/-! ## D1.1a, D1.4a — lawful comparators, the order on forests and keys -/

-- D1.1a items 1–5 (`Tree.cmp_eq_swap`, `Tree.cmp_self`, `Tree.eq_of_cmp_eq`,
-- `Tree.cmp_isLE_trans` and the four `Tree.inst…Cmp` instances) and D1.4a item 2
-- (`keyLabelCmp_transCmp`, `keyLabelCmp_lawfulEqCmp`) moved to `Plan/Spine.lean`, before
-- `Forest.instLinearOrder`, whose proof fields need them (brief rule 5; statements unchanged).

namespace Tree

variable {α β : Type}

mutual
/-- D1.4a: relabelling by a comparison-preserving map preserves the comparison. This is the tree
form of trace fact (1) and gives `relKey_lt_iff`. -/
theorem cmp_map {c : α → α → Ordering} {c' : β → β → Ordering} {f : α → β}
    (hf : ∀ x y, c' (f x) (f y) = c x y) (s t : Tree α) :
    cmp c' (map f s) (map f t) = cmp c s t :=
  match s, t with
  | .node a, .node b => by rw [map, map, cmp, cmp]; exact cmpCols_map hf a b

/-- D1.4a helper: `cmp_map` for column lists. -/
theorem cmpCols_map {c : α → α → Ordering} {c' : β → β → Ordering} {f : α → β}
    (hf : ∀ x y, c' (f x) (f y) = c x y) (a b : List (List (α × Tree α))) :
    cmpCols c' (mapCols f a) (mapCols f b) = cmpCols c a b :=
  match a, b with
  | [], [] => rfl
  | [], _ :: _ => rfl
  | _ :: _, [] => rfl
  | x :: xs, y :: ys => by
    rw [mapCols, mapCols, cmpCols, cmpCols, cmpCol_map hf x y, cmpCols_map hf xs ys]

/-- D1.4a helper: `cmp_map` for columns. -/
theorem cmpCol_map {c : α → α → Ordering} {c' : β → β → Ordering} {f : α → β}
    (hf : ∀ x y, c' (f x) (f y) = c x y) (a b : List (α × Tree α)) :
    cmpCol c' (mapCol f a) (mapCol f b) = cmpCol c a b :=
  match a, b with
  | [], [] => rfl
  | [], _ :: _ => rfl
  | _ :: _, [] => rfl
  | (p, h) :: es, (q, k) :: fs => by
    rw [mapCol, mapCol, cmpCol, cmpCol, hf, cmp_map hf h k, cmpCol_map hf es fs]
end

mutual
/-- D1.4a helper: `Tree.map f` is injective, pointwise form. -/
theorem map_inj {f : α → β} (hf : Function.Injective f) (s t : Tree α)
    (h : map f s = map f t) : s = t :=
  match s, t, h with
  | .node a, .node b, h => by
    rw [map, map] at h
    rw [mapCols_inj hf a b (Tree.node.inj h)]

/-- D1.4a helper: `map_inj` for column lists. -/
theorem mapCols_inj {f : α → β} (hf : Function.Injective f) (a b : List (List (α × Tree α)))
    (h : mapCols f a = mapCols f b) : a = b :=
  match a, b, h with
  | [], [], _ => rfl
  | x :: xs, y :: ys, h => by
    rw [mapCols, mapCols] at h
    obtain ⟨h1, h2⟩ := List.cons.inj h
    rw [mapCol_inj hf x y h1, mapCols_inj hf xs ys h2]

/-- D1.4a helper: `map_inj` for columns. -/
theorem mapCol_inj {f : α → β} (hf : Function.Injective f) (a b : List (α × Tree α))
    (h : mapCol f a = mapCol f b) : a = b :=
  match a, b, h with
  | [], [], _ => rfl
  | (p, h') :: es, (q, k) :: fs, h => by
    rw [mapCol, mapCol] at h
    obtain ⟨h1, h2⟩ := List.cons.inj h
    obtain ⟨h3, h4⟩ := Prod.mk.inj h1
    rw [hf h3, map_inj hf h' k h4, mapCol_inj hf es fs h2]
end

/-- D1.4a: relabelling by an injective map is injective. -/
theorem map_injective {f : α → β} (hf : Function.Injective f) :
    Function.Injective (map f : Tree α → Tree β) := fun s t h => map_inj hf s t h

end Tree

/-- D1.4a: `keyLabelCmp` is the lexicographic comparison of `Bool ×ₗ Nat` (false before true). -/
theorem keyLabelCmp_eq (x y : Bool × Nat) : keyLabelCmp x y = compare (toLex x) (toLex y) := rfl

/-- D1.4a: `keyCmp` is `Tree.cmp compare` on `Tree (Bool ×ₗ Nat)` (definitional). -/
theorem keyCmp_eq_cmp_lex (x y : Key) : keyCmp x y = @Tree.cmp (Lex (Bool × Nat)) compare x y := rfl

/-- D1.1: the spine's `≤` on forests (definitional). -/
theorem Forest.le_iff_cmp (a b : Forest) : a ≤ b ↔ Tree.cmp compare a b ≠ .gt := Iff.rfl

-- U1-verify: changed (new declaration)
/-- D1.1: the `compare` of the spine's linear order (its default `compareOfLessAndEq`) is the
locked comparison `Tree.cmp compare`. -/
theorem Forest.compare_eq_cmp (a b : Forest) : compare a b = Tree.cmp compare a b :=
  LawfulCmp.compare_eq (Tree.cmp compare) (fun _ _ => Iff.rfl) a b

/-- D1.4: the spine's `<` on keys (definitional). -/
theorem Key.lt_iff_keyCmp (x y : Key) : x < y ↔ keyCmp x y = .lt := Iff.rfl

/-- D1.4: the label map of `h_a` (txt:82-83). -/
def relLabel (a p : Nat) : Bool × Nat := if p < a then (false, p) else (true, p - a)

/-- D1.4: `relKey a` is relabelling by `relLabel a` (definitional). -/
theorem relKey_eq_map (a : Nat) (H : Forest) : relKey a H = H.map (relLabel a) := rfl

/-- D1.4: `relLabel a` is strictly increasing: it turns `compare` into `keyLabelCmp`
(txt:84-85). -/
theorem keyLabelCmp_relLabel (a p q : Nat) :
    keyLabelCmp (relLabel a p) (relLabel a q) = compare p q := by
  unfold relLabel keyLabelCmp
  by_cases hp : p < a <;> by_cases hq : q < a <;> simp only [hp, hq, if_true, if_false]
  · simp
  · have : compare p q = .lt := Nat.compare_eq_lt.2 (by omega)
    rw [this]; rfl
  · have : compare p q = .gt := Nat.compare_eq_gt.2 (by omega)
    rw [this]; rfl
  · show (compare true true).then (compare (p - a) (q - a)) = compare p q
    rw [show compare true true = .eq from rfl, Ordering.eq_then]
    rcases Nat.lt_trichotomy p q with h | h | h
    · rw [Nat.compare_eq_lt.2 h, Nat.compare_eq_lt.2 (by omega)]
    · subst h; rw [Nat.compare_eq_eq.2 rfl, Nat.compare_eq_eq.2 rfl]
    · rw [Nat.compare_eq_gt.2 h, Nat.compare_eq_gt.2 (by omega)]

/-- D1.4: `h_a` preserves and reflects the comparison. -/
theorem keyCmp_relKey (a : Nat) (H H' : Forest) :
    keyCmp (relKey a H) (relKey a H') = Tree.cmp compare H H' := by
  rw [relKey_eq_map, relKey_eq_map]
  exact Tree.cmp_map (keyLabelCmp_relLabel a) H H'

-- provides: U1, D1.4 (h_a preserves and reflects order, txt:84-85). Moved here from
-- `Plan/Spine.lean` (brief rule 5): its proof needs `keyCmp_relKey`; nothing in between uses it.
theorem relKey_lt_iff (a : Nat) (H H' : Forest) : relKey a H < relKey a H' ↔ H < H' := by
  rw [Key.lt_iff_keyCmp, keyCmp_relKey]; rfl

/-- D1.4: `h_a` is injective. -/
theorem relKey_injective (a : Nat) : Function.Injective (relKey a) := fun H H' h =>
  Tree.eq_of_cmp_eq compare <| by
    rw [← keyCmp_relKey a, h]; exact Tree.cmp_self keyLabelCmp _

-- U1-verify: changed (new declaration)
/-- D1.4: the `compare` of the spine's linear order on keys (its default `compareOfLessAndEq`)
is the locked `keyCmp`. Needed to feed `sign_of_agreement` (stated with `keyCmp`) into
`trace_agree` (stated with `compare`). -/
theorem Key.compare_eq_keyCmp (x y : Key) : compare x y = keyCmp x y :=
  LawfulCmp.compare_eq (Tree.cmp keyLabelCmp) (fun _ _ => Iff.rfl) x y

/-! ## D1.2b — occurrences: stacks, containment, accessors, roles -/

namespace ColAddr

/-- D1.2b: `o` lies on the visible stack of `c` (txt:66-69): at a containing level `k` it is one
of the columns `0…c_k` of that forest, or at `c`'s own level one of the columns `0…c.col-1`. -/
def OnStack (c o : ColAddr) : Prop :=
  (∃ k ck ik, c.path[k]? = some (ck, ik) ∧ o.path = c.path.take k ∧ o.col ≤ ck) ∨
    (o.path = c.path ∧ o.col < c.col)

/-- D1.2b: `resolve` returns exactly the stack occurrence with the given printed number. -/
theorem resolve_spec (base : Nat) (c o : ColAddr) (q : Nat) :
    c.resolve base q = some o ↔ c.OnStack o ∧ o.num base = q := by sorry

/-- D1.2b: stack occurrences have smaller printed numbers. -/
theorem num_lt_of_onStack (base : Nat) {c o : ColAddr} (h : c.OnStack o) :
    o.num base < c.num base := by sorry

/-- D1.2b: numbers on a stack are unique (txt:69). -/
theorem onStack_inj (base : Nat) {c o o' : ColAddr} (h : c.OnStack o) (h' : c.OnStack o')
    (hn : o.num base = o'.num base) : o = o' := by sorry

theorem resolve_num {base : Nat} {c o : ColAddr} {q : Nat} (h : c.resolve base q = some o) :
    o.num base = q := by sorry

/-- D1.2b: only numbers below `c`'s own number resolve (V makes edges decrease). -/
theorem resolve_lt {base : Nat} {c o : ColAddr} {q : Nat} (h : c.resolve base q = some o) :
    q < c.num base := by sorry

/-- D1.2b: the visible stack of `c` carries exactly the numbers `base, …, c.num base - 1`. -/
theorem resolve_isSome_iff (base : Nat) (c : ColAddr) (q : Nat) :
    (c.resolve base q).isSome ↔ base ≤ q ∧ q < c.num base := by sorry

/-- D1.2b (stack nesting, codex-crosscheck-1 Q2 "restricting σ"): below a stack occurrence `o`
of `c`, the stacks of `o` and `c` resolve every number identically. -/
theorem resolve_of_resolve_lt {base : Nat} {c o : ColAddr} {x q : Nat}
    (h : c.resolve base x = some o) (hq : q < x) : o.resolve base q = c.resolve base q := by sorry

/-- D1.2b: the container of `c` in column `q`. -/
theorem container_spec (q c : ColAddr) (e : EntryAddr) :
    q.container c = some e ↔ e.col = q ∧ e.heightPath <+: c.path := by sorry

end ColAddr

/-- D1.2b: column occurrence `c` lies inside the height of entry `e`. -/
def EntryAddr.Contains (e : EntryAddr) (c : ColAddr) : Prop := e.heightPath <+: c.path

namespace EntryAddr

/-- D1.2b: a containing column is visible from inside, under its own number. -/
theorem resolve_host {e : EntryAddr} {c : ColAddr} (h : e.Contains c) :
    c.resolve 0 (e.col.num 0) = some e.col := by sorry

/-- D1.2b (txt:216-217, "every visible z > a on this path is still inside H_e"): a stack
occurrence with a number above the host of a containing entry lies inside that entry's height. -/
theorem contains_of_resolve {e : EntryAddr} {c o : ColAddr} {z : Nat} (h : e.Contains c)
    (hz : c.resolve 0 z = some o) (hlt : e.col.num 0 < z) : e.Contains o := by sorry

/-- D1.2b: `e` contains `c` iff `e.col.container c = some e`. -/
theorem contains_iff_container (e : EntryAddr) (c : ColAddr) :
    e.Contains c ↔ e.col.container c = some e := by sorry

end EntryAddr

namespace Tree

variable {α : Type}

/-- D1.2b: column addresses are exactly the addresses at which `colAt` succeeds. -/
theorem mem_colAddrs_iff (t : Tree α) (c : ColAddr) : c ∈ t.colAddrs ↔ (t.colAt c).isSome := by
  sorry

/-- D1.2b: entry addresses are exactly the addresses at which `entryAt` succeeds. -/
theorem mem_entryAddrs_iff (t : Tree α) (e : EntryAddr) :
    e ∈ t.entryAddrs ↔ (t.entryAt e).isSome := by sorry

/-- D1.2b: the roles of a tree are its column and entry occurrences. -/
theorem mem_roles_iff (t : Tree α) (x : Role) :
    x ∈ t.roles ↔ match x with
      | .ord c => (t.colAt c).isSome
      | .slot e => (t.entryAt e).isSome := by sorry

/-- D1.2b (`roles_nodup`†): every role occurs once in reading order. -/
theorem roles_nodup (t : Tree α) : t.roles.Nodup := by sorry

/-- D1.2b: forests at concatenated paths. -/
theorem forestAt_append (t : Tree α) (π π' : List (Nat × Nat)) :
    t.forestAt (π ++ π') = (t.forestAt π).bind fun f => f.forestAt π' := by sorry

/-- D1.2b: the height of an entry is the forest at its height path. -/
theorem forestAt_heightPath (t : Tree α) (e : EntryAddr) :
    t.forestAt e.heightPath = t.heightAt e := by sorry

/-- D1.2b: an entry of `t` has its column in `t`. -/
theorem colAt_of_entryAt {t : Tree α} {e : EntryAddr} {x : α × Tree α} (h : t.entryAt e = some x) :
    ∃ col, t.colAt e.col = some col ∧ col[e.idx]? = some x := by sorry

-- bridge: holds by `rfl` (SCR-2 applied; checked in scratch/blueprint/all/rfl_check.lean)
theorem truncAfter_eq_body (t : Tree α) (e : EntryAddr) : t.truncAfter e = t.truncAfterBody e := by
  sorry
-- bridge: holds by `rfl` (SCR-2 applied)
theorem setHeight_eq_body (t : Tree α) (e : EntryAddr) (h : Tree α) :
    t.setHeight e h = t.setHeightBody e h := by sorry

/-- D1.2c (`truncAfter_roles`†): the roles of `truncAfter t e` are the roles of `t` strictly before
`U_e`, followed by the maximal run of roles inside `e` starting with `U_e`. -/
theorem truncAfter_roles {t : Tree α} {e : EntryAddr} (he : e ∈ t.entryAddrs) :
    (t.truncAfter e).roles =
      t.roles.takeWhile (· != .slot e) ++
        (t.roles.dropWhile (· != .slot e)).takeWhile (fun x => x.inEntry e) := by sorry

/-- D1.2c: `truncAfter` keeps `e` and its height. -/
theorem entryAt_truncAfter {t : Tree α} {e : EntryAddr} (he : e ∈ t.entryAddrs) :
    (t.truncAfter e).entryAt e = t.entryAt e := by sorry

/-- D1.2c: `setHeight` changes only the height of `e`. -/
theorem entryAt_setHeight {t : Tree α} {e : EntryAddr} {p : α} {H : Tree α}
    (he : t.entryAt e = some (p, H)) (h : Tree α) : (t.setHeight e h).entryAt e = some (p, h) := by
  sorry

/-- D1.2d: the last step of the last-column, last-entry route in `F`: `(|F| - 1, |col| - 1)` for
the last column `col`, if it is nonempty. -/
def lastStep? (F : Tree α) : Option (Nat × Nat) :=
  F.cols.getLast?.bind fun col => if col.isEmpty then none else some (F.cols.length - 1, col.length - 1)

end Tree

/-! ## D1.2d — the terminal last-column, last-entry route -/

/-- D1.2d: the route path: at every level `d` the step taken is the last-column, last-entry step
of the forest there. -/
def Scan.IsRoutePath (E : Forest) (π : List (Nat × Nat)) : Prop :=
  ∀ d < π.length, ∃ F, E.forestAt (π.take d) = some F ∧ F.lastStep? = π[d]?

/-- D1.2d: membership in the spine's `routeCols` (whose fuel `E.size + 1` suffices). -/
theorem Scan.mem_routeCols_iff (E : Forest) (c : ColAddr) :
    c ∈ Scan.routeCols E ↔ Scan.IsRoutePath E c.path ∧
      ∃ F, E.forestAt c.path = some F ∧ F.cols.length = c.col + 1 := by sorry

/-- D1.2d: route columns are columns of `E`. -/
theorem Scan.mem_colAddrs_of_mem_routeCols {E : Forest} {c : ColAddr} (h : c ∈ Scan.routeCols E) :
    c ∈ E.colAddrs := by sorry

/-! ## D2.1, D2.1a, L2.1, L2.1a–c, L2.3b, L2.5 — the generic word library (S-6, U1 half) -/

namespace Scan

section Words

variable {α : Type} [LinearOrder α]

/-- D2.1a: a nonincreasing word (the reduced words of txt:159). -/
abbrev Noninc (l : List α) : Prop := l.Pairwise fun x y => y ≤ x

/-- D2.1a: one reduction step: delete terminal letters strictly smaller than `x`, append `x`. -/
def nuStep (acc : List α) (x : α) : List α :=
  (acc.reverse.dropWhile fun y => decide (y < x)).reverse ++ [x]

theorem nu_eq_foldl (l : List α) : nu l = l.foldl nuStep [] := rfl

/-- D2.1a. -/
theorem nu_append_singleton (l : List α) (x : α) : nu (l ++ [x]) = nuStep (nu l) x := by
  rw [nu_eq_foldl, nu_eq_foldl, List.foldl_append]; rfl

omit [LinearOrder α] in
/-- D2.1a helper: every letter of `l.takeWhile p` satisfies `p`. -/
theorem mem_takeWhile_imp_of {p : α → Bool} :
    ∀ {l : List α} {y : α}, y ∈ l.takeWhile p → p y = true
  | [], _, h => by simp at h
  | a :: l, y, h => by
    rw [List.takeWhile_cons] at h
    split at h
    · rcases List.mem_cons.1 h with rfl | h
      · assumption
      · exact mem_takeWhile_imp_of h
    · simp at h

omit [LinearOrder α] in
/-- D2.1a helper: `l.takeWhile p = l` when every letter satisfies `p`. -/
theorem takeWhile_eq_self_of {p : α → Bool} {l : List α} (h : ∀ a ∈ l, p a = true) :
    l.takeWhile p = l := by
  simpa using List.takeWhile_append_of_pos (l₂ := []) h

/-- D2.1a helper: on a nonincreasing word, deleting the terminal letters `< x` keeps exactly the
letters `≥ x`. -/
theorem reverse_dropWhile_reverse {acc : List α} (h : Noninc acc) (x : α) :
    (acc.reverse.dropWhile fun y => decide (y < x)).reverse =
      acc.takeWhile fun y => decide (x ≤ y) := by
  induction acc with
  | nil => rfl
  | cons a rest ih =>
    rw [Noninc, List.pairwise_cons] at h
    obtain ⟨ha, hrest⟩ := h
    rw [List.reverse_cons, List.dropWhile_append, List.takeWhile_cons]
    by_cases hxa : x ≤ a
    · have hna : ¬ a < x := not_lt.2 hxa
      rw [if_pos (decide_eq_true hxa)]
      split
      · rename_i hemp
        have h0 : rest.takeWhile (fun y => decide (x ≤ y)) = [] := by
          rw [← ih hrest]; simpa using hemp
        rw [h0]; simp [hna]
      · rw [List.reverse_append, ih hrest]; rfl
    · have hax : a < x := lt_of_not_ge hxa
      have hall : ∀ b ∈ rest.reverse, decide (b < x) = true := by
        intro b hb
        exact decide_eq_true (lt_of_le_of_lt (ha b (List.mem_reverse.1 hb)) hax)
      have hd : (rest.reverse.dropWhile fun y => decide (y < x)) = [] := by
        simpa using List.dropWhile_append_of_pos (l₂ := []) hall
      simp [hd, hax, hxa]

/-- D2.1a: on a nonincreasing word, a step keeps the letters `≥ x` and appends `x`. -/
theorem nuStep_eq_takeWhile {acc : List α} (h : Noninc acc) (x : α) :
    nuStep acc x = acc.takeWhile (fun y => decide (x ≤ y)) ++ [x] := by
  rw [nuStep, reverse_dropWhile_reverse h]

/-- D2.1a: `ν(W)` is nonincreasing (txt:159). -/
theorem nu_noninc (l : List α) : Noninc (nu l) := by
  induction l using List.reverseRecOn with
  | nil => exact List.Pairwise.nil
  | append_singleton l x ih =>
    rw [nu_append_singleton, nuStep_eq_takeWhile ih, Noninc, List.pairwise_append]
    refine ⟨ih.sublist (List.takeWhile_sublist _), List.pairwise_singleton _ _, ?_⟩
    intro a ha b hb
    rw [List.mem_singleton] at hb
    subst hb
    simpa using mem_takeWhile_imp_of ha

/-- D2.1a: a nonincreasing word is reduced. -/
theorem nu_of_noninc {l : List α} (h : Noninc l) : nu l = l := by
  induction l using List.reverseRecOn with
  | nil => rfl
  | append_singleton l x ih =>
    rw [Noninc, List.pairwise_append] at h
    obtain ⟨h1, -, h3⟩ := h
    rw [nu_append_singleton, ih h1, nuStep_eq_takeWhile h1,
      takeWhile_eq_self_of fun a ha => decide_eq_true (h3 a ha x (List.mem_singleton_self x))]

/-- D2.1a. -/
theorem nu_append_nu (l m : List α) : nu (nu l ++ m) = nu (l ++ m) := by
  induction m using List.reverseRecOn with
  | nil => simp [nu_of_noninc (nu_noninc l)]
  | append_singleton m x ih =>
    rw [← List.append_assoc, ← List.append_assoc, nu_append_singleton, nu_append_singleton, ih]

/-- D2.1a (txt:163-164): an append strictly increases a reduced word. -/
theorem lt_nuStep {acc : List α} (h : Noninc acc) (x : α) : acc < nuStep acc x := by
  rw [nuStep_eq_takeWhile h]
  conv_lhs => rw [← List.takeWhile_append_dropWhile (p := fun y => decide (x ≤ y)) (l := acc)]
  apply List.append_left_lt
  cases hd : acc.dropWhile (fun y => decide (x ≤ y)) with
  | nil => exact List.nil_lt_cons _ _
  | cons d D =>
    have := List.head_dropWhile_not (fun y => decide (x ≤ y)) (l := acc) (by simp [hd])
    simp only [hd, List.head_cons, decide_eq_false_iff_not, not_le] at this
    exact List.cons_lt_cons_iff.2 (Or.inl this)

/-- D2.1a: every letter of `nuStep acc x` is at least `x`. -/
theorem le_of_mem_nuStep {acc : List α} (h : Noninc acc) {x y : α} (hy : y ∈ nuStep acc x) :
    x ≤ y := by
  rw [nuStep_eq_takeWhile h, List.mem_append] at hy
  rcases hy with hy | hy
  · simpa using mem_takeWhile_imp_of hy
  · rw [List.mem_singleton] at hy; exact hy ▸ le_refl x

theorem cutQuery_zero (ks : List α) : cutQuery ks 0 = [] := rfl

theorem boundary_eq_cutQuery (ks : List α) (i : Nat) : boundary ks i = cutQuery ks (i + 1) := rfl

/-- D2.1a. -/
theorem cutQuery_succ {ks : List α} {k : Nat} (hk : k < ks.length) :
    cutQuery ks (k + 1) = nuStep (cutQuery ks k) ks[k] := by
  rw [cutQuery, ← List.take_append_getElem hk, nu_append_singleton]; rfl

theorem cutQuery_noninc (ks : List α) (k : Nat) : Noninc (cutQuery ks k) := nu_noninc _

-- provides: U1, D2.1 (boundaries strictly increase). Moved here from `Plan/Spine.lean` (brief
-- rule 5): its proof needs `cutQuery_succ` and `lt_nuStep`; nothing in between uses it.
theorem cutQuery_lt_succ {α : Type} [LinearOrder α] (ks : List α) {k : Nat} (hk : k < ks.length) :
    cutQuery ks k < cutQuery ks (k + 1) := by
  rw [cutQuery_succ hk]; exact lt_nuStep (cutQuery_noninc ks k) _

/-- D2.1 (with `cutQuery_lt_succ`): boundaries strictly increase up to the full cut. -/
theorem cutQuery_strictMono {ks : List α} {j k : Nat} (hjk : j < k) (hk : k ≤ ks.length) :
    cutQuery ks j < cutQuery ks k := by
  induction k with
  | zero => omega
  | succ k ih =>
    rcases Nat.lt_succ_iff_lt_or_eq.1 hjk with h | h
    · exact lt_trans (ih h (by omega)) (cutQuery_lt_succ ks (by omega))
    · subst h; exact cutQuery_lt_succ ks (by omega)

/-- D2.1 helper: a cut beyond the column is the full cut. -/
theorem cutQuery_eq_min (ks : List α) (k : Nat) : cutQuery ks k = cutQuery ks (min k ks.length) := by
  unfold cutQuery
  rcases le_total k ks.length with h | h
  · rw [Nat.min_eq_left h]
  · rw [Nat.min_eq_right h, List.take_of_length_le h, List.take_length]

/-- D2.1: boundaries are monotone (constant beyond the full cut). -/
theorem cutQuery_mono (ks : List α) {j k : Nat} (hjk : j ≤ k) : cutQuery ks j ≤ cutQuery ks k := by
  rw [cutQuery_eq_min ks j, cutQuery_eq_min ks k]
  rcases Nat.lt_or_eq_of_le (min_le_min_right ks.length hjk) with h | h
  · exact le_of_lt (cutQuery_strictMono h (Nat.min_le_right _ _))
  · rw [h]

theorem boundary_ne_nil {ks : List α} {i : Nat} (hi : i < ks.length) : boundary ks i ≠ [] := by
  rw [boundary_eq_cutQuery, cutQuery_succ hi, nuStep]; simp

/-- D2.1a helper: a step commutes with a strictly increasing map. -/
theorem nuStep_map {β : Type} [LinearOrder β] {f : α → β} (hf : StrictMono f) (acc : List α)
    (x : α) : nuStep (acc.map f) (f x) = (nuStep acc x).map f := by
  unfold nuStep
  rw [← List.map_reverse, List.dropWhile_map, ← List.map_reverse, List.map_append]
  have : ((fun y => decide (y < f x)) ∘ f) = fun y => decide (y < x) := by
    funext y; simp [hf.lt_iff_lt]
  rw [this]; rfl

-- U1-verify: changed (new declarations)
/-- D2.1a: `ν` commutes with a strictly increasing map (used for the maps `κ_j` of txt:331-333
and for the coercion `Key → WithTop Key`). -/
theorem nu_map {β : Type} [LinearOrder β] {f : α → β} (hf : StrictMono f) (l : List α) :
    nu (l.map f) = (nu l).map f := by
  induction l using List.reverseRecOn with
  | nil => rfl
  | append_singleton l x ih =>
    rw [List.map_append, List.map_singleton, nu_append_singleton, nu_append_singleton, ih,
      nuStep_map hf]

/-- D2.1a: cut queries commute with a strictly increasing map. -/
theorem cutQuery_map {β : Type} [LinearOrder β] {f : α → β} (hf : StrictMono f) (ks : List α)
    (k : Nat) : cutQuery (ks.map f) k = (cutQuery ks k).map f := by
  rw [cutQuery, cutQuery, ← List.map_take, nu_map hf]

/-- D2.1a: boundaries commute with a strictly increasing map. -/
theorem boundary_map {β : Type} [LinearOrder β] {f : α → β} (hf : StrictMono f) (ks : List α)
    (i : Nat) : boundary (ks.map f) i = (boundary ks i).map f := by
  rw [boundary, boundary, ← List.map_take, nu_map hf]

/-- L2.3b helper: if every letter of `D` is above `J` and `W < D`, then the letters of `W` up
to the first one below `J`, followed by `J`, are still below `D`. -/
theorem takeWhile_append_lt {J : α} : ∀ {W D : List α}, (∀ d ∈ D, J < d) → W < D →
    W.takeWhile (fun y => decide (J ≤ y)) ++ [J] < D
  | [], D, hD, h => by
    cases D with
    | nil => exact absurd h (lt_irrefl _)
    | cons d D => exact List.cons_lt_cons_iff.2 (Or.inl (hD d List.mem_cons_self))
  | w :: W, D, hD, h => by
    cases D with
    | nil => exact absurd h (List.not_lt_nil _)
    | cons d D =>
      rw [List.takeWhile_cons]
      by_cases hJw : J ≤ w
      · rw [if_pos (decide_eq_true hJw), List.cons_append]
        rcases List.cons_lt_cons_iff.1 h with h' | ⟨rfl, h'⟩
        · exact List.cons_lt_cons_iff.2 (Or.inl h')
        · exact List.cons_lt_cons_iff.2 (Or.inr ⟨rfl,
            takeWhile_append_lt (fun d hd => hD d (List.mem_cons_of_mem _ hd)) h'⟩)
      · rw [if_neg (by simpa using hJw), List.nil_append]
        exact List.cons_lt_cons_iff.2 (Or.inl (hD d List.mem_cons_self))

/-- L2.3b (word observation, txt:211-213): if `D = ν(P ⌢ [K])`, `W` is nonincreasing, `W < D`
and `J < K`, then `ν(W ⌢ [J]) < D`. -/
theorem nu_append_lt {P W : List α} {K J : α} (hW : Noninc W) (hWD : W < nu (P ++ [K]))
    (hJK : J < K) : nu (W ++ [J]) < nu (P ++ [K]) := by
  rw [nu_append_singleton, nu_of_noninc hW, nuStep_eq_takeWhile hW]
  refine takeWhile_append_lt (fun d hd => lt_of_lt_of_le hJK ?_) hWD
  rw [nu_append_singleton] at hd
  exact le_of_mem_nuStep (nu_noninc P) hd

/-- L2.3b, boundary form: `W(c,k) < B_a(u)` and `K_k < K_u` give `B_c(k) < B_a(u)`. -/
theorem boundary_lt_of_cut {ksc ksa : List α} {k u : Nat} (hk : k < ksc.length)
    (hu : u < ksa.length) (hW : cutQuery ksc k < boundary ksa u) (hK : ksc[k] < ksa[u]) :
    boundary ksc k < boundary ksa u := by
  have e1 : boundary ksc k = nu (cutQuery ksc k ++ [ksc[k]]) := by
    rw [boundary, ← List.take_append_getElem hk, cutQuery, nu_append_nu]
  have e2 : boundary ksa u = nu (ksa.take u ++ [ksa[u]]) := by
    rw [boundary, ← List.take_append_getElem hu]
  rw [e1, e2]
  rw [e2] at hW
  exact nu_append_lt (cutQuery_noninc ksc k) hW hK

/-- L2.1a: the source cursor never exceeds the source length. -/
theorem cursor_le_length (src qry : List α) : cursor src qry ≤ src.length := by
  fun_induction cursor src qry with
  | case1 => simp
  | case2 => simp
  | case3 x xs y ys h ih => simp only [List.length_cons]; omega
  | case4 xs y ys h ih => simp only [List.length_cons]; omega
  | case5 x xs y ys h1 h2 ih => exact ih

/-- L2.1a: the run on a source prefix is the run on the whole source, stopped at its end. -/
theorem cursor_take (src qry : List α) (k : Nat) :
    cursor (src.take k) qry = min k (cursor src qry) := by
  induction src, qry using cursor.induct generalizing k with
  | case1 qry => simp [cursor]
  | case2 x xs => cases k <;> simp [cursor]
  | case3 x xs y ys h ih =>
    cases k with
    | zero => simp [cursor]
    | succ k => simp only [List.take_succ_cons, cursor, if_pos h, ih]; omega
  | case4 xs y ys h ih =>
    cases k with
    | zero => simp [cursor]
    | succ k => simp only [List.take_succ_cons, cursor, lt_irrefl, if_false, if_true, ih]; omega
  | case5 x xs y ys h1 h2 ih =>
    cases k with
    | zero => simp [cursor]
    | succ k =>
      have := ih (k + 1)
      simp only [List.take_succ_cons] at this
      simp only [List.take_succ_cons, cursor, if_neg h1, if_neg h2, this]

/-- L2.1a: the final query cursor of the raw scan (same recursion as `cursor`). -/
def qcursor : List α → List α → Nat
  | [], _ => 0
  | _ :: _, [] => 0
  | x :: xs, y :: ys =>
    if x < y then qcursor xs (y :: ys)
    else if x = y then qcursor xs ys + 1
    else qcursor (x :: xs) ys + 1
termination_by xs ys => xs.length + ys.length

theorem qcursor_le_length (src qry : List α) : qcursor src qry ≤ qry.length := by
  fun_induction qcursor src qry with
  | case1 => simp
  | case2 => simp
  | case3 x xs y ys h ih => exact ih
  | case4 xs y ys h ih => simp only [List.length_cons]; omega
  | case5 x xs y ys h1 h2 ih => simp only [List.length_cons]; omega

/-- L2.1a: a run that exhausts `src` continues on `src'` from the query position it reached. -/
theorem cursor_append_of_exhausted {src qry : List α} (src' : List α)
    (h : cursor src qry = src.length) :
    cursor (src ++ src') qry = src.length + cursor src' (qry.drop (qcursor src qry)) ∧
      qcursor (src ++ src') qry = qcursor src qry + qcursor src' (qry.drop (qcursor src qry)) := by
  induction src, qry using cursor.induct with
  | case1 qry => simp [qcursor]
  | case2 x xs => simp [cursor] at h
  | case3 x xs y ys hxy ih =>
    simp only [cursor, if_pos hxy, List.length_cons] at h
    obtain ⟨h1, h2⟩ := ih (by omega)
    simp only [List.cons_append, cursor, qcursor, if_pos hxy, List.length_cons, h1, h2]
    exact ⟨by omega, trivial⟩
  | case4 xs y ys hyy ih =>
    simp only [cursor, lt_irrefl, if_false, if_true, List.length_cons] at h
    obtain ⟨h1, h2⟩ := ih (by omega)
    simp only [List.cons_append, cursor, qcursor, lt_irrefl, if_false, if_true, List.length_cons,
      h1, h2, List.drop_succ_cons]
    exact ⟨by omega, by omega⟩
  | case5 x xs y ys h1 h2 ih =>
    simp only [cursor, if_neg h1, if_neg h2] at h
    obtain ⟨h3, h4⟩ := ih h
    simp only [List.cons_append] at h3 h4
    simp only [List.cons_append, cursor, qcursor, if_neg h1, if_neg h2, List.drop_succ_cons]
    exact ⟨h3, by omega⟩

/-- L2.1a: a run that stops inside `src` (its query is exhausted) ignores what follows. -/
theorem cursor_append_of_lt {src qry : List α} (src' : List α) (h : cursor src qry < src.length) :
    cursor (src ++ src') qry = cursor src qry := by
  induction src, qry using cursor.induct with
  | case1 qry => simp at h
  | case2 x xs => simp [cursor]
  | case3 x xs y ys hxy ih =>
    simp only [cursor, if_pos hxy, List.length_cons] at h
    simp only [List.cons_append, cursor, if_pos hxy, ih (by omega)]
  | case4 xs y ys hyy ih =>
    simp only [cursor, lt_irrefl, if_false, if_true, List.length_cons] at h
    simp only [List.cons_append, cursor, lt_irrefl, if_false, if_true, ih (by omega)]
  | case5 x xs y ys h1 h2 ih =>
    simp only [cursor, if_neg h1, if_neg h2] at h
    have := ih h
    simp only [List.cons_append] at this
    simp only [List.cons_append, cursor, if_neg h1, if_neg h2, this]

/-- L2.1a helper: a one-letter source above every query letter is never consumed. -/
theorem cursor_singleton_of_lt (x : α) : ∀ (V : List α), (∀ v ∈ V, v < x) → cursor [x] V = 0
  | [], _ => by simp [cursor]
  | v :: V, h => by
    have hv : v < x := h v List.mem_cons_self
    rw [cursor, if_neg (not_lt.2 hv.le), if_neg (ne_of_gt hv)]
    exact cursor_singleton_of_lt x V fun w hw => h w (List.mem_cons_of_mem _ hw)

/-- L2.1a: a one-letter source against a nonincreasing query `y :: V`. -/
theorem cursor_singleton_cons (x y : α) (V : List α) (hV : Noninc (y :: V)) :
    (x < y → cursor [x] (y :: V) = 1 ∧ qcursor [x] (y :: V) = 0) ∧
      (x = y → cursor [x] (y :: V) = 1 ∧ qcursor [x] (y :: V) = 1) ∧
      (y < x → cursor [x] (y :: V) = 0) := by
  refine ⟨fun h => ?_, fun h => ?_, fun h => ?_⟩
  · simp [cursor, qcursor, h]
  · subst h; simp [cursor, qcursor]
  · rw [cursor, if_neg (not_lt.2 h.le), if_neg (ne_of_gt h)]
    rw [Noninc, List.pairwise_cons] at hV
    exact cursor_singleton_of_lt x V fun v hv => lt_of_le_of_lt (hV.1 v hv) h

theorem cursor_nil_right (src : List α) : cursor src [] = 0 := by
  cases src <;> simp [cursor]

/-- L2.1b helper: `ν(l)` is a sublist of `l`. -/
theorem nu_sublist (l : List α) : (nu l).Sublist l := by
  induction l using List.reverseRecOn with
  | nil => exact List.Sublist.slnil
  | append_singleton l x ih =>
    rw [nu_append_singleton, nuStep_eq_takeWhile (nu_noninc l)]
    exact ((List.takeWhile_sublist _).trans ih).append (List.Sublist.refl _)

/-- L2.1b helper: a letter at least every later letter is kept by `ν`. -/
theorem nu_cons_of_le {x : α} {xs : List α} (h : ∀ z ∈ xs, z ≤ x) : nu (x :: xs) = x :: nu xs := by
  induction xs using List.reverseRecOn with
  | nil => rfl
  | append_singleton xs w ih =>
    have ih' := ih fun z hz => h z (List.mem_append_left _ hz)
    have hw : w ≤ x := h w (List.mem_append_right _ (List.mem_singleton_self w))
    have hn : Noninc (x :: nu xs) := ih' ▸ nu_noninc (x :: xs)
    rw [← List.cons_append, nu_append_singleton, ih', nuStep_eq_takeWhile hn, List.takeWhile_cons,
      if_pos (decide_eq_true hw), nu_append_singleton, nuStep_eq_takeWhile (nu_noninc xs),
      List.cons_append]

/-- L2.1b helper: a letter below some later letter is deleted by `ν`. -/
theorem nu_cons_of_lt {x : α} {xs : List α} (h : ∃ z ∈ xs, x < z) : nu (x :: xs) = nu xs := by
  induction xs using List.reverseRecOn with
  | nil => simp at h
  | append_singleton xs w ih =>
    rw [← List.cons_append, nu_append_singleton, nu_append_singleton]
    by_cases h' : ∃ z ∈ xs, x < z
    · rw [ih h']
    · push Not at h'
      obtain ⟨z, hz, hxz⟩ := h
      have hxw : x < w := by
        rcases List.mem_append.1 hz with hz | hz
        · exact absurd (h' z hz) (not_le.2 hxz)
        · rw [List.mem_singleton] at hz; exact hz ▸ hxz
      rw [nu_cons_of_le h', nuStep_eq_takeWhile (nu_cons_of_le h' ▸ nu_noninc (x :: xs)),
        nuStep_eq_takeWhile (nu_noninc xs), List.takeWhile_cons,
        if_neg (by simpa using hxw)]
      cases hn : nu xs with
      | nil => rfl
      | cons a rest =>
        have ha : a ≤ x := h' a ((nu_sublist xs).subset (hn ▸ List.mem_cons_self))
        rw [List.takeWhile_cons, if_neg (by simpa using lt_of_le_of_lt ha hxw)]

/-- L2.1b helper: the first letter of `ν(x :: xs)` is a maximum of `x :: xs`. -/
theorem nu_head (x : α) (xs : List α) :
    ∃ m rest, nu (x :: xs) = m :: rest ∧ x ≤ m ∧ ∀ z ∈ xs, z ≤ m := by
  induction xs generalizing x with
  | nil => exact ⟨x, [], rfl, le_refl x, by simp⟩
  | cons w ws ih =>
    by_cases hall : ∀ z ∈ w :: ws, z ≤ x
    · exact ⟨x, _, nu_cons_of_le hall, le_refl x, hall⟩
    · push Not at hall
      obtain ⟨m, rest, hm, hwm, hws⟩ := ih w
      obtain ⟨z, hz, hxz⟩ := hall
      have hzm : ∀ z ∈ w :: ws, z ≤ m := by
        intro z hz
        rcases List.mem_cons.1 hz with rfl | hz
        · exact hwm
        · exact hws z hz
      exact ⟨m, rest, (nu_cons_of_lt ⟨z, hz, hxz⟩).trans hm, (hxz.trans_le (hzm z hz)).le, hzm⟩

/-- L2.1b helper: a list whose first letter is below `m` is below every list starting with `m`. -/
theorem lt_cons_of_head_lt {l : List α} {m : α} (rest : List α) (h : ∀ a ∈ l.head?, a < m) :
    l < m :: rest := by
  cases l with
  | nil => exact List.nil_lt_cons _ _
  | cons a l => exact List.cons_lt_cons_iff.2 (Or.inl (h a rfl))

/-- L2.1b helper: the empty list is least. -/
theorem nil_le_list (l : List α) : ([] : List α) ≤ l := by
  cases l with
  | nil => exact le_refl _
  | cons a l => exact le_of_lt (List.nil_lt_cons _ _)

/-- L2.1b helper: `≤` under a common first letter. -/
theorem cons_le_cons_iff' (a : α) (l l' : List α) : a :: l ≤ a :: l' ↔ l ≤ l' := by
  rw [le_iff_lt_or_eq, le_iff_lt_or_eq, List.cons_lt_cons_iff, List.cons.injEq]
  simp

/-- L2.1b (txt:170-173): against a nonincreasing query, exhaustion is lexicographic comparison
of the reduced source. -/
theorem cursor_eq_length_iff (src : List α) {W : List α} (hW : Noninc W) :
    cursor src W = src.length ↔ nu src ≤ W := by
  induction src, W using cursor.induct with
  | case1 W => exact iff_of_true (by simp [cursor]) (nil_le_list W)
  | case2 x xs =>
    obtain ⟨m, rest, hm, -⟩ := nu_head x xs
    rw [hm, cursor]
    exact iff_of_false (by simp) (not_le.2 (List.nil_lt_cons _ _))
  | case3 x xs y ys hxy ih =>
    rw [cursor, if_pos hxy, List.length_cons, Nat.add_right_cancel_iff, ih hW]
    by_cases hall : ∀ z ∈ xs, z ≤ x
    · rw [nu_cons_of_le hall]
      refine iff_of_true (le_of_lt (lt_cons_of_head_lt _ fun a ha => ?_))
        (le_of_lt (List.cons_lt_cons_iff.2 (Or.inl hxy)))
      have ha' : a ∈ nu xs := List.mem_of_mem_head? ha
      exact lt_of_le_of_lt (hall a ((nu_sublist xs).subset ha')) hxy
    · push Not at hall
      rw [nu_cons_of_lt hall]
  | case4 xs y ys hyy ih =>
    have hys : Noninc ys := (List.pairwise_cons.1 hW).2
    rw [cursor, if_neg hyy, if_pos rfl, List.length_cons, Nat.add_right_cancel_iff, ih hys]
    by_cases hall : ∀ z ∈ xs, z ≤ y
    · rw [nu_cons_of_le hall, cons_le_cons_iff']
    · push Not at hall
      obtain ⟨z, hz, hyz⟩ := hall
      rw [nu_cons_of_lt ⟨z, hz, hyz⟩]
      obtain ⟨w, ws, rfl⟩ : ∃ w ws, xs = w :: ws := List.exists_cons_of_ne_nil (List.ne_nil_of_mem hz)
      obtain ⟨m, rest, hm, hwm, hws⟩ := nu_head w ws
      have hym : y < m := by
        rcases List.mem_cons.1 hz with rfl | hz
        · exact lt_of_lt_of_le hyz hwm
        · exact lt_of_lt_of_le hyz (hws z hz)
      rw [hm]
      refine iff_of_false (not_le.2 (lt_cons_of_head_lt _ fun a ha => ?_))
        (not_le.2 (List.cons_lt_cons_iff.2 (Or.inl hym)))
      exact lt_of_le_of_lt ((List.pairwise_cons.1 hW).1 a (List.mem_of_mem_head? ha)) hym
  | case5 x xs y ys h1 h2 ih =>
    have hys : Noninc ys := (List.pairwise_cons.1 hW).2
    have hyx : y < x := lt_of_le_of_ne (not_lt.1 h1) (Ne.symm h2)
    rw [cursor, if_neg h1, if_neg h2, ih hys]
    obtain ⟨m, rest, hm, hxm, -⟩ := nu_head x xs
    have hym : y < m := lt_of_lt_of_le hyx hxm
    rw [hm]
    refine iff_of_false (not_le.2 (lt_cons_of_head_lt _ fun a ha => ?_))
      (not_le.2 (List.cons_lt_cons_iff.2 (Or.inl hym)))
    exact lt_of_le_of_lt ((List.pairwise_cons.1 hW).1 a (List.mem_of_mem_head? ha)) hym

-- provides: U1, L2.1 (scan boundary lemma, reduced query). Moved here from `Plan/Spine.lean`
-- (brief rule 5): its proof needs `cursor_take` and `cursor_eq_length_iff`; nothing in between
-- uses it.
theorem cursor_spec {α : Type} [LinearOrder α] (ks W : List α)
    (hW : W.Pairwise fun x y => y ≤ x) :
    cutQuery ks (cursor ks W) ≤ W ∧
      (cursor ks W < ks.length → W < cutQuery ks (cursor ks W + 1)) := by
  have hc := cursor_le_length ks W
  refine ⟨?_, fun hlt => ?_⟩
  · have h1 : cursor (ks.take (cursor ks W)) W = (ks.take (cursor ks W)).length := by
      rw [cursor_take, min_self, List.length_take, Nat.min_eq_left hc]
    exact (cursor_eq_length_iff _ hW).1 h1
  · have h1 : cursor (ks.take (cursor ks W + 1)) W ≠ (ks.take (cursor ks W + 1)).length := by
      rw [cursor_take, List.length_take, Nat.min_eq_left hlt]; omega
    exact not_le.1 fun h => h1 ((cursor_eq_length_iff _ hW).2 h)

/-- L2.1 ("the unique i", txt:165-167). -/
theorem cursor_unique {ks W : List α} (hW : Noninc W) {i : Nat} (hi : i ≤ ks.length)
    (hlo : cutQuery ks i ≤ W) (hhi : i < ks.length → W < cutQuery ks (i + 1)) :
    cursor ks W = i := by
  obtain ⟨h1, h2⟩ := cursor_spec ks W hW
  have hc := cursor_le_length ks W
  rcases lt_trichotomy i (cursor ks W) with h | h | h
  · exact absurd (lt_of_lt_of_le (hhi (by omega)) ((cutQuery_mono ks h).trans h1)) (lt_irrefl W)
  · exact h.symm
  · exact absurd (lt_of_lt_of_le (h2 (by omega)) ((cutQuery_mono ks h).trans hlo)) (lt_irrefl W)

/-- L2.1: a query strictly below `B(v)` stops the scan at or before `v`. -/
theorem cursor_le_of_lt_cutQuery {ks W : List α} (hW : Noninc W) {v : Nat} (hv : v < ks.length)
    (h : W < cutQuery ks (v + 1)) : cursor ks W ≤ v := by
  by_contra hc
  exact lt_irrefl W (lt_of_lt_of_le h
    ((cutQuery_mono ks (by omega : v + 1 ≤ cursor ks W)).trans (cursor_spec ks W hW).1))

/-- L2.1: a query at least `B(v-1)` reaches `v`. -/
theorem le_cursor_of_cutQuery_le {ks W : List α} (hW : Noninc W) {v : Nat} (hv : v ≤ ks.length)
    (h : cutQuery ks v ≤ W) : v ≤ cursor ks W := by
  have h1 : cursor (ks.take v) W = (ks.take v).length := (cursor_eq_length_iff _ hW).2 h
  rw [cursor_take, List.length_take, Nat.min_eq_left hv] at h1
  omega

/-- L2.1: the final source cursor is monotone in reduced queries (used by L2.2). -/
theorem cursor_mono (ks : List α) {W Z : List α} (hW : Noninc W) (hZ : Noninc Z) (h : W ≤ Z) :
    cursor ks W ≤ cursor ks Z := by
  by_contra hc
  have hZl : cursor ks Z < ks.length := by have := cursor_le_length ks W; omega
  exact lt_irrefl Z (lt_of_lt_of_le ((cursor_spec ks Z hZ).2 hZl)
    (((cutQuery_mono ks (by omega : cursor ks Z + 1 ≤ cursor ks W)).trans
      (cursor_spec ks W hW).1).trans h))

/-- L2.1c (txt:174-176): deleting a query letter immediately followed by a larger one does not
change the final source cursor. -/
theorem cursor_delete (src A B : List α) {x y : α} (hxy : x < y) :
    cursor src (A ++ x :: y :: B) = cursor src (A ++ y :: B) := by
  induction A generalizing src with
  | nil =>
    induction src with
    | nil => simp [cursor]
    | cons s ss ih =>
      simp only [List.nil_append] at ih ⊢
      rcases lt_trichotomy s x with h | h | h
      · conv_lhs => rw [cursor, if_pos h]
        conv_rhs => rw [cursor, if_pos (lt_trans h hxy)]
        rw [ih]
      · subst h
        conv_lhs => rw [cursor, if_neg (lt_irrefl _), if_pos rfl]
        conv_rhs => rw [cursor, if_pos hxy]
      · conv_lhs => rw [cursor, if_neg (not_lt.2 h.le), if_neg (ne_of_gt h)]
  | cons a A ih =>
    induction src with
    | nil => simp [cursor]
    | cons s ss ihs =>
      simp only [List.cons_append] at ihs ⊢
      rcases lt_trichotomy s a with h | h | h
      · conv_lhs => rw [cursor, if_pos h]
        conv_rhs => rw [cursor, if_pos h]
        rw [ihs]
      · subst h
        conv_lhs => rw [cursor, if_neg (lt_irrefl _), if_pos rfl]
        conv_rhs => rw [cursor, if_neg (lt_irrefl _), if_pos rfl]
        rw [ih]
      · conv_lhs => rw [cursor, if_neg (not_lt.2 h.le), if_neg (ne_of_gt h)]
        conv_rhs => rw [cursor, if_neg (not_lt.2 h.le), if_neg (ne_of_gt h)]
        rw [ih]

/-- L2.1c helper: deleting the terminal letters `< y` before `y` does not change the cursor. -/
theorem cursor_reduce_before (src : List α) (y : α) (C : List α) (acc : List α) :
    cursor src ((acc.reverse.dropWhile fun z => decide (z < y)).reverse ++ y :: C) =
      cursor src (acc ++ y :: C) := by
  induction acc using List.reverseRecOn with
  | nil => rfl
  | append_singleton acc d ih =>
    rw [List.reverse_append, List.reverse_singleton, List.singleton_append, List.dropWhile_cons]
    by_cases hd : d < y
    · rw [if_pos (decide_eq_true hd), ih, List.append_assoc, List.singleton_append,
        cursor_delete src acc C hd]
    · rw [if_neg (by simpa using hd), List.reverse_cons, List.reverse_reverse, List.append_assoc,
        List.singleton_append]

-- provides: U1, L2.1 (reducing a query does not change the final source cursor). Moved here from
-- `Plan/Spine.lean` (brief rule 5): its proof needs `cursor_delete`; nothing in between uses it.
theorem cursor_nu {α : Type} [LinearOrder α] (ks W : List α) :
    cursor ks (nu W) = cursor ks W := by
  suffices h : ∀ C, cursor ks (nu W ++ C) = cursor ks (W ++ C) by simpa using h []
  induction W using List.reverseRecOn with
  | nil => intro C; rfl
  | append_singleton W y ih =>
    intro C
    rw [nu_append_singleton, nuStep, List.append_assoc, List.singleton_append,
      cursor_reduce_before, ih, List.append_assoc, List.singleton_append]

/-- L2.5a helper: the final state of a run started at `(i, j)`. -/
theorem traceFrom_getLast (src qry : List α) (i j : Nat) :
    (traceFrom i j src qry).getLast? = some (i + cursor src qry, j + qcursor src qry) := by
  induction src, qry using cursor.induct generalizing i j with
  | case1 qry => simp [traceFrom, cursor, qcursor]
  | case2 x xs => simp [traceFrom, cursor, qcursor]
  | case3 x xs y ys h ih =>
    rw [traceFrom, if_pos h, List.getLast?_cons, ih, cursor, if_pos h, qcursor, if_pos h]
    simp only [Option.getD_some, Option.some.injEq, Prod.mk.injEq, and_true]; omega
  | case4 xs y ys h ih =>
    rw [traceFrom, if_neg h, if_pos rfl, List.getLast?_cons, ih, cursor, if_neg h, if_pos rfl,
      qcursor, if_neg h, if_pos rfl]
    simp only [Option.getD_some, Option.some.injEq, Prod.mk.injEq]; omega
  | case5 x xs y ys h1 h2 ih =>
    rw [traceFrom, if_neg h1, if_neg h2, List.getLast?_cons, ih, cursor, if_neg h1, if_neg h2,
      qcursor, if_neg h1, if_neg h2]
    simp only [Option.getD_some, Option.some.injEq, Prod.mk.injEq, true_and]; omega

/-- L2.5a: the final state of the trace is `(cursor, qcursor)`. -/
theorem trace_last (src qry : List α) :
    (trace src qry).getLast? = some (cursor src qry, qcursor src qry) := by
  have := traceFrom_getLast src qry 0 0
  simpa [trace] using this

/-- L2.5a: equal traces have equal final source cursors. -/
theorem cursor_eq_of_trace_eq {src₁ src₂ qry₁ qry₂ : List α}
    (h : trace src₁ qry₁ = trace src₂ qry₂) : cursor src₁ qry₁ = cursor src₂ qry₂ := by
  have := trace_last src₁ qry₁
  rw [h, trace_last] at this
  exact (Prod.mk.inj (Option.some.inj this)).1.symm

/-- L2.5a helper: every state of a run started at `(i, j)` lies between the start and the final
state, coordinatewise. -/
theorem mem_traceFrom (src qry : List α) (i j : Nat) {s : Nat × Nat}
    (hs : s ∈ traceFrom i j src qry) :
    i ≤ s.1 ∧ s.1 ≤ i + cursor src qry ∧ j ≤ s.2 ∧ s.2 ≤ j + qcursor src qry := by
  induction src, qry using cursor.induct generalizing i j with
  | case1 qry =>
    simp only [traceFrom, List.mem_singleton] at hs; subst hs; simp
  | case2 x xs =>
    simp only [traceFrom, List.mem_singleton] at hs; subst hs; simp
  | case3 x xs y ys h ih =>
    rw [traceFrom, if_pos h, List.mem_cons] at hs
    rw [cursor, if_pos h, qcursor, if_pos h]
    rcases hs with rfl | hs
    · simp
    · have := ih (i + 1) j hs; omega
  | case4 xs y ys h ih =>
    rw [traceFrom, if_neg h, if_pos rfl, List.mem_cons] at hs
    rw [cursor, if_neg h, if_pos rfl, qcursor, if_neg h, if_pos rfl]
    rcases hs with rfl | hs
    · simp
    · have := ih (i + 1) (j + 1) hs; omega
  | case5 x xs y ys h1 h2 ih =>
    rw [traceFrom, if_neg h1, if_neg h2, List.mem_cons] at hs
    rw [cursor, if_neg h1, if_neg h2, qcursor, if_neg h1, if_neg h2]
    rcases hs with rfl | hs
    · simp
    · have := ih i (j + 1) hs; omega

-- U1-verify: changed (new declaration)
/-- L2.5a: no state of a run has a source cursor beyond the final one (used in the proof of
`trace_agree`). -/
theorem trace_fst_le_cursor (src qry : List α) {i j : Nat} (h : (i, j) ∈ trace src qry) :
    i ≤ cursor src qry := by
  simpa using (mem_traceFrom src qry 0 0 h).2.1

/-- L2.5 helper: `trace_map` from an arbitrary start state. -/
theorem traceFrom_map {β : Type} [LinearOrder β] {f : α → β} (hf : StrictMono f)
    (src qry : List α) (i j : Nat) :
    traceFrom i j (src.map f) (qry.map f) = traceFrom i j src qry := by
  induction src, qry using cursor.induct generalizing i j with
  | case1 qry => simp [traceFrom]
  | case2 x xs => simp [traceFrom]
  | case3 x xs y ys h ih =>
    have := ih (i + 1) j
    simp only [List.map_cons] at this
    simp only [List.map_cons, traceFrom, if_pos (hf.lt_iff_lt.2 h), if_pos h, this]
  | case4 xs y ys h ih =>
    have := ih (i + 1) (j + 1)
    simp only [List.map_cons, traceFrom, lt_irrefl, if_false, if_true, this]
  | case5 x xs y ys h1 h2 ih =>
    have := ih i (j + 1)
    simp only [List.map_cons] at this
    simp only [List.map_cons, traceFrom, if_neg (mt hf.lt_iff_lt.1 h1), if_neg (hf.injective.ne h2),
      if_neg h1, if_neg h2, this]

/-- L2.5 (1) (`trace_map`†, txt:238): a common strictly increasing map preserves every cursor
pair. -/
theorem trace_map {β : Type} [LinearOrder β] {f : α → β} (hf : StrictMono f) (src qry : List α) :
    trace (src.map f) (qry.map f) = trace src qry := traceFrom_map hf src qry 0 0

/-- L2.5 (1), cursor form. -/
theorem cursor_map {β : Type} [LinearOrder β] {f : α → β} (hf : StrictMono f) (src qry : List α) :
    cursor (src.map f) (qry.map f) = cursor src qry := by
  have h1 := trace_last (src.map f) (qry.map f)
  rw [trace_map hf, trace_last] at h1
  exact (Prod.mk.inj (Option.some.inj h1)).1.symm

/-- L2.5 helper: a one-letter source that is never consumed can be raised to `⊤`. -/
theorem traceFrom_singleton_top {β : Type} [LinearOrder β] [OrderTop β] (s : β) :
    ∀ (qry : List β) (i j : Nat), cursor [s] qry = 0 →
      traceFrom i j [⊤] qry = traceFrom i j [s] qry
  | [], i, j, _ => by simp [traceFrom]
  | y :: ys, i, j, h => by
    have h1 : ¬ s < y := fun hc => by rw [cursor, if_pos hc] at h; simp at h
    have h2 : ¬ s = y := fun hc => by rw [cursor, if_neg h1, if_pos hc] at h; simp at h
    rw [cursor, if_neg h1, if_neg h2] at h
    have hys : y < s := lt_of_le_of_ne (not_lt.1 h1) (Ne.symm h2)
    have h3 : ¬ (⊤ : β) < y := not_lt.2 le_top
    have h4 : ¬ (⊤ : β) = y := fun hc => by
      rw [← hc] at hys; exact absurd hys (not_lt.2 le_top)
    conv_lhs => rw [traceFrom, if_neg h3, if_neg h4]
    conv_rhs => rw [traceFrom, if_neg h1, if_neg h2]
    rw [traceFrom_singleton_top s ys i (j + 1) h]

/-- L2.5 helper: `trace_cap_top` for a source `A ⌢ [s]` and an arbitrary start state. -/
theorem traceFrom_cap_top {β : Type} [LinearOrder β] [OrderTop β] (s : β) (A : List β) :
    ∀ (qry : List β) (i j : Nat), cursor (A ++ [s]) qry < A.length + 1 →
      traceFrom i j (A ++ [⊤]) qry = traceFrom i j (A ++ [s]) qry := by
  induction A with
  | nil =>
    intro qry i j h
    simp only [List.nil_append, List.length_nil, Nat.zero_add, Nat.lt_one_iff] at h ⊢
    exact traceFrom_singleton_top s qry i j h
  | cons a A ih =>
    intro qry
    induction qry with
    | nil => intro i j _; simp [traceFrom]
    | cons y ys ihq =>
      intro i j h
      simp only [List.cons_append, List.length_cons] at h ihq ⊢
      by_cases h1 : a < y
      · rw [cursor, if_pos h1] at h
        rw [traceFrom, traceFrom, if_pos h1, if_pos h1, ih (y :: ys) (i + 1) j (by omega)]
      · by_cases h2 : a = y
        · subst h2
          rw [cursor, if_neg h1, if_pos rfl] at h
          rw [traceFrom, traceFrom, if_neg h1, if_pos rfl, if_neg h1, if_pos rfl,
            ih ys (i + 1) (j + 1) (by omega)]
        · rw [cursor, if_neg h1, if_neg h2] at h
          rw [traceFrom, traceFrom, if_neg h1, if_neg h2, if_neg h1, if_neg h2, ihq i (j + 1) h]

/-- L2.5 (2) (`trace_cap_top`†, txt:239, 242-244): if a nonempty source is not exhausted,
replacing its last key by `⊤` preserves every cursor pair. -/
theorem trace_cap_top {β : Type} [LinearOrder β] [OrderTop β] {src qry : List β} (hne : src ≠ [])
    (hnx : cursor src qry < src.length) : trace (src.dropLast ++ [⊤]) qry = trace src qry := by
  have hsrc := List.dropLast_append_getLast hne
  have hlen : src.length = src.dropLast.length + 1 := by
    conv_lhs => rw [← hsrc]
    simp
  rw [← hsrc] at hnx
  unfold trace
  conv_rhs => rw [← hsrc]
  exact traceFrom_cap_top _ _ qry 0 0 (by rw [← hlen]; rwa [hsrc] at hnx ⊢)

/-- L2.5 helper: `trace_agree` from an arbitrary start state, with the sign hypothesis phrased
through `getElem?`. -/
theorem traceFrom_agree (u : Nat) : ∀ (src₁ src₂ qry : List α) (i j : Nat),
    src₁.take u = src₂.take u →
    (∃ x₁ x₂, src₁[u]? = some x₁ ∧ src₂[u]? = some x₂ ∧ ∀ y ∈ qry, compare x₁ y = compare x₂ y) →
    cursor src₁ qry ≤ u → traceFrom i j src₁ qry = traceFrom i j src₂ qry := by
  induction u with
  | zero =>
    intro src₁ src₂ qry i j _ hsign hrun
    obtain ⟨x₁, x₂, h₁, h₂, hs⟩ := hsign
    obtain ⟨S₁, rfl⟩ : ∃ S₁, src₁ = x₁ :: S₁ := by
      cases src₁ with
      | nil => simp at h₁
      | cons a S₁ => simp at h₁; exact ⟨S₁, by rw [h₁]⟩
    obtain ⟨S₂, rfl⟩ : ∃ S₂, src₂ = x₂ :: S₂ := by
      cases src₂ with
      | nil => simp at h₂
      | cons a S₂ => simp at h₂; exact ⟨S₂, by rw [h₂]⟩
    induction qry generalizing i j with
    | nil => simp [traceFrom]
    | cons y ys ihq =>
      have hy := hs y List.mem_cons_self
      have h1 : ¬ x₁ < y := fun hc => by rw [cursor, if_pos hc] at hrun; omega
      have h2 : ¬ x₁ = y := fun hc => by rw [cursor, if_neg h1, if_pos hc] at hrun; omega
      have hgt : compare x₁ y = .gt :=
        compare_gt_iff_gt.2 (lt_of_le_of_ne (not_lt.1 h1) (Ne.symm h2))
      have hgt' : y < x₂ := compare_gt_iff_gt.1 (hy ▸ hgt)
      have h3 : ¬ x₂ < y := not_lt.2 hgt'.le
      have h4 : ¬ x₂ = y := ne_of_gt hgt'
      rw [cursor, if_neg h1, if_neg h2] at hrun
      rw [traceFrom, traceFrom, if_neg h1, if_neg h2, if_neg h3, if_neg h4,
        ihq i (j + 1) (fun z hz => hs z (List.mem_cons_of_mem _ hz)) hrun]
  | succ u ih =>
    intro src₁ src₂ qry i j hpre hsign hrun
    obtain ⟨x₁, x₂, h₁, h₂, hs⟩ := hsign
    cases src₁ with
    | nil => simp at h₁
    | cons a S₁ =>
    cases src₂ with
    | nil => simp at h₂
    | cons b S₂ =>
    simp only [List.take_succ_cons, List.cons.injEq] at hpre
    obtain ⟨rfl, hpre⟩ := hpre
    simp only [List.getElem?_cons_succ] at h₁ h₂
    induction qry generalizing i j with
    | nil => simp [traceFrom]
    | cons y ys ihq =>
      by_cases h1 : a < y
      · rw [cursor, if_pos h1] at hrun
        rw [traceFrom, traceFrom, if_pos h1, if_pos h1,
          ih S₁ S₂ (y :: ys) (i + 1) j hpre ⟨x₁, x₂, h₁, h₂, hs⟩ (by omega)]
      · by_cases h2 : a = y
        · subst h2
          rw [cursor, if_neg h1, if_pos rfl] at hrun
          rw [traceFrom, traceFrom, if_neg h1, if_pos rfl, if_neg h1, if_pos rfl,
            ih S₁ S₂ ys (i + 1) (j + 1) hpre
              ⟨x₁, x₂, h₁, h₂, fun z hz => hs z (List.mem_cons_of_mem _ hz)⟩ (by omega)]
        · rw [cursor, if_neg h1, if_neg h2] at hrun
          rw [traceFrom, traceFrom, if_neg h1, if_neg h2, if_neg h1, if_neg h2,
            ihq i (j + 1) (fun z hz => hs z (List.mem_cons_of_mem _ hz)) hrun]

/-- L2.5 (3) (`trace_agree`†, txt:240-241, 244-245): sources agreeing before `u`, with keys at `u`
of identical signs against every query key, have the same trace for a run ending at or before
`u`. -/
theorem trace_agree {src₁ src₂ qry : List α} {u : Nat} (hpre : src₁.take u = src₂.take u)
    (hu₁ : u < src₁.length) (hu₂ : u < src₂.length)
    (hsign : ∀ y ∈ qry, compare src₁[u] y = compare src₂[u] y) (hrun : cursor src₁ qry ≤ u) :
    trace src₁ qry = trace src₂ qry :=
  traceFrom_agree u src₁ src₂ qry 0 0 hpre
    ⟨src₁[u], src₂[u], List.getElem?_eq_getElem hu₁, List.getElem?_eq_getElem hu₂, hsign⟩ hrun

end Words

/-- L2.5b (`cursor_eq_scanCount`†): the generic cursor at `Key` is the locked `scanCount`. -/
theorem cursor_eq_scanCount (xs ys : List Key) : scanCount xs ys = cursor xs ys := by
  induction xs, ys using cursor.induct with
  | case1 ys => simp [scanCount, cursor]
  | case2 x xs => simp [scanCount, cursor]
  | case3 x xs y ys h ih =>
    have hc : keyCmp x y = .lt := h
    rw [scanCount, cursor, if_pos h, ← ih, hc]
  | case4 xs y ys h ih =>
    have hc : keyCmp y y = .eq := Tree.cmp_self keyLabelCmp y
    rw [scanCount, cursor, if_neg h, if_pos rfl, ← ih, hc]
  | case5 x xs y ys h1 h2 ih =>
    have hc : keyCmp x y = .gt := by
      rw [← Key.compare_eq_keyCmp]
      exact compare_gt_iff_gt.2 (lt_of_le_of_ne (not_lt.1 h1) (Ne.symm h2))
    rw [scanCount, cursor, if_neg h1, if_neg h2, ← ih, hc]

/-! ## N1.2, C1.8a, C1.8, D1.9 — compact words and safe prefixes -/

/-- N1.2: atoms of the generic compact word over labels `α`: `(depth coordinate, marker, label)`,
the label `⊥` marking an empty column. -/
abbrev GAtom (α : Type) := Nat ×ₗ Nat ×ₗ WithBot α

mutual
/-- N1.2: the generic compact word at depth `e` (txt:143-146), with `⊥` in the empty-column
atom so that relabelling commutes with the word. -/
def gwordAt {α : Type} (e : Nat) : Tree α → List (GAtom α)
  | .node cols => gwordCols e cols

def gwordCols {α : Type} (e : Nat) : List (List (α × Tree α)) → List (GAtom α)
  | [] => []
  | col :: rest => gwordCol e col ++ gwordCols e rest

def gwordCol {α : Type} (e : Nat) : List (α × Tree α) → List (GAtom α)
  | [] => [toLex (2 * e, toLex (0, (⊥ : WithBot α)))]
  | (p, h) :: rest =>
    toLex (2 * e, toLex (1, (p : WithBot α))) :: (gwordAt (e + 1) h ++ gwordLater e rest)

def gwordLater {α : Type} (e : Nat) : List (α × Tree α) → List (GAtom α)
  | [] => []
  | (p, h) :: rest =>
    toLex (2 * e + 1, toLex (0, (p : WithBot α))) :: (gwordAt (e + 1) h ++ gwordLater e rest)
end

/-- N1.2. -/
def gword {α : Type} (t : Tree α) : List (GAtom α) := gwordAt 0 t

/-- N1.2: relabelling of an atom. -/
def GAtom.map {α β : Type} (f : α → β) (A : GAtom α) : GAtom β :=
  toLex ((ofLex A).1, toLex ((ofLex (ofLex A).2).1, (ofLex (ofLex A).2).2.map f))

/-- N1.2: the spine's word atoms, read as generic atoms (`⊥` exactly at even depth coordinate and
marker `0`, which only the empty-column atom has). -/
def toGAtom (A : WordAtom) : GAtom Nat :=
  toLex ((ofLex A).1, toLex ((ofLex (ofLex A).2).1,
    if (ofLex A).1 % 2 = 0 ∧ (ofLex (ofLex A).2).1 = 0 then (⊥ : WithBot Nat)
    else ((ofLex (ofLex A).2).2 : WithBot Nat)))

/-- N1.2: relabelling commutes with the generic word (positions and length are unchanged). -/
theorem gword_map {α β : Type} (f : α → β) (t : Tree α) :
    gword (t.map f) = (gword t).map (GAtom.map f) := by sorry

/-- N1.2: the spine's word is the generic word with the label decoration forgotten. -/
theorem gword_eq_map_word (E : Forest) : gword E = (word E).map toGAtom := by sorry

theorem mu_eq_length_gword (E : Forest) : mu E = (gword E).length := by sorry

/-- C1.8a: every atom of `gwordAt e t` has depth coordinate at least `2e`. -/
theorem gwordAt_fst_ge {α : Type} (e : Nat) (t : Tree α) :
    ∀ A ∈ gwordAt e t, 2 * e ≤ (ofLex A).1 := by sorry

/-- C1.8a (txt:147-151): with continuations whose first atoms have depth coordinate below `2e`,
comparison of words followed by continuations is comparison of the trees, then of the
continuations. -/
theorem gwordAt_append_lt_iff {α : Type} [LinearOrder α] (e : Nat) (s t : Tree α)
    {xs ys : List (GAtom α)} (hxs : ∀ A ∈ xs.head?, (ofLex A).1 < 2 * e)
    (hys : ∀ A ∈ ys.head?, (ofLex A).1 < 2 * e) :
    gwordAt e s ++ xs < gwordAt e t ++ ys ↔
      Tree.cmp compare s t = .lt ∨ (s = t ∧ xs < ys) := by sorry

/-- C1.8a: injectivity with continuations. -/
theorem gwordAt_append_inj {α : Type} (e : Nat) {s t : Tree α} {xs ys : List (GAtom α)}
    (hxs : ∀ A ∈ xs.head?, (ofLex A).1 < 2 * e) (hys : ∀ A ∈ ys.head?, (ofLex A).1 < 2 * e)
    (h : gwordAt e s ++ xs = gwordAt e t ++ ys) : s = t ∧ xs = ys := by sorry

/-- C1.8a: the generic word is an order embedding. -/
theorem gword_lt_iff {α : Type} [LinearOrder α] (s t : Tree α) :
    gword s < gword t ↔ Tree.cmp compare s t = .lt := by sorry

theorem gword_injective {α : Type} : Function.Injective (gword : Tree α → List (GAtom α)) := by
  sorry

/-- N1.3: a map strictly increasing on the letters that occur preserves list order. -/
theorem list_map_lt_iff {γ δ : Type} [LinearOrder γ] [LinearOrder δ] {f : γ → δ} {S : Set γ}
    (hf : StrictMonoOn f S) {l₁ l₂ : List γ} (h₁ : ∀ x ∈ l₁, x ∈ S) (h₂ : ∀ x ∈ l₂, x ∈ S) :
    l₁.map f < l₂.map f ↔ l₁ < l₂ := by sorry

/-- N1.3: a comparison with `Y` is decided within the first `|Y| + 1` letters. -/
theorem list_lt_of_take_eq {γ : Type} [LinearOrder γ] {X₁ X₂ Y : List γ}
    (hlen : Y.length < X₁.length) (h : X₁.take (Y.length + 1) = X₂.take (Y.length + 1)) :
    (X₁ < Y ↔ X₂ < Y) ∧ X₁ ≠ Y ∧ X₂ ≠ Y := by sorry

/-- N1.2: the shapes of atoms that occur in words: `(2e, 0, 0)`, `(2e, 1, p)`, `(2e+1, 0, p)`. -/
def WordAtom.WF (A : WordAtom) : Prop :=
  ((ofLex A).1 % 2 = 0 ∧ (((ofLex (ofLex A).2).1 = 0 ∧ (ofLex (ofLex A).2).2 = 0) ∨
      (ofLex (ofLex A).2).1 = 1)) ∨
    ((ofLex A).1 % 2 = 1 ∧ (ofLex (ofLex A).2).1 = 0)

/-- N1.2: every atom of a word is well formed. -/
theorem word_wf (E : Forest) : ∀ A ∈ word E, A.WF := by sorry

/-- N1.2: `toGAtom` is strictly increasing on well-formed atoms. -/
theorem toGAtom_strictMonoOn : StrictMonoOn toGAtom {A : WordAtom | A.WF} := by sorry

-- bridge: holds by `rfl` (SCR-2 applied)
theorem safePrefix_eq_body (E : Forest) (k : Nat) : safePrefix E k = safePrefixBody E k := by sorry

/-- D1.9a: the budget bookkeeping of `spF` (the invariant behind `word_safePrefix`):
`word (spF k E).1 = (word E).take k` and the unused budget is `k - µ(E)`. -/
theorem spF_spec (e k : Nat) (E : Forest) :
    wordAt e (spF k E).1 = (wordAt e E).take k ∧ (spF k E).2 = k - (wordAt e E).length := by sorry

/-- D1.9: a safe prefix of full length is the whole forest. -/
theorem safePrefix_of_le {E : Forest} {k : Nat} (hk : mu E ≤ k) : safePrefix E k = E := by sorry

/-- D1.9: a safe prefix is `≤` the forest (by `word_safePrefix` and `word_lt_iff`). -/
theorem safePrefix_le (E : Forest) (k : Nat) : safePrefix E k ≤ E := by sorry

/-- D1.9 (txt:152-153): every column of a safe prefix is a prefix of the corresponding column,
nonempty if the original column is nonempty; every kept entry keeps its parent and its height is
a safe prefix of the original height. -/
theorem colAt_safePrefix {E : Forest} {k : Nat} {c : ColAddr} {col' : Column}
    (h : (safePrefix E k).colAt c = some col') :
    ∃ col, E.colAt c = some col ∧ col'.length ≤ col.length ∧ (col' = [] → col = []) ∧
      ∀ (i p' : Nat) (H' : Forest), col'[i]? = some (p', H') →
        ∃ (H : Forest) (j : Nat), col[i]? = some (p', H) ∧ H' = safePrefix H j := by sorry

/-- D1.9a: the word of a truncation after an entry is a prefix of the word. -/
theorem word_truncAfter_prefix (E : Forest) (e : EntryAddr) : word (E.truncAfter e) <+: word E := by
  sorry

/-- L2.5c (`sign_of_agreement`†, txt:246-249): if two height words agree for more atoms than the
length of a query height, their normalized comparisons with it have the same strict sign; the
thresholds are arbitrary. -/
theorem sign_of_agreement (r t : Nat) {A₁ A₂ J : Forest} (hlen : mu J < mu A₁)
    (hagree : (word A₁).take (mu J + 1) = (word A₂).take (mu J + 1)) :
    keyCmp (relKey r A₁) (relKey t J) = keyCmp (relKey r A₂) (relKey t J) ∧
      keyCmp (relKey r A₁) (relKey t J) ≠ .eq := by
  -- generic words of keys (labels `Bool × Nat`), in terms of the compact word
  have hg : ∀ (a : Nat) (A : Forest), (gword (relKey a A) : List (GAtom (Bool × Nat))) =
      (word A).map (GAtom.map (relLabel a) ∘ toGAtom) := by
    intro a A
    rw [relKey_eq_map, gword_map, gword_eq_map_word, List.map_map]
  -- the same words read over `Lex (Bool × Nat)`, whose `Tree.cmp compare` is `keyCmp`
  let X₁ : List (GAtom (Lex (Bool × Nat))) := gword (relKey r A₁ : Tree (Lex (Bool × Nat)))
  let X₂ : List (GAtom (Lex (Bool × Nat))) := gword (relKey r A₂ : Tree (Lex (Bool × Nat)))
  let Y : List (GAtom (Lex (Bool × Nat))) := gword (relKey t J : Tree (Lex (Bool × Nat)))
  have hY : Y.length = mu J := by
    change (gword (relKey t J) : List (GAtom (Bool × Nat))).length = mu J
    rw [hg, List.length_map]; rfl
  have hX₁ : X₁.length = mu A₁ := by
    change (gword (relKey r A₁) : List (GAtom (Bool × Nat))).length = mu A₁
    rw [hg, List.length_map]; rfl
  have htake : X₁.take (Y.length + 1) = X₂.take (Y.length + 1) := by
    rw [hY]
    change (gword (relKey r A₁) : List (GAtom (Bool × Nat))).take (mu J + 1) =
      (gword (relKey r A₂) : List (GAtom (Bool × Nat))).take (mu J + 1)
    rw [hg, hg, ← List.map_take, ← List.map_take, hagree]
  obtain ⟨hlt, hne₁, hne₂⟩ := list_lt_of_take_eq (by rw [hY, hX₁]; exact hlen) htake
  have hlt₁ : X₁ < Y ↔ keyCmp (relKey r A₁) (relKey t J) = .lt :=
    gword_lt_iff (α := Lex (Bool × Nat)) _ _
  have hlt₂ : X₂ < Y ↔ keyCmp (relKey r A₂) (relKey t J) = .lt :=
    gword_lt_iff (α := Lex (Bool × Nat)) _ _
  have heq₁ : keyCmp (relKey r A₁) (relKey t J) ≠ .eq := fun h =>
    hne₁ (congrArg (gword (α := Lex (Bool × Nat))) (Tree.eq_of_cmp_eq keyLabelCmp h))
  have heq₂ : keyCmp (relKey r A₂) (relKey t J) ≠ .eq := fun h =>
    hne₂ (congrArg (gword (α := Lex (Bool × Nat))) (Tree.eq_of_cmp_eq keyLabelCmp h))
  refine ⟨?_, heq₁⟩
  have hiff := hlt₁.symm.trans (hlt.trans hlt₂)
  revert heq₁ heq₂ hiff
  cases keyCmp (relKey r A₁) (relKey t J) <;> cases keyCmp (relKey r A₂) (relKey t J) <;> simp

/-- L2.5c helper: the coercion into `WithTop` preserves `compare`. -/
theorem compare_coe_withTop {β : Type} [LinearOrder β] (a b : β) :
    compare (a : WithTop β) (b : WithTop β) = compare a b := by
  rcases lt_trichotomy a b with h | h | h
  · rw [compare_lt_iff_lt.2 h, compare_lt_iff_lt.2 (WithTop.coe_lt_coe.2 h)]
  · subst h; rw [compare_eq_iff_eq.2 rfl, compare_eq_iff_eq.2 rfl]
  · rw [compare_gt_iff_gt.2 h, compare_gt_iff_gt.2 (WithTop.coe_lt_coe.2 h)]

-- U1-verify: changed (new declaration)
/-- L2.5c, key-system form: the sign hypothesis `hsign` of `trace_agree` at `α = WithTop Key`,
for one query key. -/
theorem sign_of_agreement_compare (r t : Nat) {A₁ A₂ J : Forest} (hlen : mu J < mu A₁)
    (hagree : (word A₁).take (mu J + 1) = (word A₂).take (mu J + 1)) :
    compare ((relKey r A₁ : Key) : WithTop Key) ((relKey t J : Key) : WithTop Key) =
      compare ((relKey r A₂ : Key) : WithTop Key) ((relKey t J : Key) : WithTop Key) := by
  rw [compare_coe_withTop, compare_coe_withTop, Key.compare_eq_keyCmp, Key.compare_eq_keyCmp]
  exact (sign_of_agreement r t hlen hagree).1

/-! ## D1.5a — shifts and the continuation hole (S-6) -/

theorem shiftVal_zero (r p : Nat) : shiftVal r 0 p = p := by
  unfold shiftVal; split <;> rfl

/-- D1.5a helper: `shiftVal r 0` is the identity function. -/
theorem shiftVal_zero_fun (r : Nat) : shiftVal r 0 = id := funext (shiftVal_zero r)

mutual
/-- D1.5a helper: `Tree.map id` is the identity. -/
theorem treeMap_id {α : Type} : (t : Tree α) → Tree.map id t = t
  | .node cols => by
    simp only [Tree.map]; rw [treeMapCols_id]
theorem treeMapCols_id {α : Type} :
    (cs : List (List (α × Tree α))) → Tree.mapCols id cs = cs
  | [] => rfl
  | c :: cs => by
    simp only [Tree.mapCols]; rw [treeMapCol_id, treeMapCols_id]
theorem treeMapCol_id {α : Type} :
    (c : List (α × Tree α)) → Tree.mapCol id c = c
  | [] => rfl
  | (p, h) :: es => by
    simp only [Tree.mapCol]; rw [treeMap_id, treeMapCol_id]; rfl
end

/-- D1.5a. -/
theorem shift_zero (r : Nat) (F : Forest) : shift r 0 F = F := by
  unfold shift; rw [shiftVal_zero_fun]; exact treeMap_id F

mutual
/-- D1.5a helper: relabellings compose. -/
theorem treeMap_map {α β γ : Type} (f : β → γ) (g : α → β) :
    (t : Tree α) → Tree.map f (Tree.map g t) = Tree.map (f ∘ g) t
  | .node cols => by
    simp only [Tree.map]; rw [treeMapCols_map]
theorem treeMapCols_map {α β γ : Type} (f : β → γ) (g : α → β) :
    (cs : List (List (α × Tree α))) → Tree.mapCols f (Tree.mapCols g cs) = Tree.mapCols (f ∘ g) cs
  | [] => rfl
  | c :: cs => by
    simp only [Tree.mapCols]; rw [treeMapCol_map, treeMapCols_map]
theorem treeMapCol_map {α β γ : Type} (f : β → γ) (g : α → β) :
    (c : List (α × Tree α)) → Tree.mapCol f (Tree.mapCol g c) = Tree.mapCol (f ∘ g) c
  | [] => rfl
  | (p, h) :: es => by
    simp only [Tree.mapCol]; rw [treeMap_map, treeMapCol_map]; rfl
end

/-- D1.5a helper: `shiftVal` at one threshold composes additively. -/
theorem shiftVal_add (r d d' : Nat) : shiftVal r d ∘ shiftVal r d' = shiftVal r (d + d') := by
  funext p; simp only [Function.comp, shiftVal]; split_ifs <;> omega

/-- D1.5a: shifts at one threshold compose additively. -/
theorem shift_add (r d d' : Nat) (F : Forest) : shift r d (shift r d' F) = shift r (d + d') F := by
  unfold shift; rw [treeMap_map, shiftVal_add]

/-- D1.5a: `mapLast` (locked) in list form. -/
theorem mapLast_eq {γ δ : Type} (f g : γ → δ) (l : List γ) :
    mapLast f g l = l.dropLast.map f ++ (l.getLast?.map g).toList :=
  match l with
  | [] => by simp [mapLast]
  | [x] => by simp [mapLast]
  | x :: y :: ys => by rw [mapLast, mapLast_eq f g (y :: ys)]; simp

/-- D1.5a: the unshifted placement of `Z` into the hole (`A_{0,0,depth,Z}`). -/
def Hole.put (h : Hole) (Z : Forest) : Forest := replaceAt 0 0 Z h.depth h.outer

/-- D1.5a helper: `Tree.mapCols` in list form. -/
theorem treeMapCols_eq_map {α β : Type} (f : α → β) (cs : List (List (α × Tree α))) :
    Tree.mapCols f cs = cs.map (Tree.mapCol f) := by
  induction cs with
  | nil => rfl
  | cons c cs ih => simp only [Tree.mapCols, List.map_cons, ih]

/-- D1.5a helper: `Tree.mapCol` in list form. -/
theorem treeMapCol_eq_map {α β : Type} (f : α → β) (c : List (α × Tree α)) :
    Tree.mapCol f c = c.map (fun x => (f x.1, Tree.map f x.2)) := by
  induction c with
  | nil => rfl
  | cons x c ih => obtain ⟨p, h⟩ := x; simp only [Tree.mapCol, List.map_cons, ih]

/-- D1.5a helper: `mapLast` after a `map`. -/
theorem mapLast_map {γ δ ε : Type} (f g : δ → ε) (h : γ → δ) (l : List γ) :
    mapLast f g (l.map h) = mapLast (f ∘ h) (g ∘ h) l := by
  rw [mapLast_eq, mapLast_eq]; simp [List.map_dropLast, Option.map_map]

/-- D1.5a helper: `Tree.mapCol id` is the identity function. -/
theorem treeMapCol_id_fun {α : Type} : Tree.mapCol (α := α) id = id := funext treeMapCol_id

/-- D1.5a helper: `A_{r,d,k,Z}(F) = A_{0,0,k,Z}(T_{r,d}(F))`, by induction on `k` following the
locked `replaceAt`. -/
theorem replaceAt_eq_shift (r d : Nat) (Z : Forest) :
    ∀ (k : Nat) (F : Forest), replaceAt r d Z k F = replaceAt 0 0 Z k (shift r d F)
  | 0, .node [] => by simp [replaceAt, shift, Tree.map, Tree.mapCols]
  | 0, .node (c :: cs) => by
    simp only [replaceAt, shift, Tree.map, Tree.mapCols]
    rw [shiftVal_zero_fun 0, treeMapCol_id_fun, List.map_id, treeMapCols_eq_map, ← List.map_cons,
      List.map_dropLast]
  | k + 1, .node cols => by
    simp only [replaceAt, shift, Tree.map]
    rw [shiftVal_zero_fun 0, treeMapCol_id_fun, treeMapCols_eq_map, mapLast_map]
    congr 1
    congr 1
    funext c
    rw [Function.comp, treeMapCol_eq_map, mapLast_map]
    congr 1
    · funext x; simp only [Function.comp, id, treeMap_id]
    · funext x
      simp only [Function.comp, id]
      rw [replaceAt_eq_shift r d Z k x.2]
      rfl

/-- D1.5a (fill/shift law): `A_{r,d,ℓ,Z}(F)` is `T_{r,d}(F)` with `Z` placed unshifted. -/
theorem Hole.fill_eq_put (h : Hole) (r d : Nat) (Z : Forest) :
    h.fill r d Z = (⟨shift r d h.outer, h.depth⟩ : Hole).put Z :=
  replaceAt_eq_shift r d Z h.depth h.outer

theorem Hole.fill_zero (h : Hole) (Z : Forest) : h.fill 0 0 Z = h.put Z := by
  rw [Hole.fill_eq_put, shift_zero]

/-- D1.5a helper: the word of a list of columns splits over an append. -/
theorem wordCols_append (e : Nat) (l₁ l₂ : List Column) :
    wordCols e (l₁ ++ l₂) = wordCols e l₁ ++ wordCols e l₂ := by
  induction l₁ with
  | nil => rfl
  | cons c l ih => simp only [List.cons_append, wordCols, ih, List.append_assoc]

/-- D1.5a helper: the height of the last later entry is read last. -/
theorem wordLater_snoc (e : Nat) (l : Column) (q : Nat) (H : Forest) :
    wordLater e (l ++ [(q, H)]) = wordLater e (l ++ [(q, Tree.empty)]) ++ wordAt (e + 1) H := by
  induction l with
  | nil => simp [wordLater, Tree.empty, wordAt, wordCols]
  | cons x l ih =>
    obtain ⟨p, h⟩ := x
    simp only [List.cons_append, wordLater, ih, List.append_assoc]

/-- D1.5a helper: the height of the last entry of a column is read last. -/
theorem wordCol_snoc (e : Nat) (l : Column) (q : Nat) (H : Forest) :
    wordCol e (l ++ [(q, H)]) = wordCol e (l ++ [(q, Tree.empty)]) ++ wordAt (e + 1) H := by
  cases l with
  | nil => simp [wordCol, wordLater, Tree.empty, wordAt, wordCols]
  | cons x l =>
    obtain ⟨p, h⟩ := x
    simp only [List.cons_append, wordCol]
    rw [wordLater_snoc]
    simp only [List.append_assoc]

/-- D1.5a helper: a forest with a nonempty route has columns. -/
theorem routeColsAux_pos {fuel : Nat} {F : Forest} {π : List (Nat × Nat)}
    (h : 0 < (routeColsAux fuel F π).length) : F.cols ≠ [] := by
  cases fuel with
  | zero => simp [routeColsAux] at h
  | succ f =>
    rw [routeColsAux] at h
    intro hF
    rw [hF] at h
    simp at h

/-- D1.5a helper: a route longer than `k + 1` continues into the height of the last entry of a
nonempty last column. -/
theorem routeColsAux_succ_lt {fuel : Nat} {F : Forest} {π : List (Nat × Nat)} {k : Nat}
    (h : k + 1 < (routeColsAux fuel F π).length) :
    ∃ fuel' col p H, fuel = fuel' + 1 ∧ F.cols.getLast? = some col ∧ col.getLast? = some (p, H) ∧
      k < (routeColsAux fuel' H (π ++ [(F.cols.length - 1, col.length - 1)])).length := by
  cases fuel with
  | zero => simp [routeColsAux] at h
  | succ f =>
    rw [routeColsAux] at h
    cases hc : F.cols.getLast? with
    | none => simp [hc] at h
    | some col =>
      simp only [hc] at h
      cases hl : col.getLast? with
      | none => simp [hl] at h
      | some ph =>
        obtain ⟨p, H⟩ := ph
        simp only [hl, List.length_cons] at h
        exact ⟨f, col, p, H, rfl, rfl, hl, by omega⟩

/-- D1.5a helper: `word_put` at an arbitrary depth coordinate `e` and fuel. -/
theorem wordAt_replaceAt (Z : Forest) :
    ∀ (k fuel : Nat) (F : Forest) (π : List (Nat × Nat)) (e : Nat),
      k < (routeColsAux fuel F π).length →
      wordAt e (replaceAt 0 0 Z k F) = wordAt e (replaceAt 0 0 Tree.empty k F) ++ wordAt (e + k) Z
  | 0, fuel, .node cols, π, e, h => by
    have hne := routeColsAux_pos h
    obtain ⟨zc⟩ := Z
    cases cols with
    | nil => exact absurd rfl hne
    | cons c cs =>
      simp only [replaceAt, wordAt, Tree.cols, Tree.empty, List.append_nil, wordCols_append,
        Nat.add_zero]
  | k + 1, fuel, .node cols, π, e, h => by
    obtain ⟨fuel', col, p, H, rfl, hc, hl, hk⟩ := routeColsAux_succ_lt h
    have ih := wordAt_replaceAt Z k fuel' H _ (e + 1) hk
    simp only [Tree.cols] at hc
    simp only [replaceAt, mapLast_eq, hc, hl, Option.map_some, Option.toList_some, wordAt,
      wordCols_append, wordCols, List.append_nil]
    rw [wordCol_snoc, wordCol_snoc e _ _ (replaceAt 0 0 Tree.empty k H), ih]
    simp only [List.append_assoc]
    rw [show e + 1 + k = e + (k + 1) by omega]

/-- D1.5a: the word of a filled hole is the word with the hole emptied, followed by the word of
`Z` at the hole's depth (the hole column is the last thing in reading order). -/
theorem word_put (h : Hole) (Z : Forest) (hd : h.depth < (routeCols h.outer).length) :
    word (h.put Z) = word (h.put Tree.empty) ++ wordAt h.depth Z := by
  have := wordAt_replaceAt Z h.depth _ h.outer [] 0 hd
  rw [Nat.zero_add] at this
  exact this

/-- D1.5a: the generic word of a shift relabels the generic word. -/
theorem gword_shift (r d : Nat) (F : Forest) :
    gword (shift r d F) = (gword F).map (GAtom.map (shiftVal r d)) := gword_map _ _

/-! ## D1.6, D1.6b — the paper's operation written from §1.2 (G-001) -/

-- bridges: hold by `rfl` (SCR-2 applied)
theorem stopData_eq_body (E : Forest) : stopData E = stopDataBody E := by sorry
theorem stepKind_eq_body (E : Forest) : stepKind E = stepKindBody E := by sorry
theorem rootData_eq_body (E : Forest) : rootData E = rootDataBody E := by sorry
theorem paperOp_eq_body (E : Forest) (n : Nat) : paperOp E n = paperOpBody E n := by sorry

/-! ### D1.6b — branch data specifications -/

/-- D1.6b (`stopData_spec`†): the stopping column `Q ⌢ [(r, ∅)]` is the last route column. -/
theorem stopData_spec {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    E.colAt sd.col = some (sd.Q ++ [(sd.r, Tree.empty)]) ∧ sd.depth = sd.col.path.length ∧
      sd.t = sd.col.num 0 ∧ sd.col ∈ routeCols E ∧ (routeCols E).getLast? = some sd.col ∧
      (routeCols E).length = sd.depth + 1 := by sorry

/-- D1.6b: under I the route is never stuck (X-02 cannot happen). -/
theorem stopData_isSome {E : Forest} (hI : CondI E) {col : Column}
    (hlast : E.cols.getLast? = some col) (hne : col ≠ []) : (stopData E).isSome := by sorry

/-- D1.6b: `stopData` is `none` on `∅` and on a last outer column that is empty. -/
theorem stopData_eq_none_of_lastCol {E : Forest} (h : E.cols.getLast? = none ∨ E.cols.getLast? = some []) :
    stopData E = none := by sorry

/-- D1.6b: the deletion branch is exactly an empty last outer column. -/
theorem stepKind_deletion_iff (E : Forest) : stepKind E = some .deletion ↔ E.cols.getLast? = some [] := by
  sorry

/-- D1.6b: the special branch is exactly `specialStop`. -/
theorem stepKind_special_iff (E : Forest) :
    stepKind E = some .special ↔ ∃ sd, stopData E = some sd ∧ specialStop sd = true := by sorry

/-- D1.6b: the ordinary branch: a stop that is not special with a visible root. -/
theorem stepKind_ordinary_iff (E : Forest) :
    stepKind E = some .ordinary ↔ ∃ sd o, stopData E = some sd ∧ specialStop sd = false ∧
      sd.col.resolve 0 sd.r = some o := by sorry

/-- D1.6b (`rootData_spec`†). -/
theorem rootData_spec {E : Forest} {sd : StopData} {rd : RootData} (hsd : stopData E = some sd)
    (hrd : rootData E = some rd) :
    sd.col.resolve 0 sd.r = some rd.col ∧ rd.layer = rd.col.path.length ∧ rd.idx = rd.col.col ∧
      rd.col.num 0 = sd.r ∧ sd.r < sd.t ∧ rd.col ∈ E.colAddrs ∧
      rd.cursor = cursor (rootKeys E rd) (queryKeys sd) ∧
      (rd.owner = true ↔ ∃ F, E.forestAt rd.col.path = some F ∧ rd.col.col + 1 = F.cols.length) := by
  sorry

/-- D1.6b: the root is an owner iff it contains the stopping column; then the containing entry is
its last entry (the active root entry `u`). -/
theorem rootData_owner_iff {E : Forest} {sd : StopData} {rd : RootData} (hsd : stopData E = some sd)
    (hrd : rootData E = some rd) :
    rd.owner = true ↔ ∃ u, (⟨rd.col, u⟩ : EntryAddr).Contains sd.col ∧
      u + 1 = ((E.colAt rd.col).getD []).length := by sorry

/-- D1.6b: in the owner case the root layer is strictly above the stopping depth. -/
theorem rootData_layer_lt {E : Forest} {sd : StopData} {rd : RootData} (hsd : stopData E = some sd)
    (hrd : rootData E = some rd) (ho : rd.owner = true) : rd.layer < sd.depth := by sorry

theorem rootData_layer_le {E : Forest} {sd : StopData} {rd : RootData} (hsd : stopData E = some sd)
    (hrd : rootData E = some rd) : rd.layer ≤ sd.depth := by sorry

/-- D1.6b: the special owner entry is the last entry of the owner column, its height is the
stopping forest, which ends in the single-entry column `[(r, ∅)]`. -/
theorem ownerEntry_spec {E : Forest} {sd : StopData} {oe : EntryAddr}
    (hk : stepKind E = some .special) (hsd : stopData E = some sd) (hoe : sd.ownerEntry = some oe) :
    oe.Contains sd.col ∧ oe.heightPath = sd.col.path ∧ oe.col.num 0 = sd.r ∧
      ∃ col p Fl, E.colAt oe.col = some col ∧ col.getLast? = some (p, Fl) ∧
        oe.idx + 1 = col.length ∧ Fl.cols.getLast? = some [(sd.r, Tree.empty)] := by sorry

/-- D1.6b (`paperOp_deletion`). -/
theorem paperOp_deletion {E : Forest} (h : stepKind E = some .deletion) (n : Nat) :
    paperOp E n = some (.node E.cols.dropLast) := by sorry

/-- D1.6b (`paperOp_special`†): the special output, in terms of `Hole.fill`. -/
theorem paperOp_special {E : Forest} {sd : StopData} {oe : EntryAddr} {col : Column} {p : Nat}
    {Fl : Forest} (hk : stepKind E = some .special) (hsd : stopData E = some sd)
    (hoe : sd.ownerEntry = some oe) (hcol : E.colAt oe.col = some col)
    (hlast : col.getLast? = some (p, Fl)) (n : Nat) :
    paperOp E n = some (Hole.fill ⟨E, sd.depth - 1⟩ 0 0
      (.node [col.dropLast ++
        List.replicate (n + if col.dropLast.isEmpty then 1 else 0) (p, .node Fl.cols.dropLast)])) := by
  sorry

/-- D1.6b (`paperOp_ordinary`†): the ordinary output, in terms of `Hole.fill` and `ordZ`. -/
theorem paperOp_ordinary {E : Forest} {sd : StopData} {rd : RootData}
    (hk : stepKind E = some .ordinary) (hsd : stopData E = some sd) (hrd : rootData E = some rd)
    (n : Nat) :
    paperOp E n =
      if rd.owner && n != 0 && (((E.colAt rd.col).getD []).drop rd.cursor).isEmpty then none
      else some (Hole.fill ⟨E, sd.depth⟩ 0 0 (ordZ E sd rd n)) := by sorry

/-- D1.6b: the ordinary step at parameter `0` deletes the whole stopping column (txt:132-133). -/
theorem paperOp_ordinary_zero {E : Forest} {sd : StopData} (hk : stepKind E = some .ordinary)
    (hsd : stopData E = some sd) : paperOp E 0 = some (Hole.put ⟨E, sd.depth⟩ Tree.empty) := by sorry

/-! ### D1.6c — agreement of the locked `expand` with `paperOp` (G-001, D-3) -/

/-- D1.6c: the reference's depth agrees with the paper's route whenever the latter stops
(no use of I). -/
theorem tailLayer_of_stopData {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    tailLayer E = (sd.depth : Int) := by sorry

/-- D1.6c: the reference's deletion test. -/
theorem tailLayer_neg_iff {E : Forest} (hE : E ≠ Tree.empty) :
    tailLayer E < 0 ↔ E.cols.getLast? = some [] := by sorry

/-- D1.6c: the reference's layers are the paper's route forests. -/
theorem skipLayers_of_stopData {E : Forest} {sd : StopData} (h : stopData E = some sd) {d : Nat}
    (hd : d ≤ sd.depth) : E.forestAt (sd.col.path.take d) = some (skipLayers E d) := by sorry

theorem skipLayers_add (E : Forest) (a b : Nat) : skipLayers (skipLayers E a) b = skipLayers E (a + b) := by
  sorry

/-- D1.6c: `leftCount` counts the columns of the layers above `d` (no hypothesis). -/
theorem leftCount_eq_sum (E : Forest) (d : Nat) :
    leftCount E d = ((List.range d).map fun k => (skipLayers E k).cols.length).sum := by sorry

/-- D1.6c: `t` agrees (txt:101-103). -/
theorem tailNum_of_stopData {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    tailNum E sd.depth = sd.t := by sorry

/-- D1.6c: `r` agrees. -/
theorem rootAt_of_stopData {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    rootAt E sd.depth = sd.r := by sorry

/-- D1.6c: the special tests agree. -/
theorem isSpecial_of_stopData {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    isSpecial E sd.depth = specialStop sd := by sorry

/-- D1.6c: the special outputs agree. -/
theorem expandSpecial_of_stopData {E : Forest} {sd : StopData} (h : stopData E = some sd)
    (hs : specialStop sd = true) (n : Nat) : some (expandSpecial n sd.depth E) = specialOut E sd n := by
  sorry

/-- D1.6c: the reference's root search finds the paper's visible root. -/
theorem rootLayer_of_resolve {E : Forest} {sd : StopData} {o : ColAddr} (h : stopData E = some sd)
    (ho : sd.col.resolve 0 sd.r = some o) : rootLayer E sd.r sd.depth = some (o.path.length, o.col) := by
  sorry

/-- D1.6c: the reference's scan start is the paper's cursor. -/
theorem rootAppendingStart_of_rootData {E : Forest} {sd : StopData} {rd : RootData}
    (hsd : stopData E = some sd) (hrd : rootData E = some rd) :
    rootAppendingStart ((E.colAt rd.col).getD []) sd.r (sd.Q ++ [(sd.r, Tree.empty)]) sd.t =
      rd.cursor := by sorry

/-- D1.6c: `ascendReplace` at a nonnegative depth is `Hole.fill`. -/
theorem ascendReplace_ofNat (r d k : Nat) (Z F : Forest) :
    ascendReplace r d (some (k : Int)) Z F = Hole.fill ⟨F, k⟩ r d Z := by sorry

/-- D1.6c: the loops agree. -/
theorem iterDown_eq_ordLoop (step : Nat → Forest → Forest) (n : Nat) (Z : Forest) :
    iterDown step n Z = ordLoop step n Z := by sorry

/-- D1.6c: agreement on every input where the paper's route stops at a special step. -/
theorem expand_eq_paperOp_special {E : Forest} {sd : StopData} (h : stopData E = some sd)
    (hs : specialStop sd = true) (n : Nat) : expand E n = paperOp E n := by sorry

/-- D1.6c: agreement on every input where the paper's route stops at a non-special step with a
visible root. -/
theorem expand_eq_paperOp_ordinary {E : Forest} {sd : StopData} {o : ColAddr}
    (h : stopData E = some sd) (hs : specialStop sd = false) (ho : sd.col.resolve 0 sd.r = some o)
    (n : Nat) : expand E n = paperOp E n := by sorry

/-- D1.6c: under V the root of a stop is visible. -/
theorem resolve_root_of_condV {E : Forest} (hV : CondV E) {sd : StopData} (h : stopData E = some sd) :
    (sd.col.resolve 0 sd.r).isSome := by sorry

/-! ## D2.2a — responses, edges and paths -/

/-- D2.2a: the start `x(c,k)` of the cut-`k` test of column `c` (codex-crosscheck-1 Q2):
`c - 1` at `k = 0`, else the parent of entry `k - 1`. -/
def cutStart (E : Forest) (c : ColAddr) (k : Nat) : Nat :=
  if k = 0 then c.num 0 - 1 else ((parents E c)[k - 1]?).getD 0

/-- D2.2a: condition A at entry `i` of column `c` in key system `ks`. -/
def AAt (E : Forest) (ks : KeySys) (c : ColAddr) (i : Nat) : Prop :=
  ∀ p, (parents E c)[i]? = some p → Path E ks c (cutQuery (ks c) i) (cutStart E c i) p

/-- D2.2a: `CondAK` is `AAt` at every entry. -/
theorem condAK_iff (E : Forest) (ks : KeySys) :
    CondAK E ks ↔ ∀ c ∈ E.colAddrs, ∀ i, AAt E ks c i := Iff.rfl

/-- D2.2a: the (deterministic) response function of an edge read on the stack of `c`. -/
def respEdge (E : Forest) (ks : KeySys) (c : ColAddr) (W : List (WithTop Key)) (x : Nat) :
    Option Nat :=
  (c.resolve 0 x).bind fun o => resp E ks o W

theorem edge_iff (E : Forest) (ks : KeySys) (c : ColAddr) (W : List (WithTop Key)) (x p : Nat) :
    Edge E ks c W x p ↔ respEdge E ks c W x = some p := by
  unfold Edge respEdge
  rw [Option.bind_eq_some_iff]

/-- D2.2a: `resp` in terms of the cursor. -/
theorem resp_eq_some {E : Forest} {ks : KeySys} {o : ColAddr} {W : List (WithTop Key)} {p : Nat} :
    resp E ks o W = some p ↔ ∃ H, ((E.colAt o).getD [])[cursor (ks o) W]? = some (p, H) := by
  unfold resp
  constructor
  · intro h
    obtain ⟨⟨q, H⟩, h1, h2⟩ := Option.map_eq_some_iff.1 h
    exact ⟨H, by rw [h1, show q = p from h2]⟩
  · rintro ⟨H, h⟩
    rw [h]; rfl

/-- D2.2a: the number of keys is the number of entries, for actual and capped systems. -/
theorem length_actualKeys (E : Forest) (c : ColAddr) :
    (actualKeys E c).length = ((E.colAt c).getD []).length := by
  simp [actualKeys]

theorem length_capKeys (E : Forest) (sel : List ColAddr) (c : ColAddr) :
    (capKeys E sel c).length = ((E.colAt c).getD []).length := by
  rw [← length_actualKeys E c]
  simp only [capKeys]
  split_ifs
  · rcases List.eq_nil_or_concat (actualKeys E c) with h | ⟨L, b, h⟩
    · simp [h]
    · simp [h]
  · rfl

-- Moved here from the D1.3a section below (brief rule 5; statement unchanged): `edge_lt` and
-- `cutStart_lt` use it, and nothing in between uses it.
/-- D2.2a: parents of a column, entrywise. -/
theorem parents_getElem? (E : Forest) (c : ColAddr) (k : Nat) :
    (parents E c)[k]? = (E.entryAt ⟨c, k⟩).map Prod.fst := by
  unfold parents Tree.entryAt
  cases E.colAt c <;> simp

/-- D2.2a helper: under V the parent of an entry of column `o` is below `o`'s number. -/
theorem parent_lt_num_of_condV {E : Forest} (hV : CondV E) {o : ColAddr} {k p : Nat} {H : Forest}
    (he : E.entryAt ⟨o, k⟩ = some (p, H)) : p < o.num 0 := by
  have hmem : (⟨o, k⟩ : EntryAddr) ∈ E.entryAddrs :=
    (Tree.mem_entryAddrs_iff E _).2 (by rw [he]; rfl)
  exact ((ColAddr.resolve_isSome_iff 0 o p).1 (hV _ hmem p H he)).2

/-- D2.2a (txt:179-180): under V every edge decreases the column number. -/
theorem edge_lt {E : Forest} (hV : CondV E) {ks : KeySys} {c : ColAddr} {W : List (WithTop Key)}
    {x p : Nat} (h : Edge E ks c W x p) : p < x := by
  obtain ⟨o, ho, hr⟩ := h
  obtain ⟨H, hH⟩ := resp_eq_some.1 hr
  cases hcol : E.colAt o with
  | none => rw [hcol] at hH; simp at hH
  | some col =>
    rw [hcol, Option.getD_some] at hH
    have he : E.entryAt ⟨o, cursor (ks o) W⟩ = some (p, H) := by
      simp [Tree.entryAt, hcol, hH]
    rw [← ColAddr.resolve_num ho]
    exact parent_lt_num_of_condV hV he

/-- D2.2a: paths decrease. -/
theorem path_le {E : Forest} (hV : CondV E) {ks : KeySys} {c : ColAddr} {W : List (WithTop Key)}
    {x y : Nat} (h : Path E ks c W x y) : y ≤ x := by
  induction h with
  | refl => exact le_refl _
  | tail _ he ih => exact le_trans (edge_lt hV he).le ih

/-- D2.2a: the test starts strictly below the tested column. -/
theorem cutStart_lt {E : Forest} (hV : CondV E) {c : ColAddr} (hc : c ∈ E.colAddrs) {k : Nat}
    (hk : k ≤ (parents E c).length) (hpos : 0 < c.num 0) : cutStart E c k < c.num 0 := by
  unfold cutStart
  split
  · omega
  · have hlt : k - 1 < (parents E c).length := by omega
    obtain ⟨p, hp⟩ : ∃ p, (parents E c)[k - 1]? = some p := ⟨_, List.getElem?_eq_getElem hlt⟩
    rw [hp, Option.getD_some]
    rw [parents_getElem?] at hp
    obtain ⟨⟨q, H⟩, he, rfl⟩ := Option.map_eq_some_iff.1 hp
    exact parent_lt_num_of_condV hV he

/-- D2.2a (stack restriction): edges from numbers below `x₀` depend only on the stack below
`x₀`. -/
theorem edge_congr_stack {E : Forest} {ks : KeySys} {c c' : ColAddr} {W : List (WithTop Key)}
    {x₀ x p : Nat} (hst : ∀ q < x₀, c.resolve 0 q = c'.resolve 0 q) (hx : x < x₀) :
    Edge E ks c W x p ↔ Edge E ks c' W x p := by
  unfold Edge; rw [hst x hx]

/-- D2.2a (stack restriction for paths, codex-crosscheck-1 Q2). -/
theorem path_congr_stack {E : Forest} (hV : CondV E) {ks : KeySys} {c c' : ColAddr}
    {W : List (WithTop Key)} {x₀ x y : Nat} (hst : ∀ q < x₀, c.resolve 0 q = c'.resolve 0 q)
    (hx : x < x₀) : Path E ks c W x y ↔ Path E ks c' W x y := by
  have key : ∀ {c c' : ColAddr}, (∀ q < x₀, c.resolve 0 q = c'.resolve 0 q) → ∀ {x : Nat},
      x < x₀ → Path E ks c W x y → Path E ks c' W x y := by
    intro c c' hst x hx h
    revert hx
    induction h using Relation.ReflTransGen.head_induction_on with
    | refl => intro _; exact Relation.ReflTransGen.refl
    | head he _ ih =>
      intro hx
      exact Relation.ReflTransGen.head ((edge_congr_stack hst hx).1 he)
        (ih (lt_trans (edge_lt hV he) hx))
  exact ⟨key hst hx, key (fun q hq => (hst q hq).symm) hx⟩

/-- D2.2a (txt:191-193): A implies parent monotonicity, in every key system. -/
theorem parents_antitone {E : Forest} (hV : CondV E) {ks : KeySys} (hA : CondAK E ks)
    {c : ColAddr} (hc : c ∈ E.colAddrs) {i p q : Nat} (hi : (parents E c)[i + 1]? = some p)
    (hq : (parents E c)[i]? = some q) : p ≤ q := by
  have := hA c hc (i + 1) p hi
  simp only [Nat.add_one_ne_zero, if_false, Nat.add_sub_cancel, hq, Option.getD_some] at this
  exact path_le hV this

/-! ## D1.3a, D2.3a — the conditions in usable form -/

/-- D1.3a: V is "every parent is smaller than its column's printed number" (every smaller
number is visible, `resolve_isSome_iff`). -/
theorem condV_iff_lt (E : Forest) :
    CondV E ↔ ∀ e ∈ E.entryAddrs, ∀ p h, E.entryAt e = some (p, h) → p < e.col.num 0 := by sorry

-- D2.2a `parents_getElem?` moved up, before `edge_lt` (brief rule 5).

/-- D2.3a: an owner return is a contained column whose entry's parent resolves to the owner
column (definitional unfolding with `Contains`). -/
theorem isOwnerReturn_iff (E : Forest) (e₀ e : EntryAddr) :
    IsOwnerReturn E e₀ e ↔ e₀.Contains e.col ∧
      ∃ q J, E.entryAt e = some (q, J) ∧ e.col.resolve 0 q = some e₀.col := Iff.rfl

/-- D2.3a: an entry of a contained column whose parent is the host number is an owner return. -/
theorem isOwnerReturn_of_parent {E : Forest} {e₀ : EntryAddr} {c : ColAddr} {k : Nat} {J : Forest}
    (hc : e₀.Contains c) (hk : E.entryAt ⟨c, k⟩ = some (e₀.col.num 0, J)) :
    IsOwnerReturn E e₀ ⟨c, k⟩ :=
  ⟨hc, e₀.col.num 0, J, hk, EntryAddr.resolve_host hc⟩

/-! ## L2.2a — the path-nesting induction (G-006) -/

/-- L2.2a: the path-nesting predicate at source number `x`, quantified over every stack owner
`c` (all occurrences and scopes simultaneously, codex-crosscheck-1 Q2). -/
def NestPred (E : Forest) (ks : KeySys) (x : Nat) : Prop :=
  ∀ (c : ColAddr) (W Z : List (WithTop Key)) (p : Nat), Noninc W → Noninc Z → W ≤ Z →
    Edge E ks c Z x p → Path E ks c W x p

/-- L2.2a: the induction step (strong induction on `x`). -/
theorem nestPred_step {E : Forest} (hV : CondV E) {ks : KeySys} (hA : CondAK E ks) (x : Nat)
    (ih : ∀ y < x, NestPred E ks y) : NestPred E ks x := by sorry

/-- L2.2a. -/
theorem nestPred_all {E : Forest} (hV : CondV E) {ks : KeySys} (hA : CondAK E ks) (x : Nat) :
    NestPred E ks x := by sorry

/-! ## L2.3, L2.3a — the barrier (G-006 predicates) -/

/-- L2.3a: `C_e(c,k)`: an actual cut-`k` path of column `c` that reaches the host `a` of the
containing entry `e` has query strictly below `D_e = B_a(u)` (codex-crosscheck-1 Q2). -/
def CutBound (E : Forest) (e : EntryAddr) (c : ColAddr) (k : Nat) : Prop :=
  Path E (actualKeys E) c (cutQuery (actualKeys E c) k) (cutStart E c k) (e.col.num 0) →
    cutQuery (actualKeys E c) k < boundary (actualKeys E e.col) e.idx

/-- L2.3a: `R_e(c,k)`: if entry `k` of `c` returns to the host of `e`, then `B_c(k) < D_e`. -/
def ReturnBound (E : Forest) (e : EntryAddr) (c : ColAddr) (k : Nat) : Prop :=
  (parents E c)[k]? = some (e.col.num 0) →
    boundary (actualKeys E c) k < boundary (actualKeys E e.col) e.idx

/-- L2.3a: the empty cut is below every boundary of an entry. -/
theorem cutBound_zero {E : Forest} {e : EntryAddr} (he : e ∈ E.entryAddrs) (c : ColAddr) :
    CutBound E e c 0 := by sorry

/-- L2.3a (localized pre-entry-cut barrier): `C_e(c,k)` follows from the return bounds at
smaller column numbers inside `H_e` and at earlier entries of `c`; no A at `(c,k)` is used. -/
theorem cutBound_of_returns {E : Forest} (hV : CondV E) {e : EntryAddr} (he : e ∈ E.entryAddrs)
    {c : ColAddr} (hc : c ∈ E.colAddrs) (hec : e.Contains c) {k : Nat}
    (hk : k ≤ (parents E c).length)
    (hlow : ∀ o ∈ E.colAddrs, e.Contains o → o.num 0 < c.num 0 → ∀ v, ReturnBound E e o v)
    (hprev : ∀ k' < k, ReturnBound E e c k') : CutBound E e c k := by sorry

/-- L2.3a: the return step: `C_e(c,k)`, actual A at `(c,k)` and S give `R_e(c,k)`. -/
theorem returnBound_of_cutBound {E : Forest} (hS : CondS E) {e : EntryAddr}
    (he : e ∈ E.entryAddrs) {c : ColAddr} (hc : c ∈ E.colAddrs) (hec : e.Contains c) {k : Nat}
    (hA : AAt E (actualKeys E) c k) (hcut : CutBound E e c k) : ReturnBound E e c k := by sorry

/-- L2.3a: the joint barrier predicate at `(c, k)` for the containing entry `e`. -/
def BarPred (E : Forest) (e : EntryAddr) (c : ColAddr) (k : Nat) : Prop :=
  CutBound E e c k ∧ ReturnBound E e c k

/-- L2.3a: the lexicographic induction step on `(c.num 0, k)`. -/
theorem barPred_step {E : Forest} (hV : CondV E) (hA : CondA E) (hS : CondS E) {e : EntryAddr}
    (he : e ∈ E.entryAddrs) {c : ColAddr} (hc : c ∈ E.colAddrs) (hec : e.Contains c) {k : Nat}
    (hk : k ≤ (parents E c).length)
    (ihlow : ∀ o ∈ E.colAddrs, e.Contains o → o.num 0 < c.num 0 →
      ∀ v ≤ (parents E o).length, BarPred E e o v)
    (ihprev : ∀ k' < k, BarPred E e c k') : BarPred E e c k := by sorry

/-- L2.3a: the joint induction on `(c.num 0, k)`, all occurrences and scopes simultaneously. -/
theorem barrier_joint {E : Forest} (hV : CondV E) (hA : CondA E) (hS : CondS E) {e : EntryAddr}
    (he : e ∈ E.entryAddrs) {c : ColAddr} (hc : c ∈ E.colAddrs) (hec : e.Contains c) {k : Nat}
    (hk : k ≤ (parents E c).length) : CutBound E e c k ∧ ReturnBound E e c k := by sorry

/-- L2.3 (`barrier`†, txt:205-207): at an owner return, `B_c(v) < B_a(u)`. -/
theorem barrier {E : Forest} (hV : CondV E) (hA : CondA E) (hS : CondS E) {e₀ e : EntryAddr}
    (he₀ : e₀ ∈ E.entryAddrs) (he : e ∈ E.entryAddrs) (hret : IsOwnerReturn E e₀ e) :
    boundary (actualKeys E e.col) e.idx < boundary (actualKeys E e₀.col) e₀.idx := by sorry

/-- L2.3 (`cut_barrier`†, txt:207-209): at any complete cut, including the full cut after the
last entry, a read of an active containing entry by the cut's ancestor path has query strictly
below that entry's boundary. -/
theorem cut_barrier {E : Forest} (hV : CondV E) (hA : CondA E) (hS : CondS E) {e : EntryAddr}
    (he : e ∈ E.entryAddrs) {c : ColAddr} (hc : c ∈ E.colAddrs) (hec : e.Contains c) {k : Nat}
    (hk : k ≤ (parents E c).length)
    (hpath : Path E (actualKeys E) c (cutQuery (actualKeys E c) k) (cutStart E c k) (e.col.num 0)) :
    cutQuery (actualKeys E c) k < boundary (actualKeys E e.col) e.idx := by sorry

/-! ## L2.4, L2.4a, L2.4b — independent capping (G-006) -/

/-- L2.4b: an unselected column keeps its actual keys. -/
theorem capKeys_of_not_mem {E : Forest} {sel : List ColAddr} {c : ColAddr} (h : c ∉ sel) :
    capKeys E sel c = actualKeys E c := by sorry

/-- L2.4b (txt:222, point 1 of codex Q2): no entry query contains a capped last key. -/
theorem cutQuery_capKeys (E : Forest) (sel : List ColAddr) (c : ColAddr) {i : Nat}
    (hi : i < ((E.colAt c).getD []).length) :
    cutQuery (capKeys E sel c) i = cutQuery (actualKeys E c) i := by sorry

/-- L2.4b: a capped column whose actual scan is not exhausted gives the actual response
(L2.5 (2)). -/
theorem resp_capKeys {E : Forest} {sel : List ColAddr} {o : ColAddr} {W : List (WithTop Key)}
    (hnx : cursor (actualKeys E o) W < (actualKeys E o).length) :
    resp E (capKeys E sel) o W = resp E (actualKeys E) o W := by sorry

/-- L2.4b (point 2 of codex Q2): a route column visible from a column of `E` contains it. -/
theorem routeCols_visible {E : Forest} {c a : ColAddr} {z : Nat} (hc : c ∈ E.colAddrs)
    (ha : a ∈ routeCols E) (hres : c.resolve 0 z = some a) :
    ∃ v, (⟨a, v⟩ : EntryAddr) ∈ E.entryAddrs ∧ (⟨a, v⟩ : EntryAddr).Contains c := by sorry

/-- L2.4b: at a cut whose containing entries satisfy their cut bounds, actual paths are capped
paths (forward direction). -/
theorem capped_path_of_actual {E : Forest} (hV : CondV E) {sel : List ColAddr}
    (hsel : ∀ a ∈ sel, a ∈ routeCols E) {c : ColAddr} (hc : c ∈ E.colAddrs) {k : Nat}
    (hcut : ∀ e ∈ E.entryAddrs, e.Contains c → CutBound E e c k) {y : Nat}
    (h : Path E (actualKeys E) c (cutQuery (actualKeys E c) k) (cutStart E c k) y) :
    Path E (capKeys E sel) c (cutQuery (actualKeys E c) k) (cutStart E c k) y := by sorry

/-- L2.4a (first divergence): under the same cut bounds, capped paths are actual paths. -/
theorem actual_path_of_capped {E : Forest} (hV : CondV E) {sel : List ColAddr}
    (hsel : ∀ a ∈ sel, a ∈ routeCols E) {c : ColAddr} (hc : c ∈ E.colAddrs) {k : Nat}
    (hcut : ∀ e ∈ E.entryAddrs, e.Contains c → CutBound E e c k) {y : Nat}
    (h : Path E (capKeys E sel) c (cutQuery (actualKeys E c) k) (cutStart E c k) y) :
    Path E (actualKeys E) c (cutQuery (actualKeys E c) k) (cutStart E c k) y := by sorry

/-- L2.4: forward capping. -/
theorem capping_forward {E : Forest} (hV : CondV E) (hA : CondA E) (hS : CondS E)
    {sel : List ColAddr} (hsel : ∀ a ∈ sel, a ∈ routeCols E) : CondAK E (capKeys E sel) := by sorry

/-- L2.4a: the reverse-capping predicate at `(c, i)`: actual A at entry `i` together with the
actual return bounds of that entry for every containing entry (codex-crosscheck-1 Q2). -/
def RevPred (E : Forest) (c : ColAddr) (i : Nat) : Prop :=
  AAt E (actualKeys E) c i ∧ ∀ e ∈ E.entryAddrs, e.Contains c → ReturnBound E e c i

/-- L2.4a: the lexicographic induction step on `(c.num 0, i)`. -/
theorem revPred_step {E : Forest} (hV : CondV E) (hS : CondS E) {sel : List ColAddr}
    (hsel : ∀ a ∈ sel, a ∈ routeCols E) (hA : CondAK E (capKeys E sel)) {c : ColAddr}
    (hc : c ∈ E.colAddrs) (i : Nat)
    (ihlow : ∀ o ∈ E.colAddrs, o.num 0 < c.num 0 → ∀ v, RevPred E o v)
    (ihprev : ∀ i' < i, RevPred E c i') : RevPred E c i := by sorry

/-- L2.4a: the reverse joint induction on `(c.num 0, i)`: actual A together with the actual
return bounds. -/
theorem capping_reverse_joint {E : Forest} (hV : CondV E) (hS : CondS E) {sel : List ColAddr}
    (hsel : ∀ a ∈ sel, a ∈ routeCols E) (hA : CondAK E (capKeys E sel)) {c : ColAddr}
    (hc : c ∈ E.colAddrs) (i : Nat) :
    AAt E (actualKeys E) c i ∧ ∀ e ∈ E.entryAddrs, e.Contains c → ReturnBound E e c i := by sorry

/-- L2.4a: reverse capping. -/
theorem capping_reverse {E : Forest} (hV : CondV E) (hS : CondS E) {sel : List ColAddr}
    (hsel : ∀ a ∈ sel, a ∈ routeCols E) (hA : CondAK E (capKeys E sel)) : CondA E := by sorry

/-- L2.4 (`capping_iff`†, txt:223-224): on V, S inputs, A is equivalent to A in every
independently capped system on the terminal route. -/
theorem capping_iff {E : Forest} (hV : CondV E) (hS : CondS E) {sel : List ColAddr}
    (hsel : ∀ a ∈ sel, a ∈ routeCols E) : CondA E ↔ CondAK E (capKeys E sel) := by sorry

/-! ## L2.4c — every operation is defined on V, I, A, S -/

/-- L2.4c (txt:232-236): the owner root scan is not exhausted. -/
theorem owner_root_nonexhaust {E : Forest} (hV : CondV E) (hA : CondA E) (hS : CondS E)
