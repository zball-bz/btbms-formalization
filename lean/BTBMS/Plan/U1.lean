/-! ## D1.1a, D1.4a — lawful comparators, the order on forests and keys -/

-- D1.1a items 1–5 (`Tree.cmp_eq_swap`, `Tree.cmp_self`, `Tree.eq_of_cmp_eq`,
-- `Tree.cmp_isLE_trans` and the four `Tree.inst…Cmp` instances) and D1.4a item 2
-- (`keyLabelCmp_transCmp`, `keyLabelCmp_lawfulEqCmp`) moved to `Plan/Spine.lean`, before
-- `Forest.instLinearOrder`, whose proof fields need them (brief rule 5; statements unchanged).

namespace Tree

variable {α β : Type}

mutual
/-- D1.4a: relabelling by a comparison-preserving map preserves the comparison. This is the tree
form of trace fact (1) and gives `relKey_lt_iff`. -/
theorem cmp_map {c : α → α → Ordering} {c' : β → β → Ordering} {f : α → β}
    (hf : ∀ x y, c' (f x) (f y) = c x y) (s t : Tree α) :
    cmp c' (map f s) (map f t) = cmp c s t :=
  match s, t with
  | .node a, .node b => by rw [map, map, cmp, cmp]; exact cmpCols_map hf a b

/-- D1.4a helper: `cmp_map` for column lists. -/
theorem cmpCols_map {c : α → α → Ordering} {c' : β → β → Ordering} {f : α → β}
    (hf : ∀ x y, c' (f x) (f y) = c x y) (a b : List (List (α × Tree α))) :
    cmpCols c' (mapCols f a) (mapCols f b) = cmpCols c a b :=
  match a, b with
  | [], [] => rfl
  | [], _ :: _ => rfl
  | _ :: _, [] => rfl
  | x :: xs, y :: ys => by
    rw [mapCols, mapCols, cmpCols, cmpCols, cmpCol_map hf x y, cmpCols_map hf xs ys]

/-- D1.4a helper: `cmp_map` for columns. -/
theorem cmpCol_map {c : α → α → Ordering} {c' : β → β → Ordering} {f : α → β}
    (hf : ∀ x y, c' (f x) (f y) = c x y) (a b : List (α × Tree α)) :
    cmpCol c' (mapCol f a) (mapCol f b) = cmpCol c a b :=
  match a, b with
  | [], [] => rfl
  | [], _ :: _ => rfl
  | _ :: _, [] => rfl
  | (p, h) :: es, (q, k) :: fs => by
    rw [mapCol, mapCol, cmpCol, cmpCol, hf, cmp_map hf h k, cmpCol_map hf es fs]
end

mutual
/-- D1.4a helper: `Tree.map f` is injective, pointwise form. -/
theorem map_inj {f : α → β} (hf : Function.Injective f) (s t : Tree α)
    (h : map f s = map f t) : s = t :=
  match s, t, h with
  | .node a, .node b, h => by
    rw [map, map] at h
    rw [mapCols_inj hf a b (Tree.node.inj h)]

/-- D1.4a helper: `map_inj` for column lists. -/
theorem mapCols_inj {f : α → β} (hf : Function.Injective f) (a b : List (List (α × Tree α)))
    (h : mapCols f a = mapCols f b) : a = b :=
  match a, b, h with
  | [], [], _ => rfl
  | x :: xs, y :: ys, h => by
    rw [mapCols, mapCols] at h
    obtain ⟨h1, h2⟩ := List.cons.inj h
    rw [mapCol_inj hf x y h1, mapCols_inj hf xs ys h2]

/-- D1.4a helper: `map_inj` for columns. -/
theorem mapCol_inj {f : α → β} (hf : Function.Injective f) (a b : List (α × Tree α))
    (h : mapCol f a = mapCol f b) : a = b :=
  match a, b, h with
  | [], [], _ => rfl
  | (p, h') :: es, (q, k) :: fs, h => by
    rw [mapCol, mapCol] at h
    obtain ⟨h1, h2⟩ := List.cons.inj h
    obtain ⟨h3, h4⟩ := Prod.mk.inj h1
    rw [hf h3, map_inj hf h' k h4, mapCol_inj hf es fs h2]
end

/-- D1.4a: relabelling by an injective map is injective. -/
theorem map_injective {f : α → β} (hf : Function.Injective f) :
    Function.Injective (map f : Tree α → Tree β) := fun s t h => map_inj hf s t h

end Tree

/-- D1.4a: `keyLabelCmp` is the lexicographic comparison of `Bool ×ₗ Nat` (false before true). -/
theorem keyLabelCmp_eq (x y : Bool × Nat) : keyLabelCmp x y = compare (toLex x) (toLex y) := rfl

/-- D1.4a: `keyCmp` is `Tree.cmp compare` on `Tree (Bool ×ₗ Nat)` (definitional). -/
theorem keyCmp_eq_cmp_lex (x y : Key) : keyCmp x y = @Tree.cmp (Lex (Bool × Nat)) compare x y := rfl

/-- D1.1: the spine's `≤` on forests (definitional). -/
theorem Forest.le_iff_cmp (a b : Forest) : a ≤ b ↔ Tree.cmp compare a b ≠ .gt := Iff.rfl

-- U1-verify: changed (new declaration)
/-- D1.1: the `compare` of the spine's linear order (its default `compareOfLessAndEq`) is the
locked comparison `Tree.cmp compare`. -/
theorem Forest.compare_eq_cmp (a b : Forest) : compare a b = Tree.cmp compare a b :=
  LawfulCmp.compare_eq (Tree.cmp compare) (fun _ _ => Iff.rfl) a b

/-- D1.4: the spine's `<` on keys (definitional). -/
theorem Key.lt_iff_keyCmp (x y : Key) : x < y ↔ keyCmp x y = .lt := Iff.rfl

/-- D1.4: the label map of `h_a` (txt:82-83). -/
def relLabel (a p : Nat) : Bool × Nat := if p < a then (false, p) else (true, p - a)

/-- D1.4: `relKey a` is relabelling by `relLabel a` (definitional). -/
theorem relKey_eq_map (a : Nat) (H : Forest) : relKey a H = H.map (relLabel a) := rfl

/-- D1.4: `relLabel a` is strictly increasing: it turns `compare` into `keyLabelCmp`
(txt:84-85). -/
theorem keyLabelCmp_relLabel (a p q : Nat) :
    keyLabelCmp (relLabel a p) (relLabel a q) = compare p q := by
  unfold relLabel keyLabelCmp
  by_cases hp : p < a <;> by_cases hq : q < a <;> simp only [hp, hq, if_true, if_false]
  · simp
  · have : compare p q = .lt := Nat.compare_eq_lt.2 (by omega)
    rw [this]; rfl
  · have : compare p q = .gt := Nat.compare_eq_gt.2 (by omega)
    rw [this]; rfl
  · show (compare true true).then (compare (p - a) (q - a)) = compare p q
    rw [show compare true true = .eq from rfl, Ordering.eq_then]
    rcases Nat.lt_trichotomy p q with h | h | h
    · rw [Nat.compare_eq_lt.2 h, Nat.compare_eq_lt.2 (by omega)]
    · subst h; rw [Nat.compare_eq_eq.2 rfl, Nat.compare_eq_eq.2 rfl]
    · rw [Nat.compare_eq_gt.2 h, Nat.compare_eq_gt.2 (by omega)]

/-- D1.4: `h_a` preserves and reflects the comparison. -/
theorem keyCmp_relKey (a : Nat) (H H' : Forest) :
    keyCmp (relKey a H) (relKey a H') = Tree.cmp compare H H' := by
  rw [relKey_eq_map, relKey_eq_map]
  exact Tree.cmp_map (keyLabelCmp_relLabel a) H H'

-- provides: U1, D1.4 (h_a preserves and reflects order, txt:84-85). Moved here from
-- `Plan/Spine.lean` (brief rule 5): its proof needs `keyCmp_relKey`; nothing in between uses it.
theorem relKey_lt_iff (a : Nat) (H H' : Forest) : relKey a H < relKey a H' ↔ H < H' := by
  rw [Key.lt_iff_keyCmp, keyCmp_relKey]; rfl

/-- D1.4: `h_a` is injective. -/
theorem relKey_injective (a : Nat) : Function.Injective (relKey a) := fun H H' h =>
  Tree.eq_of_cmp_eq compare <| by
    rw [← keyCmp_relKey a, h]; exact Tree.cmp_self keyLabelCmp _

-- U1-verify: changed (new declaration)
/-- D1.4: the `compare` of the spine's linear order on keys (its default `compareOfLessAndEq`)
is the locked `keyCmp`. Needed to feed `sign_of_agreement` (stated with `keyCmp`) into
`trace_agree` (stated with `compare`). -/
theorem Key.compare_eq_keyCmp (x y : Key) : compare x y = keyCmp x y :=
  LawfulCmp.compare_eq (Tree.cmp keyLabelCmp) (fun _ _ => Iff.rfl) x y

/-! ## D1.2b — occurrences: stacks, containment, accessors, roles -/

namespace ColAddr

/-- D1.2b: `o` lies on the visible stack of `c` (txt:66-69): at a containing level `k` it is one
of the columns `0…c_k` of that forest, or at `c`'s own level one of the columns `0…c.col-1`. -/
def OnStack (c o : ColAddr) : Prop :=
  (∃ k ck ik, c.path[k]? = some (ck, ik) ∧ o.path = c.path.take k ∧ o.col ≤ ck) ∨
    (o.path = c.path ∧ o.col < c.col)

/-- D1.2b helper: `resolveAux` after `|pre|` levels, with `start` the first number of the level. -/
theorem resolveAux_eq_some (base j q : Nat) (o : ColAddr) :
    ∀ (rest pre : List (Nat × Nat)) (start : Nat), start = base + (pre.map (·.1 + 1)).sum →
    (resolveAux start pre rest j q = some o ↔
      ((∃ k ck ik, rest[k]? = some (ck, ik) ∧ o.path = pre ++ rest.take k ∧ o.col ≤ ck) ∨
        (o.path = pre ++ rest ∧ o.col < j)) ∧ o.num base = q)
  | [], pre, start, hs => by
    simp only [List.sum_map_add, List.map_const', List.sum_replicate, smul_eq_mul, mul_one] at hs
    simp only [resolveAux]
    constructor
    · intro h
      split_ifs at h with hg
      · cases h
        refine ⟨Or.inr ⟨by simp, by simp; omega⟩, ?_⟩
        simp [num]; omega
    · rintro ⟨(⟨k, ck, ik, hk, -, -⟩ | ⟨hp, hc⟩), hn⟩
      · simp at hk
      · simp at hp
        simp [num, hp] at hn
        rw [if_pos (by omega)]
        cases o
        simp_all
        omega
  | (ck, ik) :: rest, pre, start, hs => by
    have IH := resolveAux_eq_some base j q o rest (pre ++ [(ck, ik)]) (start + ck + 1)
      (by simp [hs]; omega)
    simp only [List.sum_map_add, List.map_const', List.sum_replicate, smul_eq_mul, mul_one] at hs
    simp only [resolveAux]
    split_ifs with hg
    · constructor
      · intro h
        cases h
        refine ⟨Or.inl ⟨0, ck, ik, rfl, by simp, by simp; omega⟩, ?_⟩
        simp [num]; omega
      · rintro ⟨h, hn⟩
        rcases h with ⟨k, ck', ik', hk, hp, hc⟩ | ⟨hp, hc⟩
        · cases k with
          | zero =>
            simp at hk; obtain ⟨rfl, rfl⟩ := hk
            simp at hp
            simp [num, hp] at hn
            cases o
            simp_all
            omega
          | succ k =>
            exfalso
            simp at hk hp
            simp [num, hp] at hn
            omega
        · exfalso
          simp [num, hp] at hn
          omega
    · rw [IH]
      constructor
      · rintro ⟨h, hn⟩
        refine ⟨?_, hn⟩
        rcases h with ⟨k, ck', ik', hk, hp, hc⟩ | ⟨hp, hc⟩
        · exact Or.inl ⟨k + 1, ck', ik', by simpa using hk, by simpa using hp, hc⟩
        · exact Or.inr ⟨by simpa using hp, hc⟩
      · rintro ⟨h, hn⟩
        refine ⟨?_, hn⟩
        rcases h with ⟨k, ck', ik', hk, hp, hc⟩ | ⟨hp, hc⟩
        · cases k with
          | zero =>
            exfalso
            simp at hk; obtain ⟨rfl, rfl⟩ := hk
            simp at hp
            simp [num, hp] at hn
            omega
          | succ k => exact Or.inl ⟨k, ck', ik', by simpa using hk, by simpa using hp, hc⟩
        · exact Or.inr ⟨by simpa using hp, hc⟩

/-- D1.2b: `resolve` returns exactly the stack occurrence with the given printed number. -/
theorem resolve_spec (base : Nat) (c o : ColAddr) (q : Nat) :
    c.resolve base q = some o ↔ c.OnStack o ∧ o.num base = q := by
  rw [resolve, resolveAux_eq_some base c.col q o c.path [] base (by simp)]
  simp [OnStack]

/-- D1.2b helpers: prefix sums of the level widths `c_l + 1`. -/
theorem wsum_take_succ {l : List (Nat × Nat)} {k a b : Nat} (h : l[k]? = some (a, b)) :
    ((l.take (k + 1)).map (·.1 + 1)).sum = ((l.take k).map (·.1 + 1)).sum + (a + 1) := by
  rw [List.take_add_one, h]
  simp

theorem wsum_take_mono (l : List (Nat × Nat)) {k k' : Nat} (h : k ≤ k') :
    ((l.take k).map (·.1 + 1)).sum ≤ ((l.take k').map (·.1 + 1)).sum := by
  have : l.take k = (l.take k').take k := by rw [List.take_take, Nat.min_eq_left h]
  rw [this]
  conv_rhs => rw [← List.take_append_drop k (l.take k')]
  rw [List.map_append, List.sum_append]
  exact Nat.le_add_right _ _

theorem wsum_take_le (l : List (Nat × Nat)) (k : Nat) :
    ((l.take k).map (·.1 + 1)).sum ≤ (l.map (·.1 + 1)).sum := by
  conv_rhs => rw [← List.take_append_drop k l]
  rw [List.map_append, List.sum_append]
  exact Nat.le_add_right _ _

/-- D1.2b: stack occurrences have smaller printed numbers. -/
theorem num_lt_of_onStack (base : Nat) {c o : ColAddr} (h : c.OnStack o) :
    o.num base < c.num base := by
  simp only [num]
  rcases h with ⟨k, ck, ik, hk, hp, hc⟩ | ⟨hp, hc⟩
  · rw [hp]
    have h1 := wsum_take_succ hk
    have h2 := wsum_take_le c.path (k + 1)
    omega
  · rw [hp]; omega

/-- D1.2b: numbers on a stack are unique (txt:69). -/
theorem onStack_inj (base : Nat) {c o o' : ColAddr} (h : c.OnStack o) (h' : c.OnStack o')
    (hn : o.num base = o'.num base) : o = o' := by
  have h1 := (resolve_spec base c o (o.num base)).2 ⟨h, rfl⟩
  have h2 := (resolve_spec base c o' (o.num base)).2 ⟨h', hn.symm⟩
  rw [h1] at h2
  exact Option.some.inj h2

theorem resolve_num {base : Nat} {c o : ColAddr} {q : Nat} (h : c.resolve base q = some o) :
    o.num base = q := ((resolve_spec base c o q).1 h).2

/-- D1.2b: only numbers below `c`'s own number resolve (V makes edges decrease). -/
theorem resolve_lt {base : Nat} {c o : ColAddr} {q : Nat} (h : c.resolve base q = some o) :
    q < c.num base := by
  obtain ⟨hs, hn⟩ := (resolve_spec base c o q).1 h
  exact hn ▸ num_lt_of_onStack base hs

/-- D1.2b helper: the numbers resolved by `resolveAux` form an interval. -/
theorem resolveAux_isSome (j q : Nat) :
    ∀ (rest pre : List (Nat × Nat)) (start : Nat),
    (resolveAux start pre rest j q).isSome ↔ start ≤ q ∧ q < start + (rest.map (·.1 + 1)).sum + j
  | [], pre, start => by
    simp only [resolveAux]
    split_ifs with h <;> simp <;> omega
  | (ck, ik) :: rest, pre, start => by
    simp only [resolveAux]
    split_ifs with h
    · simp only [Option.isSome_some, true_iff, List.map_cons, List.sum_cons]; omega
    · rw [resolveAux_isSome j q rest]
      simp only [List.map_cons, List.sum_cons]
      omega

/-- D1.2b: the visible stack of `c` carries exactly the numbers `base, …, c.num base - 1`. -/
theorem resolve_isSome_iff (base : Nat) (c : ColAddr) (q : Nat) :
    (c.resolve base q).isSome ↔ base ≤ q ∧ q < c.num base := by
  rw [resolve, resolveAux_isSome]
  simp only [num]

/-- D1.2b helper: below a stack occurrence `o` of `c`, the stacks of `o` and `c` agree. -/
theorem onStack_iff_of_onStack (base : Nat) {c o o' : ColAddr} (hs : c.OnStack o)
    (hlt : o'.num base < o.num base) : o.OnStack o' ↔ c.OnStack o' := by
  simp only [num] at hlt
  rcases hs with ⟨k, ck, ik, hk, hp, hc⟩ | ⟨hp, hc⟩
  · constructor
    · rintro (⟨k', ck', ik', hk', hp', hc'⟩ | ⟨hp', hc'⟩)
      · rw [hp, List.getElem?_take] at hk'
        split_ifs at hk' with hkk
        refine Or.inl ⟨k', ck', ik', hk', ?_, hc'⟩
        rw [hp', hp, List.take_take, Nat.min_eq_left (Nat.le_of_lt hkk)]
      · exact Or.inl ⟨k, ck, ik, hk, hp' ▸ hp, by omega⟩
    · rintro (⟨k', ck', ik', hk', hp', hc'⟩ | ⟨hp', hc'⟩)
      · rcases Nat.lt_trichotomy k' k with hkk | rfl | hkk
        · refine Or.inl ⟨k', ck', ik', ?_, ?_, hc'⟩
          · rw [hp, List.getElem?_take, if_pos hkk, hk']
          · rw [hp', hp, List.take_take, Nat.min_eq_left (Nat.le_of_lt hkk)]
        · refine Or.inr ⟨hp'.trans hp.symm, ?_⟩
          rw [hp', ← hp] at hlt
          omega
        · exfalso
          rw [hp', hp] at hlt
          have h1 := wsum_take_succ hk
          have h2 := wsum_take_mono c.path (by omega : k + 1 ≤ k')
          omega
      · exfalso
        rw [hp', hp] at hlt
        have h1 := wsum_take_succ hk
        have h2 := wsum_take_le c.path (k + 1)
        omega
  · constructor
    · rintro (⟨k', ck', ik', hk', hp', hc'⟩ | ⟨hp', hc'⟩)
      · rw [hp] at hk' hp'
        exact Or.inl ⟨k', ck', ik', hk', hp', hc'⟩
      · exact Or.inr ⟨hp'.trans hp, by omega⟩
    · rintro (⟨k', ck', ik', hk', hp', hc'⟩ | ⟨hp', hc'⟩)
      · rw [← hp] at hk' hp'
        exact Or.inl ⟨k', ck', ik', hk', hp', hc'⟩
      · refine Or.inr ⟨hp'.trans hp.symm, ?_⟩
        rw [hp', ← hp] at hlt
        omega

/-- D1.2b (stack nesting, codex-crosscheck-1 Q2 "restricting σ"): below a stack occurrence `o`
of `c`, the stacks of `o` and `c` resolve every number identically. -/
theorem resolve_of_resolve_lt {base : Nat} {c o : ColAddr} {x q : Nat}
    (h : c.resolve base x = some o) (hq : q < x) : o.resolve base q = c.resolve base q := by
  obtain ⟨hs, hn⟩ := (resolve_spec base c o x).1 h
  apply Option.ext
  intro o'
  rw [resolve_spec, resolve_spec]
  constructor
  · rintro ⟨h1, h2⟩
    exact ⟨(onStack_iff_of_onStack base hs (by omega)).1 h1, h2⟩
  · rintro ⟨h1, h2⟩
    exact ⟨(onStack_iff_of_onStack base hs (by omega)).2 h1, h2⟩

/-- D1.2b: the container of `c` in column `q`. -/
theorem container_spec (q c : ColAddr) (e : EntryAddr) :
    q.container c = some e ↔ e.col = q ∧ e.heightPath <+: c.path := by
  unfold container
  constructor
  · intro h
    split at h
    · rename_i k i tl hd
      split_ifs at h with hc
      obtain ⟨ht, rfl⟩ := hc
      cases h
      refine ⟨rfl, tl, ?_⟩
      rw [EntryAddr.heightPath, List.append_assoc, ← ht, List.singleton_append, ← hd,
        List.take_append_drop]
    · cases h
  · rintro ⟨rfl, t, ht⟩
    rw [← ht]
    simp [EntryAddr.heightPath]

end ColAddr

/-- D1.2b: column occurrence `c` lies inside the height of entry `e`. -/
def EntryAddr.Contains (e : EntryAddr) (c : ColAddr) : Prop := e.heightPath <+: c.path

namespace EntryAddr

/-- D1.2b: a containing column is visible from inside, under its own number. -/
theorem resolve_host {e : EntryAddr} {c : ColAddr} (h : e.Contains c) :
    c.resolve 0 (e.col.num 0) = some e.col := by
  obtain ⟨t, ht⟩ := h
  refine (ColAddr.resolve_spec 0 c e.col _).2
    ⟨Or.inl ⟨e.col.path.length, e.col.col, e.idx, ?_, ?_, le_refl _⟩, rfl⟩
  · rw [← ht]; simp [heightPath]
  · rw [← ht]; simp [heightPath]

/-- D1.2b (txt:216-217, "every visible z > a on this path is still inside H_e"): a stack
occurrence with a number above the host of a containing entry lies inside that entry's height. -/
theorem contains_of_resolve {e : EntryAddr} {c o : ColAddr} {z : Nat} (h : e.Contains c)
    (hz : c.resolve 0 z = some o) (hlt : e.col.num 0 < z) : e.Contains o := by
  obtain ⟨hs, hn⟩ := (ColAddr.resolve_spec 0 c o z).1 hz
  obtain ⟨t, ht⟩ := h
  have hpre : c.path.take e.col.path.length = e.col.path := by rw [← ht]; simp [heightPath]
  have hm : c.path[e.col.path.length]? = some (e.col.col, e.idx) := by rw [← ht]; simp [heightPath]
  have hhp : e.heightPath = c.path.take (e.col.path.length + 1) := by
    rw [← ht]; exact (List.take_left' (by simp [heightPath])).symm
  simp only [ColAddr.num] at hn hlt
  rcases hs with ⟨k, ck, ik, hk, hp, hc⟩ | ⟨hp, hc⟩
  · rw [hp] at hn
    by_cases hkm : e.col.path.length + 1 ≤ k
    · rw [Contains, hhp, hp]
      exact List.take_prefix_take_left hkm
    · exfalso
      rcases Nat.lt_or_eq_of_le (Nat.le_of_lt_succ (Nat.lt_of_not_le hkm)) with hkm | rfl
      · have h1 := ColAddr.wsum_take_succ hk
        have h2 := ColAddr.wsum_take_mono c.path (by omega : k + 1 ≤ e.col.path.length)
        rw [hpre] at h2
        omega
      · rw [hm] at hk
        cases hk
        rw [hpre] at hn
        omega
  · rw [Contains, hp]
    exact ⟨t, ht⟩

/-- D1.2b: `e` contains `c` iff `e.col.container c = some e`. -/
theorem contains_iff_container (e : EntryAddr) (c : ColAddr) :
    e.Contains c ↔ e.col.container c = some e := by
  rw [ColAddr.container_spec]
  exact ⟨fun h => ⟨rfl, h⟩, fun h => h.2⟩

end EntryAddr

/-! D1.2b helpers: placing roles under a path prefix. -/

namespace Role

theorem path_under (σ : List (Nat × Nat)) (x : Role) : (x.under σ).path = σ ++ x.path := by
  cases x <;> rfl

theorem under_injective (σ : List (Nat × Nat)) : Function.Injective (Role.under σ) := by
  intro x y h
  rcases x with ⟨⟨p, c⟩⟩ | ⟨⟨⟨p, c⟩, i⟩⟩ <;> rcases y with ⟨⟨p', c'⟩⟩ | ⟨⟨⟨p', c'⟩, i'⟩⟩ <;>
    simp_all [Role.under]

theorem ord_eq_under {c : ColAddr} {σ : List (Nat × Nat)} {y : Role} :
    Role.ord c = y.under σ ↔ ∃ c', y = .ord c' ∧ c = ⟨σ ++ c'.path, c'.col⟩ := by
  cases y <;> simp [Role.under, eq_comm]

theorem slot_eq_under {e : EntryAddr} {σ : List (Nat × Nat)} {y : Role} :
    Role.slot e = y.under σ ↔
      ∃ e', y = .slot e' ∧ e = ⟨⟨σ ++ e'.col.path, e'.col.col⟩, e'.idx⟩ := by
  cases y <;> simp [Role.under, eq_comm]

end Role

namespace Tree

variable {α : Type}

/-! D1.2b helpers: the role recursion read one level at a time. Every role emitted by
`rolesF π` is a role of the tree placed under `π`. -/

mutual
theorem rolesF_append_under (σ π : List (Nat × Nat)) :
    ∀ t : Tree α, rolesF (σ ++ π) t = (rolesF π t).map (Role.under σ)
  | .node cols => by rw [rolesF, rolesF]; exact rolesCols_append_under σ π 0 cols
theorem rolesCols_append_under (σ π : List (Nat × Nat)) :
    ∀ (c : Nat) (cols : List (List (α × Tree α))),
      rolesCols (σ ++ π) c cols = (rolesCols π c cols).map (Role.under σ)
  | _, [] => by simp [rolesCols]
  | c, col :: rest => by
    rw [rolesCols, rolesCols, rolesCol_append_under σ π c 0 col,
      rolesCols_append_under σ π (c + 1) rest]
    simp [Role.under]
theorem rolesCol_append_under (σ π : List (Nat × Nat)) :
    ∀ (c i : Nat) (col : List (α × Tree α)),
      rolesCol (σ ++ π) c i col = (rolesCol π c i col).map (Role.under σ)
  | _, _, [] => by simp [rolesCol]
  | c, i, (p, h) :: rest => by
    rw [rolesCol, rolesCol, List.append_assoc, rolesF_append_under σ (π ++ [(c, i)]) h,
      rolesCol_append_under σ π c (i + 1) rest]
    simp [Role.under]
end

/-- Roles read under a path prefix are the roles of the tree placed under it. -/
theorem rolesF_eq_map_under (π : List (Nat × Nat)) (t : Tree α) :
    rolesF π t = t.roles.map (Role.under π) := by
  have := rolesF_append_under π [] t
  rw [List.append_nil] at this
  exact this

theorem mem_rolesCols_iff {π : List (Nat × Nat)} {x : Role} :
    ∀ {c : Nat} {cols : List (List (α × Tree α))},
    x ∈ rolesCols π c cols ↔ ∃ j col, cols[j]? = some col ∧
      (x = .ord ⟨π, c + j⟩ ∨ x ∈ rolesCol π (c + j) 0 col)
  | c, [] => by simp [rolesCols]
  | c, col :: rest => by
    rw [rolesCols, List.mem_cons, List.mem_append, mem_rolesCols_iff]
    constructor
    · rintro (h | h | ⟨j, col', hj, h⟩)
      · exact ⟨0, col, rfl, Or.inl (by simpa using h)⟩
      · exact ⟨0, col, rfl, Or.inr (by simpa using h)⟩
      · refine ⟨j + 1, col', by simpa using hj, ?_⟩
        rw [show c + (j + 1) = c + 1 + j by omega]; exact h
    · rintro ⟨j, col', hj, h⟩
      cases j with
      | zero =>
        simp at hj; subst hj
        rcases h with h | h
        · exact Or.inl (by simpa using h)
        · exact Or.inr (Or.inl (by simpa using h))
      | succ j =>
        refine Or.inr (Or.inr ⟨j, col', by simpa using hj, ?_⟩)
        rw [show c + 1 + j = c + (j + 1) by omega]; exact h

theorem mem_rolesCol_iff {π : List (Nat × Nat)} {x : Role} {c : Nat} :
    ∀ {k : Nat} {col : List (α × Tree α)},
    x ∈ rolesCol π c k col ↔ ∃ m p h, col[m]? = some (p, h) ∧
      (x = .slot ⟨⟨π, c⟩, k + m⟩ ∨ x ∈ rolesF (π ++ [(c, k + m)]) h)
  | k, [] => by simp [rolesCol]
  | k, (p, h) :: rest => by
    rw [rolesCol, List.mem_cons, List.mem_append, mem_rolesCol_iff]
    constructor
    · rintro (hx | hx | ⟨m, p', h', hm, hx⟩)
      · exact ⟨0, p, h, rfl, Or.inl (by simpa using hx)⟩
      · exact ⟨0, p, h, rfl, Or.inr (by simpa using hx)⟩
      · refine ⟨m + 1, p', h', by simpa using hm, ?_⟩
        rw [show k + (m + 1) = k + 1 + m by omega]; exact hx
    · rintro ⟨m, p', h', hm, hx⟩
      cases m with
      | zero =>
        simp at hm; obtain ⟨rfl, rfl⟩ := hm
        rcases hx with hx | hx
        · exact Or.inl (by simpa using hx)
        · exact Or.inr (Or.inl (by simpa using hx))
      | succ m =>
        refine Or.inr (Or.inr ⟨m, p', h', by simpa using hm, ?_⟩)
        rw [show k + 1 + m = k + (m + 1) by omega]; exact hx

/-- Membership in the roles of a forest, one level at a time. -/
theorem mem_roles_node {cols : List (List (α × Tree α))} {x : Role} :
    x ∈ (Tree.node cols).roles ↔
      (∃ j col, cols[j]? = some col ∧ x = .ord ⟨[], j⟩) ∨
      (∃ j col m p h, cols[j]? = some col ∧ col[m]? = some (p, h) ∧
        (x = .slot ⟨⟨[], j⟩, m⟩ ∨ ∃ y ∈ h.roles, x = y.under [(j, m)])) := by
  rw [roles, rolesF, mem_rolesCols_iff]
  constructor
  · rintro ⟨j, col, hj, hx | hx⟩
    · exact Or.inl ⟨j, col, hj, by simpa using hx⟩
    · rw [mem_rolesCol_iff] at hx
      obtain ⟨m, p, h, hm, hx | hx⟩ := hx
      · exact Or.inr ⟨j, col, m, p, h, hj, hm, Or.inl (by simpa using hx)⟩
      · rw [rolesF_eq_map_under, List.mem_map] at hx
        obtain ⟨y, hy, rfl⟩ := hx
        exact Or.inr ⟨j, col, m, p, h, hj, hm, Or.inr ⟨y, hy, by simp⟩⟩
  · rintro (⟨j, col, hj, hx⟩ | ⟨j, col, m, p, h, hj, hm, hx⟩)
    · exact ⟨j, col, hj, Or.inl (by simpa using hx)⟩
    · refine ⟨j, col, hj, Or.inr ?_⟩
      rw [mem_rolesCol_iff]
      refine ⟨m, p, h, hm, ?_⟩
      rcases hx with hx | ⟨y, hy, rfl⟩
      · exact Or.inl (by simpa using hx)
      · refine Or.inr ?_
        rw [rolesF_eq_map_under, List.mem_map]
        exact ⟨y, hy, by simp⟩

theorem forestAt_cons (t : Tree α) (c i : Nat) (rest : List (Nat × Nat)) :
    t.forestAt ((c, i) :: rest) =
      ((t.cols[c]?.bind (·[i]?)).bind fun x => x.2.forestAt rest) := by
  cases h : (t.cols[c]?.bind (·[i]?)) with
  | none => rw [forestAt, h]; rfl
  | some x => obtain ⟨p, h'⟩ := x; rw [forestAt, h]; rfl

theorem colAt_cons (t : Tree α) (a b : Nat) (P : List (Nat × Nat)) (j : Nat) :
    t.colAt ⟨(a, b) :: P, j⟩ = (t.cols[a]?.bind (·[b]?)).bind fun x => x.2.colAt ⟨P, j⟩ := by
  simp only [colAt, forestAt_cons, Option.bind_assoc]

theorem entryAt_cons (t : Tree α) (a b : Nat) (P : List (Nat × Nat)) (j i : Nat) :
    t.entryAt ⟨⟨(a, b) :: P, j⟩, i⟩ =
      (t.cols[a]?.bind (·[b]?)).bind fun x => x.2.entryAt ⟨⟨P, j⟩, i⟩ := by
  simp only [entryAt, colAt_cons, Option.bind_assoc]

/-- D1.2b helpers: membership of ordinary and slot roles, by induction on the address path. -/
theorem mem_roles_ord (P : List (Nat × Nat)) :
    ∀ (t : Tree α) (j : Nat), Role.ord ⟨P, j⟩ ∈ t.roles ↔ (t.colAt ⟨P, j⟩).isSome := by
  induction P with
  | nil =>
    rintro ⟨cols⟩ j
    rw [mem_roles_node, show (Tree.node cols).colAt ⟨[], j⟩ = cols[j]? from rfl]
    constructor
    · rintro (⟨j', col, hj, hx⟩ | ⟨j', col, m, p, h, hj, hm, hx | ⟨y, hy, hx⟩⟩)
      · cases hx; simp [hj]
      · cases hx
      · rw [Role.ord_eq_under] at hx; obtain ⟨c', -, hc⟩ := hx; simp at hc
    · intro h
      obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 h
      exact Or.inl ⟨j, col, hcol, rfl⟩
  | cons ab P ih =>
    obtain ⟨a, b⟩ := ab
    rintro ⟨cols⟩ j
    rw [mem_roles_node, colAt_cons]
    constructor
    · rintro (⟨j', col, hj, hx⟩ | ⟨j', col, m, p, h, hj, hm, hx | ⟨y, hy, hx⟩⟩)
      · cases hx
      · cases hx
      · rw [Role.ord_eq_under] at hx
        obtain ⟨c', rfl, hc⟩ := hx
        simp only [ColAddr.mk.injEq, List.cons_append, List.nil_append, List.cons.injEq,
          Prod.mk.injEq] at hc
        obtain ⟨⟨⟨rfl, rfl⟩, hP⟩, hj'⟩ := hc
        have : c' = ⟨P, j⟩ := by cases c'; simp_all
        subst this
        rw [ih] at hy
        simp [Tree.cols, hj, hm, hy]
    · intro h
      simp only [Tree.cols] at h
      cases hcol : cols[a]? with
      | none => simp [hcol] at h
      | some col =>
        cases hx : col[b]? with
        | none => simp [hcol, hx] at h
        | some x =>
          obtain ⟨p, hh⟩ := x
          simp [hcol, hx] at h
          refine Or.inr ⟨a, col, b, p, hh, hcol, hx, Or.inr ⟨.ord ⟨P, j⟩, (ih hh j).2 h, rfl⟩⟩

theorem mem_roles_slot (P : List (Nat × Nat)) :
    ∀ (t : Tree α) (j i : Nat), Role.slot ⟨⟨P, j⟩, i⟩ ∈ t.roles ↔ (t.entryAt ⟨⟨P, j⟩, i⟩).isSome := by
  induction P with
  | nil =>
    rintro ⟨cols⟩ j i
    rw [mem_roles_node, show (Tree.node cols).entryAt ⟨⟨[], j⟩, i⟩ = cols[j]?.bind (·[i]?) from rfl]
    constructor
    · rintro (⟨j', col, hj, hx⟩ | ⟨j', col, m, p, h, hj, hm, hx | ⟨y, hy, hx⟩⟩)
      · cases hx
      · cases hx; simp [hj, hm]
      · rw [Role.slot_eq_under] at hx; obtain ⟨c', -, hc⟩ := hx; simp at hc
    · intro h
      cases hcol : cols[j]? with
      | none => simp [hcol] at h
      | some col =>
        cases hx : col[i]? with
        | none => simp [hcol, hx] at h
        | some x =>
          obtain ⟨p, hh⟩ := x
          exact Or.inr ⟨j, col, i, p, hh, hcol, hx, Or.inl rfl⟩
  | cons ab P ih =>
    obtain ⟨a, b⟩ := ab
    rintro ⟨cols⟩ j i
    rw [mem_roles_node, entryAt_cons]
    constructor
    · rintro (⟨j', col, hj, hx⟩ | ⟨j', col, m, p, h, hj, hm, hx | ⟨y, hy, hx⟩⟩)
      · cases hx
      · cases hx
      · rw [Role.slot_eq_under] at hx
        obtain ⟨e', rfl, hc⟩ := hx
        simp only [EntryAddr.mk.injEq, ColAddr.mk.injEq, List.cons_append, List.nil_append,
          List.cons.injEq, Prod.mk.injEq] at hc
        obtain ⟨⟨⟨⟨rfl, rfl⟩, hP⟩, hj'⟩, hi⟩ := hc
        have : e' = ⟨⟨P, j⟩, i⟩ := by obtain ⟨⟨_, _⟩, _⟩ := e'; simp_all
        subst this
        rw [ih] at hy
        simp [Tree.cols, hj, hm, hy]
    · intro h
      simp only [Tree.cols] at h
      cases hcol : cols[a]? with
      | none => simp [hcol] at h
      | some col =>
        cases hx : col[b]? with
        | none => simp [hcol, hx] at h
        | some x =>
          obtain ⟨p, hh⟩ := x
          simp [hcol, hx] at h
          refine Or.inr ⟨a, col, b, p, hh, hcol, hx, Or.inr ⟨.slot ⟨⟨P, j⟩, i⟩, (ih hh j i).2 h, rfl⟩⟩

/-- D1.2b: column addresses are exactly the addresses at which `colAt` succeeds. -/
theorem mem_colAddrs_iff (t : Tree α) (c : ColAddr) : c ∈ t.colAddrs ↔ (t.colAt c).isSome := by
  rw [colAddrs, List.mem_filterMap]
  obtain ⟨P, j⟩ := c
  rw [← mem_roles_ord]
  constructor
  · rintro ⟨x, hx, hc⟩
    rcases x with c' | e
    · cases hc; exact hx
    · cases hc
  · intro h
    exact ⟨_, h, rfl⟩

/-- D1.2b: entry addresses are exactly the addresses at which `entryAt` succeeds. -/
theorem mem_entryAddrs_iff (t : Tree α) (e : EntryAddr) :
    e ∈ t.entryAddrs ↔ (t.entryAt e).isSome := by
  rw [entryAddrs, List.mem_filterMap]
  obtain ⟨⟨P, j⟩, i⟩ := e
  rw [← mem_roles_slot]
  constructor
  · rintro ⟨x, hx, hc⟩
    rcases x with c' | e'
    · cases hc
    · cases hc; exact hx
  · intro h
    exact ⟨_, h, rfl⟩

/-- D1.2b: the roles of a tree are its column and entry occurrences. -/
theorem mem_roles_iff (t : Tree α) (x : Role) :
    x ∈ t.roles ↔ match x with
      | .ord c => (t.colAt c).isSome
      | .slot e => (t.entryAt e).isSome := by
  rcases x with ⟨⟨P, j⟩⟩ | ⟨⟨⟨P, j⟩, i⟩⟩
  · exact mem_roles_ord P t j
  · exact mem_roles_slot P t j i

/-- Position of the roles emitted by `rolesCol π c k`. -/
theorem pos_rolesCol {π : List (Nat × Nat)} {c k : Nat} {col : List (α × Tree α)} {x : Role}
    (hx : x ∈ rolesCol π c k col) :
    (∃ i, k ≤ i ∧ x = .slot ⟨⟨π, c⟩, i⟩) ∨ (∃ i σ, k ≤ i ∧ x.path = π ++ (c, i) :: σ) := by
  rw [mem_rolesCol_iff] at hx
  obtain ⟨m, p, h, -, hx | hx⟩ := hx
  · exact Or.inl ⟨k + m, by omega, hx⟩
  · rw [rolesF_eq_map_under, List.mem_map] at hx
    obtain ⟨y, -, rfl⟩ := hx
    exact Or.inr ⟨k + m, y.path, by omega, by simp [Role.path_under]⟩

/-- Position of the roles emitted by `rolesCols π c`. -/
theorem pos_rolesCols {π : List (Nat × Nat)} {c : Nat} {cols : List (List (α × Tree α))}
    {x : Role} (hx : x ∈ rolesCols π c cols) :
    (∃ c', c ≤ c' ∧ x = .ord ⟨π, c'⟩) ∨ (∃ c' i, c ≤ c' ∧ x = .slot ⟨⟨π, c'⟩, i⟩) ∨
      (∃ c' i σ, c ≤ c' ∧ x.path = π ++ (c', i) :: σ) := by
  rw [mem_rolesCols_iff] at hx
  obtain ⟨j, col, -, hx | hx⟩ := hx
  · exact Or.inl ⟨c + j, by omega, hx⟩
  · rcases pos_rolesCol hx with ⟨i, -, hx⟩ | ⟨i, σ, -, hx⟩
    · exact Or.inr (Or.inl ⟨c + j, i, by omega, hx⟩)
    · exact Or.inr (Or.inr ⟨c + j, i, σ, by omega, hx⟩)

theorem path_of_mem_rolesF {π : List (Nat × Nat)} {t : Tree α} {x : Role} (hx : x ∈ rolesF π t) :
    ∃ σ, x.path = π ++ σ := by
  rw [rolesF_eq_map_under, List.mem_map] at hx
  obtain ⟨y, -, rfl⟩ := hx
  exact ⟨y.path, Role.path_under π y⟩

mutual
theorem nodup_rolesF (π : List (Nat × Nat)) : ∀ t : Tree α, (rolesF π t).Nodup
  | .node cols => by rw [rolesF]; exact nodup_rolesCols π 0 cols
theorem nodup_rolesCols (π : List (Nat × Nat)) :
    ∀ (c : Nat) (cols : List (List (α × Tree α))), (rolesCols π c cols).Nodup
  | _, [] => by simp [rolesCols]
  | c, col :: rest => by
    rw [rolesCols, List.nodup_cons, List.nodup_append]
    refine ⟨?_, nodup_rolesCol π c 0 col, nodup_rolesCols π (c + 1) rest, ?_⟩
    · rw [List.mem_append, not_or]
      constructor
      · intro hx
        rcases pos_rolesCol hx with ⟨i, -, hx⟩ | ⟨i, σ, -, hx⟩
        · cases hx
        · simp [Role.path] at hx
      · intro hx
        rcases pos_rolesCols hx with ⟨c', hc, hx⟩ | ⟨c', i, -, hx⟩ | ⟨c', i, σ, -, hx⟩
        · simp at hx; omega
        · cases hx
        · simp [Role.path] at hx
    · intro a ha b hb hab
      subst hab
      rcases pos_rolesCol ha with ⟨i, -, rfl⟩ | ⟨i, σ, -, ha⟩ <;>
        rcases pos_rolesCols hb with ⟨c', hc, hb⟩ | ⟨c', i', hc, hb⟩ | ⟨c', i', σ', hc, hb⟩
      all_goals first
        | (cases hb; done)
        | (simp at hb; omega)
        | (subst hb; simp [Role.path] at ha)
        | (rw [ha] at hb; simp at hb; omega)
        | (simp [Role.path] at hb)
theorem nodup_rolesCol (π : List (Nat × Nat)) :
    ∀ (c i : Nat) (col : List (α × Tree α)), (rolesCol π c i col).Nodup
  | _, _, [] => by simp [rolesCol]
  | c, i, (p, h) :: rest => by
    rw [rolesCol, List.nodup_cons, List.nodup_append]
    refine ⟨?_, nodup_rolesF (π ++ [(c, i)]) h, nodup_rolesCol π c (i + 1) rest, ?_⟩
    · rw [List.mem_append, not_or]
      constructor
      · intro hx
        obtain ⟨σ, hσ⟩ := path_of_mem_rolesF hx
        simp [Role.path] at hσ
      · intro hx
        rcases pos_rolesCol hx with ⟨i', hi, hx⟩ | ⟨i', σ, -, hx⟩
        · simp at hx; omega
        · simp [Role.path] at hx
    · intro a ha b hb hab
      subst hab
      obtain ⟨σ, hσ⟩ := path_of_mem_rolesF ha
      rcases pos_rolesCol hb with ⟨i', hi, rfl⟩ | ⟨i', σ', hi, hb⟩
      · simp [Role.path] at hσ
      · rw [hσ] at hb; simp at hb; omega
end

/-- D1.2b (`roles_nodup`†): every role occurs once in reading order. -/
theorem roles_nodup (t : Tree α) : t.roles.Nodup := nodup_rolesF [] t

/-- D1.2b: forests at concatenated paths. -/
theorem forestAt_append (t : Tree α) (π π' : List (Nat × Nat)) :
    t.forestAt (π ++ π') = (t.forestAt π).bind fun f => f.forestAt π' := by
  induction π generalizing t with
  | nil => rfl
  | cons ab π ih =>
    obtain ⟨c, i⟩ := ab
    simp only [List.cons_append, forestAt_cons, Option.bind_assoc, ih]

/-- D1.2b: the height of an entry is the forest at its height path. -/
theorem forestAt_heightPath (t : Tree α) (e : EntryAddr) :
    t.forestAt e.heightPath = t.heightAt e := by
  rw [EntryAddr.heightPath, forestAt_append, heightAt, entryAt, colAt]
  cases t.forestAt e.col.path with
  | none => rfl
  | some f =>
    simp only [Option.bind_some, forestAt_cons]
    cases (f.cols[e.col.col]?.bind (·[e.idx]?)) with
    | none => rfl
    | some x => rfl

/-- D1.2b: an entry of `t` has its column in `t`. -/
theorem colAt_of_entryAt {t : Tree α} {e : EntryAddr} {x : α × Tree α} (h : t.entryAt e = some x) :
    ∃ col, t.colAt e.col = some col ∧ col[e.idx]? = some x := by
  rw [entryAt, Option.bind_eq_some_iff] at h
  exact h

-- bridge: holds by `rfl` (SCR-2 applied; checked in scratch/blueprint/all/rfl_check.lean)
theorem truncAfter_eq_body (t : Tree α) (e : EntryAddr) : t.truncAfter e = t.truncAfterBody e :=
  rfl
-- bridge: holds by `rfl` (SCR-2 applied)
theorem setHeight_eq_body (t : Tree α) (e : EntryAddr) (h : Tree α) :
    t.setHeight e h = t.setHeightBody e h := rfl

/-- D1.2c helper: `entryAt` through `forestAt`. -/
theorem entryAt_eq_bind (t : Tree α) (π : List (Nat × Nat)) (j i : Nat) :
    t.entryAt ⟨⟨π, j⟩, i⟩ = (t.forestAt π).bind fun f => (f.cols[j]?).bind (·[i]?) := by
  simp only [entryAt, colAt, Option.bind_assoc]

-- (merge) `forestAt_cons`: an identical copy is declared earlier (D1.2b helpers).

/-- D1.2c helper: the containing step of `truncAux` keeps entry `i₀` of column `c`, with its
height transformed. -/
theorem truncStep_getElem? {β : Type} (cols : List (List β)) (c i₀ : Nat) (g : β → β) :
    ((cols.take c ++ [(cols.getD c []).take i₀ ++ ((cols.getD c [])[i₀]?.map g).toList])[c]?).bind
      (·[i₀]?) = ((cols[c]?).bind (·[i₀]?)).map g := by
  rw [List.getD_eq_getElem?_getD]
  rcases Nat.lt_or_ge c cols.length with hc | hc
  · rw [List.getElem?_append_right (by simp only [List.length_take]; omega)]
    simp only [List.length_take, Nat.min_eq_left hc.le, Nat.sub_self, List.getElem?_cons_zero,
      Option.bind_some, List.getElem?_eq_getElem hc, Option.getD_some]
    rcases Nat.lt_or_ge i₀ cols[c].length with hi | hi
    · rw [List.getElem?_append_right (by simp only [List.length_take]; omega)]
      simp [List.getElem?_eq_getElem hi, Nat.min_eq_left hi.le]
    · rw [List.getElem?_eq_none (by omega : cols[c].length ≤ i₀)]
      simp [List.take_of_length_le hi, List.getElem?_eq_none hi]
  · rw [List.getElem?_eq_none hc, List.take_of_length_le hc]
    rcases Nat.lt_or_ge cols.length c with hc' | hc'
    · rw [List.getElem?_eq_none (by simp only [List.length_append, List.length_singleton]; omega)]
      rfl
    · have : c = cols.length := by omega
      subst this
      simp

/-- D1.2c helper: the last level of `truncAux` keeps entry `i` of column `j`. -/
theorem truncLast_getElem? {β : Type} (cols : List (List β)) (j i : Nat) :
    ((cols.take j ++ [(cols.getD j []).take (i + 1)])[j]?).bind (·[i]?) = (cols[j]?).bind (·[i]?) := by
  rw [List.getD_eq_getElem?_getD]
  rcases Nat.lt_or_ge j cols.length with hc | hc
  · rw [List.getElem?_append_right (by simp only [List.length_take]; omega)]
    simp [List.length_take, Nat.min_eq_left hc.le, List.getElem?_eq_getElem hc]
  · rw [List.getElem?_eq_none hc, List.take_of_length_le hc]
    rcases Nat.lt_or_ge cols.length j with hc' | hc'
    · rw [List.getElem?_eq_none (by simp only [List.length_append, List.length_singleton]; omega)]
    · have : j = cols.length := by omega
      subst this
      simp

/-- D1.2c helper: `truncAux` descends to the forest of the address and truncates there. -/
theorem forestAt_truncAux : ∀ (π : List (Nat × Nat)) (t : Tree α) (j i : Nat),
    (truncAux π j i t).forestAt π = (t.forestAt π).map (truncAux [] j i)
  | [], _, _, _ => rfl
  | (c, i₀) :: rest, .node cols, j, i => by
    rw [forestAt_cons, forestAt_cons]
    simp only [truncAux, Tree.cols]
    rw [truncStep_getElem?]
    cases (cols[c]?).bind (·[i₀]?) with
    | none => rfl
    | some x => exact forestAt_truncAux rest x.2 j i

/-- D1.2c helper: `truncAux` keeps its target entry. -/
theorem entryAt_truncAux (π : List (Nat × Nat)) (t : Tree α) (j i : Nat) :
    (truncAux π j i t).entryAt ⟨⟨π, j⟩, i⟩ = t.entryAt ⟨⟨π, j⟩, i⟩ := by
  rw [entryAt_eq_bind, entryAt_eq_bind, forestAt_truncAux]
  cases t.forestAt π with
  | none => rfl
  | some f =>
    obtain ⟨cols⟩ := f
    simp only [Option.map_some, Option.bind_some, truncAux, Tree.cols]
    exact truncLast_getElem? cols j i

/-- D1.2c helper: `setAux` descends to the forest of the address and sets the height there. -/
theorem forestAt_setAux (h : Tree α) : ∀ (π : List (Nat × Nat)) (t : Tree α) (j i : Nat),
    (setAux h π j i t).forestAt π = (t.forestAt π).map (setAux h [] j i)
  | [], _, _, _ => rfl
  | (c, i₀) :: rest, .node cols, j, i => by
    rw [forestAt_cons, forestAt_cons]
    simp only [setAux, Tree.cols, List.getElem?_modify_eq]
    cases hc : cols[c]? with
    | none => rfl
    | some col =>
      simp only [Option.map_eq_map, Option.map_some, Option.bind_some, List.getElem?_modify_eq]
      cases col[i₀]? with
      | none => rfl
      | some x => exact forestAt_setAux h rest x.2 j i

/-- D1.2c helper: `setAux` sets the height of its target entry. -/
theorem entryAt_setAux (h : Tree α) (π : List (Nat × Nat)) (t : Tree α) (j i : Nat) :
    (setAux h π j i t).entryAt ⟨⟨π, j⟩, i⟩ = (t.entryAt ⟨⟨π, j⟩, i⟩).map fun x => (x.1, h) := by
  rw [entryAt_eq_bind, entryAt_eq_bind, forestAt_setAux]
  cases t.forestAt π with
  | none => rfl
  | some f =>
    obtain ⟨cols⟩ := f
    simp only [Option.map_some, Option.bind_some, setAux, Tree.cols, List.getElem?_modify_eq]
    cases cols[j]? with
    | none => rfl
    | some col => simp [List.getElem?_modify_eq]

mutual
/-- D1.2c helper: every role read under the prefix `π` has a path extending `π`. -/
theorem rolesF_path_prefix : (π : List (Nat × Nat)) → (t : Tree α) → ∀ x ∈ rolesF π t, π <+: x.path
  | π, .node cols => by
    simp only [rolesF]
    intro x hx
    obtain ⟨c', -, -, h⟩ := rolesCols_mem π 0 cols x hx
    rcases h with rfl | ⟨i', rfl⟩ | ⟨i', h⟩
    · exact List.prefix_refl _
    · exact List.prefix_refl _
    · exact (List.prefix_append _ _).trans h
/-- D1.2c helper: the roles of the columns `c, c+1, …`: column roles and slots at the level
`π`, or roles below an entry of one of these columns. -/
theorem rolesCols_mem : (π : List (Nat × Nat)) → (c : Nat) → (cs : List (List (α × Tree α))) →
    ∀ x ∈ rolesCols π c cs, ∃ c', c ≤ c' ∧ c' < c + cs.length ∧
      (x = .ord ⟨π, c'⟩ ∨ (∃ i', x = .slot ⟨⟨π, c'⟩, i'⟩) ∨ ∃ i', π ++ [(c', i')] <+: x.path)
  | _, _, [] => by simp [rolesCols]
  | π, c, col :: rest => by
    simp only [rolesCols, List.mem_cons, List.mem_append]
    rintro x (rfl | hx | hx)
    · exact ⟨c, le_refl _, by simp, Or.inl rfl⟩
    · obtain ⟨i', -, -, h⟩ := rolesCol_mem π c 0 col x hx
      exact ⟨c, le_refl _, by simp,
        h.elim (fun h => Or.inr (Or.inl ⟨i', h⟩)) (fun h => Or.inr (Or.inr ⟨i', h⟩))⟩
    · obtain ⟨c', h1, h2, h⟩ := rolesCols_mem π (c + 1) rest x hx
      exact ⟨c', by omega, by simp only [List.length_cons]; omega, h⟩
/-- D1.2c helper: the roles of the entries `i, i+1, …` of column `c`: their slots, or roles
below one of them. -/
theorem rolesCol_mem : (π : List (Nat × Nat)) → (c i : Nat) → (es : List (α × Tree α)) →
    ∀ x ∈ rolesCol π c i es, ∃ i', i ≤ i' ∧ i' < i + es.length ∧
      (x = .slot ⟨⟨π, c⟩, i'⟩ ∨ π ++ [(c, i')] <+: x.path)
  | _, _, _, [] => by simp [rolesCol]
  | π, c, i, (_, h) :: rest => by
    simp only [rolesCol, List.mem_cons, List.mem_append]
    rintro x (rfl | hx | hx)
    · exact ⟨i, le_refl _, by simp, Or.inl rfl⟩
    · exact ⟨i, le_refl _, by simp, Or.inr (rolesF_path_prefix _ h x hx)⟩
    · obtain ⟨i', h1, h2, h⟩ := rolesCol_mem π c (i + 1) rest x hx
      exact ⟨i', by omega, by simp only [List.length_cons]; omega, h⟩
end

/-- D1.2c helper: `rolesCols` over an append. -/
theorem rolesCols_append (π : List (Nat × Nat)) (c : Nat) (l₁ l₂ : List (List (α × Tree α))) :
    rolesCols π c (l₁ ++ l₂) = rolesCols π c l₁ ++ rolesCols π (c + l₁.length) l₂ := by
  induction l₁ generalizing c with
  | nil => simp [rolesCols]
  | cons col l ih =>
    simp only [List.cons_append, rolesCols, ih, List.length_cons, List.append_assoc]
    rw [show c + 1 + l.length = c + (l.length + 1) by omega]

/-- D1.2c helper: `rolesCol` over an append. -/
theorem rolesCol_append (π : List (Nat × Nat)) (c i : Nat) (l₁ l₂ : List (α × Tree α)) :
    rolesCol π c i (l₁ ++ l₂) = rolesCol π c i l₁ ++ rolesCol π c (i + l₁.length) l₂ := by
  induction l₁ generalizing i with
  | nil => simp [rolesCol]
  | cons x l ih =>
    obtain ⟨q, h⟩ := x
    simp only [List.cons_append, rolesCol, ih, List.length_cons, List.append_assoc]
    rw [show i + 1 + l.length = i + (l.length + 1) by omega]

/-- D1.2c helper: split a list at a present index. -/
theorem exists_split_of_getElem? {β : Type} {l : List β} {n : Nat} {x : β} (h : l[n]? = some x) :
    ∃ l₁ l₂, l = l₁ ++ x :: l₂ ∧ l₁.length = n := by
  induction l generalizing n with
  | nil => simp at h
  | cons y ys ih =>
    cases n with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.some.injEq] at h
      exact ⟨[], ys, by simp [h], rfl⟩
    | succ n =>
      simp only [List.getElem?_cons_succ] at h
      obtain ⟨l₁, l₂, rfl, rfl⟩ := ih h
      exact ⟨y :: l₁, l₂, rfl, rfl⟩

/-- D1.2c helper: two one-step extensions of `π` that are prefixes of one list agree. -/
theorem prefix_step_eq {π l : List (Nat × Nat)} {a b : Nat × Nat} (h₁ : π ++ [a] <+: l)
    (h₂ : π ++ [b] <+: l) : a = b := by
  have h := (List.prefix_of_prefix_length_le h₁ h₂ (by simp)).eq_of_length (by simp)
  simpa using h

/-- D1.2c helper: a one-step extension of `π` is not a prefix of `π`. -/
theorem not_prefix_append_self {π : List (Nat × Nat)} {a : Nat × Nat} {l : List (Nat × Nat)}
    (hl : l = π) : ¬ π ++ [a] <+: l := by
  intro h; have := h.length_le; subst hl; simp at this

/-- D1.2c helper: roles of later entries of column `c` do not lie below entry `i` of it. -/
theorem not_prefix_of_mem_rolesCol_later {π : List (Nat × Nat)} {c i : Nat} {es : List (α × Tree α)}
    {x : Role} (hx : x ∈ rolesCol π c (i + 1) es) : ¬ π ++ [(c, i)] <+: x.path := by
  obtain ⟨i', h1, -, h⟩ := rolesCol_mem π c (i + 1) es x hx
  rcases h with rfl | h
  · exact not_prefix_append_self rfl
  · intro h'; have := prefix_step_eq h h'; simp at this; omega

/-- D1.2c helper: roles of later columns do not lie below an entry of column `c`. -/
theorem not_prefix_of_mem_rolesCols_later {π : List (Nat × Nat)} {c i : Nat}
    {cs : List (List (α × Tree α))} {x : Role} (hx : x ∈ rolesCols π (c + 1) cs) :
    ¬ π ++ [(c, i)] <+: x.path := by
  obtain ⟨c', h1, -, h⟩ := rolesCols_mem π (c + 1) cs x hx
  rcases h with rfl | ⟨i', rfl⟩ | ⟨i', h⟩
  · exact not_prefix_append_self rfl
  · exact not_prefix_append_self rfl
  · intro h'; have := prefix_step_eq h h'; simp at this; omega

/-- D1.2c helper: roles of earlier entries of column `c` do not lie below entry `i` of it, and
are not its slot. -/
theorem not_mem_of_mem_rolesCol_earlier {π : List (Nat × Nat)} {c : Nat} {es : List (α × Tree α)}
    {x : Role} (hx : x ∈ rolesCol π c 0 es) :
    x ≠ .slot ⟨⟨π, c⟩, es.length⟩ ∧ ¬ π ++ [(c, es.length)] <+: x.path := by
  obtain ⟨i', -, h2, h⟩ := rolesCol_mem π c 0 es x hx
  rcases h with rfl | h
  · exact ⟨by simp; omega, not_prefix_append_self rfl⟩
  · refine ⟨fun h' => ?_, fun h' => ?_⟩
    · subst h'; exact not_prefix_append_self rfl h
    · have := prefix_step_eq h h'; simp at this; omega

/-- D1.2c helper: roles of earlier columns do not lie below an entry of column `c`, and are not
slots of column `c`. -/
theorem not_mem_of_mem_rolesCols_earlier {π : List (Nat × Nat)} {cs : List (List (α × Tree α))}
    {x : Role} (hx : x ∈ rolesCols π 0 cs) (i : Nat) :
    x ≠ .slot ⟨⟨π, cs.length⟩, i⟩ ∧ ¬ π ++ [(cs.length, i)] <+: x.path := by
  obtain ⟨c', -, h2, h⟩ := rolesCols_mem π 0 cs x hx
  rcases h with rfl | ⟨i', rfl⟩ | ⟨i', h⟩
  · exact ⟨by simp, not_prefix_append_self rfl⟩
  · exact ⟨by simp; omega, not_prefix_append_self rfl⟩
  · refine ⟨fun h' => ?_, fun h' => ?_⟩
    · subst h'; exact not_prefix_append_self rfl h
    · have := prefix_step_eq h h'; simp at this; omega

/-- D1.2c helper: `inEntry` fails for a role that is not the slot and not below the height. -/
theorem inEntry_eq_false {x : Role} {e : EntryAddr} (h₁ : x ≠ .slot e)
    (h₂ : ¬ e.heightPath <+: x.path) : x.inEntry e = false := by
  simp only [Role.inEntry, Bool.or_eq_false_iff, beq_eq_false_iff_ne]
  exact ⟨h₁, by rw [Bool.eq_false_iff]; intro h; exact h₂ (List.isPrefixOf_iff_prefix.mp h)⟩

/-- D1.2c helper (`truncAfter_roles` for an arbitrary prefix `π`, since `truncAux` descends with
relative paths): the roles under `π` split at the slot of the target entry into the earlier
roles `A`, the slot, the roles of its height and later roles `C` outside the entry; truncation
keeps `A`, the slot and the height. -/
theorem truncAux_roles_decomp : ∀ (ρ π : List (Nat × Nat)) (s : Tree α) (j i : Nat) (p : α)
    (h : Tree α), s.entryAt ⟨⟨ρ, j⟩, i⟩ = some (p, h) →
    ∃ A C, rolesF π s = A ++ .slot ⟨⟨π ++ ρ, j⟩, i⟩ :: (rolesF (π ++ ρ ++ [(j, i)]) h ++ C) ∧
      .slot ⟨⟨π ++ ρ, j⟩, i⟩ ∉ A ∧ (∀ x ∈ C, x.inEntry ⟨⟨π ++ ρ, j⟩, i⟩ = false) ∧
      rolesF π (truncAux ρ j i s) = A ++ .slot ⟨⟨π ++ ρ, j⟩, i⟩ :: rolesF (π ++ ρ ++ [(j, i)]) h
  | [], π, .node cols, j, i, p, h, he => by
    simp only [List.append_nil]
    rw [entryAt_eq_bind] at he
    simp only [forestAt, Option.bind_some, Tree.cols] at he
    cases hc : cols[j]? with
    | none => rw [hc] at he; simp at he
    | some col =>
      rw [hc, Option.bind_some] at he
      obtain ⟨cols₁, cols₂, rfl, rfl⟩ := exists_split_of_getElem? hc
      obtain ⟨es₁, es₂, rfl, rfl⟩ := exists_split_of_getElem? he
      refine ⟨rolesCols π 0 cols₁ ++ .ord ⟨π, cols₁.length⟩ :: rolesCol π cols₁.length 0 es₁,
        rolesCol π cols₁.length (es₁.length + 1) es₂ ++ rolesCols π (cols₁.length + 1) cols₂,
        ?_, ?_, ?_, ?_⟩
      · simp only [rolesF, rolesCols_append, rolesCols, rolesCol_append, rolesCol, Nat.zero_add,
          List.append_assoc, List.cons_append]
      · intro hm
        simp only [List.mem_append, List.mem_cons] at hm
        rcases hm with hm | hm | hm
        · exact (not_mem_of_mem_rolesCols_earlier hm _).1 rfl
        · simp at hm
        · exact (not_mem_of_mem_rolesCol_earlier hm).1 rfl
      · intro x hx
        simp only [List.mem_append] at hx
        refine inEntry_eq_false ?_ ?_
        · rintro rfl
          rcases hx with hx | hx
          · obtain ⟨i', h1, -, h⟩ := rolesCol_mem _ _ _ _ _ hx
            rcases h with h | h
            · simp at h; omega
            · exact not_prefix_append_self rfl h
          · obtain ⟨c', h1, -, h⟩ := rolesCols_mem _ _ _ _ hx
            rcases h with h | ⟨i', h⟩ | ⟨i', h⟩
            · simp at h
            · simp at h; omega
            · exact not_prefix_append_self rfl h
        · simp only [EntryAddr.heightPath]
          rcases hx with hx | hx
          · exact not_prefix_of_mem_rolesCol_later hx
          · exact not_prefix_of_mem_rolesCols_later hx
      · simp [truncAux, rolesF, rolesCols_append, rolesCols, rolesCol_append, rolesCol,
          List.take_append, List.getD_eq_getElem?_getD, List.take_of_length_le]
  | (c₀, i₀) :: ρ, π, .node cols, j, i, p, h, he => by
    rw [entryAt_eq_bind, forestAt_cons] at he
    simp only [Tree.cols] at he
    cases hc : cols[c₀]? with
    | none => rw [hc] at he; simp at he
    | some col =>
      rw [hc, Option.bind_some] at he
      cases hi : col[i₀]? with
      | none => rw [hi] at he; simp at he
      | some x =>
        obtain ⟨p₀, h₀⟩ := x
        rw [hi, Option.bind_some] at he
        replace he : h₀.entryAt ⟨⟨ρ, j⟩, i⟩ = some (p, h) := by rw [entryAt_eq_bind]; exact he
        obtain ⟨A', C', hR, hA', hC', hT⟩ := truncAux_roles_decomp ρ (π ++ [(c₀, i₀)]) h₀ j i p h he
        simp only [List.append_assoc, List.singleton_append] at hR hA' hC' hT
        obtain ⟨cols₁, cols₂, rfl, rfl⟩ := exists_split_of_getElem? hc
        obtain ⟨es₁, es₂, rfl, rfl⟩ := exists_split_of_getElem? hi
        refine ⟨rolesCols π 0 cols₁ ++ .ord ⟨π, cols₁.length⟩ :: (rolesCol π cols₁.length 0 es₁ ++
            .slot ⟨⟨π, cols₁.length⟩, es₁.length⟩ :: A'),
          C' ++ (rolesCol π cols₁.length (es₁.length + 1) es₂ ++
            rolesCols π (cols₁.length + 1) cols₂), ?_, ?_, ?_, ?_⟩
        · simp only [rolesF, rolesCols_append, rolesCols, rolesCol_append, rolesCol, Nat.zero_add,
            List.append_assoc, List.cons_append]
          rw [hR]
          simp only [List.append_assoc, List.cons_append]
        · have hpre : π ++ [(cols₁.length, es₁.length)] <+:
              (Role.slot ⟨⟨π ++ (cols₁.length, es₁.length) :: ρ, j⟩, i⟩).path :=
            ⟨ρ, by simp [Role.path]⟩
          intro hm
          simp only [List.mem_append, List.mem_cons] at hm
          rcases hm with hm | hm | hm | hm | hm
          · exact (not_mem_of_mem_rolesCols_earlier hm es₁.length).2 hpre
          · simp at hm
          · exact (not_mem_of_mem_rolesCol_earlier hm).2 hpre
          · simp at hm
          · exact hA' hm
        · intro x hx
          simp only [List.mem_append] at hx
          rcases hx with hx | hx
          · exact hC' x hx
          · have hnp : ¬ π ++ [(cols₁.length, es₁.length)] <+: x.path := by
              rcases hx with hx | hx
              · exact not_prefix_of_mem_rolesCol_later hx
              · exact not_prefix_of_mem_rolesCols_later hx
            refine inEntry_eq_false ?_ ?_
            · rintro rfl; exact hnp ⟨ρ, by simp [Role.path]⟩
            · intro h'
              have hp : π ++ [(cols₁.length, es₁.length)] <+:
                  EntryAddr.heightPath ⟨⟨π ++ (cols₁.length, es₁.length) :: ρ, j⟩, i⟩ :=
                ⟨ρ ++ [(j, i)], by simp [EntryAddr.heightPath]⟩
              exact hnp (hp.trans h')
        · simp [truncAux, rolesF, rolesCols_append, rolesCols, rolesCol_append, rolesCol,
            List.getD_eq_getElem?_getD, hT]

/-- D1.2c (`truncAfter_roles`†): the roles of `truncAfter t e` are the roles of `t` strictly before
`U_e`, followed by the maximal run of roles inside `e` starting with `U_e`. -/
theorem truncAfter_roles {t : Tree α} {e : EntryAddr} (he : e ∈ t.entryAddrs) :
    (t.truncAfter e).roles =
      t.roles.takeWhile (· != .slot e) ++
        (t.roles.dropWhile (· != .slot e)).takeWhile (fun x => x.inEntry e) := by
  have hs := (mem_entryAddrs_iff t e).mp he
  obtain ⟨⟨p, h⟩, hpe⟩ := Option.isSome_iff_exists.mp hs
  rw [truncAfter_eq_body, truncAfterBody, if_pos hs]
  obtain ⟨⟨path, j⟩, i⟩ := e
  obtain ⟨A, C, hR, hA, hC, hT⟩ := truncAux_roles_decomp path [] t j i p h hpe
  simp only [List.nil_append] at hR hA hC hT
  unfold roles
  rw [hT, hR]
  have hA' : ∀ x ∈ A, (x != .slot ⟨⟨path, j⟩, i⟩) = true := fun x hx => by
    simp only [bne_iff_ne, ne_eq]; rintro rfl; exact hA hx
  have hH : ∀ x ∈ rolesF (path ++ [(j, i)]) h, x.inEntry ⟨⟨path, j⟩, i⟩ = true := fun x hx => by
    simp only [Role.inEntry, EntryAddr.heightPath, Bool.or_eq_true]
    exact Or.inr (List.isPrefixOf_iff_prefix.mpr (rolesF_path_prefix _ h x hx))
  have hC' : C.takeWhile (fun x => x.inEntry ⟨⟨path, j⟩, i⟩) = [] := by
    cases C with
    | nil => rfl
    | cons y ys => simp [hC y (List.mem_cons_self ..)]
  rw [List.takeWhile_append_of_pos hA', List.dropWhile_append_of_pos hA']
  simp only [List.takeWhile_cons, List.dropWhile_cons, bne_self_eq_false, Bool.false_eq_true,
    if_false, List.append_nil]
  have hself : (Role.slot ⟨⟨path, j⟩, i⟩).inEntry ⟨⟨path, j⟩, i⟩ = true := by
    simp [Role.inEntry]
  rw [if_pos hself, List.takeWhile_append_of_pos hH, hC', List.append_nil]

/-- D1.2c: `truncAfter` keeps `e` and its height. -/
theorem entryAt_truncAfter {t : Tree α} {e : EntryAddr} (he : e ∈ t.entryAddrs) :
    (t.truncAfter e).entryAt e = t.entryAt e := by
  clear he
  rw [truncAfter_eq_body, truncAfterBody]
  split_ifs
  · exact entryAt_truncAux e.col.path t e.col.col e.idx
  · rfl

/-- D1.2c: `setHeight` changes only the height of `e`. -/
theorem entryAt_setHeight {t : Tree α} {e : EntryAddr} {p : α} {H : Tree α}
    (he : t.entryAt e = some (p, H)) (h : Tree α) : (t.setHeight e h).entryAt e = some (p, h) := by
  rw [setHeight_eq_body, setHeightBody, if_pos (by rw [he]; rfl)]
  have := entryAt_setAux h e.col.path t e.col.col e.idx
  rw [he] at this
  exact this

/-- D1.2d: the last step of the last-column, last-entry route in `F`: `(|F| - 1, |col| - 1)` for
the last column `col`, if it is nonempty. -/
def lastStep? (F : Tree α) : Option (Nat × Nat) :=
  F.cols.getLast?.bind fun col => if col.isEmpty then none else some (F.cols.length - 1, col.length - 1)

end Tree

/-! ## D1.2d — the terminal last-column, last-entry route -/

/-- D1.2d: the route path: at every level `d` the step taken is the last-column, last-entry step
of the forest there. -/
def Scan.IsRoutePath (E : Forest) (π : List (Nat × Nat)) : Prop :=
  ∀ d < π.length, ∃ F, E.forestAt (π.take d) = some F ∧ F.lastStep? = π[d]?

namespace Scan

/-! D1.2d helpers: one step of the route, `routeColsAux` with explicit fuel, and fuel adequacy. -/

theorem lastStep?_eq_some {F : Forest} {s : Nat × Nat} (h : F.lastStep? = some s) :
    ∃ col p h', F.cols.getLast? = some col ∧ col.getLast? = some (p, h') ∧
      s = (F.cols.length - 1, col.length - 1) ∧ F.forestAt [s] = some h' := by
  unfold Tree.lastStep? at h
  rw [Option.bind_eq_some_iff] at h
  obtain ⟨col, hcol, hs⟩ := h
  split_ifs at hs with hce
  cases hs
  obtain ⟨⟨p, h'⟩, hl⟩ : ∃ x, col.getLast? = some x := by
    cases hc : col.getLast? with
    | none => simp [List.getLast?_eq_none_iff] at hc; simp [hc] at hce
    | some x => exact ⟨x, rfl⟩
  refine ⟨col, p, h', hcol, hl, rfl, ?_⟩
  rw [Tree.forestAt_cons]
  rw [List.getLast?_eq_getElem?] at hcol hl
  simp [hcol, hl, Tree.forestAt]

theorem isRoutePath_cons {E : Forest} {s : Nat × Nat} {σ : List (Nat × Nat)} :
    IsRoutePath E (s :: σ) ↔ E.lastStep? = some s ∧ ∃ h, E.forestAt [s] = some h ∧ IsRoutePath h σ := by
  have hsplit : ∀ (rest : List (Nat × Nat)) h, E.forestAt [s] = some h →
      E.forestAt (s :: rest) = h.forestAt rest := by
    intro rest h hh
    rw [show s :: rest = [s] ++ rest from rfl, Tree.forestAt_append, hh]
    rfl
  constructor
  · intro hr
    obtain ⟨F, hF, hl⟩ := hr 0 (by simp)
    simp only [List.take_zero, Tree.forestAt] at hF
    cases hF
    simp only [List.getElem?_cons_zero] at hl
    obtain ⟨col, p, h, -, -, -, hh⟩ := lastStep?_eq_some hl
    refine ⟨hl, h, hh, ?_⟩
    intro d hd
    obtain ⟨F, hF, hl'⟩ := hr (d + 1) (by simp; omega)
    rw [List.take_succ_cons, hsplit _ h hh] at hF
    exact ⟨F, hF, by simpa using hl'⟩
  · rintro ⟨hl, h, hh, hr⟩ d hd
    cases d with
    | zero => exact ⟨E, rfl, by simpa using hl⟩
    | succ d =>
      obtain ⟨F, hF, hl'⟩ := hr d (by simp at hd; omega)
      refine ⟨F, ?_, by simpa using hl'⟩
      rw [List.take_succ_cons, hsplit _ h hh]
      exact hF

theorem exists_list_iff {β : Type} {P : List β → Prop} :
    (∃ σ, P σ) ↔ P [] ∨ ∃ s σ, P (s :: σ) := by
  constructor
  · rintro ⟨σ, h⟩
    cases σ with
    | nil => exact Or.inl h
    | cons s σ => exact Or.inr ⟨s, σ, h⟩
  · rintro (h | ⟨s, σ, h⟩)
    · exact ⟨[], h⟩
    · exact ⟨s :: σ, h⟩

/-- D1.2d helper: membership in `routeColsAux` with explicit fuel. -/
theorem mem_routeColsAux_iff : ∀ (fuel : Nat) (F : Forest) (π : List (Nat × Nat)) (c : ColAddr),
    c ∈ routeColsAux fuel F π ↔ ∃ σ, c.path = π ++ σ ∧ σ.length < fuel ∧ IsRoutePath F σ ∧
      ∃ G, F.forestAt σ = some G ∧ G.cols.length = c.col + 1
  | 0, F, π, c => by simp [routeColsAux]
  | fuel + 1, F, π, c => by
    rw [exists_list_iff]
    simp only [List.append_nil, List.length_nil, Nat.zero_lt_succ, true_and, List.length_cons,
      Nat.add_lt_add_iff_right, isRoutePath_cons]
    have h0 : IsRoutePath F [] := fun d hd => absurd hd (Nat.not_lt_zero _)
    simp only [h0, true_and]
    unfold routeColsAux
    cases hl : F.cols.getLast? with
    | none =>
      have hF : F.cols = [] := List.getLast?_eq_none_iff.1 hl
      simp only [List.not_mem_nil, false_iff, not_or, not_exists, not_and]
      refine ⟨fun _ G hG => ?_, fun s σ _ _ hs => ?_⟩
      · simp only [Tree.forestAt, Option.some.injEq] at hG
        subst hG; simp [hF]
      · simp [Tree.lastStep?, hl] at hs
    | some col =>
      have hlen : 0 < F.cols.length := by
        cases hc : F.cols with
        | nil => simp [hc] at hl
        | cons _ _ => simp
      rw [List.mem_cons]
      apply or_congr
      · constructor
        · rintro rfl
          exact ⟨rfl, F, rfl, by simp; omega⟩
        · rintro ⟨hp, G, hG, hGl⟩
          simp only [Tree.forestAt, Option.some.injEq] at hG
          subst hG
          obtain ⟨p, c'⟩ := c
          simp only at hp hGl ⊢
          rw [hp]; congr 1; omega
      · cases hcl : col.getLast? with
        | none =>
          simp only [List.not_mem_nil, false_iff, not_exists, not_and]
          intro s σ _ _ hs
          obtain ⟨col', p, h', hcol', hl', -, -⟩ := lastStep?_eq_some hs.1
          rw [hl] at hcol'; cases hcol'
          rw [hcl] at hl'; cases hl'
        | some x =>
          obtain ⟨p, h⟩ := x
          simp only
          rw [mem_routeColsAux_iff fuel h]
          have hstep : F.lastStep? = some (F.cols.length - 1, col.length - 1) := by
            have hne : col ≠ [] := by intro hc; simp [hc] at hcl
            simp [Tree.lastStep?, hl, hne]
          obtain ⟨col', p', h', hcol', hl', hs', hh'⟩ := lastStep?_eq_some hstep
          rw [hl] at hcol'; cases hcol'
          rw [hcl] at hl'; cases hl'
          constructor
          · rintro ⟨σ, hp, hσ, hr, G, hG, hGl⟩
            refine ⟨_, σ, by rw [hp]; simp, hσ, ⟨hstep, h, hh', hr⟩, G, ?_, hGl⟩
            rw [show (F.cols.length - 1, col.length - 1) :: σ = [_] ++ σ from rfl,
              Tree.forestAt_append, hh']
            exact hG
          · rintro ⟨s, σ, hp, hσ, ⟨hs, h'', hh'', hr⟩, G, hG, hGl⟩
            rw [hstep] at hs; cases hs
            rw [hh'] at hh''; cases hh''
            refine ⟨σ, by rw [hp]; simp, hσ, hr, G, ?_, hGl⟩
            rw [show (F.cols.length - 1, col.length - 1) :: σ = [_] ++ σ from rfl,
              Tree.forestAt_append, hh'] at hG
            exact hG

/-- D1.2d helper (fuel adequacy): a route path is shorter than the number of roles of `E`. -/
theorem length_lt_size_of_isRoutePath {E : Forest} {σ : List (Nat × Nat)} (hr : IsRoutePath E σ)
    {G : Forest} (hG : E.forestAt σ = some G) (hne : G.cols ≠ []) : σ.length < E.size := by
  let L := (List.range (σ.length + 1)).map fun d => Role.ord ⟨σ.take d, 0⟩
  have hnd : L.Nodup := by
    refine List.Nodup.map_on ?_ List.nodup_range
    intro x hx y hy hxy
    simp only [List.mem_range] at hx hy
    simp only [Role.ord.injEq, ColAddr.mk.injEq, and_true] at hxy
    have := congrArg List.length hxy
    simp only [List.length_take] at this
    omega
  have hsub : L ⊆ E.roles := by
    intro x hx
    simp only [L, List.mem_map, List.mem_range] at hx
    obtain ⟨d, hd, rfl⟩ := hx
    rw [Tree.mem_roles_ord]
    rcases Nat.lt_or_ge d σ.length with hd' | hd'
    · obtain ⟨F, hF, hl⟩ := hr d hd'
      rw [List.getElem?_eq_getElem hd'] at hl
      obtain ⟨col, -, -, hcol, -, -, -⟩ := lastStep?_eq_some hl
      have : F.cols ≠ [] := by intro h; simp [h] at hcol
      simp only [Tree.colAt, hF, Option.bind_some]
      cases hc : F.cols with
      | nil => exact absurd hc this
      | cons _ _ => simp
    · have hd'' : d = σ.length := by omega
      subst hd''
      simp only [List.take_length, Tree.colAt, hG, Option.bind_some]
      cases hc : G.cols with
      | nil => exact absurd hc hne
      | cons _ _ => simp
  have := (hnd.subperm hsub).length_le
  simp only [L, List.length_map, List.length_range] at this
  unfold Tree.size
  omega

end Scan

/-- D1.2d: membership in the spine's `routeCols` (whose fuel `E.size + 1` suffices). -/
theorem Scan.mem_routeCols_iff (E : Forest) (c : ColAddr) :
    c ∈ Scan.routeCols E ↔ Scan.IsRoutePath E c.path ∧
      ∃ F, E.forestAt c.path = some F ∧ F.cols.length = c.col + 1 := by
  rw [Scan.routeCols, Scan.mem_routeColsAux_iff]
  simp only [List.nil_append]
  constructor
  · rintro ⟨σ, rfl, -, hr, G, hG, hGl⟩
    exact ⟨hr, G, hG, hGl⟩
  · rintro ⟨hr, G, hG, hGl⟩
    refine ⟨c.path, rfl, ?_, hr, G, hG, hGl⟩
    have := Scan.length_lt_size_of_isRoutePath hr hG (by intro h; simp [h] at hGl)
    omega

/-- D1.2d: route columns are columns of `E`. -/
theorem Scan.mem_colAddrs_of_mem_routeCols {E : Forest} {c : ColAddr} (h : c ∈ Scan.routeCols E) :
    c ∈ E.colAddrs := by
  obtain ⟨-, F, hF, hFl⟩ := (Scan.mem_routeCols_iff E c).1 h
  rw [Tree.mem_colAddrs_iff, Tree.colAt, hF, Option.bind_some]
  rw [List.getElem?_eq_getElem (by omega)]
  rfl

/-! ## D2.1, D2.1a, L2.1, L2.1a–c, L2.3b, L2.5 — the generic word library (S-6, U1 half) -/

namespace Scan

section Words

variable {α : Type} [LinearOrder α]

/-- D2.1a: a nonincreasing word (the reduced words of txt:159). -/
abbrev Noninc (l : List α) : Prop := l.Pairwise fun x y => y ≤ x

/-- D2.1a: one reduction step: delete terminal letters strictly smaller than `x`, append `x`. -/
def nuStep (acc : List α) (x : α) : List α :=
  (acc.reverse.dropWhile fun y => decide (y < x)).reverse ++ [x]

theorem nu_eq_foldl (l : List α) : nu l = l.foldl nuStep [] := rfl

/-- D2.1a. -/
theorem nu_append_singleton (l : List α) (x : α) : nu (l ++ [x]) = nuStep (nu l) x := by
  rw [nu_eq_foldl, nu_eq_foldl, List.foldl_append]; rfl

omit [LinearOrder α] in
/-- D2.1a helper: every letter of `l.takeWhile p` satisfies `p`. -/
theorem mem_takeWhile_imp_of {p : α → Bool} :
    ∀ {l : List α} {y : α}, y ∈ l.takeWhile p → p y = true
  | [], _, h => by simp at h
  | a :: l, y, h => by
    rw [List.takeWhile_cons] at h
    split at h
    · rcases List.mem_cons.1 h with rfl | h
      · assumption
      · exact mem_takeWhile_imp_of h
    · simp at h

omit [LinearOrder α] in
/-- D2.1a helper: `l.takeWhile p = l` when every letter satisfies `p`. -/
theorem takeWhile_eq_self_of {p : α → Bool} {l : List α} (h : ∀ a ∈ l, p a = true) :
    l.takeWhile p = l := by
  simpa using List.takeWhile_append_of_pos (l₂ := []) h

/-- D2.1a helper: on a nonincreasing word, deleting the terminal letters `< x` keeps exactly the
letters `≥ x`. -/
theorem reverse_dropWhile_reverse {acc : List α} (h : Noninc acc) (x : α) :
    (acc.reverse.dropWhile fun y => decide (y < x)).reverse =
      acc.takeWhile fun y => decide (x ≤ y) := by
  induction acc with
  | nil => rfl
  | cons a rest ih =>
    rw [Noninc, List.pairwise_cons] at h
    obtain ⟨ha, hrest⟩ := h
    rw [List.reverse_cons, List.dropWhile_append, List.takeWhile_cons]
    by_cases hxa : x ≤ a
    · have hna : ¬ a < x := not_lt.2 hxa
      rw [if_pos (decide_eq_true hxa)]
      split
      · rename_i hemp
        have h0 : rest.takeWhile (fun y => decide (x ≤ y)) = [] := by
          rw [← ih hrest]; simpa using hemp
        rw [h0]; simp [hna]
      · rw [List.reverse_append, ih hrest]; rfl
    · have hax : a < x := lt_of_not_ge hxa
      have hall : ∀ b ∈ rest.reverse, decide (b < x) = true := by
        intro b hb
        exact decide_eq_true (lt_of_le_of_lt (ha b (List.mem_reverse.1 hb)) hax)
      have hd : (rest.reverse.dropWhile fun y => decide (y < x)) = [] := by
        simpa using List.dropWhile_append_of_pos (l₂ := []) hall
      simp [hd, hax, hxa]

/-- D2.1a: on a nonincreasing word, a step keeps the letters `≥ x` and appends `x`. -/
theorem nuStep_eq_takeWhile {acc : List α} (h : Noninc acc) (x : α) :
    nuStep acc x = acc.takeWhile (fun y => decide (x ≤ y)) ++ [x] := by
  rw [nuStep, reverse_dropWhile_reverse h]

/-- D2.1a: `ν(W)` is nonincreasing (txt:159). -/
theorem nu_noninc (l : List α) : Noninc (nu l) := by
  induction l using List.reverseRecOn with
  | nil => exact List.Pairwise.nil
  | append_singleton l x ih =>
    rw [nu_append_singleton, nuStep_eq_takeWhile ih, Noninc, List.pairwise_append]
    refine ⟨ih.sublist (List.takeWhile_sublist _), List.pairwise_singleton _ _, ?_⟩
    intro a ha b hb
    rw [List.mem_singleton] at hb
    subst hb
    simpa using mem_takeWhile_imp_of ha

/-- D2.1a: a nonincreasing word is reduced. -/
theorem nu_of_noninc {l : List α} (h : Noninc l) : nu l = l := by
  induction l using List.reverseRecOn with
  | nil => rfl
  | append_singleton l x ih =>
    rw [Noninc, List.pairwise_append] at h
    obtain ⟨h1, -, h3⟩ := h
    rw [nu_append_singleton, ih h1, nuStep_eq_takeWhile h1,
      takeWhile_eq_self_of fun a ha => decide_eq_true (h3 a ha x (List.mem_singleton_self x))]

/-- D2.1a. -/
theorem nu_append_nu (l m : List α) : nu (nu l ++ m) = nu (l ++ m) := by
  induction m using List.reverseRecOn with
  | nil => simp [nu_of_noninc (nu_noninc l)]
  | append_singleton m x ih =>
    rw [← List.append_assoc, ← List.append_assoc, nu_append_singleton, nu_append_singleton, ih]

/-- D2.1a (txt:163-164): an append strictly increases a reduced word. -/
theorem lt_nuStep {acc : List α} (h : Noninc acc) (x : α) : acc < nuStep acc x := by
  rw [nuStep_eq_takeWhile h]
  conv_lhs => rw [← List.takeWhile_append_dropWhile (p := fun y => decide (x ≤ y)) (l := acc)]
  apply List.append_left_lt
  cases hd : acc.dropWhile (fun y => decide (x ≤ y)) with
  | nil => exact List.nil_lt_cons _ _
  | cons d D =>
    have := List.head_dropWhile_not (fun y => decide (x ≤ y)) (l := acc) (by simp [hd])
    simp only [hd, List.head_cons, decide_eq_false_iff_not, not_le] at this
    exact List.cons_lt_cons_iff.2 (Or.inl this)

/-- D2.1a: every letter of `nuStep acc x` is at least `x`. -/
theorem le_of_mem_nuStep {acc : List α} (h : Noninc acc) {x y : α} (hy : y ∈ nuStep acc x) :
    x ≤ y := by
  rw [nuStep_eq_takeWhile h, List.mem_append] at hy
  rcases hy with hy | hy
  · simpa using mem_takeWhile_imp_of hy
  · rw [List.mem_singleton] at hy; exact hy ▸ le_refl x

theorem cutQuery_zero (ks : List α) : cutQuery ks 0 = [] := rfl

theorem boundary_eq_cutQuery (ks : List α) (i : Nat) : boundary ks i = cutQuery ks (i + 1) := rfl

/-- D2.1a. -/
theorem cutQuery_succ {ks : List α} {k : Nat} (hk : k < ks.length) :
    cutQuery ks (k + 1) = nuStep (cutQuery ks k) ks[k] := by
  rw [cutQuery, ← List.take_append_getElem hk, nu_append_singleton]; rfl

theorem cutQuery_noninc (ks : List α) (k : Nat) : Noninc (cutQuery ks k) := nu_noninc _

-- provides: U1, D2.1 (boundaries strictly increase). Moved here from `Plan/Spine.lean` (brief
-- rule 5): its proof needs `cutQuery_succ` and `lt_nuStep`; nothing in between uses it.
theorem cutQuery_lt_succ {α : Type} [LinearOrder α] (ks : List α) {k : Nat} (hk : k < ks.length) :
    cutQuery ks k < cutQuery ks (k + 1) := by
  rw [cutQuery_succ hk]; exact lt_nuStep (cutQuery_noninc ks k) _

/-- D2.1 (with `cutQuery_lt_succ`): boundaries strictly increase up to the full cut. -/
theorem cutQuery_strictMono {ks : List α} {j k : Nat} (hjk : j < k) (hk : k ≤ ks.length) :
    cutQuery ks j < cutQuery ks k := by
  induction k with
  | zero => omega
  | succ k ih =>
    rcases Nat.lt_succ_iff_lt_or_eq.1 hjk with h | h
    · exact lt_trans (ih h (by omega)) (cutQuery_lt_succ ks (by omega))
    · subst h; exact cutQuery_lt_succ ks (by omega)

/-- D2.1 helper: a cut beyond the column is the full cut. -/
theorem cutQuery_eq_min (ks : List α) (k : Nat) : cutQuery ks k = cutQuery ks (min k ks.length) := by
  unfold cutQuery
  rcases le_total k ks.length with h | h
  · rw [Nat.min_eq_left h]
  · rw [Nat.min_eq_right h, List.take_of_length_le h, List.take_length]

/-- D2.1: boundaries are monotone (constant beyond the full cut). -/
theorem cutQuery_mono (ks : List α) {j k : Nat} (hjk : j ≤ k) : cutQuery ks j ≤ cutQuery ks k := by
  rw [cutQuery_eq_min ks j, cutQuery_eq_min ks k]
  rcases Nat.lt_or_eq_of_le (min_le_min_right ks.length hjk) with h | h
  · exact le_of_lt (cutQuery_strictMono h (Nat.min_le_right _ _))
  · rw [h]

theorem boundary_ne_nil {ks : List α} {i : Nat} (hi : i < ks.length) : boundary ks i ≠ [] := by
  rw [boundary_eq_cutQuery, cutQuery_succ hi, nuStep]; simp

/-- D2.1a helper: a step commutes with a strictly increasing map. -/
theorem nuStep_map {β : Type} [LinearOrder β] {f : α → β} (hf : StrictMono f) (acc : List α)
    (x : α) : nuStep (acc.map f) (f x) = (nuStep acc x).map f := by
  unfold nuStep
  rw [← List.map_reverse, List.dropWhile_map, ← List.map_reverse, List.map_append]
  have : ((fun y => decide (y < f x)) ∘ f) = fun y => decide (y < x) := by
    funext y; simp [hf.lt_iff_lt]
  rw [this]; rfl

-- U1-verify: changed (new declarations)
/-- D2.1a: `ν` commutes with a strictly increasing map (used for the maps `κ_j` of txt:331-333
and for the coercion `Key → WithTop Key`). -/
theorem nu_map {β : Type} [LinearOrder β] {f : α → β} (hf : StrictMono f) (l : List α) :
    nu (l.map f) = (nu l).map f := by
  induction l using List.reverseRecOn with
  | nil => rfl
  | append_singleton l x ih =>
    rw [List.map_append, List.map_singleton, nu_append_singleton, nu_append_singleton, ih,
      nuStep_map hf]

/-- D2.1a: cut queries commute with a strictly increasing map. -/
theorem cutQuery_map {β : Type} [LinearOrder β] {f : α → β} (hf : StrictMono f) (ks : List α)
    (k : Nat) : cutQuery (ks.map f) k = (cutQuery ks k).map f := by
  rw [cutQuery, cutQuery, ← List.map_take, nu_map hf]

/-- D2.1a: boundaries commute with a strictly increasing map. -/
theorem boundary_map {β : Type} [LinearOrder β] {f : α → β} (hf : StrictMono f) (ks : List α)
    (i : Nat) : boundary (ks.map f) i = (boundary ks i).map f := by
  rw [boundary, boundary, ← List.map_take, nu_map hf]

/-- L2.3b helper: if every letter of `D` is above `J` and `W < D`, then the letters of `W` up
to the first one below `J`, followed by `J`, are still below `D`. -/
theorem takeWhile_append_lt {J : α} : ∀ {W D : List α}, (∀ d ∈ D, J < d) → W < D →
    W.takeWhile (fun y => decide (J ≤ y)) ++ [J] < D
  | [], D, hD, h => by
    cases D with
    | nil => exact absurd h (lt_irrefl _)
    | cons d D => exact List.cons_lt_cons_iff.2 (Or.inl (hD d List.mem_cons_self))
  | w :: W, D, hD, h => by
    cases D with
    | nil => exact absurd h (List.not_lt_nil _)
    | cons d D =>
      rw [List.takeWhile_cons]
      by_cases hJw : J ≤ w
      · rw [if_pos (decide_eq_true hJw), List.cons_append]
        rcases List.cons_lt_cons_iff.1 h with h' | ⟨rfl, h'⟩
        · exact List.cons_lt_cons_iff.2 (Or.inl h')
        · exact List.cons_lt_cons_iff.2 (Or.inr ⟨rfl,
            takeWhile_append_lt (fun d hd => hD d (List.mem_cons_of_mem _ hd)) h'⟩)
      · rw [if_neg (by simpa using hJw), List.nil_append]
        exact List.cons_lt_cons_iff.2 (Or.inl (hD d List.mem_cons_self))

/-- L2.3b (word observation, txt:211-213): if `D = ν(P ⌢ [K])`, `W` is nonincreasing, `W < D`
and `J < K`, then `ν(W ⌢ [J]) < D`. -/
theorem nu_append_lt {P W : List α} {K J : α} (hW : Noninc W) (hWD : W < nu (P ++ [K]))
    (hJK : J < K) : nu (W ++ [J]) < nu (P ++ [K]) := by
  rw [nu_append_singleton, nu_of_noninc hW, nuStep_eq_takeWhile hW]
  refine takeWhile_append_lt (fun d hd => lt_of_lt_of_le hJK ?_) hWD
  rw [nu_append_singleton] at hd
  exact le_of_mem_nuStep (nu_noninc P) hd

/-- L2.3b, boundary form: `W(c,k) < B_a(u)` and `K_k < K_u` give `B_c(k) < B_a(u)`. -/
theorem boundary_lt_of_cut {ksc ksa : List α} {k u : Nat} (hk : k < ksc.length)
    (hu : u < ksa.length) (hW : cutQuery ksc k < boundary ksa u) (hK : ksc[k] < ksa[u]) :
    boundary ksc k < boundary ksa u := by
  have e1 : boundary ksc k = nu (cutQuery ksc k ++ [ksc[k]]) := by
    rw [boundary, ← List.take_append_getElem hk, cutQuery, nu_append_nu]
  have e2 : boundary ksa u = nu (ksa.take u ++ [ksa[u]]) := by
    rw [boundary, ← List.take_append_getElem hu]
  rw [e1, e2]
  rw [e2] at hW
  exact nu_append_lt (cutQuery_noninc ksc k) hW hK

/-- L2.1a: the source cursor never exceeds the source length. -/
theorem cursor_le_length (src qry : List α) : cursor src qry ≤ src.length := by
  fun_induction cursor src qry with
  | case1 => simp
  | case2 => simp
  | case3 x xs y ys h ih => simp only [List.length_cons]; omega
  | case4 xs y ys h ih => simp only [List.length_cons]; omega
  | case5 x xs y ys h1 h2 ih => exact ih

/-- L2.1a: the run on a source prefix is the run on the whole source, stopped at its end. -/
theorem cursor_take (src qry : List α) (k : Nat) :
    cursor (src.take k) qry = min k (cursor src qry) := by
  induction src, qry using cursor.induct generalizing k with
  | case1 qry => simp [cursor]
  | case2 x xs => cases k <;> simp [cursor]
  | case3 x xs y ys h ih =>
    cases k with
    | zero => simp [cursor]
    | succ k => simp only [List.take_succ_cons, cursor, if_pos h, ih]; omega
  | case4 xs y ys h ih =>
    cases k with
    | zero => simp [cursor]
    | succ k => simp only [List.take_succ_cons, cursor, lt_irrefl, if_false, if_true, ih]; omega
  | case5 x xs y ys h1 h2 ih =>
    cases k with
    | zero => simp [cursor]
    | succ k =>
      have := ih (k + 1)
      simp only [List.take_succ_cons] at this
      simp only [List.take_succ_cons, cursor, if_neg h1, if_neg h2, this]

/-- L2.1a: the final query cursor of the raw scan (same recursion as `cursor`). -/
def qcursor : List α → List α → Nat
  | [], _ => 0
  | _ :: _, [] => 0
  | x :: xs, y :: ys =>
    if x < y then qcursor xs (y :: ys)
    else if x = y then qcursor xs ys + 1
    else qcursor (x :: xs) ys + 1
termination_by xs ys => xs.length + ys.length

theorem qcursor_le_length (src qry : List α) : qcursor src qry ≤ qry.length := by
  fun_induction qcursor src qry with
  | case1 => simp
  | case2 => simp
  | case3 x xs y ys h ih => exact ih
  | case4 xs y ys h ih => simp only [List.length_cons]; omega
  | case5 x xs y ys h1 h2 ih => simp only [List.length_cons]; omega

/-- L2.1a: a run that exhausts `src` continues on `src'` from the query position it reached. -/
theorem cursor_append_of_exhausted {src qry : List α} (src' : List α)
    (h : cursor src qry = src.length) :
    cursor (src ++ src') qry = src.length + cursor src' (qry.drop (qcursor src qry)) ∧
      qcursor (src ++ src') qry = qcursor src qry + qcursor src' (qry.drop (qcursor src qry)) := by
  induction src, qry using cursor.induct with
  | case1 qry => simp [qcursor]
  | case2 x xs => simp [cursor] at h
  | case3 x xs y ys hxy ih =>
    simp only [cursor, if_pos hxy, List.length_cons] at h
    obtain ⟨h1, h2⟩ := ih (by omega)
    simp only [List.cons_append, cursor, qcursor, if_pos hxy, List.length_cons, h1, h2]
    exact ⟨by omega, trivial⟩
  | case4 xs y ys hyy ih =>
    simp only [cursor, lt_irrefl, if_false, if_true, List.length_cons] at h
    obtain ⟨h1, h2⟩ := ih (by omega)
    simp only [List.cons_append, cursor, qcursor, lt_irrefl, if_false, if_true, List.length_cons,
      h1, h2, List.drop_succ_cons]
    exact ⟨by omega, by omega⟩
  | case5 x xs y ys h1 h2 ih =>
    simp only [cursor, if_neg h1, if_neg h2] at h
    obtain ⟨h3, h4⟩ := ih h
    simp only [List.cons_append] at h3 h4
    simp only [List.cons_append, cursor, qcursor, if_neg h1, if_neg h2, List.drop_succ_cons]
    exact ⟨h3, by omega⟩

/-- L2.1a: a run that stops inside `src` (its query is exhausted) ignores what follows. -/
theorem cursor_append_of_lt {src qry : List α} (src' : List α) (h : cursor src qry < src.length) :
    cursor (src ++ src') qry = cursor src qry := by
  induction src, qry using cursor.induct with
  | case1 qry => simp at h
  | case2 x xs => simp [cursor]
  | case3 x xs y ys hxy ih =>
    simp only [cursor, if_pos hxy, List.length_cons] at h
    simp only [List.cons_append, cursor, if_pos hxy, ih (by omega)]
  | case4 xs y ys hyy ih =>
    simp only [cursor, lt_irrefl, if_false, if_true, List.length_cons] at h
    simp only [List.cons_append, cursor, lt_irrefl, if_false, if_true, ih (by omega)]
  | case5 x xs y ys h1 h2 ih =>
    simp only [cursor, if_neg h1, if_neg h2] at h
    have := ih h
    simp only [List.cons_append] at this
    simp only [List.cons_append, cursor, if_neg h1, if_neg h2, this]

/-- L2.1a helper: a one-letter source above every query letter is never consumed. -/
theorem cursor_singleton_of_lt (x : α) : ∀ (V : List α), (∀ v ∈ V, v < x) → cursor [x] V = 0
  | [], _ => by simp [cursor]
  | v :: V, h => by
    have hv : v < x := h v List.mem_cons_self
    rw [cursor, if_neg (not_lt.2 hv.le), if_neg (ne_of_gt hv)]
    exact cursor_singleton_of_lt x V fun w hw => h w (List.mem_cons_of_mem _ hw)

/-- L2.1a: a one-letter source against a nonincreasing query `y :: V`. -/
theorem cursor_singleton_cons (x y : α) (V : List α) (hV : Noninc (y :: V)) :
    (x < y → cursor [x] (y :: V) = 1 ∧ qcursor [x] (y :: V) = 0) ∧
      (x = y → cursor [x] (y :: V) = 1 ∧ qcursor [x] (y :: V) = 1) ∧
      (y < x → cursor [x] (y :: V) = 0) := by
  refine ⟨fun h => ?_, fun h => ?_, fun h => ?_⟩
  · simp [cursor, qcursor, h]
  · subst h; simp [cursor, qcursor]
  · rw [cursor, if_neg (not_lt.2 h.le), if_neg (ne_of_gt h)]
    rw [Noninc, List.pairwise_cons] at hV
    exact cursor_singleton_of_lt x V fun v hv => lt_of_le_of_lt (hV.1 v hv) h

theorem cursor_nil_right (src : List α) : cursor src [] = 0 := by
  cases src <;> simp [cursor]

/-- L2.1b helper: `ν(l)` is a sublist of `l`. -/
theorem nu_sublist (l : List α) : (nu l).Sublist l := by
  induction l using List.reverseRecOn with
  | nil => exact List.Sublist.slnil
  | append_singleton l x ih =>
    rw [nu_append_singleton, nuStep_eq_takeWhile (nu_noninc l)]
    exact ((List.takeWhile_sublist _).trans ih).append (List.Sublist.refl _)

/-- L2.1b helper: a letter at least every later letter is kept by `ν`. -/
theorem nu_cons_of_le {x : α} {xs : List α} (h : ∀ z ∈ xs, z ≤ x) : nu (x :: xs) = x :: nu xs := by
  induction xs using List.reverseRecOn with
  | nil => rfl
  | append_singleton xs w ih =>
    have ih' := ih fun z hz => h z (List.mem_append_left _ hz)
    have hw : w ≤ x := h w (List.mem_append_right _ (List.mem_singleton_self w))
    have hn : Noninc (x :: nu xs) := ih' ▸ nu_noninc (x :: xs)
    rw [← List.cons_append, nu_append_singleton, ih', nuStep_eq_takeWhile hn, List.takeWhile_cons,
      if_pos (decide_eq_true hw), nu_append_singleton, nuStep_eq_takeWhile (nu_noninc xs),
      List.cons_append]

/-- L2.1b helper: a letter below some later letter is deleted by `ν`. -/
theorem nu_cons_of_lt {x : α} {xs : List α} (h : ∃ z ∈ xs, x < z) : nu (x :: xs) = nu xs := by
  induction xs using List.reverseRecOn with
  | nil => simp at h
  | append_singleton xs w ih =>
    rw [← List.cons_append, nu_append_singleton, nu_append_singleton]
    by_cases h' : ∃ z ∈ xs, x < z
    · rw [ih h']
    · push Not at h'
      obtain ⟨z, hz, hxz⟩ := h
      have hxw : x < w := by
        rcases List.mem_append.1 hz with hz | hz
        · exact absurd (h' z hz) (not_le.2 hxz)
        · rw [List.mem_singleton] at hz; exact hz ▸ hxz
      rw [nu_cons_of_le h', nuStep_eq_takeWhile (nu_cons_of_le h' ▸ nu_noninc (x :: xs)),
        nuStep_eq_takeWhile (nu_noninc xs), List.takeWhile_cons,
        if_neg (by simpa using hxw)]
      cases hn : nu xs with
      | nil => rfl
      | cons a rest =>
        have ha : a ≤ x := h' a ((nu_sublist xs).subset (hn ▸ List.mem_cons_self))
        rw [List.takeWhile_cons, if_neg (by simpa using lt_of_le_of_lt ha hxw)]

/-- L2.1b helper: the first letter of `ν(x :: xs)` is a maximum of `x :: xs`. -/
theorem nu_head (x : α) (xs : List α) :
    ∃ m rest, nu (x :: xs) = m :: rest ∧ x ≤ m ∧ ∀ z ∈ xs, z ≤ m := by
  induction xs generalizing x with
  | nil => exact ⟨x, [], rfl, le_refl x, by simp⟩
  | cons w ws ih =>
    by_cases hall : ∀ z ∈ w :: ws, z ≤ x
    · exact ⟨x, _, nu_cons_of_le hall, le_refl x, hall⟩
    · push Not at hall
      obtain ⟨m, rest, hm, hwm, hws⟩ := ih w
      obtain ⟨z, hz, hxz⟩ := hall
      have hzm : ∀ z ∈ w :: ws, z ≤ m := by
        intro z hz
        rcases List.mem_cons.1 hz with rfl | hz
        · exact hwm
        · exact hws z hz
      exact ⟨m, rest, (nu_cons_of_lt ⟨z, hz, hxz⟩).trans hm, (hxz.trans_le (hzm z hz)).le, hzm⟩

/-- L2.1b helper: a list whose first letter is below `m` is below every list starting with `m`. -/
theorem lt_cons_of_head_lt {l : List α} {m : α} (rest : List α) (h : ∀ a ∈ l.head?, a < m) :
    l < m :: rest := by
  cases l with
  | nil => exact List.nil_lt_cons _ _
  | cons a l => exact List.cons_lt_cons_iff.2 (Or.inl (h a rfl))

/-- L2.1b helper: the empty list is least. -/
theorem nil_le_list (l : List α) : ([] : List α) ≤ l := by
  cases l with
  | nil => exact le_refl _
  | cons a l => exact le_of_lt (List.nil_lt_cons _ _)

/-- L2.1b helper: `≤` under a common first letter. -/
theorem cons_le_cons_iff' (a : α) (l l' : List α) : a :: l ≤ a :: l' ↔ l ≤ l' := by
  rw [le_iff_lt_or_eq, le_iff_lt_or_eq, List.cons_lt_cons_iff, List.cons.injEq]
  simp

/-- L2.1b (txt:170-173): against a nonincreasing query, exhaustion is lexicographic comparison
of the reduced source. -/
theorem cursor_eq_length_iff (src : List α) {W : List α} (hW : Noninc W) :
    cursor src W = src.length ↔ nu src ≤ W := by
  induction src, W using cursor.induct with
  | case1 W => exact iff_of_true (by simp [cursor]) (nil_le_list W)
  | case2 x xs =>
    obtain ⟨m, rest, hm, -⟩ := nu_head x xs
    rw [hm, cursor]
    exact iff_of_false (by simp) (not_le.2 (List.nil_lt_cons _ _))
  | case3 x xs y ys hxy ih =>
    rw [cursor, if_pos hxy, List.length_cons, Nat.add_right_cancel_iff, ih hW]
    by_cases hall : ∀ z ∈ xs, z ≤ x
    · rw [nu_cons_of_le hall]
      refine iff_of_true (le_of_lt (lt_cons_of_head_lt _ fun a ha => ?_))
        (le_of_lt (List.cons_lt_cons_iff.2 (Or.inl hxy)))
      have ha' : a ∈ nu xs := List.mem_of_mem_head? ha
      exact lt_of_le_of_lt (hall a ((nu_sublist xs).subset ha')) hxy
    · push Not at hall
      rw [nu_cons_of_lt hall]
  | case4 xs y ys hyy ih =>
    have hys : Noninc ys := (List.pairwise_cons.1 hW).2
    rw [cursor, if_neg hyy, if_pos rfl, List.length_cons, Nat.add_right_cancel_iff, ih hys]
    by_cases hall : ∀ z ∈ xs, z ≤ y
    · rw [nu_cons_of_le hall, cons_le_cons_iff']
    · push Not at hall
      obtain ⟨z, hz, hyz⟩ := hall
      rw [nu_cons_of_lt ⟨z, hz, hyz⟩]
      obtain ⟨w, ws, rfl⟩ : ∃ w ws, xs = w :: ws := List.exists_cons_of_ne_nil (List.ne_nil_of_mem hz)
      obtain ⟨m, rest, hm, hwm, hws⟩ := nu_head w ws
      have hym : y < m := by
        rcases List.mem_cons.1 hz with rfl | hz
        · exact lt_of_lt_of_le hyz hwm
        · exact lt_of_lt_of_le hyz (hws z hz)
      rw [hm]
      refine iff_of_false (not_le.2 (lt_cons_of_head_lt _ fun a ha => ?_))
        (not_le.2 (List.cons_lt_cons_iff.2 (Or.inl hym)))
      exact lt_of_le_of_lt ((List.pairwise_cons.1 hW).1 a (List.mem_of_mem_head? ha)) hym
  | case5 x xs y ys h1 h2 ih =>
    have hys : Noninc ys := (List.pairwise_cons.1 hW).2
    have hyx : y < x := lt_of_le_of_ne (not_lt.1 h1) (Ne.symm h2)
    rw [cursor, if_neg h1, if_neg h2, ih hys]
    obtain ⟨m, rest, hm, hxm, -⟩ := nu_head x xs
    have hym : y < m := lt_of_lt_of_le hyx hxm
    rw [hm]
    refine iff_of_false (not_le.2 (lt_cons_of_head_lt _ fun a ha => ?_))
      (not_le.2 (List.cons_lt_cons_iff.2 (Or.inl hym)))
    exact lt_of_le_of_lt ((List.pairwise_cons.1 hW).1 a (List.mem_of_mem_head? ha)) hym

-- provides: U1, L2.1 (scan boundary lemma, reduced query). Moved here from `Plan/Spine.lean`
-- (brief rule 5): its proof needs `cursor_take` and `cursor_eq_length_iff`; nothing in between
-- uses it.
theorem cursor_spec {α : Type} [LinearOrder α] (ks W : List α)
    (hW : W.Pairwise fun x y => y ≤ x) :
    cutQuery ks (cursor ks W) ≤ W ∧
      (cursor ks W < ks.length → W < cutQuery ks (cursor ks W + 1)) := by
  have hc := cursor_le_length ks W
  refine ⟨?_, fun hlt => ?_⟩
  · have h1 : cursor (ks.take (cursor ks W)) W = (ks.take (cursor ks W)).length := by
      rw [cursor_take, min_self, List.length_take, Nat.min_eq_left hc]
    exact (cursor_eq_length_iff _ hW).1 h1
  · have h1 : cursor (ks.take (cursor ks W + 1)) W ≠ (ks.take (cursor ks W + 1)).length := by
      rw [cursor_take, List.length_take, Nat.min_eq_left hlt]; omega
    exact not_le.1 fun h => h1 ((cursor_eq_length_iff _ hW).2 h)

/-- L2.1 ("the unique i", txt:165-167). -/
theorem cursor_unique {ks W : List α} (hW : Noninc W) {i : Nat} (hi : i ≤ ks.length)
    (hlo : cutQuery ks i ≤ W) (hhi : i < ks.length → W < cutQuery ks (i + 1)) :
    cursor ks W = i := by
  obtain ⟨h1, h2⟩ := cursor_spec ks W hW
  have hc := cursor_le_length ks W
  rcases lt_trichotomy i (cursor ks W) with h | h | h
  · exact absurd (lt_of_lt_of_le (hhi (by omega)) ((cutQuery_mono ks h).trans h1)) (lt_irrefl W)
  · exact h.symm
  · exact absurd (lt_of_lt_of_le (h2 (by omega)) ((cutQuery_mono ks h).trans hlo)) (lt_irrefl W)

/-- L2.1: a query strictly below `B(v)` stops the scan at or before `v`. -/
theorem cursor_le_of_lt_cutQuery {ks W : List α} (hW : Noninc W) {v : Nat} (hv : v < ks.length)
    (h : W < cutQuery ks (v + 1)) : cursor ks W ≤ v := by
  by_contra hc
  exact lt_irrefl W (lt_of_lt_of_le h
    ((cutQuery_mono ks (by omega : v + 1 ≤ cursor ks W)).trans (cursor_spec ks W hW).1))

/-- L2.1: a query at least `B(v-1)` reaches `v`. -/
theorem le_cursor_of_cutQuery_le {ks W : List α} (hW : Noninc W) {v : Nat} (hv : v ≤ ks.length)
    (h : cutQuery ks v ≤ W) : v ≤ cursor ks W := by
  have h1 : cursor (ks.take v) W = (ks.take v).length := (cursor_eq_length_iff _ hW).2 h
  rw [cursor_take, List.length_take, Nat.min_eq_left hv] at h1
  omega

/-- L2.1: the final source cursor is monotone in reduced queries (used by L2.2). -/
theorem cursor_mono (ks : List α) {W Z : List α} (hW : Noninc W) (hZ : Noninc Z) (h : W ≤ Z) :
    cursor ks W ≤ cursor ks Z := by
  by_contra hc
  have hZl : cursor ks Z < ks.length := by have := cursor_le_length ks W; omega
  exact lt_irrefl Z (lt_of_lt_of_le ((cursor_spec ks Z hZ).2 hZl)
    (((cutQuery_mono ks (by omega : cursor ks Z + 1 ≤ cursor ks W)).trans
      (cursor_spec ks W hW).1).trans h))

/-- L2.1c (txt:174-176): deleting a query letter immediately followed by a larger one does not
change the final source cursor. -/
theorem cursor_delete (src A B : List α) {x y : α} (hxy : x < y) :
    cursor src (A ++ x :: y :: B) = cursor src (A ++ y :: B) := by
  induction A generalizing src with
  | nil =>
    induction src with
    | nil => simp [cursor]
    | cons s ss ih =>
      simp only [List.nil_append] at ih ⊢
      rcases lt_trichotomy s x with h | h | h
      · conv_lhs => rw [cursor, if_pos h]
        conv_rhs => rw [cursor, if_pos (lt_trans h hxy)]
        rw [ih]
      · subst h
        conv_lhs => rw [cursor, if_neg (lt_irrefl _), if_pos rfl]
        conv_rhs => rw [cursor, if_pos hxy]
      · conv_lhs => rw [cursor, if_neg (not_lt.2 h.le), if_neg (ne_of_gt h)]
  | cons a A ih =>
    induction src with
    | nil => simp [cursor]
    | cons s ss ihs =>
      simp only [List.cons_append] at ihs ⊢
      rcases lt_trichotomy s a with h | h | h
      · conv_lhs => rw [cursor, if_pos h]
        conv_rhs => rw [cursor, if_pos h]
        rw [ihs]
      · subst h
        conv_lhs => rw [cursor, if_neg (lt_irrefl _), if_pos rfl]
        conv_rhs => rw [cursor, if_neg (lt_irrefl _), if_pos rfl]
        rw [ih]
      · conv_lhs => rw [cursor, if_neg (not_lt.2 h.le), if_neg (ne_of_gt h)]
        conv_rhs => rw [cursor, if_neg (not_lt.2 h.le), if_neg (ne_of_gt h)]
        rw [ih]

/-- L2.1c helper: deleting the terminal letters `< y` before `y` does not change the cursor. -/
theorem cursor_reduce_before (src : List α) (y : α) (C : List α) (acc : List α) :
    cursor src ((acc.reverse.dropWhile fun z => decide (z < y)).reverse ++ y :: C) =
      cursor src (acc ++ y :: C) := by
  induction acc using List.reverseRecOn with
  | nil => rfl
  | append_singleton acc d ih =>
    rw [List.reverse_append, List.reverse_singleton, List.singleton_append, List.dropWhile_cons]
    by_cases hd : d < y
    · rw [if_pos (decide_eq_true hd), ih, List.append_assoc, List.singleton_append,
        cursor_delete src acc C hd]
    · rw [if_neg (by simpa using hd), List.reverse_cons, List.reverse_reverse, List.append_assoc,
        List.singleton_append]

-- provides: U1, L2.1 (reducing a query does not change the final source cursor). Moved here from
-- `Plan/Spine.lean` (brief rule 5): its proof needs `cursor_delete`; nothing in between uses it.
theorem cursor_nu {α : Type} [LinearOrder α] (ks W : List α) :
    cursor ks (nu W) = cursor ks W := by
  suffices h : ∀ C, cursor ks (nu W ++ C) = cursor ks (W ++ C) by simpa using h []
  induction W using List.reverseRecOn with
  | nil => intro C; rfl
  | append_singleton W y ih =>
    intro C
    rw [nu_append_singleton, nuStep, List.append_assoc, List.singleton_append,
      cursor_reduce_before, ih, List.append_assoc, List.singleton_append]

/-- L2.5a helper: the final state of a run started at `(i, j)`. -/
theorem traceFrom_getLast (src qry : List α) (i j : Nat) :
    (traceFrom i j src qry).getLast? = some (i + cursor src qry, j + qcursor src qry) := by
  induction src, qry using cursor.induct generalizing i j with
  | case1 qry => simp [traceFrom, cursor, qcursor]
  | case2 x xs => simp [traceFrom, cursor, qcursor]
  | case3 x xs y ys h ih =>
    rw [traceFrom, if_pos h, List.getLast?_cons, ih, cursor, if_pos h, qcursor, if_pos h]
    simp only [Option.getD_some, Option.some.injEq, Prod.mk.injEq, and_true]; omega
  | case4 xs y ys h ih =>
    rw [traceFrom, if_neg h, if_pos rfl, List.getLast?_cons, ih, cursor, if_neg h, if_pos rfl,
      qcursor, if_neg h, if_pos rfl]
    simp only [Option.getD_some, Option.some.injEq, Prod.mk.injEq]; omega
  | case5 x xs y ys h1 h2 ih =>
    rw [traceFrom, if_neg h1, if_neg h2, List.getLast?_cons, ih, cursor, if_neg h1, if_neg h2,
      qcursor, if_neg h1, if_neg h2]
    simp only [Option.getD_some, Option.some.injEq, Prod.mk.injEq, true_and]; omega

/-- L2.5a: the final state of the trace is `(cursor, qcursor)`. -/
theorem trace_last (src qry : List α) :
    (trace src qry).getLast? = some (cursor src qry, qcursor src qry) := by
  have := traceFrom_getLast src qry 0 0
  simpa [trace] using this

/-- L2.5a: equal traces have equal final source cursors. -/
theorem cursor_eq_of_trace_eq {src₁ src₂ qry₁ qry₂ : List α}
    (h : trace src₁ qry₁ = trace src₂ qry₂) : cursor src₁ qry₁ = cursor src₂ qry₂ := by
  have := trace_last src₁ qry₁
  rw [h, trace_last] at this
  exact (Prod.mk.inj (Option.some.inj this)).1.symm

/-- L2.5a helper: every state of a run started at `(i, j)` lies between the start and the final
state, coordinatewise. -/
theorem mem_traceFrom (src qry : List α) (i j : Nat) {s : Nat × Nat}
    (hs : s ∈ traceFrom i j src qry) :
    i ≤ s.1 ∧ s.1 ≤ i + cursor src qry ∧ j ≤ s.2 ∧ s.2 ≤ j + qcursor src qry := by
  induction src, qry using cursor.induct generalizing i j with
  | case1 qry =>
    simp only [traceFrom, List.mem_singleton] at hs; subst hs; simp
  | case2 x xs =>
    simp only [traceFrom, List.mem_singleton] at hs; subst hs; simp
  | case3 x xs y ys h ih =>
    rw [traceFrom, if_pos h, List.mem_cons] at hs
    rw [cursor, if_pos h, qcursor, if_pos h]
    rcases hs with rfl | hs
    · simp
    · have := ih (i + 1) j hs; omega
  | case4 xs y ys h ih =>
    rw [traceFrom, if_neg h, if_pos rfl, List.mem_cons] at hs
    rw [cursor, if_neg h, if_pos rfl, qcursor, if_neg h, if_pos rfl]
    rcases hs with rfl | hs
    · simp
    · have := ih (i + 1) (j + 1) hs; omega
  | case5 x xs y ys h1 h2 ih =>
    rw [traceFrom, if_neg h1, if_neg h2, List.mem_cons] at hs
    rw [cursor, if_neg h1, if_neg h2, qcursor, if_neg h1, if_neg h2]
    rcases hs with rfl | hs
    · simp
    · have := ih i (j + 1) hs; omega

-- U1-verify: changed (new declaration)
/-- L2.5a: no state of a run has a source cursor beyond the final one (used in the proof of
`trace_agree`). -/
theorem trace_fst_le_cursor (src qry : List α) {i j : Nat} (h : (i, j) ∈ trace src qry) :
    i ≤ cursor src qry := by
  simpa using (mem_traceFrom src qry 0 0 h).2.1

/-- L2.5 helper: `trace_map` from an arbitrary start state. -/
theorem traceFrom_map {β : Type} [LinearOrder β] {f : α → β} (hf : StrictMono f)
    (src qry : List α) (i j : Nat) :
    traceFrom i j (src.map f) (qry.map f) = traceFrom i j src qry := by
  induction src, qry using cursor.induct generalizing i j with
  | case1 qry => simp [traceFrom]
  | case2 x xs => simp [traceFrom]
  | case3 x xs y ys h ih =>
    have := ih (i + 1) j
    simp only [List.map_cons] at this
    simp only [List.map_cons, traceFrom, if_pos (hf.lt_iff_lt.2 h), if_pos h, this]
  | case4 xs y ys h ih =>
    have := ih (i + 1) (j + 1)
    simp only [List.map_cons, traceFrom, lt_irrefl, if_false, if_true, this]
  | case5 x xs y ys h1 h2 ih =>
    have := ih i (j + 1)
    simp only [List.map_cons] at this
    simp only [List.map_cons, traceFrom, if_neg (mt hf.lt_iff_lt.1 h1), if_neg (hf.injective.ne h2),
      if_neg h1, if_neg h2, this]

/-- L2.5 (1) (`trace_map`†, txt:238): a common strictly increasing map preserves every cursor
pair. -/
theorem trace_map {β : Type} [LinearOrder β] {f : α → β} (hf : StrictMono f) (src qry : List α) :
    trace (src.map f) (qry.map f) = trace src qry := traceFrom_map hf src qry 0 0

/-- L2.5 (1), cursor form. -/
theorem cursor_map {β : Type} [LinearOrder β] {f : α → β} (hf : StrictMono f) (src qry : List α) :
    cursor (src.map f) (qry.map f) = cursor src qry := by
  have h1 := trace_last (src.map f) (qry.map f)
  rw [trace_map hf, trace_last] at h1
  exact (Prod.mk.inj (Option.some.inj h1)).1.symm

/-- L2.5 helper: a one-letter source that is never consumed can be raised to `⊤`. -/
theorem traceFrom_singleton_top {β : Type} [LinearOrder β] [OrderTop β] (s : β) :
    ∀ (qry : List β) (i j : Nat), cursor [s] qry = 0 →
      traceFrom i j [⊤] qry = traceFrom i j [s] qry
  | [], i, j, _ => by simp [traceFrom]
  | y :: ys, i, j, h => by
    have h1 : ¬ s < y := fun hc => by rw [cursor, if_pos hc] at h; simp at h
    have h2 : ¬ s = y := fun hc => by rw [cursor, if_neg h1, if_pos hc] at h; simp at h
    rw [cursor, if_neg h1, if_neg h2] at h
    have hys : y < s := lt_of_le_of_ne (not_lt.1 h1) (Ne.symm h2)
    have h3 : ¬ (⊤ : β) < y := not_lt.2 le_top
    have h4 : ¬ (⊤ : β) = y := fun hc => by
      rw [← hc] at hys; exact absurd hys (not_lt.2 le_top)
    conv_lhs => rw [traceFrom, if_neg h3, if_neg h4]
    conv_rhs => rw [traceFrom, if_neg h1, if_neg h2]
    rw [traceFrom_singleton_top s ys i (j + 1) h]

/-- L2.5 helper: `trace_cap_top` for a source `A ⌢ [s]` and an arbitrary start state. -/
theorem traceFrom_cap_top {β : Type} [LinearOrder β] [OrderTop β] (s : β) (A : List β) :
    ∀ (qry : List β) (i j : Nat), cursor (A ++ [s]) qry < A.length + 1 →
      traceFrom i j (A ++ [⊤]) qry = traceFrom i j (A ++ [s]) qry := by
  induction A with
  | nil =>
    intro qry i j h
    simp only [List.nil_append, List.length_nil, Nat.zero_add, Nat.lt_one_iff] at h ⊢
    exact traceFrom_singleton_top s qry i j h
  | cons a A ih =>
    intro qry
    induction qry with
    | nil => intro i j _; simp [traceFrom]
    | cons y ys ihq =>
      intro i j h
      simp only [List.cons_append, List.length_cons] at h ihq ⊢
      by_cases h1 : a < y
      · rw [cursor, if_pos h1] at h
        rw [traceFrom, traceFrom, if_pos h1, if_pos h1, ih (y :: ys) (i + 1) j (by omega)]
      · by_cases h2 : a = y
        · subst h2
          rw [cursor, if_neg h1, if_pos rfl] at h
          rw [traceFrom, traceFrom, if_neg h1, if_pos rfl, if_neg h1, if_pos rfl,
            ih ys (i + 1) (j + 1) (by omega)]
        · rw [cursor, if_neg h1, if_neg h2] at h
          rw [traceFrom, traceFrom, if_neg h1, if_neg h2, if_neg h1, if_neg h2, ihq i (j + 1) h]

/-- L2.5 (2) (`trace_cap_top`†, txt:239, 242-244): if a nonempty source is not exhausted,
replacing its last key by `⊤` preserves every cursor pair. -/
theorem trace_cap_top {β : Type} [LinearOrder β] [OrderTop β] {src qry : List β} (hne : src ≠ [])
    (hnx : cursor src qry < src.length) : trace (src.dropLast ++ [⊤]) qry = trace src qry := by
  have hsrc := List.dropLast_append_getLast hne
  have hlen : src.length = src.dropLast.length + 1 := by
    conv_lhs => rw [← hsrc]
    simp
  rw [← hsrc] at hnx
  unfold trace
  conv_rhs => rw [← hsrc]
  exact traceFrom_cap_top _ _ qry 0 0 (by rw [← hlen]; rwa [hsrc] at hnx ⊢)

/-- L2.5 helper: `trace_agree` from an arbitrary start state, with the sign hypothesis phrased
through `getElem?`. -/
theorem traceFrom_agree (u : Nat) : ∀ (src₁ src₂ qry : List α) (i j : Nat),
    src₁.take u = src₂.take u →
    (∃ x₁ x₂, src₁[u]? = some x₁ ∧ src₂[u]? = some x₂ ∧ ∀ y ∈ qry, compare x₁ y = compare x₂ y) →
    cursor src₁ qry ≤ u → traceFrom i j src₁ qry = traceFrom i j src₂ qry := by
  induction u with
  | zero =>
    intro src₁ src₂ qry i j _ hsign hrun
    obtain ⟨x₁, x₂, h₁, h₂, hs⟩ := hsign
    obtain ⟨S₁, rfl⟩ : ∃ S₁, src₁ = x₁ :: S₁ := by
      cases src₁ with
      | nil => simp at h₁
      | cons a S₁ => simp at h₁; exact ⟨S₁, by rw [h₁]⟩
    obtain ⟨S₂, rfl⟩ : ∃ S₂, src₂ = x₂ :: S₂ := by
      cases src₂ with
      | nil => simp at h₂
      | cons a S₂ => simp at h₂; exact ⟨S₂, by rw [h₂]⟩
    induction qry generalizing i j with
    | nil => simp [traceFrom]
    | cons y ys ihq =>
      have hy := hs y List.mem_cons_self
      have h1 : ¬ x₁ < y := fun hc => by rw [cursor, if_pos hc] at hrun; omega
      have h2 : ¬ x₁ = y := fun hc => by rw [cursor, if_neg h1, if_pos hc] at hrun; omega
      have hgt : compare x₁ y = .gt :=
        compare_gt_iff_gt.2 (lt_of_le_of_ne (not_lt.1 h1) (Ne.symm h2))
      have hgt' : y < x₂ := compare_gt_iff_gt.1 (hy ▸ hgt)
      have h3 : ¬ x₂ < y := not_lt.2 hgt'.le
      have h4 : ¬ x₂ = y := ne_of_gt hgt'
      rw [cursor, if_neg h1, if_neg h2] at hrun
      rw [traceFrom, traceFrom, if_neg h1, if_neg h2, if_neg h3, if_neg h4,
        ihq i (j + 1) (fun z hz => hs z (List.mem_cons_of_mem _ hz)) hrun]
  | succ u ih =>
    intro src₁ src₂ qry i j hpre hsign hrun
    obtain ⟨x₁, x₂, h₁, h₂, hs⟩ := hsign
    cases src₁ with
    | nil => simp at h₁
    | cons a S₁ =>
    cases src₂ with
    | nil => simp at h₂
    | cons b S₂ =>
    simp only [List.take_succ_cons, List.cons.injEq] at hpre
    obtain ⟨rfl, hpre⟩ := hpre
    simp only [List.getElem?_cons_succ] at h₁ h₂
    induction qry generalizing i j with
    | nil => simp [traceFrom]
    | cons y ys ihq =>
      by_cases h1 : a < y
      · rw [cursor, if_pos h1] at hrun
        rw [traceFrom, traceFrom, if_pos h1, if_pos h1,
          ih S₁ S₂ (y :: ys) (i + 1) j hpre ⟨x₁, x₂, h₁, h₂, hs⟩ (by omega)]
      · by_cases h2 : a = y
        · subst h2
          rw [cursor, if_neg h1, if_pos rfl] at hrun
          rw [traceFrom, traceFrom, if_neg h1, if_pos rfl, if_neg h1, if_pos rfl,
            ih S₁ S₂ ys (i + 1) (j + 1) hpre
              ⟨x₁, x₂, h₁, h₂, fun z hz => hs z (List.mem_cons_of_mem _ hz)⟩ (by omega)]
        · rw [cursor, if_neg h1, if_neg h2] at hrun
          rw [traceFrom, traceFrom, if_neg h1, if_neg h2, if_neg h1, if_neg h2,
            ihq i (j + 1) (fun z hz => hs z (List.mem_cons_of_mem _ hz)) hrun]

/-- L2.5 (3) (`trace_agree`†, txt:240-241, 244-245): sources agreeing before `u`, with keys at `u`
of identical signs against every query key, have the same trace for a run ending at or before
`u`. -/
theorem trace_agree {src₁ src₂ qry : List α} {u : Nat} (hpre : src₁.take u = src₂.take u)
    (hu₁ : u < src₁.length) (hu₂ : u < src₂.length)
    (hsign : ∀ y ∈ qry, compare src₁[u] y = compare src₂[u] y) (hrun : cursor src₁ qry ≤ u) :
    trace src₁ qry = trace src₂ qry :=
  traceFrom_agree u src₁ src₂ qry 0 0 hpre
    ⟨src₁[u], src₂[u], List.getElem?_eq_getElem hu₁, List.getElem?_eq_getElem hu₂, hsign⟩ hrun

end Words

/-- L2.5b (`cursor_eq_scanCount`†): the generic cursor at `Key` is the locked `scanCount`. -/
theorem cursor_eq_scanCount (xs ys : List Key) : scanCount xs ys = cursor xs ys := by
  induction xs, ys using cursor.induct with
  | case1 ys => simp [scanCount, cursor]
  | case2 x xs => simp [scanCount, cursor]
  | case3 x xs y ys h ih =>
    have hc : keyCmp x y = .lt := h
    rw [scanCount, cursor, if_pos h, ← ih, hc]
  | case4 xs y ys h ih =>
    have hc : keyCmp y y = .eq := Tree.cmp_self keyLabelCmp y
    rw [scanCount, cursor, if_neg h, if_pos rfl, ← ih, hc]
  | case5 x xs y ys h1 h2 ih =>
    have hc : keyCmp x y = .gt := by
      rw [← Key.compare_eq_keyCmp]
      exact compare_gt_iff_gt.2 (lt_of_le_of_ne (not_lt.1 h1) (Ne.symm h2))
    rw [scanCount, cursor, if_neg h1, if_neg h2, ← ih, hc]

/-! ## N1.2, C1.8a, C1.8, D1.9 — compact words and safe prefixes -/

/-- N1.2: atoms of the generic compact word over labels `α`: `(depth coordinate, marker, label)`,
the label `⊥` marking an empty column. -/
abbrev GAtom (α : Type) := Nat ×ₗ Nat ×ₗ WithBot α

mutual
/-- N1.2: the generic compact word at depth `e` (txt:143-146), with `⊥` in the empty-column
atom so that relabelling commutes with the word. -/
def gwordAt {α : Type} (e : Nat) : Tree α → List (GAtom α)
  | .node cols => gwordCols e cols

def gwordCols {α : Type} (e : Nat) : List (List (α × Tree α)) → List (GAtom α)
  | [] => []
  | col :: rest => gwordCol e col ++ gwordCols e rest

def gwordCol {α : Type} (e : Nat) : List (α × Tree α) → List (GAtom α)
  | [] => [toLex (2 * e, toLex (0, (⊥ : WithBot α)))]
  | (p, h) :: rest =>
    toLex (2 * e, toLex (1, (p : WithBot α))) :: (gwordAt (e + 1) h ++ gwordLater e rest)

def gwordLater {α : Type} (e : Nat) : List (α × Tree α) → List (GAtom α)
  | [] => []
  | (p, h) :: rest =>
    toLex (2 * e + 1, toLex (0, (p : WithBot α))) :: (gwordAt (e + 1) h ++ gwordLater e rest)
end

/-- N1.2. -/
def gword {α : Type} (t : Tree α) : List (GAtom α) := gwordAt 0 t

/-- N1.2: relabelling of an atom. -/
def GAtom.map {α β : Type} (f : α → β) (A : GAtom α) : GAtom β :=
  toLex ((ofLex A).1, toLex ((ofLex (ofLex A).2).1, (ofLex (ofLex A).2).2.map f))

/-- N1.2: the spine's word atoms, read as generic atoms (`⊥` exactly at even depth coordinate and
marker `0`, which only the empty-column atom has). -/
def toGAtom (A : WordAtom) : GAtom Nat :=
  toLex ((ofLex A).1, toLex ((ofLex (ofLex A).2).1,
    if (ofLex A).1 % 2 = 0 ∧ (ofLex (ofLex A).2).1 = 0 then (⊥ : WithBot Nat)
    else ((ofLex (ofLex A).2).2 : WithBot Nat)))

mutual
/-- N1.2 helper: `gword_map` at an arbitrary depth. -/
theorem gwordAt_map {α β : Type} (f : α → β) :
    (e : Nat) → (t : Tree α) → gwordAt e (t.map f) = (gwordAt e t).map (GAtom.map f)
  | e, .node cols => by
    simp only [Tree.map, gwordAt]; exact gwordCols_map f e cols
theorem gwordCols_map {α β : Type} (f : α → β) :
    (e : Nat) → (cs : List (List (α × Tree α))) →
      gwordCols e (Tree.mapCols f cs) = (gwordCols e cs).map (GAtom.map f)
  | _, [] => rfl
  | e, c :: cs => by
    simp only [Tree.mapCols, gwordCols, List.map_append]
    rw [gwordCol_map f e c, gwordCols_map f e cs]
theorem gwordCol_map {α β : Type} (f : α → β) :
    (e : Nat) → (c : List (α × Tree α)) →
      gwordCol e (Tree.mapCol f c) = (gwordCol e c).map (GAtom.map f)
  | _, [] => rfl
  | e, (p, h) :: es => by
    simp only [Tree.mapCol, gwordCol, List.map_cons, List.map_append]
    rw [gwordAt_map f (e + 1) h, gwordLater_map f e es]
    rfl
theorem gwordLater_map {α β : Type} (f : α → β) :
    (e : Nat) → (c : List (α × Tree α)) →
      gwordLater e (Tree.mapCol f c) = (gwordLater e c).map (GAtom.map f)
  | _, [] => rfl
  | e, (p, h) :: es => by
    simp only [Tree.mapCol, gwordLater, List.map_cons, List.map_append]
    rw [gwordAt_map f (e + 1) h, gwordLater_map f e es]
    rfl
end

/-- N1.2: relabelling commutes with the generic word (positions and length are unchanged). -/
theorem gword_map {α β : Type} (f : α → β) (t : Tree α) :
    gword (t.map f) = (gword t).map (GAtom.map f) := gwordAt_map f 0 t

mutual
/-- N1.2 helper: `gword_eq_map_word` at an arbitrary depth. -/
theorem gwordAt_eq_map_wordAt : (e : Nat) → (E : Forest) → gwordAt e E = (wordAt e E).map toGAtom
  | e, .node cols => by
    simp only [gwordAt, wordAt]; exact gwordCols_eq_map_wordCols e cols
theorem gwordCols_eq_map_wordCols :
    (e : Nat) → (cs : List Column) → gwordCols e cs = (wordCols e cs).map toGAtom
  | _, [] => rfl
  | e, c :: cs => by
    simp only [gwordCols, wordCols, List.map_append]
    rw [gwordCol_eq_map_wordCol e c, gwordCols_eq_map_wordCols e cs]
theorem gwordCol_eq_map_wordCol :
    (e : Nat) → (c : Column) → gwordCol e c = (wordCol e c).map toGAtom
  | e, [] => by
    simp [gwordCol, wordCol, toGAtom]
  | e, (p, h) :: es => by
    simp only [gwordCol, wordCol, List.map_cons, List.map_append]
    rw [gwordAt_eq_map_wordAt (e + 1) h, gwordLater_eq_map_wordLater e es]
    simp [toGAtom]; rfl
theorem gwordLater_eq_map_wordLater :
    (e : Nat) → (c : Column) → gwordLater e c = (wordLater e c).map toGAtom
  | _, [] => rfl
  | e, (p, h) :: es => by
    simp only [gwordLater, wordLater, List.map_cons, List.map_append]
    rw [gwordAt_eq_map_wordAt (e + 1) h, gwordLater_eq_map_wordLater e es]
    simp [toGAtom, Nat.add_mod]; rfl
end

/-- N1.2: the spine's word is the generic word with the label decoration forgotten. -/
theorem gword_eq_map_word (E : Forest) : gword E = (word E).map toGAtom :=
  gwordAt_eq_map_wordAt 0 E

theorem mu_eq_length_gword (E : Forest) : mu E = (gword E).length := by
  rw [gword_eq_map_word, List.length_map]; rfl

mutual
/-- C1.8a helper: `gwordAt_fst_ge` together with its column, entry and later-entry forms. -/
theorem gwordAt_fst_ge' {α : Type} : (e : Nat) → (t : Tree α) → ∀ A ∈ gwordAt e t, 2 * e ≤ (ofLex A).1
  | e, .node cols => by simp only [gwordAt]; exact gwordCols_fst_ge e cols
theorem gwordCols_fst_ge {α : Type} :
    (e : Nat) → (cs : List (List (α × Tree α))) → ∀ A ∈ gwordCols e cs, 2 * e ≤ (ofLex A).1
  | _, [] => by simp [gwordCols]
  | e, c :: cs => by
    simp only [gwordCols, List.mem_append]
    rintro A (hA | hA)
    · exact gwordCol_fst_ge e c A hA
    · exact gwordCols_fst_ge e cs A hA
theorem gwordCol_fst_ge {α : Type} :
    (e : Nat) → (c : List (α × Tree α)) → ∀ A ∈ gwordCol e c, 2 * e ≤ (ofLex A).1
  | e, [] => by simp [gwordCol]
  | e, (p, h) :: es => by
    simp only [gwordCol, List.mem_cons, List.mem_append]
    rintro A (rfl | hA | hA)
    · simp
    · have := gwordAt_fst_ge' (e + 1) h A hA; omega
    · exact gwordLater_fst_ge e es A hA
theorem gwordLater_fst_ge {α : Type} :
    (e : Nat) → (c : List (α × Tree α)) → ∀ A ∈ gwordLater e c, 2 * e ≤ (ofLex A).1
  | _, [] => by simp [gwordLater]
  | e, (p, h) :: es => by
    simp only [gwordLater, List.mem_cons, List.mem_append]
    rintro A (rfl | hA | hA)
    · simp
    · have := gwordAt_fst_ge' (e + 1) h A hA; omega
    · exact gwordLater_fst_ge e es A hA
end

/-- C1.8a: every atom of `gwordAt e t` has depth coordinate at least `2e`. -/
theorem gwordAt_fst_ge {α : Type} (e : Nat) (t : Tree α) :
    ∀ A ∈ gwordAt e t, 2 * e ≤ (ofLex A).1 := gwordAt_fst_ge' e t

/-- C1.8a helper: the three-way reading of a comparison `o` of `X` with `Y`; `Q` is what an
`.eq` comparison yields. -/
def CmpTri {β : Type} [LT β] (o : Ordering) (X Y : β) (Q : Prop) : Prop :=
  (o = .lt → X < Y) ∧ (o = .gt → Y < X) ∧ (o = .eq → Q)

theorem CmpTri.mono {β : Type} [LT β] {o : Ordering} {X Y : β} {Q Q' : Prop}
    (h : CmpTri o X Y Q) (hQ : Q → Q') : CmpTri o X Y Q' :=
  ⟨h.1, h.2.1, fun ho => hQ (h.2.2 ho)⟩

/-- C1.8a helper: a common prefix does not change a list comparison. -/
theorem list_append_lt_append_left {β : Type} [LinearOrder β] (l : List β) {xs ys : List β} :
    l ++ xs < l ++ ys ↔ xs < ys := by
  induction l with
  | nil => rfl
  | cons a l ih => rw [List.cons_append, List.cons_append, List.cons_lt_cons_iff, ih]; simp

/-- C1.8a helper: a lexicographic `then` of two three-way comparisons, the second read after a
common (on `.eq`) prefix. -/
theorem CmpTri.then {β : Type} [LinearOrder β] {o₁ o₂ : Ordering} {P P' X Y : List β}
    {Qa Qb : Prop} (h₁ : CmpTri o₁ (P ++ X) (P' ++ Y) Qa) (hP : Qa → P = P')
    (h₂ : CmpTri o₂ X Y Qb) : CmpTri (o₁.then o₂) (P ++ X) (P' ++ Y) (Qa ∧ Qb) := by
  cases o₁ with
  | lt => exact ⟨fun _ => h₁.1 rfl, fun h => by simp [Ordering.then] at h,
      fun h => by simp [Ordering.then] at h⟩
  | gt => exact ⟨fun h => by simp [Ordering.then] at h, fun _ => h₁.2.1 rfl,
      fun h => by simp [Ordering.then] at h⟩
  | eq =>
    have hQa := h₁.2.2 rfl
    obtain rfl := hP hQa
    simp only [Ordering.then]
    exact ⟨fun h => (list_append_lt_append_left P).mpr (h₂.1 h),
      fun h => (list_append_lt_append_left P).mpr (h₂.2.1 h), fun h => ⟨hQa, h₂.2.2 h⟩⟩

/-- C1.8a helper: a continuation whose head is below `b` precedes a list starting at depth
coordinate `≥ b`. -/
theorem headLt_lt {α : Type} [LinearOrder α] {b : Nat} {xs : List (GAtom α)}
    (hxs : ∀ A ∈ xs.head?, (ofLex A).1 < b) {A : GAtom α} (hA : b ≤ (ofLex A).1)
    (Y : List (GAtom α)) : xs < A :: Y := by
  cases xs with
  | nil => exact List.nil_lt_cons _ _
  | cons x xs =>
    have hx := hxs x (by simp)
    exact List.cons_lt_cons_iff.mpr (Or.inl (Prod.Lex.lt_iff.mpr (Or.inl (by omega))))

/-- C1.8a helper: an entry atom against an entry atom at the same position. -/
theorem cmpTri_atom {α : Type} [LinearOrder α] (n m : Nat) (p q : α) (X Y : List (GAtom α)) :
    CmpTri (compare p q) ([toLex (n, toLex (m, (p : WithBot α)))] ++ X)
      ([toLex (n, toLex (m, (q : WithBot α)))] ++ Y) (p = q) := by
  refine ⟨fun h => ?_, fun h => ?_, compare_eq_iff_eq.mp⟩
  · have h := compare_lt_iff_lt.mp h
    refine List.cons_lt_cons_iff.mpr (Or.inl ?_)
    simp only [Prod.Lex.toLex_lt_toLex, lt_irrefl, false_or, true_and]
    exact WithBot.coe_lt_coe.mpr h
  · have h := compare_gt_iff_gt.mp h
    refine List.cons_lt_cons_iff.mpr (Or.inl ?_)
    simp only [Prod.Lex.toLex_lt_toLex, lt_irrefl, false_or, true_and]
    exact WithBot.coe_lt_coe.mpr h

/-- C1.8a helper: the head of a column's word has depth coordinate `2e`. -/
theorem gwordCol_head {α : Type} (e : Nat) (c : List (α × Tree α)) :
    ∃ A rest, gwordCol e c = A :: rest ∧ (ofLex A).1 = 2 * e := by
  cases c with
  | nil => exact ⟨_, _, rfl, rfl⟩
  | cons x es => obtain ⟨p, h⟩ := x; exact ⟨_, _, rfl, rfl⟩

theorem headLt_gwordCols_append {α : Type} (e : Nat) (cs : List (List (α × Tree α)))
    {xs : List (GAtom α)} (hxs : ∀ A ∈ xs.head?, (ofLex A).1 < 2 * e) :
    ∀ A ∈ (gwordCols e cs ++ xs).head?, (ofLex A).1 < 2 * e + 1 := by
  cases cs with
  | nil => intro A hA; have := hxs A hA; omega
  | cons c cs =>
    obtain ⟨B, rest, hc, hB⟩ := gwordCol_head e c
    intro A hA
    simp only [gwordCols, hc, List.cons_append, List.head?_cons, Option.mem_def,
      Option.some.injEq] at hA
    subst hA; omega

theorem headLt_gwordLater_append {α : Type} (e : Nat) (es : List (α × Tree α))
    {xs : List (GAtom α)} (hxs : ∀ A ∈ xs.head?, (ofLex A).1 < 2 * e + 1) :
    ∀ A ∈ (gwordLater e es ++ xs).head?, (ofLex A).1 < 2 * (e + 1) := by
  cases es with
  | nil => intro A hA; have := hxs A hA; omega
  | cons x es =>
    obtain ⟨p, h⟩ := x
    intro A hA
    simp only [gwordLater, List.cons_append, List.head?_cons, Option.mem_def,
      Option.some.injEq] at hA
    subst hA; simp; omega

mutual
/-- C1.8a helper: the three-way form of `gwordAt_append_lt_iff`/`gwordAt_append_inj`, by mutual
structural induction on the left tree (statements Cols(e), Col(e), Later(e) of the plan). -/
theorem gwordAt_tri {α : Type} [LinearOrder α] : (e : Nat) → (s : Tree α) →
    ∀ (t : Tree α) (xs ys : List (GAtom α)), (∀ A ∈ xs.head?, (ofLex A).1 < 2 * e) →
      (∀ A ∈ ys.head?, (ofLex A).1 < 2 * e) →
      CmpTri (Tree.cmp compare s t) (gwordAt e s ++ xs) (gwordAt e t ++ ys) (s = t)
  | e, .node a, .node b, xs, ys, hxs, hys => by
    simp only [Tree.cmp, gwordAt]
    exact (gwordCols_tri e a b xs ys hxs hys).mono fun h => h ▸ rfl
theorem gwordCols_tri {α : Type} [LinearOrder α] : (e : Nat) → (as : List (List (α × Tree α))) →
    ∀ (bs : List (List (α × Tree α))) (xs ys : List (GAtom α)),
      (∀ A ∈ xs.head?, (ofLex A).1 < 2 * e) → (∀ A ∈ ys.head?, (ofLex A).1 < 2 * e) →
      CmpTri (Tree.cmpCols compare as bs) (gwordCols e as ++ xs) (gwordCols e bs ++ ys) (as = bs)
  | _, [], [], _, _, _, _ => ⟨fun h => by simp [Tree.cmpCols] at h,
      fun h => by simp [Tree.cmpCols] at h, fun _ => rfl⟩
  | e, [], b :: bs, xs, ys, hxs, _ => by
    obtain ⟨B, rest, hb, hB⟩ := gwordCol_head e b
    refine ⟨fun _ => ?_, fun h => by simp [Tree.cmpCols] at h, fun h => by simp [Tree.cmpCols] at h⟩
    simp only [gwordCols, hb, List.cons_append, List.nil_append]
    exact headLt_lt hxs (by omega) _
  | e, a :: as, [], xs, ys, _, hys => by
    obtain ⟨B, rest, ha, hB⟩ := gwordCol_head e a
    refine ⟨fun h => by simp [Tree.cmpCols] at h, fun _ => ?_, fun h => by simp [Tree.cmpCols] at h⟩
    simp only [gwordCols, ha, List.cons_append, List.nil_append]
    exact headLt_lt hys (by omega) _
  | e, a :: as, b :: bs, xs, ys, hxs, hys => by
    have h₁ := gwordCol_tri e a b (gwordCols e as ++ xs) (gwordCols e bs ++ ys)
      (headLt_gwordCols_append e as hxs) (headLt_gwordCols_append e bs hys)
    have h₂ := gwordCols_tri e as bs xs ys hxs hys
    simp only [Tree.cmpCols, gwordCols, List.append_assoc]
    exact (h₁.then (fun h => h ▸ rfl) h₂).mono fun ⟨h₁, h₂⟩ => h₁ ▸ h₂ ▸ rfl
theorem gwordCol_tri {α : Type} [LinearOrder α] : (e : Nat) → (a : List (α × Tree α)) →
    ∀ (b : List (α × Tree α)) (xs ys : List (GAtom α)),
      (∀ A ∈ xs.head?, (ofLex A).1 < 2 * e + 1) → (∀ A ∈ ys.head?, (ofLex A).1 < 2 * e + 1) →
      CmpTri (Tree.cmpCol compare a b) (gwordCol e a ++ xs) (gwordCol e b ++ ys) (a = b)
  | _, [], [], _, _, _, _ => ⟨fun h => by simp [Tree.cmpCol] at h,
      fun h => by simp [Tree.cmpCol] at h, fun _ => rfl⟩
  | e, [], (q, k) :: fs, xs, ys, _, _ => by
    refine ⟨fun _ => ?_, fun h => by simp [Tree.cmpCol] at h, fun h => by simp [Tree.cmpCol] at h⟩
    simp only [gwordCol, List.cons_append, List.nil_append]
    exact List.cons_lt_cons_iff.mpr (Or.inl (by simp [Prod.Lex.toLex_lt_toLex]))
  | e, (p, h) :: es, [], xs, ys, _, _ => by
    refine ⟨fun h => by simp [Tree.cmpCol] at h, fun _ => ?_, fun h => by simp [Tree.cmpCol] at h⟩
    simp only [gwordCol, List.cons_append, List.nil_append]
    exact List.cons_lt_cons_iff.mpr (Or.inl (by simp [Prod.Lex.toLex_lt_toLex]))
  | e, (p, h) :: es, (q, k) :: fs, xs, ys, hxs, hys => by
    have h₀ := cmpTri_atom (2 * e) 1 p q (gwordAt (e + 1) h ++ (gwordLater e es ++ xs))
      (gwordAt (e + 1) k ++ (gwordLater e fs ++ ys))
    have h₁ := gwordAt_tri (e + 1) h k (gwordLater e es ++ xs) (gwordLater e fs ++ ys)
      (headLt_gwordLater_append e es hxs) (headLt_gwordLater_append e fs hys)
    have h₂ := gwordLater_tri e es fs xs ys hxs hys
    simp only [Tree.cmpCol, gwordCol, List.cons_append, List.append_assoc, Ordering.then_assoc]
    exact (h₀.then (fun h => h ▸ rfl) (h₁.then (fun h => h ▸ rfl) h₂)).mono
      fun ⟨h₀, h₁, h₂⟩ => h₀ ▸ h₁ ▸ h₂ ▸ rfl
theorem gwordLater_tri {α : Type} [LinearOrder α] : (e : Nat) → (a : List (α × Tree α)) →
    ∀ (b : List (α × Tree α)) (xs ys : List (GAtom α)),
      (∀ A ∈ xs.head?, (ofLex A).1 < 2 * e + 1) → (∀ A ∈ ys.head?, (ofLex A).1 < 2 * e + 1) →
      CmpTri (Tree.cmpCol compare a b) (gwordLater e a ++ xs) (gwordLater e b ++ ys) (a = b)
  | _, [], [], _, _, _, _ => ⟨fun h => by simp [Tree.cmpCol] at h,
      fun h => by simp [Tree.cmpCol] at h, fun _ => rfl⟩
  | e, [], (q, k) :: fs, xs, ys, hxs, _ => by
    refine ⟨fun _ => ?_, fun h => by simp [Tree.cmpCol] at h, fun h => by simp [Tree.cmpCol] at h⟩
    simp only [gwordLater, List.cons_append, List.nil_append]
    exact headLt_lt hxs (by simp) _
  | e, (p, h) :: es, [], xs, ys, _, hys => by
    refine ⟨fun h => by simp [Tree.cmpCol] at h, fun _ => ?_, fun h => by simp [Tree.cmpCol] at h⟩
    simp only [gwordLater, List.cons_append, List.nil_append]
    exact headLt_lt hys (by simp) _
  | e, (p, h) :: es, (q, k) :: fs, xs, ys, hxs, hys => by
    have h₀ := cmpTri_atom (2 * e + 1) 0 p q (gwordAt (e + 1) h ++ (gwordLater e es ++ xs))
      (gwordAt (e + 1) k ++ (gwordLater e fs ++ ys))
    have h₁ := gwordAt_tri (e + 1) h k (gwordLater e es ++ xs) (gwordLater e fs ++ ys)
      (headLt_gwordLater_append e es hxs) (headLt_gwordLater_append e fs hys)
    have h₂ := gwordLater_tri e es fs xs ys hxs hys
    simp only [Tree.cmpCol, gwordLater, List.cons_append, List.append_assoc, Ordering.then_assoc]
    exact (h₀.then (fun h => h ▸ rfl) (h₁.then (fun h => h ▸ rfl) h₂)).mono
      fun ⟨h₀, h₁, h₂⟩ => h₀ ▸ h₁ ▸ h₂ ▸ rfl
end

/-- C1.8a (txt:147-151): with continuations whose first atoms have depth coordinate below `2e`,
comparison of words followed by continuations is comparison of the trees, then of the
continuations. -/
theorem gwordAt_append_lt_iff {α : Type} [LinearOrder α] (e : Nat) (s t : Tree α)
    {xs ys : List (GAtom α)} (hxs : ∀ A ∈ xs.head?, (ofLex A).1 < 2 * e)
    (hys : ∀ A ∈ ys.head?, (ofLex A).1 < 2 * e) :
    gwordAt e s ++ xs < gwordAt e t ++ ys ↔
      Tree.cmp compare s t = .lt ∨ (s = t ∧ xs < ys) := by
  obtain ⟨hlt, hgt, heq⟩ := gwordAt_tri e s t xs ys hxs hys
  constructor
  · intro h
    cases hc : Tree.cmp compare s t with
    | lt => exact Or.inl rfl
    | gt => exact absurd (hgt hc) (lt_asymm h)
    | eq =>
      obtain rfl := heq hc
      exact Or.inr ⟨rfl, (list_append_lt_append_left _).mp h⟩
  · rintro (h | ⟨rfl, h⟩)
    · exact hlt h
    · exact (list_append_lt_append_left _).mpr h

/-- C1.8a: injectivity with continuations. -/
theorem gwordAt_append_inj {α : Type} (e : Nat) {s t : Tree α} {xs ys : List (GAtom α)}
    (hxs : ∀ A ∈ xs.head?, (ofLex A).1 < 2 * e) (hys : ∀ A ∈ ys.head?, (ofLex A).1 < 2 * e)
    (h : gwordAt e s ++ xs = gwordAt e t ++ ys) : s = t ∧ xs = ys := by
  -- any linear order on the labels will do
  letI : LinearOrder α := IsWellOrder.linearOrder WellOrderingRel
  obtain ⟨hlt, hgt, heq⟩ := gwordAt_tri e s t xs ys hxs hys
  cases hc : Tree.cmp compare s t with
  | lt => exact absurd (h ▸ hlt hc) (lt_irrefl _)
  | gt => exact absurd (h ▸ hgt hc) (lt_irrefl _)
  | eq =>
    obtain rfl := heq hc
    exact ⟨rfl, List.append_cancel_left h⟩

/-- C1.8a: the generic word is an order embedding. -/
theorem gword_lt_iff {α : Type} [LinearOrder α] (s t : Tree α) :
    gword s < gword t ↔ Tree.cmp compare s t = .lt := by
  have := gwordAt_append_lt_iff (xs := []) (ys := []) 0 s t (by simp) (by simp)
  simp only [List.append_nil] at this
  unfold gword
  rw [this]
  simp

theorem gword_injective {α : Type} : Function.Injective (gword : Tree α → List (GAtom α)) := by
  intro s t h
  have h' : gwordAt 0 s ++ [] = gwordAt 0 t ++ [] := by
    simp only [List.append_nil]; exact h
  exact (gwordAt_append_inj 0 (by simp) (by simp) h').1

/-- N1.3: a map strictly increasing on the letters that occur preserves list order. -/
theorem list_map_lt_iff {γ δ : Type} [LinearOrder γ] [LinearOrder δ] {f : γ → δ} {S : Set γ}
    (hf : StrictMonoOn f S) {l₁ l₂ : List γ} (h₁ : ∀ x ∈ l₁, x ∈ S) (h₂ : ∀ x ∈ l₂, x ∈ S) :
    l₁.map f < l₂.map f ↔ l₁ < l₂ := by
  induction l₁ generalizing l₂ with
  | nil =>
    cases l₂ with
    | nil => simp
    | cons y ys => simp [List.nil_lt_cons]
  | cons x xs ih =>
    cases l₂ with
    | nil => simp [List.not_lt_nil]
    | cons y ys =>
      have hx : x ∈ S := h₁ x (List.mem_cons_self ..)
      have hy : y ∈ S := h₂ y (List.mem_cons_self ..)
      simp only [List.map_cons, List.cons_lt_cons_iff]
      rw [hf.lt_iff_lt hx hy, hf.injOn.eq_iff hx hy,
        ih (fun z hz => h₁ z (List.mem_cons_of_mem _ hz)) (fun z hz => h₂ z (List.mem_cons_of_mem _ hz))]

/-- N1.3 helper: a comparison with `Y` only reads the first `|Y| + 1` letters. -/
theorem list_lt_iff_take_lt {γ : Type} [LinearOrder γ] :
    ∀ (X Y : List γ), X < Y ↔ X.take (Y.length + 1) < Y
  | _, [] => by simp [List.not_lt_nil]
  | [], _ :: _ => by simp
  | x :: xs, y :: ys => by
    rw [List.length_cons, List.take_succ_cons, List.cons_lt_cons_iff, List.cons_lt_cons_iff,
      list_lt_iff_take_lt xs ys]

/-- N1.3: a comparison with `Y` is decided within the first `|Y| + 1` letters. -/
theorem list_lt_of_take_eq {γ : Type} [LinearOrder γ] {X₁ X₂ Y : List γ}
    (hlen : Y.length < X₁.length) (h : X₁.take (Y.length + 1) = X₂.take (Y.length + 1)) :
    (X₁ < Y ↔ X₂ < Y) ∧ X₁ ≠ Y ∧ X₂ ≠ Y := by
  refine ⟨by rw [list_lt_iff_take_lt X₁, list_lt_iff_take_lt X₂, h], ?_, ?_⟩
  · rintro rfl; exact absurd hlen (lt_irrefl _)
  · rintro rfl
    have h1 := congrArg List.length h
    rw [List.length_take, List.length_take] at h1
    omega

/-- N1.2: the shapes of atoms that occur in words: `(2e, 0, 0)`, `(2e, 1, p)`, `(2e+1, 0, p)`. -/
def WordAtom.WF (A : WordAtom) : Prop :=
  ((ofLex A).1 % 2 = 0 ∧ (((ofLex (ofLex A).2).1 = 0 ∧ (ofLex (ofLex A).2).2 = 0) ∨
      (ofLex (ofLex A).2).1 = 1)) ∨
    ((ofLex A).1 % 2 = 1 ∧ (ofLex (ofLex A).2).1 = 0)

mutual
/-- N1.2 helper: `word_wf` at an arbitrary depth. -/
theorem wordAt_wf : (e : Nat) → (E : Forest) → ∀ A ∈ wordAt e E, A.WF
  | e, .node cols => by
    simp only [wordAt]; exact wordCols_wf e cols
theorem wordCols_wf : (e : Nat) → (cs : List Column) → ∀ A ∈ wordCols e cs, A.WF
  | _, [] => by simp [wordCols]
  | e, c :: cs => by
    simp only [wordCols, List.mem_append]
    rintro A (hA | hA)
    · exact wordCol_wf e c A hA
    · exact wordCols_wf e cs A hA
theorem wordCol_wf : (e : Nat) → (c : Column) → ∀ A ∈ wordCol e c, A.WF
  | e, [] => by simp [wordCol, WordAtom.WF]
  | e, (p, h) :: es => by
    simp only [wordCol, List.mem_cons, List.mem_append]
    rintro A (rfl | hA | hA)
    · simp [WordAtom.WF]
    · exact wordAt_wf (e + 1) h A hA
    · exact wordLater_wf e es A hA
theorem wordLater_wf : (e : Nat) → (c : Column) → ∀ A ∈ wordLater e c, A.WF
  | _, [] => by simp [wordLater]
  | e, (p, h) :: es => by
    simp only [wordLater, List.mem_cons, List.mem_append]
    rintro A (rfl | hA | hA)
    · simp [WordAtom.WF, Nat.add_mod]
    · exact wordAt_wf (e + 1) h A hA
    · exact wordLater_wf e es A hA
end

/-- N1.2: every atom of a word is well formed. -/
theorem word_wf (E : Forest) : ∀ A ∈ word E, A.WF := wordAt_wf 0 E

/-- N1.2: `toGAtom` is strictly increasing on well-formed atoms. -/
theorem toGAtom_strictMonoOn : StrictMonoOn toGAtom {A : WordAtom | A.WF} := by
  rintro ⟨a, b, c⟩ hA ⟨a', b', c'⟩ hB hlt
  change toLex (a, toLex (b, c)) < toLex (a', toLex (b', c')) at hlt
  change toLex (a, toLex (b, _)) < toLex (a', toLex (b', _))
  simp only [Prod.Lex.toLex_lt_toLex] at hlt ⊢
  rcases hlt with h | ⟨rfl, h | ⟨rfl, h⟩⟩
  · exact Or.inl h
  · exact Or.inr ⟨rfl, Or.inl h⟩
  · refine Or.inr ⟨rfl, Or.inr ⟨rfl, ?_⟩⟩
    by_cases hz : a % 2 = 0 ∧ b = 0
    · exfalso
      have : c = 0 ∧ c' = 0 := by
        change (a % 2 = 0 ∧ (b = 0 ∧ c = 0 ∨ b = 1)) ∨ (a % 2 = 1 ∧ b = 0) at hA
        change (a % 2 = 0 ∧ (b = 0 ∧ c' = 0 ∨ b = 1)) ∨ (a % 2 = 1 ∧ b = 0) at hB
        omega
      omega
    · change (if a % 2 = 0 ∧ b = 0 then (⊥ : WithBot Nat) else (c : WithBot Nat)) <
        (if a % 2 = 0 ∧ b = 0 then (⊥ : WithBot Nat) else (c' : WithBot Nat))
      rw [if_neg hz, if_neg hz]
      exact WithBot.coe_lt_coe.mpr h

-- provides: U1, C1.8 (moved from `Spine.lean`: the proof uses N1.2, N1.3 and C1.8a)
theorem word_lt_iff (E F : Forest) : word E < word F ↔ E < F := by
  rw [← list_map_lt_iff toGAtom_strictMonoOn (word_wf E) (word_wf F), ← gword_eq_map_word,
    ← gword_eq_map_word]
  exact gword_lt_iff E F
-- provides: U1, C1.8 (moved from `Spine.lean`)
theorem word_injective : Function.Injective word := by
  intro E F h
  apply gword_injective
  rw [gword_eq_map_word, gword_eq_map_word, h]

-- bridge: holds by `rfl` (SCR-2 applied)
theorem safePrefix_eq_body (E : Forest) (k : Nat) : safePrefix E k = safePrefixBody E k := rfl

mutual
/-- D1.9a helper: `spF_spec` with its column, entry and later-entry forms. -/
theorem spF_spec' : (e k : Nat) → (E : Forest) →
    wordAt e (spF k E).1 = (wordAt e E).take k ∧ (spF k E).2 = k - (wordAt e E).length
  | e, k, .node cols => by simp only [spF, wordAt]; exact spCols_spec e k cols
theorem spCols_spec : (e k : Nat) → (cs : List Column) →
    wordCols e (spCols k cs).1 = (wordCols e cs).take k ∧ (spCols k cs).2 = k - (wordCols e cs).length
  | _, k, [] => by simp [spCols, wordCols]
  | e, k, col :: rest => by
    by_cases hk : k = 0
    · subst hk; simp [spCols, wordCols]
    · obtain ⟨h1, h2⟩ := spCol_spec e k col (by omega)
      obtain ⟨h3, h4⟩ := spCols_spec e (spCol k col).2 rest
      simp only [spCols, if_neg hk, wordCols, List.take_append, List.length_append]
      rw [h1, h3, h4, h2]
      exact ⟨rfl, by omega⟩
theorem spCol_spec : (e k : Nat) → (col : Column) → 1 ≤ k →
    wordCol e (spCol k col).1 = (wordCol e col).take k ∧ (spCol k col).2 = k - (wordCol e col).length
  | e, k, [], hk => by
    obtain ⟨k, rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
    simp [spCol, wordCol]
  | e, k, (p, h) :: rest, hk => by
    obtain ⟨k, rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
    obtain ⟨h1, h2⟩ := spF_spec' (e + 1) k h
    obtain ⟨h3, h4⟩ := spLater_spec e (spF k h).2 rest
    simp only [spCol, wordCol, Nat.add_sub_cancel, List.take_succ_cons, List.take_append,
      List.length_cons, List.length_append]
    rw [h1, h3, h4, h2]
    exact ⟨rfl, by omega⟩
theorem spLater_spec : (e k : Nat) → (col : Column) →
    wordLater e (spLater k col).1 = (wordLater e col).take k ∧
      (spLater k col).2 = k - (wordLater e col).length
  | _, k, [] => by simp [spLater, wordLater]
  | e, k, (p, h) :: rest => by
    by_cases hk : k = 0
    · subst hk; simp [spLater, wordLater]
    · obtain ⟨k, rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
      obtain ⟨h1, h2⟩ := spF_spec' (e + 1) k h
      obtain ⟨h3, h4⟩ := spLater_spec e (spF k h).2 rest
      simp only [spLater, if_neg hk, wordLater, Nat.add_sub_cancel, List.take_succ_cons,
        List.take_append, List.length_cons, List.length_append]
      rw [h1, h3, h4, h2]
      exact ⟨rfl, by omega⟩
end

/-- D1.9a: the budget bookkeeping of `spF` (the invariant behind `word_safePrefix`):
`word (spF k E).1 = (word E).take k` and the unused budget is `k - µ(E)`. -/
theorem spF_spec (e k : Nat) (E : Forest) :
    wordAt e (spF k E).1 = (wordAt e E).take k ∧ (spF k E).2 = k - (wordAt e E).length :=
  spF_spec' e k E

-- provides: U1, D1.9 (moved from `Spine.lean`: the proof uses `spF_spec`)
theorem word_safePrefix (E : Forest) (k : Nat) : word (safePrefix E k) = (word E).take k :=
  (spF_spec 0 k E).1

/-- D1.9: a safe prefix of full length is the whole forest. -/
theorem safePrefix_of_le {E : Forest} {k : Nat} (hk : mu E ≤ k) : safePrefix E k = E := by
  apply word_injective
  rw [word_safePrefix]
  exact List.take_of_length_le hk

/-- D1.9 helper: a list is never smaller than one of its prefixes. -/
theorem list_not_lt_prefix {β : Type} [LinearOrder β] {p l : List β} (h : p <+: l) : ¬ l < p := by
  obtain ⟨r, rfl⟩ := h
  induction p with
  | nil => exact List.not_lt_nil _
  | cons a p ih => rw [List.cons_append, List.cons_lt_cons_iff]; simpa using ih

/-- D1.9: a safe prefix is `≤` the forest (by `word_safePrefix` and `word_lt_iff`). -/
theorem safePrefix_le (E : Forest) (k : Nat) : safePrefix E k ≤ E := by
  rw [Forest.le_iff_cmp]
  intro hgt
  have h := (gwordAt_tri 0 (safePrefix E k) E [] [] (by simp) (by simp)).2.1 hgt
  simp only [List.append_nil] at h
  change gword E < gword (safePrefix E k) at h
  rw [gword_eq_map_word, gword_eq_map_word, word_safePrefix] at h
  exact list_not_lt_prefix ((List.take_prefix k (word E)).map toGAtom) h

/-- D1.9 helper: kept later entries keep their parent; their heights are budgeted walks. -/
theorem spLater_getElem? : ∀ (k : Nat) (es : Column) (n : Nat) (x' : Nat × Forest),
    (spLater k es).1[n]? = some x' → ∃ x k', es[n]? = some x ∧ x' = (x.1, (spF k' x.2).1)
  | _, [], n, x', h => by simp [spLater] at h
  | k, (p, H) :: rest, n, x', h => by
    by_cases hk : k = 0
    · subst hk; simp [spLater] at h
    · simp only [spLater, if_neg hk] at h
      cases n with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq] at h
        exact ⟨(p, H), k - 1, rfl, h.symm⟩
      | succ n =>
        simp only [List.getElem?_cons_succ] at h
        obtain ⟨x, k', h1, h2⟩ := spLater_getElem? _ rest n x' h
        exact ⟨x, k', by simpa using h1, h2⟩

theorem spLater_length : ∀ (k : Nat) (es : Column), (spLater k es).1.length ≤ es.length
  | _, [] => by simp [spLater]
  | k, (p, H) :: rest => by
    by_cases hk : k = 0
    · subst hk; simp [spLater]
    · simp only [spLater, if_neg hk, List.length_cons]
      have := spLater_length (spF (k - 1) H).2 rest
      omega

/-- D1.9 helper: kept entries of a column keep their parent; their heights are budgeted walks. -/
theorem spCol_getElem? (k : Nat) (col : Column) (n : Nat) (x' : Nat × Forest)
    (h : (spCol k col).1[n]? = some x') : ∃ x k', col[n]? = some x ∧ x' = (x.1, (spF k' x.2).1) := by
  cases col with
  | nil => simp [spCol] at h
  | cons x rest =>
    obtain ⟨p, H⟩ := x
    simp only [spCol] at h
    cases n with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.some.injEq] at h
      exact ⟨(p, H), k - 1, rfl, h.symm⟩
    | succ n =>
      simp only [List.getElem?_cons_succ] at h
      obtain ⟨x, k', h1, h2⟩ := spLater_getElem? _ rest n x' h
      exact ⟨x, k', by simpa using h1, h2⟩

theorem spCol_length (k : Nat) (col : Column) : (spCol k col).1.length ≤ col.length := by
  cases col with
  | nil => simp [spCol]
  | cons x rest =>
    obtain ⟨p, H⟩ := x
    simp only [spCol, List.length_cons]
    have := spLater_length (spF (k - 1) H).2 rest
    omega

theorem spCol_eq_nil (k : Nat) (col : Column) (h : (spCol k col).1 = []) : col = [] := by
  cases col with
  | nil => rfl
  | cons x rest => obtain ⟨p, H⟩ := x; simp [spCol] at h

/-- D1.9 helper: kept columns are budgeted walks of the columns with a positive budget. -/
theorem spCols_getElem? : ∀ (k : Nat) (cs : List Column) (n : Nat) (col' : Column),
    (spCols k cs).1[n]? = some col' → ∃ col k', 1 ≤ k' ∧ cs[n]? = some col ∧ col' = (spCol k' col).1
  | _, [], n, col', h => by simp [spCols] at h
  | k, col :: rest, n, col', h => by
    by_cases hk : k = 0
    · subst hk; simp [spCols] at h
    · simp only [spCols, if_neg hk] at h
      cases n with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq] at h
        exact ⟨col, k, by omega, rfl, h.symm⟩
      | succ n =>
        simp only [List.getElem?_cons_succ] at h
        obtain ⟨c, k', h0, h1, h2⟩ := spCols_getElem? _ rest n col' h
        exact ⟨c, k', h0, by simpa using h1, h2⟩

/-- D1.9 helper: every forest of a safe prefix is a budgeted walk of the forest at the same
address. -/
theorem forestAt_spF : ∀ (ρ : List (Nat × Nat)) (k : Nat) (E F' : Forest),
    (spF k E).1.forestAt ρ = some F' → ∃ F k', E.forestAt ρ = some F ∧ F' = (spF k' F).1
  | [], k, E, F', h => ⟨E, k, rfl, (Option.some.inj h).symm⟩
  | (c, i) :: ρ, k, .node cols, F', h => by
    rw [Tree.forestAt_cons] at h
    rw [Tree.forestAt_cons]
    simp only [spF, Tree.cols] at h ⊢
    cases hc : (spCols k cols).1[c]? with
    | none => rw [hc] at h; simp at h
    | some col' =>
      obtain ⟨col, k₁, -, hcol, rfl⟩ := spCols_getElem? k cols c col' hc
      rw [hc, Option.bind_some] at h
      cases hi : (spCol k₁ col).1[i]? with
      | none => rw [hi] at h; simp at h
      | some x' =>
        obtain ⟨x, k₂, hx, rfl⟩ := spCol_getElem? k₁ col i x' hi
        rw [hi, Option.bind_some] at h
        obtain ⟨F, k', hF, rfl⟩ := forestAt_spF ρ k₂ x.2 F' h
        exact ⟨F, k', by simp [hcol, hx, hF], rfl⟩

/-- D1.9 (txt:152-153): every column of a safe prefix is a prefix of the corresponding column,
nonempty if the original column is nonempty; every kept entry keeps its parent and its height is
a safe prefix of the original height. -/
theorem colAt_safePrefix {E : Forest} {k : Nat} {c : ColAddr} {col' : Column}
    (h : (safePrefix E k).colAt c = some col') :
    ∃ col, E.colAt c = some col ∧ col'.length ≤ col.length ∧ (col' = [] → col = []) ∧
      ∀ (i p' : Nat) (H' : Forest), col'[i]? = some (p', H') →
        ∃ (H : Forest) (j : Nat), col[i]? = some (p', H) ∧ H' = safePrefix H j := by
  unfold Tree.colAt at h
  cases hf : (safePrefix E k).forestAt c.path with
  | none => rw [hf] at h; simp at h
  | some F' =>
    rw [hf, Option.bind_some] at h
    obtain ⟨⟨cols⟩, k', hF, rfl⟩ := forestAt_spF c.path k E F' hf
    simp only [spF, Tree.cols] at h
    obtain ⟨col, k₁, -, hcol, rfl⟩ := spCols_getElem? k' cols c.col col' h
    refine ⟨col, by simp only [Tree.colAt, hF, Option.bind_some]; exact hcol,
      spCol_length k₁ col, spCol_eq_nil k₁ col,
      fun i p' H' hi => ?_⟩
    obtain ⟨x, k₂, hx, hx'⟩ := spCol_getElem? k₁ col i _ hi
    obtain ⟨q, H⟩ := x
    simp only [Prod.mk.injEq] at hx'
    obtain ⟨rfl, rfl⟩ := hx'
    exact ⟨H, k₂, hx, rfl⟩

/-- D1.9a helper: the word of a list of columns splits over an append (the D1.5a helper
`wordCols_append` comes later in the file). -/
theorem wordCols_append' (d : Nat) (l₁ l₂ : List Column) :
    wordCols d (l₁ ++ l₂) = wordCols d l₁ ++ wordCols d l₂ := by
  induction l₁ with
  | nil => rfl
  | cons c l ih => simp only [List.cons_append, wordCols, ih, List.append_assoc]

/-- D1.9a helper: the word of later entries splits over an append. -/
theorem wordLater_append (d : Nat) (l₁ l₂ : Column) :
    wordLater d (l₁ ++ l₂) = wordLater d l₁ ++ wordLater d l₂ := by
  induction l₁ with
  | nil => rfl
  | cons x l ih => obtain ⟨p, h⟩ := x; simp only [List.cons_append, wordLater, ih, List.append_assoc]

/-- D1.9a helper: the word of a column with a nonempty first part. -/
theorem wordCol_append_of_ne_nil (d : Nat) {l₁ : Column} (h : l₁ ≠ []) (l₂ : Column) :
    wordCol d (l₁ ++ l₂) = wordCol d l₁ ++ wordLater d l₂ := by
  cases l₁ with
  | nil => exact absurd rfl h
  | cons x l => obtain ⟨p, H⟩ := x; simp only [List.cons_append, wordCol, wordLater_append, List.append_assoc]

/-- D1.9a helper: cutting a column after entry `|es₁|`, whose height is replaced by one with a
prefix word, gives a prefix of the column's word. -/
theorem wordCol_cut_prefix (d : Nat) (es₁ : Column) (q : Nat) {H H' : Forest} (es₂ : Column)
    (hH : wordAt (d + 1) H' <+: wordAt (d + 1) H) :
    wordCol d (es₁ ++ [(q, H')]) <+: wordCol d (es₁ ++ (q, H) :: es₂) := by
  cases es₁ with
  | nil =>
    simp only [List.nil_append, wordCol, wordLater, List.append_nil, List.cons_prefix_cons, true_and]
    exact hH.trans (List.prefix_append _ _)
  | cons x l =>
    rw [wordCol_append_of_ne_nil d (List.cons_ne_nil x l),
      wordCol_append_of_ne_nil d (List.cons_ne_nil x l), List.prefix_append_right_inj]
    simp only [wordLater, List.append_nil, List.cons_prefix_cons, true_and]
    exact hH.trans (List.prefix_append _ _)

/-- D1.9a helper: `truncAux` at a present entry gives a prefix of the word, at every depth. -/
theorem wordAt_truncAux_prefix : ∀ (ρ : List (Nat × Nat)) (s : Forest) (j i d : Nat)
    (x : Nat × Forest), s.entryAt ⟨⟨ρ, j⟩, i⟩ = some x → wordAt d (Tree.truncAux ρ j i s) <+: wordAt d s
  | [], .node cols, j, i, d, x, he => by
    rw [Tree.entryAt_eq_bind] at he
    simp only [Tree.forestAt, Option.bind_some, Tree.cols] at he
    cases hc : cols[j]? with
    | none => rw [hc] at he; simp at he
    | some col =>
      rw [hc, Option.bind_some] at he
      obtain ⟨cols₁, cols₂, rfl, rfl⟩ := Tree.exists_split_of_getElem? hc
      obtain ⟨es₁, es₂, rfl, rfl⟩ := Tree.exists_split_of_getElem? he
      obtain ⟨q, H⟩ := x
      simp [Tree.truncAux, wordAt, wordCols_append', wordCols, List.getD_eq_getElem?_getD,
        List.take_append, List.take_of_length_le]
      exact (wordCol_cut_prefix d es₁ q es₂ (List.prefix_refl _)).trans (List.prefix_append _ _)
  | (c₀, i₀) :: ρ, .node cols, j, i, d, x, he => by
    rw [Tree.entryAt_eq_bind, Tree.forestAt_cons] at he
    simp only [Tree.cols] at he
    cases hc : cols[c₀]? with
    | none => rw [hc] at he; simp at he
    | some col =>
      rw [hc, Option.bind_some] at he
      cases hi : col[i₀]? with
      | none => rw [hi] at he; simp at he
      | some y =>
        obtain ⟨p₀, h₀⟩ := y
        rw [hi, Option.bind_some] at he
        replace he : h₀.entryAt ⟨⟨ρ, j⟩, i⟩ = some x := by rw [Tree.entryAt_eq_bind]; exact he
        have ih := wordAt_truncAux_prefix ρ h₀ j i (d + 1) x he
        obtain ⟨cols₁, cols₂, rfl, rfl⟩ := Tree.exists_split_of_getElem? hc
        obtain ⟨es₁, es₂, rfl, rfl⟩ := Tree.exists_split_of_getElem? hi
        simp [Tree.truncAux, wordAt, wordCols_append', wordCols, List.getD_eq_getElem?_getD]
        exact (wordCol_cut_prefix d es₁ p₀ es₂ ih).trans (List.prefix_append _ _)

/-- D1.9a: the word of a truncation after an entry is a prefix of the word. -/
theorem word_truncAfter_prefix (E : Forest) (e : EntryAddr) : word (E.truncAfter e) <+: word E := by
  rw [Tree.truncAfter_eq_body, Tree.truncAfterBody]
  split_ifs with hs
  · obtain ⟨x, hx⟩ := Option.isSome_iff_exists.mp hs
    exact wordAt_truncAux_prefix e.col.path E e.col.col e.idx 0 x hx
  · exact List.prefix_refl _

-- provides: U1, D1.9 (`truncAfter` is a safe prefix; moved from `Spine.lean`: the proof uses
-- `word_truncAfter_prefix`, `word_safePrefix` and `word_injective`)
theorem truncAfter_safePrefix {E : Forest} {e : EntryAddr} (he : e ∈ E.entryAddrs) :
    ∃ k, E.truncAfter e = safePrefix E k := by
  clear he
  refine ⟨(word (E.truncAfter e)).length, word_injective ?_⟩
  rw [word_safePrefix]
  exact List.prefix_iff_eq_take.mp (word_truncAfter_prefix E e)

/-- L2.5c (`sign_of_agreement`†, txt:246-249): if two height words agree for more atoms than the
length of a query height, their normalized comparisons with it have the same strict sign; the
thresholds are arbitrary. -/
theorem sign_of_agreement (r t : Nat) {A₁ A₂ J : Forest} (hlen : mu J < mu A₁)
    (hagree : (word A₁).take (mu J + 1) = (word A₂).take (mu J + 1)) :
    keyCmp (relKey r A₁) (relKey t J) = keyCmp (relKey r A₂) (relKey t J) ∧
      keyCmp (relKey r A₁) (relKey t J) ≠ .eq := by
  -- generic words of keys (labels `Bool × Nat`), in terms of the compact word
  have hg : ∀ (a : Nat) (A : Forest), (gword (relKey a A) : List (GAtom (Bool × Nat))) =
      (word A).map (GAtom.map (relLabel a) ∘ toGAtom) := by
    intro a A
    rw [relKey_eq_map, gword_map, gword_eq_map_word, List.map_map]
  -- the same words read over `Lex (Bool × Nat)`, whose `Tree.cmp compare` is `keyCmp`
  let X₁ : List (GAtom (Lex (Bool × Nat))) := gword (relKey r A₁ : Tree (Lex (Bool × Nat)))
  let X₂ : List (GAtom (Lex (Bool × Nat))) := gword (relKey r A₂ : Tree (Lex (Bool × Nat)))
  let Y : List (GAtom (Lex (Bool × Nat))) := gword (relKey t J : Tree (Lex (Bool × Nat)))
  have hY : Y.length = mu J := by
    change (gword (relKey t J) : List (GAtom (Bool × Nat))).length = mu J
    rw [hg, List.length_map]; rfl
  have hX₁ : X₁.length = mu A₁ := by
    change (gword (relKey r A₁) : List (GAtom (Bool × Nat))).length = mu A₁
    rw [hg, List.length_map]; rfl
  have htake : X₁.take (Y.length + 1) = X₂.take (Y.length + 1) := by
    rw [hY]
    change (gword (relKey r A₁) : List (GAtom (Bool × Nat))).take (mu J + 1) =
      (gword (relKey r A₂) : List (GAtom (Bool × Nat))).take (mu J + 1)
    rw [hg, hg, ← List.map_take, ← List.map_take, hagree]
  obtain ⟨hlt, hne₁, hne₂⟩ := list_lt_of_take_eq (by rw [hY, hX₁]; exact hlen) htake
  have hlt₁ : X₁ < Y ↔ keyCmp (relKey r A₁) (relKey t J) = .lt :=
    gword_lt_iff (α := Lex (Bool × Nat)) _ _
  have hlt₂ : X₂ < Y ↔ keyCmp (relKey r A₂) (relKey t J) = .lt :=
    gword_lt_iff (α := Lex (Bool × Nat)) _ _
  have heq₁ : keyCmp (relKey r A₁) (relKey t J) ≠ .eq := fun h =>
    hne₁ (congrArg (gword (α := Lex (Bool × Nat))) (Tree.eq_of_cmp_eq keyLabelCmp h))
  have heq₂ : keyCmp (relKey r A₂) (relKey t J) ≠ .eq := fun h =>
    hne₂ (congrArg (gword (α := Lex (Bool × Nat))) (Tree.eq_of_cmp_eq keyLabelCmp h))
  refine ⟨?_, heq₁⟩
  have hiff := hlt₁.symm.trans (hlt.trans hlt₂)
  revert heq₁ heq₂ hiff
  cases keyCmp (relKey r A₁) (relKey t J) <;> cases keyCmp (relKey r A₂) (relKey t J) <;> simp

/-- L2.5c helper: the coercion into `WithTop` preserves `compare`. -/
theorem compare_coe_withTop {β : Type} [LinearOrder β] (a b : β) :
    compare (a : WithTop β) (b : WithTop β) = compare a b := by
  rcases lt_trichotomy a b with h | h | h
  · rw [compare_lt_iff_lt.2 h, compare_lt_iff_lt.2 (WithTop.coe_lt_coe.2 h)]
  · subst h; rw [compare_eq_iff_eq.2 rfl, compare_eq_iff_eq.2 rfl]
  · rw [compare_gt_iff_gt.2 h, compare_gt_iff_gt.2 (WithTop.coe_lt_coe.2 h)]

-- U1-verify: changed (new declaration)
/-- L2.5c, key-system form: the sign hypothesis `hsign` of `trace_agree` at `α = WithTop Key`,
for one query key. -/
theorem sign_of_agreement_compare (r t : Nat) {A₁ A₂ J : Forest} (hlen : mu J < mu A₁)
    (hagree : (word A₁).take (mu J + 1) = (word A₂).take (mu J + 1)) :
    compare ((relKey r A₁ : Key) : WithTop Key) ((relKey t J : Key) : WithTop Key) =
      compare ((relKey r A₂ : Key) : WithTop Key) ((relKey t J : Key) : WithTop Key) := by
  rw [compare_coe_withTop, compare_coe_withTop, Key.compare_eq_keyCmp, Key.compare_eq_keyCmp]
  exact (sign_of_agreement r t hlen hagree).1

/-! ## D1.5a — shifts and the continuation hole (S-6) -/

theorem shiftVal_zero (r p : Nat) : shiftVal r 0 p = p := by
  unfold shiftVal; split <;> rfl

/-- D1.5a helper: `shiftVal r 0` is the identity function. -/
theorem shiftVal_zero_fun (r : Nat) : shiftVal r 0 = id := funext (shiftVal_zero r)

mutual
/-- D1.5a helper: `Tree.map id` is the identity. -/
theorem treeMap_id {α : Type} : (t : Tree α) → Tree.map id t = t
  | .node cols => by
    simp only [Tree.map]; rw [treeMapCols_id]
theorem treeMapCols_id {α : Type} :
    (cs : List (List (α × Tree α))) → Tree.mapCols id cs = cs
  | [] => rfl
  | c :: cs => by
    simp only [Tree.mapCols]; rw [treeMapCol_id, treeMapCols_id]
theorem treeMapCol_id {α : Type} :
    (c : List (α × Tree α)) → Tree.mapCol id c = c
  | [] => rfl
  | (p, h) :: es => by
    simp only [Tree.mapCol]; rw [treeMap_id, treeMapCol_id]; rfl
end

/-- D1.5a. -/
theorem shift_zero (r : Nat) (F : Forest) : shift r 0 F = F := by
  unfold shift; rw [shiftVal_zero_fun]; exact treeMap_id F

mutual
/-- D1.5a helper: relabellings compose. -/
theorem treeMap_map {α β γ : Type} (f : β → γ) (g : α → β) :
    (t : Tree α) → Tree.map f (Tree.map g t) = Tree.map (f ∘ g) t
  | .node cols => by
    simp only [Tree.map]; rw [treeMapCols_map]
theorem treeMapCols_map {α β γ : Type} (f : β → γ) (g : α → β) :
    (cs : List (List (α × Tree α))) → Tree.mapCols f (Tree.mapCols g cs) = Tree.mapCols (f ∘ g) cs
  | [] => rfl
  | c :: cs => by
    simp only [Tree.mapCols]; rw [treeMapCol_map, treeMapCols_map]
theorem treeMapCol_map {α β γ : Type} (f : β → γ) (g : α → β) :
    (c : List (α × Tree α)) → Tree.mapCol f (Tree.mapCol g c) = Tree.mapCol (f ∘ g) c
  | [] => rfl
  | (p, h) :: es => by
    simp only [Tree.mapCol]; rw [treeMap_map, treeMapCol_map]; rfl
end

/-- D1.5a helper: `shiftVal` at one threshold composes additively. -/
theorem shiftVal_add (r d d' : Nat) : shiftVal r d ∘ shiftVal r d' = shiftVal r (d + d') := by
  funext p; simp only [Function.comp, shiftVal]; split_ifs <;> omega

/-- D1.5a: shifts at one threshold compose additively. -/
theorem shift_add (r d d' : Nat) (F : Forest) : shift r d (shift r d' F) = shift r (d + d') F := by
  unfold shift; rw [treeMap_map, shiftVal_add]

/-- D1.5a: `mapLast` (locked) in list form. -/
theorem mapLast_eq {γ δ : Type} (f g : γ → δ) (l : List γ) :
    mapLast f g l = l.dropLast.map f ++ (l.getLast?.map g).toList :=
  match l with
  | [] => by simp [mapLast]
  | [x] => by simp [mapLast]
  | x :: y :: ys => by rw [mapLast, mapLast_eq f g (y :: ys)]; simp

/-- D1.5a: the unshifted placement of `Z` into the hole (`A_{0,0,depth,Z}`). -/
def Hole.put (h : Hole) (Z : Forest) : Forest := replaceAt 0 0 Z h.depth h.outer

/-- D1.5a helper: `Tree.mapCols` in list form. -/
theorem treeMapCols_eq_map {α β : Type} (f : α → β) (cs : List (List (α × Tree α))) :
    Tree.mapCols f cs = cs.map (Tree.mapCol f) := by
  induction cs with
  | nil => rfl
  | cons c cs ih => simp only [Tree.mapCols, List.map_cons, ih]

/-- D1.5a helper: `Tree.mapCol` in list form. -/
theorem treeMapCol_eq_map {α β : Type} (f : α → β) (c : List (α × Tree α)) :
    Tree.mapCol f c = c.map (fun x => (f x.1, Tree.map f x.2)) := by
  induction c with
  | nil => rfl
  | cons x c ih => obtain ⟨p, h⟩ := x; simp only [Tree.mapCol, List.map_cons, ih]

/-- D1.5a helper: `mapLast` after a `map`. -/
theorem mapLast_map {γ δ ε : Type} (f g : δ → ε) (h : γ → δ) (l : List γ) :
    mapLast f g (l.map h) = mapLast (f ∘ h) (g ∘ h) l := by
  rw [mapLast_eq, mapLast_eq]; simp [List.map_dropLast, Option.map_map]

/-- D1.5a helper: `Tree.mapCol id` is the identity function. -/
theorem treeMapCol_id_fun {α : Type} : Tree.mapCol (α := α) id = id := funext treeMapCol_id

/-- D1.5a helper: `A_{r,d,k,Z}(F) = A_{0,0,k,Z}(T_{r,d}(F))`, by induction on `k` following the
locked `replaceAt`. -/
theorem replaceAt_eq_shift (r d : Nat) (Z : Forest) :
    ∀ (k : Nat) (F : Forest), replaceAt r d Z k F = replaceAt 0 0 Z k (shift r d F)
  | 0, .node [] => by simp [replaceAt, shift, Tree.map, Tree.mapCols]
  | 0, .node (c :: cs) => by
    simp only [replaceAt, shift, Tree.map, Tree.mapCols]
    rw [shiftVal_zero_fun 0, treeMapCol_id_fun, List.map_id, treeMapCols_eq_map, ← List.map_cons,
      List.map_dropLast]
  | k + 1, .node cols => by
    simp only [replaceAt, shift, Tree.map]
    rw [shiftVal_zero_fun 0, treeMapCol_id_fun, treeMapCols_eq_map, mapLast_map]
    congr 1
    congr 1
    funext c
    rw [Function.comp, treeMapCol_eq_map, mapLast_map]
    congr 1
    · funext x; simp only [Function.comp, id, treeMap_id]
    · funext x
      simp only [Function.comp, id]
      rw [replaceAt_eq_shift r d Z k x.2]
      rfl

/-- D1.5a (fill/shift law): `A_{r,d,ℓ,Z}(F)` is `T_{r,d}(F)` with `Z` placed unshifted. -/
theorem Hole.fill_eq_put (h : Hole) (r d : Nat) (Z : Forest) :
    h.fill r d Z = (⟨shift r d h.outer, h.depth⟩ : Hole).put Z :=
  replaceAt_eq_shift r d Z h.depth h.outer

theorem Hole.fill_zero (h : Hole) (Z : Forest) : h.fill 0 0 Z = h.put Z := by
  rw [Hole.fill_eq_put, shift_zero]

/-- D1.5a helper: the word of a list of columns splits over an append. -/
theorem wordCols_append (e : Nat) (l₁ l₂ : List Column) :
    wordCols e (l₁ ++ l₂) = wordCols e l₁ ++ wordCols e l₂ := by
  induction l₁ with
  | nil => rfl
  | cons c l ih => simp only [List.cons_append, wordCols, ih, List.append_assoc]

/-- D1.5a helper: the height of the last later entry is read last. -/
theorem wordLater_snoc (e : Nat) (l : Column) (q : Nat) (H : Forest) :
    wordLater e (l ++ [(q, H)]) = wordLater e (l ++ [(q, Tree.empty)]) ++ wordAt (e + 1) H := by
  induction l with
  | nil => simp [wordLater, Tree.empty, wordAt, wordCols]
  | cons x l ih =>
    obtain ⟨p, h⟩ := x
    simp only [List.cons_append, wordLater, ih, List.append_assoc]

/-- D1.5a helper: the height of the last entry of a column is read last. -/
theorem wordCol_snoc (e : Nat) (l : Column) (q : Nat) (H : Forest) :
    wordCol e (l ++ [(q, H)]) = wordCol e (l ++ [(q, Tree.empty)]) ++ wordAt (e + 1) H := by
  cases l with
  | nil => simp [wordCol, wordLater, Tree.empty, wordAt, wordCols]
  | cons x l =>
    obtain ⟨p, h⟩ := x
    simp only [List.cons_append, wordCol]
    rw [wordLater_snoc]
    simp only [List.append_assoc]

/-- D1.5a helper: a forest with a nonempty route has columns. -/
theorem routeColsAux_pos {fuel : Nat} {F : Forest} {π : List (Nat × Nat)}
    (h : 0 < (routeColsAux fuel F π).length) : F.cols ≠ [] := by
  cases fuel with
  | zero => simp [routeColsAux] at h
  | succ f =>
    rw [routeColsAux] at h
    intro hF
    rw [hF] at h
    simp at h

/-- D1.5a helper: a route longer than `k + 1` continues into the height of the last entry of a
nonempty last column. -/
theorem routeColsAux_succ_lt {fuel : Nat} {F : Forest} {π : List (Nat × Nat)} {k : Nat}
    (h : k + 1 < (routeColsAux fuel F π).length) :
    ∃ fuel' col p H, fuel = fuel' + 1 ∧ F.cols.getLast? = some col ∧ col.getLast? = some (p, H) ∧
      k < (routeColsAux fuel' H (π ++ [(F.cols.length - 1, col.length - 1)])).length := by
  cases fuel with
  | zero => simp [routeColsAux] at h
  | succ f =>
    rw [routeColsAux] at h
    cases hc : F.cols.getLast? with
    | none => simp [hc] at h
    | some col =>
      simp only [hc] at h
      cases hl : col.getLast? with
      | none => simp [hl] at h
      | some ph =>
        obtain ⟨p, H⟩ := ph
        simp only [hl, List.length_cons] at h
        exact ⟨f, col, p, H, rfl, rfl, hl, by omega⟩

/-- D1.5a helper: `word_put` at an arbitrary depth coordinate `e` and fuel. -/
theorem wordAt_replaceAt (Z : Forest) :
    ∀ (k fuel : Nat) (F : Forest) (π : List (Nat × Nat)) (e : Nat),
      k < (routeColsAux fuel F π).length →
      wordAt e (replaceAt 0 0 Z k F) = wordAt e (replaceAt 0 0 Tree.empty k F) ++ wordAt (e + k) Z
  | 0, fuel, .node cols, π, e, h => by
    have hne := routeColsAux_pos h
    obtain ⟨zc⟩ := Z
    cases cols with
    | nil => exact absurd rfl hne
    | cons c cs =>
      simp only [replaceAt, wordAt, Tree.cols, Tree.empty, List.append_nil, wordCols_append,
        Nat.add_zero]
  | k + 1, fuel, .node cols, π, e, h => by
    obtain ⟨fuel', col, p, H, rfl, hc, hl, hk⟩ := routeColsAux_succ_lt h
    have ih := wordAt_replaceAt Z k fuel' H _ (e + 1) hk
    simp only [Tree.cols] at hc
    simp only [replaceAt, mapLast_eq, hc, hl, Option.map_some, Option.toList_some, wordAt,
      wordCols_append, wordCols, List.append_nil]
    rw [wordCol_snoc, wordCol_snoc e _ _ (replaceAt 0 0 Tree.empty k H), ih]
    simp only [List.append_assoc]
    rw [show e + 1 + k = e + (k + 1) by omega]

/-- D1.5a: the word of a filled hole is the word with the hole emptied, followed by the word of
`Z` at the hole's depth (the hole column is the last thing in reading order). -/
theorem word_put (h : Hole) (Z : Forest) (hd : h.depth < (routeCols h.outer).length) :
    word (h.put Z) = word (h.put Tree.empty) ++ wordAt h.depth Z := by
  have := wordAt_replaceAt Z h.depth _ h.outer [] 0 hd
  rw [Nat.zero_add] at this
  exact this

/-- D1.5a: the generic word of a shift relabels the generic word. -/
theorem gword_shift (r d : Nat) (F : Forest) :
    gword (shift r d F) = (gword F).map (GAtom.map (shiftVal r d)) := gword_map _ _

/-! ## D1.6, D1.6b — the paper's operation written from §1.2 (G-001) -/

-- bridges: hold by `rfl` (SCR-2 applied)
theorem stopData_eq_body (E : Forest) : stopData E = stopDataBody E := rfl
theorem stepKind_eq_body (E : Forest) : stepKind E = stepKindBody E := rfl
theorem rootData_eq_body (E : Forest) : rootData E = rootDataBody E := rfl
theorem paperOp_eq_body (E : Forest) (n : Nat) : paperOp E n = paperOpBody E n := rfl

/-! ### D1.6b — branch data specifications -/

/-! Helpers (D1.6b, D1.6c): the route one level at a time, and the reference's layers. -/

theorem stopCol_eq (π : List (Nat × Nat)) (ci : Nat) :
    ∀ (col : Column) (ei : Nat) (Q : Column), stopCol π ci ei Q col =
      match col.getLast? with
      | none => none
      | some (p, h) =>
        if h.cols.isEmpty then
          some { depth := π.length, col := ⟨π, ci⟩, t := ColAddr.num 0 ⟨π, ci⟩, r := p,
                 Q := Q ++ col.dropLast }
        else stopF (π ++ [(ci, ei + col.length - 1)]) h
  | [], ei, Q => by simp [stopCol]
  | [(p, .node [])], ei, Q => by simp [stopCol, Tree.cols]
  | [(p, .node (g :: gs))], ei, Q => by simp [stopCol, Tree.cols, stopF]
  | x :: y :: rest, ei, Q => by
    rw [stopCol, stopCol_eq π ci (y :: rest) (ei + 1) (Q ++ [x])]
    have h1 : (x :: y :: rest).getLast? = (y :: rest).getLast? := by simp
    rw [h1]
    rcases hl : (y :: rest).getLast? with _ | ⟨p, h⟩
    · rfl
    · simp only
      have : ei + 1 + (y :: rest).length - 1 = ei + (x :: y :: rest).length - 1 := by
        simp; omega
      rw [this]
      simp

theorem stopCols_eq (π : List (Nat × Nat)) :
    ∀ (cols : List Column) (ci : Nat), stopCols π ci cols =
      match cols.getLast? with
      | none => none
      | some col => stopCol π (ci + cols.length - 1) 0 [] col
  | [], ci => by simp [stopCols]
  | [c], ci => by simp [stopCols]
  | c :: d :: rest, ci => by
    rw [stopCols, stopCols_eq π (d :: rest) (ci + 1)]
    have h1 : (c :: d :: rest).getLast? = (d :: rest).getLast? := by simp
    rw [h1]
    have : ci + 1 + (d :: rest).length - 1 = ci + (c :: d :: rest).length - 1 := by simp; omega
    rw [this]

/-- The route, one level at a time. -/
theorem stopF_eq (π : List (Nat × Nat)) (F : Forest) : stopF π F =
    match F.cols.getLast? with
    | none => none
    | some col =>
      match col.getLast? with
      | none => none
      | some (p, h) =>
        if h.cols.isEmpty then
          some { depth := π.length, col := ⟨π, F.cols.length - 1⟩,
                 t := ColAddr.num 0 ⟨π, F.cols.length - 1⟩, r := p, Q := col.dropLast }
        else stopF (π ++ [(F.cols.length - 1, col.length - 1)]) h := by
  obtain ⟨cols⟩ := F
  simp only [stopF, Tree.cols]
  rw [stopCols_eq]
  rcases cols.getLast? with _ | col
  · rfl
  · simp only
    rw [stopCol_eq]
    rcases col.getLast? with _ | ⟨p, h⟩
    · rfl
    · obtain ⟨hc⟩ := h
      simp only [Nat.zero_add, List.nil_append]
      rfl

theorem sizeOf_lt_of_last {F : Forest} {col : Column} {p : Nat} {h : Forest}
    (hc : F.cols.getLast? = some col) (he : col.getLast? = some (p, h)) :
    sizeOf h < sizeOf F := by
  obtain ⟨cols⟩ := F
  have m1 : col ∈ cols := List.mem_of_getLast? hc
  have m2 : (p, h) ∈ col := List.mem_of_getLast? he
  have l1 := List.sizeOf_lt_of_mem m1
  have l2 := List.sizeOf_lt_of_mem m2
  simp only [Tree.node.sizeOf_spec, Prod.mk.sizeOf_spec] at *
  omega

theorem tailLayerCols_eq : ∀ cols : List Column, tailLayerCols cols =
    match cols.getLast? with
    | none => -1
    | some c => tailLayerCol c
  | [] => by simp [tailLayerCols]
  | [c] => by simp [tailLayerCols]
  | c :: d :: rest => by
    rw [tailLayerCols, tailLayerCols_eq (d :: rest)]
    simp

theorem tailLayerCol_eq : ∀ col : Column, tailLayerCol col =
    match col.getLast? with
    | none => -1
    | some (_, h) => 1 + tailLayer h
  | [] => by simp [tailLayerCol]
  | [(a, h)] => by simp [tailLayerCol]
  | x :: y :: rest => by
    rw [tailLayerCol, tailLayerCol_eq (y :: rest)]
    simp

theorem tailLayer_eq (F : Forest) : tailLayer F =
    match F.cols.getLast? with
    | none => -1
    | some col =>
      match col.getLast? with
      | none => -1
      | some (_, h) => 1 + tailLayer h := by
  obtain ⟨cols⟩ := F
  rw [tailLayer, tailLayerCols_eq]
  simp only [Tree.cols]
  rcases cols.getLast? with _ | col
  · rfl
  · simp only
    rw [tailLayerCol_eq]
    rcases col.getLast? with _ | ⟨a, h⟩ <;> rfl

theorem tailLayer_empty : tailLayer Tree.empty = -1 := by
  simp [Tree.empty, tailLayer, tailLayerCols]

theorem nextLayer_of_last {F : Forest} {col : Column} {p : Nat} {h : Forest}
    (hc : F.cols.getLast? = some col) (he : col.getLast? = some (p, h)) : nextLayer F = h := by
  simp [nextLayer, lastEntry?, hc, he]

theorem skipLayers_succ (F : Forest) (k : Nat) :
    skipLayers F (k + 1) = nextLayer (skipLayers F k) := by
  induction k generalizing F with
  | zero => rfl
  | succ k ih => exact ih (nextLayer F)

theorem routeColsAux_empty (m : Nat) (π : List (Nat × Nat)) : routeColsAux m Tree.empty π = [] := by
  cases m <;> rfl

theorem routeColsAux_of_last (m : Nat) (π : List (Nat × Nat)) {F : Forest} {col : Column} {p : Nat}
    {h : Forest} (hc : F.cols.getLast? = some col) (he : col.getLast? = some (p, h)) :
    routeColsAux (m + 1) F π =
      ⟨π, F.cols.length - 1⟩ :: routeColsAux m h (π ++ [(F.cols.length - 1, col.length - 1)]) := by
  simp [routeColsAux, hc, he]

theorem rolesCols_length_ge {α : Type} (π : List (Nat × Nat)) :
    ∀ (cols : List (List (α × Tree α))) (c : Nat) (col : List (α × Tree α)),
      cols.getLast? = some col →
      (Tree.rolesCol π (c + cols.length - 1) 0 col).length + 1 ≤ (Tree.rolesCols π c cols).length
  | [], c, col, h => by simp at h
  | [x], c, col, h => by
    simp at h; subst h; simp [Tree.rolesCols]
  | x :: y :: rest, c, col, h => by
    have h' : (y :: rest).getLast? = some col := by simpa using h
    have := rolesCols_length_ge π (y :: rest) (c + 1) col h'
    simp only [Tree.rolesCols, List.length_cons, List.length_append] at this ⊢
    have e : c + (rest.length + 1 + 1) - 1 = c + 1 + (rest.length + 1) - 1 := by omega
    rw [e]
    omega

theorem rolesCol_length_ge {α : Type} (π : List (Nat × Nat)) (c : Nat) :
    ∀ (col : List (α × Tree α)) (i : Nat) (p : α) (h : Tree α), col.getLast? = some (p, h) →
      (Tree.rolesF (π ++ [(c, i + col.length - 1)]) h).length + 1 ≤ (Tree.rolesCol π c i col).length
  | [], i, p, h, hl => by simp at hl
  | [x], i, p, h, hl => by
    simp at hl; subst hl; simp [Tree.rolesCol]
  | x :: y :: rest, i, p, h, hl => by
    have h' : (y :: rest).getLast? = some (p, h) := by simpa using hl
    have := rolesCol_length_ge π c (y :: rest) (i + 1) p h h'
    obtain ⟨a, b⟩ := x
    simp only [Tree.rolesCol, List.length_cons, List.length_append] at this ⊢
    have e : i + (rest.length + 1 + 1) - 1 = i + 1 + (rest.length + 1) - 1 := by omega
    rw [e]
    omega

theorem rolesF_length_of_last (π : List (Nat × Nat)) {F : Forest} {col : Column} {p : Nat}
    {h : Forest} (hc : F.cols.getLast? = some col) (he : col.getLast? = some (p, h)) :
    (Tree.rolesF (π ++ [(F.cols.length - 1, col.length - 1)]) h).length + 2 ≤
      (Tree.rolesF π F).length := by
  obtain ⟨cols⟩ := F
  have h1 := rolesCols_length_ge π cols 0 col hc
  have h2 := rolesCol_length_ge π (0 + cols.length - 1) col 0 p h he
  simp only [Nat.zero_add] at h1 h2
  show _ + 2 ≤ (Tree.rolesCols π 0 cols).length
  simp only [Tree.cols]
  omega

/-- D1.6b (helper): the paper's route from address prefix `π`, read through the reference's
layers `skipLayers F k`. -/
theorem stopF_core (π : List (Nat × Nat)) (F : Forest) (sd : StopData) (hs : stopF π F = some sd) :
    ∃ ρ : List (Nat × Nat),
      sd.col = ⟨π ++ ρ, (skipLayers F ρ.length).cols.length - 1⟩ ∧
      sd.depth = π.length + ρ.length ∧ sd.t = sd.col.num 0 ∧
      (skipLayers F ρ.length).cols.getLast? = some (sd.Q ++ [(sd.r, Tree.empty)]) ∧
      (∀ k < ρ.length, ∃ col p, (skipLayers F k).cols.getLast? = some col ∧
          col.getLast? = some (p, skipLayers F (k + 1)) ∧ (skipLayers F (k + 1)).cols ≠ [] ∧
          ρ[k]? = some ((skipLayers F k).cols.length - 1, col.length - 1)) ∧
      tailLayer F = ρ.length ∧
      (ρ.map (·.1 + 1)).sum = leftCount F ρ.length ∧
      (∀ k ≤ ρ.length, F.forestAt (ρ.take k) = some (skipLayers F k)) ∧
      (∀ π', ρ.length + 1 ≤ (Tree.rolesF π' F).length) ∧
      (∀ m, ∃ L, routeColsAux (m + ρ.length + 1) F π = L ∧ L.length = ρ.length + 1 ∧
        L.getLast? = some sd.col) := by
  induction hn : sizeOf F using Nat.strong_induction_on generalizing π F with
  | _ n ih =>
  rw [stopF_eq] at hs
  rcases hc : F.cols.getLast? with _ | col
  · simp [hc] at hs
  rcases he : col.getLast? with _ | ⟨p, h⟩
  · simp [hc, he] at hs
  simp only [hc, he] at hs
  have hnl := nextLayer_of_last hc he
  have hTL := tailLayer_eq F
  simp only [hc, he] at hTL
  have hF : F.cols ≠ [] := by intro h0; simp [h0] at hc
  have hcl : F.cols[F.cols.length - 1]? = some col := by rw [← List.getLast?_eq_getElem?]; exact hc
  have hel : col[col.length - 1]? = some (p, h) := by rw [← List.getLast?_eq_getElem?]; exact he
  by_cases hh : h.cols.isEmpty
  · simp only [hh, if_true, Option.some.injEq] at hs
    subst hs
    have hhe : h = Tree.empty := by
      obtain ⟨hc'⟩ := h
      simp [Tree.cols] at hh
      subst hh; rfl
    subst hhe
    refine ⟨[], ?_, ?_, rfl, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · simp [skipLayers]
    · simp
    · simp [skipLayers, hc, List.dropLast_append_getLast? _ he]
    · simp
    · rw [hTL, tailLayer_empty]; simp
    · rfl
    · intro k hk
      simp at hk; subst hk; rfl
    · intro π'
      have := rolesF_length_of_last π' hc he
      simp only [List.length_nil]
      omega
    · intro m
      refine ⟨[⟨π, F.cols.length - 1⟩], ?_, ?_, ?_⟩
      · simp only [List.length_nil, Nat.add_zero]
        rw [routeColsAux_of_last m π hc he, routeColsAux_empty]
      · simp
      · simp
  · simp only [hh, Bool.false_eq_true, if_false] at hs
    have hlt : sizeOf h < n := hn ▸ sizeOf_lt_of_last hc he
    obtain ⟨ρ, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10⟩ := ih (sizeOf h) hlt _ h hs rfl
    have hsk : ∀ k, skipLayers F (k + 1) = skipLayers h k := by
      intro k; show skipLayers (nextLayer F) k = _; rw [hnl]
    have hhne : h.cols ≠ [] := by
      intro h0; simp [h0] at hh
    refine ⟨(F.cols.length - 1, col.length - 1) :: ρ, ?_, ?_, h3, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · rw [h1]; simp [hsk]
    · rw [h2]; simp; omega
    · simpa [hsk] using h4
    · intro k hk
      cases k with
      | zero =>
        refine ⟨col, p, hc, ?_, ?_, ?_⟩
        · rw [hsk]; exact he
        · rw [hsk]; exact hhne
        · rfl
      | succ k =>
        obtain ⟨col', p', a1, a2, a3, a4⟩ := h5 k (by simpa using hk)
        refine ⟨col', p', ?_, ?_, ?_, ?_⟩
        · rw [hsk]; exact a1
        · rw [hsk]; exact a2
        · rw [hsk]; exact a3
        · simp only [List.getElem?_cons_succ]; rw [hsk]; exact a4
    · rw [hTL, h6]; simp; omega
    · simp only [List.map_cons, List.sum_cons, List.length_cons, h7]
      show _ = F.cols.length + leftCount (nextLayer F) ρ.length
      rw [hnl]
      have : F.cols.length - 1 + 1 = F.cols.length := by
        have := List.length_pos_of_ne_nil hF; omega
      omega
    · intro k hk
      cases k with
      | zero => rfl
      | succ k =>
        simp only [List.take_succ_cons]
        simp only [Tree.forestAt, hcl, Option.bind_some, hel]
        rw [hsk]; exact h8 k (by simpa using hk)
    · intro π'
      have := rolesF_length_of_last π' hc he
      have := h9 (π' ++ [(F.cols.length - 1, col.length - 1)])
      simp only [List.length_cons]
      omega
    · intro m
      obtain ⟨L, e1, e2, e3⟩ := h10 m
      refine ⟨⟨π, F.cols.length - 1⟩ :: L, ?_, ?_, ?_⟩
      · rw [show m + ((F.cols.length - 1, col.length - 1) :: ρ).length + 1 =
            (m + ρ.length + 1) + 1 by simp; omega]
        rw [routeColsAux_of_last _ π hc he, e1]
      · simp [e2]
      · have : L ≠ [] := by intro h0; simp [h0] at e2
        obtain ⟨y, L', rfl⟩ := List.exists_cons_of_ne_nil this
        rw [List.getLast?_cons_cons]; exact e3


/-- D1.6b (helper): `stopF_core` at the outer forest; the route forests are `skipLayers E k`. -/
theorem stopData_core {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    sd.col.col + 1 = (skipLayers E sd.depth).cols.length ∧
    sd.depth = sd.col.path.length ∧ sd.t = sd.col.num 0 ∧
    (skipLayers E sd.depth).cols.getLast? = some (sd.Q ++ [(sd.r, Tree.empty)]) ∧
    (∀ k < sd.depth, ∃ col p, (skipLayers E k).cols.getLast? = some col ∧
        col.getLast? = some (p, skipLayers E (k + 1)) ∧ (skipLayers E (k + 1)).cols ≠ [] ∧
        sd.col.path[k]? = some ((skipLayers E k).cols.length - 1, col.length - 1)) ∧
    tailLayer E = sd.depth ∧
    (sd.col.path.map (·.1 + 1)).sum = leftCount E sd.depth ∧
    (∀ k ≤ sd.depth, E.forestAt (sd.col.path.take k) = some (skipLayers E k)) ∧
    sd.depth + 1 ≤ E.size ∧
    (∀ m, ∃ L, routeColsAux (m + sd.depth + 1) E [] = L ∧ L.length = sd.depth + 1 ∧
      L.getLast? = some sd.col) := by
  obtain ⟨ρ, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10⟩ := stopF_core [] E sd h
  have hp : sd.col.path = ρ := by rw [h1]; simp
  have hd : sd.depth = ρ.length := by rw [h2]; simp
  have hc : sd.col.col = (skipLayers E ρ.length).cols.length - 1 := by rw [h1]
  rw [hp, hd]
  refine ⟨?_, rfl, h3, h4, h5, h6, h7, h8, ?_, ?_⟩
  · have : (skipLayers E ρ.length).cols ≠ [] := by intro h0; simp [h0] at h4
    have := List.length_pos_of_ne_nil this
    omega
  · simpa [Tree.size, Tree.roles] using h9 []
  · intro m; simpa using h10 m

/-- D1.6b (helper): the stopping forest is the forest at the stopping column's path. -/
theorem forestAt_stopPath {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    E.forestAt sd.col.path = some (skipLayers E sd.depth) := by
  obtain ⟨-, hd, -, -, -, -, -, hfa, -⟩ := stopData_core h
  have h1 := hfa sd.depth le_rfl
  have h2 : sd.col.path.take sd.depth = sd.col.path := by rw [hd, List.take_length]
  rwa [h2] at h1

/-- D1.6b (helper): a stop has a nonempty last outer column. -/
theorem lastCol_of_stopData {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    ∃ x xs, E.cols.getLast? = some (x :: xs) := by
  have h' : stopF [] E = some sd := h
  rw [stopF_eq] at h'
  rcases hc : E.cols.getLast? with _ | _ | ⟨x, xs⟩
  · simp [hc] at h'
  · simp [hc] at h'
  · exact ⟨x, xs, rfl⟩

/-- D1.6b (`stopData_spec`†): the stopping column `Q ⌢ [(r, ∅)]` is the last route column. -/
theorem stopData_spec {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    E.colAt sd.col = some (sd.Q ++ [(sd.r, Tree.empty)]) ∧ sd.depth = sd.col.path.length ∧
      sd.t = sd.col.num 0 ∧ sd.col ∈ routeCols E ∧ (routeCols E).getLast? = some sd.col ∧
      (routeCols E).length = sd.depth + 1 := by
  obtain ⟨hcc, hd, ht, hlast, -, -, -, -, hsz, hroute⟩ := stopData_core h
  have hfp := forestAt_stopPath h
  obtain ⟨L, e1, e2, e3⟩ := hroute (E.size - sd.depth)
  have hrc : routeCols E = L := by
    have : routeCols E = routeColsAux (E.size - sd.depth + sd.depth + 1) E [] := by
      rw [routeCols]; congr 1; omega
    rw [this, e1]
  refine ⟨?_, hd, ht, ?_, ?_, ?_⟩
  · simp only [Tree.colAt, hfp, Option.bind_some]
    rw [show sd.col.col = (skipLayers E sd.depth).cols.length - 1 by omega,
      ← List.getLast?_eq_getElem?]
    exact hlast
  · rw [hrc]; exact List.mem_of_getLast? e3
  · rw [hrc]; exact e3
  · rw [hrc]; exact e2

/-- D1.6b (helper): under I the route from a forest of `E` with a nonempty last column stops. -/
theorem stopF_isSome {E : Forest} (hI : CondI E) (F : Forest) (π : List (Nat × Nat))
    (hF : E.forestAt π = some F) {col : Column} (hc : F.cols.getLast? = some col)
    (hne : col ≠ []) : (stopF π F).isSome := by
  induction hn : sizeOf F using Nat.strong_induction_on generalizing π F col with
  | _ n ih =>
  obtain ⟨⟨p, h⟩, he⟩ : ∃ x, col.getLast? = some x := by
    cases hcl : col.getLast? with
    | none => simp at hcl; exact absurd hcl hne
    | some x => exact ⟨x, rfl⟩
  rw [stopF_eq]
  simp only [hc, he]
  by_cases hh : h.cols.isEmpty
  · simp [hh]
  · simp only [hh, Bool.false_eq_true, if_false]
    have hcl : F.cols[F.cols.length - 1]? = some col := by
      rw [← List.getLast?_eq_getElem?]; exact hc
    have hel : col[col.length - 1]? = some (p, h) := by
      rw [← List.getLast?_eq_getElem?]; exact he
    have hfa : E.forestAt (π ++ [(F.cols.length - 1, col.length - 1)]) = some h := by
      rw [Tree.forestAt_append, hF]
      simp [Tree.forestAt, hcl, hel]
    have hent : E.entryAt ⟨⟨π, F.cols.length - 1⟩, col.length - 1⟩ = some (p, h) := by
      simp [Tree.entryAt, Tree.colAt, hF, hcl, hel]
    have hmem : (⟨⟨π, F.cols.length - 1⟩, col.length - 1⟩ : EntryAddr) ∈ E.entryAddrs :=
      (Tree.mem_entryAddrs_iff E _).mpr (by rw [hent]; rfl)
    have hhc : h.cols ≠ [] := by intro h0; simp [h0] at hh
    have hhne : h ≠ Tree.empty := by
      intro h0; subst h0; exact hhc rfl
    obtain ⟨col', hc'⟩ : ∃ c, h.cols.getLast? = some c := by
      cases hx : h.cols.getLast? with
      | none => simp at hx; exact absurd hx hhc
      | some c => exact ⟨c, rfl⟩
    have hne' : col' ≠ [] := by
      obtain ⟨q, H, rest, hq, -⟩ := hI _ hmem p h hent hhne col' (List.mem_of_getLast? hc')
      rw [hq]; simp
    exact ih _ (hn ▸ sizeOf_lt_of_last hc he) h _ hfa hc' hne' rfl

/-- D1.6b: under I the route is never stuck (X-02 cannot happen). -/
theorem stopData_isSome {E : Forest} (hI : CondI E) {col : Column}
    (hlast : E.cols.getLast? = some col) (hne : col ≠ []) : (stopData E).isSome :=
  stopF_isSome hI E [] (by simp [Tree.forestAt]) hlast hne

/-- D1.6b: `stopData` is `none` on `∅` and on a last outer column that is empty. -/
theorem stopData_eq_none_of_lastCol {E : Forest} (h : E.cols.getLast? = none ∨ E.cols.getLast? = some []) :
    stopData E = none := by
  show stopF [] E = none
  rw [stopF_eq]
  rcases h with h | h <;> simp [h]

/-- D1.6b (helper): the branch of a stop. -/
theorem stepKind_of_stopData {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    stepKind E = if specialStop sd then some .special
      else if (sd.col.resolve 0 sd.r).isSome then some .ordinary else none := by
  obtain ⟨x, xs, hc⟩ := lastCol_of_stopData h
  have h' : stopDataBody E = some sd := h
  simp only [stepKind, stepKindBody, hc, h']

/-- D1.6b (helper): without a stop, the branch is deletion or undefined. -/
theorem stepKind_of_stopData_none {E : Forest} (h : stopData E = none) :
    stepKind E = if E.cols.getLast? = some [] then some .deletion else none := by
  have h' : stopDataBody E = none := h
  simp only [stepKind, stepKindBody]
  rcases hc : E.cols.getLast? with _ | _ | ⟨x, xs⟩ <;> simp [h']

/-- D1.6b: the deletion branch is exactly an empty last outer column. -/
theorem stepKind_deletion_iff (E : Forest) : stepKind E = some .deletion ↔ E.cols.getLast? = some [] := by
  rcases hs : stopData E with _ | sd
  · rw [stepKind_of_stopData_none hs]; split_ifs with h <;> simp [h]
  · rw [stepKind_of_stopData hs]
    obtain ⟨x, xs, hc⟩ := lastCol_of_stopData hs
    rw [hc]; split_ifs <;> simp

/-- D1.6b: the special branch is exactly `specialStop`. -/
theorem stepKind_special_iff (E : Forest) :
    stepKind E = some .special ↔ ∃ sd, stopData E = some sd ∧ specialStop sd = true := by
  rcases hs : stopData E with _ | sd
  · rw [stepKind_of_stopData_none hs]; split_ifs <;> simp
  · rw [stepKind_of_stopData hs]; split_ifs with h1 h2 <;> simp [h1]

/-- D1.6b: the ordinary branch: a stop that is not special with a visible root. -/
theorem stepKind_ordinary_iff (E : Forest) :
    stepKind E = some .ordinary ↔ ∃ sd o, stopData E = some sd ∧ specialStop sd = false ∧
      sd.col.resolve 0 sd.r = some o := by
  rcases hs : stopData E with _ | sd
  · rw [stepKind_of_stopData_none hs]; split_ifs <;> simp
  · rw [stepKind_of_stopData hs]
    split_ifs with h1 h2
    · simp [h1]
    · simp only [Option.some.injEq, true_iff]
      obtain ⟨o, ho⟩ := Option.isSome_iff_exists.mp h2
      exact ⟨sd, o, rfl, by simpa using h1, ho⟩
    · simp only [false_iff, not_exists, not_and]
      intro sd' o h' _ ho
      cases h'
      simp [ho] at h2

/-- D1.6b (helper): the root data built from a visible root `o` (the body of `rootDataBody`). -/
def rootOf (E : Forest) (sd : StopData) (o : ColAddr) : RootData :=
  { layer := o.path.length, idx := o.col, col := o,
    owner := o.col + 1 == ((E.forestAt o.path).getD Tree.empty).cols.length,
    cursor := cursor (((((E.forestAt o.path).getD Tree.empty).cols[o.col]?).getD []).map
      fun x => relKey (o.num 0) x.2) (sd.Q.map fun x => relKey sd.t x.2) }

/-- D1.6b (helper): `rootData` unfolded at a stop. -/
theorem rootData_eq_of_stopData {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    rootData E = if stepKind E = some .ordinary then (sd.col.resolve 0 sd.r).map (rootOf E sd)
      else none := by
  have h' : stopDataBody E = some sd := h
  rcases hk : stepKind E with _ | _ | _ | _
  · have hk' : stepKindBody E = none := hk
    simp [rootData, rootDataBody, h', hk']
  · have hk' : stepKindBody E = some .deletion := hk
    simp [rootData, rootDataBody, h', hk']
  · have hk' : stepKindBody E = some .special := hk
    simp [rootData, rootDataBody, h', hk']
  · have hk' : stepKindBody E = some .ordinary := hk
    simp only [rootData, rootDataBody, h', hk', if_true]
    rcases sd.col.resolve 0 sd.r with _ | o <;> rfl

/-- D1.6b (helper): root data come from a visible root. -/
theorem rootData_unpack {E : Forest} {sd : StopData} {rd : RootData} (hsd : stopData E = some sd)
    (hrd : rootData E = some rd) :
    stepKind E = some .ordinary ∧ ∃ o, sd.col.resolve 0 sd.r = some o ∧ rd = rootOf E sd o := by
  rw [rootData_eq_of_stopData hsd] at hrd
  split_ifs at hrd with hk
  · refine ⟨hk, ?_⟩
    rcases ho : sd.col.resolve 0 sd.r with _ | o
    · simp [ho] at hrd
    · simp only [ho, Option.map_some, Option.some.injEq] at hrd
      exact ⟨o, rfl, hrd.symm⟩

/-- D1.6b (helper): a stack occurrence of the stopping column is a column of a route forest; it
is the last column of its forest exactly when it contains the stopping column, and then the
containing entry is its last entry. -/
theorem onStack_route {E : Forest} {sd : StopData} {o : ColAddr} (h : stopData E = some sd)
    (hon : sd.col.OnStack o) :
    ∃ F, E.forestAt o.path = some F ∧ o.col < F.cols.length ∧ o.path <+: sd.col.path ∧
      (o.col + 1 = F.cols.length ↔ ∃ u, o.path ++ [(o.col, u)] <+: sd.col.path) ∧
      (∀ u, o.path ++ [(o.col, u)] <+: sd.col.path →
        u + 1 = ((F.cols[o.col]?).getD []).length) := by
  obtain ⟨hcc, hd, -, -, hcont, -, -, hfa, -⟩ := stopData_core h
  rcases hon with ⟨k, ck, ik, hk, hp, hc⟩ | ⟨hp, hc⟩
  · have hkl : k < sd.depth := by
      rw [hd]; exact (List.getElem?_eq_some_iff.mp hk).1
    obtain ⟨col, p, a1, a2, -, a4⟩ := hcont k hkl
    rw [hk, Option.some.injEq, Prod.mk.injEq] at a4
    obtain ⟨rfl, rfl⟩ := a4
    have hFne : (skipLayers E k).cols ≠ [] := by intro h0; simp [h0] at a1
    have hFpos := List.length_pos_of_ne_nil hFne
    have hcolne : col ≠ [] := by intro h0; simp [h0] at a2
    have hcolpos := List.length_pos_of_ne_nil hcolne
    have hlastc : (skipLayers E k).cols[(skipLayers E k).cols.length - 1]? = some col := by
      rw [← List.getLast?_eq_getElem?]; exact a1
    have htake : sd.col.path.take (k + 1) = sd.col.path.take k ++
        [((skipLayers E k).cols.length - 1, col.length - 1)] := by
      rw [List.take_add_one, hk]; rfl
    have hpre_iff : ∀ u, o.path ++ [(o.col, u)] <+: sd.col.path →
        o.col = (skipLayers E k).cols.length - 1 ∧ u = col.length - 1 := by
      intro u hu
      have hl : (o.path ++ [(o.col, u)]).length = k + 1 := by
        simp [hp]; exact Nat.le_of_lt (by rw [← hd]; exact hkl)
      rw [List.prefix_iff_eq_take, hl, htake, hp] at hu
      simpa using hu
    refine ⟨skipLayers E k, by rw [hp]; exact hfa k (Nat.le_of_lt hkl), by omega,
      by rw [hp]; exact List.take_prefix _ _, ⟨fun ho => ?_, fun ⟨u, hu⟩ => ?_⟩, ?_⟩
    · refine ⟨col.length - 1, ?_⟩
      rw [hp, show o.col = (skipLayers E k).cols.length - 1 by omega, ← htake]
      exact List.take_prefix _ _
    · have := (hpre_iff u hu).1; omega
    · intro u hu
      obtain ⟨h1, h2⟩ := hpre_iff u hu
      rw [h1, hlastc]; simp; omega
  · refine ⟨skipLayers E sd.depth, by rw [hp]; exact forestAt_stopPath h, by omega,
      by rw [hp], ⟨fun ho => by omega, fun ⟨u, hu⟩ => ?_⟩, fun u hu => ?_⟩
    · have := hu.length_le; simp [hp] at this
    · have := hu.length_le; simp [hp] at this

/-- D1.6b (`rootData_spec`†). -/
theorem rootData_spec {E : Forest} {sd : StopData} {rd : RootData} (hsd : stopData E = some sd)
    (hrd : rootData E = some rd) :
    sd.col.resolve 0 sd.r = some rd.col ∧ rd.layer = rd.col.path.length ∧ rd.idx = rd.col.col ∧
      rd.col.num 0 = sd.r ∧ sd.r < sd.t ∧ rd.col ∈ E.colAddrs ∧
      rd.cursor = cursor (rootKeys E rd) (queryKeys sd) ∧
      (rd.owner = true ↔ ∃ F, E.forestAt rd.col.path = some F ∧ rd.col.col + 1 = F.cols.length) := by
  obtain ⟨-, o, ho, rfl⟩ := rootData_unpack hsd hrd
  obtain ⟨hon, hnum⟩ := (ColAddr.resolve_spec 0 sd.col o sd.r).mp ho
  obtain ⟨F, hF, hlt, -⟩ := onStack_route hsd hon
  obtain ⟨-, -, ht, -⟩ := stopData_core hsd
  refine ⟨ho, rfl, rfl, hnum, ?_, ?_, ?_, ?_⟩
  · rw [ht]; exact ColAddr.resolve_lt ho
  · exact (Tree.mem_colAddrs_iff E o).mpr (by simp [Tree.colAt, hF, hlt])
  · simp [rootOf, rootKeys, queryKeys, Tree.colAt, hF]
  · simp [rootOf, hF]

/-- D1.6b: the root is an owner iff it contains the stopping column; then the containing entry is
its last entry (the active root entry `u`). -/
theorem rootData_owner_iff {E : Forest} {sd : StopData} {rd : RootData} (hsd : stopData E = some sd)
    (hrd : rootData E = some rd) :
    rd.owner = true ↔ ∃ u, (⟨rd.col, u⟩ : EntryAddr).Contains sd.col ∧
      u + 1 = ((E.colAt rd.col).getD []).length := by
  obtain ⟨-, o, ho, rfl⟩ := rootData_unpack hsd hrd
  obtain ⟨hon, -⟩ := (ColAddr.resolve_spec 0 sd.col o sd.r).mp ho
  obtain ⟨F, hF, -, -, hiff, hlen⟩ := onStack_route hsd hon
  simp only [rootOf, hF, Option.getD_some, beq_iff_eq, EntryAddr.Contains, EntryAddr.heightPath,
    Tree.colAt, Option.bind_some]
  constructor
  · intro hown
    obtain ⟨u, hu⟩ := hiff.mp hown
    exact ⟨u, hu, hlen u hu⟩
  · rintro ⟨u, hu, -⟩
    exact hiff.mpr ⟨u, hu⟩

/-- D1.6b: in the owner case the root layer is strictly above the stopping depth. -/
theorem rootData_layer_lt {E : Forest} {sd : StopData} {rd : RootData} (hsd : stopData E = some sd)
    (hrd : rootData E = some rd) (ho : rd.owner = true) : rd.layer < sd.depth := by
  obtain ⟨u, hu, -⟩ := (rootData_owner_iff hsd hrd).mp ho
  obtain ⟨-, hlay, -⟩ := rootData_spec hsd hrd
  obtain ⟨-, hd, -⟩ := stopData_core hsd
  have := hu.length_le
  simp [EntryAddr.heightPath] at this
  omega

theorem rootData_layer_le {E : Forest} {sd : StopData} {rd : RootData} (hsd : stopData E = some sd)
    (hrd : rootData E = some rd) : rd.layer ≤ sd.depth := by
  obtain ⟨-, o, ho, rfl⟩ := rootData_unpack hsd hrd
  obtain ⟨hon, -⟩ := (ColAddr.resolve_spec 0 sd.col o sd.r).mp ho
  obtain ⟨F, -, -, hpre, -⟩ := onStack_route hsd hon
  obtain ⟨-, hd, -⟩ := stopData_core hsd
  have := hpre.length_le
  simp only [rootOf]
  omega

/-- D1.6b (helper): the owner entry of a stop at positive depth: the last entry of the last
column of the route forest above. -/
theorem ownerEntry_data {E : Forest} {sd : StopData} (h : stopData E = some sd)
    (hpos : 0 < sd.depth) :
    ∃ oe col p, sd.ownerEntry = some oe ∧ oe.heightPath = sd.col.path ∧
      E.colAt oe.col = some col ∧ (skipLayers E (sd.depth - 1)).cols.getLast? = some col ∧
      col.getLast? = some (p, skipLayers E sd.depth) ∧ oe.idx + 1 = col.length ∧
      oe.col.num 0 + 1 + sd.col.col = sd.t := by
  obtain ⟨-, hd, ht, -, hcont, -, -, hfa, -⟩ := stopData_core h
  obtain ⟨col, p, a1, a2, -, a4⟩ := hcont (sd.depth - 1) (by omega)
  rw [show sd.depth - 1 + 1 = sd.depth by omega] at a2
  have hpl : sd.col.path.getLast? = some ((skipLayers E (sd.depth - 1)).cols.length - 1,
      col.length - 1) := by
    rw [List.getLast?_eq_getElem?, ← hd]; exact a4
  have hdl := List.dropLast_append_getLast? _ hpl
  have hcolne : col ≠ [] := by intro h0; simp [h0] at a2
  have hcolpos := List.length_pos_of_ne_nil hcolne
  have hlastc : (skipLayers E (sd.depth - 1)).cols[(skipLayers E (sd.depth - 1)).cols.length - 1]? =
      some col := by
    rw [← List.getLast?_eq_getElem?]; exact a1
  have hfd : E.forestAt sd.col.path.dropLast = some (skipLayers E (sd.depth - 1)) := by
    rw [List.dropLast_eq_take, ← hd]; exact hfa _ (by omega)
  refine ⟨⟨⟨sd.col.path.dropLast, (skipLayers E (sd.depth - 1)).cols.length - 1⟩, col.length - 1⟩,
    col, p, by simp [StopData.ownerEntry, hpl], by simpa [EntryAddr.heightPath] using hdl, ?_, a1,
    a2, by simp; omega, ?_⟩
  · simp [Tree.colAt, hfd, hlastc]
  · rw [ht]
    conv_rhs => rw [ColAddr.num, ← hdl]
    simp [ColAddr.num]
    omega

/-- D1.6b: the special owner entry is the last entry of the owner column, its height is the
stopping forest, which ends in the single-entry column `[(r, ∅)]`. -/
theorem ownerEntry_spec {E : Forest} {sd : StopData} {oe : EntryAddr}
    (hk : stepKind E = some .special) (hsd : stopData E = some sd) (hoe : sd.ownerEntry = some oe) :
    oe.Contains sd.col ∧ oe.heightPath = sd.col.path ∧ oe.col.num 0 = sd.r ∧
      ∃ col p Fl, E.colAt oe.col = some col ∧ col.getLast? = some (p, Fl) ∧
        oe.idx + 1 = col.length ∧ Fl.cols.getLast? = some [(sd.r, Tree.empty)] := by
  obtain ⟨sd', hsd', hs⟩ := (stepKind_special_iff E).mp hk
  rw [hsd] at hsd'; cases hsd'
  simp only [specialStop, Bool.and_eq_true, decide_eq_true_eq, List.isEmpty_iff, beq_iff_eq] at hs
  obtain ⟨⟨hpos, hQ⟩, hr⟩ := hs
  obtain ⟨oe', col, p, hoe', hhp, hcol, -, hlast, hidx, hnum⟩ := ownerEntry_data hsd hpos
  rw [hoe] at hoe'; cases hoe'
  obtain ⟨-, -, -, hF, -⟩ := stopData_core hsd
  refine ⟨by rw [EntryAddr.Contains, hhp], hhp, by omega, col, p, _, hcol, hlast, hidx, ?_⟩
  rw [hF, hQ]; rfl

/-- D1.6b (`paperOp_deletion`). -/
theorem paperOp_deletion {E : Forest} (h : stepKind E = some .deletion) (n : Nat) :
    paperOp E n = some (.node E.cols.dropLast) := by
  have h' : stepKindBody E = some .deletion := h
  simp only [paperOp, paperOpBody, h']

/-- D1.6b (`paperOp_special`†): the special output, in terms of `Hole.fill`. -/
theorem paperOp_special {E : Forest} {sd : StopData} {oe : EntryAddr} {col : Column} {p : Nat}
    {Fl : Forest} (hk : stepKind E = some .special) (hsd : stopData E = some sd)
    (hoe : sd.ownerEntry = some oe) (hcol : E.colAt oe.col = some col)
    (hlast : col.getLast? = some (p, Fl)) (n : Nat) :
    paperOp E n = some (Hole.fill ⟨E, sd.depth - 1⟩ 0 0
      (.node [col.dropLast ++
        List.replicate (n + if col.dropLast.isEmpty then 1 else 0) (p, .node Fl.cols.dropLast)])) := by
  have hk' : stepKindBody E = some .special := hk
  have hsd' : stopDataBody E = some sd := hsd
  simp only [paperOp, paperOpBody, hk', hsd', specialOut, hoe, hcol, hlast]

/-- D1.6b (`paperOp_ordinary`†): the ordinary output, in terms of `Hole.fill` and `ordZ`. -/
theorem paperOp_ordinary {E : Forest} {sd : StopData} {rd : RootData}
    (hk : stepKind E = some .ordinary) (hsd : stopData E = some sd) (hrd : rootData E = some rd)
    (n : Nat) :
    paperOp E n =
      if rd.owner && n != 0 && (((E.colAt rd.col).getD []).drop rd.cursor).isEmpty then none
      else some (Hole.fill ⟨E, sd.depth⟩ 0 0 (ordZ E sd rd n)) := by
  have hk' : stepKindBody E = some .ordinary := hk
  have hsd' : stopDataBody E = some sd := hsd
  have hrd' : rootDataBody E = some rd := hrd
  simp only [paperOp, paperOpBody, hk', hsd', hrd', ordinaryOut]

/-- D1.6b: the ordinary step at parameter `0` deletes the whole stopping column (txt:132-133). -/
theorem paperOp_ordinary_zero {E : Forest} {sd : StopData} (hk : stepKind E = some .ordinary)
    (hsd : stopData E = some sd) : paperOp E 0 = some (Hole.put ⟨E, sd.depth⟩ Tree.empty) := by
  obtain ⟨rd, hrd⟩ := Option.isSome_iff_exists.mp (rootData_of_ordinary hk)
  rw [paperOp_ordinary hk hsd hrd]
  simp only [bne_self_eq_false, Bool.and_false, Bool.false_and, Bool.false_eq_true, if_false]
  rfl

/-! ### D1.6c — agreement of the locked `expand` with `paperOp` (G-001, D-3) -/

/-- D1.6c: the reference's depth agrees with the paper's route whenever the latter stops
(no use of I). -/
theorem tailLayer_of_stopData {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    tailLayer E = (sd.depth : Int) := by
  obtain ⟨-, -, -, -, -, htl, -⟩ := stopData_core h
  exact htl

/-- D1.6c (helper): `tailLayer` is at least `-1`. -/
theorem tailLayer_ge (F : Forest) : -1 ≤ tailLayer F := by
  induction hn : sizeOf F using Nat.strong_induction_on generalizing F with
  | _ n ih =>
  rw [tailLayer_eq]
  rcases hc : F.cols.getLast? with _ | col
  · simp
  simp only
  rcases he : col.getLast? with _ | ⟨p, h⟩
  · simp
  have := ih _ (hn ▸ sizeOf_lt_of_last hc he) h rfl
  simp only
  omega

/-- D1.6c: the reference's deletion test. -/
theorem tailLayer_neg_iff {E : Forest} (hE : E ≠ Tree.empty) :
    tailLayer E < 0 ↔ E.cols.getLast? = some [] := by
  obtain ⟨cols⟩ := E
  have hne : cols ≠ [] := by rintro rfl; exact hE rfl
  obtain ⟨col, hc⟩ : ∃ c, cols.getLast? = some c := by
    cases hx : cols.getLast? with
    | none => simp at hx; exact absurd hx hne
    | some c => exact ⟨c, rfl⟩
  rw [tailLayer_eq]
  simp only [Tree.cols] at hc ⊢
  rw [hc]
  simp only
  rcases he : col.getLast? with _ | ⟨p, h⟩
  · simp at he; simp [he]
  · have := tailLayer_ge h
    have hcne : col ≠ [] := by intro h0; simp [h0] at he
    simp only [Option.some.injEq, hcne, iff_false]
    omega

/-- D1.6c: the reference's layers are the paper's route forests. -/
theorem skipLayers_of_stopData {E : Forest} {sd : StopData} (h : stopData E = some sd) {d : Nat}
    (hd : d ≤ sd.depth) : E.forestAt (sd.col.path.take d) = some (skipLayers E d) := by
  obtain ⟨-, -, -, -, -, -, -, hfa, -⟩ := stopData_core h
  exact hfa d hd

theorem skipLayers_add (E : Forest) (a b : Nat) : skipLayers (skipLayers E a) b = skipLayers E (a + b) := by
  induction a generalizing E with
  | zero => simp [skipLayers]
  | succ a ih =>
    rw [show a + 1 + b = (a + b) + 1 by omega]
    exact ih (nextLayer E)

/-- D1.6c: `leftCount` counts the columns of the layers above `d` (no hypothesis). -/
theorem leftCount_eq_sum (E : Forest) (d : Nat) :
    leftCount E d = ((List.range d).map fun k => (skipLayers E k).cols.length).sum := by
  induction d generalizing E with
  | zero => rfl
  | succ d ih =>
    rw [leftCount, ih, List.range_succ_eq_map]
    simp [skipLayers, Function.comp_def]

/-- D1.6c: `t` agrees (txt:101-103). -/
theorem tailNum_of_stopData {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    tailNum E sd.depth = sd.t := by
  obtain ⟨hcc, -, ht, -, -, -, hsum, -⟩ := stopData_core h
  rw [tailNum, ht, ColAddr.num, hsum]
  omega

/-- D1.6c: `r` agrees. -/
theorem rootAt_of_stopData {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    rootAt E sd.depth = sd.r := by
  obtain ⟨-, -, -, hlast, -⟩ := stopData_core h
  simp [rootAt, lastEntry?, hlast]

/-- D1.6c: the special tests agree. -/
theorem isSpecial_of_stopData {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    isSpecial E sd.depth = specialStop sd := by
  obtain ⟨hcc, -, ht, hlast, -, -, hsum, -⟩ := stopData_core h
  have hnum : sd.t = leftCount E sd.depth + sd.col.col := by
    rw [ht, ColAddr.num, hsum]; omega
  unfold isSpecial specialStop
  rw [hlast]
  rcases Nat.eq_zero_or_pos sd.depth with h0 | hpos
  · simp [h0]
  · have hlc : 1 ≤ leftCount E sd.depth := by
      obtain ⟨k, hk⟩ : ∃ k, sd.depth = k + 1 := ⟨sd.depth - 1, by omega⟩
      obtain ⟨x, xs, hc⟩ := lastCol_of_stopData h
      have hEne : E.cols ≠ [] := by intro h0; simp [h0] at hc
      have := List.length_pos_of_ne_nil hEne
      rw [hk, leftCount]; omega
    rcases hQ : sd.Q with _ | ⟨x, Q'⟩
    · simp only [List.nil_append, Tree.empty, Tree.cols, List.isEmpty_nil, Bool.true_and,
        decide_eq_true hpos]
      rw [Bool.eq_iff_iff]
      simp only [Bool.and_eq_true, bne_iff_ne, beq_iff_eq, ne_eq]
      omega
    · obtain ⟨y, rest, hyr⟩ : ∃ y rest, Q' ++ [(sd.r, Tree.empty)] = y :: rest := by
        cases Q' with
        | nil => exact ⟨_, _, rfl⟩
        | cons a l => exact ⟨a, _, rfl⟩
      simp [hyr]

/-- D1.6c (helper): a shift by `0` fixes a column. -/
theorem mapCol_shiftVal_zero (r : Nat) (col : Column) : Tree.mapCol (shiftVal r 0) col = col := by
  have h := shift_zero r (.node [col])
  simp only [shift, Tree.map, Tree.mapCols] at h
  simpa using h

/-- D1.6c (helper, item 8): the column that `specialOut` places, read off the forest `H` holding
the owner column as its last column. -/
def specialZ (n : Nat) (H : Forest) : Forest :=
  let col := H.cols.getLast?.getD []
  let pf := col.getLast?.getD (0, Tree.empty)
  .node [col.dropLast ++
    List.replicate (n + if col.dropLast.isEmpty then 1 else 0) (pf.1, .node pf.2.cols.dropLast)]

/-- D1.6c (helper, item 8, generalized): along a route with nonempty last columns down to layer
`k`, `expandSpecial` at depth `k + 1` is the placement of `specialZ` at depth `k`. -/
theorem expandSpecial_eq_replaceAt (n : Nat) : ∀ (k : Nat) (G : Forest),
    (∀ j ≤ k, ∃ col, (skipLayers G j).cols.getLast? = some col ∧ col ≠ []) →
    expandSpecial n (k + 1) G = replaceAt 0 0 (specialZ n (skipLayers G k)) k G
  | 0, G, hG => by
    obtain ⟨col, hc, hne⟩ := hG 0 le_rfl
    obtain ⟨⟨p, h⟩, he⟩ : ∃ x, col.getLast? = some x := by
      cases hx : col.getLast? with
      | none => simp at hx; exact absurd hx hne
      | some x => exact ⟨x, rfl⟩
    obtain ⟨cols⟩ := G
    simp only [skipLayers, Tree.cols] at hc
    obtain ⟨c, cs, rfl⟩ : ∃ c cs, cols = c :: cs := by
      cases cols with
      | nil => simp at hc
      | cons c cs => exact ⟨c, cs, rfl⟩
    simp only [expandSpecial, replaceAt, specialZ, skipLayers, Tree.cols, hc, he,
      Option.getD_some]
    rw [show List.map (Tree.mapCol (shiftVal 0 0)) (c :: cs).dropLast = (c :: cs).dropLast from
      List.map_id'' (mapCol_shiftVal_zero 0) _]
    by_cases hd : col.dropLast.isEmpty
    · simp only [hd, if_true]
      rw [List.isEmpty_iff.mp hd]
      simp [List.replicate_succ]
    · simp [hd]
  | k + 1, G, hG => by
    obtain ⟨col, hc, hne⟩ := hG 0 (Nat.zero_le _)
    obtain ⟨⟨p, h⟩, he⟩ : ∃ x, col.getLast? = some x := by
      cases hx : col.getLast? with
      | none => simp at hx; exact absurd hx hne
      | some x => exact ⟨x, rfl⟩
    simp only [skipLayers] at hc
    have hnl := nextLayer_of_last hc he
    have ih := expandSpecial_eq_replaceAt n k h (fun j hj => by
      have := hG (j + 1) (by omega)
      simpa [skipLayers, hnl] using this)
    have hsk : skipLayers G (k + 1) = skipLayers h k := by
      show skipLayers (nextLayer G) k = _; rw [hnl]
    obtain ⟨cols⟩ := G
    simp only [Tree.cols] at hc
    simp only [expandSpecial, replaceAt, hc, he, Option.getD_some]
    rw [mapLast_eq, hc]
    simp only [Option.map_some, Option.toList_some]
    rw [mapLast_eq, he, hsk]
    simp only [Option.map_some, Option.toList_some, shiftVal_zero]
    have hf : ∀ x : Nat × Forest, (x.1, Tree.map (shiftVal 0 0) x.2) = x := fun x => by
      rw [show Tree.map (shiftVal 0 0) x.2 = x.2 from shift_zero 0 x.2]
    rw [← ih, List.map_id'' (mapCol_shiftVal_zero 0) cols.dropLast, List.map_id'' hf]

/-- D1.6c: the special outputs agree. -/
theorem expandSpecial_of_stopData {E : Forest} {sd : StopData} (h : stopData E = some sd)
    (hs : specialStop sd = true) (n : Nat) : some (expandSpecial n sd.depth E) = specialOut E sd n := by
  have hpos : 0 < sd.depth := by
    simp only [specialStop, Bool.and_eq_true, decide_eq_true_eq] at hs; exact hs.1.1
  obtain ⟨-, -, -, -, hcont, -⟩ := stopData_core h
  obtain ⟨oe, col, p, hoe, -, hcol, hlastc, hlastp, -, -⟩ := ownerEntry_data h hpos
  have hgen := expandSpecial_eq_replaceAt n (sd.depth - 1) E (fun j hj => by
    obtain ⟨c, q, a1, a2, -⟩ := hcont j (by omega)
    exact ⟨c, a1, by intro h0; simp [h0] at a2⟩)
  rw [show sd.depth - 1 + 1 = sd.depth by omega] at hgen
  rw [hgen]
  simp only [specialOut, hoe, hcol, hlastp, Hole.fill, specialZ, hlastc, Option.getD_some]

/-- D1.6c (helper, item 9): `rootLayerAux` and `resolveAux` visit the same levels of a route. -/
theorem rootLayerAux_of_resolveAux (q c : Nat) : ∀ (ρ : List (Nat × Nat)) (F : Forest)
    (start layer fuel : Nat) (pre : List (Nat × Nat)) (o : ColAddr),
    (∀ k (hk : k < ρ.length), ρ[k].1 + 1 = (skipLayers F k).cols.length) →
    c + 1 = (skipLayers F ρ.length).cols.length → ρ.length + 2 ≤ fuel → start ≤ q →
    ColAddr.resolveAux start pre ρ c q = some o →
    ∃ k, o.path.length = pre.length + k ∧ rootLayerAux q fuel F start layer = some (layer + k, o.col)
  | [], F, start, layer, fuel, pre, o, _, hc, hf, hq, hr => by
    simp only [ColAddr.resolveAux] at hr
    split_ifs at hr with h1
    obtain rfl := (Option.some.inj hr).symm
    obtain ⟨f, rfl⟩ : ∃ f, fuel = f + 1 := ⟨fuel - 1, by simp at hf; omega⟩
    refine ⟨0, by simp, ?_⟩
    simp only [List.length_nil, skipLayers] at hc
    simp only [rootLayerAux]
    rw [if_pos (by omega)]
    simp
  | (ck, ik) :: ρ, F, start, layer, fuel, pre, o, hρ, hc, hf, hq, hr => by
    have h0 := hρ 0 (by simp)
    simp only [List.getElem_cons_zero, skipLayers] at h0
    obtain ⟨f, rfl⟩ : ∃ f, fuel = f + 1 := ⟨fuel - 1, by simp at hf; omega⟩
    simp only [ColAddr.resolveAux] at hr
    simp only [rootLayerAux]
    split_ifs at hr with h1
    · obtain rfl := (Option.some.inj hr).symm
      refine ⟨0, by simp, ?_⟩
      rw [if_pos (by omega)]
      simp
    · rw [if_neg (by omega)]
      obtain ⟨k, hk1, hk2⟩ := rootLayerAux_of_resolveAux q c ρ (nextLayer F) (start + ck + 1)
        (layer + 1) f (pre ++ [(ck, ik)]) o
        (fun k hk => by
          have := hρ (k + 1) (by simp; omega)
          simpa [skipLayers] using this)
        (by simpa [skipLayers] using hc) (by simp at hf; omega) (by omega) hr
      refine ⟨k + 1, by simp at hk1; omega, ?_⟩
      rw [show start + F.cols.length = start + ck + 1 by omega, hk2]
      congr 2; omega

/-- D1.6c: the reference's root search finds the paper's visible root. -/
theorem rootLayer_of_resolve {E : Forest} {sd : StopData} {o : ColAddr} (h : stopData E = some sd)
    (ho : sd.col.resolve 0 sd.r = some o) : rootLayer E sd.r sd.depth = some (o.path.length, o.col) := by
  obtain ⟨hcc, hd, -, -, hcont, -⟩ := stopData_core h
  have hρ : ∀ k (hk : k < sd.col.path.length), sd.col.path[k].1 + 1 =
      (skipLayers E k).cols.length := by
    intro k hk
    obtain ⟨col, p, a1, -, -, a4⟩ := hcont k (by omega)
    rw [List.getElem?_eq_getElem hk, Option.some.injEq] at a4
    rw [a4]
    have : (skipLayers E k).cols ≠ [] := by intro h0; simp [h0] at a1
    have := List.length_pos_of_ne_nil this
    simp only; omega
  obtain ⟨k, hk1, hk2⟩ := rootLayerAux_of_resolveAux sd.r sd.col.col sd.col.path E 0 0
    (sd.depth + 2) [] o hρ (by rw [← hd]; exact hcc) (by omega) (Nat.zero_le _) ho
  unfold rootLayer
  rw [hk2]
  simp at hk1
  simp [hk1]

/-- D1.6c: the reference's scan start is the paper's cursor. -/
theorem rootAppendingStart_of_rootData {E : Forest} {sd : StopData} {rd : RootData}
    (hsd : stopData E = some sd) (hrd : rootData E = some rd) :
    rootAppendingStart ((E.colAt rd.col).getD []) sd.r (sd.Q ++ [(sd.r, Tree.empty)]) sd.t =
      rd.cursor := by
  obtain ⟨-, -, -, hnum, -, -, hcur, -⟩ := rootData_spec hsd hrd
  rw [hcur, rootKeys, queryKeys, hnum, rootAppendingStart, List.dropLast_concat,
    cursor_eq_scanCount]

/-- D1.6c: `ascendReplace` at a nonnegative depth is `Hole.fill`. -/
theorem ascendReplace_ofNat (r d k : Nat) (Z F : Forest) :
    ascendReplace r d (some (k : Int)) Z F = Hole.fill ⟨F, k⟩ r d Z := rfl

/-- D1.6c: the loops agree. -/
theorem iterDown_eq_ordLoop (step : Nat → Forest → Forest) (n : Nat) (Z : Forest) :
    iterDown step n Z = ordLoop step n Z := by
  induction n generalizing Z with
  | zero => rfl
  | succ n ih => exact ih _

/-- D1.6c: agreement on every input where the paper's route stops at a special step. -/
theorem expand_eq_paperOp_special {E : Forest} {sd : StopData} (h : stopData E = some sd)
    (hs : specialStop sd = true) (n : Nat) : expand E n = paperOp E n := by
  obtain ⟨x, xs, hc⟩ := lastCol_of_stopData h
  have hE : E.cols ≠ [] := by intro h0; simp [h0] at hc
  have htl := tailLayer_of_stopData h
  have hsp := isSpecial_of_stopData h
  have hk' : stepKindBody E = some .special := (stepKind_special_iff E).mpr ⟨sd, h, hs⟩
  have hsd' : stopDataBody E = some sd := h
  simp only [paperOp, paperOpBody, hk', hsd']
  rw [← expandSpecial_of_stopData h hs n]
  unfold expand
  split
  · rename_i heq; exact absurd heq hE
  · simp only [htl]
    rw [if_neg (by omega)]
    simp only [Int.toNat_natCast, hsp, hs, if_true]

/-- D1.6c: agreement on every input where the paper's route stops at a non-special step with a
visible root. -/
theorem expand_eq_paperOp_ordinary {E : Forest} {sd : StopData} {o : ColAddr}
    (h : stopData E = some sd) (hs : specialStop sd = false) (ho : sd.col.resolve 0 sd.r = some o)
    (n : Nat) : expand E n = paperOp E n := by
  obtain ⟨x, xs, hc⟩ := lastCol_of_stopData h
  have hE : E.cols ≠ [] := by intro h0; simp [h0] at hc
  obtain ⟨hcc, hd, ht, hlast, -, -, -, hfa, -⟩ := stopData_core h
  have htl := tailLayer_of_stopData h
  have hsp := isSpecial_of_stopData h
  have hk : stepKind E = some .ordinary := (stepKind_ordinary_iff E).mpr ⟨sd, o, h, hs, ho⟩
  obtain ⟨rd, hrd⟩ := Option.isSome_iff_exists.mp (rootData_of_ordinary hk)
  have happ := rootAppendingStart_of_rootData h hrd
  have hlay := rootData_layer_lt h hrd
  have hcurle : rd.cursor ≤ ((E.colAt rd.col).getD []).length := by
    obtain ⟨-, -, -, -, -, -, hcur, -⟩ := rootData_spec h hrd
    rw [hcur]
    have := cursor_le_length (rootKeys E rd) (queryKeys sd)
    simpa [rootKeys] using this
  rw [paperOp_ordinary hk h hrd n]
  obtain ⟨-, o', ho', rfl⟩ := rootData_unpack h hrd
  rw [ho] at ho'; cases ho'
  have hrl := rootLayer_of_resolve h ho
  have htn := tailNum_of_stopData h
  have hra := rootAt_of_stopData h
  obtain ⟨hon, hnum⟩ := (ColAddr.resolve_spec 0 sd.col o sd.r).mp ho
  obtain ⟨F, hF, hlt, hpre, hiff, -⟩ := onStack_route h hon
  have hj : o.path.length ≤ sd.depth := by have := hpre.length_le; omega
  have hFj : skipLayers E o.path.length = F := by
    have h1 := hfa o.path.length hj
    rw [List.prefix_iff_eq_take.mp hpre] at hF
    rw [hF] at h1
    exact (Option.some.inj h1).symm
  have hTail : (skipLayers F (sd.depth - o.path.length)).cols.getLast?.getD [] =
      sd.Q ++ [(sd.r, Tree.empty)] := by
    rw [← hFj, skipLayers_add, Nat.add_sub_cancel' hj, hlast]; rfl
  have hcolAt : (E.colAt o).getD [] = F.cols.getD o.col [] := by
    simp [Tree.colAt, hF, List.getD_eq_getElem?_getD]
  have hrc : (rootOf E sd o).col = o := rfl
  have hlay' : (rootOf E sd o).layer = o.path.length := rfl
  have hidx : (rootOf E sd o).idx = o.col := rfl
  have hown : (rootOf E sd o).owner = (o.col + 1 == F.cols.length) := by simp [rootOf, hF]
  rw [hrc, hcolAt] at happ hcurle
  rw [hlay'] at hlay
  have hordZ : ordZ E sd (rootOf E sd o) n = ordLoop (ordStep sd (rootOf E sd o) F
      ((F.cols.getD o.col []).drop (rootOf E sd o).cursor)) n Tree.empty := by
    simp only [ordZ, hrc, hF, Option.getD_some, hcolAt]
  unfold expand
  split
  · rename_i heq; exact absurd heq hE
  · simp only [htl]
    rw [if_neg (by omega)]
    simp only [Int.toNat_natCast, hsp, hs, Bool.false_eq_true, if_false, htn, hra, hrl]
    rw [if_neg (by omega)]
    simp only [hFj, hTail, happ, List.dropLast_concat, hrc, hcolAt, hordZ, Hole.fill]
    rw [iterDown_eq_ordLoop, iterDown_eq_ordLoop]
    by_cases hO : o.col + 1 = F.cols.length
    · have hb : (o.col != F.cols.length - 1) = false := by simp; omega
      have hown' : (rootOf E sd o).owner = true := by rw [hown]; simpa using hO
      have hjl := hlay hown'
      have hex : ((rootOf E sd o).cursor == (F.cols.getD o.col []).length) =
          ((F.cols.getD o.col []).drop (rootOf E sd o).cursor).isEmpty := by
        rw [Bool.eq_iff_iff, beq_iff_eq, List.isEmpty_iff, List.drop_eq_nil_iff]; omega
      rw [hb, hown', hex]
      simp only [Bool.false_eq_true, if_false, Bool.true_and]
      split_ifs
      · rfl
      · congr 3
        funext k Z
        simp only [ordStep, hown', if_true, hlay', mapLast_eq, List.append_assoc]
        rw [show (sd.depth : Int) - (o.path.length : Int) - 1 =
          ((sd.depth - o.path.length - 1 : Nat) : Int) by omega]
        rfl
    · have hb : (o.col != F.cols.length - 1) = true := by simp; omega
      have hown' : (rootOf E sd o).owner = false := by rw [hown]; simpa using hO
      rw [hb, hown']
      simp only [if_true, Bool.false_and, Bool.false_eq_true, if_false]
      congr 3
      funext k Z
      simp only [ordStep, hown', Bool.false_eq_true, if_false, hlay', hidx]
      rw [show (sd.depth : Int) - (o.path.length : Int) =
        ((sd.depth - o.path.length : Nat) : Int) by omega]
      rfl

/-- D1.6c: under V the root of a stop is visible. -/
theorem resolve_root_of_condV {E : Forest} (hV : CondV E) {sd : StopData} (h : stopData E = some sd) :
    (sd.col.resolve 0 sd.r).isSome := by
  obtain ⟨hcol, -⟩ := stopData_spec h
  have hent : E.entryAt (closingSlot sd) = some (sd.r, Tree.empty) := by
    simp [Tree.entryAt, closingSlot, hcol]
  exact hV _ ((Tree.mem_entryAddrs_iff E _).mpr (by rw [hent]; rfl)) sd.r Tree.empty hent

/-! ### D1.6a — the agreement lemma and the branch contracts (moved from the spine) -/

-- provides: U1, D1.6 (deletion removes the empty last outer column)
-- Moved from `Spine.lean` (its proof uses D1.6b/D1.6c; nothing in between uses it).
theorem expand_deletion {E : Forest} (h : stepKind E = some .deletion) (n : Nat) :
    expand E n = some (.node E.cols.dropLast) := by
  have hc := (stepKind_deletion_iff E).mp h
  have hE : E ≠ Tree.empty := by rintro rfl; simp [Tree.empty, Tree.cols] at hc
  have hneg := (tailLayer_neg_iff hE).mpr hc
  have hne : E.cols ≠ [] := by intro h0; simp [h0] at hc
  unfold expand
  split
  · rename_i heq; exact absurd heq hne
  · simp only [hneg, if_true]

-- provides: U1, D1.6a (G-001: agreement on nonempty V ∧ I inputs)
-- Moved from `Spine.lean` (its proof uses D1.6b/D1.6c; nothing in between uses it).
theorem expand_eq_paperOp {E : Forest} (hE : E ≠ Tree.empty) (hV : CondV E) (hI : CondI E)
    (n : Nat) : expand E n = paperOp E n := by
  have hne : E.cols ≠ [] := by
    obtain ⟨cols⟩ := E
    rintro (h0 : cols = [])
    exact hE (by rw [h0]; rfl)
  obtain ⟨col, hc⟩ : ∃ col, E.cols.getLast? = some col := by
    cases hx : E.cols.getLast? with
    | none => simp at hx; exact absurd hx hne
    | some c => exact ⟨c, rfl⟩
  by_cases hcol : col = []
  · subst hcol
    have hk : stepKind E = some .deletion := (stepKind_deletion_iff E).mpr hc
    rw [expand_deletion hk, paperOp_deletion hk]
  · obtain ⟨sd, hsd⟩ := Option.isSome_iff_exists.mp (stopData_isSome hI hc hcol)
    cases hs : specialStop sd
    · obtain ⟨o, ho⟩ := Option.isSome_iff_exists.mp (resolve_root_of_condV hV hsd)
      exact expand_eq_paperOp_ordinary hsd hs ho n
    · exact expand_eq_paperOp_special hsd hs n

-- provides: U1, D1.6a (on nonempty V ∧ I inputs the paper's route and root lookup are defined)
-- Moved from `Spine.lean` (its proof uses D1.6b/D1.6c; nothing in between uses it).
theorem stepKind_isSome {E : Forest} (hE : E ≠ Tree.empty) (hV : CondV E) (hI : CondI E) :
    (stepKind E).isSome := by
  have hne : E.cols ≠ [] := by
    obtain ⟨cols⟩ := E
    rintro (h0 : cols = [])
    exact hE (by rw [h0]; rfl)
  obtain ⟨col, hc⟩ : ∃ col, E.cols.getLast? = some col := by
    cases hx : E.cols.getLast? with
    | none => simp at hx; exact absurd hx hne
    | some c => exact ⟨c, rfl⟩
  by_cases hcol : col = []
  · subst hcol
    rw [(stepKind_deletion_iff E).mpr hc]; rfl
  · obtain ⟨sd, hsd⟩ := Option.isSome_iff_exists.mp (stopData_isSome hI hc hcol)
    have hr := resolve_root_of_condV hV hsd
    rw [stepKind_of_stopData hsd]
    split_ifs <;> rfl

-- provides: U1, D1.6
-- Moved from `Spine.lean` (its proof uses D1.6b; nothing in between uses it).
theorem ownerEntry_of_special {E : Forest} {sd : StopData} (h : stepKind E = some .special)
    (hsd : stopData E = some sd) : sd.ownerEntry.isSome := by
  obtain ⟨sd', hsd', hs⟩ := (stepKind_special_iff E).mp h
  rw [hsd] at hsd'; cases hsd'
  have hpos : 0 < sd.depth := by
    simp only [specialStop, Bool.and_eq_true, decide_eq_true_eq] at hs; exact hs.1.1
  obtain ⟨oe, -, -, hoe, -⟩ := ownerEntry_data hsd hpos
  rw [hoe]; rfl

/-! ## D2.2a — responses, edges and paths -/

/-- D2.2a: the start `x(c,k)` of the cut-`k` test of column `c` (codex-crosscheck-1 Q2):
`c - 1` at `k = 0`, else the parent of entry `k - 1`. -/
def cutStart (E : Forest) (c : ColAddr) (k : Nat) : Nat :=
  if k = 0 then c.num 0 - 1 else ((parents E c)[k - 1]?).getD 0

/-- D2.2a: condition A at entry `i` of column `c` in key system `ks`. -/
def AAt (E : Forest) (ks : KeySys) (c : ColAddr) (i : Nat) : Prop :=
  ∀ p, (parents E c)[i]? = some p → Path E ks c (cutQuery (ks c) i) (cutStart E c i) p

/-- D2.2a: `CondAK` is `AAt` at every entry. -/
theorem condAK_iff (E : Forest) (ks : KeySys) :
    CondAK E ks ↔ ∀ c ∈ E.colAddrs, ∀ i, AAt E ks c i := Iff.rfl

/-- D2.2a: the (deterministic) response function of an edge read on the stack of `c`. -/
def respEdge (E : Forest) (ks : KeySys) (c : ColAddr) (W : List (WithTop Key)) (x : Nat) :
    Option Nat :=
  (c.resolve 0 x).bind fun o => resp E ks o W

theorem edge_iff (E : Forest) (ks : KeySys) (c : ColAddr) (W : List (WithTop Key)) (x p : Nat) :
    Edge E ks c W x p ↔ respEdge E ks c W x = some p := by
  unfold Edge respEdge
  rw [Option.bind_eq_some_iff]

/-- D2.2a: `resp` in terms of the cursor. -/
theorem resp_eq_some {E : Forest} {ks : KeySys} {o : ColAddr} {W : List (WithTop Key)} {p : Nat} :
    resp E ks o W = some p ↔ ∃ H, ((E.colAt o).getD [])[cursor (ks o) W]? = some (p, H) := by
  unfold resp
  constructor
  · intro h
    obtain ⟨⟨q, H⟩, h1, h2⟩ := Option.map_eq_some_iff.1 h
    exact ⟨H, by rw [h1, show q = p from h2]⟩
  · rintro ⟨H, h⟩
    rw [h]; rfl

/-- D2.2a: the number of keys is the number of entries, for actual and capped systems. -/
theorem length_actualKeys (E : Forest) (c : ColAddr) :
    (actualKeys E c).length = ((E.colAt c).getD []).length := by
  simp [actualKeys]

theorem length_capKeys (E : Forest) (sel : List ColAddr) (c : ColAddr) :
    (capKeys E sel c).length = ((E.colAt c).getD []).length := by
  rw [← length_actualKeys E c]
  simp only [capKeys]
  split_ifs
  · rcases List.eq_nil_or_concat (actualKeys E c) with h | ⟨L, b, h⟩
    · simp [h]
    · simp [h]
  · rfl

-- Moved here from the D1.3a section below (brief rule 5; statement unchanged): `edge_lt` and
-- `cutStart_lt` use it, and nothing in between uses it.
/-- D2.2a: parents of a column, entrywise. -/
theorem parents_getElem? (E : Forest) (c : ColAddr) (k : Nat) :
    (parents E c)[k]? = (E.entryAt ⟨c, k⟩).map Prod.fst := by
  unfold parents Tree.entryAt
  cases E.colAt c <;> simp

/-- D2.2a helper: under V the parent of an entry of column `o` is below `o`'s number. -/
theorem parent_lt_num_of_condV {E : Forest} (hV : CondV E) {o : ColAddr} {k p : Nat} {H : Forest}
    (he : E.entryAt ⟨o, k⟩ = some (p, H)) : p < o.num 0 := by
  have hmem : (⟨o, k⟩ : EntryAddr) ∈ E.entryAddrs :=
    (Tree.mem_entryAddrs_iff E _).2 (by rw [he]; rfl)
  exact ((ColAddr.resolve_isSome_iff 0 o p).1 (hV _ hmem p H he)).2

/-- D2.2a (txt:179-180): under V every edge decreases the column number. -/
theorem edge_lt {E : Forest} (hV : CondV E) {ks : KeySys} {c : ColAddr} {W : List (WithTop Key)}
    {x p : Nat} (h : Edge E ks c W x p) : p < x := by
  obtain ⟨o, ho, hr⟩ := h
  obtain ⟨H, hH⟩ := resp_eq_some.1 hr
  cases hcol : E.colAt o with
  | none => rw [hcol] at hH; simp at hH
  | some col =>
    rw [hcol, Option.getD_some] at hH
    have he : E.entryAt ⟨o, cursor (ks o) W⟩ = some (p, H) := by
      simp [Tree.entryAt, hcol, hH]
    rw [← ColAddr.resolve_num ho]
    exact parent_lt_num_of_condV hV he

/-- D2.2a: paths decrease. -/
theorem path_le {E : Forest} (hV : CondV E) {ks : KeySys} {c : ColAddr} {W : List (WithTop Key)}
    {x y : Nat} (h : Path E ks c W x y) : y ≤ x := by
  induction h with
  | refl => exact le_refl _
  | tail _ he ih => exact le_trans (edge_lt hV he).le ih

/-- D2.2a: the test starts strictly below the tested column. -/
theorem cutStart_lt {E : Forest} (hV : CondV E) {c : ColAddr} (hc : c ∈ E.colAddrs) {k : Nat}
    (hk : k ≤ (parents E c).length) (hpos : 0 < c.num 0) : cutStart E c k < c.num 0 := by
  unfold cutStart
  split
  · omega
  · have hlt : k - 1 < (parents E c).length := by omega
    obtain ⟨p, hp⟩ : ∃ p, (parents E c)[k - 1]? = some p := ⟨_, List.getElem?_eq_getElem hlt⟩
    rw [hp, Option.getD_some]
    rw [parents_getElem?] at hp
    obtain ⟨⟨q, H⟩, he, rfl⟩ := Option.map_eq_some_iff.1 hp
    exact parent_lt_num_of_condV hV he

/-- D2.2a (stack restriction): edges from numbers below `x₀` depend only on the stack below
`x₀`. -/
theorem edge_congr_stack {E : Forest} {ks : KeySys} {c c' : ColAddr} {W : List (WithTop Key)}
    {x₀ x p : Nat} (hst : ∀ q < x₀, c.resolve 0 q = c'.resolve 0 q) (hx : x < x₀) :
    Edge E ks c W x p ↔ Edge E ks c' W x p := by
  unfold Edge; rw [hst x hx]

/-- D2.2a (stack restriction for paths, codex-crosscheck-1 Q2). -/
theorem path_congr_stack {E : Forest} (hV : CondV E) {ks : KeySys} {c c' : ColAddr}
    {W : List (WithTop Key)} {x₀ x y : Nat} (hst : ∀ q < x₀, c.resolve 0 q = c'.resolve 0 q)
    (hx : x < x₀) : Path E ks c W x y ↔ Path E ks c' W x y := by
  have key : ∀ {c c' : ColAddr}, (∀ q < x₀, c.resolve 0 q = c'.resolve 0 q) → ∀ {x : Nat},
      x < x₀ → Path E ks c W x y → Path E ks c' W x y := by
    intro c c' hst x hx h
    revert hx
    induction h using Relation.ReflTransGen.head_induction_on with
    | refl => intro _; exact Relation.ReflTransGen.refl
    | head he _ ih =>
      intro hx
      exact Relation.ReflTransGen.head ((edge_congr_stack hst hx).1 he)
        (ih (lt_trans (edge_lt hV he) hx))
  exact ⟨key hst hx, key (fun q hq => (hst q hq).symm) hx⟩

/-- D2.2a (txt:191-193): A implies parent monotonicity, in every key system. -/
theorem parents_antitone {E : Forest} (hV : CondV E) {ks : KeySys} (hA : CondAK E ks)
    {c : ColAddr} (hc : c ∈ E.colAddrs) {i p q : Nat} (hi : (parents E c)[i + 1]? = some p)
    (hq : (parents E c)[i]? = some q) : p ≤ q := by
  have := hA c hc (i + 1) p hi
  simp only [Nat.add_one_ne_zero, if_false, Nat.add_sub_cancel, hq, Option.getD_some] at this
  exact path_le hV this

/-! ## D1.3a, D2.3a — the conditions in usable form -/

/-- D1.3a: V is "every parent is smaller than its column's printed number" (every smaller
number is visible, `resolve_isSome_iff`). -/
theorem condV_iff_lt (E : Forest) :
    CondV E ↔ ∀ e ∈ E.entryAddrs, ∀ p h, E.entryAt e = some (p, h) → p < e.col.num 0 := by
  simp only [CondV, ColAddr.resolve_isSome_iff, Nat.zero_le, true_and]

-- D2.2a `parents_getElem?` moved up, before `edge_lt` (brief rule 5).

/-- D2.3a: an owner return is a contained column whose entry's parent resolves to the owner
column (definitional unfolding with `Contains`). -/
theorem isOwnerReturn_iff (E : Forest) (e₀ e : EntryAddr) :
    IsOwnerReturn E e₀ e ↔ e₀.Contains e.col ∧
      ∃ q J, E.entryAt e = some (q, J) ∧ e.col.resolve 0 q = some e₀.col := Iff.rfl

/-- D2.3a: an entry of a contained column whose parent is the host number is an owner return. -/
theorem isOwnerReturn_of_parent {E : Forest} {e₀ : EntryAddr} {c : ColAddr} {k : Nat} {J : Forest}
    (hc : e₀.Contains c) (hk : E.entryAt ⟨c, k⟩ = some (e₀.col.num 0, J)) :
    IsOwnerReturn E e₀ ⟨c, k⟩ :=
  ⟨hc, e₀.col.num 0, J, hk, EntryAddr.resolve_host hc⟩

/-! ## L2.2a — the path-nesting induction (G-006) -/

/-- L2.2a: the path-nesting predicate at source number `x`, quantified over every stack owner
`c` (all occurrences and scopes simultaneously, codex-crosscheck-1 Q2). -/
def NestPred (E : Forest) (ks : KeySys) (x : Nat) : Prop :=
  ∀ (c : ColAddr) (W Z : List (WithTop Key)) (p : Nat), Noninc W → Noninc Z → W ≤ Z →
    Edge E ks c Z x p → Path E ks c W x p

/-- L2.2a helper: under V, a parent of a column is below the column's printed number. -/
theorem parent_lt_num {E : Forest} (hV : CondV E) {o : ColAddr} {k q : Nat}
    (h : (parents E o)[k]? = some q) : q < o.num 0 := by
  rw [parents_getElem?, Option.map_eq_some_iff] at h
  obtain ⟨⟨q', H⟩, hq, rfl⟩ := h
  have hmem : (⟨o, k⟩ : EntryAddr) ∈ E.entryAddrs := by
    rw [Tree.mem_entryAddrs_iff, hq]; rfl
  exact ((ColAddr.resolve_isSome_iff 0 o q').1 (hV _ hmem q' H hq)).2

/-- L2.2a helper: a response is the parent of the entry at the cursor. -/
theorem resp_eq_parents (E : Forest) (ks : KeySys) (o : ColAddr) (W : List (WithTop Key)) :
    resp E ks o W = (parents E o)[cursor (ks o) W]? := by
  simp [resp, parents]

/-- L2.2a helper: a `Y`-path from `s` is a `W`-path once every `Y`-edge from a source `≤ s` is
replaced by a `W`-path (under V every vertex of the path is `≤ s`). -/
theorem path_replace {E : Forest} (hV : CondV E) {ks : KeySys} {c : ColAddr}
    {Y W : List (WithTop Key)} {s t : Nat}
    (hrep : ∀ y ≤ s, ∀ y', Edge E ks c Y y y' → Path E ks c W y y')
    (h : Path E ks c Y s t) : Path E ks c W s t := by
  have key : ∀ a, Path E ks c Y a t → a ≤ s → Path E ks c W a t := by
    intro a ha
    induction ha using Relation.ReflTransGen.head_induction_on with
    | refl => intro _; exact Relation.ReflTransGen.refl
    | head hab _ ihb =>
      intro has
      exact (hrep _ has _ hab).trans (ihb (le_trans (le_of_lt (edge_lt hV hab)) has))
  exact key s h le_rfl

/-- L2.2a: the induction step (strong induction on `x`). -/
theorem nestPred_step {E : Forest} (hV : CondV E) {ks : KeySys} (hA : CondAK E ks) (x : Nat)
    (ih : ∀ y < x, NestPred E ks y) : NestPred E ks x := by
  intro c W Z p hW hZ hWZ hedge
  obtain ⟨o, ho, hresp⟩ := hedge
  have hox : o.num 0 = x := ColAddr.resolve_num ho
  rw [resp_eq_parents] at hresp
  have hji : cursor (ks o) W ≤ cursor (ks o) Z := cursor_mono (ks o) hW hZ hWZ
  have hil : cursor (ks o) Z ≤ (ks o).length := cursor_le_length _ _
  have hoE : o ∈ E.colAddrs := by
    rw [Tree.mem_colAddrs_iff]
    cases h : E.colAt o with
    | none => simp [parents, h] at hresp
    | some _ => rfl
  have hst : ∀ q < x, o.resolve 0 q = c.resolve 0 q := fun q hq =>
    ColAddr.resolve_of_resolve_lt ho hq
  -- the chain `x → p_j ⇝ p_{j+1} ⇝ … ⇝ p_{j+m}`
  have claim : ∀ m, cursor (ks o) W + m ≤ cursor (ks o) Z → ∀ q,
      (parents E o)[cursor (ks o) W + m]? = some q → Path E ks c W x q := by
    intro m
    induction m with
    | zero =>
      intro _ q hq
      refine Relation.ReflTransGen.single ⟨o, ho, ?_⟩
      rw [resp_eq_parents]; simpa using hq
    | succ m ihm =>
      intro hm q hq
      set j := cursor (ks o) W
      have hlt : j + m < (parents E o).length := by
        have := (List.getElem?_eq_some_iff.1 hq).1; omega
      obtain ⟨q', hq'⟩ : ∃ q', (parents E o)[j + m]? = some q' :=
        ⟨_, List.getElem?_eq_getElem hlt⟩
      have hpath := hA o hoE (j + m + 1) q (by simpa [Nat.add_assoc] using hq)
      simp only [Nat.add_one_ne_zero, if_false, Nat.add_sub_cancel, hq', Option.getD_some] at hpath
      have hq'x : q' < x := hox ▸ parent_lt_num hV hq'
      rw [path_congr_stack hV hst hq'x] at hpath
      have hjlen : j < (ks o).length := by omega
      have hWY : W ≤ cutQuery (ks o) (j + m + 1) :=
        le_trans (le_of_lt ((cursor_spec (ks o) W hW).2 hjlen))
          (cutQuery_mono (ks o) (by omega))
      refine (ihm (by omega) q' hq').trans (path_replace hV ?_ hpath)
      intro y hy y' he
      exact ih y (lt_of_le_of_lt hy hq'x) c W _ y' hW (cutQuery_noninc _ _) hWY he
  have := claim (cursor (ks o) Z - cursor (ks o) W) (by omega) p
  rw [Nat.add_sub_cancel' hji] at this
  exact this hresp

/-- L2.2a. -/
theorem nestPred_all {E : Forest} (hV : CondV E) {ks : KeySys} (hA : CondAK E ks) (x : Nat) :
    NestPred E ks x := by
  induction x using Nat.strong_induction_on with
  | _ x ih => exact nestPred_step hV hA x ih

-- Moved here from `Plan/Spine.lean` (brief rule 5): its proof needs `nestPred_all`; nothing in
-- between uses it. Statement unchanged.
-- provides: U1, L2.2 (path nesting)
theorem path_nesting {E : Forest} {ks : KeySys} (hV : CondV E) (hA : CondAK E ks) (c : ColAddr)
    {W Z : List (WithTop Key)} (hW : W.Pairwise fun x y => y ≤ x)
    (hZ : Z.Pairwise fun x y => y ≤ x) (hWZ : W ≤ Z) {x p : Nat} (h : Edge E ks c Z x p) :
    Path E ks c W x p :=
  nestPred_all hV hA x c W Z p hW hZ hWZ h

/-! ## L2.3, L2.3a — the barrier (G-006 predicates) -/

/-- L2.3a: `C_e(c,k)`: an actual cut-`k` path of column `c` that reaches the host `a` of the
containing entry `e` has query strictly below `D_e = B_a(u)` (codex-crosscheck-1 Q2). -/
def CutBound (E : Forest) (e : EntryAddr) (c : ColAddr) (k : Nat) : Prop :=
  Path E (actualKeys E) c (cutQuery (actualKeys E c) k) (cutStart E c k) (e.col.num 0) →
    cutQuery (actualKeys E c) k < boundary (actualKeys E e.col) e.idx

/-- L2.3a: `R_e(c,k)`: if entry `k` of `c` returns to the host of `e`, then `B_c(k) < D_e`. -/
def ReturnBound (E : Forest) (e : EntryAddr) (c : ColAddr) (k : Nat) : Prop :=
  (parents E c)[k]? = some (e.col.num 0) →
    boundary (actualKeys E c) k < boundary (actualKeys E e.col) e.idx

/-- L2.3a helper: an entry containing a column of `E` is an entry of `E`. -/
theorem mem_entryAddrs_of_contains {E : Forest} {e : EntryAddr} {c : ColAddr}
    (hc : c ∈ E.colAddrs) (hec : e.Contains c) : e ∈ E.entryAddrs := by
  rw [Tree.mem_colAddrs_iff] at hc
  rw [Tree.mem_entryAddrs_iff]
  obtain ⟨rest, hrest⟩ := hec
  unfold Tree.colAt at hc
  rw [← hrest, Tree.forestAt_append, Tree.forestAt_heightPath] at hc
  unfold Tree.heightAt at hc
  cases h : E.entryAt e <;> simp_all

/-- L2.3a helper: the index of an entry is below the length of its column. -/
theorem idx_lt_of_mem_entryAddrs {E : Forest} {e : EntryAddr} (he : e ∈ E.entryAddrs) :
    e.idx < ((E.colAt e.col).getD []).length := by
  rw [Tree.mem_entryAddrs_iff, Option.isSome_iff_exists] at he
  obtain ⟨x, hx⟩ := he
  obtain ⟨col, hcol, hx⟩ := Tree.colAt_of_entryAt hx
  rw [hcol, Option.getD_some]
  exact (List.getElem?_eq_some_iff.1 hx).1

/-- L2.3a helper: a column with a parent at some index is a column of `E`. -/
theorem mem_colAddrs_of_parents {E : Forest} {o : ColAddr} {k q : Nat}
    (h : (parents E o)[k]? = some q) : o ∈ E.colAddrs := by
  rw [Tree.mem_colAddrs_iff]
  cases hc : E.colAt o with
  | none => simp [parents, hc] at h
  | some _ => rfl

/-- L2.3a: the empty cut is below every boundary of an entry. -/
theorem cutBound_zero {E : Forest} {e : EntryAddr} (he : e ∈ E.entryAddrs) (c : ColAddr) :
    CutBound E e c 0 := by
  intro _
  rw [cutQuery_zero]
  have hlen : e.idx < (actualKeys E e.col).length := by
    rw [length_actualKeys]; exact idx_lt_of_mem_entryAddrs he
  obtain ⟨x, l, hxl⟩ := List.exists_cons_of_ne_nil (boundary_ne_nil hlen)
  rw [hxl]; exact List.nil_lt_cons x l

/-- L2.3a (localized pre-entry-cut barrier): `C_e(c,k)` follows from the return bounds at
smaller column numbers inside `H_e` and at earlier entries of `c`; no A at `(c,k)` is used. -/
theorem cutBound_of_returns {E : Forest} (hV : CondV E) {e : EntryAddr} (he : e ∈ E.entryAddrs)
    {c : ColAddr} (hc : c ∈ E.colAddrs) (hec : e.Contains c) {k : Nat}
    (hk : k ≤ (parents E c).length)
    (hlow : ∀ o ∈ E.colAddrs, e.Contains o → o.num 0 < c.num 0 → ∀ v, ReturnBound E e o v)
    (hprev : ∀ k' < k, ReturnBound E e c k') : CutBound E e c k := by
  rcases Nat.eq_zero_or_pos k with rfl | hkpos
  · exact cutBound_zero he c
  intro hpath
  rcases Relation.ReflTransGen.cases_tail hpath with hxa | ⟨z, -, hza⟩
  · -- the path is reflexive: the preceding entry returns to the host
    have hk1 : k - 1 < (parents E c).length := by omega
    have hpk : (parents E c)[k - 1]? = some (e.col.num 0) := by
      rw [List.getElem?_eq_getElem hk1]
      simp only [cutStart, Nat.pos_iff_ne_zero.1 hkpos, if_false,
        List.getElem?_eq_getElem hk1, Option.getD_some] at hxa
      rw [hxa]
    have := hprev (k - 1) (by omega) hpk
    rwa [boundary_eq_cutQuery, Nat.sub_add_cancel hkpos] at this
  · obtain ⟨o, hzo, hresp⟩ := hza
    have haz : e.col.num 0 < z := edge_lt hV ⟨o, hzo, hresp⟩
    have heo : e.Contains o := EntryAddr.contains_of_resolve hec hzo haz
    have hoz : o.num 0 = z := ColAddr.resolve_num hzo
    have hzc : z < c.num 0 := ColAddr.resolve_lt hzo
    rw [resp_eq_parents] at hresp
    have hoE : o ∈ E.colAddrs := mem_colAddrs_of_parents hresp
    have hv : cursor (actualKeys E o) (cutQuery (actualKeys E c) k) < (actualKeys E o).length := by
      rw [length_actualKeys]
      have := (List.getElem?_eq_some_iff.1 hresp).1
      simpa [parents] using this
    have h1 := (cursor_spec (actualKeys E o) _ (cutQuery_noninc _ _)).2 hv
    have h2 := hlow o hoE heo (hoz ▸ hzc) _ hresp
    rw [boundary_eq_cutQuery] at h2
    exact lt_trans h1 h2

/-- L2.3a: the return step: `C_e(c,k)`, actual A at `(c,k)` and S give `R_e(c,k)`. -/
theorem returnBound_of_cutBound {E : Forest} (hS : CondS E) {e : EntryAddr}
    (he : e ∈ E.entryAddrs) {c : ColAddr} (hc : c ∈ E.colAddrs) (hec : e.Contains c) {k : Nat}
    (hA : AAt E (actualKeys E) c k) (hcut : CutBound E e c k) : ReturnBound E e c k := by
  intro hpk
  have hW := hcut (hA _ hpk)
  rw [parents_getElem?, Option.map_eq_some_iff] at hpk
  obtain ⟨⟨q, J⟩, hent, hq⟩ := hpk
  simp only at hq
  subst hq
  have hret : IsOwnerReturn E e ⟨c, k⟩ := isOwnerReturn_of_parent hec hent
  have hmem : (⟨c, k⟩ : EntryAddr) ∈ E.entryAddrs := by
    rw [Tree.mem_entryAddrs_iff, hent]; rfl
  have hKS := hS e he ⟨c, k⟩ hmem hret
  obtain ⟨col, hcol, hck⟩ := Tree.colAt_of_entryAt hent
  have hkc : k < (actualKeys E c).length := by
    rw [length_actualKeys, hcol, Option.getD_some]; exact (List.getElem?_eq_some_iff.1 hck).1
  have hu : e.idx < (actualKeys E e.col).length := by
    rw [length_actualKeys]; exact idx_lt_of_mem_entryAddrs he
  refine boundary_lt_of_cut hkc hu hW ?_
  have hck' : (actualKeys E c)[k] = ((relKey (c.num 0) J : Key) : WithTop Key) := by
    obtain ⟨_, heq⟩ := List.getElem?_eq_some_iff.1 hck
    simp [actualKeys, hcol, heq]
  rw [Tree.mem_entryAddrs_iff, Option.isSome_iff_exists] at he
  obtain ⟨⟨pe, He⟩, hente⟩ := he
  obtain ⟨cole, hcole, hcke⟩ := Tree.colAt_of_entryAt hente
  have hue : (actualKeys E e.col)[e.idx] = ((relKey (e.col.num 0) He : Key) : WithTop Key) := by
    obtain ⟨_, heq⟩ := List.getElem?_eq_some_iff.1 hcke
    simp [actualKeys, hcole, heq]
  rw [hck', hue, WithTop.coe_lt_coe]
  simpa [Tree.heightAt, hent, hente] using hKS

/-- L2.3a: the joint barrier predicate at `(c, k)` for the containing entry `e`. -/
def BarPred (E : Forest) (e : EntryAddr) (c : ColAddr) (k : Nat) : Prop :=
  CutBound E e c k ∧ ReturnBound E e c k

/-- L2.3a: the lexicographic induction step on `(c.num 0, k)`. -/
theorem barPred_step {E : Forest} (hV : CondV E) (hA : CondA E) (hS : CondS E) {e : EntryAddr}
    (he : e ∈ E.entryAddrs) {c : ColAddr} (hc : c ∈ E.colAddrs) (hec : e.Contains c) {k : Nat}
    (hk : k ≤ (parents E c).length)
    (ihlow : ∀ o ∈ E.colAddrs, e.Contains o → o.num 0 < c.num 0 →
      ∀ v ≤ (parents E o).length, BarPred E e o v)
    (ihprev : ∀ k' < k, BarPred E e c k') : BarPred E e c k := by
  have hcut : CutBound E e c k := by
    refine cutBound_of_returns hV he hc hec hk ?_ (fun k' hk' => (ihprev k' hk').2)
    intro o ho heo hlt v
    by_cases hv : v ≤ (parents E o).length
    · exact (ihlow o ho heo hlt v hv).2
    · intro h
      rw [List.getElem?_eq_none (by omega)] at h
      cases h
  exact ⟨hcut, returnBound_of_cutBound hS he hc hec ((condAK_iff _ _).1 hA c hc k) hcut⟩

/-- L2.3a: the joint induction on `(c.num 0, k)`, all occurrences and scopes simultaneously. -/
theorem barrier_joint {E : Forest} (hV : CondV E) (hA : CondA E) (hS : CondS E) {e : EntryAddr}
    (he : e ∈ E.entryAddrs) {c : ColAddr} (hc : c ∈ E.colAddrs) (hec : e.Contains c) {k : Nat}
    (hk : k ≤ (parents E c).length) : CutBound E e c k ∧ ReturnBound E e c k := by
  suffices H : ∀ N, ∀ c ∈ E.colAddrs, c.num 0 = N → e.Contains c →
      ∀ k ≤ (parents E c).length, BarPred E e c k from H _ c hc rfl hec k hk
  intro N
  induction N using Nat.strong_induction_on with
  | _ N ihN =>
    intro c hc hN hec k
    induction k using Nat.strong_induction_on with
    | _ k ihk =>
      intro hk
      exact barPred_step hV hA hS he hc hec hk
        (fun o ho heo hlt v hv => ihN _ (hN ▸ hlt) o ho rfl heo v hv)
        (fun k' hk' => ihk k' hk' (by omega))

/-- L2.3 (`barrier`†, txt:205-207): at an owner return, `B_c(v) < B_a(u)`. -/
theorem barrier {E : Forest} (hV : CondV E) (hA : CondA E) (hS : CondS E) {e₀ e : EntryAddr}
    (he₀ : e₀ ∈ E.entryAddrs) (he : e ∈ E.entryAddrs) (hret : IsOwnerReturn E e₀ e) :
    boundary (actualKeys E e.col) e.idx < boundary (actualKeys E e₀.col) e₀.idx := by
  obtain ⟨hcont, q, J, hent, hres⟩ := (isOwnerReturn_iff E e₀ e).1 hret
  have hq : e₀.col.num 0 = q := ColAddr.resolve_num hres
  subst hq
  have hpk : (parents E e.col)[e.idx]? = some (e₀.col.num 0) := by
    rw [parents_getElem?, hent]; rfl
  have hcE : e.col ∈ E.colAddrs := mem_colAddrs_of_parents hpk
  have hk : e.idx ≤ (parents E e.col).length :=
    le_of_lt (List.getElem?_eq_some_iff.1 hpk).1
  exact (barrier_joint hV hA hS he₀ hcE hcont hk).2 hpk

/-- L2.3 (`cut_barrier`†, txt:207-209): at any complete cut, including the full cut after the
last entry, a read of an active containing entry by the cut's ancestor path has query strictly
below that entry's boundary. -/
theorem cut_barrier {E : Forest} (hV : CondV E) (hA : CondA E) (hS : CondS E) {e : EntryAddr}
    (he : e ∈ E.entryAddrs) {c : ColAddr} (hc : c ∈ E.colAddrs) (hec : e.Contains c) {k : Nat}
    (hk : k ≤ (parents E c).length)
    (hpath : Path E (actualKeys E) c (cutQuery (actualKeys E c) k) (cutStart E c k) (e.col.num 0)) :
    cutQuery (actualKeys E c) k < boundary (actualKeys E e.col) e.idx :=
  (barrier_joint hV hA hS he hc hec hk).1 hpath

/-! ## L2.4, L2.4a, L2.4b — independent capping (G-006) -/

/-- L2.4b: an unselected column keeps its actual keys. -/
theorem capKeys_of_not_mem {E : Forest} {sel : List ColAddr} {c : ColAddr} (h : c ∉ sel) :
    capKeys E sel c = actualKeys E c := by
  simp [capKeys, h]

/-- L2.4b (txt:222, point 1 of codex Q2): no entry query contains a capped last key. -/
theorem cutQuery_capKeys (E : Forest) (sel : List ColAddr) (c : ColAddr) {i : Nat}
    (hi : i < ((E.colAt c).getD []).length) :
    cutQuery (capKeys E sel c) i = cutQuery (actualKeys E c) i := by
  by_cases hc : c ∈ sel
  · have hi' : i < (actualKeys E c).length := by rwa [length_actualKeys]
    simp only [cutQuery, capKeys, hc, if_true]
    congr 1
    rw [List.take_append_of_le_length (by rw [List.length_dropLast]; omega),
      List.dropLast_eq_take, List.take_take, Nat.min_eq_left (by omega)]
  · rw [capKeys_of_not_mem hc]

/-- L2.4b: a capped column whose actual scan is not exhausted gives the actual response
(L2.5 (2)). -/
theorem resp_capKeys {E : Forest} {sel : List ColAddr} {o : ColAddr} {W : List (WithTop Key)}
    (hnx : cursor (actualKeys E o) W < (actualKeys E o).length) :
    resp E (capKeys E sel) o W = resp E (actualKeys E) o W := by
  by_cases ho : o ∈ sel
  · have hne : actualKeys E o ≠ [] := by
      intro h; rw [h] at hnx; simp at hnx
    have hks : capKeys E sel o = (actualKeys E o).dropLast ++ [⊤] := by
      obtain ⟨y, hy⟩ := Option.ne_none_iff_exists'.1 (mt List.getLast?_eq_none_iff.1 hne)
      simp [capKeys, ho, hy]
    have := cursor_eq_of_trace_eq (trace_cap_top hne hnx)
    simp only [resp, hks, this]
  · simp only [resp, capKeys_of_not_mem ho]

/-- L2.4b (point 2 of codex Q2): a route column visible from a column of `E` contains it. -/
theorem routeCols_visible {E : Forest} {c a : ColAddr} {z : Nat} (hc : c ∈ E.colAddrs)
    (ha : a ∈ routeCols E) (hres : c.resolve 0 z = some a) :
    ∃ v, (⟨a, v⟩ : EntryAddr) ∈ E.entryAddrs ∧ (⟨a, v⟩ : EntryAddr).Contains c := by
  obtain ⟨hst, -⟩ := (ColAddr.resolve_spec 0 c a z).1 hres
  obtain ⟨-, F, hF, hFl⟩ := (Scan.mem_routeCols_iff E a).1 ha
  have hcol := hc
  rw [Tree.mem_colAddrs_iff, Option.isSome_iff_exists] at hcol
  obtain ⟨col, hcol⟩ := hcol
  rcases hst with ⟨k, ck, ik, hk, hap, hle⟩ | ⟨hap, hlt⟩
  · have hk' : k < c.path.length := (List.getElem?_eq_some_iff.1 hk).1
    have htake : c.path.take (k + 1) = a.path ++ [(ck, ik)] := by
      rw [List.take_add_one, hk, hap]; rfl
    have hG : (E.forestAt (c.path.take (k + 1))).isSome := by
      unfold Tree.colAt at hcol
      rw [← List.take_append_drop (k + 1) c.path, Tree.forestAt_append] at hcol
      cases h : E.forestAt (c.path.take (k + 1)) with
      | none => rw [h] at hcol; simp at hcol
      | some _ => rfl
    rw [htake, Tree.forestAt_append, hF, Option.bind_some, Tree.forestAt_cons] at hG
    have hck : ck < F.cols.length := by
      cases h : F.cols[ck]? with
      | none => rw [h] at hG; simp at hG
      | some _ => exact (List.getElem?_eq_some_iff.1 h).1
    have hac : a.col = ck := by omega
    have hcont : (⟨a, ik⟩ : EntryAddr).Contains c := by
      show a.path ++ [(a.col, ik)] <+: c.path
      rw [hac, ← htake]
      exact List.take_prefix _ _
    exact ⟨ik, mem_entryAddrs_of_contains hc hcont, hcont⟩
  · exfalso
    unfold Tree.colAt at hcol
    rw [← hap, hF, Option.bind_some] at hcol
    have := (List.getElem?_eq_some_iff.1 hcol).1
    omega

/-- L2.4b helper (the edge step of items 5 and L2.4a item 1): along an actual cut path whose
containing entries satisfy their cut bounds, the capped and actual responses at the reached
vertex agree. -/
theorem resp_cap_eq_of_path {E : Forest} {sel : List ColAddr}
    (hsel : ∀ a ∈ sel, a ∈ routeCols E) {c : ColAddr} (hc : c ∈ E.colAddrs) {k : Nat}
    (hcut : ∀ e ∈ E.entryAddrs, e.Contains c → CutBound E e c k) {z : Nat}
    (hz : Path E (actualKeys E) c (cutQuery (actualKeys E c) k) (cutStart E c k) z)
    {o : ColAddr} (ho : c.resolve 0 z = some o) :
    resp E (capKeys E sel) o (cutQuery (actualKeys E c) k) =
      resp E (actualKeys E) o (cutQuery (actualKeys E c) k) := by
  by_cases hos : o ∈ sel
  · obtain ⟨v, hv, hvc⟩ := routeCols_visible hc (hsel o hos) ho
    have hoz : o.num 0 = z := ColAddr.resolve_num ho
    have hb := hcut _ hv hvc (hoz ▸ hz)
    rw [boundary_eq_cutQuery] at hb
    have hvl : v < (actualKeys E o).length := by
      rw [length_actualKeys]; exact idx_lt_of_mem_entryAddrs hv
    exact resp_capKeys
      (lt_of_le_of_lt (cursor_le_of_lt_cutQuery (cutQuery_noninc _ _) hvl hb) hvl)
  · simp only [resp, capKeys_of_not_mem hos]

/-- L2.4b: at a cut whose containing entries satisfy their cut bounds, actual paths are capped
paths (forward direction). -/
theorem capped_path_of_actual {E : Forest} (hV : CondV E) {sel : List ColAddr}
    (hsel : ∀ a ∈ sel, a ∈ routeCols E) {c : ColAddr} (hc : c ∈ E.colAddrs) {k : Nat}
    (hcut : ∀ e ∈ E.entryAddrs, e.Contains c → CutBound E e c k) {y : Nat}
    (h : Path E (actualKeys E) c (cutQuery (actualKeys E c) k) (cutStart E c k) y) :
    Path E (capKeys E sel) c (cutQuery (actualKeys E c) k) (cutStart E c k) y := by
  induction h with
  | refl => exact Relation.ReflTransGen.refl
  | tail hxz hzy ih =>
    obtain ⟨o, ho, hr⟩ := hzy
    exact ih.tail ⟨o, ho, (resp_cap_eq_of_path hsel hc hcut hxz ho).trans hr⟩

/-- L2.4a (first divergence): under the same cut bounds, capped paths are actual paths. -/
theorem actual_path_of_capped {E : Forest} (hV : CondV E) {sel : List ColAddr}
    (hsel : ∀ a ∈ sel, a ∈ routeCols E) {c : ColAddr} (hc : c ∈ E.colAddrs) {k : Nat}
    (hcut : ∀ e ∈ E.entryAddrs, e.Contains c → CutBound E e c k) {y : Nat}
    (h : Path E (capKeys E sel) c (cutQuery (actualKeys E c) k) (cutStart E c k) y) :
    Path E (actualKeys E) c (cutQuery (actualKeys E c) k) (cutStart E c k) y := by
  induction h with
  | refl => exact Relation.ReflTransGen.refl
  | tail _ hzy ih =>
    obtain ⟨o, ho, hr⟩ := hzy
    exact ih.tail ⟨o, ho, (resp_cap_eq_of_path hsel hc hcut ih ho).symm.trans hr⟩

/-- L2.4: forward capping. -/
theorem capping_forward {E : Forest} (hV : CondV E) (hA : CondA E) (hS : CondS E)
    {sel : List ColAddr} (hsel : ∀ a ∈ sel, a ∈ routeCols E) : CondAK E (capKeys E sel) := by
  rw [condAK_iff]
  intro c hc i p hp
  have hi : i < ((E.colAt c).getD []).length := by
    have := (List.getElem?_eq_some_iff.1 hp).1
    simpa [parents] using this
  rw [cutQuery_capKeys E sel c hi]
  exact capped_path_of_actual hV hsel hc
    (fun e he hec => (barrier_joint hV hA hS he hc hec (by simpa [parents] using hi.le)).1)
    ((condAK_iff _ _).1 hA c hc i p hp)

/-- L2.4a: the reverse-capping predicate at `(c, i)`: actual A at entry `i` together with the
actual return bounds of that entry for every containing entry (codex-crosscheck-1 Q2). -/
def RevPred (E : Forest) (c : ColAddr) (i : Nat) : Prop :=
  AAt E (actualKeys E) c i ∧ ∀ e ∈ E.entryAddrs, e.Contains c → ReturnBound E e c i

/-- L2.4a: the lexicographic induction step on `(c.num 0, i)`. -/
theorem revPred_step {E : Forest} (hV : CondV E) (hS : CondS E) {sel : List ColAddr}
    (hsel : ∀ a ∈ sel, a ∈ routeCols E) (hA : CondAK E (capKeys E sel)) {c : ColAddr}
    (hc : c ∈ E.colAddrs) (i : Nat)
    (ihlow : ∀ o ∈ E.colAddrs, o.num 0 < c.num 0 → ∀ v, RevPred E o v)
    (ihprev : ∀ i' < i, RevPred E c i') : RevPred E c i := by
  by_cases hi : i < (parents E c).length
  · have hcut : ∀ e ∈ E.entryAddrs, e.Contains c → CutBound E e c i := fun e he hec =>
      cutBound_of_returns hV he hc hec hi.le
        (fun o ho heo hlt v => (ihlow o ho hlt v).2 e he heo)
        (fun k' hk' => (ihprev k' hk').2 e he hec)
    have hAA : AAt E (actualKeys E) c i := by
      intro p hp
      have hcap := (condAK_iff _ _).1 hA c hc i p hp
      rw [cutQuery_capKeys E sel c (by simpa [parents] using hi)] at hcap
      exact actual_path_of_capped hV hsel hc hcut hcap
    exact ⟨hAA, fun e he hec => returnBound_of_cutBound hS he hc hec hAA (hcut e he hec)⟩
  · have hnone : (parents E c)[i]? = none := List.getElem?_eq_none (by omega)
    refine ⟨fun p hp => ?_, fun e _ _ hp => ?_⟩ <;> rw [hnone] at hp <;> cases hp

/-- L2.4a: the reverse joint induction on `(c.num 0, i)`: actual A together with the actual
return bounds. -/
theorem capping_reverse_joint {E : Forest} (hV : CondV E) (hS : CondS E) {sel : List ColAddr}
    (hsel : ∀ a ∈ sel, a ∈ routeCols E) (hA : CondAK E (capKeys E sel)) {c : ColAddr}
    (hc : c ∈ E.colAddrs) (i : Nat) :
    AAt E (actualKeys E) c i ∧ ∀ e ∈ E.entryAddrs, e.Contains c → ReturnBound E e c i := by
  suffices H : ∀ N, ∀ c ∈ E.colAddrs, c.num 0 = N → ∀ i, RevPred E c i from H _ c hc rfl i
  intro N
  induction N using Nat.strong_induction_on with
  | _ N ihN =>
    intro c hc hN i
    induction i using Nat.strong_induction_on with
    | _ i ihi =>
      exact revPred_step hV hS hsel hA hc i (fun o ho hlt v => ihN _ (hN ▸ hlt) o ho rfl v) ihi

/-- L2.4a: reverse capping. -/
theorem capping_reverse {E : Forest} (hV : CondV E) (hS : CondS E) {sel : List ColAddr}
    (hsel : ∀ a ∈ sel, a ∈ routeCols E) (hA : CondAK E (capKeys E sel)) : CondA E :=
  (condAK_iff _ _).2 fun _ hc i => (capping_reverse_joint hV hS hsel hA hc i).1

/-- L2.4 (`capping_iff`†, txt:223-224): on V, S inputs, A is equivalent to A in every
independently capped system on the terminal route. -/
theorem capping_iff {E : Forest} (hV : CondV E) (hS : CondS E) {sel : List ColAddr}
    (hsel : ∀ a ∈ sel, a ∈ routeCols E) : CondA E ↔ CondAK E (capKeys E sel) :=
  ⟨fun hA => capping_forward hV hA hS hsel, capping_reverse hV hS hsel⟩

/-! ## L2.4c — every operation is defined on V, I, A, S -/

/-- L2.4c (txt:232-236): the owner root scan is not exhausted. -/
theorem owner_root_nonexhaust {E : Forest} (hV : CondV E) (hA : CondA E) (hS : CondS E)
    {sd : StopData} {rd : RootData} (hsd : stopData E = some sd) (hrd : rootData E = some rd)
    (ho : rd.owner = true) : rd.cursor < ((E.colAt rd.col).getD []).length := by sorry

/-- L2.4c: the paper's operation is defined on nonempty V, I, A, S inputs. -/
theorem paperOp_isSome {E : Forest} (hE : E ≠ Tree.empty) (hV : CondV E) (hI : CondI E)
    (hA : CondA E) (hS : CondS E) (n : Nat) : (paperOp E n).isSome := by sorry

/-- L2.4c (task form of `expand_isSome`). -/
theorem expand_ne_none {E : Forest} (hV : CondV E) (hI : CondI E) (hA : CondA E) (hS : CondS E)
    (n : Nat) : expand E n ≠ none := by sorry

/-- L2.4c: every operation on the class L is defined. -/
theorem inL_expand_ne_none {E : Forest} (h : InL E) (n : Nat) : expand E n ≠ none := by sorry

end Scan

/-! ## D1.7a — seeds and generation witnesses -/

theorem seed_ne_empty (m : Nat) : seed m ≠ Tree.empty := by
  cases m <;> simp [seed, Tree.empty]

/-- D1.7a: the seed's columns (txt:139-140): `L_0 = ()`, `L_{m+1} = (0)` followed by the branch. -/
theorem seed_cols (m : Nat) : (seed m).cols = if m = 0 then [[]] else [[], branch 0 (m - 1)] := by
  cases m <;> simp [seed, Tree.cols]

/-- D1.7a: the branch has singleton columns with parents `i, i+1, …`. -/
theorem branch_spec (i k : Nat) :
    branch i k = [(i, if k = 0 then Tree.empty else .node [branch (i + 1) (k - 1)])] := by
  cases k <;> simp [branch]

/-- D1.7a helper: running a witness from a standard expression stays standard. -/
theorem isStd_foldlM {E : Forest} :
    ∀ (ns : List Nat) (F : Forest), IsStd F →
      ns.foldlM (fun F n => expand F n) F = some E → IsStd E
  | [], F, hF, h => by
    simp only [List.foldlM_nil] at h
    exact (Option.some.inj h) ▸ hF
  | n :: ns, F, hF, h => by
    simp only [List.foldlM_cons] at h
    cases hx : expand F n with
    | none => rw [hx] at h; simp at h
    | some F' =>
      rw [hx] at h
      exact isStd_foldlM ns F' (IsStd.expand n hF hx) h

/-- D1.7a (txt:141-142): a seed index and a finite parameter list are a generation witness. -/
theorem isStd_iff_witness (E : Forest) :
    IsStd E ↔ ∃ (m : Nat) (ns : List Nat), ns.foldlM (fun F n => expand F n) (seed m) = some E := by
  constructor
  · intro h
    induction h with
    | seed m => exact ⟨m, [], rfl⟩
    | expand n _ hexp ih =>
      obtain ⟨m, ns, hns⟩ := ih
      refine ⟨m, ns ++ [n], ?_⟩
      rw [List.foldlM_append, hns]
      simp [hexp]
  · rintro ⟨m, ns, h⟩
    exact isStd_foldlM ns (seed m) (IsStd.seed m) h

namespace Scan

/-! ## N1.1 — decidable mirrors and test generators (testing only) -/

/-- N1.1. -/
def condVb (E : Forest) : Bool :=
  E.entryAddrs.all fun e => match E.entryAt e with
    | some (p, _) => (e.col.resolve 0 p).isSome
    | none => true

/-- N1.1. -/
def condIb (E : Forest) : Bool :=
  E.entryAddrs.all fun e => match E.entryAt e with
    | some (_, h) => h.cols.isEmpty || h.cols.all fun col => match col with
        | (q, _) :: _ => decide (e.col.num 0 ≤ q)
        | [] => false
    | none => true

/-- N1.1. -/
def condHb (E : Forest) : Bool :=
  E.colAddrs.all fun c =>
    let col := (E.colAt c).getD []
    (List.range (col.length - 1)).all fun i => match col[i]?, col[i + 1]? with
      | some x, some y => decide (y.1 < x.1) || (decide (y.1 = x.1) && decide (y.2 ≤ x.2))
      | _, _ => true

/-- N1.1: the deterministic orbit search (fuel `x + 1` suffices under V, since edges decrease). -/
def pathAux (E : Forest) (ks : KeySys) (c : ColAddr) (W : List (WithTop Key)) (y : Nat) :
    Nat → Nat → Bool
  | 0, _ => false
  | fuel + 1, z => z == y || match respEdge E ks c W z with
    | some p => decide (p < z) && pathAux E ks c W y fuel p
    | none => false

def pathb (E : Forest) (ks : KeySys) (c : ColAddr) (W : List (WithTop Key)) (x y : Nat) : Bool :=
  pathAux E ks c W y (x + 1) x

/-- N1.1. -/
def condAKb (E : Forest) (ks : KeySys) : Bool :=
  E.colAddrs.all fun c => (List.range (parents E c).length).all fun i =>
    match (parents E c)[i]? with
    | some p => pathb E ks c (cutQuery (ks c) i) (cutStart E c i) p
    | none => true

/-- N1.1. -/
def isOwnerReturnb (E : Forest) (e₀ e : EntryAddr) : Bool :=
  e₀.heightPath.isPrefixOf e.col.path && match E.entryAt e with
    | some (q, _) => e.col.resolve 0 q == some e₀.col
    | none => false

/-- N1.1. -/
def condSb (E : Forest) : Bool :=
  E.entryAddrs.all fun e₀ => E.entryAddrs.all fun e => !isOwnerReturnb E e₀ e ||
    decide (relKey (e.col.num 0) ((E.heightAt e).getD Tree.empty) <
      relKey (e₀.col.num 0) ((E.heightAt e₀).getD Tree.empty))

def inLb (E : Forest) : Bool :=
  condVb E && condIb E && condHb E && condAKb E (actualKeys E) && condSb E

theorem condV_iff (E : Forest) : CondV E ↔ condVb E = true := by sorry
theorem condI_iff (E : Forest) : CondI E ↔ condIb E = true := by sorry
theorem condH_iff (E : Forest) : CondH E ↔ condHb E = true := by sorry
theorem path_iff_pathb {E : Forest} (hV : CondV E) (ks : KeySys) (c : ColAddr)
    (W : List (WithTop Key)) (x y : Nat) : Path E ks c W x y ↔ pathb E ks c W x y = true := by sorry
theorem condAK_iff_b {E : Forest} (hV : CondV E) (ks : KeySys) :
    CondAK E ks ↔ condAKb E ks = true := by sorry
theorem condS_iff (E : Forest) : CondS E ↔ condSb E = true := by sorry
theorem inL_iff (E : Forest) : InL E ↔ inLb E = true := by sorry

/-- N1.1: standard expressions reachable from the seeds `0…m` in at most `d` operations with
parameters `0…p` (breadth first; for bounded tests). -/
def stdUpTo (m d p : Nat) : List Forest :=
  ((List.range d).foldl
    (fun (st : List Forest × List Forest) _ =>
      let nxt := st.2.flatMap fun F => (List.range (p + 1)).filterMap (expand F)
      (st.1 ++ nxt, nxt))
    ((List.range (m + 1)).map seed, (List.range (m + 1)).map seed)).1

/-- N1.1: every listed expression is standard. -/
theorem isStd_of_mem_stdUpTo {m d p : Nat} {E : Forest} (h : E ∈ stdUpTo m d p) : IsStd E := by
  sorry

end Scan

/-! ## Integration additions (requested by U2, U3, U5; nodes D1.2e, D1.2f, D1.3b, D1.4b,
D1.5b, D1.6d, D1.9b, N1.4, L2.1d, L2.3c, L2.5d). Every statement below was a stub or a
Requires entry of another unit; the requester is named in each docstring. -/

namespace Tree

mutual
/-- D1.4b helper: `roles_map` under an arbitrary prefix. -/
theorem rolesF_map {α β : Type} (f : α → β) :
    (π : List (Nat × Nat)) → (t : Tree α) → rolesF π (t.map f) = rolesF π t
  | π, .node cols => by simp only [Tree.map, rolesF]; exact rolesCols_map f π 0 cols
theorem rolesCols_map {α β : Type} (f : α → β) :
    (π : List (Nat × Nat)) → (c : Nat) → (cs : List (List (α × Tree α))) →
      rolesCols π c (Tree.mapCols f cs) = rolesCols π c cs
  | _, _, [] => rfl
  | π, c, col :: rest => by
    simp only [Tree.mapCols, rolesCols]
    rw [rolesCol_map f π c 0 col, rolesCols_map f π (c + 1) rest]
theorem rolesCol_map {α β : Type} (f : α → β) :
    (π : List (Nat × Nat)) → (c i : Nat) → (es : List (α × Tree α)) →
      rolesCol π c i (Tree.mapCol f es) = rolesCol π c i es
  | _, _, _, [] => rfl
  | π, c, i, (_, h) :: rest => by
    simp only [Tree.mapCol, rolesCol]
    rw [rolesF_map f (π ++ [(c, i)]) h, rolesCol_map f π c (i + 1) rest]
end

/-- D1.4b (moved from U3 L6.2a `roles_map`; requested by U5 R14): roles depend only on the
shape of a tree. -/
theorem roles_map {α β : Type} (f : α → β) (t : Tree α) : (t.map f).roles = t.roles :=
  rolesF_map f [] t

end Tree

/-! D1.2e helpers: `Role.under` composes, and preserves `inEntry`. -/

namespace Role

theorem under_under (σ τ : List (Nat × Nat)) (x : Role) :
    (x.under τ).under σ = x.under (σ ++ τ) := by
  cases x <;> simp [Role.under]

theorem inEntry_eq_false {x : Role} {e : EntryAddr} (h1 : x ≠ .slot e)
    (h2 : ¬ e.heightPath <+: x.path) : x.inEntry e = false := by
  simp only [Role.inEntry, Bool.or_eq_false_iff, beq_eq_false_iff_ne, ne_eq, h1,
    not_false_eq_true, true_and]
  rw [Bool.eq_false_iff]
  intro h
  exact h2 (List.isPrefixOf_iff_prefix.1 h)

theorem inEntry_under (σ : List (Nat × Nat)) (y : Role) (P : List (Nat × Nat)) (j i : Nat) :
    (y.under σ).inEntry ⟨⟨σ ++ P, j⟩, i⟩ = y.inEntry ⟨⟨P, j⟩, i⟩ := by
  have h1 : (y.under σ == Role.slot ⟨⟨σ ++ P, j⟩, i⟩) = (y == Role.slot ⟨⟨P, j⟩, i⟩) := by
    rw [show Role.slot ⟨⟨σ ++ P, j⟩, i⟩ = (Role.slot ⟨⟨P, j⟩, i⟩).under σ from rfl]
    by_cases h : y = Role.slot ⟨⟨P, j⟩, i⟩
    · simp [h]
    · have : y.under σ ≠ (Role.slot ⟨⟨P, j⟩, i⟩).under σ := fun h' => h (Role.under_injective σ h')
      simp [h, this]
  simp only [Role.inEntry, h1, EntryAddr.heightPath, Role.path_under, List.append_assoc]
  congr 1
  rw [Bool.eq_iff_iff, List.isPrefixOf_iff_prefix, List.isPrefixOf_iff_prefix,
    List.prefix_append_right_inj]

end Role

namespace Tree

variable {α : Type}

/-! D1.2e helpers: the role recursion splits along a list of columns or entries; the roles
around an entry. -/

theorem list_split_of_getElem? {β : Type} {l : List β} {n : Nat} {a : β} (h : l[n]? = some a) :
    l = l.take n ++ a :: l.drop (n + 1) := by
  obtain ⟨hn, rfl⟩ := List.getElem?_eq_some_iff.1 h
  conv_lhs => rw [← List.take_append_drop n l, List.drop_eq_getElem_cons hn]

-- (merge) `rolesCols_append` / `rolesCol_append`: identical copies are declared earlier (D1.2c helpers).

/-- D1.2e helper: the roles of a tree around an entry `e`: the roles before `U_e` (among them
the column of `e`, its visible stack and the slots of the entries containing it), `U_e`, the
roles of its height, and the later roles, none of which lies in `e`. -/
theorem roles_decomp (P : List (Nat × Nat)) :
    ∀ (t : Tree α) (j i : Nat) (p : α) (h : Tree α), t.entryAt ⟨⟨P, j⟩, i⟩ = some (p, h) →
    ∃ pre post, t.roles = pre ++ Role.slot ⟨⟨P, j⟩, i⟩ ::
        (h.roles.map (Role.under (P ++ [(j, i)])) ++ post) ∧
      (∀ x ∈ post, x.inEntry ⟨⟨P, j⟩, i⟩ = false) ∧
      Role.ord ⟨P, j⟩ ∈ pre ∧ (∀ o, ColAddr.OnStack ⟨P, j⟩ o → Role.ord o ∈ pre) ∧
      (∀ e' : EntryAddr, e'.Contains ⟨P, j⟩ → Role.slot e' ∈ pre) := by
  induction P with
  | nil =>
    rintro ⟨cols⟩ j i p h he
    change (cols[j]?.bind (·[i]?)) = some (p, h) at he
    rw [Option.bind_eq_some_iff] at he
    obtain ⟨col, hcol, hx⟩ := he
    have hj : j < cols.length := (List.getElem?_eq_some_iff.1 hcol).1
    have hi : i < col.length := (List.getElem?_eq_some_iff.1 hx).1
    have hroles : (Tree.node cols).roles =
        (rolesCols [] 0 (cols.take j) ++ Role.ord ⟨[], j⟩ :: rolesCol [] j 0 (col.take i)) ++
          Role.slot ⟨⟨[], j⟩, i⟩ :: (h.roles.map (Role.under ([] ++ [(j, i)])) ++
            (rolesCol [] j (i + 1) (col.drop (i + 1)) ++ rolesCols [] (j + 1) (cols.drop (j + 1)))) := by
      rw [roles, rolesF]
      conv_lhs => rw [list_split_of_getElem? hcol]
      rw [rolesCols_append, rolesCols]
      conv_lhs => rw [list_split_of_getElem? hx]
      rw [rolesCol_append, rolesCol, ← rolesF_eq_map_under]
      simp only [List.length_take, Nat.min_eq_left (Nat.le_of_lt hj), Nat.min_eq_left (Nat.le_of_lt hi),
        Nat.zero_add, List.append_assoc, List.cons_append, List.nil_append]
    refine ⟨_, _, hroles, ?_, ?_, ?_, ?_⟩
    · intro x hx'
      rcases List.mem_append.1 hx' with hx' | hx'
      · rcases pos_rolesCol hx' with ⟨i', hi', rfl⟩ | ⟨i', σ, hi', hxp⟩
        · apply Role.inEntry_eq_false
          · simp; omega
          · simp [EntryAddr.heightPath, Role.path]
        · apply Role.inEntry_eq_false
          · rintro rfl; simp [Role.path] at hxp
          · rw [hxp]; simp [EntryAddr.heightPath]; omega
      · rcases pos_rolesCols hx' with ⟨c', hc', rfl⟩ | ⟨c', i', hc', rfl⟩ | ⟨c', i', σ, hc', hxp⟩
        · apply Role.inEntry_eq_false
          · simp
          · simp [EntryAddr.heightPath, Role.path]
        · apply Role.inEntry_eq_false
          · simp; omega
          · simp [EntryAddr.heightPath, Role.path]
        · apply Role.inEntry_eq_false
          · rintro rfl; simp [Role.path] at hxp
          · rw [hxp]; simp [EntryAddr.heightPath]; omega
    · simp
    · rintro o (⟨k, ck, ik, hk, -, -⟩ | ⟨hp, hc⟩)
      · simp at hk
      · refine List.mem_append_left _ ?_
        rw [mem_rolesCols_iff]
        refine ⟨o.col, cols[o.col]'(by simp at hc; omega), ?_, Or.inl ?_⟩
        · rw [List.getElem?_take, if_pos (by simpa using hc)]
          simp
        · obtain ⟨op, oc⟩ := o
          simp_all
    · rintro e' ⟨t, ht⟩
      have := congrArg List.length ht
      simp [EntryAddr.heightPath] at this
  | cons ab P ih =>
    obtain ⟨a, b⟩ := ab
    rintro ⟨cols⟩ j i p h he
    rw [entryAt_cons, Option.bind_eq_some_iff] at he
    obtain ⟨⟨p', h'⟩, hab, he'⟩ := he
    simp only [Tree.cols, Option.bind_eq_some_iff] at hab
    obtain ⟨col, hcol, hx⟩ := hab
    have ha : a < cols.length := (List.getElem?_eq_some_iff.1 hcol).1
    have hb : b < col.length := (List.getElem?_eq_some_iff.1 hx).1
    obtain ⟨pre', post', hr', hpost', hord', hstack', hcont'⟩ := ih h' j i p h he'
    have hroles : (Tree.node cols).roles =
        (rolesCols [] 0 (cols.take a) ++ Role.ord ⟨[], a⟩ :: (rolesCol [] a 0 (col.take b) ++
          Role.slot ⟨⟨[], a⟩, b⟩ :: pre'.map (Role.under [(a, b)]))) ++
          Role.slot ⟨⟨(a, b) :: P, j⟩, i⟩ :: (h.roles.map (Role.under ((a, b) :: P ++ [(j, i)])) ++
            (post'.map (Role.under [(a, b)]) ++ (rolesCol [] a (b + 1) (col.drop (b + 1)) ++
              rolesCols [] (a + 1) (cols.drop (a + 1))))) := by
      rw [roles, rolesF]
      conv_lhs => rw [list_split_of_getElem? hcol]
      rw [rolesCols_append, rolesCols]
      conv_lhs => rw [list_split_of_getElem? hx]
      rw [rolesCol_append, rolesCol, rolesF_eq_map_under, hr']
      simp only [List.length_take, Nat.min_eq_left (Nat.le_of_lt ha), Nat.min_eq_left (Nat.le_of_lt hb),
        Nat.zero_add, List.append_assoc, List.cons_append, List.nil_append, List.map_append,
        List.map_cons, List.map_map]
      have hu : (Role.under [(a, b)] ∘ Role.under (P ++ [(j, i)])) =
          Role.under ((a, b) :: P ++ [(j, i)]) := by
        funext x; simp [Role.under_under]
      rw [hu]
      rfl
    refine ⟨_, _, hroles, ?_, ?_, ?_, ?_⟩
    · intro x hx'
      rcases List.mem_append.1 hx' with hx' | hx'
      · obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx'
        have := Role.inEntry_under [(a, b)] y P j i
        simp only [List.singleton_append] at this
        rw [this]
        exact hpost' y hy
      rcases List.mem_append.1 hx' with hx' | hx'
      · rcases pos_rolesCol hx' with ⟨i', hi', rfl⟩ | ⟨i', σ, hi', hxp⟩
        · apply Role.inEntry_eq_false
          · simp
          · simp [EntryAddr.heightPath, Role.path]
        · apply Role.inEntry_eq_false
          · rintro rfl; simp [Role.path] at hxp; omega
          · rw [hxp]; simp [EntryAddr.heightPath]; omega
      · rcases pos_rolesCols hx' with ⟨c', hc', rfl⟩ | ⟨c', i', hc', rfl⟩ | ⟨c', i', σ, hc', hxp⟩
        · apply Role.inEntry_eq_false
          · simp
          · simp [EntryAddr.heightPath, Role.path]
        · apply Role.inEntry_eq_false
          · simp
          · simp [EntryAddr.heightPath, Role.path]
        · apply Role.inEntry_eq_false
          · rintro rfl; simp [Role.path] at hxp; omega
          · rw [hxp]; simp [EntryAddr.heightPath]; omega
    · refine List.mem_append_right _ (List.mem_cons_of_mem _ (List.mem_append_right _
        (List.mem_cons_of_mem _ ?_)))
      exact List.mem_map.2 ⟨_, hord', rfl⟩
    · rintro ⟨op, oc⟩ (⟨k, ck, ik, hk, hp, hc⟩ | ⟨hp, hc⟩)
      · cases k with
        | zero =>
          simp at hk hp
          obtain ⟨rfl, rfl⟩ := hk
          subst hp
          simp only at hc
          rcases Nat.lt_or_eq_of_le hc with hc | rfl
          · refine List.mem_append_left _ ?_
            rw [mem_rolesCols_iff]
            refine ⟨oc, cols[oc]'(by omega), ?_, Or.inl (by simp)⟩
            rw [List.getElem?_take, if_pos hc]
            simp
          · exact List.mem_append_right _ (List.mem_cons_self ..)
        | succ k =>
          simp only [List.getElem?_cons_succ] at hk
          simp only [List.take_succ_cons] at hp
          subst hp
          have := hstack' ⟨P.take k, oc⟩ (Or.inl ⟨k, ck, ik, hk, rfl, hc⟩)
          refine List.mem_append_right _ (List.mem_cons_of_mem _ (List.mem_append_right _
            (List.mem_cons_of_mem _ ?_)))
          exact List.mem_map.2 ⟨_, this, rfl⟩
      · simp only at hp hc
        subst hp
        have := hstack' ⟨P, oc⟩ (Or.inr ⟨rfl, hc⟩)
        refine List.mem_append_right _ (List.mem_cons_of_mem _ (List.mem_append_right _
          (List.mem_cons_of_mem _ ?_)))
        exact List.mem_map.2 ⟨_, this, rfl⟩
    · rintro ⟨⟨Q, c'⟩, i'⟩ ⟨t, ht⟩
      simp only [EntryAddr.heightPath] at ht
      cases Q with
      | nil =>
        simp at ht
        obtain ⟨⟨rfl, rfl⟩, -⟩ := ht
        exact List.mem_append_right _ (List.mem_cons_of_mem _ (List.mem_append_right _
          (List.mem_cons_self ..)))
      | cons q Q =>
        simp only [List.cons_append, List.cons.injEq] at ht
        obtain ⟨rfl, ht⟩ := ht
        have := hcont' ⟨⟨Q, c'⟩, i'⟩ ⟨t, by simpa [EntryAddr.heightPath] using ht⟩
        refine List.mem_append_right _ (List.mem_cons_of_mem _ (List.mem_append_right _
          (List.mem_cons_of_mem _ ?_)))
        exact List.mem_map.2 ⟨_, this, rfl⟩

/-- D1.2e helper: the roles before `U_e`, from any decomposition of the roles at `U_e`. -/
theorem prefixRoles_of_decomp {E : Forest} {e : EntryAddr} {pre rest : List Role}
    (hr : E.roles = pre ++ Role.slot e :: rest) : Packet.prefixRoles E e = pre := by
  have hnd := roles_nodup E
  rw [hr, List.nodup_append] at hnd
  have hne : Role.slot e ∉ pre := fun hm => hnd.2.2 _ hm _ (List.mem_cons_self ..) rfl
  unfold Packet.prefixRoles Packet.rolesBefore
  rw [hr, List.takeWhile_append_of_pos]
  · simp
  · intro a ha
    simp only [bne_iff_ne, ne_eq]
    rintro rfl
    exact hne ha

/-- D1.2e (requested by U5 R12): the roles of an entry `e` are its slot, right after the prefix
`P(E, e)`, followed by the roles of its height placed under `e`'s height path; no later role lies
inside `e`. -/
theorem roles_entry {E : Forest} {e : EntryAddr} (he : e ∈ E.entryAddrs) :
    ∃ post, E.roles = Packet.prefixRoles E e ++ .slot e ::
      (((E.heightAt e).getD Tree.empty).roles.map (Role.under e.heightPath) ++ post) ∧
      ∀ x ∈ post, x.inEntry e = false := by
  obtain ⟨⟨P, j⟩, i⟩ := e
  rw [mem_entryAddrs_iff] at he
  obtain ⟨⟨p, h⟩, hx⟩ := Option.isSome_iff_exists.1 he
  obtain ⟨pre, post, hr, hpost, -⟩ := roles_decomp P E j i p h hx
  have hh : E.heightAt ⟨⟨P, j⟩, i⟩ = some h := by simp [heightAt, hx]
  refine ⟨post, ?_, hpost⟩
  rw [prefixRoles_of_decomp hr, hh]
  exact hr

/-- D1.2e (requested by U5 R13): `truncAfter_roles` in `Role.under` form. -/
theorem truncAfter_roles_under {E : Forest} {e : EntryAddr} (he : e ∈ E.entryAddrs) :
    (E.truncAfter e).roles = Packet.prefixRoles E e ++ .slot e ::
      ((E.heightAt e).getD Tree.empty).roles.map (Role.under e.heightPath) := by
  rw [truncAfter_roles he]
  obtain ⟨post, hr, hpost⟩ := roles_entry he
  have hpre : ∀ a ∈ Packet.prefixRoles E e, (a != Role.slot e) = true := fun a ha =>
    List.all_eq_true.1 List.all_takeWhile a ha
  have htw : E.roles.takeWhile (· != .slot e) = Packet.prefixRoles E e := rfl
  rw [htw]
  congr 1
  rw [hr, List.dropWhile_append_of_pos hpre, List.dropWhile_cons_of_neg (by simp),
    List.takeWhile_cons_of_pos (by simp [Role.inEntry]), List.takeWhile_append_of_pos]
  · congr 1
    cases post with
    | nil => simp
    | cons x post =>
      rw [List.takeWhile_cons_of_neg (by simp [hpost x (List.mem_cons_self ..)])]
      simp
  · intro a ha
    obtain ⟨y, -, rfl⟩ := List.mem_map.1 ha
    simp [Role.inEntry, Role.path_under, List.isPrefixOf_iff_prefix]

/-- D1.2e (requested by U3 D7.1b for U5 R19): the column of an entry, every column occurrence on
the visible stack of that column, and the slot of every entry containing that column precede the
entry's slot in reading order. -/
theorem stack_mem_prefix {E : Forest} {e : EntryAddr} (he : e ∈ E.entryAddrs) :
    Role.ord e.col ∈ Packet.prefixRoles E e ∧
    (∀ o, e.col.OnStack o → Role.ord o ∈ Packet.prefixRoles E e) ∧
    ∀ e' : EntryAddr, e'.Contains e.col → Role.slot e' ∈ Packet.prefixRoles E e := by
  obtain ⟨⟨P, j⟩, i⟩ := e
  rw [mem_entryAddrs_iff] at he
  obtain ⟨⟨p, h⟩, hx⟩ := Option.isSome_iff_exists.1 he
  obtain ⟨pre, post, hr, -, hord, hstack, hcont⟩ := roles_decomp P E j i p h hx
  rw [prefixRoles_of_decomp hr]
  exact ⟨hord, hstack, hcont⟩

/-- D1.2f helper: `truncAux` is idempotent at an entry. -/
theorem truncAux_idem (P : List (Nat × Nat)) :
    ∀ (t : Tree α) (j i : Nat), (t.entryAt ⟨⟨P, j⟩, i⟩).isSome →
      truncAux P j i (truncAux P j i t) = truncAux P j i t := by
  induction P with
  | nil =>
    rintro ⟨cols⟩ j i he
    change (cols[j]?.bind (·[i]?)).isSome at he
    obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 he
    rw [Option.bind_eq_some_iff] at hx
    obtain ⟨col, hcol, -⟩ := hx
    have hj : j < cols.length := (List.getElem?_eq_some_iff.1 hcol).1
    have hA : (cols.take j).length = j := by simp; omega
    simp only [truncAux]
    congr 1
    rw [List.take_left' hA, List.getD_eq_getElem?_getD, List.getElem?_append_right (by omega),
      hA, Nat.sub_self]
    simp
  | cons ab P ih =>
    obtain ⟨c, i₀⟩ := ab
    rintro ⟨cols⟩ j i he
    rw [entryAt_cons] at he
    obtain ⟨y, hy⟩ := Option.isSome_iff_exists.1 he
    rw [Option.bind_eq_some_iff] at hy
    obtain ⟨⟨p', h'⟩, hab, he'⟩ := hy
    simp only [Tree.cols, Option.bind_eq_some_iff] at hab
    obtain ⟨col, hcol, hx⟩ := hab
    have hc : c < cols.length := (List.getElem?_eq_some_iff.1 hcol).1
    have hi : i₀ < col.length := (List.getElem?_eq_some_iff.1 hx).1
    have hA : (cols.take c).length = c := by simp; omega
    have hB : (col.take i₀).length = i₀ := by simp; omega
    have hgd : cols.getD c [] = col := by simp [List.getD_eq_getElem?_getD, hcol]
    simp only [truncAux, hgd, hx, Option.map_some, Option.toList_some]
    congr 1
    rw [List.take_left' hA, List.getD_eq_getElem?_getD, List.getElem?_append_right (by omega),
      hA, Nat.sub_self]
    simp only [List.getElem?_cons_zero, Option.getD_some, List.take_left' hB]
    rw [List.getElem?_append_right (by omega), hB, Nat.sub_self]
    simp only [List.getElem?_cons_zero, Option.map_some, Option.toList_some]
    rw [ih h' j i (by rw [he']; rfl)]

/-- D1.2f (requested by U3 R1): truncation after an entry is idempotent and keeps the entry,
its height and its prefix. -/
theorem truncAfter_spec (t : Forest) (e : EntryAddr) (he : e ∈ t.entryAddrs) :
    (t.truncAfter e).truncAfter e = t.truncAfter e ∧ e ∈ (t.truncAfter e).entryAddrs ∧
    (t.truncAfter e).heightAt e = t.heightAt e ∧ (t.truncAfter e).entryAt e = t.entryAt e ∧
    (∀ x ∈ Packet.prefixRoles t e, x ∈ Packet.prefixRoles (t.truncAfter e) e) ∧
    Packet.prefixRoles (t.truncAfter e) e = Packet.prefixRoles t e := by
  have hent := entryAt_truncAfter he
  have he' : (t.entryAt e).isSome := (mem_entryAddrs_iff t e).1 he
  have hpre : Packet.prefixRoles (t.truncAfter e) e = Packet.prefixRoles t e :=
    prefixRoles_of_decomp (truncAfter_roles_under he)
  refine ⟨?_, ?_, ?_, hent, fun x hx => hpre ▸ hx, hpre⟩
  · have h1 : ((t.truncAfter e).entryAt e).isSome := by rw [hent]; exact he'
    obtain ⟨⟨P, j⟩, i⟩ := e
    show (t.truncAfter _).truncAfterBody _ = t.truncAfterBody _
    rw [truncAfterBody, if_pos h1]
    show truncAux P j i (t.truncAfterBody _) = _
    rw [truncAfterBody, if_pos he']
    exact truncAux_idem P t j i he'
  · rw [mem_entryAddrs_iff, hent]; exact he'
  · simp only [heightAt, hent]

/-- D1.2f helpers: `List.modify` laws, and `setAux` composed with itself and with `truncAux`. -/
theorem list_modify_eq_self_of {β : Type} {l : List β} {n : Nat} {a : β} {f : β → β}
    (h : l[n]? = some a) (hf : f a = a) : l.modify n f = l := by
  apply List.ext_getElem?
  intro m
  rw [List.getElem?_modify]
  by_cases hm : n = m
  · subst hm; rw [h]; simp [hf]
  · simp [hm]

theorem list_modify_append_singleton {β : Type} (f : β → β) (x : β) :
    ∀ (A : List β) {n : Nat}, A.length = n → (A ++ [x]).modify n f = A ++ [f x]
  | [], n, hn => by subst hn; simp
  | y :: A, n, hn => by
    subst hn
    rw [List.cons_append, List.length_cons, List.modify_succ_cons,
      list_modify_append_singleton f x A rfl]
    rfl

theorem setAux_setAux (h h' : Tree α) (P : List (Nat × Nat)) :
    ∀ (t : Tree α) (j i : Nat), setAux h' P j i (setAux h P j i t) = setAux h' P j i t := by
  induction P with
  | nil =>
    rintro ⟨cols⟩ j i
    simp only [setAux, List.modify_modify_eq]
    congr 2
    funext col
    simp only [Function.comp_apply, List.modify_modify_eq]
    rfl
  | cons ab P ih =>
    obtain ⟨c, i₀⟩ := ab
    rintro ⟨cols⟩ j i
    simp only [setAux, List.modify_modify_eq]
    congr 2
    funext col
    simp only [Function.comp_apply, List.modify_modify_eq]
    congr 1
    funext x
    simp [ih]

theorem setAux_self (P : List (Nat × Nat)) :
    ∀ (t : Tree α) (j i : Nat) (p : α) (h : Tree α), t.entryAt ⟨⟨P, j⟩, i⟩ = some (p, h) →
      setAux h P j i t = t := by
  induction P with
  | nil =>
    rintro ⟨cols⟩ j i p h he
    change (cols[j]?.bind (·[i]?)) = some (p, h) at he
    rw [Option.bind_eq_some_iff] at he
    obtain ⟨col, hcol, hx⟩ := he
    simp only [setAux]
    rw [list_modify_eq_self_of (f := fun col => col.modify i fun x => (x.1, h)) hcol
      (list_modify_eq_self_of (f := fun x => (x.1, h)) hx rfl)]
  | cons ab P ih =>
    obtain ⟨c, i₀⟩ := ab
    rintro ⟨cols⟩ j i p h he
    rw [entryAt_cons, Option.bind_eq_some_iff] at he
    obtain ⟨⟨p', h'⟩, hab, he'⟩ := he
    simp only [Tree.cols, Option.bind_eq_some_iff] at hab
    obtain ⟨col, hcol, hx⟩ := hab
    simp only [setAux]
    rw [list_modify_eq_self_of (f := fun col => col.modify i₀ fun x => (x.1, setAux h P j i x.2))
      hcol (list_modify_eq_self_of (f := fun x => (x.1, setAux h P j i x.2)) hx
        (by simp only; rw [ih h' j i p h he']))]

theorem truncAux_setAux (h : Tree α) (P : List (Nat × Nat)) :
    ∀ (t : Tree α) (j i : Nat), (t.entryAt ⟨⟨P, j⟩, i⟩).isSome →
      truncAux P j i (setAux h P j i t) = setAux h P j i (truncAux P j i t) := by
  induction P with
  | nil =>
    rintro ⟨cols⟩ j i he
    change (cols[j]?.bind (·[i]?)).isSome at he
    obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 he
    rw [Option.bind_eq_some_iff] at hx
    obtain ⟨col, hcol, -⟩ := hx
    have hj : j < cols.length := (List.getElem?_eq_some_iff.1 hcol).1
    have hA : (cols.take j).length = j := by simp; omega
    simp only [truncAux, setAux]
    congr 1
    rw [List.take_modify, List.modify_eq_self (by omega), List.getD_eq_getElem?_getD,
      List.getElem?_modify_eq, hcol, List.getD_eq_getElem?_getD, hcol]
    rw [list_modify_append_singleton _ _ _ hA]
    simp [List.take_modify]
  | cons ab P ih =>
    obtain ⟨c, i₀⟩ := ab
    rintro ⟨cols⟩ j i he
    rw [entryAt_cons] at he
    obtain ⟨y, hy⟩ := Option.isSome_iff_exists.1 he
    rw [Option.bind_eq_some_iff] at hy
    obtain ⟨⟨p', h'⟩, hab, he'⟩ := hy
    simp only [Tree.cols, Option.bind_eq_some_iff] at hab
    obtain ⟨col, hcol, hx⟩ := hab
    have hc : c < cols.length := (List.getElem?_eq_some_iff.1 hcol).1
    have hi : i₀ < col.length := (List.getElem?_eq_some_iff.1 hx).1
    have hA : (cols.take c).length = c := by simp; omega
    have hB : (col.take i₀).length = i₀ := by simp; omega
    simp only [truncAux, setAux]
    congr 1
    rw [List.take_modify, List.modify_eq_self (by omega), List.getD_eq_getElem?_getD,
      List.getElem?_modify_eq, hcol, List.getD_eq_getElem?_getD, hcol]
    simp only [Option.map_eq_map, Option.map_some, Option.getD_some]
    rw [list_modify_append_singleton _ _ _ hA]
    congr 2
    rw [List.take_modify, List.modify_eq_self (by omega), List.getElem?_modify_eq, hx]
    simp only [Option.map_eq_map, Option.map_some, Option.toList_some]
    rw [list_modify_append_singleton _ _ _ hB]
    rw [ih h' j i (by rw [he']; rfl)]

/-- D1.2f (requested by U3 R2): basic laws of `setHeight`. -/
theorem setHeight_basic (t : Forest) (e : EntryAddr) (h : Forest) (he : e ∈ t.entryAddrs) :
    e ∈ (t.setHeight e h).entryAddrs ∧ (t.setHeight e h).heightAt e = some h ∧
    (∀ h', (t.setHeight e h).setHeight e h' = t.setHeight e h') ∧
    (t.heightAt e = some h → t.setHeight e h = t) ∧
    (t.truncAfter e = t → (t.setHeight e h).truncAfter e = t.setHeight e h) ∧
    ((t.setHeight e h).entryAt e).map Prod.fst = (t.entryAt e).map Prod.fst := by
  have he' : (t.entryAt e).isSome := (mem_entryAddrs_iff t e).1 he
  obtain ⟨⟨p, H⟩, hx⟩ := Option.isSome_iff_exists.1 he'
  have hset := entryAt_setHeight hx h
  have hs' : ((t.setHeight e h).entryAt e).isSome := by rw [hset]; rfl
  obtain ⟨⟨P, j⟩, i⟩ := e
  have hsh : t.setHeight ⟨⟨P, j⟩, i⟩ h = setAux h P j i t := by
    show t.setHeightBody _ h = _
    rw [setHeightBody, if_pos he']
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [mem_entryAddrs_iff, hset]; rfl
  · simp only [heightAt, hset, Option.map_some]
  · intro h'
    show (t.setHeight _ h).setHeightBody _ h' = t.setHeightBody _ h'
    rw [setHeightBody, if_pos hs', setHeightBody, if_pos he', hsh, setAux_setAux]
  · intro hh
    have : H = h := by
      simp only [heightAt, hx, Option.map_some, Option.some.injEq] at hh
      exact hh
    subst this
    rw [hsh]
    exact setAux_self P t j i p H hx
  · intro htr
    have htr' : truncAux P j i t = t := by
      have : t.truncAfter ⟨⟨P, j⟩, i⟩ = truncAux P j i t := by
        show t.truncAfterBody _ = _
        rw [truncAfterBody, if_pos he']
      rw [← this]; exact htr
    show (t.setHeight _ h).truncAfterBody _ = _
    rw [truncAfterBody, if_pos hs', hsh, truncAux_setAux h P t j i he', htr']
  · rw [hset, hx]; rfl

end Tree

/-- D1.4b (requested by U5 R14): a relative key has the roles of its height. -/
theorem relKey_roles (a : Nat) (B : Forest) : (relKey a B).roles = B.roles := by
  rw [relKey_eq_map]; exact Tree.roles_map _ B

/-- D1.4b (requested by U5 R14): a relative key is empty exactly when its height is. -/
theorem relKey_eq_empty {a : Nat} {B : Forest} : relKey a B = Tree.empty ↔ B = Tree.empty := by
  obtain ⟨cols⟩ := B
  cases cols with
  | nil => simp [relKey, Tree.map, Tree.mapCols, Tree.empty]
  | cons c cs => simp [relKey, Tree.map, Tree.mapCols, Tree.empty]

namespace Scan

/-- D1.3b (requested by U5 R8): under V and I the first parent of a nonempty height is the
printed number of its host column. -/
theorem firstParent_host {E : Forest} (hV : CondV E) (hI : CondI E) {e : EntryAddr}
    (he : e ∈ E.entryAddrs) {h : Forest} (hh : E.heightAt e = some h) (hne : h ≠ Tree.empty) :
    ∃ H₀ rest, h.cols.head? = some ((e.col.num 0, H₀) :: rest) := by
  obtain ⟨⟨p, h'⟩, hpe, hph⟩ := Option.map_eq_some_iff.mp hh
  simp only at hph
  rw [hph] at hpe
  obtain ⟨hcols⟩ := h
  cases hcols with
  | nil => exact absurd rfl hne
  | cons col₀ restCols =>
    obtain ⟨q, H₀, rest, rfl, hq⟩ := hI e he p _ hpe hne col₀ (List.mem_cons_self ..)
    -- the first entry of the height, `e₀ = ⟨⟨e.heightPath, 0⟩, 0⟩`
    have he₀ : E.entryAt ⟨⟨e.heightPath, 0⟩, 0⟩ = some (q, H₀) := by
      rw [Tree.entryAt_eq_bind, Tree.forestAt_heightPath, hh]
      rfl
    have hmem : (⟨⟨e.heightPath, 0⟩, 0⟩ : EntryAddr) ∈ E.entryAddrs :=
      (Tree.mem_entryAddrs_iff E _).mpr (by rw [he₀]; rfl)
    have hlt := (condV_iff_lt E).mp hV _ hmem q H₀ he₀
    have hnum : (⟨e.heightPath, 0⟩ : ColAddr).num 0 = e.col.num 0 + 1 := by
      simp only [ColAddr.num, EntryAddr.heightPath, List.map_append, List.sum_append, List.map_cons,
        List.map_nil, List.sum_cons, List.sum_nil]
      omega
    rw [hnum] at hlt
    exact ⟨H₀, rest, by simp only [Tree.cols, List.head?_cons]; congr; omega⟩

/-- D1.5b helper: a `map` after `mapLast`. -/
theorem map_mapLast {γ δ ε : Type} (f g : γ → δ) (h : δ → ε) (l : List γ) :
    (mapLast f g l).map h = mapLast (h ∘ f) (h ∘ g) l := by
  rw [mapLast_eq, mapLast_eq]; cases l.getLast? <;> simp

/-- D1.5b (requested by U2 REQ-U1-7, second form): a shift commutes with an unshifted placement. -/
theorem shift_replaceAt (r a δ : Nat) (Z G : Forest) :
    shift r a (replaceAt 0 0 Z δ G) = replaceAt r a (shift r a Z) δ G := by
  induction δ generalizing G with
  | zero =>
    obtain ⟨cols⟩ := G
    obtain ⟨zc⟩ := Z
    cases cols with
    | nil => simp [replaceAt, shift, Tree.map, Tree.mapCols]
    | cons c cs =>
      simp only [replaceAt, shift, Tree.map, Tree.cols]
      rw [shiftVal_zero_fun 0, treeMapCol_id_fun, List.map_id, treeMapCols_eq_map,
        treeMapCols_eq_map, List.map_append]
  | succ k ih =>
    obtain ⟨cols⟩ := G
    simp only [replaceAt, shift, Tree.map]
    rw [shiftVal_zero_fun 0, treeMapCol_id_fun, treeMapCols_eq_map, map_mapLast]
    congr 1
    congr 1
    funext c
    rw [Function.comp, treeMapCol_eq_map, map_mapLast]
    congr 1
    · funext x; simp only [Function.comp, id, treeMap_id]
    · funext x
      simp only [Function.comp, id]
      exact Prod.ext rfl (ih x.2)

/-- D1.6d (requested by U5 R3): the closing slot reads the root column and is an entry
`(r, ∅)`. -/
theorem rootData_col {H : Forest} {sd : StopData} {rd : RootData}
    (hsd : stopData H = some sd) (hrd : rootData H = some rd) :
    sd.col.resolve 0 sd.r = some rd.col ∧ rd.col.num 0 = sd.r ∧
      closingSlot sd ∈ H.entryAddrs ∧ H.entryAt (closingSlot sd) = some (sd.r, Tree.empty) := by
  obtain ⟨hres, -, -, hnum, -⟩ := rootData_spec hsd hrd
  obtain ⟨hcol, -⟩ := stopData_spec hsd
  have hent : H.entryAt (closingSlot sd) = some (sd.r, Tree.empty) := by
    simp [Tree.entryAt, closingSlot, hcol]
  exact ⟨hres, hnum, (Tree.mem_entryAddrs_iff H _).mpr (by rw [hent]; rfl), hent⟩

/-- D1.6d (requested by U5 R4): the stopping column is a column of the expression. -/
theorem stopData_col_mem {H : Forest} {sd : StopData} (hsd : stopData H = some sd) :
    Role.ord sd.col ∈ H.roles := by
  obtain ⟨hcol, -⟩ := stopData_spec hsd
  exact (Tree.mem_roles_iff H _).mpr (by simp [hcol])

/-- D1.6d (requested by U5 R5): the owner entry of a special step is an entry containing the
stopping column, and its height ends with the column `[(a, ∅)]`, `a` the owner column's number. -/
theorem ownerEntry_mem {H : Forest} {sd : StopData} {e : EntryAddr}
    (hk : stepKind H = some .special) (hsd : stopData H = some sd) (he : sd.ownerEntry = some e) :
    e ∈ H.entryAddrs ∧ (Role.ord sd.col).inEntry e = true ∧
      ∃ h, H.heightAt e = some h ∧ h.cols.getLast? = some [(e.col.num 0, Tree.empty)] := by
  obtain ⟨-, hhp, hnum, col, p, Fl, hcol, hlast, hidx, hFl⟩ := ownerEntry_spec hk hsd he
  have hent : H.entryAt e = some (p, Fl) := by
    simp only [Tree.entryAt, hcol, Option.bind_some]
    rw [show e.idx = col.length - 1 by omega, ← List.getLast?_eq_getElem?, hlast]
  refine ⟨(Tree.mem_entryAddrs_iff H _).mpr (by rw [hent]; rfl), ?_, Fl,
    by simp [Tree.heightAt, hent], by rw [hFl, hnum]⟩
  simp [Role.inEntry, Role.path, hhp]

/-- D1.6d (requested by U5 R7): an ordinary step has a nonempty last outer column. -/
theorem lastCol_of_ordinary {E : Forest} (h : stepKind E = some .ordinary) :
    E.cols.getLast? ≠ some [] := by
  intro h0
  rw [(stepKind_deletion_iff E).mpr h0] at h
  cases h

/-- D1.6d (helper): the roles of the last column of a column list. -/
theorem rolesCols_last (π : List (Nat × Nat)) : ∀ (cols : List Column) (c : Nat) (col : Column),
    cols.getLast? = some col → ∃ A, Tree.rolesCols π c cols =
      A ++ .ord ⟨π, c + cols.length - 1⟩ :: Tree.rolesCol π (c + cols.length - 1) 0 col
  | [], c, col, h => by simp at h
  | [x], c, col, h => by
    simp at h; subst h
    exact ⟨[], by simp [Tree.rolesCols]⟩
  | x :: y :: rest, c, col, h => by
    have h' : (y :: rest).getLast? = some col := by simpa using h
    obtain ⟨A, hA⟩ := rolesCols_last π (y :: rest) (c + 1) col h'
    refine ⟨.ord ⟨π, c⟩ :: (Tree.rolesCol π c 0 x ++ A), ?_⟩
    have e : c + (x :: y :: rest).length - 1 = c + 1 + (y :: rest).length - 1 := by simp; omega
    rw [e, Tree.rolesCols, hA]
    simp

/-- D1.6d (helper): the roles of a column ending in a given entry. -/
theorem rolesCol_snoc (π : List (Nat × Nat)) (c p : Nat) (h : Forest) : ∀ (P : Column) (i : Nat),
    Tree.rolesCol π c i (P ++ [(p, h)]) = Tree.rolesCol π c i P ++
      .slot ⟨⟨π, c⟩, i + P.length⟩ :: Tree.rolesF (π ++ [(c, i + P.length)]) h
  | [], i => by simp [Tree.rolesCol]
  | (a, b) :: P, i => by
    have ih := rolesCol_snoc π c p h P (i + 1)
    simp only [List.cons_append, Tree.rolesCol, ih, List.length_cons, List.append_assoc]
    rw [show i + 1 + P.length = i + (P.length + 1) by omega]

/-- D1.6d (helper): roles read under a prefix `π` have paths extending `π`. -/
theorem rolesF_prefix (F : Forest) : ∀ (π : List (Nat × Nat)) (x : Role),
    x ∈ Tree.rolesF π F → π <+: x.path := by
  induction hn : sizeOf F using Nat.strong_induction_on generalizing F with
  | _ n ih =>
  intro π x hx
  obtain ⟨cols⟩ := F
  have hsz : ∀ col ∈ cols, ∀ e ∈ col, sizeOf e.2 < n := by
    intro col hcol e he
    have l1 := List.sizeOf_lt_of_mem hcol
    have l2 := List.sizeOf_lt_of_mem he
    obtain ⟨a, b⟩ := e
    subst hn
    simp only [Tree.node.sizeOf_spec, Prod.mk.sizeOf_spec] at *
    omega
  have key2 : ∀ (c : Nat) (es : Column), (∀ e ∈ es, sizeOf e.2 < n) → ∀ i,
      x ∈ Tree.rolesCol π c i es → π <+: x.path := by
    intro c es
    induction es with
    | nil => intro _ i h; simp [Tree.rolesCol] at h
    | cons e rest ihe =>
      intro hes i h
      obtain ⟨a, hgt⟩ := e
      simp only [Tree.rolesCol, List.mem_cons, List.mem_append] at h
      rcases h with h | h | h
      · subst h; exact List.prefix_refl _
      · exact (List.prefix_append π [(c, i)]).trans
          (ih _ (hes _ (List.mem_cons_self ..)) hgt rfl _ x h)
      · exact ihe (fun e he => hes e (List.mem_cons_of_mem _ he)) (i + 1) h
  have key : ∀ (cs : List Column), (∀ col ∈ cs, ∀ e ∈ col, sizeOf e.2 < n) → ∀ c,
      x ∈ Tree.rolesCols π c cs → π <+: x.path := by
    intro cs
    induction cs with
    | nil => intro _ c h; simp [Tree.rolesCols] at h
    | cons col rest ihc =>
      intro hcs c h
      simp only [Tree.rolesCols, List.mem_cons, List.mem_append] at h
      rcases h with h | h | h
      · subst h; exact List.prefix_refl _
      · exact key2 c col (hcs col (List.mem_cons_self ..)) 0 h
      · exact ihc (fun col hc => hcs col (List.mem_cons_of_mem _ hc)) (c + 1) h
  exact key cols hsz 0 hx

/-- D1.6d (helper): every role of the first entries of a column lies in one of them. -/
theorem rolesCol_inEntry (π : List (Nat × Nat)) (c : Nat) : ∀ (col : Column) (i : Nat) (x : Role),
    x ∈ Tree.rolesCol π c i col → ∃ j, i ≤ j ∧ j < i + col.length ∧ x.inEntry ⟨⟨π, c⟩, j⟩ = true
  | [], i, x, h => by simp [Tree.rolesCol] at h
  | (a, hgt) :: rest, i, x, h => by
    simp only [Tree.rolesCol, List.mem_cons, List.mem_append] at h
    rcases h with h | h | h
    · subst h; exact ⟨i, le_rfl, by simp, by simp [Role.inEntry]⟩
    · refine ⟨i, le_rfl, by simp, ?_⟩
      have := rolesF_prefix hgt _ x h
      simp [Role.inEntry, EntryAddr.heightPath, List.isPrefixOf_iff_prefix.mpr this]
    · obtain ⟨j, h1, h2, h3⟩ := rolesCol_inEntry π c rest (i + 1) x h
      exact ⟨j, by omega, by simp; omega, h3⟩

theorem rolesF_eq_rolesCols (π : List (Nat × Nat)) (F : Forest) :
    Tree.rolesF π F = Tree.rolesCols π 0 F.cols := by
  obtain ⟨cols⟩ := F; simp [Tree.rolesF, Tree.cols]

/-- D1.6d (helper): along the route, the roles of each route forest end with the stopping column
and its entries. -/
theorem roles_route {E : Forest} {sd : StopData} (h : stopData E = some sd) : ∀ m ≤ sd.depth,
    ∃ A, Tree.rolesF (sd.col.path.take (sd.depth - m)) (skipLayers E (sd.depth - m)) =
      A ++ .ord sd.col :: Tree.rolesCol sd.col.path sd.col.col 0 (sd.Q ++ [(sd.r, Tree.empty)]) := by
  obtain ⟨hcc, hd, -, hlast, hcont, -⟩ := stopData_core h
  intro m
  induction m with
  | zero =>
    intro _
    obtain ⟨A, hA⟩ := rolesCols_last sd.col.path (skipLayers E sd.depth).cols 0 _ hlast
    refine ⟨A, ?_⟩
    have hcol : sd.col.col = (skipLayers E sd.depth).cols.length - 1 := by omega
    rw [Nat.sub_zero, show sd.col.path.take sd.depth = sd.col.path by rw [hd, List.take_length],
      rolesF_eq_rolesCols, hA, Nat.zero_add, ← hcol]
  | succ m ih =>
    intro hm
    obtain ⟨A, hA⟩ := ih (by omega)
    have hk1 : sd.depth - m = sd.depth - (m + 1) + 1 := by omega
    rw [hk1] at hA
    obtain ⟨col, p, a1, a2, -, a4⟩ := hcont (sd.depth - (m + 1)) (by omega)
    obtain ⟨A1, hA1⟩ := rolesCols_last (sd.col.path.take (sd.depth - (m + 1)))
      (skipLayers E (sd.depth - (m + 1))).cols 0 col a1
    have hrc := rolesCol_snoc (sd.col.path.take (sd.depth - (m + 1)))
      ((skipLayers E (sd.depth - (m + 1))).cols.length - 1) p
      (skipLayers E (sd.depth - (m + 1) + 1)) col.dropLast 0
    rw [List.dropLast_append_getLast? _ a2] at hrc
    have hcl1 : col.dropLast.length = col.length - 1 := List.length_dropLast
    have htake : sd.col.path.take (sd.depth - (m + 1)) ++
        [((skipLayers E (sd.depth - (m + 1))).cols.length - 1, col.length - 1)] =
        sd.col.path.take (sd.depth - (m + 1) + 1) := by
      rw [List.take_add_one, a4]; rfl
    simp only [Nat.zero_add] at hA1 hrc
    rw [hcl1, htake, hA] at hrc
    refine ⟨A1 ++ .ord ⟨sd.col.path.take (sd.depth - (m + 1)),
        (skipLayers E (sd.depth - (m + 1))).cols.length - 1⟩ ::
      (Tree.rolesCol (sd.col.path.take (sd.depth - (m + 1)))
        ((skipLayers E (sd.depth - (m + 1))).cols.length - 1) 0 col.dropLast ++
        .slot ⟨⟨sd.col.path.take (sd.depth - (m + 1)),
          (skipLayers E (sd.depth - (m + 1))).cols.length - 1⟩, col.length - 1⟩ :: A), ?_⟩
    rw [rolesF_eq_rolesCols, hA1, hrc]
    simp

/-- D1.6d (helper): truncation after the closing slot keeps every route forest. -/
theorem truncAux_route {E : Forest} {sd : StopData} (h : stopData E = some sd) : ∀ m ≤ sd.depth,
    Tree.truncAux (sd.col.path.drop (sd.depth - m)) sd.col.col sd.Q.length
      (skipLayers E (sd.depth - m)) = skipLayers E (sd.depth - m) := by
  obtain ⟨hcc, hd, -, hlast, hcont, -⟩ := stopData_core h
  intro m
  induction m with
  | zero =>
    intro _
    rw [Nat.sub_zero, show sd.col.path.drop sd.depth = [] by rw [hd]; simp]
    have hcl : (skipLayers E sd.depth).cols[sd.col.col]? = some (sd.Q ++ [(sd.r, Tree.empty)]) := by
      rw [show sd.col.col = (skipLayers E sd.depth).cols.length - 1 by omega,
        ← List.getLast?_eq_getElem?]; exact hlast
    have hdl := List.dropLast_append_getLast? _ hlast
    generalize skipLayers E sd.depth = F at hcl hdl hcc ⊢
    obtain ⟨cols⟩ := F
    simp only [Tree.cols] at hcl hdl hcc
    simp only [Tree.truncAux, List.getD_eq_getElem?_getD, hcl, Option.getD_some]
    have htk : List.take (sd.Q.length + 1) (sd.Q ++ [(sd.r, Tree.empty)]) =
        sd.Q ++ [(sd.r, Tree.empty)] := by simp
    have htc : List.take sd.col.col cols = cols.dropLast := by
      rw [List.dropLast_eq_take]; congr 1; omega
    rw [htk, htc, hdl]
  | succ m ih =>
    intro hm
    have ih' := ih (by omega)
    have hk1 : sd.depth - m = sd.depth - (m + 1) + 1 := by omega
    rw [hk1] at ih'
    obtain ⟨col, p, a1, a2, -, a4⟩ := hcont (sd.depth - (m + 1)) (by omega)
    have hkl : sd.depth - (m + 1) < sd.col.path.length := by omega
    have hdrop := List.drop_eq_getElem_cons hkl
    rw [List.getElem?_eq_getElem hkl, Option.some.injEq] at a4
    rw [a4] at hdrop
    rw [hdrop]
    have hcl : (skipLayers E (sd.depth - (m + 1))).cols[(skipLayers E (sd.depth - (m + 1))).cols.length - 1]? = some col := by
      rw [← List.getLast?_eq_getElem?]; exact a1
    have hel : col[col.length - 1]? = some (p, skipLayers E (sd.depth - (m + 1) + 1)) := by
      rw [← List.getLast?_eq_getElem?]; exact a2
    have hdl1 := List.dropLast_append_getLast? _ a1
    have hdl2 := List.dropLast_append_getLast? _ a2
    generalize skipLayers E (sd.depth - (m + 1) + 1) = G at hel hdl2 ih'
    generalize skipLayers E (sd.depth - (m + 1)) = F at hcl hdl1 ⊢
    obtain ⟨cols⟩ := F
    simp only [Tree.cols] at hcl hdl1 ⊢
    simp only [Tree.truncAux, List.getD_eq_getElem?_getD, hcl, Option.getD_some, hel,
      Option.map_some, Option.toList_some, ih']
    have hdl2' : col.take (col.length - 1) ++ [(p, G)] = col := by
      rw [← List.dropLast_eq_take]; exact hdl2
    have hdl1' : cols.take (cols.length - 1) ++ [col] = cols := by
      rw [← List.dropLast_eq_take]; exact hdl1
    rw [hdl2', hdl1']

/-- D1.6d (requested by U3 R4): the stopping data in role form. -/
theorem stopData_roles {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    sd.t = sd.col.num 0 ∧ sd.depth = sd.col.path.length ∧
    E.colAt sd.col = some (sd.Q ++ [(sd.r, Tree.empty)]) ∧
    E.entryAt (closingSlot sd) = some (sd.r, Tree.empty) ∧
    E.truncAfter (closingSlot sd) = E ∧
    ∃ qs : List Role, E.roles = Packet.rolesBefore E (.ord sd.col) ++ .ord sd.col ::
      (qs ++ [.slot (closingSlot sd)]) ∧ ∀ x ∈ qs, Packet.inQueryRegion sd x = true := by
  obtain ⟨hcol, hd, ht, -⟩ := stopData_spec h
  have hent : E.entryAt (closingSlot sd) = some (sd.r, Tree.empty) := by
    simp [Tree.entryAt, closingSlot, hcol]
  refine ⟨ht, hd, hcol, hent, ?_, ?_⟩
  · have := truncAux_route h sd.depth le_rfl
    simp only [Nat.sub_self, List.drop_zero, skipLayers] at this
    show Tree.truncAfterBody E (closingSlot sd) = E
    rw [Tree.truncAfterBody, hent]
    simpa [closingSlot] using this
  · obtain ⟨A, hA⟩ := roles_route h sd.depth le_rfl
    simp only [Nat.sub_self, List.take_zero, skipLayers] at hA
    have hrc := rolesCol_snoc sd.col.path sd.col.col sd.r Tree.empty sd.Q 0
    have hroles : E.roles = A ++ .ord sd.col ::
        (Tree.rolesCol sd.col.path sd.col.col 0 sd.Q ++ [.slot (closingSlot sd)]) := by
      rw [Tree.roles, hA, hrc]
      simp [closingSlot, Tree.empty, Tree.rolesF, Tree.rolesCols]
    have hnd := Tree.roles_nodup E
    rw [hroles] at hnd
    have hnotin : Role.ord sd.col ∉ A := by
      intro hx
      exact (List.nodup_append.mp hnd).2.2 _ hx _ (List.mem_cons_self ..) rfl
    refine ⟨Tree.rolesCol sd.col.path sd.col.col 0 sd.Q, ?_, ?_⟩
    · rw [Packet.rolesBefore, hroles, List.takeWhile_append_of_pos]
      · simp
      · intro a ha
        simp only [bne_iff_ne, ne_eq]
        rintro rfl; exact hnotin ha
    · intro x hx
      obtain ⟨j, -, hj, hin⟩ := rolesCol_inEntry _ _ sd.Q 0 x hx
      simp only [Packet.inQueryRegion, List.any_eq_true, List.mem_range]
      exact ⟨j, by omega, hin⟩

/-- D1.6d (requested by U3 R5): the root column lies on the stopping column's path, and the owner
flag is containment by the root's last entry. -/
theorem rootData_path {E : Forest} {sd : StopData} {rd : RootData}
    (hsd : stopData E = some sd) (h : rootData E = some rd) :
    sd.col.resolve 0 sd.r = some rd.col ∧ rd.col.num 0 = sd.r ∧ rd.layer = rd.col.path.length ∧
    rd.col.path <+: sd.col.path ∧
    rd.cursor = cursor (rootKeys E rd) (queryKeys sd) ∧
    (rd.owner = true ↔ (rd.col.container sd.col).isSome) ∧
    (∀ e, rd.col.container sd.col = some e → e.idx + 1 = Packet.rootLenOf E rd) := by
  obtain ⟨hres, hlay, -, hnum, -, -, hcur, -⟩ := rootData_spec hsd h
  obtain ⟨-, o, ho, rfl⟩ := rootData_unpack hsd h
  obtain ⟨hon, -⟩ := (ColAddr.resolve_spec 0 sd.col o sd.r).mp ho
  obtain ⟨F, hF, -, hpre, hiff, hlen⟩ := onStack_route hsd hon
  have hown : (rootOf E sd o).owner = (o.col + 1 == F.cols.length) := by simp [rootOf, hF]
  have hR : ((E.colAt o).getD []).length = ((F.cols[o.col]?).getD []).length := by
    simp [Tree.colAt, hF]
  refine ⟨hres, hnum, hlay, hpre, hcur, ?_, ?_⟩
  · rw [hown, beq_iff_eq, hiff, Option.isSome_iff_exists]
    constructor
    · rintro ⟨u, hu⟩
      exact ⟨⟨o, u⟩, (ColAddr.container_spec o sd.col ⟨o, u⟩).mpr ⟨rfl, hu⟩⟩
    · rintro ⟨e, he⟩
      obtain ⟨hec, hep⟩ := (ColAddr.container_spec o sd.col e).mp he
      refine ⟨e.idx, ?_⟩
      have : e.heightPath = o.path ++ [(o.col, e.idx)] := by
        simp [EntryAddr.heightPath, hec]
      rwa [← this]
  · intro e he
    obtain ⟨hec, hep⟩ := (ColAddr.container_spec o sd.col e).mp he
    have : e.heightPath = o.path ++ [(o.col, e.idx)] := by simp [EntryAddr.heightPath, hec]
    rw [this] at hep
    rw [Packet.rootLenOf, show (rootOf E sd o).col = o from rfl, hR]
    exact hlen e.idx hep

/-- D1.6d (requested by U3 R6): the ordinary branch with `specialStop` unfolded. -/
theorem stepKind_ordinary_iff_unfold {E : Forest} (hE : E ≠ Tree.empty) (hV : CondV E)
    (hI : CondI E) :
    stepKind E = some .ordinary ↔
      ∃ sd, stopData E = some sd ∧
        ¬ (0 < sd.depth ∧ sd.Q = [] ∧ sd.r + (sd.col.col + 1) = sd.t) ∧
        (sd.col.resolve 0 sd.r).isSome := by
  rw [stepKind_ordinary_iff]
  have hsp : ∀ sd : StopData, specialStop sd = false ↔
      ¬ (0 < sd.depth ∧ sd.Q = [] ∧ sd.r + (sd.col.col + 1) = sd.t) := by
    intro sd
    rw [← Bool.not_eq_true, specialStop]
    simp only [Bool.and_eq_true, decide_eq_true_eq, List.isEmpty_iff, beq_iff_eq, Nat.add_assoc,
      and_assoc]
  constructor
  · rintro ⟨sd, o, h1, h2, h3⟩
    exact ⟨sd, h1, (hsp sd).mp h2, by rw [h3]; rfl⟩
  · rintro ⟨sd, h1, h2, h3⟩
    obtain ⟨o, ho⟩ := Option.isSome_iff_exists.mp h3
    exact ⟨sd, o, h1, (hsp sd).mpr h2, ho⟩

/-- D1.6d (helper): the last column of the reference's route (`routeColsAux`), when it ends in an
entry with empty height, is where the paper's route `stopF` stops. -/
theorem routeColsAux_stop : ∀ (fuel : Nat) (F : Forest) (π : List (Nat × Nat)) (c : ColAddr),
    (routeColsAux fuel F π).getLast? = some c →
    ∃ ρ, c.path = π ++ ρ ∧ ∀ Q r, F.colAt ⟨ρ, c.col⟩ = some (Q ++ [(r, Tree.empty)]) →
      stopF π F = some { depth := c.path.length, col := c, t := c.num 0, r := r, Q := Q }
  | 0, F, π, c, h => by simp [routeColsAux] at h
  | fuel + 1, F, π, c, h => by
    rcases hcF : F.cols.getLast? with _ | col
    · simp [routeColsAux, hcF] at h
    have hcl : F.cols[F.cols.length - 1]? = some col := by
      rw [← List.getLast?_eq_getElem?]; exact hcF
    have hhead : ∀ Q r, F.colAt ⟨[], F.cols.length - 1⟩ = some (Q ++ [(r, Tree.empty)]) →
        col = Q ++ [(r, Tree.empty)] := by
      intro Q r hq
      simp only [Tree.colAt, Tree.forestAt, Option.bind_some, hcl, Option.some.injEq] at hq
      exact hq
    rcases he : col.getLast? with _ | ⟨p, hh⟩
    · simp only [routeColsAux, hcF, he, List.getLast?_singleton, Option.some.injEq] at h
      subst h
      refine ⟨[], by simp, fun Q r hq => ?_⟩
      rw [hhead Q r hq] at he; simp at he
    · rw [routeColsAux_of_last fuel π hcF he] at h
      by_cases hL : routeColsAux fuel hh (π ++ [(F.cols.length - 1, col.length - 1)]) = []
      · rw [hL, List.getLast?_singleton, Option.some.injEq] at h
        subst h
        refine ⟨[], by simp, fun Q r hq => ?_⟩
        have hcol := hhead Q r hq
        rw [hcol, List.getLast?_concat, Option.some.injEq, Prod.mk.injEq] at he
        obtain ⟨rfl, rfl⟩ := he
        rw [stopF_eq, hcF]
        simp [hcol, Tree.empty, Tree.cols]
      · obtain ⟨y, L', hyL⟩ := List.exists_cons_of_ne_nil hL
        rw [hyL, List.getLast?_cons_cons, ← hyL] at h
        obtain ⟨ρ, hp, hst⟩ := routeColsAux_stop fuel hh _ c h
        have hel : col[col.length - 1]? = some (p, hh) := by
          rw [← List.getLast?_eq_getElem?]; exact he
        have hhne : hh.cols.isEmpty = false := by
          cases hx : hh.cols.isEmpty
          · rfl
          · exfalso; apply hL
            have : hh = Tree.empty := by
              obtain ⟨hc⟩ := hh; simp [Tree.cols] at hx; subst hx; rfl
            rw [this, routeColsAux_empty]
        refine ⟨(F.cols.length - 1, col.length - 1) :: ρ, by rw [hp]; simp, fun Q r hq => ?_⟩
        have hq' : hh.colAt ⟨ρ, c.col⟩ = some (Q ++ [(r, Tree.empty)]) := by
          simpa [Tree.colAt, Tree.forestAt, hcl, hel] using hq
        rw [stopF_eq, hcF]
        simp only [he, hhne, Bool.false_eq_true, if_false]
        exact hst Q r hq'

/-- D1.6d (requested by U2 REQ-U1-3, converse; used by U2 D3.1e item 1): if the last route column
of `E` ends in an entry with empty height, the paper's route stops there. -/
theorem stopData_of_route {E : Forest} {c : ColAddr} {Q : Column} {r : Nat}
    (hc : (routeCols E).getLast? = some c) (hcol : E.colAt c = some (Q ++ [(r, Tree.empty)])) :
    stopData E = some { depth := c.path.length, col := c, t := c.num 0, r := r, Q := Q } := by
  obtain ⟨ρ, hp, hst⟩ := routeColsAux_stop _ E [] c hc
  have hc' : c = ⟨ρ, c.col⟩ := by
    obtain ⟨cp, cc⟩ := c
    simp only [List.nil_append] at hp
    simp [hp]
  rw [hc'] at hcol
  exact hst Q r hcol

mutual
/-- D1.9b helper: the number of roles does not depend on the address prefix. -/
theorem rolesF_length_eq {α : Type} : (π π' : List (Nat × Nat)) → (t : Tree α) →
    (Tree.rolesF π t).length = (Tree.rolesF π' t).length
  | π, π', .node cols => by simp only [Tree.rolesF]; exact rolesCols_length_eq π π' 0 0 cols
theorem rolesCols_length_eq {α : Type} : (π π' : List (Nat × Nat)) → (c c' : Nat) →
    (cs : List (List (α × Tree α))) → (Tree.rolesCols π c cs).length = (Tree.rolesCols π' c' cs).length
  | _, _, _, _, [] => rfl
  | π, π', c, c', col :: rest => by
    simp only [Tree.rolesCols, List.length_cons, List.length_append]
    rw [rolesCol_length_eq π π' c c' 0 0 col, rolesCols_length_eq π π' (c + 1) (c' + 1) rest]
theorem rolesCol_length_eq {α : Type} : (π π' : List (Nat × Nat)) → (c c' i i' : Nat) →
    (es : List (α × Tree α)) → (Tree.rolesCol π c i es).length = (Tree.rolesCol π' c' i' es).length
  | _, _, _, _, _, _, [] => rfl
  | π, π', c, c', i, i', (_, h) :: rest => by
    simp only [Tree.rolesCol, List.length_cons, List.length_append]
    rw [rolesF_length_eq (π ++ [(c, i)]) (π' ++ [(c', i')]) h,
      rolesCol_length_eq π π' c c' (i + 1) (i' + 1) rest]
end

/-- D1.9b helper: the height of the last entry of the last column has at least two roles fewer
(the last column's role and the entry's slot). -/
theorem size_lastHeight (cs : List Column) (es : Column) (q : Nat) (h : Forest) :
    h.size + 2 ≤ (Tree.node (cs ++ [es ++ [(q, h)]])).size := by
  unfold Tree.size Tree.roles
  simp only [Tree.rolesF, Tree.rolesCols_append, Tree.rolesCols, Tree.rolesCol_append, Tree.rolesCol,
    List.length_append, List.length_cons, List.length_nil]
  rw [rolesF_length_eq [] ([] ++ [(0 + cs.length, 0 + es.length)]) h]
  omega

/-- D1.9b helper: one step of the route through the last entry of the last column. -/
theorem routeColsAux_snoc (m : Nat) (π : List (Nat × Nat)) (cs : List Column) (es : Column)
    (q : Nat) (h : Forest) :
    routeColsAux (m + 1) (.node (cs ++ [es ++ [(q, h)]])) π =
      ⟨π, cs.length⟩ :: routeColsAux m h (π ++ [(cs.length, es.length)]) := by
  simp [routeColsAux, Tree.cols]

theorem routeColsAux_node_nil (m : Nat) (π : List (Nat × Nat)) :
    routeColsAux m (Tree.node []) π = [] := by
  cases m <;> rfl

/-- D1.9b helper: entries and columns below the last entry of the last column. -/
theorem entryAt_snoc_cons (cs : List Column) (es : Column) (q : Nat) (h : Forest)
    (ρ : List (Nat × Nat)) (j k : Nat) :
    (Tree.node (cs ++ [es ++ [(q, h)]])).entryAt ⟨⟨(cs.length, es.length) :: ρ, j⟩, k⟩ =
      h.entryAt ⟨⟨ρ, j⟩, k⟩ := by
  rw [Tree.entryAt_eq_bind, Tree.entryAt_eq_bind, Tree.forestAt_cons]
  simp [Tree.cols]

theorem colAt_snoc_cons (cs : List Column) (es : Column) (q : Nat) (h : Forest)
    (ρ : List (Nat × Nat)) (j : Nat) :
    (Tree.node (cs ++ [es ++ [(q, h)]])).colAt ⟨(cs.length, es.length) :: ρ, j⟩ = h.colAt ⟨ρ, j⟩ := by
  unfold Tree.colAt
  rw [Tree.forestAt_cons]
  simp [Tree.cols]

/-- D1.9b helper: the word of a nonempty forest is nonempty. -/
theorem wordAt_ne_nil {d : Nat} {h : Forest} (hh : h.cols ≠ []) : wordAt d h ≠ [] := by
  obtain ⟨cols⟩ := h
  cases cols with
  | nil => exact absurd rfl hh
  | cons col rest =>
    cases col with
    | nil => simp [wordAt, wordCols, wordCol]
    | cons x es => obtain ⟨p, H⟩ := x; simp [wordAt, wordCols, wordCol]

/-- D1.9b helper: the entry atom `(2e, 1, p)` (`first`) or `(2e+1, 0, p)`. -/
def entryAtom (e p : Nat) (first : Bool) : WordAtom :=
  if first then toLex (2 * e, toLex (1, p)) else toLex (2 * e + 1, toLex (0, p))

/-- D1.9b helper: the last atom of a word along the route, by strong induction on the size,
relative to a depth `d` and address prefix `π`, for every adequate fuel; `G₀` is the forest
without that atom. -/
theorem lastAtom_route : ∀ (n : Nat) (F : Forest) (d : Nat) (π : List (Nat × Nat))
    (W : List WordAtom) {e p : Nat} {first : Bool}, F.size ≤ n →
    wordAt d F = W ++ [entryAtom e p first] →
    ∃ (c : ColAddr) (k : Nat) (ρ : List (Nat × Nat)) (G₀ : Forest),
      c.path = π ++ ρ ∧ d ≤ e ∧ ρ.length = e - d ∧ (k = 0 ↔ first = true) ∧
      (∀ fuel, F.size < fuel → (routeColsAux fuel F π).getLast? = some c) ∧
      F.entryAt ⟨⟨ρ, c.col⟩, k⟩ = some (p, Tree.empty) ∧
      ((F.colAt ⟨ρ, c.col⟩).getD []).length = k + 1 ∧ wordAt d G₀ = W ∧
      (∀ fuel fuel', F.size < fuel → G₀.size < fuel' →
        (routeColsAux fuel' G₀ π).take (e - d) = (routeColsAux fuel F π).take (e - d)) ∧
      (k ≠ 0 → (∀ fuel', G₀.size < fuel' → (routeColsAux fuel' G₀ π)[e - d]? = some c) ∧
        G₀.colAt ⟨ρ, c.col⟩ = some (((F.colAt ⟨ρ, c.col⟩).getD []).take k)) := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro F d π W e p first hn hw
  obtain ⟨cols⟩ := F
  rcases List.eq_nil_or_concat' cols with rfl | ⟨cs, col, rfl⟩
  · simp [wordAt, wordCols] at hw
  rcases List.eq_nil_or_concat' col with rfl | ⟨es, ⟨q, h⟩, rfl⟩
  · exfalso
    rw [wordAt, wordCols_append, wordCols, wordCols, List.append_nil, wordCol] at hw
    have := (List.append_singleton_inj.mp hw).2
    unfold entryAtom at this
    split at this <;> (simp at this; try omega)
  rw [wordAt, wordCols_append, wordCols, wordCols, List.append_nil, wordCol_snoc] at hw
  by_cases hh : h.cols = []
  · -- the last entry has an empty height: it carries the last atom
    obtain ⟨hc⟩ := h
    simp only [Tree.cols] at hh
    subst hh
    have hR : ∀ fuel, (Tree.node (cs ++ [es ++ [(q, Tree.node [])]])).size < fuel →
        routeColsAux fuel (Tree.node (cs ++ [es ++ [(q, Tree.node [])]])) π = [⟨π, cs.length⟩] := by
      intro fuel hf
      obtain ⟨m, rfl⟩ : ∃ m, fuel = m + 1 := ⟨fuel - 1, by omega⟩
      rw [routeColsAux_snoc, routeColsAux_node_nil]
    have hE : (Tree.node (cs ++ [es ++ [(q, Tree.node [])]])).entryAt ⟨⟨[], cs.length⟩, es.length⟩ =
        some (q, Tree.empty) := by
      simp [Tree.entryAt_eq_bind, Tree.forestAt, Tree.cols, Tree.empty]
    have hC : (Tree.node (cs ++ [es ++ [(q, Tree.node [])]])).colAt ⟨[], cs.length⟩ =
        some (es ++ [(q, Tree.node [])]) := by
      simp [Tree.colAt, Tree.forestAt, Tree.cols]
    have hw0 : wordAt (d + 1) (Tree.node ([] : List Column)) = [] := rfl
    rw [hw0, List.append_nil] at hw
    rcases List.eq_nil_or_concat' es with rfl | ⟨es', x', rfl⟩
    · -- first entry: the atom `(2d, 1, q)`
      have hcol : wordCol d ([] ++ [(q, Tree.empty)]) = [toLex (2 * d, toLex (1, q))] := by
        simp [wordCol, wordLater, Tree.empty, wordAt, wordCols]
      rw [hcol] at hw
      obtain ⟨hW, hz⟩ := List.append_singleton_inj.mp hw
      unfold entryAtom at hz
      cases first with
      | false => simp at hz
      | true =>
        simp at hz
        obtain ⟨rfl, rfl⟩ := hz
        refine ⟨⟨π, cs.length⟩, 0, [], Tree.node cs, by simp, le_rfl, by simp, by simp, ?_, ?_, ?_,
          ?_, ?_, by simp⟩
        · intro fuel hf; rw [hR fuel hf]; rfl
        · simpa using hE
        · rw [hC]; simp
        · simp [wordAt, hW]
        · intro fuel fuel' _ _; simp
    · -- later entry: the atom `(2d+1, 0, q)`
      have hcol : wordCol d (es' ++ [x'] ++ [(q, Tree.empty)]) =
          wordCol d (es' ++ [x']) ++ [toLex (2 * d + 1, toLex (0, q))] := by
        rw [wordCol_append_of_ne_nil d (by simp)]
        simp [wordLater, Tree.empty, wordAt, wordCols]
      rw [hcol, ← List.append_assoc] at hw
      obtain ⟨hW, hz⟩ := List.append_singleton_inj.mp hw
      unfold entryAtom at hz
      cases first with
      | true => simp at hz
      | false =>
        simp at hz
        obtain ⟨rfl, rfl⟩ := hz
        refine ⟨⟨π, cs.length⟩, (es' ++ [x']).length, [], Tree.node (cs ++ [es' ++ [x']]), by simp,
          le_rfl, by simp, by simp, ?_, ?_, ?_, ?_, ?_, ?_⟩
        · intro fuel hf; rw [hR fuel hf]; rfl
        · simpa using hE
        · rw [hC]; simp
        · simp [wordAt, wordCols_append, wordCols, hW]
        · intro fuel fuel' _ _; simp
        · intro _
          refine ⟨fun fuel' hf => ?_, ?_⟩
          · obtain ⟨m, rfl⟩ : ∃ m, fuel' = m + 1 := ⟨fuel' - 1, by omega⟩
            obtain ⟨q', h'⟩ := x'
            rw [routeColsAux_snoc]; simp
          · rw [hC]; simp [Tree.colAt, Tree.forestAt, Tree.cols, List.take_append]
  · -- the last entry has a nonempty height: the last atom lies in it
    obtain ⟨W', z', hW'⟩ := (List.eq_nil_or_concat' (wordAt (d + 1) h)).resolve_left
      (wordAt_ne_nil hh)
    rw [hW', ← List.append_assoc, ← List.append_assoc] at hw
    obtain ⟨hW, rfl⟩ := List.append_singleton_inj.mp hw
    have hsz := size_lastHeight cs es q h
    obtain ⟨c, k, ρ', G₀', hc, hde, hρ, hk, hR, hE, hcol, hWG, hT, hK⟩ :=
      ih h.size (by omega) h (d + 1) (π ++ [(cs.length, es.length)]) W' le_rfl hW'
    have hsz' := size_lastHeight cs es q G₀'
    refine ⟨c, k, (cs.length, es.length) :: ρ', Tree.node (cs ++ [es ++ [(q, G₀')]]),
      by simp [hc], by omega, by simp; omega, hk, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro fuel hf
      obtain ⟨m, rfl⟩ : ∃ m, fuel = m + 1 := ⟨fuel - 1, by omega⟩
      rw [routeColsAux_snoc, List.getLast?_cons, hR m (by omega)]
      rfl
    · rw [entryAt_snoc_cons]; exact hE
    · rw [colAt_snoc_cons]; exact hcol
    · rw [wordAt, wordCols_append, wordCols, wordCols, List.append_nil, wordCol_snoc, hWG, ← hW,
        List.append_assoc]
    · intro fuel fuel' hf hf'
      obtain ⟨m, rfl⟩ : ∃ m, fuel = m + 1 := ⟨fuel - 1, by omega⟩
      obtain ⟨m', rfl⟩ : ∃ m', fuel' = m' + 1 := ⟨fuel' - 1, by omega⟩
      obtain ⟨t, ht⟩ : ∃ t, e - d = t + 1 := ⟨e - d - 1, by omega⟩
      rw [routeColsAux_snoc, routeColsAux_snoc, ht, List.take_succ_cons, List.take_succ_cons,
        show t = e - (d + 1) by omega, hT m m' (by omega) (by omega)]
    · intro hk0
      obtain ⟨hK1, hK2⟩ := hK hk0
      refine ⟨fun fuel' hf' => ?_, ?_⟩
      · obtain ⟨m', rfl⟩ : ∃ m', fuel' = m' + 1 := ⟨fuel' - 1, by omega⟩
        obtain ⟨t, ht⟩ : ∃ t, e - d = t + 1 := ⟨e - d - 1, by omega⟩
        rw [routeColsAux_snoc, ht, List.getElem?_cons_succ, show t = e - (d + 1) by omega]
        exact hK1 m' (by omega)
      · rw [colAt_snoc_cons, colAt_snoc_cons]; exact hK2

/-- D1.9b (requested by U2 REQ-U1-14, for N2.1): a one-atom extension of a word. If
`w(E) = w(G) ⌢ [z]` with `z` an entry atom at depth `e` (`(2e,1,p)` if `first`, else
`(2e+1,0,p)`), then the last route column `c` of `E` has depth `e` and ends in its entry `k`,
which is `(p, ∅)`, `k = 0` iff `first`; `G` is the safe prefix of `E` without that atom; the route
columns of depth `< e` are shared; and for `k ≠ 0` the column `c` is the route column of `G` at
depth `e`, holding the first `k` entries of `E`'s column. -/
theorem routeCols_of_word_snoc {G E : Forest} {e p : Nat} {first : Bool}
    (hw : word E = word G ++
      [if first then toLex (2 * e, toLex (1, p)) else toLex (2 * e + 1, toLex (0, p))]) :
    ∃ (c : ColAddr) (k : Nat), c.path.length = e ∧ (k = 0 ↔ first = true) ∧
      (routeCols E).getLast? = some c ∧ E.entryAt ⟨c, k⟩ = some (p, Tree.empty) ∧
      ((E.colAt c).getD []).length = k + 1 ∧ G = safePrefix E (mu E - 1) ∧
      (routeCols G).take e = (routeCols E).take e ∧
      (k ≠ 0 → (routeCols G)[e]? = some c ∧ G.colAt c = some (((E.colAt c).getD []).take k)) := by
  obtain ⟨c, k, ρ, G₀, hc, -, hρ, hk, hR, hE, hcol, hWG, hT, hK⟩ :=
    lastAtom_route E.size E 0 [] (word G) le_rfl hw
  simp only [List.nil_append] at hc
  have hc' : c = ⟨ρ, c.col⟩ := by rw [← hc]
  have hG : G = G₀ := word_injective hWG.symm
  subst hG
  unfold routeCols
  refine ⟨c, k, by rw [hc, hρ]; rfl, hk, hR _ (Nat.lt_succ_self _), by rw [hc']; exact hE,
    by rw [hc']; exact hcol, ?_, ?_, ?_⟩
  · apply word_injective
    rw [word_safePrefix, hw]
    simp [mu, hw]
  · simpa using hT _ _ (Nat.lt_succ_self _) (Nat.lt_succ_self _)
  · intro hk0
    obtain ⟨hK1, hK2⟩ := hK hk0
    refine ⟨by simpa using hK1 _ (Nat.lt_succ_self _), ?_⟩
    rw [hc']; exact hK2

mutual
/-- N1.4 helper: `wordAt_add` with its column, entry and later-entry forms. -/
theorem wordAt_add' (δ : Nat) : (e : Nat) → (X : Forest) →
    wordAt (e + δ) X = (wordAt e X).map fun A => toLex ((ofLex A).1 + 2 * δ, (ofLex A).2)
  | e, .node cols => by simp only [wordAt]; exact wordCols_add δ e cols
theorem wordCols_add (δ : Nat) : (e : Nat) → (cs : List Column) →
    wordCols (e + δ) cs = (wordCols e cs).map fun A => toLex ((ofLex A).1 + 2 * δ, (ofLex A).2)
  | _, [] => rfl
  | e, c :: cs => by
    simp only [wordCols, List.map_append]
    rw [wordCol_add δ e c, wordCols_add δ e cs]
theorem wordCol_add (δ : Nat) : (e : Nat) → (c : Column) →
    wordCol (e + δ) c = (wordCol e c).map fun A => toLex ((ofLex A).1 + 2 * δ, (ofLex A).2)
  | e, [] => by simp only [wordCol, List.map_cons, List.map_nil, ofLex_toLex, Nat.mul_add]
  | e, (p, h) :: es => by
    simp only [wordCol, List.map_cons, List.map_append]
    rw [show e + δ + 1 = e + 1 + δ by omega, wordAt_add' δ (e + 1) h, wordLater_add δ e es]
    simp only [ofLex_toLex, Nat.mul_add]
theorem wordLater_add (δ : Nat) : (e : Nat) → (c : Column) →
    wordLater (e + δ) c = (wordLater e c).map fun A => toLex ((ofLex A).1 + 2 * δ, (ofLex A).2)
  | _, [] => rfl
  | e, (p, h) :: es => by
    simp only [wordLater, List.map_cons, List.map_append]
    rw [show e + δ + 1 = e + 1 + δ by omega, wordAt_add' δ (e + 1) h, wordLater_add δ e es]
    simp only [ofLex_toLex, Nat.mul_add]
    rw [show 2 * e + 2 * δ + 1 = 2 * e + 1 + 2 * δ by omega]
end

/-- N1.4 (requested by U2 REQ-U1-18): the word at a deeper starting depth adds `2δ` to every depth
coordinate. -/
theorem wordAt_add (e δ : Nat) (X : Forest) :
    wordAt (e + δ) X = (wordAt e X).map fun A => toLex ((ofLex A).1 + 2 * δ, (ofLex A).2) :=
  wordAt_add' δ e X

/-- N1.4: relabelling of a word atom: the empty-column atom (even depth coordinate, marker `0`)
is fixed; every entry atom has its third coordinate relabelled. -/
def WordAtom.relabel (f : Nat → Nat) (A : WordAtom) : WordAtom :=
  if (ofLex A).1 % 2 = 0 ∧ (ofLex (ofLex A).2).1 = 0 then A
  else toLex ((ofLex A).1, toLex ((ofLex (ofLex A).2).1, f (ofLex (ofLex A).2).2))

mutual
/-- N1.4 helper: `wordAt_map` with its column, entry and later-entry forms. -/
theorem wordAt_map' (f : Nat → Nat) : (e : Nat) → (X : Forest) →
    wordAt e (Tree.map f X) = (wordAt e X).map (WordAtom.relabel f)
  | e, .node cols => by simp only [Tree.map, wordAt]; exact wordCols_map f e cols
theorem wordCols_map (f : Nat → Nat) : (e : Nat) → (cs : List Column) →
    wordCols e (Tree.mapCols f cs) = (wordCols e cs).map (WordAtom.relabel f)
  | _, [] => rfl
  | e, c :: cs => by
    simp only [Tree.mapCols, wordCols, List.map_append]
    rw [wordCol_map f e c, wordCols_map f e cs]
theorem wordCol_map (f : Nat → Nat) : (e : Nat) → (c : Column) →
    wordCol e (Tree.mapCol f c) = (wordCol e c).map (WordAtom.relabel f)
  | e, [] => by simp [Tree.mapCol, wordCol, WordAtom.relabel]
  | e, (p, h) :: es => by
    simp only [Tree.mapCol, wordCol, List.map_cons, List.map_append]
    rw [wordAt_map' f (e + 1) h, wordLater_map f e es]
    simp [WordAtom.relabel]
theorem wordLater_map (f : Nat → Nat) : (e : Nat) → (c : Column) →
    wordLater e (Tree.mapCol f c) = (wordLater e c).map (WordAtom.relabel f)
  | _, [] => rfl
  | e, (p, h) :: es => by
    simp only [Tree.mapCol, wordLater, List.map_cons, List.map_append]
    rw [wordAt_map' f (e + 1) h, wordLater_map f e es]
    simp [WordAtom.relabel, Nat.add_mod]
end

/-- N1.4 (requested by U2 REQ-U1-18): relabelling a forest relabels its word atom by atom. -/
theorem wordAt_map (e : Nat) (f : Nat → Nat) (X : Forest) :
    wordAt e (Tree.map f X) = (wordAt e X).map (WordAtom.relabel f) := wordAt_map' f e X

/-- L2.1d (requested by U3 R7): a reduced `⊤`-free query below the boundary of entry `u` stops at
or before `u`, and the scan is unchanged when the column is cut after `u` with key `u` raised
to `⊤`. -/
theorem cursor_cappedAt (ks W : List (WithTop Key)) (u : Nat) (hu : u < ks.length)
    (hW : W.Pairwise fun x y => y ≤ x) (hT : ∀ y ∈ W, y ≠ ⊤)
    (hlt : W < cutQuery ks (u + 1)) :
    cursor ks W ≤ u ∧ cursor ks W = cursor (ks.take u ++ [⊤]) W := by
  have hc : cursor ks W ≤ u := cursor_le_of_lt_cutQuery hW hu hlt
  refine ⟨hc, ?_⟩
  have h1 : cursor (ks.take (u + 1)) W = cursor ks W := by rw [cursor_take]; omega
  have hsplit : ks.take (u + 1) = ks.take u ++ [ks[u]] := (List.take_append_getElem hu).symm
  have hne : ks.take (u + 1) ≠ [] := by
    rw [hsplit]; exact List.append_ne_nil_of_right_ne_nil _ (by simp)
  have hlen : (ks.take (u + 1)).length = u + 1 := by rw [List.length_take]; omega
  have hdl : (ks.take (u + 1)).dropLast = ks.take u := by rw [hsplit, List.dropLast_concat]
  have h2 := cursor_eq_of_trace_eq (trace_cap_top hne (by rw [h1, hlen]; omega))
  rw [hdl] at h2
  rw [h2, h1]

/-- L2.3c (requested by U3 R8): the cut barrier read at a containing column on the cut chain. -/
theorem cut_barrier_read {E : Forest} (hE : InL E) {c : ColAddr} (hc : c ∈ E.colAddrs)
    {k : Nat} (hk : k ≤ (parents E c).length) {y : Nat}
    (hy : Path E (actualKeys E) c (cutQuery (actualKeys E c) k) (cutStart E c k) y)
    {o : ColAddr} (ho : c.resolve 0 y = some o) {e : EntryAddr} (he : o.container c = some e) :
    cutQuery (actualKeys E c) k < cutQuery (actualKeys E o) (e.idx + 1) := by
  obtain ⟨hV, -, -, hA, hS⟩ := hE
  obtain ⟨rfl, hec⟩ := (ColAddr.container_spec _ c e).1 he
  have hy' : e.col.num 0 = y := ColAddr.resolve_num ho
  subst hy'
  rw [← boundary_eq_cutQuery]
  exact cut_barrier hV hA hS (mem_entryAddrs_of_contains hc hec) hc hec hk hy

/-- L2.5d helper: a run starts at its start state. -/
theorem traceFrom_head? {α : Type} [LinearOrder α] (src qry : List α) (i j : Nat) :
    (traceFrom i j src qry).head? = some (i, j) := by
  cases src <;> cases qry <;> simp [traceFrom]

/-- L2.5d helper: a run that stops with source cursor inside the source has used up its query. -/
theorem qcursor_eq_length_of_lt {α : Type} [LinearOrder α] {src qry : List α}
    (h : cursor src qry < src.length) : qcursor src qry = qry.length := by
  induction src, qry using cursor.induct with
  | case1 qry => simp at h
  | case2 x xs => simp [qcursor]
  | case3 x xs y ys hxy ih =>
    rw [cursor, if_pos hxy, List.length_cons] at h
    rw [qcursor, if_pos hxy, ih (by omega)]
  | case4 xs y ys hyy ih =>
    rw [cursor, if_neg hyy, if_pos rfl, List.length_cons] at h
    rw [qcursor, if_neg hyy, if_pos rfl, ih (by omega), List.length_cons]
  | case5 x xs y ys h1 h2 ih =>
    rw [cursor, if_neg h1, if_neg h2] at h
    rw [qcursor, if_neg h1, if_neg h2, ih h, List.length_cons]

/-- L2.5d helper: consecutive states of a run started after the source prefix `A` and the query
prefix `B` follow the three comparison rules. -/
theorem traceFrom_step {α : Type} [LinearOrder α] (A B src qry : List α) :
    ∀ k s s', (traceFrom A.length B.length src qry)[k]? = some s →
      (traceFrom A.length B.length src qry)[k + 1]? = some s' →
      ∃ x y, (A ++ src)[s.1]? = some x ∧ (B ++ qry)[s.2]? = some y ∧
        ((x < y ∧ s' = (s.1 + 1, s.2)) ∨ (x = y ∧ s' = (s.1 + 1, s.2 + 1)) ∨
          (y < x ∧ s' = (s.1, s.2 + 1))) := by
  induction src, qry using cursor.induct generalizing A B with
  | case1 qry => intro k s s' _ h'; simp [traceFrom] at h'
  | case2 x xs => intro k s s' _ h'; simp [traceFrom] at h'
  | case3 x xs y ys hxy ih =>
    intro k s s' h h'
    rw [traceFrom, if_pos hxy] at h h'
    cases k with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.some.injEq] at h
      subst h
      rw [List.getElem?_cons_succ, ← List.head?_eq_getElem?, traceFrom_head?] at h'
      cases h'
      refine ⟨x, y, by simp, by simp, Or.inl ⟨hxy, rfl⟩⟩
    | succ k =>
      rw [List.getElem?_cons_succ] at h h'
      have := ih (A ++ [x]) B k s s'
      simp only [List.length_append, List.length_singleton, List.append_assoc,
        List.singleton_append] at this
      exact this h h'
  | case4 xs y ys hyy ih =>
    intro k s s' h h'
    rw [traceFrom, if_neg hyy, if_pos rfl] at h h'
    cases k with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.some.injEq] at h
      subst h
      rw [List.getElem?_cons_succ, ← List.head?_eq_getElem?, traceFrom_head?] at h'
      cases h'
      refine ⟨y, y, by simp, by simp, Or.inr (Or.inl ⟨rfl, rfl⟩)⟩
    | succ k =>
      rw [List.getElem?_cons_succ] at h h'
      have := ih (A ++ [y]) (B ++ [y]) k s s'
      simp only [List.length_append, List.length_singleton, List.append_assoc,
        List.singleton_append] at this
      exact this h h'
  | case5 x xs y ys h1 h2 ih =>
    intro k s s' h h'
    rw [traceFrom, if_neg h1, if_neg h2] at h h'
    cases k with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.some.injEq] at h
      subst h
      rw [List.getElem?_cons_succ, ← List.head?_eq_getElem?, traceFrom_head?] at h'
      cases h'
      refine ⟨x, y, by simp, by simp,
        Or.inr (Or.inr ⟨lt_of_le_of_ne (not_lt.1 h1) (Ne.symm h2), rfl⟩)⟩
    | succ k =>
      rw [List.getElem?_cons_succ] at h h'
      have := ih A (B ++ [y]) k s s'
      simp only [List.length_append, List.length_singleton, List.append_assoc,
        List.singleton_append] at this
      exact this h h'

/-- L2.5d (requested by U5 R15): the trace of the raw scan starts at `(0,0)`, moves by the three
comparison rules, stays within the cursors, and ends at `(cursor, j)` with `j = |qry|` when the
source is not exhausted. -/
theorem trace_spec {α : Type} [LinearOrder α] (src qry : List α) :
    (trace src qry).head? = some (0, 0) ∧
    (∀ k s s', (trace src qry)[k]? = some s → (trace src qry)[k + 1]? = some s' →
      ∃ x y, src[s.1]? = some x ∧ qry[s.2]? = some y ∧
        ((x < y ∧ s' = (s.1 + 1, s.2)) ∨ (x = y ∧ s' = (s.1 + 1, s.2 + 1)) ∨
          (y < x ∧ s' = (s.1, s.2 + 1)))) ∧
    (∀ s ∈ trace src qry, s.1 ≤ cursor src qry ∧ s.2 ≤ qry.length) ∧
    ∃ j, (trace src qry).getLast? = some (cursor src qry, j) ∧
      (cursor src qry < src.length → j = qry.length) := by
  refine ⟨traceFrom_head? src qry 0 0, fun k s s' h h' => ?_, fun s hs => ?_,
    qcursor src qry, trace_last src qry, qcursor_eq_length_of_lt⟩
  · simpa using traceFrom_step [] [] src qry k s s' h h'
  · have := mem_traceFrom src qry 0 0 hs
    exact ⟨by simpa using this.2.1, by have := qcursor_le_length src qry; omega⟩

end Scan

end BTBMS
