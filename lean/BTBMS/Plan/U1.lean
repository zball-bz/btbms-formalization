/-- D1.2c helper: every role read under the prefix `π` has a path extending `π`. -/
theorem rolesF_path_prefix : (π : List (Nat × Nat)) → (t : Tree α) → ∀ x ∈ rolesF π t, π <+: x.path
  | π, .node cols => by
    simp only [rolesF]
    intro x hx
    obtain ⟨c', -, -, h⟩ := rolesCols_mem π 0 cols x hx
    rcases h with rfl | ⟨i', rfl⟩ | ⟨i', h⟩
    · exact List.prefix_refl _
    · exact List.prefix_refl _
    · exact (List.prefix_append _ _).trans h
/-- D1.2c helper: the roles of the columns `c, c+1, …`: column roles and slots at the level
`π`, or roles below an entry of one of these columns. -/
theorem rolesCols_mem : (π : List (Nat × Nat)) → (c : Nat) → (cs : List (List (α × Tree α))) →
    ∀ x ∈ rolesCols π c cs, ∃ c', c ≤ c' ∧ c' < c + cs.length ∧
      (x = .ord ⟨π, c'⟩ ∨ (∃ i', x = .slot ⟨⟨π, c'⟩, i'⟩) ∨ ∃ i', π ++ [(c', i')] <+: x.path)
  | _, _, [] => by simp [rolesCols]
  | π, c, col :: rest => by
    simp only [rolesCols, List.mem_cons, List.mem_append]
    rintro x (rfl | hx | hx)
    · exact ⟨c, le_refl _, by simp, Or.inl rfl⟩
    · obtain ⟨i', -, -, h⟩ := rolesCol_mem π c 0 col x hx
      exact ⟨c, le_refl _, by simp,
        h.elim (fun h => Or.inr (Or.inl ⟨i', h⟩)) (fun h => Or.inr (Or.inr ⟨i', h⟩))⟩
    · obtain ⟨c', h1, h2, h⟩ := rolesCols_mem π (c + 1) rest x hx
      exact ⟨c', by omega, by simp only [List.length_cons]; omega, h⟩
/-- D1.2c helper: the roles of the entries `i, i+1, …` of column `c`: their slots, or roles
below one of them. -/
theorem rolesCol_mem : (π : List (Nat × Nat)) → (c i : Nat) → (es : List (α × Tree α)) →
    ∀ x ∈ rolesCol π c i es, ∃ i', i ≤ i' ∧ i' < i + es.length ∧
      (x = .slot ⟨⟨π, c⟩, i'⟩ ∨ π ++ [(c, i')] <+: x.path)
  | _, _, _, [] => by simp [rolesCol]
  | π, c, i, (_, h) :: rest => by
    simp only [rolesCol, List.mem_cons, List.mem_append]
    rintro x (rfl | hx | hx)
    · exact ⟨i, le_refl _, by simp, Or.inl rfl⟩
    · exact ⟨i, le_refl _, by simp, Or.inr (rolesF_path_prefix _ h x hx)⟩
    · obtain ⟨i', h1, h2, h⟩ := rolesCol_mem π c (i + 1) rest x hx
      exact ⟨i', by omega, by simp only [List.length_cons]; omega, h⟩
end

/-- D1.2c helper: `rolesCols` over an append. -/
theorem rolesCols_append (π : List (Nat × Nat)) (c : Nat) (l₁ l₂ : List (List (α × Tree α))) :
    rolesCols π c (l₁ ++ l₂) = rolesCols π c l₁ ++ rolesCols π (c + l₁.length) l₂ := by
  induction l₁ generalizing c with
  | nil => simp [rolesCols]
  | cons col l ih =>
    simp only [List.cons_append, rolesCols, ih, List.length_cons, List.append_assoc]
    rw [show c + 1 + l.length = c + (l.length + 1) by omega]

/-- D1.2c helper: `rolesCol` over an append. -/
theorem rolesCol_append (π : List (Nat × Nat)) (c i : Nat) (l₁ l₂ : List (α × Tree α)) :
    rolesCol π c i (l₁ ++ l₂) = rolesCol π c i l₁ ++ rolesCol π c (i + l₁.length) l₂ := by
  induction l₁ generalizing i with
  | nil => simp [rolesCol]
  | cons x l ih =>
    obtain ⟨q, h⟩ := x
    simp only [List.cons_append, rolesCol, ih, List.length_cons, List.append_assoc]
    rw [show i + 1 + l.length = i + (l.length + 1) by omega]

/-- D1.2c helper: split a list at a present index. -/
theorem exists_split_of_getElem? {β : Type} {l : List β} {n : Nat} {x : β} (h : l[n]? = some x) :
    ∃ l₁ l₂, l = l₁ ++ x :: l₂ ∧ l₁.length = n := by
  induction l generalizing n with
  | nil => simp at h
  | cons y ys ih =>
    cases n with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.some.injEq] at h
      exact ⟨[], ys, by simp [h], rfl⟩
    | succ n =>
      simp only [List.getElem?_cons_succ] at h
      obtain ⟨l₁, l₂, rfl, rfl⟩ := ih h
      exact ⟨y :: l₁, l₂, rfl, rfl⟩

/-- D1.2c helper: two one-step extensions of `π` that are prefixes of one list agree. -/
theorem prefix_step_eq {π l : List (Nat × Nat)} {a b : Nat × Nat} (h₁ : π ++ [a] <+: l)
    (h₂ : π ++ [b] <+: l) : a = b := by
  have h := (List.prefix_of_prefix_length_le h₁ h₂ (by simp)).eq_of_length (by simp)
  simpa using h

/-- D1.2c helper: a one-step extension of `π` is not a prefix of `π`. -/
theorem not_prefix_append_self {π : List (Nat × Nat)} {a : Nat × Nat} {l : List (Nat × Nat)}
    (hl : l = π) : ¬ π ++ [a] <+: l := by
  intro h; have := h.length_le; subst hl; simp at this

/-- D1.2c helper: roles of later entries of column `c` do not lie below entry `i` of it. -/
theorem not_prefix_of_mem_rolesCol_later {π : List (Nat × Nat)} {c i : Nat} {es : List (α × Tree α)}
    {x : Role} (hx : x ∈ rolesCol π c (i + 1) es) : ¬ π ++ [(c, i)] <+: x.path := by
  obtain ⟨i', h1, -, h⟩ := rolesCol_mem π c (i + 1) es x hx
  rcases h with rfl | h
  · exact not_prefix_append_self rfl
  · intro h'; have := prefix_step_eq h h'; simp at this; omega

/-- D1.2c helper: roles of later columns do not lie below an entry of column `c`. -/
theorem not_prefix_of_mem_rolesCols_later {π : List (Nat × Nat)} {c i : Nat}
    {cs : List (List (α × Tree α))} {x : Role} (hx : x ∈ rolesCols π (c + 1) cs) :
    ¬ π ++ [(c, i)] <+: x.path := by
  obtain ⟨c', h1, -, h⟩ := rolesCols_mem π (c + 1) cs x hx
  rcases h with rfl | ⟨i', rfl⟩ | ⟨i', h⟩
  · exact not_prefix_append_self rfl
  · exact not_prefix_append_self rfl
  · intro h'; have := prefix_step_eq h h'; simp at this; omega

/-- D1.2c helper: roles of earlier entries of column `c` do not lie below entry `i` of it, and
are not its slot. -/
theorem not_mem_of_mem_rolesCol_earlier {π : List (Nat × Nat)} {c : Nat} {es : List (α × Tree α)}
    {x : Role} (hx : x ∈ rolesCol π c 0 es) :
    x ≠ .slot ⟨⟨π, c⟩, es.length⟩ ∧ ¬ π ++ [(c, es.length)] <+: x.path := by
  obtain ⟨i', -, h2, h⟩ := rolesCol_mem π c 0 es x hx
  rcases h with rfl | h
  · exact ⟨by simp; omega, not_prefix_append_self rfl⟩
  · refine ⟨fun h' => ?_, fun h' => ?_⟩
    · subst h'; exact not_prefix_append_self rfl h
    · have := prefix_step_eq h h'; simp at this; omega

/-- D1.2c helper: roles of earlier columns do not lie below an entry of column `c`, and are not
slots of column `c`. -/
theorem not_mem_of_mem_rolesCols_earlier {π : List (Nat × Nat)} {cs : List (List (α × Tree α))}
    {x : Role} (hx : x ∈ rolesCols π 0 cs) (i : Nat) :
    x ≠ .slot ⟨⟨π, cs.length⟩, i⟩ ∧ ¬ π ++ [(cs.length, i)] <+: x.path := by
  obtain ⟨c', -, h2, h⟩ := rolesCols_mem π 0 cs x hx
  rcases h with rfl | ⟨i', rfl⟩ | ⟨i', h⟩
  · exact ⟨by simp, not_prefix_append_self rfl⟩
  · exact ⟨by simp; omega, not_prefix_append_self rfl⟩
  · refine ⟨fun h' => ?_, fun h' => ?_⟩
    · subst h'; exact not_prefix_append_self rfl h
    · have := prefix_step_eq h h'; simp at this; omega

/-- D1.2c helper: `inEntry` fails for a role that is not the slot and not below the height. -/
theorem inEntry_eq_false {x : Role} {e : EntryAddr} (h₁ : x ≠ .slot e)
    (h₂ : ¬ e.heightPath <+: x.path) : x.inEntry e = false := by
  simp only [Role.inEntry, Bool.or_eq_false_iff, beq_eq_false_iff_ne]
  exact ⟨h₁, by rw [Bool.eq_false_iff]; intro h; exact h₂ (List.isPrefixOf_iff_prefix.mp h)⟩

/-- D1.2c helper (`truncAfter_roles` for an arbitrary prefix `π`, since `truncAux` descends with
relative paths): the roles under `π` split at the slot of the target entry into the earlier
roles `A`, the slot, the roles of its height and later roles `C` outside the entry; truncation
keeps `A`, the slot and the height. -/
theorem truncAux_roles_decomp : ∀ (ρ π : List (Nat × Nat)) (s : Tree α) (j i : Nat) (p : α)
    (h : Tree α), s.entryAt ⟨⟨ρ, j⟩, i⟩ = some (p, h) →
    ∃ A C, rolesF π s = A ++ .slot ⟨⟨π ++ ρ, j⟩, i⟩ :: (rolesF (π ++ ρ ++ [(j, i)]) h ++ C) ∧
      .slot ⟨⟨π ++ ρ, j⟩, i⟩ ∉ A ∧ (∀ x ∈ C, x.inEntry ⟨⟨π ++ ρ, j⟩, i⟩ = false) ∧
      rolesF π (truncAux ρ j i s) = A ++ .slot ⟨⟨π ++ ρ, j⟩, i⟩ :: rolesF (π ++ ρ ++ [(j, i)]) h
  | [], π, .node cols, j, i, p, h, he => by
    simp only [List.append_nil]
    rw [entryAt_eq_bind] at he
    simp only [forestAt, Option.bind_some, Tree.cols] at he
    cases hc : cols[j]? with
    | none => rw [hc] at he; simp at he
    | some col =>
      rw [hc, Option.bind_some] at he
      obtain ⟨cols₁, cols₂, rfl, rfl⟩ := exists_split_of_getElem? hc
      obtain ⟨es₁, es₂, rfl, rfl⟩ := exists_split_of_getElem? he
      refine ⟨rolesCols π 0 cols₁ ++ .ord ⟨π, cols₁.length⟩ :: rolesCol π cols₁.length 0 es₁,
        rolesCol π cols₁.length (es₁.length + 1) es₂ ++ rolesCols π (cols₁.length + 1) cols₂,
        ?_, ?_, ?_, ?_⟩
      · simp only [rolesF, rolesCols_append, rolesCols, rolesCol_append, rolesCol, Nat.zero_add,
          List.append_assoc, List.cons_append]
      · intro hm
        simp only [List.mem_append, List.mem_cons] at hm
        rcases hm with hm | hm | hm
        · exact (not_mem_of_mem_rolesCols_earlier hm _).1 rfl
        · simp at hm
        · exact (not_mem_of_mem_rolesCol_earlier hm).1 rfl
      · intro x hx
        simp only [List.mem_append] at hx
        refine inEntry_eq_false ?_ ?_
        · rintro rfl
          rcases hx with hx | hx
          · obtain ⟨i', h1, -, h⟩ := rolesCol_mem _ _ _ _ _ hx
            rcases h with h | h
            · simp at h; omega
            · exact not_prefix_append_self rfl h
          · obtain ⟨c', h1, -, h⟩ := rolesCols_mem _ _ _ _ hx
            rcases h with h | ⟨i', h⟩ | ⟨i', h⟩
            · simp at h
            · simp at h; omega
            · exact not_prefix_append_self rfl h
        · simp only [EntryAddr.heightPath]
          rcases hx with hx | hx
          · exact not_prefix_of_mem_rolesCol_later hx
          · exact not_prefix_of_mem_rolesCols_later hx
      · simp [truncAux, rolesF, rolesCols_append, rolesCols, rolesCol_append, rolesCol,
          List.take_append, List.getD_eq_getElem?_getD, List.take_of_length_le]
  | (c₀, i₀) :: ρ, π, .node cols, j, i, p, h, he => by
    rw [entryAt_eq_bind, forestAt_cons] at he
    simp only [Tree.cols] at he
    cases hc : cols[c₀]? with
    | none => rw [hc] at he; simp at he
    | some col =>
      rw [hc, Option.bind_some] at he
      cases hi : col[i₀]? with
      | none => rw [hi] at he; simp at he
      | some x =>
        obtain ⟨p₀, h₀⟩ := x
        rw [hi, Option.bind_some] at he
        replace he : h₀.entryAt ⟨⟨ρ, j⟩, i⟩ = some (p, h) := by rw [entryAt_eq_bind]; exact he
        obtain ⟨A', C', hR, hA', hC', hT⟩ := truncAux_roles_decomp ρ (π ++ [(c₀, i₀)]) h₀ j i p h he
        simp only [List.append_assoc, List.singleton_append] at hR hA' hC' hT
        obtain ⟨cols₁, cols₂, rfl, rfl⟩ := exists_split_of_getElem? hc
        obtain ⟨es₁, es₂, rfl, rfl⟩ := exists_split_of_getElem? hi
        refine ⟨rolesCols π 0 cols₁ ++ .ord ⟨π, cols₁.length⟩ :: (rolesCol π cols₁.length 0 es₁ ++
            .slot ⟨⟨π, cols₁.length⟩, es₁.length⟩ :: A'),
          C' ++ (rolesCol π cols₁.length (es₁.length + 1) es₂ ++
            rolesCols π (cols₁.length + 1) cols₂), ?_, ?_, ?_, ?_⟩
        · simp only [rolesF, rolesCols_append, rolesCols, rolesCol_append, rolesCol, Nat.zero_add,
            List.append_assoc, List.cons_append]
          rw [hR]
          simp only [List.append_assoc, List.cons_append]
        · have hpre : π ++ [(cols₁.length, es₁.length)] <+:
              (Role.slot ⟨⟨π ++ (cols₁.length, es₁.length) :: ρ, j⟩, i⟩).path :=
            ⟨ρ, by simp [Role.path]⟩
          intro hm
          simp only [List.mem_append, List.mem_cons] at hm
          rcases hm with hm | hm | hm | hm | hm
          · exact (not_mem_of_mem_rolesCols_earlier hm es₁.length).2 hpre
          · simp at hm
          · exact (not_mem_of_mem_rolesCol_earlier hm).2 hpre
          · simp at hm
          · exact hA' hm
        · intro x hx
          simp only [List.mem_append] at hx
          rcases hx with hx | hx
          · exact hC' x hx
          · have hnp : ¬ π ++ [(cols₁.length, es₁.length)] <+: x.path := by
              rcases hx with hx | hx
              · exact not_prefix_of_mem_rolesCol_later hx
              · exact not_prefix_of_mem_rolesCols_later hx
            refine inEntry_eq_false ?_ ?_
            · rintro rfl; exact hnp ⟨ρ, by simp [Role.path]⟩
            · intro h'
              have hp : π ++ [(cols₁.length, es₁.length)] <+:
                  EntryAddr.heightPath ⟨⟨π ++ (cols₁.length, es₁.length) :: ρ, j⟩, i⟩ :=
                ⟨ρ ++ [(j, i)], by simp [EntryAddr.heightPath]⟩
              exact hnp (hp.trans h')
        · simp [truncAux, rolesF, rolesCols_append, rolesCols, rolesCol_append, rolesCol,
            List.getD_eq_getElem?_getD, hT]

/-- D1.2c (`truncAfter_roles`†): the roles of `truncAfter t e` are the roles of `t` strictly before
`U_e`, followed by the maximal run of roles inside `e` starting with `U_e`. -/
theorem truncAfter_roles {t : Tree α} {e : EntryAddr} (he : e ∈ t.entryAddrs) :
    (t.truncAfter e).roles =
      t.roles.takeWhile (· != .slot e) ++
        (t.roles.dropWhile (· != .slot e)).takeWhile (fun x => x.inEntry e) := by
  have hs := (mem_entryAddrs_iff t e).mp he
  obtain ⟨⟨p, h⟩, hpe⟩ := Option.isSome_iff_exists.mp hs
  rw [truncAfter_eq_body, truncAfterBody, if_pos hs]
  obtain ⟨⟨path, j⟩, i⟩ := e
  obtain ⟨A, C, hR, hA, hC, hT⟩ := truncAux_roles_decomp path [] t j i p h hpe
  simp only [List.nil_append] at hR hA hC hT
  unfold roles
  rw [hT, hR]
  have hA' : ∀ x ∈ A, (x != .slot ⟨⟨path, j⟩, i⟩) = true := fun x hx => by
    simp only [bne_iff_ne, ne_eq]; rintro rfl; exact hA hx
  have hH : ∀ x ∈ rolesF (path ++ [(j, i)]) h, x.inEntry ⟨⟨path, j⟩, i⟩ = true := fun x hx => by
    simp only [Role.inEntry, EntryAddr.heightPath, Bool.or_eq_true]
    exact Or.inr (List.isPrefixOf_iff_prefix.mpr (rolesF_path_prefix _ h x hx))
  have hC' : C.takeWhile (fun x => x.inEntry ⟨⟨path, j⟩, i⟩) = [] := by
    cases C with
    | nil => rfl
    | cons y ys => simp [hC y (List.mem_cons_self ..)]
  rw [List.takeWhile_append_of_pos hA', List.dropWhile_append_of_pos hA']
  simp only [List.takeWhile_cons, List.dropWhile_cons, bne_self_eq_false, Bool.false_eq_true,
    if_false, List.append_nil]
  have hself : (Role.slot ⟨⟨path, j⟩, i⟩).inEntry ⟨⟨path, j⟩, i⟩ = true := by
    simp [Role.inEntry]
  rw [if_pos hself, List.takeWhile_append_of_pos hH, hC', List.append_nil]

/-- D1.2c: `truncAfter` keeps `e` and its height. -/
theorem entryAt_truncAfter {t : Tree α} {e : EntryAddr} (he : e ∈ t.entryAddrs) :
    (t.truncAfter e).entryAt e = t.entryAt e := by
  clear he
  rw [truncAfter_eq_body, truncAfterBody]
  split_ifs
  · exact entryAt_truncAux e.col.path t e.col.col e.idx
  · rfl

/-- D1.2c: `setHeight` changes only the height of `e`. -/
theorem entryAt_setHeight {t : Tree α} {e : EntryAddr} {p : α} {H : Tree α}
    (he : t.entryAt e = some (p, H)) (h : Tree α) : (t.setHeight e h).entryAt e = some (p, h) := by
  rw [setHeight_eq_body, setHeightBody, if_pos (by rw [he]; rfl)]
  have := entryAt_setAux h e.col.path t e.col.col e.idx
  rw [he] at this
  exact this

/-- D1.2d: the last step of the last-column, last-entry route in `F`: `(|F| - 1, |col| - 1)` for
the last column `col`, if it is nonempty. -/
def lastStep? (F : Tree α) : Option (Nat × Nat) :=
  F.cols.getLast?.bind fun col => if col.isEmpty then none else some (F.cols.length - 1, col.length - 1)

end Tree

/-! ## D1.2d — the terminal last-column, last-entry route -/

/-- D1.2d: the route path: at every level `d` the step taken is the last-column, last-entry step
of the forest there. -/
def Scan.IsRoutePath (E : Forest) (π : List (Nat × Nat)) : Prop :=
  ∀ d < π.length, ∃ F, E.forestAt (π.take d) = some F ∧ F.lastStep? = π[d]?

/-- D1.2d: membership in the spine's `routeCols` (whose fuel `E.size + 1` suffices). -/
theorem Scan.mem_routeCols_iff (E : Forest) (c : ColAddr) :
    c ∈ Scan.routeCols E ↔ Scan.IsRoutePath E c.path ∧
      ∃ F, E.forestAt c.path = some F ∧ F.cols.length = c.col + 1 := by sorry

/-- D1.2d: route columns are columns of `E`. -/
theorem Scan.mem_colAddrs_of_mem_routeCols {E : Forest} {c : ColAddr} (h : c ∈ Scan.routeCols E) :
    c ∈ E.colAddrs := by sorry

/-! ## D2.1, D2.1a, L2.1, L2.1a–c, L2.3b, L2.5 — the generic word library (S-6, U1 half) -/

namespace Scan

section Words

variable {α : Type} [LinearOrder α]

/-- D2.1a: a nonincreasing word (the reduced words of txt:159). -/
abbrev Noninc (l : List α) : Prop := l.Pairwise fun x y => y ≤ x

/-- D2.1a: one reduction step: delete terminal letters strictly smaller than `x`, append `x`. -/
def nuStep (acc : List α) (x : α) : List α :=
  (acc.reverse.dropWhile fun y => decide (y < x)).reverse ++ [x]

theorem nu_eq_foldl (l : List α) : nu l = l.foldl nuStep [] := rfl

/-- D2.1a. -/
theorem nu_append_singleton (l : List α) (x : α) : nu (l ++ [x]) = nuStep (nu l) x := by sorry

/-- D2.1a: `ν(W)` is nonincreasing (txt:159). -/
theorem nu_noninc (l : List α) : Noninc (nu l) := by sorry

/-- D2.1a: a nonincreasing word is reduced. -/
theorem nu_of_noninc {l : List α} (h : Noninc l) : nu l = l := by sorry

/-- D2.1a. -/
theorem nu_append_nu (l m : List α) : nu (nu l ++ m) = nu (l ++ m) := by sorry

/-- D2.1a: on a nonincreasing word, a step keeps the letters `≥ x` and appends `x`. -/
theorem nuStep_eq_takeWhile {acc : List α} (h : Noninc acc) (x : α) :
    nuStep acc x = acc.takeWhile (fun y => decide (x ≤ y)) ++ [x] := by sorry

/-- D2.1a (txt:163-164): an append strictly increases a reduced word. -/
theorem lt_nuStep {acc : List α} (h : Noninc acc) (x : α) : acc < nuStep acc x := by sorry

/-- D2.1a: every letter of `nuStep acc x` is at least `x`. -/
theorem le_of_mem_nuStep {acc : List α} (h : Noninc acc) {x y : α} (hy : y ∈ nuStep acc x) :
    x ≤ y := by sorry

theorem cutQuery_zero (ks : List α) : cutQuery ks 0 = [] := rfl

theorem boundary_eq_cutQuery (ks : List α) (i : Nat) : boundary ks i = cutQuery ks (i + 1) := rfl

/-- D2.1a. -/
theorem cutQuery_succ {ks : List α} {k : Nat} (hk : k < ks.length) :
    cutQuery ks (k + 1) = nuStep (cutQuery ks k) ks[k] := by sorry

theorem cutQuery_noninc (ks : List α) (k : Nat) : Noninc (cutQuery ks k) := nu_noninc _

/-- D2.1 (with `cutQuery_lt_succ`): boundaries strictly increase up to the full cut. -/
theorem cutQuery_strictMono {ks : List α} {j k : Nat} (hjk : j < k) (hk : k ≤ ks.length) :
    cutQuery ks j < cutQuery ks k := by sorry

/-- D2.1: boundaries are monotone (constant beyond the full cut). -/
theorem cutQuery_mono (ks : List α) {j k : Nat} (hjk : j ≤ k) : cutQuery ks j ≤ cutQuery ks k := by
  sorry

theorem boundary_ne_nil {ks : List α} {i : Nat} (hi : i < ks.length) : boundary ks i ≠ [] := by
  sorry

-- U1-verify: changed (new declarations)
/-- D2.1a: `ν` commutes with a strictly increasing map (used for the maps `κ_j` of txt:331-333
and for the coercion `Key → WithTop Key`). -/
theorem nu_map {β : Type} [LinearOrder β] {f : α → β} (hf : StrictMono f) (l : List α) :
    nu (l.map f) = (nu l).map f := by sorry

/-- D2.1a: cut queries commute with a strictly increasing map. -/
theorem cutQuery_map {β : Type} [LinearOrder β] {f : α → β} (hf : StrictMono f) (ks : List α)
    (k : Nat) : cutQuery (ks.map f) k = (cutQuery ks k).map f := by sorry

/-- D2.1a: boundaries commute with a strictly increasing map. -/
theorem boundary_map {β : Type} [LinearOrder β] {f : α → β} (hf : StrictMono f) (ks : List α)
    (i : Nat) : boundary (ks.map f) i = (boundary ks i).map f := by sorry

/-- L2.3b (word observation, txt:211-213): if `D = ν(P ⌢ [K])`, `W` is nonincreasing, `W < D`
and `J < K`, then `ν(W ⌢ [J]) < D`. -/
theorem nu_append_lt {P W : List α} {K J : α} (hW : Noninc W) (hWD : W < nu (P ++ [K]))
    (hJK : J < K) : nu (W ++ [J]) < nu (P ++ [K]) := by sorry

/-- L2.3b, boundary form: `W(c,k) < B_a(u)` and `K_k < K_u` give `B_c(k) < B_a(u)`. -/
theorem boundary_lt_of_cut {ksc ksa : List α} {k u : Nat} (hk : k < ksc.length)
    (hu : u < ksa.length) (hW : cutQuery ksc k < boundary ksa u) (hK : ksc[k] < ksa[u]) :
    boundary ksc k < boundary ksa u := by sorry

/-- L2.1a: the source cursor never exceeds the source length. -/
theorem cursor_le_length (src qry : List α) : cursor src qry ≤ src.length := by sorry

/-- L2.1a: the run on a source prefix is the run on the whole source, stopped at its end. -/
theorem cursor_take (src qry : List α) (k : Nat) :
    cursor (src.take k) qry = min k (cursor src qry) := by sorry

/-- L2.1a: the final query cursor of the raw scan (same recursion as `cursor`). -/
def qcursor : List α → List α → Nat
  | [], _ => 0
  | _ :: _, [] => 0
  | x :: xs, y :: ys =>
    if x < y then qcursor xs (y :: ys)
    else if x = y then qcursor xs ys + 1
    else qcursor (x :: xs) ys + 1
termination_by xs ys => xs.length + ys.length

theorem qcursor_le_length (src qry : List α) : qcursor src qry ≤ qry.length := by sorry

/-- L2.1a: a run that exhausts `src` continues on `src'` from the query position it reached. -/
theorem cursor_append_of_exhausted {src qry : List α} (src' : List α)
    (h : cursor src qry = src.length) :
    cursor (src ++ src') qry = src.length + cursor src' (qry.drop (qcursor src qry)) ∧
      qcursor (src ++ src') qry = qcursor src qry + qcursor src' (qry.drop (qcursor src qry)) := by
  sorry

/-- L2.1a: a run that stops inside `src` (its query is exhausted) ignores what follows. -/
theorem cursor_append_of_lt {src qry : List α} (src' : List α) (h : cursor src qry < src.length) :
    cursor (src ++ src') qry = cursor src qry := by sorry

/-- L2.1a: a one-letter source against a nonincreasing query `y :: V`. -/
theorem cursor_singleton_cons (x y : α) (V : List α) (hV : Noninc (y :: V)) :
    (x < y → cursor [x] (y :: V) = 1 ∧ qcursor [x] (y :: V) = 0) ∧
      (x = y → cursor [x] (y :: V) = 1 ∧ qcursor [x] (y :: V) = 1) ∧
      (y < x → cursor [x] (y :: V) = 0) := by sorry

theorem cursor_nil_right (src : List α) : cursor src [] = 0 := by sorry

/-- L2.1b (txt:170-173): against a nonincreasing query, exhaustion is lexicographic comparison
of the reduced source. -/
theorem cursor_eq_length_iff (src : List α) {W : List α} (hW : Noninc W) :
    cursor src W = src.length ↔ nu src ≤ W := by sorry

/-- L2.1 ("the unique i", txt:165-167). -/
theorem cursor_unique {ks W : List α} (hW : Noninc W) {i : Nat} (hi : i ≤ ks.length)
    (hlo : cutQuery ks i ≤ W) (hhi : i < ks.length → W < cutQuery ks (i + 1)) :
    cursor ks W = i := by sorry

/-- L2.1: a query strictly below `B(v)` stops the scan at or before `v`. -/
theorem cursor_le_of_lt_cutQuery {ks W : List α} (hW : Noninc W) {v : Nat} (hv : v < ks.length)
    (h : W < cutQuery ks (v + 1)) : cursor ks W ≤ v := by sorry

/-- L2.1: a query at least `B(v-1)` reaches `v`. -/
theorem le_cursor_of_cutQuery_le {ks W : List α} (hW : Noninc W) {v : Nat} (hv : v ≤ ks.length)
    (h : cutQuery ks v ≤ W) : v ≤ cursor ks W := by sorry

/-- L2.1: the final source cursor is monotone in reduced queries (used by L2.2). -/
theorem cursor_mono (ks : List α) {W Z : List α} (hW : Noninc W) (hZ : Noninc Z) (h : W ≤ Z) :
    cursor ks W ≤ cursor ks Z := by sorry

/-- L2.1c (txt:174-176): deleting a query letter immediately followed by a larger one does not
change the final source cursor. -/
theorem cursor_delete (src A B : List α) {x y : α} (hxy : x < y) :
    cursor src (A ++ x :: y :: B) = cursor src (A ++ y :: B) := by sorry

/-- L2.5a: the final state of the trace is `(cursor, qcursor)`. -/
theorem trace_last (src qry : List α) :
    (trace src qry).getLast? = some (cursor src qry, qcursor src qry) := by sorry

/-- L2.5a: equal traces have equal final source cursors. -/
theorem cursor_eq_of_trace_eq {src₁ src₂ qry₁ qry₂ : List α}
    (h : trace src₁ qry₁ = trace src₂ qry₂) : cursor src₁ qry₁ = cursor src₂ qry₂ := by sorry

-- U1-verify: changed (new declaration)
/-- L2.5a: no state of a run has a source cursor beyond the final one (used in the proof of
`trace_agree`). -/
theorem trace_fst_le_cursor (src qry : List α) {i j : Nat} (h : (i, j) ∈ trace src qry) :
    i ≤ cursor src qry := by sorry

/-- L2.5 (1) (`trace_map`†, txt:238): a common strictly increasing map preserves every cursor
pair. -/
theorem trace_map {β : Type} [LinearOrder β] {f : α → β} (hf : StrictMono f) (src qry : List α) :
    trace (src.map f) (qry.map f) = trace src qry := by sorry

/-- L2.5 (1), cursor form. -/
theorem cursor_map {β : Type} [LinearOrder β] {f : α → β} (hf : StrictMono f) (src qry : List α) :
    cursor (src.map f) (qry.map f) = cursor src qry := by sorry

/-- L2.5 (2) (`trace_cap_top`†, txt:239, 242-244): if a nonempty source is not exhausted,
replacing its last key by `⊤` preserves every cursor pair. -/
theorem trace_cap_top {β : Type} [LinearOrder β] [OrderTop β] {src qry : List β} (hne : src ≠ [])
    (hnx : cursor src qry < src.length) : trace (src.dropLast ++ [⊤]) qry = trace src qry := by
  sorry

/-- L2.5 (3) (`trace_agree`†, txt:240-241, 244-245): sources agreeing before `u`, with keys at `u`
of identical signs against every query key, have the same trace for a run ending at or before
`u`. -/
theorem trace_agree {src₁ src₂ qry : List α} {u : Nat} (hpre : src₁.take u = src₂.take u)
    (hu₁ : u < src₁.length) (hu₂ : u < src₂.length)
    (hsign : ∀ y ∈ qry, compare src₁[u] y = compare src₂[u] y) (hrun : cursor src₁ qry ≤ u) :
    trace src₁ qry = trace src₂ qry := by sorry

end Words

/-- L2.5b (`cursor_eq_scanCount`†): the generic cursor at `Key` is the locked `scanCount`. -/
theorem cursor_eq_scanCount (xs ys : List Key) : scanCount xs ys = cursor xs ys := by sorry

/-! ## N1.2, C1.8a, C1.8, D1.9 — compact words and safe prefixes -/

/-- N1.2: atoms of the generic compact word over labels `α`: `(depth coordinate, marker, label)`,
the label `⊥` marking an empty column. -/
abbrev GAtom (α : Type) := Nat ×ₗ Nat ×ₗ WithBot α

mutual
/-- N1.2: the generic compact word at depth `e` (txt:143-146), with `⊥` in the empty-column
atom so that relabelling commutes with the word. -/
def gwordAt {α : Type} (e : Nat) : Tree α → List (GAtom α)
  | .node cols => gwordCols e cols

def gwordCols {α : Type} (e : Nat) : List (List (α × Tree α)) → List (GAtom α)
  | [] => []
  | col :: rest => gwordCol e col ++ gwordCols e rest

def gwordCol {α : Type} (e : Nat) : List (α × Tree α) → List (GAtom α)
  | [] => [toLex (2 * e, toLex (0, (⊥ : WithBot α)))]
  | (p, h) :: rest =>
    toLex (2 * e, toLex (1, (p : WithBot α))) :: (gwordAt (e + 1) h ++ gwordLater e rest)

def gwordLater {α : Type} (e : Nat) : List (α × Tree α) → List (GAtom α)
  | [] => []
  | (p, h) :: rest =>
    toLex (2 * e + 1, toLex (0, (p : WithBot α))) :: (gwordAt (e + 1) h ++ gwordLater e rest)
end

/-- N1.2. -/
def gword {α : Type} (t : Tree α) : List (GAtom α) := gwordAt 0 t

/-- N1.2: relabelling of an atom. -/
def GAtom.map {α β : Type} (f : α → β) (A : GAtom α) : GAtom β :=
  toLex ((ofLex A).1, toLex ((ofLex (ofLex A).2).1, (ofLex (ofLex A).2).2.map f))

/-- N1.2: the spine's word atoms, read as generic atoms (`⊥` exactly at even depth coordinate and
marker `0`, which only the empty-column atom has). -/
def toGAtom (A : WordAtom) : GAtom Nat :=
  toLex ((ofLex A).1, toLex ((ofLex (ofLex A).2).1,
    if (ofLex A).1 % 2 = 0 ∧ (ofLex (ofLex A).2).1 = 0 then (⊥ : WithBot Nat)
    else ((ofLex (ofLex A).2).2 : WithBot Nat)))

mutual
/-- N1.2 helper: `gword_map` at an arbitrary depth. -/
theorem gwordAt_map {α β : Type} (f : α → β) :
    (e : Nat) → (t : Tree α) → gwordAt e (t.map f) = (gwordAt e t).map (GAtom.map f)
  | e, .node cols => by
    simp only [Tree.map, gwordAt]; exact gwordCols_map f e cols
theorem gwordCols_map {α β : Type} (f : α → β) :
    (e : Nat) → (cs : List (List (α × Tree α))) →
      gwordCols e (Tree.mapCols f cs) = (gwordCols e cs).map (GAtom.map f)
  | _, [] => rfl
  | e, c :: cs => by
    simp only [Tree.mapCols, gwordCols, List.map_append]
    rw [gwordCol_map f e c, gwordCols_map f e cs]
theorem gwordCol_map {α β : Type} (f : α → β) :
    (e : Nat) → (c : List (α × Tree α)) →
      gwordCol e (Tree.mapCol f c) = (gwordCol e c).map (GAtom.map f)
  | _, [] => rfl
  | e, (p, h) :: es => by
    simp only [Tree.mapCol, gwordCol, List.map_cons, List.map_append]
    rw [gwordAt_map f (e + 1) h, gwordLater_map f e es]
    rfl
theorem gwordLater_map {α β : Type} (f : α → β) :
    (e : Nat) → (c : List (α × Tree α)) →
      gwordLater e (Tree.mapCol f c) = (gwordLater e c).map (GAtom.map f)
  | _, [] => rfl
  | e, (p, h) :: es => by
    simp only [Tree.mapCol, gwordLater, List.map_cons, List.map_append]
    rw [gwordAt_map f (e + 1) h, gwordLater_map f e es]
    rfl
end

/-- N1.2: relabelling commutes with the generic word (positions and length are unchanged). -/
theorem gword_map {α β : Type} (f : α → β) (t : Tree α) :
    gword (t.map f) = (gword t).map (GAtom.map f) := gwordAt_map f 0 t

mutual
/-- N1.2 helper: `gword_eq_map_word` at an arbitrary depth. -/
theorem gwordAt_eq_map_wordAt : (e : Nat) → (E : Forest) → gwordAt e E = (wordAt e E).map toGAtom
  | e, .node cols => by
    simp only [gwordAt, wordAt]; exact gwordCols_eq_map_wordCols e cols
theorem gwordCols_eq_map_wordCols :
    (e : Nat) → (cs : List Column) → gwordCols e cs = (wordCols e cs).map toGAtom
  | _, [] => rfl
  | e, c :: cs => by
    simp only [gwordCols, wordCols, List.map_append]
    rw [gwordCol_eq_map_wordCol e c, gwordCols_eq_map_wordCols e cs]
theorem gwordCol_eq_map_wordCol :
    (e : Nat) → (c : Column) → gwordCol e c = (wordCol e c).map toGAtom
  | e, [] => by
    simp [gwordCol, wordCol, toGAtom]
  | e, (p, h) :: es => by
    simp only [gwordCol, wordCol, List.map_cons, List.map_append]
    rw [gwordAt_eq_map_wordAt (e + 1) h, gwordLater_eq_map_wordLater e es]
    simp [toGAtom]; rfl
theorem gwordLater_eq_map_wordLater :
    (e : Nat) → (c : Column) → gwordLater e c = (wordLater e c).map toGAtom
  | _, [] => rfl
  | e, (p, h) :: es => by
    simp only [gwordLater, wordLater, List.map_cons, List.map_append]
    rw [gwordAt_eq_map_wordAt (e + 1) h, gwordLater_eq_map_wordLater e es]
    simp [toGAtom, Nat.add_mod]; rfl
end

/-- N1.2: the spine's word is the generic word with the label decoration forgotten. -/
theorem gword_eq_map_word (E : Forest) : gword E = (word E).map toGAtom :=
  gwordAt_eq_map_wordAt 0 E

theorem mu_eq_length_gword (E : Forest) : mu E = (gword E).length := by
  rw [gword_eq_map_word, List.length_map]; rfl

mutual
/-- C1.8a helper: `gwordAt_fst_ge` together with its column, entry and later-entry forms. -/
theorem gwordAt_fst_ge' {α : Type} : (e : Nat) → (t : Tree α) → ∀ A ∈ gwordAt e t, 2 * e ≤ (ofLex A).1
  | e, .node cols => by simp only [gwordAt]; exact gwordCols_fst_ge e cols
theorem gwordCols_fst_ge {α : Type} :
    (e : Nat) → (cs : List (List (α × Tree α))) → ∀ A ∈ gwordCols e cs, 2 * e ≤ (ofLex A).1
  | _, [] => by simp [gwordCols]
  | e, c :: cs => by
    simp only [gwordCols, List.mem_append]
    rintro A (hA | hA)
    · exact gwordCol_fst_ge e c A hA
    · exact gwordCols_fst_ge e cs A hA
theorem gwordCol_fst_ge {α : Type} :
    (e : Nat) → (c : List (α × Tree α)) → ∀ A ∈ gwordCol e c, 2 * e ≤ (ofLex A).1
  | e, [] => by simp [gwordCol]
  | e, (p, h) :: es => by
    simp only [gwordCol, List.mem_cons, List.mem_append]
    rintro A (rfl | hA | hA)
    · simp
    · have := gwordAt_fst_ge' (e + 1) h A hA; omega
    · exact gwordLater_fst_ge e es A hA
theorem gwordLater_fst_ge {α : Type} :
    (e : Nat) → (c : List (α × Tree α)) → ∀ A ∈ gwordLater e c, 2 * e ≤ (ofLex A).1
  | _, [] => by simp [gwordLater]
  | e, (p, h) :: es => by
    simp only [gwordLater, List.mem_cons, List.mem_append]
    rintro A (rfl | hA | hA)
    · simp
    · have := gwordAt_fst_ge' (e + 1) h A hA; omega
    · exact gwordLater_fst_ge e es A hA
end

/-- C1.8a: every atom of `gwordAt e t` has depth coordinate at least `2e`. -/
theorem gwordAt_fst_ge {α : Type} (e : Nat) (t : Tree α) :
    ∀ A ∈ gwordAt e t, 2 * e ≤ (ofLex A).1 := gwordAt_fst_ge' e t

/-- C1.8a helper: the three-way reading of a comparison `o` of `X` with `Y`; `Q` is what an
`.eq` comparison yields. -/
def CmpTri {β : Type} [LT β] (o : Ordering) (X Y : β) (Q : Prop) : Prop :=
  (o = .lt → X < Y) ∧ (o = .gt → Y < X) ∧ (o = .eq → Q)

theorem CmpTri.mono {β : Type} [LT β] {o : Ordering} {X Y : β} {Q Q' : Prop}
    (h : CmpTri o X Y Q) (hQ : Q → Q') : CmpTri o X Y Q' :=
  ⟨h.1, h.2.1, fun ho => hQ (h.2.2 ho)⟩

/-- C1.8a helper: a common prefix does not change a list comparison. -/
theorem list_append_lt_append_left {β : Type} [LinearOrder β] (l : List β) {xs ys : List β} :
    l ++ xs < l ++ ys ↔ xs < ys := by
  induction l with
  | nil => rfl
  | cons a l ih => rw [List.cons_append, List.cons_append, List.cons_lt_cons_iff, ih]; simp

/-- C1.8a helper: a lexicographic `then` of two three-way comparisons, the second read after a
common (on `.eq`) prefix. -/
theorem CmpTri.then {β : Type} [LinearOrder β] {o₁ o₂ : Ordering} {P P' X Y : List β}
    {Qa Qb : Prop} (h₁ : CmpTri o₁ (P ++ X) (P' ++ Y) Qa) (hP : Qa → P = P')
    (h₂ : CmpTri o₂ X Y Qb) : CmpTri (o₁.then o₂) (P ++ X) (P' ++ Y) (Qa ∧ Qb) := by
  cases o₁ with
  | lt => exact ⟨fun _ => h₁.1 rfl, fun h => by simp [Ordering.then] at h,
      fun h => by simp [Ordering.then] at h⟩
  | gt => exact ⟨fun h => by simp [Ordering.then] at h, fun _ => h₁.2.1 rfl,
      fun h => by simp [Ordering.then] at h⟩
  | eq =>
    have hQa := h₁.2.2 rfl
    obtain rfl := hP hQa
    simp only [Ordering.then]
    exact ⟨fun h => (list_append_lt_append_left P).mpr (h₂.1 h),
      fun h => (list_append_lt_append_left P).mpr (h₂.2.1 h), fun h => ⟨hQa, h₂.2.2 h⟩⟩

/-- C1.8a helper: a continuation whose head is below `b` precedes a list starting at depth
coordinate `≥ b`. -/
theorem headLt_lt {α : Type} [LinearOrder α] {b : Nat} {xs : List (GAtom α)}
    (hxs : ∀ A ∈ xs.head?, (ofLex A).1 < b) {A : GAtom α} (hA : b ≤ (ofLex A).1)
    (Y : List (GAtom α)) : xs < A :: Y := by
  cases xs with
  | nil => exact List.nil_lt_cons _ _
  | cons x xs =>
    have hx := hxs x (by simp)
    exact List.cons_lt_cons_iff.mpr (Or.inl (Prod.Lex.lt_iff.mpr (Or.inl (by omega))))

/-- C1.8a helper: an entry atom against an entry atom at the same position. -/
theorem cmpTri_atom {α : Type} [LinearOrder α] (n m : Nat) (p q : α) (X Y : List (GAtom α)) :
    CmpTri (compare p q) ([toLex (n, toLex (m, (p : WithBot α)))] ++ X)
      ([toLex (n, toLex (m, (q : WithBot α)))] ++ Y) (p = q) := by
  refine ⟨fun h => ?_, fun h => ?_, compare_eq_iff_eq.mp⟩
  · have h := compare_lt_iff_lt.mp h
    refine List.cons_lt_cons_iff.mpr (Or.inl ?_)
    simp only [Prod.Lex.toLex_lt_toLex, lt_irrefl, false_or, true_and]
    exact WithBot.coe_lt_coe.mpr h
  · have h := compare_gt_iff_gt.mp h
    refine List.cons_lt_cons_iff.mpr (Or.inl ?_)
    simp only [Prod.Lex.toLex_lt_toLex, lt_irrefl, false_or, true_and]
    exact WithBot.coe_lt_coe.mpr h

/-- C1.8a helper: the head of a column's word has depth coordinate `2e`. -/
theorem gwordCol_head {α : Type} (e : Nat) (c : List (α × Tree α)) :
    ∃ A rest, gwordCol e c = A :: rest ∧ (ofLex A).1 = 2 * e := by
  cases c with
  | nil => exact ⟨_, _, rfl, rfl⟩
  | cons x es => obtain ⟨p, h⟩ := x; exact ⟨_, _, rfl, rfl⟩

theorem headLt_gwordCols_append {α : Type} (e : Nat) (cs : List (List (α × Tree α)))
    {xs : List (GAtom α)} (hxs : ∀ A ∈ xs.head?, (ofLex A).1 < 2 * e) :
    ∀ A ∈ (gwordCols e cs ++ xs).head?, (ofLex A).1 < 2 * e + 1 := by
  cases cs with
  | nil => intro A hA; have := hxs A hA; omega
  | cons c cs =>
    obtain ⟨B, rest, hc, hB⟩ := gwordCol_head e c
    intro A hA
    simp only [gwordCols, hc, List.cons_append, List.head?_cons, Option.mem_def,
      Option.some.injEq] at hA
    subst hA; omega

theorem headLt_gwordLater_append {α : Type} (e : Nat) (es : List (α × Tree α))
    {xs : List (GAtom α)} (hxs : ∀ A ∈ xs.head?, (ofLex A).1 < 2 * e + 1) :
    ∀ A ∈ (gwordLater e es ++ xs).head?, (ofLex A).1 < 2 * (e + 1) := by
  cases es with
  | nil => intro A hA; have := hxs A hA; omega
  | cons x es =>
    obtain ⟨p, h⟩ := x
    intro A hA
    simp only [gwordLater, List.cons_append, List.head?_cons, Option.mem_def,
      Option.some.injEq] at hA
    subst hA; simp; omega

mutual
/-- C1.8a helper: the three-way form of `gwordAt_append_lt_iff`/`gwordAt_append_inj`, by mutual
structural induction on the left tree (statements Cols(e), Col(e), Later(e) of the plan). -/
theorem gwordAt_tri {α : Type} [LinearOrder α] : (e : Nat) → (s : Tree α) →
    ∀ (t : Tree α) (xs ys : List (GAtom α)), (∀ A ∈ xs.head?, (ofLex A).1 < 2 * e) →
      (∀ A ∈ ys.head?, (ofLex A).1 < 2 * e) →
      CmpTri (Tree.cmp compare s t) (gwordAt e s ++ xs) (gwordAt e t ++ ys) (s = t)
  | e, .node a, .node b, xs, ys, hxs, hys => by
    simp only [Tree.cmp, gwordAt]
    exact (gwordCols_tri e a b xs ys hxs hys).mono fun h => h ▸ rfl
theorem gwordCols_tri {α : Type} [LinearOrder α] : (e : Nat) → (as : List (List (α × Tree α))) →
    ∀ (bs : List (List (α × Tree α))) (xs ys : List (GAtom α)),
      (∀ A ∈ xs.head?, (ofLex A).1 < 2 * e) → (∀ A ∈ ys.head?, (ofLex A).1 < 2 * e) →
      CmpTri (Tree.cmpCols compare as bs) (gwordCols e as ++ xs) (gwordCols e bs ++ ys) (as = bs)
  | _, [], [], _, _, _, _ => ⟨fun h => by simp [Tree.cmpCols] at h,
      fun h => by simp [Tree.cmpCols] at h, fun _ => rfl⟩
  | e, [], b :: bs, xs, ys, hxs, _ => by
    obtain ⟨B, rest, hb, hB⟩ := gwordCol_head e b
    refine ⟨fun _ => ?_, fun h => by simp [Tree.cmpCols] at h, fun h => by simp [Tree.cmpCols] at h⟩
    simp only [gwordCols, hb, List.cons_append, List.nil_append]
    exact headLt_lt hxs (by omega) _
  | e, a :: as, [], xs, ys, _, hys => by
    obtain ⟨B, rest, ha, hB⟩ := gwordCol_head e a
    refine ⟨fun h => by simp [Tree.cmpCols] at h, fun _ => ?_, fun h => by simp [Tree.cmpCols] at h⟩
    simp only [gwordCols, ha, List.cons_append, List.nil_append]
    exact headLt_lt hys (by omega) _
  | e, a :: as, b :: bs, xs, ys, hxs, hys => by
    have h₁ := gwordCol_tri e a b (gwordCols e as ++ xs) (gwordCols e bs ++ ys)
      (headLt_gwordCols_append e as hxs) (headLt_gwordCols_append e bs hys)
    have h₂ := gwordCols_tri e as bs xs ys hxs hys
    simp only [Tree.cmpCols, gwordCols, List.append_assoc]
    exact (h₁.then (fun h => h ▸ rfl) h₂).mono fun ⟨h₁, h₂⟩ => h₁ ▸ h₂ ▸ rfl
theorem gwordCol_tri {α : Type} [LinearOrder α] : (e : Nat) → (a : List (α × Tree α)) →
    ∀ (b : List (α × Tree α)) (xs ys : List (GAtom α)),
      (∀ A ∈ xs.head?, (ofLex A).1 < 2 * e + 1) → (∀ A ∈ ys.head?, (ofLex A).1 < 2 * e + 1) →
      CmpTri (Tree.cmpCol compare a b) (gwordCol e a ++ xs) (gwordCol e b ++ ys) (a = b)
  | _, [], [], _, _, _, _ => ⟨fun h => by simp [Tree.cmpCol] at h,
      fun h => by simp [Tree.cmpCol] at h, fun _ => rfl⟩
  | e, [], (q, k) :: fs, xs, ys, _, _ => by
    refine ⟨fun _ => ?_, fun h => by simp [Tree.cmpCol] at h, fun h => by simp [Tree.cmpCol] at h⟩
    simp only [gwordCol, List.cons_append, List.nil_append]
    exact List.cons_lt_cons_iff.mpr (Or.inl (by simp [Prod.Lex.toLex_lt_toLex]))
  | e, (p, h) :: es, [], xs, ys, _, _ => by
    refine ⟨fun h => by simp [Tree.cmpCol] at h, fun _ => ?_, fun h => by simp [Tree.cmpCol] at h⟩
    simp only [gwordCol, List.cons_append, List.nil_append]
    exact List.cons_lt_cons_iff.mpr (Or.inl (by simp [Prod.Lex.toLex_lt_toLex]))
  | e, (p, h) :: es, (q, k) :: fs, xs, ys, hxs, hys => by
    have h₀ := cmpTri_atom (2 * e) 1 p q (gwordAt (e + 1) h ++ (gwordLater e es ++ xs))
      (gwordAt (e + 1) k ++ (gwordLater e fs ++ ys))
    have h₁ := gwordAt_tri (e + 1) h k (gwordLater e es ++ xs) (gwordLater e fs ++ ys)
      (headLt_gwordLater_append e es hxs) (headLt_gwordLater_append e fs hys)
    have h₂ := gwordLater_tri e es fs xs ys hxs hys
    simp only [Tree.cmpCol, gwordCol, List.cons_append, List.append_assoc, Ordering.then_assoc]
    exact (h₀.then (fun h => h ▸ rfl) (h₁.then (fun h => h ▸ rfl) h₂)).mono
      fun ⟨h₀, h₁, h₂⟩ => h₀ ▸ h₁ ▸ h₂ ▸ rfl
theorem gwordLater_tri {α : Type} [LinearOrder α] : (e : Nat) → (a : List (α × Tree α)) →
    ∀ (b : List (α × Tree α)) (xs ys : List (GAtom α)),
      (∀ A ∈ xs.head?, (ofLex A).1 < 2 * e + 1) → (∀ A ∈ ys.head?, (ofLex A).1 < 2 * e + 1) →
      CmpTri (Tree.cmpCol compare a b) (gwordLater e a ++ xs) (gwordLater e b ++ ys) (a = b)
  | _, [], [], _, _, _, _ => ⟨fun h => by simp [Tree.cmpCol] at h,
      fun h => by simp [Tree.cmpCol] at h, fun _ => rfl⟩
  | e, [], (q, k) :: fs, xs, ys, hxs, _ => by
    refine ⟨fun _ => ?_, fun h => by simp [Tree.cmpCol] at h, fun h => by simp [Tree.cmpCol] at h⟩
    simp only [gwordLater, List.cons_append, List.nil_append]
    exact headLt_lt hxs (by simp) _
  | e, (p, h) :: es, [], xs, ys, _, hys => by
    refine ⟨fun h => by simp [Tree.cmpCol] at h, fun _ => ?_, fun h => by simp [Tree.cmpCol] at h⟩
    simp only [gwordLater, List.cons_append, List.nil_append]
    exact headLt_lt hys (by simp) _
  | e, (p, h) :: es, (q, k) :: fs, xs, ys, hxs, hys => by
    have h₀ := cmpTri_atom (2 * e + 1) 0 p q (gwordAt (e + 1) h ++ (gwordLater e es ++ xs))
      (gwordAt (e + 1) k ++ (gwordLater e fs ++ ys))
    have h₁ := gwordAt_tri (e + 1) h k (gwordLater e es ++ xs) (gwordLater e fs ++ ys)
      (headLt_gwordLater_append e es hxs) (headLt_gwordLater_append e fs hys)
    have h₂ := gwordLater_tri e es fs xs ys hxs hys
    simp only [Tree.cmpCol, gwordLater, List.cons_append, List.append_assoc, Ordering.then_assoc]
    exact (h₀.then (fun h => h ▸ rfl) (h₁.then (fun h => h ▸ rfl) h₂)).mono
      fun ⟨h₀, h₁, h₂⟩ => h₀ ▸ h₁ ▸ h₂ ▸ rfl
end

/-- C1.8a (txt:147-151): with continuations whose first atoms have depth coordinate below `2e`,
comparison of words followed by continuations is comparison of the trees, then of the
continuations. -/
theorem gwordAt_append_lt_iff {α : Type} [LinearOrder α] (e : Nat) (s t : Tree α)
    {xs ys : List (GAtom α)} (hxs : ∀ A ∈ xs.head?, (ofLex A).1 < 2 * e)
    (hys : ∀ A ∈ ys.head?, (ofLex A).1 < 2 * e) :
    gwordAt e s ++ xs < gwordAt e t ++ ys ↔
      Tree.cmp compare s t = .lt ∨ (s = t ∧ xs < ys) := by
  obtain ⟨hlt, hgt, heq⟩ := gwordAt_tri e s t xs ys hxs hys
  constructor
  · intro h
    cases hc : Tree.cmp compare s t with
    | lt => exact Or.inl rfl
    | gt => exact absurd (hgt hc) (lt_asymm h)
    | eq =>
      obtain rfl := heq hc
      exact Or.inr ⟨rfl, (list_append_lt_append_left _).mp h⟩
  · rintro (h | ⟨rfl, h⟩)
    · exact hlt h
    · exact (list_append_lt_append_left _).mpr h

/-- C1.8a: injectivity with continuations. -/
theorem gwordAt_append_inj {α : Type} (e : Nat) {s t : Tree α} {xs ys : List (GAtom α)}
    (hxs : ∀ A ∈ xs.head?, (ofLex A).1 < 2 * e) (hys : ∀ A ∈ ys.head?, (ofLex A).1 < 2 * e)
    (h : gwordAt e s ++ xs = gwordAt e t ++ ys) : s = t ∧ xs = ys := by
  -- any linear order on the labels will do
  letI : LinearOrder α := IsWellOrder.linearOrder WellOrderingRel
  obtain ⟨hlt, hgt, heq⟩ := gwordAt_tri e s t xs ys hxs hys
  cases hc : Tree.cmp compare s t with
  | lt => exact absurd (h ▸ hlt hc) (lt_irrefl _)
  | gt => exact absurd (h ▸ hgt hc) (lt_irrefl _)
  | eq =>
    obtain rfl := heq hc
    exact ⟨rfl, List.append_cancel_left h⟩

/-- C1.8a: the generic word is an order embedding. -/
theorem gword_lt_iff {α : Type} [LinearOrder α] (s t : Tree α) :
    gword s < gword t ↔ Tree.cmp compare s t = .lt := by
  have := gwordAt_append_lt_iff (xs := []) (ys := []) 0 s t (by simp) (by simp)
  simp only [List.append_nil] at this
  unfold gword
  rw [this]
  simp

theorem gword_injective {α : Type} : Function.Injective (gword : Tree α → List (GAtom α)) := by
  intro s t h
  have h' : gwordAt 0 s ++ [] = gwordAt 0 t ++ [] := by
    simp only [List.append_nil]; exact h
  exact (gwordAt_append_inj 0 (by simp) (by simp) h').1

/-- N1.3: a map strictly increasing on the letters that occur preserves list order. -/
theorem list_map_lt_iff {γ δ : Type} [LinearOrder γ] [LinearOrder δ] {f : γ → δ} {S : Set γ}
    (hf : StrictMonoOn f S) {l₁ l₂ : List γ} (h₁ : ∀ x ∈ l₁, x ∈ S) (h₂ : ∀ x ∈ l₂, x ∈ S) :
    l₁.map f < l₂.map f ↔ l₁ < l₂ := by
  induction l₁ generalizing l₂ with
  | nil =>
    cases l₂ with
    | nil => simp
    | cons y ys => simp [List.nil_lt_cons]
  | cons x xs ih =>
    cases l₂ with
    | nil => simp [List.not_lt_nil]
    | cons y ys =>
      have hx : x ∈ S := h₁ x (List.mem_cons_self ..)
      have hy : y ∈ S := h₂ y (List.mem_cons_self ..)
      simp only [List.map_cons, List.cons_lt_cons_iff]
      rw [hf.lt_iff_lt hx hy, hf.injOn.eq_iff hx hy,
        ih (fun z hz => h₁ z (List.mem_cons_of_mem _ hz)) (fun z hz => h₂ z (List.mem_cons_of_mem _ hz))]

/-- N1.3 helper: a comparison with `Y` only reads the first `|Y| + 1` letters. -/
theorem list_lt_iff_take_lt {γ : Type} [LinearOrder γ] :
    ∀ (X Y : List γ), X < Y ↔ X.take (Y.length + 1) < Y
  | _, [] => by simp [List.not_lt_nil]
  | [], _ :: _ => by simp
  | x :: xs, y :: ys => by
    rw [List.length_cons, List.take_succ_cons, List.cons_lt_cons_iff, List.cons_lt_cons_iff,
      list_lt_iff_take_lt xs ys]

/-- N1.3: a comparison with `Y` is decided within the first `|Y| + 1` letters. -/
theorem list_lt_of_take_eq {γ : Type} [LinearOrder γ] {X₁ X₂ Y : List γ}
    (hlen : Y.length < X₁.length) (h : X₁.take (Y.length + 1) = X₂.take (Y.length + 1)) :
    (X₁ < Y ↔ X₂ < Y) ∧ X₁ ≠ Y ∧ X₂ ≠ Y := by
  refine ⟨by rw [list_lt_iff_take_lt X₁, list_lt_iff_take_lt X₂, h], ?_, ?_⟩
  · rintro rfl; exact absurd hlen (lt_irrefl _)
  · rintro rfl
    have h1 := congrArg List.length h
    rw [List.length_take, List.length_take] at h1
    omega

/-- N1.2: the shapes of atoms that occur in words: `(2e, 0, 0)`, `(2e, 1, p)`, `(2e+1, 0, p)`. -/
def WordAtom.WF (A : WordAtom) : Prop :=
  ((ofLex A).1 % 2 = 0 ∧ (((ofLex (ofLex A).2).1 = 0 ∧ (ofLex (ofLex A).2).2 = 0) ∨
      (ofLex (ofLex A).2).1 = 1)) ∨
    ((ofLex A).1 % 2 = 1 ∧ (ofLex (ofLex A).2).1 = 0)

mutual
/-- N1.2 helper: `word_wf` at an arbitrary depth. -/
theorem wordAt_wf : (e : Nat) → (E : Forest) → ∀ A ∈ wordAt e E, A.WF
  | e, .node cols => by
    simp only [wordAt]; exact wordCols_wf e cols
theorem wordCols_wf : (e : Nat) → (cs : List Column) → ∀ A ∈ wordCols e cs, A.WF
  | _, [] => by simp [wordCols]
  | e, c :: cs => by
    simp only [wordCols, List.mem_append]
    rintro A (hA | hA)
    · exact wordCol_wf e c A hA
    · exact wordCols_wf e cs A hA
theorem wordCol_wf : (e : Nat) → (c : Column) → ∀ A ∈ wordCol e c, A.WF
  | e, [] => by simp [wordCol, WordAtom.WF]
  | e, (p, h) :: es => by
    simp only [wordCol, List.mem_cons, List.mem_append]
    rintro A (rfl | hA | hA)
    · simp [WordAtom.WF]
    · exact wordAt_wf (e + 1) h A hA
    · exact wordLater_wf e es A hA
theorem wordLater_wf : (e : Nat) → (c : Column) → ∀ A ∈ wordLater e c, A.WF
  | _, [] => by simp [wordLater]
  | e, (p, h) :: es => by
    simp only [wordLater, List.mem_cons, List.mem_append]
    rintro A (rfl | hA | hA)
    · simp [WordAtom.WF, Nat.add_mod]
    · exact wordAt_wf (e + 1) h A hA
    · exact wordLater_wf e es A hA
end

/-- N1.2: every atom of a word is well formed. -/
theorem word_wf (E : Forest) : ∀ A ∈ word E, A.WF := wordAt_wf 0 E

/-- N1.2: `toGAtom` is strictly increasing on well-formed atoms. -/
theorem toGAtom_strictMonoOn : StrictMonoOn toGAtom {A : WordAtom | A.WF} := by
  rintro ⟨a, b, c⟩ hA ⟨a', b', c'⟩ hB hlt
  change toLex (a, toLex (b, c)) < toLex (a', toLex (b', c')) at hlt
  change toLex (a, toLex (b, _)) < toLex (a', toLex (b', _))
  simp only [Prod.Lex.toLex_lt_toLex] at hlt ⊢
  rcases hlt with h | ⟨rfl, h | ⟨rfl, h⟩⟩
  · exact Or.inl h
  · exact Or.inr ⟨rfl, Or.inl h⟩
  · refine Or.inr ⟨rfl, Or.inr ⟨rfl, ?_⟩⟩
    by_cases hz : a % 2 = 0 ∧ b = 0
    · exfalso
      have : c = 0 ∧ c' = 0 := by
        change (a % 2 = 0 ∧ (b = 0 ∧ c = 0 ∨ b = 1)) ∨ (a % 2 = 1 ∧ b = 0) at hA
        change (a % 2 = 0 ∧ (b = 0 ∧ c' = 0 ∨ b = 1)) ∨ (a % 2 = 1 ∧ b = 0) at hB
        omega
      omega
    · change (if a % 2 = 0 ∧ b = 0 then (⊥ : WithBot Nat) else (c : WithBot Nat)) <
        (if a % 2 = 0 ∧ b = 0 then (⊥ : WithBot Nat) else (c' : WithBot Nat))
      rw [if_neg hz, if_neg hz]
      exact WithBot.coe_lt_coe.mpr h

-- provides: U1, C1.8 (moved from `Spine.lean`: the proof uses N1.2, N1.3 and C1.8a)
theorem word_lt_iff (E F : Forest) : word E < word F ↔ E < F := by
  rw [← list_map_lt_iff toGAtom_strictMonoOn (word_wf E) (word_wf F), ← gword_eq_map_word,
    ← gword_eq_map_word]
  exact gword_lt_iff E F
-- provides: U1, C1.8 (moved from `Spine.lean`)
theorem word_injective : Function.Injective word := by
  intro E F h
  apply gword_injective
  rw [gword_eq_map_word, gword_eq_map_word, h]

-- bridge: holds by `rfl` (SCR-2 applied)
theorem safePrefix_eq_body (E : Forest) (k : Nat) : safePrefix E k = safePrefixBody E k := rfl

mutual
/-- D1.9a helper: `spF_spec` with its column, entry and later-entry forms. -/
theorem spF_spec' : (e k : Nat) → (E : Forest) →
    wordAt e (spF k E).1 = (wordAt e E).take k ∧ (spF k E).2 = k - (wordAt e E).length
  | e, k, .node cols => by simp only [spF, wordAt]; exact spCols_spec e k cols
theorem spCols_spec : (e k : Nat) → (cs : List Column) →
    wordCols e (spCols k cs).1 = (wordCols e cs).take k ∧ (spCols k cs).2 = k - (wordCols e cs).length
  | _, k, [] => by simp [spCols, wordCols]
  | e, k, col :: rest => by
    by_cases hk : k = 0
    · subst hk; simp [spCols, wordCols]
    · obtain ⟨h1, h2⟩ := spCol_spec e k col (by omega)
      obtain ⟨h3, h4⟩ := spCols_spec e (spCol k col).2 rest
      simp only [spCols, if_neg hk, wordCols, List.take_append, List.length_append]
      rw [h1, h3, h4, h2]
      exact ⟨rfl, by omega⟩
theorem spCol_spec : (e k : Nat) → (col : Column) → 1 ≤ k →
    wordCol e (spCol k col).1 = (wordCol e col).take k ∧ (spCol k col).2 = k - (wordCol e col).length
  | e, k, [], hk => by
    obtain ⟨k, rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
    simp [spCol, wordCol]
  | e, k, (p, h) :: rest, hk => by
    obtain ⟨k, rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
    obtain ⟨h1, h2⟩ := spF_spec' (e + 1) k h
    obtain ⟨h3, h4⟩ := spLater_spec e (spF k h).2 rest
    simp only [spCol, wordCol, Nat.add_sub_cancel, List.take_succ_cons, List.take_append,
      List.length_cons, List.length_append]
    rw [h1, h3, h4, h2]
    exact ⟨rfl, by omega⟩
theorem spLater_spec : (e k : Nat) → (col : Column) →
    wordLater e (spLater k col).1 = (wordLater e col).take k ∧
      (spLater k col).2 = k - (wordLater e col).length
  | _, k, [] => by simp [spLater, wordLater]
  | e, k, (p, h) :: rest => by
    by_cases hk : k = 0
    · subst hk; simp [spLater, wordLater]
    · obtain ⟨k, rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
      obtain ⟨h1, h2⟩ := spF_spec' (e + 1) k h
      obtain ⟨h3, h4⟩ := spLater_spec e (spF k h).2 rest
      simp only [spLater, if_neg hk, wordLater, Nat.add_sub_cancel, List.take_succ_cons,
        List.take_append, List.length_cons, List.length_append]
      rw [h1, h3, h4, h2]
      exact ⟨rfl, by omega⟩
end

/-- D1.9a: the budget bookkeeping of `spF` (the invariant behind `word_safePrefix`):
`word (spF k E).1 = (word E).take k` and the unused budget is `k - µ(E)`. -/
theorem spF_spec (e k : Nat) (E : Forest) :
    wordAt e (spF k E).1 = (wordAt e E).take k ∧ (spF k E).2 = k - (wordAt e E).length :=
  spF_spec' e k E

-- provides: U1, D1.9 (moved from `Spine.lean`: the proof uses `spF_spec`)
theorem word_safePrefix (E : Forest) (k : Nat) : word (safePrefix E k) = (word E).take k :=
  (spF_spec 0 k E).1

/-- D1.9: a safe prefix of full length is the whole forest. -/
theorem safePrefix_of_le {E : Forest} {k : Nat} (hk : mu E ≤ k) : safePrefix E k = E := by
  apply word_injective
  rw [word_safePrefix]
  exact List.take_of_length_le hk

/-- D1.9 helper: a list is never smaller than one of its prefixes. -/
theorem list_not_lt_prefix {β : Type} [LinearOrder β] {p l : List β} (h : p <+: l) : ¬ l < p := by
  obtain ⟨r, rfl⟩ := h
  induction p with
  | nil => exact List.not_lt_nil _
  | cons a p ih => rw [List.cons_append, List.cons_lt_cons_iff]; simpa using ih

/-- D1.9: a safe prefix is `≤` the forest (by `word_safePrefix` and `word_lt_iff`). -/
theorem safePrefix_le (E : Forest) (k : Nat) : safePrefix E k ≤ E := by
  rw [Forest.le_iff_cmp]
  intro hgt
  have h := (gwordAt_tri 0 (safePrefix E k) E [] [] (by simp) (by simp)).2.1 hgt
  simp only [List.append_nil] at h
  change gword E < gword (safePrefix E k) at h
  rw [gword_eq_map_word, gword_eq_map_word, word_safePrefix] at h
  exact list_not_lt_prefix ((List.take_prefix k (word E)).map toGAtom) h

/-- D1.9 helper: kept later entries keep their parent; their heights are budgeted walks. -/
theorem spLater_getElem? : ∀ (k : Nat) (es : Column) (n : Nat) (x' : Nat × Forest),
    (spLater k es).1[n]? = some x' → ∃ x k', es[n]? = some x ∧ x' = (x.1, (spF k' x.2).1)
  | _, [], n, x', h => by simp [spLater] at h
  | k, (p, H) :: rest, n, x', h => by
    by_cases hk : k = 0
    · subst hk; simp [spLater] at h
    · simp only [spLater, if_neg hk] at h
      cases n with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq] at h
        exact ⟨(p, H), k - 1, rfl, h.symm⟩
      | succ n =>
        simp only [List.getElem?_cons_succ] at h
        obtain ⟨x, k', h1, h2⟩ := spLater_getElem? _ rest n x' h
        exact ⟨x, k', by simpa using h1, h2⟩

theorem spLater_length : ∀ (k : Nat) (es : Column), (spLater k es).1.length ≤ es.length
  | _, [] => by simp [spLater]
  | k, (p, H) :: rest => by
    by_cases hk : k = 0
    · subst hk; simp [spLater]
    · simp only [spLater, if_neg hk, List.length_cons]
      have := spLater_length (spF (k - 1) H).2 rest
      omega

/-- D1.9 helper: kept entries of a column keep their parent; their heights are budgeted walks. -/
theorem spCol_getElem? (k : Nat) (col : Column) (n : Nat) (x' : Nat × Forest)
    (h : (spCol k col).1[n]? = some x') : ∃ x k', col[n]? = some x ∧ x' = (x.1, (spF k' x.2).1) := by
  cases col with
  | nil => simp [spCol] at h
  | cons x rest =>
    obtain ⟨p, H⟩ := x
    simp only [spCol] at h
    cases n with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.some.injEq] at h
      exact ⟨(p, H), k - 1, rfl, h.symm⟩
    | succ n =>
      simp only [List.getElem?_cons_succ] at h
      obtain ⟨x, k', h1, h2⟩ := spLater_getElem? _ rest n x' h
      exact ⟨x, k', by simpa using h1, h2⟩

theorem spCol_length (k : Nat) (col : Column) : (spCol k col).1.length ≤ col.length := by
  cases col with
  | nil => simp [spCol]
  | cons x rest =>
    obtain ⟨p, H⟩ := x
    simp only [spCol, List.length_cons]
    have := spLater_length (spF (k - 1) H).2 rest
    omega

theorem spCol_eq_nil (k : Nat) (col : Column) (h : (spCol k col).1 = []) : col = [] := by
  cases col with
  | nil => rfl
  | cons x rest => obtain ⟨p, H⟩ := x; simp [spCol] at h

/-- D1.9 helper: kept columns are budgeted walks of the columns with a positive budget. -/
theorem spCols_getElem? : ∀ (k : Nat) (cs : List Column) (n : Nat) (col' : Column),
    (spCols k cs).1[n]? = some col' → ∃ col k', 1 ≤ k' ∧ cs[n]? = some col ∧ col' = (spCol k' col).1
  | _, [], n, col', h => by simp [spCols] at h
  | k, col :: rest, n, col', h => by
    by_cases hk : k = 0
    · subst hk; simp [spCols] at h
    · simp only [spCols, if_neg hk] at h
      cases n with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq] at h
        exact ⟨col, k, by omega, rfl, h.symm⟩
      | succ n =>
        simp only [List.getElem?_cons_succ] at h
        obtain ⟨c, k', h0, h1, h2⟩ := spCols_getElem? _ rest n col' h
        exact ⟨c, k', h0, by simpa using h1, h2⟩

/-- D1.9 helper: every forest of a safe prefix is a budgeted walk of the forest at the same
address. -/
theorem forestAt_spF : ∀ (ρ : List (Nat × Nat)) (k : Nat) (E F' : Forest),
    (spF k E).1.forestAt ρ = some F' → ∃ F k', E.forestAt ρ = some F ∧ F' = (spF k' F).1
  | [], k, E, F', h => ⟨E, k, rfl, (Option.some.inj h).symm⟩
  | (c, i) :: ρ, k, .node cols, F', h => by
    rw [Tree.forestAt_cons] at h
    rw [Tree.forestAt_cons]
    simp only [spF, Tree.cols] at h ⊢
    cases hc : (spCols k cols).1[c]? with
    | none => rw [hc] at h; simp at h
    | some col' =>
      obtain ⟨col, k₁, -, hcol, rfl⟩ := spCols_getElem? k cols c col' hc
      rw [hc, Option.bind_some] at h
      cases hi : (spCol k₁ col).1[i]? with
      | none => rw [hi] at h; simp at h
      | some x' =>
        obtain ⟨x, k₂, hx, rfl⟩ := spCol_getElem? k₁ col i x' hi
        rw [hi, Option.bind_some] at h
        obtain ⟨F, k', hF, rfl⟩ := forestAt_spF ρ k₂ x.2 F' h
        exact ⟨F, k', by simp [hcol, hx, hF], rfl⟩

/-- D1.9 (txt:152-153): every column of a safe prefix is a prefix of the corresponding column,
nonempty if the original column is nonempty; every kept entry keeps its parent and its height is
a safe prefix of the original height. -/
theorem colAt_safePrefix {E : Forest} {k : Nat} {c : ColAddr} {col' : Column}
    (h : (safePrefix E k).colAt c = some col') :
    ∃ col, E.colAt c = some col ∧ col'.length ≤ col.length ∧ (col' = [] → col = []) ∧
      ∀ (i p' : Nat) (H' : Forest), col'[i]? = some (p', H') →
        ∃ (H : Forest) (j : Nat), col[i]? = some (p', H) ∧ H' = safePrefix H j := by
  unfold Tree.colAt at h
  cases hf : (safePrefix E k).forestAt c.path with
  | none => rw [hf] at h; simp at h
  | some F' =>
    rw [hf, Option.bind_some] at h
    obtain ⟨⟨cols⟩, k', hF, rfl⟩ := forestAt_spF c.path k E F' hf
    simp only [spF, Tree.cols] at h
    obtain ⟨col, k₁, -, hcol, rfl⟩ := spCols_getElem? k' cols c.col col' h
    refine ⟨col, by simp only [Tree.colAt, hF, Option.bind_some]; exact hcol,
      spCol_length k₁ col, spCol_eq_nil k₁ col,
      fun i p' H' hi => ?_⟩
    obtain ⟨x, k₂, hx, hx'⟩ := spCol_getElem? k₁ col i _ hi
    obtain ⟨q, H⟩ := x
    simp only [Prod.mk.injEq] at hx'
    obtain ⟨rfl, rfl⟩ := hx'
    exact ⟨H, k₂, hx, rfl⟩

/-- D1.9a helper: the word of a list of columns splits over an append (the D1.5a helper
`wordCols_append` comes later in the file). -/
theorem wordCols_append' (d : Nat) (l₁ l₂ : List Column) :
    wordCols d (l₁ ++ l₂) = wordCols d l₁ ++ wordCols d l₂ := by
  induction l₁ with
  | nil => rfl
  | cons c l ih => simp only [List.cons_append, wordCols, ih, List.append_assoc]

/-- D1.9a helper: the word of later entries splits over an append. -/
theorem wordLater_append (d : Nat) (l₁ l₂ : Column) :
    wordLater d (l₁ ++ l₂) = wordLater d l₁ ++ wordLater d l₂ := by
  induction l₁ with
  | nil => rfl
  | cons x l ih => obtain ⟨p, h⟩ := x; simp only [List.cons_append, wordLater, ih, List.append_assoc]

/-- D1.9a helper: the word of a column with a nonempty first part. -/
theorem wordCol_append_of_ne_nil (d : Nat) {l₁ : Column} (h : l₁ ≠ []) (l₂ : Column) :
    wordCol d (l₁ ++ l₂) = wordCol d l₁ ++ wordLater d l₂ := by
  cases l₁ with
  | nil => exact absurd rfl h
  | cons x l => obtain ⟨p, H⟩ := x; simp only [List.cons_append, wordCol, wordLater_append, List.append_assoc]

/-- D1.9a helper: cutting a column after entry `|es₁|`, whose height is replaced by one with a
prefix word, gives a prefix of the column's word. -/
theorem wordCol_cut_prefix (d : Nat) (es₁ : Column) (q : Nat) {H H' : Forest} (es₂ : Column)
    (hH : wordAt (d + 1) H' <+: wordAt (d + 1) H) :
    wordCol d (es₁ ++ [(q, H')]) <+: wordCol d (es₁ ++ (q, H) :: es₂) := by
  cases es₁ with
  | nil =>
    simp only [List.nil_append, wordCol, wordLater, List.append_nil, List.cons_prefix_cons, true_and]
    exact hH.trans (List.prefix_append _ _)
  | cons x l =>
    rw [wordCol_append_of_ne_nil d (List.cons_ne_nil x l),
      wordCol_append_of_ne_nil d (List.cons_ne_nil x l), List.prefix_append_right_inj]
    simp only [wordLater, List.append_nil, List.cons_prefix_cons, true_and]
    exact hH.trans (List.prefix_append _ _)

/-- D1.9a helper: `truncAux` at a present entry gives a prefix of the word, at every depth. -/
theorem wordAt_truncAux_prefix : ∀ (ρ : List (Nat × Nat)) (s : Forest) (j i d : Nat)
    (x : Nat × Forest), s.entryAt ⟨⟨ρ, j⟩, i⟩ = some x → wordAt d (Tree.truncAux ρ j i s) <+: wordAt d s
  | [], .node cols, j, i, d, x, he => by
    rw [Tree.entryAt_eq_bind] at he
    simp only [Tree.forestAt, Option.bind_some, Tree.cols] at he
    cases hc : cols[j]? with
    | none => rw [hc] at he; simp at he
    | some col =>
      rw [hc, Option.bind_some] at he
      obtain ⟨cols₁, cols₂, rfl, rfl⟩ := Tree.exists_split_of_getElem? hc
      obtain ⟨es₁, es₂, rfl, rfl⟩ := Tree.exists_split_of_getElem? he
      obtain ⟨q, H⟩ := x
      simp [Tree.truncAux, wordAt, wordCols_append', wordCols, List.getD_eq_getElem?_getD,
        List.take_append, List.take_of_length_le]
      exact (wordCol_cut_prefix d es₁ q es₂ (List.prefix_refl _)).trans (List.prefix_append _ _)
  | (c₀, i₀) :: ρ, .node cols, j, i, d, x, he => by
    rw [Tree.entryAt_eq_bind, Tree.forestAt_cons] at he
    simp only [Tree.cols] at he
    cases hc : cols[c₀]? with
    | none => rw [hc] at he; simp at he
    | some col =>
      rw [hc, Option.bind_some] at he
      cases hi : col[i₀]? with
      | none => rw [hi] at he; simp at he
      | some y =>
        obtain ⟨p₀, h₀⟩ := y
        rw [hi, Option.bind_some] at he
        replace he : h₀.entryAt ⟨⟨ρ, j⟩, i⟩ = some x := by rw [Tree.entryAt_eq_bind]; exact he
        have ih := wordAt_truncAux_prefix ρ h₀ j i (d + 1) x he
        obtain ⟨cols₁, cols₂, rfl, rfl⟩ := Tree.exists_split_of_getElem? hc
        obtain ⟨es₁, es₂, rfl, rfl⟩ := Tree.exists_split_of_getElem? hi
        simp [Tree.truncAux, wordAt, wordCols_append', wordCols, List.getD_eq_getElem?_getD]
        exact (wordCol_cut_prefix d es₁ p₀ es₂ ih).trans (List.prefix_append _ _)

/-- D1.9a: the word of a truncation after an entry is a prefix of the word. -/
theorem word_truncAfter_prefix (E : Forest) (e : EntryAddr) : word (E.truncAfter e) <+: word E := by
  rw [Tree.truncAfter_eq_body, Tree.truncAfterBody]
  split_ifs with hs
  · obtain ⟨x, hx⟩ := Option.isSome_iff_exists.mp hs
    exact wordAt_truncAux_prefix e.col.path E e.col.col e.idx 0 x hx
  · exact List.prefix_refl _

-- provides: U1, D1.9 (`truncAfter` is a safe prefix; moved from `Spine.lean`: the proof uses
-- `word_truncAfter_prefix`, `word_safePrefix` and `word_injective`)
theorem truncAfter_safePrefix {E : Forest} {e : EntryAddr} (he : e ∈ E.entryAddrs) :
    ∃ k, E.truncAfter e = safePrefix E k := by
  clear he
  refine ⟨(word (E.truncAfter e)).length, word_injective ?_⟩
  rw [word_safePrefix]
  exact List.prefix_iff_eq_take.mp (word_truncAfter_prefix E e)

/-- L2.5c (`sign_of_agreement`†, txt:246-249): if two height words agree for more atoms than the
length of a query height, their normalized comparisons with it have the same strict sign; the
thresholds are arbitrary. -/
theorem sign_of_agreement (r t : Nat) {A₁ A₂ J : Forest} (hlen : mu J < mu A₁)
    (hagree : (word A₁).take (mu J + 1) = (word A₂).take (mu J + 1)) :
    keyCmp (relKey r A₁) (relKey t J) = keyCmp (relKey r A₂) (relKey t J) ∧
      keyCmp (relKey r A₁) (relKey t J) ≠ .eq := by sorry

-- U1-verify: changed (new declaration)
/-- L2.5c, key-system form: the sign hypothesis `hsign` of `trace_agree` at `α = WithTop Key`,
for one query key. -/
theorem sign_of_agreement_compare (r t : Nat) {A₁ A₂ J : Forest} (hlen : mu J < mu A₁)
    (hagree : (word A₁).take (mu J + 1) = (word A₂).take (mu J + 1)) :
    compare ((relKey r A₁ : Key) : WithTop Key) ((relKey t J : Key) : WithTop Key) =
      compare ((relKey r A₂ : Key) : WithTop Key) ((relKey t J : Key) : WithTop Key) := by sorry

/-! ## D1.5a — shifts and the continuation hole (S-6) -/

theorem shiftVal_zero (r p : Nat) : shiftVal r 0 p = p := by
  unfold shiftVal; split <;> rfl

/-- D1.5a helper: `shiftVal r 0` is the identity function. -/
theorem shiftVal_zero_fun (r : Nat) : shiftVal r 0 = id := funext (shiftVal_zero r)

mutual
/-- D1.5a helper: `Tree.map id` is the identity. -/
theorem treeMap_id {α : Type} : (t : Tree α) → Tree.map id t = t
  | .node cols => by
    simp only [Tree.map]; rw [treeMapCols_id]
theorem treeMapCols_id {α : Type} :
    (cs : List (List (α × Tree α))) → Tree.mapCols id cs = cs
  | [] => rfl
  | c :: cs => by
    simp only [Tree.mapCols]; rw [treeMapCol_id, treeMapCols_id]
theorem treeMapCol_id {α : Type} :
    (c : List (α × Tree α)) → Tree.mapCol id c = c
  | [] => rfl
  | (p, h) :: es => by
    simp only [Tree.mapCol]; rw [treeMap_id, treeMapCol_id]; rfl
end

/-- D1.5a. -/
theorem shift_zero (r : Nat) (F : Forest) : shift r 0 F = F := by
  unfold shift; rw [shiftVal_zero_fun]; exact treeMap_id F

mutual
/-- D1.5a helper: relabellings compose. -/
theorem treeMap_map {α β γ : Type} (f : β → γ) (g : α → β) :
    (t : Tree α) → Tree.map f (Tree.map g t) = Tree.map (f ∘ g) t
  | .node cols => by
    simp only [Tree.map]; rw [treeMapCols_map]
theorem treeMapCols_map {α β γ : Type} (f : β → γ) (g : α → β) :
    (cs : List (List (α × Tree α))) → Tree.mapCols f (Tree.mapCols g cs) = Tree.mapCols (f ∘ g) cs
  | [] => rfl
  | c :: cs => by
    simp only [Tree.mapCols]; rw [treeMapCol_map, treeMapCols_map]
theorem treeMapCol_map {α β γ : Type} (f : β → γ) (g : α → β) :
    (c : List (α × Tree α)) → Tree.mapCol f (Tree.mapCol g c) = Tree.mapCol (f ∘ g) c
  | [] => rfl
  | (p, h) :: es => by
    simp only [Tree.mapCol]; rw [treeMap_map, treeMapCol_map]; rfl
end

/-- D1.5a helper: `shiftVal` at one threshold composes additively. -/
theorem shiftVal_add (r d d' : Nat) : shiftVal r d ∘ shiftVal r d' = shiftVal r (d + d') := by
  funext p; simp only [Function.comp, shiftVal]; split_ifs <;> omega

/-- D1.5a: shifts at one threshold compose additively. -/
theorem shift_add (r d d' : Nat) (F : Forest) : shift r d (shift r d' F) = shift r (d + d') F := by
  unfold shift; rw [treeMap_map, shiftVal_add]

/-- D1.5a: `mapLast` (locked) in list form. -/
theorem mapLast_eq {γ δ : Type} (f g : γ → δ) (l : List γ) :
    mapLast f g l = l.dropLast.map f ++ (l.getLast?.map g).toList :=
  match l with
  | [] => by simp [mapLast]
  | [x] => by simp [mapLast]
  | x :: y :: ys => by rw [mapLast, mapLast_eq f g (y :: ys)]; simp

/-- D1.5a: the unshifted placement of `Z` into the hole (`A_{0,0,depth,Z}`). -/
def Hole.put (h : Hole) (Z : Forest) : Forest := replaceAt 0 0 Z h.depth h.outer

/-- D1.5a helper: `Tree.mapCols` in list form. -/
theorem treeMapCols_eq_map {α β : Type} (f : α → β) (cs : List (List (α × Tree α))) :
    Tree.mapCols f cs = cs.map (Tree.mapCol f) := by
  induction cs with
  | nil => rfl
  | cons c cs ih => simp only [Tree.mapCols, List.map_cons, ih]

/-- D1.5a helper: `Tree.mapCol` in list form. -/
theorem treeMapCol_eq_map {α β : Type} (f : α → β) (c : List (α × Tree α)) :
    Tree.mapCol f c = c.map (fun x => (f x.1, Tree.map f x.2)) := by
  induction c with
  | nil => rfl
  | cons x c ih => obtain ⟨p, h⟩ := x; simp only [Tree.mapCol, List.map_cons, ih]

/-- D1.5a helper: `mapLast` after a `map`. -/
theorem mapLast_map {γ δ ε : Type} (f g : δ → ε) (h : γ → δ) (l : List γ) :
    mapLast f g (l.map h) = mapLast (f ∘ h) (g ∘ h) l := by
  rw [mapLast_eq, mapLast_eq]; simp [List.map_dropLast, Option.map_map]

/-- D1.5a helper: `Tree.mapCol id` is the identity function. -/
theorem treeMapCol_id_fun {α : Type} : Tree.mapCol (α := α) id = id := funext treeMapCol_id

/-- D1.5a helper: `A_{r,d,k,Z}(F) = A_{0,0,k,Z}(T_{r,d}(F))`, by induction on `k` following the
locked `replaceAt`. -/
theorem replaceAt_eq_shift (r d : Nat) (Z : Forest) :
    ∀ (k : Nat) (F : Forest), replaceAt r d Z k F = replaceAt 0 0 Z k (shift r d F)
  | 0, .node [] => by simp [replaceAt, shift, Tree.map, Tree.mapCols]
  | 0, .node (c :: cs) => by
    simp only [replaceAt, shift, Tree.map, Tree.mapCols]
    rw [shiftVal_zero_fun 0, treeMapCol_id_fun, List.map_id, treeMapCols_eq_map, ← List.map_cons,
      List.map_dropLast]
  | k + 1, .node cols => by
    simp only [replaceAt, shift, Tree.map]
    rw [shiftVal_zero_fun 0, treeMapCol_id_fun, treeMapCols_eq_map, mapLast_map]
    congr 1
    congr 1
    funext c
    rw [Function.comp, treeMapCol_eq_map, mapLast_map]
    congr 1
    · funext x; simp only [Function.comp, id, treeMap_id]
    · funext x
      simp only [Function.comp, id]
      rw [replaceAt_eq_shift r d Z k x.2]
      rfl

/-- D1.5a (fill/shift law): `A_{r,d,ℓ,Z}(F)` is `T_{r,d}(F)` with `Z` placed unshifted. -/
theorem Hole.fill_eq_put (h : Hole) (r d : Nat) (Z : Forest) :
    h.fill r d Z = (⟨shift r d h.outer, h.depth⟩ : Hole).put Z :=
  replaceAt_eq_shift r d Z h.depth h.outer

theorem Hole.fill_zero (h : Hole) (Z : Forest) : h.fill 0 0 Z = h.put Z := by
  rw [Hole.fill_eq_put, shift_zero]

/-- D1.5a helper: the word of a list of columns splits over an append. -/
theorem wordCols_append (e : Nat) (l₁ l₂ : List Column) :
    wordCols e (l₁ ++ l₂) = wordCols e l₁ ++ wordCols e l₂ := by
  induction l₁ with
  | nil => rfl
  | cons c l ih => simp only [List.cons_append, wordCols, ih, List.append_assoc]

/-- D1.5a helper: the height of the last later entry is read last. -/
theorem wordLater_snoc (e : Nat) (l : Column) (q : Nat) (H : Forest) :
    wordLater e (l ++ [(q, H)]) = wordLater e (l ++ [(q, Tree.empty)]) ++ wordAt (e + 1) H := by
  induction l with
  | nil => simp [wordLater, Tree.empty, wordAt, wordCols]
  | cons x l ih =>
    obtain ⟨p, h⟩ := x
    simp only [List.cons_append, wordLater, ih, List.append_assoc]

/-- D1.5a helper: the height of the last entry of a column is read last. -/
theorem wordCol_snoc (e : Nat) (l : Column) (q : Nat) (H : Forest) :
    wordCol e (l ++ [(q, H)]) = wordCol e (l ++ [(q, Tree.empty)]) ++ wordAt (e + 1) H := by
  cases l with
  | nil => simp [wordCol, wordLater, Tree.empty, wordAt, wordCols]
  | cons x l =>
    obtain ⟨p, h⟩ := x
    simp only [List.cons_append, wordCol]
    rw [wordLater_snoc]
    simp only [List.append_assoc]

/-- D1.5a helper: a forest with a nonempty route has columns. -/
theorem routeColsAux_pos {fuel : Nat} {F : Forest} {π : List (Nat × Nat)}
    (h : 0 < (routeColsAux fuel F π).length) : F.cols ≠ [] := by
  cases fuel with
  | zero => simp [routeColsAux] at h
  | succ f =>
    rw [routeColsAux] at h
    intro hF
    rw [hF] at h
    simp at h

/-- D1.5a helper: a route longer than `k + 1` continues into the height of the last entry of a
nonempty last column. -/
theorem routeColsAux_succ_lt {fuel : Nat} {F : Forest} {π : List (Nat × Nat)} {k : Nat}
    (h : k + 1 < (routeColsAux fuel F π).length) :
    ∃ fuel' col p H, fuel = fuel' + 1 ∧ F.cols.getLast? = some col ∧ col.getLast? = some (p, H) ∧
      k < (routeColsAux fuel' H (π ++ [(F.cols.length - 1, col.length - 1)])).length := by
  cases fuel with
  | zero => simp [routeColsAux] at h
  | succ f =>
    rw [routeColsAux] at h
    cases hc : F.cols.getLast? with
    | none => simp [hc] at h
    | some col =>
      simp only [hc] at h
      cases hl : col.getLast? with
      | none => simp [hl] at h
      | some ph =>
        obtain ⟨p, H⟩ := ph
        simp only [hl, List.length_cons] at h
        exact ⟨f, col, p, H, rfl, rfl, hl, by omega⟩

/-- D1.5a helper: `word_put` at an arbitrary depth coordinate `e` and fuel. -/
theorem wordAt_replaceAt (Z : Forest) :
    ∀ (k fuel : Nat) (F : Forest) (π : List (Nat × Nat)) (e : Nat),
      k < (routeColsAux fuel F π).length →
      wordAt e (replaceAt 0 0 Z k F) = wordAt e (replaceAt 0 0 Tree.empty k F) ++ wordAt (e + k) Z
  | 0, fuel, .node cols, π, e, h => by
    have hne := routeColsAux_pos h
    obtain ⟨zc⟩ := Z
    cases cols with
    | nil => exact absurd rfl hne
    | cons c cs =>
      simp only [replaceAt, wordAt, Tree.cols, Tree.empty, List.append_nil, wordCols_append,
        Nat.add_zero]
  | k + 1, fuel, .node cols, π, e, h => by
    obtain ⟨fuel', col, p, H, rfl, hc, hl, hk⟩ := routeColsAux_succ_lt h
    have ih := wordAt_replaceAt Z k fuel' H _ (e + 1) hk
    simp only [Tree.cols] at hc
    simp only [replaceAt, mapLast_eq, hc, hl, Option.map_some, Option.toList_some, wordAt,
      wordCols_append, wordCols, List.append_nil]
    rw [wordCol_snoc, wordCol_snoc e _ _ (replaceAt 0 0 Tree.empty k H), ih]
    simp only [List.append_assoc]
    rw [show e + 1 + k = e + (k + 1) by omega]

/-- D1.5a: the word of a filled hole is the word with the hole emptied, followed by the word of
`Z` at the hole's depth (the hole column is the last thing in reading order). -/
theorem word_put (h : Hole) (Z : Forest) (hd : h.depth < (routeCols h.outer).length) :
    word (h.put Z) = word (h.put Tree.empty) ++ wordAt h.depth Z := by
  have := wordAt_replaceAt Z h.depth _ h.outer [] 0 hd
  rw [Nat.zero_add] at this
  exact this

/-- D1.5a: the generic word of a shift relabels the generic word. -/
theorem gword_shift (r d : Nat) (F : Forest) :
    gword (shift r d F) = (gword F).map (GAtom.map (shiftVal r d)) := gword_map _ _

/-! ## D1.6, D1.6b — the paper's operation written from §1.2 (G-001) -/

-- bridges: hold by `rfl` (SCR-2 applied)
theorem stopData_eq_body (E : Forest) : stopData E = stopDataBody E := by sorry
theorem stepKind_eq_body (E : Forest) : stepKind E = stepKindBody E := by sorry
theorem rootData_eq_body (E : Forest) : rootData E = rootDataBody E := by sorry
theorem paperOp_eq_body (E : Forest) (n : Nat) : paperOp E n = paperOpBody E n := by sorry

/-! ### D1.6b — branch data specifications -/

/-- D1.6b (`stopData_spec`†): the stopping column `Q ⌢ [(r, ∅)]` is the last route column. -/
theorem stopData_spec {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    E.colAt sd.col = some (sd.Q ++ [(sd.r, Tree.empty)]) ∧ sd.depth = sd.col.path.length ∧
      sd.t = sd.col.num 0 ∧ sd.col ∈ routeCols E ∧ (routeCols E).getLast? = some sd.col ∧
      (routeCols E).length = sd.depth + 1 := by sorry

/-- D1.6b: under I the route is never stuck (X-02 cannot happen). -/
theorem stopData_isSome {E : Forest} (hI : CondI E) {col : Column}
    (hlast : E.cols.getLast? = some col) (hne : col ≠ []) : (stopData E).isSome := by sorry

/-- D1.6b: `stopData` is `none` on `∅` and on a last outer column that is empty. -/
theorem stopData_eq_none_of_lastCol {E : Forest} (h : E.cols.getLast? = none ∨ E.cols.getLast? = some []) :
    stopData E = none := by sorry

/-- D1.6b: the deletion branch is exactly an empty last outer column. -/
theorem stepKind_deletion_iff (E : Forest) : stepKind E = some .deletion ↔ E.cols.getLast? = some [] := by
  sorry

/-- D1.6b: the special branch is exactly `specialStop`. -/
theorem stepKind_special_iff (E : Forest) :
    stepKind E = some .special ↔ ∃ sd, stopData E = some sd ∧ specialStop sd = true := by sorry

/-- D1.6b: the ordinary branch: a stop that is not special with a visible root. -/
theorem stepKind_ordinary_iff (E : Forest) :
    stepKind E = some .ordinary ↔ ∃ sd o, stopData E = some sd ∧ specialStop sd = false ∧
      sd.col.resolve 0 sd.r = some o := by sorry

/-- D1.6b (`rootData_spec`†). -/
theorem rootData_spec {E : Forest} {sd : StopData} {rd : RootData} (hsd : stopData E = some sd)
    (hrd : rootData E = some rd) :
    sd.col.resolve 0 sd.r = some rd.col ∧ rd.layer = rd.col.path.length ∧ rd.idx = rd.col.col ∧
      rd.col.num 0 = sd.r ∧ sd.r < sd.t ∧ rd.col ∈ E.colAddrs ∧
      rd.cursor = cursor (rootKeys E rd) (queryKeys sd) ∧
      (rd.owner = true ↔ ∃ F, E.forestAt rd.col.path = some F ∧ rd.col.col + 1 = F.cols.length) := by
  sorry

/-- D1.6b: the root is an owner iff it contains the stopping column; then the containing entry is
its last entry (the active root entry `u`). -/
theorem rootData_owner_iff {E : Forest} {sd : StopData} {rd : RootData} (hsd : stopData E = some sd)
    (hrd : rootData E = some rd) :
    rd.owner = true ↔ ∃ u, (⟨rd.col, u⟩ : EntryAddr).Contains sd.col ∧
      u + 1 = ((E.colAt rd.col).getD []).length := by sorry

/-- D1.6b: in the owner case the root layer is strictly above the stopping depth. -/
theorem rootData_layer_lt {E : Forest} {sd : StopData} {rd : RootData} (hsd : stopData E = some sd)
    (hrd : rootData E = some rd) (ho : rd.owner = true) : rd.layer < sd.depth := by sorry

theorem rootData_layer_le {E : Forest} {sd : StopData} {rd : RootData} (hsd : stopData E = some sd)
    (hrd : rootData E = some rd) : rd.layer ≤ sd.depth := by sorry

/-- D1.6b: the special owner entry is the last entry of the owner column, its height is the
stopping forest, which ends in the single-entry column `[(r, ∅)]`. -/
theorem ownerEntry_spec {E : Forest} {sd : StopData} {oe : EntryAddr}
    (hk : stepKind E = some .special) (hsd : stopData E = some sd) (hoe : sd.ownerEntry = some oe) :
    oe.Contains sd.col ∧ oe.heightPath = sd.col.path ∧ oe.col.num 0 = sd.r ∧
      ∃ col p Fl, E.colAt oe.col = some col ∧ col.getLast? = some (p, Fl) ∧
        oe.idx + 1 = col.length ∧ Fl.cols.getLast? = some [(sd.r, Tree.empty)] := by sorry

/-- D1.6b (`paperOp_deletion`). -/
theorem paperOp_deletion {E : Forest} (h : stepKind E = some .deletion) (n : Nat) :
    paperOp E n = some (.node E.cols.dropLast) := by sorry

/-- D1.6b (`paperOp_special`†): the special output, in terms of `Hole.fill`. -/
theorem paperOp_special {E : Forest} {sd : StopData} {oe : EntryAddr} {col : Column} {p : Nat}
    {Fl : Forest} (hk : stepKind E = some .special) (hsd : stopData E = some sd)
    (hoe : sd.ownerEntry = some oe) (hcol : E.colAt oe.col = some col)
    (hlast : col.getLast? = some (p, Fl)) (n : Nat) :
    paperOp E n = some (Hole.fill ⟨E, sd.depth - 1⟩ 0 0
      (.node [col.dropLast ++
        List.replicate (n + if col.dropLast.isEmpty then 1 else 0) (p, .node Fl.cols.dropLast)])) := by
  sorry

/-- D1.6b (`paperOp_ordinary`†): the ordinary output, in terms of `Hole.fill` and `ordZ`. -/
theorem paperOp_ordinary {E : Forest} {sd : StopData} {rd : RootData}
    (hk : stepKind E = some .ordinary) (hsd : stopData E = some sd) (hrd : rootData E = some rd)
    (n : Nat) :
    paperOp E n =
      if rd.owner && n != 0 && (((E.colAt rd.col).getD []).drop rd.cursor).isEmpty then none
      else some (Hole.fill ⟨E, sd.depth⟩ 0 0 (ordZ E sd rd n)) := by sorry

/-- D1.6b: the ordinary step at parameter `0` deletes the whole stopping column (txt:132-133). -/
theorem paperOp_ordinary_zero {E : Forest} {sd : StopData} (hk : stepKind E = some .ordinary)
    (hsd : stopData E = some sd) : paperOp E 0 = some (Hole.put ⟨E, sd.depth⟩ Tree.empty) := by sorry

/-! ### D1.6c — agreement of the locked `expand` with `paperOp` (G-001, D-3) -/

/-- D1.6c: the reference's depth agrees with the paper's route whenever the latter stops
(no use of I). -/
theorem tailLayer_of_stopData {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    tailLayer E = (sd.depth : Int) := by sorry

/-- D1.6c: the reference's deletion test. -/
theorem tailLayer_neg_iff {E : Forest} (hE : E ≠ Tree.empty) :
    tailLayer E < 0 ↔ E.cols.getLast? = some [] := by sorry

/-- D1.6c: the reference's layers are the paper's route forests. -/
theorem skipLayers_of_stopData {E : Forest} {sd : StopData} (h : stopData E = some sd) {d : Nat}
    (hd : d ≤ sd.depth) : E.forestAt (sd.col.path.take d) = some (skipLayers E d) := by sorry

theorem skipLayers_add (E : Forest) (a b : Nat) : skipLayers (skipLayers E a) b = skipLayers E (a + b) := by
  sorry

/-- D1.6c: `leftCount` counts the columns of the layers above `d` (no hypothesis). -/
theorem leftCount_eq_sum (E : Forest) (d : Nat) :
    leftCount E d = ((List.range d).map fun k => (skipLayers E k).cols.length).sum := by sorry

/-- D1.6c: `t` agrees (txt:101-103). -/
theorem tailNum_of_stopData {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    tailNum E sd.depth = sd.t := by sorry

/-- D1.6c: `r` agrees. -/
theorem rootAt_of_stopData {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    rootAt E sd.depth = sd.r := by sorry

/-- D1.6c: the special tests agree. -/
theorem isSpecial_of_stopData {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    isSpecial E sd.depth = specialStop sd := by sorry

/-- D1.6c: the special outputs agree. -/
theorem expandSpecial_of_stopData {E : Forest} {sd : StopData} (h : stopData E = some sd)
    (hs : specialStop sd = true) (n : Nat) : some (expandSpecial n sd.depth E) = specialOut E sd n := by
  sorry

/-- D1.6c: the reference's root search finds the paper's visible root. -/
theorem rootLayer_of_resolve {E : Forest} {sd : StopData} {o : ColAddr} (h : stopData E = some sd)
    (ho : sd.col.resolve 0 sd.r = some o) : rootLayer E sd.r sd.depth = some (o.path.length, o.col) := by
  sorry

/-- D1.6c: the reference's scan start is the paper's cursor. -/
theorem rootAppendingStart_of_rootData {E : Forest} {sd : StopData} {rd : RootData}
    (hsd : stopData E = some sd) (hrd : rootData E = some rd) :
    rootAppendingStart ((E.colAt rd.col).getD []) sd.r (sd.Q ++ [(sd.r, Tree.empty)]) sd.t =
      rd.cursor := by sorry

/-- D1.6c: `ascendReplace` at a nonnegative depth is `Hole.fill`. -/
theorem ascendReplace_ofNat (r d k : Nat) (Z F : Forest) :
    ascendReplace r d (some (k : Int)) Z F = Hole.fill ⟨F, k⟩ r d Z := by sorry

/-- D1.6c: the loops agree. -/
theorem iterDown_eq_ordLoop (step : Nat → Forest → Forest) (n : Nat) (Z : Forest) :
    iterDown step n Z = ordLoop step n Z := by sorry

/-- D1.6c: agreement on every input where the paper's route stops at a special step. -/
theorem expand_eq_paperOp_special {E : Forest} {sd : StopData} (h : stopData E = some sd)
    (hs : specialStop sd = true) (n : Nat) : expand E n = paperOp E n := by sorry

/-- D1.6c: agreement on every input where the paper's route stops at a non-special step with a
visible root. -/
theorem expand_eq_paperOp_ordinary {E : Forest} {sd : StopData} {o : ColAddr}
    (h : stopData E = some sd) (hs : specialStop sd = false) (ho : sd.col.resolve 0 sd.r = some o)
    (n : Nat) : expand E n = paperOp E n := by sorry

/-- D1.6c: under V the root of a stop is visible. -/
theorem resolve_root_of_condV {E : Forest} (hV : CondV E) {sd : StopData} (h : stopData E = some sd) :
    (sd.col.resolve 0 sd.r).isSome := by sorry

/-! ## D2.2a — responses, edges and paths -/

/-- D2.2a: the start `x(c,k)` of the cut-`k` test of column `c` (codex-crosscheck-1 Q2):
`c - 1` at `k = 0`, else the parent of entry `k - 1`. -/
def cutStart (E : Forest) (c : ColAddr) (k : Nat) : Nat :=
  if k = 0 then c.num 0 - 1 else ((parents E c)[k - 1]?).getD 0

/-- D2.2a: condition A at entry `i` of column `c` in key system `ks`. -/
def AAt (E : Forest) (ks : KeySys) (c : ColAddr) (i : Nat) : Prop :=
  ∀ p, (parents E c)[i]? = some p → Path E ks c (cutQuery (ks c) i) (cutStart E c i) p

/-- D2.2a: `CondAK` is `AAt` at every entry. -/
theorem condAK_iff (E : Forest) (ks : KeySys) :
    CondAK E ks ↔ ∀ c ∈ E.colAddrs, ∀ i, AAt E ks c i := Iff.rfl

/-- D2.2a: the (deterministic) response function of an edge read on the stack of `c`. -/
def respEdge (E : Forest) (ks : KeySys) (c : ColAddr) (W : List (WithTop Key)) (x : Nat) :
    Option Nat :=
  (c.resolve 0 x).bind fun o => resp E ks o W

theorem edge_iff (E : Forest) (ks : KeySys) (c : ColAddr) (W : List (WithTop Key)) (x p : Nat) :
    Edge E ks c W x p ↔ respEdge E ks c W x = some p := by sorry

/-- D2.2a: `resp` in terms of the cursor. -/
theorem resp_eq_some {E : Forest} {ks : KeySys} {o : ColAddr} {W : List (WithTop Key)} {p : Nat} :
    resp E ks o W = some p ↔ ∃ H, ((E.colAt o).getD [])[cursor (ks o) W]? = some (p, H) := by sorry

/-- D2.2a: the number of keys is the number of entries, for actual and capped systems. -/
theorem length_actualKeys (E : Forest) (c : ColAddr) :
    (actualKeys E c).length = ((E.colAt c).getD []).length := by sorry

theorem length_capKeys (E : Forest) (sel : List ColAddr) (c : ColAddr) :
    (capKeys E sel c).length = ((E.colAt c).getD []).length := by sorry

/-- D2.2a (txt:179-180): under V every edge decreases the column number. -/
theorem edge_lt {E : Forest} (hV : CondV E) {ks : KeySys} {c : ColAddr} {W : List (WithTop Key)}
    {x p : Nat} (h : Edge E ks c W x p) : p < x := by sorry

/-- D2.2a: paths decrease. -/
theorem path_le {E : Forest} (hV : CondV E) {ks : KeySys} {c : ColAddr} {W : List (WithTop Key)}
    {x y : Nat} (h : Path E ks c W x y) : y ≤ x := by sorry

/-- D2.2a: the test starts strictly below the tested column. -/
theorem cutStart_lt {E : Forest} (hV : CondV E) {c : ColAddr} (hc : c ∈ E.colAddrs) {k : Nat}
    (hk : k ≤ (parents E c).length) (hpos : 0 < c.num 0) : cutStart E c k < c.num 0 := by sorry

/-- D2.2a (stack restriction): edges from numbers below `x₀` depend only on the stack below
`x₀`. -/
theorem edge_congr_stack {E : Forest} {ks : KeySys} {c c' : ColAddr} {W : List (WithTop Key)}
    {x₀ x p : Nat} (hst : ∀ q < x₀, c.resolve 0 q = c'.resolve 0 q) (hx : x < x₀) :
    Edge E ks c W x p ↔ Edge E ks c' W x p := by sorry

/-- D2.2a (stack restriction for paths, codex-crosscheck-1 Q2). -/
theorem path_congr_stack {E : Forest} (hV : CondV E) {ks : KeySys} {c c' : ColAddr}
    {W : List (WithTop Key)} {x₀ x y : Nat} (hst : ∀ q < x₀, c.resolve 0 q = c'.resolve 0 q)
    (hx : x < x₀) : Path E ks c W x y ↔ Path E ks c' W x y := by sorry

/-- D2.2a (txt:191-193): A implies parent monotonicity, in every key system. -/
theorem parents_antitone {E : Forest} (hV : CondV E) {ks : KeySys} (hA : CondAK E ks)
    {c : ColAddr} (hc : c ∈ E.colAddrs) {i p q : Nat} (hi : (parents E c)[i + 1]? = some p)
    (hq : (parents E c)[i]? = some q) : p ≤ q := by sorry

/-! ## D1.3a, D2.3a — the conditions in usable form -/

/-- D1.3a: V is "every parent is smaller than its column's printed number" (every smaller
number is visible, `resolve_isSome_iff`). -/
theorem condV_iff_lt (E : Forest) :
    CondV E ↔ ∀ e ∈ E.entryAddrs, ∀ p h, E.entryAt e = some (p, h) → p < e.col.num 0 := by sorry

/-- D2.2a: parents of a column, entrywise. -/
theorem parents_getElem? (E : Forest) (c : ColAddr) (k : Nat) :
    (parents E c)[k]? = (E.entryAt ⟨c, k⟩).map Prod.fst := by sorry

/-- D2.3a: an owner return is a contained column whose entry's parent resolves to the owner
column (definitional unfolding with `Contains`). -/
theorem isOwnerReturn_iff (E : Forest) (e₀ e : EntryAddr) :
    IsOwnerReturn E e₀ e ↔ e₀.Contains e.col ∧
      ∃ q J, E.entryAt e = some (q, J) ∧ e.col.resolve 0 q = some e₀.col := Iff.rfl

/-- D2.3a: an entry of a contained column whose parent is the host number is an owner return. -/
theorem isOwnerReturn_of_parent {E : Forest} {e₀ : EntryAddr} {c : ColAddr} {k : Nat} {J : Forest}
    (hc : e₀.Contains c) (hk : E.entryAt ⟨c, k⟩ = some (e₀.col.num 0, J)) :
    IsOwnerReturn E e₀ ⟨c, k⟩ := by sorry

/-! ## L2.2a — the path-nesting induction (G-006) -/

/-- L2.2a: the path-nesting predicate at source number `x`, quantified over every stack owner
`c` (all occurrences and scopes simultaneously, codex-crosscheck-1 Q2). -/
def NestPred (E : Forest) (ks : KeySys) (x : Nat) : Prop :=
  ∀ (c : ColAddr) (W Z : List (WithTop Key)) (p : Nat), Noninc W → Noninc Z → W ≤ Z →
    Edge E ks c Z x p → Path E ks c W x p

/-- L2.2a: the induction step (strong induction on `x`). -/
theorem nestPred_step {E : Forest} (hV : CondV E) {ks : KeySys} (hA : CondAK E ks) (x : Nat)
    (ih : ∀ y < x, NestPred E ks y) : NestPred E ks x := by sorry

/-- L2.2a. -/
theorem nestPred_all {E : Forest} (hV : CondV E) {ks : KeySys} (hA : CondAK E ks) (x : Nat) :
    NestPred E ks x := by sorry

/-! ## L2.3, L2.3a — the barrier (G-006 predicates) -/

/-- L2.3a: `C_e(c,k)`: an actual cut-`k` path of column `c` that reaches the host `a` of the
containing entry `e` has query strictly below `D_e = B_a(u)` (codex-crosscheck-1 Q2). -/
def CutBound (E : Forest) (e : EntryAddr) (c : ColAddr) (k : Nat) : Prop :=
  Path E (actualKeys E) c (cutQuery (actualKeys E c) k) (cutStart E c k) (e.col.num 0) →
    cutQuery (actualKeys E c) k < boundary (actualKeys E e.col) e.idx

/-- L2.3a: `R_e(c,k)`: if entry `k` of `c` returns to the host of `e`, then `B_c(k) < D_e`. -/
def ReturnBound (E : Forest) (e : EntryAddr) (c : ColAddr) (k : Nat) : Prop :=
  (parents E c)[k]? = some (e.col.num 0) →
    boundary (actualKeys E c) k < boundary (actualKeys E e.col) e.idx

/-- L2.3a: the empty cut is below every boundary of an entry. -/
theorem cutBound_zero {E : Forest} {e : EntryAddr} (he : e ∈ E.entryAddrs) (c : ColAddr) :
    CutBound E e c 0 := by sorry

/-- L2.3a (localized pre-entry-cut barrier): `C_e(c,k)` follows from the return bounds at
smaller column numbers inside `H_e` and at earlier entries of `c`; no A at `(c,k)` is used. -/
theorem cutBound_of_returns {E : Forest} (hV : CondV E) {e : EntryAddr} (he : e ∈ E.entryAddrs)
    {c : ColAddr} (hc : c ∈ E.colAddrs) (hec : e.Contains c) {k : Nat}
    (hk : k ≤ (parents E c).length)
    (hlow : ∀ o ∈ E.colAddrs, e.Contains o → o.num 0 < c.num 0 → ∀ v, ReturnBound E e o v)
    (hprev : ∀ k' < k, ReturnBound E e c k') : CutBound E e c k := by sorry

/-- L2.3a: the return step: `C_e(c,k)`, actual A at `(c,k)` and S give `R_e(c,k)`. -/
theorem returnBound_of_cutBound {E : Forest} (hS : CondS E) {e : EntryAddr}
    (he : e ∈ E.entryAddrs) {c : ColAddr} (hc : c ∈ E.colAddrs) (hec : e.Contains c) {k : Nat}
    (hA : AAt E (actualKeys E) c k) (hcut : CutBound E e c k) : ReturnBound E e c k := by sorry

/-- L2.3a: the joint barrier predicate at `(c, k)` for the containing entry `e`. -/
def BarPred (E : Forest) (e : EntryAddr) (c : ColAddr) (k : Nat) : Prop :=
  CutBound E e c k ∧ ReturnBound E e c k

/-- L2.3a: the lexicographic induction step on `(c.num 0, k)`. -/
theorem barPred_step {E : Forest} (hV : CondV E) (hA : CondA E) (hS : CondS E) {e : EntryAddr}
    (he : e ∈ E.entryAddrs) {c : ColAddr} (hc : c ∈ E.colAddrs) (hec : e.Contains c) {k : Nat}
    (hk : k ≤ (parents E c).length)
    (ihlow : ∀ o ∈ E.colAddrs, e.Contains o → o.num 0 < c.num 0 →
      ∀ v ≤ (parents E o).length, BarPred E e o v)
    (ihprev : ∀ k' < k, BarPred E e c k') : BarPred E e c k := by sorry

/-- L2.3a: the joint induction on `(c.num 0, k)`, all occurrences and scopes simultaneously. -/
theorem barrier_joint {E : Forest} (hV : CondV E) (hA : CondA E) (hS : CondS E) {e : EntryAddr}
    (he : e ∈ E.entryAddrs) {c : ColAddr} (hc : c ∈ E.colAddrs) (hec : e.Contains c) {k : Nat}
    (hk : k ≤ (parents E c).length) : CutBound E e c k ∧ ReturnBound E e c k := by sorry

/-- L2.3 (`barrier`†, txt:205-207): at an owner return, `B_c(v) < B_a(u)`. -/
theorem barrier {E : Forest} (hV : CondV E) (hA : CondA E) (hS : CondS E) {e₀ e : EntryAddr}
    (he₀ : e₀ ∈ E.entryAddrs) (he : e ∈ E.entryAddrs) (hret : IsOwnerReturn E e₀ e) :
    boundary (actualKeys E e.col) e.idx < boundary (actualKeys E e₀.col) e₀.idx := by sorry

/-- L2.3 (`cut_barrier`†, txt:207-209): at any complete cut, including the full cut after the
last entry, a read of an active containing entry by the cut's ancestor path has query strictly
below that entry's boundary. -/
theorem cut_barrier {E : Forest} (hV : CondV E) (hA : CondA E) (hS : CondS E) {e : EntryAddr}
    (he : e ∈ E.entryAddrs) {c : ColAddr} (hc : c ∈ E.colAddrs) (hec : e.Contains c) {k : Nat}
    (hk : k ≤ (parents E c).length)
    (hpath : Path E (actualKeys E) c (cutQuery (actualKeys E c) k) (cutStart E c k) (e.col.num 0)) :
    cutQuery (actualKeys E c) k < boundary (actualKeys E e.col) e.idx := by sorry

/-! ## L2.4, L2.4a, L2.4b — independent capping (G-006) -/

/-- L2.4b: an unselected column keeps its actual keys. -/
theorem capKeys_of_not_mem {E : Forest} {sel : List ColAddr} {c : ColAddr} (h : c ∉ sel) :
    capKeys E sel c = actualKeys E c := by sorry

/-- L2.4b (txt:222, point 1 of codex Q2): no entry query contains a capped last key. -/
theorem cutQuery_capKeys (E : Forest) (sel : List ColAddr) (c : ColAddr) {i : Nat}
    (hi : i < ((E.colAt c).getD []).length) :
    cutQuery (capKeys E sel c) i = cutQuery (actualKeys E c) i := by sorry

/-- L2.4b: a capped column whose actual scan is not exhausted gives the actual response
(L2.5 (2)). -/
theorem resp_capKeys {E : Forest} {sel : List ColAddr} {o : ColAddr} {W : List (WithTop Key)}
    (hnx : cursor (actualKeys E o) W < (actualKeys E o).length) :
    resp E (capKeys E sel) o W = resp E (actualKeys E) o W := by sorry

/-- L2.4b (point 2 of codex Q2): a route column visible from a column of `E` contains it. -/
theorem routeCols_visible {E : Forest} {c a : ColAddr} {z : Nat} (hc : c ∈ E.colAddrs)
    (ha : a ∈ routeCols E) (hres : c.resolve 0 z = some a) :
    ∃ v, (⟨a, v⟩ : EntryAddr) ∈ E.entryAddrs ∧ (⟨a, v⟩ : EntryAddr).Contains c := by sorry

/-- L2.4b: at a cut whose containing entries satisfy their cut bounds, actual paths are capped
paths (forward direction). -/
theorem capped_path_of_actual {E : Forest} (hV : CondV E) {sel : List ColAddr}
    (hsel : ∀ a ∈ sel, a ∈ routeCols E) {c : ColAddr} (hc : c ∈ E.colAddrs) {k : Nat}
    (hcut : ∀ e ∈ E.entryAddrs, e.Contains c → CutBound E e c k) {y : Nat}
    (h : Path E (actualKeys E) c (cutQuery (actualKeys E c) k) (cutStart E c k) y) :
    Path E (capKeys E sel) c (cutQuery (actualKeys E c) k) (cutStart E c k) y := by sorry

/-- L2.4a (first divergence): under the same cut bounds, capped paths are actual paths. -/
theorem actual_path_of_capped {E : Forest} (hV : CondV E) {sel : List ColAddr}
    (hsel : ∀ a ∈ sel, a ∈ routeCols E) {c : ColAddr} (hc : c ∈ E.colAddrs) {k : Nat}
    (hcut : ∀ e ∈ E.entryAddrs, e.Contains c → CutBound E e c k) {y : Nat}
    (h : Path E (capKeys E sel) c (cutQuery (actualKeys E c) k) (cutStart E c k) y) :
    Path E (actualKeys E) c (cutQuery (actualKeys E c) k) (cutStart E c k) y := by sorry

/-- L2.4: forward capping. -/
theorem capping_forward {E : Forest} (hV : CondV E) (hA : CondA E) (hS : CondS E)
    {sel : List ColAddr} (hsel : ∀ a ∈ sel, a ∈ routeCols E) : CondAK E (capKeys E sel) := by sorry

/-- L2.4a: the reverse-capping predicate at `(c, i)`: actual A at entry `i` together with the
actual return bounds of that entry for every containing entry (codex-crosscheck-1 Q2). -/
def RevPred (E : Forest) (c : ColAddr) (i : Nat) : Prop :=
  AAt E (actualKeys E) c i ∧ ∀ e ∈ E.entryAddrs, e.Contains c → ReturnBound E e c i

/-- L2.4a: the lexicographic induction step on `(c.num 0, i)`. -/
theorem revPred_step {E : Forest} (hV : CondV E) (hS : CondS E) {sel : List ColAddr}
    (hsel : ∀ a ∈ sel, a ∈ routeCols E) (hA : CondAK E (capKeys E sel)) {c : ColAddr}
    (hc : c ∈ E.colAddrs) (i : Nat)
    (ihlow : ∀ o ∈ E.colAddrs, o.num 0 < c.num 0 → ∀ v, RevPred E o v)
    (ihprev : ∀ i' < i, RevPred E c i') : RevPred E c i := by sorry

/-- L2.4a: the reverse joint induction on `(c.num 0, i)`: actual A together with the actual
return bounds. -/
theorem capping_reverse_joint {E : Forest} (hV : CondV E) (hS : CondS E) {sel : List ColAddr}
    (hsel : ∀ a ∈ sel, a ∈ routeCols E) (hA : CondAK E (capKeys E sel)) {c : ColAddr}
    (hc : c ∈ E.colAddrs) (i : Nat) :
    AAt E (actualKeys E) c i ∧ ∀ e ∈ E.entryAddrs, e.Contains c → ReturnBound E e c i := by sorry

/-- L2.4a: reverse capping. -/
theorem capping_reverse {E : Forest} (hV : CondV E) (hS : CondS E) {sel : List ColAddr}
    (hsel : ∀ a ∈ sel, a ∈ routeCols E) (hA : CondAK E (capKeys E sel)) : CondA E := by sorry

/-- L2.4 (`capping_iff`†, txt:223-224): on V, S inputs, A is equivalent to A in every
independently capped system on the terminal route. -/
theorem capping_iff {E : Forest} (hV : CondV E) (hS : CondS E) {sel : List ColAddr}
    (hsel : ∀ a ∈ sel, a ∈ routeCols E) : CondA E ↔ CondAK E (capKeys E sel) := by sorry

/-! ## L2.4c — every operation is defined on V, I, A, S -/

/-- L2.4c (txt:232-236): the owner root scan is not exhausted. -/
theorem owner_root_nonexhaust {E : Forest} (hV : CondV E) (hA : CondA E) (hS : CondS E)
    {sd : StopData} {rd : RootData} (hsd : stopData E = some sd) (hrd : rootData E = some rd)
    (ho : rd.owner = true) : rd.cursor < ((E.colAt rd.col).getD []).length := by sorry

/-- L2.4c: the paper's operation is defined on nonempty V, I, A, S inputs. -/
theorem paperOp_isSome {E : Forest} (hE : E ≠ Tree.empty) (hV : CondV E) (hI : CondI E)
    (hA : CondA E) (hS : CondS E) (n : Nat) : (paperOp E n).isSome := by sorry

/-- L2.4c (task form of `expand_isSome`). -/
theorem expand_ne_none {E : Forest} (hV : CondV E) (hI : CondI E) (hA : CondA E) (hS : CondS E)
    (n : Nat) : expand E n ≠ none := by sorry

/-- L2.4c: every operation on the class L is defined. -/
theorem inL_expand_ne_none {E : Forest} (h : InL E) (n : Nat) : expand E n ≠ none := by sorry

end Scan

/-! ## D1.7a — seeds and generation witnesses -/

theorem seed_ne_empty (m : Nat) : seed m ≠ Tree.empty := by
  cases m <;> simp [seed, Tree.empty]

/-- D1.7a: the seed's columns (txt:139-140): `L_0 = ()`, `L_{m+1} = (0)` followed by the branch. -/
theorem seed_cols (m : Nat) : (seed m).cols = if m = 0 then [[]] else [[], branch 0 (m - 1)] := by
  cases m <;> simp [seed, Tree.cols]

/-- D1.7a: the branch has singleton columns with parents `i, i+1, …`. -/
theorem branch_spec (i k : Nat) :
    branch i k = [(i, if k = 0 then Tree.empty else .node [branch (i + 1) (k - 1)])] := by
  cases k <;> simp [branch]

/-- D1.7a helper: running a witness from a standard expression stays standard. -/
theorem isStd_foldlM {E : Forest} :
    ∀ (ns : List Nat) (F : Forest), IsStd F →
      ns.foldlM (fun F n => expand F n) F = some E → IsStd E
  | [], F, hF, h => by
    simp only [List.foldlM_nil] at h
    exact (Option.some.inj h) ▸ hF
  | n :: ns, F, hF, h => by
    simp only [List.foldlM_cons] at h
    cases hx : expand F n with
    | none => rw [hx] at h; simp at h
    | some F' =>
      rw [hx] at h
      exact isStd_foldlM ns F' (IsStd.expand n hF hx) h

/-- D1.7a (txt:141-142): a seed index and a finite parameter list are a generation witness. -/
theorem isStd_iff_witness (E : Forest) :
    IsStd E ↔ ∃ (m : Nat) (ns : List Nat), ns.foldlM (fun F n => expand F n) (seed m) = some E := by
  constructor
  · intro h
    induction h with
    | seed m => exact ⟨m, [], rfl⟩
    | expand n _ hexp ih =>
      obtain ⟨m, ns, hns⟩ := ih
      refine ⟨m, ns ++ [n], ?_⟩
      rw [List.foldlM_append, hns]
      simp [hexp]
  · rintro ⟨m, ns, h⟩
    exact isStd_foldlM ns (seed m) (IsStd.seed m) h

namespace Scan

/-! ## N1.1 — decidable mirrors and test generators (testing only) -/

/-- N1.1. -/
def condVb (E : Forest) : Bool :=
  E.entryAddrs.all fun e => match E.entryAt e with
    | some (p, _) => (e.col.resolve 0 p).isSome
    | none => true

/-- N1.1. -/
def condIb (E : Forest) : Bool :=
  E.entryAddrs.all fun e => match E.entryAt e with
    | some (_, h) => h.cols.isEmpty || h.cols.all fun col => match col with
        | (q, _) :: _ => decide (e.col.num 0 ≤ q)
        | [] => false
    | none => true

/-- N1.1. -/
def condHb (E : Forest) : Bool :=
  E.colAddrs.all fun c =>
    let col := (E.colAt c).getD []
    (List.range (col.length - 1)).all fun i => match col[i]?, col[i + 1]? with
      | some x, some y => decide (y.1 < x.1) || (decide (y.1 = x.1) && decide (y.2 ≤ x.2))
      | _, _ => true

/-- N1.1: the deterministic orbit search (fuel `x + 1` suffices under V, since edges decrease). -/
def pathAux (E : Forest) (ks : KeySys) (c : ColAddr) (W : List (WithTop Key)) (y : Nat) :
    Nat → Nat → Bool
  | 0, _ => false
  | fuel + 1, z => z == y || match respEdge E ks c W z with
    | some p => decide (p < z) && pathAux E ks c W y fuel p
    | none => false

def pathb (E : Forest) (ks : KeySys) (c : ColAddr) (W : List (WithTop Key)) (x y : Nat) : Bool :=
  pathAux E ks c W y (x + 1) x

/-- N1.1. -/
def condAKb (E : Forest) (ks : KeySys) : Bool :=
  E.colAddrs.all fun c => (List.range (parents E c).length).all fun i =>
    match (parents E c)[i]? with
    | some p => pathb E ks c (cutQuery (ks c) i) (cutStart E c i) p
    | none => true

/-- N1.1. -/
def isOwnerReturnb (E : Forest) (e₀ e : EntryAddr) : Bool :=
  e₀.heightPath.isPrefixOf e.col.path && match E.entryAt e with
    | some (q, _) => e.col.resolve 0 q == some e₀.col
    | none => false

/-- N1.1. -/
def condSb (E : Forest) : Bool :=
  E.entryAddrs.all fun e₀ => E.entryAddrs.all fun e => !isOwnerReturnb E e₀ e ||
    decide (relKey (e.col.num 0) ((E.heightAt e).getD Tree.empty) <
      relKey (e₀.col.num 0) ((E.heightAt e₀).getD Tree.empty))

def inLb (E : Forest) : Bool :=
  condVb E && condIb E && condHb E && condAKb E (actualKeys E) && condSb E

theorem condV_iff (E : Forest) : CondV E ↔ condVb E = true := by sorry
theorem condI_iff (E : Forest) : CondI E ↔ condIb E = true := by sorry
theorem condH_iff (E : Forest) : CondH E ↔ condHb E = true := by sorry
theorem path_iff_pathb {E : Forest} (hV : CondV E) (ks : KeySys) (c : ColAddr)
    (W : List (WithTop Key)) (x y : Nat) : Path E ks c W x y ↔ pathb E ks c W x y = true := by sorry
theorem condAK_iff_b {E : Forest} (hV : CondV E) (ks : KeySys) :
    CondAK E ks ↔ condAKb E ks = true := by sorry
theorem condS_iff (E : Forest) : CondS E ↔ condSb E = true := by sorry
theorem inL_iff (E : Forest) : InL E ↔ inLb E = true := by sorry

/-- N1.1: standard expressions reachable from the seeds `0…m` in at most `d` operations with
parameters `0…p` (breadth first; for bounded tests). -/
def stdUpTo (m d p : Nat) : List Forest :=
  ((List.range d).foldl
    (fun (st : List Forest × List Forest) _ =>
      let nxt := st.2.flatMap fun F => (List.range (p + 1)).filterMap (expand F)
      (st.1 ++ nxt, nxt))
    ((List.range (m + 1)).map seed, (List.range (m + 1)).map seed)).1

/-- N1.1: every listed expression is standard. -/
theorem isStd_of_mem_stdUpTo {m d p : Nat} {E : Forest} (h : E ∈ stdUpTo m d p) : IsStd E := by
  sorry

end Scan

/-! ## Integration additions (requested by U2, U3, U5; nodes D1.2e, D1.2f, D1.3b, D1.4b,
D1.5b, D1.6d, D1.9b, N1.4, L2.1d, L2.3c, L2.5d). Every statement below was a stub or a
Requires entry of another unit; the requester is named in each docstring. -/

namespace Tree

mutual
/-- D1.4b helper: `roles_map` under an arbitrary prefix. -/
theorem rolesF_map {α β : Type} (f : α → β) :
    (π : List (Nat × Nat)) → (t : Tree α) → rolesF π (t.map f) = rolesF π t
  | π, .node cols => by simp only [Tree.map, rolesF]; exact rolesCols_map f π 0 cols
theorem rolesCols_map {α β : Type} (f : α → β) :
    (π : List (Nat × Nat)) → (c : Nat) → (cs : List (List (α × Tree α))) →
      rolesCols π c (Tree.mapCols f cs) = rolesCols π c cs
  | _, _, [] => rfl
  | π, c, col :: rest => by
    simp only [Tree.mapCols, rolesCols]
    rw [rolesCol_map f π c 0 col, rolesCols_map f π (c + 1) rest]
theorem rolesCol_map {α β : Type} (f : α → β) :
    (π : List (Nat × Nat)) → (c i : Nat) → (es : List (α × Tree α)) →
      rolesCol π c i (Tree.mapCol f es) = rolesCol π c i es
  | _, _, _, [] => rfl
  | π, c, i, (_, h) :: rest => by
    simp only [Tree.mapCol, rolesCol]
    rw [rolesF_map f (π ++ [(c, i)]) h, rolesCol_map f π c (i + 1) rest]
end

/-- D1.4b (moved from U3 L6.2a `roles_map`; requested by U5 R14): roles depend only on the
shape of a tree. -/
theorem roles_map {α β : Type} (f : α → β) (t : Tree α) : (t.map f).roles = t.roles :=
  rolesF_map f [] t

/-- D1.2e (requested by U5 R12): the roles of an entry `e` are its slot, right after the prefix
`P(E, e)`, followed by the roles of its height placed under `e`'s height path; no later role lies
inside `e`. -/
theorem roles_entry {E : Forest} {e : EntryAddr} (he : e ∈ E.entryAddrs) :
    ∃ post, E.roles = Packet.prefixRoles E e ++ .slot e ::
      (((E.heightAt e).getD Tree.empty).roles.map (Role.under e.heightPath) ++ post) ∧
      ∀ x ∈ post, x.inEntry e = false := by sorry

/-- D1.2e (requested by U5 R13): `truncAfter_roles` in `Role.under` form. -/
theorem truncAfter_roles_under {E : Forest} {e : EntryAddr} (he : e ∈ E.entryAddrs) :
    (E.truncAfter e).roles = Packet.prefixRoles E e ++ .slot e ::
      ((E.heightAt e).getD Tree.empty).roles.map (Role.under e.heightPath) := by sorry

/-- D1.2e (requested by U3 D7.1b for U5 R19): the column of an entry, every column occurrence on
the visible stack of that column, and the slot of every entry containing that column precede the
entry's slot in reading order. -/
theorem stack_mem_prefix {E : Forest} {e : EntryAddr} (he : e ∈ E.entryAddrs) :
    Role.ord e.col ∈ Packet.prefixRoles E e ∧
    (∀ o, e.col.OnStack o → Role.ord o ∈ Packet.prefixRoles E e) ∧
    ∀ e' : EntryAddr, e'.Contains e.col → Role.slot e' ∈ Packet.prefixRoles E e := by sorry

/-- D1.2f (requested by U3 R1): truncation after an entry is idempotent and keeps the entry,
its height and its prefix. -/
theorem truncAfter_spec (t : Forest) (e : EntryAddr) (he : e ∈ t.entryAddrs) :
    (t.truncAfter e).truncAfter e = t.truncAfter e ∧ e ∈ (t.truncAfter e).entryAddrs ∧
    (t.truncAfter e).heightAt e = t.heightAt e ∧ (t.truncAfter e).entryAt e = t.entryAt e ∧
    (∀ x ∈ Packet.prefixRoles t e, x ∈ Packet.prefixRoles (t.truncAfter e) e) ∧
    Packet.prefixRoles (t.truncAfter e) e = Packet.prefixRoles t e := by sorry

/-- D1.2f (requested by U3 R2): basic laws of `setHeight`. -/
theorem setHeight_basic (t : Forest) (e : EntryAddr) (h : Forest) (he : e ∈ t.entryAddrs) :
    e ∈ (t.setHeight e h).entryAddrs ∧ (t.setHeight e h).heightAt e = some h ∧
    (∀ h', (t.setHeight e h).setHeight e h' = t.setHeight e h') ∧
    (t.heightAt e = some h → t.setHeight e h = t) ∧
    (t.truncAfter e = t → (t.setHeight e h).truncAfter e = t.setHeight e h) ∧
    ((t.setHeight e h).entryAt e).map Prod.fst = (t.entryAt e).map Prod.fst := by sorry

end Tree

/-- D1.4b (requested by U5 R14): a relative key has the roles of its height. -/
theorem relKey_roles (a : Nat) (B : Forest) : (relKey a B).roles = B.roles := by
  rw [relKey_eq_map]; exact Tree.roles_map _ B

/-- D1.4b (requested by U5 R14): a relative key is empty exactly when its height is. -/
theorem relKey_eq_empty {a : Nat} {B : Forest} : relKey a B = Tree.empty ↔ B = Tree.empty := by
  obtain ⟨cols⟩ := B
  cases cols with
  | nil => simp [relKey, Tree.map, Tree.mapCols, Tree.empty]
  | cons c cs => simp [relKey, Tree.map, Tree.mapCols, Tree.empty]

namespace Scan

/-- D1.3b (requested by U5 R8): under V and I the first parent of a nonempty height is the
printed number of its host column. -/
theorem firstParent_host {E : Forest} (hV : CondV E) (hI : CondI E) {e : EntryAddr}
    (he : e ∈ E.entryAddrs) {h : Forest} (hh : E.heightAt e = some h) (hne : h ≠ Tree.empty) :
    ∃ H₀ rest, h.cols.head? = some ((e.col.num 0, H₀) :: rest) := by sorry

/-- D1.5b helper: a `map` after `mapLast`. -/
theorem map_mapLast {γ δ ε : Type} (f g : γ → δ) (h : δ → ε) (l : List γ) :
    (mapLast f g l).map h = mapLast (h ∘ f) (h ∘ g) l := by
  rw [mapLast_eq, mapLast_eq]; cases l.getLast? <;> simp

/-- D1.5b (requested by U2 REQ-U1-7, second form): a shift commutes with an unshifted placement. -/
theorem shift_replaceAt (r a δ : Nat) (Z G : Forest) :
    shift r a (replaceAt 0 0 Z δ G) = replaceAt r a (shift r a Z) δ G := by
  induction δ generalizing G with
  | zero =>
    obtain ⟨cols⟩ := G
    obtain ⟨zc⟩ := Z
    cases cols with
    | nil => simp [replaceAt, shift, Tree.map, Tree.mapCols]
    | cons c cs =>
      simp only [replaceAt, shift, Tree.map, Tree.cols]
      rw [shiftVal_zero_fun 0, treeMapCol_id_fun, List.map_id, treeMapCols_eq_map,
        treeMapCols_eq_map, List.map_append]
  | succ k ih =>
    obtain ⟨cols⟩ := G
    simp only [replaceAt, shift, Tree.map]
    rw [shiftVal_zero_fun 0, treeMapCol_id_fun, treeMapCols_eq_map, map_mapLast]
    congr 1
    congr 1
    funext c
    rw [Function.comp, treeMapCol_eq_map, map_mapLast]
    congr 1
    · funext x; simp only [Function.comp, id, treeMap_id]
    · funext x
      simp only [Function.comp, id]
      exact Prod.ext rfl (ih x.2)

/-- D1.6d (requested by U5 R3): the closing slot reads the root column and is an entry
`(r, ∅)`. -/
theorem rootData_col {H : Forest} {sd : StopData} {rd : RootData}
    (hsd : stopData H = some sd) (hrd : rootData H = some rd) :
    sd.col.resolve 0 sd.r = some rd.col ∧ rd.col.num 0 = sd.r ∧
      closingSlot sd ∈ H.entryAddrs ∧ H.entryAt (closingSlot sd) = some (sd.r, Tree.empty) := by
  sorry

/-- D1.6d (requested by U5 R4): the stopping column is a column of the expression. -/
theorem stopData_col_mem {H : Forest} {sd : StopData} (hsd : stopData H = some sd) :
    Role.ord sd.col ∈ H.roles := by sorry

/-- D1.6d (requested by U5 R5): the owner entry of a special step is an entry containing the
stopping column, and its height ends with the column `[(a, ∅)]`, `a` the owner column's number. -/
theorem ownerEntry_mem {H : Forest} {sd : StopData} {e : EntryAddr}
    (hk : stepKind H = some .special) (hsd : stopData H = some sd) (he : sd.ownerEntry = some e) :
    e ∈ H.entryAddrs ∧ (Role.ord sd.col).inEntry e = true ∧
      ∃ h, H.heightAt e = some h ∧ h.cols.getLast? = some [(e.col.num 0, Tree.empty)] := by sorry

/-- D1.6d (requested by U5 R7): an ordinary step has a nonempty last outer column. -/
theorem lastCol_of_ordinary {E : Forest} (h : stepKind E = some .ordinary) :
    E.cols.getLast? ≠ some [] := by sorry

/-- D1.6d (requested by U3 R4): the stopping data in role form. -/
theorem stopData_roles {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    sd.t = sd.col.num 0 ∧ sd.depth = sd.col.path.length ∧
    E.colAt sd.col = some (sd.Q ++ [(sd.r, Tree.empty)]) ∧
    E.entryAt (closingSlot sd) = some (sd.r, Tree.empty) ∧
    E.truncAfter (closingSlot sd) = E ∧
    ∃ qs : List Role, E.roles = Packet.rolesBefore E (.ord sd.col) ++ .ord sd.col ::
      (qs ++ [.slot (closingSlot sd)]) ∧ ∀ x ∈ qs, Packet.inQueryRegion sd x = true := by sorry

/-- D1.6d (requested by U3 R5): the root column lies on the stopping column's path, and the owner
flag is containment by the root's last entry. -/
theorem rootData_path {E : Forest} {sd : StopData} {rd : RootData}
    (hsd : stopData E = some sd) (h : rootData E = some rd) :
    sd.col.resolve 0 sd.r = some rd.col ∧ rd.col.num 0 = sd.r ∧ rd.layer = rd.col.path.length ∧
    rd.col.path <+: sd.col.path ∧
    rd.cursor = cursor (rootKeys E rd) (queryKeys sd) ∧
    (rd.owner = true ↔ (rd.col.container sd.col).isSome) ∧
    (∀ e, rd.col.container sd.col = some e → e.idx + 1 = Packet.rootLenOf E rd) := by sorry

/-- D1.6d (requested by U3 R6): the ordinary branch with `specialStop` unfolded. -/
theorem stepKind_ordinary_iff_unfold {E : Forest} (hE : E ≠ Tree.empty) (hV : CondV E)
    (hI : CondI E) :
    stepKind E = some .ordinary ↔
      ∃ sd, stopData E = some sd ∧
        ¬ (0 < sd.depth ∧ sd.Q = [] ∧ sd.r + (sd.col.col + 1) = sd.t) ∧
        (sd.col.resolve 0 sd.r).isSome := by sorry

/-- D1.6d (requested by U2 REQ-U1-3, converse; used by U2 D3.1e item 1): if the last route column
of `E` ends in an entry with empty height, the paper's route stops there. -/
theorem stopData_of_route {E : Forest} {c : ColAddr} {Q : Column} {r : Nat}
    (hc : (routeCols E).getLast? = some c) (hcol : E.colAt c = some (Q ++ [(r, Tree.empty)])) :
    stopData E = some { depth := c.path.length, col := c, t := c.num 0, r := r, Q := Q } := by
  sorry

mutual
/-- D1.9b helper: the number of roles does not depend on the address prefix. -/
theorem rolesF_length_eq {α : Type} : (π π' : List (Nat × Nat)) → (t : Tree α) →
    (Tree.rolesF π t).length = (Tree.rolesF π' t).length
  | π, π', .node cols => by simp only [Tree.rolesF]; exact rolesCols_length_eq π π' 0 0 cols
theorem rolesCols_length_eq {α : Type} : (π π' : List (Nat × Nat)) → (c c' : Nat) →
    (cs : List (List (α × Tree α))) → (Tree.rolesCols π c cs).length = (Tree.rolesCols π' c' cs).length
  | _, _, _, _, [] => rfl
  | π, π', c, c', col :: rest => by
    simp only [Tree.rolesCols, List.length_cons, List.length_append]
    rw [rolesCol_length_eq π π' c c' 0 0 col, rolesCols_length_eq π π' (c + 1) (c' + 1) rest]
theorem rolesCol_length_eq {α : Type} : (π π' : List (Nat × Nat)) → (c c' i i' : Nat) →
    (es : List (α × Tree α)) → (Tree.rolesCol π c i es).length = (Tree.rolesCol π' c' i' es).length
  | _, _, _, _, _, _, [] => rfl
  | π, π', c, c', i, i', (_, h) :: rest => by
    simp only [Tree.rolesCol, List.length_cons, List.length_append]
    rw [rolesF_length_eq (π ++ [(c, i)]) (π' ++ [(c', i')]) h,
      rolesCol_length_eq π π' c c' (i + 1) (i' + 1) rest]
end

/-- D1.9b helper: the height of the last entry of the last column has at least two roles fewer
(the last column's role and the entry's slot). -/
theorem size_lastHeight (cs : List Column) (es : Column) (q : Nat) (h : Forest) :
    h.size + 2 ≤ (Tree.node (cs ++ [es ++ [(q, h)]])).size := by
  unfold Tree.size Tree.roles
  simp only [Tree.rolesF, Tree.rolesCols_append, Tree.rolesCols, Tree.rolesCol_append, Tree.rolesCol,
    List.length_append, List.length_cons, List.length_nil]
  rw [rolesF_length_eq [] ([] ++ [(0 + cs.length, 0 + es.length)]) h]
  omega

/-- D1.9b helper: one step of the route through the last entry of the last column. -/
theorem routeColsAux_snoc (m : Nat) (π : List (Nat × Nat)) (cs : List Column) (es : Column)
    (q : Nat) (h : Forest) :
    routeColsAux (m + 1) (.node (cs ++ [es ++ [(q, h)]])) π =
      ⟨π, cs.length⟩ :: routeColsAux m h (π ++ [(cs.length, es.length)]) := by
  simp [routeColsAux, Tree.cols]

theorem routeColsAux_empty (m : Nat) (π : List (Nat × Nat)) :
    routeColsAux m (Tree.node []) π = [] := by
  cases m <;> rfl

/-- D1.9b helper: entries and columns below the last entry of the last column. -/
theorem entryAt_snoc_cons (cs : List Column) (es : Column) (q : Nat) (h : Forest)
    (ρ : List (Nat × Nat)) (j k : Nat) :
    (Tree.node (cs ++ [es ++ [(q, h)]])).entryAt ⟨⟨(cs.length, es.length) :: ρ, j⟩, k⟩ =
      h.entryAt ⟨⟨ρ, j⟩, k⟩ := by
  rw [Tree.entryAt_eq_bind, Tree.entryAt_eq_bind, Tree.forestAt_cons]
  simp [Tree.cols]

theorem colAt_snoc_cons (cs : List Column) (es : Column) (q : Nat) (h : Forest)
    (ρ : List (Nat × Nat)) (j : Nat) :
    (Tree.node (cs ++ [es ++ [(q, h)]])).colAt ⟨(cs.length, es.length) :: ρ, j⟩ = h.colAt ⟨ρ, j⟩ := by
  unfold Tree.colAt
  rw [Tree.forestAt_cons]
  simp [Tree.cols]

/-- D1.9b helper: the word of a nonempty forest is nonempty. -/
theorem wordAt_ne_nil {d : Nat} {h : Forest} (hh : h.cols ≠ []) : wordAt d h ≠ [] := by
  obtain ⟨cols⟩ := h
  cases cols with
  | nil => exact absurd rfl hh
  | cons col rest =>
    cases col with
    | nil => simp [wordAt, wordCols, wordCol]
    | cons x es => obtain ⟨p, H⟩ := x; simp [wordAt, wordCols, wordCol]

/-- D1.9b helper: the entry atom `(2e, 1, p)` (`first`) or `(2e+1, 0, p)`. -/
def entryAtom (e p : Nat) (first : Bool) : WordAtom :=
  if first then toLex (2 * e, toLex (1, p)) else toLex (2 * e + 1, toLex (0, p))

/-- D1.9b helper: the last atom of a word along the route, by strong induction on the size,
relative to a depth `d` and address prefix `π`, for every adequate fuel; `G₀` is the forest
without that atom. -/
theorem lastAtom_route : ∀ (n : Nat) (F : Forest) (d : Nat) (π : List (Nat × Nat))
    (W : List WordAtom) {e p : Nat} {first : Bool}, F.size ≤ n →
    wordAt d F = W ++ [entryAtom e p first] →
    ∃ (c : ColAddr) (k : Nat) (ρ : List (Nat × Nat)) (G₀ : Forest),
      c.path = π ++ ρ ∧ d ≤ e ∧ ρ.length = e - d ∧ (k = 0 ↔ first = true) ∧
      (∀ fuel, F.size < fuel → (routeColsAux fuel F π).getLast? = some c) ∧
      F.entryAt ⟨⟨ρ, c.col⟩, k⟩ = some (p, Tree.empty) ∧
      ((F.colAt ⟨ρ, c.col⟩).getD []).length = k + 1 ∧ wordAt d G₀ = W ∧
      (∀ fuel fuel', F.size < fuel → G₀.size < fuel' →
        (routeColsAux fuel' G₀ π).take (e - d) = (routeColsAux fuel F π).take (e - d)) ∧
      (k ≠ 0 → (∀ fuel', G₀.size < fuel' → (routeColsAux fuel' G₀ π)[e - d]? = some c) ∧
        G₀.colAt ⟨ρ, c.col⟩ = some (((F.colAt ⟨ρ, c.col⟩).getD []).take k)) := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro F d π W e p first hn hw
  obtain ⟨cols⟩ := F
  rcases List.eq_nil_or_concat' cols with rfl | ⟨cs, col, rfl⟩
  · simp [wordAt, wordCols] at hw
  rcases List.eq_nil_or_concat' col with rfl | ⟨es, ⟨q, h⟩, rfl⟩
  · exfalso
    rw [wordAt, wordCols_append, wordCols, wordCols, List.append_nil, wordCol] at hw
    have := (List.append_singleton_inj.mp hw).2
    unfold entryAtom at this
    split at this <;> (simp at this; try omega)
  rw [wordAt, wordCols_append, wordCols, wordCols, List.append_nil, wordCol_snoc] at hw
  by_cases hh : h.cols = []
  · -- the last entry has an empty height: it carries the last atom
    obtain ⟨hc⟩ := h
    simp only [Tree.cols] at hh
    subst hh
    have hR : ∀ fuel, (Tree.node (cs ++ [es ++ [(q, Tree.node [])]])).size < fuel →
        routeColsAux fuel (Tree.node (cs ++ [es ++ [(q, Tree.node [])]])) π = [⟨π, cs.length⟩] := by
      intro fuel hf
      obtain ⟨m, rfl⟩ : ∃ m, fuel = m + 1 := ⟨fuel - 1, by omega⟩
      rw [routeColsAux_snoc, routeColsAux_empty]
    have hE : (Tree.node (cs ++ [es ++ [(q, Tree.node [])]])).entryAt ⟨⟨[], cs.length⟩, es.length⟩ =
        some (q, Tree.empty) := by
      simp [Tree.entryAt_eq_bind, Tree.forestAt, Tree.cols, Tree.empty]
    have hC : (Tree.node (cs ++ [es ++ [(q, Tree.node [])]])).colAt ⟨[], cs.length⟩ =
        some (es ++ [(q, Tree.node [])]) := by
      simp [Tree.colAt, Tree.forestAt, Tree.cols]
    have hw0 : wordAt (d + 1) (Tree.node ([] : List Column)) = [] := rfl
    rw [hw0, List.append_nil] at hw
    rcases List.eq_nil_or_concat' es with rfl | ⟨es', x', rfl⟩
    · -- first entry: the atom `(2d, 1, q)`
      have hcol : wordCol d ([] ++ [(q, Tree.empty)]) = [toLex (2 * d, toLex (1, q))] := by
        simp [wordCol, wordLater, Tree.empty, wordAt, wordCols]
      rw [hcol] at hw
      obtain ⟨hW, hz⟩ := List.append_singleton_inj.mp hw
      unfold entryAtom at hz
      cases first with
      | false => simp at hz
      | true =>
        simp at hz
        obtain ⟨rfl, rfl⟩ := hz
        refine ⟨⟨π, cs.length⟩, 0, [], Tree.node cs, by simp, le_rfl, by simp, by simp, ?_, ?_, ?_,
          ?_, ?_, by simp⟩
        · intro fuel hf; rw [hR fuel hf]; rfl
        · simpa using hE
        · rw [hC]; simp
        · simp [wordAt, hW]
        · intro fuel fuel' _ _; simp
    · -- later entry: the atom `(2d+1, 0, q)`
      have hcol : wordCol d (es' ++ [x'] ++ [(q, Tree.empty)]) =
          wordCol d (es' ++ [x']) ++ [toLex (2 * d + 1, toLex (0, q))] := by
        rw [wordCol_append_of_ne_nil d (by simp)]
        simp [wordLater, Tree.empty, wordAt, wordCols]
      rw [hcol, ← List.append_assoc] at hw
      obtain ⟨hW, hz⟩ := List.append_singleton_inj.mp hw
      unfold entryAtom at hz
      cases first with
      | true => simp at hz
      | false =>
        simp at hz
        obtain ⟨rfl, rfl⟩ := hz
        refine ⟨⟨π, cs.length⟩, (es' ++ [x']).length, [], Tree.node (cs ++ [es' ++ [x']]), by simp,
          le_rfl, by simp, by simp, ?_, ?_, ?_, ?_, ?_, ?_⟩
        · intro fuel hf; rw [hR fuel hf]; rfl
        · simpa using hE
        · rw [hC]; simp
        · simp [wordAt, wordCols_append, wordCols, hW]
        · intro fuel fuel' _ _; simp
        · intro _
          refine ⟨fun fuel' hf => ?_, ?_⟩
          · obtain ⟨m, rfl⟩ : ∃ m, fuel' = m + 1 := ⟨fuel' - 1, by omega⟩
            obtain ⟨q', h'⟩ := x'
            rw [routeColsAux_snoc]; simp
          · rw [hC]; simp [Tree.colAt, Tree.forestAt, Tree.cols, List.take_append]
  · -- the last entry has a nonempty height: the last atom lies in it
    obtain ⟨W', z', hW'⟩ := (List.eq_nil_or_concat' (wordAt (d + 1) h)).resolve_left
      (wordAt_ne_nil hh)
    rw [hW', ← List.append_assoc, ← List.append_assoc] at hw
    obtain ⟨hW, rfl⟩ := List.append_singleton_inj.mp hw
    have hsz := size_lastHeight cs es q h
    obtain ⟨c, k, ρ', G₀', hc, hde, hρ, hk, hR, hE, hcol, hWG, hT, hK⟩ :=
      ih h.size (by omega) h (d + 1) (π ++ [(cs.length, es.length)]) W' le_rfl hW'
    have hsz' := size_lastHeight cs es q G₀'
    refine ⟨c, k, (cs.length, es.length) :: ρ', Tree.node (cs ++ [es ++ [(q, G₀')]]),
      by simp [hc], by omega, by simp; omega, hk, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro fuel hf
      obtain ⟨m, rfl⟩ : ∃ m, fuel = m + 1 := ⟨fuel - 1, by omega⟩
      rw [routeColsAux_snoc, List.getLast?_cons, hR m (by omega)]
      rfl
    · rw [entryAt_snoc_cons]; exact hE
    · rw [colAt_snoc_cons]; exact hcol
    · rw [wordAt, wordCols_append, wordCols, wordCols, List.append_nil, wordCol_snoc, hWG, ← hW,
        List.append_assoc]
    · intro fuel fuel' hf hf'
      obtain ⟨m, rfl⟩ : ∃ m, fuel = m + 1 := ⟨fuel - 1, by omega⟩
      obtain ⟨m', rfl⟩ : ∃ m', fuel' = m' + 1 := ⟨fuel' - 1, by omega⟩
      obtain ⟨t, ht⟩ : ∃ t, e - d = t + 1 := ⟨e - d - 1, by omega⟩
      rw [routeColsAux_snoc, routeColsAux_snoc, ht, List.take_succ_cons, List.take_succ_cons,
        show t = e - (d + 1) by omega, hT m m' (by omega) (by omega)]
    · intro hk0
      obtain ⟨hK1, hK2⟩ := hK hk0
      refine ⟨fun fuel' hf' => ?_, ?_⟩
      · obtain ⟨m', rfl⟩ : ∃ m', fuel' = m' + 1 := ⟨fuel' - 1, by omega⟩
        obtain ⟨t, ht⟩ : ∃ t, e - d = t + 1 := ⟨e - d - 1, by omega⟩
        rw [routeColsAux_snoc, ht, List.getElem?_cons_succ, show t = e - (d + 1) by omega]
        exact hK1 m' (by omega)
      · rw [colAt_snoc_cons, colAt_snoc_cons]; exact hK2

/-- D1.9b (requested by U2 REQ-U1-14, for N2.1): a one-atom extension of a word. If
`w(E) = w(G) ⌢ [z]` with `z` an entry atom at depth `e` (`(2e,1,p)` if `first`, else
`(2e+1,0,p)`), then the last route column `c` of `E` has depth `e` and ends in its entry `k`,
which is `(p, ∅)`, `k = 0` iff `first`; `G` is the safe prefix of `E` without that atom; the route
columns of depth `< e` are shared; and for `k ≠ 0` the column `c` is the route column of `G` at
depth `e`, holding the first `k` entries of `E`'s column. -/
theorem routeCols_of_word_snoc {G E : Forest} {e p : Nat} {first : Bool}
    (hw : word E = word G ++
      [if first then toLex (2 * e, toLex (1, p)) else toLex (2 * e + 1, toLex (0, p))]) :
    ∃ (c : ColAddr) (k : Nat), c.path.length = e ∧ (k = 0 ↔ first = true) ∧
      (routeCols E).getLast? = some c ∧ E.entryAt ⟨c, k⟩ = some (p, Tree.empty) ∧
      ((E.colAt c).getD []).length = k + 1 ∧ G = safePrefix E (mu E - 1) ∧
      (routeCols G).take e = (routeCols E).take e ∧
      (k ≠ 0 → (routeCols G)[e]? = some c ∧ G.colAt c = some (((E.colAt c).getD []).take k)) := by
  obtain ⟨c, k, ρ, G₀, hc, -, hρ, hk, hR, hE, hcol, hWG, hT, hK⟩ :=
    lastAtom_route E.size E 0 [] (word G) le_rfl hw
  simp only [List.nil_append] at hc
  have hc' : c = ⟨ρ, c.col⟩ := by rw [← hc]
  have hG : G = G₀ := word_injective hWG.symm
  subst hG
  unfold routeCols
  refine ⟨c, k, by rw [hc, hρ]; rfl, hk, hR _ (Nat.lt_succ_self _), by rw [hc']; exact hE,
    by rw [hc']; exact hcol, ?_, ?_, ?_⟩
  · apply word_injective
    rw [word_safePrefix, hw]
    simp [mu, hw]
  · simpa using hT _ _ (Nat.lt_succ_self _) (Nat.lt_succ_self _)
  · intro hk0
    obtain ⟨hK1, hK2⟩ := hK hk0
    refine ⟨by simpa using hK1 _ (Nat.lt_succ_self _), ?_⟩
    rw [hc']; exact hK2

mutual
/-- N1.4 helper: `wordAt_add` with its column, entry and later-entry forms. -/
theorem wordAt_add' (δ : Nat) : (e : Nat) → (X : Forest) →
    wordAt (e + δ) X = (wordAt e X).map fun A => toLex ((ofLex A).1 + 2 * δ, (ofLex A).2)
  | e, .node cols => by simp only [wordAt]; exact wordCols_add δ e cols
theorem wordCols_add (δ : Nat) : (e : Nat) → (cs : List Column) →
    wordCols (e + δ) cs = (wordCols e cs).map fun A => toLex ((ofLex A).1 + 2 * δ, (ofLex A).2)
  | _, [] => rfl
  | e, c :: cs => by
    simp only [wordCols, List.map_append]
    rw [wordCol_add δ e c, wordCols_add δ e cs]
theorem wordCol_add (δ : Nat) : (e : Nat) → (c : Column) →
    wordCol (e + δ) c = (wordCol e c).map fun A => toLex ((ofLex A).1 + 2 * δ, (ofLex A).2)
  | e, [] => by simp only [wordCol, List.map_cons, List.map_nil, ofLex_toLex, Nat.mul_add]
  | e, (p, h) :: es => by
    simp only [wordCol, List.map_cons, List.map_append]
    rw [show e + δ + 1 = e + 1 + δ by omega, wordAt_add' δ (e + 1) h, wordLater_add δ e es]
    simp only [ofLex_toLex, Nat.mul_add]
theorem wordLater_add (δ : Nat) : (e : Nat) → (c : Column) →
    wordLater (e + δ) c = (wordLater e c).map fun A => toLex ((ofLex A).1 + 2 * δ, (ofLex A).2)
  | _, [] => rfl
  | e, (p, h) :: es => by
    simp only [wordLater, List.map_cons, List.map_append]
    rw [show e + δ + 1 = e + 1 + δ by omega, wordAt_add' δ (e + 1) h, wordLater_add δ e es]
    simp only [ofLex_toLex, Nat.mul_add]
    rw [show 2 * e + 2 * δ + 1 = 2 * e + 1 + 2 * δ by omega]
end

/-- N1.4 (requested by U2 REQ-U1-18): the word at a deeper starting depth adds `2δ` to every depth
coordinate. -/
theorem wordAt_add (e δ : Nat) (X : Forest) :
    wordAt (e + δ) X = (wordAt e X).map fun A => toLex ((ofLex A).1 + 2 * δ, (ofLex A).2) :=
  wordAt_add' δ e X

/-- N1.4: relabelling of a word atom: the empty-column atom (even depth coordinate, marker `0`)
is fixed; every entry atom has its third coordinate relabelled. -/
def WordAtom.relabel (f : Nat → Nat) (A : WordAtom) : WordAtom :=
  if (ofLex A).1 % 2 = 0 ∧ (ofLex (ofLex A).2).1 = 0 then A
  else toLex ((ofLex A).1, toLex ((ofLex (ofLex A).2).1, f (ofLex (ofLex A).2).2))

mutual
/-- N1.4 helper: `wordAt_map` with its column, entry and later-entry forms. -/
theorem wordAt_map' (f : Nat → Nat) : (e : Nat) → (X : Forest) →
    wordAt e (Tree.map f X) = (wordAt e X).map (WordAtom.relabel f)
  | e, .node cols => by simp only [Tree.map, wordAt]; exact wordCols_map f e cols
theorem wordCols_map (f : Nat → Nat) : (e : Nat) → (cs : List Column) →
    wordCols e (Tree.mapCols f cs) = (wordCols e cs).map (WordAtom.relabel f)
  | _, [] => rfl
  | e, c :: cs => by
    simp only [Tree.mapCols, wordCols, List.map_append]
    rw [wordCol_map f e c, wordCols_map f e cs]
theorem wordCol_map (f : Nat → Nat) : (e : Nat) → (c : Column) →
    wordCol e (Tree.mapCol f c) = (wordCol e c).map (WordAtom.relabel f)
  | e, [] => by simp [Tree.mapCol, wordCol, WordAtom.relabel]
  | e, (p, h) :: es => by
    simp only [Tree.mapCol, wordCol, List.map_cons, List.map_append]
    rw [wordAt_map' f (e + 1) h, wordLater_map f e es]
    simp [WordAtom.relabel]
theorem wordLater_map (f : Nat → Nat) : (e : Nat) → (c : Column) →
    wordLater e (Tree.mapCol f c) = (wordLater e c).map (WordAtom.relabel f)
  | _, [] => rfl
  | e, (p, h) :: es => by
    simp only [Tree.mapCol, wordLater, List.map_cons, List.map_append]
    rw [wordAt_map' f (e + 1) h, wordLater_map f e es]
    simp [WordAtom.relabel, Nat.add_mod]
end

/-- N1.4 (requested by U2 REQ-U1-18): relabelling a forest relabels its word atom by atom. -/
theorem wordAt_map (e : Nat) (f : Nat → Nat) (X : Forest) :
    wordAt e (Tree.map f X) = (wordAt e X).map (WordAtom.relabel f) := wordAt_map' f e X

/-- L2.1d (requested by U3 R7): a reduced `⊤`-free query below the boundary of entry `u` stops at
or before `u`, and the scan is unchanged when the column is cut after `u` with key `u` raised
to `⊤`. -/
theorem cursor_cappedAt (ks W : List (WithTop Key)) (u : Nat) (hu : u < ks.length)
    (hW : W.Pairwise fun x y => y ≤ x) (hT : ∀ y ∈ W, y ≠ ⊤)
    (hlt : W < cutQuery ks (u + 1)) :
    cursor ks W ≤ u ∧ cursor ks W = cursor (ks.take u ++ [⊤]) W := by sorry

/-- L2.3c (requested by U3 R8): the cut barrier read at a containing column on the cut chain. -/
theorem cut_barrier_read {E : Forest} (hE : InL E) {c : ColAddr} (hc : c ∈ E.colAddrs)
    {k : Nat} (hk : k ≤ (parents E c).length) {y : Nat}
    (hy : Path E (actualKeys E) c (cutQuery (actualKeys E c) k) (cutStart E c k) y)
    {o : ColAddr} (ho : c.resolve 0 y = some o) {e : EntryAddr} (he : o.container c = some e) :
    cutQuery (actualKeys E c) k < cutQuery (actualKeys E o) (e.idx + 1) := by sorry

/-- L2.5d (requested by U5 R15): the trace of the raw scan starts at `(0,0)`, moves by the three
comparison rules, stays within the cursors, and ends at `(cursor, j)` with `j = |qry|` when the
source is not exhausted. -/
theorem trace_spec {α : Type} [LinearOrder α] (src qry : List α) :
    (trace src qry).head? = some (0, 0) ∧
    (∀ k s s', (trace src qry)[k]? = some s → (trace src qry)[k + 1]? = some s' →
      ∃ x y, src[s.1]? = some x ∧ qry[s.2]? = some y ∧
        ((x < y ∧ s' = (s.1 + 1, s.2)) ∨ (x = y ∧ s' = (s.1 + 1, s.2 + 1)) ∨
          (y < x ∧ s' = (s.1, s.2 + 1)))) ∧
    (∀ s ∈ trace src qry, s.1 ≤ cursor src qry ∧ s.2 ≤ qry.length) ∧
    ∃ j, (trace src qry).getLast? = some (cursor src qry, j) ∧
      (cursor src qry < src.length → j = qry.length) := by sorry

end Scan

end BTBMS
