namespace BTBMS

universe u

open Cardinal

namespace Hier

namespace Refl

open FirstOrder FirstOrder.Language

/-! ## N4.3: the language `{<, Elem, Edge}` and the structures `M(ν, Q)` -/

/-- N4.3: relation symbols. -/
inductive Rel : Nat → Type
  | lt : Rel 2
  | elem : Rel 2
  | edge : Rel 3

/-- N4.3: the relational language of ordinal structures. -/
def lang : Language.{0, 0} := ⟨fun _ => Empty, Rel⟩

/-- N4.3: points of `M(ν, Q)`: the ordinals below `ν`. -/
@[ext] structure Carrier (ν : Ordinal.{u}) (Q : Prims.{u}) : Type (u + 1) where
  val : Ordinal.{u}
  lt : val < ν

/-- N4.3: the relations of `M(ν, Q)`: the true order, and `Q` restricted to `ν`. -/
def relMap {ν : Ordinal.{u}} {Q : Prims.{u}} : {n : Nat} → Rel n → (Fin n → Carrier ν Q) → Prop
  | _, .lt, xs => (xs 0).val < (xs 1).val
  | _, .elem, xs => Q.Elem (xs 0).val (xs 1).val
  | _, .edge, xs => Q.Edge (xs 0).val (xs 1).val (xs 2).val

/-- N4.3: `M(ν, Q)` as a first-order structure. -/
instance instStructure (ν : Ordinal.{u}) (Q : Prims.{u}) : lang.Structure (Carrier ν Q) where
  funMap := fun f => Empty.elim f
  RelMap := fun r xs => relMap r xs

/-! ## N4.4: translation of the diagram grammar into first-order formulas -/

/-- N4.4: `t₁ < t₂`. -/
def ltB {α : Type} {n : Nat} (t₁ t₂ : lang.Term (α ⊕ Fin n)) : lang.BoundedFormula α n :=
  Relations.boundedFormula₂ (Rel.lt : lang.Relations 2) t₁ t₂

/-- N4.4: a free variable as a term. -/
def fv {α : Type} {n : Nat} (a : α) : lang.Term (α ⊕ Fin n) := Term.var (Sum.inl a)

/-- N4.4: "`x₀` is a limit ordinal greater than `ω`", read in an initial segment of the
ordinals: `x₀ ≠ 0`, `x₀` is not a successor, and some `y < x₀` is a nonzero non-successor. -/
def limFml : lang.Formula (Fin 1) :=
  (∃' ltB (&0) (fv 0)) ⊓
    (∀' (ltB (&0) (fv 0) ⟹ ∃' (ltB (&0) (&1) ⊓ ltB (&1) (fv 0)))) ⊓
    (∃' (ltB (&0) (fv 0) ⊓ (∃' ltB (&1) (&0)) ⊓
      (∀' (ltB (&1) (&0) ⟹ ∃' (ltB (&1) (&2) ⊓ ltB (&2) (&0))))))

/-- N4.4: translation of a base atom. -/
def baseFml {V : Type} : BaseAtom V → lang.Formula V
  | .lim x => limFml.relabel (fun _ => x)
  | .lt x y => Relations.formula₂ (Rel.lt : lang.Relations 2) (Term.var x) (Term.var y)
  | .le x y => (Relations.formula₂ (Rel.lt : lang.Relations 2) (Term.var y) (Term.var x)).not
  | .eq x y => Term.equal (Term.var x) (Term.var y)
  | .elem x y => Relations.formula₂ (Rel.elem : lang.Relations 2) (Term.var x) (Term.var y)
  | .edge c b a =>
      Relations.formula (Rel.edge : lang.Relations 3) ![Term.var c, Term.var b, Term.var a]

/-- N4.4: the new (unframed) variables of a block problem. -/
abbrev NewVars {W V : Type} (D : List (BaseAtom W)) (fr : W → Option V) : Type :=
  {x : W // x ∈ baseVars D ∧ fr x = none}

/-- N4.4: finitely many new variables. -/
instance {W V : Type} (D : List (BaseAtom W)) (fr : W → Option V) : Finite (NewVars D fr) := by
  classical
  exact Finite.of_injective (fun x : NewVars D fr => (⟨x.1, x.2.1⟩ : {y // y ∈ baseVars D}))
    (fun a b h => Subtype.ext (congrArg (fun z : {y // y ∈ baseVars D} => z.1) h))

open Classical in
/-- N4.4: variables of a block problem: new variables are bound, framed ones read the frame
(the default `d` is never used on base variables). -/
noncomputable def blockVar {W V : Type} (D : List (BaseAtom W)) (fr : W → Option V) (d : V)
    (x : W) : V ⊕ NewVars D fr :=
  if h : x ∈ baseVars D ∧ fr x = none then Sum.inr ⟨x, h⟩ else Sum.inl ((fr x).getD d)

open Classical in
/-- N4.4: the bounds of a block: new variables in `(L, u)`, framed ones below `u`. -/
noncomputable def boundFml {W V : Type} (D : List (BaseAtom W)) (fr : W → Option V) (u L : V)
    (x : W) : lang.Formula (V ⊕ NewVars D fr) :=
  if x ∈ baseVars D ∧ fr x = none then
    Relations.formula₂ (Rel.lt : lang.Relations 2) (Term.var (Sum.inl L))
        (Term.var (blockVar D fr u x)) ⊓
      Relations.formula₂ (Rel.lt : lang.Relations 2) (Term.var (blockVar D fr u x))
        (Term.var (Sum.inl u))
  else
    Relations.formula₂ (Rel.lt : lang.Relations 2) (Term.var (blockVar D fr u x))
      (Term.var (Sum.inl u))

/-- N4.4: `BlockAbove` as a formula: some values of the new variables satisfy the bounds and
the block. -/
noncomputable def blockFml {W V : Type} (D : List (BaseAtom W)) (fr : W → Option V) (u L : V) :
    lang.Formula V :=
  Formula.iExs (NewVars D fr)
    ((((baseVars D).map (boundFml D fr u L)).foldr (· ⊓ ·) ⊤) ⊓
      ((D.map (fun b => baseFml (b.map (blockVar D fr u)))).foldr (· ⊓ ·) ⊤))

/-- N4.4: translation of an atom of the full grammar. -/
noncomputable def atomFml {V : Type} : Atom V → lang.Formula V
  | .base b => baseFml b
  | .noReal D fr u L => (blockFml D fr u L).not

/-- N4.4: translation of a diagram (conjunction of its atoms). -/
noncomputable def diagramFml {V : Type} (D : Diagram V) : lang.Formula V :=
  (List.map atomFml D).foldr (· ⊓ ·) ⊤

/-! ### N4.4 helpers: atoms, finite tuples, conjunctions -/

/-- N4.4 (helper): `ltB` reads the true order. -/
theorem realize_ltB {ν : Ordinal.{u}} {Q : Prims.{u}} {α : Type} {n : Nat}
    (t₁ t₂ : lang.Term (α ⊕ Fin n)) (v : α → Carrier ν Q) (xs : Fin n → Carrier ν Q) :
    (ltB t₁ t₂).Realize v xs ↔
      (t₁.realize (Sum.elim v xs)).val < (t₂.realize (Sum.elim v xs)).val := Iff.rfl

/-- N4.4 (helper): the order atom between two variables. -/
theorem realize_lt_var {ν : Ordinal.{u}} {Q : Prims.{u}} {β : Type} (x y : β)
    (v : β → Carrier ν Q) :
    (Relations.formula₂ (L := lang) Rel.lt (Term.var x) (Term.var y)).Realize v ↔
      (v x).val < (v y).val := Iff.rfl

/-- N4.4 (helper): the `Elem` atom between two variables. -/
theorem realize_elem_var {ν : Ordinal.{u}} {Q : Prims.{u}} {β : Type} (x y : β)
    (v : β → Carrier ν Q) :
    (Relations.formula₂ (L := lang) Rel.elem (Term.var x) (Term.var y)).Realize v ↔
      Q.Elem (v x).val (v y).val := Iff.rfl

/-- N4.4 (helper): the `Edge` atom between three variables. -/
theorem realize_edge_var {ν : Ordinal.{u}} {Q : Prims.{u}} {β : Type} (x y z : β)
    (v : β → Carrier ν Q) :
    (Relations.formula (L := lang) Rel.edge ![Term.var x, Term.var y, Term.var z]).Realize
      v ↔ Q.Edge (v x).val (v y).val (v z).val := Iff.rfl

/-- N4.4 (helper): finite conjunctions of formulas. -/
theorem realize_foldr_inf_formula {M : Type*} [lang.Structure M] {α : Type}
    (l : List (lang.Formula α)) (v : α → M) :
    (l.foldr (· ⊓ ·) ⊤).Realize v ↔ ∀ φ ∈ l, φ.Realize v :=
  BoundedFormula.realize_foldr_inf l v default

section snoc
variable {M : Type*} (a b c : M)
/-- N4.4 (helper): evaluating bound-variable tuples. -/
theorem snoc1_0 : (Fin.snoc (default : Fin 0 → M) a : Fin 1 → M) 0 = a := rfl
/-- N4.4 (helper). -/
theorem snoc2_0 : (Fin.snoc (Fin.snoc (default : Fin 0 → M) a : Fin 1 → M) b : Fin 2 → M) 0 = a :=
  rfl
/-- N4.4 (helper). -/
theorem snoc2_1 : (Fin.snoc (Fin.snoc (default : Fin 0 → M) a : Fin 1 → M) b : Fin 2 → M) 1 = b :=
  rfl
/-- N4.4 (helper). -/
theorem snoc3_0 : (Fin.snoc (Fin.snoc (Fin.snoc (default : Fin 0 → M) a : Fin 1 → M) b :
    Fin 2 → M) c : Fin 3 → M) 0 = a := rfl
/-- N4.4 (helper). -/
theorem snoc3_1 : (Fin.snoc (Fin.snoc (Fin.snoc (default : Fin 0 → M) a : Fin 1 → M) b :
    Fin 2 → M) c : Fin 3 → M) 1 = b := rfl
/-- N4.4 (helper). -/
theorem snoc3_2 : (Fin.snoc (Fin.snoc (Fin.snoc (default : Fin 0 → M) a : Fin 1 → M) b :
    Fin 2 → M) c : Fin 3 → M) 2 = c := rfl
end snoc

/-- N4.4 (helper): "nonzero and not a successor", read among the points of `M(ν, Q)`. -/
theorem isSuccLimit_iff_carrier {ν : Ordinal.{u}} {Q : Prims.{u}} {o : Ordinal.{u}} (ho : o < ν) :
    ((∃ a : Carrier ν Q, a.val < o) ∧
      ∀ a : Carrier ν Q, a.val < o → ∃ b : Carrier ν Q, a.val < b.val ∧ b.val < o) ↔
      Order.IsSuccLimit o := by
  constructor
  · rintro ⟨⟨a, ha⟩, h⟩
    rw [Ordinal.isSuccLimit_iff, Order.isSuccPrelimit_iff_succ_lt]
    refine ⟨(zero_le.trans_lt ha).ne', fun b hb => ?_⟩
    obtain ⟨c, hbc, hco⟩ := h ⟨b, hb.trans ho⟩ hb
    exact (Order.succ_le_of_lt hbc).trans_lt hco
  · intro hl
    exact ⟨⟨⟨0, hl.pos.trans ho⟩, hl.pos⟩, fun a ha =>
      ⟨⟨Order.succ a.val, (hl.succ_lt ha).trans ho⟩, Order.lt_succ a.val, hl.succ_lt ha⟩⟩

/-- N4.4: correctness of `limFml` in every `M(ν, Q)`. -/
theorem realize_limFml {ν : Ordinal.{u}} {Q : Prims.{u}} (x : Carrier ν Q) :
    limFml.Realize (fun _ => x) ↔ IsLim x.val := by
  simp only [limFml, fv, Formula.Realize, BoundedFormula.realize_inf, BoundedFormula.realize_ex,
    BoundedFormula.realize_all, BoundedFormula.realize_imp, realize_ltB, Term.realize_var,
    Function.comp_apply, Sum.elim_inl, Sum.elim_inr, snoc1_0, snoc2_0, snoc2_1, snoc3_0, snoc3_1,
    snoc3_2]
  rw [isSuccLimit_iff_carrier x.lt]
  have : (∃ a : Carrier ν Q, (a.val < x.val ∧ ∃ b : Carrier ν Q, b.val < a.val) ∧
      ∀ b : Carrier ν Q, b.val < a.val → ∃ c : Carrier ν Q, b.val < c.val ∧ c.val < a.val) ↔
      Ordinal.omega0 < x.val := by
    constructor
    · rintro ⟨a, ⟨hax, h₁⟩, h₂⟩
      exact (Ordinal.omega0_le_of_isSuccLimit
        ((isSuccLimit_iff_carrier a.lt).1 ⟨h₁, h₂⟩)).trans_lt hax
    · intro h
      refine ⟨⟨Ordinal.omega0, h.trans x.lt⟩, ?_⟩
      have := (isSuccLimit_iff_carrier (Q := Q) (h.trans x.lt)).2 Ordinal.isSuccLimit_omega0
      exact ⟨⟨h, this.1⟩, this.2⟩
  rw [this]
  rfl

/-- N4.4 (helper): a base atom under a renaming of variables. -/
theorem baseAtom_holds_map {W V : Type} (P : Prims.{u}) (b : BaseAtom W) (f : W → V)
    (a : V → Ordinal.{u}) : (b.map f).Holds P a ↔ b.Holds P (fun x => a (f x)) := by
  cases b <;> rfl

/-- N4.4 (helper): a base atom reads its assignment only on its own variables. -/
theorem baseAtom_holds_congr {V : Type} (P : Prims.{u}) (b : BaseAtom V) (a a' : V → Ordinal.{u})
    (h : ∀ x ∈ b.vars, a x = a' x) : b.Holds P a ↔ b.Holds P a' := by
  cases b <;> simp_all [BaseAtom.vars, BaseAtom.Holds]

/-- N4.4 (helper): the translation of one base atom. -/
theorem realize_baseFml {ν : Ordinal.{u}} {Q : Prims.{u}} {V : Type} (b : BaseAtom V)
    (v : V → Carrier ν Q) : (baseFml b).Realize v ↔ b.Holds Q (fun x => (v x).val) := by
  cases b with
  | lim x =>
    rw [baseFml, Formula.realize_relabel]
    exact realize_limFml (v x)
  | lt x y => exact realize_lt_var x y v
  | le x y =>
    rw [baseFml, Formula.realize_not, realize_lt_var]
    exact not_lt
  | eq x y =>
    rw [baseFml, Formula.realize_equal]
    exact Carrier.ext_iff
  | elem x y => exact realize_elem_var x y v
  | edge c b a => exact realize_edge_var c b a v

/-- N4.4 (helper): `blockVar` on a new variable. -/
theorem blockVar_new {W V : Type} (D : List (BaseAtom W)) (fr : W → Option V) (d : V) {x : W}
    (h : x ∈ baseVars D ∧ fr x = none) : blockVar D fr d x = Sum.inr ⟨x, h⟩ := dif_pos h

/-- N4.4 (helper): `blockVar` on a framed variable. -/
theorem blockVar_some {W V : Type} (D : List (BaseAtom W)) (fr : W → Option V) (d : V) {x : W}
    {y : V} (h : fr x = some y) : blockVar D fr d x = Sum.inl y := by
  rw [blockVar, dif_neg (by simp [h]), h]
  rfl

/-- N4.4 (helper): the bound conjunct of one variable. -/
theorem realize_boundFml {ν : Ordinal.{u}} {Q : Prims.{u}} {W V : Type} (D : List (BaseAtom W))
    (fr : W → Option V) (u L : V) (x : W) (w : V ⊕ NewVars D fr → Carrier ν Q) :
    (boundFml D fr u L x).Realize w ↔
      ((x ∈ baseVars D ∧ fr x = none) → (w (Sum.inl L)).val < (w (blockVar D fr u x)).val) ∧
        (w (blockVar D fr u x)).val < (w (Sum.inl u)).val := by
  unfold boundFml
  split_ifs with h
  · rw [Formula.realize_inf, realize_lt_var, realize_lt_var]
    exact ⟨fun h' => ⟨fun _ => h'.1, h'.2⟩, fun h' => ⟨h'.1 h, h'.2⟩⟩
  · rw [realize_lt_var]
    exact ⟨fun h' => ⟨fun h'' => absurd h'' h, h'⟩, fun h' => h'.2⟩

/-- N4.4: correctness of the block translation. -/
theorem realize_blockFml {ν : Ordinal.{u}} {Q : Prims.{u}} {W V : Type}
    (D : List (BaseAtom W)) (fr : W → Option V) (u L : V) (v : V → Carrier ν Q) :
    (blockFml D fr u L).Realize v ↔
      BlockAbove Q D (fun x => (fr x).map (fun y => (v y).val)) (v L).val (v u).val := by
  unfold blockFml
  rw [Formula.realize_iExs]
  simp only [Formula.realize_inf, realize_foldr_inf_formula, List.forall_mem_map]
  constructor
  · rintro ⟨i, hb, hd⟩
    refine ⟨fun x => (Sum.elim v i (blockVar D fr u x)).val, ?_, ?_, ?_, ?_⟩
    · intro x o hx
      cases hfx : fr x with
      | none => simp [hfx] at hx
      | some y =>
        simp only [hfx, Option.map_some, Option.some.injEq] at hx
        subst hx
        show (Sum.elim v i (blockVar D fr u x)).val = _
        rw [blockVar_some D fr u hfx]
        rfl
    · intro x hx hnone
      exact ((realize_boundFml D fr u L x _).1 (hb x hx)).1 ⟨hx, Option.map_eq_none_iff.1 hnone⟩
    · intro x hx
      exact ((realize_boundFml D fr u L x _).1 (hb x hx)).2
    · intro b hbD
      have := hd b hbD
      rwa [realize_baseFml, baseAtom_holds_map] at this
  · rintro ⟨β, h₁, h₂, h₃, h₄⟩
    let i : NewVars D fr → Carrier ν Q := fun x => ⟨β x.1, (h₃ x.1 x.2.1).trans (v u).lt⟩
    have key : ∀ x ∈ baseVars D, (Sum.elim v i (blockVar D fr u x)).val = β x := by
      intro x hx
      cases hfx : fr x with
      | none => rw [blockVar_new D fr u ⟨hx, hfx⟩]; rfl
      | some y =>
        rw [blockVar_some D fr u hfx]
        exact (h₁ x _ (by simp [hfx])).symm
    refine ⟨i, fun x hx => ?_, fun b hbD => ?_⟩
    · rw [realize_boundFml]
      refine ⟨fun hn => ?_, ?_⟩
      · rw [key x hx]
        exact h₂ x hx (by simp [hn.2])
      · rw [key x hx]
        exact h₃ x hx
    · rw [realize_baseFml, baseAtom_holds_map]
      refine (baseAtom_holds_congr Q b _ _ fun x hx => ?_).1 (h₄ b hbD)
      exact (key x (List.mem_flatMap.2 ⟨b, hbD, hx⟩)).symm

/-- N4.4 (helper): the translation of one atom of the full grammar. -/
theorem realize_atomFml {ν : Ordinal.{u}} {Q : Prims.{u}} {V : Type} (A : Atom V)
    (v : V → Carrier ν Q) : (atomFml A).Realize v ↔ A.Holds Q (fun x => (v x).val) := by
  cases A with
  | base b => exact realize_baseFml b v
  | noReal D fr u L =>
    rw [atomFml, Formula.realize_not, realize_blockFml]
    rfl

/-- N4.4 (translation lemma): in every `M(ν, Q)`, the translation of a diagram holds exactly
when the diagram holds for `Q`. -/
theorem realize_diagramFml {ν : Ordinal.{u}} {Q : Prims.{u}} {V : Type} (D : Diagram V)
    (v : V → Carrier ν Q) : (diagramFml D).Realize v ↔ D.Holds Q (fun x => (v x).val) := by
  unfold diagramFml
  rw [realize_foldr_inf_formula]
  simp only [List.forall_mem_map, realize_atomFml]
  rfl

/-! ## N4.4: the reflection and transport properties, semantically and as formulas -/

/-- N4.4: fixed variables occurring in `D`. -/
abbrev FixT {V : Type} (D : Diagram V) (F : V → Prop) : Type := {x : V // x ∈ D.vars ∧ F x}

/-- N4.4: free variables occurring in `D`, other than `t`. -/
abbrev FreeT {V : Type} (D : Diagram V) (F : V → Prop) (t : Option V) : Type :=
  {x : V // x ∈ D.vars ∧ ¬ F x ∧ some x ≠ t}

/-- N4.4: finitely many fixed variables. -/
instance {V : Type} (D : Diagram V) (F : V → Prop) : Finite (FixT D F) := by
  classical
  exact Finite.of_injective (fun x : FixT D F => (⟨x.1, x.2.1⟩ : {y // y ∈ D.vars}))
    (fun a b h => Subtype.ext (congrArg (fun z : {y // y ∈ D.vars} => z.1) h))

/-- N4.4: finitely many free variables. -/
instance {V : Type} (D : Diagram V) (F : V → Prop) (t : Option V) : Finite (FreeT D F t) := by
  classical
  exact Finite.of_injective (fun x : FreeT D F t => (⟨x.1, x.2.1⟩ : {y // y ∈ D.vars}))
    (fun a b h => Subtype.ext (congrArg (fun z : {y // y ∈ D.vars} => z.1) h))

open Classical in
/-- N4.4: sorting the variables of `D`: the distinguished `t` goes to the coordinate `tgt`,
fixed ones to `FixT`, free ones to `FreeT`, others to the dummy coordinate `0`. -/
noncomputable def splitVar {V : Type} (D : Diagram V) (F : V → Prop) (t : Option V) {k : Nat}
    (tgt : Fin (k + 1)) (x : V) : (Fin (k + 1) ⊕ FixT D F) ⊕ FreeT D F t :=
  if some x = t then Sum.inl (Sum.inl tgt)
  else if h : x ∈ D.vars ∧ F x then Sum.inl (Sum.inr ⟨x, h⟩)
  else if h' : x ∈ D.vars ∧ ¬ F x ∧ some x ≠ t then Sum.inr ⟨x, h'⟩
  else Sum.inl (Sum.inl 0)

/-- N4.4: "every fixed value is below the coordinate `bd`". -/
noncomputable def fixBelowFml {V : Type} (D : Diagram V) (F : V → Prop) {k : Nat}
    (bd : Fin (k + 1)) : lang.Formula (Fin (k + 1) ⊕ FixT D F) :=
  Formula.iInf (fun f : FixT D F =>
    Relations.formula₂ (Rel.lt : lang.Relations 2) (Term.var (Sum.inr f))
      (Term.var (Sum.inl bd)))

/-- N4.4: "`D` is realizable below the coordinate `bd`", with the fixed variables read from
`FixT` and the distinguished variable `t` (if any) at the coordinate `tgt`. -/
noncomputable def realFml {V : Type} (D : Diagram V) (F : V → Prop) (t : Option V) {k : Nat}
    (tgt bd : Fin (k + 1)) : lang.Formula (Fin (k + 1) ⊕ FixT D F) :=
  fixBelowFml D F bd ⊓
    Formula.iExs (FreeT D F t)
      (Formula.iInf (fun r : FreeT D F t =>
          Relations.formula₂ (Rel.lt : lang.Relations 2) (Term.var (Sum.inr r))
            (Term.var (Sum.inl (Sum.inl bd)))) ⊓
        (diagramFml D).relabel (splitVar D F t tgt))

/-- N4.4: "`D` is realizable" in the whole structure (no explicit bound; used with bound `w`). -/
noncomputable def realTopFml {V : Type} (D : Diagram V) (F : V → Prop) :
    lang.Formula (Fin 1 ⊕ FixT D F) :=
  Formula.iExs (FreeT D F none) ((diagramFml D).relabel (splitVar D F none 0))

open Classical in
/-- N4.4: the fixed assignment read from a valuation of `FixT` (`0` off the fixed variables). -/
noncomputable def fixAsg {ν : Ordinal.{u}} {Q : Prims.{u}} {V : Type} (D : Diagram V)
    (F : V → Prop) (v : FixT D F → Carrier ν Q) (x : V) : Ordinal.{u} :=
  if h : x ∈ D.vars ∧ F x then (v ⟨x, h⟩).val else 0

/-- N4.4 (helper): `fixAsg` on a fixed variable of `D`. -/
theorem fixAsg_of_mem {ν : Ordinal.{u}} {Q : Prims.{u}} {V : Type} (D : Diagram V)
    (F : V → Prop) (v : FixT D F → Carrier ν Q) {x : V} (h : x ∈ D.vars ∧ F x) :
    fixAsg D F v x = (v ⟨x, h⟩).val := dif_pos h

/-- N4.4 (helper): `splitVar` on the distinguished variable. -/
theorem splitVar_tgt {V : Type} (D : Diagram V) (F : V → Prop) (t : Option V) {k : Nat}
    (tgt : Fin (k + 1)) {x : V} (h : some x = t) :
    splitVar D F t tgt x = Sum.inl (Sum.inl tgt) := if_pos h

/-- N4.4 (helper): `splitVar` on a fixed variable. -/
theorem splitVar_fix {V : Type} (D : Diagram V) (F : V → Prop) (t : Option V) {k : Nat}
    (tgt : Fin (k + 1)) {x : V} (ht : some x ≠ t) (h : x ∈ D.vars ∧ F x) :
    splitVar D F t tgt x = Sum.inl (Sum.inr ⟨x, h⟩) := by
  rw [splitVar, if_neg ht, dif_pos h]

/-- N4.4 (helper): `splitVar` on a free variable. -/
theorem splitVar_free {V : Type} (D : Diagram V) (F : V → Prop) (t : Option V) {k : Nat}
    (tgt : Fin (k + 1)) {x : V} (h : x ∈ D.vars ∧ ¬ F x ∧ some x ≠ t) :
    splitVar D F t tgt x = Sum.inr ⟨x, h⟩ := by
  rw [splitVar, if_neg h.2.2, dif_neg (fun h' => h.2.1 h'.2), dif_pos h]

/-- N4.4 (helper): `fixBelowFml` unfolded. -/
theorem realize_fixBelowFml {ν : Ordinal.{u}} {Q : Prims.{u}} {V : Type} (D : Diagram V)
    (F : V → Prop) {k : Nat} (bd : Fin (k + 1)) (c : Fin (k + 1) → Carrier ν Q)
    (v : FixT D F → Carrier ν Q) :
    (fixBelowFml D F bd).Realize (Sum.elim c v) ↔ ∀ f, (v f).val < (c bd).val := by
  rw [fixBelowFml, Formula.realize_iInf]
  rfl

/-- N4.4 (helper): `realFml` unfolded, before gluing the assignments. -/
theorem realize_realFml_iff {ν : Ordinal.{u}} {Q : Prims.{u}} {V : Type} (D : Diagram V)
    (F : V → Prop) (t : Option V) {k : Nat} (tgt bd : Fin (k + 1)) (c : Fin (k + 1) → Carrier ν Q)
    (v : FixT D F → Carrier ν Q) :
    (realFml D F t tgt bd).Realize (Sum.elim c v) ↔
      (∀ f, (v f).val < (c bd).val) ∧ ∃ i : FreeT D F t → Carrier ν Q,
        (∀ r, (i r).val < (c bd).val) ∧
          D.Holds Q (fun x => (Sum.elim (Sum.elim c v) i (splitVar D F t tgt x)).val) := by
  rw [realFml, Formula.realize_inf, realize_fixBelowFml, Formula.realize_iExs]
  simp only [Formula.realize_inf, Formula.realize_iInf, Formula.realize_relabel,
    realize_diagramFml, realize_lt_var, Sum.elim_inl, Sum.elim_inr, Function.comp_apply]

/-- N4.4: correctness of `realFml` (no distinguished variable). -/
theorem realize_realFml {ν : Ordinal.{u}} {Q : Prims.{u}} {V : Type} (D : Diagram V)
    (F : V → Prop) {k : Nat} (tgt bd : Fin (k + 1)) (c : Fin (k + 1) → Carrier ν Q)
    (v : FixT D F → Carrier ν Q) :
    (realFml D F none tgt bd).Realize (Sum.elim c v) ↔
      D.RealizableBelow Q F (fixAsg D F v) (c bd).val := by
  classical
  rw [realize_realFml_iff]
  constructor
  · rintro ⟨hfix, i, hi, hD⟩
    let g := Sum.elim (Sum.elim c v) i
    refine ⟨fun x => if F x then fixAsg D F v x else (g (splitVar D F none tgt x)).val,
      fun x hF => if_pos hF, fun x hx => ?_, ?_⟩
    · by_cases hF : F x
      · simp only [if_pos hF, fixAsg_of_mem D F v ⟨hx, hF⟩]
        exact hfix _
      · simp only [if_neg hF, g, splitVar_free D F none tgt ⟨hx, hF, by simp⟩]
        exact hi _
    · refine (Diagram.holds_congr Q D _ _ fun x hx => ?_).1 hD
      by_cases hF : F x
      · simp only [if_pos hF, g, splitVar_fix D F none tgt (by simp) ⟨hx, hF⟩,
          fixAsg_of_mem D F v ⟨hx, hF⟩]
        rfl
      · simp only [if_neg hF, g]
  · rintro ⟨a, ha₁, ha₂, ha₃⟩
    refine ⟨fun f => ?_, fun r => ⟨a r.1, (ha₂ r.1 r.2.1).trans (c bd).lt⟩,
      fun r => ha₂ r.1 r.2.1, ?_⟩
    · rw [show (v f).val = a f.1 from ((ha₁ f.1 f.2.2).trans (fixAsg_of_mem D F v f.2)).symm]
      exact ha₂ f.1 f.2.1
    · refine (Diagram.holds_congr Q D _ _ fun x hx => ?_).1 ha₃
      by_cases hF : F x
      · rw [splitVar_fix D F none tgt (by simp) ⟨hx, hF⟩, ha₁ x hF, fixAsg_of_mem D F v ⟨hx, hF⟩]
        rfl
      · rw [splitVar_free D F none tgt ⟨hx, hF, by simp⟩]
        rfl

-- V-U4-4
/-- N4.4: correctness of `realFml` with a distinguished variable `t ∉ F`, which is read at the
coordinate `tgt` and whose value lies below the bound `bd` (used by `realize_transFml`). -/
theorem realize_realFml_some {ν : Ordinal.{u}} {Q : Prims.{u}} {V : Type} [DecidableEq V]
    (D : Diagram V) (F : V → Prop) (t : V) (ht : ¬ F t) {k : Nat} (tgt bd : Fin (k + 1))
    (c : Fin (k + 1) → Carrier ν Q) (v : FixT D F → Carrier ν Q)
    (htb : (c tgt).val < (c bd).val) :
    (realFml D F (some t) tgt bd).Realize (Sum.elim c v) ↔
      D.RealizableBelow Q (fun x => F x ∨ x = t)
        (Function.update (fixAsg D F v) t (c tgt).val) (c bd).val := by
  classical
  have hne : ∀ {x : V}, x ≠ t → some x ≠ some t := fun h h' => h (Option.some_injective _ h')
  rw [realize_realFml_iff]
  constructor
  · rintro ⟨hfix, i, hi, hD⟩
    let g := Sum.elim (Sum.elim c v) i
    let σ' := Function.update (fixAsg D F v) t (c tgt).val
    have hg : ∀ x ∈ D.vars, (F x ∨ x = t) → (g (splitVar D F (some t) tgt x)).val = σ' x := by
      intro x hx hF
      by_cases hxt : x = t
      · subst hxt
        rw [splitVar_tgt D F _ tgt rfl]
        simp only [σ', Function.update_self]
        rfl
      · have hF' : F x := hF.resolve_right hxt
        rw [splitVar_fix D F _ tgt (hne hxt) ⟨hx, hF'⟩]
        simp only [σ', Function.update_of_ne hxt, fixAsg_of_mem D F v ⟨hx, hF'⟩]
        rfl
    refine ⟨fun x => if F x ∨ x = t then σ' x else (g (splitVar D F (some t) tgt x)).val,
      fun x hF => if_pos hF, fun x hx => ?_, ?_⟩
    · by_cases hF : F x ∨ x = t
      · simp only [if_pos hF]
        rw [← hg x hx hF]
        by_cases hxt : x = t
        · subst hxt
          rw [splitVar_tgt D F _ tgt rfl]
          exact htb
        · rw [splitVar_fix D F _ tgt (hne hxt) ⟨hx, hF.resolve_right hxt⟩]
          exact hfix _
      · simp only [if_neg hF]
        rw [splitVar_free D F _ tgt ⟨hx, fun h => hF (Or.inl h), hne fun h => hF (Or.inr h)⟩]
        exact hi _
    · refine (Diagram.holds_congr Q D _ _ fun x hx => ?_).1 hD
      by_cases hF : F x ∨ x = t
      · simp only [if_pos hF]
        exact hg x hx hF
      · simp only [if_neg hF]
        rfl
  · rintro ⟨a, ha₁, ha₂, ha₃⟩
    refine ⟨fun f => ?_, fun r => ⟨a r.1, (ha₂ r.1 r.2.1).trans (c bd).lt⟩,
      fun r => ha₂ r.1 r.2.1, ?_⟩
    · have hft : f.1 ≠ t := fun h => ht (h ▸ f.2.2)
      have h₁ := ha₁ f.1 (Or.inl f.2.2)
      rw [Function.update_of_ne hft, fixAsg_of_mem D F v f.2] at h₁
      rw [show (v f).val = a f.1 from h₁.symm]
      exact ha₂ f.1 f.2.1
    · refine (Diagram.holds_congr Q D _ _ fun x hx => ?_).1 ha₃
      by_cases hxt : x = t
      · subst hxt
        rw [splitVar_tgt D F _ tgt rfl, ha₁ x (Or.inr rfl), Function.update_self]
        rfl
      · by_cases hF : F x
        · rw [splitVar_fix D F _ tgt (hne hxt) ⟨hx, hF⟩, ha₁ x (Or.inl hF),
            Function.update_of_ne hxt, fixAsg_of_mem D F v ⟨hx, hF⟩]
          rfl
        · rw [splitVar_free D F _ tgt ⟨hx, hF, hne hxt⟩]
          rfl

/-- N4.4: correctness of `realTopFml`: realizable below the height `ν` of the structure. -/
theorem realize_realTopFml {ν : Ordinal.{u}} {Q : Prims.{u}} {V : Type} (D : Diagram V)
    (F : V → Prop) (c : Fin 1 → Carrier ν Q) (v : FixT D F → Carrier ν Q) :
    (realTopFml D F).Realize (Sum.elim c v) ↔ D.RealizableBelow Q F (fixAsg D F v) ν := by
  classical
  rw [realTopFml, Formula.realize_iExs]
  simp only [Formula.realize_relabel, realize_diagramFml, Function.comp_apply]
  constructor
  · rintro ⟨i, hD⟩
    let g := Sum.elim (Sum.elim c v) i
    refine ⟨fun x => if F x then fixAsg D F v x else (g (splitVar D F none 0 x)).val,
      fun x hF => if_pos hF, fun x hx => ?_, ?_⟩
    · by_cases hF : F x
      · simp only [if_pos hF, fixAsg_of_mem D F v ⟨hx, hF⟩]
        exact (v _).lt
      · simp only [if_neg hF]
        exact (g _).lt
    · refine (Diagram.holds_congr Q D _ _ fun x hx => ?_).1 hD
      by_cases hF : F x
      · simp only [if_pos hF, g, splitVar_fix D F none 0 (by simp) ⟨hx, hF⟩,
          fixAsg_of_mem D F v ⟨hx, hF⟩]
        rfl
      · simp only [if_neg hF, g]
  · rintro ⟨a, ha₁, ha₂, ha₃⟩
    refine ⟨fun r => ⟨a r.1, ha₂ r.1 r.2.1⟩, ?_⟩
    refine (Diagram.holds_congr Q D _ _ fun x hx => ?_).1 ha₃
    by_cases hF : F x
    · rw [splitVar_fix D F none 0 (by simp) ⟨hx, hF⟩, ha₁ x hF, fixAsg_of_mem D F v ⟨hx, hF⟩]
      rfl
    · rw [splitVar_free D F none 0 ⟨hx, hF, by simp⟩]
      rfl

/-- N4.4: `θ_{D,F}(a, b)` (coordinates `0 = a`, `1 = b`): fixed values below `a` and a
realization below `b` give a realization below `a`. -/
noncomputable def reflFml {V : Type} (D : Diagram V) (F : V → Prop) : lang.Formula (Fin 2) :=
  Formula.iAlls (FixT D F)
    (fixBelowFml D F 0 ⟹ (realFml D F none 0 1 ⟹ realFml D F none 0 0))

/-- N4.4: `τ_{D,F,t}(c, b, a)` (coordinates `0 = c`, `1 = b`, `2 = a`): fixed values below `a`
and a realization below `c` with `t ↦ b` give a realization below `b` with `t ↦ a`. -/
noncomputable def transFml {V : Type} (D : Diagram V) (F : V → Prop) (t : V) :
    lang.Formula (Fin 3) :=
  Formula.iAlls (FixT D F)
    (fixBelowFml D F 2 ⟹ (realFml D F (some t) 1 0 ⟹ realFml D F (some t) 2 1))

/-- N4.4: the reflection property of one diagram. -/
def ReflectsD (Q : Prims.{u}) {V : Type} (D : Diagram V) (F : V → Prop) (a b : Ordinal.{u}) :
    Prop :=
  ∀ σ : V → Ordinal.{u}, (∀ x ∈ D.vars, F x → σ x < a) →
    D.RealizableBelow Q F σ b → D.RealizableBelow Q F σ a

/-- N4.4: the transport property of one diagram and distinguished variable. -/
def TransportsD (Q : Prims.{u}) {V : Type} [DecidableEq V] (D : Diagram V) (F : V → Prop)
    (t : V) (c b a : Ordinal.{u}) : Prop :=
  ¬ F t → ∀ σ : V → Ordinal.{u}, (∀ x ∈ D.vars, F x → σ x < a) →
    D.RealizableBelow Q (fun x => F x ∨ x = t) (Function.update σ t b) c →
    D.RealizableBelow Q (fun x => F x ∨ x = t) (Function.update σ t a) b

/-- N4.4: `θ` expresses `ReflectsD` (for `a ≤ b`). -/
theorem realize_reflFml {ν : Ordinal.{u}} {Q : Prims.{u}} {V : Type} (D : Diagram V)
    (F : V → Prop) (a b : Carrier ν Q) (hab : a.val ≤ b.val) :
    (reflFml D F).Realize ![a, b] ↔ ReflectsD Q D F a.val b.val := by
  -- the hypothesis `a ≤ b` is not needed: both `realFml` conjuncts carry their own bounds
  have _ := hab
  rw [reflFml, Formula.realize_iAlls]
  constructor
  · intro h σ hσ hr
    let i : FixT D F → Carrier ν Q := fun f => ⟨σ f.1, (hσ f.1 f.2.1 f.2.2).trans a.lt⟩
    have hi : ∀ x ∈ D.vars, F x → fixAsg D F i x = σ x :=
      fun x hx hF => fixAsg_of_mem D F i ⟨hx, hF⟩
    have h' := h i
    rw [Formula.realize_imp, Formula.realize_imp, realize_fixBelowFml, realize_realFml,
      realize_realFml] at h'
    exact (Diagram.realizableBelow_congr_fixed Q D F _ _ _ hi).1
      (h' (fun f => hσ f.1 f.2.1 f.2.2) ((Diagram.realizableBelow_congr_fixed Q D F _ _ _ hi).2 hr))
  · intro h i
    rw [Formula.realize_imp, Formula.realize_imp, realize_fixBelowFml, realize_realFml,
      realize_realFml]
    intro hfix hr
    exact h (fixAsg D F i) (fun x hx hF => by rw [fixAsg_of_mem D F i ⟨hx, hF⟩]; exact hfix _) hr

/-- N4.4: `τ` expresses `TransportsD` (for `t ∉ F` and `a < b < c`; for `t ∈ F` the property
`TransportsD` is vacuous and is not needed). -/
theorem realize_transFml {ν : Ordinal.{u}} {Q : Prims.{u}} {V : Type} [DecidableEq V]
    (D : Diagram V) (F : V → Prop) (t : V) (ht : ¬ F t) (c b a : Carrier ν Q)
    (hab : a.val < b.val) (hbc : b.val < c.val) :
    (transFml D F t).Realize ![c, b, a] ↔ TransportsD Q D F t c.val b.val a.val := by
  rw [transFml, Formula.realize_iAlls]
  constructor
  · intro h _ σ hσ hr
    let i : FixT D F → Carrier ν Q := fun f => ⟨σ f.1, (hσ f.1 f.2.1 f.2.2).trans a.lt⟩
    have hi : ∀ s : Ordinal.{u}, ∀ x ∈ D.vars, (F x ∨ x = t) →
        Function.update (fixAsg D F i) t s x = Function.update σ t s x := by
      intro s x hx hF
      by_cases hxt : x = t
      · subst hxt
        rw [Function.update_self, Function.update_self]
      · rw [Function.update_of_ne hxt, Function.update_of_ne hxt]
        exact fixAsg_of_mem D F i ⟨hx, hF.resolve_right hxt⟩
    have h' := h i
    rw [Formula.realize_imp, Formula.realize_imp, realize_fixBelowFml,
      realize_realFml_some D F t ht 1 0 _ _ hbc, realize_realFml_some D F t ht 2 1 _ _ hab] at h'
    exact (Diagram.realizableBelow_congr_fixed Q D _ _ _ _ (hi a.val)).1
      (h' (fun f => hσ f.1 f.2.1 f.2.2)
        ((Diagram.realizableBelow_congr_fixed Q D _ _ _ _ (hi b.val)).2 hr))
  · intro h i
    rw [Formula.realize_imp, Formula.realize_imp, realize_fixBelowFml,
      realize_realFml_some D F t ht 1 0 _ _ hbc, realize_realFml_some D F t ht 2 1 _ _ hab]
    intro hfix hr
    exact h ht (fixAsg D F i)
      (fun x hx hF => by rw [fixAsg_of_mem D F i ⟨hx, hF⟩]; exact hfix _) hr

/-! ## N4.5: the recursive definition of `Elem` and `Edge` -/

/-- N4.5: all diagrams reflect from below `b` to below `a`. -/
def Reflects (Q : Prims.{u}) (a b : Ordinal.{u}) : Prop :=
  ∀ {V : Type} (D : Diagram V) (F : V → Prop), ReflectsD Q D F a b

/-- N4.5: all diagrams transport along `(c, b, a)`; this is the shape of the `transport`
field of `Interface`. -/
def Transports (Q : Prims.{u}) (c b a : Ordinal.{u}) : Prop :=
  ∀ {V : Type} [DecidableEq V] (D : Diagram V) (F : V → Prop) (σ : V → Ordinal.{u}) (t : V),
    ¬ F t → (∀ x ∈ D.vars, F x → σ x < a) →
    D.RealizableBelow Q (fun x => F x ∨ x = t) (Function.update σ t b) c →
    D.RealizableBelow Q (fun x => F x ∨ x = t) (Function.update σ t a) b

/-- N4.5: the data of one level `z`: `Elem (·) z` and `Edge z (·) (·)`. -/
abbrev LevData : Type (u + 1) := (Ordinal.{u} → Prop) × (Ordinal.{u} → Ordinal.{u} → Prop)

/-- N4.5: the primitives below `z`, read from the levels below `z`. -/
def below {z : Ordinal.{u}} (lv : ∀ y : Ordinal.{u}, y < z → LevData.{u}) : Prims.{u} where
  Elem x y := ∃ h : y < z, (lv y h).1 x
  Edge c b a := ∃ h : c < z, (lv c h).2 b a

/-- N4.5: one level, from the primitives below it. -/
def step (z : Ordinal.{u}) (Q : Prims.{u}) : LevData.{u} :=
  (fun a => IsLim a ∧ IsLim z ∧ a ≤ z ∧ Reflects Q a z,
   fun b a => IsLim a ∧ IsLim b ∧ IsLim z ∧ a < b ∧ b < z ∧ Q.Elem a b ∧
     (IsLim b ∧ IsLim z ∧ b ≤ z ∧ Reflects Q b z) ∧ Transports Q z b a)

/-- N4.5: the levels, by well-founded recursion on the top coordinate. -/
noncomputable def lev : Ordinal.{u} → LevData.{u} :=
  Ordinal.lt_wf.fix (fun z IH => step z (below IH))

/-- N4.5: the primitives of the reflection hierarchy. -/
noncomputable def prims : Prims.{u} := ⟨fun a b => (lev b).1 a, fun c b a => (lev c).2 b a⟩

/-- N4.5 (helper): the unfolding equation of `lev`. -/
theorem lev_eq (z : Ordinal.{u}) : lev z = step z (below (fun y (_ : y < z) => lev y)) :=
  Ordinal.lt_wf.fix_eq _ z

/-- N4.5 (helper): the primitives read from the levels below `z` agree with `prims` below `z`. -/
theorem agreeBelow_below (z : Ordinal.{u}) :
    AgreeBelow (below (fun y (_ : y < z) => lev y)) prims z :=
  ⟨fun _ _ _ hy => ⟨fun ⟨_, h⟩ => h, fun h => ⟨hy, h⟩⟩,
    fun _ _ _ hc _ _ => ⟨fun ⟨_, h⟩ => h, fun h => ⟨hc, h⟩⟩⟩

/-- N4.5 (helper): `Reflects` only reads the primitives below its upper bound. -/
theorem reflects_congr_below {Q Q' : Prims.{u}} {z a b : Ordinal.{u}} (hQ : AgreeBelow Q Q' z)
    (ha : a ≤ z) (hb : b ≤ z) : Reflects Q a b ↔ Reflects Q' a b := by
  constructor
  · intro h V D F σ hσ hr
    exact (Diagram.realizableBelow_congr_below hQ ha D F σ).1
      (h D F σ hσ ((Diagram.realizableBelow_congr_below hQ hb D F σ).2 hr))
  · intro h V D F σ hσ hr
    exact (Diagram.realizableBelow_congr_below hQ ha D F σ).2
      (h D F σ hσ ((Diagram.realizableBelow_congr_below hQ hb D F σ).1 hr))

/-- N4.5 (helper): `Transports` only reads the primitives below its upper bound. -/
theorem transports_congr_below {Q Q' : Prims.{u}} {z c b a : Ordinal.{u}}
    (hQ : AgreeBelow Q Q' z) (hb : b ≤ z) (hc : c ≤ z) :
    Transports Q c b a ↔ Transports Q' c b a := by
  constructor
  · intro h V _ D F σ t ht hσ hr
    exact (Diagram.realizableBelow_congr_below hQ hb D _ _).1
      (h D F σ t ht hσ ((Diagram.realizableBelow_congr_below hQ hc D _ _).2 hr))
  · intro h V _ D F σ t ht hσ hr
    exact (Diagram.realizableBelow_congr_below hQ hb D _ _).2
      (h D F σ t ht hσ ((Diagram.realizableBelow_congr_below hQ hc D _ _).1 hr))

/-- N4.5: unfolding `Elem`. -/
theorem elem_iff {a b : Ordinal.{u}} :
    prims.Elem a b ↔ IsLim a ∧ IsLim b ∧ a ≤ b ∧ Reflects prims a b := by
  show (lev b).1 a ↔ _
  rw [lev_eq b]
  show IsLim a ∧ IsLim b ∧ a ≤ b ∧ Reflects (below fun y (_ : y < b) => lev y) a b ↔ _
  constructor
  · rintro ⟨h₁, h₂, h₃, h₄⟩
    exact ⟨h₁, h₂, h₃, (reflects_congr_below (agreeBelow_below b) h₃ le_rfl).1 h₄⟩
  · rintro ⟨h₁, h₂, h₃, h₄⟩
    exact ⟨h₁, h₂, h₃, (reflects_congr_below (agreeBelow_below b) h₃ le_rfl).2 h₄⟩

/-- N4.5: unfolding `Edge`. -/
theorem edge_iff {c b a : Ordinal.{u}} :
    prims.Edge c b a ↔ IsLim a ∧ IsLim b ∧ IsLim c ∧ a < b ∧ b < c ∧ prims.Elem a b ∧
      prims.Elem b c ∧ Transports prims c b a := by
  have hE : prims.Elem b c ↔
      IsLim b ∧ IsLim c ∧ b ≤ c ∧ Reflects (below fun y (_ : y < c) => lev y) b c := by
    show (lev c).1 b ↔ _
    rw [lev_eq c]
    rfl
  show (lev c).2 b a ↔ _
  rw [lev_eq c]
  show (IsLim a ∧ IsLim b ∧ IsLim c ∧ a < b ∧ b < c ∧
      (below fun y (_ : y < c) => lev y).Elem a b ∧
      (IsLim b ∧ IsLim c ∧ b ≤ c ∧ Reflects (below fun y (_ : y < c) => lev y) b c) ∧
      Transports (below fun y (_ : y < c) => lev y) c b a) ↔ _
  constructor
  · rintro ⟨h₁, h₂, h₃, h₄, h₅, ⟨_, h₆⟩, h₇, h₈⟩
    exact ⟨h₁, h₂, h₃, h₄, h₅, h₆, hE.2 h₇,
      (transports_congr_below (agreeBelow_below c) h₅.le le_rfl).1 h₈⟩
  · rintro ⟨h₁, h₂, h₃, h₄, h₅, h₆, h₇, h₈⟩
    exact ⟨h₁, h₂, h₃, h₄, h₅, ⟨h₅, h₆⟩, hE.1 h₇,
      (transports_congr_below (agreeBelow_below c) h₅.le le_rfl).2 h₈⟩

/-! ## N4.6: the structural laws -/

/-- N4.6: field `elem_le`. -/
theorem elem_le {a b : Ordinal.{u}} (h : prims.Elem a b) : a ≤ b := (elem_iff.1 h).2.2.1
/-- N4.6: field `elem_lim`. -/
theorem elem_lim {a b : Ordinal.{u}} (h : prims.Elem a b) : IsLim a ∧ IsLim b :=
  ⟨(elem_iff.1 h).1, (elem_iff.1 h).2.1⟩
/-- N4.6: field `elem_refl`. -/
theorem elem_refl {a : Ordinal.{u}} (h : IsLim a) : prims.Elem a a :=
  elem_iff.2 ⟨h, h, le_rfl, fun _ _ _ _ hr => hr⟩
/-- N4.6: field `elem_trans`. -/
theorem elem_trans {a b c : Ordinal.{u}} (h₁ : prims.Elem a b) (h₂ : prims.Elem b c) :
    prims.Elem a c := by
  obtain ⟨ha, -, hab, r₁⟩ := elem_iff.1 h₁
  obtain ⟨-, hc, hbc, r₂⟩ := elem_iff.1 h₂
  exact elem_iff.2 ⟨ha, hc, hab.trans hbc, fun D F σ hσ hr =>
    r₁ D F σ hσ (r₂ D F σ (fun x hx hF => (hσ x hx hF).trans_le hab) hr)⟩
/-- N4.6: field `elem_mid`. -/
theorem elem_mid {a b c : Ordinal.{u}} (h : prims.Elem a c) (hab : a ≤ b) (hbc : b ≤ c)
    (hb : IsLim b) : prims.Elem a b := by
  obtain ⟨ha, -, -, r⟩ := elem_iff.1 h
  refine elem_iff.2 ⟨ha, hb, hab, fun D F σ hσ hr => r D F σ hσ ?_⟩
  obtain ⟨β, h₁, h₂, h₃⟩ := hr
  exact ⟨β, h₁, fun x hx => (h₂ x hx).trans_le hbc, h₃⟩
/-- N4.6: field `edge_lt`. -/
theorem edge_lt {c b a : Ordinal.{u}} (h : prims.Edge c b a) : a < b ∧ b < c :=
  ⟨(edge_iff.1 h).2.2.2.1, (edge_iff.1 h).2.2.2.2.1⟩
/-- N4.6: field `edge_lim`. -/
theorem edge_lim {c b a : Ordinal.{u}} (h : prims.Edge c b a) : IsLim a ∧ IsLim b ∧ IsLim c :=
  ⟨(edge_iff.1 h).1, (edge_iff.1 h).2.1, (edge_iff.1 h).2.2.1⟩
/-- N4.6: field `edge_elem_low`. -/
theorem edge_elem_low {c b a : Ordinal.{u}} (h : prims.Edge c b a) : prims.Elem a b :=
  (edge_iff.1 h).2.2.2.2.2.1
/-- N4.6: field `edge_elem_high`. -/
theorem edge_elem_high {c b a : Ordinal.{u}} (h : prims.Edge c b a) : prims.Elem b c :=
  (edge_iff.1 h).2.2.2.2.2.2.1
/-- N4.6: field `edge_restrict`. -/
theorem edge_restrict {c b a d : Ordinal.{u}} (h : prims.Edge c b a) (hd : IsLim d) (hbd : b < d)
    (hdc : d ≤ c) : prims.Edge d b a := by
  obtain ⟨ha, hb, -, hab, -, e₁, e₂, tr⟩ := edge_iff.1 h
  refine edge_iff.2 ⟨ha, hb, hd, hab, hbd, e₁, elem_mid e₂ hbd.le hdc hd, ?_⟩
  intro V _ D F σ t ht hσ hr
  refine tr D F σ t ht hσ ?_
  obtain ⟨β, h₁, h₂, h₃⟩ := hr
  exact ⟨β, h₁, fun x hx => (h₂ x hx).trans_le hdc, h₃⟩
/-- N4.6: field `edge_extend`. -/
theorem edge_extend {c b a d : Ordinal.{u}} (h : prims.Edge c b a) (hcd : prims.Elem c d) :
    prims.Edge d b a := by
  obtain ⟨ha, hb, -, hab, hbc, e₁, e₂, tr⟩ := edge_iff.1 h
  obtain ⟨-, hd, hcd', r⟩ := elem_iff.1 hcd
  refine edge_iff.2 ⟨ha, hb, hd, hab, hbc.trans_le hcd', e₁, elem_trans e₂ hcd, ?_⟩
  intro V _ D F σ t ht hσ hr
  refine tr D F σ t ht hσ (r D _ _ ?_ hr)
  intro x _ hF
  by_cases hxt : x = t
  · subst hxt
    rw [Function.update_self]
    exact hbc
  · rw [Function.update_of_ne hxt]
    rcases hF with hF | hF
    · exact (hσ x ‹_› hF).trans (hab.trans hbc)
    · exact absurd hF hxt
/-- N4.6: field `capture` (by definition of `Elem`). -/
theorem capture {V : Type} (D : Diagram V) (F : V → Prop) (σ : V → Ordinal.{u})
    {a b : Ordinal.{u}} (hab : prims.Elem a b) (hσ : ∀ x ∈ D.vars, F x → σ x < a) :
    D.RealizableBelow prims F σ b → D.RealizableBelow prims F σ a :=
  (elem_iff.1 hab).2.2.2 D F σ hσ
/-- N4.6: field `transport` (by definition of `Edge`). -/
theorem transport {V : Type} [DecidableEq V] (D : Diagram V) (F : V → Prop)
    (σ : V → Ordinal.{u}) (t : V) {c b a : Ordinal.{u}} (h : prims.Edge c b a) (ht : ¬ F t)
    (hσ : ∀ x ∈ D.vars, F x → σ x < a) :
    D.RealizableBelow prims (fun x => F x ∨ x = t) (Function.update σ t b) c →
      D.RealizableBelow prims (fun x => F x ∨ x = t) (Function.update σ t a) b :=
  (edge_iff.1 h).2.2.2.2.2.2.2 D F σ t ht hσ

/-! ## N4.7: hulls in `M_w`, collapse and condensation -/

/-- N4.7: the ambient structure `M_w = M(w, prims)`. -/
abbrev M (w : Ordinal.{u}) : Type (u + 1) := Carrier w prims

/-- N4.7: the Skolem hull of `s` in `M_w`: the closure under Mathlib's Skolem functions, an
elementary substructure (`Substructure.elementarySkolem₁Reduct`). -/
noncomputable def hull (w : Ordinal.{u}) (hw : 0 < w) (s : Set (M w)) :
    lang.ElementarySubstructure (M w) :=
  haveI : Nonempty (M w) := ⟨⟨0, hw⟩⟩
  Substructure.elementarySkolem₁Reduct (Substructure.closure (lang.sum lang.skolem₁) s)

/-- N4.7 (helper): the carrier of the hull is the carrier of the Skolem closure. -/
theorem coe_hull (w : Ordinal.{u}) (hw : 0 < w) (s : Set (M w)) :
    (hull w hw s : Set (M w)) =
      (haveI : Nonempty (M w) := ⟨⟨0, hw⟩⟩
       (Substructure.closure (lang.sum lang.skolem₁) s : Set (M w))) := rfl

/-- N4.7: generators lie in the hull. -/
theorem subset_hull (w : Ordinal.{u}) (hw : 0 < w) (s : Set (M w)) :
    s ⊆ (hull w hw s : Set (M w)) := by
  haveI : Nonempty (M w) := ⟨⟨0, hw⟩⟩
  rw [coe_hull]
  exact Substructure.subset_closure

/-- N4.7: monotonicity. -/
theorem hull_mono (w : Ordinal.{u}) (hw : 0 < w) {s t : Set (M w)} (h : s ⊆ t) :
    (hull w hw s : Set (M w)) ⊆ hull w hw t := by
  haveI : Nonempty (M w) := ⟨⟨0, hw⟩⟩
  rw [coe_hull, coe_hull]
  exact Substructure.closure_mono h

/-- N4.7: continuity on directed unions. -/
theorem hull_iUnion (w : Ordinal.{u}) (hw : 0 < w) {ι : Type*} [Nonempty ι]
    {s : ι → Set (M w)} (hs : Directed (· ⊆ ·) s) :
    (hull w hw (⋃ i, s i) : Set (M w)) = ⋃ i, (hull w hw (s i) : Set (M w)) := by
  haveI : Nonempty (M w) := ⟨⟨0, hw⟩⟩
  simp only [coe_hull]
  rw [Substructure.closure_iUnion]
  ext x
  rw [SetLike.mem_coe, Substructure.mem_iSup_of_directed, Set.mem_iUnion]
  · rfl
  · exact hs.mono_comp _ (fun a b h => Substructure.closure_mono h)

/-- N4.7 (helper): each arity has countably many relation symbols. -/
instance (n : Nat) : Countable (Rel n) := by
  refine Function.Injective.countable (f := fun r : Rel n => match r with
    | .lt => (0 : Fin 3) | .elem => 1 | .edge => 2) ?_
  intro a b h
  cases a <;> cases b <;> first | rfl | (simp at h)

/-- N4.7 (helper): the language is countable. -/
theorem lang_card_le : lang.card ≤ ℵ₀ := by
  have : Countable lang.Symbols := by
    change Countable ((Σ l, Empty) ⊕ (Σ l, Rel l))
    infer_instance
  exact Cardinal.mk_le_aleph0

/-- N4.7: the size bound `|hull s| ≤ max(ℵ₀, |s|)`. -/
theorem card_hull_le (w : Ordinal.{u}) (hw : 0 < w) (s : Set (M w)) :
    Cardinal.mk (hull w hw s) ≤ max ℵ₀ (Cardinal.mk s) := by
  haveI : Nonempty (M w) := ⟨⟨0, hw⟩⟩
  have h1 := Substructure.lift_card_closure_le (L := lang.sum lang.skolem₁) (s := s)
  have h2 : #(Σ n, (lang.sum lang.skolem₁).Functions n) ≤ ℵ₀ :=
    card_functions_sum_skolem₁_le.trans (max_le le_rfl lang_card_le)
  change #(Substructure.closure (lang.sum lang.skolem₁) s) ≤ _
  simp only [Cardinal.lift_uzero] at h1
  refine h1.trans (max_le (le_max_left _ _) ?_)
  refine (Cardinal.add_le_max _ _).trans (max_le (max_le (le_max_right _ _) ?_) (le_max_left _ _))
  refine ((Cardinal.lift_le.2 h2).trans (by simp)).trans (le_max_left _ _)

-- Moved before `condensation`, which uses it (statement unchanged).
/-- N4.7: the collapse of a point is the order type of the substructure below it: if exactly
the ordinals below `x` lie (as points of `S`) below `k`, then `π k = x`. -/
theorem collapse_eq_of_cut {w ν : Ordinal.{u}} (S : lang.ElementarySubstructure (M w))
    (π : S ≃[lang] M ν)
    (hπ : ∀ x y : S, ((x : M w).val < (y : M w).val ↔ (π x).val < (π y).val)) (k : S)
    {x : Ordinal.{u}} (hcut : ∀ y : S, (y : M w).val < (k : M w).val ↔ (y : M w).val < x)
    (hfull : ∀ o < x, ∃ y : S, (y : M w).val = o) : (π k).val = x := by
  -- `π` is onto the ordinals below `ν`
  have hsurj : ∀ o (ho : o < ν), (π (π.symm ⟨o, ho⟩)).val = o := fun o ho => by
    rw [π.apply_symm_apply]
  -- points below `x` are fixed
  have key : ∀ o, ∀ y : S, (y : M w).val = o → o < x → (π y).val = o := by
    intro o
    induction o using WellFoundedLT.induction with
    | _ o IH =>
      intro y hy hox
      apply le_antisymm
      · by_contra hlt
        rw [not_le] at hlt
        set z := π.symm ⟨o, hlt.trans (π y).lt⟩
        have hz : (π z).val = o := hsurj _ _
        have hzy : (z : M w).val < o := hy ▸ (hπ z y).2 (by rw [hz]; exact hlt)
        have := IH _ hzy z rfl (hzy.trans hox)
        rw [hz] at this
        exact (lt_irrefl o) (this ▸ hzy)
      · refine le_of_forall_lt fun c hc => ?_
        obtain ⟨y', hy'⟩ := hfull c (hc.trans hox)
        rw [← IH c hc y' hy' (hc.trans hox)]
        exact (hπ y' y).1 (by rw [hy', hy]; exact hc)
  apply le_antisymm
  · by_contra hlt
    rw [not_le] at hlt
    set z := π.symm ⟨x, hlt.trans (π k).lt⟩
    have hz : (π z).val = x := hsurj _ _
    have hzx : (z : M w).val < x := (hcut z).1 ((hπ z k).2 (by rw [hz]; exact hlt))
    have := key _ z rfl hzx
    rw [hz] at this
    exact (lt_irrefl x) (this ▸ hzx)
  · refine le_of_forall_lt fun c hc => ?_
    obtain ⟨y, hy⟩ := hfull c hc
    rw [← key c y hy hc]
    exact (hπ y k).1 ((hcut y).2 (hy ▸ hc))

/-- N4.7 (helper): formulas transfer from `M_w` to an elementary substructure `S` and then
along an isomorphism of `S` (`ElementaryEmbedding.map_formula`,
`StrongHomClass.realize_formula`). -/
theorem realize_elemIso {w ν : Ordinal.{u}} (S : lang.ElementarySubstructure (M w))
    {Q : Prims.{u}} (π : S ≃[lang] Carrier ν Q) {α : Type*} (φ : lang.Formula α)
    (v : α → S) : φ.Realize (((↑) : S → M w) ∘ v) ↔ φ.Realize (π ∘ v) :=
  (S.subtype.map_formula φ v).trans (StrongHomClass.realize_formula π φ).symm

/-- N4.7 (helper): `ReflectsD` only reads the primitives below `z` when `a, b ≤ z`. -/
theorem reflectsD_congr {Q Q' : Prims.{u}} {z : Ordinal.{u}} (hQ : AgreeBelow Q Q' z) {V : Type}
    (D : Diagram V) (F : V → Prop) {a b : Ordinal.{u}} (ha : a ≤ z) (hb : b ≤ z) :
    ReflectsD Q D F a b ↔ ReflectsD Q' D F a b := by
  unfold ReflectsD
  simp only [Diagram.realizableBelow_congr_below hQ ha, Diagram.realizableBelow_congr_below hQ hb]

/-- N4.7 (helper): `TransportsD` only reads the primitives below `z` when `b, c ≤ z`. -/
theorem transportsD_congr {Q Q' : Prims.{u}} {z : Ordinal.{u}} (hQ : AgreeBelow Q Q' z)
    {V : Type} [DecidableEq V] (D : Diagram V) (F : V → Prop) (t : V) {c b a : Ordinal.{u}}
    (hc : c ≤ z) (hb : b ≤ z) :
    TransportsD Q D F t c b a ↔ TransportsD Q' D F t c b a := by
  unfold TransportsD
  simp only [Diagram.realizableBelow_congr_below hQ hc, Diagram.realizableBelow_congr_below hQ hb]

/-- N4.7 (helper): `Transports` is the conjunction of the `TransportsD`. -/
theorem transports_iff (Q : Prims.{u}) (c b a : Ordinal.{u}) :
    Transports Q c b a ↔ ∀ {V : Type} [DecidableEq V] (D : Diagram V) (F : V → Prop) (t : V),
      TransportsD Q D F t c b a :=
  ⟨fun h _ _ D F t ht σ hσ hr => h D F σ t ht hσ hr,
   fun h _ _ D F σ t ht hσ hr => h D F t ht σ hσ hr⟩

/-- N4.7 (helper): an order collapse of the points of `S` onto the ordinals below `ν`. -/
structure Collapse {w : Ordinal.{u}} (S : lang.ElementarySubstructure (M w))
    (ν : Ordinal.{u}) where
  f : S → Ordinal.{u}
  lt_top : ∀ x, f x < ν
  lt_iff : ∀ x y : S, (x : M w).val < (y : M w).val ↔ f x < f y
  surj : ∀ o < ν, ∃ x, f x = o

namespace Collapse

variable {w ν : Ordinal.{u}} {S : lang.ElementarySubstructure (M w)} (C : Collapse S ν)

/-- N4.7 (helper): the collapse preserves `≤`. -/
theorem le_iff (x y : S) : (x : M w).val ≤ (y : M w).val ↔ C.f x ≤ C.f y := by
  rw [← not_lt, ← not_lt, C.lt_iff]

/-- N4.7 (helper): the collapse is injective. -/
theorem injective : Function.Injective C.f := fun x y h =>
  Subtype.ext (Carrier.ext (le_antisymm ((C.le_iff x y).2 h.le) ((C.le_iff y x).2 h.ge)))

/-- N4.7 (helper): the underlying bijection onto `Carrier ν Q`. -/
noncomputable def equiv (Q : Prims.{u}) : S ≃ Carrier ν Q :=
  Equiv.ofBijective (fun x => ⟨C.f x, C.lt_top x⟩)
    ⟨fun _ _ h => C.injective (congrArg Carrier.val h),
     fun z => let ⟨x, hx⟩ := C.surj z.val z.lt; ⟨x, Carrier.ext hx⟩⟩

/-- N4.7 (helper): the primitives pushed forward along the collapse. -/
def pushQ : Prims.{u} where
  Elem x' y' := ∃ x y : S, C.f x = x' ∧ C.f y = y' ∧ prims.Elem (x : M w).val (y : M w).val
  Edge c' b' a' := ∃ c b a : S, C.f c = c' ∧ C.f b = b' ∧ C.f a = a' ∧
    prims.Edge (c : M w).val (b : M w).val (a : M w).val

/-- N4.7 (helper): the pushed-forward `Elem` on collapsed points. -/
theorem pushQ_elem (x y : S) :
    C.pushQ.Elem (C.f x) (C.f y) ↔ prims.Elem (x : M w).val (y : M w).val :=
  ⟨fun ⟨_, _, hx, hy, h⟩ => C.injective hx ▸ C.injective hy ▸ h,
   fun h => ⟨x, y, rfl, rfl, h⟩⟩

/-- N4.7 (helper): the pushed-forward `Edge` on collapsed points. -/
theorem pushQ_edge (c b a : S) :
    C.pushQ.Edge (C.f c) (C.f b) (C.f a) ↔
      prims.Edge (c : M w).val (b : M w).val (a : M w).val :=
  ⟨fun ⟨_, _, _, hc, hb, ha, h⟩ => C.injective hc ▸ C.injective hb ▸ C.injective ha ▸ h,
   fun h => ⟨c, b, a, rfl, rfl, rfl, h⟩⟩

/-- N4.7 (helper): the collapse as an isomorphism onto `Carrier ν pushQ`. -/
noncomputable def pushEquiv : S ≃[lang] Carrier ν C.pushQ :=
  { C.equiv C.pushQ with
    map_fun' := fun {_} g => Empty.elim g
    map_rel' := by
      intro n r xs
      cases r
      · exact (C.lt_iff (xs 0) (xs 1)).symm
      · exact C.pushQ_elem (xs 0) (xs 1)
      · exact C.pushQ_edge (xs 0) (xs 1) (xs 2) }

/-- N4.7 (helper): the collapse map on values. -/
theorem pushEquiv_val (x : S) : (C.pushEquiv x).val = C.f x := rfl

/-- N4.7 (helper): formulas transfer from `M_w` along the collapse. -/
theorem realize_push {α : Type*} (φ : lang.Formula α) (v : α → S) :
    φ.Realize (((↑) : S → M w) ∘ v) ↔ φ.Realize (C.pushEquiv ∘ v) :=
  realize_elemIso S C.pushEquiv φ v

/-- N4.7 (helper): `realize_push` at a pair. -/
theorem realize_push2 (φ : lang.Formula (Fin 2)) (x y : S) :
    φ.Realize ![(x : M w), (y : M w)] ↔ φ.Realize ![C.pushEquiv x, C.pushEquiv y] := by
  have h := C.realize_push φ ![x, y]
  have e1 : (((↑) : S → M w) ∘ ![x, y]) = ![(x : M w), (y : M w)] := by
    funext i; match i with | 0 => rfl | 1 => rfl
  have e2 : (C.pushEquiv ∘ ![x, y]) = ![C.pushEquiv x, C.pushEquiv y] := by
    funext i; match i with | 0 => rfl | 1 => rfl
  rwa [e1, e2] at h

/-- N4.7 (helper): `realize_push` at a triple. -/
theorem realize_push3 (φ : lang.Formula (Fin 3)) (x y z : S) :
    φ.Realize ![(x : M w), (y : M w), (z : M w)] ↔
      φ.Realize ![C.pushEquiv x, C.pushEquiv y, C.pushEquiv z] := by
  have h := C.realize_push φ ![x, y, z]
  have e1 : (((↑) : S → M w) ∘ ![x, y, z]) = ![(x : M w), (y : M w), (z : M w)] := by
    funext i; match i with | 0 => rfl | 1 => rfl | 2 => rfl
  have e2 : (C.pushEquiv ∘ ![x, y, z]) = ![C.pushEquiv x, C.pushEquiv y, C.pushEquiv z] := by
    funext i; match i with | 0 => rfl | 1 => rfl | 2 => rfl
  rwa [e1, e2] at h

/-- N4.7 (helper): the collapse preserves `IsLim` (`limFml` and elementarity). -/
theorem isLim_iff (x : S) : IsLim (x : M w).val ↔ IsLim (C.f x) :=
  (realize_limFml (x : M w)).symm.trans
    ((C.realize_push limFml (fun _ => x)).trans (realize_limFml (C.pushEquiv x)))

/-- N4.7 (helper): the induction statement (step 4): the collapse preserves `Elem` and `Edge`
at top coordinate `o`. -/
def Good (o : Ordinal.{u}) : Prop :=
  (∀ x y : S, C.f y = o →
    (prims.Elem (x : M w).val (y : M w).val ↔ prims.Elem (C.f x) (C.f y))) ∧
  (∀ c b a : S, C.f c = o →
    (prims.Edge (c : M w).val (b : M w).val (a : M w).val ↔
      prims.Edge (C.f c) (C.f b) (C.f a)))

/-- N4.7 (helper, step 4a): below a collapsed top coordinate, the pushed-forward primitives
are the true ones. -/
theorem agreeBelow (o : Ordinal.{u}) (ho : o ≤ ν) (IH : ∀ o' < o, C.Good o') :
    AgreeBelow C.pushQ prims o := by
  refine ⟨fun x' y' hx' hy' => ?_, fun c' b' a' hc' hb' ha' => ?_⟩
  · obtain ⟨x, rfl⟩ := C.surj x' (hx'.trans_le ho)
    obtain ⟨y, rfl⟩ := C.surj y' (hy'.trans_le ho)
    rw [C.pushQ_elem]
    exact (IH _ hy').1 x y rfl
  · obtain ⟨c, rfl⟩ := C.surj c' (hc'.trans_le ho)
    obtain ⟨b, rfl⟩ := C.surj b' (hb'.trans_le ho)
    obtain ⟨a, rfl⟩ := C.surj a' (ha'.trans_le ho)
    rw [C.pushQ_edge]
    exact (IH _ hc').2 c b a rfl

/-- N4.7 (helper, step 4b): `Elem` at the collapsed top coordinate `o`. -/
theorem good_elem (o : Ordinal.{u}) (IH : ∀ o' < o, C.Good o') (x y : S) (hy : C.f y = o) :
    prims.Elem (x : M w).val (y : M w).val ↔ prims.Elem (C.f x) (C.f y) := by
  have hQ := C.agreeBelow o (hy ▸ (C.lt_top y).le) IH
  rw [elem_iff, elem_iff, C.isLim_iff x, C.isLim_iff y, C.le_iff x y]
  refine and_congr_right fun _ => and_congr_right fun _ => and_congr_right fun hxy => ?_
  have key : ∀ {V : Type} (D : Diagram V) (F : V → Prop),
      ReflectsD prims D F (x : M w).val (y : M w).val ↔ ReflectsD prims D F (C.f x) (C.f y) := by
    intro V D F
    rw [← realize_reflFml D F (x : M w) (y : M w) ((C.le_iff x y).2 hxy), C.realize_push2,
      realize_reflFml D F (C.pushEquiv x) (C.pushEquiv y) hxy]
    exact reflectsD_congr hQ D F (hxy.trans_eq hy) hy.le
  exact ⟨fun h V D F => (key D F).1 (h D F), fun h V D F => (key D F).2 (h D F)⟩

/-- N4.7 (helper, step 4c): `Edge` at the collapsed top coordinate `o`. -/
theorem good_edge (o : Ordinal.{u}) (IH : ∀ o' < o, C.Good o') (c b a : S) (hc : C.f c = o) :
    prims.Edge (c : M w).val (b : M w).val (a : M w).val ↔
      prims.Edge (C.f c) (C.f b) (C.f a) := by
  have hQ := C.agreeBelow o (hc ▸ (C.lt_top c).le) IH
  rw [edge_iff, edge_iff, C.isLim_iff a, C.isLim_iff b, C.isLim_iff c, C.lt_iff a b,
    C.lt_iff b c]
  refine and_congr_right fun _ => and_congr_right fun _ => and_congr_right fun _ =>
    and_congr_right fun hab => and_congr_right fun hbc => ?_
  rw [(IH (C.f b) (hbc.trans_eq hc)).1 a b rfl, C.good_elem o IH b c hc]
  refine and_congr_right fun _ => and_congr_right fun _ => ?_
  rw [transports_iff, transports_iff]
  have key : ∀ {V : Type} [DecidableEq V] (D : Diagram V) (F : V → Prop) (t : V),
      TransportsD prims D F t (c : M w).val (b : M w).val (a : M w).val ↔
        TransportsD prims D F t (C.f c) (C.f b) (C.f a) := by
    intro V _ D F t
    by_cases ht : F t
    · exact ⟨fun _ h => absurd ht h, fun _ h => absurd ht h⟩
    rw [← realize_transFml D F t ht (c : M w) (b : M w) (a : M w) ((C.lt_iff a b).2 hab)
      ((C.lt_iff b c).2 hbc), C.realize_push3,
      realize_transFml D F t ht (C.pushEquiv c) (C.pushEquiv b) (C.pushEquiv a) hab hbc]
    exact transportsD_congr hQ D F t hc.le (hbc.trans_eq hc).le
  exact ⟨fun h V _ D F t => (key D F t).1 (h D F t), fun h V _ D F t => (key D F t).2 (h D F t)⟩

/-- N4.7 (helper, step 4): strong induction on the collapsed top coordinate. -/
theorem good (o : Ordinal.{u}) : C.Good o := by
  induction o using WellFoundedLT.induction with
  | _ o IH =>
    exact ⟨fun x y hy => C.good_elem o IH x y hy, fun c b a hc => C.good_edge o IH c b a hc⟩

/-- N4.7 (helper, step 5): the collapse as an isomorphism onto the genuine `M ν`. -/
noncomputable def iso : S ≃[lang] M ν :=
  { C.equiv prims with
    map_fun' := fun {_} g => Empty.elim g
    map_rel' := by
      intro n r xs
      cases r
      · exact (C.lt_iff (xs 0) (xs 1)).symm
      · exact ((C.good (C.f (xs 1))).1 (xs 0) (xs 1) rfl).symm
      · exact ((C.good (C.f (xs 0))).2 (xs 0) (xs 1) (xs 2) rfl).symm }

/-- N4.7 (helper): the isomorphism on values. -/
theorem iso_val (x : S) : (C.iso x).val = C.f x := rfl

end Collapse

/-- N4.7 (helper): every elementary substructure of `M_w` has an order collapse onto some
`ν ≤ w` (via `Ordinal.enumOrdOrderIso`). -/
theorem exists_collapse {w : Ordinal.{u}} (S : lang.ElementarySubstructure (M w)) :
    ∃ ν : Ordinal.{u}, ν ≤ w ∧ Nonempty (Collapse S ν) := by
  set T : Set Ordinal.{u} := Set.range (fun x : S => (x : M w).val) ∪ Set.Ici w
  have hTb : ¬ BddAbove T := by
    rintro ⟨b, hb⟩
    have := hb (show max w (Order.succ b) ∈ T from Or.inr (Set.mem_Ici.2 (le_max_left _ _)))
    exact (not_le.2 ((Order.lt_succ b).trans_le (le_max_right _ _))) this
  let e := Ordinal.enumOrdOrderIso T hTb
  let ν := e.symm ⟨w, Or.inr (Set.mem_Ici.2 le_rfl)⟩
  have heν : e ν = ⟨w, Or.inr (Set.mem_Ici.2 le_rfl)⟩ := e.apply_symm_apply _
  refine ⟨ν, ?_,
    ⟨⟨fun x => e.symm ⟨(x : M w).val, Or.inl ⟨x, rfl⟩⟩, ?_, ?_, ?_⟩⟩⟩
  · calc ν ≤ Ordinal.enumOrd T ν := Ordinal.le_enumOrd_self hTb
      _ = w := congrArg Subtype.val heν
  · intro x
    exact e.symm.lt_iff_lt.2 (show (⟨(x : M w).val, _⟩ : T) < ⟨w, _⟩ from (x : M w).lt)
  · intro x y
    exact (e.symm.lt_iff_lt (x := ⟨(x : M w).val, Or.inl ⟨x, rfl⟩⟩)
      (y := ⟨(y : M w).val, Or.inl ⟨y, rfl⟩⟩)).symm
  · intro o ho
    have h1 : (e o : Ordinal.{u}) < w := by
      have := e.lt_iff_lt.2 ho
      rw [heν] at this
      exact this
    rcases (e o).2 with ⟨x, hx⟩ | hw'
    · refine ⟨x, ?_⟩
      show e.symm _ = o
      rw [OrderIso.symm_apply_eq]
      exact Subtype.ext hx
    · exact absurd hw' (not_le.2 h1)

/-- N4.7 (condensation for reflection structures): the order collapse of an elementary
substructure of `M_w` is an isomorphism onto the *genuine* `M_ν`, for some `ν ≤ w`; it fixes
every point below which the substructure is full, and `|ν| = |S|`. -/
theorem condensation {w : Ordinal.{u}} (S : lang.ElementarySubstructure (M w)) :
    ∃ (ν : Ordinal.{u}) (π : S ≃[lang] M ν), ν ≤ w ∧
      (∀ x y : S, ((x : M w).val < (y : M w).val ↔ (π x).val < (π y).val)) ∧
      (∀ x : S, (∀ o < (x : M w).val, ∃ y : S, (y : M w).val = o) →
        (π x).val = (x : M w).val) ∧
      Cardinal.lift.{u + 1} ν.card = Cardinal.mk S := by
  obtain ⟨ν, hν, ⟨C⟩⟩ := exists_collapse S
  have hπ : ∀ x y : S, ((x : M w).val < (y : M w).val ↔ (C.iso x).val < (C.iso y).val) :=
    C.lt_iff
  refine ⟨ν, C.iso, hν, hπ, fun x hx => collapse_eq_of_cut S C.iso hπ x (fun _ => Iff.rfl) hx,
    ?_⟩
  rw [← Cardinal.mk_Iio_ordinal]
  exact Cardinal.mk_congr
    ((⟨fun y => ⟨y.1, y.2⟩, fun x => ⟨x.val, x.lt⟩, fun _ => rfl, fun _ => rfl⟩ :
      Set.Iio ν ≃ M ν).trans C.iso.toEquiv.symm)


/-! ## N4.8: transfer of realizations through a collapsed hull -/

/-- N4.8: a realization below a point `bd` of `S` with fixed values at points of `S`
transfers to a realization below `π bd` with the collapsed fixed values. -/
theorem transfer {w ν : Ordinal.{u}} (S : lang.ElementarySubstructure (M w))
    (π : S ≃[lang] M ν) {V : Type} (D : Diagram V) (F : V → Prop) (σ σ' : V → Ordinal.{u})
    (p : V → S) (hp : ∀ x ∈ D.vars, F x → (p x : M w).val = σ x ∧ (π (p x)).val = σ' x)
    (bd : S) :
    D.RealizableBelow prims F σ (bd : M w).val → D.RealizableBelow prims F σ' (π bd).val := by
  intro h
  have h1 : D.RealizableBelow prims F (fixAsg D F (fun x => (p x.1 : M w))) (bd : M w).val := by
    refine (Diagram.realizableBelow_congr_fixed prims D F _ _ _ ?_).1 h
    intro x hx hF
    simp only [fixAsg, dif_pos (And.intro hx hF), (hp x hx hF).1]
  rw [← realize_realFml D F (k := 0) 0 0 (fun _ => (bd : M w)) (fun x => (p x.1 : M w))] at h1
  have e1 : (Sum.elim (fun _ => (bd : M w)) (fun x => (p x.1 : M w)) : Fin 1 ⊕ FixT D F → M w) =
      ((↑) : S → M w) ∘ Sum.elim (fun _ => bd) (fun x => p x.1) := by
    funext i; cases i <;> rfl
  have e2 : (π ∘ Sum.elim (fun _ : Fin 1 => bd) (fun x : FixT D F => p x.1)) =
      Sum.elim (fun _ => π bd) (fun x => π (p x.1)) := by
    funext i; cases i <;> rfl
  rw [e1, realize_elemIso S π, e2, realize_realFml] at h1
  refine (Diagram.realizableBelow_congr_fixed prims D F _ _ _ ?_).1 h1
  intro x hx hF
  simp only [fixAsg, dif_pos (And.intro hx hF), (hp x hx hF).2]

/-- N4.8: the same with the top bound `w ↦ ν`. -/
theorem transfer_top {w ν : Ordinal.{u}} (S : lang.ElementarySubstructure (M w))
    (π : S ≃[lang] M ν) {V : Type} (D : Diagram V) (F : V → Prop) (σ σ' : V → Ordinal.{u})
    (p : V → S) (hp : ∀ x ∈ D.vars, F x → (p x : M w).val = σ x ∧ (π (p x)).val = σ' x) :
    D.RealizableBelow prims F σ w → D.RealizableBelow prims F σ' ν := by
  intro h
  by_cases hS : Nonempty S
  · obtain ⟨s₀⟩ := hS
    have h1 : D.RealizableBelow prims F (fixAsg D F (fun x => (p x.1 : M w))) w := by
      refine (Diagram.realizableBelow_congr_fixed prims D F _ _ _ ?_).1 h
      intro x hx hF
      simp only [fixAsg, dif_pos (And.intro hx hF), (hp x hx hF).1]
    rw [← realize_realTopFml D F (fun _ => (s₀ : M w)) (fun x => (p x.1 : M w))] at h1
    have e1 : (Sum.elim (fun _ => (s₀ : M w)) (fun x => (p x.1 : M w)) :
        Fin 1 ⊕ FixT D F → M w) =
        ((↑) : S → M w) ∘ Sum.elim (fun _ => s₀) (fun x => p x.1) := by
      funext i; cases i <;> rfl
    have e2 : (π ∘ Sum.elim (fun _ : Fin 1 => s₀) (fun x : FixT D F => p x.1)) =
        Sum.elim (fun _ => π s₀) (fun x => π (p x.1)) := by
      funext i; cases i <;> rfl
    rw [e1, realize_elemIso S π, e2, realize_realTopFml] at h1
    refine (Diagram.realizableBelow_congr_fixed prims D F _ _ _ ?_).1 h1
    intro x hx hF
    simp only [fixAsg, dif_pos (And.intro hx hF), (hp x hx hF).2]
  · -- an empty elementary substructure only occurs in the empty structure `M 0`
    have hw : w = 0 := by
      by_contra hw
      haveI : Nonempty (M w) := ⟨⟨0, pos_iff_ne_zero.2 hw⟩⟩
      exact hS inferInstance
    subst hw
    obtain ⟨a, -, ha, hD⟩ := h
    have hv : ∀ x ∈ D.vars, False := fun x hx => not_lt_zero (ha x hx)
    exact ⟨σ', fun _ _ => rfl, fun x hx => (hv x hx).elim,
      (Diagram.holds_congr prims D a σ' (fun x hx => (hv x hx).elim)).1 hD⟩

/-! ## N4.9: (13) and (14) for the reflection hierarchy -/

/-- N4.9a (13): `Elem κ w` for an uncountable cardinal `κ` and a limit `w > κ` (S-1). -/
theorem card_elem (κ : Cardinal.{u}) (w : Ordinal.{u}) (hκ : ℵ₀ < κ) (hw : IsLim w)
    (hκw : κ.ord < w) : prims.Elem κ.ord w := by sorry

/-- N4.9b: the hulls `H_r = hull(Iio r ∪ {κ})` in `M_w`. -/
noncomputable def hullAt (κ : Cardinal.{u}) (w : Ordinal.{u}) (hw : 0 < w) (r : Ordinal.{u}) :
    lang.ElementarySubstructure (M w) :=
  hull w hw {x | x.val < r ∨ x.val = κ.ord}

/-- N4.9b: for regular uncountable `κ`, `H_r ∩ κ` is bounded below `κ` when `r < κ`. -/
theorem hullAt_bounded (κ : Cardinal.{u}) (w : Ordinal.{u}) (hw : 0 < w) (hκ : ℵ₀ < κ)
    (hreg : κ.IsRegular) (hκw : κ.ord < w) {r : Ordinal.{u}} (hr : r < κ.ord) :
    ∃ f : Ordinal.{u}, r < f ∧ f < κ.ord ∧
      ∀ y : hullAt κ w hw r, (y : M w).val < κ.ord → (y : M w).val < f := by sorry

/-- N4.9b: the club of reflection points: limits `x < κ` whose hull meets `κ` exactly in `x`. -/
def reflPoints (κ : Cardinal.{u}) (w : Ordinal.{u}) (hw : 0 < w) : Set (Set.Iio κ.ord) :=
  {x | IsLim x.1 ∧ ∀ y : hullAt κ w hw x.1, (y : M w).val < κ.ord → (y : M w).val < x.1}

/-- N4.9b: `reflPoints` is a club. -/
theorem isClub_reflPoints (κ : Cardinal.{u}) (w : Ordinal.{u}) (hw : 0 < w) (hκ : ℵ₀ < κ)
    (hreg : κ.IsRegular) (hκw : κ.ord < w) : IsClub (reflPoints κ w hw) := by sorry

/-- N4.9b: every reflection point carries an edge `Edge w κ x`. -/
theorem edge_of_reflPoint (κ : Cardinal.{u}) (w : Ordinal.{u}) (hw : 0 < w) (hκ : ℵ₀ < κ)
    (hreg : κ.IsRegular) (hwl : IsLim w) (hκw : κ.ord < w) {x : Set.Iio κ.ord}
    (hx : x ∈ reflPoints κ w hw) : prims.Edge w κ.ord x.1 := by sorry

/-- N4.9b (14). -/
theorem club_edge (κ : Cardinal.{u}) (w : Ordinal.{u}) (hκ : ℵ₀ < κ) (hreg : κ.IsRegular)
    (hw : IsLim w) (hκw : κ.ord < w) :
    ∃ C : Set (Set.Iio κ.ord), IsClub C ∧ ∀ x ∈ C, prims.Edge w κ.ord x.1 := by sorry

/-- N4.10 (P-U4-1): the reflection-structure instance of the S-4 interface. -/
noncomputable def interface : Interface.{u} where
  toPrims := prims
  elem_le := elem_le
  elem_lim := elem_lim
  elem_refl := elem_refl
  elem_trans := elem_trans
  elem_mid := elem_mid
  edge_lt := edge_lt
  edge_lim := edge_lim
  edge_elem_low := edge_elem_low
  edge_elem_high := edge_elem_high
  edge_restrict := edge_restrict
  edge_extend := edge_extend
  capture := fun D F σ _ _ hab hσ => capture D F σ hab hσ
  transport := fun D F σ t _ _ _ h ht hσ => transport D F σ t h ht hσ
  card_elem := card_elem
  club_edge := club_edge

end Refl

end Hier

