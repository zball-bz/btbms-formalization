/-- T3.8l (txt:511-643): the setting of the ordinary induction step. -/
structure OrdStep where
  A : Forest
  sd : StopData
  rd : RootData
  n : Nat
  B : Forest
  std : IsStd A
  inL : InL A
  condP : CondP A
  cof : Cof A
  kind : stepKind A = some .ordinary
  hsd : stopData A = some sd
  hrd : rootData A = some rd
  pos : 1 ≤ n
  out : expand A n = some B

namespace OrdStep

variable (S : OrdStep)

/-- The period `d`. -/
def d : Nat := period S.sd
/-- `s_i = r + i d`, the number of the head of layer `i`. -/
def s (i : Nat) : Nat := S.sd.r + i * S.d
/-- `m = |Q|`. -/
def m : Nat := S.sd.Q.length
/-- `τ_i = T_{r, i d}`. -/
def tau (i : Nat) (F : Forest) : Forest := shift S.sd.r (i * S.d) F
/-- The projection of a selected root of phase `φ` (txt:521-524); only used outside `(r, s_φ)`. -/
def proj (φ ρ : Nat) : Nat := if S.s φ < ρ then ρ - φ * S.d else if ρ = S.s φ then S.sd.r else ρ

end OrdStep

-- T3.8la (txt:511-519): where a cap not above `A` and not at the end of `B` can sit
theorem cut_location (S : OrdStep) {c : ColAddr} {k ρ : Nat} (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hle : ¬ S.A < litCap S.B c k ρ)
    (hend : capPos S.B c k < mu S.B) :
    (c = S.sd.col ∧ S.m ≤ k) ∨
      (∃ i, 2 ≤ i ∧ i ≤ S.n ∧ phaseCol S.sd S.rd i S.rd.col = some c) ∨
      (∃ i a, 1 ≤ i ∧ i ≤ S.n ∧ IsTmplCol S.A S.sd S.rd a ∧ (isQMat S.sd a = true → 2 ≤ i) ∧
        phaseCol S.sd S.rd i a = some c) := by sorry

-- T3.8lb (txt:607-608, with the method of T3.8li): the old terminal cap of a head-query cut
theorem headQuery_oldCap (S : OrdStep) {i : Nat} {c : ColAddr} {k ρ : Nat} (hi : 2 ≤ i ∧ i ≤ S.n)
    (hc : phaseCol S.sd S.rd i S.rd.col = some c) (hk : k < S.m ∨ (k = S.m ∧ S.s (i - 1) < ρ))
    (hup : IsUpward S.B c k ρ) (hKL : InL (litCap S.B c k ρ)) :
    let K' := litCap S.A S.sd.col k (ρ - (i - 1) * S.d)
    S.s (i - 1) < ρ ∧ IsUpward S.A S.sd.col k (ρ - (i - 1) * S.d) ∧ CondV K' ∧ CondI K' ∧
      CondAK K' (capKeys K' (routeCols K')) := by sorry

-- T3.8lc (txt:607-611): query-part cuts of head `i ≥ 2`
theorem headQuery_cut (S : OrdStep) {i : Nat} {c : ColAddr} {k ρ : Nat} (hi : 2 ≤ i ∧ i ≤ S.n)
    (hc : phaseCol S.sd S.rd i S.rd.col = some c) (hk : k < S.m ∨ (k = S.m ∧ S.s (i - 1) < ρ))
    (hup : IsUpward S.B c k ρ) (hKL : InL (litCap S.B c k ρ)) :
    Covers (litCap S.B c k ρ) S.B := by sorry

-- T3.8ld (txt:613-617): the seam: the cap at `s_{i−1}` is `A` advanced by `i − 1` periods
theorem expand_seam (S : OrdStep) {i : Nat} {c : ColAddr} (hi : 1 ≤ i ∧ i ≤ S.n)
    (hc : phaseCol S.sd S.rd i S.rd.col = some c) (q : Nat) :
    expand (litCap S.B c S.m (S.s (i - 1))) q = expand S.A (i - 1 + q) := by sorry

-- T3.8le (txt:617-620): no closing parent below `s_{i−1}` is an upward `L` cap at `k = m`
theorem seam_parent (S : OrdStep) {i : Nat} {c : ColAddr} {ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (hc : phaseCol S.sd S.rd i S.rd.col = some c) (hup : IsUpward S.B c S.m ρ)
    (hKL : InL (litCap S.B c S.m ρ)) : S.s (i - 1) ≤ ρ := by sorry

-- T3.8lf (txt:623-624): restored-suffix cuts force `ρ < r`
theorem restored_parent (S : OrdStep) {i : Nat} {c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (hc : phaseCol S.sd S.rd i S.rd.col = some c) (hk : S.m < k) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) : ρ < S.sd.r := by sorry

-- T3.8lg (txt:624-626): the old root cap after `w = c + v` entries has V, I, decorated A
theorem restored_oldCap (S : OrdStep) {i : Nat} {c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (hc : phaseCol S.sd S.rd i S.rd.col = some c) (hk : S.m < k) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hend : capPos S.B c k < mu S.B) :
    let K' := litCap S.A S.rd.col (S.rd.cursor + (k - S.m)) ρ
    IsUpward S.A S.rd.col (S.rd.cursor + (k - S.m)) ρ ∧ CondV K' ∧ CondI K' ∧
      CondAK K' (capKeys K' (routeCols K')) := by sorry

-- T3.8lh (txt:621-640): restored-suffix cuts succeed (remainders (5), delayed change)
theorem restored_cut (S : OrdStep) {i : Nat} {c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (hc : phaseCol S.sd S.rd i S.rd.col = some c) (hk : S.m < k) (hup : IsUpward S.B c k ρ)
