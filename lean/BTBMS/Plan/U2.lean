theorem repairList_eq_body (K : Forest) (b : EntryAddr) (ms : List Move) :
    RepairList K b ms = RepairListBody K b ms := by sorry

theorem origin_eq_body {E : Forest} (w : AdmCap E) : w.origin = originBody w := by sorry

-- provides: U2, D3.1a (`origin_spec`†: χ is injective on the roles of `w.H`, `none` exactly on
-- the closing slot, and the identity on every role of a literal cap other than that slot)
theorem origin_spec {E : Forest} (w : AdmCap E) :
    (∀ x ∈ w.H.roles, ∀ y ∈ w.H.roles, ∀ z, w.origin x = some z → w.origin y = some z → x = y) ∧
    (∀ x ∈ w.H.roles, w.origin x = none ↔
      ∃ sd, stopData w.H = some sd ∧ x = .slot (closingSlot sd)) ∧
    (w.moves = [] → ∀ x ∈ w.H.roles, x ≠ .slot ⟨w.col, w.cut⟩ → w.origin x = some x) ∧
    (∀ x ∈ w.H.roles, ∀ z, w.origin x = some z → z ∈ E.roles) := by sorry

/-! ## §W — U2 half of the S-6 word library -/

section Words

variable {α : Type} [LinearOrder α]

/-- T3.2b: `X'` is a decrease of `X` whose first change is exactly at position `a`: they agree
before `a`, and at `a` either `X'` ends (while `X` continues) or has a smaller letter. -/
def FirstDec (X X' : List α) (a : Nat) : Prop :=
  X'.take a = X.take a ∧ a ≤ X'.length ∧
    ((X'.length = a ∧ a < X.length) ∨ ∃ x x', X[a]? = some x ∧ X'[a]? = some x' ∧ x' < x)

-- T3.2b (txt:304-307, first part)
theorem lt_of_firstDec {X Y X' Y' : List α} {a b : Nat} (hXY : X < Y) (hX : FirstDec X X' a)
    (hY : Y'.take b = Y.take b ∧ b ≤ Y'.length) (hab : a < b) : X' < Y' := by sorry

-- T3.2b (txt:306-307, second part: changes of `Y` only after position `|X|`)
theorem lt_of_take_succ {X Y Y' : List α} (hXY : X < Y)
    (h : Y'.take (X.length + 1) = Y.take (X.length + 1)) : X < Y' := by sorry

/-- L3.4: the kernel's iterates on words: `kerIter P σ q = P Σ(P) ⋯ Σ^{q-1}(P)`. -/
def kerIter (P : List α) (σ : α → α) : Nat → List α
  | 0 => []
  | q + 1 => P ++ (kerIter P σ q).map σ

-- L3.4a: iterates are proper-prefix increasing
theorem kerIter_prefix (P : List α) (σ : α → α) (hP : P ≠ []) (q : Nat) :
    kerIter P σ q <+: kerIter P σ (q + 1) ∧ kerIter P σ q ≠ kerIter P σ (q + 1) := by sorry

theorem kerIter_length (P : List α) (σ : α → α) (q : Nat) :
    (kerIter P σ q).length = q * P.length := by sorry

-- L3.4b (txt:427-436): success iff some iterate covers
theorem word_criterion (P : List α) {σ : α → α} (hP : P ≠ []) (hσ : StrictMono σ)
    (Y : List α) : Y < P ++ Y.map σ ↔ ∃ q, Y < kerIter P σ q := by sorry

-- L3.4c: success is downward closed in the target
theorem success_anti (P : List α) {σ : α → α} (hP : P ≠ []) (hσ : StrictMono σ)
    {Y Y' : List α} (hle : Y' ≤ Y) (h : Y < P ++ Y.map σ) : Y' < P ++ Y'.map σ := by sorry

-- L3.4d: the explicit iteration bound `q |P| > |w(Y)|`
theorem cover_of_success (P : List α) {σ : α → α} (hP : P ≠ []) (hσ : StrictMono σ)
    {Y : List α} (h : Y < P ++ Y.map σ) {q : Nat} (hq : Y.length < q * P.length) :
    Y < kerIter P σ q := by sorry

-- L3.4e: equality `F(Y) = Y` is impossible by length
theorem kernel_ne (P : List α) (σ : α → α) (hP : P ≠ []) (Y : List α) : P ++ Y.map σ ≠ Y := by
  sorry

-- L3.7 (txt:482-487): delayed change
theorem delayed_change {L R L' R' : List α} {lam : Nat} (hRL : R < L) (hlen : R.length ≤ lam)
    (hagree : L'.take lam = L.take lam) (hL' : lam ≤ L'.length) (hR : R' < R) : R' < L' := by
  sorry

/-- T3.2p helper: a word between `T ⌢ D` (letters of `D` below `K`) and `T ⌢ [K]` (letters of `T`
at least `K`) keeps exactly `T` as its run of letters `≥ K`. -/
theorem spx_takeWhile_between {K : α} : ∀ (T D Z : List α), (∀ t ∈ T, K ≤ t) →
    (∀ d ∈ D, d < K) → T ++ D ≤ Z → Z < T ++ [K] →
      Z.takeWhile (fun y => decide (K ≤ y)) = T
  | [], D, [], _, _, _, _ => rfl
  | [], D, z :: Z, _, _, _, h2 => by
    rcases List.cons_lt_cons_iff.1 h2 with h | ⟨-, h⟩
    · simp [not_le.2 h]
    · exact absurd h (List.not_lt_nil _)
  | t :: T, D, [], _, _, h1, _ => by
    exact absurd (List.nil_lt_cons t (T ++ D)) (not_lt.2 h1)
  | t :: T, D, z :: Z, hT, hD, h1, h2 => by
    have h1' : ¬ z :: Z < t :: (T ++ D) := not_lt.2 h1
    rw [List.cons_lt_cons_iff] at h1'
    have h2' := List.cons_lt_cons_iff.1 h2
    have hzt : z = t := by
      rcases h2' with h | ⟨h, -⟩
      · exact absurd (Or.inl h) h1'
      · exact h
    subst hzt
    have h2'' : Z < T ++ [K] := by
      rcases h2' with h | ⟨-, h⟩
      · exact absurd h (lt_irrefl _)
      · exact h
    have h1'' : T ++ D ≤ Z := by
      rw [← not_lt]; intro h; exact h1' (Or.inr ⟨rfl, h⟩)
    have hK : K ≤ z := hT z List.mem_cons_self
    rw [List.takeWhile_cons, if_pos (by simpa using hK),
      spx_takeWhile_between T D Z (fun t ht => hT t (List.mem_cons_of_mem _ ht)) hD h1'' h2'']

/-- T3.2p helper: the one-step reset. -/
theorem spx_reset_one (ks Z : List α) {c : Nat} (hc : c < ks.length)
    (hZ : Z.Pairwise fun x y => y ≤ x) (h1 : cutQuery ks c ≤ Z) (h2 : Z < cutQuery ks (c + 1)) :
    nu (Z ++ [ks[c]]) = cutQuery ks (c + 1) := by
  have hB := cutQuery_noninc ks c
  rw [nu_append_singleton, nu_of_noninc hZ, nuStep_eq_takeWhile hZ, cutQuery_succ hc,
    nuStep_eq_takeWhile hB]
  rw [cutQuery_succ hc, nuStep_eq_takeWhile hB] at h2
  congr 1
  set B := cutQuery ks c
  refine spx_takeWhile_between _ (B.dropWhile fun y => decide (ks[c] ≤ y)) Z ?_ ?_ ?_ h2
  · intro t ht; simpa using mem_takeWhile_imp_of ht
  · intro d hd
    -- the letters after the run are below `ks[c]` (the word is nonincreasing)
    have hsplit := List.takeWhile_append_dropWhile (p := fun y => decide (ks[c] ≤ y)) (l := B)
    cases hdw : B.dropWhile (fun y => decide (ks[c] ≤ y)) with
    | nil => rw [hdw] at hd; simp at hd
    | cons d₀ ds =>
      have hd₀ : d₀ < ks[c] := by
        have := List.head_dropWhile_not (fun y => decide (ks[c] ≤ y)) (l := B) (by simp [hdw])
        simp only [hdw, List.head_cons] at this
        simpa using this
      rw [hdw] at hd
      rcases List.mem_cons.1 hd with rfl | hd
      · exact hd₀
      · have hnon : (d₀ :: ds).Pairwise fun x y => y ≤ x := by
          rw [← hdw]; exact hB.sublist (List.dropWhile_sublist _)
        exact lt_of_le_of_lt (List.rel_of_pairwise_cons hnon hd) hd₀
  · rw [List.takeWhile_append_dropWhile]; exact h1

-- T3.2p (txt:377-382): the reset identity `ν(Z ⌢ [K_c]) = B_c`, iterated through the suffix
theorem reset_nu (ks Z : List α) {c : Nat} (hc : c < ks.length)
    (hZ : Z.Pairwise fun x y => y ≤ x) (h1 : cutQuery ks c ≤ Z) (h2 : Z < cutQuery ks (c + 1))
    {v : Nat} (hv1 : 1 ≤ v) (hv : c + v ≤ ks.length) :
    nu (Z ++ (ks.drop c).take v) = cutQuery ks (c + v) := by
  obtain ⟨w, rfl⟩ : ∃ w, v = w + 1 := ⟨v - 1, by omega⟩
  rw [List.drop_eq_getElem_cons hc, List.take_succ_cons,
    show Z ++ ks[c] :: (ks.drop (c + 1)).take w = (Z ++ [ks[c]]) ++ (ks.drop (c + 1)).take w by simp,
    ← nu_append_nu, spx_reset_one ks Z hc hZ h1 h2, cutQuery, nu_append_nu, ← List.take_add,
    show c + 1 + w = c + (w + 1) by omega]
  rfl

-- T3.2p (txt:386-389): the head cursor `m + γ − c` (including exhaustion)
theorem head_cursor (qs ks : List α) {c : Nat} (hc : c ≤ ks.length)
    (h1 : cutQuery ks c ≤ nu qs) (h2 : c < ks.length → nu qs < cutQuery ks (c + 1))
    {V : List α} (hV : V.Pairwise fun x y => y ≤ x) :
    (V < nu qs → cursor (qs ++ ks.drop c) V < qs.length) ∧
    (nu qs ≤ V → c ≤ cursor ks V ∧
      cursor (qs ++ ks.drop c) V = qs.length + (cursor ks V - c)) := by
  refine ⟨fun hlt => ?_, fun hle => ?_⟩
  · have hq : cursor qs V < qs.length := by
      have := cursor_le_length qs V
      rcases Nat.lt_or_eq_of_le this with h | h
      · exact h
      · exact absurd ((cursor_eq_length_iff qs hV).1 h) (not_le.2 hlt)
    rw [cursor_append_of_lt _ hq]; exact hq
  · have hcm : c ≤ cursor ks V := le_cursor_of_cutQuery_le hV hc (le_trans h1 hle)
    refine ⟨hcm, ?_⟩
    set m := cursor ks V with hm
    have hmL : m ≤ ks.length := cursor_le_length ks V
    obtain ⟨hlo, hhi⟩ := cursor_spec ks V hV
    -- the cut queries of the concatenated source past `qs`
    have hcut : ∀ w, c + w ≤ ks.length →
        cutQuery (qs ++ ks.drop c) (qs.length + w) = if w = 0 then nu qs else cutQuery ks (c + w) := by
      intro w hw
      rw [cutQuery, List.take_append, List.take_of_length_le (by omega), Nat.add_sub_cancel_left,
        ← nu_append_nu]
      split_ifs with hw0
      · subst hw0; simp [nu_of_noninc (nu_noninc qs)]
      · exact reset_nu ks (nu qs) (by omega) (nu_noninc qs) h1 (h2 (by omega)) (by omega) hw
    apply cursor_unique hV
    · simp only [List.length_append, List.length_drop]; omega
    · rw [hcut (m - c) (by omega)]
      split_ifs with h0
      · exact hle
      · rw [show c + (m - c) = m by omega]; exact hlo
    · intro hlt
      simp only [List.length_append, List.length_drop] at hlt
      rw [show qs.length + (m - c) + 1 = qs.length + (m - c + 1) by omega,
        hcut (m - c + 1) (by omega), if_neg (by omega), show c + (m - c + 1) = m + 1 by omega]
      exact hhi (by omega)

end Words

/-! ## L3.1 — profile and repair -/

-- L3.1b (txt:265-266, G-002: needs V, I, H): the first-entry branch of a nonempty height is a
-- pure tower; `h_a(J)` is strictly below the tower with one more terminal entry
theorem relKey_lt_towKey {E : Forest} (hV : CondV E) (hI : CondI E) (hH : CondH E)
    {e : EntryAddr} {p : Nat} {J : Forest} (he : E.entryAt e = some (p, J)) (hJ : J ≠ Tree.empty)
    {d m : Nat} (hπ : profile J = ((toLex (d, m) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat))) :
    relKey (e.col.num 0) J < towKey d (m + 1) := by sorry

-- L3.1b: and above every tower of smaller profile
theorem towKey_le_relKey {E : Forest} (hV : CondV E) (hI : CondI E) (hH : CondH E)
    {e : EntryAddr} {p : Nat} {H : Forest} (he : E.entryAt e = some (p, H)) {d m : Nat}
    (hπ : ((toLex (d, m) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) < profile H) :
    towKey d (m + 1) ≤ relKey (e.col.num 0) H := by sorry

-- L3.1b: profiles of I-legal nonempty heights are `(d, m)` with `m ≥ 1`
theorem profile_of_entry {E : Forest} (hI : CondI E) {e : EntryAddr} {p : Nat} {J : Forest}
    (he : E.entryAt e = some (p, J)) (hJ : J ≠ Tree.empty) :
    ∃ d m, 1 ≤ m ∧ profile J = ((toLex (d, m) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by sorry

-- provides: U2, L3.1c (a literal cap is a safe prefix of `w(E)` followed by one atom)
theorem word_litCap {E : Forest} {c : ColAddr} {k : Nat} (hc : c ∈ E.colAddrs)
    (hk : k ≤ ((E.colAt c).getD []).length) (p : Nat) :
    word (litCap E c k p) = (word E).take (capPos E c k) ++ [capAtom c k p] := by sorry

-- L3.1c: upwardness is "the appended atom beats the next atom of `w(E)`"
theorem isUpward_iff_atom {E : Forest} {c : ColAddr} {k p : Nat} (hc : c ∈ E.colAddrs)
    (hk : k ≤ ((E.colAt c).getD []).length) :
    IsUpward E c k p ↔ ∀ y, (word E)[capPos E c k]? = some y → y < capAtom c k p := by sorry

-- L3.1c: an upward cap is strictly larger
theorem lt_litCap {E : Forest} {c : ColAddr} {k p : Nat} (h : IsUpward E c k p) :
    E < litCap E c k p := by sorry

-- N2.1 (converse of L3.1c): a prefix of `w(B)` followed by a valid closing atom is a literal
-- cap of `B`, provided the next atom of `B` is smaller (and, for a column-start atom, not
-- shallower than the new column)
theorem exists_litCap_of_word {B E : Forest} {π e p : Nat} {first : Bool}
    (hw : word E = (word B).take π ++
      [if first then toLex (2 * e, toLex (1, p)) else toLex (2 * e + 1, toLex (0, p))])
    (hπ : π ≤ mu B)
    (hnext : ∀ y, (word B)[π]? = some y →
      y < (if first then toLex (2 * e, toLex (1, p)) else toLex (2 * e + 1, toLex (0, p))))
    (hfirst : first = true → ∃ y, (word B)[π]? = some y ∧ 2 * e ≤ (ofLex y).1) :
    ∃ c k, c ∈ B.colAddrs ∧ k ≤ ((B.colAt c).getD []).length ∧ colDepth c = e ∧
      (k = 0 ↔ first = true) ∧ capPos B c k = π ∧ IsUpward B c k p ∧ litCap B c k p = E := by
  sorry

-- L3.1d (txt:269-272): every V, I-legal upward literal cap of a nonempty height `J` is at most
-- `Γ(J)`, read at the heights of the cap's containing entries
theorem capKey_le_towKey {E : Forest} (hV : CondV E) (hI : CondI E) (hH : CondH E)
    {c : ColAddr} {k p : Nat} (hup : IsUpward E c k p) (hKV : CondV (litCap E c k p))
    (hKI : CondI (litCap E c k p)) {e : EntryAddr} (hcont : e.heightPath <+: c.path)
    {q : Nat} {J : Forest} (he : E.entryAt e = some (q, J)) {d m : Nat}
    (hπ : profile J = ((toLex (d, m) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat))) :
    relKey (e.col.num 0) (((litCap E c k p).heightAt e).getD Tree.empty) ≤ towKey d (m + 1) := by
  sorry

-- provides: U2, L3.1e (`upward_condS`†, txt:274-282)
theorem upward_condS {E : Forest} (hV : CondV E) (hI : CondI E) (hH : CondH E) (hP : CondP E)
    {c : ColAddr} {k p : Nat} (hup : IsUpward E c k p) (hKV : CondV (litCap E c k p))
    (hKI : CondI (litCap E c k p)) : CondS (litCap E c k p) := by sorry

-- L3.1f (txt:286-288): the interval fact
theorem interval_cap {X Y : Forest} {c : ColAddr} {k p : Nat} (hup : IsUpward X c k p)
    (hXY : X ≤ Y) (hYC : Y < litCap X c k p) :
    IsUpward Y c k p ∧ litCap Y c k p = litCap X c k p := by sorry

-- L3.1g (txt:289-293): a legal move keeps every decorated response, hence decorated A
theorem decoratedA_applyMove {K : Forest} {m : Move} (hm : MoveOK K m) (hV : CondV K)
    (hA : CondAK K (capKeys K (routeCols K))) :
    CondV (applyMove K m) ∧ (CondI K → CondI (applyMove K m)) ∧
      CondAK (applyMove K m) (capKeys (applyMove K m) (routeCols (applyMove K m))) := by sorry

-- L3.1h (txt:286-288, 294-295): after legal moves an upward literal cap of an `H`-expression is
-- again an upward literal cap of it, with the same cut, parent and internal cap
theorem applyMoves_litCap {E : Forest} (hH : CondH E) {c : ColAddr} {k p : Nat}
    (hup : IsUpward E c k p) {ms : List Move} (hms : MovesValid (litCap E c k p) ms) :
    ∃ c', IsUpward E c' k p ∧ applyMoves (litCap E c k p) ms = litCap E c' k p ∧
      ((E.colAt c').getD []).take k = ((E.colAt c).getD []).take k := by sorry

-- provides: U2, L3.1 (`repair`†, txt:283-298)
theorem repair {E : Forest} (hL : InL E) (hP : CondP E) {c : ColAddr} {k p : Nat}
    (hup : IsUpward E c k p) (hKV : CondV (litCap E c k p)) (hKI : CondI (litCap E c k p))
    (hKA : CondAK (litCap E c k p) (capKeys (litCap E c k p) (routeCols (litCap E c k p)))) :
    ∃ w : AdmCap E, w.col = c ∧ w.cut = k ∧ w.par = p ∧
      (∃ sd, stopData w.H = some sd ∧ sd.r = p ∧ sd.Q = ((E.colAt c).getD []).take k) ∧
      ∃ c', IsUpward E c' k p ∧ w.H = litCap E c' k p := by sorry

/-! ## D3.1d, D3.1e — integration additions (requested by U3 R10–R13, R15, R18, R19 and U5 R16,
R17; formerly stubs in `U3.lean` / `U5.lean`) -/

-- provides: U2, D3.1d (requested by U3 R10; refines `origin_spec`†): χ is injective on the
-- roles of `w.H`, `none` exactly on the closing slot, valued in `E`, sends ordinary roles to
-- ordinary roles of the same printed number, keeps labels and hosts of slots, commutes with
-- representatives, and preserves reading order.
theorem origin_spec_full {E : Forest} (hE : InL E) (w : AdmCap E) :
    Set.InjOn w.origin {x | x ∈ w.H.roles} ∧
    (∀ x ∈ w.H.roles, w.origin x = none ↔ ∃ sd, stopData w.H = some sd ∧
      x = .slot (closingSlot sd)) ∧
    (∀ x ∈ w.H.roles, ∀ y, w.origin x = some y → y ∈ E.roles) ∧
    (∀ c, Role.ord c ∈ w.H.roles → (∃ c', w.origin (.ord c) = some (.ord c')) ∨ w.origin (.ord c) = none) ∧
    (∀ c c', Role.ord c ∈ w.H.roles → w.origin (.ord c) = some (.ord c') → c'.num 0 = c.num 0) ∧
    (∀ e e', Role.slot e ∈ w.H.roles → w.origin (.slot e) = some (.slot e') →
      (w.H.entryAt e).map Prod.fst = (E.entryAt e').map Prod.fst ∧
      w.origin (.ord e.col) = some (.ord e'.col)) ∧
    (∀ c c', Role.ord c ∈ w.H.roles → w.origin (.ord c) = some (.ord c') → ∀ q, q < c.num 0 →
      (c.rep 0 q).map (fun ov => (Packet.anchorD E (some w) ov.1, Packet.anchorD E (some w) ov.2)) =
        c'.rep 0 q) ∧
    (∀ x y, (∃ i j : Nat, w.H.roles[i]? = some x ∧ w.H.roles[j]? = some y ∧ i < j) →
      (w.origin x).isSome → (w.origin y).isSome →
      ∃ i j : Nat, E.roles[i]? = some (Packet.anchorD E (some w) x) ∧
        E.roles[j]? = some (Packet.anchorD E (some w) y) ∧ i < j) := by sorry

-- provides: U2, D3.1d (requested by U3 R15): the query of an admissible cap is the cut prefix of
-- `E`'s column, with origins at the same indices.
theorem admCap_query {E : Forest} (hE : InL E) (w : AdmCap E) {sd : StopData}
    (hsd : stopData w.H = some sd) :
    sd.t = w.col.num 0 ∧ sd.r = w.par ∧ sd.Q.length = w.cut ∧
    w.origin (.ord sd.col) = some (.ord w.col) ∧
    ∀ j < w.cut, w.origin (.slot ⟨sd.col, j⟩) = some (.slot ⟨w.col, j⟩) ∧
      (sd.Q[j]?) = ((E.colAt w.col).getD [])[j]? := by sorry

-- provides: U2, D3.1d (requested by U5 R16): the origin of the stopping role exists, the origin map
-- is injective, and every pre-stop role of the anchor has an origin strictly before the origin of
-- the stopping role.
theorem anchorOrigin_prefix {E : Forest} {cap : Option (AdmCap E)} (hE : InL (anchor E cap))
    {sd : StopData}
    (hsd : stopData (anchor E cap) = some sd) :
    ∃ T', anchorOrigin E cap (.ord sd.col) = some T' ∧
    (∀ x x' y, anchorOrigin E cap x = some y → anchorOrigin E cap x' = some y → x = x') ∧
    ∀ x ∈ Packet.rolesBefore (anchor E cap) (.ord sd.col),
      ∃ y, anchorOrigin E cap x = some y ∧ y ∈ Packet.rolesBefore E T' ∧ y ∈ E.roles := by sorry

-- provides: U2, D3.1d (requested by U5 R17): an admissible upward cap lies strictly above `E`.
theorem lt_admCap {E : Forest} (w : AdmCap E) : E < w.H := by sorry

-- provides: U2, D3.1e (requested by U3 R11): roles and stopping data of a literal cap.
theorem litCap_spec {E : Forest} {c : ColAddr} {k p : Nat} (hc : c ∈ E.colAddrs)
    (hk : k ≤ (parents E c).length) :
    let K := litCap E c k p
    (∃ m, K.roles = E.roles.take m ++ [.slot ⟨c, k⟩]) ∧
    (∀ e ∈ K.entryAddrs, e ≠ ⟨c, k⟩ → (K.entryAt e).map Prod.fst = (E.entryAt e).map Prod.fst) ∧
    (∀ e ∈ K.entryAddrs, e ≠ ⟨c, k⟩ → ¬ e.heightPath <+: c.path → K.entryAt e = E.entryAt e) ∧
    K.entryAt ⟨c, k⟩ = some (p, Tree.empty) ∧
    (c.path ≠ [] → CondI E → CondV K →
      ∃ sd, stopData K = some sd ∧ sd.col = c ∧ sd.r = p ∧
        sd.Q = ((E.colAt c).getD []).take k) := by sorry

/-- D3.1e (G-016 / BP-04): every move avoids the marked height at its *current* address
(after the earlier moves have relocated it). -/
def MovesOutside (ms : List Move) (b : EntryAddr) : Prop :=
  ∀ idx (h : idx < ms.length), ¬ (moveAddr (ms.take idx) b).heightPath <+: (ms[idx]).col.path

-- provides: U2, D3.1e (requested by U3 R12): the moves of an admissible cap that avoid the
-- marked height `B` form a repair list for `b` and commute with replacing `B`.
-- G-016: `hout` is `MovesOutside` (the original static exclusion is false, BP-04).
theorem moves_spec {E : Forest} (hE : InL E) (w : AdmCap E) (b : EntryAddr)
    (hb : b.heightPath <+: w.col.path) (hout : MovesOutside w.moves b) :
    RepairList (E.truncAfter b) b w.moves ∧
    (moveAddr w.moves b).col.num 0 = b.col.num 0 ∧
    (∀ X, applyMoves ((E.truncAfter b).setHeight b X) w.moves =
      (applyMoves (E.truncAfter b) w.moves).setHeight (moveAddr w.moves b) X) ∧
    (applyMoves (E.truncAfter b) w.moves).heightAt (moveAddr w.moves b) = E.heightAt b ∧
    w.H = (applyMoves (E.truncAfter b) w.moves).setHeight (moveAddr w.moves b)
      ((w.H.heightAt (moveAddr w.moves b)).getD Tree.empty) := by sorry

-- provides: U2, D3.1e (requested by U3 R13): every move of an admissible cap is legal for the
-- expression produced by the moves before it (`MoveOK` unfolded).
theorem moves_violate {E : Forest} (w : AdmCap E) :
    ∀ idx (hidx : idx < w.moves.length),
      ∃ (col : List (Nat × Forest)) (sd : StopData) (q : Nat) (Hi C : Forest),
        (applyMoves (litCap E w.col w.cut w.par) (w.moves.take idx)).colAt
          w.moves[idx].col = some col ∧
        stopData (applyMoves (litCap E w.col w.cut w.par) (w.moves.take idx)) = some sd ∧
        w.moves[idx].j + 1 = col.length ∧ w.moves[idx].i < w.moves[idx].j ∧
        (⟨w.moves[idx].col, w.moves[idx].j⟩ : EntryAddr).heightPath <+: sd.col.path ∧
        col[w.moves[idx].i]? = some (q, Hi) ∧ col[w.moves[idx].j]? = some (q, C) ∧
        (∀ x, w.moves[idx].i ≤ x → x ≤ w.moves[idx].j → (col[x]?).map Prod.fst = some q) ∧
        Hi < C := by sorry

-- provides: U2, D3.1e (requested by U3 R18): address form of L3.1h — each prefix of the repair
-- is the literal cap of `E` at the relocated column.
theorem applyMoves_litCap_addr {E : Forest} (hH : CondH E) (w : AdmCap E)
    {b : EntryAddr} (hb : b.heightPath <+: w.col.path) (hout : MovesOutside w.moves b) :
    ∀ q, q ≤ w.moves.length →
      IsUpward E ⟨(moveAddr (w.moves.take q) b).heightPath ++
          w.col.path.drop b.heightPath.length, w.col.col⟩ w.cut w.par ∧
      applyMoves (litCap E w.col w.cut w.par) (w.moves.take q) =
        litCap E ⟨(moveAddr (w.moves.take q) b).heightPath ++
          w.col.path.drop b.heightPath.length, w.col.col⟩ w.cut w.par ∧
      ((E.colAt ⟨(moveAddr (w.moves.take q) b).heightPath ++
          w.col.path.drop b.heightPath.length, w.col.col⟩).getD []).take w.cut =
        ((E.colAt w.col).getD []).take w.cut := by sorry

-- provides: U2, D3.1e (requested by U3 R19(a)): a move rewrites only entry indices.
theorem moveAddr_num (ms : List Move) (b : EntryAddr) :
    (moveAddr ms b).col.num 0 = b.col.num 0 := by sorry

-- provides: U2, D3.1e (requested by U3 R19(b)): a repair list carries the marked height.
theorem repairList_height {K : Forest} {b : EntryAddr} {ms : List Move}
    (h : RepairList K b ms) :
    (applyMoves K ms).heightAt (moveAddr ms b) = K.heightAt b := by sorry

/-! ## D3.3, L3.5 — kernels, contexts, filling identity, cancellation -/

/-- D3.3: the root forest `F = F_j` (the forest containing the root column). -/
def rootForest (E : Forest) (rd : RootData) : Forest := (E.forestAt rd.col.path).getD Tree.empty

/-- D3.3: the root column `R`. -/
def rootCol (E : Forest) (rd : RootData) : Column := (E.colAt rd.col).getD []

/-- D3.3: the unconsumed root suffix `U = R[c:]`. -/
def unconsumed (E : Forest) (rd : RootData) : Column := (rootCol E rd).drop rd.cursor

/-- D3.3: the period `d = t − r`. -/
def period (sd : StopData) : Nat := sd.t - sd.r

/-- D3.3: the hole depth `ℓ − j` (relative to the root forest). -/
def holeDepth (sd : StopData) (rd : RootData) : Nat := sd.depth - rd.layer

/-- D3.3: the kernel is defined unless the owner root is exhausted (txt:129). -/
def KernelDefined (E : Forest) (rd : RootData) : Prop := rd.owner = true → unconsumed E rd ≠ []

/-- D3.3 (txt:421-422): the kernel `F_E(X)`: one period of the ordinary loop with its rightmost
continuation hole filled by `T_{r,t−r}(X)`. Body case: head `Q ⌢ U'` then
`A_{r,d,ℓ−j,T_d X}(F[i+1:])`; owner case: the head alone, its last restored height using
`A_{r,d,ℓ−j−1,T_d X}`. -/
def kernel (E : Forest) (sd : StopData) (rd : RootData) (X : Forest) : Forest :=
  let r := sd.r
  let d := period sd
  let U := unconsumed E rd
  if rd.owner then
    .node [sd.Q ++ mapLast (fun x => (x.1, shift r d x.2))
      (fun x => (x.1, replaceAt r d (shift r d X) (holeDepth sd rd - 1) x.2)) U]
  else
    .node ((sd.Q ++ U.map fun x => (x.1, shift r d x.2)) ::
      (replaceAt r d (shift r d X) (holeDepth sd rd)
        (.node ((rootForest E rd).cols.drop (rd.idx + 1)))).cols)

/-- D3.3 (txt:422): the terminal context `C_E(Z) = A_{0,0,ℓ,Z}(E)`; also the paper's
`fill(K, Y)` (txt:440). -/
def context (E : Forest) (sd : StopData) (Z : Forest) : Forest := replaceAt 0 0 Z sd.depth E

/-- D3.3b: the kernel's word prefix `P = w(F_E(∅))`. -/
def kerPrefix (E : Forest) (sd : StopData) (rd : RootData) : List WordAtom :=
  word (kernel E sd rd Tree.empty)

/-- D3.3b: the letterwise embedding `Σ`: depth translation by `2(ℓ−j)`, parent shift `T_{r,d}`.
VERIFY-U2 (F1): the parent shift is applied only to entry atoms. An empty-column atom `(2e, 0, 0)`
(even depth coordinate, marker `0`) keeps its third coordinate: shifting it would turn `(2e,0,0)`
into `(2e,0,d)` when `r = 0`, and `word_kernel` would fail (e.g. `E = seed 1`, `X = [[],[]]`). -/
def kerSigma (sd : StopData) (rd : RootData) (A : WordAtom) : WordAtom :=
  toLex ((ofLex A).1 + 2 * holeDepth sd rd,
    toLex ((ofLex (ofLex A).2).1,
      if (ofLex A).1 % 2 = 0 ∧ (ofLex (ofLex A).2).1 = 0 then (ofLex (ofLex A).2).2
      else shiftVal sd.r (period sd) (ofLex (ofLex A).2).2))

/-- D3.3b: depth translation of an atom by `e` levels. -/
def depthShift (e : Nat) (A : WordAtom) : WordAtom := toLex ((ofLex A).1 + 2 * e, (ofLex A).2)

-- provides: U2, D3.3a (txt:422: `H[q] = C_H(F_H^q(∅))`)
theorem expand_eq_iterate {E : Forest} {sd : StopData} {rd : RootData} (hE : E ≠ Tree.empty)
    (hV : CondV E) (hI : CondI E) (hk : stepKind E = some .ordinary)
    (hsd : stopData E = some sd) (hrd : rootData E = some rd) (hdef : KernelDefined E rd)
    (n : Nat) : expand E n = some (context E sd ((kernel E sd rd)^[n] Tree.empty)) := by sorry

-- D3.3a: the exhausted owner root is the only undefined case
theorem expand_none_iff {E : Forest} {sd : StopData} {rd : RootData} (hE : E ≠ Tree.empty)
    (hV : CondV E) (hI : CondI E) (hk : stepKind E = some .ordinary)
    (hsd : stopData E = some sd) (hrd : rootData E = some rd) (n : Nat) :
    expand E n = none ↔ (1 ≤ n ∧ ¬ KernelDefined E rd) := by sorry

-- VERIFY-U2 (F2): D3.3a part 3: at parameter `0` the ordinary output is `C_E(∅)` with no
-- `KernelDefined` hypothesis (the exhausted owner root only matters for `n ≥ 1`); needed by
-- T3.2g and `expand_lt` (V, I only) and by T3.8c.3
theorem expand_zero_eq_context {E : Forest} {sd : StopData} (hE : E ≠ Tree.empty)
    (hV : CondV E) (hI : CondI E) (hk : stepKind E = some .ordinary)
    (hsd : stopData E = some sd) : expand E 0 = some (context E sd Tree.empty) := by sorry

-- D3.3b: the context appends the word of its filling at depth `ℓ`
theorem word_context {E : Forest} {sd : StopData} (hsd : stopData E = some sd) (Z : Forest) :
    word (context E sd Z) = word (context E sd Tree.empty) ++ (word Z).map (depthShift sd.depth) := by
  sorry

-- D3.3b (txt:422): `w(F_E(X)) = P ⌢ Σ(w(X))`
theorem word_kernel {E : Forest} {sd : StopData} {rd : RootData} (hV : CondV E)
    (hsd : stopData E = some sd) (hrd : rootData E = some rd) (hkd : KernelDefined E rd)
    (X : Forest) :
    word (kernel E sd rd X) = kerPrefix E sd rd ++ (word X).map (kerSigma sd rd) := by sorry

-- D3.3b: `|P| > 0` and `Σ` is an order embedding
theorem kerPrefix_ne_nil (E : Forest) (sd : StopData) (rd : RootData) : kerPrefix E sd rd ≠ [] := by
  sorry

theorem kerSigma_strictMono (sd : StopData) (rd : RootData) : StrictMono (kerSigma sd rd) := by
  sorry

theorem depthShift_strictMono (e : Nat) : StrictMono (depthShift e) := by sorry

/-- L3.5: `rt_{ρ,c}(D)`: the root forest suffix from the root column, with the first `c` entries
of that column deleted (the column is retained even if empty). -/
def rootTail (D : Forest) (rd : RootData) (c : Nat) : Forest :=
  .node ((((D.colAt rd.col).getD []).drop c) ::
    ((D.forestAt rd.col.path).getD Tree.empty).cols.drop (rd.idx + 1))

/-- L3.5: `Q ⋄ X` prepends `Q` to the first column of a nonempty `X`. -/
def diamond (Q : Column) (X : Forest) : Forest :=
  match X with
  | .node (c :: cs) => .node ((Q ++ c) :: cs)
  | .node [] => .node []

/-- L3.5: `e_1(X)`: the first column's entries encoded as continuation entries (no marker),
then the remaining columns. -/
def encOne (X : Forest) : List WordAtom :=
  match X with
  | .node (c :: cs) => wordLater 0 c ++ wordCols 0 cs
  | .node [] => []

/-- L3.5: `e_ε(Q)(X)`. -/
def encEps (Q : Column) (X : Forest) : List WordAtom := if Q = [] then word X else encOne X

-- provides: U2, L3.5 (1) (txt:438-447): the filling identity, with frozen cursor
theorem filling_identity {K : Forest} {sd : StopData} {rd : RootData} (hV : CondV K)
    (hsd : stopData K = some sd) (hrd : rootData K = some rd) (Y : Forest) :
    kernel K sd rd Y = diamond sd.Q (shift sd.r (period sd) (rootTail (context K sd Y) rd rd.cursor)) := by
  sorry

-- L3.5 (2) (txt:448-458): cancellation of a prefix `Q`
theorem cancel_eq (Q : Column) {X : Forest} (hX : X ≠ Tree.empty) :
    word (diamond Q X) = (if Q = [] then [] else word (.node [Q])) ++ encEps Q X := by sorry

-- L3.5 (2): comparisons after deleting the same nonempty prefix
theorem diamond_lt_iff {Q : Column} (hQ : Q ≠ []) {X X' : Forest} (hX : X ≠ Tree.empty)
    (hX' : X' ≠ Tree.empty) : diamond Q X < diamond Q X' ↔ encOne X < encOne X' := by sorry

-- L3.5c (txt:476-478, 579-580): root restriction preserves proper word extension when the cut of
-- the shorter filling lies after the start of the retained root entry
theorem rootTail_extension {D₁ D₂ : Forest} {rd : RootData} {γ π : Nat}
    (hD : D₁ = safePrefix D₂ π) (hπ : π < mu D₂) (hcol : rd.col ∈ D₂.colAddrs)
    (hγ : capPos D₂ rd.col γ < π)
    (hlast : ∀ y ∈ (word D₂).drop (capPos D₂ rd.col γ), 2 * colDepth rd.col ≤ (ofLex y).1)
    (Q : Column) (ρ δ : Nat) :
    diamond Q (shift ρ δ (rootTail D₁ rd γ)) < diamond Q (shift ρ δ (rootTail D₂ rd γ)) := by
  sorry

/-- D3.3c: kernel success at a target suffix `Y`. -/
def Success (K Y : Forest) : Prop :=
  ∃ sd rd, stopData K = some sd ∧ rootData K = some rd ∧ KernelDefined K rd ∧
    Y < kernel K sd rd Y

/-- D3.3c: some approximant of `K` strictly exceeds `B`. -/
def Covers (K B : Forest) : Prop := ∃ q K', expand K q = some K' ∧ B < K'

-- D3.3c: kernel conjugacy under a phase shift (txt:542-546, 547-552)
theorem kernel_conj {K K' : Forest} {sd sd' : StopData} {rd rd' : RootData} {r δ : Nat}
    (hr : r ≤ sd'.r) (hQ : sd.Q = Tree.mapCol (shiftVal r δ) sd'.Q) (hρ : sd.r = sd'.r + δ)
    (ht : sd.t = sd'.t + δ) (hU : unconsumed K rd = Tree.mapCol (shiftVal r δ) (unconsumed K' rd'))
    (howner : rd.owner = rd'.owner) (hhole : holeDepth sd rd = holeDepth sd' rd')
    (hbody : Tree.node ((rootForest K rd).cols.drop (rd.idx + 1)) =
      shift r δ (.node ((rootForest K' rd').cols.drop (rd'.idx + 1))))
    (X : Forest) : kernel K sd rd (shift r δ X) = shift r δ (kernel K' sd' rd' X) := by sorry

/-! ## §T3.2 — closure -/

/-- T3.2d: the word of a key (U1's generic word at labels `Bool ×ₗ Nat`); positions and length
equal those of the underlying forest's word (`relKey` is a relabelling). -/
def keyWord (K : Key) : List (Nat ×ₗ Nat ×ₗ WithBot (Bool ×ₗ Nat)) :=
  gwordAt 0 (K.map fun x => (toLex x : Bool ×ₗ Nat))

/-- T3.2h (txt:331-336): `κ_j` on key labels: add `j·d` to a false field `(0, p)` with `p ≥ r`. -/
def kappaLabel (r d j : Nat) (x : Bool × Nat) : Bool × Nat :=
  if x.1 = false ∧ r ≤ x.2 then (false, x.2 + j * d) else x

def kappa (r d j : Nat) (K : Key) : Key := K.map (kappaLabel r d j)

-- T3.2h: `h_{x+jd}(τ_j H) = κ_j(h_x(H))` for `x ≥ r`
theorem relKey_shift (r d j x : Nat) (hx : r ≤ x) (H : Forest) :
    relKey (x + j * d) (shift r (j * d) H) = kappa r d j (relKey x H) := by sorry

-- T3.2h: `κ_i κ_j = κ_{i+j}`
theorem kappa_add (r d i j : Nat) (K : Key) : kappa r d i (kappa r d j K) = kappa r d (i + j) K := by
  sorry

-- T3.2h: `κ_j` is an order embedding of keys
theorem kappa_strictMono (r d j : Nat) : StrictMono (kappa r d j) := by sorry

-- T3.2h: `κ_j` commutes with `ν`
theorem kappa_nu (r d j : Nat) (l : List Key) : nu (l.map (kappa r d j)) = (nu l).map (kappa r d j) := by
  sorry

-- T3.2h: keys normalized at or below `r` are fixed
theorem kappa_fix (r d j x : Nat) (hx : x ≤ r) (H : Forest) : kappa r d j (relKey x H) = relKey x H := by
  sorry

-- T3.2h (3) (txt:572-575): `T_{ρ,x+δ−ρ} = τ_δ ∘ T_{ρ,x−ρ}` for `ρ ≤ r ≤ x`
theorem shiftVal_comp {ρ r x δ : Nat} (hρ : ρ ≤ r) (hx : r ≤ x) (p : Nat) :
    shiftVal ρ (x + δ - ρ) p = shiftVal r δ (shiftVal ρ (x - ρ) p) := by sorry

-- T3.2h: `T_{ρ'+δ,d} ∘ τ_δ = τ_δ ∘ T_{ρ',d}` for `r ≤ ρ'` (phase conjugacy of root shifts)
theorem shiftVal_conj {r ρ' δ d : Nat} (hr : r ≤ ρ') (p : Nat) :
    shiftVal (ρ' + δ) d (shiftVal r δ p) = shiftVal r δ (shiftVal ρ' d p) := by sorry

-- T3.2h: shifts are order embeddings of forests
theorem shift_lt_shift (r d : Nat) {X Y : Forest} : shift r d X < shift r d Y ↔ X < Y := by sorry

/-- T3.2i: placement of an address of a forest `X` whose columns are put at the hole column `h`
(the address-level fill law of `A_{r,d,ℓ,X}` and `C_E(X)`). -/
def underCol (h a : ColAddr) : ColAddr :=
  match a.path with
  | [] => ⟨h.path, h.col + a.col⟩
  | (c0, e0) :: rest => ⟨h.path ++ (h.col + c0, e0) :: rest, a.col⟩

/-- T3.2i: Q-height material: addresses inside the height of an entry `j < |Q|` of the stopping
column. -/
def isQMat (sd : StopData) (a : ColAddr) : Bool :=
  (a.path.take sd.col.path.length == sd.col.path) &&
    match a.path.drop sd.col.path.length with
    | (ci, j) :: _ => ci == sd.col.col && decide (j < sd.Q.length)
    | [] => false

/-- T3.2i: the template map of one period: an address of `A` in the copied region ↦ its address
relative to the kernel output. Q-heights go to the head's first `m` entries; the root column
goes to the head (column 0); restored heights (entries `c + v`) go to head entries `m + v`;
body columns `ι+1+z` go to column `1+z` (body case only). `none` outside the template. -/
def kerCol (sd : StopData) (rd : RootData) (a : ColAddr) : Option ColAddr :=
  let m := sd.Q.length
  if isQMat sd a then
    match a.path.drop sd.col.path.length with
    | (_, j) :: rest => some ⟨(0, j) :: rest, a.col⟩
    | [] => none
  else if a.path.take rd.col.path.length = rd.col.path then
    match a.path.drop rd.col.path.length with
    | (ci, e) :: rest =>
      if ci = rd.idx ∧ rd.cursor ≤ e then some ⟨(0, m + (e - rd.cursor)) :: rest, a.col⟩
      else if rd.idx < ci ∧ rd.owner = false then some ⟨(ci - rd.idx, e) :: rest, a.col⟩
      else none
    | [] =>
      if a.col = rd.idx then some ⟨[], 0⟩
      else if rd.idx < a.col ∧ rd.owner = false then some ⟨[], a.col - rd.idx⟩
      else none
  else none

/-- T3.2i: the hole of the kernel (the image of the stopping column). -/
def kerHole (sd : StopData) (rd : RootData) : ColAddr := (kerCol sd rd sd.col).getD ⟨[], 0⟩

/-- T3.2i: the address in `E[n] = C_E(F^n(∅))` of the phase-`i` copy (`i ≥ 1`, `i`-th kernel
layer from outside) of the template address `a`. -/
def phaseCol (sd : StopData) (rd : RootData) (i : Nat) (a : ColAddr) : Option ColAddr :=
  (kerCol sd rd a).map fun a' => underCol sd.col ((underCol (kerHole sd rd))^[i - 1] a')

/-- T3.2i: the phase of the copy: Q-heights in head `i` have phase `i − 1`, all other template
material in layer `i` has phase `i`. -/
def phaseOff (sd : StopData) (i : Nat) (a : ColAddr) : Nat := if isQMat sd a then i - 1 else i

/-- T3.2i: a template column of `A` (copied region, excluding the root and stopping columns). -/
def IsTmplCol (A : Forest) (sd : StopData) (rd : RootData) (a : ColAddr) : Prop :=
  a ∈ A.colAddrs ∧ a ≠ sd.col ∧ a ≠ rd.col ∧ (kerCol sd rd a).isSome

/-- T3.2i / T3.8: `a` lies in a forest on the route to the stopping column (its local suffix
contains the continuation hole). -/
def OnHoleRoute (sd : StopData) (a : ColAddr) : Prop := a.path <+: sd.col.path

-- T3.2i (txt:318-330): every column of the output is a context column or exactly one phase copy
theorem classify_cols {A B : Forest} {sd : StopData} {rd : RootData} {n : Nat} (hL : InL A)
    (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd) (hrd : rootData A = some rd)
    (hB : expand A n = some B) {c : ColAddr} (hc : c ∈ B.colAddrs) :
    (c ∈ (context A sd Tree.empty).colAddrs ∧ c ≠ sd.col) ∨
      ∃ i a, 1 ≤ i ∧ i ≤ n ∧ (a = rd.col ∨ IsTmplCol A sd rd a) ∧ phaseCol sd rd i a = some c ∧
        ∀ i' a', 1 ≤ i' → i' ≤ n → (a' = rd.col ∨ IsTmplCol A sd rd a') →
          phaseCol sd rd i' a' = some c → i' = i ∧ a' = a := by sorry

-- T3.2i: printed numbers of phase copies
theorem num_phaseCol {A : Forest} {sd : StopData} {rd : RootData} {i : Nat} {a c : ColAddr}
    (hL : InL A) (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) (ha : a = rd.col ∨ IsTmplCol A sd rd a) (hi : 1 ≤ i)
    (hc : phaseCol sd rd i a = some c) : c.num 0 = a.num 0 + phaseOff sd i a * period sd := by sorry

-- T3.2i: a closed template column is a pure copy (parents and heights shifted by its phase)
theorem colAt_phaseCol {A B : Forest} {sd : StopData} {rd : RootData} {n i : Nat} {a c : ColAddr}
    (hL : InL A) (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) (hB : expand A n = some B) (hi : 1 ≤ i ∧ i ≤ n)
    (ha : IsTmplCol A sd rd a) (hroute : ¬ OnHoleRoute sd a) (hc : phaseCol sd rd i a = some c) :
    B.colAt c = (A.colAt a).map (Tree.mapCol (shiftVal sd.r (phaseOff sd i a * period sd))) := by sorry

-- T3.2i: the head column of layer `i`: `τ_{i−1}(Q)` then the restored entries of `U` with
-- phase-`i` heights (the last one a continuation in the owner case)
theorem colAt_head {A B : Forest} {sd : StopData} {rd : RootData} {n i : Nat} {c : ColAddr}
    (hL : InL A) (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) (hB : expand A n = some B) (hi : 1 ≤ i ∧ i ≤ n)
    (hc : phaseCol sd rd i rd.col = some c) :
    ∃ col, B.colAt c = some col ∧ col.length = sd.Q.length + (unconsumed A rd).length ∧
      col.take sd.Q.length = Tree.mapCol (shiftVal sd.r ((i - 1) * period sd)) sd.Q ∧
      ∀ v x, (unconsumed A rd)[v]? = some x → ∃ y, col[sd.Q.length + v]? = some y ∧ y.1 = x.1 ∧
        (¬ (rd.owner = true ∧ v + 1 = (unconsumed A rd).length) →
          y.2 = shift sd.r (i * period sd) x.2) := by sorry

-- T3.2i/T3.2l: local suffixes of phase copies; root-tail material reads the shorter output
-- `A_{n−i}` (txt:586-592)
theorem localSuffix_phase {A B A' : Forest} {sd : StopData} {rd : RootData} {n i : Nat}
    {a c : ColAddr} (hL : InL A) (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) (hB : expand A n = some B) (hi : 1 ≤ i ∧ i ≤ n)
    (ha : IsTmplCol A sd rd a) (hc : phaseCol sd rd i a = some c)
    (hA' : expand A (n - i) = some A') :
    localSuffix B c = (if isQMat sd a then shift sd.r ((i - 1) * period sd) (localSuffix A a)
      else shift sd.r (i * period sd) (localSuffix A' a)) := by sorry

-- T3.2i: the local suffix at the head of layer `i` is the shifted remaining iterate
-- `τ_{i−1}(F^{n−i+1}(∅))`
theorem localSuffix_head {A B : Forest} {sd : StopData} {rd : RootData} {n i : Nat} {c : ColAddr}
    (hL : InL A) (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) (hB : expand A n = some B) (hi : 1 ≤ i ∧ i ≤ n)
    (hc : phaseCol sd rd i rd.col = some c) :
    localSuffix B c = shift sd.r ((i - 1) * period sd) ((kernel A sd rd)^[n - i + 1] Tree.empty) := by
  sorry

-- T3.2l (txt:345-349): a changed continuation is smaller than its complete prototype, with its
-- first difference at the old terminal
theorem localSuffix_cont_le {A A' : Forest} {sd : StopData} {rd : RootData} {n : Nat} {a : ColAddr}
    (hL : InL A) (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) (hA' : expand A n = some A') (ha : IsTmplCol A sd rd a ∨ a = rd.col) :
    localSuffix A' a ≤ localSuffix A a ∧ (OnHoleRoute sd a ∨ a = rd.col ∧ rd.owner = true →
      localSuffix A' a < localSuffix A a) := by sorry

/-! T3.2j helpers: first-parent paths. -/

/-- Under V and A every `g_W` path is a `g_∅` path (path nesting with `∅ ≤ W`). -/
theorem spx_path_nil {E : Forest} {ks : KeySys} (hV : CondV E) (hA : CondAK E ks) {c : ColAddr}
    {W : List (WithTop Key)} (hW : W.Pairwise fun x y => y ≤ x) {s t : Nat}
    (h : Path E ks c W s t) : Path E ks c [] s t :=
  path_replace hV (fun _ _ _ he => path_nesting hV hA c List.Pairwise.nil hW (nil_le_list W) he) h

/-- A `g_∅` edge from `x` reads the first parent of the column numbered `x`, and that first parent
is a `g_∅` ancestor of `x - 1` (A at entry `0`). -/
theorem spx_edge_nil {E : Forest} (hV : CondV E) (hA : CondA E) {c : ColAddr} {x y : Nat}
    (h : Edge E (actualKeys E) c [] x y) : Path E (actualKeys E) c [] (x - 1) y := by
  obtain ⟨o, ho, hr⟩ := h
  rw [resp_eq_parents, cursor_nil_right] at hr
  have hoE : o ∈ E.colAddrs := mem_colAddrs_of_parents hr
  have h0 := hA o hoE 0 y hr
  simp only [if_true, cutQuery_zero] at h0
  have hox : o.num 0 = x := ColAddr.resolve_num ho
  have hlt : y < o.num 0 := parent_lt_num hV hr
  rw [hox] at h0 hlt
  exact (path_congr_stack hV (fun q hq => ColAddr.resolve_of_resolve_lt ho hq) (by omega)).1 h0

-- T3.2j (txt:337-340): every body column on the stopping column's stack lies in the subtree of
-- `r`, is nonempty and has first parent at least `r`
theorem body_firstParent {A : Forest} {sd : StopData} (hL : InL A) (hk : stepKind A = some .ordinary)
    (hsd : stopData A = some sd) {x : Nat} (hx1 : sd.r < x) (hx2 : x < sd.t) {o : ColAddr}
    (ho : sd.col.resolve 0 x = some o) :
    ∃ q H rest, A.colAt o = some ((q, H) :: rest) ∧ sd.r ≤ q := by
  obtain ⟨hV, -, -, hA, -⟩ := hL
  obtain ⟨hcol, -, ht, -, -, -⟩ := stopData_spec hsd
  set c := sd.col
  have hcE : c ∈ A.colAddrs := (Tree.mem_colAddrs_iff A c).2 (by rw [hcol]; rfl)
  have hpar : parents A c = (sd.Q ++ [(sd.r, Tree.empty)]).map Prod.fst := by
    simp [parents, hcol]
  -- the A tests of the stopping column chain `t - 1` down to `r`
  have hchain : ∀ (i p : Nat), (parents A c)[i]? = some p → Path A (actualKeys A) c [] (sd.t - 1) p := by
    intro i
    induction i with
    | zero =>
      intro p hp
      have h0 := hA c hcE 0 p hp
      simp only [if_true, cutQuery_zero] at h0
      rw [ht]; exact h0
    | succ i ih =>
      intro p hp
      have hlt : i < (parents A c).length := by
        have := (List.getElem?_eq_some_iff.1 hp).1; omega
      obtain ⟨p', hp'⟩ : ∃ p', (parents A c)[i]? = some p' := ⟨_, List.getElem?_eq_getElem hlt⟩
      have h1 := hA c hcE (i + 1) p hp
      simp only [Nat.add_one_ne_zero, if_false, Nat.add_sub_cancel, hp', Option.getD_some] at h1
      exact (ih p' hp').trans (spx_path_nil hV hA (cutQuery_noninc _ _) h1)
  have hbase : Path A (actualKeys A) c [] (sd.t - 1) sd.r :=
    hchain sd.Q.length sd.r (by rw [hpar]; simp)
  -- downward induction: `r` is a `g_∅` ancestor of every `x` with `r ≤ x < t`
  have key : ∀ n x, x + n = sd.t - 1 → sd.r ≤ x → Path A (actualKeys A) c [] x sd.r := by
    intro n
    induction n with
    | zero => intro x hx _; rw [show x = sd.t - 1 by omega]; exact hbase
    | succ n ih =>
      intro x hx hrx
      rcases Relation.ReflTransGen.cases_head (ih (x + 1) (by omega) (by omega)) with h | ⟨y, hxy, hyr⟩
      · omega
      · have := spx_edge_nil hV hA hxy
        simp only [Nat.add_sub_cancel] at this
        exact this.trans hyr
  have hxr := key (sd.t - 1 - x) x (by omega) (le_of_lt hx1)
  rcases Relation.ReflTransGen.cases_head hxr with h | ⟨y, hxy, hyr⟩
  · omega
  · obtain ⟨o', ho', hr⟩ := hxy
    rw [ho, Option.some.injEq] at ho'
    subst ho'
    rw [resp_eq_parents, cursor_nil_right, parents_getElem?] at hr
    obtain ⟨⟨q, H⟩, he, rfl⟩ := Option.map_eq_some_iff.1 hr
    obtain ⟨col, hcol', hc0⟩ := Tree.colAt_of_entryAt he
    obtain ⟨⟨q', H'⟩, rest, rfl⟩ : ∃ x rest, col = x :: rest := by
      cases col with
      | nil => simp at hc0
      | cons x rest => exact ⟨x, rest, rfl⟩
    simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hc0
    obtain ⟨rfl, rfl⟩ := hc0
    exact ⟨q', H', rest, hcol', path_le hV hyr⟩


/-! T3.2c helpers: the structure of the budgeted walk `spF` behind `safePrefix`. -/

theorem spx_spF_snd_le (k : Nat) (T : Forest) : (spF k T).2 ≤ k := by
  rw [(spF_spec 0 k T).2]; omega

/-- A walk that leaves budget unused keeps the whole forest. -/
theorem spx_spF_full {k : Nat} {T : Forest} (h : (spF k T).2 ≠ 0) : (spF k T).1 = T := by
  rw [(spF_spec 0 k T).2] at h
  exact safePrefix_of_le (by unfold mu word; omega)

theorem spx_spLater_snd_le : ∀ (k : Nat) (col : Column), (spLater k col).2 ≤ k
  | k, [] => by simp [spLater]
  | k, (p, h) :: rest => by
    by_cases hk : k = 0
    · simp [spLater, hk]
    · simp only [spLater, hk, if_false]
      have := spx_spLater_snd_le (spF (k - 1) h).2 rest
      have := spx_spF_snd_le (k - 1) h
      omega

theorem spx_spCol_snd_le : ∀ (k : Nat) (col : Column), (spCol k col).2 ≤ k - 1
  | k, [] => by simp [spCol]
  | k, (p, h) :: rest => by
    simp only [spCol]
    have := spx_spLater_snd_le (spF (k - 1) h).2 rest
    have := spx_spF_snd_le (k - 1) h
    omega

theorem spx_spLater_get : ∀ (k : Nat) (col : Column) (i p : Nat) (h' : Forest),
    (spLater k col).1[i]? = some (p, h') →
      ∃ h k', col[i]? = some (p, h) ∧ h' = (spF k' h).1 ∧ k' < k
  | k, [], i, p, h', hi => by simp [spLater] at hi
  | k, (q, h) :: rest, i, p, h', hi => by
    by_cases hk : k = 0
    · simp [spLater, hk] at hi
    · simp only [spLater, hk, if_false] at hi
      cases i with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hi
        obtain ⟨rfl, rfl⟩ := hi
        exact ⟨h, k - 1, rfl, rfl, by omega⟩
      | succ i =>
        rw [List.getElem?_cons_succ] at hi
        obtain ⟨h₀, k', h1, h2, h3⟩ := spx_spLater_get _ rest i p h' hi
        have := spx_spF_snd_le (k - 1) h
        exact ⟨h₀, k', by simpa using h1, h2, by omega⟩

theorem spx_spCol_get {k : Nat} (hk : 1 ≤ k) {col : Column} {i p : Nat} {h' : Forest}
    (hi : (spCol k col).1[i]? = some (p, h')) :
    ∃ h k', col[i]? = some (p, h) ∧ h' = (spF k' h).1 ∧ k' < k := by
  cases col with
  | nil => simp [spCol] at hi
  | cons x rest =>
    obtain ⟨q, h⟩ := x
    simp only [spCol] at hi
    cases i with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hi
      obtain ⟨rfl, rfl⟩ := hi
      exact ⟨h, k - 1, rfl, rfl, by omega⟩
    | succ i =>
      rw [List.getElem?_cons_succ] at hi
      obtain ⟨h₀, k', h1, h2, h3⟩ := spx_spLater_get _ rest i p h' hi
      have := spx_spF_snd_le (k - 1) h
      exact ⟨h₀, k', by simpa using h1, h2, by omega⟩

theorem spx_spCols_get : ∀ (k : Nat) (cols : List Column) (j : Nat) (col' : Column),
    (spCols k cols).1[j]? = some col' →
      ∃ col k', cols[j]? = some col ∧ col' = (spCol k' col).1 ∧ 1 ≤ k' ∧ k' ≤ k
  | k, [], j, col', hj => by simp [spCols] at hj
  | k, c :: rest, j, col', hj => by
    by_cases hk : k = 0
    · simp [spCols, hk] at hj
    · simp only [spCols, hk, if_false] at hj
      cases j with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq] at hj
        exact ⟨c, k, rfl, hj.symm, by omega, le_rfl⟩
      | succ j =>
        rw [List.getElem?_cons_succ] at hj
        obtain ⟨col, k', h1, h2, h3, h4⟩ := spx_spCols_get _ rest j col' hj
        have := spx_spCol_snd_le k c
        exact ⟨col, k', by simpa using h1, h2, h3, by omega⟩

/-- In a kept column, every entry followed by a kept entry keeps its whole height. -/
theorem spx_spLater_full : ∀ (k : Nat) (col : Column) (i : Nat),
    ((spLater k col).1[i + 1]?).isSome → (spLater k col).1[i]? = col[i]?
  | k, [], i, hi => by simp [spLater] at hi
  | k, (q, h) :: rest, i, hi => by
    by_cases hk : k = 0
    · simp [spLater, hk] at hi
    · simp only [spLater, hk, if_false] at hi ⊢
      cases i with
      | zero =>
        simp only [List.getElem?_cons_zero, List.getElem?_cons_succ] at hi ⊢
        have hne : (spF (k - 1) h).2 ≠ 0 := by
          intro h0; rw [h0] at hi
          cases rest with
          | nil => simp [spLater] at hi
          | cons y ys => simp [spLater] at hi
        rw [spx_spF_full hne]
      | succ i =>
        simp only [List.getElem?_cons_succ] at hi ⊢
        exact spx_spLater_full _ rest i hi

theorem spx_spCol_full {k : Nat} {col : Column} {i : Nat}
    (hi : ((spCol k col).1[i + 1]?).isSome) : (spCol k col).1[i]? = col[i]? := by
  cases col with
  | nil => simp [spCol] at hi
  | cons x rest =>
    obtain ⟨q, h⟩ := x
    simp only [spCol] at hi ⊢
    cases i with
    | zero =>
      simp only [List.getElem?_cons_zero, List.getElem?_cons_succ] at hi ⊢
      have hne : (spF (k - 1) h).2 ≠ 0 := by
        intro h0; rw [h0] at hi
        cases rest with
        | nil => simp [spLater] at hi
        | cons y ys => simp [spLater] at hi
      rw [spx_spF_full hne]
    | succ i =>
      simp only [List.getElem?_cons_succ] at hi ⊢
      exact spx_spLater_full _ rest i hi

/-- Forests of a safe prefix are safe prefixes of the forests at the same path, with a smaller
budget below the outer level. -/
theorem spx_forestAt : ∀ (π : List (Nat × Nat)) (T : Forest) (k : Nat) (F' : Forest),
    (spF k T).1.forestAt π = some F' →
      ∃ F k', T.forestAt π = some F ∧ F' = (spF k' F).1 ∧ k' ≤ k ∧ (π ≠ [] → k' < k)
  | [], T, k, F', h => by
    simp only [Tree.forestAt, Option.some.injEq] at h
    exact ⟨T, k, rfl, h.symm, le_rfl, fun h => absurd rfl h⟩
  | (a, b) :: π, .node cols, k, F', h => by
    rw [spF, Tree.forestAt_cons] at h
    simp only [Tree.cols, Option.bind_eq_some_iff] at h
    obtain ⟨x, ⟨col', hcol', hx⟩, hF⟩ := h
    obtain ⟨col, k₁, hcol, rfl, hk₁, hk₁'⟩ := spx_spCols_get k cols a col' hcol'
    obtain ⟨p, h'⟩ := x
    obtain ⟨h, k₂, hh, rfl, hk₂⟩ := spx_spCol_get hk₁ hx
    obtain ⟨F, k₃, hF1, hF2, hk₃, -⟩ := spx_forestAt π h k₂ F' hF
    refine ⟨F, k₃, ?_, hF2, by omega, fun _ => by omega⟩
    rw [Tree.forestAt_cons]
    simp only [Tree.cols, hcol, Option.bind_some, hh]
    exact hF1

theorem spx_colAt {T : Forest} {k : Nat} {c : ColAddr} {col' : Column}
    (h : (spF k T).1.colAt c = some col') :
    ∃ col k', T.colAt c = some col ∧ col' = (spCol k' col).1 ∧ 1 ≤ k' ∧ k' ≤ k ∧
      (c.path ≠ [] → k' < k) := by
  rw [Tree.colAt, Option.bind_eq_some_iff] at h
  obtain ⟨F', hF', hc⟩ := h
  obtain ⟨F, k₁, hF, rfl, hk₁, hk₁'⟩ := spx_forestAt c.path T k F' hF'
  obtain ⟨cols⟩ := F
  rw [spF] at hc
  obtain ⟨col, k₂, hcol, rfl, hk₂, hk₂'⟩ := spx_spCols_get k₁ cols c.col col' hc
  refine ⟨col, k₂, ?_, rfl, hk₂, by omega, fun hp => by have := hk₁' hp; omega⟩
  rw [Tree.colAt, hF]; exact hcol

theorem spx_entryAt {T : Forest} {k : Nat} {e : EntryAddr} {p : Nat} {h' : Forest}
    (h : (spF k T).1.entryAt e = some (p, h')) :
    ∃ h k', T.entryAt e = some (p, h) ∧ h' = (spF k' h).1 ∧ k' < k := by
  rw [Tree.entryAt, Option.bind_eq_some_iff] at h
  obtain ⟨col', hc', hi⟩ := h
  obtain ⟨col, k₁, hcol, rfl, hk₁, hk₁', -⟩ := spx_colAt hc'
  obtain ⟨H, k₂, hH, rfl, hk₂⟩ := spx_spCol_get hk₁ hi
  exact ⟨H, k₂, by rw [Tree.entryAt, hcol]; exact hH, rfl, by omega⟩

theorem spx_spF_empty (k : Nat) : (spF k (Tree.empty : Forest)).1 = Tree.empty := by
  simp [Tree.empty, spF, spCols]

-- T3.2c (txt:311-312): safe prefixes keep V, I, H
theorem safePrefix_condV {E : Forest} (hV : CondV E) (k : Nat) : CondV (safePrefix E k) := by
  intro e _ p h' he
  obtain ⟨h, -, hE, -, -⟩ := spx_entryAt he
  exact hV e ((Tree.mem_entryAddrs_iff E e).2 (by rw [hE]; rfl)) p h hE

theorem safePrefix_condI {E : Forest} (hI : CondI E) (k : Nat) : CondI (safePrefix E k) := by
  intro e _ p h' he hne col' hcol'
  obtain ⟨h, k', hE, rfl, -⟩ := spx_entryAt he
  obtain ⟨hcols⟩ := h
  have hne' : Tree.node hcols ≠ Tree.empty := by
    intro h0; apply hne; rw [h0]; exact spx_spF_empty k'
  rw [spF] at hcol'
  obtain ⟨j, hj⟩ := List.mem_iff_getElem?.1 hcol'
  obtain ⟨col, k₂, hcol, rfl, hk₂, -⟩ := spx_spCols_get k' hcols j col' hj
  obtain ⟨q, H, rest, rfl, hq⟩ := hI e ((Tree.mem_entryAddrs_iff E e).2 (by rw [hE]; rfl)) p _ hE
    hne' col (List.mem_of_getElem? hcol)
  exact ⟨q, (spF (k₂ - 1) H).1, (spLater (spF (k₂ - 1) H).2 rest).1, by rw [spCol], hq⟩

theorem safePrefix_condH {E : Forest} (hH : CondH E) (k : Nat) : CondH (safePrefix E k) := by
  intro c hc i x y hx hy
  obtain ⟨col', hcol'⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff _ c).1 hc)
  change (spF k E).1.colAt c = some col' at hcol'
  change (((spF k E).1.colAt c).getD [])[i]? = some x at hx
  change (((spF k E).1.colAt c).getD [])[i + 1]? = some y at hy
  rw [hcol', Option.getD_some] at hx hy
  obtain ⟨col, k', hcol, rfl, hk', -⟩ := spx_colAt hcol'
  have hxi := spx_spCol_full (k := k') (col := col) (i := i) (by rw [hy]; rfl)
  rw [hx] at hxi
  obtain ⟨Y, k₂, hY, hYy, -⟩ := spx_spCol_get hk' hy
  have hle := hH c ((Tree.mem_colAddrs_iff E c).2 (by rw [hcol]; rfl)) i x (y.1, Y)
    (by rw [hcol]; exact hxi.symm) (by rw [hcol]; exact hY)
  rcases hle with hlt | ⟨heq, hle⟩
  · exact Or.inl hlt
  · refine Or.inr ⟨heq, le_trans ?_ hle⟩
    rw [hYy]; exact safePrefix_le Y k₂


/-! T3.2d helpers: key order as word order, truncated keys, entries below a height. -/

/-- A strict comparison survives truncating the smaller list strictly earlier. -/
theorem spx_take_lt_take {α : Type} [LinearOrder α] :
    ∀ (Y X : List α) (k₁ k₀ : Nat), Y < X → k₁ < k₀ → Y.take k₁ < X.take k₀
  | _, _, _, 0, _, hk => absurd hk (Nat.not_lt_zero _)
  | _, [], _, _ + 1, h, _ => absurd h (List.not_lt_nil _)
  | [], x :: xs, _, k₀ + 1, _, _ => by simp
  | _ :: _, x :: xs, 0, k₀ + 1, _, _ => by simp
  | y :: ys, x :: xs, k₁ + 1, k₀ + 1, h, hk => by
    rw [List.take_succ_cons, List.take_succ_cons, List.cons_lt_cons_iff]
    rcases List.cons_lt_cons_iff.1 h with h₁ | ⟨h₁, h₂⟩
    · exact Or.inl h₁
    · exact Or.inr ⟨h₁, spx_take_lt_take ys xs k₁ k₀ h₂ (by omega)⟩

/-- Key comparison is comparison of generic words over `Bool ×ₗ Nat`. -/
theorem spx_key_lt_iff (X Y : Key) :
    X < Y ↔ @gword (Lex (Bool × Nat)) X < @gword (Lex (Bool × Nat)) Y :=
  (gword_lt_iff (α := Lex (Bool × Nat)) X Y).symm

/-- The generic word of the key of a safe prefix is the truncated generic word. -/
theorem spx_gword_relKey_safePrefix (a k : Nat) (H : Forest) :
    @gword (Lex (Bool × Nat)) (relKey a (safePrefix H k)) =
      (@gword (Lex (Bool × Nat)) (relKey a H)).take k := by
  change (gword (relKey a (safePrefix H k)) : List (GAtom (Bool × Nat))) =
      (gword (relKey a H) : List (GAtom (Bool × Nat))).take k
  rw [relKey_eq_map, relKey_eq_map, gword_map, gword_map, gword_eq_map_word, gword_eq_map_word,
    word_safePrefix, List.map_take, List.map_take]

/-- T3.2b in key form: truncating the lower height strictly before the upper one keeps `<`. -/
theorem spx_relKey_safePrefix_lt {a b : Nat} {H J : Forest} (h : relKey b J < relKey a H)
    {k₁ k₀ : Nat} (hk : k₁ < k₀) : relKey b (safePrefix J k₁) < relKey a (safePrefix H k₀) := by
  rw [spx_key_lt_iff] at h ⊢
  rw [spx_gword_relKey_safePrefix, spx_gword_relKey_safePrefix]
  exact spx_take_lt_take (α := GAtom (Lex (Bool × Nat))) _ _ _ _ h hk

theorem spx_entryAt_append (t : Forest) (π ρ : List (Nat × Nat)) (j i : Nat) :
    t.entryAt ⟨⟨π ++ ρ, j⟩, i⟩ = (t.forestAt π).bind fun F => F.entryAt ⟨⟨ρ, j⟩, i⟩ := by
  simp only [Tree.entryAt, Tree.colAt, Tree.forestAt_append, Option.bind_assoc]

/-- An entry inside the height of `e0` is read in that height. -/
theorem spx_entryAt_inside (t : Forest) (e0 : EntryAddr) (ρ : List (Nat × Nat)) (j i : Nat) :
    t.entryAt ⟨⟨e0.heightPath ++ ρ, j⟩, i⟩ =
      (t.heightAt e0).bind fun F => F.entryAt ⟨⟨ρ, j⟩, i⟩ := by
  rw [spx_entryAt_append, Tree.forestAt_heightPath]

-- T3.2d (txt:308-311): safe prefixes keep S (containment offsets + word fact)
theorem safePrefix_condS {E : Forest} (hV : CondV E) (hS : CondS E) (k : Nat) :
    CondS (safePrefix E k) := by
  intro e0 he0 e he hret
  obtain ⟨⟨ρ, hρ⟩, q, J', hJ', hres⟩ := hret
  obtain ⟨⟨P, j⟩, i⟩ := e
  dsimp only at hρ
  subst hρ
  obtain ⟨x0, hx0⟩ := Option.isSome_iff_exists.1 ((Tree.mem_entryAddrs_iff _ e0).1 he0)
  obtain ⟨p0, H'⟩ := x0
  obtain ⟨H, k₀, hH, rfl, -⟩ := spx_entryAt (k := k) (T := E) hx0
  have hJ'' := hJ'
  rw [spx_entryAt_inside, Tree.heightAt, hx0] at hJ''
  simp only [Option.map_some, Option.bind_some] at hJ''
  obtain ⟨J, k₁, hJ, rfl, hk⟩ := spx_entryAt hJ''
  have hEe : E.entryAt ⟨⟨e0.heightPath ++ ρ, j⟩, i⟩ = some (q, J) := by
    rw [spx_entryAt_inside, Tree.heightAt, hH]; simpa using hJ
  have hret : IsOwnerReturn E e0 ⟨⟨e0.heightPath ++ ρ, j⟩, i⟩ := ⟨⟨ρ, rfl⟩, q, J, hEe, hres⟩
  have hSE := hS e0 ((Tree.mem_entryAddrs_iff E e0).2 (by rw [hH]; rfl)) _
    ((Tree.mem_entryAddrs_iff E _).2 (by rw [hEe]; rfl)) hret
  rw [Tree.heightAt, Tree.heightAt, hEe, hH] at hSE
  rw [Tree.heightAt, Tree.heightAt, hJ', hx0]
  exact spx_relKey_safePrefix_lt hSE hk


/-! T3.2e helpers: complete columns of a safe prefix, and capped cursors. -/

/-- A column walk that leaves budget unused keeps the whole column. -/
theorem spx_spCol_full_of {k : Nat} (hk : k ≠ 0) {col : Column} (h : (spCol k col).2 ≠ 0) :
    (spCol k col).1 = col := by
  have h2 : (spF k (Tree.node [col])).2 ≠ 0 := by simpa [spF, spCols, hk] using h
  have := spx_spF_full h2
  simp only [spF, spCols, hk, if_false, Tree.node.injEq] at this
  simpa using this

/-- In a safe prefix, a column followed by a kept column is complete. -/
theorem spx_spCols_full : ∀ (k : Nat) (cols : List Column) (j : Nat),
    ((spCols k cols).1[j + 1]?).isSome → (spCols k cols).1[j]? = cols[j]?
  | k, [], j, h => by simp [spCols] at h
  | k, c :: rest, j, h => by
    by_cases hk : k = 0
    · simp [spCols, hk] at h
    · simp only [spCols, hk, if_false] at h ⊢
      cases j with
      | zero =>
        simp only [List.getElem?_cons_zero, List.getElem?_cons_succ] at h ⊢
        have hne : (spCol k c).2 ≠ 0 := by
          intro h0; rw [h0] at h
          cases rest with
          | nil => simp [spCols] at h
          | cons y ys => simp [spCols] at h
        rw [spx_spCol_full_of hk hne]
      | succ j =>
        simp only [List.getElem?_cons_succ] at h ⊢
        exact spx_spCols_full _ rest j h

/-- In a kept column, all entries before a kept entry are complete. -/
theorem spx_spCol_prefix {k : Nat} {col : Column} {v : Nat} (hv : v < (spCol k col).1.length) :
    (spCol k col).1.take v = col.take v := by
  apply List.ext_getElem?
  intro j
  rw [List.getElem?_take, List.getElem?_take]
  split_ifs with hj
  · exact spx_spCol_full (by rw [List.getElem?_eq_getElem (by omega)]; rfl)
  · rfl

/-- Kept entries keep their parents. -/
theorem spx_spCol_fst {k : Nat} (hk : 1 ≤ k) {col : Column} {j : Nat}
    (hj : j < (spCol k col).1.length) :
    ((spCol k col).1[j]?).map Prod.fst = (col[j]?).map Prod.fst := by
  obtain ⟨⟨p, h'⟩, hx⟩ : ∃ x, (spCol k col).1[j]? = some x := ⟨_, List.getElem?_eq_getElem hj⟩
  obtain ⟨h, -, hh, -, -⟩ := spx_spCol_get hk hx
  rw [hx, hh]; rfl

/-- Every column of a safe prefix is complete or a route column of the prefix. -/
theorem spx_complete_or_route : ∀ (P : List (Nat × Nat)) (T : Forest) (k j : Nat),
    ((spF k T).1.colAt ⟨P, j⟩).isSome →
      (spF k T).1.colAt ⟨P, j⟩ = T.colAt ⟨P, j⟩ ∨ (⟨P, j⟩ : ColAddr) ∈ routeCols (spF k T).1
  | [], .node cols, k, j, h => by
    rw [spF] at h ⊢
    simp only [Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols] at h ⊢
    by_cases hj : j + 1 < (spCols k cols).1.length
    · exact Or.inl (spx_spCols_full k cols j (by rw [List.getElem?_eq_getElem hj]; rfl))
    · right
      rw [mem_routeCols_iff]
      refine ⟨fun d hd => absurd hd (Nat.not_lt_zero _), _, rfl, ?_⟩
      have := (Option.isSome_iff_exists.1 h)
      obtain ⟨x, hx⟩ := this
      have := (List.getElem?_eq_some_iff.1 hx).1
      simp only [Tree.cols]; omega
  | (a, b) :: P, .node cols, k, j, h => by
    rw [spF] at h ⊢
    rw [Tree.colAt_cons] at h
    simp only [Tree.cols] at h
    obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 h
    rw [Option.bind_eq_some_iff] at hx
    obtain ⟨⟨p, h'⟩, hab, hP⟩ := hx
    rw [Option.bind_eq_some_iff] at hab
    obtain ⟨colA', hA', hb'⟩ := hab
    obtain ⟨colA, k₁, hA, rfl, hk₁, -⟩ := spx_spCols_get k cols a colA' hA'
    obtain ⟨h₀, k₂, hb, rfl, -⟩ := spx_spCol_get hk₁ hb'
    have e1 : (Tree.node (spCols k cols).1).colAt ⟨(a, b) :: P, j⟩ =
        (spF k₂ h₀).1.colAt ⟨P, j⟩ := by
      rw [Tree.colAt_cons]; simp [Tree.cols, hA', hb']
    have e2 : (Tree.node cols).colAt ⟨(a, b) :: P, j⟩ = h₀.colAt ⟨P, j⟩ := by
      rw [Tree.colAt_cons]; simp [Tree.cols, hA, hb]
    have hfa : (Tree.node (spCols k cols).1).forestAt [(a, b)] = some (spF k₂ h₀).1 := by
      rw [Tree.forestAt_cons]; simp [Tree.cols, hA', hb', Tree.forestAt]
    rw [e1, e2]
    rcases spx_complete_or_route P h₀ k₂ j (by rw [hP]; rfl) with hc | hr
    · exact Or.inl hc
    · by_cases hlast : a + 1 = (spCols k cols).1.length ∧ b + 1 = (spCol k₁ colA).1.length
      · right
        rw [mem_routeCols_iff] at hr ⊢
        obtain ⟨hrp, F, hF, hFl⟩ := hr
        refine ⟨isRoutePath_cons.2 ⟨?_, _, hfa, hrp⟩, F, ?_, hFl⟩
        · have hne : (spCol k₁ colA).1 ≠ [] := by
            intro h0; rw [h0] at hlast; simp at hlast
          simp only [Tree.lastStep?, Tree.cols]
          rw [List.getLast?_eq_getElem?, show (spCols k cols).1.length - 1 = a by omega, hA',
            Option.bind_some]
          simp only [List.isEmpty_eq_false_iff.2 hne, if_false, Bool.false_eq_true]
          congr 2; omega
        · rw [Tree.forestAt_cons]; simp [Tree.cols, hA', hb', hF]
      · left
        have hfull : (spF k₂ h₀).1 = h₀ := by
          have haL : a < (spCols k cols).1.length := (List.getElem?_eq_some_iff.1 hA').1
          have hbL : b < (spCol k₁ colA).1.length := (List.getElem?_eq_some_iff.1 hb').1
          by_cases ha : a + 1 < (spCols k cols).1.length
          · have hf := spx_spCols_full k cols a (by rw [List.getElem?_eq_getElem ha]; rfl)
            rw [hA', hA] at hf
            have hf' := Option.some.inj hf
            rw [hf', hb] at hb'
            exact (Prod.mk.inj (Option.some.inj hb')).2.symm
          · have hb2 : b + 1 < (spCol k₁ colA).1.length := by omega
            have hf := spx_spCol_full (k := k₁) (col := colA) (i := b)
              (by rw [List.getElem?_eq_getElem hb2]; rfl)
            rw [hb', hb] at hf
            exact (Prod.mk.inj (Option.some.inj hf)).2
        rw [hfull]

/-- A reduced `⊤`-free query below the boundary of entry `v` has the same cursor in a source that
agrees with `ks` through entry `v`, or agrees before `v` and ends at `v` with `⊤`. -/
theorem spx_cursor_capped {ks ks' W : List (WithTop Key)} {v : Nat} (hv : v < ks.length)
    (hW : W.Pairwise fun x y => y ≤ x) (hT : ∀ y ∈ W, y ≠ ⊤) (hlt : W < cutQuery ks (v + 1))
    (hks : ks' = ks.take v ++ [⊤] ∨ (v < ks'.length ∧ ks'.take (v + 1) = ks.take (v + 1))) :
    cursor ks' W = cursor ks W := by
  rcases hks with rfl | ⟨hv', htk⟩
  · exact ((cursor_cappedAt ks W v hv hW hT hlt).2).symm
  · have hc := cursor_le_of_lt_cutQuery hW hv hlt
    have hlt' : W < cutQuery ks' (v + 1) := by
      unfold cutQuery at hlt ⊢; rw [htk]; exact hlt
    have hc' := cursor_le_of_lt_cutQuery hW hv' hlt'
    have e1 := cursor_take ks' W (v + 1)
    have e2 := cursor_take ks W (v + 1)
    rw [htk] at e1
    omega

-- T3.2e (txt:312-313): safe prefixes keep A (barrier + capping)
theorem safePrefix_condA {E : Forest} (hL : InL E) (k : Nat) : CondA (safePrefix E k) := by
  obtain ⟨hV, -, -, hA, hS⟩ := hL
  have hV' : CondV (safePrefix E k) := safePrefix_condV hV k
  have hS' : CondS (safePrefix E k) := safePrefix_condS hV hS k
  refine capping_reverse hV' hS' (sel := routeCols (safePrefix E k)) (fun a ha => ha) ?_
  rw [condAK_iff]
  intro c hc i p hp
  -- the column of `c` in the prefix
  obtain ⟨col', hcol'⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff _ c).1 hc)
  obtain ⟨col, k₁, hcol, rfl, hk₁, -, -⟩ := spx_colAt (k := k) (T := E) hcol'
  have hcE : c ∈ E.colAddrs := (Tree.mem_colAddrs_iff E c).2 (by rw [hcol]; rfl)
  have hpar : ∀ j, j < (spCol k₁ col).1.length →
      (parents (safePrefix E k) c)[j]? = (parents E c)[j]? := by
    intro j hj
    simp only [parents, List.getElem?_map]
    rw [hcol', hcol, Option.getD_some, Option.getD_some]
    exact spx_spCol_fst hk₁ hj
  have hiL : i < (spCol k₁ col).1.length := by
    have := (List.getElem?_eq_some_iff.1 hp).1
    simp only [parents, hcol', Option.getD_some, List.length_map] at this; exact this
  have hpE : (parents E c)[i]? = some p := by rw [← hpar i hiL]; exact hp
  have hiE : i < col.length := by
    have := (List.getElem?_eq_some_iff.1 hpE).1; simpa [parents, hcol] using this
  have hstart : cutStart (safePrefix E k) c i = cutStart E c i := by
    unfold cutStart
    split_ifs with h0
    · rfl
    · rw [hpar (i - 1) (by omega)]
  -- the query
  have hgk : ∀ (o : ColAddr) (colo : Column) (k₂ n : Nat), (safePrefix E k).colAt o =
      some (spCol k₂ colo).1 → E.colAt o = some colo →
      (spCol k₂ colo).1.take n = colo.take n →
      (actualKeys (safePrefix E k) o).take n = (actualKeys E o).take n := by
    intro o colo k₂ n h1 h2 h3
    simp only [actualKeys, h1, h2, Option.getD_some, ← List.map_take, h3]
  have hW : cutQuery (capKeys (safePrefix E k) (routeCols (safePrefix E k)) c) i =
      cutQuery (actualKeys E c) i := by
    rw [cutQuery_capKeys _ _ c (by rw [hcol']; simpa using hiL)]
    unfold cutQuery
    rw [hgk c col k₁ i hcol' hcol (spx_spCol_prefix hiL)]
  have hAE := (condAK_iff _ _).1 hA c hcE i p hpE
  rw [hW, hstart]
  set W := cutQuery (actualKeys E c) i with hWdef
  have hWn : W.Pairwise fun x y => y ≤ x := cutQuery_noninc _ _
  have hWT : ∀ y ∈ W, y ≠ ⊤ := by
    intro y hy
    have hy' := ((nu_sublist _).trans (List.take_sublist _ _)).subset hy
    simp only [actualKeys, List.mem_map] at hy'
    obtain ⟨_, -, rfl⟩ := hy'
    exact WithTop.coe_ne_top
  have hent : (⟨c, i⟩ : EntryAddr) ∈ (safePrefix E k).entryAddrs := by
    rw [Tree.mem_entryAddrs_iff, Tree.entryAt]
    rw [hcol', Option.bind_some, List.getElem?_eq_getElem hiL]; rfl
  -- transfer of the actual path of `E`, edge by edge
  have key : ∀ y, Path E (actualKeys E) c W (cutStart E c i) y →
      Path (safePrefix E k) (capKeys (safePrefix E k) (routeCols (safePrefix E k))) c W
        (cutStart E c i) y := by
    intro y h
    induction h with
    | refl => exact Relation.ReflTransGen.refl
    | @tail z y' hxz hzy ih =>
      obtain ⟨o, ho, hr⟩ := hzy
      refine ih.tail ⟨o, ho, ?_⟩
      have hoE' : ((safePrefix E k).colAt o).isSome := by
        have := (Tree.stack_mem_prefix hent).2.1 o ((ColAddr.resolve_spec 0 c o z).1 ho).1
        exact (Tree.mem_roles_ord o.path _ o.col).1 ((List.takeWhile_sublist _).subset this)
      by_cases hor : o ∈ routeCols (safePrefix E k)
      · -- a route column: a container of `c`; the barrier stops the scan at the container
        obtain ⟨v, hvE', hvc⟩ := routeCols_visible hc hor ho
        obtain ⟨colo', hcolo'⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff _ o).1
          (mem_colAddrs_of_mem_routeCols hor))
        obtain ⟨colo, k₂, hcolo, rfl, hk₂, -, -⟩ := spx_colAt (k := k) (T := E) hcolo'
        have hvL : v < (spCol k₂ colo).1.length := by
          have := (Tree.mem_entryAddrs_iff _ _).1 hvE'
          rw [Tree.entryAt] at this
          rw [hcolo', Option.bind_some] at this
          obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 this
          exact (List.getElem?_eq_some_iff.1 hx).1
        obtain ⟨xv, hxv⟩ : ∃ x, (spCol k₂ colo).1[v]? = some x :=
          ⟨_, List.getElem?_eq_getElem hvL⟩
        obtain ⟨Hv, -, hHv, -, -⟩ := spx_spCol_get hk₂ hxv
        have hvo : v < colo.length := (List.getElem?_eq_some_iff.1 hHv).1
        have hvE : (⟨o, v⟩ : EntryAddr) ∈ E.entryAddrs := by
          rw [Tree.mem_entryAddrs_iff, Tree.entryAt, hcolo, Option.bind_some, hHv]; rfl
        have hz : o.num 0 = z := ColAddr.resolve_num ho
        have hbar := cut_barrier hV hA hS hvE hcE hvc (k := i)
          (by simp [parents, hcol]; omega) (by rw [hz]; exact hxz)
        dsimp only at hbar
        rw [boundary_eq_cutQuery] at hbar
        set ks := actualKeys E o with hks
        have hksL : ks.length = colo.length := by simp [hks, actualKeys, hcolo]
        have hcap : capKeys (safePrefix E k) (routeCols (safePrefix E k)) o =
            (actualKeys (safePrefix E k) o).dropLast ++ [⊤] := by
          have hne : actualKeys (safePrefix E k) o ≠ [] := by
            simp only [actualKeys]
            rw [hcolo', Option.getD_some]
            intro h0; rw [List.map_eq_nil_iff] at h0; rw [h0] at hvL; simp at hvL
          obtain ⟨y, hy⟩ := Option.ne_none_iff_exists'.1 (mt List.getLast?_eq_none_iff.1 hne)
          simp [capKeys, hor, hy]
        have hlenA : (actualKeys (safePrefix E k) o).length = (spCol k₂ colo).1.length := by
          simp only [actualKeys, List.length_map]
          rw [hcolo', Option.getD_some]
        have hcur : cursor (capKeys (safePrefix E k) (routeCols (safePrefix E k)) o) W =
            cursor ks W := by
          refine spx_cursor_capped (by omega) hWn hWT hbar ?_
          rw [hcap]
          by_cases hv1 : v + 1 = (spCol k₂ colo).1.length
          · left
            rw [List.dropLast_eq_take, hlenA, show (spCol k₂ colo).1.length - 1 = v by omega,
              hgk o colo k₂ v hcolo' hcolo (spx_spCol_prefix hvL)]
          · right
            refine ⟨by simp; omega, ?_⟩
            rw [List.take_append_of_le_length (by rw [List.length_dropLast]; omega),
              List.dropLast_eq_take, List.take_take, Nat.min_eq_left (by omega)]
            exact hgk o colo k₂ (v + 1) hcolo' hcolo (spx_spCol_prefix (by omega))
        have hm : cursor ks W ≤ v := cursor_le_of_lt_cutQuery hWn (by omega) hbar
        unfold resp at hr ⊢
        rw [hcur]
        rw [hcolo', Option.getD_some, spx_spCol_fst hk₂ (by omega)]
        rw [hcolo, Option.getD_some] at hr
        exact hr
      · -- a non-route column is complete in the prefix
        have hcomp := (spx_complete_or_route o.path E k o.col hoE').resolve_right hor
        have hcomp' : (safePrefix E k).colAt o = E.colAt o := hcomp
        unfold resp at hr ⊢
        rw [capKeys_of_not_mem hor]
        unfold actualKeys at hr ⊢
        rw [hcomp']
        exact hr
  exact key p hAE


/-! T3.2f helpers: profiles of safe prefixes, pure towers. -/

/-- The profile recursion started `e` levels deeper adds `e` to the depth. -/
theorem spx_profileAux_add (e : Nat) (d : Nat) (H : Forest) :
    profileAux (d + e) H = toLex ((ofLex (profileAux d H)).1 + e, (ofLex (profileAux d H)).2) := by
  induction d, H using profileAux.induct with
  | case1 d p rest tail => simp [profileAux]
  | case2 d p rest tail head tail_1 ih =>
    rw [profileAux, profileAux, show d + e + 1 = d + 1 + e by omega]; exact ih
  | case3 d cols hne =>
    match cols, hne with
    | [], _ => simp [profileAux]
    | [] :: cs, _ => simp [profileAux]
    | ((p, h) :: rest) :: cs, hne => exact absurd rfl (hne p h rest cs)

theorem spx_profile_node {cols : List Column} (h : cols ≠ []) :
    profile (Tree.node cols) = ((profileAux 0 (Tree.node cols) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by
  cases cols with
  | nil => exact absurd rfl h
  | cons x xs => rfl

theorem spx_profileAux_one (H : Forest) :
    profileAux 1 H = toLex ((ofLex (profileAux 0 H)).1 + 1, (ofLex (profileAux 0 H)).2) :=
  spx_profileAux_add 1 0 H

/-- A pure tower: singleton levels with parents `ps`, ending in `m` entries `(q, ∅)`. -/
def spxTower : List Nat → Nat → Nat → Forest
  | [], q, m => .node [List.replicate m (q, Tree.empty)]
  | p :: ps, q, m => .node [[(p, spxTower ps q m)]]

theorem spx_tower_ne (ps : List Nat) (q m : Nat) : (spxTower ps q m).cols ≠ [] := by
  cases ps <;> simp [spxTower, Tree.cols]

theorem spx_profileAux_cons (d p : Nat) {h : Forest} (hh : h.cols ≠ []) (rest : Column)
    (tail : List Column) :
    profileAux d (Tree.node (((p, h) :: rest) :: tail)) = profileAux (d + 1) h := by
  obtain ⟨hc⟩ := h
  cases hc with
  | nil => simp [Tree.cols] at hh
  | cons x xs => rw [profileAux]

theorem spx_eta (T : Forest) : T = Tree.node T.cols := by cases T; rfl

theorem spx_profileAux_tower : ∀ (ps : List Nat) (q m : Nat),
    profileAux 0 (spxTower ps q (m + 1)) = toLex (ps.length, m + 1)
  | [], q, m => by
    show profileAux 0 (Tree.node [((q, Tree.node []) :: List.replicate m (q, Tree.node []))]) = _
    rw [profileAux]
    have : (List.replicate m (q, (Tree.node [] : Forest))).takeWhile (fun x => x.1 == q) =
        List.replicate m (q, Tree.node []) := by
      induction m with
      | zero => rfl
      | succ m ih => simp only [List.replicate_succ, List.takeWhile_cons, beq_self_eq_true,
          if_true, ih]
    rw [this, List.length_replicate]; simp; omega
  | p :: ps, q, m => by
    simp only [spxTower]
    rw [spx_profileAux_cons 0 p (spx_tower_ne ps q (m + 1)), spx_profileAux_one,
      spx_profileAux_tower ps q m]
    simp

theorem spx_profile_tower (ps : List Nat) (q m : Nat) :
    profile (spxTower ps q (m + 1)) = ((toLex (ps.length, m + 1) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by
  rw [spx_eta (spxTower ps q (m + 1)), spx_profile_node (spx_tower_ne ps q (m + 1)), ← spx_eta]
  exact congrArg _ (spx_profileAux_tower ps q m)

theorem spx_colAt_empty (c : ColAddr) : (Tree.empty : Forest).colAt c = none := by
  obtain ⟨P, j⟩ := c
  cases P with
  | nil => simp [Tree.colAt, Tree.forestAt, Tree.empty, Tree.cols]
  | cons x xs => obtain ⟨a, b⟩ := x; simp [Tree.colAt, Tree.forestAt, Tree.empty, Tree.cols]

/-- Every column of a tower is nonempty with constant parents. -/
theorem spx_tower_col : ∀ (ps : List Nat) (q m : Nat) (ρ : List (Nat × Nat)) (j : Nat) (col : Column),
    (spxTower ps q (m + 1)).colAt ⟨ρ, j⟩ = some col →
      ∃ q₀ H₀ rest, col = (q₀, H₀) :: rest ∧ ∀ x ∈ col, x.1 = q₀
  | [], q, m, [], j, col, h => by
    simp only [spxTower, Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols] at h
    cases j with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.some.injEq] at h
      subst h
      exact ⟨q, _, _, rfl, fun x hx => by rw [(List.eq_of_mem_replicate hx)]⟩
    | succ j => simp at h
  | [], q, m, (a, b) :: ρ, j, col, h => by
    rw [Tree.colAt_cons] at h
    simp only [spxTower, Tree.cols] at h
    cases a with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.bind_some] at h
      cases hb : (List.replicate (m + 1) (q, (Tree.empty : Forest)))[b]? with
      | none => rw [hb] at h; simp at h
      | some x =>
        rw [hb, Option.bind_some] at h
        have := List.eq_of_mem_replicate (List.mem_of_getElem? hb)
        rw [this] at h
        rw [spx_colAt_empty] at h; simp at h
    | succ a => simp at h
  | p :: ps, q, m, [], j, col, h => by
    simp only [spxTower, Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols] at h
    cases j with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.some.injEq] at h
      subst h
      exact ⟨p, _, _, rfl, fun x hx => by simp at hx; rw [hx]⟩
    | succ j => simp at h
  | p :: ps, q, m, (a, b) :: ρ, j, col, h => by
    rw [Tree.colAt_cons] at h
    simp only [spxTower, Tree.cols] at h
    cases a with
    | zero =>
      cases b with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.bind_some] at h
        exact spx_tower_col ps q m ρ j col h
      | succ b => simp at h
    | succ a => simp at h

/-- The heights of the outer entries of a tower have smaller profile. -/
theorem spx_tower_outer {ps : List Nat} {q m j i q' : Nat} {J : Forest}
    (h : (spxTower ps q (m + 1)).entryAt ⟨⟨[], j⟩, i⟩ = some (q', J)) :
    profile J < profile (spxTower ps q (m + 1)) := by
  rw [spx_profile_tower]
  cases ps with
  | nil =>
    simp only [spxTower, Tree.entryAt, Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols] at h
    cases j with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.bind_some] at h
      have := List.eq_of_mem_replicate (List.mem_of_getElem? h)
      simp only [Prod.mk.injEq] at this
      rw [this.2]
      exact WithBot.bot_lt_coe _
    | succ j => simp at h
  | cons p ps =>
    simp only [spxTower, Tree.entryAt, Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols] at h
    cases j with
    | zero =>
      cases i with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.bind_some, Option.some.injEq,
          Prod.mk.injEq] at h
        rw [← h.2, spx_profile_tower]
        exact WithBot.coe_lt_coe.2 (Prod.Lex.toLex_lt_toLex.2 (Or.inl (by simp)))
      | succ i => simp at h
    | succ j => simp at h

theorem spx_spF_emptyF (k : Nat) : spF k (Tree.empty : Forest) = (Tree.empty, k) := by
  simp [Tree.empty, spF, spCols]

theorem spx_spLater_zero (col : Column) : spLater 0 col = ([], 0) := by
  cases col <;> simp [spLater]

theorem spx_spCols_zero (cols : List Column) : spCols 0 cols = ([], 0) := by
  cases cols <;> simp [spCols]

theorem spx_spLater_fst : ∀ (k : Nat) (col : Column),
    (spLater k col).1.map Prod.fst <+: col.map Prod.fst
  | k, [] => by simp [spLater]
  | k, (q, h) :: rest => by
    by_cases hk : k = 0
    · simp [spLater, hk]
    · simp only [spLater, hk, if_false, List.map_cons]
      exact (List.prefix_cons_inj _).2 (spx_spLater_fst _ rest)

theorem spx_spLater_short : ∀ (k : Nat) (col : Column),
    (spLater k col).1.length < col.length → (spLater k col).2 = 0
  | k, [] => by simp [spLater]
  | k, (q, h) :: rest => by
    by_cases hk : k = 0
    · simp [spLater, hk]
    · simp only [spLater, hk, if_false, List.length_cons]
      intro hl
      exact spx_spLater_short _ rest (by omega)

/-- Runs of a parent in a prefix of the parent list. -/
theorem spx_takeWhile_prefix (p : Nat) : ∀ (l' l : Column), l'.map Prod.fst <+: l.map Prod.fst →
    (l'.takeWhile fun x => x.1 == p).length ≤ (l.takeWhile fun x => x.1 == p).length ∧
    ((l'.takeWhile fun x => x.1 == p).length < (l.takeWhile fun x => x.1 == p).length →
      (∀ x ∈ l', x.1 = p) ∧ l'.length < l.length)
  | [], l, _ => by
    refine ⟨by simp, fun h => ⟨by simp, ?_⟩⟩
    cases l with
    | nil => simp at h
    | cons x xs => simp
  | x' :: xs', [], h => by simp at h
  | x' :: xs', x :: xs, h => by
    simp only [List.map_cons, List.cons_prefix_cons] at h
    obtain ⟨hx, h⟩ := h
    have ih := spx_takeWhile_prefix p xs' xs h
    by_cases hp : x'.1 = p
    · have hp' : x.1 = p := hx ▸ hp
      have e1 : (x' :: xs').takeWhile (fun x => x.1 == p) = x' :: xs'.takeWhile (fun x => x.1 == p) := by
        simp [hp]
      have e2 : (x :: xs).takeWhile (fun x => x.1 == p) = x :: xs.takeWhile (fun x => x.1 == p) := by
        simp [hp']
      rw [e1, e2, List.length_cons, List.length_cons]
      refine ⟨Nat.succ_le_succ ih.1, fun hl => ⟨?_, ?_⟩⟩
      · intro y hy
        rcases List.mem_cons.1 hy with rfl | hy
        · exact hp
        · exact (ih.2 (Nat.lt_of_succ_lt_succ hl)).1 y hy
      · simp only [List.length_cons]
        exact Nat.succ_lt_succ (ih.2 (Nat.lt_of_succ_lt_succ hl)).2
    · have hp' : ¬ x.1 = p := hx ▸ hp
      have e1 : (x' :: xs').takeWhile (fun x => x.1 == p) = [] := by
        simp [hp]
      have e2 : (x :: xs).takeWhile (fun x => x.1 == p) = [] := by
        simp [hp']
      rw [e1, e2]; simp

/-- Nonincreasing columns. -/
def spxNoninc (col : Column) : Prop :=
  ∀ i x y, col[i]? = some x → col[i + 1]? = some y → EntryLe y x

theorem spx_le_empty {X : Forest} (h : X ≤ Tree.empty) : X = Tree.empty := by
  by_contra hne
  exact absurd h (not_le.2 (Forest.empty_lt hne))

/-- Under H the run of the first parent after an entry with empty height has empty heights. -/
theorem spx_run_empty (p : Nat) : ∀ (rest : Column), spxNoninc ((p, Tree.empty) :: rest) →
    ∀ x ∈ rest.takeWhile (fun x => x.1 == p), x = (p, Tree.empty)
  | [], _ => by simp
  | y :: ys, h => by
    by_cases hy : y.1 = p
    · have hle := h 0 (p, Tree.empty) y rfl rfl
      have hy2 : y.2 = Tree.empty := by
        rcases hle with hlt | ⟨-, hle⟩
        · exact absurd hlt (by simp [hy])
        · exact spx_le_empty hle
      have hyy : y = (p, Tree.empty) := Prod.ext hy hy2
      have h' : spxNoninc ((p, Tree.empty) :: ys) := by
        intro i x z hx hz
        apply h (i + 1) x z
        · cases i with
          | zero => simpa [hyy] using hx
          | succ i => simpa using hx
        · simpa using hz
      intro x hx
      simp only [List.takeWhile_cons, hy, beq_self_eq_true, if_true, List.mem_cons] at hx
      rcases hx with rfl | hx
      · exact hyy
      · exact spx_run_empty p ys h' x hx
    · simp [hy]

theorem spx_condH_col {T : Forest} (hH : CondH T) {c : ColAddr} {col : Column}
    (hc : T.colAt c = some col) : spxNoninc col := by
  intro i x y hx hy
  have := hH c ((Tree.mem_colAddrs_iff T c).2 (by rw [hc]; rfl)) i x y
  rw [hc, Option.getD_some] at this
  exact this hx hy

theorem spx_colAt_append (t : Forest) (π ρ : List (Nat × Nat)) (j : Nat) :
    t.colAt ⟨π ++ ρ, j⟩ = (t.forestAt π).bind fun F => F.colAt ⟨ρ, j⟩ := by
  simp only [Tree.colAt, Tree.forestAt_append, Option.bind_assoc]

/-- H passes to heights. -/
theorem spx_condH_height {T : Forest} (hH : CondH T) {g : EntryAddr} {G : Forest}
    (hg : T.heightAt g = some G) : CondH G := by
  intro c hc i x y hx hy
  have hcol : T.colAt ⟨g.heightPath ++ c.path, c.col⟩ = G.colAt c := by
    rw [spx_colAt_append, Tree.forestAt_heightPath, hg]; rfl
  obtain ⟨col, hcol'⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff G c).1 hc)
  rw [hcol'] at hcol hx hy
  exact spx_condH_col hH hcol i x y hx hy

/-- Profiles of safe prefixes: never larger, and when changed (and nonempty) a pure tower. -/
theorem spx_profile_sp (d : Nat) (H : Forest) : ∀ k, CondH H →
    profile (safePrefix H k) ≤ profile H ∧
      (profile (safePrefix H k) = profile H ∨
        (∃ ps q m, safePrefix H k = spxTower ps q (m + 1)) ∨ safePrefix H k = Tree.empty) := by
  induction d, H using profileAux.induct with
  | case1 d p rest tail =>
    intro k hH
    rcases Nat.eq_zero_or_pos k with rfl | hk
    · have : safePrefix (Tree.node (((p, Tree.node []) :: rest) :: tail)) 0 = Tree.empty := by
        simp [safePrefix, safePrefixBody, spF, spCols, Tree.empty]
      rw [this]; exact ⟨by simp [profile, profileBody, Tree.empty], Or.inr (Or.inr rfl)⟩
    · have hsp : safePrefix (Tree.node (((p, Tree.node []) :: rest) :: tail)) k =
          Tree.node (((p, Tree.node []) :: (spLater (k - 1) rest).1) ::
            (spCols (spLater (k - 1) rest).2 tail).1) := by
        show (spF k _).1 = _
        have := spx_spF_emptyF (k - 1)
        simp only [Tree.empty] at this
        simp only [spF, spCols, Nat.pos_iff_ne_zero.1 hk, if_false, spCol]
      rw [hsp, spx_profile_node (by simp), spx_profile_node (by simp), profileAux, profileAux]
      obtain ⟨hle, hlt⟩ := spx_takeWhile_prefix p _ rest (spx_spLater_fst (k - 1) rest)
      refine ⟨WithBot.coe_le_coe.2 (Prod.Lex.toLex_le_toLex.2 (Or.inr ⟨rfl,
        Nat.add_le_add_left hle 1⟩)), ?_⟩
      by_cases heq : ((spLater (k - 1) rest).1.takeWhile fun x => x.1 == p).length =
          (rest.takeWhile fun x => x.1 == p).length
      · left; rw [heq]
      · right; left
        obtain ⟨hall, hshort⟩ := hlt (Nat.lt_of_le_of_ne hle heq)
        have hrun := spx_run_empty p rest (spx_condH_col hH (c := ⟨[], 0⟩) rfl)
        have hb := spx_spLater_short _ _ hshort
        have hit : (spLater (k - 1) rest).1.length < (rest.takeWhile fun x => x.1 == p).length := by
          have e : ((spLater (k - 1) rest).1.takeWhile fun x => x.1 == p) =
              (spLater (k - 1) rest).1 := takeWhile_eq_self_of (fun x hx => by simp [hall x hx])
          rw [e] at hle heq; exact Nat.lt_of_le_of_ne hle heq
        have hkept : (spLater (k - 1) rest).1 =
            List.replicate (spLater (k - 1) rest).1.length (p, Tree.empty) := by
          apply List.ext_getElem (by simp)
          intro i hi _
          rw [List.getElem_replicate]
          obtain ⟨⟨q, h'⟩, hx⟩ : ∃ x, (spLater (k - 1) rest).1[i]? = some x :=
            ⟨_, List.getElem?_eq_getElem hi⟩
          obtain ⟨h₀, k', hr, rfl, -⟩ := spx_spLater_get _ _ i q h' hx
          have hq : q = p := hall _ (List.mem_of_getElem? hx)
          have hmem : (q, h₀) ∈ rest.takeWhile fun x => x.1 == p := by
            apply List.mem_of_getElem? (i := i)
            rw [List.prefix_iff_eq_take.1 (List.takeWhile_prefix _), List.getElem?_take,
              if_pos (by omega)]
            exact hr
          have := hrun _ hmem
          simp only [Prod.mk.injEq] at this
          rw [List.getElem?_eq_getElem hi] at hx
          rw [Option.some.inj hx, this.2, hq, spx_spF_emptyF]
        refine ⟨[], p, (spLater (k - 1) rest).1.length, ?_⟩
        rw [hb, spx_spCols_zero, hkept]
        simp only [spxTower, List.replicate_succ, List.length_replicate, Tree.empty]
  | case2 d p rest tail head tail_1 ih =>
    intro k hH
    have hHh : CondH (Tree.node (head :: tail_1)) := spx_condH_height hH (g := ⟨⟨[], 0⟩, 0⟩) rfl
    have ih' := ih
    generalize hh : Tree.node (head :: tail_1) = h at hHh ih'
    have hne : h.cols ≠ [] := by rw [← hh]; simp [Tree.cols]
    have hprof : profile (Tree.node (((p, h) :: rest) :: tail)) =
        ((profileAux 1 h : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by
      rw [spx_profile_node (by simp), spx_profileAux_cons 0 p hne]
    rcases Nat.eq_zero_or_pos k with rfl | hk
    · have : safePrefix (Tree.node (((p, h) :: rest) :: tail)) 0 = Tree.empty := by
        simp [safePrefix, safePrefixBody, spF, spCols, Tree.empty]
      rw [this]; exact ⟨by simp [profile, profileBody, Tree.empty], Or.inr (Or.inr rfl)⟩
    · have hsp : safePrefix (Tree.node (((p, h) :: rest) :: tail)) k =
          Tree.node (((p, (spF (k - 1) h).1) :: (spLater (spF (k - 1) h).2 rest).1) ::
            (spCols (spLater (spF (k - 1) h).2 rest).2 tail).1) := by
        show (spF k _).1 = _
        simp only [spF, spCols, Nat.pos_iff_ne_zero.1 hk, if_false, spCol]
      rw [hsp, hprof]
      by_cases hb : (spF (k - 1) h).2 = 0
      · rw [hb, spx_spLater_zero, spx_spCols_zero]
        obtain ⟨ihle, ihc⟩ := ih' (k - 1) hHh
        by_cases he : (spF (k - 1) h).1 = Tree.empty
        · rw [he]
          have ht : (Tree.node [[(p, Tree.empty)]] : Forest) = spxTower [] p (0 + 1) := rfl
          rw [ht, spx_profile_tower]
          refine ⟨WithBot.coe_le_coe.2 ?_, Or.inr (Or.inl ⟨[], p, 0, rfl⟩)⟩
          rw [spx_profileAux_one, Prod.Lex.toLex_le_toLex]
          left; simp
        · have hne' : (spF (k - 1) h).1.cols ≠ [] := by
            intro h0; apply he; rw [spx_eta (spF (k - 1) h).1, h0]; rfl
          have e1 : profile (Tree.node [[(p, (spF (k - 1) h).1)]]) =
              ((profileAux 1 (spF (k - 1) h).1 : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by
            rw [spx_profile_node (by simp), spx_profileAux_cons 0 p hne']
          have e2 : profile (spF (k - 1) h).1 =
              ((profileAux 0 (spF (k - 1) h).1 : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by
            rw [spx_eta (spF (k - 1) h).1, spx_profile_node hne', ← spx_eta]
          have e3 : profile h = ((profileAux 0 h : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by
            rw [spx_eta h, spx_profile_node hne, ← spx_eta]
          have ihle' : profile (spF (k - 1) h).1 ≤ profile h := ihle
          rw [e2, e3, WithBot.coe_le_coe] at ihle'
          rw [e1]
          refine ⟨WithBot.coe_le_coe.2 ?_, ?_⟩
          · rw [spx_profileAux_one, spx_profileAux_one]
            rw [Prod.Lex.le_iff] at ihle'
            rw [Prod.Lex.toLex_le_toLex]
            simp only at ihle' ⊢
            omega
          · rcases ihc with heq | ⟨ps, q, m, htw⟩ | hemp
            · left
              change profile (spF (k - 1) h).1 = profile h at heq
              rw [e2, e3, WithBot.coe_inj] at heq
              rw [spx_profileAux_one, spx_profileAux_one, heq]
            · right; left
              change (spF (k - 1) h).1 = _ at htw
              exact ⟨p :: ps, q, m, by rw [htw]; rfl⟩
            · exact absurd hemp he
      · rw [spx_spF_full hb]
        have e1 : profile (Tree.node (((p, h) :: (spLater (spF (k - 1) h).2 rest).1) ::
            (spCols (spLater (spF (k - 1) h).2 rest).2 tail).1)) =
            ((profileAux 1 h : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by
          rw [spx_profile_node (by simp), spx_profileAux_cons 0 p hne]
        rw [e1]
        exact ⟨le_refl _, Or.inl rfl⟩
  | case3 d cols hne =>
    intro k hH
    match cols, hne with
    | [], _ =>
      have : safePrefix (Tree.node []) k = Tree.empty := by
        have := spx_spF_emptyF k; simp only [Tree.empty] at this
        show (spF k _).1 = _; rw [this]; rfl
      rw [this]; exact ⟨le_of_eq (by rfl), Or.inr (Or.inr rfl)⟩
    | [] :: cs, _ =>
      rcases Nat.eq_zero_or_pos k with rfl | hk
      · have : safePrefix (Tree.node ([] :: cs)) 0 = Tree.empty := by
          simp [safePrefix, safePrefixBody, spF, spCols, Tree.empty]
        rw [this]; exact ⟨by simp [profile, profileBody, Tree.empty], Or.inr (Or.inr rfl)⟩
      · have hsp : safePrefix (Tree.node ([] :: cs)) k =
            Tree.node ([] :: (spCols (k - 1) cs).1) := by
          show (spF k _).1 = _
          simp only [spF, spCols, Nat.pos_iff_ne_zero.1 hk, if_false, spCol]
        rw [hsp, spx_profile_node (by simp), spx_profile_node (by simp), profileAux, profileAux]
        all_goals first | exact ⟨le_refl _, Or.inl rfl⟩ | simp
    | ((p, h) :: rest) :: cs, hne => exact absurd rfl (hne p h rest cs)

-- T3.2f (txt:314-318): safe prefixes keep P
theorem safePrefix_condP {E : Forest} (hL : InL E) (hP : CondP E) (k : Nat) :
    CondP (safePrefix E k) := by
  obtain ⟨-, hI, hH, -, -⟩ := hL
  have hI' : CondI (safePrefix E k) := safePrefix_condI hI k
  intro e0 he0 e he hret
  obtain ⟨⟨ρ, hρ⟩, q, J', hJ', hres⟩ := hret
  obtain ⟨⟨P, j⟩, i⟩ := e
  dsimp only at hρ
  subst hρ
  obtain ⟨x0, hx0⟩ := Option.isSome_iff_exists.1 ((Tree.mem_entryAddrs_iff _ e0).1 he0)
  obtain ⟨p0, H'⟩ := x0
  obtain ⟨H, k₀, hH0, rfl, -⟩ := spx_entryAt (k := k) (T := E) hx0
  have hJ'' := hJ'
  rw [spx_entryAt_inside, Tree.heightAt, hx0] at hJ''
  simp only [Option.map_some, Option.bind_some] at hJ''
  obtain ⟨J, k₁, hJ, rfl, hk⟩ := spx_entryAt hJ''
  have hEe : E.entryAt ⟨⟨e0.heightPath ++ ρ, j⟩, i⟩ = some (q, J) := by
    rw [spx_entryAt_inside, Tree.heightAt, hH0]; simpa using hJ
  have hretE : IsOwnerReturn E e0 ⟨⟨e0.heightPath ++ ρ, j⟩, i⟩ := ⟨⟨ρ, rfl⟩, q, J, hEe, hres⟩
  have hPE := hP e0 ((Tree.mem_entryAddrs_iff E e0).2 (by rw [hH0]; rfl)) _
    ((Tree.mem_entryAddrs_iff E _).2 (by rw [hEe]; rfl)) hretE
  rw [Tree.heightAt, Tree.heightAt, hEe, hH0] at hPE
  simp only [Option.map_some, Option.getD_some] at hPE
  rw [Tree.heightAt, Tree.heightAt, hJ', hx0]
  simp only [Option.map_some, Option.getD_some]
  have hHH : CondH H := spx_condH_height hH (g := e0) (by rw [Tree.heightAt, hH0]; rfl)
  have hHJ : CondH J :=
    spx_condH_height hH (g := ⟨⟨e0.heightPath ++ ρ, j⟩, i⟩) (by rw [Tree.heightAt, hEe]; rfl)
  obtain ⟨-, hcase⟩ := spx_profile_sp 0 H k₀ hHH
  rcases hcase with hsame | ⟨ps, q', m, htw⟩ | hemp
  · exact lt_of_le_of_lt (spx_profile_sp 0 J k₁ hHJ).1 (hsame ▸ hPE)
  · -- the prefix of `H` is a pure tower: only its outer entries can return to its host
    have htw' : (spF k₀ H).1 = spxTower ps q' (m + 1) := htw
    rw [htw'] at hJ'' ⊢
    rcases List.eq_nil_or_concat ρ with rfl | ⟨ρ₀, ⟨c₁, i₁⟩, rfl⟩
    · exact spx_tower_outer hJ''
    · exfalso
      obtain ⟨col, hcol, hci⟩ := Tree.colAt_of_entryAt hJ''
      obtain ⟨q₀, H₀, rest, rfl, hconst⟩ := spx_tower_col ps q' m _ j _ hcol
      have hqq : q = q₀ := hconst _ (List.mem_of_getElem? hci)
      -- the entry `g` whose height holds the returning column
      let g : EntryAddr := ⟨⟨e0.heightPath ++ ρ₀, c₁⟩, i₁⟩
      have hgp : g.heightPath = e0.heightPath ++ (ρ₀ ++ [(c₁, i₁)]) := by
        simp [g, EntryAddr.heightPath]
      have hcolE : (safePrefix E k).colAt ⟨g.heightPath, j⟩ = some ((q₀, H₀) :: rest) := by
        rw [hgp, spx_colAt_append, Tree.forestAt_heightPath, Tree.heightAt, hx0]
        simp only [Option.map_some, Option.bind_some]
        rw [htw']; simpa using hcol
      rw [Tree.colAt, Tree.forestAt_heightPath, Tree.heightAt] at hcolE
      obtain ⟨G, hG, hGc⟩ := Option.bind_eq_some_iff.1 hcolE
      obtain ⟨⟨pg, G'⟩, hgE, hGG⟩ := Option.map_eq_some_iff.1 hG
      simp only at hGG
      subst hGG
      have hGne : G' ≠ Tree.empty := by
        intro h0; rw [h0] at hGc; simp [Tree.empty, Tree.cols] at hGc
      obtain ⟨q'', H'', rest'', hc'', hle⟩ := hI' g ((Tree.mem_entryAddrs_iff _ g).2
        (by rw [hgE]; rfl)) pg G' hgE hGne _ (List.mem_of_getElem? hGc)
      simp only [List.cons.injEq, Prod.mk.injEq] at hc''
      have hnum : e0.col.num 0 = q := ColAddr.resolve_num hres
      have hg : e0.col.num 0 + 1 ≤ g.col.num 0 := by
        simp only [g, ColAddr.num, EntryAddr.heightPath, List.map_append, List.sum_append,
          List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]
        omega
      omega
  · have htw' : (spF k₀ H).1 = Tree.empty := hemp
    rw [htw'] at hJ''
    obtain ⟨col, hcol, -⟩ := Tree.colAt_of_entryAt hJ''
    rw [spx_colAt_empty] at hcol; cases hcol


/-! T3.2g helpers: a proper word prefix is a safe prefix; filling the hole with its own column. -/

/-- A forest whose word is a proper prefix of `w(E)` is a safe prefix of `E`. -/
theorem spx_safePrefix_of_word {E E' : Forest} {X : List WordAtom} (hX : X ≠ [])
    (h : word E = word E' ++ X) : ∃ k, k < mu E ∧ E' = safePrefix E k := by
  refine ⟨mu E', ?_, word_injective ?_⟩
  · unfold mu; rw [h, List.length_append]
    have := List.length_pos_of_ne_nil hX; omega
  · rw [word_safePrefix, h]
    show word E' = (word E' ++ X).take (word E').length
    simp

/-- Filling the hole at the end of a route path with the column found there restores the forest. -/
theorem spx_put_self : ∀ (π : List (Nat × Nat)) (F G : Forest), IsRoutePath F π →
    F.forestAt π = some G → G.cols ≠ [] →
      replaceAt 0 0 (Tree.node [G.cols.getLast?.getD []]) π.length F = F
  | [], .node cols, G, _, hG, hne => by
    simp only [Tree.forestAt, Option.some.injEq] at hG
    subst hG
    simp only [Tree.cols] at hne ⊢
    obtain ⟨ys, y, rfl⟩ := (List.eq_nil_or_concat cols).resolve_left hne
    cases ys with
    | nil => simp [replaceAt, shiftVal_zero_fun, treeMapCol_id_fun, Tree.cols]
    | cons c cs =>
      simp only [replaceAt, shiftVal_zero_fun, treeMapCol_id_fun, Tree.cols, List.map_id,
        List.length_nil]
      rw [List.concat_eq_append, List.dropLast_concat, List.getLast?_concat]; rfl
  | s :: π, .node cols, G, hr, hG, hne => by
    obtain ⟨hl, h, hh, hr'⟩ := isRoutePath_cons.1 hr
    obtain ⟨col, p, h', hcol, hcl, hs, hh'⟩ := lastStep?_eq_some hl
    rw [hh] at hh'
    cases hh'
    have hG' : h.forestAt π = some G := by
      rw [show s :: π = [s] ++ π from rfl, Tree.forestAt_append, hh] at hG
      exact hG
    have ih := spx_put_self π h G hr' hG' hne
    simp only [Tree.cols] at hcol
    obtain ⟨ys, rfl⟩ := List.getLast?_eq_some_iff.1 hcol
    obtain ⟨zs, rfl⟩ := List.getLast?_eq_some_iff.1 hcl
    simp only [List.length_cons, replaceAt, mapLast_eq, List.dropLast_concat, List.getLast?_concat,
      Option.map_some, Option.toList_some, shiftVal_zero_fun, treeMapCol_id_fun, id, treeMap_id,
      List.map_id, ih]
    simp

theorem spx_wordCol_ne (e : Nat) (c : Column) : wordCol e c ≠ [] := by
  cases c with
  | nil => simp [wordCol]
  | cons x xs => obtain ⟨p, h⟩ := x; simp [wordCol]

-- T3.2g: deletion steps and ordinary steps at parameter 0 are safe prefixes
theorem expand_safePrefix {E E' : Forest} {n : Nat} (hE : E ≠ Tree.empty) (hV : CondV E)
    (hI : CondI E) (hk : stepKind E = some .deletion ∨ (stepKind E = some .ordinary ∧ n = 0))
    (h : expand E n = some E') : ∃ k, k < mu E ∧ E' = safePrefix E k := by
  rcases hk with hd | ⟨ho, rfl⟩
  · rw [expand_deletion hd n, Option.some.injEq] at h
    subst h
    have hl := (stepKind_deletion_iff E).1 hd
    obtain ⟨ys, hys⟩ := List.getLast?_eq_some_iff.1 hl
    refine spx_safePrefix_of_word (X := [toLex (0, toLex (0, 0))]) (by simp) ?_
    obtain ⟨cols⟩ := E
    simp only [Tree.cols] at hys ⊢
    subst hys
    simp [word, wordAt, wordCols_append, wordCols, wordCol]
  · obtain ⟨sd, hsd⟩ := Option.isSome_iff_exists.1 (stopData_of_stepKind ho (by decide))
    rw [expand_zero_eq_context hE hV hI ho hsd, Option.some.injEq] at h
    subst h
    obtain ⟨-, hdep, -, hmem, -, hlen⟩ := stopData_spec hsd
    obtain ⟨hrp, F, hF, hFl⟩ := (mem_routeCols_iff E sd.col).1 hmem
    have hne : F.cols ≠ [] := by intro h0; rw [h0] at hFl; simp at hFl
    have hself := spx_put_self sd.col.path E F hrp hF hne
    have hput := word_put ⟨E, sd.depth⟩ (Tree.node [F.cols.getLast?.getD []]) (by simp; omega)
    simp only [Hole.put] at hput
    rw [hdep, hself, ← hdep] at hput
    refine spx_safePrefix_of_word ?_ hput
    simp only [wordAt, wordCols, List.append_nil]
    exact spx_wordCol_ne _ _


/-! ### T3.2k/T3.2x helpers (branch D3): relative V, I, H along the route

The ordinary output is `A_{0,0,ℓ,Z}(A)` with `Z = ordZ A sd rd n` (`paperOp_ordinary`). The
conditions V, I (and H below) are proved structurally: each is restated relative to the number of
the first column of a forest (`VRel_D3`, `IRel_D3`), shown stable under shifts and under the
unshifted route replacement `replaceAt 0 0 Z k` (`*_put_D3`), and carried through the loop
`ordStep` one phase at a time (`*_ordStep_D3`). -/

theorem num_cons_D3 (b j m : Nat) (P : List (Nat × Nat)) (c : Nat) :
    ColAddr.num b ⟨(j, m) :: P, c⟩ = ColAddr.num (b + j + 1) ⟨P, c⟩ := by
  simp only [ColAddr.num, List.map_cons, List.sum_cons]; omega

theorem num_nil_D3 (b c : Nat) : ColAddr.num b ⟨[], c⟩ = b + c := by
  simp [ColAddr.num]

theorem num_add_D3 (b d : Nat) (c : ColAddr) : c.num (b + d) = c.num b + d := by
  simp only [ColAddr.num]; omega

theorem entryAt_nil_D3 (cols : List Column) (j m : Nat) :
    (Tree.node cols).entryAt ⟨⟨[], j⟩, m⟩ = (cols[j]?).bind (·[m]?) := rfl

theorem entryAt_cons_D3 (cols : List Column) (j m : Nat) (P : List (Nat × Nat)) (c i : Nat) :
    (Tree.node cols).entryAt ⟨⟨(j, m) :: P, c⟩, i⟩ =
      ((cols[j]?).bind (·[m]?)).bind fun x => x.2.entryAt ⟨⟨P, c⟩, i⟩ :=
  Tree.entryAt_cons _ _ _ _ _ _

/-- Relative condition V: parents below the printed number, the outer forest starting at `b`. -/
def VRel_D3 (b : Nat) (F : Forest) : Prop :=
  ∀ e p h, F.entryAt e = some (p, h) → p < e.col.num b

theorem vrel_node_D3 (b : Nat) (cols : List Column) :
    VRel_D3 b (.node cols) ↔ ∀ (j : Nat) (col : Column), cols[j]? = some col →
      ∀ (m p : Nat) (h : Forest), col[m]? = some (p, h) →
      p < b + j ∧ VRel_D3 (b + j + 1) h := by
  constructor
  · intro hV j col hj m p h hm
    refine ⟨?_, ?_⟩
    · have := hV ⟨⟨[], j⟩, m⟩ p h (by rw [entryAt_nil_D3, hj]; exact hm)
      simpa [num_nil_D3] using this
    · intro e p' h' he
      obtain ⟨⟨P, c⟩, i⟩ := e
      have := hV ⟨⟨(j, m) :: P, c⟩, i⟩ p' h' (by rw [entryAt_cons_D3, hj]; simp [hm, he])
      simpa [num_cons_D3] using this
  · intro hV e p h he
    obtain ⟨⟨P, c⟩, i⟩ := e
    cases P with
    | nil =>
      rw [entryAt_nil_D3] at he
      cases hc : cols[c]? with
      | none => simp [hc] at he
      | some col =>
        simp only [hc, Option.bind_some] at he
        have := (hV c col hc i p h he).1
        simpa [num_nil_D3] using this
    | cons ab P =>
      obtain ⟨j, m⟩ := ab
      rw [entryAt_cons_D3] at he
      cases hc : cols[j]? with
      | none => simp [hc] at he
      | some col =>
        cases hm : col[m]? with
        | none => simp [hc, hm] at he
        | some x =>
          obtain ⟨q, hq⟩ := x
          simp only [hc, hm, Option.bind_some] at he
          have := (hV j col hc m q hq hm).2 ⟨⟨P, c⟩, i⟩ p h he
          simpa [num_cons_D3] using this

theorem condV_iff_vrel_D3 (E : Forest) : CondV E ↔ VRel_D3 0 E := by
  rw [condV_iff_lt]
  constructor
  · intro h e p hh he
    exact h e ((Tree.mem_entryAddrs_iff E e).2 (by rw [he]; rfl)) p hh he
  · intro h e _ p hh he
    exact h e p hh he


theorem cols_map_D3 (f : Nat → Nat) (F : Forest) :
    (Tree.map f F).cols = F.cols.map (Tree.mapCol f) := by
  obtain ⟨cols⟩ := F; simp [Tree.map, Tree.cols, treeMapCols_eq_map]

theorem forestAt_map_D3 (f : Nat → Nat) : ∀ (π : List (Nat × Nat)) (t : Forest),
    (Tree.map f t).forestAt π = (t.forestAt π).map (Tree.map f)
  | [], t => rfl
  | (c, i) :: rest, t => by
    rw [Tree.forestAt_cons, Tree.forestAt_cons, cols_map_D3]
    simp only [List.getElem?_map]
    cases hc : t.cols[c]? with
    | none => simp
    | some col =>
      simp only [Option.map_some, Option.bind_some, treeMapCol_eq_map, List.getElem?_map]
      cases hi : col[i]? with
      | none => simp
      | some x => simp [forestAt_map_D3 f rest x.2]

theorem colAt_map_D3 (f : Nat → Nat) (t : Forest) (c : ColAddr) :
    (Tree.map f t).colAt c = (t.colAt c).map (Tree.mapCol f) := by
  obtain ⟨π, j⟩ := c
  simp only [Tree.colAt, forestAt_map_D3]
  cases t.forestAt π with
  | none => simp
  | some F => simp [cols_map_D3, List.getElem?_map]

theorem entryAt_map_D3 (f : Nat → Nat) (t : Forest) (e : EntryAddr) :
    (Tree.map f t).entryAt e = (t.entryAt e).map fun x => (f x.1, Tree.map f x.2) := by
  obtain ⟨c, i⟩ := e
  simp only [Tree.entryAt, colAt_map_D3]
  cases t.colAt c with
  | none => simp
  | some col => simp [treeMapCol_eq_map, List.getElem?_map]

theorem shiftVal_le_D3 (r d p : Nat) : shiftVal r d p ≤ p + d := by
  unfold shiftVal; split <;> omega

theorem le_shiftVal_D3 (r d p : Nat) : p ≤ shiftVal r d p := by
  unfold shiftVal; split <;> omega

theorem shiftVal_mono_D3 (r d : Nat) {p q : Nat} (h : p ≤ q) : shiftVal r d p ≤ shiftVal r d q := by
  unfold shiftVal; split <;> split <;> omega

theorem shiftVal_strictMono_D3 (r d : Nat) {p q : Nat} (h : p < q) :
    shiftVal r d p < shiftVal r d q := by
  unfold shiftVal; split <;> split <;> omega

theorem vrel_shift_D3 {b : Nat} {F : Forest} (h : VRel_D3 b F) (r d : Nat) :
    VRel_D3 (b + d) (shift r d F) := by
  intro e p hh he
  rw [shift, entryAt_map_D3] at he
  cases h' : F.entryAt e with
  | none => simp [h'] at he
  | some x =>
    simp only [h', Option.map_some, Option.some.injEq, Prod.mk.injEq] at he
    obtain ⟨rfl, rfl⟩ := he
    have := h e x.1 x.2 h'
    rw [num_add_D3]
    have := shiftVal_le_D3 r d x.1
    omega

/-- The last-column, last-entry route reaches depth `k`. -/
def RouteOK_D3 : Nat → Forest → Prop
  | 0, F => F.cols ≠ []
  | k + 1, F => ∃ cs es p h, F = .node (cs ++ [es ++ [(p, h)]]) ∧ RouteOK_D3 k h

/-- The relative number of the route column at depth `k`. -/
def routeNum_D3 : Nat → Forest → Nat
  | 0, F => F.cols.length - 1
  | k + 1, F => F.cols.length + routeNum_D3 k (nextLayer F)

theorem nextLayer_snoc_D3 (cs : List Column) (es : Column) (p : Nat) (h : Forest) :
    nextLayer (.node (cs ++ [es ++ [(p, h)]])) = h := by
  simp [nextLayer, lastEntry?, Tree.cols]

theorem put_zero_D3 (Z : Forest) {cols : List Column} (hc : cols ≠ []) :
    replaceAt 0 0 Z 0 (.node cols) = .node (cols.dropLast ++ Z.cols) := by
  cases cols with
  | nil => exact absurd rfl hc
  | cons c cs =>
    simp only [replaceAt]
    rw [shiftVal_zero_fun 0, treeMapCol_id_fun, List.map_id]

theorem put_succ_D3 (Z : Forest) (k : Nat) (cs : List Column) (es : Column) (p : Nat)
    (h : Forest) :
    replaceAt 0 0 Z (k + 1) (.node (cs ++ [es ++ [(p, h)]])) =
      .node (cs ++ [es ++ [(p, replaceAt 0 0 Z k h)]]) := by
  simp only [replaceAt]
  rw [shiftVal_zero_fun 0, treeMapCol_id_fun]
  simp [mapLast_eq, treeMap_id]

theorem vrel_put_D3 (Z : Forest) : ∀ (k : Nat) (F : Forest) (b : Nat), RouteOK_D3 k F →
    VRel_D3 b F → VRel_D3 (b + routeNum_D3 k F) Z → VRel_D3 b (replaceAt 0 0 Z k F)
  | 0, .node cols, b, hR, hF, hZ => by
    have hc : cols ≠ [] := hR
    rw [put_zero_D3 Z hc]
    obtain ⟨zc⟩ := Z
    simp only [routeNum_D3, Tree.cols] at hZ ⊢
    rw [vrel_node_D3] at hF hZ ⊢
    intro j col hj m p h hm
    by_cases hjl : j < cols.length - 1
    · rw [List.getElem?_append_left (by simpa using hjl), List.getElem?_dropLast] at hj
      simp only [hjl, if_true] at hj
      exact hF j col hj m p h hm
    · rw [List.getElem?_append_right (by simp; omega)] at hj
      simp only [List.length_dropLast] at hj
      have := hZ _ col hj m p h hm
      have e : b + (cols.length - 1) + (j - (cols.length - 1)) = b + j := by omega
      rw [e] at this
      exact this
  | k + 1, F, b, hR, hF, hZ => by
    obtain ⟨cs, es, q, H, rfl, hR'⟩ := hR
    rw [put_succ_D3]
    simp only [routeNum_D3, nextLayer_snoc_D3, Tree.cols, List.length_append, List.length_singleton]
      at hZ
    rw [vrel_node_D3] at hF ⊢
    intro j col hj m p h hm
    by_cases hjl : j < cs.length
    · rw [List.getElem?_append_left hjl] at hj
      exact hF j col (by rw [List.getElem?_append_left hjl]; exact hj) m p h hm
    · have hjeq : j = cs.length := by
        have := (List.getElem?_eq_some_iff.1 hj).1; simp at this; omega
      subst hjeq
      simp only [List.getElem?_append_right (le_refl _), Nat.sub_self, List.getElem?_cons_zero,
        Option.some.injEq] at hj
      subst hj
      have hF' := hF cs.length (es ++ [(q, H)]) (by simp)
      by_cases hml : m < es.length
      · rw [List.getElem?_append_left hml] at hm
        exact hF' m p h (by rw [List.getElem?_append_left hml]; exact hm)
      · have hmeq : m = es.length := by
          have := (List.getElem?_eq_some_iff.1 hm).1; simp at this; omega
        subst hmeq
        simp only [List.getElem?_append_right (le_refl _), Nat.sub_self, List.getElem?_cons_zero,
          Option.some.injEq, Prod.mk.injEq] at hm
        obtain ⟨rfl, rfl⟩ := hm
        have := hF' es.length q H (by simp)
        refine ⟨this.1, vrel_put_D3 Z k H _ hR' this.2 ?_⟩
        have e : b + (cs.length + 1 + routeNum_D3 k H) = b + cs.length + 1 + routeNum_D3 k H := by
          omega
        rw [e] at hZ; exact hZ


/-- Column form of `VRel_D3`: a column numbered `b`. -/
def VCol_D3 (b : Nat) (col : Column) : Prop := ∀ x ∈ col, x.1 < b ∧ VRel_D3 (b + 1) x.2

/-- List-of-columns form of `VRel_D3`. -/
def VCols_D3 (b : Nat) (cols : List Column) : Prop :=
  ∀ (j : Nat) (col : Column), cols[j]? = some col → VCol_D3 (b + j) col

theorem vrel_iff_vcols_D3 (b : Nat) (cols : List Column) :
    VRel_D3 b (.node cols) ↔ VCols_D3 b cols := by
  rw [vrel_node_D3]
  constructor
  · intro h j col hj x hx
    obtain ⟨m, hm⟩ := List.getElem?_of_mem hx
    exact h j col hj m x.1 x.2 hm
  · intro h j col hj m p hh hm
    exact h j col hj (p, hh) (List.mem_of_getElem? hm)

theorem vrel_eq_vcols_D3 (b : Nat) (F : Forest) : VRel_D3 b F ↔ VCols_D3 b F.cols := by
  obtain ⟨cols⟩ := F; exact vrel_iff_vcols_D3 b cols

theorem vcols_nil_D3 (b : Nat) : VCols_D3 b [] := by
  intro j col hj; simp at hj

theorem vcols_cons_D3 (b : Nat) (c : Column) (cs : List Column) :
    VCols_D3 b (c :: cs) ↔ VCol_D3 b c ∧ VCols_D3 (b + 1) cs := by
  constructor
  · intro h
    refine ⟨by simpa using h 0 c rfl, fun j col hj => ?_⟩
    have := h (j + 1) col (by simpa using hj)
    rwa [show b + (j + 1) = b + 1 + j by omega] at this
  · rintro ⟨h1, h2⟩ j col hj
    cases j with
    | zero => simp at hj; subst hj; simpa using h1
    | succ j =>
      have := h2 j col (by simpa using hj)
      rw [show b + (j + 1) = b + 1 + j by omega]; exact this

theorem vcols_append_D3 (b : Nat) (cs ds : List Column) :
    VCols_D3 b (cs ++ ds) ↔ VCols_D3 b cs ∧ VCols_D3 (b + cs.length) ds := by
  induction cs generalizing b with
  | nil => simp [vcols_nil_D3]
  | cons c cs ih =>
    rw [List.cons_append, vcols_cons_D3, vcols_cons_D3, ih]
    simp only [List.length_cons, show b + 1 + cs.length = b + (cs.length + 1) by omega, and_assoc]

theorem vcols_single_D3 (b : Nat) (c : Column) : VCols_D3 b [c] ↔ VCol_D3 b c := by
  rw [vcols_cons_D3]; simp [vcols_nil_D3]

theorem vcol_append_D3 (b : Nat) (l₁ l₂ : Column) :
    VCol_D3 b (l₁ ++ l₂) ↔ VCol_D3 b l₁ ∧ VCol_D3 b l₂ := by
  simp only [VCol_D3, List.mem_append]
  constructor
  · intro h; exact ⟨fun x hx => h x (Or.inl hx), fun x hx => h x (Or.inr hx)⟩
  · rintro ⟨h1, h2⟩ x (hx | hx); exacts [h1 x hx, h2 x hx]

theorem vcol_mono_D3 {b b' : Nat} (hb : b ≤ b') {col : Column} (h : ∀ x ∈ col, x.1 < b)
    (h' : ∀ x ∈ col, VRel_D3 (b' + 1) x.2) : VCol_D3 b' col :=
  fun x hx => ⟨lt_of_lt_of_le (h x hx) hb, h' x hx⟩

theorem vrel_empty_D3 (b : Nat) : VRel_D3 b Tree.empty := by
  rw [show (Tree.empty : Forest) = .node [] from rfl, vrel_iff_vcols_D3]; exact vcols_nil_D3 b

/-- `VRel` inside a column of a forest. -/
theorem vrel_colAt_D3 {b : Nat} {F : Forest} (hF : VRel_D3 b F) {c : ColAddr} {col : Column}
    (hc : F.colAt c = some col) : VCol_D3 (c.num b) col := by
  intro x hx
  obtain ⟨m, hm⟩ := List.getElem?_of_mem hx
  have he : F.entryAt ⟨c, m⟩ = some (x.1, x.2) := by
    simp [Tree.entryAt, hc, hm]
  refine ⟨hF _ _ _ he, ?_⟩
  intro e p h he'
  obtain ⟨⟨P, j⟩, i⟩ := e
  have hG : F.forestAt c.path = some (.node ((F.forestAt c.path).getD Tree.empty).cols) := by
    cases hf : F.forestAt c.path with
    | none => simp [Tree.colAt, hf] at hc
    | some G => obtain ⟨gc⟩ := G; rfl
  have hcol : ((F.forestAt c.path).getD Tree.empty).cols[c.col]? = some col := by
    simp only [Tree.colAt] at hc
    cases hf : F.forestAt c.path with
    | none => simp [hf] at hc
    | some G => simp only [hf, Option.bind_some] at hc; simpa using hc
  have hf : F.forestAt (c.path ++ (c.col, m) :: P) = x.2.forestAt P := by
    rw [Tree.forestAt_append, hG]
    simp only [Option.bind_some]
    rw [Tree.forestAt_cons]
    have e : (Tree.node ((F.forestAt c.path).getD Tree.empty).cols).cols =
      ((F.forestAt c.path).getD Tree.empty).cols := rfl
    rw [e, hcol]; simp [hm]
  have : F.entryAt ⟨⟨c.path ++ (c.col, m) :: P, j⟩, i⟩ = some (p, h) := by
    rw [Tree.entryAt_eq_bind, hf, ← Tree.entryAt_eq_bind]; exact he'
  have := hF _ _ _ this
  simp only [ColAddr.num, List.map_append, List.map_cons, List.sum_append, List.sum_cons] at this ⊢
  omega

theorem vrel_forestAt_D3 {b : Nat} {F : Forest} (hF : VRel_D3 b F) {π : List (Nat × Nat)}
    {G : Forest} (hG : F.forestAt π = some G) :
    VRel_D3 (b + (π.map (·.1 + 1)).sum) G := by
  intro e p h he
  obtain ⟨⟨P, j⟩, i⟩ := e
  have : F.entryAt ⟨⟨π ++ P, j⟩, i⟩ = some (p, h) := by
    rw [Tree.entryAt_eq_bind, Tree.forestAt_append, hG]
    simp only [Option.bind_some]
    rw [Tree.entryAt_eq_bind] at he; exact he
  have := hF _ _ _ this
  simp only [ColAddr.num, List.map_append, List.sum_append] at this ⊢
  omega

theorem vcols_drop_D3 {b : Nat} {cols : List Column} (h : VCols_D3 b cols) (k : Nat) :
    VCols_D3 (b + k) (cols.drop k) := by
  intro j col hj
  rw [List.getElem?_drop] at hj
  have := h (k + j) col hj
  rwa [show b + (k + j) = b + k + j by omega] at this

theorem nextLayer_map_D3 (f : Nat → Nat) (F : Forest) :
    nextLayer (Tree.map f F) = Tree.map f (nextLayer F) := by
  obtain ⟨cols⟩ := F
  rcases List.eq_nil_or_concat cols with rfl | ⟨cs, c, rfl⟩
  · rfl
  rcases List.eq_nil_or_concat c with rfl | ⟨es, x, rfl⟩
  · simp [nextLayer, lastEntry?, Tree.map, Tree.cols, treeMapCols_eq_map, treeMapCol_eq_map,
      Tree.empty, Tree.mapCols]
  · simp [nextLayer, lastEntry?, Tree.map, Tree.cols, treeMapCols_eq_map, treeMapCol_eq_map]

theorem routeOK_shift_D3 (r d : Nat) : ∀ (k : Nat) (F : Forest),
    RouteOK_D3 k (shift r d F) ↔ RouteOK_D3 k F
  | 0, .node cols => by
    simp [RouteOK_D3, shift, Tree.map, Tree.cols, treeMapCols_eq_map]
  | k + 1, .node cols => by
    simp only [RouteOK_D3]
    constructor
    · rintro ⟨cs, es, p, h, he, hR⟩
      simp only [shift, Tree.map, treeMapCols_eq_map, Tree.node.injEq] at he
      rcases List.eq_nil_or_concat cols with rfl | ⟨cs', c, rfl⟩
      · simp at he
      rw [List.concat_eq_append, List.map_append, List.map_singleton] at he
      obtain ⟨hcs, hc⟩ := List.append_inj' he (by simp)
      simp only [List.cons.injEq, and_true] at hc
      rw [treeMapCol_eq_map] at hc
      rcases List.eq_nil_or_concat c with rfl | ⟨es', x, rfl⟩
      · simp at hc
      rw [List.concat_eq_append, List.map_append, List.map_singleton] at hc
      obtain ⟨-, hx⟩ := List.append_inj' hc (by simp)
      simp only [List.cons.injEq, and_true, Prod.mk.injEq] at hx
      refine ⟨cs', es', x.1, x.2, by simp, ?_⟩
      rw [← routeOK_shift_D3 r d k x.2]
      have : shift r d x.2 = h := hx.2
      rw [this]; exact hR
    · rintro ⟨cs, es, p, h, he, hR⟩
      cases he
      refine ⟨cs.map (Tree.mapCol (shiftVal r d)), es.map (fun x => (shiftVal r d x.1, Tree.map (shiftVal r d) x.2)),
        shiftVal r d p, shift r d h, ?_, (routeOK_shift_D3 r d k h).2 hR⟩
      simp [shift, Tree.map, treeMapCols_eq_map, treeMapCol_eq_map]

theorem routeNum_shift_D3 (r d : Nat) : ∀ (k : Nat) (F : Forest),
    routeNum_D3 k (shift r d F) = routeNum_D3 k F
  | 0, .node cols => by
    simp [routeNum_D3, shift, Tree.map, Tree.cols, treeMapCols_eq_map]
  | k + 1, .node cols => by
    simp only [routeNum_D3]
    have hlen : (shift r d (.node cols)).cols.length = (Tree.node cols).cols.length := by
      simp [shift, Tree.map, Tree.cols, treeMapCols_eq_map]
    have hnext : nextLayer (shift r d (.node cols)) = shift r d (nextLayer (.node cols)) :=
      nextLayer_map_D3 _ _
    rw [hlen, hnext, routeNum_shift_D3 r d k]


theorem leftCount_succ_D3 (E : Forest) (k : Nat) :
    leftCount E (k + 1) = leftCount E k + (skipLayers E k).cols.length := by
  rw [leftCount_eq_sum, leftCount_eq_sum, List.range_succ, List.map_append, List.sum_append]
  simp

theorem stop_route_D3 {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    ∀ i, i ≤ sd.depth → RouteOK_D3 i (skipLayers E (sd.depth - i)) ∧
      leftCount E (sd.depth - i) + routeNum_D3 i (skipLayers E (sd.depth - i)) = sd.t := by
  obtain ⟨h1, h2, h3, h4, h5, -, h7, -⟩ := stopData_core h
  intro i hi
  induction i with
  | zero =>
    simp only [Nat.sub_zero, RouteOK_D3, routeNum_D3]
    refine ⟨fun he => by rw [he] at h1; simp at h1, ?_⟩
    rw [h3, ← h7]; simp only [ColAddr.num]; omega
  | succ i ih =>
    obtain ⟨ih1, ih2⟩ := ih (by omega)
    obtain ⟨col, p, hc, hp, -, -⟩ := h5 (sd.depth - (i + 1)) (by omega)
    obtain ⟨cs, hcs⟩ := List.getLast?_eq_some_iff.1 hc
    obtain ⟨es, hes⟩ := List.getLast?_eq_some_iff.1 hp
    have hk : sd.depth - (i + 1) + 1 = sd.depth - i := by omega
    rw [hk] at hes
    have hF : skipLayers E (sd.depth - (i + 1)) = .node (cs ++ [es ++ [(p, skipLayers E (sd.depth - i))]]) := by
      rw [← hes, ← hcs]; cases skipLayers E (sd.depth - (i + 1)); rfl
    refine ⟨⟨cs, es, p, _, hF, ih1⟩, ?_⟩
    simp only [routeNum_D3]
    rw [hF, nextLayer_snoc_D3, ← hF]
    have := leftCount_succ_D3 E (sd.depth - (i + 1))
    rw [hk] at this
    omega

theorem stop_route_top_D3 {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    RouteOK_D3 sd.depth E ∧ routeNum_D3 sd.depth E = sd.t := by
  have := stop_route_D3 h sd.depth le_rfl
  simpa [skipLayers, leftCount] using this

theorem stop_pathSum_D3 {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    ∀ k, k ≤ sd.depth → ((sd.col.path.take k).map (·.1 + 1)).sum = leftCount E k := by
  obtain ⟨-, h2, -, -, h5, -⟩ := stopData_core h
  intro k hk
  induction k with
  | zero => simp [leftCount]
  | succ k ih =>
    obtain ⟨col, p, hc, -, -, hpk⟩ := h5 k (by omega)
    rw [List.take_add_one, hpk, leftCount_succ_D3, ← ih (by omega)]
    have hne : (skipLayers E k).cols ≠ [] := by intro he; rw [he] at hc; simp at hc
    have : 0 < (skipLayers E k).cols.length := List.length_pos_iff.2 hne
    simp; omega

theorem root_facts_D3 {E : Forest} {sd : StopData} {rd : RootData} (hsd : stopData E = some sd)
    (hrd : rootData E = some rd) :
    rd.layer ≤ sd.depth ∧ E.forestAt rd.col.path = some (skipLayers E rd.layer) ∧
      sd.r = leftCount E rd.layer + rd.idx ∧ rd.idx < (skipLayers E rd.layer).cols.length ∧
      (rd.owner = true ↔ rd.idx + 1 = (skipLayers E rd.layer).cols.length) ∧
      E.colAt rd.col = (skipLayers E rd.layer).cols[rd.idx]? := by
  obtain ⟨-, hlay, hidx, hnum, -, hmem, -, hown⟩ := rootData_spec hsd hrd
  obtain ⟨-, -, -, hpre, -⟩ := rootData_path hsd hrd
  have hle := rootData_layer_le hsd hrd
  have hpath : rd.col.path = sd.col.path.take rd.layer := by
    obtain ⟨t, ht⟩ := hpre
    rw [hlay, ← ht, List.take_left' rfl]
  have hfa : E.forestAt rd.col.path = some (skipLayers E rd.layer) := by
    rw [hpath]; exact skipLayers_of_stopData hsd hle
  have hcol : E.colAt rd.col = (skipLayers E rd.layer).cols[rd.idx]? := by
    simp [Tree.colAt, hfa, hidx]
  refine ⟨hle, hfa, ?_, ?_, ?_, hcol⟩
  · rw [← hnum]; simp only [ColAddr.num]
    rw [hpath, stop_pathSum_D3 hsd _ hle, hidx]; omega
  · have := (Tree.mem_colAddrs_iff E rd.col).1 hmem
    rw [hcol] at this
    by_contra hc
    rw [List.getElem?_eq_none (by omega)] at this
    simp at this
  · rw [hown, hidx]
    constructor
    · rintro ⟨F, hF, h⟩; rw [hfa] at hF; cases hF; exact h
    · intro h; exact ⟨_, hfa, h⟩


theorem body_route_D3 {E : Forest} {sd : StopData} {rd : RootData} (hsd : stopData E = some sd)
    (hrd : rootData E = some rd) (hown : rd.owner = false) :
    RouteOK_D3 (sd.depth - rd.layer) (.node ((skipLayers E rd.layer).cols.drop (rd.idx + 1))) ∧
      sd.r + 1 + routeNum_D3 (sd.depth - rd.layer)
        (.node ((skipLayers E rd.layer).cols.drop (rd.idx + 1))) = sd.t := by
  obtain ⟨hle, -, hr, hidx, howner, -⟩ := root_facts_D3 hsd hrd
  have hlt : rd.idx + 1 < (skipLayers E rd.layer).cols.length := by
    have : ¬ rd.idx + 1 = (skipLayers E rd.layer).cols.length := by
      rw [← howner, hown]; simp
    omega
  obtain ⟨hR, hN⟩ := stop_route_D3 hsd (sd.depth - rd.layer) (by omega)
  rw [show sd.depth - (sd.depth - rd.layer) = rd.layer by omega] at hR hN
  generalize skipLayers E rd.layer = G at *
  generalize hi : sd.depth - rd.layer = i at hR hN ⊢
  cases i with
  | zero =>
    refine ⟨?_, ?_⟩
    · show G.cols.drop (rd.idx + 1) ≠ []
      intro h; rw [List.drop_eq_nil_iff] at h; omega
    · show sd.r + 1 + ((G.cols.drop (rd.idx + 1)).length - 1) = sd.t
      simp only [routeNum_D3] at hN
      rw [List.length_drop]; omega
  | succ i =>
    obtain ⟨cs, es, p, h, rfl, hR'⟩ := hR
    simp only [Tree.cols, List.length_append, List.length_singleton] at hlt
    have hdrop : (cs ++ [es ++ [(p, h)]]).drop (rd.idx + 1) =
        cs.drop (rd.idx + 1) ++ [es ++ [(p, h)]] := List.drop_append_of_le_length (by omega)
    simp only [Tree.cols, hdrop]
    refine ⟨⟨_, _, _, _, rfl, hR'⟩, ?_⟩
    simp only [routeNum_D3, nextLayer_snoc_D3, Tree.cols, List.length_append, List.length_singleton,
      List.length_drop] at hN ⊢
    omega

theorem owner_route_D3 {E : Forest} {sd : StopData} {rd : RootData} (hsd : stopData E = some sd)
    (hrd : rootData E = some rd) (hown : rd.owner = true) :
    ∃ es p h, E.colAt rd.col = some (es ++ [(p, h)]) ∧
      RouteOK_D3 (sd.depth - rd.layer - 1) h ∧
      sd.r + 1 + routeNum_D3 (sd.depth - rd.layer - 1) h = sd.t := by
  obtain ⟨hle, -, hr, hidx, howner, hcol⟩ := root_facts_D3 hsd hrd
  have hlt := rootData_layer_lt hsd hrd hown
  have hidx' := howner.1 hown
  obtain ⟨hR, hN⟩ := stop_route_D3 hsd (sd.depth - rd.layer) (by omega)
  rw [show sd.depth - (sd.depth - rd.layer) = rd.layer by omega] at hR hN
  obtain ⟨i, hi⟩ : ∃ i, sd.depth - rd.layer = i + 1 := ⟨sd.depth - rd.layer - 1, by omega⟩
  rw [hi] at hR hN
  obtain ⟨cs, es, p, h, hG, hR'⟩ := hR
  rw [hG] at hidx' hN hcol
  simp only [Tree.cols, List.length_append, List.length_singleton] at hidx'
  refine ⟨es, p, h, ?_, by rw [hi]; exact hR', ?_⟩
  · rw [hcol]; simp [Tree.cols, show rd.idx = cs.length by omega]
  · simp only [routeNum_D3, nextLayer_snoc_D3, Tree.cols, List.length_append,
      List.length_singleton] at hN
    rw [show sd.depth - rd.layer - 1 = i by omega]
    omega

theorem vcol_shift_D3 {b : Nat} {col : Column} (h : VCol_D3 b col) (r d : Nat) :
    VCol_D3 (b + d) (Tree.mapCol (shiftVal r d) col) := by
  rw [treeMapCol_eq_map]
  intro x hx
  obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx
  obtain ⟨h1, h2⟩ := h y hy
  refine ⟨lt_of_le_of_lt (shiftVal_le_D3 r d y.1) (by omega), ?_⟩
  have := vrel_shift_D3 h2 r d
  rwa [show b + 1 + d = b + d + 1 by omega] at this

theorem vcol_shiftH_D3 {b b' : Nat} {col : Column} (h : VCol_D3 b col) (hb : b ≤ b') (r d : Nat)
    (hd : b' = b + d) :
    VCol_D3 b' (col.map fun x => (x.1, shift r d x.2)) := by
  intro x hx
  obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx
  obtain ⟨h1, h2⟩ := h y hy
  refine ⟨by simp; omega, ?_⟩
  have := vrel_shift_D3 h2 r d
  rwa [show b + 1 + d = b' + 1 by omega] at this

theorem vcol_sub_D3 {b : Nat} {l l' : Column} (h : VCol_D3 b l) (hs : ∀ x ∈ l', x ∈ l) :
    VCol_D3 b l' := fun x hx => h x (hs x hx)

/-- Step `k` of the ordinary loop keeps relative V, one phase down. -/
theorem vrel_ordStep_D3 {sd : StopData} {rd : RootData} {F : Forest} {U : Column} {k : Nat}
    {Z : Forest} (hk : 1 ≤ k) (hrt : sd.r < sd.t) (hQ : VCol_D3 sd.t sd.Q) (hU : VCol_D3 sd.r U)
    (hbody : rd.owner = false →
      RouteOK_D3 (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) ∧
      VRel_D3 (sd.r + 1) (.node (F.cols.drop (rd.idx + 1))) ∧
      sd.r + 1 + routeNum_D3 (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) = sd.t)
    (howner : rd.owner = true → ∀ x, U.getLast? = some x →
      RouteOK_D3 (sd.depth - rd.layer - 1) x.2 ∧
      sd.r + 1 + routeNum_D3 (sd.depth - rd.layer - 1) x.2 = sd.t)
    (hZ : VRel_D3 (sd.t + k * (sd.t - sd.r)) Z) :
    VRel_D3 (sd.r + k * (sd.t - sd.r)) (ordStep sd rd F U k Z) := by
  have key : sd.t + (k - 1) * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) := by
    obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
    simp only [Nat.add_sub_cancel, Nat.succ_mul]; omega
  have hQ' : VCol_D3 (sd.r + k * (sd.t - sd.r))
      (Tree.mapCol (shiftVal sd.r ((k - 1) * (sd.t - sd.r))) sd.Q) := by
    rw [← key]; exact vcol_shift_D3 hQ _ _
  have hU' : ∀ l : Column, (∀ x ∈ l, x ∈ U) → VCol_D3 (sd.r + k * (sd.t - sd.r))
      (l.map fun x => (x.1, shift sd.r (k * (sd.t - sd.r)) x.2)) :=
    fun l hl => vcol_shiftH_D3 (vcol_sub_D3 hU hl) (by omega) _ _ rfl
  unfold ordStep
  simp only
  split
  · rename_i hown
    rw [vrel_iff_vcols_D3, vcols_single_D3, vcol_append_D3, vcol_append_D3]
    refine ⟨⟨hQ', hU' _ (fun x hx => List.mem_of_mem_dropLast hx)⟩, ?_⟩
    intro x hx
    cases hl : U.getLast? with
    | none => simp [hl] at hx
    | some u =>
      simp only [hl, Option.map_some, Option.toList_some, List.mem_singleton] at hx
      subst hx
      have hu : u ∈ U := List.mem_of_getLast? hl
      obtain ⟨hR, hN⟩ := howner hown u hl
      refine ⟨by simp; exact lt_of_lt_of_le (hU u hu).1 (by omega), ?_⟩
      simp only
      rw [Hole.fill_eq_put]
      refine vrel_put_D3 Z _ _ _ ((routeOK_shift_D3 _ _ _ _).2 hR) ?_ ?_
      · have := vrel_shift_D3 (hU u hu).2 sd.r (k * (sd.t - sd.r))
        rwa [show sd.r + 1 + k * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) + 1 by omega] at this
      · rw [routeNum_shift_D3]
        rwa [show sd.r + k * (sd.t - sd.r) + 1 + routeNum_D3 (sd.depth - rd.layer - 1) u.2 =
          sd.t + k * (sd.t - sd.r) by omega]
  · rename_i hown
    have hown' : rd.owner = false := by simpa using hown
    obtain ⟨hR, hB, hN⟩ := hbody hown'
    rw [vrel_iff_vcols_D3, vcols_cons_D3, vcol_append_D3, ← vrel_eq_vcols_D3]
    refine ⟨⟨hQ', hU' U (fun x hx => hx)⟩, ?_⟩
    rw [Hole.fill_eq_put]
    refine vrel_put_D3 Z _ _ _ ((routeOK_shift_D3 _ _ _ _).2 hR) ?_ ?_
    · have := vrel_shift_D3 hB sd.r (k * (sd.t - sd.r))
      rwa [show sd.r + 1 + k * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) + 1 by omega] at this
    · rw [routeNum_shift_D3]
      rwa [show sd.r + k * (sd.t - sd.r) + 1 + routeNum_D3 (sd.depth - rd.layer)
        (.node (F.cols.drop (rd.idx + 1))) = sd.t + k * (sd.t - sd.r) by omega]

theorem ordLoop_induct_D3 {step : Nat → Forest → Forest} {P : Nat → Forest → Prop}
    (hstep : ∀ k Z, 1 ≤ k → P k Z → P (k - 1) (step k Z)) :
    ∀ m Z, P m Z → P 0 (ordLoop step m Z)
  | 0, Z, h => h
  | m + 1, Z, h => ordLoop_induct_D3 hstep m _ (by simpa using hstep (m + 1) Z (by omega) h)


theorem ne_empty_of_stepKind_D3 {E : Forest} {k : StepKind} (h : stepKind E = some k) :
    E ≠ Tree.empty := by
  rintro rfl; simp [stepKind, stepKindBody, Tree.empty, Tree.cols] at h

/-- The ordinary output, unfolded: `B = A_{0,0,ℓ,Z}(A)` with `Z = ordZ A sd rd n`. -/
theorem ord_output_D3 {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .ordinary)
    (hB : expand A n = some B) :
    ∃ sd rd, stopData A = some sd ∧ rootData A = some rd ∧
      B = replaceAt 0 0 (ordZ A sd rd n) sd.depth A ∧
      ¬ (rd.owner = true ∧ n ≠ 0 ∧ ((A.colAt rd.col).getD []).drop rd.cursor = []) := by
  obtain ⟨sd, hsd⟩ := Option.isSome_iff_exists.mp (stopData_of_stepKind hk (by decide))
  obtain ⟨rd, hrd⟩ := Option.isSome_iff_exists.mp (rootData_of_ordinary hk)
  rw [expand_eq_paperOp (ne_empty_of_stepKind_D3 hk) hL.1 hL.2.1, paperOp_ordinary hk hsd hrd] at hB
  refine ⟨sd, rd, hsd, hrd, ?_⟩
  split at hB
  · cases hB
  · rename_i hc
    cases hB
    refine ⟨rfl, ?_⟩
    rintro ⟨h1, h2, h3⟩
    apply hc
    simp [h1, h2, h3]

/-- The data of an ordinary step used by the structural closure proofs. -/
theorem ord_vdata_D3 {A : Forest} {sd : StopData} {rd : RootData} (hV : CondV A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) :
    let F := (A.forestAt rd.col.path).getD Tree.empty
    let U := ((A.colAt rd.col).getD []).drop rd.cursor
    sd.r < sd.t ∧ VCol_D3 sd.t sd.Q ∧ VCol_D3 sd.r U ∧
    (rd.owner = false →
      RouteOK_D3 (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) ∧
      VRel_D3 (sd.r + 1) (.node (F.cols.drop (rd.idx + 1))) ∧
      sd.r + 1 + routeNum_D3 (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) = sd.t) ∧
    (rd.owner = true → ∀ x, U.getLast? = some x →
      RouteOK_D3 (sd.depth - rd.layer - 1) x.2 ∧
      sd.r + 1 + routeNum_D3 (sd.depth - rd.layer - 1) x.2 = sd.t) := by
  intro F U
  have hA := (condV_iff_vrel_D3 A).1 hV
  obtain ⟨-, -, hidx, hnum, hrt, hmem, -, -⟩ := rootData_spec hsd hrd
  obtain ⟨hle, hfa, hr, -, -, -⟩ := root_facts_D3 hsd hrd
  obtain ⟨hcolsd, -, ht, -⟩ := stopData_spec hsd
  have hF : F = skipLayers A rd.layer := by simp [F, hfa]
  refine ⟨hrt, ?_, ?_, ?_, ?_⟩
  · have := vrel_colAt_D3 hA hcolsd
    rw [ht]; exact ((vcol_append_D3 _ _ _).1 this).1
  · obtain ⟨R, hR⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff A rd.col).1 hmem)
    have := vrel_colAt_D3 hA hR
    rw [show rd.col.num 0 = sd.r from hnum] at this
    simp only [U, hR, Option.getD_some]
    exact vcol_sub_D3 this (fun x hx => List.mem_of_mem_drop hx)
  · intro hown
    obtain ⟨h1, h2⟩ := body_route_D3 hsd hrd hown
    rw [hF]
    refine ⟨h1, ?_, h2⟩
    have hG := vrel_forestAt_D3 hA hfa
    have hsum : (rd.col.path.map (·.1 + 1)).sum = leftCount A rd.layer := by
      have : rd.col.num 0 = (rd.col.path.map (·.1 + 1)).sum + rd.col.col := by
        simp [ColAddr.num]
      omega
    rw [Nat.zero_add, hsum] at hG
    rw [vrel_eq_vcols_D3] at hG
    rw [vrel_iff_vcols_D3]
    have := vcols_drop_D3 hG (rd.idx + 1)
    rwa [show leftCount A rd.layer + (rd.idx + 1) = sd.r + 1 by omega] at this
  · intro hown x hx
    obtain ⟨es, p, h, hc, h1, h2⟩ := owner_route_D3 hsd hrd hown
    have hx' : x = (p, h) := by
      simp only [U, hc, Option.getD_some, List.getLast?_drop] at hx
      split at hx
      · cases hx
      · simp at hx; exact hx.symm
    subst hx'
    exact ⟨h1, h2⟩


/-! ### Relative condition I -/

theorem Tree.treeMapCol_append_D3 (f : Nat → Nat) (l₁ l₂ : Column) :
    Tree.mapCol f (l₁ ++ l₂) = Tree.mapCol f l₁ ++ Tree.mapCol f l₂ := by
  simp [treeMapCol_eq_map]

/-- The column's first parent is at least the host (vacuous without a host). -/
def FirstOK_D3 (host : Option Nat) (col : Column) : Prop :=
  ∀ a, host = some a → ∃ q H rest, col = (q, H) :: rest ∧ a ≤ q

/-- The host number of column `c` (the outer host `host` at top level). -/
def hostNum_D3 (b : Nat) (host : Option Nat) (c : ColAddr) : Option Nat :=
  match c.path.getLast? with
  | none => host
  | some x => some (ColAddr.num b ⟨c.path.dropLast, x.1⟩)

/-- Relative condition I: every column's first parent is at least its host. -/
def IRel_D3 (b : Nat) (host : Option Nat) (F : Forest) : Prop :=
  ∀ c col, F.colAt c = some col → FirstOK_D3 (hostNum_D3 b host c) col

def ICols_D3 (b : Nat) (host : Option Nat) (cols : List Column) : Prop :=
  ∀ (j : Nat) (col : Column), cols[j]? = some col →
    FirstOK_D3 host col ∧ ∀ x ∈ col, IRel_D3 (b + j + 1) (some (b + j)) x.2

theorem hostNum_nil_D3 (b : Nat) (host : Option Nat) (k : Nat) :
    hostNum_D3 b host ⟨[], k⟩ = host := rfl

theorem hostNum_cons_D3 (b : Nat) (host : Option Nat) (j m : Nat) (P : List (Nat × Nat)) (k : Nat) :
    hostNum_D3 b host ⟨(j, m) :: P, k⟩ = hostNum_D3 (b + j + 1) (some (b + j)) ⟨P, k⟩ := by
  rcases List.eq_nil_or_concat' P with rfl | ⟨P', x, rfl⟩
  · simp [hostNum_D3, ColAddr.num]
  · simp only [hostNum_D3, ← List.cons_append, List.getLast?_append, List.getLast?_singleton,
      Option.some_or, List.dropLast_concat]
    rw [num_cons_D3]

theorem colAt_nil_D3 (cols : List Column) (k : Nat) :
    (Tree.node cols).colAt ⟨[], k⟩ = cols[k]? := rfl

theorem colAt_cons_D3 (cols : List Column) (j m : Nat) (P : List (Nat × Nat)) (k : Nat) :
    (Tree.node cols).colAt ⟨(j, m) :: P, k⟩ =
      ((cols[j]?).bind (·[m]?)).bind fun x => x.2.colAt ⟨P, k⟩ :=
  Tree.colAt_cons _ _ _ _ _

theorem irel_iff_icols_D3 (b : Nat) (host : Option Nat) (cols : List Column) :
    IRel_D3 b host (.node cols) ↔ ICols_D3 b host cols := by
  constructor
  · intro hI j col hj
    refine ⟨by simpa [hostNum_nil_D3] using hI ⟨[], j⟩ col (by rw [colAt_nil_D3]; exact hj), ?_⟩
    intro x hx c col' hc
    obtain ⟨m, hm⟩ := List.getElem?_of_mem hx
    obtain ⟨P, k⟩ := c
    have := hI ⟨(j, m) :: P, k⟩ col' (by rw [colAt_cons_D3, hj]; simp [hm, hc])
    rwa [hostNum_cons_D3] at this
  · intro hI c col hc
    obtain ⟨P, k⟩ := c
    cases P with
    | nil =>
      rw [colAt_nil_D3] at hc
      rw [hostNum_nil_D3]; exact (hI k col hc).1
    | cons ab P =>
      obtain ⟨j, m⟩ := ab
      rw [colAt_cons_D3] at hc
      cases hcj : cols[j]? with
      | none => simp [hcj] at hc
      | some cj =>
        cases hm : cj[m]? with
        | none => simp [hcj, hm] at hc
        | some x =>
          simp only [hcj, hm, Option.bind_some] at hc
          rw [hostNum_cons_D3]
          exact (hI j cj hcj).2 x (List.mem_of_getElem? hm) _ col hc

theorem irel_eq_icols_D3 (b : Nat) (host : Option Nat) (F : Forest) :
    IRel_D3 b host F ↔ ICols_D3 b host F.cols := by
  obtain ⟨cols⟩ := F; exact irel_iff_icols_D3 b host cols

theorem condI_iff_irel_D3 (E : Forest) : CondI E ↔ IRel_D3 0 none E := by
  constructor
  · intro hI c col hc a ha
    obtain ⟨P, k⟩ := c
    rcases List.eq_nil_or_concat' P with rfl | ⟨π, x, rfl⟩
    · simp [hostNum_D3] at ha
    obtain ⟨ci, ei⟩ := x
    simp only [hostNum_D3, List.getLast?_concat, List.dropLast_concat, Option.some.injEq] at ha
    subst ha
    have hfa : E.forestAt (π ++ [(ci, ei)]) = E.heightAt ⟨⟨π, ci⟩, ei⟩ :=
      Tree.forestAt_heightPath E ⟨⟨π, ci⟩, ei⟩
    cases hh : E.heightAt ⟨⟨π, ci⟩, ei⟩ with
    | none => simp [Tree.colAt, hfa, hh] at hc
    | some h =>
      simp only [Tree.colAt, hfa, hh, Option.bind_some] at hc
      obtain ⟨p, hp⟩ : ∃ p, E.entryAt ⟨⟨π, ci⟩, ei⟩ = some (p, h) := by
        simp only [Tree.heightAt] at hh
        cases he : E.entryAt ⟨⟨π, ci⟩, ei⟩ with
        | none => simp [he] at hh
        | some y => simp [he] at hh; exact ⟨y.1, by rw [← hh]⟩
      have hne : h ≠ Tree.empty := by
        rintro rfl; simp [Tree.empty, Tree.cols] at hc
      exact hI _ ((Tree.mem_entryAddrs_iff E _).2 (by rw [hp]; rfl)) p h hp hne col
        (List.mem_of_getElem? hc)
  · intro hI e _ p h he hne col hcol
    obtain ⟨k, hk⟩ := List.getElem?_of_mem hcol
    have hc : E.colAt ⟨e.heightPath, k⟩ = some col := by
      simp only [Tree.colAt, Tree.forestAt_heightPath, Tree.heightAt, he, Option.map_some,
        Option.bind_some]
      exact hk
    have := hI _ col hc (e.col.num 0)
    apply this
    simp [hostNum_D3, EntryAddr.heightPath]

theorem firstOK_mono_D3 {a a' : Nat} (h : a' ≤ a) {col : Column} (hc : FirstOK_D3 (some a) col) :
    FirstOK_D3 (some a') col := by
  intro x hx; cases hx
  obtain ⟨q, H, rest, rfl, hq⟩ := hc a rfl
  exact ⟨q, H, rest, rfl, le_trans h hq⟩

theorem firstOK_none_D3 (col : Column) : FirstOK_D3 none col := by
  intro a ha; cases ha

theorem firstOK_shift_D3 {host : Option Nat} {col : Column} (h : FirstOK_D3 host col) (r d : Nat) :
    FirstOK_D3 (host.map (shiftVal r d)) (Tree.mapCol (shiftVal r d) col) := by
  intro a ha
  cases host with
  | none => cases ha
  | some a0 =>
    simp only [Option.map_some, Option.some.injEq] at ha; subst ha
    obtain ⟨q, H, rest, rfl, hq⟩ := h a0 rfl
    exact ⟨_, _, _, rfl, shiftVal_mono_D3 r d hq⟩

/-- `FirstOK` reads only the first parent. -/
theorem firstOK_of_fst_D3 {host : Option Nat} {col col' : Column} (h : FirstOK_D3 host col)
    (hfst : ∀ x, col.head? = some x → ∃ y, col'.head? = some y ∧ y.1 = x.1) :
    FirstOK_D3 host col' := by
  intro a ha
  obtain ⟨q, H, rest, rfl, hq⟩ := h a ha
  obtain ⟨y, hy, hyq⟩ := hfst _ rfl
  cases col' with
  | nil => simp at hy
  | cons y' ys => simp at hy; subst hy; exact ⟨y'.1, y'.2, ys, rfl, by rw [hyq]; exact hq⟩

theorem hostNum_shift_D3 {b r : Nat} (hrb : r ≤ b) (d : Nat) (host : Option Nat) (c : ColAddr) :
    hostNum_D3 (b + d) (host.map (shiftVal r d)) c = (hostNum_D3 b host c).map (shiftVal r d) := by
  simp only [hostNum_D3]
  cases c.path.getLast? with
  | none => rfl
  | some x =>
    simp only [Option.map_some, Option.some.injEq]
    rw [num_add_D3]
    have : b ≤ ColAddr.num b ⟨c.path.dropLast, x.1⟩ := by simp only [ColAddr.num]; omega
    unfold shiftVal; rw [if_pos (by omega)]

theorem irel_shift_D3 {b : Nat} {host : Option Nat} {F : Forest} (h : IRel_D3 b host F) {r : Nat}
    (hrb : r ≤ b) (d : Nat) : IRel_D3 (b + d) (host.map (shiftVal r d)) (shift r d F) := by
  intro c col hc
  rw [shift, colAt_map_D3] at hc
  cases h' : F.colAt c with
  | none => simp [h'] at hc
  | some col0 =>
    simp only [h', Option.map_some, Option.some.injEq] at hc
    subst hc
    rw [hostNum_shift_D3 hrb]
    exact firstOK_shift_D3 (h c col0 h') r d

theorem irel_empty_D3 (b : Nat) (host : Option Nat) : IRel_D3 b host Tree.empty := by
  intro c col hc
  obtain ⟨P, k⟩ := c
  cases P with
  | nil => simp [Tree.colAt, Tree.forestAt, Tree.empty, Tree.cols] at hc
  | cons ab P => simp [Tree.colAt, Tree.forestAt, Tree.empty, Tree.cols] at hc

theorem icols_nil_D3 (b : Nat) (host : Option Nat) : ICols_D3 b host [] := by
  intro j col hj; simp at hj

theorem icols_cons_D3 (b : Nat) (host : Option Nat) (c : Column) (cs : List Column) :
    ICols_D3 b host (c :: cs) ↔
      (FirstOK_D3 host c ∧ ∀ x ∈ c, IRel_D3 (b + 1) (some b) x.2) ∧ ICols_D3 (b + 1) host cs := by
  constructor
  · intro h
    refine ⟨by simpa using h 0 c rfl, fun j col hj => ?_⟩
    have := h (j + 1) col (by simpa using hj)
    rwa [show b + (j + 1) = b + 1 + j by omega] at this
  · rintro ⟨h1, h2⟩ j col hj
    cases j with
    | zero => simp at hj; subst hj; simpa using h1
    | succ j =>
      have := h2 j col (by simpa using hj)
      rw [show b + (j + 1) = b + 1 + j by omega]; exact this

theorem icols_append_D3 (b : Nat) (host : Option Nat) (cs ds : List Column) :
    ICols_D3 b host (cs ++ ds) ↔ ICols_D3 b host cs ∧ ICols_D3 (b + cs.length) host ds := by
  induction cs generalizing b with
  | nil => simp [icols_nil_D3]
  | cons c cs ih =>
    rw [List.cons_append, icols_cons_D3, icols_cons_D3, ih]
    simp only [List.length_cons, show b + 1 + cs.length = b + (cs.length + 1) by omega, and_assoc]

theorem icols_single_D3 (b : Nat) (host : Option Nat) (c : Column) :
    ICols_D3 b host [c] ↔ FirstOK_D3 host c ∧ ∀ x ∈ c, IRel_D3 (b + 1) (some b) x.2 := by
  rw [icols_cons_D3]; simp [icols_nil_D3]

theorem icols_drop_D3 {b : Nat} {host : Option Nat} {cols : List Column}
    (h : ICols_D3 b host cols) (k : Nat) : ICols_D3 (b + k) host (cols.drop k) := by
  intro j col hj
  rw [List.getElem?_drop] at hj
  have := h (k + j) col hj
  rwa [show b + (k + j) = b + k + j by omega] at this

/-- The host of the route forest at depth `k`. -/
def routeHost_D3 : Nat → Option Nat → Nat → Forest → Option Nat
  | _, host, 0, _ => host
  | b, _, k + 1, F => routeHost_D3 (b + F.cols.length) (some (b + (F.cols.length - 1))) k (nextLayer F)

theorem irel_put_D3 (Z : Forest) : ∀ (k : Nat) (F : Forest) (b : Nat) (host : Option Nat),
    RouteOK_D3 k F → IRel_D3 b host F →
    IRel_D3 (b + routeNum_D3 k F) (routeHost_D3 b host k F) Z →
    IRel_D3 b host (replaceAt 0 0 Z k F)
  | 0, .node cols, b, host, hR, hF, hZ => by
    have hc : cols ≠ [] := hR
    rw [put_zero_D3 Z hc]
    obtain ⟨zc⟩ := Z
    simp only [routeNum_D3, routeHost_D3, Tree.cols] at hZ ⊢
    rw [irel_iff_icols_D3] at hF hZ ⊢
    have hlen : (cols.dropLast).length = cols.length - 1 := List.length_dropLast
    rw [icols_append_D3, hlen]
    refine ⟨?_, hZ⟩
    have := (List.dropLast_append_getLast hc)
    rw [← this, icols_append_D3] at hF
    exact hF.1
  | k + 1, F, b, host, hR, hF, hZ => by
    obtain ⟨cs, es, q, H, rfl, hR'⟩ := hR
    rw [put_succ_D3]
    simp only [routeNum_D3, routeHost_D3, nextLayer_snoc_D3, Tree.cols, List.length_append,
      List.length_singleton] at hZ
    rw [irel_iff_icols_D3, icols_append_D3, icols_single_D3] at hF ⊢
    obtain ⟨hF1, hF2, hF3⟩ := hF
    refine ⟨hF1, ?_, ?_⟩
    · refine firstOK_of_fst_D3 hF2 ?_
      intro x hx
      cases es with
      | nil => simp at hx; subst hx; exact ⟨_, rfl, rfl⟩
      | cons e es => simp at hx; subst hx; exact ⟨_, rfl, rfl⟩
    · intro x hx
      rw [List.mem_append, List.mem_singleton] at hx
      rcases hx with hx | rfl
      · exact hF3 x (List.mem_append_left _ hx)
      · refine irel_put_D3 Z k H _ _ hR' (hF3 (q, H) (by simp)) ?_
        have e1 : b + cs.length + 1 + routeNum_D3 k H = b + (cs.length + 1 + routeNum_D3 k H) := by
          omega
        have e2 : b + cs.length + 1 - 1 = b + cs.length := by omega
        rw [e1]
        convert hZ using 2
        · omega
        · rw [show b + (cs.length + 1 - 1) = b + cs.length by omega]


theorem routeHost_split_D3 : ∀ (k1 k2 b : Nat) (h : Option Nat) (F : Forest),
    routeHost_D3 b h (k1 + k2) F =
      routeHost_D3 (b + leftCount F k1) (routeHost_D3 b h k1 F) k2 (skipLayers F k1)
  | 0, k2, b, h, F => by simp [routeHost_D3, leftCount, skipLayers]
  | k1 + 1, k2, b, h, F => by
    rw [show k1 + 1 + k2 = (k1 + k2) + 1 by omega]
    simp only [routeHost_D3, leftCount, skipLayers]
    rw [routeHost_split_D3 k1 k2]
    congr 1; omega

theorem routeHost_shiftBase_D3 (δ : Nat) : ∀ (k b : Nat) (X : Option Nat) (F : Forest),
    routeHost_D3 (b + δ) (X.map (· + δ)) k F = (routeHost_D3 b X k F).map (· + δ)
  | 0, b, X, F => rfl
  | k + 1, b, X, F => by
    simp only [routeHost_D3]
    have := routeHost_shiftBase_D3 δ k (b + F.cols.length) (some (b + (F.cols.length - 1)))
      (nextLayer F)
    simp only [Option.map_some] at this
    rw [show b + δ + F.cols.length = b + F.cols.length + δ by omega,
      show b + δ + (F.cols.length - 1) = b + (F.cols.length - 1) + δ by omega]
    exact this

theorem routeHost_shift_D3 (r d : Nat) : ∀ (k b : Nat) (X : Option Nat) (F : Forest),
    routeHost_D3 b X k (shift r d F) = routeHost_D3 b X k F
  | 0, b, X, F => rfl
  | k + 1, b, X, F => by
    simp only [routeHost_D3]
    have hlen : (shift r d F).cols.length = F.cols.length := by
      obtain ⟨cols⟩ := F; simp [shift, Tree.map, Tree.cols, treeMapCols_eq_map]
    rw [hlen, show nextLayer (shift r d F) = shift r d (nextLayer F) from nextLayer_map_D3 _ _,
      routeHost_shift_D3 r d k]

theorem routeHost_bound_D3 : ∀ (k b : Nat) (h : Option Nat) (F : Forest) (a : Nat),
    RouteOK_D3 k F → routeHost_D3 b h k F = some a →
      h = some a ∨ (b ≤ a ∧ a < b + leftCount F k)
  | 0, b, h, F, a, _, hh => Or.inl hh
  | k + 1, b, h, F, a, hR, hh => by
    obtain ⟨cs, es, p, H, rfl, hR'⟩ := hR
    simp only [routeHost_D3, nextLayer_snoc_D3, Tree.cols, List.length_append,
      List.length_singleton] at hh
    rcases routeHost_bound_D3 k _ _ H a hR' hh with h1 | ⟨h1, h2⟩
    · simp at h1
      right; simp only [leftCount, Tree.cols, List.length_append, List.length_singleton]; omega
    · right; simp only [leftCount, Tree.cols, List.length_append, List.length_singleton,
        nextLayer_snoc_D3]
      omega

theorem routeOK_le_D3 : ∀ (k : Nat) (F : Forest) (j : Nat), RouteOK_D3 k F → j ≤ k → RouteOK_D3 j F
  | 0, F, j, h, hj => by rw [show j = 0 by omega]; exact h
  | k + 1, F, 0, h, _ => by
    obtain ⟨cs, es, p, H, rfl, -⟩ := h
    simp [RouteOK_D3, Tree.cols]
  | k + 1, F, j + 1, h, hj => by
    obtain ⟨cs, es, p, H, rfl, hR'⟩ := h
    exact ⟨cs, es, p, H, rfl, routeOK_le_D3 k H j hR' (by omega)⟩

theorem leftCount_mono_D3 (E : Forest) {j k : Nat} (h : j ≤ k) : leftCount E j ≤ leftCount E k := by
  induction k with
  | zero => rw [show j = 0 by omega]
  | succ k ih =>
    rcases Nat.lt_or_ge j (k + 1) with hj | hj
    · rw [leftCount_succ_D3]; have := ih (by omega); omega
    · rw [show j = k + 1 by omega]

theorem irel_skip_D3 : ∀ (k b : Nat) (host : Option Nat) (F : Forest), RouteOK_D3 k F →
    IRel_D3 b host F → IRel_D3 (b + leftCount F k) (routeHost_D3 b host k F) (skipLayers F k)
  | 0, b, host, F, _, h => by simpa [leftCount, skipLayers, routeHost_D3] using h
  | k + 1, b, host, F, hR, h => by
    obtain ⟨cs, es, p, H, rfl, hR'⟩ := hR
    simp only [leftCount, skipLayers, routeHost_D3, nextLayer_snoc_D3, Tree.cols,
      List.length_append, List.length_singleton]
    rw [irel_iff_icols_D3, icols_append_D3, icols_single_D3] at h
    have hH := h.2.2 (p, H) (by simp)
    have := irel_skip_D3 k _ _ H hR' hH
    rw [show b + (cs.length + 1 + leftCount H k) = b + cs.length + 1 + leftCount H k by omega,
      show b + (cs.length + 1) = b + cs.length + 1 by omega,
      show b + (cs.length + 1 - 1) = b + cs.length by omega]
    exact this

theorem vrel_skip_D3 : ∀ (k b : Nat) (F : Forest), RouteOK_D3 k F →
    VRel_D3 b F → VRel_D3 (b + leftCount F k) (skipLayers F k)
  | 0, b, F, _, h => by simpa [leftCount, skipLayers] using h
  | k + 1, b, F, hR, h => by
    obtain ⟨cs, es, p, H, rfl, hR'⟩ := hR
    simp only [leftCount, skipLayers, nextLayer_snoc_D3, Tree.cols,
      List.length_append, List.length_singleton]
    rw [vrel_iff_vcols_D3, vcols_append_D3, vcols_single_D3] at h
    have hH := (h.2 (p, H) (by simp)).2
    have := vrel_skip_D3 k _ H hR' hH
    rwa [show b + cs.length + 1 + leftCount H k = b + (cs.length + 1 + leftCount H k) by omega]
      at this

theorem irel_host_mono_D3 {b : Nat} {h h' : Option Nat} {F : Forest} (hF : IRel_D3 b h F)
    (hh : ∀ a', h' = some a' → ∃ a, h = some a ∧ a' ≤ a) : IRel_D3 b h' F := by
  intro c col hc
  have := hF c col hc
  simp only [hostNum_D3] at this ⊢
  cases hl : c.path.getLast? with
  | none =>
    rw [hl] at this
    intro a' ha'
    obtain ⟨a, rfl, ha⟩ := hh a' ha'
    exact firstOK_mono_D3 ha this a' rfl
  | some x => rw [hl] at this; exact this


theorem firstOK_map_fst_D3 {host : Option Nat} {col : Column} (h : FirstOK_D3 host col)
    (g : Nat × Forest → Nat × Forest) (hg : ∀ x, (g x).1 = x.1) : FirstOK_D3 host (col.map g) :=
  firstOK_of_fst_D3 h (fun x hx => ⟨g x, by cases col <;> simp_all, hg x⟩)

theorem firstOK_append_D3 {host : Option Nat} {l₁ l₂ : Column} (h : FirstOK_D3 host l₁)
    (hne : l₁ ≠ []) : FirstOK_D3 host (l₁ ++ l₂) :=
  firstOK_of_fst_D3 h (fun x hx => ⟨x, by cases l₁ <;> simp_all, rfl⟩)

theorem head_mapLast_fst_D3 {col : Column}
    (f g : Nat × Forest → Nat × Forest) (hf : ∀ x, (f x).1 = x.1) (hg : ∀ x, (g x).1 = x.1) :
    ∀ x, col.head? = some x → ∃ y, (mapLast f g col).head? = some y ∧ y.1 = x.1 := by
  intro x hx
  match col, hx with
  | [y], hx => simp at hx; subst hx; exact ⟨g y, by simp [mapLast], hg y⟩
  | y :: z :: zs, hx => simp at hx; subst hx; exact ⟨f y, by simp [mapLast], hf y⟩

/-- Step `k` of the ordinary loop keeps relative I, one phase down. -/
theorem irel_ordStep_D3 {sd : StopData} {rd : RootData} {F : Forest} {U : Column} {k : Nat}
    {Z : Forest} {hostSd : Option Nat} (hk : 1 ≤ k) (hrt : sd.r < sd.t)
    (hlt : ∀ a, hostSd = some a → a < sd.t)
    (hQ1 : FirstOK_D3 hostSd (sd.Q ++ [(sd.r, Tree.empty)]))
    (hQ2 : ∀ x ∈ sd.Q, IRel_D3 (sd.t + 1) (some sd.t) x.2)
    (hU2 : ∀ x ∈ U, IRel_D3 (sd.r + 1) (some sd.r) x.2)
    (hQnil : sd.Q = [] → ∀ a, hostSd = some a → a < sd.r ∧ FirstOK_D3 (some a) U)
    (hbodyR : rd.owner = false →
      RouteOK_D3 (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) ∧
      sd.r + 1 + routeNum_D3 (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) = sd.t)
    (hbody0 : rd.owner = false → sd.depth - rd.layer = 0 →
      IRel_D3 (sd.r + 1) hostSd (.node (F.cols.drop (rd.idx + 1))) ∧
      ∀ a, hostSd = some a → a < sd.r)
    (hbody1 : rd.owner = false → 1 ≤ sd.depth - rd.layer →
      IRel_D3 (sd.r + 1) (some sd.r) (.node (F.cols.drop (rd.idx + 1))) ∧
      routeHost_D3 (sd.r + 1) (some sd.r) (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) =
        hostSd ∧ ∀ a, hostSd = some a → sd.r ≤ a)
    (hownerR : rd.owner = true → ∀ x, U.getLast? = some x →
      RouteOK_D3 (sd.depth - rd.layer - 1) x.2 ∧
      sd.r + 1 + routeNum_D3 (sd.depth - rd.layer - 1) x.2 = sd.t)
    (howner : rd.owner = true → ∀ x, U.getLast? = some x →
      routeHost_D3 (sd.r + 1) (some sd.r) (sd.depth - rd.layer - 1) x.2 = hostSd ∧
      ∀ a, hostSd = some a → sd.r ≤ a)
    (hZ : IRel_D3 (sd.t + k * (sd.t - sd.r)) (hostSd.map (shiftVal sd.r (k * (sd.t - sd.r)))) Z) :
    IRel_D3 (sd.r + k * (sd.t - sd.r)) (hostSd.map (shiftVal sd.r ((k - 1) * (sd.t - sd.r))))
      (ordStep sd rd F U k Z) := by
  have key : sd.t + (k - 1) * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) := by
    obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
    simp only [Nat.add_sub_cancel, Nat.succ_mul]; omega
  -- the head column's heights
  have hQh : ∀ x ∈ Tree.mapCol (shiftVal sd.r ((k - 1) * (sd.t - sd.r))) sd.Q,
      IRel_D3 (sd.r + k * (sd.t - sd.r) + 1) (some (sd.r + k * (sd.t - sd.r))) x.2 := by
    intro x hx
    rw [treeMapCol_eq_map] at hx
    obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx
    have := irel_shift_D3 (hQ2 y hy) (r := sd.r) (by omega) ((k - 1) * (sd.t - sd.r))
    simp only [Option.map_some] at this
    rw [show shiftVal sd.r ((k - 1) * (sd.t - sd.r)) sd.t = sd.t + (k - 1) * (sd.t - sd.r) by
      unfold shiftVal; rw [if_pos (by omega)]] at this
    rw [show sd.t + 1 + (k - 1) * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) + 1 by omega, key] at this
    exact this
  have hUh : ∀ x ∈ U, IRel_D3 (sd.r + k * (sd.t - sd.r) + 1) (some (sd.r + k * (sd.t - sd.r)))
      (shift sd.r (k * (sd.t - sd.r)) x.2) := by
    intro x hx
    have := irel_shift_D3 (hU2 x hx) (r := sd.r) (by omega) (k * (sd.t - sd.r))
    simp only [Option.map_some] at this
    rw [show shiftVal sd.r (k * (sd.t - sd.r)) sd.r = sd.r + k * (sd.t - sd.r) by
      unfold shiftVal; rw [if_pos le_rfl]] at this
    rwa [show sd.r + 1 + k * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) + 1 by omega] at this
  -- the head column's first parent
  have hfirst : ∀ (rest : Column), (∀ x, U.head? = some x → ∃ y, rest.head? = some y ∧ y.1 = x.1) →
      FirstOK_D3 (hostSd.map (shiftVal sd.r ((k - 1) * (sd.t - sd.r))))
        (Tree.mapCol (shiftVal sd.r ((k - 1) * (sd.t - sd.r))) sd.Q ++ rest) := by
    intro rest hrest
    by_cases hQ : sd.Q = []
    · rw [hQ]
      simp only [Tree.mapCol, List.nil_append]
      intro a ha
      cases hs : hostSd with
      | none => rw [hs] at ha; cases ha
      | some a0 =>
        rw [hs] at ha
        simp only [Option.map_some, Option.some.injEq] at ha
        obtain ⟨h1, h2⟩ := hQnil hQ a0 hs
        rw [show shiftVal sd.r ((k - 1) * (sd.t - sd.r)) a0 = a0 by
          unfold shiftVal; rw [if_neg (by omega)]] at ha
        subst ha
        exact firstOK_of_fst_D3 h2 hrest a0 rfl
    · have h1 := firstOK_shift_D3 hQ1 sd.r ((k - 1) * (sd.t - sd.r))
      rw [Tree.treeMapCol_append_D3] at h1
      have hne : Tree.mapCol (shiftVal sd.r ((k - 1) * (sd.t - sd.r))) sd.Q ≠ [] := by
        rw [treeMapCol_eq_map]; simpa using hQ
      refine firstOK_of_fst_D3 h1 (fun x hx => ⟨x, ?_, rfl⟩)
      cases hq : Tree.mapCol (shiftVal sd.r ((k - 1) * (sd.t - sd.r))) sd.Q with
      | nil => exact absurd hq hne
      | cons y ys => rw [hq] at hx; simp at hx ⊢; exact hx
  unfold ordStep
  simp only
  split
  · rename_i hown
    rw [irel_iff_icols_D3, icols_single_D3]
    refine ⟨?_, ?_⟩
    · rw [List.append_assoc]
      refine hfirst _ (fun x hx => ?_)
      have e := mapLast_eq (fun x : Nat × Forest => (x.1, shift sd.r (k * (sd.t - sd.r)) x.2))
        (fun x : Nat × Forest => (x.1, Hole.fill ⟨x.2, sd.depth - rd.layer - 1⟩ sd.r
          (k * (sd.t - sd.r)) Z)) U
      rw [← e]
      exact head_mapLast_fst_D3 (fun x : Nat × Forest => (x.1, shift sd.r (k * (sd.t - sd.r)) x.2))
        (fun x : Nat × Forest => (x.1, Hole.fill ⟨x.2, sd.depth - rd.layer - 1⟩ sd.r
          (k * (sd.t - sd.r)) Z)) (fun _ => rfl) (fun _ => rfl) x hx
    · intro x hx
      rw [List.mem_append, List.mem_append] at hx
      rcases hx with (hx | hx) | hx
      · exact hQh x hx
      · obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx
        exact hUh y (List.mem_of_mem_dropLast hy)
      · cases hl : U.getLast? with
        | none => simp [hl] at hx
        | some u =>
          simp only [hl, Option.map_some, Option.toList_some, List.mem_singleton] at hx
          subst hx
          have hu : u ∈ U := List.mem_of_getLast? hl
          obtain ⟨hR, hN⟩ := hownerR hown u hl
          obtain ⟨hH, hge⟩ := howner hown u hl
          simp only
          rw [Hole.fill_eq_put]
          refine irel_put_D3 Z _ _ _ _ ((routeOK_shift_D3 _ _ _ _).2 hR) (hUh u hu) ?_
          rw [routeNum_shift_D3, routeHost_shift_D3]
          have := routeHost_shiftBase_D3 (k * (sd.t - sd.r)) (sd.depth - rd.layer - 1) (sd.r + 1)
            (some sd.r) u.2
          simp only [Option.map_some] at this
          rw [show sd.r + k * (sd.t - sd.r) + 1 = sd.r + 1 + k * (sd.t - sd.r) by omega,
            show sd.r + k * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) from rfl]
          rw [show sd.r + k * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) from rfl] at this
          rw [this, hH]
          rw [show sd.r + 1 + k * (sd.t - sd.r) + routeNum_D3 (sd.depth - rd.layer - 1) u.2 =
            sd.t + k * (sd.t - sd.r) by omega]
          have hmap : hostSd.map (· + k * (sd.t - sd.r)) = hostSd.map (shiftVal sd.r (k * (sd.t - sd.r))) := by
            cases hs : hostSd with
            | none => rfl
            | some a =>
              simp only [Option.map_some, Option.some.injEq]
              unfold shiftVal; rw [if_pos (hge a hs)]
          rw [hmap]; exact hZ
  · rename_i hown
    have hown' : rd.owner = false := by simpa using hown
    obtain ⟨hR, hN⟩ := hbodyR hown'
    rw [irel_iff_icols_D3, icols_cons_D3, ← irel_eq_icols_D3]
    refine ⟨⟨hfirst _ (fun x hx => ?_), ?_⟩, ?_⟩
    · cases U with
      | nil => simp at hx
      | cons u us =>
        simp at hx; subst hx
        exact ⟨(u.1, shift sd.r (k * (sd.t - sd.r)) u.2), by simp, rfl⟩
    · intro x hx
      rw [List.mem_append] at hx
      rcases hx with hx | hx
      · exact hQh x hx
      · obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx
        exact hUh y hy
    · rw [Hole.fill_eq_put]
      by_cases hd0 : sd.depth - rd.layer = 0
      · obtain ⟨hB, hlt'⟩ := hbody0 hown' hd0
        have hfix : ∀ δ, hostSd.map (shiftVal sd.r δ) = hostSd := by
          intro δ
          cases hs : hostSd with
          | none => rfl
          | some a =>
            simp only [Option.map_some, Option.some.injEq]
            unfold shiftVal; rw [if_neg (by have := hlt' a hs; omega)]
        rw [hfix]
        have hB' := irel_shift_D3 hB (r := sd.r) (by omega) (k * (sd.t - sd.r))
        rw [hfix, show sd.r + 1 + k * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) + 1 by omega] at hB'
        refine irel_put_D3 Z _ _ _ _ ((routeOK_shift_D3 _ _ _ _).2 hR) hB' ?_
        rw [routeNum_shift_D3, hd0]
        simp only [routeHost_D3]
        rw [hfix] at hZ
        rw [hd0] at hN
        rwa [show sd.r + k * (sd.t - sd.r) + 1 + routeNum_D3 0 (.node (F.cols.drop (rd.idx + 1))) =
          sd.t + k * (sd.t - sd.r) by omega]
      · obtain ⟨hB, hH, hge⟩ := hbody1 hown' (by omega)
        have hB' := irel_shift_D3 hB (r := sd.r) (by omega) (k * (sd.t - sd.r))
        simp only [Option.map_some] at hB'
        rw [show shiftVal sd.r (k * (sd.t - sd.r)) sd.r = sd.r + k * (sd.t - sd.r) by
          unfold shiftVal; rw [if_pos le_rfl],
          show sd.r + 1 + k * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) + 1 by omega] at hB'
        have hB'' : IRel_D3 (sd.r + k * (sd.t - sd.r) + 1)
            (hostSd.map (shiftVal sd.r ((k - 1) * (sd.t - sd.r))))
            (shift sd.r (k * (sd.t - sd.r)) (.node (F.cols.drop (rd.idx + 1)))) := by
          refine irel_host_mono_D3 hB' (fun a' ha' => ⟨_, rfl, ?_⟩)
          cases hs : hostSd with
          | none => rw [hs] at ha'; cases ha'
          | some a =>
            rw [hs] at ha'
            simp only [Option.map_some, Option.some.injEq] at ha'
            subst ha'
            have := hlt a hs
            have := shiftVal_le_D3 sd.r ((k - 1) * (sd.t - sd.r)) a
            omega
        refine irel_put_D3 Z _ _ _ _ ((routeOK_shift_D3 _ _ _ _).2 hR) hB'' ?_
        rw [routeNum_shift_D3, routeHost_shift_D3]
        obtain ⟨hd', hd'eq⟩ : ∃ hd', sd.depth - rd.layer = hd' + 1 := ⟨_, (Nat.succ_pred_eq_of_ne_zero hd0).symm⟩
        rw [hd'eq] at hH hN ⊢
        have hind : ∀ X Y : Option Nat, ∀ b,
            routeHost_D3 b X (hd' + 1) (.node (F.cols.drop (rd.idx + 1))) =
            routeHost_D3 b Y (hd' + 1) (.node (F.cols.drop (rd.idx + 1))) := fun _ _ _ => rfl
        rw [hind _ ((some sd.r).map (· + k * (sd.t - sd.r)))]
        have := routeHost_shiftBase_D3 (k * (sd.t - sd.r)) (hd' + 1) (sd.r + 1) (some sd.r)
          (.node (F.cols.drop (rd.idx + 1)))
        rw [show sd.r + k * (sd.t - sd.r) + 1 = sd.r + 1 + k * (sd.t - sd.r) by omega, this, hH]
        rw [show sd.r + 1 + k * (sd.t - sd.r) +
            routeNum_D3 (hd' + 1) (.node (F.cols.drop (rd.idx + 1))) = sd.t + k * (sd.t - sd.r) by
          omega]
        have hmap : hostSd.map (· + k * (sd.t - sd.r)) = hostSd.map (shiftVal sd.r (k * (sd.t - sd.r))) := by
          cases hs : hostSd with
          | none => rfl
          | some a =>
            simp only [Option.map_some, Option.some.injEq]
            unfold shiftVal; rw [if_pos (hge a hs)]
        rw [hmap]; exact hZ


theorem getElem_of_getLast_D3 {l : List Column} {x : Column} {k : Nat} (h : l.getLast? = some x)
    (hk : k + 1 = l.length) : l[k]? = some x := by
  rw [List.getLast?_eq_getElem?] at h; rwa [show k = l.length - 1 by omega]

/-- Data of an ordinary step for relative I, part 1: the stopping column and the root column. -/
theorem ord_idata1_D3 {A : Forest} {sd : StopData} {rd : RootData} (hI : CondI A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) :
    (∀ a, routeHost_D3 0 none sd.depth A = some a → a < sd.t) ∧
    FirstOK_D3 (routeHost_D3 0 none sd.depth A) (sd.Q ++ [(sd.r, Tree.empty)]) ∧
    (∀ x ∈ sd.Q, IRel_D3 (sd.t + 1) (some sd.t) x.2) ∧
    (∀ x ∈ ((A.colAt rd.col).getD []).drop rd.cursor, IRel_D3 (sd.r + 1) (some sd.r) x.2) := by
  have hA : IRel_D3 0 none A := (condI_iff_irel_D3 A).1 hI
  obtain ⟨h1, -, -, h4, -⟩ := stopData_core hsd
  obtain ⟨hRA, -⟩ := stop_route_top_D3 hsd
  obtain ⟨-, htd⟩ := stop_route_D3 hsd 0 (Nat.zero_le _)
  simp only [Nat.sub_zero, routeNum_D3] at htd
  obtain ⟨hle, -, hr, hidx, -, hcol⟩ := root_facts_D3 hsd hrd
  have hRj : RouteOK_D3 rd.layer A := routeOK_le_D3 _ _ _ hRA hle
  have hIj := irel_skip_D3 rd.layer 0 none A hRj hA
  have hId := irel_skip_D3 sd.depth 0 none A hRA hA
  rw [Nat.zero_add] at hIj hId
  rw [irel_eq_icols_D3] at hIj hId
  have hcolsd := getElem_of_getLast_D3 h4 h1
  obtain ⟨hQ1, hQ2⟩ := hId _ _ hcolsd
  refine ⟨?_, hQ1, ?_, ?_⟩
  · intro a ha
    rcases routeHost_bound_D3 _ _ _ _ a hRA ha with h | ⟨-, h⟩
    · cases h
    · omega
  · intro x hx
    have := hQ2 x (List.mem_append_left _ hx)
    rwa [show leftCount A sd.depth + sd.col.col = sd.t by omega] at this
  · intro x hx
    cases hc : A.colAt rd.col with
    | none => simp [hc] at hx
    | some R =>
      rw [hc, Option.getD_some] at hx
      rw [hcol] at hc
      have := (hIj _ _ hc).2 x (List.mem_of_mem_drop hx)
      rwa [← hr] at this

/-- Data of an ordinary step for relative I, part 2: an empty query. -/
theorem ord_idata2_D3 {A : Forest} {sd : StopData} {rd : RootData} (hL : InL A)
    (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd) (hrd : rootData A = some rd) :
    sd.Q = [] → ∀ a, routeHost_D3 0 none sd.depth A = some a →
      a < sd.r ∧ FirstOK_D3 (some a) (((A.colAt rd.col).getD []).drop rd.cursor) := by
  intro hQ a ha
  have hA : IRel_D3 0 none A := (condI_iff_irel_D3 A).1 hL.2.1
  obtain ⟨h1, -, -, h4, h5, -⟩ := stopData_core hsd
  obtain ⟨hRA, -⟩ := stop_route_top_D3 hsd
  obtain ⟨-, htd⟩ := stop_route_D3 hsd 0 (Nat.zero_le _)
  simp only [Nat.sub_zero, routeNum_D3] at htd
  obtain ⟨hle, -, hr, hidx, -, hcol⟩ := root_facts_D3 hsd hrd
  obtain ⟨-, hQ1, -, -⟩ := ord_idata1_D3 hL.2.1 hsd hrd
  have hpos : 0 < sd.depth := by
    rcases Nat.eq_zero_or_pos sd.depth with h0 | h0
    · rw [h0] at ha; simp [routeHost_D3] at ha
    · exact h0
  -- the host is the last container: `a + 1 = leftCount A depth`
  have ha1 : a + 1 = leftCount A sd.depth := by
    have := routeHost_split_D3 (sd.depth - 1) 1 0 none A
    rw [show sd.depth - 1 + 1 = sd.depth by omega, ha] at this
    simp only [routeHost_D3, Nat.zero_add] at this
    obtain ⟨col, p, hc, -⟩ := h5 (sd.depth - 1) (by omega)
    have hne : (skipLayers A (sd.depth - 1)).cols ≠ [] := by intro he; rw [he] at hc; simp at hc
    have hlen := List.length_pos_iff.2 hne
    have := leftCount_succ_D3 A (sd.depth - 1)
    rw [show sd.depth - 1 + 1 = sd.depth by omega] at this
    simp only [Option.some.injEq] at *
    omega
  have hns := (stepKind_ordinary_iff_unfold (ne_empty_of_stepKind_D3 hk) hL.1 hL.2.1).1 hk
  obtain ⟨sd', hsd', hspec, -⟩ := hns
  rw [hsd] at hsd'; cases hsd'
  have har : a ≤ sd.r := by
    rw [hQ] at hQ1
    obtain ⟨q, H, rest, he, hq⟩ := hQ1 a ha
    simp at he; omega
  have hne : sd.r ≠ a := by
    intro he; apply hspec; exact ⟨hpos, hQ, by omega⟩
  refine ⟨by omega, ?_⟩
  -- the root lies in the stopping forest
  have hj : rd.layer = sd.depth := by
    by_contra hj
    have := leftCount_succ_D3 A rd.layer
    have := leftCount_mono_D3 A (show rd.layer + 1 ≤ sd.depth by omega)
    omega
  have hcur : rd.cursor = 0 := by
    obtain ⟨-, -, -, -, -, -, hc, -⟩ := rootData_spec hsd hrd
    rw [hc, queryKeys, hQ]; exact cursor_nil_right _
  have hId := irel_skip_D3 sd.depth 0 none A hRA hA
  rw [Nat.zero_add, irel_eq_icols_D3] at hId
  rw [hcur, List.drop_zero]
  have hc' : A.colAt rd.col = (skipLayers A sd.depth).cols[rd.idx]? := by rw [hcol, hj]
  cases hc : A.colAt rd.col with
  | none => rw [hc] at hc'; rw [hj] at hidx; rw [List.getElem?_eq_getElem hidx] at hc'; cases hc'
  | some R =>
    rw [Option.getD_some]
    rw [hc] at hc'
    intro a' ha'; cases ha'
    exact (hId _ _ hc'.symm).1 a ha


/-- Data of an ordinary step for relative I, part 3: the body and the owner's last height. -/
theorem ord_idata3_D3 {A : Forest} {sd : StopData} {rd : RootData} (hL : InL A)
    (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd) (hrd : rootData A = some rd) :
    let hostSd := routeHost_D3 0 none sd.depth A
    let F := (A.forestAt rd.col.path).getD Tree.empty
    let U := ((A.colAt rd.col).getD []).drop rd.cursor
    (rd.owner = false → sd.depth - rd.layer = 0 →
      IRel_D3 (sd.r + 1) hostSd (.node (F.cols.drop (rd.idx + 1))) ∧
      ∀ a, hostSd = some a → a < sd.r) ∧
    (rd.owner = false → 1 ≤ sd.depth - rd.layer →
      IRel_D3 (sd.r + 1) (some sd.r) (.node (F.cols.drop (rd.idx + 1))) ∧
      routeHost_D3 (sd.r + 1) (some sd.r) (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) =
        hostSd ∧ ∀ a, hostSd = some a → sd.r ≤ a) ∧
    (rd.owner = true → ∀ x, U.getLast? = some x →
      routeHost_D3 (sd.r + 1) (some sd.r) (sd.depth - rd.layer - 1) x.2 = hostSd ∧
      ∀ a, hostSd = some a → sd.r ≤ a) := by
  intro hostSd F U
  have hA : IRel_D3 0 none A := (condI_iff_irel_D3 A).1 hL.2.1
  obtain ⟨-, -, -, -, h5, -⟩ := stopData_core hsd
  obtain ⟨hRA, -⟩ := stop_route_top_D3 hsd
  obtain ⟨hle, hfa, hr, hidx, howner, hcol⟩ := root_facts_D3 hsd hrd
  obtain ⟨-, -, hidx', hnum, -, -, -, -⟩ := rootData_spec hsd hrd
  obtain ⟨-, -, -, hpre, -⟩ := rootData_path hsd hrd
  have hF : F = skipLayers A rd.layer := by simp [F, hfa]
  have hRj : RouteOK_D3 rd.layer A := routeOK_le_D3 _ _ _ hRA hle
  have hIj := irel_skip_D3 rd.layer 0 none A hRj hA
  rw [Nat.zero_add, irel_eq_icols_D3] at hIj
  have hsplit : hostSd = routeHost_D3 (leftCount A rd.layer) (routeHost_D3 0 none rd.layer A)
      (sd.depth - rd.layer) (skipLayers A rd.layer) := by
    have := routeHost_split_D3 rd.layer (sd.depth - rd.layer) 0 none A
    rw [Nat.add_sub_cancel' hle, Nat.zero_add] at this
    exact this
  obtain ⟨hRs, -⟩ := stop_route_D3 hsd (sd.depth - rd.layer) (by omega)
  rw [show sd.depth - (sd.depth - rd.layer) = rd.layer by omega] at hRs
  rw [hF]
  refine ⟨?_, ?_, ?_⟩
  · intro hown hd0
    rw [hd0] at hsplit
    simp only [routeHost_D3] at hsplit
    refine ⟨?_, ?_⟩
    · rw [irel_iff_icols_D3, hsplit]
      have := icols_drop_D3 hIj (rd.idx + 1)
      rwa [show leftCount A rd.layer + (rd.idx + 1) = sd.r + 1 by omega] at this
    · intro a ha
      rw [hsplit] at ha
      rcases routeHost_bound_D3 _ _ _ _ a hRj ha with h | ⟨-, h⟩
      · cases h
      · omega
  · intro hown hd1
    obtain ⟨i, hi⟩ : ∃ i, sd.depth - rd.layer = i + 1 := ⟨_, (Nat.succ_pred_eq_of_ne_zero (by omega)).symm⟩
    rw [hi] at hRs hsplit ⊢
    obtain ⟨cs, es, p, h, hG, hR'⟩ := hRs
    have hlen : (skipLayers A rd.layer).cols.length = cs.length + 1 := by rw [hG]; simp [Tree.cols]
    have hlt : rd.idx + 1 < (skipLayers A rd.layer).cols.length := by
      have : ¬ rd.idx + 1 = (skipLayers A rd.layer).cols.length := by
        rw [← howner, hown]; simp
      omega
    have hdrop : (skipLayers A rd.layer).cols.drop (rd.idx + 1) =
        cs.drop (rd.idx + 1) ++ [es ++ [(p, h)]] := by
      rw [hG]; exact List.drop_append_of_le_length (by omega)
    have hsum : (rd.col.path.map (·.1 + 1)).sum = leftCount A rd.layer := by
      have : rd.col.num 0 = (rd.col.path.map (·.1 + 1)).sum + rd.col.col := by simp [ColAddr.num]
      omega
    refine ⟨?_, ?_, ?_⟩
    · rw [irel_iff_icols_D3]
      intro z col hz
      have hz' : (skipLayers A rd.layer).cols[rd.idx + 1 + z]? = some col := by
        rw [← List.getElem?_drop]; exact hz
      have hzlt : rd.idx + 1 + z < (skipLayers A rd.layer).cols.length :=
        (List.getElem?_eq_some_iff.1 hz').1
      refine ⟨?_, ?_⟩
      · -- the body column's first parent is at least `r` (T3.2j)
        have hres : sd.col.resolve 0 (sd.r + 1 + z) = some ⟨rd.col.path, rd.idx + 1 + z⟩ := by
          rw [ColAddr.resolve_spec]
          refine ⟨Or.inl ?_, ?_⟩
          · obtain ⟨col', p', hc', -, -, hpk⟩ := h5 rd.layer (by omega)
            refine ⟨rd.layer, _, _, hpk, ?_, ?_⟩
            · obtain ⟨t, ht⟩ := hpre
              obtain ⟨-, hlay, -⟩ := rootData_spec hsd hrd
              show rd.col.path = sd.col.path.take rd.layer
              rw [hlay, ← ht]; simp
            · simp only; omega
          · simp only [ColAddr.num]; omega
        have htt : sd.t = sd.col.num 0 := (stopData_spec hsd).2.2.1
        obtain ⟨q, H, rest, hc, hq⟩ := body_firstParent hL hk hsd (x := sd.r + 1 + z) (by omega)
          (by rw [htt]; exact ColAddr.resolve_lt hres) hres
        have : A.colAt ⟨rd.col.path, rd.idx + 1 + z⟩ = some col := by
          simp only [Tree.colAt, hfa, Option.bind_some]; exact hz'
        rw [this] at hc; cases hc
        intro a ha; cases ha
        exact ⟨q, H, rest, rfl, hq⟩
      · intro x hx
        have := (hIj _ _ hz').2 x hx
        rwa [show leftCount A rd.layer + (rd.idx + 1 + z) = sd.r + 1 + z by omega] at this
    · rw [hsplit, hdrop, hG]
      simp only [routeHost_D3, nextLayer_snoc_D3, Tree.cols, List.length_append,
        List.length_singleton]
      have e1 : sd.r + 1 + ((cs.drop (rd.idx + 1)).length + 1) = leftCount A rd.layer + (cs.length + 1) := by
        rw [List.length_drop]; omega
      have e2 : sd.r + 1 + ((cs.drop (rd.idx + 1)).length + 1 - 1) =
          leftCount A rd.layer + (cs.length + 1 - 1) := by
        rw [List.length_drop]; omega
      rw [e1, e2]
    · intro a ha
      rw [hsplit, hG] at ha
      simp only [routeHost_D3, nextLayer_snoc_D3, Tree.cols, List.length_append,
        List.length_singleton] at ha
      rcases routeHost_bound_D3 _ _ _ _ a hR' ha with h' | ⟨h', -⟩
      · simp at h'; omega
      · omega
  · intro hown x hx
    have hlt := rootData_layer_lt hsd hrd hown
    obtain ⟨i, hi⟩ : ∃ i, sd.depth - rd.layer = i + 1 := ⟨_, (Nat.succ_pred_eq_of_ne_zero (by omega)).symm⟩
    rw [hi] at hRs hsplit
    obtain ⟨cs, es, p, h, hG, hR'⟩ := hRs
    have hidx2 := howner.1 hown
    rw [hG] at hidx2 hcol
    simp only [Tree.cols, List.length_append, List.length_singleton] at hidx2
    have hcol' : A.colAt rd.col = some (es ++ [(p, h)]) := by
      rw [hcol]; simp [Tree.cols, show rd.idx = cs.length by omega]
    have hx' : x = (p, h) := by
      simp only [U, hcol', Option.getD_some, List.getLast?_drop] at hx
      split at hx
      · cases hx
      · simp at hx; exact hx.symm
    subst hx'
    rw [show sd.depth - rd.layer - 1 = i by omega]
    rw [hsplit, hG]
    simp only [routeHost_D3, nextLayer_snoc_D3, Tree.cols, List.length_append,
      List.length_singleton]
    refine ⟨?_, ?_⟩
    · congr 1
      · omega
      · congr 1; omega
    · intro a ha
      rcases routeHost_bound_D3 _ _ _ _ a hR' ha with h' | ⟨h', -⟩
      · simp at h'; omega
      · omega

-- T3.2k (txt:340-344): ordinary outputs satisfy V and I
theorem condV_ord {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .ordinary)
    (hB : expand A n = some B) : CondV B := by
  obtain ⟨sd, rd, hsd, hrd, rfl, -⟩ := ord_output_D3 hL hk hB
  obtain ⟨hrt, hQ, hU, hbody, howner⟩ := ord_vdata_D3 hL.1 hsd hrd
  obtain ⟨hR, hN⟩ := stop_route_top_D3 hsd
  rw [condV_iff_vrel_D3]
  refine vrel_put_D3 _ _ _ _ hR ((condV_iff_vrel_D3 A).1 hL.1) ?_
  rw [hN, Nat.zero_add]
  have := ordLoop_induct_D3 (step := ordStep sd rd ((A.forestAt rd.col.path).getD Tree.empty)
      (((A.colAt rd.col).getD []).drop rd.cursor))
    (P := fun k Z => VRel_D3 (sd.t + k * (sd.t - sd.r)) Z) ?_ n Tree.empty (vrel_empty_D3 _)
  · simpa [ordZ] using this
  · intro k Z hk1 hZ
    have := vrel_ordStep_D3 hk1 hrt hQ hU hbody howner hZ
    have e : sd.t + (k - 1) * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) := by
      obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
      simp only [Nat.add_sub_cancel, Nat.succ_mul]; omega
    show VRel_D3 (sd.t + (k - 1) * (sd.t - sd.r)) _
    rw [e]; exact this
theorem condI_ord {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .ordinary)
    (hB : expand A n = some B) : CondI B := by
  obtain ⟨sd, rd, hsd, hrd, rfl, -⟩ := ord_output_D3 hL hk hB
  obtain ⟨hrt, -, -, hbodyR, hownerR⟩ := ord_vdata_D3 hL.1 hsd hrd
  obtain ⟨hlt, hQ1, hQ2, hU2⟩ := ord_idata1_D3 hL.2.1 hsd hrd
  have hQnil := ord_idata2_D3 hL hk hsd hrd
  obtain ⟨hbody0, hbody1, howner⟩ := ord_idata3_D3 hL hk hsd hrd
  obtain ⟨hR, hN⟩ := stop_route_top_D3 hsd
  rw [condI_iff_irel_D3]
  refine irel_put_D3 _ _ _ _ _ hR ((condI_iff_irel_D3 A).1 hL.2.1) ?_
  rw [hN, Nat.zero_add]
  have := ordLoop_induct_D3 (step := ordStep sd rd ((A.forestAt rd.col.path).getD Tree.empty)
      (((A.colAt rd.col).getD []).drop rd.cursor))
    (P := fun k Z => IRel_D3 (sd.t + k * (sd.t - sd.r))
      ((routeHost_D3 0 none sd.depth A).map (shiftVal sd.r (k * (sd.t - sd.r)))) Z) ?_ n Tree.empty
    (irel_empty_D3 _ _)
  · simp only [Nat.zero_mul, Nat.add_zero, shiftVal_zero_fun, Option.map_id] at this
    simpa [ordZ] using this
  · intro k Z hk1 hZ
    have := irel_ordStep_D3 hk1 hrt hlt hQ1 hQ2 hU2 hQnil
      (fun h => ⟨(hbodyR h).1, (hbodyR h).2.2⟩) hbody0 hbody1 hownerR howner hZ
    have e : sd.t + (k - 1) * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) := by
      obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
      simp only [Nat.add_sub_cancel, Nat.succ_mul]; omega
    show IRel_D3 (sd.t + (k - 1) * (sd.t - sd.r)) _ _
    rw [e]; exact this

/-! ### Relative condition H -/

/-- The entries of a column are nonincreasing. -/
def ColH_D3 (col : Column) : Prop := List.IsChain (fun x y => EntryLe y x) col

def HRel_D3 (F : Forest) : Prop := ∀ c col, F.colAt c = some col → ColH_D3 col

def HCols_D3 (cols : List Column) : Prop :=
  ∀ (j : Nat) (col : Column), cols[j]? = some col → ColH_D3 col ∧ ∀ x ∈ col, HRel_D3 x.2

theorem hrel_iff_hcols_D3 (cols : List Column) : HRel_D3 (.node cols) ↔ HCols_D3 cols := by
  constructor
  · intro hH j col hj
    refine ⟨hH ⟨[], j⟩ col hj, ?_⟩
    intro x hx c col' hc
    obtain ⟨m, hm⟩ := List.getElem?_of_mem hx
    obtain ⟨P, k⟩ := c
    exact hH ⟨(j, m) :: P, k⟩ col' (by rw [Tree.colAt_cons]; simp [Tree.cols, hj, hm, hc])
  · intro hH c col hc
    obtain ⟨P, k⟩ := c
    cases P with
    | nil => exact (hH k col hc).1
    | cons ab P =>
      obtain ⟨j, m⟩ := ab
      rw [Tree.colAt_cons] at hc
      cases hcj : (Tree.node cols).cols[j]? with
      | none => simp [hcj] at hc
      | some cj =>
        cases hm : cj[m]? with
        | none => simp [hcj, hm] at hc
        | some x =>
          simp only [hcj, hm, Option.bind_some] at hc
          exact (hH j cj hcj).2 x (List.mem_of_getElem? hm) _ col hc

theorem hrel_eq_hcols_D3 (F : Forest) : HRel_D3 F ↔ HCols_D3 F.cols := by
  obtain ⟨cols⟩ := F; exact hrel_iff_hcols_D3 cols

theorem condH_iff_hrel_D3 (E : Forest) : CondH E ↔ HRel_D3 E := by
  constructor
  · intro hH c col hc
    have hmem : c ∈ E.colAddrs := (Tree.mem_colAddrs_iff E c).2 (by rw [hc]; rfl)
    rw [ColH_D3, List.isChain_iff_getElem]
    intro i hi
    exact hH c hmem i _ _ (by rw [hc]; simp [List.getElem?_eq_getElem (show i < col.length by omega)])
      (by rw [hc]; simp [List.getElem?_eq_getElem hi])
  · intro hH c hc i x y hx hy
    obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff E c).1 hc)
    rw [hcol, Option.getD_some] at hx hy
    have := hH c col hcol
    rw [ColH_D3, List.isChain_iff_getElem] at this
    obtain ⟨hi, rfl⟩ := List.getElem?_eq_some_iff.1 hy
    obtain ⟨hi', rfl⟩ := List.getElem?_eq_some_iff.1 hx
    exact this i hi

theorem hcols_nil_D3 : HCols_D3 [] := by intro j col hj; simp at hj

theorem hcols_cons_D3 (c : Column) (cs : List Column) :
    HCols_D3 (c :: cs) ↔ (ColH_D3 c ∧ ∀ x ∈ c, HRel_D3 x.2) ∧ HCols_D3 cs := by
  constructor
  · intro h
    exact ⟨h 0 c rfl, fun j col hj => h (j + 1) col (by simpa using hj)⟩
  · rintro ⟨h1, h2⟩ j col hj
    cases j with
    | zero => simp at hj; subst hj; exact h1
    | succ j => exact h2 j col (by simpa using hj)

theorem hcols_append_D3 (cs ds : List Column) :
    HCols_D3 (cs ++ ds) ↔ HCols_D3 cs ∧ HCols_D3 ds := by
  induction cs with
  | nil => simp [hcols_nil_D3]
  | cons c cs ih => rw [List.cons_append, hcols_cons_D3, hcols_cons_D3, ih]; simp only [and_assoc]

theorem hcols_single_D3 (c : Column) : HCols_D3 [c] ↔ ColH_D3 c ∧ ∀ x ∈ c, HRel_D3 x.2 := by
  rw [hcols_cons_D3]; simp [hcols_nil_D3]

theorem hcols_drop_D3 {cols : List Column} (h : HCols_D3 cols) (k : Nat) : HCols_D3 (cols.drop k) := by
  intro j col hj
  rw [List.getElem?_drop] at hj
  exact h (k + j) col hj

theorem hrel_empty_D3 : HRel_D3 Tree.empty := by
  rw [show (Tree.empty : Forest) = .node [] from rfl, hrel_iff_hcols_D3]; exact hcols_nil_D3

theorem hrel_colAt_D3 {F : Forest} (hF : HRel_D3 F) {c : ColAddr} {col : Column}
    (hc : F.colAt c = some col) : ColH_D3 col ∧ ∀ x ∈ col, HRel_D3 x.2 := by
  refine ⟨hF c col hc, ?_⟩
  intro x hx c' col' hc'
  obtain ⟨m, hm⟩ := List.getElem?_of_mem hx
  obtain ⟨P, k⟩ := c'
  have hG : F.forestAt c.path = some (.node ((F.forestAt c.path).getD Tree.empty).cols) := by
    cases hf : F.forestAt c.path with
    | none => simp [Tree.colAt, hf] at hc
    | some G => obtain ⟨gc⟩ := G; rfl
  have hcol : ((F.forestAt c.path).getD Tree.empty).cols[c.col]? = some col := by
    simp only [Tree.colAt] at hc
    cases hf : F.forestAt c.path with
    | none => simp [hf] at hc
    | some G => simp only [hf, Option.bind_some] at hc; simpa using hc
  have hf : F.forestAt (c.path ++ (c.col, m) :: P) = x.2.forestAt P := by
    rw [Tree.forestAt_append, hG]
    simp only [Option.bind_some]
    rw [Tree.forestAt_cons]
    have e : (Tree.node ((F.forestAt c.path).getD Tree.empty).cols).cols =
      ((F.forestAt c.path).getD Tree.empty).cols := rfl
    rw [e, hcol]; simp [hm]
  exact hF ⟨c.path ++ (c.col, m) :: P, k⟩ col' (by simp only [Tree.colAt]; rw [hf]; exact hc')

theorem hrel_forestAt_D3 {F : Forest} (hF : HRel_D3 F) {π : List (Nat × Nat)} {G : Forest}
    (hG : F.forestAt π = some G) : HRel_D3 G := by
  intro c col hc
  apply hF ⟨π ++ c.path, c.col⟩ col
  simp only [Tree.colAt, Tree.forestAt_append, hG, Option.bind_some]
  exact hc

/-! Shifts are order embeddings of forests. -/

theorem compare_shiftVal_D3 (r d x y : Nat) :
    compare (shiftVal r d x) (shiftVal r d y) = compare x y := by
  rcases lt_trichotomy x y with h | rfl | h
  · rw [compare_lt_iff_lt.2 h, compare_lt_iff_lt.2 (shiftVal_strictMono_D3 r d h)]
  · simp
  · rw [compare_gt_iff_gt.2 h, compare_gt_iff_gt.2 (shiftVal_strictMono_D3 r d h)]

theorem cmp_shift_D3 (r d : Nat) (X Y : Forest) :
    Tree.cmp compare (shift r d X) (shift r d Y) = Tree.cmp compare X Y :=
  Tree.cmp_map (compare_shiftVal_D3 r d) X Y

theorem shift_le_shift_D3 (r d : Nat) {X Y : Forest} (h : X ≤ Y) : shift r d X ≤ shift r d Y := by
  show Tree.cmp compare _ _ ≠ .gt
  rw [cmp_shift_D3]; exact h

theorem entryLe_shift_D3 (r d : Nat) {x y : Nat × Forest} (h : EntryLe y x) :
    EntryLe (shiftVal r d y.1, shift r d y.2) (shiftVal r d x.1, shift r d x.2) := by
  rcases h with h | ⟨h1, h2⟩
  · exact Or.inl (shiftVal_strictMono_D3 r d h)
  · exact Or.inr ⟨by rw [h1], shift_le_shift_D3 r d h2⟩

theorem colH_shift_D3 {col : Column} (h : ColH_D3 col) (r d : Nat) :
    ColH_D3 (Tree.mapCol (shiftVal r d) col) := by
  rw [ColH_D3, treeMapCol_eq_map, List.isChain_map]
  exact h.imp (fun a b hab => entryLe_shift_D3 r d hab)

theorem colH_shiftH_D3 {col : Column} (h : ColH_D3 col) (r d : Nat) :
    ColH_D3 (col.map fun x => (x.1, shift r d x.2)) := by
  rw [ColH_D3, List.isChain_map]
  refine h.imp (fun a b hab => ?_)
  rcases hab with h | ⟨h1, h2⟩
  · exact Or.inl h
  · exact Or.inr ⟨h1, shift_le_shift_D3 r d h2⟩

theorem hrel_shift_D3 {F : Forest} (h : HRel_D3 F) (r d : Nat) : HRel_D3 (shift r d F) := by
  intro c col hc
  rw [shift, colAt_map_D3] at hc
  cases h' : F.colAt c with
  | none => simp [h'] at hc
  | some col0 =>
    simp only [h', Option.map_some, Option.some.injEq] at hc
    subst hc
    exact colH_shift_D3 (h c col0 h') r d

/-! Route replacement and the order. -/

/-- The route column at depth `k`. -/
def routeCol_D3 (k : Nat) (F : Forest) : Column := ((skipLayers F k).cols.getLast?).getD []

theorem cmpCol_self_D3 (x : Column) : Tree.cmpCol (compare : Nat → Nat → Ordering) x x = .eq := by
  have : Tree.cmp (compare : Nat → Nat → Ordering) (Tree.node [x]) (Tree.node [x]) = .eq :=
    Std.ReflCmp.compare_self
  simp only [Tree.cmp, Tree.cmpCols] at this
  cases h : Tree.cmpCol compare x x <;> simp_all [Ordering.then]

theorem cmpCols_append_left_D3 (P a b : List Column) :
    Tree.cmpCols (compare : Nat → Nat → Ordering) (P ++ a) (P ++ b) = Tree.cmpCols compare a b := by
  induction P with
  | nil => rfl
  | cons x P ih => simp only [List.cons_append, Tree.cmpCols, cmpCol_self_D3, ih, Ordering.then]

theorem cmpCol_append_left_D3 (P a b : Column) :
    Tree.cmpCol (compare : Nat → Nat → Ordering) (P ++ a) (P ++ b) = Tree.cmpCol compare a b := by
  induction P with
  | nil => rfl
  | cons x P ih =>
    obtain ⟨p, h⟩ := x
    simp only [List.cons_append, Tree.cmpCol, ih]
    have : Tree.cmp (compare : Nat → Nat → Ordering) h h = .eq := Std.ReflCmp.compare_self
    simp [this, Ordering.then]

theorem cmp_put_D3 (Z Z' : Forest) : ∀ (k : Nat) (F : Forest), RouteOK_D3 k F →
    Tree.cmp compare (replaceAt 0 0 Z k F) (replaceAt 0 0 Z' k F) = Tree.cmp compare Z Z'
  | 0, .node cols, hR => by
    have hc : cols ≠ [] := hR
    rw [put_zero_D3 Z hc, put_zero_D3 Z' hc]
    obtain ⟨zc⟩ := Z; obtain ⟨zc'⟩ := Z'
    simp only [Tree.cmp, Tree.cols]
    exact cmpCols_append_left_D3 _ _ _
  | k + 1, F, hR => by
    obtain ⟨cs, es, q, H, rfl, hR'⟩ := hR
    rw [put_succ_D3, put_succ_D3]
    simp only [Tree.cmp]
    rw [cmpCols_append_left_D3]
    simp only [Tree.cmpCols, cmpCol_append_left_D3, Tree.cmpCol, cmp_put_D3 Z Z' k H hR']
    rw [show compare q q = Ordering.eq from compare_eq_iff_eq.2 rfl]
    cases Tree.cmp compare Z Z' <;> rfl

theorem put_self_D3 : ∀ (k : Nat) (F : Forest), RouteOK_D3 k F →
    replaceAt 0 0 (.node [routeCol_D3 k F]) k F = F
  | 0, .node cols, hR => by
    have hc : cols ≠ [] := hR
    rw [put_zero_D3 _ hc]
    simp only [routeCol_D3, skipLayers, Tree.cols]
    obtain ⟨l, hl⟩ : ∃ l, cols.getLast? = some l := by
      cases h : cols.getLast? with
      | none => simp at h; exact absurd h hc
      | some l => exact ⟨l, rfl⟩
    rw [hl, Option.getD_some]
    obtain ⟨ys, rfl⟩ := List.getLast?_eq_some_iff.1 hl
    simp
  | k + 1, F, hR => by
    obtain ⟨cs, es, q, H, rfl, hR'⟩ := hR
    rw [put_succ_D3]
    have : routeCol_D3 (k + 1) (.node (cs ++ [es ++ [(q, H)]])) = routeCol_D3 k H := by
      simp only [routeCol_D3, skipLayers, nextLayer_snoc_D3]
    rw [this, put_self_D3 k H hR']

theorem put_le_D3 {Z : Forest} {k : Nat} {F : Forest} (hR : RouteOK_D3 k F)
    (hZ : Z ≤ .node [routeCol_D3 k F]) : replaceAt 0 0 Z k F ≤ F := by
  have h1 := cmp_put_D3 Z (.node [routeCol_D3 k F]) k F hR
  rw [put_self_D3 k F hR] at h1
  show Tree.cmp compare _ _ ≠ .gt
  rw [h1]; exact hZ

theorem put_lt_D3 {Z : Forest} {k : Nat} {F : Forest} (hR : RouteOK_D3 k F)
    (hZ : Z < .node [routeCol_D3 k F]) : replaceAt 0 0 Z k F < F := by
  have h1 := cmp_put_D3 Z (.node [routeCol_D3 k F]) k F hR
  rw [put_self_D3 k F hR] at h1
  show Tree.cmp compare _ _ = .lt
  rw [h1]; exact hZ

theorem colH_snoc_D3 {l : Column} {a : Nat × Forest} :
    ColH_D3 (l ++ [a]) ↔ ColH_D3 l ∧ ∀ x ∈ l.getLast?, EntryLe a x := by
  rw [ColH_D3, List.isChain_append]
  simp [ColH_D3]

theorem entryLe_trans_le_D3 {x y : Nat × Forest} {h' : Forest} (h : EntryLe y x)
    (hh : h' ≤ y.2) : EntryLe (y.1, h') x := by
  rcases h with h | ⟨h1, h2⟩
  · exact Or.inl h
  · exact Or.inr ⟨h1, le_trans hh h2⟩

theorem hrel_put_D3 (Z : Forest) : ∀ (k : Nat) (F : Forest), RouteOK_D3 k F → HRel_D3 F →
    HRel_D3 Z → Z ≤ .node [routeCol_D3 k F] → HRel_D3 (replaceAt 0 0 Z k F)
  | 0, .node cols, hR, hF, hZ, _ => by
    have hc : cols ≠ [] := hR
    rw [put_zero_D3 Z hc]
    obtain ⟨zc⟩ := Z
    simp only [Tree.cols]
    rw [hrel_iff_hcols_D3] at hF hZ ⊢
    rw [hcols_append_D3]
    refine ⟨?_, hZ⟩
    rw [← List.dropLast_append_getLast hc, hcols_append_D3] at hF
    exact hF.1
  | k + 1, F, hR, hF, hZ, hle => by
    obtain ⟨cs, es, q, H, rfl, hR'⟩ := hR
    have hle' : Z ≤ .node [routeCol_D3 k H] := by
      simpa [routeCol_D3, skipLayers, nextLayer_snoc_D3] using hle
    rw [put_succ_D3]
    rw [hrel_iff_hcols_D3, hcols_append_D3, hcols_single_D3] at hF ⊢
    obtain ⟨hF1, hF2, hF3⟩ := hF
    refine ⟨hF1, ?_, ?_⟩
    · rw [colH_snoc_D3] at hF2 ⊢
      refine ⟨hF2.1, fun x hx => ?_⟩
      exact entryLe_trans_le_D3 (hF2.2 x hx) (put_le_D3 hR' hle')
    · intro x hx
      rw [List.mem_append, List.mem_singleton] at hx
      rcases hx with hx | rfl
      · exact hF3 x (List.mem_append_left _ hx)
      · exact hrel_put_D3 Z k H hR' (hF3 (q, H) (by simp)) hZ hle'


theorem routeCol_shift_D3 (r d : Nat) : ∀ (k : Nat) (F : Forest),
    routeCol_D3 k (shift r d F) = Tree.mapCol (shiftVal r d) (routeCol_D3 k F)
  | 0, .node cols => by
    simp only [routeCol_D3, skipLayers, shift, Tree.map, Tree.cols, treeMapCols_eq_map,
      List.getLast?_map]
    cases cols.getLast? <;> rfl
  | k + 1, F => by
    simp only [routeCol_D3, skipLayers]
    rw [show nextLayer (shift r d F) = shift r d (nextLayer F) from nextLayer_map_D3 _ _]
    exact routeCol_shift_D3 r d k (nextLayer F)

/-- A head column `Q' ⌢ V` whose continuation starts below the closing parent `ρ` is smaller
than the stopping column `Q' ⌢ [(ρ, ∅)]`. -/
theorem head_lt_D3 {Q' V : Column} {rest : List Column} {ρ : Nat}
    (hV : ∀ v ∈ V.head?, v.1 < ρ) :
    (Tree.node ((Q' ++ V) :: rest) : Forest) < .node [Q' ++ [(ρ, Tree.empty)]] := by
  show Tree.cmp compare _ _ = .lt
  simp only [Tree.cmp, Tree.cmpCols, cmpCol_append_left_D3]
  cases V with
  | nil => rfl
  | cons v vs =>
    have : compare v.1 ρ = .lt := compare_lt_iff_lt.2 (hV v (by simp))
    obtain ⟨p, h⟩ := v
    simp only [Tree.cmpCol] at this ⊢
    rw [this]; rfl

/-- Step `k` of the ordinary loop keeps relative H, and its output lies below the stopping column
of the previous phase. -/
theorem hrel_ordStep_D3 {sd : StopData} {rd : RootData} {F : Forest} {U : Column} {k : Nat}
    {Z : Forest}
    (hQ : ColH_D3 (sd.Q ++ [(sd.r, Tree.empty)])) (hQh : ∀ x ∈ sd.Q, HRel_D3 x.2)
    (hU : ColH_D3 U) (hUh : ∀ x ∈ U, HRel_D3 x.2) (hUr : ∀ x ∈ U, x.1 < sd.r)
    (hbody : rd.owner = false →
      RouteOK_D3 (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) ∧
      HRel_D3 (.node (F.cols.drop (rd.idx + 1))) ∧
      routeCol_D3 (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) = sd.Q ++ [(sd.r, Tree.empty)])
    (howner : rd.owner = true → ∀ x, U.getLast? = some x →
      RouteOK_D3 (sd.depth - rd.layer - 1) x.2 ∧
      routeCol_D3 (sd.depth - rd.layer - 1) x.2 = sd.Q ++ [(sd.r, Tree.empty)])
    (hZ : HRel_D3 Z)
    (hZle : Z ≤ .node [Tree.mapCol (shiftVal sd.r (k * (sd.t - sd.r))) (sd.Q ++ [(sd.r, Tree.empty)])]) :
    HRel_D3 (ordStep sd rd F U k Z) ∧
      ordStep sd rd F U k Z <
        .node [Tree.mapCol (shiftVal sd.r ((k - 1) * (sd.t - sd.r))) (sd.Q ++ [(sd.r, Tree.empty)])] := by
  set δ := (k - 1) * (sd.t - sd.r) with hδ
  set Q' := Tree.mapCol (shiftVal sd.r δ) sd.Q with hQ'
  have hmapQ : Tree.mapCol (shiftVal sd.r δ) (sd.Q ++ [(sd.r, Tree.empty)]) =
      Q' ++ [(shiftVal sd.r δ sd.r, Tree.empty)] := by
    simp [hQ', treeMapCol_eq_map, Tree.map, Tree.mapCols, Tree.empty]
  rw [colH_snoc_D3] at hQ
  have hQ'c : ColH_D3 Q' := colH_shift_D3 hQ.1 _ _
  have hQr : ∀ x ∈ Q'.getLast?, sd.r ≤ x.1 := by
    intro x hx
    rw [hQ', treeMapCol_eq_map, List.getLast?_map] at hx
    cases hl : sd.Q.getLast? with
    | none => rw [hl] at hx; cases hx
    | some q =>
      rw [hl] at hx; simp only [Option.map_some, Option.mem_def, Option.some.injEq] at hx
      subst hx
      have := hQ.2 q hl
      have h2 := le_shiftVal_D3 sd.r δ q.1
      simp only
      rcases this with h | ⟨h, -⟩ <;> omega
  have hQ'h : ∀ x ∈ Q', HRel_D3 x.2 := by
    intro x hx
    rw [hQ', treeMapCol_eq_map] at hx
    obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx
    exact hrel_shift_D3 (hQh y hy) _ _
  -- the head: `Q'` followed by a continuation `V` with the parents of `U`
  have hhead : ∀ V : Column, ColH_D3 V → (∀ v ∈ V.head?, v.1 < sd.r) →
      ColH_D3 (Q' ++ V) := by
    intro V hV hVr
    rw [ColH_D3, List.isChain_append]
    refine ⟨hQ'c, hV, fun x hx y hy => Or.inl ?_⟩
    have := hQr x hx; have := hVr y hy; omega
  have hρ : sd.r ≤ shiftVal sd.r δ sd.r := le_shiftVal_D3 _ _ _
  unfold ordStep
  simp only
  rw [← hδ, ← hQ', hmapQ]
  split
  · rename_i hown
    have hcols : ColH_D3 (U.dropLast.map (fun x => (x.1, shift sd.r (k * (sd.t - sd.r)) x.2)) ++
        (U.getLast?.map fun x => (x.1, Hole.fill ⟨x.2, sd.depth - rd.layer - 1⟩ sd.r
          (k * (sd.t - sd.r)) Z)).toList) := by
      cases hl : U.getLast? with
      | none =>
        have : U = [] := by simpa using hl
        subst this; simp [ColH_D3]
      | some u =>
        obtain ⟨R, rfl⟩ := List.getLast?_eq_some_iff.1 hl
        simp only [List.dropLast_concat, Option.map_some, Option.toList_some]
        rw [colH_snoc_D3] at hU ⊢
        refine ⟨colH_shiftH_D3 hU.1 _ _, fun x hx => ?_⟩
        rw [List.getLast?_map] at hx
        cases hR : R.getLast? with
        | none => rw [hR] at hx; cases hx
        | some w =>
          rw [hR] at hx; simp only [Option.map_some, Option.mem_def, Option.some.injEq] at hx
          subst hx
          obtain ⟨hRo, hRc⟩ := howner hown u (by simp)
          have hle : Hole.fill ⟨u.2, sd.depth - rd.layer - 1⟩ sd.r (k * (sd.t - sd.r)) Z ≤
              shift sd.r (k * (sd.t - sd.r)) u.2 := by
            rw [Hole.fill_eq_put]
            refine put_le_D3 ((routeOK_shift_D3 _ _ _ _).2 hRo) ?_
            rw [routeCol_shift_D3, hRc]; exact hZle
          rcases hU.2 w hR with h | ⟨h1, h2⟩
          · exact Or.inl h
          · exact Or.inr ⟨h1, le_trans hle (shift_le_shift_D3 _ _ h2)⟩
    have hVr : ∀ v ∈ (U.dropLast.map (fun x => (x.1, shift sd.r (k * (sd.t - sd.r)) x.2)) ++
        (U.getLast?.map fun x => (x.1, Hole.fill ⟨x.2, sd.depth - rd.layer - 1⟩ sd.r
          (k * (sd.t - sd.r)) Z)).toList).head?, v.1 < sd.r := by
      intro v hv
      have e := mapLast_eq (fun x : Nat × Forest => (x.1, shift sd.r (k * (sd.t - sd.r)) x.2))
        (fun x : Nat × Forest => (x.1, Hole.fill ⟨x.2, sd.depth - rd.layer - 1⟩ sd.r
          (k * (sd.t - sd.r)) Z)) U
      rw [← e] at hv
      cases hU0 : U.head? with
      | none =>
        cases U with
        | nil => simp [mapLast] at hv
        | cons _ _ => simp at hU0
      | some u0 =>
        obtain ⟨y, hy, hyu⟩ := head_mapLast_fst_D3
          (fun x : Nat × Forest => (x.1, shift sd.r (k * (sd.t - sd.r)) x.2))
          (fun x : Nat × Forest => (x.1, Hole.fill ⟨x.2, sd.depth - rd.layer - 1⟩ sd.r
            (k * (sd.t - sd.r)) Z)) (fun _ => rfl) (fun _ => rfl) u0 hU0
        rw [hy] at hv; cases hv
        rw [hyu]; exact hUr u0 (List.mem_of_head? hU0)
    refine ⟨?_, ?_⟩
    · rw [hrel_iff_hcols_D3, hcols_single_D3, List.append_assoc]
      refine ⟨hhead _ hcols hVr, fun x hx => ?_⟩
      rw [List.mem_append, List.mem_append] at hx
      rcases hx with hx | hx | hx
      · exact hQ'h x hx
      · obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx
        exact hrel_shift_D3 (hUh y (List.mem_of_mem_dropLast hy)) _ _
      · cases hl : U.getLast? with
        | none => simp [hl] at hx
        | some u =>
          simp only [hl, Option.map_some, Option.toList_some, List.mem_singleton] at hx
          subst hx
          obtain ⟨hRo, hRc⟩ := howner hown u hl
          simp only
          rw [Hole.fill_eq_put]
          refine hrel_put_D3 Z _ _ ((routeOK_shift_D3 _ _ _ _).2 hRo)
            (hrel_shift_D3 (hUh u (List.mem_of_getLast? hl)) _ _) hZ ?_
          rw [routeCol_shift_D3, hRc]; exact hZle
    · rw [List.append_assoc]
      have := head_lt_D3 (Q' := Q') (rest := []) (ρ := shiftVal sd.r δ sd.r) (fun v hv =>
        lt_of_lt_of_le (hVr v hv) hρ)
      exact this
  · rename_i hown
    have hown' : rd.owner = false := by simpa using hown
    obtain ⟨hR, hB, hRc⟩ := hbody hown'
    have hVr : ∀ v ∈ (U.map fun x => (x.1, shift sd.r (k * (sd.t - sd.r)) x.2)).head?, v.1 < sd.r := by
      intro v hv
      cases U with
      | nil => simp at hv
      | cons u us => simp at hv; subst hv; exact hUr u (by simp)
    refine ⟨?_, head_lt_D3 (fun v hv => lt_of_lt_of_le (hVr v hv) hρ)⟩
    rw [hrel_iff_hcols_D3, hcols_cons_D3, ← hrel_eq_hcols_D3]
    refine ⟨⟨hhead _ (colH_shiftH_D3 hU _ _) hVr, fun x hx => ?_⟩, ?_⟩
    · rw [List.mem_append] at hx
      rcases hx with hx | hx
      · exact hQ'h x hx
      · obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx
        exact hrel_shift_D3 (hUh y hy) _ _
    · rw [Hole.fill_eq_put]
      refine hrel_put_D3 Z _ _ ((routeOK_shift_D3 _ _ _ _).2 hR) (hrel_shift_D3 hB _ _) hZ ?_
      rw [routeCol_shift_D3, hRc]; exact hZle


theorem routeCol_skip_D3 (F : Forest) (k : Nat) : routeCol_D3 k F = routeCol_D3 0 (skipLayers F k) := by
  simp [routeCol_D3, skipLayers]

/-- Data of an ordinary step for relative H. -/
theorem ord_hdata_D3 {A : Forest} {sd : StopData} {rd : RootData} (hH : CondH A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) :
    let F := (A.forestAt rd.col.path).getD Tree.empty
    let U := ((A.colAt rd.col).getD []).drop rd.cursor
    ColH_D3 (sd.Q ++ [(sd.r, Tree.empty)]) ∧ (∀ x ∈ sd.Q, HRel_D3 x.2) ∧
    ColH_D3 U ∧ (∀ x ∈ U, HRel_D3 x.2) ∧
    (rd.owner = false → HRel_D3 (.node (F.cols.drop (rd.idx + 1))) ∧
      routeCol_D3 (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) =
        sd.Q ++ [(sd.r, Tree.empty)]) ∧
    (rd.owner = true → ∀ x, U.getLast? = some x →
      routeCol_D3 (sd.depth - rd.layer - 1) x.2 = sd.Q ++ [(sd.r, Tree.empty)]) := by
  intro F U
  have hA := (condH_iff_hrel_D3 A).1 hH
  obtain ⟨h1, -, -, h4, -⟩ := stopData_core hsd
  obtain ⟨hcolsd, -⟩ := stopData_spec hsd
  obtain ⟨hle, hfa, hr, hidx, howner, hcol⟩ := root_facts_D3 hsd hrd
  obtain ⟨-, -, -, -, -, hmem, -, -⟩ := rootData_spec hsd hrd
  have hF : F = skipLayers A rd.layer := by simp [F, hfa]
  obtain ⟨hQc, hQh⟩ := hrel_colAt_D3 hA hcolsd
  obtain ⟨R, hR⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff A rd.col).1 hmem)
  obtain ⟨hRc, hRh⟩ := hrel_colAt_D3 hA hR
  have hU : U = R.drop rd.cursor := by simp [U, hR]
  have hlast : ∀ m, rd.layer + m = sd.depth → routeCol_D3 m (skipLayers A rd.layer) =
      sd.Q ++ [(sd.r, Tree.empty)] := by
    intro m hm
    rw [routeCol_skip_D3, skipLayers_add, hm]
    simp [routeCol_D3, skipLayers, h4]
  refine ⟨hQc, fun x hx => hQh x (List.mem_append_left _ hx), ?_, ?_, ?_, ?_⟩
  · rw [hU]; exact hRc.drop _
  · rw [hU]; exact fun x hx => hRh x (List.mem_of_mem_drop hx)
  · intro hown
    rw [hF]
    have hlt : rd.idx + 1 < (skipLayers A rd.layer).cols.length := by
      have : ¬ rd.idx + 1 = (skipLayers A rd.layer).cols.length := by rw [← howner, hown]; simp
      omega
    refine ⟨?_, ?_⟩
    · rw [hrel_iff_hcols_D3]
      exact hcols_drop_D3 ((hrel_eq_hcols_D3 _).1 (hrel_forestAt_D3 hA hfa)) _
    · rcases Nat.eq_zero_or_pos (sd.depth - rd.layer) with h0 | h0
      · rw [h0]
        have := hlast 0 (by omega)
        simp only [routeCol_D3, skipLayers] at this ⊢
        show ((skipLayers A rd.layer).cols.drop (rd.idx + 1)).getLast?.getD [] = _
        rw [List.getLast?_drop, if_neg (by omega)]; exact this
      · obtain ⟨i, hi⟩ : ∃ i, sd.depth - rd.layer = i + 1 := ⟨_, (Nat.succ_pred_eq_of_ne_zero (by omega)).symm⟩
        rw [hi]
        have := hlast (i + 1) (by omega)
        have hnx : nextLayer (.node ((skipLayers A rd.layer).cols.drop (rd.idx + 1))) =
            nextLayer (skipLayers A rd.layer) := by
          have e : (Tree.node ((skipLayers A rd.layer).cols.drop (rd.idx + 1))).cols.getLast? =
              (skipLayers A rd.layer).cols.getLast? := by
            show ((skipLayers A rd.layer).cols.drop (rd.idx + 1)).getLast? = _
            rw [List.getLast?_drop, if_neg (by omega)]
          simp only [nextLayer, lastEntry?, e]
        simp only [routeCol_D3, skipLayers] at this ⊢
        rw [hnx]; exact this
  · intro hown x hx
    have hidx' := howner.1 hown
    rw [hU] at hx
    have hx' : R.getLast? = some x := by
      rw [List.getLast?_drop] at hx; split at hx
      · cases hx
      · exact hx
    have hsome : (skipLayers A rd.layer).cols.getLast? = some R := by
      rw [List.getLast?_eq_getElem?, show (skipLayers A rd.layer).cols.length - 1 = rd.idx by omega,
        ← hcol, hR]
    have hnx := nextLayer_of_last hsome (show R.getLast? = some (x.1, x.2) from hx')
    have := hlast (sd.depth - rd.layer) (by omega)
    rw [routeCol_skip_D3] at this ⊢
    have hlt := rootData_layer_lt hsd hrd hown
    rw [show sd.depth - rd.layer = (sd.depth - rd.layer - 1) + 1 by omega, skipLayers, hnx] at this
    exact this

theorem empty_le_D3 (X : Forest) : (Tree.empty : Forest) ≤ X := by
  show Tree.cmp compare _ _ ≠ .gt
  obtain ⟨xc⟩ := X
  cases xc <;> simp [Tree.empty, Tree.cmp, Tree.cmpCols]

-- T3.2x (txt:345-349): ordinary outputs satisfy H (strict decrease is the spine's `expand_lt`)
theorem condH_ord {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .ordinary)
    (hB : expand A n = some B) : CondH B := by
  obtain ⟨sd, rd, hsd, hrd, rfl, -⟩ := ord_output_D3 hL hk hB
  obtain ⟨hrt, -, hU, hbodyR, hownerR⟩ := ord_vdata_D3 hL.1 hsd hrd
  obtain ⟨hQc, hQh, hUc, hUh, hbody, howner⟩ := ord_hdata_D3 hL.2.2.1 hsd hrd
  obtain ⟨hR, -⟩ := stop_route_top_D3 hsd
  obtain ⟨-, -, -, h4, -⟩ := stopData_core hsd
  have hrc : routeCol_D3 sd.depth A = sd.Q ++ [(sd.r, Tree.empty)] := by
    simp [routeCol_D3, h4]
  rw [condH_iff_hrel_D3]
  have := ordLoop_induct_D3 (step := ordStep sd rd ((A.forestAt rd.col.path).getD Tree.empty)
      (((A.colAt rd.col).getD []).drop rd.cursor))
    (P := fun k Z => HRel_D3 Z ∧
      Z ≤ .node [Tree.mapCol (shiftVal sd.r (k * (sd.t - sd.r))) (sd.Q ++ [(sd.r, Tree.empty)])]) ?_ n
    Tree.empty ⟨hrel_empty_D3, empty_le_D3 _⟩
  · simp only [Nat.zero_mul, shiftVal_zero_fun, treeMapCol_id_fun, id] at this
    refine hrel_put_D3 _ _ _ hR ((condH_iff_hrel_D3 A).1 hL.2.2.1) this.1 ?_
    rw [hrc]; exact this.2
  · intro k Z _ hZ
    have := hrel_ordStep_D3 (F := (A.forestAt rd.col.path).getD Tree.empty) (k := k) hQc hQh hUc hUh
      (fun x hx => (hU x hx).1)
      (fun h => ⟨(hbodyR h).1, (hbody h).1, (hbody h).2⟩)
      (fun h x hx => ⟨(hownerR h x hx).1, howner h x hx⟩) hZ.1 hZ.2
    exact ⟨this.1, le_of_lt this.2⟩

/-! ### T3.2m helpers (branch E3): the loop, word lengths, entries of a filled hole -/

/-- Steps `lo + c, …, lo + 1` of the ordinary loop applied to `∅`. -/
def loopFrom_E3 (step : Nat → Forest → Forest) : Nat → Nat → Forest
  | _, 0 => Tree.empty
  | lo, c + 1 => step (lo + 1) (loopFrom_E3 step (lo + 1) c)

theorem ordLoop_loopFrom_E3 (step : Nat → Forest → Forest) : ∀ lo c,
    ordLoop step lo (loopFrom_E3 step lo c) = loopFrom_E3 step 0 (lo + c)
  | 0, c => by simp [ordLoop]
  | lo + 1, c => by
    rw [ordLoop, show step (lo + 1) (loopFrom_E3 step (lo + 1) c) = loopFrom_E3 step lo (c + 1)
      from rfl, ordLoop_loopFrom_E3 step lo (c + 1)]
    congr 1; omega

/-- The filling of the hole of layer `j` of `A[n]` (steps `n, …, j+1`; `zs_E3 … 0` is `ordZ`). -/
def zs_E3 (A : Forest) (sd : StopData) (rd : RootData) (n j : Nat) : Forest :=
  loopFrom_E3 (ordStep sd rd ((A.forestAt rd.col.path).getD Tree.empty)
    (((A.colAt rd.col).getD []).drop rd.cursor)) j (n - j)

theorem zs_top_E3 (A : Forest) (sd : StopData) (rd : RootData) (n : Nat) :
    zs_E3 A sd rd n n = Tree.empty := by
  simp [zs_E3, loopFrom_E3]

theorem zs_step_E3 (A : Forest) (sd : StopData) (rd : RootData) {n j : Nat} (hj : j < n) :
    zs_E3 A sd rd n j = ordStep sd rd ((A.forestAt rd.col.path).getD Tree.empty)
      (((A.colAt rd.col).getD []).drop rd.cursor) (j + 1) (zs_E3 A sd rd n (j + 1)) := by
  simp only [zs_E3]
  rw [show n - j = (n - (j + 1)) + 1 by omega]
  rfl

theorem ordZ_eq_zs_E3 (A : Forest) (sd : StopData) (rd : RootData) (n : Nat) :
    ordZ A sd rd n = zs_E3 A sd rd n 0 := by
  have := ordLoop_loopFrom_E3 (ordStep sd rd ((A.forestAt rd.col.path).getD Tree.empty)
    (((A.colAt rd.col).getD []).drop rd.cursor)) n 0
  simp only [loopFrom_E3, Nat.add_zero] at this
  simp only [ordZ, zs_E3, Nat.sub_zero]
  exact this

/-! Word lengths. -/

/-- The length of the (generic) word of a forest. -/
def N_E3 (X : Forest) : Nat := (gwordAt 0 X).length

theorem len_gwordAt_E3 (e : Nat) (X : Forest) : (gwordAt e X).length = N_E3 X := by
  have h := wordAt_add 0 e X
  rw [Nat.zero_add] at h
  rw [N_E3, gwordAt_eq_map_wordAt, gwordAt_eq_map_wordAt, List.length_map, List.length_map, h,
    List.length_map]

theorem gwordCols_append_E3 {α : Type} (e : Nat) (l₁ l₂ : List (List (α × Tree α))) :
    gwordCols e (l₁ ++ l₂) = gwordCols e l₁ ++ gwordCols e l₂ := by
  induction l₁ with
  | nil => rfl
  | cons c l ih => simp only [List.cons_append, gwordCols, ih, List.append_assoc]

theorem gwordLater_append_E3 {α : Type} (e : Nat) (l₁ l₂ : List (α × Tree α)) :
    gwordLater e (l₁ ++ l₂) = gwordLater e l₁ ++ gwordLater e l₂ := by
  induction l₁ with
  | nil => rfl
  | cons x l ih =>
    obtain ⟨p, h⟩ := x
    simp only [List.cons_append, gwordLater, ih, List.append_assoc]

theorem gwordCol_append_E3 {α : Type} (e : Nat) {l₁ : List (α × Tree α)} (h : l₁ ≠ [])
    (l₂ : List (α × Tree α)) : gwordCol e (l₁ ++ l₂) = gwordCol e l₁ ++ gwordLater e l₂ := by
  cases l₁ with
  | nil => exact absurd rfl h
  | cons x l =>
    obtain ⟨p, hh⟩ := x
    simp only [List.cons_append, gwordCol, gwordLater_append_E3, List.append_assoc]

theorem gwordAt_empty_E3 {α : Type} (e : Nat) : gwordAt e (Tree.empty : Tree α) = [] := rfl

theorem gwordCol_snoc_E3 {α : Type} (e : Nat) (l : List (α × Tree α)) (q : α) (H : Tree α) :
    gwordCol e (l ++ [(q, H)]) = gwordCol e (l ++ [(q, Tree.empty)]) ++ gwordAt (e + 1) H := by
  cases l with
  | nil => simp [gwordCol, gwordLater, gwordAt_empty_E3]
  | cons x l =>
    obtain ⟨p, h⟩ := x
    rw [gwordCol_append_E3 e (List.cons_ne_nil _ _), gwordCol_append_E3 e (List.cons_ne_nil _ _)]
    simp [gwordLater, gwordAt_empty_E3]

theorem len_later_entry_E3 {α : Type} (e : Nat) : ∀ (col : List (α × Tree α)) (i : Nat)
    (x : α × Tree α), col[i]? = some x → (gwordAt (e + 1) x.2).length < (gwordLater e col).length
  | [], _, _, h => by simp at h
  | (p, h') :: rest, 0, x, h => by
    simp only [List.getElem?_cons_zero, Option.some.injEq] at h
    subst h
    simp [gwordLater]
  | (p, h') :: rest, i + 1, x, h => by
    simp only [List.getElem?_cons_succ] at h
    have := len_later_entry_E3 e rest i x h
    simp [gwordLater]; omega

theorem len_col_entry_E3 {α : Type} (e : Nat) (col : List (α × Tree α)) (i : Nat)
    (x : α × Tree α) (h : col[i]? = some x) :
    (gwordAt (e + 1) x.2).length < (gwordCol e col).length := by
  cases col with
  | nil => simp at h
  | cons y rest =>
    obtain ⟨p, h'⟩ := y
    cases i with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.some.injEq] at h
      subst h
      simp [gwordCol]
    | succ i =>
      simp only [List.getElem?_cons_succ] at h
      have := len_later_entry_E3 e rest i x h
      simp [gwordCol]; omega

theorem len_cols_col_E3 {α : Type} (e : Nat) : ∀ (cols : List (List (α × Tree α))) (j : Nat)
    (col : List (α × Tree α)), cols[j]? = some col →
      (gwordCol e col).length ≤ (gwordCols e cols).length
  | [], _, _, h => by simp at h
  | c :: rest, 0, col, h => by
    simp only [List.getElem?_cons_zero, Option.some.injEq] at h
    subst h; simp [gwordCols]
  | c :: rest, j + 1, col, h => by
    simp only [List.getElem?_cons_succ] at h
    have := len_cols_col_E3 e rest j col h
    simp [gwordCols]; omega

/-- An entry's height has a shorter word than any forest containing the entry. -/
theorem N_entry_lt_E3 : ∀ (X : Forest) (e : EntryAddr) (x : Nat × Forest),
    X.entryAt e = some x → N_E3 x.2 < N_E3 X := by
  intro X e
  obtain ⟨⟨P, j⟩, i⟩ := e
  induction P generalizing X with
  | nil =>
    intro x h
    obtain ⟨cols⟩ := X
    rw [entryAt_nil_D3] at h
    cases hc : cols[j]? with
    | none => simp [hc] at h
    | some col =>
      simp only [hc, Option.bind_some] at h
      have h1 := len_col_entry_E3 0 col i x h
      have h2 := len_cols_col_E3 0 cols j col hc
      rw [len_gwordAt_E3] at h1
      unfold N_E3 at h1 ⊢
      simp only [gwordAt] at h2 ⊢
      omega
  | cons s P ih =>
    intro x h
    obtain ⟨c, m⟩ := s
    obtain ⟨cols⟩ := X
    rw [entryAt_cons_D3] at h
    cases hc : cols[c]? with
    | none => simp [hc] at h
    | some col =>
      cases hm : col[m]? with
      | none => simp [hc, hm] at h
      | some y =>
        simp only [hc, hm, Option.bind_some] at h
        have h0 := ih y.2 x h
        have h1 := len_col_entry_E3 0 col m y hm
        have h2 := len_cols_col_E3 0 cols c col hc
        rw [len_gwordAt_E3] at h1
        unfold N_E3 at h1 h0 ⊢
        simp only [gwordAt] at h2 h0 ⊢
        omega

/-! Entries of a filled hole. -/

/-- The route path of depth `k` (the `(column, entry)` steps of the last-column, last-entry
route). -/
def rpath_E3 : Nat → Forest → List (Nat × Nat)
  | 0, _ => []
  | k + 1, F => (F.cols.length - 1, (F.cols.getLast?.getD []).length - 1) ::
      rpath_E3 k (nextLayer F)

/-- The index of the hole column (the route column at depth `k`) in its forest. -/
def hcol_E3 (k : Nat) (F : Forest) : Nat := (skipLayers F k).cols.length - 1

/-- A column at or after the hole column at depth `k`, or inside one. -/
def InHole_E3 (k : Nat) (F : Forest) (c : ColAddr) : Prop :=
  (c.path = rpath_E3 k F ∧ hcol_E3 k F ≤ c.col) ∨
    ∃ c' i rest, c.path = rpath_E3 k F ++ (c', i) :: rest ∧ hcol_E3 k F ≤ c'

/-- The address of a hole column relative to the filling. -/
def unplace_E3 (k : Nat) (F : Forest) (c : ColAddr) : ColAddr :=
  match c.path.drop (rpath_E3 k F).length with
  | [] => ⟨[], c.col - hcol_E3 k F⟩
  | (c', i) :: rest => ⟨(c' - hcol_E3 k F, i) :: rest, c.col⟩

/-- A route container above depth `k`. -/
def IsRoute_E3 (k : Nat) (F : Forest) (e : EntryAddr) : Prop := e.heightPath <+: rpath_E3 k F

theorem rpath_snoc_E3 (k : Nat) (cs : List Column) (es : Column) (q : Nat) (H : Forest) :
    rpath_E3 (k + 1) (.node (cs ++ [es ++ [(q, H)]])) = (cs.length, es.length) :: rpath_E3 k H := by
  simp [rpath_E3, Tree.cols, nextLayer_snoc_D3]

theorem hcol_snoc_E3 (k : Nat) (cs : List Column) (es : Column) (q : Nat) (H : Forest) :
    hcol_E3 (k + 1) (.node (cs ++ [es ++ [(q, H)]])) = hcol_E3 k H := by
  simp [hcol_E3, skipLayers, nextLayer_snoc_D3]

theorem snoc_entry_ne_E3 (cs : List Column) (es : Column) (q : Nat) (Y Y' : Forest) {c m : Nat}
    (h : (c, m) ≠ (cs.length, es.length)) :
    ((cs ++ [es ++ [(q, Y)]])[c]?).bind (·[m]?) = ((cs ++ [es ++ [(q, Y')]])[c]?).bind (·[m]?) := by
  rcases Nat.lt_trichotomy c cs.length with hc | rfl | hc
  · rw [List.getElem?_append_left hc, List.getElem?_append_left hc]
  · have hm : m ≠ es.length := fun hm => h (by rw [hm])
    simp only [List.getElem?_append_right (le_refl _), Nat.sub_self, List.getElem?_cons_zero,
      Option.bind_some]
    rcases Nat.lt_or_gt_of_ne hm with hm | hm
    · rw [List.getElem?_append_left hm, List.getElem?_append_left hm]
    · rw [List.getElem?_append_right (by omega), List.getElem?_append_right (by omega)]
      simp [show m - es.length ≠ 0 by omega]
  · rw [List.getElem?_eq_none (by simp; omega), List.getElem?_eq_none (by simp; omega)]

theorem snoc_entry_eq_E3 (cs : List Column) (es : Column) (q : Nat) (Y : Forest) :
    ((cs ++ [es ++ [(q, Y)]])[cs.length]?).bind (·[es.length]?) = some (q, Y) := by
  simp

/-- The entries of `A_{0,0,k,Z}(F)`: hole addresses read `Z`, route containers have filled
heights, every other entry is unchanged. -/
theorem put_entryAt_E3 (Z : Forest) : ∀ (k : Nat) (F : Forest), RouteOK_D3 k F →
    ∀ (e : EntryAddr),
    (InHole_E3 k F e.col → (replaceAt 0 0 Z k F).entryAt e = Z.entryAt ⟨unplace_E3 k F e.col, e.idx⟩ ∧
        ∀ b, e.col.num b = (unplace_E3 k F e.col).num (b + routeNum_D3 k F)) ∧
    (¬ InHole_E3 k F e.col → IsRoute_E3 k F e →
      (replaceAt 0 0 Z k F).entryAt e =
        (F.entryAt e).map (fun x => (x.1, replaceAt 0 0 Z (k - e.col.path.length - 1) x.2))) ∧
    (¬ InHole_E3 k F e.col → ¬ IsRoute_E3 k F e → (replaceAt 0 0 Z k F).entryAt e = F.entryAt e)
  | 0, .node cols, hR, ⟨⟨P, j⟩, i⟩ => by
    have hc : cols ≠ [] := hR
    have hlen : cols.dropLast.length = hcol_E3 0 (.node cols) := by
      simp [hcol_E3, skipLayers, Tree.cols]
    rw [put_zero_D3 Z hc]
    obtain ⟨zc⟩ := Z
    have hnr : ¬ IsRoute_E3 0 (.node cols) ⟨⟨P, j⟩, i⟩ := by
      simp [IsRoute_E3, rpath_E3, EntryAddr.heightPath]
    cases P with
    | nil =>
      have hiff : InHole_E3 0 (.node cols) ⟨[], j⟩ ↔ hcol_E3 0 (.node cols) ≤ j := by
        simp [InHole_E3, rpath_E3]
      refine ⟨fun hh => ?_, fun _ h => absurd h hnr, fun hh _ => ?_⟩
      · rw [hiff] at hh
        refine ⟨?_, fun b => ?_⟩
        · simp only [entryAt_nil_D3, Tree.cols, unplace_E3, rpath_E3, List.length_nil,
            List.drop_zero]
          rw [List.getElem?_append_right (by omega), hlen]
        · simp only [unplace_E3, rpath_E3, List.length_nil, List.drop_zero, num_nil_D3,
            routeNum_D3, Tree.cols]
          simp only [hcol_E3, skipLayers, Tree.cols] at hh ⊢
          omega
      · rw [hiff] at hh
        simp only [entryAt_nil_D3, Tree.cols]
        have hj : j < cols.length - 1 := by
          simp only [hcol_E3, skipLayers, Tree.cols] at hh; omega
        rw [List.getElem?_append_left (by omega), List.getElem?_dropLast, if_pos hj]
    | cons s P =>
      obtain ⟨c, m⟩ := s
      have hiff : InHole_E3 0 (.node cols) ⟨(c, m) :: P, j⟩ ↔ hcol_E3 0 (.node cols) ≤ c := by
        simp [InHole_E3, rpath_E3]
      refine ⟨fun hh => ?_, fun _ h => absurd h hnr, fun hh _ => ?_⟩
      · rw [hiff] at hh
        refine ⟨?_, fun b => ?_⟩
        · simp only [entryAt_cons_D3, Tree.cols, unplace_E3, rpath_E3, List.length_nil,
            List.drop_zero]
          rw [List.getElem?_append_right (by omega), hlen]
        · simp only [unplace_E3, rpath_E3, List.length_nil, List.drop_zero, num_cons_D3,
            routeNum_D3, Tree.cols]
          simp only [hcol_E3, skipLayers, Tree.cols] at hh ⊢
          congr 1; omega
      · rw [hiff] at hh
        simp only [entryAt_cons_D3, Tree.cols]
        have hj : c < cols.length - 1 := by
          simp only [hcol_E3, skipLayers, Tree.cols] at hh; omega
        rw [List.getElem?_append_left (by omega), List.getElem?_dropLast, if_pos hj]
  | k + 1, F, hR, ⟨⟨P, j⟩, i⟩ => by
    obtain ⟨cs, es, q, H, rfl, hR'⟩ := hR
    rw [put_succ_D3]
    have hrp := rpath_snoc_E3 k cs es q H
    have hhc := hcol_snoc_E3 k cs es q H
    cases P with
    | nil =>
      have hnh : ¬ InHole_E3 (k + 1) (.node (cs ++ [es ++ [(q, H)]])) ⟨[], j⟩ := by
        simp [InHole_E3, hrp]
      refine ⟨fun h => absurd h hnh, fun _ hr => ?_, fun _ hr => ?_⟩
      · simp only [IsRoute_E3, EntryAddr.heightPath, hrp, List.nil_append,
          List.cons_prefix_cons, List.nil_prefix, and_true, Prod.mk.injEq] at hr
        obtain ⟨rfl, rfl⟩ := hr
        simp only [entryAt_nil_D3, snoc_entry_eq_E3, Option.map_some, List.length_nil]
        rfl
      · have hne : (j, i) ≠ (cs.length, es.length) := by
          rintro he
          apply hr
          simp only [IsRoute_E3, EntryAddr.heightPath, hrp, List.nil_append, he]
          exact List.cons_prefix_cons.2 ⟨rfl, List.nil_prefix⟩
        simp only [entryAt_nil_D3]
        exact snoc_entry_ne_E3 cs es q _ _ hne
    | cons s P =>
      obtain ⟨c, m⟩ := s
      by_cases hs : (c, m) = (cs.length, es.length)
      · simp only [Prod.mk.injEq] at hs
        obtain ⟨rfl, rfl⟩ := hs
        have ih := put_entryAt_E3 Z k H hR' ⟨⟨P, j⟩, i⟩
        have hh : InHole_E3 (k + 1) (.node (cs ++ [es ++ [(q, H)]])) ⟨(cs.length, es.length) :: P, j⟩ ↔
            InHole_E3 k H ⟨P, j⟩ := by
          simp only [InHole_E3, hrp, hhc, List.cons_append, List.cons.injEq, true_and]
        have hr : IsRoute_E3 (k + 1) (.node (cs ++ [es ++ [(q, H)]]))
            ⟨⟨(cs.length, es.length) :: P, j⟩, i⟩ ↔ IsRoute_E3 k H ⟨⟨P, j⟩, i⟩ := by
          simp only [IsRoute_E3, EntryAddr.heightPath, hrp, List.cons_append,
            List.cons_prefix_cons, true_and]
        have hu : unplace_E3 (k + 1) (.node (cs ++ [es ++ [(q, H)]])) ⟨(cs.length, es.length) :: P, j⟩ =
            unplace_E3 k H ⟨P, j⟩ := by
          simp only [unplace_E3, hrp, List.length_cons, hhc]
          rw [show (rpath_E3 k H).length + 1 = 1 + (rpath_E3 k H).length by omega,
            ← List.drop_drop]
          rfl
        simp only [entryAt_cons_D3, snoc_entry_eq_E3, Option.bind_some]
        rw [hh, hr, hu]
        refine ⟨fun h => ⟨(ih.1 h).1, fun b => ?_⟩, fun h1 h2 => ?_, ih.2.2⟩
        · rw [num_cons_D3, (ih.1 h).2 (b + cs.length + 1)]
          simp only [routeNum_D3, Tree.cols, nextLayer_snoc_D3, List.length_append,
            List.length_singleton]
          congr 1; omega
        · rw [ih.2.1 h1 h2]
          simp only [List.length_cons]
          congr 2; funext x; congr 2; omega
      · have hnh : ¬ InHole_E3 (k + 1) (.node (cs ++ [es ++ [(q, H)]])) ⟨(c, m) :: P, j⟩ := by
          simp only [InHole_E3, hrp, List.cons_append, List.cons.injEq, not_or, not_and,
            not_exists]
          exact ⟨fun h => absurd h.1 hs, fun _ _ _ h => absurd h.1 hs⟩
        have hnr : ¬ IsRoute_E3 (k + 1) (.node (cs ++ [es ++ [(q, H)]])) ⟨⟨(c, m) :: P, j⟩, i⟩ := by
          simp only [IsRoute_E3, EntryAddr.heightPath, hrp, List.cons_append,
            List.cons_prefix_cons, not_and]
          exact fun h => absurd h hs
        refine ⟨fun h => absurd h hnh, fun _ h => absurd h hnr, fun _ _ => ?_⟩
        simp only [entryAt_cons_D3]
        rw [snoc_entry_ne_E3 cs es q _ H hs]

/-! Words of filled holes and first decreases. -/

theorem gword_put_E3 (Z : Forest) : ∀ (k : Nat) (F : Forest), RouteOK_D3 k F → ∀ e,
    gwordAt e (replaceAt 0 0 Z k F) = gwordAt e (replaceAt 0 0 Tree.empty k F) ++ gwordAt (e + k) Z
  | 0, .node cols, hR, e => by
    have hc : cols ≠ [] := hR
    rw [put_zero_D3 Z hc, put_zero_D3 _ hc]
    obtain ⟨zc⟩ := Z
    simp [gwordAt, gwordCols_append_E3, Tree.empty, Tree.cols]
  | k + 1, F, hR, e => by
    obtain ⟨cs, es, q, H, rfl, hR'⟩ := hR
    rw [put_succ_D3, put_succ_D3]
    simp only [gwordAt, gwordCols_append_E3, gwordCols, List.append_nil]
    rw [gwordCol_snoc_E3, gwordCol_snoc_E3 e _ _ (replaceAt 0 0 Tree.empty k H),
      gword_put_E3 Z k H hR' (e + 1)]
    simp only [List.append_assoc]
    rw [show e + 1 + k = e + (k + 1) by omega]

theorem N_put_E3 {Z : Forest} {k : Nat} {F : Forest} (hR : RouteOK_D3 k F) :
    N_E3 (replaceAt 0 0 Z k F) = N_E3 (replaceAt 0 0 Tree.empty k F) + N_E3 Z := by
  unfold N_E3
  rw [gword_put_E3 Z k F hR 0, List.length_append]
  simp only [len_gwordAt_E3]

theorem N_self_E3 {k : Nat} {F : Forest} (hR : RouteOK_D3 k F) :
    N_E3 F = N_E3 (replaceAt 0 0 Tree.empty k F) + N_E3 (.node [routeCol_D3 k F]) := by
  conv_lhs => rw [← put_self_D3 k F hR]
  exact N_put_E3 hR

theorem N_shift_E3 (r d : Nat) (X : Forest) : N_E3 (shift r d X) = N_E3 X := by
  unfold N_E3 shift; rw [gwordAt_map, List.length_map]

theorem N_col_pos_E3 (col : Column) : 0 < N_E3 (.node [col]) := by
  unfold N_E3
  obtain ⟨A, rest, h, -⟩ := gwordCol_head 0 col
  simp [gwordAt, gwordCols, h]

section FirstDecE3
variable {α : Type} [LinearOrder α]

theorem firstDec_append_E3 (P : List α) {X X' : List α} {a : Nat} (h : FirstDec X X' a) :
    FirstDec (P ++ X) (P ++ X') (P.length + a) := by
  obtain ⟨h1, h2, h3⟩ := h
  refine ⟨by rw [List.take_length_add_append, List.take_length_add_append, h1], by simp; omega, ?_⟩
  rcases h3 with ⟨h3, h4⟩ | ⟨x, x', hx, hx', hlt⟩
  · exact Or.inl ⟨by simp; omega, by simp; omega⟩
  · refine Or.inr ⟨x, x', ?_, ?_, hlt⟩
    · rw [List.getElem?_append_right (by omega)]; simpa using hx
    · rw [List.getElem?_append_right (by omega)]; simpa using hx'

theorem firstDec_map_E3 {β : Type} [LinearOrder β] {f : α → β} (hf : StrictMono f)
    {X X' : List α} {a : Nat} (h : FirstDec X X' a) : FirstDec (X.map f) (X'.map f) a := by
  obtain ⟨h1, h2, h3⟩ := h
  refine ⟨by rw [← List.map_take, ← List.map_take, h1], by simpa using h2, ?_⟩
  rcases h3 with ⟨h3, h4⟩ | ⟨x, x', hx, hx', hlt⟩
  · exact Or.inl ⟨by simpa using h3, by simpa using h4⟩
  · exact Or.inr ⟨f x, f x', by simp [hx], by simp [hx'], hf hlt⟩

theorem lt_of_firstDec_E3 {X X' : List α} {a : Nat} (h : FirstDec X X' a) : X' < X := by
  obtain ⟨h1, h2, h3⟩ := h
  rw [← List.take_append_drop a X, ← List.take_append_drop a X', h1,
    list_append_lt_append_left]
  rcases h3 with ⟨h3, h4⟩ | ⟨x, x', hx, hx', hlt⟩
  · rw [List.drop_eq_nil_of_le (by omega)]
    obtain ⟨y, ys, hy⟩ := List.exists_cons_of_ne_nil (by simp; omega : X.drop a ≠ [])
    rw [hy]; exact List.nil_lt_cons _ _
  · obtain ⟨hl1, hx⟩ := List.getElem?_eq_some_iff.1 hx
    obtain ⟨hl2, hx'⟩ := List.getElem?_eq_some_iff.1 hx'
    rw [List.drop_eq_getElem_cons (l := X) hl1, List.drop_eq_getElem_cons (l := X') hl2, hx, hx']
    exact List.cons_lt_cons_iff.2 (Or.inl hlt)

theorem firstDec_ends_E3 (P X : List α) (hX : X ≠ []) : FirstDec (P ++ X) P P.length := by
  refine ⟨by simp, le_refl _, Or.inl ⟨rfl, ?_⟩⟩
  have : 0 < X.length := List.length_pos_iff.2 hX
  simp; omega

end FirstDecE3

theorem gatom_lt_E3 {α : Type} [LinearOrder α] {x y : Nat} {m m' : Nat} {l l' : WithBot α}
    (h : x < y ∨ (x = y ∧ (m < m' ∨ (m = m' ∧ l < l')))) :
    (toLex (x, toLex (m, l)) : GAtom α) < toLex (y, toLex (m', l')) := by
  rw [Prod.Lex.lt_iff]
  rcases h with h | ⟨rfl, h⟩
  · exact Or.inl h
  · refine Or.inr ⟨rfl, ?_⟩
    show toLex (m, l) < toLex (m', l')
    rw [Prod.Lex.lt_iff]
    rcases h with h | ⟨rfl, h⟩
    · exact Or.inl h
    · exact Or.inr ⟨rfl, h⟩

/-- The first decrease of a head column `P ⌢ V` against the stopping column `P ⌢ [(s, ∅)]`. -/
theorem head_firstDec_E3 (e : Nat) (P V : Column) (rest : List Column) (s : Nat)
    (hV : ∀ v ∈ V.head?, v.1 < s) :
    FirstDec (gwordAt e (Tree.node [P ++ [(s, Tree.empty)]]))
      (gwordAt e (Tree.node ((P ++ V) :: rest)))
      ((gwordAt e (Tree.node [P ++ [(s, Tree.empty)]])).length - 1) := by
  simp only [gwordAt, gwordCols, List.append_nil]
  rcases eq_or_ne P [] with rfl | hP
  · simp only [List.nil_append, gwordCol, gwordAt_empty_E3, gwordLater, List.append_nil,
      List.length_singleton, Nat.sub_self]
    refine ⟨by simp, Nat.zero_le _, Or.inr ?_⟩
    cases V with
    | nil =>
      refine ⟨_, toLex (2 * e, toLex (0, (⊥ : WithBot Nat))), rfl, by simp [gwordCol],
        gatom_lt_E3 (Or.inr ⟨rfl, Or.inl (by omega)⟩)⟩
    | cons v vs =>
      obtain ⟨p, h⟩ := v
      have hp : p < s := hV (p, h) (by simp)
      refine ⟨_, toLex (2 * e, toLex (1, (p : WithBot Nat))), rfl, by simp [gwordCol]; rfl,
        gatom_lt_E3 (Or.inr ⟨rfl, Or.inr ⟨rfl, ?_⟩⟩)⟩
      exact WithBot.coe_lt_coe.2 hp
  · rw [gwordCol_append_E3 e hP, gwordCol_append_E3 e hP]
    simp only [gwordLater, gwordAt_empty_E3, List.append_nil, List.length_append,
      List.length_singleton, Nat.add_sub_cancel, List.append_assoc]
    show FirstDec _ _ ((gwordCol e P).length + 0)
    apply firstDec_append_E3
    cases V with
    | cons v vs =>
      obtain ⟨p, h⟩ := v
      have hp : p < s := hV (p, h) (by simp)
      refine ⟨by simp, Nat.zero_le _, Or.inr ⟨_, toLex (2 * e + 1, toLex (0, (p : WithBot Nat))), rfl,
        by simp [gwordLater]; rfl, ?_⟩⟩
      exact gatom_lt_E3 (Or.inr ⟨rfl, Or.inr ⟨rfl, WithBot.coe_lt_coe.2 hp⟩⟩)
    | nil =>
      cases rest with
      | nil => exact ⟨by simp, by simp, Or.inl ⟨by simp [gwordLater, gwordCols], by simp⟩⟩
      | cons c cs =>
        obtain ⟨A, l, hA, hA1⟩ := gwordCol_head e c
        refine ⟨by simp, Nat.zero_le _, Or.inr ⟨_, A, rfl, by simp [gwordLater, gwordCols, hA], ?_⟩⟩
        rw [← toLex_ofLex A, Prod.Lex.lt_iff]; left
        show (ofLex A).1 < 2 * e + 1
        omega

/-- The first decrease of a filled continuation against the shifted old height (`k < n`): at the
old closing atom. -/
theorem fill_firstDec_head_E3 {H : Forest} {k : Nat} (hR : RouteOK_D3 k H) {Q : Column} {s : Nat}
    (hc : routeCol_D3 k H = Q ++ [(s, Tree.empty)]) {r δ : Nat} (hs : r ≤ s) {V : Column}
    {rest : List Column} (hV : ∀ v ∈ V.head?, v.1 < r) (e : Nat) :
    FirstDec (gwordAt e (shift r δ H))
      (gwordAt e (replaceAt r δ (.node ((Tree.mapCol (shiftVal r δ) Q ++ V) :: rest)) k H))
      (N_E3 H - 1) := by
  have hRG : RouteOK_D3 k (shift r δ H) := (routeOK_shift_D3 r δ k H).2 hR
  have hcG : routeCol_D3 k (shift r δ H) = Tree.mapCol (shiftVal r δ) Q ++ [(s + δ, Tree.empty)] := by
    rw [routeCol_shift_D3, hc, Tree.treeMapCol_append_D3]
    simp [Tree.mapCol, shiftVal, hs]; rfl
  have h1 := gword_put_E3 (.node [routeCol_D3 k (shift r δ H)]) k _ hRG e
  rw [put_self_D3 k _ hRG] at h1
  rw [replaceAt_eq_shift, h1,
    gword_put_E3 (.node ((Tree.mapCol (shiftVal r δ) Q ++ V) :: rest)) k _ hRG e, hcG]
  have h3 := head_firstDec_E3 (e + k) (Tree.mapCol (shiftVal r δ) Q) V rest (s + δ)
    (fun v hv => lt_of_lt_of_le (hV v hv) (by omega))
  have h4 := firstDec_append_E3 (gwordAt e (replaceAt 0 0 Tree.empty k (shift r δ H))) h3
  convert h4 using 1
  have hl : (gwordAt e (shift r δ H)).length = N_E3 H := by rw [len_gwordAt_E3, N_shift_E3]
  rw [h1, hcG, List.length_append] at hl
  have hpos := N_col_pos_E3 (Tree.mapCol (shiftVal r δ) Q ++ [(s + δ, Tree.empty)])
  simp only [len_gwordAt_E3] at hl ⊢
  omega

/-- The first decrease of the last continuation (`k = n`, empty filling): the old stopping column
is deleted. -/
theorem fill_firstDec_empty_E3 {H : Forest} {k : Nat} (hR : RouteOK_D3 k H) (r δ e : Nat) :
    FirstDec (gwordAt e (shift r δ H)) (gwordAt e (replaceAt r δ Tree.empty k H))
      (N_E3 H - N_E3 (.node [routeCol_D3 k H])) := by
  have hRG : RouteOK_D3 k (shift r δ H) := (routeOK_shift_D3 r δ k H).2 hR
  have h1 := gword_put_E3 (.node [routeCol_D3 k (shift r δ H)]) k _ hRG e
  rw [put_self_D3 k _ hRG] at h1
  rw [replaceAt_eq_shift, h1]
  have hne : gwordAt (e + k) (Tree.node [routeCol_D3 k (shift r δ H)]) ≠ [] := by
    intro h
    have := N_col_pos_E3 (routeCol_D3 k (shift r δ H))
    rw [← len_gwordAt_E3 (e + k), h] at this; simp at this
  convert firstDec_ends_E3 _ _ hne using 1
  have hl : (gwordAt e (shift r δ H)).length = N_E3 H := by rw [len_gwordAt_E3, N_shift_E3]
  rw [h1, List.length_append] at hl
  have : N_E3 (.node [routeCol_D3 k (shift r δ H)]) = N_E3 (.node [routeCol_D3 k H]) := by
    rw [routeCol_shift_D3, ← N_shift_E3 r δ (.node [routeCol_D3 k H])]
    simp [shift, Tree.map, Tree.mapCols]
  simp only [len_gwordAt_E3] at hl ⊢
  rw [← this]; omega

/-! Key words as relabelled words. -/

/-- The label map of `relKey a`, into the lexicographic order. -/
def lab_E3 (a p : Nat) : Bool ×ₗ Nat := toLex (if p < a then (false, p) else (true, p - a))

theorem lab_strictMono_E3 (a : Nat) : StrictMono (lab_E3 a) := by
  intro p q h
  simp only [lab_E3]
  split_ifs with h1 h2 h2
  · exact Prod.Lex.lt_iff.2 (Or.inr ⟨rfl, h⟩)
  · exact Prod.Lex.lt_iff.2 (Or.inl (show false < true by decide))
  · omega
  · exact Prod.Lex.lt_iff.2 (Or.inr ⟨rfl, show p - a < q - a by omega⟩)

theorem gatomMap_strictMono_E3 {α β : Type} [LinearOrder α] [LinearOrder β] {f : α → β}
    (hf : StrictMono f) : StrictMono (GAtom.map f) := by
  intro A B h
  obtain ⟨⟨a1, a2, a3⟩, rfl⟩ : ∃ t : Nat × Nat × WithBot α, A = toLex (t.1, toLex (t.2.1, t.2.2)) :=
    ⟨((ofLex A).1, (ofLex (ofLex A).2).1, (ofLex (ofLex A).2).2), rfl⟩
  obtain ⟨⟨b1, b2, b3⟩, rfl⟩ : ∃ t : Nat × Nat × WithBot α, B = toLex (t.1, toLex (t.2.1, t.2.2)) :=
    ⟨((ofLex B).1, (ofLex (ofLex B).2).1, (ofLex (ofLex B).2).2), rfl⟩
  simp only [GAtom.map, ofLex_toLex]
  rw [Prod.Lex.lt_iff] at h ⊢
  rcases h with h | ⟨h1, h⟩
  · exact Or.inl h
  · refine Or.inr ⟨h1, ?_⟩
    simp only at h ⊢
    rw [Prod.Lex.lt_iff] at h ⊢
    rcases h with h | ⟨h2, h⟩
    · exact Or.inl h
    · exact Or.inr ⟨h2, hf.withBot_map h⟩

theorem keyWord_relKey_E3 (a : Nat) (X : Forest) :
    keyWord (relKey a X) = (gwordAt 0 X).map (GAtom.map (lab_E3 a)) := by
  unfold keyWord relKey
  rw [treeMap_map, gwordAt_map]
  rfl

theorem len_keyWord_E3 (a : Nat) (X : Forest) : (keyWord (relKey a X)).length = N_E3 X := by
  rw [keyWord_relKey_E3, List.length_map]; rfl

/-- First decreases of words are first decreases of key words. -/
theorem firstDec_keyWord_E3 (a : Nat) {X X' : Forest} {b : Nat}
    (h : FirstDec (gwordAt 0 X) (gwordAt 0 X') b) :
    FirstDec (keyWord (relKey a X)) (keyWord (relKey a X')) b := by
  rw [keyWord_relKey_E3, keyWord_relKey_E3]
  exact firstDec_map_E3 (gatomMap_strictMono_E3 (lab_strictMono_E3 a)) h

/-! Route paths of the old forest. -/

theorem cols_length_map_E3 (f : Nat → Nat) (F : Forest) : (Tree.map f F).cols.length = F.cols.length := by
  rw [cols_map_D3, List.length_map]

theorem rpath_map_E3 (f : Nat → Nat) : ∀ (k : Nat) (F : Forest), rpath_E3 k (Tree.map f F) = rpath_E3 k F
  | 0, _ => rfl
  | k + 1, F => by
    simp only [rpath_E3, cols_length_map_E3, nextLayer_map_D3, rpath_map_E3 f k]
    rw [cols_map_D3, List.getLast?_map]
    cases F.cols.getLast? with
    | none => rfl
    | some c => simp [treeMapCol_eq_map]

theorem skipLayers_map_E3 (f : Nat → Nat) : ∀ (k : Nat) (F : Forest),
    skipLayers (Tree.map f F) k = Tree.map f (skipLayers F k)
  | 0, _ => rfl
  | k + 1, F => by simp only [skipLayers, nextLayer_map_D3, skipLayers_map_E3 f k]

theorem hcol_map_E3 (f : Nat → Nat) (k : Nat) (F : Forest) : hcol_E3 k (Tree.map f F) = hcol_E3 k F := by
  simp only [hcol_E3, skipLayers_map_E3, cols_length_map_E3]

theorem rpath_skip_E3 {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    ∀ m i, i + m = sd.depth → rpath_E3 m (skipLayers E i) = sd.col.path.drop i := by
  obtain ⟨-, h2, -, -, h5, -⟩ := stopData_core h
  intro m
  induction m with
  | zero =>
    intro i hi
    simp only [rpath_E3]
    rw [List.drop_eq_nil_of_le (by omega)]
  | succ m ih =>
    intro i hi
    obtain ⟨col, p, hc, hp, -, hpk⟩ := h5 i (by omega)
    rw [rpath_E3, ← skipLayers_succ, ih (i + 1) (by omega),
      List.drop_eq_getElem_cons (l := sd.col.path) (i := i) (by omega)]
    rw [List.getElem?_eq_some_iff] at hpk
    obtain ⟨_, hpk⟩ := hpk
    rw [hpk, hc]
    obtain ⟨es, rfl⟩ := List.getLast?_eq_some_iff.1 hp
    simp

theorem hcol_skip_E3 {E : Forest} {sd : StopData} (h : stopData E = some sd) (m i : Nat)
    (hi : i + m = sd.depth) : hcol_E3 m (skipLayers E i) = sd.col.col := by
  obtain ⟨h1, -⟩ := stopData_core h
  simp only [hcol_E3, skipLayers_add, hi]; omega

/-! Translating relative addresses of a forest on the route into absolute addresses. -/

theorem entryAt_abs_E3 {A G : Forest} {π : List (Nat × Nat)} (hG : A.forestAt π = some G)
    (e : EntryAddr) : A.entryAt ⟨⟨π ++ e.col.path, e.col.col⟩, e.idx⟩ = G.entryAt e := by
  rw [Tree.entryAt_eq_bind, Tree.forestAt_append, hG, Option.bind_some, ← Tree.entryAt_eq_bind]

theorem num_abs_E3 (π : List (Nat × Nat)) (c : ColAddr) :
    (⟨π ++ c.path, c.col⟩ : ColAddr).num 0 = c.num ((π.map (·.1 + 1)).sum) := by
  simp only [ColAddr.num, List.map_append, List.sum_append]; omega

theorem isRoute_abs_E3 {k k' : Nat} {F G : Forest} {π : List (Nat × Nat)}
    (hp : rpath_E3 k' F = π ++ rpath_E3 k G) (e : EntryAddr) :
    IsRoute_E3 k' F ⟨⟨π ++ e.col.path, e.col.col⟩, e.idx⟩ ↔ IsRoute_E3 k G e := by
  simp only [IsRoute_E3, EntryAddr.heightPath, hp, List.append_assoc]
  exact List.prefix_append_right_inj π

theorem inHole_abs_E3 {k k' : Nat} {F G : Forest} {π : List (Nat × Nat)}
    (hp : rpath_E3 k' F = π ++ rpath_E3 k G) (hh : hcol_E3 k' F = hcol_E3 k G) (c : ColAddr) :
    InHole_E3 k' F ⟨π ++ c.path, c.col⟩ ↔ InHole_E3 k G c := by
  simp only [InHole_E3, hp, hh, List.append_assoc, List.append_cancel_left_eq]

/-! Locations of old entries: route containers, the hole region, the query region. -/

/-- `e` lies in the query region: an entry of `Q`, or inside the height of one. -/
def InQ_E3 (sd : StopData) (e : EntryAddr) : Prop :=
  (e.col = sd.col ∧ e.idx < sd.Q.length) ∨
    ∃ i < sd.Q.length, (⟨sd.col, i⟩ : EntryAddr).heightPath <+: e.col.path

/-- Entries outside the route and the hole are hereditary: so is everything in their heights. -/
theorem outside_hered_E3 {S : List (Nat × Nat)} {c0 : Nat} {e0 e : EntryAddr}
    (hr : ¬ e0.heightPath <+: S)
    (hh : ¬ ((e0.col.path = S ∧ c0 ≤ e0.col.col) ∨
      ∃ c' i rest, e0.col.path = S ++ (c', i) :: rest ∧ c0 ≤ c'))
    (hc : e0.heightPath <+: e.col.path) :
    ¬ e.heightPath <+: S ∧ ¬ ((e.col.path = S ∧ c0 ≤ e.col.col) ∨
      ∃ c' i rest, e.col.path = S ++ (c', i) :: rest ∧ c0 ≤ c') := by
  have hc' : e0.heightPath <+: e.heightPath := hc.trans (List.prefix_append _ _)
  refine ⟨fun h => hr (hc'.trans h), ?_⟩
  rintro (⟨h1, -⟩ | ⟨c', i, rest, h1, h2⟩)
  · exact hr (h1 ▸ hc)
  · have hS : S <+: e.col.path := h1 ▸ List.prefix_append _ _
    rcases List.prefix_or_prefix_of_prefix hc hS with h3 | h3
    · exact hr h3
    · -- `S` is a proper prefix of `e0.heightPath`
      have hlen : S.length < e0.heightPath.length := by
        rcases Nat.lt_or_ge S.length e0.heightPath.length with h4 | h4
        · exact h4
        · exact absurd (h3.eq_of_length_le h4 ▸ List.prefix_refl S) (fun h => hr (by
            rw [h3.eq_of_length_le h4]))
      have hlen' : S.length ≤ e0.col.path.length := by
        simp [EntryAddr.heightPath] at hlen; omega
      have hSP : S <+: e0.col.path :=
        List.prefix_of_prefix_length_le h3 (List.prefix_append _ _) hlen'
      obtain ⟨T, hT⟩ := hSP
      -- position `S.length` of `e.col.path`
      have hpos : ∀ x, (e0.heightPath)[S.length]? = some x → x = (c', i) := by
        intro x hx
        obtain ⟨tt, htt⟩ := hc
        have := congrArg (fun l => l[S.length]?) htt
        rw [List.getElem?_append_left (by rw [List.getElem?_eq_some_iff] at hx; exact hx.1),
          hx, h1] at this
        simp at this; exact this
      cases T with
      | nil =>
        simp only [List.append_nil] at hT
        have hx := hpos (e0.col.col, e0.idx) (by
          simp [EntryAddr.heightPath, ← hT])
        simp only [Prod.mk.injEq] at hx
        exact hh (Or.inl ⟨hT.symm, hx.1 ▸ h2⟩)
      | cons t T =>
        have hx := hpos t (by simp [EntryAddr.heightPath, ← hT])
        exact hh (Or.inr ⟨t.1, t.2, T, by rw [← hT, hx], by rw [hx]; exact h2⟩)

/-- Route containers are outside the hole region. -/
theorem route_not_hole_E3 {S : List (Nat × Nat)} {c0 : Nat} {e : EntryAddr} (h : e.heightPath <+: S) :
    ¬ ((e.col.path = S ∧ c0 ≤ e.col.col) ∨ ∃ c' i rest, e.col.path = S ++ (c', i) :: rest ∧ c0 ≤ c') := by
  have := h.length_le
  simp only [EntryAddr.heightPath, List.length_append, List.length_singleton] at this
  rintro (⟨h1, -⟩ | ⟨c', i, rest, h1, -⟩)
  · rw [h1] at this; omega
  · rw [h1] at this; simp at this

/-! Origins of the entries of the loop output. -/

/-- A template entry of `A`: below the root column's forest, numbered at least `r`, and in the
query region or outside the hole. -/
def Tmpl_E3 (A : Forest) (sd : StopData) (rd : RootData) (e : EntryAddr) : Prop :=
  rd.col.path <+: e.col.path ∧ sd.r ≤ e.col.num 0 ∧
    (InQ_E3 sd e ∨ ¬ InHole_E3 sd.depth A e.col)

/-- `(y, c')` (an entry and its column number) is the phase-`ψ` copy of the old entry `e`: parent
shifted, number shifted, height shifted, or (route containers) shifted with the filling of
layer `ψ` placed in its hole. -/
def Orig_E3 (A : Forest) (sd : StopData) (rd : RootData) (n ψ : Nat) (e : EntryAddr)
    (y : Nat × Forest) (c' : Nat) : Prop :=
  ∃ x, A.entryAt e = some x ∧ y.1 = shiftVal sd.r (ψ * period sd) x.1 ∧
    c' = e.col.num 0 + ψ * period sd ∧
    ((¬ e.heightPath <+: sd.col.path ∧ y.2 = shift sd.r (ψ * period sd) x.2) ∨
     (e.heightPath <+: sd.col.path ∧ y.2 = replaceAt sd.r (ψ * period sd) (zs_E3 A sd rd n ψ)
        (sd.depth - e.col.path.length - 1) x.2))

/-- Every entry of the filling `Z` of layer `j` (first column numbered `t + j d`) is a copy of a
template entry, of phase `ψ ≥ j`, and of phase `j` only in the query region of the first head. -/
def E1_E3 (A : Forest) (sd : StopData) (rd : RootData) (n j : Nat) (Z : Forest) : Prop :=
  ∀ ρ y, Z.entryAt ρ = some y → ∃ e ψ, j ≤ ψ ∧ ψ ≤ n ∧ (ψ = j → InQ_E3 sd e) ∧
    Tmpl_E3 A sd rd e ∧ Orig_E3 A sd rd n ψ e y (ρ.col.num (sd.t + j * period sd))

theorem num_ge_E3 (b : Nat) (c : ColAddr) : b ≤ c.num b := by simp only [ColAddr.num]; omega

theorem sum_heightPath_E3 (e : EntryAddr) :
    (e.heightPath.map (·.1 + 1)).sum = e.col.num 0 + 1 := by
  simp [EntryAddr.heightPath, ColAddr.num]; omega

theorem stop_rpath_E3 {A : Forest} {sd : StopData} (hsd : stopData A = some sd) :
    rpath_E3 sd.depth A = sd.col.path ∧ hcol_E3 sd.depth A = sd.col.col := by
  have h1 := rpath_skip_E3 hsd sd.depth 0 (by omega)
  have h2 := hcol_skip_E3 hsd sd.depth 0 (by omega)
  simp only [skipLayers, List.drop_zero] at h1 h2
  exact ⟨h1, h2⟩

/-- Pure copies of the entries inside the height of a non-route template entry. -/
theorem pure_orig_E3 {A : Forest} {sd : StopData} (rd : RootData) (n : Nat)
    (hsd : stopData A = some sd)
    {e0 : EntryAddr} {x0 : Nat × Forest} (hx0 : A.entryAt e0 = some x0)
    (hnr : ¬ e0.heightPath <+: sd.col.path) (hloc : InQ_E3 sd e0 ∨ ¬ InHole_E3 sd.depth A e0.col)
    (hrd0 : rd.col.path <+: e0.col.path) (hr0 : sd.r ≤ e0.col.num 0) (ψ : Nat) {ρ : EntryAddr}
    {y : Nat × Forest} (hy : (shift sd.r (ψ * period sd) x0.2).entryAt ρ = some y) :
    Tmpl_E3 A sd rd ⟨⟨e0.heightPath ++ ρ.col.path, ρ.col.col⟩, ρ.idx⟩ ∧
      (InQ_E3 sd e0 → InQ_E3 sd ⟨⟨e0.heightPath ++ ρ.col.path, ρ.col.col⟩, ρ.idx⟩) ∧
      Orig_E3 A sd rd n ψ ⟨⟨e0.heightPath ++ ρ.col.path, ρ.col.col⟩, ρ.idx⟩ y
        (ρ.col.num (e0.col.num 0 + 1 + ψ * period sd)) := by
  obtain ⟨hrp, hhc⟩ := stop_rpath_E3 hsd
  rw [shift, entryAt_map_D3] at hy
  obtain ⟨x, hx, rfl⟩ := Option.map_eq_some_iff.1 hy
  have hfa : A.forestAt e0.heightPath = some x0.2 := by
    rw [Tree.forestAt_heightPath, Tree.heightAt, hx0]; rfl
  have hA := entryAt_abs_E3 hfa ρ
  rw [hx] at hA
  have hcon : e0.heightPath <+: (⟨⟨e0.heightPath ++ ρ.col.path, ρ.col.col⟩, ρ.idx⟩ : EntryAddr).col.path :=
    List.prefix_append _ _
  have hnum : (⟨⟨e0.heightPath ++ ρ.col.path, ρ.col.col⟩, ρ.idx⟩ : EntryAddr).col.num 0 =
      ρ.col.num (e0.col.num 0 + 1) := by
    rw [num_abs_E3, sum_heightPath_E3]
  have hnr' : ¬ (⟨⟨e0.heightPath ++ ρ.col.path, ρ.col.col⟩, ρ.idx⟩ : EntryAddr).heightPath <+:
      sd.col.path := fun h => hnr ((hcon.trans (List.prefix_append _ _)).trans h)
  have hq : InQ_E3 sd e0 → InQ_E3 sd ⟨⟨e0.heightPath ++ ρ.col.path, ρ.col.col⟩, ρ.idx⟩ := by
    rintro (⟨h1, h2⟩ | ⟨i, hi, h⟩)
    · refine Or.inr ⟨e0.idx, h2, ?_⟩
      have : (⟨sd.col, e0.idx⟩ : EntryAddr) = e0 := by rw [← h1]
      rw [this]; exact hcon
    · exact Or.inr ⟨i, hi, h.trans ((List.prefix_append _ _).trans hcon)⟩
  refine ⟨⟨hrd0.trans ((List.prefix_append _ _).trans hcon), ?_, ?_⟩, hq, x, hA, rfl, ?_, Or.inl ⟨hnr', rfl⟩⟩
  · rw [hnum]; have := num_ge_E3 (e0.col.num 0 + 1) ρ.col; omega
  · rcases hloc with h | h
    · exact Or.inl (hq h)
    · right
      simp only [InHole_E3, hrp, hhc] at h ⊢
      exact (outside_hered_E3 hnr h hcon).2
  · rw [hnum, num_add_D3]

/-- The first column index of an address (the column of its outermost step). -/
def fstCol_E3 (e : EntryAddr) : Nat :=
  match e.col.path with
  | [] => e.col.col
  | (c, _) :: _ => c

theorem num_ge_fst_E3 (b : Nat) (e : EntryAddr) : b + fstCol_E3 e ≤ e.col.num b := by
  obtain ⟨⟨P, j⟩, i⟩ := e
  cases P with
  | nil => simp [fstCol_E3, ColAddr.num]
  | cons s P => obtain ⟨c, m⟩ := s; simp [fstCol_E3, ColAddr.num]; omega

/-- The route forests of `A`, read relatively. -/
theorem skip_data_E3 {A : Forest} {sd : StopData} (hsd : stopData A = some sd) {i : Nat}
    (hi : i ≤ sd.depth) :
    A.forestAt (sd.col.path.take i) = some (skipLayers A i) ∧
      RouteOK_D3 (sd.depth - i) (skipLayers A i) ∧
      leftCount A i + routeNum_D3 (sd.depth - i) (skipLayers A i) = sd.t ∧
      rpath_E3 sd.depth A = sd.col.path.take i ++ rpath_E3 (sd.depth - i) (skipLayers A i) ∧
      hcol_E3 sd.depth A = hcol_E3 (sd.depth - i) (skipLayers A i) ∧
      ((sd.col.path.take i).map (·.1 + 1)).sum = leftCount A i := by
  obtain ⟨hrp, hhc⟩ := stop_rpath_E3 hsd
  have h1 := stop_route_D3 hsd (sd.depth - i) (by omega)
  rw [show sd.depth - (sd.depth - i) = i by omega] at h1
  refine ⟨skipLayers_of_stopData hsd hi, h1.1, h1.2, ?_, ?_, stop_pathSum_D3 hsd i hi⟩
  · rw [hrp, rpath_skip_E3 hsd (sd.depth - i) i (by omega), List.take_append_drop]
  · rw [hhc, hcol_skip_E3 hsd (sd.depth - i) i (by omega)]

/-- Entries of a filled copy of a route forest `skipLayers A i` (the owner's last restored
height, or the root forest in the body case): kept entries and route containers are copies of
phase `k`, hole entries come from the filling of layer `k`. -/
theorem route_orig_E3 {A : Forest} {sd : StopData} {rd : RootData} {n : Nat}
    (hsd : stopData A = some sd) (hrp : rd.col.path = sd.col.path.take rd.layer)
    {i : Nat} (hi : i ≤ sd.depth) (hli : rd.layer ≤ i) {k : Nat}
    (hE : E1_E3 A sd rd n k (zs_E3 A sd rd n k)) (hk : k ≤ n) {e : EntryAddr} {y : Nat × Forest}
    (hy : (replaceAt 0 0 (zs_E3 A sd rd n k) (sd.depth - i)
      (shift sd.r (k * period sd) (skipLayers A i))).entryAt e = some y)
    (hnum : sd.r ≤ leftCount A i + fstCol_E3 e) :
    ∃ eA ψ, k ≤ ψ ∧ ψ ≤ n ∧ Tmpl_E3 A sd rd eA ∧
      Orig_E3 A sd rd n ψ eA y (e.col.num (leftCount A i + k * period sd)) := by
  obtain ⟨hfa, hR, hN, hrp', hhc', hsum⟩ := skip_data_E3 hsd hi
  obtain ⟨hrpA, hhcA⟩ := stop_rpath_E3 hsd
  have hRG := (routeOK_shift_D3 sd.r (k * period sd) _ _).2 hR
  have hrpG : rpath_E3 sd.depth A = sd.col.path.take i ++
      rpath_E3 (sd.depth - i) (shift sd.r (k * period sd) (skipLayers A i)) := by
    rw [shift, rpath_map_E3]; exact hrp'
  have hhcG : hcol_E3 sd.depth A = hcol_E3 (sd.depth - i) (shift sd.r (k * period sd) (skipLayers A i)) := by
    rw [shift, hcol_map_E3]; exact hhc'
  have hlen : (sd.col.path.take i).length = i := by
    obtain ⟨-, h2, -⟩ := stopData_core hsd; rw [List.length_take]; omega
  have hrdP : rd.col.path <+: sd.col.path.take i := hrp ▸ List.take_prefix_take_left hli
  have hnumA : ∀ e' : EntryAddr, (⟨sd.col.path.take i ++ e'.col.path, e'.col.col⟩ : ColAddr).num 0 =
      e'.col.num (leftCount A i) := fun e' => by rw [num_abs_E3, hsum]
  have hP := put_entryAt_E3 (zs_E3 A sd rd n k) (sd.depth - i) _ hRG e
  by_cases hh : InHole_E3 (sd.depth - i) (shift sd.r (k * period sd) (skipLayers A i)) e.col
  · obtain ⟨h1, h2⟩ := hP.1 hh
    rw [h1] at hy
    obtain ⟨eA, ψ, hψ1, hψ2, -, ht, ho⟩ := hE _ _ hy
    refine ⟨eA, ψ, hψ1, hψ2, ht, ?_⟩
    rw [h2, routeNum_shift_D3, show leftCount A i + k * period sd + routeNum_D3 (sd.depth - i)
      (skipLayers A i) = sd.t + k * period sd by omega]
    exact ho
  · -- kept entries and route containers: copies of `skipLayers A i` at phase `k`
    have hkept : ∀ x, (skipLayers A i).entryAt e = some x →
        A.entryAt ⟨⟨sd.col.path.take i ++ e.col.path, e.col.col⟩, e.idx⟩ = some x := by
      intro x hx; rw [entryAt_abs_E3 hfa, hx]
    have hhA : ¬ InHole_E3 sd.depth A ⟨sd.col.path.take i ++ e.col.path, e.col.col⟩ := by
      rw [inHole_abs_E3 hrpG hhcG]; exact hh
    have htm : sd.r ≤ (⟨sd.col.path.take i ++ e.col.path, e.col.col⟩ : ColAddr).num 0 := by
      rw [hnumA]; exact le_trans hnum (num_ge_fst_E3 _ e)
    have hrdA : rd.col.path <+: (⟨sd.col.path.take i ++ e.col.path, e.col.col⟩ : ColAddr).path :=
      hrdP.trans (List.prefix_append _ _)
    refine ⟨⟨⟨sd.col.path.take i ++ e.col.path, e.col.col⟩, e.idx⟩, k, le_rfl, hk,
      ⟨hrdA, htm, Or.inr hhA⟩, ?_⟩
    by_cases hr : IsRoute_E3 (sd.depth - i) (shift sd.r (k * period sd) (skipLayers A i)) e
    · rw [hP.2.1 hh hr, shift, entryAt_map_D3] at hy
      simp only [Option.map_map] at hy
      obtain ⟨x, hx, rfl⟩ := Option.map_eq_some_iff.1 hy
      refine ⟨x, hkept x hx, rfl, by rw [hnumA, num_add_D3], Or.inr ⟨?_, ?_⟩⟩
      · have := (isRoute_abs_E3 hrpG e).2 hr
        rwa [IsRoute_E3, hrpA] at this
      · simp only [Function.comp, List.length_append, hlen]
        rw [replaceAt_eq_shift sd.r,
          show sd.depth - (i + e.col.path.length) - 1 = sd.depth - i - e.col.path.length - 1 by omega]
        rfl
    · rw [hP.2.2 hh hr, shift, entryAt_map_D3] at hy
      obtain ⟨x, hx, rfl⟩ := Option.map_eq_some_iff.1 hy
      refine ⟨x, hkept x hx, rfl, by rw [hnumA, num_add_D3], Or.inl ⟨?_, rfl⟩⟩
      intro h
      apply hr
      have : IsRoute_E3 sd.depth A ⟨⟨sd.col.path.take i ++ e.col.path, e.col.col⟩, e.idx⟩ := by
        rw [IsRoute_E3, hrpA]; exact h
      exact (isRoute_abs_E3 hrpG e).1 this

/-- Facts about the root column and its unconsumed suffix. -/
theorem root_pack_E3 {A : Forest} {sd : StopData} {rd : RootData} (hV : CondV A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) :
    rd.col.path = sd.col.path.take rd.layer ∧ rd.col.col = rd.idx ∧ rd.col.num 0 = sd.r ∧
      sd.r = leftCount A rd.layer + rd.idx ∧ rd.layer ≤ sd.depth ∧
      (A.forestAt rd.col.path).getD Tree.empty = skipLayers A rd.layer ∧
      (∀ v u, (((A.colAt rd.col).getD []).drop rd.cursor)[v]? = some u →
        A.entryAt ⟨rd.col, rd.cursor + v⟩ = some u ∧ u.1 < sd.r ∧
        ¬ InHole_E3 sd.depth A rd.col ∧
        ((⟨rd.col, rd.cursor + v⟩ : EntryAddr).heightPath <+: sd.col.path ↔
          rd.owner = true ∧ v + 1 = (((A.colAt rd.col).getD []).drop rd.cursor).length)) ∧
      (rd.owner = true → ∀ u, (((A.colAt rd.col).getD []).drop rd.cursor).getLast? = some u →
        u.2 = skipLayers A (rd.layer + 1) ∧ rd.layer < sd.depth ∧
        leftCount A (rd.layer + 1) = sd.r + 1) := by
  obtain ⟨hle, hfa, hr, hidx, howner, hcol⟩ := root_facts_D3 hsd hrd
  obtain ⟨-, hlay, hcc, hnum, hrt, hmem, -, -⟩ := rootData_spec hsd hrd
  obtain ⟨-, -, -, hpre, -⟩ := rootData_path hsd hrd
  obtain ⟨h1, h2, h3, h4, h5, -⟩ := stopData_core hsd
  obtain ⟨hrpA, hhcA⟩ := stop_rpath_E3 hsd
  obtain ⟨-, -, hU, -⟩ := ord_vdata_D3 hV hsd hrd
  have hpath : rd.col.path = sd.col.path.take rd.layer := by
    rw [List.prefix_iff_eq_take] at hpre; rw [hpre, hlay]
  obtain ⟨R, hR⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff A rd.col).1 hmem)
  have hRc : (skipLayers A rd.layer).cols[rd.idx]? = some R := by rw [← hcol, hR]
  have hstep : rd.layer < sd.depth → ∃ col p, (skipLayers A rd.layer).cols.getLast? = some col ∧
      col.getLast? = some (p, skipLayers A (rd.layer + 1)) ∧
      sd.col.path[rd.layer]? = some ((skipLayers A rd.layer).cols.length - 1, col.length - 1) := by
    intro hl; obtain ⟨col, p, a, b, -, c⟩ := h5 rd.layer hl; exact ⟨col, p, a, b, c⟩
  have hlr : rd.owner = true → rd.layer < sd.depth := rootData_layer_lt hsd hrd
  have hlastR : rd.owner = true → ∀ col, (skipLayers A rd.layer).cols.getLast? = some col → col = R := by
    intro hown col hc1
    rw [List.getLast?_eq_getElem?, show (skipLayers A rd.layer).cols.length - 1 = rd.idx by
      have := howner.1 hown; omega, hRc] at hc1
    exact (Option.some.inj hc1).symm
  have hnh : ¬ InHole_E3 sd.depth A rd.col := by
    simp only [InHole_E3, hrpA, hhcA]
    rintro (⟨hp, hc⟩ | ⟨c', i, rest, hp, -⟩)
    · have hl : rd.layer = sd.depth := by
        have := congrArg List.length hp; rw [hlay]; simpa [h2] using this
      have hown : rd.owner = false := by
        cases ho : rd.owner
        · rfl
        · exact absurd hl (Nat.ne_of_lt (hlr ho))
      have : rd.idx + 1 < (skipLayers A rd.layer).cols.length := by
        have : ¬ rd.idx + 1 = (skipLayers A rd.layer).cols.length := by rw [← howner, hown]; simp
        omega
      rw [hl] at this; rw [← hcc] at hc; omega
    · have := congrArg List.length hp
      have := hpre.length_le
      simp at *; omega
  refine ⟨hpath, hcc.symm, hnum, hr, hle, by rw [hfa]; rfl, ?_, ?_⟩
  · intro v u hu
    have hmemU : u ∈ ((A.colAt rd.col).getD []).drop rd.cursor := List.mem_of_getElem? hu
    rw [hR, Option.getD_some, List.getElem?_drop] at hu
    refine ⟨by simp [Tree.entryAt, hR, hu], (hU u hmemU).1, hnh, ?_⟩
    have hlt : rd.cursor + v < R.length := (List.getElem?_eq_some_iff.1 hu).1
    simp only [hR, Option.getD_some, List.length_drop]
    have hhp : (⟨rd.col, rd.cursor + v⟩ : EntryAddr).heightPath =
        sd.col.path.take rd.layer ++ [(rd.idx, rd.cursor + v)] := by
      rw [EntryAddr.heightPath, hpath, ← hcc]
    rw [hhp]
    constructor
    · intro hon
      have hlen := hon.length_le
      simp only [List.length_append, List.length_take, List.length_singleton] at hlen
      have hl : rd.layer < sd.depth := by omega
      obtain ⟨col, p, hc1, hc2, hc3⟩ := hstep hl
      have : sd.col.path[rd.layer]? = some (rd.idx, rd.cursor + v) := by
        obtain ⟨t, ht⟩ := hon
        rw [← ht, List.append_assoc, List.getElem?_append_right (by simp), List.length_take,
          Nat.min_eq_left (by omega), Nat.sub_self]
        rfl
      rw [hc3] at this
      simp only [Option.some.injEq, Prod.mk.injEq] at this
      have hown : rd.owner = true := howner.2 (by omega)
      refine ⟨hown, ?_⟩
      have := hlastR hown col hc1
      subst this; omega
    · rintro ⟨hown, hv⟩
      obtain ⟨col, p, hc1, hc2, hc3⟩ := hstep (hlr hown)
      have := hlastR hown col hc1
      subst this
      have hio := howner.1 hown
      rw [List.prefix_iff_eq_take, List.length_append, List.length_take, List.length_singleton,
        show min rd.layer sd.col.path.length = rd.layer by omega, List.take_add_one]
      congr 1
      rw [hc3]; simp; omega
  · intro hown u hu
    obtain ⟨col, p, hc1, hc2, hc3⟩ := hstep (hlr hown)
    have := hlastR hown col hc1
    subst this
    rw [hR, Option.getD_some, List.getLast?_drop] at hu
    split at hu
    · cases hu
    · rw [hc2] at hu
      refine ⟨by rw [← Option.some.inj hu], hlr hown, ?_⟩
      rw [leftCount_succ_D3, hr]; have := howner.1 hown; omega

/-! Entries of a step of the loop. -/

/-- Move an address `m` columns to the right in its outermost forest. -/
def addCol_E3 (m : Nat) (e : EntryAddr) : EntryAddr :=
  match e.col.path with
  | [] => ⟨⟨[], e.col.col + m⟩, e.idx⟩
  | (c, i) :: P => ⟨⟨(c + m, i) :: P, e.col.col⟩, e.idx⟩

theorem entryAt_drop_E3 (L : List Column) (m : Nat) (e : EntryAddr) :
    (Tree.node (L.drop m)).entryAt e = (Tree.node L).entryAt (addCol_E3 m e) := by
  obtain ⟨⟨P, j⟩, i⟩ := e
  cases P with
  | nil => simp only [addCol_E3, entryAt_nil_D3, List.getElem?_drop]; rw [Nat.add_comm]
  | cons s P =>
    obtain ⟨c, k⟩ := s
    simp only [addCol_E3, entryAt_cons_D3, List.getElem?_drop]; rw [Nat.add_comm m c]

theorem addCol_num_E3 (m b : Nat) (e : EntryAddr) :
    (addCol_E3 m e).col.num b = e.col.num (b + m) := by
  obtain ⟨⟨P, j⟩, i⟩ := e
  cases P with
  | nil => simp [addCol_E3, ColAddr.num]; omega
  | cons s P => obtain ⟨c, k⟩ := s; simp [addCol_E3, ColAddr.num]; omega

theorem fstCol_addCol_E3 (m : Nat) (e : EntryAddr) : fstCol_E3 (addCol_E3 m e) = fstCol_E3 e + m := by
  obtain ⟨⟨P, j⟩, i⟩ := e
  cases P with
  | nil => rfl
  | cons s P => obtain ⟨c, k⟩ := s; rfl

theorem addCol_of_fstCol_E3 (e : EntryAddr) (h : 1 ≤ fstCol_E3 e) : ∃ e0, e = addCol_E3 1 e0 := by
  obtain ⟨⟨P, j⟩, i⟩ := e
  cases P with
  | nil =>
    simp only [fstCol_E3] at h
    exact ⟨⟨⟨[], j - 1⟩, i⟩, by simp [addCol_E3]; omega⟩
  | cons s P =>
    obtain ⟨c, k⟩ := s
    simp only [fstCol_E3] at h
    exact ⟨⟨⟨(c - 1, k) :: P, j⟩, i⟩, by simp [addCol_E3]; omega⟩

theorem put_drop_E3 (Z : Forest) : ∀ (k : Nat) (L : List Column), RouteOK_D3 k (.node L) →
    ∀ m, m < L.length →
      replaceAt 0 0 Z k (.node (L.drop m)) = .node ((replaceAt 0 0 Z k (.node L)).cols.drop m)
  | 0, L, hR, m, hm => by
    have hc : L ≠ [] := hR
    have hc' : L.drop m ≠ [] := by simp; omega
    rw [put_zero_D3 Z hc, put_zero_D3 Z hc']
    obtain ⟨L', x, rfl⟩ := List.eq_nil_or_concat L |>.resolve_left hc
    simp only [List.concat_eq_append, List.length_append, List.length_singleton] at hm ⊢
    obtain ⟨zc⟩ := Z
    simp only [Tree.cols, List.dropLast_concat]
    rw [List.drop_append_of_le_length (by omega), List.drop_append_of_le_length (by omega),
      List.dropLast_concat]
  | k + 1, L, hR, m, hm => by
    obtain ⟨cs, es, q, H, he, hR'⟩ := hR
    simp only [Tree.node.injEq] at he
    subst he
    simp only [List.length_append, List.length_singleton] at hm
    rw [List.drop_append_of_le_length (by omega), put_succ_D3, put_succ_D3]
    simp only [Tree.cols]
    rw [List.drop_append_of_le_length (by omega)]

theorem shift_drop_E3 (r d : Nat) (L : List Column) (m : Nat) :
    shift r d (.node (L.drop m)) = .node ((shift r d (.node L)).cols.drop m) := by
  simp [shift, Tree.map, Tree.cols, treeMapCols_eq_map, List.map_drop]

theorem q_pack_E3 {A : Forest} {sd : StopData} {rd : RootData} (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) {i : Nat} {x : Nat × Forest} (hx : sd.Q[i]? = some x) :
    A.entryAt ⟨sd.col, i⟩ = some x ∧ ¬ (⟨sd.col, i⟩ : EntryAddr).heightPath <+: sd.col.path ∧
      InQ_E3 sd ⟨sd.col, i⟩ ∧ Tmpl_E3 A sd rd ⟨sd.col, i⟩ := by
  obtain ⟨hcol, -, ht, -⟩ := stopData_spec hsd
  obtain ⟨-, -, -, -, hrt, -⟩ := rootData_spec hsd hrd
  obtain ⟨-, -, -, hpre, -⟩ := rootData_path hsd hrd
  have hi : i < sd.Q.length := (List.getElem?_eq_some_iff.1 hx).1
  have hq : InQ_E3 sd ⟨sd.col, i⟩ := Or.inl ⟨rfl, hi⟩
  refine ⟨?_, ?_, hq, hpre, by rw [← ht]; omega, Or.inl hq⟩
  · simp only [Tree.entryAt, hcol, Option.bind_some]
    rw [List.getElem?_append_left hi, hx]
  · intro h
    have := h.length_le
    simp [EntryAddr.heightPath] at this

/-- The head column of a step: the query copy (phase `k-1`) and the restored entries (phase `k`). -/
theorem head_orig_E3 {A : Forest} {sd : StopData} {rd : RootData} {n k : Nat} (hL : InL A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) (hk1 : 1 ≤ k) (hkn : k ≤ n)
    (hE : E1_E3 A sd rd n k (zs_E3 A sd rd n k)) {W : Column} {rest : List Column}
    (hW : ∀ v x, W[v]? = some x → ∃ u, (((A.colAt rd.col).getD []).drop rd.cursor)[v]? = some u ∧
      x.1 = u.1 ∧ ((¬ (rd.owner = true ∧ v + 1 = (((A.colAt rd.col).getD []).drop rd.cursor).length) ∧
          x.2 = shift sd.r (k * period sd) u.2) ∨
        (rd.owner = true ∧ v + 1 = (((A.colAt rd.col).getD []).drop rd.cursor).length ∧
          x.2 = replaceAt sd.r (k * period sd) (zs_E3 A sd rd n k) (sd.depth - rd.layer - 1) u.2)))
    {ρ : EntryAddr} {y : Nat × Forest} (hρ : fstCol_E3 ρ = 0)
    (hy : (Tree.node ((Tree.mapCol (shiftVal sd.r ((k - 1) * period sd)) sd.Q ++ W) :: rest)).entryAt ρ
      = some y) :
    ∃ e ψ, k - 1 ≤ ψ ∧ ψ ≤ n ∧ (ψ = k - 1 → InQ_E3 sd e) ∧ Tmpl_E3 A sd rd e ∧
      Orig_E3 A sd rd n ψ e y (ρ.col.num (sd.t + (k - 1) * period sd)) := by
  obtain ⟨hpath, hcc, hnum, hr, hle, hF, hUe, hlast⟩ := root_pack_E3 hL.1 hsd hrd
  obtain ⟨-, -, ht, -⟩ := stopData_spec hsd
  obtain ⟨-, -, -, -, hrt, -⟩ := rootData_spec hsd hrd
  have hbase : sd.t + (k - 1) * period sd = sd.r + k * period sd := by
    obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
    simp only [period, Nat.add_sub_cancel, Nat.succ_mul]; omega
  have hlay : rd.col.path.length = rd.layer := by
    rw [hpath, List.length_take]; obtain ⟨-, h2, -⟩ := stopData_core hsd; omega
  have hhd : ∀ i, (Tree.mapCol (shiftVal sd.r ((k - 1) * period sd)) sd.Q ++ W)[i]? =
      if i < sd.Q.length then (sd.Q[i]?).map (fun x => (shiftVal sd.r ((k - 1) * period sd) x.1,
        shift sd.r ((k - 1) * period sd) x.2)) else W[i - sd.Q.length]? := by
    intro i
    split_ifs with hi
    · rw [List.getElem?_append_left (by rw [treeMapCol_eq_map, List.length_map]; exact hi),
        treeMapCol_eq_map, List.getElem?_map]; rfl
    · rw [List.getElem?_append_right (by rw [treeMapCol_eq_map, List.length_map]; omega),
        treeMapCol_eq_map, List.length_map]
  -- the restored entry `v`
  have hWo : ∀ v x, W[v]? = some x → (Tmpl_E3 A sd rd ⟨rd.col, rd.cursor + v⟩ ∧
      ∃ u, A.entryAt ⟨rd.col, rd.cursor + v⟩ = some u ∧ x.1 = shiftVal sd.r (k * period sd) u.1 ∧
      ((¬ (⟨rd.col, rd.cursor + v⟩ : EntryAddr).heightPath <+: sd.col.path ∧
          x.2 = shift sd.r (k * period sd) u.2) ∨
        ((⟨rd.col, rd.cursor + v⟩ : EntryAddr).heightPath <+: sd.col.path ∧ rd.owner = true ∧
          x.2 = replaceAt sd.r (k * period sd) (zs_E3 A sd rd n k) (sd.depth - rd.layer - 1) u.2 ∧
          u.2 = skipLayers A (rd.layer + 1) ∧ rd.layer < sd.depth ∧
          leftCount A (rd.layer + 1) = sd.r + 1))) := by
    intro v x hx
    obtain ⟨u, hu, hx1, hx2⟩ := hW v x hx
    obtain ⟨hA, hur, hnh, hon⟩ := hUe v u hu
    refine ⟨⟨List.prefix_refl _, by rw [hnum], Or.inr hnh⟩, u, hA, ?_, ?_⟩
    · rw [hx1, shiftVal, if_neg (by omega)]
    · rcases hx2 with ⟨h1, h2⟩ | ⟨h1, h2, h3⟩
      · exact Or.inl ⟨fun h => h1 (hon.1 h), h2⟩
      · have hl : (((A.colAt rd.col).getD []).drop rd.cursor).getLast? = some u := by
          rw [List.getLast?_eq_getElem?, show (((A.colAt rd.col).getD []).drop rd.cursor).length - 1 = v
            by omega, hu]
        obtain ⟨g1, g2, g3⟩ := hlast h1 u hl
        exact Or.inr ⟨hon.2 ⟨h1, h2⟩, h1, h3, g1, g2, g3⟩
  obtain ⟨⟨P, j⟩, i⟩ := ρ
  cases P with
  | nil =>
    simp only [fstCol_E3] at hρ
    subst hρ
    rw [entryAt_nil_D3] at hy
    simp only [List.getElem?_cons_zero, Option.bind_some, hhd] at hy
    split_ifs at hy with hi
    · obtain ⟨x, hx, rfl⟩ := Option.map_eq_some_iff.1 hy
      obtain ⟨hA, hnr, hq, htm⟩ := q_pack_E3 hsd hrd hx
      refine ⟨⟨sd.col, i⟩, k - 1, le_rfl, by omega, fun _ => hq, htm, x, hA, rfl, ?_,
        Or.inl ⟨hnr, rfl⟩⟩
      simp [num_nil_D3, ht]
    · obtain ⟨htm, u, hA, hy1, hy2⟩ := hWo _ _ hy
      refine ⟨⟨rd.col, rd.cursor + (i - sd.Q.length)⟩, k, by omega, hkn, fun h => by omega, htm,
        u, hA, hy1, by simp [num_nil_D3, hnum, hbase], ?_⟩
      rcases hy2 with h | ⟨h1, -, h2, -⟩
      · exact Or.inl h
      · exact Or.inr ⟨h1, by rw [h2, hlay]⟩
  | cons s P =>
    obtain ⟨c0, i0⟩ := s
    simp only [fstCol_E3] at hρ
    subst hρ
    rw [entryAt_cons_D3] at hy
    simp only [List.getElem?_cons_zero, Option.bind_some, hhd] at hy
    rw [num_cons_D3]
    split_ifs at hy with hi
    · cases hx : sd.Q[i0]? with
      | none => simp [hx] at hy
      | some x =>
        simp only [hx, Option.map_some, Option.bind_some] at hy
        obtain ⟨hA, hnr, hq, htm⟩ := q_pack_E3 hsd hrd hx
        obtain ⟨t1, t2, t3⟩ := pure_orig_E3 rd n hsd hA hnr htm.2.2 htm.1 htm.2.1 (k - 1) hy
        refine ⟨_, k - 1, le_rfl, by omega, fun _ => t2 hq, t1, ?_⟩
        convert t3 using 2
        simp only; rw [← ht]; omega
    · obtain ⟨x, hx, hy⟩ := Option.bind_eq_some_iff.1 hy
      · obtain ⟨htm, u, hA, hy1, hy2⟩ := hWo _ _ hx
        rcases hy2 with ⟨hnr, h2⟩ | ⟨hon, hown, h2, g1, g2, g3⟩
        · rw [h2] at hy
          obtain ⟨t1, -, t3⟩ := pure_orig_E3 rd n hsd hA hnr htm.2.2 htm.1 htm.2.1 k hy
          refine ⟨_, k, by omega, hkn, fun h => by omega, t1, ?_⟩
          convert t3 using 2
          simp only; rw [hnum]; omega
        · rw [h2, g1, replaceAt_eq_shift] at hy
          obtain ⟨eA, ψ, hψ1, hψ2, htA, hoA⟩ := route_orig_E3 hsd hpath (i := rd.layer + 1)
            (by omega) (by omega) hE hkn (by rw [show sd.depth - (rd.layer + 1) =
              sd.depth - rd.layer - 1 by omega]; exact hy) (by rw [g3]; omega)
          refine ⟨eA, ψ, by omega, hψ2, fun h => by omega, htA, ?_⟩
          convert hoA using 2
          rw [g3]; omega

theorem eta_E3 (X : Forest) : Tree.node X.cols = X := by cases X; rfl

/-- The body columns of a step (body case): copies of the root forest's columns after the root. -/
theorem body_orig_E3 {A : Forest} {sd : StopData} {rd : RootData} {n k : Nat} (hL : InL A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) (hown : rd.owner = false)
    (hk1 : 1 ≤ k) (hkn : k ≤ n) (hE : E1_E3 A sd rd n k (zs_E3 A sd rd n k)) (hd : Column)
    {ρ : EntryAddr} {y : Nat × Forest}
    (hy : (Tree.node (hd :: (Hole.fill ⟨.node (((A.forestAt rd.col.path).getD Tree.empty).cols.drop
      (rd.idx + 1)), sd.depth - rd.layer⟩ sd.r (k * period sd) (zs_E3 A sd rd n k)).cols)).entryAt
        (addCol_E3 1 ρ) = some y) :
    ∃ e ψ, k ≤ ψ ∧ ψ ≤ n ∧ Tmpl_E3 A sd rd e ∧
      Orig_E3 A sd rd n ψ e y ((addCol_E3 1 ρ).col.num (sd.t + (k - 1) * period sd)) := by
  obtain ⟨hpath, hcc, hnum, hr, hle, hF, -⟩ := root_pack_E3 hL.1 hsd hrd
  obtain ⟨-, -, -, hidx, howner, -⟩ := root_facts_D3 hsd hrd
  obtain ⟨-, hRF, -⟩ := skip_data_E3 hsd hle
  have hbase : sd.t + (k - 1) * period sd = sd.r + k * period sd := by
    obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
    simp only [period, Nat.add_sub_cancel, Nat.succ_mul]
    obtain ⟨-, -, -, -, hrt, -⟩ := rootData_spec hsd hrd; omega
  have hlt : rd.idx + 1 < (skipLayers A rd.layer).cols.length := by
    have : ¬ rd.idx + 1 = (skipLayers A rd.layer).cols.length := by rw [← howner, hown]; simp
    omega
  rw [hF] at hy
  have h1 := entryAt_drop_E3 (hd :: (Hole.fill ⟨.node ((skipLayers A rd.layer).cols.drop (rd.idx + 1)),
    sd.depth - rd.layer⟩ sd.r (k * period sd) (zs_E3 A sd rd n k)).cols) 1 ρ
  rw [← h1, List.drop_one, List.tail_cons, eta_E3] at hy
  have hRG : RouteOK_D3 (sd.depth - rd.layer) (Tree.node (shift sd.r (k * period sd) (skipLayers A rd.layer)).cols) := by
    rw [eta_E3]; exact (routeOK_shift_D3 _ _ _ _).2 hRF
  have hlt' : rd.idx + 1 < (shift sd.r (k * period sd) (skipLayers A rd.layer)).cols.length := by
    rw [shift, cols_length_map_E3]; exact hlt
  have h2 : Hole.fill ⟨.node ((skipLayers A rd.layer).cols.drop (rd.idx + 1)), sd.depth - rd.layer⟩ sd.r
      (k * period sd) (zs_E3 A sd rd n k) =
      .node ((replaceAt 0 0 (zs_E3 A sd rd n k) (sd.depth - rd.layer)
        (shift sd.r (k * period sd) (skipLayers A rd.layer))).cols.drop (rd.idx + 1)) := by
    rw [Hole.fill, replaceAt_eq_shift, shift_drop_E3, eta_E3]
    have := put_drop_E3 (zs_E3 A sd rd n k) _ _ hRG _ hlt'
    rw [eta_E3] at this
    exact this
  rw [h2, entryAt_drop_E3, eta_E3] at hy
  obtain ⟨eA, ψ, hψ1, hψ2, htA, hoA⟩ := route_orig_E3 hsd hpath (i := rd.layer) hle le_rfl hE hkn hy
    (by rw [fstCol_addCol_E3]; omega)
  refine ⟨eA, ψ, hψ1, hψ2, htA, ?_⟩
  have : (addCol_E3 1 ρ).col.num (sd.t + (k - 1) * period sd) =
      (addCol_E3 (rd.idx + 1) ρ).col.num (leftCount A rd.layer + k * period sd) := by
    rw [addCol_num_E3, addCol_num_E3]; congr 1; omega
  rw [this]; exact hoA

theorem mapLast_getElem_E3 {β : Type} (f g : β → β) (U : List β) (v : Nat) (x : β)
    (h : (U.dropLast.map f ++ (U.getLast?.map g).toList)[v]? = some x) :
    ∃ u, U[v]? = some u ∧ ((v + 1 ≠ U.length ∧ x = f u) ∨ (v + 1 = U.length ∧ x = g u)) := by
  rcases List.eq_nil_or_concat U with rfl | ⟨U', u0, rfl⟩
  · simp at h
  · simp only [List.concat_eq_append, List.dropLast_concat, List.getLast?_concat, Option.map_some,
      Option.toList_some] at h ⊢
    rcases Nat.lt_or_ge v U'.length with hv | hv
    · rw [List.getElem?_append_left (by simpa using hv), List.getElem?_map] at h
      obtain ⟨u, hu, rfl⟩ := Option.map_eq_some_iff.1 h
      exact ⟨u, by rw [List.getElem?_append_left hv, hu], Or.inl ⟨by simp; omega, rfl⟩⟩
    · rw [List.getElem?_append_right (by simpa using hv)] at h
      simp only [List.length_map] at h
      rcases Nat.lt_or_ge v (U'.length + 1) with hv' | hv'
      · have : v = U'.length := by omega
        subst this
        simp at h
        exact ⟨u0, by simp, Or.inr ⟨by simp, h.symm⟩⟩
      · rw [List.getElem?_eq_none (by simp; omega)] at h; cases h

theorem entryAt_single_E3 (col : Column) (ρ : EntryAddr) (y : Nat × Forest)
    (h : (Tree.node [col]).entryAt ρ = some y) : fstCol_E3 ρ = 0 := by
  by_contra hc
  obtain ⟨ρ0, rfl⟩ := addCol_of_fstCol_E3 ρ (by omega)
  have := entryAt_drop_E3 [col] 1 ρ0
  rw [← this] at h
  simp only [List.drop_one, List.tail_cons] at h
  obtain ⟨⟨P, j⟩, i⟩ := ρ0
  cases P with
  | nil => simp [entryAt_nil_D3] at h
  | cons s P => obtain ⟨c, m⟩ := s; simp [entryAt_cons_D3] at h

/-- One step of the loop keeps the origin classification, one phase down. -/
theorem ordStep_E1_E3 {A : Forest} {sd : StopData} {rd : RootData} {n k : Nat} (hL : InL A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) (hk1 : 1 ≤ k) (hkn : k ≤ n)
    (hE : E1_E3 A sd rd n k (zs_E3 A sd rd n k)) :
    E1_E3 A sd rd n (k - 1) (ordStep sd rd ((A.forestAt rd.col.path).getD Tree.empty)
      (((A.colAt rd.col).getD []).drop rd.cursor) k (zs_E3 A sd rd n k)) := by
  intro ρ y hy
  simp only [ordStep] at hy
  split_ifs at hy with hown
  · rw [List.append_assoc] at hy
    have hρ := entryAt_single_E3 _ ρ y hy
    refine head_orig_E3 hL hsd hrd hk1 hkn hE (rest := []) ?_ hρ hy
    intro v x hx
    obtain ⟨u, hu, hx'⟩ := mapLast_getElem_E3 _ _ _ v x hx
    refine ⟨u, hu, ?_⟩
    rcases hx' with ⟨h1, rfl⟩ | ⟨h1, rfl⟩
    · exact ⟨rfl, Or.inl ⟨fun h => h1 h.2, rfl⟩⟩
    · exact ⟨rfl, Or.inr ⟨hown, h1, rfl⟩⟩
  · have hown' : rd.owner = false := by simpa using hown
    by_cases hρ : fstCol_E3 ρ = 0
    · refine head_orig_E3 hL hsd hrd hk1 hkn hE ?_ hρ hy
      intro v x hx
      rw [List.getElem?_map] at hx
      obtain ⟨u, hu, rfl⟩ := Option.map_eq_some_iff.1 hx
      exact ⟨u, hu, rfl, Or.inl ⟨by simp [hown'], rfl⟩⟩
    · obtain ⟨ρ0, rfl⟩ := addCol_of_fstCol_E3 ρ (by omega)
      obtain ⟨e, ψ, h1, h2, h3, h4⟩ := body_orig_E3 hL hsd hrd hown' hk1 hkn hE _ hy
      exact ⟨e, ψ, by omega, h2, fun h => by omega, h3, h4⟩

/-- The origin classification of every filling `zs_E3 … j`. -/
theorem zs_E1_E3 {A : Forest} {sd : StopData} {rd : RootData} {n : Nat} (hL : InL A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) :
    ∀ c, c ≤ n → E1_E3 A sd rd n (n - c) (zs_E3 A sd rd n (n - c))
  | 0, _ => by
    rw [Nat.sub_zero, zs_top_E3]
    intro ρ y hy
    obtain ⟨⟨P, j⟩, i⟩ := ρ
    cases P with
    | nil => simp [Tree.empty, entryAt_nil_D3] at hy
    | cons s P => obtain ⟨c, m⟩ := s; simp [Tree.empty, entryAt_cons_D3] at hy
  | c + 1, hc => by
    have ih := zs_E1_E3 (n := n) hL hsd hrd c (by omega)
    rw [zs_step_E3 A sd rd (n := n) (j := n - (c + 1)) (by omega),
      show n - (c + 1) + 1 = n - c by omega]
    have := ordStep_E1_E3 hL hsd hrd (n := n) (k := n - c) (by omega) (by omega) ih
    rwa [show n - c - 1 = n - (c + 1) by omega] at this

/-! Facts used by the owner-return analysis. -/

theorem kappa_zero_E3 (r d : Nat) (K : Key) : kappa r d 0 K = K := by
  have : kappaLabel r d 0 = id := by
    funext x; simp only [kappaLabel, Nat.zero_mul, Nat.add_zero, id]
    split_ifs with h
    · obtain ⟨x1, x2⟩ := x; simp only at h; rw [h.1]
    · rfl
  rw [kappa, this, treeMap_id]

/-- `κ_j h_x(H)` read as `h_{x + j d}` of the shifted height (for `x ≥ r` or `j = 0`). -/
theorem kappa_eq_E3 (r d j x : Nat) (h : j = 0 ∨ r ≤ x) (H : Forest) :
    kappa r d j (relKey x H) = relKey (x + j * d) (shift r (j * d) H) := by
  rcases h with rfl | h
  · rw [kappa_zero_E3, Nat.zero_mul, Nat.add_zero, shift_zero]
  · exact (relKey_shift r d j x h H).symm

/-- Route containers of `A`: their depth, height, number and route. -/
theorem onR_pack_E3 {A : Forest} {sd : StopData} (hsd : stopData A = some sd) {e0 : EntryAddr}
    {x0 : Nat × Forest} (hx0 : A.entryAt e0 = some x0) (hon : e0.heightPath <+: sd.col.path) :
    e0.col.path.length < sd.depth ∧ e0.heightPath = sd.col.path.take (e0.col.path.length + 1) ∧
      x0.2 = skipLayers A (e0.col.path.length + 1) ∧
      e0.col.num 0 + 1 = leftCount A (e0.col.path.length + 1) ∧
      RouteOK_D3 (sd.depth - e0.col.path.length - 1) x0.2 ∧
      e0.col.num 0 + 1 + routeNum_D3 (sd.depth - e0.col.path.length - 1) x0.2 = sd.t ∧
      routeCol_D3 (sd.depth - e0.col.path.length - 1) x0.2 = sd.Q ++ [(sd.r, Tree.empty)] ∧
      rpath_E3 sd.depth A = e0.heightPath ++ rpath_E3 (sd.depth - e0.col.path.length - 1) x0.2 ∧
      hcol_E3 sd.depth A = hcol_E3 (sd.depth - e0.col.path.length - 1) x0.2 ∧
      e0.col.num 0 < sd.t := by
  obtain ⟨-, h2, -, h4, -⟩ := stopData_core hsd
  have hlen := hon.length_le
  simp only [EntryAddr.heightPath, List.length_append, List.length_singleton] at hlen
  have hl : e0.col.path.length < sd.depth := by omega
  have hhp : e0.heightPath = sd.col.path.take (e0.col.path.length + 1) := by
    rw [List.prefix_iff_eq_take] at hon
    rw [hon]; simp [EntryAddr.heightPath]
  obtain ⟨hfa, hR, hN, hrp, hhc, hsum⟩ := skip_data_E3 hsd (i := e0.col.path.length + 1) (by omega)
  have hx : x0.2 = skipLayers A (e0.col.path.length + 1) := by
    have : A.forestAt e0.heightPath = some x0.2 := by
      rw [Tree.forestAt_heightPath, Tree.heightAt, hx0]; rfl
    rw [hhp, hfa] at this; exact (Option.some.inj this).symm
  have hnum : e0.col.num 0 + 1 = leftCount A (e0.col.path.length + 1) := by
    rw [← sum_heightPath_E3, hhp, hsum]
  have hd : sd.depth - e0.col.path.length - 1 = sd.depth - (e0.col.path.length + 1) := by omega
  rw [hd, hx]
  refine ⟨hl, hhp, rfl, hnum, hR, by omega, ?_, by rw [hhp]; exact hrp, hhc, by omega⟩
  simp only [routeCol_D3, skipLayers_add, show e0.col.path.length + 1 + (sd.depth - (e0.col.path.length + 1))
    = sd.depth by omega, h4, Option.getD_some]

/-- An entry inside the height of another has a shorter height word. -/
theorem N_inside_E3 {E : Forest} {e1 e : EntryAddr} {x1 x : Nat × Forest}
    (h1 : E.entryAt e1 = some x1) (hc : e1.heightPath <+: e.col.path) (h : E.entryAt e = some x) :
    N_E3 x.2 < N_E3 x1.2 := by
  obtain ⟨P, hP⟩ := hc
  have hfa : E.forestAt e1.heightPath = some x1.2 := by
    rw [Tree.forestAt_heightPath, Tree.heightAt, h1]; rfl
  have := entryAt_abs_E3 hfa ⟨⟨P, e.col.col⟩, e.idx⟩
  simp only [hP] at this
  rw [h] at this
  exact N_entry_lt_E3 _ _ _ this.symm

theorem len_col_snoc_E3 (e : Nat) (Q : Column) (z : Nat × Forest) {i : Nat} {y : Nat × Forest}
    (h : Q[i]? = some y) : (gwordAt (e + 1) y.2).length + 2 ≤ (gwordCol e (Q ++ [z])).length := by
  have hQ : Q ≠ [] := by rintro rfl; simp at h
  rw [gwordCol_append_E3 e hQ, List.length_append]
  have := len_col_entry_E3 e Q i y h
  obtain ⟨p, hz⟩ := z
  simp [gwordLater]; omega

/-- Heights in the query region are short against any route container. -/
theorem N_query_E3 {A : Forest} {sd : StopData} (hsd : stopData A = some sd) {e0 e : EntryAddr}
    {x0 x : Nat × Forest} (hx0 : A.entryAt e0 = some x0) (hon : e0.heightPath <+: sd.col.path)
    (hq : InQ_E3 sd e) (hx : A.entryAt e = some x) : N_E3 x.2 + 2 ≤ N_E3 x0.2 := by
  obtain ⟨-, -, -, -, hR, -, hrc, -⟩ := onR_pack_E3 hsd hx0 hon
  obtain ⟨hcol, -⟩ := stopData_spec hsd
  have hS := N_self_E3 hR
  rw [hrc] at hS
  have hstop : ∀ (i : Nat) (y : Nat × Forest), sd.Q[i]? = some y → N_E3 y.2 + 2 ≤ N_E3 x0.2 := by
    intro i y hy
    have := len_col_snoc_E3 0 sd.Q (sd.r, Tree.empty) hy
    rw [len_gwordAt_E3] at this
    have h' : N_E3 (Tree.node [sd.Q ++ [(sd.r, Tree.empty)]]) =
        (gwordCol 0 (sd.Q ++ [(sd.r, Tree.empty)])).length := by
      simp [N_E3, gwordAt, gwordCols]
    omega
  have hQe : ∀ i, i < sd.Q.length → A.entryAt ⟨sd.col, i⟩ = sd.Q[i]? := by
    intro i hi; simp only [Tree.entryAt, hcol, Option.bind_some]; rw [List.getElem?_append_left hi]
  rcases hq with ⟨h1, h2⟩ | ⟨i, hi, hc⟩
  · have : e = ⟨sd.col, e.idx⟩ := by rw [← h1]
    rw [this, hQe _ h2] at hx
    exact hstop _ _ hx
  · obtain ⟨y, hy⟩ : ∃ y, sd.Q[i]? = some y := ⟨_, List.getElem?_eq_getElem hi⟩
    have h1 := N_inside_E3 (by rw [hQe i hi]; exact hy) hc hx
    have := hstop i y hy
    omega

/-- Kept heights (outside the route and the hole) are short against the emptied route container. -/
theorem N_kept_E3 {A : Forest} {sd : StopData} (hsd : stopData A = some sd) {e0 e : EntryAddr}
    {x0 x : Nat × Forest} (hx0 : A.entryAt e0 = some x0) (hon : e0.heightPath <+: sd.col.path)
    (hnr : ¬ e.heightPath <+: sd.col.path) (hnh : ¬ InHole_E3 sd.depth A e.col)
    (hc : e0.heightPath <+: e.col.path) (hx : A.entryAt e = some x) :
    N_E3 x.2 < N_E3 (replaceAt 0 0 Tree.empty (sd.depth - e0.col.path.length - 1) x0.2) := by
  obtain ⟨hrp, -⟩ := stop_rpath_E3 hsd
  obtain ⟨hRA, -⟩ := stop_route_top_D3 hsd
  have hP := put_entryAt_E3 Tree.empty sd.depth A hRA
  have he : (replaceAt 0 0 Tree.empty sd.depth A).entryAt e = some x := by
    rw [(hP e).2.2 hnh (by rw [IsRoute_E3, hrp]; exact hnr), hx]
  have he0 : (replaceAt 0 0 Tree.empty sd.depth A).entryAt e0 =
      some (x0.1, replaceAt 0 0 Tree.empty (sd.depth - e0.col.path.length - 1) x0.2) := by
    rw [(hP e0).2.1 (by rw [InHole_E3, hrp]; exact route_not_hole_E3 hon)
      (by rw [IsRoute_E3, hrp]; exact hon), hx0]; rfl
  exact N_inside_E3 he0 hc he

/-- The shape of a step of the loop: the shifted query, then restored entries below `r`. -/
theorem ordStep_shape_E3 {A : Forest} {sd : StopData} {rd : RootData} (hL : InL A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) (k : Nat) (Z : Forest) :
    ∃ V rest, ordStep sd rd ((A.forestAt rd.col.path).getD Tree.empty)
      (((A.colAt rd.col).getD []).drop rd.cursor) (k + 1) Z =
        .node ((Tree.mapCol (shiftVal sd.r (k * period sd)) sd.Q ++ V) :: rest) ∧
      ∀ v ∈ V.head?, v.1 < sd.r := by
  obtain ⟨-, -, -, -, -, -, hUe, -⟩ := root_pack_E3 hL.1 hsd hrd
  have hU0 : ∀ u ∈ (((A.colAt rd.col).getD []).drop rd.cursor).head?, u.1 < sd.r := by
    intro u hu
    exact (hUe 0 u (by rw [List.head?_eq_getElem?] at hu; exact hu)).2.1
  simp only [ordStep, Nat.add_sub_cancel]
  split_ifs
  · refine ⟨_, [], by rw [List.append_assoc]; rfl, ?_⟩
    intro v hv
    rw [List.head?_eq_getElem?] at hv
    obtain ⟨u, hu, hx⟩ := mapLast_getElem_E3 _ _ _ 0 v hv
    rcases hx with ⟨-, rfl⟩ | ⟨-, rfl⟩ <;>
      exact hU0 u (by rw [List.head?_eq_getElem?]; exact hu)
  · refine ⟨_, _, rfl, ?_⟩
    intro v hv
    rw [List.head?_map] at hv
    obtain ⟨u, hu, rfl⟩ := Option.map_eq_some_iff.1 hv
    exact hU0 u hu

/-! The conclusion of T3.2m for one pair of heights. -/

/-- The conclusion of `ownerReturn_origin` for an old pair `(a, H), (c, J)` at phase `j` and a new
pair `(a', H'), (c', J')`. -/
def Concl_E3 (sd : StopData) (j a c : Nat) (H J : Forest) (a' c' : Nat) (H' J' : Forest) : Prop :=
  let kJ := keyWord (kappa sd.r (period sd) j (relKey c J))
  let kH := keyWord (kappa sd.r (period sd) j (relKey a H))
  let kJ' := keyWord (relKey c' J')
  let kH' := keyWord (relKey a' H')
  (kH' = kH ∨ ∃ b, kH'.take b = kH.take b ∧ b ≤ kH'.length ∧ kH' ≤ kH ∧
    (kJ' = kJ ∧ kJ.length < b ∨ ∃ a, a < b ∧ FirstDec kJ kJ' a)) ∧ (kH' = kH → kJ' = kJ)

theorem concl_eq_E3 {sd : StopData} {j a c : Nat} {H J : Forest} {a' c' : Nat} {H' J' : Forest}
    (hH : keyWord (relKey a' H') = keyWord (kappa sd.r (period sd) j (relKey a H)))
    (hJ : keyWord (relKey c' J') = keyWord (kappa sd.r (period sd) j (relKey c J))) :
    Concl_E3 sd j a c H J a' c' H' J' :=
  ⟨Or.inl hH, fun _ => hJ⟩

theorem concl_dec_E3 {sd : StopData} {j a c : Nat} {H J : Forest} {a' c' : Nat} {H' J' : Forest}
    {b : Nat} (hH : FirstDec (keyWord (kappa sd.r (period sd) j (relKey a H))) (keyWord (relKey a' H')) b)
    (hJ : (keyWord (relKey c' J') = keyWord (kappa sd.r (period sd) j (relKey c J)) ∧
        (keyWord (kappa sd.r (period sd) j (relKey c J))).length < b) ∨
      ∃ a0, a0 < b ∧ FirstDec (keyWord (kappa sd.r (period sd) j (relKey c J))) (keyWord (relKey c' J')) a0) :
    Concl_E3 sd j a c H J a' c' H' J' := by
  have hlt := lt_of_firstDec_E3 hH
  exact ⟨Or.inr ⟨b, hH.1, hH.2.1, le_of_lt hlt, hJ⟩, fun h => absurd h (ne_of_lt hlt)⟩

/-- A new pair of heights with an old owner return of `A` as origin. -/
def Good_E3 (A : Forest) (sd : StopData) (a' : Nat) (H' : Forest) (c' : Nat) (J' : Forest) : Prop :=
  ∃ e0 e j x0 x, A.entryAt e0 = some x0 ∧ A.entryAt e = some x ∧ IsOwnerReturn A e0 e ∧
    Concl_E3 sd j (e0.col.num 0) (e.col.num 0) x0.2 x.2 a' c' H' J'

/-- Every return to the host `a'` inside the height `H'` has an origin. -/
def HostGood_E3 (A : Forest) (sd : StopData) (a' : Nat) (H' : Forest) : Prop :=
  ∀ ρ J', H'.entryAt ρ = some (a', J') → Good_E3 A sd a' H' (ρ.col.num (a' + 1)) J'

/-- The absolute address of an entry read inside the height of `e0`. -/
def under_E3 (e0 ρ : EntryAddr) : EntryAddr := ⟨⟨e0.heightPath ++ ρ.col.path, ρ.col.col⟩, ρ.idx⟩

theorem under_entryAt_E3 {E : Forest} {e0 : EntryAddr} {x0 : Nat × Forest}
    (h : E.entryAt e0 = some x0) (ρ : EntryAddr) : E.entryAt (under_E3 e0 ρ) = x0.2.entryAt ρ := by
  have hfa : E.forestAt e0.heightPath = some x0.2 := by
    rw [Tree.forestAt_heightPath, Tree.heightAt, h]; rfl
  exact entryAt_abs_E3 hfa ρ

theorem under_num_E3 (e0 ρ : EntryAddr) :
    (under_E3 e0 ρ).col.num 0 = ρ.col.num (e0.col.num 0 + 1) := by
  rw [under_E3, num_abs_E3, sum_heightPath_E3]

theorem under_return_E3 {E : Forest} {e0 : EntryAddr} {x0 : Nat × Forest}
    (h : E.entryAt e0 = some x0) {ρ : EntryAddr} {J : Forest}
    (hρ : x0.2.entryAt ρ = some (e0.col.num 0, J)) :
    E.entryAt (under_E3 e0 ρ) = some (e0.col.num 0, J) ∧ IsOwnerReturn E e0 (under_E3 e0 ρ) := by
  have h1 : E.entryAt (under_E3 e0 ρ) = some (e0.col.num 0, J) := by
    rw [under_entryAt_E3 h, hρ]
  exact ⟨h1, isOwnerReturn_of_parent (List.prefix_append _ _) h1⟩

theorem shiftVal_host_E3 {r δ a p : Nat} (h : δ = 0 ∨ r ≤ a) (hp : shiftVal r δ p = a + δ) : p = a := by
  unfold shiftVal at hp; split_ifs at hp <;> omega

/-- Pure copies of hosts: returns are copies of old returns, at the same phase. -/
theorem hostS_E3 {A : Forest} (sd : StopData) {e0 : EntryAddr} {x0 : Nat × Forest}
    (hx0 : A.entryAt e0 = some x0) (ψ : Nat) (hψ : ψ = 0 ∨ sd.r ≤ e0.col.num 0) :
    HostGood_E3 A sd (e0.col.num 0 + ψ * period sd) (shift sd.r (ψ * period sd) x0.2) := by
  intro ρ J' hρ
  rw [shift, entryAt_map_D3] at hρ
  obtain ⟨x, hx, hxe⟩ := Option.map_eq_some_iff.1 hρ
  simp only [Prod.mk.injEq] at hxe
  obtain ⟨hp, rfl⟩ := hxe
  have hδ : ψ * period sd = 0 ∨ sd.r ≤ e0.col.num 0 := by
    rcases hψ with h | h
    · left; rw [h, Nat.zero_mul]
    · exact Or.inr h
  have hp' : x.1 = e0.col.num 0 := shiftVal_host_E3 hδ hp
  have hx' : x0.2.entryAt ρ = some (e0.col.num 0, x.2) := by rw [hx, ← hp']
  obtain ⟨h1, h2⟩ := under_return_E3 hx0 hx'
  have hψ' : ψ = 0 ∨ sd.r ≤ (under_E3 e0 ρ).col.num 0 := by
    rcases hψ with h | h
    · exact Or.inl h
    · right; rw [under_num_E3]; have := num_ge_E3 (e0.col.num 0 + 1) ρ.col; omega
  refine ⟨e0, under_E3 e0 ρ, ψ, x0, (e0.col.num 0, x.2), hx0, h1, h2, concl_eq_E3 ?_ ?_⟩
  · rw [kappa_eq_E3 _ _ _ _ hψ]
  · rw [kappa_eq_E3 _ _ _ _ hψ', under_num_E3, ← num_add_D3 (e0.col.num 0 + 1) (ψ * period sd) ρ.col,
      show e0.col.num 0 + ψ * period sd + 1 = e0.col.num 0 + 1 + ψ * period sd by omega]
    rfl

/-! Type C hosts: route containers, in the context or copied into a layer. -/

theorem inHole_map_E3 (f : Nat → Nat) (k : Nat) (F : Forest) (c : ColAddr) :
    InHole_E3 k (Tree.map f F) c ↔ InHole_E3 k F c := by
  simp only [InHole_E3, rpath_map_E3, hcol_map_E3]

theorem isRoute_map_E3 (f : Nat → Nat) (k : Nat) (F : Forest) (e : EntryAddr) :
    IsRoute_E3 k (Tree.map f F) e ↔ IsRoute_E3 k F e := by
  simp only [IsRoute_E3, rpath_map_E3]

/-- A route container numbered below `r` lies above the root column. -/
theorem low_route_E3 {A : Forest} {sd : StopData} {rd : RootData} (hV : CondV A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) {e0 : EntryAddr} {x0 : Nat × Forest}
    (hx0 : A.entryAt e0 = some x0) (hon : e0.heightPath <+: sd.col.path) (ha : e0.col.num 0 < sd.r) :
    e0.heightPath <+: rd.col.path := by
  obtain ⟨-, hhp, -, hnum, -⟩ := onR_pack_E3 hsd hx0 hon
  obtain ⟨hpath, -, -, hr, -⟩ := root_pack_E3 hV hsd hrd
  obtain ⟨-, -, -, hidx, -⟩ := root_facts_D3 hsd hrd
  rw [hhp, hpath]
  by_cases h : e0.col.path.length + 1 ≤ rd.layer
  · exact List.take_prefix_take_left h
  · exfalso
    have h1 := leftCount_mono_D3 A (show rd.layer + 1 ≤ e0.col.path.length + 1 by omega)
    rw [leftCount_succ_D3] at h1
    omega

/-- Route containers end with the stopping column. -/
theorem route_N_E3 {A : Forest} {sd : StopData} (hsd : stopData A = some sd) {e : EntryAddr}
    {x : Nat × Forest} (hx : A.entryAt e = some x) (hon : e.heightPath <+: sd.col.path) :
    N_E3 x.2 = N_E3 (replaceAt 0 0 Tree.empty (sd.depth - e.col.path.length - 1) x.2) +
      N_E3 (.node [sd.Q ++ [(sd.r, Tree.empty)]]) ∧
      1 ≤ N_E3 (.node [sd.Q ++ [(sd.r, Tree.empty)]]) := by
  obtain ⟨-, -, -, -, hR, -, hrc, -⟩ := onR_pack_E3 hsd hx hon
  have := N_self_E3 hR
  rw [hrc] at this
  exact ⟨this, N_col_pos_E3 _⟩

/-- The first decrease of a copied route container against its shifted old height. -/
theorem routeFD_E3 {A : Forest} {sd : StopData} {rd : RootData} {n : Nat} (hL : InL A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) {e : EntryAddr} {x : Nat × Forest}
    (hx : A.entryAt e = some x) (hon : e.heightPath <+: sd.col.path) {ψ : Nat} (hψ : ψ ≤ n) :
    FirstDec (gwordAt 0 (shift sd.r (ψ * period sd) x.2))
      (gwordAt 0 (replaceAt sd.r (ψ * period sd) (zs_E3 A sd rd n ψ) (sd.depth - e.col.path.length - 1) x.2))
      (if ψ < n then N_E3 x.2 - 1 else N_E3 x.2 - N_E3 (.node [sd.Q ++ [(sd.r, Tree.empty)]])) := by
  obtain ⟨-, -, -, -, hR, -, hrc, -⟩ := onR_pack_E3 hsd hx hon
  split_ifs with h
  · rw [zs_step_E3 A sd rd h]
    obtain ⟨V, rest, hsh, hV⟩ := ordStep_shape_E3 hL hsd hrd ψ (zs_E3 A sd rd n (ψ + 1))
    rw [hsh]
    exact fill_firstDec_head_E3 hR hrc le_rfl hV 0
  · rw [show ψ = n by omega, zs_top_E3]
    have := fill_firstDec_empty_E3 hR sd.r (n * period sd) 0
    rwa [hrc] at this

theorem empty_entryAt_E3 (e : EntryAddr) : (Tree.node [] : Forest).entryAt e = none := by
  obtain ⟨⟨P, j⟩, i⟩ := e
  cases P with
  | nil => simp [entryAt_nil_D3]
  | cons s P => obtain ⟨c, m⟩ := s; simp [entryAt_cons_D3]

theorem period_pos_E3 {A : Forest} {sd : StopData} {rd : RootData} (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) : 0 < period sd := by
  obtain ⟨-, -, -, -, hrt, -⟩ := rootData_spec hsd hrd
  simp only [period]; omega

/-- Route containers of phase `k` (the context ones for `k = 0`): every return has an origin;
the host height decreases first at the old closing entry (`k < n`) or at the old stopping column
(`k = n`), and the lower height is unchanged before that position or decreases earlier. -/
theorem hostC_E3 {A : Forest} {sd : StopData} {rd : RootData} {n : Nat} (hL : InL A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) {e0 : EntryAddr} {x0 : Nat × Forest}
    (hx0 : A.entryAt e0 = some x0) (hon : e0.heightPath <+: sd.col.path) {k : Nat} (hkn : k ≤ n)
    (hk : k = 0 ∨ sd.r ≤ e0.col.num 0) :
    HostGood_E3 A sd (e0.col.num 0 + k * period sd)
      (replaceAt sd.r (k * period sd) (zs_E3 A sd rd n k) (sd.depth - e0.col.path.length - 1) x0.2) := by
  have hE : E1_E3 A sd rd n k (zs_E3 A sd rd n k) := by
    have := zs_E1_E3 (n := n) hL hsd hrd (n - k) (by omega)
    rwa [show n - (n - k) = k by omega] at this
  have hd := period_pos_E3 hsd hrd
  obtain ⟨hl, hhp, hxH, hnum, hR, hN, hrc, hrp, hhc, hat⟩ := onR_pack_E3 hsd hx0 hon
  obtain ⟨hrpA, hhcA⟩ := stop_rpath_E3 hsd
  obtain ⟨hNH, hS⟩ := route_N_E3 hsd hx0 hon
  have hδ : k * period sd = 0 ∨ sd.r ≤ e0.col.num 0 := by
    rcases hk with h | h
    · left; rw [h, Nat.zero_mul]
    · exact Or.inr h
  -- the host's key words
  have hkH : ∀ j, (j = k ∨ (k = 0 ∧ e0.col.num 0 ≤ sd.r)) →
      keyWord (kappa sd.r (period sd) j (relKey (e0.col.num 0) x0.2)) =
        keyWord (relKey (e0.col.num 0 + k * period sd) (shift sd.r (k * period sd) x0.2)) := by
    rintro j (rfl | ⟨rfl, h⟩)
    · rw [kappa_eq_E3 _ _ _ _ hk]
    · rw [kappa_fix _ _ _ _ h, Nat.zero_mul, Nat.add_zero, shift_zero]
  set bH := if k < n then N_E3 x0.2 - 1 else N_E3 x0.2 - N_E3 (.node [sd.Q ++ [(sd.r, Tree.empty)]])
    with hbH
  have hFH : FirstDec (keyWord (relKey (e0.col.num 0 + k * period sd) (shift sd.r (k * period sd) x0.2)))
      (keyWord (relKey (e0.col.num 0 + k * period sd) (replaceAt sd.r (k * period sd)
        (zs_E3 A sd rd n k) (sd.depth - e0.col.path.length - 1) x0.2))) bH :=
    firstDec_keyWord_E3 _ (routeFD_E3 hL hsd hrd hx0 hon hkn)
  have hRG := (routeOK_shift_D3 sd.r (k * period sd) _ _).2 hR
  intro ρ J' hρ
  rw [replaceAt_eq_shift] at hρ
  have hP := put_entryAt_E3 (zs_E3 A sd rd n k) _ _ hRG ρ
  by_cases hh : InHole_E3 (sd.depth - e0.col.path.length - 1) (shift sd.r (k * period sd) x0.2) ρ.col
  · -- returns from the filling: the query region of the next head, or low parents
    obtain ⟨h1, h2⟩ := hP.1 hh
    rw [h1] at hρ
    obtain ⟨e, ψ, hψ1, hψ2, hψq, ⟨htr, htn, htl⟩, x, hxA, hx1, hc', hx2⟩ := hE _ _ hρ
    have hkn' : k < n := by
      by_contra hc
      rw [show k = n by omega, zs_top_E3, Tree.empty, empty_entryAt_E3] at hρ
      cases hρ
    simp only at hx1
    have hcase : x.1 = e0.col.num 0 ∧ ((k = 0 ∧ e0.col.num 0 < sd.r) ∨ (ψ = k ∧ InQ_E3 sd e)) := by
      unfold shiftVal at hx1
      split_ifs at hx1 with hxr
      · by_cases hψk : ψ = k
        · subst hψk; exact ⟨by omega, Or.inr ⟨rfl, hψq rfl⟩⟩
        · exfalso
          have : (k + 1) * period sd ≤ ψ * period sd := Nat.mul_le_mul_right _ (by omega)
          have : sd.t = sd.r + period sd := by simp only [period]; omega
          rw [Nat.succ_mul] at *
          omega
      · have hk0 : k = 0 := by
          rcases hk with h | h
          · exact h
          · exfalso; omega
        subst hk0
        exact ⟨by omega, Or.inl ⟨rfl, by omega⟩⟩
    obtain ⟨hxa, hcase⟩ := hcase
    have hcon : e0.Contains e.col := by
      rcases hcase with ⟨-, hlow⟩ | ⟨-, hq⟩
      · exact (low_route_E3 hL.1 hsd hrd hx0 hon hlow).trans htr
      · rcases hq with ⟨h1, -⟩ | ⟨i, -, hi⟩
        · show e0.heightPath <+: e.col.path; rw [h1]; exact hon
        · exact hon.trans ((List.prefix_append _ _).trans hi)
    have hret : IsOwnerReturn A e0 e := by
      have : A.entryAt ⟨e.col, e.idx⟩ = some (e0.col.num 0, x.2) := by rw [← hxa]; exact hxA
      exact isOwnerReturn_of_parent hcon this
    refine ⟨e0, e, ψ, x0, x, hx0, hxA, hret, ?_⟩
    have hkH' := hkH ψ (by
      rcases hcase with ⟨h1, h2⟩ | ⟨h1, -⟩
      · exact Or.inr ⟨h1, le_of_lt h2⟩
      · exact Or.inl h1)
    have hnumρ : ρ.col.num (e0.col.num 0 + k * period sd + 1) = e.col.num 0 + ψ * period sd := by
      rw [h2, routeNum_shift_D3, show e0.col.num 0 + k * period sd + 1 +
        routeNum_D3 (sd.depth - e0.col.path.length - 1) x0.2 = sd.t + k * period sd by omega]
      exact hc'
    have hbH : bH = N_E3 x0.2 - 1 := by rw [hbH, if_pos hkn']
    refine concl_dec_E3 (b := bH) (by rw [hkH']; exact hFH) ?_
    rw [hnumρ, kappa_eq_E3 _ _ _ _ (Or.inr htn)]
    rcases hx2 with ⟨hnr, hJ'⟩ | ⟨hon', hJ'⟩ <;> simp only at hJ'
    · left
      refine ⟨by rw [hJ'], ?_⟩
      rw [len_keyWord_E3, N_shift_E3, hbH]
      by_cases hq : InQ_E3 sd e
      · have := N_query_E3 hsd hx0 hon hq hxA; omega
      · have hnh := htl.resolve_left hq
        have := N_kept_E3 hsd hx0 hon hnr hnh hcon hxA
        omega
    · right
      have hfd := firstDec_keyWord_E3 (e.col.num 0 + ψ * period sd) (routeFD_E3 hL hsd hrd hxA hon' hψ2)
      rw [← hJ'] at hfd
      refine ⟨_, ?_, hfd⟩
      have hlt := N_inside_E3 hx0 hcon hxA
      obtain ⟨hNx, hSx⟩ := route_N_E3 hsd hxA hon'
      rw [hbH]
      split_ifs <;> omega
  · have hgen : ∀ x, x0.2.entryAt ρ = some x →
        shiftVal sd.r (k * period sd) x.1 = e0.col.num 0 + k * period sd →
        x.1 = e0.col.num 0 ∧ A.entryAt (under_E3 e0 ρ) = some (e0.col.num 0, x.2) ∧
          IsOwnerReturn A e0 (under_E3 e0 ρ) ∧ (k = 0 ∨ sd.r ≤ (under_E3 e0 ρ).col.num 0) ∧
          ρ.col.num (e0.col.num 0 + k * period sd + 1) = (under_E3 e0 ρ).col.num 0 + k * period sd := by
      intro x hx hp
      have hxa : x.1 = e0.col.num 0 := shiftVal_host_E3 hδ hp
      have hx' : x0.2.entryAt ρ = some (e0.col.num 0, x.2) := by rw [hx, ← hxa]
      obtain ⟨h1, h2⟩ := under_return_E3 hx0 hx'
      refine ⟨hxa, h1, h2, ?_, ?_⟩
      · rcases hk with h | h
        · exact Or.inl h
        · right; rw [under_num_E3]; have := num_ge_E3 (e0.col.num 0 + 1) ρ.col; omega
      · rw [under_num_E3, ← num_add_D3 (e0.col.num 0 + 1) (k * period sd) ρ.col]; congr 1; omega
    by_cases hr : IsRoute_E3 (sd.depth - e0.col.path.length - 1) (shift sd.r (k * period sd) x0.2) ρ
    · -- route containers inside the host: both heights change, the lower one first
      rw [hP.2.1 hh hr, shift, entryAt_map_D3, Option.map_map] at hρ
      obtain ⟨x, hx, hxe⟩ := Option.map_eq_some_iff.1 hρ
      simp only [Function.comp, Prod.mk.injEq] at hxe
      obtain ⟨hp, hJ'⟩ := hxe
      obtain ⟨hxa, h1, h2, hk', hnumρ⟩ := hgen x hx hp
      refine ⟨e0, under_E3 e0 ρ, k, x0, (e0.col.num 0, x.2), hx0, h1, h2, ?_⟩
      have hon' : (under_E3 e0 ρ).heightPath <+: sd.col.path := by
        have := (isRoute_abs_E3 hrp ρ).2 ((isRoute_map_E3 _ _ _ _).1 hr)
        rwa [IsRoute_E3, hrpA] at this
      have hlen : (under_E3 e0 ρ).col.path.length = e0.col.path.length + 1 + ρ.col.path.length := by
        simp [under_E3, EntryAddr.heightPath]; omega
      have hfd := firstDec_keyWord_E3 ((under_E3 e0 ρ).col.num 0 + k * period sd)
        (routeFD_E3 hL hsd hrd h1 hon' hkn)
      have hJ'' : replaceAt sd.r (k * period sd) (zs_E3 A sd rd n k)
          (sd.depth - (under_E3 e0 ρ).col.path.length - 1) x.2 = J' := by
        rw [← hJ', hlen, replaceAt_eq_shift]
        congr 1; omega
      simp only at hfd
      rw [hJ''] at hfd
      refine concl_dec_E3 (b := bH) (by rw [hkH k (Or.inl rfl)]; exact hFH) ?_
      rw [hnumρ, kappa_eq_E3 _ _ _ _ hk']
      refine Or.inr ⟨_, ?_, hfd⟩
      have hlt := N_entry_lt_E3 _ _ _ hx
      obtain ⟨hNx, hSx⟩ := route_N_E3 hsd h1 hon'
      rw [hbH]
      split_ifs <;> simp only at hlt hNx <;> omega
    · -- kept entries: pure copies, ending before the host's first change
      rw [hP.2.2 hh hr, shift, entryAt_map_D3] at hρ
      obtain ⟨x, hx, hxe⟩ := Option.map_eq_some_iff.1 hρ
      simp only [Prod.mk.injEq] at hxe
      obtain ⟨hp, hJ'⟩ := hxe
      obtain ⟨hxa, h1, h2, hk', hnumρ⟩ := hgen x hx hp
      refine ⟨e0, under_E3 e0 ρ, k, x0, (e0.col.num 0, x.2), hx0, h1, h2, ?_⟩
      have hC : (replaceAt 0 0 Tree.empty (sd.depth - e0.col.path.length - 1) x0.2).entryAt ρ = some x := by
        rw [(put_entryAt_E3 Tree.empty _ _ hR ρ).2.2 ((inHole_map_E3 _ _ _ _).not.1 hh)
          ((isRoute_map_E3 _ _ _ _).not.1 hr), hx]
      have hlt := N_entry_lt_E3 _ _ _ hC
      refine concl_dec_E3 (b := bH) (by rw [hkH k (Or.inl rfl)]; exact hFH) ?_
      rw [hnumρ, kappa_eq_E3 _ _ _ _ hk']
      refine Or.inl ⟨by rw [← hJ']; rfl, ?_⟩
      rw [len_keyWord_E3, N_shift_E3, hbH]
      simp only at hlt ⊢
      split_ifs <;> omega

theorem replaceAt_zero_E3 (r : Nat) (Z : Forest) (k : Nat) (F : Forest) :
    replaceAt r 0 Z k F = replaceAt 0 0 Z k F := by
  rw [replaceAt_eq_shift, shift_zero]

/-- Every host of an ordinary output has origins for all its returns. -/
theorem hosts_E3 {A : Forest} {sd : StopData} {rd : RootData} {n : Nat} (hL : InL A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) {e0' : EntryAddr} {y0 : Nat × Forest}
    (hy0 : (replaceAt 0 0 (zs_E3 A sd rd n 0) sd.depth A).entryAt e0' = some y0) :
    HostGood_E3 A sd (e0'.col.num 0) y0.2 := by
  obtain ⟨hrpA, hhcA⟩ := stop_rpath_E3 hsd
  obtain ⟨hRA, hNA⟩ := stop_route_top_D3 hsd
  have hP := put_entryAt_E3 (zs_E3 A sd rd n 0) sd.depth A hRA e0'
  by_cases hh : InHole_E3 sd.depth A e0'.col
  · obtain ⟨h1, h2⟩ := hP.1 hh
    rw [h1] at hy0
    have hE := zs_E1_E3 (n := n) hL hsd hrd n le_rfl
    rw [Nat.sub_self] at hE
    obtain ⟨e, ψ, -, hψ2, -, ⟨-, htn, -⟩, x, hxA, -, hc', hx2⟩ := hE _ _ hy0
    have hnum : e0'.col.num 0 = e.col.num 0 + ψ * period sd := by
      rw [h2 0, Nat.zero_add, hNA, ← hc', Nat.zero_mul, Nat.add_zero]
    rw [hnum]
    rcases hx2 with ⟨-, hJ⟩ | ⟨hon, hJ⟩
    · rw [hJ]; exact hostS_E3 sd hxA ψ (Or.inr htn)
    · rw [hJ]; exact hostC_E3 hL hsd hrd hxA hon hψ2 (Or.inr htn)
  · by_cases hr : IsRoute_E3 sd.depth A e0'
    · rw [hP.2.1 hh hr] at hy0
      obtain ⟨x, hx, rfl⟩ := Option.map_eq_some_iff.1 hy0
      have hon : e0'.heightPath <+: sd.col.path := by rw [IsRoute_E3, hrpA] at hr; exact hr
      have := hostC_E3 (n := n) hL hsd hrd hx hon (Nat.zero_le n) (Or.inl rfl)
      rw [Nat.zero_mul, Nat.add_zero, replaceAt_zero_E3] at this
      exact this
    · rw [hP.2.2 hh hr] at hy0
      have := hostS_E3 sd hy0 0 (Or.inl rfl)
      rw [Nat.zero_mul, Nat.add_zero, shift_zero] at this
      exact this

/-- Entry-level classification of an ordinary output `B = A[n]` (reusable form of T3.2i at the
level of entries): every entry of `B` is an unchanged context entry, a context route container
whose height is filled with the layers, or (in the hole) a phase-`ψ` copy of a template entry of
`A` (`Orig_E3`: parent and number shifted by `ψ d`, height shifted, or filled for route
containers). -/
theorem ord_entry_origin_E3 {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .ordinary)
    (hB : expand A n = some B) {sd : StopData} {rd : RootData} (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) {e' : EntryAddr} {y : Nat × Forest} (hy : B.entryAt e' = some y) :
    (¬ InHole_E3 sd.depth A e'.col ∧ ¬ e'.heightPath <+: sd.col.path ∧ A.entryAt e' = some y) ∨
    (e'.heightPath <+: sd.col.path ∧ ∃ x, A.entryAt e' = some x ∧
      y = (x.1, replaceAt 0 0 (zs_E3 A sd rd n 0) (sd.depth - e'.col.path.length - 1) x.2)) ∨
    (InHole_E3 sd.depth A e'.col ∧ ∃ e ψ, ψ ≤ n ∧ Tmpl_E3 A sd rd e ∧
      Orig_E3 A sd rd n ψ e y (e'.col.num 0)) := by
  obtain ⟨sd', rd', hsd', hrd', hBeq, -⟩ := ord_output_D3 hL hk hB
  rw [hsd] at hsd'; cases hsd'
  rw [hrd] at hrd'; cases hrd'
  rw [ordZ_eq_zs_E3] at hBeq
  subst hBeq
  obtain ⟨hrpA, -⟩ := stop_rpath_E3 hsd
  obtain ⟨hRA, hNA⟩ := stop_route_top_D3 hsd
  have hPu := put_entryAt_E3 (zs_E3 A sd rd n 0) sd.depth A hRA e'
  by_cases hh : InHole_E3 sd.depth A e'.col
  · right; right
    obtain ⟨h1, h2⟩ := hPu.1 hh
    rw [h1] at hy
    have hE := zs_E1_E3 (n := n) hL hsd hrd n le_rfl
    rw [Nat.sub_self] at hE
    obtain ⟨e, ψ, -, hψ2, -, ht, ho⟩ := hE _ _ hy
    refine ⟨hh, e, ψ, hψ2, ht, ?_⟩
    rw [h2 0, Nat.zero_add, hNA]
    simpa using ho
  · by_cases hr : IsRoute_E3 sd.depth A e'
    · right; left
      rw [hPu.2.1 hh hr] at hy
      obtain ⟨x, hx, rfl⟩ := Option.map_eq_some_iff.1 hy
      exact ⟨by rw [IsRoute_E3, hrpA] at hr; exact hr, x, hx, rfl⟩
    · left
      rw [hPu.2.2 hh hr] at hy
      exact ⟨hh, by rw [IsRoute_E3, hrpA] at hr; exact hr, hy⟩

-- T3.2m (txt:350-362): every owner return of an ordinary output has an old origin; the key
-- words of both heights are the phase images of the old ones, changed only by decreases whose
-- first changes respect the containment offset (or the lower height is unchanged and ends
-- before the upper change)
theorem ownerReturn_origin {A B : Forest} {sd : StopData} {rd : RootData} {n : Nat} (hL : InL A)
    (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd) (hrd : rootData A = some rd)
    (hB : expand A n = some B) {e0' e' : EntryAddr} (he0 : e0' ∈ B.entryAddrs)
    (he : e' ∈ B.entryAddrs) (hret : IsOwnerReturn B e0' e') :
    ∃ e0 e j, e0 ∈ A.entryAddrs ∧ e ∈ A.entryAddrs ∧ IsOwnerReturn A e0 e ∧
      let J := (A.heightAt e).getD Tree.empty
      let H := (A.heightAt e0).getD Tree.empty
      let J' := (B.heightAt e').getD Tree.empty
      let H' := (B.heightAt e0').getD Tree.empty
      let kJ := keyWord (kappa sd.r (period sd) j (relKey (e.col.num 0) J))
      let kH := keyWord (kappa sd.r (period sd) j (relKey (e0.col.num 0) H))
      let kJ' := keyWord (relKey (e'.col.num 0) J')
      let kH' := keyWord (relKey (e0'.col.num 0) H')
      (kH' = kH ∨ ∃ b, kH'.take b = kH.take b ∧ b ≤ kH'.length ∧ kH' ≤ kH ∧
        (kJ' = kJ ∧ kJ.length < b ∨ ∃ a, a < b ∧ FirstDec kJ kJ' a)) ∧
      (kH' = kH → kJ' = kJ) := by
  obtain ⟨sd', rd', hsd', hrd', hBeq, -⟩ := ord_output_D3 hL hk hB
  rw [hsd] at hsd'; cases hsd'
  rw [hrd] at hrd'; cases hrd'
  rw [ordZ_eq_zs_E3] at hBeq
  obtain ⟨y0, hy0⟩ := Option.isSome_iff_exists.1 ((Tree.mem_entryAddrs_iff B e0').1 he0)
  obtain ⟨hcon, q, J', hJ, hres⟩ := hret
  have hq : q = e0'.col.num 0 := (ColAddr.resolve_num hres).symm
  subst hq
  obtain ⟨P, hP⟩ := hcon
  have he' : e' = under_E3 e0' ⟨⟨P, e'.col.col⟩, e'.idx⟩ := by
    simp only [under_E3, hP]
  have hρ : y0.2.entryAt ⟨⟨P, e'.col.col⟩, e'.idx⟩ = some (e0'.col.num 0, J') := by
    rw [← under_entryAt_E3 hy0, ← he', hJ]
  have hG := hosts_E3 (n := n) hL hsd hrd (by rw [← hBeq]; exact hy0) _ _ hρ
  rw [← under_num_E3, ← he'] at hG
  obtain ⟨e0, e, j, x0, x, hx0, hx, hret', hC⟩ := hG
  refine ⟨e0, e, j, (Tree.mem_entryAddrs_iff A e0).2 (by rw [hx0]; rfl),
    (Tree.mem_entryAddrs_iff A e).2 (by rw [hx]; rfl), hret', ?_⟩
  have h1 : (A.heightAt e).getD Tree.empty = x.2 := by simp [Tree.heightAt, hx]
  have h2 : (A.heightAt e0).getD Tree.empty = x0.2 := by simp [Tree.heightAt, hx0]
  have h3 : (B.heightAt e').getD Tree.empty = J' := by simp [Tree.heightAt, hJ]
  have h4 : (B.heightAt e0').getD Tree.empty = y0.2 := by simp [Tree.heightAt, hy0]
  simp only [h1, h2, h3, h4]
  exact hC

/-- T3.2n helper (branch D3): key-word order is key order. -/
theorem keyWord_lt_iff_D3 (K K' : Key) : keyWord K < keyWord K' ↔ K < K' := by
  unfold keyWord
  rw [← gword, ← gword, gword_lt_iff,
    Tree.cmp_map (c := keyLabelCmp) (fun x y => (keyLabelCmp_eq x y).symm)]
  rfl

-- T3.2n (txt:363-366): ordinary outputs satisfy S (no output A is used)
theorem condS_ord {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .ordinary)
    (hB : expand A n = some B) : CondS B := by
  obtain ⟨sd, hsd⟩ := Option.isSome_iff_exists.mp (stopData_of_stepKind hk (by decide))
  obtain ⟨rd, hrd⟩ := Option.isSome_iff_exists.mp (rootData_of_ordinary hk)
  intro e0' he0 e' he hret
  obtain ⟨e0, e, j, he0A, heA, hretA, hpos, heq⟩ :=
    ownerReturn_origin hL hk hsd hrd hB he0 he hret
  have hSA := hL.2.2.2.2 e0 he0A e heA hretA
  have hlt : keyWord (kappa sd.r (period sd) j (relKey (e.col.num 0) ((A.heightAt e).getD Tree.empty))) <
      keyWord (kappa sd.r (period sd) j (relKey (e0.col.num 0) ((A.heightAt e0).getD Tree.empty))) :=
    (keyWord_lt_iff_D3 _ _).2 (kappa_strictMono _ _ _ hSA)
  rw [← keyWord_lt_iff_D3]
  rcases hpos with hH | ⟨b, hb1, hb2, -, hJ | ⟨a, hab, hfd⟩⟩
  · rw [hH, heq hH]; exact hlt
  · rw [hJ.1]
    refine lt_of_take_succ hlt ?_
    have h1 := congrArg (List.take (keyWord (kappa sd.r (period sd) j
      (relKey (e.col.num 0) ((A.heightAt e).getD Tree.empty)))).length.succ) hb1
    rw [List.take_take, List.take_take] at h1
    rwa [min_eq_left (by omega)] at h1
  · exact lt_of_firstDec hlt hfd ⟨hb1, hb2⟩ hab

/-! ### T3.2o helpers (branch E3): profiles of shifted and filled heights -/

theorem takeWhile_map_len_E3 {f : Nat → Nat} (hf : Function.Injective f) (p : Nat) :
    ∀ rest : Column, ((Tree.mapCol f rest).takeWhile (fun x => x.1 == f p)).length =
      (rest.takeWhile (fun x => x.1 == p)).length
  | [] => rfl
  | (q, h) :: rest => by
    simp only [Tree.mapCol, List.takeWhile_cons]
    by_cases hq : q = p
    · subst hq; simp [takeWhile_map_len_E3 hf q rest]
    · have : f q ≠ f p := fun h => hq (hf h)
      simp [hq, this]

theorem profileAux_map_E3 {f : Nat → Nat} (hf : Function.Injective f) (d : Nat) (X : Forest) :
    profileAux d (Tree.map f X) = profileAux d X := by
  induction d, X using profileAux.induct with
  | case1 d p rest tail =>
    simp only [Tree.map, Tree.mapCols, Tree.mapCol, profileAux]
    rw [takeWhile_map_len_E3 hf p rest]
  | case2 d p rest tail head tail_1 ih =>
    simp only [Tree.map, Tree.mapCols, Tree.mapCol] at ih ⊢
    rw [profileAux, profileAux]; exact ih
  | case3 d cols hne =>
    match cols, hne with
    | [], _ => simp [Tree.map, Tree.mapCols, profileAux]
    | [] :: cs, _ => simp [Tree.map, Tree.mapCols, Tree.mapCol, profileAux]
    | ((p, h) :: rest) :: cs, hne => exact absurd rfl (hne p h rest cs)

theorem profile_shift_E3 (r d : Nat) (X : Forest) : profile (shift r d X) = profile X := by
  have hf : Function.Injective (shiftVal r d) := (StrictMono.injective (fun _ _ h =>
    shiftVal_strictMono_D3 r d h))
  obtain ⟨cols⟩ := X
  cases cols with
  | nil => rfl
  | cons c cs =>
    show (profileAux 0 (Tree.map (shiftVal r d) (Tree.node (c :: cs))) : WithBot (Nat ×ₗ Nat)) =
      profileAux 0 (Tree.node (c :: cs))
    rw [profileAux_map_E3 hf]

/-- One more singleton level above a height. -/
def sig_E3 : WithBot (Nat ×ₗ Nat) → WithBot (Nat ×ₗ Nat)
  | ⊥ => ((toLex (0, 1) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat))
  | (x : Nat ×ₗ Nat) => ((toLex ((ofLex x).1 + 1, (ofLex x).2) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat))

theorem profile_single_E3 (p : Nat) (Y : Forest) : profile (.node [[(p, Y)]]) = sig_E3 (profile Y) := by
  obtain ⟨ycols⟩ := Y
  cases ycols with
  | nil =>
    show (profileAux 0 (Tree.node [[(p, Tree.node [])]]) : WithBot (Nat ×ₗ Nat)) = sig_E3 ⊥
    simp [profileAux, sig_E3]
  | cons c cs =>
    show (profileAux 0 (Tree.node [[(p, Tree.node (c :: cs))]]) : WithBot (Nat ×ₗ Nat)) = _
    rw [spx_profileAux_cons 0 p (by simp [Tree.cols]), spx_profileAux_one]
    rfl

theorem lt_sig_E3 (x : WithBot (Nat ×ₗ Nat)) : x < sig_E3 x := by
  cases x with
  | bot => exact WithBot.bot_lt_coe _
  | coe x =>
    simp only [sig_E3]
    rw [WithBot.coe_lt_coe, ← toLex_ofLex x, Prod.Lex.lt_iff]
    left; simp

theorem sig_mono_E3 {x y : WithBot (Nat ×ₗ Nat)} (h : x ≤ y) : sig_E3 x ≤ sig_E3 y := by
  cases x with
  | bot =>
    cases y with
    | bot => exact le_rfl
    | coe y =>
      simp only [sig_E3]
      rw [WithBot.coe_le_coe]
      apply le_of_lt
      rw [Prod.Lex.lt_iff]; left; simp
  | coe x =>
    cases y with
    | bot => exact absurd h (by simp)
    | coe y =>
      simp only [sig_E3]
      rw [WithBot.coe_le_coe] at h ⊢
      rw [← toLex_ofLex x, ← toLex_ofLex y, Prod.Lex.le_iff] at h
      rw [Prod.Lex.le_iff]
      simp only [ofLex_toLex] at h ⊢
      omega

theorem sig_strictMono_E3 : StrictMono sig_E3 := by
  intro x y h
  cases x with
  | bot =>
    cases y with
    | bot => exact absurd h (lt_irrefl _)
    | coe y =>
      simp only [sig_E3]
      rw [WithBot.coe_lt_coe, ← toLex_ofLex y, Prod.Lex.lt_iff]
      simp only [ofLex_toLex]
      left; omega
  | coe x =>
    cases y with
    | bot => exact absurd h (by simp)
    | coe y =>
      simp only [sig_E3]
      rw [WithBot.coe_lt_coe] at h ⊢
      rw [← toLex_ofLex x, ← toLex_ofLex y, Prod.Lex.lt_iff] at h
      rw [Prod.Lex.lt_iff]
      simp only [ofLex_toLex] at h ⊢
      omega

theorem sig_iter_mono_E3 (k : Nat) {x y : WithBot (Nat ×ₗ Nat)} (h : x ≤ y) :
    sig_E3^[k] x ≤ sig_E3^[k] y := by
  induction k generalizing x y with
  | zero => exact h
  | succ k ih => rw [Function.iterate_succ_apply, Function.iterate_succ_apply]; exact ih (sig_mono_E3 h)

theorem sig_iter_coe_E3 (k a b : Nat) :
    sig_E3^[k] (((toLex (a, b) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat))) =
      ((toLex (a + k, b) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by
  induction k generalizing a with
  | zero => rfl
  | succ k ih =>
    rw [Function.iterate_succ_apply]
    simp only [sig_E3, ofLex_toLex]
    rw [ih]; congr 3; omega

/-- A singleton chain of depth `k`: one column with one entry at each level above depth `k`, and a
single column at depth `k`. -/
def Chain_E3 : Nat → Forest → Prop
  | 0, S => S.cols.length = 1
  | k + 1, X => ∃ p Y, X = .node [[(p, Y)]] ∧ Chain_E3 k Y

theorem chain_routeOK_E3 : ∀ (k : Nat) (X : Forest), Chain_E3 k X → RouteOK_D3 k X
  | 0, X, h => by
    show X.cols ≠ []
    intro hc; simp [Chain_E3, hc] at h
  | k + 1, _, ⟨p, Y, rfl, h⟩ => ⟨[], [], p, Y, rfl, chain_routeOK_E3 k Y h⟩

theorem chain_map_E3 (f : Nat → Nat) : ∀ (k : Nat) (X : Forest),
    Chain_E3 k (Tree.map f X) ↔ Chain_E3 k X
  | 0, X => by simp only [Chain_E3, cols_length_map_E3]
  | k + 1, .node cols => by
    simp only [Chain_E3]
    constructor
    · rintro ⟨p, Y, hX, h⟩
      simp only [Tree.map, Tree.node.injEq] at hX
      match cols, hX with
      | [[(q, Y0)]], hX =>
        simp only [Tree.mapCols, Tree.mapCol, List.cons.injEq, Prod.mk.injEq, and_true] at hX
        obtain ⟨-, rfl⟩ := hX
        exact ⟨q, Y0, rfl, (chain_map_E3 f k Y0).1 h⟩
      | [], hX => simp [Tree.mapCols] at hX
      | [[]], hX => simp [Tree.mapCols, Tree.mapCol] at hX
      | [x :: y :: zs], hX => simp [Tree.mapCols, Tree.mapCol] at hX
      | c :: d :: ds, hX => simp [Tree.mapCols] at hX
    · rintro ⟨p, Y, hX, h⟩
      cases hX
      exact ⟨f p, Tree.map f Y, by simp [Tree.map, Tree.mapCols, Tree.mapCol],
        (chain_map_E3 f k Y).2 h⟩

theorem nextLayer_single_E3 (p : Nat) (Y : Forest) : nextLayer (.node [[(p, Y)]]) = Y := by
  simp [nextLayer, lastEntry?, Tree.cols]

theorem chain_skip_E3 : ∀ (k : Nat) (X : Forest), Chain_E3 k X → ∀ j, j ≤ k →
    Chain_E3 (k - j) (skipLayers X j)
  | k, X, h, 0, _ => by simpa [skipLayers] using h
  | 0, X, h, j + 1, hj => absurd hj (by omega)
  | k + 1, _, ⟨p, Y, rfl, h⟩, j + 1, hj => by
    rw [skipLayers, nextLayer_single_E3, show k + 1 - (j + 1) = k - j by omega]
    exact chain_skip_E3 k Y h j (by omega)

theorem put_single_E3 (Z : Forest) (k p : Nat) (Y : Forest) :
    replaceAt 0 0 Z (k + 1) (.node [[(p, Y)]]) = .node [[(p, replaceAt 0 0 Z k Y)]] := by
  have := put_succ_D3 Z k [] [] p Y
  simpa using this

theorem chain_put_E3 (Z : Forest) : ∀ (k : Nat) (X : Forest), Chain_E3 k X →
    profile (replaceAt 0 0 Z k X) = sig_E3^[k] (profile Z)
  | 0, .node cols, h => by
    simp only [Chain_E3, Tree.cols] at h
    match cols, h with
    | [c], _ =>
      rw [put_zero_D3 Z (by simp)]
      simp only [List.dropLast_singleton, List.nil_append, Function.iterate_zero, id, eta_E3]
  | k + 1, _, ⟨p, Y, rfl, h⟩ => by
    rw [put_single_E3, profile_single_E3, chain_put_E3 Z k Y h, Function.iterate_succ_apply']

theorem chain_self_E3 {k : Nat} {X : Forest} (h : Chain_E3 k X) :
    profile X = sig_E3^[k] (profile (.node [routeCol_D3 k X])) := by
  conv_lhs => rw [← put_self_D3 k X (chain_routeOK_E3 k X h)]
  exact chain_put_E3 _ k X h

/-- Route containers of a filled chain have smaller profiles than the filled chain. -/
theorem chain_route_E3 (Z : Forest) : ∀ (k : Nat) (X : Forest), Chain_E3 k X →
    ∀ (ρ : EntryAddr) (x : Nat × Forest), IsRoute_E3 k X ρ → X.entryAt ρ = some x →
      profile (replaceAt 0 0 Z (k - ρ.col.path.length - 1) x.2) < profile (replaceAt 0 0 Z k X)
  | 0, X, _, ρ, x, hr, _ => by
    exfalso; have := hr.length_le; simp [rpath_E3, EntryAddr.heightPath] at this
  | k + 1, _, ⟨p, Y, rfl, h⟩, ⟨⟨P, c⟩, i⟩, x, hr, hx => by
    have hrp : rpath_E3 (k + 1) (.node [[(p, Y)]]) = (0, 0) :: rpath_E3 k Y := by
      have := rpath_snoc_E3 k [] [] p Y; simpa using this
    rw [put_single_E3, profile_single_E3]
    cases P with
    | nil =>
      simp only [IsRoute_E3, EntryAddr.heightPath, hrp, List.nil_append, List.cons_prefix_cons,
        Prod.mk.injEq, List.nil_prefix, and_true] at hr
      obtain ⟨rfl, rfl⟩ := hr
      simp only [entryAt_nil_D3] at hx
      simp at hx; subst hx
      simpa using lt_sig_E3 _
    | cons s P =>
      obtain ⟨c0, i0⟩ := s
      simp only [IsRoute_E3, EntryAddr.heightPath, hrp, List.cons_append, List.cons_prefix_cons,
        Prod.mk.injEq] at hr
      obtain ⟨⟨rfl, rfl⟩, hr⟩ := hr
      rw [entryAt_cons_D3] at hx
      simp only [List.getElem?_cons_zero, Option.bind_some] at hx
      have := chain_route_E3 Z k Y h ⟨⟨P, c⟩, i⟩ x hr hx
      simp only [List.length_cons] at this ⊢
      rw [show k + 1 - (P.length + 1) - 1 = k - P.length - 1 by omega]
      exact lt_trans this (lt_sig_E3 _)

/-- In a chain every entry is a route container or lies in the hole. -/
theorem chain_entries_E3 : ∀ (k : Nat) (X : Forest), Chain_E3 k X → ∀ (ρ : EntryAddr) (x : Nat × Forest),
    X.entryAt ρ = some x → IsRoute_E3 k X ρ ∨ InHole_E3 k X ρ.col
  | 0, X, h, ⟨⟨P, c⟩, i⟩, x, _ => by
    right
    have h0 : hcol_E3 0 X = 0 := by simp only [hcol_E3, skipLayers]; simp only [Chain_E3] at h; omega
    cases P with
    | nil => exact Or.inl ⟨rfl, by rw [h0]; omega⟩
    | cons s P => exact Or.inr ⟨s.1, s.2, P, rfl, by rw [h0]; omega⟩
  | k + 1, _, ⟨p, Y, rfl, h⟩, ⟨⟨P, c⟩, i⟩, x, hx => by
    have hrp : rpath_E3 (k + 1) (.node [[(p, Y)]]) = (0, 0) :: rpath_E3 k Y := by
      have := rpath_snoc_E3 k [] [] p Y; simpa using this
    have hhc : hcol_E3 (k + 1) (.node [[(p, Y)]]) = hcol_E3 k Y := by
      have := hcol_snoc_E3 k [] [] p Y; simpa using this
    cases P with
    | nil =>
      left
      rw [entryAt_nil_D3] at hx
      rcases c with _ | c
      · rcases i with _ | i
        · simp [IsRoute_E3, EntryAddr.heightPath, hrp]
        · simp at hx
      · simp at hx
    | cons s P =>
      obtain ⟨c0, i0⟩ := s
      rw [entryAt_cons_D3] at hx
      rcases c0 with _ | c0
      · rcases i0 with _ | i0
        · simp only [List.getElem?_cons_zero, Option.bind_some] at hx
          rcases chain_entries_E3 k Y h ⟨⟨P, c⟩, i⟩ x hx with h1 | h1
          · left
            simp only [IsRoute_E3, EntryAddr.heightPath, hrp, List.cons_append,
              List.cons_prefix_cons, true_and] at h1 ⊢
            exact h1
          · right
            simp only [InHole_E3, hrp, hhc, List.cons_append, List.cons.injEq, true_and] at h1 ⊢
            exact h1
        · simp at hx
      · simp at hx

theorem profileAux_col_E3 (d : Nat) (c : Column) (cs : List Column) :
    profileAux d (.node (c :: cs)) = profileAux d (.node [c]) := by
  rcases c with _ | ⟨⟨p, h⟩, rest⟩
  · simp [profileAux]
  · obtain ⟨hc⟩ := h
    cases hc <;> simp [profileAux]

theorem takeWhile_fst_len_E3 (p : Nat) : ∀ (l l' : Column), l.map Prod.fst = l'.map Prod.fst →
    (l.takeWhile (fun x => x.1 == p)).length = (l'.takeWhile (fun x => x.1 == p)).length
  | [], [], _ => rfl
  | [], _ :: _, h => by simp at h
  | _ :: _, [], h => by simp at h
  | x :: l, y :: l', h => by
    simp only [List.map_cons, List.cons.injEq] at h
    simp only [List.takeWhile_cons, h.1]
    split <;> simp [takeWhile_fst_len_E3 p l l' h.2]

theorem profileAux_entry_E3 (d : Nat) (x : Nat × Forest) (l l' : Column)
    (h : l.map Prod.fst = l'.map Prod.fst) (tl tl' : List Column) :
    profileAux d (.node ((x :: l) :: tl)) = profileAux d (.node ((x :: l') :: tl')) := by
  obtain ⟨p, ⟨hc⟩⟩ := x
  cases hc with
  | nil => simp only [profileAux]; rw [takeWhile_fst_len_E3 p l l' h]
  | cons c cs => simp only [profileAux]

/-- A filling changes the profile only through a chain. -/
theorem put_profile_E3 (Z : Forest) : ∀ (k : Nat) (G : Forest), RouteOK_D3 k G →
    profile (replaceAt 0 0 Z k G) = profile G ∨ Chain_E3 k G
  | 0, .node cols, hR => by
    have hc : cols ≠ [] := hR
    match cols, hc with
    | [c], _ => exact Or.inr rfl
    | c :: c' :: cs, _ =>
      left
      rw [put_zero_D3 Z (by simp)]
      simp only [List.dropLast_cons_cons, List.cons_append]
      show (profileAux 0 _ : WithBot (Nat ×ₗ Nat)) = profileAux 0 _
      rw [profileAux_col_E3, profileAux_col_E3 0 c (c' :: cs)]
  | k + 1, G, hR => by
    obtain ⟨cs, es, q, Y, rfl, hR'⟩ := hR
    rw [put_succ_D3]
    rcases cs with _ | ⟨c, cs⟩
    · rcases es with _ | ⟨x, es⟩
      · rcases put_profile_E3 Z k Y hR' with h | h
        · left
          have e1 : (Tree.node ([] ++ [[] ++ [(q, replaceAt 0 0 Z k Y)]]) : Forest) =
            .node [[(q, replaceAt 0 0 Z k Y)]] := rfl
          have e2 : (Tree.node ([] ++ [[] ++ [(q, Y)]]) : Forest) = .node [[(q, Y)]] := rfl
          rw [e1, e2, profile_single_E3, profile_single_E3, h]
        · exact Or.inr ⟨q, Y, rfl, h⟩
      · left
        show (profileAux 0 _ : WithBot (Nat ×ₗ Nat)) = profileAux 0 _
        simp only [List.nil_append, List.cons_append]
        exact congrArg _ (profileAux_entry_E3 0 x _ _ (by simp) _ _)
    · left
      show (profileAux 0 _ : WithBot (Nat ×ₗ Nat)) = profileAux 0 _
      simp only [List.cons_append]
      rw [profileAux_col_E3, profileAux_col_E3 0 c (cs ++ [es ++ [(q, Y)]])]

/-- The bottom of a chain: a head `P ⌢ V` against the stopping column `P ⌢ [(s, ∅)]`. -/
theorem bot_E3 {P V : Column} {rest : List Column} {s : Nat} (hP : P ≠ []) (hPs : ∀ x ∈ P, s ≤ x.1)
    (hV : ∀ v ∈ V.head?, v.1 < s) (hN : spxNoninc (P ++ [(s, Tree.empty)])) :
    profile (.node ((P ++ V) :: rest)) = profile (.node [P ++ [(s, Tree.empty)]]) ∨
      ((∀ x ∈ P, x = (s, Tree.empty)) ∧
        profile (.node ((P ++ V) :: rest)) = ((toLex (0, P.length) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) ∧
        profile (.node [P ++ [(s, Tree.empty)]]) =
          ((toLex (0, P.length + 1) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat))) := by
  obtain ⟨⟨q0, h0⟩, P', rfl⟩ := List.exists_cons_of_ne_nil hP
  have hq0 : s ≤ q0 := hPs (q0, h0) (by simp)
  have hVt : V.takeWhile (fun x => x.1 == q0) = [] := by
    cases V with
    | nil => rfl
    | cons v vs =>
      have : v.1 < s := hV v (by simp)
      simp [show v.1 ≠ q0 by omega]
  obtain ⟨hc⟩ := h0
  cases hc with
  | cons c cs =>
    left
    show (profileAux 0 _ : WithBot (Nat ×ₗ Nat)) = profileAux 0 _
    simp only [List.cons_append, profileAux]
  | nil =>
    by_cases hall : ∀ x ∈ P', (x.1 == q0) = true
    · by_cases hs : s = q0
      · subst hs
        right
        have hrun := spx_run_empty s (P' ++ [(s, Tree.empty)])
          (show spxNoninc ((s, Tree.empty) :: (P' ++ [(s, Tree.empty)])) from hN)
        rw [List.takeWhile_append_of_pos hall] at hrun
        refine ⟨?_, ?_, ?_⟩
        · intro x hx
          simp only [List.mem_cons] at hx
          rcases hx with rfl | hx
          · rfl
          · exact hrun x (List.mem_append_left _ hx)
        · show (profileAux 0 _ : WithBot (Nat ×ₗ Nat)) = _
          simp only [List.cons_append, profileAux, List.takeWhile_append_of_pos hall, hVt]
          simp; omega
        · show (profileAux 0 _ : WithBot (Nat ×ₗ Nat)) = _
          simp only [List.cons_append, profileAux, List.takeWhile_append_of_pos hall]
          simp; omega
      · left
        show (profileAux 0 _ : WithBot (Nat ×ₗ Nat)) = profileAux 0 _
        simp only [List.cons_append, profileAux, List.takeWhile_append_of_pos hall, hVt]
        simp [show s ≠ q0 from hs]
    · left
      show (profileAux 0 _ : WithBot (Nat ×ₗ Nat)) = profileAux 0 _
      simp only [List.cons_append, profileAux]
      have hlen : (P'.takeWhile (fun x => x.1 == q0)).length ≠ P'.length := by
        intro h
        apply hall
        have heq := (List.takeWhile_prefix (l := P') (fun x => x.1 == q0)).eq_of_length h
        have := List.all_takeWhile (l := P') (p := fun x => x.1 == q0)
        rw [heq, List.all_eq_true] at this
        exact this
      rw [List.takeWhile_append, List.takeWhile_append, if_neg hlen, if_neg hlen]

theorem noninc_ge_E3 {col : Column} (h : spxNoninc col) :
    ∀ (k i : Nat) (x y : Nat × Forest), col[i]? = some x → col[i + k]? = some y → y.1 ≤ x.1
  | 0, i, x, y, hx, hy => by rw [Nat.add_zero, hx] at hy; cases hy; exact le_rfl
  | k + 1, i, x, y, hx, hy => by
    obtain ⟨z, hz⟩ : ∃ z, col[i + 1]? = some z := by
      have := (List.getElem?_eq_some_iff.1 hy).1
      exact ⟨_, List.getElem?_eq_getElem (by omega)⟩
    have h1 := noninc_ge_E3 h k (i + 1) z y hz (by rw [show i + 1 + k = i + (k + 1) by omega]; exact hy)
    have h2 := h i x z hx hz
    rcases h2 with h2 | ⟨h2, -⟩ <;> omega

theorem noninc_shift_E3 {col : Column} (h : spxNoninc col) (r d : Nat) :
    spxNoninc (Tree.mapCol (shiftVal r d) col) := by
  intro i x y hx hy
  rw [treeMapCol_eq_map, List.getElem?_map] at hx hy
  obtain ⟨x0, hx0, rfl⟩ := Option.map_eq_some_iff.1 hx
  obtain ⟨y0, hy0, rfl⟩ := Option.map_eq_some_iff.1 hy
  exact entryLe_shift_D3 r d (h i x0 y0 hx0 hy0)

/-- Under I, a query-free stop at positive depth has at least two columns (otherwise the step is
special). -/
theorem fq_E3 {A : Forest} {sd : StopData} (hL : InL A) (hk : stepKind A = some .ordinary)
    (hsd : stopData A = some sd) (hpos : 0 < sd.depth) (hc0 : sd.col.col = 0) : sd.Q ≠ [] := by
  intro hQ
  obtain ⟨oe, col, p, -, hoe, hcol, -, hlast, hidx, hnum⟩ := ownerEntry_data hsd hpos
  obtain ⟨-, -, -, h4, -⟩ := stopData_core hsd
  have hent : A.entryAt oe = some (p, skipLayers A sd.depth) := by
    simp only [Tree.entryAt, hcol, Option.bind_some]
    rw [List.getLast?_eq_getElem?, show col.length - 1 = oe.idx by omega] at hlast
    exact hlast
  have hne : skipLayers A sd.depth ≠ Tree.empty := by
    intro h; rw [h] at h4; simp [Tree.empty, Tree.cols] at h4
  have hmem : sd.Q ++ [(sd.r, Tree.empty)] ∈ (skipLayers A sd.depth).cols := List.mem_of_getLast? h4
  obtain ⟨q, H, rest, hc, hle⟩ := hL.2.1 oe ((Tree.mem_entryAddrs_iff A oe).2 (by rw [hent]; rfl))
    p _ hent hne _ hmem
  rw [hQ, List.nil_append] at hc
  simp only [List.cons.injEq, Prod.mk.injEq] at hc
  obtain ⟨-, -, -, -, hrt, -⟩ := rootData_spec hsd (Option.isSome_iff_exists.1 (rootData_of_ordinary hk)).choose_spec
  have hsp : specialStop sd = true := by
    simp only [specialStop, Bool.and_eq_true, decide_eq_true_eq, List.isEmpty_iff, beq_iff_eq]
    refine ⟨⟨hpos, hQ⟩, ?_⟩
    omega
  have := (stepKind_special_iff A).2 ⟨sd, hsd, hsp⟩
  rw [hk] at this; cases this

/-- A continuation never raises the profile. -/
theorem cot_E3 {A : Forest} {sd : StopData} {rd : RootData} {n : Nat} (hL : InL A)
    (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd) (hrd : rootData A = some rd)
    {e : EntryAddr} {x : Nat × Forest} (hx : A.entryAt e = some x) (hon : e.heightPath <+: sd.col.path)
    {ψ : Nat} (hψ : ψ ≤ n) :
    profile (replaceAt sd.r (ψ * period sd) (zs_E3 A sd rd n ψ) (sd.depth - e.col.path.length - 1) x.2)
      ≤ profile x.2 := by
  obtain ⟨hl, -, -, -, hR, -, hrc, -, hhc, -⟩ := onR_pack_E3 hsd hx hon
  obtain ⟨-, hhcA⟩ := stop_rpath_E3 hsd
  obtain ⟨hcolsd, -⟩ := stopData_spec hsd
  have hNs := spx_condH_col hL.2.2.1 hcolsd
  have hRG := (routeOK_shift_D3 sd.r (ψ * period sd) _ _).2 hR
  rw [replaceAt_eq_shift]
  rcases put_profile_E3 (zs_E3 A sd rd n ψ) _ _ hRG with h | hch
  · rw [h, profile_shift_E3]
  · rw [chain_put_E3 _ _ _ hch, ← profile_shift_E3 sd.r (ψ * period sd) x.2, chain_self_E3 hch]
    apply sig_iter_mono_E3
    rw [routeCol_shift_D3, hrc, Tree.treeMapCol_append_D3]
    have hcm : Tree.mapCol (shiftVal sd.r (ψ * period sd)) [(sd.r, Tree.empty)] =
        [(sd.r + ψ * period sd, Tree.empty)] := by
      simp [Tree.mapCol, shiftVal]; rfl
    rw [hcm]
    by_cases hψn : ψ < n
    · rw [zs_step_E3 A sd rd hψn]
      obtain ⟨V, rest, hsh, hV⟩ := ordStep_shape_E3 hL hsd hrd ψ (zs_E3 A sd rd n (ψ + 1))
      rw [hsh]
      have hQ : sd.Q ≠ [] := by
        apply fq_E3 hL hk hsd (by omega)
        have h0 := chain_skip_E3 _ _ hch _ le_rfl
        simp only [Nat.sub_self, Chain_E3] at h0
        have : hcol_E3 (sd.depth - e.col.path.length - 1) (shift sd.r (ψ * period sd) x.2) = 0 := by
          simp only [hcol_E3]; omega
        rw [shift, hcol_map_E3, ← hhc, hhcA] at this; exact this
      have hPs : ∀ y ∈ Tree.mapCol (shiftVal sd.r (ψ * period sd)) sd.Q, sd.r + ψ * period sd ≤ y.1 := by
        intro y hy
        rw [treeMapCol_eq_map] at hy
        obtain ⟨y0, hy0, rfl⟩ := List.mem_map.1 hy
        obtain ⟨i, hi⟩ := List.getElem?_of_mem hy0
        have := noninc_ge_E3 hNs (sd.Q.length - i) i y0 (sd.r, Tree.empty)
          (by rw [List.getElem?_append_left (List.getElem?_eq_some_iff.1 hi).1]; exact hi)
          (by rw [show i + (sd.Q.length - i) = sd.Q.length by
                have := (List.getElem?_eq_some_iff.1 hi).1; omega]; simp)
        simp only [shiftVal, if_pos this]; omega
      have hN := noninc_shift_E3 hNs sd.r (ψ * period sd)
      rw [Tree.treeMapCol_append_D3, hcm] at hN
      rcases bot_E3 (by simpa [treeMapCol_eq_map] using hQ) hPs
        (fun v hv => lt_of_lt_of_le (hV v hv) (by omega)) hN with h | ⟨-, h1, h2⟩
      · exact le_of_eq h
      · rw [h1, h2, WithBot.coe_le_coe, Prod.Lex.le_iff]; right; simp
    · rw [show ψ = n by omega, zs_top_E3]
      exact bot_le

/-- Every return to the host `a'` in `H'` has a smaller profile. -/
def ProfHost_E3 (a' : Nat) (H' : Forest) : Prop :=
  ∀ ρ J', H'.entryAt ρ = some (a', J') → profile J' < profile H'

theorem condP_pair_E3 {A : Forest} (hP : CondP A) {e0 e : EntryAddr} {x0 x : Nat × Forest}
    (hx0 : A.entryAt e0 = some x0) (hx : A.entryAt e = some x) (hret : IsOwnerReturn A e0 e) :
    profile x.2 < profile x0.2 := by
  have := hP e0 ((Tree.mem_entryAddrs_iff A e0).2 (by rw [hx0]; rfl)) e
    ((Tree.mem_entryAddrs_iff A e).2 (by rw [hx]; rfl)) hret
  simpa [Tree.heightAt, hx0, hx] using this

theorem hostSP_E3 {A : Forest} (sd : StopData) (hP : CondP A) {e0 : EntryAddr} {x0 : Nat × Forest}
    (hx0 : A.entryAt e0 = some x0) (ψ : Nat) (hψ : ψ = 0 ∨ sd.r ≤ e0.col.num 0) :
    ProfHost_E3 (e0.col.num 0 + ψ * period sd) (shift sd.r (ψ * period sd) x0.2) := by
  intro ρ J' hρ
  rw [shift, entryAt_map_D3] at hρ
  obtain ⟨x, hx, hxe⟩ := Option.map_eq_some_iff.1 hρ
  simp only [Prod.mk.injEq] at hxe
  obtain ⟨hp, rfl⟩ := hxe
  have hδ : ψ * period sd = 0 ∨ sd.r ≤ e0.col.num 0 := by
    rcases hψ with h | h
    · left; rw [h, Nat.zero_mul]
    · exact Or.inr h
  have hp' : x.1 = e0.col.num 0 := shiftVal_host_E3 hδ hp
  have hx' : x0.2.entryAt ρ = some (e0.col.num 0, x.2) := by rw [hx, ← hp']
  obtain ⟨h1, h2⟩ := under_return_E3 hx0 hx'
  have := condP_pair_E3 hP hx0 h1 h2
  rw [← shift, profile_shift_E3, profile_shift_E3]; exact this

/-- The bottom of a filled chain at phase `ψ < n`: the profile is unchanged, or the query is a run
of `(r, ∅)` entries and the run loses its closing entry. -/
theorem bottom_dich_E3 {A : Forest} {sd : StopData} {rd : RootData} {n : Nat} (hL : InL A)
    (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd) (hrd : rootData A = some rd)
    {e : EntryAddr} {x : Nat × Forest} (hx : A.entryAt e = some x) (hon : e.heightPath <+: sd.col.path)
    {ψ : Nat} (hψ : ψ < n)
    (hch : Chain_E3 (sd.depth - e.col.path.length - 1) (shift sd.r (ψ * period sd) x.2)) :
    profile (replaceAt 0 0 (zs_E3 A sd rd n ψ) (sd.depth - e.col.path.length - 1)
      (shift sd.r (ψ * period sd) x.2)) = profile x.2 ∨
    ((∀ y ∈ sd.Q, y = (sd.r, Tree.empty)) ∧ 1 ≤ sd.Q.length ∧
      profile (replaceAt 0 0 (zs_E3 A sd rd n ψ) (sd.depth - e.col.path.length - 1)
        (shift sd.r (ψ * period sd) x.2)) =
        ((toLex (sd.depth - e.col.path.length - 1, sd.Q.length) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat))) := by
  obtain ⟨hl, -, -, -, hR, -, hrc, -, hhc, -⟩ := onR_pack_E3 hsd hx hon
  obtain ⟨-, hhcA⟩ := stop_rpath_E3 hsd
  obtain ⟨hcolsd, -⟩ := stopData_spec hsd
  have hNs := spx_condH_col hL.2.2.1 hcolsd
  rw [chain_put_E3 _ _ _ hch, ← profile_shift_E3 sd.r (ψ * period sd) x.2, chain_self_E3 hch,
    routeCol_shift_D3, hrc, Tree.treeMapCol_append_D3]
  have hcm : Tree.mapCol (shiftVal sd.r (ψ * period sd)) [(sd.r, Tree.empty)] =
      [(sd.r + ψ * period sd, Tree.empty)] := by
    simp [Tree.mapCol, shiftVal]; rfl
  rw [hcm, zs_step_E3 A sd rd hψ]
  obtain ⟨V, rest, hsh, hV⟩ := ordStep_shape_E3 hL hsd hrd ψ (zs_E3 A sd rd n (ψ + 1))
  rw [hsh]
  have hQ : sd.Q ≠ [] := by
    apply fq_E3 hL hk hsd (by omega)
    have h0 := chain_skip_E3 _ _ hch _ le_rfl
    simp only [Nat.sub_self, Chain_E3] at h0
    have : hcol_E3 (sd.depth - e.col.path.length - 1) (shift sd.r (ψ * period sd) x.2) = 0 := by
      simp only [hcol_E3]; omega
    rw [shift, hcol_map_E3, ← hhc, hhcA] at this; exact this
  have hPs : ∀ y ∈ Tree.mapCol (shiftVal sd.r (ψ * period sd)) sd.Q, sd.r + ψ * period sd ≤ y.1 := by
    intro y hy
    rw [treeMapCol_eq_map] at hy
    obtain ⟨y0, hy0, rfl⟩ := List.mem_map.1 hy
    obtain ⟨i, hi⟩ := List.getElem?_of_mem hy0
    have := noninc_ge_E3 hNs (sd.Q.length - i) i y0 (sd.r, Tree.empty)
      (by rw [List.getElem?_append_left (List.getElem?_eq_some_iff.1 hi).1]; exact hi)
      (by rw [show i + (sd.Q.length - i) = sd.Q.length by
            have := (List.getElem?_eq_some_iff.1 hi).1; omega]; simp)
    simp only [shiftVal, if_pos this]; omega
  have hN := noninc_shift_E3 hNs sd.r (ψ * period sd)
  rw [Tree.treeMapCol_append_D3, hcm] at hN
  rcases bot_E3 (by simpa [treeMapCol_eq_map] using hQ) hPs
    (fun v hv => lt_of_lt_of_le (hV v hv) (by omega)) hN with h | ⟨hall, h1, -⟩
  · left; rw [h]
  · right
    refine ⟨?_, List.length_pos_iff.2 hQ, ?_⟩
    · intro y hy
      have := hall _ (by rw [treeMapCol_eq_map]; exact List.mem_map_of_mem hy)
      simp only [Prod.mk.injEq] at this
      obtain ⟨h1, h2⟩ := this
      have hy1 : y.1 = sd.r := by unfold shiftVal at h1; split_ifs at h1 <;> omega
      have hy2 : y.2 = Tree.empty := by
        match hY : y.2 with
        | .node [] => rfl
        | .node (c :: cs) => rw [hY] at h2; simp [Tree.map, Tree.mapCols, Tree.empty] at h2
      exact Prod.ext hy1 hy2
    · rw [h1, sig_iter_coe_E3, treeMapCol_eq_map, List.length_map]; simp

/-- Route containers of phase `k`: P for their returns. The profile is unchanged (then the old
returns bound the new ones), or the host is a filled chain: then its route containers are smaller
by the chain, and (`k < n`) the query is a run of `(r, ∅)` whose copies have empty heights, while
the low returns are copies of chain levels strictly below the host. -/
theorem hostCP_E3 {A : Forest} {sd : StopData} {rd : RootData} {n : Nat} (hL : InL A) (hP : CondP A)
    (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd) (hrd : rootData A = some rd)
    {e0 : EntryAddr} {x0 : Nat × Forest} (hx0 : A.entryAt e0 = some x0)
    (hon : e0.heightPath <+: sd.col.path) {k : Nat} (hkn : k ≤ n)
    (hkk : k = 0 ∨ sd.r ≤ e0.col.num 0) :
    ProfHost_E3 (e0.col.num 0 + k * period sd)
      (replaceAt sd.r (k * period sd) (zs_E3 A sd rd n k) (sd.depth - e0.col.path.length - 1) x0.2) := by
  have hE : E1_E3 A sd rd n k (zs_E3 A sd rd n k) := by
    have := zs_E1_E3 (n := n) hL hsd hrd (n - k) (by omega)
    rwa [show n - (n - k) = k by omega] at this
  have hd := period_pos_E3 hsd hrd
  obtain ⟨hl, hhp, hxH, hnum, hR, hN, hrc, hrp, hhc, hat⟩ := onR_pack_E3 hsd hx0 hon
  obtain ⟨hrpA, hhcA⟩ := stop_rpath_E3 hsd
  have hδ : k * period sd = 0 ∨ sd.r ≤ e0.col.num 0 := by
    rcases hkk with h | h
    · left; rw [h, Nat.zero_mul]
    · exact Or.inr h
  have hRG := (routeOK_shift_D3 sd.r (k * period sd) _ _).2 hR
  -- the host's profile: unchanged, or a filled chain
  have hdich : profile (replaceAt 0 0 (zs_E3 A sd rd n k) (sd.depth - e0.col.path.length - 1) (shift sd.r (k * period sd) x0.2)) = profile x0.2 ∨
      (Chain_E3 (sd.depth - e0.col.path.length - 1) x0.2 ∧ Chain_E3 (sd.depth - e0.col.path.length - 1) (shift sd.r (k * period sd) x0.2) ∧ (k = n ∨ (k < n ∧ (∀ y ∈ sd.Q, y = (sd.r, Tree.empty)) ∧
        1 ≤ sd.Q.length ∧ profile (replaceAt 0 0 (zs_E3 A sd rd n k) (sd.depth - e0.col.path.length - 1) (shift sd.r (k * period sd) x0.2)) =
          ((toLex (sd.depth - e0.col.path.length - 1, sd.Q.length) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat))))) := by
    rcases put_profile_E3 (zs_E3 A sd rd n k) _ _ hRG with h | hch
    · left; rw [h, profile_shift_E3]
    · have hch0 : Chain_E3 (sd.depth - e0.col.path.length - 1) x0.2 := (chain_map_E3 _ _ _).1 hch
      by_cases hkn' : k < n
      · rcases bottom_dich_E3 hL hk hsd hrd hx0 hon hkn' hch with h | h
        · exact Or.inl h
        · exact Or.inr ⟨hch0, hch, Or.inr ⟨hkn', h⟩⟩
      · exact Or.inr ⟨hch0, hch, Or.inl (by omega)⟩
  intro ρ J' hρ
  rw [replaceAt_eq_shift] at hρ ⊢
  have hPu := put_entryAt_E3 (zs_E3 A sd rd n k) _ _ hRG ρ
  -- a return whose profile is bounded by an old return of `e0`
  have hbound : ∀ e x, A.entryAt e = some x → IsOwnerReturn A e0 e → profile J' ≤ profile x.2 →
      profile (replaceAt 0 0 (zs_E3 A sd rd n k) (sd.depth - e0.col.path.length - 1) (shift sd.r (k * period sd) x0.2)) = profile x0.2 → profile J' < profile (replaceAt 0 0 (zs_E3 A sd rd n k) (sd.depth - e0.col.path.length - 1) (shift sd.r (k * period sd) x0.2)) := by
    intro e x hx hret hle heq
    rw [heq]; exact lt_of_le_of_lt hle (condP_pair_E3 hP hx0 hx hret)
  have hnochain : ∀ ρ' x', Chain_E3 (sd.depth - e0.col.path.length - 1) x0.2 → x0.2.entryAt ρ' = some x' →
      ¬ InHole_E3 (sd.depth - e0.col.path.length - 1) x0.2 ρ'.col → ¬ IsRoute_E3 (sd.depth - e0.col.path.length - 1) x0.2 ρ' → False := by
    intro ρ' x' hch hx' h1 h2
    rcases chain_entries_E3 _ x0.2 hch ρ' x' hx' with h | h
    · exact h2 h
    · exact h1 h
  by_cases hh : InHole_E3 (sd.depth - e0.col.path.length - 1) (shift sd.r (k * period sd) x0.2) ρ.col
  · obtain ⟨h1, h2⟩ := hPu.1 hh
    rw [h1] at hρ
    obtain ⟨e, ψ, hψ1, hψ2, hψq, ⟨htr, htn, htl⟩, x, hxA, hx1, hc', hx2⟩ := hE _ _ hρ
    have hkn' : k < n := by
      by_contra hc
      rw [show k = n by omega, zs_top_E3, Tree.empty, empty_entryAt_E3] at hρ
      cases hρ
    simp only at hx1
    have hcase : x.1 = e0.col.num 0 ∧ ((k = 0 ∧ e0.col.num 0 < sd.r) ∨ (ψ = k ∧ InQ_E3 sd e)) := by
      unfold shiftVal at hx1
      split_ifs at hx1 with hxr
      · by_cases hψk : ψ = k
        · subst hψk; exact ⟨by omega, Or.inr ⟨rfl, hψq rfl⟩⟩
        · exfalso
          have : (k + 1) * period sd ≤ ψ * period sd := Nat.mul_le_mul_right _ (by omega)
          have : sd.t = sd.r + period sd := by simp only [period]; omega
          rw [Nat.succ_mul] at *
          omega
      · have hk0 : k = 0 := by
          rcases hkk with h | h
          · exact h
          · exfalso; omega
        subst hk0
        exact ⟨by omega, Or.inl ⟨rfl, by omega⟩⟩
    obtain ⟨hxa, hcase⟩ := hcase
    have hcon : e0.Contains e.col := by
      rcases hcase with ⟨-, hlow⟩ | ⟨-, hq⟩
      · exact (low_route_E3 hL.1 hsd hrd hx0 hon hlow).trans htr
      · rcases hq with ⟨h1, -⟩ | ⟨i, -, hi⟩
        · show e0.heightPath <+: e.col.path; rw [h1]; exact hon
        · exact hon.trans ((List.prefix_append _ _).trans hi)
    have hret : IsOwnerReturn A e0 e := by
      have : A.entryAt ⟨e.col, e.idx⟩ = some (e0.col.num 0, x.2) := by rw [← hxa]; exact hxA
      exact isOwnerReturn_of_parent hcon this
    have hle : profile J' ≤ profile x.2 := by
      rcases hx2 with ⟨-, hJ'⟩ | ⟨hon', hJ'⟩
      · simp only at hJ'; rw [hJ', profile_shift_E3]
      · simp only at hJ'; rw [hJ']; exact cot_E3 hL hk hsd hrd hxA hon' hψ2
    rcases hdich with heq | ⟨hch0, hch, hkn2 | ⟨-, hQr, hQ1, hprof⟩⟩
    · exact hbound e x hxA hret hle heq
    · omega
    · rw [hprof]
      obtain ⟨P, hP'⟩ := hcon
      have hρe : x0.2.entryAt ⟨⟨P, e.col.col⟩, e.idx⟩ = some x := by
        rw [← under_entryAt_E3 hx0]
        have : under_E3 e0 ⟨⟨P, e.col.col⟩, e.idx⟩ = e := by simp only [under_E3, hP']
        rw [this, hxA]
      by_cases hone : e.heightPath <+: sd.col.path
      · -- a chain level strictly below the host
        obtain ⟨hle', -, hxe, -, -, -, hrce, -⟩ := onR_pack_E3 hsd hxA hone
        have hlen : e.col.path.length = e0.col.path.length + 1 + P.length := by
          rw [← hP']; simp [EntryAddr.heightPath]; omega
        have hj : x.2 = skipLayers x0.2 (P.length + 1) := by
          rw [hxe, hxH, skipLayers_add, hlen, show e0.col.path.length + 1 + (P.length + 1) =
            e0.col.path.length + 1 + P.length + 1 by omega]
        have hchx := chain_skip_E3 _ _ hch0 (P.length + 1) (by omega)
        rw [← hj] at hchx
        have hself := chain_self_E3 hchx
        rw [show sd.depth - e0.col.path.length - 1 - (P.length + 1) = sd.depth - e.col.path.length - 1 by
          omega, hrce] at hself
        have hrep : sd.Q ++ [(sd.r, Tree.empty)] = List.replicate (sd.Q.length + 1) (sd.r, Tree.empty) := by
          have hQe : sd.Q = List.replicate sd.Q.length (sd.r, Tree.empty) := List.eq_replicate_iff.2 ⟨rfl, hQr⟩
          rw [List.replicate_succ', ← hQe]
        have htow : profile (Tree.node [sd.Q ++ [(sd.r, Tree.empty)]]) =
            ((toLex (0, sd.Q.length + 1) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by
          rw [hrep]
          have := spx_profile_tower [] sd.r sd.Q.length
          simpa [spxTower] using this
        rw [htow, sig_iter_coe_E3] at hself
        refine lt_of_le_of_lt hle ?_
        rw [hself, WithBot.coe_lt_coe, Prod.Lex.lt_iff]
        left; simp only [ofLex_toLex]; omega
      · -- the query region: empty heights
        have hq : InQ_E3 sd e := by
          rcases htl with h | h
          · exact h
          · exfalso
            refine hnochain _ x hch0 hρe ?_ ?_
            · intro hh'
              apply h
              have := (inHole_abs_E3 hrp hhc ⟨P, e.col.col⟩).2 hh'
              simpa [hP'] using this
            · intro hr'
              apply hone
              have := (isRoute_abs_E3 hrp ⟨⟨P, e.col.col⟩, e.idx⟩).2 hr'
              rw [IsRoute_E3, hrpA] at this
              show e.col.path ++ _ <+: _
              rw [← hP']
              simpa [EntryAddr.heightPath] using this
        have hx2e : x.2 = Tree.empty := by
          obtain ⟨hcolsd, -⟩ := stopData_spec hsd
          rcases hq with ⟨h1, h2⟩ | ⟨i, hi, hc⟩
          · have : A.entryAt ⟨sd.col, e.idx⟩ = sd.Q[e.idx]? := by
              simp only [Tree.entryAt, hcolsd, Option.bind_some]; rw [List.getElem?_append_left h2]
            have he : e = ⟨sd.col, e.idx⟩ := by rw [← h1]
            rw [← he, hxA] at this
            have := hQr x (List.mem_of_getElem? this.symm)
            rw [this]
          · exfalso
            have hqi : A.entryAt ⟨sd.col, i⟩ = some (sd.r, Tree.empty) := by
              simp only [Tree.entryAt, hcolsd, Option.bind_some]; rw [List.getElem?_append_left hi]
              exact hQr _ (List.getElem_mem hi) ▸ List.getElem?_eq_getElem hi
            have := N_inside_E3 hqi hc hxA
            simp [N_E3, gwordAt_empty_E3] at this
        rcases hx2 with ⟨-, hJ'⟩ | ⟨hon', -⟩
        · simp only at hJ'
          rw [hJ', hx2e]
          exact WithBot.bot_lt_coe _
        · exact absurd hon' hone
  · by_cases hr : IsRoute_E3 (sd.depth - e0.col.path.length - 1) (shift sd.r (k * period sd) x0.2) ρ
    · rw [hPu.2.1 hh hr] at hρ
      obtain ⟨y, hy, hye⟩ := Option.map_eq_some_iff.1 hρ
      simp only [Prod.mk.injEq] at hye
      obtain ⟨hp, hJ'⟩ := hye
      rcases hdich with heq | ⟨-, hch, -⟩
      · rw [shift, entryAt_map_D3] at hy
        obtain ⟨x, hx, rfl⟩ := Option.map_eq_some_iff.1 hy
        have hxa : x.1 = e0.col.num 0 := shiftVal_host_E3 hδ hp
        have hx' : x0.2.entryAt ρ = some (e0.col.num 0, x.2) := by rw [hx, ← hxa]
        obtain ⟨h1, h2⟩ := under_return_E3 hx0 hx'
        have hon' : (under_E3 e0 ρ).heightPath <+: sd.col.path := by
          have := (isRoute_abs_E3 hrp ρ).2 ((isRoute_map_E3 _ _ _ _).1 hr)
          rwa [IsRoute_E3, hrpA] at this
        have hlen : (under_E3 e0 ρ).col.path.length = e0.col.path.length + 1 + ρ.col.path.length := by
          simp [under_E3, EntryAddr.heightPath]; omega
        refine hbound _ _ h1 h2 ?_ heq
        rw [← hJ']
        have := cot_E3 (n := n) hL hk hsd hrd h1 hon' hkn
        rw [replaceAt_eq_shift, hlen] at this
        convert this using 3 <;> first | omega | rfl
      · rw [← hJ']; exact chain_route_E3 _ _ _ hch ρ y hr hy
    · rw [hPu.2.2 hh hr, shift, entryAt_map_D3] at hρ
      obtain ⟨x, hx, hxe⟩ := Option.map_eq_some_iff.1 hρ
      simp only [Prod.mk.injEq] at hxe
      obtain ⟨hp, hJ'⟩ := hxe
      rcases hdich with heq | ⟨hch0, -, -⟩
      · have hxa : x.1 = e0.col.num 0 := shiftVal_host_E3 hδ hp
        have hx' : x0.2.entryAt ρ = some (e0.col.num 0, x.2) := by rw [hx, ← hxa]
        obtain ⟨h1, h2⟩ := under_return_E3 hx0 hx'
        refine hbound _ _ h1 h2 ?_ heq
        rw [← hJ', ← shift, profile_shift_E3]
      · exact absurd (hnochain ρ x hch0 hx ((inHole_map_E3 _ _ _ _).not.1 hh)
          ((isRoute_map_E3 _ _ _ _).not.1 hr)) id

/-- Every host of an ordinary output satisfies P for its returns. -/
theorem hostsP_E3 {A : Forest} {sd : StopData} {rd : RootData} {n : Nat} (hL : InL A) (hP : CondP A)
    (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd) (hrd : rootData A = some rd)
    {e0' : EntryAddr} {y0 : Nat × Forest}
    (hy0 : (replaceAt 0 0 (zs_E3 A sd rd n 0) sd.depth A).entryAt e0' = some y0) :
    ProfHost_E3 (e0'.col.num 0) y0.2 := by
  obtain ⟨hrpA, hhcA⟩ := stop_rpath_E3 hsd
  obtain ⟨hRA, hNA⟩ := stop_route_top_D3 hsd
  have hPu := put_entryAt_E3 (zs_E3 A sd rd n 0) sd.depth A hRA e0'
  by_cases hh : InHole_E3 sd.depth A e0'.col
  · obtain ⟨h1, h2⟩ := hPu.1 hh
    rw [h1] at hy0
    have hE := zs_E1_E3 (n := n) hL hsd hrd n le_rfl
    rw [Nat.sub_self] at hE
    obtain ⟨e, ψ, -, hψ2, -, ⟨-, htn, -⟩, x, hxA, -, hc', hx2⟩ := hE _ _ hy0
    have hnum : e0'.col.num 0 = e.col.num 0 + ψ * period sd := by
      rw [h2 0, Nat.zero_add, hNA, ← hc', Nat.zero_mul, Nat.add_zero]
    rw [hnum]
    rcases hx2 with ⟨-, hJ⟩ | ⟨hon, hJ⟩
    · rw [hJ]; exact hostSP_E3 sd hP hxA ψ (Or.inr htn)
    · rw [hJ]; exact hostCP_E3 hL hP hk hsd hrd hxA hon hψ2 (Or.inr htn)
  · by_cases hr : IsRoute_E3 sd.depth A e0'
    · rw [hPu.2.1 hh hr] at hy0
      obtain ⟨x, hx, rfl⟩ := Option.map_eq_some_iff.1 hy0
      have hon : e0'.heightPath <+: sd.col.path := by rw [IsRoute_E3, hrpA] at hr; exact hr
      have := hostCP_E3 (n := n) hL hP hk hsd hrd hx hon (Nat.zero_le n) (Or.inl rfl)
      rw [Nat.zero_mul, Nat.add_zero, replaceAt_zero_E3] at this
      exact this
    · rw [hPu.2.2 hh hr] at hy0
      have := hostSP_E3 sd hP hy0 0 (Or.inl rfl)
      rw [Nat.zero_mul, Nat.add_zero, shift_zero] at this
      exact this

-- T3.2o (txt:367-376): P is preserved by ordinary steps
theorem condP_ord {A B : Forest} {n : Nat} (hL : InL A) (hP : CondP A)
    (hk : stepKind A = some .ordinary) (hB : expand A n = some B) : CondP B := by
  obtain ⟨sd, rd, hsd, hrd, hBeq, -⟩ := ord_output_D3 hL hk hB
  rw [ordZ_eq_zs_E3] at hBeq
  intro e0' he0 e' he hret
  obtain ⟨y0, hy0⟩ := Option.isSome_iff_exists.1 ((Tree.mem_entryAddrs_iff B e0').1 he0)
  obtain ⟨hcon, q, J', hJ, hres⟩ := hret
  have hq : q = e0'.col.num 0 := (ColAddr.resolve_num hres).symm
  subst hq
  obtain ⟨P, hP'⟩ := hcon
  have he' : e' = under_E3 e0' ⟨⟨P, e'.col.col⟩, e'.idx⟩ := by
    simp only [under_E3, hP']
  have hρ : y0.2.entryAt ⟨⟨P, e'.col.col⟩, e'.idx⟩ = some (e0'.col.num 0, J') := by
    rw [← under_entryAt_E3 hy0, ← he', hJ]
  have := hostsP_E3 (n := n) hL hP hk hsd hrd (by rw [← hBeq]; exact hy0) _ _ hρ
  have h3 : (B.heightAt e').getD Tree.empty = J' := by simp [Tree.heightAt, hJ]
  have h4 : (B.heightAt e0').getD Tree.empty = y0.2 := by simp [Tree.heightAt, hy0]
  rw [h3, h4]; exact this

-- T3.2q (txt:390-394, 524-530): read on the stack of a phase-`φ` copy `c` of `a`, a
-- `g_{κ_φ W}` path from a vertex `x ≥ s_φ` to an endpoint `y < r` is the copy of an old `g_W`
-- path from `x − φd` (from `r` when `x = s_φ`): low heads detour through the previous phase,
-- high heads return the old root response at `W` (all root keys are `κ`-fixed)
theorem head_path {A B : Forest} {sd : StopData} {rd : RootData} {n j : Nat} (hL : InL A)
    (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd) (hrd : rootData A = some rd)
    (hB : expand A n = some B) (hj : 1 ≤ j ∧ j ≤ n) {a c : ColAddr}
    (ha : IsTmplCol A sd rd a) (hc : phaseCol sd rd j a = some c)
    {W : List (WithTop Key)} (hW : W.Pairwise fun x y => y ≤ x) {x y : Nat} (hy : y < sd.r)
    (hx : sd.r + phaseOff sd j a * period sd ≤ x)
    (hpath : Path B (actualKeys B) c
      (W.map (WithTop.map (kappa sd.r (period sd) (phaseOff sd j a)))) x y) :
    Path A (actualKeys A) a W
      (if x = sd.r + phaseOff sd j a * period sd then sd.r else x - phaseOff sd j a * period sd) y := by
  sorry

-- T3.2q: the converse transfer, old path to new path (used by T3.2r).
-- VERIFY-U2 (F4): the new path is read in the decorated system of `B` (route last keys `⊤`).
-- With actual keys of `B` the statement is false: a continuation last key of a head is smaller
-- than the old root key and can be consumed (bounded test: 176 failures on own cut queries).
theorem head_path_rev {A B : Forest} {sd : StopData} {rd : RootData} {n j : Nat} (hL : InL A)
    (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd) (hrd : rootData A = some rd)
    (hB : expand A n = some B) (hj : 1 ≤ j ∧ j ≤ n) {a c : ColAddr}
    (ha : IsTmplCol A sd rd a) (hc : phaseCol sd rd j a = some c)
    {W : List (WithTop Key)} (hW : W.Pairwise fun x y => y ≤ x) {x0 y : Nat} (hy : y < sd.r)
    (hx0 : sd.r ≤ x0) (hpath : Path A (actualKeys A) a W x0 y) :
    Path B (capKeys B (routeCols B)) c
      (W.map (WithTop.map (kappa sd.r (period sd) (phaseOff sd j a))))
      (if x0 = sd.r then sd.r + phaseOff sd j a * period sd else x0 + phaseOff sd j a * period sd) y := by
  sorry

-- T3.2r (txt:377-403): ordinary outputs satisfy A (decorated A, then uncapping by S)
theorem condA_ord {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .ordinary)
    (hB : expand A n = some B) : CondA B := by sorry

/-! T3.2s helpers: column-local conditions, and replacing the last column at the end of a route. -/

/-- A column-local condition `φ`, read at every column with its printed number from `base`. -/
def spxAll (φ : Nat → Column → Prop) (base : Nat) (T : Forest) : Prop :=
  ∀ c col, T.colAt c = some col → φ (c.num base) col

theorem spx_num_cons (base a b : Nat) (ρ : List (Nat × Nat)) (j : Nat) :
    ColAddr.num base ⟨(a, b) :: ρ, j⟩ = ColAddr.num (base + a + 1) ⟨ρ, j⟩ := by
  simp only [ColAddr.num, List.map_cons, List.sum_cons]; omega

theorem spxAll_node {φ : Nat → Column → Prop} {base : Nat} {cols : List Column} :
    spxAll φ base (Tree.node cols) ↔
      ∀ j col, cols[j]? = some col → φ (base + j) col ∧ ∀ x ∈ col, spxAll φ (base + j + 1) x.2 := by
  constructor
  · intro h j col hj
    refine ⟨?_, fun x hx c col' hc => ?_⟩
    · have := h ⟨[], j⟩ col (by simpa [Tree.colAt, Tree.forestAt, Tree.cols] using hj)
      simpa [ColAddr.num] using this
    · obtain ⟨i, hi⟩ := List.mem_iff_getElem?.1 hx
      have := h ⟨(j, i) :: c.path, c.col⟩ col' (by
        rw [Tree.colAt_cons]; simp [Tree.cols, hj, hi, hc])
      rwa [spx_num_cons] at this
  · intro h c col hc
    obtain ⟨P, j⟩ := c
    cases P with
    | nil =>
      have hj : cols[j]? = some col := by simpa [Tree.colAt, Tree.forestAt, Tree.cols] using hc
      simpa [ColAddr.num] using (h j col hj).1
    | cons s ρ =>
      obtain ⟨a, b⟩ := s
      rw [Tree.colAt_cons] at hc
      simp only [Tree.cols, Option.bind_eq_some_iff] at hc
      obtain ⟨x, ⟨colA, hA, hb⟩, hx⟩ := hc
      rw [spx_num_cons]
      exact (h a colA hA).2 x (List.mem_of_getElem? hb) ⟨ρ, j⟩ col hx

theorem spx_replaceAt_zero (Z : Forest) (ys : List Column) (y : Column) :
    replaceAt 0 0 Z 0 (Tree.node (ys ++ [y])) = Tree.node (ys ++ Z.cols) := by
  cases ys with
  | nil => simp [replaceAt, shiftVal_zero_fun, treeMapCol_id_fun]
  | cons c cs =>
    simp only [replaceAt, shiftVal_zero_fun, treeMapCol_id_fun, List.map_id]
    rw [List.dropLast_concat]
    simp only [List.cons_append]

theorem spx_replaceAt_succ (Z : Forest) (k : Nat) (ys : List Column) (zs : Column) (q : Nat)
    (h : Forest) :
    replaceAt 0 0 Z (k + 1) (Tree.node (ys ++ [zs ++ [(q, h)]])) =
      Tree.node (ys ++ [zs ++ [(q, replaceAt 0 0 Z k h)]]) := by
  simp only [replaceAt, mapLast_eq, List.dropLast_concat, List.getLast?_concat,
    Option.map_some, Option.toList_some, shiftVal_zero_fun, treeMapCol_id_fun, id, treeMap_id,
    List.map_id]
  simp

/-- Replacing the last column at the end of a route path keeps a column-local condition, given
the condition at the new column and below it, and a relation `R` between the old and new heights
of the containers along which `φ` passes. -/
theorem spxAll_replace {φ : Nat → Column → Prop} (R : Forest → Forest → Prop) {c' col : Column}
    (hR0 : ∀ cs, R (Tree.node (cs ++ [c'])) (Tree.node (cs ++ [col])))
    (hRs : ∀ ys zs q h h', R h' h →
      R (Tree.node (ys ++ [zs ++ [(q, h')]])) (Tree.node (ys ++ [zs ++ [(q, h)]])))
    (hφ : ∀ n zs q h h', R h' h → φ n (zs ++ [(q, h)]) → φ n (zs ++ [(q, h')])) :
    ∀ (π : List (Nat × Nat)) (F G : Forest) (cs : List Column) (base : Nat), IsRoutePath F π →
      F.forestAt π = some G → G.cols = cs ++ [col] → spxAll φ base F →
      φ (ColAddr.num base ⟨π, cs.length⟩) c' →
      (∀ x ∈ c', spxAll φ (ColAddr.num base ⟨π, cs.length⟩ + 1) x.2) →
      spxAll φ base (replaceAt 0 0 (Tree.node [c']) π.length F) ∧
        R (replaceAt 0 0 (Tree.node [c']) π.length F) F
  | [], F, G, cs, base, _, hG, hGc, hF, hc', hsub => by
    simp only [Tree.forestAt, Option.some.injEq] at hG
    subst hG
    obtain ⟨cols⟩ := F
    simp only [Tree.cols] at hGc
    subst hGc
    simp only [List.length_nil, spx_replaceAt_zero, Tree.cols]
    refine ⟨?_, hR0 cs⟩
    rw [spxAll_node] at hF ⊢
    intro j c hj
    by_cases hjc : j = cs.length
    · subst hjc
      simp only [List.getElem?_append_right (le_refl _), Nat.sub_self, List.getElem?_cons_zero,
        Option.some.injEq] at hj
      subst hj
      simpa [ColAddr.num] using And.intro hc' hsub
    · have : (cs ++ [col])[j]? = some c := by
        rcases Nat.lt_or_gt_of_ne hjc with hlt | hgt
        · rw [List.getElem?_append_left hlt] at hj ⊢; exact hj
        · rw [List.getElem?_append_right (by omega)] at hj ⊢
          simp [show j - cs.length ≠ 0 by omega] at hj
      exact hF j c this
  | s :: π, .node cols, G, cs, base, hr, hG, hGc, hF, hc', hsub => by
    obtain ⟨hl, h, hh, hr'⟩ := isRoutePath_cons.1 hr
    obtain ⟨colL, q, h₀, hcol, hcl, hs, hh'⟩ := lastStep?_eq_some hl
    rw [hh] at hh'
    cases hh'
    have hG' : h.forestAt π = some G := by
      rw [show s :: π = [s] ++ π from rfl, Tree.forestAt_append, hh] at hG
      exact hG
    simp only [Tree.cols] at hcol hs
    obtain ⟨ys, rfl⟩ := List.getLast?_eq_some_iff.1 hcol
    obtain ⟨zs, rfl⟩ := List.getLast?_eq_some_iff.1 hcl
    subst hs
    simp only [List.length_append, List.length_singleton, Nat.add_sub_cancel] at hF hc' hsub ⊢
    rw [List.length_cons, spx_replaceAt_succ]
    rw [spxAll_node] at hF
    have hFy := hF ys.length (zs ++ [(q, h)]) (by simp)
    have hn : ∀ n, ColAddr.num base ⟨(ys.length, zs.length) :: π, n⟩ =
        ColAddr.num (base + ys.length + 1) ⟨π, n⟩ := fun n => spx_num_cons _ _ _ _ _
    rw [hn] at hc' hsub
    obtain ⟨ih1, ih2⟩ := spxAll_replace R hR0 hRs hφ π h G cs (base + ys.length + 1) hr' hG' hGc
      (hFy.2 (q, h) (by simp)) hc' hsub
    refine ⟨?_, hRs ys zs q h _ ih2⟩
    rw [spxAll_node]
    intro j c hj
    by_cases hjc : j = ys.length
    · subst hjc
      simp only [List.getElem?_append_right (le_refl _), Nat.sub_self, List.getElem?_cons_zero,
        Option.some.injEq] at hj
      subst hj
      refine ⟨hφ _ zs q h _ ih2 hFy.1, ?_⟩
      intro x hx
      rcases List.mem_append.1 hx with hx | hx
      · exact hFy.2 x (List.mem_append_left _ hx)
      · simp only [List.mem_singleton] at hx; subst hx; exact ih1
    · have : (ys ++ [zs ++ [(q, h)]])[j]? = some c := by
        rcases Nat.lt_or_gt_of_ne hjc with hlt | hgt
        · rw [List.getElem?_append_left hlt] at hj ⊢; exact hj
        · rw [List.getElem?_append_right (by omega)] at hj ⊢
          simp [show j - ys.length ≠ 0 by omega] at hj
      exact hF j c this

theorem spx_then_eq (o : Ordering) : o.then .eq = o := by cases o <;> rfl

theorem spx_compare_self (q : Nat) : compare q q = .eq := compare_eq_iff_eq.2 rfl

theorem spx_cmpCols_append (ys X Y : List Column) :
    Tree.cmpCols compare (ys ++ X) (ys ++ Y) = Tree.cmpCols compare X Y := by
  induction ys with
  | nil => rfl
  | cons y ys ih =>
    simp only [List.cons_append, Tree.cmpCols, Tree.cmpCol_self, ih]; rfl

theorem spx_cmpCol_append (zs X Y : Column) :
    Tree.cmpCol compare (zs ++ X) (zs ++ Y) = Tree.cmpCol compare X Y := by
  induction zs with
  | nil => rfl
  | cons z zs ih =>
    obtain ⟨q, h⟩ := z
    simp only [List.cons_append, Tree.cmpCol, Tree.cmp_self, spx_compare_self, ih]; rfl

/-- Lowering the height of the last entry of the last column lowers the forest. -/
theorem spx_le_last (ys : List Column) (zs : Column) (q : Nat) {h h' : Forest} (hh : h' ≤ h) :
    Tree.node (ys ++ [zs ++ [(q, h')]]) ≤ Tree.node (ys ++ [zs ++ [(q, h)]]) := by
  rw [Forest.le_iff_cmp] at hh ⊢
  show Tree.cmpCols compare _ _ ≠ .gt
  rw [spx_cmpCols_append]
  simp only [Tree.cmpCols, spx_then_eq]
  rw [spx_cmpCol_append]
  simp only [Tree.cmpCol, spx_compare_self, spx_then_eq]
  exact hh

/-- Lowering the last column lowers the forest. -/
theorem spx_le_lastCol (cs : List Column) {c' col : Column} (h : Tree.cmpCol compare c' col ≠ .gt) :
    Tree.node (cs ++ [c']) ≤ Tree.node (cs ++ [col]) := by
  rw [Forest.le_iff_cmp]
  show Tree.cmpCols compare _ _ ≠ .gt
  rw [spx_cmpCols_append]
  simp only [Tree.cmpCols, spx_then_eq]
  exact h

/-- Dropping the last column is a decrease. -/
theorem spx_dropLast_lt {Fl : Forest} (h : Fl.cols ≠ []) : Tree.node Fl.cols.dropLast < Fl := by
  rw [Forest.lt_iff_cmp]
  obtain ⟨L, x, hL⟩ := (List.eq_nil_or_concat Fl.cols).resolve_left h
  rw [spx_eta Fl, hL]
  show Tree.cmpCols compare _ _ = .lt
  simp only [Tree.cols]
  rw [List.concat_eq_append, List.dropLast_concat]
  have := spx_cmpCols_append L [] [x]
  rw [List.append_nil] at this
  rw [this]; rfl

/-! The three column-local conditions V, I, H. -/

def spxφV (n : Nat) (col : Column) : Prop := ∀ x ∈ col, x.1 < n

def spxφI (n : Nat) (col : Column) : Prop :=
  ∀ x ∈ col, x.2 ≠ Tree.empty → ∀ cc ∈ x.2.cols, ∃ q H rest, cc = (q, H) :: rest ∧ n ≤ q

def spxφH (_ : Nat) (col : Column) : Prop := spxNoninc col

theorem spx_condV_iff (E : Forest) : CondV E ↔ spxAll spxφV 0 E := by
  rw [condV_iff_lt]
  constructor
  · intro h c col hc x hx
    obtain ⟨i, hi⟩ := List.mem_iff_getElem?.1 hx
    have he : E.entryAt ⟨c, i⟩ = some x := by rw [Tree.entryAt, hc]; exact hi
    exact h ⟨c, i⟩ ((Tree.mem_entryAddrs_iff _ _).2 (by rw [he]; rfl)) x.1 x.2 he
  · intro h e _ p H he
    obtain ⟨col, hc, hi⟩ := Tree.colAt_of_entryAt he
    exact h e.col col hc (p, H) (List.mem_of_getElem? hi)

theorem spx_condI_iff (E : Forest) : CondI E ↔ spxAll spxφI 0 E := by
  constructor
  · intro h c col hc x hx hne cc hcc
    obtain ⟨i, hi⟩ := List.mem_iff_getElem?.1 hx
    have he : E.entryAt ⟨c, i⟩ = some x := by rw [Tree.entryAt, hc]; exact hi
    exact h ⟨c, i⟩ ((Tree.mem_entryAddrs_iff _ _).2 (by rw [he]; rfl)) x.1 x.2 he hne cc hcc
  · intro h e _ p H he hne cc hcc
    obtain ⟨col, hc, hi⟩ := Tree.colAt_of_entryAt he
    exact h e.col col hc (p, H) (List.mem_of_getElem? hi) hne cc hcc

theorem spx_condH_iff (E : Forest) : CondH E ↔ spxAll spxφH 0 E := by
  constructor
  · intro h c col hc
    exact spx_condH_col h hc
  · intro h c _ i x y hx hy
    obtain ⟨col, hc⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff _ c).1 ‹_›)
    rw [hc, Option.getD_some] at hx hy
    exact h c col hc i x y hx hy

/-- Column-local conditions pass to the heights of a column's entries. -/
theorem spxAll_height {φ : Nat → Column → Prop} {base : Nat} {T : Forest} (h : spxAll φ base T)
    {c : ColAddr} {col : Column} (hc : T.colAt c = some col) :
    ∀ x ∈ col, spxAll φ (c.num base + 1) x.2 := by
  intro x hx c'' col'' hc''
  obtain ⟨i, hi⟩ := List.mem_iff_getElem?.1 hx
  have hcol : T.colAt ⟨c.path ++ (c.col, i) :: c''.path, c''.col⟩ = some col'' := by
    rw [show c.path ++ (c.col, i) :: c''.path = (⟨c, i⟩ : EntryAddr).heightPath ++ c''.path by
      simp [EntryAddr.heightPath], spx_colAt_append, Tree.forestAt_heightPath, Tree.heightAt,
      Tree.entryAt, hc]
    simp [hi, hc'']
  have := h _ _ hcol
  have hn : ColAddr.num base ⟨c.path ++ (c.col, i) :: c''.path, c''.col⟩ =
      ColAddr.num (c.num base + 1) c'' := by
    simp only [ColAddr.num, List.map_append, List.map_cons, List.sum_append, List.sum_cons]; omega
  rwa [hn] at this

/-- Column-local conditions hold for a forest made of a prefix of the columns. -/
theorem spxAll_dropLast {φ : Nat → Column → Prop} {base : Nat} {Fl : Forest}
    (h : spxAll φ base Fl) : spxAll φ base (Tree.node Fl.cols.dropLast) := by
  rw [spx_eta Fl, spxAll_node] at h
  rw [spxAll_node]
  intro j col hj
  exact h j col (by rw [List.getElem?_dropLast] at hj; split_ifs at hj; exact hj)

/-- Lowering the height of the last entry keeps a column nonincreasing. -/
theorem spx_noninc_lower {zs : Column} {q : Nat} {h h' : Forest} (hc : spxNoninc (zs ++ [(q, h)]))
    (hh : h' ≤ h) : spxNoninc (zs ++ [(q, h')]) := by
  intro i x y hx hy
  by_cases hi : i + 1 < zs.length
  · rw [List.getElem?_append_left (by omega)] at hx
    rw [List.getElem?_append_left hi] at hy
    exact hc i x y (by rw [List.getElem?_append_left (by omega)]; exact hx)
      (by rw [List.getElem?_append_left hi]; exact hy)
  · have hil : i + 1 = zs.length := by
      have := (List.getElem?_eq_some_iff.1 hy).1; simp at this; omega
    rw [List.getElem?_append_left (by omega)] at hx
    rw [List.getElem?_append_right (by omega), hil, Nat.sub_self] at hy
    simp only [List.getElem?_cons_zero, Option.some.injEq] at hy
    subst hy
    have := hc i x (q, h) (by rw [List.getElem?_append_left (by omega)]; exact hx)
      (by rw [List.getElem?_append_right (by omega), hil, Nat.sub_self]; rfl)
    rcases this with hlt | ⟨heq, hle⟩
    · exact Or.inl hlt
    · exact Or.inr ⟨heq, le_trans hh hle⟩

/-- Repeating the last entry keeps a column nonincreasing. -/
theorem spx_noninc_replicate {L : Column} {z : Nat × Forest} (hc : spxNoninc (L ++ [z])) (N : Nat) :
    spxNoninc (L ++ List.replicate N z) := by
  intro i x y hx hy
  by_cases hi : i + 1 < L.length
  · rw [List.getElem?_append_left (by omega)] at hx
    rw [List.getElem?_append_left hi] at hy
    exact hc i x y (by rw [List.getElem?_append_left (by omega)]; exact hx)
      (by rw [List.getElem?_append_left hi]; exact hy)
  · by_cases hil : i + 1 = L.length
    · rw [List.getElem?_append_left (by omega)] at hx
      rw [List.getElem?_append_right (by omega), hil, Nat.sub_self] at hy
      have hy' := List.eq_of_mem_replicate (List.mem_of_getElem? hy)
      subst hy'
      exact hc i x _ (by rw [List.getElem?_append_left (by omega)]; exact hx)
        (by rw [List.getElem?_append_right (by omega), hil, Nat.sub_self]; rfl)
    · rw [List.getElem?_append_right (by omega)] at hx hy
      have hx' := List.eq_of_mem_replicate (List.mem_of_getElem? hx)
      have hy' := List.eq_of_mem_replicate (List.mem_of_getElem? hy)
      subst hx' hy'
      exact Or.inr ⟨rfl, le_refl _⟩

/-- The special output: the owner column `P ⌢ [(p, Fl)]` at the end of the route path `π` becomes
`P ⌢ [(p, C)]^N`, `C` being `Fl` without its last column, with `N ≥ 1` when `P = []`. -/
theorem spx_special_shape {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .special)
    (hB : expand A n = some B) :
    ∃ (π : List (Nat × Nat)) (G : Forest) (cs : List Column) (P : Column) (p : Nat) (Fl : Forest)
      (N : Nat), IsRoutePath A π ∧ A.forestAt π = some G ∧ G.cols = cs ++ [P ++ [(p, Fl)]] ∧
      Fl.cols ≠ [] ∧ (P = [] → 1 ≤ N) ∧
      B = replaceAt 0 0 (Tree.node [P ++ List.replicate N (p, Tree.node Fl.cols.dropLast)])
        π.length A := by
  obtain ⟨hV, hI, -, -, -⟩ := hL
  have hE : A ≠ Tree.empty := by
    rintro rfl; simp [stepKind, stepKindBody, Tree.empty, Tree.cols] at hk
  rw [expand_eq_paperOp hE hV hI] at hB
  obtain ⟨sd, hsd⟩ := Option.isSome_iff_exists.1 (stopData_of_stepKind hk (by decide))
  obtain ⟨oe, hoe⟩ := Option.isSome_iff_exists.1 (ownerEntry_of_special hk hsd)
  obtain ⟨-, hhp, -, col, p, Fl, hcol, hlast, -, hFl⟩ := ownerEntry_spec hk hsd hoe
  rw [paperOp_special hk hsd hoe hcol hlast n, Option.some.injEq, Hole.fill_zero] at hB
  obtain ⟨-, hdep, -, hmem, -, -⟩ := stopData_spec hsd
  obtain ⟨hrp, -⟩ := (mem_routeCols_iff A sd.col).1 hmem
  rw [← hhp] at hrp hdep
  have hrpπ : IsRoutePath A oe.col.path := by
    intro d hd
    obtain ⟨F, hF, hFl'⟩ := hrp d (by simp [EntryAddr.heightPath]; omega)
    refine ⟨F, ?_, ?_⟩
    · rw [EntryAddr.heightPath, List.take_append_of_le_length (le_of_lt hd)] at hF; exact hF
    · rw [EntryAddr.heightPath, List.getElem?_append_left hd] at hFl'; exact hFl'
  obtain ⟨G, hG, hGl⟩ := hrp oe.col.path.length (by simp [EntryAddr.heightPath])
  simp only [EntryAddr.heightPath, List.take_left', List.getElem?_append_right (le_refl _),
    Nat.sub_self, List.getElem?_cons_zero] at hG hGl
  obtain ⟨colL, q', h', hcolL, -, hs, -⟩ := lastStep?_eq_some hGl
  simp only [Prod.mk.injEq] at hs
  obtain ⟨hs1, -⟩ := hs
  have hcc : col = colL := by
    rw [Tree.colAt, hG, Option.bind_some, hs1, ← List.getLast?_eq_getElem?, hcolL] at hcol
    exact (Option.some.inj hcol).symm
  subst hcc
  obtain ⟨cs, hcs⟩ := List.getLast?_eq_some_iff.1 hcolL
  obtain ⟨P, hP⟩ := List.getLast?_eq_some_iff.1 hlast
  have hFl' : Fl.cols ≠ [] := by intro h0; rw [h0] at hFl; simp at hFl
  refine ⟨oe.col.path, G, cs, P, p, Fl, n + (if col.dropLast.isEmpty then 1 else 0), hrpπ, hG,
    by rw [hcs, hP], hFl', fun hP0 => by simp [hP, hP0], ?_⟩
  rw [← hB, Hole.put]
  simp only [hdep, EntryAddr.heightPath, List.length_append, List.length_singleton,
    Nat.add_sub_cancel, hP, List.dropLast_concat]

theorem spx_mem_special {P : Column} {N p : Nat} {C : Forest} {x : Nat × Forest}
    (hx : x ∈ P ++ List.replicate N (p, C)) : x ∈ P ∨ x = (p, C) := by
  rcases List.mem_append.1 hx with hx | hx
  · exact Or.inl hx
  · exact Or.inr (List.eq_of_mem_replicate hx)

-- T3.2s (txt:404-407): special outputs satisfy V, I, H
theorem condVIH_special {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .special)
    (hB : expand A n = some B) : CondV B ∧ CondI B ∧ CondH B := by
  obtain ⟨π, G, cs, P, p, Fl, N, hrp, hG, hGc, hFl, hN, rfl⟩ := spx_special_shape hL hk hB
  obtain ⟨hV, hI, hH, -, -⟩ := hL
  have hcolA : A.colAt ⟨π, cs.length⟩ = some (P ++ [(p, Fl)]) := by
    simp [Tree.colAt, hG, hGc]
  have hCFl : Tree.node Fl.cols.dropLast < Fl := spx_dropLast_lt hFl
  have hFlne : Fl ≠ Tree.empty := by intro h0; rw [h0] at hFl; exact hFl rfl
  refine ⟨?_, ?_, ?_⟩
  · -- V: parents are unchanged
    rw [spx_condV_iff] at hV ⊢
    refine (spxAll_replace (φ := spxφV) (fun _ _ => True) (fun _ => trivial)
      (fun _ _ _ _ _ _ => trivial) ?_ π A G cs 0 hrp hG hGc hV ?_ ?_).1
    · intro m zs q h h' _ hφ x hx
      rcases List.mem_append.1 hx with hx | hx
      · exact hφ x (List.mem_append_left _ hx)
      · simp only [List.mem_singleton] at hx; subst hx; exact hφ (q, h) (by simp)
    · intro x hx
      rcases spx_mem_special hx with hx | rfl
      · exact hV _ _ hcolA x (List.mem_append_left _ hx)
      · exact hV _ _ hcolA (p, Fl) (by simp)
    · intro x hx
      rcases spx_mem_special hx with hx | rfl
      · exact spxAll_height hV hcolA x (List.mem_append_left _ hx)
      · exact spxAll_dropLast (spxAll_height hV hcolA (p, Fl) (by simp))
  · -- I: first parents of all columns are unchanged
    rw [spx_condI_iff] at hI ⊢
    let f : Column → Option Nat := fun cc => cc.head?.map Prod.fst
    refine (spxAll_replace (φ := spxφI) (fun h' h => h'.cols.map f = h.cols.map f) ?_ ?_ ?_
      π A G cs 0 hrp hG hGc hI ?_ ?_).1
    · intro cs'
      simp only [Tree.cols, List.map_append, List.map_cons, List.map_nil, f]
      congr 2
      cases P with
      | nil =>
        obtain ⟨N', rfl⟩ : ∃ N', N = N' + 1 := ⟨N - 1, by have := hN rfl; omega⟩
        simp [List.replicate_succ]
      | cons x xs => simp
    · intro ys zs q h h' _
      simp only [Tree.cols, List.map_append, List.map_cons, List.map_nil, f]
      cases zs <;> simp
    · intro m zs q h h' hR hφ x hx hne cc hcc
      rcases List.mem_append.1 hx with hx | hx
      · exact hφ x (List.mem_append_left _ hx) hne cc hcc
      · simp only [List.mem_singleton] at hx
        subst hx
        dsimp only at hne hcc
        obtain ⟨i, hi⟩ := List.mem_iff_getElem?.1 hcc
        have hlen : h'.cols.length = h.cols.length := by simpa using congrArg List.length hR
        have hi' : i < h.cols.length := by have := (List.getElem?_eq_some_iff.1 hi).1; omega
        have hne' : h ≠ Tree.empty := by
          intro h0; rw [h0] at hi'; simp [Tree.empty, Tree.cols] at hi'
        obtain ⟨q₀, H₀, rest₀, hc₀, hq₀⟩ := hφ (q, h) (by simp) hne' _
          (List.getElem_mem hi')
        have hf := congrArg (fun l => l[i]?) hR
        simp only [List.getElem?_map, hi, List.getElem?_eq_getElem hi', hc₀, Option.map_some,
          f] at hf
        obtain ⟨⟨q₁, H₁⟩, rest₁, rfl⟩ : ∃ y rest, cc = y :: rest := by
          cases cc with
          | nil => simp at hf
          | cons y rest => exact ⟨y, rest, rfl⟩
        simp only [List.head?_cons, Option.map_some, Option.some.injEq] at hf
        exact ⟨q₁, H₁, rest₁, rfl, hf ▸ hq₀⟩
    · intro x hx hne cc hcc
      rcases spx_mem_special hx with hx | rfl
      · exact hI _ _ hcolA x (List.mem_append_left _ hx) hne cc hcc
      · exact hI _ _ hcolA (p, Fl) (by simp) hFlne cc (List.mem_of_mem_dropLast hcc)
    · intro x hx
      rcases spx_mem_special hx with hx | rfl
      · exact spxAll_height hI hcolA x (List.mem_append_left _ hx)
      · exact spxAll_dropLast (spxAll_height hI hcolA (p, Fl) (by simp))
  · -- H: the changed heights only decrease
    rw [spx_condH_iff] at hH ⊢
    refine (spxAll_replace (φ := spxφH) (fun h' h => h' ≤ h) ?_ ?_ ?_
      π A G cs 0 hrp hG hGc hH ?_ ?_).1
    · intro cs'
      apply spx_le_lastCol
      rw [spx_cmpCol_append]
      cases N with
      | zero => simp [Tree.cmpCol]
      | succ N =>
        simp only [List.replicate_succ, Tree.cmpCol, spx_compare_self]
        rw [show Tree.cmp compare (Tree.node Fl.cols.dropLast) Fl = .lt from hCFl]
        simp
    · intro ys zs q h h' hh; exact spx_le_last ys zs q hh
    · intro m zs q h h' hh hφ; exact spx_noninc_lower hφ hh
    · exact spx_noninc_replicate (spx_noninc_lower (hH _ _ hcolA) (le_of_lt hCFl)) N
    · intro x hx
      rcases spx_mem_special hx with hx | rfl
      · exact spxAll_height hH hcolA x (List.mem_append_left _ hx)
      · exact spxAll_dropLast (spxAll_height hH hcolA (p, Fl) (by simp))


-- T3.2t (txt:406-409): special outputs satisfy S, and P when present
theorem condS_special {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .special)
    (hB : expand A n = some B) : CondS B := by sorry
theorem condP_special {A B : Forest} {n : Nat} (hL : InL A) (hP : CondP A)
    (hk : stepKind A = some .special) (hB : expand A n = some B) : CondP B := by sorry

-- T3.2u (txt:410-412): special outputs satisfy A
theorem condA_special {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .special)
    (hB : expand A n = some B) : CondA B := by sorry

/-! T3.2v helpers: the columns of a seed. -/

/-- The height below the branch entry with parent `l` of `L_{m+1}`. -/
def spxSeedH (l s : Nat) : Forest := if s = 0 then Tree.empty else .node [branch (l + 1) (s - 1)]

theorem spx_branch (l s : Nat) : branch l s = [(l, spxSeedH l s)] := by
  cases s <;> rfl

/-- Columns of a branch forest. -/
theorem spx_branch_colAt : ∀ (k i : Nat) (P : List (Nat × Nat)) (j : Nat) (col : Column),
    (Tree.node [branch i k]).colAt ⟨P, j⟩ = some col →
      ∃ l ≤ k, P = List.replicate l (0, 0) ∧ j = 0 ∧ col = branch (i + l) (k - l)
  | k, i, [], j, col, h => by
    simp only [Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols] at h
    cases j with
    | zero => simp only [List.getElem?_cons_zero, Option.some.injEq] at h; exact ⟨0, by omega, rfl, rfl, by simp [h]⟩
    | succ j => simp at h
  | k, i, (a, b) :: P, j, col, h => by
    rw [Tree.colAt_cons] at h
    simp only [Tree.cols] at h
    cases a with
    | succ a => simp at h
    | zero =>
      cases k with
      | zero => cases b <;> simp [branch, spx_colAt_empty] at h
      | succ k =>
        cases b with
        | succ b => simp [branch] at h
        | zero =>
          simp only [branch, List.getElem?_cons_zero, Option.bind_some] at h
          obtain ⟨l, hl, rfl, rfl, rfl⟩ := spx_branch_colAt k (i + 1) P j col h
          exact ⟨l + 1, by omega, by simp [List.replicate_succ], rfl, by
            rw [show i + 1 + l = i + (l + 1) by omega, show k - l = k + 1 - (l + 1) by omega]⟩

/-- Columns of `L_{m+1}`: the empty outer column, and one singleton column per level. -/
theorem spx_seed_colAt (m : Nat) (c : ColAddr) (col : Column)
    (h : (seed (m + 1)).colAt c = some col) :
    (c = ⟨[], 0⟩ ∧ col = []) ∨ ∃ l ≤ m, c.num 0 = l + 1 ∧ col = branch l (m - l) := by
  obtain ⟨P, j⟩ := c
  cases P with
  | nil =>
    simp only [seed, Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols] at h
    match j, h with
    | 0, h => left; simp at h; exact ⟨rfl, h⟩
    | 1, h => right; simp at h; exact ⟨0, by omega, by simp [ColAddr.num], by simp [h]⟩
    | j + 2, h => simp at h
  | cons x P =>
    obtain ⟨a, b⟩ := x
    rw [seed, Tree.colAt_cons] at h
    simp only [Tree.cols] at h
    match a, b, h with
    | 0, b, h => simp at h
    | a + 2, b, h => simp at h
    | 1, b + 1, h => simp [spx_branch] at h
    | 1, 0, h =>
      cases m with
      | zero => simp [branch, spx_colAt_empty] at h
      | succ k =>
        simp only [branch, List.getElem?_cons_succ, List.getElem?_cons_zero, Option.bind_some] at h
        obtain ⟨l, hl, rfl, rfl, rfl⟩ := spx_branch_colAt k 1 P j col h
        right
        refine ⟨l + 1, by omega, ?_, by rw [show 1 + l = l + 1 by omega,
          show k - l = k + 1 - (l + 1) by omega]⟩
        simp [ColAddr.num, List.map_replicate, List.sum_replicate]; omega

/-- Entries of `L_{m+1}`: the entry at level `l` has parent `l`, column number `l + 1`. -/
theorem spx_seed_entryAt (m : Nat) (e : EntryAddr) (q : Nat) (h : Forest)
    (he : (seed (m + 1)).entryAt e = some (q, h)) :
    ∃ l ≤ m, e.idx = 0 ∧ e.col.num 0 = l + 1 ∧ q = l ∧ h = spxSeedH l (m - l) := by
  obtain ⟨col, hcol, hi⟩ := Tree.colAt_of_entryAt he
  rcases spx_seed_colAt m e.col col hcol with ⟨-, rfl⟩ | ⟨l, hl, hn, rfl⟩
  · simp at hi
  · rw [spx_branch] at hi
    cases hidx : e.idx with
    | zero =>
      rw [hidx] at hi
      simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hi
      exact ⟨l, hl, rfl, hn, hi.1.symm, hi.2.symm⟩
    | succ i => rw [hidx] at hi; simp at hi

theorem spx_profile_branch : ∀ (s i : Nat),
    profile (Tree.node [branch i s]) = ((toLex (s, 1) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat))
  | 0, i => by simp [branch, profile, profileBody, profileAux, Tree.empty]
  | s + 1, i => by
    rw [spx_profile_node (by simp), branch, spx_profileAux_cons 0 i (by simp [Tree.cols]),
      spx_profileAux_one]
    have := spx_profile_branch s (i + 1)
    rw [spx_profile_node (by simp), WithBot.coe_inj] at this
    rw [this]; rfl

theorem spx_seed_zero_entryAt (e : EntryAddr) : (seed 0).entryAt e = none := by
  obtain ⟨⟨P, j⟩, i⟩ := e
  cases P with
  | nil =>
    simp only [seed, Tree.entryAt, Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols]
    cases j <;> simp
  | cons x P =>
    obtain ⟨a, b⟩ := x
    rw [seed, Tree.entryAt, Tree.colAt_cons]
    cases a <;> simp [Tree.cols]

theorem spx_empty_entryAddrs : (Tree.empty : Forest).entryAddrs = [] := rfl
theorem spx_empty_colAddrs : (Tree.empty : Forest).colAddrs = [] := rfl

-- T3.2v (txt:412-413): seeds lie in L and satisfy P (`seed_condP` is stated first: the proof
-- of `seed_inL` gets S from P by L3.1a)
theorem seed_condP (m : Nat) : CondP (seed m) := by
  intro e0 he0 e he hret
  obtain ⟨-, q, J, hJ, hres⟩ := hret
  cases m with
  | zero => exact absurd hJ (by rw [spx_seed_zero_entryAt]; simp)
  | succ m =>
    obtain ⟨x0, hx0⟩ := Option.isSome_iff_exists.1 ((Tree.mem_entryAddrs_iff _ e0).1 he0)
    obtain ⟨q0, H0⟩ := x0
    obtain ⟨l0, hl0, -, hn0, -, rfl⟩ := spx_seed_entryAt m e0 q0 H0 hx0
    obtain ⟨l1, hl1, -, -, hq1, hJ1⟩ := spx_seed_entryAt m e q J hJ
    have hq : e0.col.num 0 = l1 := hq1 ▸ ColAddr.resolve_num hres
    rw [Tree.heightAt, Tree.heightAt, hJ, hx0, hJ1]
    simp only [Option.map_some, Option.getD_some]
    have hm : m - l0 = m - l1 + 1 := by omega
    rw [hm]
    simp only [spxSeedH, Nat.add_one_ne_zero, if_false, Nat.add_sub_cancel]
    rw [show l0 + 1 = l1 by omega, spx_profile_branch]
    by_cases hs : m - l1 = 0
    · simp only [hs, if_true]; exact WithBot.bot_lt_coe _
    · rw [if_neg hs, spx_profile_branch]
      exact WithBot.coe_lt_coe.2 (Prod.Lex.toLex_lt_toLex.2 (Or.inl (by simp; omega)))

theorem seed_inL (m : Nat) : InL (seed m) := by
  have hV : CondV (seed m) := by
    rw [condV_iff_lt]
    intro e _ q h he
    cases m with
    | zero => rw [spx_seed_zero_entryAt] at he; cases he
    | succ m =>
      obtain ⟨l, -, -, hn, rfl, -⟩ := spx_seed_entryAt m e q h he
      omega
  have hI : CondI (seed m) := by
    intro e _ q h he hne col hcol
    cases m with
    | zero => rw [spx_seed_zero_entryAt] at he; cases he
    | succ m =>
      obtain ⟨l, -, -, hn, -, rfl⟩ := spx_seed_entryAt m e q _ he
      unfold spxSeedH at hne hcol
      split_ifs at hne hcol with hs
      · exact absurd rfl hne
      · simp only [Tree.cols, List.mem_singleton] at hcol
        subst hcol
        rw [spx_branch]
        exact ⟨l + 1, _, [], rfl, by omega⟩
  have hH : CondH (seed m) := by
    intro c hc i x y hx hy
    obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff _ c).1 hc)
    rw [hcol, Option.getD_some] at hx hy
    cases m with
    | zero =>
      have he : (seed 0).entryAt ⟨c, i⟩ = some x := by rw [Tree.entryAt, hcol]; exact hx
      rw [spx_seed_zero_entryAt] at he; cases he
    | succ m =>
      rcases spx_seed_colAt m c col hcol with ⟨-, rfl⟩ | ⟨l, -, -, rfl⟩
      · simp at hx
      · rw [spx_branch] at hy; simp at hy
  have hA : CondA (seed m) := by
    intro c _ i p hp
    rw [parents_getElem?] at hp
    obtain ⟨⟨q, h⟩, he, rfl⟩ := Option.map_eq_some_iff.1 hp
    cases m with
    | zero => rw [spx_seed_zero_entryAt] at he; cases he
    | succ m =>
      obtain ⟨l, -, hi, hn, rfl, -⟩ := spx_seed_entryAt m ⟨c, i⟩ q h he
      simp only at hi hn
      subst hi
      simp only [if_true, hn, Nat.add_sub_cancel]
      exact Relation.ReflTransGen.refl
  exact ⟨hV, hI, hH, hA, condS_of_condP hV hI hH (seed_condP m)⟩

-- T3.2w: the empty forest lies in L and satisfies P
theorem inL_empty : InL Tree.empty := by
  refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;> intro c hc <;> simp [spx_empty_entryAddrs, spx_empty_colAddrs] at hc

theorem condP_empty : CondP Tree.empty := by
  intro e0 he0; simp [spx_empty_entryAddrs] at he0


/-! ### T3.2 — the closure theorem

The six spine contracts of T3.2 below were moved here from `Plan/Spine.lean` (brief rule 5,
branch D3): their proofs use the T3.2 sub-lemmas of this section; nothing in between used them. -/

/-- The output of a loop step lies below the previous phase's stopping column (only the parents
of `U` are used). -/
theorem ordStep_lt_D3 {sd : StopData} {rd : RootData} {F : Forest} {U : Column} {k : Nat}
    {Z : Forest} (hUr : ∀ x ∈ U, x.1 < sd.r) :
    ordStep sd rd F U k Z <
      .node [Tree.mapCol (shiftVal sd.r ((k - 1) * (sd.t - sd.r))) (sd.Q ++ [(sd.r, Tree.empty)])] := by
  have hmapQ : Tree.mapCol (shiftVal sd.r ((k - 1) * (sd.t - sd.r))) (sd.Q ++ [(sd.r, Tree.empty)]) =
      Tree.mapCol (shiftVal sd.r ((k - 1) * (sd.t - sd.r))) sd.Q ++
        [(shiftVal sd.r ((k - 1) * (sd.t - sd.r)) sd.r, Tree.empty)] := by
    simp [treeMapCol_eq_map, Tree.map, Tree.mapCols, Tree.empty]
  have hρ : sd.r ≤ shiftVal sd.r ((k - 1) * (sd.t - sd.r)) sd.r := le_shiftVal_D3 _ _ _
  unfold ordStep
  simp only
  rw [hmapQ]
  split
  · rw [List.append_assoc]
    refine head_lt_D3 (rest := []) (fun v hv => lt_of_lt_of_le ?_ hρ)
    have e := mapLast_eq (fun x : Nat × Forest => (x.1, shift sd.r (k * (sd.t - sd.r)) x.2))
      (fun x : Nat × Forest => (x.1, Hole.fill ⟨x.2, sd.depth - rd.layer - 1⟩ sd.r
        (k * (sd.t - sd.r)) Z)) U
    rw [← e] at hv
    cases hU0 : U.head? with
    | none =>
      cases U with
      | nil => simp [mapLast] at hv
      | cons _ _ => simp at hU0
    | some u0 =>
      obtain ⟨y, hy, hyu⟩ := head_mapLast_fst_D3
        (fun x : Nat × Forest => (x.1, shift sd.r (k * (sd.t - sd.r)) x.2))
        (fun x : Nat × Forest => (x.1, Hole.fill ⟨x.2, sd.depth - rd.layer - 1⟩ sd.r
          (k * (sd.t - sd.r)) Z)) (fun _ => rfl) (fun _ => rfl) u0 hU0
      rw [hy] at hv; cases hv
      rw [hyu]; exact hUr u0 (List.mem_of_head? hU0)
  · refine head_lt_D3 (fun v hv => lt_of_lt_of_le ?_ hρ)
    cases U with
    | nil => simp at hv
    | cons u us => simp at hv; subst hv; exact hUr u (by simp)

theorem ordZ_lt_D3 {A : Forest} {sd : StopData} {rd : RootData} (hV : CondV A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) (n : Nat) :
    ordZ A sd rd n < .node [sd.Q ++ [(sd.r, Tree.empty)]] := by
  obtain ⟨-, -, hU, -, -⟩ := ord_vdata_D3 hV hsd hrd
  have := ordLoop_induct_D3 (step := ordStep sd rd ((A.forestAt rd.col.path).getD Tree.empty)
      (((A.colAt rd.col).getD []).drop rd.cursor))
    (P := fun k Z => Z <
      .node [Tree.mapCol (shiftVal sd.r (k * (sd.t - sd.r))) (sd.Q ++ [(sd.r, Tree.empty)])]) ?_ n
    Tree.empty (Forest.empty_lt (by simp [Tree.empty]))
  · simpa [ordZ, shiftVal_zero_fun, treeMapCol_id_fun] using this
  · intro k Z _ _
    exact ordStep_lt_D3 (fun x hx => (hU x hx).1)

/-- The special output is below the input: the owner column `P ⌢ [(p, C ⌢ [[(a,∅)]])]` becomes
`P ⌢ [(p, C)]^m`. -/
theorem special_col_lt_D3 (P : Column) (p : Nat) (Fl : Forest) (hFl : Fl.cols ≠ []) (m : Nat) :
    (Tree.node [P ++ List.replicate m (p, Tree.node Fl.cols.dropLast)] : Forest) <
      .node [P ++ [(p, Fl)]] := by
  show Tree.cmp compare _ _ = .lt
  simp only [Tree.cmp, Tree.cmpCols, cmpCol_append_left_D3]
  cases m with
  | zero => rfl
  | succ m =>
    rw [List.replicate_succ]
    simp only [Tree.cmpCol]
    rw [show compare p p = Ordering.eq from compare_eq_iff_eq.2 rfl]
    obtain ⟨fc⟩ := Fl
    have hc : Tree.cmp compare (Tree.node fc.dropLast : Forest) (Tree.node fc) = .lt := by
      simp only [Tree.cmp, Tree.cols] at hFl ⊢
      conv => rhs; skip
      have := cmpCols_append_left_D3 fc.dropLast [] [fc.getLast hFl]
      rw [List.append_nil, List.dropLast_append_getLast hFl] at this
      rw [this]; rfl
    have e : (Tree.node fc).cols = fc := rfl
    rw [e, hc]; rfl

-- provides: U2, T3.2
theorem inL_safePrefix {E : Forest} (hE : Scan.InL E) (k : Nat) :
    Scan.InL (Scan.safePrefix E k) :=
  ⟨safePrefix_condV hE.1 k, safePrefix_condI hE.2.1 k, safePrefix_condH hE.2.2.1 k,
    safePrefix_condA hE k, safePrefix_condS hE.1 hE.2.2.2.2 k⟩

-- provides: U2, T3.2
theorem inL_expand {E E' : Forest} {n : Nat} (hE : Scan.InL E) (h : expand E n = some E') :
    Scan.InL E' := by
  by_cases hE0 : E = Tree.empty
  · subst hE0; rw [expand_empty] at h; cases h; exact inL_empty
  obtain ⟨k, hk⟩ := Option.isSome_iff_exists.1 (stepKind_isSome hE0 hE.1 hE.2.1)
  cases k with
  | deletion =>
    obtain ⟨j, -, rfl⟩ := expand_safePrefix hE0 hE.1 hE.2.1 (Or.inl hk) h
    exact inL_safePrefix hE j
  | special =>
    obtain ⟨hV, hI, hH⟩ := condVIH_special hE hk h
    exact ⟨hV, hI, hH, condA_special hE hk h, condS_special hE hk h⟩
  | ordinary =>
    exact ⟨condV_ord hE hk h, condI_ord hE hk h, condH_ord hE hk h, condA_ord hE hk h,
      condS_ord hE hk h⟩

-- provides: U2, T3.2 (P is preserved when present, S-6)
theorem condP_expand {E E' : Forest} {n : Nat} (hE : Scan.InL E) (hP : CondP E)
    (h : expand E n = some E') : CondP E' := by
  by_cases hE0 : E = Tree.empty
  · subst hE0; rw [expand_empty] at h; cases h; exact condP_empty
  obtain ⟨k, hk⟩ := Option.isSome_iff_exists.1 (stepKind_isSome hE0 hE.1 hE.2.1)
  cases k with
  | deletion =>
    obtain ⟨j, -, rfl⟩ := expand_safePrefix hE0 hE.1 hE.2.1 (Or.inl hk) h
    exact safePrefix_condP hE hP j
  | special => exact condP_special hE hP hk h
  | ordinary => exact condP_ord hE hP hk h

-- provides: U2, T3.2
theorem std_inL {E : Forest} (h : IsStd E) : Scan.InL E := by
  induction h with
  | seed m => exact seed_inL m
  | expand n _ hexp ih => exact inL_expand ih hexp

-- provides: U2, T3.2
theorem std_condP {E : Forest} (h : IsStd E) : CondP E := by
  induction h with
  | seed m => exact seed_condP m
  | expand n hstd hexp ih => exact condP_expand (std_inL hstd) ih hexp

-- provides: U2, T3.2 (strict decrease; the paper's statement asks only V, I)
theorem expand_lt {E E' : Forest} {n : Nat} (hE : E ≠ Tree.empty) (hV : Scan.CondV E)
    (hI : Scan.CondI E) (h : expand E n = some E') : E' < E := by
  obtain ⟨k, hk⟩ := Option.isSome_iff_exists.1 (stepKind_isSome hE hV hI)
  cases k with
  | deletion =>
    rw [expand_deletion hk] at h
    cases h
    obtain ⟨cs, hcs⟩ := List.getLast?_eq_some_iff.1 ((stepKind_deletion_iff E).1 hk)
    obtain ⟨cols⟩ := E
    simp only [Tree.cols] at hcs ⊢
    subst hcs
    show Tree.cmp compare _ _ = .lt
    simp only [Tree.cmp, List.dropLast_concat]
    have := cmpCols_append_left_D3 cs [] [[]]
    rw [List.append_nil] at this
    rw [this]; rfl
  | special =>
    obtain ⟨sd, hsd⟩ := Option.isSome_iff_exists.mp (stopData_of_stepKind hk (by decide))
    obtain ⟨sd', hsd', hs⟩ := (stepKind_special_iff E).mp hk
    rw [hsd] at hsd'; cases hsd'
    have hpos : 0 < sd.depth := by
      simp only [specialStop, Bool.and_eq_true, decide_eq_true_eq] at hs; exact hs.1.1
    obtain ⟨oe, col, p0, hoe, -, hcol, hlastc, -⟩ := ownerEntry_data hsd hpos
    obtain ⟨-, -, -, col', p, Fl, hcol', hlast, -, hFl⟩ := ownerEntry_spec hk hsd hoe
    rw [hcol] at hcol'; cases hcol'
    rw [expand_eq_paperOp hE hV hI, paperOp_special hk hsd hoe hcol hlast] at h
    cases h
    obtain ⟨hR, -⟩ := stop_route_top_D3 hsd
    have hR' : RouteOK_D3 (sd.depth - 1) E := routeOK_le_D3 _ _ _ hR (by omega)
    have hrc : routeCol_D3 (sd.depth - 1) E = col := by simp [routeCol_D3, hlastc]
    rw [Hole.fill_eq_put, shift_zero]
    refine put_lt_D3 hR' ?_
    rw [hrc]
    obtain ⟨P, rfl⟩ := List.getLast?_eq_some_iff.1 hlast
    rw [List.dropLast_concat]
    exact special_col_lt_D3 P p Fl (by intro he; rw [he] at hFl; simp at hFl) _
  | ordinary =>
    obtain ⟨sd, hsd⟩ := Option.isSome_iff_exists.mp (stopData_of_stepKind hk (by decide))
    obtain ⟨rd, hrd⟩ := Option.isSome_iff_exists.mp (rootData_of_ordinary hk)
    rw [expand_eq_paperOp hE hV hI, paperOp_ordinary hk hsd hrd] at h
    split at h
    · cases h
    · cases h
      obtain ⟨hR, -⟩ := stop_route_top_D3 hsd
      obtain ⟨-, -, -, h4, -⟩ := stopData_core hsd
      have hrc : routeCol_D3 sd.depth E = sd.Q ++ [(sd.r, Tree.empty)] := by
        simp [routeCol_D3, h4]
      show replaceAt 0 0 _ sd.depth E < E
      refine put_lt_D3 hR ?_
      rw [hrc]; exact ordZ_lt_D3 hV hsd hrd n

/-! ## §T3.8 — cofinality -/

/-- T3.8n: cofinality with target `B` (the statement of T3.8 for one fixed target). -/
def Cof (B : Forest) : Prop :=
  ∀ E, InL E → B < E → ∃ n E', expand E n = some E' ∧ B ≤ E' ∧ E' < E

/-- T3.8n: kernel success for every upward literal `L` cap of `B`, in the covering form. -/
def KS (B : Forest) : Prop :=
  ∀ c k p, IsUpward B c k p → InL (litCap B c k p) → Covers (litCap B c k p) B

/-- L3.6: the conclusion of cap completion for target `B` (caps with V, I, decorated A). -/
def CC (B : Forest) : Prop :=
  ∀ c k p, IsUpward B c k p → CondV (litCap B c k p) → CondI (litCap B c k p) →
    CondAK (litCap B c k p) (capKeys (litCap B c k p) (routeCols (litCap B c k p))) →
    Success (litCap B c k p) (localSuffix B c)

-- T3.8a (txt:493): an empty last column is the least column
theorem le_of_lt_append_empty {B F : Forest} (h : B < Tree.node (F.cols ++ [[]])) : B ≤ F := by sorry

-- T3.8b: approximants strictly increase
theorem expand_strictMono {E X Y : Forest} {n n' : Nat} (hL : InL E)
    (hlast : E.cols.getLast? ≠ some []) (hE : E ≠ Tree.empty) (hnn : n < n')
    (hX : expand E n = some X) (hY : expand E n' = some Y) : X < Y := by sorry

-- T3.8c: stop data of a literal cap
theorem stopData_litCap {B : Forest} {c : ColAddr} {k p : Nat} (hup : IsUpward B c k p) :
    stopData (litCap B c k p) =
      some ⟨colDepth c, c, c.num 0, p, ((B.colAt c).getD []).take k⟩ := by sorry

-- T3.8c (txt:539-540): an upward cap of an I-expression that satisfies V and I is ordinary
theorem litCap_ordinary {B : Forest} (hI : CondI B) {c : ColAddr} {k p : Nat}
    (hup : IsUpward B c k p) (hKV : CondV (litCap B c k p)) (hKI : CondI (litCap B c k p)) :
    stepKind (litCap B c k p) = some .ordinary := by sorry

-- T3.8c: the approximant at `0` of a cap lies strictly below its target
-- VERIFY-U2 (F6): `hI` added (the doc's proof uses part 2, which needs I of `B`)
theorem expand_zero_litCap_lt {B : Forest} (hI : CondI B) {c : ColAddr} {k p : Nat}
    (hup : IsUpward B c k p)
    (hKV : CondV (litCap B c k p)) (hKI : CondI (litCap B c k p)) {K0 : Forest}
    (h0 : expand (litCap B c k p) 0 = some K0) : K0 < B := by sorry

-- N2.2: the word of `B` at a column: context prefix, local suffix at depth `e`, shallower rest
theorem word_localSuffix {B : Forest} {c : ColAddr} (hc : c ∈ B.colAddrs) :
    ∃ S, word B = (word B).take (capPos B c 0) ++ (word (localSuffix B c)).map (depthShift (colDepth c)) ++ S ∧
      ∀ y ∈ S.head?, (ofLex y).1 < 2 * colDepth c := by sorry

-- N2.2: filling a cap with its complete local suffix restores the target up to the end of the
-- cap column's forest (all of the target when that forest is on the target's route)
theorem context_litCap_localSuffix {B : Forest} {c : ColAddr} {k p : Nat} (hup : IsUpward B c k p)
    {sd : StopData} (hsd : stopData (litCap B c k p) = some sd) :
    context (litCap B c k p) sd (localSuffix B c) =
      safePrefix B (capPos B c 0 + mu (localSuffix B c)) := by sorry

-- T3.8d (txt:496-499): between `E[1]` and `E`, `E` is an upward literal cap of the target
theorem ordinary_cap_of_between {E B E1 : Forest} {sd : StopData} (hL : InL E)
    (hk : stepKind E = some .ordinary) (hsd : stopData E = some sd) (h1 : expand E 1 = some E1)
    (hlo : E1 < B) (hhi : B < E) :
    IsUpward B sd.col sd.Q.length sd.r ∧ litCap B sd.col sd.Q.length sd.r = E := by sorry

-- T3.8e (txt:500-503): special steps cover within the bound
theorem special_cover {E B : Forest} (hL : InL E) (hB : InL B) (hk : stepKind E = some .special)
    (hlt : B < E) : ∃ n E', 1 ≤ n ∧ n ≤ mu B + 1 ∧ expand E n = some E' ∧ B < E' := by sorry

-- T3.8f: covering is kernel success at the complete local suffix (word criterion + context)
theorem covers_iff_success {B : Forest} {c : ColAddr} {k p : Nat} (hB : CondI B)
    (hup : IsUpward B c k p) (hKV : CondV (litCap B c k p)) (hKI : CondI (litCap B c k p))
    (hdef : ∀ rd, rootData (litCap B c k p) = some rd → KernelDefined (litCap B c k p) rd) :
    Covers (litCap B c k p) B ↔ Success (litCap B c k p) (localSuffix B c) := by sorry

-- T3.8f: the explicit bound
theorem covers_bound {B : Forest} {c : ColAddr} {k p : Nat} (hB : CondI B)
    (hup : IsUpward B c k p) (hKL : InL (litCap B c k p))
    (h : Success (litCap B c k p) (localSuffix B c)) :
    ∃ q K', 1 ≤ q ∧ q ≤ mu B + 1 ∧ expand (litCap B c k p) q = some K' ∧ B < K' := by sorry

-- L3.4f (txt:428-429, 436-437): a full cut at the end of the target succeeds
theorem fullCut_success {B : Forest} {c : ColAddr} {k p : Nat} (hup : IsUpward B c k p)
    (hKL : InL (litCap B c k p)) (hend : capPos B c k = mu B) :
    Success (litCap B c k p) (localSuffix B c) := by sorry

-- T3.8h (txt:511-512): a cap above a covered old target is covered
theorem covers_of_gt {A B K : Forest} (hcof : Cof A) (hKL : InL K) (hKne : K ≠ Tree.empty)
    (hlast : K.cols.getLast? ≠ some []) (hAK : A < K) (hBA : B ≤ A)
    (hK0 : ∀ K0, expand K 0 = some K0 → K0 < B) : Covers K B := by sorry

-- T3.8g: kernel success for all caps gives cofinality with the bound
theorem cof_of_KS {B : Forest} (hB : InL B) (hKS : KS B) : Cof B := by sorry
theorem bound_of_KS {B E : Forest} (hB : InL B) (hKS : KS B) (hE : InL E) (hlt : B < E)
    (hlast : E.cols.getLast? ≠ some []) :
    ∃ n E', 1 ≤ n ∧ n ≤ mu B + 1 ∧ expand E n = some E' ∧ B < E' := by sorry

-- L3.6a (txt:463-465): reversing one repair: the complete old suffixes compare `Y_i ≥ Y_j`
theorem repair_suffix_ge {B : Forest} (hH : CondH B) {cj ci : ColAddr} {k p : Nat}
    (hj : IsUpward B cj k p) (hi : IsUpward B ci k p)
    (hmove : ∃ m, MoveOK (litCap B cj k p) m ∧ applyMove (litCap B cj k p) m = litCap B ci k p) :
    localSuffix B cj ≤ localSuffix B ci := by sorry

-- L3.6b (txt:466-481): success transfers backward through one legal move
-- VERIFY-U2 (F5): `hP` added; step 1 gets S of the cap from L3.1e, which needs P of `B`
theorem success_unmove {B : Forest} (hL : InL B) (hP : CondP B) {cj ci : ColAddr} {k p : Nat}
    (hj : IsUpward B cj k p) (hi : IsUpward B ci k p)
    (hjV : CondV (litCap B cj k p)) (hjI : CondI (litCap B cj k p))
    (hjA : CondAK (litCap B cj k p) (capKeys (litCap B cj k p) (routeCols (litCap B cj k p))))
    (hmove : ∃ m, MoveOK (litCap B cj k p) m ∧ applyMove (litCap B cj k p) m = litCap B ci k p)
    (hsucc : Success (litCap B ci k p) (localSuffix B ci)) :
    Success (litCap B cj k p) (localSuffix B cj) := by sorry

-- provides: U2, L3.6 (txt:459-481): cap completion
theorem cap_completion {B : Forest} (hL : InL B) (hP : CondP B) (hcof : Cof B) : CC B := by sorry

-- T3.8i (txt:505): seeds
theorem KS_seed (m : Nat) : KS (seed m) := by sorry

-- T3.8j (txt:505-506): safe prefixes of a covered target
theorem KS_safePrefix {A : Forest} (hA : InL A) (hcof : Cof A) (k : Nat) : KS (safePrefix A k) := by
  sorry

-- T3.8k (txt:506-510): special outputs
theorem KS_special {A B : Forest} {n : Nat} (hA : InL A) (hcof : Cof A)
    (hk : stepKind A = some .special) (hB : expand A n = some B) : KS B := by sorry

/-- T3.8l (txt:511-643): the setting of the ordinary induction step. -/
structure OrdStep where
  A : Forest
  sd : StopData
  rd : RootData
  n : Nat
  B : Forest
  std : IsStd A
  inL : InL A
  condP : CondP A
  cof : Cof A
  kind : stepKind A = some .ordinary
  hsd : stopData A = some sd
  hrd : rootData A = some rd
  pos : 1 ≤ n
  out : expand A n = some B

namespace OrdStep

variable (S : OrdStep)

/-- The period `d`. -/
def d : Nat := period S.sd
/-- `s_i = r + i d`, the number of the head of layer `i`. -/
def s (i : Nat) : Nat := S.sd.r + i * S.d
/-- `m = |Q|`. -/
def m : Nat := S.sd.Q.length
/-- `τ_i = T_{r, i d}`. -/
def tau (i : Nat) (F : Forest) : Forest := shift S.sd.r (i * S.d) F
/-- The projection of a selected root of phase `φ` (txt:521-524); only used outside `(r, s_φ)`. -/
def proj (φ ρ : Nat) : Nat := if S.s φ < ρ then ρ - φ * S.d else if ρ = S.s φ then S.sd.r else ρ

end OrdStep

-- T3.8la (txt:511-519): where a cap not above `A` and not at the end of `B` can sit
theorem cut_location (S : OrdStep) {c : ColAddr} {k ρ : Nat} (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hle : ¬ S.A < litCap S.B c k ρ)
    (hend : capPos S.B c k < mu S.B) :
    (c = S.sd.col ∧ S.m ≤ k) ∨
      (∃ i, 2 ≤ i ∧ i ≤ S.n ∧ phaseCol S.sd S.rd i S.rd.col = some c) ∨
      (∃ i a, 1 ≤ i ∧ i ≤ S.n ∧ IsTmplCol S.A S.sd S.rd a ∧ (isQMat S.sd a = true → 2 ≤ i) ∧
        phaseCol S.sd S.rd i a = some c) := by sorry

-- T3.8lb (txt:607-608, with the method of T3.8li): the old terminal cap of a head-query cut
theorem headQuery_oldCap (S : OrdStep) {i : Nat} {c : ColAddr} {k ρ : Nat} (hi : 2 ≤ i ∧ i ≤ S.n)
    (hc : phaseCol S.sd S.rd i S.rd.col = some c) (hk : k < S.m ∨ (k = S.m ∧ S.s (i - 1) < ρ))
    (hup : IsUpward S.B c k ρ) (hKL : InL (litCap S.B c k ρ)) :
    let K' := litCap S.A S.sd.col k (ρ - (i - 1) * S.d)
    S.s (i - 1) < ρ ∧ IsUpward S.A S.sd.col k (ρ - (i - 1) * S.d) ∧ CondV K' ∧ CondI K' ∧
      CondAK K' (capKeys K' (routeCols K')) := by sorry

-- T3.8lc (txt:607-611): query-part cuts of head `i ≥ 2`
theorem headQuery_cut (S : OrdStep) {i : Nat} {c : ColAddr} {k ρ : Nat} (hi : 2 ≤ i ∧ i ≤ S.n)
    (hc : phaseCol S.sd S.rd i S.rd.col = some c) (hk : k < S.m ∨ (k = S.m ∧ S.s (i - 1) < ρ))
    (hup : IsUpward S.B c k ρ) (hKL : InL (litCap S.B c k ρ)) :
    Covers (litCap S.B c k ρ) S.B := by sorry

-- T3.8ld (txt:613-617): the seam: the cap at `s_{i−1}` is `A` advanced by `i − 1` periods
theorem expand_seam (S : OrdStep) {i : Nat} {c : ColAddr} (hi : 1 ≤ i ∧ i ≤ S.n)
    (hc : phaseCol S.sd S.rd i S.rd.col = some c) (q : Nat) :
    expand (litCap S.B c S.m (S.s (i - 1))) q = expand S.A (i - 1 + q) := by sorry

-- T3.8le (txt:617-620): no closing parent below `s_{i−1}` is an upward `L` cap at `k = m`
theorem seam_parent (S : OrdStep) {i : Nat} {c : ColAddr} {ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (hc : phaseCol S.sd S.rd i S.rd.col = some c) (hup : IsUpward S.B c S.m ρ)
    (hKL : InL (litCap S.B c S.m ρ)) : S.s (i - 1) ≤ ρ := by sorry

-- T3.8lf (txt:623-624): restored-suffix cuts force `ρ < r`
theorem restored_parent (S : OrdStep) {i : Nat} {c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (hc : phaseCol S.sd S.rd i S.rd.col = some c) (hk : S.m < k) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) : ρ < S.sd.r := by sorry

-- T3.8lg (txt:624-626): the old root cap after `w = c + v` entries has V, I, decorated A
theorem restored_oldCap (S : OrdStep) {i : Nat} {c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (hc : phaseCol S.sd S.rd i S.rd.col = some c) (hk : S.m < k) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hend : capPos S.B c k < mu S.B) :
    let K' := litCap S.A S.rd.col (S.rd.cursor + (k - S.m)) ρ
    IsUpward S.A S.rd.col (S.rd.cursor + (k - S.m)) ρ ∧ CondV K' ∧ CondI K' ∧
      CondAK K' (capKeys K' (routeCols K')) := by sorry

-- T3.8lh (txt:621-640): restored-suffix cuts succeed (remainders (5), delayed change)
theorem restored_cut (S : OrdStep) {i : Nat} {c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (hc : phaseCol S.sd S.rd i S.rd.col = some c) (hk : S.m < k) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hend : capPos S.B c k < mu S.B)
    (hold : Success (litCap S.A S.rd.col (S.rd.cursor + (k - S.m)) ρ) (localSuffix S.A S.rd.col)) :
    Success (litCap S.B c k ρ) (localSuffix S.B c) := by sorry

-- T3.8li (txt:520-541): projection of a material cut to an old cap
theorem projection (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hend : capPos S.B c k < mu S.B)
    (hρ : ρ ≤ S.sd.r ∨ S.s (phaseOff S.sd i a) ≤ ρ) :
    let K' := litCap S.A a k (S.proj (phaseOff S.sd i a) ρ)
    IsUpward S.A a k (S.proj (phaseOff S.sd i a) ρ) ∧ CondV K' ∧ CondI K' ∧
      CondAK K' (capKeys K' (routeCols K')) := by sorry

-- T3.8lj (txt:542-546): proper current root `ρ > s_φ`: conjugate kernels, downward success
theorem root_current (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hend : capPos S.B c k < mu S.B)
    (hρ : S.s (phaseOff S.sd i a) < ρ)
    (hold : Success (litCap S.A a k (ρ - phaseOff S.sd i a * S.d)) (localSuffix S.A a)) :
    Success (litCap S.B c k ρ) (localSuffix S.B c) := by sorry

-- T3.8lk (txt:547-552): current head root `ρ = s_φ`: high scans conjugate, low scans win
theorem root_head (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hend : capPos S.B c k < mu S.B)
    (hρ : ρ = S.s (phaseOff S.sd i a))
    (hold : Success (litCap S.A a k S.sd.r) (localSuffix S.A a)) :
    Success (litCap S.B c k ρ) (localSuffix S.B c) := by sorry

-- T3.8ll (txt:551-552, 560-561): "wins at once": the first unconsumed root entry beats the next
-- target entry
theorem success_of_first {K Y : Forest} {sd : StopData} {rd : RootData}
    (hsd : stopData K = some sd) (hrd : rootData K = some rd) (hdef : KernelDefined K rd)
    {rest : Column} {more : List Column} (hY : Y = .node ((sd.Q ++ rest) :: more))
    {u : Nat × Forest} {us : Column} (hU : unconsumed K rd = u :: us)
    (hbeat : ∀ x ∈ rest.head?, x.1 < u.1) : Success K Y := by sorry

-- T3.8lm (txt:555-559): sign independence of a fixed phase-`φ` key against the phase-`h` images
-- of a key normalized at the old terminal `t = r + d`, for every `h < φ`
theorem sign_indep {r d φ h h' : Nat} (hh : h < φ) (hh' : h' < φ) (w : Key) (J : Forest) :
    keyCmp (kappa r d φ w) (kappa r d h (relKey (r + d) J)) =
      keyCmp (kappa r d φ w) (kappa r d h' (relKey (r + d) J)) := by sorry

-- T3.8lm: the same for reduced queries (lists of keys), hence for "low/high" at every head
theorem sign_indep_list {r d φ h h' : Nat} (hh : h < φ) (hh' : h' < φ) (W : List Key)
    (Js : List Forest) :
    (W.map (kappa r d φ) < (Js.map (relKey (r + d))).map (kappa r d h) ↔
      W.map (kappa r d φ) < (Js.map (relKey (r + d))).map (kappa r d h')) := by sorry

-- T3.8ln (txt:530, 549-551; moved here from after T3.8lo, used by G9.8a `phase_exit`): parents of phase-`φ` material are `< r` or `≥ s_φ`
theorem phase_parent_dichotomy (S : OrdStep) {i : Nat} {a c : ColAddr} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hc : phaseCol S.sd S.rd i a = some c) {x : Nat × Forest}
    (hx : x ∈ (S.B.colAt c).getD []) : x.1 < S.sd.r ∨ S.s (phaseOff S.sd i a) ≤ x.1 := by sorry

/-! ## G-009 helpers for T3.8lo (from `blueprint/repairs/lean/G009.lean`)

The low-head detour invariant behind T3.8lo (`blueprint/repairs/G-009.md`). Notation:
`r = S.sd.r`, `t = S.sd.t`, `d = S.d`, `m = S.m`, `s_h = S.s h`, `φ = phaseOff S.sd i a`,
`K = litCap S.B c k ρ`, `V = S.capQ c k ρ`, `Z = S.termZ`. -/

/-! ## G9.0 — definitions -/

/-- G9.0 (= D-G010.2 `kappaQ`, draft name `kappaQry`): `κ_j` on a query of actual keys (a list
of `WithTop Key`), exactly the map applied to queries in `head_path` (T3.2q). -/
def kappaQ (r d φ : Nat) (W : List (WithTop Key)) : List (WithTop Key) :=
  W.map (WithTop.map (kappa r d φ))

namespace OrdStep

variable (S : OrdStep)

/-- G9.0: the old terminal's complete query `Z = B_t(m−1) = ν(y_0,…,y_{m−1})` (txt:381), read in
the actual key system of `A` at the stopping column. -/
def termZ : List (WithTop Key) := cutQuery (actualKeys S.A S.sd.col) S.m

/-- G9.0: the address in `B` of the head `s_h` of layer `h ≥ 1` (`phaseCol h rd.col`). -/
def headCol (h : Nat) : ColAddr := (phaseCol S.sd S.rd h S.rd.col).getD S.rd.col

/-- G9.0: the phase-`h` copy in `B` of a column `o` of `A` on the stopping column's stack: `o`
itself at phase `0` (retained context), `phaseCol h o` at phase `h ≥ 1`. -/
def copyCol (h : Nat) (o : ColAddr) : ColAddr :=
  if h = 0 then o else (phaseCol S.sd S.rd h o).getD o

/-- G9.0: the cut query `V = B_c(k−1)` of the literal cap `K = litCap B c k ρ` at its stopping
column `c` (the query of `K`'s closing A test and of its root scan). -/
def capQ (c : ColAddr) (k ρ : Nat) : List (WithTop Key) :=
  cutQuery (actualKeys (litCap S.B c k ρ) c) k

end OrdStep

/-! ## G9.1, G9.2 — generic scan and path facts -/

section G9Words

variable {α : Type} [LinearOrder α]

-- G9.1: two sources that agree before `u`, scanned by runs that both stop at or before `u`,
-- have the same final cursor
theorem cursor_eq_of_take_eq {s₁ s₂ W : List α} {u : Nat} (htake : s₁.take u = s₂.take u)
    (h₁ : cursor s₁ W ≤ u) (h₂ : cursor s₂ W ≤ u) : cursor s₁ W = cursor s₂ W := by
  have e₁ := cursor_take s₁ W u
  have e₂ := cursor_take s₂ W u
  rw [Nat.min_eq_right h₂] at e₂
  rw [Nat.min_eq_right h₁, htake, e₂] at e₁
  exact e₁.symm

-- G9.2a: a query strictly below the full boundary of the first `m` keys stops before `m`
theorem cursor_lt_of_lt_cutQuery {ks W : List α} (hW : Noninc W) {m : Nat} (hm : m ≤ ks.length)
    (h : W < cutQuery ks m) : cursor ks W < m := by
  rcases m with _ | v
  · rw [cutQuery_zero] at h
    exact absurd h (List.not_lt_nil _)
  · exact Nat.lt_succ_of_le (cursor_le_of_lt_cutQuery hW (by omega) h)

-- G9.2b: conversely, a run that stops before `m` has its query strictly below that boundary
theorem lt_cutQuery_of_cursor_lt {ks W : List α} (hW : Noninc W) {m : Nat} (hm : m ≤ ks.length)
    (h : cursor ks W < m) : W < cutQuery ks m := by
  by_contra hn
  have := le_cursor_of_cutQuery_le hW hm (not_lt.mp hn)
  omega

-- G9.2c: `ν(l)` is a sublist of `l`
theorem nu_sublist (l : List α) : (nu l).Sublist l := by
  rw [nu_eq_foldl]
  suffices H : ∀ (l acc pre : List α), acc.Sublist pre → (l.foldl nuStep acc).Sublist (pre ++ l) by
    simpa using H l [] [] (List.Sublist.refl _)
  intro l
  induction l with
  | nil => intro acc pre h; simpa using h
  | cons x xs ih =>
    intro acc pre h
    rw [List.foldl_cons]
    have hstep : (nuStep acc x).Sublist (pre ++ [x]) := by
      unfold nuStep
      refine List.Sublist.append ?_ (List.Sublist.refl _)
      refine List.Sublist.trans ?_ h
      have := (List.dropWhile_sublist (l := acc.reverse) (fun y => decide (y < x))).reverse
      simpa using this
    simpa using ih _ _ hstep

end G9Words

-- G9.2d: `κ_j` on `WithTop Key` is strictly increasing
theorem kappaQry_strictMono (r d j : Nat) : StrictMono (WithTop.map (kappa r d j)) :=
  WithTop.strictMono_map_iff.mpr (kappa_strictMono r d j)

-- G9.2d (helper): `κ_i ∘ κ_j = κ_{i+j}` on queries (T3.2h.2 `kappa_add`, pointwise)
theorem kappaQ_add (r d i j : Nat) (W : List (WithTop Key)) :
    kappaQ r d i (kappaQ r d j W) = kappaQ r d (i + j) W := by
  unfold kappaQ
  rw [List.map_map]
  congr 1
  funext x
  cases x with
  | top => rfl
  | coe x => simp only [Function.comp_apply, WithTop.map_coe, kappa_add]

-- G9.2d (helper): `κ_j` keeps queries reduced
theorem kappaQ_noninc (r d j : Nat) {W : List (WithTop Key)} (hW : Noninc W) :
    Noninc (kappaQ r d j W) :=
  List.Pairwise.map _ (fun _ _ h => (kappaQry_strictMono r d j).monotone h) hW

-- G9.2d (helper): `κ_j` reflects and preserves the order of queries
theorem kappaQ_lt_iff (r d j : Nat) (W Z : List (WithTop Key)) :
    kappaQ r d j W < kappaQ r d j Z ↔ W < Z :=
  list_map_lt_iff ((kappaQry_strictMono r d j).strictMonoOn Set.univ)
    (fun _ _ => Set.mem_univ _) (fun _ _ => Set.mem_univ _)

-- G9.2e: path nesting for whole paths (U1 L2.2 edgewise)
theorem path_nesting_path {E : Forest} {ks : KeySys} (hV : CondV E) (hA : CondAK E ks)
    (c : ColAddr) {W Z : List (WithTop Key)} (hW : Noninc W) (hZ : Noninc Z) (hWZ : W ≤ Z)
    {x y : Nat} (h : Path E ks c Z x y) : Path E ks c W x y := by
  induction h with
  | refl => exact Relation.ReflTransGen.refl
  | tail _ he ih => exact ih.trans (path_nesting hV hA c hW hZ hWZ he)

-- G9.2f: paths are orbits of the partial response function: a path through `y` and a path to a
-- lower `z` from the same start meet, so `z` is reached from `y`
theorem path_functional {E : Forest} (hV : CondV E) {ks : KeySys} {c : ColAddr}
    {W : List (WithTop Key)} {x y z : Nat} (hy : Path E ks c W x y) (hz : Path E ks c W x z)
    (hzy : z ≤ y) : Path E ks c W y z := by
  induction hy using Relation.ReflTransGen.head_induction_on with
  | refl => exact hz
  | @head x x' hxx' hx'y ih =>
    rcases Relation.ReflTransGen.cases_head hz with hxz | ⟨x'', hxx'', hx''z⟩
    · subst hxz
      have h1 := path_le hV hx'y
      have h2 := edge_lt hV hxx'
      omega
    · obtain ⟨o, ho, hr⟩ := hxx'
      obtain ⟨o', ho', hr'⟩ := hxx''
      rw [ho] at ho'
      cases ho'
      rw [hr] at hr'
      cases hr'
      exact ih hx''z

/-! ## G9.3 — the old terminal-to-root path at a low query -/

-- G9.3 (txt:391-392, "path nesting supplies the terminal-to-root path"): at a reduced query
-- `W' < Z` the old terminal answers with a query parent `q_j`, `j = cursor y W' < m`, and `q_j`
-- reaches `r` by a `g_{W'}` path on the stopping column's stack
theorem term_detour (S : OrdStep) {W : List (WithTop Key)} (hW : Noninc W) (hlow : W < S.termZ) :
    cursor (actualKeys S.A S.sd.col) W < S.m ∧
      ∃ q, (parents S.A S.sd.col)[cursor (actualKeys S.A S.sd.col) W]? = some q ∧
        S.sd.r ≤ q ∧ q < S.sd.t ∧ Path S.A (actualKeys S.A) S.sd.col W q S.sd.r := by
  obtain ⟨hcol, -, ht, -⟩ := stopData_spec S.hsd
  have hVA : CondV S.A := S.inL.1
  have hAA : CondA S.A := S.inL.2.2.2.1
  have hlen : (actualKeys S.A S.sd.col).length = S.m + 1 := by
    rw [length_actualKeys, hcol]; simp [OrdStep.m]
  have hpar : parents S.A S.sd.col = S.sd.Q.map Prod.fst ++ [S.sd.r] := by
    simp [parents, hcol]
  have hplen : (parents S.A S.sd.col).length = S.m + 1 := by
    rw [hpar]; simp [OrdStep.m]
  have hj : cursor (actualKeys S.A S.sd.col) W < S.m :=
    cursor_lt_of_lt_cutQuery hW (by omega) hlow
  refine ⟨hj, ?_⟩
  have hmem : S.sd.col ∈ S.A.colAddrs := by rw [Tree.mem_colAddrs_iff, hcol]; rfl
  set j := cursor (actualKeys S.A S.sd.col) W with hjdef
  set P : Nat → Nat := fun l => ((parents S.A S.sd.col)[l]?).getD 0 with hP
  have hPget : ∀ l, l ≤ S.m → (parents S.A S.sd.col)[l]? = some (P l) := by
    intro l hl
    have : l < (parents S.A S.sd.col).length := by omega
    simp [hP, List.getElem?_eq_getElem this]
  have hPm : P S.m = S.sd.r := by
    simp [hP, hpar, OrdStep.m]
  have hWlt : W < cutQuery (actualKeys S.A S.sd.col) (j + 1) :=
    (cursor_spec _ W hW).2 (by omega)
  have hchain : ∀ n, j + n ≤ S.m → Path S.A (actualKeys S.A) S.sd.col W (P j) (P (j + n)) := by
    intro n
    induction n with
    | zero => intro _; exact Relation.ReflTransGen.refl
    | succ n ih =>
      intro hn
      have h1 := ih (by omega)
      have hA := hAA S.sd.col hmem (j + n + 1) (P (j + n + 1)) (hPget _ hn)
      simp only [Nat.add_one_ne_zero, if_false, Nat.add_sub_cancel] at hA
      have hA' : Path S.A (actualKeys S.A) S.sd.col
          (cutQuery (actualKeys S.A S.sd.col) (j + n + 1)) (P (j + n)) (P (j + n + 1)) := hA
      have hle : W ≤ cutQuery (actualKeys S.A S.sd.col) (j + n + 1) :=
        le_of_lt (lt_of_lt_of_le hWlt (cutQuery_mono _ (by omega)))
      have h2 := path_nesting_path hVA hAA S.sd.col hW (cutQuery_noninc _ _) hle hA'
      exact h1.trans h2
  have hqr : Path S.A (actualKeys S.A) S.sd.col W (P j) S.sd.r := by
    have := hchain (S.m - j) (by omega)
    rwa [show j + (S.m - j) = S.m by omega, hPm] at this
  refine ⟨P j, hPget j hj.le, path_le hVA hqr, ?_, hqr⟩
  -- `q < t`: a parent of the stopping column is visible from it (V)
  have hent : S.A.entryAt ⟨S.sd.col, j⟩ = some (P j, (S.sd.Q[j]'(by simp [OrdStep.m] at hj; omega)).2) := by
    have hjQ : j < S.sd.Q.length := by simpa [OrdStep.m] using hj
    have hjQ' : j < (S.sd.Q.map Prod.fst).length := by simpa using hjQ
    have hPj : P j = (S.sd.Q[j]).1 := by
      simp only [hP, hpar, List.getElem?_append_left hjQ', List.getElem?_map,
        List.getElem?_eq_getElem hjQ, Option.map_some, Option.getD_some]
    rw [hPj]
    simp [Tree.entryAt, hcol, List.getElem?_append_left hjQ, hjQ]
    rfl
  have hmemE : (⟨S.sd.col, j⟩ : EntryAddr) ∈ S.A.entryAddrs := by
    rw [Tree.mem_entryAddrs_iff, hent]; rfl
  have := (condV_iff_lt S.A).mp hVA _ hmemE _ _ hent
  rw [ht]
  exact this

-- G9 (helper): a response is the parent at the cursor
theorem resp_eq_parents (E : Forest) (ks : KeySys) (o : ColAddr) (W : List (WithTop Key)) :
    resp E ks o W = (parents E o)[cursor (ks o) W]? := by
  unfold resp parents
  rw [List.getElem?_map]

-- G9 (helper, from T3.8c and D1.6b): the cap column of a literal cap holds the first `k`
-- entries of the column followed by `(ρ, ∅)`
theorem litCap_colAt_self {B : Forest} {c : ColAddr} {k ρ : Nat} (hup : IsUpward B c k ρ) :
    (litCap B c k ρ).colAt c = some (((B.colAt c).getD []).take k ++ [(ρ, Tree.empty)]) ∧
      (((B.colAt c).getD []).take k).length = k := by
  have hs := (stopData_spec (stopData_litCap hup)).1
  refine ⟨hs, ?_⟩
  unfold IsUpward at hup
  cases hB : B.colAt c with
  | none => rw [hB] at hup; exact hup.elim
  | some col =>
    rw [hB] at hup
    simp only [Option.getD_some, List.length_take]
    cases hk : col[k]? with
    | none => simp only [hk] at hup; omega
    | some x =>
      have : k < col.length := by
        by_contra hc
        rw [List.getElem?_eq_none (by omega)] at hk
        cases hk
      omega

-- G9 (helper): the cap column is a column of the cap, with `k + 1` entries
theorem litCap_parents_self {B : Forest} {c : ColAddr} {k ρ : Nat} (hup : IsUpward B c k ρ) :
    c ∈ (litCap B c k ρ).colAddrs ∧ (parents (litCap B c k ρ) c).length = k + 1 := by
  obtain ⟨hcol, hlen⟩ := litCap_colAt_self hup
  refine ⟨by rw [Tree.mem_colAddrs_iff, hcol]; rfl, ?_⟩
  simp only [parents, hcol, Option.getD_some, List.length_map, List.length_append, hlen,
    List.length_singleton]

-- G9 (helper): a path sum through a step `(ci, e)` after a prefix `pre`
theorem pathSum_ge (pre rest : List (Nat × Nat)) (ci e : Nat) :
    (pre.map (·.1 + 1)).sum + ci + 1 ≤ ((pre ++ (ci, e) :: rest).map (·.1 + 1)).sum := by
  simp only [List.map_append, List.map_cons, List.sum_append, List.sum_cons]
  omega

-- G9 (helper): every template column lies above the root, `r < num a`
theorem tmplCol_num_gt (S : OrdStep) {a : ColAddr} (ha : IsTmplCol S.A S.sd S.rd a) :
    S.sd.r < a.num 0 := by
  obtain ⟨-, -, hne, hker⟩ := ha
  obtain ⟨-, -, hidx, hrnum, hrt, -⟩ := rootData_spec S.hsd S.hrd
  obtain ⟨-, -, ht, -⟩ := stopData_spec S.hsd
  have hnum : ∀ b : ColAddr, b.num 0 = (b.path.map (·.1 + 1)).sum + b.col := by
    intro b; simp [ColAddr.num]
  by_cases hQ : isQMat S.sd a = true
  · -- Q-material lies inside a height of the stopping column, above `t > r`
    cases hd : a.path.drop S.sd.col.path.length with
    | nil => simp [isQMat, hd] at hQ
    | cons p rest =>
      obtain ⟨ci, j⟩ := p
      simp only [isQMat, hd, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at hQ
      obtain ⟨htk, hci, -⟩ := hQ
      have hpath : a.path = S.sd.col.path ++ (ci, j) :: rest := by
        rw [← htk, ← hd, List.take_append_drop]
      have h1 := pathSum_ge S.sd.col.path rest ci j
      rw [← hpath] at h1
      have h2 := hnum a
      have h3 := hnum S.sd.col
      omega
  · simp only [Bool.not_eq_true] at hQ
    unfold kerCol at hker
    simp only [hQ, Bool.false_eq_true, if_false] at hker
    by_cases hR : a.path.take S.rd.col.path.length = S.rd.col.path
    · rw [if_pos hR] at hker
      cases hd : a.path.drop S.rd.col.path.length with
      | nil =>
        rw [hd] at hker
        have hpath : a.path = S.rd.col.path := by
          rw [← List.take_append_drop S.rd.col.path.length a.path, hR, hd, List.append_nil]
        have hcol : S.rd.idx ≤ a.col := by
          split_ifs at hker with h1 h2
          · omega
          · omega
          · simp at hker
        have hcol' : a.col ≠ S.rd.col.col := by
          intro h
          apply hne
          show (⟨a.path, a.col⟩ : ColAddr) = ⟨S.rd.col.path, S.rd.col.col⟩
          rw [hpath, h]
        have h2 := hnum a
        have h3 := hnum S.rd.col
        rw [hpath] at h2
        omega
      | cons p rest =>
        obtain ⟨ci, e⟩ := p
        rw [hd] at hker
        have hci : S.rd.idx ≤ ci := by
          simp only at hker
          split_ifs at hker with h1 h2
          · omega
          · omega
          · simp at hker
        have hpath : a.path = S.rd.col.path ++ (ci, e) :: rest := by
          rw [← hR, ← hd, List.take_append_drop]
        have h1 := pathSum_ge S.rd.col.path rest ci e
        rw [← hpath] at h1
        have h2 := hnum a
        have h3 := hnum S.rd.col
        omega
    · rw [if_neg hR] at hker
      simp at hker

-- G9 (helper, T3.2i `num_phaseCol`): a phase copy lies above its head, `s_φ < num c`
theorem phaseCol_num_gt (S : OrdStep) {i : Nat} {a c : ColAddr} (hi : 1 ≤ i)
    (ha : IsTmplCol S.A S.sd S.rd a) (hc : phaseCol S.sd S.rd i a = some c) :
    S.s (phaseOff S.sd i a) < c.num 0 := by
  have hn := num_phaseCol S.inL S.kind S.hsd S.hrd (Or.inr ha) hi hc
  have := tmplCol_num_gt S ha
  simp only [OrdStep.s, OrdStep.d]
  omega

/-! ## G9.4 — the stack of a phase copy (address algebra, T3.2i) -/

-- G9.4s1: the stack of `underCol h b` is the stack of `h` together with the `underCol h`-image of
-- the stack of `b`
theorem onStack_underCol (h b o : ColAddr) :
    (underCol h b).OnStack o ↔ h.OnStack o ∨ ∃ o', b.OnStack o' ∧ o = underCol h o' := by
  obtain ⟨hp, hc⟩ := h
  obtain ⟨bp, bc⟩ := b
  obtain ⟨op, oc⟩ := o
  cases bp with
  | nil =>
    show ColAddr.OnStack ⟨hp, hc + bc⟩ ⟨op, oc⟩ ↔ _
    unfold ColAddr.OnStack
    simp only
    constructor
    · rintro (hA | ⟨hpe, hlt⟩)
      · exact Or.inl (Or.inl hA)
      · by_cases hlt' : oc < hc
        · exact Or.inl (Or.inr ⟨hpe, hlt'⟩)
        · refine Or.inr ⟨⟨[], oc - hc⟩, Or.inr ⟨rfl, by simp only; omega⟩, ?_⟩
          show (⟨op, oc⟩ : ColAddr) = ⟨hp, hc + (oc - hc)⟩
          rw [hpe, show hc + (oc - hc) = oc by omega]
    · rintro ((hA | ⟨hpe, hlt⟩) | ⟨⟨op', oc'⟩, hst, hoe⟩)
      · exact Or.inl hA
      · exact Or.inr ⟨hpe, by omega⟩
      · rcases hst with ⟨k, ck, ik, hk, -, -⟩ | ⟨hp', hlt'⟩
        · simp at hk
        · simp only at hp' hlt'
          subst hp'
          change (⟨op, oc⟩ : ColAddr) = ⟨hp, hc + oc'⟩ at hoe
          simp only [ColAddr.mk.injEq] at hoe
          exact Or.inr ⟨hoe.1, by omega⟩
  | cons p rest =>
    obtain ⟨c0, e0⟩ := p
    show ColAddr.OnStack ⟨hp ++ (hc + c0, e0) :: rest, bc⟩ ⟨op, oc⟩ ↔ _
    unfold ColAddr.OnStack
    simp only
    constructor
    · rintro (⟨k, ck, ik, hk, hpe, hle⟩ | ⟨hpe, hlt⟩)
      · rcases Nat.lt_trichotomy k hp.length with hkl | hkl | hkl
        · rw [List.getElem?_append_left hkl] at hk
          rw [List.take_append_of_le_length hkl.le] at hpe
          exact Or.inl (Or.inl ⟨k, ck, ik, hk, hpe, hle⟩)
        · subst hkl
          rw [List.getElem?_append_right le_rfl, Nat.sub_self] at hk
          simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hk
          obtain ⟨h1, -⟩ := hk
          rw [List.take_left' rfl] at hpe
          by_cases hlt' : oc < hc
          · exact Or.inl (Or.inr ⟨hpe, hlt'⟩)
          · refine Or.inr ⟨⟨[], oc - hc⟩, Or.inl ⟨0, c0, e0, rfl, rfl, by simp only; omega⟩, ?_⟩
            show (⟨op, oc⟩ : ColAddr) = ⟨hp, hc + (oc - hc)⟩
            rw [hpe, show hc + (oc - hc) = oc by omega]
        · obtain ⟨j, hj⟩ : ∃ j, k = hp.length + (j + 1) := ⟨k - hp.length - 1, by omega⟩
          rw [hj, List.getElem?_append_right (by omega), Nat.add_sub_cancel_left] at hk
          rw [hj, List.take_length_add_append] at hpe
          refine Or.inr ⟨⟨(c0, e0) :: rest.take j, oc⟩,
            Or.inl ⟨j + 1, ck, ik, hk, by simp, hle⟩, ?_⟩
          show (⟨op, oc⟩ : ColAddr) = ⟨hp ++ (hc + c0, e0) :: rest.take j, oc⟩
          rw [hpe]
          simp
      · refine Or.inr ⟨⟨(c0, e0) :: rest, oc⟩, Or.inr ⟨rfl, hlt⟩, ?_⟩
        show (⟨op, oc⟩ : ColAddr) = ⟨hp ++ (hc + c0, e0) :: rest, oc⟩
        rw [hpe]
    · rintro ((⟨k, ck, ik, hk, hpe, hle⟩ | ⟨hpe, hlt⟩) | ⟨⟨op', oc'⟩, hst, hoe⟩)
      · have hkl : k < hp.length := (List.getElem?_eq_some_iff.mp hk).1
        refine Or.inl ⟨k, ck, ik, ?_, ?_, hle⟩
        · rw [List.getElem?_append_left hkl]; exact hk
        · rw [List.take_append_of_le_length hkl.le]; exact hpe
      · refine Or.inl ⟨hp.length, hc + c0, e0, ?_, ?_, by omega⟩
        · rw [List.getElem?_append_right le_rfl, Nat.sub_self]; rfl
        · rw [List.take_left' rfl]; exact hpe
      · rcases hst with ⟨k, ck, ik, hk, hpe, hle⟩ | ⟨hpe, hlt⟩
        · simp only at hpe hle
          cases k with
          | zero =>
            simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hk
            obtain ⟨h1, -⟩ := hk
            simp only [List.take_zero] at hpe
            subst hpe
            change (⟨op, oc⟩ : ColAddr) = ⟨hp, hc + oc'⟩ at hoe
            simp only [ColAddr.mk.injEq] at hoe
            obtain ⟨h3, h4⟩ := hoe
            rw [h3, h4]
            refine Or.inl ⟨hp.length, hc + c0, e0, ?_, ?_, by omega⟩
            · rw [List.getElem?_append_right le_rfl, Nat.sub_self]; rfl
            · rw [List.take_left' rfl]
          | succ j =>
            simp only [List.take_succ_cons] at hpe
            subst hpe
            change (⟨op, oc⟩ : ColAddr) = ⟨hp ++ (hc + c0, e0) :: rest.take j, oc'⟩ at hoe
            simp only [ColAddr.mk.injEq] at hoe
            obtain ⟨h3, h4⟩ := hoe
            rw [h3, h4]
            refine Or.inl ⟨hp.length + (j + 1), ck, ik, ?_, ?_, hle⟩
            · rw [List.getElem?_append_right (by omega), Nat.add_sub_cancel_left]; exact hk
            · rw [List.take_length_add_append]; rfl
        · simp only at hpe hlt
          subst hpe
          change (⟨op, oc⟩ : ColAddr) = ⟨hp ++ (hc + c0, e0) :: rest, oc'⟩ at hoe
          simp only [ColAddr.mk.injEq] at hoe
          obtain ⟨h3, h4⟩ := hoe
          rw [h3, h4]
          exact Or.inr ⟨rfl, hlt⟩

-- G9.4s2: printed numbers add under `underCol`
theorem num_underCol (h b : ColAddr) : (underCol h b).num 0 = h.num 0 + b.num 0 := by
  obtain ⟨bp, bc⟩ := b
  cases bp with
  | nil => simp [underCol, ColAddr.num]; omega
  | cons p rest =>
    obtain ⟨c0, e0⟩ := p
    simp [underCol, ColAddr.num, List.sum_append]; omega

-- G9.4s3: containment is carried by `underCol`
theorem container_underCol (h b o : ColAddr) :
    (underCol h o).container (underCol h b) = (o.container b).map fun e => ⟨underCol h o, e.idx⟩ := by
  obtain ⟨op, oc⟩ := o
  obtain ⟨bp, bc⟩ := b
  cases op with
  | nil =>
    cases bp with
    | nil => simp [underCol, ColAddr.container]
    | cons p rest =>
      obtain ⟨c0, e0⟩ := p
      simp [underCol, ColAddr.container]
  | cons p' rest' =>
    obtain ⟨c0', e0'⟩ := p'
    cases bp with
    | nil =>
      simp only [underCol, ColAddr.container]
      rw [List.drop_eq_nil_of_le (by simp)]
      simp
    | cons p rest =>
      obtain ⟨c0, e0⟩ := p
      simp only [underCol, ColAddr.container, List.length_append, List.length_cons]
      rw [List.drop_length_add_append, List.take_length_add_append]
      simp
      rcases List.drop rest'.length rest with _ | ⟨⟨k, i⟩, tail⟩
      · simp
      · simp

-- G9.4s3b: a column strictly on the stack of `h` contains `underCol h b` exactly when it contains
-- `h`, through the same entry
theorem container_underCol_of_onStack {h o : ColAddr} (ho : h.OnStack o) (b : ColAddr) :
    o.container (underCol h b) = o.container h := by
  obtain ⟨bp, bc⟩ := b
  rcases ho with ⟨k, ck, ik, hk, hp, hc⟩ | ⟨hp, hc⟩
  · have hkl : k < h.path.length := (List.getElem?_eq_some_iff.mp hk).1
    cases bp with
    | nil => rfl
    | cons p rest =>
      obtain ⟨c0, e0⟩ := p
      simp only [underCol, ColAddr.container, hp, List.length_take]
      rw [Nat.min_eq_left hkl.le]
      rw [List.drop_append_of_le_length hkl.le, List.take_append_of_le_length hkl.le]
      rw [List.drop_eq_getElem_cons hkl]
      rfl
  · cases bp with
    | nil => simp [underCol, ColAddr.container, hp]
    | cons p rest =>
      obtain ⟨c0, e0⟩ := p
      simp [underCol, ColAddr.container, hp]
      omega

-- G9 (helper): the root-tail branch of `kerCol`, case by case
theorem kerCol_tail_spec (S : OrdStep) {x x' : ColAddr} (hx : kerCol S.sd S.rd x = some x')
    (hxq : isQMat S.sd x = false) :
    ∃ suf, x.path = S.rd.col.path ++ suf ∧
      ((suf = [] ∧ x.col = S.rd.col.col ∧ x' = ⟨[], 0⟩) ∨
       (suf = [] ∧ S.rd.col.col < x.col ∧ S.rd.owner = false ∧ x' = ⟨[], x.col - S.rd.col.col⟩) ∨
       (∃ e rest, suf = (S.rd.col.col, e) :: rest ∧ S.rd.cursor ≤ e ∧
          x' = ⟨(0, S.m + (e - S.rd.cursor)) :: rest, x.col⟩) ∨
       (∃ ci e rest, suf = (ci, e) :: rest ∧ S.rd.col.col < ci ∧ S.rd.owner = false ∧
          x' = ⟨(ci - S.rd.col.col, e) :: rest, x.col⟩)) := by
  obtain ⟨-, -, hidx, -⟩ := rootData_spec S.hsd S.hrd
  unfold kerCol at hx
  simp only [hxq, Bool.false_eq_true, if_false] at hx
  by_cases hR : x.path.take S.rd.col.path.length = S.rd.col.path
  · rw [if_pos hR] at hx
    have hsplit := List.take_append_drop S.rd.col.path.length x.path
    rw [hR] at hsplit
    refine ⟨x.path.drop S.rd.col.path.length, hsplit.symm, ?_⟩
    cases hd : x.path.drop S.rd.col.path.length with
    | nil =>
      rw [hd] at hx
      simp only at hx
      rw [← hidx]
      split_ifs at hx with h1 h2
      · cases hx; exact Or.inl ⟨rfl, h1, rfl⟩
      · cases hx; exact Or.inr (Or.inl ⟨rfl, h2.1, h2.2, rfl⟩)
    | cons p rest =>
      obtain ⟨ci, e⟩ := p
      rw [hd] at hx
      simp only at hx
      rw [← hidx]
      split_ifs at hx with h1 h2
      · cases hx; obtain ⟨rfl, h1'⟩ := h1
        exact Or.inr (Or.inr (Or.inl ⟨e, rest, rfl, h1', rfl⟩))
      · cases hx
        exact Or.inr (Or.inr (Or.inr ⟨ci, e, rest, rfl, h2.1, h2.2, rfl⟩))
  · rw [if_neg hR] at hx
    cases hx

-- G9 (helper): root-tail columns through a root-level step are in the template
theorem kerCol_isSome_cons (S : OrdStep) {o : ColAddr} (hoq : isQMat S.sd o = false) {ci e : Nat}
    {rest : List (Nat × Nat)} (hp : o.path = S.rd.col.path ++ (ci, e) :: rest)
    (hc : (ci = S.rd.col.col ∧ S.rd.cursor ≤ e) ∨ (S.rd.col.col < ci ∧ S.rd.owner = false)) :
    (kerCol S.sd S.rd o).isSome := by
  obtain ⟨-, -, hidx, -⟩ := rootData_spec S.hsd S.hrd
  unfold kerCol
  simp only [hoq, hp, List.take_left, List.drop_left, Bool.false_eq_true, if_false, if_true, hidx]
  rcases hc with h | h
  · rw [if_pos h]; rfl
  · rw [if_neg (by omega), if_pos h]; rfl

-- G9 (helper): root-level columns from the root on are in the template
theorem kerCol_isSome_nil (S : OrdStep) {o : ColAddr} (hoq : isQMat S.sd o = false)
    (hp : o.path = S.rd.col.path)
    (hc : o.col = S.rd.col.col ∨ (S.rd.col.col < o.col ∧ S.rd.owner = false)) :
    (kerCol S.sd S.rd o).isSome := by
  obtain ⟨-, -, hidx, -⟩ := rootData_spec S.hsd S.hrd
  unfold kerCol
  simp only [hoq, hp, List.take_length, List.drop_length, Bool.false_eq_true, if_false, if_true, hidx]
  rcases hc with h | h
  · rw [if_pos h]; rfl
  · rw [if_neg (by omega), if_pos h]; rfl

-- G9 (helper): Q-material is closed under extending the address path
theorem isQMat_of_prefix (sd : StopData) {o x : ColAddr} (ho : isQMat sd o = true)
    (hpre : o.path <+: x.path) : isQMat sd x = true := by
  obtain ⟨t, ht⟩ := hpre
  unfold isQMat at ho ⊢
  cases hd : o.path.drop sd.col.path.length with
  | nil => simp [hd] at ho
  | cons p rest =>
    have hlen : sd.col.path.length < o.path.length := by
      by_contra hc
      rw [List.drop_eq_nil_of_le (by omega)] at hd
      cases hd
    rw [← ht, List.take_append_of_le_length hlen.le, List.drop_append_of_le_length hlen.le, hd]
    rw [hd] at ho
    exact ho

-- G9 (helper): a stack column's path is a prefix of the column's path
theorem onStack_prefix {x o : ColAddr} (ho : x.OnStack o) : o.path <+: x.path := by
  rcases ho with ⟨k, -, -, -, hp, -⟩ | ⟨hp, -⟩
  · rw [hp]; exact List.take_prefix _ _
  · rw [hp]

-- G9.4s4b: every stack column with number `≥ r` of root-tail material is root-tail material
theorem kerCol_of_onStack_tail (S : OrdStep) {x x' : ColAddr} (hx : kerCol S.sd S.rd x = some x')
    (hxq : isQMat S.sd x = false) {o : ColAddr} (ho : x.OnStack o) (hr : S.sd.r ≤ o.num 0) :
    (kerCol S.sd S.rd o).isSome ∧ isQMat S.sd o = false := by
  obtain ⟨-, -, hidx, hrnum, -⟩ := rootData_spec S.hsd S.hrd
  obtain ⟨suf, hpath, hcases⟩ := kerCol_tail_spec S hx hxq
  have hoq : isQMat S.sd o = false := by
    cases h : isQMat S.sd o
    · rfl
    · have := isQMat_of_prefix S.sd h (onStack_prefix ho)
      rw [this] at hxq
      cases hxq
  refine ⟨?_, hoq⟩
  have hnot : ¬ S.rd.col.OnStack o := fun h => by
    have := ColAddr.num_lt_of_onStack 0 h
    omega
  rcases ho with ⟨k, ck, ik, hk, hop, hoc⟩ | ⟨hop, hoc⟩
  · by_cases hkR : k < S.rd.col.path.length
    · exfalso
      apply hnot
      refine Or.inl ⟨k, ck, ik, ?_, ?_, hoc⟩
      · rw [hpath, List.getElem?_append_left hkR] at hk; exact hk
      · rw [hop, hpath, List.take_append_of_le_length hkR.le]
    · rw [not_lt] at hkR
      obtain ⟨j, hj⟩ : ∃ j, k = S.rd.col.path.length + j := ⟨k - S.rd.col.path.length, by omega⟩
      rw [hpath, hj, List.getElem?_append_right (by omega), Nat.add_sub_cancel_left] at hk
      rw [hpath, hj, List.take_length_add_append] at hop
      cases j with
      | zero =>
        simp only [List.take_zero, List.append_nil] at hop
        -- `o` sits at the root's level, at most at the column `ck` of `x`'s first step
        rcases Nat.lt_trichotomy o.col S.rd.col.col with hlt | heq | hgt
        · exact absurd (Or.inr ⟨hop, hlt⟩) hnot
        · exact kerCol_isSome_nil S hoq hop (Or.inl heq)
        · refine kerCol_isSome_nil S hoq hop (Or.inr ⟨hgt, ?_⟩)
          rcases hcases with ⟨rfl, -⟩ | ⟨rfl, -⟩ | ⟨e, rest, rfl, -, -⟩ | ⟨ci, e, rest, rfl, -, hown, -⟩
          · simp at hk
          · simp at hk
          · simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hk
            omega
          · exact hown
      | succ j =>
        rcases hcases with ⟨rfl, -⟩ | ⟨rfl, -⟩ | ⟨e, rest, rfl, he, -⟩ | ⟨ci, e, rest, rfl, hci, hown, -⟩
        · simp at hk
        · simp at hk
        · simp only [List.take_succ_cons] at hop
          exact kerCol_isSome_cons S hoq hop (Or.inl ⟨rfl, he⟩)
        · simp only [List.take_succ_cons] at hop
          exact kerCol_isSome_cons S hoq hop (Or.inr ⟨hci, hown⟩)
  · rw [hpath] at hop
    rcases hcases with ⟨rfl, hxc, -⟩ | ⟨rfl, hxc, hown, -⟩ | ⟨e, rest, rfl, he, -⟩ |
        ⟨ci, e, rest, rfl, hci, hown, -⟩
    · simp only [List.append_nil] at hop
      exact absurd (Or.inr ⟨hop, by omega⟩) hnot
    · simp only [List.append_nil] at hop
      rcases Nat.lt_trichotomy o.col S.rd.col.col with hlt | heq | hgt
      · exact absurd (Or.inr ⟨hop, hlt⟩) hnot
      · exact kerCol_isSome_nil S hoq hop (Or.inl heq)
      · exact kerCol_isSome_nil S hoq hop (Or.inr ⟨hgt, hown⟩)
    · exact kerCol_isSome_cons S hoq hop (Or.inl ⟨rfl, he⟩)
    · exact kerCol_isSome_cons S hoq hop (Or.inr ⟨hci, hown⟩)

theorem num_kerCol_tail (S : OrdStep) {x x' : ColAddr} (hx : kerCol S.sd S.rd x = some x')
    (hxq : isQMat S.sd x = false) : x'.num 0 + S.sd.r = x.num 0 := by
  obtain ⟨-, -, -, hrnum, -⟩ := rootData_spec S.hsd S.hrd
  obtain ⟨suf, hpath, hcases⟩ := kerCol_tail_spec S hx hxq
  have hnum : ∀ b : ColAddr, b.num 0 = (b.path.map (·.1 + 1)).sum + b.col := by
    intro b; simp [ColAddr.num]
  have hx1 := hnum x
  have hr1 := hnum S.rd.col
  rw [hpath, List.map_append, List.sum_append] at hx1
  rw [← hrnum]
  rcases hcases with ⟨rfl, h1, rfl⟩ | ⟨rfl, h1, -, rfl⟩ | ⟨e, rest, rfl, -, rfl⟩ |
      ⟨ci, e, rest, rfl, h1, -, rfl⟩
  · simp [ColAddr.num] at hx1 ⊢; omega
  · simp [ColAddr.num] at hx1 ⊢; omega
  · simp [ColAddr.num] at hx1 ⊢; omega
  · simp [ColAddr.num] at hx1 ⊢; omega

-- G9 (helper)
theorem container_col {o b : ColAddr} {e : EntryAddr} (h : o.container b = some e) : e.col = o :=
  ((ColAddr.container_spec o b e).mp h).1

-- G9 (helper): containment below a common step
theorem container_cons (ci ei : Nat) (π₁ π₂ : List (Nat × Nat)) (c₁ c₂ : Nat) :
    (⟨(ci, ei) :: π₁, c₁⟩ : ColAddr).container ⟨(ci, ei) :: π₂, c₂⟩ =
      ((⟨π₁, c₁⟩ : ColAddr).container ⟨π₂, c₂⟩).map fun e => ⟨⟨(ci, ei) :: π₁, c₁⟩, e.idx⟩ := by
  unfold ColAddr.container
  simp only [List.length_cons, List.drop_succ_cons, List.take_succ_cons, List.cons.injEq, true_and]
  cases List.drop π₁.length π₂ with
  | nil => rfl
  | cons x xs =>
    obtain ⟨k, i⟩ := x
    simp only
    split_ifs <;> rfl

-- G9 (helper): containment below a common prefix
theorem container_append (R so sx : List (Nat × Nat)) (c c' : Nat) :
    (⟨R ++ so, c⟩ : ColAddr).container ⟨R ++ sx, c'⟩ =
      ((⟨so, c⟩ : ColAddr).container ⟨sx, c'⟩).map fun e => ⟨⟨R ++ so, c⟩, e.idx⟩ := by
  induction R with
  | nil =>
    simp only [List.nil_append]
    cases h : (⟨so, c⟩ : ColAddr).container ⟨sx, c'⟩ with
    | none => rfl
    | some e =>
      simp only [Option.map_some]
      rw [← container_col h]
  | cons s R ih =>
    obtain ⟨ci, ei⟩ := s
    rw [List.cons_append, List.cons_append, container_cons, ih, Option.map_map]
    rfl

-- G9 (helper): a column at the root level contains nothing at the root level
theorem container_nil_nil (c c' : Nat) : (⟨[], c⟩ : ColAddr).container ⟨[], c'⟩ = none := by
  simp [ColAddr.container]

-- G9 (helper)
theorem container_nil_cons (c c' k i : Nat) (rest : List (Nat × Nat)) :
    (⟨[], c⟩ : ColAddr).container ⟨(k, i) :: rest, c'⟩ = if k = c then some ⟨⟨[], c⟩, i⟩ else none := by
  simp [ColAddr.container]

-- G9 (helper)
theorem container_cons_nil (c c' : Nat) (s : Nat × Nat) (rest : List (Nat × Nat)) :
    (⟨s :: rest, c⟩ : ColAddr).container ⟨[], c'⟩ = none := by
  simp [ColAddr.container]

-- G9 (helper)
theorem container_cons_ne (c c' : Nat) (s t : Nat × Nat) (rs rt : List (Nat × Nat)) (h : s ≠ t) :
    (⟨s :: rs, c⟩ : ColAddr).container ⟨t :: rt, c'⟩ = none := by
  unfold ColAddr.container
  simp only [List.length_cons, List.drop_succ_cons, List.take_succ_cons, List.cons.injEq]
  cases List.drop rs.length rt with
  | nil => rfl
  | cons x xs =>
    obtain ⟨k, i⟩ := x
    simp only
    rw [if_neg (by intro hh; exact h hh.1.1.symm)]

theorem container_kerCol (S : OrdStep) {x x' o o' : ColAddr} (hx : kerCol S.sd S.rd x = some x')
    (ho : kerCol S.sd S.rd o = some o') (hxq : isQMat S.sd x = false) :
    o'.container x' = (o.container x).map fun e =>
      ⟨o', if o = S.rd.col then S.m + (e.idx - S.rd.cursor) else e.idx⟩ := by
  obtain ⟨sx, hxp, hxc⟩ := kerCol_tail_spec S hx hxq
  by_cases hoq : isQMat S.sd o = true
  · -- Q-material `o` contains no root-tail column, and its image contains no image of one
    have hox : o.container x = none := by
      cases h : o.container x with
      | none => rfl
      | some e =>
        exfalso
        obtain ⟨-, hpre⟩ := (ColAddr.container_spec o x e).mp h
        have hpre' : o.path <+: x.path := by
          rw [← container_col h]
          exact List.IsPrefix.trans (List.prefix_append _ _) hpre
        have := isQMat_of_prefix S.sd hoq hpre'
        rw [hxq] at this
        cases this
    rw [hox, Option.map_none]
    -- `o' = ⟨(0, j) :: rest, o.col⟩` with `j < m`
    unfold kerCol at ho
    rw [if_pos hoq] at ho
    unfold isQMat at hoq
    cases hd : o.path.drop S.sd.col.path.length with
    | nil => rw [hd] at ho; cases ho
    | cons p rest =>
      obtain ⟨ci, j⟩ := p
      rw [hd] at ho hoq
      simp only [Option.some.injEq] at ho
      subst ho
      simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at hoq
      have hj : j < S.m := hoq.2.2
      rcases hxc with ⟨-, -, rfl⟩ | ⟨-, -, -, rfl⟩ | ⟨e, rest', -, -, rfl⟩ |
          ⟨ci', e, rest', -, hci', -, rfl⟩
      · exact container_cons_nil _ _ _ _
      · exact container_cons_nil _ _ _ _
      · exact container_cons_ne _ _ _ _ _ _ (by simp; omega)
      · exact container_cons_ne _ _ _ _ _ _ (by simp; omega)
  · have hoq' : isQMat S.sd o = false := by simpa using hoq
    obtain ⟨so, hop, hoc⟩ := kerCol_tail_spec S ho hoq'
    obtain ⟨-, -, hidx, -⟩ := rootData_spec S.hsd S.hrd
    have hoeq : o = ⟨S.rd.col.path ++ so, o.col⟩ := by
      show (⟨o.path, o.col⟩ : ColAddr) = _; rw [hop]
    have hxeq : x = ⟨S.rd.col.path ++ sx, x.col⟩ := by
      show (⟨x.path, x.col⟩ : ColAddr) = _; rw [hxp]
    have hcont : o.container x = ((⟨so, o.col⟩ : ColAddr).container ⟨sx, x.col⟩).map
        fun e => ⟨o, e.idx⟩ := by
      conv_lhs => rw [hoeq, hxeq]
      rw [container_append]
      rw [← hoeq]
    rw [hcont, Option.map_map]
    rcases hoc with ⟨rfl, hoc, rfl⟩ | ⟨rfl, hoc, hown, rfl⟩ | ⟨e₀, rest_o, rfl, he₀, rfl⟩ |
        ⟨ci₀, e₀, rest_o, rfl, hci₀, hown, rfl⟩
    · -- `o` is the root column
      have hor : o = S.rd.col := by
        rw [hoeq]; show (⟨_, _⟩ : ColAddr) = ⟨S.rd.col.path, S.rd.col.col⟩; rw [List.append_nil, hoc]
      rcases hxc with ⟨rfl, -, rfl⟩ | ⟨rfl, -, -, rfl⟩ | ⟨e, rest', rfl, he, rfl⟩ |
          ⟨ci', e, rest', rfl, hci', -, rfl⟩
      · simp [container_nil_nil]
      · simp [container_nil_nil]
      · rw [container_nil_cons, container_nil_cons, if_pos rfl, if_pos hoc.symm]
        simp [hor]
      · rw [container_nil_cons, container_nil_cons, if_neg (by omega), if_neg (by omega)]
        rfl
    · -- `o` a later root-level column
      have hor : o ≠ S.rd.col := by
        intro h; rw [h] at hoc; omega
      rcases hxc with ⟨rfl, -, rfl⟩ | ⟨rfl, -, -, rfl⟩ | ⟨e, rest', rfl, he, rfl⟩ |
          ⟨ci', e, rest', rfl, hci', -, rfl⟩
      · simp [container_nil_nil]
      · simp [container_nil_nil]
      · rw [container_nil_cons, container_nil_cons, if_neg (by omega), if_neg (by omega)]
        rfl
      · rw [container_nil_cons, container_nil_cons]
        by_cases hco : ci' = o.col
        · rw [if_pos hco, if_pos (by omega)]
          simp [hor]
        · rw [if_neg hco, if_neg (by omega)]
          rfl
    · -- `o` inside a restored height of the root
      have hor : o ≠ S.rd.col := by
        intro h; rw [h] at hop
        have := congrArg List.length hop
        simp at this
      rcases hxc with ⟨rfl, -, rfl⟩ | ⟨rfl, -, -, rfl⟩ | ⟨e, rest', rfl, he, rfl⟩ |
          ⟨ci', e, rest', rfl, hci', -, rfl⟩
      · simp [container_cons_nil]
      · simp [container_cons_nil]
      · by_cases hee : e = e₀
        · subst hee
          rw [container_cons, container_cons]
          simp only [Option.map_map]
          congr 1
          funext e'
          simp [hor]
        · rw [container_cons_ne _ _ _ _ _ _ (by simp; omega),
            container_cons_ne _ _ _ _ _ _ (by simp; omega)]
          rfl
      · rw [container_cons_ne _ _ _ _ _ _ (by simp; omega),
          container_cons_ne _ _ _ _ _ _ (by simp; omega)]
        rfl
    · -- `o` in a later body column of the root forest
      have hor : o ≠ S.rd.col := by
        intro h; rw [h] at hop
        have := congrArg List.length hop
        simp at this
      rcases hxc with ⟨rfl, -, rfl⟩ | ⟨rfl, -, -, rfl⟩ | ⟨e, rest', rfl, he, rfl⟩ |
          ⟨ci', e, rest', rfl, hci', -, rfl⟩
      · simp [container_cons_nil]
      · simp [container_cons_nil]
      · rw [container_cons_ne _ _ _ _ _ _ (by simp; omega),
          container_cons_ne _ _ _ _ _ _ (by simp; omega)]
        rfl
      · by_cases hee : ci' = ci₀ ∧ e = e₀
        · obtain ⟨rfl, rfl⟩ := hee
          rw [container_cons, container_cons]
          simp only [Option.map_map]
          congr 1
          funext e'
          simp [hor]
        · rw [container_cons_ne _ _ _ _ _ _ (by simp; omega),
            container_cons_ne _ _ _ _ _ _ (by simp; omega)]
          rfl

-- G9 (helper): Q-material, explicitly
theorem isQMat_spec (sd : StopData) {a : ColAddr} (h : isQMat sd a = true) :
    ∃ j rest, a.path = sd.col.path ++ (sd.col.col, j) :: rest ∧ j < sd.Q.length := by
  unfold isQMat at h
  cases hd : a.path.drop sd.col.path.length with
  | nil => simp [hd] at h
  | cons p rest =>
    obtain ⟨ci, j⟩ := p
    simp only [hd, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at h
    obtain ⟨htk, hci, hj⟩ := h
    refine ⟨j, rest, ?_, hj⟩
    rw [← List.take_append_drop sd.col.path.length a.path, htk, hd, hci]

-- G9 (helper)
theorem isQMat_of_spec (sd : StopData) {a : ColAddr} {j : Nat} {rest : List (Nat × Nat)}
    (hp : a.path = sd.col.path ++ (sd.col.col, j) :: rest) (hj : j < sd.Q.length) :
    isQMat sd a = true := by
  unfold isQMat
  rw [hp, List.take_left, List.drop_left]
  simp [hj]

-- G9 (helper): the template map on Q-material
theorem kerCol_qmat (S : OrdStep) {a : ColAddr} (h : isQMat S.sd a = true) {j : Nat}
    {rest : List (Nat × Nat)} (hp : a.path = S.sd.col.path ++ (S.sd.col.col, j) :: rest) :
    kerCol S.sd S.rd a = some ⟨(0, j) :: rest, a.col⟩ := by
  unfold kerCol
  simp only [h, if_true, hp, List.drop_left]

-- G9.4s5: the stack of Q-material images: the head and Q-material images only
theorem onStack_kerCol_qmat (S : OrdStep) {x x' : ColAddr} (hx : kerCol S.sd S.rd x = some x')
    (hxq : isQMat S.sd x = true) (o' : ColAddr) :
    x'.OnStack o' ↔ o' = ⟨[], 0⟩ ∨ ∃ o, x.OnStack o ∧ isQMat S.sd o = true ∧
      kerCol S.sd S.rd o = some o' := by
  obtain ⟨j, rest, hxp, hj⟩ := isQMat_spec S.sd hxq
  rw [kerCol_qmat S hxq hxp, Option.some.injEq] at hx
  subst hx
  obtain ⟨op, oc⟩ := o'
  constructor
  · rintro (⟨l, ck, ik, hl, hp, hle⟩ | ⟨hp, hlt⟩)
    · simp only at hp hle hl
      cases l with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hl
        simp only [List.take_zero] at hp
        left
        rw [hp, show oc = 0 by omega]
      | succ l =>
        simp only [List.getElem?_cons_succ] at hl
        simp only [List.take_succ_cons] at hp
        right
        refine ⟨⟨S.sd.col.path ++ (S.sd.col.col, j) :: rest.take l, oc⟩, ?_, ?_, ?_⟩
        · refine Or.inl ⟨S.sd.col.path.length + (l + 1), ck, ik, ?_, ?_, hle⟩
          · rw [hxp, List.getElem?_append_right (by omega), Nat.add_sub_cancel_left]
            simpa using hl
          · rw [hxp, List.take_length_add_append]; rfl
        · exact isQMat_of_spec S.sd (rest := rest.take l) rfl hj
        · rw [kerCol_qmat S (isQMat_of_spec S.sd (rest := rest.take l) rfl hj) rfl, hp]
    · simp only at hp hlt
      right
      refine ⟨⟨x.path, oc⟩, Or.inr ⟨rfl, hlt⟩, isQMat_of_spec S.sd hxp hj, ?_⟩
      have hq : isQMat S.sd ⟨x.path, oc⟩ = true := isQMat_of_spec S.sd hxp hj
      rw [kerCol_qmat S hq (show (⟨x.path, oc⟩ : ColAddr).path = _ from hxp), hp]
  · rintro (h0 | ⟨⟨op₀, oc₀⟩, hst, hq, hk⟩)
    · rw [h0]
      exact Or.inl ⟨0, 0, j, rfl, rfl, le_rfl⟩
    · obtain ⟨j', rest_o, hop, hj'⟩ := isQMat_spec S.sd hq
      rw [kerCol_qmat S hq hop, Option.some.injEq] at hk
      simp only at hop
      rw [← hk]
      rcases hst with ⟨k, ck, ik, hk', hp, hle⟩ | ⟨hp, hlt⟩
      · simp only at hp hle
        have hklen : k = S.sd.col.path.length + 1 + rest_o.length := by
          have := congrArg List.length hp
          have hkl : k < x.path.length := (List.getElem?_eq_some_iff.mp hk').1
          rw [hop, List.length_take, List.length_append, List.length_cons,
            Nat.min_eq_left hkl.le] at this
          omega
        rw [hxp, hklen, show S.sd.col.path.length + 1 + rest_o.length = S.sd.col.path.length + (rest_o.length + 1) by omega,
          List.take_length_add_append, List.take_succ_cons, hop] at hp
        have hp' := List.append_cancel_left hp
        simp only [List.cons.injEq, Prod.mk.injEq, true_and] at hp'
        obtain ⟨rfl, hrest⟩ := hp'
        rw [hxp, hklen, show S.sd.col.path.length + 1 + rest_o.length = S.sd.col.path.length + (rest_o.length + 1) by omega,
          List.getElem?_append_right (by omega), Nat.add_sub_cancel_left] at hk'
        simp only [List.getElem?_cons_succ] at hk'
        refine Or.inl ⟨rest_o.length + 1, ck, ik, ?_, ?_, hle⟩
        · simpa using hk'
        · simp only [List.take_succ_cons]
          exact congrArg _ hrest
      · simp only at hp hlt
        rw [hop, hxp] at hp
        have hp' := List.append_cancel_left hp
        simp only [List.cons.injEq, Prod.mk.injEq, true_and] at hp'
        obtain ⟨rfl, rfl⟩ := hp'
        exact Or.inr ⟨rfl, hlt⟩

-- G9 (helper): columns of a forest below a step `(ci, ei)`
theorem colAt_cons (cols : List Column) (ci ei : Nat) (π : List (Nat × Nat)) (col : Nat) :
    (Tree.node cols).colAt ⟨(ci, ei) :: π, col⟩ =
      ((cols[ci]?).bind (·[ei]?)).bind fun x => x.2.colAt ⟨π, col⟩ := by
  unfold Tree.colAt
  simp only [Tree.forestAt, Tree.cols]
  cases hx : (cols[ci]?).bind (·[ei]?) with
  | none => rfl
  | some x => obtain ⟨q, h⟩ := x; rfl

-- G9 (helper): the column-level form of G9.4l, by induction along the cap's address
theorem litCapAux_colAt (k p : Nat) (π : List (Nat × Nat)) (j : Nat) (F : Forest)
    (hc : (F.colAt ⟨π, j⟩).isSome) (o : ColAddr) (ho : (⟨π, j⟩ : ColAddr).OnStack o) :
    (∀ e, o.container ⟨π, j⟩ = some e → ∃ col h', F.colAt o = some col ∧ e.idx < col.length ∧
        (litCapAux k p π j F).colAt o = some (col.take e.idx ++ [((col[e.idx]?.map Prod.fst).getD 0, h')])) ∧
      (o.container ⟨π, j⟩ = none → (litCapAux k p π j F).colAt o = F.colAt o) := by
  induction π generalizing F o with
  | nil =>
    obtain ⟨cols⟩ := F
    obtain ⟨op, oc⟩ := o
    rcases ho with ⟨l, cl, il, hl, -, -⟩ | ⟨hp, hlt⟩
    · simp at hl
    · simp only at hp hlt
      subst hp
      have hj : j < cols.length := by
        unfold Tree.colAt at hc
        simp only [Tree.forestAt, Option.bind_some, Tree.cols] at hc
        cases h : cols[j]? with
        | none => rw [h] at hc; cases hc
        | some _ => exact (List.getElem?_eq_some_iff.mp h).1
      refine ⟨fun e he => by simp [ColAddr.container] at he, fun _ => ?_⟩
      unfold litCapAux Tree.colAt
      simp only [Tree.forestAt, Option.bind_some, Tree.cols]
      rw [List.getElem?_append_left (by simp; omega), List.getElem?_take_of_lt hlt]
  | cons s rest ih =>
    obtain ⟨ci, ei⟩ := s
    obtain ⟨cols⟩ := F
    rw [colAt_cons] at hc
    -- the containing entry exists
    obtain ⟨x, hx⟩ : ∃ x, (cols[ci]?).bind (·[ei]?) = some x := by
      cases h : (cols[ci]?).bind (·[ei]?) with
      | none => rw [h] at hc; cases hc
      | some x => exact ⟨x, rfl⟩
    obtain ⟨q, h⟩ := x
    rw [hx] at hc
    simp only [Option.bind_some] at hc
    obtain ⟨colci, hcolci, hei⟩ : ∃ colci, cols[ci]? = some colci ∧ colci[ei]? = some (q, h) := by
      cases h1 : cols[ci]? with
      | none => rw [h1] at hx; cases hx
      | some colci => rw [h1] at hx; exact ⟨colci, rfl, hx⟩
    have hci : ci < cols.length := (List.getElem?_eq_some_iff.mp hcolci).1
    have heil : ei < colci.length := (List.getElem?_eq_some_iff.mp hei).1
    have hK : litCapAux k p ((ci, ei) :: rest) j (Tree.node cols) =
        .node (cols.take ci ++ [colci.take ei ++ [(q, litCapAux k p rest j h)]]) := by
      simp only [litCapAux, List.getD_eq_getElem?_getD, hcolci, Option.getD_some, hei]
    rw [hK]
    have hlen1 : (cols.take ci).length = ci := by rw [List.length_take]; omega
    have hlen2 : (colci.take ei).length = ei := by rw [List.length_take]; omega
    have hKci : (cols.take ci ++ [colci.take ei ++ [(q, litCapAux k p rest j h)]])[ci]? =
        some (colci.take ei ++ [(q, litCapAux k p rest j h)]) := by
      rw [List.getElem?_append_right (le_of_eq hlen1), hlen1, Nat.sub_self]; rfl
    have hKei : (colci.take ei ++ [(q, litCapAux k p rest j h)])[ei]? =
        some (q, litCapAux k p rest j h) := by
      rw [List.getElem?_append_right (le_of_eq hlen2), hlen2, Nat.sub_self]; rfl
    obtain ⟨op, oc⟩ := o
    rcases ho with ⟨l, cl, il, hl, hp, hle⟩ | ⟨hp, hlt⟩
    · simp only at hp hle
      cases l with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hl
        have hcl : cl = ci := hl.1.symm
        simp only [List.take_zero] at hp
        subst hp
        rw [hcl] at hle
        rcases Nat.eq_or_lt_of_le hle with heq | hlt'
        · rw [heq]
          have hcont : (⟨[], ci⟩ : ColAddr).container ⟨(ci, ei) :: rest, j⟩ = some ⟨⟨[], ci⟩, ei⟩ := by
            simp [ColAddr.container]
          refine ⟨fun e he => ?_, fun he => (by rw [hcont] at he; cases he)⟩
          rw [hcont, Option.some.injEq] at he
          subst he
          refine ⟨colci, litCapAux k p rest j h, ?_, heil, ?_⟩
          · unfold Tree.colAt; simp [Tree.forestAt, Tree.cols, hcolci]
          · unfold Tree.colAt
            simp only [Tree.forestAt, Option.bind_some, Tree.cols, hKci, hei]
            simp
        · have hcont : (⟨[], oc⟩ : ColAddr).container ⟨(ci, ei) :: rest, j⟩ = none := by
            unfold ColAddr.container
            simp only [List.length_nil, List.drop_zero, List.take_zero, true_and]
            rw [if_neg (by omega)]
          refine ⟨fun e he => (by rw [hcont] at he; cases he), fun _ => ?_⟩
          unfold Tree.colAt
          simp only [Tree.forestAt, Option.bind_some, Tree.cols]
          rw [List.getElem?_append_left (by simp; omega), List.getElem?_take_of_lt hlt']
      | succ l =>
        simp only [List.getElem?_cons_succ] at hl
        simp only [List.take_succ_cons] at hp
        subst hp
        have ho' : (⟨rest, j⟩ : ColAddr).OnStack ⟨rest.take l, oc⟩ := Or.inl ⟨l, cl, il, hl, rfl, hle⟩
        obtain ⟨ih1, ih2⟩ := ih h hc ⟨rest.take l, oc⟩ ho'
        have hKcol : (Tree.node (cols.take ci ++ [colci.take ei ++ [(q, litCapAux k p rest j h)]])).colAt
            ⟨(ci, ei) :: rest.take l, oc⟩ = (litCapAux k p rest j h).colAt ⟨rest.take l, oc⟩ := by
          rw [colAt_cons, hKci]
          simp only [Option.bind_some, hKei]
        have hFcol : (Tree.node cols).colAt ⟨(ci, ei) :: rest.take l, oc⟩ = h.colAt ⟨rest.take l, oc⟩ := by
          rw [colAt_cons, hx]; rfl
        rw [hKcol, hFcol, container_cons]
        refine ⟨fun e he => ?_, fun he => ?_⟩
        · cases hce : (⟨rest.take l, oc⟩ : ColAddr).container ⟨rest, j⟩ with
          | none => rw [hce] at he; cases he
          | some e' =>
            rw [hce] at he
            simp only [Option.map_some, Option.some.injEq] at he
            subst he
            exact ih1 e' hce
        · cases hce : (⟨rest.take l, oc⟩ : ColAddr).container ⟨rest, j⟩ with
          | none => exact ih2 hce
          | some e' => rw [hce] at he; cases he
    · simp only at hp hlt
      subst hp
      have ho' : (⟨rest, j⟩ : ColAddr).OnStack ⟨rest, oc⟩ := Or.inr ⟨rfl, hlt⟩
      obtain ⟨ih1, ih2⟩ := ih h hc ⟨rest, oc⟩ ho'
      have hKcol : (Tree.node (cols.take ci ++ [colci.take ei ++ [(q, litCapAux k p rest j h)]])).colAt
          ⟨(ci, ei) :: rest, oc⟩ = (litCapAux k p rest j h).colAt ⟨rest, oc⟩ := by
        rw [colAt_cons, hKci]
        simp only [Option.bind_some, hKei]
      have hFcol : (Tree.node cols).colAt ⟨(ci, ei) :: rest, oc⟩ = h.colAt ⟨rest, oc⟩ := by
        rw [colAt_cons, hx]; rfl
      rw [hKcol, hFcol, container_cons]
      refine ⟨fun e he => ?_, fun he => ?_⟩
      · cases hce : (⟨rest, oc⟩ : ColAddr).container ⟨rest, j⟩ with
        | none => rw [hce] at he; cases he
        | some e' =>
          rw [hce] at he
          simp only [Option.map_some, Option.some.injEq] at he
          subst he
          exact ih1 e' hce
      · cases hce : (⟨rest, oc⟩ : ColAddr).container ⟨rest, j⟩ with
        | none => exact ih2 hce
        | some e' => rw [hce] at he; cases he

-- G9.4l: a literal cap keeps every stack column of its cap column: a container through its
-- active entry `u` (same parents up to `u`, same keys before `u`), any other stack column whole
theorem colAt_litCap_onStack {B : Forest} {c o : ColAddr} {k p : Nat} (hc : c ∈ B.colAddrs)
    (ho : c.OnStack o) :
    (∀ e, o.container c = some e →
        parents (litCap B c k p) o = (parents B o).take (e.idx + 1) ∧
        (actualKeys (litCap B c k p) o).take e.idx = (actualKeys B o).take e.idx) ∧
      (o.container c = none → (litCap B c k p).colAt o = B.colAt o) := by
  have hcs : (B.colAt c).isSome := (Tree.mem_colAddrs_iff _ _).mp hc
  have hK : litCap B c k p = litCapAux k p c.path c.col B := by
    show litCapBody B c k p = _
    unfold litCapBody
    rw [if_pos hcs]
  rw [hK]
  obtain ⟨h1, h2⟩ := litCapAux_colAt k p c.path c.col B hcs o ho
  refine ⟨fun e he => ?_, h2⟩
  obtain ⟨col, h', hB, hlt, hKc⟩ := h1 e he
  have hfst : (col[e.idx]?.map Prod.fst).getD 0 = (col[e.idx]'hlt).1 := by
    simp [List.getElem?_eq_getElem hlt]
  refine ⟨?_, ?_⟩
  · simp only [parents, hB, hKc, Option.getD_some, List.map_append, List.map_cons, List.map_nil,
      hfst]
    rw [List.take_add_one, List.getElem?_map, List.getElem?_eq_getElem hlt, List.map_take]
    rfl
  · simp only [actualKeys, hB, hKc, Option.getD_some, List.map_append]
    rw [List.take_left' (by simp; omega), ← List.map_take]

-- G9 (helper): a mapped column, entrywise
theorem mapCol_eq_map (f : Nat → Nat) (col : Column) :
    Tree.mapCol f col = col.map fun x => (f x.1, Tree.map f x.2) := by
  induction col with
  | nil => simp [Tree.mapCol]
  | cons x xs ih =>
    obtain ⟨p, H⟩ := x
    simp [Tree.mapCol, ih]

-- G9 (helper): the zero shift fixes columns
theorem mapCol_shiftVal_zero (r : Nat) (col : Column) : Tree.mapCol (shiftVal r 0) col = col := by
  rw [mapCol_eq_map]
  conv_rhs => rw [← List.map_id col]
  congr 1
  funext x
  rw [shiftVal_zero]
  have : Tree.map (shiftVal r 0) x.2 = x.2 := shift_zero r x.2
  rw [this]
  rfl

-- G9 (helper): the unshifted placement at depth `k + 1` changes only the last entry of the last
-- column, replacing its height
theorem replaceAt_succ_eq (Z : Forest) (k : Nat) (cols : List Column) :
    replaceAt 0 0 Z (k + 1) (.node cols) =
      .node (cols.dropLast ++ (cols.getLast?.map fun col =>
        col.dropLast ++ (col.getLast?.map fun x => (x.1, replaceAt 0 0 Z k x.2)).toList).toList) := by
  have e1 : (fun x : Nat × Forest => (shiftVal 0 0 x.1, Tree.map (shiftVal 0 0) x.2)) = id := by
    funext x
    rw [shiftVal_zero]
    exact congrArg _ (shift_zero 0 x.2)
  have e2 : Tree.mapCol (shiftVal 0 0) = id := by
    funext col
    exact mapCol_shiftVal_zero 0 col
  have e3 : (fun x : Nat × Forest => (shiftVal 0 0 x.1, replaceAt 0 0 Z k x.2)) =
      fun x => (x.1, replaceAt 0 0 Z k x.2) := by
    funext x
    rw [shiftVal_zero]
  simp only [replaceAt, mapLast_eq, e1, e2, e3, List.map_id]
  congr 2
  cases cols.getLast? with
  | none => rfl
  | some col => simp only [Option.map_some, mapLast_eq, List.map_id]

-- G9 (helper): the unshifted placement at depth `0` replaces the last column
theorem replaceAt_zero_eq (Z : Forest) (cols : List Column) (hne : cols ≠ []) :
    replaceAt 0 0 Z 0 (.node cols) = .node (cols.dropLast ++ Z.cols) := by
  cases cols with
  | nil => exact absurd rfl hne
  | cons x xs =>
    simp only [replaceAt]
    congr 2
    conv_rhs => rw [← List.map_id (x :: xs).dropLast]
    congr 1
    funext col
    exact mapCol_shiftVal_zero 0 col

-- G9 (helper): the route path one level down
theorem isRoutePath_cons {F : Forest} {cols : List Column} (hF : F = .node cols) {ci ei : Nat}
    {rest : List (Nat × Nat)} {colci : Column} {q : Nat} {h : Forest}
    (hcolci : cols[ci]? = some colci) (hei : colci[ei]? = some (q, h))
    (hr : Scan.IsRoutePath F ((ci, ei) :: rest)) : Scan.IsRoutePath h rest := by
  intro d hd
  obtain ⟨G, hG, hls⟩ := hr (d + 1) (by simp; omega)
  refine ⟨G, ?_, ?_⟩
  · rw [hF] at hG
    simpa [List.take_succ_cons, Tree.forestAt, Tree.cols, hcolci, hei] using hG
  · simpa using hls

-- G9 (helper): the column-level form of G9.4m, by induction along the route
theorem replaceAt_colAt (Z : Forest) (π : List (Nat × Nat)) (F : Forest)
    (hroute : Scan.IsRoutePath F π) {j : Nat}
    (hlast : ∃ G, F.forestAt π = some G ∧ G.cols.length = j + 1)
    (o : ColAddr) (ho : (⟨π, j⟩ : ColAddr).OnStack o) :
    ((replaceAt 0 0 Z π.length F).colAt o).map (·.map Prod.fst) = (F.colAt o).map (·.map Prod.fst) ∧
    (∀ e, o.container ⟨π, j⟩ = some e →
      ((replaceAt 0 0 Z π.length F).colAt o).map (·.take e.idx) = (F.colAt o).map (·.take e.idx)) ∧
    (o.container ⟨π, j⟩ = none → (replaceAt 0 0 Z π.length F).colAt o = F.colAt o) := by
  -- it suffices to treat the two shapes of the conclusion
  suffices H : (o.container ⟨π, j⟩ = none ∧ (replaceAt 0 0 Z π.length F).colAt o = F.colAt o) ∨
      (∃ e, o.container ⟨π, j⟩ = some e ∧
        ((replaceAt 0 0 Z π.length F).colAt o).map (·.map Prod.fst) = (F.colAt o).map (·.map Prod.fst) ∧
        ((replaceAt 0 0 Z π.length F).colAt o).map (·.take e.idx) = (F.colAt o).map (·.take e.idx)) by
    rcases H with ⟨hn, heq⟩ | ⟨e, he, h1, h2⟩
    · exact ⟨by rw [heq], fun e he => (by rw [hn] at he; cases he), fun _ => heq⟩
    · refine ⟨h1, fun e' he' => ?_, fun hn => (by rw [he] at hn; cases hn)⟩
      rw [he, Option.some.injEq] at he'
      rw [← he']
      exact h2
  induction π generalizing F o with
  | nil =>
    obtain ⟨cols⟩ := F
    obtain ⟨G, hG, hlen⟩ := hlast
    simp only [Tree.forestAt, Option.some.injEq] at hG
    subst hG
    simp only [Tree.cols] at hlen
    obtain ⟨op, oc⟩ := o
    rcases ho with ⟨l, cl, il, hl, -, -⟩ | ⟨hp, hlt⟩
    · simp at hl
    · simp only at hp hlt
      subst hp
      left
      refine ⟨by simp [ColAddr.container], ?_⟩
      rw [List.length_nil, replaceAt_zero_eq Z cols (by intro h; rw [h] at hlen; simp at hlen)]
      unfold Tree.colAt
      simp only [Tree.forestAt, Option.bind_some, Tree.cols]
      rw [List.getElem?_append_left (by simp; omega), List.getElem?_dropLast]
      simp [show oc < cols.length - 1 by omega]
  | cons s rest ih =>
    obtain ⟨ci, ei⟩ := s
    obtain ⟨cols⟩ := F
    -- the route step is the last-column, last-entry step
    obtain ⟨G0, hG0, hls⟩ := hroute 0 (by simp)
    simp only [List.take_zero, Tree.forestAt, Option.some.injEq] at hG0
    subst hG0
    unfold Tree.lastStep? at hls
    simp only [Tree.cols, List.getElem?_cons_zero] at hls
    obtain ⟨lc, hlc, hlcne, hci, hei⟩ : ∃ lc, cols.getLast? = some lc ∧ lc ≠ [] ∧
        ci = cols.length - 1 ∧ ei = lc.length - 1 := by
      cases hg : cols.getLast? with
      | none => rw [hg] at hls; cases hls
      | some lc =>
        rw [hg] at hls
        simp only [Option.bind_some] at hls
        split_ifs at hls with hemp
        simp only [Option.some.injEq, Prod.mk.injEq] at hls
        exact ⟨lc, rfl, by simpa using hemp, hls.1.symm, hls.2.symm⟩
    obtain ⟨pq, hpq⟩ : ∃ x, lc.getLast? = some x := by
      cases h : lc.getLast? with
      | none => simp at h; exact absurd h hlcne
      | some x => exact ⟨x, rfl⟩
    obtain ⟨q, h⟩ := pq
    have hcolsne : cols ≠ [] := by intro h; rw [h] at hlc; cases hlc
    have hcolci : cols[ci]? = some lc := by
      rw [hci, ← List.getLast?_eq_getElem?]; exact hlc
    have heiq : lc[ei]? = some (q, h) := by
      rw [hei, ← List.getLast?_eq_getElem?]; exact hpq
    have hcil : ci < cols.length := (List.getElem?_eq_some_iff.mp hcolci).1
    have heil : ei < lc.length := (List.getElem?_eq_some_iff.mp heiq).1
    have hR : replaceAt 0 0 Z ((ci, ei) :: rest).length (Tree.node cols) =
        .node (cols.dropLast ++ [lc.dropLast ++ [(q, replaceAt 0 0 Z rest.length h)]]) := by
      rw [List.length_cons, replaceAt_succ_eq, hlc]
      simp only [Option.map_some, Option.toList_some, hpq]
    rw [hR]
    have hlen1 : cols.dropLast.length = ci := by simp; omega
    have hlen2 : lc.dropLast.length = ei := by simp; omega
    have hRci : (cols.dropLast ++ [lc.dropLast ++ [(q, replaceAt 0 0 Z rest.length h)]])[ci]? =
        some (lc.dropLast ++ [(q, replaceAt 0 0 Z rest.length h)]) := by
      rw [List.getElem?_append_right (le_of_eq hlen1), hlen1, Nat.sub_self]; rfl
    have hRei : (lc.dropLast ++ [(q, replaceAt 0 0 Z rest.length h)])[ei]? =
        some (q, replaceAt 0 0 Z rest.length h) := by
      rw [List.getElem?_append_right (le_of_eq hlen2), hlen2, Nat.sub_self]; rfl
    have hlc_split : lc = lc.dropLast ++ [(q, h)] := (List.dropLast_append_getLast? (q, h) hpq).symm
    have hroute' := isRoutePath_cons rfl hcolci heiq hroute
    have hlast' : ∃ G, h.forestAt rest = some G ∧ G.cols.length = j + 1 := by
      obtain ⟨G, hG, hl⟩ := hlast
      refine ⟨G, ?_, hl⟩
      simpa [Tree.forestAt, Tree.cols, hcolci, heiq] using hG
    obtain ⟨op, oc⟩ := o
    rcases ho with ⟨l, cl, il, hl, hp, hle⟩ | ⟨hp, hlt⟩
    · simp only at hp hle
      cases l with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hl
        have hcl : cl = ci := hl.1.symm
        simp only [List.take_zero] at hp
        subst hp
        rw [hcl] at hle
        rcases Nat.eq_or_lt_of_le hle with heq | hlt'
        · rw [heq]
          right
          refine ⟨⟨⟨[], ci⟩, ei⟩, by simp [ColAddr.container], ?_, ?_⟩
          · unfold Tree.colAt
            simp only [Tree.forestAt, Option.bind_some, Tree.cols, hRci, hcolci, Option.map_some,
              Option.some.injEq]
            conv_rhs => rw [hlc_split]
            simp
          · unfold Tree.colAt
            simp only [Tree.forestAt, Option.bind_some, Tree.cols, hRci, hcolci, Option.map_some,
              Option.some.injEq]
            rw [List.take_left' hlen2]
            conv_rhs => rw [hlc_split]
            rw [List.take_left' hlen2]
        · left
          refine ⟨?_, ?_⟩
          · unfold ColAddr.container
            simp only [List.length_nil, List.drop_zero, List.take_zero, true_and]
            rw [if_neg (by omega)]
          · unfold Tree.colAt
            simp only [Tree.forestAt, Option.bind_some, Tree.cols]
            rw [List.getElem?_append_left (by omega), List.getElem?_dropLast]
            simp [show oc < cols.length - 1 by omega]
      | succ l =>
        simp only [List.getElem?_cons_succ] at hl
        simp only [List.take_succ_cons] at hp
        subst hp
        have ho' : (⟨rest, j⟩ : ColAddr).OnStack ⟨rest.take l, oc⟩ := Or.inl ⟨l, cl, il, hl, rfl, hle⟩
        have hRcol : (Tree.node (cols.dropLast ++ [lc.dropLast ++ [(q, replaceAt 0 0 Z rest.length h)]])).colAt
            ⟨(ci, ei) :: rest.take l, oc⟩ = (replaceAt 0 0 Z rest.length h).colAt ⟨rest.take l, oc⟩ := by
          rw [colAt_cons, hRci]
          simp only [Option.bind_some, hRei]
        have hFcol : (Tree.node cols).colAt ⟨(ci, ei) :: rest.take l, oc⟩ = h.colAt ⟨rest.take l, oc⟩ := by
          rw [colAt_cons, hcolci]
          simp only [Option.bind_some, heiq]
        rw [hRcol, hFcol, container_cons]
        rcases ih h hroute' hlast' ⟨rest.take l, oc⟩ ho' with ⟨hn, heq⟩ | ⟨e, he, h1, h2⟩
        · exact Or.inl ⟨by rw [hn]; rfl, heq⟩
        · exact Or.inr ⟨⟨⟨(ci, ei) :: rest.take l, oc⟩, e.idx⟩, by rw [he]; rfl, h1, h2⟩
    · simp only at hp hlt
      subst hp
      have ho' : (⟨rest, j⟩ : ColAddr).OnStack ⟨rest, oc⟩ := Or.inr ⟨rfl, hlt⟩
      have hRcol : (Tree.node (cols.dropLast ++ [lc.dropLast ++ [(q, replaceAt 0 0 Z rest.length h)]])).colAt
          ⟨(ci, ei) :: rest, oc⟩ = (replaceAt 0 0 Z rest.length h).colAt ⟨rest, oc⟩ := by
        rw [colAt_cons, hRci]
        simp only [Option.bind_some, hRei]
      have hFcol : (Tree.node cols).colAt ⟨(ci, ei) :: rest, oc⟩ = h.colAt ⟨rest, oc⟩ := by
        rw [colAt_cons, hcolci]
        simp only [Option.bind_some, heiq]
      rw [hRcol, hFcol, container_cons]
      rcases ih h hroute' hlast' ⟨rest, oc⟩ ho' with ⟨hn, heq⟩ | ⟨e, he, h1, h2⟩
      · exact Or.inl ⟨by rw [hn]; rfl, heq⟩
      · exact Or.inr ⟨⟨⟨(ci, ei) :: rest, oc⟩, e.idx⟩, by rw [he]; rfl, h1, h2⟩

-- G9.4m: a context `C_A(Z)` keeps every stack column of the stopping column: same parents, and
-- the same entries except the height of the active entry of a container
theorem colAt_context_onStack {A : Forest} {sd : StopData} (hsd : stopData A = some sd)
    (Z : Forest) {o : ColAddr} (ho : sd.col.OnStack o) :
    parents (context A sd Z) o = parents A o ∧
      (∀ e, o.container sd.col = some e →
        ((context A sd Z).colAt o).map (·.take e.idx) = (A.colAt o).map (·.take e.idx)) ∧
      (o.container sd.col = none → (context A sd Z).colAt o = A.colAt o) := by
  obtain ⟨-, hdepth, -, hroute, -⟩ := stopData_spec hsd
  obtain ⟨hpath, F, hF, hFlen⟩ := (Scan.mem_routeCols_iff _ _).mp hroute
  have hctx : context A sd Z = replaceAt 0 0 Z sd.col.path.length A := by
    unfold context; rw [hdepth]
  rw [hctx]
  obtain ⟨h1, h2, h3⟩ := replaceAt_colAt Z sd.col.path A hpath ⟨F, hF, hFlen⟩ o ho
  refine ⟨?_, h2, h3⟩
  unfold parents
  cases hR : (replaceAt 0 0 Z sd.col.path.length A).colAt o with
  | none =>
    cases hA : A.colAt o with
    | none => rfl
    | some _ => rw [hR, hA] at h1; cases h1
  | some C1 =>
    cases hA : A.colAt o with
    | none => rw [hR, hA] at h1; cases h1
    | some C2 => rw [hR, hA] at h1; simpa using h1

-- G9 (helper): columns of a forest below a step, when the step's column and entry are given
theorem colAt_cons_of {cols : List Column} {ci ei : Nat} {colci : Column} {q : Nat} {h : Forest}
    (hc : cols[ci]? = some colci) (he : colci[ei]? = some (q, h)) (π : List (Nat × Nat)) (col : Nat) :
    (Tree.node cols).colAt ⟨(ci, ei) :: π, col⟩ = h.colAt ⟨π, col⟩ := by
  rw [colAt_cons, hc]
  simp only [Option.bind_some, he]

-- G9 (helper): the column-level form of G9.4m', by induction along the route
theorem replaceAt_colAt_off (Z : Forest) (π : List (Nat × Nat)) (F : Forest)
    (hroute : Scan.IsRoutePath F π) {j : Nat}
    (hlast : ∃ G, F.forestAt π = some G ∧ G.cols.length = j + 1)
    (o : ColAddr) (ho : (F.colAt o).isSome) (hne : o ≠ ⟨π, j⟩)
    (hin : (⟨π, j⟩ : ColAddr).container o = none) (hnc : o.container ⟨π, j⟩ = none) :
    (replaceAt 0 0 Z π.length F).colAt o = F.colAt o := by
  induction π generalizing F o with
  | nil =>
    obtain ⟨cols⟩ := F
    obtain ⟨G, hG, hlen⟩ := hlast
    simp only [Tree.forestAt, Option.some.injEq] at hG
    subst hG
    simp only [Tree.cols] at hlen
    have hcne : cols ≠ [] := by intro h; rw [h] at hlen; simp at hlen
    rw [List.length_nil, replaceAt_zero_eq Z cols hcne]
    obtain ⟨op, oc⟩ := o
    cases op with
    | nil =>
      have hoc : oc < cols.length := by
        unfold Tree.colAt at ho
        simp only [Tree.forestAt, Option.bind_some, Tree.cols] at ho
        cases h : cols[oc]? with
        | none => rw [h] at ho; cases ho
        | some _ => exact (List.getElem?_eq_some_iff.mp h).1
      have hoj : oc ≠ j := fun h => hne (by rw [h])
      unfold Tree.colAt
      simp only [Tree.forestAt, Option.bind_some, Tree.cols]
      rw [List.getElem?_append_left (by simp; omega), List.getElem?_dropLast]
      simp [show oc < cols.length - 1 by omega]
    | cons s rest =>
      obtain ⟨c', e'⟩ := s
      have hc' : c' < cols.length := by
        rw [colAt_cons] at ho
        cases h : cols[c']? with
        | none => rw [h] at ho; cases ho
        | some _ => exact (List.getElem?_eq_some_iff.mp h).1
      have hcj : c' ≠ j := by
        intro h
        apply Option.some_ne_none (⟨⟨[], j⟩, e'⟩ : EntryAddr)
        rw [← hin]
        simp [ColAddr.container, h]
      rw [colAt_cons, colAt_cons]
      rw [List.getElem?_append_left (by simp; omega), List.getElem?_dropLast]
      simp [show c' < cols.length - 1 by omega]
  | cons s rest ih =>
    obtain ⟨ci, ei⟩ := s
    obtain ⟨cols⟩ := F
    obtain ⟨G0, hG0, hls⟩ := hroute 0 (by simp)
    simp only [List.take_zero, Tree.forestAt, Option.some.injEq] at hG0
    subst hG0
    unfold Tree.lastStep? at hls
    simp only [Tree.cols, List.getElem?_cons_zero] at hls
    obtain ⟨lc, hlc, hlcne, hci, hei⟩ : ∃ lc, cols.getLast? = some lc ∧ lc ≠ [] ∧
        ci = cols.length - 1 ∧ ei = lc.length - 1 := by
      cases hg : cols.getLast? with
      | none => rw [hg] at hls; cases hls
      | some lc =>
        rw [hg] at hls
        simp only [Option.bind_some] at hls
        split_ifs at hls with hemp
        simp only [Option.some.injEq, Prod.mk.injEq] at hls
        exact ⟨lc, rfl, by simpa using hemp, hls.1.symm, hls.2.symm⟩
    obtain ⟨pq, hpq⟩ : ∃ x, lc.getLast? = some x := by
      cases h : lc.getLast? with
      | none => simp at h; exact absurd h hlcne
      | some x => exact ⟨x, rfl⟩
    obtain ⟨q, h⟩ := pq
    have hcolci : cols[ci]? = some lc := by
      rw [hci, ← List.getLast?_eq_getElem?]; exact hlc
    have heiq : lc[ei]? = some (q, h) := by
      rw [hei, ← List.getLast?_eq_getElem?]; exact hpq
    have hcil : ci < cols.length := (List.getElem?_eq_some_iff.mp hcolci).1
    have heil : ei < lc.length := (List.getElem?_eq_some_iff.mp heiq).1
    have hR : replaceAt 0 0 Z ((ci, ei) :: rest).length (Tree.node cols) =
        .node (cols.dropLast ++ [lc.dropLast ++ [(q, replaceAt 0 0 Z rest.length h)]]) := by
      rw [List.length_cons, replaceAt_succ_eq, hlc]
      simp only [Option.map_some, Option.toList_some, hpq]
    rw [hR]
    have hlen1 : cols.dropLast.length = ci := by simp; omega
    have hlen2 : lc.dropLast.length = ei := by simp; omega
    have hRci : (cols.dropLast ++ [lc.dropLast ++ [(q, replaceAt 0 0 Z rest.length h)]])[ci]? =
        some (lc.dropLast ++ [(q, replaceAt 0 0 Z rest.length h)]) := by
      rw [List.getElem?_append_right (le_of_eq hlen1), hlen1, Nat.sub_self]; rfl
    have hRei : (lc.dropLast ++ [(q, replaceAt 0 0 Z rest.length h)])[ei]? =
        some (q, replaceAt 0 0 Z rest.length h) := by
      rw [List.getElem?_append_right (le_of_eq hlen2), hlen2, Nat.sub_self]; rfl
    have hroute' := isRoutePath_cons rfl hcolci heiq hroute
    have hlast' : ∃ G, h.forestAt rest = some G ∧ G.cols.length = j + 1 := by
      obtain ⟨G, hG, hl⟩ := hlast
      refine ⟨G, ?_, hl⟩
      simpa [Tree.forestAt, Tree.cols, hcolci, heiq] using hG
    obtain ⟨op, oc⟩ := o
    cases op with
    | nil =>
      have hoc : oc < cols.length := by
        unfold Tree.colAt at ho
        simp only [Tree.forestAt, Option.bind_some, Tree.cols] at ho
        cases h : cols[oc]? with
        | none => rw [h] at ho; cases ho
        | some _ => exact (List.getElem?_eq_some_iff.mp h).1
      have hoci : oc ≠ ci := by
        intro h
        apply Option.some_ne_none (⟨⟨[], oc⟩, ei⟩ : EntryAddr)
        rw [← hnc]
        simp [ColAddr.container, h]
      unfold Tree.colAt
      simp only [Tree.forestAt, Option.bind_some, Tree.cols]
      rw [List.getElem?_append_left (by omega), List.getElem?_dropLast]
      simp [show oc < cols.length - 1 by omega]
    | cons s rest_o =>
      obtain ⟨c', e'⟩ := s
      have hc' : c' < cols.length := by
        rw [colAt_cons] at ho
        cases h : cols[c']? with
        | none => rw [h] at ho; cases ho
        | some _ => exact (List.getElem?_eq_some_iff.mp h).1
      rcases Nat.lt_or_ge c' ci with hlt | hge
      · rw [colAt_cons, colAt_cons]
        rw [List.getElem?_append_left (by omega), List.getElem?_dropLast]
        simp [show c' < cols.length - 1 by omega]
      · have hc'ci : c' = ci := by omega
        subst hc'ci
        have he' : e' < lc.length := by
          rw [colAt_cons, hcolci] at ho
          simp only [Option.bind_some] at ho
          cases h : lc[e']? with
          | none => rw [h] at ho; cases ho
          | some _ => exact (List.getElem?_eq_some_iff.mp h).1
        rcases Nat.lt_or_ge e' ei with hlt | hge'
        · rw [colAt_cons, colAt_cons, hRci, hcolci]
          simp only [Option.bind_some]
          rw [List.getElem?_append_left (by omega), List.getElem?_dropLast]
          simp [show e' < lc.length - 1 by omega]
        · have he'ei : e' = ei := by omega
          subst he'ei
          rw [colAt_cons_of hRci hRei, colAt_cons_of hcolci heiq]
          rw [colAt_cons_of hcolci heiq] at ho
          rw [container_cons] at hin hnc
          apply ih h hroute' hlast' _ ho
          · intro heq
            apply hne
            simp only [ColAddr.mk.injEq] at heq ⊢
            rw [heq.1, heq.2]
            exact ⟨rfl, rfl⟩
          · cases hce : (⟨rest, j⟩ : ColAddr).container ⟨rest_o, oc⟩ with
            | none => rfl
            | some _ => rw [hce] at hin; cases hin
          · cases hce : (⟨rest_o, oc⟩ : ColAddr).container ⟨rest, j⟩ with
            | none => rfl
            | some _ => rw [hce] at hnc; cases hnc

-- G9.4m' (added by the G-009 verification, used by G9.6 for template columns off the stopping
-- column's stack): a context `C_A(Z)` keeps every column of `A` that is not the stopping column,
-- not inside one of its heights and not a container of it
theorem colAt_context_of_not_route {A : Forest} {sd : StopData} (hsd : stopData A = some sd)
    (Z : Forest) {o : ColAddr} (ho : o ∈ A.colAddrs) (hne : o ≠ sd.col)
    (hin : sd.col.container o = none) (hnc : o.container sd.col = none) :
    (context A sd Z).colAt o = A.colAt o := by
  obtain ⟨-, hdepth, -, hroute, -⟩ := stopData_spec hsd
  obtain ⟨hpath, F, hF, hFlen⟩ := (Scan.mem_routeCols_iff _ _).mp hroute
  have hctx : context A sd Z = replaceAt 0 0 Z sd.col.path.length A := by
    unfold context; rw [hdepth]
  rw [hctx]
  exact replaceAt_colAt_off Z sd.col.path A hpath ⟨F, hF, hFlen⟩ o
    ((Tree.mem_colAddrs_iff _ _).mp ho) hne hin hnc

-- G9.4n: the column of a root-tail phase copy is the shifted column of the shorter output
-- `A' = A[n−h]` (the first column of `localSuffix_phase`, T3.2i.6)
theorem colAt_phaseCol_tail (S : OrdStep) {h : Nat} (hh : 1 ≤ h ∧ h ≤ S.n) {o : ColAddr}
    (ho : IsTmplCol S.A S.sd S.rd o) (hoq : isQMat S.sd o = false) {A' : Forest}
    (hA' : expand S.A (S.n - h) = some A') :
    S.B.colAt ((phaseCol S.sd S.rd h o).getD o) =
      (A'.colAt o).map (Tree.mapCol (shiftVal S.sd.r (h * S.d))) := by
  obtain ⟨c, hc⟩ : ∃ c, phaseCol S.sd S.rd h o = some c := by
    have hker := ho.2.2.2
    unfold phaseCol
    cases hk : kerCol S.sd S.rd o with
    | none => rw [hk] at hker; cases hker
    | some a' => exact ⟨_, rfl⟩
  rw [hc, Option.getD_some]
  have hls := localSuffix_phase S.inL S.kind S.hsd S.hrd S.out hh ho hc hA'
  rw [hoq] at hls
  simp only [Bool.false_eq_true, if_false] at hls
  have key : ∀ (E : Forest) (a : ColAddr), E.colAt a = (localSuffix E a).cols.head? := by
    intro E a
    unfold localSuffix Tree.colAt
    cases E.forestAt a.path with
    | none => simp [Tree.cols, Tree.empty]
    | some f => simp [Tree.cols, List.head?_drop]
  rw [key S.B c, hls, key A' o]
  unfold shift
  generalize localSuffix A' o = L
  obtain ⟨cols⟩ := L
  cases cols with
  | nil => simp [Tree.map, Tree.mapCols, Tree.cols]
  | cons x xs => simp [Tree.map, Tree.mapCols, Tree.cols, OrdStep.d]

-- G9 (helper): columns no deeper than the stopping column are not Q-material
theorem isQMat_of_short (sd : StopData) {x : ColAddr} (h : x.path.length ≤ sd.col.path.length) :
    isQMat sd x = false := by
  unfold isQMat
  rw [List.drop_eq_nil_of_le h]
  simp

-- G9 (helper): the root column is not Q-material and maps to the head `⟨[], 0⟩`
theorem isQMat_rdcol (S : OrdStep) : isQMat S.sd S.rd.col = false := by
  obtain ⟨-, -, -, hpre, -⟩ := rootData_path S.hsd S.hrd
  exact isQMat_of_short S.sd hpre.length_le

theorem kerCol_rdcol (S : OrdStep) : kerCol S.sd S.rd S.rd.col = some ⟨[], 0⟩ := by
  obtain ⟨-, -, hidx, -⟩ := rootData_spec S.hsd S.hrd
  unfold kerCol
  simp only [isQMat_rdcol, List.take_length, List.drop_length, Bool.false_eq_true, if_false,
    if_true, hidx]

-- G9 (helper, D3.3a `expand_none_iff`): an ordinary step with an output has a defined kernel
theorem OrdStep.kernelDefined (S : OrdStep) : KernelDefined S.A S.rd := by
  have hE : S.A ≠ Tree.empty := by
    intro h
    have := S.hsd
    rw [h, stopData_eq_none_of_lastCol (Or.inl rfl)] at this
    cases this
  by_contra hk
  have := (expand_none_iff hE S.inL.1 S.inL.2.1 S.kind S.hsd S.hrd S.n).mpr ⟨S.pos, hk⟩
  rw [S.out] at this
  cases this

-- G9 (helper): the stopping column is template material (its image is the kernel hole)
theorem kerCol_sdcol (S : OrdStep) : ∃ kh, kerCol S.sd S.rd S.sd.col = some kh := by
  obtain ⟨hres, -, -, hpre, -, hown, hlast⟩ := rootData_path S.hsd S.hrd
  have hq : isQMat S.sd S.sd.col = false := isQMat_of_short S.sd le_rfl
  have hst := ((ColAddr.resolve_spec 0 _ _ _).mp hres).1
  obtain ⟨suf, hsuf⟩ := hpre
  cases suf with
  | nil =>
    rw [List.append_nil] at hsuf
    have hlt : S.rd.col.col < S.sd.col.col := by
      rcases hst with ⟨k, ck, ik, hk, hp, -⟩ | ⟨-, hlt⟩
      · exfalso
        have h1 := (List.getElem?_eq_some_iff.mp hk).1
        have h2 := congrArg List.length hp
        rw [List.length_take, hsuf] at h2
        omega
      · exact hlt
    have hown' : S.rd.owner = false := by
      cases h : S.rd.owner
      · rfl
      · exfalso
        have := hown.mp h
        simp [ColAddr.container, ← hsuf] at this
    exact Option.isSome_iff_exists.mp (kerCol_isSome_nil S hq hsuf.symm (Or.inr ⟨hlt, hown'⟩))
  | cons p rest =>
    obtain ⟨ci, e⟩ := p
    have hle : S.rd.col.col ≤ ci := by
      rcases hst with ⟨k, ck, ik, hk, hp, hle⟩ | ⟨hp, -⟩
      · have hkl := congrArg List.length hp
        rw [List.length_take, ← hsuf] at hkl
        rw [← hsuf] at hk
        have h1 := (List.getElem?_eq_some_iff.mp hk).1
        simp only [List.length_append, List.length_cons] at hkl h1
        have hk' : k = S.rd.col.path.length := by omega
        subst hk'
        rw [List.getElem?_append_right le_rfl, Nat.sub_self] at hk
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hk
        omega
      · exfalso
        rw [← hsuf] at hp
        have := congrArg List.length hp
        simp at this
    rcases Nat.eq_or_lt_of_le hle with heq | hlt
    · have hcont : S.rd.col.container S.sd.col = some ⟨S.rd.col, e⟩ := by
        simp [ColAddr.container, ← hsuf, heq]
      have hown' : S.rd.owner = true := hown.mpr (by rw [hcont]; rfl)
      have he := hlast _ hcont
      have hkd := S.kernelDefined hown'
      have hcur : S.rd.cursor ≤ e := by
        unfold unconsumed rootCol at hkd
        unfold Packet.rootLenOf at he
        by_contra hc
        exact hkd (List.drop_eq_nil_of_le (by simp only at he; omega))
      exact Option.isSome_iff_exists.mp
        (kerCol_isSome_cons S hq hsuf.symm (Or.inl ⟨heq.symm, hcur⟩))
    · have hown' : S.rd.owner = false := by
        cases h : S.rd.owner
        · rfl
        · exfalso
          have := hown.mp h
          simp [ColAddr.container, ← hsuf] at this
          omega
      exact Option.isSome_iff_exists.mp
        (kerCol_isSome_cons S hq hsuf.symm (Or.inr ⟨hlt, hown'⟩))

-- G9 (helper): template material other than the root has the root on its stack
theorem onStack_rdcol (S : OrdStep) {x x' : ColAddr} (hx : kerCol S.sd S.rd x = some x')
    (hxq : isQMat S.sd x = false) (hne : x ≠ S.rd.col) : x.OnStack S.rd.col := by
  obtain ⟨suf, hpath, hcases⟩ := kerCol_tail_spec S hx hxq
  rcases hcases with ⟨rfl, hc, -⟩ | ⟨rfl, hc, -, -⟩ | ⟨e, rest, rfl, -, -⟩ |
      ⟨ci, e, rest, rfl, hc, -, -⟩
  · exfalso
    apply hne
    show (⟨x.path, x.col⟩ : ColAddr) = ⟨S.rd.col.path, S.rd.col.col⟩
    rw [hpath, hc, List.append_nil]
  · exact Or.inr ⟨by rw [hpath, List.append_nil], hc⟩
  · refine Or.inl ⟨S.rd.col.path.length, S.rd.col.col, e, ?_, ?_, le_rfl⟩
    · rw [hpath, List.getElem?_append_right le_rfl, Nat.sub_self]; rfl
    · rw [hpath, List.take_left]
  · refine Or.inl ⟨S.rd.col.path.length, ci, e, ?_, ?_, hc.le⟩
    · rw [hpath, List.getElem?_append_right le_rfl, Nat.sub_self]; rfl
    · rw [hpath, List.take_left]

-- G9 (helper): iterated placements carry stacks and containment
theorem iterate_underCol_onStack (g : ColAddr) (n : Nat) {x y : ColAddr} (h : x.OnStack y) :
    ((underCol g)^[n] x).OnStack ((underCol g)^[n] y) := by
  induction n with
  | zero => exact h
  | succ n ih =>
    rw [Function.iterate_succ_apply', Function.iterate_succ_apply']
    exact (onStack_underCol g _ _).mpr (Or.inr ⟨_, ih, rfl⟩)

theorem iterate_underCol_container (g : ColAddr) (n : Nat) (o b : ColAddr) :
    ((underCol g)^[n] o).container ((underCol g)^[n] b) =
      (o.container b).map fun e => ⟨(underCol g)^[n] o, e.idx⟩ := by
  induction n with
  | zero =>
    simp only [Function.iterate_zero_apply]
    cases h : o.container b with
    | none => rfl
    | some e =>
      have := container_col h
      simp only [Option.map_some]
      rw [← this]
  | succ n ih =>
    rw [Function.iterate_succ_apply', Function.iterate_succ_apply', container_underCol, ih,
      Option.map_map]
    rfl

-- G9 (helper): the head contains a column exactly through the first step `(0, e)` of its path
theorem container_root_head {Z : ColAddr} {e : EntryAddr} (h : (⟨[], 0⟩ : ColAddr).container Z = some e) :
    Z.path.head? = some (0, e.idx) := by
  unfold ColAddr.container at h
  simp only [List.length_nil, List.drop_zero, List.take_zero] at h
  cases hp : Z.path with
  | nil => rw [hp] at h; cases h
  | cons p rest =>
    obtain ⟨k, j⟩ := p
    rw [hp] at h
    simp only [true_and] at h
    split_ifs at h with hk
    cases h
    simp [hk]

-- G9 (helper): an image of root-tail material entering the head does so through an entry `≥ m`
theorem kerCol_head_zero (S : OrdStep) {x x' : ColAddr} (hx : kerCol S.sd S.rd x = some x')
    (hxq : isQMat S.sd x = false) {j : Nat} (hj : x'.path.head? = some (0, j)) : S.m ≤ j := by
  obtain ⟨suf, -, hcases⟩ := kerCol_tail_spec S hx hxq
  rcases hcases with ⟨-, -, rfl⟩ | ⟨-, -, -, rfl⟩ | ⟨e, rest, -, -, rfl⟩ | ⟨ci, e, rest, -, hc, -, rfl⟩
  · simp at hj
  · simp at hj
  · simp only [List.head?_cons, Option.some.injEq, Prod.mk.injEq, true_and] at hj
    omega
  · simp only [List.head?_cons, Option.some.injEq, Prod.mk.injEq] at hj
    omega

-- G9 (helper): a kernel hole at the head level is a column `≥ 1`
theorem kerHole_col_pos (S : OrdStep) {kh : ColAddr} (hkh : kerCol S.sd S.rd S.sd.col = some kh)
    (hp : kh.path = []) : 1 ≤ kh.col := by
  have hsdq : isQMat S.sd S.sd.col = false := isQMat_of_short S.sd le_rfl
  obtain ⟨suf, hpath, hcases⟩ := kerCol_tail_spec S hkh hsdq
  obtain ⟨-, -, -, hrnum, hrt, -⟩ := rootData_spec S.hsd S.hrd
  obtain ⟨-, -, ht, -⟩ := stopData_spec S.hsd
  rcases hcases with ⟨rfl, hc, rfl⟩ | ⟨rfl, hc, -, rfl⟩ | ⟨e, rest, -, -, rfl⟩ |
      ⟨ci, e, rest, -, -, -, rfl⟩
  · exfalso
    have : S.sd.col = S.rd.col := by
      show (⟨S.sd.col.path, S.sd.col.col⟩ : ColAddr) = ⟨S.rd.col.path, S.rd.col.col⟩
      rw [hpath, hc, List.append_nil]
    rw [this] at ht
    omega
  · show 1 ≤ S.sd.col.col - S.rd.col.col
    omega
  · simp at hp
  · simp at hp

-- G9 (helper): the first step of a placement under the kernel hole
theorem underCol_kerHole_head (S : OrdStep) {kh : ColAddr}
    (hkh : kerCol S.sd S.rd S.sd.col = some kh) (z : ColAddr) {j : Nat}
    (hj : (underCol kh z).path.head? = some (0, j)) : S.m ≤ j := by
  have hsdq : isQMat S.sd S.sd.col = false := isQMat_of_short S.sd le_rfl
  obtain ⟨zp, zc⟩ := z
  cases hkp : kh.path with
  | nil =>
    have hpos := kerHole_col_pos S hkh hkp
    cases zp with
    | nil => simp [underCol, hkp] at hj
    | cons p rest =>
      obtain ⟨c0, e0⟩ := p
      simp only [underCol, hkp, List.nil_append, List.head?_cons, Option.some.injEq,
        Prod.mk.injEq] at hj
      omega
  | cons p rest =>
    have hhead : kh.path.head? = some (0, j) := by
      cases zp with
      | nil => simpa [underCol] using hj
      | cons q rest' =>
        obtain ⟨c0, e0⟩ := q
        simpa [underCol, hkp] using hj
    exact kerCol_head_zero S hkh hsdq hhead

-- G9 (helper): the cap column and the heads as iterated placements under the kernel hole
theorem phaseCol_eq_iterate (S : OrdStep) {kh : ColAddr} (hkh : kerCol S.sd S.rd S.sd.col = some kh)
    {i : Nat} {a a' : ColAddr} (ha' : kerCol S.sd S.rd a = some a') :
    phaseCol S.sd S.rd i a = some (underCol S.sd.col ((underCol kh)^[i - 1] a')) := by
  have hkerHole : kerHole S.sd S.rd = kh := by simp [kerHole, hkh]
  unfold phaseCol
  rw [ha', hkerHole]
  rfl

theorem headCol_eq (S : OrdStep) {kh : ColAddr} (hkh : kerCol S.sd S.rd S.sd.col = some kh)
    (h : Nat) : S.headCol h = underCol S.sd.col ((underCol kh)^[h - 1] ⟨[], 0⟩) := by
  unfold OrdStep.headCol
  rw [phaseCol_eq_iterate S hkh (kerCol_rdcol S)]
  rfl

-- G9 (helper): the template map at the root level
theorem kerCol_nil_eq (S : OrdStep) {o : ColAddr} (hoq : isQMat S.sd o = false)
    (hp : o.path = S.rd.col.path) :
    kerCol S.sd S.rd o = if o.col = S.rd.col.col then some ⟨[], 0⟩
      else if S.rd.col.col < o.col ∧ S.rd.owner = false then some ⟨[], o.col - S.rd.col.col⟩
      else none := by
  obtain ⟨-, -, hidx, -⟩ := rootData_spec S.hsd S.hrd
  unfold kerCol
  simp only [hoq, hp, List.take_length, List.drop_length, Bool.false_eq_true, if_false, if_true, hidx]

-- G9 (helper): the template map through a root-level step
theorem kerCol_cons_eq (S : OrdStep) {o : ColAddr} (hoq : isQMat S.sd o = false) {ci e : Nat}
    {rest : List (Nat × Nat)} (hp : o.path = S.rd.col.path ++ (ci, e) :: rest) :
    kerCol S.sd S.rd o = if ci = S.rd.col.col ∧ S.rd.cursor ≤ e then
        some ⟨(0, S.m + (e - S.rd.cursor)) :: rest, o.col⟩
      else if S.rd.col.col < ci ∧ S.rd.owner = false then some ⟨(ci - S.rd.col.col, e) :: rest, o.col⟩
      else none := by
  obtain ⟨-, -, hidx, -⟩ := rootData_spec S.hsd S.hrd
  unfold kerCol
  simp only [hoq, hp, List.take_left, List.drop_left, Bool.false_eq_true, if_false, if_true, hidx]
  rfl

-- G9 (helper): numbers of root-tail columns
theorem num_tail (S : OrdStep) {o : ColAddr} {s : List (Nat × Nat)} (hp : o.path = S.rd.col.path ++ s) :
    o.num 0 + S.rd.col.col = S.sd.r + (s.map (·.1 + 1)).sum + o.col := by
  obtain ⟨-, -, -, hrnum, -⟩ := rootData_spec S.hsd S.hrd
  rw [← hrnum]
  simp only [ColAddr.num, hp, List.map_append, List.sum_append]
  omega

-- G9.4s4, forward direction
theorem onStack_kerCol_tail_mp (S : OrdStep) {x x' : ColAddr} (hx : kerCol S.sd S.rd x = some x')
    (hxq : isQMat S.sd x = false) (o' : ColAddr) (h : x'.OnStack o') :
    ∃ o, x.OnStack o ∧ S.sd.r ≤ o.num 0 ∧ isQMat S.sd o = false ∧ kerCol S.sd S.rd o = some o' := by
  obtain ⟨-, -, -, hpre, -⟩ := rootData_path S.hsd S.hrd
  have hRq : ∀ {o : ColAddr}, o.path = S.rd.col.path → isQMat S.sd o = false := fun {o} hp =>
    isQMat_of_short S.sd (by rw [hp]; exact hpre.length_le)
  have hpq : ∀ {o : ColAddr}, o.path <+: x.path → isQMat S.sd o = false := fun {o} hp => by
    cases hq : isQMat S.sd o
    · rfl
    · have := isQMat_of_prefix S.sd hq hp; rw [hxq] at this; cases this
  obtain ⟨sx, hxp, hxc⟩ := kerCol_tail_spec S hx hxq
  obtain ⟨op, oc⟩ := o'
  -- the root column itself
  have hroot : ∀ (hne : x ≠ S.rd.col), ∃ o, x.OnStack o ∧ S.sd.r ≤ o.num 0 ∧
      isQMat S.sd o = false ∧ kerCol S.sd S.rd o = some ⟨[], 0⟩ :=
    fun hne => ⟨S.rd.col, onStack_rdcol S hx hxq hne,
      by rw [(rootData_spec S.hsd S.hrd).2.2.2.1], isQMat_rdcol S, kerCol_rdcol S⟩
  -- a root-level column `⟨R, idx + j⟩`
  have hlevel : ∀ j, (j = 0 ∨ S.rd.owner = false) → x.OnStack ⟨S.rd.col.path, S.rd.col.col + j⟩ →
      ∃ o, x.OnStack o ∧ S.sd.r ≤ o.num 0 ∧ isQMat S.sd o = false ∧
        kerCol S.sd S.rd o = some ⟨[], j⟩ := by
    intro j hj hst
    refine ⟨⟨S.rd.col.path, S.rd.col.col + j⟩, hst, ?_, hRq rfl, ?_⟩
    · have := num_tail S (o := ⟨S.rd.col.path, S.rd.col.col + j⟩) (s := []) (by simp)
      simp at this; omega
    · rw [kerCol_nil_eq S (o := ⟨S.rd.col.path, S.rd.col.col + j⟩) (hRq rfl) rfl]
      by_cases hj0 : j = 0
      · subst hj0; simp
      · have hown : S.rd.owner = false := hj.resolve_left hj0
        simp only [show ¬ (S.rd.col.col + j = S.rd.col.col) by omega, if_false, hown, and_true]
        rw [if_pos (by omega)]
        simp
  rcases hxc with ⟨rfl, hxc, rfl⟩ | ⟨rfl, hxc, hown, rfl⟩ | ⟨e, rest, rfl, he, rfl⟩ |
      ⟨ci, e, rest, rfl, hci, hown, rfl⟩
  · -- `x` is the root: its image `⟨[],0⟩` has an empty stack
    rcases h with ⟨l, _, _, hl, -, -⟩ | ⟨-, hlt⟩
    · simp at hl
    · simp at hlt
  · rcases h with ⟨l, _, _, hl, -, -⟩ | ⟨hp, hlt⟩
    · simp at hl
    · simp only at hp hlt
      subst hp
      have := hlevel oc (Or.inr hown) (Or.inr ⟨by rw [hxp, List.append_nil], by simp only; omega⟩)
      exact this
  · have hne : x ≠ S.rd.col := by
      intro h; rw [h] at hxp; have := congrArg List.length hxp; simp at this
    rcases h with ⟨l, ck, ik, hl, hp, hle⟩ | ⟨hp, hlt⟩
    · simp only at hp hle
      cases l with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hl
        simp only [List.take_zero] at hp
        subst hp
        rw [show oc = 0 by omega]
        exact hroot hne
      | succ l =>
        simp only [List.getElem?_cons_succ] at hl
        simp only [List.take_succ_cons] at hp
        subst hp
        have hp' : (⟨S.rd.col.path ++ (S.rd.col.col, e) :: rest.take l, oc⟩ : ColAddr).path <+:
            x.path := by
          rw [hxp]; exact List.prefix_append_right_inj _ |>.mpr (List.cons_prefix_cons.mpr ⟨rfl, List.take_prefix _ _⟩)
        refine ⟨⟨S.rd.col.path ++ (S.rd.col.col, e) :: rest.take l, oc⟩, ?_, ?_, hpq hp', ?_⟩
        · refine Or.inl ⟨S.rd.col.path.length + (l + 1), ck, ik, ?_, ?_, hle⟩
          · rw [hxp, List.getElem?_append_right (by omega), Nat.add_sub_cancel_left]
            simpa using hl
          · rw [hxp, List.take_length_add_append]; rfl
        · have := num_tail S (o := ⟨S.rd.col.path ++ (S.rd.col.col, e) :: rest.take l, oc⟩) rfl
          simp at this; omega
        · rw [kerCol_cons_eq S (hpq hp') rfl, if_pos ⟨rfl, he⟩]
    · simp only at hp hlt
      subst hp
      refine ⟨⟨x.path, oc⟩, Or.inr ⟨rfl, hlt⟩, ?_, hpq (List.prefix_refl _), ?_⟩
      · have := num_tail S (o := ⟨x.path, oc⟩) hxp
        simp at this; omega
      · rw [kerCol_cons_eq S (o := ⟨x.path, oc⟩) (hpq (List.prefix_refl _)) hxp,
          if_pos ⟨rfl, he⟩]
  · rcases h with ⟨l, ck, ik, hl, hp, hle⟩ | ⟨hp, hlt⟩
    · simp only at hp hle
      cases l with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hl
        simp only [List.take_zero] at hp
        subst hp
        refine hlevel oc (Or.inr hown) (Or.inl ⟨S.rd.col.path.length, ci, e, ?_, ?_, by simp only; omega⟩)
        · rw [hxp, List.getElem?_append_right le_rfl, Nat.sub_self]; rfl
        · rw [hxp, List.take_left]
      | succ l =>
        simp only [List.getElem?_cons_succ] at hl
        simp only [List.take_succ_cons] at hp
        subst hp
        have hp' : (⟨S.rd.col.path ++ (ci, e) :: rest.take l, oc⟩ : ColAddr).path <+: x.path := by
          rw [hxp]; exact List.prefix_append_right_inj _ |>.mpr (List.cons_prefix_cons.mpr ⟨rfl, List.take_prefix _ _⟩)
        refine ⟨⟨S.rd.col.path ++ (ci, e) :: rest.take l, oc⟩, ?_, ?_, hpq hp', ?_⟩
        · refine Or.inl ⟨S.rd.col.path.length + (l + 1), ck, ik, ?_, ?_, hle⟩
          · rw [hxp, List.getElem?_append_right (by omega), Nat.add_sub_cancel_left]
            simpa using hl
          · rw [hxp, List.take_length_add_append]; rfl
        · have := num_tail S (o := ⟨S.rd.col.path ++ (ci, e) :: rest.take l, oc⟩) rfl
          simp at this; omega
        · rw [kerCol_cons_eq S (hpq hp') rfl, if_neg (by omega), if_pos ⟨hci, hown⟩]
    · simp only at hp hlt
      subst hp
      refine ⟨⟨x.path, oc⟩, Or.inr ⟨rfl, hlt⟩, ?_, hpq (List.prefix_refl _), ?_⟩
      · have := num_tail S (o := ⟨x.path, oc⟩) hxp
        simp at this; omega
      · rw [kerCol_cons_eq S (o := ⟨x.path, oc⟩) (hpq (List.prefix_refl _)) hxp,
          if_neg (by omega), if_pos ⟨hci, hown⟩]

-- G9.4s4, backward direction
theorem onStack_kerCol_tail_mpr (S : OrdStep) {x x' : ColAddr} (hx : kerCol S.sd S.rd x = some x')
    (hxq : isQMat S.sd x = false) {o o' : ColAddr} (hst : x.OnStack o) (_hr : S.sd.r ≤ o.num 0)
    (hoq : isQMat S.sd o = false) (ho : kerCol S.sd S.rd o = some o') : x'.OnStack o' := by
  obtain ⟨-, -, -, hrnum, -⟩ := rootData_spec S.hsd S.hrd
  obtain ⟨sx, hxp, hxc⟩ := kerCol_tail_spec S hx hxq
  obtain ⟨so, hop, hoc⟩ := kerCol_tail_spec S ho hoq
  -- the stack of `x` is `o`'s path as a prefix of `x`'s
  have hlen : o.path.length ≤ x.path.length := by
    rcases hst with ⟨k, -, -, -, hp, -⟩ | ⟨hp, -⟩
    · rw [hp, List.length_take]; omega
    · rw [hp]
  rcases hoc with ⟨rfl, hoc, rfl⟩ | ⟨rfl, hoc, hown, rfl⟩ | ⟨e₀, rest_o, rfl, he₀, rfl⟩ |
      ⟨ci₀, e₀, rest_o, rfl, hci₀, hown, rfl⟩
  · -- `o` is the root column, imaged to the head `⟨[], 0⟩`
    rw [List.append_nil] at hop
    rcases hxc with ⟨rfl, hxc, rfl⟩ | ⟨rfl, hxc, -, rfl⟩ | ⟨e, rest, rfl, -, rfl⟩ |
        ⟨ci, e, rest, rfl, hci, -, rfl⟩
    · exfalso
      have h1 := ColAddr.num_lt_of_onStack 0 hst
      have h2 := num_tail S (o := o) (s := []) (by simpa using hop)
      have h3 := num_tail S (o := x) (s := []) (by simpa using hxp)
      simp at h2 h3
      omega
    · exact Or.inr ⟨rfl, by simp only; omega⟩
    · exact Or.inl ⟨0, 0, S.m + (e - S.rd.cursor), rfl, rfl, by simp only; omega⟩
    · exact Or.inl ⟨0, ci - S.rd.col.col, e, rfl, rfl, by simp only; omega⟩
  · -- `o` a later root-level column
    rw [List.append_nil] at hop
    rcases hxc with ⟨rfl, hxc, rfl⟩ | ⟨rfl, hxc, -, rfl⟩ | ⟨e, rest, rfl, -, rfl⟩ |
        ⟨ci, e, rest, rfl, hci, -, rfl⟩
    · rw [List.append_nil] at hxp
      rcases hst with ⟨k, _, _, hk, hp, _⟩ | ⟨_, hlt⟩
      · exfalso
        have h1 := (List.getElem?_eq_some_iff.mp hk).1
        have := congrArg List.length hp
        rw [List.length_take, hop, hxp] at this
        rw [hxp] at h1
        omega
      · exfalso; omega
    · rw [List.append_nil] at hxp
      rcases hst with ⟨k, _, _, hk, hp, _⟩ | ⟨_, hlt⟩
      · exfalso
        have h1 := (List.getElem?_eq_some_iff.mp hk).1
        have := congrArg List.length hp
        rw [List.length_take, hop, hxp] at this
        rw [hxp] at h1
        omega
      · exact Or.inr ⟨rfl, by simp only; omega⟩
    · exfalso
      rcases hst with ⟨k, ck, ik, hk, hp, hle⟩ | ⟨hp, -⟩
      · have hk' : k = S.rd.col.path.length := by
          have := congrArg List.length hp
          rw [List.length_take, hop, hxp] at this
          simp at this; omega
        subst hk'
        rw [hxp, List.getElem?_append_right le_rfl, Nat.sub_self] at hk
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hk
        omega
      · rw [hop, hxp] at hp
        have := congrArg List.length hp
        simp at this
    · rcases hst with ⟨k, ck, ik, hk, hp, hle⟩ | ⟨hp, -⟩
      · have hk' : k = S.rd.col.path.length := by
          have := congrArg List.length hp
          rw [List.length_take, hop, hxp] at this
          simp at this; omega
        subst hk'
        rw [hxp, List.getElem?_append_right le_rfl, Nat.sub_self] at hk
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hk
        exact Or.inl ⟨0, ci - S.rd.col.col, e, rfl, rfl, by simp only; omega⟩
      · exfalso
        rw [hop, hxp] at hp
        have := congrArg List.length hp
        simp at this
  · -- `o` inside a restored height of the root: `x` passes through the same step
    rcases hxc with ⟨rfl, -, rfl⟩ | ⟨rfl, -, -, rfl⟩ | ⟨e, rest, rfl, -, rfl⟩ |
        ⟨ci, e, rest, rfl, hci, -, rfl⟩
    · exfalso; rw [hop, hxp] at hlen; simp at hlen
    · exfalso; rw [hop, hxp] at hlen; simp at hlen
    · rcases hst with ⟨k, ck, ik, hk, hp, hle⟩ | ⟨hp, hlt⟩
      · have hkl : k < x.path.length := (List.getElem?_eq_some_iff.mp hk).1
        have hk' : k = S.rd.col.path.length + (rest_o.length + 1) := by
          have := congrArg List.length hp
          rw [List.length_take, Nat.min_eq_left hkl.le, hop] at this
          simp at this; omega
        subst hk'
        rw [hop, hxp, List.take_length_add_append, List.take_succ_cons] at hp
        have hp' := List.append_cancel_left hp
        simp only [List.cons.injEq, Prod.mk.injEq, true_and] at hp'
        obtain ⟨rfl, hrest⟩ := hp'
        rw [hxp, List.getElem?_append_right (by omega), Nat.add_sub_cancel_left] at hk
        simp only [List.getElem?_cons_succ] at hk
        refine Or.inl ⟨rest_o.length + 1, ck, ik, ?_, ?_, hle⟩
        · simpa using hk
        · show (0, S.m + (e₀ - S.rd.cursor)) :: rest_o = _
          rw [List.take_succ_cons, ← hrest]
      · rw [hop, hxp] at hp
        have hp' := List.append_cancel_left hp
        simp only [List.cons.injEq, Prod.mk.injEq, true_and] at hp'
        obtain ⟨rfl, rfl⟩ := hp'
        exact Or.inr ⟨rfl, hlt⟩
    · exfalso
      rcases hst with ⟨k, ck, ik, hk, hp, hle⟩ | ⟨hp, hlt⟩
      · have hkl : k < x.path.length := (List.getElem?_eq_some_iff.mp hk).1
        have hk' : S.rd.col.path.length < k := by
          have := congrArg List.length hp
          rw [List.length_take, Nat.min_eq_left hkl.le, hop] at this
          simp at this; omega
        obtain ⟨j, rfl⟩ : ∃ j, k = S.rd.col.path.length + (j + 1) := ⟨k - S.rd.col.path.length - 1, by omega⟩
        rw [hop, hxp, List.take_length_add_append, List.take_succ_cons] at hp
        have hp' := List.append_cancel_left hp
        simp only [List.cons.injEq, Prod.mk.injEq] at hp'
        omega
      · rw [hop, hxp] at hp
        have hp' := List.append_cancel_left hp
        simp only [List.cons.injEq, Prod.mk.injEq] at hp'
        omega
  · -- `o` in a later body column of the root forest
    rcases hxc with ⟨rfl, -, rfl⟩ | ⟨rfl, -, -, rfl⟩ | ⟨e, rest, rfl, -, rfl⟩ |
        ⟨ci, e, rest, rfl, hci, -, rfl⟩
    · exfalso; rw [hop, hxp] at hlen; simp at hlen
    · exfalso; rw [hop, hxp] at hlen; simp at hlen
    · exfalso
      rcases hst with ⟨k, ck, ik, hk, hp, hle⟩ | ⟨hp, hlt⟩
      · have hkl : k < x.path.length := (List.getElem?_eq_some_iff.mp hk).1
        have hk' : S.rd.col.path.length < k := by
          have := congrArg List.length hp
          rw [List.length_take, Nat.min_eq_left hkl.le, hop] at this
          simp at this; omega
        obtain ⟨j, rfl⟩ : ∃ j, k = S.rd.col.path.length + (j + 1) := ⟨k - S.rd.col.path.length - 1, by omega⟩
        rw [hop, hxp, List.take_length_add_append, List.take_succ_cons] at hp
        have hp' := List.append_cancel_left hp
        simp only [List.cons.injEq, Prod.mk.injEq] at hp'
        omega
      · rw [hop, hxp] at hp
        have hp' := List.append_cancel_left hp
        simp only [List.cons.injEq, Prod.mk.injEq] at hp'
        omega
    · rcases hst with ⟨k, ck, ik, hk, hp, hle⟩ | ⟨hp, hlt⟩
      · have hkl : k < x.path.length := (List.getElem?_eq_some_iff.mp hk).1
        have hk' : k = S.rd.col.path.length + (rest_o.length + 1) := by
          have := congrArg List.length hp
          rw [List.length_take, Nat.min_eq_left hkl.le, hop] at this
          simp at this; omega
        subst hk'
        rw [hop, hxp, List.take_length_add_append, List.take_succ_cons] at hp
        have hp' := List.append_cancel_left hp
        simp only [List.cons.injEq, Prod.mk.injEq] at hp'
        obtain ⟨⟨rfl, rfl⟩, hrest⟩ := hp'
        rw [hxp, List.getElem?_append_right (by omega), Nat.add_sub_cancel_left] at hk
        simp only [List.getElem?_cons_succ] at hk
        refine Or.inl ⟨rest_o.length + 1, ck, ik, ?_, ?_, hle⟩
        · simpa using hk
        · show (ci₀ - S.rd.col.col, e₀) :: rest_o = _
          rw [List.take_succ_cons, ← hrest]
      · rw [hop, hxp] at hp
        have hp' := List.append_cancel_left hp
        simp only [List.cons.injEq, Prod.mk.injEq] at hp'
        obtain ⟨⟨rfl, rfl⟩, rfl⟩ := hp'
        exact Or.inr ⟨rfl, hlt⟩

-- G9.4s4 (moved here from before G9.4s4b: its proof uses `onStack_rdcol`): on root-tail material `kerCol` is a stack isomorphism onto the kernel output, with
-- `num (kerCol o) = num o − r`, and it carries containment
theorem onStack_kerCol_tail (S : OrdStep) {x x' : ColAddr} (hx : kerCol S.sd S.rd x = some x')
    (hxq : isQMat S.sd x = false) (o' : ColAddr) :
    x'.OnStack o' ↔ ∃ o, x.OnStack o ∧ S.sd.r ≤ o.num 0 ∧ isQMat S.sd o = false ∧
      kerCol S.sd S.rd o = some o' := by
  constructor
  · exact onStack_kerCol_tail_mp S hx hxq o'
  · rintro ⟨o, hst, hr, hoq, ho⟩
    exact onStack_kerCol_tail_mpr S hx hxq hst hr hoq ho

-- G9.4a: the heads `s_1, …, s_φ` are on the stack of `c`; a head containing `c` does so through
-- an entry of index `≥ m` (a restored entry)
theorem resolve_headCol (S : OrdStep) {i : Nat} {a c : ColAddr} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) {h : Nat} (hh : 1 ≤ h ∧ h ≤ phaseOff S.sd i a) :
    c.resolve 0 (S.s h) = some (S.headCol h) ∧
      ∀ e, (S.headCol h).container c = some e → S.m ≤ e.idx := by
  obtain ⟨hres, hrnum, -⟩ := rootData_path S.hsd S.hrd
  have hsdq : isQMat S.sd S.sd.col = false := isQMat_of_short S.sd le_rfl
  have hsd_rd : S.sd.col.OnStack S.rd.col := ((ColAddr.resolve_spec 0 _ _ _).mp hres).1
  obtain ⟨kh, hkh⟩ := kerCol_sdcol S
  obtain ⟨b₀, hb₀⟩ := Option.isSome_iff_exists.mp ha.2.2.2
  have hcdef : c = underCol S.sd.col ((underCol kh)^[i - 1] b₀) := by
    rw [phaseCol_eq_iterate S hkh hb₀] at hc
    exact (Option.some.inj hc).symm
  have hhead := headCol_eq S hkh h
  have hφ : phaseOff S.sd i a ≤ i := by unfold phaseOff; split_ifs <;> omega
  have hhi : h ≤ i := by omega
  have hsplit : (underCol kh)^[i - 1] b₀ = (underCol kh)^[h - 1] ((underCol kh)^[i - h] b₀) := by
    rw [← Function.iterate_add_apply]
    congr 1
    omega
  have hroot : ∀ {x x' : ColAddr}, kerCol S.sd S.rd x = some x' → isQMat S.sd x = false →
      x.OnStack S.rd.col → x'.OnStack ⟨[], 0⟩ := fun hx hxq hst =>
    (onStack_kerCol_tail S hx hxq _).mpr ⟨S.rd.col, hst, by rw [hrnum], isQMat_rdcol S, kerCol_rdcol S⟩
  -- `⟨[],0⟩` (the head of the layer) is on the stack of `Z = G^{i−h} b₀`, and `Z` enters it
  -- through an entry `≥ m`
  have hZ : ((underCol kh)^[i - h] b₀).OnStack ⟨[], 0⟩ ∧
      ∀ j, ((underCol kh)^[i - h] b₀).path.head? = some (0, j) → S.m ≤ j := by
    rcases Nat.eq_or_lt_of_le hhi with heq | hlt
    · rw [heq, Nat.sub_self, Function.iterate_zero_apply]
      have haq : isQMat S.sd a = false := by
        cases hqa : isQMat S.sd a
        · rfl
        · simp only [phaseOff, hqa, if_true] at hh
          omega
      exact ⟨hroot hb₀ haq (onStack_rdcol S hb₀ haq ha.2.2.1),
        fun j hj => kerCol_head_zero S hb₀ haq hj⟩
    · obtain ⟨j, hj⟩ : ∃ j, i - h = j + 1 := ⟨i - h - 1, by omega⟩
      rw [hj, Function.iterate_succ_apply']
      exact ⟨(onStack_underCol kh _ _).mpr (Or.inl (hroot hkh hsdq hsd_rd)),
        fun j' hj' => underCol_kerHole_head S hkh _ hj'⟩
  have hst : c.OnStack (S.headCol h) := by
    rw [hcdef, hhead, hsplit]
    exact (onStack_underCol _ _ _).mpr (Or.inr ⟨_, iterate_underCol_onStack kh (h - 1) hZ.1, rfl⟩)
  have hnum : (S.headCol h).num 0 = S.s h := by
    have hpc : phaseCol S.sd S.rd h S.rd.col = some (S.headCol h) := by
      rw [phaseCol_eq_iterate S hkh (kerCol_rdcol S), hhead]
    rw [num_phaseCol S.inL S.kind S.hsd S.hrd (Or.inl rfl) hh.1 hpc, hrnum]
    simp [phaseOff, isQMat_rdcol, OrdStep.s, OrdStep.d]
  refine ⟨(ColAddr.resolve_spec 0 _ _ _).mpr ⟨hst, hnum⟩, ?_⟩
  intro e he
  rw [hcdef, hhead, hsplit, container_underCol, iterate_underCol_container] at he
  cases hz : (⟨[], 0⟩ : ColAddr).container ((underCol kh)^[i - h] b₀) with
  | none => rw [hz] at he; cases he
  | some e' =>
    rw [hz] at he
    simp only [Option.map_some, Option.some.injEq] at he
    rw [← he]
    exact hZ.2 e'.idx (container_root_head hz)

-- G9 (helper): a container of the stopping column contains it through its last entry
theorem container_sdcol_last (S : OrdStep) {o : ColAddr} {e : EntryAddr}
    (h : o.container S.sd.col = some e) : e.idx + 1 = (parents S.A o).length := by
  obtain ⟨-, -, -, hroute, -⟩ := stopData_spec S.hsd
  obtain ⟨hpath, -⟩ := (Scan.mem_routeCols_iff _ _).mp hroute
  unfold ColAddr.container at h
  cases hd : S.sd.col.path.drop o.path.length with
  | nil => rw [hd] at h; cases h
  | cons p rest =>
    obtain ⟨k, j⟩ := p
    rw [hd] at h
    simp only at h
    split_ifs at h with hc
    cases h
    obtain ⟨htake, hk⟩ := hc
    have hlt : o.path.length < S.sd.col.path.length := by
      by_contra hcon
      rw [List.drop_eq_nil_of_le (by omega)] at hd
      cases hd
    obtain ⟨F, hF, hlast⟩ := hpath o.path.length hlt
    rw [htake] at hF
    have hget : S.sd.col.path[o.path.length]? = some (k, j) := by
      rw [← List.head?_drop, hd]; rfl
    rw [hget] at hlast
    unfold Tree.lastStep? at hlast
    cases hcl : F.cols.getLast? with
    | none => rw [hcl] at hlast; cases hlast
    | some col =>
      rw [hcl] at hlast
      simp only [Option.bind_some] at hlast
      split_ifs at hlast with hemp
      simp only [Option.some.injEq, Prod.mk.injEq] at hlast
      obtain ⟨h1, h2⟩ := hlast
      have hcol : S.A.colAt o = some col := by
        unfold Tree.colAt
        rw [hF]
        simp only [Option.bind_some]
        rw [← hk, ← h1, ← List.getLast?_eq_getElem?]
        exact hcl
      simp only [parents, hcol, Option.getD_some, List.length_map]
      have : col.length ≠ 0 := by simpa using hemp
      omega

-- G9 (helper): numbers of iterated placements
theorem num_iterate_underCol (g : ColAddr) (n : Nat) (z : ColAddr) :
    ((underCol g)^[n] z).num 0 = n * g.num 0 + z.num 0 := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Function.iterate_succ_apply', num_underCol, ih, Nat.succ_mul]
    omega

-- G9.4b: for `h < φ`, the phase-`h` copies of the stopping column's stack columns between `r` and
-- `t` are on the stack of `c` at numbers `x + h d`, and they contain `c` exactly when the old
-- columns contain the stopping column, through the same (last) entry
theorem resolve_copyCol (S : OrdStep) {i : Nat} {a c : ColAddr} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) {h : Nat} (hh : h < phaseOff S.sd i a)
    {x : Nat} {o : ColAddr} (hx : S.sd.r < x) (hxt : x < S.sd.t)
    (ho : S.sd.col.resolve 0 x = some o) :
    c.resolve 0 (x + h * S.d) = some (S.copyCol h o) ∧
      (S.copyCol h o).container c = (o.container S.sd.col).map (fun e => ⟨S.copyCol h o, e.idx⟩) ∧
      ∀ e, o.container S.sd.col = some e → e.idx + 1 = (parents S.A o).length := by
  obtain ⟨hst, hnum⟩ := (ColAddr.resolve_spec 0 _ _ _).mp ho
  obtain ⟨-, -, ht, -⟩ := stopData_spec S.hsd
  obtain ⟨-, -, -, hrnum, hrt, -⟩ := rootData_spec S.hsd S.hrd
  have hsdq : isQMat S.sd S.sd.col = false := isQMat_of_short S.sd le_rfl
  obtain ⟨kh, hkh⟩ := kerCol_sdcol S
  obtain ⟨b₀, hb₀⟩ := Option.isSome_iff_exists.mp ha.2.2.2
  have hcdef : c = underCol S.sd.col ((underCol kh)^[i - 1] b₀) := by
    rw [phaseCol_eq_iterate S hkh hb₀] at hc
    exact (Option.some.inj hc).symm
  obtain ⟨hoker, hoq⟩ := kerCol_of_onStack_tail S hkh hsdq hst (by omega)
  obtain ⟨o', ho'⟩ := Option.isSome_iff_exists.mp hoker
  have hne : o ≠ S.rd.col := by
    intro h; rw [h] at hnum; omega
  refine ⟨?_, ?_, fun e he => container_sdcol_last S he⟩
  · -- resolution
    rw [ColAddr.resolve_spec]
    rcases Nat.eq_zero_or_pos h with h0 | hpos
    · subst h0
      simp only [OrdStep.copyCol, if_true, Nat.zero_mul, Nat.add_zero]
      exact ⟨by rw [hcdef]; exact (onStack_underCol _ _ _).mpr (Or.inl hst), hnum⟩
    · have hcopy : S.copyCol h o = underCol S.sd.col ((underCol kh)^[h - 1] o') := by
        simp only [OrdStep.copyCol, if_neg (show h ≠ 0 by omega)]
        rw [phaseCol_eq_iterate S hkh ho']
        rfl
      have hφ : phaseOff S.sd i a ≤ i := by unfold phaseOff; split_ifs <;> omega
      have hsplit : (underCol kh)^[i - 1] b₀ =
          (underCol kh)^[h - 1] ((underCol kh)^[i - h] b₀) := by
        rw [← Function.iterate_add_apply]
        congr 1
        omega
      obtain ⟨j, hj⟩ : ∃ j, i - h = j + 1 := ⟨i - h - 1, by omega⟩
      have hkho' : kh.OnStack o' :=
        (onStack_kerCol_tail S hkh hsdq o').mpr ⟨o, hst, by omega, hoq, ho'⟩
      have hZ : ((underCol kh)^[i - h] b₀).OnStack o' := by
        rw [hj, Function.iterate_succ_apply']
        exact (onStack_underCol kh _ _).mpr (Or.inl hkho')
      rw [hcopy]
      refine ⟨?_, ?_⟩
      · rw [hcdef, hsplit]
        exact (onStack_underCol _ _ _).mpr
          (Or.inr ⟨_, iterate_underCol_onStack kh (h - 1) hZ, rfl⟩)
      · have h1 := num_kerCol_tail S hkh hsdq
        have h2 := num_kerCol_tail S ho' hoq
        rw [num_underCol, num_iterate_underCol]
        simp only [OrdStep.d, period]
        rw [← ht] at h1
        have : (h - 1) * kh.num 0 + kh.num 0 = h * kh.num 0 := by
          rw [← Nat.succ_mul]; congr 1; omega
        have hd : kh.num 0 = S.sd.t - S.sd.r := by omega
        rw [← hd]
        omega
  · -- containment
    rcases Nat.eq_zero_or_pos h with h0 | hpos
    · subst h0
      simp only [OrdStep.copyCol, if_true]
      rw [hcdef, container_underCol_of_onStack hst]
      cases hce : o.container S.sd.col with
      | none => rfl
      | some e =>
        simp only [Option.map_some, Option.some.injEq]
        rw [← container_col hce]
    · have hcopy : S.copyCol h o = underCol S.sd.col ((underCol kh)^[h - 1] o') := by
        simp only [OrdStep.copyCol, if_neg (show h ≠ 0 by omega)]
        rw [phaseCol_eq_iterate S hkh ho']
        rfl
      have hφ : phaseOff S.sd i a ≤ i := by unfold phaseOff; split_ifs <;> omega
      have hsplit : (underCol kh)^[i - 1] b₀ =
          (underCol kh)^[h - 1] ((underCol kh)^[i - h] b₀) := by
        rw [← Function.iterate_add_apply]
        congr 1
        omega
      obtain ⟨j, hj⟩ : ∃ j, i - h = j + 1 := ⟨i - h - 1, by omega⟩
      have hkho' : kh.OnStack o' :=
        (onStack_kerCol_tail S hkh hsdq o').mpr ⟨o, hst, by omega, hoq, ho'⟩
      rw [hcopy, hcdef, hsplit, container_underCol, iterate_underCol_container, hj,
        Function.iterate_succ_apply', container_underCol_of_onStack hkho',
        container_kerCol S hkh ho' hsdq]
      simp only [if_neg hne, Option.map_map]
      rfl

-- G9 (helper): the stack columns of the stopping column are columns of `A`
theorem mem_colAddrs_of_sdstack (S : OrdStep) {o : ColAddr} (ho : S.sd.col.OnStack o) :
    o ∈ S.A.colAddrs := by
  obtain ⟨-, -, hmem, -⟩ := rootData_col S.hsd S.hrd
  have := (Tree.stack_mem_prefix hmem).2.1 o ho
  have hr : Role.ord o ∈ S.A.roles := (List.takeWhile_sublist _).subset this
  rw [Tree.mem_colAddrs_iff]
  exact (Tree.mem_roles_iff _ _).mp hr

-- G9 (helper): the stack columns of the stopping column strictly between `r` and `t` are
-- non-Q template columns
theorem tmplCol_of_sdstack (S : OrdStep) {x : Nat} {o : ColAddr} (hx : S.sd.r < x)
    (hxt : x < S.sd.t) (ho : S.sd.col.resolve 0 x = some o) :
    IsTmplCol S.A S.sd S.rd o ∧ isQMat S.sd o = false := by
  obtain ⟨hst, hnum⟩ := (ColAddr.resolve_spec 0 _ _ _).mp ho
  obtain ⟨-, -, ht, -⟩ := stopData_spec S.hsd
  obtain ⟨-, -, -, hrnum, -⟩ := rootData_spec S.hsd S.hrd
  obtain ⟨kh, hkh⟩ := kerCol_sdcol S
  obtain ⟨hker, hoq⟩ := kerCol_of_onStack_tail S hkh (isQMat_of_short S.sd le_rfl) hst (by omega)
  refine ⟨⟨mem_colAddrs_of_sdstack S hst, ?_, ?_, hker⟩, hoq⟩
  · intro h; rw [h] at hnum; omega
  · intro h; rw [h] at hnum; omega

-- G9 (helper): a copy's column in `B` is the shifted column of a context of `A`
theorem colAt_copyCol (S : OrdStep) {h : Nat} (hh : h ≤ S.n) {o : ColAddr}
    (ho : IsTmplCol S.A S.sd S.rd o) (hoq : isQMat S.sd o = false) :
    ∃ Z, S.B.colAt (S.copyCol h o) =
      ((context S.A S.sd Z).colAt o).map (Tree.mapCol (shiftVal S.sd.r (h * S.d))) := by
  have hE : S.A ≠ Tree.empty := by
    intro h
    have := S.hsd
    rw [h, stopData_eq_none_of_lastCol (Or.inl rfl)] at this
    cases this
  have hit := expand_eq_iterate hE S.inL.1 S.inL.2.1 S.kind S.hsd S.hrd S.kernelDefined
  rcases Nat.eq_zero_or_pos h with h0 | hpos
  · subst h0
    refine ⟨(kernel S.A S.sd S.rd)^[S.n] Tree.empty, ?_⟩
    have hB : S.B = context S.A S.sd ((kernel S.A S.sd S.rd)^[S.n] Tree.empty) := by
      have := hit S.n
      rw [S.out] at this
      exact Option.some.inj this
    simp only [OrdStep.copyCol, if_true, Nat.zero_mul]
    rw [← hB]
    cases S.B.colAt o with
    | none => rfl
    | some col =>
      simp only [Option.map_some, mapCol_eq_map]
      congr 1
      conv_lhs => rw [← List.map_id col]
      congr 1
      funext x
      have h1 : shiftVal S.sd.r 0 x.1 = x.1 := by simp [shiftVal]
      have h2 : Tree.map (shiftVal S.sd.r 0) x.2 = x.2 := shift_zero S.sd.r x.2
      rw [h1, h2]
      rfl
  · refine ⟨(kernel S.A S.sd S.rd)^[S.n - h] Tree.empty, ?_⟩
    have hA' := hit (S.n - h)
    simp only [OrdStep.copyCol, if_neg (show h ≠ 0 by omega)]
    rw [colAt_phaseCol_tail S ⟨hpos, hh⟩ ho hoq hA']

-- G9.4c: contents in `K` of a copy: parents shifted by `τ_h`, keys `κ_h`-related before the
-- active index `u` (all keys when the copy does not contain `c`)
theorem copyCol_litCap (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ) {h : Nat}
    (hh : h < phaseOff S.sd i a) {x : Nat} {o : ColAddr} (hx : S.sd.r < x) (hxt : x < S.sd.t)
    (ho : S.sd.col.resolve 0 x = some o) :
    parents (litCap S.B c k ρ) (S.copyCol h o) = (parents S.A o).map (shiftVal S.sd.r (h * S.d)) ∧
      (actualKeys (litCap S.B c k ρ) (S.copyCol h o)).take
          (((o.container S.sd.col).map (·.idx)).getD (parents S.A o).length) =
        kappaQ S.sd.r S.d h ((actualKeys S.A o).take
          (((o.container S.sd.col).map (·.idx)).getD (parents S.A o).length)) := by
  obtain ⟨hres, hcont, hlast⟩ := resolve_copyCol S hi ha hq hc hh hx hxt ho
  obtain ⟨hst, hnum⟩ := (ColAddr.resolve_spec 0 _ _ _).mp ho
  obtain ⟨hcst, hcnum⟩ := (ColAddr.resolve_spec 0 _ _ _).mp hres
  obtain ⟨hot, hoq⟩ := tmplCol_of_sdstack S hx hxt ho
  have hφ : phaseOff S.sd i a ≤ i := by unfold phaseOff; split_ifs <;> omega
  obtain ⟨Z, hBcol⟩ := colAt_copyCol S (show h ≤ S.n by omega) hot hoq
  obtain ⟨hcpar, hctake, hcnone⟩ := colAt_context_onStack S.hsd Z hst
  have hcmem : c ∈ S.B.colAddrs := by
    rw [Tree.mem_colAddrs_iff]
    unfold IsUpward at hup
    cases hB : S.B.colAt c with
    | none => rw [hB] at hup; exact hup.elim
    | some _ => rfl
  obtain ⟨hK1, hK2⟩ := colAt_litCap_onStack (k := k) (p := ρ) hcmem hcst
  -- `B` in terms of the context column `C`
  set C := ((context S.A S.sd Z).colAt o).getD [] with hC
  have hBget : (S.B.colAt (S.copyCol h o)).getD [] = Tree.mapCol (shiftVal S.sd.r (h * S.d)) C := by
    rw [hBcol, hC]
    cases (context S.A S.sd Z).colAt o <;> simp [Tree.mapCol]
  have hBpar : parents S.B (S.copyCol h o) = (parents S.A o).map (shiftVal S.sd.r (h * S.d)) := by
    rw [← hcpar]
    simp only [parents, hBget, mapCol_eq_map, List.map_map, ← hC]
    rfl
  have hBkeys : actualKeys S.B (S.copyCol h o) =
      kappaQ S.sd.r S.d h (actualKeys (context S.A S.sd Z) o) := by
    simp only [actualKeys, hBget, mapCol_eq_map, List.map_map, kappaQ, ← hC]
    congr 1
    funext y
    simp only [Function.comp_apply, WithTop.map_coe]
    rw [hcnum, ← hnum]
    exact congrArg _ (relKey_shift S.sd.r S.d h (o.num 0) (by omega) y.2)
  cases hce : o.container S.sd.col with
  | none =>
    rw [hce] at hcont
    simp only [Option.map_none] at hcont
    have hK := hK2 hcont
    have hctx := hcnone hce
    simp only [Option.map_none, Option.getD_none]
    refine ⟨?_, ?_⟩
    · simp only [parents, hK]; exact hBpar
    · have : actualKeys (litCap S.B c k ρ) (S.copyCol h o) = actualKeys S.B (S.copyCol h o) := by
        simp only [actualKeys, hK]
      rw [this, hBkeys]
      unfold kappaQ
      rw [List.map_take]
      simp only [actualKeys, hctx]
  | some e =>
    rw [hce] at hcont
    simp only [Option.map_some] at hcont
    obtain ⟨hKp, hKk⟩ := hK1 _ hcont
    have hl := hlast e hce
    simp only [Option.map_some, Option.getD_some]
    refine ⟨?_, ?_⟩
    · rw [hKp, hBpar]
      apply List.take_of_length_le
      simp only [List.length_map]
      omega
    · rw [hKk, hBkeys]
      unfold kappaQ
      rw [← List.map_take]
      congr 1
      have := hctake e hce
      simp only [actualKeys, ← List.map_take]
      congr 1
      cases h1 : (context S.A S.sd Z).colAt o with
      | none =>
        rw [h1] at this
        cases h2 : S.A.colAt o with
        | none => rfl
        | some _ => rw [h2] at this; cases this
      | some C1 =>
        rw [h1] at this
        cases h2 : S.A.colAt o with
        | none => rw [h2] at this; cases this
        | some C2 =>
          rw [h2] at this
          simpa using this

-- G9 (helper): the column of an upward cap exists
theorem mem_colAddrs_of_upward {B : Forest} {c : ColAddr} {k p : Nat} (hup : IsUpward B c k p) :
    c ∈ B.colAddrs := by
  rw [Tree.mem_colAddrs_iff]
  unfold IsUpward at hup
  cases hB : B.colAt c with
  | none => rw [hB] at hup; exact hup.elim
  | some _ => rfl

-- G9 (helper): the head of layer `h` is the phase-`h` copy of the root column
theorem phaseCol_headCol (S : OrdStep) (h : Nat) :
    phaseCol S.sd S.rd h S.rd.col = some (S.headCol h) := by
  obtain ⟨kh, hkh⟩ := kerCol_sdcol S
  rw [phaseCol_eq_iterate S hkh (kerCol_rdcol S), headCol_eq S hkh]

-- G9 (helper): the unconsumed root entries have parents below `r`
theorem unconsumed_parent_lt (S : OrdStep) {v : Nat} {x : Nat × Forest}
    (hx : (unconsumed S.A S.rd)[v]? = some x) : x.1 < S.sd.r := by
  obtain ⟨-, hrnum, -⟩ := rootData_path S.hsd S.hrd
  unfold unconsumed rootCol at hx
  rw [List.getElem?_drop] at hx
  have hent : S.A.entryAt ⟨S.rd.col, S.rd.cursor + v⟩ = some x := by
    unfold Tree.entryAt
    cases hR : S.A.colAt S.rd.col with
    | none => rw [hR] at hx; simp at hx
    | some R => rw [hR] at hx; exact hx
  have hmem : (⟨S.rd.col, S.rd.cursor + v⟩ : EntryAddr) ∈ S.A.entryAddrs := by
    rw [Tree.mem_entryAddrs_iff, hent]; rfl
  have := (condV_iff_lt S.A).mp S.inL.1 _ hmem x.1 x.2 hent
  rw [hrnum] at this
  exact this

-- G9.4d: contents in `K` of the head `s_h` (`1 ≤ h ≤ φ`): the query part `τ_{h−1}(Q)` with keys
-- `κ_{h−1}(y)`, then restored entries with parents `< r`
theorem headCol_litCap (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ) {h : Nat}
    (hh : 1 ≤ h ∧ h ≤ phaseOff S.sd i a) :
    (parents (litCap S.B c k ρ) (S.headCol h)).take S.m =
        ((parents S.A S.sd.col).take S.m).map (shiftVal S.sd.r ((h - 1) * S.d)) ∧
      (∀ v p, S.m ≤ v → (parents (litCap S.B c k ρ) (S.headCol h))[v]? = some p → p < S.sd.r) ∧
      (actualKeys (litCap S.B c k ρ) (S.headCol h)).take S.m =
        kappaQ S.sd.r S.d (h - 1) ((actualKeys S.A S.sd.col).take S.m) ∧
      S.m ≤ (actualKeys (litCap S.B c k ρ) (S.headCol h)).length := by
  obtain ⟨hres, hidx⟩ := resolve_headCol S hi ha hq hc hh
  obtain ⟨hcst, hHnum⟩ := (ColAddr.resolve_spec 0 _ _ _).mp hres
  obtain ⟨hcol, -, ht, -⟩ := stopData_spec S.hsd
  obtain ⟨-, -, -, hrnum, hrt, -⟩ := rootData_spec S.hsd S.hrd
  have hφ : phaseOff S.sd i a ≤ i := by unfold phaseOff; split_ifs <;> omega
  obtain ⟨col, hBcol, hlen, htake, hrest⟩ :=
    colAt_head S.inL S.kind S.hsd S.hrd S.out ⟨hh.1, by omega⟩ (phaseCol_headCol S h)
  obtain ⟨hK1, hK2⟩ := colAt_litCap_onStack (k := k) (p := ρ) (mem_colAddrs_of_upward hup) hcst
  have hm : S.sd.Q.length = S.m := rfl
  -- facts about `B`'s head column
  have hBpar : parents S.B (S.headCol h) = col.map Prod.fst := by simp [parents, hBcol]
  have hBpar_take : (parents S.B (S.headCol h)).take S.m =
      ((parents S.A S.sd.col).take S.m).map (shiftVal S.sd.r ((h - 1) * S.d)) := by
    rw [hBpar, ← List.map_take, ← hm, htake, mapCol_eq_map]
    simp only [parents, hcol, Option.getD_some, List.map_append, List.map_map]
    rw [List.take_left' (by simp), List.map_map]
    rfl
  have hBkeys_take : (actualKeys S.B (S.headCol h)).take S.m =
      kappaQ S.sd.r S.d (h - 1) ((actualKeys S.A S.sd.col).take S.m) := by
    simp only [actualKeys, hBcol, hcol, Option.getD_some, ← List.map_take, ← hm, htake,
      mapCol_eq_map, List.map_map, kappaQ]
    rw [List.take_left' (by simp)]
    congr 1
    funext y
    simp only [Function.comp_apply, WithTop.map_coe]
    rw [hHnum, ← ht]
    have : S.s h = S.sd.t + (h - 1) * S.d := by
      simp only [OrdStep.s, OrdStep.d, period]
      have : h * (S.sd.t - S.sd.r) = (h - 1) * (S.sd.t - S.sd.r) + (S.sd.t - S.sd.r) := by
        rw [← Nat.succ_mul]; congr 1; omega
      omega
    rw [this]
    exact congrArg _ (relKey_shift S.sd.r S.d (h - 1) S.sd.t hrt.le y.2)
  have hBbig : ∀ v p, S.m ≤ v → (parents S.B (S.headCol h))[v]? = some p → p < S.sd.r := by
    intro v p hv hp
    rw [hBpar, List.getElem?_map] at hp
    obtain ⟨v', rfl⟩ : ∃ v', v = S.m + v' := ⟨v - S.m, by omega⟩
    have hlt : v' < (unconsumed S.A S.rd).length := by
      have : S.m + v' < col.length := by
        by_contra hcon
        rw [List.getElem?_eq_none (by omega)] at hp
        cases hp
      omega
    obtain ⟨y, hy, hy1, -⟩ := hrest v' _ (List.getElem?_eq_getElem hlt)
    rw [← hm, hy] at hp
    simp only [Option.map_some, Option.some.injEq] at hp
    rw [← hp, hy1]
    exact unconsumed_parent_lt S (List.getElem?_eq_getElem hlt)
  have hBlen : S.m ≤ (parents S.B (S.headCol h)).length := by
    rw [hBpar, List.length_map, hlen]; omega
  have hlenK : ∀ E, (actualKeys E (S.headCol h)).length = (parents E (S.headCol h)).length := by
    intro E; rw [length_actualKeys]; simp [parents]
  cases hce : (S.headCol h).container c with
  | none =>
    have hK := hK2 hce
    have hp : parents (litCap S.B c k ρ) (S.headCol h) = parents S.B (S.headCol h) := by
      simp only [parents, hK]
    have hk : actualKeys (litCap S.B c k ρ) (S.headCol h) = actualKeys S.B (S.headCol h) := by
      simp only [actualKeys, hK]
    rw [hp, hk, hlenK]
    exact ⟨hBpar_take, hBbig, hBkeys_take, hBlen⟩
  | some e =>
    obtain ⟨hKp, hKk⟩ := hK1 e hce
    have he := hidx e hce
    refine ⟨?_, ?_, ?_, ?_⟩
    · rw [hKp, List.take_take, Nat.min_eq_left (by omega)]
      exact hBpar_take
    · intro v p hv hp
      rw [hKp, List.getElem?_take] at hp
      split_ifs at hp
      · exact hBbig v p hv hp
    · have := congrArg (List.take S.m) hKk
      rw [List.take_take, List.take_take, Nat.min_eq_left he] at this
      rw [this]
      exact hBkeys_take
    · rw [hlenK, hKp, List.length_take]
      omega

-- G9 (helper): splitting an address path at a step
theorem path_split {π : List (Nat × Nat)} {k ck ik : Nat} (hk : π[k]? = some (ck, ik)) :
    π = π.take k ++ (ck, ik) :: π.drop (k + 1) := by
  have hkl : k < π.length := (List.getElem?_eq_some_iff.mp hk).1
  have hget : π[k] = (ck, ik) := by
    rw [List.getElem?_eq_getElem hkl] at hk
    exact Option.some.inj hk
  conv_lhs => rw [← List.take_append_drop k π, List.drop_eq_getElem_cons hkl, hget]

-- G9 (helper): a step into an existing forest has an existing column
theorem forestAt_cons_some {G F : Forest} {ck ik : Nat} {rest : List (Nat × Nat)}
    (h : G.forestAt ((ck, ik) :: rest) = some F) : ck < G.cols.length := by
  simp only [Tree.forestAt] at h
  cases hc : G.cols[ck]? with
  | none => rw [hc] at h; simp at h
  | some _ => exact (List.getElem?_eq_some_iff.mp hc).1

-- G9 (helper): the stack columns of a column of `E` are columns of `E`
theorem mem_colAddrs_of_onStack {E : Forest} {c o : ColAddr} (hc : c ∈ E.colAddrs)
    (ho : c.OnStack o) : o ∈ E.colAddrs := by
  rw [Tree.mem_colAddrs_iff] at hc ⊢
  unfold Tree.colAt at hc ⊢
  cases hF : E.forestAt c.path with
  | none => rw [hF] at hc; cases hc
  | some F =>
    rw [hF] at hc
    simp only [Option.bind_some] at hc
    rcases ho with ⟨k, ck, ik, hk, hp, hle⟩ | ⟨hp, hlt⟩
    · have hsplit := path_split hk
      rw [hsplit, Tree.forestAt_append] at hF
      cases hG : E.forestAt (c.path.take k) with
      | none => rw [hG] at hF; cases hF
      | some G =>
        rw [hG] at hF
        simp only [Option.bind_some] at hF
        have hck := forestAt_cons_some hF
        rw [hp, hG]
        simp only [Option.bind_some]
        rw [List.getElem?_eq_getElem (by omega)]
        rfl
    · rw [hp, hF]
      simp only [Option.bind_some]
      have : c.col < F.cols.length := by
        cases h : F.cols[c.col]? with
        | none => rw [h] at hc; cases hc
        | some _ => exact (List.getElem?_eq_some_iff.mp h).1
      rw [List.getElem?_eq_getElem (by omega)]
      rfl

-- G9 (helper): the stopping column is on the stack of no non-Q column of `A`
theorem not_onStack_sdcol (S : OrdStep) {a : ColAddr} (ha : a ∈ S.A.colAddrs)
    (haq : isQMat S.sd a = false) : ¬ a.OnStack S.sd.col := by
  intro hst
  obtain ⟨hcol, -, -, hroute, -⟩ := stopData_spec S.hsd
  obtain ⟨-, F, hF, hFlen⟩ := (Scan.mem_routeCols_iff _ _).mp hroute
  have hcolF : F.cols[S.sd.col.col]? = some (S.sd.Q ++ [(S.sd.r, Tree.empty)]) := by
    unfold Tree.colAt at hcol
    rw [hF] at hcol
    simpa using hcol
  rw [Tree.mem_colAddrs_iff] at ha
  unfold Tree.colAt at ha
  rcases hst with ⟨k, ck, ik, hk, hp, hle⟩ | ⟨hp, hlt⟩
  · have hsplit := path_split hk
    have hkl : k < a.path.length := (List.getElem?_eq_some_iff.mp hk).1
    rw [← hp] at hsplit
    rw [hsplit, Tree.forestAt_append, hF] at ha
    simp only [Option.bind_some] at ha
    cases hG : F.forestAt ((ck, ik) :: a.path.drop (k + 1)) with
    | none => rw [hG] at ha; cases ha
    | some G =>
      rw [hG] at ha
      simp only [Option.bind_some] at ha
      have hck := forestAt_cons_some hG
      have hck' : ck = S.sd.col.col := by omega
      subst hck'
      simp only [Tree.forestAt, hcolF, Option.bind_some] at hG
      rcases Nat.lt_trichotomy ik S.sd.Q.length with hik | hik | hik
      · -- inside a query height: `a` would be Q-material
        apply Bool.false_ne_true
        rw [← haq]
        unfold isQMat
        rw [hsplit, List.take_left, List.drop_left]
        simp [hik]
      · -- inside the empty height of `(r, ∅)`
        subst hik
        rw [List.getElem?_append_right le_rfl, Nat.sub_self] at hG
        simp only [List.getElem?_cons_zero] at hG
        cases hrest : a.path.drop (k + 1) with
        | nil =>
          rw [hrest] at hG
          simp only [Tree.forestAt, Option.some.injEq] at hG
          subst hG
          simp [Tree.empty, Tree.cols] at ha
        | cons q rest =>
          obtain ⟨c', e'⟩ := q
          rw [hrest] at hG
          simp [Tree.forestAt, Tree.empty, Tree.cols] at hG
      · rw [List.getElem?_eq_none (by simp; omega)] at hG
        simp at hG
  · rw [← hp, hF] at ha
    simp only [Option.bind_some] at ha
    have : a.col < F.cols.length := by
      cases h : F.cols[a.col]? with
      | none => rw [h] at ha; cases ha
      | some _ => exact (List.getElem?_eq_some_iff.mp h).1
    omega

-- G9 (helper): the stack of an iterated placement
theorem iterate_underCol_onStack_cases (g : ColAddr) (n : Nat) (z w : ColAddr)
    (h : ((underCol g)^[n] z).OnStack w) :
    (∃ j < n, ∃ w₂, g.OnStack w₂ ∧ w = (underCol g)^[j] w₂) ∨
      (∃ w₂, z.OnStack w₂ ∧ w = (underCol g)^[n] w₂) := by
  induction n generalizing w with
  | zero => exact Or.inr ⟨w, h, rfl⟩
  | succ n ih =>
    rw [Function.iterate_succ_apply'] at h
    rcases (onStack_underCol g _ _).mp h with h1 | ⟨w', hw', rfl⟩
    · exact Or.inl ⟨0, by omega, w, h1, rfl⟩
    · rcases ih w' hw' with ⟨j, hj, w₂, hw₂, rfl⟩ | ⟨w₂, hw₂, rfl⟩
      · exact Or.inl ⟨j + 1, by omega, w₂, hw₂, by rw [Function.iterate_succ_apply']⟩
      · exact Or.inr ⟨w₂, hw₂, by rw [Function.iterate_succ_apply']⟩

-- G9 (helper): a literal cap keeps a prefix of the parents of every stack column
theorem parents_litCap_subset {B : Forest} {c o : ColAddr} {k p : Nat} (hc : c ∈ B.colAddrs)
    (ho : c.OnStack o) {q : Nat} (hq : q ∈ parents (litCap B c k p) o) : q ∈ parents B o := by
  obtain ⟨h1, h2⟩ := colAt_litCap_onStack (k := k) (p := p) hc ho
  cases hce : o.container c with
  | none =>
    have := h2 hce
    simp only [parents, this] at hq ⊢
    exact hq
  | some e =>
    rw [(h1 e hce).1] at hq
    exact List.mem_of_mem_take hq

-- G9 (helper): shifted parents are `< r` or `≥ r + δ`
theorem shiftVal_dich (r δ p : Nat) : shiftVal r δ p < r ∨ r + δ ≤ shiftVal r δ p := by
  unfold shiftVal
  split_ifs <;> omega

-- G9 (helper): every parent of a mapped column is an image
theorem parents_of_mapCol {E : Forest} {o : ColAddr} {f : Nat → Nat} {C : Option Column}
    (h : E.colAt o = C.map (Tree.mapCol f)) : ∀ p ∈ parents E o, ∃ p₀, p = f p₀ := by
  intro p hp
  simp only [parents, h] at hp
  cases C with
  | none => simp at hp
  | some col =>
    simp only [Option.map_some, Option.getD_some, mapCol_eq_map, List.map_map, List.mem_map] at hp
    obtain ⟨x, -, rfl⟩ := hp
    exact ⟨x.1, rfl⟩

-- G9.4e: every column on the stack of `c` above `s_φ` has parents `< r` or `≥ s_φ` in `K`
-- (generalizes T3.8ln from `c` to its stack)
theorem stack_parent_dichotomy (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat}
    (hi : 1 ≤ i ∧ i ≤ S.n) (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ) {x : Nat} {o : ColAddr}
    (hx : S.s (phaseOff S.sd i a) < x) (ho : c.resolve 0 x = some o) :
    ∀ p ∈ parents (litCap S.B c k ρ) o, p < S.sd.r ∨ S.s (phaseOff S.sd i a) ≤ p := by
  obtain ⟨hst, hnum⟩ := (ColAddr.resolve_spec 0 _ _ _).mp ho
  obtain ⟨-, -, ht, -⟩ := stopData_spec S.hsd
  obtain ⟨-, -, -, hrnum, hrt, -⟩ := rootData_spec S.hsd S.hrd
  have hsdq : isQMat S.sd S.sd.col = false := isQMat_of_short S.sd le_rfl
  obtain ⟨kh, hkh⟩ := kerCol_sdcol S
  obtain ⟨b₀, hb₀⟩ := Option.isSome_iff_exists.mp ha.2.2.2
  have hcdef : c = underCol S.sd.col ((underCol kh)^[i - 1] b₀) := by
    rw [phaseCol_eq_iterate S hkh hb₀] at hc
    exact (Option.some.inj hc).symm
  have hφ1 : 1 ≤ phaseOff S.sd i a := by
    unfold phaseOff
    split_ifs with hqa
    · have := hq hqa; omega
    · omega
  have hφi : phaseOff S.sd i a ≤ i := by unfold phaseOff; split_ifs <;> omega
  have hφi' : i - 1 ≤ phaseOff S.sd i a := by unfold phaseOff; split_ifs <;> omega
  have hd : kh.num 0 = S.d := by
    have := num_kerCol_tail S hkh hsdq
    simp only [OrdStep.d, period]
    omega
  have htd : S.sd.t = S.sd.r + S.d := by simp only [OrdStep.d, period]; omega
  have hsφ : S.s (phaseOff S.sd i a) = S.sd.r + phaseOff S.sd i a * S.d := rfl
  intro p hp
  have hpB := parents_litCap_subset (mem_colAddrs_of_upward hup) hst hp
  have hshift : ∀ C : Option Column,
      S.B.colAt o = C.map (Tree.mapCol (shiftVal S.sd.r (phaseOff S.sd i a * S.d))) →
      p < S.sd.r ∨ S.s (phaseOff S.sd i a) ≤ p := by
    intro C hC
    obtain ⟨p₀, rfl⟩ := parents_of_mapCol hC p hpB
    exact shiftVal_dich _ _ _
  rw [hcdef] at hst
  rcases (onStack_underCol _ _ _).mp hst with h1 | ⟨o₁, ho₁, rfl⟩
  · -- on the stopping column's stack: below `t = s_1 ≤ s_φ`
    exfalso
    have h2 := ColAddr.num_lt_of_onStack 0 h1
    have h3 : 1 * S.d ≤ phaseOff S.sd i a * S.d := Nat.mul_le_mul_right _ hφ1
    omega
  · rcases iterate_underCol_onStack_cases kh (i - 1) b₀ o₁ ho₁ with
      ⟨j, hj, w₂, hw₂, rfl⟩ | ⟨w₂, hw₂, rfl⟩
    · -- a phase-`(j+1)` copy of a column of the stopping column's stack
      obtain ⟨o₀, ho₀, hr₀, hq₀, hk₀⟩ := (onStack_kerCol_tail S hkh hsdq w₂).mp hw₂
      have hn₀ := ColAddr.num_lt_of_onStack 0 ho₀
      have hnw := num_kerCol_tail S hk₀ hq₀
      have hxeq : x = S.sd.t + j * S.d + w₂.num 0 := by
        rw [← hnum, num_underCol, num_iterate_underCol, hd, ← ht]
        omega
      have hjφ : j + 1 = phaseOff S.sd i a := by
        have hlt : phaseOff S.sd i a * S.d < (j + 2) * S.d := by
          rw [Nat.add_mul]; omega
        have := Nat.lt_of_mul_lt_mul_right hlt
        omega
      have hr₀' : S.sd.r < o₀.num 0 := by
        rcases Nat.eq_or_lt_of_le hr₀ with h | h
        · exfalso
          have h5 : phaseOff S.sd i a * S.d = j * S.d + S.d := by
            rw [← hjφ, Nat.succ_mul]
          omega
        · exact h
      obtain ⟨hot, hoq⟩ := tmplCol_of_sdstack S hr₀' (by omega)
        ((ColAddr.resolve_spec 0 _ _ _).mpr ⟨ho₀, rfl⟩)
      obtain ⟨Z, hZ⟩ := colAt_copyCol S (h := phaseOff S.sd i a) (by omega) hot hoq
      have hcopy : S.copyCol (phaseOff S.sd i a) o₀ = underCol S.sd.col ((underCol kh)^[j] w₂) := by
        simp only [OrdStep.copyCol, if_neg (show phaseOff S.sd i a ≠ 0 by omega)]
        rw [phaseCol_eq_iterate S hkh hk₀, Option.getD_some, show phaseOff S.sd i a - 1 = j by omega]
      rw [hcopy] at hZ
      exact hshift _ hZ
    · by_cases haq : isQMat S.sd a = true
      · -- Q-material: the head of layer `i`, or a Q-material copy (phase `i − 1 = φ`)
        have hφeq : phaseOff S.sd i a = i - 1 := by simp [phaseOff, haq]
        rcases (onStack_kerCol_qmat S hb₀ haq w₂).mp hw₂ with rfl | ⟨o₀, ho₀, hq₀, hk₀⟩
        · obtain ⟨col, hBcol, hlen, htake, hrest⟩ :=
            colAt_head S.inL S.kind S.hsd S.hrd S.out hi (phaseCol_headCol S i)
          rw [← headCol_eq S hkh] at hpB
          simp only [parents, hBcol, Option.getD_some, List.mem_map] at hpB
          obtain ⟨y, hy, rfl⟩ := hpB
          obtain ⟨v, hv⟩ := List.mem_iff_getElem?.mp hy
          by_cases hvm : v < S.sd.Q.length
          · have h1 : (col.take S.sd.Q.length)[v]? = some y := by
              rw [List.getElem?_take_of_lt hvm]; exact hv
            rw [htake, mapCol_eq_map, List.getElem?_map] at h1
            cases hQv : S.sd.Q[v]? with
            | none => rw [hQv] at h1; cases h1
            | some q =>
              rw [hQv] at h1
              simp only [Option.map_some, Option.some.injEq] at h1
              rw [← h1, hsφ, hφeq]
              exact shiftVal_dich _ _ _
          · left
            obtain ⟨v', rfl⟩ : ∃ v', v = S.sd.Q.length + v' := ⟨v - S.sd.Q.length, by omega⟩
            have hvl : v' < (unconsumed S.A S.rd).length := by
              have : S.sd.Q.length + v' < col.length := (List.getElem?_eq_some_iff.mp hv).1
              omega
            obtain ⟨y', hy', hy1, -⟩ := hrest v' _ (List.getElem?_eq_getElem hvl)
            rw [hv, Option.some.injEq] at hy'
            rw [hy', hy1]
            exact unconsumed_parent_lt S (List.getElem?_eq_getElem hvl)
        · have hot : IsTmplCol S.A S.sd S.rd o₀ := by
            refine ⟨mem_colAddrs_of_onStack ha.1 ho₀, ?_, ?_, by rw [hk₀]; rfl⟩
            · intro h; rw [h, hsdq] at hq₀; cases hq₀
            · intro h; rw [h, isQMat_rdcol] at hq₀; cases hq₀
          have hroute : ¬ OnHoleRoute S.sd o₀ := fun h => by
            have := isQMat_of_short S.sd h.length_le
            rw [hq₀] at this
            cases this
          have := colAt_phaseCol S.inL S.kind S.hsd S.hrd S.out hi hot hroute
            (phaseCol_eq_iterate S hkh (i := i) hk₀)
          rw [show phaseOff S.sd i o₀ = phaseOff S.sd i a by simp [phaseOff, hq₀, haq]] at this
          exact hshift _ this
      · -- root-tail material: a phase-`i` copy
        have haq' : isQMat S.sd a = false := by simpa using haq
        obtain ⟨o₀, ho₀, hr₀, hq₀, hk₀⟩ := (onStack_kerCol_tail S hb₀ haq' w₂).mp hw₂
        have hφeq : phaseOff S.sd i a = i := by simp [phaseOff, haq']
        have hne_rd : o₀ ≠ S.rd.col := by
          intro h
          rw [h, kerCol_rdcol, Option.some.injEq] at hk₀
          subst hk₀
          have hxeq : x = S.sd.t + (i - 1) * S.d := by
            rw [← hnum, num_underCol, num_iterate_underCol, hd, ← ht]
            simp [ColAddr.num]
          have h5 : i * S.d = (i - 1) * S.d + S.d := by
            rw [← Nat.succ_mul]; congr 1; omega
          rw [hsφ, hφeq] at hx
          omega
        have hne_sd : o₀ ≠ S.sd.col := fun h => not_onStack_sdcol S ha.1 haq' (h ▸ ho₀)
        have hot : IsTmplCol S.A S.sd S.rd o₀ :=
          ⟨mem_colAddrs_of_onStack ha.1 ho₀, hne_sd, hne_rd, by rw [hk₀]; rfl⟩
        obtain ⟨Z, hZ⟩ := colAt_copyCol S (h := i) hi.2 hot hq₀
        have hcopy : S.copyCol i o₀ = underCol S.sd.col ((underCol kh)^[i - 1] w₂) := by
          simp only [OrdStep.copyCol, if_neg (show i ≠ 0 by omega)]
          rw [phaseCol_eq_iterate S hkh hk₀, Option.getD_some]
        rw [hcopy] at hZ
        have hZ' : S.B.colAt (underCol S.sd.col ((underCol kh)^[i - 1] w₂)) =
            ((context S.A S.sd Z).colAt o₀).map
              (Tree.mapCol (shiftVal S.sd.r (phaseOff S.sd i a * S.d))) := by
          rw [hφeq]; exact hZ
        exact hshift _ hZ'

/-! ## G9.5 — the invariant: low heads detour along copies of the old terminal-to-root path -/

-- G9.5a (txt:391-393, 553-560): at a head `s_h`, `1 ≤ h ≤ φ`, whose query `V = κ_{h−1}(W')` is low
-- (`W' < Z`): (i) the response of `s_h` is `τ_{h−1}(q_j)`, `j = cursor y W'`; (ii) every edge
-- `x → y` of the old `g_{W'}` orbit at a column `x ∈ (r, t)` of the stopping column's stack is
-- copied to the edge `x + (h−1)d → τ_{h−1}(y)` of `K`, provided `K`'s cut path reaches
-- `x + (h−1)d` (the cut barrier of `K` then protects a copy that contains `c`)
theorem detour_copy (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) {h : Nat} (hh : 1 ≤ h ∧ h ≤ phaseOff S.sd i a)
    {W' : List (WithTop Key)} (hW' : Noninc W') (hV : S.capQ c k ρ = kappaQ S.sd.r S.d (h - 1) W')
    (hlow : W' < S.termZ) :
    (∃ q, (parents S.A S.sd.col)[cursor (actualKeys S.A S.sd.col) W']? = some q ∧
      Edge (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c (S.capQ c k ρ) (S.s h)
        (q + (h - 1) * S.d)) ∧
    ∀ x y, S.sd.r < x → x < S.sd.t → Edge S.A (actualKeys S.A) S.sd.col W' x y →
      Path (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c (S.capQ c k ρ)
        (cutStart (litCap S.B c k ρ) c k) (x + (h - 1) * S.d) →
      Edge (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c (S.capQ c k ρ) (x + (h - 1) * S.d)
        (shiftVal S.sd.r ((h - 1) * S.d) y) := by
  obtain ⟨hjm, q, hqget, hrq, -, -⟩ := term_detour S hW' hlow
  have hh' : h - 1 < phaseOff S.sd i a := by omega
  have hst := kappaQry_strictMono S.sd.r S.d (h - 1)
  have hVn : Noninc (S.capQ c k ρ) := cutQuery_noninc _ _
  refine ⟨⟨q, hqget, ?_⟩, ?_⟩
  · -- (i) the head edge
    obtain ⟨hres, -⟩ := resolve_headCol S hi ha hq hc hh
    obtain ⟨hpar, -, hkeys, -⟩ := headCol_litCap S hi ha hq hc hup hh
    refine ⟨S.headCol h, hres, ?_⟩
    have hcur : cursor (actualKeys (litCap S.B c k ρ) (S.headCol h)) (S.capQ c k ρ) =
        cursor (actualKeys S.A S.sd.col) W' := by
      have e1 := cursor_take (actualKeys (litCap S.B c k ρ) (S.headCol h)) (S.capQ c k ρ) S.m
      rw [hkeys, hV] at e1
      unfold kappaQ at e1
      rw [cursor_map hst, cursor_take] at e1
      rw [hV]
      unfold kappaQ
      omega
    rw [resp_eq_parents, hcur, ← List.getElem?_take_of_lt hjm, hpar, List.getElem?_map,
      List.getElem?_take_of_lt hjm, hqget]
    simp [shiftVal, hrq]
  · -- (ii) the copy step
    intro x y hx hxt hxy hreach
    obtain ⟨o, ho, hresp⟩ := hxy
    obtain ⟨hres, hcont, hlast⟩ := resolve_copyCol S hi ha hq hc hh' hx hxt ho
    obtain ⟨hparK, hkeysK⟩ := copyCol_litCap S hi ha hq hc hup hh' hx hxt ho
    refine ⟨S.copyCol (h - 1) o, hres, ?_⟩
    rw [resp_eq_parents] at hresp ⊢
    have hjxlt : cursor (actualKeys S.A o) W' < (parents S.A o).length := by
      by_contra hcon
      rw [List.getElem?_eq_none (by omega)] at hresp
      cases hresp
    have hlenK : (actualKeys (litCap S.B c k ρ) (S.copyCol (h - 1) o)).length =
        (parents S.A o).length := by
      rw [length_actualKeys, ← List.length_map (f := Prod.fst)]
      show (parents _ _).length = _
      rw [hparK, List.length_map]
    have hjxu : cursor (actualKeys S.A o) W' ≤
        ((o.container S.sd.col).map (·.idx)).getD (parents S.A o).length := by
      cases hce : o.container S.sd.col with
      | none => simp only [Option.map_none, Option.getD_none]; omega
      | some e =>
        have := hlast e hce
        simp only [Option.map_some, Option.getD_some]
        omega
    have hcurK : cursor (actualKeys (litCap S.B c k ρ) (S.copyCol (h - 1) o)) (S.capQ c k ρ) ≤
        ((o.container S.sd.col).map (·.idx)).getD (parents S.A o).length := by
      cases hce : o.container S.sd.col with
      | none =>
        simp only [Option.map_none, Option.getD_none]
        rw [← hlenK]
        exact cursor_le_length _ _
      | some e =>
        simp only [Option.map_some, Option.getD_some]
        rw [hce] at hcont
        simp only [Option.map_some] at hcont
        obtain ⟨hcmem, hplen⟩ := litCap_parents_self hup
        have hbar := cut_barrier_read hKL hcmem (by omega) hreach hres hcont
        have hlt := hlast e hce
        exact cursor_le_of_lt_cutQuery hVn (by omega) hbar
    have hcurA : cursor (kappaQ S.sd.r S.d (h - 1) (actualKeys S.A o)) (S.capQ c k ρ) =
        cursor (actualKeys S.A o) W' := by
      rw [hV]
      exact cursor_map hst _ _
    have heq : cursor (actualKeys (litCap S.B c k ρ) (S.copyCol (h - 1) o)) (S.capQ c k ρ) =
        cursor (actualKeys S.A o) W' := by
      rw [← hcurA]
      refine cursor_eq_of_take_eq ?_ hcurK (hcurA ▸ hjxu)
      rw [hkeysK]
      unfold kappaQ
      rw [List.map_take]
    rw [heq, hparK, List.getElem?_map, hresp]
    rfl

-- G9.5 (the invariant, `low_head_detour`): if `K`'s cut path reaches a low head `s_h`,
-- `1 ≤ h ≤ φ`, it continues to `s_{h−1}` (`s_0 = r`) along the `τ_{h−1}`-copy of the old
-- terminal-to-root path at `W'`
theorem low_head_detour (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) {h : Nat} (hh : 1 ≤ h ∧ h ≤ phaseOff S.sd i a)
    {W' : List (WithTop Key)} (hW' : Noninc W') (hV : S.capQ c k ρ = kappaQ S.sd.r S.d (h - 1) W')
    (hlow : W' < S.termZ)
    (hreach : Path (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c (S.capQ c k ρ)
      (cutStart (litCap S.B c k ρ) c k) (S.s h)) :
    Path (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c (S.capQ c k ρ) (S.s h)
      (S.s (h - 1)) := by
  have hVA : CondV S.A := S.inL.1
  obtain ⟨⟨q', hq', hedge⟩, hcopy⟩ := detour_copy S hi ha hq hc hup hKL hh hW' hV hlow
  obtain ⟨_, q, hqget, hrq, hqt, hqr⟩ := term_detour S hW' hlow
  rw [hqget, Option.some.injEq] at hq'
  rw [← hq'] at hedge
  -- every vertex `x ≥ r` of the old path from `q` is reached, shifted by `(h−1)d`, from `s_h`
  have key : ∀ x, Path S.A (actualKeys S.A) S.sd.col W' q x → S.sd.r ≤ x →
      Path (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c (S.capQ c k ρ) (S.s h)
        (x + (h - 1) * S.d) := by
    intro x hx
    induction hx with
    | refl => intro _; exact Relation.ReflTransGen.single hedge
    | @tail b y hqb hby ih =>
      intro hry
      have hyb : y < b := edge_lt hVA hby
      have hbq : b ≤ q := path_le hVA hqb
      have hb : Path (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c (S.capQ c k ρ) (S.s h)
          (b + (h - 1) * S.d) := ih (by omega)
      have he := hcopy b y (by omega) (by omega) hby (hreach.trans hb)
      have hsh : shiftVal S.sd.r ((h - 1) * S.d) y = y + (h - 1) * S.d := by
        simp [shiftVal, hry]
      rw [hsh] at he
      exact hb.tail he
  have := key S.sd.r hqr le_rfl
  simpa [OrdStep.s] using this

/-! ## G9.6, G9.7 — the cut query is `κ_φ W`; lowness is the same at every head -/

-- G9 (helper): no non-Q column of `A` lies inside a height of the stopping column
theorem not_inside_sdcol (S : OrdStep) {a : ColAddr} (ha : a ∈ S.A.colAddrs)
    (haq : isQMat S.sd a = false) {i : Nat} {rest : List (Nat × Nat)}
    (hp : a.path = S.sd.col.path ++ (S.sd.col.col, i) :: rest) : False := by
  obtain ⟨hcol, -, -, hroute, -⟩ := stopData_spec S.hsd
  obtain ⟨-, F, hF, -⟩ := (Scan.mem_routeCols_iff _ _).mp hroute
  have hcolF : F.cols[S.sd.col.col]? = some (S.sd.Q ++ [(S.sd.r, Tree.empty)]) := by
    unfold Tree.colAt at hcol
    rw [hF] at hcol
    simpa using hcol
  rcases Nat.lt_trichotomy i S.sd.Q.length with hik | hik | hik
  · apply Bool.false_ne_true
    rw [← haq]
    unfold isQMat
    rw [hp, List.take_left, List.drop_left]
    simp [hik]
  · rw [Tree.mem_colAddrs_iff] at ha
    unfold Tree.colAt at ha
    rw [hp, Tree.forestAt_append, hF] at ha
    simp only [Option.bind_some, Tree.forestAt, hcolF] at ha
    rw [hik, List.getElem?_append_right le_rfl, Nat.sub_self] at ha
    simp only [List.getElem?_cons_zero] at ha
    cases rest with
    | nil => simp [Tree.forestAt, Tree.empty, Tree.cols] at ha
    | cons q rest' =>
      obtain ⟨c', e'⟩ := q
      simp [Tree.forestAt, Tree.empty, Tree.cols] at ha
  · rw [Tree.mem_colAddrs_iff] at ha
    unfold Tree.colAt at ha
    rw [hp, Tree.forestAt_append, hF] at ha
    simp only [Option.bind_some, Tree.forestAt, hcolF] at ha
    rw [List.getElem?_eq_none (by simp; omega)] at ha
    simp at ha

-- G9 (helper): the stopping column contains no non-Q column of `A`
theorem sdcol_container_none (S : OrdStep) {a : ColAddr} (ha : a ∈ S.A.colAddrs)
    (haq : isQMat S.sd a = false) : S.sd.col.container a = none := by
  cases h : S.sd.col.container a with
  | none => rfl
  | some e =>
    exfalso
    unfold ColAddr.container at h
    cases hd : a.path.drop S.sd.col.path.length with
    | nil => rw [hd] at h; cases h
    | cons x rest =>
      obtain ⟨k', i'⟩ := x
      rw [hd] at h
      simp only at h
      split_ifs at h with hc
      obtain ⟨htake, hk⟩ := hc
      have hp : a.path = S.sd.col.path ++ (S.sd.col.col, i') :: rest := by
        rw [← List.take_append_drop S.sd.col.path.length a.path, htake, hd, hk]
      exact not_inside_sdcol S ha haq hp

-- G9 (helper): a container of a column is on its stack
theorem onStack_of_container {a b : ColAddr} {e : EntryAddr} (h : a.container b = some e) :
    b.OnStack a := by
  obtain ⟨he1, ⟨t, ht⟩⟩ := (ColAddr.container_spec a b e).mp h
  subst he1
  unfold EntryAddr.heightPath at ht
  refine Or.inl ⟨e.col.path.length, e.col.col, e.idx, ?_, ?_, le_rfl⟩
  · rw [← ht, List.append_assoc, List.getElem?_append_right le_rfl, Nat.sub_self]; rfl
  · rw [← ht, List.append_assoc, List.take_left]

-- G9.6 (helper, the full-cut exclusion; open): the phase copy `c` of a template column that
-- contains the stopping column lies on the route of `B`, so a cut after its last entry is at the
-- end of `w(B)` (G-009 §3 G9.6 step 2)
theorem fullCut_container_end (S : OrdStep) {i : Nat} {a c : ColAddr} {ρ : Nat}
    (hi : 1 ≤ i ∧ i ≤ S.n) (ha : IsTmplCol S.A S.sd S.rd a) (haq : isQMat S.sd a = false)
    (hc : phaseCol S.sd S.rd i a = some c) {e : EntryAddr} (he : a.container S.sd.col = some e)
    (hup : IsUpward S.B c (e.idx + 1) ρ) : mu S.B ≤ capPos S.B c (e.idx + 1) := by sorry

-- G9.6: off the full cut, the first `k` entries of `c` are pure `τ_φ`-copies of those of `a`, so
-- `V = κ_φ(W)` with `W = B_a(k−1)` the old cut query (T3.2h.1)
theorem capQ_eq_kappaQ (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ)
    (hend : capPos S.B c k < mu S.B) :
    S.capQ c k ρ = kappaQ S.sd.r S.d (phaseOff S.sd i a) (cutQuery (actualKeys S.A a) k) := by
  obtain ⟨hKcol, hKlen⟩ := litCap_colAt_self hup
  set f := shiftVal S.sd.r (phaseOff S.sd i a * S.d) with hf
  -- the first `k` entries of `c` in `B` are `τ_φ`-copies of those of `a` in `A`
  have hfirst : ((S.B.colAt c).getD []).take k =
      (((S.A.colAt a).getD []).take k).map fun x => (f x.1, Tree.map f x.2) := by
    by_cases haq : isQMat S.sd a = true
    · have hroute : ¬ OnHoleRoute S.sd a := fun h => by
        have := isQMat_of_short S.sd h.length_le
        rw [haq] at this
        cases this
      have hB := colAt_phaseCol S.inL S.kind S.hsd S.hrd S.out hi ha hroute hc
      rw [hB]
      cases S.A.colAt a with
      | none => simp
      | some col => simp [mapCol_eq_map, List.map_take, hf, OrdStep.d]
    · have haq' : isQMat S.sd a = false := by simpa using haq
      have hφ : phaseOff S.sd i a = i := by simp [phaseOff, haq']
      obtain ⟨Z, hZ⟩ := colAt_copyCol S (h := i) hi.2 ha haq'
      have hcopy : S.copyCol i a = c := by
        simp only [OrdStep.copyCol, if_neg (show i ≠ 0 by omega), hc, Option.getD_some]
      rw [hcopy] at hZ
      rw [hZ]
      -- the context agrees with `A` on the first `k` entries of `a`
      have hctx : (((context S.A S.sd Z).colAt a).getD []).take k = ((S.A.colAt a).getD []).take k := by
        cases hce : a.container S.sd.col with
        | none =>
          rw [colAt_context_of_not_route S.hsd Z ha.1 ha.2.1 (sdcol_container_none S ha.1 haq') hce]
        | some e =>
          have hst := onStack_of_container hce
          obtain ⟨hpar, htk, -⟩ := colAt_context_onStack S.hsd Z hst
          have hl := container_sdcol_last S hce
          -- `k ≤ e.idx`: the full cut is excluded by `hend`
          have hkle : k ≤ e.idx := by
            have hk1 : k ≤ ((S.B.colAt c).getD []).length := by
              have := hKlen; rw [List.length_take] at this; omega
            have hBlen : ((S.B.colAt c).getD []).length = (parents S.A a).length := by
              rw [hZ, ← hpar]
              simp only [parents, List.length_map]
              cases (context S.A S.sd Z).colAt a with
              | none => rfl
              | some col => simp [mapCol_eq_map]
            by_contra hcon
            have hk : k = e.idx + 1 := by omega
            subst hk
            have := fullCut_container_end S hi ha haq' hc hce hup
            omega
          have h1 := htk e hce
          have key : ∀ (o1 o2 : Option Column), o1.map (·.take e.idx) = o2.map (·.take e.idx) →
              (o1.getD []).take k = (o2.getD []).take k := by
            intro o1 o2 h12
            cases o1 with
            | none =>
              cases o2 with
              | none => rfl
              | some _ => cases h12
            | some C1 =>
              cases o2 with
              | none => cases h12
              | some C2 =>
                simp only [Option.map_some, Option.some.injEq] at h12
                simp only [Option.getD_some]
                rw [← Nat.min_eq_left hkle, ← List.take_take, h12, List.take_take]
          exact key _ _ h1
      rw [← hctx]
      simp only [hf, hφ]
      cases (context S.A S.sd Z).colAt a with
      | none => simp
      | some col => simp [mapCol_eq_map, List.map_take]
  -- keys
  have hnum : c.num 0 = a.num 0 + phaseOff S.sd i a * S.d :=
    num_phaseCol S.inL S.kind S.hsd S.hrd (Or.inr ha) hi.1 hc
  have hra : S.sd.r ≤ a.num 0 := (tmplCol_num_gt S ha).le
  have hKtake : (actualKeys (litCap S.B c k ρ) c).take k =
      kappaQ S.sd.r S.d (phaseOff S.sd i a) ((actualKeys S.A a).take k) := by
    simp only [actualKeys, hKcol, Option.getD_some, List.map_append]
    rw [List.take_left' (by rw [List.length_map, hKlen]), ← List.map_take, hfirst, List.map_map]
    unfold kappaQ
    rw [List.map_map]
    congr 1
    funext x
    simp only [Function.comp_apply, WithTop.map_coe, hnum, hf]
    exact congrArg _ (relKey_shift S.sd.r S.d (phaseOff S.sd i a) (a.num 0) hra x.2)
  unfold OrdStep.capQ cutQuery
  rw [hKtake]
  unfold kappaQ
  rw [nu_map (kappaQry_strictMono _ _ _)]

-- G9.7 (T3.8lm, list form): a query `κ_φ W` that is low at `s_φ` is low at every head
-- `s_1, …, s_φ`
theorem low_all_heads (S : OrdStep) {φ : Nat} (hφ : 1 ≤ φ) (W : List Key)
    (hlow : kappaQ S.sd.r S.d φ (W.map (↑)) < kappaQ S.sd.r S.d (φ - 1) S.termZ) {h : Nat}
    (hh : 1 ≤ h ∧ h ≤ φ) :
    kappaQ S.sd.r S.d φ (W.map (↑)) < kappaQ S.sd.r S.d (h - 1) S.termZ := by
  obtain ⟨hcol, -, ht, -⟩ := stopData_spec S.hsd
  have hrt : S.sd.r < S.sd.t := (rootData_spec S.hsd S.hrd).2.2.2.2.1
  have htd : S.sd.r + S.d = S.sd.t := by simp only [OrdStep.d, period]; omega
  have hcoe : StrictMono (fun x : Key => (x : WithTop Key)) := WithTop.coe_strictMono
  -- the old complete query is `ν(y)`, read in `WithTop Key`
  have hZ : S.termZ = (nu (S.sd.Q.map fun x => relKey (S.sd.r + S.d) x.2)).map (↑) := by
    unfold OrdStep.termZ cutQuery
    rw [← nu_map hcoe]
    congr 1
    simp only [actualKeys, hcol, Option.getD_some, List.map_append, ← ht, htd, List.map_map]
    rw [List.take_left' (by simp [OrdStep.m])]
    rfl
  obtain ⟨Js, -, hJs⟩ : ∃ Js : List Forest, Js.Sublist (S.sd.Q.map Prod.snd) ∧
      nu (S.sd.Q.map fun x => relKey (S.sd.r + S.d) x.2) = Js.map (relKey (S.sd.r + S.d)) := by
    have hm : (S.sd.Q.map fun x => relKey (S.sd.r + S.d) x.2) =
        (S.sd.Q.map Prod.snd).map (relKey (S.sd.r + S.d)) := by
      rw [List.map_map]; rfl
    have := nu_sublist (S.sd.Q.map fun x => relKey (S.sd.r + S.d) x.2)
    rw [hm] at this ⊢
    exact List.sublist_map_iff.mp this
  have hmap : ∀ j (l : List Key),
      kappaQ S.sd.r S.d j (l.map (↑)) = (l.map (kappa S.sd.r S.d j)).map (↑) := by
    intro j l; unfold kappaQ; rw [List.map_map, List.map_map]; rfl
  rw [hZ, hJs, hmap, hmap] at hlow ⊢
  rw [list_map_lt_iff (hcoe.strictMonoOn Set.univ) (fun _ _ => trivial) (fun _ _ => trivial)]
    at hlow ⊢
  exact (sign_indep_list (by omega) (by omega) W Js).mp hlow

/-! ## G9.8 — the derivation of T3.8lo -/

-- G9.8a: the cut path of `K` starts at or above `s_φ` and passes through `s_φ` on its way to a
-- previous-phase root
theorem phase_exit (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hρ1 : S.sd.r < ρ) (hρ2 : ρ < S.s (phaseOff S.sd i a)) :
    S.s (phaseOff S.sd i a) ≤ cutStart (litCap S.B c k ρ) c k ∧
      Path (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c (S.capQ c k ρ)
        (cutStart (litCap S.B c k ρ) c k) (S.s (phaseOff S.sd i a)) ∧
      Path (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c (S.capQ c k ρ)
        (S.s (phaseOff S.sd i a)) ρ := by
  have hV : CondV (litCap S.B c k ρ) := hKL.1
  have hA : CondA (litCap S.B c k ρ) := hKL.2.2.2.1
  obtain ⟨hcol, hlen⟩ := litCap_colAt_self hup
  obtain ⟨hcmem, -⟩ := litCap_parents_self hup
  have hpar : parents (litCap S.B c k ρ) c =
      (((S.B.colAt c).getD []).take k).map Prod.fst ++ [ρ] := by
    simp [parents, hcol]
  -- the cut path: A of `K` at `(c, k)`
  have hcut : Path (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c (S.capQ c k ρ)
      (cutStart (litCap S.B c k ρ) c k) ρ := by
    have hk : (parents (litCap S.B c k ρ) c)[k]? = some ρ := by
      rw [hpar, List.getElem?_append_right (by rw [List.length_map, hlen]), List.length_map, hlen,
        Nat.sub_self]
      rfl
    exact hA c hcmem k ρ hk
  -- `s_φ ≤ x₀`
  have hx0 : S.s (phaseOff S.sd i a) ≤ cutStart (litCap S.B c k ρ) c k := by
    rcases Nat.eq_zero_or_pos k with hk0 | hk0
    · subst hk0
      simp only [cutStart, if_true]
      have := phaseCol_num_gt S hi.1 ha hc
      omega
    · have hne : k ≠ 0 := by omega
      have hlt : k - 1 < (((S.B.colAt c).getD []).take k).length := by omega
      have hget : (parents (litCap S.B c k ρ) c)[k - 1]? =
          some ((((S.B.colAt c).getD []).take k)[k - 1]'hlt).1 := by
        rw [hpar, List.getElem?_append_left (by simpa using hlt), List.getElem?_map,
          List.getElem?_eq_getElem hlt]
        rfl
      have hx0eq : cutStart (litCap S.B c k ρ) c k =
          ((((S.B.colAt c).getD []).take k)[k - 1]'hlt).1 := by
        simp only [cutStart, hne, if_false, hget, Option.getD_some]
      rw [hx0eq]
      have hmem : (((S.B.colAt c).getD []).take k)[k - 1]'hlt ∈ (S.B.colAt c).getD [] :=
        List.mem_of_mem_take (List.getElem_mem hlt)
      rcases phase_parent_dichotomy S hi ha hc hmem with h | h
      · exfalso
        have := path_le hV hcut
        rw [hx0eq] at this
        omega
      · exact h
  -- the cut path passes `s_φ`: above `s_φ` every stack parent is `< r` or `≥ s_φ`
  have hpass : ∀ x, Path (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c (S.capQ c k ρ) x ρ →
      S.s (phaseOff S.sd i a) ≤ x →
      Path (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c (S.capQ c k ρ) x
        (S.s (phaseOff S.sd i a)) := by
    intro x hx
    induction hx using Relation.ReflTransGen.head_induction_on with
    | refl => intro h; omega
    | @head x x' hxx' hx'ρ ih =>
      intro hsx
      rcases Nat.eq_or_lt_of_le hsx with heq | hlt
      · rw [← heq]
        exact Relation.ReflTransGen.refl
      · obtain ⟨o, ho, hresp⟩ := hxx'
        have hmem : x' ∈ parents (litCap S.B c k ρ) o := by
          rw [resp_eq_parents] at hresp
          exact List.mem_of_getElem? hresp
        rcases stack_parent_dichotomy S hi ha hq hc hup hlt ho x' hmem with h | h
        · exfalso
          have := path_le hV hx'ρ
          omega
        · exact Relation.ReflTransGen.head ⟨o, ho, hresp⟩ (ih h)
  have hP1 := hpass _ hcut hx0
  exact ⟨hx0, hP1, path_functional hV hP1 hcut hρ2.le⟩

-- G9.8b: a head `s_h` whose response is a parent `≥ r` is low
theorem low_of_head_edge (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat}
    (hi : 1 ≤ i ∧ i ≤ S.n) (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ) {h : Nat}
    (hh : 1 ≤ h ∧ h ≤ phaseOff S.sd i a) {w : Nat}
    (he : Edge (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c (S.capQ c k ρ) (S.s h) w)
    (hw : S.sd.r ≤ w) : S.capQ c k ρ < kappaQ S.sd.r S.d (h - 1) S.termZ := by
  obtain ⟨o, ho, hresp⟩ := he
  obtain ⟨hres, -⟩ := resolve_headCol S hi ha hq hc hh
  rw [hres, Option.some.injEq] at ho
  subst ho
  obtain ⟨-, hbig, hkeys, hlen⟩ := headCol_litCap S hi ha hq hc hup hh
  rw [resp_eq_parents] at hresp
  have hcm : cursor (actualKeys (litCap S.B c k ρ) (S.headCol h)) (S.capQ c k ρ) < S.m := by
    by_contra hcon
    have := hbig _ _ (by omega) hresp
    omega
  have hst := kappaQry_strictMono S.sd.r S.d (h - 1)
  have e1 := cursor_take (actualKeys (litCap S.B c k ρ) (S.headCol h)) (S.capQ c k ρ) S.m
  rw [hkeys] at e1
  have hlt : cursor (kappaQ S.sd.r S.d (h - 1) ((actualKeys S.A S.sd.col).take S.m))
      (S.capQ c k ρ) < S.m := by
    rw [e1]; omega
  have hlenq : S.m ≤ (kappaQ S.sd.r S.d (h - 1) ((actualKeys S.A S.sd.col).take S.m)).length := by
    rw [← hkeys, List.length_take]; omega
  have := lt_cutQuery_of_cursor_lt (cutQuery_noninc _ _) hlenq hlt
  unfold kappaQ at this ⊢
  rw [cutQuery_map hst] at this
  have htt : cutQuery ((actualKeys S.A S.sd.col).take S.m) S.m =
      cutQuery (actualKeys S.A S.sd.col) S.m := by
    unfold cutQuery; rw [List.take_take, Nat.min_self]
  rw [htt] at this
  exact this

-- G9.8c: the first unconsumed root entry of a literal cap is the response of its root column at
-- the cap's cut query
theorem unconsumed_litCap {B : Forest} {c : ColAddr} {k ρ : Nat} (hup : IsUpward B c k ρ)
    {rd : RootData} (hrd : rootData (litCap B c k ρ) = some rd) :
    c.resolve 0 ρ = some rd.col ∧
      (unconsumed (litCap B c k ρ) rd).head?.map Prod.fst =
        resp (litCap B c k ρ) (actualKeys (litCap B c k ρ)) rd.col
          (cutQuery (actualKeys (litCap B c k ρ) c) k) := by
  have hsd := stopData_litCap hup
  obtain ⟨hres, -, -, -, hcur, -⟩ := rootData_path hsd hrd
  refine ⟨hres, ?_⟩
  obtain ⟨hcol, hlen⟩ := litCap_colAt_self hup
  have hq : (actualKeys (litCap B c k ρ) c).take k =
      (queryKeys ⟨colDepth c, c, c.num 0, ρ, ((B.colAt c).getD []).take k⟩).map (↑) := by
    simp only [actualKeys, hcol, queryKeys, Option.getD_some, List.map_append, List.map_map]
    rw [List.take_left' (by rw [List.length_map, hlen])]
    rfl
  have hkeys : actualKeys (litCap B c k ρ) rd.col = (rootKeys (litCap B c k ρ) rd).map (↑) := by
    simp only [actualKeys, rootKeys, List.map_map]
    rfl
  have hc : cursor (actualKeys (litCap B c k ρ) rd.col) (cutQuery (actualKeys (litCap B c k ρ) c) k) =
      rd.cursor := by
    unfold cutQuery
    rw [cursor_nu, hq, hkeys, cursor_map WithTop.coe_strictMono, hcur]
  unfold unconsumed rootCol resp
  rw [hc, List.head?_drop]

-- T3.8lo (txt:556-560): at a previous-phase root the actual response is a parent `≥ r`
theorem prev_root_response (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat}
    (hi : 1 ≤ i ∧ i ≤ S.n) (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hend : capPos S.B c k < mu S.B) (hρ1 : S.sd.r < ρ)
    (hρ2 : ρ < S.s (phaseOff S.sd i a))
    {rdN : RootData} (hN : rootData (litCap S.B c k ρ) = some rdN) :
    ∃ u us, unconsumed (litCap S.B c k ρ) rdN = u :: us ∧ S.sd.r ≤ u.1 := by
  have hV : CondV (litCap S.B c k ρ) := hKL.1
  obtain ⟨_, hP1, hP2⟩ := phase_exit S hi ha hq hc hup hKL hρ1 hρ2
  -- `φ ≥ 1`, since `r < ρ < s_φ = r + φ d`
  have hφ1 : 1 ≤ phaseOff S.sd i a := by
    rcases Nat.eq_zero_or_pos (phaseOff S.sd i a) with h0 | h0
    · exfalso
      simp only [OrdStep.s, h0, Nat.zero_mul, Nat.add_zero] at hρ2
      omega
    · exact h0
  -- step 1: the edge out of `s_φ` goes to a parent `≥ ρ > r`, so `s_φ` is low
  obtain ⟨w, hw, hρw⟩ : ∃ w, Edge (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c
      (S.capQ c k ρ) (S.s (phaseOff S.sd i a)) w ∧ ρ ≤ w := by
    rcases Relation.ReflTransGen.cases_head hP2 with h | ⟨w, hw, hwρ⟩
    · omega
    · exact ⟨w, hw, path_le hV hwρ⟩
  have hlowφ := low_of_head_edge S hi ha hq hc hup ⟨hφ1, le_rfl⟩ hw (by omega)
  -- step 2: `V = κ_φ W`, `W = W₀` read in `WithTop Key`, and every head is low
  have hVeq := capQ_eq_kappaQ S hi ha hq hc hup hend
  set W₀ : List Key := cutQuery (((S.A.colAt a).getD []).map fun x => relKey (a.num 0) x.2) k
    with hW₀
  have hWW₀ : cutQuery (actualKeys S.A a) k = W₀.map (↑) := by
    rw [hW₀, ← cutQuery_map WithTop.coe_strictMono, List.map_map]
    rfl
  rw [hWW₀] at hVeq
  rw [hVeq] at hlowφ
  have hall := fun h (hh : 1 ≤ h ∧ h ≤ phaseOff S.sd i a) => low_all_heads S hφ1 W₀ hlowφ hh
  have hWn : Noninc (W₀.map ((↑) : Key → WithTop Key)) := hWW₀ ▸ cutQuery_noninc _ _
  -- steps 3, 4: descend through the heads `s_φ, …, s_1` along the detours
  have hdesc : ∀ j, j ≤ phaseOff S.sd i a →
      Path (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c (S.capQ c k ρ)
          (cutStart (litCap S.B c k ρ) c k) (S.s (phaseOff S.sd i a - j)) ∧
        Path (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c (S.capQ c k ρ)
          (S.s (phaseOff S.sd i a)) (S.s (phaseOff S.sd i a - j)) := by
    intro j
    induction j with
    | zero => intro _; exact ⟨hP1, Relation.ReflTransGen.refl⟩
    | succ j ih =>
      intro hj
      obtain ⟨h1, h2⟩ := ih (by omega)
      have hh : 1 ≤ phaseOff S.sd i a - j ∧ phaseOff S.sd i a - j ≤ phaseOff S.sd i a := by omega
      have hsum : phaseOff S.sd i a - j - 1 + (phaseOff S.sd i a - (phaseOff S.sd i a - j) + 1) =
          phaseOff S.sd i a := by omega
      have hVh : S.capQ c k ρ = kappaQ S.sd.r S.d (phaseOff S.sd i a - j - 1)
          (kappaQ S.sd.r S.d (phaseOff S.sd i a - (phaseOff S.sd i a - j) + 1)
            (W₀.map (↑))) := by
        rw [kappaQ_add, hsum, hVeq]
      have hlowh : kappaQ S.sd.r S.d (phaseOff S.sd i a - (phaseOff S.sd i a - j) + 1)
          (W₀.map (↑)) < S.termZ := by
        rw [← kappaQ_lt_iff S.sd.r S.d (phaseOff S.sd i a - j - 1), kappaQ_add, hsum]
        exact hall _ hh
      have hstep := low_head_detour S hi ha hq hc hup hKL hh (kappaQ_noninc _ _ _ hWn) hVh hlowh h1
      have heq : phaseOff S.sd i a - j - 1 = phaseOff S.sd i a - (j + 1) := by omega
      rw [heq] at hstep
      exact ⟨h1.trans hstep, h2.trans hstep⟩
  have hφr := (hdesc _ le_rfl).2
  have hs0 : S.s (phaseOff S.sd i a - phaseOff S.sd i a) = S.sd.r := by
    simp [OrdStep.s]
  rw [hs0] at hφr
  -- step 5: paths are orbits, so `ρ` reaches `r`; its edge goes to a vertex `≥ r`
  have hρr := path_functional hV hP2 hφr hρ1.le
  obtain ⟨u₁, he, hu₁⟩ : ∃ u₁, Edge (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c
      (S.capQ c k ρ) ρ u₁ ∧ S.sd.r ≤ u₁ := by
    rcases Relation.ReflTransGen.cases_head hρr with h | ⟨u₁, hu, hur⟩
    · omega
    · exact ⟨u₁, hu, path_le hV hur⟩
  -- step 6: that edge is the first unconsumed root entry
  obtain ⟨o, ho, hresp⟩ := he
  obtain ⟨hres, hhead⟩ := unconsumed_litCap hup hN
  rw [ho] at hres
  cases hres
  have hhead' : (unconsumed (litCap S.B c k ρ) rdN).head?.map Prod.fst = some u₁ :=
    hhead.trans hresp
  cases hU : unconsumed (litCap S.B c k ρ) rdN with
  | nil => rw [hU] at hhead'; simp at hhead'
  | cons u us =>
    rw [hU] at hhead'
    simp only [List.head?_cons, Option.map_some, Option.some.injEq] at hhead'
    exact ⟨u, us, rfl, hhead' ▸ hu₁⟩

-- T3.8lp (txt:553-561): previous-phase root `r < ρ < s_φ`: the root response is `≥ r`, the next
-- target parent is `< r`, so the kernel wins at once
theorem root_prev (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hend : capPos S.B c k < mu S.B)
    (hρ1 : S.sd.r < ρ) (hρ2 : ρ < S.s (phaseOff S.sd i a)) :
    Success (litCap S.B c k ρ) (localSuffix S.B c) := by sorry

-- T3.8lq (txt:564-571): fixed roots `ρ ≤ r`: the actual source cursors agree.
-- VERIFY-U2 (F3): the owner flags need not agree (`ρ = r`, cut in a restored origin: the old
-- cap's root `R` contains the cut, the new cap's root does not; 106 bounded cases), so the
-- drafted conjunct `rdN.owner = rdO.owner` is removed; T3.8lr/T3.8ls use only cursor and column.
theorem root_fixed_cursor (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat}
    (hi : 1 ≤ i ∧ i ≤ S.n) (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hend : capPos S.B c k < mu S.B) (hρ : ρ ≤ S.sd.r)
    {rdN rdO : RootData} (hN : rootData (litCap S.B c k ρ) = some rdN)
    (hO : rootData (litCap S.A a k ρ) = some rdO) :
    rdN.cursor = rdO.cursor ∧ rdN.col = rdO.col := by sorry

-- T3.8lr (txt:576-582): closed side targets with fixed root
theorem closed_side (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hroute : ¬ OnHoleRoute S.sd a)
    (hup : IsUpward S.B c k ρ) (hKL : InL (litCap S.B c k ρ)) (hend : capPos S.B c k < mu S.B)
    (hρ : ρ ≤ S.sd.r) (hold : Success (litCap S.A a k ρ) (localSuffix S.A a)) :
    Success (litCap S.B c k ρ) (localSuffix S.B c) := by sorry

-- T3.8ls (txt:583-605): direct body targets with fixed root (remainders (4), delayed change)
theorem direct_body (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hc : phaseCol S.sd S.rd i a = some c)
    (hroute : OnHoleRoute S.sd a) (hup : IsUpward S.B c k ρ) (hKL : InL (litCap S.B c k ρ))
    (hend : capPos S.B c k < mu S.B) (hρ : ρ ≤ S.sd.r)
    (hold : Success (litCap S.A a k ρ) (localSuffix S.A a)) :
    Success (litCap S.B c k ρ) (localSuffix S.B c) := by sorry

-- T3.8l (txt:511-643): the ordinary induction step
theorem KS_ordinary (S : OrdStep) : KS S.B := by sorry

-- T3.8m (txt:504): kernel success for every standard target, by induction on generation
theorem KS_std {B : Forest} (hB : IsStd B) : KS B := by sorry

