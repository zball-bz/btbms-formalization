    Success (litCap B c k p) (localSuffix B c) := by sorry

-- T3.8h (txt:511-512): a cap above a covered old target is covered
theorem covers_of_gt {A B K : Forest} (hcof : Cof A) (hKL : InL K) (hKne : K ≠ Tree.empty)
    (hlast : K.cols.getLast? ≠ some []) (hAK : A < K) (hBA : B ≤ A)
    (hK0 : ∀ K0, expand K 0 = some K0 → K0 < B) : Covers K B := by sorry

-- T3.8g: kernel success for all caps gives cofinality with the bound
theorem cof_of_KS {B : Forest} (hB : InL B) (hKS : KS B) : Cof B := by sorry
theorem bound_of_KS {B E : Forest} (hB : InL B) (hKS : KS B) (hE : InL E) (hlt : B < E)
    (hlast : E.cols.getLast? ≠ some []) :
    ∃ n E', 1 ≤ n ∧ n ≤ mu B + 1 ∧ expand E n = some E' ∧ B < E' := by sorry

-- L3.6a (txt:463-465): reversing one repair: the complete old suffixes compare `Y_i ≥ Y_j`
theorem repair_suffix_ge {B : Forest} (hH : CondH B) {cj ci : ColAddr} {k p : Nat}
    (hj : IsUpward B cj k p) (hi : IsUpward B ci k p)
    (hmove : ∃ m, MoveOK (litCap B cj k p) m ∧ applyMove (litCap B cj k p) m = litCap B ci k p) :
    localSuffix B cj ≤ localSuffix B ci := by sorry

-- L3.6b (txt:466-481): success transfers backward through one legal move
-- VERIFY-U2 (F5): `hP` added; step 1 gets S of the cap from L3.1e, which needs P of `B`
theorem success_unmove {B : Forest} (hL : InL B) (hP : CondP B) {cj ci : ColAddr} {k p : Nat}
    (hj : IsUpward B cj k p) (hi : IsUpward B ci k p)
    (hjV : CondV (litCap B cj k p)) (hjI : CondI (litCap B cj k p))
    (hjA : CondAK (litCap B cj k p) (capKeys (litCap B cj k p) (routeCols (litCap B cj k p))))
    (hmove : ∃ m, MoveOK (litCap B cj k p) m ∧ applyMove (litCap B cj k p) m = litCap B ci k p)
    (hsucc : Success (litCap B ci k p) (localSuffix B ci)) :
    Success (litCap B cj k p) (localSuffix B cj) := by sorry

-- provides: U2, L3.6 (txt:459-481): cap completion
theorem cap_completion {B : Forest} (hL : InL B) (hP : CondP B) (hcof : Cof B) : CC B := by sorry

-- T3.8i (txt:505): seeds
theorem KS_seed (m : Nat) : KS (seed m) := by sorry

-- T3.8j (txt:505-506): safe prefixes of a covered target
theorem KS_safePrefix {A : Forest} (hA : InL A) (hcof : Cof A) (k : Nat) : KS (safePrefix A k) := by
  sorry

-- T3.8k (txt:506-510): special outputs
theorem KS_special {A B : Forest} {n : Nat} (hA : InL A) (hcof : Cof A)
    (hk : stepKind A = some .special) (hB : expand A n = some B) : KS B := by sorry

/-- T3.8l (txt:511-643): the setting of the ordinary induction step. -/
structure OrdStep where
  A : Forest
  sd : StopData
  rd : RootData
  n : Nat
  B : Forest
  std : IsStd A
  inL : InL A
  condP : CondP A
  cof : Cof A
  kind : stepKind A = some .ordinary
  hsd : stopData A = some sd
  hrd : rootData A = some rd
  pos : 1 ≤ n
  out : expand A n = some B

namespace OrdStep

variable (S : OrdStep)

/-- The period `d`. -/
def d : Nat := period S.sd
/-- `s_i = r + i d`, the number of the head of layer `i`. -/
def s (i : Nat) : Nat := S.sd.r + i * S.d
/-- `m = |Q|`. -/
def m : Nat := S.sd.Q.length
/-- `τ_i = T_{r, i d}`. -/
def tau (i : Nat) (F : Forest) : Forest := shift S.sd.r (i * S.d) F
/-- The projection of a selected root of phase `φ` (txt:521-524); only used outside `(r, s_φ)`. -/
def proj (φ ρ : Nat) : Nat := if S.s φ < ρ then ρ - φ * S.d else if ρ = S.s φ then S.sd.r else ρ

end OrdStep

-- T3.8la (txt:511-519): where a cap not above `A` and not at the end of `B` can sit
theorem cut_location (S : OrdStep) {c : ColAddr} {k ρ : Nat} (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hle : ¬ S.A < litCap S.B c k ρ)
    (hend : capPos S.B c k < mu S.B) :
    (c = S.sd.col ∧ S.m ≤ k) ∨
      (∃ i, 2 ≤ i ∧ i ≤ S.n ∧ phaseCol S.sd S.rd i S.rd.col = some c) ∨
      (∃ i a, 1 ≤ i ∧ i ≤ S.n ∧ IsTmplCol S.A S.sd S.rd a ∧ (isQMat S.sd a = true → 2 ≤ i) ∧
        phaseCol S.sd S.rd i a = some c) := by sorry

-- T3.8lb (txt:607-608, with the method of T3.8li): the old terminal cap of a head-query cut
theorem headQuery_oldCap (S : OrdStep) {i : Nat} {c : ColAddr} {k ρ : Nat} (hi : 2 ≤ i ∧ i ≤ S.n)
    (hc : phaseCol S.sd S.rd i S.rd.col = some c) (hk : k < S.m ∨ (k = S.m ∧ S.s (i - 1) < ρ))
    (hup : IsUpward S.B c k ρ) (hKL : InL (litCap S.B c k ρ)) :
    let K' := litCap S.A S.sd.col k (ρ - (i - 1) * S.d)
    S.s (i - 1) < ρ ∧ IsUpward S.A S.sd.col k (ρ - (i - 1) * S.d) ∧ CondV K' ∧ CondI K' ∧
      CondAK K' (capKeys K' (routeCols K')) := by sorry

-- T3.8lc (txt:607-611): query-part cuts of head `i ≥ 2`
theorem headQuery_cut (S : OrdStep) {i : Nat} {c : ColAddr} {k ρ : Nat} (hi : 2 ≤ i ∧ i ≤ S.n)
    (hc : phaseCol S.sd S.rd i S.rd.col = some c) (hk : k < S.m ∨ (k = S.m ∧ S.s (i - 1) < ρ))
    (hup : IsUpward S.B c k ρ) (hKL : InL (litCap S.B c k ρ)) :
    Covers (litCap S.B c k ρ) S.B := by sorry

-- T3.8ld (txt:613-617): the seam: the cap at `s_{i−1}` is `A` advanced by `i − 1` periods
theorem expand_seam (S : OrdStep) {i : Nat} {c : ColAddr} (hi : 1 ≤ i ∧ i ≤ S.n)
    (hc : phaseCol S.sd S.rd i S.rd.col = some c) (q : Nat) :
    expand (litCap S.B c S.m (S.s (i - 1))) q = expand S.A (i - 1 + q) := by sorry

-- T3.8le (txt:617-620): no closing parent below `s_{i−1}` is an upward `L` cap at `k = m`
theorem seam_parent (S : OrdStep) {i : Nat} {c : ColAddr} {ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (hc : phaseCol S.sd S.rd i S.rd.col = some c) (hup : IsUpward S.B c S.m ρ)
    (hKL : InL (litCap S.B c S.m ρ)) : S.s (i - 1) ≤ ρ := by sorry

-- T3.8lf (txt:623-624): restored-suffix cuts force `ρ < r`
theorem restored_parent (S : OrdStep) {i : Nat} {c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (hc : phaseCol S.sd S.rd i S.rd.col = some c) (hk : S.m < k) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) : ρ < S.sd.r := by sorry

-- T3.8lg (txt:624-626): the old root cap after `w = c + v` entries has V, I, decorated A
theorem restored_oldCap (S : OrdStep) {i : Nat} {c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (hc : phaseCol S.sd S.rd i S.rd.col = some c) (hk : S.m < k) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hend : capPos S.B c k < mu S.B) :
    let K' := litCap S.A S.rd.col (S.rd.cursor + (k - S.m)) ρ
    IsUpward S.A S.rd.col (S.rd.cursor + (k - S.m)) ρ ∧ CondV K' ∧ CondI K' ∧
      CondAK K' (capKeys K' (routeCols K')) := by sorry

-- T3.8lh (txt:621-640): restored-suffix cuts succeed (remainders (5), delayed change)
theorem restored_cut (S : OrdStep) {i : Nat} {c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (hc : phaseCol S.sd S.rd i S.rd.col = some c) (hk : S.m < k) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hend : capPos S.B c k < mu S.B)
    (hold : Success (litCap S.A S.rd.col (S.rd.cursor + (k - S.m)) ρ) (localSuffix S.A S.rd.col)) :
    Success (litCap S.B c k ρ) (localSuffix S.B c) := by sorry

-- T3.8li (txt:520-541): projection of a material cut to an old cap
theorem projection (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hend : capPos S.B c k < mu S.B)
    (hρ : ρ ≤ S.sd.r ∨ S.s (phaseOff S.sd i a) ≤ ρ) :
    let K' := litCap S.A a k (S.proj (phaseOff S.sd i a) ρ)
    IsUpward S.A a k (S.proj (phaseOff S.sd i a) ρ) ∧ CondV K' ∧ CondI K' ∧
      CondAK K' (capKeys K' (routeCols K')) := by sorry

-- T3.8lj (txt:542-546): proper current root `ρ > s_φ`: conjugate kernels, downward success
theorem root_current (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hend : capPos S.B c k < mu S.B)
    (hρ : S.s (phaseOff S.sd i a) < ρ)
    (hold : Success (litCap S.A a k (ρ - phaseOff S.sd i a * S.d)) (localSuffix S.A a)) :
    Success (litCap S.B c k ρ) (localSuffix S.B c) := by sorry

-- T3.8lk (txt:547-552): current head root `ρ = s_φ`: high scans conjugate, low scans win
theorem root_head (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hend : capPos S.B c k < mu S.B)
    (hρ : ρ = S.s (phaseOff S.sd i a))
    (hold : Success (litCap S.A a k S.sd.r) (localSuffix S.A a)) :
    Success (litCap S.B c k ρ) (localSuffix S.B c) := by sorry

-- T3.8ll (txt:551-552, 560-561): "wins at once": the first unconsumed root entry beats the next
-- target entry
theorem success_of_first {K Y : Forest} {sd : StopData} {rd : RootData}
    (hsd : stopData K = some sd) (hrd : rootData K = some rd) (hdef : KernelDefined K rd)
    {rest : Column} {more : List Column} (hY : Y = .node ((sd.Q ++ rest) :: more))
    {u : Nat × Forest} {us : Column} (hU : unconsumed K rd = u :: us)
    (hbeat : ∀ x ∈ rest.head?, x.1 < u.1) : Success K Y := by sorry

-- T3.8lm (txt:555-559): sign independence of a fixed phase-`φ` key against the phase-`h` images
-- of a key normalized at the old terminal `t = r + d`, for every `h < φ`
theorem sign_indep {r d φ h h' : Nat} (hh : h < φ) (hh' : h' < φ) (w : Key) (J : Forest) :
    keyCmp (kappa r d φ w) (kappa r d h (relKey (r + d) J)) =
      keyCmp (kappa r d φ w) (kappa r d h' (relKey (r + d) J)) := by sorry

-- T3.8lm: the same for reduced queries (lists of keys), hence for "low/high" at every head
theorem sign_indep_list {r d φ h h' : Nat} (hh : h < φ) (hh' : h' < φ) (W : List Key)
    (Js : List Forest) :
    (W.map (kappa r d φ) < (Js.map (relKey (r + d))).map (kappa r d h) ↔
      W.map (kappa r d φ) < (Js.map (relKey (r + d))).map (kappa r d h')) := by sorry

-- T3.8lo (txt:556-560): at a previous-phase root the actual response is a parent `≥ r`
theorem prev_root_response (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat}
    (hi : 1 ≤ i ∧ i ≤ S.n) (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hend : capPos S.B c k < mu S.B) (hρ1 : S.sd.r < ρ)
    (hρ2 : ρ < S.s (phaseOff S.sd i a))
    {rdN : RootData} (hN : rootData (litCap S.B c k ρ) = some rdN) :
    ∃ u us, unconsumed (litCap S.B c k ρ) rdN = u :: us ∧ S.sd.r ≤ u.1 := by sorry

-- T3.8ln (txt:530, 549-551): parents of phase-`φ` material are `< r` or `≥ s_φ`
theorem phase_parent_dichotomy (S : OrdStep) {i : Nat} {a c : ColAddr} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hc : phaseCol S.sd S.rd i a = some c) {x : Nat × Forest}
    (hx : x ∈ (S.B.colAt c).getD []) : x.1 < S.sd.r ∨ S.s (phaseOff S.sd i a) ≤ x.1 := by sorry

-- T3.8lp (txt:553-561): previous-phase root `r < ρ < s_φ`: the root response is `≥ r`, the next
-- target parent is `< r`, so the kernel wins at once
theorem root_prev (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hend : capPos S.B c k < mu S.B)
    (hρ1 : S.sd.r < ρ) (hρ2 : ρ < S.s (phaseOff S.sd i a)) :
    Success (litCap S.B c k ρ) (localSuffix S.B c) := by sorry

-- T3.8lq (txt:564-571): fixed roots `ρ ≤ r`: the actual source cursors agree.
-- VERIFY-U2 (F3): the owner flags need not agree (`ρ = r`, cut in a restored origin: the old
-- cap's root `R` contains the cut, the new cap's root does not; 106 bounded cases), so the
-- drafted conjunct `rdN.owner = rdO.owner` is removed; T3.8lr/T3.8ls use only cursor and column.
theorem root_fixed_cursor (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat}
    (hi : 1 ≤ i ∧ i ≤ S.n) (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hend : capPos S.B c k < mu S.B) (hρ : ρ ≤ S.sd.r)
    {rdN rdO : RootData} (hN : rootData (litCap S.B c k ρ) = some rdN)
    (hO : rootData (litCap S.A a k ρ) = some rdO) :
    rdN.cursor = rdO.cursor ∧ rdN.col = rdO.col := by sorry

-- T3.8lr (txt:576-582): closed side targets with fixed root
theorem closed_side (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hroute : ¬ OnHoleRoute S.sd a)
    (hup : IsUpward S.B c k ρ) (hKL : InL (litCap S.B c k ρ)) (hend : capPos S.B c k < mu S.B)
    (hρ : ρ ≤ S.sd.r) (hold : Success (litCap S.A a k ρ) (localSuffix S.A a)) :
    Success (litCap S.B c k ρ) (localSuffix S.B c) := by sorry

-- T3.8ls (txt:583-605): direct body targets with fixed root (remainders (4), delayed change)
theorem direct_body (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hc : phaseCol S.sd S.rd i a = some c)
    (hroute : OnHoleRoute S.sd a) (hup : IsUpward S.B c k ρ) (hKL : InL (litCap S.B c k ρ))
    (hend : capPos S.B c k < mu S.B) (hρ : ρ ≤ S.sd.r)
    (hold : Success (litCap S.A a k ρ) (localSuffix S.A a)) :
    Success (litCap S.B c k ρ) (localSuffix S.B c) := by sorry

-- T3.8l (txt:511-643): the ordinary induction step
theorem KS_ordinary (S : OrdStep) : KS S.B := by sorry

-- T3.8m (txt:504): kernel success for every standard target, by induction on generation
theorem KS_std {B : Forest} (hB : IsStd B) : KS B := by sorry

