theorem applyMove_eq_body (E : Forest) (m : Move) : applyMove E m = applyMoveBody E m := by sorry

theorem moveAddr_eq_body (ms : List Move) (b : EntryAddr) : moveAddr ms b = moveAddrBody ms b := by
