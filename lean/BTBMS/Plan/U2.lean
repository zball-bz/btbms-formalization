theorem applyMove_eq_body (E : Forest) (m : Move) : applyMove E m = applyMoveBody E m := rfl

theorem moveAddr_eq_body (ms : List Move) (b : EntryAddr) : moveAddr ms b = moveAddrBody ms b :=
  rfl

theorem movesValid_eq_body (K : Forest) (ms : List Move) : MovesValid K ms = MovesValidBody K ms :=
  rfl

theorem repairList_eq_body (K : Forest) (b : EntryAddr) (ms : List Move) :
    RepairList K b ms = RepairListBody K b ms := rfl

theorem origin_eq_body {E : Forest} (w : AdmCap E) : w.origin = originBody w := rfl

/-! ### D3.1a helpers (stop data, index maps, roles of moves and literal caps) -/

/-- helper: stop data read below a prefix path. -/
def sdPrepend (π : List (Nat × Nat)) (sd : StopData) : StopData :=
  { depth := π.length + sd.depth, col := ⟨π ++ sd.col.path, sd.col.col⟩,
    t := (π.map (·.1 + 1)).sum + sd.t, r := sd.r, Q := sd.Q }

theorem sdPrepend_append (π π' : List (Nat × Nat)) (sd : StopData) :
    sdPrepend π (sdPrepend π' sd) = sdPrepend (π ++ π') sd := by
  simp only [sdPrepend, List.length_append, List.append_assoc, List.map_append, List.sum_append]
  congr 1 <;> omega

mutual
theorem stopF_prepend : ∀ (π : List (Nat × Nat)) (F : Forest),
    stopF π F = (stopF [] F).map (sdPrepend π)
  | π, .node cols => by simp only [stopF]; exact stopCols_prepend π 0 cols
theorem stopCols_prepend : ∀ (π : List (Nat × Nat)) (ci : Nat) (cols : List Column),
    stopCols π ci cols = (stopCols [] ci cols).map (sdPrepend π)
  | _, _, [] => by simp [stopCols]
  | π, ci, [col] => by simp only [stopCols]; exact stopCol_prepend π ci 0 [] col
  | π, ci, _ :: _ :: rest => by simp only [stopCols]; exact stopCols_prepend π (ci + 1) (_ :: rest)
theorem stopCol_prepend : ∀ (π : List (Nat × Nat)) (ci ei : Nat) (Q : Column) (col : Column),
    stopCol π ci ei Q col = (stopCol [] ci ei Q col).map (sdPrepend π)
  | _, _, _, _, [] => by simp [stopCol]
  | π, ci, ei, Q, [(p, .node [])] => by
    simp only [stopCol, Option.map_some, sdPrepend, ColAddr.num, List.append_nil, List.length_nil,
      List.map_nil, List.sum_nil]
    simp only [StopData.mk.injEq, Nat.add_zero, Nat.zero_add, true_and, and_true]
  | π, ci, ei, Q, [(_, .node (g :: gs))] => by
    simp only [stopCol]
    rw [stopCols_prepend (π ++ [(ci, ei)]) 0 (g :: gs), stopCols_prepend ([] ++ [(ci, ei)]) 0 (g :: gs),
      Option.map_map]
    congr 1
    funext sd
    simp only [Function.comp, sdPrepend_append, List.nil_append]
  | π, ci, ei, Q, x :: y :: rest => by
    simp only [stopCol]; exact stopCol_prepend π ci (ei + 1) (Q ++ [x]) (y :: rest)
end

theorem stopCols_snoc (π : List (Nat × Nat)) (col : Column) :
    ∀ (ci : Nat) (pre : List Column),
      stopCols π ci (pre ++ [col]) = stopCol π (ci + pre.length) 0 [] col
  | ci, [] => by simp [stopCols]
  | ci, [a] => by simp [stopCols]
  | ci, a :: b :: pre => by
    rw [List.cons_append, List.cons_append, stopCols, ← List.cons_append,
      stopCols_snoc π col (ci + 1) (b :: pre)]
    simp only [List.length_cons]; congr 1; omega

theorem stopCol_snoc (π : List (Nat × Nat)) (ci : Nat) (x : Nat × Forest) :
    ∀ (ei : Nat) (Q0 pre : Column),
      stopCol π ci ei Q0 (pre ++ [x]) = stopCol π ci (ei + pre.length) (Q0 ++ pre) [x]
  | ei, Q0, [] => by simp
  | ei, Q0, a :: pre => by
    rw [List.cons_append]
    cases pre with
    | nil => simp [stopCol]
    | cons b pre =>
      simp only [List.cons_append]
      rw [stopCol, ← List.cons_append, stopCol_snoc π ci x (ei + 1) (Q0 ++ [a]) (b :: pre)]
      simp only [List.length_cons, List.append_assoc, List.singleton_append]
      congr 1; omega

/-- helper: `stopF` at a forest whose last column ends in `(q, h)`. -/
theorem stopF_snoc (π : List (Nat × Nat)) (pre : List Column) (Q : Column) (q : Nat) (h : Forest) :
    stopF π (.node (pre ++ [Q ++ [(q, h)]])) =
      if h = Tree.empty then
        some { depth := π.length, col := ⟨π, pre.length⟩, t := ColAddr.num 0 ⟨π, pre.length⟩,
               r := q, Q := Q }
      else stopF (π ++ [(pre.length, Q.length)]) h := by
  rw [stopF, stopCols_snoc, stopCol_snoc]
  simp only [Nat.zero_add, List.nil_append]
  obtain ⟨gs⟩ := h
  cases gs with
  | nil => simp [stopCol, Tree.empty]
  | cons g gs => simp [stopCol, Tree.empty, stopF]

/-- helper: decomposition of a successful `stopF` at its first level. -/
theorem stopF_some_iff {F : Forest} {sd : StopData} :
    stopF [] F = some sd ↔ ∃ pre Q q h, F = .node (pre ++ [Q ++ [(q, h)]]) ∧
      ((h = Tree.empty ∧ sd = { depth := 0, col := ⟨[], pre.length⟩, t := pre.length, r := q, Q := Q }) ∨
       (h ≠ Tree.empty ∧ ∃ sd', stopF [] h = some sd' ∧ sd = sdPrepend [(pre.length, Q.length)] sd')) := by
  constructor
  · intro hs
    obtain ⟨cols⟩ := F
    rcases List.eq_nil_or_concat' cols with rfl | ⟨pre, col, rfl⟩
    · simp [stopF, stopCols] at hs
    rcases List.eq_nil_or_concat' col with rfl | ⟨Q, ⟨q, h⟩, rfl⟩
    · rw [stopF, stopCols_snoc] at hs; simp [stopCol] at hs
    refine ⟨pre, Q, q, h, rfl, ?_⟩
    rw [stopF_snoc] at hs
    by_cases hh : h = Tree.empty
    · simp only [hh, if_true, Option.some.injEq] at hs
      left; refine ⟨hh, ?_⟩; rw [← hs]; simp [ColAddr.num]
    · simp only [hh, if_false] at hs
      right; refine ⟨hh, ?_⟩
      rw [stopF_prepend] at hs
      cases h' : stopF [] h with
      | none => rw [h'] at hs; simp at hs
      | some sd' => rw [h'] at hs; simp only [Option.map_some, Option.some.injEq] at hs; exact ⟨sd', rfl, hs.symm⟩
  · rintro ⟨pre, Q, q, h, rfl, (⟨hh, rfl⟩ | ⟨hh, sd', hs, rfl⟩)⟩
    · rw [stopF_snoc, if_pos hh]; simp [ColAddr.num]
    · rw [stopF_snoc, if_neg hh, stopF_prepend, hs]; rfl

theorem list_modify_snoc {α : Type} (pre : List α) (x : α) (g : α → α) :
    (pre ++ [x]).modify pre.length g = pre ++ [g x] := by
  induction pre with
  | nil => rfl
  | cons a pre ih => simp only [List.cons_append, List.length_cons, List.modify_succ_cons, ih]

theorem stopF_ne_empty {F : Forest} {sd : StopData} (h : stopF [] F = some sd) : F ≠ Tree.empty := by
  rintro rfl; simp [stopF, stopCols, Tree.empty] at h

/-- helper: the forest at a path through the first level. -/
theorem forestAt_node_cons (cols : List Column) (a b : Nat) (rest : List (Nat × Nat)) :
    (Tree.node cols).forestAt ((a, b) :: rest) =
      ((cols[a]?).bind (·[b]?)).bind fun x => x.2.forestAt rest := by
  simp only [Tree.forestAt, Tree.cols]
  cases (cols[a]?).bind (·[b]?) with
  | none => rfl
  | some x => obtain ⟨_, _⟩ := x; rfl

theorem colAt_node_cons (cols : List Column) (a b : Nat) (rest : List (Nat × Nat)) (j : Nat) :
    (Tree.node cols).colAt ⟨(a, b) :: rest, j⟩ =
      ((cols[a]?).bind (·[b]?)).bind fun x => x.2.colAt ⟨rest, j⟩ := by
  simp only [Tree.colAt, forestAt_node_cons]
  cases (cols[a]?).bind (·[b]?) with
  | none => rfl
  | some x => rfl

theorem colAt_node_nil (cols : List Column) (j : Nat) : (Tree.node cols).colAt ⟨[], j⟩ = cols[j]? := rfl

/-- helper: stop data of a literal cap at a valid address (cf. T3.8c `stopData_litCap`). -/
theorem stopF_litCapAux (k p : Nat) : ∀ (ρ : List (Nat × Nat)) (j : Nat) (F : Forest) (col : Column),
    F.colAt ⟨ρ, j⟩ = some col →
    stopF [] (litCapAux k p ρ j F) =
      some { depth := ρ.length, col := ⟨ρ, j⟩, t := ColAddr.num 0 ⟨ρ, j⟩, r := p, Q := col.take k }
  | [], j, .node cols, col, h => by
    rw [colAt_node_nil] at h
    have hj : j < cols.length := (List.getElem?_eq_some_iff.1 h).1
    simp only [litCapAux, List.getD_eq_getElem?_getD, h, Option.getD_some]
    rw [stopF_snoc, if_pos rfl, List.length_take_of_le (by omega)]
  | (ci, ei) :: ρ, j, .node cols, col, h => by
    rw [colAt_node_cons] at h
    cases he : (cols[ci]?).bind (·[ei]?) with
    | none => rw [he] at h; simp at h
    | some x =>
      obtain ⟨q, H⟩ := x
      rw [he] at h
      simp only [Option.bind_some] at h
      have ih := stopF_litCapAux k p ρ j H col h
      obtain ⟨colc, hc, hx⟩ := Option.bind_eq_some_iff.1 he
      have hci : ci < cols.length := (List.getElem?_eq_some_iff.1 hc).1
      have hei : ei < colc.length := (List.getElem?_eq_some_iff.1 hx).1
      simp only [litCapAux, List.getD_eq_getElem?_getD, hc, Option.getD_some, hx]
      rw [stopF_snoc, if_neg (stopF_ne_empty ih), stopF_prepend, ih, List.length_take_of_le (by omega),
        List.length_take_of_le (by omega)]
      simp only [Option.map_some, sdPrepend, ColAddr.num, Option.some.injEq, StopData.mk.injEq]
      simp
      omega

theorem litCap_eq_aux {E : Forest} {c : ColAddr} {col : Column} (h : E.colAt c = some col) (k p : Nat) :
    litCap E c k p = litCapAux k p c.path c.col E := by
  simp [litCap, litCapBody, h]

/-- helper (cf. T3.8c `stopData_litCap`): stop data of a literal cap. -/
theorem stopData_litCap' {E : Forest} {c : ColAddr} {col : Column} (h : E.colAt c = some col)
    (k p : Nat) :
    stopData (litCap E c k p) =
      some { depth := c.path.length, col := c, t := c.num 0, r := p, Q := col.take k } := by
  rw [litCap_eq_aux h]
  exact stopF_litCapAux k p c.path c.col E col h

/-- helper: `stopF` after deleting entries `i … e-1` of a column on the route. -/
theorem stopF_modifyColAux (c e i : Nat) (rest : List (Nat × Nat)) (hi : i ≤ e) :
    ∀ (P : List (Nat × Nat)) (F : Forest) (sd : StopData), stopF [] F = some sd →
      sd.col.path = P ++ (c, e) :: rest →
      stopF [] (modifyColAux (fun col => col.take i ++ col.drop e) P c F) =
        some { sd with col := ⟨P ++ (c, i) :: rest, sd.col.col⟩ }
  | [], F, sd, hs, hp => by
    obtain ⟨pre, Q, q, h, rfl, (⟨hh, rfl⟩ | ⟨hh, sd', hs', rfl⟩)⟩ := stopF_some_iff.1 hs
    · simp at hp
    · simp only [sdPrepend, List.singleton_append, List.nil_append, List.cons.injEq,
        Prod.mk.injEq] at hp
      obtain ⟨⟨rfl, rfl⟩, rfl⟩ := hp
      simp only [modifyColAux, list_modify_snoc]
      have hf : (Q ++ [(q, h)]).take i ++ (Q ++ [(q, h)]).drop Q.length = Q.take i ++ [(q, h)] := by
        rw [List.take_append_of_le_length hi, List.drop_left]
      rw [hf]
      refine stopF_some_iff.2 ⟨pre, Q.take i, q, h, rfl, Or.inr ⟨hh, sd', hs', ?_⟩⟩
      rw [List.length_take_of_le hi]
      simp [sdPrepend]
  | (a, b) :: P, F, sd, hs, hp => by
    obtain ⟨pre, Q, q, h, rfl, (⟨hh, rfl⟩ | ⟨hh, sd', hs', rfl⟩)⟩ := stopF_some_iff.1 hs
    · simp at hp
    · simp only [sdPrepend, List.singleton_append, List.cons_append, List.cons.injEq,
        Prod.mk.injEq] at hp
      obtain ⟨⟨rfl, rfl⟩, hp⟩ := hp
      have ih := stopF_modifyColAux c e i rest hi P h sd' hs' hp
      simp only [modifyColAux, list_modify_snoc]
      refine stopF_some_iff.2 ⟨pre, Q, q, _, rfl, Or.inr ⟨stopF_ne_empty ih, _, ih, ?_⟩⟩
      simp [sdPrepend]

/-! ### helpers: index maps of moves -/

theorem fwdIdx_bwdIdx (m : Move) (e : Nat) : m.fwdIdx (m.bwdIdx e) = e := by
  unfold Move.fwdIdx Move.bwdIdx; split_ifs <;> omega

theorem mapPath_through (g : Nat → Nat) (m : Move) (e : Nat) (D : List (Nat × Nat)) :
    m.mapPath g (m.col.path ++ (m.col.col, e) :: D) = m.col.path ++ (m.col.col, g e) :: D := by
  simp [Move.mapPath]

theorem mapPath_off (g : Nat → Nat) (m : Move) (π : List (Nat × Nat))
    (h : ∀ e D, π ≠ m.col.path ++ (m.col.col, e) :: D) : m.mapPath g π = π := by
  unfold Move.mapPath
  split_ifs with h1
  · split
    · next c e he =>
      split_ifs with h3
      · exfalso
        have hl : m.col.path.length < π.length := (List.getElem?_eq_some_iff.1 he).1
        apply h e (π.drop (m.col.path.length + 1))
        conv_lhs => rw [← List.take_append_drop m.col.path.length π]
        rw [h1, List.drop_eq_getElem_cons hl]
        have := (List.getElem?_eq_some_iff.1 he).2
        rw [this, h3]
      · rfl
    · rfl
  · rfl

theorem mapPath_cases (m : Move) (π : List (Nat × Nat)) :
    (∃ e D, π = m.col.path ++ (m.col.col, e) :: D) ∨ ∀ e D, π ≠ m.col.path ++ (m.col.col, e) :: D := by
  by_cases h : ∃ e D, π = m.col.path ++ (m.col.col, e) :: D
  · exact Or.inl h
  · exact Or.inr fun e D he => h ⟨e, D, he⟩

theorem mapPath_comp (g g' : Nat → Nat) (m : Move) (π : List (Nat × Nat)) :
    m.mapPath g' (m.mapPath g π) = m.mapPath (g' ∘ g) π := by
  rcases mapPath_cases m π with ⟨e, D, rfl⟩ | h
  · simp only [mapPath_through, Function.comp]
  · rw [mapPath_off g m π h, mapPath_off g' m π h, mapPath_off _ m π h]

theorem mapPath_id (m : Move) (π : List (Nat × Nat)) : m.mapPath id π = π := by
  rcases mapPath_cases m π with ⟨e, D, rfl⟩ | h
  · simp only [mapPath_through, id]
  · exact mapPath_off id m π h

theorem mapPath_eq_colPath_iff (g : Nat → Nat) (m : Move) (π : List (Nat × Nat)) :
    m.mapPath g π = m.col.path ↔ π = m.col.path := by
  rcases mapPath_cases m π with ⟨e, D, rfl⟩ | h
  · rw [mapPath_through]
    constructor <;> intro h' <;> exact absurd (congrArg List.length h') (by simp)
  · rw [mapPath_off g m π h]

theorem colAddr_mapPath_eq_iff (g : Nat → Nat) (m : Move) (π : List (Nat × Nat)) (cc : Nat) :
    ((⟨m.mapPath g π, cc⟩ : ColAddr) = m.col) ↔ ((⟨π, cc⟩ : ColAddr) = m.col) := by
  have h := mapPath_eq_colPath_iff g m π
  obtain ⟨⟨P, c⟩, i, j⟩ := m
  simp only [ColAddr.mk.injEq] at h ⊢
  rw [h]

theorem mapEntry_col (g : Nat → Nat) (m : Move) (b : EntryAddr) :
    (m.mapEntry g b).col = ⟨m.mapPath g b.col.path, b.col.col⟩ := by
  unfold Move.mapEntry; dsimp only; split_ifs <;> rfl

theorem mapEntry_comp (g g' : Nat → Nat) (m : Move) (b : EntryAddr) :
    m.mapEntry g' (m.mapEntry g b) = m.mapEntry (g' ∘ g) b := by
  have hc := mapEntry_col g m b
  have h1 := colAddr_mapPath_eq_iff g m b.col.path b.col.col
  have h2 := colAddr_mapPath_eq_iff g' m (m.mapPath g b.col.path) b.col.col
  have h3 := colAddr_mapPath_eq_iff (g' ∘ g) m b.col.path b.col.col
  unfold Move.mapEntry at hc ⊢
  dsimp only at hc ⊢
  rw [hc]
  dsimp only
  rw [mapPath_comp]
  rw [mapPath_comp] at h2
  by_cases h : (⟨b.col.path, b.col.col⟩ : ColAddr) = m.col
  · rw [if_pos (h1.2 h), if_pos (h3.2 h), if_pos (h3.2 h)]; rfl
  · rw [if_neg (fun h' => h (h1.1 h')), if_neg (fun h' => h (h3.1 h')),
      if_neg (fun h' => h (h3.1 h'))]

theorem mapEntry_id (m : Move) (b : EntryAddr) : m.mapEntry id b = b := by
  unfold Move.mapEntry; dsimp only
  rw [mapPath_id]
  split_ifs <;> rfl

theorem mapRole_fwd_bwd (m : Move) (x : Role) : m.mapRole m.fwdIdx (m.mapRole m.bwdIdx x) = x := by
  have hid : m.fwdIdx ∘ m.bwdIdx = id := funext (fwdIdx_bwdIdx m)
  cases x with
  | ord c => simp only [Move.mapRole, mapPath_comp, hid, mapPath_id]
  | slot e => simp only [Move.mapRole, mapEntry_comp, hid, mapEntry_id]

theorem mapRole_bwd_injective (m : Move) : Function.Injective (m.mapRole m.bwdIdx) := fun x y h => by
  rw [← mapRole_fwd_bwd m x, h, mapRole_fwd_bwd]

/-- helper: undo a list of moves, last first (the role part of `originBody`). -/
def backRole (ms : List Move) (x : Role) : Role := ms.foldr (fun m y => m.mapRole m.bwdIdx y) x

theorem backRole_injective (ms : List Move) : Function.Injective (backRole ms) := by
  induction ms with
  | nil => exact fun x y h => h
  | cons m ms ih => exact fun x y h => ih (mapRole_bwd_injective m h)

theorem backRole_append (ms : List Move) (m : Move) (x : Role) :
    backRole (ms ++ [m]) x = backRole ms (m.mapRole m.bwdIdx x) := by
  simp [backRole, List.foldr_append]

theorem originBody_eq {E : Forest} (w : AdmCap E) (x : Role) :
    w.origin x = if backRole w.moves x = .slot ⟨w.col, w.cut⟩ then none else some (backRole w.moves x) :=
  rfl

/-! ### helpers: forests after `modifyColAux` -/

theorem forestAt_nil_path (F : Forest) : F.forestAt [] = some F := by cases F; rfl

theorem list_getElem?_modify_self {α : Type} (l : List α) (i : Nat) (f : α → α) :
    (l.modify i f)[i]? = l[i]?.map f := by
  rw [List.getElem?_modify]; cases l[i]? <;> simp

theorem list_getElem?_modify_ne {α : Type} (l : List α) {i j : Nat} (f : α → α) (h : i ≠ j) :
    (l.modify i f)[j]? = l[j]? := by
  rw [List.getElem?_modify]; cases l[j]? <;> simp [h]

theorem forestAt_modifyColAux_prefix (f : Column → Column) (c : Nat) :
    ∀ (P π : List (Nat × Nat)) (F : Forest), π <+: P →
      (modifyColAux f P c F).forestAt π = (F.forestAt π).map (modifyColAux f (P.drop π.length) c)
  | P, [], F, _ => by simp [forestAt_nil_path]
  | [], _ :: _, _, h => absurd (List.eq_nil_of_prefix_nil h) (List.cons_ne_nil _ _)
  | (a, b) :: P, (a', b') :: π, .node cols, h => by
    obtain ⟨hab, hp⟩ := List.cons_prefix_cons.1 h
    obtain ⟨rfl, rfl⟩ := Prod.mk.inj hab
    simp only [modifyColAux, forestAt_node_cons]
    rw [list_getElem?_modify_self]
    cases hc : cols[a']? with
    | none => rfl
    | some colc =>
      simp only [Option.map_some, Option.bind_some]
      rw [list_getElem?_modify_self]
      cases hx : colc[b']? with
      | none => rfl
      | some x =>
        simp only [Option.map_some, Option.bind_some, List.length_cons, List.drop_succ_cons]
        exact forestAt_modifyColAux_prefix f c P π x.2 hp

theorem forestAt_through_col (c b : Nat) (rest : List (Nat × Nat)) :
    ∀ (P : List (Nat × Nat)) (F : Forest),
      F.forestAt (P ++ (c, b) :: rest) = ((F.colAt ⟨P, c⟩).bind (·[b]?)).bind fun x => x.2.forestAt rest
  | [], .node cols => by simp only [List.nil_append, forestAt_node_cons, colAt_node_nil]
  | (a, b0) :: P, .node cols => by
    rw [List.cons_append, forestAt_node_cons, colAt_node_cons]
    cases (cols[a]?).bind (·[b0]?) with
    | none => rfl
    | some x => exact forestAt_through_col c b rest P x.2

theorem forestAt_modifyColAux_through (f : Column → Column) (c b : Nat) (rest : List (Nat × Nat)) :
    ∀ (P : List (Nat × Nat)) (F : Forest),
      (modifyColAux f P c F).forestAt (P ++ (c, b) :: rest) =
        ((F.colAt ⟨P, c⟩).bind fun col => (f col)[b]?).bind fun x => x.2.forestAt rest
  | [], .node cols => by
    simp only [modifyColAux, List.nil_append, forestAt_node_cons, colAt_node_nil]
    rw [list_getElem?_modify_self]
    cases cols[c]? <;> rfl
  | (a, b0) :: P, .node cols => by
    simp only [modifyColAux, List.cons_append, forestAt_node_cons, colAt_node_cons]
    rw [list_getElem?_modify_self]
    cases hc : cols[a]? with
    | none => rfl
    | some colc =>
      simp only [Option.map_some, Option.bind_some]
      rw [list_getElem?_modify_self]
      cases hx : colc[b0]? with
      | none => rfl
      | some x =>
        simp only [Option.map_some, Option.bind_some]
        exact forestAt_modifyColAux_through f c b rest P x.2

theorem forestAt_modifyColAux_off (f : Column → Column) (c : Nat) :
    ∀ (P π : List (Nat × Nat)) (F : Forest), ¬ π <+: P → (∀ b rest, π ≠ P ++ (c, b) :: rest) →
      (modifyColAux f P c F).forestAt π = F.forestAt π
  | _, [], _, h, _ => absurd (List.nil_prefix) h
  | [], (a, b) :: π, .node cols, _, h' => by
    have hac : a ≠ c := fun hac => h' b π (by rw [hac]; rfl)
    simp only [modifyColAux, forestAt_node_cons]
    rw [list_getElem?_modify_ne _ _ (Ne.symm hac)]
  | (a0, b0) :: P, (a, b) :: π, .node cols, h, h' => by
    simp only [modifyColAux, forestAt_node_cons]
    by_cases ha : a0 = a
    · subst ha
      rw [list_getElem?_modify_self]
      cases hc : cols[a0]? with
      | none => rfl
      | some colc =>
        simp only [Option.map_some, Option.bind_some]
        by_cases hb : b0 = b
        · subst hb
          rw [list_getElem?_modify_self]
          cases colc[b0]? with
          | none => rfl
          | some x =>
            simp only [Option.map_some, Option.bind_some]
            exact forestAt_modifyColAux_off f c P π x.2 (fun hp => h (List.cons_prefix_cons.2 ⟨rfl, hp⟩))
              (fun b rest he => h' b rest (by rw [he]; rfl))
        · rw [list_getElem?_modify_ne _ _ hb]
    · rw [list_getElem?_modify_ne _ _ ha]

theorem cols_length_modifyColAux (f : Column → Column) (c : Nat) :
    ∀ (P : List (Nat × Nat)) (F : Forest), (modifyColAux f P c F).cols.length = F.cols.length
  | [], .node cols => by simp [modifyColAux, Tree.cols]
  | (_, _) :: _, .node cols => by simp [modifyColAux, Tree.cols]

theorem colLen_modifyColAux (f : Column → Column) (c c' : Nat) (P : List (Nat × Nat)) (F : Forest)
    (h : P ≠ [] ∨ c' ≠ c) :
    ((modifyColAux f P c F).cols[c']?).map List.length = (F.cols[c']?).map List.length := by
  obtain ⟨cols⟩ := F
  cases P with
  | nil =>
    simp only [modifyColAux, Tree.cols]
    rw [list_getElem?_modify_ne _ _ (Ne.symm (h.resolve_left (by simp)))]
  | cons ab P =>
    obtain ⟨a, b⟩ := ab
    simp only [modifyColAux, Tree.cols]
    by_cases ha : a = c'
    · subst ha; rw [list_getElem?_modify_self]; cases cols[a]? <;> simp
    · rw [list_getElem?_modify_ne _ _ ha]

/-- helper: the deleted-block column map `col ↦ col.take i ++ col.drop j` reads index `b` of the
result at `bwdIdx b`. -/
theorem getElem?_moveFun (m : Move) (col : Column) (hij : m.i ≤ m.j) (hj : m.j ≤ col.length) (b : Nat) :
    (col.take m.i ++ col.drop m.j)[b]? = col[m.bwdIdx b]? := by
  unfold Move.bwdIdx
  have hl : (col.take m.i).length = m.i := List.length_take_of_le (by omega)
  split_ifs with hb
  · rw [List.getElem?_append_right (by omega), hl, List.getElem?_drop]
    congr 1; omega
  · rw [List.getElem?_append_left (by omega), List.getElem?_take_of_lt (by omega)]

/-! ### helpers: a valid move -/

/-- helper: the column map of a move. -/
def moveFun (m : Move) (col : Column) : Column := col.take m.i ++ col.drop m.j

theorem applyMove_eq_mod {K : Forest} {m : Move} {col : Column} (hcol : K.colAt m.col = some col)
    (hij : m.i < m.j) (hj : m.j < col.length) :
    applyMove K m = modifyColAux (moveFun m) m.col.path m.col.col K := by
  simp only [applyMove, applyMoveBody, hcol, if_pos (And.intro hij hj)]; rfl

theorem colAt_mod_self (f : Column → Column) (K : Forest) (c : ColAddr) :
    (modifyColAux f c.path c.col K).colAt c = (K.colAt c).map f := by
  simp only [Tree.colAt]
  rw [forestAt_modifyColAux_prefix f c.col c.path c.path K (List.prefix_refl _), List.drop_length]
  cases K.forestAt c.path with
  | none => rfl
  | some G =>
    obtain ⟨cols⟩ := G
    simp only [Option.map_some, Option.bind_some, modifyColAux, Tree.cols]
    exact list_getElem?_modify_self _ _ _

theorem forestAt_mod_bwd {K : Forest} {m : Move} {col : Column} (hcol : K.colAt m.col = some col)
    (hij : m.i < m.j) (hj : m.j < col.length) :
    ∀ π G', (modifyColAux (moveFun m) m.col.path m.col.col K).forestAt π = some G' →
      ∃ G, K.forestAt (m.mapPath m.bwdIdx π) = some G ∧ G'.cols.length = G.cols.length ∧
        ∀ c', ¬ (π = m.col.path ∧ c' = m.col.col) →
          (G'.cols[c']?).map List.length = (G.cols[c']?).map List.length := by
  intro π G' hG'
  by_cases h1 : π <+: m.col.path
  · rw [forestAt_modifyColAux_prefix _ _ _ _ _ h1] at hG'
    obtain ⟨G, hG, rfl⟩ := Option.map_eq_some_iff.1 hG'
    have hoff : ∀ e D, π ≠ m.col.path ++ (m.col.col, e) :: D := by
      intro e D he; have := h1.length_le; rw [he] at this; simp at this
    refine ⟨G, by rw [mapPath_off _ _ _ hoff]; exact hG, cols_length_modifyColAux _ _ _ _, ?_⟩
    intro c' hc'
    apply colLen_modifyColAux
    by_cases hπ : π = m.col.path
    · exact Or.inr fun h => hc' ⟨hπ, h⟩
    · left
      intro hd
      apply hπ
      have := List.prefix_iff_eq_take.1 h1
      have hl : m.col.path.length ≤ π.length := by
        have := congrArg List.length hd; simp at this; omega
      rw [this, List.take_of_length_le (by have := h1.length_le; omega)]
  by_cases h2 : ∃ e D, π = m.col.path ++ (m.col.col, e) :: D
  · obtain ⟨e, D, rfl⟩ := h2
    rw [forestAt_modifyColAux_through, show (⟨m.col.path, m.col.col⟩ : ColAddr) = m.col from rfl,
      hcol] at hG'
    simp only [Option.bind_some, moveFun] at hG'
    rw [getElem?_moveFun m col hij.le hj.le] at hG'
    refine ⟨G', ?_, rfl, fun _ _ => rfl⟩
    rw [mapPath_through, forestAt_through_col, show (⟨m.col.path, m.col.col⟩ : ColAddr) = m.col from rfl,
      hcol]
    exact hG'
  · have hoff : ∀ e D, π ≠ m.col.path ++ (m.col.col, e) :: D := fun e D he => h2 ⟨e, D, he⟩
    rw [forestAt_modifyColAux_off _ _ _ _ _ h1 hoff] at hG'
    exact ⟨G', by rw [mapPath_off _ _ _ hoff]; exact hG', rfl, fun _ _ => rfl⟩

/-- helper: every role of the moved tree undoes to a role of the original tree. -/
theorem roles_applyMove_bwd {K : Forest} {m : Move} {col : Column} (hcol : K.colAt m.col = some col)
    (hij : m.i < m.j) (hj : m.j < col.length) :
    ∀ x ∈ (applyMove K m).roles, m.mapRole m.bwdIdx x ∈ K.roles := by
  rw [applyMove_eq_mod hcol hij hj]
  intro x hx
  rw [Tree.mem_roles_iff] at hx ⊢
  cases x with
  | ord a =>
    simp only [Move.mapRole]
    simp only [Tree.colAt, Option.isSome_iff_exists, Option.bind_eq_some_iff] at hx ⊢
    obtain ⟨y, G', hG', hy⟩ := hx
    obtain ⟨G, hG, hlen, -⟩ := forestAt_mod_bwd hcol hij hj a.path G' hG'
    have : a.col < G.cols.length := hlen ▸ (List.getElem?_eq_some_iff.1 hy).1
    exact ⟨_, G, hG, (List.getElem?_eq_some_iff.2 ⟨this, rfl⟩)⟩
  | slot e =>
    obtain ⟨⟨π, c'⟩, idx⟩ := e
    simp only [Move.mapRole]
    by_cases hm : π = m.col.path ∧ c' = m.col.col
    · obtain ⟨rfl, rfl⟩ := hm
      have hme : m.mapEntry m.bwdIdx ⟨m.col, idx⟩ = ⟨m.col, m.bwdIdx idx⟩ := by
        unfold Move.mapEntry; dsimp only
        rw [mapPath_off _ _ _ (fun e D he => by have := congrArg List.length he; simp at this)]
        rw [if_pos rfl]
      rw [show (⟨⟨m.col.path, m.col.col⟩, idx⟩ : EntryAddr) = ⟨m.col, idx⟩ from rfl, hme]
      rw [show (⟨⟨m.col.path, m.col.col⟩, idx⟩ : EntryAddr) = ⟨m.col, idx⟩ from rfl] at hx
      simp only [Tree.entryAt] at hx ⊢
      rw [colAt_mod_self, hcol] at hx
      rw [hcol]
      simp only [Option.map_some, Option.bind_some] at hx ⊢
      rw [moveFun, getElem?_moveFun m col hij.le hj.le] at hx
      exact hx
    · have hne : ¬ ((⟨m.mapPath m.bwdIdx π, c'⟩ : ColAddr) = m.col) := by
        rw [colAddr_mapPath_eq_iff]
        intro h; apply hm; rw [← h]; exact ⟨rfl, rfl⟩
      have hme : m.mapEntry m.bwdIdx ⟨⟨π, c'⟩, idx⟩ = ⟨⟨m.mapPath m.bwdIdx π, c'⟩, idx⟩ := by
        unfold Move.mapEntry; dsimp only; rw [if_neg hne]
      rw [hme]
      simp only [Tree.entryAt, Tree.colAt, Option.isSome_iff_exists, Option.bind_eq_some_iff] at hx ⊢
      obtain ⟨y, col', ⟨G', hG', hcol'⟩, hy⟩ := hx
      obtain ⟨G, hG, -, hlen⟩ := forestAt_mod_bwd hcol hij hj π G' hG'
      have hl := hlen c' hm
      rw [hcol'] at hl
      obtain ⟨col0, hcol0, hl0⟩ := Option.map_eq_some_iff.1 hl.symm
      have hidx : idx < col0.length := hl0 ▸ (List.getElem?_eq_some_iff.1 hy).1
      exact ⟨_, col0, ⟨G, hG, hcol0⟩, List.getElem?_eq_some_iff.2 ⟨hidx, rfl⟩⟩

/-! ### helpers: forests of a literal cap -/

theorem list_getElem?_take_snoc {α : Type} (l : List α) (n : Nat) (x : α) (h : n ≤ l.length) (a : Nat) :
    (l.take n ++ [x])[a]? = if a < n then l[a]? else if a = n then some x else none := by
  have hl : (l.take n).length = n := List.length_take_of_le h
  split_ifs with h1 h2
  · rw [List.getElem?_append_left (by omega), List.getElem?_take_of_lt h1]
  · subst h2; rw [List.getElem?_append_right (by omega), hl]; simp
  · rw [List.getElem?_append_right (by omega), hl]; simp; omega

theorem forestAt_empty_node_cons (x : Nat × Nat) (rest : List (Nat × Nat)) :
    (Tree.empty : Forest).forestAt (x :: rest) = none := by
  obtain ⟨a, b⟩ := x; simp [Tree.empty, forestAt_node_cons]

/-- helper: what a literal cap keeps, read at an arbitrary path. -/
theorem forestAt_litCapAux (k p : Nat) :
    ∀ (ρ : List (Nat × Nat)) (j : Nat) (F : Forest) (col : Column), F.colAt ⟨ρ, j⟩ = some col →
      k ≤ col.length → ∀ π G', (litCapAux k p ρ j F).forestAt π = some G' →
      (π = ρ ++ [(j, k)] ∧ G' = Tree.empty) ∨ ∃ G, F.forestAt π = some G ∧
        G'.cols.length ≤ G.cols.length ∧ ∀ c' col', G'.cols[c']? = some col' →
          ∃ col0, G.cols[c']? = some col0 ∧ ∀ idx < col'.length,
            idx < col0.length ∨ (π = ρ ∧ c' = j ∧ idx = k)
  | [], j, .node cols, col, hcol, hk, π, G', hG' => by
    rw [colAt_node_nil] at hcol
    have hj : j < cols.length := (List.getElem?_eq_some_iff.1 hcol).1
    simp only [litCapAux, List.getD_eq_getElem?_getD, hcol, Option.getD_some] at hG'
    cases π with
    | nil =>
      rw [forestAt_nil_path] at hG'
      obtain rfl := Option.some.inj hG'
      right
      refine ⟨_, forestAt_nil_path _, ?_, ?_⟩
      · simp only [Tree.cols, List.length_append, List.length_take, List.length_singleton]; omega
      · intro c' col' hc'
        simp only [Tree.cols] at hc' ⊢
        rw [list_getElem?_take_snoc _ _ _ hj.le] at hc'
        split_ifs at hc' with h1 h2
        · exact ⟨col', hc', fun idx hidx => Or.inl hidx⟩
        · subst h2
          obtain rfl := Option.some.inj hc'
          refine ⟨col, hcol, fun idx hidx => ?_⟩
          simp only [List.length_append, List.length_take, List.length_singleton] at hidx
          by_cases hik : idx = k
          · exact Or.inr (by simp [hik])
          · left; omega
    | cons ab rest =>
      obtain ⟨a, b⟩ := ab
      rw [forestAt_node_cons, list_getElem?_take_snoc _ _ _ hj.le] at hG'
      split_ifs at hG' with h1 h2
      · right; exact ⟨G', by rw [forestAt_node_cons]; exact hG', le_refl _,
          fun c' col' h => ⟨col', h, fun idx hidx => Or.inl hidx⟩⟩
      · subst h2
        simp only [Option.bind_some] at hG'
        rw [list_getElem?_take_snoc _ _ _ hk] at hG'
        split_ifs at hG' with h3 h4
        · right
          refine ⟨G', ?_, le_refl _, fun c' col' h => ⟨col', h, fun idx hidx => Or.inl hidx⟩⟩
          rw [forestAt_node_cons, hcol]; exact hG'
        · subst h4
          simp only [Option.bind_some] at hG'
          cases rest with
          | nil =>
            rw [forestAt_nil_path] at hG'
            exact Or.inl ⟨rfl, (Option.some.inj hG').symm⟩
          | cons x rest => rw [forestAt_empty_node_cons] at hG'; simp at hG'
        · simp at hG'
      · simp at hG'
  | (ci, ei) :: ρ, j, .node cols, col, hcol, hk, π, G', hG' => by
    rw [colAt_node_cons] at hcol
    obtain ⟨x, hx, hcolx⟩ := Option.bind_eq_some_iff.1 hcol
    obtain ⟨colc, hc, hx'⟩ := Option.bind_eq_some_iff.1 hx
    have hci : ci < cols.length := (List.getElem?_eq_some_iff.1 hc).1
    have hei : ei < colc.length := (List.getElem?_eq_some_iff.1 hx').1
    obtain ⟨q, H⟩ := x
    simp only [litCapAux, List.getD_eq_getElem?_getD, hc, Option.getD_some, hx'] at hG'
    cases π with
    | nil =>
      rw [forestAt_nil_path] at hG'
      obtain rfl := Option.some.inj hG'
      right
      refine ⟨_, forestAt_nil_path _, ?_, ?_⟩
      · simp only [Tree.cols, List.length_append, List.length_take, List.length_singleton]; omega
      · intro c' col' hc'
        simp only [Tree.cols] at hc' ⊢
        rw [list_getElem?_take_snoc _ _ _ hci.le] at hc'
        split_ifs at hc' with h1 h2
        · exact ⟨col', hc', fun idx hidx => Or.inl hidx⟩
        · subst h2
          obtain rfl := Option.some.inj hc'
          refine ⟨colc, hc, fun idx hidx => ?_⟩
          simp only [List.length_append, List.length_take, List.length_singleton] at hidx
          left; omega
    | cons ab rest =>
      obtain ⟨a, b⟩ := ab
      rw [forestAt_node_cons, list_getElem?_take_snoc _ _ _ hci.le] at hG'
      split_ifs at hG' with h1 h2
      · right; exact ⟨G', by rw [forestAt_node_cons]; exact hG', le_refl _,
          fun c' col' h => ⟨col', h, fun idx hidx => Or.inl hidx⟩⟩
      · subst h2
        simp only [Option.bind_some] at hG'
        rw [list_getElem?_take_snoc _ _ _ hei.le] at hG'
        split_ifs at hG' with h3 h4
        · right
          refine ⟨G', ?_, le_refl _, fun c' col' h => ⟨col', h, fun idx hidx => Or.inl hidx⟩⟩
          rw [forestAt_node_cons, hc]; exact hG'
        · subst h4
          simp only [Option.bind_some] at hG'
          rcases forestAt_litCapAux k p ρ j H col hcolx hk rest G' hG' with ⟨rfl, rfl⟩ | ⟨G, hG, hl, hcc⟩
          · exact Or.inl ⟨rfl, rfl⟩
          · right
            refine ⟨G, ?_, hl, fun c' col' h => ?_⟩
            · rw [forestAt_node_cons, hc]; simp only [Option.bind_some, hx']; exact hG
            · obtain ⟨col0, h0, hidx⟩ := hcc c' col' h
              refine ⟨col0, h0, fun idx hi => ?_⟩
              rcases hidx idx hi with h | ⟨rfl, rfl, rfl⟩
              · exact Or.inl h
              · exact Or.inr ⟨rfl, rfl, rfl⟩
        · simp at hG'
      · simp at hG'

/-- helper: every role of a literal cap is a role of `E` or the appended closing slot. -/
theorem roles_litCap {E : Forest} {c : ColAddr} {col : Column} (hcol : E.colAt c = some col)
    {k : Nat} (hk : k ≤ col.length) (p : Nat) :
    ∀ x ∈ (litCap E c k p).roles, x = .slot ⟨c, k⟩ ∨ x ∈ E.roles := by
  rw [litCap_eq_aux hcol]
  intro x hx
  rw [Tree.mem_roles_iff] at hx
  cases x with
  | ord a =>
    right
    rw [Tree.mem_roles_iff]
    simp only [Tree.colAt, Option.isSome_iff_exists, Option.bind_eq_some_iff] at hx ⊢
    obtain ⟨y, G', hG', hy⟩ := hx
    rcases forestAt_litCapAux k p c.path c.col E col hcol hk a.path G' hG' with ⟨-, rfl⟩ | ⟨G, hG, hl, -⟩
    · simp [Tree.empty, Tree.cols] at hy
    · have : a.col < G.cols.length := by have := (List.getElem?_eq_some_iff.1 hy).1; omega
      exact ⟨_, G, hG, List.getElem?_eq_some_iff.2 ⟨this, rfl⟩⟩
  | slot e =>
    obtain ⟨⟨π, c'⟩, idx⟩ := e
    simp only [Tree.entryAt, Tree.colAt, Option.isSome_iff_exists, Option.bind_eq_some_iff] at hx
    obtain ⟨y, col', ⟨G', hG', hcol'⟩, hy⟩ := hx
    rcases forestAt_litCapAux k p c.path c.col E col hcol hk π G' hG' with ⟨-, rfl⟩ | ⟨G, hG, -, hcc⟩
    · simp [Tree.empty, Tree.cols] at hcol'
    · obtain ⟨col0, h0, hidx⟩ := hcc c' col' hcol'
      rcases hidx idx (List.getElem?_eq_some_iff.1 hy).1 with h | ⟨rfl, rfl, rfl⟩
      · right
        rw [Tree.mem_roles_iff]
        simp only [Tree.entryAt, Tree.colAt, Option.isSome_iff_exists, Option.bind_eq_some_iff]
        exact ⟨_, col0, ⟨G, hG, h0⟩, List.getElem?_eq_some_iff.2 ⟨h, rfl⟩⟩
      · left; rfl

/-! ### helpers: stop data along legal moves -/

theorem stopData_applyMove {K : Forest} {m : Move} (hm : MoveOK K m) {sd : StopData}
    (hsd : stopData K = some sd) :
    ∃ rest, sd.col.path = m.col.path ++ (m.col.col, m.j) :: rest ∧
      stopData (applyMove K m) =
        some { sd with col := ⟨m.col.path ++ (m.col.col, m.i) :: rest, sd.col.col⟩ } := by
  obtain ⟨col, sd0, hcol, hsd0, hj, hij, hpre, -, -, -⟩ := hm
  rw [hsd] at hsd0
  obtain rfl := Option.some.inj hsd0
  obtain ⟨rest, hrest⟩ := hpre
  have hpath : sd.col.path = m.col.path ++ (m.col.col, m.j) :: rest := by
    rw [← hrest]; simp [EntryAddr.heightPath]
  refine ⟨rest, hpath, ?_⟩
  rw [applyMove_eq_mod hcol hij (by omega)]
  exact stopF_modifyColAux m.col.col m.j m.i rest hij.le m.col.path K sd hsd hpath

theorem bwd_moved_slot (m : Move) (hij : m.i ≤ m.j) (rest : List (Nat × Nat)) (cc n : Nat) :
    m.mapRole m.bwdIdx (.slot ⟨⟨m.col.path ++ (m.col.col, m.i) :: rest, cc⟩, n⟩) =
      .slot ⟨⟨m.col.path ++ (m.col.col, m.j) :: rest, cc⟩, n⟩ := by
  simp only [Move.mapRole, Move.mapEntry, mapPath_through]
  have hb : m.bwdIdx m.i = m.j := by unfold Move.bwdIdx; rw [if_pos le_rfl]; omega
  rw [hb]
  rw [if_neg]
  intro h
  have := congrArg (fun c : ColAddr => c.path.length) h
  simp at this

theorem movesValid_append {K : Forest} {ms : List Move} {m : Move} (h : MovesValid K (ms ++ [m])) :
    MovesValid K ms ∧ MoveOK (applyMoves K ms) m := by
  refine ⟨fun idx hidx => ?_, ?_⟩
  · have := h idx (by simp; omega)
    rw [List.take_append_of_le_length hidx.le, List.getElem_append_left hidx] at this
    exact this
  · have := h ms.length (by simp)
    rw [List.take_left, List.getElem_append_right (by omega)] at this
    simpa using this

theorem applyMoves_snoc (K : Forest) (ms : List Move) (m : Move) :
    applyMoves K (ms ++ [m]) = applyMove (applyMoves K ms) m := by
  simp [applyMoves, List.foldl_append]

theorem isUpward_iff_exists {E : Forest} {c : ColAddr} {k p : Nat} :
    IsUpward E c k p ↔ ∃ col, E.colAt c = some col ∧ k ≤ col.length ∧
      ∀ q h, col[k]? = some (q, h) → q < p := by
  unfold IsUpward
  cases hcol : E.colAt c with
  | none => simp
  | some col =>
    simp only [Option.some.injEq, exists_eq_left']
    cases hk : col[k]? with
    | none =>
      have := List.getElem?_eq_none_iff.1 hk
      simp only [reduceCtorEq, false_implies, implies_true, and_true]
      omega
    | some x =>
      obtain ⟨q, h⟩ := x
      have := (List.getElem?_eq_some_iff.1 hk).1
      simp only [Option.some.injEq, Prod.mk.injEq]
      constructor
      · intro hq; exact ⟨this.le, fun q' h' he => he.1 ▸ hq⟩
      · intro ⟨_, h⟩; exact h q _ ⟨rfl, rfl⟩

/-- helper: the invariant behind `origin_spec`: roles of the moved cap undo to roles of the literal
cap, and the closing slot undoes to the appended slot. -/
theorem adm_invariant {E : Forest} {c : ColAddr} {k p : Nat} (hup : IsUpward E c k p) :
    ∀ ms : List Move, MovesValid (litCap E c k p) ms →
      (∀ x ∈ (applyMoves (litCap E c k p) ms).roles, backRole ms x ∈ (litCap E c k p).roles) ∧
      ∃ sd, stopData (applyMoves (litCap E c k p) ms) = some sd ∧
        backRole ms (.slot (closingSlot sd)) = .slot ⟨c, k⟩ := by
  intro ms
  induction ms using List.reverseRecOn with
  | nil =>
    intro _
    refine ⟨fun x hx => hx, ?_⟩
    obtain ⟨col, hcol, hk, -⟩ := isUpward_iff_exists.1 hup
    refine ⟨_, stopData_litCap' hcol k p, ?_⟩
    simp [backRole, closingSlot, List.length_take_of_le hk]
  | append_singleton ms m ih =>
    intro hv
    obtain ⟨hv, hm⟩ := movesValid_append hv
    obtain ⟨ihr, sd, hsd, hback⟩ := ih hv
    rw [applyMoves_snoc]
    have hm' := hm
    obtain ⟨col, -, hcol, -, hj, hij, -⟩ := hm'
    refine ⟨fun x hx => ?_, ?_⟩
    · rw [backRole_append]
      exact ihr _ (roles_applyMove_bwd hcol hij (by omega) x hx)
    · obtain ⟨rest, hpath, hsd'⟩ := stopData_applyMove hm hsd
      refine ⟨_, hsd', ?_⟩
      rw [backRole_append]
      simp only [closingSlot]
      rw [bwd_moved_slot m hij.le, ← hpath]
      exact hback

-- provides: U2, D3.1a (`origin_spec`†: χ is injective on the roles of `w.H`, `none` exactly on
-- the closing slot, and the identity on every role of a literal cap other than that slot)
theorem origin_spec {E : Forest} (w : AdmCap E) :
    (∀ x ∈ w.H.roles, ∀ y ∈ w.H.roles, ∀ z, w.origin x = some z → w.origin y = some z → x = y) ∧
    (∀ x ∈ w.H.roles, w.origin x = none ↔
      ∃ sd, stopData w.H = some sd ∧ x = .slot (closingSlot sd)) ∧
    (w.moves = [] → ∀ x ∈ w.H.roles, x ≠ .slot ⟨w.col, w.cut⟩ → w.origin x = some x) ∧
    (∀ x ∈ w.H.roles, ∀ z, w.origin x = some z → z ∈ E.roles) := by
  obtain ⟨hroles, sdf, hsdf, hback⟩ := adm_invariant w.upward w.moves w.movesValid
  have hsome : ∀ x z, w.origin x = some z → backRole w.moves x = z ∧
      backRole w.moves x ≠ .slot ⟨w.col, w.cut⟩ := by
    intro x z h
    rw [originBody_eq] at h
    split_ifs at h with h1
    exact ⟨Option.some.inj h, h1⟩
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro x _ y _ z hx hy
    obtain ⟨hx, -⟩ := hsome x z hx
    obtain ⟨hy, -⟩ := hsome y z hy
    exact backRole_injective _ (hx.trans hy.symm)
  · intro x _
    rw [originBody_eq]
    constructor
    · intro h
      split_ifs at h with h1
      refine ⟨sdf, hsdf, backRole_injective w.moves ?_⟩
      rw [h1, hback]
    · rintro ⟨sd, hsd, rfl⟩
      have : sd = sdf := Option.some.inj ((hsd.symm.trans hsdf))
      subst this
      rw [if_pos hback]
  · intro h0 x _ hx
    rw [originBody_eq]
    simp only [h0, backRole, List.foldr_nil]
    rw [if_neg hx]
  · intro x hx z hz
    obtain ⟨rfl, hne⟩ := hsome x z hz
    obtain ⟨col, hcol, hk, -⟩ := isUpward_iff_exists.1 w.upward
    rcases roles_litCap hcol hk w.par _ (hroles x hx) with h | h
    · exact absurd h hne
    · exact h


/-! ## §W — U2 half of the S-6 word library -/

section Words

variable {α : Type} [LinearOrder α]

/-- T3.2b: `X'` is a decrease of `X` whose first change is exactly at position `a`: they agree
before `a`, and at `a` either `X'` ends (while `X` continues) or has a smaller letter. -/
def FirstDec (X X' : List α) (a : Nat) : Prop :=
  X'.take a = X.take a ∧ a ≤ X'.length ∧
    ((X'.length = a ∧ a < X.length) ∨ ∃ x x', X[a]? = some x ∧ X'[a]? = some x' ∧ x' < x)

/-- S-6 helper: the list order through its decision position `i`: `X` and `Y` agree before
`i`, `Y` has a letter `y` at `i`, and `X` ends at `i` or has a smaller letter there. -/
theorem ker_lt_iff : ∀ (X Y : List α),
    X < Y ↔ ∃ i y, X.take i = Y.take i ∧ Y[i]? = some y ∧
      (X[i]? = none ∨ ∃ x, X[i]? = some x ∧ x < y)
  | [], [] => by simp
  | [], y :: Y => by
    simp only [List.nil_lt_cons, true_iff]
    exact ⟨0, y, rfl, rfl, Or.inl rfl⟩
  | x :: X, [] => by
    simp only [List.not_lt_nil, false_iff, not_exists, not_and]
    intro i y _ h; simp at h
  | x :: X, y :: Y => by
    rw [List.cons_lt_cons_iff, ker_lt_iff X Y]
    constructor
    · rintro (h | ⟨rfl, i, z, h1, h2, h3⟩)
      · exact ⟨0, y, rfl, rfl, Or.inr ⟨x, rfl, h⟩⟩
      · exact ⟨i + 1, z, by simp [h1], by simpa using h2, by simpa using h3⟩
    · rintro ⟨i, z, h1, h2, h3⟩
      cases i with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq] at h2
        subst h2
        rcases h3 with h3 | ⟨x', h3, h4⟩
        · simp at h3
        · simp only [List.getElem?_cons_zero, Option.some.injEq] at h3
          subst h3; exact Or.inl h4
      | succ i =>
        simp only [List.take_succ_cons, List.cons.injEq, List.getElem?_cons_succ] at h1 h2 h3
        exact Or.inr ⟨h1.1, i, z, h1.2, h2, h3⟩

/-- S-6 helper: agreement before `j` gives agreement at every `i < j`. -/
theorem ker_getElem?_of_take {l₁ l₂ : List α} {i j : Nat} (h : l₁.take j = l₂.take j)
    (hij : i < j) : l₁[i]? = l₂[i]? := by
  rw [← List.getElem?_take_of_lt hij, h, List.getElem?_take_of_lt hij]

/-- S-6 helper: agreement before `j` gives agreement before every `i ≤ j`. -/
theorem ker_take_of_take {l₁ l₂ : List α} {i j : Nat} (h : l₁.take j = l₂.take j)
    (hij : i ≤ j) : l₁.take i = l₂.take i := by
  rw [← Nat.min_eq_left hij, ← List.take_take, h, List.take_take]

/-- S-6 helper: the decision position of `X < Y` is at most `|X|`. -/
theorem ker_lt_pos_le {X Y : List α} {i : Nat} {y : α} (h1 : X.take i = Y.take i)
    (h2 : Y[i]? = some y) (h3 : X[i]? = none ∨ ∃ x, X[i]? = some x ∧ x < y) : i ≤ X.length := by
  rcases h3 with h3 | ⟨x, h3, _⟩
  · have hY : i < Y.length := by
      by_contra h; rw [List.getElem?_eq_none (by omega)] at h2; cases h2
    have := congrArg List.length h1
    rw [List.length_take, List.length_take] at this
    omega
  · by_contra h; rw [List.getElem?_eq_none (by omega)] at h3; cases h3

/-- S-6 helper: a comparison `X < Y` decided at `i` survives any change of `Y` after `i`. -/
theorem ker_lt_of_agree {X Y Y' : List α} {i : Nat} {y : α} (h1 : X.take i = Y.take i)
    (h2 : Y[i]? = some y) (h3 : X[i]? = none ∨ ∃ x, X[i]? = some x ∧ x < y)
    (hY : Y'.take (i + 1) = Y.take (i + 1)) : X < Y' := by
  rw [ker_lt_iff]
  refine ⟨i, y, ?_, ?_, h3⟩
  · rw [h1, ker_take_of_take hY (Nat.le_succ i)]
  · rw [ker_getElem?_of_take hY (Nat.lt_succ_self i), h2]

-- T3.2b (txt:304-307, first part)
theorem lt_of_firstDec {X Y X' Y' : List α} {a b : Nat} (hXY : X < Y) (hX : FirstDec X X' a)
    (hY : Y'.take b = Y.take b ∧ b ≤ Y'.length) (hab : a < b) : X' < Y' := by
  obtain ⟨hXa, haX', hdec⟩ := hX
  obtain ⟨hYb, hbY'⟩ := hY
  obtain ⟨δ, y, h1, h2, h3⟩ := (ker_lt_iff X Y).1 hXY
  rw [ker_lt_iff]
  rcases Nat.lt_or_ge δ a with hδ | hδ
  · -- decided before the change of `X`
    refine ⟨δ, y, ?_, ?_, ?_⟩
    · rw [ker_take_of_take hXa (le_of_lt hδ), h1, ker_take_of_take hYb (by omega)]
    · rw [ker_getElem?_of_take hYb (by omega), h2]
    · rw [ker_getElem?_of_take hXa hδ]; exact h3
  · -- `X'` decreases at `a ≤ δ`, before any change of `Y`
    have hYa : a < Y.length := by
      have := ker_lt_pos_le h1 h2 h3
      have hY : δ < Y.length := by
        by_contra h; rw [List.getElem?_eq_none (by omega)] at h2; cases h2
      omega
    obtain ⟨y', hy'⟩ : ∃ y', Y[a]? = some y' := ⟨Y[a], List.getElem?_eq_getElem hYa⟩
    refine ⟨a, y', ?_, ?_, ?_⟩
    · rw [hXa, ker_take_of_take h1 hδ, ker_take_of_take hYb (le_of_lt hab)]
    · rw [ker_getElem?_of_take hYb hab, hy']
    · rcases hdec with ⟨hlen, _⟩ | ⟨x, x', hx, hx', hlt⟩
      · left; exact List.getElem?_eq_none (by omega)
      · right
        refine ⟨x', hx', ?_⟩
        rcases Nat.lt_or_ge a δ with hlt' | hge
        · have : X[a]? = Y[a]? := ker_getElem?_of_take h1 hlt'
          rw [hx, hy'] at this
          cases this
          exact hlt
        · have had : a = δ := by omega
          subst had
          rw [hy'] at h2
          cases h2
          rcases h3 with h3 | ⟨x₀, h3, h4⟩
          · rw [h3] at hx; cases hx
          · rw [h3] at hx; cases hx
            exact lt_trans hlt h4

-- T3.2b (txt:306-307, second part: changes of `Y` only after position `|X|`)
theorem lt_of_take_succ {X Y Y' : List α} (hXY : X < Y)
    (h : Y'.take (X.length + 1) = Y.take (X.length + 1)) : X < Y' := by
  obtain ⟨δ, y, h1, h2, h3⟩ := (ker_lt_iff X Y).1 hXY
  have hδ := ker_lt_pos_le h1 h2 h3
  exact ker_lt_of_agree h1 h2 h3 (ker_take_of_take h (by omega))

/-- L3.4: the kernel's iterates on words: `kerIter P σ q = P Σ(P) ⋯ Σ^{q-1}(P)`. -/
def kerIter (P : List α) (σ : α → α) : Nat → List α
  | 0 => []
  | q + 1 => P ++ (kerIter P σ q).map σ

/-- L3.4a helper: the length of an iterate. -/
theorem ker_kerIter_len (P : List α) (σ : α → α) :
    ∀ q, (kerIter P σ q).length = q * P.length
  | 0 => by simp [kerIter]
  | q + 1 => by
    simp only [kerIter, List.length_append, List.length_map, ker_kerIter_len P σ q, Nat.succ_mul]
    omega

-- L3.4a: iterates are proper-prefix increasing
theorem kerIter_prefix (P : List α) (σ : α → α) (hP : P ≠ []) (q : Nat) :
    kerIter P σ q <+: kerIter P σ (q + 1) ∧ kerIter P σ q ≠ kerIter P σ (q + 1) := by
  refine ⟨?_, ?_⟩
  · induction q with
    | zero => exact List.nil_prefix
    | succ q ih =>
      show P ++ (kerIter P σ q).map σ <+: P ++ (kerIter P σ (q + 1)).map σ
      exact (List.prefix_append_right_inj P).2 (ih.map σ)
  · intro h
    have := congrArg List.length h
    rw [ker_kerIter_len, ker_kerIter_len, Nat.succ_mul] at this
    have := List.length_pos_of_ne_nil hP
    omega

theorem kerIter_length (P : List α) (σ : α → α) (q : Nat) :
    (kerIter P σ q).length = q * P.length := ker_kerIter_len P σ q

/-- helper: a proper extension is larger. -/
theorem ker_lt_append {t : List α} (ht : t ≠ []) :
    ∀ l : List α, l < l ++ t
  | [] => by
    obtain ⟨x, xs, rfl⟩ := List.exists_cons_of_ne_nil ht
    exact List.nil_lt_cons _ _
  | x :: l => by
    rw [List.cons_append, List.cons_lt_cons_iff]
    exact Or.inr ⟨rfl, ker_lt_append ht l⟩

theorem ker_kerIter_prefix_succ (P : List α) (σ : α → α) :
    ∀ m, kerIter P σ m <+: kerIter P σ (m + 1)
  | 0 => List.nil_prefix
  | q + 1 => by
    show P ++ (kerIter P σ q).map σ <+: P ++ (kerIter P σ (q + 1)).map σ
    exact (List.prefix_append_right_inj P).2 ((ker_kerIter_prefix_succ P σ q).map σ)

theorem ker_kerIter_prefix_le (P : List α) (σ : α → α) {n n' : Nat} (h : n ≤ n') :
    kerIter P σ n <+: kerIter P σ n' := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le h
  clear h
  induction k with
  | zero => exact List.prefix_refl _
  | succ k ih => exact ih.trans (ker_kerIter_prefix_succ P σ (n + k))


/-- L3.4 helper: `F(U) = P ⌢ σ(U)` turns agreement on `t` letters into agreement on `|P| + t`. -/
theorem ker_F_take (P : List α) (σ : α → α) {U V : List α} {t : Nat} (h : U.take t = V.take t) :
    (P ++ U.map σ).take (P.length + t) = (P ++ V.map σ).take (P.length + t) := by
  rw [List.take_length_add_append, List.take_length_add_append, ← List.map_take, h,
    List.map_take]

/-- L3.4 helper: if `Y < F(Y)`, every iterate longer than `|Y|` covers `Y`. -/
theorem ker_cover (P : List α) {σ : α → α} (hP : P ≠ []) {Y : List α}
    (h : Y < P ++ Y.map σ) {q : Nat} (hq : Y.length < q * P.length) : Y < kerIter P σ q := by
  obtain ⟨δ, z, h1, h2, h3⟩ := (ker_lt_iff Y _).1 h
  have hδ := ker_lt_pos_le h1 h2 h3
  have hPpos := List.length_pos_of_ne_nil hP
  -- the iterates agree with `Y` before `min δ (q' |P|)`
  have hagree : ∀ q', Y.take (min δ (q' * P.length)) =
      (kerIter P σ q').take (min δ (q' * P.length)) := by
    intro q'
    induction q' with
    | zero => simp
    | succ q' ih =>
      have hF := ker_F_take P σ ih
      have hm : min δ ((q' + 1) * P.length) ≤ min δ (P.length + min δ (q' * P.length)) := by
        rw [Nat.succ_mul]; omega
      apply ker_take_of_take _ hm
      rw [ker_take_of_take h1 (Nat.min_le_left _ _)]
      exact ker_take_of_take hF (Nat.min_le_right _ _)
  cases q with
  | zero => simp at hq
  | succ q =>
    have hF := ker_F_take P σ (hagree q)
    apply ker_lt_of_agree h1 h2 h3
    symm
    apply ker_take_of_take hF
    rw [Nat.succ_mul] at hq
    omega

-- L3.4b (txt:427-436): success iff some iterate covers
theorem word_criterion (P : List α) {σ : α → α} (hP : P ≠ []) (hσ : StrictMono σ)
    (Y : List α) : Y < P ++ Y.map σ ↔ ∃ q, Y < kerIter P σ q := by
  have hPpos := List.length_pos_of_ne_nil hP
  constructor
  · intro h
    refine ⟨Y.length + 1, ker_cover P hP h ?_⟩
    rw [Nat.succ_mul]
    have : Y.length ≤ Y.length * P.length := Nat.le_mul_of_pos_right _ hPpos
    omega
  · rintro ⟨q, hq⟩
    obtain ⟨δ, z, h1, h2, h3⟩ := (ker_lt_iff Y _).1 hq
    cases q with
    | zero => simp [kerIter] at h2
    | succ q =>
      have hδK : δ < (kerIter P σ (q + 1)).length := by
        by_contra h; rw [List.getElem?_eq_none (by omega)] at h2; cases h2
      have hpre := ker_kerIter_prefix_le P σ (Nat.le_succ q)
      set t := min δ (kerIter P σ q).length with ht
      have hYt : Y.take t = (kerIter P σ q).take t := by
        rw [ker_take_of_take h1 (Nat.min_le_left _ _)]
        obtain ⟨u, hu⟩ := hpre
        rw [← hu, List.take_append_of_le_length (Nat.min_le_right _ _)]
      have hF := ker_F_take P σ hYt
      have hlen := kerIter_length P σ (q + 1)
      have hlen' := kerIter_length P σ q
      apply ker_lt_of_agree h1 h2 h3
      apply ker_take_of_take hF
      rw [Nat.succ_mul] at hlen
      omega

-- L3.4c: success is downward closed in the target
theorem success_anti (P : List α) {σ : α → α} (hP : P ≠ []) (hσ : StrictMono σ)
    {Y Y' : List α} (hle : Y' ≤ Y) (h : Y < P ++ Y.map σ) : Y' < P ++ Y'.map σ := by
  obtain ⟨q, hq⟩ := (word_criterion P hP hσ Y).1 h
  exact (word_criterion P hP hσ Y').2 ⟨q, lt_of_le_of_lt hle hq⟩

-- L3.4d: the explicit iteration bound `q |P| > |w(Y)|`
theorem cover_of_success (P : List α) {σ : α → α} (hP : P ≠ []) (hσ : StrictMono σ)
    {Y : List α} (h : Y < P ++ Y.map σ) {q : Nat} (hq : Y.length < q * P.length) :
    Y < kerIter P σ q := ker_cover P hP h hq

-- L3.4e: equality `F(Y) = Y` is impossible by length
theorem kernel_ne (P : List α) (σ : α → α) (hP : P ≠ []) (Y : List α) : P ++ Y.map σ ≠ Y := by
  intro h
  have := congrArg List.length h
  rw [List.length_append, List.length_map] at this
  have := List.length_pos_of_ne_nil hP
  omega

-- L3.7 (txt:482-487): delayed change
theorem delayed_change {L R L' R' : List α} {lam : Nat} (hRL : R < L) (hlen : R.length ≤ lam)
    (hagree : L'.take lam = L.take lam) (hL' : lam ≤ L'.length) (hR : R' < R) : R' < L' := by
  obtain ⟨δ, y, h1, h2, h3⟩ := (ker_lt_iff R L).1 hRL
  have hδ := ker_lt_pos_le h1 h2 h3
  apply lt_of_lt_of_le hR
  rcases Nat.lt_or_ge δ lam with hlt | hge
  · exact le_of_lt (ker_lt_of_agree h1 h2 h3 (ker_take_of_take hagree hlt))
  · -- `R` is a prefix of `L'`
    have hRe : R.take δ = R := List.take_of_length_le (by omega)
    have hRL' : R = L'.take δ := by rw [← hRe, h1, ker_take_of_take hagree (by omega)]
    obtain ⟨t, ht⟩ := List.take_prefix δ L'
    rw [hRL']
    conv_rhs => rw [← ht]
    by_cases h0 : t = []
    · rw [h0, List.append_nil]
    · exact le_of_lt (ker_lt_append h0 _)

/-- T3.2p helper: a word between `T ⌢ D` (letters of `D` below `K`) and `T ⌢ [K]` (letters of `T`
at least `K`) keeps exactly `T` as its run of letters `≥ K`. -/
theorem spx_takeWhile_between {K : α} : ∀ (T D Z : List α), (∀ t ∈ T, K ≤ t) →
    (∀ d ∈ D, d < K) → T ++ D ≤ Z → Z < T ++ [K] →
      Z.takeWhile (fun y => decide (K ≤ y)) = T
  | [], D, [], _, _, _, _ => rfl
  | [], D, z :: Z, _, _, _, h2 => by
    rcases List.cons_lt_cons_iff.1 h2 with h | ⟨-, h⟩
    · simp [not_le.2 h]
    · exact absurd h (List.not_lt_nil _)
  | t :: T, D, [], _, _, h1, _ => by
    exact absurd (List.nil_lt_cons t (T ++ D)) (not_lt.2 h1)
  | t :: T, D, z :: Z, hT, hD, h1, h2 => by
    have h1' : ¬ z :: Z < t :: (T ++ D) := not_lt.2 h1
    rw [List.cons_lt_cons_iff] at h1'
    have h2' := List.cons_lt_cons_iff.1 h2
    have hzt : z = t := by
      rcases h2' with h | ⟨h, -⟩
      · exact absurd (Or.inl h) h1'
      · exact h
    subst hzt
    have h2'' : Z < T ++ [K] := by
      rcases h2' with h | ⟨-, h⟩
      · exact absurd h (lt_irrefl _)
      · exact h
    have h1'' : T ++ D ≤ Z := by
      rw [← not_lt]; intro h; exact h1' (Or.inr ⟨rfl, h⟩)
    have hK : K ≤ z := hT z List.mem_cons_self
    rw [List.takeWhile_cons, if_pos (by simpa using hK),
      spx_takeWhile_between T D Z (fun t ht => hT t (List.mem_cons_of_mem _ ht)) hD h1'' h2'']

/-- T3.2p helper: the one-step reset. -/
theorem spx_reset_one (ks Z : List α) {c : Nat} (hc : c < ks.length)
    (hZ : Z.Pairwise fun x y => y ≤ x) (h1 : cutQuery ks c ≤ Z) (h2 : Z < cutQuery ks (c + 1)) :
    nu (Z ++ [ks[c]]) = cutQuery ks (c + 1) := by
  have hB := cutQuery_noninc ks c
  rw [nu_append_singleton, nu_of_noninc hZ, nuStep_eq_takeWhile hZ, cutQuery_succ hc,
    nuStep_eq_takeWhile hB]
  rw [cutQuery_succ hc, nuStep_eq_takeWhile hB] at h2
  congr 1
  set B := cutQuery ks c
  refine spx_takeWhile_between _ (B.dropWhile fun y => decide (ks[c] ≤ y)) Z ?_ ?_ ?_ h2
  · intro t ht; simpa using mem_takeWhile_imp_of ht
  · intro d hd
    -- the letters after the run are below `ks[c]` (the word is nonincreasing)
    have hsplit := List.takeWhile_append_dropWhile (p := fun y => decide (ks[c] ≤ y)) (l := B)
    cases hdw : B.dropWhile (fun y => decide (ks[c] ≤ y)) with
    | nil => rw [hdw] at hd; simp at hd
    | cons d₀ ds =>
      have hd₀ : d₀ < ks[c] := by
        have := List.head_dropWhile_not (fun y => decide (ks[c] ≤ y)) (l := B) (by simp [hdw])
        simp only [hdw, List.head_cons] at this
        simpa using this
      rw [hdw] at hd
      rcases List.mem_cons.1 hd with rfl | hd
      · exact hd₀
      · have hnon : (d₀ :: ds).Pairwise fun x y => y ≤ x := by
          rw [← hdw]; exact hB.sublist (List.dropWhile_sublist _)
        exact lt_of_le_of_lt (List.rel_of_pairwise_cons hnon hd) hd₀
  · rw [List.takeWhile_append_dropWhile]; exact h1

-- T3.2p (txt:377-382): the reset identity `ν(Z ⌢ [K_c]) = B_c`, iterated through the suffix
theorem reset_nu (ks Z : List α) {c : Nat} (hc : c < ks.length)
    (hZ : Z.Pairwise fun x y => y ≤ x) (h1 : cutQuery ks c ≤ Z) (h2 : Z < cutQuery ks (c + 1))
    {v : Nat} (hv1 : 1 ≤ v) (hv : c + v ≤ ks.length) :
    nu (Z ++ (ks.drop c).take v) = cutQuery ks (c + v) := by
  obtain ⟨w, rfl⟩ : ∃ w, v = w + 1 := ⟨v - 1, by omega⟩
  rw [List.drop_eq_getElem_cons hc, List.take_succ_cons,
    show Z ++ ks[c] :: (ks.drop (c + 1)).take w = (Z ++ [ks[c]]) ++ (ks.drop (c + 1)).take w by simp,
    ← nu_append_nu, spx_reset_one ks Z hc hZ h1 h2, cutQuery, nu_append_nu, ← List.take_add,
    show c + 1 + w = c + (w + 1) by omega]
  rfl

-- T3.2p (txt:386-389): the head cursor `m + γ − c` (including exhaustion)
theorem head_cursor (qs ks : List α) {c : Nat} (hc : c ≤ ks.length)
    (h1 : cutQuery ks c ≤ nu qs) (h2 : c < ks.length → nu qs < cutQuery ks (c + 1))
    {V : List α} (hV : V.Pairwise fun x y => y ≤ x) :
    (V < nu qs → cursor (qs ++ ks.drop c) V < qs.length) ∧
    (nu qs ≤ V → c ≤ cursor ks V ∧
      cursor (qs ++ ks.drop c) V = qs.length + (cursor ks V - c)) := by
  refine ⟨fun hlt => ?_, fun hle => ?_⟩
  · have hq : cursor qs V < qs.length := by
      have := cursor_le_length qs V
      rcases Nat.lt_or_eq_of_le this with h | h
      · exact h
      · exact absurd ((cursor_eq_length_iff qs hV).1 h) (not_le.2 hlt)
    rw [cursor_append_of_lt _ hq]; exact hq
  · have hcm : c ≤ cursor ks V := le_cursor_of_cutQuery_le hV hc (le_trans h1 hle)
    refine ⟨hcm, ?_⟩
    set m := cursor ks V with hm
    have hmL : m ≤ ks.length := cursor_le_length ks V
    obtain ⟨hlo, hhi⟩ := cursor_spec ks V hV
    -- the cut queries of the concatenated source past `qs`
    have hcut : ∀ w, c + w ≤ ks.length →
        cutQuery (qs ++ ks.drop c) (qs.length + w) = if w = 0 then nu qs else cutQuery ks (c + w) := by
      intro w hw
      rw [cutQuery, List.take_append, List.take_of_length_le (by omega), Nat.add_sub_cancel_left,
        ← nu_append_nu]
      split_ifs with hw0
      · subst hw0; simp [nu_of_noninc (nu_noninc qs)]
      · exact reset_nu ks (nu qs) (by omega) (nu_noninc qs) h1 (h2 (by omega)) (by omega) hw
    apply cursor_unique hV
    · simp only [List.length_append, List.length_drop]; omega
    · rw [hcut (m - c) (by omega)]
      split_ifs with h0
      · exact hle
      · rw [show c + (m - c) = m by omega]; exact hlo
    · intro hlt
      simp only [List.length_append, List.length_drop] at hlt
      rw [show qs.length + (m - c) + 1 = qs.length + (m - c + 1) by omega,
        hcut (m - c + 1) (by omega), if_neg (by omega), show c + (m - c + 1) = m + 1 by omega]
      exact hhi (by omega)

end Words

/-! ## L3.1 — profile and repair -/

/-! ### L3.1b helpers: the first-entry branch is a pure tower -/

/-- helper: the first-entry branch of a height with host number `a + k`, as V, I and H shape it:
the first column starts with an entry of parent `a + k`, its entries are nonincreasing, and the
branch continues in the height of that entry when nonempty. -/
inductive BranchOK (a : Nat) : Nat → Forest → Prop
  | mk {k : Nat} {h₀ : Forest} {rest : List (Nat × Forest)} {cs : List Column} :
      (∀ i x y, ((a + k, h₀) :: rest)[i]? = some x → ((a + k, h₀) :: rest)[i + 1]? = some y →
        EntryLe y x) →
      (h₀ ≠ Tree.empty → BranchOK a (k + 1) h₀) →
      BranchOK a k (.node (((a + k, h₀) :: rest) :: cs))

/-- helper: a nonincreasing column starting with `(q, ∅)`: its run of parent `q` has empty
heights, and the entry after the run has a smaller parent. -/
theorem run_split {q : Nat} :
    ∀ (rest : List (Nat × Forest)),
      (∀ i x y, ((q, Tree.empty) :: rest)[i]? = some x → ((q, Tree.empty) :: rest)[i + 1]? = some y →
        EntryLe y x) →
      rest = List.replicate (rest.takeWhile fun x => x.1 == q).length (q, Tree.empty) ++
        rest.dropWhile (fun x => x.1 == q) ∧
      ∀ y ∈ (rest.dropWhile fun x => x.1 == q).head?, y.1 < q
  | [], _ => by simp
  | y :: rest, h => by
    have h0 := h 0 _ _ rfl rfl
    rcases h0 with hlt | ⟨heq, hle⟩
    · have hne : (y.1 == q) = false := by simp; omega
      simp [List.takeWhile_cons, List.dropWhile_cons, hne, hlt]
    · have hy : y.2 = Tree.empty := by
        by_contra hne
        exact absurd hle (not_le.2 (Forest.empty_lt hne))
      obtain ⟨y1, y2⟩ := y
      simp only at heq hy; subst heq hy
      have ih := run_split rest (fun i x z hx hz => h (i + 1) x z hx hz)
      simp only [List.takeWhile_cons, List.dropWhile_cons, beq_self_eq_true, if_true,
        List.length_cons, List.replicate_succ, List.cons_append]
      exact ⟨by rw [← ih.1], ih.2⟩

theorem relLabel_host (a k : Nat) : relLabel a (a + k) = (true, k) := by
  unfold relLabel; rw [if_neg (by omega)]; simp

theorem relKey_node (a : Nat) (cols : List Column) :
    relKey a (.node cols) = .node (Tree.mapCols (relLabel a) cols) := rfl

theorem cmpCol_rep_append {α : Type} (c : α → α → Ordering) [Std.ReflCmp c] (X : α × Tree α) :
    ∀ (m : Nat) (A B : List (α × Tree α)),
      Tree.cmpCol c (List.replicate m X ++ A) (List.replicate m X ++ B) = Tree.cmpCol c A B
  | 0, A, B => rfl
  | m + 1, A, B => by
    obtain ⟨x, h⟩ := X
    simp only [List.replicate_succ, List.cons_append, Tree.cmpCol, Std.ReflCmp.compare_self,
      Tree.cmp_self, Ordering.eq_then]
    exact cmpCol_rep_append c (x, h) m A B

theorem profileAux_branch {a : Nat} : ∀ {k : Nat} {J : Forest}, BranchOK a k J →
    ∃ d m, profileAux k J = toLex (d, m) ∧ 1 ≤ m ∧ k ≤ d := by
  intro k J hb
  induction hb with
  | @mk k h₀ rest cs hH hrec ih =>
    obtain ⟨gs⟩ := h₀
    cases gs with
    | nil => exact ⟨k, 1 + (rest.takeWhile fun x => x.1 == a + k).length, by simp [profileAux],
        by omega, le_refl _⟩
    | cons g gs =>
      obtain ⟨d, m, h1, h2, h3⟩ := ih (by simp [Tree.empty])
      exact ⟨d, m, by simp only [profileAux]; exact h1, h2, by omega⟩

/-- helper: the relabelled first column of a branch level with empty first height. -/
theorem mapCol_run (a k : Nat) (rest : List (Nat × Forest))
    (hH : ∀ i x y, ((a + k, Tree.empty) :: rest)[i]? = some x →
      ((a + k, Tree.empty) :: rest)[i + 1]? = some y → EntryLe y x) :
    ∃ A, Tree.mapCol (relLabel a) ((a + k, (Tree.empty : Forest)) :: rest) =
      List.replicate (1 + (rest.takeWhile fun x => x.1 == a + k).length) ((true, k), Tree.empty) ++ A ∧
      ∀ y ∈ A.head?, keyLabelCmp y.1 (true, k) = .lt := by
  obtain ⟨h1, h2⟩ := run_split rest hH
  refine ⟨Tree.mapCol (relLabel a) (rest.dropWhile fun x => x.1 == a + k), ?_, ?_⟩
  · conv_lhs => rw [h1]
    rw [treeMapCol_eq_map, treeMapCol_eq_map]
    simp only [List.map_cons, List.map_append, List.map_replicate, relLabel_host]
    rw [Nat.add_comm 1, List.replicate_succ]
    simp [Tree.empty, Tree.map, Tree.mapCols]
  · intro y hy
    rw [treeMapCol_eq_map] at hy
    cases hd : (rest.dropWhile fun x => x.1 == a + k) with
    | nil => rw [hd] at hy; simp at hy
    | cons z zs =>
      rw [hd] at hy h2
      simp only [List.map_cons, List.head?_cons, Option.mem_def, Option.some.injEq] at hy
      subst hy
      have := h2 z (by simp)
      rw [← relLabel_host a k, keyLabelCmp_relLabel]
      exact Nat.compare_eq_lt.2 this

theorem relKey_lt_tower {a : Nat} : ∀ {k : Nat} {J : Forest}, BranchOK a k J →
    ∀ {d m : Nat}, profileAux k J = toLex (d, m) →
      keyCmp (relKey a J) (towKeyAt k (d - k) (m + 1)) = .lt := by
  intro k J hb
  induction hb with
  | @mk k h₀ rest cs hH hrec ih =>
    intro d m hp
    obtain ⟨gs⟩ := h₀
    cases gs with
    | nil =>
      simp only [profileAux] at hp
      obtain ⟨hd, hm⟩ := Prod.mk.inj (toLex.injective hp)
      rw [← hd, ← hm]
      obtain ⟨A, hA, hAh⟩ := mapCol_run a k rest hH
      rw [Nat.sub_self, towKeyAt, keyCmp, relKey_node, Tree.mapCols, Tree.cmp]
      rw [Tree.cmpCols]
      simp only [Tree.empty] at hA ⊢
      rw [hA, List.replicate_succ', cmpCol_rep_append]
      cases A with
      | nil => rfl
      | cons y A =>
        obtain ⟨l, h⟩ := y
        simp only [Tree.cmpCol]
        rw [hAh (l, h) rfl]; rfl
    | cons g gs =>
      have hne : Tree.node (g :: gs) ≠ (Tree.empty : Forest) := by simp [Tree.empty]
      have hp' : profileAux (k + 1) (.node (g :: gs)) = toLex (d, m) := by
        simp only [profileAux] at hp; exact hp
      obtain ⟨d', m', h1, -, h3⟩ := profileAux_branch (hrec hne)
      rw [hp'] at h1; obtain ⟨hd, -⟩ := Prod.mk.inj (toLex.injective h1)
      have ih' := ih hne hp'
      rw [show d - k = (d - (k + 1)) + 1 by omega, towKeyAt, keyCmp, relKey_node, Tree.mapCols,
        Tree.cmp, Tree.cmpCols, Tree.mapCol, Tree.cmpCol, relLabel_host]
      rw [keyCmp, relKey_eq_map] at ih'
      simp only [Std.ReflCmp.compare_self, Ordering.eq_then]
      rw [ih']; rfl

theorem ordering_then_ne_gt {a b : Ordering} (ha : a ≠ .gt) (hb : b ≠ .gt) : a.then b ≠ .gt := by
  cases a <;> simp_all [Ordering.then]

theorem cmpCols_nil_ne_gt {α : Type} (c : α → α → Ordering) (l : List (List (α × Tree α))) :
    Tree.cmpCols c [] l ≠ .gt := by cases l <;> simp [Tree.cmpCols]

theorem cmpCol_nil_ne_gt {α : Type} (c : α → α → Ordering) (l : List (α × Tree α)) :
    Tree.cmpCol c [] l ≠ .gt := by cases l <;> simp [Tree.cmpCol]

theorem tower_le_relKey {a : Nat} : ∀ {k : Nat} {J : Forest}, BranchOK a k J →
    ∀ {d m : Nat}, k ≤ d → (toLex (d, m) : Nat ×ₗ Nat) < profileAux k J →
      keyCmp (towKeyAt k (d - k) (m + 1)) (relKey a J) ≠ .gt := by
  intro k J hb
  induction hb with
  | @mk k h₀ rest cs hH hrec ih =>
    intro d m hkd hp
    obtain ⟨gs⟩ := h₀
    cases gs with
    | nil =>
      simp only [profileAux] at hp
      rw [Prod.Lex.toLex_lt_toLex] at hp
      have hd : d = k := by rcases hp with h | ⟨h, -⟩ <;> omega
      have hm : m < 1 + (rest.takeWhile fun x => x.1 == a + k).length := by
        rcases hp with h | ⟨-, h⟩
        · omega
        · exact h
      subst hd
      obtain ⟨A, hA, -⟩ := mapCol_run a d rest hH
      rw [Nat.sub_self, towKeyAt, keyCmp, relKey_node, Tree.mapCols, Tree.cmp, Tree.cmpCols]
      simp only [Tree.empty] at hA ⊢
      rw [hA]
      obtain ⟨r, hr⟩ : ∃ r, 1 + (rest.takeWhile fun x => x.1 == a + d).length = (m + 1) + r :=
        ⟨_, (Nat.add_sub_cancel' hm).symm⟩
      rw [hr, List.replicate_add (m + 1) r, List.append_assoc]
      have := cmpCol_rep_append keyLabelCmp ((true, d), (Tree.node [] : Key)) (m + 1) []
        (List.replicate r ((true, d), Tree.node []) ++ A)
      rw [List.append_nil] at this
      rw [this]
      exact ordering_then_ne_gt (cmpCol_nil_ne_gt _ _) (cmpCols_nil_ne_gt _ _)
    | cons g gs =>
      have hne : Tree.node (g :: gs) ≠ (Tree.empty : Forest) := by simp [Tree.empty]
      have hp' : (toLex (d, m) : Nat ×ₗ Nat) < profileAux (k + 1) (.node (g :: gs)) := by
        simp only [profileAux] at hp; exact hp
      rcases Nat.eq_or_lt_of_le hkd with rfl | hlt
      · rw [Nat.sub_self, towKeyAt, keyCmp, relKey_node, Tree.mapCols, Tree.cmp, Tree.cmpCols,
          List.replicate_succ, Tree.mapCol, Tree.cmpCol, relLabel_host]
        simp only [Std.ReflCmp.compare_self, Ordering.eq_then]
        have : Tree.cmp keyLabelCmp (Tree.empty : Key) (Tree.map (relLabel a) (.node (g :: gs))) = .lt := by
          simp [Tree.empty, Tree.map, Tree.mapCols, Tree.cmp, Tree.cmpCols]
        rw [this]; simp [Ordering.then]
      · have ih' := ih hne (by omega) hp'
        rw [show d - k = (d - (k + 1)) + 1 by omega, towKeyAt, keyCmp, relKey_node, Tree.mapCols,
          Tree.cmp, Tree.cmpCols, Tree.mapCol, Tree.cmpCol, relLabel_host]
        rw [keyCmp, relKey_eq_map] at ih'
        simp only [Std.ReflCmp.compare_self, Ordering.eq_then]
        exact ordering_then_ne_gt (ordering_then_ne_gt ih' (cmpCol_nil_ne_gt _ _))
          (cmpCols_nil_ne_gt _ _)

theorem heightAt_of_entryAt {E : Forest} {e : EntryAddr} {p : Nat} {J : Forest}
    (h : E.entryAt e = some (p, J)) : E.heightAt e = some J := by
  simp [Tree.heightAt, h]

/-- helper: the first column and first entry of the height of `f`. -/
theorem first_of_height {E : Forest} {f : EntryAddr} {cols : List Column} {col0 : Column}
    (hf : E.heightAt f = some (.node cols)) (h0 : cols[0]? = some col0) :
    E.colAt ⟨f.heightPath, 0⟩ = some col0 := by
  simp only [Tree.colAt]
  rw [Tree.forestAt_heightPath, hf]; exact h0

theorem num_heightPath (f : EntryAddr) (j : Nat) :
    ColAddr.num 0 ⟨f.heightPath, j⟩ = f.col.num 0 + 1 + j := by
  simp [ColAddr.num, EntryAddr.heightPath]; omega

theorem branchOK_of_height {E : Forest} (hV : CondV E) (hI : CondI E) (hH : CondH E) (a : Nat) :
    ∀ (J : Forest) (f : EntryAddr) (k : Nat), E.heightAt f = some J → f.col.num 0 = a + k →
      J ≠ Tree.empty → BranchOK a k J
  | .node [], _, _, _, _, hne => absurd rfl hne
  | .node ([] :: cs), f, k, hf, _, hne => by
    exfalso
    obtain ⟨x, hx⟩ : ∃ x, E.entryAt f = some x := by
      simp only [Tree.heightAt, Option.map_eq_some_iff] at hf
      obtain ⟨x, hx, -⟩ := hf; exact ⟨x, hx⟩
    obtain ⟨p, H⟩ := x
    have hHJ : H = .node ([] :: cs) := by
      rw [heightAt_of_entryAt hx] at hf; exact Option.some.inj hf
    subst hHJ
    obtain ⟨q, H', rest, h, -⟩ := hI f ((Tree.mem_entryAddrs_iff E f).2 (by rw [hx]; rfl)) p _ hx hne
      [] (by simp [Tree.cols])
    simp at h
  | .node (((q₀, h₀) :: rest) :: cs), f, k, hf, hn, hne => by
    obtain ⟨x, hx⟩ : ∃ x, E.entryAt f = some x := by
      simp only [Tree.heightAt, Option.map_eq_some_iff] at hf
      obtain ⟨x, hx, -⟩ := hf; exact ⟨x, hx⟩
    obtain ⟨p, H⟩ := x
    have hHJ : H = .node (((q₀, h₀) :: rest) :: cs) := by
      rw [heightAt_of_entryAt hx] at hf; exact Option.some.inj hf
    subst hHJ
    have hfm : f ∈ E.entryAddrs := (Tree.mem_entryAddrs_iff E f).2 (by rw [hx]; rfl)
    obtain ⟨q, H', rest', h, hq⟩ := hI f hfm p _ hx hne ((q₀, h₀) :: rest) (by simp [Tree.cols])
    simp only [List.cons.injEq, Prod.mk.injEq] at h
    obtain ⟨⟨rfl, rfl⟩, rfl⟩ := h
    have hcol := first_of_height (col0 := (q₀, h₀) :: rest) hf (by simp)
    let f₀ : EntryAddr := ⟨⟨f.heightPath, 0⟩, 0⟩
    have he₀ : E.entryAt f₀ = some (q₀, h₀) := by simp [f₀, Tree.entryAt, hcol]
    have hf₀ : f₀ ∈ E.entryAddrs := (Tree.mem_entryAddrs_iff E f₀).2 (by rw [he₀]; rfl)
    have hv := (ColAddr.resolve_isSome_iff 0 f₀.col q₀).1 (hV f₀ hf₀ q₀ h₀ he₀)
    have hnum : f₀.col.num 0 = f.col.num 0 + 1 := by simpa [f₀] using num_heightPath f 0
    have hqa : q₀ = a + k := by omega
    subst hqa
    refine BranchOK.mk ?_ ?_
    · intro i x y hx' hy'
      have hc : f₀.col ∈ E.colAddrs := (Tree.mem_colAddrs_iff E f₀.col).2 (by rw [hcol]; rfl)
      exact hH f₀.col hc i x y (by rw [hcol]; exact hx') (by rw [hcol]; exact hy')
    · intro hne'
      exact branchOK_of_height hV hI hH a h₀ f₀ (k + 1) (heightAt_of_entryAt he₀)
        (by rw [hnum, hn]; omega) hne'

theorem profileAux_of_height {E : Forest} (hI : CondI E) :
    ∀ (J : Forest) (f : EntryAddr) (k : Nat), E.heightAt f = some J → J ≠ Tree.empty →
      ∃ d m, profileAux k J = toLex (d, m) ∧ 1 ≤ m
  | .node [], _, _, _, hne => absurd rfl hne
  | .node ([] :: cs), f, k, hf, hne => by
    exfalso
    obtain ⟨x, hx⟩ : ∃ x, E.entryAt f = some x := by
      simp only [Tree.heightAt, Option.map_eq_some_iff] at hf
      obtain ⟨x, hx, -⟩ := hf; exact ⟨x, hx⟩
    obtain ⟨p, H⟩ := x
    have hHJ : H = .node ([] :: cs) := by
      rw [heightAt_of_entryAt hx] at hf; exact Option.some.inj hf
    subst hHJ
    obtain ⟨q, H', rest, h, -⟩ := hI f ((Tree.mem_entryAddrs_iff E f).2 (by rw [hx]; rfl)) p _ hx hne
      [] (by simp [Tree.cols])
    simp at h
  | .node (((q₀, h₀) :: rest) :: cs), f, k, hf, hne => by
    obtain ⟨gs⟩ := h₀
    cases gs with
    | nil => exact ⟨k, 1 + (rest.takeWhile fun x => x.1 == q₀).length, by simp [profileAux], by omega⟩
    | cons g gs =>
      have hcol := first_of_height (col0 := (q₀, .node (g :: gs)) :: rest) hf (by simp)
      let f₀ : EntryAddr := ⟨⟨f.heightPath, 0⟩, 0⟩
      have he₀ : E.entryAt f₀ = some (q₀, .node (g :: gs)) := by simp [f₀, Tree.entryAt, hcol]
      obtain ⟨d, m, h1, h2⟩ := profileAux_of_height hI (.node (g :: gs)) f₀ (k + 1)
        (heightAt_of_entryAt he₀) (by simp [Tree.empty])
      exact ⟨d, m, by simp only [profileAux]; exact h1, h2⟩

theorem profile_of_ne {J : Forest} (h : J ≠ Tree.empty) :
    profile J = ((profileAux 0 J : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by
  obtain ⟨cols⟩ := J
  cases cols with
  | nil => exact absurd rfl h
  | cons c cs => rfl

-- L3.1b (txt:265-266, G-002: needs V, I, H): the first-entry branch of a nonempty height is a
-- pure tower; `h_a(J)` is strictly below the tower with one more terminal entry
theorem relKey_lt_towKey {E : Forest} (hV : CondV E) (hI : CondI E) (hH : CondH E)
    {e : EntryAddr} {p : Nat} {J : Forest} (he : E.entryAt e = some (p, J)) (hJ : J ≠ Tree.empty)
    {d m : Nat} (hπ : profile J = ((toLex (d, m) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat))) :
    relKey (e.col.num 0) J < towKey d (m + 1) := by
  rw [profile_of_ne hJ, WithBot.coe_inj] at hπ
  have hb := branchOK_of_height hV hI hH (e.col.num 0) J e 0 (heightAt_of_entryAt he) rfl hJ
  have := relKey_lt_tower hb hπ
  rw [Nat.sub_zero] at this
  exact this


-- L3.1b: and above every tower of smaller profile
theorem towKey_le_relKey {E : Forest} (hV : CondV E) (hI : CondI E) (hH : CondH E)
    {e : EntryAddr} {p : Nat} {H : Forest} (he : E.entryAt e = some (p, H)) {d m : Nat}
    (hπ : ((toLex (d, m) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) < profile H) :
    towKey d (m + 1) ≤ relKey (e.col.num 0) H := by
  have hH0 : H ≠ Tree.empty := by
    rintro rfl; exact absurd hπ (by simp [profile, profileBody, Tree.empty])
  rw [profile_of_ne hH0, WithBot.coe_lt_coe] at hπ
  have hb := branchOK_of_height hV hI hH (e.col.num 0) H e 0 (heightAt_of_entryAt he) rfl hH0
  have := tower_le_relKey hb (Nat.zero_le d) hπ
  rw [Nat.sub_zero] at this
  exact this


-- L3.1b: profiles of I-legal nonempty heights are `(d, m)` with `m ≥ 1`
theorem profile_of_entry {E : Forest} (hI : CondI E) {e : EntryAddr} {p : Nat} {J : Forest}
    (he : E.entryAt e = some (p, J)) (hJ : J ≠ Tree.empty) :
    ∃ d m, 1 ≤ m ∧ profile J = ((toLex (d, m) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by
  obtain ⟨d, m, h1, h2⟩ := profileAux_of_height hI J e 0 (heightAt_of_entryAt he) hJ
  exact ⟨d, m, h2, by rw [profile_of_ne hJ, h1]⟩

/-- helper: the height of an entry that contains another entry's column is nonempty. -/
theorem height_ne_of_contains {E : Forest} {e₀ e : EntryAddr} (hc : e₀.heightPath <+: e.col.path)
    (he : (E.entryAt e).isSome) :
    ∃ H, E.heightAt e₀ = some H ∧ H ≠ Tree.empty := by
  obtain ⟨rest, hrest⟩ := hc
  simp only [Tree.entryAt, Option.isSome_iff_exists, Option.bind_eq_some_iff] at he
  obtain ⟨x, col, hcol, -⟩ := he
  simp only [Tree.colAt, Option.bind_eq_some_iff] at hcol
  obtain ⟨G, hG, hGc⟩ := hcol
  rw [← hrest, Tree.forestAt_append, Tree.forestAt_heightPath, Option.bind_eq_some_iff] at hG
  obtain ⟨H, hH, hG⟩ := hG
  refine ⟨H, hH, ?_⟩
  rintro rfl
  cases rest with
  | nil =>
    rw [forestAt_nil_path] at hG; obtain rfl := Option.some.inj hG
    simp [Tree.empty, Tree.cols] at hGc
  | cons x rest => rw [forestAt_empty_node_cons] at hG; simp at hG

-- provides: U2, L3.1a (G-002: `V ∧ I ∧ H ∧ P ⇒ S`). Moved here from `Plan/Spine.lean` (brief rule 5):
-- its proof needs L3.1b; nothing in between uses it.
theorem condS_of_condP {E : Forest} (hV : Scan.CondV E) (hI : Scan.CondI E) (hH : Scan.CondH E)
    (hP : CondP E) : Scan.CondS E := by
  intro e₀ he₀ e he hown
  have hP' := hP e₀ he₀ e he hown
  obtain ⟨hc, q, J, hJ, -⟩ := hown
  obtain ⟨H, hHe, hHne⟩ := height_ne_of_contains hc (by rw [hJ]; rfl)
  obtain ⟨p₀, hp₀⟩ : ∃ p₀, E.entryAt e₀ = some (p₀, H) := by
    simp only [Tree.heightAt, Option.map_eq_some_iff] at hHe
    obtain ⟨⟨p₀, H'⟩, h1, h2⟩ := hHe
    exact ⟨p₀, by simp only at h2; rw [h1, h2]⟩
  rw [hHe, Option.getD_some] at hP' ⊢
  rw [heightAt_of_entryAt hJ, Option.getD_some] at hP' ⊢
  by_cases hJ0 : J = Tree.empty
  · subst hJ0
    obtain ⟨cols⟩ := H
    cases cols with
    | nil => exact absurd rfl hHne
    | cons c cs => rfl
  · obtain ⟨d, m, -, hπ⟩ := profile_of_entry hI hJ hJ0
    rw [hπ] at hP'
    exact lt_of_lt_of_le (relKey_lt_towKey hV hI hH hJ hJ0 hπ) (towKey_le_relKey hV hI hH hp₀ hP')


/-! ### L3.1c helpers: words of literal caps -/

theorem wordLater_append' (e : Nat) (l₁ l₂ : Column) :
    wordLater e (l₁ ++ l₂) = wordLater e l₁ ++ wordLater e l₂ := by
  induction l₁ with
  | nil => rfl
  | cons x l ih => obtain ⟨p, h⟩ := x; simp only [List.cons_append, wordLater, ih, List.append_assoc]

theorem wordCol_append' (e : Nat) {l₁ : Column} (h : l₁ ≠ []) (l₂ : Column) :
    wordCol e (l₁ ++ l₂) = wordCol e l₁ ++ wordLater e l₂ := by
  cases l₁ with
  | nil => exact absurd rfl h
  | cons x l => obtain ⟨p, h⟩ := x; simp only [List.cons_append, wordCol, wordLater_append', List.append_assoc]

theorem wordAt_empty (e : Nat) : wordAt e (Tree.empty : Forest) = [] := by
  simp [Tree.empty, wordAt, wordCols]

/-- helper: the atom of the `k`-th entry with parent `p` of a column at depth `d`. -/
def capAtomAt (d k p : Nat) : WordAtom :=
  if k = 0 then toLex (2 * d, toLex (1, p)) else toLex (2 * d + 1, toLex (0, p))

theorem wordCol_take_snoc (e : Nat) (col : Column) (k p : Nat) (hk : k ≤ col.length) :
    wordCol e (col.take k ++ [(p, Tree.empty)]) =
      (if k = 0 then [] else wordCol e (col.take k)) ++ [capAtomAt e k p] := by
  unfold capAtomAt
  by_cases hk0 : k = 0
  · subst hk0; simp [wordCol, wordAt_empty, wordLater]
  · rw [if_neg hk0, if_neg hk0]
    have hc : col.take k ≠ [] := by
      rw [ne_eq, List.take_eq_nil_iff]; rintro (h | rfl) <;> simp_all
    rw [wordCol_append' e hc]; simp [wordLater, wordAt_empty]

/-- helper: the next atom of `w(E)` after the part kept by a cap at `(col, k)` at depth `d`. -/
def NextAtom (d k : Nat) (col : Column) (R : List WordAtom) : Prop :=
  (∀ q h, col[k]? = some (q, h) → R.head? = some (capAtomAt d k q)) ∧
  (k = col.length → k ≠ 0 → ∀ y ∈ R.head?, (ofLex y).1 ≤ 2 * d) ∧
  (k = col.length → k = 0 → R.head? = some (toLex (2 * d, toLex (0, 0))))

theorem wordCols_cons' (e : Nat) (col : Column) (rest : List Column) :
    wordCols e (col :: rest) = wordCol e col ++ wordCols e rest := rfl

theorem wordCols_split (e : Nat) {cols : List Column} {j : Nat} {col : Column}
    (h : cols[j]? = some col) :
    wordCols e cols = wordCols e (cols.take j) ++ wordCol e col ++ wordCols e (cols.drop (j + 1)) := by
  have hj : j < cols.length := (List.getElem?_eq_some_iff.1 h).1
  conv_lhs => rw [← List.take_append_drop j cols, List.drop_eq_getElem_cons hj]
  rw [wordCols_append, wordCols_cons', (List.getElem?_eq_some_iff.1 h).2, List.append_assoc]

theorem head_wordCols_fst (e : Nat) (cols : List Column) :
    ∀ y ∈ (wordCols e cols).head?, (ofLex y).1 ≤ 2 * e := by
  intro y hy
  cases cols with
  | nil => simp [wordCols] at hy
  | cons col rest =>
    cases col with
    | nil => simp [wordCols, wordCol] at hy; subst hy; simp
    | cons x l => obtain ⟨p, h⟩ := x; simp [wordCols, wordCol] at hy; subst hy; simp

theorem head_wordLater_fst (e : Nat) (l : Column) :
    ∀ y ∈ (wordLater e l).head?, (ofLex y).1 ≤ 2 * e + 1 := by
  intro y hy
  cases l with
  | nil => simp [wordLater] at hy
  | cons x l => obtain ⟨p, h⟩ := x; simp [wordLater] at hy; subst hy; simp

/-- helper (L3.1c): the word of a literal cap is a prefix of the word plus one atom. -/
theorem wordAt_litCapAux (k : Nat) :
    ∀ (ρ : List (Nat × Nat)) (j : Nat) (F : Forest) (col : Column) (e : Nat),
      F.colAt ⟨ρ, j⟩ = some col → k ≤ col.length →
      ∃ P R, wordAt e F = P ++ R ∧
        (∀ p, wordAt e (litCapAux k p ρ j F) = P ++ [capAtomAt (e + ρ.length) k p]) ∧
        NextAtom (e + ρ.length) k col R
  | [], j, .node cols, col, e, hcol, hk => by
    rw [colAt_node_nil] at hcol
    refine ⟨wordCols e (cols.take j) ++ (if k = 0 then [] else wordCol e (col.take k)),
      (if k = 0 then wordCol e col else wordLater e (col.drop k)) ++ wordCols e (cols.drop (j + 1)),
      ?_, ?_, ?_⟩
    · rw [wordAt, wordCols_split e hcol]
      by_cases hk0 : k = 0
      · simp [hk0]
      · rw [if_neg hk0, if_neg hk0]
        have hc : col.take k ≠ [] := by
          rw [ne_eq, List.take_eq_nil_iff]; rintro (h | rfl) <;> simp_all
        conv_lhs => rw [← List.take_append_drop k col, wordCol_append' e hc]
        simp only [List.append_assoc]
    · intro p
      simp only [litCapAux, List.getD_eq_getElem?_getD, hcol, Option.getD_some, wordAt,
        wordCols_append, wordCols_cons', wordCols, List.append_nil, List.length_nil, Nat.add_zero]
      rw [wordCol_take_snoc e col k p hk, List.append_assoc]
    · simp only [List.length_nil, Nat.add_zero]
      refine ⟨fun q h hq => ?_, fun hkl hk0 y hy => ?_, fun hkl hk0 => ?_⟩
      · by_cases hk0 : k = 0
        · subst hk0
          cases col with
          | nil => simp at hq
          | cons x l =>
            simp at hq; subst hq
            simp [wordCol, capAtomAt]
        · rw [if_neg hk0, List.drop_eq_getElem_cons (List.getElem?_eq_some_iff.1 hq).1,
            (List.getElem?_eq_some_iff.1 hq).2]
          simp [wordLater, capAtomAt, hk0]
      · rw [if_neg hk0, hkl, List.drop_length] at hy
        exact head_wordCols_fst e _ y (by simpa [wordLater] using hy)
      · subst hk0
        have : col = [] := List.eq_nil_of_length_eq_zero hkl.symm
        subst this
        simp [wordCol]
  | (ci, ei) :: ρ, j, .node cols, col, e, hcol, hk => by
    rw [colAt_node_cons] at hcol
    obtain ⟨x, hx, hcolx⟩ := Option.bind_eq_some_iff.1 hcol
    obtain ⟨colc, hc, hx'⟩ := Option.bind_eq_some_iff.1 hx
    obtain ⟨q, H⟩ := x
    obtain ⟨P', R', hw, hcap, hnext⟩ := wordAt_litCapAux k ρ j H col (e + 1) hcolx hk
    have hei : ei < colc.length := (List.getElem?_eq_some_iff.1 hx').1
    refine ⟨wordCols e (cols.take ci) ++ wordCol e (colc.take ei ++ [(q, Tree.empty)]) ++ P',
      R' ++ wordLater e (colc.drop (ei + 1)) ++ wordCols e (cols.drop (ci + 1)), ?_, ?_, ?_⟩
    · rw [wordAt, wordCols_split e hc]
      have hne : colc.take ei ++ [(q, H)] ≠ [] := by simp
      have hsplit : colc = (colc.take ei ++ [(q, H)]) ++ colc.drop (ei + 1) := by
        conv_lhs => rw [← List.take_append_drop ei colc, List.drop_eq_getElem_cons hei]
        rw [(List.getElem?_eq_some_iff.1 hx').2]; simp
      conv_lhs => rw [hsplit, wordCol_append' e hne, wordCol_snoc, hw]
      simp only [List.append_assoc]
    · intro p
      simp only [litCapAux, List.getD_eq_getElem?_getD, hc, Option.getD_some, hx', wordAt,
        wordCols_append, wordCols_cons', wordCols, List.append_nil]
      rw [wordCol_snoc, ← wordAt, hcap p]
      simp only [List.append_assoc, List.length_cons]
      rw [show e + (ρ.length + 1) = e + 1 + ρ.length by omega]
    · have he : e + ((ci, ei) :: ρ).length = e + 1 + ρ.length := by simp; omega
      rw [he]
      obtain ⟨h1, h2, h3⟩ := hnext
      refine ⟨fun q' h' hq => ?_, fun hkl hk0 y hy => ?_, fun hkl hk0 => ?_⟩
      · obtain ⟨z, zs, hz⟩ : ∃ z zs, R' = z :: zs := by
          have := h1 q' h' hq; cases R' with
          | nil => simp at this
          | cons z zs => exact ⟨z, zs, rfl⟩
        have := h1 q' h' hq; rw [hz] at this ⊢; simpa using this
      · cases R' with
        | nil =>
          simp only [List.nil_append] at hy
          cases hl : colc.drop (ei + 1) with
          | nil =>
            rw [hl] at hy
            have := head_wordCols_fst e _ y (by simpa [wordLater] using hy); omega
          | cons z zs =>
            rw [hl] at hy
            obtain ⟨pz, hz⟩ := z
            simp only [wordLater, List.cons_append, List.head?_cons, Option.mem_def,
              Option.some.injEq] at hy
            subst hy; simp; omega
        | cons z zs =>
          simp only [List.cons_append, List.head?_cons, Option.mem_def, Option.some.injEq] at hy
          exact h2 hkl hk0 y (by simp [hy])
      · have := h3 hkl hk0
        cases R' with
        | nil => simp at this
        | cons z zs => simpa using this

theorem capAtom_eq (c : ColAddr) (k p : Nat) : capAtom c k p = capAtomAt (colDepth c) k p := rfl

theorem capAtomAt_lt_iff (d k q p : Nat) : capAtomAt d k q < capAtomAt d k p ↔ q < p := by
  unfold capAtomAt; split_ifs <;> simp [Prod.Lex.toLex_lt_toLex]

/-- helper (L3.1c): the word data of a literal cap at a column `col` of `E`. -/
theorem litCap_word_data {E : Forest} {c : ColAddr} {col : Column} (hcol : E.colAt c = some col)
    {k : Nat} (hk : k ≤ col.length) :
    ∃ R, word E = (word E).take (capPos E c k) ++ R ∧
      (∀ p, word (litCap E c k p) = (word E).take (capPos E c k) ++ [capAtom c k p]) ∧
      NextAtom (colDepth c) k col R ∧ capPos E c k ≤ (word E).length := by
  obtain ⟨P, R, hw, hcap, hnext⟩ := wordAt_litCapAux k c.path c.col E col 0 hcol hk
  have hcap' : ∀ p, word (litCap E c k p) = P ++ [capAtom c k p] := by
    intro p; rw [litCap_eq_aux hcol, word, hcap p, capAtom_eq, colDepth, Nat.zero_add]
  have hpos : capPos E c k = P.length := by simp [capPos, hcap' 0]
  have htake : (word E).take (capPos E c k) = P := by
    rw [hpos, word, hw, List.take_left]
  refine ⟨R, ?_, ?_, ?_, ?_⟩
  · rw [htake]; exact hw
  · intro p; rw [htake]; exact hcap' p
  · rw [colDepth]; simpa using hnext
  · rw [hpos, word, hw]; simp

theorem upward_of_nextAtom {d k p : Nat} {col : Column} {R : List WordAtom} (h : NextAtom d k col R)
    (hk : k ≤ col.length) (hup : ∀ q h, col[k]? = some (q, h) → q < p) :
    ∀ y, R.head? = some y → y < capAtomAt d k p := by
  intro y hy
  obtain ⟨h1, h2, h3⟩ := h
  cases hc : col[k]? with
  | some x =>
    obtain ⟨q, H⟩ := x
    rw [h1 q H hc] at hy
    obtain rfl := Option.some.inj hy
    exact (capAtomAt_lt_iff d k q p).2 (hup q H hc)
  | none =>
    have hkl : k = col.length := le_antisymm hk (List.getElem?_eq_none_iff.1 hc)
    by_cases hk0 : k = 0
    · rw [h3 hkl hk0] at hy
      obtain rfl := Option.some.inj hy
      simp [capAtomAt, hk0, Prod.Lex.toLex_lt_toLex]
    · have := h2 hkl hk0 y hy
      unfold capAtomAt; rw [if_neg hk0, Prod.Lex.lt_iff]; left; simp; omega

-- provides: U2, L3.1c (a literal cap is a safe prefix of `w(E)` followed by one atom)
theorem word_litCap {E : Forest} {c : ColAddr} {k : Nat} (hc : c ∈ E.colAddrs)
    (hk : k ≤ ((E.colAt c).getD []).length) (p : Nat) :
    word (litCap E c k p) = (word E).take (capPos E c k) ++ [capAtom c k p] := by
  obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff E c).1 hc)
  rw [hcol, Option.getD_some] at hk
  obtain ⟨R, -, hcap, -⟩ := litCap_word_data hcol hk
  exact hcap p


-- L3.1c: upwardness is "the appended atom beats the next atom of `w(E)`"
theorem isUpward_iff_atom {E : Forest} {c : ColAddr} {k p : Nat} (hc : c ∈ E.colAddrs)
    (hk : k ≤ ((E.colAt c).getD []).length) :
    IsUpward E c k p ↔ ∀ y, (word E)[capPos E c k]? = some y → y < capAtom c k p := by
  obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff E c).1 hc)
  rw [hcol, Option.getD_some] at hk
  obtain ⟨R, hw, -, hnext, hle⟩ := litCap_word_data hcol hk
  have hat : (word E)[capPos E c k]? = R.head? := by
    have hl : ((word E).take (capPos E c k)).length = capPos E c k := List.length_take_of_le hle
    conv_lhs => rw [hw]
    rw [List.getElem?_append_right (by omega), hl, Nat.sub_self, List.head?_eq_getElem?]
  rw [hat, capAtom_eq]
  constructor
  · intro hup
    obtain ⟨col', hcol', -, hq⟩ := isUpward_iff_exists.1 hup
    rw [hcol] at hcol'; obtain rfl := Option.some.inj hcol'
    exact upward_of_nextAtom hnext hk hq
  · intro h
    refine isUpward_iff_exists.2 ⟨col, hcol, hk, fun q H hq => ?_⟩
    have := h _ (hnext.1 q H hq)
    exact (capAtomAt_lt_iff _ _ _ _).1 this


-- L3.1c: an upward cap is strictly larger
theorem lt_litCap {E : Forest} {c : ColAddr} {k p : Nat} (h : IsUpward E c k p) :
    E < litCap E c k p := by
  obtain ⟨col, hcol, hk, hq⟩ := isUpward_iff_exists.1 h
  obtain ⟨R, hw, hcap, hnext, -⟩ := litCap_word_data hcol hk
  rw [← word_lt_iff, hcap p]
  conv_lhs => rw [hw]
  apply List.append_left_lt
  have hat := upward_of_nextAtom hnext hk hq
  cases R with
  | nil => exact List.nil_lt_cons _ _
  | cons y R => exact List.cons_lt_cons_iff.2 (Or.inl (by rw [capAtom_eq]; exact hat y rfl))


/-! ### N2.1 helpers: unique decoding of words -/

mutual
theorem wordAt_fst_ge : ∀ (e : Nat) (F : Forest), ∀ y ∈ wordAt e F, 2 * e ≤ (ofLex y).1
  | e, .node cols => wordCols_fst_ge e cols
theorem wordCols_fst_ge : ∀ (e : Nat) (cols : List Column), ∀ y ∈ wordCols e cols, 2 * e ≤ (ofLex y).1
  | _, [] => by simp [wordCols]
  | e, col :: rest => by
    intro y hy
    rw [wordCols_cons', List.mem_append] at hy
    rcases hy with hy | hy
    · exact wordCol_fst_ge e col y hy
    · exact wordCols_fst_ge e rest y hy
theorem wordCol_fst_ge : ∀ (e : Nat) (col : Column), ∀ y ∈ wordCol e col, 2 * e ≤ (ofLex y).1
  | e, [] => by intro y hy; simp [wordCol] at hy; subst hy; simp
  | e, (p, h) :: rest => by
    intro y hy
    simp only [wordCol, List.mem_cons, List.mem_append] at hy
    rcases hy with rfl | hy | hy
    · simp
    · have := wordAt_fst_ge (e + 1) h y hy; omega
    · have := wordLater_fst_ge e rest y hy; omega
theorem wordLater_fst_ge : ∀ (e : Nat) (col : Column), ∀ y ∈ wordLater e col, 2 * e + 1 ≤ (ofLex y).1
  | _, [] => by simp [wordLater]
  | e, (p, h) :: rest => by
    intro y hy
    simp only [wordLater, List.mem_cons, List.mem_append] at hy
    rcases hy with rfl | hy | hy
    · simp
    · have := wordAt_fst_ge (e + 1) h y hy; omega
    · exact wordLater_fst_ge e rest y hy
end

/-- helper: every head of `X` has depth coordinate `≤ b`. -/
def HeadLe (b : Nat) (X : List WordAtom) : Prop := ∀ y ∈ X.head?, (ofLex y).1 ≤ b

theorem headLe_append_of_ne {b : Nat} {X : List WordAtom} (Y : List WordAtom) (hX : X ≠ [])
    (h : HeadLe b X) : HeadLe b (X ++ Y) := by
  cases X with
  | nil => exact absurd rfl hX
  | cons x X => intro y hy; exact h y (by simpa using hy)

theorem headLe_append {b : Nat} {X Y : List WordAtom} (hX : HeadLe b X) (hY : HeadLe b Y) :
    HeadLe b (X ++ Y) := by
  cases X with
  | nil => simpa using hY
  | cons x X => intro y hy; exact hX y (by simpa using hy)

theorem headLe_mono {a b : Nat} {X : List WordAtom} (h : HeadLe a X) (hab : a ≤ b) : HeadLe b X :=
  fun y hy => le_trans (h y hy) hab

theorem headLe_wordCols (e : Nat) (cols : List Column) : HeadLe (2 * e) (wordCols e cols) :=
  head_wordCols_fst e cols

theorem headLe_wordLater (e : Nat) (l : Column) : HeadLe (2 * e + 1) (wordLater e l) :=
  head_wordLater_fst e l

theorem headLe_wordCol (e : Nat) (col : Column) : HeadLe (2 * e) (wordCol e col) := by
  intro y hy
  cases col with
  | nil => simp [wordCol] at hy; subst hy; simp
  | cons x l => obtain ⟨p, h⟩ := x; simp [wordCol] at hy; subst hy; simp

theorem headLe_cons_iff {b : Nat} {x : WordAtom} {X : List WordAtom} :
    HeadLe b (x :: X) ↔ (ofLex x).1 ≤ b := by simp [HeadLe]

mutual
theorem decode_forest : ∀ (e : Nat) (F₁ F₂ : Forest) (X₁ X₂ : List WordAtom),
    HeadLe (2 * e - 1) X₁ → (X₁ ≠ [] → 0 < e) → HeadLe (2 * e - 1) X₂ → (X₂ ≠ [] → 0 < e) →
    wordAt e F₁ ++ X₁ = wordAt e F₂ ++ X₂ → F₁ = F₂ ∧ X₁ = X₂
  | e, .node l₁, .node l₂, X₁, X₂, h₁, h₁', h₂, h₂', h => by
    obtain ⟨rfl, rfl⟩ := decode_cols e l₁ l₂ X₁ X₂ h₁ h₁' h₂ h₂' h
    exact ⟨rfl, rfl⟩
theorem decode_cols : ∀ (e : Nat) (l₁ l₂ : List Column) (X₁ X₂ : List WordAtom),
    HeadLe (2 * e - 1) X₁ → (X₁ ≠ [] → 0 < e) → HeadLe (2 * e - 1) X₂ → (X₂ ≠ [] → 0 < e) →
    wordCols e l₁ ++ X₁ = wordCols e l₂ ++ X₂ → l₁ = l₂ ∧ X₁ = X₂
  | _, [], [], _, _, _, _, _, _, h => ⟨rfl, by simpa [wordCols] using h⟩
  | e, [], c :: l, X₁, X₂, h₁, h₁', _, _, h => by
    exfalso
    have hne : wordCol e c ≠ [] := by cases c <;> simp [wordCol]
    have hX : X₁ ≠ [] := by
      rintro rfl; simp [wordCols] at h; exact hne h.1
    obtain ⟨x, X, rfl⟩ := List.exists_cons_of_ne_nil hX
    have hl := headLe_wordCol e c
    obtain ⟨y, Y, hy⟩ := List.exists_cons_of_ne_nil hne
    rw [hy] at hl
    simp only [wordCols, List.nil_append, wordCols_cons', hy, List.cons_append, List.cons.injEq] at h
    have h1 := (headLe_cons_iff.1 h₁)
    have h2 : 2 * e ≤ (ofLex y).1 := wordCol_fst_ge e c y (by rw [hy]; simp)
    rw [h.1] at h1; have := h₁' (by simp); omega
  | e, c :: l, [], X₁, X₂, _, _, h₂, h₂', h => by
    exfalso
    have hne : wordCol e c ≠ [] := by cases c <;> simp [wordCol]
    have hX : X₂ ≠ [] := by
      rintro rfl; simp [wordCols] at h; exact hne h.1
    obtain ⟨x, X, rfl⟩ := List.exists_cons_of_ne_nil hX
    obtain ⟨y, Y, hy⟩ := List.exists_cons_of_ne_nil hne
    simp only [wordCols, List.nil_append, wordCols_cons', hy, List.cons_append, List.cons.injEq] at h
    have h1 := (headLe_cons_iff.1 h₂)
    have h2 : 2 * e ≤ (ofLex y).1 := wordCol_fst_ge e c y (by rw [hy]; simp)
    rw [← h.1] at h1; have := h₂' (by simp); omega
  | e, c₁ :: l₁, c₂ :: l₂, X₁, X₂, h₁, h₁', h₂, h₂', h => by
    simp only [wordCols_cons', List.append_assoc] at h
    have hc₁ : HeadLe (2 * e) (wordCols e l₁ ++ X₁) :=
      headLe_append (headLe_wordCols e l₁) (headLe_mono h₁ (by omega))
    have hc₂ : HeadLe (2 * e) (wordCols e l₂ ++ X₂) :=
      headLe_append (headLe_wordCols e l₂) (headLe_mono h₂ (by omega))
    obtain ⟨rfl, h'⟩ := decode_col e c₁ c₂ _ _ hc₁ hc₂ h
    obtain ⟨rfl, rfl⟩ := decode_cols e l₁ l₂ X₁ X₂ h₁ h₁' h₂ h₂' h'
    exact ⟨rfl, rfl⟩
theorem decode_col : ∀ (e : Nat) (c₁ c₂ : Column) (X₁ X₂ : List WordAtom),
    HeadLe (2 * e) X₁ → HeadLe (2 * e) X₂ →
    wordCol e c₁ ++ X₁ = wordCol e c₂ ++ X₂ → c₁ = c₂ ∧ X₁ = X₂
  | _, [], [], _, _, _, _, h => ⟨rfl, by simpa [wordCol] using h⟩
  | e, [], (p, H) :: l, _, _, _, _, h => by simp [wordCol] at h
  | e, (p, H) :: l, [], _, _, _, _, h => by simp [wordCol] at h
  | e, (p₁, H₁) :: l₁, (p₂, H₂) :: l₂, X₁, X₂, h₁, h₂, h => by
    simp only [wordCol, List.cons_append, List.cons.injEq, List.append_assoc] at h
    obtain ⟨hp, h⟩ := h
    have hp' : p₁ = p₂ := by simpa using hp
    subst hp'
    have hc₁ : HeadLe (2 * (e + 1) - 1) (wordLater e l₁ ++ X₁) :=
      headLe_append (headLe_mono (headLe_wordLater e l₁) (by omega)) (headLe_mono h₁ (by omega))
    have hc₂ : HeadLe (2 * (e + 1) - 1) (wordLater e l₂ ++ X₂) :=
      headLe_append (headLe_mono (headLe_wordLater e l₂) (by omega)) (headLe_mono h₂ (by omega))
    obtain ⟨rfl, h'⟩ := decode_forest (e + 1) H₁ H₂ _ _ hc₁ (fun _ => by omega) hc₂ (fun _ => by omega) h
    obtain ⟨rfl, rfl⟩ := decode_later e l₁ l₂ X₁ X₂ h₁ h₂ h'
    exact ⟨rfl, rfl⟩
theorem decode_later : ∀ (e : Nat) (l₁ l₂ : Column) (X₁ X₂ : List WordAtom),
    HeadLe (2 * e) X₁ → HeadLe (2 * e) X₂ →
    wordLater e l₁ ++ X₁ = wordLater e l₂ ++ X₂ → l₁ = l₂ ∧ X₁ = X₂
  | _, [], [], _, _, _, _, h => ⟨rfl, by simpa [wordLater] using h⟩
  | e, [], (p, H) :: l, X₁, _, h₁, _, h => by
    exfalso
    simp only [wordLater, List.nil_append, List.cons_append] at h
    rw [h] at h₁; have := headLe_cons_iff.1 h₁; simp at this
  | e, (p, H) :: l, [], _, X₂, _, h₂, h => by
    exfalso
    simp only [wordLater, List.nil_append, List.cons_append] at h
    rw [← h] at h₂; have := headLe_cons_iff.1 h₂; simp at this
  | e, (p₁, H₁) :: l₁, (p₂, H₂) :: l₂, X₁, X₂, h₁, h₂, h => by
    simp only [wordLater, List.cons_append, List.cons.injEq, List.append_assoc] at h
    obtain ⟨hp, h⟩ := h
    have hp' : p₁ = p₂ := by simpa using hp
    subst hp'
    have hc₁ : HeadLe (2 * (e + 1) - 1) (wordLater e l₁ ++ X₁) :=
      headLe_append (headLe_mono (headLe_wordLater e l₁) (by omega)) (headLe_mono h₁ (by omega))
    have hc₂ : HeadLe (2 * (e + 1) - 1) (wordLater e l₂ ++ X₂) :=
      headLe_append (headLe_mono (headLe_wordLater e l₂) (by omega)) (headLe_mono h₂ (by omega))
    obtain ⟨rfl, h'⟩ := decode_forest (e + 1) H₁ H₂ _ _ hc₁ (fun _ => by omega) hc₂ (fun _ => by omega) h
    obtain ⟨rfl, rfl⟩ := decode_later e l₁ l₂ X₁ X₂ h₁ h₂ h'
    exact ⟨rfl, rfl⟩
end

theorem decode_cols_prefix (e : Nat) : ∀ (xpre ycols : List Column) (T : List WordAtom),
    HeadLe (2 * e) T → wordCols e ycols = wordCols e xpre ++ T →
    ycols.take xpre.length = xpre ∧ wordCols e (ycols.drop xpre.length) = T
  | [], ycols, T, _, h => by simpa [wordCols] using h
  | x :: xs, [], T, _, h => by
    exfalso
    have hne : wordCol e x ≠ [] := by cases x <;> simp [wordCol]
    simp [wordCols] at h; exact hne h.1
  | x :: xs, y :: ys, T, hT, h => by
    simp only [wordCols_cons', List.append_assoc] at h
    obtain ⟨rfl, h'⟩ := decode_col e y x _ _ (headLe_wordCols e ys)
      (headLe_append (headLe_wordCols e xs) hT) h
    obtain ⟨h1, h2⟩ := decode_cols_prefix e xs ys T hT h'
    exact ⟨by simp [h1], by simpa using h2⟩

theorem decode_later_prefix (e : Nat) : ∀ (cr yr : Column) (A S : List WordAtom),
    HeadLe (2 * e) A → HeadLe (2 * e + 1) S → wordLater e yr ++ A = wordLater e cr ++ S →
    yr.take cr.length = cr ∧ wordLater e (yr.drop cr.length) ++ A = S
  | [], yr, A, S, _, _, h => by simpa [wordLater] using h
  | (p₁, H₁) :: cr, [], A, S, hA, _, h => by
    exfalso
    simp only [wordLater, List.nil_append, List.cons_append] at h
    rw [h] at hA; have := headLe_cons_iff.1 hA; simp at this
  | (p₁, H₁) :: cr, (py, Hy) :: yr, A, S, hA, hS, h => by
    simp only [wordLater, List.cons_append, List.cons.injEq, List.append_assoc] at h
    obtain ⟨hp, h⟩ := h
    have hp' : py = p₁ := by simpa using hp
    subst hp'
    have hc₁ : HeadLe (2 * (e + 1) - 1) (wordLater e yr ++ A) :=
      headLe_append (headLe_mono (headLe_wordLater e yr) (by omega)) (headLe_mono hA (by omega))
    have hc₂ : HeadLe (2 * (e + 1) - 1) (wordLater e cr ++ S) :=
      headLe_append (headLe_mono (headLe_wordLater e cr) (by omega)) (headLe_mono hS (by omega))
    obtain ⟨rfl, h'⟩ := decode_forest (e + 1) Hy H₁ _ _ hc₁ (fun _ => by omega) hc₂ (fun _ => by omega) h
    obtain ⟨h1, h2⟩ := decode_later_prefix e cr yr A S hA hS h'
    exact ⟨by simp [h1], by simpa using h2⟩

theorem decode_col_prefix (e : Nat) (cpre yc : Column) (A S : List WordAtom) (hc : cpre ≠ [])
    (hA : HeadLe (2 * e) A) (hS : HeadLe (2 * e + 1) S) (h : wordCol e yc ++ A = wordCol e cpre ++ S) :
    yc.take cpre.length = cpre ∧ wordLater e (yc.drop cpre.length) ++ A = S := by
  obtain ⟨⟨p₀, H₀⟩, cr, rfl⟩ := List.exists_cons_of_ne_nil hc
  cases yc with
  | nil => simp [wordCol] at h
  | cons y yr =>
    obtain ⟨py, Hy⟩ := y
    simp only [wordCol, List.cons_append, List.cons.injEq, List.append_assoc] at h
    obtain ⟨hp, h⟩ := h
    have hp' : py = p₀ := by simpa using hp
    subst hp'
    have hc₁ : HeadLe (2 * (e + 1) - 1) (wordLater e yr ++ A) :=
      headLe_append (headLe_mono (headLe_wordLater e yr) (by omega)) (headLe_mono hA (by omega))
    have hc₂ : HeadLe (2 * (e + 1) - 1) (wordLater e cr ++ S) :=
      headLe_append (headLe_mono (headLe_wordLater e cr) (by omega)) (headLe_mono hS (by omega))
    obtain ⟨rfl, h'⟩ := decode_forest (e + 1) Hy H₀ _ _ hc₁ (fun _ => by omega) hc₂ (fun _ => by omega) h
    obtain ⟨h1, h2⟩ := decode_later_prefix e cr yr A S hA hS h'
    exact ⟨by simp [h1], by simpa using h2⟩

theorem split_of_deep {L C P S : List WordAtom} {b : Nat} (hP : ∀ y ∈ P, b + 1 ≤ (ofLex y).1)
    (hC : HeadLe b C) (h : L ++ C = P ++ S) : ∃ Sin, L = P ++ Sin ∧ S = Sin ++ C := by
  rcases List.append_eq_append_iff.1 h with ⟨a', rfl, hC'⟩ | ⟨c', hL, hS⟩
  · cases a' with
    | nil => exact ⟨[], by simp, by simpa using hC'.symm⟩
    | cons x a' =>
      exfalso
      rw [hC'] at hC
      have h1 := headLe_cons_iff.1 (headLe_append_of_ne S (List.cons_ne_nil x a') hC)
      have h2 := hP x (by simp)
      omega
  · exact ⟨c', hL, hS⟩

theorem getElem?_of_drop_eq_cons {α : Type} {l : List α} {j : Nat} {x : α} {xs : List α}
    (h : l.drop j = x :: xs) : l[j]? = some x := by
  have := congrArg (·[0]?) h
  simpa [List.getElem?_drop] using this

/-- helper (N2.1): a literal cap of `X` whose word prefix is also a prefix of `w(Y)`, followed in
`w(Y)` by a suitable atom, is a literal cap of `Y` with the same internal part. -/
theorem litCap_transfer (k : Nat) :
    ∀ (ρ : List (Nat × Nat)) (j : Nat) (X : Forest) (col : Column) (e : Nat) (P : List WordAtom),
      X.colAt ⟨ρ, j⟩ = some col → k ≤ col.length →
      (∀ p, wordAt e (litCapAux k p ρ j X) = P ++ [capAtomAt (e + ρ.length) k p]) →
      ∀ (Y : Forest) (S : List WordAtom), wordAt e Y = P ++ S →
      (k ≠ 0 → HeadLe (2 * (e + ρ.length) + 1) S) →
      (k = 0 → ∃ y, S.head? = some y ∧ (ofLex y).1 = 2 * (e + ρ.length)) →
      ∃ colY, Y.colAt ⟨ρ, j⟩ = some colY ∧ k ≤ colY.length ∧ colY.take k = col.take k ∧
        ∀ p, wordAt e (litCapAux k p ρ j Y) = P ++ [capAtomAt (e + ρ.length) k p]
  | [], j, .node xcols, col, e, P, hcol, hk, hP, .node ycols, S, hY, hS1, hS0 => by
    rw [colAt_node_nil] at hcol
    have hj : j < xcols.length := (List.getElem?_eq_some_iff.1 hcol).1
    have hPeq : P = wordCols e (xcols.take j) ++ (if k = 0 then [] else wordCol e (col.take k)) := by
      have h0 := hP 0
      simp only [litCapAux, List.getD_eq_getElem?_getD, hcol, Option.getD_some, wordAt,
        wordCols_append, wordCols_cons', wordCols, List.append_nil, List.length_nil, Nat.add_zero] at h0
      rw [wordCol_take_snoc e col k 0 hk, ← List.append_assoc] at h0
      exact (List.append_cancel_right h0).symm
    subst hPeq
    simp only [List.length_nil, Nat.add_zero] at hS1 hS0 ⊢
    have hT : HeadLe (2 * e) ((if k = 0 then [] else wordCol e (col.take k)) ++ S) := by
      by_cases hk0 : k = 0
      · obtain ⟨y, hy, hy'⟩ := hS0 hk0
        rw [if_pos hk0, List.nil_append]; intro y' hy''; rw [hy] at hy''
        cases hy''; omega
      · rw [if_neg hk0]; apply headLe_append_of_ne _ (by cases col.take k <;> simp [wordCol])
        exact headLe_wordCol e _
    have hY' : wordCols e ycols = wordCols e (xcols.take j) ++
        ((if k = 0 then [] else wordCol e (col.take k)) ++ S) := by
      rw [← List.append_assoc]; exact hY
    obtain ⟨h1, h2⟩ := decode_cols_prefix e _ _ _ hT hY'
    rw [List.length_take_of_le hj.le] at h1 h2
    have hTne : (if k = 0 then [] else wordCol e (col.take k)) ++ S ≠ [] := by
      by_cases hk0 : k = 0
      · obtain ⟨y, hy, -⟩ := hS0 hk0; rw [if_pos hk0, List.nil_append]; rintro rfl; simp at hy
      · rw [if_neg hk0]; cases col.take k <;> simp [wordCol]
    cases hd : ycols.drop j with
    | nil => rw [hd] at h2; exact absurd h2.symm (by simpa [wordCols] using hTne)
    | cons yc ys =>
      rw [hd, wordCols_cons'] at h2
      have hyc : ycols[j]? = some yc := getElem?_of_drop_eq_cons hd
      by_cases hk0 : k = 0
      · subst hk0
        refine ⟨yc, by rw [colAt_node_nil]; exact hyc, Nat.zero_le _, by simp, fun p => ?_⟩
        simp only [litCapAux, List.getD_eq_getElem?_getD, hyc, Option.getD_some, wordAt,
          wordCols_append, wordCols_cons', wordCols, List.append_nil, h1]
        rw [wordCol_take_snoc e yc 0 p (Nat.zero_le _)]
        simp
      · rw [if_neg hk0] at h2
        have hne : col.take k ≠ [] := by
          rw [ne_eq, List.take_eq_nil_iff]; rintro (h | rfl) <;> simp_all
        obtain ⟨h3, -⟩ := decode_col_prefix e (col.take k) yc (wordCols e ys) S hne
          (headLe_wordCols e ys) (hS1 hk0) h2
        rw [List.length_take_of_le hk] at h3
        have hkY : k ≤ yc.length := by
          have := congrArg List.length h3; simp at this; omega
        refine ⟨yc, by rw [colAt_node_nil]; exact hyc, hkY, h3, fun p => ?_⟩
        simp only [litCapAux, List.getD_eq_getElem?_getD, hyc, Option.getD_some, wordAt,
          wordCols_append, wordCols_cons', wordCols, List.append_nil, h1]
        rw [wordCol_take_snoc e yc k p hkY, h3, if_neg hk0, List.append_assoc]
  | (ci, ei) :: ρ, j, .node xcols, col, e, P, hcol, hk, hP, .node ycols, S, hY, hS1, hS0 => by
    rw [colAt_node_cons] at hcol
    obtain ⟨x, hx, hcolx⟩ := Option.bind_eq_some_iff.1 hcol
    obtain ⟨colc, hc, hx'⟩ := Option.bind_eq_some_iff.1 hx
    obtain ⟨q, H⟩ := x
    have hci : ci < xcols.length := (List.getElem?_eq_some_iff.1 hc).1
    have hei : ei < colc.length := (List.getElem?_eq_some_iff.1 hx').1
    obtain ⟨P', R', hw', hcap', -⟩ := wordAt_litCapAux k ρ j H col (e + 1) hcolx hk
    have hidx : e + ((ci, ei) :: ρ).length = e + 1 + ρ.length := by simp; omega
    simp only [hidx] at hP hS1 hS0 ⊢
    have hPeq : P = wordCols e (xcols.take ci) ++ wordCol e (colc.take ei ++ [(q, Tree.empty)]) ++ P' := by
      have h0 := hP 0
      simp only [litCapAux, List.getD_eq_getElem?_getD, hc, Option.getD_some, hx', wordAt,
        wordCols_append, wordCols_cons', wordCols, List.append_nil] at h0
      rw [wordCol_snoc, ← wordAt, hcap' 0] at h0
      simp only [← List.append_assoc] at h0
      exact (List.append_cancel_right h0).symm
    subst hPeq
    have hT : HeadLe (2 * e) (wordCol e (colc.take ei ++ [(q, Tree.empty)]) ++ P' ++ S) := by
      rw [List.append_assoc]
      exact headLe_append_of_ne _ (by cases (colc.take ei ++ [(q, Tree.empty)]) <;> simp [wordCol])
        (headLe_wordCol e _)
    have hY' : wordCols e ycols = wordCols e (xcols.take ci) ++
        (wordCol e (colc.take ei ++ [(q, Tree.empty)]) ++ P' ++ S) := by
      simp only [← List.append_assoc]; exact hY
    obtain ⟨h1, h2⟩ := decode_cols_prefix e _ _ _ hT hY'
    rw [List.length_take_of_le hci.le] at h1 h2
    cases hd : ycols.drop ci with
    | nil =>
      rw [hd] at h2
      exfalso
      have hne : wordCol e (colc.take ei ++ [(q, Tree.empty)]) ≠ [] := by
        cases (colc.take ei ++ [(q, Tree.empty)]) <;> simp [wordCol]
      simp only [wordCols] at h2
      exact hne (List.append_eq_nil_iff.1 (List.append_eq_nil_iff.1 h2.symm).1).1
    | cons yc ys =>
      rw [hd, wordCols_cons'] at h2
      have hyc : ycols[ci]? = some yc := getElem?_of_drop_eq_cons hd
      -- decode the containing column up to the containing entry
      obtain ⟨Hy, yr, hyc_eq, hrest⟩ : ∃ Hy yr, yc = colc.take ei ++ (q, Hy) :: yr ∧
          wordAt (e + 1) Hy ++ (wordLater e yr ++ wordCols e ys) = P' ++ S := by
        by_cases hei0 : ei = 0
        · subst hei0
          cases yc with
          | nil => simp [wordCol, wordAt_empty, wordLater] at h2
          | cons y yr =>
            obtain ⟨q', Hy⟩ := y
            simp only [List.take_zero, List.nil_append, wordCol, wordAt_empty, wordLater,
              List.append_nil, List.cons_append, List.singleton_append, List.cons.injEq,
              List.append_assoc] at h2
            obtain ⟨hq, h2⟩ := h2
            have : q' = q := by simpa using hq
            subst this
            exact ⟨Hy, yr, by simp, h2⟩
        · rw [wordCol_take_snoc e colc ei q hei.le, if_neg hei0] at h2
          have hne : colc.take ei ≠ [] := by
            rw [ne_eq, List.take_eq_nil_iff]; rintro (h | h) <;> simp_all
          have hS' : HeadLe (2 * e + 1) ([capAtomAt e ei q] ++ P' ++ S) := by
            intro y hy; simp [capAtomAt, hei0] at hy; subst hy; simp
          simp only [List.append_assoc] at h2 hS'
          obtain ⟨h3, h4⟩ := decode_col_prefix e (colc.take ei) yc (wordCols e ys) _ hne
            (headLe_wordCols e ys) hS' h2
          rw [List.length_take_of_le hei.le] at h3 h4
          cases hdy : yc.drop ei with
          | nil =>
            exfalso
            rw [hdy] at h4
            have := headLe_wordCols e ys
            rw [show wordLater e [] = [] from rfl, List.nil_append] at h4
            rw [h4] at this
            have := headLe_cons_iff.1 this; simp [capAtomAt, hei0] at this
          | cons y yr =>
            obtain ⟨q', Hy⟩ := y
            rw [hdy] at h4
            simp only [wordLater, List.cons_append, List.singleton_append, List.cons.injEq,
              List.append_assoc, capAtomAt, if_neg hei0] at h4
            obtain ⟨hq, h4⟩ := h4
            have : q' = q := by simpa using hq
            subst this
            refine ⟨Hy, yr, ?_, h4⟩
            rw [← List.take_append_drop ei yc, h3, hdy]
      -- the containing entry's height starts with the inner cap prefix
      have hdeep : ∀ y ∈ P', 2 * e + 1 + 1 ≤ (ofLex y).1 := by
        intro y hy
        have := wordAt_fst_ge (e + 1) (litCapAux k 0 ρ j H) y (by rw [hcap' 0]; simp [hy])
        omega
      have hC : HeadLe (2 * e + 1) (wordLater e yr ++ wordCols e ys) :=
        headLe_append (headLe_wordLater e yr) (headLe_mono (headLe_wordCols e ys) (by omega))
      obtain ⟨Sin, hHy, hS⟩ := split_of_deep hdeep hC hrest
      have hS1' : k ≠ 0 → HeadLe (2 * (e + 1 + ρ.length) + 1) Sin := by
        intro hk0 y hy
        cases Sin with
        | nil => simp at hy
        | cons z Sin => exact hS1 hk0 y (by rw [hS]; simpa using hy)
      have hS0' : k = 0 → ∃ y, Sin.head? = some y ∧ (ofLex y).1 = 2 * (e + 1 + ρ.length) := by
        intro hk0
        obtain ⟨y, hy, hy'⟩ := hS0 hk0
        cases Sin with
        | nil =>
          exfalso
          rw [hS, List.nil_append] at hy
          have := hC y (by rw [hy]; rfl)
          omega
        | cons z Sin => exact ⟨y, by rw [hS] at hy; simpa using hy, hy'⟩
      obtain ⟨colY, hcolY, hkY, htake, hcapY⟩ :=
        litCap_transfer k ρ j H col (e + 1) P' hcolx hk hcap' Hy Sin hHy hS1' hS0'
      have hyx : yc[ei]? = some (q, Hy) := by
        rw [hyc_eq, List.getElem?_append_right (by simp)]
        simp [List.length_take_of_le hei.le]
      refine ⟨colY, ?_, hkY, htake, fun p => ?_⟩
      · rw [colAt_node_cons, hyc]; simp only [Option.bind_some, hyx]; exact hcolY
      · have hyt : yc.take ei = colc.take ei := by
          rw [hyc_eq, List.take_left' (by simp; omega)]
        simp only [litCapAux, List.getD_eq_getElem?_getD, hyc, Option.getD_some, hyx, wordAt,
          wordCols_append, wordCols_cons', wordCols, List.append_nil, h1, hyt]
        rw [wordCol_snoc, ← wordAt, hcapY p]
        simp only [List.append_assoc]

theorem litCapAux_route (Q : Column) (r j : Nat) :
    ∀ (ρ : List (Nat × Nat)) (F : Forest),
      (∀ d < ρ.length, ∃ G, F.forestAt (ρ.take d) = some G ∧ G.lastStep? = ρ[d]?) →
      (∃ G, F.forestAt ρ = some G ∧ G.cols.length = j + 1) →
      F.colAt ⟨ρ, j⟩ = some (Q ++ [(r, Tree.empty)]) → litCapAux Q.length r ρ j F = F
  | [], .node cols, _, hG, hcol => by
    obtain ⟨G, hG, hl⟩ := hG
    rw [forestAt_nil_path] at hG; obtain rfl := Option.some.inj hG
    rw [colAt_node_nil] at hcol
    simp only [Tree.cols] at hl
    simp only [litCapAux, List.getD_eq_getElem?_getD, hcol, Option.getD_some, List.take_left]
    congr 1
    conv_rhs => rw [← List.take_append_drop j cols, List.drop_eq_getElem_cons (by omega),
      (List.getElem?_eq_some_iff.1 hcol).2]
    rw [List.drop_eq_nil_of_le (by omega)]
  | (ci, ei) :: ρ, .node cols, hroute, hG, hcol => by
    obtain ⟨G0, hG0, hls⟩ := hroute 0 (by simp)
    simp only [List.take_zero, forestAt_nil_path, Option.some.injEq] at hG0
    subst hG0
    simp only [Tree.lastStep?, Tree.cols, List.getElem?_cons_zero] at hls
    obtain ⟨colL, hL, hls⟩ := Option.bind_eq_some_iff.1 hls
    split_ifs at hls with hne
    obtain ⟨rfl, rfl⟩ := Prod.mk.inj (Option.some.inj hls)
    have hcolsne : cols ≠ [] := by rintro rfl; simp at hL
    have hLi : cols[cols.length - 1]? = some colL := by rw [← List.getLast?_eq_getElem?]; exact hL
    have hLne : colL ≠ [] := by simpa using hne
    rw [colAt_node_cons, hLi] at hcol
    simp only [Option.bind_some] at hcol
    obtain ⟨x, hx, hcolx⟩ := Option.bind_eq_some_iff.1 hcol
    obtain ⟨q, H⟩ := x
    have ih := litCapAux_route Q r j ρ H (fun d hd => by
        obtain ⟨G, hG, hl⟩ := hroute (d + 1) (by simp; omega)
        refine ⟨G, ?_, by simpa using hl⟩
        rw [List.take_succ_cons, forestAt_node_cons, hLi] at hG
        simpa [hx] using hG)
      (by
        obtain ⟨G, hG, hl⟩ := hG
        rw [forestAt_node_cons, hLi] at hG
        exact ⟨G, by simpa [hx] using hG, hl⟩) hcolx
    simp only [litCapAux, List.getD_eq_getElem?_getD, hLi, Option.getD_some, hx, ih]
    congr 1
    have hc1 : cols = cols.take (cols.length - 1) ++ [colL] := by
      conv_lhs => rw [← List.take_append_drop (cols.length - 1) cols,
        List.drop_eq_getElem_cons (by have := List.length_pos_of_ne_nil hcolsne; omega),
        (List.getElem?_eq_some_iff.1 hLi).2]
      rw [List.drop_eq_nil_of_le (by omega)]
    have hc2 : colL = colL.take (colL.length - 1) ++ [(q, H)] := by
      conv_lhs => rw [← List.take_append_drop (colL.length - 1) colL,
        List.drop_eq_getElem_cons (by have := List.length_pos_of_ne_nil hLne; omega),
        (List.getElem?_eq_some_iff.1 hx).2]
      rw [List.drop_eq_nil_of_le (by omega)]
    rw [← hc2, ← hc1]

/-- helper: a forest whose last route column ends with `(r, ∅)` is its own literal cap there. -/
theorem litCap_of_lastRoute {E : Forest} {c : ColAddr} {Q : Column} {r : Nat}
    (hc : (routeCols E).getLast? = some c) (hcol : E.colAt c = some (Q ++ [(r, Tree.empty)])) :
    litCap E c Q.length r = E := by
  rw [litCap_eq_aux hcol]
  have hmem : c ∈ routeCols E := List.mem_of_getLast? hc
  obtain ⟨hroute, G, hG, hl⟩ := (mem_routeCols_iff E c).1 hmem
  exact litCapAux_route Q r c.col c.path E hroute ⟨G, hG, hl⟩ hcol

-- N2.1 (converse of L3.1c): a prefix of `w(B)` followed by a valid closing atom is a literal
-- cap of `B`, provided the next atom of `B` is smaller (and, for a column-start atom, not
-- shallower than the new column)
theorem exists_litCap_of_word {B E : Forest} {π e p : Nat} {first : Bool}
    (hw : word E = (word B).take π ++
      [if first then toLex (2 * e, toLex (1, p)) else toLex (2 * e + 1, toLex (0, p))])
    (hπ : π ≤ mu B)
    (hnext : ∀ y, (word B)[π]? = some y →
      y < (if first then toLex (2 * e, toLex (1, p)) else toLex (2 * e + 1, toLex (0, p))))
    (hfirst : first = true → ∃ y, (word B)[π]? = some y ∧ 2 * e ≤ (ofLex y).1) :
    ∃ c k, c ∈ B.colAddrs ∧ k ≤ ((B.colAt c).getD []).length ∧ colDepth c = e ∧
      (k = 0 ↔ first = true) ∧ capPos B c k = π ∧ IsUpward B c k p ∧ litCap B c k p = E := by
  have hG : word (safePrefix B π) = (word B).take π := word_safePrefix B π
  obtain ⟨c, k, hce, hkf, hlast, hentry, hlen, -, -, -⟩ :=
    routeCols_of_word_snoc (G := safePrefix B π) (E := E) (e := e) (p := p) (first := first)
      (by rw [hG]; exact hw)
  obtain ⟨col, hcol, hck⟩ := Tree.colAt_of_entryAt hentry
  rw [hcol, Option.getD_some] at hlen
  have hcol' : E.colAt c = some (col.take k ++ [(p, Tree.empty)]) := by
    rw [hcol]; congr 1
    conv_lhs => rw [← List.take_append_drop k col, List.drop_eq_getElem_cons (by omega),
      (List.getElem?_eq_some_iff.1 hck).2]
    rw [List.drop_eq_nil_of_le (by omega)]
  have hkk : (col.take k).length = k := List.length_take_of_le (by omega)
  have hEcap : litCap E c k p = E := by
    have := litCap_of_lastRoute hlast hcol'; rwa [hkk] at this
  have hz : capAtom c k p =
      (if first then toLex (2 * e, toLex (1, p)) else toLex (2 * e + 1, toLex (0, p))) := by
    unfold capAtom colDepth; rw [hce]
    cases first <;> simp_all
  obtain ⟨-, -, hcapE, -, -⟩ := litCap_word_data hcol (k := k) (by omega)
  have hPE : (word E).take (capPos E c k) = (word B).take π := by
    have h1 := hcapE p
    rw [hEcap, hz] at h1
    exact List.append_cancel_right (h1.symm.trans hw)
  have hS1 : k ≠ 0 → HeadLe (2 * (0 + c.path.length) + 1) ((word B).drop π) := by
    intro hk0 y hy
    have hf : first = false := by cases first <;> simp_all
    have := hnext y (by rw [List.head?_drop] at hy; exact hy)
    rw [hf, if_neg (by simp), Prod.Lex.lt_iff] at this
    rw [hce]; simp at this ⊢
    rcases this with h | ⟨h, -⟩ <;> omega
  have hS0 : k = 0 → ∃ y, ((word B).drop π).head? = some y ∧
      (ofLex y).1 = 2 * (0 + c.path.length) := by
    intro hk0
    have hf : first = true := hkf.1 hk0
    obtain ⟨y, hy, hy'⟩ := hfirst hf
    refine ⟨y, by rw [List.head?_drop]; exact hy, ?_⟩
    have := hnext y hy
    rw [hf, if_pos rfl, Prod.Lex.lt_iff] at this
    rw [hce]; simp at this ⊢
    rcases this with h | ⟨h, -⟩ <;> omega
  obtain ⟨colY, hcolY, hkY, -, hcapB⟩ := litCap_transfer k c.path c.col E col 0 ((word B).take π)
    hcol (by omega) (fun p' => by
      have := hcapE p'
      rw [litCap_eq_aux hcol, word, hPE, capAtom_eq, colDepth] at this
      simpa using this)
    B ((word B).drop π) (by rw [← word, List.take_append_drop]) hS1 hS0
  have hcapB' : ∀ p', word (litCap B c k p') = (word B).take π ++ [capAtom c k p'] := by
    intro p'; rw [litCap_eq_aux hcolY, word, hcapB p', capAtom_eq, colDepth]; simp
  have hpos : capPos B c k = π := by
    simp only [capPos, hcapB' 0, List.length_append, List.length_take, List.length_singleton]
    unfold mu at hπ; omega
  refine ⟨c, k, (Tree.mem_colAddrs_iff B c).2 (by rw [hcolY]; rfl), by rw [hcolY]; exact hkY,
    by rw [colDepth, hce], hkf, hpos, ?_, ?_⟩
  · rw [isUpward_iff_atom ((Tree.mem_colAddrs_iff B c).2 (by rw [hcolY]; rfl))
      (by rw [hcolY]; exact hkY), hpos, hz]
    exact hnext
  · apply word_injective
    rw [hcapB' p, hw, hz]


/-! ### L3.1d helpers -/

theorem cmpCol_append_same {α : Type} (c : α → α → Ordering) [Std.ReflCmp c] :
    ∀ (P A B : List (α × Tree α)), Tree.cmpCol c (P ++ A) (P ++ B) = Tree.cmpCol c A B
  | [], A, B => rfl
  | (x, h) :: P, A, B => by
    simp only [List.cons_append, Tree.cmpCol, Std.ReflCmp.compare_self, Tree.cmp_self,
      Ordering.eq_then]
    exact cmpCol_append_same c P A B

/-- helper: a branch level with empty first height is `m` copies of `(a+k, ∅)` then a part
whose first parent is smaller. -/
theorem run_split' {a k : Nat} {rest : List (Nat × Forest)}
    (hH : ∀ i x y, ((a + k, Tree.empty) :: rest)[i]? = some x →
      ((a + k, Tree.empty) :: rest)[i + 1]? = some y → EntryLe y x) :
    ∃ after, (a + k, (Tree.empty : Forest)) :: rest =
        List.replicate (1 + (rest.takeWhile fun x => x.1 == a + k).length) (a + k, Tree.empty) ++ after ∧
      ∀ y ∈ after.head?, y.1 < a + k := by
  obtain ⟨h1, h2⟩ := run_split rest hH
  refine ⟨_, ?_, h2⟩
  conv_lhs => rw [h1]
  rw [Nat.add_comm 1, List.replicate_succ]; rfl

/-- helper: the relabelled form of `rep m (a+k, ∅) ++ W` against the level-`k` tower column. -/
theorem cmpCol_run_lt (a k m : Nat) (W : List (Nat × Forest))
    (hW : ∀ y ∈ W.head?, y.1 < a + k) :
    Tree.cmpCol keyLabelCmp (Tree.mapCol (relLabel a) (List.replicate m (a + k, Tree.empty) ++ W))
      (List.replicate (m + 1) ((true, k), (Tree.empty : Key))) = .lt := by
  rw [treeMapCol_eq_map, List.map_append, List.map_replicate, List.replicate_succ']
  have hX : ((relLabel a (a + k, (Tree.empty : Forest)).1, Tree.map (relLabel a) (a + k, (Tree.empty : Forest)).2) :
      (Bool × Nat) × Key) = ((true, k), (Tree.empty : Key)) := by
    simp [relLabel_host, Tree.empty, Tree.map, Tree.mapCols]
  rw [hX, cmpCol_append_same]
  cases W with
  | nil => rfl
  | cons y W =>
    obtain ⟨q, h⟩ := y
    have := hW (q, h) rfl
    simp only [List.map_cons, Tree.cmpCol]
    rw [← relLabel_host a k, keyLabelCmp_relLabel, Nat.compare_eq_lt.2 this]; rfl

theorem litCapAux_nil (k p j : Nat) (cols : List Column) :
    litCapAux k p [] j (.node cols) = .node (cols.take j ++ [(cols.getD j []).take k ++ [(p, Tree.empty)]]) :=
  rfl

theorem litCapAux_cons (k p ci ei j : Nat) (ρ : List (Nat × Nat)) (cols : List Column) {q : Nat}
    {H : Forest} (h : (cols.getD ci [])[ei]? = some (q, H)) :
    litCapAux k p ((ci, ei) :: ρ) j (.node cols) =
      .node (cols.take ci ++ [(cols.getD ci []).take ei ++ [(q, litCapAux k p ρ j H)]]) := by
  show (match (cols.getD ci [])[ei]? with
    | some (q, h) => Tree.node (cols.take ci ++ [(cols.getD ci []).take ei ++ [(q, litCapAux k p ρ j h)]])
    | none => Tree.node cols) = _
  rw [h]

/-- helper: a capped tower level that keeps a complete nonempty first entry is strictly below. -/
theorem keep_first_lt {a kk : Nat} {h₀ : Forest} {T : Key} (hlt : keyCmp (relKey a h₀) T = .lt)
    (R : List (Nat × Forest)) (cs : List Column) :
    keyCmp (relKey a (.node (((a + kk, h₀) :: R) :: cs))) (.node [[((true, kk), T)]]) = .lt := by
  rw [keyCmp, relKey_node, Tree.mapCols, Tree.cmp, Tree.cmpCols, Tree.mapCol, Tree.cmpCol,
    relLabel_host]
  rw [keyCmp, relKey_eq_map] at hlt
  simp only [Std.ReflCmp.compare_self, Ordering.eq_then]
  rw [hlt]; rfl

theorem keep_run_lt {a kk m : Nat} (W : List (Nat × Forest)) (hW : ∀ y ∈ W.head?, y.1 < a + kk)
    (cs : List Column) :
    keyCmp (relKey a (.node ((List.replicate m (a + kk, Tree.empty) ++ W) :: cs)))
      (.node [List.replicate (m + 1) ((true, kk), Tree.empty)]) = .lt := by
  rw [keyCmp, relKey_node, Tree.mapCols, Tree.cmp, Tree.cmpCols, cmpCol_run_lt a kk m W hW]; rfl

theorem colAt_empty_none (ρ : List (Nat × Nat)) (j : Nat) : (Tree.empty : Forest).colAt ⟨ρ, j⟩ = none := by
  cases ρ with
  | nil => rfl
  | cons x ρ => simp [Tree.colAt, forestAt_empty_node_cons]

theorem capKey_le_tower {a k p : Nat} : ∀ {kk : Nat} {J : Forest}, BranchOK a kk J →
    ∀ (ρ : List (Nat × Nat)) (j : Nat) (col : Column) {d m : Nat},
      J.colAt ⟨ρ, j⟩ = some col → k ≤ col.length → (∀ q h, col[k]? = some (q, h) → q < p) →
      p < a + kk + 1 + ((ρ.map (·.1 + 1)).sum + j) → profileAux kk J = toLex (d, m) →
      keyCmp (relKey a (litCapAux k p ρ j J)) (towKeyAt kk (d - kk) (m + 1)) ≠ .gt := by
  intro kk J hb
  induction hb with
  | @mk kk h₀ rest cs hH hrec ih =>
    intro ρ j col d m hcol hk hup hV hp
    obtain ⟨gs⟩ := h₀
    cases gs with
    | cons g gs =>
      have hne : Tree.node (g :: gs) ≠ (Tree.empty : Forest) := by simp [Tree.empty]
      have hp' : profileAux (kk + 1) (.node (g :: gs)) = toLex (d, m) := by
        simp only [profileAux] at hp; exact hp
      obtain ⟨d', m', h1, -, h3⟩ := profileAux_branch (hrec hne)
      rw [hp'] at h1; obtain ⟨hd, -⟩ := Prod.mk.inj (toLex.injective h1)
      have hlt := relKey_lt_tower (hrec hne) hp'
      rw [show d - kk = (d - (kk + 1)) + 1 by omega, towKeyAt]
      cases ρ with
      | nil =>
        rw [colAt_node_nil] at hcol
        rw [litCapAux_nil]
        cases j with
        | zero =>
          simp only [List.getElem?_cons_zero, Option.some.injEq] at hcol
          subst hcol
          cases k with
          | zero =>
            exfalso; have := hup _ _ rfl; simp at hV; omega
          | succ k =>
            simp only [List.take_zero, List.nil_append, List.getD_cons_zero, List.take_succ_cons,
              List.cons_append]
            rw [keep_first_lt hlt]; simp
        | succ j =>
          simp only [List.take_succ_cons, List.cons_append]
          rw [keep_first_lt hlt]; simp
      | cons ce ρ =>
        obtain ⟨ci, ei⟩ := ce
        rw [colAt_node_cons] at hcol
        obtain ⟨x, hx, hcolx⟩ := Option.bind_eq_some_iff.1 hcol
        obtain ⟨colc, hc, hx'⟩ := Option.bind_eq_some_iff.1 hx
        obtain ⟨q', H'⟩ := x
        have hget : ((((a + kk, Tree.node (g :: gs)) :: rest) :: cs).getD ci [])[ei]? = some (q', H') := by
          rw [List.getD_eq_getElem?_getD, hc, Option.getD_some]; exact hx'
        rw [litCapAux_cons k p ci ei j ρ _ hget]
        cases ci with
        | succ ci =>
          simp only [List.take_succ_cons, List.cons_append]
          rw [keep_first_lt hlt]; simp
        | zero =>
          simp only [List.getElem?_cons_zero, Option.some.injEq] at hc
          subst hc
          cases ei with
          | succ ei =>
            simp only [List.take_zero, List.nil_append, List.getD_cons_zero, List.take_succ_cons,
              List.cons_append]
            rw [keep_first_lt hlt]; simp
          | zero =>
            simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hx'
            obtain ⟨rfl, rfl⟩ := hx'
            have hih := ih hne ρ j col hcolx hk hup (by simp at hV ⊢; omega) hp'
            simp only [List.take_zero, List.nil_append, List.getD_cons_zero]
            rw [keyCmp, relKey_node, Tree.mapCols, Tree.cmp, Tree.cmpCols, Tree.mapCol, Tree.cmpCol,
              relLabel_host]
            rw [keyCmp, relKey_eq_map] at hih
            simp only [Std.ReflCmp.compare_self, Ordering.eq_then]
            exact ordering_then_ne_gt (ordering_then_ne_gt hih (by simp [Tree.mapCol, Tree.cmpCol]))
              (by simp [Tree.mapCols, Tree.cmpCols])
    | nil =>
      simp only [profileAux] at hp
      obtain ⟨hd, hm⟩ := Prod.mk.inj (toLex.injective hp)
      rw [← hd, Nat.sub_self, towKeyAt]
      obtain ⟨after, hsplit, hafter⟩ := run_split' (a := a) (k := kk) (rest := rest) hH
      rw [hm] at hsplit
      have hsplit' : (a + kk, (Tree.node [] : Forest)) :: rest =
          List.replicate m (a + kk, Tree.empty) ++ after := hsplit
      have hlenc : ((a + kk, (Tree.node [] : Forest)) :: rest).length = m + after.length := by
        rw [hsplit']; simp
      have hrun : ∀ i < m, ((a + kk, (Tree.node [] : Forest)) :: rest)[i]? = some (a + kk, Tree.empty) := by
        intro i hi; rw [hsplit', List.getElem?_append_left (by simp; omega)]; simp [hi]
      have hlate : ∀ i, ((a + kk, (Tree.node [] : Forest)) :: rest)[m + i]? = after[i]? := by
        intro i; rw [hsplit', List.getElem?_append_right (by simp)]; simp
      have htake : ∀ t, m ≤ t → ((a + kk, (Tree.node [] : Forest)) :: rest).take t =
          List.replicate m (a + kk, Tree.empty) ++ after.take (t - m) := by
        intro t ht; rw [hsplit', List.take_append, List.take_of_length_le (by simp; omega)]
        simp
      cases ρ with
      | nil =>
        rw [colAt_node_nil] at hcol
        rw [litCapAux_nil]
        cases j with
        | zero =>
          simp only [List.getElem?_cons_zero, Option.some.injEq] at hcol
          subst hcol
          simp only [List.take_zero, List.nil_append, List.getD_cons_zero]
          simp only [List.map_nil, List.sum_nil, Nat.add_zero] at hV
          rcases lt_trichotomy k m with hkm | rfl | hkm
          · exfalso; have := hup _ _ (hrun k hkm); omega
          · rw [htake k le_rfl, Nat.sub_self, List.take_zero, List.append_nil]
            rw [keyCmp, relKey_node, Tree.mapCols, Tree.cmp, Tree.cmpCols, treeMapCol_eq_map,
              List.map_append, List.map_replicate, List.replicate_succ']
            have hX : ((relLabel a (a + kk, (Tree.empty : Forest)).1,
                Tree.map (relLabel a) (a + kk, (Tree.empty : Forest)).2) : (Bool × Nat) × Key) =
                ((true, kk), (Tree.empty : Key)) := by
              simp [relLabel_host, Tree.empty, Tree.map, Tree.mapCols]
            rw [hX, cmpCol_append_same]
            simp only [List.map_cons, List.map_nil, Tree.cmpCol, Tree.mapCols, Tree.cmpCols]
            rw [← relLabel_host a kk, keyLabelCmp_relLabel]
            have : Tree.cmp keyLabelCmp (Tree.map (relLabel a) (Tree.empty : Forest)) (Tree.empty : Key) = .eq := by
              simp [Tree.empty, Tree.map, Tree.mapCols, Tree.cmp, Tree.cmpCols]
            rw [this]
            rcases Nat.lt_or_eq_of_le (Nat.lt_succ_iff.1 hV) with h | h
            · rw [Nat.compare_eq_lt.2 h]; simp
            · rw [h, Nat.compare_eq_eq.2 rfl]; simp
          · have hne : after ≠ [] := by
              rintro rfl; simp at hlenc hk; omega
            obtain ⟨z, after', rfl⟩ := List.exists_cons_of_ne_nil hne
            rw [htake k hkm.le, List.append_assoc]
            rw [show k - m = (k - m - 1) + 1 by omega, List.take_succ_cons, keep_run_lt]
            · simp
            · intro y hy; simp at hy; subst hy; exact hafter z (by simp)
        | succ j =>
          simp only [List.take_succ_cons, List.cons_append]
          rw [hsplit', keep_run_lt after hafter]; simp
      | cons ce ρ =>
        obtain ⟨ci, ei⟩ := ce
        rw [colAt_node_cons] at hcol
        obtain ⟨x, hx, hcolx⟩ := Option.bind_eq_some_iff.1 hcol
        obtain ⟨colc, hc, hx'⟩ := Option.bind_eq_some_iff.1 hx
        obtain ⟨q', H'⟩ := x
        have hget : ((((a + kk, Tree.node []) :: rest) :: cs).getD ci [])[ei]? = some (q', H') := by
          rw [List.getD_eq_getElem?_getD, hc, Option.getD_some]; exact hx'
        rw [litCapAux_cons k p ci ei j ρ _ hget]
        cases ci with
        | succ ci =>
          simp only [List.take_succ_cons, List.cons_append]
          rw [hsplit', keep_run_lt after hafter]; simp
        | zero =>
          simp only [List.getElem?_cons_zero, Option.some.injEq] at hc
          subst hc
          have hH' : H' ≠ Tree.empty := by
            rintro rfl; rw [colAt_empty_none] at hcolx; simp at hcolx
          have hei : m ≤ ei := by
            by_contra hlt
            have := hrun ei (by omega)
            rw [hx'] at this
            exact hH' (Prod.mk.inj (Option.some.inj this)).2
          have heil : ei < m + after.length := by
            have := (List.getElem?_eq_some_iff.1 hx').1; omega
          have hne : after ≠ [] := by rintro rfl; simp at heil; omega
          obtain ⟨z, after', rfl⟩ := List.exists_cons_of_ne_nil hne
          simp only [List.take_zero, List.nil_append, List.getD_cons_zero]
          rw [htake ei hei, List.append_assoc, keep_run_lt]
          · simp
          · intro y hy
            rcases Nat.eq_or_lt_of_le hei with rfl | hlt
            · simp at hy; subst hy
              have := hlate 0; rw [Nat.add_zero, hx'] at this
              simp at this
              have hq : q' = z.1 := congrArg Prod.fst this
              have hz := hafter z (by simp)
              rw [← hq] at hz
              simpa using hz
            · rw [show ei - m = (ei - m - 1) + 1 by omega, List.take_succ_cons] at hy
              simp at hy; subst hy; exact hafter _ (by simp)

theorem forestAt_litCapAux_prefix (k p j : Nat) :
    ∀ (ρ π : List (Nat × Nat)) (F : Forest), π <+: ρ → (∃ col, F.colAt ⟨ρ, j⟩ = some col) →
      (litCapAux k p ρ j F).forestAt π = (F.forestAt π).map (litCapAux k p (ρ.drop π.length) j)
  | ρ, [], F, _, _ => by simp [forestAt_nil_path]
  | [], _ :: _, _, h, _ => absurd (List.eq_nil_of_prefix_nil h) (List.cons_ne_nil _ _)
  | (ci, ei) :: ρ, (a, b) :: π, .node cols, h, ⟨col, hcol⟩ => by
    obtain ⟨hab, hp⟩ := List.cons_prefix_cons.1 h
    obtain ⟨rfl, rfl⟩ := Prod.mk.inj hab
    rw [colAt_node_cons] at hcol
    obtain ⟨x, hx, hcolx⟩ := Option.bind_eq_some_iff.1 hcol
    obtain ⟨colc, hc, hx'⟩ := Option.bind_eq_some_iff.1 hx
    obtain ⟨q, H⟩ := x
    have hci : a < cols.length := (List.getElem?_eq_some_iff.1 hc).1
    have hei : b < colc.length := (List.getElem?_eq_some_iff.1 hx').1
    have hget : (cols.getD a [])[b]? = some (q, H) := by
      rw [List.getD_eq_getElem?_getD, hc, Option.getD_some]; exact hx'
    rw [litCapAux_cons k p a b j ρ cols hget, forestAt_node_cons, forestAt_node_cons,
      list_getElem?_take_snoc _ _ _ hci.le, if_neg (lt_irrefl _), if_pos rfl, hc]
    simp only [Option.bind_some, List.getD_eq_getElem?_getD, hc, Option.getD_some]
    rw [list_getElem?_take_snoc _ _ _ hei.le, if_neg (lt_irrefl _), if_pos rfl, hx']
    simp only [Option.bind_some, List.length_cons, List.drop_succ_cons]
    exact forestAt_litCapAux_prefix k p j ρ π H hp ⟨col, hcolx⟩

-- L3.1d (txt:269-272): every V, I-legal upward literal cap of a nonempty height `J` is at most
-- `Γ(J)`, read at the heights of the cap's containing entries
theorem capKey_le_towKey {E : Forest} (hV : CondV E) (hI : CondI E) (hH : CondH E)
    {c : ColAddr} {k p : Nat} (hup : IsUpward E c k p) (hKV : CondV (litCap E c k p))
    (hKI : CondI (litCap E c k p)) {e : EntryAddr} (hcont : e.heightPath <+: c.path)
    {q : Nat} {J : Forest} (he : E.entryAt e = some (q, J)) {d m : Nat}
    (hπ : profile J = ((toLex (d, m) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat))) :
    relKey (e.col.num 0) (((litCap E c k p).heightAt e).getD Tree.empty) ≤ towKey d (m + 1) := by
  obtain ⟨col, hcol, hk, hq⟩ := isUpward_iff_exists.1 hup
  obtain ⟨ρ, hρ⟩ := hcont
  have hJ := heightAt_of_entryAt he
  have hJcol : J.colAt ⟨ρ, c.col⟩ = some col := by
    rw [← hcol]
    simp only [Tree.colAt]
    rw [← hρ, Tree.forestAt_append, Tree.forestAt_heightPath, hJ]; rfl
  have hJne : J ≠ Tree.empty := by rintro rfl; rw [colAt_empty_none] at hJcol; simp at hJcol
  have hK : (litCap E c k p).heightAt e = some (litCapAux k p ρ c.col J) := by
    rw [litCap_eq_aux hcol, ← Tree.forestAt_heightPath,
      forestAt_litCapAux_prefix k p c.col c.path e.heightPath E ⟨ρ, hρ⟩ ⟨col, hcol⟩,
      Tree.forestAt_heightPath, hJ]
    simp [← hρ]
  -- V in the cap at its closing entry
  have hKe : (litCap E c k p).entryAt ⟨c, k⟩ = some (p, Tree.empty) := by
    rw [litCap_eq_aux hcol]
    simp only [Tree.entryAt, Tree.colAt]
    rw [forestAt_litCapAux_prefix k p c.col c.path c.path E (List.prefix_refl _) ⟨col, hcol⟩]
    simp only [Tree.colAt] at hcol
    obtain ⟨G, hG, hGc⟩ := Option.bind_eq_some_iff.1 hcol
    rw [hG]
    obtain ⟨gcols⟩ := G
    have hj : c.col < gcols.length := (List.getElem?_eq_some_iff.1 hGc).1
    simp only [Option.map_some, Option.bind_some, List.drop_length, litCapAux_nil, Tree.cols]
    rw [list_getElem?_take_snoc _ _ _ hj.le, if_neg (lt_irrefl _), if_pos rfl]
    simp only [Option.bind_some, List.getD_eq_getElem?_getD]
    simp only [Tree.cols] at hGc
    rw [hGc, Option.getD_some, List.getElem?_append_right (by simp),
      List.length_take_of_le hk, Nat.sub_self]; rfl
  have hVp := (ColAddr.resolve_isSome_iff 0 c p).1
    (hKV ⟨c, k⟩ ((Tree.mem_entryAddrs_iff _ _).2 (by rw [hKe]; rfl)) p Tree.empty hKe)
  have hnum : c.num 0 = e.col.num 0 + 0 + 1 + ((ρ.map (·.1 + 1)).sum + c.col) := by
    have h1 := num_heightPath e 0
    simp only [ColAddr.num] at h1 ⊢
    rw [← hρ, List.map_append, List.sum_append]; omega
  rw [profile_of_ne hJne, WithBot.coe_inj] at hπ
  have hb := branchOK_of_height hV hI hH (e.col.num 0) J e 0 hJ rfl hJne
  have := capKey_le_tower hb ρ c.col col hJcol hk hq (by omega) hπ
  rw [Nat.sub_zero] at this
  rw [hK, Option.getD_some]
  exact this


/-! ### L3.1e helpers: entries of a literal cap -/

theorem forestAt_litCapAux_off (k p j : Nat) :
    ∀ (ρ π : List (Nat × Nat)) (F G' : Forest),
      (∃ col, F.colAt ⟨ρ, j⟩ = some col ∧ k ≤ col.length) →
      ¬ π <+: ρ → π ≠ ρ ++ [(j, k)] → (litCapAux k p ρ j F).forestAt π = some G' →
      F.forestAt π = some G'
  | _, [], _, _, _, h, _, _ => absurd List.nil_prefix h
  | [], (a, b) :: π, .node cols, G', ⟨col, hcol, hk⟩, _, hne, hG => by
    rw [colAt_node_nil] at hcol
    have hj : j < cols.length := (List.getElem?_eq_some_iff.1 hcol).1
    rw [litCapAux_nil, forestAt_node_cons, list_getElem?_take_snoc _ _ _ hj.le] at hG
    rw [forestAt_node_cons]
    split_ifs at hG with h1 h2
    · exact hG
    · subst h2
      rw [hcol]
      simp only [Option.bind_some, List.getD_eq_getElem?_getD, hcol, Option.getD_some] at hG ⊢
      by_cases hbk : b < k
      · rw [List.getElem?_append_left (by simp; omega), List.getElem?_take_of_lt hbk] at hG
        exact hG
      · rw [List.getElem?_append_right (by simp; omega)] at hG
        by_cases hb : b = k
        · subst hb
          have hl : (col.take b).length = b := List.length_take_of_le hk
          simp only [hl, Nat.sub_self, List.getElem?_cons_zero, Option.bind_some] at hG
          cases π with
          | nil => exact absurd rfl hne
          | cons x π => rw [forestAt_empty_node_cons] at hG; simp at hG
        · rw [List.length_take_of_le hk, List.getElem?_eq_none (by simp; omega)] at hG; simp at hG
    · simp at hG
  | (ci, ei) :: ρ, (a, b) :: π, .node cols, G', ⟨col, hcol, hk⟩, hpre, hne, hG => by
    rw [colAt_node_cons] at hcol
    obtain ⟨x, hx, hcolx⟩ := Option.bind_eq_some_iff.1 hcol
    obtain ⟨colc, hc, hx'⟩ := Option.bind_eq_some_iff.1 hx
    obtain ⟨q, H⟩ := x
    have hci : ci < cols.length := (List.getElem?_eq_some_iff.1 hc).1
    have hei : ei < colc.length := (List.getElem?_eq_some_iff.1 hx').1
    have hget : (cols.getD ci [])[ei]? = some (q, H) := by
      rw [List.getD_eq_getElem?_getD, hc, Option.getD_some]; exact hx'
    rw [litCapAux_cons k p ci ei j ρ cols hget, forestAt_node_cons,
      list_getElem?_take_snoc _ _ _ hci.le] at hG
    rw [forestAt_node_cons]
    split_ifs at hG with h1 h2
    · exact hG
    · subst h2
      rw [hc]
      simp only [Option.bind_some, List.getD_eq_getElem?_getD, hc, Option.getD_some] at hG ⊢
      rw [list_getElem?_take_snoc _ _ _ hei.le] at hG
      split_ifs at hG with h3 h4
      · simpa [List.getElem?_take_of_lt h3] using hG
      · subst h4
        rw [hx']
        simp only [Option.bind_some] at hG ⊢
        exact forestAt_litCapAux_off k p j ρ π H G' ⟨col, hcolx, hk⟩
          (fun h => hpre (List.cons_prefix_cons.2 ⟨rfl, h⟩))
          (fun h => hne (by rw [h]; rfl)) hG
      · simp at hG
    · simp at hG

theorem colAt_litCapAux_self {E : Forest} {c : ColAddr} {col : Column} (hcol : E.colAt c = some col)
    (k p : Nat) : (litCapAux k p c.path c.col E).colAt c = some (col.take k ++ [(p, Tree.empty)]) := by
  simp only [Tree.colAt]
  rw [forestAt_litCapAux_prefix k p c.col c.path c.path E (List.prefix_refl _) ⟨col, hcol⟩]
  simp only [Tree.colAt] at hcol
  obtain ⟨G, hG, hGc⟩ := Option.bind_eq_some_iff.1 hcol
  rw [hG]
  obtain ⟨gcols⟩ := G
  have hj : c.col < gcols.length := (List.getElem?_eq_some_iff.1 hGc).1
  simp only [Option.map_some, Option.bind_some, List.drop_length, litCapAux_nil, Tree.cols]
  rw [list_getElem?_take_snoc _ _ _ hj.le, if_neg (lt_irrefl _), if_pos rfl]
  simp only [Tree.cols] at hGc
  simp [List.getD_eq_getElem?_getD, hGc]

/-- helper: an entry of a literal cap is the appended closing slot, a container of the cap
column, or an unchanged entry of `E`. -/
theorem entryAt_litCap_cases {E : Forest} {c : ColAddr} {col : Column} (hcol : E.colAt c = some col)
    {k p : Nat} (hk : k ≤ col.length) {e : EntryAddr} {x : Nat × Forest} (h : (litCap E c k p).entryAt e = some x) :
    e = ⟨c, k⟩ ∨ e.heightPath <+: c.path ∨ E.entryAt e = some x := by
  rw [litCap_eq_aux hcol] at h
  obtain ⟨⟨π, cc⟩, idx⟩ := e
  simp only [Tree.entryAt, Tree.colAt, Option.bind_eq_some_iff] at h
  obtain ⟨colx, ⟨G', hG', hcc⟩, hidx⟩ := h
  by_cases hpre : π <+: c.path
  · rw [forestAt_litCapAux_prefix k p c.col c.path π E hpre ⟨col, hcol⟩] at hG'
    obtain ⟨G, hG, rfl⟩ := Option.map_eq_some_iff.1 hG'
    obtain ⟨rest, hrest⟩ := hpre
    have hdrop : c.path.drop π.length = rest := by rw [← hrest]; simp
    rw [hdrop] at hcc
    have hEc : G.colAt ⟨rest, c.col⟩ = some col := by
      rw [← hcol]; simp only [Tree.colAt]; rw [← hrest, Tree.forestAt_append, hG]; rfl
    obtain ⟨gcols⟩ := G
    cases rest with
    | nil =>
      rw [colAt_node_nil] at hEc
      have hj : c.col < gcols.length := (List.getElem?_eq_some_iff.1 hEc).1
      simp only [List.append_nil] at hrest
      rw [litCapAux_nil] at hcc
      simp only [Tree.cols] at hcc
      rw [list_getElem?_take_snoc _ _ _ hj.le] at hcc
      split_ifs at hcc with h1 h2
      · right; right
        simp only [Tree.entryAt, Tree.colAt, hG, Option.bind_some, Tree.cols, hcc, hidx]
      · subst h2
        obtain rfl := Option.some.inj hcc
        simp only [List.getD_eq_getElem?_getD, hEc, Option.getD_some] at hidx
        by_cases hik : idx < k
        · right; right
          rw [List.getElem?_append_left (by simp; omega), List.getElem?_take_of_lt hik] at hidx
          simp only [Tree.entryAt, Tree.colAt, hG, Option.bind_some, Tree.cols, hEc, hidx]
        · rw [List.getElem?_append_right (by simp; omega)] at hidx
          by_cases hi : idx = k
          · left; subst hi; subst hrest; rfl
          · rw [List.length_take_of_le hk, List.getElem?_eq_none (by simp; omega)] at hidx
            simp at hidx
    | cons ce rest =>
      obtain ⟨ci, ei⟩ := ce
      rw [colAt_node_cons] at hEc
      obtain ⟨y, hy, hcoly⟩ := Option.bind_eq_some_iff.1 hEc
      obtain ⟨colc, hc, hy'⟩ := Option.bind_eq_some_iff.1 hy
      obtain ⟨q, H⟩ := y
      have hci : ci < gcols.length := (List.getElem?_eq_some_iff.1 hc).1
      have hei : ei < colc.length := (List.getElem?_eq_some_iff.1 hy').1
      have hget : (gcols.getD ci [])[ei]? = some (q, H) := by
        rw [List.getD_eq_getElem?_getD, hc, Option.getD_some]; exact hy'
      rw [litCapAux_cons k p ci ei c.col rest gcols hget] at hcc
      simp only [Tree.cols] at hcc
      rw [list_getElem?_take_snoc _ _ _ hci.le] at hcc
      split_ifs at hcc with h1 h2
      · right; right
        simp only [Tree.entryAt, Tree.colAt, hG, Option.bind_some, Tree.cols, hcc, hidx]
      · subst h2
        obtain rfl := Option.some.inj hcc
        simp only [List.getD_eq_getElem?_getD, hc, Option.getD_some] at hidx
        rw [list_getElem?_take_snoc _ _ _ hei.le] at hidx
        split_ifs at hidx with h3 h4
        · right; right
          simp only [Tree.entryAt, Tree.colAt, hG, Option.bind_some, Tree.cols, hc, hidx]
        · subst h4
          right; left
          exact ⟨rest, by rw [← hrest]; simp [EntryAddr.heightPath]⟩
  · by_cases hcap : π = c.path ++ [(c.col, k)]
    · exfalso
      subst hcap
      rw [forestAt_through_col, show (⟨c.path, c.col⟩ : ColAddr) = c from rfl,
        colAt_litCapAux_self hcol k p] at hG'
      simp only [Option.bind_some, List.getElem?_append_right (by simp : (col.take k).length ≤ k),
        List.length_take_of_le hk, Nat.sub_self, List.getElem?_cons_zero, forestAt_nil_path,
        Option.some.injEq] at hG'
      subst hG'
      simp [Tree.empty, Tree.cols] at hcc
    · right; right
      have := forestAt_litCapAux_off k p c.col c.path π E G' ⟨col, hcol, hk⟩ hpre hcap hG'
      simp only [Tree.entryAt, Tree.colAt, this, Option.bind_some, hcc, hidx]

theorem entryAt_litCap_closing {E : Forest} {c : ColAddr} {col : Column} (hcol : E.colAt c = some col)
    {k : Nat} (hk : k ≤ col.length) (p : Nat) :
    (litCap E c k p).entryAt ⟨c, k⟩ = some (p, Tree.empty) := by
  rw [litCap_eq_aux hcol]
  simp only [Tree.entryAt]
  rw [colAt_litCapAux_self hcol k p]
  simp [List.getElem?_append_right, List.length_take_of_le hk]

theorem heightAt_of_prefix {E : Forest} {c : ColAddr} {col : Column} (hcol : E.colAt c = some col)
    {e : EntryAddr} (hc : e.heightPath <+: c.path) : ∃ q H, E.entryAt e = some (q, H) := by
  obtain ⟨ρ, hρ⟩ := hc
  simp only [Tree.colAt] at hcol
  rw [← hρ, Tree.forestAt_append, Tree.forestAt_heightPath] at hcol
  cases hH : E.heightAt e with
  | none => rw [hH] at hcol; simp at hcol
  | some H =>
    simp only [Tree.heightAt, Option.map_eq_some_iff] at hH
    obtain ⟨⟨q, H'⟩, h1, h2⟩ := hH
    exact ⟨q, H', h1⟩

theorem entryAt_litCap_container {E : Forest} {c : ColAddr} {col : Column}
    (hcol : E.colAt c = some col) {k p : Nat} {e : EntryAddr} {ρ : List (Nat × Nat)}
    (hρ : e.heightPath ++ ρ = c.path) {q : Nat} {J : Forest} (he : E.entryAt e = some (q, J)) :
    (litCap E c k p).entryAt e = some (q, litCapAux k p ρ c.col J) := by
  rw [litCap_eq_aux hcol]
  have hpre : e.col.path <+: c.path := ⟨(e.col.col, e.idx) :: ρ, by rw [← hρ]; simp [EntryAddr.heightPath]⟩
  simp only [Tree.entryAt, Tree.colAt] at he ⊢
  rw [forestAt_litCapAux_prefix k p c.col c.path e.col.path E hpre ⟨col, hcol⟩]
  obtain ⟨colx, ⟨G, hG, hGc⟩, hx⟩ := by simpa only [Option.bind_eq_some_iff] using he
  rw [hG]
  have hdrop : c.path.drop e.col.path.length = (e.col.col, e.idx) :: ρ := by
    rw [← hρ]; simp [EntryAddr.heightPath]
  obtain ⟨gcols⟩ := G
  have hget : (gcols.getD e.col.col [])[e.idx]? = some (q, J) := by
    simp only [Tree.cols] at hGc; rw [List.getD_eq_getElem?_getD, hGc, Option.getD_some]; exact hx
  simp only [Option.map_some, Option.bind_some, hdrop]
  rw [litCapAux_cons k p e.col.col e.idx c.col ρ gcols hget]
  simp only [Tree.cols] at hGc ⊢
  have hci : e.col.col < gcols.length := (List.getElem?_eq_some_iff.1 hGc).1
  have hei : e.idx < colx.length := (List.getElem?_eq_some_iff.1 hx).1
  rw [list_getElem?_take_snoc _ _ _ hci.le, if_neg (lt_irrefl _), if_pos rfl]
  simp only [Option.bind_some, List.getD_eq_getElem?_getD, hGc, Option.getD_some]
  rw [list_getElem?_take_snoc _ _ _ hei.le, if_neg (lt_irrefl _), if_pos rfl]

theorem relKey_empty_lt {a b : Nat} {H : Forest} (h : Tree.empty < H) :
    relKey a Tree.empty < relKey b H := by
  obtain ⟨cols⟩ := H
  cases cols with
  | nil => exact absurd h (lt_irrefl _)
  | cons c cs => rfl

theorem empty_le_forest (H : Forest) : (Tree.empty : Forest) ≤ H := by
  by_cases h : H = Tree.empty
  · rw [h]
  · exact le_of_lt (Forest.empty_lt h)

-- provides: U2, L3.1e (`upward_condS`†, txt:274-282)
theorem upward_condS {E : Forest} (hV : CondV E) (hI : CondI E) (hH : CondH E) (hP : CondP E)
    {c : ColAddr} {k p : Nat} (hup : IsUpward E c k p) (hKV : CondV (litCap E c k p))
    (hKI : CondI (litCap E c k p)) : CondS (litCap E c k p) := by
  obtain ⟨col, hcol, hk, hq⟩ := isUpward_iff_exists.1 hup
  have hS := condS_of_condP hV hI hH hP
  intro e₀ he₀ e he hown
  have hown' := hown
  obtain ⟨hc, q, J', hJ', hres⟩ := hown
  obtain ⟨⟨p₀, H₀'⟩, hx₀⟩ := Option.isSome_iff_exists.1 ((Tree.mem_entryAddrs_iff _ _).1 he₀)
  rw [heightAt_of_entryAt hJ', heightAt_of_entryAt hx₀, Option.getD_some, Option.getD_some]
  have hmemE : ∀ f : EntryAddr, (E.entryAt f).isSome → f ∈ E.entryAddrs :=
    fun f h => (Tree.mem_entryAddrs_iff _ _).2 h
  -- the closing slot has an empty height, so it is not an owner
  have hne₀ : e₀ ≠ ⟨c, k⟩ := by
    rintro rfl
    obtain ⟨H, hH', hHne⟩ := height_ne_of_contains hc (by rw [hJ']; rfl)
    rw [heightAt_of_entryAt (entryAt_litCap_closing hcol hk p)] at hH'
    exact hHne (Option.some.inj hH').symm
  by_cases hcont₀ : e₀.heightPath <+: c.path
  · obtain ⟨ρ₀, hρ₀⟩ := hcont₀
    obtain ⟨p₁, H₀, hE₀⟩ := heightAt_of_prefix hcol ⟨ρ₀, hρ₀⟩
    rw [entryAt_litCap_container hcol hρ₀ hE₀] at hx₀
    obtain ⟨rfl, rfl⟩ := Prod.mk.inj (Option.some.inj hx₀)
    -- the cap strictly raises the owner height
    have hcol₀ : H₀.colAt ⟨ρ₀, c.col⟩ = some col := by
      rw [← hcol]; simp only [Tree.colAt]
      rw [← hρ₀, Tree.forestAt_append, Tree.forestAt_heightPath, heightAt_of_entryAt hE₀]; rfl
    have hup₀ : IsUpward H₀ ⟨ρ₀, c.col⟩ k p := isUpward_iff_exists.2 ⟨col, hcol₀, hk, hq⟩
    have hlt₀ : H₀ < litCapAux k p ρ₀ c.col H₀ := by
      have := lt_litCap hup₀; rwa [litCap_eq_aux hcol₀] at this
    have hkey₀ := (relKey_lt_iff (e₀.col.num 0) _ _).2 hlt₀
    rcases entryAt_litCap_cases hcol hk hJ' with rfl | hcont | hEe
    · rw [entryAt_litCap_closing hcol hk p] at hJ'
      obtain ⟨-, rfl⟩ := Prod.mk.inj (Option.some.inj hJ')
      exact relKey_empty_lt (lt_of_le_of_lt (empty_le_forest H₀) hlt₀)
    · obtain ⟨ρ, hρ⟩ := hcont
      obtain ⟨q₁, J, hEe⟩ := heightAt_of_prefix hcol ⟨ρ, hρ⟩
      rw [entryAt_litCap_container hcol hρ hEe] at hJ'
      obtain ⟨rfl, rfl⟩ := Prod.mk.inj (Option.some.inj hJ')
      have hownE : IsOwnerReturn E e₀ e := ⟨hc, q₁, J, hEe, hres⟩
      have hJne : J ≠ Tree.empty := by
        rintro rfl
        have hJc : (Tree.empty : Forest).colAt ⟨ρ, c.col⟩ = some col := by
          rw [← hcol]; simp only [Tree.colAt]
          rw [← hρ, Tree.forestAt_append, Tree.forestAt_heightPath, heightAt_of_entryAt hEe]; rfl
        rw [colAt_empty_none] at hJc; simp at hJc
      obtain ⟨d, m, -, hπ⟩ := profile_of_entry hI hEe hJne
      have hPJ := hP e₀ (hmemE _ (by rw [hE₀]; rfl)) e (hmemE _ (by rw [hEe]; rfl)) hownE
      rw [heightAt_of_entryAt hEe, heightAt_of_entryAt hE₀, Option.getD_some, Option.getD_some,
        hπ] at hPJ
      have h1 := capKey_le_towKey hV hI hH hup hKV hKI ⟨ρ, hρ⟩ hEe hπ
      rw [heightAt_of_entryAt (entryAt_litCap_container hcol hρ hEe), Option.getD_some] at h1
      exact lt_of_le_of_lt (le_trans h1 (towKey_le_relKey hV hI hH hE₀ hPJ)) hkey₀
    · have hownE : IsOwnerReturn E e₀ e := ⟨hc, q, J', hEe, hres⟩
      have := hS e₀ (hmemE _ (by rw [hE₀]; rfl)) e (hmemE _ (by rw [hEe]; rfl)) hownE
      rw [heightAt_of_entryAt hEe, heightAt_of_entryAt hE₀, Option.getD_some, Option.getD_some] at this
      exact lt_trans this hkey₀
  · have hE₀ : E.entryAt e₀ = some (p₀, H₀') := by
      rcases entryAt_litCap_cases hcol hk hx₀ with h | h | h
      · exact absurd h hne₀
      · exact absurd h hcont₀
      · exact h
    have hEe : E.entryAt e = some (q, J') := by
      rcases entryAt_litCap_cases hcol hk hJ' with h | h | h
      · exfalso; subst h; exact hcont₀ hc
      · exfalso; apply hcont₀
        exact hc.trans ((List.prefix_append _ _).trans h)
      · exact h
    have hownE : IsOwnerReturn E e₀ e := ⟨hc, q, J', hEe, hres⟩
    have := hS e₀ (hmemE _ (by rw [hE₀]; rfl)) e (hmemE _ (by rw [hEe]; rfl)) hownE
    rwa [heightAt_of_entryAt hEe, heightAt_of_entryAt hE₀, Option.getD_some, Option.getD_some] at this


/-! ### L3.1f helpers -/

theorem list_append_lt_append_iff {α : Type} [LinearOrder α] (T : List α) {U V : List α} :
    T ++ U < T ++ V ↔ U < V := by
  induction T with
  | nil => rfl
  | cons t T ih => simp only [List.cons_append, List.cons_lt_cons_iff, lt_irrefl, false_or, true_and, ih]

theorem list_between {α : Type} [LinearOrder α] :
    ∀ (T R S W : List α), ¬ W < T ++ R → W < T ++ S → ∃ U, W = T ++ U
  | [], _, _, W, _, _ => ⟨W, rfl⟩
  | t :: T, R, S, [], h1, _ => by
    exfalso; exact h1 (List.nil_lt_cons _ _)
  | t :: T, R, S, w :: W, h1, h2 => by
    simp only [List.cons_append] at h1 h2
    rw [List.cons_lt_cons_iff] at h1 h2
    rcases h2 with h2 | ⟨rfl, h2⟩
    · exact absurd (Or.inl h2) h1
    · obtain ⟨U, rfl⟩ := list_between T R S W (fun h => h1 (Or.inr ⟨rfl, h⟩)) h2
      exact ⟨U, rfl⟩

theorem capAtom_eq_if (c : ColAddr) (k p : Nat) :
    capAtom c k p = (if decide (k = 0) = true then toLex (2 * colDepth c, toLex (1, p))
      else toLex (2 * colDepth c + 1, toLex (0, p))) := by
  unfold capAtom; simp only [decide_eq_true_eq]

theorem word_le_of_le {X Y : Forest} (h : X ≤ Y) : word X ≤ word Y := by
  rcases lt_or_eq_of_le h with h | rfl
  · exact le_of_lt ((word_lt_iff X Y).2 h)
  · exact le_refl _

-- L3.1f (txt:286-288): the interval fact
theorem interval_cap {X Y : Forest} {c : ColAddr} {k p : Nat} (hup : IsUpward X c k p)
    (hXY : X ≤ Y) (hYC : Y < litCap X c k p) :
    IsUpward Y c k p ∧ litCap Y c k p = litCap X c k p := by
  obtain ⟨col, hcol, hk, hq⟩ := isUpward_iff_exists.1 hup
  obtain ⟨R, hwX, hcap, hnext, hle⟩ := litCap_word_data hcol hk
  set T := (word X).take (capPos X c k) with hT
  have hTl : T.length = capPos X c k := List.length_take_of_le hle
  have h1 : ¬ word Y < T ++ R := by rw [← hwX]; exact not_lt.2 (word_le_of_le hXY)
  have h2 : word Y < T ++ [capAtom c k p] := by rw [← hcap p]; exact (word_lt_iff _ _).2 hYC
  obtain ⟨U, hU⟩ := list_between T R [capAtom c k p] (word Y) h1 h2
  rw [hU] at h1 h2
  rw [list_append_lt_append_iff] at h2
  rw [list_append_lt_append_iff] at h1
  have hUz : ∀ y, U.head? = some y → y < capAtom c k p := by
    intro y hy
    cases U with
    | nil => simp at hy
    | cons u U =>
      simp only [List.head?_cons, Option.some.injEq] at hy; subst hy
      rcases List.cons_lt_cons_iff.1 h2 with h | ⟨-, h⟩
      · exact h
      · exact absurd h (List.not_lt_nil _)
  have hat : ∀ y, (word Y)[capPos X c k]? = some y → y < capAtom c k p := by
    intro y hy
    rw [hU, List.getElem?_append_right (by omega), hTl, Nat.sub_self, ← List.head?_eq_getElem?] at hy
    exact hUz y hy
  have hπ : capPos X c k ≤ mu Y := by
    unfold mu; rw [hU]; simp; omega
  have hwC : word (litCap X c k p) = (word Y).take (capPos X c k) ++
      [if decide (k = 0) then toLex (2 * colDepth c, toLex (1, p))
        else toLex (2 * colDepth c + 1, toLex (0, p))] := by
    rw [hcap p, hU, List.take_left' hTl, capAtom_eq_if]
  have hfirst : decide (k = 0) = true → ∃ y, (word Y)[capPos X c k]? = some y ∧
      2 * colDepth c ≤ (ofLex y).1 := by
    intro hk0; simp only [decide_eq_true_eq] at hk0
    subst hk0
    have hR : ∃ r, R.head? = some r ∧ (ofLex r).1 = 2 * colDepth c := by
      cases hc0 : col[0]? with
      | some x =>
        obtain ⟨q, H⟩ := x
        exact ⟨_, hnext.1 q H hc0, by simp [capAtomAt]⟩
      | none =>
        have : col.length = 0 := by
          have := List.getElem?_eq_none_iff.1 hc0; omega
        exact ⟨_, hnext.2.2 this.symm rfl, by simp⟩
    obtain ⟨r, hr, hr'⟩ := hR
    cases R with
    | nil => simp at hr
    | cons r' R =>
      simp only [List.head?_cons, Option.some.injEq] at hr; subst hr
      cases U with
      | nil => exact absurd (List.nil_lt_cons _ _) h1
      | cons u U =>
        refine ⟨u, by rw [hU, List.getElem?_append_right (by omega), hTl]; simp, ?_⟩
        have : r' ≤ u := by
          rw [List.cons_lt_cons_iff] at h1
          exact not_lt.1 (fun h => h1 (Or.inl h))
        rw [Prod.Lex.le_iff] at this
        rcases this with h | ⟨h, -⟩ <;> omega
  have hnext' : ∀ y, (word Y)[capPos X c k]? = some y →
      y < (if decide (k = 0) then toLex (2 * colDepth c, toLex (1, p))
        else toLex (2 * colDepth c + 1, toLex (0, p))) := by
    intro y hy
    rw [← capAtom_eq_if]; exact hat y hy
  obtain ⟨c', k', hc', hk', hd', hkf, hpos, hup', hcapY⟩ :=
    exists_litCap_of_word hwC hπ hnext' hfirst
  obtain ⟨colY, hcolY, hkY, -⟩ := isUpward_iff_exists.1 hup'
  have hs1 := stopData_litCap' hcolY k' p
  have hs2 := stopData_litCap' hcol k p
  rw [hcapY, hs2] at hs1
  simp only [Option.some.injEq, StopData.mk.injEq] at hs1
  obtain ⟨-, rfl, -, -, hQ⟩ := hs1
  have : k' = k := by
    have := congrArg List.length hQ
    rw [List.length_take_of_le hk, List.length_take_of_le hkY] at this; exact this.symm
  subst this
  exact ⟨hup', hcapY⟩


/-! ### L3.1g helpers: the moved tree, read backwards -/

theorem path_split_at {π : List (Nat × Nat)} {d : Nat} (hd : d < π.length) :
    π = π.take d ++ π[d] :: π.drop (d + 1) := by
  conv_lhs => rw [← List.take_append_drop d π, List.drop_eq_getElem_cons hd]


/-- helper: the backward column map of a move. -/
def bwdC (m : Move) (a : ColAddr) : ColAddr := ⟨m.mapPath m.bwdIdx a.path, a.col⟩

theorem mapPath_length (g : Nat → Nat) (m : Move) (π : List (Nat × Nat)) :
    (m.mapPath g π).length = π.length := by
  rcases mapPath_cases m π with ⟨e, D, rfl⟩ | h
  · simp [mapPath_through]
  · rw [mapPath_off g m π h]

theorem mapPath_fst (g : Nat → Nat) (m : Move) (π : List (Nat × Nat)) :
    (m.mapPath g π).map Prod.fst = π.map Prod.fst := by
  rcases mapPath_cases m π with ⟨e, D, rfl⟩ | h
  · simp [mapPath_through]
  · rw [mapPath_off g m π h]

theorem mapPath_getElem_fst (g : Nat → Nat) (m : Move) (π : List (Nat × Nat)) (k : Nat) :
    ((m.mapPath g π)[k]?).map Prod.fst = (π[k]?).map Prod.fst := by
  rw [← List.getElem?_map, ← List.getElem?_map, mapPath_fst]

theorem take_append_cons {α : Type} (P D : List α) (x : α) {n : Nat} (hn : P.length < n) :
    (P ++ x :: D).take n = P ++ x :: D.take (n - P.length - 1) := by
  rw [List.take_append, List.take_of_length_le (by omega),
    show n - P.length = (n - P.length - 1) + 1 by omega, List.take_succ_cons, Nat.add_sub_cancel]

theorem mapPath_take (g : Nat → Nat) (m : Move) (π : List (Nat × Nat)) (n : Nat) :
    (m.mapPath g π).take n = m.mapPath g (π.take n) := by
  rcases mapPath_cases m π with ⟨e, D, rfl⟩ | h
  · rw [mapPath_through]
    by_cases hn : n ≤ m.col.path.length
    · rw [List.take_append_of_le_length hn, List.take_append_of_le_length hn,
        mapPath_off g m _ (fun e' D' he => by
          have := congrArg List.length he; simp at this; omega)]
    · rw [take_append_cons _ _ _ (by omega), take_append_cons _ _ _ (by omega), mapPath_through]
  · rw [mapPath_off g m π h]
    by_cases ht : ∃ e D, π.take n = m.col.path ++ (m.col.col, e) :: D
    · obtain ⟨e, D, hD⟩ := ht
      exfalso; apply h e (D ++ π.drop n)
      conv_lhs => rw [← List.take_append_drop n π, hD]
      simp
    · rw [mapPath_off g m _ (fun e D he => ht ⟨e, D, he⟩)]

theorem num_bwdC (m : Move) (a : ColAddr) (b : Nat) : (bwdC m a).num b = a.num b := by
  simp only [bwdC, ColAddr.num]
  have := congrArg (fun l => (l.map (· + 1)).sum) (mapPath_fst m.bwdIdx m a.path)
  simp only [List.map_map] at this
  rw [show (fun x : Nat × Nat => x.1 + 1) = ((· + 1) ∘ Prod.fst) from rfl, this]

theorem bwdC_col (m : Move) : bwdC m m.col = m.col := by
  simp only [bwdC]
  rw [mapPath_off _ _ _ (fun e D he => by have := congrArg List.length he; simp at this)]

/-- helper: columns of a forest after `modifyColAux` keep their parent labels. -/
theorem cols_modifyColAux_labels (f : Column → Column) (cc : Nat) (Q : List (Nat × Nat)) (G : Forest)
    (c' : Nat) (h : ¬ (Q = [] ∧ c' = cc)) :
    ((modifyColAux f Q cc G).cols[c']?).map (·.map Prod.fst) = (G.cols[c']?).map (·.map Prod.fst) := by
  obtain ⟨cols⟩ := G
  cases Q with
  | nil =>
    simp only [modifyColAux, Tree.cols]
    rw [list_getElem?_modify_ne _ _ (fun h' => h ⟨rfl, h'.symm⟩)]
  | cons ab Q =>
    obtain ⟨a, b⟩ := ab
    simp only [modifyColAux, Tree.cols]
    by_cases ha : a = c'
    · subst ha; rw [list_getElem?_modify_self]
      cases cols[a]? with
      | none => rfl
      | some col =>
        simp only [Option.map_some, Option.some.injEq]
        apply List.ext_getElem?
        intro n
        simp only [List.getElem?_map, List.getElem?_modify]
        cases col[n]? with
        | none => rfl
        | some v => simp only [Option.map_some]; split <;> rfl
    · rw [list_getElem?_modify_ne _ _ ha]

theorem cols_modifyColAux_entry (f : Column → Column) (cc : Nat) (Q : List (Nat × Nat)) (G : Forest)
    (c' idx : Nat) (h : ¬ (Q = [] ∧ c' = cc)) (h' : ¬ [(c', idx)] <+: Q) :
    ((modifyColAux f Q cc G).cols[c']?).bind (·[idx]?) = (G.cols[c']?).bind (·[idx]?) := by
  obtain ⟨cols⟩ := G
  cases Q with
  | nil =>
    simp only [modifyColAux, Tree.cols]
    rw [list_getElem?_modify_ne _ _ (fun h'' => h ⟨rfl, h''.symm⟩)]
  | cons ab Q =>
    obtain ⟨a, b⟩ := ab
    simp only [modifyColAux, Tree.cols]
    by_cases ha : a = c'
    · subst ha; rw [list_getElem?_modify_self]
      cases cols[a]? with
      | none => rfl
      | some col =>
        simp only [Option.map_some, Option.bind_some]
        have hb : b ≠ idx := by
          rintro rfl; exact h' (List.cons_prefix_cons.2 ⟨rfl, List.nil_prefix⟩)
        rw [list_getElem?_modify_ne _ _ hb]
    · rw [list_getElem?_modify_ne _ _ ha]

theorem forestAt_mod_corr {K : Forest} {m : Move} {col : Column} (hcol : K.colAt m.col = some col)
    (hij : m.i < m.j) (hj : m.j < col.length) :
    ∀ π G', (modifyColAux (moveFun m) m.col.path m.col.col K).forestAt π = some G' →
      ∃ G, K.forestAt (m.mapPath m.bwdIdx π) = some G ∧ G'.cols.length = G.cols.length ∧
        ∀ c', ¬ (π = m.col.path ∧ c' = m.col.col) →
          (G'.cols[c']?).map (·.map Prod.fst) = (G.cols[c']?).map (·.map Prod.fst) ∧
          ∀ idx, ¬ (π ++ [(c', idx)] <+: m.col.path) →
            (G'.cols[c']?).bind (·[idx]?) = (G.cols[c']?).bind (·[idx]?) := by
  intro π G' hG'
  by_cases h1 : π <+: m.col.path
  · rw [forestAt_modifyColAux_prefix _ _ _ _ _ h1] at hG'
    obtain ⟨G, hG, rfl⟩ := Option.map_eq_some_iff.1 hG'
    have hoff : ∀ e D, π ≠ m.col.path ++ (m.col.col, e) :: D := by
      intro e D he; have := h1.length_le; rw [he] at this; simp at this
    refine ⟨G, by rw [mapPath_off _ _ _ hoff]; exact hG, cols_length_modifyColAux _ _ _ _, ?_⟩
    obtain ⟨Q, hQ⟩ := h1
    have hdrop : m.col.path.drop π.length = Q := by rw [← hQ]; simp
    rw [hdrop]
    intro c' hc'
    have hne : ¬ (Q = [] ∧ c' = m.col.col) := by
      rintro ⟨rfl, h⟩; exact hc' ⟨by simpa using hQ, h⟩
    refine ⟨cols_modifyColAux_labels _ _ _ _ _ hne, fun idx hidx => ?_⟩
    apply cols_modifyColAux_entry _ _ _ _ _ _ hne
    intro hpre; apply hidx; rw [← hQ]; exact (List.prefix_append_right_inj π).2 hpre
  by_cases h2 : ∃ e D, π = m.col.path ++ (m.col.col, e) :: D
  · obtain ⟨e, D, rfl⟩ := h2
    rw [forestAt_modifyColAux_through, show (⟨m.col.path, m.col.col⟩ : ColAddr) = m.col from rfl,
      hcol] at hG'
    simp only [Option.bind_some, moveFun] at hG'
    rw [getElem?_moveFun m col hij.le hj.le] at hG'
    refine ⟨G', ?_, rfl, fun _ _ => ⟨rfl, fun _ _ => rfl⟩⟩
    rw [mapPath_through, forestAt_through_col, show (⟨m.col.path, m.col.col⟩ : ColAddr) = m.col from rfl,
      hcol]
    exact hG'
  · have hoff : ∀ e D, π ≠ m.col.path ++ (m.col.col, e) :: D := fun e D he => h2 ⟨e, D, he⟩
    rw [forestAt_modifyColAux_off _ _ _ _ _ h1 hoff] at hG'
    exact ⟨G', by rw [mapPath_off _ _ _ hoff]; exact hG', rfl, fun _ _ => ⟨rfl, fun _ _ => rfl⟩⟩

/-- helper: a column of the moved tree read at its backward address. -/
theorem colAt_mod_corr {K : Forest} {m : Move} {col : Column} (hcol : K.colAt m.col = some col)
    (hij : m.i < m.j) (hj : m.j < col.length) {a : ColAddr} {col' : Column}
    (h : (applyMove K m).colAt a = some col') :
    ∃ col0, K.colAt (bwdC m a) = some col0 ∧
      (a = m.col → col' = moveFun m col ∧ col0 = col) ∧
      (a ≠ m.col → col'.map Prod.fst = col0.map Prod.fst ∧
        ∀ idx, ¬ (a.path ++ [(a.col, idx)] <+: m.col.path) → col'[idx]? = col0[idx]?) := by
  rw [applyMove_eq_mod hcol hij hj] at h
  by_cases ha : a = m.col
  · subst ha
    have := colAt_mod_self (moveFun m) K m.col
    rw [hcol, h] at this
    refine ⟨col, by rw [bwdC_col]; exact hcol, fun _ => ⟨Option.some.inj this, rfl⟩, fun h' => absurd rfl h'⟩
  · simp only [Tree.colAt, Option.bind_eq_some_iff] at h
    obtain ⟨G', hG', hc'⟩ := h
    obtain ⟨G, hG, -, hcorr⟩ := forestAt_mod_corr hcol hij hj a.path G' hG'
    have hne : ¬ (a.path = m.col.path ∧ a.col = m.col.col) := by
      rintro ⟨h1, h2⟩; exact ha (by cases a; cases m.col; simp_all)
    obtain ⟨hl, he⟩ := hcorr a.col hne
    rw [hc'] at hl he
    obtain ⟨col0, hcol0, hl0⟩ := Option.map_eq_some_iff.1 hl.symm
    refine ⟨col0, by simp only [Tree.colAt, bwdC, hG, Option.bind_some]; exact hcol0,
      fun h' => absurd h' ha, fun _ => ⟨hl0.symm, fun idx hidx => ?_⟩⟩
    have := he idx hidx
    rw [hcol0] at this
    simpa using this

theorem forestAt_take_some {E : Forest} {π : List (Nat × Nat)} {F : Forest} (h : E.forestAt π = some F)
    (d : Nat) : ∃ G, E.forestAt (π.take d) = some G := by
  rw [← List.take_append_drop d π, Tree.forestAt_append] at h
  cases h' : E.forestAt (π.take d) with
  | none => rw [h'] at h; simp at h
  | some G => exact ⟨G, rfl⟩

theorem mapPath_getElem_of_ne (g : Nat → Nat) (m : Move) (π : List (Nat × Nat)) (d : Nat)
    (h : ¬ (d = m.col.path.length ∧ π.take d = m.col.path)) : (m.mapPath g π)[d]? = π[d]? := by
  rcases mapPath_cases m π with ⟨e, D, rfl⟩ | h'
  · rw [mapPath_through]
    rcases lt_trichotomy d m.col.path.length with hd | hd | hd
    · rw [List.getElem?_append_left hd, List.getElem?_append_left hd]
    · exact absurd ⟨hd, by subst hd; simp⟩ h
    · rw [List.getElem?_append_right hd.le, List.getElem?_append_right hd.le,
        show d - m.col.path.length = (d - m.col.path.length - 1) + 1 by omega]
      rfl
  · rw [mapPath_off g m π h']

/-- helper: the route of `K` passes through the move column, which is the last column of its
forest with last entry `j`. -/
theorem moveOK_route {K : Forest} {m : Move} (hm : MoveOK K m) :
    (∀ d < m.col.path.length, ∃ F, K.forestAt (m.col.path.take d) = some F ∧
      F.lastStep? = m.col.path[d]?) ∧
    ∃ F, K.forestAt m.col.path = some F ∧ F.lastStep? = some (m.col.col, m.j) := by
  obtain ⟨col, sd, hcol, hsd, hj, hij, hpre, -⟩ := hm
  obtain ⟨-, -, -, hmem, -⟩ := stopData_spec hsd
  obtain ⟨hroute, -⟩ := (mem_routeCols_iff K sd.col).1 hmem
  obtain ⟨rest, hrest⟩ := hpre
  simp only [EntryAddr.heightPath, List.append_assoc, List.singleton_append] at hrest
  refine ⟨fun d hd => ?_, ?_⟩
  · obtain ⟨F, hF, hl⟩ := hroute d (by rw [← hrest]; simp; omega)
    refine ⟨F, ?_, ?_⟩
    · rw [← hrest, List.take_append_of_le_length hd.le] at hF; exact hF
    · rw [hl, ← hrest, List.getElem?_append_left hd]
  · obtain ⟨F, hF, hl⟩ := hroute m.col.path.length (by rw [← hrest]; simp)
    refine ⟨F, ?_, ?_⟩
    · rw [← hrest, List.take_left] at hF; exact hF
    · rw [hl, ← hrest]; simp

theorem lastStep_eq {F : Forest} : F.lastStep? = (F.cols[F.cols.length - 1]?).bind fun col =>
    if col.isEmpty then none else some (F.cols.length - 1, col.length - 1) := by
  simp only [Tree.lastStep?, List.getLast?_eq_getElem?]

theorem lastStep_corr {K : Forest} {m : Move} (hm : MoveOK K m) {col : Column}
    (hcol : K.colAt m.col = some col) (hij : m.i < m.j) (hj : m.j + 1 = col.length)
    {π : List (Nat × Nat)} {G' G : Forest}
    (hG' : (modifyColAux (moveFun m) m.col.path m.col.col K).forestAt π = some G')
    (hG : K.forestAt (m.mapPath m.bwdIdx π) = some G) (hlen : G'.cols.length = G.cols.length)
    (hcorr : ∀ c', ¬ (π = m.col.path ∧ c' = m.col.col) →
      (G'.cols[c']?).map (·.map Prod.fst) = (G.cols[c']?).map (·.map Prod.fst)) :
    (π = m.col.path → G'.lastStep? = some (m.col.col, m.i) ∧ G.lastStep? = some (m.col.col, m.j)) ∧
    (π ≠ m.col.path → G'.lastStep? = G.lastStep?) := by
  constructor
  · rintro rfl
    obtain ⟨-, F, hF, hlF⟩ := moveOK_route hm
    rw [mapPath_off _ _ _ (fun e D he => by have := congrArg List.length he; simp at this), hF] at hG
    obtain rfl := Option.some.inj hG
    refine ⟨?_, hlF⟩
    have hG'c : G'.cols[m.col.col]? = some (moveFun m col) := by
      have := colAt_mod_self (moveFun m) K m.col
      rw [hcol] at this
      simp only [Tree.colAt, hG', Option.bind_some] at this; exact this
    have hFc : F.cols[m.col.col]? = some col := by
      simp only [Tree.colAt, hF, Option.bind_some] at hcol; exact hcol
    rw [lastStep_eq] at hlF ⊢
    obtain ⟨colL, hL, hls⟩ := Option.bind_eq_some_iff.1 hlF
    split_ifs at hls with hne
    obtain ⟨h1, h2⟩ := Prod.mk.inj (Option.some.inj hls)
    rw [hlen, h1, hG'c]
    simp only [Option.bind_some]
    have hmf : (moveFun m col).length = m.i + 1 := by
      simp only [moveFun, List.length_append, List.length_take, List.length_drop]; omega
    rw [hmf, if_neg (by simp [List.isEmpty_iff, ← List.length_eq_zero_iff, hmf])]
    rfl
  · intro hπ
    rw [lastStep_eq, lastStep_eq, hlen]
    have h := hcorr (G.cols.length - 1) (fun h => hπ h.1)
    cases h1 : G'.cols[G.cols.length - 1]? with
    | none =>
      rw [h1] at h
      cases h2 : G.cols[G.cols.length - 1]? with
      | none => rfl
      | some c => rw [h2] at h; simp at h
    | some c' =>
      rw [h1] at h
      cases h2 : G.cols[G.cols.length - 1]? with
      | none => rw [h2] at h; simp at h
      | some c =>
        rw [h2] at h
        have hl : c'.length = c.length := by
          have := congrArg List.length (Option.some.inj h); simpa using this
        simp only [Option.bind_some, List.isEmpty_iff, ← List.length_eq_zero_iff, hl]

theorem routeCols_corr {K : Forest} {m : Move} (hm : MoveOK K m) {col : Column}
    (hcol : K.colAt m.col = some col) (hij : m.i < m.j) (hj : m.j + 1 = col.length) {a : ColAddr}
    (ha : ((applyMove K m).colAt a).isSome) :
    a ∈ routeCols (applyMove K m) ↔ bwdC m a ∈ routeCols K := by
  have hj' : m.j < col.length := by omega
  rw [mem_routeCols_iff, mem_routeCols_iff]
  rw [applyMove_eq_mod hcol hij hj'] at ha ⊢
  obtain ⟨col', hcol'⟩ := Option.isSome_iff_exists.1 ha
  simp only [Tree.colAt, Option.bind_eq_some_iff] at hcol'
  obtain ⟨F'0, hF'0, -⟩ := hcol'
  obtain ⟨F0, hF0, hlen0, -⟩ := forestAt_mod_corr hcol hij hj' a.path F'0 hF'0
  have hroute : Scan.IsRoutePath (modifyColAux (moveFun m) m.col.path m.col.col K) a.path ↔
      Scan.IsRoutePath K (m.mapPath m.bwdIdx a.path) := by
    simp only [Scan.IsRoutePath, mapPath_length]
    refine forall_congr' fun d => forall_congr' fun hd => ?_
    obtain ⟨G', hG'⟩ := forestAt_take_some hF'0 d
    obtain ⟨G, hG, hlen, hcorr⟩ := forestAt_mod_corr hcol hij hj' _ G' hG'
    have hG2 : K.forestAt ((m.mapPath m.bwdIdx a.path).take d) = some G := by
      rw [mapPath_take]; exact hG
    have hls := lastStep_corr hm hcol hij hj hG' hG hlen (fun c' h => (hcorr c' h).1)
    constructor
    · rintro ⟨G₁, hG₁, hl₁⟩
      rw [hG'] at hG₁; obtain rfl := Option.some.inj hG₁
      refine ⟨G, hG2, ?_⟩
      by_cases hP : a.path.take d = m.col.path
      · obtain ⟨h1, h2⟩ := hls.1 hP
        rw [h1] at hl₁; rw [h2]
        have hdL : d = m.col.path.length := by
          have := congrArg List.length hP; simp at this; omega
        have hx : a.path[d] = (m.col.col, m.i) := by
          have := hl₁.symm; rw [List.getElem?_eq_getElem hd] at this; exact Option.some.inj this
        have hsplit : a.path = m.col.path ++ (m.col.col, m.i) :: a.path.drop (d + 1) := by
          conv_lhs => rw [path_split_at hd]
          rw [hP, hx]
        rw [hsplit, mapPath_through]
        have : m.bwdIdx m.i = m.j := by unfold Move.bwdIdx; rw [if_pos le_rfl]; omega
        rw [this, hdL]; simp
      · rw [← hls.2 hP, hl₁]
        exact (mapPath_getElem_of_ne m.bwdIdx m a.path d (fun h => hP h.2)).symm
    · rintro ⟨G₁, hG₁, hl₁⟩
      rw [hG2] at hG₁; obtain rfl := Option.some.inj hG₁
      refine ⟨G', hG', ?_⟩
      by_cases hP : a.path.take d = m.col.path
      · obtain ⟨h1, h2⟩ := hls.1 hP
        rw [h2] at hl₁; rw [h1]
        have hdL : d = m.col.path.length := by
          have := congrArg List.length hP; simp at this; omega
        obtain ⟨x, hx⟩ : ∃ x, a.path[d]? = some x := ⟨_, List.getElem?_eq_getElem hd⟩
        have hsplit : a.path = m.col.path ++ x :: a.path.drop (d + 1) := by
          conv_lhs => rw [path_split_at hd]
          rw [hP, (List.getElem?_eq_some_iff.1 hx).2]
        obtain ⟨x1, x2⟩ := x
        by_cases hx1 : x1 = m.col.col
        · subst hx1
          rw [hsplit, mapPath_through, hdL] at hl₁
          simp only [List.getElem?_append_right le_rfl, Nat.sub_self, List.getElem?_cons_zero,
            Option.some.injEq, Prod.mk.injEq, true_and] at hl₁
          have hx2 : x2 = m.i := by unfold Move.bwdIdx at hl₁; split_ifs at hl₁ <;> omega
          rw [hx, hx2]
        · exfalso
          rw [hsplit, mapPath_off _ _ _ (fun e D he => by
            simp only [List.append_cancel_left_eq, List.cons.injEq, Prod.mk.injEq] at he
            exact hx1 he.1.1), hdL] at hl₁
          simp at hl₁; exact hx1 hl₁.1.symm
      · rw [hls.2 hP, hl₁]
        exact mapPath_getElem_of_ne m.bwdIdx m a.path d (fun h => hP h.2)
  rw [hroute]
  apply and_congr_right
  intro _
  constructor
  · rintro ⟨F, hF, hFl⟩; rw [hF'0] at hF; obtain rfl := Option.some.inj hF
    exact ⟨F0, hF0, hlen0 ▸ hFl⟩
  · rintro ⟨F, hF, hFl⟩; simp only [bwdC] at hF hFl; rw [hF0] at hF; obtain rfl := Option.some.inj hF
    exact ⟨F'0, hF'0, hlen0.symm ▸ hFl⟩

/-- helper: in `K`, every column containing the move column is a route column whose last entry
contains it (the move column itself is a route column). -/
theorem container_route_K {K : Forest} {m : Move} (hm : MoveOK K m) {a : ColAddr} {idx : Nat}
    (h : a.path ++ [(a.col, idx)] <+: m.col.path ∨ (a = m.col ∧ idx = m.j)) :
    a ∈ routeCols K ∧ ∃ col0, K.colAt a = some col0 ∧ idx + 1 = col0.length := by
  obtain ⟨hlev, F, hF, hlF⟩ := moveOK_route hm
  rcases h with ⟨rest, hrest⟩ | ⟨rfl, rfl⟩
  · have hd : a.path.length < m.col.path.length := by rw [← hrest]; simp
    have htake : m.col.path.take a.path.length = a.path := by rw [← hrest]; simp
    have hget : m.col.path[a.path.length]? = some (a.col, idx) := by rw [← hrest]; simp
    obtain ⟨G, hG, hlG⟩ := hlev a.path.length hd
    rw [htake] at hG
    rw [hget, lastStep_eq] at hlG
    obtain ⟨colL, hL, hls⟩ := Option.bind_eq_some_iff.1 hlG
    split_ifs at hls with hne
    obtain ⟨h1, h2⟩ := Prod.mk.inj (Option.some.inj hls)
    refine ⟨(mem_routeCols_iff K a).2 ⟨fun d hd' => ?_, G, hG, by
      have := (List.getElem?_eq_some_iff.1 hL).1; omega⟩, colL, ?_, ?_⟩
    · obtain ⟨G₁, hG₁, hl₁⟩ := hlev d (by omega)
      refine ⟨G₁, ?_, ?_⟩
      · rw [← htake, List.take_take, Nat.min_eq_left hd'.le]; exact hG₁
      · rw [hl₁, ← htake, List.getElem?_take_of_lt hd']
    · simp only [Tree.colAt, hG, Option.bind_some]; rw [← h1]; exact hL
    · have : colL.length ≠ 0 := by simpa [List.isEmpty_iff, ← List.length_eq_zero_iff] using hne
      omega
  · rw [lastStep_eq] at hlF
    obtain ⟨colL, hL, hls⟩ := Option.bind_eq_some_iff.1 hlF
    split_ifs at hls with hne
    obtain ⟨h1, h2⟩ := Prod.mk.inj (Option.some.inj hls)
    refine ⟨(mem_routeCols_iff K m.col).2 ⟨hlev, F, hF, by
      have := (List.getElem?_eq_some_iff.1 hL).1; omega⟩, colL, ?_, ?_⟩
    · simp only [Tree.colAt, hF, Option.bind_some]; rw [← h1]; exact hL
    · have : colL.length ≠ 0 := by simpa [List.isEmpty_iff, ← List.length_eq_zero_iff] using hne
      omega

theorem capKeys_corr {K : Forest} {m : Move} (hm : MoveOK K m) {col : Column}
    (hcol : K.colAt m.col = some col) (hij : m.i < m.j) (hj : m.j + 1 = col.length) {a : ColAddr}
    (ha : ((applyMove K m).colAt a).isSome) (hne : a ≠ m.col) :
    capKeys (applyMove K m) (routeCols (applyMove K m)) a = capKeys K (routeCols K) (bwdC m a) := by
  have hj' : m.j < col.length := by omega
  obtain ⟨col', hcol'⟩ := Option.isSome_iff_exists.1 ha
  obtain ⟨col0, hcol0, -, hcorr⟩ := colAt_mod_corr hcol hij hj' hcol'
  obtain ⟨hlab, hent⟩ := hcorr hne
  have hlen : col'.length = col0.length := by
    have := congrArg List.length hlab; simpa using this
  -- an entry containing the move column is the last entry of a route column
  have hcont : ∀ idx, a.path ++ [(a.col, idx)] <+: m.col.path →
      bwdC m a ∈ routeCols K ∧ idx + 1 = col0.length := by
    intro idx h
    have hba : bwdC m a = a := by
      simp only [bwdC]
      rw [mapPath_off _ _ _ (fun e D he => by
        have h1 := h.length_le; rw [he] at h1; simp at h1)]
    obtain ⟨hr, c0, hc0, hl0⟩ := container_route_K hm (Or.inl h)
    rw [hba] at hcol0 ⊢
    rw [hcol0] at hc0; obtain rfl := Option.some.inj hc0
    exact ⟨hr, hl0⟩
  simp only [capKeys, actualKeys]
  rw [hcol', hcol0, Option.getD_some, Option.getD_some, num_bwdC]
  have hrc := routeCols_corr hm hcol hij hj ha
  by_cases hr : bwdC m a ∈ routeCols K
  · rw [if_pos (hrc.2 hr), if_pos hr]
    have hdl : col'.dropLast = col0.dropLast := by
      apply List.ext_getElem?
      intro n
      rw [List.getElem?_dropLast, List.getElem?_dropLast, hlen]
      split_ifs with hn
      · apply hent
        intro h; have := (hcont n h).2; omega
      · rfl
    rw [← List.map_dropLast, ← List.map_dropLast, hdl, List.getLast?_map, List.getLast?_map]
    congr 2
    by_cases hc : col0 = []
    · have : col' = [] := List.eq_nil_of_length_eq_zero (by rw [hlen, hc]; rfl)
      rw [this, hc]
    · have hc' : col' ≠ [] := fun h => hc (List.eq_nil_of_length_eq_zero (by rw [← hlen, h]; rfl))
      rw [List.getLast?_eq_some_getLast hc, List.getLast?_eq_some_getLast hc']; rfl
  · rw [if_neg (fun h => hr (hrc.1 h)), if_neg hr]
    have : col' = col0 := by
      apply List.ext_getElem?
      intro n
      apply hent
      intro h; exact hr (hcont n h).1
    rw [this]

/-- helper: the capped keys of the move column, before and after the move. -/
theorem capKeys_moved {K : Forest} {m : Move} (hm : MoveOK K m) {col : Column}
    (hcol : K.colAt m.col = some col) (hij : m.i < m.j) (hj : m.j + 1 = col.length) :
    capKeys K (routeCols K) m.col =
      (col.map fun x => ((relKey (m.col.num 0) x.2 : Key) : WithTop Key)).take m.j ++ [⊤] ∧
    capKeys (applyMove K m) (routeCols (applyMove K m)) m.col =
      (col.map fun x => ((relKey (m.col.num 0) x.2 : Key) : WithTop Key)).take m.i ++ [⊤] := by
  have hj' : m.j < col.length := by omega
  have hr : m.col ∈ routeCols K := (container_route_K hm (Or.inr ⟨rfl, rfl⟩)).1
  have hK' : (applyMove K m).colAt m.col = some (moveFun m col) := by
    rw [applyMove_eq_mod hcol hij hj', colAt_mod_self, hcol]; rfl
  have hr' : m.col ∈ routeCols (applyMove K m) := by
    rw [routeCols_corr hm hcol hij hj (by rw [hK']; rfl), bwdC_col]; exact hr
  have hmf : moveFun m col = col.take m.i ++ [col.getD m.j (0, Tree.empty)] := by
    simp only [moveFun]
    congr 1
    rw [List.drop_eq_getElem_cons hj', List.drop_eq_nil_of_le (by omega)]
    simp [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hj']
  constructor
  · simp only [capKeys, actualKeys, if_pos hr, hcol, Option.getD_some]
    rw [List.dropLast_eq_take, List.length_map, ← hj, Nat.add_sub_cancel]
    cases h : (col.map fun x => ((relKey (m.col.num 0) x.2 : Key) : WithTop Key)).getLast? with
    | none => simp at h; subst h; simp at hj
    | some _ => rfl
  · simp only [capKeys, actualKeys, if_pos hr', hK', Option.getD_some, hmf, List.map_append,
      List.map_cons, List.map_nil]
    rw [List.dropLast_concat, List.getLast?_concat, List.map_take]
    rfl

theorem nu_mem {α : Type} [LinearOrder α] {P : α → Prop} :
    ∀ (l acc : List α), (∀ y ∈ acc, P y) → (∀ y ∈ l, P y) → ∀ y ∈ l.foldl nuStep acc, P y
  | [], acc, hacc, _ => hacc
  | x :: l, acc, hacc, hl => by
    apply nu_mem l (nuStep acc x) _ (fun y hy => hl y (by simp [hy]))
    intro y hy
    simp only [nuStep, List.mem_append, List.mem_reverse, List.mem_singleton] at hy
    rcases hy with hy | rfl
    · exact hacc y (List.mem_reverse.1 ((List.dropWhile_sublist _).subset hy))
    · exact hl _ (by simp)

theorem cutQuery_mem {α : Type} [LinearOrder α] {P : α → Prop} (ks : List α) (t : Nat)
    (h : ∀ y ∈ ks, P y) : ∀ y ∈ cutQuery ks t, P y := by
  intro y hy
  simp only [cutQuery, nu_eq_foldl] at hy
  exact nu_mem _ [] (by simp) (fun z hz => h z (List.mem_of_mem_take hz)) y hy

/-! #### scans against `⊤`-free queries -/

theorem cursor_top_zero : ∀ (V : List (WithTop Key)), (∀ y ∈ V, y ≠ ⊤) → cursor [⊤] V = 0
  | [], _ => by rw [cursor_nil_right]
  | y :: V, h => by
    rw [cursor]
    have hy : y ≠ ⊤ := h y (by simp)
    rw [if_neg (not_top_lt), if_neg (fun h' => hy h'.symm)]
    exact cursor_top_zero V (fun z hz => h z (by simp [hz]))

theorem cursor_snoc_top_le (X W : List (WithTop Key)) (hW : ∀ y ∈ W, y ≠ ⊤) :
    cursor (X ++ [⊤]) W ≤ X.length := by
  rcases Nat.lt_or_eq_of_le (cursor_le_length X W) with h | h
  · rw [cursor_append_of_lt _ h]; exact h.le
  · rw [(cursor_append_of_exhausted [⊤] h).1, cursor_top_zero _ (fun y hy => hW y (List.mem_of_mem_drop hy))]
    simp

/-- helper: the scan of the move column after the move ends at the same parent. -/
theorem resp_moved_eq {col : Column} {m : Move} (hij : m.i < m.j) (hj : m.j + 1 = col.length)
    (hpar : ∀ x, m.i ≤ x → x ≤ m.j → (col.getD x (0, Tree.empty)).1 = (col.getD m.j (0, Tree.empty)).1)
    (L : List (WithTop Key)) (hL : L.length = col.length) (W : List (WithTop Key))
    (hW : ∀ y ∈ W, y ≠ ⊤) :
    ((moveFun m col)[cursor (L.take m.i ++ [⊤]) W]?).map Prod.fst =
      (col[cursor (L.take m.j ++ [⊤]) W]?).map Prod.fst := by
  set t := cursor (L.take m.j ++ [⊤]) W with ht
  have htle : t ≤ m.j := by
    have := cursor_snoc_top_le (L.take m.j) W hW; simp at this; omega
  have htake : (L.take m.j ++ [⊤]).take m.i = L.take m.i := by
    rw [List.take_append_of_le_length (by simp; omega), List.take_take, Nat.min_eq_left hij.le]
  have hc := cursor_take (L.take m.j ++ [⊤]) W m.i
  rw [htake, ← ht] at hc
  have hlA : (L.take m.i).length = m.i := by simp; omega
  have hmf : ∀ x, x < m.i → (moveFun m col)[x]? = col[x]? := by
    intro x hx
    simp only [moveFun]
    rw [List.getElem?_append_left (by simp; omega), List.getElem?_take_of_lt hx]
  have hmfi : (moveFun m col)[m.i]? = col[m.j]? := by
    rw [moveFun, getElem?_moveFun m col hij.le (by omega)]
    unfold Move.bwdIdx; rw [if_pos le_rfl]; congr 1; omega
  rcases Nat.lt_or_ge t m.i with hlt | hge
  · rw [Nat.min_eq_right hlt.le] at hc
    rw [cursor_append_of_lt _ (by omega), hc, hmf t hlt]
  · rw [Nat.min_eq_left hge] at hc
    rw [(cursor_append_of_exhausted [⊤] (by omega)).1, cursor_top_zero _
      (fun y hy => hW y (List.mem_of_mem_drop hy)), hlA, Nat.add_zero, hmfi]
    rw [List.getElem?_eq_getElem (by omega), List.getElem?_eq_getElem (by omega)]
    simp only [Option.map_some]
    have h1 := hpar t hge htle
    simp only [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (show t < col.length by omega),
      List.getElem?_eq_getElem (show m.j < col.length by omega), Option.getD_some] at h1
    rw [h1]

/-! #### stacks and edges -/

theorem onStack_bwdC (m : Move) {a o : ColAddr} (h : a.OnStack o) : (bwdC m a).OnStack (bwdC m o) := by
  rcases h with ⟨k, ck, ik, hk, hp, hc⟩ | ⟨hp, hc⟩
  · left
    have := mapPath_getElem_fst m.bwdIdx m a.path k
    rw [hk] at this
    obtain ⟨⟨ck', ik'⟩, h1, h2⟩ := Option.map_eq_some_iff.1 this
    simp only at h2; subst h2
    exact ⟨k, ck', ik', h1, by simp only [bwdC]; rw [hp, mapPath_take], hc⟩
  · right; exact ⟨by simp only [bwdC]; rw [hp], hc⟩

theorem onStack_of_bwdC (m : Move) {a o : ColAddr} (h : (bwdC m a).OnStack o) :
    ∃ o', a.OnStack o' ∧ bwdC m o' = o := by
  rcases h with ⟨k, ck, ik, hk, hp, hc⟩ | ⟨hp, hc⟩
  · have := mapPath_getElem_fst m.bwdIdx m a.path k
    simp only [bwdC] at hk hp
    rw [hk] at this
    obtain ⟨⟨ck', ik'⟩, h1, h2⟩ := Option.map_eq_some_iff.1 this.symm
    simp only at h2; subst h2
    refine ⟨⟨a.path.take k, o.col⟩, Or.inl ⟨k, ck', ik', h1, rfl, hc⟩, ?_⟩
    simp only [bwdC]; rw [← mapPath_take, ← hp]
  · simp only [bwdC] at hp hc
    refine ⟨⟨a.path, o.col⟩, Or.inr ⟨rfl, hc⟩, ?_⟩
    simp only [bwdC]; rw [← hp]

theorem resolve_bwdC (m : Move) (a : ColAddr) (x : Nat) :
    (bwdC m a).resolve 0 x = (a.resolve 0 x).map (bwdC m) := by
  cases h : a.resolve 0 x with
  | some o' =>
    obtain ⟨hs, hn⟩ := (ColAddr.resolve_spec 0 a o' x).1 h
    exact (ColAddr.resolve_spec 0 _ _ x).2 ⟨onStack_bwdC m hs, by rw [num_bwdC]; exact hn⟩
  | none =>
    cases h' : (bwdC m a).resolve 0 x with
    | none => rfl
    | some o =>
      exfalso
      obtain ⟨hs, hn⟩ := (ColAddr.resolve_spec 0 _ o x).1 h'
      obtain ⟨o', hs', rfl⟩ := onStack_of_bwdC m hs
      rw [num_bwdC] at hn
      rw [(ColAddr.resolve_spec 0 a o' x).2 ⟨hs', hn⟩] at h
      simp at h

theorem onStack_colAt {E : Forest} {a o : ColAddr} (ha : (E.colAt a).isSome) (h : a.OnStack o) :
    (E.colAt o).isSome := by
  obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ha
  rcases h with ⟨k, ck, ik, hk, hp, hc⟩ | ⟨hp, hc⟩
  · have hkl : k < a.path.length := (List.getElem?_eq_some_iff.1 hk).1
    have hsplit : a.path = a.path.take k ++ (ck, ik) :: a.path.drop (k + 1) := by
      conv_lhs => rw [path_split_at hkl]
      rw [(List.getElem?_eq_some_iff.1 hk).2]
    simp only [Tree.colAt, Option.bind_eq_some_iff] at hcol
    obtain ⟨F, hF, -⟩ := hcol
    rw [hsplit, forestAt_through_col] at hF
    obtain ⟨y, hy, -⟩ := Option.bind_eq_some_iff.1 hF
    obtain ⟨colk, hcolk, -⟩ := Option.bind_eq_some_iff.1 hy
    simp only [Tree.colAt, Option.bind_eq_some_iff] at hcolk
    obtain ⟨G, hG, hGc⟩ := hcolk
    have hckl : ck < G.cols.length := (List.getElem?_eq_some_iff.1 hGc).1
    simp only [Tree.colAt, hp, hG, Option.bind_some]
    exact Option.isSome_iff_exists.2 ⟨_, List.getElem?_eq_getElem (by omega)⟩
  · simp only [Tree.colAt, Option.bind_eq_some_iff] at hcol
    obtain ⟨F, hF, hFc⟩ := hcol
    have hcl : a.col < F.cols.length := (List.getElem?_eq_some_iff.1 hFc).1
    simp only [Tree.colAt, hp, hF, Option.bind_some]
    exact Option.isSome_iff_exists.2 ⟨_, List.getElem?_eq_getElem (by omega)⟩

theorem resp_corr {K : Forest} {m : Move} (hm : MoveOK K m) {col : Column}
    (hcol : K.colAt m.col = some col) (hij : m.i < m.j) (hj : m.j + 1 = col.length)
    (hpar : ∀ x, m.i ≤ x → x ≤ m.j → (col.getD x (0, Tree.empty)).1 = (col.getD m.j (0, Tree.empty)).1)
    {o : ColAddr} (ho : ((applyMove K m).colAt o).isSome) {W : List (WithTop Key)}
    (hW : ∀ y ∈ W, y ≠ ⊤) :
    resp (applyMove K m) (capKeys (applyMove K m) (routeCols (applyMove K m))) o W =
      resp K (capKeys K (routeCols K)) (bwdC m o) W := by
  have hj' : m.j < col.length := by omega
  by_cases hom : o = m.col
  · subst hom
    obtain ⟨h1, h2⟩ := capKeys_moved hm hcol hij hj
    have hK' : (applyMove K m).colAt m.col = some (moveFun m col) := by
      rw [applyMove_eq_mod hcol hij hj', colAt_mod_self, hcol]; rfl
    simp only [resp, bwdC_col, hK', hcol, Option.getD_some, h1, h2]
    exact resp_moved_eq hij hj hpar _ (by simp) W hW
  · obtain ⟨col', hcol'⟩ := Option.isSome_iff_exists.1 ho
    obtain ⟨col0, hcol0, -, hcorr⟩ := colAt_mod_corr hcol hij hj' hcol'
    obtain ⟨hlab, -⟩ := hcorr hom
    simp only [resp, hcol', hcol0, Option.getD_some]
    rw [capKeys_corr hm hcol hij hj ho hom, ← List.getElem?_map, ← List.getElem?_map, hlab]

theorem edge_corr {K : Forest} {m : Move} (hm : MoveOK K m) {col : Column}
    (hcol : K.colAt m.col = some col) (hij : m.i < m.j) (hj : m.j + 1 = col.length)
    (hpar : ∀ x, m.i ≤ x → x ≤ m.j → (col.getD x (0, Tree.empty)).1 = (col.getD m.j (0, Tree.empty)).1)
    {a : ColAddr} (ha : ((applyMove K m).colAt a).isSome) {W : List (WithTop Key)}
    (hW : ∀ y ∈ W, y ≠ ⊤) {x y : Nat} (h : Edge K (capKeys K (routeCols K)) (bwdC m a) W x y) :
    Edge (applyMove K m) (capKeys (applyMove K m) (routeCols (applyMove K m))) a W x y := by
  obtain ⟨o, ho, hr⟩ := h
  rw [resolve_bwdC] at ho
  obtain ⟨o', ho', rfl⟩ := Option.map_eq_some_iff.1 ho
  have hst := ((ColAddr.resolve_spec 0 a o' x).1 ho').1
  exact ⟨o', ho', by rw [resp_corr hm hcol hij hj hpar (onStack_colAt ha hst) hW]; exact hr⟩

theorem mapPath_snoc (g : Nat → Nat) (m : Move) (π : List (Nat × Nat)) (x : Nat × Nat)
    (h : ¬ (π = m.col.path ∧ x.1 = m.col.col)) :
    m.mapPath g (π ++ [x]) = m.mapPath g π ++ [x] := by
  rcases mapPath_cases m (π ++ [x]) with ⟨e, D, hD⟩ | hoff
  · rcases List.eq_nil_or_concat' D with rfl | ⟨D', y, rfl⟩
    · exfalso; apply h
      obtain ⟨h1, h2⟩ := List.append_inj' hD rfl
      simp only [List.cons.injEq, and_true] at h2
      exact ⟨h1, by rw [h2]⟩
    · have : π ++ [x] = (m.col.path ++ (m.col.col, e) :: D') ++ [y] := by rw [hD]; simp
      obtain ⟨h1, h2⟩ := List.append_inj' this rfl
      simp only [List.cons.injEq, and_true] at h2
      subst h2; subst h1
      rw [List.append_assoc, List.cons_append, mapPath_through, mapPath_through]; simp
  · rw [mapPath_off g m _ hoff, mapPath_off g m π (fun e D hD => hoff e (D ++ [x]) (by rw [hD]; simp))]

theorem heightPath_bwd {m : Move} (e : EntryAddr) :
    ∃ idx0, m.mapPath m.bwdIdx e.heightPath = (bwdC m e.col).path ++ [((bwdC m e.col).col, idx0)] := by
  by_cases h : e.col.path = m.col.path ∧ e.col.col = m.col.col
  · refine ⟨m.bwdIdx e.idx, ?_⟩
    simp only [EntryAddr.heightPath, bwdC]
    rw [h.1, h.2]
    have := mapPath_through m.bwdIdx m e.idx []
    rw [this, mapPath_off _ _ _ (fun e D he => by have := congrArg List.length he; simp at this)]
  · refine ⟨e.idx, ?_⟩
    simp only [EntryAddr.heightPath, bwdC]
    exact mapPath_snoc _ _ _ _ h

-- L3.1g (txt:289-293): a legal move keeps every decorated response, hence decorated A
theorem decoratedA_applyMove {K : Forest} {m : Move} (hm : MoveOK K m) (hV : CondV K)
    (hA : CondAK K (capKeys K (routeCols K))) :
    CondV (applyMove K m) ∧ (CondI K → CondI (applyMove K m)) ∧
      CondAK (applyMove K m) (capKeys (applyMove K m) (routeCols (applyMove K m))) := by
  have hm' := hm
  obtain ⟨col, sd, hcol, -, hj, hij, -, hpar, -, -⟩ := hm'
  have hj' : m.j < col.length := by omega
  have hK' : (applyMove K m).colAt m.col = some (moveFun m col) := by
    rw [applyMove_eq_mod hcol hij hj', colAt_mod_self, hcol]; rfl
  have hmfl : (moveFun m col).length = m.i + 1 := by
    simp only [moveFun, List.length_append, List.length_take, List.length_drop]; omega
  have hmf : ∀ x, x < m.i → (moveFun m col)[x]? = col[x]? := by
    intro x hx
    simp only [moveFun]
    rw [List.getElem?_append_left (by simp; omega), List.getElem?_take_of_lt hx]
  have hmfi : (moveFun m col)[m.i]? = col[m.j]? := by
    rw [moveFun, getElem?_moveFun m col hij.le hj'.le]
    unfold Move.bwdIdx; rw [if_pos le_rfl]; congr 1; omega
  have hparj : ∀ x, m.i ≤ x → x ≤ m.j → ∀ z, col[x]? = some z → z.1 = (col.getD m.j (0, Tree.empty)).1 := by
    intro x h1 h2 z hz
    have := hpar x h1 h2
    simp only [List.getD_eq_getElem?_getD, hz, Option.getD_some] at this
    simpa [List.getD_eq_getElem?_getD] using this
  refine ⟨?_, ?_, ?_⟩
  · -- V
    rw [condV_iff_lt] at hV ⊢
    intro e he p h hep
    obtain ⟨col', hcol', hidx⟩ := Tree.colAt_of_entryAt hep
    obtain ⟨col0, hcol0, hmc, hnc⟩ := colAt_mod_corr hcol hij hj' hcol'
    by_cases hem : e.col = m.col
    · obtain ⟨rfl, -⟩ := hmc hem
      rw [moveFun, getElem?_moveFun m col hij.le hj'.le] at hidx
      have hKe : K.entryAt ⟨m.col, m.bwdIdx e.idx⟩ = some (p, h) := by
        simp only [Tree.entryAt, hcol, Option.bind_some]; exact hidx
      have := hV _ ((Tree.mem_entryAddrs_iff _ _).2 (by rw [hKe]; rfl)) p h hKe
      rw [hem]; exact this
    · obtain ⟨hlab, -⟩ := hnc hem
      have h1 := congrArg (·[e.idx]?) hlab
      simp only [List.getElem?_map, hidx, Option.map_some] at h1
      obtain ⟨⟨p0, h0⟩, h2, h3⟩ := Option.map_eq_some_iff.1 h1.symm
      simp only at h3; subst h3
      have hKe : K.entryAt ⟨bwdC m e.col, e.idx⟩ = some (p0, h0) := by
        simp only [Tree.entryAt, hcol0, Option.bind_some]; exact h2
      have := hV _ ((Tree.mem_entryAddrs_iff _ _).2 (by rw [hKe]; rfl)) p0 h0 hKe
      rw [num_bwdC] at this; exact this
  · -- I
    intro hI e he p h' hep hne col'' hcol''
    have hH' : (applyMove K m).forestAt e.heightPath = some h' := by
      rw [Tree.forestAt_heightPath, heightAt_of_entryAt hep]
    rw [applyMove_eq_mod hcol hij hj'] at hH'
    obtain ⟨G, hG, hlen, hcorr⟩ := forestAt_mod_corr hcol hij hj' _ _ hH'
    obtain ⟨idx0, hidx0⟩ := heightPath_bwd (m := m) e
    let e₀ : EntryAddr := ⟨bwdC m e.col, idx0⟩
    have hhp : e₀.heightPath = m.mapPath m.bwdIdx e.heightPath := by rw [hidx0]; rfl
    have hKh : K.heightAt e₀ = some G := by rw [← Tree.forestAt_heightPath, hhp]; exact hG
    obtain ⟨⟨p₀, G₀⟩, hKe, hG₀⟩ := Option.map_eq_some_iff.1 hKh
    simp only at hG₀; subst hG₀
    have hGne : G₀ ≠ Tree.empty := by
      intro hG0; apply hne
      obtain ⟨cs⟩ := h'
      subst hG0
      cases cs with
      | nil => rfl
      | cons c cs => simp [Tree.empty, Tree.cols] at hlen
    obtain ⟨c'', hc''⟩ := List.mem_iff_getElem?.1 hcol''
    by_cases hP : e.heightPath = m.col.path ∧ c'' = m.col.col
    · -- the moved column itself
      have hGc : G₀.cols[m.col.col]? = some col := by
        have hb : m.mapPath m.bwdIdx e.heightPath = m.col.path := by
          rw [hP.1, mapPath_off _ _ _ (fun e D he => by have := congrArg List.length he; simp at this)]
        rw [hb] at hG
        simp only [Tree.colAt, hG, Option.bind_some] at hcol; exact hcol
      have h'c : h'.cols[m.col.col]? = some (moveFun m col) := by
        have := hK'
        rw [applyMove_eq_mod hcol hij hj'] at this
        have hH'' := hH'
        rw [hP.1] at hH''
        simp only [Tree.colAt, hH'', Option.bind_some] at this; exact this
      rw [hP.2, h'c] at hc''
      obtain rfl := Option.some.inj hc''
      obtain ⟨q, H, rest, hcq, hq⟩ := hI e₀ ((Tree.mem_entryAddrs_iff _ _).2 (by rw [hKe]; rfl)) p₀ G₀ hKe
        hGne col (List.mem_of_getElem? hGc)
      rw [show e₀.col.num 0 = e.col.num 0 from num_bwdC m e.col 0] at hq
      by_cases hi0 : m.i = 0
      · obtain ⟨z, hz⟩ : ∃ z, (moveFun m col)[0]? = some z := by
          cases h : (moveFun m col)[0]? with
          | none => rw [List.getElem?_eq_none_iff] at h; omega
          | some z => exact ⟨z, rfl⟩
        have hz' := hz
        rw [← hi0, hmfi] at hz'
        have h1 := hparj m.j (by omega) le_rfl z hz'
        have h2 := hparj 0 (by omega) (by omega) (q, H) (by rw [hcq]; rfl)
        cases hmc : moveFun m col with
        | nil => simp [hmc] at hmfl
        | cons y ys =>
          rw [hmc] at hz; simp at hz; subst hz
          exact ⟨y.1, y.2, ys, rfl, by simp at h1 h2; omega⟩
      · have h0 : (moveFun m col)[0]? = some (q, H) := by rw [hmf 0 (by omega), hcq]; rfl
        cases hmc : moveFun m col with
        | nil => simp [hmc] at hmfl
        | cons y ys =>
          rw [hmc] at h0; simp at h0; subst h0
          exact ⟨q, H, ys, rfl, hq⟩
    · obtain ⟨hlab, -⟩ := hcorr c'' hP
      rw [hc''] at hlab
      obtain ⟨colG, hcolG, hlG⟩ := Option.map_eq_some_iff.1 hlab.symm
      obtain ⟨q, H, rest, hcq, hq⟩ := hI e₀ ((Tree.mem_entryAddrs_iff _ _).2 (by rw [hKe]; rfl)) p₀ G₀ hKe
        hGne colG (List.mem_of_getElem? hcolG)
      rw [show e₀.col.num 0 = e.col.num 0 from num_bwdC m e.col 0] at hq
      cases col'' with
      | nil => subst hcq; simp at hlG
      | cons y ys =>
        subst hcq
        simp only [List.map_cons, List.cons.injEq] at hlG
        exact ⟨y.1, y.2, ys, rfl, by rw [← hlG.1]; exact hq⟩
  · -- decorated A
    intro a ha t y hy
    have ham : ((applyMove K m).colAt a).isSome := (Tree.mem_colAddrs_iff _ _).1 ha
    obtain ⟨col', hcol'⟩ := Option.isSome_iff_exists.1 ham
    obtain ⟨col0, hcol0, hmc, hnc⟩ := colAt_mod_corr hcol hij hj' hcol'
    have hbm : bwdC m a ∈ K.colAddrs := (Tree.mem_colAddrs_iff _ _).2 (by rw [hcol0]; rfl)
    have htr : ∀ W : List (WithTop Key), (∀ z ∈ W, z ≠ ⊤) → ∀ x z,
        Path K (capKeys K (routeCols K)) (bwdC m a) W x z →
        Path (applyMove K m) (capKeys (applyMove K m) (routeCols (applyMove K m))) a W x z :=
      by
        intro W hW x z h
        induction h with
        | refl => exact Relation.ReflTransGen.refl
        | tail _ he ih => exact ih.tail (edge_corr hm hcol hij hj hpar ham hW he)
    have hcoe : ∀ (L : List (Nat × Forest)) (b : Nat) (s : Nat), ∀ z ∈ cutQuery
        (L.map fun x => ((relKey b x.2 : Key) : WithTop Key)) s, z ≠ ⊤ := by
      intro L b s
      apply cutQuery_mem
      intro z hz; simp only [List.mem_map] at hz; obtain ⟨_, -, rfl⟩ := hz; exact WithTop.coe_ne_top
    by_cases ham' : a = m.col
    · subst ham'
      obtain ⟨hc1, -⟩ := hmc rfl
      subst hc1
      rw [bwdC_col] at htr hbm
      obtain ⟨h1, h2⟩ := capKeys_moved hm hcol hij hj
      simp only [parents, hcol', Option.getD_some, List.getElem?_map] at hy
      have ht : t ≤ m.i := by
        have := (List.getElem?_eq_some_iff.1 (Option.map_eq_some_iff.1 hy).choose_spec.1).1; omega
      set L := col.map fun x => ((relKey (m.col.num 0) x.2 : Key) : WithTop Key) with hLdef
      have hLl : L.length = col.length := by simp [hLdef]
      have hq : cutQuery (L.take m.i ++ [⊤]) t = cutQuery (L.take m.j ++ [⊤]) t := by
        simp only [cutQuery]
        rw [List.take_append_of_le_length (by simp; omega), List.take_append_of_le_length (by simp; omega),
          List.take_take, List.take_take, Nat.min_eq_left ht, Nat.min_eq_left (by omega)]
      have hq' : cutQuery (L.take m.j ++ [⊤]) t = cutQuery L t := by
        simp only [cutQuery]
        rw [List.take_append_of_le_length (by simp; omega), List.take_take, Nat.min_eq_left (by omega)]
      have hyK : (parents K m.col)[t]? = some y := by
        simp only [parents, hcol, Option.getD_some, List.getElem?_map]
        rcases Nat.lt_or_eq_of_le ht with hlt | hti
        · rw [← hmf t hlt]; exact hy
        · subst hti
          rw [hmfi] at hy
          obtain ⟨z, hz, rfl⟩ := Option.map_eq_some_iff.1 hy
          obtain ⟨w, hw⟩ : ∃ w, col[m.i]? = some w := ⟨_, List.getElem?_eq_getElem (by omega)⟩
          rw [hw]
          have e1 := hparj m.i le_rfl (by omega) w hw
          have e2 := hparj m.j (by omega) le_rfl z hz
          simp only [Option.map_some, Option.some.injEq]; rw [e1, e2]
      have hP := hA m.col hbm t y hyK
      rw [h1, hq'] at hP
      rw [h2, hq, hq']
      have hstart : (if t = 0 then m.col.num 0 - 1 else ((parents (applyMove K m) m.col)[t - 1]?).getD 0) =
          (if t = 0 then m.col.num 0 - 1 else ((parents K m.col)[t - 1]?).getD 0) := by
        split_ifs with h0
        · rfl
        · simp only [parents, hcol', hcol, Option.getD_some, List.getElem?_map]
          rw [hmf (t - 1) (by omega)]
      rw [hstart]
      exact htr _ (hcoe col _ t) _ _ hP
    · obtain ⟨hlab, -⟩ := hnc ham'
      have hpe : parents (applyMove K m) a = parents K (bwdC m a) := by
        simp only [parents, hcol', hcol0, Option.getD_some, hlab]
      rw [hpe] at hy ⊢
      rw [capKeys_corr hm hcol hij hj ham ham']
      have hP := hA (bwdC m a) hbm t y hy
      rw [num_bwdC] at hP
      have htl : t < col0.length := by
        have := (List.getElem?_eq_some_iff.1 hy).1; simpa [parents, hcol0] using this
      have hW : ∀ z ∈ cutQuery (capKeys K (routeCols K) (bwdC m a)) t, z ≠ ⊤ := by
        rw [cutQuery_capKeys K _ _ (by rw [hcol0]; exact htl)]
        simp only [actualKeys, hcol0, Option.getD_some]
        exact hcoe col0 _ t
      exact htr _ hW _ _ hP


/-! ### L3.1h helpers -/

theorem mod_litCapAux (k p jj cc i j : Nat) (rest : List (Nat × Nat)) (hij : i < j) :
    ∀ (P : List (Nat × Nat)) (F : Forest) (Fcol : Column) (q : Nat) (Hi Hj : Forest),
      F.colAt ⟨P, cc⟩ = some Fcol → Fcol[i]? = some (q, Hi) → Fcol[j]? = some (q, Hj) →
      litCapAux k p rest jj Hj = litCapAux k p rest jj Hi →
      modifyColAux (fun col => col.take i ++ col.drop j) P cc
          (litCapAux k p (P ++ (cc, j) :: rest) jj F) =
        litCapAux k p (P ++ (cc, i) :: rest) jj F
  | [], .node cols, Fcol, q, Hi, Hj, hcol, hi, hj, hC => by
    rw [colAt_node_nil] at hcol
    have hcc : cc < cols.length := (List.getElem?_eq_some_iff.1 hcol).1
    have hjl : j < Fcol.length := (List.getElem?_eq_some_iff.1 hj).1
    have hgj : (cols.getD cc [])[j]? = some (q, Hj) := by
      rw [List.getD_eq_getElem?_getD, hcol, Option.getD_some]; exact hj
    have hgi : (cols.getD cc [])[i]? = some (q, Hi) := by
      rw [List.getD_eq_getElem?_getD, hcol, Option.getD_some]; exact hi
    simp only [List.nil_append]
    rw [litCapAux_cons k p cc j jj rest cols hgj, litCapAux_cons k p cc i jj rest cols hgi]
    simp only [modifyColAux]
    have hl : (cols.take cc).length = cc := List.length_take_of_le hcc.le
    have hm := list_modify_snoc (cols.take cc)
      ((cols.getD cc []).take j ++ [(q, litCapAux k p rest jj Hj)]) (fun col => col.take i ++ col.drop j)
    rw [hl] at hm
    rw [hm, List.getD_eq_getElem?_getD, hcol, Option.getD_some, hC]
    congr 3
    have hl2 : (Fcol.take j).length = j := List.length_take_of_le hjl.le
    rw [List.take_append_of_le_length (by omega), List.take_take, Nat.min_eq_left hij.le,
      List.drop_left' hl2]
  | (a, b) :: P, .node cols, Fcol, q, Hi, Hj, hcol, hi, hj, hC => by
    rw [colAt_node_cons] at hcol
    obtain ⟨x, hx, hcolx⟩ := Option.bind_eq_some_iff.1 hcol
    obtain ⟨colc, hc, hx'⟩ := Option.bind_eq_some_iff.1 hx
    obtain ⟨q', H'⟩ := x
    have hci : a < cols.length := (List.getElem?_eq_some_iff.1 hc).1
    have hei : b < colc.length := (List.getElem?_eq_some_iff.1 hx').1
    have hget : (cols.getD a [])[b]? = some (q', H') := by
      rw [List.getD_eq_getElem?_getD, hc, Option.getD_some]; exact hx'
    simp only [List.cons_append]
    rw [litCapAux_cons k p a b jj _ cols hget, litCapAux_cons k p a b jj _ cols hget]
    simp only [modifyColAux]
    have hl : (cols.take a).length = a := List.length_take_of_le hci.le
    have hl' : ((cols.getD a []).take b).length = b := by
      rw [List.getD_eq_getElem?_getD, hc, Option.getD_some]; exact List.length_take_of_le hei.le
    have hm := list_modify_snoc (cols.take a)
      ((cols.getD a []).take b ++ [(q', litCapAux k p (P ++ (cc, j) :: rest) jj H')])
      (fun col => col.modify b fun x => (x.1, modifyColAux (fun col => col.take i ++ col.drop j) P cc x.2))
    rw [hl] at hm
    rw [hm]
    have hm' := list_modify_snoc ((cols.getD a []).take b) (q', litCapAux k p (P ++ (cc, j) :: rest) jj H')
      (fun x => (x.1, modifyColAux (fun col => col.take i ++ col.drop j) P cc x.2))
    rw [hl'] at hm'
    rw [hm']
    try simp only
    rw [mod_litCapAux k p jj cc i j rest hij P H' Fcol q Hi Hj hcolx hi hj hC]

theorem colAt_through {E : Forest} {P rest : List (Nat × Nat)} {cc b j : Nat} {col : Column}
    (h : E.colAt ⟨P ++ (cc, b) :: rest, j⟩ = some col) :
    ∃ Ecol q H, E.colAt ⟨P, cc⟩ = some Ecol ∧ Ecol[b]? = some (q, H) ∧ H.colAt ⟨rest, j⟩ = some col := by
  simp only [Tree.colAt] at h
  rw [forestAt_through_col] at h
  obtain ⟨G, hG, hGc⟩ := Option.bind_eq_some_iff.1 h
  obtain ⟨x, hx, hxG⟩ := Option.bind_eq_some_iff.1 hG
  obtain ⟨Ecol, hE, hEx⟩ := Option.bind_eq_some_iff.1 hx
  exact ⟨Ecol, x.1, x.2, hE, hEx, by simp only [Tree.colAt, hxG, Option.bind_some]; exact hGc⟩

theorem colAt_through_of {E : Forest} {P rest : List (Nat × Nat)} {cc b j : Nat} {Ecol : Column}
    {q : Nat} {H : Forest} (hE : E.colAt ⟨P, cc⟩ = some Ecol) (hb : Ecol[b]? = some (q, H)) :
    E.colAt ⟨P ++ (cc, b) :: rest, j⟩ = H.colAt ⟨rest, j⟩ := by
  simp only [Tree.colAt]
  rw [forestAt_through_col, hE]
  simp only [Option.bind_some, hb]

/-- helper (L3.1h): one legal move of an upward literal cap of an `H`-expression gives the literal
cap at the relocated column. -/
theorem litCap_move_step {E : Forest} (hH : CondH E) {cs : ColAddr} {k p : Nat}
    (hup : IsUpward E cs k p) {m : Move} (hm : MoveOK (litCap E cs k p) m) :
    ∃ rest, cs.path = m.col.path ++ (m.col.col, m.j) :: rest ∧
      IsUpward E ⟨m.col.path ++ (m.col.col, m.i) :: rest, cs.col⟩ k p ∧
      applyMove (litCap E cs k p) m = litCap E ⟨m.col.path ++ (m.col.col, m.i) :: rest, cs.col⟩ k p ∧
      ((E.colAt ⟨m.col.path ++ (m.col.col, m.i) :: rest, cs.col⟩).getD []).take k =
        ((E.colAt cs).getD []).take k := by
  obtain ⟨col0, hcol0, hk0, hq0⟩ := isUpward_iff_exists.1 hup
  obtain ⟨col, sd, hcolK, hsd, hj, hij, hpre, hpar, hlt, -⟩ := hm
  rw [stopData_litCap' hcol0] at hsd
  obtain rfl := Option.some.inj hsd
  obtain ⟨rest, hrest⟩ := hpre
  simp only [EntryAddr.heightPath, List.append_assoc, List.singleton_append] at hrest
  refine ⟨rest, hrest.symm, ?_⟩
  set P := m.col.path
  set cc := m.col.col
  have hcs : cs = ⟨P ++ (cc, m.j) :: rest, cs.col⟩ := by rw [hrest]
  have hcol0' := hcol0
  rw [hcs] at hcol0'
  obtain ⟨Ecol, qj, Hj, hEcol, hEj, hHj⟩ := colAt_through hcol0'
  -- the cap's column at the move
  have hKcol : (litCap E cs k p).colAt m.col = some (Ecol.take m.j ++ [(qj, litCapAux k p rest cs.col Hj)]) := by
    rw [litCap_eq_aux hcol0]
    simp only [Tree.colAt] at hEcol ⊢
    have hpreP : P <+: cs.path := ⟨(cc, m.j) :: rest, hrest⟩
    rw [forestAt_litCapAux_prefix k p cs.col cs.path P E hpreP ⟨col0, hcol0⟩]
    obtain ⟨G, hG, hGc⟩ := Option.bind_eq_some_iff.1 hEcol
    rw [hG]
    have hdrop : cs.path.drop P.length = (cc, m.j) :: rest := by rw [← hrest]; simp
    obtain ⟨gcols⟩ := G
    have hget : (gcols.getD cc [])[m.j]? = some (qj, Hj) := by
      simp only [Tree.cols] at hGc; rw [List.getD_eq_getElem?_getD, hGc, Option.getD_some]; exact hEj
    simp only [Option.map_some, Option.bind_some, hdrop]
    rw [litCapAux_cons k p cc m.j cs.col rest gcols hget]
    simp only [Tree.cols] at hGc ⊢
    have hci : cc < gcols.length := (List.getElem?_eq_some_iff.1 hGc).1
    rw [list_getElem?_take_snoc _ _ _ hci.le, if_neg (lt_irrefl _), if_pos rfl]
    all_goals simp [List.getD_eq_getElem?_getD, hGc]
  have hcolK' : (litCap E cs k p).colAt m.col = some col := hcolK
  rw [hKcol] at hcolK'
  obtain rfl := Option.some.inj hcolK'
  have hjE : m.j < Ecol.length := (List.getElem?_eq_some_iff.1 hEj).1
  have hlen : (Ecol.take m.j ++ [(qj, litCapAux k p rest cs.col Hj)]).length = m.j + 1 := by
    simp [List.length_take_of_le hjE.le]
  have hgetK : ∀ x, x < m.j → (Ecol.take m.j ++ [(qj, litCapAux k p rest cs.col Hj)]).getD x (0, Tree.empty) =
      Ecol.getD x (0, Tree.empty) := by
    intro x hx
    simp only [List.getD_eq_getElem?_getD]
    rw [List.getElem?_append_left (by simp; omega), List.getElem?_take_of_lt hx]
  have hgetKj : (Ecol.take m.j ++ [(qj, litCapAux k p rest cs.col Hj)]).getD m.j (0, Tree.empty) =
      (qj, litCapAux k p rest cs.col Hj) := by
    simp only [List.getD_eq_getElem?_getD]
    rw [List.getElem?_append_right (by simp)]; simp [List.length_take_of_le hjE.le]
  -- entries i … j of E share the parent qj
  have hparE : ∀ x, m.i ≤ x → x < m.j → (Ecol.getD x (0, Tree.empty)).1 = qj := by
    intro x h1 h2
    have := hpar x h1 h2.le
    rw [hgetK x h2, hgetKj] at this; exact this
  obtain ⟨qi, Hi, hEi⟩ : ∃ qi Hi, Ecol[m.i]? = some (qi, Hi) := by
    cases h : Ecol[m.i]? with
    | none => have := List.getElem?_eq_none_iff.1 h; omega
    | some x => exact ⟨x.1, x.2, rfl⟩
  have hqi : qi = qj := by
    have := hparE m.i le_rfl hij
    simp only [List.getD_eq_getElem?_getD, hEi, Option.getD_some] at this; exact this
  subst hqi
  have hltE : Hi < litCapAux k p rest cs.col Hj := by
    have := hlt
    rw [hgetK m.i hij, hgetKj] at this
    simpa [List.getD_eq_getElem?_getD, hEi] using this
  -- H gives `Hj ≤ Hi`
  have hmemc : m.col ∈ E.colAddrs := (Tree.mem_colAddrs_iff E m.col).2 (by
    show (E.colAt ⟨P, cc⟩).isSome; rw [hEcol]; rfl)
  have hchain : ∀ n, m.i + n ≤ m.j → Hj ≤ (Ecol.getD (m.j - n) (0, Tree.empty)).2 := by
    intro n
    induction n with
    | zero => intro _; simp [List.getD_eq_getElem?_getD, hEj]
    | succ n ih =>
      intro hn
      have h1 := ih (by omega)
      have hx : Ecol[m.j - (n + 1)]? = some (Ecol.getD (m.j - (n + 1)) (0, Tree.empty)) := by
        rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (by omega)]; simp
      have hy : Ecol[m.j - (n + 1) + 1]? = some (Ecol.getD (m.j - n) (0, Tree.empty)) := by
        rw [show m.j - (n + 1) + 1 = m.j - n by omega, List.getD_eq_getElem?_getD,
          List.getElem?_eq_getElem (by omega)]; simp
      have hle := hH m.col hmemc (m.j - (n + 1)) _ _ (by rw [show m.col = ⟨P, cc⟩ from rfl, hEcol]; exact hx)
        (by rw [show m.col = ⟨P, cc⟩ from rfl, hEcol]; exact hy)
      have hp1 : (Ecol.getD (m.j - (n + 1)) (0, Tree.empty)).1 = qi := hparE _ (by omega) (by omega)
      have hp2 : (Ecol.getD (m.j - n) (0, Tree.empty)).1 = qi := by
        rcases Nat.eq_zero_or_pos n with rfl | hn0
        · simp [List.getD_eq_getElem?_getD, hEj]
        · exact hparE _ (by omega) (by omega)
      rcases hle with h | ⟨-, h⟩
      · omega
      · exact le_trans h1 h
  have hHjHi : Hj ≤ Hi := by
    have := hchain (m.j - m.i) (by omega)
    rw [show m.j - (m.j - m.i) = m.i by omega] at this
    simpa [List.getD_eq_getElem?_getD, hEi] using this
  -- the interval fact inside the moved height
  have hupJ : IsUpward Hj ⟨rest, cs.col⟩ k p := isUpward_iff_exists.2 ⟨col0, hHj, hk0, hq0⟩
  obtain ⟨hupI, heq⟩ := interval_cap hupJ hHjHi (by rw [litCap_eq_aux hHj]; exact hltE)
  obtain ⟨colI, hcolI, hkI, hqI⟩ := isUpward_iff_exists.1 hupI
  have hEI : E.colAt ⟨P ++ (cc, m.i) :: rest, cs.col⟩ = some colI := by
    rw [colAt_through_of hEcol hEi]; exact hcolI
  refine ⟨isUpward_iff_exists.2 ⟨colI, hEI, hkI, hqI⟩, ?_, ?_⟩
  · rw [applyMove_eq_mod hKcol hij (by rw [hlen]; omega), litCap_eq_aux hcol0, litCap_eq_aux hEI]
    have hC : litCapAux k p rest cs.col Hj = litCapAux k p rest cs.col Hi := by
      rw [← litCap_eq_aux hHj, ← litCap_eq_aux hcolI, heq]
    have := mod_litCapAux k p cs.col cc m.i m.j rest hij P E Ecol qi Hi Hj hEcol hEi hEj hC
    rw [← hrest]
    exact this
  · rw [hEI, hcol0, Option.getD_some, Option.getD_some]
    have h1 := stopData_litCap' hcolI k p
    have h2 := stopData_litCap' hHj k p
    rw [heq, h2] at h1
    simp only [Option.some.injEq, StopData.mk.injEq] at h1
    exact h1.2.2.2.2.symm

-- L3.1h (txt:286-288, 294-295): after legal moves an upward literal cap of an `H`-expression is
-- again an upward literal cap of it, with the same cut, parent and internal cap
theorem applyMoves_litCap {E : Forest} (hH : CondH E) {c : ColAddr} {k p : Nat}
    (hup : IsUpward E c k p) {ms : List Move} (hms : MovesValid (litCap E c k p) ms) :
    ∃ c', IsUpward E c' k p ∧ applyMoves (litCap E c k p) ms = litCap E c' k p ∧
      ((E.colAt c').getD []).take k = ((E.colAt c).getD []).take k := by
  revert hms
  induction ms using List.reverseRecOn with
  | nil => intro _; exact ⟨c, hup, rfl, rfl⟩
  | append_singleton ms m ih =>
    intro hms
    obtain ⟨hv, hm⟩ := movesValid_append hms
    obtain ⟨c', hup', heq, htk⟩ := ih hv
    rw [applyMoves_snoc, heq]
    rw [heq] at hm
    obtain ⟨rest, -, hup'', hmove, htk'⟩ := litCap_move_step hH hup' hm
    exact ⟨_, hup'', hmove, htk'.trans htk⟩


/-! ### L3.1 helpers -/

/-- helper: the column of a literal cap at one of its containing columns. -/
theorem colAt_litCap_container {E : Forest} {cs : ColAddr} {col0 : Column}
    (hcol0 : E.colAt cs = some col0) {π rest : List (Nat × Nat)} {a e : Nat}
    (hpath : cs.path = π ++ (a, e) :: rest) (k p : Nat) :
    ∃ Ecol q H, E.colAt ⟨π, a⟩ = some Ecol ∧ Ecol[e]? = some (q, H) ∧
      H.colAt ⟨rest, cs.col⟩ = some col0 ∧
      (litCap E cs k p).colAt ⟨π, a⟩ = some (Ecol.take e ++ [(q, litCapAux k p rest cs.col H)]) := by
  have hcol0' : E.colAt ⟨π ++ (a, e) :: rest, cs.col⟩ = some col0 := by rw [← hpath]; exact hcol0
  obtain ⟨Ecol, q, H, hEcol, hEe, hH⟩ := colAt_through hcol0'
  refine ⟨Ecol, q, H, hEcol, hEe, hH, ?_⟩
  rw [litCap_eq_aux hcol0]
  simp only [Tree.colAt] at hEcol ⊢
  have hpreP : π <+: cs.path := ⟨(a, e) :: rest, hpath.symm⟩
  rw [forestAt_litCapAux_prefix k p cs.col cs.path π E hpreP ⟨col0, hcol0⟩]
  obtain ⟨G, hG, hGc⟩ := Option.bind_eq_some_iff.1 hEcol
  rw [hG]
  have hdrop : cs.path.drop π.length = (a, e) :: rest := by rw [hpath]; simp
  obtain ⟨gcols⟩ := G
  have hget : (gcols.getD a [])[e]? = some (q, H) := by
    simp only [Tree.cols] at hGc; rw [List.getD_eq_getElem?_getD, hGc, Option.getD_some]; exact hEe
  simp only [Option.map_some, Option.bind_some, hdrop]
  rw [litCapAux_cons k p a e cs.col rest gcols hget]
  simp only [Tree.cols] at hGc ⊢
  have hci : a < gcols.length := (List.getElem?_eq_some_iff.1 hGc).1
  rw [list_getElem?_take_snoc _ _ _ hci.le, if_neg (lt_irrefl _), if_pos rfl]
  all_goals simp [List.getD_eq_getElem?_getD, hGc]

theorem movesValid_snoc {K : Forest} {ms : List Move} {m : Move} (h : MovesValid K ms)
    (hm : MoveOK (applyMoves K ms) m) : MovesValid K (ms ++ [m]) := by
  intro idx hidx
  simp only [List.length_append, List.length_singleton] at hidx
  rcases Nat.lt_or_eq_of_le (Nat.lt_succ_iff.1 hidx) with hlt | rfl
  · rw [List.take_append_of_le_length hlt.le, List.getElem_append_left hlt]; exact h idx hlt
  · rw [List.take_left, List.getElem_append_right (by omega)]; simpa using hm

/-- helper: the columns of a literal cap: the cap column, a containing column (a prefix of the
original column followed by its containing entry with a new height), or an unchanged column. -/
theorem colAt_litCap_cases {E : Forest} {c : ColAddr} {col : Column} (hcol : E.colAt c = some col)
    {k : Nat} (hk : k ≤ col.length) (p : Nat) {a : ColAddr} {col' : Column}
    (h : (litCap E c k p).colAt a = some col') :
    (a = c ∧ col' = col.take k ++ [(p, Tree.empty)]) ∨
    (∃ e rest Ecol q H H', c.path = a.path ++ (a.col, e) :: rest ∧ E.colAt a = some Ecol ∧
      Ecol[e]? = some (q, H) ∧ col' = Ecol.take e ++ [(q, H')]) ∨
    E.colAt a = some col' := by
  obtain ⟨π, cc⟩ := a
  have h' := h
  rw [litCap_eq_aux hcol] at h
  simp only [Tree.colAt, Option.bind_eq_some_iff] at h
  obtain ⟨G', hG', hcc⟩ := h
  by_cases hpre : π <+: c.path
  · rw [forestAt_litCapAux_prefix k p c.col c.path π E hpre ⟨col, hcol⟩] at hG'
    obtain ⟨G, hG, rfl⟩ := Option.map_eq_some_iff.1 hG'
    obtain ⟨rest, hrest⟩ := hpre
    have hdrop : c.path.drop π.length = rest := by rw [← hrest]; simp
    rw [hdrop] at hcc
    have hEc : G.colAt ⟨rest, c.col⟩ = some col := by
      rw [← hcol]; simp only [Tree.colAt]; rw [← hrest, Tree.forestAt_append, hG]; rfl
    obtain ⟨gcols⟩ := G
    cases rest with
    | nil =>
      rw [colAt_node_nil] at hEc
      have hj : c.col < gcols.length := (List.getElem?_eq_some_iff.1 hEc).1
      simp only [List.append_nil] at hrest
      rw [litCapAux_nil] at hcc
      simp only [Tree.cols] at hcc
      rw [list_getElem?_take_snoc _ _ _ hj.le] at hcc
      split_ifs at hcc with h1 h2
      · right; right
        simp only [Tree.colAt, hG, Option.bind_some, Tree.cols, hcc]
      · subst h2
        left
        refine ⟨by subst hrest; rfl, ?_⟩
        obtain rfl := Option.some.inj hcc
        simp [List.getD_eq_getElem?_getD, hEc]
    | cons ce rest =>
      obtain ⟨ci, ei⟩ := ce
      rw [colAt_node_cons] at hEc
      obtain ⟨y, hy, hcoly⟩ := Option.bind_eq_some_iff.1 hEc
      obtain ⟨colc, hc, hy'⟩ := Option.bind_eq_some_iff.1 hy
      obtain ⟨q, H⟩ := y
      have hci : ci < gcols.length := (List.getElem?_eq_some_iff.1 hc).1
      have hget : (gcols.getD ci [])[ei]? = some (q, H) := by
        rw [List.getD_eq_getElem?_getD, hc, Option.getD_some]; exact hy'
      rw [litCapAux_cons k p ci ei c.col rest gcols hget] at hcc
      simp only [Tree.cols] at hcc
      rw [list_getElem?_take_snoc _ _ _ hci.le] at hcc
      split_ifs at hcc with h1 h2
      · right; right
        simp only [Tree.colAt, hG, Option.bind_some, Tree.cols, hcc]
      · subst h2
        right; left
        obtain rfl := Option.some.inj hcc
        refine ⟨ei, rest, colc, q, H, litCapAux k p rest c.col H, hrest.symm, ?_, hy', ?_⟩
        · simp only [Tree.colAt, hG, Option.bind_some, Tree.cols, hc]
        · simp [List.getD_eq_getElem?_getD, hc]
  · by_cases hcap : π = c.path ++ [(c.col, k)]
    · exfalso
      subst hcap
      rw [forestAt_through_col, show (⟨c.path, c.col⟩ : ColAddr) = c from rfl,
        colAt_litCapAux_self hcol k p] at hG'
      simp only [Option.bind_some, List.getElem?_append_right (by simp : (col.take k).length ≤ k),
        List.length_take_of_le hk, Nat.sub_self, List.getElem?_cons_zero, forestAt_nil_path,
        Option.some.injEq] at hG'
      subst hG'
      simp [Tree.empty, Tree.cols] at hcc
    · right; right
      have := forestAt_litCapAux_off k p c.col c.path π E G' ⟨col, hcol, hk⟩ hpre hcap hG'
      simp only [Tree.colAt, this, Option.bind_some, hcc]

/-- helper: at level `d` of the cap address, the containing entry is entry-ordered after its
predecessor in the cap. -/
def LastOK (K : Forest) (cs : ColAddr) (d : Nat) : Prop :=
  ∀ a e (x y : Nat × Forest), cs.path[d]? = some (a, e) →
    ((K.colAt ⟨cs.path.take d, a⟩).getD [])[e]? = some x →
    ((K.colAt ⟨cs.path.take d, a⟩).getD [])[e - 1]? = some y → 1 ≤ e → EntryLe x y

/-- helper: H for a literal cap of an H-expression whose containing entries and closing entry are
entry-ordered after their predecessors. -/
theorem condH_litCap {E : Forest} (hH : CondH E) {cs : ColAddr} {col : Column}
    (hcol : E.colAt cs = some col) {k p : Nat} (hk : k ≤ col.length)
    (hlast : ∀ d, d < cs.path.length → LastOK (litCap E cs k p) cs d)
    (hcap : 1 ≤ k → ∀ y, col[k - 1]? = some y → p ≤ y.1) : CondH (litCap E cs k p) := by
  intro a ha t x y hx hy
  obtain ⟨col', hcol'⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff _ _).1 ha)
  rw [hcol', Option.getD_some] at hx hy
  rcases colAt_litCap_cases hcol hk p hcol' with ⟨rfl, rfl⟩ | ⟨e, rest, Ecol, q, H, H', hpath, hEa, hEe, rfl⟩ | hEa
  · have hamem : a ∈ E.colAddrs := (Tree.mem_colAddrs_iff _ _).2 (by rw [hcol]; rfl)
    have hl : (col.take k).length = k := List.length_take_of_le hk
    by_cases ht : t + 1 < k
    · rw [List.getElem?_append_left (by omega), List.getElem?_take_of_lt (by omega)] at hx hy
      exact hH a hamem t x y (by rw [hcol]; exact hx) (by rw [hcol]; exact hy)
    · have ht' : t + 1 = k := by
        have := (List.getElem?_eq_some_iff.1 hy).1; simp at this; omega
      rw [List.getElem?_append_left (by omega), List.getElem?_take_of_lt (by omega)] at hx
      rw [List.getElem?_append_right (by omega), hl, ht', Nat.sub_self] at hy
      simp only [List.getElem?_cons_zero, Option.some.injEq] at hy
      subst hy
      have := hcap (by omega) x (by rw [show k - 1 = t by omega]; exact hx)
      rcases Nat.lt_or_eq_of_le this with h | h
      · exact Or.inl h
      · exact Or.inr ⟨h, empty_le_forest _⟩
  · have hamem : a ∈ E.colAddrs := (Tree.mem_colAddrs_iff _ _).2 (by rw [hEa]; rfl)
    have he : e < Ecol.length := (List.getElem?_eq_some_iff.1 hEe).1
    have hl : (Ecol.take e).length = e := List.length_take_of_le he.le
    by_cases ht : t + 1 < e
    · rw [List.getElem?_append_left (by omega), List.getElem?_take_of_lt (by omega)] at hx hy
      exact hH a hamem t x y (by rw [hEa]; exact hx) (by rw [hEa]; exact hy)
    · have ht' : t + 1 = e := by
        have := (List.getElem?_eq_some_iff.1 hy).1; simp at this; omega
      subst ht'
      have hd : a.path.length < cs.path.length := by rw [hpath]; simp
      have hpd : cs.path[a.path.length]? = some (a.col, t + 1) := by rw [hpath]; simp
      have htk : cs.path.take a.path.length = a.path := by rw [hpath]; simp
      have := hlast a.path.length hd a.col (t + 1) y x hpd
      rw [htk, show (⟨a.path, a.col⟩ : ColAddr) = a from rfl, hcol', Option.getD_some] at this
      exact this hy (by rw [show t + 1 - 1 = t by omega]; exact hx) (by omega)
  · have hamem : a ∈ E.colAddrs := (Tree.mem_colAddrs_iff _ _).2 (by rw [hEa]; rfl)
    exact hH a hamem t x y (by rw [hEa]; exact hx) (by rw [hEa]; exact hy)

theorem forestAt_applyMove_through {K : Forest} {m : Move} {col : Column}
    (hcol : K.colAt m.col = some col) (hij : m.i < m.j) (hj : m.j < col.length) (R : List (Nat × Nat)) :
    (applyMove K m).forestAt (m.col.path ++ (m.col.col, m.i) :: R) =
      K.forestAt (m.col.path ++ (m.col.col, m.j) :: R) := by
  rw [applyMove_eq_mod hcol hij hj, forestAt_modifyColAux_through, forestAt_through_col,
    show (⟨m.col.path, m.col.col⟩ : ColAddr) = m.col from rfl, hcol]
  simp only [Option.bind_some, moveFun]
  rw [getElem?_moveFun m col hij.le hj.le]
  have : m.bwdIdx m.i = m.j := by unfold Move.bwdIdx; rw [if_pos le_rfl]; omega
  rw [this]

/-- helper: parents of an A-column are nonincreasing between any two indices. -/
theorem parents_antitone_le {E : Forest} (hV : CondV E) {ks : KeySys} (hA : CondAK E ks)
    {b : ColAddr} {Ecol : Column} (hb : E.colAt b = some Ecol) :
    ∀ n x, x + n < Ecol.length → (Ecol.getD (x + n) (0, Tree.empty)).1 ≤ (Ecol.getD x (0, Tree.empty)).1 := by
  have hbm : b ∈ E.colAddrs := (Tree.mem_colAddrs_iff _ _).2 (by rw [hb]; rfl)
  intro n
  induction n with
  | zero => intro x _; exact le_refl _
  | succ n ih =>
    intro x hx
    have h1 := ih x (by omega)
    have h2 := parents_antitone hV hA hbm (i := x + n)
      (p := (Ecol.getD (x + n + 1) (0, Tree.empty)).1) (q := (Ecol.getD (x + n) (0, Tree.empty)).1)
      (by simp [parents, hb, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (show x + n + 1 < Ecol.length by omega)])
      (by simp [parents, hb, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (show x + n < Ecol.length by omega)])
    rw [show x + (n + 1) = x + n + 1 by omega]
    exact le_trans h2 h1

theorem getD_take_snoc_lt {Ecol : Column} {e x : Nat} (z : Nat × Forest) (he : e ≤ Ecol.length)
    (hx : x < e) : (Ecol.take e ++ [z]).getD x (0, Tree.empty) = Ecol.getD x (0, Tree.empty) := by
  simp only [List.getD_eq_getElem?_getD]
  rw [List.getElem?_append_left (by rw [List.length_take_of_le he]; exact hx), List.getElem?_take_of_lt hx]

theorem getD_take_snoc_self {Ecol : Column} {e : Nat} (z : Nat × Forest) (he : e ≤ Ecol.length) :
    (Ecol.take e ++ [z]).getD e (0, Tree.empty) = z := by
  simp only [List.getD_eq_getElem?_getD]
  rw [List.getElem?_append_right (by rw [List.length_take_of_le he]), List.length_take_of_le he]
  simp

theorem getElem?_eq_getD {Ecol : Column} {x : Nat} (hx : x < Ecol.length) :
    Ecol[x]? = some (Ecol.getD x (0, Tree.empty)) := by
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hx]; rfl

/-- helper: the invariant of the inside-out repair after the levels `≥ ℓ` are repaired. -/
def RepairState (E : Forest) (c : ColAddr) (k p ℓ : Nat) : Prop :=
  ∃ (ms : List Move) (cs : ColAddr), MovesValid (litCap E c k p) ms ∧
    applyMoves (litCap E c k p) ms = litCap E cs k p ∧ IsUpward E cs k p ∧
    ((E.colAt cs).getD []).take k = ((E.colAt c).getD []).take k ∧
    cs.path.length = c.path.length ∧ CondV (litCap E cs k p) ∧ CondI (litCap E cs k p) ∧
    CondAK (litCap E cs k p) (capKeys (litCap E cs k p) (routeCols (litCap E cs k p))) ∧
    ∀ d, ℓ ≤ d → d < cs.path.length → LastOK (litCap E cs k p) cs d

theorem repair_step {E : Forest} (hL : InL E) {c : ColAddr} {k p d : Nat} (hd : d < c.path.length)
    (h : RepairState E c k p (d + 1)) : RepairState E c k p d := by
  classical
  obtain ⟨ms, cs, hmv, heq, hup', htk, hlen, hV', hI', hA', hlast⟩ := h
  obtain ⟨col_s, hcol_s, hk_s, -⟩ := isUpward_iff_exists.1 hup'
  have hd' : d < cs.path.length := by omega
  obtain ⟨a, e, T, R, hTl, hsplit⟩ : ∃ a e T R, T.length = d ∧ cs.path = T ++ (a, e) :: R := by
    refine ⟨cs.path[d].1, cs.path[d].2, cs.path.take d, cs.path.drop (d + 1), by simp; omega, ?_⟩
    exact path_split_at hd'
  have hgetT : ∀ (x : Nat × Nat) (d'' : Nat), d < d'' → (T ++ x :: R)[d'']? = R[d'' - d - 1]? := by
    intro x d'' h
    rw [List.getElem?_append_right (by omega), hTl, show d'' - d = (d'' - d - 1) + 1 by omega]; rfl
  have htakeT : ∀ (x : Nat × Nat) (d'' : Nat), d < d'' →
      (T ++ x :: R).take d'' = T ++ x :: R.take (d'' - d - 1) := by
    intro x d'' h
    rw [List.take_append, List.take_of_length_le (by omega), hTl,
      show d'' - d = (d'' - d - 1) + 1 by omega, List.take_succ_cons, Nat.add_sub_cancel]
  obtain ⟨Ecol, q, H, hEcol, hEe, hHcol, hKcol⟩ := colAt_litCap_container hcol_s hsplit k p
  have he : e < Ecol.length := (List.getElem?_eq_some_iff.1 hEe).1
  have hqe : (Ecol.getD e (0, Tree.empty)).1 = q := by
    simp [List.getD_eq_getElem?_getD, hEe]
  have hantiE := parents_antitone_le hL.1 hL.2.2.2.1 hEcol
  have hbK : (⟨T, a⟩ : ColAddr) ∈ (litCap E cs k p).colAddrs :=
    (Tree.mem_colAddrs_iff _ _).2 (by rw [hKcol]; rfl)
  have hpK : ∀ x, x < e → (parents (litCap E cs k p) ⟨T, a⟩)[x]? = some (Ecol.getD x (0, Tree.empty)).1 := by
    intro x hx
    simp only [parents, hKcol, Option.getD_some, List.getElem?_map]
    rw [List.getElem?_append_left (by rw [List.length_take_of_le he.le]; exact hx),
      List.getElem?_take_of_lt hx, getElem?_eq_getD (by omega)]; rfl
  have hpKe : (parents (litCap E cs k p) ⟨T, a⟩)[e]? = some q := by
    simp only [parents, hKcol, Option.getD_some, List.getElem?_map]
    rw [List.getElem?_append_right (by rw [List.length_take_of_le he.le]), List.length_take_of_le he.le]
    simp
  by_cases hv : ∃ x, x < e ∧ (Ecol.getD x (0, Tree.empty)).1 = q ∧
      (Ecol.getD x (0, Tree.empty)).2 < litCapAux k p R cs.col H
  · -- a violation: move the containing entry back to the least admissible index
    have hi := Nat.find_spec hv
    have hmin : ∀ x < Nat.find hv, ¬ (x < e ∧ (Ecol.getD x (0, Tree.empty)).1 = q ∧
        (Ecol.getD x (0, Tree.empty)).2 < litCapAux k p R cs.col H) := fun x hx => Nat.find_min hv hx
    generalize Nat.find hv = i at hi hmin
    let m : Move := ⟨⟨T, a⟩, i, e⟩
    have hparE : ∀ x, i ≤ x → x ≤ e → (Ecol.getD x (0, Tree.empty)).1 = q := by
      intro x h1 h2
      have u1 := hantiE (x - i) i (by omega)
      have u2 := hantiE (e - x) x (by omega)
      rw [show i + (x - i) = x by omega, hi.2.1] at u1
      rw [show x + (e - x) = e by omega, hqe] at u2
      omega
    have hmok : MoveOK (litCap E cs k p) m := by
      refine ⟨Ecol.take e ++ [(q, litCapAux k p R cs.col H)], _, hKcol, stopData_litCap' hcol_s k p,
        ?_, hi.1, ?_, ?_, ?_, ?_⟩
      · simp [m, List.length_take_of_le he.le]
      · show (T ++ [(a, e)]) <+: cs.path
        exact ⟨R, by rw [hsplit]; simp⟩
      · intro x h1 h2
        show ((Ecol.take e ++ [(q, litCapAux k p R cs.col H)]).getD x (0, Tree.empty)).1 =
          ((Ecol.take e ++ [(q, litCapAux k p R cs.col H)]).getD e (0, Tree.empty)).1
        rw [getD_take_snoc_self _ he.le]
        rcases Nat.lt_or_eq_of_le h2 with h | rfl
        · rw [getD_take_snoc_lt _ he.le h]; exact hparE x h1 h.le
        · rw [getD_take_snoc_self _ he.le]
      · show ((Ecol.take e ++ [(q, litCapAux k p R cs.col H)]).getD i (0, Tree.empty)).2 <
          ((Ecol.take e ++ [(q, litCapAux k p R cs.col H)]).getD e (0, Tree.empty)).2
        rw [getD_take_snoc_lt _ he.le hi.1, getD_take_snoc_self _ he.le]; exact hi.2.2
      · intro x hx hq'
        show ¬ ((Ecol.take e ++ [(q, litCapAux k p R cs.col H)]).getD x (0, Tree.empty)).2 <
          ((Ecol.take e ++ [(q, litCapAux k p R cs.col H)]).getD e (0, Tree.empty)).2
        change ((Ecol.take e ++ [(q, litCapAux k p R cs.col H)]).getD x (0, Tree.empty)).1 =
          ((Ecol.take e ++ [(q, litCapAux k p R cs.col H)]).getD e (0, Tree.empty)).1 at hq'
        have hxe : x < e := by have := hi.1; simp [m] at hx; omega
        rw [getD_take_snoc_lt _ he.le hxe, getD_take_snoc_self _ he.le] at hq' ⊢
        exact fun hlt => hmin x hx ⟨hxe, hq', hlt⟩
    obtain ⟨rest', hrest', hupN, hmove, htk'⟩ := litCap_move_step hL.2.2.1 hup' hmok
    have hR' : rest' = R := by
      have h1 : T ++ (a, e) :: rest' = T ++ (a, e) :: R := hrest'.symm.trans hsplit
      simpa using h1
    subst hR'
    obtain ⟨hVN, hIN, hAN⟩ := decoratedA_applyMove hmok hV' hA'
    rw [hmove] at hVN hIN hAN
    have hKcolN : (litCap E ⟨T ++ (a, i) :: rest', cs.col⟩ k p).colAt ⟨T, a⟩ =
        some (Ecol.take i ++ [(q, litCapAux k p rest' cs.col H)]) := by
      show (litCap E ⟨m.col.path ++ (m.col.col, m.i) :: rest', cs.col⟩ k p).colAt m.col = _
      rw [← hmove, applyMove_eq_mod hKcol hi.1 (by simp [m, List.length_take_of_le he.le]),
        colAt_mod_self, hKcol]
      simp only [Option.map_some, moveFun, m]
      congr 1
      rw [List.take_append_of_le_length (by rw [List.length_take_of_le he.le]; omega), List.take_take,
        Nat.min_eq_left hi.1.le, List.drop_left' (List.length_take_of_le he.le)]
    refine ⟨ms ++ [m], ⟨T ++ (a, i) :: rest', cs.col⟩, movesValid_snoc hmv (by rw [heq]; exact hmok),
      by rw [applyMoves_snoc, heq, hmove], hupN, htk'.trans htk, ?_, hVN, hIN hI', hAN, ?_⟩
    · have := congrArg List.length hsplit; simp at this ⊢; omega
    · intro d'' h1 h2
      rcases Nat.lt_or_eq_of_le h1 with hlt | rfl
      · intro a' e' x y hpd hx hy he1
        have hlt' := hlast d'' (by omega) (by simp at h2; rw [hsplit]; simp; omega) a' e' x y
        rw [hsplit, hgetT _ _ hlt] at hlt'
        simp only at hpd
        rw [hgetT _ _ hlt] at hpd
        rw [htakeT _ _ hlt] at hx hy
        rw [htakeT _ _ hlt] at hlt'
        have hcolEq : (litCap E ⟨T ++ (a, i) :: rest', cs.col⟩ k p).colAt
            ⟨T ++ (a, i) :: rest'.take (d'' - d - 1), a'⟩ =
            (litCap E cs k p).colAt ⟨T ++ (a, e) :: rest'.take (d'' - d - 1), a'⟩ := by
          simp only [Tree.colAt]
          rw [← hmove]
          have := forestAt_applyMove_through (m := m) hKcol hi.1
            (by simp [m, List.length_take_of_le he.le]) (rest'.take (d'' - d - 1))
          simp only [m] at this
          rw [this]
        rw [hcolEq] at hx hy
        exact hlt' hpd hx hy he1
      · intro a' e' x y hpd hx hy he1
        simp only at hpd
        rw [List.getElem?_append_right (by omega), hTl, Nat.sub_self] at hpd
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hpd
        obtain ⟨rfl, rfl⟩ := hpd
        simp only at hx hy
        rw [List.take_left' hTl, hKcolN, Option.getD_some] at hx hy
        rw [List.getElem?_append_right (by rw [List.length_take_of_le (by omega)]),
          List.length_take_of_le (by omega), Nat.sub_self] at hx
        simp only [List.getElem?_cons_zero, Option.some.injEq] at hx
        subst hx
        rw [List.getElem?_append_left (by rw [List.length_take_of_le (by omega)]; omega),
          List.getElem?_take_of_lt (by omega), getElem?_eq_getD (by omega), Option.some.injEq] at hy
        subst hy
        have hanti := hantiE 1 (i - 1) (by omega)
        rw [show i - 1 + 1 = i by omega, hi.2.1] at hanti
        by_cases hyq : (Ecol.getD (i - 1) (0, Tree.empty)).1 = q
        · right
          refine ⟨hyq.symm, not_lt.1 fun hlt => hmin (i - 1) (by omega) ⟨by omega, hyq, hlt⟩⟩
        · left; omega
  · -- no violation at this level
    refine ⟨ms, cs, hmv, heq, hup', htk, hlen, hV', hI', hA', ?_⟩
    intro d'' h1 h2
    rcases Nat.lt_or_eq_of_le h1 with hlt | rfl
    · exact hlast d'' hlt h2
    · intro a' e' x y hpd hx hy he1
      rw [hsplit, List.getElem?_append_right (by omega), hTl, Nat.sub_self] at hpd
      simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hpd
      obtain ⟨rfl, rfl⟩ := hpd
      rw [hsplit, List.take_left' hTl, hKcol, Option.getD_some] at hx hy
      rw [List.getElem?_append_right (by rw [List.length_take_of_le he.le]),
        List.length_take_of_le he.le, Nat.sub_self] at hx
      simp only [List.getElem?_cons_zero, Option.some.injEq] at hx
      subst hx
      rw [List.getElem?_append_left (by rw [List.length_take_of_le he.le]; omega),
        List.getElem?_take_of_lt (by omega), getElem?_eq_getD (by omega), Option.some.injEq] at hy
      subst hy
      have hanti := parents_antitone hV' hA' hbK (i := e - 1) (p := q)
        (q := (Ecol.getD (e - 1) (0, Tree.empty)).1) (by rw [show e - 1 + 1 = e by omega]; exact hpKe)
        (hpK _ (by omega))
      by_cases hyq : (Ecol.getD (e - 1) (0, Tree.empty)).1 = q
      · right
        exact ⟨hyq.symm, not_lt.1 fun hlt => hv ⟨e - 1, by omega, hyq, hlt⟩⟩
      · left; omega

-- provides: U2, L3.1 (`repair`†, txt:283-298)
theorem repair {E : Forest} (hL : InL E) (hP : CondP E) {c : ColAddr} {k p : Nat}
    (hup : IsUpward E c k p) (hKV : CondV (litCap E c k p)) (hKI : CondI (litCap E c k p))
    (hKA : CondAK (litCap E c k p) (capKeys (litCap E c k p) (routeCols (litCap E c k p)))) :
    ∃ w : AdmCap E, w.col = c ∧ w.cut = k ∧ w.par = p ∧
      (∃ sd, stopData w.H = some sd ∧ sd.r = p ∧ sd.Q = ((E.colAt c).getD []).take k) ∧
      ∃ c', IsUpward E c' k p ∧ w.H = litCap E c' k p := by
  have hR : ∀ t, t ≤ c.path.length → RepairState E c k p (c.path.length - t) := by
    intro t
    induction t with
    | zero =>
      intro _
      refine ⟨[], c, fun idx h => absurd h (by simp), rfl, hup, rfl, rfl, hKV, hKI, hKA, ?_⟩
      intro d h1 h2; omega
    | succ t ih =>
      intro ht
      have := repair_step hL (c := c) (k := k) (p := p) (d := c.path.length - (t + 1)) (by omega)
        (by rw [show c.path.length - (t + 1) + 1 = c.path.length - t by omega]; exact ih (by omega))
      exact this
  obtain ⟨ms, cs, hmv, heq, hup', htk, hlen, hV', hI', hA', hlast⟩ := hR c.path.length le_rfl
  rw [Nat.sub_self] at hlast
  obtain ⟨col, hcol, hk, -⟩ := isUpward_iff_exists.1 hup'
  have hcsK : (litCap E cs k p).colAt cs = some (col.take k ++ [(p, Tree.empty)]) := by
    rw [litCap_eq_aux hcol]; exact colAt_litCapAux_self hcol k p
  have hcsm : cs ∈ (litCap E cs k p).colAddrs := (Tree.mem_colAddrs_iff _ _).2 (by rw [hcsK]; rfl)
  have hcap : 1 ≤ k → ∀ y, col[k - 1]? = some y → p ≤ y.1 := by
    intro hk1 y hy
    have hy' : (col.take k ++ [(p, Tree.empty)])[k - 1]? = some y := by
      rw [List.getElem?_append_left (by rw [List.length_take_of_le hk]; omega),
        List.getElem?_take_of_lt (by omega)]; exact hy
    have hp' : (col.take k ++ [(p, Tree.empty)])[k]? = some (p, Tree.empty) := by
      rw [List.getElem?_append_right (by rw [List.length_take_of_le hk]), List.length_take_of_le hk]
      simp
    refine parents_antitone hV' hA' hcsm (i := k - 1) ?_ ?_
    · simp only [parents, hcsK, Option.getD_some, List.getElem?_map]
      rw [show k - 1 + 1 = k by omega, hp']; rfl
    · simp only [parents, hcsK, Option.getD_some, List.getElem?_map, hy']; rfl
  have hHf := condH_litCap hL.2.2.1 hcol hk (fun d hd => hlast d (Nat.zero_le d) hd) hcap
  have hSf := upward_condS hL.1 hL.2.1 hL.2.2.1 hP hup' hV' hI'
  have hAf := (capping_iff hV' hSf (sel := routeCols (litCap E cs k p)) (fun a h => h)).2 hA'
  have hinL : InL (applyMoves (litCap E c k p) ms) := by
    rw [heq]; exact ⟨hV', hI', hHf, hAf, hSf⟩
  refine ⟨⟨c, k, p, ms, hup, hmv, hinL⟩, rfl, rfl, rfl, ?_, cs, hup', heq⟩
  refine ⟨⟨cs.path.length, cs, cs.num 0, p, col.take k⟩, ?_, rfl, ?_⟩
  · show stopData (applyMoves (litCap E c k p) ms) = _
    rw [heq, stopData_litCap' hcol k p]
  · show col.take k = _
    rw [← htk, hcol, Option.getD_some]


/-! ## D3.1d, D3.1e — integration additions (requested by U3 R10–R13, R15, R18, R19 and U5 R16,
R17; formerly stubs in `U3.lean` / `U5.lean`) -/

/-! ### D3.1d helpers: origins of ordinary roles and slots -/

theorem backRole_ord : ∀ (ms : List Move) (c : ColAddr),
    ∃ c', backRole ms (.ord c) = .ord c' ∧ c'.num 0 = c.num 0
  | [], c => ⟨c, rfl, rfl⟩
  | m :: ms, c => by
    obtain ⟨c', h1, h2⟩ := backRole_ord ms c
    refine ⟨bwdC m c', ?_, by rw [num_bwdC, h2]⟩
    show m.mapRole m.bwdIdx (backRole ms (.ord c)) = _
    rw [h1]; rfl

theorem origin_ord {E : Forest} (w : AdmCap E) (c : ColAddr) :
    ∃ c', w.origin (.ord c) = some (.ord c') ∧ c'.num 0 = c.num 0 := by
  obtain ⟨c', h1, h2⟩ := backRole_ord w.moves c
  exact ⟨c', by rw [originBody_eq, h1, if_neg (by simp)], h2⟩

/-- helper: an entry of the moved tree, undone, keeps its label and its column. -/
theorem adm_entries {K : Forest} :
    ∀ ms : List Move, MovesValid K ms → ∀ e, ((applyMoves K ms).entryAt e).isSome →
      ∃ e₀, backRole ms (.slot e) = .slot e₀ ∧ backRole ms (.ord e.col) = .ord e₀.col ∧
        ((applyMoves K ms).entryAt e).map Prod.fst = (K.entryAt e₀).map Prod.fst := by
  intro ms
  induction ms using List.reverseRecOn with
  | nil => intro _ e _; exact ⟨e, rfl, rfl, rfl⟩
  | append_singleton ms m ih =>
    intro hv e he
    obtain ⟨hv, hm⟩ := movesValid_append hv
    obtain ⟨col, -, hcol, -, hj, hij, -⟩ := hm
    have hj' : m.j < col.length := by omega
    rw [applyMoves_snoc] at he ⊢
    -- the backward entry of `e` in the tree before the move
    obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 he
    obtain ⟨col', hcol', hidx⟩ := Tree.colAt_of_entryAt hx
    obtain ⟨col0, hcol0, hmc, hnc⟩ := colAt_mod_corr hcol hij hj' hcol'
    have hlab : ∃ y, (applyMoves K ms).entryAt (m.mapEntry m.bwdIdx e) = some y ∧ y.1 = x.1 := by
      by_cases hem : e.col = m.col
      · obtain ⟨rfl, -⟩ := hmc hem
        have hme : m.mapEntry m.bwdIdx e = ⟨m.col, m.bwdIdx e.idx⟩ := by
          unfold Move.mapEntry; dsimp only
          have : (⟨m.mapPath m.bwdIdx e.col.path, e.col.col⟩ : ColAddr) = m.col := by
            rw [hem, mapPath_off _ _ _ (fun e D he => by have := congrArg List.length he; simp at this)]
          rw [if_pos this, this]
        rw [moveFun, getElem?_moveFun m col hij.le hj'.le] at hidx
        refine ⟨x, ?_, rfl⟩
        rw [hme]; simp only [Tree.entryAt, hcol, Option.bind_some]; exact hidx
      · obtain ⟨hl, -⟩ := hnc hem
        have h1 := congrArg (·[e.idx]?) hl
        simp only [List.getElem?_map, hidx, Option.map_some] at h1
        obtain ⟨y, hy, hyx⟩ := Option.map_eq_some_iff.1 h1.symm
        have hme : m.mapEntry m.bwdIdx e = ⟨bwdC m e.col, e.idx⟩ := by
          unfold Move.mapEntry; dsimp only
          rw [if_neg]; rfl
          intro h'; apply hem
          have := (colAddr_mapPath_eq_iff m.bwdIdx m e.col.path e.col.col).1 h'
          exact this
        refine ⟨y, ?_, hyx⟩
        rw [hme]; simp only [Tree.entryAt, hcol0, Option.bind_some]; exact hy
    obtain ⟨y, hy, hyx⟩ := hlab
    obtain ⟨e₀, h1, h2, h3⟩ := ih hv (m.mapEntry m.bwdIdx e) (by rw [hy]; rfl)
    refine ⟨e₀, ?_, ?_, ?_⟩
    · rw [backRole_append]; exact h1
    · rw [backRole_append]
      show backRole ms (.ord ⟨m.mapPath m.bwdIdx e.col.path, e.col.col⟩) = _
      rw [← mapEntry_col]; exact h2
    · rw [hx, ← h3, hy]; simp [hyx]

theorem bwd_moved_ord (m : Move) (hij : m.i ≤ m.j) (rest : List (Nat × Nat)) (cc : Nat) :
    m.mapRole m.bwdIdx (.ord ⟨m.col.path ++ (m.col.col, m.i) :: rest, cc⟩) =
      .ord ⟨m.col.path ++ (m.col.col, m.j) :: rest, cc⟩ := by
  simp only [Move.mapRole, mapPath_through]
  have hb : m.bwdIdx m.i = m.j := by unfold Move.bwdIdx; rw [if_pos le_rfl]; omega
  rw [hb]

/-- helper: the stop data of an admissible cap and the origins of its stopping column. -/
theorem adm_stop {E : Forest} {c : ColAddr} {k p : Nat} {col : Column} (hcol : E.colAt c = some col) :
    ∀ ms : List Move, MovesValid (litCap E c k p) ms →
      ∃ c', stopData (applyMoves (litCap E c k p) ms) =
          some { depth := c.path.length, col := c', t := c.num 0, r := p, Q := col.take k } ∧
        backRole ms (.ord c') = .ord c ∧ ∀ n, backRole ms (.slot ⟨c', n⟩) = .slot ⟨c, n⟩ := by
  intro ms
  induction ms using List.reverseRecOn with
  | nil => intro _; exact ⟨c, stopData_litCap' hcol k p, rfl, fun _ => rfl⟩
  | append_singleton ms m ih =>
    intro hv
    obtain ⟨hv, hm⟩ := movesValid_append hv
    obtain ⟨c', hsd, hord, hslot⟩ := ih hv
    obtain ⟨rest, hpath, hsd'⟩ := stopData_applyMove hm hsd
    obtain ⟨-, -, -, -, -, hij, -⟩ := hm
    rw [applyMoves_snoc]
    refine ⟨_, hsd', ?_, fun n => ?_⟩
    · rw [backRole_append]
      simp only at hpath ⊢
      rw [bwd_moved_ord m hij.le, ← hpath]; exact hord
    · rw [backRole_append]
      simp only at hpath ⊢
      rw [bwd_moved_slot m hij.le, ← hpath]; exact hslot n

theorem container_eq (o c : ColAddr) {k ck ik : Nat} (hp : o.path = c.path.take k)
    (hk : c.path[k]? = some (ck, ik)) :
    o.container c = if ck = o.col then some ⟨o, ik⟩ else none := by
  have hkl : k < c.path.length := (List.getElem?_eq_some_iff.1 hk).1
  have hn : o.path.length = k := by rw [hp]; simp; omega
  unfold ColAddr.container
  rw [hn, List.drop_eq_getElem_cons hkl, (List.getElem?_eq_some_iff.1 hk).2]
  simp only
  by_cases h : ck = o.col
  · rw [if_pos ⟨hp.symm, h⟩, if_pos h]
  · rw [if_neg (fun h' => h h'.2), if_neg h]

theorem container_bwdC (m : Move) {c o : ColAddr} (h : c.OnStack o) :
    (bwdC m o).container (bwdC m c) = (o.container c).map (m.mapEntry m.bwdIdx) := by
  rcases h with ⟨k, ck, ik, hk, hp, hc⟩ | ⟨hp, hc⟩
  · have hkl : k < c.path.length := (List.getElem?_eq_some_iff.1 hk).1
    have hfst := mapPath_getElem_fst m.bwdIdx m c.path k
    rw [hk] at hfst
    obtain ⟨⟨ck', ik'⟩, hk', hck'⟩ := Option.map_eq_some_iff.1 hfst
    simp only at hck'; subst hck'
    have hp' : (bwdC m o).path = (bwdC m c).path.take k := by
      simp only [bwdC]; rw [hp, mapPath_take]
    rw [container_eq o c hp hk, container_eq (bwdC m o) (bwdC m c) hp' hk']
    by_cases hck : ck' = o.col
    · rw [if_pos hck, if_pos (show ck' = (bwdC m o).col from hck)]
      simp only [bwdC, Option.map_some, Option.some.injEq]
      unfold Move.mapEntry; dsimp only
      -- compare the backward entry index with `ik'`
      rcases mapPath_cases m c.path with ⟨e, D, hD⟩ | hoff
      · rw [hD, mapPath_through] at hk'
        rw [hD] at hk hp
        rcases lt_trichotomy k m.col.path.length with hlt | heq | hgt
        · rw [List.getElem?_append_left hlt] at hk hk'
          rw [hk] at hk'; obtain ⟨-, rfl⟩ := Prod.mk.inj (Option.some.inj hk')
          rw [if_neg]
          intro h'
          have := congrArg (fun c : ColAddr => c.path.length) h'
          simp only [mapPath_length, hp, List.length_take, List.length_append, List.length_cons] at this
          omega
        · subst heq
          simp only [List.getElem?_append_right le_rfl, Nat.sub_self, List.getElem?_cons_zero,
            Option.some.injEq, Prod.mk.injEq] at hk hk'
          obtain ⟨rfl, rfl⟩ := hk
          obtain ⟨-, rfl⟩ := hk'
          have hop : o.path = m.col.path := by rw [hp]; simp
          rw [if_pos]
          rw [hop, mapPath_off _ _ _ (fun e D he => by have := congrArg List.length he; simp at this)]
          rw [← hck]
        · rw [List.getElem?_append_right hgt.le,
            show k - m.col.path.length = (k - m.col.path.length - 1) + 1 by omega] at hk hk'
          simp only [List.getElem?_cons_succ] at hk hk'
          rw [hk] at hk'; obtain ⟨-, rfl⟩ := Prod.mk.inj (Option.some.inj hk')
          rw [if_neg]
          intro h'
          have := congrArg (fun c : ColAddr => c.path.length) h'
          simp only [mapPath_length, hp, List.length_take, List.length_append, List.length_cons] at this
          omega
      · rw [mapPath_off _ _ _ hoff] at hk'
        rw [hk] at hk'; obtain ⟨-, rfl⟩ := Prod.mk.inj (Option.some.inj hk')
        rw [if_neg]
        intro h'
        rw [colAddr_mapPath_eq_iff] at h'
        apply hoff ik (c.path.drop (k + 1))
        have h1 : o.path = m.col.path := congrArg ColAddr.path h'
        have h2 : o.col = m.col.col := congrArg ColAddr.col h'
        conv_lhs => rw [path_split_at hkl]
        rw [(List.getElem?_eq_some_iff.1 hk).2, ← hp, h1, hck, h2]
    · rw [if_neg hck, if_neg (show ¬ ck' = (bwdC m o).col from hck)]; rfl
  · unfold ColAddr.container
    simp only [bwdC, hp, List.drop_length]
    rfl

theorem rep_bwdC (m : Move) (c : ColAddr) (q : Nat) :
    (bwdC m c).rep 0 q = (c.rep 0 q).map (fun ov => (m.mapRole m.bwdIdx ov.1, m.mapRole m.bwdIdx ov.2)) := by
  simp only [ColAddr.rep, resolve_bwdC]
  cases h : c.resolve 0 q with
  | none => rfl
  | some o =>
    simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq]
    have hst := ((ColAddr.resolve_spec 0 c o q).1 h).1
    rw [container_bwdC m hst]
    refine ⟨rfl, ?_⟩
    cases o.container c with
    | none => rfl
    | some e => rfl

/-- helper: undo a list of moves on a column address. -/
def backC (ms : List Move) (c : ColAddr) : ColAddr := ms.foldr (fun m c => bwdC m c) c

theorem backRole_ord_eq : ∀ (ms : List Move) (c : ColAddr), backRole ms (.ord c) = .ord (backC ms c)
  | [], _ => rfl
  | m :: ms, c => by
    show m.mapRole m.bwdIdx (backRole ms (.ord c)) = _
    rw [backRole_ord_eq ms c]; rfl

theorem rep_backC : ∀ (ms : List Move) (c : ColAddr) (q : Nat),
    (backC ms c).rep 0 q = (c.rep 0 q).map (fun ov => (backRole ms ov.1, backRole ms ov.2))
  | [], c, q => by simp [backC, backRole]
  | m :: ms, c, q => by
    show (bwdC m (backC ms c)).rep 0 q = _
    rw [rep_bwdC, rep_backC ms c q, Option.map_map]
    rfl

theorem heightAt_ne_of_col {E : Forest} {c : ColAddr} {e : EntryAddr} (hc : (E.colAt c).isSome)
    (he : e.heightPath <+: c.path) : ∃ H, E.heightAt e = some H ∧ H ≠ Tree.empty := by
  obtain ⟨rest, hrest⟩ := he
  obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 hc
  simp only [Tree.colAt, Option.bind_eq_some_iff] at hcol
  obtain ⟨G, hG, hGc⟩ := hcol
  rw [← hrest, Tree.forestAt_append, Tree.forestAt_heightPath, Option.bind_eq_some_iff] at hG
  obtain ⟨H, hH, hG⟩ := hG
  refine ⟨H, hH, ?_⟩
  rintro rfl
  cases rest with
  | nil =>
    rw [forestAt_nil_path] at hG; obtain rfl := Option.some.inj hG
    simp [Tree.empty, Tree.cols] at hGc
  | cons x rest => rw [forestAt_empty_node_cons] at hG; simp at hG

/-- helper (D3.1d, representatives clause of `origin_spec_full`). -/
theorem origin_reps {E : Forest} (w : AdmCap E) :
    ∀ c c', Role.ord c ∈ w.H.roles → w.origin (.ord c) = some (.ord c') → ∀ q, q < c.num 0 →
      (c.rep 0 q).map (fun ov => (Packet.anchorD E (some w) ov.1, Packet.anchorD E (some w) ov.2)) =
        c'.rep 0 q := by
  intro c c' hc h q _
  rw [originBody_eq, backRole_ord_eq, if_neg (by simp)] at h
  obtain rfl := Role.ord.inj (Option.some.inj h)
  rw [rep_backC]
  have hcs : (w.H.colAt c).isSome := (Tree.mem_roles_iff _ _).1 hc
  obtain ⟨col, hcol, hk, -⟩ := isUpward_iff_exists.1 w.upward
  obtain ⟨cs, hsd, -, hslot⟩ := adm_stop (k := w.cut) (p := w.par) hcol w.moves w.movesValid
  have hanD : ∀ x, backRole w.moves x ≠ .slot ⟨w.col, w.cut⟩ →
      Packet.anchorD E (some w) x = backRole w.moves x := by
    intro x hx
    simp only [Packet.anchorD, anchorOrigin, originBody_eq, if_neg hx, Option.getD_some]
  simp only [ColAddr.rep]
  cases hr : c.resolve 0 q with
  | none => rfl
  | some o =>
    simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq]
    refine ⟨hanD _ (by rw [backRole_ord_eq]; simp), ?_⟩
    cases hco : o.container c with
    | none => exact hanD _ (by rw [backRole_ord_eq]; simp)
    | some e =>
      apply hanD
      intro heq
      rw [← hslot w.cut] at heq
      have heq' := backRole_injective _ heq
      obtain rfl := Role.slot.inj heq'
      have hcont := ((ColAddr.container_spec o c _).1 hco).2
      obtain ⟨H, hH, hne⟩ := heightAt_ne_of_col hcs hcont
      obtain ⟨hcolsd, -⟩ := stopData_spec hsd
      have hentry : w.H.entryAt ⟨cs, w.cut⟩ = some (w.par, Tree.empty) := by
        simp only [Tree.entryAt]
        show ((applyMoves (litCap E w.col w.cut w.par) w.moves).colAt cs).bind _ = _
        rw [hcolsd]
        simp only [Option.bind_some]
        rw [List.getElem?_append_right (by simp), List.length_take_of_le hk]; simp
      rw [heightAt_of_entryAt hentry] at hH
      exact hne (Option.some.inj hH).symm

theorem modify_split {α : Type} {l : List α} {n : Nat} {x : α} (h : l[n]? = some x) (f : α → α) :
    l = l.take n ++ x :: l.drop (n + 1) ∧ l.modify n f = l.take n ++ f x :: l.drop (n + 1) := by
  have hn : n < l.length := (List.getElem?_eq_some_iff.1 h).1
  have hx : l[n] = x := (List.getElem?_eq_some_iff.1 h).2
  constructor
  · conv_lhs => rw [← List.take_append_drop n l, List.drop_eq_getElem_cons hn, hx]
  · rw [List.modify_eq_take_drop, List.drop_eq_getElem_cons hn, hx]; rfl

/-! ### D3.1e helpers: roles of a literal cap -/

theorem rolesCols_append {α : Type} (π : List (Nat × Nat)) :
    ∀ (c : Nat) (l₁ l₂ : List (List (α × Tree α))),
      Tree.rolesCols π c (l₁ ++ l₂) = Tree.rolesCols π c l₁ ++ Tree.rolesCols π (c + l₁.length) l₂
  | c, [], l₂ => by simp [Tree.rolesCols]
  | c, x :: l₁, l₂ => by
    rw [List.length_cons, show c + (l₁.length + 1) = c + 1 + l₁.length by omega]
    simp only [List.cons_append, Tree.rolesCols, rolesCols_append π (c + 1) l₁ l₂,
      List.append_assoc, List.cons_append]

theorem rolesCol_append {α : Type} (π : List (Nat × Nat)) (c : Nat) :
    ∀ (i : Nat) (l₁ l₂ : List (α × Tree α)),
      Tree.rolesCol π c i (l₁ ++ l₂) = Tree.rolesCol π c i l₁ ++ Tree.rolesCol π c (i + l₁.length) l₂
  | i, [], l₂ => by simp [Tree.rolesCol]
  | i, (x, h) :: l₁, l₂ => by
    rw [List.length_cons, show i + (l₁.length + 1) = i + 1 + l₁.length by omega]
    simp only [List.cons_append, Tree.rolesCol, rolesCol_append π c (i + 1) l₁ l₂,
      List.append_assoc, List.cons_append]

theorem rolesF_empty {α : Type} (π : List (Nat × Nat)) : Tree.rolesF π (Tree.empty : Tree α) = [] := by
  simp [Tree.empty, Tree.rolesF, Tree.rolesCols]

theorem roles_litCapAux (k p : Nat) :
    ∀ (ρ : List (Nat × Nat)) (j : Nat) (F : Forest) (col : Column) (π : List (Nat × Nat)),
      F.colAt ⟨ρ, j⟩ = some col → k ≤ col.length →
      ∃ n, n ≤ (Tree.rolesF π F).length ∧
        Tree.rolesF π (litCapAux k p ρ j F) = (Tree.rolesF π F).take n ++ [.slot ⟨⟨π ++ ρ, j⟩, k⟩]
  | [], j, .node cols, col, π, hcol, hk => by
    rw [colAt_node_nil] at hcol
    have hj : j < cols.length := (List.getElem?_eq_some_iff.1 hcol).1
    obtain ⟨h1, -⟩ := modify_split hcol id
    have hl : (cols.take j).length = j := List.length_take_of_le hj.le
    have hkl : (col.take k).length = k := List.length_take_of_le hk
    have hKr : Tree.rolesF π (litCapAux k p [] j (.node cols)) =
        Tree.rolesCols π 0 (cols.take j) ++ Role.ord ⟨π, j⟩ ::
          (Tree.rolesCol π j 0 (col.take k) ++ [Role.slot ⟨⟨π, j⟩, k⟩]) := by
      rw [litCapAux_nil, List.getD_eq_getElem?_getD, hcol, Option.getD_some]
      simp only [Tree.rolesF]
      rw [rolesCols_append, hl]
      simp only [Tree.rolesCols, List.append_nil]
      rw [rolesCol_append, Nat.zero_add, hkl]
      simp [Tree.rolesCol, rolesF_empty]
    have hEr : Tree.rolesF π (.node cols) =
        Tree.rolesCols π 0 (cols.take j) ++ Role.ord ⟨π, j⟩ ::
          (Tree.rolesCol π j 0 (col.take k) ++ (Tree.rolesCol π j k (col.drop k) ++
            Tree.rolesCols π (j + 1) (cols.drop (j + 1)))) := by
      simp only [Tree.rolesF]
      conv_lhs => rw [h1]
      rw [rolesCols_append, hl]
      simp only [Tree.rolesCols]
      conv_lhs => rw [← List.take_append_drop k col]
      rw [rolesCol_append]
      simp only [Nat.zero_add, hkl, List.append_assoc]
    rw [hKr, hEr]
    set A := Tree.rolesCols π 0 (cols.take j)
    set B := Tree.rolesCol π j 0 (col.take k)
    refine ⟨A.length + 1 + B.length, by simp; omega, ?_⟩
    rw [show A.length + 1 + B.length = (A ++ Role.ord ⟨π, j⟩ :: B).length by simp; omega]
    rw [show A ++ Role.ord ⟨π, j⟩ :: (B ++ (Tree.rolesCol π j k (col.drop k) ++
        Tree.rolesCols π (j + 1) (cols.drop (j + 1)))) = (A ++ Role.ord ⟨π, j⟩ :: B) ++
        (Tree.rolesCol π j k (col.drop k) ++ Tree.rolesCols π (j + 1) (cols.drop (j + 1))) by simp,
      List.take_left]
    simp
  | (ci, ei) :: ρ, j, .node cols, col, π, hcol, hk => by
    rw [colAt_node_cons] at hcol
    obtain ⟨x, hx, hcolx⟩ := Option.bind_eq_some_iff.1 hcol
    obtain ⟨colc, hc, hx'⟩ := Option.bind_eq_some_iff.1 hx
    obtain ⟨q, H⟩ := x
    have hci : ci < cols.length := (List.getElem?_eq_some_iff.1 hc).1
    have hei : ei < colc.length := (List.getElem?_eq_some_iff.1 hx').1
    have hget : (cols.getD ci [])[ei]? = some (q, H) := by
      rw [List.getD_eq_getElem?_getD, hc, Option.getD_some]; exact hx'
    obtain ⟨n', hn', hih⟩ := roles_litCapAux k p ρ j H col (π ++ [(ci, ei)]) hcolx hk
    obtain ⟨h1, -⟩ := modify_split hc id
    obtain ⟨h3, -⟩ := modify_split hx' id
    have hl : (cols.take ci).length = ci := List.length_take_of_le hci.le
    have hl' : (colc.take ei).length = ei := List.length_take_of_le hei.le
    have hKr : Tree.rolesF π (litCapAux k p ((ci, ei) :: ρ) j (.node cols)) =
        Tree.rolesCols π 0 (cols.take ci) ++ Role.ord ⟨π, ci⟩ ::
          (Tree.rolesCol π ci 0 (colc.take ei) ++ Role.slot ⟨⟨π, ci⟩, ei⟩ ::
            ((Tree.rolesF (π ++ [(ci, ei)]) H).take n' ++
              [Role.slot ⟨⟨π ++ [(ci, ei)] ++ ρ, j⟩, k⟩])) := by
      rw [litCapAux_cons k p ci ei j ρ cols hget, List.getD_eq_getElem?_getD, hc, Option.getD_some]
      simp only [Tree.rolesF]
      rw [rolesCols_append, hl]
      simp only [Tree.rolesCols, List.append_nil]
      rw [rolesCol_append]
      simp only [Nat.zero_add, hl', Tree.rolesCol, List.append_nil]
      rw [hih]
    have hEr : Tree.rolesF π (.node cols) =
        Tree.rolesCols π 0 (cols.take ci) ++ Role.ord ⟨π, ci⟩ ::
          (Tree.rolesCol π ci 0 (colc.take ei) ++ Role.slot ⟨⟨π, ci⟩, ei⟩ ::
            (Tree.rolesF (π ++ [(ci, ei)]) H ++ (Tree.rolesCol π ci (ei + 1) (colc.drop (ei + 1)) ++
              Tree.rolesCols π (ci + 1) (cols.drop (ci + 1))))) := by
      simp only [Tree.rolesF]
      conv_lhs => rw [h1]
      rw [rolesCols_append, hl]
      simp only [Tree.rolesCols]
      conv_lhs => rw [h3]
      rw [rolesCol_append]
      simp only [Nat.zero_add, hl', Tree.rolesCol, List.append_assoc, List.cons_append]
    rw [hKr, hEr]
    set A := Tree.rolesCols π 0 (cols.take ci)
    set B := Tree.rolesCol π ci 0 (colc.take ei)
    set R := Tree.rolesF (π ++ [(ci, ei)]) H
    refine ⟨(A ++ Role.ord ⟨π, ci⟩ :: (B ++ [Role.slot ⟨⟨π, ci⟩, ei⟩])).length + n', by
      simp only [List.length_append, List.length_cons, List.length_singleton, List.length_nil]; omega, ?_⟩
    have e1 : ∀ (X T : List Role), (X ++ (R ++ T)).take (X.length + n') = X ++ R.take n' := by
      intro X T
      rw [List.take_append, List.take_of_length_le (Nat.le_add_right _ _), Nat.add_sub_cancel_left,
        List.take_append_of_le_length hn']
    have e2 := e1 (A ++ Role.ord ⟨π, ci⟩ :: (B ++ [Role.slot ⟨⟨π, ci⟩, ei⟩]))
      (Tree.rolesCol π ci (ei + 1) (colc.drop (ei + 1)) ++ Tree.rolesCols π (ci + 1) (cols.drop (ci + 1)))
    simp only [List.append_assoc, List.cons_append, List.singleton_append, List.nil_append] at e2 ⊢
    rw [e2]
    simp

/-! ### reading order under a move -/

theorem mapRole_off (g : Nat → Nat) (m : Move) (x : Role)
    (h1 : ∀ e D, x.path ≠ m.col.path ++ (m.col.col, e) :: D) (h2 : ∀ e, x ≠ .slot ⟨m.col, e⟩) :
    m.mapRole g x = x := by
  cases x with
  | ord c => simp only [Move.mapRole]; rw [mapPath_off g m c.path h1]
  | slot e =>
    simp only [Move.mapRole]
    unfold Move.mapEntry; dsimp only
    rw [mapPath_off g m e.col.path h1, if_neg]
    intro h; apply h2 e.idx; rw [← h]

mutual
/-- helper: relabelling the entry index of one step of the path of every role of a height. -/
theorem rolesF_relabel (g : Nat → Nat) (m : Move) :
    ∀ (e : Nat) (R : List (Nat × Nat)) (h : Forest),
      (Tree.rolesF (m.col.path ++ (m.col.col, e) :: R) h).map (m.mapRole g) =
        Tree.rolesF (m.col.path ++ (m.col.col, g e) :: R) h
  | e, R, .node cols => by simp only [Tree.rolesF]; exact rolesCols_relabel g m e R 0 cols
theorem rolesCols_relabel (g : Nat → Nat) (m : Move) :
    ∀ (e : Nat) (R : List (Nat × Nat)) (c : Nat) (cols : List Column),
      (Tree.rolesCols (m.col.path ++ (m.col.col, e) :: R) c cols).map (m.mapRole g) =
        Tree.rolesCols (m.col.path ++ (m.col.col, g e) :: R) c cols
  | _, _, _, [] => by simp [Tree.rolesCols]
  | e, R, c, col :: rest => by
    simp only [Tree.rolesCols, List.map_cons, List.map_append]
    rw [rolesCol_relabel g m e R c 0 col, rolesCols_relabel g m e R (c + 1) rest]
    simp only [Move.mapRole, mapPath_through]
theorem rolesCol_relabel (g : Nat → Nat) (m : Move) :
    ∀ (e : Nat) (R : List (Nat × Nat)) (c i : Nat) (col : Column),
      (Tree.rolesCol (m.col.path ++ (m.col.col, e) :: R) c i col).map (m.mapRole g) =
        Tree.rolesCol (m.col.path ++ (m.col.col, g e) :: R) c i col
  | _, _, _, _, [] => by simp [Tree.rolesCol]
  | e, R, c, i, (x, h) :: rest => by
    simp only [Tree.rolesCol, List.map_cons, List.map_append]
    have h1 := rolesF_relabel g m e (R ++ [(c, i)]) h
    simp only [List.append_assoc, List.cons_append] at h1 ⊢
    rw [h1, rolesCol_relabel g m e R c (i + 1) rest]
    congr 1
    simp only [Move.mapRole]
    unfold Move.mapEntry; dsimp only
    rw [mapPath_through, if_neg]
    intro h'; have := congrArg (fun c : ColAddr => c.path.length) h'; simp at this
end

mutual
theorem rolesF_path : ∀ (π : List (Nat × Nat)) (h : Forest), ∀ x ∈ Tree.rolesF π h, π <+: x.path
  | π, .node cols => by
    intro x hx
    simp only [Tree.rolesF] at hx
    obtain ⟨c', -, -, h⟩ := rolesCols_path π 0 cols x hx
    rcases h with rfl | ⟨e, rfl | h⟩
    · exact List.prefix_refl _
    · exact List.prefix_refl _
    · exact (List.prefix_append _ _).trans h
theorem rolesCols_path : ∀ (π : List (Nat × Nat)) (c : Nat) (cols : List Column),
    ∀ x ∈ Tree.rolesCols π c cols, ∃ c', c ≤ c' ∧ c' < c + cols.length ∧
      (x = .ord ⟨π, c'⟩ ∨ ∃ e, x = .slot ⟨⟨π, c'⟩, e⟩ ∨ π ++ [(c', e)] <+: x.path)
  | _, _, [] => by simp [Tree.rolesCols]
  | π, c, col :: rest => by
    intro x hx
    simp only [Tree.rolesCols, List.mem_cons, List.mem_append] at hx
    rcases hx with rfl | hx | hx
    · exact ⟨c, le_rfl, by simp, Or.inl rfl⟩
    · obtain ⟨e, -, -, h⟩ := rolesCol_path π c 0 col x hx
      exact ⟨c, le_rfl, by simp, Or.inr ⟨e, h⟩⟩
    · obtain ⟨c', h1, h2, h⟩ := rolesCols_path π (c + 1) rest x hx
      exact ⟨c', by omega, by simp; omega, h⟩
theorem rolesCol_path : ∀ (π : List (Nat × Nat)) (c i : Nat) (col : Column),
    ∀ x ∈ Tree.rolesCol π c i col, ∃ e, i ≤ e ∧ e < i + col.length ∧
      (x = .slot ⟨⟨π, c⟩, e⟩ ∨ π ++ [(c, e)] <+: x.path)
  | _, _, _, [] => by simp [Tree.rolesCol]
  | π, c, i, (y, h) :: rest => by
    intro x hx
    simp only [Tree.rolesCol, List.mem_cons, List.mem_append] at hx
    rcases hx with rfl | hx | hx
    · exact ⟨i, le_rfl, by simp, Or.inl rfl⟩
    · exact ⟨i, le_rfl, by simp, Or.inr (rolesF_path _ h x hx)⟩
    · obtain ⟨e, h1, h2, h⟩ := rolesCol_path π c (i + 1) rest x hx
      exact ⟨e, by omega, by simp; omega, h⟩
end

theorem path_ne_of_div {π P D : List (Nat × Nat)} {x y : Nat × Nat} (hxy : x ≠ y) :
    ∀ D', π ++ x :: D ≠ π ++ y :: D' := by
  intro D' h; simp at h; exact hxy h.1

/-- helper: roles at the move level, in columns other than the move column, are fixed. -/
theorem off_base (g : Nat → Nat) (m : Move) (c0 : Nat) (cols : List Column)
    (hcc : ¬ (c0 ≤ m.col.col ∧ m.col.col < c0 + cols.length)) :
    ∀ x ∈ Tree.rolesCols m.col.path c0 cols, m.mapRole g x = x := by
  intro x hx
  obtain ⟨c', h1, h2, h⟩ := rolesCols_path _ _ _ x hx
  have hc' : c' ≠ m.col.col := fun h' => hcc ⟨h' ▸ h1, h' ▸ h2⟩
  apply mapRole_off
  · intro e D he
    rcases h with rfl | ⟨e', rfl | ⟨D', hD'⟩⟩
    · simp [Role.path] at he
    · simp [Role.path] at he
    · rw [he] at hD'; simp at hD'; exact hc' hD'.1.1
  · intro e he
    rcases h with rfl | ⟨e', rfl | ⟨D', hD'⟩⟩
    · simp at he
    · simp at he; exact hc' (congrArg ColAddr.col he.1)
    · rw [he] at hD'; simp [Role.path] at hD'

/-- helper: roles above the move level, off the move's path, are fixed. -/
theorem off_step_cols (g : Nat → Nat) (m : Move) {π P'' : List (Nat × Nat)} {a b : Nat}
    (hP : m.col.path = π ++ (a, b) :: P'') (c0 : Nat) (cols : List Column)
    (ha : ¬ (c0 ≤ a ∧ a < c0 + cols.length)) :
    ∀ x ∈ Tree.rolesCols π c0 cols, m.mapRole g x = x := by
  intro x hx
  obtain ⟨c', h1, h2, h⟩ := rolesCols_path _ _ _ x hx
  have hc' : c' ≠ a := fun h' => ha ⟨h' ▸ h1, h' ▸ h2⟩
  apply mapRole_off
  · intro e D he
    rw [hP] at he
    rcases h with rfl | ⟨e', rfl | ⟨D', hD'⟩⟩
    · simp [Role.path] at he
    · simp [Role.path] at he
    · rw [he] at hD'; simp at hD'; exact hc' hD'.1.1
  · intro e he
    have hl : x.path = m.col.path := by rw [he]; rfl
    rw [hP] at hl
    rcases h with rfl | ⟨e', rfl | ⟨D', hD'⟩⟩
    · simp [Role.path] at hl
    · simp [Role.path] at hl
    · rw [hl] at hD'; simp at hD'; exact hc' hD'.1.1

theorem off_step_col (g : Nat → Nat) (m : Move) {π P'' : List (Nat × Nat)} {a b : Nat}
    (hP : m.col.path = π ++ (a, b) :: P'') (i : Nat) (col : Column)
    (hb : ¬ (i ≤ b ∧ b < i + col.length)) :
    ∀ x ∈ Tree.rolesCol π a i col, m.mapRole g x = x := by
  intro x hx
  obtain ⟨e', h1, h2, h⟩ := rolesCol_path _ _ _ _ x hx
  have he' : e' ≠ b := fun h' => hb ⟨h' ▸ h1, h' ▸ h2⟩
  apply mapRole_off
  · intro e D he
    rw [hP] at he
    rcases h with rfl | ⟨D', hD'⟩
    · simp [Role.path] at he
    · rw [he] at hD'; simp at hD'; exact he' hD'.1
  · intro e he
    have hl : x.path = m.col.path := by rw [he]; rfl
    rw [hP] at hl
    rcases h with rfl | ⟨D', hD'⟩
    · simp [Role.path] at hl
    · rw [hl] at hD'; simp at hD'; exact he' hD'.1

theorem off_short (g : Nat → Nat) (m : Move) {x : Role} (h : x.path.length < m.col.path.length) :
    m.mapRole g x = x := by
  apply mapRole_off
  · intro e D he; rw [he] at h; simp at h
  · intro e he; rw [he] at h; simp [Role.path] at h

/-- helper: column-level relabelling of the move column's entries by a shift. -/
theorem rolesCol_shift (g : Nat → Nat) (m : Move) :
    ∀ (s : Nat) (l : Column), (∀ t, t < l.length → g (s + t) = g s + t) →
      (Tree.rolesCol m.col.path m.col.col s l).map (m.mapRole g) =
        Tree.rolesCol m.col.path m.col.col (g s) l
  | _, [], _ => by simp [Tree.rolesCol]
  | s, (y, h) :: rest, hg => by
    simp only [Tree.rolesCol, List.map_cons, List.map_append]
    have h1 := rolesF_relabel g m s [] h
    rw [h1]
    rw [rolesCol_shift g m (s + 1) rest (fun t ht => by
      rw [show s + 1 + t = s + (t + 1) by omega, hg (t + 1) (by simp; omega),
        hg 1 (by simp; omega)]; omega)]
    have key : Tree.rolesCol m.col.path m.col.col (g (s + 1)) rest =
        Tree.rolesCol m.col.path m.col.col (g s + 1) rest := by
      cases rest with
      | nil => simp [Tree.rolesCol]
      | cons _ _ => rw [hg 1 (by simp)]
    rw [key]
    congr 1
    simp only [Move.mapRole]
    unfold Move.mapEntry; dsimp only
    rw [mapPath_off _ _ _ (fun e D he => by have := congrArg List.length he; simp at this), if_pos rfl]

theorem map_eq_self_of {α : Type} {f : α → α} : ∀ {l : List α}, (∀ x ∈ l, f x = x) → l.map f = l
  | [], _ => rfl
  | x :: l, h => by
    simp only [List.map_cons]
    rw [h x (by simp), map_eq_self_of (fun y hy => h y (by simp [hy]))]

/-- helper: the roles of the moved tree, read backwards, are a sublist of the original roles. -/
theorem roles_mod_sublist (m : Move) {col : Column} (hij : m.i < m.j) (hj : m.j < col.length) :
    ∀ (P' π : List (Nat × Nat)) (F : Forest), π ++ P' = m.col.path → F.colAt ⟨P', m.col.col⟩ = some col →
      List.Sublist ((Tree.rolesF π (modifyColAux (moveFun m) P' m.col.col F)).map (m.mapRole m.bwdIdx))
        (Tree.rolesF π F)
  | [], π, .node cols, hπ, hcol => by
    simp only [List.append_nil] at hπ
    subst hπ
    rw [colAt_node_nil] at hcol
    have hcc : m.col.col < cols.length := (List.getElem?_eq_some_iff.1 hcol).1
    obtain ⟨h1, h2⟩ := modify_split hcol (moveFun m)
    have hl : (cols.take m.col.col).length = m.col.col := List.length_take_of_le hcc.le
    simp only [modifyColAux, Tree.rolesF]
    rw [h2]
    conv_rhs => rw [h1]
    rw [rolesCols_append, rolesCols_append, hl]
    simp only [Tree.rolesCols, List.map_append, List.map_cons]
    have hti : (col.take m.i).length = m.i := List.length_take_of_le (by omega)
    have hcolsplit : col = col.take m.i ++ ((col.take m.j).drop m.i ++ col.drop m.j) := by
      have : col.take m.i ++ (col.take m.j).drop m.i = col.take m.j := by
        conv_rhs => rw [← List.take_append_drop m.i (col.take m.j)]
        rw [List.take_take, Nat.min_eq_left hij.le]
      rw [← List.append_assoc, this, List.take_append_drop]
    have hmid : ((col.take m.j).drop m.i).length = m.j - m.i := by simp; omega
    conv_rhs => rw [hcolsplit]
    simp only [moveFun]
    rw [rolesCol_append, rolesCol_append, rolesCol_append, hti, hmid]
    simp only [Nat.zero_add]
    rw [show m.i + (m.j - m.i) = m.j by omega]
    rw [map_eq_self_of (off_base _ m 0 _ (by simp [hl])),
      map_eq_self_of (off_base _ m (m.col.col + 1) _ (by omega)),
      mapRole_off _ m (.ord m.col) (fun e D he => by have := congrArg List.length he; simp [Role.path] at this)
        (fun e he => by simp at he)]
    simp only [List.map_append]
    rw [rolesCol_shift _ m m.i (col.drop m.j) (fun t ht => by unfold Move.bwdIdx; split_ifs <;> omega)]
    have hb0 : (Tree.rolesCol m.col.path m.col.col 0 (col.take m.i)).map (m.mapRole m.bwdIdx) =
        Tree.rolesCol m.col.path m.col.col 0 (col.take m.i) := by
      rcases Nat.eq_zero_or_pos m.i with h0 | h0
      · rw [h0]; simp [Tree.rolesCol]
      · rw [rolesCol_shift _ m 0 _ (fun t ht => by
          simp at ht; unfold Move.bwdIdx; split_ifs <;> omega)]
        unfold Move.bwdIdx; rw [if_neg (by omega)]
    rw [hb0, show m.bwdIdx m.i = m.j by unfold Move.bwdIdx; rw [if_pos le_rfl]; omega]
    simp only [List.append_assoc, List.cons_append]
    exact List.Sublist.append_left (List.Sublist.cons_cons _ (List.Sublist.append_left
      (List.sublist_append_right _ _) _)) _
  | (a, b) :: P'', π, .node cols, hπ, hcol => by
    rw [colAt_node_cons] at hcol
    obtain ⟨x, hx, hcolx⟩ := Option.bind_eq_some_iff.1 hcol
    obtain ⟨colc, hc, hx'⟩ := Option.bind_eq_some_iff.1 hx
    obtain ⟨q, H⟩ := x
    have hP : m.col.path = π ++ (a, b) :: P'' := hπ.symm
    have hci : a < cols.length := (List.getElem?_eq_some_iff.1 hc).1
    have hei : b < colc.length := (List.getElem?_eq_some_iff.1 hx').1
    have ih := roles_mod_sublist m hij hj P'' (π ++ [(a, b)]) H (by rw [hP]; simp) hcolx
    obtain ⟨h1, h2⟩ := modify_split hc (fun col => col.modify b fun x => (x.1, modifyColAux (moveFun m) P'' m.col.col x.2))
    obtain ⟨h3, h4⟩ := modify_split hx' (fun x => (x.1, modifyColAux (moveFun m) P'' m.col.col x.2))
    have hl : (cols.take a).length = a := List.length_take_of_le hci.le
    have hl' : (colc.take b).length = b := List.length_take_of_le hei.le
    have hshort : π.length < m.col.path.length := by rw [hP]; simp
    simp only [modifyColAux, Tree.rolesF]
    rw [h2]
    conv_rhs => rw [h1]
    rw [rolesCols_append, rolesCols_append, hl]
    simp only [Tree.rolesCols, List.map_append, List.map_cons]
    rw [h4]
    conv_rhs => rw [h3]
    rw [rolesCol_append, rolesCol_append, hl']
    simp only [Tree.rolesCol, Nat.zero_add, List.map_append, List.map_cons]
    rw [map_eq_self_of (off_step_cols _ m hP 0 _ (by simp [hl])),
      map_eq_self_of (off_step_cols _ m hP (a + 1) _ (by omega)),
      map_eq_self_of (off_step_col _ m hP 0 _ (by simp [hl'])),
      map_eq_self_of (off_step_col _ m hP (b + 1) _ (by omega)),
      off_short _ m (x := .ord ⟨π, a⟩) (by simpa [Role.path] using hshort),
      off_short _ m (x := .slot ⟨⟨π, a⟩, b⟩) (by simpa [Role.path] using hshort)]
    simp only [List.append_assoc, List.cons_append]
    exact List.Sublist.append_left (List.Sublist.cons_cons _ (List.Sublist.append_left
      (List.Sublist.cons_cons _ (List.Sublist.append_right ih _)) _)) _

/-- helper: `x` occurs before `y` in `l`. -/
def ListBefore {α : Type} (l : List α) (x y : α) : Prop :=
  ∃ i j : Nat, l[i]? = some x ∧ l[j]? = some y ∧ i < j

theorem before_map {α β : Type} (f : α → β) {l : List α} {x y : α} (h : ListBefore l x y) :
    ListBefore (l.map f) (f x) (f y) := by
  obtain ⟨i, j, hi, hj, hij⟩ := h
  exact ⟨i, j, by simp [hi], by simp [hj], hij⟩

theorem before_sublist {α : Type} {l₁ l₂ : List α} (hs : List.Sublist l₁ l₂) :
    ∀ {x y : α}, ListBefore l₁ x y → ListBefore l₂ x y := by
  induction hs with
  | slnil => intro x y ⟨i, j, hi, _, _⟩; simp at hi
  | cons a _ ih =>
    intro x y h
    obtain ⟨i, j, hi, hj, hij⟩ := ih h
    exact ⟨i + 1, j + 1, by simpa using hi, by simpa using hj, by omega⟩
  | cons_cons a hsub ih =>
    intro x y ⟨i, j, hi, hj, hij⟩
    rcases i with _ | i
    · simp at hi; subst hi
      obtain ⟨j', hj'⟩ : ∃ j', j = j' + 1 := ⟨j - 1, by omega⟩
      subst hj'
      simp at hj
      obtain ⟨k, hk⟩ := List.mem_iff_getElem?.1 (hsub.subset (List.mem_of_getElem? hj))
      exact ⟨0, k + 1, rfl, by simpa using hk, by omega⟩
    · obtain ⟨j', hj'⟩ : ∃ j', j = j' + 1 := ⟨j - 1, by omega⟩
      subst hj'
      obtain ⟨i₂, j₂, h1, h2, h3⟩ := ih ⟨i, j', by simpa using hi, by simpa using hj, by omega⟩
      exact ⟨i₂ + 1, j₂ + 1, by simpa using h1, by simpa using h2, by omega⟩

theorem before_applyMove {K : Forest} {m : Move} (hm : MoveOK K m) {x y : Role}
    (h : ListBefore (applyMove K m).roles x y) :
    ListBefore K.roles (m.mapRole m.bwdIdx x) (m.mapRole m.bwdIdx y) := by
  obtain ⟨col, -, hcol, -, hj, hij, -⟩ := hm
  have hj' : m.j < col.length := by omega
  rw [applyMove_eq_mod hcol hij hj'] at h
  have hs := roles_mod_sublist m hij hj' m.col.path [] K (by simp) hcol
  exact before_sublist hs (before_map _ h)

theorem before_applyMoves {K : Forest} :
    ∀ ms : List Move, MovesValid K ms → ∀ {x y : Role}, ListBefore (applyMoves K ms).roles x y →
      ListBefore K.roles (backRole ms x) (backRole ms y) := by
  intro ms
  induction ms using List.reverseRecOn with
  | nil => intro _ x y h; exact h
  | append_singleton ms m ih =>
    intro hv x y h
    obtain ⟨hv, hm⟩ := movesValid_append hv
    rw [applyMoves_snoc] at h
    rw [backRole_append, backRole_append]
    exact ih hv (before_applyMove hm h)

/-- helper (D3.1d, reading-order clause of `origin_spec_full`). -/
theorem origin_order {E : Forest} (w : AdmCap E) :
    ∀ x y, (∃ i j : Nat, w.H.roles[i]? = some x ∧ w.H.roles[j]? = some y ∧ i < j) →
      (w.origin x).isSome → (w.origin y).isSome →
      ∃ i j : Nat, E.roles[i]? = some (Packet.anchorD E (some w) x) ∧
        E.roles[j]? = some (Packet.anchorD E (some w) y) ∧ i < j := by
  intro x y hxy hx hy
  have hb := before_applyMoves w.moves w.movesValid hxy
  have hxo : ∀ z, (w.origin z).isSome → Packet.anchorD E (some w) z = backRole w.moves z ∧
      backRole w.moves z ≠ .slot ⟨w.col, w.cut⟩ := by
    intro z hz
    rw [originBody_eq] at hz
    split_ifs at hz with h
    · simp at hz
    · refine ⟨?_, h⟩
      simp only [Packet.anchorD, anchorOrigin, originBody_eq, if_neg h, Option.getD_some]
  obtain ⟨hax, hnx⟩ := hxo x hx
  obtain ⟨hay, hny⟩ := hxo y hy
  rw [hax, hay]
  obtain ⟨col, hcol, hk, -⟩ := isUpward_iff_exists.1 w.upward
  obtain ⟨n, hn, hroles⟩ := roles_litCapAux w.cut w.par w.col.path w.col.col E col [] hcol hk
  have hK : (litCap E w.col w.cut w.par).roles = E.roles.take n ++ [.slot ⟨w.col, w.cut⟩] := by
    show Tree.rolesF [] _ = _
    rw [litCap_eq_aux hcol, hroles]; rfl
  obtain ⟨i, j, hi, hj, hij⟩ := hb
  rw [hK] at hi hj
  have hln : (E.roles.take n).length = n := List.length_take_of_le hn
  have hjn : j < n := by
    by_contra hc
    rw [List.getElem?_append_right (by omega), hln] at hj
    rcases Nat.lt_or_ge (j - n) 1 with h | h
    · rw [show j - n = 0 by omega] at hj; simp at hj; exact hny hj.symm
    · rw [List.getElem?_eq_none (by simp; omega)] at hj; simp at hj
  rw [List.getElem?_append_left (by omega), List.getElem?_take_of_lt (by omega)] at hi
  rw [List.getElem?_append_left (by omega), List.getElem?_take_of_lt hjn] at hj
  exact ⟨i, j, hi, hj, hij⟩

-- provides: U2, D3.1d (requested by U3 R10; refines `origin_spec`†): χ is injective on the
-- roles of `w.H`, `none` exactly on the closing slot, valued in `E`, sends ordinary roles to
-- ordinary roles of the same printed number, keeps labels and hosts of slots, commutes with
-- representatives, and preserves reading order.
theorem origin_spec_full {E : Forest} (hE : InL E) (w : AdmCap E) :
    Set.InjOn w.origin {x | x ∈ w.H.roles} ∧
    (∀ x ∈ w.H.roles, w.origin x = none ↔ ∃ sd, stopData w.H = some sd ∧
      x = .slot (closingSlot sd)) ∧
    (∀ x ∈ w.H.roles, ∀ y, w.origin x = some y → y ∈ E.roles) ∧
    (∀ c, Role.ord c ∈ w.H.roles → (∃ c', w.origin (.ord c) = some (.ord c')) ∨ w.origin (.ord c) = none) ∧
    (∀ c c', Role.ord c ∈ w.H.roles → w.origin (.ord c) = some (.ord c') → c'.num 0 = c.num 0) ∧
    (∀ e e', Role.slot e ∈ w.H.roles → w.origin (.slot e) = some (.slot e') →
      (w.H.entryAt e).map Prod.fst = (E.entryAt e').map Prod.fst ∧
      w.origin (.ord e.col) = some (.ord e'.col)) ∧
    (∀ c c', Role.ord c ∈ w.H.roles → w.origin (.ord c) = some (.ord c') → ∀ q, q < c.num 0 →
      (c.rep 0 q).map (fun ov => (Packet.anchorD E (some w) ov.1, Packet.anchorD E (some w) ov.2)) =
        c'.rep 0 q) ∧
    (∀ x y, (∃ i j : Nat, w.H.roles[i]? = some x ∧ w.H.roles[j]? = some y ∧ i < j) →
      (w.origin x).isSome → (w.origin y).isSome →
      ∃ i j : Nat, E.roles[i]? = some (Packet.anchorD E (some w) x) ∧
        E.roles[j]? = some (Packet.anchorD E (some w) y) ∧ i < j) := by
  obtain ⟨hinj, hnone, -, hval⟩ := origin_spec w
  refine ⟨fun x hx y hy hxy => ?_, hnone, hval, fun c _ => ?_, fun c c' _ h => ?_,
    fun e e' he h => ?_, origin_reps w, origin_order w⟩
  · cases h : w.origin x with
    | none =>
      have hy' : w.origin y = none := by rw [← hxy, h]
      obtain ⟨sd, hsd, rfl⟩ := (hnone x hx).1 h
      obtain ⟨sd', hsd', rfl⟩ := (hnone y hy).1 hy'
      rw [hsd] at hsd'; obtain rfl := Option.some.inj hsd'; rfl
    | some z => exact hinj x hx y hy z h (by rw [← hxy, h])
  · obtain ⟨c', h1, -⟩ := origin_ord w c; exact Or.inl ⟨c', h1⟩
  · obtain ⟨c'', h1, h2⟩ := origin_ord w c
    rw [h1] at h; obtain rfl := Role.ord.inj (Option.some.inj h); exact h2
  · obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 ((Tree.mem_roles_iff _ _).1 he)
    have hx' : (applyMoves (litCap E w.col w.cut w.par) w.moves).entryAt e = some x := hx
    obtain ⟨e₀, h1, h2, h3⟩ := adm_entries w.moves w.movesValid e (by rw [hx']; rfl)
    rw [originBody_eq, h1] at h
    split_ifs at h with hne
    obtain rfl := Role.slot.inj (Option.some.inj h)
    refine ⟨?_, by rw [originBody_eq, h2, if_neg (by simp)]⟩
    show ((applyMoves (litCap E w.col w.cut w.par) w.moves).entryAt e).map Prod.fst = _
    rw [h3]
    obtain ⟨col, hcol, hk, -⟩ := isUpward_iff_exists.1 w.upward
    obtain ⟨y, hy⟩ : ∃ y, (litCap E w.col w.cut w.par).entryAt e₀ = some y := by
      cases h4 : (litCap E w.col w.cut w.par).entryAt e₀ with
      | none => rw [h4] at h3; rw [hx'] at h3; simp at h3
      | some y => exact ⟨y, rfl⟩
    rw [hy]
    rcases entryAt_litCap_cases hcol hk hy with h' | ⟨ρ, hρ⟩ | h'
    · exact absurd (by rw [h']) hne
    · obtain ⟨q, J, hE⟩ := heightAt_of_prefix hcol ⟨ρ, hρ⟩
      rw [entryAt_litCap_container hcol hρ hE] at hy
      rw [← hy, hE]; rfl
    · rw [h']

/-! ### D3.1d helpers: the stopping column of an admissible cap -/

-- provides: U2, D3.1d (requested by U3 R15): the query of an admissible cap is the cut prefix of
-- `E`'s column, with origins at the same indices.
theorem admCap_query {E : Forest} (hE : InL E) (w : AdmCap E) {sd : StopData}
    (hsd : stopData w.H = some sd) :
    sd.t = w.col.num 0 ∧ sd.r = w.par ∧ sd.Q.length = w.cut ∧
    w.origin (.ord sd.col) = some (.ord w.col) ∧
    ∀ j < w.cut, w.origin (.slot ⟨sd.col, j⟩) = some (.slot ⟨w.col, j⟩) ∧
      (sd.Q[j]?) = ((E.colAt w.col).getD [])[j]? := by
  obtain ⟨col, hcol, hk, -⟩ := isUpward_iff_exists.1 w.upward
  obtain ⟨c', hsd', hord, hslot⟩ := adm_stop (k := w.cut) (p := w.par) hcol w.moves w.movesValid
  have : sd = _ := Option.some.inj (hsd.symm.trans hsd')
  subst this
  refine ⟨rfl, rfl, List.length_take_of_le hk, ?_, fun j hj => ⟨?_, ?_⟩⟩
  · rw [originBody_eq]; simp only; rw [hord, if_neg (by simp)]
  · rw [originBody_eq]; simp only; rw [hslot j, if_neg (by simp; omega)]
  · simp only; rw [hcol, Option.getD_some, List.getElem?_take_of_lt hj]


theorem mem_takeWhile_ne_of_lt {α : Type} [DecidableEq α] :
    ∀ (l : List α) {z y : α} {i j : Nat}, l.Nodup → l[j]? = some z → i < j → l[i]? = some y →
      y ∈ l.takeWhile (· != z)
  | [], _, _, _, _, _, h, _, _ => by simp at h
  | a :: l, z, y, i, j, hnd, hj, hij, hi => by
    rcases j with _ | j
    · omega
    have haz : a ≠ z := by
      intro h; subst h
      have := List.mem_of_getElem? (show l[j]? = some a by simpa using hj)
      exact (List.nodup_cons.1 hnd).1 this
    rw [List.takeWhile_cons, if_pos (by simp [haz])]
    rcases i with _ | i
    · simp at hi; subst hi; simp
    · exact List.mem_cons_of_mem _ (mem_takeWhile_ne_of_lt l (i := i) (j := j) (List.nodup_cons.1 hnd).2
        (by simpa using hj) (by omega) (by simpa using hi))

theorem lt_of_mem_takeWhile_ne {α : Type} [DecidableEq α] :
    ∀ (l : List α) {z x : α}, x ∈ l.takeWhile (· != z) → z ∈ l →
      ∃ i j : Nat, l[i]? = some x ∧ l[j]? = some z ∧ i < j
  | [], _, _, h, _ => by simp at h
  | a :: l, z, x, hx, hz => by
    by_cases haz : a = z
    · subst haz; simp at hx
    · rw [List.takeWhile_cons, if_pos (by simp [haz])] at hx
      have hz' : z ∈ l := by
        rcases List.mem_cons.1 hz with h | h
        · exact absurd h.symm haz
        · exact h
      rcases List.mem_cons.1 hx with rfl | hx
      · obtain ⟨j, hj⟩ := List.mem_iff_getElem?.1 hz'
        exact ⟨0, j + 1, rfl, by simpa using hj, by omega⟩
      · obtain ⟨i, j, h1, h2, h3⟩ := lt_of_mem_takeWhile_ne l hx hz'
        exact ⟨i + 1, j + 1, by simpa using h1, by simpa using h2, by omega⟩

-- provides: U2, D3.1d (requested by U5 R16): the origin of the stopping role exists, the origin map
-- is injective, and every pre-stop role of the anchor has an origin strictly before the origin of
-- the stopping role.
theorem anchorOrigin_prefix {E : Forest} {cap : Option (AdmCap E)} (hE : InL (anchor E cap))
    {sd : StopData}
    (hsd : stopData (anchor E cap) = some sd) :
    ∃ T', anchorOrigin E cap (.ord sd.col) = some T' ∧
    (∀ x x' y, anchorOrigin E cap x = some y → anchorOrigin E cap x' = some y → x = x') ∧
    ∀ x ∈ Packet.rolesBefore (anchor E cap) (.ord sd.col),
      ∃ y, anchorOrigin E cap x = some y ∧ y ∈ Packet.rolesBefore E T' ∧ y ∈ E.roles := by
  cases cap with
  | none =>
    refine ⟨.ord sd.col, rfl, fun x x' y h1 h2 => ?_, fun x hx => ⟨x, rfl, hx, ?_⟩⟩
    · simp only [anchorOrigin] at h1 h2; exact (Option.some.inj h1).trans (Option.some.inj h2).symm
    · exact (List.takeWhile_sublist _).subset hx
  | some w =>
    simp only [anchor] at hsd ⊢
    obtain ⟨col, hcol, hk, -⟩ := isUpward_iff_exists.1 w.upward
    obtain ⟨c', hsd', hord, hslot⟩ := adm_stop (k := w.cut) (p := w.par) hcol w.moves w.movesValid
    have : sd = _ := Option.some.inj (hsd.symm.trans hsd')
    subst this
    have hosd : w.origin (.ord c') = some (.ord w.col) := by
      rw [originBody_eq, hord, if_neg (by simp)]
    refine ⟨.ord w.col, hosd, fun x x' y h1 h2 => ?_, fun x hx => ?_⟩
    · simp only [anchorOrigin, originBody_eq] at h1 h2
      split_ifs at h1 h2
      exact backRole_injective _ ((Option.some.inj h1).trans (Option.some.inj h2).symm)
    · simp only [anchorOrigin]
      -- `x` precedes the stopping column, hence is not the closing slot
      have hmem : Role.ord c' ∈ w.H.roles := by
        have := stopData_col_mem hsd; exact this
      obtain ⟨i, j, hi, hj, hij⟩ := lt_of_mem_takeWhile_ne _ hx hmem
      have hxm : x ∈ w.H.roles := List.mem_of_getElem? hi
      obtain ⟨-, -, -, -, -, qs, hqs, -⟩ := stopData_roles hsd
      have hnd := Tree.roles_nodup w.H
      let sd0 : StopData := ⟨w.col.path.length, c', ColAddr.num 0 w.col, w.par, List.take w.cut col⟩
      have hxc : x ≠ .slot (closingSlot sd0) := by
        rintro rfl
        rw [hqs] at hnd
        have h1 : Role.slot (closingSlot sd0) ∈ Packet.rolesBefore w.H (.ord c') := hx
        have h2 := List.nodup_append.1 hnd
        exact h2.2.2 _ h1 _ (List.mem_cons_of_mem _ (List.mem_append_right _ (List.mem_singleton_self _))) rfl
      obtain ⟨-, hnone, -, -⟩ := origin_spec w
      have hxs : (w.origin x).isSome := by
        cases h : w.origin x with
        | some _ => rfl
        | none =>
          obtain ⟨sd2, hsd2, rfl⟩ := (hnone x hxm).1 h
          rw [hsd] at hsd2; obtain rfl := Option.some.inj hsd2
          exact absurd rfl hxc
      obtain ⟨y, hy⟩ := Option.isSome_iff_exists.1 hxs
      obtain ⟨i', j', hi', hj', hij'⟩ := origin_order w x (.ord c') ⟨i, j, hi, hj, hij⟩ hxs
        (by rw [hosd]; rfl)
      simp only [Packet.anchorD, anchorOrigin, hy, hosd, Option.getD_some] at hi' hj'
      exact ⟨y, hy, mem_takeWhile_ne_of_lt _ (Tree.roles_nodup E) hj' hij' hi',
        List.mem_of_getElem? hi'⟩


/-! ### D3.1d helpers: legal moves raise the expression -/

theorem cmpCols_append_same {α : Type} (c : α → α → Ordering) [Std.ReflCmp c] :
    ∀ (P A B : List (List (α × Tree α))), Tree.cmpCols c (P ++ A) (P ++ B) = Tree.cmpCols c A B
  | [], A, B => rfl
  | x :: P, A, B => by
    simp only [List.cons_append, Tree.cmpCols, Tree.cmpCol_self, Ordering.eq_then]
    exact cmpCols_append_same c P A B

/-- helper: a legal move strictly raises the expression. -/
theorem cmp_modifyColAux_lt (f : Column → Column) (cc : Nat) :
    ∀ (P : List (Nat × Nat)) (K : Forest) (col : Column), K.colAt ⟨P, cc⟩ = some col →
      Tree.cmpCol compare col (f col) = .lt →
      Tree.cmp compare K (modifyColAux f P cc K) = .lt
  | [], .node cols, col, hcol, hlt => by
    rw [colAt_node_nil] at hcol
    obtain ⟨h1, h2⟩ := modify_split hcol f
    simp only [modifyColAux, Tree.cmp]
    rw [h2]
    generalize cols.take cc = T at h1 ⊢
    generalize cols.drop (cc + 1) = D at h1 ⊢
    subst h1
    rw [cmpCols_append_same, Tree.cmpCols, hlt]; rfl
  | (a, b) :: P, .node cols, col, hcol, hlt => by
    rw [colAt_node_cons] at hcol
    obtain ⟨x, hx, hcolx⟩ := Option.bind_eq_some_iff.1 hcol
    obtain ⟨colc, hc, hx'⟩ := Option.bind_eq_some_iff.1 hx
    obtain ⟨q, H⟩ := x
    have ih := cmp_modifyColAux_lt f cc P H col hcolx hlt
    simp only [modifyColAux, Tree.cmp]
    obtain ⟨h1, h2⟩ := modify_split hc
      (fun col => col.modify b fun x => (x.1, modifyColAux f P cc x.2))
    rw [h2]
    generalize cols.take a = T at h1 ⊢
    generalize cols.drop (a + 1) = D at h1 ⊢
    subst h1
    rw [cmpCols_append_same, Tree.cmpCols]
    obtain ⟨h3, h4⟩ := modify_split hx' (fun x => (x.1, modifyColAux f P cc x.2))
    rw [h4]
    generalize colc.take b = T' at h3 ⊢
    generalize colc.drop (b + 1) = D' at h3 ⊢
    subst h3
    rw [cmpCol_append_same, Tree.cmpCol]
    simp only [Std.ReflCmp.compare_self, Ordering.eq_then]
    rw [show Tree.cmp compare H (modifyColAux f P cc H) = .lt from ih]; rfl

theorem lt_applyMove {K : Forest} {m : Move} (hm : MoveOK K m) : K < applyMove K m := by
  obtain ⟨col, sd, hcol, -, hj, hij, -, hpar, hlt, -⟩ := hm
  have hj' : m.j < col.length := by omega
  rw [applyMove_eq_mod hcol hij hj', Forest.lt_iff_cmp]
  apply cmp_modifyColAux_lt _ _ _ _ col hcol
  -- compare the column with its moved version at index `i`
  have hi : col[m.i]? = some (col.getD m.i (0, Tree.empty)) := by
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (by omega)]; rfl
  have hjx : col[m.j]? = some (col.getD m.j (0, Tree.empty)) := by
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (by omega)]; rfl
  have hc1 : col = col.take m.i ++ col.getD m.i (0, Tree.empty) :: col.drop (m.i + 1) :=
    (modify_split hi id).1
  have hc2 : moveFun m col = col.take m.i ++ col.getD m.j (0, Tree.empty) :: col.drop (m.j + 1) := by
    simp only [moveFun]
    rw [List.drop_eq_getElem_cons hj', (List.getElem?_eq_some_iff.1 hjx).2]
  rw [hc2]
  have hp := hpar m.i le_rfl hij.le
  generalize col.getD m.i (0, Tree.empty) = x1 at hc1 hp hlt
  generalize col.getD m.j (0, Tree.empty) = x2 at hp hlt ⊢
  generalize col.take m.i = T at hc1 ⊢
  generalize col.drop (m.j + 1) = D
  generalize col.drop (m.i + 1) = D0 at hc1
  subst hc1
  rw [cmpCol_append_same]
  obtain ⟨p1, H1⟩ := x1
  obtain ⟨p2, H2⟩ := x2
  simp only at hp hlt
  subst hp
  simp only [Tree.cmpCol, Std.ReflCmp.compare_self, Ordering.eq_then]
  rw [show Tree.cmp compare H1 H2 = .lt from hlt]; rfl

theorem le_applyMoves {K : Forest} : ∀ {ms : List Move}, MovesValid K ms → K ≤ applyMoves K ms := by
  intro ms
  induction ms using List.reverseRecOn with
  | nil => intro _; exact le_rfl
  | append_singleton ms m ih =>
    intro h
    obtain ⟨hv, hm⟩ := movesValid_append h
    rw [applyMoves_snoc]
    exact le_trans (ih hv) (le_of_lt (lt_applyMove hm))

-- provides: U2, D3.1d (requested by U5 R17): an admissible upward cap lies strictly above `E`.
theorem lt_admCap {E : Forest} (w : AdmCap E) : E < w.H :=
  lt_of_lt_of_le (lt_litCap w.upward) (le_applyMoves w.movesValid)


-- provides: U2, D3.1e (requested by U3 R11): roles and stopping data of a literal cap.
theorem litCap_spec {E : Forest} {c : ColAddr} {k p : Nat} (hc : c ∈ E.colAddrs)
    (hk : k ≤ (parents E c).length) :
    let K := litCap E c k p
    (∃ m, K.roles = E.roles.take m ++ [.slot ⟨c, k⟩]) ∧
    (∀ e ∈ K.entryAddrs, e ≠ ⟨c, k⟩ → (K.entryAt e).map Prod.fst = (E.entryAt e).map Prod.fst) ∧
    (∀ e ∈ K.entryAddrs, e ≠ ⟨c, k⟩ → ¬ e.heightPath <+: c.path → K.entryAt e = E.entryAt e) ∧
    K.entryAt ⟨c, k⟩ = some (p, Tree.empty) ∧
    (c.path ≠ [] → CondI E → CondV K →
      ∃ sd, stopData K = some sd ∧ sd.col = c ∧ sd.r = p ∧
        sd.Q = ((E.colAt c).getD []).take k) := by
  obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff E c).1 hc)
  have hk' : k ≤ col.length := by simpa [parents, hcol] using hk
  intro K
  refine ⟨?_, ?_, ?_, entryAt_litCap_closing hcol hk' p, ?_⟩
  · obtain ⟨n, -, h⟩ := roles_litCapAux k p c.path c.col E col [] hcol hk'
    refine ⟨n, ?_⟩
    show Tree.rolesF [] (litCap E c k p) = _
    rw [litCap_eq_aux hcol, h]; rfl
  · intro e he hne
    obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 ((Tree.mem_entryAddrs_iff _ _).1 he)
    rcases entryAt_litCap_cases hcol hk' hx with h | ⟨ρ, hρ⟩ | h
    · exact absurd h hne
    · obtain ⟨q, J, hE⟩ := heightAt_of_prefix hcol ⟨ρ, hρ⟩
      show ((litCap E c k p).entryAt e).map Prod.fst = _
      rw [entryAt_litCap_container hcol hρ hE, hE]; rfl
    · show ((litCap E c k p).entryAt e).map Prod.fst = _
      rw [hx, h]
  · intro e he hne hnc
    obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 ((Tree.mem_entryAddrs_iff _ _).1 he)
    rcases entryAt_litCap_cases hcol hk' hx with h | h | h
    · exact absurd h hne
    · exact absurd h hnc
    · show (litCap E c k p).entryAt e = _
      rw [hx, h]
  · intro _ _ _
    refine ⟨_, stopData_litCap' hcol k p, rfl, rfl, by rw [hcol]; rfl⟩


/-- D3.1e (G-016 / BP-04): every move avoids the marked height at its *current* address
(after the earlier moves have relocated it). -/
def MovesOutside (ms : List Move) (b : EntryAddr) : Prop :=
  ∀ idx (h : idx < ms.length), ¬ (moveAddr (ms.take idx) b).heightPath <+: (ms[idx]).col.path

-- provides: U2, D3.1e (requested by U3 R13): every move of an admissible cap is legal for the
-- expression produced by the moves before it (`MoveOK` unfolded).
theorem moves_violate {E : Forest} (w : AdmCap E) :
    ∀ idx (hidx : idx < w.moves.length),
      ∃ (col : List (Nat × Forest)) (sd : StopData) (q : Nat) (Hi C : Forest),
        (applyMoves (litCap E w.col w.cut w.par) (w.moves.take idx)).colAt
          w.moves[idx].col = some col ∧
        stopData (applyMoves (litCap E w.col w.cut w.par) (w.moves.take idx)) = some sd ∧
        w.moves[idx].j + 1 = col.length ∧ w.moves[idx].i < w.moves[idx].j ∧
        (⟨w.moves[idx].col, w.moves[idx].j⟩ : EntryAddr).heightPath <+: sd.col.path ∧
        col[w.moves[idx].i]? = some (q, Hi) ∧ col[w.moves[idx].j]? = some (q, C) ∧
        (∀ x, w.moves[idx].i ≤ x → x ≤ w.moves[idx].j → (col[x]?).map Prod.fst = some q) ∧
        Hi < C := by
  intro idx hidx
  obtain ⟨col, sd, hcol, hsd, hj, hij, hpre, hpar, hlt, -⟩ := w.movesValid idx hidx
  refine ⟨col, sd, (col.getD w.moves[idx].j (0, Tree.empty)).1,
    (col.getD w.moves[idx].i (0, Tree.empty)).2, (col.getD w.moves[idx].j (0, Tree.empty)).2,
    hcol, hsd, hj, hij, hpre, ?_, ?_, ?_, hlt⟩
  · have := hpar w.moves[idx].i le_rfl hij.le
    rw [List.getElem?_eq_getElem (by omega), ← this]
    simp [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (show w.moves[idx].i < col.length by omega)]
  · rw [List.getElem?_eq_getElem (by omega)]
    simp [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (show w.moves[idx].j < col.length by omega)]
  · intro x h1 h2
    have := hpar x h1 h2
    rw [List.getElem?_eq_getElem (by omega)]
    simp only [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (show x < col.length by omega),
      List.getElem?_eq_getElem (show w.moves[idx].j < col.length by omega), Option.getD_some] at this
    simp [this, List.getElem?_eq_getElem (show w.moves[idx].j < col.length by omega)]


theorem moveAddr_snoc (ms : List Move) (m : Move) (b : EntryAddr) :
    moveAddr (ms ++ [m]) b = m.mapEntry m.fwdIdx (moveAddr ms b) := by
  simp [moveAddr, moveAddrBody, List.foldl_append]

theorem fwdIdx_j (m : Move) (hij : m.i < m.j) : m.fwdIdx m.j = m.i := by
  unfold Move.fwdIdx; rw [if_pos le_rfl]; omega

theorem heightPath_mapEntry (g : Nat → Nat) (m : Move) (e : EntryAddr) :
    (m.mapEntry g e).heightPath = m.mapPath g e.heightPath := by
  by_cases h : e.col.path = m.col.path ∧ e.col.col = m.col.col
  · have hc : e.col = m.col := by
      rcases e with ⟨⟨_, _⟩, _⟩; rcases m with ⟨⟨_, _⟩, _, _⟩; simp only at h ⊢; rw [h.1, h.2]
    have hme : m.mapEntry g e = ⟨m.col, g e.idx⟩ := by
      unfold Move.mapEntry; dsimp only
      rw [h.1, mapPath_off _ _ _ (fun e D he => by have := congrArg List.length he; simp at this)]
      rw [if_pos (by rw [h.2]), ← hc]
    rw [hme]
    simp only [EntryAddr.heightPath]
    rw [hc]
    have := mapPath_through g m e.idx []
    rw [this]
  · have hme : (m.mapEntry g e).col = ⟨m.mapPath g e.col.path, e.col.col⟩ := mapEntry_col g m e
    have hidx : (m.mapEntry g e).idx = e.idx := by
      unfold Move.mapEntry; dsimp only
      split_ifs with h'
      · exfalso; apply h
        have := congrArg ColAddr.path h'; have h2 := congrArg ColAddr.col h'
        simp only at this h2
        exact ⟨(mapPath_eq_colPath_iff g m _).1 this, h2⟩
      · rfl
    simp only [EntryAddr.heightPath, hme, hidx]
    exact (mapPath_snoc g m _ _ h).symm

-- provides: U2, D3.1e (requested by U3 R18): address form of L3.1h — each prefix of the repair
-- is the literal cap of `E` at the relocated column.
theorem applyMoves_litCap_addr {E : Forest} (hH : CondH E) (w : AdmCap E)
    {b : EntryAddr} (hb : b.heightPath <+: w.col.path) (hout : MovesOutside w.moves b) :
    ∀ q, q ≤ w.moves.length →
      IsUpward E ⟨(moveAddr (w.moves.take q) b).heightPath ++
          w.col.path.drop b.heightPath.length, w.col.col⟩ w.cut w.par ∧
      applyMoves (litCap E w.col w.cut w.par) (w.moves.take q) =
        litCap E ⟨(moveAddr (w.moves.take q) b).heightPath ++
          w.col.path.drop b.heightPath.length, w.col.col⟩ w.cut w.par ∧
      ((E.colAt ⟨(moveAddr (w.moves.take q) b).heightPath ++
          w.col.path.drop b.heightPath.length, w.col.col⟩).getD []).take w.cut =
        ((E.colAt w.col).getD []).take w.cut := by
  intro q
  induction q with
  | zero =>
    intro _
    have hc : (⟨(moveAddr (w.moves.take 0) b).heightPath ++ w.col.path.drop b.heightPath.length,
        w.col.col⟩ : ColAddr) = w.col := by
      simp only [List.take_zero]
      show (⟨b.heightPath ++ w.col.path.drop b.heightPath.length, w.col.col⟩ : ColAddr) = w.col
      obtain ⟨S, hS⟩ := hb
      rw [show w.col.path.drop b.heightPath.length = S by rw [← hS]; simp, hS]
    rw [hc]
    exact ⟨w.upward, rfl, rfl⟩
  | succ q ih =>
    intro hq
    obtain ⟨hup, heq, htk⟩ := ih (by omega)
    set bq := moveAddr (w.moves.take q) b with hbq
    set S := w.col.path.drop b.heightPath.length
    set m := w.moves[q]
    have hm : MoveOK (litCap E ⟨bq.heightPath ++ S, w.col.col⟩ w.cut w.par) m := by
      have := w.movesValid q (by omega)
      rw [heq] at this; exact this
    obtain ⟨rest, hrest, hup', hmove, htk'⟩ := litCap_move_step hH hup hm
    have htake : w.moves.take (q + 1) = w.moves.take q ++ [m] := (List.take_concat_get' _ _ _).symm
    -- the move lies at `bq` or at one of its containers
    have hno := hout q (by omega)
    simp only at hrest
    obtain ⟨T, hT⟩ : ∃ T, bq.heightPath = m.col.path ++ (m.col.col, m.j) :: T := by
      have h1 : bq.heightPath <+: m.col.path ++ (m.col.col, m.j) :: rest := ⟨S, hrest⟩
      have h2 : m.col.path ++ [(m.col.col, m.j)] <+: m.col.path ++ (m.col.col, m.j) :: rest :=
        ⟨rest, by simp⟩
      rcases List.prefix_or_prefix_of_prefix h1 h2 with h | h
      · obtain ⟨U, hU⟩ := h
        rcases List.eq_nil_or_concat' U with rfl | ⟨U', u, rfl⟩
        · exact ⟨[], by simpa using hU⟩
        · exfalso; apply hno
          rw [← List.append_assoc] at hU
          obtain ⟨hU1, -⟩ := List.append_inj' hU rfl
          exact ⟨U', hU1⟩
      · obtain ⟨T, hTT⟩ := h; exact ⟨T, by rw [← hTT]; simp⟩
    have hrestT : rest = T ++ S := by
      rw [hT] at hrest; simpa using hrest.symm
    have hij : m.i < m.j := by obtain ⟨_, _, _, _, _, hij, _⟩ := hm; exact hij
    have hb1 : (moveAddr (w.moves.take (q + 1)) b).heightPath =
        m.col.path ++ (m.col.col, m.i) :: T := by
      rw [htake, moveAddr_snoc, heightPath_mapEntry, ← hbq, hT, mapPath_through, fwdIdx_j m hij]
    have hc1 : (⟨(moveAddr (w.moves.take (q + 1)) b).heightPath ++ S, w.col.col⟩ : ColAddr) =
        ⟨m.col.path ++ (m.col.col, m.i) :: rest, w.col.col⟩ := by
      rw [hb1, hrestT]; simp
    rw [hc1, htake, applyMoves_snoc, heq]
    exact ⟨hup', hmove, htk'.trans htk⟩


theorem num_mapPath (g : Nat → Nat) (m : Move) (π : List (Nat × Nat)) (c b : Nat) :
    ColAddr.num b ⟨m.mapPath g π, c⟩ = ColAddr.num b ⟨π, c⟩ := by
  simp only [ColAddr.num]
  have := congrArg (fun l => (l.map (· + 1)).sum) (mapPath_fst g m π)
  simp only [List.map_map] at this
  rw [show (fun x : Nat × Nat => x.1 + 1) = ((· + 1) ∘ Prod.fst) from rfl, this]

theorem mapEntry_num (g : Nat → Nat) (m : Move) (b : EntryAddr) :
    (m.mapEntry g b).col.num 0 = b.col.num 0 := by
  rw [mapEntry_col]
  exact num_mapPath g m b.col.path b.col.col 0

-- provides: U2, D3.1e (requested by U3 R19(a)): a move rewrites only entry indices.
theorem moveAddr_num (ms : List Move) (b : EntryAddr) :
    (moveAddr ms b).col.num 0 = b.col.num 0 := by
  induction ms generalizing b with
  | nil => rfl
  | cons m ms ih =>
    show (moveAddrBody ms (m.mapEntry m.fwdIdx b)).col.num 0 = b.col.num 0
    rw [← moveAddr_eq_body, ih, mapEntry_num]


theorem repairList_append {K : Forest} {b : EntryAddr} {ms : List Move} {m : Move}
    (h : RepairList K b (ms ++ [m])) :
    RepairList K b ms ∧ RepairStepOK (applyMoves K ms) (moveAddr ms b) m := by
  refine ⟨fun idx hidx => ?_, ?_⟩
  · have := h idx (by simp; omega)
    rw [List.take_append_of_le_length hidx.le, List.getElem_append_left hidx] at this
    exact this
  · have := h ms.length (by simp)
    rw [List.take_left, List.getElem_append_right (by omega)] at this
    simpa using this

theorem heightAt_repairStep {K : Forest} {b : EntryAddr} {m : Move} (h : RepairStepOK K b m) :
    (applyMove K m).heightAt (m.mapEntry m.fwdIdx b) = K.heightAt b := by
  obtain ⟨col, hcol, hij, hj, -, -, hb⟩ := h
  rw [← Tree.forestAt_heightPath, ← Tree.forestAt_heightPath]
  rcases hb with rfl | ⟨R, hR⟩
  · have hme : m.mapEntry m.fwdIdx ⟨m.col, m.j⟩ = ⟨m.col, m.i⟩ := by
      unfold Move.mapEntry; dsimp only
      rw [mapPath_off _ _ _ (fun e D he => by have := congrArg List.length he; simp at this), if_pos rfl,
        fwdIdx_j m hij]
    rw [hme]
    simp only [EntryAddr.heightPath]
    exact forestAt_applyMove_through hcol hij hj []
  · simp only [EntryAddr.heightPath, List.append_assoc, List.singleton_append] at hR
    have hme : m.mapEntry m.fwdIdx b = ⟨⟨m.col.path ++ (m.col.col, m.i) :: R, b.col.col⟩, b.idx⟩ := by
      unfold Move.mapEntry; dsimp only
      rw [← hR, mapPath_through, fwdIdx_j m hij, if_neg]
      intro h'; have := congrArg (fun c : ColAddr => c.path.length) h'; simp at this
    rw [hme]
    simp only [EntryAddr.heightPath]
    rw [← hR, List.append_assoc, List.cons_append, List.append_assoc, List.cons_append]
    exact forestAt_applyMove_through hcol hij hj _

-- provides: U2, D3.1e (requested by U3 R19(b)): a repair list carries the marked height.
theorem repairList_height {K : Forest} {b : EntryAddr} {ms : List Move}
    (h : RepairList K b ms) :
    (applyMoves K ms).heightAt (moveAddr ms b) = K.heightAt b := by
  revert h
  induction ms using List.reverseRecOn with
  | nil => intro _; rfl
  | append_singleton ms m ih =>
    intro h
    obtain ⟨h1, h2⟩ := repairList_append h
    rw [applyMoves_snoc, moveAddr_snoc, heightAt_repairStep h2, ih h1]

/-! ### D3.1e helpers: truncations, height replacement and moves -/

theorem setAux_eq_mod (h : Forest) : ∀ (π : List (Nat × Nat)) (j i : Nat) (t : Forest),
    Tree.setAux h π j i t = modifyColAux (fun col => col.modify i fun x => (x.1, h)) π j t
  | [], j, i, .node cols => rfl
  | (c, i₀) :: π, j, i, .node cols => by
    simp only [Tree.setAux, modifyColAux]
    congr 1
    congr 1; funext col; congr 1; funext x; rw [setAux_eq_mod h π j i x.2]

theorem modifyColAux_comp (f g : Column → Column) (c : Nat) :
    ∀ (P : List (Nat × Nat)) (T : Forest),
      modifyColAux f P c (modifyColAux g P c T) = modifyColAux (f ∘ g) P c T
  | [], .node cols => by
    simp only [modifyColAux, List.modify_modify_eq]
  | (a, b) :: P, .node cols => by
    simp only [modifyColAux, List.modify_modify_eq]
    congr 1; congr 1; funext col
    simp only [Function.comp, List.modify_modify_eq]
    congr 1; funext x
    simp only [Function.comp]
    rw [modifyColAux_comp f g c P x.2]

theorem modifyColAux_append (g : Column → Column) (bc : Nat) (c e : Nat) (R : List (Nat × Nat)) :
    ∀ (P : List (Nat × Nat)) (T : Forest),
      modifyColAux g (P ++ (c, e) :: R) bc T =
        modifyColAux (fun col => col.modify e fun x => (x.1, modifyColAux g R bc x.2)) P c T
  | [], .node cols => rfl
  | (a, b) :: P, .node cols => by
    simp only [List.cons_append, modifyColAux]
    congr 1; congr 1; funext col; congr 1; funext x
    rw [modifyColAux_append g bc c e R P x.2]

theorem litCapAux_trunc (k p jj bc bi : Nat) (ρ : List (Nat × Nat)) :
    ∀ (Bp : List (Nat × Nat)) (E : Forest) (colb : Column) (q : Nat) (H : Forest),
      E.colAt ⟨Bp, bc⟩ = some colb → colb[bi]? = some (q, H) →
      litCapAux k p (Bp ++ (bc, bi) :: ρ) jj E =
        Tree.setAux (litCapAux k p ρ jj H) Bp bc bi (Tree.truncAux Bp bc bi E)
  | [], .node cols, colb, q, H, hcol, hb => by
    rw [colAt_node_nil] at hcol
    have hbc : bc < cols.length := (List.getElem?_eq_some_iff.1 hcol).1
    have hbi : bi < colb.length := (List.getElem?_eq_some_iff.1 hb).1
    have hget : (cols.getD bc [])[bi]? = some (q, H) := by
      rw [List.getD_eq_getElem?_getD, hcol, Option.getD_some]; exact hb
    simp only [List.nil_append]
    rw [litCapAux_cons k p bc bi jj ρ cols hget]
    simp only [Tree.truncAux, Tree.setAux, List.getD_eq_getElem?_getD, hcol, Option.getD_some]
    have hl : (cols.take bc).length = bc := List.length_take_of_le hbc.le
    have hm := list_modify_snoc (cols.take bc) (colb.take (bi + 1))
      (fun col => col.modify bi fun x => (x.1, litCapAux k p ρ jj H))
    rw [hl] at hm
    rw [hm]
    congr 3
    have hsp : colb.take (bi + 1) = colb.take bi ++ [(q, H)] := by
      rw [List.take_add_one, hb]; rfl
    rw [hsp]
    have hl' : (colb.take bi).length = bi := List.length_take_of_le hbi.le
    have hm' := list_modify_snoc (colb.take bi) (q, H) (fun x => (x.1, litCapAux k p ρ jj H))
    rw [hl'] at hm'
    rw [hm']
  | (a, e) :: Bp, .node cols, colb, q, H, hcol, hb => by
    rw [colAt_node_cons] at hcol
    obtain ⟨x, hx, hcolx⟩ := Option.bind_eq_some_iff.1 hcol
    obtain ⟨colc, hc, hx'⟩ := Option.bind_eq_some_iff.1 hx
    obtain ⟨q', H'⟩ := x
    have hci : a < cols.length := (List.getElem?_eq_some_iff.1 hc).1
    have hei : e < colc.length := (List.getElem?_eq_some_iff.1 hx').1
    have hget : (cols.getD a [])[e]? = some (q', H') := by
      rw [List.getD_eq_getElem?_getD, hc, Option.getD_some]; exact hx'
    simp only [List.cons_append]
    rw [litCapAux_cons k p a e jj _ cols hget]
    simp only [Tree.truncAux, Tree.setAux, List.getD_eq_getElem?_getD, hc, Option.getD_some, hx',
      Option.map_some, Option.toList_some]
    have hl : (cols.take a).length = a := List.length_take_of_le hci.le
    have hm := list_modify_snoc (cols.take a) (colc.take e ++ [(q', Tree.truncAux Bp bc bi H')])
      (fun col => col.modify e fun x => (x.1, Tree.setAux (litCapAux k p ρ jj H) Bp bc bi x.2))
    rw [hl] at hm
    rw [hm]
    have hl' : (colc.take e).length = e := List.length_take_of_le hei.le
    have hm' := list_modify_snoc (colc.take e) (q', Tree.truncAux Bp bc bi H')
      (fun x => (x.1, Tree.setAux (litCapAux k p ρ jj H) Bp bc bi x.2))
    rw [hl'] at hm'
    rw [hm', litCapAux_trunc k p jj bc bi ρ Bp H' colb q H hcolx hb]

theorem modifyColAux_congr {f g : Column → Column} (c : Nat) :
    ∀ (P : List (Nat × Nat)) (T : Forest), (∀ col, T.colAt ⟨P, c⟩ = some col → f col = g col) →
      modifyColAux f P c T = modifyColAux g P c T
  | [], .node cols, h => by
    simp only [modifyColAux]
    congr 1
    apply List.ext_getElem?; intro n
    rw [List.getElem?_modify, List.getElem?_modify]
    by_cases hn : c = n
    · subst hn
      cases hc : cols[c]? with
      | none => rfl
      | some col =>
        have := h col (by rw [colAt_node_nil]; exact hc)
        simp [this]
    · simp [hn]
  | (a, b) :: P, .node cols, h => by
    simp only [modifyColAux]
    congr 1
    apply List.ext_getElem?; intro n
    rw [List.getElem?_modify, List.getElem?_modify]
    by_cases hn : a = n
    · subst hn
      cases hc : cols[a]? with
      | none => rfl
      | some col =>
        simp only [if_true, Option.map_eq_map, Option.map_some, Option.some.injEq]
        apply List.ext_getElem?; intro n'
        rw [List.getElem?_modify, List.getElem?_modify]
        by_cases hn' : b = n'
        · subst hn'
          cases hx : col[b]? with
          | none => rfl
          | some x =>
            simp only [if_true, Option.map_eq_map, Option.map_some, Option.some.injEq, Prod.mk.injEq,
              true_and]
            apply modifyColAux_congr c P x.2
            intro col' hcol'
            apply h col'
            rw [colAt_node_cons, hc]; simp only [Option.bind_some, hx]; exact hcol'
        · simp [hn']
    · simp [hn]

theorem moveFun_modify (m : Move) (hij : m.i < m.j) {col : Column} (hj : m.j < col.length)
    (φ : Nat × Forest → Nat × Forest) :
    moveFun m (col.modify m.j φ) = (moveFun m col).modify m.i φ := by
  apply List.ext_getElem?; intro n
  rw [moveFun, getElem?_moveFun m _ hij.le (by simp; omega), List.getElem?_modify, moveFun,
    List.getElem?_modify, getElem?_moveFun m _ hij.le hj.le]
  have hb : m.bwdIdx m.i = m.j := by unfold Move.bwdIdx; rw [if_pos le_rfl]; omega
  have hiff : (m.j = m.bwdIdx n) ↔ (m.i = n) := by
    constructor
    · intro h'
      have := congrArg m.fwdIdx h'
      rw [fwdIdx_bwdIdx, ← hb, fwdIdx_bwdIdx] at this; exact this
    · rintro rfl; exact hb.symm
  simp only [hiff]

/-- helper: the entry function by which a height replacement below a column acts on it. -/
def setFun (R : List (Nat × Nat)) (X : Forest) : Nat × Forest → Nat × Forest :=
  match R.reverse with
  | [] => fun x => (x.1, X)
  | (bc, bi) :: Drev => fun x => (x.1, modifyColAux (fun col => col.modify bi fun y => (y.1, X)) Drev.reverse bc x.2)

theorem setFun_fst (R : List (Nat × Nat)) (X : Forest) (x : Nat × Forest) : (setFun R X x).1 = x.1 := by
  unfold setFun
  generalize R.reverse = l
  cases l with
  | nil => rfl
  | cons a l => rfl

theorem setHeight_as_mod {T : Forest} {b' : EntryAddr} {P R : List (Nat × Nat)} {cc e : Nat}
    (he : (T.entryAt b').isSome) (hb : b'.heightPath = P ++ (cc, e) :: R) (X : Forest) :
    T.setHeight b' X = modifyColAux (fun col => col.modify e (setFun R X)) P cc T := by
  show (if (T.entryAt b').isSome then Tree.setAux X b'.col.path b'.col.col b'.idx T else T) = _
  rw [if_pos he, setAux_eq_mod]
  simp only [EntryAddr.heightPath] at hb
  rcases List.eq_nil_or_concat' R with rfl | ⟨D, ⟨bc, bi⟩, rfl⟩
  · obtain ⟨h1, h2⟩ := List.append_inj' hb rfl
    simp only [List.cons.injEq, Prod.mk.injEq, and_true] at h2
    rw [h1, h2.1, h2.2]
    simp [setFun]
  · have hb' : b'.col.path ++ [(b'.col.col, b'.idx)] = (P ++ (cc, e) :: D) ++ [(bc, bi)] := by
      rw [hb]; simp
    obtain ⟨h1, h2⟩ := List.append_inj' hb' rfl
    simp only [List.cons.injEq, Prod.mk.injEq, and_true] at h2
    rw [h1, h2.1, h2.2, modifyColAux_append]
    simp [setFun]

theorem applyMove_setHeight {T : Forest} {m : Move} {col : Column} (hcol : T.colAt m.col = some col)
    (hij : m.i < m.j) (hj : m.j < col.length) {b' : EntryAddr} {R : List (Nat × Nat)}
    (hb' : b'.heightPath = m.col.path ++ (m.col.col, m.j) :: R) (he : (T.entryAt b').isSome)
    (X : Forest) :
    applyMove (T.setHeight b' X) m = (applyMove T m).setHeight (m.mapEntry m.fwdIdx b') X := by
  have hfb : (m.mapEntry m.fwdIdx b').heightPath = m.col.path ++ (m.col.col, m.i) :: R := by
    rw [heightPath_mapEntry, hb', mapPath_through, fwdIdx_j m hij]
  have he' : ((applyMove T m).entryAt (m.mapEntry m.fwdIdx b')).isSome := by
    have h1 : (applyMove T m).forestAt (m.mapEntry m.fwdIdx b').heightPath = T.forestAt b'.heightPath := by
      rw [hfb, hb']; exact forestAt_applyMove_through hcol hij hj R
    rw [Tree.forestAt_heightPath, Tree.forestAt_heightPath] at h1
    simp only [Tree.heightAt] at h1
    cases h2 : (applyMove T m).entryAt (m.mapEntry m.fwdIdx b') with
    | some _ => rfl
    | none => rw [h2] at h1; cases h3 : T.entryAt b' <;> simp_all
  rw [setHeight_as_mod he hb', setHeight_as_mod he' hfb]
  have hcol' : (modifyColAux (fun col => col.modify m.j (setFun R X)) m.col.path m.col.col T).colAt m.col =
      some (col.modify m.j (setFun R X)) := by
    rw [colAt_mod_self, hcol]; rfl
  rw [applyMove_eq_mod hcol' hij (by simp; omega), applyMove_eq_mod hcol hij hj, modifyColAux_comp,
    modifyColAux_comp]
  apply modifyColAux_congr
  intro col' hc'
  rw [show (⟨m.col.path, m.col.col⟩ : ColAddr) = m.col from rfl, hcol] at hc'
  obtain rfl := Option.some.inj hc'
  exact moveFun_modify m hij hj _

theorem repairList_snoc {K : Forest} {b : EntryAddr} {ms : List Move} {m : Move}
    (h : RepairList K b ms) (hm : RepairStepOK (applyMoves K ms) (moveAddr ms b) m) :
    RepairList K b (ms ++ [m]) := by
  intro idx hidx
  simp only [List.length_append, List.length_singleton] at hidx
  rcases Nat.lt_or_eq_of_le (Nat.lt_succ_iff.1 hidx) with hlt | rfl
  · rw [List.take_append_of_le_length hlt.le, List.getElem_append_left hlt]; exact h idx hlt
  · rw [List.take_left, List.getElem_append_right (by omega)]; simpa using hm

-- provides: U2, D3.1e (requested by U3 R12): the moves of an admissible cap that avoid the
-- marked height `B` form a repair list for `b` and commute with replacing `B`.
-- G-016: `hout` is `MovesOutside` (the original static exclusion is false, BP-04).
-- Moved here from before `moves_violate` (brief rule 5): its proof needs `applyMoves_litCap_addr`,
-- `moveAddr_num` and `repairList_height`; nothing in between uses it.
theorem moves_spec {E : Forest} (hE : InL E) (w : AdmCap E) (b : EntryAddr)
    (hb : b.heightPath <+: w.col.path) (hout : MovesOutside w.moves b) :
    RepairList (E.truncAfter b) b w.moves ∧
    (moveAddr w.moves b).col.num 0 = b.col.num 0 ∧
    (∀ X, applyMoves ((E.truncAfter b).setHeight b X) w.moves =
      (applyMoves (E.truncAfter b) w.moves).setHeight (moveAddr w.moves b) X) ∧
    (applyMoves (E.truncAfter b) w.moves).heightAt (moveAddr w.moves b) = E.heightAt b ∧
    w.H = (applyMoves (E.truncAfter b) w.moves).setHeight (moveAddr w.moves b)
      ((w.H.heightAt (moveAddr w.moves b)).getD Tree.empty) := by
  obtain ⟨col, hcol, hk, -⟩ := isUpward_iff_exists.1 w.upward
  obtain ⟨qb, Hb, hEb⟩ := heightAt_of_prefix hcol hb
  have hbE : b ∈ E.entryAddrs := (Tree.mem_entryAddrs_iff _ _).2 (by rw [hEb]; rfl)
  set T := E.truncAfter b with hT
  have hTb : T.entryAt b = E.entryAt b := Tree.entryAt_truncAfter hbE
  obtain ⟨S, hS⟩ := hb
  set X0 := litCapAux w.cut w.par S w.col.col Hb
  -- the literal cap is the truncation with the height at `b` replaced
  have hK0 : litCap E w.col w.cut w.par = T.setHeight b X0 := by
    obtain ⟨colb, hcolb, hbi⟩ := Tree.colAt_of_entryAt hEb
    rw [litCap_eq_aux hcol]
    have hpath : w.col.path = b.col.path ++ (b.col.col, b.idx) :: S := by
      rw [← hS]; simp [EntryAddr.heightPath]
    rw [hpath, litCapAux_trunc w.cut w.par w.col.col b.col.col b.idx S b.col.path E colb qb Hb hcolb hbi]
    show _ = (if (T.entryAt b).isSome then Tree.setAux X0 b.col.path b.col.col b.idx T else T)
    rw [hTb, hEb, if_pos (show (some (qb, Hb)).isSome = true from rfl)]
    show _ = Tree.setAux X0 b.col.path b.col.col b.idx
      (if (E.entryAt b).isSome then Tree.truncAux b.col.path b.col.col b.idx E else E)
    rw [hEb, if_pos (show (some (qb, Hb)).isSome = true from rfl)]
  have hH := hE.2.2.1
  -- the joint induction along the moves
  have key : ∀ q, q ≤ w.moves.length →
      RepairList T b (w.moves.take q) ∧
      ((applyMoves T (w.moves.take q)).entryAt (moveAddr (w.moves.take q) b)).isSome ∧
      ∀ X, applyMoves (T.setHeight b X) (w.moves.take q) =
        (applyMoves T (w.moves.take q)).setHeight (moveAddr (w.moves.take q) b) X := by
    intro q
    induction q with
    | zero => intro _; exact ⟨fun idx h => absurd h (by simp),
        by simp [moveAddr, moveAddrBody, applyMoves, hTb, hEb],
        fun X => by simp [moveAddr, moveAddrBody, applyMoves]⟩
    | succ q ih =>
      intro hq
      obtain ⟨hrl, hent, hcomm⟩ := ih (by omega)
      set bq := moveAddr (w.moves.take q) b
      set Tq := applyMoves T (w.moves.take q)
      set m := w.moves[q]
      have htake : w.moves.take (q + 1) = w.moves.take q ++ [m] := (List.take_concat_get' _ _ _).symm
      -- the move, read on the cap
      obtain ⟨hupq, heqq, -⟩ := applyMoves_litCap_addr hH w ⟨S, hS⟩ hout q (by omega)
      have hm : MoveOK (litCap E ⟨bq.heightPath ++ w.col.path.drop b.heightPath.length, w.col.col⟩
          w.cut w.par) m := by
        have := w.movesValid q (by omega); rw [heqq] at this; exact this
      have hSd : w.col.path.drop b.heightPath.length = S := by rw [← hS]; simp
      rw [hSd] at hm hupq heqq
      obtain ⟨rest, hrest, -, -, -⟩ := litCap_move_step hH hupq hm
      have hno := hout q (by omega)
      simp only at hrest
      obtain ⟨T', hT'⟩ : ∃ T', bq.heightPath = m.col.path ++ (m.col.col, m.j) :: T' := by
        have h1 : bq.heightPath <+: m.col.path ++ (m.col.col, m.j) :: rest := ⟨S, hrest⟩
        have h2 : m.col.path ++ [(m.col.col, m.j)] <+: m.col.path ++ (m.col.col, m.j) :: rest :=
          ⟨rest, by simp⟩
        rcases List.prefix_or_prefix_of_prefix h1 h2 with h | h
        · obtain ⟨U, hU⟩ := h
          rcases List.eq_nil_or_concat' U with rfl | ⟨U', u, rfl⟩
          · exact ⟨[], by simpa using hU⟩
          · exfalso; apply hno
            rw [← List.append_assoc] at hU
            obtain ⟨hU1, -⟩ := List.append_inj' hU rfl
            exact ⟨U', hU1⟩
        · obtain ⟨T', hTT⟩ := h; exact ⟨T', by rw [← hTT]; simp⟩
      -- the cap is the moved truncation with the height at `bq` replaced
      have hKq : applyMoves (litCap E w.col w.cut w.par) (w.moves.take q) = Tq.setHeight bq X0 := by
        rw [hK0, hcomm]
      rw [heqq] at hKq
      obtain ⟨colK, sdK, hcolK, -, hjK, hijK, -, hparK, -, -⟩ := hm
      rw [hKq, setHeight_as_mod hent hT', colAt_mod_self] at hcolK
      obtain ⟨colT, hcolT, rfl⟩ := Option.map_eq_some_iff.1 hcolK
      have hjT : m.j < colT.length := by simp at hjK; omega
      have hlab : ∀ x, ((colT.modify m.j (setFun T' X0)).getD x (0, Tree.empty)).1 =
          (colT.getD x (0, Tree.empty)).1 := by
        intro x
        simp only [List.getD_eq_getElem?_getD, List.getElem?_modify]
        cases colT[x]? with
        | none => rfl
        | some y =>
          simp only [Option.map_eq_map, Option.map_some, Option.getD_some]
          split
          · exact setFun_fst T' X0 y
          · rfl
      have hstep : RepairStepOK Tq bq m := by
        refine ⟨colT, hcolT, hijK, hjT, ?_, fun x h1 h2 => ?_, ?_⟩
        · rcases List.eq_nil_or_concat' T' with rfl | ⟨D, d, rfl⟩
          · left
            simp only [EntryAddr.heightPath] at hT'
            obtain ⟨h1, h2⟩ := List.append_inj' hT' rfl
            simp only [List.cons.injEq, Prod.mk.injEq, and_true] at h2
            show m.col = bq.col
            rcases m with ⟨⟨mp, mc⟩, mi, mj⟩; rcases bq with ⟨⟨bp, bc⟩, bi⟩
            simp_all
          · right; refine ⟨m.j, D, ?_⟩
            simp only [EntryAddr.heightPath] at hT' ⊢
            have : bq.col.path ++ [(bq.col.col, bq.idx)] = (m.col.path ++ (m.col.col, m.j) :: D) ++ [d] := by
              rw [hT']; simp
            obtain ⟨h1, -⟩ := List.append_inj' this rfl
            rw [h1]; simp
        · have := hparK x h1 h2; rw [hlab, hlab] at this; exact this
        · rcases List.eq_nil_or_concat' T' with rfl | ⟨D, d, rfl⟩
          · left
            simp only [EntryAddr.heightPath] at hT'
            obtain ⟨h1, h2⟩ := List.append_inj' hT' rfl
            simp only [List.cons.injEq, Prod.mk.injEq, and_true] at h2
            rcases m with ⟨⟨mp, mc⟩, mi, mj⟩; rcases bq with ⟨⟨bp, bc⟩, bi⟩
            simp_all
          · right; refine ⟨D, ?_⟩
            simp only [EntryAddr.heightPath] at hT' ⊢
            have : bq.col.path ++ [(bq.col.col, bq.idx)] = (m.col.path ++ (m.col.col, m.j) :: D) ++ [d] := by
              rw [hT']; simp
            obtain ⟨h1, -⟩ := List.append_inj' this rfl
            rw [h1]; simp
      refine ⟨by rw [htake]; exact repairList_snoc hrl hstep, ?_, fun X => ?_⟩
      · rw [htake, applyMoves_snoc, moveAddr_snoc]
        have := heightAt_repairStep hstep
        simp only [Tree.heightAt] at this
        cases h1 : (applyMove Tq m).entryAt (m.mapEntry m.fwdIdx bq) with
        | some _ => rfl
        | none => rw [h1] at this; cases h2 : Tq.entryAt bq <;> simp_all
      · rw [htake, applyMoves_snoc, applyMoves_snoc, moveAddr_snoc, hcomm X]
        exact applyMove_setHeight hcolT hijK hjT hT' hent X
  obtain ⟨hrl, hent, hcomm⟩ := key w.moves.length le_rfl
  rw [List.take_length] at hrl hent hcomm
  have hbn : moveAddr w.moves b ∈ (applyMoves T w.moves).entryAddrs :=
    (Tree.mem_entryAddrs_iff _ _).2 hent
  refine ⟨hrl, moveAddr_num _ _, hcomm, ?_, ?_⟩
  · rw [repairList_height hrl, Tree.heightAt, hTb]; rfl
  · have hwH : w.H = (applyMoves T w.moves).setHeight (moveAddr w.moves b) X0 := by
      show applyMoves (litCap E w.col w.cut w.par) w.moves = _
      rw [hK0, hcomm]
    rw [hwH, (Tree.setHeight_basic _ _ X0 hbn).2.1, Option.getD_some]



/-! ## D3.3, L3.5 — kernels, contexts, filling identity, cancellation -/

/-- D3.3: the root forest `F = F_j` (the forest containing the root column). -/
def rootForest (E : Forest) (rd : RootData) : Forest := (E.forestAt rd.col.path).getD Tree.empty

/-- D3.3: the root column `R`. -/
def rootCol (E : Forest) (rd : RootData) : Column := (E.colAt rd.col).getD []

/-- D3.3: the unconsumed root suffix `U = R[c:]`. -/
def unconsumed (E : Forest) (rd : RootData) : Column := (rootCol E rd).drop rd.cursor

/-- D3.3: the period `d = t − r`. -/
def period (sd : StopData) : Nat := sd.t - sd.r

/-- D3.3: the hole depth `ℓ − j` (relative to the root forest). -/
def holeDepth (sd : StopData) (rd : RootData) : Nat := sd.depth - rd.layer

/-- D3.3: the kernel is defined unless the owner root is exhausted (txt:129). -/
def KernelDefined (E : Forest) (rd : RootData) : Prop := rd.owner = true → unconsumed E rd ≠ []

/-- D3.3 (txt:421-422): the kernel `F_E(X)`: one period of the ordinary loop with its rightmost
continuation hole filled by `T_{r,t−r}(X)`. Body case: head `Q ⌢ U'` then
`A_{r,d,ℓ−j,T_d X}(F[i+1:])`; owner case: the head alone, its last restored height using
`A_{r,d,ℓ−j−1,T_d X}`. -/
def kernel (E : Forest) (sd : StopData) (rd : RootData) (X : Forest) : Forest :=
  let r := sd.r
  let d := period sd
  let U := unconsumed E rd
  if rd.owner then
    .node [sd.Q ++ mapLast (fun x => (x.1, shift r d x.2))
      (fun x => (x.1, replaceAt r d (shift r d X) (holeDepth sd rd - 1) x.2)) U]
  else
    .node ((sd.Q ++ U.map fun x => (x.1, shift r d x.2)) ::
      (replaceAt r d (shift r d X) (holeDepth sd rd)
        (.node ((rootForest E rd).cols.drop (rd.idx + 1)))).cols)

/-- D3.3 (txt:422): the terminal context `C_E(Z) = A_{0,0,ℓ,Z}(E)`; also the paper's
`fill(K, Y)` (txt:440). -/
def context (E : Forest) (sd : StopData) (Z : Forest) : Forest := replaceAt 0 0 Z sd.depth E

/-- D3.3b: the kernel's word prefix `P = w(F_E(∅))`. -/
def kerPrefix (E : Forest) (sd : StopData) (rd : RootData) : List WordAtom :=
  word (kernel E sd rd Tree.empty)

/-- D3.3b: the letterwise embedding `Σ`: depth translation by `2(ℓ−j)`, parent shift `T_{r,d}`.
VERIFY-U2 (F1): the parent shift is applied only to entry atoms. An empty-column atom `(2e, 0, 0)`
(even depth coordinate, marker `0`) keeps its third coordinate: shifting it would turn `(2e,0,0)`
into `(2e,0,d)` when `r = 0`, and `word_kernel` would fail (e.g. `E = seed 1`, `X = [[],[]]`). -/
def kerSigma (sd : StopData) (rd : RootData) (A : WordAtom) : WordAtom :=
  toLex ((ofLex A).1 + 2 * holeDepth sd rd,
    toLex ((ofLex (ofLex A).2).1,
      if (ofLex A).1 % 2 = 0 ∧ (ofLex (ofLex A).2).1 = 0 then (ofLex (ofLex A).2).2
      else shiftVal sd.r (period sd) (ofLex (ofLex A).2).2))

/-- D3.3b: depth translation of an atom by `e` levels. -/
def depthShift (e : Nat) (A : WordAtom) : WordAtom := toLex ((ofLex A).1 + 2 * e, (ofLex A).2)

/-! ### D3.3a helpers: the loop identity -/

/-- D3.3a helper: the columns of a relabelled tree. -/
theorem ker_map_cols {α β : Type} (f : α → β) (T : Tree α) :
    (Tree.map f T).cols = T.cols.map (Tree.mapCol f) := by
  obtain ⟨cs⟩ := T
  simp only [Tree.map, Tree.cols]
  exact treeMapCols_eq_map f cs

/-- D3.3a helper: a shift of a node. -/
theorem ker_shift_node (r a : Nat) (cs : List Column) :
    shift r a (Tree.node cs) = Tree.node (cs.map (Tree.mapCol (shiftVal r a))) := by
  simp only [shift, Tree.map]
  rw [treeMapCols_eq_map]

/-- D3.3a helper: `mapCol` distributes over an append. -/
theorem ker_mapCol_append {α β : Type} (f : α → β) (l₁ l₂ : List (α × Tree α)) :
    Tree.mapCol f (l₁ ++ l₂) = Tree.mapCol f l₁ ++ Tree.mapCol f l₂ := by
  rw [treeMapCol_eq_map, treeMapCol_eq_map, treeMapCol_eq_map, List.map_append]

/-- D3.3a helper: `mapCol (shiftVal r 0)` is the identity. -/
theorem ker_mapCol_zero (r : Nat) (l : Column) : Tree.mapCol (shiftVal r 0) l = l := by
  rw [shiftVal_zero_fun, treeMapCol_id]

/-- D3.3a helper: a shift fixes the outer parents `< r` of a column whose heights are shifted. -/
theorem ker_mapCol_heights {r a b : Nat} {l : Column} (hl : ∀ x ∈ l, x.1 < r) :
    Tree.mapCol (shiftVal r a) (l.map fun x => (x.1, shift r b x.2)) =
      l.map fun x => (x.1, shift r (a + b) x.2) := by
  rw [treeMapCol_eq_map, List.map_map]
  apply List.map_congr_left
  intro x hx
  simp only [Function.comp]
  have h1 : shiftVal r a x.1 = x.1 := by
    have := hl x hx
    unfold shiftVal; rw [if_neg (by omega)]
  rw [h1]
  exact Prod.ext rfl (shift_add r a b x.2)

/-- D3.3a helper: a shift composes with a shifted placement. -/
theorem ker_shift_replaceAt (r a b k : Nat) (Y G : Forest) :
    shift r a (replaceAt r b Y k G) = replaceAt r (a + b) (shift r a Y) k G := by
  rw [replaceAt_eq_shift r b, shift_replaceAt, replaceAt_eq_shift r a, shift_add,
    ← replaceAt_eq_shift]

/-- D3.3a helper: the outer parents of the unconsumed root suffix are `< r` (V). -/
theorem ker_unconsumed_lt {E : Forest} {sd : StopData} {rd : RootData} (hV : CondV E)
    (hsd : stopData E = some sd) (hrd : rootData E = some rd) :
    ∀ x ∈ unconsumed E rd, x.1 < sd.r := by
  intro x hx
  obtain ⟨-, -, -, hnum, -, hmem, -⟩ := rootData_spec hsd hrd
  have hx' : x ∈ rootCol E rd := List.mem_of_mem_drop hx
  unfold rootCol at hx'
  obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff E rd.col).1 hmem)
  rw [hcol, Option.getD_some] at hx'
  obtain ⟨i, hi, hxi⟩ := List.getElem_of_mem hx'
  have he : E.entryAt ⟨rd.col, i⟩ = some x := by
    simp only [Tree.entryAt, hcol, Option.bind_some, List.getElem?_eq_getElem hi, hxi]
  have hmemE : (⟨rd.col, i⟩ : EntryAddr) ∈ E.entryAddrs :=
    (Tree.mem_entryAddrs_iff _ _).2 (by rw [he]; rfl)
  have := (condV_iff_lt E).1 hV ⟨rd.col, i⟩ hmemE x.1 x.2 he
  rw [hnum] at this
  exact this

/-- D3.3a helper: pass `k + 1` of the loop on a `τ_{kd}`-shifted input is the `τ_{kd}`-shift of
pass `1` (outer parents of `U` are `< r`). -/
theorem ker_ordStep_shift {sd : StopData} {rd : RootData} {F : Forest} {U : Column}
    (hU : ∀ x ∈ U, x.1 < sd.r) (k : Nat) (Y : Forest) :
    ordStep sd rd F U (k + 1) (shift sd.r (k * (sd.t - sd.r)) Y) =
      shift sd.r (k * (sd.t - sd.r)) (ordStep sd rd F U 1 Y) := by
  unfold ordStep
  simp only [Nat.add_sub_cancel, Nat.sub_self, Nat.zero_mul, Nat.one_mul, ker_mapCol_zero]
  have hkd : (k + 1) * (sd.t - sd.r) = k * (sd.t - sd.r) + (sd.t - sd.r) := Nat.succ_mul _ _
  by_cases ho : rd.owner = true
  · simp only [ho, if_true]
    rw [ker_shift_node, List.map_cons, List.map_nil, ker_mapCol_append, ker_mapCol_append]
    have hdl : ∀ x ∈ U.dropLast, x.1 < sd.r := fun x hx => hU x (List.mem_of_mem_dropLast hx)
    rw [ker_mapCol_heights hdl, ← hkd]
    congr 3
    cases hl : U.getLast? with
    | none => rfl
    | some u =>
      have hu := hU u (List.mem_of_getLast? hl)
      simp only [Option.map_some, Option.toList_some, Tree.mapCol]
      have h1 : shiftVal sd.r (k * (sd.t - sd.r)) u.1 = u.1 := by
        unfold shiftVal; rw [if_neg (by omega)]
      rw [h1]
      congr 2
      show replaceAt _ _ _ _ _ = shift sd.r _ (replaceAt _ _ _ _ _)
      rw [ker_shift_replaceAt, hkd]
  · simp only [ho, Bool.false_eq_true, if_false]
    rw [ker_shift_node, List.map_cons, ker_mapCol_append, ker_mapCol_heights hU, ← hkd]
    congr 2
    rw [← ker_map_cols]
    show (replaceAt _ _ _ _ _).cols = (shift sd.r _ (replaceAt _ _ _ _ _)).cols
    rw [ker_shift_replaceAt, hkd]

/-- D3.3a helper: pass `1` on a `T_d`-shifted input is the kernel. -/
theorem ker_ordStep_one (E : Forest) (sd : StopData) (rd : RootData) (X : Forest) :
    ordStep sd rd (rootForest E rd) (unconsumed E rd) 1 (shift sd.r (sd.t - sd.r) X) =
      kernel E sd rd X := by
  unfold ordStep kernel
  simp only [Nat.sub_self, Nat.zero_mul, Nat.one_mul, ker_mapCol_zero]
  by_cases ho : rd.owner = true
  · simp only [ho, if_true, mapLast_eq, List.append_assoc]
    rfl
  · simp only [ho, Bool.false_eq_true, if_false]
    rfl

/-- D3.3a helper: after the passes `k, …, 1` on `τ_{kd}(F^m ∅)` the loop variable is
`F^{m+k} ∅`. -/
theorem ker_ordLoop {E : Forest} {sd : StopData} {rd : RootData}
    (hU : ∀ x ∈ unconsumed E rd, x.1 < sd.r) :
    ∀ (k m : Nat), ordLoop (ordStep sd rd (rootForest E rd) (unconsumed E rd)) k
      (shift sd.r (k * (sd.t - sd.r)) ((kernel E sd rd)^[m] Tree.empty)) =
        (kernel E sd rd)^[m + k] Tree.empty
  | 0, m => by simp only [ordLoop, Nat.zero_mul, shift_zero, Nat.add_zero]
  | k + 1, m => by
    simp only [ordLoop]
    rw [Nat.succ_mul, ← shift_add, ker_ordStep_shift hU, ker_ordStep_one,
      ← Function.iterate_succ_apply' (kernel E sd rd) m, ker_ordLoop hU k (m + 1)]
    rw [Nat.add_assoc, Nat.add_comm 1 k]

/-- D3.3a helper: the final loop variable of an ordinary step is the `n`-th kernel iterate. -/
theorem ker_ordZ {E : Forest} {sd : StopData} {rd : RootData} (hV : CondV E)
    (hsd : stopData E = some sd) (hrd : rootData E = some rd) (n : Nat) :
    ordZ E sd rd n = (kernel E sd rd)^[n] Tree.empty := by
  have h := ker_ordLoop (ker_unconsumed_lt hV hsd hrd) n 0
  rw [Function.iterate_zero_apply, Nat.zero_add] at h
  have he : shift sd.r (n * (sd.t - sd.r)) Tree.empty = Tree.empty := rfl
  rw [he] at h
  exact h

-- provides: U2, D3.3a (txt:422: `H[q] = C_H(F_H^q(∅))`)
theorem expand_eq_iterate {E : Forest} {sd : StopData} {rd : RootData} (hE : E ≠ Tree.empty)
    (hV : CondV E) (hI : CondI E) (hk : stepKind E = some .ordinary)
    (hsd : stopData E = some sd) (hrd : rootData E = some rd) (hdef : KernelDefined E rd)
    (n : Nat) : expand E n = some (context E sd ((kernel E sd rd)^[n] Tree.empty)) := by
  rw [expand_eq_paperOp hE hV hI, paperOp_ordinary hk hsd hrd]
  have hc : (rd.owner && n != 0 && (((E.colAt rd.col).getD []).drop rd.cursor).isEmpty) = false := by
    by_cases ho : rd.owner = true
    · have hU : unconsumed E rd ≠ [] := hdef ho
      unfold unconsumed rootCol at hU
      simp [hU]
    · simp [ho]
  simp only [hc, Bool.false_eq_true, if_false]
  rw [← ker_ordZ hV hsd hrd]
  rfl

-- D3.3a: the exhausted owner root is the only undefined case
theorem expand_none_iff {E : Forest} {sd : StopData} {rd : RootData} (hE : E ≠ Tree.empty)
    (hV : CondV E) (hI : CondI E) (hk : stepKind E = some .ordinary)
    (hsd : stopData E = some sd) (hrd : rootData E = some rd) (n : Nat) :
    expand E n = none ↔ (1 ≤ n ∧ ¬ KernelDefined E rd) := by
  rw [expand_eq_paperOp hE hV hI, paperOp_ordinary hk hsd hrd]
  unfold KernelDefined unconsumed rootCol
  by_cases hc : (rd.owner && n != 0 && (((E.colAt rd.col).getD []).drop rd.cursor).isEmpty) = true
  · rw [if_pos hc]
    simp only [Bool.and_eq_true, bne_iff_ne, ne_eq, List.isEmpty_iff] at hc
    obtain ⟨⟨ho, hn⟩, hU⟩ := hc
    simp only [true_iff]
    exact ⟨by omega, fun h => h ho hU⟩
  · rw [if_neg hc]
    simp only [reduceCtorEq, false_iff, not_and, not_not]
    intro hn ho
    simp only [Bool.and_eq_true, bne_iff_ne, ne_eq, List.isEmpty_iff, not_and] at hc
    exact hc ⟨ho, by omega⟩

-- VERIFY-U2 (F2): D3.3a part 3: at parameter `0` the ordinary output is `C_E(∅)` with no
-- `KernelDefined` hypothesis (the exhausted owner root only matters for `n ≥ 1`); needed by
-- T3.2g and `expand_lt` (V, I only) and by T3.8c.3
theorem expand_zero_eq_context {E : Forest} {sd : StopData} (hE : E ≠ Tree.empty)
    (hV : CondV E) (hI : CondI E) (hk : stepKind E = some .ordinary)
    (hsd : stopData E = some sd) : expand E 0 = some (context E sd Tree.empty) := by
  rw [expand_eq_paperOp hE hV hI, paperOp_ordinary_zero hk hsd]
  rfl

/-! ### D3.3b helpers: the route to the hole and words of placements -/

/-- D3.3b helper: the last-column, last-entry route of `F` reaches a column at depth `k` (so
`replaceAt _ _ _ k F` places its filling there). -/
def KerRoute : Nat → Forest → Prop
  | 0, F => F.cols ≠ []
  | k + 1, F => ∃ col p H, F.cols.getLast? = some col ∧ col.getLast? = some (p, H) ∧ KerRoute k H

/-- D3.3b helper: `word_put` for an arbitrary forest whose route reaches depth `k`. -/
theorem ker_wordAt_replaceAt (Z : Forest) :
    ∀ (k : Nat) (F : Forest) (e : Nat), KerRoute k F →
      wordAt e (replaceAt 0 0 Z k F) = wordAt e (replaceAt 0 0 Tree.empty k F) ++ wordAt (e + k) Z
  | 0, .node cols, e, h => by
    obtain ⟨zc⟩ := Z
    cases cols with
    | nil => exact absurd rfl h
    | cons c cs =>
      simp only [replaceAt, wordAt, Tree.cols, Tree.empty, List.append_nil, wordCols_append,
        Nat.add_zero]
  | k + 1, .node cols, e, h => by
    obtain ⟨col, p, H, hc, hl, hk⟩ := h
    have ih := ker_wordAt_replaceAt Z k H (e + 1) hk
    simp only [Tree.cols] at hc
    simp only [replaceAt, mapLast_eq, hc, hl, Option.map_some, Option.toList_some, wordAt,
      wordCols_append, wordCols, List.append_nil]
    rw [wordCol_snoc, wordCol_snoc e _ _ (replaceAt 0 0 Tree.empty k H), ih]
    simp only [List.append_assoc]
    rw [show e + 1 + k = e + (k + 1) by omega]

/-- D3.3b helper: relabelling keeps the route. -/
theorem ker_route_map {f : Nat → Nat} :
    ∀ (k : Nat) (F : Forest), KerRoute k F → KerRoute k (Tree.map f F)
  | 0, F, h => by
    show (Tree.map f F).cols ≠ []
    rw [ker_map_cols]
    exact fun h' => h (List.map_eq_nil_iff.1 h')
  | k + 1, F, h => by
    obtain ⟨col, p, H, hc, hl, hk⟩ := h
    refine ⟨Tree.mapCol f col, f p, Tree.map f H, ?_, ?_, ker_route_map k H hk⟩
    · rw [ker_map_cols, List.getLast?_map, hc]; rfl
    · rw [treeMapCol_eq_map, List.getLast?_map, hl]; rfl

/-- D3.3b helper: shifting keeps the route. -/
theorem ker_route_shift {r d k : Nat} {F : Forest} (h : KerRoute k F) : KerRoute k (shift r d F) :=
  ker_route_map k F h

/-- D3.3b helper: one step down the route. -/
theorem ker_forestAt_lastStep {G : Forest} {col : Column} {p : Nat} {H : Forest}
    (hc : G.cols.getLast? = some col) (hl : col.getLast? = some (p, H)) :
    G.forestAt [(G.cols.length - 1, col.length - 1)] = some H := by
  have h1 : G.cols[G.cols.length - 1]? = some col := by rw [← List.getLast?_eq_getElem?]; exact hc
  have h2 : col[col.length - 1]? = some (p, H) := by rw [← List.getLast?_eq_getElem?]; exact hl
  simp only [Tree.forestAt, h1, Option.bind_some, h2]

/-- D3.3b helper: along the stopping route, the forest at depth `j` has a route of depth `ℓ − j`. -/
theorem ker_route_of_stop {E : Forest} {sd : StopData} (hsd : stopData E = some sd) :
    ∀ j, j ≤ sd.depth →
      ∃ G, E.forestAt (sd.col.path.take j) = some G ∧ KerRoute (sd.depth - j) G := by
  obtain ⟨-, hdep, -, hmem, -⟩ := stopData_spec hsd
  obtain ⟨hpath, F, hF, hFlen⟩ := (Scan.mem_routeCols_iff E sd.col).1 hmem
  suffices h : ∀ m j, j + m = sd.col.path.length →
      ∃ G, E.forestAt (sd.col.path.take j) = some G ∧ KerRoute m G by
    intro j hj
    exact h (sd.depth - j) j (by omega)
  intro m
  induction m with
  | zero =>
    intro j hj
    refine ⟨F, ?_, ?_⟩
    · rw [List.take_of_length_le (by omega)]; exact hF
    · show F.cols ≠ []
      intro h; rw [h] at hFlen; simp at hFlen
  | succ m ih =>
    intro j hj
    obtain ⟨H, hH, hHr⟩ := ih (j + 1) (by omega)
    obtain ⟨G, hG, hlast⟩ := hpath j (by omega)
    refine ⟨G, hG, ?_⟩
    have hj' : j < sd.col.path.length := by omega
    rw [List.getElem?_eq_getElem hj'] at hlast
    unfold Tree.lastStep? at hlast
    cases hgc : G.cols.getLast? with
    | none => rw [hgc] at hlast; simp at hlast
    | some col =>
      rw [hgc] at hlast
      simp only [Option.bind_some] at hlast
      split at hlast
      · simp at hlast
      · rename_i hne
        have hstep : sd.col.path[j] = (G.cols.length - 1, col.length - 1) :=
          (Option.some.inj hlast).symm
        have hcol : col ≠ [] := by simpa using hne
        obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 (List.getLast?_isSome.2 hcol)
        obtain ⟨p, H'⟩ := x
        rw [List.take_add_one, List.getElem?_eq_getElem hj', Option.toList_some,
          Tree.forestAt_append, hG, Option.bind_some, hstep, ker_forestAt_lastStep hgc hx] at hH
        cases hH
        exact ⟨col, p, H, hgc, hx, hHr⟩

/-- D3.3b helper: the root forest has a route of depth `ℓ − j`. -/
theorem ker_route_rootForest {E : Forest} {sd : StopData} {rd : RootData}
    (hsd : stopData E = some sd) (hrd : rootData E = some rd) :
    E.forestAt rd.col.path = some (rootForest E rd) ∧
      KerRoute (holeDepth sd rd) (rootForest E rd) := by
  obtain ⟨-, -, hlay, hpre, -⟩ := rootData_path hsd hrd
  obtain ⟨-, hdep, -⟩ := stopData_spec hsd
  have hle : rd.layer ≤ sd.depth := rootData_layer_le hsd hrd
  obtain ⟨G, hG, hR⟩ := ker_route_of_stop hsd rd.layer hle
  have hp : rd.col.path = sd.col.path.take rd.layer := by
    rw [hlay]; exact List.prefix_iff_eq_take.1 hpre
  rw [← hp] at hG
  have : rootForest E rd = G := by unfold rootForest; rw [hG]; rfl
  rw [this]
  exact ⟨hG, hR⟩

/-- D3.3b helper: shifts fix the empty forest. -/
theorem ker_shift_empty (r d : Nat) : shift r d Tree.empty = Tree.empty := rfl

/-- D3.3b helper: words of a node are the words of its columns. -/
theorem ker_wordCols_cols (e : Nat) (T : Forest) : wordCols e T.cols = wordAt e T := by
  obtain ⟨cs⟩ := T; rfl

/-- D3.3b helper: the word of a shifted forest placed at depth `δ`. -/
theorem ker_wordAt_shift (sd : StopData) (rd : RootData) (X : Forest) :
    wordAt (holeDepth sd rd) (shift sd.r (period sd) X) = (word X).map (kerSigma sd rd) := by
  rw [show holeDepth sd rd = 0 + holeDepth sd rd by omega, wordAt_add, shift, wordAt_map,
    List.map_map]
  unfold word
  apply List.map_congr_left
  intro A _
  simp only [Function.comp, WordAtom.relabel, kerSigma]
  split_ifs <;> rfl

-- D3.3b: the context appends the word of its filling at depth `ℓ`
theorem word_context {E : Forest} {sd : StopData} (hsd : stopData E = some sd) (Z : Forest) :
    word (context E sd Z) = word (context E sd Tree.empty) ++ (word Z).map (depthShift sd.depth) := by
  obtain ⟨G, hG, hR⟩ := ker_route_of_stop hsd 0 (Nat.zero_le _)
  simp only [List.take_zero, Tree.forestAt, Option.some.injEq] at hG
  subst hG
  rw [Nat.sub_zero] at hR
  unfold context word
  rw [ker_wordAt_replaceAt Z _ _ 0 hR, Nat.zero_add, show sd.depth = 0 + sd.depth by omega,
    wordAt_add, Nat.zero_add]
  rfl

-- D3.3b (txt:422): `w(F_E(X)) = P ⌢ Σ(w(X))`
theorem word_kernel {E : Forest} {sd : StopData} {rd : RootData} (hV : CondV E)
    (hsd : stopData E = some sd) (hrd : rootData E = some rd) (hkd : KernelDefined E rd)
    (X : Forest) :
    word (kernel E sd rd X) = kerPrefix E sd rd ++ (word X).map (kerSigma sd rd) := by
  rw [← ker_wordAt_shift]
  obtain ⟨hF, hR⟩ := ker_route_rootForest hsd hrd
  obtain ⟨-, -, hidx, -, -, hmem, -, hown⟩ := rootData_spec hsd hrd
  obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff E rd.col).1 hmem)
  have hcolF : (rootForest E rd).cols[rd.idx]? = some col := by
    unfold Tree.colAt at hcol; rw [hF, Option.bind_some, ← hidx] at hcol; exact hcol
  have hidxlt : rd.idx < (rootForest E rd).cols.length := by
    by_contra h; rw [List.getElem?_eq_none (by omega)] at hcolF; cases hcolF
  unfold kerPrefix kernel
  by_cases ho : rd.owner = true
  · simp only [ho, if_true]
    have hlast : rd.idx + 1 = (rootForest E rd).cols.length := by
      obtain ⟨F', hF', h'⟩ := hown.1 ho
      rw [hF] at hF'; cases hF'; rw [hidx]; exact h'
    have hlay := rootData_layer_lt hsd hrd ho
    have hδ : holeDepth sd rd = (holeDepth sd rd - 1) + 1 := by unfold holeDepth; omega
    have hR' := hR
    rw [hδ] at hR'
    obtain ⟨lcol, p, H, hlc, hlh, hHR⟩ := hR'
    have hlcol : lcol = col := by
      rw [List.getLast?_eq_getElem?, ← hlast, Nat.add_sub_cancel, hcolF] at hlc
      exact (Option.some.inj hlc).symm
    subst hlcol
    have hU : unconsumed E rd ≠ [] := hkd ho
    have hUl : (unconsumed E rd).getLast? = some (p, H) := by
      unfold unconsumed rootCol
      rw [hcol, Option.getD_some, List.getLast?_drop, if_neg, hlh]
      intro hle
      apply hU
      unfold unconsumed rootCol
      rw [hcol, Option.getD_some]
      exact List.drop_eq_nil_of_le hle
    simp only [mapLast_eq, hUl, Option.map_some, Option.toList_some, word, wordAt, wordCols,
      List.append_nil, ← List.append_assoc, ker_shift_empty,
      replaceAt_eq_shift sd.r (period sd)]
    rw [wordCol_snoc, wordCol_snoc 0 _ _ (replaceAt 0 0 Tree.empty _ _),
      ker_wordAt_replaceAt _ _ _ _ (ker_route_shift hHR),
      show 0 + 1 + (holeDepth sd rd - 1) = holeDepth sd rd by omega]
    simp only [List.append_assoc]
  · simp only [ho, Bool.false_eq_true, if_false]
    have hlt : rd.idx + 1 < (rootForest E rd).cols.length := by
      rcases Nat.lt_or_ge (rd.idx + 1) (rootForest E rd).cols.length with h | h
      · exact h
      · exact absurd (hown.2 ⟨_, hF, by rw [← hidx]; omega⟩) ho
    have hRb : KerRoute (holeDepth sd rd) (Tree.node ((rootForest E rd).cols.drop (rd.idx + 1))) := by
      cases hδ : holeDepth sd rd with
      | zero =>
        show (rootForest E rd).cols.drop (rd.idx + 1) ≠ []
        intro h; have := congrArg List.length h; simp at this; omega
      | succ k =>
        rw [hδ] at hR
        obtain ⟨lcol, p, H, hlc, hlh, hHR⟩ := hR
        refine ⟨lcol, p, H, ?_, hlh, hHR⟩
        show ((rootForest E rd).cols.drop (rd.idx + 1)).getLast? = some lcol
        rw [List.getLast?_drop, if_neg (by omega), hlc]
    simp only [word, wordAt, wordCols, ker_wordCols_cols, ker_shift_empty,
      replaceAt_eq_shift sd.r (period sd)]
    rw [ker_wordAt_replaceAt _ _ _ 0 (ker_route_shift hRb), Nat.zero_add, List.append_assoc]

-- D3.3b: `|P| > 0` and `Σ` is an order embedding
theorem kerPrefix_ne_nil (E : Forest) (sd : StopData) (rd : RootData) : kerPrefix E sd rd ≠ [] := by
  have hcol : ∀ (c : Column) (cs : List Column), word (Tree.node (c :: cs)) ≠ [] := by
    intro c cs
    simp only [word, wordAt, wordCols]
    cases c with
    | nil => simp [wordCol]
    | cons x xs => obtain ⟨p, h⟩ := x; simp [wordCol]
  unfold kerPrefix kernel
  split
  · exact hcol _ _
  · exact hcol _ _

/-- D3.3b helper: `shiftVal` is strictly increasing. -/
theorem ker_shiftVal_strictMono (r d : Nat) : StrictMono (shiftVal r d) := by
  intro p q h
  unfold shiftVal
  split_ifs <;> omega

theorem kerSigma_strictMono (sd : StopData) (rd : RootData) : StrictMono (kerSigma sd rd) := by
  intro A B h
  unfold kerSigma
  rw [Prod.Lex.lt_iff] at h ⊢
  rw [Prod.Lex.lt_iff] at h
  simp only [ofLex_toLex]
  rw [Prod.Lex.toLex_lt_toLex]
  rcases h with h | ⟨h1, h | ⟨h2, h3⟩⟩
  · left; omega
  · right; exact ⟨by omega, Or.inl h⟩
  · right
    refine ⟨by omega, Or.inr ⟨h2, ?_⟩⟩
    simp only
    rw [h1, h2]
    split_ifs
    · exact h3
    · exact ker_shiftVal_strictMono _ _ h3

theorem depthShift_strictMono (e : Nat) : StrictMono (depthShift e) := by
  intro A B h
  unfold depthShift
  rw [Prod.Lex.lt_iff] at h ⊢
  simp only [ofLex_toLex]
  rcases h with h | ⟨h1, h2⟩
  · left; omega
  · right; exact ⟨by omega, h2⟩

/-- L3.5: `rt_{ρ,c}(D)`: the root forest suffix from the root column, with the first `c` entries
of that column deleted (the column is retained even if empty). -/
def rootTail (D : Forest) (rd : RootData) (c : Nat) : Forest :=
  .node ((((D.colAt rd.col).getD []).drop c) ::
    ((D.forestAt rd.col.path).getD Tree.empty).cols.drop (rd.idx + 1))

/-- L3.5: `Q ⋄ X` prepends `Q` to the first column of a nonempty `X`. -/
def diamond (Q : Column) (X : Forest) : Forest :=
  match X with
  | .node (c :: cs) => .node ((Q ++ c) :: cs)
  | .node [] => .node []

/-- L3.5: `e_1(X)`: the first column's entries encoded as continuation entries (no marker),
then the remaining columns. -/
def encOne (X : Forest) : List WordAtom :=
  match X with
  | .node (c :: cs) => wordLater 0 c ++ wordCols 0 cs
  | .node [] => []

/-- L3.5: `e_ε(Q)(X)`. -/
def encEps (Q : Column) (X : Forest) : List WordAtom := if Q = [] then word X else encOne X

/-! ### L3.5 helpers: unshifted placements along the route -/

theorem ker_mapLast_cons {β γ : Type} (f g : β → γ) (a : β) {l : List β} (hl : l ≠ []) :
    mapLast f g (a :: l) = f a :: mapLast f g l := by
  cases l with
  | nil => exact absurd rfl hl
  | cons b bs => simp only [mapLast]

/-- L3.5 helper: `mapLast` over an append with a nonempty right part. -/
theorem ker_mapLast_append {β γ : Type} (f g : β → γ) (A B : List β) (hB : B ≠ []) :
    mapLast f g (A ++ B) = A.map f ++ mapLast f g B := by
  induction A with
  | nil => rfl
  | cons a A ih =>
    rw [List.cons_append, ker_mapLast_cons _ _ _ (by simp [hB]), ih]
    rfl

theorem ker_length_mapLast {β γ : Type} (f g : β → γ) :
    ∀ (l : List β), (mapLast f g l).length = l.length
  | [] => by simp [mapLast]
  | [x] => by simp [mapLast]
  | x :: y :: ys => by simp only [mapLast, List.length_cons, ker_length_mapLast f g (y :: ys)]

theorem ker_getLast?_mapLast {β γ : Type} (f g : β → γ) (l : List β) :
    (mapLast f g l).getLast? = l.getLast?.map g := by
  rw [mapLast_eq]
  cases h : l.getLast? with
  | none => simp at h; subst h; simp
  | some x => simp

theorem ker_mapLast_drop {β γ : Type} (f g : β → γ) :
    ∀ (l : List β) (c : Nat), (mapLast f g l).drop c = mapLast f g (l.drop c)
  | [], c => by simp [mapLast]
  | l, 0 => rfl
  | [x], c + 1 => by simp [mapLast]
  | x :: y :: ys, c + 1 => by
    rw [mapLast, List.drop_succ_cons, List.drop_succ_cons, ker_mapLast_drop f g (y :: ys) c]

theorem ker_mapLast_congr {β γ : Type} {f f' g g' : β → γ} :
    ∀ (l : List β), (∀ x ∈ l, f x = f' x) → (∀ x ∈ l, g x = g' x) →
      mapLast f g l = mapLast f' g' l
  | [], _, _ => by simp [mapLast]
  | [x], _, hg => by simp only [mapLast]; rw [hg x (by simp)]
  | x :: y :: ys, hf, hg => by
    simp only [mapLast]
    rw [hf x (by simp), ker_mapLast_congr (y :: ys) (fun z hz => hf z (by simp [hz]))
      (fun z hz => hg z (by simp [hz]))]

/-- L3.5 helper: the unshifted placement at depth `m + 1` in list form. -/
theorem ker_replaceAt_zero_succ (Y : Forest) (m : Nat) (cols : List Column) :
    replaceAt 0 0 Y (m + 1) (Tree.node cols) =
      Tree.node (mapLast id (mapLast id (fun x : Nat × Forest => (x.1, replaceAt 0 0 Y m x.2)))
        cols) := by
  simp only [replaceAt]
  rw [shiftVal_zero_fun, treeMapCol_id_fun]
  have h1 : (fun x : Nat × Forest => match x with | (p, h) => (id p, Tree.map id h)) = id := by
    funext x; obtain ⟨p, h⟩ := x; simp [treeMap_id]
  have h2 : (fun x : Nat × Forest => match x with | (p, h) => (id p, replaceAt 0 0 Y m h)) =
      (fun x : Nat × Forest => (x.1, replaceAt 0 0 Y m x.2)) := by
    funext x; obtain ⟨p, h⟩ := x; rfl
  rw [h1, h2]

/-- L3.5 helper: the unshifted placement at depth `0` of a nonempty forest. -/
theorem ker_replaceAt_zero_zero (Y : Forest) (cols : List Column) (h : cols ≠ []) :
    replaceAt 0 0 Y 0 (Tree.node cols) = Tree.node (cols.dropLast ++ Y.cols) := by
  cases cols with
  | nil => exact absurd rfl h
  | cons c cs =>
    simp only [replaceAt]
    rw [shiftVal_zero_fun, treeMapCol_id_fun, List.map_id]

/-- L3.5 helper: a placement through the last column leaves the first `i` columns alone. -/
theorem ker_replaceAt_split (Y : Forest) (δ : Nat) (cs : List Column) (i : Nat)
    (hi : i < cs.length) :
    (replaceAt 0 0 Y δ (Tree.node cs)).cols =
      cs.take i ++ (replaceAt 0 0 Y δ (Tree.node (cs.drop i))).cols := by
  have hne : cs.drop i ≠ [] := by
    intro h; have := congrArg List.length h; simp at this; omega
  have hcs : cs ≠ [] := by intro h; subst h; simp at hi
  cases δ with
  | zero =>
    rw [ker_replaceAt_zero_zero Y _ hcs, ker_replaceAt_zero_zero Y _ hne]
    simp only [Tree.cols]
    conv_lhs => rw [← List.take_append_drop i cs]
    rw [List.dropLast_append_of_ne_nil hne, List.append_assoc]
  | succ m =>
    rw [ker_replaceAt_zero_succ, ker_replaceAt_zero_succ]
    simp only [Tree.cols]
    conv_lhs => rw [← List.take_append_drop i cs]
    rw [ker_mapLast_append _ _ _ _ hne, List.map_id]

/-- L3.5 helper: the unshifted placement at depth `m + 1` descends along the last step. -/
theorem ker_replaceAt_forestAt_last (Y : Forest) (m : Nat) {G : Forest} {col : Column} {p : Nat}
    {H : Forest} (hc : G.cols.getLast? = some col) (hl : col.getLast? = some (p, H)) :
    (replaceAt 0 0 Y (m + 1) G).forestAt [(G.cols.length - 1, col.length - 1)] =
      some (replaceAt 0 0 Y m H) := by
  obtain ⟨cols⟩ := G
  rw [ker_replaceAt_zero_succ]
  have hlen : (Tree.node cols).cols.length = (Tree.node (mapLast id (mapLast id
      (fun x : Nat × Forest => (x.1, replaceAt 0 0 Y m x.2))) cols)).cols.length := by
    simp only [Tree.cols]; rw [ker_length_mapLast]
  have hlen2 : col.length = (mapLast id (fun x : Nat × Forest => (x.1, replaceAt 0 0 Y m x.2))
      col).length := (ker_length_mapLast _ _ _).symm
  rw [hlen, hlen2]
  apply ker_forestAt_lastStep (p := p)
  · show (mapLast id _ cols).getLast? = _
    rw [ker_getLast?_mapLast]
    simp only [Tree.cols] at hc
    rw [hc]
    rfl
  · rw [ker_getLast?_mapLast, hl]
    rfl

/-- L3.5 helper (fill law along the route): the context places `Y` at depth `ℓ − j` inside the
forest at depth `j` of the stopping route. -/
theorem ker_context_forestAt {K : Forest} {sd : StopData} (hsd : stopData K = some sd)
    (Y : Forest) : ∀ j, j ≤ sd.depth → ∀ G, K.forestAt (sd.col.path.take j) = some G →
      (context K sd Y).forestAt (sd.col.path.take j) = some (replaceAt 0 0 Y (sd.depth - j) G) := by
  obtain ⟨-, hdep, -, hmem, -⟩ := stopData_spec hsd
  obtain ⟨hpath, -⟩ := (Scan.mem_routeCols_iff K sd.col).1 hmem
  intro j
  induction j with
  | zero =>
    intro _ G hG
    simp only [List.take_zero, Tree.forestAt, Option.some.injEq] at hG ⊢
    subst hG
    rfl
  | succ j ih =>
    intro hj G hG
    have hj' : j < sd.col.path.length := by omega
    obtain ⟨G0, hG0, hlast⟩ := hpath j hj'
    have ih' := ih (by omega) G0 hG0
    rw [List.getElem?_eq_getElem hj'] at hlast
    unfold Tree.lastStep? at hlast
    cases hgc : G0.cols.getLast? with
    | none => rw [hgc] at hlast; simp at hlast
    | some col =>
      rw [hgc] at hlast
      simp only [Option.bind_some] at hlast
      split at hlast
      · simp at hlast
      · rename_i hne
        have hstep : sd.col.path[j] = (G0.cols.length - 1, col.length - 1) :=
          (Option.some.inj hlast).symm
        have hcol : col ≠ [] := by simpa using hne
        obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 (List.getLast?_isSome.2 hcol)
        obtain ⟨p, H⟩ := x
        rw [List.take_add_one, List.getElem?_eq_getElem hj', Option.toList_some,
          Tree.forestAt_append, hG0, Option.bind_some, hstep, ker_forestAt_lastStep hgc hx] at hG
        cases hG
        rw [List.take_add_one, List.getElem?_eq_getElem hj', Option.toList_some,
          Tree.forestAt_append, ih', Option.bind_some, hstep,
          show sd.depth - j = (sd.depth - (j + 1)) + 1 by omega]
        exact ker_replaceAt_forestAt_last Y _ hgc hx

/-- L3.5 helper: the root column lies on the stopping route. -/
theorem ker_rootPath {K : Forest} {sd : StopData} {rd : RootData} (hsd : stopData K = some sd)
    (hrd : rootData K = some rd) :
    rd.col.path = sd.col.path.take rd.layer ∧ rd.layer ≤ sd.depth := by
  obtain ⟨-, -, hlay, hpre, -⟩ := rootData_path hsd hrd
  refine ⟨?_, rootData_layer_le hsd hrd⟩
  rw [hlay]; exact List.prefix_iff_eq_take.1 hpre

/-- L3.5 helper: a shift of a column whose outer parents are `< r` shifts only heights. -/
theorem ker_mapCol_fix {r a : Nat} {l : Column} (hl : ∀ x ∈ l, x.1 < r) :
    Tree.mapCol (shiftVal r a) l = l.map fun x => (x.1, shift r a x.2) := by
  rw [treeMapCol_eq_map]
  apply List.map_congr_left
  intro x hx
  have := hl x hx
  rw [show shiftVal r a x.1 = x.1 by unfold shiftVal; rw [if_neg (by omega)]]
  rfl

-- provides: U2, L3.5 (1) (txt:438-447): the filling identity, with frozen cursor
theorem filling_identity {K : Forest} {sd : StopData} {rd : RootData} (hV : CondV K)
    (hsd : stopData K = some sd) (hrd : rootData K = some rd) (Y : Forest) :
    kernel K sd rd Y = diamond sd.Q (shift sd.r (period sd) (rootTail (context K sd Y) rd rd.cursor)) := by
  obtain ⟨hF, -⟩ := ker_route_rootForest hsd hrd
  obtain ⟨hpath, hle⟩ := ker_rootPath hsd hrd
  have hC : (context K sd Y).forestAt rd.col.path =
      some (replaceAt 0 0 Y (holeDepth sd rd) (rootForest K rd)) := by
    rw [hpath] at hF ⊢
    rw [ker_context_forestAt hsd Y rd.layer hle _ hF]
    rfl
  have hUlt := ker_unconsumed_lt hV hsd hrd
  obtain ⟨-, -, hidx, -, -, hmem, -, hown⟩ := rootData_spec hsd hrd
  obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff K rd.col).1 hmem)
  have hcolF : (rootForest K rd).cols[rd.idx]? = some col := by
    unfold Tree.colAt at hcol; rw [hF, Option.bind_some, ← hidx] at hcol; exact hcol
  have hidxlt : rd.idx < (rootForest K rd).cols.length := by
    by_contra h; rw [List.getElem?_eq_none (by omega)] at hcolF; cases hcolF
  have hU : unconsumed K rd = col.drop rd.cursor := by
    unfold unconsumed rootCol; rw [hcol]; rfl
  unfold rootTail kernel
  simp only [Tree.colAt, hC, Option.bind_some, Option.getD_some, ← hidx]
  rcases hFF : rootForest K rd with ⟨cs⟩
  rw [hFF] at hcolF hidxlt
  simp only [Tree.cols] at hcolF hidxlt
  by_cases ho : rd.owner = true
  · simp only [ho, if_true]
    have hlast : rd.idx + 1 = cs.length := by
      obtain ⟨F', hF', h'⟩ := hown.1 ho
      rw [hF, hFF] at hF'; cases hF'; rw [hidx]; exact h'
    have hlay := rootData_layer_lt hsd hrd ho
    obtain ⟨m, hm⟩ : ∃ m, holeDepth sd rd = m + 1 := ⟨holeDepth sd rd - 1, by unfold holeDepth; omega⟩
    rw [hm, ker_replaceAt_zero_succ, Nat.add_sub_cancel]
    simp only [Tree.cols]
    have hcsl : cs.getLast? = some col := by
      rw [List.getLast?_eq_getElem?, ← hlast, Nat.add_sub_cancel, hcolF]
    have hA : (mapLast id (mapLast id (fun x : Nat × Forest => (x.1, replaceAt 0 0 Y m x.2))) cs)[rd.idx]? =
        some (mapLast id (fun x : Nat × Forest => (x.1, replaceAt 0 0 Y m x.2)) col) := by
      rw [show rd.idx = (mapLast id (mapLast id (fun x : Nat × Forest =>
          (x.1, replaceAt 0 0 Y m x.2))) cs).length - 1 by rw [ker_length_mapLast]; omega,
        ← List.getLast?_eq_getElem?, ker_getLast?_mapLast, hcsl]
      rfl
    have hB : (mapLast id (mapLast id (fun x : Nat × Forest => (x.1, replaceAt 0 0 Y m x.2))) cs).drop
        (rd.idx + 1) = [] := List.drop_eq_nil_of_le (by rw [ker_length_mapLast]; omega)
    rw [hA, Option.getD_some, hB, ker_mapLast_drop, ← hU, ker_shift_node, List.map_cons,
      List.map_nil]
    simp only [diamond]
    congr 3
    rw [treeMapCol_eq_map, map_mapLast]
    apply ker_mapLast_congr
    · intro x hx
      simp only [Function.comp, id]
      rw [show shiftVal sd.r (period sd) x.1 = x.1 by
        have := hUlt x hx; unfold shiftVal; rw [if_neg (by omega)]]
      rfl
    · intro x hx
      simp only [Function.comp]
      rw [show shiftVal sd.r (period sd) x.1 = x.1 by
        have := hUlt x hx; unfold shiftVal; rw [if_neg (by omega)]]
      congr 1
      exact (shift_replaceAt _ _ _ _ _).symm
  · simp only [ho, Bool.false_eq_true, if_false]
    have hlt : rd.idx + 1 < cs.length := by
      rcases Nat.lt_or_ge (rd.idx + 1) cs.length with h | h
      · exact h
      · exact absurd (hown.2 ⟨_, hF, by rw [hFF, ← hidx]; simp only [Tree.cols]; omega⟩) ho
    have hsplit := ker_replaceAt_split Y (holeDepth sd rd) cs (rd.idx + 1) hlt
    have hA : (replaceAt 0 0 Y (holeDepth sd rd) (Tree.node cs)).cols[rd.idx]? = some col := by
      rw [hsplit, List.getElem?_append_left (by simp; omega), List.getElem?_take_of_lt (by omega),
        hcolF]
    have hB : (replaceAt 0 0 Y (holeDepth sd rd) (Tree.node cs)).cols.drop (rd.idx + 1) =
        (replaceAt 0 0 Y (holeDepth sd rd) (Tree.node (cs.drop (rd.idx + 1)))).cols := by
      rw [hsplit, List.drop_append_of_le_length (by simp; omega),
        List.drop_eq_nil_of_le (by simp), List.nil_append]
    rw [hA, Option.getD_some, hB, ← hU, ker_shift_node, List.map_cons]
    simp only [diamond]
    rw [ker_mapCol_fix hUlt, ← ker_map_cols]
    congr 3
    simp only [Tree.cols]
    exact (shift_replaceAt _ _ _ _ _).symm

-- L3.5 (2) (txt:448-458): cancellation of a prefix `Q`
/-- L3.5 helper: the continuation word of a column splits over an append. -/
theorem ker_wordLater_append (e : Nat) (l₁ l₂ : Column) :
    wordLater e (l₁ ++ l₂) = wordLater e l₁ ++ wordLater e l₂ := by
  induction l₁ with
  | nil => rfl
  | cons x l ih =>
    obtain ⟨p, h⟩ := x
    simp only [List.cons_append, wordLater, ih, List.append_assoc]

theorem cancel_eq (Q : Column) {X : Forest} (hX : X ≠ Tree.empty) :
    word (diamond Q X) = (if Q = [] then [] else word (.node [Q])) ++ encEps Q X := by
  obtain ⟨cols⟩ := X
  cases cols with
  | nil => exact absurd rfl hX
  | cons c cs =>
    unfold encEps
    cases Q with
    | nil => simp [diamond]
    | cons q qs =>
      obtain ⟨p, h⟩ := q
      simp only [diamond, encOne, reduceCtorEq, if_false, word, wordAt, wordCols, List.cons_append,
        wordCol, ker_wordLater_append, List.append_nil, List.append_assoc]

/-- L3.5 helper: a common prefix cancels in the list order. -/
theorem ker_append_lt_append_iff {α : Type} [LinearOrder α] (P a b : List α) :
    P ++ a < P ++ b ↔ a < b := by
  induction P with
  | nil => rfl
  | cons x P ih =>
    rw [List.cons_append, List.cons_append, List.cons_lt_cons_iff, ih]
    simp

-- L3.5 (2): comparisons after deleting the same nonempty prefix
theorem diamond_lt_iff {Q : Column} (hQ : Q ≠ []) {X X' : Forest} (hX : X ≠ Tree.empty)
    (hX' : X' ≠ Tree.empty) : diamond Q X < diamond Q X' ↔ encOne X < encOne X' := by
  rw [← word_lt_iff, cancel_eq Q hX, cancel_eq Q hX']
  unfold encEps
  rw [if_neg hQ, if_neg hQ, if_neg hQ, ker_append_lt_append_iff]

/-- D3.3c: kernel success at a target suffix `Y`. -/
def Success (K Y : Forest) : Prop :=
  ∃ sd rd, stopData K = some sd ∧ rootData K = some rd ∧ KernelDefined K rd ∧
    Y < kernel K sd rd Y

/-- D3.3c: some approximant of `K` strictly exceeds `B`. -/
def Covers (K B : Forest) : Prop := ∃ q K', expand K q = some K' ∧ B < K'

/-- D3.3c helper (= T3.2h `shiftVal_conj`, stated here for use before it): phase conjugacy of
root shifts. -/
theorem ker_shiftVal_conj {r ρ' δ d : Nat} (hr : r ≤ ρ') (p : Nat) :
    shiftVal (ρ' + δ) d (shiftVal r δ p) = shiftVal r δ (shiftVal ρ' d p) := by
  unfold shiftVal
  split_ifs <;> omega

-- D3.3c: kernel conjugacy under a phase shift (txt:542-546, 547-552)
theorem kernel_conj {K K' : Forest} {sd sd' : StopData} {rd rd' : RootData} {r δ : Nat}
    (hr : r ≤ sd'.r) (hQ : sd.Q = Tree.mapCol (shiftVal r δ) sd'.Q) (hρ : sd.r = sd'.r + δ)
    (ht : sd.t = sd'.t + δ) (hU : unconsumed K rd = Tree.mapCol (shiftVal r δ) (unconsumed K' rd'))
    (howner : rd.owner = rd'.owner) (hhole : holeDepth sd rd = holeDepth sd' rd')
    (hbody : Tree.node ((rootForest K rd).cols.drop (rd.idx + 1)) =
      shift r δ (.node ((rootForest K' rd').cols.drop (rd'.idx + 1))))
    (X : Forest) : kernel K sd rd (shift r δ X) = shift r δ (kernel K' sd' rd' X) := by
  have hd : period sd = period sd' := by unfold period; omega
  have hconj : ∀ F : Forest,
      shift sd.r (period sd) (shift r δ F) = shift r δ (shift sd'.r (period sd') F) := by
    intro F
    rw [hd, hρ]
    unfold shift
    rw [treeMap_map, treeMap_map]
    congr 1
    funext p
    exact ker_shiftVal_conj hr p
  have hrep : ∀ k (Z G : Forest), shift r δ (replaceAt sd'.r (period sd') Z k G) =
      replaceAt sd.r (period sd) (shift r δ Z) k (shift r δ G) := by
    intro k Z G
    rw [replaceAt_eq_shift sd'.r, shift_replaceAt, replaceAt_eq_shift r δ,
      replaceAt_eq_shift sd.r, hconj]
  have hent : ∀ x : Nat × Forest,
      (shiftVal r δ x.1, shift sd.r (period sd) (Tree.map (shiftVal r δ) x.2)) =
        (shiftVal r δ x.1, Tree.map (shiftVal r δ) (shift sd'.r (period sd') x.2)) := by
    intro x
    show (_, shift sd.r (period sd) (shift r δ x.2)) = (_, shift r δ (shift sd'.r (period sd') x.2))
    rw [hconj]
  unfold kernel
  simp only []
  rw [howner, hhole, hU, hQ, hbody]
  by_cases ho : rd'.owner = true
  · simp only [ho, if_true]
    rw [ker_shift_node, List.map_cons, List.map_nil, ker_mapCol_append]
    congr 3
    rw [treeMapCol_eq_map, treeMapCol_eq_map, mapLast_map, map_mapLast]
    congr 1
    · funext x; exact hent x
    · funext x
      simp only [Function.comp]
      congr 1
      show replaceAt _ _ _ _ (shift r δ x.2) = shift r δ (replaceAt _ _ _ _ x.2)
      rw [hrep, hconj]
  · simp only [ho, Bool.false_eq_true, if_false]
    conv_rhs => rw [ker_shift_node, List.map_cons, ker_mapCol_append]
    congr 2
    · simp only [treeMapCol_eq_map, List.map_map]
      congr 1
      apply List.map_congr_left
      intro x _
      exact hent x
    · rw [← ker_map_cols]
      show (replaceAt _ _ _ _ _).cols = (shift r δ (replaceAt _ _ _ _ _)).cols
      rw [hrep, hconj]

/-! ### Helpers shared by T3.2i, T3.2l, T3.8: outputs as contexts, fill laws off the route -/

/-- helper: an ordinary output is the context of the `n`-th kernel iterate (the kernel is
defined whenever `n ≥ 1` and the output exists). -/
theorem ker_expand_out {A A' : Forest} {sd : StopData} {rd : RootData} {n : Nat} (hV : CondV A)
    (hI : CondI A) (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) (hA' : expand A n = some A') :
    A' = context A sd ((kernel A sd rd)^[n] Tree.empty) ∧ (1 ≤ n → KernelDefined A rd) := by
  have hE : A ≠ Tree.empty := by
    intro h; subst h
    simp [stopData, stopDataBody, stopF, stopCols, Tree.empty] at hsd
  by_cases hkd : KernelDefined A rd
  · rw [expand_eq_iterate hE hV hI hk hsd hrd hkd] at hA'
    exact ⟨(Option.some.inj hA').symm, fun _ => hkd⟩
  · rcases Nat.eq_zero_or_pos n with rfl | hn
    · rw [expand_zero_eq_context hE hV hI hk hsd] at hA'
      exact ⟨(Option.some.inj hA').symm, fun h => absurd h (by omega)⟩
    · have := (expand_none_iff hE hV hI hk hsd hrd n).2 ⟨hn, hkd⟩
      rw [this] at hA'; cases hA'

/-- helper: the path trichotomy (prefix, extension, divergence). -/
theorem ker_path_cases : ∀ (σ π : List (Nat × Nat)),
    σ <+: π ∨ (∃ x rest, σ = π ++ x :: rest) ∨
      ∃ j, j < σ.length ∧ j < π.length ∧ σ.take j = π.take j ∧ σ[j]? ≠ π[j]?
  | [], _ => Or.inl List.nil_prefix
  | x :: σ, [] => Or.inr (Or.inl ⟨x, σ, rfl⟩)
  | x :: σ, y :: π => by
    by_cases hxy : x = y
    · subst hxy
      rcases ker_path_cases σ π with h | ⟨z, rest, h⟩ | ⟨j, h1, h2, h3, h4⟩
      · exact Or.inl ((List.prefix_cons_inj x).2 h)
      · exact Or.inr (Or.inl ⟨z, rest, by rw [h]; rfl⟩)
      · refine Or.inr (Or.inr ⟨j + 1, by simp; omega, by simp; omega, ?_, by simpa using h4⟩)
        simp [h3]
    · exact Or.inr (Or.inr ⟨0, by simp, by simp, rfl, by simpa using hxy⟩)

theorem ker_mapLast_getElem?_lt {β γ : Type} (f g : β → γ) :
    ∀ {l : List β} {i : Nat}, i + 1 < l.length → (mapLast f g l)[i]? = l[i]?.map f
  | [], _, h => by simp at h
  | [_], _, h => by simp at h
  | x :: y :: ys, 0, _ => by simp [mapLast]
  | x :: y :: ys, i + 1, h => by
    simp only [mapLast, List.getElem?_cons_succ]
    exact ker_mapLast_getElem?_lt f g (l := y :: ys) (by simp at h ⊢; omega)

theorem ker_mapLast_getElem?_ge {β γ : Type} (f g : β → γ) {l : List β} {i : Nat}
    (h : l.length ≤ i) : (mapLast f g l)[i]? = none :=
  List.getElem?_eq_none (by rw [ker_length_mapLast]; exact h)

theorem ker_mapLast_getElem?_last {β γ : Type} (f g : β → γ) (l : List β) :
    (mapLast f g l)[l.length - 1]? = l.getLast?.map g := by
  rw [← ker_length_mapLast f g l, ← List.getLast?_eq_getElem?, ker_getLast?_mapLast]

/-- helper: off the last step, an unshifted placement at depth `m + 1` leaves entries alone. -/
theorem ker_replaceAt_step_other (Y : Forest) (m : Nat) {G : Forest} {col : Column}
    (hc : G.cols.getLast? = some col) (c' e' : Nat)
    (hne : (c', e') ≠ (G.cols.length - 1, col.length - 1)) :
    ((replaceAt 0 0 Y (m + 1) G).cols[c']?).bind (·[e']?) = (G.cols[c']?).bind (·[e']?) := by
  obtain ⟨cols⟩ := G
  rw [ker_replaceAt_zero_succ]
  simp only [Tree.cols] at hc hne ⊢
  rcases Nat.lt_or_ge (c' + 1) cols.length with h1 | h1
  · rw [ker_mapLast_getElem?_lt _ _ h1]
    cases cols[c']? <;> rfl
  · rcases Nat.lt_or_ge c' cols.length with h2 | h2
    · have hc' : c' = cols.length - 1 := by omega
      subst hc'
      rw [ker_mapLast_getElem?_last, hc, ← List.getLast?_eq_getElem?, hc]
      simp only [Option.map_some, Option.bind_some]
      have he : e' ≠ col.length - 1 := fun h => hne (by rw [h])
      rcases Nat.lt_or_ge (e' + 1) col.length with h3 | h3
      · rw [ker_mapLast_getElem?_lt _ _ h3]; cases col[e']? <;> rfl
      · rw [ker_mapLast_getElem?_ge _ _ (by omega), List.getElem?_eq_none (by omega)]
    · rw [ker_mapLast_getElem?_ge _ _ h2, List.getElem?_eq_none h2]

/-- helper: the step lookup of `forestAt`. -/
theorem ker_forestAt_cons {α : Type} (T : Tree α) (c e : Nat) (rest : List (Nat × Nat)) :
    T.forestAt ((c, e) :: rest) = ((T.cols[c]?).bind (·[e]?)).bind fun x => x.2.forestAt rest := by
  simp only [Tree.forestAt]
  cases (T.cols[c]?).bind (·[e]?) with
  | none => rfl
  | some x => rfl

/-- helper (fill law off the route): a path that leaves the stopping route above the stopping
forest reads the same forest in every context. -/
theorem ker_context_forestAt_diverge {K : Forest} {sd : StopData} (hsd : stopData K = some sd)
    (Y : Forest) {σ : List (Nat × Nat)} {j : Nat} (hj : j < sd.col.path.length)
    (hjσ : j < σ.length) (htake : σ.take j = sd.col.path.take j)
    (hne : σ[j]? ≠ sd.col.path[j]?) :
    (context K sd Y).forestAt σ = K.forestAt σ := by
  obtain ⟨-, hdep, -, hmem, -⟩ := stopData_spec hsd
  obtain ⟨hpath, -⟩ := (Scan.mem_routeCols_iff K sd.col).1 hmem
  obtain ⟨G0, hG0, hlast⟩ := hpath j hj
  have hC := ker_context_forestAt hsd Y j (by omega) G0 hG0
  rw [List.getElem?_eq_getElem hj] at hlast hne
  unfold Tree.lastStep? at hlast
  cases hgc : G0.cols.getLast? with
  | none => rw [hgc] at hlast; simp at hlast
  | some col =>
    rw [hgc] at hlast
    simp only [Option.bind_some] at hlast
    split at hlast
    · simp at hlast
    · have hstep : sd.col.path[j] = (G0.cols.length - 1, col.length - 1) :=
        (Option.some.inj hlast).symm
      have hσ : σ = σ.take j ++ σ[j] :: σ.drop (j + 1) := by
        rw [← List.drop_eq_getElem_cons hjσ, List.take_append_drop]
      have hσj : σ[j]? = some σ[j] := List.getElem?_eq_getElem hjσ
      rw [hσ, Tree.forestAt_append, Tree.forestAt_append, htake, hC, hG0, Option.bind_some,
        Option.bind_some]
      rcases hx : σ[j] with ⟨c', e'⟩
      have hne' : (c', e') ≠ (G0.cols.length - 1, col.length - 1) := by
        rw [← hstep, ← hx]; intro h; exact hne (by rw [hσj, h])
      rw [ker_forestAt_cons, ker_forestAt_cons, show sd.depth - j = (sd.depth - j - 1) + 1 by omega,
        ker_replaceAt_step_other Y _ hgc c' e' hne']

/-- helper: the stopping forest of `K` and its last column. -/
theorem ker_stopForest {K : Forest} {sd : StopData} (hsd : stopData K = some sd) :
    ∃ G, K.forestAt sd.col.path = some G ∧ G.cols.length = sd.col.col + 1 ∧
      G.cols[sd.col.col]? = some (sd.Q ++ [(sd.r, Tree.empty)]) := by
  obtain ⟨hcol, -, -, hmem, -⟩ := stopData_spec hsd
  obtain ⟨-, F, hF, hFlen⟩ := (Scan.mem_routeCols_iff K sd.col).1 hmem
  refine ⟨F, hF, hFlen, ?_⟩
  unfold Tree.colAt at hcol
  rw [hF, Option.bind_some] at hcol
  exact hcol

/-- helper (fill law at the stopping forest): an entry of a column before the stopping column,
or a query entry of the stopping column when the filling starts with `Q`, reads the same forest
below it. -/
theorem ker_context_forestAt_stop {K : Forest} {sd : StopData} (hsd : stopData K = some sd)
    (Y : Forest) {c' e' : Nat} (rest : List (Nat × Nat))
    (hce : c' < sd.col.col ∨
      (c' = sd.col.col ∧ e' < sd.Q.length ∧ ∃ V cs, Y = Tree.node ((sd.Q ++ V) :: cs))) :
    (context K sd Y).forestAt (sd.col.path ++ (c', e') :: rest) =
      K.forestAt (sd.col.path ++ (c', e') :: rest) := by
  obtain ⟨G, hG, hGlen, hGc⟩ := ker_stopForest hsd
  obtain ⟨-, hdep, -⟩ := stopData_spec hsd
  have hC := ker_context_forestAt hsd Y sd.depth le_rfl G (by rw [hdep, List.take_length]; exact hG)
  rw [hdep, List.take_length, Nat.sub_self] at hC
  rw [Tree.forestAt_append, Tree.forestAt_append, hC, hG, Option.bind_some, Option.bind_some,
    ker_forestAt_cons, ker_forestAt_cons]
  obtain ⟨cols⟩ := G
  simp only [Tree.cols] at hGlen hGc
  have hne : cols ≠ [] := by intro h; subst h; simp at hGlen
  rw [ker_replaceAt_zero_zero Y cols hne]
  simp only [Tree.cols]
  rcases hce with h | ⟨rfl, he, V, cs, rfl⟩
  · rw [List.getElem?_append_left (by simp; omega), List.getElem?_dropLast, if_pos (by omega)]
  · rw [List.getElem?_append_right (by simp; omega), show sd.col.col - cols.dropLast.length = 0 by
      simp; omega, hGc]
    simp only [List.getElem?_cons_zero, Option.bind_some, List.getElem?_append_left he]

/-- helper: under `∅` the query heights disappear. -/
theorem ker_context_empty_forestAt_stop {K : Forest} {sd : StopData} (hsd : stopData K = some sd)
    (e' : Nat) (rest : List (Nat × Nat)) :
    (context K sd Tree.empty).forestAt (sd.col.path ++ (sd.col.col, e') :: rest) = none := by
  obtain ⟨G, hG, hGlen, hGc⟩ := ker_stopForest hsd
  obtain ⟨-, hdep, -⟩ := stopData_spec hsd
  have hC := ker_context_forestAt hsd Tree.empty sd.depth le_rfl G
    (by rw [hdep, List.take_length]; exact hG)
  rw [hdep, List.take_length, Nat.sub_self] at hC
  rw [Tree.forestAt_append, hC, Option.bind_some, ker_forestAt_cons]
  obtain ⟨cols⟩ := G
  simp only [Tree.cols] at hGlen hGc
  have hne : cols ≠ [] := by intro h; subst h; simp at hGlen
  rw [ker_replaceAt_zero_zero _ cols hne]
  simp only [Tree.cols, Tree.empty, List.append_nil]
  rw [List.getElem?_dropLast, if_neg (by omega)]
  rfl

/-- helper: the route of a forest reaches a given column at depth `k`. -/
def KerRouteTo : Nat → Forest → Column → Prop
  | 0, F, X => F.cols.getLast? = some X
  | k + 1, F, X => ∃ col p H, F.cols.getLast? = some col ∧ col.getLast? = some (p, H) ∧
      KerRouteTo k H X

theorem ker_routeTo_route : ∀ (k : Nat) (F : Forest) (X : Column), KerRouteTo k F X → KerRoute k F
  | 0, F, X, h => by
    show F.cols ≠ []
    intro h'; unfold KerRouteTo at h; rw [h'] at h; cases h
  | k + 1, F, X, ⟨col, p, H, h1, h2, h3⟩ => ⟨col, p, H, h1, h2, ker_routeTo_route k H X h3⟩

/-- helper: filling the end of a route with its own last column changes nothing. -/
theorem ker_replaceAt_self :
    ∀ (k : Nat) (F : Forest) (X : Column), KerRouteTo k F X →
      replaceAt 0 0 (Tree.node [X]) k F = F
  | 0, .node cols, X, h => by
    have hne : cols ≠ [] := by intro h'; subst h'; cases h
    rw [ker_replaceAt_zero_zero _ cols hne]
    simp only [Tree.cols]
    have hX : X = cols.getLast hne := by
      unfold KerRouteTo at h; simp only [Tree.cols] at h
      rw [List.getLast?_eq_some_getLast hne] at h; exact (Option.some.inj h).symm
    rw [hX, List.dropLast_concat_getLast]
  | k + 1, .node cols, X, ⟨col, p, H, h1, h2, h3⟩ => by
    rw [ker_replaceAt_zero_succ]
    simp only [Tree.cols] at h1
    have hcol : mapLast id (fun x : Nat × Forest => (x.1, replaceAt 0 0 (Tree.node [X]) k x.2)) col
        = col := by
      have hne : col ≠ [] := by intro h'; subst h'; cases h2
      rw [mapLast_eq, h2, List.map_id]
      simp only [Option.map_some, Option.toList_some, ker_replaceAt_self k H X h3]
      have : (p, H) = col.getLast hne := by
        rw [List.getLast?_eq_some_getLast hne] at h2; exact (Option.some.inj h2).symm
      rw [this, List.dropLast_concat_getLast]
    have hne : cols ≠ [] := by intro h'; subst h'; cases h1
    rw [mapLast_eq, h1, List.map_id]
    simp only [Option.map_some, Option.toList_some, hcol]
    have : col = cols.getLast hne := by
      rw [List.getLast?_eq_some_getLast hne] at h1; exact (Option.some.inj h1).symm
    rw [this, List.dropLast_concat_getLast]

theorem ker_routeTo_drop (k : Nat) (cs : List Column) (X : Column) (i : Nat) (hi : i < cs.length)
    (h : KerRouteTo k (Tree.node cs) X) : KerRouteTo k (Tree.node (cs.drop i)) X := by
  cases k with
  | zero =>
    unfold KerRouteTo at h ⊢; simp only [Tree.cols] at h ⊢
    rw [List.getLast?_drop, if_neg (by omega), h]
  | succ k =>
    obtain ⟨col, p, H, h1, h2, h3⟩ := h
    refine ⟨col, p, H, ?_, h2, h3⟩
    simp only [Tree.cols] at h1 ⊢
    rw [List.getLast?_drop, if_neg (by omega), h1]

/-- helper: along the stopping route the forest at depth `j` routes to the stopping column. -/
theorem ker_routeTo_of_stop {E : Forest} {sd : StopData} (hsd : stopData E = some sd) :
    ∀ j, j ≤ sd.depth →
      ∃ G, E.forestAt (sd.col.path.take j) = some G ∧
        KerRouteTo (sd.depth - j) G (sd.Q ++ [(sd.r, Tree.empty)]) := by
  obtain ⟨-, hdep, -, hmem, -⟩ := stopData_spec hsd
  obtain ⟨hpath, -⟩ := (Scan.mem_routeCols_iff E sd.col).1 hmem
  obtain ⟨F, hF, hFlen, hFc⟩ := ker_stopForest hsd
  suffices h : ∀ m j, j + m = sd.col.path.length →
      ∃ G, E.forestAt (sd.col.path.take j) = some G ∧
        KerRouteTo m G (sd.Q ++ [(sd.r, Tree.empty)]) by
    intro j hj
    exact h (sd.depth - j) j (by omega)
  intro m
  induction m with
  | zero =>
    intro j hj
    refine ⟨F, ?_, ?_⟩
    · rw [List.take_of_length_le (by omega)]; exact hF
    · show F.cols.getLast? = _
      rw [List.getLast?_eq_getElem?, hFlen, Nat.add_sub_cancel, hFc]
  | succ m ih =>
    intro j hj
    obtain ⟨H, hH, hHr⟩ := ih (j + 1) (by omega)
    obtain ⟨G, hG, hlast⟩ := hpath j (by omega)
    refine ⟨G, hG, ?_⟩
    have hj' : j < sd.col.path.length := by omega
    rw [List.getElem?_eq_getElem hj'] at hlast
    unfold Tree.lastStep? at hlast
    cases hgc : G.cols.getLast? with
    | none => rw [hgc] at hlast; simp at hlast
    | some col =>
      rw [hgc] at hlast
      simp only [Option.bind_some] at hlast
      split at hlast
      · simp at hlast
      · rename_i hne
        have hstep : sd.col.path[j] = (G.cols.length - 1, col.length - 1) :=
          (Option.some.inj hlast).symm
        have hcol : col ≠ [] := by simpa using hne
        obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 (List.getLast?_isSome.2 hcol)
        obtain ⟨p, H'⟩ := x
        rw [List.take_add_one, List.getElem?_eq_getElem hj', Option.toList_some,
          Tree.forestAt_append, hG, Option.bind_some, hstep, ker_forestAt_lastStep hgc hx] at hH
        cases hH
        exact ⟨col, p, H, hgc, hx, hHr⟩

/-- helper: a node is the node of its columns. -/
theorem ker_node_cols {α : Type} (T : Tree α) : Tree.node T.cols = T := by cases T; rfl

/-- helper: local suffixes of route columns are placements. For a column `a` whose forest lies
on the stopping route, the local suffix of `K` routes to the stopping column, and the local
suffix of `C_K(Y)` is that suffix with its stopping column replaced by `Y`. -/
theorem ker_localSuffix_prefix {K : Forest} {sd : StopData} (hsd : stopData K = some sd)
    {a : ColAddr} (hpre : a.path <+: sd.col.path) (ha : a ∈ K.colAddrs) :
    KerRouteTo (sd.depth - a.path.length) (localSuffix K a) (sd.Q ++ [(sd.r, Tree.empty)]) ∧
      ∀ Y, localSuffix (context K sd Y) a =
        replaceAt 0 0 Y (sd.depth - a.path.length) (localSuffix K a) := by
  obtain ⟨-, hdep, -⟩ := stopData_spec hsd
  have hlen : a.path.length ≤ sd.depth := by rw [hdep]; exact hpre.length_le
  have hpa : a.path = sd.col.path.take a.path.length := List.prefix_iff_eq_take.1 hpre
  obtain ⟨G, hG, hR⟩ := ker_routeTo_of_stop hsd a.path.length hlen
  rw [← hpa] at hG
  obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff K a).1 ha)
  unfold Tree.colAt at hcol
  rw [hG, Option.bind_some] at hcol
  obtain ⟨cs⟩ := G
  have hac : a.col < cs.length := by
    by_contra h; simp only [Tree.cols] at hcol; rw [List.getElem?_eq_none (by omega)] at hcol
    cases hcol
  have hL : localSuffix K a = Tree.node (cs.drop a.col) := by
    unfold localSuffix; rw [hG]; rfl
  refine ⟨hL ▸ ker_routeTo_drop _ cs _ a.col hac hR, ?_⟩
  intro Y
  have hC := ker_context_forestAt hsd Y a.path.length hlen _ (by rw [← hpa]; exact hG)
  rw [← hpa] at hC
  unfold localSuffix
  rw [hC, hG, Option.getD_some, Option.getD_some,
    ker_replaceAt_split Y _ cs a.col hac, List.drop_append_of_le_length (by simp; omega),
    List.drop_eq_nil_of_le (by simp), List.nil_append, ker_node_cols]
  rfl

/-- helper: comparison of columns after a common prefix. -/
theorem ker_cmpCol_append_left :
    ∀ (Q V W : Column), Tree.cmpCol compare (Q ++ V) (Q ++ W) = Tree.cmpCol compare V W
  | [], _, _ => rfl
  | (p, h) :: Q, V, W => by
    simp only [List.cons_append, Tree.cmpCol]
    rw [Tree.cmp_self compare h, ker_cmpCol_append_left Q V W]
    rw [show compare p p = .eq from Nat.compare_eq_eq.2 rfl]
    rfl

/-- helper: the first column of a kernel output is `Q` followed by entries with parents `< r`. -/
theorem ker_kernel_firstCol {K : Forest} {sd : StopData} {rd : RootData}
    (hU : ∀ x ∈ unconsumed K rd, x.1 < sd.r) (X : Forest) :
    ∃ V cs, kernel K sd rd X = Tree.node ((sd.Q ++ V) :: cs) ∧ ∀ v ∈ V.head?, v.1 < sd.r := by
  unfold kernel
  split
  · refine ⟨_, [], rfl, ?_⟩
    intro v hv
    cases hU' : unconsumed K rd with
    | nil => rw [hU'] at hv; simp [mapLast] at hv
    | cons u us =>
      rw [hU'] at hv
      cases us with
      | nil => simp [mapLast] at hv; rw [← hv]; exact hU u (by rw [hU']; simp)
      | cons u' us' => simp [mapLast] at hv; rw [← hv]; exact hU u (by rw [hU']; simp)
  · refine ⟨_, _, rfl, ?_⟩
    intro v hv
    cases hU' : unconsumed K rd with
    | nil => rw [hU'] at hv; simp at hv
    | cons u us => rw [hU'] at hv; simp at hv; rw [← hv]; exact hU u (by rw [hU']; simp)

/-- helper: a kernel output is smaller than the stopping column it replaces. -/
theorem ker_kernel_lt_stop {K : Forest} {sd : StopData} {rd : RootData}
    (hU : ∀ x ∈ unconsumed K rd, x.1 < sd.r) (X : Forest) :
    kernel K sd rd X < Tree.node [sd.Q ++ [(sd.r, Tree.empty)]] := by
  obtain ⟨V, cs, hk, hV⟩ := ker_kernel_firstCol hU X
  rw [hk]
  show Tree.cmp compare _ _ = .lt
  simp only [Tree.cmp, Tree.cmpCols]
  rw [ker_cmpCol_append_left]
  cases V with
  | nil => rfl
  | cons v vs =>
    obtain ⟨p, h⟩ := v
    have hp : p < sd.r := hV _ rfl
    simp only [Tree.cmpCol]
    rw [Nat.compare_eq_lt.2 hp]
    rfl

/-- helper: every kernel iterate is smaller than the stopping column. -/
theorem ker_iterate_lt_stop {K : Forest} {sd : StopData} {rd : RootData}
    (hU : ∀ x ∈ unconsumed K rd, x.1 < sd.r) (n : Nat) :
    (kernel K sd rd)^[n] Tree.empty < Tree.node [sd.Q ++ [(sd.r, Tree.empty)]] := by
  cases n with
  | zero => exact Forest.empty_lt (by simp [Tree.empty])
  | succ n =>
    rw [Function.iterate_succ_apply']
    exact ker_kernel_lt_stop hU _

/-- helper: placing a smaller filling into the same route gives a smaller forest. -/
theorem ker_replaceAt_lt {k : Nat} {L : Forest} (hL : KerRoute k L) {Y Y' : Forest}
    (h : Y < Y') : replaceAt 0 0 Y k L < replaceAt 0 0 Y' k L := by
  rw [← word_lt_iff]
  unfold word
  rw [ker_wordAt_replaceAt Y k L 0 hL, ker_wordAt_replaceAt Y' k L 0 hL,
    ker_append_lt_append_iff, Nat.zero_add, show k = 0 + k by omega, wordAt_add, wordAt_add]
  exact List.map_lt (fun x y hxy => depthShift_strictMono k hxy) ((word_lt_iff Y Y').2 h)


/-! ## §T3.2 — closure -/

/-- T3.2d: the word of a key (U1's generic word at labels `Bool ×ₗ Nat`); positions and length
equal those of the underlying forest's word (`relKey` is a relabelling). -/
def keyWord (K : Key) : List (Nat ×ₗ Nat ×ₗ WithBot (Bool ×ₗ Nat)) :=
  gwordAt 0 (K.map fun x => (toLex x : Bool ×ₗ Nat))

/-- T3.2h (txt:331-336): `κ_j` on key labels: add `j·d` to a false field `(0, p)` with `p ≥ r`. -/
def kappaLabel (r d j : Nat) (x : Bool × Nat) : Bool × Nat :=
  if x.1 = false ∧ r ≤ x.2 then (false, x.2 + j * d) else x

def kappa (r d j : Nat) (K : Key) : Key := K.map (kappaLabel r d j)

/-- T3.2h helper: on false fields `κ_j` is the parent shift `T_{r,jd}`. -/
theorem ker_kappaLabel_false (r d j p : Nat) :
    kappaLabel r d j (false, p) = (false, shiftVal r (j * d) p) := by
  unfold kappaLabel shiftVal
  by_cases h : r ≤ p <;> simp [h]

theorem ker_kappaLabel_true (r d j p : Nat) : kappaLabel r d j (true, p) = (true, p) := by
  unfold kappaLabel; simp

/-- T3.2h helper: shifts preserve `compare`. -/
theorem ker_compare_shiftVal (r d p q : Nat) :
    compare (shiftVal r d p) (shiftVal r d q) = compare p q := by
  rcases Nat.lt_trichotomy p q with h | rfl | h
  · rw [Nat.compare_eq_lt.2 h, Nat.compare_eq_lt.2 (ker_shiftVal_strictMono r d h)]
  · rw [Nat.compare_eq_eq.2 rfl, Nat.compare_eq_eq.2 rfl]
  · rw [Nat.compare_eq_gt.2 h, Nat.compare_eq_gt.2 (ker_shiftVal_strictMono r d h)]

/-- T3.2h helper: `κ_j` preserves the key-label comparison. -/
theorem ker_kappaLabel_cmp (r d j : Nat) (x y : Bool × Nat) :
    keyLabelCmp (kappaLabel r d j x) (kappaLabel r d j y) = keyLabelCmp x y := by
  obtain ⟨a, p⟩ := x
  obtain ⟨b, q⟩ := y
  cases a <;> cases b <;>
    simp only [ker_kappaLabel_false, ker_kappaLabel_true, keyLabelCmp, ker_compare_shiftVal] <;> rfl

-- T3.2h: `h_{x+jd}(τ_j H) = κ_j(h_x(H))` for `x ≥ r`
theorem relKey_shift (r d j x : Nat) (hx : r ≤ x) (H : Forest) :
    relKey (x + j * d) (shift r (j * d) H) = kappa r d j (relKey x H) := by
  unfold relKey shift kappa
  rw [treeMap_map, treeMap_map]
  congr 1
  funext p
  simp only [Function.comp]
  by_cases h1 : p < r
  · have h2 : p < x := by omega
    rw [show shiftVal r (j * d) p = p by unfold shiftVal; rw [if_neg (by omega)],
      if_pos (by omega), if_pos h2, ker_kappaLabel_false]
    unfold shiftVal; rw [if_neg (by omega)]
  · by_cases h2 : p < x
    · rw [show shiftVal r (j * d) p = p + j * d by unfold shiftVal; rw [if_pos (by omega)],
        if_pos (by omega), if_pos h2, ker_kappaLabel_false]
      unfold shiftVal; rw [if_pos (by omega)]
    · rw [show shiftVal r (j * d) p = p + j * d by unfold shiftVal; rw [if_pos (by omega)],
        if_neg (by omega), if_neg h2, ker_kappaLabel_true]
      congr 1; omega

-- T3.2h: `κ_i κ_j = κ_{i+j}`
theorem kappa_add (r d i j : Nat) (K : Key) : kappa r d i (kappa r d j K) = kappa r d (i + j) K := by
  unfold kappa
  rw [treeMap_map]
  congr 1
  funext x
  obtain ⟨b, p⟩ := x
  cases b
  · simp only [Function.comp, ker_kappaLabel_false]
    unfold shiftVal
    by_cases h : r ≤ p
    · rw [if_pos h, if_pos (by omega), if_pos h]; congr 1; rw [Nat.add_mul]; omega
    · rw [if_neg h, if_neg h, if_neg h]
  · simp only [Function.comp, ker_kappaLabel_true]

-- T3.2h: `κ_j` is an order embedding of keys
theorem kappa_strictMono (r d j : Nat) : StrictMono (kappa r d j) := by
  intro K K' h
  show keyCmp (kappa r d j K) (kappa r d j K') = .lt
  unfold keyCmp kappa
  rw [Tree.cmp_map (ker_kappaLabel_cmp r d j)]
  exact h

-- T3.2h: `κ_j` commutes with `ν`
theorem kappa_nu (r d j : Nat) (l : List Key) : nu (l.map (kappa r d j)) = (nu l).map (kappa r d j) := by
  exact nu_map (kappa_strictMono r d j) l

-- T3.2h: keys normalized at or below `r` are fixed
theorem kappa_fix (r d j x : Nat) (hx : x ≤ r) (H : Forest) : kappa r d j (relKey x H) = relKey x H := by
  unfold kappa relKey
  rw [treeMap_map]
  congr 1
  funext p
  simp only [Function.comp]
  by_cases h : p < x
  · rw [if_pos h, ker_kappaLabel_false]
    unfold shiftVal; rw [if_neg (by omega)]
  · rw [if_neg h, ker_kappaLabel_true]

-- T3.2h (3) (txt:572-575): `T_{ρ,x+δ−ρ} = τ_δ ∘ T_{ρ,x−ρ}` for `ρ ≤ r ≤ x`
theorem shiftVal_comp {ρ r x δ : Nat} (hρ : ρ ≤ r) (hx : r ≤ x) (p : Nat) :
    shiftVal ρ (x + δ - ρ) p = shiftVal r δ (shiftVal ρ (x - ρ) p) := by
  unfold shiftVal
  split_ifs <;> omega

-- T3.2h: `T_{ρ'+δ,d} ∘ τ_δ = τ_δ ∘ T_{ρ',d}` for `r ≤ ρ'` (phase conjugacy of root shifts)
theorem shiftVal_conj {r ρ' δ d : Nat} (hr : r ≤ ρ') (p : Nat) :
    shiftVal (ρ' + δ) d (shiftVal r δ p) = shiftVal r δ (shiftVal ρ' d p) :=
  ker_shiftVal_conj hr p

-- T3.2h: shifts are order embeddings of forests
theorem shift_lt_shift (r d : Nat) {X Y : Forest} : shift r d X < shift r d Y ↔ X < Y := by
  show Tree.cmp compare (shift r d X) (shift r d Y) = .lt ↔ Tree.cmp compare X Y = .lt
  unfold shift
  rw [Tree.cmp_map (ker_compare_shiftVal r d)]

/-- T3.2i: placement of an address of a forest `X` whose columns are put at the hole column `h`
(the address-level fill law of `A_{r,d,ℓ,X}` and `C_E(X)`). -/
def underCol (h a : ColAddr) : ColAddr :=
  match a.path with
  | [] => ⟨h.path, h.col + a.col⟩
  | (c0, e0) :: rest => ⟨h.path ++ (h.col + c0, e0) :: rest, a.col⟩

/-- T3.2i: Q-height material: addresses inside the height of an entry `j < |Q|` of the stopping
column. -/
def isQMat (sd : StopData) (a : ColAddr) : Bool :=
  (a.path.take sd.col.path.length == sd.col.path) &&
    match a.path.drop sd.col.path.length with
    | (ci, j) :: _ => ci == sd.col.col && decide (j < sd.Q.length)
    | [] => false

/-- T3.2i: the template map of one period: an address of `A` in the copied region ↦ its address
relative to the kernel output. Q-heights go to the head's first `m` entries; the root column
goes to the head (column 0); restored heights (entries `c + v`) go to head entries `m + v`;
body columns `ι+1+z` go to column `1+z` (body case only). `none` outside the template. -/
def kerCol (sd : StopData) (rd : RootData) (a : ColAddr) : Option ColAddr :=
  let m := sd.Q.length
  if isQMat sd a then
    match a.path.drop sd.col.path.length with
    | (_, j) :: rest => some ⟨(0, j) :: rest, a.col⟩
    | [] => none
  else if a.path.take rd.col.path.length = rd.col.path then
    match a.path.drop rd.col.path.length with
    | (ci, e) :: rest =>
      if ci = rd.idx ∧ rd.cursor ≤ e then some ⟨(0, m + (e - rd.cursor)) :: rest, a.col⟩
      else if rd.idx < ci ∧ rd.owner = false then some ⟨(ci - rd.idx, e) :: rest, a.col⟩
      else none
    | [] =>
      if a.col = rd.idx then some ⟨[], 0⟩
      else if rd.idx < a.col ∧ rd.owner = false then some ⟨[], a.col - rd.idx⟩
      else none
  else none

/-- T3.2i: the hole of the kernel (the image of the stopping column). -/
def kerHole (sd : StopData) (rd : RootData) : ColAddr := (kerCol sd rd sd.col).getD ⟨[], 0⟩

/-- T3.2i: the address in `E[n] = C_E(F^n(∅))` of the phase-`i` copy (`i ≥ 1`, `i`-th kernel
layer from outside) of the template address `a`. -/
def phaseCol (sd : StopData) (rd : RootData) (i : Nat) (a : ColAddr) : Option ColAddr :=
  (kerCol sd rd a).map fun a' => underCol sd.col ((underCol (kerHole sd rd))^[i - 1] a')

/-- T3.2i: the phase of the copy: Q-heights in head `i` have phase `i − 1`, all other template
material in layer `i` has phase `i`. -/
def phaseOff (sd : StopData) (i : Nat) (a : ColAddr) : Nat := if isQMat sd a then i - 1 else i

/-- T3.2i: a template column of `A` (copied region, excluding the root and stopping columns). -/
def IsTmplCol (A : Forest) (sd : StopData) (rd : RootData) (a : ColAddr) : Prop :=
  a ∈ A.colAddrs ∧ a ≠ sd.col ∧ a ≠ rd.col ∧ (kerCol sd rd a).isSome

/-- T3.2i / T3.8: `a` lies in a forest on the route to the stopping column (its local suffix
contains the continuation hole). -/
def OnHoleRoute (sd : StopData) (a : ColAddr) : Prop := a.path <+: sd.col.path

/-! ### T3.2i helpers: numbers of placed addresses -/

theorem ker_num_cons (x : Nat × Nat) (p : List (Nat × Nat)) (c : Nat) :
    ColAddr.num 0 ⟨x :: p, c⟩ = x.1 + 1 + ColAddr.num 0 ⟨p, c⟩ := by
  unfold ColAddr.num; simp; omega

theorem ker_num_append (p q : List (Nat × Nat)) (c : Nat) :
    ColAddr.num 0 ⟨p ++ q, c⟩ = (p.map (·.1 + 1)).sum + ColAddr.num 0 ⟨q, c⟩ := by
  unfold ColAddr.num; simp [List.map_append, List.sum_append]; omega

theorem ker_num_underCol (h a : ColAddr) : (underCol h a).num 0 = h.num 0 + a.num 0 := by
  obtain ⟨p, c⟩ := a
  cases p with
  | nil => simp only [underCol]; unfold ColAddr.num; simp; omega
  | cons x rest =>
    obtain ⟨c0, e0⟩ := x
    simp only [underCol]
    rw [ker_num_append, ker_num_cons]
    unfold ColAddr.num; simp; omega

theorem ker_num_iterate (h : ColAddr) :
    ∀ (k : Nat) (a : ColAddr), ((underCol h)^[k] a).num 0 = k * h.num 0 + a.num 0
  | 0, a => by simp
  | k + 1, a => by
    rw [Function.iterate_succ_apply', ker_num_underCol, ker_num_iterate h k a, Nat.succ_mul]
    omega

/-- T3.2i helper: `kerCol` subtracts `t` (Q-material) or `r` (root-tail material) from numbers. -/
theorem ker_num_kerCol {A : Forest} {sd : StopData} {rd : RootData} (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) {a a' : ColAddr} (h : kerCol sd rd a = some a') :
    a'.num 0 + (if isQMat sd a then sd.t else sd.r) = a.num 0 := by
  obtain ⟨-, -, ht, -⟩ := stopData_spec hsd
  obtain ⟨-, -, hidx, hnum, -⟩ := rootData_spec hsd hrd
  have hsplit : ∀ (l : List (Nat × Nat)) (k : Nat), l = l.take k ++ l.drop k :=
    fun l k => (List.take_append_drop k l).symm
  unfold kerCol at h
  by_cases hq : isQMat sd a = true
  · rw [if_pos hq] at h ⊢
    have hq' := hq
    unfold isQMat at hq'
    rw [Bool.and_eq_true, beq_iff_eq] at hq'
    obtain ⟨h1, h2⟩ := hq'
    cases hd : a.path.drop sd.col.path.length with
    | nil => rw [hd] at h2; cases h2
    | cons x rest =>
      obtain ⟨ci, j⟩ := x
      rw [hd] at h h2
      simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at h2
      simp only [Option.some.injEq] at h
      subst h
      obtain ⟨a1, a2⟩ := a
      simp only at h1 hd h2 ⊢
      have hp := hsplit a1 sd.col.path.length
      rw [h1, hd] at hp
      rw [ht, hp, ker_num_append, ker_num_cons, ker_num_cons, h2.1]
      unfold ColAddr.num; omega
  · rw [if_neg hq] at h ⊢
    simp only [Bool.not_eq_true] at hq
    by_cases hρ : a.path.take rd.col.path.length = rd.col.path
    swap
    · rw [if_neg hρ] at h; cases h
    rw [if_pos hρ] at h
    obtain ⟨a1, a2⟩ := a
    simp only at hρ h ⊢
    have hp := hsplit a1 rd.col.path.length
    rw [hρ] at hp
    rw [← hnum]
    cases hd : a1.drop rd.col.path.length with
    | nil =>
      rw [hd] at h hp
      rw [List.append_nil] at hp
      simp only at h
      split_ifs at h with hc1 hc2
      · simp only [Option.some.injEq] at h; subst h
        rw [hp]; unfold ColAddr.num; simp; omega
      · simp only [Option.some.injEq] at h; subst h
        rw [hp]; unfold ColAddr.num; simp; omega
    | cons x rest =>
      obtain ⟨ci, e⟩ := x
      rw [hd] at h hp
      simp only at h
      split_ifs at h with hc1 hc2
      · simp only [Option.some.injEq] at h; subst h
        rw [hp, ker_num_append, ker_num_cons, ker_num_cons, hc1.1]
        unfold ColAddr.num; simp; omega
      · simp only [Option.some.injEq] at h; subst h
        rw [hp, ker_num_append, ker_num_cons, ker_num_cons]
        unfold ColAddr.num; simp; omega

/-- T3.2i helper: the kernel is defined on `L`. -/
theorem ker_kernelDefined {A : Forest} {sd : StopData} {rd : RootData} (hL : InL A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) : KernelDefined A rd := by
  obtain ⟨hV, -, -, hA, hS⟩ := hL
  intro ho h
  have := owner_root_nonexhaust hV hA hS hsd hrd ho
  unfold unconsumed rootCol at h
  have := congrArg List.length h
  simp at this
  omega

/-- T3.2i helper: where the stopping column lies relative to the root column. -/
theorem ker_stop_path {A : Forest} {sd : StopData} {rd : RootData} (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) (hkd : KernelDefined A rd) :
    (rd.owner = false ∧ ((sd.col.path = rd.col.path ∧ rd.idx < sd.col.col) ∨
        ∃ ci e rest, sd.col.path = rd.col.path ++ (ci, e) :: rest ∧ rd.idx < ci)) ∨
      (rd.owner = true ∧ ∃ e rest, sd.col.path = rd.col.path ++ (rd.idx, e) :: rest ∧
        rd.cursor ≤ e ∧ e + 1 = (rootCol A rd).length) := by
  obtain ⟨-, hnum, hlay, hpre, -, hown, hlen⟩ := rootData_path hsd hrd
  obtain ⟨-, -, hidx, -, hrt, hmem, -⟩ := rootData_spec hsd hrd
  obtain ⟨-, hdep, ht, hrmem, -⟩ := stopData_spec hsd
  obtain ⟨hpath, -⟩ := (Scan.mem_routeCols_iff A sd.col).1 hrmem
  obtain ⟨t, ht'⟩ := hpre
  cases t with
  | nil =>
    rw [List.append_nil] at ht'
    left
    have hown' : rd.owner = false := by
      cases ho : rd.owner
      · rfl
      · exfalso
        have := hown.1 ho
        unfold ColAddr.container at this
        rw [← ht', List.drop_length] at this
        cases this
    refine ⟨hown', Or.inl ⟨ht'.symm, ?_⟩⟩
    rw [hidx]
    have h1 : rd.col.num 0 < sd.col.num 0 := by rw [hnum, ← ht]; exact hrt
    unfold ColAddr.num at h1
    rw [← ht'] at h1
    omega
  | cons x rest =>
    obtain ⟨ci, e⟩ := x
    have hj : rd.col.path.length < sd.col.path.length := by rw [← ht']; simp
    obtain ⟨G, hG, hlast⟩ := hpath rd.col.path.length hj
    have htake : sd.col.path.take rd.col.path.length = rd.col.path := by
      rw [← ht', List.take_left' rfl]
    have hstep : sd.col.path[rd.col.path.length]? = some (ci, e) := by
      rw [← ht', List.getElem?_append_right (le_refl _), Nat.sub_self]; rfl
    rw [htake] at hG
    rw [hstep] at hlast
    -- `ci` is the last column of the root forest
    have hci : ci + 1 = G.cols.length := by
      unfold Tree.lastStep? at hlast
      cases hgc : G.cols.getLast? with
      | none => rw [hgc] at hlast; cases hlast
      | some col =>
        rw [hgc] at hlast
        simp only [Option.bind_some] at hlast
        split at hlast
        · cases hlast
        · simp only [Option.some.injEq, Prod.mk.injEq] at hlast
          have : G.cols.length ≠ 0 := by intro h0; rw [List.length_eq_zero_iff] at h0; rw [h0] at hgc; cases hgc
          omega
    have hidxlt : rd.idx < G.cols.length := by
      obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff A rd.col).1 hmem)
      unfold Tree.colAt at hcol
      rw [hG, Option.bind_some] at hcol
      rw [hidx]
      by_contra h; rw [List.getElem?_eq_none (by omega)] at hcol; cases hcol
    cases ho : rd.owner
    · left
      refine ⟨rfl, Or.inr ⟨ci, e, rest, ht'.symm, ?_⟩⟩
      have hne : ci ≠ rd.idx := by
        intro hc
        have hcont : (rd.col.container sd.col).isSome := by
          unfold ColAddr.container
          rw [← ht', List.drop_left' rfl, List.take_left' rfl]
          simp [hc, hidx]
        rw [← hown] at hcont
        rw [ho] at hcont; cases hcont
      omega
    · right
      have hcont := hown.1 ho
      obtain ⟨en, hen⟩ := Option.isSome_iff_exists.1 hcont
      have hen' := hen
      unfold ColAddr.container at hen'
      rw [← ht', List.drop_left' rfl, List.take_left' rfl] at hen'
      simp only at hen'
      split_ifs at hen' with hc
      simp only [Option.some.injEq] at hen'
      subst hen'
      have hl := hlen _ hen
      unfold Packet.rootLenOf at hl
      refine ⟨rfl, e, rest, ?_, ?_, ?_⟩
      · rw [← ht', hidx, hc.2]
      · have hU : unconsumed A rd ≠ [] := hkd ho
        unfold unconsumed at hU
        have : rd.cursor < (rootCol A rd).length := by
          by_contra h; exact hU (List.drop_eq_nil_of_le (by omega))
        unfold rootCol at this
        simp only at hl
        omega
      · unfold rootCol; simp only at hl; exact hl

/-- T3.2i helper: the hole of the kernel has number `d`. -/
theorem ker_kerCol_stop {A : Forest} {sd : StopData} {rd : RootData} (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) (hkd : KernelDefined A rd) :
    kerCol sd rd sd.col = some (kerHole sd rd) ∧ isQMat sd sd.col = false := by
  have hq : isQMat sd sd.col = false := by
    unfold isQMat
    simp [List.drop_length]
  refine ⟨?_, hq⟩
  have hsome : (kerCol sd rd sd.col).isSome := by
    unfold kerCol
    rw [if_neg (by simp [hq])]
    have hidx := (rootData_spec hsd hrd).2.2.1
    rcases ker_stop_path hsd hrd hkd with ⟨ho, ⟨hp, hlt⟩ | ⟨ci, e, rest, hp, hlt⟩⟩ |
        ⟨ho, e, rest, hp, hle, -⟩
    · rw [hp, List.take_length, if_pos rfl, List.drop_length]
      simp only
      rw [if_neg (by omega), if_pos ⟨hlt, ho⟩]
      rfl
    · rw [hp, List.take_left' rfl, if_pos rfl, List.drop_left' rfl]
      simp only
      rw [if_neg (by omega), if_pos ⟨hlt, ho⟩]
      rfl
    · rw [hp, List.take_left' rfl, if_pos rfl, List.drop_left' rfl]
      simp only
      rw [if_pos (by simp [hle])]
      rfl
  obtain ⟨h, hh⟩ := Option.isSome_iff_exists.1 hsome
  unfold kerHole
  rw [hh]
  rfl

theorem ker_num_kerHole {A : Forest} {sd : StopData} {rd : RootData} (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) (hkd : KernelDefined A rd) :
    (kerHole sd rd).num 0 + sd.r = sd.t := by
  obtain ⟨h1, h2⟩ := ker_kerCol_stop hsd hrd hkd
  have := ker_num_kerCol hsd hrd h1
  rw [h2, if_neg (by simp)] at this
  rw [this]
  exact (stopData_spec hsd).2.2.1.symm

/-! ### T3.2i helpers: placement under a hole -/

/-- T3.2i helper: the route hole of a forest at depth `k` (the last column reached at depth `k`
by following last columns and last entries). -/
def kerHoleAt : Nat → Forest → ColAddr
  | 0, F => ⟨[], F.cols.length - 1⟩
  | k + 1, F =>
    ⟨(F.cols.length - 1, (F.cols.getLast?.getD []).length - 1) ::
        (kerHoleAt k ((((F.cols.getLast?.getD []).getLast?).map Prod.snd).getD Tree.empty)).path,
      (kerHoleAt k ((((F.cols.getLast?.getD []).getLast?).map Prod.snd).getD Tree.empty)).col⟩

theorem ker_kerHoleAt_succ {G : Forest} {col : Column} {p : Nat} {H : Forest}
    (hc : G.cols.getLast? = some col) (hl : col.getLast? = some (p, H)) (k : Nat) :
    kerHoleAt (k + 1) G =
      ⟨(G.cols.length - 1, col.length - 1) :: (kerHoleAt k H).path, (kerHoleAt k H).col⟩ := by
  simp only [kerHoleAt, hc, hl, Option.getD_some, Option.map_some]

theorem ker_kerHoleAt_map (f : Nat → Nat) : ∀ (k : Nat) (G : Forest),
    kerHoleAt k (Tree.map f G) = kerHoleAt k G
  | 0, G => by simp only [kerHoleAt, ker_map_cols, List.length_map]
  | k + 1, G => by
    simp only [kerHoleAt, ker_map_cols, List.length_map, List.getLast?_map]
    cases hc : G.cols.getLast? with
    | none => simp only [Option.map_none, Option.getD_none]
    | some col =>
      simp only [Option.map_some, Option.getD_some]
      rw [treeMapCol_eq_map, List.length_map, List.getLast?_map]
      cases hl : col.getLast? with
      | none => simp only [Option.map_none, Option.getD_none]
      | some x => simp only [Option.map_some, Option.getD_some, ker_kerHoleAt_map f k x.2]

theorem ker_kerHoleAt_shift (r d k : Nat) (G : Forest) :
    kerHoleAt k (shift r d G) = kerHoleAt k G := ker_kerHoleAt_map _ k G

theorem ker_forestAt_cons' {α : Type} (T : Tree α) (x : Nat × Nat) (p : List (Nat × Nat)) :
    T.forestAt (x :: p) = (T.forestAt [x]).bind fun F => F.forestAt p := by
  rw [← Tree.forestAt_append]; rfl

/-- T3.2i helper: the forest of the hole after a placement: the columns before the hole followed by
the filling's columns. -/
theorem ker_hole_forest (Z : Forest) : ∀ (k : Nat) (G : Forest), KerRoute k G →
    ∃ L : List Column, (replaceAt 0 0 Z k G).forestAt (kerHoleAt k G).path =
      some (Tree.node (L ++ Z.cols)) ∧ L.length = (kerHoleAt k G).col
  | 0, .node cols, h => by
    have hne : cols ≠ [] := h
    refine ⟨cols.dropLast, ?_, ?_⟩
    · simp only [kerHoleAt, Tree.forestAt]; rw [ker_replaceAt_zero_zero _ _ hne]
    · simp [kerHoleAt, Tree.cols]
  | k + 1, G, ⟨col, p, H, hc, hl, hk⟩ => by
    obtain ⟨L, hL1, hL2⟩ := ker_hole_forest Z k H hk
    refine ⟨L, ?_, ?_⟩
    · rw [ker_kerHoleAt_succ hc hl, ker_forestAt_cons', ker_replaceAt_forestAt_last Z k hc hl,
        Option.bind_some, hL1]
    · rw [ker_kerHoleAt_succ hc hl]; exact hL2

/-- T3.2i helper (fill law under the hole): columns and local suffixes under the hole of a
placement are those of the filling. -/
theorem ker_hole_law (Z : Forest) {k : Nat} {G : Forest} (hG : KerRoute k G) (y : ColAddr) :
    (replaceAt 0 0 Z k G).colAt (underCol (kerHoleAt k G) y) = Z.colAt y ∧
      localSuffix (replaceAt 0 0 Z k G) (underCol (kerHoleAt k G) y) = localSuffix Z y := by
  obtain ⟨L, hL1, hL2⟩ := ker_hole_forest Z k G hG
  obtain ⟨yp, yc⟩ := y
  cases yp with
  | nil =>
    simp only [underCol]
    unfold Tree.colAt localSuffix
    simp only [hL1, Option.bind_some, Option.getD_some, Tree.forestAt, Tree.cols]
    rw [← hL2, List.getElem?_append_right (by omega), Nat.add_sub_cancel_left, ← List.drop_drop,
      List.drop_left]
    exact ⟨rfl, rfl⟩
  | cons x rest =>
    obtain ⟨c0, e0⟩ := x
    simp only [underCol]
    have hf : (replaceAt 0 0 Z k G).forestAt
        ((kerHoleAt k G).path ++ ((kerHoleAt k G).col + c0, e0) :: rest) =
          Z.forestAt ((c0, e0) :: rest) := by
      rw [Tree.forestAt_append, hL1, Option.bind_some, ker_forestAt_cons, ker_forestAt_cons]
      simp only [Tree.cols]
      rw [← hL2, List.getElem?_append_right (by omega), Nat.add_sub_cancel_left]
    unfold Tree.colAt localSuffix
    simp only
    rw [hf]
    exact ⟨rfl, rfl⟩

/-- T3.2i helper: along the stopping route, the route holes are the stopping column. -/
theorem ker_holeAt_of_stop {E : Forest} {sd : StopData} (hsd : stopData E = some sd) :
    ∀ j, j ≤ sd.depth → ∃ G, E.forestAt (sd.col.path.take j) = some G ∧
      kerHoleAt (sd.depth - j) G = ⟨sd.col.path.drop j, sd.col.col⟩ := by
  obtain ⟨-, hdep, -, hmem, -⟩ := stopData_spec hsd
  obtain ⟨hpath, -⟩ := (Scan.mem_routeCols_iff E sd.col).1 hmem
  obtain ⟨F, hF, hFlen, -⟩ := ker_stopForest hsd
  suffices h : ∀ m j, j + m = sd.col.path.length →
      ∃ G, E.forestAt (sd.col.path.take j) = some G ∧
        kerHoleAt m G = ⟨sd.col.path.drop j, sd.col.col⟩ by
    intro j hj
    exact h (sd.depth - j) j (by omega)
  intro m
  induction m with
  | zero =>
    intro j hj
    refine ⟨F, ?_, ?_⟩
    · rw [List.take_of_length_le (by omega)]; exact hF
    · simp only [kerHoleAt, hFlen, Nat.add_sub_cancel]
      rw [List.drop_of_length_le (by omega)]
  | succ m ih =>
    intro j hj
    obtain ⟨H, hH, hHr⟩ := ih (j + 1) (by omega)
    obtain ⟨G, hG, hlast⟩ := hpath j (by omega)
    refine ⟨G, hG, ?_⟩
    have hj' : j < sd.col.path.length := by omega
    rw [List.getElem?_eq_getElem hj'] at hlast
    unfold Tree.lastStep? at hlast
    cases hgc : G.cols.getLast? with
    | none => rw [hgc] at hlast; simp at hlast
    | some col =>
      rw [hgc] at hlast
      simp only [Option.bind_some] at hlast
      split at hlast
      · simp at hlast
      · rename_i hne
        have hstep : sd.col.path[j] = (G.cols.length - 1, col.length - 1) :=
          (Option.some.inj hlast).symm
        have hcol : col ≠ [] := by simpa using hne
        obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 (List.getLast?_isSome.2 hcol)
        obtain ⟨p, H'⟩ := x
        rw [List.take_add_one, List.getElem?_eq_getElem hj', Option.toList_some,
          Tree.forestAt_append, hG, Option.bind_some, hstep, ker_forestAt_lastStep hgc hx] at hH
        cases hH
        rw [ker_kerHoleAt_succ hgc hx, hHr, List.drop_eq_getElem_cons hj', hstep]

/-- T3.2i helper: the stopping column is the route hole of the whole expression. -/
theorem ker_stop_hole {E : Forest} {sd : StopData} (hsd : stopData E = some sd) :
    KerRoute sd.depth E ∧ kerHoleAt sd.depth E = sd.col := by
  obtain ⟨G, hG, hR⟩ := ker_route_of_stop hsd 0 (Nat.zero_le _)
  obtain ⟨G', hG', hH⟩ := ker_holeAt_of_stop hsd 0 (Nat.zero_le _)
  simp only [List.take_zero, Tree.forestAt, Option.some.injEq] at hG hG'
  subst hG hG'
  rw [Nat.sub_zero] at hR hH
  exact ⟨hR, by rw [hH]; rfl⟩

/-- T3.2i helper (context fill law). -/
theorem ker_context_law {E : Forest} {sd : StopData} (hsd : stopData E = some sd) (Z : Forest)
    (y : ColAddr) :
    (context E sd Z).colAt (underCol sd.col y) = Z.colAt y ∧
      localSuffix (context E sd Z) (underCol sd.col y) = localSuffix Z y := by
  obtain ⟨hR, hH⟩ := ker_stop_hole hsd
  have := ker_hole_law Z hR y
  rw [hH] at this
  exact this

/-- T3.2i helper: shifts relabel forests at every address. -/
theorem ker_forestAt_map (f : Nat → Nat) : ∀ (p : List (Nat × Nat)) (X : Forest),
    (Tree.map f X).forestAt p = (X.forestAt p).map (Tree.map f)
  | [], X => rfl
  | (c, e) :: rest, X => by
    rw [ker_forestAt_cons, ker_forestAt_cons, ker_map_cols, List.getElem?_map]
    cases hc : X.cols[c]? with
    | none => rfl
    | some col =>
      simp only [Option.map_some, Option.bind_some]
      rw [treeMapCol_eq_map, List.getElem?_map]
      cases he : col[e]? with
      | none => rfl
      | some x => simp only [Option.map_some, Option.bind_some]; exact ker_forestAt_map f rest x.2

theorem ker_shift_law (r d : Nat) (X : Forest) (y : ColAddr) :
    (shift r d X).colAt y = (X.colAt y).map (Tree.mapCol (shiftVal r d)) ∧
      localSuffix (shift r d X) y = shift r d (localSuffix X y) := by
  unfold shift Tree.colAt localSuffix
  rw [ker_forestAt_map]
  cases X.forestAt y.path with
  | none => simp [Tree.empty, Tree.cols, Tree.map, Tree.mapCols]
  | some F =>
    constructor
    · simp [ker_map_cols, List.getElem?_map]
    · simp only [Option.map_some, Option.getD_some, ker_map_cols]
      simp only [Tree.map]
      rw [treeMapCols_eq_map, List.map_drop]

/-- T3.2i helper: the kernel is a placement of `T_d X` into a kernel with an open hole. -/
def kerOpen (E : Forest) (sd : StopData) (rd : RootData) : Forest :=
  if rd.owner then
    .node [sd.Q ++ (unconsumed E rd).map fun x => (x.1, shift sd.r (period sd) x.2)]
  else
    .node ((sd.Q ++ (unconsumed E rd).map fun x => (x.1, shift sd.r (period sd) x.2)) ::
      (shift sd.r (period sd) (.node ((rootForest E rd).cols.drop (rd.idx + 1)))).cols)

theorem ker_route_cons {c : Column} {cs : List Column} (hcs : cs ≠ []) :
    ∀ k, KerRoute k (Tree.node cs) → KerRoute k (Tree.node (c :: cs))
  | 0, _ => by show c :: cs ≠ []; simp
  | k + 1, ⟨col, p, H, h1, h2, h3⟩ => by
    refine ⟨col, p, H, ?_, h2, h3⟩
    obtain ⟨y, ys, rfl⟩ := List.exists_cons_of_ne_nil hcs
    simp only [Tree.cols] at h1 ⊢
    rw [List.getLast?_cons_cons]; exact h1

theorem ker_route_drop : ∀ (k : Nat) (cs : List Column) (i : Nat), i < cs.length →
    KerRoute k (Tree.node cs) → KerRoute k (Tree.node (cs.drop i))
  | 0, cs, i, hi, _ => by
    show cs.drop i ≠ []
    intro h; have := congrArg List.length h; simp at this; omega
  | k + 1, cs, i, hi, ⟨col, p, H, h1, h2, h3⟩ => by
    refine ⟨col, p, H, ?_, h2, h3⟩
    simp only [Tree.cols] at h1 ⊢
    rw [List.getLast?_drop, if_neg (by omega), h1]

/-- helper: a placement through the last column leaves the first column alone. -/
theorem ker_replaceAt_cons (Z : Forest) (δ : Nat) (c : Column) {cs : List Column} (hcs : cs ≠ []) :
    replaceAt 0 0 Z δ (Tree.node (c :: cs)) =
      Tree.node (c :: (replaceAt 0 0 Z δ (Tree.node cs)).cols) := by
  have := ker_replaceAt_split Z δ (c :: cs) 1 (by
    obtain ⟨y, ys, rfl⟩ := List.exists_cons_of_ne_nil hcs; simp)
  simp only [List.take_succ_cons, List.take_zero, List.drop_succ_cons, List.drop_zero,
    List.singleton_append] at this
  rw [← ker_node_cols (replaceAt 0 0 Z δ (Tree.node (c :: cs))), this]

theorem ker_kernel_open {E : Forest} {sd : StopData} {rd : RootData} (hsd : stopData E = some sd)
    (hrd : rootData E = some rd) (hkd : KernelDefined E rd) (X : Forest) :
    kernel E sd rd X = replaceAt 0 0 (shift sd.r (period sd) X) (holeDepth sd rd) (kerOpen E sd rd) ∧
      KerRoute (holeDepth sd rd) (kerOpen E sd rd) ∧
      kerHoleAt (holeDepth sd rd) (kerOpen E sd rd) = kerHole sd rd := by
  obtain ⟨hF, hR⟩ := ker_route_rootForest hsd hrd
  obtain ⟨-, -, hidx, -, -, hmem, -, hown⟩ := rootData_spec hsd hrd
  obtain ⟨-, hdep, -⟩ := stopData_spec hsd
  obtain ⟨-, -, hlay, -⟩ := rootData_path hsd hrd
  obtain ⟨hkc, hq⟩ := ker_kerCol_stop hsd hrd hkd
  obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff E rd.col).1 hmem)
  have hcolF : (rootForest E rd).cols[rd.idx]? = some col := by
    unfold Tree.colAt at hcol; rw [hF, Option.bind_some, ← hidx] at hcol; exact hcol
  have hidxlt : rd.idx < (rootForest E rd).cols.length := by
    by_contra h; rw [List.getElem?_eq_none (by omega)] at hcolF; cases hcolF
  have hδ : holeDepth sd rd = sd.col.path.length - rd.col.path.length := by
    unfold holeDepth; rw [hdep, hlay]
  obtain ⟨Gh, hGh, hGhole⟩ := ker_holeAt_of_stop hsd rd.layer (rootData_layer_le hsd hrd)
  rw [← (ker_rootPath hsd hrd).1, hF] at hGh
  cases hGh
  rw [show sd.depth - rd.layer = holeDepth sd rd from rfl] at hGhole
  unfold kerCol at hkc
  rw [if_neg (by simp [hq])] at hkc
  rcases hFF : rootForest E rd with ⟨cs⟩
  rw [hFF] at hcolF hidxlt hR hGhole hF
  simp only [Tree.cols] at hcolF hidxlt
  by_cases ho : rd.owner = true
  · -- owner case
    rcases ker_stop_path hsd hrd hkd with ⟨ho', -⟩ | ⟨-, e, rest, hp, hle, hlen⟩
    · rw [ho] at ho'; cases ho'
    rw [hp, List.take_left' rfl, if_pos rfl, List.drop_left' rfl] at hkc
    simp only at hkc
    rw [if_pos (by simp [hle])] at hkc
    have hhole := (Option.some.inj hkc).symm
    have hδs : holeDepth sd rd = rest.length + 1 := by rw [hδ, hp]; simp
    rw [hδs] at hR hGhole
    obtain ⟨lc, p, H, hlc, hlh, hHR⟩ := hR
    rw [ker_kerHoleAt_succ hlc hlh, hp, hlay, List.drop_left' rfl] at hGhole
    simp only [ColAddr.mk.injEq, List.cons.injEq, Prod.mk.injEq] at hGhole
    have hlast : rd.idx + 1 = cs.length := by
      obtain ⟨F', hF', h'⟩ := hown.1 ho
      rw [hF] at hF'; cases hF'; rw [hidx]; exact h'
    have hlcc : lc = col := by
      simp only [Tree.cols] at hlc
      rw [List.getLast?_eq_getElem?, ← hlast, Nat.add_sub_cancel, hcolF] at hlc
      exact (Option.some.inj hlc).symm
    subst hlcc
    have hU : unconsumed E rd ≠ [] := hkd ho
    have hUl : (unconsumed E rd).getLast? = some (p, H) := by
      unfold unconsumed rootCol
      rw [hcol, Option.getD_some, List.getLast?_drop, if_neg, hlh]
      intro hle'
      apply hU
      unfold unconsumed rootCol
      rw [hcol, Option.getD_some]
      exact List.drop_eq_nil_of_le hle'
    have hUlen : (unconsumed E rd).length = lc.length - rd.cursor := by
      unfold unconsumed rootCol; rw [hcol, Option.getD_some, List.length_drop]
    have hlcl : lc.length = (rootCol E rd).length := by unfold rootCol; rw [hcol]; rfl
    have hcol0 : (sd.Q ++ (unconsumed E rd).map fun x => (x.1, shift sd.r (period sd) x.2)).getLast?
        = some (p, shift sd.r (period sd) H) := by
      rw [List.getLast?_append, List.getLast?_map, hUl]; rfl
    have hkr : KerRoute (rest.length + 1) (kerOpen E sd rd) := by
      unfold kerOpen
      simp only [ho, if_true]
      exact ⟨_, p, shift sd.r (period sd) H, rfl, hcol0, ker_route_shift hHR⟩
    refine ⟨?_, by rw [hδs]; exact hkr, ?_⟩
    · unfold kernel kerOpen
      simp only [ho, if_true]
      rw [hδs, ker_replaceAt_zero_succ]
      simp only [mapLast]
      rw [ker_mapLast_append _ _ _ _ (by simp [hU]), List.map_id, mapLast_map]
      congr 3
      apply ker_mapLast_congr _ (fun x _ => rfl)
      intro x _
      simp only [Function.comp]
      rw [replaceAt_eq_shift sd.r (period sd), Nat.add_sub_cancel]
    · rw [hδs]
      unfold kerOpen
      simp only [ho, if_true]
      rw [ker_kerHoleAt_succ rfl hcol0, ker_kerHoleAt_shift, hhole]
      simp only [Tree.cols, List.length_singleton, Nat.sub_self, List.length_append,
        List.length_map, hUlen, ColAddr.mk.injEq]
      refine ⟨?_, hGhole.2⟩
      rw [hGhole.1.2]
      simp only [List.cons.injEq, Prod.mk.injEq, and_true, true_and]
      have := hGhole.1.1.2
      omega
  · -- body case
    have ho' : rd.owner = false := by simpa using ho
    have hlt : rd.idx + 1 < cs.length := by
      rcases Nat.lt_or_ge (rd.idx + 1) cs.length with h | h
      · exact h
      · exact absurd (hown.2 ⟨_, hF, by rw [← hidx]; simp only [Tree.cols]; omega⟩) ho
    have hcsne : (cs.drop (rd.idx + 1)).map (Tree.mapCol (shiftVal sd.r (period sd))) ≠ [] := by
      intro h; have := congrArg List.length h; simp at this; omega
    have hRb : KerRoute (holeDepth sd rd) (Tree.node ((cs.drop (rd.idx + 1)).map
        (Tree.mapCol (shiftVal sd.r (period sd))))) := by
      rw [← ker_shift_node]
      exact ker_route_shift (ker_route_drop _ cs _ hlt hR)
    refine ⟨?_, ?_, ?_⟩
    · unfold kernel kerOpen
      simp only [ho', Bool.false_eq_true, if_false]
      rw [hFF, replaceAt_eq_shift sd.r (period sd), ker_shift_node]
      simp only [Tree.cols]
      rw [ker_replaceAt_cons _ _ _ hcsne]
      rfl
    · unfold kerOpen
      simp only [ho', Bool.false_eq_true, if_false]
      rw [hFF, ker_shift_node]
      exact ker_route_cons hcsne _ hRb
    · unfold kerOpen
      simp only [ho', Bool.false_eq_true, if_false]
      rw [hFF, ker_shift_node]
      simp only [Tree.cols]
      rcases ker_stop_path hsd hrd hkd with ⟨-, ⟨hp, hlt'⟩ | ⟨ci, e, rest, hp, hlt'⟩⟩ |
          ⟨ho'', -⟩
      · rw [hp, List.take_length, if_pos rfl, List.drop_length] at hkc
        simp only at hkc
        rw [if_neg (by omega), if_pos ⟨hlt', ho'⟩] at hkc
        have hhole := (Option.some.inj hkc).symm
        have hδ0 : holeDepth sd rd = 0 := by rw [hδ, hp]; simp
        rw [hδ0, hhole]
        rw [hδ0] at hGhole
        simp only [kerHoleAt, Tree.cols, ColAddr.mk.injEq, List.length_cons, List.length_map,
          List.length_drop] at hGhole ⊢
        refine ⟨trivial, ?_⟩
        omega
      · rw [hp, List.take_left' rfl, if_pos rfl, List.drop_left' rfl] at hkc
        simp only at hkc
        rw [if_neg (by omega), if_pos ⟨hlt', ho'⟩] at hkc
        have hhole := (Option.some.inj hkc).symm
        have hδs : holeDepth sd rd = rest.length + 1 := by rw [hδ, hp]; simp
        rw [hδs] at hR hGhole
        rw [hδs, hhole]
        obtain ⟨lc, p, H, hlc, hlh, hHR⟩ := hR
        rw [ker_kerHoleAt_succ hlc hlh] at hGhole
        rw [hp, hlay, List.drop_left' rfl] at hGhole
        simp only [ColAddr.mk.injEq, List.cons.injEq, Prod.mk.injEq] at hGhole
        simp only [Tree.cols] at hlc
        have hlc' : ((cs.drop (rd.idx + 1)).map (Tree.mapCol (shiftVal sd.r (period sd)))).getLast?
            = some (Tree.mapCol (shiftVal sd.r (period sd)) lc) := by
          rw [List.getLast?_map, List.getLast?_drop, if_neg (by omega), hlc]; rfl
        have hlc'' : (Tree.node ((sd.Q ++ (unconsumed E rd).map fun x =>
            (x.1, shift sd.r (period sd) x.2)) :: (cs.drop (rd.idx + 1)).map
              (Tree.mapCol (shiftVal sd.r (period sd))))).cols.getLast? =
            some (Tree.mapCol (shiftVal sd.r (period sd)) lc) := by
          obtain ⟨y, ys, hy⟩ := List.exists_cons_of_ne_nil hcsne
          simp only [Tree.cols]
          rw [hy, List.getLast?_cons_cons, ← hy, hlc']
        have hlh' : (Tree.mapCol (shiftVal sd.r (period sd)) lc).getLast? =
            some (shiftVal sd.r (period sd) p, Tree.map (shiftVal sd.r (period sd)) H) := by
          rw [treeMapCol_eq_map, List.getLast?_map, hlh]; rfl
        simp only [Tree.cols] at hGhole
        rw [ker_kerHoleAt_succ hlc'' hlh', ker_kerHoleAt_map]
        simp only [Tree.cols, ColAddr.mk.injEq, List.cons.injEq, Prod.mk.injEq, List.length_cons,
          List.length_map, List.length_drop, treeMapCol_eq_map]
        refine ⟨⟨⟨by omega, by omega⟩, hGhole.1.2⟩, hGhole.2⟩
      · exact absurd ho'' ho

/-- T3.2i helper: the kernel hole law (columns under the hole are those of `T_d X`). -/
theorem ker_kernel_hole_law {E : Forest} {sd : StopData} {rd : RootData}
    (hsd : stopData E = some sd) (hrd : rootData E = some rd) (hkd : KernelDefined E rd)
    (X : Forest) (y : ColAddr) :
    (kernel E sd rd X).colAt (underCol (kerHole sd rd) y) = (shift sd.r (period sd) X).colAt y ∧
      localSuffix (kernel E sd rd X) (underCol (kerHole sd rd) y) =
        localSuffix (shift sd.r (period sd) X) y := by
  obtain ⟨h1, h2, h3⟩ := ker_kernel_open hsd hrd hkd X
  rw [h1, ← h3]
  exact ker_hole_law _ h2 y

/-- T3.2i helper: `k` kernel layers above an address shift it by `τ_k`. -/
theorem ker_iterate_law {E : Forest} {sd : StopData} {rd : RootData}
    (hsd : stopData E = some sd) (hrd : rootData E = some rd) (hkd : KernelDefined E rd) :
    ∀ (k m : Nat) (w : ColAddr),
      ((kernel E sd rd)^[m + k] Tree.empty).colAt ((underCol (kerHole sd rd))^[k] w) =
        (((kernel E sd rd)^[m] Tree.empty).colAt w).map
          (Tree.mapCol (shiftVal sd.r (k * period sd))) ∧
      localSuffix ((kernel E sd rd)^[m + k] Tree.empty) ((underCol (kerHole sd rd))^[k] w) =
        shift sd.r (k * period sd) (localSuffix ((kernel E sd rd)^[m] Tree.empty) w)
  | 0, m, w => by
    simp only [Nat.add_zero, Function.iterate_zero_apply, Nat.zero_mul, shift_zero]
    rw [shiftVal_zero_fun, treeMapCol_id_fun, Option.map_id]
    exact ⟨by simp, by simp⟩
  | k + 1, m, w => by
    rw [show m + (k + 1) = (m + k) + 1 by omega, Function.iterate_succ_apply',
      Function.iterate_succ_apply']
    obtain ⟨h1, h2⟩ := ker_kernel_hole_law hsd hrd hkd ((kernel E sd rd)^[m + k] Tree.empty)
      ((underCol (kerHole sd rd))^[k] w)
    obtain ⟨h3, h4⟩ := ker_shift_law sd.r (period sd) ((kernel E sd rd)^[m + k] Tree.empty)
      ((underCol (kerHole sd rd))^[k] w)
    obtain ⟨ih1, ih2⟩ := ker_iterate_law hsd hrd hkd k m w
    refine ⟨?_, ?_⟩
    · rw [h1, h3, ih1, Option.map_map]
      congr 1
      funext c
      rw [Function.comp, treeMapCol_map, shiftVal_add, Nat.succ_mul, Nat.add_comm]
    · rw [h2, h4, ih2, shift_add, Nat.succ_mul, Nat.add_comm]

/-- T3.2i helper: the root column is not query material. -/
theorem ker_isQMat_root {A : Forest} {sd : StopData} {rd : RootData} (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) : isQMat sd rd.col = false := by
  obtain ⟨hpath, hle⟩ := ker_rootPath hsd hrd
  obtain ⟨-, hdep, -⟩ := stopData_spec hsd
  obtain ⟨-, -, hlay, -⟩ := rootData_path hsd hrd
  unfold isQMat
  have hl : rd.col.path.length ≤ sd.col.path.length := by rw [← hlay, ← hdep]; exact hle
  rw [List.take_of_length_le hl]
  by_cases h : rd.col.path = sd.col.path
  · rw [h, List.drop_length]; simp
  · simp [h]

theorem ker_kerCol_root {A : Forest} {sd : StopData} {rd : RootData} (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) : kerCol sd rd rd.col = some ⟨[], 0⟩ := by
  have hq := ker_isQMat_root hsd hrd
  have hidx := (rootData_spec hsd hrd).2.2.1
  unfold kerCol
  rw [if_neg (by simp [hq]), if_pos (List.take_length), List.drop_length]
  simp only
  rw [if_pos hidx.symm]

/-- T3.2i helper: the head column of a kernel output. -/
theorem ker_kernel_col0 (E : Forest) (sd : StopData) (rd : RootData) (X : Forest) :
    ∃ V, (kernel E sd rd X).colAt ⟨[], 0⟩ = some (sd.Q ++ V) ∧
      V.length = (unconsumed E rd).length ∧
      ∀ v x, (unconsumed E rd)[v]? = some x → ∃ y, V[v]? = some y ∧ y.1 = x.1 ∧
        (¬ (rd.owner = true ∧ v + 1 = (unconsumed E rd).length) →
          y.2 = shift sd.r (period sd) x.2) := by
  unfold kernel
  by_cases ho : rd.owner = true
  · simp only [ho, if_true]
    refine ⟨_, rfl, ker_length_mapLast _ _ _, ?_⟩
    intro v x hx
    rcases Nat.lt_or_ge (v + 1) (unconsumed E rd).length with hlt | hge
    · rw [ker_mapLast_getElem?_lt _ _ hlt, hx]
      exact ⟨_, rfl, rfl, fun _ => rfl⟩
    · have hv : v < (unconsumed E rd).length := by
        by_contra h; rw [List.getElem?_eq_none (by omega)] at hx; cases hx
      have hve : v = (unconsumed E rd).length - 1 := by omega
      rw [hve, ker_mapLast_getElem?_last, List.getLast?_eq_getElem?, ← hve, hx]
      exact ⟨_, rfl, rfl, fun h => (h ⟨by simp [ho], by omega⟩).elim⟩
  · simp only [ho, Bool.false_eq_true, if_false]
    refine ⟨_, rfl, List.length_map _, ?_⟩
    intro v x hx
    rw [List.getElem?_map, hx]
    exact ⟨_, rfl, rfl, fun _ => rfl⟩

/-! ### T3.2i helpers: template material of one kernel layer -/

/-- helper: a forest relation at addresses gives the column and local-suffix relations. -/
theorem ker_cl_of_forestAt {T T' : Forest} {p p' : List (Nat × Nat)} (r d c : Nat)
    (h : T.forestAt p = (T'.forestAt p').map (shift r d)) :
    T.colAt ⟨p, c⟩ = (T'.colAt ⟨p', c⟩).map (Tree.mapCol (shiftVal r d)) ∧
      localSuffix T ⟨p, c⟩ = shift r d (localSuffix T' ⟨p', c⟩) := by
  unfold Tree.colAt localSuffix
  simp only
  rw [h]
  cases T'.forestAt p' with
  | none => simp [Tree.empty, Tree.cols, shift, Tree.map, Tree.mapCols]
  | some F =>
    simp only [Option.map_some, Option.bind_some, Option.getD_some]
    unfold shift
    rw [ker_map_cols, List.getElem?_map]
    refine ⟨rfl, ?_⟩
    simp only [Tree.map]
    rw [treeMapCols_eq_map, List.map_drop]

theorem ker_cl_of_forestAt_eq {T T' : Forest} {p p' : List (Nat × Nat)} (c : Nat)
    (h : T.forestAt p = T'.forestAt p') :
    T.colAt ⟨p, c⟩ = T'.colAt ⟨p', c⟩ ∧ localSuffix T ⟨p, c⟩ = localSuffix T' ⟨p', c⟩ := by
  unfold Tree.colAt localSuffix
  simp only
  rw [h]
  exact ⟨rfl, rfl⟩

/-- helper: query material of the kernel is the query material of `A`. -/
theorem ker_kernel_qmat {A : Forest} {sd : StopData} {rd : RootData} (hsd : stopData A = some sd)
    (X : Forest) {a a' : ColAddr} (hq : isQMat sd a = true) (ha' : kerCol sd rd a = some a') :
    (kernel A sd rd X).colAt a' = A.colAt a ∧ localSuffix (kernel A sd rd X) a' = localSuffix A a := by
  have hq' := hq
  unfold isQMat at hq'
  rw [Bool.and_eq_true, beq_iff_eq] at hq'
  obtain ⟨h1, h2⟩ := hq'
  unfold kerCol at ha'
  rw [if_pos hq] at ha'
  cases hd : a.path.drop sd.col.path.length with
  | nil => rw [hd] at h2; cases h2
  | cons x rest =>
    obtain ⟨ci, j⟩ := x
    rw [hd] at h2 ha'
    simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at h2
    simp only [Option.some.injEq] at ha'
    subst ha'
    obtain ⟨a1, a2⟩ := a
    simp only at h1 hd h2 ⊢
    have hp : a1 = sd.col.path ++ (sd.col.col, j) :: rest := by
      rw [← List.take_append_drop sd.col.path.length a1, h1, hd, h2.1]
    subst hp
    apply ker_cl_of_forestAt_eq
    obtain ⟨V, hV0, -⟩ := ker_kernel_col0 A sd rd X
    obtain ⟨G, hG, -, hGc⟩ := ker_stopForest hsd
    unfold Tree.colAt at hV0
    simp only [Tree.forestAt, Option.bind_some] at hV0
    rw [ker_forestAt_cons, hV0, Option.bind_some, Tree.forestAt_append, hG, Option.bind_some,
      ker_forestAt_cons, hGc, Option.bind_some, List.getElem?_append_left h2.2,
      List.getElem?_append_left h2.2]

/-- helper: the kernel output in explicit form (filling identity, root data unfolded). -/
theorem ker_kernel_explicit {A : Forest} {sd : StopData} {rd : RootData} (hV : CondV A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) (X : Forest) :
    (context A sd X).forestAt rd.col.path =
        some (replaceAt 0 0 X (holeDepth sd rd) (rootForest A rd)) ∧
      kernel A sd rd X = Tree.node ((sd.Q ++ Tree.mapCol (shiftVal sd.r (period sd))
        ((((replaceAt 0 0 X (holeDepth sd rd) (rootForest A rd)).cols[rd.idx]?).getD []).drop
          rd.cursor)) ::
        ((replaceAt 0 0 X (holeDepth sd rd) (rootForest A rd)).cols.drop (rd.idx + 1)).map
          (Tree.mapCol (shiftVal sd.r (period sd)))) := by
  obtain ⟨hF, -⟩ := ker_route_rootForest hsd hrd
  obtain ⟨hpath, hle⟩ := ker_rootPath hsd hrd
  have hidx := (rootData_spec hsd hrd).2.2.1
  have hC : (context A sd X).forestAt rd.col.path =
      some (replaceAt 0 0 X (holeDepth sd rd) (rootForest A rd)) := by
    rw [hpath] at hF ⊢
    rw [ker_context_forestAt hsd X rd.layer hle _ hF]
    rfl
  refine ⟨hC, ?_⟩
  rw [filling_identity hV hsd hrd X]
  unfold rootTail
  have hDcol : (context A sd X).colAt rd.col =
      (replaceAt 0 0 X (holeDepth sd rd) (rootForest A rd)).cols[rd.idx]? := by
    unfold Tree.colAt; rw [hC, Option.bind_some, hidx]
  rw [hDcol, hC, Option.getD_some, ker_shift_node, List.map_cons]
  rfl

/-- helper: root-tail material of the kernel is that of the context, shifted by `T_d`. -/
theorem ker_kernel_roottail {A : Forest} {sd : StopData} {rd : RootData} (hV : CondV A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) (X : Forest) {a a' : ColAddr}
    (hq : isQMat sd a = false) (hne : a ≠ rd.col) (ha' : kerCol sd rd a = some a') :
    (kernel A sd rd X).colAt a' =
        ((context A sd X).colAt a).map (Tree.mapCol (shiftVal sd.r (period sd))) ∧
      localSuffix (kernel A sd rd X) a' =
        shift sd.r (period sd) (localSuffix (context A sd X) a) := by
  obtain ⟨hC, hK⟩ := ker_kernel_explicit hV hsd hrd X
  have hidx := (rootData_spec hsd hrd).2.2.1
  generalize replaceAt 0 0 X (holeDepth sd rd) (rootForest A rd) = FD at hC hK
  obtain ⟨fcs⟩ := FD
  simp only [Tree.cols] at hK
  rw [hK]
  unfold kerCol at ha'
  rw [if_neg (by simp [hq])] at ha'
  by_cases hρ : a.path.take rd.col.path.length = rd.col.path
  swap
  · rw [if_neg hρ] at ha'; cases ha'
  rw [if_pos hρ] at ha'
  obtain ⟨a1, a2⟩ := a
  simp only at hρ ha' ⊢
  have hsplit : a1 = rd.col.path ++ a1.drop rd.col.path.length := by
    conv_lhs => rw [← List.take_append_drop rd.col.path.length a1, hρ]
  cases hd : a1.drop rd.col.path.length with
  | nil =>
    rw [hd] at ha' hsplit
    rw [List.append_nil] at hsplit
    subst hsplit
    simp only at ha'
    split_ifs at ha' with hc1 hc2
    · exact absurd (by rw [hc1, hidx]) hne
    · simp only [Option.some.injEq] at ha'
      subst ha'
      obtain ⟨c', hc'⟩ : ∃ c', a2 - rd.idx = c' + 1 := ⟨a2 - rd.idx - 1, by omega⟩
      have ha2 : a2 = rd.idx + 1 + c' := by omega
      unfold Tree.colAt localSuffix
      simp only [Tree.forestAt, Option.bind_some, Option.getD_some, hC]
      rw [hc']
      show (List.map _ (fcs.drop (rd.idx + 1)))[c']? = Option.map _ fcs[a2]? ∧
        Tree.node ((List.map _ (fcs.drop (rd.idx + 1))).drop c') = shift _ _ (Tree.node (fcs.drop a2))
      rw [List.getElem?_map, List.getElem?_drop, ← ha2, List.map_drop, List.drop_drop, ← ha2]
      refine ⟨rfl, ?_⟩
      unfold shift; simp only [Tree.map]; rw [treeMapCols_eq_map, List.map_drop]
  | cons x rest =>
    obtain ⟨ci, e⟩ := x
    rw [hd] at ha' hsplit
    subst hsplit
    simp only at ha'
    split_ifs at ha' with hc1 hc2
    · simp only [Option.some.injEq] at ha'
      subst ha'
      apply ker_cl_of_forestAt
      rw [ker_forestAt_cons, Tree.forestAt_append, hC, Option.bind_some, ker_forestAt_cons]
      show (((sd.Q ++ _) :: _)[0]?.bind (·[sd.Q.length + (e - rd.cursor)]?)).bind _ = _
      simp only [List.getElem?_cons_zero, Option.bind_some]
      rw [List.getElem?_append_right (by omega), Nat.add_sub_cancel_left, treeMapCol_eq_map,
        List.getElem?_map, List.getElem?_drop, show rd.cursor + (e - rd.cursor) = e by omega,
        hc1.1]
      show _ = Option.map _ (((fcs[rd.idx]?).bind (·[e]?)).bind _)
      cases fcs[rd.idx]? with
      | none => simp
      | some R =>
        simp only [Option.getD_some, Option.bind_some]
        cases R[e]? with
        | none => rfl
        | some y =>
          simp only [Option.map_some, Option.bind_some]
          exact ker_forestAt_map _ rest y.2
    · simp only [Option.some.injEq] at ha'
      subst ha'
      apply ker_cl_of_forestAt
      obtain ⟨ci', hci'⟩ : ∃ ci', ci - rd.idx = ci' + 1 := ⟨ci - rd.idx - 1, by omega⟩
      have hci : ci = rd.idx + 1 + ci' := by omega
      rw [hci', ker_forestAt_cons, Tree.forestAt_append, hC, Option.bind_some, ker_forestAt_cons]
      show (((_ :: List.map _ (fcs.drop (rd.idx + 1)))[ci' + 1]?).bind (·[e]?)).bind _ =
        Option.map _ (((fcs[ci]?).bind (·[e]?)).bind _)
      rw [List.getElem?_cons_succ, List.getElem?_map, List.getElem?_drop, ← hci]
      cases fcs[ci]? with
      | none => rfl
      | some R =>
        simp only [Option.map_some, Option.bind_some]
        rw [treeMapCol_eq_map, List.getElem?_map]
        cases R[e]? with
        | none => rfl
        | some y =>
          simp only [Option.map_some, Option.bind_some]
          exact ker_forestAt_map _ rest y.2

/-- helper: off the hole route, non-query template columns are unchanged by the context. -/
theorem ker_context_offroute {A : Forest} {sd : StopData} (hsd : stopData A = some sd) (X : Forest)
    {a : ColAddr} (ha : a ∈ A.colAddrs) (hq : isQMat sd a = false) (hroute : ¬ OnHoleRoute sd a) :
    (context A sd X).forestAt a.path = A.forestAt a.path := by
  rcases ker_path_cases a.path sd.col.path with hpre | ⟨x, rest, hx⟩ | ⟨j, hj1, hj2, hj3, hj4⟩
  · exact absurd hpre hroute
  · obtain ⟨c', e'⟩ := x
    obtain ⟨G, hG, hGlen, hGc⟩ := ker_stopForest hsd
    obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff A a).1 ha)
    unfold Tree.colAt at hcol
    rw [hx, Tree.forestAt_append, hG, Option.bind_some, ker_forestAt_cons] at hcol
    cases hgc : G.cols[c']? with
    | none => rw [hgc] at hcol; cases hcol
    | some gc =>
      rw [hgc, Option.bind_some] at hcol
      have hc'lt : c' < sd.col.col + 1 := by
        rw [← hGlen]; by_contra h; rw [List.getElem?_eq_none (by omega)] at hgc; cases hgc
      rcases Nat.lt_or_ge c' sd.col.col with hlt | hge
      · rw [hx]; exact ker_context_forestAt_stop hsd X rest (Or.inl hlt)
      · exfalso
        have hc' : c' = sd.col.col := by omega
        subst hc'
        rw [hGc] at hgc
        cases hgc
        rcases Nat.lt_or_ge e' sd.Q.length with he | he
        · -- query material
          have : isQMat sd a = true := by
            unfold isQMat
            rw [hx, List.take_left' rfl, List.drop_left' rfl]
            simp [he]
          rw [hq] at this; cases this
        · cases he' : (sd.Q ++ [(sd.r, Tree.empty)])[e']? with
          | none => rw [he'] at hcol; cases hcol
          | some y =>
            rw [he', Option.bind_some] at hcol
            have hy : y = (sd.r, Tree.empty) := by
              rw [List.getElem?_append_right he] at he'
              rcases Nat.lt_or_ge (e' - sd.Q.length) 1 with h1 | h1
              · rw [show e' - sd.Q.length = 0 by omega] at he'
                simp at he'; exact he'.symm
              · rw [List.getElem?_eq_none (by simp; omega)] at he'; cases he'
            subst hy
            cases rest with
            | nil => simp [Tree.forestAt, Tree.empty, Tree.cols] at hcol
            | cons z zs =>
              obtain ⟨z1, z2⟩ := z
              simp [ker_forestAt_cons, Tree.empty, Tree.cols] at hcol
  · exact ker_context_forestAt_diverge hsd X hj2 hj1 hj3 hj4

/-! ### T3.2i helpers: the hole region of a placement -/

/-- T3.2i helper: `c` is the hole `h`, lies right of it in its forest, or lies under such a
column (the region replaced by a placement at `h`). -/
def KerUnder (h c : ColAddr) : Prop :=
  (c.path = h.path ∧ h.col ≤ c.col) ∨ ∃ c0 e0 rest, c.path = h.path ++ (c0, e0) :: rest ∧ h.col ≤ c0

theorem ker_under_underCol (h y : ColAddr) : KerUnder h (underCol h y) := by
  obtain ⟨yp, yc⟩ := y
  cases yp with
  | nil => left; simp [underCol]
  | cons x rest =>
    obtain ⟨c0, e0⟩ := x
    right; exact ⟨h.col + c0, e0, rest, rfl, by omega⟩

theorem ker_under_cons (x : Nat × Nat) (p : List (Nat × Nat)) (hc : Nat) (rest : List (Nat × Nat))
    (c : Nat) : KerUnder ⟨x :: p, hc⟩ ⟨x :: rest, c⟩ ↔ KerUnder ⟨p, hc⟩ ⟨rest, c⟩ := by
  unfold KerUnder
  simp only [List.cons_append, List.cons.injEq, true_and]

/-- T3.2i helper: columns in the hole region come from the filling. -/
theorem ker_under_exhaust (Z : Forest) {k : Nat} {G : Forest} (hG : KerRoute k G) {c : ColAddr}
    (hu : KerUnder (kerHoleAt k G) c) (hc : c ∈ (replaceAt 0 0 Z k G).colAddrs) :
    ∃ y, y ∈ Z.colAddrs ∧ c = underCol (kerHoleAt k G) y := by
  obtain ⟨L, hL1, hL2⟩ := ker_hole_forest Z k G hG
  obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff _ c).1 hc)
  obtain ⟨cp, cc⟩ := c
  have hnc : (Tree.node (L ++ Z.cols)).cols = L ++ Z.cols := rfl
  rcases hu with ⟨hp, hle⟩ | ⟨c0, e0, rest, hp, hle⟩
  · have hle' : (kerHoleAt k G).col ≤ cc := hle
    simp only at hp
    subst hp
    unfold Tree.colAt at hcol
    rw [hL1, Option.bind_some, hnc, List.getElem?_append_right (by omega), hL2] at hcol
    refine ⟨⟨[], cc - (kerHoleAt k G).col⟩, ?_, ?_⟩
    · rw [Tree.mem_colAddrs_iff]
      unfold Tree.colAt
      rw [show Tree.forestAt Z ([] : List (Nat × Nat)) = some Z from rfl, Option.bind_some]
      simp only at hcol ⊢
      rw [hcol]; rfl
    · simp only [underCol, ColAddr.mk.injEq, true_and]
      omega
  · simp only at hp
    subst hp
    unfold Tree.colAt at hcol
    rw [Tree.forestAt_append, hL1, Option.bind_some, ker_forestAt_cons, hnc,
      List.getElem?_append_right (by omega), hL2] at hcol
    refine ⟨⟨(c0 - (kerHoleAt k G).col, e0) :: rest, cc⟩, ?_, ?_⟩
    · rw [Tree.mem_colAddrs_iff]
      unfold Tree.colAt
      rw [ker_forestAt_cons]
      simp only at hcol ⊢
      rw [hcol]; rfl
    · have hle' : (kerHoleAt k G).col ≤ c0 := hle
      simp only [underCol, ColAddr.mk.injEq, List.append_cancel_left_eq, List.cons.injEq,
        Prod.mk.injEq, and_true, true_and]
      omega

/-- T3.2i helper: outside the hole region, which addresses are columns does not depend on the
filling. -/
theorem ker_off_isSome (Z : Forest) : ∀ (k : Nat) (G : Forest), KerRoute k G → ∀ c : ColAddr,
    ¬ KerUnder (kerHoleAt k G) c →
      ((replaceAt 0 0 Z k G).colAt c).isSome = (G.colAt c).isSome
  | 0, .node cols, h, ⟨cp, cc⟩, hu => by
    have hne : cols ≠ [] := h
    rw [ker_replaceAt_zero_zero Z cols hne]
    simp only [KerUnder, kerHoleAt, Tree.cols, List.nil_append, not_or, not_and, not_le,
      not_exists] at hu
    obtain ⟨hu1, hu2⟩ := hu
    cases cp with
    | nil =>
      have := hu1 rfl
      unfold Tree.colAt
      simp only [Tree.forestAt, Option.bind_some, Tree.cols]
      rw [List.getElem?_append_left (by simp; omega), List.getElem?_dropLast, if_pos (by omega)]
    | cons x rest =>
      obtain ⟨c0, e0⟩ := x
      have := hu2 c0 e0 rest rfl
      unfold Tree.colAt
      rw [ker_forestAt_cons, ker_forestAt_cons]
      simp only [Tree.cols]
      rw [List.getElem?_append_left (by simp; omega), List.getElem?_dropLast, if_pos (by omega)]
  | k + 1, G, ⟨col, p, H, hc, hl, hk⟩, ⟨cp, cc⟩, hu => by
    rw [ker_kerHoleAt_succ hc hl] at hu
    cases cp with
    | nil =>
      obtain ⟨cols⟩ := G
      rw [ker_replaceAt_zero_succ]
      unfold Tree.colAt
      simp only [Tree.forestAt, Option.bind_some, Tree.cols]
      cases h1 : (mapLast id (mapLast id fun x : Nat × Forest => (x.1, replaceAt 0 0 Z k x.2))
          cols)[cc]? with
      | none =>
        rw [List.getElem?_eq_none_iff, ker_length_mapLast] at h1
        rw [List.getElem?_eq_none h1]
      | some x =>
        have : cc < cols.length := by
          have := (List.getElem?_eq_some_iff.1 h1).1; rw [ker_length_mapLast] at this; exact this
        rw [List.getElem?_eq_getElem this]; rfl
    | cons x rest =>
      obtain ⟨c0, e0⟩ := x
      by_cases hx : (c0, e0) = (G.cols.length - 1, col.length - 1)
      · rw [hx] at hu ⊢
        rw [ker_under_cons] at hu
        have ih := ker_off_isSome Z k H hk ⟨rest, cc⟩ hu
        unfold Tree.colAt at ih ⊢
        simp only at ih ⊢
        rw [ker_forestAt_cons' (replaceAt 0 0 Z (k + 1) G) _ rest, ker_forestAt_cons' G _ rest,
          ker_replaceAt_forestAt_last Z k hc hl, ker_forestAt_lastStep hc hl, Option.bind_some,
          Option.bind_some]
        exact ih
      · unfold Tree.colAt
        rw [ker_forestAt_cons, ker_forestAt_cons, ker_replaceAt_step_other Z k hc c0 e0 hx]

/-- T3.2i helper: in `A`, the region of the stopping column holds only the stopping column and
its query heights. -/
theorem ker_under_stop {A : Forest} {sd : StopData} (hsd : stopData A = some sd) {a : ColAddr}
    (ha : a ∈ A.colAddrs) (hu : KerUnder sd.col a) : a = sd.col ∨ isQMat sd a = true := by
  obtain ⟨G, hG, hGlen, hGc⟩ := ker_stopForest hsd
  obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff A a).1 ha)
  obtain ⟨ap, ac⟩ := a
  unfold Tree.colAt at hcol
  rcases hu with ⟨hp, hle⟩ | ⟨c0, e0, rest, hp, hle⟩
  · simp only at hp hle hcol
    subst hp
    rw [hG, Option.bind_some] at hcol
    left
    have : ac < sd.col.col + 1 := by
      rw [← hGlen]; by_contra h; rw [List.getElem?_eq_none (by omega)] at hcol; cases hcol
    have hac : ac = sd.col.col := by omega
    subst hac; rfl
  · simp only at hp hle hcol
    subst hp
    rw [Tree.forestAt_append, hG, Option.bind_some, ker_forestAt_cons] at hcol
    cases hgc : G.cols[c0]? with
    | none => rw [hgc] at hcol; cases hcol
    | some gc =>
      rw [hgc, Option.bind_some] at hcol
      have hc0 : c0 < sd.col.col + 1 := by
        rw [← hGlen]; by_contra h; rw [List.getElem?_eq_none (by omega)] at hgc; cases hgc
      have hc0' : c0 = sd.col.col := by omega
      subst hc0'
      rw [hGc] at hgc
      cases hgc
      right
      rcases Nat.lt_or_ge e0 sd.Q.length with he | he
      · unfold isQMat
        simp only [List.take_left' rfl, List.drop_left' rfl]
        simp [he]
      · exfalso
        cases he' : (sd.Q ++ [(sd.r, Tree.empty)])[e0]? with
        | none => rw [he'] at hcol; cases hcol
        | some y =>
          rw [he', Option.bind_some] at hcol
          have hy : y = (sd.r, Tree.empty) := by
            rw [List.getElem?_append_right he] at he'
            rcases Nat.lt_or_ge (e0 - sd.Q.length) 1 with h1 | h1
            · rw [show e0 - sd.Q.length = 0 by omega] at he'
              simp at he'; exact he'.symm
            · rw [List.getElem?_eq_none (by simp; omega)] at he'; cases he'
          subst hy
          cases rest with
          | nil => simp [Tree.forestAt, Tree.empty, Tree.cols] at hcol
          | cons z zs =>
            obtain ⟨z1, z2⟩ := z
            simp [ker_forestAt_cons, Tree.empty, Tree.cols] at hcol

/-! ### T3.2i helpers: the shapes of `kerCol` -/

/-- T3.2i helper: the five shapes of the template map. -/
theorem ker_kerCol_shape {sd : StopData} {rd : RootData} {a a' : ColAddr}
    (h : kerCol sd rd a = some a') :
    (isQMat sd a = true ∧ ∃ j rest, a.path = sd.col.path ++ (sd.col.col, j) :: rest ∧
        j < sd.Q.length ∧ a' = ⟨(0, j) :: rest, a.col⟩) ∨
      (isQMat sd a = false ∧ a.path = rd.col.path ∧ a.col = rd.idx ∧ a' = ⟨[], 0⟩) ∨
      (isQMat sd a = false ∧ a.path = rd.col.path ∧ rd.idx < a.col ∧ rd.owner = false ∧
        a' = ⟨[], a.col - rd.idx⟩) ∨
      (isQMat sd a = false ∧ ∃ e rest, a.path = rd.col.path ++ (rd.idx, e) :: rest ∧
        rd.cursor ≤ e ∧ a' = ⟨(0, sd.Q.length + (e - rd.cursor)) :: rest, a.col⟩) ∨
      (isQMat sd a = false ∧ ∃ ci e rest, a.path = rd.col.path ++ (ci, e) :: rest ∧
        rd.idx < ci ∧ rd.owner = false ∧ a' = ⟨(ci - rd.idx, e) :: rest, a.col⟩) := by
  unfold kerCol at h
  by_cases hq : isQMat sd a = true
  · rw [if_pos hq] at h
    left
    refine ⟨hq, ?_⟩
    have hq' := hq
    unfold isQMat at hq'
    rw [Bool.and_eq_true, beq_iff_eq] at hq'
    obtain ⟨h1, h2⟩ := hq'
    cases hd : a.path.drop sd.col.path.length with
    | nil => rw [hd] at h2; cases h2
    | cons x rest =>
      obtain ⟨ci, j⟩ := x
      rw [hd] at h2 h
      simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at h2
      simp only [Option.some.injEq] at h
      refine ⟨j, rest, ?_, h2.2, h.symm⟩
      rw [← List.take_append_drop sd.col.path.length a.path, h1, hd, h2.1]
  · rw [if_neg hq] at h
    simp only [Bool.not_eq_true] at hq
    right
    by_cases hρ : a.path.take rd.col.path.length = rd.col.path
    swap
    · rw [if_neg hρ] at h; cases h
    rw [if_pos hρ] at h
    have hsplit : a.path = rd.col.path ++ a.path.drop rd.col.path.length := by
      conv_lhs => rw [← List.take_append_drop rd.col.path.length a.path, hρ]
    cases hd : a.path.drop rd.col.path.length with
    | nil =>
      rw [hd] at h hsplit
      rw [List.append_nil] at hsplit
      simp only at h
      split_ifs at h with hc1 hc2
      · simp only [Option.some.injEq] at h
        exact Or.inl ⟨hq, hsplit, hc1, h.symm⟩
      · simp only [Option.some.injEq] at h
        exact Or.inr (Or.inl ⟨hq, hsplit, hc2.1, hc2.2, h.symm⟩)
    | cons x rest =>
      obtain ⟨ci, e⟩ := x
      rw [hd] at h hsplit
      simp only at h
      split_ifs at h with hc1 hc2
      · simp only [Option.some.injEq] at h
        refine Or.inr (Or.inr (Or.inl ⟨hq, e, rest, ?_, hc1.2, h.symm⟩))
        rw [hsplit, hc1.1]
      · simp only [Option.some.injEq] at h
        exact Or.inr (Or.inr (Or.inr ⟨hq, ci, e, rest, hsplit, hc2.1, hc2.2, h.symm⟩))

/-- T3.2i helper: the inverse of the template map. -/
def kerDecode (sd : StopData) (rd : RootData) (y : ColAddr) : ColAddr :=
  match y.path with
  | [] => ⟨rd.col.path, rd.idx + y.col⟩
  | (0, j) :: rest =>
    if j < sd.Q.length then ⟨sd.col.path ++ (sd.col.col, j) :: rest, y.col⟩
    else ⟨rd.col.path ++ (rd.idx, rd.cursor + (j - sd.Q.length)) :: rest, y.col⟩
  | (k + 1, e) :: rest => ⟨rd.col.path ++ (rd.idx + (k + 1), e) :: rest, y.col⟩

theorem ker_kerCol_decode {sd : StopData} {rd : RootData} {a y : ColAddr}
    (h : kerCol sd rd a = some y) : a = kerDecode sd rd y := by
  obtain ⟨ap, ac⟩ := a
  rcases ker_kerCol_shape h with ⟨-, j, rest, hp, hj, rfl⟩ | ⟨-, hp, hc, rfl⟩ |
      ⟨-, hp, hc, -, rfl⟩ | ⟨-, e, rest, hp, he, rfl⟩ | ⟨-, ci, e, rest, hp, hci, -, rfl⟩
  · simp only at hp ⊢; subst hp; simp [kerDecode, hj]
  · simp only at hp hc ⊢; subst hp hc; simp [kerDecode]
  · simp only at hp hc ⊢; subst hp; simp only [kerDecode]; congr 1; omega
  · simp only at hp ⊢; subst hp
    simp only [kerDecode, show ¬ (sd.Q.length + (e - rd.cursor) < sd.Q.length) by omega, if_false,
      ColAddr.mk.injEq, List.append_cancel_left_eq, List.cons.injEq, Prod.mk.injEq, true_and,
      and_true]
    omega
  · simp only at hp ⊢; subst hp
    obtain ⟨k, hk⟩ : ∃ k, ci - rd.idx = k + 1 := ⟨ci - rd.idx - 1, by omega⟩
    simp only [hk, kerDecode, ColAddr.mk.injEq, List.append_cancel_left_eq, List.cons.injEq,
      Prod.mk.injEq, true_and, and_true]
    omega

/-- T3.2i helper: the template map is injective. -/
theorem ker_kerCol_inj {sd : StopData} {rd : RootData} {a b y : ColAddr}
    (ha : kerCol sd rd a = some y) (hb : kerCol sd rd b = some y) : a = b := by
  rw [ker_kerCol_decode ha, ker_kerCol_decode hb]

/-! ### T3.2i helpers: the hole region and the template map -/

theorem ker_under_nil_nil (hc c : Nat) : KerUnder ⟨[], hc⟩ ⟨[], c⟩ ↔ hc ≤ c := by
  unfold KerUnder; simp

theorem ker_under_nil_cons (hc c c0 e0 : Nat) (q : List (Nat × Nat)) :
    KerUnder ⟨[], hc⟩ ⟨(c0, e0) :: q, c⟩ ↔ hc ≤ c0 := by
  unfold KerUnder
  simp only [List.nil_append, List.cons.injEq, Prod.mk.injEq, reduceCtorEq, false_and, false_or]
  constructor
  · rintro ⟨c1, e1, r, ⟨⟨rfl, rfl⟩, rfl⟩, h⟩; exact h
  · intro h; exact ⟨c0, e0, q, ⟨⟨rfl, rfl⟩, rfl⟩, h⟩

theorem ker_under_cons_nil (x : Nat × Nat) (p : List (Nat × Nat)) (hc c : Nat) :
    ¬ KerUnder ⟨x :: p, hc⟩ ⟨[], c⟩ := by
  unfold KerUnder; simp

theorem ker_under_cons_cons (x x' : Nat × Nat) (p q : List (Nat × Nat)) (hc c : Nat) :
    KerUnder ⟨x :: p, hc⟩ ⟨x' :: q, c⟩ ↔ x' = x ∧ KerUnder ⟨p, hc⟩ ⟨q, c⟩ := by
  unfold KerUnder
  simp only [List.cons_append, List.cons.injEq]
  constructor
  · rintro (⟨⟨h1, h2⟩, h3⟩ | ⟨c0, e0, r, ⟨h1, h2⟩, h3⟩)
    · exact ⟨h1, Or.inl ⟨h2, h3⟩⟩
    · exact ⟨h1, Or.inr ⟨c0, e0, r, h2, h3⟩⟩
  · rintro ⟨h1, ⟨h2, h3⟩ | ⟨c0, e0, r, h2, h3⟩⟩
    · exact Or.inl ⟨⟨h1, h2⟩, h3⟩
    · exact Or.inr ⟨c0, e0, r, ⟨h1, h2⟩, h3⟩

theorem ker_under_append (P p q : List (Nat × Nat)) (hc c : Nat) :
    KerUnder ⟨P ++ p, hc⟩ ⟨P ++ q, c⟩ ↔ KerUnder ⟨p, hc⟩ ⟨q, c⟩ := by
  induction P with
  | nil => rfl
  | cons x P ih => rw [List.cons_append, List.cons_append, ker_under_cons_cons, ih]; simp

theorem ker_under_pre_l (P q : List (Nat × Nat)) (hc c : Nat) :
    KerUnder ⟨P, hc⟩ ⟨P ++ q, c⟩ ↔ KerUnder ⟨[], hc⟩ ⟨q, c⟩ := by
  have := ker_under_append P [] q hc c
  rw [List.append_nil] at this; exact this

theorem ker_under_pre_r (P p : List (Nat × Nat)) (hc c : Nat) :
    KerUnder ⟨P ++ p, hc⟩ ⟨P, c⟩ ↔ KerUnder ⟨p, hc⟩ ⟨[], c⟩ := by
  have := ker_under_append P p [] hc c
  rw [List.append_nil] at this; exact this

theorem ker_under_pre (P : List (Nat × Nat)) (hc c : Nat) :
    KerUnder ⟨P, hc⟩ ⟨P, c⟩ ↔ hc ≤ c := by
  have := ker_under_append P [] [] hc c
  rw [List.append_nil] at this; rw [this, ker_under_nil_nil]

/-- T3.2i helper: query material lies in the region of the stopping column. -/
theorem ker_qmat_under {sd : StopData} {a : ColAddr} (hq : isQMat sd a = true) :
    KerUnder sd.col a := by
  unfold isQMat at hq
  rw [Bool.and_eq_true, beq_iff_eq] at hq
  obtain ⟨h1, h2⟩ := hq
  cases hd : a.path.drop sd.col.path.length with
  | nil => rw [hd] at h2; cases h2
  | cons x rest =>
    obtain ⟨ci, j⟩ := x
    rw [hd] at h2
    simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at h2
    right
    refine ⟨ci, j, rest, ?_, by omega⟩
    rw [← List.take_append_drop sd.col.path.length a.path, h1, hd]

/-- T3.2i helper: the explicit hole of the kernel. -/
theorem ker_kerHole_cases {A : Forest} {sd : StopData} {rd : RootData}
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) (hkd : KernelDefined A rd) :
    (rd.owner = false ∧ sd.col.path = rd.col.path ∧ rd.idx < sd.col.col ∧
        kerHole sd rd = ⟨[], sd.col.col - rd.idx⟩) ∨
      (rd.owner = false ∧ ∃ ci e rest, sd.col.path = rd.col.path ++ (ci, e) :: rest ∧
        rd.idx < ci ∧ kerHole sd rd = ⟨(ci - rd.idx, e) :: rest, sd.col.col⟩) ∨
      (rd.owner = true ∧ ∃ e rest, sd.col.path = rd.col.path ++ (rd.idx, e) :: rest ∧
        rd.cursor ≤ e ∧ kerHole sd rd = ⟨(0, sd.Q.length + (e - rd.cursor)) :: rest, sd.col.col⟩) := by
  obtain ⟨hkc, hq⟩ := ker_kerCol_stop hsd hrd hkd
  unfold kerCol at hkc
  rw [if_neg (by simp [hq])] at hkc
  rcases ker_stop_path hsd hrd hkd with ⟨ho, ⟨hp, hlt⟩ | ⟨ci, e, rest, hp, hlt⟩⟩ |
      ⟨ho, e, rest, hp, hle, -⟩
  · rw [hp, List.take_length, if_pos rfl, List.drop_length] at hkc
    simp only at hkc
    rw [if_neg (by omega), if_pos ⟨hlt, ho⟩] at hkc
    exact Or.inl ⟨ho, hp, hlt, (Option.some.inj hkc).symm⟩
  · rw [hp, List.take_left' rfl, if_pos rfl, List.drop_left' rfl] at hkc
    simp only at hkc
    rw [if_neg (by omega), if_pos ⟨hlt, ho⟩] at hkc
    exact Or.inr (Or.inl ⟨ho, ci, e, rest, hp, hlt, (Option.some.inj hkc).symm⟩)
  · rw [hp, List.take_left' rfl, if_pos rfl, List.drop_left' rfl] at hkc
    simp only at hkc
    rw [if_pos (by simp [hle])] at hkc
    exact Or.inr (Or.inr ⟨ho, e, rest, hp, hle, (Option.some.inj hkc).symm⟩)

/-- T3.2i helper: for root-tail material the template map carries the region of the stopping
column onto the region of the kernel hole. -/
theorem ker_under_transport {A : Forest} {sd : StopData} {rd : RootData}
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) (hkd : KernelDefined A rd)
    {a y : ColAddr}
    (h : (a.path = rd.col.path ∧ rd.idx < a.col ∧ rd.owner = false ∧ y = ⟨[], a.col - rd.idx⟩) ∨
      (∃ e rest, a.path = rd.col.path ++ (rd.idx, e) :: rest ∧ rd.cursor ≤ e ∧
        y = ⟨(0, sd.Q.length + (e - rd.cursor)) :: rest, a.col⟩) ∨
      (∃ ci e rest, a.path = rd.col.path ++ (ci, e) :: rest ∧ rd.idx < ci ∧ rd.owner = false ∧
        y = ⟨(ci - rd.idx, e) :: rest, a.col⟩)) :
    KerUnder (kerHole sd rd) y ↔ KerUnder sd.col a := by
  obtain ⟨ap, ac⟩ := a
  show KerUnder (kerHole sd rd) y ↔ KerUnder ⟨sd.col.path, sd.col.col⟩ ⟨ap, ac⟩
  rcases ker_kerHole_cases hsd hrd hkd with ⟨ho, hp, hlt, hkh⟩ | ⟨ho, ci, e, rest, hp, hlt, hkh⟩ |
      ⟨ho, e, rest, hp, hle, hkh⟩
  · rw [hkh, hp]
    generalize sd.col.col = sc at hlt ⊢
    rcases h with ⟨h1, h2, -, rfl⟩ | ⟨e', rest', h1, h2, rfl⟩ | ⟨ci', e', rest', h1, h2, -, rfl⟩ <;>
      simp only at h1 h2 ⊢ <;> subst h1
    · rw [ker_under_nil_nil, ker_under_pre]
      omega
    · rw [ker_under_pre_l, ker_under_nil_cons, ker_under_nil_cons]
      omega
    · rw [ker_under_pre_l, ker_under_nil_cons, ker_under_nil_cons]
      omega
  · rw [hkh, hp]
    generalize sd.col.col = sc
    rcases h with ⟨h1, h2, -, rfl⟩ | ⟨e', rest', h1, h2, rfl⟩ | ⟨ci', e', rest', h1, h2, -, rfl⟩ <;>
      simp only at h1 h2 ⊢ <;> subst h1
    · rw [ker_under_pre_r]
      exact iff_of_false (ker_under_cons_nil _ _ _ _) (ker_under_cons_nil _ _ _ _)
    · rw [ker_under_append, ker_under_cons_cons, ker_under_cons_cons]
      simp only [Prod.mk.injEq]
      constructor <;> rintro ⟨⟨h3, -⟩, -⟩ <;> omega
    · rw [ker_under_append, ker_under_cons_cons, ker_under_cons_cons]
      simp only [Prod.mk.injEq]
      constructor
      · rintro ⟨⟨h3, h4⟩, h5⟩; exact ⟨⟨by omega, h4⟩, h5⟩
      · rintro ⟨⟨h3, h4⟩, h5⟩; exact ⟨⟨by omega, h4⟩, h5⟩
  · rw [hkh, hp]
    generalize sd.col.col = sc
    rcases h with ⟨h1, h2, h3, rfl⟩ | ⟨e', rest', h1, h2, rfl⟩ | ⟨ci', e', rest', h1, h2, h3, rfl⟩
    · rw [ho] at h3; cases h3
    · simp only at h1 h2 ⊢; subst h1
      rw [ker_under_append, ker_under_cons_cons, ker_under_cons_cons]
      simp only [Prod.mk.injEq, true_and]
      constructor
      · rintro ⟨h3, h4⟩; exact ⟨by omega, h4⟩
      · rintro ⟨h3, h4⟩; exact ⟨by omega, h4⟩
    · rw [ho] at h3; cases h3

/-- T3.2i helper: addresses on the root column's forest are not query material. -/
theorem ker_isQMat_rootpath {A : Forest} {sd : StopData} {rd : RootData}
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) {a : ColAddr}
    (ha : a.path = rd.col.path) : isQMat sd a = false := by
  obtain ⟨hpath, hle⟩ := ker_rootPath hsd hrd
  obtain ⟨-, hdep, -⟩ := stopData_spec hsd
  obtain ⟨-, -, hlay, -⟩ := rootData_path hsd hrd
  unfold isQMat
  rw [ha]
  have hl : rd.col.path.length ≤ sd.col.path.length := by rw [← hlay, ← hdep]; exact hle
  rw [List.take_of_length_le hl]
  by_cases h : rd.col.path = sd.col.path
  · rw [h, List.drop_length]; simp
  · simp [h]

theorem ker_root_ne_stop {A : Forest} {sd : StopData} {rd : RootData}
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) : rd.col ≠ sd.col := by
  intro h
  obtain ⟨-, -, -, hnum, hrt, -⟩ := rootData_spec hsd hrd
  have ht := (stopData_spec hsd).2.2.1
  rw [h] at hnum
  omega

/-- T3.2i helper: template images avoid the region of the kernel hole. -/
theorem ker_kerCol_not_under {A : Forest} {sd : StopData} {rd : RootData}
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) (hkd : KernelDefined A rd)
    {a a' : ColAddr} (ha : a = rd.col ∨ IsTmplCol A sd rd a) (h : kerCol sd rd a = some a') :
    ¬ KerUnder (kerHole sd rd) a' := by
  intro hu
  have hamem : a ∈ A.colAddrs := by
    rcases ha with rfl | h'
    · exact (rootData_spec hsd hrd).2.2.2.2.2.1
    · exact h'.1
  have hane : a ≠ sd.col := by
    rcases ha with rfl | h'
    · exact ker_root_ne_stop hsd hrd
    · exact h'.2.1
  have key : KerUnder sd.col a → False := by
    intro hs
    rcases ker_under_stop hsd hamem hs with h1 | h1
    · exact hane h1
    · rcases ker_kerCol_shape h with ⟨-, -⟩ | ⟨hq, -⟩ | ⟨hq, -⟩ | ⟨hq, -⟩ | ⟨hq, -⟩
      · -- query material is never in the hole region of the kernel: handled below
        exact absurd hu (by
          rcases ker_kerCol_shape h with ⟨-, j, rest, -, hj, rfl⟩ | ⟨hq', -⟩ | ⟨hq', -⟩ |
              ⟨hq', -⟩ | ⟨hq', -⟩
          · rcases ker_kerHole_cases hsd hrd hkd with ⟨-, -, hlt, hkh⟩ |
                ⟨-, ci, e, rest', -, hlt, hkh⟩ | ⟨-, e, rest', -, -, hkh⟩ <;> rw [hkh]
            · rw [ker_under_nil_cons]; omega
            · rw [ker_under_cons_cons]; simp only [Prod.mk.injEq, not_and]; intro h0; omega
            · rw [ker_under_cons_cons]; simp only [Prod.mk.injEq, not_and]; intro _ h0; omega
          all_goals (rw [hq'] at h1; cases h1))
      all_goals (rw [hq] at h1; cases h1)
  rcases ker_kerCol_shape h with ⟨-, j, rest, -, hj, rfl⟩ | ⟨-, -, -, rfl⟩ |
      ⟨-, hp, hc, ho, rfl⟩ | ⟨-, e, rest, hp, he, rfl⟩ | ⟨-, ci, e, rest, hp, hci, ho, rfl⟩
  · rcases ker_kerHole_cases hsd hrd hkd with ⟨-, -, hlt, hkh⟩ |
        ⟨-, ci, e, rest', -, hlt, hkh⟩ | ⟨-, e, rest', -, -, hkh⟩ <;> rw [hkh] at hu
    · rw [ker_under_nil_cons] at hu; omega
    · rw [ker_under_cons_cons] at hu; simp only [Prod.mk.injEq] at hu; omega
    · rw [ker_under_cons_cons] at hu; simp only [Prod.mk.injEq] at hu; omega
  · rcases ker_kerHole_cases hsd hrd hkd with ⟨-, -, hlt, hkh⟩ |
        ⟨-, ci, e, rest', -, hlt, hkh⟩ | ⟨-, e, rest', -, -, hkh⟩ <;> rw [hkh] at hu
    · rw [ker_under_nil_nil] at hu; omega
    · exact ker_under_cons_nil _ _ _ _ hu
    · exact ker_under_cons_nil _ _ _ _ hu
  · exact key ((ker_under_transport hsd hrd hkd (Or.inl ⟨hp, hc, ho, rfl⟩)).1 hu)
  · exact key ((ker_under_transport hsd hrd hkd (Or.inr (Or.inl ⟨e, rest, hp, he, rfl⟩))).1 hu)
  · exact key ((ker_under_transport hsd hrd hkd
      (Or.inr (Or.inr ⟨ci, e, rest, hp, hci, ho, rfl⟩))).1 hu)

/-- T3.2i helper: shifting an entry does not change which addresses below it are columns. -/
theorem ker_isSome_shift_entry (r d : Nat) (o : Option (Nat × Forest)) (rest : List (Nat × Nat))
    (c : Nat) :
    (((o.map fun x => (shiftVal r d x.1, Tree.map (shiftVal r d) x.2)).bind
        fun x => x.2.forestAt rest).bind fun f => f.cols[c]?).isSome =
      ((o.bind fun x => x.2.forestAt rest).bind fun f => f.cols[c]?).isSome := by
  cases o with
  | none => rfl
  | some x =>
    simp only [Option.map_some, Option.bind_some]
    rw [ker_forestAt_map]
    cases x.2.forestAt rest with
    | none => rfl
    | some F => simp [ker_map_cols, List.getElem?_map]

theorem ker_isSome_shift_entry' (r d : Nat) (o : Option (Nat × Forest)) (rest : List (Nat × Nat))
    (c : Nat) :
    (((o.map fun x => (x.1, shift r d x.2)).bind
        fun x => x.2.forestAt rest).bind fun f => f.cols[c]?).isSome =
      ((o.bind fun x => x.2.forestAt rest).bind fun f => f.cols[c]?).isSome := by
  cases o with
  | none => rfl
  | some x =>
    simp only [Option.map_some, Option.bind_some]
    unfold shift
    rw [ker_forestAt_map]
    cases x.2.forestAt rest with
    | none => rfl
    | some F => simp [ker_map_cols, List.getElem?_map]

/-- T3.2i helper: every column of the open kernel outside its hole region is a template image. -/
theorem ker_kerOpen_preimage {A : Forest} {sd : StopData} {rd : RootData}
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) (hkd : KernelDefined A rd)
    {y : ColAddr} (hy : y ∈ (kerOpen A sd rd).colAddrs) (hu : ¬ KerUnder (kerHole sd rd) y) :
    ∃ a, (a = rd.col ∨ IsTmplCol A sd rd a) ∧ kerCol sd rd a = some y := by
  obtain ⟨hF, -⟩ := ker_route_rootForest hsd hrd
  obtain ⟨-, -, hidx, -, -, hmem, -⟩ := rootData_spec hsd hrd
  obtain ⟨hkc, -⟩ := ker_kerCol_stop hsd hrd hkd
  obtain ⟨G, hG, hGlen, hGc⟩ := ker_stopForest hsd
  have hne_stop : ∀ a, kerCol sd rd a = some y → a ≠ sd.col := by
    intro a ha h
    subst h
    rw [hkc] at ha
    cases ha
    exact hu ((ker_under_pre (kerHole sd rd).path _ _).2 le_rfl)
  have htmpl : ∀ a, a ∈ A.colAddrs → a ≠ rd.col → kerCol sd rd a = some y →
      ∃ a, (a = rd.col ∨ IsTmplCol A sd rd a) ∧ kerCol sd rd a = some y := by
    intro a ha hr hk
    exact ⟨a, Or.inr ⟨ha, hne_stop a hk, hr, by rw [hk]; rfl⟩, hk⟩
  rcases hFF : rootForest A rd with ⟨cs⟩
  rw [hFF] at hF
  have hU : unconsumed A rd = ((cs[rd.idx]?).getD []).drop rd.cursor := by
    unfold unconsumed rootCol Tree.colAt; rw [hF, Option.bind_some, hidx]; rfl
  have hK0 : (kerOpen A sd rd).cols[0]? = some (sd.Q ++ (unconsumed A rd).map fun x =>
      (x.1, shift sd.r (period sd) x.2)) := by
    unfold kerOpen; split <;> rfl
  have hK1 : ∀ k, (kerOpen A sd rd).cols[k + 1]? =
      if rd.owner then none else (cs[rd.idx + 1 + k]?).map
        (Tree.mapCol (shiftVal sd.r (period sd))) := by
    intro k
    unfold kerOpen
    split
    · rename_i ho; simp [ho, Tree.cols]
    · rename_i ho
      simp only [ho, Bool.false_eq_true, if_false, hFF, ker_shift_node, Tree.cols,
        List.getElem?_cons_succ, List.getElem?_map, List.getElem?_drop]
  have hcolA : ∀ c, A.colAt ⟨rd.col.path, c⟩ = cs[c]? := by
    intro c; unfold Tree.colAt; rw [hF]; rfl
  have hfA : ∀ ci e rest, A.forestAt (rd.col.path ++ (ci, e) :: rest) =
      ((cs[ci]?).bind (·[e]?)).bind fun x => x.2.forestAt rest := by
    intro ci e rest; rw [Tree.forestAt_append, hF, Option.bind_some, ker_forestAt_cons]; rfl
  obtain ⟨yp, yc⟩ := y
  rw [Tree.mem_colAddrs_iff] at hy
  cases yp with
  | nil =>
    cases yc with
    | zero => exact ⟨rd.col, Or.inl rfl, ker_kerCol_root hsd hrd⟩
    | succ k =>
      have hy' : ((kerOpen A sd rd).cols[k + 1]?).isSome := hy
      rw [hK1] at hy'
      by_cases ho : rd.owner = true
      · rw [if_pos ho] at hy'; cases hy'
      rw [if_neg ho] at hy'
      have ho' : rd.owner = false := by simpa using ho
      refine htmpl ⟨rd.col.path, rd.idx + (k + 1)⟩ ?_ ?_ ?_
      · rw [Tree.mem_colAddrs_iff, hcolA]
        rw [show rd.idx + (k + 1) = rd.idx + 1 + k by omega]
        simpa using hy'
      · intro h; have := congrArg ColAddr.col h; simp only at this; omega
      · have hq0 : isQMat sd ⟨rd.col.path, rd.idx + (k + 1)⟩ = false :=
          ker_isQMat_rootpath hsd hrd rfl
        unfold kerCol
        rw [if_neg (by rw [hq0]; simp), if_pos (List.take_length), List.drop_length]
        simp only
        rw [if_neg (by omega), if_pos ⟨by omega, ho'⟩]
        congr 2; omega
  | cons x rest =>
    obtain ⟨c0, e0⟩ := x
    have hy' : ((((kerOpen A sd rd).cols[c0]?).bind (·[e0]?)).bind fun x =>
        x.2.forestAt rest).bind (fun f => f.cols[yc]?) |>.isSome := by
      unfold Tree.colAt at hy; rw [ker_forestAt_cons] at hy; exact hy
    cases c0 with
    | zero =>
      rw [hK0, Option.bind_some] at hy'
      rcases Nat.lt_or_ge e0 sd.Q.length with he | he
      · -- query material
        rw [List.getElem?_append_left he] at hy'
        refine htmpl ⟨sd.col.path ++ (sd.col.col, e0) :: rest, yc⟩ ?_ ?_ ?_
        · rw [Tree.mem_colAddrs_iff]
          unfold Tree.colAt
          simp only
          rw [Tree.forestAt_append, hG, Option.bind_some, ker_forestAt_cons, hGc, Option.bind_some,
            List.getElem?_append_left he]
          exact hy'
        · intro h
          have := congrArg (fun c : ColAddr => c.path.length) h
          have hle := (ker_rootPath hsd hrd).2
          have hdep := (stopData_spec hsd).2.1
          have hlay := (rootData_path hsd hrd).2.2.1
          simp at this; omega
        · unfold kerCol
          have hq : isQMat sd ⟨sd.col.path ++ (sd.col.col, e0) :: rest, yc⟩ = true := by
            unfold isQMat; simp only [List.take_left' rfl, List.drop_left' rfl]; simp [he]
          rw [if_pos hq]
          simp only [List.drop_left' rfl]
      · -- restored root entries
        rw [List.getElem?_append_right he, List.getElem?_map, hU, List.getElem?_drop] at hy'
        set e := rd.cursor + (e0 - sd.Q.length) with he_def
        have hyform : (⟨(0, e0) :: rest, yc⟩ : ColAddr) =
            ⟨(0, sd.Q.length + (e - rd.cursor)) :: rest, yc⟩ := by
          congr 3; omega
        have htr := ker_under_transport hsd hrd hkd (a := ⟨rd.col.path ++ (rd.idx, e) :: rest, yc⟩)
          (Or.inr (Or.inl ⟨e, rest, rfl, by omega, hyform⟩))
        have hnu : ¬ KerUnder sd.col ⟨rd.col.path ++ (rd.idx, e) :: rest, yc⟩ :=
          fun h => hu (htr.2 h)
        have hq : isQMat sd ⟨rd.col.path ++ (rd.idx, e) :: rest, yc⟩ = false := by
          cases h : isQMat sd ⟨rd.col.path ++ (rd.idx, e) :: rest, yc⟩
          · rfl
          · exact absurd (ker_qmat_under h) hnu
        refine htmpl ⟨rd.col.path ++ (rd.idx, e) :: rest, yc⟩ ?_ ?_ ?_
        · rw [Tree.mem_colAddrs_iff]
          unfold Tree.colAt
          simp only
          rw [hfA]
          cases hR : cs[rd.idx]? with
          | none => rw [hR] at hy'; simp at hy'
          | some R =>
            rw [hR, Option.getD_some] at hy'
            rw [Option.bind_some, ← ker_isSome_shift_entry' sd.r (period sd)]
            exact hy'
        · intro h
          have := congrArg (fun c : ColAddr => c.path.length) h
          simp at this
        · unfold kerCol
          rw [if_neg (by rw [hq]; simp), if_pos (List.take_left' rfl), List.drop_left' rfl]
          simp only
          rw [if_pos (by refine ⟨?_, ?_⟩ <;> first | trivial | rfl | omega), ← hyform]
    | succ k =>
      rw [hK1] at hy'
      by_cases ho : rd.owner = true
      · rw [if_pos ho] at hy'; cases hy'
      rw [if_neg ho] at hy'
      have ho' : rd.owner = false := by simpa using ho
      set ci := rd.idx + 1 + k with hci
      have hyform : (⟨(k + 1, e0) :: rest, yc⟩ : ColAddr) = ⟨(ci - rd.idx, e0) :: rest, yc⟩ := by
        congr 3; omega
      have htr := ker_under_transport hsd hrd hkd (a := ⟨rd.col.path ++ (ci, e0) :: rest, yc⟩)
        (Or.inr (Or.inr ⟨ci, e0, rest, rfl, by omega, ho', hyform⟩))
      have hnu : ¬ KerUnder sd.col ⟨rd.col.path ++ (ci, e0) :: rest, yc⟩ := fun h => hu (htr.2 h)
      have hq : isQMat sd ⟨rd.col.path ++ (ci, e0) :: rest, yc⟩ = false := by
        cases h : isQMat sd ⟨rd.col.path ++ (ci, e0) :: rest, yc⟩
        · rfl
        · exact absurd (ker_qmat_under h) hnu
      refine htmpl ⟨rd.col.path ++ (ci, e0) :: rest, yc⟩ ?_ ?_ ?_
      · rw [Tree.mem_colAddrs_iff]
        unfold Tree.colAt
        simp only
        rw [hfA]
        cases hR : cs[ci]? with
        | none => rw [hR] at hy'; simp at hy'
        | some R =>
          rw [hR, Option.map_some, Option.bind_some, treeMapCol_eq_map, List.getElem?_map] at hy'
          rw [Option.bind_some, ← ker_isSome_shift_entry sd.r (period sd)]
          exact hy'
      · intro h
        have := congrArg (fun c : ColAddr => c.path.length) h
        simp at this
      · unfold kerCol
        rw [if_neg (by rw [hq]; simp), if_pos (List.take_left' rfl), List.drop_left' rfl]
        simp only
        rw [if_neg (by omega), if_pos ⟨by omega, ho'⟩, ← hyform]

/-- T3.2i helper: placement under a fixed hole is injective. -/
theorem ker_underCol_inj (h : ColAddr) {y y' : ColAddr} (hy : underCol h y = underCol h y') :
    y = y' := by
  obtain ⟨yp, yc⟩ := y
  obtain ⟨yp', yc'⟩ := y'
  cases yp with
  | nil =>
    cases yp' with
    | nil =>
      simp only [underCol, ColAddr.mk.injEq] at hy ⊢
      exact ⟨trivial, by omega⟩
    | cons x rest =>
      obtain ⟨c0, e0⟩ := x
      simp only [underCol, ColAddr.mk.injEq] at hy
      have := congrArg List.length hy.1; simp at this
  | cons x rest =>
    obtain ⟨c0, e0⟩ := x
    cases yp' with
    | nil =>
      simp only [underCol, ColAddr.mk.injEq] at hy
      have := congrArg List.length hy.1; simp at this
    | cons x' rest' =>
      obtain ⟨c0', e0'⟩ := x'
      simp only [underCol, ColAddr.mk.injEq, List.append_cancel_left_eq, List.cons.injEq,
        Prod.mk.injEq] at hy ⊢
      obtain ⟨⟨⟨h1, h2⟩, h3⟩, h4⟩ := hy
      exact ⟨⟨⟨by omega, h2⟩, h3⟩, h4⟩

/-- T3.2i helper: iterated placements of addresses outside the hole region are injective. -/
theorem ker_iter_inj (h : ColAddr) {b b' : ColAddr} (hb : ¬ KerUnder h b)
    (hb' : ¬ KerUnder h b') :
    ∀ p q, (underCol h)^[p] b = (underCol h)^[q] b' → p = q ∧ b = b'
  | 0, 0, e => ⟨rfl, e⟩
  | 0, q + 1, e => by
    rw [Function.iterate_zero_apply, Function.iterate_succ_apply'] at e
    have := ker_under_underCol h ((underCol h)^[q] b')
    rw [← e] at this
    exact absurd this hb
  | p + 1, 0, e => by
    rw [Function.iterate_zero_apply, Function.iterate_succ_apply'] at e
    have := ker_under_underCol h ((underCol h)^[p] b)
    rw [e] at this
    exact absurd this hb'
  | p + 1, q + 1, e => by
    rw [Function.iterate_succ_apply', Function.iterate_succ_apply'] at e
    obtain ⟨h1, h2⟩ := ker_iter_inj h hb hb' p q (ker_underCol_inj h e)
    exact ⟨by omega, h2⟩

-- T3.2i (txt:318-330): every column of the output is a context column or exactly one phase copy
theorem classify_cols {A B : Forest} {sd : StopData} {rd : RootData} {n : Nat} (hL : InL A)
    (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd) (hrd : rootData A = some rd)
    (hB : expand A n = some B) {c : ColAddr} (hc : c ∈ B.colAddrs) :
    (c ∈ (context A sd Tree.empty).colAddrs ∧ c ≠ sd.col) ∨
      ∃ i a, 1 ≤ i ∧ i ≤ n ∧ (a = rd.col ∨ IsTmplCol A sd rd a) ∧ phaseCol sd rd i a = some c ∧
        ∀ i' a', 1 ≤ i' → i' ≤ n → (a' = rd.col ∨ IsTmplCol A sd rd a') →
          phaseCol sd rd i' a' = some c → i' = i ∧ a' = a := by
  have hkd := ker_kernelDefined hL hsd hrd
  obtain ⟨hV, hI, -⟩ := hL
  obtain ⟨hBeq, -⟩ := ker_expand_out hV hI hk hsd hrd hB
  subst hBeq
  -- the columns of the iterates
  have hZ : ∀ m (y : ColAddr), y ∈ ((kernel A sd rd)^[m] Tree.empty).colAddrs →
      ∃ i a a', 1 ≤ i ∧ i ≤ m ∧ (a = rd.col ∨ IsTmplCol A sd rd a) ∧
        kerCol sd rd a = some a' ∧ y = (underCol (kerHole sd rd))^[i - 1] a' := by
    intro m
    induction m with
    | zero =>
      intro y hy
      rw [Tree.mem_colAddrs_iff] at hy
      exfalso
      unfold Tree.colAt at hy
      cases hp : y.path with
      | nil => rw [hp] at hy; simp [Tree.forestAt, Tree.empty, Tree.cols] at hy
      | cons x rest =>
        obtain ⟨c0, e0⟩ := x
        rw [hp, ker_forestAt_cons] at hy
        simp [Tree.empty, Tree.cols] at hy
    | succ m ih =>
      intro y hy
      rw [Function.iterate_succ_apply'] at hy
      obtain ⟨hko, hR, hH⟩ := ker_kernel_open hsd hrd hkd ((kernel A sd rd)^[m] Tree.empty)
      rw [hko] at hy
      by_cases hu : KerUnder (kerHole sd rd) y
      · have hu' := hu
        rw [← hH] at hu'
        obtain ⟨y', hy', rfl⟩ := ker_under_exhaust _ hR hu' hy
        have hy'' : y' ∈ ((kernel A sd rd)^[m] Tree.empty).colAddrs := by
          rw [Tree.mem_colAddrs_iff] at hy' ⊢
          rw [(ker_shift_law _ _ _ _).1] at hy'
          simpa using hy'
        obtain ⟨i, a, a', hi1, hi2, ha, hka, rfl⟩ := ih y' hy''
        refine ⟨i + 1, a, a', by omega, by omega, ha, hka, ?_⟩
        rw [hH, Nat.add_sub_cancel, show i = (i - 1) + 1 by omega, Function.iterate_succ_apply']
        simp only [Nat.add_sub_cancel]
      · have hu' := hu
        rw [← hH] at hu'
        have hk0 : y ∈ (kerOpen A sd rd).colAddrs := by
          rw [Tree.mem_colAddrs_iff] at hy ⊢
          rw [← ker_off_isSome _ _ _ hR y hu']
          exact hy
        obtain ⟨a, ha, hka⟩ := ker_kerOpen_preimage hsd hrd hkd hk0 hu
        exact ⟨1, a, y, le_rfl, by omega, ha, hka, rfl⟩
  obtain ⟨hRA, hHA⟩ := ker_stop_hole hsd
  have hc' : c ∈ (replaceAt 0 0 ((kernel A sd rd)^[n] Tree.empty) sd.depth A).colAddrs := hc
  by_cases hu : KerUnder sd.col c
  · right
    rw [← hHA] at hu
    obtain ⟨y, hy, rfl⟩ := ker_under_exhaust _ hRA hu hc'
    obtain ⟨i, a, a', hi1, hi2, ha, hka, rfl⟩ := hZ n y hy
    refine ⟨i, a, hi1, hi2, ha, ?_, ?_⟩
    · unfold phaseCol; rw [hka, hHA]; rfl
    · intro i' a'' hi1' hi2' ha'' hc''
      unfold phaseCol at hc''
      cases hk'' : kerCol sd rd a'' with
      | none => rw [hk''] at hc''; cases hc''
      | some b' =>
        rw [hk'', Option.map_some, Option.some.injEq, hHA] at hc''
        have e := ker_underCol_inj sd.col hc''
        obtain ⟨h1, h2⟩ := ker_iter_inj (kerHole sd rd)
          (ker_kerCol_not_under hsd hrd hkd ha'' hk'') (ker_kerCol_not_under hsd hrd hkd ha hka)
          _ _ e
        subst h2
        exact ⟨by omega, ker_kerCol_inj hk'' hka⟩
  · left
    refine ⟨?_, ?_⟩
    · rw [Tree.mem_colAddrs_iff] at hc' ⊢
      have hu' : ¬ KerUnder (kerHoleAt sd.depth A) c := by rw [hHA]; exact hu
      have h1 := ker_off_isSome ((kernel A sd rd)^[n] Tree.empty) _ _ hRA c hu'
      have h2 := ker_off_isSome Tree.empty _ _ hRA c hu'
      show ((replaceAt 0 0 Tree.empty sd.depth A).colAt c).isSome = true
      rw [h2, ← h1]
      exact hc'
    · intro h
      subst h
      exact hu ((ker_under_pre _ _ _).2 le_rfl)

-- T3.2i: printed numbers of phase copies
theorem num_phaseCol {A : Forest} {sd : StopData} {rd : RootData} {i : Nat} {a c : ColAddr}
    (hL : InL A) (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) (ha : a = rd.col ∨ IsTmplCol A sd rd a) (hi : 1 ≤ i)
    (hc : phaseCol sd rd i a = some c) : c.num 0 = a.num 0 + phaseOff sd i a * period sd := by
  have hkd := ker_kernelDefined hL hsd hrd
  have hrt := (rootData_spec hsd hrd).2.2.2.2.1
  have ht := (stopData_spec hsd).2.2.1
  unfold phaseCol at hc
  cases hk' : kerCol sd rd a with
  | none => rw [hk'] at hc; cases hc
  | some a' =>
    rw [hk', Option.map_some, Option.some.injEq] at hc
    subst hc
    have h1 := ker_num_kerCol hsd hrd hk'
    have h2 := ker_num_kerHole hsd hrd hkd
    rw [ker_num_underCol, ker_num_iterate, show (kerHole sd rd).num 0 = sd.t - sd.r by omega]
    unfold phaseOff period
    by_cases hq : isQMat sd a = true
    · rw [if_pos hq] at h1 ⊢
      omega
    · rw [if_neg hq] at h1 ⊢
      obtain ⟨i', rfl⟩ : ∃ i', i = i' + 1 := ⟨i - 1, by omega⟩
      rw [Nat.add_sub_cancel, Nat.succ_mul]
      omega

-- T3.2i: a closed template column is a pure copy (parents and heights shifted by its phase)
theorem colAt_phaseCol {A B : Forest} {sd : StopData} {rd : RootData} {n i : Nat} {a c : ColAddr}
    (hL : InL A) (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) (hB : expand A n = some B) (hi : 1 ≤ i ∧ i ≤ n)
    (ha : IsTmplCol A sd rd a) (hroute : ¬ OnHoleRoute sd a) (hc : phaseCol sd rd i a = some c) :
    B.colAt c = (A.colAt a).map (Tree.mapCol (shiftVal sd.r (phaseOff sd i a * period sd))) := by
  have hkd := ker_kernelDefined hL hsd hrd
  obtain ⟨hV, hI, -⟩ := hL
  obtain ⟨hBeq, -⟩ := ker_expand_out hV hI hk hsd hrd hB
  subst hBeq
  unfold phaseCol at hc
  cases hk' : kerCol sd rd a with
  | none => rw [hk'] at hc; cases hc
  | some a' =>
    rw [hk', Option.map_some, Option.some.injEq] at hc
    subst hc
    rw [(ker_context_law hsd _ _).1]
    have hit := (ker_iterate_law hsd hrd hkd (i - 1) (n - (i - 1)) a').1
    rw [show n - (i - 1) + (i - 1) = n by omega] at hit
    rw [hit, show n - (i - 1) = (n - i) + 1 by omega, Function.iterate_succ_apply']
    unfold phaseOff
    by_cases hq : isQMat sd a = true
    · rw [if_pos hq, (ker_kernel_qmat hsd _ hq hk').1]
    · rw [if_neg hq]
      simp only [Bool.not_eq_true] at hq
      rw [(ker_kernel_roottail hV hsd hrd _ hq ha.2.2.1 hk').1]
      have hoff := ker_context_offroute hsd ((kernel A sd rd)^[n - i] Tree.empty) ha.1 hq hroute
      have hcol : (context A sd ((kernel A sd rd)^[n - i] Tree.empty)).colAt a = A.colAt a := by
        unfold Tree.colAt; rw [hoff]
      rw [hcol, Option.map_map]
      congr 1
      funext x
      rw [Function.comp, treeMapCol_map, shiftVal_add]
      congr 2
      obtain ⟨i', rfl⟩ : ∃ i', i = i' + 1 := ⟨i - 1, by omega⟩
      rw [Nat.add_sub_cancel, Nat.succ_mul, Nat.add_comm]

-- T3.2i: the head column of layer `i`: `τ_{i−1}(Q)` then the restored entries of `U` with
-- phase-`i` heights (the last one a continuation in the owner case)
theorem colAt_head {A B : Forest} {sd : StopData} {rd : RootData} {n i : Nat} {c : ColAddr}
    (hL : InL A) (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) (hB : expand A n = some B) (hi : 1 ≤ i ∧ i ≤ n)
    (hc : phaseCol sd rd i rd.col = some c) :
    ∃ col, B.colAt c = some col ∧ col.length = sd.Q.length + (unconsumed A rd).length ∧
      col.take sd.Q.length = Tree.mapCol (shiftVal sd.r ((i - 1) * period sd)) sd.Q ∧
      ∀ v x, (unconsumed A rd)[v]? = some x → ∃ y, col[sd.Q.length + v]? = some y ∧ y.1 = x.1 ∧
        (¬ (rd.owner = true ∧ v + 1 = (unconsumed A rd).length) →
          y.2 = shift sd.r (i * period sd) x.2) := by
  have hkd := ker_kernelDefined hL hsd hrd
  obtain ⟨hV, hI, -⟩ := hL
  have hU := ker_unconsumed_lt hV hsd hrd
  obtain ⟨hBeq, -⟩ := ker_expand_out hV hI hk hsd hrd hB
  subst hBeq
  unfold phaseCol at hc
  rw [ker_kerCol_root hsd hrd, Option.map_some, Option.some.injEq] at hc
  subst hc
  rw [(ker_context_law hsd _ _).1]
  have hit := (ker_iterate_law hsd hrd hkd (i - 1) (n - (i - 1)) ⟨[], 0⟩).1
  rw [show n - (i - 1) + (i - 1) = n by omega] at hit
  rw [hit, show n - (i - 1) = (n - i) + 1 by omega, Function.iterate_succ_apply']
  obtain ⟨V, hV0, hVlen, hVent⟩ := ker_kernel_col0 A sd rd ((kernel A sd rd)^[n - i] Tree.empty)
  rw [hV0, Option.map_some]
  refine ⟨_, rfl, ?_, ?_, ?_⟩
  · rw [treeMapCol_eq_map, List.length_map, List.length_append, hVlen]
  · rw [ker_mapCol_append, List.take_left' (by rw [treeMapCol_eq_map, List.length_map])]
  · intro v x hx
    have hxm : x ∈ unconsumed A rd := List.mem_of_getElem? hx
    obtain ⟨y, hy, hy1, hy2⟩ := hVent v x hx
    have hlenQ : (Tree.mapCol (shiftVal sd.r ((i - 1) * period sd)) sd.Q).length ≤
        sd.Q.length + v := by rw [treeMapCol_eq_map, List.length_map]; omega
    rw [ker_mapCol_append, List.getElem?_append_right hlenQ, treeMapCol_eq_map, treeMapCol_eq_map,
      List.length_map, Nat.add_sub_cancel_left, List.getElem?_map, hy]
    have := hU x hxm
    refine ⟨_, rfl, ?_, fun h => ?_⟩
    · show shiftVal sd.r ((i - 1) * period sd) y.1 = x.1
      rw [hy1]; unfold shiftVal; rw [if_neg (by omega)]
    · show shift sd.r ((i - 1) * period sd) y.2 = _
      rw [hy2 h, shift_add]
      congr 1
      obtain ⟨i', rfl⟩ : ∃ i', i = i' + 1 := ⟨i - 1, by omega⟩
      rw [Nat.add_sub_cancel, Nat.succ_mul]

-- T3.2i/T3.2l: local suffixes of phase copies; root-tail material reads the shorter output
-- `A_{n−i}` (txt:586-592)
theorem localSuffix_phase {A B A' : Forest} {sd : StopData} {rd : RootData} {n i : Nat}
    {a c : ColAddr} (hL : InL A) (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) (hB : expand A n = some B) (hi : 1 ≤ i ∧ i ≤ n)
    (ha : IsTmplCol A sd rd a) (hc : phaseCol sd rd i a = some c)
    (hA' : expand A (n - i) = some A') :
    localSuffix B c = (if isQMat sd a then shift sd.r ((i - 1) * period sd) (localSuffix A a)
      else shift sd.r (i * period sd) (localSuffix A' a)) := by
  have hkd := ker_kernelDefined hL hsd hrd
  obtain ⟨hV, hI, -⟩ := hL
  obtain ⟨hBeq, -⟩ := ker_expand_out hV hI hk hsd hrd hB
  obtain ⟨hA'eq, -⟩ := ker_expand_out hV hI hk hsd hrd hA'
  subst hBeq hA'eq
  unfold phaseCol at hc
  cases hk' : kerCol sd rd a with
  | none => rw [hk'] at hc; cases hc
  | some a' =>
    rw [hk', Option.map_some, Option.some.injEq] at hc
    subst hc
    rw [(ker_context_law hsd _ _).2]
    have hit := (ker_iterate_law hsd hrd hkd (i - 1) (n - (i - 1)) a').2
    rw [show n - (i - 1) + (i - 1) = n by omega] at hit
    rw [hit, show n - (i - 1) = (n - i) + 1 by omega, Function.iterate_succ_apply']
    by_cases hq : isQMat sd a = true
    · rw [if_pos hq, (ker_kernel_qmat hsd _ hq hk').2]
    · rw [if_neg hq]
      simp only [Bool.not_eq_true] at hq
      rw [(ker_kernel_roottail hV hsd hrd _ hq ha.2.2.1 hk').2, shift_add]
      congr 1
      obtain ⟨i', rfl⟩ : ∃ i', i = i' + 1 := ⟨i - 1, by omega⟩
      rw [Nat.add_sub_cancel, Nat.succ_mul]

-- T3.2i: the local suffix at the head of layer `i` is the shifted remaining iterate
-- `τ_{i−1}(F^{n−i+1}(∅))`
theorem localSuffix_head {A B : Forest} {sd : StopData} {rd : RootData} {n i : Nat} {c : ColAddr}
    (hL : InL A) (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) (hB : expand A n = some B) (hi : 1 ≤ i ∧ i ≤ n)
    (hc : phaseCol sd rd i rd.col = some c) :
    localSuffix B c = shift sd.r ((i - 1) * period sd) ((kernel A sd rd)^[n - i + 1] Tree.empty) := by
  have hkd := ker_kernelDefined hL hsd hrd
  obtain ⟨hV, hI, -⟩ := hL
  obtain ⟨hBeq, -⟩ := ker_expand_out hV hI hk hsd hrd hB
  subst hBeq
  unfold phaseCol at hc
  rw [ker_kerCol_root hsd hrd, Option.map_some, Option.some.injEq] at hc
  subst hc
  rw [(ker_context_law hsd _ _).2]
  have hit := (ker_iterate_law hsd hrd hkd (i - 1) (n - (i - 1)) ⟨[], 0⟩).2
  rw [show n - (i - 1) + (i - 1) = n by omega] at hit
  rw [hit, show n - (i - 1) = n - i + 1 by omega]
  congr 1
  unfold localSuffix
  simp only [Tree.forestAt, Option.getD_some, List.drop_zero, ker_node_cols]

-- T3.2l (txt:345-349): a changed continuation is smaller than its complete prototype, with its
-- first difference at the old terminal
theorem localSuffix_cont_le {A A' : Forest} {sd : StopData} {rd : RootData} {n : Nat} {a : ColAddr}
    (hL : InL A) (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) (hA' : expand A n = some A') (ha : IsTmplCol A sd rd a ∨ a = rd.col) :
    localSuffix A' a ≤ localSuffix A a ∧ (OnHoleRoute sd a ∨ a = rd.col ∧ rd.owner = true →
      localSuffix A' a < localSuffix A a) := by
  obtain ⟨hV, hI, -⟩ := hL
  obtain ⟨hA'eq, -⟩ := ker_expand_out hV hI hk hsd hrd hA'
  subst hA'eq
  have hU := ker_unconsumed_lt hV hsd hrd
  have hamem : a ∈ A.colAddrs := by
    rcases ha with h | rfl
    · exact h.1
    · exact (rootData_spec hsd hrd).2.2.2.2.2.1
  have hrdpre : rd.col.path <+: sd.col.path := (rootData_path hsd hrd).2.2.2.1
  rcases ker_path_cases a.path sd.col.path with hpre | ⟨x, rest, hx⟩ | ⟨j, hj1, hj2, hj3, hj4⟩
  · -- on the hole route: the hole is the last part of the local suffix
    obtain ⟨hR, hY⟩ := ker_localSuffix_prefix hsd hpre hamem
    have hlt : localSuffix (context A sd ((kernel A sd rd)^[n] Tree.empty)) a <
        localSuffix A a := by
      rw [hY]
      conv_rhs => rw [← ker_replaceAt_self _ _ _ hR]
      exact ker_replaceAt_lt (ker_routeTo_route _ _ _ hR) (ker_iterate_lt_stop hU n)
    exact ⟨le_of_lt hlt, fun _ => hlt⟩
  · -- below the stopping forest: unchanged, or deleted with the query (`n = 0`)
    have hnot : ¬ (OnHoleRoute sd a ∨ a = rd.col ∧ rd.owner = true) := by
      rintro (h | ⟨rfl, -⟩)
      · have := h.length_le; rw [hx] at this; simp at this
      · have := hrdpre.length_le; rw [hx] at this; simp at this
    refine ⟨?_, fun h => absurd h hnot⟩
    obtain ⟨c', e'⟩ := x
    obtain ⟨G, hG, hGlen, hGc⟩ := ker_stopForest hsd
    obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff A a).1 hamem)
    unfold Tree.colAt at hcol
    rw [hx, Tree.forestAt_append, hG, Option.bind_some, ker_forestAt_cons] at hcol
    cases hgc : G.cols[c']? with
    | none => rw [hgc] at hcol; cases hcol
    | some gc =>
      rw [hgc, Option.bind_some] at hcol
      have hc'lt : c' < sd.col.col + 1 := by
        rw [← hGlen]; by_contra h; rw [List.getElem?_eq_none (by omega)] at hgc; cases hgc
      have hequal : ∀ Y, (context A sd Y).forestAt a.path = A.forestAt a.path →
          localSuffix (context A sd Y) a ≤ localSuffix A a := by
        intro Y hY; unfold localSuffix; rw [hY]
      rcases Nat.lt_or_ge c' sd.col.col with hlt | hge
      · apply hequal
        rw [hx]
        exact ker_context_forestAt_stop hsd _ rest (Or.inl hlt)
      · have hc' : c' = sd.col.col := by omega
        subst hc'
        rw [hGc] at hgc
        cases hgc
        have he : e' < sd.Q.length := by
          rcases Nat.lt_or_ge e' sd.Q.length with h | h
          · exact h
          · exfalso
            cases he' : (sd.Q ++ [(sd.r, Tree.empty)])[e']? with
            | none => rw [he'] at hcol; cases hcol
            | some y =>
              rw [he', Option.bind_some] at hcol
              have hy : y = (sd.r, Tree.empty) := by
                rw [List.getElem?_append_right h] at he'
                rcases Nat.lt_or_ge (e' - sd.Q.length) 1 with h1 | h1
                · rw [show e' - sd.Q.length = 0 by omega] at he'
                  simp at he'; exact he'.symm
                · rw [List.getElem?_eq_none (by simp; omega)] at he'; cases he'
              subst hy
              cases rest with
              | nil => simp [Tree.forestAt, Tree.empty, Tree.cols] at hcol
              | cons z zs =>
                obtain ⟨z1, z2⟩ := z
                simp [ker_forestAt_cons, Tree.empty, Tree.cols] at hcol
        cases n with
        | zero =>
          have hnone : (context A sd ((kernel A sd rd)^[0] Tree.empty)).forestAt a.path = none := by
            rw [hx]; exact ker_context_empty_forestAt_stop hsd e' rest
          have hle : localSuffix (context A sd ((kernel A sd rd)^[0] Tree.empty)) a = Tree.empty := by
            unfold localSuffix; rw [hnone]; simp [Tree.empty, Tree.cols]
          rw [hle]
          by_cases h0 : localSuffix A a = Tree.empty
          · rw [h0]
          · exact le_of_lt (Forest.empty_lt h0)
        | succ n =>
          obtain ⟨V, cs, hker, -⟩ := ker_kernel_firstCol hU ((kernel A sd rd)^[n] Tree.empty)
          apply hequal
          rw [hx]
          refine ker_context_forestAt_stop hsd _ rest (Or.inr ⟨rfl, he, V, cs, ?_⟩)
          rw [Function.iterate_succ_apply', hker]
  · -- leaves the stopping route above the stopping forest: unchanged
    have hnot : ¬ (OnHoleRoute sd a ∨ a = rd.col ∧ rd.owner = true) := by
      rintro (h | ⟨rfl, -⟩)
      · exact hj4 (by rw [List.getElem?_eq_getElem hj1, List.getElem?_eq_getElem hj2,
          h.getElem hj1])
      · exact hj4 (by rw [List.getElem?_eq_getElem hj1, List.getElem?_eq_getElem hj2,
          hrdpre.getElem hj1])
    refine ⟨?_, fun h => absurd h hnot⟩
    unfold localSuffix
    rw [ker_context_forestAt_diverge hsd _ hj2 hj1 hj3 hj4]

/-! T3.2j helpers: first-parent paths. -/

/-- Under V and A every `g_W` path is a `g_∅` path (path nesting with `∅ ≤ W`). -/
theorem spx_path_nil {E : Forest} {ks : KeySys} (hV : CondV E) (hA : CondAK E ks) {c : ColAddr}
    {W : List (WithTop Key)} (hW : W.Pairwise fun x y => y ≤ x) {s t : Nat}
    (h : Path E ks c W s t) : Path E ks c [] s t :=
  path_replace hV (fun _ _ _ he => path_nesting hV hA c List.Pairwise.nil hW (nil_le_list W) he) h

/-- A `g_∅` edge from `x` reads the first parent of the column numbered `x`, and that first parent
is a `g_∅` ancestor of `x - 1` (A at entry `0`). -/
theorem spx_edge_nil {E : Forest} (hV : CondV E) (hA : CondA E) {c : ColAddr} {x y : Nat}
    (h : Edge E (actualKeys E) c [] x y) : Path E (actualKeys E) c [] (x - 1) y := by
  obtain ⟨o, ho, hr⟩ := h
  rw [resp_eq_parents, cursor_nil_right] at hr
  have hoE : o ∈ E.colAddrs := mem_colAddrs_of_parents hr
  have h0 := hA o hoE 0 y hr
  simp only [if_true, cutQuery_zero] at h0
  have hox : o.num 0 = x := ColAddr.resolve_num ho
  have hlt : y < o.num 0 := parent_lt_num hV hr
  rw [hox] at h0 hlt
  exact (path_congr_stack hV (fun q hq => ColAddr.resolve_of_resolve_lt ho hq) (by omega)).1 h0

-- T3.2j (txt:337-340): every body column on the stopping column's stack lies in the subtree of
-- `r`, is nonempty and has first parent at least `r`
theorem body_firstParent {A : Forest} {sd : StopData} (hL : InL A) (hk : stepKind A = some .ordinary)
    (hsd : stopData A = some sd) {x : Nat} (hx1 : sd.r < x) (hx2 : x < sd.t) {o : ColAddr}
    (ho : sd.col.resolve 0 x = some o) :
    ∃ q H rest, A.colAt o = some ((q, H) :: rest) ∧ sd.r ≤ q := by
  obtain ⟨hV, -, -, hA, -⟩ := hL
  obtain ⟨hcol, -, ht, -, -, -⟩ := stopData_spec hsd
  set c := sd.col
  have hcE : c ∈ A.colAddrs := (Tree.mem_colAddrs_iff A c).2 (by rw [hcol]; rfl)
  have hpar : parents A c = (sd.Q ++ [(sd.r, Tree.empty)]).map Prod.fst := by
    simp [parents, hcol]
  -- the A tests of the stopping column chain `t - 1` down to `r`
  have hchain : ∀ (i p : Nat), (parents A c)[i]? = some p → Path A (actualKeys A) c [] (sd.t - 1) p := by
    intro i
    induction i with
    | zero =>
      intro p hp
      have h0 := hA c hcE 0 p hp
      simp only [if_true, cutQuery_zero] at h0
      rw [ht]; exact h0
    | succ i ih =>
      intro p hp
      have hlt : i < (parents A c).length := by
        have := (List.getElem?_eq_some_iff.1 hp).1; omega
      obtain ⟨p', hp'⟩ : ∃ p', (parents A c)[i]? = some p' := ⟨_, List.getElem?_eq_getElem hlt⟩
      have h1 := hA c hcE (i + 1) p hp
      simp only [Nat.add_one_ne_zero, if_false, Nat.add_sub_cancel, hp', Option.getD_some] at h1
      exact (ih p' hp').trans (spx_path_nil hV hA (cutQuery_noninc _ _) h1)
  have hbase : Path A (actualKeys A) c [] (sd.t - 1) sd.r :=
    hchain sd.Q.length sd.r (by rw [hpar]; simp)
  -- downward induction: `r` is a `g_∅` ancestor of every `x` with `r ≤ x < t`
  have key : ∀ n x, x + n = sd.t - 1 → sd.r ≤ x → Path A (actualKeys A) c [] x sd.r := by
    intro n
    induction n with
    | zero => intro x hx _; rw [show x = sd.t - 1 by omega]; exact hbase
    | succ n ih =>
      intro x hx hrx
      rcases Relation.ReflTransGen.cases_head (ih (x + 1) (by omega) (by omega)) with h | ⟨y, hxy, hyr⟩
      · omega
      · have := spx_edge_nil hV hA hxy
        simp only [Nat.add_sub_cancel] at this
        exact this.trans hyr
  have hxr := key (sd.t - 1 - x) x (by omega) (le_of_lt hx1)
  rcases Relation.ReflTransGen.cases_head hxr with h | ⟨y, hxy, hyr⟩
  · omega
  · obtain ⟨o', ho', hr⟩ := hxy
    rw [ho, Option.some.injEq] at ho'
    subst ho'
    rw [resp_eq_parents, cursor_nil_right, parents_getElem?] at hr
    obtain ⟨⟨q, H⟩, he, rfl⟩ := Option.map_eq_some_iff.1 hr
    obtain ⟨col, hcol', hc0⟩ := Tree.colAt_of_entryAt he
    obtain ⟨⟨q', H'⟩, rest, rfl⟩ : ∃ x rest, col = x :: rest := by
      cases col with
      | nil => simp at hc0
      | cons x rest => exact ⟨x, rest, rfl⟩
    simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hc0
    obtain ⟨rfl, rfl⟩ := hc0
    exact ⟨q', H', rest, hcol', path_le hV hyr⟩


/-! T3.2c helpers: the structure of the budgeted walk `spF` behind `safePrefix`. -/

theorem spx_spF_snd_le (k : Nat) (T : Forest) : (spF k T).2 ≤ k := by
  rw [(spF_spec 0 k T).2]; omega

/-- A walk that leaves budget unused keeps the whole forest. -/
theorem spx_spF_full {k : Nat} {T : Forest} (h : (spF k T).2 ≠ 0) : (spF k T).1 = T := by
  rw [(spF_spec 0 k T).2] at h
  exact safePrefix_of_le (by unfold mu word; omega)

theorem spx_spLater_snd_le : ∀ (k : Nat) (col : Column), (spLater k col).2 ≤ k
  | k, [] => by simp [spLater]
  | k, (p, h) :: rest => by
    by_cases hk : k = 0
    · simp [spLater, hk]
    · simp only [spLater, hk, if_false]
      have := spx_spLater_snd_le (spF (k - 1) h).2 rest
      have := spx_spF_snd_le (k - 1) h
      omega

theorem spx_spCol_snd_le : ∀ (k : Nat) (col : Column), (spCol k col).2 ≤ k - 1
  | k, [] => by simp [spCol]
  | k, (p, h) :: rest => by
    simp only [spCol]
    have := spx_spLater_snd_le (spF (k - 1) h).2 rest
    have := spx_spF_snd_le (k - 1) h
    omega

theorem spx_spLater_get : ∀ (k : Nat) (col : Column) (i p : Nat) (h' : Forest),
    (spLater k col).1[i]? = some (p, h') →
      ∃ h k', col[i]? = some (p, h) ∧ h' = (spF k' h).1 ∧ k' < k
  | k, [], i, p, h', hi => by simp [spLater] at hi
  | k, (q, h) :: rest, i, p, h', hi => by
    by_cases hk : k = 0
    · simp [spLater, hk] at hi
    · simp only [spLater, hk, if_false] at hi
      cases i with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hi
        obtain ⟨rfl, rfl⟩ := hi
        exact ⟨h, k - 1, rfl, rfl, by omega⟩
      | succ i =>
        rw [List.getElem?_cons_succ] at hi
        obtain ⟨h₀, k', h1, h2, h3⟩ := spx_spLater_get _ rest i p h' hi
        have := spx_spF_snd_le (k - 1) h
        exact ⟨h₀, k', by simpa using h1, h2, by omega⟩

theorem spx_spCol_get {k : Nat} (hk : 1 ≤ k) {col : Column} {i p : Nat} {h' : Forest}
    (hi : (spCol k col).1[i]? = some (p, h')) :
    ∃ h k', col[i]? = some (p, h) ∧ h' = (spF k' h).1 ∧ k' < k := by
  cases col with
  | nil => simp [spCol] at hi
  | cons x rest =>
    obtain ⟨q, h⟩ := x
    simp only [spCol] at hi
    cases i with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hi
      obtain ⟨rfl, rfl⟩ := hi
      exact ⟨h, k - 1, rfl, rfl, by omega⟩
    | succ i =>
      rw [List.getElem?_cons_succ] at hi
      obtain ⟨h₀, k', h1, h2, h3⟩ := spx_spLater_get _ rest i p h' hi
      have := spx_spF_snd_le (k - 1) h
      exact ⟨h₀, k', by simpa using h1, h2, by omega⟩

theorem spx_spCols_get : ∀ (k : Nat) (cols : List Column) (j : Nat) (col' : Column),
    (spCols k cols).1[j]? = some col' →
      ∃ col k', cols[j]? = some col ∧ col' = (spCol k' col).1 ∧ 1 ≤ k' ∧ k' ≤ k
  | k, [], j, col', hj => by simp [spCols] at hj
  | k, c :: rest, j, col', hj => by
    by_cases hk : k = 0
    · simp [spCols, hk] at hj
    · simp only [spCols, hk, if_false] at hj
      cases j with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq] at hj
        exact ⟨c, k, rfl, hj.symm, by omega, le_rfl⟩
      | succ j =>
        rw [List.getElem?_cons_succ] at hj
        obtain ⟨col, k', h1, h2, h3, h4⟩ := spx_spCols_get _ rest j col' hj
        have := spx_spCol_snd_le k c
        exact ⟨col, k', by simpa using h1, h2, h3, by omega⟩

/-- In a kept column, every entry followed by a kept entry keeps its whole height. -/
theorem spx_spLater_full : ∀ (k : Nat) (col : Column) (i : Nat),
    ((spLater k col).1[i + 1]?).isSome → (spLater k col).1[i]? = col[i]?
  | k, [], i, hi => by simp [spLater] at hi
  | k, (q, h) :: rest, i, hi => by
    by_cases hk : k = 0
    · simp [spLater, hk] at hi
    · simp only [spLater, hk, if_false] at hi ⊢
      cases i with
      | zero =>
        simp only [List.getElem?_cons_zero, List.getElem?_cons_succ] at hi ⊢
        have hne : (spF (k - 1) h).2 ≠ 0 := by
          intro h0; rw [h0] at hi
          cases rest with
          | nil => simp [spLater] at hi
          | cons y ys => simp [spLater] at hi
        rw [spx_spF_full hne]
      | succ i =>
        simp only [List.getElem?_cons_succ] at hi ⊢
        exact spx_spLater_full _ rest i hi

theorem spx_spCol_full {k : Nat} {col : Column} {i : Nat}
    (hi : ((spCol k col).1[i + 1]?).isSome) : (spCol k col).1[i]? = col[i]? := by
  cases col with
  | nil => simp [spCol] at hi
  | cons x rest =>
    obtain ⟨q, h⟩ := x
    simp only [spCol] at hi ⊢
    cases i with
    | zero =>
      simp only [List.getElem?_cons_zero, List.getElem?_cons_succ] at hi ⊢
      have hne : (spF (k - 1) h).2 ≠ 0 := by
        intro h0; rw [h0] at hi
        cases rest with
        | nil => simp [spLater] at hi
        | cons y ys => simp [spLater] at hi
      rw [spx_spF_full hne]
    | succ i =>
      simp only [List.getElem?_cons_succ] at hi ⊢
      exact spx_spLater_full _ rest i hi

/-- Forests of a safe prefix are safe prefixes of the forests at the same path, with a smaller
budget below the outer level. -/
theorem spx_forestAt : ∀ (π : List (Nat × Nat)) (T : Forest) (k : Nat) (F' : Forest),
    (spF k T).1.forestAt π = some F' →
      ∃ F k', T.forestAt π = some F ∧ F' = (spF k' F).1 ∧ k' ≤ k ∧ (π ≠ [] → k' < k)
  | [], T, k, F', h => by
    simp only [Tree.forestAt, Option.some.injEq] at h
    exact ⟨T, k, rfl, h.symm, le_rfl, fun h => absurd rfl h⟩
  | (a, b) :: π, .node cols, k, F', h => by
    rw [spF, Tree.forestAt_cons] at h
    simp only [Tree.cols, Option.bind_eq_some_iff] at h
    obtain ⟨x, ⟨col', hcol', hx⟩, hF⟩ := h
    obtain ⟨col, k₁, hcol, rfl, hk₁, hk₁'⟩ := spx_spCols_get k cols a col' hcol'
    obtain ⟨p, h'⟩ := x
    obtain ⟨h, k₂, hh, rfl, hk₂⟩ := spx_spCol_get hk₁ hx
    obtain ⟨F, k₃, hF1, hF2, hk₃, -⟩ := spx_forestAt π h k₂ F' hF
    refine ⟨F, k₃, ?_, hF2, by omega, fun _ => by omega⟩
    rw [Tree.forestAt_cons]
    simp only [Tree.cols, hcol, Option.bind_some, hh]
    exact hF1

theorem spx_colAt {T : Forest} {k : Nat} {c : ColAddr} {col' : Column}
    (h : (spF k T).1.colAt c = some col') :
    ∃ col k', T.colAt c = some col ∧ col' = (spCol k' col).1 ∧ 1 ≤ k' ∧ k' ≤ k ∧
      (c.path ≠ [] → k' < k) := by
  rw [Tree.colAt, Option.bind_eq_some_iff] at h
  obtain ⟨F', hF', hc⟩ := h
  obtain ⟨F, k₁, hF, rfl, hk₁, hk₁'⟩ := spx_forestAt c.path T k F' hF'
  obtain ⟨cols⟩ := F
  rw [spF] at hc
  obtain ⟨col, k₂, hcol, rfl, hk₂, hk₂'⟩ := spx_spCols_get k₁ cols c.col col' hc
  refine ⟨col, k₂, ?_, rfl, hk₂, by omega, fun hp => by have := hk₁' hp; omega⟩
  rw [Tree.colAt, hF]; exact hcol

theorem spx_entryAt {T : Forest} {k : Nat} {e : EntryAddr} {p : Nat} {h' : Forest}
    (h : (spF k T).1.entryAt e = some (p, h')) :
    ∃ h k', T.entryAt e = some (p, h) ∧ h' = (spF k' h).1 ∧ k' < k := by
  rw [Tree.entryAt, Option.bind_eq_some_iff] at h
  obtain ⟨col', hc', hi⟩ := h
  obtain ⟨col, k₁, hcol, rfl, hk₁, hk₁', -⟩ := spx_colAt hc'
  obtain ⟨H, k₂, hH, rfl, hk₂⟩ := spx_spCol_get hk₁ hi
  exact ⟨H, k₂, by rw [Tree.entryAt, hcol]; exact hH, rfl, by omega⟩

theorem spx_spF_empty (k : Nat) : (spF k (Tree.empty : Forest)).1 = Tree.empty := by
  simp [Tree.empty, spF, spCols]

-- T3.2c (txt:311-312): safe prefixes keep V, I, H
theorem safePrefix_condV {E : Forest} (hV : CondV E) (k : Nat) : CondV (safePrefix E k) := by
  intro e _ p h' he
  obtain ⟨h, -, hE, -, -⟩ := spx_entryAt he
  exact hV e ((Tree.mem_entryAddrs_iff E e).2 (by rw [hE]; rfl)) p h hE

theorem safePrefix_condI {E : Forest} (hI : CondI E) (k : Nat) : CondI (safePrefix E k) := by
  intro e _ p h' he hne col' hcol'
  obtain ⟨h, k', hE, rfl, -⟩ := spx_entryAt he
  obtain ⟨hcols⟩ := h
  have hne' : Tree.node hcols ≠ Tree.empty := by
    intro h0; apply hne; rw [h0]; exact spx_spF_empty k'
  rw [spF] at hcol'
  obtain ⟨j, hj⟩ := List.mem_iff_getElem?.1 hcol'
  obtain ⟨col, k₂, hcol, rfl, hk₂, -⟩ := spx_spCols_get k' hcols j col' hj
  obtain ⟨q, H, rest, rfl, hq⟩ := hI e ((Tree.mem_entryAddrs_iff E e).2 (by rw [hE]; rfl)) p _ hE
    hne' col (List.mem_of_getElem? hcol)
  exact ⟨q, (spF (k₂ - 1) H).1, (spLater (spF (k₂ - 1) H).2 rest).1, by rw [spCol], hq⟩

theorem safePrefix_condH {E : Forest} (hH : CondH E) (k : Nat) : CondH (safePrefix E k) := by
  intro c hc i x y hx hy
  obtain ⟨col', hcol'⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff _ c).1 hc)
  change (spF k E).1.colAt c = some col' at hcol'
  change (((spF k E).1.colAt c).getD [])[i]? = some x at hx
  change (((spF k E).1.colAt c).getD [])[i + 1]? = some y at hy
  rw [hcol', Option.getD_some] at hx hy
  obtain ⟨col, k', hcol, rfl, hk', -⟩ := spx_colAt hcol'
  have hxi := spx_spCol_full (k := k') (col := col) (i := i) (by rw [hy]; rfl)
  rw [hx] at hxi
  obtain ⟨Y, k₂, hY, hYy, -⟩ := spx_spCol_get hk' hy
  have hle := hH c ((Tree.mem_colAddrs_iff E c).2 (by rw [hcol]; rfl)) i x (y.1, Y)
    (by rw [hcol]; exact hxi.symm) (by rw [hcol]; exact hY)
  rcases hle with hlt | ⟨heq, hle⟩
  · exact Or.inl hlt
  · refine Or.inr ⟨heq, le_trans ?_ hle⟩
    rw [hYy]; exact safePrefix_le Y k₂


/-! T3.2d helpers: key order as word order, truncated keys, entries below a height. -/

/-- A strict comparison survives truncating the smaller list strictly earlier. -/
theorem spx_take_lt_take {α : Type} [LinearOrder α] :
    ∀ (Y X : List α) (k₁ k₀ : Nat), Y < X → k₁ < k₀ → Y.take k₁ < X.take k₀
  | _, _, _, 0, _, hk => absurd hk (Nat.not_lt_zero _)
  | _, [], _, _ + 1, h, _ => absurd h (List.not_lt_nil _)
  | [], x :: xs, _, k₀ + 1, _, _ => by simp
  | _ :: _, x :: xs, 0, k₀ + 1, _, _ => by simp
  | y :: ys, x :: xs, k₁ + 1, k₀ + 1, h, hk => by
    rw [List.take_succ_cons, List.take_succ_cons, List.cons_lt_cons_iff]
    rcases List.cons_lt_cons_iff.1 h with h₁ | ⟨h₁, h₂⟩
    · exact Or.inl h₁
    · exact Or.inr ⟨h₁, spx_take_lt_take ys xs k₁ k₀ h₂ (by omega)⟩

/-- Key comparison is comparison of generic words over `Bool ×ₗ Nat`. -/
theorem spx_key_lt_iff (X Y : Key) :
    X < Y ↔ @gword (Lex (Bool × Nat)) X < @gword (Lex (Bool × Nat)) Y :=
  (gword_lt_iff (α := Lex (Bool × Nat)) X Y).symm

/-- The generic word of the key of a safe prefix is the truncated generic word. -/
theorem spx_gword_relKey_safePrefix (a k : Nat) (H : Forest) :
    @gword (Lex (Bool × Nat)) (relKey a (safePrefix H k)) =
      (@gword (Lex (Bool × Nat)) (relKey a H)).take k := by
  change (gword (relKey a (safePrefix H k)) : List (GAtom (Bool × Nat))) =
      (gword (relKey a H) : List (GAtom (Bool × Nat))).take k
  rw [relKey_eq_map, relKey_eq_map, gword_map, gword_map, gword_eq_map_word, gword_eq_map_word,
    word_safePrefix, List.map_take, List.map_take]

/-- T3.2b in key form: truncating the lower height strictly before the upper one keeps `<`. -/
theorem spx_relKey_safePrefix_lt {a b : Nat} {H J : Forest} (h : relKey b J < relKey a H)
    {k₁ k₀ : Nat} (hk : k₁ < k₀) : relKey b (safePrefix J k₁) < relKey a (safePrefix H k₀) := by
  rw [spx_key_lt_iff] at h ⊢
  rw [spx_gword_relKey_safePrefix, spx_gword_relKey_safePrefix]
  exact spx_take_lt_take (α := GAtom (Lex (Bool × Nat))) _ _ _ _ h hk

theorem spx_entryAt_append (t : Forest) (π ρ : List (Nat × Nat)) (j i : Nat) :
    t.entryAt ⟨⟨π ++ ρ, j⟩, i⟩ = (t.forestAt π).bind fun F => F.entryAt ⟨⟨ρ, j⟩, i⟩ := by
  simp only [Tree.entryAt, Tree.colAt, Tree.forestAt_append, Option.bind_assoc]

/-- An entry inside the height of `e0` is read in that height. -/
theorem spx_entryAt_inside (t : Forest) (e0 : EntryAddr) (ρ : List (Nat × Nat)) (j i : Nat) :
    t.entryAt ⟨⟨e0.heightPath ++ ρ, j⟩, i⟩ =
      (t.heightAt e0).bind fun F => F.entryAt ⟨⟨ρ, j⟩, i⟩ := by
  rw [spx_entryAt_append, Tree.forestAt_heightPath]

-- T3.2d (txt:308-311): safe prefixes keep S (containment offsets + word fact)
theorem safePrefix_condS {E : Forest} (hV : CondV E) (hS : CondS E) (k : Nat) :
    CondS (safePrefix E k) := by
  intro e0 he0 e he hret
  obtain ⟨⟨ρ, hρ⟩, q, J', hJ', hres⟩ := hret
  obtain ⟨⟨P, j⟩, i⟩ := e
  dsimp only at hρ
  subst hρ
  obtain ⟨x0, hx0⟩ := Option.isSome_iff_exists.1 ((Tree.mem_entryAddrs_iff _ e0).1 he0)
  obtain ⟨p0, H'⟩ := x0
  obtain ⟨H, k₀, hH, rfl, -⟩ := spx_entryAt (k := k) (T := E) hx0
  have hJ'' := hJ'
  rw [spx_entryAt_inside, Tree.heightAt, hx0] at hJ''
  simp only [Option.map_some, Option.bind_some] at hJ''
  obtain ⟨J, k₁, hJ, rfl, hk⟩ := spx_entryAt hJ''
  have hEe : E.entryAt ⟨⟨e0.heightPath ++ ρ, j⟩, i⟩ = some (q, J) := by
    rw [spx_entryAt_inside, Tree.heightAt, hH]; simpa using hJ
  have hret : IsOwnerReturn E e0 ⟨⟨e0.heightPath ++ ρ, j⟩, i⟩ := ⟨⟨ρ, rfl⟩, q, J, hEe, hres⟩
  have hSE := hS e0 ((Tree.mem_entryAddrs_iff E e0).2 (by rw [hH]; rfl)) _
    ((Tree.mem_entryAddrs_iff E _).2 (by rw [hEe]; rfl)) hret
  rw [Tree.heightAt, Tree.heightAt, hEe, hH] at hSE
  rw [Tree.heightAt, Tree.heightAt, hJ', hx0]
  exact spx_relKey_safePrefix_lt hSE hk


/-! T3.2e helpers: complete columns of a safe prefix, and capped cursors. -/

/-- A column walk that leaves budget unused keeps the whole column. -/
theorem spx_spCol_full_of {k : Nat} (hk : k ≠ 0) {col : Column} (h : (spCol k col).2 ≠ 0) :
    (spCol k col).1 = col := by
  have h2 : (spF k (Tree.node [col])).2 ≠ 0 := by simpa [spF, spCols, hk] using h
  have := spx_spF_full h2
  simp only [spF, spCols, hk, if_false, Tree.node.injEq] at this
  simpa using this

/-- In a safe prefix, a column followed by a kept column is complete. -/
theorem spx_spCols_full : ∀ (k : Nat) (cols : List Column) (j : Nat),
    ((spCols k cols).1[j + 1]?).isSome → (spCols k cols).1[j]? = cols[j]?
  | k, [], j, h => by simp [spCols] at h
  | k, c :: rest, j, h => by
    by_cases hk : k = 0
    · simp [spCols, hk] at h
    · simp only [spCols, hk, if_false] at h ⊢
      cases j with
      | zero =>
        simp only [List.getElem?_cons_zero, List.getElem?_cons_succ] at h ⊢
        have hne : (spCol k c).2 ≠ 0 := by
          intro h0; rw [h0] at h
          cases rest with
          | nil => simp [spCols] at h
          | cons y ys => simp [spCols] at h
        rw [spx_spCol_full_of hk hne]
      | succ j =>
        simp only [List.getElem?_cons_succ] at h ⊢
        exact spx_spCols_full _ rest j h

/-- In a kept column, all entries before a kept entry are complete. -/
theorem spx_spCol_prefix {k : Nat} {col : Column} {v : Nat} (hv : v < (spCol k col).1.length) :
    (spCol k col).1.take v = col.take v := by
  apply List.ext_getElem?
  intro j
  rw [List.getElem?_take, List.getElem?_take]
  split_ifs with hj
  · exact spx_spCol_full (by rw [List.getElem?_eq_getElem (by omega)]; rfl)
  · rfl

/-- Kept entries keep their parents. -/
theorem spx_spCol_fst {k : Nat} (hk : 1 ≤ k) {col : Column} {j : Nat}
    (hj : j < (spCol k col).1.length) :
    ((spCol k col).1[j]?).map Prod.fst = (col[j]?).map Prod.fst := by
  obtain ⟨⟨p, h'⟩, hx⟩ : ∃ x, (spCol k col).1[j]? = some x := ⟨_, List.getElem?_eq_getElem hj⟩
  obtain ⟨h, -, hh, -, -⟩ := spx_spCol_get hk hx
  rw [hx, hh]; rfl

/-- Every column of a safe prefix is complete or a route column of the prefix. -/
theorem spx_complete_or_route : ∀ (P : List (Nat × Nat)) (T : Forest) (k j : Nat),
    ((spF k T).1.colAt ⟨P, j⟩).isSome →
      (spF k T).1.colAt ⟨P, j⟩ = T.colAt ⟨P, j⟩ ∨ (⟨P, j⟩ : ColAddr) ∈ routeCols (spF k T).1
  | [], .node cols, k, j, h => by
    rw [spF] at h ⊢
    simp only [Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols] at h ⊢
    by_cases hj : j + 1 < (spCols k cols).1.length
    · exact Or.inl (spx_spCols_full k cols j (by rw [List.getElem?_eq_getElem hj]; rfl))
    · right
      rw [mem_routeCols_iff]
      refine ⟨fun d hd => absurd hd (Nat.not_lt_zero _), _, rfl, ?_⟩
      have := (Option.isSome_iff_exists.1 h)
      obtain ⟨x, hx⟩ := this
      have := (List.getElem?_eq_some_iff.1 hx).1
      simp only [Tree.cols]; omega
  | (a, b) :: P, .node cols, k, j, h => by
    rw [spF] at h ⊢
    rw [Tree.colAt_cons] at h
    simp only [Tree.cols] at h
    obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 h
    rw [Option.bind_eq_some_iff] at hx
    obtain ⟨⟨p, h'⟩, hab, hP⟩ := hx
    rw [Option.bind_eq_some_iff] at hab
    obtain ⟨colA', hA', hb'⟩ := hab
    obtain ⟨colA, k₁, hA, rfl, hk₁, -⟩ := spx_spCols_get k cols a colA' hA'
    obtain ⟨h₀, k₂, hb, rfl, -⟩ := spx_spCol_get hk₁ hb'
    have e1 : (Tree.node (spCols k cols).1).colAt ⟨(a, b) :: P, j⟩ =
        (spF k₂ h₀).1.colAt ⟨P, j⟩ := by
      rw [Tree.colAt_cons]; simp [Tree.cols, hA', hb']
    have e2 : (Tree.node cols).colAt ⟨(a, b) :: P, j⟩ = h₀.colAt ⟨P, j⟩ := by
      rw [Tree.colAt_cons]; simp [Tree.cols, hA, hb]
    have hfa : (Tree.node (spCols k cols).1).forestAt [(a, b)] = some (spF k₂ h₀).1 := by
      rw [Tree.forestAt_cons]; simp [Tree.cols, hA', hb', Tree.forestAt]
    rw [e1, e2]
    rcases spx_complete_or_route P h₀ k₂ j (by rw [hP]; rfl) with hc | hr
    · exact Or.inl hc
    · by_cases hlast : a + 1 = (spCols k cols).1.length ∧ b + 1 = (spCol k₁ colA).1.length
      · right
        rw [mem_routeCols_iff] at hr ⊢
        obtain ⟨hrp, F, hF, hFl⟩ := hr
        refine ⟨isRoutePath_cons.2 ⟨?_, _, hfa, hrp⟩, F, ?_, hFl⟩
        · have hne : (spCol k₁ colA).1 ≠ [] := by
            intro h0; rw [h0] at hlast; simp at hlast
          simp only [Tree.lastStep?, Tree.cols]
          rw [List.getLast?_eq_getElem?, show (spCols k cols).1.length - 1 = a by omega, hA',
            Option.bind_some]
          simp only [List.isEmpty_eq_false_iff.2 hne, if_false, Bool.false_eq_true]
          congr 2; omega
        · rw [Tree.forestAt_cons]; simp [Tree.cols, hA', hb', hF]
      · left
        have hfull : (spF k₂ h₀).1 = h₀ := by
          have haL : a < (spCols k cols).1.length := (List.getElem?_eq_some_iff.1 hA').1
          have hbL : b < (spCol k₁ colA).1.length := (List.getElem?_eq_some_iff.1 hb').1
          by_cases ha : a + 1 < (spCols k cols).1.length
          · have hf := spx_spCols_full k cols a (by rw [List.getElem?_eq_getElem ha]; rfl)
            rw [hA', hA] at hf
            have hf' := Option.some.inj hf
            rw [hf', hb] at hb'
            exact (Prod.mk.inj (Option.some.inj hb')).2.symm
          · have hb2 : b + 1 < (spCol k₁ colA).1.length := by omega
            have hf := spx_spCol_full (k := k₁) (col := colA) (i := b)
              (by rw [List.getElem?_eq_getElem hb2]; rfl)
            rw [hb', hb] at hf
            exact (Prod.mk.inj (Option.some.inj hf)).2
        rw [hfull]

/-- A reduced `⊤`-free query below the boundary of entry `v` has the same cursor in a source that
agrees with `ks` through entry `v`, or agrees before `v` and ends at `v` with `⊤`. -/
theorem spx_cursor_capped {ks ks' W : List (WithTop Key)} {v : Nat} (hv : v < ks.length)
    (hW : W.Pairwise fun x y => y ≤ x) (hT : ∀ y ∈ W, y ≠ ⊤) (hlt : W < cutQuery ks (v + 1))
    (hks : ks' = ks.take v ++ [⊤] ∨ (v < ks'.length ∧ ks'.take (v + 1) = ks.take (v + 1))) :
    cursor ks' W = cursor ks W := by
  rcases hks with rfl | ⟨hv', htk⟩
  · exact ((cursor_cappedAt ks W v hv hW hT hlt).2).symm
  · have hc := cursor_le_of_lt_cutQuery hW hv hlt
    have hlt' : W < cutQuery ks' (v + 1) := by
      unfold cutQuery at hlt ⊢; rw [htk]; exact hlt
    have hc' := cursor_le_of_lt_cutQuery hW hv' hlt'
    have e1 := cursor_take ks' W (v + 1)
    have e2 := cursor_take ks W (v + 1)
    rw [htk] at e1
    omega

-- T3.2e (txt:312-313): safe prefixes keep A (barrier + capping)
theorem safePrefix_condA {E : Forest} (hL : InL E) (k : Nat) : CondA (safePrefix E k) := by
  obtain ⟨hV, -, -, hA, hS⟩ := hL
  have hV' : CondV (safePrefix E k) := safePrefix_condV hV k
  have hS' : CondS (safePrefix E k) := safePrefix_condS hV hS k
  refine capping_reverse hV' hS' (sel := routeCols (safePrefix E k)) (fun a ha => ha) ?_
  rw [condAK_iff]
  intro c hc i p hp
  -- the column of `c` in the prefix
  obtain ⟨col', hcol'⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff _ c).1 hc)
  obtain ⟨col, k₁, hcol, rfl, hk₁, -, -⟩ := spx_colAt (k := k) (T := E) hcol'
  have hcE : c ∈ E.colAddrs := (Tree.mem_colAddrs_iff E c).2 (by rw [hcol]; rfl)
  have hpar : ∀ j, j < (spCol k₁ col).1.length →
      (parents (safePrefix E k) c)[j]? = (parents E c)[j]? := by
    intro j hj
    simp only [parents, List.getElem?_map]
    rw [hcol', hcol, Option.getD_some, Option.getD_some]
    exact spx_spCol_fst hk₁ hj
  have hiL : i < (spCol k₁ col).1.length := by
    have := (List.getElem?_eq_some_iff.1 hp).1
    simp only [parents, hcol', Option.getD_some, List.length_map] at this; exact this
  have hpE : (parents E c)[i]? = some p := by rw [← hpar i hiL]; exact hp
  have hiE : i < col.length := by
    have := (List.getElem?_eq_some_iff.1 hpE).1; simpa [parents, hcol] using this
  have hstart : cutStart (safePrefix E k) c i = cutStart E c i := by
    unfold cutStart
    split_ifs with h0
    · rfl
    · rw [hpar (i - 1) (by omega)]
  -- the query
  have hgk : ∀ (o : ColAddr) (colo : Column) (k₂ n : Nat), (safePrefix E k).colAt o =
      some (spCol k₂ colo).1 → E.colAt o = some colo →
      (spCol k₂ colo).1.take n = colo.take n →
      (actualKeys (safePrefix E k) o).take n = (actualKeys E o).take n := by
    intro o colo k₂ n h1 h2 h3
    simp only [actualKeys, h1, h2, Option.getD_some, ← List.map_take, h3]
  have hW : cutQuery (capKeys (safePrefix E k) (routeCols (safePrefix E k)) c) i =
      cutQuery (actualKeys E c) i := by
    rw [cutQuery_capKeys _ _ c (by rw [hcol']; simpa using hiL)]
    unfold cutQuery
    rw [hgk c col k₁ i hcol' hcol (spx_spCol_prefix hiL)]
  have hAE := (condAK_iff _ _).1 hA c hcE i p hpE
  rw [hW, hstart]
  set W := cutQuery (actualKeys E c) i with hWdef
  have hWn : W.Pairwise fun x y => y ≤ x := cutQuery_noninc _ _
  have hWT : ∀ y ∈ W, y ≠ ⊤ := by
    intro y hy
    have hy' := ((nu_sublist _).trans (List.take_sublist _ _)).subset hy
    simp only [actualKeys, List.mem_map] at hy'
    obtain ⟨_, -, rfl⟩ := hy'
    exact WithTop.coe_ne_top
  have hent : (⟨c, i⟩ : EntryAddr) ∈ (safePrefix E k).entryAddrs := by
    rw [Tree.mem_entryAddrs_iff, Tree.entryAt]
    rw [hcol', Option.bind_some, List.getElem?_eq_getElem hiL]; rfl
  -- transfer of the actual path of `E`, edge by edge
  have key : ∀ y, Path E (actualKeys E) c W (cutStart E c i) y →
      Path (safePrefix E k) (capKeys (safePrefix E k) (routeCols (safePrefix E k))) c W
        (cutStart E c i) y := by
    intro y h
    induction h with
    | refl => exact Relation.ReflTransGen.refl
    | @tail z y' hxz hzy ih =>
      obtain ⟨o, ho, hr⟩ := hzy
      refine ih.tail ⟨o, ho, ?_⟩
      have hoE' : ((safePrefix E k).colAt o).isSome := by
        have := (Tree.stack_mem_prefix hent).2.1 o ((ColAddr.resolve_spec 0 c o z).1 ho).1
        exact (Tree.mem_roles_ord o.path _ o.col).1 ((List.takeWhile_sublist _).subset this)
      by_cases hor : o ∈ routeCols (safePrefix E k)
      · -- a route column: a container of `c`; the barrier stops the scan at the container
        obtain ⟨v, hvE', hvc⟩ := routeCols_visible hc hor ho
        obtain ⟨colo', hcolo'⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff _ o).1
          (mem_colAddrs_of_mem_routeCols hor))
        obtain ⟨colo, k₂, hcolo, rfl, hk₂, -, -⟩ := spx_colAt (k := k) (T := E) hcolo'
        have hvL : v < (spCol k₂ colo).1.length := by
          have := (Tree.mem_entryAddrs_iff _ _).1 hvE'
          rw [Tree.entryAt] at this
          rw [hcolo', Option.bind_some] at this
          obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 this
          exact (List.getElem?_eq_some_iff.1 hx).1
        obtain ⟨xv, hxv⟩ : ∃ x, (spCol k₂ colo).1[v]? = some x :=
          ⟨_, List.getElem?_eq_getElem hvL⟩
        obtain ⟨Hv, -, hHv, -, -⟩ := spx_spCol_get hk₂ hxv
        have hvo : v < colo.length := (List.getElem?_eq_some_iff.1 hHv).1
        have hvE : (⟨o, v⟩ : EntryAddr) ∈ E.entryAddrs := by
          rw [Tree.mem_entryAddrs_iff, Tree.entryAt, hcolo, Option.bind_some, hHv]; rfl
        have hz : o.num 0 = z := ColAddr.resolve_num ho
        have hbar := cut_barrier hV hA hS hvE hcE hvc (k := i)
          (by simp [parents, hcol]; omega) (by rw [hz]; exact hxz)
        dsimp only at hbar
        rw [boundary_eq_cutQuery] at hbar
        set ks := actualKeys E o with hks
        have hksL : ks.length = colo.length := by simp [hks, actualKeys, hcolo]
        have hcap : capKeys (safePrefix E k) (routeCols (safePrefix E k)) o =
            (actualKeys (safePrefix E k) o).dropLast ++ [⊤] := by
          have hne : actualKeys (safePrefix E k) o ≠ [] := by
            simp only [actualKeys]
            rw [hcolo', Option.getD_some]
            intro h0; rw [List.map_eq_nil_iff] at h0; rw [h0] at hvL; simp at hvL
          obtain ⟨y, hy⟩ := Option.ne_none_iff_exists'.1 (mt List.getLast?_eq_none_iff.1 hne)
          simp [capKeys, hor, hy]
        have hlenA : (actualKeys (safePrefix E k) o).length = (spCol k₂ colo).1.length := by
          simp only [actualKeys, List.length_map]
          rw [hcolo', Option.getD_some]
        have hcur : cursor (capKeys (safePrefix E k) (routeCols (safePrefix E k)) o) W =
            cursor ks W := by
          refine spx_cursor_capped (by omega) hWn hWT hbar ?_
          rw [hcap]
          by_cases hv1 : v + 1 = (spCol k₂ colo).1.length
          · left
            rw [List.dropLast_eq_take, hlenA, show (spCol k₂ colo).1.length - 1 = v by omega,
              hgk o colo k₂ v hcolo' hcolo (spx_spCol_prefix hvL)]
          · right
            refine ⟨by simp; omega, ?_⟩
            rw [List.take_append_of_le_length (by rw [List.length_dropLast]; omega),
              List.dropLast_eq_take, List.take_take, Nat.min_eq_left (by omega)]
            exact hgk o colo k₂ (v + 1) hcolo' hcolo (spx_spCol_prefix (by omega))
        have hm : cursor ks W ≤ v := cursor_le_of_lt_cutQuery hWn (by omega) hbar
        unfold resp at hr ⊢
        rw [hcur]
        rw [hcolo', Option.getD_some, spx_spCol_fst hk₂ (by omega)]
        rw [hcolo, Option.getD_some] at hr
        exact hr
      · -- a non-route column is complete in the prefix
        have hcomp := (spx_complete_or_route o.path E k o.col hoE').resolve_right hor
        have hcomp' : (safePrefix E k).colAt o = E.colAt o := hcomp
        unfold resp at hr ⊢
        rw [capKeys_of_not_mem hor]
        unfold actualKeys at hr ⊢
        rw [hcomp']
        exact hr
  exact key p hAE


/-! T3.2f helpers: profiles of safe prefixes, pure towers. -/

/-- The profile recursion started `e` levels deeper adds `e` to the depth. -/
theorem spx_profileAux_add (e : Nat) (d : Nat) (H : Forest) :
    profileAux (d + e) H = toLex ((ofLex (profileAux d H)).1 + e, (ofLex (profileAux d H)).2) := by
  induction d, H using profileAux.induct with
  | case1 d p rest tail => simp [profileAux]
  | case2 d p rest tail head tail_1 ih =>
    rw [profileAux, profileAux, show d + e + 1 = d + 1 + e by omega]; exact ih
  | case3 d cols hne =>
    match cols, hne with
    | [], _ => simp [profileAux]
    | [] :: cs, _ => simp [profileAux]
    | ((p, h) :: rest) :: cs, hne => exact absurd rfl (hne p h rest cs)

theorem spx_profile_node {cols : List Column} (h : cols ≠ []) :
    profile (Tree.node cols) = ((profileAux 0 (Tree.node cols) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by
  cases cols with
  | nil => exact absurd rfl h
  | cons x xs => rfl

theorem spx_profileAux_one (H : Forest) :
    profileAux 1 H = toLex ((ofLex (profileAux 0 H)).1 + 1, (ofLex (profileAux 0 H)).2) :=
  spx_profileAux_add 1 0 H

/-- A pure tower: singleton levels with parents `ps`, ending in `m` entries `(q, ∅)`. -/
def spxTower : List Nat → Nat → Nat → Forest
  | [], q, m => .node [List.replicate m (q, Tree.empty)]
  | p :: ps, q, m => .node [[(p, spxTower ps q m)]]

theorem spx_tower_ne (ps : List Nat) (q m : Nat) : (spxTower ps q m).cols ≠ [] := by
  cases ps <;> simp [spxTower, Tree.cols]

theorem spx_profileAux_cons (d p : Nat) {h : Forest} (hh : h.cols ≠ []) (rest : Column)
    (tail : List Column) :
    profileAux d (Tree.node (((p, h) :: rest) :: tail)) = profileAux (d + 1) h := by
  obtain ⟨hc⟩ := h
  cases hc with
  | nil => simp [Tree.cols] at hh
  | cons x xs => rw [profileAux]

theorem spx_eta (T : Forest) : T = Tree.node T.cols := by cases T; rfl

theorem spx_profileAux_tower : ∀ (ps : List Nat) (q m : Nat),
    profileAux 0 (spxTower ps q (m + 1)) = toLex (ps.length, m + 1)
  | [], q, m => by
    show profileAux 0 (Tree.node [((q, Tree.node []) :: List.replicate m (q, Tree.node []))]) = _
    rw [profileAux]
    have : (List.replicate m (q, (Tree.node [] : Forest))).takeWhile (fun x => x.1 == q) =
        List.replicate m (q, Tree.node []) := by
      induction m with
      | zero => rfl
      | succ m ih => simp only [List.replicate_succ, List.takeWhile_cons, beq_self_eq_true,
          if_true, ih]
    rw [this, List.length_replicate]; simp; omega
  | p :: ps, q, m => by
    simp only [spxTower]
    rw [spx_profileAux_cons 0 p (spx_tower_ne ps q (m + 1)), spx_profileAux_one,
      spx_profileAux_tower ps q m]
    simp

theorem spx_profile_tower (ps : List Nat) (q m : Nat) :
    profile (spxTower ps q (m + 1)) = ((toLex (ps.length, m + 1) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by
  rw [spx_eta (spxTower ps q (m + 1)), spx_profile_node (spx_tower_ne ps q (m + 1)), ← spx_eta]
  exact congrArg _ (spx_profileAux_tower ps q m)

theorem spx_colAt_empty (c : ColAddr) : (Tree.empty : Forest).colAt c = none := by
  obtain ⟨P, j⟩ := c
  cases P with
  | nil => simp [Tree.colAt, Tree.forestAt, Tree.empty, Tree.cols]
  | cons x xs => obtain ⟨a, b⟩ := x; simp [Tree.colAt, Tree.forestAt, Tree.empty, Tree.cols]

/-- Every column of a tower is nonempty with constant parents. -/
theorem spx_tower_col : ∀ (ps : List Nat) (q m : Nat) (ρ : List (Nat × Nat)) (j : Nat) (col : Column),
    (spxTower ps q (m + 1)).colAt ⟨ρ, j⟩ = some col →
      ∃ q₀ H₀ rest, col = (q₀, H₀) :: rest ∧ ∀ x ∈ col, x.1 = q₀
  | [], q, m, [], j, col, h => by
    simp only [spxTower, Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols] at h
    cases j with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.some.injEq] at h
      subst h
      exact ⟨q, _, _, rfl, fun x hx => by rw [(List.eq_of_mem_replicate hx)]⟩
    | succ j => simp at h
  | [], q, m, (a, b) :: ρ, j, col, h => by
    rw [Tree.colAt_cons] at h
    simp only [spxTower, Tree.cols] at h
    cases a with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.bind_some] at h
      cases hb : (List.replicate (m + 1) (q, (Tree.empty : Forest)))[b]? with
      | none => rw [hb] at h; simp at h
      | some x =>
        rw [hb, Option.bind_some] at h
        have := List.eq_of_mem_replicate (List.mem_of_getElem? hb)
        rw [this] at h
        rw [spx_colAt_empty] at h; simp at h
    | succ a => simp at h
  | p :: ps, q, m, [], j, col, h => by
    simp only [spxTower, Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols] at h
    cases j with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.some.injEq] at h
      subst h
      exact ⟨p, _, _, rfl, fun x hx => by simp at hx; rw [hx]⟩
    | succ j => simp at h
  | p :: ps, q, m, (a, b) :: ρ, j, col, h => by
    rw [Tree.colAt_cons] at h
    simp only [spxTower, Tree.cols] at h
    cases a with
    | zero =>
      cases b with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.bind_some] at h
        exact spx_tower_col ps q m ρ j col h
      | succ b => simp at h
    | succ a => simp at h

/-- The heights of the outer entries of a tower have smaller profile. -/
theorem spx_tower_outer {ps : List Nat} {q m j i q' : Nat} {J : Forest}
    (h : (spxTower ps q (m + 1)).entryAt ⟨⟨[], j⟩, i⟩ = some (q', J)) :
    profile J < profile (spxTower ps q (m + 1)) := by
  rw [spx_profile_tower]
  cases ps with
  | nil =>
    simp only [spxTower, Tree.entryAt, Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols] at h
    cases j with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.bind_some] at h
      have := List.eq_of_mem_replicate (List.mem_of_getElem? h)
      simp only [Prod.mk.injEq] at this
      rw [this.2]
      exact WithBot.bot_lt_coe _
    | succ j => simp at h
  | cons p ps =>
    simp only [spxTower, Tree.entryAt, Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols] at h
    cases j with
    | zero =>
      cases i with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.bind_some, Option.some.injEq,
          Prod.mk.injEq] at h
        rw [← h.2, spx_profile_tower]
        exact WithBot.coe_lt_coe.2 (Prod.Lex.toLex_lt_toLex.2 (Or.inl (by simp)))
      | succ i => simp at h
    | succ j => simp at h

theorem spx_spF_emptyF (k : Nat) : spF k (Tree.empty : Forest) = (Tree.empty, k) := by
  simp [Tree.empty, spF, spCols]

theorem spx_spLater_zero (col : Column) : spLater 0 col = ([], 0) := by
  cases col <;> simp [spLater]

theorem spx_spCols_zero (cols : List Column) : spCols 0 cols = ([], 0) := by
  cases cols <;> simp [spCols]

theorem spx_spLater_fst : ∀ (k : Nat) (col : Column),
    (spLater k col).1.map Prod.fst <+: col.map Prod.fst
  | k, [] => by simp [spLater]
  | k, (q, h) :: rest => by
    by_cases hk : k = 0
    · simp [spLater, hk]
    · simp only [spLater, hk, if_false, List.map_cons]
      exact (List.prefix_cons_inj _).2 (spx_spLater_fst _ rest)

theorem spx_spLater_short : ∀ (k : Nat) (col : Column),
    (spLater k col).1.length < col.length → (spLater k col).2 = 0
  | k, [] => by simp [spLater]
  | k, (q, h) :: rest => by
    by_cases hk : k = 0
    · simp [spLater, hk]
    · simp only [spLater, hk, if_false, List.length_cons]
      intro hl
      exact spx_spLater_short _ rest (by omega)

/-- Runs of a parent in a prefix of the parent list. -/
theorem spx_takeWhile_prefix (p : Nat) : ∀ (l' l : Column), l'.map Prod.fst <+: l.map Prod.fst →
    (l'.takeWhile fun x => x.1 == p).length ≤ (l.takeWhile fun x => x.1 == p).length ∧
    ((l'.takeWhile fun x => x.1 == p).length < (l.takeWhile fun x => x.1 == p).length →
      (∀ x ∈ l', x.1 = p) ∧ l'.length < l.length)
  | [], l, _ => by
    refine ⟨by simp, fun h => ⟨by simp, ?_⟩⟩
    cases l with
    | nil => simp at h
    | cons x xs => simp
  | x' :: xs', [], h => by simp at h
  | x' :: xs', x :: xs, h => by
    simp only [List.map_cons, List.cons_prefix_cons] at h
    obtain ⟨hx, h⟩ := h
    have ih := spx_takeWhile_prefix p xs' xs h
    by_cases hp : x'.1 = p
    · have hp' : x.1 = p := hx ▸ hp
      have e1 : (x' :: xs').takeWhile (fun x => x.1 == p) = x' :: xs'.takeWhile (fun x => x.1 == p) := by
        simp [hp]
      have e2 : (x :: xs).takeWhile (fun x => x.1 == p) = x :: xs.takeWhile (fun x => x.1 == p) := by
        simp [hp']
      rw [e1, e2, List.length_cons, List.length_cons]
      refine ⟨Nat.succ_le_succ ih.1, fun hl => ⟨?_, ?_⟩⟩
      · intro y hy
        rcases List.mem_cons.1 hy with rfl | hy
        · exact hp
        · exact (ih.2 (Nat.lt_of_succ_lt_succ hl)).1 y hy
      · simp only [List.length_cons]
        exact Nat.succ_lt_succ (ih.2 (Nat.lt_of_succ_lt_succ hl)).2
    · have hp' : ¬ x.1 = p := hx ▸ hp
      have e1 : (x' :: xs').takeWhile (fun x => x.1 == p) = [] := by
        simp [hp]
      have e2 : (x :: xs).takeWhile (fun x => x.1 == p) = [] := by
        simp [hp']
      rw [e1, e2]; simp

/-- Nonincreasing columns. -/
def spxNoninc (col : Column) : Prop :=
  ∀ i x y, col[i]? = some x → col[i + 1]? = some y → EntryLe y x

theorem spx_le_empty {X : Forest} (h : X ≤ Tree.empty) : X = Tree.empty := by
  by_contra hne
  exact absurd h (not_le.2 (Forest.empty_lt hne))

/-- Under H the run of the first parent after an entry with empty height has empty heights. -/
theorem spx_run_empty (p : Nat) : ∀ (rest : Column), spxNoninc ((p, Tree.empty) :: rest) →
    ∀ x ∈ rest.takeWhile (fun x => x.1 == p), x = (p, Tree.empty)
  | [], _ => by simp
  | y :: ys, h => by
    by_cases hy : y.1 = p
    · have hle := h 0 (p, Tree.empty) y rfl rfl
      have hy2 : y.2 = Tree.empty := by
        rcases hle with hlt | ⟨-, hle⟩
        · exact absurd hlt (by simp [hy])
        · exact spx_le_empty hle
      have hyy : y = (p, Tree.empty) := Prod.ext hy hy2
      have h' : spxNoninc ((p, Tree.empty) :: ys) := by
        intro i x z hx hz
        apply h (i + 1) x z
        · cases i with
          | zero => simpa [hyy] using hx
          | succ i => simpa using hx
        · simpa using hz
      intro x hx
      simp only [List.takeWhile_cons, hy, beq_self_eq_true, if_true, List.mem_cons] at hx
      rcases hx with rfl | hx
      · exact hyy
      · exact spx_run_empty p ys h' x hx
    · simp [hy]

theorem spx_condH_col {T : Forest} (hH : CondH T) {c : ColAddr} {col : Column}
    (hc : T.colAt c = some col) : spxNoninc col := by
  intro i x y hx hy
  have := hH c ((Tree.mem_colAddrs_iff T c).2 (by rw [hc]; rfl)) i x y
  rw [hc, Option.getD_some] at this
  exact this hx hy

theorem spx_colAt_append (t : Forest) (π ρ : List (Nat × Nat)) (j : Nat) :
    t.colAt ⟨π ++ ρ, j⟩ = (t.forestAt π).bind fun F => F.colAt ⟨ρ, j⟩ := by
  simp only [Tree.colAt, Tree.forestAt_append, Option.bind_assoc]

/-- H passes to heights. -/
theorem spx_condH_height {T : Forest} (hH : CondH T) {g : EntryAddr} {G : Forest}
    (hg : T.heightAt g = some G) : CondH G := by
  intro c hc i x y hx hy
  have hcol : T.colAt ⟨g.heightPath ++ c.path, c.col⟩ = G.colAt c := by
    rw [spx_colAt_append, Tree.forestAt_heightPath, hg]; rfl
  obtain ⟨col, hcol'⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff G c).1 hc)
  rw [hcol'] at hcol hx hy
  exact spx_condH_col hH hcol i x y hx hy

/-- Profiles of safe prefixes: never larger, and when changed (and nonempty) a pure tower. -/
theorem spx_profile_sp (d : Nat) (H : Forest) : ∀ k, CondH H →
    profile (safePrefix H k) ≤ profile H ∧
      (profile (safePrefix H k) = profile H ∨
        (∃ ps q m, safePrefix H k = spxTower ps q (m + 1)) ∨ safePrefix H k = Tree.empty) := by
  induction d, H using profileAux.induct with
  | case1 d p rest tail =>
    intro k hH
    rcases Nat.eq_zero_or_pos k with rfl | hk
    · have : safePrefix (Tree.node (((p, Tree.node []) :: rest) :: tail)) 0 = Tree.empty := by
        simp [safePrefix, safePrefixBody, spF, spCols, Tree.empty]
      rw [this]; exact ⟨by simp [profile, profileBody, Tree.empty], Or.inr (Or.inr rfl)⟩
    · have hsp : safePrefix (Tree.node (((p, Tree.node []) :: rest) :: tail)) k =
          Tree.node (((p, Tree.node []) :: (spLater (k - 1) rest).1) ::
            (spCols (spLater (k - 1) rest).2 tail).1) := by
        show (spF k _).1 = _
        have := spx_spF_emptyF (k - 1)
        simp only [Tree.empty] at this
        simp only [spF, spCols, Nat.pos_iff_ne_zero.1 hk, if_false, spCol]
      rw [hsp, spx_profile_node (by simp), spx_profile_node (by simp), profileAux, profileAux]
      obtain ⟨hle, hlt⟩ := spx_takeWhile_prefix p _ rest (spx_spLater_fst (k - 1) rest)
      refine ⟨WithBot.coe_le_coe.2 (Prod.Lex.toLex_le_toLex.2 (Or.inr ⟨rfl,
        Nat.add_le_add_left hle 1⟩)), ?_⟩
      by_cases heq : ((spLater (k - 1) rest).1.takeWhile fun x => x.1 == p).length =
          (rest.takeWhile fun x => x.1 == p).length
      · left; rw [heq]
      · right; left
        obtain ⟨hall, hshort⟩ := hlt (Nat.lt_of_le_of_ne hle heq)
        have hrun := spx_run_empty p rest (spx_condH_col hH (c := ⟨[], 0⟩) rfl)
        have hb := spx_spLater_short _ _ hshort
        have hit : (spLater (k - 1) rest).1.length < (rest.takeWhile fun x => x.1 == p).length := by
          have e : ((spLater (k - 1) rest).1.takeWhile fun x => x.1 == p) =
              (spLater (k - 1) rest).1 := takeWhile_eq_self_of (fun x hx => by simp [hall x hx])
          rw [e] at hle heq; exact Nat.lt_of_le_of_ne hle heq
        have hkept : (spLater (k - 1) rest).1 =
            List.replicate (spLater (k - 1) rest).1.length (p, Tree.empty) := by
          apply List.ext_getElem (by simp)
          intro i hi _
          rw [List.getElem_replicate]
          obtain ⟨⟨q, h'⟩, hx⟩ : ∃ x, (spLater (k - 1) rest).1[i]? = some x :=
            ⟨_, List.getElem?_eq_getElem hi⟩
          obtain ⟨h₀, k', hr, rfl, -⟩ := spx_spLater_get _ _ i q h' hx
          have hq : q = p := hall _ (List.mem_of_getElem? hx)
          have hmem : (q, h₀) ∈ rest.takeWhile fun x => x.1 == p := by
            apply List.mem_of_getElem? (i := i)
            rw [List.prefix_iff_eq_take.1 (List.takeWhile_prefix _), List.getElem?_take,
              if_pos (by omega)]
            exact hr
          have := hrun _ hmem
          simp only [Prod.mk.injEq] at this
          rw [List.getElem?_eq_getElem hi] at hx
          rw [Option.some.inj hx, this.2, hq, spx_spF_emptyF]
        refine ⟨[], p, (spLater (k - 1) rest).1.length, ?_⟩
        rw [hb, spx_spCols_zero, hkept]
        simp only [spxTower, List.replicate_succ, List.length_replicate, Tree.empty]
  | case2 d p rest tail head tail_1 ih =>
    intro k hH
    have hHh : CondH (Tree.node (head :: tail_1)) := spx_condH_height hH (g := ⟨⟨[], 0⟩, 0⟩) rfl
    have ih' := ih
    generalize hh : Tree.node (head :: tail_1) = h at hHh ih'
    have hne : h.cols ≠ [] := by rw [← hh]; simp [Tree.cols]
    have hprof : profile (Tree.node (((p, h) :: rest) :: tail)) =
        ((profileAux 1 h : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by
      rw [spx_profile_node (by simp), spx_profileAux_cons 0 p hne]
    rcases Nat.eq_zero_or_pos k with rfl | hk
    · have : safePrefix (Tree.node (((p, h) :: rest) :: tail)) 0 = Tree.empty := by
        simp [safePrefix, safePrefixBody, spF, spCols, Tree.empty]
      rw [this]; exact ⟨by simp [profile, profileBody, Tree.empty], Or.inr (Or.inr rfl)⟩
    · have hsp : safePrefix (Tree.node (((p, h) :: rest) :: tail)) k =
          Tree.node (((p, (spF (k - 1) h).1) :: (spLater (spF (k - 1) h).2 rest).1) ::
            (spCols (spLater (spF (k - 1) h).2 rest).2 tail).1) := by
        show (spF k _).1 = _
        simp only [spF, spCols, Nat.pos_iff_ne_zero.1 hk, if_false, spCol]
      rw [hsp, hprof]
      by_cases hb : (spF (k - 1) h).2 = 0
      · rw [hb, spx_spLater_zero, spx_spCols_zero]
        obtain ⟨ihle, ihc⟩ := ih' (k - 1) hHh
        by_cases he : (spF (k - 1) h).1 = Tree.empty
        · rw [he]
          have ht : (Tree.node [[(p, Tree.empty)]] : Forest) = spxTower [] p (0 + 1) := rfl
          rw [ht, spx_profile_tower]
          refine ⟨WithBot.coe_le_coe.2 ?_, Or.inr (Or.inl ⟨[], p, 0, rfl⟩)⟩
          rw [spx_profileAux_one, Prod.Lex.toLex_le_toLex]
          left; simp
        · have hne' : (spF (k - 1) h).1.cols ≠ [] := by
            intro h0; apply he; rw [spx_eta (spF (k - 1) h).1, h0]; rfl
          have e1 : profile (Tree.node [[(p, (spF (k - 1) h).1)]]) =
              ((profileAux 1 (spF (k - 1) h).1 : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by
            rw [spx_profile_node (by simp), spx_profileAux_cons 0 p hne']
          have e2 : profile (spF (k - 1) h).1 =
              ((profileAux 0 (spF (k - 1) h).1 : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by
            rw [spx_eta (spF (k - 1) h).1, spx_profile_node hne', ← spx_eta]
          have e3 : profile h = ((profileAux 0 h : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by
            rw [spx_eta h, spx_profile_node hne, ← spx_eta]
          have ihle' : profile (spF (k - 1) h).1 ≤ profile h := ihle
          rw [e2, e3, WithBot.coe_le_coe] at ihle'
          rw [e1]
          refine ⟨WithBot.coe_le_coe.2 ?_, ?_⟩
          · rw [spx_profileAux_one, spx_profileAux_one]
            rw [Prod.Lex.le_iff] at ihle'
            rw [Prod.Lex.toLex_le_toLex]
            simp only at ihle' ⊢
            omega
          · rcases ihc with heq | ⟨ps, q, m, htw⟩ | hemp
            · left
              change profile (spF (k - 1) h).1 = profile h at heq
              rw [e2, e3, WithBot.coe_inj] at heq
              rw [spx_profileAux_one, spx_profileAux_one, heq]
            · right; left
              change (spF (k - 1) h).1 = _ at htw
              exact ⟨p :: ps, q, m, by rw [htw]; rfl⟩
            · exact absurd hemp he
      · rw [spx_spF_full hb]
        have e1 : profile (Tree.node (((p, h) :: (spLater (spF (k - 1) h).2 rest).1) ::
            (spCols (spLater (spF (k - 1) h).2 rest).2 tail).1)) =
            ((profileAux 1 h : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by
          rw [spx_profile_node (by simp), spx_profileAux_cons 0 p hne]
        rw [e1]
        exact ⟨le_refl _, Or.inl rfl⟩
  | case3 d cols hne =>
    intro k hH
    match cols, hne with
    | [], _ =>
      have : safePrefix (Tree.node []) k = Tree.empty := by
        have := spx_spF_emptyF k; simp only [Tree.empty] at this
        show (spF k _).1 = _; rw [this]; rfl
      rw [this]; exact ⟨le_of_eq (by rfl), Or.inr (Or.inr rfl)⟩
    | [] :: cs, _ =>
      rcases Nat.eq_zero_or_pos k with rfl | hk
      · have : safePrefix (Tree.node ([] :: cs)) 0 = Tree.empty := by
          simp [safePrefix, safePrefixBody, spF, spCols, Tree.empty]
        rw [this]; exact ⟨by simp [profile, profileBody, Tree.empty], Or.inr (Or.inr rfl)⟩
      · have hsp : safePrefix (Tree.node ([] :: cs)) k =
            Tree.node ([] :: (spCols (k - 1) cs).1) := by
          show (spF k _).1 = _
          simp only [spF, spCols, Nat.pos_iff_ne_zero.1 hk, if_false, spCol]
        rw [hsp, spx_profile_node (by simp), spx_profile_node (by simp), profileAux, profileAux]
        all_goals first | exact ⟨le_refl _, Or.inl rfl⟩ | simp
    | ((p, h) :: rest) :: cs, hne => exact absurd rfl (hne p h rest cs)

-- T3.2f (txt:314-318): safe prefixes keep P
theorem safePrefix_condP {E : Forest} (hL : InL E) (hP : CondP E) (k : Nat) :
    CondP (safePrefix E k) := by
  obtain ⟨-, hI, hH, -, -⟩ := hL
  have hI' : CondI (safePrefix E k) := safePrefix_condI hI k
  intro e0 he0 e he hret
  obtain ⟨⟨ρ, hρ⟩, q, J', hJ', hres⟩ := hret
  obtain ⟨⟨P, j⟩, i⟩ := e
  dsimp only at hρ
  subst hρ
  obtain ⟨x0, hx0⟩ := Option.isSome_iff_exists.1 ((Tree.mem_entryAddrs_iff _ e0).1 he0)
  obtain ⟨p0, H'⟩ := x0
  obtain ⟨H, k₀, hH0, rfl, -⟩ := spx_entryAt (k := k) (T := E) hx0
  have hJ'' := hJ'
  rw [spx_entryAt_inside, Tree.heightAt, hx0] at hJ''
  simp only [Option.map_some, Option.bind_some] at hJ''
  obtain ⟨J, k₁, hJ, rfl, hk⟩ := spx_entryAt hJ''
  have hEe : E.entryAt ⟨⟨e0.heightPath ++ ρ, j⟩, i⟩ = some (q, J) := by
    rw [spx_entryAt_inside, Tree.heightAt, hH0]; simpa using hJ
  have hretE : IsOwnerReturn E e0 ⟨⟨e0.heightPath ++ ρ, j⟩, i⟩ := ⟨⟨ρ, rfl⟩, q, J, hEe, hres⟩
  have hPE := hP e0 ((Tree.mem_entryAddrs_iff E e0).2 (by rw [hH0]; rfl)) _
    ((Tree.mem_entryAddrs_iff E _).2 (by rw [hEe]; rfl)) hretE
  rw [Tree.heightAt, Tree.heightAt, hEe, hH0] at hPE
  simp only [Option.map_some, Option.getD_some] at hPE
  rw [Tree.heightAt, Tree.heightAt, hJ', hx0]
  simp only [Option.map_some, Option.getD_some]
  have hHH : CondH H := spx_condH_height hH (g := e0) (by rw [Tree.heightAt, hH0]; rfl)
  have hHJ : CondH J :=
    spx_condH_height hH (g := ⟨⟨e0.heightPath ++ ρ, j⟩, i⟩) (by rw [Tree.heightAt, hEe]; rfl)
  obtain ⟨-, hcase⟩ := spx_profile_sp 0 H k₀ hHH
  rcases hcase with hsame | ⟨ps, q', m, htw⟩ | hemp
  · exact lt_of_le_of_lt (spx_profile_sp 0 J k₁ hHJ).1 (hsame ▸ hPE)
  · -- the prefix of `H` is a pure tower: only its outer entries can return to its host
    have htw' : (spF k₀ H).1 = spxTower ps q' (m + 1) := htw
    rw [htw'] at hJ'' ⊢
    rcases List.eq_nil_or_concat ρ with rfl | ⟨ρ₀, ⟨c₁, i₁⟩, rfl⟩
    · exact spx_tower_outer hJ''
    · exfalso
      obtain ⟨col, hcol, hci⟩ := Tree.colAt_of_entryAt hJ''
      obtain ⟨q₀, H₀, rest, rfl, hconst⟩ := spx_tower_col ps q' m _ j _ hcol
      have hqq : q = q₀ := hconst _ (List.mem_of_getElem? hci)
      -- the entry `g` whose height holds the returning column
      let g : EntryAddr := ⟨⟨e0.heightPath ++ ρ₀, c₁⟩, i₁⟩
      have hgp : g.heightPath = e0.heightPath ++ (ρ₀ ++ [(c₁, i₁)]) := by
        simp [g, EntryAddr.heightPath]
      have hcolE : (safePrefix E k).colAt ⟨g.heightPath, j⟩ = some ((q₀, H₀) :: rest) := by
        rw [hgp, spx_colAt_append, Tree.forestAt_heightPath, Tree.heightAt, hx0]
        simp only [Option.map_some, Option.bind_some]
        rw [htw']; simpa using hcol
      rw [Tree.colAt, Tree.forestAt_heightPath, Tree.heightAt] at hcolE
      obtain ⟨G, hG, hGc⟩ := Option.bind_eq_some_iff.1 hcolE
      obtain ⟨⟨pg, G'⟩, hgE, hGG⟩ := Option.map_eq_some_iff.1 hG
      simp only at hGG
      subst hGG
      have hGne : G' ≠ Tree.empty := by
        intro h0; rw [h0] at hGc; simp [Tree.empty, Tree.cols] at hGc
      obtain ⟨q'', H'', rest'', hc'', hle⟩ := hI' g ((Tree.mem_entryAddrs_iff _ g).2
        (by rw [hgE]; rfl)) pg G' hgE hGne _ (List.mem_of_getElem? hGc)
      simp only [List.cons.injEq, Prod.mk.injEq] at hc''
      have hnum : e0.col.num 0 = q := ColAddr.resolve_num hres
      have hg : e0.col.num 0 + 1 ≤ g.col.num 0 := by
        simp only [g, ColAddr.num, EntryAddr.heightPath, List.map_append, List.sum_append,
          List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]
        omega
      omega
  · have htw' : (spF k₀ H).1 = Tree.empty := hemp
    rw [htw'] at hJ''
    obtain ⟨col, hcol, -⟩ := Tree.colAt_of_entryAt hJ''
    rw [spx_colAt_empty] at hcol; cases hcol


/-! T3.2g helpers: a proper word prefix is a safe prefix; filling the hole with its own column. -/

/-- A forest whose word is a proper prefix of `w(E)` is a safe prefix of `E`. -/
theorem spx_safePrefix_of_word {E E' : Forest} {X : List WordAtom} (hX : X ≠ [])
    (h : word E = word E' ++ X) : ∃ k, k < mu E ∧ E' = safePrefix E k := by
  refine ⟨mu E', ?_, word_injective ?_⟩
  · unfold mu; rw [h, List.length_append]
    have := List.length_pos_of_ne_nil hX; omega
  · rw [word_safePrefix, h]
    show word E' = (word E' ++ X).take (word E').length
    simp

/-- Filling the hole at the end of a route path with the column found there restores the forest. -/
theorem spx_put_self : ∀ (π : List (Nat × Nat)) (F G : Forest), IsRoutePath F π →
    F.forestAt π = some G → G.cols ≠ [] →
      replaceAt 0 0 (Tree.node [G.cols.getLast?.getD []]) π.length F = F
  | [], .node cols, G, _, hG, hne => by
    simp only [Tree.forestAt, Option.some.injEq] at hG
    subst hG
    simp only [Tree.cols] at hne ⊢
    obtain ⟨ys, y, rfl⟩ := (List.eq_nil_or_concat cols).resolve_left hne
    cases ys with
    | nil => simp [replaceAt, shiftVal_zero_fun, treeMapCol_id_fun, Tree.cols]
    | cons c cs =>
      simp only [replaceAt, shiftVal_zero_fun, treeMapCol_id_fun, Tree.cols, List.map_id,
        List.length_nil]
      rw [List.concat_eq_append, List.dropLast_concat, List.getLast?_concat]; rfl
  | s :: π, .node cols, G, hr, hG, hne => by
    obtain ⟨hl, h, hh, hr'⟩ := isRoutePath_cons.1 hr
    obtain ⟨col, p, h', hcol, hcl, hs, hh'⟩ := lastStep?_eq_some hl
    rw [hh] at hh'
    cases hh'
    have hG' : h.forestAt π = some G := by
      rw [show s :: π = [s] ++ π from rfl, Tree.forestAt_append, hh] at hG
      exact hG
    have ih := spx_put_self π h G hr' hG' hne
    simp only [Tree.cols] at hcol
    obtain ⟨ys, rfl⟩ := List.getLast?_eq_some_iff.1 hcol
    obtain ⟨zs, rfl⟩ := List.getLast?_eq_some_iff.1 hcl
    simp only [List.length_cons, replaceAt, mapLast_eq, List.dropLast_concat, List.getLast?_concat,
      Option.map_some, Option.toList_some, shiftVal_zero_fun, treeMapCol_id_fun, id, treeMap_id,
      List.map_id, ih]
    simp

theorem spx_wordCol_ne (e : Nat) (c : Column) : wordCol e c ≠ [] := by
  cases c with
  | nil => simp [wordCol]
  | cons x xs => obtain ⟨p, h⟩ := x; simp [wordCol]

-- T3.2g: deletion steps and ordinary steps at parameter 0 are safe prefixes
theorem expand_safePrefix {E E' : Forest} {n : Nat} (hE : E ≠ Tree.empty) (hV : CondV E)
    (hI : CondI E) (hk : stepKind E = some .deletion ∨ (stepKind E = some .ordinary ∧ n = 0))
    (h : expand E n = some E') : ∃ k, k < mu E ∧ E' = safePrefix E k := by
  rcases hk with hd | ⟨ho, rfl⟩
  · rw [expand_deletion hd n, Option.some.injEq] at h
    subst h
    have hl := (stepKind_deletion_iff E).1 hd
    obtain ⟨ys, hys⟩ := List.getLast?_eq_some_iff.1 hl
    refine spx_safePrefix_of_word (X := [toLex (0, toLex (0, 0))]) (by simp) ?_
    obtain ⟨cols⟩ := E
    simp only [Tree.cols] at hys ⊢
    subst hys
    simp [word, wordAt, wordCols_append, wordCols, wordCol]
  · obtain ⟨sd, hsd⟩ := Option.isSome_iff_exists.1 (stopData_of_stepKind ho (by decide))
    rw [expand_zero_eq_context hE hV hI ho hsd, Option.some.injEq] at h
    subst h
    obtain ⟨-, hdep, -, hmem, -, hlen⟩ := stopData_spec hsd
    obtain ⟨hrp, F, hF, hFl⟩ := (mem_routeCols_iff E sd.col).1 hmem
    have hne : F.cols ≠ [] := by intro h0; rw [h0] at hFl; simp at hFl
    have hself := spx_put_self sd.col.path E F hrp hF hne
    have hput := word_put ⟨E, sd.depth⟩ (Tree.node [F.cols.getLast?.getD []]) (by simp; omega)
    simp only [Hole.put] at hput
    rw [hdep, hself, ← hdep] at hput
    refine spx_safePrefix_of_word ?_ hput
    simp only [wordAt, wordCols, List.append_nil]
    exact spx_wordCol_ne _ _


/-! ### T3.2k/T3.2x helpers (branch D3): relative V, I, H along the route

The ordinary output is `A_{0,0,ℓ,Z}(A)` with `Z = ordZ A sd rd n` (`paperOp_ordinary`). The
conditions V, I (and H below) are proved structurally: each is restated relative to the number of
the first column of a forest (`VRel_D3`, `IRel_D3`), shown stable under shifts and under the
unshifted route replacement `replaceAt 0 0 Z k` (`*_put_D3`), and carried through the loop
`ordStep` one phase at a time (`*_ordStep_D3`). -/

theorem num_cons_D3 (b j m : Nat) (P : List (Nat × Nat)) (c : Nat) :
    ColAddr.num b ⟨(j, m) :: P, c⟩ = ColAddr.num (b + j + 1) ⟨P, c⟩ := by
  simp only [ColAddr.num, List.map_cons, List.sum_cons]; omega

theorem num_nil_D3 (b c : Nat) : ColAddr.num b ⟨[], c⟩ = b + c := by
  simp [ColAddr.num]

theorem num_add_D3 (b d : Nat) (c : ColAddr) : c.num (b + d) = c.num b + d := by
  simp only [ColAddr.num]; omega

theorem entryAt_nil_D3 (cols : List Column) (j m : Nat) :
    (Tree.node cols).entryAt ⟨⟨[], j⟩, m⟩ = (cols[j]?).bind (·[m]?) := rfl

theorem entryAt_cons_D3 (cols : List Column) (j m : Nat) (P : List (Nat × Nat)) (c i : Nat) :
    (Tree.node cols).entryAt ⟨⟨(j, m) :: P, c⟩, i⟩ =
      ((cols[j]?).bind (·[m]?)).bind fun x => x.2.entryAt ⟨⟨P, c⟩, i⟩ :=
  Tree.entryAt_cons _ _ _ _ _ _

/-- Relative condition V: parents below the printed number, the outer forest starting at `b`. -/
def VRel_D3 (b : Nat) (F : Forest) : Prop :=
  ∀ e p h, F.entryAt e = some (p, h) → p < e.col.num b

theorem vrel_node_D3 (b : Nat) (cols : List Column) :
    VRel_D3 b (.node cols) ↔ ∀ (j : Nat) (col : Column), cols[j]? = some col →
      ∀ (m p : Nat) (h : Forest), col[m]? = some (p, h) →
      p < b + j ∧ VRel_D3 (b + j + 1) h := by
  constructor
  · intro hV j col hj m p h hm
    refine ⟨?_, ?_⟩
    · have := hV ⟨⟨[], j⟩, m⟩ p h (by rw [entryAt_nil_D3, hj]; exact hm)
      simpa [num_nil_D3] using this
    · intro e p' h' he
      obtain ⟨⟨P, c⟩, i⟩ := e
      have := hV ⟨⟨(j, m) :: P, c⟩, i⟩ p' h' (by rw [entryAt_cons_D3, hj]; simp [hm, he])
      simpa [num_cons_D3] using this
  · intro hV e p h he
    obtain ⟨⟨P, c⟩, i⟩ := e
    cases P with
    | nil =>
      rw [entryAt_nil_D3] at he
      cases hc : cols[c]? with
      | none => simp [hc] at he
      | some col =>
        simp only [hc, Option.bind_some] at he
        have := (hV c col hc i p h he).1
        simpa [num_nil_D3] using this
    | cons ab P =>
      obtain ⟨j, m⟩ := ab
      rw [entryAt_cons_D3] at he
      cases hc : cols[j]? with
      | none => simp [hc] at he
      | some col =>
        cases hm : col[m]? with
        | none => simp [hc, hm] at he
        | some x =>
          obtain ⟨q, hq⟩ := x
          simp only [hc, hm, Option.bind_some] at he
          have := (hV j col hc m q hq hm).2 ⟨⟨P, c⟩, i⟩ p h he
          simpa [num_cons_D3] using this

theorem condV_iff_vrel_D3 (E : Forest) : CondV E ↔ VRel_D3 0 E := by
  rw [condV_iff_lt]
  constructor
  · intro h e p hh he
    exact h e ((Tree.mem_entryAddrs_iff E e).2 (by rw [he]; rfl)) p hh he
  · intro h e _ p hh he
    exact h e p hh he


theorem cols_map_D3 (f : Nat → Nat) (F : Forest) :
    (Tree.map f F).cols = F.cols.map (Tree.mapCol f) := by
  obtain ⟨cols⟩ := F; simp [Tree.map, Tree.cols, treeMapCols_eq_map]

theorem forestAt_map_D3 (f : Nat → Nat) : ∀ (π : List (Nat × Nat)) (t : Forest),
    (Tree.map f t).forestAt π = (t.forestAt π).map (Tree.map f)
  | [], t => rfl
  | (c, i) :: rest, t => by
    rw [Tree.forestAt_cons, Tree.forestAt_cons, cols_map_D3]
    simp only [List.getElem?_map]
    cases hc : t.cols[c]? with
    | none => simp
    | some col =>
      simp only [Option.map_some, Option.bind_some, treeMapCol_eq_map, List.getElem?_map]
      cases hi : col[i]? with
      | none => simp
      | some x => simp [forestAt_map_D3 f rest x.2]

theorem colAt_map_D3 (f : Nat → Nat) (t : Forest) (c : ColAddr) :
    (Tree.map f t).colAt c = (t.colAt c).map (Tree.mapCol f) := by
  obtain ⟨π, j⟩ := c
  simp only [Tree.colAt, forestAt_map_D3]
  cases t.forestAt π with
  | none => simp
  | some F => simp [cols_map_D3, List.getElem?_map]

theorem entryAt_map_D3 (f : Nat → Nat) (t : Forest) (e : EntryAddr) :
    (Tree.map f t).entryAt e = (t.entryAt e).map fun x => (f x.1, Tree.map f x.2) := by
  obtain ⟨c, i⟩ := e
  simp only [Tree.entryAt, colAt_map_D3]
  cases t.colAt c with
  | none => simp
  | some col => simp [treeMapCol_eq_map, List.getElem?_map]

theorem shiftVal_le_D3 (r d p : Nat) : shiftVal r d p ≤ p + d := by
  unfold shiftVal; split <;> omega

theorem le_shiftVal_D3 (r d p : Nat) : p ≤ shiftVal r d p := by
  unfold shiftVal; split <;> omega

theorem shiftVal_mono_D3 (r d : Nat) {p q : Nat} (h : p ≤ q) : shiftVal r d p ≤ shiftVal r d q := by
  unfold shiftVal; split <;> split <;> omega

theorem shiftVal_strictMono_D3 (r d : Nat) {p q : Nat} (h : p < q) :
    shiftVal r d p < shiftVal r d q := by
  unfold shiftVal; split <;> split <;> omega

theorem vrel_shift_D3 {b : Nat} {F : Forest} (h : VRel_D3 b F) (r d : Nat) :
    VRel_D3 (b + d) (shift r d F) := by
  intro e p hh he
  rw [shift, entryAt_map_D3] at he
  cases h' : F.entryAt e with
  | none => simp [h'] at he
  | some x =>
    simp only [h', Option.map_some, Option.some.injEq, Prod.mk.injEq] at he
    obtain ⟨rfl, rfl⟩ := he
    have := h e x.1 x.2 h'
    rw [num_add_D3]
    have := shiftVal_le_D3 r d x.1
    omega

/-- The last-column, last-entry route reaches depth `k`. -/
def RouteOK_D3 : Nat → Forest → Prop
  | 0, F => F.cols ≠ []
  | k + 1, F => ∃ cs es p h, F = .node (cs ++ [es ++ [(p, h)]]) ∧ RouteOK_D3 k h

/-- The relative number of the route column at depth `k`. -/
def routeNum_D3 : Nat → Forest → Nat
  | 0, F => F.cols.length - 1
  | k + 1, F => F.cols.length + routeNum_D3 k (nextLayer F)

theorem nextLayer_snoc_D3 (cs : List Column) (es : Column) (p : Nat) (h : Forest) :
    nextLayer (.node (cs ++ [es ++ [(p, h)]])) = h := by
  simp [nextLayer, lastEntry?, Tree.cols]

theorem put_zero_D3 (Z : Forest) {cols : List Column} (hc : cols ≠ []) :
    replaceAt 0 0 Z 0 (.node cols) = .node (cols.dropLast ++ Z.cols) := by
  cases cols with
  | nil => exact absurd rfl hc
  | cons c cs =>
    simp only [replaceAt]
    rw [shiftVal_zero_fun 0, treeMapCol_id_fun, List.map_id]

theorem put_succ_D3 (Z : Forest) (k : Nat) (cs : List Column) (es : Column) (p : Nat)
    (h : Forest) :
    replaceAt 0 0 Z (k + 1) (.node (cs ++ [es ++ [(p, h)]])) =
      .node (cs ++ [es ++ [(p, replaceAt 0 0 Z k h)]]) := by
  simp only [replaceAt]
  rw [shiftVal_zero_fun 0, treeMapCol_id_fun]
  simp [mapLast_eq, treeMap_id]

theorem vrel_put_D3 (Z : Forest) : ∀ (k : Nat) (F : Forest) (b : Nat), RouteOK_D3 k F →
    VRel_D3 b F → VRel_D3 (b + routeNum_D3 k F) Z → VRel_D3 b (replaceAt 0 0 Z k F)
  | 0, .node cols, b, hR, hF, hZ => by
    have hc : cols ≠ [] := hR
    rw [put_zero_D3 Z hc]
    obtain ⟨zc⟩ := Z
    simp only [routeNum_D3, Tree.cols] at hZ ⊢
    rw [vrel_node_D3] at hF hZ ⊢
    intro j col hj m p h hm
    by_cases hjl : j < cols.length - 1
    · rw [List.getElem?_append_left (by simpa using hjl), List.getElem?_dropLast] at hj
      simp only [hjl, if_true] at hj
      exact hF j col hj m p h hm
    · rw [List.getElem?_append_right (by simp; omega)] at hj
      simp only [List.length_dropLast] at hj
      have := hZ _ col hj m p h hm
      have e : b + (cols.length - 1) + (j - (cols.length - 1)) = b + j := by omega
      rw [e] at this
      exact this
  | k + 1, F, b, hR, hF, hZ => by
    obtain ⟨cs, es, q, H, rfl, hR'⟩ := hR
    rw [put_succ_D3]
    simp only [routeNum_D3, nextLayer_snoc_D3, Tree.cols, List.length_append, List.length_singleton]
      at hZ
    rw [vrel_node_D3] at hF ⊢
    intro j col hj m p h hm
    by_cases hjl : j < cs.length
    · rw [List.getElem?_append_left hjl] at hj
      exact hF j col (by rw [List.getElem?_append_left hjl]; exact hj) m p h hm
    · have hjeq : j = cs.length := by
        have := (List.getElem?_eq_some_iff.1 hj).1; simp at this; omega
      subst hjeq
      simp only [List.getElem?_append_right (le_refl _), Nat.sub_self, List.getElem?_cons_zero,
        Option.some.injEq] at hj
      subst hj
      have hF' := hF cs.length (es ++ [(q, H)]) (by simp)
      by_cases hml : m < es.length
      · rw [List.getElem?_append_left hml] at hm
        exact hF' m p h (by rw [List.getElem?_append_left hml]; exact hm)
      · have hmeq : m = es.length := by
          have := (List.getElem?_eq_some_iff.1 hm).1; simp at this; omega
        subst hmeq
        simp only [List.getElem?_append_right (le_refl _), Nat.sub_self, List.getElem?_cons_zero,
          Option.some.injEq, Prod.mk.injEq] at hm
        obtain ⟨rfl, rfl⟩ := hm
        have := hF' es.length q H (by simp)
        refine ⟨this.1, vrel_put_D3 Z k H _ hR' this.2 ?_⟩
        have e : b + (cs.length + 1 + routeNum_D3 k H) = b + cs.length + 1 + routeNum_D3 k H := by
          omega
        rw [e] at hZ; exact hZ


/-- Column form of `VRel_D3`: a column numbered `b`. -/
def VCol_D3 (b : Nat) (col : Column) : Prop := ∀ x ∈ col, x.1 < b ∧ VRel_D3 (b + 1) x.2

/-- List-of-columns form of `VRel_D3`. -/
def VCols_D3 (b : Nat) (cols : List Column) : Prop :=
  ∀ (j : Nat) (col : Column), cols[j]? = some col → VCol_D3 (b + j) col

theorem vrel_iff_vcols_D3 (b : Nat) (cols : List Column) :
    VRel_D3 b (.node cols) ↔ VCols_D3 b cols := by
  rw [vrel_node_D3]
  constructor
  · intro h j col hj x hx
    obtain ⟨m, hm⟩ := List.getElem?_of_mem hx
    exact h j col hj m x.1 x.2 hm
  · intro h j col hj m p hh hm
    exact h j col hj (p, hh) (List.mem_of_getElem? hm)

theorem vrel_eq_vcols_D3 (b : Nat) (F : Forest) : VRel_D3 b F ↔ VCols_D3 b F.cols := by
  obtain ⟨cols⟩ := F; exact vrel_iff_vcols_D3 b cols

theorem vcols_nil_D3 (b : Nat) : VCols_D3 b [] := by
  intro j col hj; simp at hj

theorem vcols_cons_D3 (b : Nat) (c : Column) (cs : List Column) :
    VCols_D3 b (c :: cs) ↔ VCol_D3 b c ∧ VCols_D3 (b + 1) cs := by
  constructor
  · intro h
    refine ⟨by simpa using h 0 c rfl, fun j col hj => ?_⟩
    have := h (j + 1) col (by simpa using hj)
    rwa [show b + (j + 1) = b + 1 + j by omega] at this
  · rintro ⟨h1, h2⟩ j col hj
    cases j with
    | zero => simp at hj; subst hj; simpa using h1
    | succ j =>
      have := h2 j col (by simpa using hj)
      rw [show b + (j + 1) = b + 1 + j by omega]; exact this

theorem vcols_append_D3 (b : Nat) (cs ds : List Column) :
    VCols_D3 b (cs ++ ds) ↔ VCols_D3 b cs ∧ VCols_D3 (b + cs.length) ds := by
  induction cs generalizing b with
  | nil => simp [vcols_nil_D3]
  | cons c cs ih =>
    rw [List.cons_append, vcols_cons_D3, vcols_cons_D3, ih]
    simp only [List.length_cons, show b + 1 + cs.length = b + (cs.length + 1) by omega, and_assoc]

theorem vcols_single_D3 (b : Nat) (c : Column) : VCols_D3 b [c] ↔ VCol_D3 b c := by
  rw [vcols_cons_D3]; simp [vcols_nil_D3]

theorem vcol_append_D3 (b : Nat) (l₁ l₂ : Column) :
    VCol_D3 b (l₁ ++ l₂) ↔ VCol_D3 b l₁ ∧ VCol_D3 b l₂ := by
  simp only [VCol_D3, List.mem_append]
  constructor
  · intro h; exact ⟨fun x hx => h x (Or.inl hx), fun x hx => h x (Or.inr hx)⟩
  · rintro ⟨h1, h2⟩ x (hx | hx); exacts [h1 x hx, h2 x hx]

theorem vcol_mono_D3 {b b' : Nat} (hb : b ≤ b') {col : Column} (h : ∀ x ∈ col, x.1 < b)
    (h' : ∀ x ∈ col, VRel_D3 (b' + 1) x.2) : VCol_D3 b' col :=
  fun x hx => ⟨lt_of_lt_of_le (h x hx) hb, h' x hx⟩

theorem vrel_empty_D3 (b : Nat) : VRel_D3 b Tree.empty := by
  rw [show (Tree.empty : Forest) = .node [] from rfl, vrel_iff_vcols_D3]; exact vcols_nil_D3 b

/-- `VRel` inside a column of a forest. -/
theorem vrel_colAt_D3 {b : Nat} {F : Forest} (hF : VRel_D3 b F) {c : ColAddr} {col : Column}
    (hc : F.colAt c = some col) : VCol_D3 (c.num b) col := by
  intro x hx
  obtain ⟨m, hm⟩ := List.getElem?_of_mem hx
  have he : F.entryAt ⟨c, m⟩ = some (x.1, x.2) := by
    simp [Tree.entryAt, hc, hm]
  refine ⟨hF _ _ _ he, ?_⟩
  intro e p h he'
  obtain ⟨⟨P, j⟩, i⟩ := e
  have hG : F.forestAt c.path = some (.node ((F.forestAt c.path).getD Tree.empty).cols) := by
    cases hf : F.forestAt c.path with
    | none => simp [Tree.colAt, hf] at hc
    | some G => obtain ⟨gc⟩ := G; rfl
  have hcol : ((F.forestAt c.path).getD Tree.empty).cols[c.col]? = some col := by
    simp only [Tree.colAt] at hc
    cases hf : F.forestAt c.path with
    | none => simp [hf] at hc
    | some G => simp only [hf, Option.bind_some] at hc; simpa using hc
  have hf : F.forestAt (c.path ++ (c.col, m) :: P) = x.2.forestAt P := by
    rw [Tree.forestAt_append, hG]
    simp only [Option.bind_some]
    rw [Tree.forestAt_cons]
    have e : (Tree.node ((F.forestAt c.path).getD Tree.empty).cols).cols =
      ((F.forestAt c.path).getD Tree.empty).cols := rfl
    rw [e, hcol]; simp [hm]
  have : F.entryAt ⟨⟨c.path ++ (c.col, m) :: P, j⟩, i⟩ = some (p, h) := by
    rw [Tree.entryAt_eq_bind, hf, ← Tree.entryAt_eq_bind]; exact he'
  have := hF _ _ _ this
  simp only [ColAddr.num, List.map_append, List.map_cons, List.sum_append, List.sum_cons] at this ⊢
  omega

theorem vrel_forestAt_D3 {b : Nat} {F : Forest} (hF : VRel_D3 b F) {π : List (Nat × Nat)}
    {G : Forest} (hG : F.forestAt π = some G) :
    VRel_D3 (b + (π.map (·.1 + 1)).sum) G := by
  intro e p h he
  obtain ⟨⟨P, j⟩, i⟩ := e
  have : F.entryAt ⟨⟨π ++ P, j⟩, i⟩ = some (p, h) := by
    rw [Tree.entryAt_eq_bind, Tree.forestAt_append, hG]
    simp only [Option.bind_some]
    rw [Tree.entryAt_eq_bind] at he; exact he
  have := hF _ _ _ this
  simp only [ColAddr.num, List.map_append, List.sum_append] at this ⊢
  omega

theorem vcols_drop_D3 {b : Nat} {cols : List Column} (h : VCols_D3 b cols) (k : Nat) :
    VCols_D3 (b + k) (cols.drop k) := by
  intro j col hj
  rw [List.getElem?_drop] at hj
  have := h (k + j) col hj
  rwa [show b + (k + j) = b + k + j by omega] at this

theorem nextLayer_map_D3 (f : Nat → Nat) (F : Forest) :
    nextLayer (Tree.map f F) = Tree.map f (nextLayer F) := by
  obtain ⟨cols⟩ := F
  rcases List.eq_nil_or_concat cols with rfl | ⟨cs, c, rfl⟩
  · rfl
  rcases List.eq_nil_or_concat c with rfl | ⟨es, x, rfl⟩
  · simp [nextLayer, lastEntry?, Tree.map, Tree.cols, treeMapCols_eq_map, treeMapCol_eq_map,
      Tree.empty, Tree.mapCols]
  · simp [nextLayer, lastEntry?, Tree.map, Tree.cols, treeMapCols_eq_map, treeMapCol_eq_map]

theorem routeOK_shift_D3 (r d : Nat) : ∀ (k : Nat) (F : Forest),
    RouteOK_D3 k (shift r d F) ↔ RouteOK_D3 k F
  | 0, .node cols => by
    simp [RouteOK_D3, shift, Tree.map, Tree.cols, treeMapCols_eq_map]
  | k + 1, .node cols => by
    simp only [RouteOK_D3]
    constructor
    · rintro ⟨cs, es, p, h, he, hR⟩
      simp only [shift, Tree.map, treeMapCols_eq_map, Tree.node.injEq] at he
      rcases List.eq_nil_or_concat cols with rfl | ⟨cs', c, rfl⟩
      · simp at he
      rw [List.concat_eq_append, List.map_append, List.map_singleton] at he
      obtain ⟨hcs, hc⟩ := List.append_inj' he (by simp)
      simp only [List.cons.injEq, and_true] at hc
      rw [treeMapCol_eq_map] at hc
      rcases List.eq_nil_or_concat c with rfl | ⟨es', x, rfl⟩
      · simp at hc
      rw [List.concat_eq_append, List.map_append, List.map_singleton] at hc
      obtain ⟨-, hx⟩ := List.append_inj' hc (by simp)
      simp only [List.cons.injEq, and_true, Prod.mk.injEq] at hx
      refine ⟨cs', es', x.1, x.2, by simp, ?_⟩
      rw [← routeOK_shift_D3 r d k x.2]
      have : shift r d x.2 = h := hx.2
      rw [this]; exact hR
    · rintro ⟨cs, es, p, h, he, hR⟩
      cases he
      refine ⟨cs.map (Tree.mapCol (shiftVal r d)), es.map (fun x => (shiftVal r d x.1, Tree.map (shiftVal r d) x.2)),
        shiftVal r d p, shift r d h, ?_, (routeOK_shift_D3 r d k h).2 hR⟩
      simp [shift, Tree.map, treeMapCols_eq_map, treeMapCol_eq_map]

theorem routeNum_shift_D3 (r d : Nat) : ∀ (k : Nat) (F : Forest),
    routeNum_D3 k (shift r d F) = routeNum_D3 k F
  | 0, .node cols => by
    simp [routeNum_D3, shift, Tree.map, Tree.cols, treeMapCols_eq_map]
  | k + 1, .node cols => by
    simp only [routeNum_D3]
    have hlen : (shift r d (.node cols)).cols.length = (Tree.node cols).cols.length := by
      simp [shift, Tree.map, Tree.cols, treeMapCols_eq_map]
    have hnext : nextLayer (shift r d (.node cols)) = shift r d (nextLayer (.node cols)) :=
      nextLayer_map_D3 _ _
    rw [hlen, hnext, routeNum_shift_D3 r d k]


theorem leftCount_succ_D3 (E : Forest) (k : Nat) :
    leftCount E (k + 1) = leftCount E k + (skipLayers E k).cols.length := by
  rw [leftCount_eq_sum, leftCount_eq_sum, List.range_succ, List.map_append, List.sum_append]
  simp

theorem stop_route_D3 {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    ∀ i, i ≤ sd.depth → RouteOK_D3 i (skipLayers E (sd.depth - i)) ∧
      leftCount E (sd.depth - i) + routeNum_D3 i (skipLayers E (sd.depth - i)) = sd.t := by
  obtain ⟨h1, h2, h3, h4, h5, -, h7, -⟩ := stopData_core h
  intro i hi
  induction i with
  | zero =>
    simp only [Nat.sub_zero, RouteOK_D3, routeNum_D3]
    refine ⟨fun he => by rw [he] at h1; simp at h1, ?_⟩
    rw [h3, ← h7]; simp only [ColAddr.num]; omega
  | succ i ih =>
    obtain ⟨ih1, ih2⟩ := ih (by omega)
    obtain ⟨col, p, hc, hp, -, -⟩ := h5 (sd.depth - (i + 1)) (by omega)
    obtain ⟨cs, hcs⟩ := List.getLast?_eq_some_iff.1 hc
    obtain ⟨es, hes⟩ := List.getLast?_eq_some_iff.1 hp
    have hk : sd.depth - (i + 1) + 1 = sd.depth - i := by omega
    rw [hk] at hes
    have hF : skipLayers E (sd.depth - (i + 1)) = .node (cs ++ [es ++ [(p, skipLayers E (sd.depth - i))]]) := by
      rw [← hes, ← hcs]; cases skipLayers E (sd.depth - (i + 1)); rfl
    refine ⟨⟨cs, es, p, _, hF, ih1⟩, ?_⟩
    simp only [routeNum_D3]
    rw [hF, nextLayer_snoc_D3, ← hF]
    have := leftCount_succ_D3 E (sd.depth - (i + 1))
    rw [hk] at this
    omega

theorem stop_route_top_D3 {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    RouteOK_D3 sd.depth E ∧ routeNum_D3 sd.depth E = sd.t := by
  have := stop_route_D3 h sd.depth le_rfl
  simpa [skipLayers, leftCount] using this

theorem stop_pathSum_D3 {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    ∀ k, k ≤ sd.depth → ((sd.col.path.take k).map (·.1 + 1)).sum = leftCount E k := by
  obtain ⟨-, h2, -, -, h5, -⟩ := stopData_core h
  intro k hk
  induction k with
  | zero => simp [leftCount]
  | succ k ih =>
    obtain ⟨col, p, hc, -, -, hpk⟩ := h5 k (by omega)
    rw [List.take_add_one, hpk, leftCount_succ_D3, ← ih (by omega)]
    have hne : (skipLayers E k).cols ≠ [] := by intro he; rw [he] at hc; simp at hc
    have : 0 < (skipLayers E k).cols.length := List.length_pos_iff.2 hne
    simp; omega

theorem root_facts_D3 {E : Forest} {sd : StopData} {rd : RootData} (hsd : stopData E = some sd)
    (hrd : rootData E = some rd) :
    rd.layer ≤ sd.depth ∧ E.forestAt rd.col.path = some (skipLayers E rd.layer) ∧
      sd.r = leftCount E rd.layer + rd.idx ∧ rd.idx < (skipLayers E rd.layer).cols.length ∧
      (rd.owner = true ↔ rd.idx + 1 = (skipLayers E rd.layer).cols.length) ∧
      E.colAt rd.col = (skipLayers E rd.layer).cols[rd.idx]? := by
  obtain ⟨-, hlay, hidx, hnum, -, hmem, -, hown⟩ := rootData_spec hsd hrd
  obtain ⟨-, -, -, hpre, -⟩ := rootData_path hsd hrd
  have hle := rootData_layer_le hsd hrd
  have hpath : rd.col.path = sd.col.path.take rd.layer := by
    obtain ⟨t, ht⟩ := hpre
    rw [hlay, ← ht, List.take_left' rfl]
  have hfa : E.forestAt rd.col.path = some (skipLayers E rd.layer) := by
    rw [hpath]; exact skipLayers_of_stopData hsd hle
  have hcol : E.colAt rd.col = (skipLayers E rd.layer).cols[rd.idx]? := by
    simp [Tree.colAt, hfa, hidx]
  refine ⟨hle, hfa, ?_, ?_, ?_, hcol⟩
  · rw [← hnum]; simp only [ColAddr.num]
    rw [hpath, stop_pathSum_D3 hsd _ hle, hidx]; omega
  · have := (Tree.mem_colAddrs_iff E rd.col).1 hmem
    rw [hcol] at this
    by_contra hc
    rw [List.getElem?_eq_none (by omega)] at this
    simp at this
  · rw [hown, hidx]
    constructor
    · rintro ⟨F, hF, h⟩; rw [hfa] at hF; cases hF; exact h
    · intro h; exact ⟨_, hfa, h⟩


theorem body_route_D3 {E : Forest} {sd : StopData} {rd : RootData} (hsd : stopData E = some sd)
    (hrd : rootData E = some rd) (hown : rd.owner = false) :
    RouteOK_D3 (sd.depth - rd.layer) (.node ((skipLayers E rd.layer).cols.drop (rd.idx + 1))) ∧
      sd.r + 1 + routeNum_D3 (sd.depth - rd.layer)
        (.node ((skipLayers E rd.layer).cols.drop (rd.idx + 1))) = sd.t := by
  obtain ⟨hle, -, hr, hidx, howner, -⟩ := root_facts_D3 hsd hrd
  have hlt : rd.idx + 1 < (skipLayers E rd.layer).cols.length := by
    have : ¬ rd.idx + 1 = (skipLayers E rd.layer).cols.length := by
      rw [← howner, hown]; simp
    omega
  obtain ⟨hR, hN⟩ := stop_route_D3 hsd (sd.depth - rd.layer) (by omega)
  rw [show sd.depth - (sd.depth - rd.layer) = rd.layer by omega] at hR hN
  generalize skipLayers E rd.layer = G at *
  generalize hi : sd.depth - rd.layer = i at hR hN ⊢
  cases i with
  | zero =>
    refine ⟨?_, ?_⟩
    · show G.cols.drop (rd.idx + 1) ≠ []
      intro h; rw [List.drop_eq_nil_iff] at h; omega
    · show sd.r + 1 + ((G.cols.drop (rd.idx + 1)).length - 1) = sd.t
      simp only [routeNum_D3] at hN
      rw [List.length_drop]; omega
  | succ i =>
    obtain ⟨cs, es, p, h, rfl, hR'⟩ := hR
    simp only [Tree.cols, List.length_append, List.length_singleton] at hlt
    have hdrop : (cs ++ [es ++ [(p, h)]]).drop (rd.idx + 1) =
        cs.drop (rd.idx + 1) ++ [es ++ [(p, h)]] := List.drop_append_of_le_length (by omega)
    simp only [Tree.cols, hdrop]
    refine ⟨⟨_, _, _, _, rfl, hR'⟩, ?_⟩
    simp only [routeNum_D3, nextLayer_snoc_D3, Tree.cols, List.length_append, List.length_singleton,
      List.length_drop] at hN ⊢
    omega

theorem owner_route_D3 {E : Forest} {sd : StopData} {rd : RootData} (hsd : stopData E = some sd)
    (hrd : rootData E = some rd) (hown : rd.owner = true) :
    ∃ es p h, E.colAt rd.col = some (es ++ [(p, h)]) ∧
      RouteOK_D3 (sd.depth - rd.layer - 1) h ∧
      sd.r + 1 + routeNum_D3 (sd.depth - rd.layer - 1) h = sd.t := by
  obtain ⟨hle, -, hr, hidx, howner, hcol⟩ := root_facts_D3 hsd hrd
  have hlt := rootData_layer_lt hsd hrd hown
  have hidx' := howner.1 hown
  obtain ⟨hR, hN⟩ := stop_route_D3 hsd (sd.depth - rd.layer) (by omega)
  rw [show sd.depth - (sd.depth - rd.layer) = rd.layer by omega] at hR hN
  obtain ⟨i, hi⟩ : ∃ i, sd.depth - rd.layer = i + 1 := ⟨sd.depth - rd.layer - 1, by omega⟩
  rw [hi] at hR hN
  obtain ⟨cs, es, p, h, hG, hR'⟩ := hR
  rw [hG] at hidx' hN hcol
  simp only [Tree.cols, List.length_append, List.length_singleton] at hidx'
  refine ⟨es, p, h, ?_, by rw [hi]; exact hR', ?_⟩
  · rw [hcol]; simp [Tree.cols, show rd.idx = cs.length by omega]
  · simp only [routeNum_D3, nextLayer_snoc_D3, Tree.cols, List.length_append,
      List.length_singleton] at hN
    rw [show sd.depth - rd.layer - 1 = i by omega]
    omega

theorem vcol_shift_D3 {b : Nat} {col : Column} (h : VCol_D3 b col) (r d : Nat) :
    VCol_D3 (b + d) (Tree.mapCol (shiftVal r d) col) := by
  rw [treeMapCol_eq_map]
  intro x hx
  obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx
  obtain ⟨h1, h2⟩ := h y hy
  refine ⟨lt_of_le_of_lt (shiftVal_le_D3 r d y.1) (by omega), ?_⟩
  have := vrel_shift_D3 h2 r d
  rwa [show b + 1 + d = b + d + 1 by omega] at this

theorem vcol_shiftH_D3 {b b' : Nat} {col : Column} (h : VCol_D3 b col) (hb : b ≤ b') (r d : Nat)
    (hd : b' = b + d) :
    VCol_D3 b' (col.map fun x => (x.1, shift r d x.2)) := by
  intro x hx
  obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx
  obtain ⟨h1, h2⟩ := h y hy
  refine ⟨by simp; omega, ?_⟩
  have := vrel_shift_D3 h2 r d
  rwa [show b + 1 + d = b' + 1 by omega] at this

theorem vcol_sub_D3 {b : Nat} {l l' : Column} (h : VCol_D3 b l) (hs : ∀ x ∈ l', x ∈ l) :
    VCol_D3 b l' := fun x hx => h x (hs x hx)

/-- Step `k` of the ordinary loop keeps relative V, one phase down. -/
theorem vrel_ordStep_D3 {sd : StopData} {rd : RootData} {F : Forest} {U : Column} {k : Nat}
    {Z : Forest} (hk : 1 ≤ k) (hrt : sd.r < sd.t) (hQ : VCol_D3 sd.t sd.Q) (hU : VCol_D3 sd.r U)
    (hbody : rd.owner = false →
      RouteOK_D3 (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) ∧
      VRel_D3 (sd.r + 1) (.node (F.cols.drop (rd.idx + 1))) ∧
      sd.r + 1 + routeNum_D3 (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) = sd.t)
    (howner : rd.owner = true → ∀ x, U.getLast? = some x →
      RouteOK_D3 (sd.depth - rd.layer - 1) x.2 ∧
      sd.r + 1 + routeNum_D3 (sd.depth - rd.layer - 1) x.2 = sd.t)
    (hZ : VRel_D3 (sd.t + k * (sd.t - sd.r)) Z) :
    VRel_D3 (sd.r + k * (sd.t - sd.r)) (ordStep sd rd F U k Z) := by
  have key : sd.t + (k - 1) * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) := by
    obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
    simp only [Nat.add_sub_cancel, Nat.succ_mul]; omega
  have hQ' : VCol_D3 (sd.r + k * (sd.t - sd.r))
      (Tree.mapCol (shiftVal sd.r ((k - 1) * (sd.t - sd.r))) sd.Q) := by
    rw [← key]; exact vcol_shift_D3 hQ _ _
  have hU' : ∀ l : Column, (∀ x ∈ l, x ∈ U) → VCol_D3 (sd.r + k * (sd.t - sd.r))
      (l.map fun x => (x.1, shift sd.r (k * (sd.t - sd.r)) x.2)) :=
    fun l hl => vcol_shiftH_D3 (vcol_sub_D3 hU hl) (by omega) _ _ rfl
  unfold ordStep
  simp only
  split
  · rename_i hown
    rw [vrel_iff_vcols_D3, vcols_single_D3, vcol_append_D3, vcol_append_D3]
    refine ⟨⟨hQ', hU' _ (fun x hx => List.mem_of_mem_dropLast hx)⟩, ?_⟩
    intro x hx
    cases hl : U.getLast? with
    | none => simp [hl] at hx
    | some u =>
      simp only [hl, Option.map_some, Option.toList_some, List.mem_singleton] at hx
      subst hx
      have hu : u ∈ U := List.mem_of_getLast? hl
      obtain ⟨hR, hN⟩ := howner hown u hl
      refine ⟨by simp; exact lt_of_lt_of_le (hU u hu).1 (by omega), ?_⟩
      simp only
      rw [Hole.fill_eq_put]
      refine vrel_put_D3 Z _ _ _ ((routeOK_shift_D3 _ _ _ _).2 hR) ?_ ?_
      · have := vrel_shift_D3 (hU u hu).2 sd.r (k * (sd.t - sd.r))
        rwa [show sd.r + 1 + k * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) + 1 by omega] at this
      · rw [routeNum_shift_D3]
        rwa [show sd.r + k * (sd.t - sd.r) + 1 + routeNum_D3 (sd.depth - rd.layer - 1) u.2 =
          sd.t + k * (sd.t - sd.r) by omega]
  · rename_i hown
    have hown' : rd.owner = false := by simpa using hown
    obtain ⟨hR, hB, hN⟩ := hbody hown'
    rw [vrel_iff_vcols_D3, vcols_cons_D3, vcol_append_D3, ← vrel_eq_vcols_D3]
    refine ⟨⟨hQ', hU' U (fun x hx => hx)⟩, ?_⟩
    rw [Hole.fill_eq_put]
    refine vrel_put_D3 Z _ _ _ ((routeOK_shift_D3 _ _ _ _).2 hR) ?_ ?_
    · have := vrel_shift_D3 hB sd.r (k * (sd.t - sd.r))
      rwa [show sd.r + 1 + k * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) + 1 by omega] at this
    · rw [routeNum_shift_D3]
      rwa [show sd.r + k * (sd.t - sd.r) + 1 + routeNum_D3 (sd.depth - rd.layer)
        (.node (F.cols.drop (rd.idx + 1))) = sd.t + k * (sd.t - sd.r) by omega]

theorem ordLoop_induct_D3 {step : Nat → Forest → Forest} {P : Nat → Forest → Prop}
    (hstep : ∀ k Z, 1 ≤ k → P k Z → P (k - 1) (step k Z)) :
    ∀ m Z, P m Z → P 0 (ordLoop step m Z)
  | 0, Z, h => h
  | m + 1, Z, h => ordLoop_induct_D3 hstep m _ (by simpa using hstep (m + 1) Z (by omega) h)


theorem ne_empty_of_stepKind_D3 {E : Forest} {k : StepKind} (h : stepKind E = some k) :
    E ≠ Tree.empty := by
  rintro rfl; simp [stepKind, stepKindBody, Tree.empty, Tree.cols] at h

/-- The ordinary output, unfolded: `B = A_{0,0,ℓ,Z}(A)` with `Z = ordZ A sd rd n`. -/
theorem ord_output_D3 {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .ordinary)
    (hB : expand A n = some B) :
    ∃ sd rd, stopData A = some sd ∧ rootData A = some rd ∧
      B = replaceAt 0 0 (ordZ A sd rd n) sd.depth A ∧
      ¬ (rd.owner = true ∧ n ≠ 0 ∧ ((A.colAt rd.col).getD []).drop rd.cursor = []) := by
  obtain ⟨sd, hsd⟩ := Option.isSome_iff_exists.mp (stopData_of_stepKind hk (by decide))
  obtain ⟨rd, hrd⟩ := Option.isSome_iff_exists.mp (rootData_of_ordinary hk)
  rw [expand_eq_paperOp (ne_empty_of_stepKind_D3 hk) hL.1 hL.2.1, paperOp_ordinary hk hsd hrd] at hB
  refine ⟨sd, rd, hsd, hrd, ?_⟩
  split at hB
  · cases hB
  · rename_i hc
    cases hB
    refine ⟨rfl, ?_⟩
    rintro ⟨h1, h2, h3⟩
    apply hc
    simp [h1, h2, h3]

/-- The data of an ordinary step used by the structural closure proofs. -/
theorem ord_vdata_D3 {A : Forest} {sd : StopData} {rd : RootData} (hV : CondV A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) :
    let F := (A.forestAt rd.col.path).getD Tree.empty
    let U := ((A.colAt rd.col).getD []).drop rd.cursor
    sd.r < sd.t ∧ VCol_D3 sd.t sd.Q ∧ VCol_D3 sd.r U ∧
    (rd.owner = false →
      RouteOK_D3 (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) ∧
      VRel_D3 (sd.r + 1) (.node (F.cols.drop (rd.idx + 1))) ∧
      sd.r + 1 + routeNum_D3 (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) = sd.t) ∧
    (rd.owner = true → ∀ x, U.getLast? = some x →
      RouteOK_D3 (sd.depth - rd.layer - 1) x.2 ∧
      sd.r + 1 + routeNum_D3 (sd.depth - rd.layer - 1) x.2 = sd.t) := by
  intro F U
  have hA := (condV_iff_vrel_D3 A).1 hV
  obtain ⟨-, -, hidx, hnum, hrt, hmem, -, -⟩ := rootData_spec hsd hrd
  obtain ⟨hle, hfa, hr, -, -, -⟩ := root_facts_D3 hsd hrd
  obtain ⟨hcolsd, -, ht, -⟩ := stopData_spec hsd
  have hF : F = skipLayers A rd.layer := by simp [F, hfa]
  refine ⟨hrt, ?_, ?_, ?_, ?_⟩
  · have := vrel_colAt_D3 hA hcolsd
    rw [ht]; exact ((vcol_append_D3 _ _ _).1 this).1
  · obtain ⟨R, hR⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff A rd.col).1 hmem)
    have := vrel_colAt_D3 hA hR
    rw [show rd.col.num 0 = sd.r from hnum] at this
    simp only [U, hR, Option.getD_some]
    exact vcol_sub_D3 this (fun x hx => List.mem_of_mem_drop hx)
  · intro hown
    obtain ⟨h1, h2⟩ := body_route_D3 hsd hrd hown
    rw [hF]
    refine ⟨h1, ?_, h2⟩
    have hG := vrel_forestAt_D3 hA hfa
    have hsum : (rd.col.path.map (·.1 + 1)).sum = leftCount A rd.layer := by
      have : rd.col.num 0 = (rd.col.path.map (·.1 + 1)).sum + rd.col.col := by
        simp [ColAddr.num]
      omega
    rw [Nat.zero_add, hsum] at hG
    rw [vrel_eq_vcols_D3] at hG
    rw [vrel_iff_vcols_D3]
    have := vcols_drop_D3 hG (rd.idx + 1)
    rwa [show leftCount A rd.layer + (rd.idx + 1) = sd.r + 1 by omega] at this
  · intro hown x hx
    obtain ⟨es, p, h, hc, h1, h2⟩ := owner_route_D3 hsd hrd hown
    have hx' : x = (p, h) := by
      simp only [U, hc, Option.getD_some, List.getLast?_drop] at hx
      split at hx
      · cases hx
      · simp at hx; exact hx.symm
    subst hx'
    exact ⟨h1, h2⟩


/-! ### Relative condition I -/

theorem Tree.treeMapCol_append_D3 (f : Nat → Nat) (l₁ l₂ : Column) :
    Tree.mapCol f (l₁ ++ l₂) = Tree.mapCol f l₁ ++ Tree.mapCol f l₂ := by
  simp [treeMapCol_eq_map]

/-- The column's first parent is at least the host (vacuous without a host). -/
def FirstOK_D3 (host : Option Nat) (col : Column) : Prop :=
  ∀ a, host = some a → ∃ q H rest, col = (q, H) :: rest ∧ a ≤ q

/-- The host number of column `c` (the outer host `host` at top level). -/
def hostNum_D3 (b : Nat) (host : Option Nat) (c : ColAddr) : Option Nat :=
  match c.path.getLast? with
  | none => host
  | some x => some (ColAddr.num b ⟨c.path.dropLast, x.1⟩)

/-- Relative condition I: every column's first parent is at least its host. -/
def IRel_D3 (b : Nat) (host : Option Nat) (F : Forest) : Prop :=
  ∀ c col, F.colAt c = some col → FirstOK_D3 (hostNum_D3 b host c) col

def ICols_D3 (b : Nat) (host : Option Nat) (cols : List Column) : Prop :=
  ∀ (j : Nat) (col : Column), cols[j]? = some col →
    FirstOK_D3 host col ∧ ∀ x ∈ col, IRel_D3 (b + j + 1) (some (b + j)) x.2

theorem hostNum_nil_D3 (b : Nat) (host : Option Nat) (k : Nat) :
    hostNum_D3 b host ⟨[], k⟩ = host := rfl

theorem hostNum_cons_D3 (b : Nat) (host : Option Nat) (j m : Nat) (P : List (Nat × Nat)) (k : Nat) :
    hostNum_D3 b host ⟨(j, m) :: P, k⟩ = hostNum_D3 (b + j + 1) (some (b + j)) ⟨P, k⟩ := by
  rcases List.eq_nil_or_concat' P with rfl | ⟨P', x, rfl⟩
  · simp [hostNum_D3, ColAddr.num]
  · simp only [hostNum_D3, ← List.cons_append, List.getLast?_append, List.getLast?_singleton,
      Option.some_or, List.dropLast_concat]
    rw [num_cons_D3]

theorem colAt_nil_D3 (cols : List Column) (k : Nat) :
    (Tree.node cols).colAt ⟨[], k⟩ = cols[k]? := rfl

theorem colAt_cons_D3 (cols : List Column) (j m : Nat) (P : List (Nat × Nat)) (k : Nat) :
    (Tree.node cols).colAt ⟨(j, m) :: P, k⟩ =
      ((cols[j]?).bind (·[m]?)).bind fun x => x.2.colAt ⟨P, k⟩ :=
  Tree.colAt_cons _ _ _ _ _

theorem irel_iff_icols_D3 (b : Nat) (host : Option Nat) (cols : List Column) :
    IRel_D3 b host (.node cols) ↔ ICols_D3 b host cols := by
  constructor
  · intro hI j col hj
    refine ⟨by simpa [hostNum_nil_D3] using hI ⟨[], j⟩ col (by rw [colAt_nil_D3]; exact hj), ?_⟩
    intro x hx c col' hc
    obtain ⟨m, hm⟩ := List.getElem?_of_mem hx
    obtain ⟨P, k⟩ := c
    have := hI ⟨(j, m) :: P, k⟩ col' (by rw [colAt_cons_D3, hj]; simp [hm, hc])
    rwa [hostNum_cons_D3] at this
  · intro hI c col hc
    obtain ⟨P, k⟩ := c
    cases P with
    | nil =>
      rw [colAt_nil_D3] at hc
      rw [hostNum_nil_D3]; exact (hI k col hc).1
    | cons ab P =>
      obtain ⟨j, m⟩ := ab
      rw [colAt_cons_D3] at hc
      cases hcj : cols[j]? with
      | none => simp [hcj] at hc
      | some cj =>
        cases hm : cj[m]? with
        | none => simp [hcj, hm] at hc
        | some x =>
          simp only [hcj, hm, Option.bind_some] at hc
          rw [hostNum_cons_D3]
          exact (hI j cj hcj).2 x (List.mem_of_getElem? hm) _ col hc

theorem irel_eq_icols_D3 (b : Nat) (host : Option Nat) (F : Forest) :
    IRel_D3 b host F ↔ ICols_D3 b host F.cols := by
  obtain ⟨cols⟩ := F; exact irel_iff_icols_D3 b host cols

theorem condI_iff_irel_D3 (E : Forest) : CondI E ↔ IRel_D3 0 none E := by
  constructor
  · intro hI c col hc a ha
    obtain ⟨P, k⟩ := c
    rcases List.eq_nil_or_concat' P with rfl | ⟨π, x, rfl⟩
    · simp [hostNum_D3] at ha
    obtain ⟨ci, ei⟩ := x
    simp only [hostNum_D3, List.getLast?_concat, List.dropLast_concat, Option.some.injEq] at ha
    subst ha
    have hfa : E.forestAt (π ++ [(ci, ei)]) = E.heightAt ⟨⟨π, ci⟩, ei⟩ :=
      Tree.forestAt_heightPath E ⟨⟨π, ci⟩, ei⟩
    cases hh : E.heightAt ⟨⟨π, ci⟩, ei⟩ with
    | none => simp [Tree.colAt, hfa, hh] at hc
    | some h =>
      simp only [Tree.colAt, hfa, hh, Option.bind_some] at hc
      obtain ⟨p, hp⟩ : ∃ p, E.entryAt ⟨⟨π, ci⟩, ei⟩ = some (p, h) := by
        simp only [Tree.heightAt] at hh
        cases he : E.entryAt ⟨⟨π, ci⟩, ei⟩ with
        | none => simp [he] at hh
        | some y => simp [he] at hh; exact ⟨y.1, by rw [← hh]⟩
      have hne : h ≠ Tree.empty := by
        rintro rfl; simp [Tree.empty, Tree.cols] at hc
      exact hI _ ((Tree.mem_entryAddrs_iff E _).2 (by rw [hp]; rfl)) p h hp hne col
        (List.mem_of_getElem? hc)
  · intro hI e _ p h he hne col hcol
    obtain ⟨k, hk⟩ := List.getElem?_of_mem hcol
    have hc : E.colAt ⟨e.heightPath, k⟩ = some col := by
      simp only [Tree.colAt, Tree.forestAt_heightPath, Tree.heightAt, he, Option.map_some,
        Option.bind_some]
      exact hk
    have := hI _ col hc (e.col.num 0)
    apply this
    simp [hostNum_D3, EntryAddr.heightPath]

theorem firstOK_mono_D3 {a a' : Nat} (h : a' ≤ a) {col : Column} (hc : FirstOK_D3 (some a) col) :
    FirstOK_D3 (some a') col := by
  intro x hx; cases hx
  obtain ⟨q, H, rest, rfl, hq⟩ := hc a rfl
  exact ⟨q, H, rest, rfl, le_trans h hq⟩

theorem firstOK_none_D3 (col : Column) : FirstOK_D3 none col := by
  intro a ha; cases ha

theorem firstOK_shift_D3 {host : Option Nat} {col : Column} (h : FirstOK_D3 host col) (r d : Nat) :
    FirstOK_D3 (host.map (shiftVal r d)) (Tree.mapCol (shiftVal r d) col) := by
  intro a ha
  cases host with
  | none => cases ha
  | some a0 =>
    simp only [Option.map_some, Option.some.injEq] at ha; subst ha
    obtain ⟨q, H, rest, rfl, hq⟩ := h a0 rfl
    exact ⟨_, _, _, rfl, shiftVal_mono_D3 r d hq⟩

/-- `FirstOK` reads only the first parent. -/
theorem firstOK_of_fst_D3 {host : Option Nat} {col col' : Column} (h : FirstOK_D3 host col)
    (hfst : ∀ x, col.head? = some x → ∃ y, col'.head? = some y ∧ y.1 = x.1) :
    FirstOK_D3 host col' := by
  intro a ha
  obtain ⟨q, H, rest, rfl, hq⟩ := h a ha
  obtain ⟨y, hy, hyq⟩ := hfst _ rfl
  cases col' with
  | nil => simp at hy
  | cons y' ys => simp at hy; subst hy; exact ⟨y'.1, y'.2, ys, rfl, by rw [hyq]; exact hq⟩

theorem hostNum_shift_D3 {b r : Nat} (hrb : r ≤ b) (d : Nat) (host : Option Nat) (c : ColAddr) :
    hostNum_D3 (b + d) (host.map (shiftVal r d)) c = (hostNum_D3 b host c).map (shiftVal r d) := by
  simp only [hostNum_D3]
  cases c.path.getLast? with
  | none => rfl
  | some x =>
    simp only [Option.map_some, Option.some.injEq]
    rw [num_add_D3]
    have : b ≤ ColAddr.num b ⟨c.path.dropLast, x.1⟩ := by simp only [ColAddr.num]; omega
    unfold shiftVal; rw [if_pos (by omega)]

theorem irel_shift_D3 {b : Nat} {host : Option Nat} {F : Forest} (h : IRel_D3 b host F) {r : Nat}
    (hrb : r ≤ b) (d : Nat) : IRel_D3 (b + d) (host.map (shiftVal r d)) (shift r d F) := by
  intro c col hc
  rw [shift, colAt_map_D3] at hc
  cases h' : F.colAt c with
  | none => simp [h'] at hc
  | some col0 =>
    simp only [h', Option.map_some, Option.some.injEq] at hc
    subst hc
    rw [hostNum_shift_D3 hrb]
    exact firstOK_shift_D3 (h c col0 h') r d

theorem irel_empty_D3 (b : Nat) (host : Option Nat) : IRel_D3 b host Tree.empty := by
  intro c col hc
  obtain ⟨P, k⟩ := c
  cases P with
  | nil => simp [Tree.colAt, Tree.forestAt, Tree.empty, Tree.cols] at hc
  | cons ab P => simp [Tree.colAt, Tree.forestAt, Tree.empty, Tree.cols] at hc

theorem icols_nil_D3 (b : Nat) (host : Option Nat) : ICols_D3 b host [] := by
  intro j col hj; simp at hj

theorem icols_cons_D3 (b : Nat) (host : Option Nat) (c : Column) (cs : List Column) :
    ICols_D3 b host (c :: cs) ↔
      (FirstOK_D3 host c ∧ ∀ x ∈ c, IRel_D3 (b + 1) (some b) x.2) ∧ ICols_D3 (b + 1) host cs := by
  constructor
  · intro h
    refine ⟨by simpa using h 0 c rfl, fun j col hj => ?_⟩
    have := h (j + 1) col (by simpa using hj)
    rwa [show b + (j + 1) = b + 1 + j by omega] at this
  · rintro ⟨h1, h2⟩ j col hj
    cases j with
    | zero => simp at hj; subst hj; simpa using h1
    | succ j =>
      have := h2 j col (by simpa using hj)
      rw [show b + (j + 1) = b + 1 + j by omega]; exact this

theorem icols_append_D3 (b : Nat) (host : Option Nat) (cs ds : List Column) :
    ICols_D3 b host (cs ++ ds) ↔ ICols_D3 b host cs ∧ ICols_D3 (b + cs.length) host ds := by
  induction cs generalizing b with
  | nil => simp [icols_nil_D3]
  | cons c cs ih =>
    rw [List.cons_append, icols_cons_D3, icols_cons_D3, ih]
    simp only [List.length_cons, show b + 1 + cs.length = b + (cs.length + 1) by omega, and_assoc]

theorem icols_single_D3 (b : Nat) (host : Option Nat) (c : Column) :
    ICols_D3 b host [c] ↔ FirstOK_D3 host c ∧ ∀ x ∈ c, IRel_D3 (b + 1) (some b) x.2 := by
  rw [icols_cons_D3]; simp [icols_nil_D3]

theorem icols_drop_D3 {b : Nat} {host : Option Nat} {cols : List Column}
    (h : ICols_D3 b host cols) (k : Nat) : ICols_D3 (b + k) host (cols.drop k) := by
  intro j col hj
  rw [List.getElem?_drop] at hj
  have := h (k + j) col hj
  rwa [show b + (k + j) = b + k + j by omega] at this

/-- The host of the route forest at depth `k`. -/
def routeHost_D3 : Nat → Option Nat → Nat → Forest → Option Nat
  | _, host, 0, _ => host
  | b, _, k + 1, F => routeHost_D3 (b + F.cols.length) (some (b + (F.cols.length - 1))) k (nextLayer F)

theorem irel_put_D3 (Z : Forest) : ∀ (k : Nat) (F : Forest) (b : Nat) (host : Option Nat),
    RouteOK_D3 k F → IRel_D3 b host F →
    IRel_D3 (b + routeNum_D3 k F) (routeHost_D3 b host k F) Z →
    IRel_D3 b host (replaceAt 0 0 Z k F)
  | 0, .node cols, b, host, hR, hF, hZ => by
    have hc : cols ≠ [] := hR
    rw [put_zero_D3 Z hc]
    obtain ⟨zc⟩ := Z
    simp only [routeNum_D3, routeHost_D3, Tree.cols] at hZ ⊢
    rw [irel_iff_icols_D3] at hF hZ ⊢
    have hlen : (cols.dropLast).length = cols.length - 1 := List.length_dropLast
    rw [icols_append_D3, hlen]
    refine ⟨?_, hZ⟩
    have := (List.dropLast_append_getLast hc)
    rw [← this, icols_append_D3] at hF
    exact hF.1
  | k + 1, F, b, host, hR, hF, hZ => by
    obtain ⟨cs, es, q, H, rfl, hR'⟩ := hR
    rw [put_succ_D3]
    simp only [routeNum_D3, routeHost_D3, nextLayer_snoc_D3, Tree.cols, List.length_append,
      List.length_singleton] at hZ
    rw [irel_iff_icols_D3, icols_append_D3, icols_single_D3] at hF ⊢
    obtain ⟨hF1, hF2, hF3⟩ := hF
    refine ⟨hF1, ?_, ?_⟩
    · refine firstOK_of_fst_D3 hF2 ?_
      intro x hx
      cases es with
      | nil => simp at hx; subst hx; exact ⟨_, rfl, rfl⟩
      | cons e es => simp at hx; subst hx; exact ⟨_, rfl, rfl⟩
    · intro x hx
      rw [List.mem_append, List.mem_singleton] at hx
      rcases hx with hx | rfl
      · exact hF3 x (List.mem_append_left _ hx)
      · refine irel_put_D3 Z k H _ _ hR' (hF3 (q, H) (by simp)) ?_
        have e1 : b + cs.length + 1 + routeNum_D3 k H = b + (cs.length + 1 + routeNum_D3 k H) := by
          omega
        have e2 : b + cs.length + 1 - 1 = b + cs.length := by omega
        rw [e1]
        convert hZ using 2
        · omega
        · rw [show b + (cs.length + 1 - 1) = b + cs.length by omega]


theorem routeHost_split_D3 : ∀ (k1 k2 b : Nat) (h : Option Nat) (F : Forest),
    routeHost_D3 b h (k1 + k2) F =
      routeHost_D3 (b + leftCount F k1) (routeHost_D3 b h k1 F) k2 (skipLayers F k1)
  | 0, k2, b, h, F => by simp [routeHost_D3, leftCount, skipLayers]
  | k1 + 1, k2, b, h, F => by
    rw [show k1 + 1 + k2 = (k1 + k2) + 1 by omega]
    simp only [routeHost_D3, leftCount, skipLayers]
    rw [routeHost_split_D3 k1 k2]
    congr 1; omega

theorem routeHost_shiftBase_D3 (δ : Nat) : ∀ (k b : Nat) (X : Option Nat) (F : Forest),
    routeHost_D3 (b + δ) (X.map (· + δ)) k F = (routeHost_D3 b X k F).map (· + δ)
  | 0, b, X, F => rfl
  | k + 1, b, X, F => by
    simp only [routeHost_D3]
    have := routeHost_shiftBase_D3 δ k (b + F.cols.length) (some (b + (F.cols.length - 1)))
      (nextLayer F)
    simp only [Option.map_some] at this
    rw [show b + δ + F.cols.length = b + F.cols.length + δ by omega,
      show b + δ + (F.cols.length - 1) = b + (F.cols.length - 1) + δ by omega]
    exact this

theorem routeHost_shift_D3 (r d : Nat) : ∀ (k b : Nat) (X : Option Nat) (F : Forest),
    routeHost_D3 b X k (shift r d F) = routeHost_D3 b X k F
  | 0, b, X, F => rfl
  | k + 1, b, X, F => by
    simp only [routeHost_D3]
    have hlen : (shift r d F).cols.length = F.cols.length := by
      obtain ⟨cols⟩ := F; simp [shift, Tree.map, Tree.cols, treeMapCols_eq_map]
    rw [hlen, show nextLayer (shift r d F) = shift r d (nextLayer F) from nextLayer_map_D3 _ _,
      routeHost_shift_D3 r d k]

theorem routeHost_bound_D3 : ∀ (k b : Nat) (h : Option Nat) (F : Forest) (a : Nat),
    RouteOK_D3 k F → routeHost_D3 b h k F = some a →
      h = some a ∨ (b ≤ a ∧ a < b + leftCount F k)
  | 0, b, h, F, a, _, hh => Or.inl hh
  | k + 1, b, h, F, a, hR, hh => by
    obtain ⟨cs, es, p, H, rfl, hR'⟩ := hR
    simp only [routeHost_D3, nextLayer_snoc_D3, Tree.cols, List.length_append,
      List.length_singleton] at hh
    rcases routeHost_bound_D3 k _ _ H a hR' hh with h1 | ⟨h1, h2⟩
    · simp at h1
      right; simp only [leftCount, Tree.cols, List.length_append, List.length_singleton]; omega
    · right; simp only [leftCount, Tree.cols, List.length_append, List.length_singleton,
        nextLayer_snoc_D3]
      omega

theorem routeOK_le_D3 : ∀ (k : Nat) (F : Forest) (j : Nat), RouteOK_D3 k F → j ≤ k → RouteOK_D3 j F
  | 0, F, j, h, hj => by rw [show j = 0 by omega]; exact h
  | k + 1, F, 0, h, _ => by
    obtain ⟨cs, es, p, H, rfl, -⟩ := h
    simp [RouteOK_D3, Tree.cols]
  | k + 1, F, j + 1, h, hj => by
    obtain ⟨cs, es, p, H, rfl, hR'⟩ := h
    exact ⟨cs, es, p, H, rfl, routeOK_le_D3 k H j hR' (by omega)⟩

theorem leftCount_mono_D3 (E : Forest) {j k : Nat} (h : j ≤ k) : leftCount E j ≤ leftCount E k := by
  induction k with
  | zero => rw [show j = 0 by omega]
  | succ k ih =>
    rcases Nat.lt_or_ge j (k + 1) with hj | hj
    · rw [leftCount_succ_D3]; have := ih (by omega); omega
    · rw [show j = k + 1 by omega]

theorem irel_skip_D3 : ∀ (k b : Nat) (host : Option Nat) (F : Forest), RouteOK_D3 k F →
    IRel_D3 b host F → IRel_D3 (b + leftCount F k) (routeHost_D3 b host k F) (skipLayers F k)
  | 0, b, host, F, _, h => by simpa [leftCount, skipLayers, routeHost_D3] using h
  | k + 1, b, host, F, hR, h => by
    obtain ⟨cs, es, p, H, rfl, hR'⟩ := hR
    simp only [leftCount, skipLayers, routeHost_D3, nextLayer_snoc_D3, Tree.cols,
      List.length_append, List.length_singleton]
    rw [irel_iff_icols_D3, icols_append_D3, icols_single_D3] at h
    have hH := h.2.2 (p, H) (by simp)
    have := irel_skip_D3 k _ _ H hR' hH
    rw [show b + (cs.length + 1 + leftCount H k) = b + cs.length + 1 + leftCount H k by omega,
      show b + (cs.length + 1) = b + cs.length + 1 by omega,
      show b + (cs.length + 1 - 1) = b + cs.length by omega]
    exact this

theorem vrel_skip_D3 : ∀ (k b : Nat) (F : Forest), RouteOK_D3 k F →
    VRel_D3 b F → VRel_D3 (b + leftCount F k) (skipLayers F k)
  | 0, b, F, _, h => by simpa [leftCount, skipLayers] using h
  | k + 1, b, F, hR, h => by
    obtain ⟨cs, es, p, H, rfl, hR'⟩ := hR
    simp only [leftCount, skipLayers, nextLayer_snoc_D3, Tree.cols,
      List.length_append, List.length_singleton]
    rw [vrel_iff_vcols_D3, vcols_append_D3, vcols_single_D3] at h
    have hH := (h.2 (p, H) (by simp)).2
    have := vrel_skip_D3 k _ H hR' hH
    rwa [show b + cs.length + 1 + leftCount H k = b + (cs.length + 1 + leftCount H k) by omega]
      at this

theorem irel_host_mono_D3 {b : Nat} {h h' : Option Nat} {F : Forest} (hF : IRel_D3 b h F)
    (hh : ∀ a', h' = some a' → ∃ a, h = some a ∧ a' ≤ a) : IRel_D3 b h' F := by
  intro c col hc
  have := hF c col hc
  simp only [hostNum_D3] at this ⊢
  cases hl : c.path.getLast? with
  | none =>
    rw [hl] at this
    intro a' ha'
    obtain ⟨a, rfl, ha⟩ := hh a' ha'
    exact firstOK_mono_D3 ha this a' rfl
  | some x => rw [hl] at this; exact this


theorem firstOK_map_fst_D3 {host : Option Nat} {col : Column} (h : FirstOK_D3 host col)
    (g : Nat × Forest → Nat × Forest) (hg : ∀ x, (g x).1 = x.1) : FirstOK_D3 host (col.map g) :=
  firstOK_of_fst_D3 h (fun x hx => ⟨g x, by cases col <;> simp_all, hg x⟩)

theorem firstOK_append_D3 {host : Option Nat} {l₁ l₂ : Column} (h : FirstOK_D3 host l₁)
    (hne : l₁ ≠ []) : FirstOK_D3 host (l₁ ++ l₂) :=
  firstOK_of_fst_D3 h (fun x hx => ⟨x, by cases l₁ <;> simp_all, rfl⟩)

theorem head_mapLast_fst_D3 {col : Column}
    (f g : Nat × Forest → Nat × Forest) (hf : ∀ x, (f x).1 = x.1) (hg : ∀ x, (g x).1 = x.1) :
    ∀ x, col.head? = some x → ∃ y, (mapLast f g col).head? = some y ∧ y.1 = x.1 := by
  intro x hx
  match col, hx with
  | [y], hx => simp at hx; subst hx; exact ⟨g y, by simp [mapLast], hg y⟩
  | y :: z :: zs, hx => simp at hx; subst hx; exact ⟨f y, by simp [mapLast], hf y⟩

/-- Step `k` of the ordinary loop keeps relative I, one phase down. -/
theorem irel_ordStep_D3 {sd : StopData} {rd : RootData} {F : Forest} {U : Column} {k : Nat}
    {Z : Forest} {hostSd : Option Nat} (hk : 1 ≤ k) (hrt : sd.r < sd.t)
    (hlt : ∀ a, hostSd = some a → a < sd.t)
    (hQ1 : FirstOK_D3 hostSd (sd.Q ++ [(sd.r, Tree.empty)]))
    (hQ2 : ∀ x ∈ sd.Q, IRel_D3 (sd.t + 1) (some sd.t) x.2)
    (hU2 : ∀ x ∈ U, IRel_D3 (sd.r + 1) (some sd.r) x.2)
    (hQnil : sd.Q = [] → ∀ a, hostSd = some a → a < sd.r ∧ FirstOK_D3 (some a) U)
    (hbodyR : rd.owner = false →
      RouteOK_D3 (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) ∧
      sd.r + 1 + routeNum_D3 (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) = sd.t)
    (hbody0 : rd.owner = false → sd.depth - rd.layer = 0 →
      IRel_D3 (sd.r + 1) hostSd (.node (F.cols.drop (rd.idx + 1))) ∧
      ∀ a, hostSd = some a → a < sd.r)
    (hbody1 : rd.owner = false → 1 ≤ sd.depth - rd.layer →
      IRel_D3 (sd.r + 1) (some sd.r) (.node (F.cols.drop (rd.idx + 1))) ∧
      routeHost_D3 (sd.r + 1) (some sd.r) (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) =
        hostSd ∧ ∀ a, hostSd = some a → sd.r ≤ a)
    (hownerR : rd.owner = true → ∀ x, U.getLast? = some x →
      RouteOK_D3 (sd.depth - rd.layer - 1) x.2 ∧
      sd.r + 1 + routeNum_D3 (sd.depth - rd.layer - 1) x.2 = sd.t)
    (howner : rd.owner = true → ∀ x, U.getLast? = some x →
      routeHost_D3 (sd.r + 1) (some sd.r) (sd.depth - rd.layer - 1) x.2 = hostSd ∧
      ∀ a, hostSd = some a → sd.r ≤ a)
    (hZ : IRel_D3 (sd.t + k * (sd.t - sd.r)) (hostSd.map (shiftVal sd.r (k * (sd.t - sd.r)))) Z) :
    IRel_D3 (sd.r + k * (sd.t - sd.r)) (hostSd.map (shiftVal sd.r ((k - 1) * (sd.t - sd.r))))
      (ordStep sd rd F U k Z) := by
  have key : sd.t + (k - 1) * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) := by
    obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
    simp only [Nat.add_sub_cancel, Nat.succ_mul]; omega
  -- the head column's heights
  have hQh : ∀ x ∈ Tree.mapCol (shiftVal sd.r ((k - 1) * (sd.t - sd.r))) sd.Q,
      IRel_D3 (sd.r + k * (sd.t - sd.r) + 1) (some (sd.r + k * (sd.t - sd.r))) x.2 := by
    intro x hx
    rw [treeMapCol_eq_map] at hx
    obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx
    have := irel_shift_D3 (hQ2 y hy) (r := sd.r) (by omega) ((k - 1) * (sd.t - sd.r))
    simp only [Option.map_some] at this
    rw [show shiftVal sd.r ((k - 1) * (sd.t - sd.r)) sd.t = sd.t + (k - 1) * (sd.t - sd.r) by
      unfold shiftVal; rw [if_pos (by omega)]] at this
    rw [show sd.t + 1 + (k - 1) * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) + 1 by omega, key] at this
    exact this
  have hUh : ∀ x ∈ U, IRel_D3 (sd.r + k * (sd.t - sd.r) + 1) (some (sd.r + k * (sd.t - sd.r)))
      (shift sd.r (k * (sd.t - sd.r)) x.2) := by
    intro x hx
    have := irel_shift_D3 (hU2 x hx) (r := sd.r) (by omega) (k * (sd.t - sd.r))
    simp only [Option.map_some] at this
    rw [show shiftVal sd.r (k * (sd.t - sd.r)) sd.r = sd.r + k * (sd.t - sd.r) by
      unfold shiftVal; rw [if_pos le_rfl]] at this
    rwa [show sd.r + 1 + k * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) + 1 by omega] at this
  -- the head column's first parent
  have hfirst : ∀ (rest : Column), (∀ x, U.head? = some x → ∃ y, rest.head? = some y ∧ y.1 = x.1) →
      FirstOK_D3 (hostSd.map (shiftVal sd.r ((k - 1) * (sd.t - sd.r))))
        (Tree.mapCol (shiftVal sd.r ((k - 1) * (sd.t - sd.r))) sd.Q ++ rest) := by
    intro rest hrest
    by_cases hQ : sd.Q = []
    · rw [hQ]
      simp only [Tree.mapCol, List.nil_append]
      intro a ha
      cases hs : hostSd with
      | none => rw [hs] at ha; cases ha
      | some a0 =>
        rw [hs] at ha
        simp only [Option.map_some, Option.some.injEq] at ha
        obtain ⟨h1, h2⟩ := hQnil hQ a0 hs
        rw [show shiftVal sd.r ((k - 1) * (sd.t - sd.r)) a0 = a0 by
          unfold shiftVal; rw [if_neg (by omega)]] at ha
        subst ha
        exact firstOK_of_fst_D3 h2 hrest a0 rfl
    · have h1 := firstOK_shift_D3 hQ1 sd.r ((k - 1) * (sd.t - sd.r))
      rw [Tree.treeMapCol_append_D3] at h1
      have hne : Tree.mapCol (shiftVal sd.r ((k - 1) * (sd.t - sd.r))) sd.Q ≠ [] := by
        rw [treeMapCol_eq_map]; simpa using hQ
      refine firstOK_of_fst_D3 h1 (fun x hx => ⟨x, ?_, rfl⟩)
      cases hq : Tree.mapCol (shiftVal sd.r ((k - 1) * (sd.t - sd.r))) sd.Q with
      | nil => exact absurd hq hne
      | cons y ys => rw [hq] at hx; simp at hx ⊢; exact hx
  unfold ordStep
  simp only
  split
  · rename_i hown
    rw [irel_iff_icols_D3, icols_single_D3]
    refine ⟨?_, ?_⟩
    · rw [List.append_assoc]
      refine hfirst _ (fun x hx => ?_)
      have e := mapLast_eq (fun x : Nat × Forest => (x.1, shift sd.r (k * (sd.t - sd.r)) x.2))
        (fun x : Nat × Forest => (x.1, Hole.fill ⟨x.2, sd.depth - rd.layer - 1⟩ sd.r
          (k * (sd.t - sd.r)) Z)) U
      rw [← e]
      exact head_mapLast_fst_D3 (fun x : Nat × Forest => (x.1, shift sd.r (k * (sd.t - sd.r)) x.2))
        (fun x : Nat × Forest => (x.1, Hole.fill ⟨x.2, sd.depth - rd.layer - 1⟩ sd.r
          (k * (sd.t - sd.r)) Z)) (fun _ => rfl) (fun _ => rfl) x hx
    · intro x hx
      rw [List.mem_append, List.mem_append] at hx
      rcases hx with (hx | hx) | hx
      · exact hQh x hx
      · obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx
        exact hUh y (List.mem_of_mem_dropLast hy)
      · cases hl : U.getLast? with
        | none => simp [hl] at hx
        | some u =>
          simp only [hl, Option.map_some, Option.toList_some, List.mem_singleton] at hx
          subst hx
          have hu : u ∈ U := List.mem_of_getLast? hl
          obtain ⟨hR, hN⟩ := hownerR hown u hl
          obtain ⟨hH, hge⟩ := howner hown u hl
          simp only
          rw [Hole.fill_eq_put]
          refine irel_put_D3 Z _ _ _ _ ((routeOK_shift_D3 _ _ _ _).2 hR) (hUh u hu) ?_
          rw [routeNum_shift_D3, routeHost_shift_D3]
          have := routeHost_shiftBase_D3 (k * (sd.t - sd.r)) (sd.depth - rd.layer - 1) (sd.r + 1)
            (some sd.r) u.2
          simp only [Option.map_some] at this
          rw [show sd.r + k * (sd.t - sd.r) + 1 = sd.r + 1 + k * (sd.t - sd.r) by omega,
            show sd.r + k * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) from rfl]
          rw [show sd.r + k * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) from rfl] at this
          rw [this, hH]
          rw [show sd.r + 1 + k * (sd.t - sd.r) + routeNum_D3 (sd.depth - rd.layer - 1) u.2 =
            sd.t + k * (sd.t - sd.r) by omega]
          have hmap : hostSd.map (· + k * (sd.t - sd.r)) = hostSd.map (shiftVal sd.r (k * (sd.t - sd.r))) := by
            cases hs : hostSd with
            | none => rfl
            | some a =>
              simp only [Option.map_some, Option.some.injEq]
              unfold shiftVal; rw [if_pos (hge a hs)]
          rw [hmap]; exact hZ
  · rename_i hown
    have hown' : rd.owner = false := by simpa using hown
    obtain ⟨hR, hN⟩ := hbodyR hown'
    rw [irel_iff_icols_D3, icols_cons_D3, ← irel_eq_icols_D3]
    refine ⟨⟨hfirst _ (fun x hx => ?_), ?_⟩, ?_⟩
    · cases U with
      | nil => simp at hx
      | cons u us =>
        simp at hx; subst hx
        exact ⟨(u.1, shift sd.r (k * (sd.t - sd.r)) u.2), by simp, rfl⟩
    · intro x hx
      rw [List.mem_append] at hx
      rcases hx with hx | hx
      · exact hQh x hx
      · obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx
        exact hUh y hy
    · rw [Hole.fill_eq_put]
      by_cases hd0 : sd.depth - rd.layer = 0
      · obtain ⟨hB, hlt'⟩ := hbody0 hown' hd0
        have hfix : ∀ δ, hostSd.map (shiftVal sd.r δ) = hostSd := by
          intro δ
          cases hs : hostSd with
          | none => rfl
          | some a =>
            simp only [Option.map_some, Option.some.injEq]
            unfold shiftVal; rw [if_neg (by have := hlt' a hs; omega)]
        rw [hfix]
        have hB' := irel_shift_D3 hB (r := sd.r) (by omega) (k * (sd.t - sd.r))
        rw [hfix, show sd.r + 1 + k * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) + 1 by omega] at hB'
        refine irel_put_D3 Z _ _ _ _ ((routeOK_shift_D3 _ _ _ _).2 hR) hB' ?_
        rw [routeNum_shift_D3, hd0]
        simp only [routeHost_D3]
        rw [hfix] at hZ
        rw [hd0] at hN
        rwa [show sd.r + k * (sd.t - sd.r) + 1 + routeNum_D3 0 (.node (F.cols.drop (rd.idx + 1))) =
          sd.t + k * (sd.t - sd.r) by omega]
      · obtain ⟨hB, hH, hge⟩ := hbody1 hown' (by omega)
        have hB' := irel_shift_D3 hB (r := sd.r) (by omega) (k * (sd.t - sd.r))
        simp only [Option.map_some] at hB'
        rw [show shiftVal sd.r (k * (sd.t - sd.r)) sd.r = sd.r + k * (sd.t - sd.r) by
          unfold shiftVal; rw [if_pos le_rfl],
          show sd.r + 1 + k * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) + 1 by omega] at hB'
        have hB'' : IRel_D3 (sd.r + k * (sd.t - sd.r) + 1)
            (hostSd.map (shiftVal sd.r ((k - 1) * (sd.t - sd.r))))
            (shift sd.r (k * (sd.t - sd.r)) (.node (F.cols.drop (rd.idx + 1)))) := by
          refine irel_host_mono_D3 hB' (fun a' ha' => ⟨_, rfl, ?_⟩)
          cases hs : hostSd with
          | none => rw [hs] at ha'; cases ha'
          | some a =>
            rw [hs] at ha'
            simp only [Option.map_some, Option.some.injEq] at ha'
            subst ha'
            have := hlt a hs
            have := shiftVal_le_D3 sd.r ((k - 1) * (sd.t - sd.r)) a
            omega
        refine irel_put_D3 Z _ _ _ _ ((routeOK_shift_D3 _ _ _ _).2 hR) hB'' ?_
        rw [routeNum_shift_D3, routeHost_shift_D3]
        obtain ⟨hd', hd'eq⟩ : ∃ hd', sd.depth - rd.layer = hd' + 1 := ⟨_, (Nat.succ_pred_eq_of_ne_zero hd0).symm⟩
        rw [hd'eq] at hH hN ⊢
        have hind : ∀ X Y : Option Nat, ∀ b,
            routeHost_D3 b X (hd' + 1) (.node (F.cols.drop (rd.idx + 1))) =
            routeHost_D3 b Y (hd' + 1) (.node (F.cols.drop (rd.idx + 1))) := fun _ _ _ => rfl
        rw [hind _ ((some sd.r).map (· + k * (sd.t - sd.r)))]
        have := routeHost_shiftBase_D3 (k * (sd.t - sd.r)) (hd' + 1) (sd.r + 1) (some sd.r)
          (.node (F.cols.drop (rd.idx + 1)))
        rw [show sd.r + k * (sd.t - sd.r) + 1 = sd.r + 1 + k * (sd.t - sd.r) by omega, this, hH]
        rw [show sd.r + 1 + k * (sd.t - sd.r) +
            routeNum_D3 (hd' + 1) (.node (F.cols.drop (rd.idx + 1))) = sd.t + k * (sd.t - sd.r) by
          omega]
        have hmap : hostSd.map (· + k * (sd.t - sd.r)) = hostSd.map (shiftVal sd.r (k * (sd.t - sd.r))) := by
          cases hs : hostSd with
          | none => rfl
          | some a =>
            simp only [Option.map_some, Option.some.injEq]
            unfold shiftVal; rw [if_pos (hge a hs)]
        rw [hmap]; exact hZ


theorem getElem_of_getLast_D3 {l : List Column} {x : Column} {k : Nat} (h : l.getLast? = some x)
    (hk : k + 1 = l.length) : l[k]? = some x := by
  rw [List.getLast?_eq_getElem?] at h; rwa [show k = l.length - 1 by omega]

/-- Data of an ordinary step for relative I, part 1: the stopping column and the root column. -/
theorem ord_idata1_D3 {A : Forest} {sd : StopData} {rd : RootData} (hI : CondI A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) :
    (∀ a, routeHost_D3 0 none sd.depth A = some a → a < sd.t) ∧
    FirstOK_D3 (routeHost_D3 0 none sd.depth A) (sd.Q ++ [(sd.r, Tree.empty)]) ∧
    (∀ x ∈ sd.Q, IRel_D3 (sd.t + 1) (some sd.t) x.2) ∧
    (∀ x ∈ ((A.colAt rd.col).getD []).drop rd.cursor, IRel_D3 (sd.r + 1) (some sd.r) x.2) := by
  have hA : IRel_D3 0 none A := (condI_iff_irel_D3 A).1 hI
  obtain ⟨h1, -, -, h4, -⟩ := stopData_core hsd
  obtain ⟨hRA, -⟩ := stop_route_top_D3 hsd
  obtain ⟨-, htd⟩ := stop_route_D3 hsd 0 (Nat.zero_le _)
  simp only [Nat.sub_zero, routeNum_D3] at htd
  obtain ⟨hle, -, hr, hidx, -, hcol⟩ := root_facts_D3 hsd hrd
  have hRj : RouteOK_D3 rd.layer A := routeOK_le_D3 _ _ _ hRA hle
  have hIj := irel_skip_D3 rd.layer 0 none A hRj hA
  have hId := irel_skip_D3 sd.depth 0 none A hRA hA
  rw [Nat.zero_add] at hIj hId
  rw [irel_eq_icols_D3] at hIj hId
  have hcolsd := getElem_of_getLast_D3 h4 h1
  obtain ⟨hQ1, hQ2⟩ := hId _ _ hcolsd
  refine ⟨?_, hQ1, ?_, ?_⟩
  · intro a ha
    rcases routeHost_bound_D3 _ _ _ _ a hRA ha with h | ⟨-, h⟩
    · cases h
    · omega
  · intro x hx
    have := hQ2 x (List.mem_append_left _ hx)
    rwa [show leftCount A sd.depth + sd.col.col = sd.t by omega] at this
  · intro x hx
    cases hc : A.colAt rd.col with
    | none => simp [hc] at hx
    | some R =>
      rw [hc, Option.getD_some] at hx
      rw [hcol] at hc
      have := (hIj _ _ hc).2 x (List.mem_of_mem_drop hx)
      rwa [← hr] at this

/-- Data of an ordinary step for relative I, part 2: an empty query. -/
theorem ord_idata2_D3 {A : Forest} {sd : StopData} {rd : RootData} (hL : InL A)
    (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd) (hrd : rootData A = some rd) :
    sd.Q = [] → ∀ a, routeHost_D3 0 none sd.depth A = some a →
      a < sd.r ∧ FirstOK_D3 (some a) (((A.colAt rd.col).getD []).drop rd.cursor) := by
  intro hQ a ha
  have hA : IRel_D3 0 none A := (condI_iff_irel_D3 A).1 hL.2.1
  obtain ⟨h1, -, -, h4, h5, -⟩ := stopData_core hsd
  obtain ⟨hRA, -⟩ := stop_route_top_D3 hsd
  obtain ⟨-, htd⟩ := stop_route_D3 hsd 0 (Nat.zero_le _)
  simp only [Nat.sub_zero, routeNum_D3] at htd
  obtain ⟨hle, -, hr, hidx, -, hcol⟩ := root_facts_D3 hsd hrd
  obtain ⟨-, hQ1, -, -⟩ := ord_idata1_D3 hL.2.1 hsd hrd
  have hpos : 0 < sd.depth := by
    rcases Nat.eq_zero_or_pos sd.depth with h0 | h0
    · rw [h0] at ha; simp [routeHost_D3] at ha
    · exact h0
  -- the host is the last container: `a + 1 = leftCount A depth`
  have ha1 : a + 1 = leftCount A sd.depth := by
    have := routeHost_split_D3 (sd.depth - 1) 1 0 none A
    rw [show sd.depth - 1 + 1 = sd.depth by omega, ha] at this
    simp only [routeHost_D3, Nat.zero_add] at this
    obtain ⟨col, p, hc, -⟩ := h5 (sd.depth - 1) (by omega)
    have hne : (skipLayers A (sd.depth - 1)).cols ≠ [] := by intro he; rw [he] at hc; simp at hc
    have hlen := List.length_pos_iff.2 hne
    have := leftCount_succ_D3 A (sd.depth - 1)
    rw [show sd.depth - 1 + 1 = sd.depth by omega] at this
    simp only [Option.some.injEq] at *
    omega
  have hns := (stepKind_ordinary_iff_unfold (ne_empty_of_stepKind_D3 hk) hL.1 hL.2.1).1 hk
  obtain ⟨sd', hsd', hspec, -⟩ := hns
  rw [hsd] at hsd'; cases hsd'
  have har : a ≤ sd.r := by
    rw [hQ] at hQ1
    obtain ⟨q, H, rest, he, hq⟩ := hQ1 a ha
    simp at he; omega
  have hne : sd.r ≠ a := by
    intro he; apply hspec; exact ⟨hpos, hQ, by omega⟩
  refine ⟨by omega, ?_⟩
  -- the root lies in the stopping forest
  have hj : rd.layer = sd.depth := by
    by_contra hj
    have := leftCount_succ_D3 A rd.layer
    have := leftCount_mono_D3 A (show rd.layer + 1 ≤ sd.depth by omega)
    omega
  have hcur : rd.cursor = 0 := by
    obtain ⟨-, -, -, -, -, -, hc, -⟩ := rootData_spec hsd hrd
    rw [hc, queryKeys, hQ]; exact cursor_nil_right _
  have hId := irel_skip_D3 sd.depth 0 none A hRA hA
  rw [Nat.zero_add, irel_eq_icols_D3] at hId
  rw [hcur, List.drop_zero]
  have hc' : A.colAt rd.col = (skipLayers A sd.depth).cols[rd.idx]? := by rw [hcol, hj]
  cases hc : A.colAt rd.col with
  | none => rw [hc] at hc'; rw [hj] at hidx; rw [List.getElem?_eq_getElem hidx] at hc'; cases hc'
  | some R =>
    rw [Option.getD_some]
    rw [hc] at hc'
    intro a' ha'; cases ha'
    exact (hId _ _ hc'.symm).1 a ha


/-- Data of an ordinary step for relative I, part 3: the body and the owner's last height. -/
theorem ord_idata3_D3 {A : Forest} {sd : StopData} {rd : RootData} (hL : InL A)
    (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd) (hrd : rootData A = some rd) :
    let hostSd := routeHost_D3 0 none sd.depth A
    let F := (A.forestAt rd.col.path).getD Tree.empty
    let U := ((A.colAt rd.col).getD []).drop rd.cursor
    (rd.owner = false → sd.depth - rd.layer = 0 →
      IRel_D3 (sd.r + 1) hostSd (.node (F.cols.drop (rd.idx + 1))) ∧
      ∀ a, hostSd = some a → a < sd.r) ∧
    (rd.owner = false → 1 ≤ sd.depth - rd.layer →
      IRel_D3 (sd.r + 1) (some sd.r) (.node (F.cols.drop (rd.idx + 1))) ∧
      routeHost_D3 (sd.r + 1) (some sd.r) (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) =
        hostSd ∧ ∀ a, hostSd = some a → sd.r ≤ a) ∧
    (rd.owner = true → ∀ x, U.getLast? = some x →
      routeHost_D3 (sd.r + 1) (some sd.r) (sd.depth - rd.layer - 1) x.2 = hostSd ∧
      ∀ a, hostSd = some a → sd.r ≤ a) := by
  intro hostSd F U
  have hA : IRel_D3 0 none A := (condI_iff_irel_D3 A).1 hL.2.1
  obtain ⟨-, -, -, -, h5, -⟩ := stopData_core hsd
  obtain ⟨hRA, -⟩ := stop_route_top_D3 hsd
  obtain ⟨hle, hfa, hr, hidx, howner, hcol⟩ := root_facts_D3 hsd hrd
  obtain ⟨-, -, hidx', hnum, -, -, -, -⟩ := rootData_spec hsd hrd
  obtain ⟨-, -, -, hpre, -⟩ := rootData_path hsd hrd
  have hF : F = skipLayers A rd.layer := by simp [F, hfa]
  have hRj : RouteOK_D3 rd.layer A := routeOK_le_D3 _ _ _ hRA hle
  have hIj := irel_skip_D3 rd.layer 0 none A hRj hA
  rw [Nat.zero_add, irel_eq_icols_D3] at hIj
  have hsplit : hostSd = routeHost_D3 (leftCount A rd.layer) (routeHost_D3 0 none rd.layer A)
      (sd.depth - rd.layer) (skipLayers A rd.layer) := by
    have := routeHost_split_D3 rd.layer (sd.depth - rd.layer) 0 none A
    rw [Nat.add_sub_cancel' hle, Nat.zero_add] at this
    exact this
  obtain ⟨hRs, -⟩ := stop_route_D3 hsd (sd.depth - rd.layer) (by omega)
  rw [show sd.depth - (sd.depth - rd.layer) = rd.layer by omega] at hRs
  rw [hF]
  refine ⟨?_, ?_, ?_⟩
  · intro hown hd0
    rw [hd0] at hsplit
    simp only [routeHost_D3] at hsplit
    refine ⟨?_, ?_⟩
    · rw [irel_iff_icols_D3, hsplit]
      have := icols_drop_D3 hIj (rd.idx + 1)
      rwa [show leftCount A rd.layer + (rd.idx + 1) = sd.r + 1 by omega] at this
    · intro a ha
      rw [hsplit] at ha
      rcases routeHost_bound_D3 _ _ _ _ a hRj ha with h | ⟨-, h⟩
      · cases h
      · omega
  · intro hown hd1
    obtain ⟨i, hi⟩ : ∃ i, sd.depth - rd.layer = i + 1 := ⟨_, (Nat.succ_pred_eq_of_ne_zero (by omega)).symm⟩
    rw [hi] at hRs hsplit ⊢
    obtain ⟨cs, es, p, h, hG, hR'⟩ := hRs
    have hlen : (skipLayers A rd.layer).cols.length = cs.length + 1 := by rw [hG]; simp [Tree.cols]
    have hlt : rd.idx + 1 < (skipLayers A rd.layer).cols.length := by
      have : ¬ rd.idx + 1 = (skipLayers A rd.layer).cols.length := by
        rw [← howner, hown]; simp
      omega
    have hdrop : (skipLayers A rd.layer).cols.drop (rd.idx + 1) =
        cs.drop (rd.idx + 1) ++ [es ++ [(p, h)]] := by
      rw [hG]; exact List.drop_append_of_le_length (by omega)
    have hsum : (rd.col.path.map (·.1 + 1)).sum = leftCount A rd.layer := by
      have : rd.col.num 0 = (rd.col.path.map (·.1 + 1)).sum + rd.col.col := by simp [ColAddr.num]
      omega
    refine ⟨?_, ?_, ?_⟩
    · rw [irel_iff_icols_D3]
      intro z col hz
      have hz' : (skipLayers A rd.layer).cols[rd.idx + 1 + z]? = some col := by
        rw [← List.getElem?_drop]; exact hz
      have hzlt : rd.idx + 1 + z < (skipLayers A rd.layer).cols.length :=
        (List.getElem?_eq_some_iff.1 hz').1
      refine ⟨?_, ?_⟩
      · -- the body column's first parent is at least `r` (T3.2j)
        have hres : sd.col.resolve 0 (sd.r + 1 + z) = some ⟨rd.col.path, rd.idx + 1 + z⟩ := by
          rw [ColAddr.resolve_spec]
          refine ⟨Or.inl ?_, ?_⟩
          · obtain ⟨col', p', hc', -, -, hpk⟩ := h5 rd.layer (by omega)
            refine ⟨rd.layer, _, _, hpk, ?_, ?_⟩
            · obtain ⟨t, ht⟩ := hpre
              obtain ⟨-, hlay, -⟩ := rootData_spec hsd hrd
              show rd.col.path = sd.col.path.take rd.layer
              rw [hlay, ← ht]; simp
            · simp only; omega
          · simp only [ColAddr.num]; omega
        have htt : sd.t = sd.col.num 0 := (stopData_spec hsd).2.2.1
        obtain ⟨q, H, rest, hc, hq⟩ := body_firstParent hL hk hsd (x := sd.r + 1 + z) (by omega)
          (by rw [htt]; exact ColAddr.resolve_lt hres) hres
        have : A.colAt ⟨rd.col.path, rd.idx + 1 + z⟩ = some col := by
          simp only [Tree.colAt, hfa, Option.bind_some]; exact hz'
        rw [this] at hc; cases hc
        intro a ha; cases ha
        exact ⟨q, H, rest, rfl, hq⟩
      · intro x hx
        have := (hIj _ _ hz').2 x hx
        rwa [show leftCount A rd.layer + (rd.idx + 1 + z) = sd.r + 1 + z by omega] at this
    · rw [hsplit, hdrop, hG]
      simp only [routeHost_D3, nextLayer_snoc_D3, Tree.cols, List.length_append,
        List.length_singleton]
      have e1 : sd.r + 1 + ((cs.drop (rd.idx + 1)).length + 1) = leftCount A rd.layer + (cs.length + 1) := by
        rw [List.length_drop]; omega
      have e2 : sd.r + 1 + ((cs.drop (rd.idx + 1)).length + 1 - 1) =
          leftCount A rd.layer + (cs.length + 1 - 1) := by
        rw [List.length_drop]; omega
      rw [e1, e2]
    · intro a ha
      rw [hsplit, hG] at ha
      simp only [routeHost_D3, nextLayer_snoc_D3, Tree.cols, List.length_append,
        List.length_singleton] at ha
      rcases routeHost_bound_D3 _ _ _ _ a hR' ha with h' | ⟨h', -⟩
      · simp at h'; omega
      · omega
  · intro hown x hx
    have hlt := rootData_layer_lt hsd hrd hown
    obtain ⟨i, hi⟩ : ∃ i, sd.depth - rd.layer = i + 1 := ⟨_, (Nat.succ_pred_eq_of_ne_zero (by omega)).symm⟩
    rw [hi] at hRs hsplit
    obtain ⟨cs, es, p, h, hG, hR'⟩ := hRs
    have hidx2 := howner.1 hown
    rw [hG] at hidx2 hcol
    simp only [Tree.cols, List.length_append, List.length_singleton] at hidx2
    have hcol' : A.colAt rd.col = some (es ++ [(p, h)]) := by
      rw [hcol]; simp [Tree.cols, show rd.idx = cs.length by omega]
    have hx' : x = (p, h) := by
      simp only [U, hcol', Option.getD_some, List.getLast?_drop] at hx
      split at hx
      · cases hx
      · simp at hx; exact hx.symm
    subst hx'
    rw [show sd.depth - rd.layer - 1 = i by omega]
    rw [hsplit, hG]
    simp only [routeHost_D3, nextLayer_snoc_D3, Tree.cols, List.length_append,
      List.length_singleton]
    refine ⟨?_, ?_⟩
    · congr 1
      · omega
      · congr 1; omega
    · intro a ha
      rcases routeHost_bound_D3 _ _ _ _ a hR' ha with h' | ⟨h', -⟩
      · simp at h'; omega
      · omega

-- T3.2k (txt:340-344): ordinary outputs satisfy V and I
theorem condV_ord {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .ordinary)
    (hB : expand A n = some B) : CondV B := by
  obtain ⟨sd, rd, hsd, hrd, rfl, -⟩ := ord_output_D3 hL hk hB
  obtain ⟨hrt, hQ, hU, hbody, howner⟩ := ord_vdata_D3 hL.1 hsd hrd
  obtain ⟨hR, hN⟩ := stop_route_top_D3 hsd
  rw [condV_iff_vrel_D3]
  refine vrel_put_D3 _ _ _ _ hR ((condV_iff_vrel_D3 A).1 hL.1) ?_
  rw [hN, Nat.zero_add]
  have := ordLoop_induct_D3 (step := ordStep sd rd ((A.forestAt rd.col.path).getD Tree.empty)
      (((A.colAt rd.col).getD []).drop rd.cursor))
    (P := fun k Z => VRel_D3 (sd.t + k * (sd.t - sd.r)) Z) ?_ n Tree.empty (vrel_empty_D3 _)
  · simpa [ordZ] using this
  · intro k Z hk1 hZ
    have := vrel_ordStep_D3 hk1 hrt hQ hU hbody howner hZ
    have e : sd.t + (k - 1) * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) := by
      obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
      simp only [Nat.add_sub_cancel, Nat.succ_mul]; omega
    show VRel_D3 (sd.t + (k - 1) * (sd.t - sd.r)) _
    rw [e]; exact this
theorem condI_ord {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .ordinary)
    (hB : expand A n = some B) : CondI B := by
  obtain ⟨sd, rd, hsd, hrd, rfl, -⟩ := ord_output_D3 hL hk hB
  obtain ⟨hrt, -, -, hbodyR, hownerR⟩ := ord_vdata_D3 hL.1 hsd hrd
  obtain ⟨hlt, hQ1, hQ2, hU2⟩ := ord_idata1_D3 hL.2.1 hsd hrd
  have hQnil := ord_idata2_D3 hL hk hsd hrd
  obtain ⟨hbody0, hbody1, howner⟩ := ord_idata3_D3 hL hk hsd hrd
  obtain ⟨hR, hN⟩ := stop_route_top_D3 hsd
  rw [condI_iff_irel_D3]
  refine irel_put_D3 _ _ _ _ _ hR ((condI_iff_irel_D3 A).1 hL.2.1) ?_
  rw [hN, Nat.zero_add]
  have := ordLoop_induct_D3 (step := ordStep sd rd ((A.forestAt rd.col.path).getD Tree.empty)
      (((A.colAt rd.col).getD []).drop rd.cursor))
    (P := fun k Z => IRel_D3 (sd.t + k * (sd.t - sd.r))
      ((routeHost_D3 0 none sd.depth A).map (shiftVal sd.r (k * (sd.t - sd.r)))) Z) ?_ n Tree.empty
    (irel_empty_D3 _ _)
  · simp only [Nat.zero_mul, Nat.add_zero, shiftVal_zero_fun, Option.map_id] at this
    simpa [ordZ] using this
  · intro k Z hk1 hZ
    have := irel_ordStep_D3 hk1 hrt hlt hQ1 hQ2 hU2 hQnil
      (fun h => ⟨(hbodyR h).1, (hbodyR h).2.2⟩) hbody0 hbody1 hownerR howner hZ
    have e : sd.t + (k - 1) * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) := by
      obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
      simp only [Nat.add_sub_cancel, Nat.succ_mul]; omega
    show IRel_D3 (sd.t + (k - 1) * (sd.t - sd.r)) _ _
    rw [e]; exact this

/-! ### Relative condition H -/

/-- The entries of a column are nonincreasing. -/
def ColH_D3 (col : Column) : Prop := List.IsChain (fun x y => EntryLe y x) col

def HRel_D3 (F : Forest) : Prop := ∀ c col, F.colAt c = some col → ColH_D3 col

def HCols_D3 (cols : List Column) : Prop :=
  ∀ (j : Nat) (col : Column), cols[j]? = some col → ColH_D3 col ∧ ∀ x ∈ col, HRel_D3 x.2

theorem hrel_iff_hcols_D3 (cols : List Column) : HRel_D3 (.node cols) ↔ HCols_D3 cols := by
  constructor
  · intro hH j col hj
    refine ⟨hH ⟨[], j⟩ col hj, ?_⟩
    intro x hx c col' hc
    obtain ⟨m, hm⟩ := List.getElem?_of_mem hx
    obtain ⟨P, k⟩ := c
    exact hH ⟨(j, m) :: P, k⟩ col' (by rw [Tree.colAt_cons]; simp [Tree.cols, hj, hm, hc])
  · intro hH c col hc
    obtain ⟨P, k⟩ := c
    cases P with
    | nil => exact (hH k col hc).1
    | cons ab P =>
      obtain ⟨j, m⟩ := ab
      rw [Tree.colAt_cons] at hc
      cases hcj : (Tree.node cols).cols[j]? with
      | none => simp [hcj] at hc
      | some cj =>
        cases hm : cj[m]? with
        | none => simp [hcj, hm] at hc
        | some x =>
          simp only [hcj, hm, Option.bind_some] at hc
          exact (hH j cj hcj).2 x (List.mem_of_getElem? hm) _ col hc

theorem hrel_eq_hcols_D3 (F : Forest) : HRel_D3 F ↔ HCols_D3 F.cols := by
  obtain ⟨cols⟩ := F; exact hrel_iff_hcols_D3 cols

theorem condH_iff_hrel_D3 (E : Forest) : CondH E ↔ HRel_D3 E := by
  constructor
  · intro hH c col hc
    have hmem : c ∈ E.colAddrs := (Tree.mem_colAddrs_iff E c).2 (by rw [hc]; rfl)
    rw [ColH_D3, List.isChain_iff_getElem]
    intro i hi
    exact hH c hmem i _ _ (by rw [hc]; simp [List.getElem?_eq_getElem (show i < col.length by omega)])
      (by rw [hc]; simp [List.getElem?_eq_getElem hi])
  · intro hH c hc i x y hx hy
    obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff E c).1 hc)
    rw [hcol, Option.getD_some] at hx hy
    have := hH c col hcol
    rw [ColH_D3, List.isChain_iff_getElem] at this
    obtain ⟨hi, rfl⟩ := List.getElem?_eq_some_iff.1 hy
    obtain ⟨hi', rfl⟩ := List.getElem?_eq_some_iff.1 hx
    exact this i hi

theorem hcols_nil_D3 : HCols_D3 [] := by intro j col hj; simp at hj

theorem hcols_cons_D3 (c : Column) (cs : List Column) :
    HCols_D3 (c :: cs) ↔ (ColH_D3 c ∧ ∀ x ∈ c, HRel_D3 x.2) ∧ HCols_D3 cs := by
  constructor
  · intro h
    exact ⟨h 0 c rfl, fun j col hj => h (j + 1) col (by simpa using hj)⟩
  · rintro ⟨h1, h2⟩ j col hj
    cases j with
    | zero => simp at hj; subst hj; exact h1
    | succ j => exact h2 j col (by simpa using hj)

theorem hcols_append_D3 (cs ds : List Column) :
    HCols_D3 (cs ++ ds) ↔ HCols_D3 cs ∧ HCols_D3 ds := by
  induction cs with
  | nil => simp [hcols_nil_D3]
  | cons c cs ih => rw [List.cons_append, hcols_cons_D3, hcols_cons_D3, ih]; simp only [and_assoc]

theorem hcols_single_D3 (c : Column) : HCols_D3 [c] ↔ ColH_D3 c ∧ ∀ x ∈ c, HRel_D3 x.2 := by
  rw [hcols_cons_D3]; simp [hcols_nil_D3]

theorem hcols_drop_D3 {cols : List Column} (h : HCols_D3 cols) (k : Nat) : HCols_D3 (cols.drop k) := by
  intro j col hj
  rw [List.getElem?_drop] at hj
  exact h (k + j) col hj

theorem hrel_empty_D3 : HRel_D3 Tree.empty := by
  rw [show (Tree.empty : Forest) = .node [] from rfl, hrel_iff_hcols_D3]; exact hcols_nil_D3

theorem hrel_colAt_D3 {F : Forest} (hF : HRel_D3 F) {c : ColAddr} {col : Column}
    (hc : F.colAt c = some col) : ColH_D3 col ∧ ∀ x ∈ col, HRel_D3 x.2 := by
  refine ⟨hF c col hc, ?_⟩
  intro x hx c' col' hc'
  obtain ⟨m, hm⟩ := List.getElem?_of_mem hx
  obtain ⟨P, k⟩ := c'
  have hG : F.forestAt c.path = some (.node ((F.forestAt c.path).getD Tree.empty).cols) := by
    cases hf : F.forestAt c.path with
    | none => simp [Tree.colAt, hf] at hc
    | some G => obtain ⟨gc⟩ := G; rfl
  have hcol : ((F.forestAt c.path).getD Tree.empty).cols[c.col]? = some col := by
    simp only [Tree.colAt] at hc
    cases hf : F.forestAt c.path with
    | none => simp [hf] at hc
    | some G => simp only [hf, Option.bind_some] at hc; simpa using hc
  have hf : F.forestAt (c.path ++ (c.col, m) :: P) = x.2.forestAt P := by
    rw [Tree.forestAt_append, hG]
    simp only [Option.bind_some]
    rw [Tree.forestAt_cons]
    have e : (Tree.node ((F.forestAt c.path).getD Tree.empty).cols).cols =
      ((F.forestAt c.path).getD Tree.empty).cols := rfl
    rw [e, hcol]; simp [hm]
  exact hF ⟨c.path ++ (c.col, m) :: P, k⟩ col' (by simp only [Tree.colAt]; rw [hf]; exact hc')

theorem hrel_forestAt_D3 {F : Forest} (hF : HRel_D3 F) {π : List (Nat × Nat)} {G : Forest}
    (hG : F.forestAt π = some G) : HRel_D3 G := by
  intro c col hc
  apply hF ⟨π ++ c.path, c.col⟩ col
  simp only [Tree.colAt, Tree.forestAt_append, hG, Option.bind_some]
  exact hc

/-! Shifts are order embeddings of forests. -/

theorem compare_shiftVal_D3 (r d x y : Nat) :
    compare (shiftVal r d x) (shiftVal r d y) = compare x y := by
  rcases lt_trichotomy x y with h | rfl | h
  · rw [compare_lt_iff_lt.2 h, compare_lt_iff_lt.2 (shiftVal_strictMono_D3 r d h)]
  · simp
  · rw [compare_gt_iff_gt.2 h, compare_gt_iff_gt.2 (shiftVal_strictMono_D3 r d h)]

theorem cmp_shift_D3 (r d : Nat) (X Y : Forest) :
    Tree.cmp compare (shift r d X) (shift r d Y) = Tree.cmp compare X Y :=
  Tree.cmp_map (compare_shiftVal_D3 r d) X Y

theorem shift_le_shift_D3 (r d : Nat) {X Y : Forest} (h : X ≤ Y) : shift r d X ≤ shift r d Y := by
  show Tree.cmp compare _ _ ≠ .gt
  rw [cmp_shift_D3]; exact h

theorem entryLe_shift_D3 (r d : Nat) {x y : Nat × Forest} (h : EntryLe y x) :
    EntryLe (shiftVal r d y.1, shift r d y.2) (shiftVal r d x.1, shift r d x.2) := by
  rcases h with h | ⟨h1, h2⟩
  · exact Or.inl (shiftVal_strictMono_D3 r d h)
  · exact Or.inr ⟨by rw [h1], shift_le_shift_D3 r d h2⟩

theorem colH_shift_D3 {col : Column} (h : ColH_D3 col) (r d : Nat) :
    ColH_D3 (Tree.mapCol (shiftVal r d) col) := by
  rw [ColH_D3, treeMapCol_eq_map, List.isChain_map]
  exact h.imp (fun a b hab => entryLe_shift_D3 r d hab)

theorem colH_shiftH_D3 {col : Column} (h : ColH_D3 col) (r d : Nat) :
    ColH_D3 (col.map fun x => (x.1, shift r d x.2)) := by
  rw [ColH_D3, List.isChain_map]
  refine h.imp (fun a b hab => ?_)
  rcases hab with h | ⟨h1, h2⟩
  · exact Or.inl h
  · exact Or.inr ⟨h1, shift_le_shift_D3 r d h2⟩

theorem hrel_shift_D3 {F : Forest} (h : HRel_D3 F) (r d : Nat) : HRel_D3 (shift r d F) := by
  intro c col hc
  rw [shift, colAt_map_D3] at hc
  cases h' : F.colAt c with
  | none => simp [h'] at hc
  | some col0 =>
    simp only [h', Option.map_some, Option.some.injEq] at hc
    subst hc
    exact colH_shift_D3 (h c col0 h') r d

/-! Route replacement and the order. -/

/-- The route column at depth `k`. -/
def routeCol_D3 (k : Nat) (F : Forest) : Column := ((skipLayers F k).cols.getLast?).getD []

theorem cmpCol_self_D3 (x : Column) : Tree.cmpCol (compare : Nat → Nat → Ordering) x x = .eq := by
  have : Tree.cmp (compare : Nat → Nat → Ordering) (Tree.node [x]) (Tree.node [x]) = .eq :=
    Std.ReflCmp.compare_self
  simp only [Tree.cmp, Tree.cmpCols] at this
  cases h : Tree.cmpCol compare x x <;> simp_all [Ordering.then]

theorem cmpCols_append_left_D3 (P a b : List Column) :
    Tree.cmpCols (compare : Nat → Nat → Ordering) (P ++ a) (P ++ b) = Tree.cmpCols compare a b := by
  induction P with
  | nil => rfl
  | cons x P ih => simp only [List.cons_append, Tree.cmpCols, cmpCol_self_D3, ih, Ordering.then]

theorem cmpCol_append_left_D3 (P a b : Column) :
    Tree.cmpCol (compare : Nat → Nat → Ordering) (P ++ a) (P ++ b) = Tree.cmpCol compare a b := by
  induction P with
  | nil => rfl
  | cons x P ih =>
    obtain ⟨p, h⟩ := x
    simp only [List.cons_append, Tree.cmpCol, ih]
    have : Tree.cmp (compare : Nat → Nat → Ordering) h h = .eq := Std.ReflCmp.compare_self
    simp [this, Ordering.then]

theorem cmp_put_D3 (Z Z' : Forest) : ∀ (k : Nat) (F : Forest), RouteOK_D3 k F →
    Tree.cmp compare (replaceAt 0 0 Z k F) (replaceAt 0 0 Z' k F) = Tree.cmp compare Z Z'
  | 0, .node cols, hR => by
    have hc : cols ≠ [] := hR
    rw [put_zero_D3 Z hc, put_zero_D3 Z' hc]
    obtain ⟨zc⟩ := Z; obtain ⟨zc'⟩ := Z'
    simp only [Tree.cmp, Tree.cols]
    exact cmpCols_append_left_D3 _ _ _
  | k + 1, F, hR => by
    obtain ⟨cs, es, q, H, rfl, hR'⟩ := hR
    rw [put_succ_D3, put_succ_D3]
    simp only [Tree.cmp]
    rw [cmpCols_append_left_D3]
    simp only [Tree.cmpCols, cmpCol_append_left_D3, Tree.cmpCol, cmp_put_D3 Z Z' k H hR']
    rw [show compare q q = Ordering.eq from compare_eq_iff_eq.2 rfl]
    cases Tree.cmp compare Z Z' <;> rfl

theorem put_self_D3 : ∀ (k : Nat) (F : Forest), RouteOK_D3 k F →
    replaceAt 0 0 (.node [routeCol_D3 k F]) k F = F
  | 0, .node cols, hR => by
    have hc : cols ≠ [] := hR
    rw [put_zero_D3 _ hc]
    simp only [routeCol_D3, skipLayers, Tree.cols]
    obtain ⟨l, hl⟩ : ∃ l, cols.getLast? = some l := by
      cases h : cols.getLast? with
      | none => simp at h; exact absurd h hc
      | some l => exact ⟨l, rfl⟩
    rw [hl, Option.getD_some]
    obtain ⟨ys, rfl⟩ := List.getLast?_eq_some_iff.1 hl
    simp
  | k + 1, F, hR => by
    obtain ⟨cs, es, q, H, rfl, hR'⟩ := hR
    rw [put_succ_D3]
    have : routeCol_D3 (k + 1) (.node (cs ++ [es ++ [(q, H)]])) = routeCol_D3 k H := by
      simp only [routeCol_D3, skipLayers, nextLayer_snoc_D3]
    rw [this, put_self_D3 k H hR']

theorem put_le_D3 {Z : Forest} {k : Nat} {F : Forest} (hR : RouteOK_D3 k F)
    (hZ : Z ≤ .node [routeCol_D3 k F]) : replaceAt 0 0 Z k F ≤ F := by
  have h1 := cmp_put_D3 Z (.node [routeCol_D3 k F]) k F hR
  rw [put_self_D3 k F hR] at h1
  show Tree.cmp compare _ _ ≠ .gt
  rw [h1]; exact hZ

theorem put_lt_D3 {Z : Forest} {k : Nat} {F : Forest} (hR : RouteOK_D3 k F)
    (hZ : Z < .node [routeCol_D3 k F]) : replaceAt 0 0 Z k F < F := by
  have h1 := cmp_put_D3 Z (.node [routeCol_D3 k F]) k F hR
  rw [put_self_D3 k F hR] at h1
  show Tree.cmp compare _ _ = .lt
  rw [h1]; exact hZ

theorem colH_snoc_D3 {l : Column} {a : Nat × Forest} :
    ColH_D3 (l ++ [a]) ↔ ColH_D3 l ∧ ∀ x ∈ l.getLast?, EntryLe a x := by
  rw [ColH_D3, List.isChain_append]
  simp [ColH_D3]

theorem entryLe_trans_le_D3 {x y : Nat × Forest} {h' : Forest} (h : EntryLe y x)
    (hh : h' ≤ y.2) : EntryLe (y.1, h') x := by
  rcases h with h | ⟨h1, h2⟩
  · exact Or.inl h
  · exact Or.inr ⟨h1, le_trans hh h2⟩

theorem hrel_put_D3 (Z : Forest) : ∀ (k : Nat) (F : Forest), RouteOK_D3 k F → HRel_D3 F →
    HRel_D3 Z → Z ≤ .node [routeCol_D3 k F] → HRel_D3 (replaceAt 0 0 Z k F)
  | 0, .node cols, hR, hF, hZ, _ => by
    have hc : cols ≠ [] := hR
    rw [put_zero_D3 Z hc]
    obtain ⟨zc⟩ := Z
    simp only [Tree.cols]
    rw [hrel_iff_hcols_D3] at hF hZ ⊢
    rw [hcols_append_D3]
    refine ⟨?_, hZ⟩
    rw [← List.dropLast_append_getLast hc, hcols_append_D3] at hF
    exact hF.1
  | k + 1, F, hR, hF, hZ, hle => by
    obtain ⟨cs, es, q, H, rfl, hR'⟩ := hR
    have hle' : Z ≤ .node [routeCol_D3 k H] := by
      simpa [routeCol_D3, skipLayers, nextLayer_snoc_D3] using hle
    rw [put_succ_D3]
    rw [hrel_iff_hcols_D3, hcols_append_D3, hcols_single_D3] at hF ⊢
    obtain ⟨hF1, hF2, hF3⟩ := hF
    refine ⟨hF1, ?_, ?_⟩
    · rw [colH_snoc_D3] at hF2 ⊢
      refine ⟨hF2.1, fun x hx => ?_⟩
      exact entryLe_trans_le_D3 (hF2.2 x hx) (put_le_D3 hR' hle')
    · intro x hx
      rw [List.mem_append, List.mem_singleton] at hx
      rcases hx with hx | rfl
      · exact hF3 x (List.mem_append_left _ hx)
      · exact hrel_put_D3 Z k H hR' (hF3 (q, H) (by simp)) hZ hle'


theorem routeCol_shift_D3 (r d : Nat) : ∀ (k : Nat) (F : Forest),
    routeCol_D3 k (shift r d F) = Tree.mapCol (shiftVal r d) (routeCol_D3 k F)
  | 0, .node cols => by
    simp only [routeCol_D3, skipLayers, shift, Tree.map, Tree.cols, treeMapCols_eq_map,
      List.getLast?_map]
    cases cols.getLast? <;> rfl
  | k + 1, F => by
    simp only [routeCol_D3, skipLayers]
    rw [show nextLayer (shift r d F) = shift r d (nextLayer F) from nextLayer_map_D3 _ _]
    exact routeCol_shift_D3 r d k (nextLayer F)

/-- A head column `Q' ⌢ V` whose continuation starts below the closing parent `ρ` is smaller
than the stopping column `Q' ⌢ [(ρ, ∅)]`. -/
theorem head_lt_D3 {Q' V : Column} {rest : List Column} {ρ : Nat}
    (hV : ∀ v ∈ V.head?, v.1 < ρ) :
    (Tree.node ((Q' ++ V) :: rest) : Forest) < .node [Q' ++ [(ρ, Tree.empty)]] := by
  show Tree.cmp compare _ _ = .lt
  simp only [Tree.cmp, Tree.cmpCols, cmpCol_append_left_D3]
  cases V with
  | nil => rfl
  | cons v vs =>
    have : compare v.1 ρ = .lt := compare_lt_iff_lt.2 (hV v (by simp))
    obtain ⟨p, h⟩ := v
    simp only [Tree.cmpCol] at this ⊢
    rw [this]; rfl

/-- Step `k` of the ordinary loop keeps relative H, and its output lies below the stopping column
of the previous phase. -/
theorem hrel_ordStep_D3 {sd : StopData} {rd : RootData} {F : Forest} {U : Column} {k : Nat}
    {Z : Forest}
    (hQ : ColH_D3 (sd.Q ++ [(sd.r, Tree.empty)])) (hQh : ∀ x ∈ sd.Q, HRel_D3 x.2)
    (hU : ColH_D3 U) (hUh : ∀ x ∈ U, HRel_D3 x.2) (hUr : ∀ x ∈ U, x.1 < sd.r)
    (hbody : rd.owner = false →
      RouteOK_D3 (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) ∧
      HRel_D3 (.node (F.cols.drop (rd.idx + 1))) ∧
      routeCol_D3 (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) = sd.Q ++ [(sd.r, Tree.empty)])
    (howner : rd.owner = true → ∀ x, U.getLast? = some x →
      RouteOK_D3 (sd.depth - rd.layer - 1) x.2 ∧
      routeCol_D3 (sd.depth - rd.layer - 1) x.2 = sd.Q ++ [(sd.r, Tree.empty)])
    (hZ : HRel_D3 Z)
    (hZle : Z ≤ .node [Tree.mapCol (shiftVal sd.r (k * (sd.t - sd.r))) (sd.Q ++ [(sd.r, Tree.empty)])]) :
    HRel_D3 (ordStep sd rd F U k Z) ∧
      ordStep sd rd F U k Z <
        .node [Tree.mapCol (shiftVal sd.r ((k - 1) * (sd.t - sd.r))) (sd.Q ++ [(sd.r, Tree.empty)])] := by
  set δ := (k - 1) * (sd.t - sd.r) with hδ
  set Q' := Tree.mapCol (shiftVal sd.r δ) sd.Q with hQ'
  have hmapQ : Tree.mapCol (shiftVal sd.r δ) (sd.Q ++ [(sd.r, Tree.empty)]) =
      Q' ++ [(shiftVal sd.r δ sd.r, Tree.empty)] := by
    simp [hQ', treeMapCol_eq_map, Tree.map, Tree.mapCols, Tree.empty]
  rw [colH_snoc_D3] at hQ
  have hQ'c : ColH_D3 Q' := colH_shift_D3 hQ.1 _ _
  have hQr : ∀ x ∈ Q'.getLast?, sd.r ≤ x.1 := by
    intro x hx
    rw [hQ', treeMapCol_eq_map, List.getLast?_map] at hx
    cases hl : sd.Q.getLast? with
    | none => rw [hl] at hx; cases hx
    | some q =>
      rw [hl] at hx; simp only [Option.map_some, Option.mem_def, Option.some.injEq] at hx
      subst hx
      have := hQ.2 q hl
      have h2 := le_shiftVal_D3 sd.r δ q.1
      simp only
      rcases this with h | ⟨h, -⟩ <;> omega
  have hQ'h : ∀ x ∈ Q', HRel_D3 x.2 := by
    intro x hx
    rw [hQ', treeMapCol_eq_map] at hx
    obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx
    exact hrel_shift_D3 (hQh y hy) _ _
  -- the head: `Q'` followed by a continuation `V` with the parents of `U`
  have hhead : ∀ V : Column, ColH_D3 V → (∀ v ∈ V.head?, v.1 < sd.r) →
      ColH_D3 (Q' ++ V) := by
    intro V hV hVr
    rw [ColH_D3, List.isChain_append]
    refine ⟨hQ'c, hV, fun x hx y hy => Or.inl ?_⟩
    have := hQr x hx; have := hVr y hy; omega
  have hρ : sd.r ≤ shiftVal sd.r δ sd.r := le_shiftVal_D3 _ _ _
  unfold ordStep
  simp only
  rw [← hδ, ← hQ', hmapQ]
  split
  · rename_i hown
    have hcols : ColH_D3 (U.dropLast.map (fun x => (x.1, shift sd.r (k * (sd.t - sd.r)) x.2)) ++
        (U.getLast?.map fun x => (x.1, Hole.fill ⟨x.2, sd.depth - rd.layer - 1⟩ sd.r
          (k * (sd.t - sd.r)) Z)).toList) := by
      cases hl : U.getLast? with
      | none =>
        have : U = [] := by simpa using hl
        subst this; simp [ColH_D3]
      | some u =>
        obtain ⟨R, rfl⟩ := List.getLast?_eq_some_iff.1 hl
        simp only [List.dropLast_concat, Option.map_some, Option.toList_some]
        rw [colH_snoc_D3] at hU ⊢
        refine ⟨colH_shiftH_D3 hU.1 _ _, fun x hx => ?_⟩
        rw [List.getLast?_map] at hx
        cases hR : R.getLast? with
        | none => rw [hR] at hx; cases hx
        | some w =>
          rw [hR] at hx; simp only [Option.map_some, Option.mem_def, Option.some.injEq] at hx
          subst hx
          obtain ⟨hRo, hRc⟩ := howner hown u (by simp)
          have hle : Hole.fill ⟨u.2, sd.depth - rd.layer - 1⟩ sd.r (k * (sd.t - sd.r)) Z ≤
              shift sd.r (k * (sd.t - sd.r)) u.2 := by
            rw [Hole.fill_eq_put]
            refine put_le_D3 ((routeOK_shift_D3 _ _ _ _).2 hRo) ?_
            rw [routeCol_shift_D3, hRc]; exact hZle
          rcases hU.2 w hR with h | ⟨h1, h2⟩
          · exact Or.inl h
          · exact Or.inr ⟨h1, le_trans hle (shift_le_shift_D3 _ _ h2)⟩
    have hVr : ∀ v ∈ (U.dropLast.map (fun x => (x.1, shift sd.r (k * (sd.t - sd.r)) x.2)) ++
        (U.getLast?.map fun x => (x.1, Hole.fill ⟨x.2, sd.depth - rd.layer - 1⟩ sd.r
          (k * (sd.t - sd.r)) Z)).toList).head?, v.1 < sd.r := by
      intro v hv
      have e := mapLast_eq (fun x : Nat × Forest => (x.1, shift sd.r (k * (sd.t - sd.r)) x.2))
        (fun x : Nat × Forest => (x.1, Hole.fill ⟨x.2, sd.depth - rd.layer - 1⟩ sd.r
          (k * (sd.t - sd.r)) Z)) U
      rw [← e] at hv
      cases hU0 : U.head? with
      | none =>
        cases U with
        | nil => simp [mapLast] at hv
        | cons _ _ => simp at hU0
      | some u0 =>
        obtain ⟨y, hy, hyu⟩ := head_mapLast_fst_D3
          (fun x : Nat × Forest => (x.1, shift sd.r (k * (sd.t - sd.r)) x.2))
          (fun x : Nat × Forest => (x.1, Hole.fill ⟨x.2, sd.depth - rd.layer - 1⟩ sd.r
            (k * (sd.t - sd.r)) Z)) (fun _ => rfl) (fun _ => rfl) u0 hU0
        rw [hy] at hv; cases hv
        rw [hyu]; exact hUr u0 (List.mem_of_head? hU0)
    refine ⟨?_, ?_⟩
    · rw [hrel_iff_hcols_D3, hcols_single_D3, List.append_assoc]
      refine ⟨hhead _ hcols hVr, fun x hx => ?_⟩
      rw [List.mem_append, List.mem_append] at hx
      rcases hx with hx | hx | hx
      · exact hQ'h x hx
      · obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx
        exact hrel_shift_D3 (hUh y (List.mem_of_mem_dropLast hy)) _ _
      · cases hl : U.getLast? with
        | none => simp [hl] at hx
        | some u =>
          simp only [hl, Option.map_some, Option.toList_some, List.mem_singleton] at hx
          subst hx
          obtain ⟨hRo, hRc⟩ := howner hown u hl
          simp only
          rw [Hole.fill_eq_put]
          refine hrel_put_D3 Z _ _ ((routeOK_shift_D3 _ _ _ _).2 hRo)
            (hrel_shift_D3 (hUh u (List.mem_of_getLast? hl)) _ _) hZ ?_
          rw [routeCol_shift_D3, hRc]; exact hZle
    · rw [List.append_assoc]
      have := head_lt_D3 (Q' := Q') (rest := []) (ρ := shiftVal sd.r δ sd.r) (fun v hv =>
        lt_of_lt_of_le (hVr v hv) hρ)
      exact this
  · rename_i hown
    have hown' : rd.owner = false := by simpa using hown
    obtain ⟨hR, hB, hRc⟩ := hbody hown'
    have hVr : ∀ v ∈ (U.map fun x => (x.1, shift sd.r (k * (sd.t - sd.r)) x.2)).head?, v.1 < sd.r := by
      intro v hv
      cases U with
      | nil => simp at hv
      | cons u us => simp at hv; subst hv; exact hUr u (by simp)
    refine ⟨?_, head_lt_D3 (fun v hv => lt_of_lt_of_le (hVr v hv) hρ)⟩
    rw [hrel_iff_hcols_D3, hcols_cons_D3, ← hrel_eq_hcols_D3]
    refine ⟨⟨hhead _ (colH_shiftH_D3 hU _ _) hVr, fun x hx => ?_⟩, ?_⟩
    · rw [List.mem_append] at hx
      rcases hx with hx | hx
      · exact hQ'h x hx
      · obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx
        exact hrel_shift_D3 (hUh y hy) _ _
    · rw [Hole.fill_eq_put]
      refine hrel_put_D3 Z _ _ ((routeOK_shift_D3 _ _ _ _).2 hR) (hrel_shift_D3 hB _ _) hZ ?_
      rw [routeCol_shift_D3, hRc]; exact hZle


theorem routeCol_skip_D3 (F : Forest) (k : Nat) : routeCol_D3 k F = routeCol_D3 0 (skipLayers F k) := by
  simp [routeCol_D3, skipLayers]

/-- Data of an ordinary step for relative H. -/
theorem ord_hdata_D3 {A : Forest} {sd : StopData} {rd : RootData} (hH : CondH A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) :
    let F := (A.forestAt rd.col.path).getD Tree.empty
    let U := ((A.colAt rd.col).getD []).drop rd.cursor
    ColH_D3 (sd.Q ++ [(sd.r, Tree.empty)]) ∧ (∀ x ∈ sd.Q, HRel_D3 x.2) ∧
    ColH_D3 U ∧ (∀ x ∈ U, HRel_D3 x.2) ∧
    (rd.owner = false → HRel_D3 (.node (F.cols.drop (rd.idx + 1))) ∧
      routeCol_D3 (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) =
        sd.Q ++ [(sd.r, Tree.empty)]) ∧
    (rd.owner = true → ∀ x, U.getLast? = some x →
      routeCol_D3 (sd.depth - rd.layer - 1) x.2 = sd.Q ++ [(sd.r, Tree.empty)]) := by
  intro F U
  have hA := (condH_iff_hrel_D3 A).1 hH
  obtain ⟨h1, -, -, h4, -⟩ := stopData_core hsd
  obtain ⟨hcolsd, -⟩ := stopData_spec hsd
  obtain ⟨hle, hfa, hr, hidx, howner, hcol⟩ := root_facts_D3 hsd hrd
  obtain ⟨-, -, -, -, -, hmem, -, -⟩ := rootData_spec hsd hrd
  have hF : F = skipLayers A rd.layer := by simp [F, hfa]
  obtain ⟨hQc, hQh⟩ := hrel_colAt_D3 hA hcolsd
  obtain ⟨R, hR⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff A rd.col).1 hmem)
  obtain ⟨hRc, hRh⟩ := hrel_colAt_D3 hA hR
  have hU : U = R.drop rd.cursor := by simp [U, hR]
  have hlast : ∀ m, rd.layer + m = sd.depth → routeCol_D3 m (skipLayers A rd.layer) =
      sd.Q ++ [(sd.r, Tree.empty)] := by
    intro m hm
    rw [routeCol_skip_D3, skipLayers_add, hm]
    simp [routeCol_D3, skipLayers, h4]
  refine ⟨hQc, fun x hx => hQh x (List.mem_append_left _ hx), ?_, ?_, ?_, ?_⟩
  · rw [hU]; exact hRc.drop _
  · rw [hU]; exact fun x hx => hRh x (List.mem_of_mem_drop hx)
  · intro hown
    rw [hF]
    have hlt : rd.idx + 1 < (skipLayers A rd.layer).cols.length := by
      have : ¬ rd.idx + 1 = (skipLayers A rd.layer).cols.length := by rw [← howner, hown]; simp
      omega
    refine ⟨?_, ?_⟩
    · rw [hrel_iff_hcols_D3]
      exact hcols_drop_D3 ((hrel_eq_hcols_D3 _).1 (hrel_forestAt_D3 hA hfa)) _
    · rcases Nat.eq_zero_or_pos (sd.depth - rd.layer) with h0 | h0
      · rw [h0]
        have := hlast 0 (by omega)
        simp only [routeCol_D3, skipLayers] at this ⊢
        show ((skipLayers A rd.layer).cols.drop (rd.idx + 1)).getLast?.getD [] = _
        rw [List.getLast?_drop, if_neg (by omega)]; exact this
      · obtain ⟨i, hi⟩ : ∃ i, sd.depth - rd.layer = i + 1 := ⟨_, (Nat.succ_pred_eq_of_ne_zero (by omega)).symm⟩
        rw [hi]
        have := hlast (i + 1) (by omega)
        have hnx : nextLayer (.node ((skipLayers A rd.layer).cols.drop (rd.idx + 1))) =
            nextLayer (skipLayers A rd.layer) := by
          have e : (Tree.node ((skipLayers A rd.layer).cols.drop (rd.idx + 1))).cols.getLast? =
              (skipLayers A rd.layer).cols.getLast? := by
            show ((skipLayers A rd.layer).cols.drop (rd.idx + 1)).getLast? = _
            rw [List.getLast?_drop, if_neg (by omega)]
          simp only [nextLayer, lastEntry?, e]
        simp only [routeCol_D3, skipLayers] at this ⊢
        rw [hnx]; exact this
  · intro hown x hx
    have hidx' := howner.1 hown
    rw [hU] at hx
    have hx' : R.getLast? = some x := by
      rw [List.getLast?_drop] at hx; split at hx
      · cases hx
      · exact hx
    have hsome : (skipLayers A rd.layer).cols.getLast? = some R := by
      rw [List.getLast?_eq_getElem?, show (skipLayers A rd.layer).cols.length - 1 = rd.idx by omega,
        ← hcol, hR]
    have hnx := nextLayer_of_last hsome (show R.getLast? = some (x.1, x.2) from hx')
    have := hlast (sd.depth - rd.layer) (by omega)
    rw [routeCol_skip_D3] at this ⊢
    have hlt := rootData_layer_lt hsd hrd hown
    rw [show sd.depth - rd.layer = (sd.depth - rd.layer - 1) + 1 by omega, skipLayers, hnx] at this
    exact this

theorem empty_le_D3 (X : Forest) : (Tree.empty : Forest) ≤ X := by
  show Tree.cmp compare _ _ ≠ .gt
  obtain ⟨xc⟩ := X
  cases xc <;> simp [Tree.empty, Tree.cmp, Tree.cmpCols]

-- T3.2x (txt:345-349): ordinary outputs satisfy H (strict decrease is the spine's `expand_lt`)
theorem condH_ord {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .ordinary)
    (hB : expand A n = some B) : CondH B := by
  obtain ⟨sd, rd, hsd, hrd, rfl, -⟩ := ord_output_D3 hL hk hB
  obtain ⟨hrt, -, hU, hbodyR, hownerR⟩ := ord_vdata_D3 hL.1 hsd hrd
  obtain ⟨hQc, hQh, hUc, hUh, hbody, howner⟩ := ord_hdata_D3 hL.2.2.1 hsd hrd
  obtain ⟨hR, -⟩ := stop_route_top_D3 hsd
  obtain ⟨-, -, -, h4, -⟩ := stopData_core hsd
  have hrc : routeCol_D3 sd.depth A = sd.Q ++ [(sd.r, Tree.empty)] := by
    simp [routeCol_D3, h4]
  rw [condH_iff_hrel_D3]
  have := ordLoop_induct_D3 (step := ordStep sd rd ((A.forestAt rd.col.path).getD Tree.empty)
      (((A.colAt rd.col).getD []).drop rd.cursor))
    (P := fun k Z => HRel_D3 Z ∧
      Z ≤ .node [Tree.mapCol (shiftVal sd.r (k * (sd.t - sd.r))) (sd.Q ++ [(sd.r, Tree.empty)])]) ?_ n
    Tree.empty ⟨hrel_empty_D3, empty_le_D3 _⟩
  · simp only [Nat.zero_mul, shiftVal_zero_fun, treeMapCol_id_fun, id] at this
    refine hrel_put_D3 _ _ _ hR ((condH_iff_hrel_D3 A).1 hL.2.2.1) this.1 ?_
    rw [hrc]; exact this.2
  · intro k Z _ hZ
    have := hrel_ordStep_D3 (F := (A.forestAt rd.col.path).getD Tree.empty) (k := k) hQc hQh hUc hUh
      (fun x hx => (hU x hx).1)
      (fun h => ⟨(hbodyR h).1, (hbody h).1, (hbody h).2⟩)
      (fun h x hx => ⟨(hownerR h x hx).1, howner h x hx⟩) hZ.1 hZ.2
    exact ⟨this.1, le_of_lt this.2⟩

/-! ### T3.2m helpers (branch E3): the loop, word lengths, entries of a filled hole -/

/-- Steps `lo + c, …, lo + 1` of the ordinary loop applied to `∅`. -/
def loopFrom_E3 (step : Nat → Forest → Forest) : Nat → Nat → Forest
  | _, 0 => Tree.empty
  | lo, c + 1 => step (lo + 1) (loopFrom_E3 step (lo + 1) c)

theorem ordLoop_loopFrom_E3 (step : Nat → Forest → Forest) : ∀ lo c,
    ordLoop step lo (loopFrom_E3 step lo c) = loopFrom_E3 step 0 (lo + c)
  | 0, c => by simp [ordLoop]
  | lo + 1, c => by
    rw [ordLoop, show step (lo + 1) (loopFrom_E3 step (lo + 1) c) = loopFrom_E3 step lo (c + 1)
      from rfl, ordLoop_loopFrom_E3 step lo (c + 1)]
    congr 1; omega

/-- The filling of the hole of layer `j` of `A[n]` (steps `n, …, j+1`; `zs_E3 … 0` is `ordZ`). -/
def zs_E3 (A : Forest) (sd : StopData) (rd : RootData) (n j : Nat) : Forest :=
  loopFrom_E3 (ordStep sd rd ((A.forestAt rd.col.path).getD Tree.empty)
    (((A.colAt rd.col).getD []).drop rd.cursor)) j (n - j)

theorem zs_top_E3 (A : Forest) (sd : StopData) (rd : RootData) (n : Nat) :
    zs_E3 A sd rd n n = Tree.empty := by
  simp [zs_E3, loopFrom_E3]

theorem zs_step_E3 (A : Forest) (sd : StopData) (rd : RootData) {n j : Nat} (hj : j < n) :
    zs_E3 A sd rd n j = ordStep sd rd ((A.forestAt rd.col.path).getD Tree.empty)
      (((A.colAt rd.col).getD []).drop rd.cursor) (j + 1) (zs_E3 A sd rd n (j + 1)) := by
  simp only [zs_E3]
  rw [show n - j = (n - (j + 1)) + 1 by omega]
  rfl

theorem ordZ_eq_zs_E3 (A : Forest) (sd : StopData) (rd : RootData) (n : Nat) :
    ordZ A sd rd n = zs_E3 A sd rd n 0 := by
  have := ordLoop_loopFrom_E3 (ordStep sd rd ((A.forestAt rd.col.path).getD Tree.empty)
    (((A.colAt rd.col).getD []).drop rd.cursor)) n 0
  simp only [loopFrom_E3, Nat.add_zero] at this
  simp only [ordZ, zs_E3, Nat.sub_zero]
  exact this

/-! Word lengths. -/

/-- The length of the (generic) word of a forest. -/
def N_E3 (X : Forest) : Nat := (gwordAt 0 X).length

theorem len_gwordAt_E3 (e : Nat) (X : Forest) : (gwordAt e X).length = N_E3 X := by
  have h := wordAt_add 0 e X
  rw [Nat.zero_add] at h
  rw [N_E3, gwordAt_eq_map_wordAt, gwordAt_eq_map_wordAt, List.length_map, List.length_map, h,
    List.length_map]

theorem gwordCols_append_E3 {α : Type} (e : Nat) (l₁ l₂ : List (List (α × Tree α))) :
    gwordCols e (l₁ ++ l₂) = gwordCols e l₁ ++ gwordCols e l₂ := by
  induction l₁ with
  | nil => rfl
  | cons c l ih => simp only [List.cons_append, gwordCols, ih, List.append_assoc]

theorem gwordLater_append_E3 {α : Type} (e : Nat) (l₁ l₂ : List (α × Tree α)) :
    gwordLater e (l₁ ++ l₂) = gwordLater e l₁ ++ gwordLater e l₂ := by
  induction l₁ with
  | nil => rfl
  | cons x l ih =>
    obtain ⟨p, h⟩ := x
    simp only [List.cons_append, gwordLater, ih, List.append_assoc]

theorem gwordCol_append_E3 {α : Type} (e : Nat) {l₁ : List (α × Tree α)} (h : l₁ ≠ [])
    (l₂ : List (α × Tree α)) : gwordCol e (l₁ ++ l₂) = gwordCol e l₁ ++ gwordLater e l₂ := by
  cases l₁ with
  | nil => exact absurd rfl h
  | cons x l =>
    obtain ⟨p, hh⟩ := x
    simp only [List.cons_append, gwordCol, gwordLater_append_E3, List.append_assoc]

theorem gwordAt_empty_E3 {α : Type} (e : Nat) : gwordAt e (Tree.empty : Tree α) = [] := rfl

theorem gwordCol_snoc_E3 {α : Type} (e : Nat) (l : List (α × Tree α)) (q : α) (H : Tree α) :
    gwordCol e (l ++ [(q, H)]) = gwordCol e (l ++ [(q, Tree.empty)]) ++ gwordAt (e + 1) H := by
  cases l with
  | nil => simp [gwordCol, gwordLater, gwordAt_empty_E3]
  | cons x l =>
    obtain ⟨p, h⟩ := x
    rw [gwordCol_append_E3 e (List.cons_ne_nil _ _), gwordCol_append_E3 e (List.cons_ne_nil _ _)]
    simp [gwordLater, gwordAt_empty_E3]

theorem len_later_entry_E3 {α : Type} (e : Nat) : ∀ (col : List (α × Tree α)) (i : Nat)
    (x : α × Tree α), col[i]? = some x → (gwordAt (e + 1) x.2).length < (gwordLater e col).length
  | [], _, _, h => by simp at h
  | (p, h') :: rest, 0, x, h => by
    simp only [List.getElem?_cons_zero, Option.some.injEq] at h
    subst h
    simp [gwordLater]
  | (p, h') :: rest, i + 1, x, h => by
    simp only [List.getElem?_cons_succ] at h
    have := len_later_entry_E3 e rest i x h
    simp [gwordLater]; omega

theorem len_col_entry_E3 {α : Type} (e : Nat) (col : List (α × Tree α)) (i : Nat)
    (x : α × Tree α) (h : col[i]? = some x) :
    (gwordAt (e + 1) x.2).length < (gwordCol e col).length := by
  cases col with
  | nil => simp at h
  | cons y rest =>
    obtain ⟨p, h'⟩ := y
    cases i with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.some.injEq] at h
      subst h
      simp [gwordCol]
    | succ i =>
      simp only [List.getElem?_cons_succ] at h
      have := len_later_entry_E3 e rest i x h
      simp [gwordCol]; omega

theorem len_cols_col_E3 {α : Type} (e : Nat) : ∀ (cols : List (List (α × Tree α))) (j : Nat)
    (col : List (α × Tree α)), cols[j]? = some col →
      (gwordCol e col).length ≤ (gwordCols e cols).length
  | [], _, _, h => by simp at h
  | c :: rest, 0, col, h => by
    simp only [List.getElem?_cons_zero, Option.some.injEq] at h
    subst h; simp [gwordCols]
  | c :: rest, j + 1, col, h => by
    simp only [List.getElem?_cons_succ] at h
    have := len_cols_col_E3 e rest j col h
    simp [gwordCols]; omega

/-- An entry's height has a shorter word than any forest containing the entry. -/
theorem N_entry_lt_E3 : ∀ (X : Forest) (e : EntryAddr) (x : Nat × Forest),
    X.entryAt e = some x → N_E3 x.2 < N_E3 X := by
  intro X e
  obtain ⟨⟨P, j⟩, i⟩ := e
  induction P generalizing X with
  | nil =>
    intro x h
    obtain ⟨cols⟩ := X
    rw [entryAt_nil_D3] at h
    cases hc : cols[j]? with
    | none => simp [hc] at h
    | some col =>
      simp only [hc, Option.bind_some] at h
      have h1 := len_col_entry_E3 0 col i x h
      have h2 := len_cols_col_E3 0 cols j col hc
      rw [len_gwordAt_E3] at h1
      unfold N_E3 at h1 ⊢
      simp only [gwordAt] at h2 ⊢
      omega
  | cons s P ih =>
    intro x h
    obtain ⟨c, m⟩ := s
    obtain ⟨cols⟩ := X
    rw [entryAt_cons_D3] at h
    cases hc : cols[c]? with
    | none => simp [hc] at h
    | some col =>
      cases hm : col[m]? with
      | none => simp [hc, hm] at h
      | some y =>
        simp only [hc, hm, Option.bind_some] at h
        have h0 := ih y.2 x h
        have h1 := len_col_entry_E3 0 col m y hm
        have h2 := len_cols_col_E3 0 cols c col hc
        rw [len_gwordAt_E3] at h1
        unfold N_E3 at h1 h0 ⊢
        simp only [gwordAt] at h2 h0 ⊢
        omega

/-! Entries of a filled hole. -/

/-- The route path of depth `k` (the `(column, entry)` steps of the last-column, last-entry
route). -/
def rpath_E3 : Nat → Forest → List (Nat × Nat)
  | 0, _ => []
  | k + 1, F => (F.cols.length - 1, (F.cols.getLast?.getD []).length - 1) ::
      rpath_E3 k (nextLayer F)

/-- The index of the hole column (the route column at depth `k`) in its forest. -/
def hcol_E3 (k : Nat) (F : Forest) : Nat := (skipLayers F k).cols.length - 1

/-- A column at or after the hole column at depth `k`, or inside one. -/
def InHole_E3 (k : Nat) (F : Forest) (c : ColAddr) : Prop :=
  (c.path = rpath_E3 k F ∧ hcol_E3 k F ≤ c.col) ∨
    ∃ c' i rest, c.path = rpath_E3 k F ++ (c', i) :: rest ∧ hcol_E3 k F ≤ c'

/-- The address of a hole column relative to the filling. -/
def unplace_E3 (k : Nat) (F : Forest) (c : ColAddr) : ColAddr :=
  match c.path.drop (rpath_E3 k F).length with
  | [] => ⟨[], c.col - hcol_E3 k F⟩
  | (c', i) :: rest => ⟨(c' - hcol_E3 k F, i) :: rest, c.col⟩

/-- A route container above depth `k`. -/
def IsRoute_E3 (k : Nat) (F : Forest) (e : EntryAddr) : Prop := e.heightPath <+: rpath_E3 k F

theorem rpath_snoc_E3 (k : Nat) (cs : List Column) (es : Column) (q : Nat) (H : Forest) :
    rpath_E3 (k + 1) (.node (cs ++ [es ++ [(q, H)]])) = (cs.length, es.length) :: rpath_E3 k H := by
  simp [rpath_E3, Tree.cols, nextLayer_snoc_D3]

theorem hcol_snoc_E3 (k : Nat) (cs : List Column) (es : Column) (q : Nat) (H : Forest) :
    hcol_E3 (k + 1) (.node (cs ++ [es ++ [(q, H)]])) = hcol_E3 k H := by
  simp [hcol_E3, skipLayers, nextLayer_snoc_D3]

theorem snoc_entry_ne_E3 (cs : List Column) (es : Column) (q : Nat) (Y Y' : Forest) {c m : Nat}
    (h : (c, m) ≠ (cs.length, es.length)) :
    ((cs ++ [es ++ [(q, Y)]])[c]?).bind (·[m]?) = ((cs ++ [es ++ [(q, Y')]])[c]?).bind (·[m]?) := by
  rcases Nat.lt_trichotomy c cs.length with hc | rfl | hc
  · rw [List.getElem?_append_left hc, List.getElem?_append_left hc]
  · have hm : m ≠ es.length := fun hm => h (by rw [hm])
    simp only [List.getElem?_append_right (le_refl _), Nat.sub_self, List.getElem?_cons_zero,
      Option.bind_some]
    rcases Nat.lt_or_gt_of_ne hm with hm | hm
    · rw [List.getElem?_append_left hm, List.getElem?_append_left hm]
    · rw [List.getElem?_append_right (by omega), List.getElem?_append_right (by omega)]
      simp [show m - es.length ≠ 0 by omega]
  · rw [List.getElem?_eq_none (by simp; omega), List.getElem?_eq_none (by simp; omega)]

theorem snoc_entry_eq_E3 (cs : List Column) (es : Column) (q : Nat) (Y : Forest) :
    ((cs ++ [es ++ [(q, Y)]])[cs.length]?).bind (·[es.length]?) = some (q, Y) := by
  simp

/-- The entries of `A_{0,0,k,Z}(F)`: hole addresses read `Z`, route containers have filled
heights, every other entry is unchanged. -/
theorem put_entryAt_E3 (Z : Forest) : ∀ (k : Nat) (F : Forest), RouteOK_D3 k F →
    ∀ (e : EntryAddr),
    (InHole_E3 k F e.col → (replaceAt 0 0 Z k F).entryAt e = Z.entryAt ⟨unplace_E3 k F e.col, e.idx⟩ ∧
        ∀ b, e.col.num b = (unplace_E3 k F e.col).num (b + routeNum_D3 k F)) ∧
    (¬ InHole_E3 k F e.col → IsRoute_E3 k F e →
      (replaceAt 0 0 Z k F).entryAt e =
        (F.entryAt e).map (fun x => (x.1, replaceAt 0 0 Z (k - e.col.path.length - 1) x.2))) ∧
    (¬ InHole_E3 k F e.col → ¬ IsRoute_E3 k F e → (replaceAt 0 0 Z k F).entryAt e = F.entryAt e)
  | 0, .node cols, hR, ⟨⟨P, j⟩, i⟩ => by
    have hc : cols ≠ [] := hR
    have hlen : cols.dropLast.length = hcol_E3 0 (.node cols) := by
      simp [hcol_E3, skipLayers, Tree.cols]
    rw [put_zero_D3 Z hc]
    obtain ⟨zc⟩ := Z
    have hnr : ¬ IsRoute_E3 0 (.node cols) ⟨⟨P, j⟩, i⟩ := by
      simp [IsRoute_E3, rpath_E3, EntryAddr.heightPath]
    cases P with
    | nil =>
      have hiff : InHole_E3 0 (.node cols) ⟨[], j⟩ ↔ hcol_E3 0 (.node cols) ≤ j := by
        simp [InHole_E3, rpath_E3]
      refine ⟨fun hh => ?_, fun _ h => absurd h hnr, fun hh _ => ?_⟩
      · rw [hiff] at hh
        refine ⟨?_, fun b => ?_⟩
        · simp only [entryAt_nil_D3, Tree.cols, unplace_E3, rpath_E3, List.length_nil,
            List.drop_zero]
          rw [List.getElem?_append_right (by omega), hlen]
        · simp only [unplace_E3, rpath_E3, List.length_nil, List.drop_zero, num_nil_D3,
            routeNum_D3, Tree.cols]
          simp only [hcol_E3, skipLayers, Tree.cols] at hh ⊢
          omega
      · rw [hiff] at hh
        simp only [entryAt_nil_D3, Tree.cols]
        have hj : j < cols.length - 1 := by
          simp only [hcol_E3, skipLayers, Tree.cols] at hh; omega
        rw [List.getElem?_append_left (by omega), List.getElem?_dropLast, if_pos hj]
    | cons s P =>
      obtain ⟨c, m⟩ := s
      have hiff : InHole_E3 0 (.node cols) ⟨(c, m) :: P, j⟩ ↔ hcol_E3 0 (.node cols) ≤ c := by
        simp [InHole_E3, rpath_E3]
      refine ⟨fun hh => ?_, fun _ h => absurd h hnr, fun hh _ => ?_⟩
      · rw [hiff] at hh
        refine ⟨?_, fun b => ?_⟩
        · simp only [entryAt_cons_D3, Tree.cols, unplace_E3, rpath_E3, List.length_nil,
            List.drop_zero]
          rw [List.getElem?_append_right (by omega), hlen]
        · simp only [unplace_E3, rpath_E3, List.length_nil, List.drop_zero, num_cons_D3,
            routeNum_D3, Tree.cols]
          simp only [hcol_E3, skipLayers, Tree.cols] at hh ⊢
          congr 1; omega
      · rw [hiff] at hh
        simp only [entryAt_cons_D3, Tree.cols]
        have hj : c < cols.length - 1 := by
          simp only [hcol_E3, skipLayers, Tree.cols] at hh; omega
        rw [List.getElem?_append_left (by omega), List.getElem?_dropLast, if_pos hj]
  | k + 1, F, hR, ⟨⟨P, j⟩, i⟩ => by
    obtain ⟨cs, es, q, H, rfl, hR'⟩ := hR
    rw [put_succ_D3]
    have hrp := rpath_snoc_E3 k cs es q H
    have hhc := hcol_snoc_E3 k cs es q H
    cases P with
    | nil =>
      have hnh : ¬ InHole_E3 (k + 1) (.node (cs ++ [es ++ [(q, H)]])) ⟨[], j⟩ := by
        simp [InHole_E3, hrp]
      refine ⟨fun h => absurd h hnh, fun _ hr => ?_, fun _ hr => ?_⟩
      · simp only [IsRoute_E3, EntryAddr.heightPath, hrp, List.nil_append,
          List.cons_prefix_cons, List.nil_prefix, and_true, Prod.mk.injEq] at hr
        obtain ⟨rfl, rfl⟩ := hr
        simp only [entryAt_nil_D3, snoc_entry_eq_E3, Option.map_some, List.length_nil]
        rfl
      · have hne : (j, i) ≠ (cs.length, es.length) := by
          rintro he
          apply hr
          simp only [IsRoute_E3, EntryAddr.heightPath, hrp, List.nil_append, he]
          exact List.cons_prefix_cons.2 ⟨rfl, List.nil_prefix⟩
        simp only [entryAt_nil_D3]
        exact snoc_entry_ne_E3 cs es q _ _ hne
    | cons s P =>
      obtain ⟨c, m⟩ := s
      by_cases hs : (c, m) = (cs.length, es.length)
      · simp only [Prod.mk.injEq] at hs
        obtain ⟨rfl, rfl⟩ := hs
        have ih := put_entryAt_E3 Z k H hR' ⟨⟨P, j⟩, i⟩
        have hh : InHole_E3 (k + 1) (.node (cs ++ [es ++ [(q, H)]])) ⟨(cs.length, es.length) :: P, j⟩ ↔
            InHole_E3 k H ⟨P, j⟩ := by
          simp only [InHole_E3, hrp, hhc, List.cons_append, List.cons.injEq, true_and]
        have hr : IsRoute_E3 (k + 1) (.node (cs ++ [es ++ [(q, H)]]))
            ⟨⟨(cs.length, es.length) :: P, j⟩, i⟩ ↔ IsRoute_E3 k H ⟨⟨P, j⟩, i⟩ := by
          simp only [IsRoute_E3, EntryAddr.heightPath, hrp, List.cons_append,
            List.cons_prefix_cons, true_and]
        have hu : unplace_E3 (k + 1) (.node (cs ++ [es ++ [(q, H)]])) ⟨(cs.length, es.length) :: P, j⟩ =
            unplace_E3 k H ⟨P, j⟩ := by
          simp only [unplace_E3, hrp, List.length_cons, hhc]
          rw [show (rpath_E3 k H).length + 1 = 1 + (rpath_E3 k H).length by omega,
            ← List.drop_drop]
          rfl
        simp only [entryAt_cons_D3, snoc_entry_eq_E3, Option.bind_some]
        rw [hh, hr, hu]
        refine ⟨fun h => ⟨(ih.1 h).1, fun b => ?_⟩, fun h1 h2 => ?_, ih.2.2⟩
        · rw [num_cons_D3, (ih.1 h).2 (b + cs.length + 1)]
          simp only [routeNum_D3, Tree.cols, nextLayer_snoc_D3, List.length_append,
            List.length_singleton]
          congr 1; omega
        · rw [ih.2.1 h1 h2]
          simp only [List.length_cons]
          congr 2; funext x; congr 2; omega
      · have hnh : ¬ InHole_E3 (k + 1) (.node (cs ++ [es ++ [(q, H)]])) ⟨(c, m) :: P, j⟩ := by
          simp only [InHole_E3, hrp, List.cons_append, List.cons.injEq, not_or, not_and,
            not_exists]
          exact ⟨fun h => absurd h.1 hs, fun _ _ _ h => absurd h.1 hs⟩
        have hnr : ¬ IsRoute_E3 (k + 1) (.node (cs ++ [es ++ [(q, H)]])) ⟨⟨(c, m) :: P, j⟩, i⟩ := by
          simp only [IsRoute_E3, EntryAddr.heightPath, hrp, List.cons_append,
            List.cons_prefix_cons, not_and]
          exact fun h => absurd h hs
        refine ⟨fun h => absurd h hnh, fun _ h => absurd h hnr, fun _ _ => ?_⟩
        simp only [entryAt_cons_D3]
        rw [snoc_entry_ne_E3 cs es q _ H hs]

/-! Words of filled holes and first decreases. -/

theorem gword_put_E3 (Z : Forest) : ∀ (k : Nat) (F : Forest), RouteOK_D3 k F → ∀ e,
    gwordAt e (replaceAt 0 0 Z k F) = gwordAt e (replaceAt 0 0 Tree.empty k F) ++ gwordAt (e + k) Z
  | 0, .node cols, hR, e => by
    have hc : cols ≠ [] := hR
    rw [put_zero_D3 Z hc, put_zero_D3 _ hc]
    obtain ⟨zc⟩ := Z
    simp [gwordAt, gwordCols_append_E3, Tree.empty, Tree.cols]
  | k + 1, F, hR, e => by
    obtain ⟨cs, es, q, H, rfl, hR'⟩ := hR
    rw [put_succ_D3, put_succ_D3]
    simp only [gwordAt, gwordCols_append_E3, gwordCols, List.append_nil]
    rw [gwordCol_snoc_E3, gwordCol_snoc_E3 e _ _ (replaceAt 0 0 Tree.empty k H),
      gword_put_E3 Z k H hR' (e + 1)]
    simp only [List.append_assoc]
    rw [show e + 1 + k = e + (k + 1) by omega]

theorem N_put_E3 {Z : Forest} {k : Nat} {F : Forest} (hR : RouteOK_D3 k F) :
    N_E3 (replaceAt 0 0 Z k F) = N_E3 (replaceAt 0 0 Tree.empty k F) + N_E3 Z := by
  unfold N_E3
  rw [gword_put_E3 Z k F hR 0, List.length_append]
  simp only [len_gwordAt_E3]

theorem N_self_E3 {k : Nat} {F : Forest} (hR : RouteOK_D3 k F) :
    N_E3 F = N_E3 (replaceAt 0 0 Tree.empty k F) + N_E3 (.node [routeCol_D3 k F]) := by
  conv_lhs => rw [← put_self_D3 k F hR]
  exact N_put_E3 hR

theorem N_shift_E3 (r d : Nat) (X : Forest) : N_E3 (shift r d X) = N_E3 X := by
  unfold N_E3 shift; rw [gwordAt_map, List.length_map]

theorem N_col_pos_E3 (col : Column) : 0 < N_E3 (.node [col]) := by
  unfold N_E3
  obtain ⟨A, rest, h, -⟩ := gwordCol_head 0 col
  simp [gwordAt, gwordCols, h]

section FirstDecE3
variable {α : Type} [LinearOrder α]

theorem firstDec_append_E3 (P : List α) {X X' : List α} {a : Nat} (h : FirstDec X X' a) :
    FirstDec (P ++ X) (P ++ X') (P.length + a) := by
  obtain ⟨h1, h2, h3⟩ := h
  refine ⟨by rw [List.take_length_add_append, List.take_length_add_append, h1], by simp; omega, ?_⟩
  rcases h3 with ⟨h3, h4⟩ | ⟨x, x', hx, hx', hlt⟩
  · exact Or.inl ⟨by simp; omega, by simp; omega⟩
  · refine Or.inr ⟨x, x', ?_, ?_, hlt⟩
    · rw [List.getElem?_append_right (by omega)]; simpa using hx
    · rw [List.getElem?_append_right (by omega)]; simpa using hx'

theorem firstDec_map_E3 {β : Type} [LinearOrder β] {f : α → β} (hf : StrictMono f)
    {X X' : List α} {a : Nat} (h : FirstDec X X' a) : FirstDec (X.map f) (X'.map f) a := by
  obtain ⟨h1, h2, h3⟩ := h
  refine ⟨by rw [← List.map_take, ← List.map_take, h1], by simpa using h2, ?_⟩
  rcases h3 with ⟨h3, h4⟩ | ⟨x, x', hx, hx', hlt⟩
  · exact Or.inl ⟨by simpa using h3, by simpa using h4⟩
  · exact Or.inr ⟨f x, f x', by simp [hx], by simp [hx'], hf hlt⟩

theorem lt_of_firstDec_E3 {X X' : List α} {a : Nat} (h : FirstDec X X' a) : X' < X := by
  obtain ⟨h1, h2, h3⟩ := h
  rw [← List.take_append_drop a X, ← List.take_append_drop a X', h1,
    list_append_lt_append_left]
  rcases h3 with ⟨h3, h4⟩ | ⟨x, x', hx, hx', hlt⟩
  · rw [List.drop_eq_nil_of_le (by omega)]
    obtain ⟨y, ys, hy⟩ := List.exists_cons_of_ne_nil (by simp; omega : X.drop a ≠ [])
    rw [hy]; exact List.nil_lt_cons _ _
  · obtain ⟨hl1, hx⟩ := List.getElem?_eq_some_iff.1 hx
    obtain ⟨hl2, hx'⟩ := List.getElem?_eq_some_iff.1 hx'
    rw [List.drop_eq_getElem_cons (l := X) hl1, List.drop_eq_getElem_cons (l := X') hl2, hx, hx']
    exact List.cons_lt_cons_iff.2 (Or.inl hlt)

theorem firstDec_ends_E3 (P X : List α) (hX : X ≠ []) : FirstDec (P ++ X) P P.length := by
  refine ⟨by simp, le_refl _, Or.inl ⟨rfl, ?_⟩⟩
  have : 0 < X.length := List.length_pos_iff.2 hX
  simp; omega

end FirstDecE3

theorem gatom_lt_E3 {α : Type} [LinearOrder α] {x y : Nat} {m m' : Nat} {l l' : WithBot α}
    (h : x < y ∨ (x = y ∧ (m < m' ∨ (m = m' ∧ l < l')))) :
    (toLex (x, toLex (m, l)) : GAtom α) < toLex (y, toLex (m', l')) := by
  rw [Prod.Lex.lt_iff]
  rcases h with h | ⟨rfl, h⟩
  · exact Or.inl h
  · refine Or.inr ⟨rfl, ?_⟩
    show toLex (m, l) < toLex (m', l')
    rw [Prod.Lex.lt_iff]
    rcases h with h | ⟨rfl, h⟩
    · exact Or.inl h
    · exact Or.inr ⟨rfl, h⟩

/-- The first decrease of a head column `P ⌢ V` against the stopping column `P ⌢ [(s, ∅)]`. -/
theorem head_firstDec_E3 (e : Nat) (P V : Column) (rest : List Column) (s : Nat)
    (hV : ∀ v ∈ V.head?, v.1 < s) :
    FirstDec (gwordAt e (Tree.node [P ++ [(s, Tree.empty)]]))
      (gwordAt e (Tree.node ((P ++ V) :: rest)))
      ((gwordAt e (Tree.node [P ++ [(s, Tree.empty)]])).length - 1) := by
  simp only [gwordAt, gwordCols, List.append_nil]
  rcases eq_or_ne P [] with rfl | hP
  · simp only [List.nil_append, gwordCol, gwordAt_empty_E3, gwordLater, List.append_nil,
      List.length_singleton, Nat.sub_self]
    refine ⟨by simp, Nat.zero_le _, Or.inr ?_⟩
    cases V with
    | nil =>
      refine ⟨_, toLex (2 * e, toLex (0, (⊥ : WithBot Nat))), rfl, by simp [gwordCol],
        gatom_lt_E3 (Or.inr ⟨rfl, Or.inl (by omega)⟩)⟩
    | cons v vs =>
      obtain ⟨p, h⟩ := v
      have hp : p < s := hV (p, h) (by simp)
      refine ⟨_, toLex (2 * e, toLex (1, (p : WithBot Nat))), rfl, by simp [gwordCol]; rfl,
        gatom_lt_E3 (Or.inr ⟨rfl, Or.inr ⟨rfl, ?_⟩⟩)⟩
      exact WithBot.coe_lt_coe.2 hp
  · rw [gwordCol_append_E3 e hP, gwordCol_append_E3 e hP]
    simp only [gwordLater, gwordAt_empty_E3, List.append_nil, List.length_append,
      List.length_singleton, Nat.add_sub_cancel, List.append_assoc]
    show FirstDec _ _ ((gwordCol e P).length + 0)
    apply firstDec_append_E3
    cases V with
    | cons v vs =>
      obtain ⟨p, h⟩ := v
      have hp : p < s := hV (p, h) (by simp)
      refine ⟨by simp, Nat.zero_le _, Or.inr ⟨_, toLex (2 * e + 1, toLex (0, (p : WithBot Nat))), rfl,
        by simp [gwordLater]; rfl, ?_⟩⟩
      exact gatom_lt_E3 (Or.inr ⟨rfl, Or.inr ⟨rfl, WithBot.coe_lt_coe.2 hp⟩⟩)
    | nil =>
      cases rest with
      | nil => exact ⟨by simp, by simp, Or.inl ⟨by simp [gwordLater, gwordCols], by simp⟩⟩
      | cons c cs =>
        obtain ⟨A, l, hA, hA1⟩ := gwordCol_head e c
        refine ⟨by simp, Nat.zero_le _, Or.inr ⟨_, A, rfl, by simp [gwordLater, gwordCols, hA], ?_⟩⟩
        rw [← toLex_ofLex A, Prod.Lex.lt_iff]; left
        show (ofLex A).1 < 2 * e + 1
        omega

/-- The first decrease of a filled continuation against the shifted old height (`k < n`): at the
old closing atom. -/
theorem fill_firstDec_head_E3 {H : Forest} {k : Nat} (hR : RouteOK_D3 k H) {Q : Column} {s : Nat}
    (hc : routeCol_D3 k H = Q ++ [(s, Tree.empty)]) {r δ : Nat} (hs : r ≤ s) {V : Column}
    {rest : List Column} (hV : ∀ v ∈ V.head?, v.1 < r) (e : Nat) :
    FirstDec (gwordAt e (shift r δ H))
      (gwordAt e (replaceAt r δ (.node ((Tree.mapCol (shiftVal r δ) Q ++ V) :: rest)) k H))
      (N_E3 H - 1) := by
  have hRG : RouteOK_D3 k (shift r δ H) := (routeOK_shift_D3 r δ k H).2 hR
  have hcG : routeCol_D3 k (shift r δ H) = Tree.mapCol (shiftVal r δ) Q ++ [(s + δ, Tree.empty)] := by
    rw [routeCol_shift_D3, hc, Tree.treeMapCol_append_D3]
    simp [Tree.mapCol, shiftVal, hs]; rfl
  have h1 := gword_put_E3 (.node [routeCol_D3 k (shift r δ H)]) k _ hRG e
  rw [put_self_D3 k _ hRG] at h1
  rw [replaceAt_eq_shift, h1,
    gword_put_E3 (.node ((Tree.mapCol (shiftVal r δ) Q ++ V) :: rest)) k _ hRG e, hcG]
  have h3 := head_firstDec_E3 (e + k) (Tree.mapCol (shiftVal r δ) Q) V rest (s + δ)
    (fun v hv => lt_of_lt_of_le (hV v hv) (by omega))
  have h4 := firstDec_append_E3 (gwordAt e (replaceAt 0 0 Tree.empty k (shift r δ H))) h3
  convert h4 using 1
  have hl : (gwordAt e (shift r δ H)).length = N_E3 H := by rw [len_gwordAt_E3, N_shift_E3]
  rw [h1, hcG, List.length_append] at hl
  have hpos := N_col_pos_E3 (Tree.mapCol (shiftVal r δ) Q ++ [(s + δ, Tree.empty)])
  simp only [len_gwordAt_E3] at hl ⊢
  omega

/-- The first decrease of the last continuation (`k = n`, empty filling): the old stopping column
is deleted. -/
theorem fill_firstDec_empty_E3 {H : Forest} {k : Nat} (hR : RouteOK_D3 k H) (r δ e : Nat) :
    FirstDec (gwordAt e (shift r δ H)) (gwordAt e (replaceAt r δ Tree.empty k H))
      (N_E3 H - N_E3 (.node [routeCol_D3 k H])) := by
  have hRG : RouteOK_D3 k (shift r δ H) := (routeOK_shift_D3 r δ k H).2 hR
  have h1 := gword_put_E3 (.node [routeCol_D3 k (shift r δ H)]) k _ hRG e
  rw [put_self_D3 k _ hRG] at h1
  rw [replaceAt_eq_shift, h1]
  have hne : gwordAt (e + k) (Tree.node [routeCol_D3 k (shift r δ H)]) ≠ [] := by
    intro h
    have := N_col_pos_E3 (routeCol_D3 k (shift r δ H))
    rw [← len_gwordAt_E3 (e + k), h] at this; simp at this
  convert firstDec_ends_E3 _ _ hne using 1
  have hl : (gwordAt e (shift r δ H)).length = N_E3 H := by rw [len_gwordAt_E3, N_shift_E3]
  rw [h1, List.length_append] at hl
  have : N_E3 (.node [routeCol_D3 k (shift r δ H)]) = N_E3 (.node [routeCol_D3 k H]) := by
    rw [routeCol_shift_D3, ← N_shift_E3 r δ (.node [routeCol_D3 k H])]
    simp [shift, Tree.map, Tree.mapCols]
  simp only [len_gwordAt_E3] at hl ⊢
  rw [← this]; omega

/-! Key words as relabelled words. -/

/-- The label map of `relKey a`, into the lexicographic order. -/
def lab_E3 (a p : Nat) : Bool ×ₗ Nat := toLex (if p < a then (false, p) else (true, p - a))

theorem lab_strictMono_E3 (a : Nat) : StrictMono (lab_E3 a) := by
  intro p q h
  simp only [lab_E3]
  split_ifs with h1 h2 h2
  · exact Prod.Lex.lt_iff.2 (Or.inr ⟨rfl, h⟩)
  · exact Prod.Lex.lt_iff.2 (Or.inl (show false < true by decide))
  · omega
  · exact Prod.Lex.lt_iff.2 (Or.inr ⟨rfl, show p - a < q - a by omega⟩)

theorem gatomMap_strictMono_E3 {α β : Type} [LinearOrder α] [LinearOrder β] {f : α → β}
    (hf : StrictMono f) : StrictMono (GAtom.map f) := by
  intro A B h
  obtain ⟨⟨a1, a2, a3⟩, rfl⟩ : ∃ t : Nat × Nat × WithBot α, A = toLex (t.1, toLex (t.2.1, t.2.2)) :=
    ⟨((ofLex A).1, (ofLex (ofLex A).2).1, (ofLex (ofLex A).2).2), rfl⟩
  obtain ⟨⟨b1, b2, b3⟩, rfl⟩ : ∃ t : Nat × Nat × WithBot α, B = toLex (t.1, toLex (t.2.1, t.2.2)) :=
    ⟨((ofLex B).1, (ofLex (ofLex B).2).1, (ofLex (ofLex B).2).2), rfl⟩
  simp only [GAtom.map, ofLex_toLex]
  rw [Prod.Lex.lt_iff] at h ⊢
  rcases h with h | ⟨h1, h⟩
  · exact Or.inl h
  · refine Or.inr ⟨h1, ?_⟩
    simp only at h ⊢
    rw [Prod.Lex.lt_iff] at h ⊢
    rcases h with h | ⟨h2, h⟩
    · exact Or.inl h
    · exact Or.inr ⟨h2, hf.withBot_map h⟩

theorem keyWord_relKey_E3 (a : Nat) (X : Forest) :
    keyWord (relKey a X) = (gwordAt 0 X).map (GAtom.map (lab_E3 a)) := by
  unfold keyWord relKey
  rw [treeMap_map, gwordAt_map]
  rfl

theorem len_keyWord_E3 (a : Nat) (X : Forest) : (keyWord (relKey a X)).length = N_E3 X := by
  rw [keyWord_relKey_E3, List.length_map]; rfl

/-- First decreases of words are first decreases of key words. -/
theorem firstDec_keyWord_E3 (a : Nat) {X X' : Forest} {b : Nat}
    (h : FirstDec (gwordAt 0 X) (gwordAt 0 X') b) :
    FirstDec (keyWord (relKey a X)) (keyWord (relKey a X')) b := by
  rw [keyWord_relKey_E3, keyWord_relKey_E3]
  exact firstDec_map_E3 (gatomMap_strictMono_E3 (lab_strictMono_E3 a)) h

/-! Route paths of the old forest. -/

theorem cols_length_map_E3 (f : Nat → Nat) (F : Forest) : (Tree.map f F).cols.length = F.cols.length := by
  rw [cols_map_D3, List.length_map]

theorem rpath_map_E3 (f : Nat → Nat) : ∀ (k : Nat) (F : Forest), rpath_E3 k (Tree.map f F) = rpath_E3 k F
  | 0, _ => rfl
  | k + 1, F => by
    simp only [rpath_E3, cols_length_map_E3, nextLayer_map_D3, rpath_map_E3 f k]
    rw [cols_map_D3, List.getLast?_map]
    cases F.cols.getLast? with
    | none => rfl
    | some c => simp [treeMapCol_eq_map]

theorem skipLayers_map_E3 (f : Nat → Nat) : ∀ (k : Nat) (F : Forest),
    skipLayers (Tree.map f F) k = Tree.map f (skipLayers F k)
  | 0, _ => rfl
  | k + 1, F => by simp only [skipLayers, nextLayer_map_D3, skipLayers_map_E3 f k]

theorem hcol_map_E3 (f : Nat → Nat) (k : Nat) (F : Forest) : hcol_E3 k (Tree.map f F) = hcol_E3 k F := by
  simp only [hcol_E3, skipLayers_map_E3, cols_length_map_E3]

theorem rpath_skip_E3 {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    ∀ m i, i + m = sd.depth → rpath_E3 m (skipLayers E i) = sd.col.path.drop i := by
  obtain ⟨-, h2, -, -, h5, -⟩ := stopData_core h
  intro m
  induction m with
  | zero =>
    intro i hi
    simp only [rpath_E3]
    rw [List.drop_eq_nil_of_le (by omega)]
  | succ m ih =>
    intro i hi
    obtain ⟨col, p, hc, hp, -, hpk⟩ := h5 i (by omega)
    rw [rpath_E3, ← skipLayers_succ, ih (i + 1) (by omega),
      List.drop_eq_getElem_cons (l := sd.col.path) (i := i) (by omega)]
    rw [List.getElem?_eq_some_iff] at hpk
    obtain ⟨_, hpk⟩ := hpk
    rw [hpk, hc]
    obtain ⟨es, rfl⟩ := List.getLast?_eq_some_iff.1 hp
    simp

theorem hcol_skip_E3 {E : Forest} {sd : StopData} (h : stopData E = some sd) (m i : Nat)
    (hi : i + m = sd.depth) : hcol_E3 m (skipLayers E i) = sd.col.col := by
  obtain ⟨h1, -⟩ := stopData_core h
  simp only [hcol_E3, skipLayers_add, hi]; omega

/-! Translating relative addresses of a forest on the route into absolute addresses. -/

theorem entryAt_abs_E3 {A G : Forest} {π : List (Nat × Nat)} (hG : A.forestAt π = some G)
    (e : EntryAddr) : A.entryAt ⟨⟨π ++ e.col.path, e.col.col⟩, e.idx⟩ = G.entryAt e := by
  rw [Tree.entryAt_eq_bind, Tree.forestAt_append, hG, Option.bind_some, ← Tree.entryAt_eq_bind]

theorem num_abs_E3 (π : List (Nat × Nat)) (c : ColAddr) :
    (⟨π ++ c.path, c.col⟩ : ColAddr).num 0 = c.num ((π.map (·.1 + 1)).sum) := by
  simp only [ColAddr.num, List.map_append, List.sum_append]; omega

theorem isRoute_abs_E3 {k k' : Nat} {F G : Forest} {π : List (Nat × Nat)}
    (hp : rpath_E3 k' F = π ++ rpath_E3 k G) (e : EntryAddr) :
    IsRoute_E3 k' F ⟨⟨π ++ e.col.path, e.col.col⟩, e.idx⟩ ↔ IsRoute_E3 k G e := by
  simp only [IsRoute_E3, EntryAddr.heightPath, hp, List.append_assoc]
  exact List.prefix_append_right_inj π

theorem inHole_abs_E3 {k k' : Nat} {F G : Forest} {π : List (Nat × Nat)}
    (hp : rpath_E3 k' F = π ++ rpath_E3 k G) (hh : hcol_E3 k' F = hcol_E3 k G) (c : ColAddr) :
    InHole_E3 k' F ⟨π ++ c.path, c.col⟩ ↔ InHole_E3 k G c := by
  simp only [InHole_E3, hp, hh, List.append_assoc, List.append_cancel_left_eq]

/-! Locations of old entries: route containers, the hole region, the query region. -/

/-- `e` lies in the query region: an entry of `Q`, or inside the height of one. -/
def InQ_E3 (sd : StopData) (e : EntryAddr) : Prop :=
  (e.col = sd.col ∧ e.idx < sd.Q.length) ∨
    ∃ i < sd.Q.length, (⟨sd.col, i⟩ : EntryAddr).heightPath <+: e.col.path

/-- Entries outside the route and the hole are hereditary: so is everything in their heights. -/
theorem outside_hered_E3 {S : List (Nat × Nat)} {c0 : Nat} {e0 e : EntryAddr}
    (hr : ¬ e0.heightPath <+: S)
    (hh : ¬ ((e0.col.path = S ∧ c0 ≤ e0.col.col) ∨
      ∃ c' i rest, e0.col.path = S ++ (c', i) :: rest ∧ c0 ≤ c'))
    (hc : e0.heightPath <+: e.col.path) :
    ¬ e.heightPath <+: S ∧ ¬ ((e.col.path = S ∧ c0 ≤ e.col.col) ∨
      ∃ c' i rest, e.col.path = S ++ (c', i) :: rest ∧ c0 ≤ c') := by
  have hc' : e0.heightPath <+: e.heightPath := hc.trans (List.prefix_append _ _)
  refine ⟨fun h => hr (hc'.trans h), ?_⟩
  rintro (⟨h1, -⟩ | ⟨c', i, rest, h1, h2⟩)
  · exact hr (h1 ▸ hc)
  · have hS : S <+: e.col.path := h1 ▸ List.prefix_append _ _
    rcases List.prefix_or_prefix_of_prefix hc hS with h3 | h3
    · exact hr h3
    · -- `S` is a proper prefix of `e0.heightPath`
      have hlen : S.length < e0.heightPath.length := by
        rcases Nat.lt_or_ge S.length e0.heightPath.length with h4 | h4
        · exact h4
        · exact absurd (h3.eq_of_length_le h4 ▸ List.prefix_refl S) (fun h => hr (by
            rw [h3.eq_of_length_le h4]))
      have hlen' : S.length ≤ e0.col.path.length := by
        simp [EntryAddr.heightPath] at hlen; omega
      have hSP : S <+: e0.col.path :=
        List.prefix_of_prefix_length_le h3 (List.prefix_append _ _) hlen'
      obtain ⟨T, hT⟩ := hSP
      -- position `S.length` of `e.col.path`
      have hpos : ∀ x, (e0.heightPath)[S.length]? = some x → x = (c', i) := by
        intro x hx
        obtain ⟨tt, htt⟩ := hc
        have := congrArg (fun l => l[S.length]?) htt
        rw [List.getElem?_append_left (by rw [List.getElem?_eq_some_iff] at hx; exact hx.1),
          hx, h1] at this
        simp at this; exact this
      cases T with
      | nil =>
        simp only [List.append_nil] at hT
        have hx := hpos (e0.col.col, e0.idx) (by
          simp [EntryAddr.heightPath, ← hT])
        simp only [Prod.mk.injEq] at hx
        exact hh (Or.inl ⟨hT.symm, hx.1 ▸ h2⟩)
      | cons t T =>
        have hx := hpos t (by simp [EntryAddr.heightPath, ← hT])
        exact hh (Or.inr ⟨t.1, t.2, T, by rw [← hT, hx], by rw [hx]; exact h2⟩)

/-- Route containers are outside the hole region. -/
theorem route_not_hole_E3 {S : List (Nat × Nat)} {c0 : Nat} {e : EntryAddr} (h : e.heightPath <+: S) :
    ¬ ((e.col.path = S ∧ c0 ≤ e.col.col) ∨ ∃ c' i rest, e.col.path = S ++ (c', i) :: rest ∧ c0 ≤ c') := by
  have := h.length_le
  simp only [EntryAddr.heightPath, List.length_append, List.length_singleton] at this
  rintro (⟨h1, -⟩ | ⟨c', i, rest, h1, -⟩)
  · rw [h1] at this; omega
  · rw [h1] at this; simp at this

/-! Origins of the entries of the loop output. -/

/-- A template entry of `A`: below the root column's forest, numbered at least `r`, and in the
query region or outside the hole. -/
def Tmpl_E3 (A : Forest) (sd : StopData) (rd : RootData) (e : EntryAddr) : Prop :=
  rd.col.path <+: e.col.path ∧ sd.r ≤ e.col.num 0 ∧
    (InQ_E3 sd e ∨ ¬ InHole_E3 sd.depth A e.col)

/-- `(y, c')` (an entry and its column number) is the phase-`ψ` copy of the old entry `e`: parent
shifted, number shifted, height shifted, or (route containers) shifted with the filling of
layer `ψ` placed in its hole. -/
def Orig_E3 (A : Forest) (sd : StopData) (rd : RootData) (n ψ : Nat) (e : EntryAddr)
    (y : Nat × Forest) (c' : Nat) : Prop :=
  ∃ x, A.entryAt e = some x ∧ y.1 = shiftVal sd.r (ψ * period sd) x.1 ∧
    c' = e.col.num 0 + ψ * period sd ∧
    ((¬ e.heightPath <+: sd.col.path ∧ y.2 = shift sd.r (ψ * period sd) x.2) ∨
     (e.heightPath <+: sd.col.path ∧ y.2 = replaceAt sd.r (ψ * period sd) (zs_E3 A sd rd n ψ)
        (sd.depth - e.col.path.length - 1) x.2))

/-- Every entry of the filling `Z` of layer `j` (first column numbered `t + j d`) is a copy of a
template entry, of phase `ψ ≥ j`, and of phase `j` only in the query region of the first head. -/
def E1_E3 (A : Forest) (sd : StopData) (rd : RootData) (n j : Nat) (Z : Forest) : Prop :=
  ∀ ρ y, Z.entryAt ρ = some y → ∃ e ψ, j ≤ ψ ∧ ψ ≤ n ∧ (ψ = j → InQ_E3 sd e) ∧
    Tmpl_E3 A sd rd e ∧ Orig_E3 A sd rd n ψ e y (ρ.col.num (sd.t + j * period sd))

theorem num_ge_E3 (b : Nat) (c : ColAddr) : b ≤ c.num b := by simp only [ColAddr.num]; omega

theorem sum_heightPath_E3 (e : EntryAddr) :
    (e.heightPath.map (·.1 + 1)).sum = e.col.num 0 + 1 := by
  simp [EntryAddr.heightPath, ColAddr.num]; omega

theorem stop_rpath_E3 {A : Forest} {sd : StopData} (hsd : stopData A = some sd) :
    rpath_E3 sd.depth A = sd.col.path ∧ hcol_E3 sd.depth A = sd.col.col := by
  have h1 := rpath_skip_E3 hsd sd.depth 0 (by omega)
  have h2 := hcol_skip_E3 hsd sd.depth 0 (by omega)
  simp only [skipLayers, List.drop_zero] at h1 h2
  exact ⟨h1, h2⟩

/-- Pure copies of the entries inside the height of a non-route template entry. -/
theorem pure_orig_E3 {A : Forest} {sd : StopData} (rd : RootData) (n : Nat)
    (hsd : stopData A = some sd)
    {e0 : EntryAddr} {x0 : Nat × Forest} (hx0 : A.entryAt e0 = some x0)
    (hnr : ¬ e0.heightPath <+: sd.col.path) (hloc : InQ_E3 sd e0 ∨ ¬ InHole_E3 sd.depth A e0.col)
    (hrd0 : rd.col.path <+: e0.col.path) (hr0 : sd.r ≤ e0.col.num 0) (ψ : Nat) {ρ : EntryAddr}
    {y : Nat × Forest} (hy : (shift sd.r (ψ * period sd) x0.2).entryAt ρ = some y) :
    Tmpl_E3 A sd rd ⟨⟨e0.heightPath ++ ρ.col.path, ρ.col.col⟩, ρ.idx⟩ ∧
      (InQ_E3 sd e0 → InQ_E3 sd ⟨⟨e0.heightPath ++ ρ.col.path, ρ.col.col⟩, ρ.idx⟩) ∧
      Orig_E3 A sd rd n ψ ⟨⟨e0.heightPath ++ ρ.col.path, ρ.col.col⟩, ρ.idx⟩ y
        (ρ.col.num (e0.col.num 0 + 1 + ψ * period sd)) := by
  obtain ⟨hrp, hhc⟩ := stop_rpath_E3 hsd
  rw [shift, entryAt_map_D3] at hy
  obtain ⟨x, hx, rfl⟩ := Option.map_eq_some_iff.1 hy
  have hfa : A.forestAt e0.heightPath = some x0.2 := by
    rw [Tree.forestAt_heightPath, Tree.heightAt, hx0]; rfl
  have hA := entryAt_abs_E3 hfa ρ
  rw [hx] at hA
  have hcon : e0.heightPath <+: (⟨⟨e0.heightPath ++ ρ.col.path, ρ.col.col⟩, ρ.idx⟩ : EntryAddr).col.path :=
    List.prefix_append _ _
  have hnum : (⟨⟨e0.heightPath ++ ρ.col.path, ρ.col.col⟩, ρ.idx⟩ : EntryAddr).col.num 0 =
      ρ.col.num (e0.col.num 0 + 1) := by
    rw [num_abs_E3, sum_heightPath_E3]
  have hnr' : ¬ (⟨⟨e0.heightPath ++ ρ.col.path, ρ.col.col⟩, ρ.idx⟩ : EntryAddr).heightPath <+:
      sd.col.path := fun h => hnr ((hcon.trans (List.prefix_append _ _)).trans h)
  have hq : InQ_E3 sd e0 → InQ_E3 sd ⟨⟨e0.heightPath ++ ρ.col.path, ρ.col.col⟩, ρ.idx⟩ := by
    rintro (⟨h1, h2⟩ | ⟨i, hi, h⟩)
    · refine Or.inr ⟨e0.idx, h2, ?_⟩
      have : (⟨sd.col, e0.idx⟩ : EntryAddr) = e0 := by rw [← h1]
      rw [this]; exact hcon
    · exact Or.inr ⟨i, hi, h.trans ((List.prefix_append _ _).trans hcon)⟩
  refine ⟨⟨hrd0.trans ((List.prefix_append _ _).trans hcon), ?_, ?_⟩, hq, x, hA, rfl, ?_, Or.inl ⟨hnr', rfl⟩⟩
  · rw [hnum]; have := num_ge_E3 (e0.col.num 0 + 1) ρ.col; omega
  · rcases hloc with h | h
    · exact Or.inl (hq h)
    · right
      simp only [InHole_E3, hrp, hhc] at h ⊢
      exact (outside_hered_E3 hnr h hcon).2
  · rw [hnum, num_add_D3]

/-- The first column index of an address (the column of its outermost step). -/
def fstCol_E3 (e : EntryAddr) : Nat :=
  match e.col.path with
  | [] => e.col.col
  | (c, _) :: _ => c

theorem num_ge_fst_E3 (b : Nat) (e : EntryAddr) : b + fstCol_E3 e ≤ e.col.num b := by
  obtain ⟨⟨P, j⟩, i⟩ := e
  cases P with
  | nil => simp [fstCol_E3, ColAddr.num]
  | cons s P => obtain ⟨c, m⟩ := s; simp [fstCol_E3, ColAddr.num]; omega

/-- The route forests of `A`, read relatively. -/
theorem skip_data_E3 {A : Forest} {sd : StopData} (hsd : stopData A = some sd) {i : Nat}
    (hi : i ≤ sd.depth) :
    A.forestAt (sd.col.path.take i) = some (skipLayers A i) ∧
      RouteOK_D3 (sd.depth - i) (skipLayers A i) ∧
      leftCount A i + routeNum_D3 (sd.depth - i) (skipLayers A i) = sd.t ∧
      rpath_E3 sd.depth A = sd.col.path.take i ++ rpath_E3 (sd.depth - i) (skipLayers A i) ∧
      hcol_E3 sd.depth A = hcol_E3 (sd.depth - i) (skipLayers A i) ∧
      ((sd.col.path.take i).map (·.1 + 1)).sum = leftCount A i := by
  obtain ⟨hrp, hhc⟩ := stop_rpath_E3 hsd
  have h1 := stop_route_D3 hsd (sd.depth - i) (by omega)
  rw [show sd.depth - (sd.depth - i) = i by omega] at h1
  refine ⟨skipLayers_of_stopData hsd hi, h1.1, h1.2, ?_, ?_, stop_pathSum_D3 hsd i hi⟩
  · rw [hrp, rpath_skip_E3 hsd (sd.depth - i) i (by omega), List.take_append_drop]
  · rw [hhc, hcol_skip_E3 hsd (sd.depth - i) i (by omega)]

/-- Entries of a filled copy of a route forest `skipLayers A i` (the owner's last restored
height, or the root forest in the body case): kept entries and route containers are copies of
phase `k`, hole entries come from the filling of layer `k`. -/
theorem route_orig_E3 {A : Forest} {sd : StopData} {rd : RootData} {n : Nat}
    (hsd : stopData A = some sd) (hrp : rd.col.path = sd.col.path.take rd.layer)
    {i : Nat} (hi : i ≤ sd.depth) (hli : rd.layer ≤ i) {k : Nat}
    (hE : E1_E3 A sd rd n k (zs_E3 A sd rd n k)) (hk : k ≤ n) {e : EntryAddr} {y : Nat × Forest}
    (hy : (replaceAt 0 0 (zs_E3 A sd rd n k) (sd.depth - i)
      (shift sd.r (k * period sd) (skipLayers A i))).entryAt e = some y)
    (hnum : sd.r ≤ leftCount A i + fstCol_E3 e) :
    ∃ eA ψ, k ≤ ψ ∧ ψ ≤ n ∧ Tmpl_E3 A sd rd eA ∧
      Orig_E3 A sd rd n ψ eA y (e.col.num (leftCount A i + k * period sd)) := by
  obtain ⟨hfa, hR, hN, hrp', hhc', hsum⟩ := skip_data_E3 hsd hi
  obtain ⟨hrpA, hhcA⟩ := stop_rpath_E3 hsd
  have hRG := (routeOK_shift_D3 sd.r (k * period sd) _ _).2 hR
  have hrpG : rpath_E3 sd.depth A = sd.col.path.take i ++
      rpath_E3 (sd.depth - i) (shift sd.r (k * period sd) (skipLayers A i)) := by
    rw [shift, rpath_map_E3]; exact hrp'
  have hhcG : hcol_E3 sd.depth A = hcol_E3 (sd.depth - i) (shift sd.r (k * period sd) (skipLayers A i)) := by
    rw [shift, hcol_map_E3]; exact hhc'
  have hlen : (sd.col.path.take i).length = i := by
    obtain ⟨-, h2, -⟩ := stopData_core hsd; rw [List.length_take]; omega
  have hrdP : rd.col.path <+: sd.col.path.take i := hrp ▸ List.take_prefix_take_left hli
  have hnumA : ∀ e' : EntryAddr, (⟨sd.col.path.take i ++ e'.col.path, e'.col.col⟩ : ColAddr).num 0 =
      e'.col.num (leftCount A i) := fun e' => by rw [num_abs_E3, hsum]
  have hP := put_entryAt_E3 (zs_E3 A sd rd n k) (sd.depth - i) _ hRG e
  by_cases hh : InHole_E3 (sd.depth - i) (shift sd.r (k * period sd) (skipLayers A i)) e.col
  · obtain ⟨h1, h2⟩ := hP.1 hh
    rw [h1] at hy
    obtain ⟨eA, ψ, hψ1, hψ2, -, ht, ho⟩ := hE _ _ hy
    refine ⟨eA, ψ, hψ1, hψ2, ht, ?_⟩
    rw [h2, routeNum_shift_D3, show leftCount A i + k * period sd + routeNum_D3 (sd.depth - i)
      (skipLayers A i) = sd.t + k * period sd by omega]
    exact ho
  · -- kept entries and route containers: copies of `skipLayers A i` at phase `k`
    have hkept : ∀ x, (skipLayers A i).entryAt e = some x →
        A.entryAt ⟨⟨sd.col.path.take i ++ e.col.path, e.col.col⟩, e.idx⟩ = some x := by
      intro x hx; rw [entryAt_abs_E3 hfa, hx]
    have hhA : ¬ InHole_E3 sd.depth A ⟨sd.col.path.take i ++ e.col.path, e.col.col⟩ := by
      rw [inHole_abs_E3 hrpG hhcG]; exact hh
    have htm : sd.r ≤ (⟨sd.col.path.take i ++ e.col.path, e.col.col⟩ : ColAddr).num 0 := by
      rw [hnumA]; exact le_trans hnum (num_ge_fst_E3 _ e)
    have hrdA : rd.col.path <+: (⟨sd.col.path.take i ++ e.col.path, e.col.col⟩ : ColAddr).path :=
      hrdP.trans (List.prefix_append _ _)
    refine ⟨⟨⟨sd.col.path.take i ++ e.col.path, e.col.col⟩, e.idx⟩, k, le_rfl, hk,
      ⟨hrdA, htm, Or.inr hhA⟩, ?_⟩
    by_cases hr : IsRoute_E3 (sd.depth - i) (shift sd.r (k * period sd) (skipLayers A i)) e
    · rw [hP.2.1 hh hr, shift, entryAt_map_D3] at hy
      simp only [Option.map_map] at hy
      obtain ⟨x, hx, rfl⟩ := Option.map_eq_some_iff.1 hy
      refine ⟨x, hkept x hx, rfl, by rw [hnumA, num_add_D3], Or.inr ⟨?_, ?_⟩⟩
      · have := (isRoute_abs_E3 hrpG e).2 hr
        rwa [IsRoute_E3, hrpA] at this
      · simp only [Function.comp, List.length_append, hlen]
        rw [replaceAt_eq_shift sd.r,
          show sd.depth - (i + e.col.path.length) - 1 = sd.depth - i - e.col.path.length - 1 by omega]
        rfl
    · rw [hP.2.2 hh hr, shift, entryAt_map_D3] at hy
      obtain ⟨x, hx, rfl⟩ := Option.map_eq_some_iff.1 hy
      refine ⟨x, hkept x hx, rfl, by rw [hnumA, num_add_D3], Or.inl ⟨?_, rfl⟩⟩
      intro h
      apply hr
      have : IsRoute_E3 sd.depth A ⟨⟨sd.col.path.take i ++ e.col.path, e.col.col⟩, e.idx⟩ := by
        rw [IsRoute_E3, hrpA]; exact h
      exact (isRoute_abs_E3 hrpG e).1 this

/-- Facts about the root column and its unconsumed suffix. -/
theorem root_pack_E3 {A : Forest} {sd : StopData} {rd : RootData} (hV : CondV A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) :
    rd.col.path = sd.col.path.take rd.layer ∧ rd.col.col = rd.idx ∧ rd.col.num 0 = sd.r ∧
      sd.r = leftCount A rd.layer + rd.idx ∧ rd.layer ≤ sd.depth ∧
      (A.forestAt rd.col.path).getD Tree.empty = skipLayers A rd.layer ∧
      (∀ v u, (((A.colAt rd.col).getD []).drop rd.cursor)[v]? = some u →
        A.entryAt ⟨rd.col, rd.cursor + v⟩ = some u ∧ u.1 < sd.r ∧
        ¬ InHole_E3 sd.depth A rd.col ∧
        ((⟨rd.col, rd.cursor + v⟩ : EntryAddr).heightPath <+: sd.col.path ↔
          rd.owner = true ∧ v + 1 = (((A.colAt rd.col).getD []).drop rd.cursor).length)) ∧
      (rd.owner = true → ∀ u, (((A.colAt rd.col).getD []).drop rd.cursor).getLast? = some u →
        u.2 = skipLayers A (rd.layer + 1) ∧ rd.layer < sd.depth ∧
        leftCount A (rd.layer + 1) = sd.r + 1) := by
  obtain ⟨hle, hfa, hr, hidx, howner, hcol⟩ := root_facts_D3 hsd hrd
  obtain ⟨-, hlay, hcc, hnum, hrt, hmem, -, -⟩ := rootData_spec hsd hrd
  obtain ⟨-, -, -, hpre, -⟩ := rootData_path hsd hrd
  obtain ⟨h1, h2, h3, h4, h5, -⟩ := stopData_core hsd
  obtain ⟨hrpA, hhcA⟩ := stop_rpath_E3 hsd
  obtain ⟨-, -, hU, -⟩ := ord_vdata_D3 hV hsd hrd
  have hpath : rd.col.path = sd.col.path.take rd.layer := by
    rw [List.prefix_iff_eq_take] at hpre; rw [hpre, hlay]
  obtain ⟨R, hR⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff A rd.col).1 hmem)
  have hRc : (skipLayers A rd.layer).cols[rd.idx]? = some R := by rw [← hcol, hR]
  have hstep : rd.layer < sd.depth → ∃ col p, (skipLayers A rd.layer).cols.getLast? = some col ∧
      col.getLast? = some (p, skipLayers A (rd.layer + 1)) ∧
      sd.col.path[rd.layer]? = some ((skipLayers A rd.layer).cols.length - 1, col.length - 1) := by
    intro hl; obtain ⟨col, p, a, b, -, c⟩ := h5 rd.layer hl; exact ⟨col, p, a, b, c⟩
  have hlr : rd.owner = true → rd.layer < sd.depth := rootData_layer_lt hsd hrd
  have hlastR : rd.owner = true → ∀ col, (skipLayers A rd.layer).cols.getLast? = some col → col = R := by
    intro hown col hc1
    rw [List.getLast?_eq_getElem?, show (skipLayers A rd.layer).cols.length - 1 = rd.idx by
      have := howner.1 hown; omega, hRc] at hc1
    exact (Option.some.inj hc1).symm
  have hnh : ¬ InHole_E3 sd.depth A rd.col := by
    simp only [InHole_E3, hrpA, hhcA]
    rintro (⟨hp, hc⟩ | ⟨c', i, rest, hp, -⟩)
    · have hl : rd.layer = sd.depth := by
        have := congrArg List.length hp; rw [hlay]; simpa [h2] using this
      have hown : rd.owner = false := by
        cases ho : rd.owner
        · rfl
        · exact absurd hl (Nat.ne_of_lt (hlr ho))
      have : rd.idx + 1 < (skipLayers A rd.layer).cols.length := by
        have : ¬ rd.idx + 1 = (skipLayers A rd.layer).cols.length := by rw [← howner, hown]; simp
        omega
      rw [hl] at this; rw [← hcc] at hc; omega
    · have := congrArg List.length hp
      have := hpre.length_le
      simp at *; omega
  refine ⟨hpath, hcc.symm, hnum, hr, hle, by rw [hfa]; rfl, ?_, ?_⟩
  · intro v u hu
    have hmemU : u ∈ ((A.colAt rd.col).getD []).drop rd.cursor := List.mem_of_getElem? hu
    rw [hR, Option.getD_some, List.getElem?_drop] at hu
    refine ⟨by simp [Tree.entryAt, hR, hu], (hU u hmemU).1, hnh, ?_⟩
    have hlt : rd.cursor + v < R.length := (List.getElem?_eq_some_iff.1 hu).1
    simp only [hR, Option.getD_some, List.length_drop]
    have hhp : (⟨rd.col, rd.cursor + v⟩ : EntryAddr).heightPath =
        sd.col.path.take rd.layer ++ [(rd.idx, rd.cursor + v)] := by
      rw [EntryAddr.heightPath, hpath, ← hcc]
    rw [hhp]
    constructor
    · intro hon
      have hlen := hon.length_le
      simp only [List.length_append, List.length_take, List.length_singleton] at hlen
      have hl : rd.layer < sd.depth := by omega
      obtain ⟨col, p, hc1, hc2, hc3⟩ := hstep hl
      have : sd.col.path[rd.layer]? = some (rd.idx, rd.cursor + v) := by
        obtain ⟨t, ht⟩ := hon
        rw [← ht, List.append_assoc, List.getElem?_append_right (by simp), List.length_take,
          Nat.min_eq_left (by omega), Nat.sub_self]
        rfl
      rw [hc3] at this
      simp only [Option.some.injEq, Prod.mk.injEq] at this
      have hown : rd.owner = true := howner.2 (by omega)
      refine ⟨hown, ?_⟩
      have := hlastR hown col hc1
      subst this; omega
    · rintro ⟨hown, hv⟩
      obtain ⟨col, p, hc1, hc2, hc3⟩ := hstep (hlr hown)
      have := hlastR hown col hc1
      subst this
      have hio := howner.1 hown
      rw [List.prefix_iff_eq_take, List.length_append, List.length_take, List.length_singleton,
        show min rd.layer sd.col.path.length = rd.layer by omega, List.take_add_one]
      congr 1
      rw [hc3]; simp; omega
  · intro hown u hu
    obtain ⟨col, p, hc1, hc2, hc3⟩ := hstep (hlr hown)
    have := hlastR hown col hc1
    subst this
    rw [hR, Option.getD_some, List.getLast?_drop] at hu
    split at hu
    · cases hu
    · rw [hc2] at hu
      refine ⟨by rw [← Option.some.inj hu], hlr hown, ?_⟩
      rw [leftCount_succ_D3, hr]; have := howner.1 hown; omega

/-! Entries of a step of the loop. -/

/-- Move an address `m` columns to the right in its outermost forest. -/
def addCol_E3 (m : Nat) (e : EntryAddr) : EntryAddr :=
  match e.col.path with
  | [] => ⟨⟨[], e.col.col + m⟩, e.idx⟩
  | (c, i) :: P => ⟨⟨(c + m, i) :: P, e.col.col⟩, e.idx⟩

theorem entryAt_drop_E3 (L : List Column) (m : Nat) (e : EntryAddr) :
    (Tree.node (L.drop m)).entryAt e = (Tree.node L).entryAt (addCol_E3 m e) := by
  obtain ⟨⟨P, j⟩, i⟩ := e
  cases P with
  | nil => simp only [addCol_E3, entryAt_nil_D3, List.getElem?_drop]; rw [Nat.add_comm]
  | cons s P =>
    obtain ⟨c, k⟩ := s
    simp only [addCol_E3, entryAt_cons_D3, List.getElem?_drop]; rw [Nat.add_comm m c]

theorem addCol_num_E3 (m b : Nat) (e : EntryAddr) :
    (addCol_E3 m e).col.num b = e.col.num (b + m) := by
  obtain ⟨⟨P, j⟩, i⟩ := e
  cases P with
  | nil => simp [addCol_E3, ColAddr.num]; omega
  | cons s P => obtain ⟨c, k⟩ := s; simp [addCol_E3, ColAddr.num]; omega

theorem fstCol_addCol_E3 (m : Nat) (e : EntryAddr) : fstCol_E3 (addCol_E3 m e) = fstCol_E3 e + m := by
  obtain ⟨⟨P, j⟩, i⟩ := e
  cases P with
  | nil => rfl
  | cons s P => obtain ⟨c, k⟩ := s; rfl

theorem addCol_of_fstCol_E3 (e : EntryAddr) (h : 1 ≤ fstCol_E3 e) : ∃ e0, e = addCol_E3 1 e0 := by
  obtain ⟨⟨P, j⟩, i⟩ := e
  cases P with
  | nil =>
    simp only [fstCol_E3] at h
    exact ⟨⟨⟨[], j - 1⟩, i⟩, by simp [addCol_E3]; omega⟩
  | cons s P =>
    obtain ⟨c, k⟩ := s
    simp only [fstCol_E3] at h
    exact ⟨⟨⟨(c - 1, k) :: P, j⟩, i⟩, by simp [addCol_E3]; omega⟩

theorem put_drop_E3 (Z : Forest) : ∀ (k : Nat) (L : List Column), RouteOK_D3 k (.node L) →
    ∀ m, m < L.length →
      replaceAt 0 0 Z k (.node (L.drop m)) = .node ((replaceAt 0 0 Z k (.node L)).cols.drop m)
  | 0, L, hR, m, hm => by
    have hc : L ≠ [] := hR
    have hc' : L.drop m ≠ [] := by simp; omega
    rw [put_zero_D3 Z hc, put_zero_D3 Z hc']
    obtain ⟨L', x, rfl⟩ := List.eq_nil_or_concat L |>.resolve_left hc
    simp only [List.concat_eq_append, List.length_append, List.length_singleton] at hm ⊢
    obtain ⟨zc⟩ := Z
    simp only [Tree.cols, List.dropLast_concat]
    rw [List.drop_append_of_le_length (by omega), List.drop_append_of_le_length (by omega),
      List.dropLast_concat]
  | k + 1, L, hR, m, hm => by
    obtain ⟨cs, es, q, H, he, hR'⟩ := hR
    simp only [Tree.node.injEq] at he
    subst he
    simp only [List.length_append, List.length_singleton] at hm
    rw [List.drop_append_of_le_length (by omega), put_succ_D3, put_succ_D3]
    simp only [Tree.cols]
    rw [List.drop_append_of_le_length (by omega)]

theorem shift_drop_E3 (r d : Nat) (L : List Column) (m : Nat) :
    shift r d (.node (L.drop m)) = .node ((shift r d (.node L)).cols.drop m) := by
  simp [shift, Tree.map, Tree.cols, treeMapCols_eq_map, List.map_drop]

theorem q_pack_E3 {A : Forest} {sd : StopData} {rd : RootData} (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) {i : Nat} {x : Nat × Forest} (hx : sd.Q[i]? = some x) :
    A.entryAt ⟨sd.col, i⟩ = some x ∧ ¬ (⟨sd.col, i⟩ : EntryAddr).heightPath <+: sd.col.path ∧
      InQ_E3 sd ⟨sd.col, i⟩ ∧ Tmpl_E3 A sd rd ⟨sd.col, i⟩ := by
  obtain ⟨hcol, -, ht, -⟩ := stopData_spec hsd
  obtain ⟨-, -, -, -, hrt, -⟩ := rootData_spec hsd hrd
  obtain ⟨-, -, -, hpre, -⟩ := rootData_path hsd hrd
  have hi : i < sd.Q.length := (List.getElem?_eq_some_iff.1 hx).1
  have hq : InQ_E3 sd ⟨sd.col, i⟩ := Or.inl ⟨rfl, hi⟩
  refine ⟨?_, ?_, hq, hpre, by rw [← ht]; omega, Or.inl hq⟩
  · simp only [Tree.entryAt, hcol, Option.bind_some]
    rw [List.getElem?_append_left hi, hx]
  · intro h
    have := h.length_le
    simp [EntryAddr.heightPath] at this

/-- The head column of a step: the query copy (phase `k-1`) and the restored entries (phase `k`). -/
theorem head_orig_E3 {A : Forest} {sd : StopData} {rd : RootData} {n k : Nat} (hL : InL A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) (hk1 : 1 ≤ k) (hkn : k ≤ n)
    (hE : E1_E3 A sd rd n k (zs_E3 A sd rd n k)) {W : Column} {rest : List Column}
    (hW : ∀ v x, W[v]? = some x → ∃ u, (((A.colAt rd.col).getD []).drop rd.cursor)[v]? = some u ∧
      x.1 = u.1 ∧ ((¬ (rd.owner = true ∧ v + 1 = (((A.colAt rd.col).getD []).drop rd.cursor).length) ∧
          x.2 = shift sd.r (k * period sd) u.2) ∨
        (rd.owner = true ∧ v + 1 = (((A.colAt rd.col).getD []).drop rd.cursor).length ∧
          x.2 = replaceAt sd.r (k * period sd) (zs_E3 A sd rd n k) (sd.depth - rd.layer - 1) u.2)))
    {ρ : EntryAddr} {y : Nat × Forest} (hρ : fstCol_E3 ρ = 0)
    (hy : (Tree.node ((Tree.mapCol (shiftVal sd.r ((k - 1) * period sd)) sd.Q ++ W) :: rest)).entryAt ρ
      = some y) :
    ∃ e ψ, k - 1 ≤ ψ ∧ ψ ≤ n ∧ (ψ = k - 1 → InQ_E3 sd e) ∧ Tmpl_E3 A sd rd e ∧
      Orig_E3 A sd rd n ψ e y (ρ.col.num (sd.t + (k - 1) * period sd)) := by
  obtain ⟨hpath, hcc, hnum, hr, hle, hF, hUe, hlast⟩ := root_pack_E3 hL.1 hsd hrd
  obtain ⟨-, -, ht, -⟩ := stopData_spec hsd
  obtain ⟨-, -, -, -, hrt, -⟩ := rootData_spec hsd hrd
  have hbase : sd.t + (k - 1) * period sd = sd.r + k * period sd := by
    obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
    simp only [period, Nat.add_sub_cancel, Nat.succ_mul]; omega
  have hlay : rd.col.path.length = rd.layer := by
    rw [hpath, List.length_take]; obtain ⟨-, h2, -⟩ := stopData_core hsd; omega
  have hhd : ∀ i, (Tree.mapCol (shiftVal sd.r ((k - 1) * period sd)) sd.Q ++ W)[i]? =
      if i < sd.Q.length then (sd.Q[i]?).map (fun x => (shiftVal sd.r ((k - 1) * period sd) x.1,
        shift sd.r ((k - 1) * period sd) x.2)) else W[i - sd.Q.length]? := by
    intro i
    split_ifs with hi
    · rw [List.getElem?_append_left (by rw [treeMapCol_eq_map, List.length_map]; exact hi),
        treeMapCol_eq_map, List.getElem?_map]; rfl
    · rw [List.getElem?_append_right (by rw [treeMapCol_eq_map, List.length_map]; omega),
        treeMapCol_eq_map, List.length_map]
  -- the restored entry `v`
  have hWo : ∀ v x, W[v]? = some x → (Tmpl_E3 A sd rd ⟨rd.col, rd.cursor + v⟩ ∧
      ∃ u, A.entryAt ⟨rd.col, rd.cursor + v⟩ = some u ∧ x.1 = shiftVal sd.r (k * period sd) u.1 ∧
      ((¬ (⟨rd.col, rd.cursor + v⟩ : EntryAddr).heightPath <+: sd.col.path ∧
          x.2 = shift sd.r (k * period sd) u.2) ∨
        ((⟨rd.col, rd.cursor + v⟩ : EntryAddr).heightPath <+: sd.col.path ∧ rd.owner = true ∧
          x.2 = replaceAt sd.r (k * period sd) (zs_E3 A sd rd n k) (sd.depth - rd.layer - 1) u.2 ∧
          u.2 = skipLayers A (rd.layer + 1) ∧ rd.layer < sd.depth ∧
          leftCount A (rd.layer + 1) = sd.r + 1))) := by
    intro v x hx
    obtain ⟨u, hu, hx1, hx2⟩ := hW v x hx
    obtain ⟨hA, hur, hnh, hon⟩ := hUe v u hu
    refine ⟨⟨List.prefix_refl _, by rw [hnum], Or.inr hnh⟩, u, hA, ?_, ?_⟩
    · rw [hx1, shiftVal, if_neg (by omega)]
    · rcases hx2 with ⟨h1, h2⟩ | ⟨h1, h2, h3⟩
      · exact Or.inl ⟨fun h => h1 (hon.1 h), h2⟩
      · have hl : (((A.colAt rd.col).getD []).drop rd.cursor).getLast? = some u := by
          rw [List.getLast?_eq_getElem?, show (((A.colAt rd.col).getD []).drop rd.cursor).length - 1 = v
            by omega, hu]
        obtain ⟨g1, g2, g3⟩ := hlast h1 u hl
        exact Or.inr ⟨hon.2 ⟨h1, h2⟩, h1, h3, g1, g2, g3⟩
  obtain ⟨⟨P, j⟩, i⟩ := ρ
  cases P with
  | nil =>
    simp only [fstCol_E3] at hρ
    subst hρ
    rw [entryAt_nil_D3] at hy
    simp only [List.getElem?_cons_zero, Option.bind_some, hhd] at hy
    split_ifs at hy with hi
    · obtain ⟨x, hx, rfl⟩ := Option.map_eq_some_iff.1 hy
      obtain ⟨hA, hnr, hq, htm⟩ := q_pack_E3 hsd hrd hx
      refine ⟨⟨sd.col, i⟩, k - 1, le_rfl, by omega, fun _ => hq, htm, x, hA, rfl, ?_,
        Or.inl ⟨hnr, rfl⟩⟩
      simp [num_nil_D3, ht]
    · obtain ⟨htm, u, hA, hy1, hy2⟩ := hWo _ _ hy
      refine ⟨⟨rd.col, rd.cursor + (i - sd.Q.length)⟩, k, by omega, hkn, fun h => by omega, htm,
        u, hA, hy1, by simp [num_nil_D3, hnum, hbase], ?_⟩
      rcases hy2 with h | ⟨h1, -, h2, -⟩
      · exact Or.inl h
      · exact Or.inr ⟨h1, by rw [h2, hlay]⟩
  | cons s P =>
    obtain ⟨c0, i0⟩ := s
    simp only [fstCol_E3] at hρ
    subst hρ
    rw [entryAt_cons_D3] at hy
    simp only [List.getElem?_cons_zero, Option.bind_some, hhd] at hy
    rw [num_cons_D3]
    split_ifs at hy with hi
    · cases hx : sd.Q[i0]? with
      | none => simp [hx] at hy
      | some x =>
        simp only [hx, Option.map_some, Option.bind_some] at hy
        obtain ⟨hA, hnr, hq, htm⟩ := q_pack_E3 hsd hrd hx
        obtain ⟨t1, t2, t3⟩ := pure_orig_E3 rd n hsd hA hnr htm.2.2 htm.1 htm.2.1 (k - 1) hy
        refine ⟨_, k - 1, le_rfl, by omega, fun _ => t2 hq, t1, ?_⟩
        convert t3 using 2
        simp only; rw [← ht]; omega
    · obtain ⟨x, hx, hy⟩ := Option.bind_eq_some_iff.1 hy
      · obtain ⟨htm, u, hA, hy1, hy2⟩ := hWo _ _ hx
        rcases hy2 with ⟨hnr, h2⟩ | ⟨hon, hown, h2, g1, g2, g3⟩
        · rw [h2] at hy
          obtain ⟨t1, -, t3⟩ := pure_orig_E3 rd n hsd hA hnr htm.2.2 htm.1 htm.2.1 k hy
          refine ⟨_, k, by omega, hkn, fun h => by omega, t1, ?_⟩
          convert t3 using 2
          simp only; rw [hnum]; omega
        · rw [h2, g1, replaceAt_eq_shift] at hy
          obtain ⟨eA, ψ, hψ1, hψ2, htA, hoA⟩ := route_orig_E3 hsd hpath (i := rd.layer + 1)
            (by omega) (by omega) hE hkn (by rw [show sd.depth - (rd.layer + 1) =
              sd.depth - rd.layer - 1 by omega]; exact hy) (by rw [g3]; omega)
          refine ⟨eA, ψ, by omega, hψ2, fun h => by omega, htA, ?_⟩
          convert hoA using 2
          rw [g3]; omega

theorem eta_E3 (X : Forest) : Tree.node X.cols = X := by cases X; rfl

/-- The body columns of a step (body case): copies of the root forest's columns after the root. -/
theorem body_orig_E3 {A : Forest} {sd : StopData} {rd : RootData} {n k : Nat} (hL : InL A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) (hown : rd.owner = false)
    (hk1 : 1 ≤ k) (hkn : k ≤ n) (hE : E1_E3 A sd rd n k (zs_E3 A sd rd n k)) (hd : Column)
    {ρ : EntryAddr} {y : Nat × Forest}
    (hy : (Tree.node (hd :: (Hole.fill ⟨.node (((A.forestAt rd.col.path).getD Tree.empty).cols.drop
      (rd.idx + 1)), sd.depth - rd.layer⟩ sd.r (k * period sd) (zs_E3 A sd rd n k)).cols)).entryAt
        (addCol_E3 1 ρ) = some y) :
    ∃ e ψ, k ≤ ψ ∧ ψ ≤ n ∧ Tmpl_E3 A sd rd e ∧
      Orig_E3 A sd rd n ψ e y ((addCol_E3 1 ρ).col.num (sd.t + (k - 1) * period sd)) := by
  obtain ⟨hpath, hcc, hnum, hr, hle, hF, -⟩ := root_pack_E3 hL.1 hsd hrd
  obtain ⟨-, -, -, hidx, howner, -⟩ := root_facts_D3 hsd hrd
  obtain ⟨-, hRF, -⟩ := skip_data_E3 hsd hle
  have hbase : sd.t + (k - 1) * period sd = sd.r + k * period sd := by
    obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
    simp only [period, Nat.add_sub_cancel, Nat.succ_mul]
    obtain ⟨-, -, -, -, hrt, -⟩ := rootData_spec hsd hrd; omega
  have hlt : rd.idx + 1 < (skipLayers A rd.layer).cols.length := by
    have : ¬ rd.idx + 1 = (skipLayers A rd.layer).cols.length := by rw [← howner, hown]; simp
    omega
  rw [hF] at hy
  have h1 := entryAt_drop_E3 (hd :: (Hole.fill ⟨.node ((skipLayers A rd.layer).cols.drop (rd.idx + 1)),
    sd.depth - rd.layer⟩ sd.r (k * period sd) (zs_E3 A sd rd n k)).cols) 1 ρ
  rw [← h1, List.drop_one, List.tail_cons, eta_E3] at hy
  have hRG : RouteOK_D3 (sd.depth - rd.layer) (Tree.node (shift sd.r (k * period sd) (skipLayers A rd.layer)).cols) := by
    rw [eta_E3]; exact (routeOK_shift_D3 _ _ _ _).2 hRF
  have hlt' : rd.idx + 1 < (shift sd.r (k * period sd) (skipLayers A rd.layer)).cols.length := by
    rw [shift, cols_length_map_E3]; exact hlt
  have h2 : Hole.fill ⟨.node ((skipLayers A rd.layer).cols.drop (rd.idx + 1)), sd.depth - rd.layer⟩ sd.r
      (k * period sd) (zs_E3 A sd rd n k) =
      .node ((replaceAt 0 0 (zs_E3 A sd rd n k) (sd.depth - rd.layer)
        (shift sd.r (k * period sd) (skipLayers A rd.layer))).cols.drop (rd.idx + 1)) := by
    rw [Hole.fill, replaceAt_eq_shift, shift_drop_E3, eta_E3]
    have := put_drop_E3 (zs_E3 A sd rd n k) _ _ hRG _ hlt'
    rw [eta_E3] at this
    exact this
  rw [h2, entryAt_drop_E3, eta_E3] at hy
  obtain ⟨eA, ψ, hψ1, hψ2, htA, hoA⟩ := route_orig_E3 hsd hpath (i := rd.layer) hle le_rfl hE hkn hy
    (by rw [fstCol_addCol_E3]; omega)
  refine ⟨eA, ψ, hψ1, hψ2, htA, ?_⟩
  have : (addCol_E3 1 ρ).col.num (sd.t + (k - 1) * period sd) =
      (addCol_E3 (rd.idx + 1) ρ).col.num (leftCount A rd.layer + k * period sd) := by
    rw [addCol_num_E3, addCol_num_E3]; congr 1; omega
  rw [this]; exact hoA

theorem mapLast_getElem_E3 {β : Type} (f g : β → β) (U : List β) (v : Nat) (x : β)
    (h : (U.dropLast.map f ++ (U.getLast?.map g).toList)[v]? = some x) :
    ∃ u, U[v]? = some u ∧ ((v + 1 ≠ U.length ∧ x = f u) ∨ (v + 1 = U.length ∧ x = g u)) := by
  rcases List.eq_nil_or_concat U with rfl | ⟨U', u0, rfl⟩
  · simp at h
  · simp only [List.concat_eq_append, List.dropLast_concat, List.getLast?_concat, Option.map_some,
      Option.toList_some] at h ⊢
    rcases Nat.lt_or_ge v U'.length with hv | hv
    · rw [List.getElem?_append_left (by simpa using hv), List.getElem?_map] at h
      obtain ⟨u, hu, rfl⟩ := Option.map_eq_some_iff.1 h
      exact ⟨u, by rw [List.getElem?_append_left hv, hu], Or.inl ⟨by simp; omega, rfl⟩⟩
    · rw [List.getElem?_append_right (by simpa using hv)] at h
      simp only [List.length_map] at h
      rcases Nat.lt_or_ge v (U'.length + 1) with hv' | hv'
      · have : v = U'.length := by omega
        subst this
        simp at h
        exact ⟨u0, by simp, Or.inr ⟨by simp, h.symm⟩⟩
      · rw [List.getElem?_eq_none (by simp; omega)] at h; cases h

theorem entryAt_single_E3 (col : Column) (ρ : EntryAddr) (y : Nat × Forest)
    (h : (Tree.node [col]).entryAt ρ = some y) : fstCol_E3 ρ = 0 := by
  by_contra hc
  obtain ⟨ρ0, rfl⟩ := addCol_of_fstCol_E3 ρ (by omega)
  have := entryAt_drop_E3 [col] 1 ρ0
  rw [← this] at h
  simp only [List.drop_one, List.tail_cons] at h
  obtain ⟨⟨P, j⟩, i⟩ := ρ0
  cases P with
  | nil => simp [entryAt_nil_D3] at h
  | cons s P => obtain ⟨c, m⟩ := s; simp [entryAt_cons_D3] at h

/-- One step of the loop keeps the origin classification, one phase down. -/
theorem ordStep_E1_E3 {A : Forest} {sd : StopData} {rd : RootData} {n k : Nat} (hL : InL A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) (hk1 : 1 ≤ k) (hkn : k ≤ n)
    (hE : E1_E3 A sd rd n k (zs_E3 A sd rd n k)) :
    E1_E3 A sd rd n (k - 1) (ordStep sd rd ((A.forestAt rd.col.path).getD Tree.empty)
      (((A.colAt rd.col).getD []).drop rd.cursor) k (zs_E3 A sd rd n k)) := by
  intro ρ y hy
  simp only [ordStep] at hy
  split_ifs at hy with hown
  · rw [List.append_assoc] at hy
    have hρ := entryAt_single_E3 _ ρ y hy
    refine head_orig_E3 hL hsd hrd hk1 hkn hE (rest := []) ?_ hρ hy
    intro v x hx
    obtain ⟨u, hu, hx'⟩ := mapLast_getElem_E3 _ _ _ v x hx
    refine ⟨u, hu, ?_⟩
    rcases hx' with ⟨h1, rfl⟩ | ⟨h1, rfl⟩
    · exact ⟨rfl, Or.inl ⟨fun h => h1 h.2, rfl⟩⟩
    · exact ⟨rfl, Or.inr ⟨hown, h1, rfl⟩⟩
  · have hown' : rd.owner = false := by simpa using hown
    by_cases hρ : fstCol_E3 ρ = 0
    · refine head_orig_E3 hL hsd hrd hk1 hkn hE ?_ hρ hy
      intro v x hx
      rw [List.getElem?_map] at hx
      obtain ⟨u, hu, rfl⟩ := Option.map_eq_some_iff.1 hx
      exact ⟨u, hu, rfl, Or.inl ⟨by simp [hown'], rfl⟩⟩
    · obtain ⟨ρ0, rfl⟩ := addCol_of_fstCol_E3 ρ (by omega)
      obtain ⟨e, ψ, h1, h2, h3, h4⟩ := body_orig_E3 hL hsd hrd hown' hk1 hkn hE _ hy
      exact ⟨e, ψ, by omega, h2, fun h => by omega, h3, h4⟩

/-- The origin classification of every filling `zs_E3 … j`. -/
theorem zs_E1_E3 {A : Forest} {sd : StopData} {rd : RootData} {n : Nat} (hL : InL A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) :
    ∀ c, c ≤ n → E1_E3 A sd rd n (n - c) (zs_E3 A sd rd n (n - c))
  | 0, _ => by
    rw [Nat.sub_zero, zs_top_E3]
    intro ρ y hy
    obtain ⟨⟨P, j⟩, i⟩ := ρ
    cases P with
    | nil => simp [Tree.empty, entryAt_nil_D3] at hy
    | cons s P => obtain ⟨c, m⟩ := s; simp [Tree.empty, entryAt_cons_D3] at hy
  | c + 1, hc => by
    have ih := zs_E1_E3 (n := n) hL hsd hrd c (by omega)
    rw [zs_step_E3 A sd rd (n := n) (j := n - (c + 1)) (by omega),
      show n - (c + 1) + 1 = n - c by omega]
    have := ordStep_E1_E3 hL hsd hrd (n := n) (k := n - c) (by omega) (by omega) ih
    rwa [show n - c - 1 = n - (c + 1) by omega] at this

/-! Facts used by the owner-return analysis. -/

theorem kappa_zero_E3 (r d : Nat) (K : Key) : kappa r d 0 K = K := by
  have : kappaLabel r d 0 = id := by
    funext x; simp only [kappaLabel, Nat.zero_mul, Nat.add_zero, id]
    split_ifs with h
    · obtain ⟨x1, x2⟩ := x; simp only at h; rw [h.1]
    · rfl
  rw [kappa, this, treeMap_id]

/-- `κ_j h_x(H)` read as `h_{x + j d}` of the shifted height (for `x ≥ r` or `j = 0`). -/
theorem kappa_eq_E3 (r d j x : Nat) (h : j = 0 ∨ r ≤ x) (H : Forest) :
    kappa r d j (relKey x H) = relKey (x + j * d) (shift r (j * d) H) := by
  rcases h with rfl | h
  · rw [kappa_zero_E3, Nat.zero_mul, Nat.add_zero, shift_zero]
  · exact (relKey_shift r d j x h H).symm

/-- Route containers of `A`: their depth, height, number and route. -/
theorem onR_pack_E3 {A : Forest} {sd : StopData} (hsd : stopData A = some sd) {e0 : EntryAddr}
    {x0 : Nat × Forest} (hx0 : A.entryAt e0 = some x0) (hon : e0.heightPath <+: sd.col.path) :
    e0.col.path.length < sd.depth ∧ e0.heightPath = sd.col.path.take (e0.col.path.length + 1) ∧
      x0.2 = skipLayers A (e0.col.path.length + 1) ∧
      e0.col.num 0 + 1 = leftCount A (e0.col.path.length + 1) ∧
      RouteOK_D3 (sd.depth - e0.col.path.length - 1) x0.2 ∧
      e0.col.num 0 + 1 + routeNum_D3 (sd.depth - e0.col.path.length - 1) x0.2 = sd.t ∧
      routeCol_D3 (sd.depth - e0.col.path.length - 1) x0.2 = sd.Q ++ [(sd.r, Tree.empty)] ∧
      rpath_E3 sd.depth A = e0.heightPath ++ rpath_E3 (sd.depth - e0.col.path.length - 1) x0.2 ∧
      hcol_E3 sd.depth A = hcol_E3 (sd.depth - e0.col.path.length - 1) x0.2 ∧
      e0.col.num 0 < sd.t := by
  obtain ⟨-, h2, -, h4, -⟩ := stopData_core hsd
  have hlen := hon.length_le
  simp only [EntryAddr.heightPath, List.length_append, List.length_singleton] at hlen
  have hl : e0.col.path.length < sd.depth := by omega
  have hhp : e0.heightPath = sd.col.path.take (e0.col.path.length + 1) := by
    rw [List.prefix_iff_eq_take] at hon
    rw [hon]; simp [EntryAddr.heightPath]
  obtain ⟨hfa, hR, hN, hrp, hhc, hsum⟩ := skip_data_E3 hsd (i := e0.col.path.length + 1) (by omega)
  have hx : x0.2 = skipLayers A (e0.col.path.length + 1) := by
    have : A.forestAt e0.heightPath = some x0.2 := by
      rw [Tree.forestAt_heightPath, Tree.heightAt, hx0]; rfl
    rw [hhp, hfa] at this; exact (Option.some.inj this).symm
  have hnum : e0.col.num 0 + 1 = leftCount A (e0.col.path.length + 1) := by
    rw [← sum_heightPath_E3, hhp, hsum]
  have hd : sd.depth - e0.col.path.length - 1 = sd.depth - (e0.col.path.length + 1) := by omega
  rw [hd, hx]
  refine ⟨hl, hhp, rfl, hnum, hR, by omega, ?_, by rw [hhp]; exact hrp, hhc, by omega⟩
  simp only [routeCol_D3, skipLayers_add, show e0.col.path.length + 1 + (sd.depth - (e0.col.path.length + 1))
    = sd.depth by omega, h4, Option.getD_some]

/-- An entry inside the height of another has a shorter height word. -/
theorem N_inside_E3 {E : Forest} {e1 e : EntryAddr} {x1 x : Nat × Forest}
    (h1 : E.entryAt e1 = some x1) (hc : e1.heightPath <+: e.col.path) (h : E.entryAt e = some x) :
    N_E3 x.2 < N_E3 x1.2 := by
  obtain ⟨P, hP⟩ := hc
  have hfa : E.forestAt e1.heightPath = some x1.2 := by
    rw [Tree.forestAt_heightPath, Tree.heightAt, h1]; rfl
  have := entryAt_abs_E3 hfa ⟨⟨P, e.col.col⟩, e.idx⟩
  simp only [hP] at this
  rw [h] at this
  exact N_entry_lt_E3 _ _ _ this.symm

theorem len_col_snoc_E3 (e : Nat) (Q : Column) (z : Nat × Forest) {i : Nat} {y : Nat × Forest}
    (h : Q[i]? = some y) : (gwordAt (e + 1) y.2).length + 2 ≤ (gwordCol e (Q ++ [z])).length := by
  have hQ : Q ≠ [] := by rintro rfl; simp at h
  rw [gwordCol_append_E3 e hQ, List.length_append]
  have := len_col_entry_E3 e Q i y h
  obtain ⟨p, hz⟩ := z
  simp [gwordLater]; omega

/-- Heights in the query region are short against any route container. -/
theorem N_query_E3 {A : Forest} {sd : StopData} (hsd : stopData A = some sd) {e0 e : EntryAddr}
    {x0 x : Nat × Forest} (hx0 : A.entryAt e0 = some x0) (hon : e0.heightPath <+: sd.col.path)
    (hq : InQ_E3 sd e) (hx : A.entryAt e = some x) : N_E3 x.2 + 2 ≤ N_E3 x0.2 := by
  obtain ⟨-, -, -, -, hR, -, hrc, -⟩ := onR_pack_E3 hsd hx0 hon
  obtain ⟨hcol, -⟩ := stopData_spec hsd
  have hS := N_self_E3 hR
  rw [hrc] at hS
  have hstop : ∀ (i : Nat) (y : Nat × Forest), sd.Q[i]? = some y → N_E3 y.2 + 2 ≤ N_E3 x0.2 := by
    intro i y hy
    have := len_col_snoc_E3 0 sd.Q (sd.r, Tree.empty) hy
    rw [len_gwordAt_E3] at this
    have h' : N_E3 (Tree.node [sd.Q ++ [(sd.r, Tree.empty)]]) =
        (gwordCol 0 (sd.Q ++ [(sd.r, Tree.empty)])).length := by
      simp [N_E3, gwordAt, gwordCols]
    omega
  have hQe : ∀ i, i < sd.Q.length → A.entryAt ⟨sd.col, i⟩ = sd.Q[i]? := by
    intro i hi; simp only [Tree.entryAt, hcol, Option.bind_some]; rw [List.getElem?_append_left hi]
  rcases hq with ⟨h1, h2⟩ | ⟨i, hi, hc⟩
  · have : e = ⟨sd.col, e.idx⟩ := by rw [← h1]
    rw [this, hQe _ h2] at hx
    exact hstop _ _ hx
  · obtain ⟨y, hy⟩ : ∃ y, sd.Q[i]? = some y := ⟨_, List.getElem?_eq_getElem hi⟩
    have h1 := N_inside_E3 (by rw [hQe i hi]; exact hy) hc hx
    have := hstop i y hy
    omega

/-- Kept heights (outside the route and the hole) are short against the emptied route container. -/
theorem N_kept_E3 {A : Forest} {sd : StopData} (hsd : stopData A = some sd) {e0 e : EntryAddr}
    {x0 x : Nat × Forest} (hx0 : A.entryAt e0 = some x0) (hon : e0.heightPath <+: sd.col.path)
    (hnr : ¬ e.heightPath <+: sd.col.path) (hnh : ¬ InHole_E3 sd.depth A e.col)
    (hc : e0.heightPath <+: e.col.path) (hx : A.entryAt e = some x) :
    N_E3 x.2 < N_E3 (replaceAt 0 0 Tree.empty (sd.depth - e0.col.path.length - 1) x0.2) := by
  obtain ⟨hrp, -⟩ := stop_rpath_E3 hsd
  obtain ⟨hRA, -⟩ := stop_route_top_D3 hsd
  have hP := put_entryAt_E3 Tree.empty sd.depth A hRA
  have he : (replaceAt 0 0 Tree.empty sd.depth A).entryAt e = some x := by
    rw [(hP e).2.2 hnh (by rw [IsRoute_E3, hrp]; exact hnr), hx]
  have he0 : (replaceAt 0 0 Tree.empty sd.depth A).entryAt e0 =
      some (x0.1, replaceAt 0 0 Tree.empty (sd.depth - e0.col.path.length - 1) x0.2) := by
    rw [(hP e0).2.1 (by rw [InHole_E3, hrp]; exact route_not_hole_E3 hon)
      (by rw [IsRoute_E3, hrp]; exact hon), hx0]; rfl
  exact N_inside_E3 he0 hc he

/-- The shape of a step of the loop: the shifted query, then restored entries below `r`. -/
theorem ordStep_shape_E3 {A : Forest} {sd : StopData} {rd : RootData} (hL : InL A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) (k : Nat) (Z : Forest) :
    ∃ V rest, ordStep sd rd ((A.forestAt rd.col.path).getD Tree.empty)
      (((A.colAt rd.col).getD []).drop rd.cursor) (k + 1) Z =
        .node ((Tree.mapCol (shiftVal sd.r (k * period sd)) sd.Q ++ V) :: rest) ∧
      ∀ v ∈ V.head?, v.1 < sd.r := by
  obtain ⟨-, -, -, -, -, -, hUe, -⟩ := root_pack_E3 hL.1 hsd hrd
  have hU0 : ∀ u ∈ (((A.colAt rd.col).getD []).drop rd.cursor).head?, u.1 < sd.r := by
    intro u hu
    exact (hUe 0 u (by rw [List.head?_eq_getElem?] at hu; exact hu)).2.1
  simp only [ordStep, Nat.add_sub_cancel]
  split_ifs
  · refine ⟨_, [], by rw [List.append_assoc]; rfl, ?_⟩
    intro v hv
    rw [List.head?_eq_getElem?] at hv
    obtain ⟨u, hu, hx⟩ := mapLast_getElem_E3 _ _ _ 0 v hv
    rcases hx with ⟨-, rfl⟩ | ⟨-, rfl⟩ <;>
      exact hU0 u (by rw [List.head?_eq_getElem?]; exact hu)
  · refine ⟨_, _, rfl, ?_⟩
    intro v hv
    rw [List.head?_map] at hv
    obtain ⟨u, hu, rfl⟩ := Option.map_eq_some_iff.1 hv
    exact hU0 u hu

/-! The conclusion of T3.2m for one pair of heights. -/

/-- The conclusion of `ownerReturn_origin` for an old pair `(a, H), (c, J)` at phase `j` and a new
pair `(a', H'), (c', J')`. -/
def Concl_E3 (sd : StopData) (j a c : Nat) (H J : Forest) (a' c' : Nat) (H' J' : Forest) : Prop :=
  let kJ := keyWord (kappa sd.r (period sd) j (relKey c J))
  let kH := keyWord (kappa sd.r (period sd) j (relKey a H))
  let kJ' := keyWord (relKey c' J')
  let kH' := keyWord (relKey a' H')
  (kH' = kH ∨ ∃ b, kH'.take b = kH.take b ∧ b ≤ kH'.length ∧ kH' ≤ kH ∧
    (kJ' = kJ ∧ kJ.length < b ∨ ∃ a, a < b ∧ FirstDec kJ kJ' a)) ∧ (kH' = kH → kJ' = kJ)

theorem concl_eq_E3 {sd : StopData} {j a c : Nat} {H J : Forest} {a' c' : Nat} {H' J' : Forest}
    (hH : keyWord (relKey a' H') = keyWord (kappa sd.r (period sd) j (relKey a H)))
    (hJ : keyWord (relKey c' J') = keyWord (kappa sd.r (period sd) j (relKey c J))) :
    Concl_E3 sd j a c H J a' c' H' J' :=
  ⟨Or.inl hH, fun _ => hJ⟩

theorem concl_dec_E3 {sd : StopData} {j a c : Nat} {H J : Forest} {a' c' : Nat} {H' J' : Forest}
    {b : Nat} (hH : FirstDec (keyWord (kappa sd.r (period sd) j (relKey a H))) (keyWord (relKey a' H')) b)
    (hJ : (keyWord (relKey c' J') = keyWord (kappa sd.r (period sd) j (relKey c J)) ∧
        (keyWord (kappa sd.r (period sd) j (relKey c J))).length < b) ∨
      ∃ a0, a0 < b ∧ FirstDec (keyWord (kappa sd.r (period sd) j (relKey c J))) (keyWord (relKey c' J')) a0) :
    Concl_E3 sd j a c H J a' c' H' J' := by
  have hlt := lt_of_firstDec_E3 hH
  exact ⟨Or.inr ⟨b, hH.1, hH.2.1, le_of_lt hlt, hJ⟩, fun h => absurd h (ne_of_lt hlt)⟩

/-- A new pair of heights with an old owner return of `A` as origin. -/
def Good_E3 (A : Forest) (sd : StopData) (a' : Nat) (H' : Forest) (c' : Nat) (J' : Forest) : Prop :=
  ∃ e0 e j x0 x, A.entryAt e0 = some x0 ∧ A.entryAt e = some x ∧ IsOwnerReturn A e0 e ∧
    Concl_E3 sd j (e0.col.num 0) (e.col.num 0) x0.2 x.2 a' c' H' J'

/-- Every return to the host `a'` inside the height `H'` has an origin. -/
def HostGood_E3 (A : Forest) (sd : StopData) (a' : Nat) (H' : Forest) : Prop :=
  ∀ ρ J', H'.entryAt ρ = some (a', J') → Good_E3 A sd a' H' (ρ.col.num (a' + 1)) J'

/-- The absolute address of an entry read inside the height of `e0`. -/
def under_E3 (e0 ρ : EntryAddr) : EntryAddr := ⟨⟨e0.heightPath ++ ρ.col.path, ρ.col.col⟩, ρ.idx⟩

theorem under_entryAt_E3 {E : Forest} {e0 : EntryAddr} {x0 : Nat × Forest}
    (h : E.entryAt e0 = some x0) (ρ : EntryAddr) : E.entryAt (under_E3 e0 ρ) = x0.2.entryAt ρ := by
  have hfa : E.forestAt e0.heightPath = some x0.2 := by
    rw [Tree.forestAt_heightPath, Tree.heightAt, h]; rfl
  exact entryAt_abs_E3 hfa ρ

theorem under_num_E3 (e0 ρ : EntryAddr) :
    (under_E3 e0 ρ).col.num 0 = ρ.col.num (e0.col.num 0 + 1) := by
  rw [under_E3, num_abs_E3, sum_heightPath_E3]

theorem under_return_E3 {E : Forest} {e0 : EntryAddr} {x0 : Nat × Forest}
    (h : E.entryAt e0 = some x0) {ρ : EntryAddr} {J : Forest}
    (hρ : x0.2.entryAt ρ = some (e0.col.num 0, J)) :
    E.entryAt (under_E3 e0 ρ) = some (e0.col.num 0, J) ∧ IsOwnerReturn E e0 (under_E3 e0 ρ) := by
  have h1 : E.entryAt (under_E3 e0 ρ) = some (e0.col.num 0, J) := by
    rw [under_entryAt_E3 h, hρ]
  exact ⟨h1, isOwnerReturn_of_parent (List.prefix_append _ _) h1⟩

theorem shiftVal_host_E3 {r δ a p : Nat} (h : δ = 0 ∨ r ≤ a) (hp : shiftVal r δ p = a + δ) : p = a := by
  unfold shiftVal at hp; split_ifs at hp <;> omega

/-- Pure copies of hosts: returns are copies of old returns, at the same phase. -/
theorem hostS_E3 {A : Forest} (sd : StopData) {e0 : EntryAddr} {x0 : Nat × Forest}
    (hx0 : A.entryAt e0 = some x0) (ψ : Nat) (hψ : ψ = 0 ∨ sd.r ≤ e0.col.num 0) :
    HostGood_E3 A sd (e0.col.num 0 + ψ * period sd) (shift sd.r (ψ * period sd) x0.2) := by
  intro ρ J' hρ
  rw [shift, entryAt_map_D3] at hρ
  obtain ⟨x, hx, hxe⟩ := Option.map_eq_some_iff.1 hρ
  simp only [Prod.mk.injEq] at hxe
  obtain ⟨hp, rfl⟩ := hxe
  have hδ : ψ * period sd = 0 ∨ sd.r ≤ e0.col.num 0 := by
    rcases hψ with h | h
    · left; rw [h, Nat.zero_mul]
    · exact Or.inr h
  have hp' : x.1 = e0.col.num 0 := shiftVal_host_E3 hδ hp
  have hx' : x0.2.entryAt ρ = some (e0.col.num 0, x.2) := by rw [hx, ← hp']
  obtain ⟨h1, h2⟩ := under_return_E3 hx0 hx'
  have hψ' : ψ = 0 ∨ sd.r ≤ (under_E3 e0 ρ).col.num 0 := by
    rcases hψ with h | h
    · exact Or.inl h
    · right; rw [under_num_E3]; have := num_ge_E3 (e0.col.num 0 + 1) ρ.col; omega
  refine ⟨e0, under_E3 e0 ρ, ψ, x0, (e0.col.num 0, x.2), hx0, h1, h2, concl_eq_E3 ?_ ?_⟩
  · rw [kappa_eq_E3 _ _ _ _ hψ]
  · rw [kappa_eq_E3 _ _ _ _ hψ', under_num_E3, ← num_add_D3 (e0.col.num 0 + 1) (ψ * period sd) ρ.col,
      show e0.col.num 0 + ψ * period sd + 1 = e0.col.num 0 + 1 + ψ * period sd by omega]
    rfl

/-! Type C hosts: route containers, in the context or copied into a layer. -/

theorem inHole_map_E3 (f : Nat → Nat) (k : Nat) (F : Forest) (c : ColAddr) :
    InHole_E3 k (Tree.map f F) c ↔ InHole_E3 k F c := by
  simp only [InHole_E3, rpath_map_E3, hcol_map_E3]

theorem isRoute_map_E3 (f : Nat → Nat) (k : Nat) (F : Forest) (e : EntryAddr) :
    IsRoute_E3 k (Tree.map f F) e ↔ IsRoute_E3 k F e := by
  simp only [IsRoute_E3, rpath_map_E3]

/-- A route container numbered below `r` lies above the root column. -/
theorem low_route_E3 {A : Forest} {sd : StopData} {rd : RootData} (hV : CondV A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) {e0 : EntryAddr} {x0 : Nat × Forest}
    (hx0 : A.entryAt e0 = some x0) (hon : e0.heightPath <+: sd.col.path) (ha : e0.col.num 0 < sd.r) :
    e0.heightPath <+: rd.col.path := by
  obtain ⟨-, hhp, -, hnum, -⟩ := onR_pack_E3 hsd hx0 hon
  obtain ⟨hpath, -, -, hr, -⟩ := root_pack_E3 hV hsd hrd
  obtain ⟨-, -, -, hidx, -⟩ := root_facts_D3 hsd hrd
  rw [hhp, hpath]
  by_cases h : e0.col.path.length + 1 ≤ rd.layer
  · exact List.take_prefix_take_left h
  · exfalso
    have h1 := leftCount_mono_D3 A (show rd.layer + 1 ≤ e0.col.path.length + 1 by omega)
    rw [leftCount_succ_D3] at h1
    omega

/-- Route containers end with the stopping column. -/
theorem route_N_E3 {A : Forest} {sd : StopData} (hsd : stopData A = some sd) {e : EntryAddr}
    {x : Nat × Forest} (hx : A.entryAt e = some x) (hon : e.heightPath <+: sd.col.path) :
    N_E3 x.2 = N_E3 (replaceAt 0 0 Tree.empty (sd.depth - e.col.path.length - 1) x.2) +
      N_E3 (.node [sd.Q ++ [(sd.r, Tree.empty)]]) ∧
      1 ≤ N_E3 (.node [sd.Q ++ [(sd.r, Tree.empty)]]) := by
  obtain ⟨-, -, -, -, hR, -, hrc, -⟩ := onR_pack_E3 hsd hx hon
  have := N_self_E3 hR
  rw [hrc] at this
  exact ⟨this, N_col_pos_E3 _⟩

/-- The first decrease of a copied route container against its shifted old height. -/
theorem routeFD_E3 {A : Forest} {sd : StopData} {rd : RootData} {n : Nat} (hL : InL A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) {e : EntryAddr} {x : Nat × Forest}
    (hx : A.entryAt e = some x) (hon : e.heightPath <+: sd.col.path) {ψ : Nat} (hψ : ψ ≤ n) :
    FirstDec (gwordAt 0 (shift sd.r (ψ * period sd) x.2))
      (gwordAt 0 (replaceAt sd.r (ψ * period sd) (zs_E3 A sd rd n ψ) (sd.depth - e.col.path.length - 1) x.2))
      (if ψ < n then N_E3 x.2 - 1 else N_E3 x.2 - N_E3 (.node [sd.Q ++ [(sd.r, Tree.empty)]])) := by
  obtain ⟨-, -, -, -, hR, -, hrc, -⟩ := onR_pack_E3 hsd hx hon
  split_ifs with h
  · rw [zs_step_E3 A sd rd h]
    obtain ⟨V, rest, hsh, hV⟩ := ordStep_shape_E3 hL hsd hrd ψ (zs_E3 A sd rd n (ψ + 1))
    rw [hsh]
    exact fill_firstDec_head_E3 hR hrc le_rfl hV 0
  · rw [show ψ = n by omega, zs_top_E3]
    have := fill_firstDec_empty_E3 hR sd.r (n * period sd) 0
    rwa [hrc] at this

theorem empty_entryAt_E3 (e : EntryAddr) : (Tree.node [] : Forest).entryAt e = none := by
  obtain ⟨⟨P, j⟩, i⟩ := e
  cases P with
  | nil => simp [entryAt_nil_D3]
  | cons s P => obtain ⟨c, m⟩ := s; simp [entryAt_cons_D3]

theorem period_pos_E3 {A : Forest} {sd : StopData} {rd : RootData} (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) : 0 < period sd := by
  obtain ⟨-, -, -, -, hrt, -⟩ := rootData_spec hsd hrd
  simp only [period]; omega

/-- Route containers of phase `k` (the context ones for `k = 0`): every return has an origin;
the host height decreases first at the old closing entry (`k < n`) or at the old stopping column
(`k = n`), and the lower height is unchanged before that position or decreases earlier. -/
theorem hostC_E3 {A : Forest} {sd : StopData} {rd : RootData} {n : Nat} (hL : InL A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) {e0 : EntryAddr} {x0 : Nat × Forest}
    (hx0 : A.entryAt e0 = some x0) (hon : e0.heightPath <+: sd.col.path) {k : Nat} (hkn : k ≤ n)
    (hk : k = 0 ∨ sd.r ≤ e0.col.num 0) :
    HostGood_E3 A sd (e0.col.num 0 + k * period sd)
      (replaceAt sd.r (k * period sd) (zs_E3 A sd rd n k) (sd.depth - e0.col.path.length - 1) x0.2) := by
  have hE : E1_E3 A sd rd n k (zs_E3 A sd rd n k) := by
    have := zs_E1_E3 (n := n) hL hsd hrd (n - k) (by omega)
    rwa [show n - (n - k) = k by omega] at this
  have hd := period_pos_E3 hsd hrd
  obtain ⟨hl, hhp, hxH, hnum, hR, hN, hrc, hrp, hhc, hat⟩ := onR_pack_E3 hsd hx0 hon
  obtain ⟨hrpA, hhcA⟩ := stop_rpath_E3 hsd
  obtain ⟨hNH, hS⟩ := route_N_E3 hsd hx0 hon
  have hδ : k * period sd = 0 ∨ sd.r ≤ e0.col.num 0 := by
    rcases hk with h | h
    · left; rw [h, Nat.zero_mul]
    · exact Or.inr h
  -- the host's key words
  have hkH : ∀ j, (j = k ∨ (k = 0 ∧ e0.col.num 0 ≤ sd.r)) →
      keyWord (kappa sd.r (period sd) j (relKey (e0.col.num 0) x0.2)) =
        keyWord (relKey (e0.col.num 0 + k * period sd) (shift sd.r (k * period sd) x0.2)) := by
    rintro j (rfl | ⟨rfl, h⟩)
    · rw [kappa_eq_E3 _ _ _ _ hk]
    · rw [kappa_fix _ _ _ _ h, Nat.zero_mul, Nat.add_zero, shift_zero]
  set bH := if k < n then N_E3 x0.2 - 1 else N_E3 x0.2 - N_E3 (.node [sd.Q ++ [(sd.r, Tree.empty)]])
    with hbH
  have hFH : FirstDec (keyWord (relKey (e0.col.num 0 + k * period sd) (shift sd.r (k * period sd) x0.2)))
      (keyWord (relKey (e0.col.num 0 + k * period sd) (replaceAt sd.r (k * period sd)
        (zs_E3 A sd rd n k) (sd.depth - e0.col.path.length - 1) x0.2))) bH :=
    firstDec_keyWord_E3 _ (routeFD_E3 hL hsd hrd hx0 hon hkn)
  have hRG := (routeOK_shift_D3 sd.r (k * period sd) _ _).2 hR
  intro ρ J' hρ
  rw [replaceAt_eq_shift] at hρ
  have hP := put_entryAt_E3 (zs_E3 A sd rd n k) _ _ hRG ρ
  by_cases hh : InHole_E3 (sd.depth - e0.col.path.length - 1) (shift sd.r (k * period sd) x0.2) ρ.col
  · -- returns from the filling: the query region of the next head, or low parents
    obtain ⟨h1, h2⟩ := hP.1 hh
    rw [h1] at hρ
    obtain ⟨e, ψ, hψ1, hψ2, hψq, ⟨htr, htn, htl⟩, x, hxA, hx1, hc', hx2⟩ := hE _ _ hρ
    have hkn' : k < n := by
      by_contra hc
      rw [show k = n by omega, zs_top_E3, Tree.empty, empty_entryAt_E3] at hρ
      cases hρ
    simp only at hx1
    have hcase : x.1 = e0.col.num 0 ∧ ((k = 0 ∧ e0.col.num 0 < sd.r) ∨ (ψ = k ∧ InQ_E3 sd e)) := by
      unfold shiftVal at hx1
      split_ifs at hx1 with hxr
      · by_cases hψk : ψ = k
        · subst hψk; exact ⟨by omega, Or.inr ⟨rfl, hψq rfl⟩⟩
        · exfalso
          have : (k + 1) * period sd ≤ ψ * period sd := Nat.mul_le_mul_right _ (by omega)
          have : sd.t = sd.r + period sd := by simp only [period]; omega
          rw [Nat.succ_mul] at *
          omega
      · have hk0 : k = 0 := by
          rcases hk with h | h
          · exact h
          · exfalso; omega
        subst hk0
        exact ⟨by omega, Or.inl ⟨rfl, by omega⟩⟩
    obtain ⟨hxa, hcase⟩ := hcase
    have hcon : e0.Contains e.col := by
      rcases hcase with ⟨-, hlow⟩ | ⟨-, hq⟩
      · exact (low_route_E3 hL.1 hsd hrd hx0 hon hlow).trans htr
      · rcases hq with ⟨h1, -⟩ | ⟨i, -, hi⟩
        · show e0.heightPath <+: e.col.path; rw [h1]; exact hon
        · exact hon.trans ((List.prefix_append _ _).trans hi)
    have hret : IsOwnerReturn A e0 e := by
      have : A.entryAt ⟨e.col, e.idx⟩ = some (e0.col.num 0, x.2) := by rw [← hxa]; exact hxA
      exact isOwnerReturn_of_parent hcon this
    refine ⟨e0, e, ψ, x0, x, hx0, hxA, hret, ?_⟩
    have hkH' := hkH ψ (by
      rcases hcase with ⟨h1, h2⟩ | ⟨h1, -⟩
      · exact Or.inr ⟨h1, le_of_lt h2⟩
      · exact Or.inl h1)
    have hnumρ : ρ.col.num (e0.col.num 0 + k * period sd + 1) = e.col.num 0 + ψ * period sd := by
      rw [h2, routeNum_shift_D3, show e0.col.num 0 + k * period sd + 1 +
        routeNum_D3 (sd.depth - e0.col.path.length - 1) x0.2 = sd.t + k * period sd by omega]
      exact hc'
    have hbH : bH = N_E3 x0.2 - 1 := by rw [hbH, if_pos hkn']
    refine concl_dec_E3 (b := bH) (by rw [hkH']; exact hFH) ?_
    rw [hnumρ, kappa_eq_E3 _ _ _ _ (Or.inr htn)]
    rcases hx2 with ⟨hnr, hJ'⟩ | ⟨hon', hJ'⟩ <;> simp only at hJ'
    · left
      refine ⟨by rw [hJ'], ?_⟩
      rw [len_keyWord_E3, N_shift_E3, hbH]
      by_cases hq : InQ_E3 sd e
      · have := N_query_E3 hsd hx0 hon hq hxA; omega
      · have hnh := htl.resolve_left hq
        have := N_kept_E3 hsd hx0 hon hnr hnh hcon hxA
        omega
    · right
      have hfd := firstDec_keyWord_E3 (e.col.num 0 + ψ * period sd) (routeFD_E3 hL hsd hrd hxA hon' hψ2)
      rw [← hJ'] at hfd
      refine ⟨_, ?_, hfd⟩
      have hlt := N_inside_E3 hx0 hcon hxA
      obtain ⟨hNx, hSx⟩ := route_N_E3 hsd hxA hon'
      rw [hbH]
      split_ifs <;> omega
  · have hgen : ∀ x, x0.2.entryAt ρ = some x →
        shiftVal sd.r (k * period sd) x.1 = e0.col.num 0 + k * period sd →
        x.1 = e0.col.num 0 ∧ A.entryAt (under_E3 e0 ρ) = some (e0.col.num 0, x.2) ∧
          IsOwnerReturn A e0 (under_E3 e0 ρ) ∧ (k = 0 ∨ sd.r ≤ (under_E3 e0 ρ).col.num 0) ∧
          ρ.col.num (e0.col.num 0 + k * period sd + 1) = (under_E3 e0 ρ).col.num 0 + k * period sd := by
      intro x hx hp
      have hxa : x.1 = e0.col.num 0 := shiftVal_host_E3 hδ hp
      have hx' : x0.2.entryAt ρ = some (e0.col.num 0, x.2) := by rw [hx, ← hxa]
      obtain ⟨h1, h2⟩ := under_return_E3 hx0 hx'
      refine ⟨hxa, h1, h2, ?_, ?_⟩
      · rcases hk with h | h
        · exact Or.inl h
        · right; rw [under_num_E3]; have := num_ge_E3 (e0.col.num 0 + 1) ρ.col; omega
      · rw [under_num_E3, ← num_add_D3 (e0.col.num 0 + 1) (k * period sd) ρ.col]; congr 1; omega
    by_cases hr : IsRoute_E3 (sd.depth - e0.col.path.length - 1) (shift sd.r (k * period sd) x0.2) ρ
    · -- route containers inside the host: both heights change, the lower one first
      rw [hP.2.1 hh hr, shift, entryAt_map_D3, Option.map_map] at hρ
      obtain ⟨x, hx, hxe⟩ := Option.map_eq_some_iff.1 hρ
      simp only [Function.comp, Prod.mk.injEq] at hxe
      obtain ⟨hp, hJ'⟩ := hxe
      obtain ⟨hxa, h1, h2, hk', hnumρ⟩ := hgen x hx hp
      refine ⟨e0, under_E3 e0 ρ, k, x0, (e0.col.num 0, x.2), hx0, h1, h2, ?_⟩
      have hon' : (under_E3 e0 ρ).heightPath <+: sd.col.path := by
        have := (isRoute_abs_E3 hrp ρ).2 ((isRoute_map_E3 _ _ _ _).1 hr)
        rwa [IsRoute_E3, hrpA] at this
      have hlen : (under_E3 e0 ρ).col.path.length = e0.col.path.length + 1 + ρ.col.path.length := by
        simp [under_E3, EntryAddr.heightPath]; omega
      have hfd := firstDec_keyWord_E3 ((under_E3 e0 ρ).col.num 0 + k * period sd)
        (routeFD_E3 hL hsd hrd h1 hon' hkn)
      have hJ'' : replaceAt sd.r (k * period sd) (zs_E3 A sd rd n k)
          (sd.depth - (under_E3 e0 ρ).col.path.length - 1) x.2 = J' := by
        rw [← hJ', hlen, replaceAt_eq_shift]
        congr 1; omega
      simp only at hfd
      rw [hJ''] at hfd
      refine concl_dec_E3 (b := bH) (by rw [hkH k (Or.inl rfl)]; exact hFH) ?_
      rw [hnumρ, kappa_eq_E3 _ _ _ _ hk']
      refine Or.inr ⟨_, ?_, hfd⟩
      have hlt := N_entry_lt_E3 _ _ _ hx
      obtain ⟨hNx, hSx⟩ := route_N_E3 hsd h1 hon'
      rw [hbH]
      split_ifs <;> simp only at hlt hNx <;> omega
    · -- kept entries: pure copies, ending before the host's first change
      rw [hP.2.2 hh hr, shift, entryAt_map_D3] at hρ
      obtain ⟨x, hx, hxe⟩ := Option.map_eq_some_iff.1 hρ
      simp only [Prod.mk.injEq] at hxe
      obtain ⟨hp, hJ'⟩ := hxe
      obtain ⟨hxa, h1, h2, hk', hnumρ⟩ := hgen x hx hp
      refine ⟨e0, under_E3 e0 ρ, k, x0, (e0.col.num 0, x.2), hx0, h1, h2, ?_⟩
      have hC : (replaceAt 0 0 Tree.empty (sd.depth - e0.col.path.length - 1) x0.2).entryAt ρ = some x := by
        rw [(put_entryAt_E3 Tree.empty _ _ hR ρ).2.2 ((inHole_map_E3 _ _ _ _).not.1 hh)
          ((isRoute_map_E3 _ _ _ _).not.1 hr), hx]
      have hlt := N_entry_lt_E3 _ _ _ hC
      refine concl_dec_E3 (b := bH) (by rw [hkH k (Or.inl rfl)]; exact hFH) ?_
      rw [hnumρ, kappa_eq_E3 _ _ _ _ hk']
      refine Or.inl ⟨by rw [← hJ']; rfl, ?_⟩
      rw [len_keyWord_E3, N_shift_E3, hbH]
      simp only at hlt ⊢
      split_ifs <;> omega

theorem replaceAt_zero_E3 (r : Nat) (Z : Forest) (k : Nat) (F : Forest) :
    replaceAt r 0 Z k F = replaceAt 0 0 Z k F := by
  rw [replaceAt_eq_shift, shift_zero]

/-- Every host of an ordinary output has origins for all its returns. -/
theorem hosts_E3 {A : Forest} {sd : StopData} {rd : RootData} {n : Nat} (hL : InL A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) {e0' : EntryAddr} {y0 : Nat × Forest}
    (hy0 : (replaceAt 0 0 (zs_E3 A sd rd n 0) sd.depth A).entryAt e0' = some y0) :
    HostGood_E3 A sd (e0'.col.num 0) y0.2 := by
  obtain ⟨hrpA, hhcA⟩ := stop_rpath_E3 hsd
  obtain ⟨hRA, hNA⟩ := stop_route_top_D3 hsd
  have hP := put_entryAt_E3 (zs_E3 A sd rd n 0) sd.depth A hRA e0'
  by_cases hh : InHole_E3 sd.depth A e0'.col
  · obtain ⟨h1, h2⟩ := hP.1 hh
    rw [h1] at hy0
    have hE := zs_E1_E3 (n := n) hL hsd hrd n le_rfl
    rw [Nat.sub_self] at hE
    obtain ⟨e, ψ, -, hψ2, -, ⟨-, htn, -⟩, x, hxA, -, hc', hx2⟩ := hE _ _ hy0
    have hnum : e0'.col.num 0 = e.col.num 0 + ψ * period sd := by
      rw [h2 0, Nat.zero_add, hNA, ← hc', Nat.zero_mul, Nat.add_zero]
    rw [hnum]
    rcases hx2 with ⟨-, hJ⟩ | ⟨hon, hJ⟩
    · rw [hJ]; exact hostS_E3 sd hxA ψ (Or.inr htn)
    · rw [hJ]; exact hostC_E3 hL hsd hrd hxA hon hψ2 (Or.inr htn)
  · by_cases hr : IsRoute_E3 sd.depth A e0'
    · rw [hP.2.1 hh hr] at hy0
      obtain ⟨x, hx, rfl⟩ := Option.map_eq_some_iff.1 hy0
      have hon : e0'.heightPath <+: sd.col.path := by rw [IsRoute_E3, hrpA] at hr; exact hr
      have := hostC_E3 (n := n) hL hsd hrd hx hon (Nat.zero_le n) (Or.inl rfl)
      rw [Nat.zero_mul, Nat.add_zero, replaceAt_zero_E3] at this
      exact this
    · rw [hP.2.2 hh hr] at hy0
      have := hostS_E3 sd hy0 0 (Or.inl rfl)
      rw [Nat.zero_mul, Nat.add_zero, shift_zero] at this
      exact this

/-- Entry-level classification of an ordinary output `B = A[n]` (reusable form of T3.2i at the
level of entries): every entry of `B` is an unchanged context entry, a context route container
whose height is filled with the layers, or (in the hole) a phase-`ψ` copy of a template entry of
`A` (`Orig_E3`: parent and number shifted by `ψ d`, height shifted, or filled for route
containers). -/
theorem ord_entry_origin_E3 {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .ordinary)
    (hB : expand A n = some B) {sd : StopData} {rd : RootData} (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) {e' : EntryAddr} {y : Nat × Forest} (hy : B.entryAt e' = some y) :
    (¬ InHole_E3 sd.depth A e'.col ∧ ¬ e'.heightPath <+: sd.col.path ∧ A.entryAt e' = some y) ∨
    (e'.heightPath <+: sd.col.path ∧ ∃ x, A.entryAt e' = some x ∧
      y = (x.1, replaceAt 0 0 (zs_E3 A sd rd n 0) (sd.depth - e'.col.path.length - 1) x.2)) ∨
    (InHole_E3 sd.depth A e'.col ∧ ∃ e ψ, ψ ≤ n ∧ Tmpl_E3 A sd rd e ∧
      Orig_E3 A sd rd n ψ e y (e'.col.num 0)) := by
  obtain ⟨sd', rd', hsd', hrd', hBeq, -⟩ := ord_output_D3 hL hk hB
  rw [hsd] at hsd'; cases hsd'
  rw [hrd] at hrd'; cases hrd'
  rw [ordZ_eq_zs_E3] at hBeq
  subst hBeq
  obtain ⟨hrpA, -⟩ := stop_rpath_E3 hsd
  obtain ⟨hRA, hNA⟩ := stop_route_top_D3 hsd
  have hPu := put_entryAt_E3 (zs_E3 A sd rd n 0) sd.depth A hRA e'
  by_cases hh : InHole_E3 sd.depth A e'.col
  · right; right
    obtain ⟨h1, h2⟩ := hPu.1 hh
    rw [h1] at hy
    have hE := zs_E1_E3 (n := n) hL hsd hrd n le_rfl
    rw [Nat.sub_self] at hE
    obtain ⟨e, ψ, -, hψ2, -, ht, ho⟩ := hE _ _ hy
    refine ⟨hh, e, ψ, hψ2, ht, ?_⟩
    rw [h2 0, Nat.zero_add, hNA]
    simpa using ho
  · by_cases hr : IsRoute_E3 sd.depth A e'
    · right; left
      rw [hPu.2.1 hh hr] at hy
      obtain ⟨x, hx, rfl⟩ := Option.map_eq_some_iff.1 hy
      exact ⟨by rw [IsRoute_E3, hrpA] at hr; exact hr, x, hx, rfl⟩
    · left
      rw [hPu.2.2 hh hr] at hy
      exact ⟨hh, by rw [IsRoute_E3, hrpA] at hr; exact hr, hy⟩

-- T3.2m (txt:350-362): every owner return of an ordinary output has an old origin; the key
-- words of both heights are the phase images of the old ones, changed only by decreases whose
-- first changes respect the containment offset (or the lower height is unchanged and ends
-- before the upper change)
theorem ownerReturn_origin {A B : Forest} {sd : StopData} {rd : RootData} {n : Nat} (hL : InL A)
    (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd) (hrd : rootData A = some rd)
    (hB : expand A n = some B) {e0' e' : EntryAddr} (he0 : e0' ∈ B.entryAddrs)
    (he : e' ∈ B.entryAddrs) (hret : IsOwnerReturn B e0' e') :
    ∃ e0 e j, e0 ∈ A.entryAddrs ∧ e ∈ A.entryAddrs ∧ IsOwnerReturn A e0 e ∧
      let J := (A.heightAt e).getD Tree.empty
      let H := (A.heightAt e0).getD Tree.empty
      let J' := (B.heightAt e').getD Tree.empty
      let H' := (B.heightAt e0').getD Tree.empty
      let kJ := keyWord (kappa sd.r (period sd) j (relKey (e.col.num 0) J))
      let kH := keyWord (kappa sd.r (period sd) j (relKey (e0.col.num 0) H))
      let kJ' := keyWord (relKey (e'.col.num 0) J')
      let kH' := keyWord (relKey (e0'.col.num 0) H')
      (kH' = kH ∨ ∃ b, kH'.take b = kH.take b ∧ b ≤ kH'.length ∧ kH' ≤ kH ∧
        (kJ' = kJ ∧ kJ.length < b ∨ ∃ a, a < b ∧ FirstDec kJ kJ' a)) ∧
      (kH' = kH → kJ' = kJ) := by
  obtain ⟨sd', rd', hsd', hrd', hBeq, -⟩ := ord_output_D3 hL hk hB
  rw [hsd] at hsd'; cases hsd'
  rw [hrd] at hrd'; cases hrd'
  rw [ordZ_eq_zs_E3] at hBeq
  obtain ⟨y0, hy0⟩ := Option.isSome_iff_exists.1 ((Tree.mem_entryAddrs_iff B e0').1 he0)
  obtain ⟨hcon, q, J', hJ, hres⟩ := hret
  have hq : q = e0'.col.num 0 := (ColAddr.resolve_num hres).symm
  subst hq
  obtain ⟨P, hP⟩ := hcon
  have he' : e' = under_E3 e0' ⟨⟨P, e'.col.col⟩, e'.idx⟩ := by
    simp only [under_E3, hP]
  have hρ : y0.2.entryAt ⟨⟨P, e'.col.col⟩, e'.idx⟩ = some (e0'.col.num 0, J') := by
    rw [← under_entryAt_E3 hy0, ← he', hJ]
  have hG := hosts_E3 (n := n) hL hsd hrd (by rw [← hBeq]; exact hy0) _ _ hρ
  rw [← under_num_E3, ← he'] at hG
  obtain ⟨e0, e, j, x0, x, hx0, hx, hret', hC⟩ := hG
  refine ⟨e0, e, j, (Tree.mem_entryAddrs_iff A e0).2 (by rw [hx0]; rfl),
    (Tree.mem_entryAddrs_iff A e).2 (by rw [hx]; rfl), hret', ?_⟩
  have h1 : (A.heightAt e).getD Tree.empty = x.2 := by simp [Tree.heightAt, hx]
  have h2 : (A.heightAt e0).getD Tree.empty = x0.2 := by simp [Tree.heightAt, hx0]
  have h3 : (B.heightAt e').getD Tree.empty = J' := by simp [Tree.heightAt, hJ]
  have h4 : (B.heightAt e0').getD Tree.empty = y0.2 := by simp [Tree.heightAt, hy0]
  simp only [h1, h2, h3, h4]
  exact hC

/-- T3.2n helper (branch D3): key-word order is key order. -/
theorem keyWord_lt_iff_D3 (K K' : Key) : keyWord K < keyWord K' ↔ K < K' := by
  unfold keyWord
  rw [← gword, ← gword, gword_lt_iff,
    Tree.cmp_map (c := keyLabelCmp) (fun x y => (keyLabelCmp_eq x y).symm)]
  rfl

-- T3.2n (txt:363-366): ordinary outputs satisfy S (no output A is used)
theorem condS_ord {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .ordinary)
    (hB : expand A n = some B) : CondS B := by
  obtain ⟨sd, hsd⟩ := Option.isSome_iff_exists.mp (stopData_of_stepKind hk (by decide))
  obtain ⟨rd, hrd⟩ := Option.isSome_iff_exists.mp (rootData_of_ordinary hk)
  intro e0' he0 e' he hret
  obtain ⟨e0, e, j, he0A, heA, hretA, hpos, heq⟩ :=
    ownerReturn_origin hL hk hsd hrd hB he0 he hret
  have hSA := hL.2.2.2.2 e0 he0A e heA hretA
  have hlt : keyWord (kappa sd.r (period sd) j (relKey (e.col.num 0) ((A.heightAt e).getD Tree.empty))) <
      keyWord (kappa sd.r (period sd) j (relKey (e0.col.num 0) ((A.heightAt e0).getD Tree.empty))) :=
    (keyWord_lt_iff_D3 _ _).2 (kappa_strictMono _ _ _ hSA)
  rw [← keyWord_lt_iff_D3]
  rcases hpos with hH | ⟨b, hb1, hb2, -, hJ | ⟨a, hab, hfd⟩⟩
  · rw [hH, heq hH]; exact hlt
  · rw [hJ.1]
    refine lt_of_take_succ hlt ?_
    have h1 := congrArg (List.take (keyWord (kappa sd.r (period sd) j
      (relKey (e.col.num 0) ((A.heightAt e).getD Tree.empty)))).length.succ) hb1
    rw [List.take_take, List.take_take] at h1
    rwa [min_eq_left (by omega)] at h1
  · exact lt_of_firstDec hlt hfd ⟨hb1, hb2⟩ hab

/-! ### T3.2o helpers (branch E3): profiles of shifted and filled heights -/

theorem takeWhile_map_len_E3 {f : Nat → Nat} (hf : Function.Injective f) (p : Nat) :
    ∀ rest : Column, ((Tree.mapCol f rest).takeWhile (fun x => x.1 == f p)).length =
      (rest.takeWhile (fun x => x.1 == p)).length
  | [] => rfl
  | (q, h) :: rest => by
    simp only [Tree.mapCol, List.takeWhile_cons]
    by_cases hq : q = p
    · subst hq; simp [takeWhile_map_len_E3 hf q rest]
    · have : f q ≠ f p := fun h => hq (hf h)
      simp [hq, this]

theorem profileAux_map_E3 {f : Nat → Nat} (hf : Function.Injective f) (d : Nat) (X : Forest) :
    profileAux d (Tree.map f X) = profileAux d X := by
  induction d, X using profileAux.induct with
  | case1 d p rest tail =>
    simp only [Tree.map, Tree.mapCols, Tree.mapCol, profileAux]
    rw [takeWhile_map_len_E3 hf p rest]
  | case2 d p rest tail head tail_1 ih =>
    simp only [Tree.map, Tree.mapCols, Tree.mapCol] at ih ⊢
    rw [profileAux, profileAux]; exact ih
  | case3 d cols hne =>
    match cols, hne with
    | [], _ => simp [Tree.map, Tree.mapCols, profileAux]
    | [] :: cs, _ => simp [Tree.map, Tree.mapCols, Tree.mapCol, profileAux]
    | ((p, h) :: rest) :: cs, hne => exact absurd rfl (hne p h rest cs)

theorem profile_shift_E3 (r d : Nat) (X : Forest) : profile (shift r d X) = profile X := by
  have hf : Function.Injective (shiftVal r d) := (StrictMono.injective (fun _ _ h =>
    shiftVal_strictMono_D3 r d h))
  obtain ⟨cols⟩ := X
  cases cols with
  | nil => rfl
  | cons c cs =>
    show (profileAux 0 (Tree.map (shiftVal r d) (Tree.node (c :: cs))) : WithBot (Nat ×ₗ Nat)) =
      profileAux 0 (Tree.node (c :: cs))
    rw [profileAux_map_E3 hf]

/-- One more singleton level above a height. -/
def sig_E3 : WithBot (Nat ×ₗ Nat) → WithBot (Nat ×ₗ Nat)
  | ⊥ => ((toLex (0, 1) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat))
  | (x : Nat ×ₗ Nat) => ((toLex ((ofLex x).1 + 1, (ofLex x).2) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat))

theorem profile_single_E3 (p : Nat) (Y : Forest) : profile (.node [[(p, Y)]]) = sig_E3 (profile Y) := by
  obtain ⟨ycols⟩ := Y
  cases ycols with
  | nil =>
    show (profileAux 0 (Tree.node [[(p, Tree.node [])]]) : WithBot (Nat ×ₗ Nat)) = sig_E3 ⊥
    simp [profileAux, sig_E3]
  | cons c cs =>
    show (profileAux 0 (Tree.node [[(p, Tree.node (c :: cs))]]) : WithBot (Nat ×ₗ Nat)) = _
    rw [spx_profileAux_cons 0 p (by simp [Tree.cols]), spx_profileAux_one]
    rfl

theorem lt_sig_E3 (x : WithBot (Nat ×ₗ Nat)) : x < sig_E3 x := by
  cases x with
  | bot => exact WithBot.bot_lt_coe _
  | coe x =>
    simp only [sig_E3]
    rw [WithBot.coe_lt_coe, ← toLex_ofLex x, Prod.Lex.lt_iff]
    left; simp

theorem sig_mono_E3 {x y : WithBot (Nat ×ₗ Nat)} (h : x ≤ y) : sig_E3 x ≤ sig_E3 y := by
  cases x with
  | bot =>
    cases y with
    | bot => exact le_rfl
    | coe y =>
      simp only [sig_E3]
      rw [WithBot.coe_le_coe]
      apply le_of_lt
      rw [Prod.Lex.lt_iff]; left; simp
  | coe x =>
    cases y with
    | bot => exact absurd h (by simp)
    | coe y =>
      simp only [sig_E3]
      rw [WithBot.coe_le_coe] at h ⊢
      rw [← toLex_ofLex x, ← toLex_ofLex y, Prod.Lex.le_iff] at h
      rw [Prod.Lex.le_iff]
      simp only [ofLex_toLex] at h ⊢
      omega

theorem sig_strictMono_E3 : StrictMono sig_E3 := by
  intro x y h
  cases x with
  | bot =>
    cases y with
    | bot => exact absurd h (lt_irrefl _)
    | coe y =>
      simp only [sig_E3]
      rw [WithBot.coe_lt_coe, ← toLex_ofLex y, Prod.Lex.lt_iff]
      simp only [ofLex_toLex]
      left; omega
  | coe x =>
    cases y with
    | bot => exact absurd h (by simp)
    | coe y =>
      simp only [sig_E3]
      rw [WithBot.coe_lt_coe] at h ⊢
      rw [← toLex_ofLex x, ← toLex_ofLex y, Prod.Lex.lt_iff] at h
      rw [Prod.Lex.lt_iff]
      simp only [ofLex_toLex] at h ⊢
      omega

theorem sig_iter_mono_E3 (k : Nat) {x y : WithBot (Nat ×ₗ Nat)} (h : x ≤ y) :
    sig_E3^[k] x ≤ sig_E3^[k] y := by
  induction k generalizing x y with
  | zero => exact h
  | succ k ih => rw [Function.iterate_succ_apply, Function.iterate_succ_apply]; exact ih (sig_mono_E3 h)

theorem sig_iter_coe_E3 (k a b : Nat) :
    sig_E3^[k] (((toLex (a, b) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat))) =
      ((toLex (a + k, b) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by
  induction k generalizing a with
  | zero => rfl
  | succ k ih =>
    rw [Function.iterate_succ_apply]
    simp only [sig_E3, ofLex_toLex]
    rw [ih]; congr 3; omega

/-- A singleton chain of depth `k`: one column with one entry at each level above depth `k`, and a
single column at depth `k`. -/
def Chain_E3 : Nat → Forest → Prop
  | 0, S => S.cols.length = 1
  | k + 1, X => ∃ p Y, X = .node [[(p, Y)]] ∧ Chain_E3 k Y

theorem chain_routeOK_E3 : ∀ (k : Nat) (X : Forest), Chain_E3 k X → RouteOK_D3 k X
  | 0, X, h => by
    show X.cols ≠ []
    intro hc; simp [Chain_E3, hc] at h
  | k + 1, _, ⟨p, Y, rfl, h⟩ => ⟨[], [], p, Y, rfl, chain_routeOK_E3 k Y h⟩

theorem chain_map_E3 (f : Nat → Nat) : ∀ (k : Nat) (X : Forest),
    Chain_E3 k (Tree.map f X) ↔ Chain_E3 k X
  | 0, X => by simp only [Chain_E3, cols_length_map_E3]
  | k + 1, .node cols => by
    simp only [Chain_E3]
    constructor
    · rintro ⟨p, Y, hX, h⟩
      simp only [Tree.map, Tree.node.injEq] at hX
      match cols, hX with
      | [[(q, Y0)]], hX =>
        simp only [Tree.mapCols, Tree.mapCol, List.cons.injEq, Prod.mk.injEq, and_true] at hX
        obtain ⟨-, rfl⟩ := hX
        exact ⟨q, Y0, rfl, (chain_map_E3 f k Y0).1 h⟩
      | [], hX => simp [Tree.mapCols] at hX
      | [[]], hX => simp [Tree.mapCols, Tree.mapCol] at hX
      | [x :: y :: zs], hX => simp [Tree.mapCols, Tree.mapCol] at hX
      | c :: d :: ds, hX => simp [Tree.mapCols] at hX
    · rintro ⟨p, Y, hX, h⟩
      cases hX
      exact ⟨f p, Tree.map f Y, by simp [Tree.map, Tree.mapCols, Tree.mapCol],
        (chain_map_E3 f k Y).2 h⟩

theorem nextLayer_single_E3 (p : Nat) (Y : Forest) : nextLayer (.node [[(p, Y)]]) = Y := by
  simp [nextLayer, lastEntry?, Tree.cols]

theorem chain_skip_E3 : ∀ (k : Nat) (X : Forest), Chain_E3 k X → ∀ j, j ≤ k →
    Chain_E3 (k - j) (skipLayers X j)
  | k, X, h, 0, _ => by simpa [skipLayers] using h
  | 0, X, h, j + 1, hj => absurd hj (by omega)
  | k + 1, _, ⟨p, Y, rfl, h⟩, j + 1, hj => by
    rw [skipLayers, nextLayer_single_E3, show k + 1 - (j + 1) = k - j by omega]
    exact chain_skip_E3 k Y h j (by omega)

theorem put_single_E3 (Z : Forest) (k p : Nat) (Y : Forest) :
    replaceAt 0 0 Z (k + 1) (.node [[(p, Y)]]) = .node [[(p, replaceAt 0 0 Z k Y)]] := by
  have := put_succ_D3 Z k [] [] p Y
  simpa using this

theorem chain_put_E3 (Z : Forest) : ∀ (k : Nat) (X : Forest), Chain_E3 k X →
    profile (replaceAt 0 0 Z k X) = sig_E3^[k] (profile Z)
  | 0, .node cols, h => by
    simp only [Chain_E3, Tree.cols] at h
    match cols, h with
    | [c], _ =>
      rw [put_zero_D3 Z (by simp)]
      simp only [List.dropLast_singleton, List.nil_append, Function.iterate_zero, id, eta_E3]
  | k + 1, _, ⟨p, Y, rfl, h⟩ => by
    rw [put_single_E3, profile_single_E3, chain_put_E3 Z k Y h, Function.iterate_succ_apply']

theorem chain_self_E3 {k : Nat} {X : Forest} (h : Chain_E3 k X) :
    profile X = sig_E3^[k] (profile (.node [routeCol_D3 k X])) := by
  conv_lhs => rw [← put_self_D3 k X (chain_routeOK_E3 k X h)]
  exact chain_put_E3 _ k X h

/-- Route containers of a filled chain have smaller profiles than the filled chain. -/
theorem chain_route_E3 (Z : Forest) : ∀ (k : Nat) (X : Forest), Chain_E3 k X →
    ∀ (ρ : EntryAddr) (x : Nat × Forest), IsRoute_E3 k X ρ → X.entryAt ρ = some x →
      profile (replaceAt 0 0 Z (k - ρ.col.path.length - 1) x.2) < profile (replaceAt 0 0 Z k X)
  | 0, X, _, ρ, x, hr, _ => by
    exfalso; have := hr.length_le; simp [rpath_E3, EntryAddr.heightPath] at this
  | k + 1, _, ⟨p, Y, rfl, h⟩, ⟨⟨P, c⟩, i⟩, x, hr, hx => by
    have hrp : rpath_E3 (k + 1) (.node [[(p, Y)]]) = (0, 0) :: rpath_E3 k Y := by
      have := rpath_snoc_E3 k [] [] p Y; simpa using this
    rw [put_single_E3, profile_single_E3]
    cases P with
    | nil =>
      simp only [IsRoute_E3, EntryAddr.heightPath, hrp, List.nil_append, List.cons_prefix_cons,
        Prod.mk.injEq, List.nil_prefix, and_true] at hr
      obtain ⟨rfl, rfl⟩ := hr
      simp only [entryAt_nil_D3] at hx
      simp at hx; subst hx
      simpa using lt_sig_E3 _
    | cons s P =>
      obtain ⟨c0, i0⟩ := s
      simp only [IsRoute_E3, EntryAddr.heightPath, hrp, List.cons_append, List.cons_prefix_cons,
        Prod.mk.injEq] at hr
      obtain ⟨⟨rfl, rfl⟩, hr⟩ := hr
      rw [entryAt_cons_D3] at hx
      simp only [List.getElem?_cons_zero, Option.bind_some] at hx
      have := chain_route_E3 Z k Y h ⟨⟨P, c⟩, i⟩ x hr hx
      simp only [List.length_cons] at this ⊢
      rw [show k + 1 - (P.length + 1) - 1 = k - P.length - 1 by omega]
      exact lt_trans this (lt_sig_E3 _)

/-- In a chain every entry is a route container or lies in the hole. -/
theorem chain_entries_E3 : ∀ (k : Nat) (X : Forest), Chain_E3 k X → ∀ (ρ : EntryAddr) (x : Nat × Forest),
    X.entryAt ρ = some x → IsRoute_E3 k X ρ ∨ InHole_E3 k X ρ.col
  | 0, X, h, ⟨⟨P, c⟩, i⟩, x, _ => by
    right
    have h0 : hcol_E3 0 X = 0 := by simp only [hcol_E3, skipLayers]; simp only [Chain_E3] at h; omega
    cases P with
    | nil => exact Or.inl ⟨rfl, by rw [h0]; omega⟩
    | cons s P => exact Or.inr ⟨s.1, s.2, P, rfl, by rw [h0]; omega⟩
  | k + 1, _, ⟨p, Y, rfl, h⟩, ⟨⟨P, c⟩, i⟩, x, hx => by
    have hrp : rpath_E3 (k + 1) (.node [[(p, Y)]]) = (0, 0) :: rpath_E3 k Y := by
      have := rpath_snoc_E3 k [] [] p Y; simpa using this
    have hhc : hcol_E3 (k + 1) (.node [[(p, Y)]]) = hcol_E3 k Y := by
      have := hcol_snoc_E3 k [] [] p Y; simpa using this
    cases P with
    | nil =>
      left
      rw [entryAt_nil_D3] at hx
      rcases c with _ | c
      · rcases i with _ | i
        · simp [IsRoute_E3, EntryAddr.heightPath, hrp]
        · simp at hx
      · simp at hx
    | cons s P =>
      obtain ⟨c0, i0⟩ := s
      rw [entryAt_cons_D3] at hx
      rcases c0 with _ | c0
      · rcases i0 with _ | i0
        · simp only [List.getElem?_cons_zero, Option.bind_some] at hx
          rcases chain_entries_E3 k Y h ⟨⟨P, c⟩, i⟩ x hx with h1 | h1
          · left
            simp only [IsRoute_E3, EntryAddr.heightPath, hrp, List.cons_append,
              List.cons_prefix_cons, true_and] at h1 ⊢
            exact h1
          · right
            simp only [InHole_E3, hrp, hhc, List.cons_append, List.cons.injEq, true_and] at h1 ⊢
            exact h1
        · simp at hx
      · simp at hx

theorem profileAux_col_E3 (d : Nat) (c : Column) (cs : List Column) :
    profileAux d (.node (c :: cs)) = profileAux d (.node [c]) := by
  rcases c with _ | ⟨⟨p, h⟩, rest⟩
  · simp [profileAux]
  · obtain ⟨hc⟩ := h
    cases hc <;> simp [profileAux]

theorem takeWhile_fst_len_E3 (p : Nat) : ∀ (l l' : Column), l.map Prod.fst = l'.map Prod.fst →
    (l.takeWhile (fun x => x.1 == p)).length = (l'.takeWhile (fun x => x.1 == p)).length
  | [], [], _ => rfl
  | [], _ :: _, h => by simp at h
  | _ :: _, [], h => by simp at h
  | x :: l, y :: l', h => by
    simp only [List.map_cons, List.cons.injEq] at h
    simp only [List.takeWhile_cons, h.1]
    split <;> simp [takeWhile_fst_len_E3 p l l' h.2]

theorem profileAux_entry_E3 (d : Nat) (x : Nat × Forest) (l l' : Column)
    (h : l.map Prod.fst = l'.map Prod.fst) (tl tl' : List Column) :
    profileAux d (.node ((x :: l) :: tl)) = profileAux d (.node ((x :: l') :: tl')) := by
  obtain ⟨p, ⟨hc⟩⟩ := x
  cases hc with
  | nil => simp only [profileAux]; rw [takeWhile_fst_len_E3 p l l' h]
  | cons c cs => simp only [profileAux]

/-- A filling changes the profile only through a chain. -/
theorem put_profile_E3 (Z : Forest) : ∀ (k : Nat) (G : Forest), RouteOK_D3 k G →
    profile (replaceAt 0 0 Z k G) = profile G ∨ Chain_E3 k G
  | 0, .node cols, hR => by
    have hc : cols ≠ [] := hR
    match cols, hc with
    | [c], _ => exact Or.inr rfl
    | c :: c' :: cs, _ =>
      left
      rw [put_zero_D3 Z (by simp)]
      simp only [List.dropLast_cons_cons, List.cons_append]
      show (profileAux 0 _ : WithBot (Nat ×ₗ Nat)) = profileAux 0 _
      rw [profileAux_col_E3, profileAux_col_E3 0 c (c' :: cs)]
  | k + 1, G, hR => by
    obtain ⟨cs, es, q, Y, rfl, hR'⟩ := hR
    rw [put_succ_D3]
    rcases cs with _ | ⟨c, cs⟩
    · rcases es with _ | ⟨x, es⟩
      · rcases put_profile_E3 Z k Y hR' with h | h
        · left
          have e1 : (Tree.node ([] ++ [[] ++ [(q, replaceAt 0 0 Z k Y)]]) : Forest) =
            .node [[(q, replaceAt 0 0 Z k Y)]] := rfl
          have e2 : (Tree.node ([] ++ [[] ++ [(q, Y)]]) : Forest) = .node [[(q, Y)]] := rfl
          rw [e1, e2, profile_single_E3, profile_single_E3, h]
        · exact Or.inr ⟨q, Y, rfl, h⟩
      · left
        show (profileAux 0 _ : WithBot (Nat ×ₗ Nat)) = profileAux 0 _
        simp only [List.nil_append, List.cons_append]
        exact congrArg _ (profileAux_entry_E3 0 x _ _ (by simp) _ _)
    · left
      show (profileAux 0 _ : WithBot (Nat ×ₗ Nat)) = profileAux 0 _
      simp only [List.cons_append]
      rw [profileAux_col_E3, profileAux_col_E3 0 c (cs ++ [es ++ [(q, Y)]])]

/-- The bottom of a chain: a head `P ⌢ V` against the stopping column `P ⌢ [(s, ∅)]`. -/
theorem bot_E3 {P V : Column} {rest : List Column} {s : Nat} (hP : P ≠ []) (hPs : ∀ x ∈ P, s ≤ x.1)
    (hV : ∀ v ∈ V.head?, v.1 < s) (hN : spxNoninc (P ++ [(s, Tree.empty)])) :
    profile (.node ((P ++ V) :: rest)) = profile (.node [P ++ [(s, Tree.empty)]]) ∨
      ((∀ x ∈ P, x = (s, Tree.empty)) ∧
        profile (.node ((P ++ V) :: rest)) = ((toLex (0, P.length) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) ∧
        profile (.node [P ++ [(s, Tree.empty)]]) =
          ((toLex (0, P.length + 1) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat))) := by
  obtain ⟨⟨q0, h0⟩, P', rfl⟩ := List.exists_cons_of_ne_nil hP
  have hq0 : s ≤ q0 := hPs (q0, h0) (by simp)
  have hVt : V.takeWhile (fun x => x.1 == q0) = [] := by
    cases V with
    | nil => rfl
    | cons v vs =>
      have : v.1 < s := hV v (by simp)
      simp [show v.1 ≠ q0 by omega]
  obtain ⟨hc⟩ := h0
  cases hc with
  | cons c cs =>
    left
    show (profileAux 0 _ : WithBot (Nat ×ₗ Nat)) = profileAux 0 _
    simp only [List.cons_append, profileAux]
  | nil =>
    by_cases hall : ∀ x ∈ P', (x.1 == q0) = true
    · by_cases hs : s = q0
      · subst hs
        right
        have hrun := spx_run_empty s (P' ++ [(s, Tree.empty)])
          (show spxNoninc ((s, Tree.empty) :: (P' ++ [(s, Tree.empty)])) from hN)
        rw [List.takeWhile_append_of_pos hall] at hrun
        refine ⟨?_, ?_, ?_⟩
        · intro x hx
          simp only [List.mem_cons] at hx
          rcases hx with rfl | hx
          · rfl
          · exact hrun x (List.mem_append_left _ hx)
        · show (profileAux 0 _ : WithBot (Nat ×ₗ Nat)) = _
          simp only [List.cons_append, profileAux, List.takeWhile_append_of_pos hall, hVt]
          simp; omega
        · show (profileAux 0 _ : WithBot (Nat ×ₗ Nat)) = _
          simp only [List.cons_append, profileAux, List.takeWhile_append_of_pos hall]
          simp; omega
      · left
        show (profileAux 0 _ : WithBot (Nat ×ₗ Nat)) = profileAux 0 _
        simp only [List.cons_append, profileAux, List.takeWhile_append_of_pos hall, hVt]
        simp [show s ≠ q0 from hs]
    · left
      show (profileAux 0 _ : WithBot (Nat ×ₗ Nat)) = profileAux 0 _
      simp only [List.cons_append, profileAux]
      have hlen : (P'.takeWhile (fun x => x.1 == q0)).length ≠ P'.length := by
        intro h
        apply hall
        have heq := (List.takeWhile_prefix (l := P') (fun x => x.1 == q0)).eq_of_length h
        have := List.all_takeWhile (l := P') (p := fun x => x.1 == q0)
        rw [heq, List.all_eq_true] at this
        exact this
      rw [List.takeWhile_append, List.takeWhile_append, if_neg hlen, if_neg hlen]

theorem noninc_ge_E3 {col : Column} (h : spxNoninc col) :
    ∀ (k i : Nat) (x y : Nat × Forest), col[i]? = some x → col[i + k]? = some y → y.1 ≤ x.1
  | 0, i, x, y, hx, hy => by rw [Nat.add_zero, hx] at hy; cases hy; exact le_rfl
  | k + 1, i, x, y, hx, hy => by
    obtain ⟨z, hz⟩ : ∃ z, col[i + 1]? = some z := by
      have := (List.getElem?_eq_some_iff.1 hy).1
      exact ⟨_, List.getElem?_eq_getElem (by omega)⟩
    have h1 := noninc_ge_E3 h k (i + 1) z y hz (by rw [show i + 1 + k = i + (k + 1) by omega]; exact hy)
    have h2 := h i x z hx hz
    rcases h2 with h2 | ⟨h2, -⟩ <;> omega

theorem noninc_shift_E3 {col : Column} (h : spxNoninc col) (r d : Nat) :
    spxNoninc (Tree.mapCol (shiftVal r d) col) := by
  intro i x y hx hy
  rw [treeMapCol_eq_map, List.getElem?_map] at hx hy
  obtain ⟨x0, hx0, rfl⟩ := Option.map_eq_some_iff.1 hx
  obtain ⟨y0, hy0, rfl⟩ := Option.map_eq_some_iff.1 hy
  exact entryLe_shift_D3 r d (h i x0 y0 hx0 hy0)

/-- Under I, a query-free stop at positive depth has at least two columns (otherwise the step is
special). -/
theorem fq_E3 {A : Forest} {sd : StopData} (hL : InL A) (hk : stepKind A = some .ordinary)
    (hsd : stopData A = some sd) (hpos : 0 < sd.depth) (hc0 : sd.col.col = 0) : sd.Q ≠ [] := by
  intro hQ
  obtain ⟨oe, col, p, -, hoe, hcol, -, hlast, hidx, hnum⟩ := ownerEntry_data hsd hpos
  obtain ⟨-, -, -, h4, -⟩ := stopData_core hsd
  have hent : A.entryAt oe = some (p, skipLayers A sd.depth) := by
    simp only [Tree.entryAt, hcol, Option.bind_some]
    rw [List.getLast?_eq_getElem?, show col.length - 1 = oe.idx by omega] at hlast
    exact hlast
  have hne : skipLayers A sd.depth ≠ Tree.empty := by
    intro h; rw [h] at h4; simp [Tree.empty, Tree.cols] at h4
  have hmem : sd.Q ++ [(sd.r, Tree.empty)] ∈ (skipLayers A sd.depth).cols := List.mem_of_getLast? h4
  obtain ⟨q, H, rest, hc, hle⟩ := hL.2.1 oe ((Tree.mem_entryAddrs_iff A oe).2 (by rw [hent]; rfl))
    p _ hent hne _ hmem
  rw [hQ, List.nil_append] at hc
  simp only [List.cons.injEq, Prod.mk.injEq] at hc
  obtain ⟨-, -, -, -, hrt, -⟩ := rootData_spec hsd (Option.isSome_iff_exists.1 (rootData_of_ordinary hk)).choose_spec
  have hsp : specialStop sd = true := by
    simp only [specialStop, Bool.and_eq_true, decide_eq_true_eq, List.isEmpty_iff, beq_iff_eq]
    refine ⟨⟨hpos, hQ⟩, ?_⟩
    omega
  have := (stepKind_special_iff A).2 ⟨sd, hsd, hsp⟩
  rw [hk] at this; cases this

/-- A continuation never raises the profile. -/
theorem cot_E3 {A : Forest} {sd : StopData} {rd : RootData} {n : Nat} (hL : InL A)
    (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd) (hrd : rootData A = some rd)
    {e : EntryAddr} {x : Nat × Forest} (hx : A.entryAt e = some x) (hon : e.heightPath <+: sd.col.path)
    {ψ : Nat} (hψ : ψ ≤ n) :
    profile (replaceAt sd.r (ψ * period sd) (zs_E3 A sd rd n ψ) (sd.depth - e.col.path.length - 1) x.2)
      ≤ profile x.2 := by
  obtain ⟨hl, -, -, -, hR, -, hrc, -, hhc, -⟩ := onR_pack_E3 hsd hx hon
  obtain ⟨-, hhcA⟩ := stop_rpath_E3 hsd
  obtain ⟨hcolsd, -⟩ := stopData_spec hsd
  have hNs := spx_condH_col hL.2.2.1 hcolsd
  have hRG := (routeOK_shift_D3 sd.r (ψ * period sd) _ _).2 hR
  rw [replaceAt_eq_shift]
  rcases put_profile_E3 (zs_E3 A sd rd n ψ) _ _ hRG with h | hch
  · rw [h, profile_shift_E3]
  · rw [chain_put_E3 _ _ _ hch, ← profile_shift_E3 sd.r (ψ * period sd) x.2, chain_self_E3 hch]
    apply sig_iter_mono_E3
    rw [routeCol_shift_D3, hrc, Tree.treeMapCol_append_D3]
    have hcm : Tree.mapCol (shiftVal sd.r (ψ * period sd)) [(sd.r, Tree.empty)] =
        [(sd.r + ψ * period sd, Tree.empty)] := by
      simp [Tree.mapCol, shiftVal]; rfl
    rw [hcm]
    by_cases hψn : ψ < n
    · rw [zs_step_E3 A sd rd hψn]
      obtain ⟨V, rest, hsh, hV⟩ := ordStep_shape_E3 hL hsd hrd ψ (zs_E3 A sd rd n (ψ + 1))
      rw [hsh]
      have hQ : sd.Q ≠ [] := by
        apply fq_E3 hL hk hsd (by omega)
        have h0 := chain_skip_E3 _ _ hch _ le_rfl
        simp only [Nat.sub_self, Chain_E3] at h0
        have : hcol_E3 (sd.depth - e.col.path.length - 1) (shift sd.r (ψ * period sd) x.2) = 0 := by
          simp only [hcol_E3]; omega
        rw [shift, hcol_map_E3, ← hhc, hhcA] at this; exact this
      have hPs : ∀ y ∈ Tree.mapCol (shiftVal sd.r (ψ * period sd)) sd.Q, sd.r + ψ * period sd ≤ y.1 := by
        intro y hy
        rw [treeMapCol_eq_map] at hy
        obtain ⟨y0, hy0, rfl⟩ := List.mem_map.1 hy
        obtain ⟨i, hi⟩ := List.getElem?_of_mem hy0
        have := noninc_ge_E3 hNs (sd.Q.length - i) i y0 (sd.r, Tree.empty)
          (by rw [List.getElem?_append_left (List.getElem?_eq_some_iff.1 hi).1]; exact hi)
          (by rw [show i + (sd.Q.length - i) = sd.Q.length by
                have := (List.getElem?_eq_some_iff.1 hi).1; omega]; simp)
        simp only [shiftVal, if_pos this]; omega
      have hN := noninc_shift_E3 hNs sd.r (ψ * period sd)
      rw [Tree.treeMapCol_append_D3, hcm] at hN
      rcases bot_E3 (by simpa [treeMapCol_eq_map] using hQ) hPs
        (fun v hv => lt_of_lt_of_le (hV v hv) (by omega)) hN with h | ⟨-, h1, h2⟩
      · exact le_of_eq h
      · rw [h1, h2, WithBot.coe_le_coe, Prod.Lex.le_iff]; right; simp
    · rw [show ψ = n by omega, zs_top_E3]
      exact bot_le

/-- Every return to the host `a'` in `H'` has a smaller profile. -/
def ProfHost_E3 (a' : Nat) (H' : Forest) : Prop :=
  ∀ ρ J', H'.entryAt ρ = some (a', J') → profile J' < profile H'

theorem condP_pair_E3 {A : Forest} (hP : CondP A) {e0 e : EntryAddr} {x0 x : Nat × Forest}
    (hx0 : A.entryAt e0 = some x0) (hx : A.entryAt e = some x) (hret : IsOwnerReturn A e0 e) :
    profile x.2 < profile x0.2 := by
  have := hP e0 ((Tree.mem_entryAddrs_iff A e0).2 (by rw [hx0]; rfl)) e
    ((Tree.mem_entryAddrs_iff A e).2 (by rw [hx]; rfl)) hret
  simpa [Tree.heightAt, hx0, hx] using this

theorem hostSP_E3 {A : Forest} (sd : StopData) (hP : CondP A) {e0 : EntryAddr} {x0 : Nat × Forest}
    (hx0 : A.entryAt e0 = some x0) (ψ : Nat) (hψ : ψ = 0 ∨ sd.r ≤ e0.col.num 0) :
    ProfHost_E3 (e0.col.num 0 + ψ * period sd) (shift sd.r (ψ * period sd) x0.2) := by
  intro ρ J' hρ
  rw [shift, entryAt_map_D3] at hρ
  obtain ⟨x, hx, hxe⟩ := Option.map_eq_some_iff.1 hρ
  simp only [Prod.mk.injEq] at hxe
  obtain ⟨hp, rfl⟩ := hxe
  have hδ : ψ * period sd = 0 ∨ sd.r ≤ e0.col.num 0 := by
    rcases hψ with h | h
    · left; rw [h, Nat.zero_mul]
    · exact Or.inr h
  have hp' : x.1 = e0.col.num 0 := shiftVal_host_E3 hδ hp
  have hx' : x0.2.entryAt ρ = some (e0.col.num 0, x.2) := by rw [hx, ← hp']
  obtain ⟨h1, h2⟩ := under_return_E3 hx0 hx'
  have := condP_pair_E3 hP hx0 h1 h2
  rw [← shift, profile_shift_E3, profile_shift_E3]; exact this

/-- The bottom of a filled chain at phase `ψ < n`: the profile is unchanged, or the query is a run
of `(r, ∅)` entries and the run loses its closing entry. -/
theorem bottom_dich_E3 {A : Forest} {sd : StopData} {rd : RootData} {n : Nat} (hL : InL A)
    (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd) (hrd : rootData A = some rd)
    {e : EntryAddr} {x : Nat × Forest} (hx : A.entryAt e = some x) (hon : e.heightPath <+: sd.col.path)
    {ψ : Nat} (hψ : ψ < n)
    (hch : Chain_E3 (sd.depth - e.col.path.length - 1) (shift sd.r (ψ * period sd) x.2)) :
    profile (replaceAt 0 0 (zs_E3 A sd rd n ψ) (sd.depth - e.col.path.length - 1)
      (shift sd.r (ψ * period sd) x.2)) = profile x.2 ∨
    ((∀ y ∈ sd.Q, y = (sd.r, Tree.empty)) ∧ 1 ≤ sd.Q.length ∧
      profile (replaceAt 0 0 (zs_E3 A sd rd n ψ) (sd.depth - e.col.path.length - 1)
        (shift sd.r (ψ * period sd) x.2)) =
        ((toLex (sd.depth - e.col.path.length - 1, sd.Q.length) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat))) := by
  obtain ⟨hl, -, -, -, hR, -, hrc, -, hhc, -⟩ := onR_pack_E3 hsd hx hon
  obtain ⟨-, hhcA⟩ := stop_rpath_E3 hsd
  obtain ⟨hcolsd, -⟩ := stopData_spec hsd
  have hNs := spx_condH_col hL.2.2.1 hcolsd
  rw [chain_put_E3 _ _ _ hch, ← profile_shift_E3 sd.r (ψ * period sd) x.2, chain_self_E3 hch,
    routeCol_shift_D3, hrc, Tree.treeMapCol_append_D3]
  have hcm : Tree.mapCol (shiftVal sd.r (ψ * period sd)) [(sd.r, Tree.empty)] =
      [(sd.r + ψ * period sd, Tree.empty)] := by
    simp [Tree.mapCol, shiftVal]; rfl
  rw [hcm, zs_step_E3 A sd rd hψ]
  obtain ⟨V, rest, hsh, hV⟩ := ordStep_shape_E3 hL hsd hrd ψ (zs_E3 A sd rd n (ψ + 1))
  rw [hsh]
  have hQ : sd.Q ≠ [] := by
    apply fq_E3 hL hk hsd (by omega)
    have h0 := chain_skip_E3 _ _ hch _ le_rfl
    simp only [Nat.sub_self, Chain_E3] at h0
    have : hcol_E3 (sd.depth - e.col.path.length - 1) (shift sd.r (ψ * period sd) x.2) = 0 := by
      simp only [hcol_E3]; omega
    rw [shift, hcol_map_E3, ← hhc, hhcA] at this; exact this
  have hPs : ∀ y ∈ Tree.mapCol (shiftVal sd.r (ψ * period sd)) sd.Q, sd.r + ψ * period sd ≤ y.1 := by
    intro y hy
    rw [treeMapCol_eq_map] at hy
    obtain ⟨y0, hy0, rfl⟩ := List.mem_map.1 hy
    obtain ⟨i, hi⟩ := List.getElem?_of_mem hy0
    have := noninc_ge_E3 hNs (sd.Q.length - i) i y0 (sd.r, Tree.empty)
      (by rw [List.getElem?_append_left (List.getElem?_eq_some_iff.1 hi).1]; exact hi)
      (by rw [show i + (sd.Q.length - i) = sd.Q.length by
            have := (List.getElem?_eq_some_iff.1 hi).1; omega]; simp)
    simp only [shiftVal, if_pos this]; omega
  have hN := noninc_shift_E3 hNs sd.r (ψ * period sd)
  rw [Tree.treeMapCol_append_D3, hcm] at hN
  rcases bot_E3 (by simpa [treeMapCol_eq_map] using hQ) hPs
    (fun v hv => lt_of_lt_of_le (hV v hv) (by omega)) hN with h | ⟨hall, h1, -⟩
  · left; rw [h]
  · right
    refine ⟨?_, List.length_pos_iff.2 hQ, ?_⟩
    · intro y hy
      have := hall _ (by rw [treeMapCol_eq_map]; exact List.mem_map_of_mem hy)
      simp only [Prod.mk.injEq] at this
      obtain ⟨h1, h2⟩ := this
      have hy1 : y.1 = sd.r := by unfold shiftVal at h1; split_ifs at h1 <;> omega
      have hy2 : y.2 = Tree.empty := by
        match hY : y.2 with
        | .node [] => rfl
        | .node (c :: cs) => rw [hY] at h2; simp [Tree.map, Tree.mapCols, Tree.empty] at h2
      exact Prod.ext hy1 hy2
    · rw [h1, sig_iter_coe_E3, treeMapCol_eq_map, List.length_map]; simp

/-- Route containers of phase `k`: P for their returns. The profile is unchanged (then the old
returns bound the new ones), or the host is a filled chain: then its route containers are smaller
by the chain, and (`k < n`) the query is a run of `(r, ∅)` whose copies have empty heights, while
the low returns are copies of chain levels strictly below the host. -/
theorem hostCP_E3 {A : Forest} {sd : StopData} {rd : RootData} {n : Nat} (hL : InL A) (hP : CondP A)
    (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd) (hrd : rootData A = some rd)
    {e0 : EntryAddr} {x0 : Nat × Forest} (hx0 : A.entryAt e0 = some x0)
    (hon : e0.heightPath <+: sd.col.path) {k : Nat} (hkn : k ≤ n)
    (hkk : k = 0 ∨ sd.r ≤ e0.col.num 0) :
    ProfHost_E3 (e0.col.num 0 + k * period sd)
      (replaceAt sd.r (k * period sd) (zs_E3 A sd rd n k) (sd.depth - e0.col.path.length - 1) x0.2) := by
  have hE : E1_E3 A sd rd n k (zs_E3 A sd rd n k) := by
    have := zs_E1_E3 (n := n) hL hsd hrd (n - k) (by omega)
    rwa [show n - (n - k) = k by omega] at this
  have hd := period_pos_E3 hsd hrd
  obtain ⟨hl, hhp, hxH, hnum, hR, hN, hrc, hrp, hhc, hat⟩ := onR_pack_E3 hsd hx0 hon
  obtain ⟨hrpA, hhcA⟩ := stop_rpath_E3 hsd
  have hδ : k * period sd = 0 ∨ sd.r ≤ e0.col.num 0 := by
    rcases hkk with h | h
    · left; rw [h, Nat.zero_mul]
    · exact Or.inr h
  have hRG := (routeOK_shift_D3 sd.r (k * period sd) _ _).2 hR
  -- the host's profile: unchanged, or a filled chain
  have hdich : profile (replaceAt 0 0 (zs_E3 A sd rd n k) (sd.depth - e0.col.path.length - 1) (shift sd.r (k * period sd) x0.2)) = profile x0.2 ∨
      (Chain_E3 (sd.depth - e0.col.path.length - 1) x0.2 ∧ Chain_E3 (sd.depth - e0.col.path.length - 1) (shift sd.r (k * period sd) x0.2) ∧ (k = n ∨ (k < n ∧ (∀ y ∈ sd.Q, y = (sd.r, Tree.empty)) ∧
        1 ≤ sd.Q.length ∧ profile (replaceAt 0 0 (zs_E3 A sd rd n k) (sd.depth - e0.col.path.length - 1) (shift sd.r (k * period sd) x0.2)) =
          ((toLex (sd.depth - e0.col.path.length - 1, sd.Q.length) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat))))) := by
    rcases put_profile_E3 (zs_E3 A sd rd n k) _ _ hRG with h | hch
    · left; rw [h, profile_shift_E3]
    · have hch0 : Chain_E3 (sd.depth - e0.col.path.length - 1) x0.2 := (chain_map_E3 _ _ _).1 hch
      by_cases hkn' : k < n
      · rcases bottom_dich_E3 hL hk hsd hrd hx0 hon hkn' hch with h | h
        · exact Or.inl h
        · exact Or.inr ⟨hch0, hch, Or.inr ⟨hkn', h⟩⟩
      · exact Or.inr ⟨hch0, hch, Or.inl (by omega)⟩
  intro ρ J' hρ
  rw [replaceAt_eq_shift] at hρ ⊢
  have hPu := put_entryAt_E3 (zs_E3 A sd rd n k) _ _ hRG ρ
  -- a return whose profile is bounded by an old return of `e0`
  have hbound : ∀ e x, A.entryAt e = some x → IsOwnerReturn A e0 e → profile J' ≤ profile x.2 →
      profile (replaceAt 0 0 (zs_E3 A sd rd n k) (sd.depth - e0.col.path.length - 1) (shift sd.r (k * period sd) x0.2)) = profile x0.2 → profile J' < profile (replaceAt 0 0 (zs_E3 A sd rd n k) (sd.depth - e0.col.path.length - 1) (shift sd.r (k * period sd) x0.2)) := by
    intro e x hx hret hle heq
    rw [heq]; exact lt_of_le_of_lt hle (condP_pair_E3 hP hx0 hx hret)
  have hnochain : ∀ ρ' x', Chain_E3 (sd.depth - e0.col.path.length - 1) x0.2 → x0.2.entryAt ρ' = some x' →
      ¬ InHole_E3 (sd.depth - e0.col.path.length - 1) x0.2 ρ'.col → ¬ IsRoute_E3 (sd.depth - e0.col.path.length - 1) x0.2 ρ' → False := by
    intro ρ' x' hch hx' h1 h2
    rcases chain_entries_E3 _ x0.2 hch ρ' x' hx' with h | h
    · exact h2 h
    · exact h1 h
  by_cases hh : InHole_E3 (sd.depth - e0.col.path.length - 1) (shift sd.r (k * period sd) x0.2) ρ.col
  · obtain ⟨h1, h2⟩ := hPu.1 hh
    rw [h1] at hρ
    obtain ⟨e, ψ, hψ1, hψ2, hψq, ⟨htr, htn, htl⟩, x, hxA, hx1, hc', hx2⟩ := hE _ _ hρ
    have hkn' : k < n := by
      by_contra hc
      rw [show k = n by omega, zs_top_E3, Tree.empty, empty_entryAt_E3] at hρ
      cases hρ
    simp only at hx1
    have hcase : x.1 = e0.col.num 0 ∧ ((k = 0 ∧ e0.col.num 0 < sd.r) ∨ (ψ = k ∧ InQ_E3 sd e)) := by
      unfold shiftVal at hx1
      split_ifs at hx1 with hxr
      · by_cases hψk : ψ = k
        · subst hψk; exact ⟨by omega, Or.inr ⟨rfl, hψq rfl⟩⟩
        · exfalso
          have : (k + 1) * period sd ≤ ψ * period sd := Nat.mul_le_mul_right _ (by omega)
          have : sd.t = sd.r + period sd := by simp only [period]; omega
          rw [Nat.succ_mul] at *
          omega
      · have hk0 : k = 0 := by
          rcases hkk with h | h
          · exact h
          · exfalso; omega
        subst hk0
        exact ⟨by omega, Or.inl ⟨rfl, by omega⟩⟩
    obtain ⟨hxa, hcase⟩ := hcase
    have hcon : e0.Contains e.col := by
      rcases hcase with ⟨-, hlow⟩ | ⟨-, hq⟩
      · exact (low_route_E3 hL.1 hsd hrd hx0 hon hlow).trans htr
      · rcases hq with ⟨h1, -⟩ | ⟨i, -, hi⟩
        · show e0.heightPath <+: e.col.path; rw [h1]; exact hon
        · exact hon.trans ((List.prefix_append _ _).trans hi)
    have hret : IsOwnerReturn A e0 e := by
      have : A.entryAt ⟨e.col, e.idx⟩ = some (e0.col.num 0, x.2) := by rw [← hxa]; exact hxA
      exact isOwnerReturn_of_parent hcon this
    have hle : profile J' ≤ profile x.2 := by
      rcases hx2 with ⟨-, hJ'⟩ | ⟨hon', hJ'⟩
      · simp only at hJ'; rw [hJ', profile_shift_E3]
      · simp only at hJ'; rw [hJ']; exact cot_E3 hL hk hsd hrd hxA hon' hψ2
    rcases hdich with heq | ⟨hch0, hch, hkn2 | ⟨-, hQr, hQ1, hprof⟩⟩
    · exact hbound e x hxA hret hle heq
    · omega
    · rw [hprof]
      obtain ⟨P, hP'⟩ := hcon
      have hρe : x0.2.entryAt ⟨⟨P, e.col.col⟩, e.idx⟩ = some x := by
        rw [← under_entryAt_E3 hx0]
        have : under_E3 e0 ⟨⟨P, e.col.col⟩, e.idx⟩ = e := by simp only [under_E3, hP']
        rw [this, hxA]
      by_cases hone : e.heightPath <+: sd.col.path
      · -- a chain level strictly below the host
        obtain ⟨hle', -, hxe, -, -, -, hrce, -⟩ := onR_pack_E3 hsd hxA hone
        have hlen : e.col.path.length = e0.col.path.length + 1 + P.length := by
          rw [← hP']; simp [EntryAddr.heightPath]; omega
        have hj : x.2 = skipLayers x0.2 (P.length + 1) := by
          rw [hxe, hxH, skipLayers_add, hlen, show e0.col.path.length + 1 + (P.length + 1) =
            e0.col.path.length + 1 + P.length + 1 by omega]
        have hchx := chain_skip_E3 _ _ hch0 (P.length + 1) (by omega)
        rw [← hj] at hchx
        have hself := chain_self_E3 hchx
        rw [show sd.depth - e0.col.path.length - 1 - (P.length + 1) = sd.depth - e.col.path.length - 1 by
          omega, hrce] at hself
        have hrep : sd.Q ++ [(sd.r, Tree.empty)] = List.replicate (sd.Q.length + 1) (sd.r, Tree.empty) := by
          have hQe : sd.Q = List.replicate sd.Q.length (sd.r, Tree.empty) := List.eq_replicate_iff.2 ⟨rfl, hQr⟩
          rw [List.replicate_succ', ← hQe]
        have htow : profile (Tree.node [sd.Q ++ [(sd.r, Tree.empty)]]) =
            ((toLex (0, sd.Q.length + 1) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by
          rw [hrep]
          have := spx_profile_tower [] sd.r sd.Q.length
          simpa [spxTower] using this
        rw [htow, sig_iter_coe_E3] at hself
        refine lt_of_le_of_lt hle ?_
        rw [hself, WithBot.coe_lt_coe, Prod.Lex.lt_iff]
        left; simp only [ofLex_toLex]; omega
      · -- the query region: empty heights
        have hq : InQ_E3 sd e := by
          rcases htl with h | h
          · exact h
          · exfalso
            refine hnochain _ x hch0 hρe ?_ ?_
            · intro hh'
              apply h
              have := (inHole_abs_E3 hrp hhc ⟨P, e.col.col⟩).2 hh'
              simpa [hP'] using this
            · intro hr'
              apply hone
              have := (isRoute_abs_E3 hrp ⟨⟨P, e.col.col⟩, e.idx⟩).2 hr'
              rw [IsRoute_E3, hrpA] at this
              show e.col.path ++ _ <+: _
              rw [← hP']
              simpa [EntryAddr.heightPath] using this
        have hx2e : x.2 = Tree.empty := by
          obtain ⟨hcolsd, -⟩ := stopData_spec hsd
          rcases hq with ⟨h1, h2⟩ | ⟨i, hi, hc⟩
          · have : A.entryAt ⟨sd.col, e.idx⟩ = sd.Q[e.idx]? := by
              simp only [Tree.entryAt, hcolsd, Option.bind_some]; rw [List.getElem?_append_left h2]
            have he : e = ⟨sd.col, e.idx⟩ := by rw [← h1]
            rw [← he, hxA] at this
            have := hQr x (List.mem_of_getElem? this.symm)
            rw [this]
          · exfalso
            have hqi : A.entryAt ⟨sd.col, i⟩ = some (sd.r, Tree.empty) := by
              simp only [Tree.entryAt, hcolsd, Option.bind_some]; rw [List.getElem?_append_left hi]
              exact hQr _ (List.getElem_mem hi) ▸ List.getElem?_eq_getElem hi
            have := N_inside_E3 hqi hc hxA
            simp [N_E3, gwordAt_empty_E3] at this
        rcases hx2 with ⟨-, hJ'⟩ | ⟨hon', -⟩
        · simp only at hJ'
          rw [hJ', hx2e]
          exact WithBot.bot_lt_coe _
        · exact absurd hon' hone
  · by_cases hr : IsRoute_E3 (sd.depth - e0.col.path.length - 1) (shift sd.r (k * period sd) x0.2) ρ
    · rw [hPu.2.1 hh hr] at hρ
      obtain ⟨y, hy, hye⟩ := Option.map_eq_some_iff.1 hρ
      simp only [Prod.mk.injEq] at hye
      obtain ⟨hp, hJ'⟩ := hye
      rcases hdich with heq | ⟨-, hch, -⟩
      · rw [shift, entryAt_map_D3] at hy
        obtain ⟨x, hx, rfl⟩ := Option.map_eq_some_iff.1 hy
        have hxa : x.1 = e0.col.num 0 := shiftVal_host_E3 hδ hp
        have hx' : x0.2.entryAt ρ = some (e0.col.num 0, x.2) := by rw [hx, ← hxa]
        obtain ⟨h1, h2⟩ := under_return_E3 hx0 hx'
        have hon' : (under_E3 e0 ρ).heightPath <+: sd.col.path := by
          have := (isRoute_abs_E3 hrp ρ).2 ((isRoute_map_E3 _ _ _ _).1 hr)
          rwa [IsRoute_E3, hrpA] at this
        have hlen : (under_E3 e0 ρ).col.path.length = e0.col.path.length + 1 + ρ.col.path.length := by
          simp [under_E3, EntryAddr.heightPath]; omega
        refine hbound _ _ h1 h2 ?_ heq
        rw [← hJ']
        have := cot_E3 (n := n) hL hk hsd hrd h1 hon' hkn
        rw [replaceAt_eq_shift, hlen] at this
        convert this using 3 <;> first | omega | rfl
      · rw [← hJ']; exact chain_route_E3 _ _ _ hch ρ y hr hy
    · rw [hPu.2.2 hh hr, shift, entryAt_map_D3] at hρ
      obtain ⟨x, hx, hxe⟩ := Option.map_eq_some_iff.1 hρ
      simp only [Prod.mk.injEq] at hxe
      obtain ⟨hp, hJ'⟩ := hxe
      rcases hdich with heq | ⟨hch0, -, -⟩
      · have hxa : x.1 = e0.col.num 0 := shiftVal_host_E3 hδ hp
        have hx' : x0.2.entryAt ρ = some (e0.col.num 0, x.2) := by rw [hx, ← hxa]
        obtain ⟨h1, h2⟩ := under_return_E3 hx0 hx'
        refine hbound _ _ h1 h2 ?_ heq
        rw [← hJ', ← shift, profile_shift_E3]
      · exact absurd (hnochain ρ x hch0 hx ((inHole_map_E3 _ _ _ _).not.1 hh)
          ((isRoute_map_E3 _ _ _ _).not.1 hr)) id

/-- Every host of an ordinary output satisfies P for its returns. -/
theorem hostsP_E3 {A : Forest} {sd : StopData} {rd : RootData} {n : Nat} (hL : InL A) (hP : CondP A)
    (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd) (hrd : rootData A = some rd)
    {e0' : EntryAddr} {y0 : Nat × Forest}
    (hy0 : (replaceAt 0 0 (zs_E3 A sd rd n 0) sd.depth A).entryAt e0' = some y0) :
    ProfHost_E3 (e0'.col.num 0) y0.2 := by
  obtain ⟨hrpA, hhcA⟩ := stop_rpath_E3 hsd
  obtain ⟨hRA, hNA⟩ := stop_route_top_D3 hsd
  have hPu := put_entryAt_E3 (zs_E3 A sd rd n 0) sd.depth A hRA e0'
  by_cases hh : InHole_E3 sd.depth A e0'.col
  · obtain ⟨h1, h2⟩ := hPu.1 hh
    rw [h1] at hy0
    have hE := zs_E1_E3 (n := n) hL hsd hrd n le_rfl
    rw [Nat.sub_self] at hE
    obtain ⟨e, ψ, -, hψ2, -, ⟨-, htn, -⟩, x, hxA, -, hc', hx2⟩ := hE _ _ hy0
    have hnum : e0'.col.num 0 = e.col.num 0 + ψ * period sd := by
      rw [h2 0, Nat.zero_add, hNA, ← hc', Nat.zero_mul, Nat.add_zero]
    rw [hnum]
    rcases hx2 with ⟨-, hJ⟩ | ⟨hon, hJ⟩
    · rw [hJ]; exact hostSP_E3 sd hP hxA ψ (Or.inr htn)
    · rw [hJ]; exact hostCP_E3 hL hP hk hsd hrd hxA hon hψ2 (Or.inr htn)
  · by_cases hr : IsRoute_E3 sd.depth A e0'
    · rw [hPu.2.1 hh hr] at hy0
      obtain ⟨x, hx, rfl⟩ := Option.map_eq_some_iff.1 hy0
      have hon : e0'.heightPath <+: sd.col.path := by rw [IsRoute_E3, hrpA] at hr; exact hr
      have := hostCP_E3 (n := n) hL hP hk hsd hrd hx hon (Nat.zero_le n) (Or.inl rfl)
      rw [Nat.zero_mul, Nat.add_zero, replaceAt_zero_E3] at this
      exact this
    · rw [hPu.2.2 hh hr] at hy0
      have := hostSP_E3 sd hP hy0 0 (Or.inl rfl)
      rw [Nat.zero_mul, Nat.add_zero, shift_zero] at this
      exact this

-- T3.2o (txt:367-376): P is preserved by ordinary steps
theorem condP_ord {A B : Forest} {n : Nat} (hL : InL A) (hP : CondP A)
    (hk : stepKind A = some .ordinary) (hB : expand A n = some B) : CondP B := by
  obtain ⟨sd, rd, hsd, hrd, hBeq, -⟩ := ord_output_D3 hL hk hB
  rw [ordZ_eq_zs_E3] at hBeq
  intro e0' he0 e' he hret
  obtain ⟨y0, hy0⟩ := Option.isSome_iff_exists.1 ((Tree.mem_entryAddrs_iff B e0').1 he0)
  obtain ⟨hcon, q, J', hJ, hres⟩ := hret
  have hq : q = e0'.col.num 0 := (ColAddr.resolve_num hres).symm
  subst hq
  obtain ⟨P, hP'⟩ := hcon
  have he' : e' = under_E3 e0' ⟨⟨P, e'.col.col⟩, e'.idx⟩ := by
    simp only [under_E3, hP']
  have hρ : y0.2.entryAt ⟨⟨P, e'.col.col⟩, e'.idx⟩ = some (e0'.col.num 0, J') := by
    rw [← under_entryAt_E3 hy0, ← he', hJ]
  have := hostsP_E3 (n := n) hL hP hk hsd hrd (by rw [← hBeq]; exact hy0) _ _ hρ
  have h3 : (B.heightAt e').getD Tree.empty = J' := by simp [Tree.heightAt, hJ]
  have h4 : (B.heightAt e0').getD Tree.empty = y0.2 := by simp [Tree.heightAt, hy0]
  rw [h3, h4]; exact this

-- T3.2q (txt:390-394, 524-530): read on the stack of a phase-`φ` copy `c` of `a`, a
-- `g_{κ_φ W}` path from a vertex `x ≥ s_φ` to an endpoint `y < r` is the copy of an old `g_W`
-- path from `x − φd` (from `r` when `x = s_φ`): low heads detour through the previous phase,
-- high heads return the old root response at `W` (all root keys are `κ`-fixed)
theorem head_path {A B : Forest} {sd : StopData} {rd : RootData} {n j : Nat} (hL : InL A)
    (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd) (hrd : rootData A = some rd)
    (hB : expand A n = some B) (hj : 1 ≤ j ∧ j ≤ n) {a c : ColAddr}
    (ha : IsTmplCol A sd rd a) (hc : phaseCol sd rd j a = some c)
    {W : List (WithTop Key)} (hW : W.Pairwise fun x y => y ≤ x) {x y : Nat} (hy : y < sd.r)
    (hx : sd.r + phaseOff sd j a * period sd ≤ x)
    (hpath : Path B (actualKeys B) c
      (W.map (WithTop.map (kappa sd.r (period sd) (phaseOff sd j a)))) x y) :
    Path A (actualKeys A) a W
      (if x = sd.r + phaseOff sd j a * period sd then sd.r else x - phaseOff sd j a * period sd) y := by
  sorry

-- T3.2q: the converse transfer, old path to new path (used by T3.2r).
-- VERIFY-U2 (F4): the new path is read in the decorated system of `B` (route last keys `⊤`).
-- With actual keys of `B` the statement is false: a continuation last key of a head is smaller
-- than the old root key and can be consumed (bounded test: 176 failures on own cut queries).
theorem head_path_rev {A B : Forest} {sd : StopData} {rd : RootData} {n j : Nat} (hL : InL A)
    (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd) (hrd : rootData A = some rd)
    (hB : expand A n = some B) (hj : 1 ≤ j ∧ j ≤ n) {a c : ColAddr}
    (ha : IsTmplCol A sd rd a) (hc : phaseCol sd rd j a = some c)
    {W : List (WithTop Key)} (hW : W.Pairwise fun x y => y ≤ x) {x0 y : Nat} (hy : y < sd.r)
    (hx0 : sd.r ≤ x0) (hpath : Path A (actualKeys A) a W x0 y) :
    Path B (capKeys B (routeCols B)) c
      (W.map (WithTop.map (kappa sd.r (period sd) (phaseOff sd j a))))
      (if x0 = sd.r then sd.r + phaseOff sd j a * period sd else x0 + phaseOff sd j a * period sd) y := by
  sorry

/-! ### T3.2r helpers (branch G3): the phase-copy machinery of G-009 and G-010, restated

The G-009/G-010 lemmas (`phase_stack_F7`, `respEdge_phase_D7`, `respEdge_head_high_D7`,
`head_low_detour_F7`, `respEdge_root_low_F7`, …) are stated over `S : OrdStep`, which also carries
`IsStd A`, `CondP A`, `Cof A`, and they sit after `inL_expand`. Their proofs use none of the extra
fields, so they are restated here over `OrdData_G3` (the same data without those fields), with the
suffix `_G3` and the original proofs. -/

/-- (G3) The setting of an ordinary step `B = A[n]`, `n ≥ 1` (`OrdStep` without `std`, `condP`,
`cof`). -/
structure OrdData_G3 where
  A : Forest
  sd : StopData
  rd : RootData
  n : Nat
  B : Forest
  inL : InL A
  kind : stepKind A = some .ordinary
  hsd : stopData A = some sd
  hrd : rootData A = some rd
  pos : 1 ≤ n
  out : expand A n = some B

namespace OrdData_G3

variable (S : OrdData_G3)

/-- The period `d`. -/
def d : Nat := period S.sd
/-- `s_i = r + i d`, the number of the head of layer `i`. -/
def s (i : Nat) : Nat := S.sd.r + i * S.d
/-- `m = |Q|`. -/
def m : Nat := S.sd.Q.length
/-- The old terminal's complete query `Z = ν(y_0,…,y_{m−1})`. -/
def termZ : List (WithTop Key) := cutQuery (actualKeys S.A S.sd.col) S.m
/-- The address in `B` of the head `s_h` of layer `h ≥ 1`. -/
def headCol (h : Nat) : ColAddr := (phaseCol S.sd S.rd h S.rd.col).getD S.rd.col
/-- The phase-`h` copy in `B` of a column `o` of `A`. -/
def copyCol (h : Nat) (o : ColAddr) : ColAddr :=
  if h = 0 then o else (phaseCol S.sd S.rd h o).getD o

end OrdData_G3

theorem OrdData_G3.kernelDefined (S : OrdData_G3) : KernelDefined S.A S.rd := by
  have hE : S.A ≠ Tree.empty := by
    intro h
    have := S.hsd
    rw [h, stopData_eq_none_of_lastCol (Or.inl rfl)] at this
    cases this
  by_contra hk
  have := (expand_none_iff hE S.inL.1 S.inL.2.1 S.kind S.hsd S.hrd S.n).mpr ⟨S.pos, hk⟩
  rw [S.out] at this
  cases this

section D7Trees_G3

variable {α β γ : Type}

mutual
-- T3.8lm (D7, helper): relabelling twice is relabelling by the composite
theorem map_map_D7_G3 (f : α → β) (g : β → γ) (t : Tree α) :
    Tree.map g (Tree.map f t) = Tree.map (g ∘ f) t :=
  match t with
  | .node a => by rw [Tree.map, Tree.map, Tree.map, mapCols_map_D7_G3]

theorem mapCols_map_D7_G3 (f : α → β) (g : β → γ) (a : List (List (α × Tree α))) :
    Tree.mapCols g (Tree.mapCols f a) = Tree.mapCols (g ∘ f) a :=
  match a with
  | [] => rfl
  | x :: xs => by rw [Tree.mapCols, Tree.mapCols, Tree.mapCols, mapCol_map_D7_G3, mapCols_map_D7_G3]

theorem mapCol_map_D7_G3 (f : α → β) (g : β → γ) (a : List (α × Tree α)) :
    Tree.mapCol g (Tree.mapCol f a) = Tree.mapCol (g ∘ f) a :=
  match a with
  | [] => rfl
  | (p, h) :: es => by
    rw [Tree.mapCol, Tree.mapCol, Tree.mapCol, map_map_D7_G3, mapCol_map_D7_G3]; rfl
end

mutual
-- T3.8lm (D7, helper): two relabelled comparisons agree when they agree labelwise
theorem cmp_map2_D7_G3 {δ : Type} {c : δ → δ → Ordering} {f₁ g₁ : α → δ} {f₂ g₂ : β → δ}
    (hf : ∀ x y, c (f₁ x) (f₂ y) = c (g₁ x) (g₂ y)) (s : Tree α) (t : Tree β) :
    Tree.cmp c (Tree.map f₁ s) (Tree.map f₂ t) = Tree.cmp c (Tree.map g₁ s) (Tree.map g₂ t) :=
  match s, t with
  | .node a, .node b => by
    rw [Tree.map, Tree.map, Tree.map, Tree.map, Tree.cmp, Tree.cmp]
    exact cmpCols_map2_D7_G3 hf a b

theorem cmpCols_map2_D7_G3 {δ : Type} {c : δ → δ → Ordering} {f₁ g₁ : α → δ} {f₂ g₂ : β → δ}
    (hf : ∀ x y, c (f₁ x) (f₂ y) = c (g₁ x) (g₂ y)) (a : List (List (α × Tree α)))
    (b : List (List (β × Tree β))) :
    Tree.cmpCols c (Tree.mapCols f₁ a) (Tree.mapCols f₂ b) =
      Tree.cmpCols c (Tree.mapCols g₁ a) (Tree.mapCols g₂ b) :=
  match a, b with
  | [], [] => rfl
  | [], _ :: _ => rfl
  | _ :: _, [] => rfl
  | x :: xs, y :: ys => by
    rw [Tree.mapCols, Tree.mapCols, Tree.mapCols, Tree.mapCols, Tree.cmpCols, Tree.cmpCols,
      cmpCol_map2_D7_G3 hf x y, cmpCols_map2_D7_G3 hf xs ys]

theorem cmpCol_map2_D7_G3 {δ : Type} {c : δ → δ → Ordering} {f₁ g₁ : α → δ} {f₂ g₂ : β → δ}
    (hf : ∀ x y, c (f₁ x) (f₂ y) = c (g₁ x) (g₂ y)) (a : List (α × Tree α))
    (b : List (β × Tree β)) :
    Tree.cmpCol c (Tree.mapCol f₁ a) (Tree.mapCol f₂ b) =
      Tree.cmpCol c (Tree.mapCol g₁ a) (Tree.mapCol g₂ b) :=
  match a, b with
  | [], [] => rfl
  | [], _ :: _ => rfl
  | _ :: _, [] => rfl
  | (p, h) :: es, (q, k) :: fs => by
    rw [Tree.mapCol, Tree.mapCol, Tree.mapCol, Tree.mapCol, Tree.cmpCol, Tree.cmpCol, hf,
      cmp_map2_D7_G3 hf h k, cmpCol_map2_D7_G3 hf es fs]
end

end D7Trees_G3

-- T3.8lm (D7, helper): the label comparison behind sign independence
theorem kappaLabel_cmp_indep_D7_G3 {r d φ h h' : Nat} (hh : h < φ) (hh' : h' < φ) (x : Bool × Nat)
    (p : Nat) :
    keyLabelCmp (kappaLabel r d φ x)
        (kappaLabel r d h (if p < r + d then (false, p) else (true, p - (r + d)))) =
      keyLabelCmp (kappaLabel r d φ x)
        (kappaLabel r d h' (if p < r + d then (false, p) else (true, p - (r + d)))) := by
  obtain ⟨b, q⟩ := x
  have h1 : (h + 1) * d ≤ φ * d := Nat.mul_le_mul_right _ (by omega)
  have h2 : (h' + 1) * d ≤ φ * d := Nat.mul_le_mul_right _ (by omega)
  rw [Nat.succ_mul] at h1 h2
  by_cases hp : p < r + d
  · simp only [hp, if_true]
    by_cases hpr : r ≤ p
    · have ey : ∀ j, kappaLabel r d j (false, p) = (false, p + j * d) := fun j => by
        simp [kappaLabel, hpr]
      rw [ey, ey]
      cases b
      · by_cases hq : r ≤ q
        · have ex : kappaLabel r d φ (false, q) = (false, q + φ * d) := by simp [kappaLabel, hq]
          rw [ex]
          have hb : compare false false = Ordering.eq := rfl
          simp only [keyLabelCmp, hb, Ordering.eq_then]
          rw [show compare (q + φ * d) (p + h * d) = .gt from compare_gt_iff_gt.mpr (by omega),
            show compare (q + φ * d) (p + h' * d) = .gt from compare_gt_iff_gt.mpr (by omega)]
        · have ex : kappaLabel r d φ (false, q) = (false, q) := by simp [kappaLabel, hq]
          rw [ex]
          have hb : compare false false = Ordering.eq := rfl
          simp only [keyLabelCmp, hb, Ordering.eq_then]
          rw [show compare q (p + h * d) = .lt from compare_lt_iff_lt.mpr (by omega),
            show compare q (p + h' * d) = .lt from compare_lt_iff_lt.mpr (by omega)]
      · have hb : compare true false = Ordering.gt := rfl
        simp [kappaLabel, keyLabelCmp, hb]
    · cases b <;> simp [kappaLabel, keyLabelCmp, hpr]
  · simp only [hp, if_false]
    simp [kappaLabel]

-- T3.8lm (txt:555-559): sign independence of a fixed phase-`φ` key against the phase-`h` images
-- of a key normalized at the old terminal `t = r + d`, for every `h < φ`
theorem sign_indep_G3 {r d φ h h' : Nat} (hh : h < φ) (hh' : h' < φ) (w : Key) (J : Forest) :
    keyCmp (kappa r d φ w) (kappa r d h (relKey (r + d) J)) =
      keyCmp (kappa r d φ w) (kappa r d h' (relKey (r + d) J)) := by
  unfold keyCmp kappa relKey
  rw [map_map_D7_G3, map_map_D7_G3]
  exact cmp_map2_D7_G3 (fun x p => kappaLabel_cmp_indep_D7_G3 hh hh' x p) w J

-- T3.8lm (D7, helper): list comparisons against two relabellings agree when every pair does
theorem list_lt_congr_D7_G3 {β γ : Type} (E : γ → Key) (F G : β → Key)
    (hFG : ∀ w J, keyCmp (E w) (F J) = keyCmp (E w) (G J)) :
    ∀ (W : List γ) (Js : List β), W.map E < Js.map F ↔ W.map E < Js.map G
  | [], [] => by simp
  | [], _ :: _ => by simp [List.nil_lt_cons]
  | _ :: _, [] => by simp
  | w :: ws, J :: Js => by
    have hlt : E w < F J ↔ E w < G J := by
      rw [← compare_lt_iff_lt (a := E w) (b := F J), ← compare_lt_iff_lt (a := E w) (b := G J),
        Key.compare_eq_keyCmp, Key.compare_eq_keyCmp, hFG]
    have heq : E w = F J ↔ E w = G J := by
      rw [← compare_eq_iff_eq (a := E w) (b := F J), ← compare_eq_iff_eq (a := E w) (b := G J),
        Key.compare_eq_keyCmp, Key.compare_eq_keyCmp, hFG]
    simp only [List.map_cons, List.cons_lt_cons_iff, hlt, heq, list_lt_congr_D7_G3 E F G hFG ws Js]

-- T3.8lm: the same for reduced queries (lists of keys), hence for "low/high" at every head
theorem sign_indep_list_G3 {r d φ h h' : Nat} (hh : h < φ) (hh' : h' < φ) (W : List Key)
    (Js : List Forest) :
    (W.map (kappa r d φ) < (Js.map (relKey (r + d))).map (kappa r d h) ↔
      W.map (kappa r d φ) < (Js.map (relKey (r + d))).map (kappa r d h')) := by
  rw [List.map_map, List.map_map]
  exact list_lt_congr_D7_G3 _ _ _ (fun w J => sign_indep_G3 hh hh' w J) W Js

/-- G9.0 (= D-G010.2 `kappaQ_G3`, draft name `kappaQry`): `κ_j` on a query of actual keys (a list
of `WithTop Key`), exactly the map applied to queries in `head_path` (T3.2q). -/
def kappaQ_G3 (r d φ : Nat) (W : List (WithTop Key)) : List (WithTop Key) :=
  W.map (WithTop.map (kappa r d φ))

section G9Words_G3

variable {α : Type} [LinearOrder α]

-- G9.2a: a query strictly below the full boundary of the first `m` keys stops before `m`
theorem cursor_lt_of_lt_cutQuery_G3 {ks W : List α} (hW : Noninc W) {m : Nat} (hm : m ≤ ks.length)
    (h : W < cutQuery ks m) : cursor ks W < m := by
  rcases m with _ | v
  · rw [cutQuery_zero] at h
    exact absurd h (List.not_lt_nil _)
  · exact Nat.lt_succ_of_le (cursor_le_of_lt_cutQuery hW (by omega) h)

-- G9.2c: `ν(l)` is a sublist of `l`
theorem nu_sublist_G3 (l : List α) : (nu l).Sublist l := by
  rw [nu_eq_foldl]
  suffices H : ∀ (l acc pre : List α), acc.Sublist pre → (l.foldl nuStep acc).Sublist (pre ++ l) by
    simpa using H l [] [] (List.Sublist.refl _)
  intro l
  induction l with
  | nil => intro acc pre h; simpa using h
  | cons x xs ih =>
    intro acc pre h
    rw [List.foldl_cons]
    have hstep : (nuStep acc x).Sublist (pre ++ [x]) := by
      unfold nuStep
      refine List.Sublist.append ?_ (List.Sublist.refl _)
      refine List.Sublist.trans ?_ h
      have := (List.dropWhile_sublist (l := acc.reverse) (fun y => decide (y < x))).reverse
      simpa using this
    simpa using ih _ _ hstep

end G9Words_G3

-- G9.2d: `κ_j` on `WithTop Key` is strictly increasing
theorem kappaQry_strictMono_G3 (r d j : Nat) : StrictMono (WithTop.map (kappa r d j)) :=
  WithTop.strictMono_map_iff.mpr (kappa_strictMono r d j)

-- G9.2d (helper): `κ_i ∘ κ_j = κ_{i+j}` on queries (T3.2h.2 `kappa_add`, pointwise)
theorem kappaQ_add_G3 (r d i j : Nat) (W : List (WithTop Key)) :
    kappaQ_G3 r d i (kappaQ_G3 r d j W) = kappaQ_G3 r d (i + j) W := by
  unfold kappaQ_G3
  rw [List.map_map]
  congr 1
  funext x
  cases x with
  | top => rfl
  | coe x => simp only [Function.comp_apply, WithTop.map_coe, kappa_add]

-- G9.2d (helper): `κ_j` keeps queries reduced
theorem kappaQ_noninc_G3 (r d j : Nat) {W : List (WithTop Key)} (hW : Noninc W) :
    Noninc (kappaQ_G3 r d j W) :=
  List.Pairwise.map _ (fun _ _ h => (kappaQry_strictMono_G3 r d j).monotone h) hW

-- G9.2d (helper): `κ_j` reflects and preserves the order of queries
theorem kappaQ_lt_iff_G3 (r d j : Nat) (W Z : List (WithTop Key)) :
    kappaQ_G3 r d j W < kappaQ_G3 r d j Z ↔ W < Z :=
  list_map_lt_iff ((kappaQry_strictMono_G3 r d j).strictMonoOn Set.univ)
    (fun _ _ => Set.mem_univ _) (fun _ _ => Set.mem_univ _)

-- G9.2e: path nesting for whole paths (U1 L2.2 edgewise)
theorem path_nesting_path_G3 {E : Forest} {ks : KeySys} (hV : CondV E) (hA : CondAK E ks)
    (c : ColAddr) {W Z : List (WithTop Key)} (hW : Noninc W) (hZ : Noninc Z) (hWZ : W ≤ Z)
    {x y : Nat} (h : Path E ks c Z x y) : Path E ks c W x y := by
  induction h with
  | refl => exact Relation.ReflTransGen.refl
  | tail _ he ih => exact ih.trans (path_nesting hV hA c hW hZ hWZ he)

-- G9.3 (txt:391-392, "path nesting supplies the terminal-to-root path"): at a reduced query
-- `W' < Z` the old terminal answers with a query parent `q_j`, `j = cursor y W' < m`, and `q_j`
-- reaches `r` by a `g_{W'}` path on the stopping column's stack
theorem term_detour_G3 (S : OrdData_G3) {W : List (WithTop Key)} (hW : Noninc W) (hlow : W < S.termZ) :
    cursor (actualKeys S.A S.sd.col) W < S.m ∧
      ∃ q, (parents S.A S.sd.col)[cursor (actualKeys S.A S.sd.col) W]? = some q ∧
        S.sd.r ≤ q ∧ q < S.sd.t ∧ Path S.A (actualKeys S.A) S.sd.col W q S.sd.r := by
  obtain ⟨hcol, -, ht, -⟩ := stopData_spec S.hsd
  have hVA : CondV S.A := S.inL.1
  have hAA : CondA S.A := S.inL.2.2.2.1
  have hlen : (actualKeys S.A S.sd.col).length = S.m + 1 := by
    rw [length_actualKeys, hcol]; simp [OrdData_G3.m]
  have hpar : parents S.A S.sd.col = S.sd.Q.map Prod.fst ++ [S.sd.r] := by
    simp [parents, hcol]
  have hplen : (parents S.A S.sd.col).length = S.m + 1 := by
    rw [hpar]; simp [OrdData_G3.m]
  have hj : cursor (actualKeys S.A S.sd.col) W < S.m :=
    cursor_lt_of_lt_cutQuery_G3 hW (by omega) hlow
  refine ⟨hj, ?_⟩
  have hmem : S.sd.col ∈ S.A.colAddrs := by rw [Tree.mem_colAddrs_iff, hcol]; rfl
  set j := cursor (actualKeys S.A S.sd.col) W with hjdef
  set P : Nat → Nat := fun l => ((parents S.A S.sd.col)[l]?).getD 0 with hP
  have hPget : ∀ l, l ≤ S.m → (parents S.A S.sd.col)[l]? = some (P l) := by
    intro l hl
    have : l < (parents S.A S.sd.col).length := by omega
    simp [hP, List.getElem?_eq_getElem this]
  have hPm : P S.m = S.sd.r := by
    simp [hP, hpar, OrdData_G3.m]
  have hWlt : W < cutQuery (actualKeys S.A S.sd.col) (j + 1) :=
    (cursor_spec _ W hW).2 (by omega)
  have hchain : ∀ n, j + n ≤ S.m → Path S.A (actualKeys S.A) S.sd.col W (P j) (P (j + n)) := by
    intro n
    induction n with
    | zero => intro _; exact Relation.ReflTransGen.refl
    | succ n ih =>
      intro hn
      have h1 := ih (by omega)
      have hA := hAA S.sd.col hmem (j + n + 1) (P (j + n + 1)) (hPget _ hn)
      simp only [Nat.add_one_ne_zero, if_false, Nat.add_sub_cancel] at hA
      have hA' : Path S.A (actualKeys S.A) S.sd.col
          (cutQuery (actualKeys S.A S.sd.col) (j + n + 1)) (P (j + n)) (P (j + n + 1)) := hA
      have hle : W ≤ cutQuery (actualKeys S.A S.sd.col) (j + n + 1) :=
        le_of_lt (lt_of_lt_of_le hWlt (cutQuery_mono _ (by omega)))
      have h2 := path_nesting_path_G3 hVA hAA S.sd.col hW (cutQuery_noninc _ _) hle hA'
      exact h1.trans h2
  have hqr : Path S.A (actualKeys S.A) S.sd.col W (P j) S.sd.r := by
    have := hchain (S.m - j) (by omega)
    rwa [show j + (S.m - j) = S.m by omega, hPm] at this
  refine ⟨P j, hPget j hj.le, path_le hVA hqr, ?_, hqr⟩
  -- `q < t`: a parent of the stopping column is visible from it (V)
  have hent : S.A.entryAt ⟨S.sd.col, j⟩ = some (P j, (S.sd.Q[j]'(by simp [OrdData_G3.m] at hj; omega)).2) := by
    have hjQ : j < S.sd.Q.length := by simpa [OrdData_G3.m] using hj
    have hjQ' : j < (S.sd.Q.map Prod.fst).length := by simpa using hjQ
    have hPj : P j = (S.sd.Q[j]).1 := by
      simp only [hP, hpar, List.getElem?_append_left hjQ', List.getElem?_map,
        List.getElem?_eq_getElem hjQ, Option.map_some, Option.getD_some]
    rw [hPj]
    simp [Tree.entryAt, hcol, List.getElem?_append_left hjQ, hjQ]
    rfl
  have hmemE : (⟨S.sd.col, j⟩ : EntryAddr) ∈ S.A.entryAddrs := by
    rw [Tree.mem_entryAddrs_iff, hent]; rfl
  have := (condV_iff_lt S.A).mp hVA _ hmemE _ _ hent
  rw [ht]
  exact this

-- G9 (helper): a response is the parent at the cursor
theorem resp_eq_parents_G3 (E : Forest) (ks : KeySys) (o : ColAddr) (W : List (WithTop Key)) :
    resp E ks o W = (parents E o)[cursor (ks o) W]? := by
  unfold resp parents
  rw [List.getElem?_map]

-- G9 (helper): a path sum through a step `(ci, e)` after a prefix `pre`
theorem pathSum_ge_G3 (pre rest : List (Nat × Nat)) (ci e : Nat) :
    (pre.map (·.1 + 1)).sum + ci + 1 ≤ ((pre ++ (ci, e) :: rest).map (·.1 + 1)).sum := by
  simp only [List.map_append, List.map_cons, List.sum_append, List.sum_cons]
  omega

-- G9 (helper): every template column lies above the root, `r < num a`
theorem tmplCol_num_gt_G3 (S : OrdData_G3) {a : ColAddr} (ha : IsTmplCol S.A S.sd S.rd a) :
    S.sd.r < a.num 0 := by
  obtain ⟨-, -, hne, hker⟩ := ha
  obtain ⟨-, -, hidx, hrnum, hrt, -⟩ := rootData_spec S.hsd S.hrd
  obtain ⟨-, -, ht, -⟩ := stopData_spec S.hsd
  have hnum : ∀ b : ColAddr, b.num 0 = (b.path.map (·.1 + 1)).sum + b.col := by
    intro b; simp [ColAddr.num]
  by_cases hQ : isQMat S.sd a = true
  · -- Q-material lies inside a height of the stopping column, above `t > r`
    cases hd : a.path.drop S.sd.col.path.length with
    | nil => simp [isQMat, hd] at hQ
    | cons p rest =>
      obtain ⟨ci, j⟩ := p
      simp only [isQMat, hd, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at hQ
      obtain ⟨htk, hci, -⟩ := hQ
      have hpath : a.path = S.sd.col.path ++ (ci, j) :: rest := by
        rw [← htk, ← hd, List.take_append_drop]
      have h1 := pathSum_ge_G3 S.sd.col.path rest ci j
      rw [← hpath] at h1
      have h2 := hnum a
      have h3 := hnum S.sd.col
      omega
  · simp only [Bool.not_eq_true] at hQ
    unfold kerCol at hker
    simp only [hQ, Bool.false_eq_true, if_false] at hker
    by_cases hR : a.path.take S.rd.col.path.length = S.rd.col.path
    · rw [if_pos hR] at hker
      cases hd : a.path.drop S.rd.col.path.length with
      | nil =>
        rw [hd] at hker
        have hpath : a.path = S.rd.col.path := by
          rw [← List.take_append_drop S.rd.col.path.length a.path, hR, hd, List.append_nil]
        have hcol : S.rd.idx ≤ a.col := by
          split_ifs at hker with h1 h2
          · omega
          · omega
          · simp at hker
        have hcol' : a.col ≠ S.rd.col.col := by
          intro h
          apply hne
          show (⟨a.path, a.col⟩ : ColAddr) = ⟨S.rd.col.path, S.rd.col.col⟩
          rw [hpath, h]
        have h2 := hnum a
        have h3 := hnum S.rd.col
        rw [hpath] at h2
        omega
      | cons p rest =>
        obtain ⟨ci, e⟩ := p
        rw [hd] at hker
        have hci : S.rd.idx ≤ ci := by
          simp only at hker
          split_ifs at hker with h1 h2
          · omega
          · omega
          · simp at hker
        have hpath : a.path = S.rd.col.path ++ (ci, e) :: rest := by
          rw [← hR, ← hd, List.take_append_drop]
        have h1 := pathSum_ge_G3 S.rd.col.path rest ci e
        rw [← hpath] at h1
        have h2 := hnum a
        have h3 := hnum S.rd.col
        omega
    · rw [if_neg hR] at hker
      simp at hker

-- G9.4s1: the stack of `underCol h b` is the stack of `h` together with the `underCol h`-image of
-- the stack of `b`
theorem onStack_underCol_G3 (h b o : ColAddr) :
    (underCol h b).OnStack o ↔ h.OnStack o ∨ ∃ o', b.OnStack o' ∧ o = underCol h o' := by
  obtain ⟨hp, hc⟩ := h
  obtain ⟨bp, bc⟩ := b
  obtain ⟨op, oc⟩ := o
  cases bp with
  | nil =>
    show ColAddr.OnStack ⟨hp, hc + bc⟩ ⟨op, oc⟩ ↔ _
    unfold ColAddr.OnStack
    simp only
    constructor
    · rintro (hA | ⟨hpe, hlt⟩)
      · exact Or.inl (Or.inl hA)
      · by_cases hlt' : oc < hc
        · exact Or.inl (Or.inr ⟨hpe, hlt'⟩)
        · refine Or.inr ⟨⟨[], oc - hc⟩, Or.inr ⟨rfl, by simp only; omega⟩, ?_⟩
          show (⟨op, oc⟩ : ColAddr) = ⟨hp, hc + (oc - hc)⟩
          rw [hpe, show hc + (oc - hc) = oc by omega]
    · rintro ((hA | ⟨hpe, hlt⟩) | ⟨⟨op', oc'⟩, hst, hoe⟩)
      · exact Or.inl hA
      · exact Or.inr ⟨hpe, by omega⟩
      · rcases hst with ⟨k, ck, ik, hk, -, -⟩ | ⟨hp', hlt'⟩
        · simp at hk
        · simp only at hp' hlt'
          subst hp'
          change (⟨op, oc⟩ : ColAddr) = ⟨hp, hc + oc'⟩ at hoe
          simp only [ColAddr.mk.injEq] at hoe
          exact Or.inr ⟨hoe.1, by omega⟩
  | cons p rest =>
    obtain ⟨c0, e0⟩ := p
    show ColAddr.OnStack ⟨hp ++ (hc + c0, e0) :: rest, bc⟩ ⟨op, oc⟩ ↔ _
    unfold ColAddr.OnStack
    simp only
    constructor
    · rintro (⟨k, ck, ik, hk, hpe, hle⟩ | ⟨hpe, hlt⟩)
      · rcases Nat.lt_trichotomy k hp.length with hkl | hkl | hkl
        · rw [List.getElem?_append_left hkl] at hk
          rw [List.take_append_of_le_length hkl.le] at hpe
          exact Or.inl (Or.inl ⟨k, ck, ik, hk, hpe, hle⟩)
        · subst hkl
          rw [List.getElem?_append_right le_rfl, Nat.sub_self] at hk
          simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hk
          obtain ⟨h1, -⟩ := hk
          rw [List.take_left' rfl] at hpe
          by_cases hlt' : oc < hc
          · exact Or.inl (Or.inr ⟨hpe, hlt'⟩)
          · refine Or.inr ⟨⟨[], oc - hc⟩, Or.inl ⟨0, c0, e0, rfl, rfl, by simp only; omega⟩, ?_⟩
            show (⟨op, oc⟩ : ColAddr) = ⟨hp, hc + (oc - hc)⟩
            rw [hpe, show hc + (oc - hc) = oc by omega]
        · obtain ⟨j, hj⟩ : ∃ j, k = hp.length + (j + 1) := ⟨k - hp.length - 1, by omega⟩
          rw [hj, List.getElem?_append_right (by omega), Nat.add_sub_cancel_left] at hk
          rw [hj, List.take_length_add_append] at hpe
          refine Or.inr ⟨⟨(c0, e0) :: rest.take j, oc⟩,
            Or.inl ⟨j + 1, ck, ik, hk, by simp, hle⟩, ?_⟩
          show (⟨op, oc⟩ : ColAddr) = ⟨hp ++ (hc + c0, e0) :: rest.take j, oc⟩
          rw [hpe]
          simp
      · refine Or.inr ⟨⟨(c0, e0) :: rest, oc⟩, Or.inr ⟨rfl, hlt⟩, ?_⟩
        show (⟨op, oc⟩ : ColAddr) = ⟨hp ++ (hc + c0, e0) :: rest, oc⟩
        rw [hpe]
    · rintro ((⟨k, ck, ik, hk, hpe, hle⟩ | ⟨hpe, hlt⟩) | ⟨⟨op', oc'⟩, hst, hoe⟩)
      · have hkl : k < hp.length := (List.getElem?_eq_some_iff.mp hk).1
        refine Or.inl ⟨k, ck, ik, ?_, ?_, hle⟩
        · rw [List.getElem?_append_left hkl]; exact hk
        · rw [List.take_append_of_le_length hkl.le]; exact hpe
      · refine Or.inl ⟨hp.length, hc + c0, e0, ?_, ?_, by omega⟩
        · rw [List.getElem?_append_right le_rfl, Nat.sub_self]; rfl
        · rw [List.take_left' rfl]; exact hpe
      · rcases hst with ⟨k, ck, ik, hk, hpe, hle⟩ | ⟨hpe, hlt⟩
        · simp only at hpe hle
          cases k with
          | zero =>
            simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hk
            obtain ⟨h1, -⟩ := hk
            simp only [List.take_zero] at hpe
            subst hpe
            change (⟨op, oc⟩ : ColAddr) = ⟨hp, hc + oc'⟩ at hoe
            simp only [ColAddr.mk.injEq] at hoe
            obtain ⟨h3, h4⟩ := hoe
            rw [h3, h4]
            refine Or.inl ⟨hp.length, hc + c0, e0, ?_, ?_, by omega⟩
            · rw [List.getElem?_append_right le_rfl, Nat.sub_self]; rfl
            · rw [List.take_left' rfl]
          | succ j =>
            simp only [List.take_succ_cons] at hpe
            subst hpe
            change (⟨op, oc⟩ : ColAddr) = ⟨hp ++ (hc + c0, e0) :: rest.take j, oc'⟩ at hoe
            simp only [ColAddr.mk.injEq] at hoe
            obtain ⟨h3, h4⟩ := hoe
            rw [h3, h4]
            refine Or.inl ⟨hp.length + (j + 1), ck, ik, ?_, ?_, hle⟩
            · rw [List.getElem?_append_right (by omega), Nat.add_sub_cancel_left]; exact hk
            · rw [List.take_length_add_append]; rfl
        · simp only at hpe hlt
          subst hpe
          change (⟨op, oc⟩ : ColAddr) = ⟨hp ++ (hc + c0, e0) :: rest, oc'⟩ at hoe
          simp only [ColAddr.mk.injEq] at hoe
          obtain ⟨h3, h4⟩ := hoe
          rw [h3, h4]
          exact Or.inr ⟨rfl, hlt⟩

-- G9.4s2: printed numbers add under `underCol`
theorem num_underCol_G3 (h b : ColAddr) : (underCol h b).num 0 = h.num 0 + b.num 0 := by
  obtain ⟨bp, bc⟩ := b
  cases bp with
  | nil => simp [underCol, ColAddr.num]; omega
  | cons p rest =>
    obtain ⟨c0, e0⟩ := p
    simp [underCol, ColAddr.num, List.sum_append]; omega

-- G9.4s3: containment is carried by `underCol`
theorem container_underCol_G3 (h b o : ColAddr) :
    (underCol h o).container (underCol h b) = (o.container b).map fun e => ⟨underCol h o, e.idx⟩ := by
  obtain ⟨op, oc⟩ := o
  obtain ⟨bp, bc⟩ := b
  cases op with
  | nil =>
    cases bp with
    | nil => simp [underCol, ColAddr.container]
    | cons p rest =>
      obtain ⟨c0, e0⟩ := p
      simp [underCol, ColAddr.container]
  | cons p' rest' =>
    obtain ⟨c0', e0'⟩ := p'
    cases bp with
    | nil =>
      simp only [underCol, ColAddr.container]
      rw [List.drop_eq_nil_of_le (by simp)]
      simp
    | cons p rest =>
      obtain ⟨c0, e0⟩ := p
      simp only [underCol, ColAddr.container, List.length_append, List.length_cons]
      rw [List.drop_length_add_append, List.take_length_add_append]
      simp
      rcases List.drop rest'.length rest with _ | ⟨⟨k, i⟩, tail⟩
      · simp
      · simp

-- G9.4s3b: a column strictly on the stack of `h` contains `underCol h b` exactly when it contains
-- `h`, through the same entry
theorem container_underCol_of_onStack_G3 {h o : ColAddr} (ho : h.OnStack o) (b : ColAddr) :
    o.container (underCol h b) = o.container h := by
  obtain ⟨bp, bc⟩ := b
  rcases ho with ⟨k, ck, ik, hk, hp, hc⟩ | ⟨hp, hc⟩
  · have hkl : k < h.path.length := (List.getElem?_eq_some_iff.mp hk).1
    cases bp with
    | nil => rfl
    | cons p rest =>
      obtain ⟨c0, e0⟩ := p
      simp only [underCol, ColAddr.container, hp, List.length_take]
      rw [Nat.min_eq_left hkl.le]
      rw [List.drop_append_of_le_length hkl.le, List.take_append_of_le_length hkl.le]
      rw [List.drop_eq_getElem_cons hkl]
      rfl
  · cases bp with
    | nil => simp [underCol, ColAddr.container, hp]
    | cons p rest =>
      obtain ⟨c0, e0⟩ := p
      simp [underCol, ColAddr.container, hp]
      omega

-- G9 (helper): the root-tail branch of `kerCol`, case by case
theorem kerCol_tail_spec_G3 (S : OrdData_G3) {x x' : ColAddr} (hx : kerCol S.sd S.rd x = some x')
    (hxq : isQMat S.sd x = false) :
    ∃ suf, x.path = S.rd.col.path ++ suf ∧
      ((suf = [] ∧ x.col = S.rd.col.col ∧ x' = ⟨[], 0⟩) ∨
       (suf = [] ∧ S.rd.col.col < x.col ∧ S.rd.owner = false ∧ x' = ⟨[], x.col - S.rd.col.col⟩) ∨
       (∃ e rest, suf = (S.rd.col.col, e) :: rest ∧ S.rd.cursor ≤ e ∧
          x' = ⟨(0, S.m + (e - S.rd.cursor)) :: rest, x.col⟩) ∨
       (∃ ci e rest, suf = (ci, e) :: rest ∧ S.rd.col.col < ci ∧ S.rd.owner = false ∧
          x' = ⟨(ci - S.rd.col.col, e) :: rest, x.col⟩)) := by
  obtain ⟨-, -, hidx, -⟩ := rootData_spec S.hsd S.hrd
  unfold kerCol at hx
  simp only [hxq, Bool.false_eq_true, if_false] at hx
  by_cases hR : x.path.take S.rd.col.path.length = S.rd.col.path
  · rw [if_pos hR] at hx
    have hsplit := List.take_append_drop S.rd.col.path.length x.path
    rw [hR] at hsplit
    refine ⟨x.path.drop S.rd.col.path.length, hsplit.symm, ?_⟩
    cases hd : x.path.drop S.rd.col.path.length with
    | nil =>
      rw [hd] at hx
      simp only at hx
      rw [← hidx]
      split_ifs at hx with h1 h2
      · cases hx; exact Or.inl ⟨rfl, h1, rfl⟩
      · cases hx; exact Or.inr (Or.inl ⟨rfl, h2.1, h2.2, rfl⟩)
    | cons p rest =>
      obtain ⟨ci, e⟩ := p
      rw [hd] at hx
      simp only at hx
      rw [← hidx]
      split_ifs at hx with h1 h2
      · cases hx; obtain ⟨rfl, h1'⟩ := h1
        exact Or.inr (Or.inr (Or.inl ⟨e, rest, rfl, h1', rfl⟩))
      · cases hx
        exact Or.inr (Or.inr (Or.inr ⟨ci, e, rest, rfl, h2.1, h2.2, rfl⟩))
  · rw [if_neg hR] at hx
    cases hx

-- G9 (helper): root-tail columns through a root-level step are in the template
theorem kerCol_isSome_cons_G3 (S : OrdData_G3) {o : ColAddr} (hoq : isQMat S.sd o = false) {ci e : Nat}
    {rest : List (Nat × Nat)} (hp : o.path = S.rd.col.path ++ (ci, e) :: rest)
    (hc : (ci = S.rd.col.col ∧ S.rd.cursor ≤ e) ∨ (S.rd.col.col < ci ∧ S.rd.owner = false)) :
    (kerCol S.sd S.rd o).isSome := by
  obtain ⟨-, -, hidx, -⟩ := rootData_spec S.hsd S.hrd
  unfold kerCol
  simp only [hoq, hp, List.take_left, List.drop_left, Bool.false_eq_true, if_false, if_true, hidx]
  rcases hc with h | h
  · rw [if_pos h]; rfl
  · rw [if_neg (by omega), if_pos h]; rfl

-- G9 (helper): root-level columns from the root on are in the template
theorem kerCol_isSome_nil_G3 (S : OrdData_G3) {o : ColAddr} (hoq : isQMat S.sd o = false)
    (hp : o.path = S.rd.col.path)
    (hc : o.col = S.rd.col.col ∨ (S.rd.col.col < o.col ∧ S.rd.owner = false)) :
    (kerCol S.sd S.rd o).isSome := by
  obtain ⟨-, -, hidx, -⟩ := rootData_spec S.hsd S.hrd
  unfold kerCol
  simp only [hoq, hp, List.take_length, List.drop_length, Bool.false_eq_true, if_false, if_true, hidx]
  rcases hc with h | h
  · rw [if_pos h]; rfl
  · rw [if_neg (by omega), if_pos h]; rfl

-- G9 (helper): Q-material is closed under extending the address path
theorem isQMat_of_prefix_G3 (sd : StopData) {o x : ColAddr} (ho : isQMat sd o = true)
    (hpre : o.path <+: x.path) : isQMat sd x = true := by
  obtain ⟨t, ht⟩ := hpre
  unfold isQMat at ho ⊢
  cases hd : o.path.drop sd.col.path.length with
  | nil => simp [hd] at ho
  | cons p rest =>
    have hlen : sd.col.path.length < o.path.length := by
      by_contra hc
      rw [List.drop_eq_nil_of_le (by omega)] at hd
      cases hd
    rw [← ht, List.take_append_of_le_length hlen.le, List.drop_append_of_le_length hlen.le, hd]
    rw [hd] at ho
    exact ho

-- G9 (helper): a stack column's path is a prefix of the column's path
theorem onStack_prefix_G3 {x o : ColAddr} (ho : x.OnStack o) : o.path <+: x.path := by
  rcases ho with ⟨k, -, -, -, hp, -⟩ | ⟨hp, -⟩
  · rw [hp]; exact List.take_prefix _ _
  · rw [hp]

-- G9.4s4b: every stack column with number `≥ r` of root-tail material is root-tail material
theorem kerCol_of_onStack_tail_G3 (S : OrdData_G3) {x x' : ColAddr} (hx : kerCol S.sd S.rd x = some x')
    (hxq : isQMat S.sd x = false) {o : ColAddr} (ho : x.OnStack o) (hr : S.sd.r ≤ o.num 0) :
    (kerCol S.sd S.rd o).isSome ∧ isQMat S.sd o = false := by
  obtain ⟨-, -, hidx, hrnum, -⟩ := rootData_spec S.hsd S.hrd
  obtain ⟨suf, hpath, hcases⟩ := kerCol_tail_spec_G3 S hx hxq
  have hoq : isQMat S.sd o = false := by
    cases h : isQMat S.sd o
    · rfl
    · have := isQMat_of_prefix_G3 S.sd h (onStack_prefix_G3 ho)
      rw [this] at hxq
      cases hxq
  refine ⟨?_, hoq⟩
  have hnot : ¬ S.rd.col.OnStack o := fun h => by
    have := ColAddr.num_lt_of_onStack 0 h
    omega
  rcases ho with ⟨k, ck, ik, hk, hop, hoc⟩ | ⟨hop, hoc⟩
  · by_cases hkR : k < S.rd.col.path.length
    · exfalso
      apply hnot
      refine Or.inl ⟨k, ck, ik, ?_, ?_, hoc⟩
      · rw [hpath, List.getElem?_append_left hkR] at hk; exact hk
      · rw [hop, hpath, List.take_append_of_le_length hkR.le]
    · rw [not_lt] at hkR
      obtain ⟨j, hj⟩ : ∃ j, k = S.rd.col.path.length + j := ⟨k - S.rd.col.path.length, by omega⟩
      rw [hpath, hj, List.getElem?_append_right (by omega), Nat.add_sub_cancel_left] at hk
      rw [hpath, hj, List.take_length_add_append] at hop
      cases j with
      | zero =>
        simp only [List.take_zero, List.append_nil] at hop
        -- `o` sits at the root's level, at most at the column `ck` of `x`'s first step
        rcases Nat.lt_trichotomy o.col S.rd.col.col with hlt | heq | hgt
        · exact absurd (Or.inr ⟨hop, hlt⟩) hnot
        · exact kerCol_isSome_nil_G3 S hoq hop (Or.inl heq)
        · refine kerCol_isSome_nil_G3 S hoq hop (Or.inr ⟨hgt, ?_⟩)
          rcases hcases with ⟨rfl, -⟩ | ⟨rfl, -⟩ | ⟨e, rest, rfl, -, -⟩ | ⟨ci, e, rest, rfl, -, hown, -⟩
          · simp at hk
          · simp at hk
          · simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hk
            omega
          · exact hown
      | succ j =>
        rcases hcases with ⟨rfl, -⟩ | ⟨rfl, -⟩ | ⟨e, rest, rfl, he, -⟩ | ⟨ci, e, rest, rfl, hci, hown, -⟩
        · simp at hk
        · simp at hk
        · simp only [List.take_succ_cons] at hop
          exact kerCol_isSome_cons_G3 S hoq hop (Or.inl ⟨rfl, he⟩)
        · simp only [List.take_succ_cons] at hop
          exact kerCol_isSome_cons_G3 S hoq hop (Or.inr ⟨hci, hown⟩)
  · rw [hpath] at hop
    rcases hcases with ⟨rfl, hxc, -⟩ | ⟨rfl, hxc, hown, -⟩ | ⟨e, rest, rfl, he, -⟩ |
        ⟨ci, e, rest, rfl, hci, hown, -⟩
    · simp only [List.append_nil] at hop
      exact absurd (Or.inr ⟨hop, by omega⟩) hnot
    · simp only [List.append_nil] at hop
      rcases Nat.lt_trichotomy o.col S.rd.col.col with hlt | heq | hgt
      · exact absurd (Or.inr ⟨hop, hlt⟩) hnot
      · exact kerCol_isSome_nil_G3 S hoq hop (Or.inl heq)
      · exact kerCol_isSome_nil_G3 S hoq hop (Or.inr ⟨hgt, hown⟩)
    · exact kerCol_isSome_cons_G3 S hoq hop (Or.inl ⟨rfl, he⟩)
    · exact kerCol_isSome_cons_G3 S hoq hop (Or.inr ⟨hci, hown⟩)

theorem num_kerCol_tail_G3 (S : OrdData_G3) {x x' : ColAddr} (hx : kerCol S.sd S.rd x = some x')
    (hxq : isQMat S.sd x = false) : x'.num 0 + S.sd.r = x.num 0 := by
  obtain ⟨-, -, -, hrnum, -⟩ := rootData_spec S.hsd S.hrd
  obtain ⟨suf, hpath, hcases⟩ := kerCol_tail_spec_G3 S hx hxq
  have hnum : ∀ b : ColAddr, b.num 0 = (b.path.map (·.1 + 1)).sum + b.col := by
    intro b; simp [ColAddr.num]
  have hx1 := hnum x
  have hr1 := hnum S.rd.col
  rw [hpath, List.map_append, List.sum_append] at hx1
  rw [← hrnum]
  rcases hcases with ⟨rfl, h1, rfl⟩ | ⟨rfl, h1, -, rfl⟩ | ⟨e, rest, rfl, -, rfl⟩ |
      ⟨ci, e, rest, rfl, h1, -, rfl⟩
  · simp [ColAddr.num] at hx1 ⊢; omega
  · simp [ColAddr.num] at hx1 ⊢; omega
  · simp [ColAddr.num] at hx1 ⊢; omega
  · simp [ColAddr.num] at hx1 ⊢; omega

-- G9 (helper)
theorem container_col_G3 {o b : ColAddr} {e : EntryAddr} (h : o.container b = some e) : e.col = o :=
  ((ColAddr.container_spec o b e).mp h).1

-- G9 (helper): containment below a common step
theorem container_cons_G3 (ci ei : Nat) (π₁ π₂ : List (Nat × Nat)) (c₁ c₂ : Nat) :
    (⟨(ci, ei) :: π₁, c₁⟩ : ColAddr).container ⟨(ci, ei) :: π₂, c₂⟩ =
      ((⟨π₁, c₁⟩ : ColAddr).container ⟨π₂, c₂⟩).map fun e => ⟨⟨(ci, ei) :: π₁, c₁⟩, e.idx⟩ := by
  unfold ColAddr.container
  simp only [List.length_cons, List.drop_succ_cons, List.take_succ_cons, List.cons.injEq, true_and]
  cases List.drop π₁.length π₂ with
  | nil => rfl
  | cons x xs =>
    obtain ⟨k, i⟩ := x
    simp only
    split_ifs <;> rfl

-- G9 (helper): containment below a common prefix
theorem container_append_G3 (R so sx : List (Nat × Nat)) (c c' : Nat) :
    (⟨R ++ so, c⟩ : ColAddr).container ⟨R ++ sx, c'⟩ =
      ((⟨so, c⟩ : ColAddr).container ⟨sx, c'⟩).map fun e => ⟨⟨R ++ so, c⟩, e.idx⟩ := by
  induction R with
  | nil =>
    simp only [List.nil_append]
    cases h : (⟨so, c⟩ : ColAddr).container ⟨sx, c'⟩ with
    | none => rfl
    | some e =>
      simp only [Option.map_some]
      rw [← container_col_G3 h]
  | cons s R ih =>
    obtain ⟨ci, ei⟩ := s
    rw [List.cons_append, List.cons_append, container_cons_G3, ih, Option.map_map]
    rfl

-- G9 (helper): a column at the root level contains nothing at the root level
theorem container_nil_nil_G3 (c c' : Nat) : (⟨[], c⟩ : ColAddr).container ⟨[], c'⟩ = none := by
  simp [ColAddr.container]

-- G9 (helper)
theorem container_nil_cons_G3 (c c' k i : Nat) (rest : List (Nat × Nat)) :
    (⟨[], c⟩ : ColAddr).container ⟨(k, i) :: rest, c'⟩ = if k = c then some ⟨⟨[], c⟩, i⟩ else none := by
  simp [ColAddr.container]

-- G9 (helper)
theorem container_cons_nil_G3 (c c' : Nat) (s : Nat × Nat) (rest : List (Nat × Nat)) :
    (⟨s :: rest, c⟩ : ColAddr).container ⟨[], c'⟩ = none := by
  simp [ColAddr.container]

-- G9 (helper)
theorem container_cons_ne_G3 (c c' : Nat) (s t : Nat × Nat) (rs rt : List (Nat × Nat)) (h : s ≠ t) :
    (⟨s :: rs, c⟩ : ColAddr).container ⟨t :: rt, c'⟩ = none := by
  unfold ColAddr.container
  simp only [List.length_cons, List.drop_succ_cons, List.take_succ_cons, List.cons.injEq]
  cases List.drop rs.length rt with
  | nil => rfl
  | cons x xs =>
    obtain ⟨k, i⟩ := x
    simp only
    rw [if_neg (by intro hh; exact h hh.1.1.symm)]

theorem container_kerCol_G3 (S : OrdData_G3) {x x' o o' : ColAddr} (hx : kerCol S.sd S.rd x = some x')
    (ho : kerCol S.sd S.rd o = some o') (hxq : isQMat S.sd x = false) :
    o'.container x' = (o.container x).map fun e =>
      ⟨o', if o = S.rd.col then S.m + (e.idx - S.rd.cursor) else e.idx⟩ := by
  obtain ⟨sx, hxp, hxc⟩ := kerCol_tail_spec_G3 S hx hxq
  by_cases hoq : isQMat S.sd o = true
  · -- Q-material `o` contains no root-tail column, and its image contains no image of one
    have hox : o.container x = none := by
      cases h : o.container x with
      | none => rfl
      | some e =>
        exfalso
        obtain ⟨-, hpre⟩ := (ColAddr.container_spec o x e).mp h
        have hpre' : o.path <+: x.path := by
          rw [← container_col_G3 h]
          exact List.IsPrefix.trans (List.prefix_append _ _) hpre
        have := isQMat_of_prefix_G3 S.sd hoq hpre'
        rw [hxq] at this
        cases this
    rw [hox, Option.map_none]
    -- `o' = ⟨(0, j) :: rest, o.col⟩` with `j < m`
    unfold kerCol at ho
    rw [if_pos hoq] at ho
    unfold isQMat at hoq
    cases hd : o.path.drop S.sd.col.path.length with
    | nil => rw [hd] at ho; cases ho
    | cons p rest =>
      obtain ⟨ci, j⟩ := p
      rw [hd] at ho hoq
      simp only [Option.some.injEq] at ho
      subst ho
      simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at hoq
      have hj : j < S.m := hoq.2.2
      rcases hxc with ⟨-, -, rfl⟩ | ⟨-, -, -, rfl⟩ | ⟨e, rest', -, -, rfl⟩ |
          ⟨ci', e, rest', -, hci', -, rfl⟩
      · exact container_cons_nil_G3 _ _ _ _
      · exact container_cons_nil_G3 _ _ _ _
      · exact container_cons_ne_G3 _ _ _ _ _ _ (by simp; omega)
      · exact container_cons_ne_G3 _ _ _ _ _ _ (by simp; omega)
  · have hoq' : isQMat S.sd o = false := by simpa using hoq
    obtain ⟨so, hop, hoc⟩ := kerCol_tail_spec_G3 S ho hoq'
    obtain ⟨-, -, hidx, -⟩ := rootData_spec S.hsd S.hrd
    have hoeq : o = ⟨S.rd.col.path ++ so, o.col⟩ := by
      show (⟨o.path, o.col⟩ : ColAddr) = _; rw [hop]
    have hxeq : x = ⟨S.rd.col.path ++ sx, x.col⟩ := by
      show (⟨x.path, x.col⟩ : ColAddr) = _; rw [hxp]
    have hcont : o.container x = ((⟨so, o.col⟩ : ColAddr).container ⟨sx, x.col⟩).map
        fun e => ⟨o, e.idx⟩ := by
      conv_lhs => rw [hoeq, hxeq]
      rw [container_append_G3]
      rw [← hoeq]
    rw [hcont, Option.map_map]
    rcases hoc with ⟨rfl, hoc, rfl⟩ | ⟨rfl, hoc, hown, rfl⟩ | ⟨e₀, rest_o, rfl, he₀, rfl⟩ |
        ⟨ci₀, e₀, rest_o, rfl, hci₀, hown, rfl⟩
    · -- `o` is the root column
      have hor : o = S.rd.col := by
        rw [hoeq]; show (⟨_, _⟩ : ColAddr) = ⟨S.rd.col.path, S.rd.col.col⟩; rw [List.append_nil, hoc]
      rcases hxc with ⟨rfl, -, rfl⟩ | ⟨rfl, -, -, rfl⟩ | ⟨e, rest', rfl, he, rfl⟩ |
          ⟨ci', e, rest', rfl, hci', -, rfl⟩
      · simp [container_nil_nil_G3]
      · simp [container_nil_nil_G3]
      · rw [container_nil_cons_G3, container_nil_cons_G3, if_pos rfl, if_pos hoc.symm]
        simp [hor]
      · rw [container_nil_cons_G3, container_nil_cons_G3, if_neg (by omega), if_neg (by omega)]
        rfl
    · -- `o` a later root-level column
      have hor : o ≠ S.rd.col := by
        intro h; rw [h] at hoc; omega
      rcases hxc with ⟨rfl, -, rfl⟩ | ⟨rfl, -, -, rfl⟩ | ⟨e, rest', rfl, he, rfl⟩ |
          ⟨ci', e, rest', rfl, hci', -, rfl⟩
      · simp [container_nil_nil_G3]
      · simp [container_nil_nil_G3]
      · rw [container_nil_cons_G3, container_nil_cons_G3, if_neg (by omega), if_neg (by omega)]
        rfl
      · rw [container_nil_cons_G3, container_nil_cons_G3]
        by_cases hco : ci' = o.col
        · rw [if_pos hco, if_pos (by omega)]
          simp [hor]
        · rw [if_neg hco, if_neg (by omega)]
          rfl
    · -- `o` inside a restored height of the root
      have hor : o ≠ S.rd.col := by
        intro h; rw [h] at hop
        have := congrArg List.length hop
        simp at this
      rcases hxc with ⟨rfl, -, rfl⟩ | ⟨rfl, -, -, rfl⟩ | ⟨e, rest', rfl, he, rfl⟩ |
          ⟨ci', e, rest', rfl, hci', -, rfl⟩
      · simp [container_cons_nil_G3]
      · simp [container_cons_nil_G3]
      · by_cases hee : e = e₀
        · subst hee
          rw [container_cons_G3, container_cons_G3]
          simp only [Option.map_map]
          congr 1
          funext e'
          simp [hor]
        · rw [container_cons_ne_G3 _ _ _ _ _ _ (by simp; omega),
            container_cons_ne_G3 _ _ _ _ _ _ (by simp; omega)]
          rfl
      · rw [container_cons_ne_G3 _ _ _ _ _ _ (by simp; omega),
          container_cons_ne_G3 _ _ _ _ _ _ (by simp; omega)]
        rfl
    · -- `o` in a later body column of the root forest
      have hor : o ≠ S.rd.col := by
        intro h; rw [h] at hop
        have := congrArg List.length hop
        simp at this
      rcases hxc with ⟨rfl, -, rfl⟩ | ⟨rfl, -, -, rfl⟩ | ⟨e, rest', rfl, he, rfl⟩ |
          ⟨ci', e, rest', rfl, hci', -, rfl⟩
      · simp [container_cons_nil_G3]
      · simp [container_cons_nil_G3]
      · rw [container_cons_ne_G3 _ _ _ _ _ _ (by simp; omega),
          container_cons_ne_G3 _ _ _ _ _ _ (by simp; omega)]
        rfl
      · by_cases hee : ci' = ci₀ ∧ e = e₀
        · obtain ⟨rfl, rfl⟩ := hee
          rw [container_cons_G3, container_cons_G3]
          simp only [Option.map_map]
          congr 1
          funext e'
          simp [hor]
        · rw [container_cons_ne_G3 _ _ _ _ _ _ (by simp; omega),
            container_cons_ne_G3 _ _ _ _ _ _ (by simp; omega)]
          rfl

-- G9 (helper): Q-material, explicitly
theorem isQMat_spec_G3 (sd : StopData) {a : ColAddr} (h : isQMat sd a = true) :
    ∃ j rest, a.path = sd.col.path ++ (sd.col.col, j) :: rest ∧ j < sd.Q.length := by
  unfold isQMat at h
  cases hd : a.path.drop sd.col.path.length with
  | nil => simp [hd] at h
  | cons p rest =>
    obtain ⟨ci, j⟩ := p
    simp only [hd, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at h
    obtain ⟨htk, hci, hj⟩ := h
    refine ⟨j, rest, ?_, hj⟩
    rw [← List.take_append_drop sd.col.path.length a.path, htk, hd, hci]

-- G9 (helper)
theorem isQMat_of_spec_G3 (sd : StopData) {a : ColAddr} {j : Nat} {rest : List (Nat × Nat)}
    (hp : a.path = sd.col.path ++ (sd.col.col, j) :: rest) (hj : j < sd.Q.length) :
    isQMat sd a = true := by
  unfold isQMat
  rw [hp, List.take_left, List.drop_left]
  simp [hj]

-- G9 (helper): the template map on Q-material
theorem kerCol_qmat_G3 (S : OrdData_G3) {a : ColAddr} (h : isQMat S.sd a = true) {j : Nat}
    {rest : List (Nat × Nat)} (hp : a.path = S.sd.col.path ++ (S.sd.col.col, j) :: rest) :
    kerCol S.sd S.rd a = some ⟨(0, j) :: rest, a.col⟩ := by
  unfold kerCol
  simp only [h, if_true, hp, List.drop_left]

-- G9.4s5: the stack of Q-material images: the head and Q-material images only
theorem onStack_kerCol_qmat_G3 (S : OrdData_G3) {x x' : ColAddr} (hx : kerCol S.sd S.rd x = some x')
    (hxq : isQMat S.sd x = true) (o' : ColAddr) :
    x'.OnStack o' ↔ o' = ⟨[], 0⟩ ∨ ∃ o, x.OnStack o ∧ isQMat S.sd o = true ∧
      kerCol S.sd S.rd o = some o' := by
  obtain ⟨j, rest, hxp, hj⟩ := isQMat_spec_G3 S.sd hxq
  rw [kerCol_qmat_G3 S hxq hxp, Option.some.injEq] at hx
  subst hx
  obtain ⟨op, oc⟩ := o'
  constructor
  · rintro (⟨l, ck, ik, hl, hp, hle⟩ | ⟨hp, hlt⟩)
    · simp only at hp hle hl
      cases l with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hl
        simp only [List.take_zero] at hp
        left
        rw [hp, show oc = 0 by omega]
      | succ l =>
        simp only [List.getElem?_cons_succ] at hl
        simp only [List.take_succ_cons] at hp
        right
        refine ⟨⟨S.sd.col.path ++ (S.sd.col.col, j) :: rest.take l, oc⟩, ?_, ?_, ?_⟩
        · refine Or.inl ⟨S.sd.col.path.length + (l + 1), ck, ik, ?_, ?_, hle⟩
          · rw [hxp, List.getElem?_append_right (by omega), Nat.add_sub_cancel_left]
            simpa using hl
          · rw [hxp, List.take_length_add_append]; rfl
        · exact isQMat_of_spec_G3 S.sd (rest := rest.take l) rfl hj
        · rw [kerCol_qmat_G3 S (isQMat_of_spec_G3 S.sd (rest := rest.take l) rfl hj) rfl, hp]
    · simp only at hp hlt
      right
      refine ⟨⟨x.path, oc⟩, Or.inr ⟨rfl, hlt⟩, isQMat_of_spec_G3 S.sd hxp hj, ?_⟩
      have hq : isQMat S.sd ⟨x.path, oc⟩ = true := isQMat_of_spec_G3 S.sd hxp hj
      rw [kerCol_qmat_G3 S hq (show (⟨x.path, oc⟩ : ColAddr).path = _ from hxp), hp]
  · rintro (h0 | ⟨⟨op₀, oc₀⟩, hst, hq, hk⟩)
    · rw [h0]
      exact Or.inl ⟨0, 0, j, rfl, rfl, le_rfl⟩
    · obtain ⟨j', rest_o, hop, hj'⟩ := isQMat_spec_G3 S.sd hq
      rw [kerCol_qmat_G3 S hq hop, Option.some.injEq] at hk
      simp only at hop
      rw [← hk]
      rcases hst with ⟨k, ck, ik, hk', hp, hle⟩ | ⟨hp, hlt⟩
      · simp only at hp hle
        have hklen : k = S.sd.col.path.length + 1 + rest_o.length := by
          have := congrArg List.length hp
          have hkl : k < x.path.length := (List.getElem?_eq_some_iff.mp hk').1
          rw [hop, List.length_take, List.length_append, List.length_cons,
            Nat.min_eq_left hkl.le] at this
          omega
        rw [hxp, hklen, show S.sd.col.path.length + 1 + rest_o.length = S.sd.col.path.length + (rest_o.length + 1) by omega,
          List.take_length_add_append, List.take_succ_cons, hop] at hp
        have hp' := List.append_cancel_left hp
        simp only [List.cons.injEq, Prod.mk.injEq, true_and] at hp'
        obtain ⟨rfl, hrest⟩ := hp'
        rw [hxp, hklen, show S.sd.col.path.length + 1 + rest_o.length = S.sd.col.path.length + (rest_o.length + 1) by omega,
          List.getElem?_append_right (by omega), Nat.add_sub_cancel_left] at hk'
        simp only [List.getElem?_cons_succ] at hk'
        refine Or.inl ⟨rest_o.length + 1, ck, ik, ?_, ?_, hle⟩
        · simpa using hk'
        · simp only [List.take_succ_cons]
          exact congrArg _ hrest
      · simp only at hp hlt
        rw [hop, hxp] at hp
        have hp' := List.append_cancel_left hp
        simp only [List.cons.injEq, Prod.mk.injEq, true_and] at hp'
        obtain ⟨rfl, rfl⟩ := hp'
        exact Or.inr ⟨rfl, hlt⟩

-- G9 (helper): columns of a forest below a step `(ci, ei)`
theorem colAt_cons_G3 (cols : List Column) (ci ei : Nat) (π : List (Nat × Nat)) (col : Nat) :
    (Tree.node cols).colAt ⟨(ci, ei) :: π, col⟩ =
      ((cols[ci]?).bind (·[ei]?)).bind fun x => x.2.colAt ⟨π, col⟩ := by
  unfold Tree.colAt
  simp only [Tree.forestAt, Tree.cols]
  cases hx : (cols[ci]?).bind (·[ei]?) with
  | none => rfl
  | some x => obtain ⟨q, h⟩ := x; rfl

-- G9 (helper): a mapped column, entrywise
theorem mapCol_eq_map_G3 (f : Nat → Nat) (col : Column) :
    Tree.mapCol f col = col.map fun x => (f x.1, Tree.map f x.2) := by
  induction col with
  | nil => simp [Tree.mapCol]
  | cons x xs ih =>
    obtain ⟨p, H⟩ := x
    simp [Tree.mapCol, ih]

-- G9 (helper): the zero shift fixes columns
theorem mapCol_shiftVal_zero_G3 (r : Nat) (col : Column) : Tree.mapCol (shiftVal r 0) col = col := by
  rw [mapCol_eq_map_G3]
  conv_rhs => rw [← List.map_id col]
  congr 1
  funext x
  rw [shiftVal_zero]
  have : Tree.map (shiftVal r 0) x.2 = x.2 := shift_zero r x.2
  rw [this]
  rfl

-- G9 (helper): the unshifted placement at depth `k + 1` changes only the last entry of the last
-- column, replacing its height
theorem replaceAt_succ_eq_G3 (Z : Forest) (k : Nat) (cols : List Column) :
    replaceAt 0 0 Z (k + 1) (.node cols) =
      .node (cols.dropLast ++ (cols.getLast?.map fun col =>
        col.dropLast ++ (col.getLast?.map fun x => (x.1, replaceAt 0 0 Z k x.2)).toList).toList) := by
  have e1 : (fun x : Nat × Forest => (shiftVal 0 0 x.1, Tree.map (shiftVal 0 0) x.2)) = id := by
    funext x
    rw [shiftVal_zero]
    exact congrArg _ (shift_zero 0 x.2)
  have e2 : Tree.mapCol (shiftVal 0 0) = id := by
    funext col
    exact mapCol_shiftVal_zero_G3 0 col
  have e3 : (fun x : Nat × Forest => (shiftVal 0 0 x.1, replaceAt 0 0 Z k x.2)) =
      fun x => (x.1, replaceAt 0 0 Z k x.2) := by
    funext x
    rw [shiftVal_zero]
  simp only [replaceAt, mapLast_eq, e1, e2, e3, List.map_id]
  congr 2
  cases cols.getLast? with
  | none => rfl
  | some col => simp only [Option.map_some, mapLast_eq, List.map_id]

-- G9 (helper): the unshifted placement at depth `0` replaces the last column
theorem replaceAt_zero_eq_G3 (Z : Forest) (cols : List Column) (hne : cols ≠ []) :
    replaceAt 0 0 Z 0 (.node cols) = .node (cols.dropLast ++ Z.cols) := by
  cases cols with
  | nil => exact absurd rfl hne
  | cons x xs =>
    simp only [replaceAt]
    congr 2
    conv_rhs => rw [← List.map_id (x :: xs).dropLast]
    congr 1
    funext col
    exact mapCol_shiftVal_zero_G3 0 col

-- G9 (helper): the route path one level down
theorem isRoutePath_cons_G3 {F : Forest} {cols : List Column} (hF : F = .node cols) {ci ei : Nat}
    {rest : List (Nat × Nat)} {colci : Column} {q : Nat} {h : Forest}
    (hcolci : cols[ci]? = some colci) (hei : colci[ei]? = some (q, h))
    (hr : Scan.IsRoutePath F ((ci, ei) :: rest)) : Scan.IsRoutePath h rest := by
  intro d hd
  obtain ⟨G, hG, hls⟩ := hr (d + 1) (by simp; omega)
  refine ⟨G, ?_, ?_⟩
  · rw [hF] at hG
    simpa [List.take_succ_cons, Tree.forestAt, Tree.cols, hcolci, hei] using hG
  · simpa using hls

-- G9 (helper): the column-level form of G9.4m, by induction along the route
theorem replaceAt_colAt_G3 (Z : Forest) (π : List (Nat × Nat)) (F : Forest)
    (hroute : Scan.IsRoutePath F π) {j : Nat}
    (hlast : ∃ G, F.forestAt π = some G ∧ G.cols.length = j + 1)
    (o : ColAddr) (ho : (⟨π, j⟩ : ColAddr).OnStack o) :
    ((replaceAt 0 0 Z π.length F).colAt o).map (·.map Prod.fst) = (F.colAt o).map (·.map Prod.fst) ∧
    (∀ e, o.container ⟨π, j⟩ = some e →
      ((replaceAt 0 0 Z π.length F).colAt o).map (·.take e.idx) = (F.colAt o).map (·.take e.idx)) ∧
    (o.container ⟨π, j⟩ = none → (replaceAt 0 0 Z π.length F).colAt o = F.colAt o) := by
  -- it suffices to treat the two shapes of the conclusion
  suffices H : (o.container ⟨π, j⟩ = none ∧ (replaceAt 0 0 Z π.length F).colAt o = F.colAt o) ∨
      (∃ e, o.container ⟨π, j⟩ = some e ∧
        ((replaceAt 0 0 Z π.length F).colAt o).map (·.map Prod.fst) = (F.colAt o).map (·.map Prod.fst) ∧
        ((replaceAt 0 0 Z π.length F).colAt o).map (·.take e.idx) = (F.colAt o).map (·.take e.idx)) by
    rcases H with ⟨hn, heq⟩ | ⟨e, he, h1, h2⟩
    · exact ⟨by rw [heq], fun e he => (by rw [hn] at he; cases he), fun _ => heq⟩
    · refine ⟨h1, fun e' he' => ?_, fun hn => (by rw [he] at hn; cases hn)⟩
      rw [he, Option.some.injEq] at he'
      rw [← he']
      exact h2
  induction π generalizing F o with
  | nil =>
    obtain ⟨cols⟩ := F
    obtain ⟨G, hG, hlen⟩ := hlast
    simp only [Tree.forestAt, Option.some.injEq] at hG
    subst hG
    simp only [Tree.cols] at hlen
    obtain ⟨op, oc⟩ := o
    rcases ho with ⟨l, cl, il, hl, -, -⟩ | ⟨hp, hlt⟩
    · simp at hl
    · simp only at hp hlt
      subst hp
      left
      refine ⟨by simp [ColAddr.container], ?_⟩
      rw [List.length_nil, replaceAt_zero_eq_G3 Z cols (by intro h; rw [h] at hlen; simp at hlen)]
      unfold Tree.colAt
      simp only [Tree.forestAt, Option.bind_some, Tree.cols]
      rw [List.getElem?_append_left (by simp; omega), List.getElem?_dropLast]
      simp [show oc < cols.length - 1 by omega]
  | cons s rest ih =>
    obtain ⟨ci, ei⟩ := s
    obtain ⟨cols⟩ := F
    -- the route step is the last-column, last-entry step
    obtain ⟨G0, hG0, hls⟩ := hroute 0 (by simp)
    simp only [List.take_zero, Tree.forestAt, Option.some.injEq] at hG0
    subst hG0
    unfold Tree.lastStep? at hls
    simp only [Tree.cols, List.getElem?_cons_zero] at hls
    obtain ⟨lc, hlc, hlcne, hci, hei⟩ : ∃ lc, cols.getLast? = some lc ∧ lc ≠ [] ∧
        ci = cols.length - 1 ∧ ei = lc.length - 1 := by
      cases hg : cols.getLast? with
      | none => rw [hg] at hls; cases hls
      | some lc =>
        rw [hg] at hls
        simp only [Option.bind_some] at hls
        split_ifs at hls with hemp
        simp only [Option.some.injEq, Prod.mk.injEq] at hls
        exact ⟨lc, rfl, by simpa using hemp, hls.1.symm, hls.2.symm⟩
    obtain ⟨pq, hpq⟩ : ∃ x, lc.getLast? = some x := by
      cases h : lc.getLast? with
      | none => simp at h; exact absurd h hlcne
      | some x => exact ⟨x, rfl⟩
    obtain ⟨q, h⟩ := pq
    have hcolsne : cols ≠ [] := by intro h; rw [h] at hlc; cases hlc
    have hcolci : cols[ci]? = some lc := by
      rw [hci, ← List.getLast?_eq_getElem?]; exact hlc
    have heiq : lc[ei]? = some (q, h) := by
      rw [hei, ← List.getLast?_eq_getElem?]; exact hpq
    have hcil : ci < cols.length := (List.getElem?_eq_some_iff.mp hcolci).1
    have heil : ei < lc.length := (List.getElem?_eq_some_iff.mp heiq).1
    have hR : replaceAt 0 0 Z ((ci, ei) :: rest).length (Tree.node cols) =
        .node (cols.dropLast ++ [lc.dropLast ++ [(q, replaceAt 0 0 Z rest.length h)]]) := by
      rw [List.length_cons, replaceAt_succ_eq_G3, hlc]
      simp only [Option.map_some, Option.toList_some, hpq]
    rw [hR]
    have hlen1 : cols.dropLast.length = ci := by simp; omega
    have hlen2 : lc.dropLast.length = ei := by simp; omega
    have hRci : (cols.dropLast ++ [lc.dropLast ++ [(q, replaceAt 0 0 Z rest.length h)]])[ci]? =
        some (lc.dropLast ++ [(q, replaceAt 0 0 Z rest.length h)]) := by
      rw [List.getElem?_append_right (le_of_eq hlen1), hlen1, Nat.sub_self]; rfl
    have hRei : (lc.dropLast ++ [(q, replaceAt 0 0 Z rest.length h)])[ei]? =
        some (q, replaceAt 0 0 Z rest.length h) := by
      rw [List.getElem?_append_right (le_of_eq hlen2), hlen2, Nat.sub_self]; rfl
    have hlc_split : lc = lc.dropLast ++ [(q, h)] := (List.dropLast_append_getLast? (q, h) hpq).symm
    have hroute' := isRoutePath_cons_G3 rfl hcolci heiq hroute
    have hlast' : ∃ G, h.forestAt rest = some G ∧ G.cols.length = j + 1 := by
      obtain ⟨G, hG, hl⟩ := hlast
      refine ⟨G, ?_, hl⟩
      simpa [Tree.forestAt, Tree.cols, hcolci, heiq] using hG
    obtain ⟨op, oc⟩ := o
    rcases ho with ⟨l, cl, il, hl, hp, hle⟩ | ⟨hp, hlt⟩
    · simp only at hp hle
      cases l with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hl
        have hcl : cl = ci := hl.1.symm
        simp only [List.take_zero] at hp
        subst hp
        rw [hcl] at hle
        rcases Nat.eq_or_lt_of_le hle with heq | hlt'
        · rw [heq]
          right
          refine ⟨⟨⟨[], ci⟩, ei⟩, by simp [ColAddr.container], ?_, ?_⟩
          · unfold Tree.colAt
            simp only [Tree.forestAt, Option.bind_some, Tree.cols, hRci, hcolci, Option.map_some,
              Option.some.injEq]
            conv_rhs => rw [hlc_split]
            simp
          · unfold Tree.colAt
            simp only [Tree.forestAt, Option.bind_some, Tree.cols, hRci, hcolci, Option.map_some,
              Option.some.injEq]
            rw [List.take_left' hlen2]
            conv_rhs => rw [hlc_split]
            rw [List.take_left' hlen2]
        · left
          refine ⟨?_, ?_⟩
          · unfold ColAddr.container
            simp only [List.length_nil, List.drop_zero, List.take_zero, true_and]
            rw [if_neg (by omega)]
          · unfold Tree.colAt
            simp only [Tree.forestAt, Option.bind_some, Tree.cols]
            rw [List.getElem?_append_left (by omega), List.getElem?_dropLast]
            simp [show oc < cols.length - 1 by omega]
      | succ l =>
        simp only [List.getElem?_cons_succ] at hl
        simp only [List.take_succ_cons] at hp
        subst hp
        have ho' : (⟨rest, j⟩ : ColAddr).OnStack ⟨rest.take l, oc⟩ := Or.inl ⟨l, cl, il, hl, rfl, hle⟩
        have hRcol : (Tree.node (cols.dropLast ++ [lc.dropLast ++ [(q, replaceAt 0 0 Z rest.length h)]])).colAt
            ⟨(ci, ei) :: rest.take l, oc⟩ = (replaceAt 0 0 Z rest.length h).colAt ⟨rest.take l, oc⟩ := by
          rw [colAt_cons_G3, hRci]
          simp only [Option.bind_some, hRei]
        have hFcol : (Tree.node cols).colAt ⟨(ci, ei) :: rest.take l, oc⟩ = h.colAt ⟨rest.take l, oc⟩ := by
          rw [colAt_cons_G3, hcolci]
          simp only [Option.bind_some, heiq]
        rw [hRcol, hFcol, container_cons_G3]
        rcases ih h hroute' hlast' ⟨rest.take l, oc⟩ ho' with ⟨hn, heq⟩ | ⟨e, he, h1, h2⟩
        · exact Or.inl ⟨by rw [hn]; rfl, heq⟩
        · exact Or.inr ⟨⟨⟨(ci, ei) :: rest.take l, oc⟩, e.idx⟩, by rw [he]; rfl, h1, h2⟩
    · simp only at hp hlt
      subst hp
      have ho' : (⟨rest, j⟩ : ColAddr).OnStack ⟨rest, oc⟩ := Or.inr ⟨rfl, hlt⟩
      have hRcol : (Tree.node (cols.dropLast ++ [lc.dropLast ++ [(q, replaceAt 0 0 Z rest.length h)]])).colAt
          ⟨(ci, ei) :: rest, oc⟩ = (replaceAt 0 0 Z rest.length h).colAt ⟨rest, oc⟩ := by
        rw [colAt_cons_G3, hRci]
        simp only [Option.bind_some, hRei]
      have hFcol : (Tree.node cols).colAt ⟨(ci, ei) :: rest, oc⟩ = h.colAt ⟨rest, oc⟩ := by
        rw [colAt_cons_G3, hcolci]
        simp only [Option.bind_some, heiq]
      rw [hRcol, hFcol, container_cons_G3]
      rcases ih h hroute' hlast' ⟨rest, oc⟩ ho' with ⟨hn, heq⟩ | ⟨e, he, h1, h2⟩
      · exact Or.inl ⟨by rw [hn]; rfl, heq⟩
      · exact Or.inr ⟨⟨⟨(ci, ei) :: rest, oc⟩, e.idx⟩, by rw [he]; rfl, h1, h2⟩

-- G9.4m: a context `C_A(Z)` keeps every stack column of the stopping column: same parents, and
-- the same entries except the height of the active entry of a container
theorem colAt_context_onStack_G3 {A : Forest} {sd : StopData} (hsd : stopData A = some sd)
    (Z : Forest) {o : ColAddr} (ho : sd.col.OnStack o) :
    parents (context A sd Z) o = parents A o ∧
      (∀ e, o.container sd.col = some e →
        ((context A sd Z).colAt o).map (·.take e.idx) = (A.colAt o).map (·.take e.idx)) ∧
      (o.container sd.col = none → (context A sd Z).colAt o = A.colAt o) := by
  obtain ⟨-, hdepth, -, hroute, -⟩ := stopData_spec hsd
  obtain ⟨hpath, F, hF, hFlen⟩ := (Scan.mem_routeCols_iff _ _).mp hroute
  have hctx : context A sd Z = replaceAt 0 0 Z sd.col.path.length A := by
    unfold context; rw [hdepth]
  rw [hctx]
  obtain ⟨h1, h2, h3⟩ := replaceAt_colAt_G3 Z sd.col.path A hpath ⟨F, hF, hFlen⟩ o ho
  refine ⟨?_, h2, h3⟩
  unfold parents
  cases hR : (replaceAt 0 0 Z sd.col.path.length A).colAt o with
  | none =>
    cases hA : A.colAt o with
    | none => rfl
    | some _ => rw [hR, hA] at h1; cases h1
  | some C1 =>
    cases hA : A.colAt o with
    | none => rw [hR, hA] at h1; cases h1
    | some C2 => rw [hR, hA] at h1; simpa using h1

-- G9 (helper): columns of a forest below a step, when the step's column and entry are given
theorem colAt_cons_of_G3 {cols : List Column} {ci ei : Nat} {colci : Column} {q : Nat} {h : Forest}
    (hc : cols[ci]? = some colci) (he : colci[ei]? = some (q, h)) (π : List (Nat × Nat)) (col : Nat) :
    (Tree.node cols).colAt ⟨(ci, ei) :: π, col⟩ = h.colAt ⟨π, col⟩ := by
  rw [colAt_cons_G3, hc]
  simp only [Option.bind_some, he]

-- G9 (helper): the column-level form of G9.4m', by induction along the route
theorem replaceAt_colAt_off_G3 (Z : Forest) (π : List (Nat × Nat)) (F : Forest)
    (hroute : Scan.IsRoutePath F π) {j : Nat}
    (hlast : ∃ G, F.forestAt π = some G ∧ G.cols.length = j + 1)
    (o : ColAddr) (ho : (F.colAt o).isSome) (hne : o ≠ ⟨π, j⟩)
    (hin : (⟨π, j⟩ : ColAddr).container o = none) (hnc : o.container ⟨π, j⟩ = none) :
    (replaceAt 0 0 Z π.length F).colAt o = F.colAt o := by
  induction π generalizing F o with
  | nil =>
    obtain ⟨cols⟩ := F
    obtain ⟨G, hG, hlen⟩ := hlast
    simp only [Tree.forestAt, Option.some.injEq] at hG
    subst hG
    simp only [Tree.cols] at hlen
    have hcne : cols ≠ [] := by intro h; rw [h] at hlen; simp at hlen
    rw [List.length_nil, replaceAt_zero_eq_G3 Z cols hcne]
    obtain ⟨op, oc⟩ := o
    cases op with
    | nil =>
      have hoc : oc < cols.length := by
        unfold Tree.colAt at ho
        simp only [Tree.forestAt, Option.bind_some, Tree.cols] at ho
        cases h : cols[oc]? with
        | none => rw [h] at ho; cases ho
        | some _ => exact (List.getElem?_eq_some_iff.mp h).1
      have hoj : oc ≠ j := fun h => hne (by rw [h])
      unfold Tree.colAt
      simp only [Tree.forestAt, Option.bind_some, Tree.cols]
      rw [List.getElem?_append_left (by simp; omega), List.getElem?_dropLast]
      simp [show oc < cols.length - 1 by omega]
    | cons s rest =>
      obtain ⟨c', e'⟩ := s
      have hc' : c' < cols.length := by
        rw [colAt_cons_G3] at ho
        cases h : cols[c']? with
        | none => rw [h] at ho; cases ho
        | some _ => exact (List.getElem?_eq_some_iff.mp h).1
      have hcj : c' ≠ j := by
        intro h
        apply Option.some_ne_none (⟨⟨[], j⟩, e'⟩ : EntryAddr)
        rw [← hin]
        simp [ColAddr.container, h]
      rw [colAt_cons_G3, colAt_cons_G3]
      rw [List.getElem?_append_left (by simp; omega), List.getElem?_dropLast]
      simp [show c' < cols.length - 1 by omega]
  | cons s rest ih =>
    obtain ⟨ci, ei⟩ := s
    obtain ⟨cols⟩ := F
    obtain ⟨G0, hG0, hls⟩ := hroute 0 (by simp)
    simp only [List.take_zero, Tree.forestAt, Option.some.injEq] at hG0
    subst hG0
    unfold Tree.lastStep? at hls
    simp only [Tree.cols, List.getElem?_cons_zero] at hls
    obtain ⟨lc, hlc, hlcne, hci, hei⟩ : ∃ lc, cols.getLast? = some lc ∧ lc ≠ [] ∧
        ci = cols.length - 1 ∧ ei = lc.length - 1 := by
      cases hg : cols.getLast? with
      | none => rw [hg] at hls; cases hls
      | some lc =>
        rw [hg] at hls
        simp only [Option.bind_some] at hls
        split_ifs at hls with hemp
        simp only [Option.some.injEq, Prod.mk.injEq] at hls
        exact ⟨lc, rfl, by simpa using hemp, hls.1.symm, hls.2.symm⟩
    obtain ⟨pq, hpq⟩ : ∃ x, lc.getLast? = some x := by
      cases h : lc.getLast? with
      | none => simp at h; exact absurd h hlcne
      | some x => exact ⟨x, rfl⟩
    obtain ⟨q, h⟩ := pq
    have hcolci : cols[ci]? = some lc := by
      rw [hci, ← List.getLast?_eq_getElem?]; exact hlc
    have heiq : lc[ei]? = some (q, h) := by
      rw [hei, ← List.getLast?_eq_getElem?]; exact hpq
    have hcil : ci < cols.length := (List.getElem?_eq_some_iff.mp hcolci).1
    have heil : ei < lc.length := (List.getElem?_eq_some_iff.mp heiq).1
    have hR : replaceAt 0 0 Z ((ci, ei) :: rest).length (Tree.node cols) =
        .node (cols.dropLast ++ [lc.dropLast ++ [(q, replaceAt 0 0 Z rest.length h)]]) := by
      rw [List.length_cons, replaceAt_succ_eq_G3, hlc]
      simp only [Option.map_some, Option.toList_some, hpq]
    rw [hR]
    have hlen1 : cols.dropLast.length = ci := by simp; omega
    have hlen2 : lc.dropLast.length = ei := by simp; omega
    have hRci : (cols.dropLast ++ [lc.dropLast ++ [(q, replaceAt 0 0 Z rest.length h)]])[ci]? =
        some (lc.dropLast ++ [(q, replaceAt 0 0 Z rest.length h)]) := by
      rw [List.getElem?_append_right (le_of_eq hlen1), hlen1, Nat.sub_self]; rfl
    have hRei : (lc.dropLast ++ [(q, replaceAt 0 0 Z rest.length h)])[ei]? =
        some (q, replaceAt 0 0 Z rest.length h) := by
      rw [List.getElem?_append_right (le_of_eq hlen2), hlen2, Nat.sub_self]; rfl
    have hroute' := isRoutePath_cons_G3 rfl hcolci heiq hroute
    have hlast' : ∃ G, h.forestAt rest = some G ∧ G.cols.length = j + 1 := by
      obtain ⟨G, hG, hl⟩ := hlast
      refine ⟨G, ?_, hl⟩
      simpa [Tree.forestAt, Tree.cols, hcolci, heiq] using hG
    obtain ⟨op, oc⟩ := o
    cases op with
    | nil =>
      have hoc : oc < cols.length := by
        unfold Tree.colAt at ho
        simp only [Tree.forestAt, Option.bind_some, Tree.cols] at ho
        cases h : cols[oc]? with
        | none => rw [h] at ho; cases ho
        | some _ => exact (List.getElem?_eq_some_iff.mp h).1
      have hoci : oc ≠ ci := by
        intro h
        apply Option.some_ne_none (⟨⟨[], oc⟩, ei⟩ : EntryAddr)
        rw [← hnc]
        simp [ColAddr.container, h]
      unfold Tree.colAt
      simp only [Tree.forestAt, Option.bind_some, Tree.cols]
      rw [List.getElem?_append_left (by omega), List.getElem?_dropLast]
      simp [show oc < cols.length - 1 by omega]
    | cons s rest_o =>
      obtain ⟨c', e'⟩ := s
      have hc' : c' < cols.length := by
        rw [colAt_cons_G3] at ho
        cases h : cols[c']? with
        | none => rw [h] at ho; cases ho
        | some _ => exact (List.getElem?_eq_some_iff.mp h).1
      rcases Nat.lt_or_ge c' ci with hlt | hge
      · rw [colAt_cons_G3, colAt_cons_G3]
        rw [List.getElem?_append_left (by omega), List.getElem?_dropLast]
        simp [show c' < cols.length - 1 by omega]
      · have hc'ci : c' = ci := by omega
        subst hc'ci
        have he' : e' < lc.length := by
          rw [colAt_cons_G3, hcolci] at ho
          simp only [Option.bind_some] at ho
          cases h : lc[e']? with
          | none => rw [h] at ho; cases ho
          | some _ => exact (List.getElem?_eq_some_iff.mp h).1
        rcases Nat.lt_or_ge e' ei with hlt | hge'
        · rw [colAt_cons_G3, colAt_cons_G3, hRci, hcolci]
          simp only [Option.bind_some]
          rw [List.getElem?_append_left (by omega), List.getElem?_dropLast]
          simp [show e' < lc.length - 1 by omega]
        · have he'ei : e' = ei := by omega
          subst he'ei
          rw [colAt_cons_of_G3 hRci hRei, colAt_cons_of_G3 hcolci heiq]
          rw [colAt_cons_of_G3 hcolci heiq] at ho
          rw [container_cons_G3] at hin hnc
          apply ih h hroute' hlast' _ ho
          · intro heq
            apply hne
            simp only [ColAddr.mk.injEq] at heq ⊢
            rw [heq.1, heq.2]
            exact ⟨rfl, rfl⟩
          · cases hce : (⟨rest, j⟩ : ColAddr).container ⟨rest_o, oc⟩ with
            | none => rfl
            | some _ => rw [hce] at hin; cases hin
          · cases hce : (⟨rest_o, oc⟩ : ColAddr).container ⟨rest, j⟩ with
            | none => rfl
            | some _ => rw [hce] at hnc; cases hnc

-- G9.4m' (added by the G-009 verification, used by G9.6 for template columns off the stopping
-- column's stack): a context `C_A(Z)` keeps every column of `A` that is not the stopping column,
-- not inside one of its heights and not a container of it
theorem colAt_context_of_not_route_G3 {A : Forest} {sd : StopData} (hsd : stopData A = some sd)
    (Z : Forest) {o : ColAddr} (ho : o ∈ A.colAddrs) (hne : o ≠ sd.col)
    (hin : sd.col.container o = none) (hnc : o.container sd.col = none) :
    (context A sd Z).colAt o = A.colAt o := by
  obtain ⟨-, hdepth, -, hroute, -⟩ := stopData_spec hsd
  obtain ⟨hpath, F, hF, hFlen⟩ := (Scan.mem_routeCols_iff _ _).mp hroute
  have hctx : context A sd Z = replaceAt 0 0 Z sd.col.path.length A := by
    unfold context; rw [hdepth]
  rw [hctx]
  exact replaceAt_colAt_off_G3 Z sd.col.path A hpath ⟨F, hF, hFlen⟩ o
    ((Tree.mem_colAddrs_iff _ _).mp ho) hne hin hnc

-- G9.4n: the column of a root-tail phase copy is the shifted column of the shorter output
-- `A' = A[n−h]` (the first column of `localSuffix_phase`, T3.2i.6)
theorem colAt_phaseCol_tail_G3 (S : OrdData_G3) {h : Nat} (hh : 1 ≤ h ∧ h ≤ S.n) {o : ColAddr}
    (ho : IsTmplCol S.A S.sd S.rd o) (hoq : isQMat S.sd o = false) {A' : Forest}
    (hA' : expand S.A (S.n - h) = some A') :
    S.B.colAt ((phaseCol S.sd S.rd h o).getD o) =
      (A'.colAt o).map (Tree.mapCol (shiftVal S.sd.r (h * S.d))) := by
  obtain ⟨c, hc⟩ : ∃ c, phaseCol S.sd S.rd h o = some c := by
    have hker := ho.2.2.2
    unfold phaseCol
    cases hk : kerCol S.sd S.rd o with
    | none => rw [hk] at hker; cases hker
    | some a' => exact ⟨_, rfl⟩
  rw [hc, Option.getD_some]
  have hls := localSuffix_phase S.inL S.kind S.hsd S.hrd S.out hh ho hc hA'
  rw [hoq] at hls
  simp only [Bool.false_eq_true, if_false] at hls
  have key : ∀ (E : Forest) (a : ColAddr), E.colAt a = (localSuffix E a).cols.head? := by
    intro E a
    unfold localSuffix Tree.colAt
    cases E.forestAt a.path with
    | none => simp [Tree.cols, Tree.empty]
    | some f => simp [Tree.cols, List.head?_drop]
  rw [key S.B c, hls, key A' o]
  unfold shift
  generalize localSuffix A' o = L
  obtain ⟨cols⟩ := L
  cases cols with
  | nil => simp [Tree.map, Tree.mapCols, Tree.cols]
  | cons x xs => simp [Tree.map, Tree.mapCols, Tree.cols, OrdData_G3.d]

-- G9 (helper): columns no deeper than the stopping column are not Q-material
theorem isQMat_of_short_G3 (sd : StopData) {x : ColAddr} (h : x.path.length ≤ sd.col.path.length) :
    isQMat sd x = false := by
  unfold isQMat
  rw [List.drop_eq_nil_of_le h]
  simp

-- G9 (helper): the root column is not Q-material and maps to the head `⟨[], 0⟩`
theorem isQMat_rdcol_G3 (S : OrdData_G3) : isQMat S.sd S.rd.col = false := by
  obtain ⟨-, -, -, hpre, -⟩ := rootData_path S.hsd S.hrd
  exact isQMat_of_short_G3 S.sd hpre.length_le

theorem kerCol_rdcol_G3 (S : OrdData_G3) : kerCol S.sd S.rd S.rd.col = some ⟨[], 0⟩ := by
  obtain ⟨-, -, hidx, -⟩ := rootData_spec S.hsd S.hrd
  unfold kerCol
  simp only [isQMat_rdcol_G3, List.take_length, List.drop_length, Bool.false_eq_true, if_false,
    if_true, hidx]

-- G9 (helper): the stopping column is template material (its image is the kernel hole)
theorem kerCol_sdcol_G3 (S : OrdData_G3) : ∃ kh, kerCol S.sd S.rd S.sd.col = some kh := by
  obtain ⟨hres, -, -, hpre, -, hown, hlast⟩ := rootData_path S.hsd S.hrd
  have hq : isQMat S.sd S.sd.col = false := isQMat_of_short_G3 S.sd le_rfl
  have hst := ((ColAddr.resolve_spec 0 _ _ _).mp hres).1
  obtain ⟨suf, hsuf⟩ := hpre
  cases suf with
  | nil =>
    rw [List.append_nil] at hsuf
    have hlt : S.rd.col.col < S.sd.col.col := by
      rcases hst with ⟨k, ck, ik, hk, hp, -⟩ | ⟨-, hlt⟩
      · exfalso
        have h1 := (List.getElem?_eq_some_iff.mp hk).1
        have h2 := congrArg List.length hp
        rw [List.length_take, hsuf] at h2
        omega
      · exact hlt
    have hown' : S.rd.owner = false := by
      cases h : S.rd.owner
      · rfl
      · exfalso
        have := hown.mp h
        simp [ColAddr.container, ← hsuf] at this
    exact Option.isSome_iff_exists.mp (kerCol_isSome_nil_G3 S hq hsuf.symm (Or.inr ⟨hlt, hown'⟩))
  | cons p rest =>
    obtain ⟨ci, e⟩ := p
    have hle : S.rd.col.col ≤ ci := by
      rcases hst with ⟨k, ck, ik, hk, hp, hle⟩ | ⟨hp, -⟩
      · have hkl := congrArg List.length hp
        rw [List.length_take, ← hsuf] at hkl
        rw [← hsuf] at hk
        have h1 := (List.getElem?_eq_some_iff.mp hk).1
        simp only [List.length_append, List.length_cons] at hkl h1
        have hk' : k = S.rd.col.path.length := by omega
        subst hk'
        rw [List.getElem?_append_right le_rfl, Nat.sub_self] at hk
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hk
        omega
      · exfalso
        rw [← hsuf] at hp
        have := congrArg List.length hp
        simp at this
    rcases Nat.eq_or_lt_of_le hle with heq | hlt
    · have hcont : S.rd.col.container S.sd.col = some ⟨S.rd.col, e⟩ := by
        simp [ColAddr.container, ← hsuf, heq]
      have hown' : S.rd.owner = true := hown.mpr (by rw [hcont]; rfl)
      have he := hlast _ hcont
      have hkd := S.kernelDefined hown'
      have hcur : S.rd.cursor ≤ e := by
        unfold unconsumed rootCol at hkd
        unfold Packet.rootLenOf at he
        by_contra hc
        exact hkd (List.drop_eq_nil_of_le (by simp only at he; omega))
      exact Option.isSome_iff_exists.mp
        (kerCol_isSome_cons_G3 S hq hsuf.symm (Or.inl ⟨heq.symm, hcur⟩))
    · have hown' : S.rd.owner = false := by
        cases h : S.rd.owner
        · rfl
        · exfalso
          have := hown.mp h
          simp [ColAddr.container, ← hsuf] at this
          omega
      exact Option.isSome_iff_exists.mp
        (kerCol_isSome_cons_G3 S hq hsuf.symm (Or.inr ⟨hlt, hown'⟩))

-- G9 (helper): template material other than the root has the root on its stack
theorem onStack_rdcol_G3 (S : OrdData_G3) {x x' : ColAddr} (hx : kerCol S.sd S.rd x = some x')
    (hxq : isQMat S.sd x = false) (hne : x ≠ S.rd.col) : x.OnStack S.rd.col := by
  obtain ⟨suf, hpath, hcases⟩ := kerCol_tail_spec_G3 S hx hxq
  rcases hcases with ⟨rfl, hc, -⟩ | ⟨rfl, hc, -, -⟩ | ⟨e, rest, rfl, -, -⟩ |
      ⟨ci, e, rest, rfl, hc, -, -⟩
  · exfalso
    apply hne
    show (⟨x.path, x.col⟩ : ColAddr) = ⟨S.rd.col.path, S.rd.col.col⟩
    rw [hpath, hc, List.append_nil]
  · exact Or.inr ⟨by rw [hpath, List.append_nil], hc⟩
  · refine Or.inl ⟨S.rd.col.path.length, S.rd.col.col, e, ?_, ?_, le_rfl⟩
    · rw [hpath, List.getElem?_append_right le_rfl, Nat.sub_self]; rfl
    · rw [hpath, List.take_left]
  · refine Or.inl ⟨S.rd.col.path.length, ci, e, ?_, ?_, hc.le⟩
    · rw [hpath, List.getElem?_append_right le_rfl, Nat.sub_self]; rfl
    · rw [hpath, List.take_left]

-- G9 (helper): iterated placements carry stacks and containment
theorem iterate_underCol_onStack_G3 (g : ColAddr) (n : Nat) {x y : ColAddr} (h : x.OnStack y) :
    ((underCol g)^[n] x).OnStack ((underCol g)^[n] y) := by
  induction n with
  | zero => exact h
  | succ n ih =>
    rw [Function.iterate_succ_apply', Function.iterate_succ_apply']
    exact (onStack_underCol_G3 g _ _).mpr (Or.inr ⟨_, ih, rfl⟩)

theorem iterate_underCol_container_G3 (g : ColAddr) (n : Nat) (o b : ColAddr) :
    ((underCol g)^[n] o).container ((underCol g)^[n] b) =
      (o.container b).map fun e => ⟨(underCol g)^[n] o, e.idx⟩ := by
  induction n with
  | zero =>
    simp only [Function.iterate_zero_apply]
    cases h : o.container b with
    | none => rfl
    | some e =>
      have := container_col_G3 h
      simp only [Option.map_some]
      rw [← this]
  | succ n ih =>
    rw [Function.iterate_succ_apply', Function.iterate_succ_apply', container_underCol_G3, ih,
      Option.map_map]
    rfl

-- G9 (helper): the cap column and the heads as iterated placements under the kernel hole
theorem phaseCol_eq_iterate_G3 (S : OrdData_G3) {kh : ColAddr} (hkh : kerCol S.sd S.rd S.sd.col = some kh)
    {i : Nat} {a a' : ColAddr} (ha' : kerCol S.sd S.rd a = some a') :
    phaseCol S.sd S.rd i a = some (underCol S.sd.col ((underCol kh)^[i - 1] a')) := by
  have hkerHole : kerHole S.sd S.rd = kh := by simp [kerHole, hkh]
  unfold phaseCol
  rw [ha', hkerHole]
  rfl

theorem headCol_eq_G3 (S : OrdData_G3) {kh : ColAddr} (hkh : kerCol S.sd S.rd S.sd.col = some kh)
    (h : Nat) : S.headCol h = underCol S.sd.col ((underCol kh)^[h - 1] ⟨[], 0⟩) := by
  unfold OrdData_G3.headCol
  rw [phaseCol_eq_iterate_G3 S hkh (kerCol_rdcol_G3 S)]
  rfl

-- G9 (helper): the template map at the root level
theorem kerCol_nil_eq_G3 (S : OrdData_G3) {o : ColAddr} (hoq : isQMat S.sd o = false)
    (hp : o.path = S.rd.col.path) :
    kerCol S.sd S.rd o = if o.col = S.rd.col.col then some ⟨[], 0⟩
      else if S.rd.col.col < o.col ∧ S.rd.owner = false then some ⟨[], o.col - S.rd.col.col⟩
      else none := by
  obtain ⟨-, -, hidx, -⟩ := rootData_spec S.hsd S.hrd
  unfold kerCol
  simp only [hoq, hp, List.take_length, List.drop_length, Bool.false_eq_true, if_false, if_true, hidx]

-- G9 (helper): the template map through a root-level step
theorem kerCol_cons_eq_G3 (S : OrdData_G3) {o : ColAddr} (hoq : isQMat S.sd o = false) {ci e : Nat}
    {rest : List (Nat × Nat)} (hp : o.path = S.rd.col.path ++ (ci, e) :: rest) :
    kerCol S.sd S.rd o = if ci = S.rd.col.col ∧ S.rd.cursor ≤ e then
        some ⟨(0, S.m + (e - S.rd.cursor)) :: rest, o.col⟩
      else if S.rd.col.col < ci ∧ S.rd.owner = false then some ⟨(ci - S.rd.col.col, e) :: rest, o.col⟩
      else none := by
  obtain ⟨-, -, hidx, -⟩ := rootData_spec S.hsd S.hrd
  unfold kerCol
  simp only [hoq, hp, List.take_left, List.drop_left, Bool.false_eq_true, if_false, if_true, hidx]
  rfl

-- G9 (helper): numbers of root-tail columns
theorem num_tail_G3 (S : OrdData_G3) {o : ColAddr} {s : List (Nat × Nat)} (hp : o.path = S.rd.col.path ++ s) :
    o.num 0 + S.rd.col.col = S.sd.r + (s.map (·.1 + 1)).sum + o.col := by
  obtain ⟨-, -, -, hrnum, -⟩ := rootData_spec S.hsd S.hrd
  rw [← hrnum]
  simp only [ColAddr.num, hp, List.map_append, List.sum_append]
  omega

-- G9.4s4, forward direction
theorem onStack_kerCol_tail_mp_G3 (S : OrdData_G3) {x x' : ColAddr} (hx : kerCol S.sd S.rd x = some x')
    (hxq : isQMat S.sd x = false) (o' : ColAddr) (h : x'.OnStack o') :
    ∃ o, x.OnStack o ∧ S.sd.r ≤ o.num 0 ∧ isQMat S.sd o = false ∧ kerCol S.sd S.rd o = some o' := by
  obtain ⟨-, -, -, hpre, -⟩ := rootData_path S.hsd S.hrd
  have hRq : ∀ {o : ColAddr}, o.path = S.rd.col.path → isQMat S.sd o = false := fun {o} hp =>
    isQMat_of_short_G3 S.sd (by rw [hp]; exact hpre.length_le)
  have hpq : ∀ {o : ColAddr}, o.path <+: x.path → isQMat S.sd o = false := fun {o} hp => by
    cases hq : isQMat S.sd o
    · rfl
    · have := isQMat_of_prefix_G3 S.sd hq hp; rw [hxq] at this; cases this
  obtain ⟨sx, hxp, hxc⟩ := kerCol_tail_spec_G3 S hx hxq
  obtain ⟨op, oc⟩ := o'
  -- the root column itself
  have hroot : ∀ (hne : x ≠ S.rd.col), ∃ o, x.OnStack o ∧ S.sd.r ≤ o.num 0 ∧
      isQMat S.sd o = false ∧ kerCol S.sd S.rd o = some ⟨[], 0⟩ :=
    fun hne => ⟨S.rd.col, onStack_rdcol_G3 S hx hxq hne,
      by rw [(rootData_spec S.hsd S.hrd).2.2.2.1], isQMat_rdcol_G3 S, kerCol_rdcol_G3 S⟩
  -- a root-level column `⟨R, idx + j⟩`
  have hlevel : ∀ j, (j = 0 ∨ S.rd.owner = false) → x.OnStack ⟨S.rd.col.path, S.rd.col.col + j⟩ →
      ∃ o, x.OnStack o ∧ S.sd.r ≤ o.num 0 ∧ isQMat S.sd o = false ∧
        kerCol S.sd S.rd o = some ⟨[], j⟩ := by
    intro j hj hst
    refine ⟨⟨S.rd.col.path, S.rd.col.col + j⟩, hst, ?_, hRq rfl, ?_⟩
    · have := num_tail_G3 S (o := ⟨S.rd.col.path, S.rd.col.col + j⟩) (s := []) (by simp)
      simp at this; omega
    · rw [kerCol_nil_eq_G3 S (o := ⟨S.rd.col.path, S.rd.col.col + j⟩) (hRq rfl) rfl]
      by_cases hj0 : j = 0
      · subst hj0; simp
      · have hown : S.rd.owner = false := hj.resolve_left hj0
        simp only [show ¬ (S.rd.col.col + j = S.rd.col.col) by omega, if_false, hown, and_true]
        rw [if_pos (by omega)]
        simp
  rcases hxc with ⟨rfl, hxc, rfl⟩ | ⟨rfl, hxc, hown, rfl⟩ | ⟨e, rest, rfl, he, rfl⟩ |
      ⟨ci, e, rest, rfl, hci, hown, rfl⟩
  · -- `x` is the root: its image `⟨[],0⟩` has an empty stack
    rcases h with ⟨l, _, _, hl, -, -⟩ | ⟨-, hlt⟩
    · simp at hl
    · simp at hlt
  · rcases h with ⟨l, _, _, hl, -, -⟩ | ⟨hp, hlt⟩
    · simp at hl
    · simp only at hp hlt
      subst hp
      have := hlevel oc (Or.inr hown) (Or.inr ⟨by rw [hxp, List.append_nil], by simp only; omega⟩)
      exact this
  · have hne : x ≠ S.rd.col := by
      intro h; rw [h] at hxp; have := congrArg List.length hxp; simp at this
    rcases h with ⟨l, ck, ik, hl, hp, hle⟩ | ⟨hp, hlt⟩
    · simp only at hp hle
      cases l with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hl
        simp only [List.take_zero] at hp
        subst hp
        rw [show oc = 0 by omega]
        exact hroot hne
      | succ l =>
        simp only [List.getElem?_cons_succ] at hl
        simp only [List.take_succ_cons] at hp
        subst hp
        have hp' : (⟨S.rd.col.path ++ (S.rd.col.col, e) :: rest.take l, oc⟩ : ColAddr).path <+:
            x.path := by
          rw [hxp]; exact List.prefix_append_right_inj _ |>.mpr (List.cons_prefix_cons.mpr ⟨rfl, List.take_prefix _ _⟩)
        refine ⟨⟨S.rd.col.path ++ (S.rd.col.col, e) :: rest.take l, oc⟩, ?_, ?_, hpq hp', ?_⟩
        · refine Or.inl ⟨S.rd.col.path.length + (l + 1), ck, ik, ?_, ?_, hle⟩
          · rw [hxp, List.getElem?_append_right (by omega), Nat.add_sub_cancel_left]
            simpa using hl
          · rw [hxp, List.take_length_add_append]; rfl
        · have := num_tail_G3 S (o := ⟨S.rd.col.path ++ (S.rd.col.col, e) :: rest.take l, oc⟩) rfl
          simp at this; omega
        · rw [kerCol_cons_eq_G3 S (hpq hp') rfl, if_pos ⟨rfl, he⟩]
    · simp only at hp hlt
      subst hp
      refine ⟨⟨x.path, oc⟩, Or.inr ⟨rfl, hlt⟩, ?_, hpq (List.prefix_refl _), ?_⟩
      · have := num_tail_G3 S (o := ⟨x.path, oc⟩) hxp
        simp at this; omega
      · rw [kerCol_cons_eq_G3 S (o := ⟨x.path, oc⟩) (hpq (List.prefix_refl _)) hxp,
          if_pos ⟨rfl, he⟩]
  · rcases h with ⟨l, ck, ik, hl, hp, hle⟩ | ⟨hp, hlt⟩
    · simp only at hp hle
      cases l with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hl
        simp only [List.take_zero] at hp
        subst hp
        refine hlevel oc (Or.inr hown) (Or.inl ⟨S.rd.col.path.length, ci, e, ?_, ?_, by simp only; omega⟩)
        · rw [hxp, List.getElem?_append_right le_rfl, Nat.sub_self]; rfl
        · rw [hxp, List.take_left]
      | succ l =>
        simp only [List.getElem?_cons_succ] at hl
        simp only [List.take_succ_cons] at hp
        subst hp
        have hp' : (⟨S.rd.col.path ++ (ci, e) :: rest.take l, oc⟩ : ColAddr).path <+: x.path := by
          rw [hxp]; exact List.prefix_append_right_inj _ |>.mpr (List.cons_prefix_cons.mpr ⟨rfl, List.take_prefix _ _⟩)
        refine ⟨⟨S.rd.col.path ++ (ci, e) :: rest.take l, oc⟩, ?_, ?_, hpq hp', ?_⟩
        · refine Or.inl ⟨S.rd.col.path.length + (l + 1), ck, ik, ?_, ?_, hle⟩
          · rw [hxp, List.getElem?_append_right (by omega), Nat.add_sub_cancel_left]
            simpa using hl
          · rw [hxp, List.take_length_add_append]; rfl
        · have := num_tail_G3 S (o := ⟨S.rd.col.path ++ (ci, e) :: rest.take l, oc⟩) rfl
          simp at this; omega
        · rw [kerCol_cons_eq_G3 S (hpq hp') rfl, if_neg (by omega), if_pos ⟨hci, hown⟩]
    · simp only at hp hlt
      subst hp
      refine ⟨⟨x.path, oc⟩, Or.inr ⟨rfl, hlt⟩, ?_, hpq (List.prefix_refl _), ?_⟩
      · have := num_tail_G3 S (o := ⟨x.path, oc⟩) hxp
        simp at this; omega
      · rw [kerCol_cons_eq_G3 S (o := ⟨x.path, oc⟩) (hpq (List.prefix_refl _)) hxp,
          if_neg (by omega), if_pos ⟨hci, hown⟩]

-- G9.4s4, backward direction
theorem onStack_kerCol_tail_mpr_G3 (S : OrdData_G3) {x x' : ColAddr} (hx : kerCol S.sd S.rd x = some x')
    (hxq : isQMat S.sd x = false) {o o' : ColAddr} (hst : x.OnStack o) (_hr : S.sd.r ≤ o.num 0)
    (hoq : isQMat S.sd o = false) (ho : kerCol S.sd S.rd o = some o') : x'.OnStack o' := by
  obtain ⟨-, -, -, hrnum, -⟩ := rootData_spec S.hsd S.hrd
  obtain ⟨sx, hxp, hxc⟩ := kerCol_tail_spec_G3 S hx hxq
  obtain ⟨so, hop, hoc⟩ := kerCol_tail_spec_G3 S ho hoq
  -- the stack of `x` is `o`'s path as a prefix of `x`'s
  have hlen : o.path.length ≤ x.path.length := by
    rcases hst with ⟨k, -, -, -, hp, -⟩ | ⟨hp, -⟩
    · rw [hp, List.length_take]; omega
    · rw [hp]
  rcases hoc with ⟨rfl, hoc, rfl⟩ | ⟨rfl, hoc, hown, rfl⟩ | ⟨e₀, rest_o, rfl, he₀, rfl⟩ |
      ⟨ci₀, e₀, rest_o, rfl, hci₀, hown, rfl⟩
  · -- `o` is the root column, imaged to the head `⟨[], 0⟩`
    rw [List.append_nil] at hop
    rcases hxc with ⟨rfl, hxc, rfl⟩ | ⟨rfl, hxc, -, rfl⟩ | ⟨e, rest, rfl, -, rfl⟩ |
        ⟨ci, e, rest, rfl, hci, -, rfl⟩
    · exfalso
      have h1 := ColAddr.num_lt_of_onStack 0 hst
      have h2 := num_tail_G3 S (o := o) (s := []) (by simpa using hop)
      have h3 := num_tail_G3 S (o := x) (s := []) (by simpa using hxp)
      simp at h2 h3
      omega
    · exact Or.inr ⟨rfl, by simp only; omega⟩
    · exact Or.inl ⟨0, 0, S.m + (e - S.rd.cursor), rfl, rfl, by simp only; omega⟩
    · exact Or.inl ⟨0, ci - S.rd.col.col, e, rfl, rfl, by simp only; omega⟩
  · -- `o` a later root-level column
    rw [List.append_nil] at hop
    rcases hxc with ⟨rfl, hxc, rfl⟩ | ⟨rfl, hxc, -, rfl⟩ | ⟨e, rest, rfl, -, rfl⟩ |
        ⟨ci, e, rest, rfl, hci, -, rfl⟩
    · rw [List.append_nil] at hxp
      rcases hst with ⟨k, _, _, hk, hp, _⟩ | ⟨_, hlt⟩
      · exfalso
        have h1 := (List.getElem?_eq_some_iff.mp hk).1
        have := congrArg List.length hp
        rw [List.length_take, hop, hxp] at this
        rw [hxp] at h1
        omega
      · exfalso; omega
    · rw [List.append_nil] at hxp
      rcases hst with ⟨k, _, _, hk, hp, _⟩ | ⟨_, hlt⟩
      · exfalso
        have h1 := (List.getElem?_eq_some_iff.mp hk).1
        have := congrArg List.length hp
        rw [List.length_take, hop, hxp] at this
        rw [hxp] at h1
        omega
      · exact Or.inr ⟨rfl, by simp only; omega⟩
    · exfalso
      rcases hst with ⟨k, ck, ik, hk, hp, hle⟩ | ⟨hp, -⟩
      · have hk' : k = S.rd.col.path.length := by
          have := congrArg List.length hp
          rw [List.length_take, hop, hxp] at this
          simp at this; omega
        subst hk'
        rw [hxp, List.getElem?_append_right le_rfl, Nat.sub_self] at hk
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hk
        omega
      · rw [hop, hxp] at hp
        have := congrArg List.length hp
        simp at this
    · rcases hst with ⟨k, ck, ik, hk, hp, hle⟩ | ⟨hp, -⟩
      · have hk' : k = S.rd.col.path.length := by
          have := congrArg List.length hp
          rw [List.length_take, hop, hxp] at this
          simp at this; omega
        subst hk'
        rw [hxp, List.getElem?_append_right le_rfl, Nat.sub_self] at hk
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hk
        exact Or.inl ⟨0, ci - S.rd.col.col, e, rfl, rfl, by simp only; omega⟩
      · exfalso
        rw [hop, hxp] at hp
        have := congrArg List.length hp
        simp at this
  · -- `o` inside a restored height of the root: `x` passes through the same step
    rcases hxc with ⟨rfl, -, rfl⟩ | ⟨rfl, -, -, rfl⟩ | ⟨e, rest, rfl, -, rfl⟩ |
        ⟨ci, e, rest, rfl, hci, -, rfl⟩
    · exfalso; rw [hop, hxp] at hlen; simp at hlen
    · exfalso; rw [hop, hxp] at hlen; simp at hlen
    · rcases hst with ⟨k, ck, ik, hk, hp, hle⟩ | ⟨hp, hlt⟩
      · have hkl : k < x.path.length := (List.getElem?_eq_some_iff.mp hk).1
        have hk' : k = S.rd.col.path.length + (rest_o.length + 1) := by
          have := congrArg List.length hp
          rw [List.length_take, Nat.min_eq_left hkl.le, hop] at this
          simp at this; omega
        subst hk'
        rw [hop, hxp, List.take_length_add_append, List.take_succ_cons] at hp
        have hp' := List.append_cancel_left hp
        simp only [List.cons.injEq, Prod.mk.injEq, true_and] at hp'
        obtain ⟨rfl, hrest⟩ := hp'
        rw [hxp, List.getElem?_append_right (by omega), Nat.add_sub_cancel_left] at hk
        simp only [List.getElem?_cons_succ] at hk
        refine Or.inl ⟨rest_o.length + 1, ck, ik, ?_, ?_, hle⟩
        · simpa using hk
        · show (0, S.m + (e₀ - S.rd.cursor)) :: rest_o = _
          rw [List.take_succ_cons, ← hrest]
      · rw [hop, hxp] at hp
        have hp' := List.append_cancel_left hp
        simp only [List.cons.injEq, Prod.mk.injEq, true_and] at hp'
        obtain ⟨rfl, rfl⟩ := hp'
        exact Or.inr ⟨rfl, hlt⟩
    · exfalso
      rcases hst with ⟨k, ck, ik, hk, hp, hle⟩ | ⟨hp, hlt⟩
      · have hkl : k < x.path.length := (List.getElem?_eq_some_iff.mp hk).1
        have hk' : S.rd.col.path.length < k := by
          have := congrArg List.length hp
          rw [List.length_take, Nat.min_eq_left hkl.le, hop] at this
          simp at this; omega
        obtain ⟨j, rfl⟩ : ∃ j, k = S.rd.col.path.length + (j + 1) := ⟨k - S.rd.col.path.length - 1, by omega⟩
        rw [hop, hxp, List.take_length_add_append, List.take_succ_cons] at hp
        have hp' := List.append_cancel_left hp
        simp only [List.cons.injEq, Prod.mk.injEq] at hp'
        omega
      · rw [hop, hxp] at hp
        have hp' := List.append_cancel_left hp
        simp only [List.cons.injEq, Prod.mk.injEq] at hp'
        omega
  · -- `o` in a later body column of the root forest
    rcases hxc with ⟨rfl, -, rfl⟩ | ⟨rfl, -, -, rfl⟩ | ⟨e, rest, rfl, -, rfl⟩ |
        ⟨ci, e, rest, rfl, hci, -, rfl⟩
    · exfalso; rw [hop, hxp] at hlen; simp at hlen
    · exfalso; rw [hop, hxp] at hlen; simp at hlen
    · exfalso
      rcases hst with ⟨k, ck, ik, hk, hp, hle⟩ | ⟨hp, hlt⟩
      · have hkl : k < x.path.length := (List.getElem?_eq_some_iff.mp hk).1
        have hk' : S.rd.col.path.length < k := by
          have := congrArg List.length hp
          rw [List.length_take, Nat.min_eq_left hkl.le, hop] at this
          simp at this; omega
        obtain ⟨j, rfl⟩ : ∃ j, k = S.rd.col.path.length + (j + 1) := ⟨k - S.rd.col.path.length - 1, by omega⟩
        rw [hop, hxp, List.take_length_add_append, List.take_succ_cons] at hp
        have hp' := List.append_cancel_left hp
        simp only [List.cons.injEq, Prod.mk.injEq] at hp'
        omega
      · rw [hop, hxp] at hp
        have hp' := List.append_cancel_left hp
        simp only [List.cons.injEq, Prod.mk.injEq] at hp'
        omega
    · rcases hst with ⟨k, ck, ik, hk, hp, hle⟩ | ⟨hp, hlt⟩
      · have hkl : k < x.path.length := (List.getElem?_eq_some_iff.mp hk).1
        have hk' : k = S.rd.col.path.length + (rest_o.length + 1) := by
          have := congrArg List.length hp
          rw [List.length_take, Nat.min_eq_left hkl.le, hop] at this
          simp at this; omega
        subst hk'
        rw [hop, hxp, List.take_length_add_append, List.take_succ_cons] at hp
        have hp' := List.append_cancel_left hp
        simp only [List.cons.injEq, Prod.mk.injEq] at hp'
        obtain ⟨⟨rfl, rfl⟩, hrest⟩ := hp'
        rw [hxp, List.getElem?_append_right (by omega), Nat.add_sub_cancel_left] at hk
        simp only [List.getElem?_cons_succ] at hk
        refine Or.inl ⟨rest_o.length + 1, ck, ik, ?_, ?_, hle⟩
        · simpa using hk
        · show (ci₀ - S.rd.col.col, e₀) :: rest_o = _
          rw [List.take_succ_cons, ← hrest]
      · rw [hop, hxp] at hp
        have hp' := List.append_cancel_left hp
        simp only [List.cons.injEq, Prod.mk.injEq] at hp'
        obtain ⟨⟨rfl, rfl⟩, rfl⟩ := hp'
        exact Or.inr ⟨rfl, hlt⟩

-- G9.4s4 (moved here from before G9.4s4b: its proof uses `onStack_rdcol_G3`): on root-tail material `kerCol` is a stack isomorphism onto the kernel output, with
-- `num (kerCol o) = num o − r`, and it carries containment
theorem onStack_kerCol_tail_G3 (S : OrdData_G3) {x x' : ColAddr} (hx : kerCol S.sd S.rd x = some x')
    (hxq : isQMat S.sd x = false) (o' : ColAddr) :
    x'.OnStack o' ↔ ∃ o, x.OnStack o ∧ S.sd.r ≤ o.num 0 ∧ isQMat S.sd o = false ∧
      kerCol S.sd S.rd o = some o' := by
  constructor
  · exact onStack_kerCol_tail_mp_G3 S hx hxq o'
  · rintro ⟨o, hst, hr, hoq, ho⟩
    exact onStack_kerCol_tail_mpr_G3 S hx hxq hst hr hoq ho

-- G9 (helper): a container of the stopping column contains it through its last entry
theorem container_sdcol_last_G3 (S : OrdData_G3) {o : ColAddr} {e : EntryAddr}
    (h : o.container S.sd.col = some e) : e.idx + 1 = (parents S.A o).length := by
  obtain ⟨-, -, -, hroute, -⟩ := stopData_spec S.hsd
  obtain ⟨hpath, -⟩ := (Scan.mem_routeCols_iff _ _).mp hroute
  unfold ColAddr.container at h
  cases hd : S.sd.col.path.drop o.path.length with
  | nil => rw [hd] at h; cases h
  | cons p rest =>
    obtain ⟨k, j⟩ := p
    rw [hd] at h
    simp only at h
    split_ifs at h with hc
    cases h
    obtain ⟨htake, hk⟩ := hc
    have hlt : o.path.length < S.sd.col.path.length := by
      by_contra hcon
      rw [List.drop_eq_nil_of_le (by omega)] at hd
      cases hd
    obtain ⟨F, hF, hlast⟩ := hpath o.path.length hlt
    rw [htake] at hF
    have hget : S.sd.col.path[o.path.length]? = some (k, j) := by
      rw [← List.head?_drop, hd]; rfl
    rw [hget] at hlast
    unfold Tree.lastStep? at hlast
    cases hcl : F.cols.getLast? with
    | none => rw [hcl] at hlast; cases hlast
    | some col =>
      rw [hcl] at hlast
      simp only [Option.bind_some] at hlast
      split_ifs at hlast with hemp
      simp only [Option.some.injEq, Prod.mk.injEq] at hlast
      obtain ⟨h1, h2⟩ := hlast
      have hcol : S.A.colAt o = some col := by
        unfold Tree.colAt
        rw [hF]
        simp only [Option.bind_some]
        rw [← hk, ← h1, ← List.getLast?_eq_getElem?]
        exact hcl
      simp only [parents, hcol, Option.getD_some, List.length_map]
      have : col.length ≠ 0 := by simpa using hemp
      omega

-- G9 (helper): numbers of iterated placements
theorem num_iterate_underCol_G3 (g : ColAddr) (n : Nat) (z : ColAddr) :
    ((underCol g)^[n] z).num 0 = n * g.num 0 + z.num 0 := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Function.iterate_succ_apply', num_underCol_G3, ih, Nat.succ_mul]
    omega

-- G9 (helper): the stack columns of the stopping column are columns of `A`
theorem mem_colAddrs_of_sdstack_G3 (S : OrdData_G3) {o : ColAddr} (ho : S.sd.col.OnStack o) :
    o ∈ S.A.colAddrs := by
  obtain ⟨-, -, hmem, -⟩ := rootData_col S.hsd S.hrd
  have := (Tree.stack_mem_prefix hmem).2.1 o ho
  have hr : Role.ord o ∈ S.A.roles := (List.takeWhile_sublist _).subset this
  rw [Tree.mem_colAddrs_iff]
  exact (Tree.mem_roles_iff _ _).mp hr

-- G9 (helper): the stack columns of the stopping column strictly between `r` and `t` are
-- non-Q template columns
theorem tmplCol_of_sdstack_G3 (S : OrdData_G3) {x : Nat} {o : ColAddr} (hx : S.sd.r < x)
    (hxt : x < S.sd.t) (ho : S.sd.col.resolve 0 x = some o) :
    IsTmplCol S.A S.sd S.rd o ∧ isQMat S.sd o = false := by
  obtain ⟨hst, hnum⟩ := (ColAddr.resolve_spec 0 _ _ _).mp ho
  obtain ⟨-, -, ht, -⟩ := stopData_spec S.hsd
  obtain ⟨-, -, -, hrnum, -⟩ := rootData_spec S.hsd S.hrd
  obtain ⟨kh, hkh⟩ := kerCol_sdcol_G3 S
  obtain ⟨hker, hoq⟩ := kerCol_of_onStack_tail_G3 S hkh (isQMat_of_short_G3 S.sd le_rfl) hst (by omega)
  refine ⟨⟨mem_colAddrs_of_sdstack_G3 S hst, ?_, ?_, hker⟩, hoq⟩
  · intro h; rw [h] at hnum; omega
  · intro h; rw [h] at hnum; omega

-- G9 (helper): a copy's column in `B` is the shifted column of a context of `A`
theorem colAt_copyCol_G3 (S : OrdData_G3) {h : Nat} (hh : h ≤ S.n) {o : ColAddr}
    (ho : IsTmplCol S.A S.sd S.rd o) (hoq : isQMat S.sd o = false) :
    ∃ Z, S.B.colAt (S.copyCol h o) =
      ((context S.A S.sd Z).colAt o).map (Tree.mapCol (shiftVal S.sd.r (h * S.d))) := by
  have hE : S.A ≠ Tree.empty := by
    intro h
    have := S.hsd
    rw [h, stopData_eq_none_of_lastCol (Or.inl rfl)] at this
    cases this
  have hit := expand_eq_iterate hE S.inL.1 S.inL.2.1 S.kind S.hsd S.hrd S.kernelDefined
  rcases Nat.eq_zero_or_pos h with h0 | hpos
  · subst h0
    refine ⟨(kernel S.A S.sd S.rd)^[S.n] Tree.empty, ?_⟩
    have hB : S.B = context S.A S.sd ((kernel S.A S.sd S.rd)^[S.n] Tree.empty) := by
      have := hit S.n
      rw [S.out] at this
      exact Option.some.inj this
    simp only [OrdData_G3.copyCol, if_true, Nat.zero_mul]
    rw [← hB]
    cases S.B.colAt o with
    | none => rfl
    | some col =>
      simp only [Option.map_some, mapCol_eq_map_G3]
      congr 1
      conv_lhs => rw [← List.map_id col]
      congr 1
      funext x
      have h1 : shiftVal S.sd.r 0 x.1 = x.1 := by simp [shiftVal]
      have h2 : Tree.map (shiftVal S.sd.r 0) x.2 = x.2 := shift_zero S.sd.r x.2
      rw [h1, h2]
      rfl
  · refine ⟨(kernel S.A S.sd S.rd)^[S.n - h] Tree.empty, ?_⟩
    have hA' := hit (S.n - h)
    simp only [OrdData_G3.copyCol, if_neg (show h ≠ 0 by omega)]
    rw [colAt_phaseCol_tail_G3 S ⟨hpos, hh⟩ ho hoq hA']

-- G9 (helper): the head of layer `h` is the phase-`h` copy of the root column
theorem phaseCol_headCol_G3 (S : OrdData_G3) (h : Nat) :
    phaseCol S.sd S.rd h S.rd.col = some (S.headCol h) := by
  obtain ⟨kh, hkh⟩ := kerCol_sdcol_G3 S
  rw [phaseCol_eq_iterate_G3 S hkh (kerCol_rdcol_G3 S), headCol_eq_G3 S hkh]

-- G9 (helper): splitting an address path at a step
theorem path_split_G3 {π : List (Nat × Nat)} {k ck ik : Nat} (hk : π[k]? = some (ck, ik)) :
    π = π.take k ++ (ck, ik) :: π.drop (k + 1) := by
  have hkl : k < π.length := (List.getElem?_eq_some_iff.mp hk).1
  have hget : π[k] = (ck, ik) := by
    rw [List.getElem?_eq_getElem hkl] at hk
    exact Option.some.inj hk
  conv_lhs => rw [← List.take_append_drop k π, List.drop_eq_getElem_cons hkl, hget]

-- G9 (helper): a step into an existing forest has an existing column
theorem forestAt_cons_some_G3 {G F : Forest} {ck ik : Nat} {rest : List (Nat × Nat)}
    (h : G.forestAt ((ck, ik) :: rest) = some F) : ck < G.cols.length := by
  simp only [Tree.forestAt] at h
  cases hc : G.cols[ck]? with
  | none => rw [hc] at h; simp at h
  | some _ => exact (List.getElem?_eq_some_iff.mp hc).1

-- G9 (helper): the stack columns of a column of `E` are columns of `E`
theorem mem_colAddrs_of_onStack_G3 {E : Forest} {c o : ColAddr} (hc : c ∈ E.colAddrs)
    (ho : c.OnStack o) : o ∈ E.colAddrs := by
  rw [Tree.mem_colAddrs_iff] at hc ⊢
  unfold Tree.colAt at hc ⊢
  cases hF : E.forestAt c.path with
  | none => rw [hF] at hc; cases hc
  | some F =>
    rw [hF] at hc
    simp only [Option.bind_some] at hc
    rcases ho with ⟨k, ck, ik, hk, hp, hle⟩ | ⟨hp, hlt⟩
    · have hsplit := path_split_G3 hk
      rw [hsplit, Tree.forestAt_append] at hF
      cases hG : E.forestAt (c.path.take k) with
      | none => rw [hG] at hF; cases hF
      | some G =>
        rw [hG] at hF
        simp only [Option.bind_some] at hF
        have hck := forestAt_cons_some_G3 hF
        rw [hp, hG]
        simp only [Option.bind_some]
        rw [List.getElem?_eq_getElem (by omega)]
        rfl
    · rw [hp, hF]
      simp only [Option.bind_some]
      have : c.col < F.cols.length := by
        cases h : F.cols[c.col]? with
        | none => rw [h] at hc; cases hc
        | some _ => exact (List.getElem?_eq_some_iff.mp h).1
      rw [List.getElem?_eq_getElem (by omega)]
      rfl

-- G9 (helper): the stopping column is on the stack of no non-Q column of `A`
theorem not_onStack_sdcol_G3 (S : OrdData_G3) {a : ColAddr} (ha : a ∈ S.A.colAddrs)
    (haq : isQMat S.sd a = false) : ¬ a.OnStack S.sd.col := by
  intro hst
  obtain ⟨hcol, -, -, hroute, -⟩ := stopData_spec S.hsd
  obtain ⟨-, F, hF, hFlen⟩ := (Scan.mem_routeCols_iff _ _).mp hroute
  have hcolF : F.cols[S.sd.col.col]? = some (S.sd.Q ++ [(S.sd.r, Tree.empty)]) := by
    unfold Tree.colAt at hcol
    rw [hF] at hcol
    simpa using hcol
  rw [Tree.mem_colAddrs_iff] at ha
  unfold Tree.colAt at ha
  rcases hst with ⟨k, ck, ik, hk, hp, hle⟩ | ⟨hp, hlt⟩
  · have hsplit := path_split_G3 hk
    have hkl : k < a.path.length := (List.getElem?_eq_some_iff.mp hk).1
    rw [← hp] at hsplit
    rw [hsplit, Tree.forestAt_append, hF] at ha
    simp only [Option.bind_some] at ha
    cases hG : F.forestAt ((ck, ik) :: a.path.drop (k + 1)) with
    | none => rw [hG] at ha; cases ha
    | some G =>
      rw [hG] at ha
      simp only [Option.bind_some] at ha
      have hck := forestAt_cons_some_G3 hG
      have hck' : ck = S.sd.col.col := by omega
      subst hck'
      simp only [Tree.forestAt, hcolF, Option.bind_some] at hG
      rcases Nat.lt_trichotomy ik S.sd.Q.length with hik | hik | hik
      · -- inside a query height: `a` would be Q-material
        apply Bool.false_ne_true
        rw [← haq]
        unfold isQMat
        rw [hsplit, List.take_left, List.drop_left]
        simp [hik]
      · -- inside the empty height of `(r, ∅)`
        subst hik
        rw [List.getElem?_append_right le_rfl, Nat.sub_self] at hG
        simp only [List.getElem?_cons_zero] at hG
        cases hrest : a.path.drop (k + 1) with
        | nil =>
          rw [hrest] at hG
          simp only [Tree.forestAt, Option.some.injEq] at hG
          subst hG
          simp [Tree.empty, Tree.cols] at ha
        | cons q rest =>
          obtain ⟨c', e'⟩ := q
          rw [hrest] at hG
          simp [Tree.forestAt, Tree.empty, Tree.cols] at hG
      · rw [List.getElem?_eq_none (by simp; omega)] at hG
        simp at hG
  · rw [← hp, hF] at ha
    simp only [Option.bind_some] at ha
    have : a.col < F.cols.length := by
      cases h : F.cols[a.col]? with
      | none => rw [h] at ha; cases ha
      | some _ => exact (List.getElem?_eq_some_iff.mp h).1
    omega

-- G9 (helper): no non-Q column of `A` lies inside a height of the stopping column
theorem not_inside_sdcol_G3 (S : OrdData_G3) {a : ColAddr} (ha : a ∈ S.A.colAddrs)
    (haq : isQMat S.sd a = false) {i : Nat} {rest : List (Nat × Nat)}
    (hp : a.path = S.sd.col.path ++ (S.sd.col.col, i) :: rest) : False := by
  obtain ⟨hcol, -, -, hroute, -⟩ := stopData_spec S.hsd
  obtain ⟨-, F, hF, -⟩ := (Scan.mem_routeCols_iff _ _).mp hroute
  have hcolF : F.cols[S.sd.col.col]? = some (S.sd.Q ++ [(S.sd.r, Tree.empty)]) := by
    unfold Tree.colAt at hcol
    rw [hF] at hcol
    simpa using hcol
  rcases Nat.lt_trichotomy i S.sd.Q.length with hik | hik | hik
  · apply Bool.false_ne_true
    rw [← haq]
    unfold isQMat
    rw [hp, List.take_left, List.drop_left]
    simp [hik]
  · rw [Tree.mem_colAddrs_iff] at ha
    unfold Tree.colAt at ha
    rw [hp, Tree.forestAt_append, hF] at ha
    simp only [Option.bind_some, Tree.forestAt, hcolF] at ha
    rw [hik, List.getElem?_append_right le_rfl, Nat.sub_self] at ha
    simp only [List.getElem?_cons_zero] at ha
    cases rest with
    | nil => simp [Tree.forestAt, Tree.empty, Tree.cols] at ha
    | cons q rest' =>
      obtain ⟨c', e'⟩ := q
      simp [Tree.forestAt, Tree.empty, Tree.cols] at ha
  · rw [Tree.mem_colAddrs_iff] at ha
    unfold Tree.colAt at ha
    rw [hp, Tree.forestAt_append, hF] at ha
    simp only [Option.bind_some, Tree.forestAt, hcolF] at ha
    rw [List.getElem?_eq_none (by simp; omega)] at ha
    simp at ha

-- G9 (helper): the stopping column contains no non-Q column of `A`
theorem sdcol_container_none_G3 (S : OrdData_G3) {a : ColAddr} (ha : a ∈ S.A.colAddrs)
    (haq : isQMat S.sd a = false) : S.sd.col.container a = none := by
  cases h : S.sd.col.container a with
  | none => rfl
  | some e =>
    exfalso
    unfold ColAddr.container at h
    cases hd : a.path.drop S.sd.col.path.length with
    | nil => rw [hd] at h; cases h
    | cons x rest =>
      obtain ⟨k', i'⟩ := x
      rw [hd] at h
      simp only at h
      split_ifs at h with hc
      obtain ⟨htake, hk⟩ := hc
      have hp : a.path = S.sd.col.path ++ (S.sd.col.col, i') :: rest := by
        rw [← List.take_append_drop S.sd.col.path.length a.path, htake, hd, hk]
      exact not_inside_sdcol_G3 S ha haq hp

-- G9 (helper): a container of a column is on its stack
theorem onStack_of_container_G3 {a b : ColAddr} {e : EntryAddr} (h : a.container b = some e) :
    b.OnStack a := by
  obtain ⟨he1, ⟨t, ht⟩⟩ := (ColAddr.container_spec a b e).mp h
  subst he1
  unfold EntryAddr.heightPath at ht
  refine Or.inl ⟨e.col.path.length, e.col.col, e.idx, ?_, ?_, le_rfl⟩
  · rw [← ht, List.append_assoc, List.getElem?_append_right le_rfl, Nat.sub_self]; rfl
  · rw [← ht, List.append_assoc, List.take_left]

-- T3.2i (D7): the parents of a template copy are the shifted parents of its template column
theorem parents_phaseCol_D7_G3 (S : OrdData_G3) {i : Nat} {a c : ColAddr} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hc : phaseCol S.sd S.rd i a = some c) :
    parents S.B c = (parents S.A a).map (shiftVal S.sd.r (phaseOff S.sd i a * S.d)) := by
  by_cases haq : isQMat S.sd a = true
  · have hroute : ¬ OnHoleRoute S.sd a := fun h => by
      have := isQMat_of_short_G3 S.sd h.length_le
      rw [haq] at this
      cases this
    have hB := colAt_phaseCol S.inL S.kind S.hsd S.hrd S.out hi ha hroute hc
    simp only [parents, hB]
    cases S.A.colAt a with
    | none => simp
    | some col => simp [mapCol_eq_map_G3, OrdData_G3.d]
  · have haq' : isQMat S.sd a = false := by simpa using haq
    have hφ : phaseOff S.sd i a = i := by simp [phaseOff, haq']
    obtain ⟨Z, hZ⟩ := colAt_copyCol_G3 S (h := i) hi.2 ha haq'
    have hcopy : S.copyCol i a = c := by
      simp only [OrdData_G3.copyCol, if_neg (show i ≠ 0 by omega), hc, Option.getD_some]
    rw [hcopy] at hZ
    have hctx : parents (context S.A S.sd Z) a = parents S.A a := by
      cases hce : a.container S.sd.col with
      | none =>
        simp only [parents]
        rw [colAt_context_of_not_route_G3 S.hsd Z ha.1 ha.2.1 (sdcol_container_none_G3 S ha.1 haq') hce]
      | some e => exact (colAt_context_onStack_G3 S.hsd Z (onStack_of_container_G3 hce)).1
    rw [hφ, ← hctx]
    simp only [parents, hZ]
    cases (context S.A S.sd Z).colAt a with
    | none => simp
    | some col => simp [mapCol_eq_map_G3]

-- G9.7 (T3.8lm, list form): a query `κ_φ W` that is low at `s_φ` is low at every head
-- `s_1, …, s_φ`
theorem low_all_heads_G3 (S : OrdData_G3) {φ : Nat} (hφ : 1 ≤ φ) (W : List Key)
    (hlow : kappaQ_G3 S.sd.r S.d φ (W.map (↑)) < kappaQ_G3 S.sd.r S.d (φ - 1) S.termZ) {h : Nat}
    (hh : 1 ≤ h ∧ h ≤ φ) :
    kappaQ_G3 S.sd.r S.d φ (W.map (↑)) < kappaQ_G3 S.sd.r S.d (h - 1) S.termZ := by
  obtain ⟨hcol, -, ht, -⟩ := stopData_spec S.hsd
  have hrt : S.sd.r < S.sd.t := (rootData_spec S.hsd S.hrd).2.2.2.2.1
  have htd : S.sd.r + S.d = S.sd.t := by simp only [OrdData_G3.d, period]; omega
  have hcoe : StrictMono (fun x : Key => (x : WithTop Key)) := WithTop.coe_strictMono
  -- the old complete query is `ν(y)`, read in `WithTop Key`
  have hZ : S.termZ = (nu (S.sd.Q.map fun x => relKey (S.sd.r + S.d) x.2)).map (↑) := by
    unfold OrdData_G3.termZ cutQuery
    rw [← nu_map hcoe]
    congr 1
    simp only [actualKeys, hcol, Option.getD_some, List.map_append, ← ht, htd, List.map_map]
    rw [List.take_left' (by simp [OrdData_G3.m])]
    rfl
  obtain ⟨Js, -, hJs⟩ : ∃ Js : List Forest, Js.Sublist (S.sd.Q.map Prod.snd) ∧
      nu (S.sd.Q.map fun x => relKey (S.sd.r + S.d) x.2) = Js.map (relKey (S.sd.r + S.d)) := by
    have hm : (S.sd.Q.map fun x => relKey (S.sd.r + S.d) x.2) =
        (S.sd.Q.map Prod.snd).map (relKey (S.sd.r + S.d)) := by
      rw [List.map_map]; rfl
    have := nu_sublist_G3 (S.sd.Q.map fun x => relKey (S.sd.r + S.d) x.2)
    rw [hm] at this ⊢
    exact List.sublist_map_iff.mp this
  have hmap : ∀ j (l : List Key),
      kappaQ_G3 S.sd.r S.d j (l.map (↑)) = (l.map (kappa S.sd.r S.d j)).map (↑) := by
    intro j l; unfold kappaQ_G3; rw [List.map_map, List.map_map]; rfl
  rw [hZ, hJs, hmap, hmap] at hlow ⊢
  rw [list_map_lt_iff (hcoe.strictMonoOn Set.univ) (fun _ _ => trivial) (fun _ _ => trivial)]
    at hlow ⊢
  exact (sign_indep_list_G3 (by omega) (by omega) W Js).mp hlow

/-- D-G010.1 (txt:531-541, "cap all strict active ancestors"): the key system of `E` capped at
the active containers of `c`: in a column `o` whose entry `e` contains `c`, key `e.idx` becomes `⊤`
and the later keys are dropped; every other column keeps its actual keys. -/
def activeKeys_D7_G3 (E : Forest) (c : ColAddr) : KeySys := fun o =>
  match o.container c with
  | some e => (actualKeys E o).take e.idx ++ [⊤]
  | none => actualKeys E o

/-- D-G010.3: `(a, c, φ)` is a phase pair of layer `j`: a template column with its phase copy
(`φ = phaseOff j a`), or the stopping column with the head of layer `j` (`φ = j − 1`). -/
def PhasePair_D7_G3 (S : OrdData_G3) (j : Nat) (a c : ColAddr) (φ : Nat) : Prop :=
  (IsTmplCol S.A S.sd S.rd a ∧ phaseCol S.sd S.rd j a = some c ∧ φ = phaseOff S.sd j a) ∨
    (a = S.sd.col ∧ phaseCol S.sd S.rd j S.rd.col = some c ∧ φ = j - 1)

-- L-G010.21b (D7): cut queries of actual keys are `⊤`-free
theorem ne_top_of_mem_cutQuery_D7_G3 (E : Forest) (o : ColAddr) (k : Nat) :
    ∀ w ∈ cutQuery (actualKeys E o) k, w ≠ ⊤ := by
  intro w hw
  have h1 := (nu_sublist_G3 _).subset hw
  have h2 := List.mem_of_mem_take h1
  simp only [actualKeys, List.mem_map] at h2
  obtain ⟨x, -, rfl⟩ := h2
  exact WithTop.coe_ne_top

-- D7 (route helper): the containers of a route column are route columns
theorem container_mem_routeCols_D7_G3 {E : Forest} {c o : ColAddr} {e : EntryAddr}
    (hc : c ∈ routeCols E) (he : o.container c = some e) : o ∈ routeCols E := by
  obtain ⟨hr, -, -, -⟩ := (Scan.mem_routeCols_iff E c).mp hc
  obtain ⟨hecol, t, ht⟩ := (ColAddr.container_spec _ _ _).mp he
  rw [EntryAddr.heightPath, hecol, List.append_assoc] at ht
  have hlt : o.path.length < c.path.length := by
    have := congrArg List.length ht; simp at this; omega
  refine (Scan.mem_routeCols_iff E o).mpr ⟨fun d hd => ?_, ?_⟩
  · obtain ⟨F, hF, hl⟩ := hr d (by omega)
    refine ⟨F, ?_, ?_⟩
    · rw [← ht, List.take_append_of_le_length (by omega)] at hF; exact hF
    · rw [hl, ← ht, List.getElem?_append_left hd]
  · obtain ⟨F, hF, hl⟩ := hr o.path.length hlt
    rw [← ht, List.take_left] at hF
    rw [← ht, List.getElem?_append_right le_rfl, Nat.sub_self] at hl
    obtain ⟨col, -, -, -, -, hs, -⟩ := Scan.lastStep?_eq_some hl
    simp only [List.cons_append, List.getElem?_cons_zero] at hl
    simp only [Prod.mk.injEq] at hs
    refine ⟨F, hF, ?_⟩
    have : F.cols ≠ [] := by
      intro h0
      simp [Tree.lastStep?, h0] at hl
    have := List.length_pos_of_ne_nil this
    omega

-- L-G010.21a (D7): a `⊤`-free query never passes a source key `⊤`
theorem cursor_append_top_D7_G3 :
    ∀ (W : List (WithTop Key)) (l : List (WithTop Key)), (∀ w ∈ W, w ≠ ⊤) →
      cursor (l ++ [⊤]) W ≤ l.length
  | [], l, _ => by cases l <;> simp [cursor]
  | y :: ys, l, hT => by
    have hy : y < ⊤ := lt_top_iff_ne_top.mpr (hT y (by simp))
    have hys : ∀ w ∈ ys, w ≠ ⊤ := fun w hw => hT w (by simp [hw])
    induction l with
    | nil =>
      rw [List.nil_append, cursor, if_neg (not_lt.mpr hy.le), if_neg (ne_of_gt hy)]
      exact cursor_append_top_D7_G3 ys [] hys
    | cons x xs ih =>
      rw [List.cons_append, cursor]
      split_ifs with h1 h2
      · simp only [List.length_cons]; omega
      · have := cursor_append_top_D7_G3 ys xs hys
        simp only [List.length_cons]; omega
      · have := cursor_append_top_D7_G3 ys (x :: xs) hys
        simpa using this

-- L-G010.17 (D7): the query part of a head is the phase-`(i−1)` copy of the old terminal's
theorem headQuery_prefix_D7_G3 (S : OrdData_G3) {i : Nat} {c : ColAddr} (hi : 1 ≤ i ∧ i ≤ S.n)
    (hc : phaseCol S.sd S.rd i S.rd.col = some c) :
    S.m ≤ (parents S.B c).length ∧
      (parents S.B c).take S.m =
        ((parents S.A S.sd.col).take S.m).map (shiftVal S.sd.r ((i - 1) * S.d)) ∧
      (actualKeys S.B c).take S.m =
        kappaQ_G3 S.sd.r S.d (i - 1) ((actualKeys S.A S.sd.col).take S.m) := by
  obtain ⟨hcol, -, ht, -⟩ := stopData_spec S.hsd
  obtain ⟨-, -, -, hrnum, hrt, -⟩ := rootData_spec S.hsd S.hrd
  obtain ⟨col, hBcol, hlen, htake, -⟩ := colAt_head S.inL S.kind S.hsd S.hrd S.out hi hc
  have hm : S.sd.Q.length = S.m := rfl
  have hnum := num_phaseCol S.inL S.kind S.hsd S.hrd (Or.inl rfl) hi.1 hc
  rw [hrnum] at hnum
  simp only [phaseOff, isQMat_rdcol_G3 S, Bool.false_eq_true, if_false] at hnum
  have hBpar : parents S.B c = col.map Prod.fst := by simp [parents, hBcol]
  refine ⟨by rw [hBpar, List.length_map, hlen]; omega, ?_, ?_⟩
  · rw [hBpar, ← List.map_take, ← hm, htake, mapCol_eq_map_G3]
    simp only [parents, hcol, Option.getD_some, List.map_append, List.map_map]
    rw [List.take_left' (by simp), List.map_map]
    rfl
  · simp only [actualKeys, hBcol, hcol, Option.getD_some, ← List.map_take, ← hm, htake,
      mapCol_eq_map_G3, List.map_map, kappaQ_G3]
    rw [List.take_left' (by simp)]
    congr 1
    funext y
    simp only [Function.comp_apply, WithTop.map_coe]
    rw [hnum, ← ht]
    have : S.sd.r + i * period S.sd = S.sd.t + (i - 1) * S.d := by
      simp only [OrdData_G3.d, period]
      have : i * (S.sd.t - S.sd.r) = (i - 1) * (S.sd.t - S.sd.r) + (S.sd.t - S.sd.r) := by
        rw [← Nat.succ_mul]; congr 1; omega
      omega
    rw [this]
    exact congrArg _ (relKey_shift S.sd.r S.d (i - 1) S.sd.t hrt.le y.2)

-- D7: numbers of a phase pair
theorem phasePair_num_D7_G3 (S : OrdData_G3) {j φ : Nat} (hj : 1 ≤ j ∧ j ≤ S.n) {a c : ColAddr}
    (hp : PhasePair_D7_G3 S j a c φ) : S.sd.r < a.num 0 ∧ c.num 0 = a.num 0 + φ * S.d := by
  rcases hp with ⟨ha, hc, rfl⟩ | ⟨rfl, hc, rfl⟩
  · exact ⟨tmplCol_num_gt_G3 S ha, num_phaseCol S.inL S.kind S.hsd S.hrd (Or.inr ha) hj.1 hc⟩
  · obtain ⟨-, -, ht, -⟩ := stopData_spec S.hsd
    obtain ⟨-, -, -, hrnum, hrt, -⟩ := rootData_spec S.hsd S.hrd
    have hnum := num_phaseCol S.inL S.kind S.hsd S.hrd (Or.inl rfl) hj.1 hc
    rw [hrnum] at hnum
    simp only [phaseOff, isQMat_rdcol_G3 S, Bool.false_eq_true, if_false] at hnum
    have hd : S.d = S.sd.t - S.sd.r := rfl
    refine ⟨by omega, ?_⟩
    rw [hnum, ← ht]
    have : j * S.d = (j - 1) * S.d + S.d := by
      rw [← Nat.succ_mul]; congr 1; omega
    simp only [OrdData_G3.d, period] at this ⊢
    omega

-- D7 (helper): the root column is on the stack of both members of a phase pair, below them in
-- path order; the copy is placed under the stopping column
theorem phasePair_root_D7_G3 (S : OrdData_G3) {j φ : Nat} {a c : ColAddr}
    (hp : PhasePair_D7_G3 S j a c φ) :
    a.resolve 0 S.sd.r = some S.rd.col ∧ c.resolve 0 S.sd.r = some S.rd.col ∧
      S.rd.col.path <+: a.path ∧ ∃ b, c = underCol S.sd.col b := by
  obtain ⟨hres, hrnum, -, hpre, -⟩ := rootData_path S.hsd S.hrd
  obtain ⟨-, -, ht, -⟩ := stopData_spec S.hsd
  obtain ⟨-, -, -, -, hrt, -⟩ := rootData_spec S.hsd S.hrd
  have hsdR : S.sd.col.OnStack S.rd.col := ((ColAddr.resolve_spec 0 _ _ _).mp hres).1
  obtain ⟨b, hb⟩ : ∃ b, c = underCol S.sd.col b := by
    rcases hp with ⟨-, hc, -⟩ | ⟨-, hc, -⟩
    · unfold phaseCol at hc; obtain ⟨a', -, ha'⟩ := Option.map_eq_some_iff.mp hc; exact ⟨_, ha'.symm⟩
    · unfold phaseCol at hc; obtain ⟨a', -, ha'⟩ := Option.map_eq_some_iff.mp hc; exact ⟨_, ha'.symm⟩
  have hcR : c.resolve 0 S.sd.r = some S.rd.col := by
    rw [hb]
    exact (ColAddr.resolve_spec 0 _ _ _).mpr ⟨(onStack_underCol_G3 _ _ _).mpr (Or.inl hsdR), hrnum⟩
  refine ⟨?_, hcR, ?_, b, hb⟩
  · rcases hp with ⟨ha, -, -⟩ | ⟨rfl, -, -⟩
    · by_cases haq : isQMat S.sd a = true
      · obtain ⟨q, rest, hq, -⟩ := isQMat_spec_G3 S.sd haq
        have hsa : a.OnStack S.sd.col := by
          refine onStack_of_container_G3 (e := ⟨S.sd.col, q⟩) ?_
          rw [ColAddr.container_spec]
          exact ⟨rfl, rest, by simp [EntryAddr.heightPath, hq]⟩
        have := (ColAddr.onStack_iff_of_onStack 0 hsa (by rw [hrnum, ← ht]; exact hrt)).mp hsdR
        exact (ColAddr.resolve_spec 0 _ _ _).mpr ⟨this, hrnum⟩
      · obtain ⟨a', ha'⟩ := Option.isSome_iff_exists.mp ha.2.2.2
        exact (ColAddr.resolve_spec 0 _ _ _).mpr
          ⟨onStack_rdcol_G3 S ha' (by simpa using haq) ha.2.2.1, hrnum⟩
    · exact hres
  · rcases hp with ⟨ha, -, -⟩ | ⟨rfl, -, -⟩
    · by_cases haq : isQMat S.sd a = true
      · obtain ⟨q, rest, hq, -⟩ := isQMat_spec_G3 S.sd haq
        rw [hq]; exact hpre.trans (List.prefix_append _ _)
      · obtain ⟨a', ha'⟩ := Option.isSome_iff_exists.mp ha.2.2.2
        obtain ⟨suf, hsuf, -⟩ := kerCol_tail_spec_G3 S ha' (by simpa using haq)
        rw [hsuf]; exact List.prefix_append _ _
    · exact hpre

-- D7 (helper): keys normalized at or below `r`, capped or not, are `κ`-fixed
theorem kappaQ_fix_D7_G3 (r d φ : Nat) (E : Forest) {o : ColAddr} (ho : o.num 0 ≤ r) :
    kappaQ_G3 r d φ (actualKeys E o) = actualKeys E o ∧
      ∀ v, kappaQ_G3 r d φ ((actualKeys E o).take v ++ [⊤]) = (actualKeys E o).take v ++ [⊤] := by
  have h1 : kappaQ_G3 r d φ (actualKeys E o) = actualKeys E o := by
    unfold kappaQ_G3 actualKeys
    rw [List.map_map]
    congr 1
    funext x
    simp only [Function.comp_apply, WithTop.map_coe, kappa_fix r d φ _ ho]
  refine ⟨h1, fun v => ?_⟩
  unfold kappaQ_G3 at h1 ⊢
  rw [List.map_append, List.map_take, h1]
  rfl

-- L-G010.4, fixed region (D7; L-G010.4c): below `r` both stacks are the root's, and the
-- decorated responses agree
theorem respEdge_fixed_D7_G3 (S : OrdData_G3) {j φ : Nat} {a c : ColAddr}
    (hp : PhasePair_D7_G3 S j a c φ) {W : List (WithTop Key)} (_hT : ∀ w ∈ W, w ≠ ⊤) {x : Nat}
    (hx : x < S.sd.r) :
    respEdge S.B (activeKeys_D7_G3 S.B c) c (kappaQ_G3 S.sd.r S.d φ W) x =
      respEdge S.A (activeKeys_D7_G3 S.A a) a W x := by
  obtain ⟨hRa, hRc, hpa, b, hb⟩ := phasePair_root_D7_G3 S hp
  obtain ⟨hres, hrnum, -, hpre, -⟩ := rootData_path S.hsd S.hrd
  have hpc : S.rd.col.path <+: c.path := by
    rw [hb]
    refine hpre.trans ?_
    obtain ⟨bp, bc⟩ := b
    cases bp with
    | nil => exact List.prefix_refl _
    | cons y ys => obtain ⟨y1, y2⟩ := y; exact List.prefix_append _ _
  unfold respEdge
  rw [← ColAddr.resolve_of_resolve_lt hRc hx, ← ColAddr.resolve_of_resolve_lt hRa hx]
  cases ho : S.rd.col.resolve 0 x with
  | none => rfl
  | some o =>
    simp only [Option.bind_some]
    have hon : o.num 0 = x := ColAddr.resolve_num ho
    have hsdo : S.sd.col.OnStack o := by
      have := ColAddr.resolve_of_resolve_lt hres hx
      rw [ho] at this
      exact ((ColAddr.resolve_spec 0 _ _ _).mp this.symm).1
    -- the containers at `o` of `a`, `c` and the stopping column are those of the root
    have hcont : ∀ X : ColAddr, X.resolve 0 S.sd.r = some S.rd.col → S.rd.col.path <+: X.path →
        o.container X = o.container S.rd.col := by
      intro X hX hpX
      apply Option.ext; intro e
      rw [ColAddr.container_spec, ColAddr.container_spec]
      constructor
      · rintro ⟨h1, h2⟩
        exact ⟨h1, EntryAddr.contains_of_resolve h2 hX (by rw [h1]; omega)⟩
      · rintro ⟨h1, h2⟩; exact ⟨h1, h2.trans hpX⟩
    have hca := hcont a hRa hpa
    have hcc := hcont c hRc hpc
    have hcs := hcont S.sd.col hres hpre
    -- the column of `o` in `B` is its context column
    have hE : S.A ≠ Tree.empty := by
      intro h
      have := S.hsd
      rw [h, stopData_eq_none_of_lastCol (Or.inl rfl)] at this
      cases this
    obtain ⟨Z, hB⟩ : ∃ Z, S.B = context S.A S.sd Z := by
      have := expand_eq_iterate hE S.inL.1 S.inL.2.1 S.kind S.hsd S.hrd S.kernelDefined S.n
      rw [S.out] at this
      exact ⟨_, Option.some.inj this⟩
    obtain ⟨hpar, htake, hnone⟩ := colAt_context_onStack_G3 S.hsd Z hsdo
    rw [← hB] at hpar htake hnone
    have hfix := kappaQ_fix_D7_G3 S.sd.r S.d φ S.A (o := o) (by omega)
    have hks : activeKeys_D7_G3 S.B c o = activeKeys_D7_G3 S.A a o ∧
        kappaQ_G3 S.sd.r S.d φ (activeKeys_D7_G3 S.A a o) = activeKeys_D7_G3 S.A a o := by
      cases hce : o.container S.rd.col with
      | none =>
        have hBo := hnone (hcs.trans hce)
        refine ⟨?_, ?_⟩
        · simp only [activeKeys_D7_G3, hca, hcc, hce, actualKeys, hBo]
        · simp only [activeKeys_D7_G3, hca, hce]; exact hfix.1
      | some e =>
        have h1 := htake e (hcs.trans hce)
        have h2 : (actualKeys S.B o).take e.idx = (actualKeys S.A o).take e.idx := by
          simp only [actualKeys, ← List.map_take]
          congr 1
          cases hBo : S.B.colAt o with
          | none =>
            cases hAo : S.A.colAt o with
            | none => rfl
            | some _ => rw [hBo, hAo] at h1; cases h1
          | some C1 =>
            cases hAo : S.A.colAt o with
            | none => rw [hBo, hAo] at h1; cases h1
            | some C2 =>
              rw [hBo, hAo] at h1
              simpa using h1
        refine ⟨?_, ?_⟩
        · simp only [activeKeys_D7_G3, hca, hcc, hce, h2]
        · simp only [activeKeys_D7_G3, hca, hce]; exact hfix.2 _
    have hc : cursor (activeKeys_D7_G3 S.A a o) (kappaQ_G3 S.sd.r S.d φ W) =
        cursor (activeKeys_D7_G3 S.A a o) W := by
      have := cursor_map (kappaQry_strictMono_G3 S.sd.r S.d φ) (activeKeys_D7_G3 S.A a o) W
      have h2 := hks.2
      unfold kappaQ_G3 at h2 ⊢
      rw [h2] at this
      exact this
    rw [resp_eq_parents_G3, resp_eq_parents_G3, hks.1, hpar, hc]

-- F7 (helper): parents and actual keys have the same length
theorem length_parents_F7_G3 (E : Forest) (o : ColAddr) :
    (parents E o).length = (actualKeys E o).length := by
  simp [parents, actualKeys]

-- F7 (helper): `κ` maps actual keys to `⊤`-free lists
theorem kappaQ_actual_ne_top_F7_G3 (r d φ : Nat) (E : Forest) (o : ColAddr) :
    ∀ w ∈ kappaQ_G3 r d φ (actualKeys E o), w ≠ ⊤ := by
  intro w hw
  simp only [kappaQ_G3, actualKeys, List.map_map, List.mem_map] at hw
  obtain ⟨x, -, rfl⟩ := hw
  simp

-- L-G010.4 (F7, reduction): a response read through related columns is related, when the key
-- lists are actual or capped at a final `⊤` and the query is `⊤`-free
theorem respEdge_of_rel_F7_G3 {A B : Forest} {ksA ksB : KeySys} {a c o o' : ColAddr}
    {x x' r d φ : Nat} {W : List (WithTop Key)} (hT : ∀ w ∈ W, w ≠ ⊤)
    (ho : a.resolve 0 x = some o) (ho' : c.resolve 0 x' = some o')
    (hks : ksB o' = kappaQ_G3 r d φ (ksA o))
    (hksA : ksA o = actualKeys A o ∨ ∃ l, ksA o = l ++ [⊤])
    (hksB : ksB o' = actualKeys B o' ∨ ∃ l, ksB o' = l ++ [⊤])
    (hpar : ∀ v, v < (ksA o).length →
      (parents B o')[v]? = ((parents A o)[v]?).map (shiftVal r (φ * d))) :
    respEdge B ksB c (kappaQ_G3 r d φ W) x' = (respEdge A ksA a W x).map (shiftVal r (φ * d)) := by
  unfold respEdge
  rw [ho, ho']
  simp only [Option.bind_some]
  rw [resp_eq_parents_G3, resp_eq_parents_G3, hks]
  have hcur : cursor (kappaQ_G3 r d φ (ksA o)) (kappaQ_G3 r d φ W) = cursor (ksA o) W :=
    cursor_map (kappaQry_strictMono_G3 r d φ) _ _
  rw [hcur]
  by_cases hlt : cursor (ksA o) W < (ksA o).length
  · exact hpar _ hlt
  · have hle := cursor_le_length (ksA o) W
    have heq : cursor (ksA o) W = (ksA o).length := by omega
    rcases hksA with hA | ⟨l, hl⟩
    · have hA1 : (parents A o)[cursor (ksA o) W]? = none := by
        rw [List.getElem?_eq_none]; rw [heq, hA, length_parents_F7_G3]
      rcases hksB with hB | ⟨l', hl'⟩
      · have hB1 : (parents B o')[cursor (ksA o) W]? = none := by
          rw [List.getElem?_eq_none]
          rw [heq, length_parents_F7_G3, ← hB, hks]
          simp [kappaQ_G3]
        rw [hA1, hB1]; rfl
      · exfalso
        have hmem : (⊤ : WithTop Key) ∈ kappaQ_G3 r d φ (ksA o) := by
          rw [← hks, hl']; simp
        rw [hA] at hmem
        exact kappaQ_actual_ne_top_F7_G3 r d φ A o _ hmem rfl
    · exfalso
      have := cursor_append_top_D7_G3 W l hT
      rw [← hl] at this
      have h2 : (ksA o).length = l.length + 1 := by rw [hl]; simp
      omega

-- L-G010.4b (F7, assembly): related containers and related contents before the active entry give
-- related active key systems and related parents
theorem activeKeys_rel_F7_G3 {A B : Forest} {a c o o' : ColAddr} {r d φ : Nat}
    (hcont : o'.container c = (o.container a).map (fun e => ⟨o', e.idx⟩))
    (hkeys : ∀ u, (∀ e, o.container a = some e → u ≤ e.idx) →
      (actualKeys B o').take u = kappaQ_G3 r d φ ((actualKeys A o).take u))
    (hpar : ∀ v, (∀ e, o.container a = some e → v ≤ e.idx) →
      (parents B o')[v]? = ((parents A o)[v]?).map (shiftVal r (φ * d))) :
    activeKeys_D7_G3 B c o' = kappaQ_G3 r d φ (activeKeys_D7_G3 A a o) ∧
      (activeKeys_D7_G3 A a o = actualKeys A o ∨ ∃ l, activeKeys_D7_G3 A a o = l ++ [⊤]) ∧
      (activeKeys_D7_G3 B c o' = actualKeys B o' ∨ ∃ l, activeKeys_D7_G3 B c o' = l ++ [⊤]) ∧
      ∀ v, v < (activeKeys_D7_G3 A a o).length →
        (parents B o')[v]? = ((parents A o)[v]?).map (shiftVal r (φ * d)) := by
  cases hca : o.container a with
  | none =>
    rw [hca, Option.map_none] at hcont
    have hu : ∀ e, o.container a = some e → (actualKeys A o).length + (actualKeys B o').length ≤ e.idx := by
      intro e he; rw [hca] at he; cases he
    have hk := hkeys _ hu
    rw [List.take_of_length_le (by omega), List.take_of_length_le (by omega)] at hk
    simp only [activeKeys_D7_G3, hca, hcont]
    refine ⟨hk, Or.inl trivial, Or.inl trivial, fun v _ => hpar v ?_⟩
    intro e he; rw [hca] at he; cases he
  | some e =>
    rw [hca, Option.map_some] at hcont
    have hk := hkeys e.idx (fun e' he' => by rw [hca] at he'; cases he'; exact le_rfl)
    simp only [activeKeys_D7_G3, hca, hcont]
    refine ⟨?_, Or.inr ⟨_, rfl⟩, Or.inr ⟨_, rfl⟩, fun v hv => hpar v ?_⟩
    · rw [hk]; simp [kappaQ_G3]
    · intro e' he'
      rw [hca] at he'
      cases he'
      simp only [List.length_append, List.length_take, List.length_singleton] at hv
      omega

-- F7 (helper): the number of a phase-`h` copy of a non-Q template column
theorem num_copyCol_F7_G3 (S : OrdData_G3) {h : Nat} {o : ColAddr} (ho : IsTmplCol S.A S.sd S.rd o)
    (hoq : isQMat S.sd o = false) : (S.copyCol h o).num 0 = o.num 0 + h * S.d := by
  rcases Nat.eq_zero_or_pos h with rfl | hpos
  · simp [OrdData_G3.copyCol]
  · obtain ⟨o', ho'⟩ : ∃ o', phaseCol S.sd S.rd h o = some o' := by
      obtain ⟨b, hb⟩ := Option.isSome_iff_exists.mp ho.2.2.2
      exact ⟨_, by unfold phaseCol; rw [hb]; rfl⟩
    have := num_phaseCol S.inL S.kind S.hsd S.hrd (Or.inr ho) hpos ho'
    simp only [OrdData_G3.copyCol, if_neg (show h ≠ 0 by omega), ho', Option.getD_some, this,
      phaseOff, hoq, Bool.false_eq_true, if_false, OrdData_G3.d]

-- L-G010.4b (F7, contents of non-Q copies): the phase-`h` copy of a non-Q template column has
-- the shifted parents, and its keys are `κ_h`-images before the entry containing the stopping
-- column (all keys if it contains none)
theorem copyCol_content_F7_G3 (S : OrdData_G3) {h : Nat} (hh : h ≤ S.n) {o : ColAddr}
    (ho : IsTmplCol S.A S.sd S.rd o) (hoq : isQMat S.sd o = false) :
    parents S.B (S.copyCol h o) = (parents S.A o).map (shiftVal S.sd.r (h * S.d)) ∧
    ∀ u, (∀ e, o.container S.sd.col = some e → u ≤ e.idx) →
      (actualKeys S.B (S.copyCol h o)).take u =
        kappaQ_G3 S.sd.r S.d h ((actualKeys S.A o).take u) := by
  obtain ⟨Z, hBcol⟩ := colAt_copyCol_G3 S hh ho hoq
  have hnum := num_copyCol_F7_G3 S (h := h) ho hoq
  have hro := tmplCol_num_gt_G3 S ho
  set C := ((context S.A S.sd Z).colAt o).getD [] with hC
  have hBget : (S.B.colAt (S.copyCol h o)).getD [] = Tree.mapCol (shiftVal S.sd.r (h * S.d)) C := by
    rw [hBcol, hC]
    cases (context S.A S.sd Z).colAt o <;> simp [Tree.mapCol]
  have hBkeys : actualKeys S.B (S.copyCol h o) =
      kappaQ_G3 S.sd.r S.d h (actualKeys (context S.A S.sd Z) o) := by
    simp only [actualKeys, hBget, mapCol_eq_map_G3, List.map_map, kappaQ_G3, ← hC]
    congr 1
    funext y
    simp only [Function.comp_apply, WithTop.map_coe]
    rw [hnum]
    exact congrArg _ (relKey_shift S.sd.r S.d h (o.num 0) (by omega) y.2)
  have hBpar : parents S.B (S.copyCol h o) =
      (parents (context S.A S.sd Z) o).map (shiftVal S.sd.r (h * S.d)) := by
    simp only [parents, hBget, mapCol_eq_map_G3, List.map_map, ← hC]
    rfl
  cases hce : o.container S.sd.col with
  | none =>
    have hctx := colAt_context_of_not_route_G3 S.hsd Z ho.1 ho.2.1
      (sdcol_container_none_G3 S ho.1 hoq) hce
    refine ⟨by rw [hBpar]; simp only [parents, hctx], fun u _ => ?_⟩
    rw [hBkeys]
    unfold kappaQ_G3
    rw [List.map_take]
    simp only [actualKeys, hctx]
  | some e =>
    obtain ⟨hcpar, hctake, -⟩ := colAt_context_onStack_G3 S.hsd Z (onStack_of_container_G3 hce)
    refine ⟨by rw [hBpar, hcpar], fun u hu => ?_⟩
    have hue := hu e rfl
    rw [hBkeys]
    unfold kappaQ_G3
    rw [← List.map_take]
    congr 1
    have := hctake e hce
    have e1 : (actualKeys (context S.A S.sd Z) o).take u =
        ((actualKeys (context S.A S.sd Z) o).take e.idx).take u := by
      rw [List.take_take, Nat.min_eq_left hue]
    have e2 : (actualKeys S.A o).take u = ((actualKeys S.A o).take e.idx).take u := by
      rw [List.take_take, Nat.min_eq_left hue]
    rw [e1, e2]
    congr 1
    simp only [actualKeys, ← List.map_take]
    congr 1
    cases h1 : (context S.A S.sd Z).colAt o with
    | none =>
      rw [h1] at this
      cases h2 : S.A.colAt o with
      | none => rfl
      | some _ => rw [h2] at this; cases this
    | some C1 =>
      rw [h1] at this
      cases h2 : S.A.colAt o with
      | none => rw [h2] at this; cases this
      | some C2 =>
        rw [h2] at this
        simpa using this

-- L-G010.4b (F7, contents of closed copies): off the hole route a phase copy is a pure copy
theorem phaseCol_content_closed_F7_G3 (S : OrdData_G3) {h : Nat} (hh : 1 ≤ h ∧ h ≤ S.n)
    {o o' : ColAddr} (ho : IsTmplCol S.A S.sd S.rd o) (hroute : ¬ OnHoleRoute S.sd o)
    (ho' : phaseCol S.sd S.rd h o = some o') :
    parents S.B o' = (parents S.A o).map (shiftVal S.sd.r (phaseOff S.sd h o * S.d)) ∧
      actualKeys S.B o' = kappaQ_G3 S.sd.r S.d (phaseOff S.sd h o) (actualKeys S.A o) := by
  have hB := colAt_phaseCol S.inL S.kind S.hsd S.hrd S.out hh ho hroute ho'
  have hnum := num_phaseCol S.inL S.kind S.hsd S.hrd (Or.inr ho) hh.1 ho'
  have hro := tmplCol_num_gt_G3 S ho
  have hBget : (S.B.colAt o').getD [] =
      Tree.mapCol (shiftVal S.sd.r (phaseOff S.sd h o * S.d)) ((S.A.colAt o).getD []) := by
    rw [hB]
    cases S.A.colAt o <;> simp [Tree.mapCol, OrdData_G3.d]
  refine ⟨?_, ?_⟩
  · simp only [parents, hBget, mapCol_eq_map_G3, List.map_map]
    rfl
  · simp only [actualKeys, hBget, mapCol_eq_map_G3, List.map_map, kappaQ_G3]
    congr 1
    funext y
    simp only [Function.comp_apply, WithTop.map_coe]
    rw [hnum]
    exact congrArg _ (relKey_shift S.sd.r S.d _ (o.num 0) (by omega) y.2)

-- G9.4b generalized (F7): for every placed address `c` of layer `i` and every phase `h < i`, the
-- phase-`h` copies of the stopping column's stack columns between `r` and `t` are on the stack of
-- `c` at numbers `x + h d`, and they contain `c` exactly when the old columns contain the stopping
-- column, through the same entry
theorem resolve_copyCol_gen_F7_G3 (S : OrdData_G3) {i : Nat} {b₀ c kh : ColAddr}
    (hkh : kerCol S.sd S.rd S.sd.col = some kh)
    (hcdef : c = underCol S.sd.col ((underCol kh)^[i - 1] b₀)) {h : Nat} (hh : h < i)
    {x : Nat} {o : ColAddr} (hx : S.sd.r < x) (ho : S.sd.col.resolve 0 x = some o) :
    c.resolve 0 (x + h * S.d) = some (S.copyCol h o) ∧
      (S.copyCol h o).container c =
        (o.container S.sd.col).map (fun e => ⟨S.copyCol h o, e.idx⟩) := by
  obtain ⟨hst, hnum⟩ := (ColAddr.resolve_spec 0 _ _ _).mp ho
  obtain ⟨-, -, ht, -⟩ := stopData_spec S.hsd
  obtain ⟨-, -, -, hrnum, hrt, -⟩ := rootData_spec S.hsd S.hrd
  have hsdq : isQMat S.sd S.sd.col = false := isQMat_of_short_G3 S.sd le_rfl
  obtain ⟨hoker, hoq⟩ := kerCol_of_onStack_tail_G3 S hkh hsdq hst (by omega)
  obtain ⟨o', ho'⟩ := Option.isSome_iff_exists.mp hoker
  have hne : o ≠ S.rd.col := by
    intro h; rw [h] at hnum; omega
  have hsplit : 0 < h → (underCol kh)^[i - 1] b₀ =
      (underCol kh)^[h - 1] ((underCol kh)^[i - h] b₀) := by
    intro hpos
    rw [← Function.iterate_add_apply]
    congr 1
    omega
  obtain ⟨j, hj⟩ : ∃ j, i - h = j + 1 := ⟨i - h - 1, by omega⟩
  have hkho' : kh.OnStack o' :=
    (onStack_kerCol_tail_G3 S hkh hsdq o').mpr ⟨o, hst, by omega, hoq, ho'⟩
  have hcopy : 0 < h → S.copyCol h o = underCol S.sd.col ((underCol kh)^[h - 1] o') := by
    intro hpos
    simp only [OrdData_G3.copyCol, if_neg (show h ≠ 0 by omega)]
    rw [phaseCol_eq_iterate_G3 S hkh ho']
    rfl
  refine ⟨?_, ?_⟩
  · -- resolution
    rw [ColAddr.resolve_spec]
    rcases Nat.eq_zero_or_pos h with h0 | hpos
    · subst h0
      simp only [OrdData_G3.copyCol, if_true, Nat.zero_mul, Nat.add_zero]
      exact ⟨by rw [hcdef]; exact (onStack_underCol_G3 _ _ _).mpr (Or.inl hst), hnum⟩
    · have hZ : ((underCol kh)^[i - h] b₀).OnStack o' := by
        rw [hj, Function.iterate_succ_apply']
        exact (onStack_underCol_G3 kh _ _).mpr (Or.inl hkho')
      rw [hcopy hpos]
      refine ⟨?_, ?_⟩
      · rw [hcdef, hsplit hpos]
        exact (onStack_underCol_G3 _ _ _).mpr
          (Or.inr ⟨_, iterate_underCol_onStack_G3 kh (h - 1) hZ, rfl⟩)
      · have h1 := num_kerCol_tail_G3 S hkh hsdq
        have h2 := num_kerCol_tail_G3 S ho' hoq
        rw [num_underCol_G3, num_iterate_underCol_G3]
        simp only [OrdData_G3.d, period]
        rw [← ht] at h1
        have : (h - 1) * kh.num 0 + kh.num 0 = h * kh.num 0 := by
          rw [← Nat.succ_mul]; congr 1; omega
        have hd : kh.num 0 = S.sd.t - S.sd.r := by omega
        rw [← hd]
        omega
  · -- containment
    rcases Nat.eq_zero_or_pos h with h0 | hpos
    · subst h0
      simp only [OrdData_G3.copyCol, if_true]
      rw [hcdef, container_underCol_of_onStack_G3 hst]
      cases hce : o.container S.sd.col with
      | none => rfl
      | some e =>
        simp only [Option.map_some, Option.some.injEq]
        rw [← container_col_G3 hce]
    · rw [hcopy hpos, hcdef, hsplit hpos, container_underCol_G3, iterate_underCol_container_G3, hj,
        Function.iterate_succ_apply', container_underCol_of_onStack_G3 hkho',
        container_kerCol_G3 S hkh ho' hsdq]
      simp only [if_neg hne, Option.map_map]
      rfl

-- F7 (helper): a stack column of a column of `A` that contains the stopping column contains the
-- column too, at an entry no later than the stopping column's
theorem container_le_sdcol_F7_G3 (S : OrdData_G3) {a o : ColAddr} (ha : a ∈ S.A.colAddrs) {x : Nat}
    (ho : a.resolve 0 x = some o) {e' : EntryAddr} (he' : o.container S.sd.col = some e') :
    ∃ e, o.container a = some e ∧ e.idx ≤ e'.idx := by
  obtain ⟨-, -, -, hroute, -⟩ := stopData_spec S.hsd
  have hor : o ∈ routeCols S.A := container_mem_routeCols_D7_G3 hroute he'
  obtain ⟨v, hv, hcv⟩ := routeCols_visible ha hor ho
  refine ⟨⟨o, v⟩, (ColAddr.container_spec _ _ _).mpr ⟨rfl, hcv⟩, ?_⟩
  have hlast := container_sdcol_last_G3 S he'
  have hent := (Tree.mem_entryAddrs_iff _ _).mp hv
  unfold Tree.entryAt at hent
  have hvlt : v < (parents S.A o).length := by
    simp only [parents, List.length_map]
    cases hc : S.A.colAt o with
    | none => rw [hc] at hent; cases hent
    | some col =>
      rw [hc] at hent
      simp only [Option.bind_some, Option.getD_some] at hent ⊢
      exact (List.getElem?_eq_some_iff.mp (Option.get_mem hent)).1
  show v ≤ e'.idx
  omega

-- F7 (helper): Q-material is the placement of its kernel image under the stopping column
theorem qmat_underCol_F7_G3 (S : OrdData_G3) {a a₀ : ColAddr} (haq : isQMat S.sd a = true)
    (ha₀ : kerCol S.sd S.rd a = some a₀) : a = underCol S.sd.col a₀ := by
  obtain ⟨q, rest, hp, -⟩ := isQMat_spec_G3 S.sd haq
  rw [kerCol_qmat_G3 S haq hp, Option.some.injEq] at ha₀
  subst ha₀
  show (⟨a.path, a.col⟩ : ColAddr) = _
  simp [underCol, hp]

-- L-G010.4b (F7, the stopping column's stack): for a placed address `c` of layer `j`, the
-- phase-`(j−1)` copies of the stopping column's stack columns above `r` are related to them
theorem phase_stack_sd_F7_G3 (S : OrdData_G3) {j : Nat} (hj : 1 ≤ j ∧ j ≤ S.n) {a b₀ c kh : ColAddr}
    (hkh : kerCol S.sd S.rd S.sd.col = some kh)
    (hcdef : c = underCol S.sd.col ((underCol kh)^[j - 1] b₀)) {x : Nat} (hx : S.sd.r < x)
    {o : ColAddr} (ho : S.sd.col.resolve 0 x = some o)
    (hca : o.container a = o.container S.sd.col) :
    ∃ o', c.resolve 0 (x + (j - 1) * S.d) = some o' ∧
      o'.container c = (o.container a).map (fun e => ⟨o', e.idx⟩) ∧
      (∀ u, (∀ e, o.container a = some e → u ≤ e.idx) →
        (actualKeys S.B o').take u = kappaQ_G3 S.sd.r S.d (j - 1) ((actualKeys S.A o).take u)) ∧
      (∀ v, (∀ e, o.container a = some e → v ≤ e.idx) →
        (parents S.B o')[v]? = ((parents S.A o)[v]?).map (shiftVal S.sd.r ((j - 1) * S.d))) := by
  obtain ⟨-, -, ht, -⟩ := stopData_spec S.hsd
  have hxt : x < S.sd.t := by rw [ht]; exact ColAddr.resolve_lt ho
  obtain ⟨hres, hcont⟩ := resolve_copyCol_gen_F7_G3 S hkh hcdef (h := j - 1) (by omega) hx ho
  obtain ⟨hot, hoq⟩ := tmplCol_of_sdstack_G3 S hx hxt ho
  obtain ⟨hpar, hkeys⟩ := copyCol_content_F7_G3 S (h := j - 1) (by omega) hot hoq
  refine ⟨_, hres, by rw [hcont, hca], fun u hu => hkeys u (by rw [← hca]; exact hu),
    fun v _ => by rw [hpar, List.getElem?_map]⟩

-- L-G010.4b (F7, root-tail template copies, `φ = j`)
theorem phase_stack_tail_F7_G3 (S : OrdData_G3) {j : Nat} (hj : 1 ≤ j ∧ j ≤ S.n) {a c : ColAddr}
    (ha : IsTmplCol S.A S.sd S.rd a) (haq : isQMat S.sd a = false)
    (hc : phaseCol S.sd S.rd j a = some c) {x : Nat} (hx : S.sd.r < x) {o : ColAddr}
    (ho : a.resolve 0 x = some o) :
    ∃ o', c.resolve 0 (x + j * S.d) = some o' ∧
      o'.container c = (o.container a).map (fun e => ⟨o', e.idx⟩) ∧
      (∀ u, (∀ e, o.container a = some e → u ≤ e.idx) →
        (actualKeys S.B o').take u = kappaQ_G3 S.sd.r S.d j ((actualKeys S.A o).take u)) ∧
      (∀ v, (∀ e, o.container a = some e → v ≤ e.idx) →
        (parents S.B o')[v]? = ((parents S.A o)[v]?).map (shiftVal S.sd.r (j * S.d))) := by
  obtain ⟨hst, hnum⟩ := (ColAddr.resolve_spec 0 _ _ _).mp ho
  obtain ⟨-, -, -, hrnum, -⟩ := rootData_spec S.hsd S.hrd
  obtain ⟨a₀, ha₀⟩ := Option.isSome_iff_exists.mp ha.2.2.2
  obtain ⟨kh, hkh⟩ := kerCol_sdcol_G3 S
  obtain ⟨hoker, hoq⟩ := kerCol_of_onStack_tail_G3 S ha₀ haq hst (by omega)
  obtain ⟨o₀, ho₀⟩ := Option.isSome_iff_exists.mp hoker
  have hne : o ≠ S.rd.col := by intro h; rw [h] at hnum; omega
  have hot : IsTmplCol S.A S.sd S.rd o := by
    refine ⟨mem_colAddrs_of_onStack_G3 ha.1 hst, ?_, hne, hoker⟩
    intro h; rw [h] at hst; exact not_onStack_sdcol_G3 S ha.1 haq hst
  have hcdef : c = underCol S.sd.col ((underCol kh)^[j - 1] a₀) := by
    rw [phaseCol_eq_iterate_G3 S hkh ha₀] at hc
    exact (Option.some.inj hc).symm
  have hcopy : S.copyCol j o = underCol S.sd.col ((underCol kh)^[j - 1] o₀) := by
    simp only [OrdData_G3.copyCol, if_neg (show j ≠ 0 by omega)]
    rw [phaseCol_eq_iterate_G3 S hkh ho₀]
    rfl
  have hst₀ : a₀.OnStack o₀ := onStack_kerCol_tail_mpr_G3 S ha₀ haq hst (by omega) hoq ho₀
  obtain ⟨hpar, hkeys⟩ := copyCol_content_F7_G3 S (h := j) hj.2 hot hoq
  refine ⟨S.copyCol j o, ?_, ?_, fun u hu => hkeys u ?_, fun v _ => ?_⟩
  · rw [ColAddr.resolve_spec]
    refine ⟨?_, by rw [num_copyCol_F7_G3 S hot hoq, hnum]⟩
    rw [hcdef, hcopy]
    exact (onStack_underCol_G3 _ _ _).mpr (Or.inr ⟨_, iterate_underCol_onStack_G3 kh (j - 1) hst₀, rfl⟩)
  · rw [hcopy, hcdef, container_underCol_G3, iterate_underCol_container_G3,
      container_kerCol_G3 S ha₀ ho₀ haq]
    simp only [if_neg hne, Option.map_map]
    rfl
  · intro e' he'
    obtain ⟨e, he, hle⟩ := container_le_sdcol_F7_G3 S ha.1 ho he'
    exact (hu e he).trans hle
  · rw [hpar, List.getElem?_map]

-- F7 (helper): the kernel hole has number `d`
theorem num_kerHole_F7_G3 (S : OrdData_G3) {kh : ColAddr} (hkh : kerCol S.sd S.rd S.sd.col = some kh) :
    kh.num 0 = S.d := by
  obtain ⟨-, -, ht, -⟩ := stopData_spec S.hsd
  have h1 := num_kerCol_tail_G3 S hkh (isQMat_of_short_G3 S.sd le_rfl)
  simp only [OrdData_G3.d, period]
  omega

-- L-G010.4b (F7, Q-material copies, `φ = j − 1`; L-G010.9 at `x = t`)
theorem phase_stack_qmat_F7_G3 (S : OrdData_G3) {j : Nat} (hj : 1 ≤ j ∧ j ≤ S.n) {a c : ColAddr}
    (ha : IsTmplCol S.A S.sd S.rd a) (haq : isQMat S.sd a = true)
    (hc : phaseCol S.sd S.rd j a = some c) {x : Nat} (hx : S.sd.r < x) {o : ColAddr}
    (ho : a.resolve 0 x = some o) :
    ∃ o', c.resolve 0 (x + (j - 1) * S.d) = some o' ∧
      o'.container c = (o.container a).map (fun e => ⟨o', e.idx⟩) ∧
      (∀ u, (∀ e, o.container a = some e → u ≤ e.idx) →
        (actualKeys S.B o').take u = kappaQ_G3 S.sd.r S.d (j - 1) ((actualKeys S.A o).take u)) ∧
      (∀ v, (∀ e, o.container a = some e → v ≤ e.idx) →
        (parents S.B o')[v]? = ((parents S.A o)[v]?).map (shiftVal S.sd.r ((j - 1) * S.d))) := by
  obtain ⟨hst, hnum⟩ := (ColAddr.resolve_spec 0 _ _ _).mp ho
  obtain ⟨-, -, ht, -⟩ := stopData_spec S.hsd
  obtain ⟨-, -, -, hrnum, hrt, -⟩ := rootData_spec S.hsd S.hrd
  obtain ⟨a₀, ha₀⟩ := Option.isSome_iff_exists.mp ha.2.2.2
  obtain ⟨kh, hkh⟩ := kerCol_sdcol_G3 S
  obtain ⟨q, rest, hap, hq⟩ := isQMat_spec_G3 S.sd haq
  have ha₀def : a₀ = ⟨(0, q) :: rest, a.col⟩ := by
    rw [kerCol_qmat_G3 S haq hap] at ha₀; exact (Option.some.inj ha₀).symm
  have haU : a = underCol S.sd.col a₀ := qmat_underCol_F7_G3 S haq ha₀
  have hcdef : c = underCol S.sd.col ((underCol kh)^[j - 1] a₀) := by
    rw [phaseCol_eq_iterate_G3 S hkh ha₀] at hc
    exact (Option.some.inj hc).symm
  have hkhd := num_kerHole_F7_G3 S hkh
  have h0st : a₀.OnStack ⟨[], 0⟩ := by
    rw [ha₀def]; exact Or.inl ⟨0, 0, q, rfl, rfl, le_rfl⟩
  have hsdA : a.OnStack S.sd.col := by
    rw [haU]
    refine (onStack_underCol_G3 _ _ _).mpr (Or.inr ⟨_, h0st, ?_⟩)
    simp [underCol]
  have hresT : a.resolve 0 S.sd.t = some S.sd.col :=
    (ColAddr.resolve_spec 0 _ _ _).mpr ⟨hsdA, ht.symm⟩
  rcases Nat.lt_trichotomy x S.sd.t with hxt | rfl | hxt
  · -- below `t`: the stopping column's stack, copied in phase `j − 1`
    have ho' : S.sd.col.resolve 0 x = some o := by
      rw [ColAddr.resolve_of_resolve_lt hresT hxt]; exact ho
    have hsdo : S.sd.col.OnStack o := ((ColAddr.resolve_spec 0 _ _ _).mp ho').1
    have hca : o.container a = o.container S.sd.col := by
      rw [haU]; exact container_underCol_of_onStack_G3 hsdo a₀
    exact phase_stack_sd_F7_G3 S hj hkh hcdef hx ho' hca
  · -- at `t`: the stopping column, copied to the head of layer `j`
    have hoe : o = S.sd.col := by rw [hresT] at ho; exact (Option.some.inj ho).symm
    subst hoe
    set hd := underCol S.sd.col ((underCol kh)^[j - 1] (⟨[], 0⟩ : ColAddr)) with hhd
    have hhead : phaseCol S.sd S.rd j S.rd.col = some hd := phaseCol_eq_iterate_G3 S hkh (kerCol_rdcol_G3 S)
    have hca : S.sd.col.container a = some ⟨S.sd.col, q⟩ := by
      rw [ColAddr.container_spec]
      exact ⟨rfl, (rest), by simp [EntryAddr.heightPath, hap]⟩
    have h0c : (⟨[], 0⟩ : ColAddr).container a₀ = some ⟨⟨[], 0⟩, q⟩ := by
      rw [ha₀def]; simp [ColAddr.container]
    obtain ⟨-, hparB, hkeyB⟩ := headQuery_prefix_D7_G3 S hj hhead
    refine ⟨hd, ?_, ?_, fun u hu => ?_, fun v hv => ?_⟩
    · rw [ColAddr.resolve_spec]
      refine ⟨?_, ?_⟩
      · rw [hcdef, hhd]
        exact (onStack_underCol_G3 _ _ _).mpr
          (Or.inr ⟨_, iterate_underCol_onStack_G3 kh (j - 1) h0st, rfl⟩)
      · rw [hhd, num_underCol_G3, num_iterate_underCol_G3, hkhd, ← ht]
        simp [ColAddr.num]
    · rw [hca, hhd, hcdef, container_underCol_G3, iterate_underCol_container_G3, h0c]
      rfl
    · have hu' := hu _ hca
      simp only at hu'
      have hum : u ≤ S.m := by simp only [OrdData_G3.m]; omega
      have e1 : (actualKeys S.B hd).take u = ((actualKeys S.B hd).take S.m).take u := by
        rw [List.take_take, Nat.min_eq_left hum]
      have e2 : (actualKeys S.A S.sd.col).take u =
          ((actualKeys S.A S.sd.col).take S.m).take u := by
        rw [List.take_take, Nat.min_eq_left hum]
      rw [e1, e2, hkeyB]
      simp only [kappaQ_G3, List.map_take]
    · have hv' := hv _ hca
      simp only at hv'
      have hvm : v < S.m := by simp only [OrdData_G3.m]; omega
      rw [← List.getElem?_take_of_lt hvm, hparB, List.getElem?_map, List.getElem?_take_of_lt hvm]
  · -- above `t`: Q-material, copied in phase `j − 1`
    rw [haU] at hst
    rcases (onStack_underCol_G3 _ _ _).mp hst with hsdo | ⟨o₁, hst₁, rfl⟩
    · have := ColAddr.num_lt_of_onStack 0 hsdo; omega
    rcases (onStack_kerCol_qmat_G3 S ha₀ haq o₁).mp hst₁ with rfl | ⟨o₂, hst₂, hq₂, ho₂⟩
    · have : underCol S.sd.col ⟨[], 0⟩ = S.sd.col := by simp [underCol]
      rw [this] at hnum; omega
    have hoU : o₂ = underCol S.sd.col o₁ := qmat_underCol_F7_G3 S hq₂ ho₂
    subst hoU
    have hot : IsTmplCol S.A S.sd S.rd (underCol S.sd.col o₁) := by
      refine ⟨mem_colAddrs_of_onStack_G3 ha.1 hst₂, ?_, ?_, by rw [ho₂]; rfl⟩
      · intro h; rw [h] at hnum; omega
      · intro h; rw [h] at hnum; omega
    have hroute : ¬ OnHoleRoute S.sd (underCol S.sd.col o₁) := fun h => by
      have := isQMat_of_short_G3 S.sd h.length_le
      rw [hq₂] at this; cases this
    have hc' := phaseCol_eq_iterate_G3 S hkh (i := j) ho₂
    obtain ⟨hpar, hkeys⟩ := phaseCol_content_closed_F7_G3 S hj hot hroute hc'
    have hφ : phaseOff S.sd j (underCol S.sd.col o₁) = j - 1 := by simp [phaseOff, hq₂]
    rw [hφ] at hpar hkeys
    refine ⟨_, ?_, ?_, fun u _ => by rw [hkeys]; unfold kappaQ_G3; rw [List.map_take],
      fun v _ => by rw [hpar, List.getElem?_map]⟩
    · rw [ColAddr.resolve_spec]
      refine ⟨?_, ?_⟩
      · rw [hcdef]
        exact (onStack_underCol_G3 _ _ _).mpr
          (Or.inr ⟨_, iterate_underCol_onStack_G3 kh (j - 1) hst₁, rfl⟩)
      · rw [← hnum, num_underCol_G3, num_underCol_G3, num_iterate_underCol_G3, hkhd]
        omega
    · rw [hcdef, container_underCol_G3, haU, container_underCol_G3, iterate_underCol_container_G3,
        Option.map_map, Option.map_map]
      rfl

-- L-G010.4b (F7; T3.2i, the three stack correspondences): above `r`, the stack of `a` at `x` and
-- the stack of `c` at `x + φd` hold related columns, with related containers and related contents
-- before the active entry
theorem phase_stack_F7_G3 (S : OrdData_G3) {j φ : Nat} (hj : 1 ≤ j ∧ j ≤ S.n) {a c : ColAddr}
    (hp : PhasePair_D7_G3 S j a c φ) {x : Nat} (hx : S.sd.r < x) {o : ColAddr}
    (ho : a.resolve 0 x = some o) :
    ∃ o', c.resolve 0 (x + φ * S.d) = some o' ∧
      o'.container c = (o.container a).map (fun e => ⟨o', e.idx⟩) ∧
      (∀ u, (∀ e, o.container a = some e → u ≤ e.idx) →
        (actualKeys S.B o').take u = kappaQ_G3 S.sd.r S.d φ ((actualKeys S.A o).take u)) ∧
      (∀ v, (∀ e, o.container a = some e → v ≤ e.idx) →
        (parents S.B o')[v]? = ((parents S.A o)[v]?).map (shiftVal S.sd.r (φ * S.d))) := by
  rcases hp with ⟨ha, hc, rfl⟩ | ⟨rfl, hc, rfl⟩
  · by_cases haq : isQMat S.sd a = true
    · have hφ : phaseOff S.sd j a = j - 1 := by simp [phaseOff, haq]
      rw [hφ]
      exact phase_stack_qmat_F7_G3 S hj ha haq hc hx ho
    · have haq' : isQMat S.sd a = false := by simpa using haq
      have hφ : phaseOff S.sd j a = j := by simp [phaseOff, haq']
      rw [hφ]
      exact phase_stack_tail_F7_G3 S hj ha haq' hc hx ho
  · obtain ⟨kh, hkh⟩ := kerCol_sdcol_G3 S
    have hcdef : c = underCol S.sd.col ((underCol kh)^[j - 1] ⟨[], 0⟩) := by
      rw [phaseCol_eq_iterate_G3 S hkh (kerCol_rdcol_G3 S)] at hc
      exact (Option.some.inj hc).symm
    exact phase_stack_sd_F7_G3 S hj hkh hcdef hx ho rfl

-- L-G010.4, phase region (D7; L-G010.4b): above `r`, phase-`φ` material is copied edge by edge
theorem respEdge_phase_D7_G3 (S : OrdData_G3) {j φ : Nat} (hj : 1 ≤ j ∧ j ≤ S.n) {a c : ColAddr}
    (hp : PhasePair_D7_G3 S j a c φ) {W : List (WithTop Key)} (hT : ∀ w ∈ W, w ≠ ⊤) {x : Nat}
    (hx : S.sd.r < x) :
    respEdge S.B (activeKeys_D7_G3 S.B c) c (kappaQ_G3 S.sd.r S.d φ W) (x + φ * S.d) =
      (respEdge S.A (activeKeys_D7_G3 S.A a) a W x).map (shiftVal S.sd.r (φ * S.d)) := by
  obtain ⟨-, hnum⟩ := phasePair_num_D7_G3 S hj hp
  by_cases hxa : x < a.num 0
  · obtain ⟨o, ho⟩ : ∃ o, a.resolve 0 x = some o :=
      Option.isSome_iff_exists.mp ((ColAddr.resolve_isSome_iff 0 a x).mpr ⟨Nat.zero_le _, hxa⟩)
    obtain ⟨o', ho', hcont, hkeys, hpar⟩ := phase_stack_F7_G3 S hj hp hx ho
    obtain ⟨hks, hksA, hksB, hparv⟩ := activeKeys_rel_F7_G3 hcont hkeys hpar
    exact respEdge_of_rel_F7_G3 hT ho ho' hks hksA hksB hparv
  · have h1 : a.resolve 0 x = none := by
      cases h : a.resolve 0 x with
      | none => rfl
      | some o => exact absurd (ColAddr.resolve_lt h) hxa
    have h2 : c.resolve 0 (x + φ * S.d) = none := by
      cases h : c.resolve 0 (x + φ * S.d) with
      | none => rfl
      | some o => have := ColAddr.resolve_lt h; omega
    simp [respEdge, h1, h2]

-- L-G010.4 (D7; T3.2q step 1, txt:524-530): phase-`φ` material is copied edge by edge, and the
-- fixed region below `r` is shared, for every `⊤`-free query
theorem respEdge_phase_active_D7_G3 (S : OrdData_G3) {j φ : Nat} (hj : 1 ≤ j ∧ j ≤ S.n) {a c : ColAddr}
    (hp : PhasePair_D7_G3 S j a c φ) {W : List (WithTop Key)} (hT : ∀ w ∈ W, w ≠ ⊤) (x : Nat) :
    (S.sd.r < x → respEdge S.B (activeKeys_D7_G3 S.B c) c (kappaQ_G3 S.sd.r S.d φ W) (x + φ * S.d) =
      (respEdge S.A (activeKeys_D7_G3 S.A a) a W x).map (shiftVal S.sd.r (φ * S.d))) ∧
    (x < S.sd.r → respEdge S.B (activeKeys_D7_G3 S.B c) c (kappaQ_G3 S.sd.r S.d φ W) x =
      respEdge S.A (activeKeys_D7_G3 S.A a) a W x) :=
  ⟨fun h => respEdge_phase_D7_G3 S hj hp hT h, fun h => respEdge_fixed_D7_G3 S hp hT h⟩

/-- D-G010.4 (F7): an admissible capping of the root's key list: its actual keys, or its actual
keys capped at an entry `u ≥ c_A`. -/
def RootCap_F7_G3 (S : OrdData_G3) (ks : List (WithTop Key)) : Prop :=
  ks = actualKeys S.A S.rd.col ∨
    ∃ u, S.rd.cursor ≤ u ∧ u < (actualKeys S.A S.rd.col).length ∧
      ks = (actualKeys S.A S.rd.col).take u ++ [⊤]

-- F7 (helper): the root's key lists are `κ`-fixed
theorem rootCap_kappa_F7_G3 (S : OrdData_G3) {ks : List (WithTop Key)} (hks : RootCap_F7_G3 S ks)
    (φ : Nat) : kappaQ_G3 S.sd.r S.d φ ks = ks := by
  obtain ⟨-, -, -, hrnum, -⟩ := rootData_spec S.hsd S.hrd
  have hfix := kappaQ_fix_D7_G3 S.sd.r S.d φ S.A (o := S.rd.col) (by omega)
  rcases hks with rfl | ⟨u, -, -, rfl⟩
  · exact hfix.1
  · exact hfix.2 u

-- F7 (helper): scans of a `κ`-fixed list do not see `κ`
theorem rootCap_cursor_F7_G3 (S : OrdData_G3) {ks : List (WithTop Key)} (hks : RootCap_F7_G3 S ks)
    (φ : Nat) (W : List (WithTop Key)) :
    cursor ks (kappaQ_G3 S.sd.r S.d φ W) = cursor ks W := by
  have := cursor_map (kappaQry_strictMono_G3 S.sd.r S.d φ) ks W
  have h2 := rootCap_kappa_F7_G3 S hks φ
  unfold kappaQ_G3 at this h2
  rw [h2] at this
  exact this

-- F7 (helper): the query part of the stopping column's keys
theorem sdcol_keys_take_F7_G3 (S : OrdData_G3) :
    (actualKeys S.A S.sd.col).take S.m = (queryKeys S.sd).map (↑) := by
  obtain ⟨hcol, -, ht, -⟩ := stopData_spec S.hsd
  simp only [actualKeys, hcol, Option.getD_some, List.map_append, queryKeys, List.map_map, ← ht]
  rw [List.take_left' (by simp [OrdData_G3.m])]
  rfl

-- F7 (helper): the root's actual keys are its root keys
theorem rdcol_keys_F7_G3 (S : OrdData_G3) :
    actualKeys S.A S.rd.col = (rootKeys S.A S.rd).map (↑) := by
  simp only [actualKeys, rootKeys, List.map_map]
  rfl

-- F7 (helper): the root cursor is the scan of the root's keys against the old complete query
theorem rdcursor_eq_F7_G3 (S : OrdData_G3) :
    S.rd.cursor = cursor (actualKeys S.A S.rd.col) S.termZ := by
  obtain ⟨-, -, -, -, -, -, hcur, -⟩ := rootData_spec S.hsd S.hrd
  unfold OrdData_G3.termZ cutQuery
  rw [cursor_nu, sdcol_keys_take_F7_G3, rdcol_keys_F7_G3, cursor_map WithTop.coe_strictMono, hcur]

-- F7 (helper): the complete query is `⊤`-free
theorem termZ_ne_top_F7_G3 (S : OrdData_G3) : ∀ w ∈ S.termZ, w ≠ ⊤ :=
  ne_top_of_mem_cutQuery_D7_G3 _ _ _

-- F7 (helper): `dropWhile` of an all-true list is empty
theorem dropWhile_all_F7_G3 {β : Type} (p : β → Bool) :
    ∀ (l : List β), (∀ y ∈ l, p y = true) → l.dropWhile p = []
  | [], _ => rfl
  | x :: xs, h => by
    simp only [List.dropWhile, h x (by simp)]
    exact dropWhile_all_F7_G3 p xs (fun y hy => h y (by simp [hy]))

-- F7 (helper): a `⊤` appended to a `⊤`-free list deletes everything
theorem nu_append_top_F7_G3 (l : List (WithTop Key)) (hl : ∀ w ∈ l, w ≠ ⊤) :
    nu (l ++ [⊤]) = [⊤] := by
  rw [nu_append_singleton, nuStep]
  have hall : ∀ y ∈ (nu l).reverse, decide (y < ⊤) = true := by
    intro y hy
    rw [List.mem_reverse] at hy
    have := hl y ((nu_sublist_G3 l).subset hy)
    simpa [lt_top_iff_ne_top] using this
  rw [dropWhile_all_F7_G3 _ _ hall]
  rfl

-- F7 (helper): every `⊤`-free list is below `[⊤]`
theorem lt_top_singleton_F7_G3 (W : List (WithTop Key)) (hW : ∀ w ∈ W, w ≠ ⊤) : W < [⊤] := by
  cases W with
  | nil => exact List.nil_lt_cons _ _
  | cons w ws =>
    have : w < ⊤ := lt_top_iff_ne_top.mpr (hW w (by simp))
    exact List.Lex.rel this

-- L-G010.7 (F7): the head hypotheses of `head_cursor` for an admissible root capping
theorem rootCap_headHyp_F7_G3 (S : OrdData_G3) {ks : List (WithTop Key)} (hks : RootCap_F7_G3 S ks) :
    S.rd.cursor ≤ ks.length ∧ cutQuery ks S.rd.cursor ≤ S.termZ ∧
      (S.rd.cursor < ks.length → S.termZ < cutQuery ks (S.rd.cursor + 1)) := by
  have hcur := rdcursor_eq_F7_G3 S
  have hZn : Noninc S.termZ := cutQuery_noninc _ _
  obtain ⟨h1, h2⟩ := cursor_spec (actualKeys S.A S.rd.col) S.termZ hZn
  rw [← hcur] at h1 h2
  have hle := cursor_le_length (actualKeys S.A S.rd.col) S.termZ
  rw [← hcur] at hle
  rcases hks with rfl | ⟨u, hu1, hu2, rfl⟩
  · exact ⟨hle, h1, h2⟩
  · have hlen : ((actualKeys S.A S.rd.col).take u ++ [⊤]).length = u + 1 := by
      simp only [List.length_append, List.length_take, List.length_singleton]; omega
    refine ⟨by omega, ?_, fun _ => ?_⟩
    · have : cutQuery ((actualKeys S.A S.rd.col).take u ++ [⊤]) S.rd.cursor =
          cutQuery (actualKeys S.A S.rd.col) S.rd.cursor := by
        unfold cutQuery
        rw [List.take_append_of_le_length (by simp; omega), List.take_take, Nat.min_eq_left hu1]
      rw [this]; exact h1
    · rcases Nat.eq_or_lt_of_le hu1 with heq | hlt
      · subst heq
        unfold cutQuery
        rw [List.take_of_length_le (by rw [hlen]), nu_append_top_F7_G3]
        · exact lt_top_singleton_F7_G3 _ (termZ_ne_top_F7_G3 S)
        · intro w hw
          have := List.mem_of_mem_take hw
          simp only [actualKeys, List.mem_map] at this
          obtain ⟨x, -, rfl⟩ := this
          exact WithTop.coe_ne_top
      · have : cutQuery ((actualKeys S.A S.rd.col).take u ++ [⊤]) (S.rd.cursor + 1) =
            cutQuery (actualKeys S.A S.rd.col) (S.rd.cursor + 1) := by
          unfold cutQuery
          rw [List.take_append_of_le_length (by simp; omega), List.take_take,
            Nat.min_eq_left (by omega)]
        rw [this]; exact h2 (by omega)

-- L-G010.8 (F7): below the complete query every admissible root capping scans like the root,
-- and stops at or before `c_A`
theorem rootCap_low_F7_G3 (S : OrdData_G3) {ks : List (WithTop Key)} (hks : RootCap_F7_G3 S ks)
    {W : List (WithTop Key)} (hW : Noninc W) (hT : ∀ w ∈ W, w ≠ ⊤) (hlow : W < S.termZ) :
    cursor ks W = cursor (actualKeys S.A S.rd.col) W ∧
      cursor (actualKeys S.A S.rd.col) W ≤ S.rd.cursor := by
  have hcur := rdcursor_eq_F7_G3 S
  have hZn : Noninc S.termZ := cutQuery_noninc _ _
  have hle : cursor (actualKeys S.A S.rd.col) W ≤ S.rd.cursor := by
    rw [hcur]; exact cursor_mono _ hW hZn hlow.le
  refine ⟨?_, hle⟩
  rcases hks with rfl | ⟨u, hu1, hu2, rfl⟩
  · rfl
  · obtain ⟨-, -, h2⟩ := rootCap_headHyp_F7_G3 S (Or.inl rfl)
    have hlt : W < cutQuery (actualKeys S.A S.rd.col) (u + 1) :=
      lt_of_lt_of_le (lt_of_lt_of_le hlow (le_of_lt (h2 (by omega))))
        (cutQuery_mono _ (by omega))
    exact ((cursor_cappedAt _ W u hu2 hW hT hlt).2).symm

-- F7 (helper): the number of the head of layer `h ≥ 1` is `s_h`
theorem num_headCol_F7_G3 (S : OrdData_G3) {h : Nat} (hh : 1 ≤ h) : (S.headCol h).num 0 = S.s h := by
  obtain ⟨-, -, -, hrnum, -⟩ := rootData_spec S.hsd S.hrd
  rw [num_phaseCol S.inL S.kind S.hsd S.hrd (Or.inl rfl) hh (phaseCol_headCol_G3 S h), hrnum]
  simp [phaseOff, isQMat_rdcol_G3, OrdData_G3.s, OrdData_G3.d]

-- F7 (helper): the head `⟨[], 0⟩` is on the stack of the kernel hole, and contains it exactly
-- when the root contains the stopping column (through the restored image of that entry)
theorem kerHole_head_F7_G3 (S : OrdData_G3) {kh : ColAddr} (hkh : kerCol S.sd S.rd S.sd.col = some kh) :
    kh.OnStack ⟨[], 0⟩ ∧ (⟨[], 0⟩ : ColAddr).container kh =
      (S.rd.col.container S.sd.col).map (fun e => ⟨⟨[], 0⟩, S.m + (e.idx - S.rd.cursor)⟩) := by
  obtain ⟨hres, hrnum, -⟩ := rootData_path S.hsd S.hrd
  have hsdq : isQMat S.sd S.sd.col = false := isQMat_of_short_G3 S.sd le_rfl
  have hsd_rd : S.sd.col.OnStack S.rd.col := ((ColAddr.resolve_spec 0 _ _ _).mp hres).1
  refine ⟨(onStack_kerCol_tail_G3 S hkh hsdq _).mpr ⟨S.rd.col, hsd_rd, by rw [hrnum],
    isQMat_rdcol_G3 S, kerCol_rdcol_G3 S⟩, ?_⟩
  rw [container_kerCol_G3 S hkh (kerCol_rdcol_G3 S) hsdq]
  simp

-- L-G010.5 (F7, the stack part): the heads `s_1, …, s_φ` are on the stack of the copy `c` of a
-- phase pair; below layer `j` a head contains `c` exactly when the root contains the stopping
-- column, and at layer `j` (root-tail template) exactly when the root contains `a`, through the
-- restored image of the same entry
theorem head_stack_F7_G3 (S : OrdData_G3) {j φ : Nat} (hj : 1 ≤ j ∧ j ≤ S.n) {a c : ColAddr}
    (hp : PhasePair_D7_G3 S j a c φ) {h : Nat} (hh1 : 1 ≤ h) (hh : h ≤ φ) :
    c.resolve 0 (S.s h) = some (S.headCol h) ∧
      (h < j → (S.headCol h).container c = (S.rd.col.container S.sd.col).map
        (fun e => ⟨S.headCol h, S.m + (e.idx - S.rd.cursor)⟩)) ∧
      (h = j → IsTmplCol S.A S.sd S.rd a ∧ isQMat S.sd a = false ∧
        (S.headCol h).container c = (S.rd.col.container a).map
          (fun e => ⟨S.headCol h, S.m + (e.idx - S.rd.cursor)⟩)) := by
  obtain ⟨hres, hrnum, -⟩ := rootData_path S.hsd S.hrd
  obtain ⟨kh, hkh⟩ := kerCol_sdcol_G3 S
  obtain ⟨hkh0, hkhc⟩ := kerHole_head_F7_G3 S hkh
  -- the copy as a placement of `b₀`
  obtain ⟨b₀, hcdef, hφj, hjcase⟩ : ∃ b₀, c = underCol S.sd.col ((underCol kh)^[j - 1] b₀) ∧
      φ ≤ j ∧ (h = j → IsTmplCol S.A S.sd S.rd a ∧ isQMat S.sd a = false ∧
        kerCol S.sd S.rd a = some b₀) := by
    rcases hp with ⟨ha, hc, rfl⟩ | ⟨rfl, hc, rfl⟩
    · obtain ⟨b₀, hb₀⟩ := Option.isSome_iff_exists.mp ha.2.2.2
      refine ⟨b₀, ?_, by unfold phaseOff; split_ifs <;> omega, fun hhj => ⟨ha, ?_, hb₀⟩⟩
      · rw [phaseCol_eq_iterate_G3 S hkh hb₀] at hc; exact (Option.some.inj hc).symm
      · cases hq : isQMat S.sd a
        · rfl
        · simp only [phaseOff, hq, if_true] at hh; omega
    · refine ⟨⟨[], 0⟩, ?_, by omega, fun hhj => by omega⟩
      rw [phaseCol_eq_iterate_G3 S hkh (kerCol_rdcol_G3 S)] at hc; exact (Option.some.inj hc).symm
  have hhj : h ≤ j := by omega
  have hsplit : (underCol kh)^[j - 1] b₀ = (underCol kh)^[h - 1] ((underCol kh)^[j - h] b₀) := by
    rw [← Function.iterate_add_apply]
    congr 1
    omega
  have hhead := headCol_eq_G3 S hkh h
  -- `Z = G^{j−h} b₀` has the head on its stack; its containment by the head
  have hZ : ((underCol kh)^[j - h] b₀).OnStack ⟨[], 0⟩ ∧
      (h < j → (⟨[], 0⟩ : ColAddr).container ((underCol kh)^[j - h] b₀) =
        (S.rd.col.container S.sd.col).map (fun e => ⟨⟨[], 0⟩, S.m + (e.idx - S.rd.cursor)⟩)) ∧
      (h = j → (⟨[], 0⟩ : ColAddr).container ((underCol kh)^[j - h] b₀) =
        (S.rd.col.container a).map (fun e => ⟨⟨[], 0⟩, S.m + (e.idx - S.rd.cursor)⟩)) := by
    rcases Nat.eq_or_lt_of_le hhj with heq | hlt
    · obtain ⟨ha, haq, hb₀⟩ := hjcase heq
      rw [heq, Nat.sub_self, Function.iterate_zero_apply]
      refine ⟨(onStack_kerCol_tail_G3 S hb₀ haq _).mpr ⟨S.rd.col, onStack_rdcol_G3 S hb₀ haq ha.2.2.1,
        by rw [hrnum], isQMat_rdcol_G3 S, kerCol_rdcol_G3 S⟩, fun h' => by omega, fun _ => ?_⟩
      rw [container_kerCol_G3 S hb₀ (kerCol_rdcol_G3 S) haq]
      simp
    · obtain ⟨k, hk⟩ : ∃ k, j - h = k + 1 := ⟨j - h - 1, by omega⟩
      rw [hk, Function.iterate_succ_apply']
      refine ⟨(onStack_underCol_G3 kh _ _).mpr (Or.inl hkh0), fun _ => ?_, fun h' => by omega⟩
      rw [container_underCol_of_onStack_G3 hkh0, hkhc]
  have hst : c.OnStack (S.headCol h) := by
    rw [hcdef, hhead, hsplit]
    exact (onStack_underCol_G3 _ _ _).mpr (Or.inr ⟨_, iterate_underCol_onStack_G3 kh (h - 1) hZ.1, rfl⟩)
  have hcont : (S.headCol h).container c =
      ((⟨[], 0⟩ : ColAddr).container ((underCol kh)^[j - h] b₀)).map
        (fun e => ⟨S.headCol h, e.idx⟩) := by
    rw [hcdef, hhead, hsplit, container_underCol_G3, iterate_underCol_container_G3, Option.map_map]
    rfl
  refine ⟨(ColAddr.resolve_spec 0 _ _ _).mpr ⟨hst, num_headCol_F7_G3 S hh1⟩, fun hlt => ?_,
    fun heq => ?_⟩
  · rw [hcont, hZ.2.1 hlt, Option.map_map]; rfl
  · obtain ⟨ha, haq, -⟩ := hjcase heq
    refine ⟨ha, haq, ?_⟩
    rw [hcont, hZ.2.2 heq, Option.map_map]; rfl

-- L-G010.5 (F7, the content part): the head of layer `h` holds the phase-`(h−1)` copy of the
-- query, then the restored root suffix: parents `R[c_A:]`, keys those of `R[c_A:]` except
-- possibly the last (a continuation, owner case)
theorem head_content_F7_G3 (S : OrdData_G3) {h : Nat} (hh : 1 ≤ h ∧ h ≤ S.n) :
    parents S.B (S.headCol h) =
        ((parents S.A S.sd.col).take S.m).map (shiftVal S.sd.r ((h - 1) * S.d)) ++
          (parents S.A S.rd.col).drop S.rd.cursor ∧
      (actualKeys S.B (S.headCol h)).take S.m =
        kappaQ_G3 S.sd.r S.d (h - 1) ((actualKeys S.A S.sd.col).take S.m) ∧
      ((actualKeys S.B (S.headCol h)).drop S.m).length =
        ((actualKeys S.A S.rd.col).drop S.rd.cursor).length ∧
      ∀ v, ¬ (S.rd.owner = true ∧ v + 1 = ((actualKeys S.A S.rd.col).drop S.rd.cursor).length) →
        ((actualKeys S.B (S.headCol h)).drop S.m)[v]? =
          ((actualKeys S.A S.rd.col).drop S.rd.cursor)[v]? := by
  obtain ⟨-, -, -, hrnum, -⟩ := rootData_spec S.hsd S.hrd
  obtain ⟨hmB, hparB, hkeyB⟩ := headQuery_prefix_D7_G3 S hh (phaseCol_headCol_G3 S h)
  obtain ⟨col, hBcol, hlen, -, hrest⟩ :=
    colAt_head S.inL S.kind S.hsd S.hrd S.out hh (phaseCol_headCol_G3 S h)
  have hm : S.sd.Q.length = S.m := rfl
  have hU : unconsumed S.A S.rd = ((S.A.colAt S.rd.col).getD []).drop S.rd.cursor := rfl
  have hnum := num_headCol_F7_G3 S hh.1
  have hBpar : parents S.B (S.headCol h) = col.map Prod.fst := by simp [parents, hBcol]
  have hBkeys : actualKeys S.B (S.headCol h) =
      col.map (fun x => ((relKey (S.s h) x.2 : Key) : WithTop Key)) := by
    simp [actualKeys, hBcol, hnum]
  have hUlen : ((actualKeys S.A S.rd.col).drop S.rd.cursor).length =
      (unconsumed S.A S.rd).length := by
    rw [hU]; simp [actualKeys]
  -- the restored entries
  have hent : ∀ v, v < (unconsumed S.A S.rd).length → ∃ x y, (unconsumed S.A S.rd)[v]? = some x ∧
      col[S.m + v]? = some y ∧ y.1 = x.1 ∧
      (¬ (S.rd.owner = true ∧ v + 1 = (unconsumed S.A S.rd).length) → y.2 = shift S.sd.r (h * S.d) x.2) := by
    intro v hv
    obtain ⟨y, hy, hy1, hy2⟩ := hrest v _ (List.getElem?_eq_getElem hv)
    exact ⟨_, y, List.getElem?_eq_getElem hv, hy, hy1, fun hn => by rw [hy2 hn]; rfl⟩
  have hdropLen : (col.drop S.m).length = (unconsumed S.A S.rd).length := by
    rw [List.length_drop, hlen, hm]; omega
  refine ⟨?_, hkeyB, ?_, ?_⟩
  · have hdrop : (parents S.B (S.headCol h)).drop S.m = (parents S.A S.rd.col).drop S.rd.cursor := by
      apply List.ext_getElem?
      intro v
      rw [hBpar, ← List.map_drop, List.getElem?_map, List.getElem?_drop]
      have hpd : (parents S.A S.rd.col).drop S.rd.cursor = (unconsumed S.A S.rd).map Prod.fst := by
        rw [hU]; simp [parents, List.map_drop]
      rw [hpd, List.getElem?_map]
      by_cases hv : v < (unconsumed S.A S.rd).length
      · obtain ⟨x, y, hx, hy, hxy, -⟩ := hent v hv
        rw [hx, hy]; simp [hxy]
      · rw [List.getElem?_eq_none (by omega), List.getElem?_eq_none (by omega)]
    rw [← List.take_append_drop S.m (parents S.B (S.headCol h)), hparB, hdrop]
  · rw [hBkeys, ← List.map_drop, List.length_map, hdropLen, hUlen]
  · intro v hn
    rw [hUlen] at hn
    rw [hBkeys, ← List.map_drop, List.getElem?_map, List.getElem?_drop]
    have hkd : (actualKeys S.A S.rd.col).drop S.rd.cursor =
        (unconsumed S.A S.rd).map (fun x => ((relKey S.sd.r x.2 : Key) : WithTop Key)) := by
      rw [hU]; simp [actualKeys, List.map_drop, hrnum]
    rw [hkd, List.getElem?_map]
    by_cases hv : v < (unconsumed S.A S.rd).length
    · obtain ⟨x, y, hx, hy, -, hy2⟩ := hent v hv
      rw [hx, hy]
      simp only [Option.map_some, Option.some.injEq, WithTop.coe_inj]
      rw [hy2 hn]
      have : S.s h = S.sd.r + h * S.d := rfl
      rw [this, relKey_shift S.sd.r S.d h S.sd.r le_rfl, kappa_fix S.sd.r S.d h S.sd.r le_rfl]
    · rw [List.getElem?_eq_none (by omega), List.getElem?_eq_none (by omega)]; rfl

-- F7 (helper): a container entry of a column of `E` exists
theorem container_idx_lt_F7_G3 {E : Forest} {o a : ColAddr} {e : EntryAddr} (ha : a ∈ E.colAddrs)
    (he : o.container a = some e) : e.idx < (actualKeys E o).length := by
  have hc := (ColAddr.container_spec _ _ _).mp he
  have hmem := mem_entryAddrs_of_contains ha hc.2
  have hent := (Tree.mem_entryAddrs_iff _ _).mp hmem
  unfold Tree.entryAt at hent
  rw [hc.1] at hent
  rw [length_actualKeys]
  cases hco : E.colAt o with
  | none => rw [hco] at hent; cases hent
  | some col =>
    rw [hco] at hent
    simp only [Option.bind_some, Option.getD_some] at hent ⊢
    exact (List.getElem?_eq_some_iff.mp (Option.get_mem hent)).1

-- L-G010.5 (F7, keys of a head): uncapped (body case) and capped at a restored entry
theorem head_keys_F7_G3 (S : OrdData_G3) {h : Nat} (hh : 1 ≤ h ∧ h ≤ S.n) :
    (S.rd.owner = false → actualKeys S.B (S.headCol h) =
      kappaQ_G3 S.sd.r S.d (h - 1) ((actualKeys S.A S.sd.col).take S.m) ++
        (actualKeys S.A S.rd.col).drop S.rd.cursor) ∧
    ∀ u, S.rd.cursor ≤ u → u < (actualKeys S.A S.rd.col).length →
      (actualKeys S.B (S.headCol h)).take (S.m + (u - S.rd.cursor)) ++ [⊤] =
        kappaQ_G3 S.sd.r S.d (h - 1) ((actualKeys S.A S.sd.col).take S.m) ++
          ((actualKeys S.A S.rd.col).take u ++ [⊤]).drop S.rd.cursor := by
  obtain ⟨-, hkeyB, hlenB, hentB⟩ := head_content_F7_G3 S hh
  refine ⟨fun hown => ?_, fun u hu1 hu2 => ?_⟩
  · rw [← List.take_append_drop S.m (actualKeys S.B (S.headCol h)), hkeyB]
    congr 1
    apply List.ext_getElem?
    intro v
    exact hentB v (by rw [hown]; simp)
  · rw [List.take_add, hkeyB, List.append_assoc]
    congr 1
    rw [List.drop_append_of_le_length (by simp; omega), List.drop_take]
    congr 1
    apply List.ext_getElem?
    intro v
    rw [List.getElem?_take, List.getElem?_take]
    split_ifs with hv
    · exact hentB v (by simp; omega)
    · rfl

-- L-G010.5 (F7; `activeKeys_head`): at a head `s_h`, `1 ≤ h ≤ φ`, the copy's capped keys are the
-- phase-`(h−1)` query keys followed by an admissible root capping from `c_A` on (the capping of
-- `a`'s root at `h = φ`), and the parents are the shifted query parents, then `R[c_A:]`
theorem activeKeys_head_F7_G3 (S : OrdData_G3) {j φ : Nat} (hj : 1 ≤ j ∧ j ≤ S.n) {a c : ColAddr}
    (hp : PhasePair_D7_G3 S j a c φ) {h : Nat} (hh1 : 1 ≤ h) (hh : h ≤ φ) :
    ∃ ks, c.resolve 0 (S.s h) = some (S.headCol h) ∧ RootCap_F7_G3 S ks ∧
      (h = φ → ks = activeKeys_D7_G3 S.A a S.rd.col) ∧
      activeKeys_D7_G3 S.B c (S.headCol h) =
        kappaQ_G3 S.sd.r S.d (h - 1) ((actualKeys S.A S.sd.col).take S.m) ++ ks.drop S.rd.cursor ∧
      parents S.B (S.headCol h) =
        ((parents S.A S.sd.col).take S.m).map (shiftVal S.sd.r ((h - 1) * S.d)) ++
          (parents S.A S.rd.col).drop S.rd.cursor := by
  obtain ⟨hres, -, -, hpre, -, hown, hlast⟩ := rootData_path S.hsd S.hrd
  have hφj : φ ≤ j := by
    rcases hp with ⟨-, -, rfl⟩ | ⟨-, -, rfl⟩
    · unfold phaseOff; split_ifs <;> omega
    · omega
  have hhn : 1 ≤ h ∧ h ≤ S.n := ⟨hh1, by omega⟩
  obtain ⟨hst, hlt, heq⟩ := head_stack_F7_G3 S hj hp hh1 hh
  obtain ⟨hparB, -⟩ := head_content_F7_G3 S hhn
  obtain ⟨hbody, hcap⟩ := head_keys_F7_G3 S hhn
  have hlenR : (actualKeys S.A S.rd.col).length = ((S.A.colAt S.rd.col).getD []).length :=
    length_actualKeys _ _
  -- the capped form of an entry `u ≥ c_A`
  have hcapped : ∀ e : EntryAddr, S.rd.cursor ≤ e.idx → e.idx < (actualKeys S.A S.rd.col).length →
      (S.headCol h).container c = some ⟨S.headCol h, S.m + (e.idx - S.rd.cursor)⟩ →
      activeKeys_D7_G3 S.B c (S.headCol h) =
        kappaQ_G3 S.sd.r S.d (h - 1) ((actualKeys S.A S.sd.col).take S.m) ++
          ((actualKeys S.A S.rd.col).take e.idx ++ [⊤]).drop S.rd.cursor := by
    intro e h1 h2 hce
    simp only [activeKeys_D7_G3, hce]
    exact hcap e.idx h1 h2
  have hbody' : S.rd.owner = false → (S.headCol h).container c = none →
      activeKeys_D7_G3 S.B c (S.headCol h) =
        kappaQ_G3 S.sd.r S.d (h - 1) ((actualKeys S.A S.sd.col).take S.m) ++
          (actualKeys S.A S.rd.col).drop S.rd.cursor := by
    intro ho hce
    simp only [activeKeys_D7_G3, hce]
    exact hbody ho
  rcases Nat.lt_or_ge h j with hhj | hhj
  · -- below layer `j`: the head contains `c` iff the root contains the stopping column
    have hce := hlt hhj
    -- at `h = φ` the pair is Q-material or the head pair: `R` contains `a` as it contains `sd.col`
    have hRa : h = φ → S.rd.col.container a = S.rd.col.container S.sd.col := by
      intro hhφ
      rcases hp with ⟨ha, hc, rfl⟩ | ⟨rfl, -, -⟩
      · have haq : isQMat S.sd a = true := by
          cases hq : isQMat S.sd a
          · simp only [phaseOff, hq, Bool.false_eq_true, if_false] at hhφ; omega
          · rfl
        obtain ⟨a₀, ha₀⟩ := Option.isSome_iff_exists.mp ha.2.2.2
        rw [qmat_underCol_F7_G3 S haq ha₀]
        exact container_underCol_of_onStack_G3 ((ColAddr.resolve_spec 0 _ _ _).mp hres).1 a₀
      · rfl
    cases hRs : S.rd.col.container S.sd.col with
    | none =>
      have ho : S.rd.owner = false := by
        cases h' : S.rd.owner
        · rfl
        · have := hown.mp h'; rw [hRs] at this; cases this
      rw [hRs, Option.map_none] at hce
      refine ⟨actualKeys S.A S.rd.col, hst, Or.inl rfl, fun hhφ => ?_, hbody' ho hce, hparB⟩
      simp only [activeKeys_D7_G3, hRa hhφ, hRs]
    | some e =>
      rw [hRs, Option.map_some] at hce
      have hl := hlast e hRs
      unfold Packet.rootLenOf at hl
      have ho : S.rd.owner = true := hown.mpr (by rw [hRs]; rfl)
      have hkd := S.kernelDefined ho
      have hcA : S.rd.cursor < (actualKeys S.A S.rd.col).length := by
        unfold unconsumed rootCol at hkd
        rw [hlenR]
        by_contra hcon
        exact hkd (List.drop_eq_nil_of_le (by omega))
      refine ⟨(actualKeys S.A S.rd.col).take e.idx ++ [⊤], hst,
        Or.inr ⟨e.idx, by omega, by omega, rfl⟩, fun hhφ => ?_,
        hcapped e (by omega) (by omega) hce, hparB⟩
      simp only [activeKeys_D7_G3, hRa hhφ, hRs]
  · -- at layer `j`: a root-tail template, contained by the head iff by the root
    have hhj' : h = j := by omega
    obtain ⟨ha, haq, hce⟩ := heq hhj'
    obtain ⟨a₀, ha₀⟩ := Option.isSome_iff_exists.mp ha.2.2.2
    obtain ⟨suf, hsuf, hcases⟩ := kerCol_tail_spec_G3 S ha₀ haq
    have hφ : h = φ := by
      rcases hp with ⟨-, -, rfl⟩ | ⟨rfl, -, -⟩
      · simp only [phaseOff, haq, Bool.false_eq_true, if_false]; omega
      · exact absurd ha.2.1 (by simp)
    cases hRa : S.rd.col.container a with
    | none =>
      have ho : S.rd.owner = false := by
        rcases hcases with ⟨rfl, hc, -⟩ | ⟨-, -, ho, -⟩ | ⟨e, rest, rfl, -, -⟩ | ⟨-, -, -, -, -, ho, -⟩
        · exfalso; apply ha.2.2.1
          show (⟨a.path, a.col⟩ : ColAddr) = ⟨S.rd.col.path, S.rd.col.col⟩
          rw [hsuf, hc, List.append_nil]
        · exact ho
        · exfalso
          have : S.rd.col.container a = some ⟨S.rd.col, e⟩ :=
            (ColAddr.container_spec _ _ _).mpr ⟨rfl, ⟨rest, by simp [EntryAddr.heightPath, hsuf]⟩⟩
          rw [hRa] at this; cases this
        · exact ho
      rw [hRa, Option.map_none] at hce
      refine ⟨actualKeys S.A S.rd.col, hst, Or.inl rfl, fun _ => ?_, hbody' ho hce, hparB⟩
      simp only [activeKeys_D7_G3, hRa]
    | some e =>
      rw [hRa, Option.map_some] at hce
      have hcA : S.rd.cursor ≤ e.idx := by
        obtain ⟨he1, t, ht⟩ := (ColAddr.container_spec _ _ _).mp hRa
        rw [EntryAddr.heightPath, he1, List.append_assoc, hsuf] at ht
        have ht' := List.append_cancel_left ht
        rcases hcases with ⟨rfl, -, -⟩ | ⟨rfl, -, -, -⟩ | ⟨e', rest, rfl, he', -⟩ |
            ⟨ci, e', rest, rfl, hci, -, -⟩
        · simp at ht'
        · simp at ht'
        · simp only [List.singleton_append, List.cons.injEq, Prod.mk.injEq, true_and] at ht'
          omega
        · simp only [List.singleton_append, List.cons.injEq, Prod.mk.injEq] at ht'
          omega
      have hlt' := container_idx_lt_F7_G3 ha.1 hRa
      refine ⟨(actualKeys S.A S.rd.col).take e.idx ++ [⊤], hst,
        Or.inr ⟨e.idx, hcA, hlt', rfl⟩, fun _ => ?_, hcapped e hcA hlt' hce, hparB⟩
      simp only [activeKeys_D7_G3, hRa]

-- F7 (helper): `κ_j` preserves and reflects `≤` of queries
theorem kappaQ_le_iff_F7_G3 (r d j : Nat) (W Z : List (WithTop Key)) :
    kappaQ_G3 r d j W ≤ kappaQ_G3 r d j Z ↔ W ≤ Z := by
  rw [← not_lt, ← not_lt, kappaQ_lt_iff_G3]

-- F7 (helper): the query part of the stopping column has `m` keys
theorem length_sdcol_take_F7_G3 (S : OrdData_G3) : ((actualKeys S.A S.sd.col).take S.m).length = S.m := by
  obtain ⟨hcol, -⟩ := stopData_spec S.hsd
  rw [List.length_take, length_actualKeys, hcol]
  simp [OrdData_G3.m]

-- F7 (helper): `head_cursor` at a head of layer `h ≥ 1` with an admissible root capping, at the
-- query `κ_{h−1}(W')`
theorem head_scan_F7_G3 (S : OrdData_G3) {ks : List (WithTop Key)} (hks : RootCap_F7_G3 S ks) (h : Nat)
    {W' : List (WithTop Key)} (hW' : Noninc W') :
    (W' < S.termZ → cursor (kappaQ_G3 S.sd.r S.d h ((actualKeys S.A S.sd.col).take S.m) ++
        ks.drop S.rd.cursor) (kappaQ_G3 S.sd.r S.d h W') < S.m) ∧
    (S.termZ ≤ W' → S.rd.cursor ≤ cursor ks W' ∧
      cursor (kappaQ_G3 S.sd.r S.d h ((actualKeys S.A S.sd.col).take S.m) ++ ks.drop S.rd.cursor)
        (kappaQ_G3 S.sd.r S.d h W') = S.m + (cursor ks W' - S.rd.cursor)) := by
  obtain ⟨hc, h1, h2⟩ := rootCap_headHyp_F7_G3 S hks
  have hfix := rootCap_kappa_F7_G3 S hks h
  have hnu : nu (kappaQ_G3 S.sd.r S.d h ((actualKeys S.A S.sd.col).take S.m)) =
      kappaQ_G3 S.sd.r S.d h S.termZ := by
    unfold kappaQ_G3 OrdData_G3.termZ cutQuery
    rw [nu_map (kappaQry_strictMono_G3 _ _ _)]
  have hcq : ∀ k, cutQuery ks k = kappaQ_G3 S.sd.r S.d h (cutQuery ks k) := by
    intro k
    conv_lhs => rw [← hfix]
    unfold kappaQ_G3
    rw [cutQuery_map (kappaQry_strictMono_G3 _ _ _)]
  have H := head_cursor (V := kappaQ_G3 S.sd.r S.d h W')
    (kappaQ_G3 S.sd.r S.d h ((actualKeys S.A S.sd.col).take S.m)) ks hc
    (by rw [hnu, hcq, kappaQ_le_iff_F7_G3]; exact h1)
    (fun hlt => by rw [hnu, hcq, kappaQ_lt_iff_G3]; exact h2 hlt)
    (kappaQ_noninc_G3 _ _ _ hW')
  have hlen : (kappaQ_G3 S.sd.r S.d h ((actualKeys S.A S.sd.col).take S.m)).length = S.m := by
    unfold kappaQ_G3; rw [List.length_map, length_sdcol_take_F7_G3]
  refine ⟨fun hlow => ?_, fun hhigh => ?_⟩
  · have := H.1 (by rw [hnu, kappaQ_lt_iff_G3]; exact hlow)
    rwa [hlen] at this
  · have := H.2 (by rw [hnu, kappaQ_le_iff_F7_G3]; exact hhigh)
    rw [rootCap_cursor_F7_G3 S hks, hlen] at this
    exact this

-- L-G010.14 (D7; T3.2q step 2, high case, txt:390-391): a high scan at the head `s_φ` returns the
-- old root response at `W`
theorem respEdge_head_high_D7_G3 (S : OrdData_G3) {j φ : Nat} (hj : 1 ≤ j ∧ j ≤ S.n) {a c : ColAddr}
    (hp : PhasePair_D7_G3 S j a c φ) (hφ : 1 ≤ φ) {W : List (WithTop Key)} (hW : Noninc W)
    (_hT : ∀ w ∈ W, w ≠ ⊤) (hhigh : S.termZ ≤ kappaQ_G3 S.sd.r S.d 1 W) :
    respEdge S.B (activeKeys_D7_G3 S.B c) c (kappaQ_G3 S.sd.r S.d φ W) (S.s φ) =
      respEdge S.A (activeKeys_D7_G3 S.A a) a W S.sd.r := by
  obtain ⟨ks, hst, hRC, hkseq, hkeys, hpar⟩ := activeKeys_head_F7_G3 S hj hp hφ le_rfl
  obtain ⟨hRa, -⟩ := phasePair_root_D7_G3 S hp
  have hks := hkseq rfl
  have hV : kappaQ_G3 S.sd.r S.d φ W = kappaQ_G3 S.sd.r S.d (φ - 1) (kappaQ_G3 S.sd.r S.d 1 W) := by
    rw [kappaQ_add_G3, show φ - 1 + 1 = φ by omega]
  obtain ⟨hge, hcur⟩ := (head_scan_F7_G3 S hRC (φ - 1) (kappaQ_noninc_G3 _ _ 1 hW)).2 hhigh
  rw [rootCap_cursor_F7_G3 S hRC] at hge hcur
  unfold respEdge
  rw [hst, hRa]
  simp only [Option.bind_some]
  rw [resp_eq_parents_G3, resp_eq_parents_G3, hkeys, hV, hcur, hpar, ← hks]
  have hlm : (((parents S.A S.sd.col).take S.m).map (shiftVal S.sd.r ((φ - 1) * S.d))).length =
      S.m := by
    have := length_sdcol_take_F7_G3 S
    rw [List.length_take] at this
    rw [List.length_map, List.length_take, length_parents_F7_G3, this]
  rw [List.getElem?_append_right (by omega), hlm, Nat.add_sub_cancel_left, List.getElem?_drop,
    Nat.add_sub_cancel' hge]

-- F7 (helper): paths only read the key lists of the columns on the stack
theorem path_congr_F7_G3 {E : Forest} {ks ks' : KeySys} {c : ColAddr} {W : List (WithTop Key)}
    (hks : ∀ x o, c.resolve 0 x = some o → ks o = ks' o) {x y : Nat}
    (h : Path E ks c W x y) : Path E ks' c W x y := by
  induction h with
  | refl => exact Relation.ReflTransGen.refl
  | tail _ he ih =>
    obtain ⟨o, ho, hr⟩ := he
    refine ih.tail ⟨o, ho, ?_⟩
    unfold resp at hr ⊢
    rw [← hks _ _ ho]
    exact hr

-- L-G010.2 (F7): below a stack column `c'` of `c`, the active systems of `c` and `c'` agree
theorem respEdge_activeKeys_onStack_F7_G3 (E : Forest) {c c' : ColAddr} {z : Nat}
    (hc' : c.resolve 0 z = some c') (W : List (WithTop Key)) {x : Nat} (hx : x < z) :
    respEdge E (activeKeys_D7_G3 E c) c W x = respEdge E (activeKeys_D7_G3 E c') c' W x := by
  unfold respEdge
  rw [ColAddr.resolve_of_resolve_lt hc' hx]
  cases ho : c.resolve 0 x with
  | none => rfl
  | some o =>
    simp only [Option.bind_some]
    have hon : o.num 0 = x := ColAddr.resolve_num ho
    have hcc' : c'.path <+: c.path := onStack_prefix_G3 ((ColAddr.resolve_spec 0 _ _ _).mp hc').1
    have hcont : o.container c = o.container c' := by
      apply Option.ext
      intro e
      constructor
      · intro he
        obtain ⟨he1, he2⟩ := (ColAddr.container_spec _ _ _).mp he
        have := EntryAddr.contains_of_resolve he2 hc' (by rw [he1]; omega)
        exact (ColAddr.container_spec _ _ _).mpr ⟨he1, this⟩
      · intro he
        obtain ⟨he1, he2⟩ := (ColAddr.container_spec _ _ _).mp he
        exact (ColAddr.container_spec _ _ _).mpr ⟨he1, he2.trans hcc'⟩
    unfold resp
    simp only [activeKeys_D7_G3, hcont]

-- L-G010.2 (F7, path form)
theorem path_activeKeys_onStack_F7_G3 (E : Forest) (hV : CondV E) {c c' : ColAddr} {z : Nat}
    (hc' : c.resolve 0 z = some c') {W : List (WithTop Key)} {x y : Nat} (hx : x < z)
    (h : Path E (activeKeys_D7_G3 E c') c' W x y) : Path E (activeKeys_D7_G3 E c) c W x y := by
  induction h using Relation.ReflTransGen.head_induction_on with
  | refl => exact Relation.ReflTransGen.refl
  | @head x x' hxx' _ ih =>
    have hlt := edge_lt hV hxx'
    rw [edge_iff, ← respEdge_activeKeys_onStack_F7_G3 E hc' W hx] at hxx'
    exact Relation.ReflTransGen.head ((edge_iff _ _ _ _ _ _).mpr hxx') (ih (by omega))

-- L-G010.3 (F7): on the stopping column's stack, the route-capped system of `A` is capped at the
-- active containers of the stopping column
theorem activeKeys_stopCol_F7_G3 (S : OrdData_G3) {x : Nat} {o : ColAddr}
    (ho : S.sd.col.resolve 0 x = some o) :
    capKeys S.A (routeCols S.A) o = activeKeys_D7_G3 S.A S.sd.col o := by
  obtain ⟨hcol, -, -, hroute, -⟩ := stopData_spec S.hsd
  have hmem : S.sd.col ∈ S.A.colAddrs := by rw [Tree.mem_colAddrs_iff, hcol]; rfl
  cases hce : o.container S.sd.col with
  | some e =>
    have hor : o ∈ routeCols S.A := container_mem_routeCols_D7_G3 hroute hce
    have hl := container_sdcol_last_G3 S hce
    rw [length_parents_F7_G3] at hl
    simp only [capKeys, hor, if_true, activeKeys_D7_G3, hce]
    obtain ⟨l, x, hlx⟩ : ∃ l x, actualKeys S.A o = l ++ [x] := by
      cases h : actualKeys S.A o using List.reverseRecOn with
      | nil => rw [h] at hl; simp at hl
      | append_singleton l x _ => exact ⟨l, x, rfl⟩
    rw [hlx] at hl ⊢
    simp only [List.length_append, List.length_singleton] at hl
    rw [List.dropLast_concat, List.getLast?_concat, List.take_left' (by omega)]
    rfl
  | none =>
    have hnr : o ∉ routeCols S.A := by
      intro hor
      obtain ⟨v, -, hv⟩ := routeCols_visible hmem hor ho
      have := (ColAddr.container_spec _ _ _).mpr ⟨rfl, hv⟩
      rw [hce] at this; cases this
    simp only [capKeys, hnr, if_false, activeKeys_D7_G3, hce]

-- G9.3 decorated (F7): at a reduced query `W' < Z` the old terminal answers with a query parent
-- `q`, and `q` reaches `r` by a path in the system capped at the stopping column's active
-- containers (decorated A of `A`, path nesting)
theorem term_detour_active_F7_G3 (S : OrdData_G3) {W : List (WithTop Key)} (hW : Noninc W)
    (hlow : W < S.termZ) :
    cursor (actualKeys S.A S.sd.col) W < S.m ∧
      ∃ q, (parents S.A S.sd.col)[cursor (actualKeys S.A S.sd.col) W]? = some q ∧
        S.sd.r ≤ q ∧ q < S.sd.t ∧
        Path S.A (activeKeys_D7_G3 S.A S.sd.col) S.sd.col W q S.sd.r := by
  obtain ⟨hj, q, hq, hrq, hqt, -⟩ := term_detour_G3 S hW hlow
  refine ⟨hj, q, hq, hrq, hqt, ?_⟩
  obtain ⟨hcol, -⟩ := stopData_spec S.hsd
  have hVA : CondV S.A := S.inL.1
  have hAK : CondAK S.A (capKeys S.A (routeCols S.A)) :=
    capping_forward S.inL.1 S.inL.2.2.2.1 S.inL.2.2.2.2 (fun _ h => h)
  have hpar : parents S.A S.sd.col = S.sd.Q.map Prod.fst ++ [S.sd.r] := by
    simp [parents, hcol]
  have hplen : (parents S.A S.sd.col).length = S.m + 1 := by
    rw [hpar]; simp [OrdData_G3.m]
  have hclen : ((S.A.colAt S.sd.col).getD []).length = S.m + 1 := by
    rw [hcol]; simp [OrdData_G3.m]
  have hmem : S.sd.col ∈ S.A.colAddrs := by rw [Tree.mem_colAddrs_iff, hcol]; rfl
  set j := cursor (actualKeys S.A S.sd.col) W with hjdef
  set P : Nat → Nat := fun l => ((parents S.A S.sd.col)[l]?).getD 0 with hP
  have hPget : ∀ l, l ≤ S.m → (parents S.A S.sd.col)[l]? = some (P l) := by
    intro l hl
    have : l < (parents S.A S.sd.col).length := by omega
    simp [hP, List.getElem?_eq_getElem this]
  have hPm : P S.m = S.sd.r := by
    simp [hP, hpar, OrdData_G3.m]
  have hPj : P j = q := by
    have := hPget j hj.le
    rw [hq] at this
    exact (Option.some.inj this).symm
  have hWlt : W < cutQuery (actualKeys S.A S.sd.col) (j + 1) :=
    (cursor_spec _ W hW).2 (by rw [length_actualKeys, hclen]; omega)
  have hchain : ∀ n, j + n ≤ S.m →
      Path S.A (capKeys S.A (routeCols S.A)) S.sd.col W (P j) (P (j + n)) := by
    intro n
    induction n with
    | zero => intro _; exact Relation.ReflTransGen.refl
    | succ n ih =>
      intro hn
      have h1 := ih (by omega)
      have hA := hAK S.sd.col hmem (j + n + 1) (P (j + n + 1)) (hPget _ hn)
      simp only [Nat.add_one_ne_zero, if_false, Nat.add_sub_cancel] at hA
      rw [cutQuery_capKeys _ _ _ (by rw [hclen]; omega)] at hA
      have hA' : Path S.A (capKeys S.A (routeCols S.A)) S.sd.col
          (cutQuery (actualKeys S.A S.sd.col) (j + n + 1)) (P (j + n)) (P (j + n + 1)) := hA
      have hle : W ≤ cutQuery (actualKeys S.A S.sd.col) (j + n + 1) :=
        le_of_lt (lt_of_lt_of_le hWlt (cutQuery_mono _ (by omega)))
      exact h1.trans (path_nesting_path_G3 hVA hAK S.sd.col hW (cutQuery_noninc _ _) hle hA')
  have hqr := hchain (S.m - j) (by omega)
  rw [show j + (S.m - j) = S.m by omega, hPm, hPj] at hqr
  exact path_congr_F7_G3 (fun x o ho => activeKeys_stopCol_F7_G3 S ho) hqr

-- L-G010.6 (F7): the root reads alike in both active systems below the complete query
theorem respEdge_root_low_F7_G3 (S : OrdData_G3) {j φ : Nat} (hj : 1 ≤ j ∧ j ≤ S.n) {a c : ColAddr}
    (hp : PhasePair_D7_G3 S j a c φ) (hφ : 1 ≤ φ) {W : List (WithTop Key)} (hW : Noninc W)
    (hT : ∀ w ∈ W, w ≠ ⊤) (hlow : kappaQ_G3 S.sd.r S.d 1 W < S.termZ) (ψ : Nat) :
    respEdge S.B (activeKeys_D7_G3 S.B c) c (kappaQ_G3 S.sd.r S.d ψ W) S.sd.r =
        (parents S.A S.rd.col)[cursor (actualKeys S.A S.rd.col) (kappaQ_G3 S.sd.r S.d 1 W)]? ∧
      respEdge S.A (activeKeys_D7_G3 S.A a) a W S.sd.r =
        (parents S.A S.rd.col)[cursor (actualKeys S.A S.rd.col) (kappaQ_G3 S.sd.r S.d 1 W)]? := by
  obtain ⟨hRa, hRc, -, b, hb⟩ := phasePair_root_D7_G3 S hp
  obtain ⟨hres, -, -, -, -, hown, hlast⟩ := rootData_path S.hsd S.hrd
  have hsdR : S.sd.col.OnStack S.rd.col := ((ColAddr.resolve_spec 0 _ _ _).mp hres).1
  have hT1 : ∀ w ∈ kappaQ_G3 S.sd.r S.d 1 W, w ≠ ⊤ := by
    intro w hw
    simp only [kappaQ_G3, List.mem_map] at hw
    obtain ⟨w', hw', rfl⟩ := hw
    have := hT w' hw'
    cases w' with
    | top => exact absurd rfl this
    | coe k => simp
  have hW1 : Noninc (kappaQ_G3 S.sd.r S.d 1 W) := kappaQ_noninc_G3 _ _ _ hW
  -- the A side: `a`'s root capping is admissible (L-G010.5 at `h = φ`)
  obtain ⟨ks, -, hRC, hkseq, -⟩ := activeKeys_head_F7_G3 S hj hp hφ le_rfl
  have hksA := hkseq rfl
  -- the B side: `B` keeps the root column, capped as the stopping column's container
  have hE : S.A ≠ Tree.empty := by
    intro h
    have := S.hsd
    rw [h, stopData_eq_none_of_lastCol (Or.inl rfl)] at this
    cases this
  obtain ⟨Z, hB⟩ : ∃ Z, S.B = context S.A S.sd Z := by
    have := expand_eq_iterate hE S.inL.1 S.inL.2.1 S.kind S.hsd S.hrd S.kernelDefined S.n
    rw [S.out] at this
    exact ⟨_, Option.some.inj this⟩
  obtain ⟨hpar, htake, hnone⟩ := colAt_context_onStack_G3 S.hsd Z hsdR
  rw [← hB] at hpar htake hnone
  have hcR : S.rd.col.container c = S.rd.col.container S.sd.col := by
    rw [hb]; exact container_underCol_of_onStack_G3 hsdR b
  obtain ⟨ksB, hRCB, hksB⟩ : ∃ ksB, RootCap_F7_G3 S ksB ∧ activeKeys_D7_G3 S.B c S.rd.col = ksB := by
    cases hRs : S.rd.col.container S.sd.col with
    | none =>
      refine ⟨actualKeys S.A S.rd.col, Or.inl rfl, ?_⟩
      simp only [activeKeys_D7_G3, hcR, hRs, actualKeys, hnone hRs]
    | some e =>
      have hl := hlast e hRs
      unfold Packet.rootLenOf at hl
      have ho : S.rd.owner = true := hown.mpr (by rw [hRs]; rfl)
      have hkd := S.kernelDefined ho
      have hlenR := length_actualKeys S.A S.rd.col
      have hcA : S.rd.cursor < (actualKeys S.A S.rd.col).length := by
        unfold unconsumed rootCol at hkd
        rw [hlenR]
        by_contra hcon
        exact hkd (List.drop_eq_nil_of_le (by omega))
      refine ⟨(actualKeys S.A S.rd.col).take e.idx ++ [⊤], Or.inr ⟨e.idx, by omega, by omega, rfl⟩, ?_⟩
      simp only [activeKeys_D7_G3, hcR, hRs]
      congr 1
      have h1 := htake e hRs
      simp only [actualKeys, ← List.map_take]
      congr 1
      cases hBo : S.B.colAt S.rd.col with
      | none =>
        cases hAo : S.A.colAt S.rd.col with
        | none => rfl
        | some _ => rw [hBo, hAo] at h1; cases h1
      | some C1 =>
        cases hAo : S.A.colAt S.rd.col with
        | none => rw [hBo, hAo] at h1; cases h1
        | some C2 =>
          rw [hBo, hAo] at h1
          simpa using h1
  have hcurB : cursor ksB (kappaQ_G3 S.sd.r S.d ψ W) =
      cursor (actualKeys S.A S.rd.col) (kappaQ_G3 S.sd.r S.d 1 W) := by
    rw [rootCap_cursor_F7_G3 S hRCB, ← rootCap_cursor_F7_G3 S hRCB 1]
    exact (rootCap_low_F7_G3 S hRCB hW1 hT1 hlow).1
  have hcurA : cursor ks W = cursor (actualKeys S.A S.rd.col) (kappaQ_G3 S.sd.r S.d 1 W) := by
    rw [← rootCap_cursor_F7_G3 S hRC 1]
    exact (rootCap_low_F7_G3 S hRC hW1 hT1 hlow).1
  refine ⟨?_, ?_⟩
  · unfold respEdge
    rw [hRc]
    simp only [Option.bind_some]
    rw [resp_eq_parents_G3, hksB, hcurB, hpar]
  · unfold respEdge
    rw [hRa]
    simp only [Option.bind_some]
    rw [resp_eq_parents_G3, ← hksA, hcurA]

-- L-G010.15 step 2, low case (F7): at a low head `s_h` the decorated path detours along the
-- phase-`(h−1)` copy of the old terminal-to-root path to `s_{h−1}`
theorem head_low_detour_F7_G3 (S : OrdData_G3) {j φ : Nat} (hj : 1 ≤ j ∧ j ≤ S.n) {a c : ColAddr}
    (hp : PhasePair_D7_G3 S j a c φ) {h : Nat} (hh1 : 1 ≤ h) (hh : h ≤ φ)
    {W' : List (WithTop Key)} (hW' : Noninc W') (hT' : ∀ w ∈ W', w ≠ ⊤) (hlow : W' < S.termZ) :
    Path S.B (activeKeys_D7_G3 S.B c) c (kappaQ_G3 S.sd.r S.d (h - 1) W') (S.s h) (S.s (h - 1)) := by
  have hVA : CondV S.A := S.inL.1
  have hVB : CondV S.B := condV_ord S.inL S.kind S.out
  have hφj : φ ≤ j := by
    rcases hp with ⟨-, -, rfl⟩ | ⟨-, -, rfl⟩
    · unfold phaseOff; split_ifs <;> omega
    · omega
  obtain ⟨ks, hst, hRC, -, hkeys, hpar⟩ := activeKeys_head_F7_G3 S hj hp hh1 hh
  obtain ⟨hjm, q, hq, hrq, hqt, hpathA⟩ := term_detour_active_F7_G3 S hW' hlow
  have hdt : S.sd.r + S.d = S.sd.t := by
    have := (rootData_spec S.hsd S.hrd).2.2.2.2.1
    simp only [OrdData_G3.d, period]; omega
  -- the head edge `s_h → τ_{h−1}(q)`
  have hedge : respEdge S.B (activeKeys_D7_G3 S.B c) c (kappaQ_G3 S.sd.r S.d (h - 1) W') (S.s h) =
      some (q + (h - 1) * S.d) := by
    have hcl := (head_scan_F7_G3 S hRC (h - 1) hW').1 hlow
    have hlenq : (kappaQ_G3 S.sd.r S.d (h - 1) ((actualKeys S.A S.sd.col).take S.m)).length = S.m := by
      unfold kappaQ_G3; rw [List.length_map, length_sdcol_take_F7_G3]
    have hcur : cursor (kappaQ_G3 S.sd.r S.d (h - 1) ((actualKeys S.A S.sd.col).take S.m) ++
        ks.drop S.rd.cursor) (kappaQ_G3 S.sd.r S.d (h - 1) W') =
        cursor (actualKeys S.A S.sd.col) W' := by
      have e1 := cursor_take (kappaQ_G3 S.sd.r S.d (h - 1) ((actualKeys S.A S.sd.col).take S.m) ++
        ks.drop S.rd.cursor) (kappaQ_G3 S.sd.r S.d (h - 1) W') S.m
      rw [List.take_left' hlenq] at e1
      unfold kappaQ_G3 at e1
      rw [cursor_map (kappaQry_strictMono_G3 _ _ _), cursor_take] at e1
      unfold kappaQ_G3 at hcl ⊢
      omega
    unfold respEdge
    rw [hst]
    simp only [Option.bind_some]
    rw [resp_eq_parents_G3, hkeys, hcur, hpar]
    have hlm : (((parents S.A S.sd.col).take S.m).map (shiftVal S.sd.r ((h - 1) * S.d))).length =
        S.m := by
      have := length_sdcol_take_F7_G3 S
      rw [List.length_take] at this
      rw [List.length_map, List.length_take, length_parents_F7_G3, this]
    rw [List.getElem?_append_left (by omega), List.getElem?_map, List.getElem?_take_of_lt hjm, hq]
    simp [shiftVal, hrq]
  -- the copied old path, read in the head's active system
  have hp' : PhasePair_D7_G3 S h S.sd.col (S.headCol h) (h - 1) :=
    Or.inr ⟨rfl, phaseCol_headCol_G3 S h, rfl⟩
  have hcopy : ∀ x, Path S.A (activeKeys_D7_G3 S.A S.sd.col) S.sd.col W' x S.sd.r →
      Path S.B (activeKeys_D7_G3 S.B (S.headCol h)) (S.headCol h) (kappaQ_G3 S.sd.r S.d (h - 1) W')
        (x + (h - 1) * S.d) (S.sd.r + (h - 1) * S.d) := by
    intro x hx
    induction hx using Relation.ReflTransGen.head_induction_on with
    | refl => exact Relation.ReflTransGen.refl
    | @head x x' hxx' hx'r ih =>
      have hlt := edge_lt hVA hxx'
      have hr' := path_le hVA hx'r
      rw [edge_iff] at hxx'
      have he := respEdge_phase_D7_G3 S ⟨hh1, by omega⟩ hp' hT' (x := x) (by omega)
      rw [hxx'] at he
      have he' : respEdge S.B (activeKeys_D7_G3 S.B (S.headCol h)) (S.headCol h)
          (kappaQ_G3 S.sd.r S.d (h - 1) W') (x + (h - 1) * S.d) = some (x' + (h - 1) * S.d) := by
        rw [he]; simp [shiftVal, hr']
      exact Relation.ReflTransGen.head ((edge_iff _ _ _ _ _ _).mpr he') ih
  have hlift := path_activeKeys_onStack_F7_G3 S.B hVB hst
    (x := q + (h - 1) * S.d) (by
      simp only [OrdData_G3.s]
      have : h * S.d = (h - 1) * S.d + S.d := by rw [← Nat.succ_mul]; congr 1; omega
      omega) (hcopy q hpathA)
  have hs : S.s (h - 1) = S.sd.r + (h - 1) * S.d := rfl
  rw [hs]
  exact Relation.ReflTransGen.head ((edge_iff _ _ _ _ _ _).mpr hedge) hlift

/-! ### T3.2r helpers (branch G3): A in the key systems capped at the active containers

`activeKeys_D7_G3 E c` caps, in every column containing `c`, the key of the containing entry by `⊤`
(dropping the later keys). Along an actual cut path whose containing entries satisfy their cut
bounds, actual and active responses agree (L2.3a), in both directions; so A of `B` follows from
the active tests of `B` and S (the active analogue of `capping_reverse`), and the old actual tests
of `A` are active tests (barrier of `A`). -/

theorem container_self_G3 (c : ColAddr) : c.container c = none := by
  simp [ColAddr.container]

theorem activeKeys_self_G3 (E : Forest) (c : ColAddr) : activeKeys_D7_G3 E c c = actualKeys E c := by
  simp [activeKeys_D7_G3, container_self_G3]

-- two scans that agree before `u` and both stop by `u` have the same cursor
theorem cursor_eq_take_G3 {α : Type} [LinearOrder α] {s₁ s₂ W : List α} {u : Nat}
    (htake : s₁.take u = s₂.take u) (h₁ : cursor s₁ W ≤ u) (h₂ : cursor s₂ W ≤ u) :
    cursor s₁ W = cursor s₂ W := by
  have e₁ := cursor_take s₁ W u
  have e₂ := cursor_take s₂ W u
  rw [Nat.min_eq_right h₂] at e₂
  rw [Nat.min_eq_right h₁, htake, e₂] at e₁
  exact e₁.symm

-- capping at `u` does not change a `⊤`-free scan that stops by `u`
theorem cursor_active_G3 {K W : List (WithTop Key)} {u : Nat} (hu : u ≤ K.length)
    (hT : ∀ w ∈ W, w ≠ ⊤) (hle : cursor K W ≤ u) : cursor (K.take u ++ [⊤]) W = cursor K W := by
  have hl : (K.take u).length = u := by rw [List.length_take]; omega
  refine cursor_eq_take_G3 (u := u) ?_ ?_ hle
  · rw [List.take_left' hl]
  · have := cursor_append_top_D7_G3 W (K.take u) hT
    omega

-- along an actual cut path with the cut bounds, active and actual responses agree
theorem resp_active_eq_G3 {E : Forest} {c : ColAddr} (hc : c ∈ E.colAddrs) {k : Nat}
    (hcut : ∀ e ∈ E.entryAddrs, e.Contains c → CutBound E e c k) {z : Nat}
    (hz : Path E (actualKeys E) c (cutQuery (actualKeys E c) k) (cutStart E c k) z)
    {o : ColAddr} (ho : c.resolve 0 z = some o) :
    resp E (activeKeys_D7_G3 E c) o (cutQuery (actualKeys E c) k) =
      resp E (actualKeys E) o (cutQuery (actualKeys E c) k) := by
  rw [resp_eq_parents, resp_eq_parents]
  cases hco : o.container c with
  | none => simp only [activeKeys_D7_G3, hco]
  | some e =>
    simp only [activeKeys_D7_G3, hco]
    obtain ⟨hecol, hcont⟩ := (ColAddr.container_spec o c e).1 hco
    have hcont' : e.Contains c := hcont
    have he : e ∈ E.entryAddrs := mem_entryAddrs_of_contains hc hcont'
    have hoz : o.num 0 = z := ColAddr.resolve_num ho
    have hb := hcut e he hcont' (by rw [hecol, hoz]; exact hz)
    rw [boundary_eq_cutQuery, hecol] at hb
    have hvl : e.idx < (actualKeys E o).length := by
      rw [length_actualKeys, ← hecol]; exact idx_lt_of_mem_entryAddrs he
    have hle := cursor_le_of_lt_cutQuery (cutQuery_noninc _ _) hvl hb
    rw [cursor_active_G3 hvl.le (ne_top_of_mem_cutQuery_D7_G3 _ _ _) hle]

theorem active_path_of_actual_G3 {E : Forest} {c : ColAddr} (hc : c ∈ E.colAddrs) {k : Nat}
    (hcut : ∀ e ∈ E.entryAddrs, e.Contains c → CutBound E e c k) {y : Nat}
    (h : Path E (actualKeys E) c (cutQuery (actualKeys E c) k) (cutStart E c k) y) :
    Path E (activeKeys_D7_G3 E c) c (cutQuery (actualKeys E c) k) (cutStart E c k) y := by
  induction h with
  | refl => exact Relation.ReflTransGen.refl
  | tail hxz hzy ih =>
    obtain ⟨o, ho, hr⟩ := hzy
    exact ih.tail ⟨o, ho, (resp_active_eq_G3 hc hcut hxz ho).trans hr⟩

theorem actual_path_of_active_G3 {E : Forest} {c : ColAddr} (hc : c ∈ E.colAddrs) {k : Nat}
    (hcut : ∀ e ∈ E.entryAddrs, e.Contains c → CutBound E e c k) {y : Nat}
    (h : Path E (activeKeys_D7_G3 E c) c (cutQuery (actualKeys E c) k) (cutStart E c k) y) :
    Path E (actualKeys E) c (cutQuery (actualKeys E c) k) (cutStart E c k) y := by
  induction h with
  | refl => exact Relation.ReflTransGen.refl
  | tail _ hzy ih =>
    obtain ⟨o, ho, hr⟩ := hzy
    exact ih.tail ⟨o, ho, (resp_active_eq_G3 hc hcut ih ho).symm.trans hr⟩

-- the old tests of an `L`-expression are active tests (barrier, L2.3)
theorem aAt_active_of_inL_G3 {E : Forest} (hL : InL E) {c : ColAddr} (hc : c ∈ E.colAddrs)
    (i : Nat) : AAt E (activeKeys_D7_G3 E c) c i := by
  intro p hp
  rw [activeKeys_self_G3]
  have hk : i ≤ (parents E c).length := (List.getElem?_eq_some_iff.1 hp).1.le
  exact active_path_of_actual_G3 hc
    (fun e he hec => (barrier_joint hL.1 hL.2.2.2.1 hL.2.2.2.2 he hc hec hk).1)
    ((condAK_iff _ _).1 hL.2.2.2.1 c hc i p hp)

-- the active analogue of `revPred_step` (L2.4a)
theorem revPred_step_active_G3 {E : Forest} (hV : CondV E) (hS : CondS E)
    (hA : ∀ c ∈ E.colAddrs, ∀ i, AAt E (activeKeys_D7_G3 E c) c i) {c : ColAddr}
    (hc : c ∈ E.colAddrs) (i : Nat)
    (ihlow : ∀ o ∈ E.colAddrs, o.num 0 < c.num 0 → ∀ v, RevPred E o v)
    (ihprev : ∀ i' < i, RevPred E c i') : RevPred E c i := by
  by_cases hi : i < (parents E c).length
  · have hcut : ∀ e ∈ E.entryAddrs, e.Contains c → CutBound E e c i := fun e he hec =>
      cutBound_of_returns hV he hc hec hi.le
        (fun o ho heo hlt v => (ihlow o ho hlt v).2 e he heo)
        (fun k' hk' => (ihprev k' hk').2 e he hec)
    have hAA : AAt E (actualKeys E) c i := by
      intro p hp
      have h := hA c hc i p hp
      rw [activeKeys_self_G3] at h
      exact actual_path_of_active_G3 hc hcut h
    exact ⟨hAA, fun e he hec => returnBound_of_cutBound hS he hc hec hAA (hcut e he hec)⟩
  · have hnone : (parents E c)[i]? = none := List.getElem?_eq_none (by omega)
    refine ⟨fun p hp => ?_, fun e _ _ hp => ?_⟩ <;> rw [hnone] at hp <;> cases hp

-- uncapping from the active systems (the active analogue of `capping_reverse`, L2.4a)
theorem condA_of_active_G3 {E : Forest} (hV : CondV E) (hS : CondS E)
    (hA : ∀ c ∈ E.colAddrs, ∀ i, AAt E (activeKeys_D7_G3 E c) c i) : CondA E := by
  have H : ∀ N, ∀ c ∈ E.colAddrs, c.num 0 = N → ∀ i, RevPred E c i := by
    intro N
    induction N using Nat.strong_induction_on with
    | _ N ihN =>
      intro c hc hN i
      induction i using Nat.strong_induction_on with
      | _ i ihi =>
        exact revPred_step_active_G3 hV hS hA hc i
          (fun o ho hlt v => ihN _ (hN ▸ hlt) o ho rfl v) ihi
  exact (condAK_iff _ _).2 fun c hc i => (H _ c hc rfl i).1

/-! ### T3.2r helpers (branch G3): the forward phase path (T3.2q.2 in the active systems) -/

theorem kappaQ_zero_G3 (r d : Nat) (W : List (WithTop Key)) : kappaQ_G3 r d 0 W = W := by
  unfold kappaQ_G3
  conv_rhs => rw [← List.map_id W]
  congr 1
  funext x
  cases x with
  | top => rfl
  | coe k => simp [kappa_zero_E3]

theorem kappaQ_ne_top_G3 (r d j : Nat) {W : List (WithTop Key)} (hT : ∀ w ∈ W, w ≠ ⊤) :
    ∀ w ∈ kappaQ_G3 r d j W, w ≠ ⊤ := by
  intro w hw
  simp only [kappaQ_G3, List.mem_map] at hw
  obtain ⟨w', hw', rfl⟩ := hw
  have := hT w' hw'
  cases w' with
  | top => exact absurd rfl this
  | coe k => simp

theorem coe_list_of_ne_top_G3 :
    ∀ (W : List (WithTop Key)), (∀ w ∈ W, w ≠ ⊤) → ∃ W₀ : List Key, W = W₀.map (↑)
  | [], _ => ⟨[], rfl⟩
  | w :: ws, h => by
    obtain ⟨W₀, hW₀⟩ := coe_list_of_ne_top_G3 ws (fun x hx => h x (by simp [hx]))
    cases w with
    | top => exact absurd rfl (h ⊤ (by simp))
    | coe k => exact ⟨k :: W₀, by simp [hW₀]⟩

-- phase `0`: the root column of `B` reads like that of `A`
theorem respEdge_root_zero_G3 (S : OrdData_G3) {j : Nat} (hj : 1 ≤ j) {a c : ColAddr}
    (hp : PhasePair_D7_G3 S j a c 0) (W : List (WithTop Key)) :
    respEdge S.B (activeKeys_D7_G3 S.B c) c W S.sd.r =
      respEdge S.A (activeKeys_D7_G3 S.A a) a W S.sd.r := by
  obtain ⟨hRa, hRc, -, b, hb⟩ := phasePair_root_D7_G3 S hp
  obtain ⟨hres, -⟩ := rootData_path S.hsd S.hrd
  have hsdR : S.sd.col.OnStack S.rd.col := ((ColAddr.resolve_spec 0 _ _ _).mp hres).1
  have hE : S.A ≠ Tree.empty := by
    intro h
    have := S.hsd
    rw [h, stopData_eq_none_of_lastCol (Or.inl rfl)] at this
    cases this
  obtain ⟨Z, hB⟩ : ∃ Z, S.B = context S.A S.sd Z := by
    have := expand_eq_iterate hE S.inL.1 S.inL.2.1 S.kind S.hsd S.hrd S.kernelDefined S.n
    rw [S.out] at this
    exact ⟨_, Option.some.inj this⟩
  obtain ⟨hpar, htake, hnone⟩ := colAt_context_onStack_G3 S.hsd Z hsdR
  rw [← hB] at hpar htake hnone
  have hcR : S.rd.col.container c = S.rd.col.container S.sd.col := by
    rw [hb]; exact container_underCol_of_onStack_G3 hsdR b
  have haR : S.rd.col.container a = S.rd.col.container S.sd.col := by
    rcases hp with ⟨-, -, hφ⟩ | ⟨rfl, -, -⟩
    · have haq : isQMat S.sd a = true := by
        by_contra h
        simp only [phaseOff, h, if_false] at hφ
        omega
      obtain ⟨q, rest, hq, -⟩ := isQMat_spec_G3 S.sd haq
      have ha : a = underCol S.sd.col ⟨(0, q) :: rest, a.col⟩ := by
        obtain ⟨ap, ac⟩ := a
        simp only at hq
        simp [underCol, hq]
      rw [ha]; exact container_underCol_of_onStack_G3 hsdR _
    · rfl
  have hks : activeKeys_D7_G3 S.B c S.rd.col = activeKeys_D7_G3 S.A a S.rd.col := by
    simp only [activeKeys_D7_G3, hcR, haR]
    cases hRs : S.rd.col.container S.sd.col with
    | none => simp only [actualKeys, hnone hRs]
    | some e =>
      simp only
      congr 1
      have h1 := htake e hRs
      simp only [actualKeys, ← List.map_take]
      congr 1
      cases hBo : S.B.colAt S.rd.col with
      | none =>
        cases hAo : S.A.colAt S.rd.col with
        | none => rfl
        | some _ => rw [hBo, hAo] at h1; cases h1
      | some C1 =>
        cases hAo : S.A.colAt S.rd.col with
        | none => rw [hBo, hAo] at h1; cases h1
        | some C2 =>
          rw [hBo, hAo] at h1
          simpa using h1
  unfold respEdge
  rw [hRc, hRa]
  simp only [Option.bind_some]
  rw [resp_eq_parents_G3, resp_eq_parents_G3, hks, hpar]

-- a low query detours through all heads `s_h, …, s_1` down to `s_0 = r` (G9.5 iterated)
theorem low_chain_G3 (S : OrdData_G3) {j φ : Nat} (hj : 1 ≤ j ∧ j ≤ S.n) {a c : ColAddr}
    (hp : PhasePair_D7_G3 S j a c φ) (hφ : 1 ≤ φ) {W : List (WithTop Key)} (hW : Noninc W)
    (hT : ∀ w ∈ W, w ≠ ⊤) (hlow : kappaQ_G3 S.sd.r S.d 1 W < S.termZ) :
    ∀ h, h ≤ φ →
      Path S.B (activeKeys_D7_G3 S.B c) c (kappaQ_G3 S.sd.r S.d φ W) (S.s h) (S.s 0) := by
  obtain ⟨W₀, rfl⟩ := coe_list_of_ne_top_G3 W hT
  have hlow0 : kappaQ_G3 S.sd.r S.d φ (W₀.map (↑)) <
      kappaQ_G3 S.sd.r S.d (φ - 1) S.termZ := by
    rw [← kappaQ_lt_iff_G3 S.sd.r S.d (φ - 1)] at hlow
    rwa [kappaQ_add_G3, show φ - 1 + 1 = φ by omega] at hlow
  intro h
  induction h with
  | zero => intro _; exact Relation.ReflTransGen.refl
  | succ h ih =>
    intro hh
    have hl := low_all_heads_G3 S hφ W₀ hlow0 (h := h + 1) ⟨by omega, hh⟩
    rw [Nat.add_sub_cancel] at hl
    have hW' : Noninc (kappaQ_G3 S.sd.r S.d (φ - h) (W₀.map (↑))) := kappaQ_noninc_G3 _ _ _ hW
    have hT' := kappaQ_ne_top_G3 S.sd.r S.d (φ - h) hT
    have hlow' : kappaQ_G3 S.sd.r S.d (φ - h) (W₀.map (↑)) < S.termZ := by
      rw [← kappaQ_lt_iff_G3 S.sd.r S.d h, kappaQ_add_G3, show h + (φ - h) = φ by omega]
      exact hl
    have hd := head_low_detour_F7_G3 S hj hp (h := h + 1) (by omega) hh hW' hT' hlow'
    rw [Nat.add_sub_cancel, kappaQ_add_G3, show h + (φ - h) = φ by omega] at hd
    exact hd.trans (ih (by omega))

-- T3.2q.2 (active form): an old active path of `a` is copied to a path of its phase copy `c`
-- (high heads answer like the old root, low heads detour down to `r`)
theorem phase_path_fwd_G3 (S : OrdData_G3) {j φ : Nat} (hj : 1 ≤ j ∧ j ≤ S.n) {a c : ColAddr}
    (hp : PhasePair_D7_G3 S j a c φ) {W : List (WithTop Key)} (hW : Noninc W)
    (hT : ∀ w ∈ W, w ≠ ⊤) {x y : Nat} (hpath : Path S.A (activeKeys_D7_G3 S.A a) a W x y) :
    Path S.B (activeKeys_D7_G3 S.B c) c (kappaQ_G3 S.sd.r S.d φ W)
      (shiftVal S.sd.r (φ * S.d) x) (shiftVal S.sd.r (φ * S.d) y) := by
  have hVA : CondV S.A := S.inL.1
  induction hpath using Relation.ReflTransGen.head_induction_on with
  | refl => exact Relation.ReflTransGen.refl
  | @head x x' hxx' hx'y ih =>
    have hx'x : x' < x := edge_lt hVA hxx'
    rw [edge_iff] at hxx'
    rcases lt_trichotomy x S.sd.r with hxr | hxr | hxr
    · have he := (respEdge_phase_active_D7_G3 S hj hp hT x).2 hxr
      rw [← he] at hxx'
      have e1 : shiftVal S.sd.r (φ * S.d) x = x := by unfold shiftVal; rw [if_neg (by omega)]
      have e2 : shiftVal S.sd.r (φ * S.d) x' = x' := by unfold shiftVal; rw [if_neg (by omega)]
      rw [e1]; rw [e2] at ih
      exact Relation.ReflTransGen.head ((edge_iff _ _ _ _ _ _).mpr hxx') ih
    · subst hxr
      have e2 : shiftVal S.sd.r (φ * S.d) x' = x' := by unfold shiftVal; rw [if_neg (by omega)]
      rw [e2] at ih
      rcases Nat.eq_zero_or_pos φ with hφ0 | hφ
      · subst hφ0
        have he := respEdge_root_zero_G3 S hj.1 hp (kappaQ_G3 S.sd.r S.d 0 W)
        rw [kappaQ_zero_G3] at he
        rw [← he] at hxx'
        have e1 : shiftVal S.sd.r (0 * S.d) S.sd.r = S.sd.r := by simp [shiftVal]
        rw [e1]
        refine Relation.ReflTransGen.head ((edge_iff _ _ _ _ _ _).mpr ?_) ih
        rw [kappaQ_zero_G3]; exact hxx'
      · have e1 : shiftVal S.sd.r (φ * S.d) S.sd.r = S.s φ := by
          unfold shiftVal OrdData_G3.s; rw [if_pos le_rfl]
        rw [e1]
        by_cases hhigh : S.termZ ≤ kappaQ_G3 S.sd.r S.d 1 W
        · have he := respEdge_head_high_D7_G3 S hj hp hφ hW hT hhigh
          rw [← he] at hxx'
          exact Relation.ReflTransGen.head ((edge_iff _ _ _ _ _ _).mpr hxx') ih
        · have hlow := lt_of_not_ge hhigh
          have hch := low_chain_G3 S hj hp hφ hW hT hlow φ le_rfl
          obtain ⟨hB1, hA1⟩ := respEdge_root_low_F7_G3 S hj hp hφ hW hT hlow φ
          have he : respEdge S.B (activeKeys_D7_G3 S.B c) c (kappaQ_G3 S.sd.r S.d φ W) S.sd.r =
              some x' := by
            rw [hB1, ← hA1]; exact hxx'
          have hs0 : S.s 0 = S.sd.r := by simp [OrdData_G3.s]
          rw [hs0] at hch
          exact hch.trans (Relation.ReflTransGen.head ((edge_iff _ _ _ _ _ _).mpr he) ih)
    · have he := (respEdge_phase_active_D7_G3 S hj hp hT x).1 hxr
      rw [hxx', Option.map_some] at he
      have e1 : shiftVal S.sd.r (φ * S.d) x = x + φ * S.d := by
        unfold shiftVal; rw [if_pos hxr.le]
      rw [e1]
      exact Relation.ReflTransGen.head ((edge_iff _ _ _ _ _ _).mpr he) ih

/-! ### T3.2r helpers (branch G3): the test classes -/

theorem List.take_take_of_le_G3 {α : Type} {l : List α} {k m : Nat} (h : k ≤ m) :
    (l.take m).take k = l.take k := by
  rw [List.take_take, Nat.min_eq_left h]



-- the hole region is closed upward along stacks
theorem kerUnder_of_onStack_G3 {h c o : ColAddr} (hs : c.OnStack o) (hu : KerUnder h o) :
    KerUnder h c := by
  rcases hs with ⟨k, ck, ik, hk, hop, hle⟩ | ⟨hop, hlt⟩
  · have hk' : k < c.path.length := (List.getElem?_eq_some_iff.1 hk).1
    have hck : c.path[k] = (ck, ik) := (List.getElem?_eq_some_iff.1 hk).2
    have hcp : c.path = c.path.take k ++ (ck, ik) :: c.path.drop (k + 1) := by
      conv_lhs => rw [← List.take_append_drop k c.path]
      rw [List.drop_eq_getElem_cons hk', hck]
    rcases hu with ⟨h1, h2⟩ | ⟨c0, e0, rest, h1, h2⟩
    · right
      refine ⟨ck, ik, c.path.drop (k + 1), ?_, by omega⟩
      conv_lhs => rw [hcp]
      rw [← hop, h1]
    · right
      refine ⟨c0, e0, rest ++ (ck, ik) :: c.path.drop (k + 1), ?_, h2⟩
      conv_lhs => rw [hcp]
      rw [← hop, h1]
      simp
  · rcases hu with ⟨h1, h2⟩ | ⟨c0, e0, rest, h1, h2⟩
    · left; exact ⟨by rw [← hop, h1], by omega⟩
    · right; exact ⟨c0, e0, rest, by rw [← hop, h1], h2⟩

-- a column of `A` outside the hole reads alike in every context: the same parents, and the same
-- keys before the entry containing the stopping column (all keys if there is none)
theorem ctx_rel_G3 {A : Forest} {sd : StopData} (hsd : stopData A = some sd) (Z : Forest)
    {o : ColAddr} (hu : ¬ KerUnder sd.col o) (ho : o ∈ A.colAddrs) :
    parents (context A sd Z) o = parents A o ∧
      (∀ e, o.container sd.col = some e →
        (actualKeys (context A sd Z) o).take e.idx = (actualKeys A o).take e.idx) ∧
      (o.container sd.col = none → actualKeys (context A sd Z) o = actualKeys A o) := by
  cases hcs : o.container sd.col with
  | some e =>
    have hst : sd.col.OnStack o := onStack_of_container_G3 hcs
    obtain ⟨hpar, htake, -⟩ := colAt_context_onStack_G3 hsd Z hst
    refine ⟨hpar, fun e' he' => ?_, fun h => by cases h⟩
    cases he'
    have h1 := htake e hcs
    simp only [actualKeys, ← List.map_take]
    congr 1
    cases hBo : (context A sd Z).colAt o with
    | none =>
      cases hAo : A.colAt o with
      | none => rfl
      | some _ => rw [hBo, hAo] at h1; cases h1
    | some C1 =>
      cases hAo : A.colAt o with
      | none => rw [hBo, hAo] at h1; cases h1
      | some C2 =>
        rw [hBo, hAo] at h1
        simpa using h1
  | none =>
    have hne : o ≠ sd.col := fun h => hu (by rw [h]; exact Or.inl ⟨rfl, le_rfl⟩)
    have hin : sd.col.container o = none := by
      cases h : sd.col.container o with
      | none => rfl
      | some e =>
        exfalso
        apply hu
        obtain ⟨hecol, rest, hrest⟩ := (ColAddr.container_spec _ _ _).1 h
        right
        refine ⟨sd.col.col, e.idx, rest, ?_, le_rfl⟩
        rw [← hrest, EntryAddr.heightPath, hecol]
        simp
    have heq := colAt_context_of_not_route_G3 hsd Z ho hne hin hcs
    refine ⟨by simp [parents, heq], fun e he => ?_, fun _ => by simp [actualKeys, heq]⟩
    cases he

/-- T3.2r (G3), class (a): tests of a context column (its stack is context, and its active key
lists are the old ones). -/
theorem aAt_ctx_G3 (S : OrdData_G3) {c : ColAddr} (hc : c ∈ S.B.colAddrs)
    (hctx : c ∈ (context S.A S.sd Tree.empty).colAddrs) (i : Nat) :
    AAt S.B (activeKeys_D7_G3 S.B c) c i := by
  have hE : S.A ≠ Tree.empty := by
    intro h
    have := S.hsd
    rw [h, stopData_eq_none_of_lastCol (Or.inl rfl)] at this
    cases this
  obtain ⟨Z, hB⟩ : ∃ Z, S.B = context S.A S.sd Z := by
    have := expand_eq_iterate hE S.inL.1 S.inL.2.1 S.kind S.hsd S.hrd S.kernelDefined S.n
    rw [S.out] at this
    exact ⟨_, Option.some.inj this⟩
  obtain ⟨hR, hH⟩ := ker_stop_hole S.hsd
  -- `c` lies outside the hole, hence so does its whole stack
  have hu : ¬ KerUnder S.sd.col c := by
    intro hu
    have hu' : KerUnder (kerHoleAt S.sd.depth S.A) c := by rw [hH]; exact hu
    obtain ⟨y, hy, -⟩ := ker_under_exhaust Tree.empty hR hu' hctx
    rw [Tree.mem_colAddrs_iff] at hy
    unfold Tree.colAt at hy
    cases hp : y.path with
    | nil => rw [hp] at hy; simp [Tree.forestAt, Tree.empty, Tree.cols] at hy
    | cons x rest =>
      obtain ⟨c0, e0⟩ := x
      rw [hp, ker_forestAt_cons] at hy
      simp [Tree.empty, Tree.cols] at hy
  have hcA : c ∈ S.A.colAddrs := by
    have := ker_off_isSome Z S.sd.depth S.A hR c (by rw [hH]; exact hu)
    rw [Tree.mem_colAddrs_iff] at hc ⊢
    rw [← this]
    rw [hB] at hc
    exact hc
  have hsdR : S.sd.col ∈ routeCols S.A := (stopData_spec S.hsd).2.2.2.1
  -- the columns of the stack read alike
  have hstack : ∀ z o, c.resolve 0 z = some o → o ∈ S.A.colAddrs →
      parents S.B o = parents S.A o ∧
        activeKeys_D7_G3 S.B c o = activeKeys_D7_G3 S.A c o := by
    intro z o hres ho
    have hst : c.OnStack o := ((ColAddr.resolve_spec 0 c o z).1 hres).1
    have huo : ¬ KerUnder S.sd.col o := fun h => hu (kerUnder_of_onStack_G3 hst h)
    obtain ⟨hpar, htk, hnc⟩ := ctx_rel_G3 S.hsd Z huo ho
    rw [← hB] at hpar htk hnc
    refine ⟨hpar, ?_⟩
    unfold activeKeys_D7_G3
    cases hoc : o.container c with
    | some e' =>
      simp only
      congr 1
      obtain ⟨he'col, he'c⟩ := (ColAddr.container_spec o c e').1 hoc
      have he'mem : e' ∈ S.A.entryAddrs := mem_entryAddrs_of_contains hcA he'c
      have he'lt := idx_lt_of_mem_entryAddrs he'mem
      rw [he'col] at he'lt
      cases hos : o.container S.sd.col with
      | none => rw [hnc hos]
      | some e =>
        have hl := container_sdcol_last_G3 S hos
        have hlen : (parents S.A o).length = ((S.A.colAt o).getD []).length := by
          simp [parents]
        rw [← List.take_take_of_le_G3 (m := e.idx) (by omega),
          ← List.take_take_of_le_G3 (l := actualKeys S.A o) (m := e.idx) (by omega), htk e hos]
    | none =>
      simp only
      cases hos : o.container S.sd.col with
      | none => rw [hnc hos]
      | some e =>
        exfalso
        have hor := container_mem_routeCols_D7_G3 hsdR hos
        obtain ⟨v, -, hvc⟩ := routeCols_visible hcA hor hres
        have : o.container c = some ⟨o, v⟩ := (ColAddr.container_spec o c _).2 ⟨rfl, hvc⟩
        rw [hoc] at this
        cases this
  -- the test of `c` is the old test
  intro p hp
  rw [activeKeys_self_G3]
  have huc := hu
  obtain ⟨hparc, htkc, hncc⟩ := ctx_rel_G3 S.hsd Z huc hcA
  rw [← hB] at hparc htkc hncc
  rw [hparc] at hp
  have hiA : i < (parents S.A c).length := (List.getElem?_eq_some_iff.1 hp).1
  have hW : cutQuery (actualKeys S.B c) i = cutQuery (actualKeys S.A c) i := by
    unfold cutQuery
    congr 1
    cases hos : c.container S.sd.col with
    | none => rw [hncc hos]
    | some e =>
      have hl := container_sdcol_last_G3 S hos
      rw [← List.take_take_of_le_G3 (m := e.idx) (by omega),
        ← List.take_take_of_le_G3 (l := actualKeys S.A c) (m := e.idx) (by omega), htkc e hos]
  have hst : cutStart S.B c i = cutStart S.A c i := by
    unfold cutStart; rw [hparc]
  have hA := aAt_active_of_inL_G3 S.inL hcA i p hp
  rw [activeKeys_self_G3] at hA
  rw [hW, hst]
  clear hW hst hp
  induction hA with
  | refl => exact Relation.ReflTransGen.refl
  | tail _ hzy ih =>
    obtain ⟨o, ho, hr⟩ := hzy
    rw [resp_eq_parents] at hr
    have hoA : o ∈ S.A.colAddrs := mem_colAddrs_of_parents hr
    obtain ⟨h1, h2⟩ := hstack _ o ho hoA
    refine ih.tail ⟨o, ho, ?_⟩
    rw [resp_eq_parents, h1, h2]
    exact hr

/-- T3.2r (G3), classes (b), (c): tests of a phase copy of a template column. -/
theorem aAt_tmpl_G3 (S : OrdData_G3) {j : Nat} (hj : 1 ≤ j ∧ j ≤ S.n) {a c : ColAddr}
    (ha : IsTmplCol S.A S.sd S.rd a) (hc : phaseCol S.sd S.rd j a = some c) (i : Nat) :
    AAt S.B (activeKeys_D7_G3 S.B c) c i := by
  intro p hp
  rw [activeKeys_self_G3]
  have hpp : PhasePair_D7_G3 S j a c (phaseOff S.sd j a) := Or.inl ⟨ha, hc, rfl⟩
  have hpar := parents_phaseCol_D7_G3 S hj ha hc
  rw [hpar, List.getElem?_map] at hp
  obtain ⟨p0, hp0, rfl⟩ := Option.map_eq_some_iff.mp hp
  have hiA : i < (parents S.A a).length := (List.getElem?_eq_some_iff.1 hp0).1
  -- the keys before `i` are `κ_φ`-images
  have hkeys : (actualKeys S.B c).take i =
      kappaQ_G3 S.sd.r S.d (phaseOff S.sd j a) ((actualKeys S.A a).take i) := by
    by_cases hroute : OnHoleRoute S.sd a
    · have hq : isQMat S.sd a = false := by
        cases hq : isQMat S.sd a with
        | false => rfl
        | true =>
          exfalso
          obtain ⟨q, rest, hqp, -⟩ := isQMat_spec_G3 S.sd hq
          have := hroute.length_le
          rw [hqp] at this
          simp at this
      have hφj : phaseOff S.sd j a = j := by simp [phaseOff, hq]
      obtain ⟨-, hk⟩ := copyCol_content_F7_G3 S hj.2 ha hq (h := j)
      have hcc : S.copyCol j a = c := by
        simp [OrdData_G3.copyCol, show j ≠ 0 by omega, hc]
      rw [hcc] at hk
      rw [hφj]
      exact hk i (fun e he => by have := container_sdcol_last_G3 S he; omega)
    · obtain ⟨-, hk⟩ := phaseCol_content_closed_F7_G3 S hj ha hroute hc
      rw [hk]; unfold kappaQ_G3; rw [List.map_take]
  have hW : cutQuery (actualKeys S.B c) i =
      kappaQ_G3 S.sd.r S.d (phaseOff S.sd j a) (cutQuery (actualKeys S.A a) i) := by
    unfold cutQuery
    rw [hkeys]
    unfold kappaQ_G3
    rw [nu_map (kappaQry_strictMono_G3 _ _ _)]
  have hst : cutStart S.B c i =
      shiftVal S.sd.r (phaseOff S.sd j a * S.d) (cutStart S.A a i) := by
    obtain ⟨hra, hnum⟩ := phasePair_num_D7_G3 S hj hpp
    unfold cutStart
    split_ifs with hi0
    · rw [hnum]; unfold shiftVal; rw [if_pos (by omega)]; omega
    · rw [hpar, List.getElem?_map]
      obtain ⟨q, hq⟩ : ∃ q, (parents S.A a)[i - 1]? = some q :=
        ⟨_, List.getElem?_eq_getElem (by omega)⟩
      rw [hq]; rfl
  have hA := aAt_active_of_inL_G3 S.inL (mem_colAddrs_of_parents hp0) i p0 hp0
  rw [activeKeys_self_G3] at hA
  rw [hW, hst]
  exact phase_path_fwd_G3 S hj hpp (cutQuery_noninc _ _) (ne_top_of_mem_cutQuery_D7_G3 _ _ _) hA

/-- T3.2r (G3), classes (d), (e), (f): tests of a head (query prefix: the old terminal tests;
first restored entry: the terminal's last test and the root edge at `Z`; later restored entries:
the old root tests at the reset boundary, T3.2p). -/
theorem aAt_head_G3 (S : OrdData_G3) {j : Nat} (hj : 1 ≤ j ∧ j ≤ S.n) {c : ColAddr}
    (hc : phaseCol S.sd S.rd j S.rd.col = some c) (i : Nat) :
    AAt S.B (activeKeys_D7_G3 S.B c) c i := by
  intro p hp
  rw [activeKeys_self_G3]
  have hpp : PhasePair_D7_G3 S j S.sd.col c (j - 1) := Or.inr ⟨rfl, hc, rfl⟩
  have hVA : CondV S.A := S.inL.1
  obtain ⟨hmB, hparm, hkeym⟩ := headQuery_prefix_D7_G3 S hj hc
  obtain ⟨col, hBcol, hlen, -, hU⟩ := colAt_head S.inL S.kind S.hsd S.hrd S.out hj hc
  obtain ⟨hra, hnum⟩ := phasePair_num_D7_G3 S hj hpp
  obtain ⟨hcolA, -, -, -⟩ := stopData_spec S.hsd
  obtain ⟨hres, hrnum, -⟩ := rootData_path S.hsd S.hrd
  have hrdmem : S.rd.col ∈ S.A.colAddrs := (rootData_spec S.hsd S.hrd).2.2.2.2.2.1
  have hsdmem : S.sd.col ∈ S.A.colAddrs := by rw [Tree.mem_colAddrs_iff, hcolA]; rfl
  have hm : S.sd.Q.length = S.m := rfl
  have hparA : parents S.A S.sd.col = S.sd.Q.map Prod.fst ++ [S.sd.r] := by
    simp [parents, hcolA]
  have hBpar : parents S.B c = col.map Prod.fst := by simp [parents, hBcol]
  -- starts and queries of the cuts `k ≤ m`
  have hpfx : ∀ k, k < S.m → (parents S.B c)[k]? =
      ((parents S.A S.sd.col)[k]?).map (shiftVal S.sd.r ((j - 1) * S.d)) := by
    intro k hk
    rw [← List.getElem?_take_of_lt hk, hparm, List.getElem?_map, List.getElem?_take_of_lt hk]
  have hst : ∀ k, k ≤ S.m → cutStart S.B c k =
      shiftVal S.sd.r ((j - 1) * S.d) (cutStart S.A S.sd.col k) := by
    intro k hk
    unfold cutStart
    split_ifs with hk0
    · rw [hnum]; unfold shiftVal; rw [if_pos (by omega)]; omega
    · rw [hpfx (k - 1) (by omega)]
      obtain ⟨q, hq⟩ : ∃ q, (parents S.A S.sd.col)[k - 1]? = some q :=
        ⟨_, List.getElem?_eq_getElem (by rw [hparA]; simp; omega)⟩
      rw [hq]; rfl
  have hqk : ∀ k, k ≤ S.m → cutQuery (actualKeys S.B c) k =
      kappaQ_G3 S.sd.r S.d (j - 1) (cutQuery (actualKeys S.A S.sd.col) k) := by
    intro k hk
    have : (actualKeys S.B c).take k =
        kappaQ_G3 S.sd.r S.d (j - 1) ((actualKeys S.A S.sd.col).take k) := by
      rw [← List.take_take_of_le_G3 hk, hkeym]
      unfold kappaQ_G3
      rw [List.map_take, List.map_take, List.take_take, Nat.min_eq_left hk]
    unfold cutQuery
    rw [this]
    unfold kappaQ_G3
    rw [nu_map (kappaQry_strictMono_G3 _ _ _)]
  have hlenB : (parents S.B c).length = S.m + (unconsumed S.A S.rd).length := by
    rw [hBpar, List.length_map, hlen]; rfl
  have hiB : i < S.m + (unconsumed S.A S.rd).length := by
    rw [← hlenB]; exact (List.getElem?_eq_some_iff.1 hp).1
  -- restored entries of the head are the unconsumed root entries
  have hrest : ∀ v x, (unconsumed S.A S.rd)[v]? = some x →
      (parents S.B c)[S.m + v]? = some x.1 ∧
        (parents S.A S.rd.col)[S.rd.cursor + v]? = some x.1 ∧ x.1 < S.sd.r := by
    intro v x hx
    obtain ⟨y, hy, hy1, -⟩ := hU v x hx
    rw [hm] at hy
    refine ⟨by rw [hBpar, List.getElem?_map, hy, Option.map_some, hy1], ?_,
      ker_unconsumed_lt hVA S.hsd S.hrd x (List.mem_of_getElem? hx)⟩
    unfold unconsumed rootCol at hx
    rw [List.getElem?_drop] at hx
    simp [parents, hx]
  rcases Nat.lt_trichotomy i S.m with him | rfl | him
  · -- (d) the query prefix: the old terminal tests
    rw [hpfx i him] at hp
    obtain ⟨p0, hp0, rfl⟩ := Option.map_eq_some_iff.mp hp
    have hA := aAt_active_of_inL_G3 S.inL hsdmem i p0 hp0
    rw [activeKeys_self_G3] at hA
    rw [hqk i him.le, hst i him.le]
    exact phase_path_fwd_G3 S hj hpp (cutQuery_noninc _ _) (ne_top_of_mem_cutQuery_D7_G3 _ _ _) hA
  · -- (e) the first restored entry: the terminal's last test, then the root edge at `Z`
    obtain ⟨x, hx⟩ : ∃ x, (unconsumed S.A S.rd)[0]? = some x :=
      ⟨_, List.getElem?_eq_getElem (by omega)⟩
    obtain ⟨hB0, hR0, hxr⟩ := hrest 0 x hx
    rw [Nat.add_zero] at hB0 hR0
    rw [hB0] at hp
    cases hp
    have hpr : (parents S.A S.sd.col)[S.m]? = some S.sd.r := by
      rw [hparA, List.getElem?_append_right (by simp [hm]), List.length_map, hm, Nat.sub_self]
      rfl
    have hA := aAt_active_of_inL_G3 S.inL hsdmem S.m S.sd.r hpr
    rw [activeKeys_self_G3] at hA
    -- the root edge `r → p_c` at the complete query
    have hcurR : S.rd.cursor < (actualKeys S.A S.rd.col).length := by
      rw [← length_parents_F7_G3]; exact (List.getElem?_eq_some_iff.1 hR0).1
    have hedge : Edge S.A (activeKeys_D7_G3 S.A S.sd.col) S.sd.col
        (cutQuery (actualKeys S.A S.sd.col) S.m) S.sd.r x.1 := by
      refine ⟨S.rd.col, hres, ?_⟩
      rw [resp_eq_parents]
      have hcur : cursor (activeKeys_D7_G3 S.A S.sd.col S.rd.col)
          (cutQuery (actualKeys S.A S.sd.col) S.m) = S.rd.cursor := by
        have h0 := rdcursor_eq_F7_G3 S
        unfold OrdData_G3.termZ at h0
        unfold activeKeys_D7_G3
        cases hRs : S.rd.col.container S.sd.col with
        | none => exact h0.symm
        | some e =>
          have hl := container_sdcol_last_G3 S hRs
          rw [length_parents_F7_G3] at hl
          simp only
          rw [cursor_active_G3 (by omega) (ne_top_of_mem_cutQuery_D7_G3 _ _ _) (by omega)]
          exact h0.symm
      rw [hcur, hR0]
    have := phase_path_fwd_G3 S hj hpp (cutQuery_noninc _ _) (ne_top_of_mem_cutQuery_D7_G3 _ _ _)
      (hA.tail hedge)
    have e1 : shiftVal S.sd.r ((j - 1) * S.d) x.1 = x.1 := by
      unfold shiftVal; rw [if_neg (by omega)]
    rw [e1] at this
    rw [hqk S.m le_rfl, hst S.m le_rfl]
    exact this
  · -- (f) later restored entries: the old root tests at the reset boundary (T3.2p)
    obtain ⟨v, rfl⟩ : ∃ v, i = S.m + v := ⟨i - S.m, by omega⟩
    have hv1 : 1 ≤ v := by omega
    have hvU : v < (unconsumed S.A S.rd).length := by omega
    obtain ⟨x, hx⟩ : ∃ x, (unconsumed S.A S.rd)[v]? = some x :=
      ⟨_, List.getElem?_eq_getElem hvU⟩
    obtain ⟨x', hx'⟩ : ∃ x', (unconsumed S.A S.rd)[v - 1]? = some x' :=
      ⟨_, List.getElem?_eq_getElem (by omega)⟩
    obtain ⟨hBv, hRv, hxr⟩ := hrest v x hx
    obtain ⟨hBv', hRv', hxr'⟩ := hrest (v - 1) x' hx'
    rw [hBv] at hp
    cases hp
    set K := actualKeys S.A S.rd.col with hK
    have hKlen : S.rd.cursor + v < K.length := by
      rw [hK, ← length_parents_F7_G3]; exact (List.getElem?_eq_some_iff.1 hRv).1
    -- root keys are `κ`-fixed
    have hfix : ∀ k, kappaQ_G3 S.sd.r S.d (j - 1) (cutQuery K k) = cutQuery K k := by
      intro k
      have h1 := (kappaQ_fix_D7_G3 S.sd.r S.d (j - 1) S.A (o := S.rd.col) (by omega)).1
      unfold kappaQ_G3 at h1 ⊢
      rw [← cutQuery_map (kappaQry_strictMono_G3 _ _ _), h1]
    -- the start
    have hstB : cutStart S.B c (S.m + v) = x'.1 := by
      unfold cutStart
      rw [if_neg (by omega), show S.m + v - 1 = S.m + (v - 1) by omega, hBv']
      rfl
    have hstA : cutStart S.A S.rd.col (S.rd.cursor + v) = x'.1 := by
      unfold cutStart
      rw [if_neg (by omega), show S.rd.cursor + v - 1 = S.rd.cursor + (v - 1) by omega, hRv']
      rfl
    -- the query: the reset boundary is the old root boundary
    have hcnum : c.num 0 = S.sd.r + j * S.d := by
      have := num_phaseCol S.inL S.kind S.hsd S.hrd (Or.inl rfl) hj.1 hc
      rw [this, hrnum]
      simp [phaseOff, isQMat_rdcol_G3 S, OrdData_G3.d]
    have hrestK : ((actualKeys S.B c).drop S.m).take v = (K.drop S.rd.cursor).take v := by
      apply List.ext_getElem?
      intro u
      rw [List.getElem?_take, List.getElem?_take, List.getElem?_drop, List.getElem?_drop]
      split_ifs with hu
      · obtain ⟨xu, hxu⟩ : ∃ xu, (unconsumed S.A S.rd)[u]? = some xu :=
          ⟨_, List.getElem?_eq_getElem (by omega)⟩
        obtain ⟨y, hy, -, hy2⟩ := hU u xu hxu
        rw [hm] at hy
        have hy2' := hy2 (fun h => by omega)
        have hRu : ((S.A.colAt S.rd.col).getD [])[S.rd.cursor + u]? = some xu := by
          unfold unconsumed rootCol at hxu
          rwa [List.getElem?_drop] at hxu
        simp only [actualKeys, hBcol, Option.getD_some, List.getElem?_map, hy, hK, hRu,
          Option.map_some]
        rw [hy2', hcnum, hrnum, show period S.sd = S.d from rfl,
          relKey_shift S.sd.r S.d j S.sd.r le_rfl, kappa_fix S.sd.r S.d j S.sd.r le_rfl]
      · rfl
    have hqB : cutQuery (actualKeys S.B c) (S.m + v) = cutQuery K (S.rd.cursor + v) := by
      obtain ⟨hcK, h1, h2⟩ := rootCap_headHyp_F7_G3 S (ks := K) (Or.inl rfl)
      have h1' : cutQuery K S.rd.cursor ≤ kappaQ_G3 S.sd.r S.d (j - 1) S.termZ := by
        rw [← hfix, kappaQ_le_iff_F7_G3]; exact h1
      have h2' : kappaQ_G3 S.sd.r S.d (j - 1) S.termZ < cutQuery K (S.rd.cursor + 1) := by
        rw [← hfix, kappaQ_lt_iff_G3]; exact h2 (by omega)
      have hZ : nu (kappaQ_G3 S.sd.r S.d (j - 1) ((actualKeys S.A S.sd.col).take S.m)) =
          kappaQ_G3 S.sd.r S.d (j - 1) S.termZ := by
        unfold kappaQ_G3 OrdData_G3.termZ cutQuery
        rw [nu_map (kappaQry_strictMono_G3 _ _ _)]
      unfold cutQuery
      rw [List.take_add, hrestK, hkeym, ← nu_append_nu, hZ]
      exact reset_nu K _ (by omega) (kappaQ_noninc_G3 _ _ _ (cutQuery_noninc _ _)) h1' h2' hv1
        hKlen.le
    -- the old root test, read on the stopping column's stack below `r`
    have hA := aAt_active_of_inL_G3 S.inL hrdmem (S.rd.cursor + v) x.1 hRv
    rw [activeKeys_self_G3, hstA] at hA
    have hA' := path_activeKeys_onStack_F7_G3 S.A hVA hres hxr' hA
    have := phase_path_fwd_G3 S hj hpp (cutQuery_noninc _ _) (ne_top_of_mem_cutQuery_D7_G3 _ _ _)
      hA'
    have e1 : shiftVal S.sd.r ((j - 1) * S.d) x.1 = x.1 := by
      unfold shiftVal; rw [if_neg (by omega)]
    have e2 : shiftVal S.sd.r ((j - 1) * S.d) x'.1 = x'.1 := by
      unfold shiftVal; rw [if_neg (by omega)]
    rw [e1, e2, hfix] at this
    rw [hqB, hstB]
    exact this

/-- T3.2r (G3): every test of an ordinary output, in its active system. -/
theorem aAt_ord_G3 (S : OrdData_G3) {c : ColAddr} (hc : c ∈ S.B.colAddrs) (i : Nat) :
    AAt S.B (activeKeys_D7_G3 S.B c) c i := by
  rcases classify_cols S.inL S.kind S.hsd S.hrd S.out hc with
    ⟨hctx, -⟩ | ⟨j, a, hj1, hj2, ha, hca, -⟩
  · exact aAt_ctx_G3 S hc hctx i
  · rcases ha with rfl | ha
    · exact aAt_head_G3 S ⟨hj1, hj2⟩ hca i
    · exact aAt_tmpl_G3 S ⟨hj1, hj2⟩ ha hca i

-- T3.2r (txt:377-403): ordinary outputs satisfy A (the tests of `B` in the systems capped at their
-- active containers, then uncapping by S); at `n = 0` the output is a safe prefix (T3.2g, T3.2e)
theorem condA_ord {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .ordinary)
    (hB : expand A n = some B) : CondA B := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · obtain ⟨j, -, rfl⟩ := expand_safePrefix (ne_empty_of_stepKind_D3 hk) hL.1 hL.2.1
      (Or.inr ⟨hk, rfl⟩) hB
    exact safePrefix_condA hL j
  · obtain ⟨sd, hsd⟩ := Option.isSome_iff_exists.mp (stopData_of_stepKind hk (by decide))
    obtain ⟨rd, hrd⟩ := Option.isSome_iff_exists.mp (rootData_of_ordinary hk)
    let S : OrdData_G3 := ⟨A, sd, rd, n, B, hL, hk, hsd, hrd, hn, hB⟩
    exact condA_of_active_G3 (condV_ord hL hk hB) (condS_ord hL hk hB)
      (fun c hc i => aAt_ord_G3 S hc i)


/-! T3.2s helpers: column-local conditions, and replacing the last column at the end of a route. -/

/-- A column-local condition `φ`, read at every column with its printed number from `base`. -/
def spxAll (φ : Nat → Column → Prop) (base : Nat) (T : Forest) : Prop :=
  ∀ c col, T.colAt c = some col → φ (c.num base) col

theorem spx_num_cons (base a b : Nat) (ρ : List (Nat × Nat)) (j : Nat) :
    ColAddr.num base ⟨(a, b) :: ρ, j⟩ = ColAddr.num (base + a + 1) ⟨ρ, j⟩ := by
  simp only [ColAddr.num, List.map_cons, List.sum_cons]; omega

theorem spxAll_node {φ : Nat → Column → Prop} {base : Nat} {cols : List Column} :
    spxAll φ base (Tree.node cols) ↔
      ∀ j col, cols[j]? = some col → φ (base + j) col ∧ ∀ x ∈ col, spxAll φ (base + j + 1) x.2 := by
  constructor
  · intro h j col hj
    refine ⟨?_, fun x hx c col' hc => ?_⟩
    · have := h ⟨[], j⟩ col (by simpa [Tree.colAt, Tree.forestAt, Tree.cols] using hj)
      simpa [ColAddr.num] using this
    · obtain ⟨i, hi⟩ := List.mem_iff_getElem?.1 hx
      have := h ⟨(j, i) :: c.path, c.col⟩ col' (by
        rw [Tree.colAt_cons]; simp [Tree.cols, hj, hi, hc])
      rwa [spx_num_cons] at this
  · intro h c col hc
    obtain ⟨P, j⟩ := c
    cases P with
    | nil =>
      have hj : cols[j]? = some col := by simpa [Tree.colAt, Tree.forestAt, Tree.cols] using hc
      simpa [ColAddr.num] using (h j col hj).1
    | cons s ρ =>
      obtain ⟨a, b⟩ := s
      rw [Tree.colAt_cons] at hc
      simp only [Tree.cols, Option.bind_eq_some_iff] at hc
      obtain ⟨x, ⟨colA, hA, hb⟩, hx⟩ := hc
      rw [spx_num_cons]
      exact (h a colA hA).2 x (List.mem_of_getElem? hb) ⟨ρ, j⟩ col hx

theorem spx_replaceAt_zero (Z : Forest) (ys : List Column) (y : Column) :
    replaceAt 0 0 Z 0 (Tree.node (ys ++ [y])) = Tree.node (ys ++ Z.cols) := by
  cases ys with
  | nil => simp [replaceAt, shiftVal_zero_fun, treeMapCol_id_fun]
  | cons c cs =>
    simp only [replaceAt, shiftVal_zero_fun, treeMapCol_id_fun, List.map_id]
    rw [List.dropLast_concat]
    simp only [List.cons_append]

theorem spx_replaceAt_succ (Z : Forest) (k : Nat) (ys : List Column) (zs : Column) (q : Nat)
    (h : Forest) :
    replaceAt 0 0 Z (k + 1) (Tree.node (ys ++ [zs ++ [(q, h)]])) =
      Tree.node (ys ++ [zs ++ [(q, replaceAt 0 0 Z k h)]]) := by
  simp only [replaceAt, mapLast_eq, List.dropLast_concat, List.getLast?_concat,
    Option.map_some, Option.toList_some, shiftVal_zero_fun, treeMapCol_id_fun, id, treeMap_id,
    List.map_id]
  simp

/-- Replacing the last column at the end of a route path keeps a column-local condition, given
the condition at the new column and below it, and a relation `R` between the old and new heights
of the containers along which `φ` passes. -/
theorem spxAll_replace {φ : Nat → Column → Prop} (R : Forest → Forest → Prop) {c' col : Column}
    (hR0 : ∀ cs, R (Tree.node (cs ++ [c'])) (Tree.node (cs ++ [col])))
    (hRs : ∀ ys zs q h h', R h' h →
      R (Tree.node (ys ++ [zs ++ [(q, h')]])) (Tree.node (ys ++ [zs ++ [(q, h)]])))
    (hφ : ∀ n zs q h h', R h' h → φ n (zs ++ [(q, h)]) → φ n (zs ++ [(q, h')])) :
    ∀ (π : List (Nat × Nat)) (F G : Forest) (cs : List Column) (base : Nat), IsRoutePath F π →
      F.forestAt π = some G → G.cols = cs ++ [col] → spxAll φ base F →
      φ (ColAddr.num base ⟨π, cs.length⟩) c' →
      (∀ x ∈ c', spxAll φ (ColAddr.num base ⟨π, cs.length⟩ + 1) x.2) →
      spxAll φ base (replaceAt 0 0 (Tree.node [c']) π.length F) ∧
        R (replaceAt 0 0 (Tree.node [c']) π.length F) F
  | [], F, G, cs, base, _, hG, hGc, hF, hc', hsub => by
    simp only [Tree.forestAt, Option.some.injEq] at hG
    subst hG
    obtain ⟨cols⟩ := F
    simp only [Tree.cols] at hGc
    subst hGc
    simp only [List.length_nil, spx_replaceAt_zero, Tree.cols]
    refine ⟨?_, hR0 cs⟩
    rw [spxAll_node] at hF ⊢
    intro j c hj
    by_cases hjc : j = cs.length
    · subst hjc
      simp only [List.getElem?_append_right (le_refl _), Nat.sub_self, List.getElem?_cons_zero,
        Option.some.injEq] at hj
      subst hj
      simpa [ColAddr.num] using And.intro hc' hsub
    · have : (cs ++ [col])[j]? = some c := by
        rcases Nat.lt_or_gt_of_ne hjc with hlt | hgt
        · rw [List.getElem?_append_left hlt] at hj ⊢; exact hj
        · rw [List.getElem?_append_right (by omega)] at hj ⊢
          simp [show j - cs.length ≠ 0 by omega] at hj
      exact hF j c this
  | s :: π, .node cols, G, cs, base, hr, hG, hGc, hF, hc', hsub => by
    obtain ⟨hl, h, hh, hr'⟩ := isRoutePath_cons.1 hr
    obtain ⟨colL, q, h₀, hcol, hcl, hs, hh'⟩ := lastStep?_eq_some hl
    rw [hh] at hh'
    cases hh'
    have hG' : h.forestAt π = some G := by
      rw [show s :: π = [s] ++ π from rfl, Tree.forestAt_append, hh] at hG
      exact hG
    simp only [Tree.cols] at hcol hs
    obtain ⟨ys, rfl⟩ := List.getLast?_eq_some_iff.1 hcol
    obtain ⟨zs, rfl⟩ := List.getLast?_eq_some_iff.1 hcl
    subst hs
    simp only [List.length_append, List.length_singleton, Nat.add_sub_cancel] at hF hc' hsub ⊢
    rw [List.length_cons, spx_replaceAt_succ]
    rw [spxAll_node] at hF
    have hFy := hF ys.length (zs ++ [(q, h)]) (by simp)
    have hn : ∀ n, ColAddr.num base ⟨(ys.length, zs.length) :: π, n⟩ =
        ColAddr.num (base + ys.length + 1) ⟨π, n⟩ := fun n => spx_num_cons _ _ _ _ _
    rw [hn] at hc' hsub
    obtain ⟨ih1, ih2⟩ := spxAll_replace R hR0 hRs hφ π h G cs (base + ys.length + 1) hr' hG' hGc
      (hFy.2 (q, h) (by simp)) hc' hsub
    refine ⟨?_, hRs ys zs q h _ ih2⟩
    rw [spxAll_node]
    intro j c hj
    by_cases hjc : j = ys.length
    · subst hjc
      simp only [List.getElem?_append_right (le_refl _), Nat.sub_self, List.getElem?_cons_zero,
        Option.some.injEq] at hj
      subst hj
      refine ⟨hφ _ zs q h _ ih2 hFy.1, ?_⟩
      intro x hx
      rcases List.mem_append.1 hx with hx | hx
      · exact hFy.2 x (List.mem_append_left _ hx)
      · simp only [List.mem_singleton] at hx; subst hx; exact ih1
    · have : (ys ++ [zs ++ [(q, h)]])[j]? = some c := by
        rcases Nat.lt_or_gt_of_ne hjc with hlt | hgt
        · rw [List.getElem?_append_left hlt] at hj ⊢; exact hj
        · rw [List.getElem?_append_right (by omega)] at hj ⊢
          simp [show j - ys.length ≠ 0 by omega] at hj
      exact hF j c this

theorem spx_then_eq (o : Ordering) : o.then .eq = o := by cases o <;> rfl

theorem spx_compare_self (q : Nat) : compare q q = .eq := compare_eq_iff_eq.2 rfl

theorem spx_cmpCols_append (ys X Y : List Column) :
    Tree.cmpCols compare (ys ++ X) (ys ++ Y) = Tree.cmpCols compare X Y := by
  induction ys with
  | nil => rfl
  | cons y ys ih =>
    simp only [List.cons_append, Tree.cmpCols, Tree.cmpCol_self, ih]; rfl

theorem spx_cmpCol_append (zs X Y : Column) :
    Tree.cmpCol compare (zs ++ X) (zs ++ Y) = Tree.cmpCol compare X Y := by
  induction zs with
  | nil => rfl
  | cons z zs ih =>
    obtain ⟨q, h⟩ := z
    simp only [List.cons_append, Tree.cmpCol, Tree.cmp_self, spx_compare_self, ih]; rfl

/-- Lowering the height of the last entry of the last column lowers the forest. -/
theorem spx_le_last (ys : List Column) (zs : Column) (q : Nat) {h h' : Forest} (hh : h' ≤ h) :
    Tree.node (ys ++ [zs ++ [(q, h')]]) ≤ Tree.node (ys ++ [zs ++ [(q, h)]]) := by
  rw [Forest.le_iff_cmp] at hh ⊢
  show Tree.cmpCols compare _ _ ≠ .gt
  rw [spx_cmpCols_append]
  simp only [Tree.cmpCols, spx_then_eq]
  rw [spx_cmpCol_append]
  simp only [Tree.cmpCol, spx_compare_self, spx_then_eq]
  exact hh

/-- Lowering the last column lowers the forest. -/
theorem spx_le_lastCol (cs : List Column) {c' col : Column} (h : Tree.cmpCol compare c' col ≠ .gt) :
    Tree.node (cs ++ [c']) ≤ Tree.node (cs ++ [col]) := by
  rw [Forest.le_iff_cmp]
  show Tree.cmpCols compare _ _ ≠ .gt
  rw [spx_cmpCols_append]
  simp only [Tree.cmpCols, spx_then_eq]
  exact h

/-- Dropping the last column is a decrease. -/
theorem spx_dropLast_lt {Fl : Forest} (h : Fl.cols ≠ []) : Tree.node Fl.cols.dropLast < Fl := by
  rw [Forest.lt_iff_cmp]
  obtain ⟨L, x, hL⟩ := (List.eq_nil_or_concat Fl.cols).resolve_left h
  rw [spx_eta Fl, hL]
  show Tree.cmpCols compare _ _ = .lt
  simp only [Tree.cols]
  rw [List.concat_eq_append, List.dropLast_concat]
  have := spx_cmpCols_append L [] [x]
  rw [List.append_nil] at this
  rw [this]; rfl

/-! The three column-local conditions V, I, H. -/

def spxφV (n : Nat) (col : Column) : Prop := ∀ x ∈ col, x.1 < n

def spxφI (n : Nat) (col : Column) : Prop :=
  ∀ x ∈ col, x.2 ≠ Tree.empty → ∀ cc ∈ x.2.cols, ∃ q H rest, cc = (q, H) :: rest ∧ n ≤ q

def spxφH (_ : Nat) (col : Column) : Prop := spxNoninc col

theorem spx_condV_iff (E : Forest) : CondV E ↔ spxAll spxφV 0 E := by
  rw [condV_iff_lt]
  constructor
  · intro h c col hc x hx
    obtain ⟨i, hi⟩ := List.mem_iff_getElem?.1 hx
    have he : E.entryAt ⟨c, i⟩ = some x := by rw [Tree.entryAt, hc]; exact hi
    exact h ⟨c, i⟩ ((Tree.mem_entryAddrs_iff _ _).2 (by rw [he]; rfl)) x.1 x.2 he
  · intro h e _ p H he
    obtain ⟨col, hc, hi⟩ := Tree.colAt_of_entryAt he
    exact h e.col col hc (p, H) (List.mem_of_getElem? hi)

theorem spx_condI_iff (E : Forest) : CondI E ↔ spxAll spxφI 0 E := by
  constructor
  · intro h c col hc x hx hne cc hcc
    obtain ⟨i, hi⟩ := List.mem_iff_getElem?.1 hx
    have he : E.entryAt ⟨c, i⟩ = some x := by rw [Tree.entryAt, hc]; exact hi
    exact h ⟨c, i⟩ ((Tree.mem_entryAddrs_iff _ _).2 (by rw [he]; rfl)) x.1 x.2 he hne cc hcc
  · intro h e _ p H he hne cc hcc
    obtain ⟨col, hc, hi⟩ := Tree.colAt_of_entryAt he
    exact h e.col col hc (p, H) (List.mem_of_getElem? hi) hne cc hcc

theorem spx_condH_iff (E : Forest) : CondH E ↔ spxAll spxφH 0 E := by
  constructor
  · intro h c col hc
    exact spx_condH_col h hc
  · intro h c _ i x y hx hy
    obtain ⟨col, hc⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff _ c).1 ‹_›)
    rw [hc, Option.getD_some] at hx hy
    exact h c col hc i x y hx hy

/-- Column-local conditions pass to the heights of a column's entries. -/
theorem spxAll_height {φ : Nat → Column → Prop} {base : Nat} {T : Forest} (h : spxAll φ base T)
    {c : ColAddr} {col : Column} (hc : T.colAt c = some col) :
    ∀ x ∈ col, spxAll φ (c.num base + 1) x.2 := by
  intro x hx c'' col'' hc''
  obtain ⟨i, hi⟩ := List.mem_iff_getElem?.1 hx
  have hcol : T.colAt ⟨c.path ++ (c.col, i) :: c''.path, c''.col⟩ = some col'' := by
    rw [show c.path ++ (c.col, i) :: c''.path = (⟨c, i⟩ : EntryAddr).heightPath ++ c''.path by
      simp [EntryAddr.heightPath], spx_colAt_append, Tree.forestAt_heightPath, Tree.heightAt,
      Tree.entryAt, hc]
    simp [hi, hc'']
  have := h _ _ hcol
  have hn : ColAddr.num base ⟨c.path ++ (c.col, i) :: c''.path, c''.col⟩ =
      ColAddr.num (c.num base + 1) c'' := by
    simp only [ColAddr.num, List.map_append, List.map_cons, List.sum_append, List.sum_cons]; omega
  rwa [hn] at this

/-- Column-local conditions hold for a forest made of a prefix of the columns. -/
theorem spxAll_dropLast {φ : Nat → Column → Prop} {base : Nat} {Fl : Forest}
    (h : spxAll φ base Fl) : spxAll φ base (Tree.node Fl.cols.dropLast) := by
  rw [spx_eta Fl, spxAll_node] at h
  rw [spxAll_node]
  intro j col hj
  exact h j col (by rw [List.getElem?_dropLast] at hj; split_ifs at hj; exact hj)

/-- Lowering the height of the last entry keeps a column nonincreasing. -/
theorem spx_noninc_lower {zs : Column} {q : Nat} {h h' : Forest} (hc : spxNoninc (zs ++ [(q, h)]))
    (hh : h' ≤ h) : spxNoninc (zs ++ [(q, h')]) := by
  intro i x y hx hy
  by_cases hi : i + 1 < zs.length
  · rw [List.getElem?_append_left (by omega)] at hx
    rw [List.getElem?_append_left hi] at hy
    exact hc i x y (by rw [List.getElem?_append_left (by omega)]; exact hx)
      (by rw [List.getElem?_append_left hi]; exact hy)
  · have hil : i + 1 = zs.length := by
      have := (List.getElem?_eq_some_iff.1 hy).1; simp at this; omega
    rw [List.getElem?_append_left (by omega)] at hx
    rw [List.getElem?_append_right (by omega), hil, Nat.sub_self] at hy
    simp only [List.getElem?_cons_zero, Option.some.injEq] at hy
    subst hy
    have := hc i x (q, h) (by rw [List.getElem?_append_left (by omega)]; exact hx)
      (by rw [List.getElem?_append_right (by omega), hil, Nat.sub_self]; rfl)
    rcases this with hlt | ⟨heq, hle⟩
    · exact Or.inl hlt
    · exact Or.inr ⟨heq, le_trans hh hle⟩

/-- Repeating the last entry keeps a column nonincreasing. -/
theorem spx_noninc_replicate {L : Column} {z : Nat × Forest} (hc : spxNoninc (L ++ [z])) (N : Nat) :
    spxNoninc (L ++ List.replicate N z) := by
  intro i x y hx hy
  by_cases hi : i + 1 < L.length
  · rw [List.getElem?_append_left (by omega)] at hx
    rw [List.getElem?_append_left hi] at hy
    exact hc i x y (by rw [List.getElem?_append_left (by omega)]; exact hx)
      (by rw [List.getElem?_append_left hi]; exact hy)
  · by_cases hil : i + 1 = L.length
    · rw [List.getElem?_append_left (by omega)] at hx
      rw [List.getElem?_append_right (by omega), hil, Nat.sub_self] at hy
      have hy' := List.eq_of_mem_replicate (List.mem_of_getElem? hy)
      subst hy'
      exact hc i x _ (by rw [List.getElem?_append_left (by omega)]; exact hx)
        (by rw [List.getElem?_append_right (by omega), hil, Nat.sub_self]; rfl)
    · rw [List.getElem?_append_right (by omega)] at hx hy
      have hx' := List.eq_of_mem_replicate (List.mem_of_getElem? hx)
      have hy' := List.eq_of_mem_replicate (List.mem_of_getElem? hy)
      subst hx' hy'
      exact Or.inr ⟨rfl, le_refl _⟩

/-- The special output: the owner column `P ⌢ [(p, Fl)]` at the end of the route path `π` becomes
`P ⌢ [(p, C)]^N`, `C` being `Fl` without its last column, with `N ≥ 1` when `P = []`. -/
theorem spx_special_shape {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .special)
    (hB : expand A n = some B) :
    ∃ (π : List (Nat × Nat)) (G : Forest) (cs : List Column) (P : Column) (p : Nat) (Fl : Forest)
      (N : Nat), IsRoutePath A π ∧ A.forestAt π = some G ∧ G.cols = cs ++ [P ++ [(p, Fl)]] ∧
      Fl.cols ≠ [] ∧ (P = [] → 1 ≤ N) ∧
      B = replaceAt 0 0 (Tree.node [P ++ List.replicate N (p, Tree.node Fl.cols.dropLast)])
        π.length A := by
  obtain ⟨hV, hI, -, -, -⟩ := hL
  have hE : A ≠ Tree.empty := by
    rintro rfl; simp [stepKind, stepKindBody, Tree.empty, Tree.cols] at hk
  rw [expand_eq_paperOp hE hV hI] at hB
  obtain ⟨sd, hsd⟩ := Option.isSome_iff_exists.1 (stopData_of_stepKind hk (by decide))
  obtain ⟨oe, hoe⟩ := Option.isSome_iff_exists.1 (ownerEntry_of_special hk hsd)
  obtain ⟨-, hhp, -, col, p, Fl, hcol, hlast, -, hFl⟩ := ownerEntry_spec hk hsd hoe
  rw [paperOp_special hk hsd hoe hcol hlast n, Option.some.injEq, Hole.fill_zero] at hB
  obtain ⟨-, hdep, -, hmem, -, -⟩ := stopData_spec hsd
  obtain ⟨hrp, -⟩ := (mem_routeCols_iff A sd.col).1 hmem
  rw [← hhp] at hrp hdep
  have hrpπ : IsRoutePath A oe.col.path := by
    intro d hd
    obtain ⟨F, hF, hFl'⟩ := hrp d (by simp [EntryAddr.heightPath]; omega)
    refine ⟨F, ?_, ?_⟩
    · rw [EntryAddr.heightPath, List.take_append_of_le_length (le_of_lt hd)] at hF; exact hF
    · rw [EntryAddr.heightPath, List.getElem?_append_left hd] at hFl'; exact hFl'
  obtain ⟨G, hG, hGl⟩ := hrp oe.col.path.length (by simp [EntryAddr.heightPath])
  simp only [EntryAddr.heightPath, List.take_left', List.getElem?_append_right (le_refl _),
    Nat.sub_self, List.getElem?_cons_zero] at hG hGl
  obtain ⟨colL, q', h', hcolL, -, hs, -⟩ := lastStep?_eq_some hGl
  simp only [Prod.mk.injEq] at hs
  obtain ⟨hs1, -⟩ := hs
  have hcc : col = colL := by
    rw [Tree.colAt, hG, Option.bind_some, hs1, ← List.getLast?_eq_getElem?, hcolL] at hcol
    exact (Option.some.inj hcol).symm
  subst hcc
  obtain ⟨cs, hcs⟩ := List.getLast?_eq_some_iff.1 hcolL
  obtain ⟨P, hP⟩ := List.getLast?_eq_some_iff.1 hlast
  have hFl' : Fl.cols ≠ [] := by intro h0; rw [h0] at hFl; simp at hFl
  refine ⟨oe.col.path, G, cs, P, p, Fl, n + (if col.dropLast.isEmpty then 1 else 0), hrpπ, hG,
    by rw [hcs, hP], hFl', fun hP0 => by simp [hP, hP0], ?_⟩
  rw [← hB, Hole.put]
  simp only [hdep, EntryAddr.heightPath, List.length_append, List.length_singleton,
    Nat.add_sub_cancel, hP, List.dropLast_concat]

theorem spx_mem_special {P : Column} {N p : Nat} {C : Forest} {x : Nat × Forest}
    (hx : x ∈ P ++ List.replicate N (p, C)) : x ∈ P ∨ x = (p, C) := by
  rcases List.mem_append.1 hx with hx | hx
  · exact Or.inl hx
  · exact Or.inr (List.eq_of_mem_replicate hx)

-- T3.2s (txt:404-407): special outputs satisfy V, I, H
theorem condVIH_special {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .special)
    (hB : expand A n = some B) : CondV B ∧ CondI B ∧ CondH B := by
  obtain ⟨π, G, cs, P, p, Fl, N, hrp, hG, hGc, hFl, hN, rfl⟩ := spx_special_shape hL hk hB
  obtain ⟨hV, hI, hH, -, -⟩ := hL
  have hcolA : A.colAt ⟨π, cs.length⟩ = some (P ++ [(p, Fl)]) := by
    simp [Tree.colAt, hG, hGc]
  have hCFl : Tree.node Fl.cols.dropLast < Fl := spx_dropLast_lt hFl
  have hFlne : Fl ≠ Tree.empty := by intro h0; rw [h0] at hFl; exact hFl rfl
  refine ⟨?_, ?_, ?_⟩
  · -- V: parents are unchanged
    rw [spx_condV_iff] at hV ⊢
    refine (spxAll_replace (φ := spxφV) (fun _ _ => True) (fun _ => trivial)
      (fun _ _ _ _ _ _ => trivial) ?_ π A G cs 0 hrp hG hGc hV ?_ ?_).1
    · intro m zs q h h' _ hφ x hx
      rcases List.mem_append.1 hx with hx | hx
      · exact hφ x (List.mem_append_left _ hx)
      · simp only [List.mem_singleton] at hx; subst hx; exact hφ (q, h) (by simp)
    · intro x hx
      rcases spx_mem_special hx with hx | rfl
      · exact hV _ _ hcolA x (List.mem_append_left _ hx)
      · exact hV _ _ hcolA (p, Fl) (by simp)
    · intro x hx
      rcases spx_mem_special hx with hx | rfl
      · exact spxAll_height hV hcolA x (List.mem_append_left _ hx)
      · exact spxAll_dropLast (spxAll_height hV hcolA (p, Fl) (by simp))
  · -- I: first parents of all columns are unchanged
    rw [spx_condI_iff] at hI ⊢
    let f : Column → Option Nat := fun cc => cc.head?.map Prod.fst
    refine (spxAll_replace (φ := spxφI) (fun h' h => h'.cols.map f = h.cols.map f) ?_ ?_ ?_
      π A G cs 0 hrp hG hGc hI ?_ ?_).1
    · intro cs'
      simp only [Tree.cols, List.map_append, List.map_cons, List.map_nil, f]
      congr 2
      cases P with
      | nil =>
        obtain ⟨N', rfl⟩ : ∃ N', N = N' + 1 := ⟨N - 1, by have := hN rfl; omega⟩
        simp [List.replicate_succ]
      | cons x xs => simp
    · intro ys zs q h h' _
      simp only [Tree.cols, List.map_append, List.map_cons, List.map_nil, f]
      cases zs <;> simp
    · intro m zs q h h' hR hφ x hx hne cc hcc
      rcases List.mem_append.1 hx with hx | hx
      · exact hφ x (List.mem_append_left _ hx) hne cc hcc
      · simp only [List.mem_singleton] at hx
        subst hx
        dsimp only at hne hcc
        obtain ⟨i, hi⟩ := List.mem_iff_getElem?.1 hcc
        have hlen : h'.cols.length = h.cols.length := by simpa using congrArg List.length hR
        have hi' : i < h.cols.length := by have := (List.getElem?_eq_some_iff.1 hi).1; omega
        have hne' : h ≠ Tree.empty := by
          intro h0; rw [h0] at hi'; simp [Tree.empty, Tree.cols] at hi'
        obtain ⟨q₀, H₀, rest₀, hc₀, hq₀⟩ := hφ (q, h) (by simp) hne' _
          (List.getElem_mem hi')
        have hf := congrArg (fun l => l[i]?) hR
        simp only [List.getElem?_map, hi, List.getElem?_eq_getElem hi', hc₀, Option.map_some,
          f] at hf
        obtain ⟨⟨q₁, H₁⟩, rest₁, rfl⟩ : ∃ y rest, cc = y :: rest := by
          cases cc with
          | nil => simp at hf
          | cons y rest => exact ⟨y, rest, rfl⟩
        simp only [List.head?_cons, Option.map_some, Option.some.injEq] at hf
        exact ⟨q₁, H₁, rest₁, rfl, hf ▸ hq₀⟩
    · intro x hx hne cc hcc
      rcases spx_mem_special hx with hx | rfl
      · exact hI _ _ hcolA x (List.mem_append_left _ hx) hne cc hcc
      · exact hI _ _ hcolA (p, Fl) (by simp) hFlne cc (List.mem_of_mem_dropLast hcc)
    · intro x hx
      rcases spx_mem_special hx with hx | rfl
      · exact spxAll_height hI hcolA x (List.mem_append_left _ hx)
      · exact spxAll_dropLast (spxAll_height hI hcolA (p, Fl) (by simp))
  · -- H: the changed heights only decrease
    rw [spx_condH_iff] at hH ⊢
    refine (spxAll_replace (φ := spxφH) (fun h' h => h' ≤ h) ?_ ?_ ?_
      π A G cs 0 hrp hG hGc hH ?_ ?_).1
    · intro cs'
      apply spx_le_lastCol
      rw [spx_cmpCol_append]
      cases N with
      | zero => simp [Tree.cmpCol]
      | succ N =>
        simp only [List.replicate_succ, Tree.cmpCol, spx_compare_self]
        rw [show Tree.cmp compare (Tree.node Fl.cols.dropLast) Fl = .lt from hCFl]
        simp
    · intro ys zs q h h' hh; exact spx_le_last ys zs q hh
    · intro m zs q h h' hh hφ; exact spx_noninc_lower hφ hh
    · exact spx_noninc_replicate (spx_noninc_lower (hH _ _ hcolA) (le_of_lt hCFl)) N
    · intro x hx
      rcases spx_mem_special hx with hx | rfl
      · exact spxAll_height hH hcolA x (List.mem_append_left _ hx)
      · exact spxAll_dropLast (spxAll_height hH hcolA (p, Fl) (by simp))


/-! T3.2t helpers (branch E2): owner-return conditions as column-local conditions. -/

/-- Returns into a height `H` attached to a column with printed number `n`, checked by `ψ`
(`ψ m J n H` reads the return height `J` in a column with number `m`). -/
def retIn_E2 (ψ : Nat → Forest → Nat → Forest → Prop) (n : Nat) (H : Forest) : Prop :=
  spxAll (fun m col' => ∀ y ∈ col', y.1 = n → ψ m y.2 n H) (n + 1) H

/-- The column-local form of an owner-return condition: every height of the column. -/
def retAll_E2 (ψ : Nat → Forest → Nat → Forest → Prop) (n : Nat) (col : Column) : Prop :=
  ∀ x ∈ col, retIn_E2 ψ n x.2

theorem num_base_E2 (b : Nat) (c : ColAddr) : c.num b = b + c.num 0 := by
  simp only [ColAddr.num]; omega

theorem num_heightPath_E2 (e0 : EntryAddr) (ρ : List (Nat × Nat)) (j : Nat) :
    ColAddr.num 0 ⟨e0.heightPath ++ ρ, j⟩ = ColAddr.num (e0.col.num 0 + 1) ⟨ρ, j⟩ := by
  simp only [ColAddr.num, EntryAddr.heightPath, List.map_append, List.sum_append, List.map_cons,
    List.map_nil, List.sum_cons, List.sum_nil]
  omega

/-- An owner-return condition is the column-local condition `retAll_E2`. -/
theorem spx_ret_iff_E2 (ψ : Nat → Forest → Nat → Forest → Prop) (E : Forest) :
    (∀ e0 ∈ E.entryAddrs, ∀ e ∈ E.entryAddrs, IsOwnerReturn E e0 e →
      ψ (e.col.num 0) ((E.heightAt e).getD Tree.empty) (e0.col.num 0)
        ((E.heightAt e0).getD Tree.empty)) ↔
    spxAll (retAll_E2 ψ) 0 E := by
  constructor
  · intro h c col hc x hx c' col' hc' y hy hy1
    obtain ⟨i, hi⟩ := List.mem_iff_getElem?.1 hx
    obtain ⟨k, hk⟩ := List.mem_iff_getElem?.1 hy
    have he0 : E.entryAt ⟨c, i⟩ = some x := by rw [Tree.entryAt, hc]; exact hi
    have hn : c.num 0 = ColAddr.num 0 c := rfl
    have he : E.entryAt ⟨⟨(⟨c, i⟩ : EntryAddr).heightPath ++ c'.path, c'.col⟩, k⟩ = some y := by
      rw [spx_entryAt_inside, Tree.heightAt, he0]
      simp only [Option.map_some, Option.bind_some, Tree.entryAt]
      rw [hc']; exact hk
    have hcont : (⟨c, i⟩ : EntryAddr).Contains ⟨(⟨c, i⟩ : EntryAddr).heightPath ++ c'.path, c'.col⟩ :=
      ⟨c'.path, rfl⟩
    have hret : IsOwnerReturn E ⟨c, i⟩ ⟨⟨(⟨c, i⟩ : EntryAddr).heightPath ++ c'.path, c'.col⟩, k⟩ := by
      refine ⟨hcont, y.1, y.2, he, ?_⟩
      have := EntryAddr.resolve_host hcont
      simp only [hy1]
      rw [num_base_E2] at this ⊢
      simpa using this
    have := h _ ((Tree.mem_entryAddrs_iff E _).2 (by rw [he0]; rfl)) _
      ((Tree.mem_entryAddrs_iff E _).2 (by rw [he]; rfl)) hret
    simp only [Tree.heightAt, he, he0, Option.map_some, Option.getD_some] at this
    rw [num_heightPath_E2] at this
    exact this
  · intro h e0 he0 e he hret
    obtain ⟨⟨ρ, hρ⟩, q, J, hJ, hres⟩ := hret
    obtain ⟨⟨P, j⟩, i⟩ := e
    dsimp only at hρ
    subst hρ
    obtain ⟨x0, hx0⟩ := Option.isSome_iff_exists.1 ((Tree.mem_entryAddrs_iff _ e0).1 he0)
    obtain ⟨col, hcol, hi⟩ := Tree.colAt_of_entryAt hx0
    have hR := h e0.col col hcol x0 (List.mem_of_getElem? hi)
    have hJ' := hJ
    rw [spx_entryAt_inside, Tree.heightAt, hx0] at hJ'
    simp only [Option.map_some, Option.bind_some] at hJ'
    obtain ⟨col', hcol', hk⟩ := Tree.colAt_of_entryAt hJ'
    have hq : e0.col.num 0 = q := ColAddr.resolve_num hres
    have := hR ⟨ρ, j⟩ col' hcol' (q, J) (List.mem_of_getElem? hk) hq.symm
    simp only [Tree.heightAt, hJ, hx0, Option.map_some, Option.getD_some]
    rw [num_heightPath_E2]
    exact this

/-- Every entry of a forest, at any depth, has a height satisfying `Q`. -/
def allEnt_E2 (Q : Forest → Prop) (T : Forest) : Prop :=
  ∀ c col, T.colAt c = some col → ∀ y ∈ col, Q y.2

/-- An entry correspondence: every entry of `h'` (any depth) has an entry of `h` in a column with
the same relative number, with the same parent, related by `Rel`. -/
def entCorr_E2 (Rel : Forest → Forest → Prop) (h' h : Forest) : Prop :=
  ∀ c' col', h'.colAt c' = some col' → ∀ y' ∈ col', ∃ c col, h.colAt c = some col ∧
    c.num 0 = c'.num 0 ∧ ∃ y ∈ col, y.1 = y'.1 ∧ Rel y'.2 y.2

theorem retIn_of_entCorr_E2 {ψ : Nat → Forest → Nat → Forest → Prop}
    {Rel : Forest → Forest → Prop} {h' h : Forest} {n : Nat} (hC : entCorr_E2 Rel h' h)
    (hψ : ∀ m J' J, Rel J' J → ψ m J n h → ψ m J' n h') (hR : retIn_E2 ψ n h) :
    retIn_E2 ψ n h' := by
  intro c' col' hc' y' hy' hy1
  obtain ⟨c, col, hc, hnum, y, hy, hyy, hrel⟩ := hC c' col' hc' y' hy'
  have := hR c col hc y hy (hyy.trans hy1)
  rw [num_base_E2, hnum, ← num_base_E2] at this
  exact hψ _ _ _ hrel this

theorem retIn_of_allEnt_E2 {ψ : Nat → Forest → Nat → Forest → Prop} {n : Nat} {h : Forest}
    (hA : allEnt_E2 (fun J => ∀ m, ψ m J n h) h) : retIn_E2 ψ n h := by
  intro c col hc y hy _
  exact hA c col hc y hy _

theorem entCorr_mono_E2 {Rel Rel' : Forest → Forest → Prop} {h' h : Forest}
    (hC : entCorr_E2 Rel h' h) (hm : ∀ J' J, Rel J' J → Rel' J' J) : entCorr_E2 Rel' h' h := by
  intro c' col' hc' y' hy'
  obtain ⟨c, col, hc, hnum, y, hy, hyy, hrel⟩ := hC c' col' hc' y' hy'
  exact ⟨c, col, hc, hnum, y, hy, hyy, hm _ _ hrel⟩

theorem colAt_dropLast_E2 {F : Forest} {c : ColAddr} {col : Column}
    (h : (Tree.node F.cols.dropLast).colAt c = some col) : F.colAt c = some col := by
  obtain ⟨P, j⟩ := c
  rw [spx_eta F]
  cases P with
  | nil =>
    simp only [Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols] at h ⊢
    rw [List.getElem?_dropLast] at h
    split_ifs at h; exact h
  | cons s ρ =>
    obtain ⟨a, b⟩ := s
    rw [Tree.colAt_cons] at h ⊢
    simp only [Tree.cols] at h ⊢
    rw [List.getElem?_dropLast] at h
    split_ifs at h
    · exact h
    · simp at h

/-- A forest made of a prefix of the columns corresponds to the whole forest. -/
theorem entCorr_dropLast_E2 {Rel : Forest → Forest → Prop} {F : Forest}
    (hA : allEnt_E2 (fun J => Rel J J) (Tree.node F.cols.dropLast)) :
    entCorr_E2 Rel (Tree.node F.cols.dropLast) F := by
  intro c' col' hc' y' hy'
  exact ⟨c', col', colAt_dropLast_E2 hc', rfl, y', hy', rfl, hA c' col' hc' y' hy'⟩

/-- The entry of `cols` at `(a, b)`. -/
def getEnt_E2 (cols : List Column) (a b : Nat) : Option (Nat × Forest) :=
  (cols[a]?).bind (·[b]?)

theorem colAt_cons_E2 (cols : List Column) (a b : Nat) (ρ : List (Nat × Nat)) (j : Nat) :
    (Tree.node cols).colAt ⟨(a, b) :: ρ, j⟩ =
      (getEnt_E2 cols a b).bind fun x => x.2.colAt ⟨ρ, j⟩ := by
  rw [Tree.colAt_cons]; rfl

theorem colAt_nil_E2 (cols : List Column) (j : Nat) :
    (Tree.node cols).colAt ⟨[], j⟩ = cols[j]? := by
  simp [Tree.colAt, Tree.forestAt, Tree.cols]

theorem getEnt_snoc_E2 {ys : List Column} {zs : Column} {q : Nat} (X Y : Forest) {a b : Nat}
    (hab : ¬ (a = ys.length ∧ b = zs.length)) :
    getEnt_E2 (ys ++ [zs ++ [(q, X)]]) a b = getEnt_E2 (ys ++ [zs ++ [(q, Y)]]) a b := by
  unfold getEnt_E2
  rcases Nat.lt_trichotomy a ys.length with ha | rfl | ha
  · rw [List.getElem?_append_left ha, List.getElem?_append_left ha]
  · rw [List.getElem?_append_right (le_refl _), List.getElem?_append_right (le_refl _)]
    simp only [Nat.sub_self, List.getElem?_cons_zero, Option.bind_some]
    have hb : b ≠ zs.length := fun h => hab ⟨rfl, h⟩
    rcases Nat.lt_or_gt_of_ne hb with hb | hb
    · rw [List.getElem?_append_left hb, List.getElem?_append_left hb]
    · rw [List.getElem?_append_right (by omega), List.getElem?_append_right (by omega)]
      simp [show b - zs.length ≠ 0 by omega]
  · rw [List.getElem?_append_right (by omega), List.getElem?_append_right (by omega)]
    simp [show a - ys.length ≠ 0 by omega]

theorem getEnt_snoc_self_E2 (ys : List Column) (zs : Column) (q : Nat) (X : Forest) :
    getEnt_E2 (ys ++ [zs ++ [(q, X)]]) ys.length zs.length = some (q, X) := by
  simp [getEnt_E2]

/-- Propagation of an entry correspondence through one level of the route. -/
theorem entCorr_snoc_E2 {Rel Rel' : Forest → Forest → Prop} {ys : List Column} {zs : Column}
    {q : Nat} {h h' : Forest} (hC : entCorr_E2 Rel h' h) (hm : ∀ J' J, Rel J' J → Rel' J' J)
    (hhh : Rel' h' h)
    (hT : allEnt_E2 (fun J => Rel' J J) (Tree.node (ys ++ [zs ++ [(q, Tree.empty)]]))) :
    entCorr_E2 Rel' (Tree.node (ys ++ [zs ++ [(q, h')]])) (Tree.node (ys ++ [zs ++ [(q, h)]])) := by
  intro c' col' hc' y' hy'
  obtain ⟨P, j⟩ := c'
  cases P with
  | nil =>
    rw [colAt_nil_E2] at hc'
    rcases Nat.lt_trichotomy j ys.length with hj | rfl | hj
    · rw [List.getElem?_append_left hj] at hc'
      refine ⟨⟨[], j⟩, col', by rw [colAt_nil_E2, List.getElem?_append_left hj, hc'], rfl, y', hy',
        rfl, hT ⟨[], j⟩ col' (by rw [colAt_nil_E2, List.getElem?_append_left hj, hc']) y' hy'⟩
    · simp only [List.getElem?_append_right (le_refl _), Nat.sub_self, List.getElem?_cons_zero,
        Option.some.injEq] at hc'
      subst hc'
      rcases List.mem_append.1 hy' with hy | hy
      · refine ⟨⟨[], ys.length⟩, zs ++ [(q, h)], by simp [colAt_nil_E2], rfl, y',
          List.mem_append_left _ hy, rfl, hT ⟨[], ys.length⟩ (zs ++ [(q, Tree.empty)])
            (by simp [colAt_nil_E2]) y' (List.mem_append_left _ hy)⟩
      · simp only [List.mem_singleton] at hy
        subst hy
        exact ⟨⟨[], ys.length⟩, zs ++ [(q, h)], by simp [colAt_nil_E2], rfl, (q, h), by simp, rfl,
          hhh⟩
    · rw [List.getElem?_append_right (by omega)] at hc'
      simp [show j - ys.length ≠ 0 by omega] at hc'
  | cons s ρ =>
    obtain ⟨a, b⟩ := s
    rw [colAt_cons_E2, Option.bind_eq_some_iff] at hc'
    obtain ⟨x', hx', hcx⟩ := hc'
    by_cases hab : a = ys.length ∧ b = zs.length
    · obtain ⟨rfl, rfl⟩ := hab
      rw [getEnt_snoc_self_E2] at hx'
      cases hx'
      obtain ⟨c, col, hc, hnum, y, hy, hyy, hrel⟩ := hC ⟨ρ, j⟩ col' hcx y' hy'
      refine ⟨⟨(ys.length, zs.length) :: c.path, c.col⟩, col, ?_, ?_, y, hy, hyy, hm _ _ hrel⟩
      · rw [colAt_cons_E2, getEnt_snoc_self_E2]; exact hc
      · rw [spx_num_cons, spx_num_cons, num_base_E2, num_base_E2 (0 + _ + 1)]
        exact congrArg _ hnum
    · have e1 := getEnt_snoc_E2 h' h hab (q := q)
      have e2 := getEnt_snoc_E2 h' Tree.empty hab (q := q)
      refine ⟨⟨(a, b) :: ρ, j⟩, col', ?_, rfl, y', hy', rfl, hT ⟨(a, b) :: ρ, j⟩ col' ?_ y' hy'⟩
      · rw [colAt_cons_E2, ← e1, hx']; exact hcx
      · rw [colAt_cons_E2, ← e2, hx']; exact hcx

/-- The entry correspondence at the replaced owner column. -/
theorem entCorr_top_E2 {Rel : Forest → Forest → Prop} {cs : List Column} {P : Column}
    {p N : Nat} {Fl : Forest}
    (hT : allEnt_E2 (fun J => Rel J J) (Tree.node (cs ++ [P])))
    (hCe : N ≠ 0 → allEnt_E2 (fun J => Rel J J) (Tree.node Fl.cols.dropLast))
    (hCF : N ≠ 0 → Rel (Tree.node Fl.cols.dropLast) Fl) :
    entCorr_E2 Rel (Tree.node (cs ++ [P ++ List.replicate N (p, Tree.node Fl.cols.dropLast)]))
      (Tree.node (cs ++ [P ++ [(p, Fl)]])) := by
  intro c' col' hc' y' hy'
  obtain ⟨Pa, j⟩ := c'
  cases Pa with
  | nil =>
    rw [colAt_nil_E2] at hc'
    rcases Nat.lt_trichotomy j cs.length with hj | rfl | hj
    · rw [List.getElem?_append_left hj] at hc'
      refine ⟨⟨[], j⟩, col', by rw [colAt_nil_E2, List.getElem?_append_left hj, hc'], rfl, y', hy',
        rfl, hT ⟨[], j⟩ col' (by rw [colAt_nil_E2, List.getElem?_append_left hj, hc']) y' hy'⟩
    · simp only [List.getElem?_append_right (le_refl _), Nat.sub_self, List.getElem?_cons_zero,
        Option.some.injEq] at hc'
      subst hc'
      rcases List.mem_append.1 hy' with hy | hy
      · refine ⟨⟨[], cs.length⟩, P ++ [(p, Fl)], by simp [colAt_nil_E2], rfl, y',
          List.mem_append_left _ hy, rfl, hT ⟨[], cs.length⟩ P (by simp [colAt_nil_E2]) y' hy⟩
      · have hN : N ≠ 0 := by rintro rfl; simp at hy
        rw [List.eq_of_mem_replicate hy]
        exact ⟨⟨[], cs.length⟩, P ++ [(p, Fl)], by simp [colAt_nil_E2], rfl, (p, Fl), by simp, rfl,
          hCF hN⟩
    · rw [List.getElem?_append_right (by omega)] at hc'
      simp [show j - cs.length ≠ 0 by omega] at hc'
  | cons s ρ =>
    obtain ⟨a, b⟩ := s
    rw [colAt_cons_E2, Option.bind_eq_some_iff] at hc'
    obtain ⟨x', hx', hcx⟩ := hc'
    by_cases hab : a = cs.length ∧ P.length ≤ b
    · obtain ⟨rfl, hb⟩ := hab
      have hx'' : x' = (p, Tree.node Fl.cols.dropLast) ∧ N ≠ 0 := by
        simp only [getEnt_E2, List.getElem?_append_right (le_refl _), Nat.sub_self,
          List.getElem?_cons_zero, Option.bind_some, List.getElem?_append_right hb] at hx'
        have hm := List.mem_of_getElem? hx'
        exact ⟨List.eq_of_mem_replicate hm, by rintro rfl; simp at hm⟩
      obtain ⟨rfl, hN⟩ := hx''
      refine ⟨⟨(cs.length, P.length) :: ρ, j⟩, col', ?_, ?_, y', hy', rfl,
        hCe hN ⟨ρ, j⟩ col' hcx y' hy'⟩
      · rw [colAt_cons_E2]
        simp only [getEnt_E2, List.getElem?_append_right (le_refl _), Nat.sub_self,
          List.getElem?_cons_zero, Option.bind_some]
        exact colAt_dropLast_E2 hcx
      · rw [spx_num_cons, spx_num_cons]
    · have e1 : getEnt_E2 (cs ++ [P ++ List.replicate N (p, Tree.node Fl.cols.dropLast)]) a b =
          getEnt_E2 (cs ++ [P]) a b ∧ getEnt_E2 (cs ++ [P ++ [(p, Fl)]]) a b =
          getEnt_E2 (cs ++ [P]) a b := by
        unfold getEnt_E2
        rcases Nat.lt_trichotomy a cs.length with ha | rfl | ha
        · constructor <;> simp [List.getElem?_append_left ha]
        · have hb : b < P.length := by omega
          constructor <;> simp [List.getElem?_append_left hb]
        · simp only [List.getElem?_append_right (show cs.length ≤ a by omega)]
          simp [show a - cs.length ≠ 0 by omega]
      refine ⟨⟨(a, b) :: ρ, j⟩, col', ?_, rfl, y', hy', rfl, hT ⟨(a, b) :: ρ, j⟩ col' ?_ y' hy'⟩
      · rw [colAt_cons_E2, e1.2, ← e1.1, hx']; exact hcx
      · rw [colAt_cons_E2, ← e1.1, hx']; exact hcx


/-! T3.2t helpers (branch E2): decreases of words, the S correspondence. -/

/-- `X'` is a decrease of `X` first changing at `a`: they agree before `a`, and at `a` either `X'`
ends while `X` continues, or the letter of `X'` has a smaller depth `d`. -/
def decAt_E2 {β : Type} (d : β → Nat) (X X' : List β) (a : Nat) : Prop :=
  X'.take a = X.take a ∧ a ≤ X'.length ∧
    ((X'.length = a ∧ a < X.length) ∨ ∃ x x', X[a]? = some x ∧ X'[a]? = some x' ∧ d x' < d x)

theorem lt_of_take_succ_E2 {β : Type} [LinearOrder β] : ∀ {X Y Y' : List β}, X < Y →
    Y'.take (X.length + 1) = Y.take (X.length + 1) → X < Y'
  | [], [], _, h, _ => absurd h (List.not_lt_nil _)
  | [], y :: ys, Y', _, ht => by
    cases Y' with
    | nil => simp at ht
    | cons y' ys' => exact List.nil_lt_cons _ _
  | x :: xs, [], _, h, _ => absurd h (List.not_lt_nil _)
  | x :: xs, y :: ys, Y', h, ht => by
    cases Y' with
    | nil => simp at ht
    | cons y' ys' =>
      simp only [List.length_cons, List.take_succ_cons, List.cons.injEq] at ht
      obtain ⟨rfl, ht⟩ := ht
      rcases List.cons_lt_cons_iff.1 h with h1 | ⟨h1, h2⟩
      · exact List.cons_lt_cons_iff.2 (Or.inl h1)
      · exact List.cons_lt_cons_iff.2 (Or.inr ⟨h1, lt_of_take_succ_E2 h2 ht⟩)

theorem lt_of_decAt_E2 {β : Type} [LinearOrder β] {d : β → Nat}
    (hd : ∀ x y, d x < d y → x < y) (a : Nat) :
    ∀ {X Y X' Y' : List β} {b : Nat}, X < Y → decAt_E2 d X X' a →
      Y'.take b = Y.take b → b ≤ Y'.length → a < b → X' < Y' := by
  induction a with
  | zero =>
    intro X Y X' Y' b hXY hdec hYb hbl hab
    obtain ⟨_, _, hc⟩ := hdec
    obtain ⟨y', ys', rfl⟩ : ∃ y' ys', Y' = y' :: ys' := by
      cases Y' with
      | nil => simp at hbl; omega
      | cons y' ys' => exact ⟨_, _, rfl⟩
    obtain ⟨y, ys, rfl⟩ : ∃ y ys, Y = y :: ys := by
      cases Y with
      | nil => exact absurd hXY (List.not_lt_nil _)
      | cons y ys => exact ⟨_, _, rfl⟩
    have hyy : y' = y := by
      obtain ⟨b', rfl⟩ : ∃ b', b = b' + 1 := ⟨b - 1, by omega⟩
      simp only [List.take_succ_cons, List.cons.injEq] at hYb; exact hYb.1
    subst hyy
    rcases hc with ⟨hl, -⟩ | ⟨x, x', hx, hx', hlt⟩
    · rw [List.length_eq_zero_iff] at hl; subst hl; exact List.nil_lt_cons _ _
    · obtain ⟨xs, rfl⟩ : ∃ xs, X = x :: xs := by
        cases X with
        | nil => simp at hx
        | cons z zs => simp at hx; exact ⟨zs, by rw [hx]⟩
      obtain ⟨xs', rfl⟩ : ∃ xs', X' = x' :: xs' := by
        cases X' with
        | nil => simp at hx'
        | cons z zs => simp at hx'; exact ⟨zs, by rw [hx']⟩
      have hxy : x ≤ y' := by
        rcases List.cons_lt_cons_iff.1 hXY with h1 | ⟨h1, -⟩
        · exact le_of_lt h1
        · exact le_of_eq h1
      exact List.cons_lt_cons_iff.2 (Or.inl (lt_of_lt_of_le (hd _ _ hlt) hxy))
  | succ a ih =>
    intro X Y X' Y' b hXY hdec hYb hbl hab
    obtain ⟨ht, hl, hc⟩ := hdec
    obtain ⟨x', xs', rfl⟩ : ∃ x' xs', X' = x' :: xs' := by
      cases X' with
      | nil => simp at hl
      | cons z zs => exact ⟨_, _, rfl⟩
    obtain ⟨x, xs, rfl⟩ : ∃ x xs, X = x :: xs := by
      cases X with
      | nil =>
        rcases hc with ⟨-, h⟩ | ⟨x, -, h, -⟩
        · simp at h
        · simp at h
      | cons z zs => exact ⟨_, _, rfl⟩
    obtain ⟨y, ys, rfl⟩ : ∃ y ys, Y = y :: ys := by
      cases Y with
      | nil => exact absurd hXY (List.not_lt_nil _)
      | cons y ys => exact ⟨_, _, rfl⟩
    obtain ⟨y', ys', rfl⟩ : ∃ y' ys', Y' = y' :: ys' := by
      cases Y' with
      | nil => simp at hbl; omega
      | cons y' ys' => exact ⟨_, _, rfl⟩
    obtain ⟨b', rfl⟩ : ∃ b', b = b' + 1 := ⟨b - 1, by omega⟩
    simp only [List.take_succ_cons, List.cons.injEq] at ht hYb
    obtain ⟨rfl, ht⟩ := ht
    obtain ⟨rfl, hYb⟩ := hYb
    simp only [List.length_cons, Nat.add_le_add_iff_right] at hl hbl
    have hdec : decAt_E2 d xs xs' a := by
      refine ⟨ht, hl, ?_⟩
      rcases hc with ⟨h1, h2⟩ | ⟨z, z', h1, h2, h3⟩
      · left; simp only [List.length_cons] at h1 h2; omega
      · right; exact ⟨z, z', by simpa using h1, by simpa using h2, h3⟩
    rcases List.cons_lt_cons_iff.1 hXY with h1 | ⟨h1, h2⟩
    · exact List.cons_lt_cons_iff.2 (Or.inl h1)
    · exact List.cons_lt_cons_iff.2 (Or.inr ⟨h1, ih h2 hdec hYb hbl (by omega)⟩)

theorem decAt_map_E2 {β γ : Type} {d : β → Nat} {d' : γ → Nat} {g : β → γ}
    (hg : ∀ x y, d x < d y → d' (g x) < d' (g y)) {X X' : List β} {a : Nat}
    (h : decAt_E2 d X X' a) : decAt_E2 d' (X.map g) (X'.map g) a := by
  obtain ⟨ht, hl, hc⟩ := h
  refine ⟨by rw [← List.map_take, ← List.map_take, ht], by simpa using hl, ?_⟩
  rcases hc with ⟨h1, h2⟩ | ⟨x, x', h1, h2, h3⟩
  · left; simp only [List.length_map]; exact ⟨h1, h2⟩
  · right; exact ⟨g x, g x', by simp [h1], by simp [h2], hg _ _ h3⟩

theorem decAt_append_E2 {β : Type} {d : β → Nat} (pre : List β) {X X' : List β} {a : Nat}
    (h : decAt_E2 d X X' a) : decAt_E2 d (pre ++ X) (pre ++ X') (pre.length + a) := by
  obtain ⟨ht, hl, hc⟩ := h
  refine ⟨?_, by simp only [List.length_append]; omega, ?_⟩
  · rw [List.take_append, List.take_append,
      List.take_of_length_le (by omega : pre.length ≤ pre.length + a), Nat.add_sub_cancel_left, ht]
  · rcases hc with ⟨h1, h2⟩ | ⟨x, x', h1, h2, h3⟩
    · left; simp only [List.length_append]; omega
    · right
      refine ⟨x, x', ?_, ?_, h3⟩
      · rw [List.getElem?_append_right (by omega), Nat.add_sub_cancel_left]; exact h1
      · rw [List.getElem?_append_right (by omega), Nat.add_sub_cancel_left]; exact h2

/-- The depth coordinate of a word atom. -/
def wdep_E2 (A : WordAtom) : Nat := (ofLex A).1

/-- A word atom read in the key word at threshold `b`. -/
def katom_E2 (b : Nat) (A : WordAtom) : GAtom (Lex (Bool × Nat)) := GAtom.map (relLabel b) (toGAtom A)

/-- The depth coordinate of a key-word atom. -/
def gdep_E2 (A : GAtom (Lex (Bool × Nat))) : Nat := (ofLex A).1

/-- The key word of a relative key is a relabelling of the word, keeping depths. -/
theorem gword_relKey_E2 (a : Nat) (H : Forest) :
    @gword (Lex (Bool × Nat)) (relKey a H) = (word H).map (katom_E2 a) := by
  change (gword (relKey a H) : List (GAtom (Bool × Nat))) = _
  rw [relKey_eq_map, gword_map, gword_eq_map_word, List.map_map]; rfl

theorem gatom_lt_of_dep_E2 {α : Type} [LinearOrder α] (x y : GAtom α)
    (h : (ofLex x).1 < (ofLex y).1) : x < y :=
  Prod.Lex.lt_iff.2 (Or.inl h)

/-- The S relation between a new and an old return height. -/
def relS_E2 (a : Nat) (J' J : Forest) : Prop :=
  (J' = J ∧ mu J < a) ∨ ∃ a', a' < a ∧ decAt_E2 wdep_E2 (word J) (word J') a'

/-- The S correspondence between a new and an old height. -/
def corrS_E2 (h' h : Forest) : Prop :=
  ∃ a, decAt_E2 wdep_E2 (word h) (word h') a ∧ entCorr_E2 (relS_E2 a) h' h

/-- The key condition of S. -/
def psiS_E2 (m : Nat) (J : Forest) (n : Nat) (H : Forest) : Prop := relKey m J < relKey n H

theorem condS_iff_ret_E2 (E : Forest) : CondS E ↔ spxAll (retAll_E2 psiS_E2) 0 E :=
  spx_ret_iff_E2 psiS_E2 E

theorem psiS_transfer_E2 {m n a : Nat} {J J' h h' : Forest} (hR : relS_E2 a J' J)
    (hd : decAt_E2 wdep_E2 (word h) (word h') a) (hlt : psiS_E2 m J n h) : psiS_E2 m J' n h' := by
  unfold psiS_E2 at hlt ⊢
  rw [spx_key_lt_iff, gword_relKey_E2, gword_relKey_E2] at hlt ⊢
  have hg : ∀ (b : Nat) (x y : WordAtom), wdep_E2 x < wdep_E2 y →
      gdep_E2 (katom_E2 b x) < gdep_E2 (katom_E2 b y) := fun _ _ _ h => h
  have hdM := decAt_map_E2 (d := wdep_E2) (d' := gdep_E2) (g := katom_E2 n) (hg n) hd
  rcases hR with ⟨hJJ, hJa⟩ | ⟨a', ha', hdJ⟩
  · rw [hJJ]
    apply lt_of_take_succ_E2 hlt
    have h1 := congrArg (List.take ((word J).length + 1)) hdM.1
    simp only [List.length_map]
    rwa [List.take_take, List.take_take, min_eq_left (by unfold mu at hJa; omega)] at h1
  · exact lt_of_decAt_E2 (gatom_lt_of_dep_E2) a' hlt
      (decAt_map_E2 (d := wdep_E2) (d' := gdep_E2) (g := katom_E2 m) (hg m) hdJ) hdM.1 hdM.2.1 ha'

/-! Word lengths. -/

theorem wordAt_length_E2 (e : Nat) (X : Forest) : (wordAt e X).length = mu X := by
  have := wordAt_add 0 e X
  rw [Nat.zero_add] at this
  rw [this, List.length_map]; rfl

theorem wordLater_length_mem_E2 (e : Nat) : ∀ (col : Column) (y : Nat × Forest), y ∈ col →
    mu y.2 < (wordLater e col).length
  | [], y, hy => by simp at hy
  | (p, h) :: rest, y, hy => by
    simp only [wordLater, List.length_cons, List.length_append, wordAt_length_E2]
    rcases List.mem_cons.1 hy with rfl | hy
    · show mu h < _; omega
    · have := wordLater_length_mem_E2 e rest y hy; omega

theorem wordCol_length_mem_E2 (e : Nat) {col : Column} {y : Nat × Forest} (hy : y ∈ col) :
    mu y.2 < (wordCol e col).length := by
  cases col with
  | nil => simp at hy
  | cons x rest =>
    obtain ⟨p, h⟩ := x
    simp only [wordCol, List.length_cons, List.length_append, wordAt_length_E2]
    rcases List.mem_cons.1 hy with rfl | hy
    · show mu h < _; omega
    · have := wordLater_length_mem_E2 e rest y hy; omega

theorem wordCols_length_mem_E2 (e : Nat) : ∀ {cols : List Column} {col : Column}, col ∈ cols →
    (wordCol e col).length ≤ (wordCols e cols).length
  | [], col, h => by simp at h
  | c :: cs, col, h => by
    simp only [wordCols, List.length_append]
    rcases List.mem_cons.1 h with rfl | h
    · omega
    · have := wordCols_length_mem_E2 e h; omega

theorem mu_node_E2 (cols : List Column) : mu (Tree.node cols) = (wordCols 0 cols).length := rfl

/-- Containment: an entry at any depth of `T` has a shorter word. -/
theorem mu_lt_of_colAt_E2 : ∀ (P : List (Nat × Nat)) (T : Forest) (j : Nat) {col : Column}
    {y : Nat × Forest}, T.colAt ⟨P, j⟩ = some col → y ∈ col → mu y.2 < mu T
  | [], .node cols, j, col, y, hc, hy => by
    rw [colAt_nil_E2] at hc
    rw [mu_node_E2]
    have := wordCol_length_mem_E2 0 hy
    have := wordCols_length_mem_E2 0 (List.mem_of_getElem? hc)
    omega
  | (a, b) :: ρ, .node cols, j, col, y, hc, hy => by
    rw [colAt_cons_E2, Option.bind_eq_some_iff] at hc
    obtain ⟨x, hx, hcx⟩ := hc
    have h1 := mu_lt_of_colAt_E2 ρ x.2 j hcx hy
    unfold getEnt_E2 at hx
    rw [Option.bind_eq_some_iff] at hx
    obtain ⟨colA, hA, hb⟩ := hx
    have h2 := mu_lt_of_colAt_E2 [] (Tree.node cols) a (col := colA) (y := x)
      (by rw [colAt_nil_E2]; exact hA) (List.mem_of_getElem? hb)
    omega

theorem allEnt_mu_E2 {T : Forest} {a : Nat} (h : mu T ≤ a) :
    allEnt_E2 (fun J => mu J < a) T := by
  intro c col hc y hy
  obtain ⟨P, j⟩ := c
  have := mu_lt_of_colAt_E2 P T j hc hy
  omega

theorem allEnt_relS_E2 {T : Forest} {a : Nat} (h : mu T ≤ a) :
    allEnt_E2 (fun J => relS_E2 a J J) T := by
  intro c col hc y hy
  exact Or.inl ⟨rfl, allEnt_mu_E2 h c col hc y hy⟩

/-! Words of the route levels. -/

theorem wordLater_append_E2 (e : Nat) : ∀ (l m : Column),
    wordLater e (l ++ m) = wordLater e l ++ wordLater e m
  | [], m => rfl
  | (p, h) :: l, m => by
    simp only [List.cons_append, wordLater, wordLater_append_E2 e l m, List.append_assoc]

theorem wordCol_cons_append_E2 (e : Nat) (x : Nat × Forest) (l m : Column) :
    wordCol e ((x :: l) ++ m) = wordCol e (x :: l) ++ wordLater e m := by
  obtain ⟨p, h⟩ := x
  simp only [List.cons_append, wordCol, wordLater_append_E2, List.append_assoc, List.cons_append]

theorem word_snoc_E2 (ys : List Column) (zs : Column) (q : Nat) (X : Forest) :
    word (Tree.node (ys ++ [zs ++ [(q, X)]])) =
      word (Tree.node (ys ++ [zs ++ [(q, Tree.empty)]])) ++
        (word X).map fun A => toLex ((ofLex A).1 + 2 * 1, (ofLex A).2) := by
  have := wordAt_add 0 1 X
  rw [Nat.zero_add] at this
  simp only [word, wordAt, wordCols_append, wordCols, List.append_nil]
  rw [wordCol_snoc, ← this]
  simp only [List.append_assoc]

theorem word_dropLast_E2 (e : Nat) {F : Forest} (hF : F.cols ≠ []) :
    ∃ last, wordAt e F = wordAt e (Tree.node F.cols.dropLast) ++ wordCol e last := by
  obtain ⟨cols⟩ := F
  simp only [Tree.cols] at hF ⊢
  obtain ⟨L, x, rfl⟩ := (List.eq_nil_or_concat cols).resolve_left hF
  refine ⟨x, ?_⟩
  simp only [wordAt]
  rw [List.concat_eq_append, List.dropLast_concat, wordCols_append]
  simp [wordCols]

theorem wordCol_ne_E2 (e : Nat) (c : Column) : wordCol e c ≠ [] := by
  cases c with
  | nil => simp [wordCol]
  | cons x r => obtain ⟨p, h⟩ := x; simp [wordCol]

theorem wordCol_head_E2 (e : Nat) (c : Column) : ∃ A rest, wordCol e c = A :: rest ∧
    wdep_E2 A = 2 * e := by
  cases c with
  | nil => exact ⟨_, _, rfl, rfl⟩
  | cons x r => obtain ⟨p, h⟩ := x; exact ⟨_, _, rfl, rfl⟩

theorem decAt_dropLast_E2 {F : Forest} (hF : F.cols ≠ []) :
    decAt_E2 wdep_E2 (word F) (word (Tree.node F.cols.dropLast)) (mu (Tree.node F.cols.dropLast)) := by
  obtain ⟨last, hw⟩ := word_dropLast_E2 0 hF
  change decAt_E2 wdep_E2 (wordAt 0 F) (wordAt 0 (Tree.node F.cols.dropLast)) _
  rw [hw]
  have hne := wordCol_ne_E2 0 last
  refine ⟨?_, le_refl _, Or.inl ⟨rfl, ?_⟩⟩
  · rw [List.take_append]; simp [mu, word]
  · simp only [List.length_append]
    have : (wordCol 0 last).length ≠ 0 := by simpa using hne
    change (wordAt 0 _).length < _
    omega

theorem mu_pos_E2 {F : Forest} (hF : F.cols ≠ []) : 0 < mu F := by
  obtain ⟨last, hw⟩ := word_dropLast_E2 0 hF
  have hne := wordCol_ne_E2 0 last
  unfold mu word
  rw [hw, List.length_append]
  have : (wordCol 0 last).length ≠ 0 := by simpa using hne
  omega

/-! The S correspondence: the three closure properties used by `spxAll_replace`. -/

/-- At the copies: `C` against `F`. -/
theorem corrS_dropLast_E2 {F : Forest} (hF : F.cols ≠ []) :
    corrS_E2 (Tree.node F.cols.dropLast) F :=
  ⟨_, decAt_dropLast_E2 hF, entCorr_dropLast_E2 (allEnt_relS_E2 (le_refl _))⟩

theorem retIn_of_corrS_E2 {h' h : Forest} {n : Nat} (hC : corrS_E2 h' h)
    (hR : retIn_E2 psiS_E2 n h) : retIn_E2 psiS_E2 n h' := by
  obtain ⟨a, hd, hE⟩ := hC
  exact retIn_of_entCorr_E2 hE (fun m J' J hr hl => psiS_transfer_E2 hr hd hl) hR

theorem corrS_snoc_E2 (ys : List Column) (zs : Column) (q : Nat) (h h' : Forest)
    (hC : corrS_E2 h' h) :
    corrS_E2 (Tree.node (ys ++ [zs ++ [(q, h')]])) (Tree.node (ys ++ [zs ++ [(q, h)]])) := by
  obtain ⟨a, hd, hE⟩ := hC
  set T : Forest := Tree.node (ys ++ [zs ++ [(q, Tree.empty)]]) with hT
  have hTpos : 0 < mu T := mu_pos_E2 (by simp [hT, Tree.cols])
  refine ⟨mu T + a, ?_, ?_⟩
  · rw [word_snoc_E2 ys zs q h, word_snoc_E2 ys zs q h']
    have := decAt_append_E2 (word T)
      (decAt_map_E2 (d' := wdep_E2) (g := fun A : WordAtom => toLex ((ofLex A).1 + 2 * 1, (ofLex A).2))
        (fun x y h => by unfold wdep_E2 at h ⊢; simp only [ofLex_toLex]; omega) hd)
    exact this
  · refine entCorr_snoc_E2 hE ?_ ?_ (allEnt_relS_E2 (by show mu T ≤ mu T + a; omega))
    · intro J' J hr
      rcases hr with ⟨h1, h2⟩ | ⟨a', h1, h2⟩
      · exact Or.inl ⟨h1, by omega⟩
      · exact Or.inr ⟨a', by omega, h2⟩
    · exact Or.inr ⟨a, by omega, hd⟩

theorem corrS_top_E2 (cs : List Column) {P : Column} {p N : Nat} {Fl : Forest}
    (hFl : Fl.cols ≠ []) (hN : P = [] → 1 ≤ N) :
    corrS_E2 (Tree.node (cs ++ [P ++ List.replicate N (p, Tree.node Fl.cols.dropLast)]))
      (Tree.node (cs ++ [P ++ [(p, Fl)]])) := by
  set C : Forest := Tree.node Fl.cols.dropLast with hC
  have hw : ∀ c : Column, word (Tree.node (cs ++ [c])) = wordCols 0 cs ++ wordCol 0 c := by
    intro c; simp [word, wordAt, wordCols_append, wordCols]
  have hTmu : mu (Tree.node (cs ++ [P])) = (wordCols 0 cs).length + (wordCol 0 P).length := by
    unfold mu; rw [hw, List.length_append]
  cases N with
  | zero =>
    obtain ⟨x, Pt, rfl⟩ : ∃ x Pt, P = x :: Pt := by
      cases P with
      | nil => exact absurd (hN rfl) (by omega)
      | cons x Pt => exact ⟨x, Pt, rfl⟩
    refine ⟨(wordCols 0 cs).length + (wordCol 0 (x :: Pt)).length, ?_, ?_⟩
    · rw [hw, hw, List.replicate_zero, List.append_nil, wordCol_cons_append_E2, ← List.append_assoc]
      refine ⟨?_, by simp, Or.inl ⟨by simp, ?_⟩⟩
      · rw [List.take_append, List.take_append, List.take_of_length_le (by simp),
          List.take_of_length_le (by simp)]
        simp
      · simp [wordLater]
    · refine entCorr_top_E2 (allEnt_relS_E2 (by rw [hTmu])) (fun h => absurd rfl h)
        (fun h => absurd rfl h)
  | succ N =>
    have hrep : P ++ List.replicate (N + 1) (p, C) = (P ++ [(p, C)]) ++ List.replicate N (p, C) := by
      rw [List.replicate_succ, List.append_assoc]; rfl
    obtain ⟨last, hwl⟩ := word_dropLast_E2 1 hFl
    set pre := wordCols 0 cs ++ wordCol 0 (P ++ [(p, Tree.empty)]) ++ wordAt 1 C with hpre
    have hwB : word (Tree.node (cs ++ [P ++ List.replicate (N + 1) (p, C)])) =
        pre ++ wordLater 0 (List.replicate N (p, C)) := by
      rw [hw, hrep]
      obtain ⟨y, ys, hys⟩ : ∃ y ys, P ++ [(p, C)] = y :: ys := by
        cases P with
        | nil => exact ⟨_, _, rfl⟩
        | cons y ys => exact ⟨_, _, rfl⟩
      rw [hys, wordCol_cons_append_E2, ← hys, wordCol_snoc, hpre]
      simp only [List.append_assoc]
    have hwA : word (Tree.node (cs ++ [P ++ [(p, Fl)]])) = pre ++ wordCol 1 last := by
      rw [hw, wordCol_snoc, hwl, hpre]
      simp only [List.append_assoc]; rfl
    have hCpre : mu C + 1 ≤ pre.length := by
      have := wordCol_ne_E2 0 (P ++ [(p, Tree.empty)])
      have : (wordCol 0 (P ++ [(p, Tree.empty)])).length ≠ 0 := by simpa using this
      simp only [hpre, List.length_append, wordAt_length_E2]
      omega
    have hPpre : mu (Tree.node (cs ++ [P])) ≤ pre.length := by
      rw [hTmu]
      have : (wordCol 0 P).length ≤ (wordCol 0 (P ++ [(p, Tree.empty)])).length := by
        cases P with
        | nil => simp [wordCol, wordLater, Tree.empty, wordAt, wordCols]
        | cons y ys => rw [wordCol_cons_append_E2]; simp
      simp only [hpre, List.length_append]
      omega
    refine ⟨pre.length, ?_, ?_⟩
    · rw [hwA, hwB]
      have h0 : decAt_E2 wdep_E2 (wordCol 1 last) (wordLater 0 (List.replicate N (p, C))) 0 := by
        obtain ⟨A, rest, hA, hdA⟩ := wordCol_head_E2 1 last
        refine ⟨by simp, by simp, ?_⟩
        cases N with
        | zero => left; simp [wordLater, hA]
        | succ N =>
          right
          refine ⟨A, _, by rw [hA]; rfl, by rw [List.replicate_succ]; rfl, ?_⟩
          rw [hdA]; simp [wdep_E2]
      have := decAt_append_E2 pre h0
      rwa [Nat.add_zero] at this
    · refine entCorr_top_E2 (allEnt_relS_E2 hPpre) (fun _ => allEnt_relS_E2 (show mu C ≤ _ by omega))
        (fun _ => Or.inr ⟨mu C, by omega, decAt_dropLast_E2 hFl⟩)


theorem retAll_corrS_E2 (n : Nat) (zs : Column) (q : Nat) (h h' : Forest) (hC : corrS_E2 h' h)
    (hφ : retAll_E2 psiS_E2 n (zs ++ [(q, h)])) : retAll_E2 psiS_E2 n (zs ++ [(q, h')]) := by
  intro x hx
  rcases List.mem_append.1 hx with hx | hx
  · exact hφ x (List.mem_append_left _ hx)
  · simp only [List.mem_singleton] at hx; subst hx
    exact retIn_of_corrS_E2 hC (hφ (q, h) (by simp))

-- T3.2t (txt:406-409): special outputs satisfy S, and P when present
theorem condS_special {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .special)
    (hB : expand A n = some B) : CondS B := by
  obtain ⟨π, G, cs, P, p, Fl, N, hrp, hG, hGc, hFl, hN, rfl⟩ := spx_special_shape hL hk hB
  have hS := hL.2.2.2.2
  have hcolA : A.colAt ⟨π, cs.length⟩ = some (P ++ [(p, Fl)]) := by
    simp [Tree.colAt, hG, hGc]
  rw [condS_iff_ret_E2] at hS ⊢
  refine (spxAll_replace (φ := retAll_E2 psiS_E2) corrS_E2 (fun cs' => corrS_top_E2 cs' hFl hN)
    corrS_snoc_E2 retAll_corrS_E2 π A G cs 0 hrp hG hGc hS ?_ ?_).1
  · intro x hx
    rcases spx_mem_special hx with hx | rfl
    · exact hS _ _ hcolA x (List.mem_append_left _ hx)
    · exact retIn_of_corrS_E2 (corrS_dropLast_E2 hFl) (hS _ _ hcolA (p, Fl) (by simp))
  · intro x hx
    rcases spx_mem_special hx with hx | rfl
    · exact spxAll_height hS hcolA x (List.mem_append_left _ hx)
    · exact spxAll_dropLast (spxAll_height hS hcolA (p, Fl) (by simp))

/-! T3.2t helpers (branch E2): the P correspondence. -/

/-- The profile condition of P. -/
def psiP_E2 (_m : Nat) (J : Forest) (_n : Nat) (H : Forest) : Prop := profile J < profile H

/-- The P relation between a new and an old return height. -/
def relP_E2 (J' J : Forest) : Prop := profile J' ≤ profile J

/-- The P correspondence between a new and an old height: the profile does not increase, entries
correspond with nonincreasing profiles, and either the profile is unchanged or every entry of the
new height has a smaller profile (the shortened pure tower). -/
def corrP_E2 (h' h : Forest) : Prop :=
  h'.cols ≠ [] ∧ profile h' ≤ profile h ∧ entCorr_E2 relP_E2 h' h ∧
    (profile h' = profile h ∨ allEnt_E2 (fun J => profile J < profile h') h')

theorem condP_iff_ret_E2 (E : Forest) : CondP E ↔ spxAll (retAll_E2 psiP_E2) 0 E :=
  spx_ret_iff_E2 psiP_E2 E

theorem allEnt_refl_E2 {Rel : Forest → Forest → Prop} (hR : ∀ J, Rel J J) (T : Forest) :
    allEnt_E2 (fun J => Rel J J) T := fun _ _ _ y _ => hR y.2

theorem retIn_of_corrP_E2 {h' h : Forest} {n : Nat} (hC : corrP_E2 h' h)
    (hR : retIn_E2 psiP_E2 n h) : retIn_E2 psiP_E2 n h' := by
  obtain ⟨-, -, hE, heq | htw⟩ := hC
  · exact retIn_of_entCorr_E2 hE
      (fun m J' J hr hl => by unfold psiP_E2 at hl ⊢; rw [heq]; exact lt_of_le_of_lt hr hl) hR
  · exact retIn_of_allEnt_E2 (fun c col hc y hy m => htw c col hc y hy)

theorem profile_some_E2 {F : Forest} (h : F.cols ≠ []) :
    profile F = ((profileAux 0 F : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by
  rw [spx_eta F, spx_profile_node h]

theorem profile_nil_E2 {F : Forest} (h : F.cols = []) : profile F = ⊥ := by
  rw [spx_eta F, h]; rfl

theorem profileAux_first_E2 (d : Nat) (c : Column) (r1 r2 : List Column) :
    profileAux d (Tree.node (c :: r1)) = profileAux d (Tree.node (c :: r2)) := by
  cases c with
  | nil => simp [profileAux]
  | cons x rest => obtain ⟨p, ⟨hc⟩⟩ := x; cases hc <;> simp [profileAux]

theorem profile_first_E2 (c : Column) (r1 r2 : List Column) :
    profile (Tree.node (c :: r1)) = profile (Tree.node (c :: r2)) := by
  rw [spx_profile_node (by simp), spx_profile_node (by simp), profileAux_first_E2 0 c r1 r2]

theorem takeWhile_fst_E2 (p : Nat) : ∀ (r1 r2 : Column), r1.map Prod.fst = r2.map Prod.fst →
    (r1.takeWhile fun x => x.1 == p).length = (r2.takeWhile fun x => x.1 == p).length
  | [], [], _ => rfl
  | [], _ :: _, h => by simp at h
  | _ :: _, [], h => by simp at h
  | x :: xs, y :: ys, h => by
    simp only [List.map_cons, List.cons.injEq] at h
    simp only [List.takeWhile_cons, h.1]
    split_ifs
    · simp only [List.length_cons]; rw [takeWhile_fst_E2 p xs ys h.2]
    · rfl

theorem profileAux_parents_E2 (d p0 : Nat) (h0 : Forest) {r1 r2 : Column}
    (hr : r1.map Prod.fst = r2.map Prod.fst) (t1 t2 : List Column) :
    profileAux d (Tree.node (((p0, h0) :: r1) :: t1)) =
      profileAux d (Tree.node (((p0, h0) :: r2) :: t2)) := by
  obtain ⟨hc⟩ := h0
  cases hc with
  | nil => simp only [profileAux]; rw [takeWhile_fst_E2 p0 r1 r2 hr]
  | cons y ys => simp [profileAux]

theorem profile_single_E2 (q : Nat) {X : Forest} (hX : X.cols ≠ []) :
    profile (Tree.node [[(q, X)]]) =
      ((toLex ((ofLex (profileAux 0 X)).1 + 1, (ofLex (profileAux 0 X)).2) : Nat ×ₗ Nat) :
        WithBot (Nat ×ₗ Nat)) := by
  rw [spx_profile_node (by simp), spx_profileAux_cons 0 q hX, spx_profileAux_one]

theorem lex_shift_le_E2 {u v : Nat ×ₗ Nat} (h : u ≤ v) :
    (toLex ((ofLex u).1 + 1, (ofLex u).2) : Nat ×ₗ Nat) ≤ toLex ((ofLex v).1 + 1, (ofLex v).2) := by
  rw [Prod.Lex.le_iff] at h
  rw [Prod.Lex.toLex_le_toLex]
  rcases h with h | ⟨h1, h2⟩
  · left; simp only; omega
  · right; exact ⟨by simp only; omega, h2⟩

theorem lex_lt_shift_E2 (u : Nat ×ₗ Nat) :
    u < (toLex ((ofLex u).1 + 1, (ofLex u).2) : Nat ×ₗ Nat) := by
  rw [Prod.Lex.lt_iff]; left; simp

theorem allEnt_single_E2 {Q : Forest → Prop} {q : Nat} {h : Forest} (hh : Q h)
    (hA : allEnt_E2 Q h) : allEnt_E2 Q (Tree.node [[(q, h)]]) := by
  intro c col hc y hy
  obtain ⟨P, j⟩ := c
  cases P with
  | nil =>
    rw [colAt_nil_E2] at hc
    cases j with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.some.injEq] at hc
      subst hc
      simp only [List.mem_singleton] at hy; subst hy; exact hh
    | succ j => simp at hc
  | cons s ρ =>
    obtain ⟨a, b⟩ := s
    rw [colAt_cons_E2, Option.bind_eq_some_iff] at hc
    obtain ⟨x, hx, hcx⟩ := hc
    have : x = (q, h) := by
      unfold getEnt_E2 at hx
      cases a with
      | zero =>
        cases b with
        | zero => simpa using hx.symm
        | succ b => simp at hx
      | succ a => simp at hx
    subst this
    exact hA _ _ hcx y hy

theorem corrP_snoc_E2 (ys : List Column) (zs : Column) (q : Nat) (h h' : Forest)
    (hC : corrP_E2 h' h) :
    corrP_E2 (Tree.node (ys ++ [zs ++ [(q, h')]])) (Tree.node (ys ++ [zs ++ [(q, h)]])) := by
  obtain ⟨hne, hle, hE, hdisj⟩ := hC
  have hhne : h.cols ≠ [] := by
    intro h0
    rw [profile_nil_E2 h0, profile_some_E2 hne] at hle
    exact absurd hle (not_le.2 (WithBot.bot_lt_coe _))
  have hEc : entCorr_E2 relP_E2 (Tree.node (ys ++ [zs ++ [(q, h')]]))
      (Tree.node (ys ++ [zs ++ [(q, h)]])) :=
    entCorr_snoc_E2 hE (fun _ _ h => h) hle (allEnt_refl_E2 (fun J => le_refl (profile J)) _)
  have hsame : ¬ (ys = [] ∧ zs = []) → profile (Tree.node (ys ++ [zs ++ [(q, h')]])) =
      profile (Tree.node (ys ++ [zs ++ [(q, h)]])) := by
    intro hyz
    cases ys with
    | cons y ys => exact profile_first_E2 y _ _
    | nil =>
      cases zs with
      | nil => exact absurd ⟨rfl, rfl⟩ hyz
      | cons z zs =>
        obtain ⟨p0, h0⟩ := z
        simp only [List.nil_append, List.cons_append]
        rw [spx_profile_node (by simp), spx_profile_node (by simp),
          profileAux_parents_E2 0 p0 h0 (r1 := zs ++ [(q, h')]) (r2 := zs ++ [(q, h)]) (by simp)]
  refine ⟨by simp [Tree.cols], ?_, hEc, ?_⟩
  · by_cases hyz : ys = [] ∧ zs = []
    · obtain ⟨rfl, rfl⟩ := hyz
      simp only [List.nil_append]
      rw [profile_single_E2 q hne, profile_single_E2 q hhne, WithBot.coe_le_coe]
      rw [profile_some_E2 hne, profile_some_E2 hhne, WithBot.coe_le_coe] at hle
      exact lex_shift_le_E2 hle
    · rw [hsame hyz]
  · by_cases hyz : ys = [] ∧ zs = []
    · obtain ⟨rfl, rfl⟩ := hyz
      simp only [List.nil_append]
      rcases hdisj with heq | htw
      · left
        rw [profile_some_E2 hne, profile_some_E2 hhne, WithBot.coe_inj] at heq
        rw [profile_single_E2 q hne, profile_single_E2 q hhne, heq]
      · right
        have hlt : profile h' < profile (Tree.node [[(q, h')]]) := by
          rw [profile_single_E2 q hne, profile_some_E2 hne, WithBot.coe_lt_coe]
          exact lex_lt_shift_E2 _
        refine allEnt_single_E2 hlt ?_
        intro c col hc y hy
        exact lt_trans (htw c col hc y hy) hlt
    · left; exact hsame hyz

theorem dropLast_first_E2 {l : List Column} (h : l.dropLast ≠ []) :
    ∃ c0 r1 r2, l = c0 :: r1 ∧ l.dropLast = c0 :: r2 := by
  cases l with
  | nil => simp at h
  | cons c0 r1 =>
    cases r1 with
    | nil => simp at h
    | cons x xs => exact ⟨c0, x :: xs, (x :: xs).dropLast, rfl, List.dropLast_cons_of_ne_nil (by simp)⟩

theorem profile_dropLast_E2 {F : Forest} (h : F.cols.dropLast ≠ []) :
    profile (Tree.node F.cols.dropLast) = profile F := by
  obtain ⟨c0, r1, r2, h1, h2⟩ := dropLast_first_E2 h
  rw [h2, spx_eta F, h1]
  exact profile_first_E2 c0 r2 r1

theorem profile_dropLast_le_E2 (F : Forest) : profile (Tree.node F.cols.dropLast) ≤ profile F := by
  by_cases h : F.cols.dropLast = []
  · rw [profile_nil_E2 (show (Tree.node F.cols.dropLast).cols = [] from h)]; exact bot_le
  · rw [profile_dropLast_E2 h]

theorem retIn_copyP_E2 {F : Forest} {n : Nat} (hR : retIn_E2 psiP_E2 n F) :
    retIn_E2 psiP_E2 n (Tree.node F.cols.dropLast) := by
  by_cases h : F.cols.dropLast = []
  · intro c col hc
    rw [h, show (Tree.node [] : Forest) = Tree.empty from rfl, spx_colAt_empty] at hc
    cases hc
  · refine retIn_of_entCorr_E2 (entCorr_dropLast_E2 (allEnt_refl_E2 (Rel := relP_E2)
      (fun J => le_refl (profile J)) _)) (fun m J' J hr hl => ?_) hR
    unfold psiP_E2 at hl ⊢
    rw [profile_dropLast_E2 h]
    exact lt_of_le_of_lt hr hl

theorem corrP_top_E2 (cs : List Column) {P : Column} {p N : Nat} {Fl : Forest}
    (hFl : Fl.cols ≠ []) (hN : P = [] → 1 ≤ N) (hnon : spxNoninc (P ++ [(p, Fl)])) :
    corrP_E2 (Tree.node (cs ++ [P ++ List.replicate N (p, Tree.node Fl.cols.dropLast)]))
      (Tree.node (cs ++ [P ++ [(p, Fl)]])) := by
  set C : Forest := Tree.node Fl.cols.dropLast with hC
  have hEc := entCorr_top_E2 (Rel := relP_E2) (cs := cs) (P := P) (p := p) (N := N) (Fl := Fl)
    (allEnt_refl_E2 (fun J => le_refl (profile J)) _)
    (fun _ => allEnt_refl_E2 (fun J => le_refl (profile J)) _)
    (fun _ => profile_dropLast_le_E2 Fl)
  -- the profile is unchanged, or the tower case
  have key : profile (Tree.node (cs ++ [P ++ List.replicate N (p, C)])) =
      profile (Tree.node (cs ++ [P ++ [(p, Fl)]])) ∨
      (profile (Tree.node (cs ++ [P ++ List.replicate N (p, C)])) <
        profile (Tree.node (cs ++ [P ++ [(p, Fl)]])) ∧
        allEnt_E2 (fun J => profile J < profile (Tree.node (cs ++ [P ++ List.replicate N (p, C)])))
          (Tree.node (cs ++ [P ++ List.replicate N (p, C)]))) := by
    cases cs with
    | cons c0 cs => left; exact profile_first_E2 c0 _ _
    | nil =>
      simp only [List.nil_append]
      cases P with
      | cons x Pt =>
        left
        obtain ⟨p0, h0⟩ := x
        by_cases h0e : h0.cols = []
        · have h0E : h0 = Tree.node [] := by rw [spx_eta h0, h0e]
          subst h0E
          simp only [List.cons_append]
          rw [spx_profile_node (by simp), spx_profile_node (by simp)]
          congr 1
          simp only [profileAux]
          congr 3
          rw [List.takeWhile_append, List.takeWhile_append]
          split_ifs with hall
          · have hpp : p ≠ p0 := by
              intro hpp
              have hrun := spx_run_empty p0 (Pt ++ [(p, Fl)]) hnon
              have hmem : (p, Fl) ∈ (Pt ++ [(p, Fl)]).takeWhile (fun x => x.1 == p0) := by
                rw [List.takeWhile_append, if_pos hall]; simp [hpp]
              have := hrun _ hmem
              simp only [Prod.mk.injEq] at this
              exact hFl (by rw [this.2]; rfl)
            have e1 : ([(p, Fl)] : Column).takeWhile (fun x => x.1 == p0) = [] := by simp [hpp]
            have e2 : (List.replicate N (p, C)).takeWhile (fun x => x.1 == p0) = [] := by
              cases N with
              | zero => rfl
              | succ N => simp [List.replicate_succ, hpp]
            rw [e1, e2]
          · rfl
        · rw [spx_profile_node (by simp), spx_profile_node (by simp)]
          simp only [List.cons_append]
          rw [spx_profileAux_cons 0 p0 h0e, spx_profileAux_cons 0 p0 h0e]
      | nil =>
        obtain ⟨N', rfl⟩ : ∃ N', N = N' + 1 := ⟨N - 1, by have := hN rfl; omega⟩
        simp only [List.nil_append, List.replicate_succ]
        rw [profile_single_E2 p hFl]
        by_cases hCe : C.cols = []
        · right
          have hC0 : C = Tree.node [] := by rw [spx_eta C, hCe]
          rw [spx_profile_node (by simp)]
          have hlt : ((profileAux 0 (Tree.node [(p, C) :: List.replicate N' (p, C)]) : Nat ×ₗ Nat) :
              WithBot (Nat ×ₗ Nat)) <
              ((toLex ((ofLex (profileAux 0 Fl)).1 + 1, (ofLex (profileAux 0 Fl)).2) : Nat ×ₗ Nat) :
                WithBot (Nat ×ₗ Nat)) := by
            rw [WithBot.coe_lt_coe, hC0]
            simp only [profileAux]
            rw [Prod.Lex.lt_iff]; left; simp
          refine ⟨hlt, ?_⟩
          intro c col hc y hy
          obtain ⟨Pa, j⟩ := c
          cases Pa with
          | nil =>
            rw [colAt_nil_E2] at hc
            cases j with
            | zero =>
              simp only [List.getElem?_cons_zero, Option.some.injEq] at hc
              subst hc
              have hy' : y = (p, C) := by
                rcases List.mem_cons.1 hy with h | h
                · exact h
                · exact List.eq_of_mem_replicate h
              rw [hy', profile_nil_E2 hCe]
              exact WithBot.bot_lt_coe _
            | succ j => simp at hc
          | cons s ρ =>
            obtain ⟨a, b⟩ := s
            rw [colAt_cons_E2, Option.bind_eq_some_iff] at hc
            obtain ⟨x, hx, hcx⟩ := hc
            have hx2 : x.2 = C := by
              unfold getEnt_E2 at hx
              cases a with
              | zero =>
                simp only [List.getElem?_cons_zero, Option.bind_some] at hx
                have := List.mem_of_getElem? hx
                rcases List.mem_cons.1 this with h | h
                · rw [h]
                · rw [List.eq_of_mem_replicate h]
              | succ a => simp at hx
            rw [hx2, hC0, show (Tree.node [] : Forest) = Tree.empty from rfl, spx_colAt_empty] at hcx
            cases hcx
        · left
          rw [spx_profile_node (by simp), spx_profileAux_cons 0 p hCe, spx_profileAux_one]
          obtain ⟨c0, r1, r2, h1, h2⟩ := dropLast_first_E2 (l := Fl.cols) hCe
          have : profileAux 0 C = profileAux 0 Fl := by
            rw [hC, h2, spx_eta Fl, h1]; exact profileAux_first_E2 0 c0 r2 r1
          rw [this]
  refine ⟨by simp [Tree.cols], ?_, hEc, ?_⟩
  · rcases key with h | ⟨h, -⟩
    · rw [h]
    · exact le_of_lt h
  · rcases key with h | ⟨-, h⟩
    · left; exact h
    · right; exact h

theorem retAll_corrP_E2 (n : Nat) (zs : Column) (q : Nat) (h h' : Forest) (hC : corrP_E2 h' h)
    (hφ : retAll_E2 psiP_E2 n (zs ++ [(q, h)])) : retAll_E2 psiP_E2 n (zs ++ [(q, h')]) := by
  intro x hx
  rcases List.mem_append.1 hx with hx | hx
  · exact hφ x (List.mem_append_left _ hx)
  · simp only [List.mem_singleton] at hx; subst hx
    exact retIn_of_corrP_E2 hC (hφ (q, h) (by simp))

theorem condP_special {A B : Forest} {n : Nat} (hL : InL A) (hP : CondP A)
    (hk : stepKind A = some .special) (hB : expand A n = some B) : CondP B := by
  obtain ⟨π, G, cs, P, p, Fl, N, hrp, hG, hGc, hFl, hN, rfl⟩ := spx_special_shape hL hk hB
  have hcolA : A.colAt ⟨π, cs.length⟩ = some (P ++ [(p, Fl)]) := by
    simp [Tree.colAt, hG, hGc]
  have hnon : spxNoninc (P ++ [(p, Fl)]) := spx_condH_col hL.2.2.1 hcolA
  rw [condP_iff_ret_E2] at hP ⊢
  refine (spxAll_replace (φ := retAll_E2 psiP_E2) corrP_E2
    (fun cs' => corrP_top_E2 cs' hFl hN hnon)
    corrP_snoc_E2 retAll_corrP_E2 π A G cs 0 hrp hG hGc hP ?_ ?_).1
  · intro x hx
    rcases spx_mem_special hx with hx | rfl
    · exact hP _ _ hcolA x (List.mem_append_left _ hx)
    · exact retIn_copyP_E2 (hP _ _ hcolA (p, Fl) (by simp))
  · intro x hx
    rcases spx_mem_special hx with hx | rfl
    · exact spxAll_height hP hcolA x (List.mem_append_left _ hx)
    · exact spxAll_dropLast (spxAll_height hP hcolA (p, Fl) (by simp))

/-! T3.2u helpers (branch E2): addresses of a special output read in the input. -/

/-- The address map of a special output into its input: a path through the `i`-th entry
(`i ≥ i0`) of column `j0` at the end of the route path `π` (a copy) goes through entry `i0`. -/
def projP_E2 (j0 i0 : Nat) : List (Nat × Nat) → List (Nat × Nat) → List (Nat × Nat)
  | [], [] => []
  | [], (a, i) :: ρ => if a = j0 ∧ i0 ≤ i then (j0, i0) :: ρ else (a, i) :: ρ
  | _ :: _, [] => []
  | s :: π, x :: σ => if x = s then x :: projP_E2 j0 i0 π σ else x :: σ

theorem projP_fst_E2 (j0 i0 : Nat) : ∀ (π σ : List (Nat × Nat)),
    (projP_E2 j0 i0 π σ).map Prod.fst = σ.map Prod.fst
  | [], [] => rfl
  | [], (a, i) :: ρ => by
    simp only [projP_E2]; split_ifs with h
    · simp [h.1]
    · rfl
  | _ :: _, [] => rfl
  | s :: π, x :: σ => by
    simp only [projP_E2]; split_ifs
    · simp [projP_fst_E2 j0 i0 π σ]
    · rfl

theorem projP_length_E2 (j0 i0 : Nat) (π σ : List (Nat × Nat)) :
    (projP_E2 j0 i0 π σ).length = σ.length := by
  have := congrArg List.length (projP_fst_E2 j0 i0 π σ)
  simpa using this

theorem projP_nil_E2 (j0 i0 : Nat) (π : List (Nat × Nat)) : projP_E2 j0 i0 π [] = [] := by
  cases π <;> rfl

theorem projP_take_E2 (j0 i0 : Nat) : ∀ (π σ : List (Nat × Nat)) (k : Nat),
    (projP_E2 j0 i0 π σ).take k = projP_E2 j0 i0 π (σ.take k)
  | π, [], k => by simp [projP_nil_E2]
  | π, x :: σ, 0 => by simp [projP_nil_E2]
  | [], (a, i) :: ρ, k + 1 => by
    by_cases h : a = j0 ∧ i0 ≤ i <;> simp [projP_E2, h]
  | s :: π, x :: σ, k + 1 => by
    by_cases hx : x = s
    · simp [projP_E2, hx, projP_take_E2 j0 i0 π σ k]
    · simp [projP_E2, hx]

theorem projP_prefix_E2 (j0 i0 : Nat) (π : List (Nat × Nat)) {τ σ : List (Nat × Nat)}
    (h : τ <+: σ) : projP_E2 j0 i0 π τ <+: projP_E2 j0 i0 π σ := by
  obtain ⟨t, rfl⟩ := h
  have := projP_take_E2 j0 i0 π (τ ++ t) τ.length
  rw [List.take_left' rfl] at this
  rw [← this]
  exact List.take_prefix _ _

theorem projP_getElem_fst_E2 (j0 i0 : Nat) (π σ : List (Nat × Nat)) (k : Nat) :
    ((projP_E2 j0 i0 π σ)[k]?).map Prod.fst = (σ[k]?).map Prod.fst := by
  rw [← List.getElem?_map, ← List.getElem?_map, projP_fst_E2]

/-- The entry index map: copies of the owner column go to the replaced entry. -/
def projI_E2 (π : List (Nat × Nat)) (j0 i0 : Nat) (e : EntryAddr) : Nat :=
  if e.col.path = π ∧ e.col.col = j0 ∧ i0 ≤ e.idx then i0 else e.idx

theorem projP_snoc_E2 (j0 i0 : Nat) : ∀ (π path : List (Nat × Nat)) (cc idx : Nat),
    projP_E2 j0 i0 π (path ++ [(cc, idx)]) =
      projP_E2 j0 i0 π path ++
        [(cc, if path = π ∧ cc = j0 ∧ i0 ≤ idx then i0 else idx)]
  | [], [], cc, idx => by
    by_cases h : cc = j0 ∧ i0 ≤ idx
    · simp [projP_E2, h, h.1]
    · simp [projP_E2, h]
  | [], (a, i) :: ρ, cc, idx => by
    by_cases h : a = j0 ∧ i0 ≤ i <;> simp [projP_E2, h]
  | s :: π, [], cc, idx => by
    by_cases h : (cc, idx) = s <;> simp [projP_E2, h, projP_nil_E2]
  | s :: π, x :: path, cc, idx => by
    by_cases hx : x = s
    · subst hx; simp [projP_E2, projP_snoc_E2 j0 i0 π path cc idx]
    · simp [projP_E2, hx]

/-- Column addresses read in the input. -/
def projC_E2 (π : List (Nat × Nat)) (j0 i0 : Nat) (c : ColAddr) : ColAddr :=
  ⟨projP_E2 j0 i0 π c.path, c.col⟩

/-- Entry addresses read in the input. -/
def projE_E2 (π : List (Nat × Nat)) (j0 i0 : Nat) (e : EntryAddr) : EntryAddr :=
  ⟨projC_E2 π j0 i0 e.col, projI_E2 π j0 i0 e⟩

theorem projE_heightPath_E2 (π : List (Nat × Nat)) (j0 i0 : Nat) (e : EntryAddr) :
    (projE_E2 π j0 i0 e).heightPath = projP_E2 j0 i0 π e.heightPath := by
  simp only [EntryAddr.heightPath, projE_E2, projC_E2, projI_E2]
  rw [projP_snoc_E2]

theorem projE_contains_E2 (π : List (Nat × Nat)) (j0 i0 : Nat) {e : EntryAddr} {c : ColAddr}
    (h : e.Contains c) : (projE_E2 π j0 i0 e).Contains (projC_E2 π j0 i0 c) := by
  unfold EntryAddr.Contains at h ⊢
  rw [projE_heightPath_E2]
  exact projP_prefix_E2 j0 i0 π h

theorem projC_num_E2 (π : List (Nat × Nat)) (j0 i0 : Nat) (b : Nat) (c : ColAddr) :
    (projC_E2 π j0 i0 c).num b = c.num b := by
  simp only [ColAddr.num, projC_E2]
  have := projP_fst_E2 j0 i0 π c.path
  have h2 : ((projP_E2 j0 i0 π c.path).map (·.1 + 1)) = (c.path.map (·.1 + 1)) := by
    have e1 : (projP_E2 j0 i0 π c.path).map (·.1 + 1) =
        ((projP_E2 j0 i0 π c.path).map Prod.fst).map (· + 1) := by simp
    have e2 : c.path.map (·.1 + 1) = (c.path.map Prod.fst).map (· + 1) := by simp
    rw [e1, e2, this]
  rw [h2]

theorem projC_resolve_E2 (π : List (Nat × Nat)) (j0 i0 : Nat) {c o : ColAddr} {z : Nat}
    (h : c.resolve 0 z = some o) :
    (projC_E2 π j0 i0 c).resolve 0 z = some (projC_E2 π j0 i0 o) := by
  obtain ⟨hs, hn⟩ := (ColAddr.resolve_spec 0 c o z).1 h
  refine (ColAddr.resolve_spec 0 _ _ z).2 ⟨?_, by rw [projC_num_E2]; exact hn⟩
  rcases hs with ⟨k, ck, ik, hk, hp, hc⟩ | ⟨hp, hc⟩
  · have hk' := projP_getElem_fst_E2 j0 i0 π c.path k
    rw [hk] at hk'
    obtain ⟨⟨ck', ik'⟩, hk'', hck⟩ := Option.map_eq_some_iff.1 hk'
    simp only at hck
    subst hck
    refine Or.inl ⟨k, ck', ik', hk'', ?_, hc⟩
    simp only [projC_E2]
    rw [hp, projP_take_E2]
  · exact Or.inr ⟨by simp only [projC_E2]; rw [hp], hc⟩

/-- A column on the route path `π` above its end: the last column at depth `d < |π|`. -/
def isCont_E2 (π σ : List (Nat × Nat)) (j : Nat) : Prop :=
  ∃ d < π.length, σ = π.take d ∧ ∃ e, π[d]? = some (j, e)

theorem lastStep_snoc_E2 (ys : List Column) (zs : Column) (q : Nat) (h : Forest) :
    (Tree.node (ys ++ [zs ++ [(q, h)]])).lastStep? = some (ys.length, zs.length) := by
  simp [Tree.lastStep?, Tree.cols]

/-- The route of a special output still reaches the owner column. -/
theorem route_replace_E2 {c' : Column} (cs : List Column) {col : Column} :
    ∀ (π : List (Nat × Nat)) (F G : Forest), IsRoutePath F π → F.forestAt π = some G →
      G.cols = cs ++ [col] →
      IsRoutePath (replaceAt 0 0 (Tree.node [c']) π.length F) π ∧
        (replaceAt 0 0 (Tree.node [c']) π.length F).forestAt π = some (Tree.node (cs ++ [c']))
  | [], F, G, hr, hG, hGc => by
    simp only [Tree.forestAt, Option.some.injEq] at hG
    subst hG
    obtain ⟨cols⟩ := F
    simp only [Tree.cols] at hGc
    subst hGc
    simp only [List.length_nil, spx_replaceAt_zero, Tree.cols, Tree.forestAt]
    exact ⟨fun d hd => absurd hd (Nat.not_lt_zero _), trivial⟩
  | s :: π, .node cols, G, hr, hG, hGc => by
    obtain ⟨hl, h, hh, hr'⟩ := Scan.isRoutePath_cons.1 hr
    obtain ⟨colL, q, h₀, hcol, hcl, hs, hh'⟩ := lastStep?_eq_some hl
    rw [hh] at hh'
    cases hh'
    have hG' : h.forestAt π = some G := by
      rw [show s :: π = [s] ++ π from rfl, Tree.forestAt_append, hh] at hG
      exact hG
    simp only [Tree.cols] at hcol hs
    obtain ⟨ys, rfl⟩ := List.getLast?_eq_some_iff.1 hcol
    obtain ⟨zs, rfl⟩ := List.getLast?_eq_some_iff.1 hcl
    subst hs
    simp only [List.length_append, List.length_singleton, Nat.add_sub_cancel]
    rw [List.length_cons, spx_replaceAt_succ]
    obtain ⟨ih1, ih2⟩ := route_replace_E2 cs π h G hr' hG' hGc
    have hstep : (Tree.node (ys ++ [zs ++ [(q, replaceAt 0 0 (Tree.node [c']) π.length h)]])).forestAt
        [(ys.length, zs.length)] = some (replaceAt 0 0 (Tree.node [c']) π.length h) := by
      rw [Tree.forestAt_cons]; simp [Tree.cols, Tree.forestAt]
    refine ⟨Scan.isRoutePath_cons.2 ⟨lastStep_snoc_E2 _ _ _ _, _, hstep, ih1⟩, ?_⟩
    rw [show (ys.length, zs.length) :: π = [(ys.length, zs.length)] ++ π from rfl,
      Tree.forestAt_append, hstep]
    exact ih2

theorem isRoutePath_take_E2 {E : Forest} {π : List (Nat × Nat)} (h : IsRoutePath E π) (k : Nat) :
    IsRoutePath E (π.take k) := by
  intro d hd
  have hd' : d < π.length := by simp at hd; omega
  obtain ⟨F, hF, hl⟩ := h d hd'
  refine ⟨F, ?_, ?_⟩
  · rw [List.take_take, Nat.min_eq_left (by simp at hd; omega)]; exact hF
  · rw [List.getElem?_take, if_pos (by simp at hd; omega)]; exact hl

theorem mem_routeCols_cont_E2 {E : Forest} {π σ : List (Nat × Nat)} {j : Nat}
    (h : IsRoutePath E π) (hc : isCont_E2 π σ j) : (⟨σ, j⟩ : ColAddr) ∈ routeCols E := by
  obtain ⟨d, hd, rfl, e, he⟩ := hc
  rw [mem_routeCols_iff]
  refine ⟨isRoutePath_take_E2 h d, ?_⟩
  obtain ⟨F, hF, hl⟩ := h d hd
  rw [he] at hl
  obtain ⟨col, q, h', hcol, -, hs, -⟩ := lastStep?_eq_some hl
  simp only [Prod.mk.injEq] at hs
  have hne : F.cols ≠ [] := by intro h0; rw [h0] at hcol; simp at hcol
  have : 0 < F.cols.length := List.length_pos_of_ne_nil hne
  refine ⟨F, hF, ?_⟩
  show F.cols.length = j + 1
  omega

theorem mem_routeCols_end_E2 {E : Forest} {π : List (Nat × Nat)} (h : IsRoutePath E π)
    {cs : List Column} {c' : Column} (hG : E.forestAt π = some (Tree.node (cs ++ [c']))) :
    (⟨π, cs.length⟩ : ColAddr) ∈ routeCols E := by
  rw [mem_routeCols_iff]
  exact ⟨h, _, hG, by simp [Tree.cols]⟩

/-- The columns of a special output, read in the input: the owner column, a route container
(the same column but the last height), or the same column. -/
theorem colAt_corr_E2 {P : Column} {p N : Nat} {Fl : Forest} (cs : List Column) :
    ∀ (π : List (Nat × Nat)) (F G : Forest), IsRoutePath F π → F.forestAt π = some G →
      G.cols = cs ++ [P ++ [(p, Fl)]] → ∀ (σ : List (Nat × Nat)) (j : Nat) (col' : Column),
      (replaceAt 0 0 (Tree.node [P ++ List.replicate N (p, Tree.node Fl.cols.dropLast)]) π.length
        F).colAt ⟨σ, j⟩ = some col' →
      ∃ colA, F.colAt ⟨projP_E2 cs.length P.length π σ, j⟩ = some colA ∧
        ((σ = π ∧ j = cs.length ∧ col' = P ++ List.replicate N (p, Tree.node Fl.cols.dropLast) ∧
            colA = P ++ [(p, Fl)]) ∨
          (isCont_E2 π σ j ∧ col'.dropLast = colA.dropLast ∧
            col'.map Prod.fst = colA.map Prod.fst) ∨
          (¬ (σ = π ∧ j = cs.length) ∧ col' = colA))
  | [], F, G, hr, hG, hGc, σ, j, col', hc' => by
    simp only [Tree.forestAt, Option.some.injEq] at hG
    subst hG
    obtain ⟨cols⟩ := F
    simp only [Tree.cols] at hGc
    subst hGc
    rw [List.length_nil, spx_replaceAt_zero] at hc'
    change (Tree.node (cs ++ [P ++ List.replicate N (p, Tree.node Fl.cols.dropLast)])).colAt
      ⟨σ, j⟩ = some col' at hc'
    cases σ with
    | nil =>
      rw [show projP_E2 cs.length P.length [] [] = [] from rfl]
      rw [colAt_nil_E2] at hc' ⊢
      rcases Nat.lt_trichotomy j cs.length with hj | rfl | hj
      · rw [List.getElem?_append_left hj] at hc' ⊢
        exact ⟨col', hc', Or.inr (Or.inr ⟨fun h => by omega, rfl⟩)⟩
      · rw [List.getElem?_append_right (le_refl _), Nat.sub_self, List.getElem?_cons_zero,
          Option.some.injEq] at hc'
        refine ⟨P ++ [(p, Fl)], by simp, Or.inl ⟨rfl, rfl, hc'.symm, rfl⟩⟩
      · rw [List.getElem?_append_right (by omega)] at hc'
        simp [show j - cs.length ≠ 0 by omega] at hc'
    | cons s ρ =>
      obtain ⟨a, b⟩ := s
      rw [colAt_cons_E2, Option.bind_eq_some_iff] at hc'
      obtain ⟨x', hx', hcx⟩ := hc'
      simp only [projP_E2]
      split_ifs with hab
      · obtain ⟨rfl, hb⟩ := hab
        have hx'' : x' = (p, Tree.node Fl.cols.dropLast) := by
          simp only [getEnt_E2, List.getElem?_append_right (le_refl _), Nat.sub_self,
            List.getElem?_cons_zero, Option.bind_some, List.getElem?_append_right hb] at hx'
          exact List.eq_of_mem_replicate (List.mem_of_getElem? hx')
        subst hx''
        refine ⟨col', ?_, Or.inr (Or.inr ⟨fun h => by simp at h, rfl⟩)⟩
        rw [colAt_cons_E2]
        simp only [getEnt_E2, List.getElem?_append_right (le_refl _), Nat.sub_self,
          List.getElem?_cons_zero, Option.bind_some]
        exact colAt_dropLast_E2 hcx
      · have e1 : getEnt_E2 (cs ++ [P ++ List.replicate N (p, Tree.node Fl.cols.dropLast)]) a b =
            getEnt_E2 (cs ++ [P ++ [(p, Fl)]]) a b := by
          unfold getEnt_E2
          rcases Nat.lt_trichotomy a cs.length with ha | rfl | ha
          · simp only [List.getElem?_append_left ha]
          · have hb : b < P.length := by omega
            simp [List.getElem?_append_left hb]
          · simp only [List.getElem?_append_right (show cs.length ≤ a by omega)]
            simp [show a - cs.length ≠ 0 by omega]
        refine ⟨col', ?_, Or.inr (Or.inr ⟨fun h => by simp at h, rfl⟩)⟩
        rw [colAt_cons_E2, ← e1, hx']; exact hcx
  | s :: π, .node cols, G, hr, hG, hGc, σ, j, col', hc' => by
    obtain ⟨hl, h, hh, hr'⟩ := Scan.isRoutePath_cons.1 hr
    obtain ⟨colL, q, h₀, hcol, hcl, hs, hh'⟩ := lastStep?_eq_some hl
    rw [hh] at hh'
    cases hh'
    have hG' : h.forestAt π = some G := by
      rw [show s :: π = [s] ++ π from rfl, Tree.forestAt_append, hh] at hG
      exact hG
    simp only [Tree.cols] at hcol hs
    obtain ⟨ys, rfl⟩ := List.getLast?_eq_some_iff.1 hcol
    obtain ⟨zs, rfl⟩ := List.getLast?_eq_some_iff.1 hcl
    subst hs
    simp only [List.length_append, List.length_singleton, Nat.add_sub_cancel] at hc' ⊢
    rw [List.length_cons, spx_replaceAt_succ] at hc'
    cases σ with
    | nil =>
      simp only [projP_E2]
      rw [colAt_nil_E2] at hc' ⊢
      rcases Nat.lt_trichotomy j ys.length with hj | rfl | hj
      · rw [List.getElem?_append_left hj] at hc' ⊢
        exact ⟨col', hc', Or.inr (Or.inr ⟨fun h => by simp at h, rfl⟩)⟩
      · simp only [List.getElem?_append_right (le_refl _), Nat.sub_self, List.getElem?_cons_zero,
          Option.some.injEq] at hc' ⊢
        subst hc'
        refine ⟨_, rfl, Or.inr (Or.inl ⟨⟨0, by simp, rfl, zs.length, rfl⟩, by simp, by simp⟩)⟩
      · rw [List.getElem?_append_right (by omega)] at hc'
        simp [show j - ys.length ≠ 0 by omega] at hc'
    | cons x ρ =>
      rw [colAt_cons_E2, Option.bind_eq_some_iff] at hc'
      obtain ⟨x', hx', hcx⟩ := hc'
      obtain ⟨a, b⟩ := x
      by_cases hab : (a, b) = (ys.length, zs.length)
      · simp only [Prod.mk.injEq] at hab
        obtain ⟨rfl, rfl⟩ := hab
        rw [getEnt_snoc_self_E2] at hx'
        cases hx'
        obtain ⟨colA, hA, hrel⟩ := colAt_corr_E2 cs π h G hr' hG' hGc ρ j col' hcx
        refine ⟨colA, ?_, ?_⟩
        · simp only [projP_E2, if_true]
          rw [colAt_cons_E2, getEnt_snoc_self_E2]; exact hA
        · rcases hrel with ⟨h1, h2, h3, h4⟩ | ⟨⟨d, hd, h1, e, he⟩, h2, h3⟩ | ⟨h1, h2⟩
          · exact Or.inl ⟨by rw [h1], h2, h3, h4⟩
          · exact Or.inr (Or.inl ⟨⟨d + 1, by simp; omega, by simp [h1], e, by simpa using he⟩,
              h2, h3⟩)
          · exact Or.inr (Or.inr ⟨fun hh => h1 ⟨by simpa using hh.1, hh.2⟩, h2⟩)
      · have hab' : ¬ (a = ys.length ∧ b = zs.length) := fun hh => hab (by rw [hh.1, hh.2])
        have e1 := getEnt_snoc_E2 (replaceAt 0 0 (Tree.node [P ++ List.replicate N (p,
          Tree.node Fl.cols.dropLast)]) π.length h) h hab' (q := q)
        refine ⟨col', ?_, Or.inr (Or.inr ⟨fun hh => hab (List.cons.inj hh.1).1, rfl⟩)⟩
        simp only [projP_E2, hab, if_false]
        rw [colAt_cons_E2, ← e1, hx']; exact hcx


/-! T3.2u helpers (branch E2): cursors of capped columns. -/

theorem cursor_le_top_E2 : ∀ (src W : List (WithTop Key)), (∀ y ∈ W, y ≠ ⊤) →
    ∀ k, src[k]? = some ⊤ → cursor src W ≤ k := by
  intro src W
  induction src, W using cursor.induct with
  | case1 qry => intro _ k _; simp [cursor]
  | case2 x xs => intro _ k _; simp [cursor]
  | case3 x xs y ys h ih =>
    intro hW k hk
    cases k with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.some.injEq] at hk
      subst hk
      exact absurd h (not_lt.2 le_top)
    | succ k =>
      simp only [cursor, if_pos h]
      have := ih hW k (by simpa using hk)
      omega
  | case4 xs y ys _ ih =>
    intro hW k hk
    cases k with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.some.injEq] at hk
      exact absurd hk (hW y (by simp))
    | succ k =>
      simp only [cursor, lt_irrefl, if_false, if_true]
      have := ih (fun z hz => hW z (by simp [hz])) k (by simpa using hk)
      omega
  | case5 x xs y ys h1 h2 ih =>
    intro hW k hk
    simp only [cursor, if_neg h1, if_neg h2]
    exact ih (fun z hz => hW z (by simp [hz])) k hk

theorem capped_cases_E2 {K KA : List (WithTop Key)} {v : Nat} (hv : v < K.length)
    (hag : K.take (v + 1) = KA.take (v + 1) ∨ (v + 1 = K.length ∧ K.take v = KA.take v)) :
    K.dropLast ++ [⊤] = KA.take v ++ [⊤] ∨
      (v < (K.dropLast ++ [⊤]).length ∧ (K.dropLast ++ [⊤]).take (v + 1) = KA.take (v + 1)) := by
  by_cases hv1 : v + 1 = K.length
  · left
    have hKv : K.take v = KA.take v := by
      rcases hag with h | ⟨-, h⟩
      · have := congrArg (List.take v) h
        rwa [List.take_take, List.take_take, Nat.min_eq_left (by omega)] at this
      · exact h
    rw [List.dropLast_eq_take, show K.length - 1 = v by omega, hKv]
  · right
    have h1 : K.take (v + 1) = KA.take (v + 1) := by
      rcases hag with h | ⟨h, -⟩
      · exact h
      · exact absurd h hv1
    refine ⟨by simp; omega, ?_⟩
    rw [List.take_append_of_le_length (by rw [List.length_dropLast]; omega), List.dropLast_eq_take,
      List.take_take, Nat.min_eq_left (by omega), h1]

theorem capKeys_mem_E2 {E : Forest} {sel : List ColAddr} {o : ColAddr} (ho : o ∈ sel)
    (hne : actualKeys E o ≠ []) : capKeys E sel o = (actualKeys E o).dropLast ++ [⊤] := by
  obtain ⟨y, hy⟩ := Option.ne_none_iff_exists'.1 (mt List.getLast?_eq_none_iff.1 hne)
  simp [capKeys, ho, hy]

theorem colAt_isSome_of_resolve_E2 {E : Forest} {c o : ColAddr} {z i : Nat}
    (he : (⟨c, i⟩ : EntryAddr) ∈ E.entryAddrs) (ho : c.resolve 0 z = some o) :
    (E.colAt o).isSome := by
  have := (Tree.stack_mem_prefix he).2.1 o ((ColAddr.resolve_spec 0 c o z).1 ho).1
  exact (Tree.mem_roles_ord o.path _ o.col).1 ((List.takeWhile_sublist _).subset this)


-- T3.2u (txt:410-412): special outputs satisfy A
theorem condA_special {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .special)
    (hB : expand A n = some B) : CondA B := by
  have hVB : CondV B := (condVIH_special hL hk hB).1
  have hSB : CondS B := condS_special hL hk hB
  obtain ⟨π, G, cs, P, p, Fl, N, hrp, hG, hGc, hFl, hN, rfl⟩ := spx_special_shape hL hk hB
  obtain ⟨hV, -, -, hAA, hSA⟩ := hL
  have hcorr := colAt_corr_E2 (N := N) cs π A G hrp hG hGc
  obtain ⟨hrB, hGB⟩ := route_replace_E2
    (c' := P ++ List.replicate N (p, Tree.node Fl.cols.dropLast)) cs π A G hrp hG hGc
  set C : Forest := Tree.node Fl.cols.dropLast with hCdef
  set B := replaceAt 0 0 (Tree.node [P ++ List.replicate N (p, C)]) π.length A with hBdef
  have hmo : (⟨π, cs.length⟩ : ColAddr) ∈ routeCols B := mem_routeCols_end_E2 hrB hGB
  have hmc : ∀ σ j, isCont_E2 π σ j → (⟨σ, j⟩ : ColAddr) ∈ routeCols B :=
    fun σ j h => mem_routeCols_cont_E2 hrB h
  have hcolo : B.colAt ⟨π, cs.length⟩ = some (P ++ List.replicate N (p, C)) := by
    simp [Tree.colAt, hGB, Tree.cols]
  -- one edge of an old path is an edge of the new capped system
  have hresp : ∀ (c : ColAddr) (i : Nat), (⟨c, i⟩ : EntryAddr) ∈ B.entryAddrs →
      c ∈ B.colAddrs → projC_E2 π cs.length P.length c ∈ A.colAddrs →
      i ≤ (parents A (projC_E2 π cs.length P.length c)).length → ∀ (z y : Nat),
      Path A (actualKeys A) (projC_E2 π cs.length P.length c)
        (cutQuery (actualKeys A (projC_E2 π cs.length P.length c)) i)
        (cutStart A (projC_E2 π cs.length P.length c) i) z →
      Edge A (actualKeys A) (projC_E2 π cs.length P.length c)
        (cutQuery (actualKeys A (projC_E2 π cs.length P.length c)) i) z y →
      Edge B (capKeys B (routeCols B)) c
        (cutQuery (actualKeys A (projC_E2 π cs.length P.length c)) i) z y := by
    intro c i hent hc hcA hiA z y hpath hedge
    obtain ⟨oA, hoA, hrA⟩ := hedge
    set W := cutQuery (actualKeys A (projC_E2 π cs.length P.length c)) i with hWdef
    have hWn : W.Pairwise fun x y => y ≤ x := cutQuery_noninc _ _
    have hWT : ∀ y ∈ W, y ≠ ⊤ := by
      intro y hy
      have hy' := ((Scan.nu_sublist _).trans (List.take_sublist _ _)).subset hy
      simp only [actualKeys, List.mem_map] at hy'
      obtain ⟨_, -, rfl⟩ := hy'
      exact WithTop.coe_ne_top
    have hz : z < c.num 0 := by
      have := ColAddr.resolve_lt hoA; rwa [projC_num_E2] at this
    obtain ⟨oB, hoB⟩ := Option.isSome_iff_exists.1
      ((ColAddr.resolve_isSome_iff 0 c z).2 ⟨Nat.zero_le _, hz⟩)
    have hpo : projC_E2 π cs.length P.length oB = oA := by
      have := projC_resolve_E2 π cs.length P.length hoB
      rw [hoA] at this; exact (Option.some.inj this).symm
    subst hpo
    refine ⟨oB, hoB, ?_⟩
    obtain ⟨colB, hcolB⟩ := Option.isSome_iff_exists.1 (colAt_isSome_of_resolve_E2 hent hoB)
    obtain ⟨colA, hcolA, hrel⟩ := hcorr oB.path oB.col colB hcolB
    have hcolA' : A.colAt (projC_E2 π cs.length P.length oB) = some colA := hcolA
    have hnum : (projC_E2 π cs.length P.length oB).num 0 = oB.num 0 := projC_num_E2 _ _ _ 0 oB
    have hzo : oB.num 0 = z := ColAddr.resolve_num hoB
    have hkB : actualKeys B oB = colB.map fun x => ((relKey (oB.num 0) x.2 : Key) : WithTop Key) := by
      simp [actualKeys, hcolB]
    have hkA : actualKeys A (projC_E2 π cs.length P.length oB) =
        colA.map fun x => ((relKey (oB.num 0) x.2 : Key) : WithTop Key) := by
      simp [actualKeys, hcolA', hnum]
    unfold resp at hrA ⊢
    rw [hcolB, Option.getD_some]
    rw [hcolA', Option.getD_some] at hrA
    by_cases hor : oB ∈ routeCols B
    · obtain ⟨v, hvB, hvc⟩ := routeCols_visible hc hor hoB
      have hvL : v < colB.length := by
        have := (Tree.mem_entryAddrs_iff _ _).1 hvB
        rw [Tree.entryAt, hcolB, Option.bind_some] at this
        obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 this
        exact (List.getElem?_eq_some_iff.1 hx).1
      have hvcA := projE_contains_E2 π cs.length P.length hvc
      have hcne : actualKeys B oB ≠ [] := by
        rw [hkB]; intro h0; rw [List.map_eq_nil_iff] at h0; rw [h0] at hvL; simp at hvL
      have hcap := capKeys_mem_E2 (E := B) hor hcne
      -- the barrier at the containing entry, read in the input
      have hbarG : ∀ (w : Nat), projI_E2 π cs.length P.length ⟨oB, v⟩ = w → w < colA.length →
          W < cutQuery (actualKeys A (projC_E2 π cs.length P.length oB)) (w + 1) := by
        intro w hw hwl
        have hvA : projE_E2 π cs.length P.length ⟨oB, v⟩ ∈ A.entryAddrs := by
          rw [Tree.mem_entryAddrs_iff, Tree.entryAt]
          simp only [projE_E2, hw]
          rw [hcolA', Option.bind_some, List.getElem?_eq_getElem hwl]; rfl
        have hbar := cut_barrier hV hAA hSA hvA hcA hvcA hiA
          (by simp only [projE_E2]; rw [hnum, hzo]; exact hpath)
        rw [boundary_eq_cutQuery] at hbar
        simpa only [projE_E2, hw] using hbar
      rcases hrel with ⟨hσ, hj, hcB, hcAe⟩ | ⟨hcont, hdl, hfst⟩ | ⟨hno, heq⟩
      · -- the owner column
        have hoBe : oB = ⟨π, cs.length⟩ := by
          obtain ⟨σ, j⟩ := oB; simp only at hσ hj; rw [hσ, hj]
        subst hcB hcAe
        have hKA : actualKeys A (projC_E2 π cs.length P.length oB) =
            P.map (fun x => ((relKey (oB.num 0) x.2 : Key) : WithTop Key)) ++
              [((relKey (oB.num 0) Fl : Key) : WithTop Key)] := by
          rw [hkA]; simp
        have hKB : actualKeys B oB =
            P.map (fun x => ((relKey (oB.num 0) x.2 : Key) : WithTop Key)) ++
              List.replicate N ((relKey (oB.num 0) C : Key) : WithTop Key) := by
          rw [hkB]; simp
        by_cases hvP : v < P.length
        · have hw : projI_E2 π cs.length P.length ⟨oB, v⟩ = v := by
            unfold projI_E2; rw [if_neg (fun h => absurd h.2.2 (by show ¬ P.length ≤ v; omega))]
          have hbar := hbarG v hw (by simp; omega)
          have hag : (actualKeys B oB).take (v + 1) =
              (actualKeys A (projC_E2 π cs.length P.length oB)).take (v + 1) := by
            rw [hKA, hKB, List.take_append_of_le_length (by simp; omega),
              List.take_append_of_le_length (by simp; omega)]
          have hcur : cursor (capKeys B (routeCols B) oB) W =
              cursor (actualKeys A (projC_E2 π cs.length P.length oB)) W := by
            refine spx_cursor_capped (by rw [hKA]; simp; omega) hWn hWT hbar ?_
            rw [hcap]
            exact capped_cases_E2 (by rw [hKB]; simp; omega) (Or.inl hag)
          have hle := cursor_le_of_lt_cutQuery hWn (by rw [hKA]; simp; omega) hbar
          rw [hcur]
          rw [List.getElem?_append_left (by omega)] at hrA ⊢
          exact hrA
        · have hNpos : N ≠ 0 := by
            rintro rfl; simp at hvL; omega
          have hw : projI_E2 π cs.length P.length ⟨oB, v⟩ = P.length := by
            unfold projI_E2
            rw [if_pos ⟨by rw [hoBe], by rw [hoBe], by show P.length ≤ v; omega⟩]
          have hbar := hbarG P.length hw (by simp)
          have hleA := cursor_le_of_lt_cutQuery hWn (by rw [hKA]; simp) hbar
          have htk : (capKeys B (routeCols B) oB).take P.length =
              (actualKeys A (projC_E2 π cs.length P.length oB)).take P.length := by
            rw [hcap, List.take_append_of_le_length (by rw [List.length_dropLast, hKB]; simp; omega),
              List.dropLast_eq_take, List.take_take, Nat.min_eq_left (by rw [hKB]; simp; omega),
              hKA, hKB, List.take_append_of_le_length (by simp),
              List.take_append_of_le_length (by simp)]
          have e1 := cursor_take (capKeys B (routeCols B) oB) W P.length
          have e2 := cursor_take (actualKeys A (projC_E2 π cs.length P.length oB)) W P.length
          rw [htk, e2] at e1
          by_cases hlt : cursor (actualKeys A (projC_E2 π cs.length P.length oB)) W < P.length
          · have hcur : cursor (capKeys B (routeCols B) oB) W =
                cursor (actualKeys A (projC_E2 π cs.length P.length oB)) W := by omega
            rw [hcur]
            rw [List.getElem?_append_left hlt] at hrA ⊢
            exact hrA
          · have hcA0 : cursor (actualKeys A (projC_E2 π cs.length P.length oB)) W = P.length := by
              omega
            rw [hcA0] at hrA
            simp only [List.getElem?_append_right (le_refl _), Nat.sub_self,
              List.getElem?_cons_zero, Option.map_some, Option.some.injEq] at hrA
            subst hrA
            have hge : P.length ≤ cursor (capKeys B (routeCols B) oB) W := by omega
            have hle : cursor (capKeys B (routeCols B) oB) W ≤ P.length + N - 1 := by
              have := cursor_le_top_E2 (capKeys B (routeCols B) oB) W hWT
                (actualKeys B oB).dropLast.length (by
                  rw [hcap, List.getElem?_append_right (le_refl _), Nat.sub_self]; rfl)
              rw [List.length_dropLast, hKB] at this
              simpa using this
            rw [List.getElem?_append_right hge]
            have hlt2 : cursor (capKeys B (routeCols B) oB) W - P.length < N := by omega
            rw [List.getElem?_replicate, if_pos hlt2]
            rfl
      · -- a route container: the same column but its last height
        have hlen : colB.length = colA.length := by
          have := congrArg List.length hfst; simpa using this
        have hw : projI_E2 π cs.length P.length ⟨oB, v⟩ = v := by
          unfold projI_E2
          rw [if_neg]
          rintro ⟨h1, -, -⟩
          obtain ⟨d, hd, h2, -⟩ := hcont
          have := congrArg List.length (h1.symm.trans h2)
          simp at this; omega
        have hbar := hbarG v hw (by omega)
        have hag : (actualKeys B oB).take (v + 1) =
              (actualKeys A (projC_E2 π cs.length P.length oB)).take (v + 1) ∨
            (v + 1 = (actualKeys B oB).length ∧ (actualKeys B oB).take v =
              (actualKeys A (projC_E2 π cs.length P.length oB)).take v) := by
          rw [hkA, hkB]
          by_cases hv1 : v + 1 = colB.length
          · right
            refine ⟨by simp; omega, ?_⟩
            rw [← List.map_take, ← List.map_take]
            congr 1
            rw [show v = colB.length - 1 by omega, ← List.dropLast_eq_take, hdl, hlen,
              List.dropLast_eq_take]
          · left
            rw [← List.map_take, ← List.map_take]
            congr 1
            have h1 : colB.take (v + 1) = colB.dropLast.take (v + 1) := by
              rw [List.dropLast_eq_take, List.take_take, Nat.min_eq_left (by omega)]
            have h2 : colA.take (v + 1) = colA.dropLast.take (v + 1) := by
              rw [List.dropLast_eq_take, List.take_take, Nat.min_eq_left (by omega)]
            rw [h1, h2, hdl]
        have hcur : cursor (capKeys B (routeCols B) oB) W =
            cursor (actualKeys A (projC_E2 π cs.length P.length oB)) W := by
          refine spx_cursor_capped (by rw [hkA]; simp; omega) hWn hWT hbar ?_
          rw [hcap]
          exact capped_cases_E2 (by rw [hkB]; simp; omega) hag
        rw [hcur, ← List.getElem?_map, hfst, List.getElem?_map]
        exact hrA
      · -- the same column
        subst heq
        have hw : projI_E2 π cs.length P.length ⟨oB, v⟩ = v := by
          unfold projI_E2
          rw [if_neg]
          rintro ⟨h1, h2, -⟩
          exact hno ⟨h1, h2⟩
        have hbar := hbarG v hw hvL
        have hKe : actualKeys B oB = actualKeys A (projC_E2 π cs.length P.length oB) := by
          rw [hkA, hkB]
        have hcur : cursor (capKeys B (routeCols B) oB) W =
            cursor (actualKeys A (projC_E2 π cs.length P.length oB)) W := by
          refine spx_cursor_capped (by rw [hkA]; simp; omega) hWn hWT hbar ?_
          rw [hcap]
          exact capped_cases_E2 (by rw [hkB]; simp; omega) (Or.inl (by rw [hKe]))
        rw [hcur]
        exact hrA
    · -- a column off the route is unchanged
      rw [capKeys_of_not_mem hor]
      have heq : colB = colA := by
        rcases hrel with ⟨hσ, hj, -, -⟩ | ⟨hcont, -, -⟩ | ⟨-, h⟩
        · exfalso; apply hor
          obtain ⟨σ, j⟩ := oB; simp only at hσ hj; rw [hσ, hj]; exact hmo
        · exact absurd (hmc _ _ hcont) hor
        · exact h
      subst heq
      have hKe : actualKeys B oB = actualKeys A (projC_E2 π cs.length P.length oB) := by
        rw [hkA, hkB]
      rw [hKe]
      exact hrA
  refine capping_reverse hVB hSB (sel := routeCols B) (fun a ha => ha) ?_
  rw [condAK_iff]
  intro c hc i q hq
  obtain ⟨col', hcol'⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff _ c).1 hc)
  have hiL : i < col'.length := by
    have := (List.getElem?_eq_some_iff.1 hq).1
    simpa [parents, hcol'] using this
  have hent : (⟨c, i⟩ : EntryAddr) ∈ B.entryAddrs := by
    rw [Tree.mem_entryAddrs_iff, Tree.entryAt, hcol', Option.bind_some,
      List.getElem?_eq_getElem hiL]; rfl
  rw [cutQuery_capKeys B _ c (by rw [hcol']; simpa using hiL)]
  obtain ⟨colA, hcolA, hrel⟩ := hcorr c.path c.col col' hcol'
  have hcolA' : A.colAt (projC_E2 π cs.length P.length c) = some colA := hcolA
  have hnum : (projC_E2 π cs.length P.length c).num 0 = c.num 0 := projC_num_E2 _ _ _ 0 c
  have hqB : (col'.map Prod.fst)[i]? = some q := by simpa [parents, hcol'] using hq
  by_cases hlate : c = ⟨π, cs.length⟩ ∧ P.length < i
  · -- later copies: the reflexive test from the repeated parent
    obtain ⟨hc0, hi⟩ := hlate
    rw [hc0] at hcol'
    rw [hcolo, Option.some.injEq] at hcol'
    subst hcol'
    have hq' : q = p := by
      rw [List.getElem?_map, List.getElem?_append_right (by omega), List.getElem?_replicate,
        if_pos (by simp at hiL; omega)] at hqB
      simpa using hqB.symm
    have hs : cutStart B c i = p := by
      unfold cutStart
      rw [if_neg (by omega), parents, hc0, hcolo, Option.getD_some, List.getElem?_map,
        List.getElem?_append_right (by omega), List.getElem?_replicate, if_pos (by simp at hiL; omega)]
      rfl
    rw [hs, hq']
    exact Relation.ReflTransGen.refl
  · -- the old test at the corresponding entry
    have hagree : col'.take i = colA.take i ∧ (col'.map Prod.fst).take (i + 1) =
        (colA.map Prod.fst).take (i + 1) ∧ i < colA.length := by
      rcases hrel with ⟨hσ, hj, hcB, hcAe⟩ | ⟨hcont, hdl, hfst⟩ | ⟨-, heq⟩
      · have hc0 : c = ⟨π, cs.length⟩ := by
          obtain ⟨σ, j⟩ := c; simp only at hσ hj; rw [hσ, hj]
        have hiP : i ≤ P.length := by
          by_contra h; exact hlate ⟨hc0, by omega⟩
        subst hcB hcAe
        refine ⟨?_, ?_, by simp; omega⟩
        · rw [List.take_append_of_le_length hiP, List.take_append_of_le_length hiP]
        · rcases Nat.lt_or_eq_of_le hiP with hiP | hiP
          · rw [List.map_append, List.map_append, List.take_append_of_le_length (by simp; omega),
              List.take_append_of_le_length (by simp; omega)]
          · have hN1 : N ≠ 0 := by rintro rfl; simp at hiL; omega
            obtain ⟨N', rfl⟩ : ∃ N', N = N' + 1 := ⟨N - 1, by omega⟩
            subst hiP
            simp only [List.replicate_succ, List.map_append, List.map_cons, List.map_replicate,
              List.map_nil]
            rw [List.take_append, List.take_append]
            simp
      · have hlen : col'.length = colA.length := by
          have := congrArg List.length hfst; simpa using this
        refine ⟨?_, ?_, by omega⟩
        · have h1 : col'.take i = col'.dropLast.take i := by
            rw [List.dropLast_eq_take, List.take_take, Nat.min_eq_left (by omega)]
          have h2 : colA.take i = colA.dropLast.take i := by
            rw [List.dropLast_eq_take, List.take_take, Nat.min_eq_left (by omega)]
          rw [h1, h2, hdl]
        · rw [hfst]
      · subst heq; exact ⟨rfl, rfl, hiL⟩
    obtain ⟨htk, hfk, hiA⟩ := hagree
    have hW : cutQuery (actualKeys B c) i = cutQuery (actualKeys A (projC_E2 π cs.length P.length c)) i := by
      unfold cutQuery
      congr 1
      simp only [actualKeys, hcol', hcolA', Option.getD_some, ← List.map_take, htk, hnum]
    have hpar : ∀ k ≤ i, (parents B c)[k]? = (parents A (projC_E2 π cs.length P.length c))[k]? := by
      intro k hk
      simp only [parents, hcol', hcolA', Option.getD_some]
      have := congrArg (fun l => l[k]?) hfk
      simp only [List.getElem?_take, if_pos (show k < i + 1 by omega)] at this
      exact this
    have hstart : cutStart B c i = cutStart A (projC_E2 π cs.length P.length c) i := by
      unfold cutStart
      rw [hnum]
      split_ifs with h0
      · rfl
      · rw [hpar (i - 1) (by omega)]
    have hqA : (parents A (projC_E2 π cs.length P.length c))[i]? = some q := by
      rw [← hpar i (le_refl _)]; exact hq
    have hcA : projC_E2 π cs.length P.length c ∈ A.colAddrs := by
      rw [Tree.mem_colAddrs_iff, hcolA']; rfl
    have hiA' : i ≤ (parents A (projC_E2 π cs.length P.length c)).length := by
      simp [parents, hcolA']; omega
    have hAt := (condAK_iff _ _).1 hAA _ hcA i q hqA
    rw [hW, hstart]
    have key : ∀ y, Path A (actualKeys A) (projC_E2 π cs.length P.length c)
        (cutQuery (actualKeys A (projC_E2 π cs.length P.length c)) i)
        (cutStart A (projC_E2 π cs.length P.length c) i) y →
        Path B (capKeys B (routeCols B)) c
          (cutQuery (actualKeys A (projC_E2 π cs.length P.length c)) i)
          (cutStart A (projC_E2 π cs.length P.length c) i) y := by
      intro y h
      induction h with
      | refl => exact Relation.ReflTransGen.refl
      | @tail z y' hxz hzy ih => exact ih.tail (hresp c i hent hc hcA hiA' z y' hxz hzy)
    exact key q hAt

/-! T3.2v helpers: the columns of a seed. -/

/-- The height below the branch entry with parent `l` of `L_{m+1}`. -/
def spxSeedH (l s : Nat) : Forest := if s = 0 then Tree.empty else .node [branch (l + 1) (s - 1)]

theorem spx_branch (l s : Nat) : branch l s = [(l, spxSeedH l s)] := by
  cases s <;> rfl

/-- Columns of a branch forest. -/
theorem spx_branch_colAt : ∀ (k i : Nat) (P : List (Nat × Nat)) (j : Nat) (col : Column),
    (Tree.node [branch i k]).colAt ⟨P, j⟩ = some col →
      ∃ l ≤ k, P = List.replicate l (0, 0) ∧ j = 0 ∧ col = branch (i + l) (k - l)
  | k, i, [], j, col, h => by
    simp only [Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols] at h
    cases j with
    | zero => simp only [List.getElem?_cons_zero, Option.some.injEq] at h; exact ⟨0, by omega, rfl, rfl, by simp [h]⟩
    | succ j => simp at h
  | k, i, (a, b) :: P, j, col, h => by
    rw [Tree.colAt_cons] at h
    simp only [Tree.cols] at h
    cases a with
    | succ a => simp at h
    | zero =>
      cases k with
      | zero => cases b <;> simp [branch, spx_colAt_empty] at h
      | succ k =>
        cases b with
        | succ b => simp [branch] at h
        | zero =>
          simp only [branch, List.getElem?_cons_zero, Option.bind_some] at h
          obtain ⟨l, hl, rfl, rfl, rfl⟩ := spx_branch_colAt k (i + 1) P j col h
          exact ⟨l + 1, by omega, by simp [List.replicate_succ], rfl, by
            rw [show i + 1 + l = i + (l + 1) by omega, show k - l = k + 1 - (l + 1) by omega]⟩

/-- Columns of `L_{m+1}`: the empty outer column, and one singleton column per level. -/
theorem spx_seed_colAt (m : Nat) (c : ColAddr) (col : Column)
    (h : (seed (m + 1)).colAt c = some col) :
    (c = ⟨[], 0⟩ ∧ col = []) ∨ ∃ l ≤ m, c.num 0 = l + 1 ∧ col = branch l (m - l) := by
  obtain ⟨P, j⟩ := c
  cases P with
  | nil =>
    simp only [seed, Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols] at h
    match j, h with
    | 0, h => left; simp at h; exact ⟨rfl, h⟩
    | 1, h => right; simp at h; exact ⟨0, by omega, by simp [ColAddr.num], by simp [h]⟩
    | j + 2, h => simp at h
  | cons x P =>
    obtain ⟨a, b⟩ := x
    rw [seed, Tree.colAt_cons] at h
    simp only [Tree.cols] at h
    match a, b, h with
    | 0, b, h => simp at h
    | a + 2, b, h => simp at h
    | 1, b + 1, h => simp [spx_branch] at h
    | 1, 0, h =>
      cases m with
      | zero => simp [branch, spx_colAt_empty] at h
      | succ k =>
        simp only [branch, List.getElem?_cons_succ, List.getElem?_cons_zero, Option.bind_some] at h
        obtain ⟨l, hl, rfl, rfl, rfl⟩ := spx_branch_colAt k 1 P j col h
        right
        refine ⟨l + 1, by omega, ?_, by rw [show 1 + l = l + 1 by omega,
          show k - l = k + 1 - (l + 1) by omega]⟩
        simp [ColAddr.num, List.map_replicate, List.sum_replicate]; omega

/-- Entries of `L_{m+1}`: the entry at level `l` has parent `l`, column number `l + 1`. -/
theorem spx_seed_entryAt (m : Nat) (e : EntryAddr) (q : Nat) (h : Forest)
    (he : (seed (m + 1)).entryAt e = some (q, h)) :
    ∃ l ≤ m, e.idx = 0 ∧ e.col.num 0 = l + 1 ∧ q = l ∧ h = spxSeedH l (m - l) := by
  obtain ⟨col, hcol, hi⟩ := Tree.colAt_of_entryAt he
  rcases spx_seed_colAt m e.col col hcol with ⟨-, rfl⟩ | ⟨l, hl, hn, rfl⟩
  · simp at hi
  · rw [spx_branch] at hi
    cases hidx : e.idx with
    | zero =>
      rw [hidx] at hi
      simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hi
      exact ⟨l, hl, rfl, hn, hi.1.symm, hi.2.symm⟩
    | succ i => rw [hidx] at hi; simp at hi

theorem spx_profile_branch : ∀ (s i : Nat),
    profile (Tree.node [branch i s]) = ((toLex (s, 1) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat))
  | 0, i => by simp [branch, profile, profileBody, profileAux, Tree.empty]
  | s + 1, i => by
    rw [spx_profile_node (by simp), branch, spx_profileAux_cons 0 i (by simp [Tree.cols]),
      spx_profileAux_one]
    have := spx_profile_branch s (i + 1)
    rw [spx_profile_node (by simp), WithBot.coe_inj] at this
    rw [this]; rfl

theorem spx_seed_zero_entryAt (e : EntryAddr) : (seed 0).entryAt e = none := by
  obtain ⟨⟨P, j⟩, i⟩ := e
  cases P with
  | nil =>
    simp only [seed, Tree.entryAt, Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols]
    cases j <;> simp
  | cons x P =>
    obtain ⟨a, b⟩ := x
    rw [seed, Tree.entryAt, Tree.colAt_cons]
    cases a <;> simp [Tree.cols]

theorem spx_empty_entryAddrs : (Tree.empty : Forest).entryAddrs = [] := rfl
theorem spx_empty_colAddrs : (Tree.empty : Forest).colAddrs = [] := rfl

-- T3.2v (txt:412-413): seeds lie in L and satisfy P (`seed_condP` is stated first: the proof
-- of `seed_inL` gets S from P by L3.1a)
theorem seed_condP (m : Nat) : CondP (seed m) := by
  intro e0 he0 e he hret
  obtain ⟨-, q, J, hJ, hres⟩ := hret
  cases m with
  | zero => exact absurd hJ (by rw [spx_seed_zero_entryAt]; simp)
  | succ m =>
    obtain ⟨x0, hx0⟩ := Option.isSome_iff_exists.1 ((Tree.mem_entryAddrs_iff _ e0).1 he0)
    obtain ⟨q0, H0⟩ := x0
    obtain ⟨l0, hl0, -, hn0, -, rfl⟩ := spx_seed_entryAt m e0 q0 H0 hx0
    obtain ⟨l1, hl1, -, -, hq1, hJ1⟩ := spx_seed_entryAt m e q J hJ
    have hq : e0.col.num 0 = l1 := hq1 ▸ ColAddr.resolve_num hres
    rw [Tree.heightAt, Tree.heightAt, hJ, hx0, hJ1]
    simp only [Option.map_some, Option.getD_some]
    have hm : m - l0 = m - l1 + 1 := by omega
    rw [hm]
    simp only [spxSeedH, Nat.add_one_ne_zero, if_false, Nat.add_sub_cancel]
    rw [show l0 + 1 = l1 by omega, spx_profile_branch]
    by_cases hs : m - l1 = 0
    · simp only [hs, if_true]; exact WithBot.bot_lt_coe _
    · rw [if_neg hs, spx_profile_branch]
      exact WithBot.coe_lt_coe.2 (Prod.Lex.toLex_lt_toLex.2 (Or.inl (by simp; omega)))

theorem seed_inL (m : Nat) : InL (seed m) := by
  have hV : CondV (seed m) := by
    rw [condV_iff_lt]
    intro e _ q h he
    cases m with
    | zero => rw [spx_seed_zero_entryAt] at he; cases he
    | succ m =>
      obtain ⟨l, -, -, hn, rfl, -⟩ := spx_seed_entryAt m e q h he
      omega
  have hI : CondI (seed m) := by
    intro e _ q h he hne col hcol
    cases m with
    | zero => rw [spx_seed_zero_entryAt] at he; cases he
    | succ m =>
      obtain ⟨l, -, -, hn, -, rfl⟩ := spx_seed_entryAt m e q _ he
      unfold spxSeedH at hne hcol
      split_ifs at hne hcol with hs
      · exact absurd rfl hne
      · simp only [Tree.cols, List.mem_singleton] at hcol
        subst hcol
        rw [spx_branch]
        exact ⟨l + 1, _, [], rfl, by omega⟩
  have hH : CondH (seed m) := by
    intro c hc i x y hx hy
    obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff _ c).1 hc)
    rw [hcol, Option.getD_some] at hx hy
    cases m with
    | zero =>
      have he : (seed 0).entryAt ⟨c, i⟩ = some x := by rw [Tree.entryAt, hcol]; exact hx
      rw [spx_seed_zero_entryAt] at he; cases he
    | succ m =>
      rcases spx_seed_colAt m c col hcol with ⟨-, rfl⟩ | ⟨l, -, -, rfl⟩
      · simp at hx
      · rw [spx_branch] at hy; simp at hy
  have hA : CondA (seed m) := by
    intro c _ i p hp
    rw [parents_getElem?] at hp
    obtain ⟨⟨q, h⟩, he, rfl⟩ := Option.map_eq_some_iff.1 hp
    cases m with
    | zero => rw [spx_seed_zero_entryAt] at he; cases he
    | succ m =>
      obtain ⟨l, -, hi, hn, rfl, -⟩ := spx_seed_entryAt m ⟨c, i⟩ q h he
      simp only at hi hn
      subst hi
      simp only [if_true, hn, Nat.add_sub_cancel]
      exact Relation.ReflTransGen.refl
  exact ⟨hV, hI, hH, hA, condS_of_condP hV hI hH (seed_condP m)⟩

-- T3.2w: the empty forest lies in L and satisfies P
theorem inL_empty : InL Tree.empty := by
  refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;> intro c hc <;> simp [spx_empty_entryAddrs, spx_empty_colAddrs] at hc

theorem condP_empty : CondP Tree.empty := by
  intro e0 he0; simp [spx_empty_entryAddrs] at he0


/-! ### T3.2 — the closure theorem

The six spine contracts of T3.2 below were moved here from `Plan/Spine.lean` (brief rule 5,
branch D3): their proofs use the T3.2 sub-lemmas of this section; nothing in between used them. -/

/-- The output of a loop step lies below the previous phase's stopping column (only the parents
of `U` are used). -/
theorem ordStep_lt_D3 {sd : StopData} {rd : RootData} {F : Forest} {U : Column} {k : Nat}
    {Z : Forest} (hUr : ∀ x ∈ U, x.1 < sd.r) :
    ordStep sd rd F U k Z <
      .node [Tree.mapCol (shiftVal sd.r ((k - 1) * (sd.t - sd.r))) (sd.Q ++ [(sd.r, Tree.empty)])] := by
  have hmapQ : Tree.mapCol (shiftVal sd.r ((k - 1) * (sd.t - sd.r))) (sd.Q ++ [(sd.r, Tree.empty)]) =
      Tree.mapCol (shiftVal sd.r ((k - 1) * (sd.t - sd.r))) sd.Q ++
        [(shiftVal sd.r ((k - 1) * (sd.t - sd.r)) sd.r, Tree.empty)] := by
    simp [treeMapCol_eq_map, Tree.map, Tree.mapCols, Tree.empty]
  have hρ : sd.r ≤ shiftVal sd.r ((k - 1) * (sd.t - sd.r)) sd.r := le_shiftVal_D3 _ _ _
  unfold ordStep
  simp only
  rw [hmapQ]
  split
  · rw [List.append_assoc]
    refine head_lt_D3 (rest := []) (fun v hv => lt_of_lt_of_le ?_ hρ)
    have e := mapLast_eq (fun x : Nat × Forest => (x.1, shift sd.r (k * (sd.t - sd.r)) x.2))
      (fun x : Nat × Forest => (x.1, Hole.fill ⟨x.2, sd.depth - rd.layer - 1⟩ sd.r
        (k * (sd.t - sd.r)) Z)) U
    rw [← e] at hv
    cases hU0 : U.head? with
    | none =>
      cases U with
      | nil => simp [mapLast] at hv
      | cons _ _ => simp at hU0
    | some u0 =>
      obtain ⟨y, hy, hyu⟩ := head_mapLast_fst_D3
        (fun x : Nat × Forest => (x.1, shift sd.r (k * (sd.t - sd.r)) x.2))
        (fun x : Nat × Forest => (x.1, Hole.fill ⟨x.2, sd.depth - rd.layer - 1⟩ sd.r
          (k * (sd.t - sd.r)) Z)) (fun _ => rfl) (fun _ => rfl) u0 hU0
      rw [hy] at hv; cases hv
      rw [hyu]; exact hUr u0 (List.mem_of_head? hU0)
  · refine head_lt_D3 (fun v hv => lt_of_lt_of_le ?_ hρ)
    cases U with
    | nil => simp at hv
    | cons u us => simp at hv; subst hv; exact hUr u (by simp)

theorem ordZ_lt_D3 {A : Forest} {sd : StopData} {rd : RootData} (hV : CondV A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) (n : Nat) :
    ordZ A sd rd n < .node [sd.Q ++ [(sd.r, Tree.empty)]] := by
  obtain ⟨-, -, hU, -, -⟩ := ord_vdata_D3 hV hsd hrd
  have := ordLoop_induct_D3 (step := ordStep sd rd ((A.forestAt rd.col.path).getD Tree.empty)
      (((A.colAt rd.col).getD []).drop rd.cursor))
    (P := fun k Z => Z <
      .node [Tree.mapCol (shiftVal sd.r (k * (sd.t - sd.r))) (sd.Q ++ [(sd.r, Tree.empty)])]) ?_ n
    Tree.empty (Forest.empty_lt (by simp [Tree.empty]))
  · simpa [ordZ, shiftVal_zero_fun, treeMapCol_id_fun] using this
  · intro k Z _ _
    exact ordStep_lt_D3 (fun x hx => (hU x hx).1)

/-- The special output is below the input: the owner column `P ⌢ [(p, C ⌢ [[(a,∅)]])]` becomes
`P ⌢ [(p, C)]^m`. -/
theorem special_col_lt_D3 (P : Column) (p : Nat) (Fl : Forest) (hFl : Fl.cols ≠ []) (m : Nat) :
    (Tree.node [P ++ List.replicate m (p, Tree.node Fl.cols.dropLast)] : Forest) <
      .node [P ++ [(p, Fl)]] := by
  show Tree.cmp compare _ _ = .lt
  simp only [Tree.cmp, Tree.cmpCols, cmpCol_append_left_D3]
  cases m with
  | zero => rfl
  | succ m =>
    rw [List.replicate_succ]
    simp only [Tree.cmpCol]
    rw [show compare p p = Ordering.eq from compare_eq_iff_eq.2 rfl]
    obtain ⟨fc⟩ := Fl
    have hc : Tree.cmp compare (Tree.node fc.dropLast : Forest) (Tree.node fc) = .lt := by
      simp only [Tree.cmp, Tree.cols] at hFl ⊢
      conv => rhs; skip
      have := cmpCols_append_left_D3 fc.dropLast [] [fc.getLast hFl]
      rw [List.append_nil, List.dropLast_append_getLast hFl] at this
      rw [this]; rfl
    have e : (Tree.node fc).cols = fc := rfl
    rw [e, hc]; rfl

-- provides: U2, T3.2
theorem inL_safePrefix {E : Forest} (hE : Scan.InL E) (k : Nat) :
    Scan.InL (Scan.safePrefix E k) :=
  ⟨safePrefix_condV hE.1 k, safePrefix_condI hE.2.1 k, safePrefix_condH hE.2.2.1 k,
    safePrefix_condA hE k, safePrefix_condS hE.1 hE.2.2.2.2 k⟩

-- provides: U2, T3.2
theorem inL_expand {E E' : Forest} {n : Nat} (hE : Scan.InL E) (h : expand E n = some E') :
    Scan.InL E' := by
  by_cases hE0 : E = Tree.empty
  · subst hE0; rw [expand_empty] at h; cases h; exact inL_empty
  obtain ⟨k, hk⟩ := Option.isSome_iff_exists.1 (stepKind_isSome hE0 hE.1 hE.2.1)
  cases k with
  | deletion =>
    obtain ⟨j, -, rfl⟩ := expand_safePrefix hE0 hE.1 hE.2.1 (Or.inl hk) h
    exact inL_safePrefix hE j
  | special =>
    obtain ⟨hV, hI, hH⟩ := condVIH_special hE hk h
    exact ⟨hV, hI, hH, condA_special hE hk h, condS_special hE hk h⟩
  | ordinary =>
    exact ⟨condV_ord hE hk h, condI_ord hE hk h, condH_ord hE hk h, condA_ord hE hk h,
      condS_ord hE hk h⟩

-- provides: U2, T3.2 (P is preserved when present, S-6)
theorem condP_expand {E E' : Forest} {n : Nat} (hE : Scan.InL E) (hP : CondP E)
    (h : expand E n = some E') : CondP E' := by
  by_cases hE0 : E = Tree.empty
  · subst hE0; rw [expand_empty] at h; cases h; exact condP_empty
  obtain ⟨k, hk⟩ := Option.isSome_iff_exists.1 (stepKind_isSome hE0 hE.1 hE.2.1)
  cases k with
  | deletion =>
    obtain ⟨j, -, rfl⟩ := expand_safePrefix hE0 hE.1 hE.2.1 (Or.inl hk) h
    exact safePrefix_condP hE hP j
  | special => exact condP_special hE hP hk h
  | ordinary => exact condP_ord hE hP hk h

-- provides: U2, T3.2
theorem std_inL {E : Forest} (h : IsStd E) : Scan.InL E := by
  induction h with
  | seed m => exact seed_inL m
  | expand n _ hexp ih => exact inL_expand ih hexp

-- provides: U2, T3.2
theorem std_condP {E : Forest} (h : IsStd E) : CondP E := by
  induction h with
  | seed m => exact seed_condP m
  | expand n hstd hexp ih => exact condP_expand (std_inL hstd) ih hexp

-- provides: U2, T3.2a (Lean `IsStd` equals the paper's Std, generated by `paperOp`)
-- Moved here from `Plan/Spine.lean` (brief rule 5): its proof needs `std_inL` (T3.2) and U1's
-- `expand_eq_paperOp`; nothing in between uses it.
theorem isStd_iff_paper (E : Forest) :
    IsStd E ↔ (∃ (m : Nat) (ns : List Nat), ns.foldlM (fun F n => Scan.paperOp F n) (seed m) = some E) := by
  -- the paper's operation is undefined on `∅` and agrees with `expand` on nonempty standard
  -- inputs (D1.6a, with V and I from T3.2)
  have hpe : ∀ n, Scan.paperOp Tree.empty n = none := fun _ => rfl
  have hagree : ∀ {F : Forest} (n : Nat), IsStd F → F ≠ Tree.empty →
      expand F n = Scan.paperOp F n := fun n hF hne =>
    Scan.expand_eq_paperOp hne (std_inL hF).1 (std_inL hF).2.1 n
  constructor
  · intro h
    induction h with
    | seed m => exact ⟨m, [], rfl⟩
    | @expand e e' n hs he ih =>
      obtain ⟨m, ns, hns⟩ := ih
      by_cases h0 : e = Tree.empty
      · subst h0
        rw [Scan.expand_empty] at he
        cases he
        exact ⟨m, ns, hns⟩
      · refine ⟨m, ns ++ [n], ?_⟩
        rw [List.foldlM_append, hns]
        simp [← hagree n hs h0, he]
  · rintro ⟨m, ns, h⟩
    suffices H : ∀ (ns : List Nat) (F : Forest), IsStd F →
        ns.foldlM (fun F n => Scan.paperOp F n) F = some E → IsStd E from
      H ns _ (IsStd.seed m) h
    intro ns
    induction ns with
    | nil =>
      intro F hF h
      cases h
      exact hF
    | cons n ns ih =>
      intro F hF h
      rw [List.foldlM_cons] at h
      cases hp : Scan.paperOp F n with
      | none => rw [hp] at h; cases h
      | some F' =>
        rw [hp] at h
        have hne : F ≠ Tree.empty := by rintro rfl; rw [hpe] at hp; cases hp
        exact ih F' (IsStd.expand n hF (by rw [hagree n hF hne, hp])) h

-- provides: U2, T3.2 (strict decrease; the paper's statement asks only V, I)
theorem expand_lt {E E' : Forest} {n : Nat} (hE : E ≠ Tree.empty) (hV : Scan.CondV E)
    (hI : Scan.CondI E) (h : expand E n = some E') : E' < E := by
  obtain ⟨k, hk⟩ := Option.isSome_iff_exists.1 (stepKind_isSome hE hV hI)
  cases k with
  | deletion =>
    rw [expand_deletion hk] at h
    cases h
    obtain ⟨cs, hcs⟩ := List.getLast?_eq_some_iff.1 ((stepKind_deletion_iff E).1 hk)
    obtain ⟨cols⟩ := E
    simp only [Tree.cols] at hcs ⊢
    subst hcs
    show Tree.cmp compare _ _ = .lt
    simp only [Tree.cmp, List.dropLast_concat]
    have := cmpCols_append_left_D3 cs [] [[]]
    rw [List.append_nil] at this
    rw [this]; rfl
  | special =>
    obtain ⟨sd, hsd⟩ := Option.isSome_iff_exists.mp (stopData_of_stepKind hk (by decide))
    obtain ⟨sd', hsd', hs⟩ := (stepKind_special_iff E).mp hk
    rw [hsd] at hsd'; cases hsd'
    have hpos : 0 < sd.depth := by
      simp only [specialStop, Bool.and_eq_true, decide_eq_true_eq] at hs; exact hs.1.1
    obtain ⟨oe, col, p0, hoe, -, hcol, hlastc, -⟩ := ownerEntry_data hsd hpos
    obtain ⟨-, -, -, col', p, Fl, hcol', hlast, -, hFl⟩ := ownerEntry_spec hk hsd hoe
    rw [hcol] at hcol'; cases hcol'
    rw [expand_eq_paperOp hE hV hI, paperOp_special hk hsd hoe hcol hlast] at h
    cases h
    obtain ⟨hR, -⟩ := stop_route_top_D3 hsd
    have hR' : RouteOK_D3 (sd.depth - 1) E := routeOK_le_D3 _ _ _ hR (by omega)
    have hrc : routeCol_D3 (sd.depth - 1) E = col := by simp [routeCol_D3, hlastc]
    rw [Hole.fill_eq_put, shift_zero]
    refine put_lt_D3 hR' ?_
    rw [hrc]
    obtain ⟨P, rfl⟩ := List.getLast?_eq_some_iff.1 hlast
    rw [List.dropLast_concat]
    exact special_col_lt_D3 P p Fl (by intro he; rw [he] at hFl; simp at hFl) _
  | ordinary =>
    obtain ⟨sd, hsd⟩ := Option.isSome_iff_exists.mp (stopData_of_stepKind hk (by decide))
    obtain ⟨rd, hrd⟩ := Option.isSome_iff_exists.mp (rootData_of_ordinary hk)
    rw [expand_eq_paperOp hE hV hI, paperOp_ordinary hk hsd hrd] at h
    split at h
    · cases h
    · cases h
      obtain ⟨hR, -⟩ := stop_route_top_D3 hsd
      obtain ⟨-, -, -, h4, -⟩ := stopData_core hsd
      have hrc : routeCol_D3 sd.depth E = sd.Q ++ [(sd.r, Tree.empty)] := by
        simp [routeCol_D3, h4]
      show replaceAt 0 0 _ sd.depth E < E
      refine put_lt_D3 hR ?_
      rw [hrc]; exact ordZ_lt_D3 hV hsd hrd n

/-! ## §T3.8 — cofinality -/

/-- T3.8n: cofinality with target `B` (the statement of T3.8 for one fixed target). -/
def Cof (B : Forest) : Prop :=
  ∀ E, InL E → B < E → ∃ n E', expand E n = some E' ∧ B ≤ E' ∧ E' < E

/-- T3.8n: kernel success for every upward literal `L` cap of `B`, in the covering form. -/
def KS (B : Forest) : Prop :=
  ∀ c k p, IsUpward B c k p → InL (litCap B c k p) → Covers (litCap B c k p) B

/-- L3.6: the conclusion of cap completion for target `B` (caps with V, I, decorated A). -/
def CC (B : Forest) : Prop :=
  ∀ c k p, IsUpward B c k p → CondV (litCap B c k p) → CondI (litCap B c k p) →
    CondAK (litCap B c k p) (capKeys (litCap B c k p) (routeCols (litCap B c k p))) →
    Success (litCap B c k p) (localSuffix B c)

-- T3.8a (txt:493): an empty last column is the least column
/-- T3.8a helper: the empty-column atom `(0, 0, 0)` is the least atom. -/
theorem ker_not_lt_bot (y : WordAtom) : ¬ y < toLex (0, toLex (0, 0)) := by
  intro h
  rw [Prod.Lex.lt_iff] at h
  simp only [ofLex_toLex] at h
  rcases h with h | ⟨_, h⟩
  · exact Nat.not_lt_zero _ h
  · rw [Prod.Lex.lt_iff] at h
    simp only [ofLex_toLex] at h
    rcases h with h | ⟨_, h⟩ <;> exact Nat.not_lt_zero _ h

/-- T3.8a helper: nothing lies strictly between `u` and `u ⌢ [(0,0,0)]` above `u`. -/
theorem ker_not_lt_append_bot :
    ∀ (u w : List WordAtom), u < w → ¬ w < u ++ [toLex (0, toLex (0, 0))]
  | [], [], h => absurd h (List.not_lt_nil _)
  | [], y :: w, _ => by
    intro h
    rw [List.nil_append, List.cons_lt_cons_iff] at h
    rcases h with h | ⟨_, h⟩
    · exact ker_not_lt_bot y h
    · exact List.not_lt_nil _ h
  | x :: u, [], h => absurd h (List.not_lt_nil _)
  | x :: u, y :: w, h => by
    intro h'
    rw [List.cons_lt_cons_iff] at h
    rw [List.cons_append, List.cons_lt_cons_iff] at h'
    rcases h with h | ⟨rfl, h⟩
    · rcases h' with h' | ⟨rfl, _⟩
      · exact lt_asymm h h'
      · exact lt_irrefl _ h
    · rcases h' with h' | ⟨_, h'⟩
      · exact lt_irrefl _ h'
      · exact ker_not_lt_append_bot u w h h'

theorem le_of_lt_append_empty {B F : Forest} (h : B < Tree.node (F.cols ++ [[]])) : B ≤ F := by
  rcases le_or_gt B F with h' | h'
  · exact h'
  · exfalso
    rw [← word_lt_iff] at h h'
    have hw : word (Tree.node (F.cols ++ [[]])) = word F ++ [toLex (0, toLex (0, 0))] := by
      unfold word
      rw [← ker_wordCols_cols 0 F]
      simp only [wordAt]
      rw [wordCols_append]
      rfl
    rw [hw] at h
    exact ker_not_lt_append_bot _ _ h' h

/-- T3.8b helper: words of kernel iterates are the word iterates. -/
theorem ker_word_iterate {E : Forest} {sd : StopData} {rd : RootData} (hV : CondV E)
    (hsd : stopData E = some sd) (hrd : rootData E = some rd) (hkd : KernelDefined E rd) :
    ∀ n, word ((kernel E sd rd)^[n] Tree.empty) = kerIter (kerPrefix E sd rd) (kerSigma sd rd) n
  | 0 => rfl
  | n + 1 => by
    rw [Function.iterate_succ_apply', word_kernel hV hsd hrd hkd, ker_word_iterate hV hsd hrd hkd n]
    rfl

/-- helper: KerRoute is downward closed. -/
theorem ker_route_pred : ∀ (k : Nat) (F : Forest), KerRoute (k + 1) F → KerRoute k F
  | 0, F, ⟨col, p, H, h1, _, _⟩ => by
    show F.cols ≠ []
    intro h; rw [h] at h1; cases h1
  | k + 1, F, ⟨col, p, H, h1, h2, h3⟩ => ⟨col, p, H, h1, h2, ker_route_pred k H h3⟩

/-- helper: the word of a column splits after a nonempty head. -/
theorem ker_wordCol_append (e : Nat) {l₁ : Column} (h : l₁ ≠ []) (l₂ : Column) :
    wordCol e (l₁ ++ l₂) = wordCol e l₁ ++ wordLater e l₂ := by
  obtain ⟨x, xs, rfl⟩ := List.exists_cons_of_ne_nil h
  obtain ⟨p, H⟩ := x
  simp only [List.cons_append, wordCol, ker_wordLater_append, List.append_assoc]

-- T3.8b: approximants strictly increase
theorem expand_strictMono {E X Y : Forest} {n n' : Nat} (hL : InL E)
    (hlast : E.cols.getLast? ≠ some []) (hE : E ≠ Tree.empty) (hnn : n < n')
    (hX : expand E n = some X) (hY : expand E n' = some Y) : X < Y := by
  obtain ⟨hV, hI, -⟩ := hL
  obtain ⟨knd, hknd⟩ := Option.isSome_iff_exists.1 (stepKind_isSome hE hV hI)
  cases knd with
  | deletion => exact absurd ((stepKind_deletion_iff E).1 hknd) hlast
  | ordinary =>
    obtain ⟨sd, hsd⟩ := Option.isSome_iff_exists.1 (stopData_of_stepKind hknd (by decide))
    obtain ⟨rd, hrd⟩ := Option.isSome_iff_exists.1 (rootData_of_ordinary hknd)
    obtain ⟨hX', -⟩ := ker_expand_out hV hI hknd hsd hrd hX
    obtain ⟨hY', hkd⟩ := ker_expand_out hV hI hknd hsd hrd hY
    have hkd := hkd (by omega)
    subst hX' hY'
    rw [← word_lt_iff, word_context hsd ((kernel E sd rd)^[n] Tree.empty),
      word_context hsd ((kernel E sd rd)^[n'] Tree.empty), ker_append_lt_append_iff,
      ker_word_iterate hV hsd hrd hkd, ker_word_iterate hV hsd hrd hkd]
    apply List.map_lt (fun x y h => depthShift_strictMono _ h)
    obtain ⟨t, ht⟩ := ker_kerIter_prefix_le (kerPrefix E sd rd) (kerSigma sd rd) (le_of_lt hnn)
    rw [← ht]
    apply ker_lt_append
    rintro rfl
    have := congrArg List.length ht
    rw [List.append_nil, kerIter_length, kerIter_length] at this
    have hP := List.length_pos_of_ne_nil (kerPrefix_ne_nil E sd rd)
    have := Nat.eq_of_mul_eq_mul_right hP this
    omega
  | special =>
    obtain ⟨sd, hsd, hspec⟩ := (stepKind_special_iff E).1 hknd
    obtain ⟨oe, hoe⟩ := Option.isSome_iff_exists.1 (ownerEntry_of_special hknd hsd)
    obtain ⟨-, -, -, col, p, Fl, hcol, hlastc, -, -⟩ := ownerEntry_spec hknd hsd hoe
    rw [expand_eq_paperOp hE hV hI, paperOp_special hknd hsd hoe hcol hlastc] at hX hY
    cases hX; cases hY
    have hdpos : 0 < sd.depth := by
      unfold specialStop at hspec
      simp only [Bool.and_eq_true, decide_eq_true_eq] at hspec
      exact hspec.1.1
    obtain ⟨G, hG, hR⟩ := ker_route_of_stop hsd 0 (Nat.zero_le _)
    simp only [List.take_zero, Tree.forestAt, Option.some.injEq] at hG
    subst hG
    have hR' : KerRoute (sd.depth - 1) E :=
      ker_route_pred _ _ (by rw [show sd.depth - 1 + 1 = sd.depth - 0 by omega]; exact hR)
    rw [← word_lt_iff]
    show wordAt 0 (replaceAt 0 0 _ (sd.depth - 1) E) < wordAt 0 (replaceAt 0 0 _ (sd.depth - 1) E)
    conv_lhs => rw [ker_wordAt_replaceAt _ _ _ 0 hR']
    conv_rhs => rw [ker_wordAt_replaceAt _ _ _ 0 hR']
    rw [ker_append_lt_append_iff, Nat.zero_add, show sd.depth - 1 = 0 + (sd.depth - 1) by omega,
      wordAt_add, wordAt_add]
    apply List.map_lt (fun x y h => depthShift_strictMono _ h)
    have hne : col.dropLast ++ List.replicate (n + if col.dropLast.isEmpty then 1 else 0)
        (p, Tree.node Fl.cols.dropLast) ≠ [] := by
      by_cases hA : col.dropLast = []
      · rw [hA]; simp
      · intro h; exact hA (List.append_eq_nil_iff.1 h).1
    have hsplit : col.dropLast ++ List.replicate (n' + if col.dropLast.isEmpty then 1 else 0)
        (p, Tree.node Fl.cols.dropLast) =
        (col.dropLast ++ List.replicate (n + if col.dropLast.isEmpty then 1 else 0)
          (p, Tree.node Fl.cols.dropLast)) ++
          List.replicate (n' - n) (p, Tree.node Fl.cols.dropLast) := by
      rw [List.append_assoc, ← List.replicate_add]
      congr 2
      omega
    simp only [wordAt, wordCols, List.append_nil]
    rw [hsplit, ker_wordCol_append 0 hne]
    apply ker_lt_append
    obtain ⟨m, hm⟩ : ∃ m, n' - n = m + 1 := ⟨n' - n - 1, by omega⟩
    rw [hm, List.replicate_succ]
    simp [wordLater]

-- T3.8c: stop data of a literal cap
/-! ### T3.8c helpers: the route of a literal cap -/

theorem ker_stopCols_snoc (π : List (Nat × Nat)) (X : Column) :
    ∀ (A : List Column) (ci : Nat), stopCols π ci (A ++ [X]) = stopCol π (ci + A.length) 0 [] X
  | [], ci => by simp [stopCols]
  | a :: A, ci => by
    obtain ⟨y, ys, h⟩ := List.exists_cons_of_ne_nil (by simp : A ++ [X] ≠ [])
    rw [List.cons_append, h]
    simp only [stopCols]
    rw [← h, ker_stopCols_snoc π X A (ci + 1)]
    congr 1
    simp; omega

theorem ker_stopCol_snoc_stop (π : List (Nat × Nat)) (ci p : Nat) :
    ∀ (T : Column) (ei : Nat) (Q0 : Column),
      stopCol π ci ei Q0 (T ++ [(p, Tree.node [])]) =
        some ⟨π.length, ⟨π, ci⟩, ColAddr.num 0 ⟨π, ci⟩, p, Q0 ++ T⟩
  | [], ei, Q0 => by simp [stopCol]
  | t :: T, ei, Q0 => by
    obtain ⟨y, ys, h⟩ := List.exists_cons_of_ne_nil (by simp : T ++ [(p, Tree.node [])] ≠ [])
    rw [List.cons_append, h]
    simp only [stopCol]
    rw [← h, ker_stopCol_snoc_stop π ci p T (ei + 1) (Q0 ++ [t])]
    simp

theorem ker_stopCol_snoc_descend (π : List (Nat × Nat)) (ci q : Nat) (g : Column)
    (gs : List Column) :
    ∀ (T : Column) (ei : Nat) (Q0 : Column),
      stopCol π ci ei Q0 (T ++ [(q, Tree.node (g :: gs))]) =
        stopCols (π ++ [(ci, ei + T.length)]) 0 (g :: gs)
  | [], ei, Q0 => by simp [stopCol]
  | t :: T, ei, Q0 => by
    obtain ⟨y, ys, h⟩ := List.exists_cons_of_ne_nil
      (by simp : T ++ [(q, Tree.node (g :: gs))] ≠ [])
    rw [List.cons_append, h]
    simp only [stopCol]
    rw [← h, ker_stopCol_snoc_descend π ci q g gs T (ei + 1) (Q0 ++ [t])]
    congr 3
    simp; omega

/-- helper: unfolding one level of `litCapAux` at an existing entry. -/
theorem ker_litCapAux_cons (k p ci ei j : Nat) (rest : List (Nat × Nat)) (cols : List Column)
    {col : Column} {q : Nat} {h : Forest} (hc : cols[ci]? = some col) (he : col[ei]? = some (q, h)) :
    litCapAux k p ((ci, ei) :: rest) j (Tree.node cols) =
      Tree.node (cols.take ci ++ [col.take ei ++ [(q, litCapAux k p rest j h)]]) := by
  have hg : cols.getD ci [] = col := by rw [List.getD_eq_getElem?_getD, hc]; rfl
  simp only [litCapAux, hg, he]

/-- helper: the lookup of a column address one level down. -/
theorem ker_colAt_cons {α : Type} (cols : List (List (α × Tree α))) (ci ei j : Nat)
    (rest : List (Nat × Nat)) :
    (Tree.node cols).colAt ⟨(ci, ei) :: rest, j⟩ =
      ((cols[ci]?).bind (·[ei]?)).bind fun x => x.2.colAt ⟨rest, j⟩ := by
  unfold Tree.colAt
  simp only [ker_forestAt_cons, Tree.cols]
  cases (cols[ci]?).bind (·[ei]?) with
  | none => rfl
  | some x => rfl

/-- helper: a literal cap at an existing column is a nonempty forest. -/
theorem ker_litCapAux_ne (k p : Nat) :
    ∀ (σ : List (Nat × Nat)) (j : Nat) (F : Forest), (F.colAt ⟨σ, j⟩).isSome →
      ∃ g gs, litCapAux k p σ j F = Tree.node (g :: gs) ∧
        ∃ x xs, (g :: gs).getLast? = some (x :: xs)
  | [], j, .node cols, _ => by
    obtain ⟨g, gs, h⟩ := List.exists_cons_of_ne_nil
      (by simp : cols.take j ++ [(cols.getD j []).take k ++ [(p, Tree.empty)]] ≠ [])
    refine ⟨g, gs, by simp only [litCapAux]; rw [h], ?_⟩
    rw [← h, List.getLast?_append, List.getLast?_singleton]
    obtain ⟨x, xs, hx⟩ := List.exists_cons_of_ne_nil
      (by simp : (cols.getD j []).take k ++ [(p, Tree.empty)] ≠ [])
    exact ⟨x, xs, by rw [hx]; rfl⟩
  | (ci, ei) :: rest, j, .node cols, hc => by
    rw [ker_colAt_cons] at hc
    cases hcol : cols[ci]? with
    | none => rw [hcol] at hc; cases hc
    | some col =>
      rw [hcol, Option.bind_some] at hc
      cases hent : col[ei]? with
      | none => rw [hent] at hc; cases hc
      | some x =>
        obtain ⟨q, h⟩ := x
        rw [ker_litCapAux_cons k p ci ei j rest cols hcol hent]
        obtain ⟨g, gs, hg⟩ := List.exists_cons_of_ne_nil
          (by simp : cols.take ci ++ [col.take ei ++ [(q, litCapAux k p rest j h)]] ≠ [])
        refine ⟨g, gs, by rw [hg], ?_⟩
        rw [← hg, List.getLast?_append, List.getLast?_singleton]
        obtain ⟨y, ys, hy⟩ := List.exists_cons_of_ne_nil
          (by simp : col.take ei ++ [(q, litCapAux k p rest j h)] ≠ [])
        exact ⟨y, ys, by rw [hy]; rfl⟩

/-- helper: the route of a literal cap stops at its cap column. -/
theorem ker_stopF_litCapAux (k p : Nat) :
    ∀ (σ : List (Nat × Nat)) (j : Nat) (F : Forest) (π : List (Nat × Nat)),
      (F.colAt ⟨σ, j⟩).isSome →
      stopF π (litCapAux k p σ j F) =
        some ⟨(π ++ σ).length, ⟨π ++ σ, j⟩, ColAddr.num 0 ⟨π ++ σ, j⟩, p,
          ((F.colAt ⟨σ, j⟩).getD []).take k⟩
  | [], j, .node cols, π, hc => by
    have hj : j < cols.length := by
      unfold Tree.colAt at hc
      simp only [Tree.forestAt, Option.bind_some, Tree.cols] at hc
      by_contra h; rw [List.getElem?_eq_none (by omega)] at hc; cases hc
    simp only [litCapAux, stopF]
    rw [ker_stopCols_snoc, List.length_take, Nat.min_eq_left (by omega), Nat.zero_add]
    rw [show (p, Tree.empty) = (p, (Tree.node [] : Forest)) from rfl, ker_stopCol_snoc_stop]
    simp only [List.append_nil, List.nil_append]
    congr 3
  | (ci, ei) :: rest, j, .node cols, π, hc => by
    have hc' := hc
    rw [ker_colAt_cons] at hc'
    cases hcol : cols[ci]? with
    | none => rw [hcol] at hc'; cases hc'
    | some col =>
      rw [hcol, Option.bind_some] at hc'
      cases hent : col[ei]? with
      | none => rw [hent] at hc'; cases hc'
      | some x =>
        obtain ⟨q, h⟩ := x
        rw [hent, Option.bind_some] at hc'
        have hci : ci < cols.length := by
          by_contra hh; rw [List.getElem?_eq_none (by omega)] at hcol; cases hcol
        have hei : ei < col.length := by
          by_contra hh; rw [List.getElem?_eq_none (by omega)] at hent; cases hent
        rw [ker_litCapAux_cons k p ci ei j rest cols hcol hent]
        obtain ⟨g, gs, hg, -⟩ := ker_litCapAux_ne k p rest j h hc'
        simp only [stopF]
        rw [ker_stopCols_snoc, List.length_take, Nat.min_eq_left (by omega), Nat.zero_add, hg,
          ker_stopCol_snoc_descend, List.length_take, Nat.min_eq_left (by omega), Nat.zero_add]
        have ih := ker_stopF_litCapAux k p rest j h (π ++ [(ci, ei)]) hc'
        rw [hg] at ih
        simp only [stopF] at ih
        rw [ih, ker_colAt_cons, hcol, Option.bind_some, hent, Option.bind_some]
        simp only [List.append_assoc, List.singleton_append]

/-- helper: replacing the cap column by `∅` gives a forest below the original. -/
theorem ker_cmpCols_append_left (A B C : List Column) :
    Tree.cmpCols compare (A ++ B) (A ++ C) = Tree.cmpCols compare B C := by
  induction A with
  | nil => rfl
  | cons a A ih =>
    simp only [List.cons_append, Tree.cmpCols]
    rw [Tree.cmpCol_self compare a, ih]
    rfl

theorem ker_cmp_snoc_lt (A R : List Column) (T R2 : Column) (q : Nat) {X' H : Forest}
    (hX : X' < H) :
    Tree.cmp compare (Tree.node (A ++ [T ++ [(q, X')]])) (Tree.node (A ++ (T ++ (q, H) :: R2) :: R))
      = .lt := by
  simp only [Tree.cmp]
  rw [ker_cmpCols_append_left]
  simp only [Tree.cmpCols]
  rw [ker_cmpCol_append_left]
  simp only [Tree.cmpCol]
  have hX' : Tree.cmp compare X' H = .lt := hX
  rw [hX', Nat.compare_eq_eq.2 rfl]
  rfl

theorem ker_context_litCapAux_lt (k p : Nat) :
    ∀ (σ : List (Nat × Nat)) (j : Nat) (F : Forest), (F.colAt ⟨σ, j⟩).isSome →
      replaceAt 0 0 Tree.empty σ.length (litCapAux k p σ j F) < F
  | [], j, .node cols, hc => by
    have hj : j < cols.length := by
      unfold Tree.colAt at hc
      simp only [Tree.forestAt, Option.bind_some, Tree.cols] at hc
      by_contra h; rw [List.getElem?_eq_none (by omega)] at hc; cases hc
    simp only [litCapAux, List.length_nil]
    rw [ker_replaceAt_zero_zero _ _ (by simp)]
    simp only [Tree.empty, Tree.cols, List.append_nil]
    rw [List.dropLast_concat]
    show Tree.cmp compare _ _ = .lt
    obtain ⟨y, ys, hy⟩ := List.exists_cons_of_ne_nil
      (by intro h; have := congrArg List.length h; simp at this; omega : cols.drop j ≠ [])
    have hsplit : cols = cols.take j ++ y :: ys := by rw [← hy, List.take_append_drop]
    have key : Tree.cmp compare (Tree.node (cols.take j ++ [])) (Tree.node (cols.take j ++ y :: ys))
        = .lt := by
      simp only [Tree.cmp]; rw [ker_cmpCols_append_left]; rfl
    rw [← hsplit, List.append_nil] at key
    exact key
  | (ci, ei) :: rest, j, .node cols, hc => by
    have hc' := hc
    rw [ker_colAt_cons] at hc'
    cases hcol : cols[ci]? with
    | none => rw [hcol] at hc'; cases hc'
    | some col =>
      rw [hcol, Option.bind_some] at hc'
      cases hent : col[ei]? with
      | none => rw [hent] at hc'; cases hc'
      | some x =>
        obtain ⟨q, h⟩ := x
        rw [hent, Option.bind_some] at hc'
        have hci : ci < cols.length := by
          by_contra hh; rw [List.getElem?_eq_none (by omega)] at hcol; cases hcol
        have hei : ei < col.length := by
          by_contra hh; rw [List.getElem?_eq_none (by omega)] at hent; cases hent
        have ih := ker_context_litCapAux_lt k p rest j h hc'
        rw [ker_litCapAux_cons k p ci ei j rest cols hcol hent, List.length_cons,
          ker_replaceAt_zero_succ, ker_mapLast_append _ _ _ _ (by simp), List.map_id]
        simp only [mapLast]
        rw [ker_mapLast_append _ _ _ _ (by simp), List.map_id]
        simp only [mapLast]
        obtain ⟨_, hcolE⟩ := List.getElem?_eq_some_iff.1 hcol
        obtain ⟨_, hentE⟩ := List.getElem?_eq_some_iff.1 hent
        have hcols : cols = cols.take ci ++ col :: cols.drop (ci + 1) := by
          conv_lhs => rw [← List.take_append_drop ci cols]
          rw [List.drop_eq_getElem_cons hci, hcolE]
        have hcol2 : col = col.take ei ++ (q, h) :: col.drop (ei + 1) := by
          conv_lhs => rw [← List.take_append_drop ei col]
          rw [List.drop_eq_getElem_cons hei, hentE]
        have key := ker_cmp_snoc_lt (cols.take ci) (cols.drop (ci + 1)) (col.take ei)
          (col.drop (ei + 1)) q ih
        rw [← hcol2, ← hcols] at key
        exact key

theorem stopData_litCap {B : Forest} {c : ColAddr} {k p : Nat} (hup : IsUpward B c k p) :
    stopData (litCap B c k p) =
      some ⟨colDepth c, c, c.num 0, p, ((B.colAt c).getD []).take k⟩ := by
  have hc : (B.colAt c).isSome := by
    unfold IsUpward at hup
    split at hup
    · rename_i col hcol; rw [hcol]; rfl
    · exact hup.elim
  unfold stopData stopDataBody litCap litCapBody
  rw [if_pos hc, ker_stopF_litCapAux k p c.path c.col B [] hc]
  rfl

-- T3.8c (txt:539-540): an upward cap of an I-expression that satisfies V and I is ordinary
theorem litCap_ordinary {B : Forest} (hI : CondI B) {c : ColAddr} {k p : Nat}
    (hup : IsUpward B c k p) (hKV : CondV (litCap B c k p)) (hKI : CondI (litCap B c k p)) :
    stepKind (litCap B c k p) = some .ordinary := by
  have hsd := stopData_litCap hup
  obtain ⟨col, hcol⟩ : ∃ col, B.colAt c = some col := by
    unfold IsUpward at hup
    split at hup
    · rename_i col hcol; exact ⟨col, hcol⟩
    · exact hup.elim
  have hc : (B.colAt c).isSome := by rw [hcol]; rfl
  rw [hcol, Option.getD_some] at hsd
  obtain ⟨g, gs, hg, x, xs, hlast⟩ := ker_litCapAux_ne k p c.path c.col B hc
  have hK : litCap B c k p = Tree.node (g :: gs) := by
    unfold litCap litCapBody; rw [if_pos hc]; exact hg
  have hspec : specialStop ⟨colDepth c, c, c.num 0, p, col.take k⟩ = false := by
    unfold specialStop
    by_contra hcon
    simp only [Bool.not_eq_false, Bool.and_eq_true, decide_eq_true_eq, List.isEmpty_iff,
      beq_iff_eq] at hcon
    obtain ⟨⟨hd, hQ⟩, hnum⟩ := hcon
    unfold colDepth at hd
    have hpne : c.path ≠ [] := by intro h; rw [h] at hd; simp at hd
    obtain ⟨pre, last, hpath⟩ : ∃ pre last, c.path = pre ++ [last] :=
      ⟨c.path.dropLast, c.path.getLast hpne, (List.dropLast_append_getLast hpne).symm⟩
    obtain ⟨ci, ei⟩ := last
    have hfa : B.forestAt c.path = B.heightAt ⟨⟨pre, ci⟩, ei⟩ := by
      rw [← Tree.forestAt_heightPath]
      simp [EntryAddr.heightPath, hpath]
    have hcol' := hcol
    unfold Tree.colAt at hcol'
    cases hF : B.forestAt c.path with
    | none => rw [hF] at hcol'; cases hcol'
    | some h =>
      rw [hF, Option.bind_some] at hcol'
      have hh : B.heightAt ⟨⟨pre, ci⟩, ei⟩ = some h := by rw [← hfa, hF]
      obtain ⟨y, hy⟩ : ∃ y, B.entryAt ⟨⟨pre, ci⟩, ei⟩ = some (y, h) := by
        unfold Tree.heightAt at hh
        cases hE : B.entryAt ⟨⟨pre, ci⟩, ei⟩ with
        | none => rw [hE] at hh; cases hh
        | some z =>
          rw [hE] at hh
          simp only [Option.map_some, Option.some.injEq] at hh
          exact ⟨z.1, by rw [← hh]⟩
      have hmem : (⟨⟨pre, ci⟩, ei⟩ : EntryAddr) ∈ B.entryAddrs :=
        (Tree.mem_entryAddrs_iff _ _).2 (by rw [hy]; rfl)
      have hne : h ≠ Tree.empty := by
        intro h0; subst h0; simp [Tree.empty, Tree.cols] at hcol'
      have hcolmem : col ∈ h.cols := List.mem_of_getElem? hcol'
      obtain ⟨q, H, rest, hcq, hq⟩ := hI _ hmem y h hy hne col hcolmem
      have hk0 : k = 0 := by
        rw [hcq] at hQ
        rcases List.take_eq_nil_iff.1 hQ with h0 | h0
        · exact h0
        · cases h0
      subst hk0
      unfold IsUpward at hup
      rw [hcol, hcq] at hup
      simp only [List.getElem?_cons_zero] at hup
      have hpn : p = ColAddr.num 0 ⟨pre, ci⟩ := by
        unfold ColAddr.num at hnum ⊢
        simp only [hpath, List.map_append, List.sum_append, List.map_cons,
          List.map_nil, List.sum_cons, List.sum_nil] at hnum ⊢
        omega
      have hq' : ColAddr.num 0 ⟨pre, ci⟩ ≤ q := hq
      omega
  have hres : (c.resolve 0 p).isSome := by
    obtain ⟨hcolK, -⟩ := stopData_spec hsd
    have hent : (litCap B c k p).entryAt ⟨c, (col.take k).length⟩ = some (p, Tree.empty) := by
      unfold Tree.entryAt; rw [hcolK]; simp
    have hmemK := (Tree.mem_entryAddrs_iff _ _).2 (by rw [hent]; rfl)
    exact hKV _ hmemK p Tree.empty hent
  unfold stepKind stepKindBody
  have hl' : (litCap B c k p).cols.getLast? = some (x :: xs) := by rw [hK]; exact hlast
  rw [hl']
  simp only []
  rw [show stopDataBody (litCap B c k p) = _ from hsd]
  simp only [hspec, hres, Bool.false_eq_true, if_false, if_true]

-- T3.8c: the approximant at `0` of a cap lies strictly below its target
-- VERIFY-U2 (F6): `hI` added (the doc's proof uses part 2, which needs I of `B`)
theorem expand_zero_litCap_lt {B : Forest} (hI : CondI B) {c : ColAddr} {k p : Nat}
    (hup : IsUpward B c k p)
    (hKV : CondV (litCap B c k p)) (hKI : CondI (litCap B c k p)) {K0 : Forest}
    (h0 : expand (litCap B c k p) 0 = some K0) : K0 < B := by
  have hsd := stopData_litCap hup
  have hord := litCap_ordinary hI hup hKV hKI
  have hKne : litCap B c k p ≠ Tree.empty := by
    intro h; rw [h] at hsd; simp [stopData, stopDataBody, stopF, stopCols, Tree.empty] at hsd
  rw [expand_zero_eq_context hKne hKV hKI hord hsd] at h0
  cases h0
  have hc : (B.colAt c).isSome := by
    unfold IsUpward at hup
    split at hup
    · rename_i col hcol; rw [hcol]; rfl
    · exact hup.elim
  unfold context litCap litCapBody
  rw [if_pos hc]
  exact ker_context_litCapAux_lt k p c.path c.col B hc

/-- N2.2 helper: the word of a column split at an entry `(q, h)`: the part through that entry's
atom, the height, and the later entries. -/
theorem wordCol_split_E5 (e : Nat) (T : Column) (q : Nat) (h : Forest) (R : Column) :
    wordCol e (T ++ (q, h) :: R) =
      wordCol e (T ++ [(q, Tree.empty)]) ++ wordAt (e + 1) h ++ wordLater e R := by
  cases T with
  | nil => simp [wordCol, wordLater, Tree.empty, wordAt, wordCols]
  | cons t T =>
    obtain ⟨p, H⟩ := t
    simp only [List.cons_append, wordCol, ker_wordLater_append, wordLater, List.append_assoc]
    simp [Tree.empty, wordAt, wordCols]

/-- N2.2 helper: the head atom of a nonempty column list word has depth coordinate `2e`. -/
theorem wordCols_head_E5 (e : Nat) (cs : List Column) :
    ∀ y ∈ (wordCols e cs).head?, (ofLex y).1 = 2 * e := by
  intro y hy
  cases cs with
  | nil => simp [wordCols] at hy
  | cons c cs =>
    cases c with
    | nil => simp [wordCols, wordCol] at hy; rw [← hy]; rfl
    | cons x xs =>
      obtain ⟨p, h⟩ := x
      simp [wordCols, wordCol] at hy; rw [← hy]; rfl

theorem wordLater_head_E5 (e : Nat) (cs : Column) :
    ∀ y ∈ (wordLater e cs).head?, (ofLex y).1 = 2 * e + 1 := by
  intro y hy
  cases cs with
  | nil => simp [wordLater] at hy
  | cons x xs =>
    obtain ⟨p, h⟩ := x
    simp [wordLater] at hy; rw [← hy]; rfl

/-! L3.5c helpers: budgeted walks over appended lists. -/

theorem spLater_append_E5 : ∀ (k : Nat) (l₁ l₂ : Column),
    spLater k (l₁ ++ l₂) =
      ((spLater k l₁).1 ++ (spLater (spLater k l₁).2 l₂).1, (spLater (spLater k l₁).2 l₂).2)
  | k, [], l₂ => by simp [spLater]
  | k, (p, h) :: l₁, l₂ => by
    by_cases hk : k = 0
    · subst hk; simp [spLater, spx_spLater_zero]
    · simp only [List.cons_append, spLater, hk, if_false]
      rw [spLater_append_E5 _ l₁ l₂]

theorem spCol_append_E5 (k : Nat) {l₁ : Column} (hl : l₁ ≠ []) (l₂ : Column) :
    spCol k (l₁ ++ l₂) =
      ((spCol k l₁).1 ++ (spLater (spCol k l₁).2 l₂).1, (spLater (spCol k l₁).2 l₂).2) := by
  obtain ⟨⟨p, h⟩, l₁, rfl⟩ := List.exists_cons_of_ne_nil hl
  simp only [List.cons_append, spCol]
  rw [spLater_append_E5]

theorem spCols_append_E5 : ∀ (k : Nat) (l₁ l₂ : List Column),
    spCols k (l₁ ++ l₂) =
      ((spCols k l₁).1 ++ (spCols (spCols k l₁).2 l₂).1, (spCols (spCols k l₁).2 l₂).2)
  | k, [], l₂ => by simp [spCols]
  | k, c :: l₁, l₂ => by
    by_cases hk : k = 0
    · subst hk; simp [spCols, spx_spCols_zero]
    · simp only [List.cons_append, spCols, hk, if_false]
      rw [spCols_append_E5 _ l₁ l₂]

theorem spCols_full_E5 {k : Nat} {cs : List Column} (h : (spCols k cs).2 ≠ 0) :
    (spCols k cs).1 = cs := by
  have h2 : (spF k (Tree.node cs)).2 ≠ 0 := by simpa [spF] using h
  have := spx_spF_full h2
  simpa [spF] using this

/-- L3.5c helper: word lengths do not depend on the depth. -/
theorem len_wordCol_E5 (e : Nat) (c : Column) : (wordCol e c).length = (wordCol 0 c).length := by
  have := wordCol_add e 0 c
  rw [Nat.zero_add] at this
  rw [this, List.length_map]

theorem len_wordCols_E5 (e : Nat) (cs : List Column) :
    (wordCols e cs).length = (wordCols 0 cs).length := by
  have := wordCols_add e 0 cs
  rw [Nat.zero_add] at this
  rw [this, List.length_map]

theorem len_wordLater_E5 (e : Nat) {c : Column} (hc : c ≠ []) :
    (wordLater e c).length = (wordCol e c).length := by
  obtain ⟨⟨p, h⟩, c, rfl⟩ := List.exists_cons_of_ne_nil hc
  simp [wordLater, wordCol]

theorem len_wordCol_snoc_E5 (e : Nat) {T : Column} (hT : T ≠ []) (q : Nat) :
    (wordCol e (T ++ [(q, Tree.empty)])).length = (wordCol e T).length + 1 := by
  rw [ker_wordCol_append e hT]
  simp [wordLater, Tree.empty, wordAt, wordCols]

theorem len_wordCol_snoc_le_E5 (e : Nat) (T : Column) (q : Nat) :
    1 ≤ (wordCol e (T ++ [(q, Tree.empty)])).length := by
  cases T with
  | nil => simp [wordCol]
  | cons x T => obtain ⟨p, h⟩ := x; simp [wordCol]

/-- L3.5c helper: the entry `ei` of a budgeted column walk, when its atom fits. -/
theorem spCol_entry_E5 (e : Nat) {colC : Column} {ei q : Nat} {h : Forest}
    (hent : colC[ei]? = some (q, h)) {r : Nat}
    (hr : (wordCol e (colC.take ei ++ [(q, Tree.empty)])).length ≤ r) :
    (spCol r colC).1[ei]? =
      some (q, (spF (r - (wordCol e (colC.take ei ++ [(q, Tree.empty)])).length) h).1) := by
  have hei : ei < colC.length := by
    by_contra hh; rw [List.getElem?_eq_none (by omega)] at hent; cases hent
  obtain ⟨_, hentE⟩ := List.getElem?_eq_some_iff.1 hent
  have hcol2 : colC = colC.take ei ++ (q, h) :: colC.drop (ei + 1) := by
    conv_lhs => rw [← List.take_append_drop ei colC]
    rw [List.drop_eq_getElem_cons hei, hentE]
  by_cases h0 : ei = 0
  · subst h0
    rw [hcol2]
    simp [spCol, wordCol, Tree.empty, wordAt, wordCols, wordLater]
  · have hT : colC.take ei ≠ [] := by
      intro hh; rcases List.take_eq_nil_iff.1 hh with hh | hh
      · exact h0 hh
      · subst hh; simp at hei
    have hlen := len_wordCol_snoc_E5 e hT q
    conv_lhs => rw [hcol2, spCol_append_E5 r hT]
    have hr1 : 1 ≤ r := by omega
    have hs := (spCol_spec e r (colC.take ei) hr1).2
    have hne : (spCol r (colC.take ei)).2 ≠ 0 := by rw [hs]; omega
    have hti : (colC.take ei).length = ei := by simp; omega
    rw [spx_spCol_full_of (by omega) hne, List.getElem?_append_right (by omega), hti, Nat.sub_self]
    simp only [spLater, hne, if_false, List.getElem?_cons_zero]
    rw [hs, hlen, Nat.sub_sub]

/-- L3.5c helper: the column `ci` of a budgeted forest walk, when its first atom fits. -/
theorem spCols_col_E5 (e : Nat) {cols : List Column} {ci : Nat} {colC : Column}
    (hcC : cols[ci]? = some colC) {k : Nat} (hk : (wordCols e (cols.take ci)).length < k) :
    (spCols k cols).1[ci]? = some (spCol (k - (wordCols e (cols.take ci)).length) colC).1 ∧
    (spCols k cols).1.take ci = cols.take ci ∧
    (spCols k cols).1.drop (ci + 1) =
      (spCols (spCol (k - (wordCols e (cols.take ci)).length) colC).2 (cols.drop (ci + 1))).1 := by
  have hci : ci < cols.length := by
    by_contra hh; rw [List.getElem?_eq_none (by omega)] at hcC; cases hcC
  obtain ⟨_, hcolE⟩ := List.getElem?_eq_some_iff.1 hcC
  have hcols : cols = cols.take ci ++ colC :: cols.drop (ci + 1) := by
    conv_lhs => rw [← List.take_append_drop ci cols]
    rw [List.drop_eq_getElem_cons hci, hcolE]
  have hs := (spCols_spec e k (cols.take ci)).2
  have hne : (spCols k (cols.take ci)).2 ≠ 0 := by rw [hs]; omega
  have hfull := spCols_full_E5 hne
  have hti : (cols.take ci).length = ci := by simp; omega
  have hk' : k - (wordCols e (cols.take ci)).length ≠ 0 := by omega
  have key : (spCols k cols).1 = cols.take ci ++
      (spCol (k - (wordCols e (cols.take ci)).length) colC).1 ::
        (spCols (spCol (k - (wordCols e (cols.take ci)).length) colC).2 (cols.drop (ci + 1))).1 := by
    conv_lhs => rw [hcols]
    rw [spCols_append_E5, hfull, hs]
    simp only [spCols, hk', if_false]
  rw [key]
  refine ⟨?_, ?_, ?_⟩
  · rw [List.getElem?_append_right (by omega), hti, Nat.sub_self]; rfl
  · rw [List.take_left' hti]
  · rw [List.drop_append, hti, List.drop_eq_nil_of_le (by omega), List.nil_append,
      show ci + 1 - ci = 1 by omega]
    rfl


/-- N2.2 helper: the word of `F` around the column `⟨σ, j⟩`: a prefix `A` (which is also the
word of every literal cap there, up to the cap's column), the columns `j, j+1, …` of the
forest at `σ` at depth `e + |σ|`, and a shallower rest; a safe prefix whose cut lies after `A` keeps the columns before `j` and
walks the columns from `j` on with the remaining budget. -/
theorem capDecomp_E5 : ∀ (σ : List (Nat × Nat)) (e j : Nat) (F G : Forest) (col : Column),
    F.forestAt σ = some G → G.cols[j]? = some col →
    ∃ A S, wordAt e F = A ++ wordCols (e + σ.length) (G.cols.drop j) ++ S ∧
      (∀ y ∈ S.head?, (ofLex y).1 < 2 * (e + σ.length)) ∧
      (∀ k p, wordAt e (litCapAux k p σ j F) =
        A ++ wordCol (e + σ.length) (col.take k ++ [(p, Tree.empty)])) ∧
      ∀ k, A.length < k → ∃ G', (spF k F).1.forestAt σ = some G' ∧
        G'.cols = G.cols.take j ++ (spCols (k - A.length) (G.cols.drop j)).1
  | [], e, j, .node cols, G, col, hG, hcol => by
    simp only [Tree.forestAt, Option.some.injEq] at hG
    subst hG
    simp only [Tree.cols] at hcol
    refine ⟨wordCols e (cols.take j), [], ?_, by simp, ?_, ?_⟩
    · simp only [wordAt, List.length_nil, Nat.add_zero, List.append_nil, Tree.cols]
      rw [← wordCols_append, List.take_append_drop]
    · intro k p
      have hg : cols.getD j [] = col := by rw [List.getD_eq_getElem?_getD, hcol]; rfl
      simp only [litCapAux, wordAt, hg, wordCols_append, List.length_nil, Nat.add_zero, wordCols,
        List.append_nil]
    · intro k hk
      refine ⟨_, rfl, ?_⟩
      simp only [spF, Tree.cols]
      have h1 := spCols_append_E5 k (cols.take j) (cols.drop j)
      rw [List.take_append_drop] at h1
      have hs := (spCols_spec e k (cols.take j)).2
      have hne : (spCols k (cols.take j)).2 ≠ 0 := by rw [hs]; omega
      rw [h1, spCols_full_E5 hne, hs]
  | (ci, ei) :: rest, e, j, .node cols, G, col, hG, hcol => by
    rw [ker_forestAt_cons] at hG
    cases hcC : cols[ci]? with
    | none => simp [Tree.cols, hcC] at hG
    | some colC =>
      cases hent : colC[ei]? with
      | none => simp [Tree.cols, hcC, hent] at hG
      | some x =>
        obtain ⟨q, h⟩ := x
        simp only [Tree.cols, hcC, hent, Option.bind_some] at hG
        obtain ⟨A', S', hw, hS, hcap, hsp⟩ := capDecomp_E5 rest (e + 1) j h G col hG hcol
        have hci : ci < cols.length := by
          by_contra hh; rw [List.getElem?_eq_none (by omega)] at hcC; cases hcC
        have hei : ei < colC.length := by
          by_contra hh; rw [List.getElem?_eq_none (by omega)] at hent; cases hent
        obtain ⟨_, hcolE⟩ := List.getElem?_eq_some_iff.1 hcC
        obtain ⟨_, hentE⟩ := List.getElem?_eq_some_iff.1 hent
        have hcols : cols = cols.take ci ++ colC :: cols.drop (ci + 1) := by
          conv_lhs => rw [← List.take_append_drop ci cols]
          rw [List.drop_eq_getElem_cons hci, hcolE]
        have hcol2 : colC = colC.take ei ++ (q, h) :: colC.drop (ei + 1) := by
          conv_lhs => rw [← List.take_append_drop ei colC]
          rw [List.drop_eq_getElem_cons hei, hentE]
        have hlen : e + ((ci, ei) :: rest).length = e + 1 + rest.length := by
          simp; omega
        rw [hlen]
        refine ⟨wordCols e (cols.take ci) ++ wordCol e (colC.take ei ++ [(q, Tree.empty)]) ++ A',
          S' ++ wordLater e (colC.drop (ei + 1)) ++ wordCols e (cols.drop (ci + 1)), ?_, ?_, ?_, ?_⟩
        · show wordCols e cols = _
          conv_lhs => rw [hcols]
          rw [wordCols_append]
          simp only [wordCols]
          conv_lhs => rw [hcol2]
          rw [wordCol_split_E5, hw]
          simp only [List.append_assoc]
        · intro y hy
          cases S' with
          | cons s S' =>
            simp only [List.cons_append, List.head?_cons, Option.mem_def,
              Option.some.injEq] at hy
            subst hy
            exact hS s rfl
          | nil =>
            simp only [List.nil_append] at hy
            cases hL : wordLater e (colC.drop (ei + 1)) with
            | cons l L =>
              rw [hL] at hy
              simp only [List.cons_append, List.head?_cons, Option.mem_def,
                Option.some.injEq] at hy
              subst hy
              have := wordLater_head_E5 e (colC.drop (ei + 1)) l (by rw [hL]; rfl)
              omega
            | nil =>
              rw [hL, List.nil_append] at hy
              have := wordCols_head_E5 e (cols.drop (ci + 1)) y hy
              omega
        · intro k p
          rw [ker_litCapAux_cons k p ci ei j rest cols hcC hent]
          show wordCols e _ = _
          rw [wordCols_append]
          simp only [wordCols, List.append_nil]
          rw [show colC.take ei ++ [(q, litCapAux k p rest j h)] =
              colC.take ei ++ (q, litCapAux k p rest j h) :: [] from rfl, wordCol_split_E5,
            hcap k p]
          simp only [wordLater, List.append_nil, List.append_assoc]
        · intro k hk
          simp only [List.length_append] at hk
          obtain ⟨hc1, -, -⟩ := spCols_col_E5 e hcC (k := k) (by omega)
          have he1 := spCol_entry_E5 e hent
            (r := k - (wordCols e (cols.take ci)).length) (by omega)
          obtain ⟨G', hG', hGc⟩ := hsp (k - (wordCols e (cols.take ci)).length -
            (wordCol e (colC.take ei ++ [(q, Tree.empty)])).length) (by omega)
          refine ⟨G', ?_, ?_⟩
          · simp only [spF]
            rw [ker_forestAt_cons]
            simp only [Tree.cols]
            rw [hc1, Option.bind_some, he1, Option.bind_some]
            exact hG'
          · rw [hGc, List.length_append, List.length_append]
            congr 3
            omega

/-- N2.2 helper: depth-shifting a word is reading the forest deeper. -/
theorem map_depthShift_word_E5 (e : Nat) (X : Forest) :
    (word X).map (depthShift e) = wordAt e X := by
  unfold word
  have := wordAt_add 0 e X
  rw [Nat.zero_add] at this
  rw [this]; rfl

/-- N2.2 helper: the decomposition of `w(B)` at a column `c` of `B`: the common prefix `A` of all
literal caps at `c`, the local suffix at depth `colDepth c`, and a shallower rest. -/
theorem wordDecomp_E5 {B : Forest} {c : ColAddr} (hc : c ∈ B.colAddrs) :
    ∃ A S, word B = A ++ (word (localSuffix B c)).map (depthShift (colDepth c)) ++ S ∧
      (∀ y ∈ S.head?, (ofLex y).1 < 2 * colDepth c) ∧
      ∀ k p, word (litCap B c k p) =
        A ++ wordCol (colDepth c) (((B.colAt c).getD []).take k ++ [(p, Tree.empty)]) := by
  obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff B c).1 hc)
  have hcol' := hcol
  unfold Tree.colAt at hcol'
  cases hG : B.forestAt c.path with
  | none => rw [hG] at hcol'; cases hcol'
  | some G =>
    rw [hG, Option.bind_some] at hcol'
    obtain ⟨A, S, hw, hS, hcap, -⟩ := capDecomp_E5 c.path 0 c.col B G col hG hcol'
    rw [Nat.zero_add] at hw hS hcap
    refine ⟨A, S, ?_, hS, ?_⟩
    · have hL : (word (localSuffix B c)).map (depthShift (colDepth c)) =
          wordCols c.path.length (G.cols.drop c.col) := by
        unfold localSuffix word
        rw [hG, Option.getD_some]
        have := wordAt_add 0 c.path.length (Tree.node (G.cols.drop c.col))
        rw [Nat.zero_add] at this
        change _ = wordAt c.path.length (Tree.node _)
        rw [this]; rfl
      rw [hL]; exact hw
    · intro k p
      unfold litCap litCapBody
      rw [if_pos (by rw [hcol]; rfl), hcol, Option.getD_some]
      exact hcap k p

/-- N2.2 helper: the cap position of a cut `k` at column `c`. -/
theorem capPos_eq_E5 {B : Forest} {c : ColAddr} {A : List WordAtom}
    (hcap : ∀ k p, word (litCap B c k p) =
        A ++ wordCol (colDepth c) (((B.colAt c).getD []).take k ++ [(p, Tree.empty)])) (k : Nat) :
    capPos B c k = A.length +
      (wordCol (colDepth c) (((B.colAt c).getD []).take k ++ [(0, Tree.empty)])).length - 1 := by
  unfold capPos; rw [hcap k 0, List.length_append]

theorem capPos_zero_E5 {B : Forest} {c : ColAddr} {A : List WordAtom}
    (hcap : ∀ k p, word (litCap B c k p) =
        A ++ wordCol (colDepth c) (((B.colAt c).getD []).take k ++ [(p, Tree.empty)])) :
    capPos B c 0 = A.length := by
  rw [capPos_eq_E5 hcap 0]
  simp [wordCol, Tree.empty, wordAt, wordCols, wordLater]

-- N2.2: the word of `B` at a column: context prefix, local suffix at depth `e`, shallower rest
theorem word_localSuffix {B : Forest} {c : ColAddr} (hc : c ∈ B.colAddrs) :
    ∃ S, word B = (word B).take (capPos B c 0) ++ (word (localSuffix B c)).map (depthShift (colDepth c)) ++ S ∧
      ∀ y ∈ S.head?, (ofLex y).1 < 2 * colDepth c := by
  obtain ⟨A, S, hw, hS, hcap⟩ := wordDecomp_E5 hc
  refine ⟨S, ?_, hS⟩
  rw [capPos_zero_E5 hcap]
  have hA : (word B).take A.length = A := by rw [hw, List.append_assoc, List.take_left]
  rw [hA]; exact hw

-- N2.2: filling a cap with its complete local suffix restores the target up to the end of the
-- cap column's forest (all of the target when that forest is on the target's route)
theorem context_litCap_localSuffix {B : Forest} {c : ColAddr} {k p : Nat} (hup : IsUpward B c k p)
    {sd : StopData} (hsd : stopData (litCap B c k p) = some sd) :
    context (litCap B c k p) sd (localSuffix B c) =
      safePrefix B (capPos B c 0 + mu (localSuffix B c)) := by
  have hc : c ∈ B.colAddrs := by
    rw [Tree.mem_colAddrs_iff]
    unfold IsUpward at hup
    split at hup
    · rename_i col hcol; rw [hcol]; rfl
    · exact hup.elim
  obtain ⟨A, S, hw, hS, hcap⟩ := wordDecomp_E5 hc
  have hsdE : sd = ⟨colDepth c, c, c.num 0, p, ((B.colAt c).getD []).take k⟩ :=
    Option.some.inj (hsd.symm.trans (stopData_litCap hup))
  have hdep : sd.depth = colDepth c := by rw [hsdE]
  have hQ : sd.Q = ((B.colAt c).getD []).take k := by rw [hsdE]
  have hr : sd.r = p := by rw [hsdE]
  apply word_injective
  rw [word_safePrefix, word_context hsd, capPos_zero_E5 hcap]
  -- the context at `∅` has word `A`
  have hK : context (litCap B c k p) sd (Tree.node [sd.Q ++ [(sd.r, Tree.empty)]])
      = litCap B c k p := by
    obtain ⟨G, hG, hR⟩ := ker_routeTo_of_stop hsd 0 (Nat.zero_le _)
    simp only [List.take_zero, Tree.forestAt, Option.some.injEq] at hG
    subst hG
    exact ker_replaceAt_self _ _ _ hR
  have h0 := word_context hsd (Tree.node [sd.Q ++ [(sd.r, Tree.empty)]])
  rw [hK, hcap k p, hQ, hr, hdep] at h0
  have h1 : (word (Tree.node [((B.colAt c).getD []).take k ++ [(p, Tree.empty)]])).map
      (depthShift (colDepth c)) = wordCol (colDepth c) (((B.colAt c).getD []).take k ++ [(p, Tree.empty)]) := by
    rw [map_depthShift_word_E5]; simp [wordAt, wordCols]
  rw [h1] at h0
  have hA := List.append_cancel_right h0
  rw [← hA, hw, mu, hdep, List.append_assoc, List.take_append, List.take_of_length_le (by omega),
    Nat.add_sub_cancel_left, List.take_left' (by simp)]

/-- L3.5c helper: the root tail of a safe prefix, read from the budgeted walk of the root
forest from the root column on, is a safe prefix of the root tail. -/
theorem rt_sp_E5 (col : Column) (R : List Column) (m γ : Nat) (hm : 1 ≤ m)
    (hγ : col.take γ ≠ [] → (wordCol 0 (col.take γ)).length < m) :
    ∃ n, 1 ≤ n ∧ n + (wordCols 0 (col :: R)).length = m + mu (Tree.node (col.drop γ :: R)) ∧
      Tree.node ((spCol m col).1.drop γ :: (spCols (spCol m col).2 R).1) =
        safePrefix (Tree.node (col.drop γ :: R)) n := by
  have hm0 : m ≠ 0 := by omega
  by_cases ht : col.take γ = []
  · have hc : γ = 0 ∨ col = [] := List.take_eq_nil_iff.1 ht
    refine ⟨m, hm, ?_, ?_⟩
    · rcases hc with rfl | rfl <;> simp [mu, word, wordAt]
    · unfold safePrefix safePrefixBody
      rcases hc with rfl | rfl
      · simp [spF, spCols, hm0]
      · simp [spF, spCols, spCol, hm0]
  · have ha := hγ ht
    have hsplit : col = col.take γ ++ col.drop γ := (List.take_append_drop γ col).symm
    have hs := (spCol_spec 0 m (col.take γ) hm).2
    have hne : (spCol m (col.take γ)).2 ≠ 0 := by rw [hs]; omega
    have hfull := spx_spCol_full_of hm0 hne
    have key : spCol m col = (col.take γ ++ (spLater (m - (wordCol 0 (col.take γ)).length)
        (col.drop γ)).1, (spLater (m - (wordCol 0 (col.take γ)).length) (col.drop γ)).2) := by
      conv_lhs => rw [hsplit]
      rw [spCol_append_E5 m ht, hfull, hs]
    rw [key]
    simp only
    have hwc : wordCol 0 col = wordCol 0 (col.take γ) ++ wordLater 0 (col.drop γ) := by
      conv_lhs => rw [hsplit]
      exact ker_wordCol_append 0 ht _
    by_cases hd : col.drop γ = []
    · have htc : col.take γ = col := by
        conv_rhs => rw [hsplit, hd, List.append_nil]
      rw [hd]
      simp only [spLater, List.append_nil]
      rw [List.drop_eq_nil_of_le (by simp)]
      rw [hd] at hwc
      simp only [wordLater, List.append_nil] at hwc
      refine ⟨m - (wordCol 0 (col.take γ)).length + 1, by omega, ?_, ?_⟩
      · simp only [mu, word, wordAt, wordCols, List.length_append, wordCol, List.length_cons,
          List.length_nil]
        rw [hwc]; omega
      · unfold safePrefix safePrefixBody
        simp [spF, spCols, spCol]
    · have hlt : γ < col.length := by
        by_contra hh; exact hd (List.drop_eq_nil_of_le (by omega))
      have hT : (col.take γ).length = γ := by simp; omega
      rw [List.drop_left' hT]
      refine ⟨m - (wordCol 0 (col.take γ)).length, by omega, ?_, ?_⟩
      · simp only [mu, word, wordAt, wordCols, List.length_append]
        rw [hwc, List.length_append, len_wordLater_E5 0 hd]; omega
      · obtain ⟨⟨p, h⟩, X', hX⟩ := List.exists_cons_of_ne_nil hd
        rw [hX]
        have hm' : m - (wordCol 0 (col.take γ)).length ≠ 0 := by omega
        unfold safePrefix safePrefixBody
        simp [spF, spCols, spCol, spLater, hm']

/-- L3.5c helper: the first atom of a forest with a first column, and its `e_1` recoding. -/
def encHd_E5 (a : WordAtom) : List WordAtom :=
  if (ofLex (ofLex a).2).1 = 0 then [] else [toLex (1, toLex (0, (ofLex (ofLex a).2).2))]

theorem encOne_word_E5 (c : Column) (cs : List Column) :
    ∃ a T, word (Tree.node (c :: cs)) = a :: T ∧ encOne (Tree.node (c :: cs)) = encHd_E5 a ++ T := by
  cases c with
  | nil => exact ⟨_, _, rfl, by simp [encOne, encHd_E5, wordLater]⟩
  | cons x c =>
    obtain ⟨p, h⟩ := x
    refine ⟨_, _, rfl, ?_⟩
    simp [encOne, encHd_E5, wordLater]

theorem take_lt_E5 {β : Type} [LinearOrder β] {l : List β} {n : Nat} (h : n < l.length) :
    l.take n < l := by
  conv_rhs => rw [← List.take_append_drop n l]
  apply ker_lt_append
  intro h'
  have := congrArg List.length h'
  simp at this; omega

/-- L3.5c helper: a nonempty proper word prefix survives relabelling and `Q ⋄ ·`. -/
theorem diamond_lt_of_prefix_E5 {X₁ X₂ : Forest} (h1 : X₁.cols ≠ []) (h2 : X₂.cols ≠ [])
    {n : Nat} (hn1 : 1 ≤ n) (hn2 : n < mu X₂) (hw : word X₁ = (word X₂).take n) (Q : Column)
    (f : Nat → Nat) : diamond Q (Tree.map f X₁) < diamond Q (Tree.map f X₂) := by
  obtain ⟨cs₁⟩ := X₁
  obtain ⟨cs₂⟩ := X₂
  obtain ⟨c₁, cs₁, rfl⟩ := List.exists_cons_of_ne_nil h1
  obtain ⟨c₂, cs₂, rfl⟩ := List.exists_cons_of_ne_nil h2
  have hY : ∀ (c : Column) (cs : List Column), Tree.map f (Tree.node (c :: cs)) =
      Tree.node (Tree.mapCol f c :: Tree.mapCols f cs) := fun c cs => rfl
  rw [hY, hY]
  have hw' : word (Tree.node (Tree.mapCol f c₁ :: Tree.mapCols f cs₁)) =
      (word (Tree.node (Tree.mapCol f c₂ :: Tree.mapCols f cs₂))).take n := by
    rw [← hY, ← hY]
    unfold word
    rw [wordAt_map, wordAt_map]
    unfold word at hw
    rw [hw, List.map_take]
  have hlen : n < (word (Tree.node (Tree.mapCol f c₂ :: Tree.mapCols f cs₂))).length := by
    rw [← hY]; unfold word; rw [wordAt_map, List.length_map]; exact hn2
  rw [← word_lt_iff, cancel_eq Q (by simp [Tree.empty]), cancel_eq Q (by simp [Tree.empty]),
    ker_append_lt_append_iff]
  unfold encEps
  split_ifs with hQ
  · rw [hw']; exact take_lt_E5 hlen
  · obtain ⟨a₁, T₁, hw₁, he₁⟩ := encOne_word_E5 (Tree.mapCol f c₁) (Tree.mapCols f cs₁)
    obtain ⟨a₂, T₂, hw₂, he₂⟩ := encOne_word_E5 (Tree.mapCol f c₂) (Tree.mapCols f cs₂)
    rw [he₁, he₂]
    rw [hw₁, hw₂] at hw'
    rw [hw₂] at hlen
    obtain ⟨n', rfl⟩ : ∃ n', n = n' + 1 := ⟨n - 1, by omega⟩
    rw [List.take_succ_cons, List.cons.injEq] at hw'
    obtain ⟨rfl, rfl⟩ := hw'
    rw [ker_append_lt_append_iff]
    simp only [List.length_cons] at hlen
    exact take_lt_E5 (by omega)

theorem len_capCol_E5 (e : Nat) (col : Column) (γ : Nat) :
    (wordCol e (col.take γ ++ [(0, Tree.empty)])).length =
      if col.take γ = [] then 1 else (wordCol e (col.take γ)).length + 1 := by
  split_ifs with h
  · rw [h]; simp [wordCol, Tree.empty, wordAt, wordCols, wordLater]
  · exact len_wordCol_snoc_E5 e h 0

-- L3.5c (txt:476-478, 579-580): root restriction preserves proper word extension when the cut of
-- the shorter filling lies after the start of the retained root entry
-- C5 (statement change): `hidx : rd.idx = rd.col.col` added. `rootTail` drops the columns up to
-- `rd.idx`, so for an arbitrary `rd` the later columns of the root forest can be lost and the
-- inequality fails. Counterexample (checked by `#eval`): `D₂ = [[],[],[]]`,
-- `rd.col = ⟨[], 0⟩`, `rd.idx = 5`, `γ = 0`, `π = 2`: `capPos D₂ rd.col 0 = 0 < 2 < 3 = µ(D₂)`,
-- `hlast` holds (depth `0`), and both root tails are `[[]]`. Every `rd` from `rootData` has
-- `rd.idx = rd.col.col` (`rootData_spec`).
-- E5: moved below N2.2 (brief rule 5): the proof uses N2.2's decomposition helpers.
theorem rootTail_extension {D₁ D₂ : Forest} {rd : RootData} {γ π : Nat}
    (hidx : rd.idx = rd.col.col)
    (hD : D₁ = safePrefix D₂ π) (hπ : π < mu D₂) (hcol : rd.col ∈ D₂.colAddrs)
    (hγ : capPos D₂ rd.col γ < π)
    (hlast : ∀ y ∈ (word D₂).drop (capPos D₂ rd.col γ), 2 * colDepth rd.col ≤ (ofLex y).1)
    (Q : Column) (ρ δ : Nat) :
    diamond Q (shift ρ δ (rootTail D₁ rd γ)) < diamond Q (shift ρ δ (rootTail D₂ rd γ)) := by
  obtain ⟨col, hcolS⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff D₂ rd.col).1 hcol)
  have hcol' := hcolS
  unfold Tree.colAt at hcol'
  cases hG : D₂.forestAt rd.col.path with
  | none => rw [hG] at hcol'; cases hcol'
  | some G =>
  rw [hG, Option.bind_some] at hcol'
  obtain ⟨A, S, hw, hS, hcap, hsp⟩ := capDecomp_E5 rd.col.path 0 rd.col.col D₂ G col hG hcol'
  rw [Nat.zero_add] at hw hS hcap
  have hj : rd.col.col < G.cols.length := by
    by_contra hh; rw [List.getElem?_eq_none (by omega)] at hcol'; cases hcol'
  have hGd : G.cols.drop rd.col.col = col :: G.cols.drop (rd.col.col + 1) := by
    rw [List.drop_eq_getElem_cons hj]
    obtain ⟨_, h⟩ := List.getElem?_eq_some_iff.1 hcol'
    rw [h]
  obtain ⟨R, hR⟩ : ∃ R, G.cols.drop (rd.col.col + 1) = R := ⟨_, rfl⟩
  rw [hR] at hGd
  rw [hGd] at hw
  have hcp : capPos D₂ rd.col γ =
      A.length + (wordCol rd.col.path.length (col.take γ ++ [(0, Tree.empty)])).length - 1 := by
    unfold capPos litCap litCapBody
    rw [if_pos (by rw [hcolS]; rfl)]
    show (wordAt 0 _).length - 1 = _
    rw [hcap, List.length_append]
  rw [len_capCol_E5] at hcp
  have hwc : wordCol rd.col.path.length col = wordCol rd.col.path.length (col.take γ) ++
      wordLater rd.col.path.length (col.drop γ) ∨ col.take γ = [] := by
    by_cases ht : col.take γ = []
    · exact Or.inr ht
    · left
      conv_lhs => rw [← List.take_append_drop γ col]
      exact ker_wordCol_append _ ht _
  have hcpA : A.length ≤ capPos D₂ rd.col γ := by rw [hcp]; split_ifs <;> omega
  have hcpM : capPos D₂ rd.col γ ≤ A.length + (wordCols rd.col.path.length (col :: R)).length := by
    rw [hcp]
    simp only [wordCols, List.length_append]
    split_ifs with ht
    · omega
    · rcases hwc with hwc | hwc
      · rw [hwc, List.length_append]; omega
      · exact absurd hwc ht
  have hS0 : S = [] := by
    cases S with
    | nil => rfl
    | cons s S' =>
      exfalso
      have hsm : s ∈ (word D₂).drop (capPos D₂ rd.col γ) := by
        unfold word; rw [hw, List.drop_append_of_le_length (by simp; omega)]
        simp
      have h1 := hlast s hsm
      have h2 := hS s rfl
      unfold colDepth at h1
      omega
  rw [hS0, List.append_nil] at hw
  have hmu : mu D₂ = A.length + (wordCols rd.col.path.length (col :: R)).length := by
    unfold mu word; rw [hw, List.length_append]
  have hA : A.length < π := by omega
  obtain ⟨G', hG', hG'c⟩ := hsp π hA
  rw [hGd] at hG'c
  have hm0 : π - A.length ≠ 0 := by omega
  simp only [spCols, hm0, if_false] at hG'c
  have hD1 : D₁ = (spF π D₂).1 := hD
  have hrt1 : rootTail D₁ rd γ = Tree.node ((spCol (π - A.length) col).1.drop γ ::
      (spCols (spCol (π - A.length) col).2 R).1) := by
    have htk : (G.cols.take rd.col.col).length = rd.col.col := by simp; omega
    unfold rootTail
    rw [hD1, hidx]
    unfold Tree.colAt
    rw [hG', Option.bind_some, Option.getD_some, hG'c, List.getElem?_append_right (by omega),
      htk, Nat.sub_self, List.getElem?_cons_zero, Option.getD_some, List.drop_append,
      show (G.cols.take rd.col.col).drop (rd.col.col + 1) = [] from
        List.drop_eq_nil_of_le (by omega), List.nil_append, htk,
      show rd.col.col + 1 - rd.col.col = 1 by omega]
    rfl
  have hrt2 : rootTail D₂ rd γ = Tree.node (col.drop γ :: R) := by
    unfold rootTail
    rw [hidx, hcolS, hG, Option.getD_some, Option.getD_some, hR]
  rw [hrt1, hrt2]
  have hγ' : col.take γ ≠ [] → (wordCol 0 (col.take γ)).length < π - A.length := by
    intro ht
    rw [if_neg ht] at hcp
    rw [← len_wordCol_E5 rd.col.path.length]
    omega
  obtain ⟨n, hn1, hnlen, heq⟩ := rt_sp_E5 col R (π - A.length) γ (by omega) hγ'
  have hlt : n < mu (Tree.node (col.drop γ :: R)) := by
    rw [len_wordCols_E5] at hmu
    omega
  exact diamond_lt_of_prefix_E5
    (X₁ := Tree.node ((spCol (π - A.length) col).1.drop γ :: (spCols (spCol (π - A.length) col).2 R).1))
    (X₂ := Tree.node (col.drop γ :: R)) (List.cons_ne_nil _ _) (List.cons_ne_nil _ _) hn1 hlt
    (by rw [heq, word_safePrefix]) Q (shiftVal ρ δ)

/-- helper: the first column of a kernel output starts with the query. -/
theorem kernel_firstCol_E5 (E : Forest) (sd : StopData) (rd : RootData) (X : Forest) :
    ∃ V cs, kernel E sd rd X = Tree.node ((sd.Q ++ V) :: cs) := by
  unfold kernel
  split
  · exact ⟨_, [], rfl⟩
  · exact ⟨_, _, rfl⟩


theorem wordCol_ne_nil_E5 (e : Nat) (c : Column) : wordCol e c ≠ [] := by
  cases c with
  | nil => simp [wordCol]
  | cons x c => obtain ⟨p, h⟩ := x; simp [wordCol]


/-- T3.8d helper: a word strictly between `X ⌢ T` and `X ⌢ [z]` continues `X` by an atom
`y < z` that is at least the first atom of `T`. -/
theorem between_E5 {β : Type} [LinearOrder β] :
    ∀ (X T L : List β) (z : β), X ++ T < L → L < X ++ [z] →
      ∃ y L', L = X ++ y :: L' ∧ y < z ∧ ∀ t ∈ T.head?, t ≤ y
  | [], T, L, z, h1, h2 => by
    cases L with
    | nil => exact absurd h1 (List.not_lt_nil _)
    | cons y L' =>
      rw [List.nil_append, List.cons_lt_cons_iff] at h2
      rcases h2 with h2 | ⟨rfl, h2⟩
      · refine ⟨y, L', rfl, h2, ?_⟩
        intro t ht
        cases T with
        | nil => simp at ht
        | cons t' T' =>
          simp only [List.head?_cons, Option.mem_def, Option.some.injEq] at ht
          subst ht
          rw [List.nil_append, List.cons_lt_cons_iff] at h1
          rcases h1 with h1 | ⟨rfl, -⟩
          · exact le_of_lt h1
          · exact le_rfl
      · exact absurd h2 (List.not_lt_nil _)
  | x :: X, T, L, z, h1, h2 => by
    cases L with
    | nil => exact absurd h1 (List.not_lt_nil _)
    | cons l L' =>
      rw [List.cons_append, List.cons_lt_cons_iff] at h1 h2
      rcases h2 with h2 | ⟨rfl, h2⟩
      · rcases h1 with h1 | ⟨rfl, _⟩
        · exact absurd h1 (not_lt_of_gt h2)
        · exact absurd h2 (lt_irrefl _)
      · rcases h1 with h1 | ⟨_, h1⟩
        · exact absurd h1 (lt_irrefl _)
        · obtain ⟨y, L'', rfl, hy, ht⟩ := between_E5 X T L' z h1 h2
          exact ⟨y, L'', rfl, hy, ht⟩

-- T3.8d (txt:496-499): between `E[1]` and `E`, `E` is an upward literal cap of the target
theorem ordinary_cap_of_between {E B E1 : Forest} {sd : StopData} (hL : InL E)
    (hk : stepKind E = some .ordinary) (hsd : stopData E = some sd) (h1 : expand E 1 = some E1)
    (hlo : E1 < B) (hhi : B < E) :
    IsUpward B sd.col sd.Q.length sd.r ∧ litCap B sd.col sd.Q.length sd.r = E := by
  obtain ⟨rd, hrd⟩ := Option.isSome_iff_exists.1 (rootData_of_ordinary hk)
  obtain ⟨hE1, -⟩ := ker_expand_out hL.1 hL.2.1 hk hsd hrd h1
  have hEself : context E sd (Tree.node [sd.Q ++ [(sd.r, Tree.empty)]]) = E := by
    obtain ⟨G, hG, hR⟩ := ker_routeTo_of_stop hsd 0 (Nat.zero_le _)
    simp only [List.take_zero, Tree.forestAt, Option.some.injEq] at hG
    subst hG
    exact ker_replaceAt_self _ _ _ hR
  have hwE := word_context hsd (Tree.node [sd.Q ++ [(sd.r, Tree.empty)]])
  rw [hEself, map_depthShift_word_E5] at hwE
  have hwE1 := word_context hsd ((kernel E sd rd)^[1] Tree.empty)
  rw [← hE1, map_depthShift_word_E5] at hwE1
  obtain ⟨V, cs, hker⟩ := kernel_firstCol_E5 E sd rd Tree.empty
  simp only [Function.iterate_one] at hwE1
  rw [hker] at hwE1
  set W0 := word (context E sd Tree.empty)
  set first : Bool := sd.Q.isEmpty
  set z : WordAtom := if first then toLex (2 * sd.depth, toLex (1, sd.r))
    else toLex (2 * sd.depth + 1, toLex (0, sd.r))
  set X : List WordAtom := W0 ++ (if sd.Q = [] then [] else wordCol sd.depth sd.Q)
  obtain ⟨T, hXT, hT⟩ : ∃ T, word E1 = X ++ T ∧
      (first = true → ∃ t ∈ T.head?, 2 * sd.depth ≤ (ofLex t).1) := by
    by_cases hQ : sd.Q = []
    · refine ⟨wordCols sd.depth ((sd.Q ++ V) :: cs), ?_, ?_⟩
      · rw [hwE1]; simp only [X, if_pos hQ, List.append_nil]; rfl
      · intro _
        obtain ⟨t, ht⟩ : ∃ t, (wordCols sd.depth ((sd.Q ++ V) :: cs)).head? = some t := by
          cases h : (wordCols sd.depth ((sd.Q ++ V) :: cs)).head? with
          | none =>
            simp only [List.head?_eq_none_iff, wordCols, List.append_eq_nil_iff] at h
            exact absurd h.1 (wordCol_ne_nil_E5 _ _)
          | some t => exact ⟨t, rfl⟩
        exact ⟨t, ht, le_of_eq (wordCols_head_E5 _ _ t ht).symm⟩
    · refine ⟨wordLater sd.depth V ++ wordCols sd.depth cs, ?_, ?_⟩
      · rw [hwE1]
        simp only [X, if_neg hQ]
        show W0 ++ wordCols sd.depth ((sd.Q ++ V) :: cs) = _
        simp only [wordCols]
        rw [ker_wordCol_append _ hQ]
        simp only [List.append_assoc]
      · intro hf
        exact absurd (List.isEmpty_iff.1 hf) hQ
  have hXz : word E = X ++ [z] := by
    rw [hwE]
    by_cases hQ : sd.Q = []
    · simp only [X, z, first, hQ, List.isEmpty_nil, if_true, List.append_nil]
      simp [wordAt, wordCols, wordCol, Tree.empty, wordLater]
    · have hf : first = false := by simp [first, hQ]
      simp only [X, z, hf, if_neg hQ, Bool.false_eq_true, if_false]
      show W0 ++ wordCols sd.depth [sd.Q ++ [(sd.r, Tree.empty)]] = _
      simp only [wordCols, List.append_nil]
      rw [ker_wordCol_append _ hQ]
      simp [wordLater, Tree.empty, wordAt, wordCols, List.append_assoc]
  rw [← word_lt_iff, hXT] at hlo
  rw [← word_lt_iff, hXz] at hhi
  obtain ⟨y, L', hB, hyz, hty⟩ := between_E5 X T (word B) z hlo hhi
  have hBX : (word B).take X.length = X := by rw [hB, List.take_left]
  have hBy : (word B)[X.length]? = some y := by rw [hB]; simp
  obtain ⟨c, k, hc, hk', hdc, hk0, hcp, hup, hcap⟩ :=
    exists_litCap_of_word (B := B) (E := E) (π := X.length) (e := sd.depth) (p := sd.r)
      (first := first) (by rw [hBX]; exact hXz) (by unfold mu; rw [hB]; simp)
      (by intro y' hy'; rw [hBy] at hy'; cases hy'; exact hyz)
      (by
        intro hf
        obtain ⟨t, ht, htd⟩ := hT hf
        refine ⟨y, hBy, ?_⟩
        have := hty t ht
        rw [Prod.Lex.le_iff] at this
        rcases this with h | ⟨h, -⟩
        · exact le_of_lt (lt_of_le_of_lt htd h)
        · rw [← h]; exact htd)
  have hsd2 := stopData_litCap hup
  rw [hcap, hsd] at hsd2
  have hsdE := Option.some.inj hsd2
  have hcolE : sd.col = c := by rw [hsdE]
  have hQE : sd.Q = ((B.colAt c).getD []).take k := by rw [hsdE]
  have hrE : sd.r = sd.r := rfl
  have hQlen : sd.Q.length = k := by rw [hQE, List.length_take]; omega
  rw [hcolE, hQlen]
  exact ⟨hup, hcap⟩

/-- T3.8f helper: words followed by shallower well-formed continuations compare as the forests,
then as the continuations (the word form of U1's `gwordAt_append_lt_iff`). -/
theorem wordAt_append_lt_iff_E5 (e : Nat) (s t : Forest) {xs ys : List WordAtom}
    (hxs : ∀ A ∈ xs, A.WF) (hys : ∀ A ∈ ys, A.WF)
    (hxs' : ∀ A ∈ xs.head?, (ofLex A).1 < 2 * e) (hys' : ∀ A ∈ ys.head?, (ofLex A).1 < 2 * e) :
    wordAt e s ++ xs < wordAt e t ++ ys ↔ s < t ∨ (s = t ∧ xs < ys) := by
  have h1 : ∀ x ∈ wordAt e s ++ xs, x ∈ {A : WordAtom | A.WF} := by
    intro x hx
    rcases List.mem_append.1 hx with hx | hx
    · exact wordAt_wf e s x hx
    · exact hxs x hx
  have h2 : ∀ x ∈ wordAt e t ++ ys, x ∈ {A : WordAtom | A.WF} := by
    intro x hx
    rcases List.mem_append.1 hx with hx | hx
    · exact wordAt_wf e t x hx
    · exact hys x hx
  rw [← list_map_lt_iff toGAtom_strictMonoOn h1 h2, List.map_append, List.map_append,
    ← gwordAt_eq_map_wordAt, ← gwordAt_eq_map_wordAt]
  have hx2 : ∀ A ∈ (xs.map toGAtom).head?, (ofLex A).1 < 2 * e := by
    intro A hA
    rw [List.head?_map, Option.mem_def, Option.map_eq_some_iff] at hA
    obtain ⟨a, ha, rfl⟩ := hA
    exact hxs' a ha
  have hy2 : ∀ A ∈ (ys.map toGAtom).head?, (ofLex A).1 < 2 * e := by
    intro A hA
    rw [List.head?_map, Option.mem_def, Option.map_eq_some_iff] at hA
    obtain ⟨a, ha, rfl⟩ := hA
    exact hys' a ha
  rw [gwordAt_append_lt_iff e s t hx2 hy2, list_map_lt_iff toGAtom_strictMonoOn hxs hys]
  rfl



/-- T3.8j helper: the complete local suffix starts with the cap column. -/
theorem localSuffix_eq_E5 {B : Forest} {c : ColAddr} {col : Column} (hcol : B.colAt c = some col) :
    ∃ R, localSuffix B c = Tree.node (col :: R) := by
  have hcol' := hcol
  unfold Tree.colAt at hcol'
  obtain ⟨G, hG⟩ : ∃ G, B.forestAt c.path = some G := by
    cases h : B.forestAt c.path with
    | none => rw [h] at hcol'; cases hcol'
    | some G => exact ⟨G, rfl⟩
  rw [hG, Option.bind_some] at hcol'
  have hj : c.col < G.cols.length := by
    by_contra hh; rw [List.getElem?_eq_none (by omega)] at hcol'; cases hcol'
  refine ⟨G.cols.drop (c.col + 1), ?_⟩
  unfold localSuffix
  rw [hG, Option.getD_some, List.drop_eq_getElem_cons hj]
  obtain ⟨_, h⟩ := List.getElem?_eq_some_iff.1 hcol'
  rw [h]



/-- T3.8e helper: placing a one-column filling keeps the hole address. -/
theorem kerHoleAt_replaceAt_E5 (c : Column) : ∀ (k : Nat) (G : Forest), KerRoute k G →
    kerHoleAt k (replaceAt 0 0 (Tree.node [c]) k G) = kerHoleAt k G
  | 0, .node cols, h => by
    have hne : cols ≠ [] := h
    rw [ker_replaceAt_zero_zero _ _ hne]
    simp only [kerHoleAt, Tree.cols, List.length_append, List.length_dropLast, List.length_singleton]
    rfl
  | k + 1, .node cols, ⟨col, p, H, h1, h2, h3⟩ => by
    rw [ker_replaceAt_zero_succ]
    have ih := kerHoleAt_replaceAt_E5 c k H h3
    simp only [Tree.cols] at h1
    obtain ⟨ys, rfl⟩ := List.getLast?_eq_some_iff.1 h1
    obtain ⟨zs, rfl⟩ := List.getLast?_eq_some_iff.1 h2
    simp only [mapLast_eq, List.dropLast_concat, List.getLast?_concat, Option.map_some,
      Option.toList_some, List.map_id_fun, id_eq]
    simp only [kerHoleAt, Tree.cols, List.getLast?_concat, Option.getD_some, List.length_append,
      List.length_singleton, Option.map_some, ih]


/-- T3.8e helper: the data of a special step: the owner column `P ⌢ [(p, C ⌢ [[(a, ∅)]])]` at the
end of the route at depth `ℓ - 1`, and all outputs. -/
theorem special_data_E5 {E : Forest} (hL : InL E) (hk : stepKind E = some .special) :
    ∃ (sd : StopData) (oe : EntryAddr) (P : Column) (p : Nat) (Cs : List Column),
      stopData E = some sd ∧ oe.heightPath = sd.col.path ∧ oe.col.num 0 = sd.r ∧
      1 ≤ sd.depth ∧ KerRoute (sd.depth - 1) E ∧
      replaceAt 0 0 (Tree.node [P ++ [(p, Tree.node (Cs ++ [[(sd.r, Tree.empty)]]))]])
        (sd.depth - 1) E = E ∧
      ∀ n, expand E n = some (replaceAt 0 0 (Tree.node [P ++
        List.replicate (n + if P = [] then 1 else 0) (p, Tree.node Cs)]) (sd.depth - 1) E) := by
  obtain ⟨hV, hI, -, -, -⟩ := hL
  have hE : E ≠ Tree.empty := by
    rintro rfl; simp [stepKind, stepKindBody, Tree.empty, Tree.cols] at hk
  obtain ⟨sd, hsd⟩ := Option.isSome_iff_exists.1 (stopData_of_stepKind hk (by decide))
  obtain ⟨oe, hoe⟩ := Option.isSome_iff_exists.1 (ownerEntry_of_special hk hsd)
  obtain ⟨-, hhp, hnum, col, p, Fl, hcol, hlast, -, hFl⟩ := ownerEntry_spec hk hsd hoe
  obtain ⟨sd', hsd', hspec⟩ := (stepKind_special_iff E).1 hk
  rw [hsd] at hsd'; cases hsd'
  have hdpos : 0 < sd.depth := by
    unfold specialStop at hspec
    simp only [Bool.and_eq_true, decide_eq_true_eq] at hspec
    exact hspec.1.1
  obtain ⟨P, hP⟩ := List.getLast?_eq_some_iff.1 hlast
  obtain ⟨Cs, hCs⟩ := List.getLast?_eq_some_iff.1 hFl
  obtain ⟨-, hdep, -, hmem, -, -⟩ := stopData_spec hsd
  obtain ⟨hrp, -⟩ := (mem_routeCols_iff E sd.col).1 hmem
  rw [← hhp] at hrp hdep
  have hrpπ : IsRoutePath E oe.col.path := by
    intro d hd
    obtain ⟨F, hF, hFl'⟩ := hrp d (by simp [EntryAddr.heightPath]; omega)
    refine ⟨F, ?_, ?_⟩
    · rw [EntryAddr.heightPath, List.take_append_of_le_length (le_of_lt hd)] at hF; exact hF
    · rw [EntryAddr.heightPath, List.getElem?_append_left hd] at hFl'; exact hFl'
  obtain ⟨G, hG, hGl⟩ := hrp oe.col.path.length (by simp [EntryAddr.heightPath])
  simp only [EntryAddr.heightPath, List.take_left', List.getElem?_append_right (le_refl _),
    Nat.sub_self, List.getElem?_cons_zero] at hG hGl
  obtain ⟨colL, q', h', hcolL, -, hs, -⟩ := lastStep?_eq_some hGl
  simp only [Prod.mk.injEq] at hs
  obtain ⟨hs1, -⟩ := hs
  have hcc : col = colL := by
    rw [Tree.colAt, hG, Option.bind_some, hs1, ← List.getLast?_eq_getElem?, hcolL] at hcol
    exact (Option.some.inj hcol).symm
  subst hcc
  have hlen : oe.col.path.length = sd.depth - 1 := by
    simp [EntryAddr.heightPath] at hdep; omega
  have hGne : G.cols ≠ [] := by intro h0; rw [h0] at hcolL; cases hcolL
  have hself := spx_put_self oe.col.path E G hrpπ hG hGne
  rw [hcolL, Option.getD_some, hlen, hP] at hself
  obtain ⟨G0, hG0, hR⟩ := ker_route_of_stop hsd 0 (Nat.zero_le _)
  simp only [List.take_zero, Tree.forestAt, Option.some.injEq] at hG0
  subst hG0
  have hR' : KerRoute (sd.depth - 1) E :=
    ker_route_pred _ _ (by rw [show sd.depth - 1 + 1 = sd.depth - 0 by omega]; exact hR)
  refine ⟨sd, oe, P, p, Cs, hsd, hhp, hnum, hdpos, hR', ?_, ?_⟩
  · have hFl2 : Fl = Tree.node (Cs ++ [[(sd.r, Tree.empty)]]) := by
      obtain ⟨fc⟩ := Fl
      simp only [Tree.cols] at hCs
      rw [hCs]
    rw [← hFl2]; exact hself
  · intro n
    rw [expand_eq_paperOp hE hV hI, paperOp_special hk hsd hoe hcol hlast n, Hole.fill_zero]
    have hFd : Tree.node Fl.cols.dropLast = Tree.node Cs := by rw [hCs, List.dropLast_concat]
    have hPd : (P ++ [(p, Fl)]).dropLast = P := List.dropLast_concat
    rw [hP, hPd, hFd]
    unfold Hole.put
    congr 4
    simp [List.isEmpty_iff]


/-- T3.8e helper: a list below `X ⌢ [z]` is below `X`, equal to `X`, or continues `X` by an
atom below `z`. -/
theorem split_E5 {β : Type} [LinearOrder β] :
    ∀ (X L : List β) (z : β), L < X ++ [z] →
      L < X ∨ L = X ∨ ∃ y L', L = X ++ y :: L' ∧ y < z
  | [], L, z, h => by
    cases L with
    | nil => exact Or.inr (Or.inl rfl)
    | cons y L' =>
      rw [List.nil_append, List.cons_lt_cons_iff] at h
      rcases h with h | ⟨rfl, h⟩
      · exact Or.inr (Or.inr ⟨y, L', rfl, h⟩)
      · exact absurd h (List.not_lt_nil _)
  | x :: X, L, z, h => by
    cases L with
    | nil => exact Or.inl (List.nil_lt_cons _ _)
    | cons l L' =>
      rw [List.cons_append, List.cons_lt_cons_iff] at h
      rcases h with h | ⟨rfl, h⟩
      · exact Or.inl (List.cons_lt_cons_iff.2 (Or.inl h))
      · rcases split_E5 X L' z h with h | h | ⟨y, L'', rfl, hy⟩
        · exact Or.inl (List.cons_lt_cons_iff.2 (Or.inr ⟨rfl, h⟩))
        · exact Or.inr (Or.inl (by rw [h]))
        · exact Or.inr (Or.inr ⟨y, L'', rfl, hy⟩)


theorem lt_append_of_lt_E5 {β : Type} [LinearOrder β] {L X : List β} (h : L < X) (T : List β) :
    L < X ++ T :=
  lt_of_lt_of_le h (not_lt.1 (list_not_lt_prefix (List.prefix_append X T)))


/-- T3.8e helper: a column all of whose entries are at most `x` is below `|R| + 1` copies of `x`. -/
theorem cmpCol_replicate_E5 (x : Nat × Forest) :
    ∀ (R : Column) (m : Nat), (∀ y ∈ R, EntryLe y x) → R.length < m →
      Tree.cmpCol compare R (List.replicate m x) = .lt
  | [], m, _, hm => by
    obtain ⟨m, rfl⟩ : ∃ m', m = m' + 1 := ⟨m - 1, by omega⟩
    rfl
  | (q, H) :: R, m, hR, hm => by
    obtain ⟨m, rfl⟩ : ∃ m', m = m' + 1 := ⟨m - 1, by simp at hm; omega⟩
    obtain ⟨p, C⟩ := x
    have hx := hR (q, H) (by simp)
    rw [List.replicate_succ]
    simp only [Tree.cmpCol]
    rcases hx with h | ⟨h1, h2⟩
    · simp only at h
      rw [Nat.compare_eq_lt.2 h]; rfl
    · simp only at h1 h2
      rw [h1, Nat.compare_eq_eq.2 rfl]
      rcases lt_or_eq_of_le h2 with h2 | rfl
      · have : Tree.cmp compare H C = .lt := h2
        rw [this]; rfl
      · rw [Tree.cmp_self compare H]
        exact cmpCol_replicate_E5 (p, H) R m (fun y hy => hR y (by simp [hy])) (by simp at hm; omega)


theorem len_wordCol_ge_E5 (e : Nat) : ∀ (D : Column), D.length ≤ (wordCol e D).length
  | [] => by simp
  | (p, h) :: D => by
    have : ∀ l : Column, l.length ≤ (wordLater e l).length := by
      intro l
      induction l with
      | nil => simp
      | cons x l ih => obtain ⟨q, h'⟩ := x; simp [wordLater]; omega
    have := this D
    simp [wordCol]; omega

-- T3.8e (txt:500-503): special steps cover within the bound
theorem special_cover {E B : Forest} (hL : InL E) (hB : InL B) (hk : stepKind E = some .special)
    (hlt : B < E) : ∃ n E', 1 ≤ n ∧ n ≤ mu B + 1 ∧ expand E n = some E' ∧ B < E' := by
  obtain ⟨sd, oe, P, p, Cs, hsd, hhp, hnum, hdpos, hR, hself, hexp⟩ := special_data_E5 hL hk
  obtain ⟨e, he⟩ : ∃ e, sd.depth - 1 = e := ⟨_, rfl⟩
  rw [he] at hR hself hexp
  have hde : sd.depth = e + 1 := by omega
  have hwZ : ∀ Z, word (replaceAt 0 0 Z e E) =
      word (replaceAt 0 0 Tree.empty e E) ++ wordAt e Z := by
    intro Z; unfold word; rw [ker_wordAt_replaceAt Z e E 0 hR, Nat.zero_add]
  set W := word (replaceAt 0 0 Tree.empty e E) with hW
  have hw1 : ∀ c : Column, wordAt e (Tree.node [c]) = wordCol e c := by
    intro c; simp [wordAt, wordCols]
  set C : Forest := Tree.node Cs with hC
  set X := W ++ wordCol e (P ++ [(p, C)]) with hX
  set z : WordAtom := toLex (2 * (e + 1), toLex (1, sd.r)) with hz
  have hsplitC : ∀ (H : Forest) (R : Column), wordCol e (P ++ (p, H) :: R) =
      wordCol e (P ++ [(p, Tree.empty)]) ++ wordAt (e + 1) H ++ wordLater e R :=
    fun H R => wordCol_split_E5 e P p H R
  have hXC : wordCol e (P ++ [(p, C)]) = wordCol e (P ++ [(p, Tree.empty)]) ++ wordAt (e + 1) C := by
    rw [hsplitC]; simp [wordLater]
  have hwE : word E = X ++ [z] := by
    conv_lhs => rw [← hself]
    rw [hwZ, hw1, hsplitC, hX, hXC]
    simp [wordLater, wordAt, wordCols_append, wordCols, wordCol, Tree.empty, hz, List.append_assoc]
    rfl
  have hwN : ∀ M, word (replaceAt 0 0 (Tree.node [P ++ List.replicate (M + 1) (p, C)]) e E) =
      X ++ wordLater e (List.replicate M (p, C)) := by
    intro M
    rw [hwZ, hw1, List.replicate_succ, hsplitC, hX, hXC]
    simp only [List.append_assoc]
  have hBE : word B < X ++ [z] := by rw [← hwE, word_lt_iff]; exact hlt
  set ε := if P = [] then 1 else 0 with hε
  rcases split_E5 X (word B) z hBE with h | h | ⟨y, L', hBw, hyz⟩
  · -- `w(B) < X`
    refine ⟨1, _, le_rfl, by omega, hexp 1, ?_⟩
    rw [← word_lt_iff, show 1 + ε = ε + 1 by omega, hwN]
    exact lt_append_of_lt_E5 h _
  · -- `w(B) = X`
    have hmu : 1 ≤ mu B := by
      unfold mu; rw [h, hX, List.length_append]
      have := List.length_pos_of_ne_nil (wordCol_ne_nil_E5 e (P ++ [(p, C)])); omega
    refine ⟨if P = [] then 1 else 2, _, by split_ifs <;> omega, by split_ifs <;> omega,
      hexp _, ?_⟩
    have h2 : (if P = [] then 1 else 2) + ε = 1 + 1 := by rw [hε]; split_ifs <;> rfl
    rw [← word_lt_iff, h2, hwN, h]
    apply ker_lt_append
    simp [wordLater]
  · by_cases hdeep : 2 * (e + 1) ≤ (ofLex y).1
    · -- a column start at depth `ℓ` would break `I` of `B`
      exfalso
      have hBX : (word B).take X.length = X := by rw [hBw, List.take_left]
      have hBy : (word B)[X.length]? = some y := by rw [hBw]; simp
      obtain ⟨c, k, hc, hk', -, hk0, -, hup, hcap⟩ :=
        exists_litCap_of_word (B := B) (E := E) (π := X.length) (e := e + 1) (p := sd.r)
          (first := true) (by rw [hBX]; simpa [hz] using hwE)
          (by unfold mu; rw [hBw]; simp)
          (by intro y' hy'; rw [hBy] at hy'; cases hy'; simpa [hz] using hyz)
          (fun _ => ⟨y, hBy, hdeep⟩)
      have hk00 : k = 0 := hk0.2 rfl
      subst hk00
      have hsd2 := stopData_litCap hup
      rw [hcap, hsd] at hsd2
      have hcolE : sd.col = c := congrArg StopData.col (Option.some.inj hsd2)
      obtain ⟨colc, hcolc⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff B c).1 hc)
      have hup' := hup
      unfold IsUpward at hup'
      rw [hcolc] at hup'
      have hcolc' := hcolc
      unfold Tree.colAt at hcolc'
      rw [← hcolE, ← hhp, Tree.forestAt_heightPath] at hcolc'
      cases hH : B.heightAt oe with
      | none => rw [hH] at hcolc'; cases hcolc'
      | some h₀ =>
        rw [hH, Option.bind_some] at hcolc'
        obtain ⟨y₀, hy₀⟩ : ∃ y₀, B.entryAt oe = some (y₀, h₀) := by
          unfold Tree.heightAt at hH
          cases hE0 : B.entryAt oe with
          | none => rw [hE0] at hH; cases hH
          | some x =>
            rw [hE0] at hH
            simp only [Option.map_some, Option.some.injEq] at hH
            exact ⟨x.1, by rw [← hH]⟩
        have hmem : oe ∈ B.entryAddrs := (Tree.mem_entryAddrs_iff _ _).2 (by rw [hy₀]; rfl)
        have hne : h₀ ≠ Tree.empty := by
          intro h0; subst h0; simp [Tree.empty, Tree.cols] at hcolc'
        obtain ⟨q, H, rest, hcq, hq⟩ :=
          hB.2.1 _ hmem y₀ h₀ hy₀ hne colc (List.mem_of_getElem? hcolc')
        rw [hcq] at hup'
        simp only [List.getElem?_cons_zero] at hup'
        rw [hnum] at hq
        omega
    · -- the next atom is at most an entry continuation of the owner column
      have hBX : (word B).take X.length = X := by rw [hBw, List.take_left]
      have hBy : (word B)[X.length]? = some y := by rw [hBw]; simp
      set pb := (ofLex (ofLex y).2).2 + 1 with hpb
      have hy1 : y < toLex (2 * e + 1, toLex (0, pb)) := by
        have hwf := word_wf B y (by rw [hBw]; simp)
        rw [Prod.Lex.lt_iff]
        simp only [ofLex_toLex]
        by_cases hy1 : (ofLex y).1 < 2 * e + 1
        · exact Or.inl hy1
        · right
          refine ⟨by omega, ?_⟩
          rw [Prod.Lex.lt_iff]
          simp only [ofLex_toLex]
          unfold WordAtom.WF at hwf
          right
          refine ⟨by omega, by omega⟩
      set E' := replaceAt 0 0 (Tree.node [P ++ [(p, C), (pb, Tree.empty)]]) e E with hE'
      have hwE' : word E' = X ++ [toLex (2 * e + 1, toLex (0, pb))] := by
        rw [hE', hwZ, hw1, show P ++ [(p, C), (pb, Tree.empty)] = P ++ (p, C) :: [(pb, Tree.empty)]
          from rfl, hsplitC, hX, hXC]
        simp [wordLater, wordAt, wordCols, Tree.empty, List.append_assoc]
      obtain ⟨c', k', hc', hk', hdep', hk0', -, hup', hcap'⟩ :=
        exists_litCap_of_word (B := B) (E := E') (π := X.length) (e := e) (p := pb)
          (first := false) (by rw [hBX]; simpa using hwE')
          (by unfold mu; rw [hBw]; simp)
          (by intro y' hy'; rw [hBy] at hy'; cases hy'; simpa using hy1)
          (fun h => absurd h (by decide))
      have hk'0 : k' ≠ 0 := fun h => absurd (hk0'.1 h) (by decide)
      -- the cap column of `B` is the hole of the special step
      have hsdE' := stopData_litCap hup'
      rw [hcap'] at hsdE'
      obtain ⟨hRE', hhole⟩ := ker_stop_hole hsdE'
      simp only at hhole
      rw [hdep', hE', kerHoleAt_replaceAt_E5 _ e E hR] at hhole
      obtain ⟨hcolE', -⟩ := stopData_spec hsdE'
      simp only at hcolE'
      have hlaw := (ker_hole_law (Tree.node [P ++ [(p, C), (pb, Tree.empty)]]) hR ⟨[], 0⟩).1
      have hu : underCol (kerHoleAt e E) ⟨[], 0⟩ = kerHoleAt e E := by
        simp [underCol]
      rw [hu, hhole] at hlaw
      rw [← hE', hcolE'] at hlaw
      simp only [Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols, List.getElem?_cons_zero,
        Option.some.injEq] at hlaw
      have htk : ((B.colAt c').getD []).take k' = P ++ [(p, C)] := by
        have := hlaw
        rw [show P ++ [(p, C), (pb, Tree.empty)] = (P ++ [(p, C)]) ++ [(pb, Tree.empty)] by simp]
          at this
        exact List.append_cancel_right this
      -- the word of `B` around its cap column
      obtain ⟨A, S, hwB, hS, hcapB⟩ := wordDecomp_E5 hc'
      obtain ⟨D, hD⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff B c').1 hc')
      rw [hD, Option.getD_some] at htk
      have hAW : A = W := by
        have h1 := hcapB k' pb
        rw [hcap', hD, Option.getD_some, htk, hwE', hdep'] at h1
        rw [hX, hXC] at h1
        have h2 : wordCol e (P ++ [(p, C)] ++ [(pb, Tree.empty)]) =
            wordCol e (P ++ [(p, Tree.empty)]) ++ wordAt (e + 1) C ++
              [toLex (2 * e + 1, toLex (0, pb))] := by
          rw [show P ++ [(p, C)] ++ [(pb, Tree.empty)] = P ++ (p, C) :: [(pb, Tree.empty)] by simp,
            hsplitC]
          simp [wordLater, wordAt, wordCols, Tree.empty]
        rw [h2] at h1
        simp only [List.append_assoc] at h1
        exact (List.append_cancel_right h1).symm
      obtain ⟨R, hRl⟩ := localSuffix_eq_E5 hD
      rw [hAW, hRl, map_depthShift_word_E5, hdep'] at hwB
      -- `D = P ⌢ (p, C) ⌢ R_B` with every entry of `R_B` at most `(p, C)` (H)
      have hDsplit : D = P ++ (p, C) :: D.drop k' := by
        conv_lhs => rw [← List.take_append_drop k' D, htk]
        simp
      have hk'le : k' ≤ D.length := by rw [hD, Option.getD_some] at hk'; exact hk'
      have hlenP : k' = P.length + 1 := by
        have := congrArg List.length htk
        rw [List.length_take] at this
        simp at this
        omega
      have hHle : ∀ i, P.length ≤ i → ∀ x, D[i]? = some x → EntryLe x (p, C) := by
        intro i hi
        induction i, hi using Nat.le_induction with
        | base =>
          intro x hx
          rw [hDsplit, List.getElem?_append_right (le_refl _), Nat.sub_self] at hx
          simp only [List.getElem?_cons_zero, Option.some.injEq] at hx
          subst hx
          exact Or.inr ⟨rfl, le_rfl⟩
        | succ i hi ih =>
          intro x hx
          have hi' : i < D.length := by
            by_contra hh
            rw [List.getElem?_eq_none (by omega)] at hx; cases hx
          have hxi := ih D[i] (List.getElem?_eq_getElem hi')
          have hH := hB.2.2.1 c' hc' i D[i] x (by rw [hD]; exact List.getElem?_eq_getElem hi')
            (by rw [hD]; exact hx)
          rcases hH with h1 | ⟨h1, h2⟩ <;> rcases hxi with h3 | ⟨h3, h4⟩
          · exact Or.inl (lt_trans h1 h3)
          · exact Or.inl (by rw [← h3]; exact h1)
          · exact Or.inl (by rw [h1]; exact h3)
          · exact Or.inr ⟨h1.trans h3, le_trans h2 h4⟩
      have hRB : ∀ x ∈ D.drop k', EntryLe x (p, C) := by
        intro x hx
        obtain ⟨i, hi, hix⟩ := List.mem_iff_getElem.1 hx
        apply hHle (k' + i) (by omega)
        rw [← hix, List.getElem_drop]
        exact List.getElem?_eq_getElem _
      -- choose `N = |R_B| + 2` copies
      set N := (D.drop k').length + 1 with hN
      have hnN : (N + 1 - ε) + ε = N + 1 := by rw [hε]; split_ifs <;> omega
      have hlenD := len_wordCol_ge_E5 e D
      have hmuB : D.length ≤ mu B := by
        unfold mu; rw [hwB]; simp only [wordAt, wordCols, List.length_append]; omega
      refine ⟨N + 1 - ε, _, by rw [hε]; split_ifs <;> omega, ?_, hexp _, ?_⟩
      · have : (D.drop k').length + P.length + 1 = D.length := by
          rw [List.length_drop]; omega
        rw [hε]; split_ifs <;> omega
      · rw [hnN, ← word_lt_iff, hwZ, hw1, hwB, List.append_assoc, ker_append_lt_append_iff]
        conv_rhs => rw [← List.append_nil (wordCol e (P ++ List.replicate (N + 1) (p, C)))]
        rw [← hw1]
        rw [wordAt_append_lt_iff_E5 _ _ _ (fun y hy => word_wf B y (by rw [hwB]; simp [hy]))
          (by simp) (by rw [hdep'] at hS; exact hS) (by simp)]
        left
        show Tree.cmpCols compare (D :: R) [P ++ List.replicate (N + 1) (p, C)] = .lt
        simp only [Tree.cmpCols]
        rw [hDsplit, List.replicate_succ, show P ++ (p, C) :: List.replicate N (p, C) =
          (P ++ [(p, C)]) ++ List.replicate N (p, C) by simp,
          show P ++ (p, C) :: D.drop k' = (P ++ [(p, C)]) ++ D.drop k' by simp,
          ker_cmpCol_append_left]
        rw [cmpCol_replicate_E5 (p, C) _ N hRB (by omega)]
        rfl

/-- T3.8f helper: the words of `B` and of the fillings of a cap of `B` share the prefix `A`. -/
theorem word_context_litCap_E5 {B : Forest} {c : ColAddr} {k p : Nat} (hup : IsUpward B c k p)
    {sd : StopData} (hsd : stopData (litCap B c k p) = some sd) :
    ∃ A S, word B = A ++ wordAt (colDepth c) (localSuffix B c) ++ S ∧
      (∀ y ∈ S.head?, (ofLex y).1 < 2 * colDepth c) ∧ (∀ y ∈ S, y.WF) ∧
      capPos B c 0 = A.length ∧ sd.depth = colDepth c ∧
      sd.Q = ((B.colAt c).getD []).take k ∧ sd.r = p ∧ sd.col = c ∧
      (∀ k' p', word (litCap B c k' p') =
        A ++ wordCol (colDepth c) (((B.colAt c).getD []).take k' ++ [(p', Tree.empty)])) ∧
      ∀ Z, word (context (litCap B c k p) sd Z) = A ++ wordAt (colDepth c) Z := by
  have hc : c ∈ B.colAddrs := by
    rw [Tree.mem_colAddrs_iff]
    unfold IsUpward at hup
    split at hup
    · rename_i col hcol; rw [hcol]; rfl
    · exact hup.elim
  obtain ⟨A, S, hw, hS, hcap⟩ := wordDecomp_E5 hc
  have hsdE : sd = ⟨colDepth c, c, c.num 0, p, ((B.colAt c).getD []).take k⟩ :=
    Option.some.inj (hsd.symm.trans (stopData_litCap hup))
  have hdep : sd.depth = colDepth c := by rw [hsdE]
  have hQ : sd.Q = ((B.colAt c).getD []).take k := by rw [hsdE]
  have hr : sd.r = p := by rw [hsdE]
  have hcol : sd.col = c := by rw [hsdE]
  have hK : context (litCap B c k p) sd (Tree.node [sd.Q ++ [(sd.r, Tree.empty)]])
      = litCap B c k p := by
    obtain ⟨G, hG, hR⟩ := ker_routeTo_of_stop hsd 0 (Nat.zero_le _)
    simp only [List.take_zero, Tree.forestAt, Option.some.injEq] at hG
    subst hG
    exact ker_replaceAt_self _ _ _ hR
  have h0 := word_context hsd (Tree.node [sd.Q ++ [(sd.r, Tree.empty)]])
  rw [hK, hcap k p, hQ, hr, hdep, map_depthShift_word_E5] at h0
  have h1 : wordAt (colDepth c) (Tree.node [((B.colAt c).getD []).take k ++ [(p, Tree.empty)]]) =
      wordCol (colDepth c) (((B.colAt c).getD []).take k ++ [(p, Tree.empty)]) := by
    simp [wordAt, wordCols]
  rw [h1] at h0
  have hA := List.append_cancel_right h0
  refine ⟨A, S, ?_, hS, ?_, capPos_zero_E5 hcap, hdep, hQ, hr, hcol, hcap, ?_⟩
  · rw [hw, map_depthShift_word_E5]
  · intro y hy
    apply word_wf B y
    rw [hw]; simp [hy]
  · intro Z
    rw [word_context hsd, ← hA, hdep, map_depthShift_word_E5]


/-- T3.8f helper (step 3): `B < C_K(Z)` iff the complete local suffix is below `Z`. -/
theorem lt_context_iff_E5 {B : Forest} {c : ColAddr} {k p : Nat} (hup : IsUpward B c k p)
    {sd : StopData} (hsd : stopData (litCap B c k p) = some sd) (Z : Forest) :
    B < context (litCap B c k p) sd Z ↔ localSuffix B c < Z := by
  obtain ⟨A, S, hw, hS, hSw, -, -, -, -, -, -, hC⟩ := word_context_litCap_E5 hup hsd
  rw [← word_lt_iff, hw, hC Z, List.append_assoc, ker_append_lt_append_iff]
  conv_lhs => rw [← List.append_nil (wordAt (colDepth c) Z)]
  rw [wordAt_append_lt_iff_E5 _ _ _ hSw (by simp) hS (by simp)]
  simp


/-- T3.8f helper: an ordinary `L` expression has a defined kernel. -/
theorem kernelDefined_of_inL_E5 {E : Forest} (hL : InL E) (hk : stepKind E = some .ordinary)
    {sd : StopData} {rd : RootData} (hsd : stopData E = some sd) (hrd : rootData E = some rd) :
    KernelDefined E rd := by
  have hE : E ≠ Tree.empty := by
    intro h; subst h
    simp [stopData, stopDataBody, stopF, stopCols, Tree.empty] at hsd
  by_contra h
  have := (expand_none_iff hE hL.1 hL.2.1 hk hsd hrd 1).2 ⟨le_rfl, h⟩
  have h2 := expand_isSome hL.1 hL.2.1 hL.2.2.2.1 hL.2.2.2.2 1
  rw [this] at h2
  cases h2


theorem litCap_ne_empty_E5 {B : Forest} {c : ColAddr} {k p : Nat} (hup : IsUpward B c k p) :
    litCap B c k p ≠ Tree.empty := by
  have hsd := stopData_litCap hup
  intro h; rw [h] at hsd; simp [stopData, stopDataBody, stopF, stopCols, Tree.empty] at hsd

-- T3.8f: covering is kernel success at the complete local suffix (word criterion + context)
theorem covers_iff_success {B : Forest} {c : ColAddr} {k p : Nat} (hB : CondI B)
    (hup : IsUpward B c k p) (hKV : CondV (litCap B c k p)) (hKI : CondI (litCap B c k p))
    (hdef : ∀ rd, rootData (litCap B c k p) = some rd → KernelDefined (litCap B c k p) rd) :
    Covers (litCap B c k p) B ↔ Success (litCap B c k p) (localSuffix B c) := by
  have hord := litCap_ordinary hB hup hKV hKI
  obtain ⟨rd, hrd⟩ := Option.isSome_iff_exists.1 (rootData_of_ordinary hord)
  obtain ⟨sd, hsd⟩ : ∃ sd, stopData (litCap B c k p) = some sd := ⟨_, stopData_litCap hup⟩
  have hkd := hdef rd hrd
  have hKne := litCap_ne_empty_E5 hup
  have hP := kerPrefix_ne_nil (litCap B c k p) sd rd
  have hSig := kerSigma_strictMono sd rd
  constructor
  · rintro ⟨q, K', hK', hBK'⟩
    rw [expand_eq_iterate hKne hKV hKI hord hsd hrd hkd] at hK'
    cases hK'
    rw [lt_context_iff_E5 hup hsd] at hBK'
    refine ⟨_, rd, hsd, hrd, hkd, ?_⟩
    rw [← word_lt_iff, word_kernel hKV hsd hrd hkd]
    rw [← word_lt_iff, ker_word_iterate hKV hsd hrd hkd] at hBK'
    exact (word_criterion _ hP hSig _).2 ⟨q, hBK'⟩
  · rintro ⟨sd', rd', hsd', hrd', -, h⟩
    rw [hsd] at hsd'; cases hsd'
    rw [hrd] at hrd'; cases hrd'
    rw [← word_lt_iff, word_kernel hKV hsd hrd hkd] at h
    obtain ⟨q, hq⟩ := (word_criterion _ hP hSig _).1 h
    refine ⟨q, _, expand_eq_iterate hKne hKV hKI hord hsd hrd hkd q, ?_⟩
    rw [lt_context_iff_E5 hup hsd, ← word_lt_iff, ker_word_iterate hKV hsd hrd hkd]
    exact hq

-- T3.8f: the explicit bound
theorem covers_bound {B : Forest} {c : ColAddr} {k p : Nat} (hB : CondI B)
    (hup : IsUpward B c k p) (hKL : InL (litCap B c k p))
    (h : Success (litCap B c k p) (localSuffix B c)) :
    ∃ q K', 1 ≤ q ∧ q ≤ mu B + 1 ∧ expand (litCap B c k p) q = some K' ∧ B < K' := by
  obtain ⟨sd, rd, hsd, hrd, hkd, hlt⟩ := h
  have hord := litCap_ordinary hB hup hKL.1 hKL.2.1
  have hKne := litCap_ne_empty_E5 hup
  have hP := kerPrefix_ne_nil (litCap B c k p) sd rd
  have hSig := kerSigma_strictMono sd rd
  obtain ⟨A, S, hw, -, -, -, -, -, -, -, -, -⟩ := word_context_litCap_E5 hup hsd
  have hmuY : mu (localSuffix B c) ≤ mu B := by
    unfold mu
    rw [hw, ← map_depthShift_word_E5]
    simp only [List.length_append, List.length_map]
    omega
  refine ⟨mu (localSuffix B c) + 1, _, by omega, by omega,
    expand_eq_iterate hKne hKL.1 hKL.2.1 hord hsd hrd hkd _, ?_⟩
  rw [lt_context_iff_E5 hup hsd, ← word_lt_iff, ker_word_iterate hKL.1 hsd hrd hkd]
  rw [← word_lt_iff, word_kernel hKL.1 hsd hrd hkd] at hlt
  apply cover_of_success _ hP hSig hlt
  have := List.length_pos_of_ne_nil hP
  rw [Nat.succ_mul]
  unfold mu
  have : (word (localSuffix B c)).length ≤ (word (localSuffix B c)).length * (kerPrefix (litCap B c k p) sd rd).length :=
    Nat.le_mul_of_pos_right _ this
  omega

/-- L3.4f helper: a cap with a nonempty query is ordinary (no `I` of the target needed). -/
theorem litCap_ordinary_of_ne_E5 {B : Forest} {c : ColAddr} {k p : Nat} (hup : IsUpward B c k p)
    (hKV : CondV (litCap B c k p)) (hQ : ((B.colAt c).getD []).take k ≠ []) :
    stepKind (litCap B c k p) = some .ordinary := by
  have hsd := stopData_litCap hup
  rw [stepKind_ordinary_iff]
  have hres : (c.resolve 0 p).isSome := by
    obtain ⟨hcolK, -⟩ := stopData_spec hsd
    have hent : (litCap B c k p).entryAt ⟨c, (((B.colAt c).getD []).take k).length⟩ =
        some (p, Tree.empty) := by
      unfold Tree.entryAt; rw [hcolK]; simp
    have hmemK := (Tree.mem_entryAddrs_iff _ _).2 (by rw [hent]; rfl)
    exact hKV _ hmemK p Tree.empty hent
  obtain ⟨o, ho⟩ := Option.isSome_iff_exists.1 hres
  refine ⟨_, o, hsd, ?_, ho⟩
  have h2 : (List.take k ((Tree.colAt B c).getD [])).isEmpty = false := by
    cases h : List.take k ((Tree.colAt B c).getD []) with
    | nil => exact absurd h hQ
    | cons _ _ => rfl
  unfold specialStop
  simp only [h2, Bool.and_false, Bool.false_and]


theorem wordCols_eq_nil_E5 {e : Nat} {cs : List Column} (h : wordCols e cs = []) : cs = [] := by
  cases cs with
  | nil => rfl
  | cons c cs =>
    simp only [wordCols, List.append_eq_nil_iff] at h
    exact absurd h.1 (wordCol_ne_nil_E5 e c)


theorem wordLater_eq_nil_E5 {e : Nat} {c : Column} (h : wordLater e c = []) : c = [] := by
  cases c with
  | nil => rfl
  | cons x c => obtain ⟨p, h'⟩ := x; simp [wordLater] at h

-- L3.4f (txt:428-429, 436-437): a full cut at the end of the target succeeds
theorem fullCut_success {B : Forest} {c : ColAddr} {k p : Nat} (hup : IsUpward B c k p)
    (hKL : InL (litCap B c k p)) (hend : capPos B c k = mu B) :
    Success (litCap B c k p) (localSuffix B c) := by
  obtain ⟨sd, hsd⟩ : ∃ sd, stopData (litCap B c k p) = some sd := ⟨_, stopData_litCap hup⟩
  obtain ⟨A, S, hw, hS, hSw, hcp0, hdep, hQ, hr, hcolc, hcap, hC⟩ := word_context_litCap_E5 hup hsd
  have hcp := capPos_eq_E5 hcap k
  rw [len_capCol_E5] at hcp
  have hc : (B.colAt c).isSome := by
    unfold IsUpward at hup
    split at hup
    · rename_i col hcol; rw [hcol]; rfl
    · exact hup.elim
  obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 hc
  have hcol' := hcol
  unfold Tree.colAt at hcol'
  obtain ⟨G, hG⟩ : ∃ G, B.forestAt c.path = some G := by
    cases h : B.forestAt c.path with
    | none => rw [h] at hcol'; cases hcol'
    | some G => exact ⟨G, rfl⟩
  rw [hG, Option.bind_some] at hcol'
  have hj : c.col < G.cols.length := by
    by_contra hh; rw [List.getElem?_eq_none (by omega)] at hcol'; cases hcol'
  have hY : localSuffix B c = Tree.node (col :: G.cols.drop (c.col + 1)) := by
    unfold localSuffix
    rw [hG, Option.getD_some, List.drop_eq_getElem_cons hj]
    obtain ⟨_, h⟩ := List.getElem?_eq_some_iff.1 hcol'
    rw [h]
  rw [hcol, Option.getD_some] at hcp hQ
  have hmu : mu B = A.length + (wordCol (colDepth c) col).length +
      (wordCols (colDepth c) (G.cols.drop (c.col + 1))).length + S.length := by
    unfold mu; rw [hw, hY]; simp only [wordAt, wordCols, List.length_append]; omega
  have hne : col.take k ≠ [] := by
    intro h
    rw [if_pos h] at hcp
    have := List.length_pos_of_ne_nil (wordCol_ne_nil_E5 (colDepth c) col)
    omega
  rw [if_neg hne] at hcp
  have hwc : wordCol (colDepth c) col =
      wordCol (colDepth c) (col.take k) ++ wordLater (colDepth c) (col.drop k) := by
    conv_lhs => rw [← List.take_append_drop k col]
    exact ker_wordCol_append _ hne _
  have hlen := congrArg List.length hwc
  rw [List.length_append] at hlen
  have hR : G.cols.drop (c.col + 1) = [] := by
    apply wordCols_eq_nil_E5 (e := colDepth c)
    apply List.eq_nil_of_length_eq_zero
    omega
  have hD : col.drop k = [] := by
    apply wordLater_eq_nil_E5 (e := colDepth c)
    apply List.eq_nil_of_length_eq_zero
    omega
  have htk : col.take k = col := by
    conv_rhs => rw [← List.take_append_drop k col, hD, List.append_nil]
  rw [hR] at hY
  rw [htk] at hQ hne
  have hord := litCap_ordinary_of_ne_E5 hup hKL.1 (by rw [hcol, Option.getD_some, htk]; exact hne)
  obtain ⟨rd, hrd⟩ := Option.isSome_iff_exists.1 (rootData_of_ordinary hord)
  have hkd := kernelDefined_of_inL_E5 hKL hord hsd hrd
  refine ⟨_, rd, hsd, hrd, hkd, ?_⟩
  rw [← word_lt_iff, word_kernel hKL.1 hsd hrd hkd, hY]
  unfold kerPrefix
  obtain ⟨V, cs, hk⟩ := kernel_firstCol_E5 (litCap B c k p) _ rd Tree.empty
  rw [hk, hQ]
  have hw0 : word (Tree.node [col]) = wordCol 0 col := by simp [word, wordAt, wordCols]
  rw [hw0]
  show wordCol 0 col < wordCols 0 ((col ++ V) :: cs) ++ _
  simp only [wordCols]
  rw [ker_wordCol_append 0 hne, List.append_assoc, List.append_assoc]
  apply ker_lt_append
  intro h
  rw [List.append_eq_nil_iff, List.append_eq_nil_iff, List.map_eq_nil_iff] at h
  exact wordCol_ne_nil_E5 0 col h.2.2

-- T3.8h (txt:511-512): a cap above a covered old target is covered
theorem covers_of_gt {A B K : Forest} (hcof : Cof A) (hKL : InL K) (hKne : K ≠ Tree.empty)
    (hlast : K.cols.getLast? ≠ some []) (hAK : A < K) (hBA : B ≤ A)
    (hK0 : ∀ K0, expand K 0 = some K0 → K0 < B) : Covers K B := by
  obtain ⟨n, K', hK', hAK', -⟩ := hcof K hKL hAK
  rcases lt_or_ge B K' with h | h
  · exact ⟨n, K', hK', h⟩
  · have hBK' : B = K' := le_antisymm (hBA.trans hAK') h
    rcases Nat.eq_zero_or_pos n with rfl | _
    · exact absurd (hK0 K' hK') (by rw [hBK']; exact lt_irrefl _)
    · obtain ⟨K'', hK''⟩ := Option.isSome_iff_exists.1
        (expand_isSome hKL.1 hKL.2.1 hKL.2.2.2.1 hKL.2.2.2.2 (n + 1))
      exact ⟨n + 1, K'', hK'', hBK' ▸ expand_strictMono hKL hlast hKne (Nat.lt_succ_self n) hK' hK''⟩

theorem not_lt_empty_E5 (X : Forest) : ¬ X < Tree.empty := by
  by_cases h : X = Tree.empty
  · rw [h]; exact lt_irrefl _
  · exact fun h' => lt_asymm h' (Forest.empty_lt h)


theorem mu_pos_E5 {X : Forest} (h : X ≠ Tree.empty) : 1 ≤ mu X := by
  obtain ⟨cols⟩ := X
  cases cols with
  | nil => exact absurd rfl h
  | cons c cs =>
    unfold mu word
    simp only [wordAt, wordCols, List.length_append]
    have := List.length_pos_of_ne_nil (wordCol_ne_nil_E5 0 c)
    omega

-- T3.8g: kernel success for all caps gives cofinality with the bound
theorem bound_of_KS {B E : Forest} (hB : InL B) (hKS : KS B) (hE : InL E) (hlt : B < E)
    (hlast : E.cols.getLast? ≠ some []) :
    ∃ n E', 1 ≤ n ∧ n ≤ mu B + 1 ∧ expand E n = some E' ∧ B < E' := by
  have hEne : E ≠ Tree.empty := by rintro rfl; exact not_lt_empty_E5 B hlt
  have hdef := fun n => Option.isSome_iff_exists.1
    (expand_isSome hE.1 hE.2.1 hE.2.2.2.1 hE.2.2.2.2 n)
  obtain ⟨E0, hE0⟩ := hdef 0
  obtain ⟨E1, hE1⟩ := hdef 1
  have h01 := expand_strictMono hE hlast hEne Nat.zero_lt_one hE0 hE1
  rcases lt_trichotomy B E1 with h | h | h
  · exact ⟨1, E1, le_rfl, by omega, hE1, h⟩
  · obtain ⟨E2, hE2⟩ := hdef 2
    have h12 := expand_strictMono hE hlast hEne (by omega : 1 < 2) hE1 hE2
    have hBne : B ≠ Tree.empty := by
      rintro rfl; rw [← h] at h01; exact not_lt_empty_E5 _ h01
    have := mu_pos_E5 hBne
    exact ⟨2, E2, by omega, by omega, hE2, h ▸ h12⟩
  · obtain ⟨knd, hknd⟩ := Option.isSome_iff_exists.1 (stepKind_isSome hEne hE.1 hE.2.1)
    cases knd with
    | deletion => exact absurd ((stepKind_deletion_iff E).1 hknd) hlast
    | special => exact special_cover hE hB hknd hlt
    | ordinary =>
      obtain ⟨sd, hsd⟩ := Option.isSome_iff_exists.1 (stopData_of_stepKind hknd (by decide))
      obtain ⟨hup, hcap⟩ := ordinary_cap_of_between hE hknd hsd hE1 h hlt
      have hKL : InL (litCap B sd.col sd.Q.length sd.r) := hcap ▸ hE
      have hcov := hKS _ _ _ hup hKL
      have hsucc := (covers_iff_success hB.2.1 hup hKL.1 hKL.2.1
        (fun rd hrd => kernelDefined_of_inL_E5 hKL (hcap ▸ hknd) (hcap ▸ hsd) hrd)).1 hcov
      obtain ⟨q, K', hq1, hq2, hK', hBK'⟩ := covers_bound hB.2.1 hup hKL hsucc
      rw [hcap] at hK'
      exact ⟨q, K', hq1, hq2, hK', hBK'⟩

theorem cof_of_KS {B : Forest} (hB : InL B) (hKS : KS B) : Cof B := by
  intro E hE hlt
  have hEne : E ≠ Tree.empty := by rintro rfl; exact not_lt_empty_E5 B hlt
  by_cases hlast : E.cols.getLast? = some []
  · have hk := (stepKind_deletion_iff E).2 hlast
    have hE0 := expand_deletion hk 0
    refine ⟨0, _, hE0, ?_, expand_lt hEne hE.1 hE.2.1 hE0⟩
    apply le_of_lt_append_empty
    obtain ⟨ys, hys⟩ := List.getLast?_eq_some_iff.1 hlast
    have : E = Tree.node ((Tree.node E.cols.dropLast).cols ++ [[]]) := by
      obtain ⟨cols⟩ := E
      simp only [Tree.cols] at hys ⊢
      rw [hys, List.dropLast_concat]
    rw [← this]; exact hlt
  · obtain ⟨n, E', -, -, hE', hBE'⟩ := bound_of_KS hB hKS hE hlt hlast
    exact ⟨n, E', hE', le_of_lt hBE', expand_lt hEne hE.1 hE.2.1 hE'⟩

/-- T3.8j helper: a cut position lies inside the word. -/
theorem capPos_le_mu_E5 {B : Forest} {c : ColAddr} (hc : c ∈ B.colAddrs) (k : Nat) :
    capPos B c k ≤ mu B := by
  obtain ⟨A, S, hw, -, hcap⟩ := wordDecomp_E5 hc
  have hcp := capPos_eq_E5 hcap k
  rw [len_capCol_E5] at hcp
  obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff B c).1 hc)
  obtain ⟨R, hR⟩ := localSuffix_eq_E5 hcol
  rw [hcol, Option.getD_some] at hcp
  have hmu : mu B = A.length + (wordCol (colDepth c) col).length +
      (wordCols (colDepth c) R).length + S.length := by
    unfold mu; rw [hw, map_depthShift_word_E5, hR]
    simp only [wordAt, wordCols, List.length_append]; omega
  split_ifs at hcp with h
  · omega
  · have hwc : wordCol (colDepth c) col =
        wordCol (colDepth c) (col.take k) ++ wordLater (colDepth c) (col.drop k) := by
      conv_lhs => rw [← List.take_append_drop k col]
      exact ker_wordCol_append _ h _
    have := congrArg List.length hwc
    rw [List.length_append] at this
    omega


/-- T3.8j helper: a literal cap ends in a nonempty column. -/
theorem litCap_last_ne_E5 {B : Forest} {c : ColAddr} {k p : Nat} (hup : IsUpward B c k p) :
    (litCap B c k p).cols.getLast? ≠ some [] := by
  have hc : (B.colAt c).isSome := by
    unfold IsUpward at hup
    split at hup
    · rename_i col hcol; rw [hcol]; rfl
    · exact hup.elim
  obtain ⟨g, gs, hg, x, xs, hlast⟩ := ker_litCapAux_ne k p c.path c.col B hc
  have hK : litCap B c k p = Tree.node (g :: gs) := by
    unfold litCap litCapBody; rw [if_pos hc]; exact hg
  rw [hK]
  show (g :: gs).getLast? ≠ some []
  rw [hlast]; simp


theorem colAddrs_of_upward_E5 {B : Forest} {c : ColAddr} {k p : Nat} (hup : IsUpward B c k p) :
    c ∈ B.colAddrs ∧ k ≤ ((B.colAt c).getD []).length := by
  unfold IsUpward at hup
  split at hup
  · rename_i col hcol
    refine ⟨(Tree.mem_colAddrs_iff B c).2 (by rw [hcol]; rfl), ?_⟩
    rw [hcol, Option.getD_some]
    split at hup
    · rename_i q h hq
      exact le_of_lt (List.getElem?_eq_some_iff.1 hq).1
    · exact le_of_eq hup
  · exact hup.elim


/-- T3.8j helper: a cap of `B` whose cut lies before the end of `B` covers once the old target
`A` (with `w(B) ⊑ w(A)` up to the cut) is covered. -/
theorem covers_of_prefix_E5 {A B : Forest} (hcof : Cof A) (hB : InL B) (hBA : B ≤ A)
    (hpre : ∀ i < mu B, (word A)[i]? = (word B)[i]?)
    {c : ColAddr} {k p : Nat} (hup : IsUpward B c k p) (hKL : InL (litCap B c k p))
    (hlt : capPos B c k < mu B) : Covers (litCap B c k p) B := by
  obtain ⟨hc, hk⟩ := colAddrs_of_upward_E5 hup
  have hAK : A < litCap B c k p := by
    rw [← word_lt_iff, word_litCap hc hk p]
    obtain ⟨y, hy⟩ : ∃ y, (word B)[capPos B c k]? = some y :=
      ⟨_, List.getElem?_eq_getElem hlt⟩
    have hyz := (isUpward_iff_atom hc hk).1 hup y hy
    have hyA : (word A)[capPos B c k]? = some y := by rw [hpre _ hlt]; exact hy
    have htake : (word B).take (capPos B c k) = (word A).take (capPos B c k) := by
      apply List.ext_getElem?
      intro i
      rw [List.getElem?_take, List.getElem?_take]
      split_ifs with hi
      · exact (hpre i (by omega)).symm
      · rfl
    rw [htake]
    have hlenA : capPos B c k < (word A).length := by
      by_contra hh; rw [List.getElem?_eq_none (by omega)] at hyA; cases hyA
    conv_lhs => rw [← List.take_append_drop (capPos B c k) (word A)]
    rw [ker_append_lt_append_iff, List.drop_eq_getElem_cons hlenA]
    have : (word A)[capPos B c k] = y := by
      rw [List.getElem?_eq_getElem hlenA] at hyA; exact Option.some.inj hyA
    rw [this]
    exact List.cons_lt_cons_iff.2 (Or.inl hyz)
  exact covers_of_gt hcof hKL (litCap_ne_empty_E5 hup) (litCap_last_ne_E5 hup) hAK hBA
    (fun K0 h0 => expand_zero_litCap_lt hB.2.1 hup hKL.1 hKL.2.1 h0)


/-- T3.8j helper: a full cut at the end of the target covers it. -/
theorem covers_of_end_E5 {B : Forest} (hB : CondI B) {c : ColAddr} {k p : Nat}
    (hup : IsUpward B c k p) (hKL : InL (litCap B c k p)) (hend : capPos B c k = mu B) :
    Covers (litCap B c k p) B :=
  (covers_iff_success hB hup hKL.1 hKL.2.1 (fun _ hrd => kernelDefined_of_inL_E5 hKL
    (litCap_ordinary hB hup hKL.1 hKL.2.1) (stopData_litCap hup) hrd)).2
    (fullCut_success hup hKL hend)

/-- L3.6a helper: the data of one legal move of an upward literal cap of an `H`-expression: the
moved entry `j` and the target entry `i` of the move column share the parent `q`, the old heights
satisfy `H_j ≤ H_i`, both carry the same internal cap, and `H_i` is below that cap. -/
theorem move_data_G5 {E : Forest} (hH : CondH E) {cs : ColAddr} {k p : Nat}
    (hup : IsUpward E cs k p) {m : Move} (hm : MoveOK (litCap E cs k p) m) :
    ∃ rest Ecol q Hi Hj, cs.path = m.col.path ++ (m.col.col, m.j) :: rest ∧
      E.colAt m.col = some Ecol ∧ Ecol[m.i]? = some (q, Hi) ∧ Ecol[m.j]? = some (q, Hj) ∧
      m.i < m.j ∧ Hj ≤ Hi ∧ IsUpward Hj ⟨rest, cs.col⟩ k p ∧ IsUpward Hi ⟨rest, cs.col⟩ k p ∧
      litCap Hi ⟨rest, cs.col⟩ k p = litCap Hj ⟨rest, cs.col⟩ k p ∧
      (∀ x, m.i ≤ x → x ≤ m.j → (Ecol.getD x (0, Tree.empty)).1 = q) ∧
      Hi < litCap Hj ⟨rest, cs.col⟩ k p ∧
      (litCap E cs k p).colAt m.col = some (Ecol.take m.j ++ [(q, litCap Hj ⟨rest, cs.col⟩ k p)]) := by
  obtain ⟨col0, hcol0, hk0, hq0⟩ := isUpward_iff_exists.1 hup
  obtain ⟨col, sd, hcolK, hsd, hj, hij, hpre, hpar, hlt, -⟩ := hm
  rw [stopData_litCap' hcol0] at hsd
  obtain rfl := Option.some.inj hsd
  obtain ⟨rest, hrest⟩ := hpre
  simp only [EntryAddr.heightPath, List.append_assoc, List.singleton_append] at hrest
  set P := m.col.path
  set cc := m.col.col
  have hcs : cs = ⟨P ++ (cc, m.j) :: rest, cs.col⟩ := by rw [hrest]
  have hcol0' := hcol0
  rw [hcs] at hcol0'
  obtain ⟨Ecol, qj, Hj, hEcol, hEj, hHj⟩ := colAt_through hcol0'
  have hKcol : (litCap E cs k p).colAt m.col =
      some (Ecol.take m.j ++ [(qj, litCapAux k p rest cs.col Hj)]) := by
    rw [litCap_eq_aux hcol0]
    simp only [Tree.colAt] at hEcol ⊢
    have hpreP : P <+: cs.path := ⟨(cc, m.j) :: rest, hrest⟩
    rw [forestAt_litCapAux_prefix k p cs.col cs.path P E hpreP ⟨col0, hcol0⟩]
    obtain ⟨G, hG, hGc⟩ := Option.bind_eq_some_iff.1 hEcol
    rw [hG]
    have hdrop : cs.path.drop P.length = (cc, m.j) :: rest := by rw [← hrest]; simp
    obtain ⟨gcols⟩ := G
    have hget : (gcols.getD cc [])[m.j]? = some (qj, Hj) := by
      simp only [Tree.cols] at hGc; rw [List.getD_eq_getElem?_getD, hGc, Option.getD_some]; exact hEj
    simp only [Option.map_some, Option.bind_some, hdrop]
    rw [litCapAux_cons k p cc m.j cs.col rest gcols hget]
    simp only [Tree.cols] at hGc ⊢
    have hci : cc < gcols.length := (List.getElem?_eq_some_iff.1 hGc).1
    rw [list_getElem?_take_snoc _ _ _ hci.le, if_neg (lt_irrefl _), if_pos rfl]
    all_goals simp [List.getD_eq_getElem?_getD, hGc]
  have hcolK' : (litCap E cs k p).colAt m.col = some col := hcolK
  rw [hKcol] at hcolK'
  obtain rfl := Option.some.inj hcolK'
  have hjE : m.j < Ecol.length := (List.getElem?_eq_some_iff.1 hEj).1
  have hgetK : ∀ x, x < m.j →
      (Ecol.take m.j ++ [(qj, litCapAux k p rest cs.col Hj)]).getD x (0, Tree.empty) =
        Ecol.getD x (0, Tree.empty) := by
    intro x hx
    simp only [List.getD_eq_getElem?_getD]
    rw [List.getElem?_append_left (by simp; omega), List.getElem?_take_of_lt hx]
  have hgetKj : (Ecol.take m.j ++ [(qj, litCapAux k p rest cs.col Hj)]).getD m.j (0, Tree.empty) =
      (qj, litCapAux k p rest cs.col Hj) := by
    simp only [List.getD_eq_getElem?_getD]
    rw [List.getElem?_append_right (by simp)]; simp [List.length_take_of_le hjE.le]
  have hparE : ∀ x, m.i ≤ x → x < m.j → (Ecol.getD x (0, Tree.empty)).1 = qj := by
    intro x h1 h2
    have := hpar x h1 h2.le
    rw [hgetK x h2, hgetKj] at this; exact this
  obtain ⟨qi, Hi, hEi⟩ : ∃ qi Hi, Ecol[m.i]? = some (qi, Hi) := by
    cases h : Ecol[m.i]? with
    | none => have := List.getElem?_eq_none_iff.1 h; omega
    | some x => exact ⟨x.1, x.2, rfl⟩
  have hqi : qi = qj := by
    have := hparE m.i le_rfl hij
    simp only [List.getD_eq_getElem?_getD, hEi, Option.getD_some] at this; exact this
  subst hqi
  have hltE : Hi < litCapAux k p rest cs.col Hj := by
    have := hlt
    rw [hgetK m.i hij, hgetKj] at this
    simpa [List.getD_eq_getElem?_getD, hEi] using this
  have hmemc : m.col ∈ E.colAddrs := (Tree.mem_colAddrs_iff E m.col).2 (by
    show (E.colAt ⟨P, cc⟩).isSome; rw [hEcol]; rfl)
  have hchain : ∀ n, m.i + n ≤ m.j → Hj ≤ (Ecol.getD (m.j - n) (0, Tree.empty)).2 := by
    intro n
    induction n with
    | zero => intro _; simp [List.getD_eq_getElem?_getD, hEj]
    | succ n ih =>
      intro hn
      have h1 := ih (by omega)
      have hx : Ecol[m.j - (n + 1)]? = some (Ecol.getD (m.j - (n + 1)) (0, Tree.empty)) := by
        rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (by omega)]; simp
      have hy : Ecol[m.j - (n + 1) + 1]? = some (Ecol.getD (m.j - n) (0, Tree.empty)) := by
        rw [show m.j - (n + 1) + 1 = m.j - n by omega, List.getD_eq_getElem?_getD,
          List.getElem?_eq_getElem (by omega)]; simp
      have hle := hH m.col hmemc (m.j - (n + 1)) _ _
        (by rw [show m.col = ⟨P, cc⟩ from rfl, hEcol]; exact hx)
        (by rw [show m.col = ⟨P, cc⟩ from rfl, hEcol]; exact hy)
      have hp1 : (Ecol.getD (m.j - (n + 1)) (0, Tree.empty)).1 = qi := hparE _ (by omega) (by omega)
      have hp2 : (Ecol.getD (m.j - n) (0, Tree.empty)).1 = qi := by
        rcases Nat.eq_zero_or_pos n with rfl | hn0
        · simp [List.getD_eq_getElem?_getD, hEj]
        · exact hparE _ (by omega) (by omega)
      rcases hle with h | ⟨-, h⟩
      · omega
      · exact le_trans h1 h
  have hHjHi : Hj ≤ Hi := by
    have := hchain (m.j - m.i) (by omega)
    rw [show m.j - (m.j - m.i) = m.i by omega] at this
    simpa [List.getD_eq_getElem?_getD, hEi] using this
  have hupJ : IsUpward Hj ⟨rest, cs.col⟩ k p := isUpward_iff_exists.2 ⟨col0, hHj, hk0, hq0⟩
  obtain ⟨hupI, heq⟩ := interval_cap hupJ hHjHi (by rw [litCap_eq_aux hHj]; exact hltE)
  have hparAll : ∀ x, m.i ≤ x → x ≤ m.j → (Ecol.getD x (0, Tree.empty)).1 = qi := by
    intro x h1 h2
    rcases Nat.lt_or_ge x m.j with h | h
    · exact hparE x h1 h
    · rw [show x = m.j by omega]; simp [List.getD_eq_getElem?_getD, hEj]
  refine ⟨rest, Ecol, qi, Hi, Hj, hrest.symm, hEcol, hEi, hEj, hij, hHjHi, hupJ, hupI, heq,
    hparAll, ?_, ?_⟩
  · rw [litCap_eq_aux hHj]; exact hltE
  · rw [hKcol, litCap_eq_aux hHj]

/-- L3.6a helper: equal upward caps of `X ≤ Y` compare the complete local suffixes. -/
theorem localSuffix_le_of_cap_G5 {X Y : Forest} {c : ColAddr} {k p : Nat}
    (hX : IsUpward X c k p) (hY : IsUpward Y c k p) (hXY : X ≤ Y)
    (hcap : litCap Y c k p = litCap X c k p) : localSuffix X c ≤ localSuffix Y c := by
  by_contra hlt
  rw [not_le] at hlt
  obtain ⟨sd, hsd⟩ : ∃ sd, stopData (litCap Y c k p) = some sd := ⟨_, stopData_litCap hY⟩
  have h1 := (lt_context_iff_E5 hY hsd (localSuffix X c)).2 hlt
  rw [hcap] at hsd h1
  obtain ⟨A, S, hw, -, -, -, -, -, -, -, -, hC⟩ := word_context_litCap_E5 hX hsd
  have h2 : word (context (litCap X c k p) sd (localSuffix X c)) <+: word X := by
    rw [hC, hw]; exact List.prefix_append _ _
  have h3 := (word_lt_iff _ _).2 h1
  have h4 := word_le_of_le hXY
  exact list_not_lt_prefix h2 (lt_of_le_of_lt h4 h3)

/-- L3.6a helper: the complete local suffix below an entry is the local suffix of its height. -/
theorem localSuffix_through_G5 {E : Forest} {P rest : List (Nat × Nat)} {cc b : Nat} {c : ColAddr}
    {Ecol : Column} {q : Nat} {H : Forest} (hc : c.path = P ++ (cc, b) :: rest)
    (hE : E.colAt ⟨P, cc⟩ = some Ecol) (hb : Ecol[b]? = some (q, H)) :
    localSuffix E c = localSuffix H ⟨rest, c.col⟩ := by
  unfold localSuffix
  rw [hc, forestAt_through_col, hE]
  simp only [Option.bind_some, hb]

-- L3.6a (txt:463-465): reversing one repair: the complete old suffixes compare `Y_i ≥ Y_j`
theorem repair_suffix_ge {B : Forest} (hH : CondH B) {cj ci : ColAddr} {k p : Nat}
    (hj : IsUpward B cj k p) (hi : IsUpward B ci k p)
    (hmove : ∃ m, MoveOK (litCap B cj k p) m ∧ applyMove (litCap B cj k p) m = litCap B ci k p) :
    localSuffix B cj ≤ localSuffix B ci := by
  obtain ⟨m, hm, heq⟩ := hmove
  obtain ⟨rest, Ecol, q, Hi, Hj, hrest, hEcol, hEi, hEj, -, hle, hupJ, hupI, hcapeq, -⟩ :=
    move_data_G5 hH hj hm
  obtain ⟨rest', hrest', hupI', hmv', -⟩ := litCap_move_step hH hj hm
  have hr : rest' = rest := by
    rw [hrest] at hrest'
    have := List.append_cancel_left hrest'
    simp only [List.cons.injEq, true_and] at this
    exact this.symm
  subst hr
  have hci : ci = ⟨m.col.path ++ (m.col.col, m.i) :: rest', cj.col⟩ := by
    have e1 := stopData_litCap hi
    rw [← heq, hmv', stopData_litCap hupI'] at e1
    have := congrArg StopData.col (Option.some.inj e1)
    exact this.symm
  have hEcol' : B.colAt ⟨m.col.path, m.col.col⟩ = some Ecol := hEcol
  have hcip : ci.path = m.col.path ++ (m.col.col, m.i) :: rest' := by rw [hci]
  have hcic : ci.col = cj.col := by rw [hci]
  rw [localSuffix_through_G5 hrest hEcol' hEj, localSuffix_through_G5 hcip hEcol' hEi, hcic]
  exact localSuffix_le_of_cap_G5 hupJ hupI hle hcapeq

/-! ### L3.6b helpers: path cuts -/

/-- L3.6b helper: cut a forest along a column path: at each step keep the columns up to the step's
column and the entries up to the step's entry, and recurse into that entry's height; keep the whole
final forest. For an upward literal cap `K` of `B` at `c` this is `C_K(Y_K)` (`c.path`). -/
def pathCut_G5 : List (Nat × Nat) → Forest → Forest
  | [], F => F
  | (a, u) :: τ, .node cols =>
    match (cols.getD a [])[u]? with
    | some (q, h) => .node (cols.take a ++ [(cols.getD a []).take u ++ [(q, pathCut_G5 τ h)]])
    | none => .node cols

theorem pathCut_cons_G5 (a u : Nat) (τ : List (Nat × Nat)) (cols : List Column) {q : Nat}
    {h : Forest} (hx : (cols.getD a [])[u]? = some (q, h)) :
    pathCut_G5 ((a, u) :: τ) (.node cols) =
      .node (cols.take a ++ [(cols.getD a []).take u ++ [(q, pathCut_G5 τ h)]]) := by
  show (match (cols.getD a [])[u]? with
    | some (q, h) => Tree.node (cols.take a ++ [(cols.getD a []).take u ++ [(q, pathCut_G5 τ h)]])
    | none => Tree.node cols) = _
  rw [hx]

/-- L3.6b helper: a prefix comparison of a cut entry. -/
theorem cmp_snoc_le_G5 (A R : List Column) (T R2 : Column) (q : Nat) {X' H : Forest}
    (hX : X' ≤ H) (hR2 : R2 ≠ []) :
    Tree.cmp compare (Tree.node (A ++ [T ++ [(q, X')]])) (Tree.node (A ++ (T ++ (q, H) :: R2) :: R))
      = .lt := by
  rcases lt_or_eq_of_le hX with h | rfl
  · exact ker_cmp_snoc_lt A R T R2 q h
  · simp only [Tree.cmp]
    rw [ker_cmpCols_append_left]
    simp only [Tree.cmpCols]
    rw [ker_cmpCol_append_left]
    obtain ⟨r, rs, rfl⟩ := List.exists_cons_of_ne_nil hR2
    simp only [Tree.cmpCol]
    rw [Tree.cmp_self compare X', Nat.compare_eq_eq.2 rfl]
    rfl

theorem cmp_snoc_le'_G5 (A : List Column) (T : Column) (q : Nat) {X' H : Forest} (hX : X' ≤ H)
    (R2 : Column) (R : List Column) :
    Tree.cmp compare (Tree.node (A ++ [T ++ [(q, X')]])) (Tree.node (A ++ (T ++ (q, H) :: R2) :: R))
      ≠ .gt := by
  rcases lt_or_eq_of_le hX with h | rfl
  · rw [ker_cmp_snoc_lt A R T R2 q h]; simp
  · simp only [Tree.cmp]
    rw [ker_cmpCols_append_left]
    simp only [Tree.cmpCols]
    rw [ker_cmpCol_append_left]
    simp only [Tree.cmpCol]
    rw [Tree.cmp_self compare X', Nat.compare_eq_eq.2 rfl]
    cases R2 <;> cases R <;> simp [Tree.cmpCol, Tree.cmpCols, Ordering.then]

theorem split_at_G5 {β : Type} {l : List β} {a : Nat} {x : β} (h : l[a]? = some x) :
    l = l.take a ++ x :: l.drop (a + 1) := by
  have ha : a < l.length := (List.getElem?_eq_some_iff.1 h).1
  conv_lhs => rw [← List.take_append_drop a l]
  rw [List.drop_eq_getElem_cons ha]
  obtain ⟨_, h2⟩ := List.getElem?_eq_some_iff.1 h
  rw [h2]

/-- L3.6b helper: a path cut is below the forest. -/
theorem pathCut_le_G5 : ∀ (τ : List (Nat × Nat)) (F : Forest), pathCut_G5 τ F ≤ F
  | [], F => le_refl F
  | (a, u) :: τ, .node cols => by
    cases hx : (cols.getD a [])[u]? with
    | none =>
      show (match (cols.getD a [])[u]? with
        | some (q, h) => Tree.node (cols.take a ++ [(cols.getD a []).take u ++ [(q, pathCut_G5 τ h)]])
        | none => Tree.node cols) ≤ _
      rw [hx]
    | some x =>
      obtain ⟨q, h⟩ := x
      rw [pathCut_cons_G5 a u τ cols hx]
      have ih := pathCut_le_G5 τ h
      have ha : a < cols.length := by
        by_contra hh
        have h0 : cols[a]? = none := List.getElem?_eq_none (by omega)
        rw [List.getD_eq_getElem?_getD, h0] at hx
        simp at hx
      have hcol : cols[a]? = some (cols.getD a []) := by
        rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem ha]; rfl
      have e1 := split_at_G5 hcol
      have e2 := split_at_G5 hx
      show Tree.cmp compare _ _ ≠ .gt
      have key := cmp_snoc_le'_G5 (cols.take a) ((cols.getD a []).take u) q ih
        ((cols.getD a []).drop (u + 1)) (cols.drop (a + 1))
      rw [← e2, ← e1] at key
      exact key

/-- L3.6b helper: cutting at an earlier entry of the same column gives a smaller forest. -/
theorem pathCut_lt_G5 (cc i j : Nat) (τ₁ τ₂ : List (Nat × Nat)) (hij : i < j) :
    ∀ (P : List (Nat × Nat)) (F : Forest) (Ecol : Column),
      F.colAt ⟨P, cc⟩ = some Ecol → j < Ecol.length →
      pathCut_G5 (P ++ (cc, i) :: τ₁) F < pathCut_G5 (P ++ (cc, j) :: τ₂) F
  | [], .node cols, Ecol, hE, hj => by
    rw [colAt_node_nil] at hE
    obtain ⟨qi, Hi, hEi⟩ : ∃ qi Hi, Ecol[i]? = some (qi, Hi) := by
      cases h : Ecol[i]? with
      | none => have := List.getElem?_eq_none_iff.1 h; omega
      | some x => exact ⟨x.1, x.2, rfl⟩
    obtain ⟨qj, Hj, hEj⟩ : ∃ qj Hj, Ecol[j]? = some (qj, Hj) := by
      cases h : Ecol[j]? with
      | none => have := List.getElem?_eq_none_iff.1 h; omega
      | some x => exact ⟨x.1, x.2, rfl⟩
    have hg : cols.getD cc [] = Ecol := by rw [List.getD_eq_getElem?_getD, hE]; rfl
    simp only [List.nil_append]
    rw [pathCut_cons_G5 cc i τ₁ cols (by rw [hg]; exact hEi),
      pathCut_cons_G5 cc j τ₂ cols (by rw [hg]; exact hEj), hg]
    show Tree.cmp compare _ _ = .lt
    have hi : i < Ecol.length := by omega
    have htj : Ecol.take j = Ecol.take i ++ (qi, Hi) :: (Ecol.drop (i + 1)).take (j - i - 1) := by
      rw [show j = i + ((j - i - 1) + 1) by omega, List.take_add, List.drop_eq_getElem_cons hi,
        List.take_succ_cons]
      obtain ⟨_, h2⟩ := List.getElem?_eq_some_iff.1 hEi
      rw [h2, show i + (j - i - 1 + 1) - i - 1 = j - i - 1 by omega]
    rw [htj, List.append_assoc, List.cons_append]
    exact cmp_snoc_le_G5 _ [] _ _ qi (pathCut_le_G5 τ₁ Hi) (by simp)
  | (a, u) :: P, .node cols, Ecol, hE, hj => by
    rw [colAt_node_cons] at hE
    obtain ⟨x, hx, hcolx⟩ := Option.bind_eq_some_iff.1 hE
    obtain ⟨colc, hc, hx'⟩ := Option.bind_eq_some_iff.1 hx
    obtain ⟨q, H⟩ := x
    have ih := pathCut_lt_G5 cc i j τ₁ τ₂ hij P H Ecol hcolx hj
    have hg : (cols.getD a [])[u]? = some (q, H) := by
      rw [List.getD_eq_getElem?_getD, hc]; exact hx'
    simp only [List.cons_append]
    rw [pathCut_cons_G5 a u _ cols hg, pathCut_cons_G5 a u _ cols hg]
    exact ker_cmp_snoc_lt _ [] _ [] q ih

/-- L3.6b helper: filling a literal cap with its complete local suffix is the path cut. -/
theorem ctx_pathCut_aux_G5 (k p jj : Nat) : ∀ (σ : List (Nat × Nat)) (F : Forest),
    (F.colAt ⟨σ, jj⟩).isSome →
    replaceAt 0 0 (Tree.node (((F.forestAt σ).getD Tree.empty).cols.drop jj)) σ.length
      (litCapAux k p σ jj F) = pathCut_G5 σ F
  | [], .node cols, hc => by
    rw [colAt_node_nil] at hc
    have hj : jj < cols.length := by
      by_contra hh; rw [List.getElem?_eq_none (by omega)] at hc; cases hc
    simp only [litCapAux, List.length_nil, forestAt_nil_path, Option.getD_some, Tree.cols]
    rw [ker_replaceAt_zero_zero _ _ (by simp), List.dropLast_concat]
    simp only [Tree.cols, List.take_append_drop]
    rfl
  | (a, u) :: σ, .node cols, hc => by
    rw [colAt_node_cons] at hc
    obtain ⟨y, hy⟩ := Option.isSome_iff_exists.1 hc
    obtain ⟨x, hx, hcx'⟩ := Option.bind_eq_some_iff.1 hy
    have hcx : (x.2.colAt ⟨σ, jj⟩).isSome := by rw [hcx']; rfl
    obtain ⟨colc, hcc, hx'⟩ := Option.bind_eq_some_iff.1 hx
    obtain ⟨q, h⟩ := x
    have hg : (cols.getD a [])[u]? = some (q, h) := by
      rw [List.getD_eq_getElem?_getD, hcc]; exact hx'
    have ih := ctx_pathCut_aux_G5 k p jj σ h hcx
    rw [litCapAux_cons k p a u jj σ cols hg, pathCut_cons_G5 a u σ cols hg, List.length_cons,
      ker_replaceAt_zero_succ, forestAt_node_cons, hcc]
    simp only [Option.bind_some, hx']
    rw [mapLast_eq]
    simp only [List.dropLast_concat, List.getLast?_concat, Option.map_some, Option.toList_some,
      List.map_id_fun, id_eq]
    rw [mapLast_eq]
    simp only [List.dropLast_concat, List.getLast?_concat, Option.map_some, Option.toList_some,
      List.map_id_fun, id_eq]
    rw [ih]

/-- L3.6b helper: `C_K(Y_K)` is the path cut of the target along the cap column. -/
theorem context_pathCut_G5 {B : Forest} {c : ColAddr} {k p : Nat} (hup : IsUpward B c k p)
    {sd : StopData} (hsd : stopData (litCap B c k p) = some sd) :
    context (litCap B c k p) sd (localSuffix B c) = pathCut_G5 c.path B := by
  obtain ⟨col, hcol, -, -⟩ := isUpward_iff_exists.1 hup
  have hsdE := hsd.symm.trans (stopData_litCap hup)
  obtain rfl := Option.some.inj hsdE
  unfold context localSuffix
  rw [litCap_eq_aux hcol]
  exact ctx_pathCut_aux_G5 k p c.col c.path B (by rw [hcol]; rfl)

/-- L3.6b helper: the forests of a path cut along a prefix of its path. -/
theorem forestAt_pathCut_G5 : ∀ (τ π : List (Nat × Nat)) (F : Forest), π <+: τ →
    (F.forestAt τ).isSome →
    (pathCut_G5 τ F).forestAt π = (F.forestAt π).map (pathCut_G5 (τ.drop π.length))
  | τ, [], F, _, _ => by simp [forestAt_nil_path]
  | [], _ :: _, _, h, _ => absurd (List.eq_nil_of_prefix_nil h) (List.cons_ne_nil _ _)
  | (a, u) :: τ, (b, v) :: π, .node cols, h, hs => by
    obtain ⟨hab, hp⟩ := List.cons_prefix_cons.1 h
    obtain ⟨rfl, rfl⟩ := Prod.mk.inj hab
    rw [forestAt_node_cons] at hs
    obtain ⟨x, hx, hxs⟩ : ∃ x, (cols[b]?.bind (·[v]?)) = some x ∧ (x.2.forestAt τ).isSome := by
      cases h1 : (cols[b]?.bind (·[v]?)) with
      | none => rw [h1] at hs; simp at hs
      | some x => rw [h1] at hs; exact ⟨x, rfl, hs⟩
    obtain ⟨colc, hcc, hx'⟩ := Option.bind_eq_some_iff.1 hx
    obtain ⟨q, H⟩ := x
    have hg : (cols.getD b [])[v]? = some (q, H) := by
      rw [List.getD_eq_getElem?_getD, hcc]; exact hx'
    have hb : b < cols.length := (List.getElem?_eq_some_iff.1 hcc).1
    have hv : v < colc.length := (List.getElem?_eq_some_iff.1 hx').1
    rw [pathCut_cons_G5 b v τ cols hg, forestAt_node_cons, forestAt_node_cons, hx]
    have hlen : (cols.take b).length = b := List.length_take_of_le hb.le
    have hlen' : ((cols.getD b []).take v).length = v := by
      rw [List.getD_eq_getElem?_getD, hcc, Option.getD_some]; exact List.length_take_of_le hv.le
    rw [List.getElem?_append_right (by omega), hlen, Nat.sub_self]
    simp only [List.getElem?_cons_zero, Option.bind_some]
    rw [List.getElem?_append_right (by omega), hlen', Nat.sub_self]
    simp only [List.getElem?_cons_zero, Option.bind_some, List.length_cons, List.drop_succ_cons]
    exact forestAt_pathCut_G5 τ π H hp hxs

/-- L3.6b helper: the root tail of a forest at its column `x` with cursor `c`. -/
def rtF_G5 (X : Forest) (x c : Nat) : Forest :=
  .node (((X.cols.getD x []).drop c) :: X.cols.drop (x + 1))

theorem rootTail_eq_rtF_G5 {D G : Forest} {rd : RootData} (hidx : rd.idx = rd.col.col)
    (hG : D.forestAt rd.col.path = some G) (c : Nat) :
    rootTail D rd c = rtF_G5 G rd.col.col c := by
  unfold rootTail rtF_G5 Tree.colAt
  rw [hG, hidx]
  simp [List.getD_eq_getElem?_getD]

theorem rtF_pathCut_G5 {x a u c : Nat} (τ : List (Nat × Nat)) (cols : List Column) {q : Nat}
    {h : Forest} (hxa : x ≤ a) (hc : a = x → c ≤ u) (hg : (cols.getD a [])[u]? = some (q, h)) :
    rtF_G5 (pathCut_G5 ((a, u) :: τ) (.node cols)) x c =
      pathCut_G5 ((a - x, if a = x then u - c else u) :: τ) (rtF_G5 (.node cols) x c) := by
  have ha : a < cols.length := by
    by_contra hh
    have h0 : cols[a]? = none := List.getElem?_eq_none (by omega)
    rw [List.getD_eq_getElem?_getD, h0] at hg
    simp at hg
  have hu : u < (cols.getD a []).length := (List.getElem?_eq_some_iff.1 hg).1
  have hlen : (cols.take a).length = a := List.length_take_of_le ha.le
  rw [pathCut_cons_G5 a u τ cols hg]
  unfold rtF_G5
  simp only [Tree.cols]
  by_cases hax : a = x
  · subst hax
    simp only [if_true, Nat.sub_self]
    have hcu := hc rfl
    have hg' : ((((cols.getD a []).drop c) :: cols.drop (a + 1)).getD 0 [])[u - c]? = some (q, h) := by
      simp only [List.getD_cons_zero, List.getElem?_drop]
      rw [show c + (u - c) = u by omega]; exact hg
    rw [pathCut_cons_G5 0 (u - c) τ _ hg']
    have h1 : (cols.take a ++ [(cols.getD a []).take u ++ [(q, pathCut_G5 τ h)]]).getD a [] =
        (cols.getD a []).take u ++ [(q, pathCut_G5 τ h)] := by
      rw [List.getD_eq_getElem?_getD, List.getElem?_append_right (by omega), hlen, Nat.sub_self]
      rfl
    have h2 : (cols.take a ++ [(cols.getD a []).take u ++ [(q, pathCut_G5 τ h)]]).drop (a + 1) = [] :=
      List.drop_eq_nil_of_le (by simp only [List.length_append, List.length_singleton, hlen]; omega)
    rw [h1, h2, List.drop_append_of_le_length (by rw [List.length_take_of_le hu.le]; exact hcu)]
    simp only [List.take_zero, List.nil_append, List.getD_cons_zero, List.drop_take]
  · have hxa' : x < a := by omega
    simp only [if_neg hax]
    have hd : (((cols.getD x []).drop c) :: cols.drop (x + 1)).getD (a - x) [] = cols.getD a [] := by
      rw [show a - x = (a - x - 1) + 1 by omega, List.getD_cons_succ, List.getD_eq_getElem?_getD,
        List.getD_eq_getElem?_getD, List.getElem?_drop, show x + 1 + (a - x - 1) = a by omega]
    have hg' : ((((cols.getD x []).drop c) :: cols.drop (x + 1)).getD (a - x) [])[u]? = some (q, h) := by
      rw [hd]; exact hg
    rw [pathCut_cons_G5 (a - x) u τ _ hg', hd]
    have h1 : (cols.take a ++ [(cols.getD a []).take u ++ [(q, pathCut_G5 τ h)]]).getD x [] =
        cols.getD x [] := by
      rw [List.getD_eq_getElem?_getD, List.getElem?_append_left (by omega), List.getElem?_take_of_lt hxa',
        ← List.getD_eq_getElem?_getD]
    rw [h1, List.drop_append_of_le_length (by omega), show a - x = (a - x - 1) + 1 by omega,
      List.take_succ_cons, List.drop_take]
    simp only [List.cons_append]
    rw [show a - x - 1 = a - (x + 1) by omega]

/-- L3.6b helper: `Q ⋄ T_{r,d}(·)` is strictly monotone on forests with a first column. -/
theorem diamond_shift_lt_G5 (Q : Column) (r d : Nat) {X X' : Forest} (hX : X.cols ≠ [])
    (hX' : X'.cols ≠ []) (h : X < X') : diamond Q (shift r d X) < diamond Q (shift r d X') := by
  obtain ⟨cs⟩ := X
  obtain ⟨cs'⟩ := X'
  obtain ⟨a, as, rfl⟩ := List.exists_cons_of_ne_nil hX
  obtain ⟨b, bs, rfl⟩ := List.exists_cons_of_ne_nil hX'
  have h1 := cmp_shift_D3 r d (Tree.node (a :: as)) (Tree.node (b :: bs))
  rw [ker_shift_node, ker_shift_node] at h1 ⊢
  simp only [List.map_cons, diamond] at h1 ⊢
  show Tree.cmp compare _ _ = .lt
  simp only [Tree.cmp, Tree.cmpCols] at h1 ⊢
  rw [ker_cmpCol_append_left, h1]
  exact h

theorem cursor_all_lt_G5 {α : Type} [LinearOrder α] (y : α) (ys : List α) :
    ∀ (Bl : List α), (∀ b ∈ Bl, b < y) → cursor Bl (y :: ys) = Bl.length
  | [], _ => by simp [cursor]
  | b :: Bl, h => by
    rw [cursor, if_pos (h b (by simp)), cursor_all_lt_G5 y ys Bl (fun b' hb' => h b' (by simp [hb']))]
    simp

/-- L3.6b helper: a block of source keys with one common strict sign against every query key is
consumed entirely once its first key is consumed. -/
theorem cursor_le_of_sign_G5 {α : Type} [LinearOrder α] (Bl : List α) (hB : Bl ≠ []) :
    ∀ (A qry : List α), (∀ y ∈ qry, (∀ b ∈ Bl, b < y) ∨ (∀ b ∈ Bl, y < b)) →
      cursor (A ++ Bl) qry < (A ++ Bl).length → cursor (A ++ Bl) qry ≤ A.length := by
  obtain ⟨b0, Bl', rfl⟩ := List.exists_cons_of_ne_nil hB
  intro A
  induction A with
  | nil =>
    intro qry
    induction qry with
    | nil => intro _ _; simp [cursor]
    | cons y ys ih =>
      intro hs hlt
      rcases hs y (by simp) with h | h
      · rw [List.nil_append, cursor_all_lt_G5 y ys _ h] at hlt; omega
      · have h1 : ¬ b0 < y := not_lt.2 (h b0 (by simp)).le
        have h2 : ¬ b0 = y := ne_of_gt (h b0 (by simp))
        simp only [List.nil_append] at hlt ih ⊢
        rw [cursor, if_neg h1, if_neg h2] at hlt ⊢
        exact ih (fun z hz => hs z (by simp [hz])) hlt
  | cons a A ihA =>
    intro qry
    induction qry with
    | nil => intro _ _; simp [cursor]
    | cons y ys ih =>
      intro hs hlt
      simp only [List.cons_append, List.length_cons] at hlt ih ⊢
      by_cases h1 : a < y
      · rw [cursor, if_pos h1] at hlt ⊢
        have := ihA (y :: ys) hs (by simp only [List.length_append, List.length_cons] at hlt ⊢; omega)
        omega
      · by_cases h2 : a = y
        · rw [cursor, if_neg h1, if_pos h2] at hlt ⊢
          have := ihA ys (fun z hz => hs z (by simp [hz]))
            (by simp only [List.length_append, List.length_cons] at hlt ⊢; omega)
          omega
        · rw [cursor, if_neg h1, if_neg h2] at hlt ⊢
          exact ih (fun z hz => hs z (by simp [hz])) hlt

/-- L3.6b helper: two unexhausted sources that differ only in their last key have the same
cursor (trace fact (2) through `⊤`). -/
theorem cursor_eq_dropLast_G5 {β : Type} [LinearOrder β] {s₁ s₂ qry : List β} (hne₁ : s₁ ≠ [])
    (hne₂ : s₂ ≠ []) (hd : s₁.dropLast = s₂.dropLast) (h₁ : cursor s₁ qry < s₁.length)
    (h₂ : cursor s₂ qry < s₂.length) : cursor s₁ qry = cursor s₂ qry := by
  have hm : StrictMono (fun x : β => (x : WithTop β)) := WithTop.coe_strictMono
  rw [← cursor_map hm s₁ qry, ← cursor_map hm s₂ qry]
  apply cursor_eq_of_trace_eq
  have e₁ := trace_cap_top (src := s₁.map (fun x : β => (x : WithTop β)))
    (qry := qry.map (fun x : β => (x : WithTop β))) (by simpa using hne₁)
    (by rw [cursor_map hm]; simpa using h₁)
  have e₂ := trace_cap_top (src := s₂.map (fun x : β => (x : WithTop β)))
    (qry := qry.map (fun x : β => (x : WithTop β))) (by simpa using hne₂)
    (by rw [cursor_map hm]; simpa using h₂)
  rw [← e₁, ← e₂, ← List.map_dropLast, ← List.map_dropLast, hd]

/-- L3.6b helper: an entry's height contributes its word and its entry atom to the column word. -/
theorem len_wordCol_entry_G5 (e : Nat) {l : Column} {a q : Nat} {J : Forest}
    (h : l[a]? = some (q, J)) : mu J + 1 ≤ (wordCol e l).length := by
  rw [split_at_G5 h, wordCol_split_E5]
  have h1 : 1 ≤ (wordCol e (l.take a ++ [(q, Tree.empty)])).length := by
    cases hT : l.take a with
    | nil => simp [wordCol]
    | cons y ys => obtain ⟨p', h'⟩ := y; simp [wordCol]
  have h2 : (wordAt (e + 1) J).length = mu J := by
    rw [← map_depthShift_word_E5, List.length_map]; rfl
  simp only [List.length_append]
  omega

/-- L3.6b helper: every query height of a cut lies inside the cut position. -/
theorem query_lt_capPos_G5 {X : Forest} {c : ColAddr} {k : Nat} (hc : c ∈ X.colAddrs)
    {a q : Nat} {J : Forest} (ha : a < k) (hJ : ((X.colAt c).getD [])[a]? = some (q, J)) :
    mu J + 1 ≤ capPos X c k := by
  obtain ⟨A, S, -, -, hcap⟩ := wordDecomp_E5 hc
  rw [capPos_eq_E5 hcap k]
  have hne : ((X.colAt c).getD []).take k ≠ [] := by
    intro h0
    have : (((X.colAt c).getD []).take k)[a]? = some (q, J) := by
      rw [List.getElem?_take_of_lt ha]; exact hJ
    rw [h0] at this; simp at this
  rw [len_wordCol_snoc_E5 _ hne]
  have := len_wordCol_entry_G5 (colDepth c) (l := ((X.colAt c).getD []).take k)
    (by rw [List.getElem?_take_of_lt ha]; exact hJ)
  omega

/-- L3.6b helper (sign of agreement at a cap): a height and its upward cap have the same strict
sign against every query height of the cap. -/
theorem sign_cap_G5 {X : Forest} {c : ColAddr} {k p : Nat} (hup : IsUpward X c k p) (r t : Nat)
    {a q : Nat} {J : Forest} (ha : a < k) (hJ : ((X.colAt c).getD [])[a]? = some (q, J)) :
    keyCmp (relKey r X) (relKey t J) = keyCmp (relKey r (litCap X c k p)) (relKey t J) ∧
      keyCmp (relKey r X) (relKey t J) ≠ .eq := by
  obtain ⟨col, hcol, hk, -⟩ := isUpward_iff_exists.1 hup
  obtain ⟨-, -, hcap, -, hle⟩ := litCap_word_data hcol hk
  have hc : c ∈ X.colAddrs := (Tree.mem_colAddrs_iff X c).2 (by rw [hcol]; rfl)
  have hn := query_lt_capPos_G5 hc ha hJ
  apply sign_of_agreement r t
  · unfold mu at hn ⊢; omega
  · rw [hcap p, List.take_append_of_le_length (by rw [List.length_take]; omega), List.take_take,
      Nat.min_eq_left (by omega)]

theorem getElem?_of_getD_G5 {β : Type} {l : List (List β)} {a u : Nat} {x : β}
    (h : (l.getD a [])[u]? = some x) : l[a]? = some (l.getD a []) := by
  cases h' : l[a]? with
  | none => rw [List.getD_eq_getElem?_getD, h'] at h; simp at h
  | some y => rw [List.getD_eq_getElem?_getD, h']; rfl

theorem rtF_entry_G5 (cols : List Column) {x a u c : Nat} (hxa : x ≤ a) (hc : a = x → c ≤ u) :
    ((rtF_G5 (.node cols) x c).cols.getD (a - x) [])[if a = x then u - c else u]? =
      (cols.getD a [])[u]? := by
  unfold rtF_G5; simp only [Tree.cols]
  by_cases hax : a = x
  · subst hax
    simp only [if_true, Nat.sub_self, List.getD_cons_zero, List.getElem?_drop]
    rw [show c + (u - c) = u by have := hc rfl; omega]
  · simp only [if_neg hax]
    rw [show a - x = (a - x - 1) + 1 by omega, List.getD_cons_succ, List.getD_eq_getElem?_getD,
      List.getD_eq_getElem?_getD, List.getElem?_drop, show x + 1 + (a - x - 1) = a by omega]

/-- L3.6b helper (root restriction, L3.5c in structural form): the root tails of the two cuts of
the target compare as the cuts, when the root lies on the common part of the two paths and the
cursor does not pass the active entry of an owner root. -/
theorem rootTail_cut_lt_G5 {B : Forest} {rd : RootData} (hidx : rd.idx = rd.col.col)
    {P rest : List (Nat × Nat)} {cc i j c : Nat} {Ecol : Column}
    (hEcol : B.colAt ⟨P, cc⟩ = some Ecol) (hij : i < j) (hj : j < Ecol.length)
    (hfi : (B.forestAt (P ++ (cc, i) :: rest)).isSome)
    (hfj : (B.forestAt (P ++ (cc, j) :: rest)).isSome)
    {n a u : Nat} (hn : (P ++ [(cc, i)])[n]? = some (a, u)) (hpath : rd.col.path = P.take n)
    (hxa : rd.col.col ≤ a) (hc : a = rd.col.col → c ≤ u) :
    rootTail (pathCut_G5 (P ++ (cc, i) :: rest) B) rd c <
      rootTail (pathCut_G5 (P ++ (cc, j) :: rest) B) rd c := by
  have hnP : n ≤ P.length := by
    have := (List.getElem?_eq_some_iff.1 hn).1; simp at this; omega
  have hFP : ∃ FP, B.forestAt P = some FP ∧ FP.cols[cc]? = some Ecol := by
    unfold Tree.colAt at hEcol
    obtain ⟨FP, h1, h2⟩ := Option.bind_eq_some_iff.1 hEcol
    exact ⟨FP, h1, h2⟩
  obtain ⟨FP, hFP, hFPc⟩ := hFP
  obtain ⟨G, hG⟩ : ∃ G, B.forestAt (P.take n) = some G := by
    have h1 : B.forestAt P = (B.forestAt (P.take n)).bind fun F => F.forestAt (P.drop n) := by
      rw [← Tree.forestAt_append, List.take_append_drop]
    rw [hFP] at h1
    cases h2 : B.forestAt (P.take n) with
    | none => rw [h2] at h1; cases h1
    | some G => exact ⟨G, rfl⟩
  have hGP : G.forestAt (P.drop n) = some FP := by
    have h1 : B.forestAt P = (B.forestAt (P.take n)).bind fun F => F.forestAt (P.drop n) := by
      rw [← Tree.forestAt_append, List.take_append_drop]
    rw [hFP, hG, Option.bind_some] at h1; exact h1.symm
  have hlenT : (P.take n).length = n := List.length_take_of_le hnP
  -- both root tails through the root forest
  have hroot : ∀ x, (B.forestAt (P ++ (cc, x) :: rest)).isSome →
      rootTail (pathCut_G5 (P ++ (cc, x) :: rest) B) rd c =
        rtF_G5 (pathCut_G5 (P.drop n ++ (cc, x) :: rest) G) rd.col.col c := by
    intro x hx
    have hpre : P.take n <+: P ++ (cc, x) :: rest :=
      ⟨P.drop n ++ (cc, x) :: rest, by rw [← List.append_assoc, List.take_append_drop]⟩
    have h1 := forestAt_pathCut_G5 _ _ B hpre hx
    rw [hG, Option.map_some, hlenT, List.drop_append_of_le_length hnP] at h1
    rw [← hpath] at h1
    exact rootTail_eq_rtF_G5 hidx h1 c
  rw [hroot i hfi, hroot j hfj]
  obtain ⟨gcols⟩ := G
  rcases Nat.lt_or_ge n P.length with hlt | hge
  · -- the root lies above the move column's forest
    have hPn : P[n]? = some (a, u) := by
      rw [List.getElem?_append_left hlt] at hn; exact hn
    have hsplit : P.drop n = (a, u) :: P.drop (n + 1) := by
      rw [List.drop_eq_getElem_cons hlt]
      obtain ⟨_, h2⟩ := List.getElem?_eq_some_iff.1 hPn
      rw [h2]
    rw [hsplit, forestAt_node_cons] at hGP
    obtain ⟨x, hx, hxP⟩ := Option.bind_eq_some_iff.1 hGP
    obtain ⟨colc, hcc, hx'⟩ := Option.bind_eq_some_iff.1 hx
    obtain ⟨qu, hu⟩ := x
    have hg : (gcols.getD a [])[u]? = some (qu, hu) := by
      rw [List.getD_eq_getElem?_getD, hcc]; exact hx'
    rw [hsplit, List.cons_append, List.cons_append,
      rtF_pathCut_G5 _ gcols hxa hc hg, rtF_pathCut_G5 _ gcols hxa hc hg,
      ← List.cons_append, ← List.cons_append]
    apply pathCut_lt_G5 cc i j rest rest hij _ _ Ecol _ hj
    have he := rtF_entry_G5 gcols hxa hc (u := u)
    rw [hg] at he
    unfold Tree.colAt
    rw [ker_forestAt_cons, getElem?_of_getD_G5 he]
    simp only [Option.bind_some, he, hxP]
    exact hFPc
  · -- the root lies in the move column's forest
    have hnP' : n = P.length := by omega
    subst hnP'
    rw [List.getElem?_append_right (le_refl _), Nat.sub_self] at hn
    simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hn
    obtain ⟨rfl, rfl⟩ := hn
    rw [List.drop_length] at hGP ⊢
    simp only [forestAt_nil_path, Option.some.injEq] at hGP
    subst hGP
    simp only [Tree.cols] at hFPc
    have hiE : i < Ecol.length := by omega
    obtain ⟨qi, Hi, hEi⟩ : ∃ qi Hi, Ecol[i]? = some (qi, Hi) := by
      cases h : Ecol[i]? with
      | none => have := List.getElem?_eq_none_iff.1 h; omega
      | some x => exact ⟨x.1, x.2, rfl⟩
    obtain ⟨qj, Hj, hEj⟩ : ∃ qj Hj, Ecol[j]? = some (qj, Hj) := by
      cases h : Ecol[j]? with
      | none => have := List.getElem?_eq_none_iff.1 h; omega
      | some x => exact ⟨x.1, x.2, rfl⟩
    have hgd : gcols.getD cc [] = Ecol := by rw [List.getD_eq_getElem?_getD, hFPc]; rfl
    have hgi : (gcols.getD cc [])[i]? = some (qi, Hi) := by rw [hgd]; exact hEi
    have hgj : (gcols.getD cc [])[j]? = some (qj, Hj) := by rw [hgd]; exact hEj
    have hcj : cc = rd.col.col → c ≤ j := fun h => by have := hc h; omega
    simp only [List.nil_append]
    rw [rtF_pathCut_G5 _ gcols hxa hc hgi, rtF_pathCut_G5 _ gcols hxa hcj hgj]
    have hei := rtF_entry_G5 gcols hxa hc (u := i)
    have hej := rtF_entry_G5 gcols hxa hcj (u := j)
    rw [hgi] at hei
    rw [hgj] at hej
    have hlt' : (if cc = rd.col.col then i - c else i) < (if cc = rd.col.col then j - c else j) := by
      split_ifs with h
      · have := hc h; omega
      · exact hij
    have key := pathCut_lt_G5 (cc - rd.col.col) _ _ rest rest hlt' []
      (rtF_G5 (Tree.node gcols) rd.col.col c)
      ((rtF_G5 (Tree.node gcols) rd.col.col c).cols.getD (cc - rd.col.col) [])
      (by
        unfold Tree.colAt
        rw [forestAt_nil_path, Option.bind_some, getElem?_of_getD_G5 hej])
      (List.getElem?_eq_some_iff.1 hej).1
    simpa using key

/-- L3.6b helper: the kernel depends on the root only through its forest, depth, index and
number. -/
theorem kernel_congr_G5 {E E' : Forest} {sd sd' : StopData} {o o' : ColAddr}
    (hF : E.forestAt o.path = E'.forestAt o'.path) (hlen : o.path.length = o'.path.length)
    (hcol : o.col = o'.col) (hnum : o.num 0 = o'.num 0) (hQ : sd.Q = sd'.Q) (ht : sd.t = sd'.t)
    (hr : sd.r = sd'.r) (hd : sd.depth = sd'.depth) (X : Forest) :
    kernel E sd (rootOf E sd o) X = kernel E' sd' (rootOf E' sd' o') X := by
  unfold kernel rootOf unconsumed rootCol rootForest holeDepth period Tree.colAt
  simp only [hF, hlen, hcol, hnum, hQ, ht, hr, hd]

/-- L3.6b helper: a literal cap's column at a containing entry of its path. -/
theorem litCap_colAt_through_G5 {E : Forest} {cs : ColAddr} {k p : Nat} {col0 : Column}
    (hcol0 : E.colAt cs = some col0) {P rest : List (Nat × Nat)} {cc e : Nat}
    (hrest : cs.path = P ++ (cc, e) :: rest) {Ecol : Column} (hEcol : E.colAt ⟨P, cc⟩ = some Ecol)
    {qe : Nat} {He : Forest} (hEe : Ecol[e]? = some (qe, He)) :
    (litCap E cs k p).colAt ⟨P, cc⟩ = some (Ecol.take e ++ [(qe, litCap He ⟨rest, cs.col⟩ k p)]) := by
  have hcs : cs = ⟨P ++ (cc, e) :: rest, cs.col⟩ := by rw [← hrest]
  have hHe : He.colAt ⟨rest, cs.col⟩ = some col0 := by
    rw [← colAt_through_of hEcol hEe, ← hcs]; exact hcol0
  rw [litCap_eq_aux hcol0, litCap_eq_aux hHe]
  simp only [Tree.colAt] at hEcol ⊢
  have hpreP : P <+: cs.path := ⟨(cc, e) :: rest, hrest.symm⟩
  rw [forestAt_litCapAux_prefix k p cs.col cs.path P E hpreP ⟨col0, hcol0⟩]
  obtain ⟨G, hG, hGc⟩ := Option.bind_eq_some_iff.1 hEcol
  rw [hG]
  have hdrop : cs.path.drop P.length = (cc, e) :: rest := by rw [hrest]; simp
  obtain ⟨gcols⟩ := G
  have hget : (gcols.getD cc [])[e]? = some (qe, He) := by
    simp only [Tree.cols] at hGc; rw [List.getD_eq_getElem?_getD, hGc, Option.getD_some]; exact hEe
  simp only [Option.map_some, Option.bind_some, hdrop]
  rw [litCapAux_cons k p cc e cs.col rest gcols hget]
  simp only [Tree.cols] at hGc ⊢
  have hci : cc < gcols.length := (List.getElem?_eq_some_iff.1 hGc).1
  rw [list_getElem?_take_snoc _ _ _ hci.le, if_neg (lt_irrefl _), if_pos rfl]
  all_goals simp [List.getD_eq_getElem?_getD, hGc]

/-- L3.6b helper: the forest below the moved entry of a literal cap. -/
theorem litCap_forestAt_through_G5 {K Kin : Forest} {P π : List (Nat × Nat)} {cc e : Nat}
    {T : Column} {q : Nat} (hK : K.colAt ⟨P, cc⟩ = some (T ++ [(q, Kin)])) (hT : T.length = e) :
    K.forestAt (P ++ (cc, e) :: π) = Kin.forestAt π := by
  rw [forestAt_through_col, hK]
  simp only [Option.bind_some]
  rw [List.getElem?_append_right (by omega), hT, Nat.sub_self]
  simp

theorem num_move_G5 (P π : List (Nat × Nat)) (cc e e' x : Nat) :
    (⟨P ++ (cc, e) :: π, x⟩ : ColAddr).num 0 = (⟨P ++ (cc, e') :: π, x⟩ : ColAddr).num 0 := by
  simp [ColAddr.num]

/-- L3.6b helper: a root inside the moved entry moves with it. -/
theorem resolve_moved_G5 {P rest π : List (Nat × Nat)} {cc e e' jj q x : Nat}
    (h : (⟨P ++ (cc, e) :: rest, jj⟩ : ColAddr).resolve 0 q = some ⟨P ++ (cc, e) :: π, x⟩) :
    (⟨P ++ (cc, e') :: rest, jj⟩ : ColAddr).resolve 0 q = some ⟨P ++ (cc, e') :: π, x⟩ := by
  obtain ⟨hon, hnum⟩ := (ColAddr.resolve_spec 0 _ _ q).1 h
  refine (ColAddr.resolve_spec 0 _ _ q).2 ⟨?_, by rw [← hnum]; exact (num_move_G5 P π cc e e' x).symm⟩
  rcases hon with ⟨kk, ck, ik, hk, hp, hc⟩ | ⟨hp, hc⟩
  · simp only at hk hp hc ⊢
    have hkk : kk < (P ++ (cc, e) :: rest).length := (List.getElem?_eq_some_iff.1 hk).1
    have hlen := congrArg List.length hp
    rw [List.length_take_of_le hkk.le] at hlen
    simp only [List.length_append, List.length_cons] at hlen
    refine Or.inl ⟨kk, ck, ik, ?_, ?_, hc⟩
    · rw [List.getElem?_append_right (by omega)] at hk ⊢
      rw [show kk - P.length = (kk - P.length - 1) + 1 by omega, List.getElem?_cons_succ] at hk ⊢
      exact hk
    · rw [List.take_append, List.take_of_length_le (by omega)] at hp ⊢
      rw [show kk - P.length = (kk - P.length - 1) + 1 by omega, List.take_succ_cons] at hp ⊢
      have := List.append_cancel_left hp
      simp only [List.cons.injEq, true_and] at this
      rw [← this]
  · simp only at hp hc ⊢
    have := List.append_cancel_left hp
    simp only [List.cons.injEq, true_and] at this
    exact Or.inr ⟨by rw [this], hc⟩

/-- L3.6b helper: a root at or above the move column's forest is unchanged by the move. -/
theorem resolve_unmoved_G5 {P rest : List (Nat × Nat)} {cc e e' jj q : Nat} {o : ColAddr}
    (h : (⟨P ++ (cc, e) :: rest, jj⟩ : ColAddr).resolve 0 q = some o)
    (hlen : o.path.length ≤ P.length) :
    (⟨P ++ (cc, e') :: rest, jj⟩ : ColAddr).resolve 0 q = some o ∧
      o.path = P.take o.path.length ∧
      ∃ a, o.col ≤ a ∧ ((o.path.length < P.length ∧ ∃ u, P[o.path.length]? = some (a, u)) ∨
        (o.path.length = P.length ∧ a = cc)) := by
  obtain ⟨hon, hnum⟩ := (ColAddr.resolve_spec 0 _ _ q).1 h
  rcases hon with ⟨kk, ck, ik, hk, hp, hc⟩ | ⟨hp, -⟩
  · simp only at hk hp hc
    have hkk : kk < (P ++ (cc, e) :: rest).length := (List.getElem?_eq_some_iff.1 hk).1
    have hlk : o.path.length = kk := by rw [hp, List.length_take_of_le hkk.le]
    have hkP : kk ≤ P.length := by omega
    have hpP : o.path = P.take kk := by rw [hp, List.take_append_of_le_length hkP]
    rw [hlk]
    refine ⟨(ColAddr.resolve_spec 0 _ _ q).2 ⟨Or.inl ?_, hnum⟩, hpP, ck, hc, ?_⟩
    · rcases Nat.lt_or_ge kk P.length with hlt | hge
      · refine ⟨kk, ck, ik, ?_, ?_, hc⟩
        · simp only
          rw [List.getElem?_append_left hlt] at hk ⊢; exact hk
        · simp only; rw [hpP, List.take_append_of_le_length hkP]
      · have hkP' : kk = P.length := by omega
        subst hkP'
        rw [List.getElem?_append_right (le_refl _), Nat.sub_self] at hk
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hk
        refine ⟨P.length, ck, e', ?_, ?_, hc⟩
        · simp only
          rw [List.getElem?_append_right (le_refl _), Nat.sub_self, hk.1]; rfl
        · simp only; rw [hpP, List.take_append_of_le_length (le_refl _)]
    · rcases Nat.lt_or_ge kk P.length with hlt | hge
      · left
        refine ⟨hlt, ik, ?_⟩
        rw [List.getElem?_append_left hlt] at hk; exact hk
      · right
        have hkP' : kk = P.length := by omega
        subst hkP'
        rw [List.getElem?_append_right (le_refl _), Nat.sub_self] at hk
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hk
        exact ⟨rfl, hk.1.symm⟩
  · simp only at hp
    rw [hp] at hlen; simp at hlen

/-- L3.6b helper: under H, same-parent entries of a column have nonincreasing heights. -/
theorem colH_mono_G5 {E : Forest} (hH : CondH E) {c : ColAddr} {col : Column}
    (hcol : E.colAt c = some col) {q l₁ : Nat} :
    ∀ n, l₁ + n < col.length →
      (∀ x, l₁ ≤ x → x ≤ l₁ + n → (col.getD x (0, Tree.empty)).1 = q) →
      (col.getD (l₁ + n) (0, Tree.empty)).2 ≤ (col.getD l₁ (0, Tree.empty)).2 := by
  have hmem : c ∈ E.colAddrs := (Tree.mem_colAddrs_iff E c).2 (by rw [hcol]; rfl)
  intro n
  induction n with
  | zero => intro _ _; exact le_rfl
  | succ n ih =>
    intro hn hpar
    have h1 := ih (by omega) (fun x h1 h2 => hpar x h1 (by omega))
    have hx : col[l₁ + n]? = some (col.getD (l₁ + n) (0, Tree.empty)) := by
      rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (by omega)]; simp
    have hy : col[l₁ + n + 1]? = some (col.getD (l₁ + (n + 1)) (0, Tree.empty)) := by
      rw [List.getD_eq_getElem?_getD, show l₁ + (n + 1) = l₁ + n + 1 by omega,
        List.getElem?_eq_getElem (by omega)]; simp
    have hle := hH c hmem (l₁ + n) _ _ (by rw [hcol]; exact hx) (by rw [hcol]; exact hy)
    have hp1 := hpar (l₁ + n) (by omega) (by omega)
    have hp2 := hpar (l₁ + (n + 1)) (by omega) (le_refl _)
    rcases hle with h | ⟨-, h⟩
    · omega
    · exact le_trans h h1

/-- L3.6b helper (case `b = ρ`): the intervening old heights and the active cap have the same
strict sign against every query key, so the owner scan stops at or before entry `i`, and both
scans agree (trace fact (3)). -/
theorem cursor_owner_move_G5 {E : Forest} (hH : CondH E) {P : List (Nat × Nat)} {cc : Nat}
    {Ecol : Column} (hEcol : E.colAt ⟨P, cc⟩ = some Ecol) {mi mj q : Nat} {Hi Hj : Forest}
    (hij : mi < mj) (hEi : Ecol[mi]? = some (q, Hi)) (hEj : Ecol[mj]? = some (q, Hj))
    (hpar : ∀ x, mi ≤ x → x ≤ mj → (Ecol.getD x (0, Tree.empty)).1 = q)
    {c : ColAddr} {k p : Nat} (hupJ : IsUpward Hj c k p) (hHiK : Hi < litCap Hj c k p)
    (ρ t : Nat)
    (hlt : cursor ((Ecol.take mj ++ [(q, litCap Hj c k p)]).map fun x => relKey ρ x.2)
        ((((Hj.colAt c).getD []).take k).map fun x => relKey t x.2) <
      ((Ecol.take mj ++ [(q, litCap Hj c k p)]).map fun x => relKey ρ x.2).length) :
    cursor ((Ecol.take mj ++ [(q, litCap Hj c k p)]).map fun x => relKey ρ x.2)
        ((((Hj.colAt c).getD []).take k).map fun x => relKey t x.2) ≤ mi ∧
      cursor ((Ecol.take mj ++ [(q, litCap Hj c k p)]).map fun x => relKey ρ x.2)
          ((((Hj.colAt c).getD []).take k).map fun x => relKey t x.2) =
        cursor ((Ecol.take mi ++ [(q, litCap Hj c k p)]).map fun x => relKey ρ x.2)
          ((((Hj.colAt c).getD []).take k).map fun x => relKey t x.2) := by
  set Kin := litCap Hj c k p with hKin
  set qry := (((Hj.colAt c).getD []).take k).map fun x => relKey t x.2 with hqry
  set key : Nat × Forest → Key := fun x => relKey ρ x.2 with hkey
  have hjE : mj < Ecol.length := (List.getElem?_eq_some_iff.1 hEj).1
  have hiE : mi < Ecol.length := by omega
  have hgi : Ecol.getD mi (0, Tree.empty) = (q, Hi) := by
    rw [List.getD_eq_getElem?_getD, hEi]; rfl
  have hgj : Ecol.getD mj (0, Tree.empty) = (q, Hj) := by
    rw [List.getD_eq_getElem?_getD, hEj]; rfl
  -- every intervening height has the same internal cap
  have hcapl : ∀ l, mi ≤ l → l < mj → IsUpward (Ecol.getD l (0, Tree.empty)).2 c k p ∧
      litCap (Ecol.getD l (0, Tree.empty)).2 c k p = Kin := by
    intro l h1 h2
    have hlo : Hj ≤ (Ecol.getD l (0, Tree.empty)).2 := by
      have := colH_mono_G5 hH hEcol (q := q) (l₁ := l) (mj - l) (by omega)
        (fun x h3 h4 => hpar x (by omega) (by omega))
      rw [show l + (mj - l) = mj by omega, hgj] at this; exact this
    have hhi : (Ecol.getD l (0, Tree.empty)).2 ≤ Hi := by
      have := colH_mono_G5 hH hEcol (q := q) (l₁ := mi) (l - mi) (by omega)
        (fun x h3 h4 => hpar x (by omega) (by omega))
      rw [show mi + (l - mi) = l by omega, hgi] at this; exact this
    exact interval_cap hupJ hlo (lt_of_le_of_lt hhi hHiK)
  -- the sign facts
  have hsign : ∀ y ∈ qry, ∀ l, mi ≤ l → l < mj →
      keyCmp (key (Ecol.getD l (0, Tree.empty))) y = keyCmp (relKey ρ Kin) y ∧
        keyCmp (relKey ρ Kin) y ≠ .eq := by
    intro y hy l h1 h2
    obtain ⟨hupl, hcl⟩ := hcapl l h1 h2
    rw [hqry, List.mem_map] at hy
    obtain ⟨⟨qa, J⟩, hJmem, rfl⟩ := hy
    obtain ⟨a, ha, hJa⟩ := List.mem_iff_getElem.1 hJmem
    have hak : a < k := by
      have := ha; rw [List.length_take] at this; omega
    -- the query of the cap at `l` is that of `Hj`
    have hQ : ((((Ecol.getD l (0, Tree.empty)).2).colAt c).getD []).take k =
        ((Hj.colAt c).getD []).take k := by
      have e1 := stopData_litCap hupl
      have e2 := stopData_litCap hupJ
      rw [hcl] at e1
      rw [e1] at e2
      exact congrArg StopData.Q (Option.some.inj e2)
    have hJl : (((((Ecol.getD l (0, Tree.empty)).2).colAt c).getD [])[a]? = some (qa, J)) := by
      rw [← List.getElem?_take_of_lt hak, hQ, List.getElem?_eq_getElem ha, hJa]
    obtain ⟨h1, h2⟩ := sign_cap_G5 hupl ρ t hak hJl
    rw [hcl] at h1
    exact ⟨h1, h1 ▸ h2⟩
  -- the block from entry `i` on has one strict sign against every query key
  set Bl := ((Ecol.drop mi).take (mj - mi)).map key ++ [relKey ρ Kin] with hBl
  have htk : Ecol.take mj = Ecol.take mi ++ (Ecol.drop mi).take (mj - mi) := by
    conv_lhs => rw [show mj = mi + (mj - mi) by omega]
    rw [List.take_add]
  have hsrc : (Ecol.take mj ++ [(q, Kin)]).map key = (Ecol.take mi).map key ++ Bl := by
    rw [hBl, htk]; simp [hkey]
  have hblk : ∀ y ∈ qry, (∀ b ∈ Bl, b < y) ∨ (∀ b ∈ Bl, y < b) := by
    intro y hy
    have hall : ∀ b ∈ Bl, keyCmp b y = keyCmp (relKey ρ Kin) y := by
      intro b hb
      rw [hBl, List.mem_append, List.mem_map] at hb
      rcases hb with ⟨x, hx, rfl⟩ | hb
      · obtain ⟨l', hl', hxl⟩ := List.mem_iff_getElem.1 hx
        rw [List.length_take, List.length_drop] at hl'
        have hxe : x = Ecol.getD (mi + l') (0, Tree.empty) := by
          rw [← hxl, List.getElem_take, List.getElem_drop, List.getD_eq_getElem?_getD,
            List.getElem?_eq_getElem (by omega)]
          rfl
        rw [hxe]
        exact (hsign y hy (mi + l') (by omega) (by omega)).1
      · simp at hb; rw [hb]
    have hne := (hsign y hy mi le_rfl hij).2
    rcases hk : keyCmp (relKey ρ Kin) y with _ | _ | _
    · left; intro b hb; show keyCmp b y = .lt; rw [hall b hb, hk]
    · exact absurd hk hne
    · right; intro b hb
      apply compare_gt_iff_gt.1
      rw [Key.compare_eq_keyCmp, hall b hb, hk]
  have hBne : Bl ≠ [] := by simp [hBl]
  have hle : cursor ((Ecol.take mj ++ [(q, Kin)]).map key) qry ≤ mi := by
    rw [hsrc]
    have := cursor_le_of_sign_G5 Bl hBne ((Ecol.take mi).map key) qry hblk (by rw [← hsrc]; exact hlt)
    rw [List.length_map, List.length_take_of_le hiE.le] at this
    exact this
  refine ⟨hle, ?_⟩
  apply cursor_eq_of_trace_eq
  have hli : ((Ecol.take mi).map key).length = mi := by
    rw [List.length_map, List.length_take_of_le hiE.le]
  have hpre : ((Ecol.take mj ++ [(q, Kin)]).map key).take mi =
      ((Ecol.take mi ++ [(q, Kin)]).map key).take mi := by
    rw [hsrc, List.take_left' hli, List.map_append, List.take_left' hli]
  have hu₁ : mi < ((Ecol.take mj ++ [(q, Kin)]).map key).length := by
    rw [List.length_map, List.length_append, List.length_take_of_le hjE.le]; simp; omega
  have hu₂ : mi < ((Ecol.take mi ++ [(q, Kin)]).map key).length := by
    rw [List.length_map, List.length_append, List.length_take_of_le hiE.le]; simp
  refine trace_agree hpre hu₁ hu₂ ?_ hle
  intro y hy
  have e1 : ((Ecol.take mj ++ [(q, Kin)]).map key)[mi]'hu₁ =
      key (Ecol.getD mi (0, Tree.empty)) := by
    simp only [List.getElem_map]
    rw [List.getElem_append_left (by simp; omega), List.getElem_take,
      List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hiE]
    rfl
  have e2 : ((Ecol.take mi ++ [(q, Kin)]).map key)[mi]'hu₂ = relKey ρ Kin := by
    simp only [List.getElem_map]
    rw [List.getElem_append_right (by simp)]
    simp [hkey]
  rw [e1, e2, Key.compare_eq_keyCmp, Key.compare_eq_keyCmp]
  exact (hsign y hy mi le_rfl hij).1

theorem rootOf_cursor_G5 (E : Forest) (sd : StopData) (o : ColAddr) :
    (rootOf E sd o).cursor = cursor (((E.colAt o).getD []).map fun x => relKey (o.num 0) x.2)
      (sd.Q.map fun x => relKey sd.t x.2) := by
  unfold rootOf Tree.colAt
  cases E.forestAt o.path <;> rfl

/-- L3.6b helper: the root column and owner flag of a literal cap whose root lies on the cap's
path at the level of `o`. -/
theorem litCap_root_G5 {E : Forest} {cs : ColAddr} {k p : Nat} {col0 : Column}
    (hcol0 : E.colAt cs = some col0) (sd : StopData) {o : ColAddr} {τ : List (Nat × Nat)}
    {a u : Nat} (hcs : cs.path = o.path ++ (a, u) :: τ) (hxa : o.col ≤ a) {gcols : List Column}
    (hG : E.forestAt o.path = some (.node gcols)) :
    ∃ qu hu, (gcols.getD a [])[u]? = some (qu, hu) ∧
      ((rootOf (litCap E cs k p) sd o).owner = true ↔ o.col = a) ∧
      (litCap E cs k p).colAt o = some (if o.col = a then
        (gcols.getD a []).take u ++ [(qu, litCapAux k p τ cs.col hu)] else gcols.getD o.col []) := by
  have hfs : (E.forestAt cs.path).isSome := by
    unfold Tree.colAt at hcol0
    cases h : E.forestAt cs.path with
    | none => rw [h] at hcol0; cases hcol0
    | some _ => rfl
  rw [hcs, Tree.forestAt_append, hG, Option.bind_some, forestAt_node_cons] at hfs
  obtain ⟨x, hx, -⟩ : ∃ x, (gcols[a]?.bind (·[u]?)) = some x ∧ True := by
    cases h1 : (gcols[a]?.bind (·[u]?)) with
    | none => rw [h1] at hfs; simp at hfs
    | some x => exact ⟨x, rfl, trivial⟩
  obtain ⟨colc, hcc, hx'⟩ := Option.bind_eq_some_iff.1 hx
  obtain ⟨qu, hu⟩ := x
  have hg : (gcols.getD a [])[u]? = some (qu, hu) := by
    rw [List.getD_eq_getElem?_getD, hcc]; exact hx'
  have ha : a < gcols.length := (List.getElem?_eq_some_iff.1 hcc).1
  have hpre : o.path <+: cs.path := ⟨(a, u) :: τ, hcs.symm⟩
  have hF : (litCap E cs k p).forestAt o.path =
      some (.node (gcols.take a ++ [(gcols.getD a []).take u ++ [(qu, litCapAux k p τ cs.col hu)]])) := by
    rw [litCap_eq_aux hcol0, forestAt_litCapAux_prefix k p cs.col cs.path o.path E hpre ⟨col0, hcol0⟩,
      hG, Option.map_some]
    have hdrop : cs.path.drop o.path.length = (a, u) :: τ := by rw [hcs]; simp
    rw [hdrop, litCapAux_cons k p a u cs.col τ gcols hg]
  have hlen : (gcols.take a).length = a := List.length_take_of_le ha.le
  refine ⟨qu, hu, hg, ?_, ?_⟩
  · unfold rootOf
    simp only [hF, Option.getD_some, Tree.cols, List.length_append, List.length_singleton, hlen,
      beq_iff_eq]
    omega
  · unfold Tree.colAt
    rw [hF, Option.bind_some]
    simp only [Tree.cols]
    split_ifs with h
    · rw [List.getElem?_append_right (by omega), hlen, h, Nat.sub_self]; rfl
    · have hlt : o.col < a := by omega
      rw [List.getElem?_append_left (by omega), List.getElem?_take_of_lt hlt,
        List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (by omega)]
      rfl

-- L3.6b (txt:466-481): success transfers backward through one legal move
-- VERIFY-U2 (F5): `hP` added; step 1 gets S of the cap from L3.1e, which needs P of `B`
theorem success_unmove {B : Forest} (hL : InL B) (hP : CondP B) {cj ci : ColAddr} {k p : Nat}
    (hj : IsUpward B cj k p) (hi : IsUpward B ci k p)
    (hjV : CondV (litCap B cj k p)) (hjI : CondI (litCap B cj k p))
    (hjA : CondAK (litCap B cj k p) (capKeys (litCap B cj k p) (routeCols (litCap B cj k p))))
    (hmove : ∃ m, MoveOK (litCap B cj k p) m ∧ applyMove (litCap B cj k p) m = litCap B ci k p)
    (hsucc : Success (litCap B ci k p) (localSuffix B ci)) :
    Success (litCap B cj k p) (localSuffix B cj) := by
  have hge := repair_suffix_ge hL.2.2.1 hj hi hmove
  obtain ⟨m, hm, heq⟩ := hmove
  have hiV : CondV (litCap B ci k p) := by
    have := (decoratedA_applyMove hm hjV hjA).1
    rwa [heq] at this
  -- `K_j` is defined: S by L3.1e, A by capping, then L2.4
  have hSj := upward_condS hL.1 hL.2.1 hL.2.2.1 hP hj hjV hjI
  have hAj : CondA (litCap B cj k p) := (capping_iff hjV hSj (fun a ha => ha)).2 hjA
  have hordj := litCap_ordinary hL.2.1 hj hjV hjI
  obtain ⟨rdj, hrdj⟩ := Option.isSome_iff_exists.1 (rootData_of_ordinary hordj)
  have hsdj := stopData_litCap hj
  have hcurj : rdj.owner = true →
      rdj.cursor < (((litCap B cj k p).colAt rdj.col).getD []).length :=
    fun ho => owner_root_nonexhaust hjV hAj hSj hsdj hrdj ho
  have hkdj : KernelDefined (litCap B cj k p) rdj := by
    intro ho h0
    have := hcurj ho
    unfold unconsumed rootCol at h0
    rw [List.drop_eq_nil_iff] at h0; omega
  obtain ⟨sdi, rdi, hsdi, hrdi, hkdi, hlti⟩ := hsucc
  have hsdi' := stopData_litCap hi
  rw [hsdi'] at hsdi
  obtain rfl := Option.some.inj hsdi
  have hcuri : rdi.owner = true →
      rdi.cursor < (((litCap B ci k p).colAt rdi.col).getD []).length := by
    intro ho
    have h0 := hkdi ho
    unfold unconsumed rootCol at h0
    by_contra hh
    exact h0 (List.drop_eq_nil_of_le (by omega))
  refine ⟨_, rdj, hsdj, hrdj, hkdj, ?_⟩
  -- the data of the move
  obtain ⟨rest, Ecol, q, Hi, Hj, hrest, hEcol, hEi, hEj, hij, -, hupJ, -, hcapeq, hpar, hHiK,
    hKcol⟩ := move_data_G5 hL.2.2.1 hj hm
  obtain ⟨rest', hrest', hupI', hmv', htk⟩ := litCap_move_step hL.2.2.1 hj hm
  have hr : rest' = rest := by
    rw [hrest] at hrest'
    have := List.append_cancel_left hrest'
    simp only [List.cons.injEq, true_and] at this
    exact this.symm
  rw [hr] at hupI' hmv' htk
  have hci : ci = ⟨m.col.path ++ (m.col.col, m.i) :: rest, cj.col⟩ := by
    have e1 := stopData_litCap hi
    rw [← heq, hmv', stopData_litCap hupI'] at e1
    exact (congrArg StopData.col (Option.some.inj e1)).symm
  obtain ⟨⟨P, cc⟩, mi, mj⟩ := m
  obtain ⟨cjp, jj⟩ := cj
  simp only at hrest hci hEcol hEi hEj hij hKcol hpar htk hupJ hHiK hcapeq
  subst hrest hci
  have hKcoli : (litCap B ⟨P ++ (cc, mi) :: rest, jj⟩ k p).colAt ⟨P, cc⟩ =
      some (Ecol.take mi ++ [(q, litCap Hj ⟨rest, jj⟩ k p)]) := by
    obtain ⟨col1, hcol1, -, -⟩ := isUpward_iff_exists.1 hi
    rw [litCap_colAt_through_G5 hcol1 rfl hEcol hEi, hcapeq]
  have hjE : mj < Ecol.length := (List.getElem?_eq_some_iff.1 hEj).1
  have hiE : mi < Ecol.length := by omega
  -- the roots
  obtain ⟨-, oj, hoj, rfl⟩ := rootData_unpack hsdj hrdj
  obtain ⟨-, oi, hoi, rfl⟩ := rootData_unpack hsdi' hrdi
  simp only at hoj hoi
  have hnum : (⟨P ++ (cc, mi) :: rest, jj⟩ : ColAddr).num 0 =
      (⟨P ++ (cc, mj) :: rest, jj⟩ : ColAddr).num 0 := num_move_G5 P rest cc mi mj jj
  by_cases hA : P.length < oj.path.length
  · -- `b < ρ`: the root lies inside the moved entry; both kernels are the same
    have hpre : oj.path <+: P ++ (cc, mj) :: rest := by
      obtain ⟨hon, -⟩ := (ColAddr.resolve_spec 0 _ _ _).1 hoj
      rcases hon with ⟨kk, ck, ik, -, hp, -⟩ | ⟨hp, -⟩
      · rw [hp]; exact List.take_prefix _ _
      · rw [hp]
    obtain ⟨π', hπ'⟩ : ∃ π', oj.path = P ++ (cc, mj) :: π' := by
      have h1 := List.prefix_iff_eq_take.1 hpre
      rw [List.take_append, List.take_of_length_le (by omega),
        show oj.path.length - P.length = (oj.path.length - P.length - 1) + 1 by omega,
        List.take_succ_cons] at h1
      exact ⟨_, h1⟩
    have hoj' : (⟨P ++ (cc, mj) :: rest, jj⟩ : ColAddr).resolve 0 p =
        some ⟨P ++ (cc, mj) :: π', oj.col⟩ := by
      rw [hoj, ← hπ']
    have hoi' := resolve_moved_G5 (e' := mi) hoj'
    rw [hoi'] at hoi
    obtain rfl := Option.some.inj hoi
    have hF : (litCap B ⟨P ++ (cc, mj) :: rest, jj⟩ k p).forestAt oj.path =
        (litCap B ⟨P ++ (cc, mi) :: rest, jj⟩ k p).forestAt (P ++ (cc, mi) :: π') := by
      rw [hπ', litCap_forestAt_through_G5 hKcol (List.length_take_of_le hjE.le),
        litCap_forestAt_through_G5 hKcoli (List.length_take_of_le hiE.le)]
    have hkeq := kernel_congr_G5 (sd := ⟨colDepth ⟨P ++ (cc, mj) :: rest, jj⟩,
        ⟨P ++ (cc, mj) :: rest, jj⟩, (⟨P ++ (cc, mj) :: rest, jj⟩ : ColAddr).num 0, p,
        ((B.colAt ⟨P ++ (cc, mj) :: rest, jj⟩).getD []).take k⟩)
      (sd' := ⟨colDepth ⟨P ++ (cc, mi) :: rest, jj⟩,
        ⟨P ++ (cc, mi) :: rest, jj⟩, (⟨P ++ (cc, mi) :: rest, jj⟩ : ColAddr).num 0, p,
        ((B.colAt ⟨P ++ (cc, mi) :: rest, jj⟩).getD []).take k⟩)
      (o := oj) (o' := ⟨P ++ (cc, mi) :: π', oj.col⟩)
      hF (by simp [hπ']) rfl (by simp only [ColAddr.num, hπ']; simp) htk.symm hnum.symm
      rfl (by simp [colDepth])
    rw [← hkeq] at hlti
    rw [← word_lt_iff, word_kernel hjV hsdj hrdj hkdj] at hlti ⊢
    exact success_anti _ (kerPrefix_ne_nil _ _ _) (kerSigma_strictMono _ _) (word_le_of_le hge) hlti
  · -- `b ≥ ρ`: the root lies at or above the move column's forest
    rw [not_lt] at hA
    obtain ⟨hoi', hpath, a, hxa, hcase⟩ := resolve_unmoved_G5 (e' := mi) hoj hA
    rw [hoi'] at hoi
    obtain rfl := Option.some.inj hoi
    have hfx : ∀ x, IsUpward B ⟨P ++ (cc, x) :: rest, jj⟩ k p →
        (B.forestAt (P ++ (cc, x) :: rest)).isSome := by
      intro x hx
      obtain ⟨col1, hcol1, -, -⟩ := isUpward_iff_exists.1 hx
      unfold Tree.colAt at hcol1
      cases h : B.forestAt (P ++ (cc, x) :: rest) with
      | none => simp only at hcol1; rw [h] at hcol1; cases hcol1
      | some _ => rfl
    set Kj := litCap B ⟨P ++ (cc, mj) :: rest, jj⟩ k p with hKj
    set Ki := litCap B ⟨P ++ (cc, mi) :: rest, jj⟩ k p with hKi
    set sdJ : StopData := ⟨colDepth ⟨P ++ (cc, mj) :: rest, jj⟩, ⟨P ++ (cc, mj) :: rest, jj⟩,
        (⟨P ++ (cc, mj) :: rest, jj⟩ : ColAddr).num 0, p,
        ((B.colAt ⟨P ++ (cc, mj) :: rest, jj⟩).getD []).take k⟩ with hsdJ
    set sdI : StopData := ⟨colDepth ⟨P ++ (cc, mi) :: rest, jj⟩, ⟨P ++ (cc, mi) :: rest, jj⟩,
        (⟨P ++ (cc, mi) :: rest, jj⟩ : ColAddr).num 0, p,
        ((B.colAt ⟨P ++ (cc, mi) :: rest, jj⟩).getD []).take k⟩ with hsdI
    -- the comparison, once the two roots agree
    have finish : ∀ u, (P ++ [(cc, mi)])[oj.path.length]? = some (a, u) →
        rootOf (litCap B ⟨P ++ (cc, mi) :: rest, jj⟩ k p)
            ⟨colDepth ⟨P ++ (cc, mi) :: rest, jj⟩, ⟨P ++ (cc, mi) :: rest, jj⟩,
              (⟨P ++ (cc, mi) :: rest, jj⟩ : ColAddr).num 0, p,
              ((B.colAt ⟨P ++ (cc, mi) :: rest, jj⟩).getD []).take k⟩ oj =
          rootOf (litCap B ⟨P ++ (cc, mj) :: rest, jj⟩ k p)
            ⟨colDepth ⟨P ++ (cc, mj) :: rest, jj⟩, ⟨P ++ (cc, mj) :: rest, jj⟩,
              (⟨P ++ (cc, mj) :: rest, jj⟩ : ColAddr).num 0, p,
              ((B.colAt ⟨P ++ (cc, mj) :: rest, jj⟩).getD []).take k⟩ oj →
        (a = oj.col → (rootOf (litCap B ⟨P ++ (cc, mj) :: rest, jj⟩ k p)
            ⟨colDepth ⟨P ++ (cc, mj) :: rest, jj⟩, ⟨P ++ (cc, mj) :: rest, jj⟩,
              (⟨P ++ (cc, mj) :: rest, jj⟩ : ColAddr).num 0, p,
              ((B.colAt ⟨P ++ (cc, mj) :: rest, jj⟩).getD []).take k⟩ oj).cursor ≤ u) →
        localSuffix B ⟨P ++ (cc, mj) :: rest, jj⟩ <
          kernel (litCap B ⟨P ++ (cc, mj) :: rest, jj⟩ k p)
            ⟨colDepth ⟨P ++ (cc, mj) :: rest, jj⟩, ⟨P ++ (cc, mj) :: rest, jj⟩,
              (⟨P ++ (cc, mj) :: rest, jj⟩ : ColAddr).num 0, p,
              ((B.colAt ⟨P ++ (cc, mj) :: rest, jj⟩).getD []).take k⟩
            (rootOf (litCap B ⟨P ++ (cc, mj) :: rest, jj⟩ k p)
              ⟨colDepth ⟨P ++ (cc, mj) :: rest, jj⟩, ⟨P ++ (cc, mj) :: rest, jj⟩,
                (⟨P ++ (cc, mj) :: rest, jj⟩ : ColAddr).num 0, p,
                ((B.colAt ⟨P ++ (cc, mj) :: rest, jj⟩).getD []).take k⟩ oj)
            (localSuffix B ⟨P ++ (cc, mj) :: rest, jj⟩) := by
      intro u hn hrd hc
      rw [hrd] at hlti hrdi
      refine lt_of_le_of_lt hge (lt_trans hlti ?_)
      rw [filling_identity hiV hsdi' hrdi, filling_identity hjV hsdj hrdj,
        context_pathCut_G5 hi hsdi', context_pathCut_G5 hj hsdj]
      simp only [period]
      have hQI : sdI.Q = sdJ.Q := htk
      have htI : sdI.t = sdJ.t := hnum
      have hrI : sdI.r = sdJ.r := rfl
      rw [hQI, htI, hrI]
      apply diamond_shift_lt_G5 _ _ _ (by unfold rootTail; exact List.cons_ne_nil _ _)
        (by unfold rootTail; exact List.cons_ne_nil _ _)
      exact rootTail_cut_lt_G5 rfl hEcol hij hjE (hfx mi hi) (hfx mj hj) hn hpath hxa hc
    -- the root forest
    obtain ⟨FP, hFP, hFPc⟩ : ∃ FP, B.forestAt P = some FP ∧ FP.cols[cc]? = some Ecol := by
      unfold Tree.colAt at hEcol
      obtain ⟨FP, h1, h2⟩ := Option.bind_eq_some_iff.1 hEcol
      exact ⟨FP, h1, h2⟩
    obtain ⟨gcols, hG⟩ : ∃ gcols, B.forestAt oj.path = some (.node gcols) := by
      have h1 : B.forestAt P = (B.forestAt (P.take oj.path.length)).bind
          fun F => F.forestAt (P.drop oj.path.length) := by
        rw [← Tree.forestAt_append, List.take_append_drop]
      rw [hFP, ← hpath] at h1
      cases h2 : B.forestAt oj.path with
      | none => rw [h2] at h1; cases h1
      | some G => obtain ⟨gc⟩ := G; exact ⟨gc, rfl⟩
    obtain ⟨col0j, hcol0j, -, -⟩ := isUpward_iff_exists.1 hj
    obtain ⟨col0i, hcol0i, -, -⟩ := isUpward_iff_exists.1 hi
    -- both cursors read the same query
    have hcj := rootOf_cursor_G5 Kj sdJ oj
    have hci := rootOf_cursor_G5 Ki sdI oj
    have hQI : sdI.Q = sdJ.Q := htk
    have htI : sdI.t = sdJ.t := hnum
    rw [hQI, htI] at hci
    -- the roots agree once owner flags and cursors do
    have hrdeq : ∀ (hown : (rootOf (litCap B ⟨P ++ (cc, mi) :: rest, jj⟩ k p)
            ⟨colDepth ⟨P ++ (cc, mi) :: rest, jj⟩, ⟨P ++ (cc, mi) :: rest, jj⟩,
              (⟨P ++ (cc, mi) :: rest, jj⟩ : ColAddr).num 0, p,
              ((B.colAt ⟨P ++ (cc, mi) :: rest, jj⟩).getD []).take k⟩ oj).owner =
          (rootOf (litCap B ⟨P ++ (cc, mj) :: rest, jj⟩ k p)
            ⟨colDepth ⟨P ++ (cc, mj) :: rest, jj⟩, ⟨P ++ (cc, mj) :: rest, jj⟩,
              (⟨P ++ (cc, mj) :: rest, jj⟩ : ColAddr).num 0, p,
              ((B.colAt ⟨P ++ (cc, mj) :: rest, jj⟩).getD []).take k⟩ oj).owner)
        (hcur : (rootOf (litCap B ⟨P ++ (cc, mi) :: rest, jj⟩ k p)
            ⟨colDepth ⟨P ++ (cc, mi) :: rest, jj⟩, ⟨P ++ (cc, mi) :: rest, jj⟩,
              (⟨P ++ (cc, mi) :: rest, jj⟩ : ColAddr).num 0, p,
              ((B.colAt ⟨P ++ (cc, mi) :: rest, jj⟩).getD []).take k⟩ oj).cursor =
          (rootOf (litCap B ⟨P ++ (cc, mj) :: rest, jj⟩ k p)
            ⟨colDepth ⟨P ++ (cc, mj) :: rest, jj⟩, ⟨P ++ (cc, mj) :: rest, jj⟩,
              (⟨P ++ (cc, mj) :: rest, jj⟩ : ColAddr).num 0, p,
              ((B.colAt ⟨P ++ (cc, mj) :: rest, jj⟩).getD []).take k⟩ oj).cursor),
        rootOf (litCap B ⟨P ++ (cc, mi) :: rest, jj⟩ k p)
            ⟨colDepth ⟨P ++ (cc, mi) :: rest, jj⟩, ⟨P ++ (cc, mi) :: rest, jj⟩,
              (⟨P ++ (cc, mi) :: rest, jj⟩ : ColAddr).num 0, p,
              ((B.colAt ⟨P ++ (cc, mi) :: rest, jj⟩).getD []).take k⟩ oj =
          rootOf (litCap B ⟨P ++ (cc, mj) :: rest, jj⟩ k p)
            ⟨colDepth ⟨P ++ (cc, mj) :: rest, jj⟩, ⟨P ++ (cc, mj) :: rest, jj⟩,
              (⟨P ++ (cc, mj) :: rest, jj⟩ : ColAddr).num 0, p,
              ((B.colAt ⟨P ++ (cc, mj) :: rest, jj⟩).getD []).take k⟩ oj := by
      intro hown hcur
      have e : ∀ r : RootData, r = ⟨r.layer, r.idx, r.col, r.owner, r.cursor⟩ := fun _ => rfl
      rw [e (rootOf (litCap B ⟨P ++ (cc, mi) :: rest, jj⟩ k p) _ oj), hown, hcur]
      rfl
    have hcolj : (rootOf Kj sdJ oj).col = oj := rfl
    have hcoli : (rootOf Ki sdI oj).col = oj := rfl
    rw [hcolj] at hcurj
    rw [hcoli] at hcuri
    rcases hcase with ⟨hn, u, hPu⟩ | ⟨hn, hacc⟩
    · -- the root forest lies strictly above the move column's forest
      have hsplitP := split_at_G5 hPu
      have hcs : ∀ x, (⟨P ++ (cc, x) :: rest, jj⟩ : ColAddr).path =
          oj.path ++ (a, u) :: (P.drop (oj.path.length + 1) ++ (cc, x) :: rest) := by
        intro x
        show P ++ (cc, x) :: rest = _
        conv_lhs => rw [hsplitP]
        rw [← hpath]; simp
      obtain ⟨quj, huj, hgj, hownj, hRj⟩ := litCap_root_G5 (k := k) (p := p) hcol0j sdJ (hcs mj) hxa hG
      obtain ⟨qui, hui, hgi, howni, hRi⟩ := litCap_root_G5 (k := k) (p := p) hcol0i sdI (hcs mi) hxa hG
      rw [hgj] at hgi
      obtain ⟨rfl, rfl⟩ := Prod.mk.inj (Option.some.inj hgi)
      have hn' : (P ++ [(cc, mi)])[oj.path.length]? = some (a, u) := by
        rw [List.getElem?_append_left hn]; exact hPu
      have hown_eq : (rootOf Ki sdI oj).owner = (rootOf Kj sdJ oj).owner :=
        Bool.eq_iff_iff.2 (howni.trans hownj.symm)
      by_cases hown : oj.col = a
      · -- an owner root above the move: only its last key changes (trace fact (2))
        rw [if_pos hown] at hRj hRi
        have hu : u < (gcols.getD a []).length := (List.getElem?_eq_some_iff.1 hgj).1
        have hbj := hcurj (hownj.2 hown)
        have hbi := hcuri (howni.2 hown)
        have hbj0 := hbj
        rw [hRj, Option.getD_some] at hbj0
        rw [hcj, hRj, Option.getD_some] at hbj
        rw [hci, hRi, Option.getD_some] at hbi
        have hcur : (rootOf Ki sdI oj).cursor = (rootOf Kj sdJ oj).cursor := by
          rw [hci, hcj, hRi, hRj, Option.getD_some, Option.getD_some]
          apply cursor_eq_dropLast_G5 (by simp) (by simp) (by simp)
            (by simpa using hbi) (by simpa using hbj)
        refine finish u hn' (hrdeq hown_eq hcur) (fun _ => ?_)
        simp only [List.length_append, List.length_take_of_le hu.le, List.length_singleton] at hbj0
        show (rootOf Kj sdJ oj).cursor ≤ u
        omega
      · -- a root column before the path: its column is unchanged
        rw [if_neg hown] at hRj hRi
        have hcur : (rootOf Ki sdI oj).cursor = (rootOf Kj sdJ oj).cursor := by
          rw [hci, hcj, hRi, hRj]
        exact finish u hn' (hrdeq hown_eq hcur) (fun h => absurd h.symm hown)
    · -- the root forest is the move column's forest
      subst a
      have hpP : oj.path = P := by rw [hpath, hn, List.take_length]
      have hcs : ∀ x, (⟨P ++ (cc, x) :: rest, jj⟩ : ColAddr).path = oj.path ++ (cc, x) :: rest := by
        intro x; rw [hpP]
      have hn' : (P ++ [(cc, mi)])[oj.path.length]? = some (cc, mi) := by
        rw [hn, List.getElem?_append_right (le_refl _), Nat.sub_self]; rfl
      obtain ⟨quj, huj, hgj, hownj, hRj⟩ := litCap_root_G5 (k := k) (p := p) hcol0j sdJ (hcs mj) hxa hG
      obtain ⟨qui, hui, hgi, howni, hRi⟩ := litCap_root_G5 (k := k) (p := p) hcol0i sdI (hcs mi) hxa hG
      have hown_eq : (rootOf Ki sdI oj).owner = (rootOf Kj sdJ oj).owner :=
        Bool.eq_iff_iff.2 (howni.trans hownj.symm)
      by_cases hown : oj.col = cc
      · -- `b = ρ`: the move column is the root (trace fact (3))
        have hoj : oj = ⟨P, cc⟩ := by
          obtain ⟨op, oc⟩ := oj
          simp only at hpP hown
          rw [hpP, hown]
        have hRj' : Kj.colAt oj = some (Ecol.take mj ++ [(q, litCap Hj ⟨rest, jj⟩ k p)]) := by
          rw [hoj]; exact hKcol
        have hRi' : Ki.colAt oj = some (Ecol.take mi ++ [(q, litCap Hj ⟨rest, jj⟩ k p)]) := by
          rw [hoj]; exact hKcoli
        have hbj := hcurj (hownj.2 hown)
        rw [hcj, hRj', Option.getD_some] at hbj
        have hBcol : B.colAt ⟨P ++ (cc, mj) :: rest, jj⟩ = Hj.colAt ⟨rest, jj⟩ :=
          colAt_through_of hEcol hEj
        have hQJ : sdJ.Q = ((Hj.colAt ⟨rest, jj⟩).getD []).take k := by
          show ((B.colAt _).getD []).take k = _
          rw [hBcol]
        rw [hQJ] at hbj
        obtain ⟨hle, heqc⟩ := cursor_owner_move_G5 hL.2.2.1 hEcol hij hEi hEj hpar hupJ hHiK
          (oj.num 0) sdJ.t (by rw [List.length_map]; exact hbj)
        have hcur : (rootOf Ki sdI oj).cursor = (rootOf Kj sdJ oj).cursor := by
          rw [hci, hcj, hRi', hRj', Option.getD_some, Option.getD_some, hQJ]
          exact heqc.symm
        refine finish mi hn' (hrdeq hown_eq hcur) (fun _ => ?_)
        show (rootOf Kj sdJ oj).cursor ≤ mi
        rw [hcj, hRj', Option.getD_some, hQJ]
        exact hle
      · -- a root column before the move column in its forest: unchanged
        rw [if_neg hown] at hRj hRi
        have hcur : (rootOf Ki sdI oj).cursor = (rootOf Kj sdJ oj).cursor := by
          rw [hci, hcj, hRi, hRj]
        exact finish mi hn' (hrdeq hown_eq hcur) (fun h => absurd h.symm hown)

/-- L3.6 helper: a literal cap determines its column. -/
theorem litCap_inj_E5 {B : Forest} {c₁ c₂ : ColAddr} {k p : Nat} (h₁ : IsUpward B c₁ k p)
    (h₂ : IsUpward B c₂ k p) (h : litCap B c₁ k p = litCap B c₂ k p) : c₁ = c₂ := by
  have e₁ := stopData_litCap h₁
  have e₂ := stopData_litCap h₂
  rw [h, e₂] at e₁
  have := congrArg StopData.col (Option.some.inj e₁)
  exact this.symm


/-- L3.6 helper: prefixes of a valid move list are valid. -/
theorem movesValid_take_E5 {K : Forest} {ms : List Move} (h : MovesValid K ms) (s : Nat) :
    MovesValid K (ms.take s) := by
  intro idx hidx
  have hidx' : idx < ms.length := by simp at hidx; omega
  have := h idx hidx'
  rw [List.take_take, Nat.min_eq_left (by simp at hidx; omega)]
  simpa using this


theorem applyMoves_take_succ_E5 (K : Forest) (ms : List Move) {s : Nat} (hs : s < ms.length) :
    applyMoves K (ms.take (s + 1)) = applyMove (applyMoves K (ms.take s)) ms[s] := by
  unfold applyMoves
  rw [List.take_add_one, List.getElem?_eq_getElem hs, Option.toList_some, List.foldl_append]
  rfl

-- provides: U2, L3.6 (txt:459-481): cap completion
theorem cap_completion {B : Forest} (hL : InL B) (hP : CondP B) (hcof : Cof B) : CC B := by
  intro c k p hup hKV hKI hKA
  obtain ⟨w, hwc, hwk, hwp, -, c', hup', hwH⟩ := repair hL hP hup hKV hKI hKA
  have hH : applyMoves (litCap B c k p) w.moves = litCap B c' k p := by
    rw [← hwH]; unfold AdmCap.H; rw [hwc, hwk, hwp]
  have hMV : MovesValid (litCap B c k p) w.moves := by
    have := w.movesValid; rwa [hwc, hwk, hwp] at this
  have hHL : InL (litCap B c' k p) := by
    have := w.inL; rw [hwc, hwk, hwp, hH] at this; exact this
  -- the last cap succeeds
  have hcov : Covers (litCap B c' k p) B :=
    covers_of_gt hcof hHL (litCap_ne_empty_E5 hup') (litCap_last_ne_E5 hup') (lt_litCap hup')
      le_rfl (fun K0 h0 => expand_zero_litCap_lt hL.2.1 hup' hHL.1 hHL.2.1 h0)
  have hsuccEnd := (covers_iff_success hL.2.1 hup' hHL.1 hHL.2.1 (fun _ hrd =>
    kernelDefined_of_inL_E5 hHL (litCap_ordinary hL.2.1 hup' hHL.1 hHL.2.1) (stopData_litCap hup')
      hrd)).1 hcov
  -- the intermediate caps are upward literal caps with V, I and decorated A
  have hfwd : ∀ s, ∃ cs, IsUpward B cs k p ∧
      applyMoves (litCap B c k p) (w.moves.take s) = litCap B cs k p ∧
      CondV (litCap B cs k p) ∧ CondI (litCap B cs k p) ∧
      CondAK (litCap B cs k p) (capKeys (litCap B cs k p) (routeCols (litCap B cs k p))) := by
    intro s
    induction s with
    | zero => exact ⟨c, hup, by simp [applyMoves], hKV, hKI, hKA⟩
    | succ s ih =>
      obtain ⟨cs, hups, heqs, hVs, hIs, hAs⟩ := ih
      obtain ⟨c'', hup'', heq'', -⟩ :=
        applyMoves_litCap hL.2.2.1 hup (movesValid_take_E5 hMV (s + 1))
      refine ⟨c'', hup'', heq'', ?_⟩
      by_cases hs : s < w.moves.length
      · have hok : MoveOK (litCap B cs k p) w.moves[s] := by
          have := hMV s hs; rwa [heqs] at this
        obtain ⟨hV', hI', hA'⟩ := decoratedA_applyMove hok hVs hAs
        rw [← heq'', applyMoves_take_succ_E5 _ _ hs, heqs]
        exact ⟨hV', hI' hIs, hA'⟩
      · have h1 : w.moves.take (s + 1) = w.moves.take s := by
          rw [List.take_of_length_le (by omega), List.take_of_length_le (by omega)]
        rw [h1, heqs] at heq''
        rw [← heq'']
        exact ⟨hVs, hIs, hAs⟩
  choose cs hups heqs hVs hIs hAs using hfwd
  -- backward induction through the moves
  have hback : ∀ t, t ≤ w.moves.length →
      Success (litCap B (cs (w.moves.length - t)) k p) (localSuffix B (cs (w.moves.length - t))) := by
    intro t
    induction t with
    | zero =>
      intro _
      have h1 := heqs w.moves.length
      rw [List.take_length, hH] at h1
      rw [Nat.sub_zero, ← litCap_inj_E5 hup' (hups _) h1]
      exact hsuccEnd
    | succ t ih =>
      intro ht
      have ih := ih (by omega)
      set s := w.moves.length - (t + 1) with hsdef
      have hs : s < w.moves.length := by omega
      have hs1 : w.moves.length - t = s + 1 := by omega
      rw [hs1] at ih
      have hok : MoveOK (litCap B (cs s) k p) w.moves[s] := by
        have := hMV s hs; rwa [heqs] at this
      have hmv : applyMove (litCap B (cs s) k p) w.moves[s] = litCap B (cs (s + 1)) k p := by
        rw [← heqs s, ← heqs (s + 1), applyMoves_take_succ_E5 _ _ hs]
      exact success_unmove hL hP (hups s) (hups (s + 1)) (hVs s) (hIs s) (hAs s)
        ⟨w.moves[s], hok, hmv⟩ ih
  have h0 := hback w.moves.length le_rfl
  rw [Nat.sub_self] at h0
  have he0 := heqs 0
  simp only [List.take_zero, applyMoves, List.foldl_nil] at he0
  rw [litCap_inj_E5 hup (hups 0) he0]
  exact h0

/-- T3.8i helper: the full cut of a branch column appends one atom to the word. -/
theorem branch_litCap_E5 (p : Nat) : ∀ (l i k e : Nat), l ≤ k →
    wordAt e (litCapAux 1 p (List.replicate l (0, 0)) 0 (Tree.node [branch i k])) =
      wordAt e (Tree.node [branch i k]) ++ [toLex (2 * (e + l) + 1, toLex (0, p))]
  | 0, i, k, e, _ => by
    rw [spx_branch]
    simp [litCapAux, wordAt, wordCols, wordCol, wordLater, Tree.empty]
  | l + 1, i, k + 1, e, hl => by
    have ih := branch_litCap_E5 p l (i + 1) k (e + 1) (by omega)
    simp only [List.replicate_succ, branch, litCapAux, List.getD_cons_zero, List.getElem?_cons_zero,
      List.take_zero, List.nil_append]
    simp only [wordAt, wordCols, wordCol, wordLater, List.append_nil] at ih ⊢
    rw [ih, show e + 1 + l = e + (l + 1) by omega, List.cons_append]
  | l + 1, i, 0, e, hl => by omega


theorem seed_full_E5 (m : Nat) {c : ColAddr} {col : Column}
    (hcol : (seed (m + 1)).colAt c = some col) (hne : col ≠ []) :
    capPos (seed (m + 1)) c 1 = mu (seed (m + 1)) := by
  have hc : ((seed (m + 1)).colAt c).isSome := by rw [hcol]; rfl
  unfold capPos litCap litCapBody
  rw [if_pos hc]
  unfold mu word
  obtain ⟨P, j⟩ := c
  cases P with
  | nil =>
    simp only [seed, Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols] at hcol
    match j, hcol with
    | 0, h => simp at h; exact absurd h hne
    | 1, h =>
      simp only [seed]
      rw [spx_branch]
      simp [litCapAux, wordAt, wordCols, wordCol, wordLater, Tree.empty]
    | j + 2, h => simp at h
  | cons x P =>
    obtain ⟨a, b⟩ := x
    have hcol' := hcol
    rw [seed, Tree.colAt_cons] at hcol'
    simp only [Tree.cols] at hcol'
    match a, b, hcol' with
    | 0, b, h => simp at h
    | a + 2, b, h => simp at h
    | 1, b + 1, h => simp [spx_branch] at h
    | 1, 0, h =>
      cases m with
      | zero => simp [branch, spx_colAt_empty] at h
      | succ k =>
        simp only [branch, List.getElem?_cons_succ, List.getElem?_cons_zero, Option.bind_some] at h
        obtain ⟨l, hl, rfl, rfl, rfl⟩ := spx_branch_colAt k 1 P j col h
        have := branch_litCap_E5 0 l 1 k 1 hl
        simp only [seed, branch, litCapAux, List.getD_cons_succ, List.getD_cons_zero,
          List.getElem?_cons_zero, List.take_zero, List.nil_append, List.take_succ_cons]
        simp only [Nat.zero_add] at this ⊢
        simp only [wordAt, wordCols, wordCol, wordLater, List.append_nil,
          List.cons_append, List.nil_append] at this ⊢
        rw [this]
        simp


/-- T3.8i helper: V of a cap bounds its closing parent by the cap column's number. -/
theorem lt_num_of_capV_E5 {B : Forest} {c : ColAddr} {k p : Nat} (hup : IsUpward B c k p)
    (hKV : CondV (litCap B c k p)) : p < c.num 0 := by
  have hsd := stopData_litCap hup
  obtain ⟨hcolK, -⟩ := stopData_spec hsd
  have hent : (litCap B c k p).entryAt ⟨c, (((B.colAt c).getD []).take k).length⟩ =
      some (p, Tree.empty) := by
    unfold Tree.entryAt; rw [hcolK]; simp
  have hmemK := (Tree.mem_entryAddrs_iff _ _).2 (by rw [hent]; rfl)
  exact (condV_iff_lt _).1 hKV _ hmemK p Tree.empty hent

-- T3.8i (txt:505): seeds
theorem KS_seed (m : Nat) : KS (seed m) := by
  intro c k p hup hKL
  have hp := lt_num_of_capV_E5 hup hKL.1
  obtain ⟨col, hcol⟩ : ∃ col, (seed m).colAt c = some col := by
    have := (colAddrs_of_upward_E5 hup).1
    exact Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff _ c).1 this)
  have hup' := hup
  unfold IsUpward at hup'
  rw [hcol] at hup'
  cases m with
  | zero =>
    exfalso
    obtain ⟨P, j⟩ := c
    cases P with
    | nil =>
      simp only [seed, Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols] at hcol
      cases j with
      | zero => simp [ColAddr.num] at hp
      | succ j => simp at hcol
    | cons x P =>
      obtain ⟨a, b⟩ := x
      simp only [seed, Tree.colAt, Tree.forestAt, Tree.cols] at hcol
      cases a with
      | zero => simp at hcol
      | succ a => simp at hcol
  | succ m =>
    rcases spx_seed_colAt m c col hcol with ⟨rfl, rfl⟩ | ⟨l, hl, hnum, rfl⟩
    · simp [ColAddr.num] at hp
    · rw [spx_branch] at hup'
      cases k with
      | zero => simp at hup'; omega
      | succ k =>
        cases k with
        | zero =>
          exact covers_of_end_E5 (seed_inL _).2.1 hup hKL
            (seed_full_E5 m hcol (by rw [spx_branch]; simp))
        | succ k => simp at hup'

-- T3.8j (txt:505-506): safe prefixes of a covered target
theorem KS_safePrefix {A : Forest} (hA : InL A) (hcof : Cof A) (k : Nat) : KS (safePrefix A k) := by
  intro c k' p hup hKL
  have hB := inL_safePrefix hA k
  obtain ⟨hc, -⟩ := colAddrs_of_upward_E5 hup
  by_cases hend : capPos (safePrefix A k) c k' = mu (safePrefix A k)
  · exact covers_of_end_E5 hB.2.1 hup hKL hend
  · have hlt := lt_of_le_of_ne (capPos_le_mu_E5 hc k') hend
    refine covers_of_prefix_E5 hcof hB (safePrefix_le A k) ?_ hup hKL hlt
    intro i hi
    have hw := word_safePrefix A k
    have hik : i < k := by
      unfold mu at hi; rw [hw, List.length_take] at hi; omega
    rw [hw, List.getElem?_take, if_pos hik]

/-- T3.8e/T3.8k helper: an `L` forest whose word lies strictly between the one-copy output
`X = w(A_1)` and `w(A) = X ⌢ [z]` of a special step continues `A`'s context `W` by the owner
column `P ⌢ (p, C) ⌢ R` with every entry of `R` at most `(p, C)` (I excludes a deeper next atom,
H bounds the later entries). -/
theorem special_decode_E5 {E F : Forest} (hF : InL F) {sd : StopData} {oe : EntryAddr}
    {P : Column} {p : Nat} {Cs : List Column} {e : Nat} (hsd : stopData E = some sd)
    (hhp : oe.heightPath = sd.col.path) (hnum : oe.col.num 0 = sd.r) (_hde : sd.depth = e + 1)
    (hR : KerRoute e E)
    (hself : replaceAt 0 0 (Tree.node [P ++ [(p, Tree.node (Cs ++ [[(sd.r, Tree.empty)]]))]]) e E = E)
    {y : WordAtom} {L' : List WordAtom}
    (hFw : word F = word (replaceAt 0 0 Tree.empty e E) ++ wordCol e (P ++ [(p, Tree.node Cs)]) ++
      y :: L')
    (hyz : y < toLex (2 * (e + 1), toLex (1, sd.r))) :
    ∃ (D : Column) (R : List Column) (S : List WordAtom),
      word F = word (replaceAt 0 0 Tree.empty e E) ++
        wordAt e (Tree.node ((P ++ (p, Tree.node Cs) :: D) :: R)) ++ S ∧
      (∀ x ∈ D, EntryLe x (p, Tree.node Cs)) ∧ (∀ s ∈ S.head?, (ofLex s).1 < 2 * e) ∧
      (∀ s ∈ S, s.WF) := by
  have hwZ : ∀ Z, word (replaceAt 0 0 Z e E) =
      word (replaceAt 0 0 Tree.empty e E) ++ wordAt e Z := by
    intro Z; unfold word; rw [ker_wordAt_replaceAt Z e E 0 hR, Nat.zero_add]
  set W := word (replaceAt 0 0 Tree.empty e E) with hW
  have hw1 : ∀ c : Column, wordAt e (Tree.node [c]) = wordCol e c := by
    intro c; simp [wordAt, wordCols]
  set C : Forest := Tree.node Cs with hC
  set X := W ++ wordCol e (P ++ [(p, C)]) with hX
  set z : WordAtom := toLex (2 * (e + 1), toLex (1, sd.r)) with hz
  have hsplitC : ∀ (H : Forest) (R : Column), wordCol e (P ++ (p, H) :: R) =
      wordCol e (P ++ [(p, Tree.empty)]) ++ wordAt (e + 1) H ++ wordLater e R :=
    fun H R => wordCol_split_E5 e P p H R
  have hXC : wordCol e (P ++ [(p, C)]) = wordCol e (P ++ [(p, Tree.empty)]) ++ wordAt (e + 1) C := by
    rw [hsplitC]; simp [wordLater]
  have hwE : word E = X ++ [z] := by
    conv_lhs => rw [← hself]
    rw [hwZ, hw1, hsplitC, hX, hXC]
    simp [wordLater, wordAt, wordCols_append, wordCols, wordCol, Tree.empty, hz, List.append_assoc]
    rfl
  by_cases hdeep : 2 * (e + 1) ≤ (ofLex y).1
  · -- a column start at depth `ℓ` would break `I` of `B`
    exfalso
    have hFX : (word F).take X.length = X := by rw [hFw, List.take_left]
    have hFy : (word F)[X.length]? = some y := by rw [hFw]; simp
    obtain ⟨c, k, hc, hk', -, hk0, -, hup, hcap⟩ :=
      exists_litCap_of_word (B := F) (E := E) (π := X.length) (e := e + 1) (p := sd.r)
        (first := true) (by rw [hFX]; simpa [hz] using hwE)
        (by unfold mu; rw [hFw]; simp)
        (by intro y' hy'; rw [hFy] at hy'; cases hy'; simpa [hz] using hyz)
        (fun _ => ⟨y, hFy, hdeep⟩)
    have hk00 : k = 0 := hk0.2 rfl
    subst hk00
    have hsd2 := stopData_litCap hup
    rw [hcap, hsd] at hsd2
    have hcolE : sd.col = c := congrArg StopData.col (Option.some.inj hsd2)
    obtain ⟨colc, hcolc⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff F c).1 hc)
    have hup' := hup
    unfold IsUpward at hup'
    rw [hcolc] at hup'
    have hcolc' := hcolc
    unfold Tree.colAt at hcolc'
    rw [← hcolE, ← hhp, Tree.forestAt_heightPath] at hcolc'
    cases hH : F.heightAt oe with
    | none => rw [hH] at hcolc'; cases hcolc'
    | some h₀ =>
      rw [hH, Option.bind_some] at hcolc'
      obtain ⟨y₀, hy₀⟩ : ∃ y₀, F.entryAt oe = some (y₀, h₀) := by
        unfold Tree.heightAt at hH
        cases hE0 : F.entryAt oe with
        | none => rw [hE0] at hH; cases hH
        | some x =>
          rw [hE0] at hH
          simp only [Option.map_some, Option.some.injEq] at hH
          exact ⟨x.1, by rw [← hH]⟩
      have hmem : oe ∈ F.entryAddrs := (Tree.mem_entryAddrs_iff _ _).2 (by rw [hy₀]; rfl)
      have hne : h₀ ≠ Tree.empty := by
        intro h0; subst h0; simp [Tree.empty, Tree.cols] at hcolc'
      obtain ⟨q, H, rest, hcq, hq⟩ :=
        hF.2.1 _ hmem y₀ h₀ hy₀ hne colc (List.mem_of_getElem? hcolc')
      rw [hcq] at hup'
      simp only [List.getElem?_cons_zero] at hup'
      rw [hnum] at hq
      omega
  · -- the next atom is at most an entry continuation of the owner column
    have hFX : (word F).take X.length = X := by rw [hFw, List.take_left]
    have hFy : (word F)[X.length]? = some y := by rw [hFw]; simp
    set pb := (ofLex (ofLex y).2).2 + 1 with hpb
    have hy1 : y < toLex (2 * e + 1, toLex (0, pb)) := by
      have hwf := word_wf F y (by rw [hFw]; simp)
      rw [Prod.Lex.lt_iff]
      simp only [ofLex_toLex]
      by_cases hy1 : (ofLex y).1 < 2 * e + 1
      · exact Or.inl hy1
      · right
        refine ⟨by omega, ?_⟩
        rw [Prod.Lex.lt_iff]
        simp only [ofLex_toLex]
        unfold WordAtom.WF at hwf
        right
        refine ⟨by omega, by omega⟩
    set E' := replaceAt 0 0 (Tree.node [P ++ [(p, C), (pb, Tree.empty)]]) e E with hE'
    have hwE' : word E' = X ++ [toLex (2 * e + 1, toLex (0, pb))] := by
      rw [hE', hwZ, hw1, show P ++ [(p, C), (pb, Tree.empty)] = P ++ (p, C) :: [(pb, Tree.empty)]
        from rfl, hsplitC, hX, hXC]
      simp [wordLater, wordAt, wordCols, Tree.empty, List.append_assoc]
    obtain ⟨c', k', hc', hk', hdep', hk0', -, hup', hcap'⟩ :=
      exists_litCap_of_word (B := F) (E := E') (π := X.length) (e := e) (p := pb)
        (first := false) (by rw [hFX]; simpa using hwE')
        (by unfold mu; rw [hFw]; simp)
        (by intro y' hy'; rw [hFy] at hy'; cases hy'; simpa using hy1)
        (fun h => absurd h (by decide))
    have hk'0 : k' ≠ 0 := fun h => absurd (hk0'.1 h) (by decide)
    -- the cap column of `B` is the hole of the special step
    have hsdE' := stopData_litCap hup'
    rw [hcap'] at hsdE'
    obtain ⟨hRE', hhole⟩ := ker_stop_hole hsdE'
    simp only at hhole
    rw [hdep', hE', kerHoleAt_replaceAt_E5 _ e E hR] at hhole
    obtain ⟨hcolE', -⟩ := stopData_spec hsdE'
    simp only at hcolE'
    have hlaw := (ker_hole_law (Tree.node [P ++ [(p, C), (pb, Tree.empty)]]) hR ⟨[], 0⟩).1
    have hu : underCol (kerHoleAt e E) ⟨[], 0⟩ = kerHoleAt e E := by
      simp [underCol]
    rw [hu, hhole] at hlaw
    rw [← hE', hcolE'] at hlaw
    simp only [Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols, List.getElem?_cons_zero,
      Option.some.injEq] at hlaw
    have htk : ((F.colAt c').getD []).take k' = P ++ [(p, C)] := by
      have := hlaw
      rw [show P ++ [(p, C), (pb, Tree.empty)] = (P ++ [(p, C)]) ++ [(pb, Tree.empty)] by simp]
        at this
      exact List.append_cancel_right this
    -- the word of `B` around its cap column
    obtain ⟨A, S, hwB, hS, hcapB⟩ := wordDecomp_E5 hc'
    obtain ⟨D, hD⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff F c').1 hc')
    rw [hD, Option.getD_some] at htk
    have hAW : A = W := by
      have h1 := hcapB k' pb
      rw [hcap', hD, Option.getD_some, htk, hwE', hdep'] at h1
      rw [hX, hXC] at h1
      have h2 : wordCol e (P ++ [(p, C)] ++ [(pb, Tree.empty)]) =
          wordCol e (P ++ [(p, Tree.empty)]) ++ wordAt (e + 1) C ++
            [toLex (2 * e + 1, toLex (0, pb))] := by
        rw [show P ++ [(p, C)] ++ [(pb, Tree.empty)] = P ++ (p, C) :: [(pb, Tree.empty)] by simp,
          hsplitC]
        simp [wordLater, wordAt, wordCols, Tree.empty]
      rw [h2] at h1
      simp only [List.append_assoc] at h1
      exact (List.append_cancel_right h1).symm
    obtain ⟨R, hRl⟩ := localSuffix_eq_E5 hD
    rw [hAW, hRl, map_depthShift_word_E5, hdep'] at hwB
    -- `D = P ⌢ (p, C) ⌢ R_B` with every entry of `R_B` at most `(p, C)` (H)
    have hDsplit : D = P ++ (p, C) :: D.drop k' := by
      conv_lhs => rw [← List.take_append_drop k' D, htk]
      simp
    have hk'le : k' ≤ D.length := by rw [hD, Option.getD_some] at hk'; exact hk'
    have hlenP : k' = P.length + 1 := by
      have := congrArg List.length htk
      rw [List.length_take] at this
      simp at this
      omega
    have hHle : ∀ i, P.length ≤ i → ∀ x, D[i]? = some x → EntryLe x (p, C) := by
      intro i hi
      induction i, hi using Nat.le_induction with
      | base =>
        intro x hx
        rw [hDsplit, List.getElem?_append_right (le_refl _), Nat.sub_self] at hx
        simp only [List.getElem?_cons_zero, Option.some.injEq] at hx
        subst hx
        exact Or.inr ⟨rfl, le_rfl⟩
      | succ i hi ih =>
        intro x hx
        have hi' : i < D.length := by
          by_contra hh
          rw [List.getElem?_eq_none (by omega)] at hx; cases hx
        have hxi := ih D[i] (List.getElem?_eq_getElem hi')
        have hH := hF.2.2.1 c' hc' i D[i] x (by rw [hD]; exact List.getElem?_eq_getElem hi')
          (by rw [hD]; exact hx)
        rcases hH with h1 | ⟨h1, h2⟩ <;> rcases hxi with h3 | ⟨h3, h4⟩
        · exact Or.inl (lt_trans h1 h3)
        · exact Or.inl (by rw [← h3]; exact h1)
        · exact Or.inl (by rw [h1]; exact h3)
        · exact Or.inr ⟨h1.trans h3, le_trans h2 h4⟩
    have hRB : ∀ x ∈ D.drop k', EntryLe x (p, C) := by
      intro x hx
      obtain ⟨i, hi, hix⟩ := List.mem_iff_getElem.1 hx
      apply hHle (k' + i) (by omega)
      rw [← hix, List.getElem_drop]
      exact List.getElem?_eq_getElem _
    refine ⟨D.drop k', R, S, ?_, hRB, by rw [hdep'] at hS; exact hS,
      fun s hs => word_wf F s (by rw [hwB]; simp [hs])⟩
    rw [hwB]
    congr 3
    exact hDsplit ▸ rfl


/-- T3.8k helper: a column that is not below `M` copies of `x` while all its entries are at most
`x` starts with those copies. -/
theorem cmpCol_rep_prefix_E5 (x : Nat × Forest) : ∀ (M : Nat) (D : Column),
    (∀ y ∈ D, EntryLe y x) → Tree.cmpCol compare (List.replicate M x) D ≠ .gt →
      List.replicate M x <+: D
  | 0, D, _, _ => List.nil_prefix
  | M + 1, [], _, h => absurd rfl (by rw [List.replicate_succ] at h; exact h)
  | M + 1, (q, H) :: D, hD, h => by
    obtain ⟨p, C⟩ := x
    have hx := hD (q, H) (by simp)
    rw [List.replicate_succ] at h ⊢
    simp only [Tree.cmpCol] at h
    rcases hx with h1 | ⟨h1, h2⟩
    · simp only at h1
      rw [Nat.compare_eq_gt.2 h1] at h
      exact absurd rfl h
    · simp only at h1 h2
      subst h1
      rcases lt_or_eq_of_le h2 with h2 | rfl
      · have h3 : Tree.cmp compare C H = .gt := by
          rw [Tree.cmp_eq_swap]; have : Tree.cmp compare H C = .lt := h2; rw [this]; rfl
        rw [Nat.compare_eq_eq.2 rfl, h3] at h
        exact absurd rfl h
      · rw [Nat.compare_eq_eq.2 rfl, Tree.cmp_self] at h
        exact (List.prefix_cons_inj _).2
          (cmpCol_rep_prefix_E5 (q, H) M D (fun y hy => hD y (by simp [hy])) h)

-- T3.8k (txt:506-510): special outputs
theorem KS_special {A B : Forest} {n : Nat} (hA : InL A) (hcof : Cof A)
    (hk : stepKind A = some .special) (hB : expand A n = some B) : KS B := by
  intro c k ρ hup hKL
  have hBL := inL_expand hA hB
  have hAne : A ≠ Tree.empty := by
    rintro rfl; simp [stepKind, stepKindBody, Tree.empty, Tree.cols] at hk
  have hBA := expand_lt hAne hA.1 hA.2.1 hB
  obtain ⟨hc, hkc⟩ := colAddrs_of_upward_E5 hup
  by_cases hend : capPos B c k = mu B
  · exact covers_of_end_E5 hBL.2.1 hup hKL hend
  have hlt := lt_of_le_of_ne (capPos_le_mu_E5 hc k) hend
  have hK0 : ∀ K0, expand (litCap B c k ρ) 0 = some K0 → K0 < B :=
    fun K0 h0 => expand_zero_litCap_lt hBL.2.1 hup hKL.1 hKL.2.1 h0
  have hAlast : A.cols.getLast? ≠ some [] := fun h => by
    rw [(stepKind_deletion_iff A).2 h] at hk; cases hk
  rcases lt_trichotomy A (litCap B c k ρ) with hAK | hAK | hAK
  · exact covers_of_gt hcof hKL (litCap_ne_empty_E5 hup) (litCap_last_ne_E5 hup) hAK
      (le_of_lt hBA) hK0
  · rw [← hAK]
    obtain ⟨B', hB'⟩ := Option.isSome_iff_exists.1
      (expand_isSome hA.1 hA.2.1 hA.2.2.2.1 hA.2.2.2.2 (n + 1))
    exact ⟨n + 1, B', hB', expand_strictMono hA hAlast hAne (Nat.lt_succ_self n) hB hB'⟩
  · exfalso
    have hBK := lt_litCap hup
    -- the cut atom of `B` is below the cap atom
    obtain ⟨y, hy⟩ : ∃ y, (word B)[capPos B c k]? = some y :=
      ⟨_, List.getElem?_eq_getElem hlt⟩
    have hyz := (isUpward_iff_atom hc hkc).1 hup y hy
    have hwK := word_litCap hc hkc ρ
    -- a proper extension of `w(B)` cannot be the cap's word
    have key : ∀ T, word (litCap B c k ρ) = word B ++ T → False := by
      intro T hT
      have h1 : (word (litCap B c k ρ))[capPos B c k]? = some y := by
        rw [hT, List.getElem?_append_left hlt]; exact hy
      have hlt' : capPos B c k < (word B).length := hlt
      rw [hwK, List.getElem?_append_right (by simp), List.length_take,
        Nat.min_eq_left (le_of_lt hlt'), Nat.sub_self] at h1
      simp at h1
      rw [h1] at hyz
      exact lt_irrefl _ hyz
    -- the special data of `A`
    obtain ⟨sd, oe, P, p, Cs, hsd, hhp, hnum, hdpos, hR, hself, hexp⟩ := special_data_E5 hA hk
    obtain ⟨e, he⟩ : ∃ e, sd.depth - 1 = e := ⟨_, rfl⟩
    rw [he] at hR hself hexp
    have hde : sd.depth = e + 1 := by omega
    have hwZ : ∀ Z, word (replaceAt 0 0 Z e A) =
        word (replaceAt 0 0 Tree.empty e A) ++ wordAt e Z := by
      intro Z; unfold word; rw [ker_wordAt_replaceAt Z e A 0 hR, Nat.zero_add]
    set W := word (replaceAt 0 0 Tree.empty e A) with hW
    have hw1 : ∀ c : Column, wordAt e (Tree.node [c]) = wordCol e c := by
      intro c; simp [wordAt, wordCols]
    set C : Forest := Tree.node Cs with hC
    set X := W ++ wordCol e (P ++ [(p, C)]) with hX
    set z : WordAtom := toLex (2 * (e + 1), toLex (1, sd.r)) with hz
    have hsplitC : ∀ (H : Forest) (R : Column), wordCol e (P ++ (p, H) :: R) =
        wordCol e (P ++ [(p, Tree.empty)]) ++ wordAt (e + 1) H ++ wordLater e R :=
      fun H R => wordCol_split_E5 e P p H R
    have hXC : wordCol e (P ++ [(p, C)]) =
        wordCol e (P ++ [(p, Tree.empty)]) ++ wordAt (e + 1) C := by
      rw [hsplitC]; simp [wordLater]
    have hwA : word A = X ++ [z] := by
      conv_lhs => rw [← hself]
      rw [hwZ, hw1, hsplitC, hX, hXC]
      simp [wordLater, wordAt, wordCols_append, wordCols, wordCol, Tree.empty, hz, List.append_assoc]
      rfl
    rw [hexp n, Option.some.injEq] at hB
    subst hB
    set N := n + if P = [] then 1 else 0 with hN
    have hwB : word (replaceAt 0 0 (Tree.node [P ++ List.replicate N (p, C)]) e A) =
        W ++ wordCol e (P ++ List.replicate N (p, C)) := by rw [hwZ, hw1]
    rw [hwB] at hy hwK key
    rw [← word_lt_iff, hwA] at hAK
    rw [← word_lt_iff, hwB] at hBK
    by_cases hN0 : N = 0
    · -- `P ≠ []`, `n = 0`: `w(B)` is a prefix of `w(A)`, so `A < K`
      have hP : P ≠ [] := by intro h; rw [hN, if_pos h] at hN0; omega
      have hrep : List.replicate N (p, C) = [] := by rw [hN0]; rfl
      simp only [hrep, List.append_nil] at hy hwK hBK key hAK ⊢
      have hwA' : X ++ [z] = (W ++ wordCol e P) ++ wordLater e [(p, Tree.node (Cs ++ [[(sd.r, Tree.empty)]]))] := by
        rw [← hwA]
        conv_lhs => rw [← hself]
        rw [hwZ, hw1, ker_wordCol_append e hP, List.append_assoc]
      rw [hwA'] at hAK
      apply lt_asymm hAK
      rw [hwK]
      obtain ⟨hlt', -⟩ := List.getElem?_eq_some_iff.1 hy
      set π := capPos (replaceAt 0 0 (Tree.node [P]) e A) c k with hπ
      conv_lhs => rw [← List.take_append_drop π (W ++ wordCol e P)]
      rw [List.append_assoc, ker_append_lt_append_iff, List.drop_eq_getElem_cons hlt']
      have : (W ++ wordCol e P)[π] = y := by
        rw [List.getElem?_eq_getElem hlt'] at hy; exact Option.some.inj hy
      rw [this, List.cons_append]
      exact List.cons_lt_cons_iff.2 (Or.inl hyz)
    · obtain ⟨M, hM⟩ : ∃ M, N = M + 1 := ⟨N - 1, by omega⟩
      have hwBX : W ++ wordCol e (P ++ List.replicate N (p, C)) =
          X ++ wordLater e (List.replicate M (p, C)) := by
        rw [hM, List.replicate_succ, hsplitC, hX, hXC]
        simp only [List.append_assoc]
      rw [hwBX] at hBK
      rcases split_E5 X _ z hAK with h | h | ⟨y', L', hKw, hyz'⟩
      · exact lt_asymm (lt_append_of_lt_E5 h _) hBK
      · rw [h] at hBK
        exact list_not_lt_prefix (List.prefix_append _ _) hBK
      · obtain ⟨D, R, S, hwK', hD, hS, hSw⟩ :=
          special_decode_E5 hKL hsd hhp hnum hde hR hself (by rw [hKw]) hyz'
        rw [← hwBX, hwK', List.append_assoc, ker_append_lt_append_iff] at hBK
        conv_lhs at hBK => rw [← List.append_nil (wordCol e (P ++ List.replicate N (p, C))), ← hw1]
        rw [wordAt_append_lt_iff_E5 _ _ _ (by simp) hSw (by simp) hS] at hBK
        -- `M` copies start `D`
        have hpre : List.replicate M (p, C) <+: D := by
          rcases hBK with h | ⟨h, -⟩
          · apply cmpCol_rep_prefix_E5 (p, C) M D hD
            intro hgt
            have h' : Tree.cmpCols compare [P ++ List.replicate N (p, C)]
                ((P ++ (p, C) :: D) :: R) = .lt := h
            simp only [Tree.cmpCols] at h'
            rw [hM, List.replicate_succ, show P ++ (p, C) :: List.replicate M (p, C) =
              (P ++ [(p, C)]) ++ List.replicate M (p, C) by simp,
              show P ++ (p, C) :: D = (P ++ [(p, C)]) ++ D by simp,
              ker_cmpCol_append_left, hgt] at h'
            cases h'
          · simp only [Tree.node.injEq, List.cons.injEq] at h
            rw [hM, List.replicate_succ] at h
            have := List.append_cancel_left h.1
            simp only [List.cons.injEq] at this
            rw [this.2]
        obtain ⟨D', rfl⟩ := hpre
        apply key (wordLater e D' ++ wordCols e R ++ S)
        rw [hwK']
        have hne : P ++ List.replicate N (p, C) ≠ [] := by rw [hM]; simp
        rw [show P ++ (p, C) :: (List.replicate M (p, C) ++ D') =
          (P ++ List.replicate N (p, C)) ++ D' by rw [hM, List.replicate_succ]; simp]
        simp only [wordAt, wordCols]
        rw [ker_wordCol_append e hne]
        simp only [List.append_assoc]
        rfl

/-- T3.8l (txt:511-643): the setting of the ordinary induction step. -/
structure OrdStep where
  A : Forest
  sd : StopData
  rd : RootData
  n : Nat
  B : Forest
  std : IsStd A
  inL : InL A
  condP : CondP A
  cof : Cof A
  kind : stepKind A = some .ordinary
  hsd : stopData A = some sd
  hrd : rootData A = some rd
  pos : 1 ≤ n
  out : expand A n = some B

namespace OrdStep

variable (S : OrdStep)

/-- The period `d`. -/
def d : Nat := period S.sd
/-- `s_i = r + i d`, the number of the head of layer `i`. -/
def s (i : Nat) : Nat := S.sd.r + i * S.d
/-- `m = |Q|`. -/
def m : Nat := S.sd.Q.length
/-- `τ_i = T_{r, i d}`. -/
def tau (i : Nat) (F : Forest) : Forest := shift S.sd.r (i * S.d) F
/-- The projection of a selected root of phase `φ` (txt:521-524); only used outside `(r, s_φ)`. -/
def proj (φ ρ : Nat) : Nat := if S.s φ < ρ then ρ - φ * S.d else if ρ = S.s φ then S.sd.r else ρ

end OrdStep

-- T3.8la (`cut_location`) moved to just before T3.8l (`KS_ordinary`), brief rule 5.

-- T3.8lb (`headQuery_oldCap`) moved below the G-009 block, to the G-010 (D7) section (brief
-- rule 5).

-- T3.8lc (txt:607-611): query-part cuts of head `i ≥ 2`
theorem headQuery_cut (S : OrdStep) {i : Nat} {c : ColAddr} {k ρ : Nat} (hi : 2 ≤ i ∧ i ≤ S.n)
    (hc : phaseCol S.sd S.rd i S.rd.col = some c) (hk : k < S.m ∨ (k = S.m ∧ S.s (i - 1) < ρ))
    (hup : IsUpward S.B c k ρ) (hKL : InL (litCap S.B c k ρ)) :
    Covers (litCap S.B c k ρ) S.B := by sorry

-- T3.8ld (txt:613-617): the seam: the cap at `s_{i−1}` is `A` advanced by `i − 1` periods
theorem expand_seam (S : OrdStep) {i : Nat} {c : ColAddr} (hi : 1 ≤ i ∧ i ≤ S.n)
    (hc : phaseCol S.sd S.rd i S.rd.col = some c) (q : Nat) :
    expand (litCap S.B c S.m (S.s (i - 1))) q = expand S.A (i - 1 + q) := by sorry

-- T3.8le (txt:617-620): no closing parent below `s_{i−1}` is an upward `L` cap at `k = m`
theorem seam_parent (S : OrdStep) {i : Nat} {c : ColAddr} {ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (hc : phaseCol S.sd S.rd i S.rd.col = some c) (hup : IsUpward S.B c S.m ρ)
    (hKL : InL (litCap S.B c S.m ρ)) : S.s (i - 1) ≤ ρ := by sorry

-- T3.8lf (txt:623-624): restored-suffix cuts force `ρ < r`
theorem restored_parent (S : OrdStep) {i : Nat} {c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (hc : phaseCol S.sd S.rd i S.rd.col = some c) (hk : S.m < k) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) : ρ < S.sd.r := by
  obtain ⟨col, hcol, hlen, -, hent⟩ := colAt_head S.inL S.kind S.hsd S.hrd S.out hi hc
  have hkle : k ≤ col.length := by
    unfold IsUpward at hup
    rw [hcol] at hup
    simp only at hup
    cases h : col[k]? with
    | none => rw [h] at hup; omega
    | some x => exact (List.getElem?_eq_some_iff.1 h).1.le
  have hm : S.m = S.sd.Q.length := rfl
  obtain ⟨x, hx⟩ : ∃ x, (unconsumed S.A S.rd)[k - 1 - S.m]? = some x :=
    ⟨_, List.getElem?_eq_getElem (by omega)⟩
  obtain ⟨y, hy, hy1, -⟩ := hent _ x hx
  have hxr := ker_unconsumed_lt S.inL.1 S.hsd S.hrd x (List.mem_of_getElem? hx)
  have hK := (stopData_spec (stopData_litCap hup)).1
  simp only [hcol, Option.getD_some] at hK
  have hmem : c ∈ (litCap S.B c k ρ).colAddrs := by
    rw [Tree.mem_colAddrs_iff, hK]; rfl
  have hk1 : S.sd.Q.length + (k - 1 - S.m) = k - 1 := by omega
  rw [hk1] at hy
  have hlt : k - 1 < (col.take k).length := by rw [List.length_take]; omega
  have hHle := hKL.2.2.1 c hmem (k - 1) y (ρ, Tree.empty)
    (by rw [hK, Option.getD_some, List.getElem?_append_left hlt, List.getElem?_take_of_lt (by omega), hy])
    (by rw [hK, Option.getD_some, show k - 1 + 1 = (col.take k).length by rw [List.length_take]; omega,
          List.getElem?_append_right le_rfl, Nat.sub_self]; rfl)
  rcases hHle with h | ⟨h, -⟩ <;> simp only at h <;> omega

-- T3.8lg (txt:624-626): the old root cap after `w = c + v` entries has V, I, decorated A
theorem restored_oldCap (S : OrdStep) {i : Nat} {c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (hc : phaseCol S.sd S.rd i S.rd.col = some c) (hk : S.m < k) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hend : capPos S.B c k < mu S.B) :
    let K' := litCap S.A S.rd.col (S.rd.cursor + (k - S.m)) ρ
    IsUpward S.A S.rd.col (S.rd.cursor + (k - S.m)) ρ ∧ CondV K' ∧ CondI K' ∧
      CondAK K' (capKeys K' (routeCols K')) := by sorry

-- T3.8lh (txt:621-640): restored-suffix cuts succeed (remainders (5), delayed change)
theorem restored_cut (S : OrdStep) {i : Nat} {c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (hc : phaseCol S.sd S.rd i S.rd.col = some c) (hk : S.m < k) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hend : capPos S.B c k < mu S.B)
    (hold : Success (litCap S.A S.rd.col (S.rd.cursor + (k - S.m)) ρ) (localSuffix S.A S.rd.col)) :
    Success (litCap S.B c k ρ) (localSuffix S.B c) := by sorry

-- T3.8li (`projection`) moved below the G-009 block, to the G-010 (D7) section (brief rule 5).

-- T3.8lj (txt:542-546): proper current root `ρ > s_φ`: conjugate kernels, downward success
theorem root_current (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hend : capPos S.B c k < mu S.B)
    (hρ : S.s (phaseOff S.sd i a) < ρ)
    (hold : Success (litCap S.A a k (ρ - phaseOff S.sd i a * S.d)) (localSuffix S.A a)) :
    Success (litCap S.B c k ρ) (localSuffix S.B c) := by sorry

-- T3.8lk (txt:547-552): current head root `ρ = s_φ`: high scans conjugate, low scans win
theorem root_head (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hend : capPos S.B c k < mu S.B)
    (hρ : ρ = S.s (phaseOff S.sd i a))
    (hold : Success (litCap S.A a k S.sd.r) (localSuffix S.A a)) :
    Success (litCap S.B c k ρ) (localSuffix S.B c) := by sorry

-- T3.8ll (txt:551-552, 560-561): "wins at once": the first unconsumed root entry beats the next
-- target entry
theorem success_of_first {K Y : Forest} {sd : StopData} {rd : RootData}
    (hsd : stopData K = some sd) (hrd : rootData K = some rd) (hdef : KernelDefined K rd)
    {rest : Column} {more : List Column} (hY : Y = .node ((sd.Q ++ rest) :: more))
    {u : Nat × Forest} {us : Column} (hU : unconsumed K rd = u :: us)
    (hbeat : ∀ x ∈ rest.head?, x.1 < u.1) : Success K Y := by
  refine ⟨sd, rd, hsd, hrd, hdef, ?_⟩
  -- the first column of the kernel is `Q ++ (u.1, _) :: _`
  obtain ⟨h', tl, more', hker⟩ : ∃ h' tl more', kernel K sd rd Y =
      .node ((sd.Q ++ (u.1, h') :: tl) :: more') := by
    unfold kernel
    rw [hU]
    split
    · cases us with
      | nil => simp only [mapLast]; exact ⟨_, _, _, rfl⟩
      | cons v vs => simp only [mapLast]; exact ⟨_, _, _, rfl⟩
    · simp only [List.map_cons]; exact ⟨_, _, _, rfl⟩
  rw [hker, hY]
  show Tree.cmp compare _ _ = .lt
  simp only [Tree.cmp, Tree.cmpCols, cmpCol_append_left_D3]
  cases rest with
  | nil => simp [Tree.cmpCol, Ordering.then]
  | cons x xs =>
    have hx := hbeat x (by simp)
    obtain ⟨p, H⟩ := x
    simp only at hx
    simp [Tree.cmpCol, Ordering.then, compare_lt_iff_lt.2 hx]

section D7Trees

variable {α β γ : Type}

mutual
-- T3.8lm (D7, helper): relabelling twice is relabelling by the composite
theorem map_map_D7 (f : α → β) (g : β → γ) (t : Tree α) :
    Tree.map g (Tree.map f t) = Tree.map (g ∘ f) t :=
  match t with
  | .node a => by rw [Tree.map, Tree.map, Tree.map, mapCols_map_D7]

theorem mapCols_map_D7 (f : α → β) (g : β → γ) (a : List (List (α × Tree α))) :
    Tree.mapCols g (Tree.mapCols f a) = Tree.mapCols (g ∘ f) a :=
  match a with
  | [] => rfl
  | x :: xs => by rw [Tree.mapCols, Tree.mapCols, Tree.mapCols, mapCol_map_D7, mapCols_map_D7]

theorem mapCol_map_D7 (f : α → β) (g : β → γ) (a : List (α × Tree α)) :
    Tree.mapCol g (Tree.mapCol f a) = Tree.mapCol (g ∘ f) a :=
  match a with
  | [] => rfl
  | (p, h) :: es => by
    rw [Tree.mapCol, Tree.mapCol, Tree.mapCol, map_map_D7, mapCol_map_D7]; rfl
end

mutual
-- T3.8lm (D7, helper): two relabelled comparisons agree when they agree labelwise
theorem cmp_map2_D7 {δ : Type} {c : δ → δ → Ordering} {f₁ g₁ : α → δ} {f₂ g₂ : β → δ}
    (hf : ∀ x y, c (f₁ x) (f₂ y) = c (g₁ x) (g₂ y)) (s : Tree α) (t : Tree β) :
    Tree.cmp c (Tree.map f₁ s) (Tree.map f₂ t) = Tree.cmp c (Tree.map g₁ s) (Tree.map g₂ t) :=
  match s, t with
  | .node a, .node b => by
    rw [Tree.map, Tree.map, Tree.map, Tree.map, Tree.cmp, Tree.cmp]
    exact cmpCols_map2_D7 hf a b

theorem cmpCols_map2_D7 {δ : Type} {c : δ → δ → Ordering} {f₁ g₁ : α → δ} {f₂ g₂ : β → δ}
    (hf : ∀ x y, c (f₁ x) (f₂ y) = c (g₁ x) (g₂ y)) (a : List (List (α × Tree α)))
    (b : List (List (β × Tree β))) :
    Tree.cmpCols c (Tree.mapCols f₁ a) (Tree.mapCols f₂ b) =
      Tree.cmpCols c (Tree.mapCols g₁ a) (Tree.mapCols g₂ b) :=
  match a, b with
  | [], [] => rfl
  | [], _ :: _ => rfl
  | _ :: _, [] => rfl
  | x :: xs, y :: ys => by
    rw [Tree.mapCols, Tree.mapCols, Tree.mapCols, Tree.mapCols, Tree.cmpCols, Tree.cmpCols,
      cmpCol_map2_D7 hf x y, cmpCols_map2_D7 hf xs ys]

theorem cmpCol_map2_D7 {δ : Type} {c : δ → δ → Ordering} {f₁ g₁ : α → δ} {f₂ g₂ : β → δ}
    (hf : ∀ x y, c (f₁ x) (f₂ y) = c (g₁ x) (g₂ y)) (a : List (α × Tree α))
    (b : List (β × Tree β)) :
    Tree.cmpCol c (Tree.mapCol f₁ a) (Tree.mapCol f₂ b) =
      Tree.cmpCol c (Tree.mapCol g₁ a) (Tree.mapCol g₂ b) :=
  match a, b with
  | [], [] => rfl
  | [], _ :: _ => rfl
  | _ :: _, [] => rfl
  | (p, h) :: es, (q, k) :: fs => by
    rw [Tree.mapCol, Tree.mapCol, Tree.mapCol, Tree.mapCol, Tree.cmpCol, Tree.cmpCol, hf,
      cmp_map2_D7 hf h k, cmpCol_map2_D7 hf es fs]
end

end D7Trees

-- T3.8lm (D7, helper): the label comparison behind sign independence
theorem kappaLabel_cmp_indep_D7 {r d φ h h' : Nat} (hh : h < φ) (hh' : h' < φ) (x : Bool × Nat)
    (p : Nat) :
    keyLabelCmp (kappaLabel r d φ x)
        (kappaLabel r d h (if p < r + d then (false, p) else (true, p - (r + d)))) =
      keyLabelCmp (kappaLabel r d φ x)
        (kappaLabel r d h' (if p < r + d then (false, p) else (true, p - (r + d)))) := by
  obtain ⟨b, q⟩ := x
  have h1 : (h + 1) * d ≤ φ * d := Nat.mul_le_mul_right _ (by omega)
  have h2 : (h' + 1) * d ≤ φ * d := Nat.mul_le_mul_right _ (by omega)
  rw [Nat.succ_mul] at h1 h2
  by_cases hp : p < r + d
  · simp only [hp, if_true]
    by_cases hpr : r ≤ p
    · have ey : ∀ j, kappaLabel r d j (false, p) = (false, p + j * d) := fun j => by
        simp [kappaLabel, hpr]
      rw [ey, ey]
      cases b
      · by_cases hq : r ≤ q
        · have ex : kappaLabel r d φ (false, q) = (false, q + φ * d) := by simp [kappaLabel, hq]
          rw [ex]
          have hb : compare false false = Ordering.eq := rfl
          simp only [keyLabelCmp, hb, Ordering.eq_then]
          rw [show compare (q + φ * d) (p + h * d) = .gt from compare_gt_iff_gt.mpr (by omega),
            show compare (q + φ * d) (p + h' * d) = .gt from compare_gt_iff_gt.mpr (by omega)]
        · have ex : kappaLabel r d φ (false, q) = (false, q) := by simp [kappaLabel, hq]
          rw [ex]
          have hb : compare false false = Ordering.eq := rfl
          simp only [keyLabelCmp, hb, Ordering.eq_then]
          rw [show compare q (p + h * d) = .lt from compare_lt_iff_lt.mpr (by omega),
            show compare q (p + h' * d) = .lt from compare_lt_iff_lt.mpr (by omega)]
      · have hb : compare true false = Ordering.gt := rfl
        simp [kappaLabel, keyLabelCmp, hb]
    · cases b <;> simp [kappaLabel, keyLabelCmp, hpr]
  · simp only [hp, if_false]
    simp [kappaLabel]

-- T3.8lm (txt:555-559): sign independence of a fixed phase-`φ` key against the phase-`h` images
-- of a key normalized at the old terminal `t = r + d`, for every `h < φ`
theorem sign_indep {r d φ h h' : Nat} (hh : h < φ) (hh' : h' < φ) (w : Key) (J : Forest) :
    keyCmp (kappa r d φ w) (kappa r d h (relKey (r + d) J)) =
      keyCmp (kappa r d φ w) (kappa r d h' (relKey (r + d) J)) := by
  unfold keyCmp kappa relKey
  rw [map_map_D7, map_map_D7]
  exact cmp_map2_D7 (fun x p => kappaLabel_cmp_indep_D7 hh hh' x p) w J


-- T3.8lm (D7, helper): list comparisons against two relabellings agree when every pair does
theorem list_lt_congr_D7 {β γ : Type} (E : γ → Key) (F G : β → Key)
    (hFG : ∀ w J, keyCmp (E w) (F J) = keyCmp (E w) (G J)) :
    ∀ (W : List γ) (Js : List β), W.map E < Js.map F ↔ W.map E < Js.map G
  | [], [] => by simp
  | [], _ :: _ => by simp [List.nil_lt_cons]
  | _ :: _, [] => by simp
  | w :: ws, J :: Js => by
    have hlt : E w < F J ↔ E w < G J := by
      rw [← compare_lt_iff_lt (a := E w) (b := F J), ← compare_lt_iff_lt (a := E w) (b := G J),
        Key.compare_eq_keyCmp, Key.compare_eq_keyCmp, hFG]
    have heq : E w = F J ↔ E w = G J := by
      rw [← compare_eq_iff_eq (a := E w) (b := F J), ← compare_eq_iff_eq (a := E w) (b := G J),
        Key.compare_eq_keyCmp, Key.compare_eq_keyCmp, hFG]
    simp only [List.map_cons, List.cons_lt_cons_iff, hlt, heq, list_lt_congr_D7 E F G hFG ws Js]

-- T3.8lm: the same for reduced queries (lists of keys), hence for "low/high" at every head
theorem sign_indep_list {r d φ h h' : Nat} (hh : h < φ) (hh' : h' < φ) (W : List Key)
    (Js : List Forest) :
    (W.map (kappa r d φ) < (Js.map (relKey (r + d))).map (kappa r d h) ↔
      W.map (kappa r d φ) < (Js.map (relKey (r + d))).map (kappa r d h')) := by
  rw [List.map_map, List.map_map]
  exact list_lt_congr_D7 _ _ _ (fun w J => sign_indep hh hh' w J) W Js

-- T3.8ln (`phase_parent_dichotomy`) moved below, before G9.8a `phase_exit`, its first use (brief
-- rule 5: its proof uses the G-009 context lemmas).

/-! ## G-009 helpers for T3.8lo (from `blueprint/repairs/lean/G009.lean`)

The low-head detour invariant behind T3.8lo (`blueprint/repairs/G-009.md`). Notation:
`r = S.sd.r`, `t = S.sd.t`, `d = S.d`, `m = S.m`, `s_h = S.s h`, `φ = phaseOff S.sd i a`,
`K = litCap S.B c k ρ`, `V = S.capQ c k ρ`, `Z = S.termZ`. -/

/-! ## G9.0 — definitions -/

/-- G9.0 (= D-G010.2 `kappaQ`, draft name `kappaQry`): `κ_j` on a query of actual keys (a list
of `WithTop Key`), exactly the map applied to queries in `head_path` (T3.2q). -/
def kappaQ (r d φ : Nat) (W : List (WithTop Key)) : List (WithTop Key) :=
  W.map (WithTop.map (kappa r d φ))

namespace OrdStep

variable (S : OrdStep)

/-- G9.0: the old terminal's complete query `Z = B_t(m−1) = ν(y_0,…,y_{m−1})` (txt:381), read in
the actual key system of `A` at the stopping column. -/
def termZ : List (WithTop Key) := cutQuery (actualKeys S.A S.sd.col) S.m

/-- G9.0: the address in `B` of the head `s_h` of layer `h ≥ 1` (`phaseCol h rd.col`). -/
def headCol (h : Nat) : ColAddr := (phaseCol S.sd S.rd h S.rd.col).getD S.rd.col

/-- G9.0: the phase-`h` copy in `B` of a column `o` of `A` on the stopping column's stack: `o`
itself at phase `0` (retained context), `phaseCol h o` at phase `h ≥ 1`. -/
def copyCol (h : Nat) (o : ColAddr) : ColAddr :=
  if h = 0 then o else (phaseCol S.sd S.rd h o).getD o

/-- G9.0: the cut query `V = B_c(k−1)` of the literal cap `K = litCap B c k ρ` at its stopping
column `c` (the query of `K`'s closing A test and of its root scan). -/
def capQ (c : ColAddr) (k ρ : Nat) : List (WithTop Key) :=
  cutQuery (actualKeys (litCap S.B c k ρ) c) k

end OrdStep

/-! ## G9.1, G9.2 — generic scan and path facts -/

section G9Words

variable {α : Type} [LinearOrder α]

-- G9.1: two sources that agree before `u`, scanned by runs that both stop at or before `u`,
-- have the same final cursor
theorem cursor_eq_of_take_eq {s₁ s₂ W : List α} {u : Nat} (htake : s₁.take u = s₂.take u)
    (h₁ : cursor s₁ W ≤ u) (h₂ : cursor s₂ W ≤ u) : cursor s₁ W = cursor s₂ W := by
  have e₁ := cursor_take s₁ W u
  have e₂ := cursor_take s₂ W u
  rw [Nat.min_eq_right h₂] at e₂
  rw [Nat.min_eq_right h₁, htake, e₂] at e₁
  exact e₁.symm

-- G9.2a: a query strictly below the full boundary of the first `m` keys stops before `m`
theorem cursor_lt_of_lt_cutQuery {ks W : List α} (hW : Noninc W) {m : Nat} (hm : m ≤ ks.length)
    (h : W < cutQuery ks m) : cursor ks W < m := by
  rcases m with _ | v
  · rw [cutQuery_zero] at h
    exact absurd h (List.not_lt_nil _)
  · exact Nat.lt_succ_of_le (cursor_le_of_lt_cutQuery hW (by omega) h)

-- G9.2b: conversely, a run that stops before `m` has its query strictly below that boundary
theorem lt_cutQuery_of_cursor_lt {ks W : List α} (hW : Noninc W) {m : Nat} (hm : m ≤ ks.length)
    (h : cursor ks W < m) : W < cutQuery ks m := by
  by_contra hn
  have := le_cursor_of_cutQuery_le hW hm (not_lt.mp hn)
  omega

-- G9.2c: `ν(l)` is a sublist of `l`
theorem nu_sublist (l : List α) : (nu l).Sublist l := by
  rw [nu_eq_foldl]
  suffices H : ∀ (l acc pre : List α), acc.Sublist pre → (l.foldl nuStep acc).Sublist (pre ++ l) by
    simpa using H l [] [] (List.Sublist.refl _)
  intro l
  induction l with
  | nil => intro acc pre h; simpa using h
  | cons x xs ih =>
    intro acc pre h
    rw [List.foldl_cons]
    have hstep : (nuStep acc x).Sublist (pre ++ [x]) := by
      unfold nuStep
      refine List.Sublist.append ?_ (List.Sublist.refl _)
      refine List.Sublist.trans ?_ h
      have := (List.dropWhile_sublist (l := acc.reverse) (fun y => decide (y < x))).reverse
      simpa using this
    simpa using ih _ _ hstep

end G9Words

-- G9.2d: `κ_j` on `WithTop Key` is strictly increasing
theorem kappaQry_strictMono (r d j : Nat) : StrictMono (WithTop.map (kappa r d j)) :=
  WithTop.strictMono_map_iff.mpr (kappa_strictMono r d j)

-- G9.2d (helper): `κ_i ∘ κ_j = κ_{i+j}` on queries (T3.2h.2 `kappa_add`, pointwise)
theorem kappaQ_add (r d i j : Nat) (W : List (WithTop Key)) :
    kappaQ r d i (kappaQ r d j W) = kappaQ r d (i + j) W := by
  unfold kappaQ
  rw [List.map_map]
  congr 1
  funext x
  cases x with
  | top => rfl
  | coe x => simp only [Function.comp_apply, WithTop.map_coe, kappa_add]

-- G9.2d (helper): `κ_j` keeps queries reduced
theorem kappaQ_noninc (r d j : Nat) {W : List (WithTop Key)} (hW : Noninc W) :
    Noninc (kappaQ r d j W) :=
  List.Pairwise.map _ (fun _ _ h => (kappaQry_strictMono r d j).monotone h) hW

-- G9.2d (helper): `κ_j` reflects and preserves the order of queries
theorem kappaQ_lt_iff (r d j : Nat) (W Z : List (WithTop Key)) :
    kappaQ r d j W < kappaQ r d j Z ↔ W < Z :=
  list_map_lt_iff ((kappaQry_strictMono r d j).strictMonoOn Set.univ)
    (fun _ _ => Set.mem_univ _) (fun _ _ => Set.mem_univ _)

-- G9.2e: path nesting for whole paths (U1 L2.2 edgewise)
theorem path_nesting_path {E : Forest} {ks : KeySys} (hV : CondV E) (hA : CondAK E ks)
    (c : ColAddr) {W Z : List (WithTop Key)} (hW : Noninc W) (hZ : Noninc Z) (hWZ : W ≤ Z)
    {x y : Nat} (h : Path E ks c Z x y) : Path E ks c W x y := by
  induction h with
  | refl => exact Relation.ReflTransGen.refl
  | tail _ he ih => exact ih.trans (path_nesting hV hA c hW hZ hWZ he)

-- G9.2f: paths are orbits of the partial response function: a path through `y` and a path to a
-- lower `z` from the same start meet, so `z` is reached from `y`
theorem path_functional {E : Forest} (hV : CondV E) {ks : KeySys} {c : ColAddr}
    {W : List (WithTop Key)} {x y z : Nat} (hy : Path E ks c W x y) (hz : Path E ks c W x z)
    (hzy : z ≤ y) : Path E ks c W y z := by
  induction hy using Relation.ReflTransGen.head_induction_on with
  | refl => exact hz
  | @head x x' hxx' hx'y ih =>
    rcases Relation.ReflTransGen.cases_head hz with hxz | ⟨x'', hxx'', hx''z⟩
    · subst hxz
      have h1 := path_le hV hx'y
      have h2 := edge_lt hV hxx'
      omega
    · obtain ⟨o, ho, hr⟩ := hxx'
      obtain ⟨o', ho', hr'⟩ := hxx''
      rw [ho] at ho'
      cases ho'
      rw [hr] at hr'
      cases hr'
      exact ih hx''z

/-! ## G9.3 — the old terminal-to-root path at a low query -/

-- G9.3 (txt:391-392, "path nesting supplies the terminal-to-root path"): at a reduced query
-- `W' < Z` the old terminal answers with a query parent `q_j`, `j = cursor y W' < m`, and `q_j`
-- reaches `r` by a `g_{W'}` path on the stopping column's stack
theorem term_detour (S : OrdStep) {W : List (WithTop Key)} (hW : Noninc W) (hlow : W < S.termZ) :
    cursor (actualKeys S.A S.sd.col) W < S.m ∧
      ∃ q, (parents S.A S.sd.col)[cursor (actualKeys S.A S.sd.col) W]? = some q ∧
        S.sd.r ≤ q ∧ q < S.sd.t ∧ Path S.A (actualKeys S.A) S.sd.col W q S.sd.r := by
  obtain ⟨hcol, -, ht, -⟩ := stopData_spec S.hsd
  have hVA : CondV S.A := S.inL.1
  have hAA : CondA S.A := S.inL.2.2.2.1
  have hlen : (actualKeys S.A S.sd.col).length = S.m + 1 := by
    rw [length_actualKeys, hcol]; simp [OrdStep.m]
  have hpar : parents S.A S.sd.col = S.sd.Q.map Prod.fst ++ [S.sd.r] := by
    simp [parents, hcol]
  have hplen : (parents S.A S.sd.col).length = S.m + 1 := by
    rw [hpar]; simp [OrdStep.m]
  have hj : cursor (actualKeys S.A S.sd.col) W < S.m :=
    cursor_lt_of_lt_cutQuery hW (by omega) hlow
  refine ⟨hj, ?_⟩
  have hmem : S.sd.col ∈ S.A.colAddrs := by rw [Tree.mem_colAddrs_iff, hcol]; rfl
  set j := cursor (actualKeys S.A S.sd.col) W with hjdef
  set P : Nat → Nat := fun l => ((parents S.A S.sd.col)[l]?).getD 0 with hP
  have hPget : ∀ l, l ≤ S.m → (parents S.A S.sd.col)[l]? = some (P l) := by
    intro l hl
    have : l < (parents S.A S.sd.col).length := by omega
    simp [hP, List.getElem?_eq_getElem this]
  have hPm : P S.m = S.sd.r := by
    simp [hP, hpar, OrdStep.m]
  have hWlt : W < cutQuery (actualKeys S.A S.sd.col) (j + 1) :=
    (cursor_spec _ W hW).2 (by omega)
  have hchain : ∀ n, j + n ≤ S.m → Path S.A (actualKeys S.A) S.sd.col W (P j) (P (j + n)) := by
    intro n
    induction n with
    | zero => intro _; exact Relation.ReflTransGen.refl
    | succ n ih =>
      intro hn
      have h1 := ih (by omega)
      have hA := hAA S.sd.col hmem (j + n + 1) (P (j + n + 1)) (hPget _ hn)
      simp only [Nat.add_one_ne_zero, if_false, Nat.add_sub_cancel] at hA
      have hA' : Path S.A (actualKeys S.A) S.sd.col
          (cutQuery (actualKeys S.A S.sd.col) (j + n + 1)) (P (j + n)) (P (j + n + 1)) := hA
      have hle : W ≤ cutQuery (actualKeys S.A S.sd.col) (j + n + 1) :=
        le_of_lt (lt_of_lt_of_le hWlt (cutQuery_mono _ (by omega)))
      have h2 := path_nesting_path hVA hAA S.sd.col hW (cutQuery_noninc _ _) hle hA'
      exact h1.trans h2
  have hqr : Path S.A (actualKeys S.A) S.sd.col W (P j) S.sd.r := by
    have := hchain (S.m - j) (by omega)
    rwa [show j + (S.m - j) = S.m by omega, hPm] at this
  refine ⟨P j, hPget j hj.le, path_le hVA hqr, ?_, hqr⟩
  -- `q < t`: a parent of the stopping column is visible from it (V)
  have hent : S.A.entryAt ⟨S.sd.col, j⟩ = some (P j, (S.sd.Q[j]'(by simp [OrdStep.m] at hj; omega)).2) := by
    have hjQ : j < S.sd.Q.length := by simpa [OrdStep.m] using hj
    have hjQ' : j < (S.sd.Q.map Prod.fst).length := by simpa using hjQ
    have hPj : P j = (S.sd.Q[j]).1 := by
      simp only [hP, hpar, List.getElem?_append_left hjQ', List.getElem?_map,
        List.getElem?_eq_getElem hjQ, Option.map_some, Option.getD_some]
    rw [hPj]
    simp [Tree.entryAt, hcol, List.getElem?_append_left hjQ, hjQ]
    rfl
  have hmemE : (⟨S.sd.col, j⟩ : EntryAddr) ∈ S.A.entryAddrs := by
    rw [Tree.mem_entryAddrs_iff, hent]; rfl
  have := (condV_iff_lt S.A).mp hVA _ hmemE _ _ hent
  rw [ht]
  exact this

-- G9 (helper): a response is the parent at the cursor
theorem resp_eq_parents (E : Forest) (ks : KeySys) (o : ColAddr) (W : List (WithTop Key)) :
    resp E ks o W = (parents E o)[cursor (ks o) W]? := by
  unfold resp parents
  rw [List.getElem?_map]

-- G9 (helper, from T3.8c and D1.6b): the cap column of a literal cap holds the first `k`
-- entries of the column followed by `(ρ, ∅)`
theorem litCap_colAt_self {B : Forest} {c : ColAddr} {k ρ : Nat} (hup : IsUpward B c k ρ) :
    (litCap B c k ρ).colAt c = some (((B.colAt c).getD []).take k ++ [(ρ, Tree.empty)]) ∧
      (((B.colAt c).getD []).take k).length = k := by
  have hs := (stopData_spec (stopData_litCap hup)).1
  refine ⟨hs, ?_⟩
  unfold IsUpward at hup
  cases hB : B.colAt c with
  | none => rw [hB] at hup; exact hup.elim
  | some col =>
    rw [hB] at hup
    simp only [Option.getD_some, List.length_take]
    cases hk : col[k]? with
    | none => simp only [hk] at hup; omega
    | some x =>
      have : k < col.length := by
        by_contra hc
        rw [List.getElem?_eq_none (by omega)] at hk
        cases hk
      omega

-- G9 (helper): the cap column is a column of the cap, with `k + 1` entries
theorem litCap_parents_self {B : Forest} {c : ColAddr} {k ρ : Nat} (hup : IsUpward B c k ρ) :
    c ∈ (litCap B c k ρ).colAddrs ∧ (parents (litCap B c k ρ) c).length = k + 1 := by
  obtain ⟨hcol, hlen⟩ := litCap_colAt_self hup
  refine ⟨by rw [Tree.mem_colAddrs_iff, hcol]; rfl, ?_⟩
  simp only [parents, hcol, Option.getD_some, List.length_map, List.length_append, hlen,
    List.length_singleton]

-- G9 (helper): a path sum through a step `(ci, e)` after a prefix `pre`
theorem pathSum_ge (pre rest : List (Nat × Nat)) (ci e : Nat) :
    (pre.map (·.1 + 1)).sum + ci + 1 ≤ ((pre ++ (ci, e) :: rest).map (·.1 + 1)).sum := by
  simp only [List.map_append, List.map_cons, List.sum_append, List.sum_cons]
  omega

-- G9 (helper): every template column lies above the root, `r < num a`
theorem tmplCol_num_gt (S : OrdStep) {a : ColAddr} (ha : IsTmplCol S.A S.sd S.rd a) :
    S.sd.r < a.num 0 := by
  obtain ⟨-, -, hne, hker⟩ := ha
  obtain ⟨-, -, hidx, hrnum, hrt, -⟩ := rootData_spec S.hsd S.hrd
  obtain ⟨-, -, ht, -⟩ := stopData_spec S.hsd
  have hnum : ∀ b : ColAddr, b.num 0 = (b.path.map (·.1 + 1)).sum + b.col := by
    intro b; simp [ColAddr.num]
  by_cases hQ : isQMat S.sd a = true
  · -- Q-material lies inside a height of the stopping column, above `t > r`
    cases hd : a.path.drop S.sd.col.path.length with
    | nil => simp [isQMat, hd] at hQ
    | cons p rest =>
      obtain ⟨ci, j⟩ := p
      simp only [isQMat, hd, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at hQ
      obtain ⟨htk, hci, -⟩ := hQ
      have hpath : a.path = S.sd.col.path ++ (ci, j) :: rest := by
        rw [← htk, ← hd, List.take_append_drop]
      have h1 := pathSum_ge S.sd.col.path rest ci j
      rw [← hpath] at h1
      have h2 := hnum a
      have h3 := hnum S.sd.col
      omega
  · simp only [Bool.not_eq_true] at hQ
    unfold kerCol at hker
    simp only [hQ, Bool.false_eq_true, if_false] at hker
    by_cases hR : a.path.take S.rd.col.path.length = S.rd.col.path
    · rw [if_pos hR] at hker
      cases hd : a.path.drop S.rd.col.path.length with
      | nil =>
        rw [hd] at hker
        have hpath : a.path = S.rd.col.path := by
          rw [← List.take_append_drop S.rd.col.path.length a.path, hR, hd, List.append_nil]
        have hcol : S.rd.idx ≤ a.col := by
          split_ifs at hker with h1 h2
          · omega
          · omega
          · simp at hker
        have hcol' : a.col ≠ S.rd.col.col := by
          intro h
          apply hne
          show (⟨a.path, a.col⟩ : ColAddr) = ⟨S.rd.col.path, S.rd.col.col⟩
          rw [hpath, h]
        have h2 := hnum a
        have h3 := hnum S.rd.col
        rw [hpath] at h2
        omega
      | cons p rest =>
        obtain ⟨ci, e⟩ := p
        rw [hd] at hker
        have hci : S.rd.idx ≤ ci := by
          simp only at hker
          split_ifs at hker with h1 h2
          · omega
          · omega
          · simp at hker
        have hpath : a.path = S.rd.col.path ++ (ci, e) :: rest := by
          rw [← hR, ← hd, List.take_append_drop]
        have h1 := pathSum_ge S.rd.col.path rest ci e
        rw [← hpath] at h1
        have h2 := hnum a
        have h3 := hnum S.rd.col
        omega
    · rw [if_neg hR] at hker
      simp at hker

-- G9 (helper, T3.2i `num_phaseCol`): a phase copy lies above its head, `s_φ < num c`
theorem phaseCol_num_gt (S : OrdStep) {i : Nat} {a c : ColAddr} (hi : 1 ≤ i)
    (ha : IsTmplCol S.A S.sd S.rd a) (hc : phaseCol S.sd S.rd i a = some c) :
    S.s (phaseOff S.sd i a) < c.num 0 := by
  have hn := num_phaseCol S.inL S.kind S.hsd S.hrd (Or.inr ha) hi hc
  have := tmplCol_num_gt S ha
  simp only [OrdStep.s, OrdStep.d]
  omega

/-! ## G9.4 — the stack of a phase copy (address algebra, T3.2i) -/

-- G9.4s1: the stack of `underCol h b` is the stack of `h` together with the `underCol h`-image of
-- the stack of `b`
theorem onStack_underCol (h b o : ColAddr) :
    (underCol h b).OnStack o ↔ h.OnStack o ∨ ∃ o', b.OnStack o' ∧ o = underCol h o' := by
  obtain ⟨hp, hc⟩ := h
  obtain ⟨bp, bc⟩ := b
  obtain ⟨op, oc⟩ := o
  cases bp with
  | nil =>
    show ColAddr.OnStack ⟨hp, hc + bc⟩ ⟨op, oc⟩ ↔ _
    unfold ColAddr.OnStack
    simp only
    constructor
    · rintro (hA | ⟨hpe, hlt⟩)
      · exact Or.inl (Or.inl hA)
      · by_cases hlt' : oc < hc
        · exact Or.inl (Or.inr ⟨hpe, hlt'⟩)
        · refine Or.inr ⟨⟨[], oc - hc⟩, Or.inr ⟨rfl, by simp only; omega⟩, ?_⟩
          show (⟨op, oc⟩ : ColAddr) = ⟨hp, hc + (oc - hc)⟩
          rw [hpe, show hc + (oc - hc) = oc by omega]
    · rintro ((hA | ⟨hpe, hlt⟩) | ⟨⟨op', oc'⟩, hst, hoe⟩)
      · exact Or.inl hA
      · exact Or.inr ⟨hpe, by omega⟩
      · rcases hst with ⟨k, ck, ik, hk, -, -⟩ | ⟨hp', hlt'⟩
        · simp at hk
        · simp only at hp' hlt'
          subst hp'
          change (⟨op, oc⟩ : ColAddr) = ⟨hp, hc + oc'⟩ at hoe
          simp only [ColAddr.mk.injEq] at hoe
          exact Or.inr ⟨hoe.1, by omega⟩
  | cons p rest =>
    obtain ⟨c0, e0⟩ := p
    show ColAddr.OnStack ⟨hp ++ (hc + c0, e0) :: rest, bc⟩ ⟨op, oc⟩ ↔ _
    unfold ColAddr.OnStack
    simp only
    constructor
    · rintro (⟨k, ck, ik, hk, hpe, hle⟩ | ⟨hpe, hlt⟩)
      · rcases Nat.lt_trichotomy k hp.length with hkl | hkl | hkl
        · rw [List.getElem?_append_left hkl] at hk
          rw [List.take_append_of_le_length hkl.le] at hpe
          exact Or.inl (Or.inl ⟨k, ck, ik, hk, hpe, hle⟩)
        · subst hkl
          rw [List.getElem?_append_right le_rfl, Nat.sub_self] at hk
          simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hk
          obtain ⟨h1, -⟩ := hk
          rw [List.take_left' rfl] at hpe
          by_cases hlt' : oc < hc
          · exact Or.inl (Or.inr ⟨hpe, hlt'⟩)
          · refine Or.inr ⟨⟨[], oc - hc⟩, Or.inl ⟨0, c0, e0, rfl, rfl, by simp only; omega⟩, ?_⟩
            show (⟨op, oc⟩ : ColAddr) = ⟨hp, hc + (oc - hc)⟩
            rw [hpe, show hc + (oc - hc) = oc by omega]
        · obtain ⟨j, hj⟩ : ∃ j, k = hp.length + (j + 1) := ⟨k - hp.length - 1, by omega⟩
          rw [hj, List.getElem?_append_right (by omega), Nat.add_sub_cancel_left] at hk
          rw [hj, List.take_length_add_append] at hpe
          refine Or.inr ⟨⟨(c0, e0) :: rest.take j, oc⟩,
            Or.inl ⟨j + 1, ck, ik, hk, by simp, hle⟩, ?_⟩
          show (⟨op, oc⟩ : ColAddr) = ⟨hp ++ (hc + c0, e0) :: rest.take j, oc⟩
          rw [hpe]
          simp
      · refine Or.inr ⟨⟨(c0, e0) :: rest, oc⟩, Or.inr ⟨rfl, hlt⟩, ?_⟩
        show (⟨op, oc⟩ : ColAddr) = ⟨hp ++ (hc + c0, e0) :: rest, oc⟩
        rw [hpe]
    · rintro ((⟨k, ck, ik, hk, hpe, hle⟩ | ⟨hpe, hlt⟩) | ⟨⟨op', oc'⟩, hst, hoe⟩)
      · have hkl : k < hp.length := (List.getElem?_eq_some_iff.mp hk).1
        refine Or.inl ⟨k, ck, ik, ?_, ?_, hle⟩
        · rw [List.getElem?_append_left hkl]; exact hk
        · rw [List.take_append_of_le_length hkl.le]; exact hpe
      · refine Or.inl ⟨hp.length, hc + c0, e0, ?_, ?_, by omega⟩
        · rw [List.getElem?_append_right le_rfl, Nat.sub_self]; rfl
        · rw [List.take_left' rfl]; exact hpe
      · rcases hst with ⟨k, ck, ik, hk, hpe, hle⟩ | ⟨hpe, hlt⟩
        · simp only at hpe hle
          cases k with
          | zero =>
            simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hk
            obtain ⟨h1, -⟩ := hk
            simp only [List.take_zero] at hpe
            subst hpe
            change (⟨op, oc⟩ : ColAddr) = ⟨hp, hc + oc'⟩ at hoe
            simp only [ColAddr.mk.injEq] at hoe
            obtain ⟨h3, h4⟩ := hoe
            rw [h3, h4]
            refine Or.inl ⟨hp.length, hc + c0, e0, ?_, ?_, by omega⟩
            · rw [List.getElem?_append_right le_rfl, Nat.sub_self]; rfl
            · rw [List.take_left' rfl]
          | succ j =>
            simp only [List.take_succ_cons] at hpe
            subst hpe
            change (⟨op, oc⟩ : ColAddr) = ⟨hp ++ (hc + c0, e0) :: rest.take j, oc'⟩ at hoe
            simp only [ColAddr.mk.injEq] at hoe
            obtain ⟨h3, h4⟩ := hoe
            rw [h3, h4]
            refine Or.inl ⟨hp.length + (j + 1), ck, ik, ?_, ?_, hle⟩
            · rw [List.getElem?_append_right (by omega), Nat.add_sub_cancel_left]; exact hk
            · rw [List.take_length_add_append]; rfl
        · simp only at hpe hlt
          subst hpe
          change (⟨op, oc⟩ : ColAddr) = ⟨hp ++ (hc + c0, e0) :: rest, oc'⟩ at hoe
          simp only [ColAddr.mk.injEq] at hoe
          obtain ⟨h3, h4⟩ := hoe
          rw [h3, h4]
          exact Or.inr ⟨rfl, hlt⟩

-- G9.4s2: printed numbers add under `underCol`
theorem num_underCol (h b : ColAddr) : (underCol h b).num 0 = h.num 0 + b.num 0 := by
  obtain ⟨bp, bc⟩ := b
  cases bp with
  | nil => simp [underCol, ColAddr.num]; omega
  | cons p rest =>
    obtain ⟨c0, e0⟩ := p
    simp [underCol, ColAddr.num, List.sum_append]; omega

-- G9.4s3: containment is carried by `underCol`
theorem container_underCol (h b o : ColAddr) :
    (underCol h o).container (underCol h b) = (o.container b).map fun e => ⟨underCol h o, e.idx⟩ := by
  obtain ⟨op, oc⟩ := o
  obtain ⟨bp, bc⟩ := b
  cases op with
  | nil =>
    cases bp with
    | nil => simp [underCol, ColAddr.container]
    | cons p rest =>
      obtain ⟨c0, e0⟩ := p
      simp [underCol, ColAddr.container]
  | cons p' rest' =>
    obtain ⟨c0', e0'⟩ := p'
    cases bp with
    | nil =>
      simp only [underCol, ColAddr.container]
      rw [List.drop_eq_nil_of_le (by simp)]
      simp
    | cons p rest =>
      obtain ⟨c0, e0⟩ := p
      simp only [underCol, ColAddr.container, List.length_append, List.length_cons]
      rw [List.drop_length_add_append, List.take_length_add_append]
      simp
      rcases List.drop rest'.length rest with _ | ⟨⟨k, i⟩, tail⟩
      · simp
      · simp

-- G9.4s3b: a column strictly on the stack of `h` contains `underCol h b` exactly when it contains
-- `h`, through the same entry
theorem container_underCol_of_onStack {h o : ColAddr} (ho : h.OnStack o) (b : ColAddr) :
    o.container (underCol h b) = o.container h := by
  obtain ⟨bp, bc⟩ := b
  rcases ho with ⟨k, ck, ik, hk, hp, hc⟩ | ⟨hp, hc⟩
  · have hkl : k < h.path.length := (List.getElem?_eq_some_iff.mp hk).1
    cases bp with
    | nil => rfl
    | cons p rest =>
      obtain ⟨c0, e0⟩ := p
      simp only [underCol, ColAddr.container, hp, List.length_take]
      rw [Nat.min_eq_left hkl.le]
      rw [List.drop_append_of_le_length hkl.le, List.take_append_of_le_length hkl.le]
      rw [List.drop_eq_getElem_cons hkl]
      rfl
  · cases bp with
    | nil => simp [underCol, ColAddr.container, hp]
    | cons p rest =>
      obtain ⟨c0, e0⟩ := p
      simp [underCol, ColAddr.container, hp]
      omega

-- G9 (helper): the root-tail branch of `kerCol`, case by case
theorem kerCol_tail_spec (S : OrdStep) {x x' : ColAddr} (hx : kerCol S.sd S.rd x = some x')
    (hxq : isQMat S.sd x = false) :
    ∃ suf, x.path = S.rd.col.path ++ suf ∧
      ((suf = [] ∧ x.col = S.rd.col.col ∧ x' = ⟨[], 0⟩) ∨
       (suf = [] ∧ S.rd.col.col < x.col ∧ S.rd.owner = false ∧ x' = ⟨[], x.col - S.rd.col.col⟩) ∨
       (∃ e rest, suf = (S.rd.col.col, e) :: rest ∧ S.rd.cursor ≤ e ∧
          x' = ⟨(0, S.m + (e - S.rd.cursor)) :: rest, x.col⟩) ∨
       (∃ ci e rest, suf = (ci, e) :: rest ∧ S.rd.col.col < ci ∧ S.rd.owner = false ∧
          x' = ⟨(ci - S.rd.col.col, e) :: rest, x.col⟩)) := by
  obtain ⟨-, -, hidx, -⟩ := rootData_spec S.hsd S.hrd
  unfold kerCol at hx
  simp only [hxq, Bool.false_eq_true, if_false] at hx
  by_cases hR : x.path.take S.rd.col.path.length = S.rd.col.path
  · rw [if_pos hR] at hx
    have hsplit := List.take_append_drop S.rd.col.path.length x.path
    rw [hR] at hsplit
    refine ⟨x.path.drop S.rd.col.path.length, hsplit.symm, ?_⟩
    cases hd : x.path.drop S.rd.col.path.length with
    | nil =>
      rw [hd] at hx
      simp only at hx
      rw [← hidx]
      split_ifs at hx with h1 h2
      · cases hx; exact Or.inl ⟨rfl, h1, rfl⟩
      · cases hx; exact Or.inr (Or.inl ⟨rfl, h2.1, h2.2, rfl⟩)
    | cons p rest =>
      obtain ⟨ci, e⟩ := p
      rw [hd] at hx
      simp only at hx
      rw [← hidx]
      split_ifs at hx with h1 h2
      · cases hx; obtain ⟨rfl, h1'⟩ := h1
        exact Or.inr (Or.inr (Or.inl ⟨e, rest, rfl, h1', rfl⟩))
      · cases hx
        exact Or.inr (Or.inr (Or.inr ⟨ci, e, rest, rfl, h2.1, h2.2, rfl⟩))
  · rw [if_neg hR] at hx
    cases hx

-- G9 (helper): root-tail columns through a root-level step are in the template
theorem kerCol_isSome_cons (S : OrdStep) {o : ColAddr} (hoq : isQMat S.sd o = false) {ci e : Nat}
    {rest : List (Nat × Nat)} (hp : o.path = S.rd.col.path ++ (ci, e) :: rest)
    (hc : (ci = S.rd.col.col ∧ S.rd.cursor ≤ e) ∨ (S.rd.col.col < ci ∧ S.rd.owner = false)) :
    (kerCol S.sd S.rd o).isSome := by
  obtain ⟨-, -, hidx, -⟩ := rootData_spec S.hsd S.hrd
  unfold kerCol
  simp only [hoq, hp, List.take_left, List.drop_left, Bool.false_eq_true, if_false, if_true, hidx]
  rcases hc with h | h
  · rw [if_pos h]; rfl
  · rw [if_neg (by omega), if_pos h]; rfl

-- G9 (helper): root-level columns from the root on are in the template
theorem kerCol_isSome_nil (S : OrdStep) {o : ColAddr} (hoq : isQMat S.sd o = false)
    (hp : o.path = S.rd.col.path)
    (hc : o.col = S.rd.col.col ∨ (S.rd.col.col < o.col ∧ S.rd.owner = false)) :
    (kerCol S.sd S.rd o).isSome := by
  obtain ⟨-, -, hidx, -⟩ := rootData_spec S.hsd S.hrd
  unfold kerCol
  simp only [hoq, hp, List.take_length, List.drop_length, Bool.false_eq_true, if_false, if_true, hidx]
  rcases hc with h | h
  · rw [if_pos h]; rfl
  · rw [if_neg (by omega), if_pos h]; rfl

-- G9 (helper): Q-material is closed under extending the address path
theorem isQMat_of_prefix (sd : StopData) {o x : ColAddr} (ho : isQMat sd o = true)
    (hpre : o.path <+: x.path) : isQMat sd x = true := by
  obtain ⟨t, ht⟩ := hpre
  unfold isQMat at ho ⊢
  cases hd : o.path.drop sd.col.path.length with
  | nil => simp [hd] at ho
  | cons p rest =>
    have hlen : sd.col.path.length < o.path.length := by
      by_contra hc
      rw [List.drop_eq_nil_of_le (by omega)] at hd
      cases hd
    rw [← ht, List.take_append_of_le_length hlen.le, List.drop_append_of_le_length hlen.le, hd]
    rw [hd] at ho
    exact ho

-- G9 (helper): a stack column's path is a prefix of the column's path
theorem onStack_prefix {x o : ColAddr} (ho : x.OnStack o) : o.path <+: x.path := by
  rcases ho with ⟨k, -, -, -, hp, -⟩ | ⟨hp, -⟩
  · rw [hp]; exact List.take_prefix _ _
  · rw [hp]

-- G9.4s4b: every stack column with number `≥ r` of root-tail material is root-tail material
theorem kerCol_of_onStack_tail (S : OrdStep) {x x' : ColAddr} (hx : kerCol S.sd S.rd x = some x')
    (hxq : isQMat S.sd x = false) {o : ColAddr} (ho : x.OnStack o) (hr : S.sd.r ≤ o.num 0) :
    (kerCol S.sd S.rd o).isSome ∧ isQMat S.sd o = false := by
  obtain ⟨-, -, hidx, hrnum, -⟩ := rootData_spec S.hsd S.hrd
  obtain ⟨suf, hpath, hcases⟩ := kerCol_tail_spec S hx hxq
  have hoq : isQMat S.sd o = false := by
    cases h : isQMat S.sd o
    · rfl
    · have := isQMat_of_prefix S.sd h (onStack_prefix ho)
      rw [this] at hxq
      cases hxq
  refine ⟨?_, hoq⟩
  have hnot : ¬ S.rd.col.OnStack o := fun h => by
    have := ColAddr.num_lt_of_onStack 0 h
    omega
  rcases ho with ⟨k, ck, ik, hk, hop, hoc⟩ | ⟨hop, hoc⟩
  · by_cases hkR : k < S.rd.col.path.length
    · exfalso
      apply hnot
      refine Or.inl ⟨k, ck, ik, ?_, ?_, hoc⟩
      · rw [hpath, List.getElem?_append_left hkR] at hk; exact hk
      · rw [hop, hpath, List.take_append_of_le_length hkR.le]
    · rw [not_lt] at hkR
      obtain ⟨j, hj⟩ : ∃ j, k = S.rd.col.path.length + j := ⟨k - S.rd.col.path.length, by omega⟩
      rw [hpath, hj, List.getElem?_append_right (by omega), Nat.add_sub_cancel_left] at hk
      rw [hpath, hj, List.take_length_add_append] at hop
      cases j with
      | zero =>
        simp only [List.take_zero, List.append_nil] at hop
        -- `o` sits at the root's level, at most at the column `ck` of `x`'s first step
        rcases Nat.lt_trichotomy o.col S.rd.col.col with hlt | heq | hgt
        · exact absurd (Or.inr ⟨hop, hlt⟩) hnot
        · exact kerCol_isSome_nil S hoq hop (Or.inl heq)
        · refine kerCol_isSome_nil S hoq hop (Or.inr ⟨hgt, ?_⟩)
          rcases hcases with ⟨rfl, -⟩ | ⟨rfl, -⟩ | ⟨e, rest, rfl, -, -⟩ | ⟨ci, e, rest, rfl, -, hown, -⟩
          · simp at hk
          · simp at hk
          · simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hk
            omega
          · exact hown
      | succ j =>
        rcases hcases with ⟨rfl, -⟩ | ⟨rfl, -⟩ | ⟨e, rest, rfl, he, -⟩ | ⟨ci, e, rest, rfl, hci, hown, -⟩
        · simp at hk
        · simp at hk
        · simp only [List.take_succ_cons] at hop
          exact kerCol_isSome_cons S hoq hop (Or.inl ⟨rfl, he⟩)
        · simp only [List.take_succ_cons] at hop
          exact kerCol_isSome_cons S hoq hop (Or.inr ⟨hci, hown⟩)
  · rw [hpath] at hop
    rcases hcases with ⟨rfl, hxc, -⟩ | ⟨rfl, hxc, hown, -⟩ | ⟨e, rest, rfl, he, -⟩ |
        ⟨ci, e, rest, rfl, hci, hown, -⟩
    · simp only [List.append_nil] at hop
      exact absurd (Or.inr ⟨hop, by omega⟩) hnot
    · simp only [List.append_nil] at hop
      rcases Nat.lt_trichotomy o.col S.rd.col.col with hlt | heq | hgt
      · exact absurd (Or.inr ⟨hop, hlt⟩) hnot
      · exact kerCol_isSome_nil S hoq hop (Or.inl heq)
      · exact kerCol_isSome_nil S hoq hop (Or.inr ⟨hgt, hown⟩)
    · exact kerCol_isSome_cons S hoq hop (Or.inl ⟨rfl, he⟩)
    · exact kerCol_isSome_cons S hoq hop (Or.inr ⟨hci, hown⟩)

theorem num_kerCol_tail (S : OrdStep) {x x' : ColAddr} (hx : kerCol S.sd S.rd x = some x')
    (hxq : isQMat S.sd x = false) : x'.num 0 + S.sd.r = x.num 0 := by
  obtain ⟨-, -, -, hrnum, -⟩ := rootData_spec S.hsd S.hrd
  obtain ⟨suf, hpath, hcases⟩ := kerCol_tail_spec S hx hxq
  have hnum : ∀ b : ColAddr, b.num 0 = (b.path.map (·.1 + 1)).sum + b.col := by
    intro b; simp [ColAddr.num]
  have hx1 := hnum x
  have hr1 := hnum S.rd.col
  rw [hpath, List.map_append, List.sum_append] at hx1
  rw [← hrnum]
  rcases hcases with ⟨rfl, h1, rfl⟩ | ⟨rfl, h1, -, rfl⟩ | ⟨e, rest, rfl, -, rfl⟩ |
      ⟨ci, e, rest, rfl, h1, -, rfl⟩
  · simp [ColAddr.num] at hx1 ⊢; omega
  · simp [ColAddr.num] at hx1 ⊢; omega
  · simp [ColAddr.num] at hx1 ⊢; omega
  · simp [ColAddr.num] at hx1 ⊢; omega

-- G9 (helper)
theorem container_col {o b : ColAddr} {e : EntryAddr} (h : o.container b = some e) : e.col = o :=
  ((ColAddr.container_spec o b e).mp h).1

-- G9 (helper): containment below a common step
theorem container_cons (ci ei : Nat) (π₁ π₂ : List (Nat × Nat)) (c₁ c₂ : Nat) :
    (⟨(ci, ei) :: π₁, c₁⟩ : ColAddr).container ⟨(ci, ei) :: π₂, c₂⟩ =
      ((⟨π₁, c₁⟩ : ColAddr).container ⟨π₂, c₂⟩).map fun e => ⟨⟨(ci, ei) :: π₁, c₁⟩, e.idx⟩ := by
  unfold ColAddr.container
  simp only [List.length_cons, List.drop_succ_cons, List.take_succ_cons, List.cons.injEq, true_and]
  cases List.drop π₁.length π₂ with
  | nil => rfl
  | cons x xs =>
    obtain ⟨k, i⟩ := x
    simp only
    split_ifs <;> rfl

-- G9 (helper): containment below a common prefix
theorem container_append (R so sx : List (Nat × Nat)) (c c' : Nat) :
    (⟨R ++ so, c⟩ : ColAddr).container ⟨R ++ sx, c'⟩ =
      ((⟨so, c⟩ : ColAddr).container ⟨sx, c'⟩).map fun e => ⟨⟨R ++ so, c⟩, e.idx⟩ := by
  induction R with
  | nil =>
    simp only [List.nil_append]
    cases h : (⟨so, c⟩ : ColAddr).container ⟨sx, c'⟩ with
    | none => rfl
    | some e =>
      simp only [Option.map_some]
      rw [← container_col h]
  | cons s R ih =>
    obtain ⟨ci, ei⟩ := s
    rw [List.cons_append, List.cons_append, container_cons, ih, Option.map_map]
    rfl

-- G9 (helper): a column at the root level contains nothing at the root level
theorem container_nil_nil (c c' : Nat) : (⟨[], c⟩ : ColAddr).container ⟨[], c'⟩ = none := by
  simp [ColAddr.container]

-- G9 (helper)
theorem container_nil_cons (c c' k i : Nat) (rest : List (Nat × Nat)) :
    (⟨[], c⟩ : ColAddr).container ⟨(k, i) :: rest, c'⟩ = if k = c then some ⟨⟨[], c⟩, i⟩ else none := by
  simp [ColAddr.container]

-- G9 (helper)
theorem container_cons_nil (c c' : Nat) (s : Nat × Nat) (rest : List (Nat × Nat)) :
    (⟨s :: rest, c⟩ : ColAddr).container ⟨[], c'⟩ = none := by
  simp [ColAddr.container]

-- G9 (helper)
theorem container_cons_ne (c c' : Nat) (s t : Nat × Nat) (rs rt : List (Nat × Nat)) (h : s ≠ t) :
    (⟨s :: rs, c⟩ : ColAddr).container ⟨t :: rt, c'⟩ = none := by
  unfold ColAddr.container
  simp only [List.length_cons, List.drop_succ_cons, List.take_succ_cons, List.cons.injEq]
  cases List.drop rs.length rt with
  | nil => rfl
  | cons x xs =>
    obtain ⟨k, i⟩ := x
    simp only
    rw [if_neg (by intro hh; exact h hh.1.1.symm)]

theorem container_kerCol (S : OrdStep) {x x' o o' : ColAddr} (hx : kerCol S.sd S.rd x = some x')
    (ho : kerCol S.sd S.rd o = some o') (hxq : isQMat S.sd x = false) :
    o'.container x' = (o.container x).map fun e =>
      ⟨o', if o = S.rd.col then S.m + (e.idx - S.rd.cursor) else e.idx⟩ := by
  obtain ⟨sx, hxp, hxc⟩ := kerCol_tail_spec S hx hxq
  by_cases hoq : isQMat S.sd o = true
  · -- Q-material `o` contains no root-tail column, and its image contains no image of one
    have hox : o.container x = none := by
      cases h : o.container x with
      | none => rfl
      | some e =>
        exfalso
        obtain ⟨-, hpre⟩ := (ColAddr.container_spec o x e).mp h
        have hpre' : o.path <+: x.path := by
          rw [← container_col h]
          exact List.IsPrefix.trans (List.prefix_append _ _) hpre
        have := isQMat_of_prefix S.sd hoq hpre'
        rw [hxq] at this
        cases this
    rw [hox, Option.map_none]
    -- `o' = ⟨(0, j) :: rest, o.col⟩` with `j < m`
    unfold kerCol at ho
    rw [if_pos hoq] at ho
    unfold isQMat at hoq
    cases hd : o.path.drop S.sd.col.path.length with
    | nil => rw [hd] at ho; cases ho
    | cons p rest =>
      obtain ⟨ci, j⟩ := p
      rw [hd] at ho hoq
      simp only [Option.some.injEq] at ho
      subst ho
      simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at hoq
      have hj : j < S.m := hoq.2.2
      rcases hxc with ⟨-, -, rfl⟩ | ⟨-, -, -, rfl⟩ | ⟨e, rest', -, -, rfl⟩ |
          ⟨ci', e, rest', -, hci', -, rfl⟩
      · exact container_cons_nil _ _ _ _
      · exact container_cons_nil _ _ _ _
      · exact container_cons_ne _ _ _ _ _ _ (by simp; omega)
      · exact container_cons_ne _ _ _ _ _ _ (by simp; omega)
  · have hoq' : isQMat S.sd o = false := by simpa using hoq
    obtain ⟨so, hop, hoc⟩ := kerCol_tail_spec S ho hoq'
    obtain ⟨-, -, hidx, -⟩ := rootData_spec S.hsd S.hrd
    have hoeq : o = ⟨S.rd.col.path ++ so, o.col⟩ := by
      show (⟨o.path, o.col⟩ : ColAddr) = _; rw [hop]
    have hxeq : x = ⟨S.rd.col.path ++ sx, x.col⟩ := by
      show (⟨x.path, x.col⟩ : ColAddr) = _; rw [hxp]
    have hcont : o.container x = ((⟨so, o.col⟩ : ColAddr).container ⟨sx, x.col⟩).map
        fun e => ⟨o, e.idx⟩ := by
      conv_lhs => rw [hoeq, hxeq]
      rw [container_append]
      rw [← hoeq]
    rw [hcont, Option.map_map]
    rcases hoc with ⟨rfl, hoc, rfl⟩ | ⟨rfl, hoc, hown, rfl⟩ | ⟨e₀, rest_o, rfl, he₀, rfl⟩ |
        ⟨ci₀, e₀, rest_o, rfl, hci₀, hown, rfl⟩
    · -- `o` is the root column
      have hor : o = S.rd.col := by
        rw [hoeq]; show (⟨_, _⟩ : ColAddr) = ⟨S.rd.col.path, S.rd.col.col⟩; rw [List.append_nil, hoc]
      rcases hxc with ⟨rfl, -, rfl⟩ | ⟨rfl, -, -, rfl⟩ | ⟨e, rest', rfl, he, rfl⟩ |
          ⟨ci', e, rest', rfl, hci', -, rfl⟩
      · simp [container_nil_nil]
      · simp [container_nil_nil]
      · rw [container_nil_cons, container_nil_cons, if_pos rfl, if_pos hoc.symm]
        simp [hor]
      · rw [container_nil_cons, container_nil_cons, if_neg (by omega), if_neg (by omega)]
        rfl
    · -- `o` a later root-level column
      have hor : o ≠ S.rd.col := by
        intro h; rw [h] at hoc; omega
      rcases hxc with ⟨rfl, -, rfl⟩ | ⟨rfl, -, -, rfl⟩ | ⟨e, rest', rfl, he, rfl⟩ |
          ⟨ci', e, rest', rfl, hci', -, rfl⟩
      · simp [container_nil_nil]
      · simp [container_nil_nil]
      · rw [container_nil_cons, container_nil_cons, if_neg (by omega), if_neg (by omega)]
        rfl
      · rw [container_nil_cons, container_nil_cons]
        by_cases hco : ci' = o.col
        · rw [if_pos hco, if_pos (by omega)]
          simp [hor]
        · rw [if_neg hco, if_neg (by omega)]
          rfl
    · -- `o` inside a restored height of the root
      have hor : o ≠ S.rd.col := by
        intro h; rw [h] at hop
        have := congrArg List.length hop
        simp at this
      rcases hxc with ⟨rfl, -, rfl⟩ | ⟨rfl, -, -, rfl⟩ | ⟨e, rest', rfl, he, rfl⟩ |
          ⟨ci', e, rest', rfl, hci', -, rfl⟩
      · simp [container_cons_nil]
      · simp [container_cons_nil]
      · by_cases hee : e = e₀
        · subst hee
          rw [container_cons, container_cons]
          simp only [Option.map_map]
          congr 1
          funext e'
          simp [hor]
        · rw [container_cons_ne _ _ _ _ _ _ (by simp; omega),
            container_cons_ne _ _ _ _ _ _ (by simp; omega)]
          rfl
      · rw [container_cons_ne _ _ _ _ _ _ (by simp; omega),
          container_cons_ne _ _ _ _ _ _ (by simp; omega)]
        rfl
    · -- `o` in a later body column of the root forest
      have hor : o ≠ S.rd.col := by
        intro h; rw [h] at hop
        have := congrArg List.length hop
        simp at this
      rcases hxc with ⟨rfl, -, rfl⟩ | ⟨rfl, -, -, rfl⟩ | ⟨e, rest', rfl, he, rfl⟩ |
          ⟨ci', e, rest', rfl, hci', -, rfl⟩
      · simp [container_cons_nil]
      · simp [container_cons_nil]
      · rw [container_cons_ne _ _ _ _ _ _ (by simp; omega),
          container_cons_ne _ _ _ _ _ _ (by simp; omega)]
        rfl
      · by_cases hee : ci' = ci₀ ∧ e = e₀
        · obtain ⟨rfl, rfl⟩ := hee
          rw [container_cons, container_cons]
          simp only [Option.map_map]
          congr 1
          funext e'
          simp [hor]
        · rw [container_cons_ne _ _ _ _ _ _ (by simp; omega),
            container_cons_ne _ _ _ _ _ _ (by simp; omega)]
          rfl

-- G9 (helper): Q-material, explicitly
theorem isQMat_spec (sd : StopData) {a : ColAddr} (h : isQMat sd a = true) :
    ∃ j rest, a.path = sd.col.path ++ (sd.col.col, j) :: rest ∧ j < sd.Q.length := by
  unfold isQMat at h
  cases hd : a.path.drop sd.col.path.length with
  | nil => simp [hd] at h
  | cons p rest =>
    obtain ⟨ci, j⟩ := p
    simp only [hd, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at h
    obtain ⟨htk, hci, hj⟩ := h
    refine ⟨j, rest, ?_, hj⟩
    rw [← List.take_append_drop sd.col.path.length a.path, htk, hd, hci]

-- G9 (helper)
theorem isQMat_of_spec (sd : StopData) {a : ColAddr} {j : Nat} {rest : List (Nat × Nat)}
    (hp : a.path = sd.col.path ++ (sd.col.col, j) :: rest) (hj : j < sd.Q.length) :
    isQMat sd a = true := by
  unfold isQMat
  rw [hp, List.take_left, List.drop_left]
  simp [hj]

-- G9 (helper): the template map on Q-material
theorem kerCol_qmat (S : OrdStep) {a : ColAddr} (h : isQMat S.sd a = true) {j : Nat}
    {rest : List (Nat × Nat)} (hp : a.path = S.sd.col.path ++ (S.sd.col.col, j) :: rest) :
    kerCol S.sd S.rd a = some ⟨(0, j) :: rest, a.col⟩ := by
  unfold kerCol
  simp only [h, if_true, hp, List.drop_left]

-- G9.4s5: the stack of Q-material images: the head and Q-material images only
theorem onStack_kerCol_qmat (S : OrdStep) {x x' : ColAddr} (hx : kerCol S.sd S.rd x = some x')
    (hxq : isQMat S.sd x = true) (o' : ColAddr) :
    x'.OnStack o' ↔ o' = ⟨[], 0⟩ ∨ ∃ o, x.OnStack o ∧ isQMat S.sd o = true ∧
      kerCol S.sd S.rd o = some o' := by
  obtain ⟨j, rest, hxp, hj⟩ := isQMat_spec S.sd hxq
  rw [kerCol_qmat S hxq hxp, Option.some.injEq] at hx
  subst hx
  obtain ⟨op, oc⟩ := o'
  constructor
  · rintro (⟨l, ck, ik, hl, hp, hle⟩ | ⟨hp, hlt⟩)
    · simp only at hp hle hl
      cases l with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hl
        simp only [List.take_zero] at hp
        left
        rw [hp, show oc = 0 by omega]
      | succ l =>
        simp only [List.getElem?_cons_succ] at hl
        simp only [List.take_succ_cons] at hp
        right
        refine ⟨⟨S.sd.col.path ++ (S.sd.col.col, j) :: rest.take l, oc⟩, ?_, ?_, ?_⟩
        · refine Or.inl ⟨S.sd.col.path.length + (l + 1), ck, ik, ?_, ?_, hle⟩
          · rw [hxp, List.getElem?_append_right (by omega), Nat.add_sub_cancel_left]
            simpa using hl
          · rw [hxp, List.take_length_add_append]; rfl
        · exact isQMat_of_spec S.sd (rest := rest.take l) rfl hj
        · rw [kerCol_qmat S (isQMat_of_spec S.sd (rest := rest.take l) rfl hj) rfl, hp]
    · simp only at hp hlt
      right
      refine ⟨⟨x.path, oc⟩, Or.inr ⟨rfl, hlt⟩, isQMat_of_spec S.sd hxp hj, ?_⟩
      have hq : isQMat S.sd ⟨x.path, oc⟩ = true := isQMat_of_spec S.sd hxp hj
      rw [kerCol_qmat S hq (show (⟨x.path, oc⟩ : ColAddr).path = _ from hxp), hp]
  · rintro (h0 | ⟨⟨op₀, oc₀⟩, hst, hq, hk⟩)
    · rw [h0]
      exact Or.inl ⟨0, 0, j, rfl, rfl, le_rfl⟩
    · obtain ⟨j', rest_o, hop, hj'⟩ := isQMat_spec S.sd hq
      rw [kerCol_qmat S hq hop, Option.some.injEq] at hk
      simp only at hop
      rw [← hk]
      rcases hst with ⟨k, ck, ik, hk', hp, hle⟩ | ⟨hp, hlt⟩
      · simp only at hp hle
        have hklen : k = S.sd.col.path.length + 1 + rest_o.length := by
          have := congrArg List.length hp
          have hkl : k < x.path.length := (List.getElem?_eq_some_iff.mp hk').1
          rw [hop, List.length_take, List.length_append, List.length_cons,
            Nat.min_eq_left hkl.le] at this
          omega
        rw [hxp, hklen, show S.sd.col.path.length + 1 + rest_o.length = S.sd.col.path.length + (rest_o.length + 1) by omega,
          List.take_length_add_append, List.take_succ_cons, hop] at hp
        have hp' := List.append_cancel_left hp
        simp only [List.cons.injEq, Prod.mk.injEq, true_and] at hp'
        obtain ⟨rfl, hrest⟩ := hp'
        rw [hxp, hklen, show S.sd.col.path.length + 1 + rest_o.length = S.sd.col.path.length + (rest_o.length + 1) by omega,
          List.getElem?_append_right (by omega), Nat.add_sub_cancel_left] at hk'
        simp only [List.getElem?_cons_succ] at hk'
        refine Or.inl ⟨rest_o.length + 1, ck, ik, ?_, ?_, hle⟩
        · simpa using hk'
        · simp only [List.take_succ_cons]
          exact congrArg _ hrest
      · simp only at hp hlt
        rw [hop, hxp] at hp
        have hp' := List.append_cancel_left hp
        simp only [List.cons.injEq, Prod.mk.injEq, true_and] at hp'
        obtain ⟨rfl, rfl⟩ := hp'
        exact Or.inr ⟨rfl, hlt⟩

-- G9 (helper): columns of a forest below a step `(ci, ei)`
theorem colAt_cons (cols : List Column) (ci ei : Nat) (π : List (Nat × Nat)) (col : Nat) :
    (Tree.node cols).colAt ⟨(ci, ei) :: π, col⟩ =
      ((cols[ci]?).bind (·[ei]?)).bind fun x => x.2.colAt ⟨π, col⟩ := by
  unfold Tree.colAt
  simp only [Tree.forestAt, Tree.cols]
  cases hx : (cols[ci]?).bind (·[ei]?) with
  | none => rfl
  | some x => obtain ⟨q, h⟩ := x; rfl

-- G9 (helper): the column-level form of G9.4l, by induction along the cap's address
theorem litCapAux_colAt (k p : Nat) (π : List (Nat × Nat)) (j : Nat) (F : Forest)
    (hc : (F.colAt ⟨π, j⟩).isSome) (o : ColAddr) (ho : (⟨π, j⟩ : ColAddr).OnStack o) :
    (∀ e, o.container ⟨π, j⟩ = some e → ∃ col h', F.colAt o = some col ∧ e.idx < col.length ∧
        (litCapAux k p π j F).colAt o = some (col.take e.idx ++ [((col[e.idx]?.map Prod.fst).getD 0, h')])) ∧
      (o.container ⟨π, j⟩ = none → (litCapAux k p π j F).colAt o = F.colAt o) := by
  induction π generalizing F o with
  | nil =>
    obtain ⟨cols⟩ := F
    obtain ⟨op, oc⟩ := o
    rcases ho with ⟨l, cl, il, hl, -, -⟩ | ⟨hp, hlt⟩
    · simp at hl
    · simp only at hp hlt
      subst hp
      have hj : j < cols.length := by
        unfold Tree.colAt at hc
        simp only [Tree.forestAt, Option.bind_some, Tree.cols] at hc
        cases h : cols[j]? with
        | none => rw [h] at hc; cases hc
        | some _ => exact (List.getElem?_eq_some_iff.mp h).1
      refine ⟨fun e he => by simp [ColAddr.container] at he, fun _ => ?_⟩
      unfold litCapAux Tree.colAt
      simp only [Tree.forestAt, Option.bind_some, Tree.cols]
      rw [List.getElem?_append_left (by simp; omega), List.getElem?_take_of_lt hlt]
  | cons s rest ih =>
    obtain ⟨ci, ei⟩ := s
    obtain ⟨cols⟩ := F
    rw [colAt_cons] at hc
    -- the containing entry exists
    obtain ⟨x, hx⟩ : ∃ x, (cols[ci]?).bind (·[ei]?) = some x := by
      cases h : (cols[ci]?).bind (·[ei]?) with
      | none => rw [h] at hc; cases hc
      | some x => exact ⟨x, rfl⟩
    obtain ⟨q, h⟩ := x
    rw [hx] at hc
    simp only [Option.bind_some] at hc
    obtain ⟨colci, hcolci, hei⟩ : ∃ colci, cols[ci]? = some colci ∧ colci[ei]? = some (q, h) := by
      cases h1 : cols[ci]? with
      | none => rw [h1] at hx; cases hx
      | some colci => rw [h1] at hx; exact ⟨colci, rfl, hx⟩
    have hci : ci < cols.length := (List.getElem?_eq_some_iff.mp hcolci).1
    have heil : ei < colci.length := (List.getElem?_eq_some_iff.mp hei).1
    have hK : litCapAux k p ((ci, ei) :: rest) j (Tree.node cols) =
        .node (cols.take ci ++ [colci.take ei ++ [(q, litCapAux k p rest j h)]]) := by
      simp only [litCapAux, List.getD_eq_getElem?_getD, hcolci, Option.getD_some, hei]
    rw [hK]
    have hlen1 : (cols.take ci).length = ci := by rw [List.length_take]; omega
    have hlen2 : (colci.take ei).length = ei := by rw [List.length_take]; omega
    have hKci : (cols.take ci ++ [colci.take ei ++ [(q, litCapAux k p rest j h)]])[ci]? =
        some (colci.take ei ++ [(q, litCapAux k p rest j h)]) := by
      rw [List.getElem?_append_right (le_of_eq hlen1), hlen1, Nat.sub_self]; rfl
    have hKei : (colci.take ei ++ [(q, litCapAux k p rest j h)])[ei]? =
        some (q, litCapAux k p rest j h) := by
      rw [List.getElem?_append_right (le_of_eq hlen2), hlen2, Nat.sub_self]; rfl
    obtain ⟨op, oc⟩ := o
    rcases ho with ⟨l, cl, il, hl, hp, hle⟩ | ⟨hp, hlt⟩
    · simp only at hp hle
      cases l with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hl
        have hcl : cl = ci := hl.1.symm
        simp only [List.take_zero] at hp
        subst hp
        rw [hcl] at hle
        rcases Nat.eq_or_lt_of_le hle with heq | hlt'
        · rw [heq]
          have hcont : (⟨[], ci⟩ : ColAddr).container ⟨(ci, ei) :: rest, j⟩ = some ⟨⟨[], ci⟩, ei⟩ := by
            simp [ColAddr.container]
          refine ⟨fun e he => ?_, fun he => (by rw [hcont] at he; cases he)⟩
          rw [hcont, Option.some.injEq] at he
          subst he
          refine ⟨colci, litCapAux k p rest j h, ?_, heil, ?_⟩
          · unfold Tree.colAt; simp [Tree.forestAt, Tree.cols, hcolci]
          · unfold Tree.colAt
            simp only [Tree.forestAt, Option.bind_some, Tree.cols, hKci, hei]
            simp
        · have hcont : (⟨[], oc⟩ : ColAddr).container ⟨(ci, ei) :: rest, j⟩ = none := by
            unfold ColAddr.container
            simp only [List.length_nil, List.drop_zero, List.take_zero, true_and]
            rw [if_neg (by omega)]
          refine ⟨fun e he => (by rw [hcont] at he; cases he), fun _ => ?_⟩
          unfold Tree.colAt
          simp only [Tree.forestAt, Option.bind_some, Tree.cols]
          rw [List.getElem?_append_left (by simp; omega), List.getElem?_take_of_lt hlt']
      | succ l =>
        simp only [List.getElem?_cons_succ] at hl
        simp only [List.take_succ_cons] at hp
        subst hp
        have ho' : (⟨rest, j⟩ : ColAddr).OnStack ⟨rest.take l, oc⟩ := Or.inl ⟨l, cl, il, hl, rfl, hle⟩
        obtain ⟨ih1, ih2⟩ := ih h hc ⟨rest.take l, oc⟩ ho'
        have hKcol : (Tree.node (cols.take ci ++ [colci.take ei ++ [(q, litCapAux k p rest j h)]])).colAt
            ⟨(ci, ei) :: rest.take l, oc⟩ = (litCapAux k p rest j h).colAt ⟨rest.take l, oc⟩ := by
          rw [colAt_cons, hKci]
          simp only [Option.bind_some, hKei]
        have hFcol : (Tree.node cols).colAt ⟨(ci, ei) :: rest.take l, oc⟩ = h.colAt ⟨rest.take l, oc⟩ := by
          rw [colAt_cons, hx]; rfl
        rw [hKcol, hFcol, container_cons]
        refine ⟨fun e he => ?_, fun he => ?_⟩
        · cases hce : (⟨rest.take l, oc⟩ : ColAddr).container ⟨rest, j⟩ with
          | none => rw [hce] at he; cases he
          | some e' =>
            rw [hce] at he
            simp only [Option.map_some, Option.some.injEq] at he
            subst he
            exact ih1 e' hce
        · cases hce : (⟨rest.take l, oc⟩ : ColAddr).container ⟨rest, j⟩ with
          | none => exact ih2 hce
          | some e' => rw [hce] at he; cases he
    · simp only at hp hlt
      subst hp
      have ho' : (⟨rest, j⟩ : ColAddr).OnStack ⟨rest, oc⟩ := Or.inr ⟨rfl, hlt⟩
      obtain ⟨ih1, ih2⟩ := ih h hc ⟨rest, oc⟩ ho'
      have hKcol : (Tree.node (cols.take ci ++ [colci.take ei ++ [(q, litCapAux k p rest j h)]])).colAt
          ⟨(ci, ei) :: rest, oc⟩ = (litCapAux k p rest j h).colAt ⟨rest, oc⟩ := by
        rw [colAt_cons, hKci]
        simp only [Option.bind_some, hKei]
      have hFcol : (Tree.node cols).colAt ⟨(ci, ei) :: rest, oc⟩ = h.colAt ⟨rest, oc⟩ := by
        rw [colAt_cons, hx]; rfl
      rw [hKcol, hFcol, container_cons]
      refine ⟨fun e he => ?_, fun he => ?_⟩
      · cases hce : (⟨rest, oc⟩ : ColAddr).container ⟨rest, j⟩ with
        | none => rw [hce] at he; cases he
        | some e' =>
          rw [hce] at he
          simp only [Option.map_some, Option.some.injEq] at he
          subst he
          exact ih1 e' hce
      · cases hce : (⟨rest, oc⟩ : ColAddr).container ⟨rest, j⟩ with
        | none => exact ih2 hce
        | some e' => rw [hce] at he; cases he

-- G9.4l: a literal cap keeps every stack column of its cap column: a container through its
-- active entry `u` (same parents up to `u`, same keys before `u`), any other stack column whole
theorem colAt_litCap_onStack {B : Forest} {c o : ColAddr} {k p : Nat} (hc : c ∈ B.colAddrs)
    (ho : c.OnStack o) :
    (∀ e, o.container c = some e →
        parents (litCap B c k p) o = (parents B o).take (e.idx + 1) ∧
        (actualKeys (litCap B c k p) o).take e.idx = (actualKeys B o).take e.idx) ∧
      (o.container c = none → (litCap B c k p).colAt o = B.colAt o) := by
  have hcs : (B.colAt c).isSome := (Tree.mem_colAddrs_iff _ _).mp hc
  have hK : litCap B c k p = litCapAux k p c.path c.col B := by
    show litCapBody B c k p = _
    unfold litCapBody
    rw [if_pos hcs]
  rw [hK]
  obtain ⟨h1, h2⟩ := litCapAux_colAt k p c.path c.col B hcs o ho
  refine ⟨fun e he => ?_, h2⟩
  obtain ⟨col, h', hB, hlt, hKc⟩ := h1 e he
  have hfst : (col[e.idx]?.map Prod.fst).getD 0 = (col[e.idx]'hlt).1 := by
    simp [List.getElem?_eq_getElem hlt]
  refine ⟨?_, ?_⟩
  · simp only [parents, hB, hKc, Option.getD_some, List.map_append, List.map_cons, List.map_nil,
      hfst]
    rw [List.take_add_one, List.getElem?_map, List.getElem?_eq_getElem hlt, List.map_take]
    rfl
  · simp only [actualKeys, hB, hKc, Option.getD_some, List.map_append]
    rw [List.take_left' (by simp; omega), ← List.map_take]

-- G9 (helper): a mapped column, entrywise
theorem mapCol_eq_map (f : Nat → Nat) (col : Column) :
    Tree.mapCol f col = col.map fun x => (f x.1, Tree.map f x.2) := by
  induction col with
  | nil => simp [Tree.mapCol]
  | cons x xs ih =>
    obtain ⟨p, H⟩ := x
    simp [Tree.mapCol, ih]

-- G9 (helper): the zero shift fixes columns
theorem mapCol_shiftVal_zero (r : Nat) (col : Column) : Tree.mapCol (shiftVal r 0) col = col := by
  rw [mapCol_eq_map]
  conv_rhs => rw [← List.map_id col]
  congr 1
  funext x
  rw [shiftVal_zero]
  have : Tree.map (shiftVal r 0) x.2 = x.2 := shift_zero r x.2
  rw [this]
  rfl

-- G9 (helper): the unshifted placement at depth `k + 1` changes only the last entry of the last
-- column, replacing its height
theorem replaceAt_succ_eq (Z : Forest) (k : Nat) (cols : List Column) :
    replaceAt 0 0 Z (k + 1) (.node cols) =
      .node (cols.dropLast ++ (cols.getLast?.map fun col =>
        col.dropLast ++ (col.getLast?.map fun x => (x.1, replaceAt 0 0 Z k x.2)).toList).toList) := by
  have e1 : (fun x : Nat × Forest => (shiftVal 0 0 x.1, Tree.map (shiftVal 0 0) x.2)) = id := by
    funext x
    rw [shiftVal_zero]
    exact congrArg _ (shift_zero 0 x.2)
  have e2 : Tree.mapCol (shiftVal 0 0) = id := by
    funext col
    exact mapCol_shiftVal_zero 0 col
  have e3 : (fun x : Nat × Forest => (shiftVal 0 0 x.1, replaceAt 0 0 Z k x.2)) =
      fun x => (x.1, replaceAt 0 0 Z k x.2) := by
    funext x
    rw [shiftVal_zero]
  simp only [replaceAt, mapLast_eq, e1, e2, e3, List.map_id]
  congr 2
  cases cols.getLast? with
  | none => rfl
  | some col => simp only [Option.map_some, mapLast_eq, List.map_id]

-- G9 (helper): the unshifted placement at depth `0` replaces the last column
theorem replaceAt_zero_eq (Z : Forest) (cols : List Column) (hne : cols ≠ []) :
    replaceAt 0 0 Z 0 (.node cols) = .node (cols.dropLast ++ Z.cols) := by
  cases cols with
  | nil => exact absurd rfl hne
  | cons x xs =>
    simp only [replaceAt]
    congr 2
    conv_rhs => rw [← List.map_id (x :: xs).dropLast]
    congr 1
    funext col
    exact mapCol_shiftVal_zero 0 col

-- G9 (helper): the route path one level down
theorem isRoutePath_cons {F : Forest} {cols : List Column} (hF : F = .node cols) {ci ei : Nat}
    {rest : List (Nat × Nat)} {colci : Column} {q : Nat} {h : Forest}
    (hcolci : cols[ci]? = some colci) (hei : colci[ei]? = some (q, h))
    (hr : Scan.IsRoutePath F ((ci, ei) :: rest)) : Scan.IsRoutePath h rest := by
  intro d hd
  obtain ⟨G, hG, hls⟩ := hr (d + 1) (by simp; omega)
  refine ⟨G, ?_, ?_⟩
  · rw [hF] at hG
    simpa [List.take_succ_cons, Tree.forestAt, Tree.cols, hcolci, hei] using hG
  · simpa using hls

-- G9 (helper): the column-level form of G9.4m, by induction along the route
theorem replaceAt_colAt (Z : Forest) (π : List (Nat × Nat)) (F : Forest)
    (hroute : Scan.IsRoutePath F π) {j : Nat}
    (hlast : ∃ G, F.forestAt π = some G ∧ G.cols.length = j + 1)
    (o : ColAddr) (ho : (⟨π, j⟩ : ColAddr).OnStack o) :
    ((replaceAt 0 0 Z π.length F).colAt o).map (·.map Prod.fst) = (F.colAt o).map (·.map Prod.fst) ∧
    (∀ e, o.container ⟨π, j⟩ = some e →
      ((replaceAt 0 0 Z π.length F).colAt o).map (·.take e.idx) = (F.colAt o).map (·.take e.idx)) ∧
    (o.container ⟨π, j⟩ = none → (replaceAt 0 0 Z π.length F).colAt o = F.colAt o) := by
  -- it suffices to treat the two shapes of the conclusion
  suffices H : (o.container ⟨π, j⟩ = none ∧ (replaceAt 0 0 Z π.length F).colAt o = F.colAt o) ∨
      (∃ e, o.container ⟨π, j⟩ = some e ∧
        ((replaceAt 0 0 Z π.length F).colAt o).map (·.map Prod.fst) = (F.colAt o).map (·.map Prod.fst) ∧
        ((replaceAt 0 0 Z π.length F).colAt o).map (·.take e.idx) = (F.colAt o).map (·.take e.idx)) by
    rcases H with ⟨hn, heq⟩ | ⟨e, he, h1, h2⟩
    · exact ⟨by rw [heq], fun e he => (by rw [hn] at he; cases he), fun _ => heq⟩
    · refine ⟨h1, fun e' he' => ?_, fun hn => (by rw [he] at hn; cases hn)⟩
      rw [he, Option.some.injEq] at he'
      rw [← he']
      exact h2
  induction π generalizing F o with
  | nil =>
    obtain ⟨cols⟩ := F
    obtain ⟨G, hG, hlen⟩ := hlast
    simp only [Tree.forestAt, Option.some.injEq] at hG
    subst hG
    simp only [Tree.cols] at hlen
    obtain ⟨op, oc⟩ := o
    rcases ho with ⟨l, cl, il, hl, -, -⟩ | ⟨hp, hlt⟩
    · simp at hl
    · simp only at hp hlt
      subst hp
      left
      refine ⟨by simp [ColAddr.container], ?_⟩
      rw [List.length_nil, replaceAt_zero_eq Z cols (by intro h; rw [h] at hlen; simp at hlen)]
      unfold Tree.colAt
      simp only [Tree.forestAt, Option.bind_some, Tree.cols]
      rw [List.getElem?_append_left (by simp; omega), List.getElem?_dropLast]
      simp [show oc < cols.length - 1 by omega]
  | cons s rest ih =>
    obtain ⟨ci, ei⟩ := s
    obtain ⟨cols⟩ := F
    -- the route step is the last-column, last-entry step
    obtain ⟨G0, hG0, hls⟩ := hroute 0 (by simp)
    simp only [List.take_zero, Tree.forestAt, Option.some.injEq] at hG0
    subst hG0
    unfold Tree.lastStep? at hls
    simp only [Tree.cols, List.getElem?_cons_zero] at hls
    obtain ⟨lc, hlc, hlcne, hci, hei⟩ : ∃ lc, cols.getLast? = some lc ∧ lc ≠ [] ∧
        ci = cols.length - 1 ∧ ei = lc.length - 1 := by
      cases hg : cols.getLast? with
      | none => rw [hg] at hls; cases hls
      | some lc =>
        rw [hg] at hls
        simp only [Option.bind_some] at hls
        split_ifs at hls with hemp
        simp only [Option.some.injEq, Prod.mk.injEq] at hls
        exact ⟨lc, rfl, by simpa using hemp, hls.1.symm, hls.2.symm⟩
    obtain ⟨pq, hpq⟩ : ∃ x, lc.getLast? = some x := by
      cases h : lc.getLast? with
      | none => simp at h; exact absurd h hlcne
      | some x => exact ⟨x, rfl⟩
    obtain ⟨q, h⟩ := pq
    have hcolsne : cols ≠ [] := by intro h; rw [h] at hlc; cases hlc
    have hcolci : cols[ci]? = some lc := by
      rw [hci, ← List.getLast?_eq_getElem?]; exact hlc
    have heiq : lc[ei]? = some (q, h) := by
      rw [hei, ← List.getLast?_eq_getElem?]; exact hpq
    have hcil : ci < cols.length := (List.getElem?_eq_some_iff.mp hcolci).1
    have heil : ei < lc.length := (List.getElem?_eq_some_iff.mp heiq).1
    have hR : replaceAt 0 0 Z ((ci, ei) :: rest).length (Tree.node cols) =
        .node (cols.dropLast ++ [lc.dropLast ++ [(q, replaceAt 0 0 Z rest.length h)]]) := by
      rw [List.length_cons, replaceAt_succ_eq, hlc]
      simp only [Option.map_some, Option.toList_some, hpq]
    rw [hR]
    have hlen1 : cols.dropLast.length = ci := by simp; omega
    have hlen2 : lc.dropLast.length = ei := by simp; omega
    have hRci : (cols.dropLast ++ [lc.dropLast ++ [(q, replaceAt 0 0 Z rest.length h)]])[ci]? =
        some (lc.dropLast ++ [(q, replaceAt 0 0 Z rest.length h)]) := by
      rw [List.getElem?_append_right (le_of_eq hlen1), hlen1, Nat.sub_self]; rfl
    have hRei : (lc.dropLast ++ [(q, replaceAt 0 0 Z rest.length h)])[ei]? =
        some (q, replaceAt 0 0 Z rest.length h) := by
      rw [List.getElem?_append_right (le_of_eq hlen2), hlen2, Nat.sub_self]; rfl
    have hlc_split : lc = lc.dropLast ++ [(q, h)] := (List.dropLast_append_getLast? (q, h) hpq).symm
    have hroute' := isRoutePath_cons rfl hcolci heiq hroute
    have hlast' : ∃ G, h.forestAt rest = some G ∧ G.cols.length = j + 1 := by
      obtain ⟨G, hG, hl⟩ := hlast
      refine ⟨G, ?_, hl⟩
      simpa [Tree.forestAt, Tree.cols, hcolci, heiq] using hG
    obtain ⟨op, oc⟩ := o
    rcases ho with ⟨l, cl, il, hl, hp, hle⟩ | ⟨hp, hlt⟩
    · simp only at hp hle
      cases l with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hl
        have hcl : cl = ci := hl.1.symm
        simp only [List.take_zero] at hp
        subst hp
        rw [hcl] at hle
        rcases Nat.eq_or_lt_of_le hle with heq | hlt'
        · rw [heq]
          right
          refine ⟨⟨⟨[], ci⟩, ei⟩, by simp [ColAddr.container], ?_, ?_⟩
          · unfold Tree.colAt
            simp only [Tree.forestAt, Option.bind_some, Tree.cols, hRci, hcolci, Option.map_some,
              Option.some.injEq]
            conv_rhs => rw [hlc_split]
            simp
          · unfold Tree.colAt
            simp only [Tree.forestAt, Option.bind_some, Tree.cols, hRci, hcolci, Option.map_some,
              Option.some.injEq]
            rw [List.take_left' hlen2]
            conv_rhs => rw [hlc_split]
            rw [List.take_left' hlen2]
        · left
          refine ⟨?_, ?_⟩
          · unfold ColAddr.container
            simp only [List.length_nil, List.drop_zero, List.take_zero, true_and]
            rw [if_neg (by omega)]
          · unfold Tree.colAt
            simp only [Tree.forestAt, Option.bind_some, Tree.cols]
            rw [List.getElem?_append_left (by omega), List.getElem?_dropLast]
            simp [show oc < cols.length - 1 by omega]
      | succ l =>
        simp only [List.getElem?_cons_succ] at hl
        simp only [List.take_succ_cons] at hp
        subst hp
        have ho' : (⟨rest, j⟩ : ColAddr).OnStack ⟨rest.take l, oc⟩ := Or.inl ⟨l, cl, il, hl, rfl, hle⟩
        have hRcol : (Tree.node (cols.dropLast ++ [lc.dropLast ++ [(q, replaceAt 0 0 Z rest.length h)]])).colAt
            ⟨(ci, ei) :: rest.take l, oc⟩ = (replaceAt 0 0 Z rest.length h).colAt ⟨rest.take l, oc⟩ := by
          rw [colAt_cons, hRci]
          simp only [Option.bind_some, hRei]
        have hFcol : (Tree.node cols).colAt ⟨(ci, ei) :: rest.take l, oc⟩ = h.colAt ⟨rest.take l, oc⟩ := by
          rw [colAt_cons, hcolci]
          simp only [Option.bind_some, heiq]
        rw [hRcol, hFcol, container_cons]
        rcases ih h hroute' hlast' ⟨rest.take l, oc⟩ ho' with ⟨hn, heq⟩ | ⟨e, he, h1, h2⟩
        · exact Or.inl ⟨by rw [hn]; rfl, heq⟩
        · exact Or.inr ⟨⟨⟨(ci, ei) :: rest.take l, oc⟩, e.idx⟩, by rw [he]; rfl, h1, h2⟩
    · simp only at hp hlt
      subst hp
      have ho' : (⟨rest, j⟩ : ColAddr).OnStack ⟨rest, oc⟩ := Or.inr ⟨rfl, hlt⟩
      have hRcol : (Tree.node (cols.dropLast ++ [lc.dropLast ++ [(q, replaceAt 0 0 Z rest.length h)]])).colAt
          ⟨(ci, ei) :: rest, oc⟩ = (replaceAt 0 0 Z rest.length h).colAt ⟨rest, oc⟩ := by
        rw [colAt_cons, hRci]
        simp only [Option.bind_some, hRei]
      have hFcol : (Tree.node cols).colAt ⟨(ci, ei) :: rest, oc⟩ = h.colAt ⟨rest, oc⟩ := by
        rw [colAt_cons, hcolci]
        simp only [Option.bind_some, heiq]
      rw [hRcol, hFcol, container_cons]
      rcases ih h hroute' hlast' ⟨rest, oc⟩ ho' with ⟨hn, heq⟩ | ⟨e, he, h1, h2⟩
      · exact Or.inl ⟨by rw [hn]; rfl, heq⟩
      · exact Or.inr ⟨⟨⟨(ci, ei) :: rest, oc⟩, e.idx⟩, by rw [he]; rfl, h1, h2⟩

-- G9.4m: a context `C_A(Z)` keeps every stack column of the stopping column: same parents, and
-- the same entries except the height of the active entry of a container
theorem colAt_context_onStack {A : Forest} {sd : StopData} (hsd : stopData A = some sd)
    (Z : Forest) {o : ColAddr} (ho : sd.col.OnStack o) :
    parents (context A sd Z) o = parents A o ∧
      (∀ e, o.container sd.col = some e →
        ((context A sd Z).colAt o).map (·.take e.idx) = (A.colAt o).map (·.take e.idx)) ∧
      (o.container sd.col = none → (context A sd Z).colAt o = A.colAt o) := by
  obtain ⟨-, hdepth, -, hroute, -⟩ := stopData_spec hsd
  obtain ⟨hpath, F, hF, hFlen⟩ := (Scan.mem_routeCols_iff _ _).mp hroute
  have hctx : context A sd Z = replaceAt 0 0 Z sd.col.path.length A := by
    unfold context; rw [hdepth]
  rw [hctx]
  obtain ⟨h1, h2, h3⟩ := replaceAt_colAt Z sd.col.path A hpath ⟨F, hF, hFlen⟩ o ho
  refine ⟨?_, h2, h3⟩
  unfold parents
  cases hR : (replaceAt 0 0 Z sd.col.path.length A).colAt o with
  | none =>
    cases hA : A.colAt o with
    | none => rfl
    | some _ => rw [hR, hA] at h1; cases h1
  | some C1 =>
    cases hA : A.colAt o with
    | none => rw [hR, hA] at h1; cases h1
    | some C2 => rw [hR, hA] at h1; simpa using h1

-- G9 (helper): columns of a forest below a step, when the step's column and entry are given
theorem colAt_cons_of {cols : List Column} {ci ei : Nat} {colci : Column} {q : Nat} {h : Forest}
    (hc : cols[ci]? = some colci) (he : colci[ei]? = some (q, h)) (π : List (Nat × Nat)) (col : Nat) :
    (Tree.node cols).colAt ⟨(ci, ei) :: π, col⟩ = h.colAt ⟨π, col⟩ := by
  rw [colAt_cons, hc]
  simp only [Option.bind_some, he]

-- G9 (helper): the column-level form of G9.4m', by induction along the route
theorem replaceAt_colAt_off (Z : Forest) (π : List (Nat × Nat)) (F : Forest)
    (hroute : Scan.IsRoutePath F π) {j : Nat}
    (hlast : ∃ G, F.forestAt π = some G ∧ G.cols.length = j + 1)
    (o : ColAddr) (ho : (F.colAt o).isSome) (hne : o ≠ ⟨π, j⟩)
    (hin : (⟨π, j⟩ : ColAddr).container o = none) (hnc : o.container ⟨π, j⟩ = none) :
    (replaceAt 0 0 Z π.length F).colAt o = F.colAt o := by
  induction π generalizing F o with
  | nil =>
    obtain ⟨cols⟩ := F
    obtain ⟨G, hG, hlen⟩ := hlast
    simp only [Tree.forestAt, Option.some.injEq] at hG
    subst hG
    simp only [Tree.cols] at hlen
    have hcne : cols ≠ [] := by intro h; rw [h] at hlen; simp at hlen
    rw [List.length_nil, replaceAt_zero_eq Z cols hcne]
    obtain ⟨op, oc⟩ := o
    cases op with
    | nil =>
      have hoc : oc < cols.length := by
        unfold Tree.colAt at ho
        simp only [Tree.forestAt, Option.bind_some, Tree.cols] at ho
        cases h : cols[oc]? with
        | none => rw [h] at ho; cases ho
        | some _ => exact (List.getElem?_eq_some_iff.mp h).1
      have hoj : oc ≠ j := fun h => hne (by rw [h])
      unfold Tree.colAt
      simp only [Tree.forestAt, Option.bind_some, Tree.cols]
      rw [List.getElem?_append_left (by simp; omega), List.getElem?_dropLast]
      simp [show oc < cols.length - 1 by omega]
    | cons s rest =>
      obtain ⟨c', e'⟩ := s
      have hc' : c' < cols.length := by
        rw [colAt_cons] at ho
        cases h : cols[c']? with
        | none => rw [h] at ho; cases ho
        | some _ => exact (List.getElem?_eq_some_iff.mp h).1
      have hcj : c' ≠ j := by
        intro h
        apply Option.some_ne_none (⟨⟨[], j⟩, e'⟩ : EntryAddr)
        rw [← hin]
        simp [ColAddr.container, h]
      rw [colAt_cons, colAt_cons]
      rw [List.getElem?_append_left (by simp; omega), List.getElem?_dropLast]
      simp [show c' < cols.length - 1 by omega]
  | cons s rest ih =>
    obtain ⟨ci, ei⟩ := s
    obtain ⟨cols⟩ := F
    obtain ⟨G0, hG0, hls⟩ := hroute 0 (by simp)
    simp only [List.take_zero, Tree.forestAt, Option.some.injEq] at hG0
    subst hG0
    unfold Tree.lastStep? at hls
    simp only [Tree.cols, List.getElem?_cons_zero] at hls
    obtain ⟨lc, hlc, hlcne, hci, hei⟩ : ∃ lc, cols.getLast? = some lc ∧ lc ≠ [] ∧
        ci = cols.length - 1 ∧ ei = lc.length - 1 := by
      cases hg : cols.getLast? with
      | none => rw [hg] at hls; cases hls
      | some lc =>
        rw [hg] at hls
        simp only [Option.bind_some] at hls
        split_ifs at hls with hemp
        simp only [Option.some.injEq, Prod.mk.injEq] at hls
        exact ⟨lc, rfl, by simpa using hemp, hls.1.symm, hls.2.symm⟩
    obtain ⟨pq, hpq⟩ : ∃ x, lc.getLast? = some x := by
      cases h : lc.getLast? with
      | none => simp at h; exact absurd h hlcne
      | some x => exact ⟨x, rfl⟩
    obtain ⟨q, h⟩ := pq
    have hcolci : cols[ci]? = some lc := by
      rw [hci, ← List.getLast?_eq_getElem?]; exact hlc
    have heiq : lc[ei]? = some (q, h) := by
      rw [hei, ← List.getLast?_eq_getElem?]; exact hpq
    have hcil : ci < cols.length := (List.getElem?_eq_some_iff.mp hcolci).1
    have heil : ei < lc.length := (List.getElem?_eq_some_iff.mp heiq).1
    have hR : replaceAt 0 0 Z ((ci, ei) :: rest).length (Tree.node cols) =
        .node (cols.dropLast ++ [lc.dropLast ++ [(q, replaceAt 0 0 Z rest.length h)]]) := by
      rw [List.length_cons, replaceAt_succ_eq, hlc]
      simp only [Option.map_some, Option.toList_some, hpq]
    rw [hR]
    have hlen1 : cols.dropLast.length = ci := by simp; omega
    have hlen2 : lc.dropLast.length = ei := by simp; omega
    have hRci : (cols.dropLast ++ [lc.dropLast ++ [(q, replaceAt 0 0 Z rest.length h)]])[ci]? =
        some (lc.dropLast ++ [(q, replaceAt 0 0 Z rest.length h)]) := by
      rw [List.getElem?_append_right (le_of_eq hlen1), hlen1, Nat.sub_self]; rfl
    have hRei : (lc.dropLast ++ [(q, replaceAt 0 0 Z rest.length h)])[ei]? =
        some (q, replaceAt 0 0 Z rest.length h) := by
      rw [List.getElem?_append_right (le_of_eq hlen2), hlen2, Nat.sub_self]; rfl
    have hroute' := isRoutePath_cons rfl hcolci heiq hroute
    have hlast' : ∃ G, h.forestAt rest = some G ∧ G.cols.length = j + 1 := by
      obtain ⟨G, hG, hl⟩ := hlast
      refine ⟨G, ?_, hl⟩
      simpa [Tree.forestAt, Tree.cols, hcolci, heiq] using hG
    obtain ⟨op, oc⟩ := o
    cases op with
    | nil =>
      have hoc : oc < cols.length := by
        unfold Tree.colAt at ho
        simp only [Tree.forestAt, Option.bind_some, Tree.cols] at ho
        cases h : cols[oc]? with
        | none => rw [h] at ho; cases ho
        | some _ => exact (List.getElem?_eq_some_iff.mp h).1
      have hoci : oc ≠ ci := by
        intro h
        apply Option.some_ne_none (⟨⟨[], oc⟩, ei⟩ : EntryAddr)
        rw [← hnc]
        simp [ColAddr.container, h]
      unfold Tree.colAt
      simp only [Tree.forestAt, Option.bind_some, Tree.cols]
      rw [List.getElem?_append_left (by omega), List.getElem?_dropLast]
      simp [show oc < cols.length - 1 by omega]
    | cons s rest_o =>
      obtain ⟨c', e'⟩ := s
      have hc' : c' < cols.length := by
        rw [colAt_cons] at ho
        cases h : cols[c']? with
        | none => rw [h] at ho; cases ho
        | some _ => exact (List.getElem?_eq_some_iff.mp h).1
      rcases Nat.lt_or_ge c' ci with hlt | hge
      · rw [colAt_cons, colAt_cons]
        rw [List.getElem?_append_left (by omega), List.getElem?_dropLast]
        simp [show c' < cols.length - 1 by omega]
      · have hc'ci : c' = ci := by omega
        subst hc'ci
        have he' : e' < lc.length := by
          rw [colAt_cons, hcolci] at ho
          simp only [Option.bind_some] at ho
          cases h : lc[e']? with
          | none => rw [h] at ho; cases ho
          | some _ => exact (List.getElem?_eq_some_iff.mp h).1
        rcases Nat.lt_or_ge e' ei with hlt | hge'
        · rw [colAt_cons, colAt_cons, hRci, hcolci]
          simp only [Option.bind_some]
          rw [List.getElem?_append_left (by omega), List.getElem?_dropLast]
          simp [show e' < lc.length - 1 by omega]
        · have he'ei : e' = ei := by omega
          subst he'ei
          rw [colAt_cons_of hRci hRei, colAt_cons_of hcolci heiq]
          rw [colAt_cons_of hcolci heiq] at ho
          rw [container_cons] at hin hnc
          apply ih h hroute' hlast' _ ho
          · intro heq
            apply hne
            simp only [ColAddr.mk.injEq] at heq ⊢
            rw [heq.1, heq.2]
            exact ⟨rfl, rfl⟩
          · cases hce : (⟨rest, j⟩ : ColAddr).container ⟨rest_o, oc⟩ with
            | none => rfl
            | some _ => rw [hce] at hin; cases hin
          · cases hce : (⟨rest_o, oc⟩ : ColAddr).container ⟨rest, j⟩ with
            | none => rfl
            | some _ => rw [hce] at hnc; cases hnc

-- G9.4m' (added by the G-009 verification, used by G9.6 for template columns off the stopping
-- column's stack): a context `C_A(Z)` keeps every column of `A` that is not the stopping column,
-- not inside one of its heights and not a container of it
theorem colAt_context_of_not_route {A : Forest} {sd : StopData} (hsd : stopData A = some sd)
    (Z : Forest) {o : ColAddr} (ho : o ∈ A.colAddrs) (hne : o ≠ sd.col)
    (hin : sd.col.container o = none) (hnc : o.container sd.col = none) :
    (context A sd Z).colAt o = A.colAt o := by
  obtain ⟨-, hdepth, -, hroute, -⟩ := stopData_spec hsd
  obtain ⟨hpath, F, hF, hFlen⟩ := (Scan.mem_routeCols_iff _ _).mp hroute
  have hctx : context A sd Z = replaceAt 0 0 Z sd.col.path.length A := by
    unfold context; rw [hdepth]
  rw [hctx]
  exact replaceAt_colAt_off Z sd.col.path A hpath ⟨F, hF, hFlen⟩ o
    ((Tree.mem_colAddrs_iff _ _).mp ho) hne hin hnc

-- G9.4n: the column of a root-tail phase copy is the shifted column of the shorter output
-- `A' = A[n−h]` (the first column of `localSuffix_phase`, T3.2i.6)
theorem colAt_phaseCol_tail (S : OrdStep) {h : Nat} (hh : 1 ≤ h ∧ h ≤ S.n) {o : ColAddr}
    (ho : IsTmplCol S.A S.sd S.rd o) (hoq : isQMat S.sd o = false) {A' : Forest}
    (hA' : expand S.A (S.n - h) = some A') :
    S.B.colAt ((phaseCol S.sd S.rd h o).getD o) =
      (A'.colAt o).map (Tree.mapCol (shiftVal S.sd.r (h * S.d))) := by
  obtain ⟨c, hc⟩ : ∃ c, phaseCol S.sd S.rd h o = some c := by
    have hker := ho.2.2.2
    unfold phaseCol
    cases hk : kerCol S.sd S.rd o with
    | none => rw [hk] at hker; cases hker
    | some a' => exact ⟨_, rfl⟩
  rw [hc, Option.getD_some]
  have hls := localSuffix_phase S.inL S.kind S.hsd S.hrd S.out hh ho hc hA'
  rw [hoq] at hls
  simp only [Bool.false_eq_true, if_false] at hls
  have key : ∀ (E : Forest) (a : ColAddr), E.colAt a = (localSuffix E a).cols.head? := by
    intro E a
    unfold localSuffix Tree.colAt
    cases E.forestAt a.path with
    | none => simp [Tree.cols, Tree.empty]
    | some f => simp [Tree.cols, List.head?_drop]
  rw [key S.B c, hls, key A' o]
  unfold shift
  generalize localSuffix A' o = L
  obtain ⟨cols⟩ := L
  cases cols with
  | nil => simp [Tree.map, Tree.mapCols, Tree.cols]
  | cons x xs => simp [Tree.map, Tree.mapCols, Tree.cols, OrdStep.d]

-- G9 (helper): columns no deeper than the stopping column are not Q-material
theorem isQMat_of_short (sd : StopData) {x : ColAddr} (h : x.path.length ≤ sd.col.path.length) :
    isQMat sd x = false := by
  unfold isQMat
  rw [List.drop_eq_nil_of_le h]
  simp

-- G9 (helper): the root column is not Q-material and maps to the head `⟨[], 0⟩`
theorem isQMat_rdcol (S : OrdStep) : isQMat S.sd S.rd.col = false := by
  obtain ⟨-, -, -, hpre, -⟩ := rootData_path S.hsd S.hrd
  exact isQMat_of_short S.sd hpre.length_le

theorem kerCol_rdcol (S : OrdStep) : kerCol S.sd S.rd S.rd.col = some ⟨[], 0⟩ := by
  obtain ⟨-, -, hidx, -⟩ := rootData_spec S.hsd S.hrd
  unfold kerCol
  simp only [isQMat_rdcol, List.take_length, List.drop_length, Bool.false_eq_true, if_false,
    if_true, hidx]

-- G9 (helper, D3.3a `expand_none_iff`): an ordinary step with an output has a defined kernel
theorem OrdStep.kernelDefined (S : OrdStep) : KernelDefined S.A S.rd := by
  have hE : S.A ≠ Tree.empty := by
    intro h
    have := S.hsd
    rw [h, stopData_eq_none_of_lastCol (Or.inl rfl)] at this
    cases this
  by_contra hk
  have := (expand_none_iff hE S.inL.1 S.inL.2.1 S.kind S.hsd S.hrd S.n).mpr ⟨S.pos, hk⟩
  rw [S.out] at this
  cases this

-- G9 (helper): the stopping column is template material (its image is the kernel hole)
theorem kerCol_sdcol (S : OrdStep) : ∃ kh, kerCol S.sd S.rd S.sd.col = some kh := by
  obtain ⟨hres, -, -, hpre, -, hown, hlast⟩ := rootData_path S.hsd S.hrd
  have hq : isQMat S.sd S.sd.col = false := isQMat_of_short S.sd le_rfl
  have hst := ((ColAddr.resolve_spec 0 _ _ _).mp hres).1
  obtain ⟨suf, hsuf⟩ := hpre
  cases suf with
  | nil =>
    rw [List.append_nil] at hsuf
    have hlt : S.rd.col.col < S.sd.col.col := by
      rcases hst with ⟨k, ck, ik, hk, hp, -⟩ | ⟨-, hlt⟩
      · exfalso
        have h1 := (List.getElem?_eq_some_iff.mp hk).1
        have h2 := congrArg List.length hp
        rw [List.length_take, hsuf] at h2
        omega
      · exact hlt
    have hown' : S.rd.owner = false := by
      cases h : S.rd.owner
      · rfl
      · exfalso
        have := hown.mp h
        simp [ColAddr.container, ← hsuf] at this
    exact Option.isSome_iff_exists.mp (kerCol_isSome_nil S hq hsuf.symm (Or.inr ⟨hlt, hown'⟩))
  | cons p rest =>
    obtain ⟨ci, e⟩ := p
    have hle : S.rd.col.col ≤ ci := by
      rcases hst with ⟨k, ck, ik, hk, hp, hle⟩ | ⟨hp, -⟩
      · have hkl := congrArg List.length hp
        rw [List.length_take, ← hsuf] at hkl
        rw [← hsuf] at hk
        have h1 := (List.getElem?_eq_some_iff.mp hk).1
        simp only [List.length_append, List.length_cons] at hkl h1
        have hk' : k = S.rd.col.path.length := by omega
        subst hk'
        rw [List.getElem?_append_right le_rfl, Nat.sub_self] at hk
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hk
        omega
      · exfalso
        rw [← hsuf] at hp
        have := congrArg List.length hp
        simp at this
    rcases Nat.eq_or_lt_of_le hle with heq | hlt
    · have hcont : S.rd.col.container S.sd.col = some ⟨S.rd.col, e⟩ := by
        simp [ColAddr.container, ← hsuf, heq]
      have hown' : S.rd.owner = true := hown.mpr (by rw [hcont]; rfl)
      have he := hlast _ hcont
      have hkd := S.kernelDefined hown'
      have hcur : S.rd.cursor ≤ e := by
        unfold unconsumed rootCol at hkd
        unfold Packet.rootLenOf at he
        by_contra hc
        exact hkd (List.drop_eq_nil_of_le (by simp only at he; omega))
      exact Option.isSome_iff_exists.mp
        (kerCol_isSome_cons S hq hsuf.symm (Or.inl ⟨heq.symm, hcur⟩))
    · have hown' : S.rd.owner = false := by
        cases h : S.rd.owner
        · rfl
        · exfalso
          have := hown.mp h
          simp [ColAddr.container, ← hsuf] at this
          omega
      exact Option.isSome_iff_exists.mp
        (kerCol_isSome_cons S hq hsuf.symm (Or.inr ⟨hlt, hown'⟩))

-- G9 (helper): template material other than the root has the root on its stack
theorem onStack_rdcol (S : OrdStep) {x x' : ColAddr} (hx : kerCol S.sd S.rd x = some x')
    (hxq : isQMat S.sd x = false) (hne : x ≠ S.rd.col) : x.OnStack S.rd.col := by
  obtain ⟨suf, hpath, hcases⟩ := kerCol_tail_spec S hx hxq
  rcases hcases with ⟨rfl, hc, -⟩ | ⟨rfl, hc, -, -⟩ | ⟨e, rest, rfl, -, -⟩ |
      ⟨ci, e, rest, rfl, hc, -, -⟩
  · exfalso
    apply hne
    show (⟨x.path, x.col⟩ : ColAddr) = ⟨S.rd.col.path, S.rd.col.col⟩
    rw [hpath, hc, List.append_nil]
  · exact Or.inr ⟨by rw [hpath, List.append_nil], hc⟩
  · refine Or.inl ⟨S.rd.col.path.length, S.rd.col.col, e, ?_, ?_, le_rfl⟩
    · rw [hpath, List.getElem?_append_right le_rfl, Nat.sub_self]; rfl
    · rw [hpath, List.take_left]
  · refine Or.inl ⟨S.rd.col.path.length, ci, e, ?_, ?_, hc.le⟩
    · rw [hpath, List.getElem?_append_right le_rfl, Nat.sub_self]; rfl
    · rw [hpath, List.take_left]

-- G9 (helper): iterated placements carry stacks and containment
theorem iterate_underCol_onStack (g : ColAddr) (n : Nat) {x y : ColAddr} (h : x.OnStack y) :
    ((underCol g)^[n] x).OnStack ((underCol g)^[n] y) := by
  induction n with
  | zero => exact h
  | succ n ih =>
    rw [Function.iterate_succ_apply', Function.iterate_succ_apply']
    exact (onStack_underCol g _ _).mpr (Or.inr ⟨_, ih, rfl⟩)

theorem iterate_underCol_container (g : ColAddr) (n : Nat) (o b : ColAddr) :
    ((underCol g)^[n] o).container ((underCol g)^[n] b) =
      (o.container b).map fun e => ⟨(underCol g)^[n] o, e.idx⟩ := by
  induction n with
  | zero =>
    simp only [Function.iterate_zero_apply]
    cases h : o.container b with
    | none => rfl
    | some e =>
      have := container_col h
      simp only [Option.map_some]
      rw [← this]
  | succ n ih =>
    rw [Function.iterate_succ_apply', Function.iterate_succ_apply', container_underCol, ih,
      Option.map_map]
    rfl

-- G9 (helper): the head contains a column exactly through the first step `(0, e)` of its path
theorem container_root_head {Z : ColAddr} {e : EntryAddr} (h : (⟨[], 0⟩ : ColAddr).container Z = some e) :
    Z.path.head? = some (0, e.idx) := by
  unfold ColAddr.container at h
  simp only [List.length_nil, List.drop_zero, List.take_zero] at h
  cases hp : Z.path with
  | nil => rw [hp] at h; cases h
  | cons p rest =>
    obtain ⟨k, j⟩ := p
    rw [hp] at h
    simp only [true_and] at h
    split_ifs at h with hk
    cases h
    simp [hk]

-- G9 (helper): an image of root-tail material entering the head does so through an entry `≥ m`
theorem kerCol_head_zero (S : OrdStep) {x x' : ColAddr} (hx : kerCol S.sd S.rd x = some x')
    (hxq : isQMat S.sd x = false) {j : Nat} (hj : x'.path.head? = some (0, j)) : S.m ≤ j := by
  obtain ⟨suf, -, hcases⟩ := kerCol_tail_spec S hx hxq
  rcases hcases with ⟨-, -, rfl⟩ | ⟨-, -, -, rfl⟩ | ⟨e, rest, -, -, rfl⟩ | ⟨ci, e, rest, -, hc, -, rfl⟩
  · simp at hj
  · simp at hj
  · simp only [List.head?_cons, Option.some.injEq, Prod.mk.injEq, true_and] at hj
    omega
  · simp only [List.head?_cons, Option.some.injEq, Prod.mk.injEq] at hj
    omega

-- G9 (helper): a kernel hole at the head level is a column `≥ 1`
theorem kerHole_col_pos (S : OrdStep) {kh : ColAddr} (hkh : kerCol S.sd S.rd S.sd.col = some kh)
    (hp : kh.path = []) : 1 ≤ kh.col := by
  have hsdq : isQMat S.sd S.sd.col = false := isQMat_of_short S.sd le_rfl
  obtain ⟨suf, hpath, hcases⟩ := kerCol_tail_spec S hkh hsdq
  obtain ⟨-, -, -, hrnum, hrt, -⟩ := rootData_spec S.hsd S.hrd
  obtain ⟨-, -, ht, -⟩ := stopData_spec S.hsd
  rcases hcases with ⟨rfl, hc, rfl⟩ | ⟨rfl, hc, -, rfl⟩ | ⟨e, rest, -, -, rfl⟩ |
      ⟨ci, e, rest, -, -, -, rfl⟩
  · exfalso
    have : S.sd.col = S.rd.col := by
      show (⟨S.sd.col.path, S.sd.col.col⟩ : ColAddr) = ⟨S.rd.col.path, S.rd.col.col⟩
      rw [hpath, hc, List.append_nil]
    rw [this] at ht
    omega
  · show 1 ≤ S.sd.col.col - S.rd.col.col
    omega
  · simp at hp
  · simp at hp

-- G9 (helper): the first step of a placement under the kernel hole
theorem underCol_kerHole_head (S : OrdStep) {kh : ColAddr}
    (hkh : kerCol S.sd S.rd S.sd.col = some kh) (z : ColAddr) {j : Nat}
    (hj : (underCol kh z).path.head? = some (0, j)) : S.m ≤ j := by
  have hsdq : isQMat S.sd S.sd.col = false := isQMat_of_short S.sd le_rfl
  obtain ⟨zp, zc⟩ := z
  cases hkp : kh.path with
  | nil =>
    have hpos := kerHole_col_pos S hkh hkp
    cases zp with
    | nil => simp [underCol, hkp] at hj
    | cons p rest =>
      obtain ⟨c0, e0⟩ := p
      simp only [underCol, hkp, List.nil_append, List.head?_cons, Option.some.injEq,
        Prod.mk.injEq] at hj
      omega
  | cons p rest =>
    have hhead : kh.path.head? = some (0, j) := by
      cases zp with
      | nil => simpa [underCol] using hj
      | cons q rest' =>
        obtain ⟨c0, e0⟩ := q
        simpa [underCol, hkp] using hj
    exact kerCol_head_zero S hkh hsdq hhead

-- G9 (helper): the cap column and the heads as iterated placements under the kernel hole
theorem phaseCol_eq_iterate (S : OrdStep) {kh : ColAddr} (hkh : kerCol S.sd S.rd S.sd.col = some kh)
    {i : Nat} {a a' : ColAddr} (ha' : kerCol S.sd S.rd a = some a') :
    phaseCol S.sd S.rd i a = some (underCol S.sd.col ((underCol kh)^[i - 1] a')) := by
  have hkerHole : kerHole S.sd S.rd = kh := by simp [kerHole, hkh]
  unfold phaseCol
  rw [ha', hkerHole]
  rfl

theorem headCol_eq (S : OrdStep) {kh : ColAddr} (hkh : kerCol S.sd S.rd S.sd.col = some kh)
    (h : Nat) : S.headCol h = underCol S.sd.col ((underCol kh)^[h - 1] ⟨[], 0⟩) := by
  unfold OrdStep.headCol
  rw [phaseCol_eq_iterate S hkh (kerCol_rdcol S)]
  rfl

-- G9 (helper): the template map at the root level
theorem kerCol_nil_eq (S : OrdStep) {o : ColAddr} (hoq : isQMat S.sd o = false)
    (hp : o.path = S.rd.col.path) :
    kerCol S.sd S.rd o = if o.col = S.rd.col.col then some ⟨[], 0⟩
      else if S.rd.col.col < o.col ∧ S.rd.owner = false then some ⟨[], o.col - S.rd.col.col⟩
      else none := by
  obtain ⟨-, -, hidx, -⟩ := rootData_spec S.hsd S.hrd
  unfold kerCol
  simp only [hoq, hp, List.take_length, List.drop_length, Bool.false_eq_true, if_false, if_true, hidx]

-- G9 (helper): the template map through a root-level step
theorem kerCol_cons_eq (S : OrdStep) {o : ColAddr} (hoq : isQMat S.sd o = false) {ci e : Nat}
    {rest : List (Nat × Nat)} (hp : o.path = S.rd.col.path ++ (ci, e) :: rest) :
    kerCol S.sd S.rd o = if ci = S.rd.col.col ∧ S.rd.cursor ≤ e then
        some ⟨(0, S.m + (e - S.rd.cursor)) :: rest, o.col⟩
      else if S.rd.col.col < ci ∧ S.rd.owner = false then some ⟨(ci - S.rd.col.col, e) :: rest, o.col⟩
      else none := by
  obtain ⟨-, -, hidx, -⟩ := rootData_spec S.hsd S.hrd
  unfold kerCol
  simp only [hoq, hp, List.take_left, List.drop_left, Bool.false_eq_true, if_false, if_true, hidx]
  rfl

-- G9 (helper): numbers of root-tail columns
theorem num_tail (S : OrdStep) {o : ColAddr} {s : List (Nat × Nat)} (hp : o.path = S.rd.col.path ++ s) :
    o.num 0 + S.rd.col.col = S.sd.r + (s.map (·.1 + 1)).sum + o.col := by
  obtain ⟨-, -, -, hrnum, -⟩ := rootData_spec S.hsd S.hrd
  rw [← hrnum]
  simp only [ColAddr.num, hp, List.map_append, List.sum_append]
  omega

-- G9.4s4, forward direction
theorem onStack_kerCol_tail_mp (S : OrdStep) {x x' : ColAddr} (hx : kerCol S.sd S.rd x = some x')
    (hxq : isQMat S.sd x = false) (o' : ColAddr) (h : x'.OnStack o') :
    ∃ o, x.OnStack o ∧ S.sd.r ≤ o.num 0 ∧ isQMat S.sd o = false ∧ kerCol S.sd S.rd o = some o' := by
  obtain ⟨-, -, -, hpre, -⟩ := rootData_path S.hsd S.hrd
  have hRq : ∀ {o : ColAddr}, o.path = S.rd.col.path → isQMat S.sd o = false := fun {o} hp =>
    isQMat_of_short S.sd (by rw [hp]; exact hpre.length_le)
  have hpq : ∀ {o : ColAddr}, o.path <+: x.path → isQMat S.sd o = false := fun {o} hp => by
    cases hq : isQMat S.sd o
    · rfl
    · have := isQMat_of_prefix S.sd hq hp; rw [hxq] at this; cases this
  obtain ⟨sx, hxp, hxc⟩ := kerCol_tail_spec S hx hxq
  obtain ⟨op, oc⟩ := o'
  -- the root column itself
  have hroot : ∀ (hne : x ≠ S.rd.col), ∃ o, x.OnStack o ∧ S.sd.r ≤ o.num 0 ∧
      isQMat S.sd o = false ∧ kerCol S.sd S.rd o = some ⟨[], 0⟩ :=
    fun hne => ⟨S.rd.col, onStack_rdcol S hx hxq hne,
      by rw [(rootData_spec S.hsd S.hrd).2.2.2.1], isQMat_rdcol S, kerCol_rdcol S⟩
  -- a root-level column `⟨R, idx + j⟩`
  have hlevel : ∀ j, (j = 0 ∨ S.rd.owner = false) → x.OnStack ⟨S.rd.col.path, S.rd.col.col + j⟩ →
      ∃ o, x.OnStack o ∧ S.sd.r ≤ o.num 0 ∧ isQMat S.sd o = false ∧
        kerCol S.sd S.rd o = some ⟨[], j⟩ := by
    intro j hj hst
    refine ⟨⟨S.rd.col.path, S.rd.col.col + j⟩, hst, ?_, hRq rfl, ?_⟩
    · have := num_tail S (o := ⟨S.rd.col.path, S.rd.col.col + j⟩) (s := []) (by simp)
      simp at this; omega
    · rw [kerCol_nil_eq S (o := ⟨S.rd.col.path, S.rd.col.col + j⟩) (hRq rfl) rfl]
      by_cases hj0 : j = 0
      · subst hj0; simp
      · have hown : S.rd.owner = false := hj.resolve_left hj0
        simp only [show ¬ (S.rd.col.col + j = S.rd.col.col) by omega, if_false, hown, and_true]
        rw [if_pos (by omega)]
        simp
  rcases hxc with ⟨rfl, hxc, rfl⟩ | ⟨rfl, hxc, hown, rfl⟩ | ⟨e, rest, rfl, he, rfl⟩ |
      ⟨ci, e, rest, rfl, hci, hown, rfl⟩
  · -- `x` is the root: its image `⟨[],0⟩` has an empty stack
    rcases h with ⟨l, _, _, hl, -, -⟩ | ⟨-, hlt⟩
    · simp at hl
    · simp at hlt
  · rcases h with ⟨l, _, _, hl, -, -⟩ | ⟨hp, hlt⟩
    · simp at hl
    · simp only at hp hlt
      subst hp
      have := hlevel oc (Or.inr hown) (Or.inr ⟨by rw [hxp, List.append_nil], by simp only; omega⟩)
      exact this
  · have hne : x ≠ S.rd.col := by
      intro h; rw [h] at hxp; have := congrArg List.length hxp; simp at this
    rcases h with ⟨l, ck, ik, hl, hp, hle⟩ | ⟨hp, hlt⟩
    · simp only at hp hle
      cases l with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hl
        simp only [List.take_zero] at hp
        subst hp
        rw [show oc = 0 by omega]
        exact hroot hne
      | succ l =>
        simp only [List.getElem?_cons_succ] at hl
        simp only [List.take_succ_cons] at hp
        subst hp
        have hp' : (⟨S.rd.col.path ++ (S.rd.col.col, e) :: rest.take l, oc⟩ : ColAddr).path <+:
            x.path := by
          rw [hxp]; exact List.prefix_append_right_inj _ |>.mpr (List.cons_prefix_cons.mpr ⟨rfl, List.take_prefix _ _⟩)
        refine ⟨⟨S.rd.col.path ++ (S.rd.col.col, e) :: rest.take l, oc⟩, ?_, ?_, hpq hp', ?_⟩
        · refine Or.inl ⟨S.rd.col.path.length + (l + 1), ck, ik, ?_, ?_, hle⟩
          · rw [hxp, List.getElem?_append_right (by omega), Nat.add_sub_cancel_left]
            simpa using hl
          · rw [hxp, List.take_length_add_append]; rfl
        · have := num_tail S (o := ⟨S.rd.col.path ++ (S.rd.col.col, e) :: rest.take l, oc⟩) rfl
          simp at this; omega
        · rw [kerCol_cons_eq S (hpq hp') rfl, if_pos ⟨rfl, he⟩]
    · simp only at hp hlt
      subst hp
      refine ⟨⟨x.path, oc⟩, Or.inr ⟨rfl, hlt⟩, ?_, hpq (List.prefix_refl _), ?_⟩
      · have := num_tail S (o := ⟨x.path, oc⟩) hxp
        simp at this; omega
      · rw [kerCol_cons_eq S (o := ⟨x.path, oc⟩) (hpq (List.prefix_refl _)) hxp,
          if_pos ⟨rfl, he⟩]
  · rcases h with ⟨l, ck, ik, hl, hp, hle⟩ | ⟨hp, hlt⟩
    · simp only at hp hle
      cases l with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hl
        simp only [List.take_zero] at hp
        subst hp
        refine hlevel oc (Or.inr hown) (Or.inl ⟨S.rd.col.path.length, ci, e, ?_, ?_, by simp only; omega⟩)
        · rw [hxp, List.getElem?_append_right le_rfl, Nat.sub_self]; rfl
        · rw [hxp, List.take_left]
      | succ l =>
        simp only [List.getElem?_cons_succ] at hl
        simp only [List.take_succ_cons] at hp
        subst hp
        have hp' : (⟨S.rd.col.path ++ (ci, e) :: rest.take l, oc⟩ : ColAddr).path <+: x.path := by
          rw [hxp]; exact List.prefix_append_right_inj _ |>.mpr (List.cons_prefix_cons.mpr ⟨rfl, List.take_prefix _ _⟩)
        refine ⟨⟨S.rd.col.path ++ (ci, e) :: rest.take l, oc⟩, ?_, ?_, hpq hp', ?_⟩
        · refine Or.inl ⟨S.rd.col.path.length + (l + 1), ck, ik, ?_, ?_, hle⟩
          · rw [hxp, List.getElem?_append_right (by omega), Nat.add_sub_cancel_left]
            simpa using hl
          · rw [hxp, List.take_length_add_append]; rfl
        · have := num_tail S (o := ⟨S.rd.col.path ++ (ci, e) :: rest.take l, oc⟩) rfl
          simp at this; omega
        · rw [kerCol_cons_eq S (hpq hp') rfl, if_neg (by omega), if_pos ⟨hci, hown⟩]
    · simp only at hp hlt
      subst hp
      refine ⟨⟨x.path, oc⟩, Or.inr ⟨rfl, hlt⟩, ?_, hpq (List.prefix_refl _), ?_⟩
      · have := num_tail S (o := ⟨x.path, oc⟩) hxp
        simp at this; omega
      · rw [kerCol_cons_eq S (o := ⟨x.path, oc⟩) (hpq (List.prefix_refl _)) hxp,
          if_neg (by omega), if_pos ⟨hci, hown⟩]

-- G9.4s4, backward direction
theorem onStack_kerCol_tail_mpr (S : OrdStep) {x x' : ColAddr} (hx : kerCol S.sd S.rd x = some x')
    (hxq : isQMat S.sd x = false) {o o' : ColAddr} (hst : x.OnStack o) (_hr : S.sd.r ≤ o.num 0)
    (hoq : isQMat S.sd o = false) (ho : kerCol S.sd S.rd o = some o') : x'.OnStack o' := by
  obtain ⟨-, -, -, hrnum, -⟩ := rootData_spec S.hsd S.hrd
  obtain ⟨sx, hxp, hxc⟩ := kerCol_tail_spec S hx hxq
  obtain ⟨so, hop, hoc⟩ := kerCol_tail_spec S ho hoq
  -- the stack of `x` is `o`'s path as a prefix of `x`'s
  have hlen : o.path.length ≤ x.path.length := by
    rcases hst with ⟨k, -, -, -, hp, -⟩ | ⟨hp, -⟩
    · rw [hp, List.length_take]; omega
    · rw [hp]
  rcases hoc with ⟨rfl, hoc, rfl⟩ | ⟨rfl, hoc, hown, rfl⟩ | ⟨e₀, rest_o, rfl, he₀, rfl⟩ |
      ⟨ci₀, e₀, rest_o, rfl, hci₀, hown, rfl⟩
  · -- `o` is the root column, imaged to the head `⟨[], 0⟩`
    rw [List.append_nil] at hop
    rcases hxc with ⟨rfl, hxc, rfl⟩ | ⟨rfl, hxc, -, rfl⟩ | ⟨e, rest, rfl, -, rfl⟩ |
        ⟨ci, e, rest, rfl, hci, -, rfl⟩
    · exfalso
      have h1 := ColAddr.num_lt_of_onStack 0 hst
      have h2 := num_tail S (o := o) (s := []) (by simpa using hop)
      have h3 := num_tail S (o := x) (s := []) (by simpa using hxp)
      simp at h2 h3
      omega
    · exact Or.inr ⟨rfl, by simp only; omega⟩
    · exact Or.inl ⟨0, 0, S.m + (e - S.rd.cursor), rfl, rfl, by simp only; omega⟩
    · exact Or.inl ⟨0, ci - S.rd.col.col, e, rfl, rfl, by simp only; omega⟩
  · -- `o` a later root-level column
    rw [List.append_nil] at hop
    rcases hxc with ⟨rfl, hxc, rfl⟩ | ⟨rfl, hxc, -, rfl⟩ | ⟨e, rest, rfl, -, rfl⟩ |
        ⟨ci, e, rest, rfl, hci, -, rfl⟩
    · rw [List.append_nil] at hxp
      rcases hst with ⟨k, _, _, hk, hp, _⟩ | ⟨_, hlt⟩
      · exfalso
        have h1 := (List.getElem?_eq_some_iff.mp hk).1
        have := congrArg List.length hp
        rw [List.length_take, hop, hxp] at this
        rw [hxp] at h1
        omega
      · exfalso; omega
    · rw [List.append_nil] at hxp
      rcases hst with ⟨k, _, _, hk, hp, _⟩ | ⟨_, hlt⟩
      · exfalso
        have h1 := (List.getElem?_eq_some_iff.mp hk).1
        have := congrArg List.length hp
        rw [List.length_take, hop, hxp] at this
        rw [hxp] at h1
        omega
      · exact Or.inr ⟨rfl, by simp only; omega⟩
    · exfalso
      rcases hst with ⟨k, ck, ik, hk, hp, hle⟩ | ⟨hp, -⟩
      · have hk' : k = S.rd.col.path.length := by
          have := congrArg List.length hp
          rw [List.length_take, hop, hxp] at this
          simp at this; omega
        subst hk'
        rw [hxp, List.getElem?_append_right le_rfl, Nat.sub_self] at hk
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hk
        omega
      · rw [hop, hxp] at hp
        have := congrArg List.length hp
        simp at this
    · rcases hst with ⟨k, ck, ik, hk, hp, hle⟩ | ⟨hp, -⟩
      · have hk' : k = S.rd.col.path.length := by
          have := congrArg List.length hp
          rw [List.length_take, hop, hxp] at this
          simp at this; omega
        subst hk'
        rw [hxp, List.getElem?_append_right le_rfl, Nat.sub_self] at hk
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hk
        exact Or.inl ⟨0, ci - S.rd.col.col, e, rfl, rfl, by simp only; omega⟩
      · exfalso
        rw [hop, hxp] at hp
        have := congrArg List.length hp
        simp at this
  · -- `o` inside a restored height of the root: `x` passes through the same step
    rcases hxc with ⟨rfl, -, rfl⟩ | ⟨rfl, -, -, rfl⟩ | ⟨e, rest, rfl, -, rfl⟩ |
        ⟨ci, e, rest, rfl, hci, -, rfl⟩
    · exfalso; rw [hop, hxp] at hlen; simp at hlen
    · exfalso; rw [hop, hxp] at hlen; simp at hlen
    · rcases hst with ⟨k, ck, ik, hk, hp, hle⟩ | ⟨hp, hlt⟩
      · have hkl : k < x.path.length := (List.getElem?_eq_some_iff.mp hk).1
        have hk' : k = S.rd.col.path.length + (rest_o.length + 1) := by
          have := congrArg List.length hp
          rw [List.length_take, Nat.min_eq_left hkl.le, hop] at this
          simp at this; omega
        subst hk'
        rw [hop, hxp, List.take_length_add_append, List.take_succ_cons] at hp
        have hp' := List.append_cancel_left hp
        simp only [List.cons.injEq, Prod.mk.injEq, true_and] at hp'
        obtain ⟨rfl, hrest⟩ := hp'
        rw [hxp, List.getElem?_append_right (by omega), Nat.add_sub_cancel_left] at hk
        simp only [List.getElem?_cons_succ] at hk
        refine Or.inl ⟨rest_o.length + 1, ck, ik, ?_, ?_, hle⟩
        · simpa using hk
        · show (0, S.m + (e₀ - S.rd.cursor)) :: rest_o = _
          rw [List.take_succ_cons, ← hrest]
      · rw [hop, hxp] at hp
        have hp' := List.append_cancel_left hp
        simp only [List.cons.injEq, Prod.mk.injEq, true_and] at hp'
        obtain ⟨rfl, rfl⟩ := hp'
        exact Or.inr ⟨rfl, hlt⟩
    · exfalso
      rcases hst with ⟨k, ck, ik, hk, hp, hle⟩ | ⟨hp, hlt⟩
      · have hkl : k < x.path.length := (List.getElem?_eq_some_iff.mp hk).1
        have hk' : S.rd.col.path.length < k := by
          have := congrArg List.length hp
          rw [List.length_take, Nat.min_eq_left hkl.le, hop] at this
          simp at this; omega
        obtain ⟨j, rfl⟩ : ∃ j, k = S.rd.col.path.length + (j + 1) := ⟨k - S.rd.col.path.length - 1, by omega⟩
        rw [hop, hxp, List.take_length_add_append, List.take_succ_cons] at hp
        have hp' := List.append_cancel_left hp
        simp only [List.cons.injEq, Prod.mk.injEq] at hp'
        omega
      · rw [hop, hxp] at hp
        have hp' := List.append_cancel_left hp
        simp only [List.cons.injEq, Prod.mk.injEq] at hp'
        omega
  · -- `o` in a later body column of the root forest
    rcases hxc with ⟨rfl, -, rfl⟩ | ⟨rfl, -, -, rfl⟩ | ⟨e, rest, rfl, -, rfl⟩ |
        ⟨ci, e, rest, rfl, hci, -, rfl⟩
    · exfalso; rw [hop, hxp] at hlen; simp at hlen
    · exfalso; rw [hop, hxp] at hlen; simp at hlen
    · exfalso
      rcases hst with ⟨k, ck, ik, hk, hp, hle⟩ | ⟨hp, hlt⟩
      · have hkl : k < x.path.length := (List.getElem?_eq_some_iff.mp hk).1
        have hk' : S.rd.col.path.length < k := by
          have := congrArg List.length hp
          rw [List.length_take, Nat.min_eq_left hkl.le, hop] at this
          simp at this; omega
        obtain ⟨j, rfl⟩ : ∃ j, k = S.rd.col.path.length + (j + 1) := ⟨k - S.rd.col.path.length - 1, by omega⟩
        rw [hop, hxp, List.take_length_add_append, List.take_succ_cons] at hp
        have hp' := List.append_cancel_left hp
        simp only [List.cons.injEq, Prod.mk.injEq] at hp'
        omega
      · rw [hop, hxp] at hp
        have hp' := List.append_cancel_left hp
        simp only [List.cons.injEq, Prod.mk.injEq] at hp'
        omega
    · rcases hst with ⟨k, ck, ik, hk, hp, hle⟩ | ⟨hp, hlt⟩
      · have hkl : k < x.path.length := (List.getElem?_eq_some_iff.mp hk).1
        have hk' : k = S.rd.col.path.length + (rest_o.length + 1) := by
          have := congrArg List.length hp
          rw [List.length_take, Nat.min_eq_left hkl.le, hop] at this
          simp at this; omega
        subst hk'
        rw [hop, hxp, List.take_length_add_append, List.take_succ_cons] at hp
        have hp' := List.append_cancel_left hp
        simp only [List.cons.injEq, Prod.mk.injEq] at hp'
        obtain ⟨⟨rfl, rfl⟩, hrest⟩ := hp'
        rw [hxp, List.getElem?_append_right (by omega), Nat.add_sub_cancel_left] at hk
        simp only [List.getElem?_cons_succ] at hk
        refine Or.inl ⟨rest_o.length + 1, ck, ik, ?_, ?_, hle⟩
        · simpa using hk
        · show (ci₀ - S.rd.col.col, e₀) :: rest_o = _
          rw [List.take_succ_cons, ← hrest]
      · rw [hop, hxp] at hp
        have hp' := List.append_cancel_left hp
        simp only [List.cons.injEq, Prod.mk.injEq] at hp'
        obtain ⟨⟨rfl, rfl⟩, rfl⟩ := hp'
        exact Or.inr ⟨rfl, hlt⟩

-- G9.4s4 (moved here from before G9.4s4b: its proof uses `onStack_rdcol`): on root-tail material `kerCol` is a stack isomorphism onto the kernel output, with
-- `num (kerCol o) = num o − r`, and it carries containment
theorem onStack_kerCol_tail (S : OrdStep) {x x' : ColAddr} (hx : kerCol S.sd S.rd x = some x')
    (hxq : isQMat S.sd x = false) (o' : ColAddr) :
    x'.OnStack o' ↔ ∃ o, x.OnStack o ∧ S.sd.r ≤ o.num 0 ∧ isQMat S.sd o = false ∧
      kerCol S.sd S.rd o = some o' := by
  constructor
  · exact onStack_kerCol_tail_mp S hx hxq o'
  · rintro ⟨o, hst, hr, hoq, ho⟩
    exact onStack_kerCol_tail_mpr S hx hxq hst hr hoq ho

-- G9.4a: the heads `s_1, …, s_φ` are on the stack of `c`; a head containing `c` does so through
-- an entry of index `≥ m` (a restored entry)
theorem resolve_headCol (S : OrdStep) {i : Nat} {a c : ColAddr} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) {h : Nat} (hh : 1 ≤ h ∧ h ≤ phaseOff S.sd i a) :
    c.resolve 0 (S.s h) = some (S.headCol h) ∧
      ∀ e, (S.headCol h).container c = some e → S.m ≤ e.idx := by
  obtain ⟨hres, hrnum, -⟩ := rootData_path S.hsd S.hrd
  have hsdq : isQMat S.sd S.sd.col = false := isQMat_of_short S.sd le_rfl
  have hsd_rd : S.sd.col.OnStack S.rd.col := ((ColAddr.resolve_spec 0 _ _ _).mp hres).1
  obtain ⟨kh, hkh⟩ := kerCol_sdcol S
  obtain ⟨b₀, hb₀⟩ := Option.isSome_iff_exists.mp ha.2.2.2
  have hcdef : c = underCol S.sd.col ((underCol kh)^[i - 1] b₀) := by
    rw [phaseCol_eq_iterate S hkh hb₀] at hc
    exact (Option.some.inj hc).symm
  have hhead := headCol_eq S hkh h
  have hφ : phaseOff S.sd i a ≤ i := by unfold phaseOff; split_ifs <;> omega
  have hhi : h ≤ i := by omega
  have hsplit : (underCol kh)^[i - 1] b₀ = (underCol kh)^[h - 1] ((underCol kh)^[i - h] b₀) := by
    rw [← Function.iterate_add_apply]
    congr 1
    omega
  have hroot : ∀ {x x' : ColAddr}, kerCol S.sd S.rd x = some x' → isQMat S.sd x = false →
      x.OnStack S.rd.col → x'.OnStack ⟨[], 0⟩ := fun hx hxq hst =>
    (onStack_kerCol_tail S hx hxq _).mpr ⟨S.rd.col, hst, by rw [hrnum], isQMat_rdcol S, kerCol_rdcol S⟩
  -- `⟨[],0⟩` (the head of the layer) is on the stack of `Z = G^{i−h} b₀`, and `Z` enters it
  -- through an entry `≥ m`
  have hZ : ((underCol kh)^[i - h] b₀).OnStack ⟨[], 0⟩ ∧
      ∀ j, ((underCol kh)^[i - h] b₀).path.head? = some (0, j) → S.m ≤ j := by
    rcases Nat.eq_or_lt_of_le hhi with heq | hlt
    · rw [heq, Nat.sub_self, Function.iterate_zero_apply]
      have haq : isQMat S.sd a = false := by
        cases hqa : isQMat S.sd a
        · rfl
        · simp only [phaseOff, hqa, if_true] at hh
          omega
      exact ⟨hroot hb₀ haq (onStack_rdcol S hb₀ haq ha.2.2.1),
        fun j hj => kerCol_head_zero S hb₀ haq hj⟩
    · obtain ⟨j, hj⟩ : ∃ j, i - h = j + 1 := ⟨i - h - 1, by omega⟩
      rw [hj, Function.iterate_succ_apply']
      exact ⟨(onStack_underCol kh _ _).mpr (Or.inl (hroot hkh hsdq hsd_rd)),
        fun j' hj' => underCol_kerHole_head S hkh _ hj'⟩
  have hst : c.OnStack (S.headCol h) := by
    rw [hcdef, hhead, hsplit]
    exact (onStack_underCol _ _ _).mpr (Or.inr ⟨_, iterate_underCol_onStack kh (h - 1) hZ.1, rfl⟩)
  have hnum : (S.headCol h).num 0 = S.s h := by
    have hpc : phaseCol S.sd S.rd h S.rd.col = some (S.headCol h) := by
      rw [phaseCol_eq_iterate S hkh (kerCol_rdcol S), hhead]
    rw [num_phaseCol S.inL S.kind S.hsd S.hrd (Or.inl rfl) hh.1 hpc, hrnum]
    simp [phaseOff, isQMat_rdcol, OrdStep.s, OrdStep.d]
  refine ⟨(ColAddr.resolve_spec 0 _ _ _).mpr ⟨hst, hnum⟩, ?_⟩
  intro e he
  rw [hcdef, hhead, hsplit, container_underCol, iterate_underCol_container] at he
  cases hz : (⟨[], 0⟩ : ColAddr).container ((underCol kh)^[i - h] b₀) with
  | none => rw [hz] at he; cases he
  | some e' =>
    rw [hz] at he
    simp only [Option.map_some, Option.some.injEq] at he
    rw [← he]
    exact hZ.2 e'.idx (container_root_head hz)

-- G9 (helper): a container of the stopping column contains it through its last entry
theorem container_sdcol_last (S : OrdStep) {o : ColAddr} {e : EntryAddr}
    (h : o.container S.sd.col = some e) : e.idx + 1 = (parents S.A o).length := by
  obtain ⟨-, -, -, hroute, -⟩ := stopData_spec S.hsd
  obtain ⟨hpath, -⟩ := (Scan.mem_routeCols_iff _ _).mp hroute
  unfold ColAddr.container at h
  cases hd : S.sd.col.path.drop o.path.length with
  | nil => rw [hd] at h; cases h
  | cons p rest =>
    obtain ⟨k, j⟩ := p
    rw [hd] at h
    simp only at h
    split_ifs at h with hc
    cases h
    obtain ⟨htake, hk⟩ := hc
    have hlt : o.path.length < S.sd.col.path.length := by
      by_contra hcon
      rw [List.drop_eq_nil_of_le (by omega)] at hd
      cases hd
    obtain ⟨F, hF, hlast⟩ := hpath o.path.length hlt
    rw [htake] at hF
    have hget : S.sd.col.path[o.path.length]? = some (k, j) := by
      rw [← List.head?_drop, hd]; rfl
    rw [hget] at hlast
    unfold Tree.lastStep? at hlast
    cases hcl : F.cols.getLast? with
    | none => rw [hcl] at hlast; cases hlast
    | some col =>
      rw [hcl] at hlast
      simp only [Option.bind_some] at hlast
      split_ifs at hlast with hemp
      simp only [Option.some.injEq, Prod.mk.injEq] at hlast
      obtain ⟨h1, h2⟩ := hlast
      have hcol : S.A.colAt o = some col := by
        unfold Tree.colAt
        rw [hF]
        simp only [Option.bind_some]
        rw [← hk, ← h1, ← List.getLast?_eq_getElem?]
        exact hcl
      simp only [parents, hcol, Option.getD_some, List.length_map]
      have : col.length ≠ 0 := by simpa using hemp
      omega

-- G9 (helper): numbers of iterated placements
theorem num_iterate_underCol (g : ColAddr) (n : Nat) (z : ColAddr) :
    ((underCol g)^[n] z).num 0 = n * g.num 0 + z.num 0 := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Function.iterate_succ_apply', num_underCol, ih, Nat.succ_mul]
    omega

-- G9.4b: for `h < φ`, the phase-`h` copies of the stopping column's stack columns between `r` and
-- `t` are on the stack of `c` at numbers `x + h d`, and they contain `c` exactly when the old
-- columns contain the stopping column, through the same (last) entry
theorem resolve_copyCol (S : OrdStep) {i : Nat} {a c : ColAddr} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) {h : Nat} (hh : h < phaseOff S.sd i a)
    {x : Nat} {o : ColAddr} (hx : S.sd.r < x) (hxt : x < S.sd.t)
    (ho : S.sd.col.resolve 0 x = some o) :
    c.resolve 0 (x + h * S.d) = some (S.copyCol h o) ∧
      (S.copyCol h o).container c = (o.container S.sd.col).map (fun e => ⟨S.copyCol h o, e.idx⟩) ∧
      ∀ e, o.container S.sd.col = some e → e.idx + 1 = (parents S.A o).length := by
  obtain ⟨hst, hnum⟩ := (ColAddr.resolve_spec 0 _ _ _).mp ho
  obtain ⟨-, -, ht, -⟩ := stopData_spec S.hsd
  obtain ⟨-, -, -, hrnum, hrt, -⟩ := rootData_spec S.hsd S.hrd
  have hsdq : isQMat S.sd S.sd.col = false := isQMat_of_short S.sd le_rfl
  obtain ⟨kh, hkh⟩ := kerCol_sdcol S
  obtain ⟨b₀, hb₀⟩ := Option.isSome_iff_exists.mp ha.2.2.2
  have hcdef : c = underCol S.sd.col ((underCol kh)^[i - 1] b₀) := by
    rw [phaseCol_eq_iterate S hkh hb₀] at hc
    exact (Option.some.inj hc).symm
  obtain ⟨hoker, hoq⟩ := kerCol_of_onStack_tail S hkh hsdq hst (by omega)
  obtain ⟨o', ho'⟩ := Option.isSome_iff_exists.mp hoker
  have hne : o ≠ S.rd.col := by
    intro h; rw [h] at hnum; omega
  refine ⟨?_, ?_, fun e he => container_sdcol_last S he⟩
  · -- resolution
    rw [ColAddr.resolve_spec]
    rcases Nat.eq_zero_or_pos h with h0 | hpos
    · subst h0
      simp only [OrdStep.copyCol, if_true, Nat.zero_mul, Nat.add_zero]
      exact ⟨by rw [hcdef]; exact (onStack_underCol _ _ _).mpr (Or.inl hst), hnum⟩
    · have hcopy : S.copyCol h o = underCol S.sd.col ((underCol kh)^[h - 1] o') := by
        simp only [OrdStep.copyCol, if_neg (show h ≠ 0 by omega)]
        rw [phaseCol_eq_iterate S hkh ho']
        rfl
      have hφ : phaseOff S.sd i a ≤ i := by unfold phaseOff; split_ifs <;> omega
      have hsplit : (underCol kh)^[i - 1] b₀ =
          (underCol kh)^[h - 1] ((underCol kh)^[i - h] b₀) := by
        rw [← Function.iterate_add_apply]
        congr 1
        omega
      obtain ⟨j, hj⟩ : ∃ j, i - h = j + 1 := ⟨i - h - 1, by omega⟩
      have hkho' : kh.OnStack o' :=
        (onStack_kerCol_tail S hkh hsdq o').mpr ⟨o, hst, by omega, hoq, ho'⟩
      have hZ : ((underCol kh)^[i - h] b₀).OnStack o' := by
        rw [hj, Function.iterate_succ_apply']
        exact (onStack_underCol kh _ _).mpr (Or.inl hkho')
      rw [hcopy]
      refine ⟨?_, ?_⟩
      · rw [hcdef, hsplit]
        exact (onStack_underCol _ _ _).mpr
          (Or.inr ⟨_, iterate_underCol_onStack kh (h - 1) hZ, rfl⟩)
      · have h1 := num_kerCol_tail S hkh hsdq
        have h2 := num_kerCol_tail S ho' hoq
        rw [num_underCol, num_iterate_underCol]
        simp only [OrdStep.d, period]
        rw [← ht] at h1
        have : (h - 1) * kh.num 0 + kh.num 0 = h * kh.num 0 := by
          rw [← Nat.succ_mul]; congr 1; omega
        have hd : kh.num 0 = S.sd.t - S.sd.r := by omega
        rw [← hd]
        omega
  · -- containment
    rcases Nat.eq_zero_or_pos h with h0 | hpos
    · subst h0
      simp only [OrdStep.copyCol, if_true]
      rw [hcdef, container_underCol_of_onStack hst]
      cases hce : o.container S.sd.col with
      | none => rfl
      | some e =>
        simp only [Option.map_some, Option.some.injEq]
        rw [← container_col hce]
    · have hcopy : S.copyCol h o = underCol S.sd.col ((underCol kh)^[h - 1] o') := by
        simp only [OrdStep.copyCol, if_neg (show h ≠ 0 by omega)]
        rw [phaseCol_eq_iterate S hkh ho']
        rfl
      have hφ : phaseOff S.sd i a ≤ i := by unfold phaseOff; split_ifs <;> omega
      have hsplit : (underCol kh)^[i - 1] b₀ =
          (underCol kh)^[h - 1] ((underCol kh)^[i - h] b₀) := by
        rw [← Function.iterate_add_apply]
        congr 1
        omega
      obtain ⟨j, hj⟩ : ∃ j, i - h = j + 1 := ⟨i - h - 1, by omega⟩
      have hkho' : kh.OnStack o' :=
        (onStack_kerCol_tail S hkh hsdq o').mpr ⟨o, hst, by omega, hoq, ho'⟩
      rw [hcopy, hcdef, hsplit, container_underCol, iterate_underCol_container, hj,
        Function.iterate_succ_apply', container_underCol_of_onStack hkho',
        container_kerCol S hkh ho' hsdq]
      simp only [if_neg hne, Option.map_map]
      rfl

-- G9 (helper): the stack columns of the stopping column are columns of `A`
theorem mem_colAddrs_of_sdstack (S : OrdStep) {o : ColAddr} (ho : S.sd.col.OnStack o) :
    o ∈ S.A.colAddrs := by
  obtain ⟨-, -, hmem, -⟩ := rootData_col S.hsd S.hrd
  have := (Tree.stack_mem_prefix hmem).2.1 o ho
  have hr : Role.ord o ∈ S.A.roles := (List.takeWhile_sublist _).subset this
  rw [Tree.mem_colAddrs_iff]
  exact (Tree.mem_roles_iff _ _).mp hr

-- G9 (helper): the stack columns of the stopping column strictly between `r` and `t` are
-- non-Q template columns
theorem tmplCol_of_sdstack (S : OrdStep) {x : Nat} {o : ColAddr} (hx : S.sd.r < x)
    (hxt : x < S.sd.t) (ho : S.sd.col.resolve 0 x = some o) :
    IsTmplCol S.A S.sd S.rd o ∧ isQMat S.sd o = false := by
  obtain ⟨hst, hnum⟩ := (ColAddr.resolve_spec 0 _ _ _).mp ho
  obtain ⟨-, -, ht, -⟩ := stopData_spec S.hsd
  obtain ⟨-, -, -, hrnum, -⟩ := rootData_spec S.hsd S.hrd
  obtain ⟨kh, hkh⟩ := kerCol_sdcol S
  obtain ⟨hker, hoq⟩ := kerCol_of_onStack_tail S hkh (isQMat_of_short S.sd le_rfl) hst (by omega)
  refine ⟨⟨mem_colAddrs_of_sdstack S hst, ?_, ?_, hker⟩, hoq⟩
  · intro h; rw [h] at hnum; omega
  · intro h; rw [h] at hnum; omega

-- G9 (helper): a copy's column in `B` is the shifted column of a context of `A`
theorem colAt_copyCol (S : OrdStep) {h : Nat} (hh : h ≤ S.n) {o : ColAddr}
    (ho : IsTmplCol S.A S.sd S.rd o) (hoq : isQMat S.sd o = false) :
    ∃ Z, S.B.colAt (S.copyCol h o) =
      ((context S.A S.sd Z).colAt o).map (Tree.mapCol (shiftVal S.sd.r (h * S.d))) := by
  have hE : S.A ≠ Tree.empty := by
    intro h
    have := S.hsd
    rw [h, stopData_eq_none_of_lastCol (Or.inl rfl)] at this
    cases this
  have hit := expand_eq_iterate hE S.inL.1 S.inL.2.1 S.kind S.hsd S.hrd S.kernelDefined
  rcases Nat.eq_zero_or_pos h with h0 | hpos
  · subst h0
    refine ⟨(kernel S.A S.sd S.rd)^[S.n] Tree.empty, ?_⟩
    have hB : S.B = context S.A S.sd ((kernel S.A S.sd S.rd)^[S.n] Tree.empty) := by
      have := hit S.n
      rw [S.out] at this
      exact Option.some.inj this
    simp only [OrdStep.copyCol, if_true, Nat.zero_mul]
    rw [← hB]
    cases S.B.colAt o with
    | none => rfl
    | some col =>
      simp only [Option.map_some, mapCol_eq_map]
      congr 1
      conv_lhs => rw [← List.map_id col]
      congr 1
      funext x
      have h1 : shiftVal S.sd.r 0 x.1 = x.1 := by simp [shiftVal]
      have h2 : Tree.map (shiftVal S.sd.r 0) x.2 = x.2 := shift_zero S.sd.r x.2
      rw [h1, h2]
      rfl
  · refine ⟨(kernel S.A S.sd S.rd)^[S.n - h] Tree.empty, ?_⟩
    have hA' := hit (S.n - h)
    simp only [OrdStep.copyCol, if_neg (show h ≠ 0 by omega)]
    rw [colAt_phaseCol_tail S ⟨hpos, hh⟩ ho hoq hA']

-- G9.4c: contents in `K` of a copy: parents shifted by `τ_h`, keys `κ_h`-related before the
-- active index `u` (all keys when the copy does not contain `c`)
theorem copyCol_litCap (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ) {h : Nat}
    (hh : h < phaseOff S.sd i a) {x : Nat} {o : ColAddr} (hx : S.sd.r < x) (hxt : x < S.sd.t)
    (ho : S.sd.col.resolve 0 x = some o) :
    parents (litCap S.B c k ρ) (S.copyCol h o) = (parents S.A o).map (shiftVal S.sd.r (h * S.d)) ∧
      (actualKeys (litCap S.B c k ρ) (S.copyCol h o)).take
          (((o.container S.sd.col).map (·.idx)).getD (parents S.A o).length) =
        kappaQ S.sd.r S.d h ((actualKeys S.A o).take
          (((o.container S.sd.col).map (·.idx)).getD (parents S.A o).length)) := by
  obtain ⟨hres, hcont, hlast⟩ := resolve_copyCol S hi ha hq hc hh hx hxt ho
  obtain ⟨hst, hnum⟩ := (ColAddr.resolve_spec 0 _ _ _).mp ho
  obtain ⟨hcst, hcnum⟩ := (ColAddr.resolve_spec 0 _ _ _).mp hres
  obtain ⟨hot, hoq⟩ := tmplCol_of_sdstack S hx hxt ho
  have hφ : phaseOff S.sd i a ≤ i := by unfold phaseOff; split_ifs <;> omega
  obtain ⟨Z, hBcol⟩ := colAt_copyCol S (show h ≤ S.n by omega) hot hoq
  obtain ⟨hcpar, hctake, hcnone⟩ := colAt_context_onStack S.hsd Z hst
  have hcmem : c ∈ S.B.colAddrs := by
    rw [Tree.mem_colAddrs_iff]
    unfold IsUpward at hup
    cases hB : S.B.colAt c with
    | none => rw [hB] at hup; exact hup.elim
    | some _ => rfl
  obtain ⟨hK1, hK2⟩ := colAt_litCap_onStack (k := k) (p := ρ) hcmem hcst
  -- `B` in terms of the context column `C`
  set C := ((context S.A S.sd Z).colAt o).getD [] with hC
  have hBget : (S.B.colAt (S.copyCol h o)).getD [] = Tree.mapCol (shiftVal S.sd.r (h * S.d)) C := by
    rw [hBcol, hC]
    cases (context S.A S.sd Z).colAt o <;> simp [Tree.mapCol]
  have hBpar : parents S.B (S.copyCol h o) = (parents S.A o).map (shiftVal S.sd.r (h * S.d)) := by
    rw [← hcpar]
    simp only [parents, hBget, mapCol_eq_map, List.map_map, ← hC]
    rfl
  have hBkeys : actualKeys S.B (S.copyCol h o) =
      kappaQ S.sd.r S.d h (actualKeys (context S.A S.sd Z) o) := by
    simp only [actualKeys, hBget, mapCol_eq_map, List.map_map, kappaQ, ← hC]
    congr 1
    funext y
    simp only [Function.comp_apply, WithTop.map_coe]
    rw [hcnum, ← hnum]
    exact congrArg _ (relKey_shift S.sd.r S.d h (o.num 0) (by omega) y.2)
  cases hce : o.container S.sd.col with
  | none =>
    rw [hce] at hcont
    simp only [Option.map_none] at hcont
    have hK := hK2 hcont
    have hctx := hcnone hce
    simp only [Option.map_none, Option.getD_none]
    refine ⟨?_, ?_⟩
    · simp only [parents, hK]; exact hBpar
    · have : actualKeys (litCap S.B c k ρ) (S.copyCol h o) = actualKeys S.B (S.copyCol h o) := by
        simp only [actualKeys, hK]
      rw [this, hBkeys]
      unfold kappaQ
      rw [List.map_take]
      simp only [actualKeys, hctx]
  | some e =>
    rw [hce] at hcont
    simp only [Option.map_some] at hcont
    obtain ⟨hKp, hKk⟩ := hK1 _ hcont
    have hl := hlast e hce
    simp only [Option.map_some, Option.getD_some]
    refine ⟨?_, ?_⟩
    · rw [hKp, hBpar]
      apply List.take_of_length_le
      simp only [List.length_map]
      omega
    · rw [hKk, hBkeys]
      unfold kappaQ
      rw [← List.map_take]
      congr 1
      have := hctake e hce
      simp only [actualKeys, ← List.map_take]
      congr 1
      cases h1 : (context S.A S.sd Z).colAt o with
      | none =>
        rw [h1] at this
        cases h2 : S.A.colAt o with
        | none => rfl
        | some _ => rw [h2] at this; cases this
      | some C1 =>
        rw [h1] at this
        cases h2 : S.A.colAt o with
        | none => rw [h2] at this; cases this
        | some C2 =>
          rw [h2] at this
          simpa using this

-- G9 (helper): the column of an upward cap exists
theorem mem_colAddrs_of_upward {B : Forest} {c : ColAddr} {k p : Nat} (hup : IsUpward B c k p) :
    c ∈ B.colAddrs := by
  rw [Tree.mem_colAddrs_iff]
  unfold IsUpward at hup
  cases hB : B.colAt c with
  | none => rw [hB] at hup; exact hup.elim
  | some _ => rfl

-- G9 (helper): the head of layer `h` is the phase-`h` copy of the root column
theorem phaseCol_headCol (S : OrdStep) (h : Nat) :
    phaseCol S.sd S.rd h S.rd.col = some (S.headCol h) := by
  obtain ⟨kh, hkh⟩ := kerCol_sdcol S
  rw [phaseCol_eq_iterate S hkh (kerCol_rdcol S), headCol_eq S hkh]

-- G9 (helper): the unconsumed root entries have parents below `r`
theorem unconsumed_parent_lt (S : OrdStep) {v : Nat} {x : Nat × Forest}
    (hx : (unconsumed S.A S.rd)[v]? = some x) : x.1 < S.sd.r := by
  obtain ⟨-, hrnum, -⟩ := rootData_path S.hsd S.hrd
  unfold unconsumed rootCol at hx
  rw [List.getElem?_drop] at hx
  have hent : S.A.entryAt ⟨S.rd.col, S.rd.cursor + v⟩ = some x := by
    unfold Tree.entryAt
    cases hR : S.A.colAt S.rd.col with
    | none => rw [hR] at hx; simp at hx
    | some R => rw [hR] at hx; exact hx
  have hmem : (⟨S.rd.col, S.rd.cursor + v⟩ : EntryAddr) ∈ S.A.entryAddrs := by
    rw [Tree.mem_entryAddrs_iff, hent]; rfl
  have := (condV_iff_lt S.A).mp S.inL.1 _ hmem x.1 x.2 hent
  rw [hrnum] at this
  exact this

-- G9.4d: contents in `K` of the head `s_h` (`1 ≤ h ≤ φ`): the query part `τ_{h−1}(Q)` with keys
-- `κ_{h−1}(y)`, then restored entries with parents `< r`
theorem headCol_litCap (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ) {h : Nat}
    (hh : 1 ≤ h ∧ h ≤ phaseOff S.sd i a) :
    (parents (litCap S.B c k ρ) (S.headCol h)).take S.m =
        ((parents S.A S.sd.col).take S.m).map (shiftVal S.sd.r ((h - 1) * S.d)) ∧
      (∀ v p, S.m ≤ v → (parents (litCap S.B c k ρ) (S.headCol h))[v]? = some p → p < S.sd.r) ∧
      (actualKeys (litCap S.B c k ρ) (S.headCol h)).take S.m =
        kappaQ S.sd.r S.d (h - 1) ((actualKeys S.A S.sd.col).take S.m) ∧
      S.m ≤ (actualKeys (litCap S.B c k ρ) (S.headCol h)).length := by
  obtain ⟨hres, hidx⟩ := resolve_headCol S hi ha hq hc hh
  obtain ⟨hcst, hHnum⟩ := (ColAddr.resolve_spec 0 _ _ _).mp hres
  obtain ⟨hcol, -, ht, -⟩ := stopData_spec S.hsd
  obtain ⟨-, -, -, hrnum, hrt, -⟩ := rootData_spec S.hsd S.hrd
  have hφ : phaseOff S.sd i a ≤ i := by unfold phaseOff; split_ifs <;> omega
  obtain ⟨col, hBcol, hlen, htake, hrest⟩ :=
    colAt_head S.inL S.kind S.hsd S.hrd S.out ⟨hh.1, by omega⟩ (phaseCol_headCol S h)
  obtain ⟨hK1, hK2⟩ := colAt_litCap_onStack (k := k) (p := ρ) (mem_colAddrs_of_upward hup) hcst
  have hm : S.sd.Q.length = S.m := rfl
  -- facts about `B`'s head column
  have hBpar : parents S.B (S.headCol h) = col.map Prod.fst := by simp [parents, hBcol]
  have hBpar_take : (parents S.B (S.headCol h)).take S.m =
      ((parents S.A S.sd.col).take S.m).map (shiftVal S.sd.r ((h - 1) * S.d)) := by
    rw [hBpar, ← List.map_take, ← hm, htake, mapCol_eq_map]
    simp only [parents, hcol, Option.getD_some, List.map_append, List.map_map]
    rw [List.take_left' (by simp), List.map_map]
    rfl
  have hBkeys_take : (actualKeys S.B (S.headCol h)).take S.m =
      kappaQ S.sd.r S.d (h - 1) ((actualKeys S.A S.sd.col).take S.m) := by
    simp only [actualKeys, hBcol, hcol, Option.getD_some, ← List.map_take, ← hm, htake,
      mapCol_eq_map, List.map_map, kappaQ]
    rw [List.take_left' (by simp)]
    congr 1
    funext y
    simp only [Function.comp_apply, WithTop.map_coe]
    rw [hHnum, ← ht]
    have : S.s h = S.sd.t + (h - 1) * S.d := by
      simp only [OrdStep.s, OrdStep.d, period]
      have : h * (S.sd.t - S.sd.r) = (h - 1) * (S.sd.t - S.sd.r) + (S.sd.t - S.sd.r) := by
        rw [← Nat.succ_mul]; congr 1; omega
      omega
    rw [this]
    exact congrArg _ (relKey_shift S.sd.r S.d (h - 1) S.sd.t hrt.le y.2)
  have hBbig : ∀ v p, S.m ≤ v → (parents S.B (S.headCol h))[v]? = some p → p < S.sd.r := by
    intro v p hv hp
    rw [hBpar, List.getElem?_map] at hp
    obtain ⟨v', rfl⟩ : ∃ v', v = S.m + v' := ⟨v - S.m, by omega⟩
    have hlt : v' < (unconsumed S.A S.rd).length := by
      have : S.m + v' < col.length := by
        by_contra hcon
        rw [List.getElem?_eq_none (by omega)] at hp
        cases hp
      omega
    obtain ⟨y, hy, hy1, -⟩ := hrest v' _ (List.getElem?_eq_getElem hlt)
    rw [← hm, hy] at hp
    simp only [Option.map_some, Option.some.injEq] at hp
    rw [← hp, hy1]
    exact unconsumed_parent_lt S (List.getElem?_eq_getElem hlt)
  have hBlen : S.m ≤ (parents S.B (S.headCol h)).length := by
    rw [hBpar, List.length_map, hlen]; omega
  have hlenK : ∀ E, (actualKeys E (S.headCol h)).length = (parents E (S.headCol h)).length := by
    intro E; rw [length_actualKeys]; simp [parents]
  cases hce : (S.headCol h).container c with
  | none =>
    have hK := hK2 hce
    have hp : parents (litCap S.B c k ρ) (S.headCol h) = parents S.B (S.headCol h) := by
      simp only [parents, hK]
    have hk : actualKeys (litCap S.B c k ρ) (S.headCol h) = actualKeys S.B (S.headCol h) := by
      simp only [actualKeys, hK]
    rw [hp, hk, hlenK]
    exact ⟨hBpar_take, hBbig, hBkeys_take, hBlen⟩
  | some e =>
    obtain ⟨hKp, hKk⟩ := hK1 e hce
    have he := hidx e hce
    refine ⟨?_, ?_, ?_, ?_⟩
    · rw [hKp, List.take_take, Nat.min_eq_left (by omega)]
      exact hBpar_take
    · intro v p hv hp
      rw [hKp, List.getElem?_take] at hp
      split_ifs at hp
      · exact hBbig v p hv hp
    · have := congrArg (List.take S.m) hKk
      rw [List.take_take, List.take_take, Nat.min_eq_left he] at this
      rw [this]
      exact hBkeys_take
    · rw [hlenK, hKp, List.length_take]
      omega

-- G9 (helper): splitting an address path at a step
theorem path_split {π : List (Nat × Nat)} {k ck ik : Nat} (hk : π[k]? = some (ck, ik)) :
    π = π.take k ++ (ck, ik) :: π.drop (k + 1) := by
  have hkl : k < π.length := (List.getElem?_eq_some_iff.mp hk).1
  have hget : π[k] = (ck, ik) := by
    rw [List.getElem?_eq_getElem hkl] at hk
    exact Option.some.inj hk
  conv_lhs => rw [← List.take_append_drop k π, List.drop_eq_getElem_cons hkl, hget]

-- G9 (helper): a step into an existing forest has an existing column
theorem forestAt_cons_some {G F : Forest} {ck ik : Nat} {rest : List (Nat × Nat)}
    (h : G.forestAt ((ck, ik) :: rest) = some F) : ck < G.cols.length := by
  simp only [Tree.forestAt] at h
  cases hc : G.cols[ck]? with
  | none => rw [hc] at h; simp at h
  | some _ => exact (List.getElem?_eq_some_iff.mp hc).1

-- G9 (helper): the stack columns of a column of `E` are columns of `E`
theorem mem_colAddrs_of_onStack {E : Forest} {c o : ColAddr} (hc : c ∈ E.colAddrs)
    (ho : c.OnStack o) : o ∈ E.colAddrs := by
  rw [Tree.mem_colAddrs_iff] at hc ⊢
  unfold Tree.colAt at hc ⊢
  cases hF : E.forestAt c.path with
  | none => rw [hF] at hc; cases hc
  | some F =>
    rw [hF] at hc
    simp only [Option.bind_some] at hc
    rcases ho with ⟨k, ck, ik, hk, hp, hle⟩ | ⟨hp, hlt⟩
    · have hsplit := path_split hk
      rw [hsplit, Tree.forestAt_append] at hF
      cases hG : E.forestAt (c.path.take k) with
      | none => rw [hG] at hF; cases hF
      | some G =>
        rw [hG] at hF
        simp only [Option.bind_some] at hF
        have hck := forestAt_cons_some hF
        rw [hp, hG]
        simp only [Option.bind_some]
        rw [List.getElem?_eq_getElem (by omega)]
        rfl
    · rw [hp, hF]
      simp only [Option.bind_some]
      have : c.col < F.cols.length := by
        cases h : F.cols[c.col]? with
        | none => rw [h] at hc; cases hc
        | some _ => exact (List.getElem?_eq_some_iff.mp h).1
      rw [List.getElem?_eq_getElem (by omega)]
      rfl

-- G9 (helper): the stopping column is on the stack of no non-Q column of `A`
theorem not_onStack_sdcol (S : OrdStep) {a : ColAddr} (ha : a ∈ S.A.colAddrs)
    (haq : isQMat S.sd a = false) : ¬ a.OnStack S.sd.col := by
  intro hst
  obtain ⟨hcol, -, -, hroute, -⟩ := stopData_spec S.hsd
  obtain ⟨-, F, hF, hFlen⟩ := (Scan.mem_routeCols_iff _ _).mp hroute
  have hcolF : F.cols[S.sd.col.col]? = some (S.sd.Q ++ [(S.sd.r, Tree.empty)]) := by
    unfold Tree.colAt at hcol
    rw [hF] at hcol
    simpa using hcol
  rw [Tree.mem_colAddrs_iff] at ha
  unfold Tree.colAt at ha
  rcases hst with ⟨k, ck, ik, hk, hp, hle⟩ | ⟨hp, hlt⟩
  · have hsplit := path_split hk
    have hkl : k < a.path.length := (List.getElem?_eq_some_iff.mp hk).1
    rw [← hp] at hsplit
    rw [hsplit, Tree.forestAt_append, hF] at ha
    simp only [Option.bind_some] at ha
    cases hG : F.forestAt ((ck, ik) :: a.path.drop (k + 1)) with
    | none => rw [hG] at ha; cases ha
    | some G =>
      rw [hG] at ha
      simp only [Option.bind_some] at ha
      have hck := forestAt_cons_some hG
      have hck' : ck = S.sd.col.col := by omega
      subst hck'
      simp only [Tree.forestAt, hcolF, Option.bind_some] at hG
      rcases Nat.lt_trichotomy ik S.sd.Q.length with hik | hik | hik
      · -- inside a query height: `a` would be Q-material
        apply Bool.false_ne_true
        rw [← haq]
        unfold isQMat
        rw [hsplit, List.take_left, List.drop_left]
        simp [hik]
      · -- inside the empty height of `(r, ∅)`
        subst hik
        rw [List.getElem?_append_right le_rfl, Nat.sub_self] at hG
        simp only [List.getElem?_cons_zero] at hG
        cases hrest : a.path.drop (k + 1) with
        | nil =>
          rw [hrest] at hG
          simp only [Tree.forestAt, Option.some.injEq] at hG
          subst hG
          simp [Tree.empty, Tree.cols] at ha
        | cons q rest =>
          obtain ⟨c', e'⟩ := q
          rw [hrest] at hG
          simp [Tree.forestAt, Tree.empty, Tree.cols] at hG
      · rw [List.getElem?_eq_none (by simp; omega)] at hG
        simp at hG
  · rw [← hp, hF] at ha
    simp only [Option.bind_some] at ha
    have : a.col < F.cols.length := by
      cases h : F.cols[a.col]? with
      | none => rw [h] at ha; cases ha
      | some _ => exact (List.getElem?_eq_some_iff.mp h).1
    omega

-- G9 (helper): the stack of an iterated placement
theorem iterate_underCol_onStack_cases (g : ColAddr) (n : Nat) (z w : ColAddr)
    (h : ((underCol g)^[n] z).OnStack w) :
    (∃ j < n, ∃ w₂, g.OnStack w₂ ∧ w = (underCol g)^[j] w₂) ∨
      (∃ w₂, z.OnStack w₂ ∧ w = (underCol g)^[n] w₂) := by
  induction n generalizing w with
  | zero => exact Or.inr ⟨w, h, rfl⟩
  | succ n ih =>
    rw [Function.iterate_succ_apply'] at h
    rcases (onStack_underCol g _ _).mp h with h1 | ⟨w', hw', rfl⟩
    · exact Or.inl ⟨0, by omega, w, h1, rfl⟩
    · rcases ih w' hw' with ⟨j, hj, w₂, hw₂, rfl⟩ | ⟨w₂, hw₂, rfl⟩
      · exact Or.inl ⟨j + 1, by omega, w₂, hw₂, by rw [Function.iterate_succ_apply']⟩
      · exact Or.inr ⟨w₂, hw₂, by rw [Function.iterate_succ_apply']⟩

-- G9 (helper): a literal cap keeps a prefix of the parents of every stack column
theorem parents_litCap_subset {B : Forest} {c o : ColAddr} {k p : Nat} (hc : c ∈ B.colAddrs)
    (ho : c.OnStack o) {q : Nat} (hq : q ∈ parents (litCap B c k p) o) : q ∈ parents B o := by
  obtain ⟨h1, h2⟩ := colAt_litCap_onStack (k := k) (p := p) hc ho
  cases hce : o.container c with
  | none =>
    have := h2 hce
    simp only [parents, this] at hq ⊢
    exact hq
  | some e =>
    rw [(h1 e hce).1] at hq
    exact List.mem_of_mem_take hq

-- G9 (helper): shifted parents are `< r` or `≥ r + δ`
theorem shiftVal_dich (r δ p : Nat) : shiftVal r δ p < r ∨ r + δ ≤ shiftVal r δ p := by
  unfold shiftVal
  split_ifs <;> omega

-- G9 (helper): every parent of a mapped column is an image
theorem parents_of_mapCol {E : Forest} {o : ColAddr} {f : Nat → Nat} {C : Option Column}
    (h : E.colAt o = C.map (Tree.mapCol f)) : ∀ p ∈ parents E o, ∃ p₀, p = f p₀ := by
  intro p hp
  simp only [parents, h] at hp
  cases C with
  | none => simp at hp
  | some col =>
    simp only [Option.map_some, Option.getD_some, mapCol_eq_map, List.map_map, List.mem_map] at hp
    obtain ⟨x, -, rfl⟩ := hp
    exact ⟨x.1, rfl⟩

-- G9.4e: every column on the stack of `c` above `s_φ` has parents `< r` or `≥ s_φ` in `K`
-- (generalizes T3.8ln from `c` to its stack)
theorem stack_parent_dichotomy (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat}
    (hi : 1 ≤ i ∧ i ≤ S.n) (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ) {x : Nat} {o : ColAddr}
    (hx : S.s (phaseOff S.sd i a) < x) (ho : c.resolve 0 x = some o) :
    ∀ p ∈ parents (litCap S.B c k ρ) o, p < S.sd.r ∨ S.s (phaseOff S.sd i a) ≤ p := by
  obtain ⟨hst, hnum⟩ := (ColAddr.resolve_spec 0 _ _ _).mp ho
  obtain ⟨-, -, ht, -⟩ := stopData_spec S.hsd
  obtain ⟨-, -, -, hrnum, hrt, -⟩ := rootData_spec S.hsd S.hrd
  have hsdq : isQMat S.sd S.sd.col = false := isQMat_of_short S.sd le_rfl
  obtain ⟨kh, hkh⟩ := kerCol_sdcol S
  obtain ⟨b₀, hb₀⟩ := Option.isSome_iff_exists.mp ha.2.2.2
  have hcdef : c = underCol S.sd.col ((underCol kh)^[i - 1] b₀) := by
    rw [phaseCol_eq_iterate S hkh hb₀] at hc
    exact (Option.some.inj hc).symm
  have hφ1 : 1 ≤ phaseOff S.sd i a := by
    unfold phaseOff
    split_ifs with hqa
    · have := hq hqa; omega
    · omega
  have hφi : phaseOff S.sd i a ≤ i := by unfold phaseOff; split_ifs <;> omega
  have hφi' : i - 1 ≤ phaseOff S.sd i a := by unfold phaseOff; split_ifs <;> omega
  have hd : kh.num 0 = S.d := by
    have := num_kerCol_tail S hkh hsdq
    simp only [OrdStep.d, period]
    omega
  have htd : S.sd.t = S.sd.r + S.d := by simp only [OrdStep.d, period]; omega
  have hsφ : S.s (phaseOff S.sd i a) = S.sd.r + phaseOff S.sd i a * S.d := rfl
  intro p hp
  have hpB := parents_litCap_subset (mem_colAddrs_of_upward hup) hst hp
  have hshift : ∀ C : Option Column,
      S.B.colAt o = C.map (Tree.mapCol (shiftVal S.sd.r (phaseOff S.sd i a * S.d))) →
      p < S.sd.r ∨ S.s (phaseOff S.sd i a) ≤ p := by
    intro C hC
    obtain ⟨p₀, rfl⟩ := parents_of_mapCol hC p hpB
    exact shiftVal_dich _ _ _
  rw [hcdef] at hst
  rcases (onStack_underCol _ _ _).mp hst with h1 | ⟨o₁, ho₁, rfl⟩
  · -- on the stopping column's stack: below `t = s_1 ≤ s_φ`
    exfalso
    have h2 := ColAddr.num_lt_of_onStack 0 h1
    have h3 : 1 * S.d ≤ phaseOff S.sd i a * S.d := Nat.mul_le_mul_right _ hφ1
    omega
  · rcases iterate_underCol_onStack_cases kh (i - 1) b₀ o₁ ho₁ with
      ⟨j, hj, w₂, hw₂, rfl⟩ | ⟨w₂, hw₂, rfl⟩
    · -- a phase-`(j+1)` copy of a column of the stopping column's stack
      obtain ⟨o₀, ho₀, hr₀, hq₀, hk₀⟩ := (onStack_kerCol_tail S hkh hsdq w₂).mp hw₂
      have hn₀ := ColAddr.num_lt_of_onStack 0 ho₀
      have hnw := num_kerCol_tail S hk₀ hq₀
      have hxeq : x = S.sd.t + j * S.d + w₂.num 0 := by
        rw [← hnum, num_underCol, num_iterate_underCol, hd, ← ht]
        omega
      have hjφ : j + 1 = phaseOff S.sd i a := by
        have hlt : phaseOff S.sd i a * S.d < (j + 2) * S.d := by
          rw [Nat.add_mul]; omega
        have := Nat.lt_of_mul_lt_mul_right hlt
        omega
      have hr₀' : S.sd.r < o₀.num 0 := by
        rcases Nat.eq_or_lt_of_le hr₀ with h | h
        · exfalso
          have h5 : phaseOff S.sd i a * S.d = j * S.d + S.d := by
            rw [← hjφ, Nat.succ_mul]
          omega
        · exact h
      obtain ⟨hot, hoq⟩ := tmplCol_of_sdstack S hr₀' (by omega)
        ((ColAddr.resolve_spec 0 _ _ _).mpr ⟨ho₀, rfl⟩)
      obtain ⟨Z, hZ⟩ := colAt_copyCol S (h := phaseOff S.sd i a) (by omega) hot hoq
      have hcopy : S.copyCol (phaseOff S.sd i a) o₀ = underCol S.sd.col ((underCol kh)^[j] w₂) := by
        simp only [OrdStep.copyCol, if_neg (show phaseOff S.sd i a ≠ 0 by omega)]
        rw [phaseCol_eq_iterate S hkh hk₀, Option.getD_some, show phaseOff S.sd i a - 1 = j by omega]
      rw [hcopy] at hZ
      exact hshift _ hZ
    · by_cases haq : isQMat S.sd a = true
      · -- Q-material: the head of layer `i`, or a Q-material copy (phase `i − 1 = φ`)
        have hφeq : phaseOff S.sd i a = i - 1 := by simp [phaseOff, haq]
        rcases (onStack_kerCol_qmat S hb₀ haq w₂).mp hw₂ with rfl | ⟨o₀, ho₀, hq₀, hk₀⟩
        · obtain ⟨col, hBcol, hlen, htake, hrest⟩ :=
            colAt_head S.inL S.kind S.hsd S.hrd S.out hi (phaseCol_headCol S i)
          rw [← headCol_eq S hkh] at hpB
          simp only [parents, hBcol, Option.getD_some, List.mem_map] at hpB
          obtain ⟨y, hy, rfl⟩ := hpB
          obtain ⟨v, hv⟩ := List.mem_iff_getElem?.mp hy
          by_cases hvm : v < S.sd.Q.length
          · have h1 : (col.take S.sd.Q.length)[v]? = some y := by
              rw [List.getElem?_take_of_lt hvm]; exact hv
            rw [htake, mapCol_eq_map, List.getElem?_map] at h1
            cases hQv : S.sd.Q[v]? with
            | none => rw [hQv] at h1; cases h1
            | some q =>
              rw [hQv] at h1
              simp only [Option.map_some, Option.some.injEq] at h1
              rw [← h1, hsφ, hφeq]
              exact shiftVal_dich _ _ _
          · left
            obtain ⟨v', rfl⟩ : ∃ v', v = S.sd.Q.length + v' := ⟨v - S.sd.Q.length, by omega⟩
            have hvl : v' < (unconsumed S.A S.rd).length := by
              have : S.sd.Q.length + v' < col.length := (List.getElem?_eq_some_iff.mp hv).1
              omega
            obtain ⟨y', hy', hy1, -⟩ := hrest v' _ (List.getElem?_eq_getElem hvl)
            rw [hv, Option.some.injEq] at hy'
            rw [hy', hy1]
            exact unconsumed_parent_lt S (List.getElem?_eq_getElem hvl)
        · have hot : IsTmplCol S.A S.sd S.rd o₀ := by
            refine ⟨mem_colAddrs_of_onStack ha.1 ho₀, ?_, ?_, by rw [hk₀]; rfl⟩
            · intro h; rw [h, hsdq] at hq₀; cases hq₀
            · intro h; rw [h, isQMat_rdcol] at hq₀; cases hq₀
          have hroute : ¬ OnHoleRoute S.sd o₀ := fun h => by
            have := isQMat_of_short S.sd h.length_le
            rw [hq₀] at this
            cases this
          have := colAt_phaseCol S.inL S.kind S.hsd S.hrd S.out hi hot hroute
            (phaseCol_eq_iterate S hkh (i := i) hk₀)
          rw [show phaseOff S.sd i o₀ = phaseOff S.sd i a by simp [phaseOff, hq₀, haq]] at this
          exact hshift _ this
      · -- root-tail material: a phase-`i` copy
        have haq' : isQMat S.sd a = false := by simpa using haq
        obtain ⟨o₀, ho₀, hr₀, hq₀, hk₀⟩ := (onStack_kerCol_tail S hb₀ haq' w₂).mp hw₂
        have hφeq : phaseOff S.sd i a = i := by simp [phaseOff, haq']
        have hne_rd : o₀ ≠ S.rd.col := by
          intro h
          rw [h, kerCol_rdcol, Option.some.injEq] at hk₀
          subst hk₀
          have hxeq : x = S.sd.t + (i - 1) * S.d := by
            rw [← hnum, num_underCol, num_iterate_underCol, hd, ← ht]
            simp [ColAddr.num]
          have h5 : i * S.d = (i - 1) * S.d + S.d := by
            rw [← Nat.succ_mul]; congr 1; omega
          rw [hsφ, hφeq] at hx
          omega
        have hne_sd : o₀ ≠ S.sd.col := fun h => not_onStack_sdcol S ha.1 haq' (h ▸ ho₀)
        have hot : IsTmplCol S.A S.sd S.rd o₀ :=
          ⟨mem_colAddrs_of_onStack ha.1 ho₀, hne_sd, hne_rd, by rw [hk₀]; rfl⟩
        obtain ⟨Z, hZ⟩ := colAt_copyCol S (h := i) hi.2 hot hq₀
        have hcopy : S.copyCol i o₀ = underCol S.sd.col ((underCol kh)^[i - 1] w₂) := by
          simp only [OrdStep.copyCol, if_neg (show i ≠ 0 by omega)]
          rw [phaseCol_eq_iterate S hkh hk₀, Option.getD_some]
        rw [hcopy] at hZ
        have hZ' : S.B.colAt (underCol S.sd.col ((underCol kh)^[i - 1] w₂)) =
            ((context S.A S.sd Z).colAt o₀).map
              (Tree.mapCol (shiftVal S.sd.r (phaseOff S.sd i a * S.d))) := by
          rw [hφeq]; exact hZ
        exact hshift _ hZ'

/-! ## G9.5 — the invariant: low heads detour along copies of the old terminal-to-root path -/

-- G9.5a (txt:391-393, 553-560): at a head `s_h`, `1 ≤ h ≤ φ`, whose query `V = κ_{h−1}(W')` is low
-- (`W' < Z`): (i) the response of `s_h` is `τ_{h−1}(q_j)`, `j = cursor y W'`; (ii) every edge
-- `x → y` of the old `g_{W'}` orbit at a column `x ∈ (r, t)` of the stopping column's stack is
-- copied to the edge `x + (h−1)d → τ_{h−1}(y)` of `K`, provided `K`'s cut path reaches
-- `x + (h−1)d` (the cut barrier of `K` then protects a copy that contains `c`)
theorem detour_copy (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) {h : Nat} (hh : 1 ≤ h ∧ h ≤ phaseOff S.sd i a)
    {W' : List (WithTop Key)} (hW' : Noninc W') (hV : S.capQ c k ρ = kappaQ S.sd.r S.d (h - 1) W')
    (hlow : W' < S.termZ) :
    (∃ q, (parents S.A S.sd.col)[cursor (actualKeys S.A S.sd.col) W']? = some q ∧
      Edge (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c (S.capQ c k ρ) (S.s h)
        (q + (h - 1) * S.d)) ∧
    ∀ x y, S.sd.r < x → x < S.sd.t → Edge S.A (actualKeys S.A) S.sd.col W' x y →
      Path (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c (S.capQ c k ρ)
        (cutStart (litCap S.B c k ρ) c k) (x + (h - 1) * S.d) →
      Edge (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c (S.capQ c k ρ) (x + (h - 1) * S.d)
        (shiftVal S.sd.r ((h - 1) * S.d) y) := by
  obtain ⟨hjm, q, hqget, hrq, -, -⟩ := term_detour S hW' hlow
  have hh' : h - 1 < phaseOff S.sd i a := by omega
  have hst := kappaQry_strictMono S.sd.r S.d (h - 1)
  have hVn : Noninc (S.capQ c k ρ) := cutQuery_noninc _ _
  refine ⟨⟨q, hqget, ?_⟩, ?_⟩
  · -- (i) the head edge
    obtain ⟨hres, -⟩ := resolve_headCol S hi ha hq hc hh
    obtain ⟨hpar, -, hkeys, -⟩ := headCol_litCap S hi ha hq hc hup hh
    refine ⟨S.headCol h, hres, ?_⟩
    have hcur : cursor (actualKeys (litCap S.B c k ρ) (S.headCol h)) (S.capQ c k ρ) =
        cursor (actualKeys S.A S.sd.col) W' := by
      have e1 := cursor_take (actualKeys (litCap S.B c k ρ) (S.headCol h)) (S.capQ c k ρ) S.m
      rw [hkeys, hV] at e1
      unfold kappaQ at e1
      rw [cursor_map hst, cursor_take] at e1
      rw [hV]
      unfold kappaQ
      omega
    rw [resp_eq_parents, hcur, ← List.getElem?_take_of_lt hjm, hpar, List.getElem?_map,
      List.getElem?_take_of_lt hjm, hqget]
    simp [shiftVal, hrq]
  · -- (ii) the copy step
    intro x y hx hxt hxy hreach
    obtain ⟨o, ho, hresp⟩ := hxy
    obtain ⟨hres, hcont, hlast⟩ := resolve_copyCol S hi ha hq hc hh' hx hxt ho
    obtain ⟨hparK, hkeysK⟩ := copyCol_litCap S hi ha hq hc hup hh' hx hxt ho
    refine ⟨S.copyCol (h - 1) o, hres, ?_⟩
    rw [resp_eq_parents] at hresp ⊢
    have hjxlt : cursor (actualKeys S.A o) W' < (parents S.A o).length := by
      by_contra hcon
      rw [List.getElem?_eq_none (by omega)] at hresp
      cases hresp
    have hlenK : (actualKeys (litCap S.B c k ρ) (S.copyCol (h - 1) o)).length =
        (parents S.A o).length := by
      rw [length_actualKeys, ← List.length_map (f := Prod.fst)]
      show (parents _ _).length = _
      rw [hparK, List.length_map]
    have hjxu : cursor (actualKeys S.A o) W' ≤
        ((o.container S.sd.col).map (·.idx)).getD (parents S.A o).length := by
      cases hce : o.container S.sd.col with
      | none => simp only [Option.map_none, Option.getD_none]; omega
      | some e =>
        have := hlast e hce
        simp only [Option.map_some, Option.getD_some]
        omega
    have hcurK : cursor (actualKeys (litCap S.B c k ρ) (S.copyCol (h - 1) o)) (S.capQ c k ρ) ≤
        ((o.container S.sd.col).map (·.idx)).getD (parents S.A o).length := by
      cases hce : o.container S.sd.col with
      | none =>
        simp only [Option.map_none, Option.getD_none]
        rw [← hlenK]
        exact cursor_le_length _ _
      | some e =>
        simp only [Option.map_some, Option.getD_some]
        rw [hce] at hcont
        simp only [Option.map_some] at hcont
        obtain ⟨hcmem, hplen⟩ := litCap_parents_self hup
        have hbar := cut_barrier_read hKL hcmem (by omega) hreach hres hcont
        have hlt := hlast e hce
        exact cursor_le_of_lt_cutQuery hVn (by omega) hbar
    have hcurA : cursor (kappaQ S.sd.r S.d (h - 1) (actualKeys S.A o)) (S.capQ c k ρ) =
        cursor (actualKeys S.A o) W' := by
      rw [hV]
      exact cursor_map hst _ _
    have heq : cursor (actualKeys (litCap S.B c k ρ) (S.copyCol (h - 1) o)) (S.capQ c k ρ) =
        cursor (actualKeys S.A o) W' := by
      rw [← hcurA]
      refine cursor_eq_of_take_eq ?_ hcurK (hcurA ▸ hjxu)
      rw [hkeysK]
      unfold kappaQ
      rw [List.map_take]
    rw [heq, hparK, List.getElem?_map, hresp]
    rfl

-- G9.5 (the invariant, `low_head_detour`): if `K`'s cut path reaches a low head `s_h`,
-- `1 ≤ h ≤ φ`, it continues to `s_{h−1}` (`s_0 = r`) along the `τ_{h−1}`-copy of the old
-- terminal-to-root path at `W'`
theorem low_head_detour (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) {h : Nat} (hh : 1 ≤ h ∧ h ≤ phaseOff S.sd i a)
    {W' : List (WithTop Key)} (hW' : Noninc W') (hV : S.capQ c k ρ = kappaQ S.sd.r S.d (h - 1) W')
    (hlow : W' < S.termZ)
    (hreach : Path (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c (S.capQ c k ρ)
      (cutStart (litCap S.B c k ρ) c k) (S.s h)) :
    Path (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c (S.capQ c k ρ) (S.s h)
      (S.s (h - 1)) := by
  have hVA : CondV S.A := S.inL.1
  obtain ⟨⟨q', hq', hedge⟩, hcopy⟩ := detour_copy S hi ha hq hc hup hKL hh hW' hV hlow
  obtain ⟨_, q, hqget, hrq, hqt, hqr⟩ := term_detour S hW' hlow
  rw [hqget, Option.some.injEq] at hq'
  rw [← hq'] at hedge
  -- every vertex `x ≥ r` of the old path from `q` is reached, shifted by `(h−1)d`, from `s_h`
  have key : ∀ x, Path S.A (actualKeys S.A) S.sd.col W' q x → S.sd.r ≤ x →
      Path (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c (S.capQ c k ρ) (S.s h)
        (x + (h - 1) * S.d) := by
    intro x hx
    induction hx with
    | refl => intro _; exact Relation.ReflTransGen.single hedge
    | @tail b y hqb hby ih =>
      intro hry
      have hyb : y < b := edge_lt hVA hby
      have hbq : b ≤ q := path_le hVA hqb
      have hb : Path (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c (S.capQ c k ρ) (S.s h)
          (b + (h - 1) * S.d) := ih (by omega)
      have he := hcopy b y (by omega) (by omega) hby (hreach.trans hb)
      have hsh : shiftVal S.sd.r ((h - 1) * S.d) y = y + (h - 1) * S.d := by
        simp [shiftVal, hry]
      rw [hsh] at he
      exact hb.tail he
  have := key S.sd.r hqr le_rfl
  simpa [OrdStep.s] using this

/-! ## G9.6, G9.7 — the cut query is `κ_φ W`; lowness is the same at every head -/

-- G9 (helper): no non-Q column of `A` lies inside a height of the stopping column
theorem not_inside_sdcol (S : OrdStep) {a : ColAddr} (ha : a ∈ S.A.colAddrs)
    (haq : isQMat S.sd a = false) {i : Nat} {rest : List (Nat × Nat)}
    (hp : a.path = S.sd.col.path ++ (S.sd.col.col, i) :: rest) : False := by
  obtain ⟨hcol, -, -, hroute, -⟩ := stopData_spec S.hsd
  obtain ⟨-, F, hF, -⟩ := (Scan.mem_routeCols_iff _ _).mp hroute
  have hcolF : F.cols[S.sd.col.col]? = some (S.sd.Q ++ [(S.sd.r, Tree.empty)]) := by
    unfold Tree.colAt at hcol
    rw [hF] at hcol
    simpa using hcol
  rcases Nat.lt_trichotomy i S.sd.Q.length with hik | hik | hik
  · apply Bool.false_ne_true
    rw [← haq]
    unfold isQMat
    rw [hp, List.take_left, List.drop_left]
    simp [hik]
  · rw [Tree.mem_colAddrs_iff] at ha
    unfold Tree.colAt at ha
    rw [hp, Tree.forestAt_append, hF] at ha
    simp only [Option.bind_some, Tree.forestAt, hcolF] at ha
    rw [hik, List.getElem?_append_right le_rfl, Nat.sub_self] at ha
    simp only [List.getElem?_cons_zero] at ha
    cases rest with
    | nil => simp [Tree.forestAt, Tree.empty, Tree.cols] at ha
    | cons q rest' =>
      obtain ⟨c', e'⟩ := q
      simp [Tree.forestAt, Tree.empty, Tree.cols] at ha
  · rw [Tree.mem_colAddrs_iff] at ha
    unfold Tree.colAt at ha
    rw [hp, Tree.forestAt_append, hF] at ha
    simp only [Option.bind_some, Tree.forestAt, hcolF] at ha
    rw [List.getElem?_eq_none (by simp; omega)] at ha
    simp at ha

-- G9 (helper): the stopping column contains no non-Q column of `A`
theorem sdcol_container_none (S : OrdStep) {a : ColAddr} (ha : a ∈ S.A.colAddrs)
    (haq : isQMat S.sd a = false) : S.sd.col.container a = none := by
  cases h : S.sd.col.container a with
  | none => rfl
  | some e =>
    exfalso
    unfold ColAddr.container at h
    cases hd : a.path.drop S.sd.col.path.length with
    | nil => rw [hd] at h; cases h
    | cons x rest =>
      obtain ⟨k', i'⟩ := x
      rw [hd] at h
      simp only at h
      split_ifs at h with hc
      obtain ⟨htake, hk⟩ := hc
      have hp : a.path = S.sd.col.path ++ (S.sd.col.col, i') :: rest := by
        rw [← List.take_append_drop S.sd.col.path.length a.path, htake, hd, hk]
      exact not_inside_sdcol S ha haq hp

-- G9 (helper): a container of a column is on its stack
theorem onStack_of_container {a b : ColAddr} {e : EntryAddr} (h : a.container b = some e) :
    b.OnStack a := by
  obtain ⟨he1, ⟨t, ht⟩⟩ := (ColAddr.container_spec a b e).mp h
  subst he1
  unfold EntryAddr.heightPath at ht
  refine Or.inl ⟨e.col.path.length, e.col.col, e.idx, ?_, ?_, le_rfl⟩
  · rw [← ht, List.append_assoc, List.getElem?_append_right le_rfl, Nat.sub_self]; rfl
  · rw [← ht, List.append_assoc, List.take_left]

/-! ### G9.6 (D7): the full cut of a route container is at the end of `w(B)` -/

-- L-G010.21d (D7, helper): replacing the height of the last entry of a column changes the
-- column's word length by the difference of the heights' word lengths
theorem length_wordCol_last_D7 (e : Nat) (L : Column) (q : Nat) (H H' : Forest) :
    (wordCol e (L ++ [(q, H')])).length + (wordAt (e + 1) H).length =
      (wordCol e (L ++ [(q, H)])).length + (wordAt (e + 1) H').length := by
  cases L with
  | nil => simp [wordCol, wordLater]; omega
  | cons x L =>
    obtain ⟨p, h⟩ := x
    simp [wordCol, wordLater_append, wordLater]
    omega

-- L-G010.21d (D7, helper): along a route path, a full cut of a nonempty last column adds exactly
-- one atom to the word
theorem length_wordAt_litCapAux_D7 (k p : Nat) :
    ∀ (π : List (Nat × Nat)) (j e : Nat) (F : Forest), Scan.IsRoutePath F π →
      (∃ G col, F.forestAt π = some G ∧ G.cols.length = j + 1 ∧ G.cols[j]? = some col ∧
        col ≠ [] ∧ k = col.length) →
      (wordAt e (litCapAux k p π j F)).length = (wordAt e F).length + 1
  | [], j, e, .node cols, _, ⟨G, col, hG, hlen, hcol, hne, hk⟩ => by
    simp only [Tree.forestAt, Option.some.injEq] at hG
    subst hG
    simp only [Tree.cols] at hlen hcol
    have hgd : cols.getD j [] = col := by simp [List.getD_eq_getElem?_getD, hcol]
    have hcols : cols = cols.take j ++ [col] := by
      conv_lhs => rw [← List.take_append_drop j cols]
      rw [List.drop_eq_getElem_cons (by omega), (List.getElem?_eq_some_iff.mp hcol).2,
        List.drop_eq_nil_of_le (by omega)]
    simp only [litCapAux, hgd, hk, List.take_length, wordAt]
    conv_rhs => rw [hcols]
    rw [wordCols_append, wordCols_append]
    simp only [wordCols, List.append_nil]
    rw [wordCol_append_of_ne_nil e hne]
    simp [wordLater, wordAt, Tree.empty, wordCols]
    omega
  | (ci, ei) :: rest, j, e, .node cols, hr, ⟨G, col, hG, hlen, hcol, hne, hk⟩ => by
    obtain ⟨hl, h, hh, hr'⟩ := Scan.isRoutePath_cons.mp hr
    obtain ⟨colc, q, h', hcl, hel, hs, hh'⟩ := Scan.lastStep?_eq_some hl
    rw [hh] at hh'
    cases hh'
    simp only [Prod.mk.injEq, Tree.cols] at hs
    obtain ⟨hcie, heie⟩ := hs
    simp only [Tree.cols] at hcl
    have hcne : cols ≠ [] := by intro h0; simp [h0] at hcl
    have hci : cols[ci]? = some colc := by
      rw [hcie, ← List.getLast?_eq_getElem?]; exact hcl
    have hgd : cols.getD ci [] = colc := by
      simp [List.getD_eq_getElem?_getD, hci]
    have hee : colc[ei]? = some (q, h) := by
      rw [heie, ← List.getLast?_eq_getElem?]; exact hel
    have hcne' : colc ≠ [] := by intro h0; simp [h0] at hel
    have hcols : cols = cols.take ci ++ [colc] := by
      conv_lhs => rw [← List.take_append_drop ci cols]
      rw [List.drop_eq_getElem_cons (by have := List.length_pos_of_ne_nil hcne; omega),
        (List.getElem?_eq_some_iff.mp hci).2, List.drop_eq_nil_of_le (by omega)]
    have hcolc : colc = colc.take ei ++ [(q, h)] := by
      conv_lhs => rw [← List.take_append_drop ei colc]
      rw [List.drop_eq_getElem_cons (by have := List.length_pos_of_ne_nil hcne'; omega),
        (List.getElem?_eq_some_iff.mp hee).2, List.drop_eq_nil_of_le (by omega)]
    have hGh : h.forestAt rest = some G := by
      rw [show (ci, ei) :: rest = [(ci, ei)] ++ rest from rfl, Tree.forestAt_append, hh] at hG
      exact hG
    have ih := length_wordAt_litCapAux_D7 k p rest j (e + 1) h hr' ⟨G, col, hGh, hlen, hcol, hne, hk⟩
    simp only [litCapAux, hgd, hee, wordAt]
    conv_rhs => rw [hcols]
    rw [wordCols_append, wordCols_append]
    simp only [wordCols, List.append_nil, List.length_append]
    have := length_wordCol_last_D7 e (colc.take ei) q h
      (litCapAux k p rest j h)
    rw [← hcolc] at this
    omega

-- L-G010.21d (D7; D3.1c, L3.1c): the full cut of a nonempty route column is at the end of the
-- word (an empty route column's marker atom is replaced instead)
theorem capPos_route_D7 {E : Forest} {c : ColAddr} (hc : c ∈ routeCols E)
    (hne : parents E c ≠ []) : capPos E c (parents E c).length = mu E := by
  obtain ⟨hr, G, hG, hGl⟩ := (Scan.mem_routeCols_iff E c).mp hc
  have hcm := Scan.mem_colAddrs_of_mem_routeCols hc
  obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.mp ((Tree.mem_colAddrs_iff _ _).mp hcm)
  have hGc : G.cols[c.col]? = some col := by
    unfold Tree.colAt at hcol; rw [hG] at hcol; exact hcol
  have hpar : parents E c = col.map Prod.fst := by simp [parents, hcol]
  have hcne : col ≠ [] := by intro h0; rw [hpar, h0] at hne; exact hne rfl
  have hlen := length_wordAt_litCapAux_D7 (parents E c).length 0 c.path c.col 0 E hr
    ⟨G, col, hG, hGl, hGc, hcne, by rw [hpar, List.length_map]⟩
  unfold capPos mu word
  have hK : litCap E c (parents E c).length 0 = litCapAux (parents E c).length 0 c.path c.col E := by
    show litCapBody E c _ 0 = _
    unfold litCapBody
    rw [if_pos (by rw [hcol]; rfl)]
  rw [hK, hlen]
  omega


/-! ### Route columns of placements (D7, for G9.6 `fullCut_container_end`) -/

-- D7 (route helper): a route column one step down
theorem mem_routeCols_cons_D7 {F h : Forest} {s : Nat × Nat} (hs : F.lastStep? = some s)
    (hh : F.forestAt [s] = some h) {b : ColAddr} (hb : b ∈ routeCols h) :
    (⟨s :: b.path, b.col⟩ : ColAddr) ∈ routeCols F := by
  obtain ⟨hr, G, hG, hGl⟩ := (Scan.mem_routeCols_iff h b).mp hb
  refine (Scan.mem_routeCols_iff F _).mpr ⟨Scan.isRoutePath_cons.mpr ⟨hs, h, hh, hr⟩, G, ?_, hGl⟩
  show F.forestAt (s :: b.path) = some G
  rw [show s :: b.path = [s] ++ b.path from rfl, Tree.forestAt_append, hh]
  exact hG

-- D7 (route helper): route columns survive prepending columns to the outer forest
theorem mem_routeCols_append_D7 (L : List Column) {Z : Forest} {b : ColAddr}
    (hb : b ∈ routeCols Z) : underCol ⟨[], L.length⟩ b ∈ routeCols (.node (L ++ Z.cols)) := by
  obtain ⟨hr, G, hG, hGl⟩ := (Scan.mem_routeCols_iff Z b).mp hb
  obtain ⟨bp, bc⟩ := b
  cases bp with
  | nil =>
    simp only [Tree.forestAt, Option.some.injEq] at hG
    subst hG
    simp only [underCol]
    refine (Scan.mem_routeCols_iff _ _).mpr ⟨fun d hd => absurd hd (by simp), _, rfl, ?_⟩
    simp only [Tree.cols, List.length_append] at hGl ⊢
    omega
  | cons s rest =>
    obtain ⟨c0, e0⟩ := s
    obtain ⟨hl, h, hh, hr'⟩ := Scan.isRoutePath_cons.mp hr
    obtain ⟨col, q, h', hcl, hel, hs, hh'⟩ := Scan.lastStep?_eq_some hl
    simp only [Prod.mk.injEq] at hs
    obtain ⟨hc0, he0⟩ := hs
    have hZne : Z.cols ≠ [] := by intro h0; simp [h0] at hcl
    have hc0' : Z.cols[c0]? = some col := by rw [hc0, ← List.getLast?_eq_getElem?]; exact hcl
    have hl' : (Tree.node (L ++ Z.cols)).lastStep? = some (L.length + c0, e0) := by
      have hcne : col ≠ [] := by intro h0; simp [h0] at hel
      have hgl : (L ++ Z.cols).getLast? = some col := by
        rw [List.getLast?_append_of_ne_nil _ hZne]; exact hcl
      unfold Tree.lastStep?
      rw [show (Tree.node (L ++ Z.cols)).cols = L ++ Z.cols from rfl, hgl]
      have := List.length_pos_of_ne_nil hZne
      simp only [Option.bind_some, List.isEmpty_iff, hcne, if_false, List.length_append,
        Option.some.injEq, Prod.mk.injEq]
      omega
    have hh2 : (Tree.node (L ++ Z.cols)).forestAt [(L.length + c0, e0)] = some h := by
      rw [show [(c0, e0)] = [(c0, e0)] from rfl, Tree.forestAt_cons] at hh
      rw [Tree.forestAt_cons]
      simp only [Tree.cols, List.getElem?_append_right (Nat.le_add_right _ _),
        Nat.add_sub_cancel_left]
      exact hh
    have hb' : (⟨rest, bc⟩ : ColAddr) ∈ routeCols h := by
      refine (Scan.mem_routeCols_iff h _).mpr ⟨hr', G, ?_, hGl⟩
      rw [show (c0, e0) :: rest = [(c0, e0)] ++ rest from rfl, Tree.forestAt_append, hh] at hG
      exact hG
    simpa [underCol] using mem_routeCols_cons_D7 hl' hh2 hb'

-- D7 (route helper): the last element of `mapLast`
theorem getLast?_mapLast_D7 {β γ : Type} (f g : β → γ) (l : List β) :
    (mapLast f g l).getLast? = l.getLast?.map g := by
  rw [mapLast_eq]
  cases h : l.getLast? with
  | none => simp [List.getLast?_eq_none_iff.mp h]
  | some x => simp [List.getLast?_append]

theorem length_mapLast_D7 {β γ : Type} (f g : β → γ) (l : List β) :
    (mapLast f g l).length = l.length := by
  rw [mapLast_eq]
  cases h : l.getLast? with
  | none => simp [List.getLast?_eq_none_iff.mp h]
  | some x =>
    have : l ≠ [] := by intro h0; simp [h0] at h
    have := List.length_pos_of_ne_nil this
    simp; omega

theorem getElem?_mapLast_last_D7 {β γ : Type} (f g : β → γ) (l : List β) :
    (mapLast f g l)[l.length - 1]? = l.getLast?.map g := by
  rw [← length_mapLast_D7 f g l, ← List.getLast?_eq_getElem?, getLast?_mapLast_D7]

-- D7 (route helper): one level of `replaceAt` keeps the last step and replaces the height below it
theorem replaceAt_succ_lastStep_D7 (r d : Nat) (Z : Forest) (k : Nat) {cols : List Column}
    {s : Nat × Nat} (hs : (Tree.node cols).lastStep? = some s) {h : Forest}
    (hh : (Tree.node cols).forestAt [s] = some h) :
    (replaceAt r d Z (k + 1) (.node cols)).lastStep? = some s ∧
      (replaceAt r d Z (k + 1) (.node cols)).forestAt [s] = some (replaceAt r d Z k h) ∧
      (replaceAt r d Z (k + 1) (.node cols)).cols.length = cols.length := by
  obtain ⟨col, q, h', hcl, hel, rfl, hh'⟩ := Scan.lastStep?_eq_some hs
  rw [hh] at hh'
  cases hh'
  simp only [Tree.cols] at hcl ⊢
  have hcne : col ≠ [] := by intro h0; simp [h0] at hel
  set f := fun (x : Nat × Forest) => (shiftVal r d x.1, Tree.map (shiftVal r d) x.2)
  set g := fun (x : Nat × Forest) => (shiftVal r d x.1, replaceAt r d Z k x.2)
  have hR : replaceAt r d Z (k + 1) (.node cols) =
      .node (mapLast (Tree.mapCol (shiftVal r d)) (mapLast f g) cols) := rfl
  rw [hR]
  have hgl : (mapLast (Tree.mapCol (shiftVal r d)) (mapLast f g) cols).getLast? =
      some (mapLast f g col) := by rw [getLast?_mapLast_D7, hcl]; rfl
  have hlc : (mapLast f g col).length = col.length := length_mapLast_D7 f g col
  refine ⟨?_, ?_, length_mapLast_D7 _ _ _⟩
  · have hne' : mapLast f g col ≠ [] := by
      intro h0; rw [← List.length_eq_zero_iff, hlc] at h0; exact hcne (List.length_eq_zero_iff.mp h0)
    simp only [Tree.lastStep?, Tree.cols, hgl, Option.bind_some, List.isEmpty_iff, hne', if_false,
      length_mapLast_D7, hlc]
  · rw [Tree.forestAt_cons]
    simp only [Tree.cols]
    rw [show cols.length - 1 = (cols).length - 1 from rfl, getElem?_mapLast_last_D7, hcl,
      Option.map_some, Option.bind_some, ← hlc, ← List.getLast?_eq_getElem?, getLast?_mapLast_D7,
      hel]
    rfl

-- D7 (route helper): a placement by `replaceAt` at the end of a route path puts the route
-- columns of the filling on the route
theorem routeCols_replaceAt_D7 (r d : Nat) (Z : Forest) :
    ∀ (π : List (Nat × Nat)) (F : Forest), Scan.IsRoutePath F π →
      ∀ H, F.forestAt π = some H → H.cols ≠ [] →
      ∀ b ∈ routeCols Z, underCol ⟨π, H.cols.length - 1⟩ b ∈ routeCols (replaceAt r d Z π.length F)
  | [], .node cols, _, H, hH, hne, b, hb => by
    simp only [Tree.forestAt, Option.some.injEq] at hH
    subst hH
    simp only [Tree.cols] at hne ⊢
    have hR : replaceAt r d Z 0 (.node cols) =
        .node (cols.dropLast.map (Tree.mapCol (shiftVal r d)) ++ Z.cols) := by
      cases cols with
      | nil => exact absurd rfl hne
      | cons x xs => rfl
    rw [List.length_nil, hR]
    have := mem_routeCols_append_D7 (cols.dropLast.map (Tree.mapCol (shiftVal r d))) hb
    simpa [List.length_dropLast] using this
  | (ci, ei) :: rest, .node cols, hr, H, hH, hne, b, hb => by
    obtain ⟨hl, h, hh, hr'⟩ := Scan.isRoutePath_cons.mp hr
    have hHh : h.forestAt rest = some H := by
      rw [show (ci, ei) :: rest = [(ci, ei)] ++ rest from rfl, Tree.forestAt_append, hh] at hH
      exact hH
    have ih := routeCols_replaceAt_D7 r d Z rest h hr' H hHh hne b hb
    obtain ⟨hl', hh', -⟩ := replaceAt_succ_lastStep_D7 r d Z rest.length hl hh
    have := mem_routeCols_cons_D7 hl' hh' ih
    rw [List.length_cons]
    obtain ⟨bp, bc⟩ := b
    cases bp with
    | nil => simpa [underCol] using this
    | cons x xs => simpa [underCol] using this

-- D7 (route helper): `replaceAt` keeps the route columns above the placement level
theorem routeCols_replaceAt_above_D7 (r d : Nat) (Z : Forest) :
    ∀ (π : List (Nat × Nat)) (F : Forest), Scan.IsRoutePath F π →
      ∀ L (hL : L < π.length),
        (⟨π.take L, (π[L]'hL).1⟩ : ColAddr) ∈ routeCols (replaceAt r d Z π.length F)
  | [], _, _, L, hL => absurd hL (by simp)
  | (ci, ei) :: rest, .node cols, hr, L, hL => by
    obtain ⟨hl, h, hh, hr'⟩ := Scan.isRoutePath_cons.mp hr
    obtain ⟨hl', hh', hlen⟩ := replaceAt_succ_lastStep_D7 r d Z rest.length hl hh
    rw [List.length_cons]
    cases L with
    | zero =>
      obtain ⟨col, q, h', hcl, -, hs, -⟩ := Scan.lastStep?_eq_some hl
      simp only [Prod.mk.injEq, Tree.cols] at hs
      have hcne : cols ≠ [] := by intro h0; simp [h0, Tree.cols] at hcl
      refine (Scan.mem_routeCols_iff _ _).mpr ⟨fun d hd => absurd hd (by simp), _, rfl, ?_⟩
      simp only [List.getElem_cons_zero]
      rw [hlen, hs.1]
      have := List.length_pos_of_ne_nil hcne
      omega
    | succ L =>
      have := mem_routeCols_cons_D7 hl' hh'
        (routeCols_replaceAt_above_D7 r d Z rest h hr' L (by simp at hL; omega))
      simpa using this

-- D7 (route helper): relabelling keeps the route
theorem mapCols_eq_map_D7 (f : Nat → Nat) (cols : List Column) :
    Tree.mapCols f cols = cols.map (Tree.mapCol f) := by
  induction cols with
  | nil => rfl
  | cons x xs ih => simp [Tree.mapCols, ih]

theorem forestAt_map_D7 (f : Nat → Nat) :
    ∀ (π : List (Nat × Nat)) (t : Forest), (Tree.map f t).forestAt π = (t.forestAt π).map (Tree.map f)
  | [], t => rfl
  | (c, i) :: rest, .node cols => by
    rw [Tree.forestAt_cons, Tree.forestAt_cons]
    simp only [Tree.map, Tree.cols]
    rw [mapCols_eq_map_D7]
    rw [List.getElem?_map]
    cases hc : cols[c]? with
    | none => rfl
    | some col =>
      simp only [Option.map_some, Option.bind_some, mapCol_eq_map, List.getElem?_map]
      cases he : col[i]? with
      | none => rfl
      | some x => simp [forestAt_map_D7 f rest x.2]

theorem lastStep?_map_D7 (f : Nat → Nat) (t : Forest) : (Tree.map f t).lastStep? = t.lastStep? := by
  obtain ⟨cols⟩ := t
  simp only [Tree.map, Tree.lastStep?, Tree.cols]
  rw [mapCols_eq_map_D7]
  rw [List.getLast?_map]
  cases cols.getLast? with
  | none => rfl
  | some col => simp [mapCol_eq_map]

theorem mem_routeCols_map_D7 (f : Nat → Nat) {t : Forest} {b : ColAddr} (hb : b ∈ routeCols t) :
    b ∈ routeCols (Tree.map f t) := by
  obtain ⟨hr, G, hG, hGl⟩ := (Scan.mem_routeCols_iff t b).mp hb
  refine (Scan.mem_routeCols_iff _ b).mpr ⟨fun d hd => ?_, Tree.map f G, ?_, ?_⟩
  · obtain ⟨F, hF, hFl⟩ := hr d hd
    exact ⟨Tree.map f F, by rw [forestAt_map_D7, hF]; rfl, by rw [lastStep?_map_D7, hFl]⟩
  · rw [forestAt_map_D7, hG]; rfl
  · obtain ⟨cols⟩ := G
    simp only [Tree.map, Tree.cols] at hGl ⊢
    rw [mapCols_eq_map_D7]
    simpa using hGl

-- D7 (address helper): placements compose
theorem underCol_assoc_D7 (h g b : ColAddr) :
    underCol (underCol h g) b = underCol h (underCol g b) := by
  obtain ⟨hp, hc⟩ := h
  obtain ⟨gp, gc⟩ := g
  obtain ⟨bp, bc⟩ := b
  cases gp with
  | nil =>
    cases bp with
    | nil => simp [underCol, Nat.add_assoc]
    | cons x xs => obtain ⟨c0, e0⟩ := x; simp [underCol, Nat.add_assoc]
  | cons y ys =>
    obtain ⟨g0, f0⟩ := y
    cases bp with
    | nil => simp [underCol]
    | cons x xs => obtain ⟨c0, e0⟩ := x; simp [underCol]


-- D7 (route helper): a suffix of a route path is a route path of the forest it starts from
theorem isRoutePath_append_D7 {E F : Forest} {π σ : List (Nat × Nat)}
    (hr : Scan.IsRoutePath E (π ++ σ)) (hF : E.forestAt π = some F) : Scan.IsRoutePath F σ := by
  intro d hd
  obtain ⟨G, hG, hl⟩ := hr (π.length + d) (by simp; omega)
  refine ⟨G, ?_, ?_⟩
  · rw [List.take_length_add_append, Tree.forestAt_append, hF] at hG
    exact hG
  · rw [hl, List.getElem?_append_right (Nat.le_add_right _ _), Nat.add_sub_cancel_left]

-- D7 (route helper): dropping columns before the last keeps the route, one column index lower
theorem isRoutePath_drop_D7 {cols : List Column} {ci e : Nat} {rest : List (Nat × Nat)}
    (hr : Scan.IsRoutePath (.node cols) ((ci, e) :: rest)) {k : Nat} (hk : k ≤ ci) :
    Scan.IsRoutePath (.node (cols.drop k)) ((ci - k, e) :: rest) ∧
      (Tree.node (cols.drop k)).forestAt [(ci - k, e)] = (Tree.node cols).forestAt [(ci, e)] := by
  obtain ⟨hl, h, hh, hr'⟩ := Scan.isRoutePath_cons.mp hr
  obtain ⟨col, q, h', hcl, hel, hs, hh'⟩ := Scan.lastStep?_eq_some hl
  simp only [Prod.mk.injEq, Tree.cols] at hs hcl
  obtain ⟨hci, he⟩ := hs
  have hcne : cols ≠ [] := by intro h0; simp [h0] at hcl
  have hlen := List.length_pos_of_ne_nil hcne
  have hfa : (Tree.node (cols.drop k)).forestAt [(ci - k, e)] =
      (Tree.node cols).forestAt [(ci, e)] := by
    rw [Tree.forestAt_cons, Tree.forestAt_cons]
    simp only [Tree.cols, List.getElem?_drop]
    rw [show k + (ci - k) = ci by omega]
  refine ⟨Scan.isRoutePath_cons.mpr ⟨?_, h, hfa.trans hh, hr'⟩, hfa⟩
  have hdl : (cols.drop k).getLast? = some col := by
    rw [List.getLast?_drop, if_neg (by omega), hcl]
  have hcne' : col ≠ [] := by intro h0; simp [h0] at hel
  unfold Tree.lastStep?
  rw [show (Tree.node (cols.drop k)).cols = cols.drop k from rfl, hdl]
  simp only [Option.bind_some, List.isEmpty_iff, hcne', if_false, List.length_drop,
    Option.some.injEq, Prod.mk.injEq]
  omega

-- D7 (route setup): the stopping column's path seen from the root forest
theorem route_setup_D7 (S : OrdStep) :
    ∃ F H, S.A.forestAt S.rd.col.path = some F ∧
      S.sd.col.path = S.rd.col.path ++ S.sd.col.path.drop S.rd.col.path.length ∧
      Scan.IsRoutePath F (S.sd.col.path.drop S.rd.col.path.length) ∧
      F.forestAt (S.sd.col.path.drop S.rd.col.path.length) = some H ∧
      H.cols.length = S.sd.col.col + 1 ∧ S.rd.col.col < F.cols.length ∧
      holeDepth S.sd S.rd = (S.sd.col.path.drop S.rd.col.path.length).length ∧
      Scan.IsRoutePath S.A S.sd.col.path ∧ S.A.forestAt S.sd.col.path = some H := by
  obtain ⟨-, hdepth, -, hroute, -⟩ := stopData_spec S.hsd
  obtain ⟨-, -, hlay, hpre, -⟩ := rootData_path S.hsd S.hrd
  obtain ⟨-, -, -, -, -, hmem, -⟩ := rootData_spec S.hsd S.hrd
  obtain ⟨hrp, H, hH, hHl⟩ := (Scan.mem_routeCols_iff _ _).mp hroute
  obtain ⟨Rc, hRc⟩ := Option.isSome_iff_exists.mp ((Tree.mem_colAddrs_iff _ _).mp hmem)
  obtain ⟨F, hF, hFc⟩ : ∃ F, S.A.forestAt S.rd.col.path = some F ∧ F.cols[S.rd.col.col]? = some Rc := by
    unfold Tree.colAt at hRc
    cases h : S.A.forestAt S.rd.col.path with
    | none => rw [h] at hRc; cases hRc
    | some F => rw [h] at hRc; exact ⟨F, rfl, hRc⟩
  obtain ⟨σ, hσ⟩ := hpre
  have hσ' : S.sd.col.path.drop S.rd.col.path.length = σ := by rw [← hσ, List.drop_left]
  rw [hσ']
  refine ⟨F, H, hF, hσ.symm, isRoutePath_append_D7 (hσ ▸ hrp) hF, ?_, hHl,
    (List.getElem?_eq_some_iff.mp hFc).1, ?_, hrp, hH⟩
  · rw [← hσ, Tree.forestAt_append, hF] at hH; exact hH
  · unfold holeDepth
    rw [hdepth, hlay, ← hσ, List.length_append]
    omega


-- D7 (route helper, body case): the kernel's route runs through the placed copy of `X`, and the
-- kernel images of the containers of the stopping column are kernel route columns
theorem kernel_route_body_D7 (S : OrdStep) (hown : S.rd.owner = false) (X : Forest) :
    (∀ b ∈ routeCols X, underCol (kerHole S.sd S.rd) b ∈ routeCols (kernel S.A S.sd S.rd X)) ∧
    ∀ L (hL : L < (S.sd.col.path.drop S.rd.col.path.length).length) a',
      kerCol S.sd S.rd ⟨S.rd.col.path ++ (S.sd.col.path.drop S.rd.col.path.length).take L,
        ((S.sd.col.path.drop S.rd.col.path.length)[L]'hL).1⟩ = some a' →
      a' ∈ routeCols (kernel S.A S.sd S.rd X) := by
  obtain ⟨F, H, hF, hσ, hrF, hFH, hHl, hidx, hhd, -, -⟩ := route_setup_D7 S
  obtain ⟨-, -, hidxeq, -, -, -, -, hownF⟩ := rootData_spec S.hsd S.hrd
  have hsdq : isQMat S.sd S.sd.col = false := isQMat_of_short S.sd le_rfl
  generalize hσd : S.sd.col.path.drop S.rd.col.path.length = σ at hσ hrF hFH hhd ⊢
  obtain ⟨cols⟩ := F
  have hnl : S.rd.col.col + 1 < cols.length := by
    have : ¬ (S.rd.col.col + 1 = cols.length) := fun h => by
      have := hownF.mpr ⟨_, hF, h⟩; rw [hown] at this; cases this
    simp only [Tree.cols] at hidx
    omega
  have hK : kernel S.A S.sd S.rd X =
      .node ([S.sd.Q ++ (unconsumed S.A S.rd).map fun x => (x.1, shift S.sd.r (period S.sd) x.2)] ++
        (replaceAt S.sd.r (period S.sd) (shift S.sd.r (period S.sd) X) σ.length
          (.node (cols.drop (S.rd.col.col + 1)))).cols) := by
    simp only [kernel, hown, Bool.false_eq_true, if_false, rootForest, hF, Option.getD_some,
      hidxeq, hhd, Tree.cols]
    rfl
  have hF0ne : (Tree.node (cols.drop (S.rd.col.col + 1))).cols ≠ [] := by
    simp only [Tree.cols, ne_eq, List.drop_eq_nil_iff, not_le]; omega
  rw [hK]
  cases σ with
  | nil =>
    simp only [Tree.forestAt, Option.some.injEq] at hFH
    subst hFH
    simp only [List.append_nil] at hσ
    simp only [Tree.cols] at hHl
    have hkh : kerHole S.sd S.rd = ⟨[], S.sd.col.col - S.rd.col.col⟩ := by
      simp only [kerHole, kerCol_nil_eq S hsdq hσ, if_neg (show S.sd.col.col ≠ S.rd.col.col by omega),
        if_pos (show S.rd.col.col < S.sd.col.col ∧ S.rd.owner = false from ⟨by omega, hown⟩),
        Option.getD_some]
    refine ⟨fun b hb => ?_, fun L hL => absurd hL (by simp)⟩
    have h1 := routeCols_replaceAt_D7 S.sd.r (period S.sd) (shift S.sd.r (period S.sd) X) []
      (.node (cols.drop (S.rd.col.col + 1))) (fun d hd => absurd hd (by simp))
      _ rfl hF0ne b (mem_routeCols_map_D7 _ hb)
    have h2 := mem_routeCols_append_D7
      [S.sd.Q ++ (unconsumed S.A S.rd).map fun x => (x.1, shift S.sd.r (period S.sd) x.2)] h1
    rw [← underCol_assoc_D7] at h2
    rw [hkh]
    convert h2 using 2
    simp only [underCol, Tree.cols, List.length_drop, List.length_singleton]
    congr 1
    omega
  | cons st rest =>
    obtain ⟨ci, e⟩ := st
    obtain ⟨hl, -, -, -⟩ := Scan.isRoutePath_cons.mp hrF
    obtain ⟨col, -, -, hcl, -, hs, -⟩ := Scan.lastStep?_eq_some hl
    simp only [Prod.mk.injEq, Tree.cols] at hs
    have hci : ci = cols.length - 1 := hs.1
    have hdrop := isRoutePath_drop_D7 hrF (k := S.rd.col.col + 1) (by omega)
    have hH0 : (Tree.node (cols.drop (S.rd.col.col + 1))).forestAt
        ((ci - (S.rd.col.col + 1), e) :: rest) = some H := by
      rw [show (ci - (S.rd.col.col + 1), e) :: rest = [(ci - (S.rd.col.col + 1), e)] ++ rest from rfl,
        Tree.forestAt_append, hdrop.2, ← Tree.forestAt_append]
      exact hFH
    have hkh : kerHole S.sd S.rd = ⟨(ci - S.rd.col.col, e) :: rest, S.sd.col.col⟩ := by
      simp only [kerHole, kerCol_cons_eq S hsdq hσ,
        if_neg (show ¬ (ci = S.rd.col.col ∧ S.rd.cursor ≤ e) by omega),
        if_pos (show S.rd.col.col < ci ∧ S.rd.owner = false from ⟨by omega, hown⟩),
        Option.getD_some]
    refine ⟨fun b hb => ?_, fun L hL a' ha' => ?_⟩
    · have h1 := routeCols_replaceAt_D7 S.sd.r (period S.sd) (shift S.sd.r (period S.sd) X) _ _
        hdrop.1 H hH0 (by intro h0; rw [h0] at hHl; simp at hHl) b (mem_routeCols_map_D7 _ hb)
      have h2 := mem_routeCols_append_D7
        [S.sd.Q ++ (unconsumed S.A S.rd).map fun x => (x.1, shift S.sd.r (period S.sd) x.2)] h1
      rw [← underCol_assoc_D7] at h2
      rw [hkh]
      convert h2 using 2
      all_goals first
        | rfl
        | (simp [underCol, hHl]; omega)
    · have h1 := routeCols_replaceAt_above_D7 S.sd.r (period S.sd) (shift S.sd.r (period S.sd) X)
        _ _ hdrop.1 L (by simpa using hL)
      have h2 := mem_routeCols_append_D7
        [S.sd.Q ++ (unconsumed S.A S.rd).map fun x => (x.1, shift S.sd.r (period S.sd) x.2)] h1
      cases L with
      | zero =>
        try simp only [List.take_zero, List.append_nil, List.getElem_cons_zero] at ha'
        rw [kerCol_nil_eq S (o := ⟨S.rd.col.path, ci⟩) (isQMat_of_short S.sd (by simp [hσ])) rfl,
          if_neg (show ci ≠ S.rd.col.col by omega),
          if_pos (show S.rd.col.col < ci ∧ S.rd.owner = false from ⟨by omega, hown⟩)] at ha'
        cases ha'
        convert h2 using 2
        all_goals first
          | rfl
          | (simp [underCol]; omega)
      | succ L =>
        try simp only [List.take_succ_cons, List.getElem_cons_succ] at ha'
        rw [kerCol_cons_eq S
            (o := ⟨S.rd.col.path ++ (ci, e) :: rest.take L, (rest[L]'(by simp at hL; omega)).1⟩)
            (isQMat_of_short S.sd (by
              simp only [hσ, List.length_append, List.length_cons, List.length_take]
              omega)) rfl,
          if_neg (show ¬ (ci = S.rd.col.col ∧ S.rd.cursor ≤ e) by omega),
          if_pos (show S.rd.col.col < ci ∧ S.rd.owner = false from ⟨by omega, hown⟩)] at ha'
        cases ha'
        convert h2 using 2
        all_goals first
          | rfl
          | (simp [underCol]; omega)


-- D7 (route helper, owner case): as `kernel_route_body_D7`, for an owner root (the kernel is its
-- head, whose last restored height carries the copy of the root's last height)
theorem kernel_route_owner_D7 (S : OrdStep) (hown : S.rd.owner = true) (X : Forest) :
    (∀ b ∈ routeCols X, underCol (kerHole S.sd S.rd) b ∈ routeCols (kernel S.A S.sd S.rd X)) ∧
    ∀ L (hL : L < (S.sd.col.path.drop S.rd.col.path.length).length) a',
      kerCol S.sd S.rd ⟨S.rd.col.path ++ (S.sd.col.path.drop S.rd.col.path.length).take L,
        ((S.sd.col.path.drop S.rd.col.path.length)[L]'hL).1⟩ = some a' →
      a' ∈ routeCols (kernel S.A S.sd S.rd X) := by
  obtain ⟨F, H, hF, hσ, hrF, hFH, hHl, hidx, hhd, -, -⟩ := route_setup_D7 S
  obtain ⟨-, -, -, -, -, hownc, hlast⟩ := rootData_path S.hsd S.hrd
  have hsdq : isQMat S.sd S.sd.col = false := isQMat_of_short S.sd le_rfl
  obtain ⟨ce, hce⟩ := Option.isSome_iff_exists.mp (hownc.mp hown)
  have hce1 := hlast ce hce
  obtain ⟨hcecol, hcepre⟩ := (ColAddr.container_spec _ _ _).mp hce
  generalize hσd : S.sd.col.path.drop S.rd.col.path.length = σ at hσ hrF hFH hhd ⊢
  obtain ⟨rest, rfl⟩ : ∃ rest, σ = (S.rd.col.col, ce.idx) :: rest := by
    obtain ⟨t, ht⟩ := hcepre
    rw [EntryAddr.heightPath, hcecol, hσ, List.append_assoc] at ht
    exact ⟨t, (List.append_cancel_left ht).symm⟩
  -- the root column and its last entry
  set e := ce.idx with he
  obtain ⟨R, hR⟩ : ∃ R, F.cols[S.rd.col.col]? = some R := ⟨_, List.getElem?_eq_getElem hidx⟩
  have hAR : S.A.colAt S.rd.col = some R := by
    unfold Tree.colAt; rw [hF]; exact hR
  have hRlen : R.length = e + 1 := by
    unfold Packet.rootLenOf at hce1; rw [hAR] at hce1; simpa using hce1.symm
  have hU := S.kernelDefined hown
  have hUeq : unconsumed S.A S.rd = R.drop S.rd.cursor := by
    simp [unconsumed, rootCol, hAR]
  have hcur : S.rd.cursor ≤ e := by
    rw [hUeq] at hU
    by_contra hc
    exact hU (List.drop_eq_nil_of_le (by omega))
  obtain ⟨hl, HR, hHR, hrR⟩ := Scan.isRoutePath_cons.mp hrF
  have hRH : HR.forestAt rest = some H := by
    rw [show (S.rd.col.col, e) :: rest = [(S.rd.col.col, e)] ++ rest from rfl, Tree.forestAt_append,
      hHR] at hFH
    exact hFH
  obtain ⟨pe, hRe⟩ : ∃ pe, R[e]? = some (pe, HR) := by
    rw [Tree.forestAt_cons, hR] at hHR
    simp only [Option.bind_some] at hHR
    cases h : R[e]? with
    | none => rw [h] at hHR; cases hHR
    | some x =>
      rw [h] at hHR
      simp only [Option.bind_some, Tree.forestAt, Option.some.injEq] at hHR
      exact ⟨x.1, by rw [← hHR]⟩
  -- the kernel is its head column
  set f := fun (x : Nat × Forest) => (x.1, shift S.sd.r (period S.sd) x.2)
  set g := fun (x : Nat × Forest) =>
    (x.1, replaceAt S.sd.r (period S.sd) (shift S.sd.r (period S.sd) X) rest.length x.2)
  set hc := S.sd.Q ++ mapLast f g (R.drop S.rd.cursor) with hhc
  have hK : kernel S.A S.sd S.rd X = .node [hc] := by
    simp only [kernel, hown, if_true, hhd, hUeq, hhc, f, g]
    rfl
  have hdl : (R.drop S.rd.cursor).length = e + 1 - S.rd.cursor := by
    rw [List.length_drop, hRlen]
  have hclen : hc.length = S.m + (e + 1 - S.rd.cursor) := by
    rw [hhc, List.length_append, length_mapLast_D7, hdl]; rfl
  have hl' : (Tree.node [hc]).lastStep? = some (0, S.m + (e - S.rd.cursor)) := by
    have hne : hc ≠ [] := by
      intro h0; have := congrArg List.length h0; rw [hclen] at this; simp at this; omega
    simp only [Tree.lastStep?, Tree.cols, List.getLast?_singleton, Option.bind_some,
      List.isEmpty_iff, hne, if_false, List.length_singleton, Option.some.injEq, Prod.mk.injEq]
    refine ⟨trivial, ?_⟩
    have h1 := hclen
    have h2 := hcur
    omega
  have hh' : (Tree.node [hc]).forestAt [(0, S.m + (e - S.rd.cursor))] =
      some (replaceAt S.sd.r (period S.sd) (shift S.sd.r (period S.sd) X) rest.length HR) := by
    rw [Tree.forestAt_cons]
    simp only [Tree.cols, List.getElem?_singleton, if_true, Option.bind_some, hhc]
    rw [List.getElem?_append_right (by simp [OrdStep.m]),
      show S.m + (e - S.rd.cursor) - S.sd.Q.length = (R.drop S.rd.cursor).length - 1 by
        rw [hdl]; simp [OrdStep.m]; omega,
      getElem?_mapLast_last_D7, List.getLast?_drop, if_neg (by omega), List.getLast?_eq_getElem?,
      hRlen, Nat.add_sub_cancel, hRe]
    rfl
  have hkh : kerHole S.sd S.rd = ⟨(0, S.m + (e - S.rd.cursor)) :: rest, S.sd.col.col⟩ := by
    rw [kerHole, kerCol_cons_eq S hsdq hσ,
      if_pos (show S.rd.col.col = S.rd.col.col ∧ S.rd.cursor ≤ e from ⟨rfl, hcur⟩)]
    rfl
  rw [hK]
  refine ⟨fun b hb => ?_, fun L hL a' ha' => ?_⟩
  · have h1 := routeCols_replaceAt_D7 S.sd.r (period S.sd) (shift S.sd.r (period S.sd) X) rest HR
      hrR H hRH (by intro h0; rw [h0] at hHl; simp at hHl) b (mem_routeCols_map_D7 _ hb)
    have h2 := mem_routeCols_cons_D7 hl' hh' h1
    rw [hkh]
    convert h2 using 2
    all_goals first
      | rfl
      | (obtain ⟨bp, bc⟩ := b
         cases bp with
         | nil => simp [underCol, hHl]
         | cons x xs => obtain ⟨c0, e0⟩ := x; simp [underCol, hHl])
  · cases L with
    | zero =>
      try simp only [List.take_zero, List.append_nil, List.getElem_cons_zero] at ha'
      rw [kerCol_nil_eq S (o := ⟨S.rd.col.path, S.rd.col.col⟩) (isQMat_of_short S.sd (by simp [hσ]))
        rfl, if_pos rfl] at ha'
      cases ha'
      refine (Scan.mem_routeCols_iff _ _).mpr ⟨fun d hd => absurd hd (by simp), _, rfl, ?_⟩
      rfl
    | succ L =>
      try simp only [List.take_succ_cons, List.getElem_cons_succ] at ha'
      rw [kerCol_cons_eq S
          (o := ⟨S.rd.col.path ++ (S.rd.col.col, e) :: rest.take L, (rest[L]'(by simp at hL; omega)).1⟩)
          (isQMat_of_short S.sd (by
            simp only [hσ, List.length_append, List.length_cons, List.length_take]
            omega)) rfl,
        if_pos (show S.rd.col.col = S.rd.col.col ∧ S.rd.cursor ≤ e from ⟨rfl, hcur⟩)] at ha'
      cases ha'
      exact mem_routeCols_cons_D7 hl' hh'
        (routeCols_replaceAt_above_D7 _ _ _ rest HR hrR L (by simp at hL; omega))


-- D7 (route helper): the kernel route facts, in both root cases
theorem kernel_route_D7 (S : OrdStep) (X : Forest) :
    (∀ b ∈ routeCols X, underCol (kerHole S.sd S.rd) b ∈ routeCols (kernel S.A S.sd S.rd X)) ∧
    ∀ L (hL : L < (S.sd.col.path.drop S.rd.col.path.length).length) a',
      kerCol S.sd S.rd ⟨S.rd.col.path ++ (S.sd.col.path.drop S.rd.col.path.length).take L,
        ((S.sd.col.path.drop S.rd.col.path.length)[L]'hL).1⟩ = some a' →
      a' ∈ routeCols (kernel S.A S.sd S.rd X) := by
  cases h : S.rd.owner
  · exact kernel_route_body_D7 S h X
  · exact kernel_route_owner_D7 S h X

-- G9.6 (D7; L-G010.4a, last clause): the phase copy of a template container of the stopping
-- column is a route column of `B`
theorem phaseCol_container_route_D7 (S : OrdStep) {i : Nat} {a c : ColAddr} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (haq : isQMat S.sd a = false)
    (hc : phaseCol S.sd S.rd i a = some c) {e : EntryAddr} (he : a.container S.sd.col = some e) :
    c ∈ routeCols S.B := by
  obtain ⟨F, H, hF, hσ, -, -, hHl, -, -, hrp, hH⟩ := route_setup_D7 S
  obtain ⟨-, hdepth, -⟩ := stopData_spec S.hsd
  obtain ⟨b₀, hb₀⟩ := Option.isSome_iff_exists.mp ha.2.2.2
  -- `a` is the container of the stopping column at some level `L` below the root forest
  obtain ⟨hecol, hepre⟩ := (ColAddr.container_spec _ _ _).mp he
  have hpre : a.path.take S.rd.col.path.length = S.rd.col.path := by
    by_contra hne
    unfold kerCol at hb₀
    simp only [haq, Bool.false_eq_true, if_false, if_neg hne] at hb₀
    cases hb₀
  generalize hσd : S.sd.col.path.drop S.rd.col.path.length = σ at hσ
  obtain ⟨t, ht⟩ := hepre
  rw [EntryAddr.heightPath, hecol, List.append_assoc] at ht
  have hlen : S.rd.col.path.length ≤ a.path.length := by
    by_contra hc'
    rw [List.take_of_length_le (by omega)] at hpre
    rw [hpre] at hc'
    omega
  have hL : a.path.length - S.rd.col.path.length < σ.length := by
    have := congrArg List.length ht
    rw [hσ] at this
    simp only [List.length_append, List.length_cons] at this
    omega
  have hapath : a.path = S.rd.col.path ++ σ.take (a.path.length - S.rd.col.path.length) := by
    have h1 : a.path = (S.rd.col.path ++ σ).take a.path.length := by
      rw [← hσ, ← ht, List.take_left]
    calc a.path = (S.rd.col.path ++ σ).take a.path.length := h1
      _ = _ := by rw [List.take_append]; simp [List.take_of_length_le hlen]
  have hacol : a.col = (σ[a.path.length - S.rd.col.path.length]'hL).1 := by
    have h1 : S.sd.col.path[a.path.length]? = some (a.col, e.idx) := by
      rw [← ht, List.getElem?_append_right le_rfl, Nat.sub_self]; rfl
    rw [hσ, List.getElem?_append_right hlen, List.getElem?_eq_getElem hL] at h1
    simp only [Option.some.injEq] at h1
    rw [h1]
  have hb₀' : kerCol S.sd S.rd ⟨S.rd.col.path ++ σ.take (a.path.length - S.rd.col.path.length),
      (σ[a.path.length - S.rd.col.path.length]'hL).1⟩ = some b₀ := by
    rw [← hapath, ← hacol]; exact hb₀
  have hroute₀ : ∀ X, b₀ ∈ routeCols (kernel S.A S.sd S.rd X) := fun X =>
    (kernel_route_D7 S X).2 _ (by rw [hσd]; exact hL) b₀ (by simp only [hσd]; exact hb₀')
  -- iterate through the layers
  have hiter : ∀ j X, (underCol (kerHole S.sd S.rd))^[j] b₀ ∈
      routeCols ((kernel S.A S.sd S.rd)^[j + 1] X) := by
    intro j
    induction j with
    | zero => intro X; simpa using hroute₀ X
    | succ j ih =>
      intro X
      have e1 : (underCol (kerHole S.sd S.rd))^[j + 1] b₀ =
          underCol (kerHole S.sd S.rd) ((underCol (kerHole S.sd S.rd))^[j] b₀) :=
        Function.iterate_succ_apply' _ _ _
      have e2 : (kernel S.A S.sd S.rd)^[j + 1 + 1] X =
          kernel S.A S.sd S.rd ((kernel S.A S.sd S.rd)^[j + 1] X) :=
        Function.iterate_succ_apply' _ _ _
      rw [e1, e2]
      exact (kernel_route_D7 S _).1 _ (ih X)
  have hcdef : c = underCol S.sd.col ((underCol (kerHole S.sd S.rd))^[i - 1] b₀) := by
    unfold phaseCol at hc; rw [hb₀] at hc; exact (Option.some.inj hc).symm
  have hE : S.A ≠ Tree.empty := by
    intro h
    have := S.hsd
    rw [h, stopData_eq_none_of_lastCol (Or.inl rfl)] at this
    cases this
  have hB : S.B = context S.A S.sd ((kernel S.A S.sd S.rd)^[S.n] Tree.empty) := by
    have := expand_eq_iterate hE S.inL.1 S.inL.2.1 S.kind S.hsd S.hrd S.kernelDefined S.n
    rw [S.out] at this
    exact Option.some.inj this
  have hZ : (underCol (kerHole S.sd S.rd))^[i - 1] b₀ ∈
      routeCols ((kernel S.A S.sd S.rd)^[S.n] Tree.empty) := by
    have := hiter (i - 1) ((kernel S.A S.sd S.rd)^[S.n - i] Tree.empty)
    rwa [← Function.iterate_add_apply, show i - 1 + 1 + (S.n - i) = S.n by omega] at this
  have := routeCols_replaceAt_D7 0 0 _ S.sd.col.path S.A hrp H hH
    (by intro h0; rw [h0] at hHl; simp at hHl) _ hZ
  rw [hB, hcdef]
  unfold context
  rw [hdepth]
  convert this using 2
  rw [hHl, Nat.add_sub_cancel]

-- T3.2i (D7): the parents of a template copy are the shifted parents of its template column
theorem parents_phaseCol_D7 (S : OrdStep) {i : Nat} {a c : ColAddr} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hc : phaseCol S.sd S.rd i a = some c) :
    parents S.B c = (parents S.A a).map (shiftVal S.sd.r (phaseOff S.sd i a * S.d)) := by
  by_cases haq : isQMat S.sd a = true
  · have hroute : ¬ OnHoleRoute S.sd a := fun h => by
      have := isQMat_of_short S.sd h.length_le
      rw [haq] at this
      cases this
    have hB := colAt_phaseCol S.inL S.kind S.hsd S.hrd S.out hi ha hroute hc
    simp only [parents, hB]
    cases S.A.colAt a with
    | none => simp
    | some col => simp [mapCol_eq_map, OrdStep.d]
  · have haq' : isQMat S.sd a = false := by simpa using haq
    have hφ : phaseOff S.sd i a = i := by simp [phaseOff, haq']
    obtain ⟨Z, hZ⟩ := colAt_copyCol S (h := i) hi.2 ha haq'
    have hcopy : S.copyCol i a = c := by
      simp only [OrdStep.copyCol, if_neg (show i ≠ 0 by omega), hc, Option.getD_some]
    rw [hcopy] at hZ
    have hctx : parents (context S.A S.sd Z) a = parents S.A a := by
      cases hce : a.container S.sd.col with
      | none =>
        simp only [parents]
        rw [colAt_context_of_not_route S.hsd Z ha.1 ha.2.1 (sdcol_container_none S ha.1 haq') hce]
      | some e => exact (colAt_context_onStack S.hsd Z (onStack_of_container hce)).1
    rw [hφ, ← hctx]
    simp only [parents, hZ]
    cases (context S.A S.sd Z).colAt a with
    | none => simp
    | some col => simp [mapCol_eq_map]

-- G9.6 (helper, the full-cut exclusion): the phase copy `c` of a template column that contains
-- the stopping column lies on the route of `B`, so a cut after its last entry is at the end of
-- `w(B)` (G-009 §3 G9.6 step 2)
theorem fullCut_container_end (S : OrdStep) {i : Nat} {a c : ColAddr} {ρ : Nat}
    (hi : 1 ≤ i ∧ i ≤ S.n) (ha : IsTmplCol S.A S.sd S.rd a) (haq : isQMat S.sd a = false)
    (hc : phaseCol S.sd S.rd i a = some c) {e : EntryAddr} (he : a.container S.sd.col = some e)
    (_hup : IsUpward S.B c (e.idx + 1) ρ) : mu S.B ≤ capPos S.B c (e.idx + 1) := by
  have hroute := phaseCol_container_route_D7 S hi ha haq hc he
  have hlen : (parents S.B c).length = e.idx + 1 := by
    rw [parents_phaseCol_D7 S hi ha hc, List.length_map, container_sdcol_last S he]
  have hne : parents S.B c ≠ [] := by
    intro h; rw [h] at hlen; simp at hlen
  rw [← hlen, capPos_route_D7 hroute hne]

-- G9.6: off the full cut, the first `k` entries of `c` are pure `τ_φ`-copies of those of `a`, so
-- `V = κ_φ(W)` with `W = B_a(k−1)` the old cut query (T3.2h.1)
theorem capQ_eq_kappaQ (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ)
    (hend : capPos S.B c k < mu S.B) :
    S.capQ c k ρ = kappaQ S.sd.r S.d (phaseOff S.sd i a) (cutQuery (actualKeys S.A a) k) := by
  obtain ⟨hKcol, hKlen⟩ := litCap_colAt_self hup
  set f := shiftVal S.sd.r (phaseOff S.sd i a * S.d) with hf
  -- the first `k` entries of `c` in `B` are `τ_φ`-copies of those of `a` in `A`
  have hfirst : ((S.B.colAt c).getD []).take k =
      (((S.A.colAt a).getD []).take k).map fun x => (f x.1, Tree.map f x.2) := by
    by_cases haq : isQMat S.sd a = true
    · have hroute : ¬ OnHoleRoute S.sd a := fun h => by
        have := isQMat_of_short S.sd h.length_le
        rw [haq] at this
        cases this
      have hB := colAt_phaseCol S.inL S.kind S.hsd S.hrd S.out hi ha hroute hc
      rw [hB]
      cases S.A.colAt a with
      | none => simp
      | some col => simp [mapCol_eq_map, List.map_take, hf, OrdStep.d]
    · have haq' : isQMat S.sd a = false := by simpa using haq
      have hφ : phaseOff S.sd i a = i := by simp [phaseOff, haq']
      obtain ⟨Z, hZ⟩ := colAt_copyCol S (h := i) hi.2 ha haq'
      have hcopy : S.copyCol i a = c := by
        simp only [OrdStep.copyCol, if_neg (show i ≠ 0 by omega), hc, Option.getD_some]
      rw [hcopy] at hZ
      rw [hZ]
      -- the context agrees with `A` on the first `k` entries of `a`
      have hctx : (((context S.A S.sd Z).colAt a).getD []).take k = ((S.A.colAt a).getD []).take k := by
        cases hce : a.container S.sd.col with
        | none =>
          rw [colAt_context_of_not_route S.hsd Z ha.1 ha.2.1 (sdcol_container_none S ha.1 haq') hce]
        | some e =>
          have hst := onStack_of_container hce
          obtain ⟨hpar, htk, -⟩ := colAt_context_onStack S.hsd Z hst
          have hl := container_sdcol_last S hce
          -- `k ≤ e.idx`: the full cut is excluded by `hend`
          have hkle : k ≤ e.idx := by
            have hk1 : k ≤ ((S.B.colAt c).getD []).length := by
              have := hKlen; rw [List.length_take] at this; omega
            have hBlen : ((S.B.colAt c).getD []).length = (parents S.A a).length := by
              rw [hZ, ← hpar]
              simp only [parents, List.length_map]
              cases (context S.A S.sd Z).colAt a with
              | none => rfl
              | some col => simp [mapCol_eq_map]
            by_contra hcon
            have hk : k = e.idx + 1 := by omega
            subst hk
            have := fullCut_container_end S hi ha haq' hc hce hup
            omega
          have h1 := htk e hce
          have key : ∀ (o1 o2 : Option Column), o1.map (·.take e.idx) = o2.map (·.take e.idx) →
              (o1.getD []).take k = (o2.getD []).take k := by
            intro o1 o2 h12
            cases o1 with
            | none =>
              cases o2 with
              | none => rfl
              | some _ => cases h12
            | some C1 =>
              cases o2 with
              | none => cases h12
              | some C2 =>
                simp only [Option.map_some, Option.some.injEq] at h12
                simp only [Option.getD_some]
                rw [← Nat.min_eq_left hkle, ← List.take_take, h12, List.take_take]
          exact key _ _ h1
      rw [← hctx]
      simp only [hf, hφ]
      cases (context S.A S.sd Z).colAt a with
      | none => simp
      | some col => simp [mapCol_eq_map, List.map_take]
  -- keys
  have hnum : c.num 0 = a.num 0 + phaseOff S.sd i a * S.d :=
    num_phaseCol S.inL S.kind S.hsd S.hrd (Or.inr ha) hi.1 hc
  have hra : S.sd.r ≤ a.num 0 := (tmplCol_num_gt S ha).le
  have hKtake : (actualKeys (litCap S.B c k ρ) c).take k =
      kappaQ S.sd.r S.d (phaseOff S.sd i a) ((actualKeys S.A a).take k) := by
    simp only [actualKeys, hKcol, Option.getD_some, List.map_append]
    rw [List.take_left' (by rw [List.length_map, hKlen]), ← List.map_take, hfirst, List.map_map]
    unfold kappaQ
    rw [List.map_map]
    congr 1
    funext x
    simp only [Function.comp_apply, WithTop.map_coe, hnum, hf]
    exact congrArg _ (relKey_shift S.sd.r S.d (phaseOff S.sd i a) (a.num 0) hra x.2)
  unfold OrdStep.capQ cutQuery
  rw [hKtake]
  unfold kappaQ
  rw [nu_map (kappaQry_strictMono _ _ _)]

-- G9.7 (T3.8lm, list form): a query `κ_φ W` that is low at `s_φ` is low at every head
-- `s_1, …, s_φ`
theorem low_all_heads (S : OrdStep) {φ : Nat} (hφ : 1 ≤ φ) (W : List Key)
    (hlow : kappaQ S.sd.r S.d φ (W.map (↑)) < kappaQ S.sd.r S.d (φ - 1) S.termZ) {h : Nat}
    (hh : 1 ≤ h ∧ h ≤ φ) :
    kappaQ S.sd.r S.d φ (W.map (↑)) < kappaQ S.sd.r S.d (h - 1) S.termZ := by
  obtain ⟨hcol, -, ht, -⟩ := stopData_spec S.hsd
  have hrt : S.sd.r < S.sd.t := (rootData_spec S.hsd S.hrd).2.2.2.2.1
  have htd : S.sd.r + S.d = S.sd.t := by simp only [OrdStep.d, period]; omega
  have hcoe : StrictMono (fun x : Key => (x : WithTop Key)) := WithTop.coe_strictMono
  -- the old complete query is `ν(y)`, read in `WithTop Key`
  have hZ : S.termZ = (nu (S.sd.Q.map fun x => relKey (S.sd.r + S.d) x.2)).map (↑) := by
    unfold OrdStep.termZ cutQuery
    rw [← nu_map hcoe]
    congr 1
    simp only [actualKeys, hcol, Option.getD_some, List.map_append, ← ht, htd, List.map_map]
    rw [List.take_left' (by simp [OrdStep.m])]
    rfl
  obtain ⟨Js, -, hJs⟩ : ∃ Js : List Forest, Js.Sublist (S.sd.Q.map Prod.snd) ∧
      nu (S.sd.Q.map fun x => relKey (S.sd.r + S.d) x.2) = Js.map (relKey (S.sd.r + S.d)) := by
    have hm : (S.sd.Q.map fun x => relKey (S.sd.r + S.d) x.2) =
        (S.sd.Q.map Prod.snd).map (relKey (S.sd.r + S.d)) := by
      rw [List.map_map]; rfl
    have := nu_sublist (S.sd.Q.map fun x => relKey (S.sd.r + S.d) x.2)
    rw [hm] at this ⊢
    exact List.sublist_map_iff.mp this
  have hmap : ∀ j (l : List Key),
      kappaQ S.sd.r S.d j (l.map (↑)) = (l.map (kappa S.sd.r S.d j)).map (↑) := by
    intro j l; unfold kappaQ; rw [List.map_map, List.map_map]; rfl
  rw [hZ, hJs, hmap, hmap] at hlow ⊢
  rw [list_map_lt_iff (hcoe.strictMonoOn Set.univ) (fun _ _ => trivial) (fun _ _ => trivial)]
    at hlow ⊢
  exact (sign_indep_list (by omega) (by omega) W Js).mp hlow

-- T3.8ln (txt:530, 549-551; moved here, before its first use G9.8a `phase_exit`): parents of
-- phase-`φ` material are `< r` or `≥ s_φ`
theorem phase_parent_dichotomy (S : OrdStep) {i : Nat} {a c : ColAddr} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hc : phaseCol S.sd S.rd i a = some c) {x : Nat × Forest}
    (hx : x ∈ (S.B.colAt c).getD []) : x.1 < S.sd.r ∨ S.s (phaseOff S.sd i a) ≤ x.1 := by
  have hmem : x.1 ∈ parents S.B c := List.mem_map_of_mem hx
  rw [parents_phaseCol_D7 S hi ha hc] at hmem
  obtain ⟨p, -, hp⟩ := List.mem_map.mp hmem
  rw [← hp]
  exact shiftVal_dich _ _ _

/-! ## G9.8 — the derivation of T3.8lo -/

-- G9.8a: the cut path of `K` starts at or above `s_φ` and passes through `s_φ` on its way to a
-- previous-phase root
theorem phase_exit (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hρ1 : S.sd.r < ρ) (hρ2 : ρ < S.s (phaseOff S.sd i a)) :
    S.s (phaseOff S.sd i a) ≤ cutStart (litCap S.B c k ρ) c k ∧
      Path (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c (S.capQ c k ρ)
        (cutStart (litCap S.B c k ρ) c k) (S.s (phaseOff S.sd i a)) ∧
      Path (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c (S.capQ c k ρ)
        (S.s (phaseOff S.sd i a)) ρ := by
  have hV : CondV (litCap S.B c k ρ) := hKL.1
  have hA : CondA (litCap S.B c k ρ) := hKL.2.2.2.1
  obtain ⟨hcol, hlen⟩ := litCap_colAt_self hup
  obtain ⟨hcmem, -⟩ := litCap_parents_self hup
  have hpar : parents (litCap S.B c k ρ) c =
      (((S.B.colAt c).getD []).take k).map Prod.fst ++ [ρ] := by
    simp [parents, hcol]
  -- the cut path: A of `K` at `(c, k)`
  have hcut : Path (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c (S.capQ c k ρ)
      (cutStart (litCap S.B c k ρ) c k) ρ := by
    have hk : (parents (litCap S.B c k ρ) c)[k]? = some ρ := by
      rw [hpar, List.getElem?_append_right (by rw [List.length_map, hlen]), List.length_map, hlen,
        Nat.sub_self]
      rfl
    exact hA c hcmem k ρ hk
  -- `s_φ ≤ x₀`
  have hx0 : S.s (phaseOff S.sd i a) ≤ cutStart (litCap S.B c k ρ) c k := by
    rcases Nat.eq_zero_or_pos k with hk0 | hk0
    · subst hk0
      simp only [cutStart, if_true]
      have := phaseCol_num_gt S hi.1 ha hc
      omega
    · have hne : k ≠ 0 := by omega
      have hlt : k - 1 < (((S.B.colAt c).getD []).take k).length := by omega
      have hget : (parents (litCap S.B c k ρ) c)[k - 1]? =
          some ((((S.B.colAt c).getD []).take k)[k - 1]'hlt).1 := by
        rw [hpar, List.getElem?_append_left (by simpa using hlt), List.getElem?_map,
          List.getElem?_eq_getElem hlt]
        rfl
      have hx0eq : cutStart (litCap S.B c k ρ) c k =
          ((((S.B.colAt c).getD []).take k)[k - 1]'hlt).1 := by
        simp only [cutStart, hne, if_false, hget, Option.getD_some]
      rw [hx0eq]
      have hmem : (((S.B.colAt c).getD []).take k)[k - 1]'hlt ∈ (S.B.colAt c).getD [] :=
        List.mem_of_mem_take (List.getElem_mem hlt)
      rcases phase_parent_dichotomy S hi ha hc hmem with h | h
      · exfalso
        have := path_le hV hcut
        rw [hx0eq] at this
        omega
      · exact h
  -- the cut path passes `s_φ`: above `s_φ` every stack parent is `< r` or `≥ s_φ`
  have hpass : ∀ x, Path (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c (S.capQ c k ρ) x ρ →
      S.s (phaseOff S.sd i a) ≤ x →
      Path (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c (S.capQ c k ρ) x
        (S.s (phaseOff S.sd i a)) := by
    intro x hx
    induction hx using Relation.ReflTransGen.head_induction_on with
    | refl => intro h; omega
    | @head x x' hxx' hx'ρ ih =>
      intro hsx
      rcases Nat.eq_or_lt_of_le hsx with heq | hlt
      · rw [← heq]
        exact Relation.ReflTransGen.refl
      · obtain ⟨o, ho, hresp⟩ := hxx'
        have hmem : x' ∈ parents (litCap S.B c k ρ) o := by
          rw [resp_eq_parents] at hresp
          exact List.mem_of_getElem? hresp
        rcases stack_parent_dichotomy S hi ha hq hc hup hlt ho x' hmem with h | h
        · exfalso
          have := path_le hV hx'ρ
          omega
        · exact Relation.ReflTransGen.head ⟨o, ho, hresp⟩ (ih h)
  have hP1 := hpass _ hcut hx0
  exact ⟨hx0, hP1, path_functional hV hP1 hcut hρ2.le⟩

-- G9.8b: a head `s_h` whose response is a parent `≥ r` is low
theorem low_of_head_edge (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat}
    (hi : 1 ≤ i ∧ i ≤ S.n) (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ) {h : Nat}
    (hh : 1 ≤ h ∧ h ≤ phaseOff S.sd i a) {w : Nat}
    (he : Edge (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c (S.capQ c k ρ) (S.s h) w)
    (hw : S.sd.r ≤ w) : S.capQ c k ρ < kappaQ S.sd.r S.d (h - 1) S.termZ := by
  obtain ⟨o, ho, hresp⟩ := he
  obtain ⟨hres, -⟩ := resolve_headCol S hi ha hq hc hh
  rw [hres, Option.some.injEq] at ho
  subst ho
  obtain ⟨-, hbig, hkeys, hlen⟩ := headCol_litCap S hi ha hq hc hup hh
  rw [resp_eq_parents] at hresp
  have hcm : cursor (actualKeys (litCap S.B c k ρ) (S.headCol h)) (S.capQ c k ρ) < S.m := by
    by_contra hcon
    have := hbig _ _ (by omega) hresp
    omega
  have hst := kappaQry_strictMono S.sd.r S.d (h - 1)
  have e1 := cursor_take (actualKeys (litCap S.B c k ρ) (S.headCol h)) (S.capQ c k ρ) S.m
  rw [hkeys] at e1
  have hlt : cursor (kappaQ S.sd.r S.d (h - 1) ((actualKeys S.A S.sd.col).take S.m))
      (S.capQ c k ρ) < S.m := by
    rw [e1]; omega
  have hlenq : S.m ≤ (kappaQ S.sd.r S.d (h - 1) ((actualKeys S.A S.sd.col).take S.m)).length := by
    rw [← hkeys, List.length_take]; omega
  have := lt_cutQuery_of_cursor_lt (cutQuery_noninc _ _) hlenq hlt
  unfold kappaQ at this ⊢
  rw [cutQuery_map hst] at this
  have htt : cutQuery ((actualKeys S.A S.sd.col).take S.m) S.m =
      cutQuery (actualKeys S.A S.sd.col) S.m := by
    unfold cutQuery; rw [List.take_take, Nat.min_self]
  rw [htt] at this
  exact this

-- G9.8c: the first unconsumed root entry of a literal cap is the response of its root column at
-- the cap's cut query
theorem unconsumed_litCap {B : Forest} {c : ColAddr} {k ρ : Nat} (hup : IsUpward B c k ρ)
    {rd : RootData} (hrd : rootData (litCap B c k ρ) = some rd) :
    c.resolve 0 ρ = some rd.col ∧
      (unconsumed (litCap B c k ρ) rd).head?.map Prod.fst =
        resp (litCap B c k ρ) (actualKeys (litCap B c k ρ)) rd.col
          (cutQuery (actualKeys (litCap B c k ρ) c) k) := by
  have hsd := stopData_litCap hup
  obtain ⟨hres, -, -, -, hcur, -⟩ := rootData_path hsd hrd
  refine ⟨hres, ?_⟩
  obtain ⟨hcol, hlen⟩ := litCap_colAt_self hup
  have hq : (actualKeys (litCap B c k ρ) c).take k =
      (queryKeys ⟨colDepth c, c, c.num 0, ρ, ((B.colAt c).getD []).take k⟩).map (↑) := by
    simp only [actualKeys, hcol, queryKeys, Option.getD_some, List.map_append, List.map_map]
    rw [List.take_left' (by rw [List.length_map, hlen])]
    rfl
  have hkeys : actualKeys (litCap B c k ρ) rd.col = (rootKeys (litCap B c k ρ) rd).map (↑) := by
    simp only [actualKeys, rootKeys, List.map_map]
    rfl
  have hc : cursor (actualKeys (litCap B c k ρ) rd.col) (cutQuery (actualKeys (litCap B c k ρ) c) k) =
      rd.cursor := by
    unfold cutQuery
    rw [cursor_nu, hq, hkeys, cursor_map WithTop.coe_strictMono, hcur]
  unfold unconsumed rootCol resp
  rw [hc, List.head?_drop]

-- T3.8lo (txt:556-560): at a previous-phase root the actual response is a parent `≥ r`
theorem prev_root_response (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat}
    (hi : 1 ≤ i ∧ i ≤ S.n) (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hend : capPos S.B c k < mu S.B) (hρ1 : S.sd.r < ρ)
    (hρ2 : ρ < S.s (phaseOff S.sd i a))
    {rdN : RootData} (hN : rootData (litCap S.B c k ρ) = some rdN) :
    ∃ u us, unconsumed (litCap S.B c k ρ) rdN = u :: us ∧ S.sd.r ≤ u.1 := by
  have hV : CondV (litCap S.B c k ρ) := hKL.1
  obtain ⟨_, hP1, hP2⟩ := phase_exit S hi ha hq hc hup hKL hρ1 hρ2
  -- `φ ≥ 1`, since `r < ρ < s_φ = r + φ d`
  have hφ1 : 1 ≤ phaseOff S.sd i a := by
    rcases Nat.eq_zero_or_pos (phaseOff S.sd i a) with h0 | h0
    · exfalso
      simp only [OrdStep.s, h0, Nat.zero_mul, Nat.add_zero] at hρ2
      omega
    · exact h0
  -- step 1: the edge out of `s_φ` goes to a parent `≥ ρ > r`, so `s_φ` is low
  obtain ⟨w, hw, hρw⟩ : ∃ w, Edge (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c
      (S.capQ c k ρ) (S.s (phaseOff S.sd i a)) w ∧ ρ ≤ w := by
    rcases Relation.ReflTransGen.cases_head hP2 with h | ⟨w, hw, hwρ⟩
    · omega
    · exact ⟨w, hw, path_le hV hwρ⟩
  have hlowφ := low_of_head_edge S hi ha hq hc hup ⟨hφ1, le_rfl⟩ hw (by omega)
  -- step 2: `V = κ_φ W`, `W = W₀` read in `WithTop Key`, and every head is low
  have hVeq := capQ_eq_kappaQ S hi ha hq hc hup hend
  set W₀ : List Key := cutQuery (((S.A.colAt a).getD []).map fun x => relKey (a.num 0) x.2) k
    with hW₀
  have hWW₀ : cutQuery (actualKeys S.A a) k = W₀.map (↑) := by
    rw [hW₀, ← cutQuery_map WithTop.coe_strictMono, List.map_map]
    rfl
  rw [hWW₀] at hVeq
  rw [hVeq] at hlowφ
  have hall := fun h (hh : 1 ≤ h ∧ h ≤ phaseOff S.sd i a) => low_all_heads S hφ1 W₀ hlowφ hh
  have hWn : Noninc (W₀.map ((↑) : Key → WithTop Key)) := hWW₀ ▸ cutQuery_noninc _ _
  -- steps 3, 4: descend through the heads `s_φ, …, s_1` along the detours
  have hdesc : ∀ j, j ≤ phaseOff S.sd i a →
      Path (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c (S.capQ c k ρ)
          (cutStart (litCap S.B c k ρ) c k) (S.s (phaseOff S.sd i a - j)) ∧
        Path (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c (S.capQ c k ρ)
          (S.s (phaseOff S.sd i a)) (S.s (phaseOff S.sd i a - j)) := by
    intro j
    induction j with
    | zero => intro _; exact ⟨hP1, Relation.ReflTransGen.refl⟩
    | succ j ih =>
      intro hj
      obtain ⟨h1, h2⟩ := ih (by omega)
      have hh : 1 ≤ phaseOff S.sd i a - j ∧ phaseOff S.sd i a - j ≤ phaseOff S.sd i a := by omega
      have hsum : phaseOff S.sd i a - j - 1 + (phaseOff S.sd i a - (phaseOff S.sd i a - j) + 1) =
          phaseOff S.sd i a := by omega
      have hVh : S.capQ c k ρ = kappaQ S.sd.r S.d (phaseOff S.sd i a - j - 1)
          (kappaQ S.sd.r S.d (phaseOff S.sd i a - (phaseOff S.sd i a - j) + 1)
            (W₀.map (↑))) := by
        rw [kappaQ_add, hsum, hVeq]
      have hlowh : kappaQ S.sd.r S.d (phaseOff S.sd i a - (phaseOff S.sd i a - j) + 1)
          (W₀.map (↑)) < S.termZ := by
        rw [← kappaQ_lt_iff S.sd.r S.d (phaseOff S.sd i a - j - 1), kappaQ_add, hsum]
        exact hall _ hh
      have hstep := low_head_detour S hi ha hq hc hup hKL hh (kappaQ_noninc _ _ _ hWn) hVh hlowh h1
      have heq : phaseOff S.sd i a - j - 1 = phaseOff S.sd i a - (j + 1) := by omega
      rw [heq] at hstep
      exact ⟨h1.trans hstep, h2.trans hstep⟩
  have hφr := (hdesc _ le_rfl).2
  have hs0 : S.s (phaseOff S.sd i a - phaseOff S.sd i a) = S.sd.r := by
    simp [OrdStep.s]
  rw [hs0] at hφr
  -- step 5: paths are orbits, so `ρ` reaches `r`; its edge goes to a vertex `≥ r`
  have hρr := path_functional hV hP2 hφr hρ1.le
  obtain ⟨u₁, he, hu₁⟩ : ∃ u₁, Edge (litCap S.B c k ρ) (actualKeys (litCap S.B c k ρ)) c
      (S.capQ c k ρ) ρ u₁ ∧ S.sd.r ≤ u₁ := by
    rcases Relation.ReflTransGen.cases_head hρr with h | ⟨u₁, hu, hur⟩
    · omega
    · exact ⟨u₁, hu, path_le hV hur⟩
  -- step 6: that edge is the first unconsumed root entry
  obtain ⟨o, ho, hresp⟩ := he
  obtain ⟨hres, hhead⟩ := unconsumed_litCap hup hN
  rw [ho] at hres
  cases hres
  have hhead' : (unconsumed (litCap S.B c k ρ) rdN).head?.map Prod.fst = some u₁ :=
    hhead.trans hresp
  cases hU : unconsumed (litCap S.B c k ρ) rdN with
  | nil => rw [hU] at hhead'; simp at hhead'
  | cons u us =>
    rw [hU] at hhead'
    simp only [List.head?_cons, Option.map_some, Option.some.injEq] at hhead'
    exact ⟨u, us, rfl, hhead' ▸ hu₁⟩

-- T3.8lp (txt:553-561): previous-phase root `r < ρ < s_φ`: the root response is `≥ r`, the next
-- target parent is `< r`, so the kernel wins at once
theorem root_prev (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hend : capPos S.B c k < mu S.B)
    (hρ1 : S.sd.r < ρ) (hρ2 : ρ < S.s (phaseOff S.sd i a)) :
    Success (litCap S.B c k ρ) (localSuffix S.B c) := by
  have hsd := stopData_litCap hup
  have hBI : CondI S.B := condI_ord S.inL S.kind S.out
  have hord := litCap_ordinary hBI hup hKL.1 hKL.2.1
  obtain ⟨rd, hrd⟩ := Option.isSome_iff_exists.mp (rootData_of_ordinary hord)
  obtain ⟨u, us, hU, hru⟩ := prev_root_response S hi ha hq hc hup hKL hend hρ1 hρ2 hrd
  -- the target suffix: the cut query, then the rest of `c`'s column
  obtain ⟨colB, hcolB⟩ : ∃ col, S.B.colAt c = some col := by
    unfold IsUpward at hup
    cases h : S.B.colAt c with
    | none => rw [h] at hup; exact hup.elim
    | some col => exact ⟨col, rfl⟩
  obtain ⟨F, hF, hFc⟩ : ∃ F, S.B.forestAt c.path = some F ∧ F.cols[c.col]? = some colB := by
    unfold Tree.colAt at hcolB
    cases h : S.B.forestAt c.path with
    | none => rw [h] at hcolB; cases hcolB
    | some F => rw [h] at hcolB; exact ⟨F, rfl, hcolB⟩
  have hY : localSuffix S.B c =
      .node ((((S.B.colAt c).getD []).take k ++ colB.drop k) :: F.cols.drop (c.col + 1)) := by
    unfold localSuffix
    rw [hF, Option.getD_some, hcolB, Option.getD_some, List.take_append_drop,
      List.drop_eq_getElem_cons (List.getElem?_eq_some_iff.mp hFc).1]
    congr 2
    exact (List.getElem?_eq_some_iff.mp hFc).2
  refine success_of_first hsd hrd (fun _ => by rw [hU]; exact List.cons_ne_nil _ _) hY hU ?_
  intro x hx
  rw [List.head?_drop] at hx
  have hx' : colB[k]? = some x := hx
  have hxmem : x ∈ (S.B.colAt c).getD [] := by
    rw [hcolB, Option.getD_some]
    exact List.mem_of_getElem? hx'
  have hxρ : x.1 < ρ := by
    unfold IsUpward at hup
    rw [hcolB] at hup
    simp only [hx'] at hup
    exact hup
  rcases phase_parent_dichotomy S hi ha hc hxmem with h | h
  · omega
  · omega

-- T3.8lq (`root_fixed_cursor`), T3.8lr (`closed_side`) and T3.8ls (`direct_body`) moved below
-- T3.8li (`projection`), to the G-010 (D7) section (brief rule 5: the proof of T3.8lq uses it).

/-! ## G-010 (D7) — the projection to an old cap (T3.8li) and the old terminal cap (T3.8lb)

From `blueprint/repairs/G-010.md` and `blueprint/repairs/lean/G010.lean`; names carry the branch
suffix `_D7`, and the statements are specialized to an ordinary step `S : OrdStep`. The draft's
`kappaQ` (D-G010.2) is the G-009 `kappaQ` above, its `phaseProj` is `OrdStep.proj` and its
complete query `Z` is `OrdStep.termZ`. -/

/-- D-G010.1 (txt:531-541, "cap all strict active ancestors"): the key system of `E` capped at
the active containers of `c`: in a column `o` whose entry `e` contains `c`, key `e.idx` becomes `⊤`
and the later keys are dropped; every other column keeps its actual keys. -/
def activeKeys_D7 (E : Forest) (c : ColAddr) : KeySys := fun o =>
  match o.container c with
  | some e => (actualKeys E o).take e.idx ++ [⊤]
  | none => actualKeys E o

/-- D-G010.3: `(a, c, φ)` is a phase pair of layer `j`: a template column with its phase copy
(`φ = phaseOff j a`), or the stopping column with the head of layer `j` (`φ = j − 1`). -/
def PhasePair_D7 (S : OrdStep) (j : Nat) (a c : ColAddr) (φ : Nat) : Prop :=
  (IsTmplCol S.A S.sd S.rd a ∧ phaseCol S.sd S.rd j a = some c ∧ φ = phaseOff S.sd j a) ∨
    (a = S.sd.col ∧ phaseCol S.sd S.rd j S.rd.col = some c ∧ φ = j - 1)

/-! ### Generic facts about literal caps -/

-- L-G010.21b (D7): cut queries of actual keys are `⊤`-free
theorem ne_top_of_mem_cutQuery_D7 (E : Forest) (o : ColAddr) (k : Nat) :
    ∀ w ∈ cutQuery (actualKeys E o) k, w ≠ ⊤ := by
  intro w hw
  have h1 := (nu_sublist _).subset hw
  have h2 := List.mem_of_mem_take h1
  simp only [actualKeys, List.mem_map] at h2
  obtain ⟨x, -, rfl⟩ := h2
  exact WithTop.coe_ne_top

-- D7: upwardness in terms of parents
theorem isUpward_iff_parents_D7 {E : Forest} {c : ColAddr} {k p : Nat} :
    IsUpward E c k p ↔ c ∈ E.colAddrs ∧ k ≤ (parents E c).length ∧
      ∀ q, (parents E c)[k]? = some q → q < p := by
  unfold IsUpward
  rw [Tree.mem_colAddrs_iff]
  cases h : E.colAt c with
  | none => simp
  | some col =>
    simp only [Option.isSome_some, true_and, parents, h, Option.getD_some, List.length_map,
      List.getElem?_map]
    constructor
    · intro hu
      cases hk : col[k]? with
      | none =>
        rw [hk] at hu
        simp only at hu
        refine ⟨by omega, fun q hq => ?_⟩
        simp at hq
      | some x =>
        obtain ⟨q', H⟩ := x
        rw [hk] at hu
        simp only at hu
        refine ⟨(List.getElem?_eq_some_iff.mp hk).1.le, fun q hq => ?_⟩
        simp only [Option.map_some, Option.some.injEq] at hq
        omega
    · rintro ⟨hk, hq⟩
      cases hk' : col[k]? with
      | none =>
        simp only
        have := List.getElem?_eq_none_iff.mp hk'
        omega
      | some x =>
        obtain ⟨q', H⟩ := x
        simp only
        exact hq q' (by rw [hk']; rfl)

-- D7 (literal-cap helper): every column of a literal cap is the cap column (cut after `k` entries,
-- closed by `(p, ∅)`), a container of it (cut after its containing entry, whose height changes),
-- or an unchanged column of the capped expression
theorem litCapAux_colAt_any_D7 (k p : Nat) :
    ∀ (π : List (Nat × Nat)) (j : Nat) (F : Forest), (F.colAt ⟨π, j⟩).isSome →
      ∀ (o : ColAddr) (col : Column), (litCapAux k p π j F).colAt o = some col →
      (o = ⟨π, j⟩ ∧ col = ((F.colAt ⟨π, j⟩).getD []).take k ++ [(p, Tree.empty)]) ∨
      (∃ e, o.container ⟨π, j⟩ = some e ∧ ∃ colE h', F.colAt o = some colE ∧
          e.idx < colE.length ∧ col = colE.take e.idx ++ [((colE[e.idx]?.map Prod.fst).getD 0, h')]) ∨
      (o ≠ ⟨π, j⟩ ∧ o.container ⟨π, j⟩ = none ∧ F.colAt o = some col)
  | [], j, .node cols, hc, ⟨op, oc⟩, col, hK => by
    have hj : j < cols.length := by
      unfold Tree.colAt at hc
      simp only [Tree.forestAt, Option.bind_some, Tree.cols] at hc
      cases h : cols[j]? with
      | none => rw [h] at hc; cases hc
      | some _ => exact (List.getElem?_eq_some_iff.mp h).1
    have hFj : (Tree.node cols).colAt ⟨[], j⟩ = cols[j]? := rfl
    have hgd : cols.getD j [] = (cols[j]?).getD [] := by simp [List.getD_eq_getElem?_getD]
    have hK' : litCapAux k p [] j (.node cols) =
        .node (cols.take j ++ [((cols[j]?).getD []).take k ++ [(p, Tree.empty)]]) := by
      simp only [litCapAux, hgd]
    rw [hK'] at hK
    have hlt : (cols.take j).length = j := by rw [List.length_take]; omega
    cases op with
    | nil =>
      unfold Tree.colAt at hK
      simp only [Tree.forestAt, Option.bind_some, Tree.cols] at hK
      rcases Nat.lt_trichotomy oc j with h | rfl | h
      · rw [List.getElem?_append_left (by omega), List.getElem?_take_of_lt h] at hK
        exact Or.inr (Or.inr ⟨by simp; omega, container_nil_nil _ _, hK⟩)
      · rw [List.getElem?_append_right (by omega), hlt, Nat.sub_self] at hK
        simp only [List.getElem?_cons_zero, Option.some.injEq] at hK
        exact Or.inl ⟨rfl, by rw [hFj]; exact hK.symm⟩
      · rw [List.getElem?_eq_none (by simp; omega)] at hK
        cases hK
    | cons s rest' =>
      obtain ⟨c0, e0⟩ := s
      rw [colAt_cons] at hK
      have hthird : (Tree.node cols).colAt ⟨(c0, e0) :: rest', oc⟩ = some col →
          (⟨(c0, e0) :: rest', oc⟩ : ColAddr) ≠ ⟨[], j⟩ ∧
            (⟨(c0, e0) :: rest', oc⟩ : ColAddr).container ⟨[], j⟩ = none ∧
            (Tree.node cols).colAt ⟨(c0, e0) :: rest', oc⟩ = some col :=
        fun h => ⟨by simp, container_cons_nil _ _ _ _, h⟩
      rcases Nat.lt_trichotomy c0 j with h | rfl | h
      · rw [List.getElem?_append_left (by omega), List.getElem?_take_of_lt h] at hK
        exact Or.inr (Or.inr (hthird (by rw [colAt_cons]; exact hK)))
      · rw [List.getElem?_append_right (by omega), hlt, Nat.sub_self] at hK
        simp only [List.getElem?_cons_zero, Option.bind_some] at hK
        set colj := (cols[c0]?).getD [] with hcolj
        have hlt2 : (colj.take k).length = min k colj.length := by rw [List.length_take]
        rcases Nat.lt_or_ge e0 (colj.take k).length with h2 | h2
        · rw [List.getElem?_append_left h2, List.getElem?_take_of_lt (by rw [hlt2] at h2; omega)] at hK
          refine Or.inr (Or.inr (hthird ?_))
          rw [colAt_cons]
          have : cols[c0]? = some colj := by
            rw [hcolj, List.getElem?_eq_getElem hj]; rfl
          rw [this]
          exact hK
        · rcases Nat.eq_or_lt_of_le h2 with h3 | h3
          · rw [List.getElem?_append_right (le_of_eq h3), ← h3, Nat.sub_self] at hK
            simp only [List.getElem?_cons_zero, Option.bind_some] at hK
            cases rest' with
            | nil => simp [Tree.colAt, Tree.forestAt, Tree.empty, Tree.cols] at hK
            | cons t ts =>
              obtain ⟨a, b⟩ := t
              simp [Tree.colAt, Tree.forestAt, Tree.empty, Tree.cols] at hK
          · rw [List.getElem?_eq_none (by simp; omega)] at hK
            cases hK
      · rw [List.getElem?_eq_none (by simp; omega)] at hK
        cases hK
  | (ci, ei) :: rest, j, .node cols, hc, ⟨op, oc⟩, col, hK => by
    rw [colAt_cons] at hc
    obtain ⟨x, hx⟩ : ∃ x, (cols[ci]?).bind (·[ei]?) = some x := by
      cases h : (cols[ci]?).bind (·[ei]?) with
      | none => rw [h] at hc; cases hc
      | some x => exact ⟨x, rfl⟩
    obtain ⟨q, h⟩ := x
    rw [hx] at hc
    simp only [Option.bind_some] at hc
    obtain ⟨colci, hcolci, hei⟩ : ∃ colci, cols[ci]? = some colci ∧ colci[ei]? = some (q, h) := by
      cases h1 : cols[ci]? with
      | none => rw [h1] at hx; cases hx
      | some colci => rw [h1] at hx; exact ⟨colci, rfl, hx⟩
    have hci : ci < cols.length := (List.getElem?_eq_some_iff.mp hcolci).1
    have heil : ei < colci.length := (List.getElem?_eq_some_iff.mp hei).1
    have hK' : litCapAux k p ((ci, ei) :: rest) j (Tree.node cols) =
        .node (cols.take ci ++ [colci.take ei ++ [(q, litCapAux k p rest j h)]]) := by
      simp only [litCapAux, List.getD_eq_getElem?_getD, hcolci, Option.getD_some, hei]
    rw [hK'] at hK
    have hlen1 : (cols.take ci).length = ci := by rw [List.length_take]; omega
    have hlen2 : (colci.take ei).length = ei := by rw [List.length_take]; omega
    have hFc : (Tree.node cols).colAt ⟨(ci, ei) :: rest, j⟩ = h.colAt ⟨rest, j⟩ := by
      rw [colAt_cons, hx]; rfl
    cases op with
    | nil =>
      unfold Tree.colAt at hK
      simp only [Tree.forestAt, Option.bind_some, Tree.cols] at hK
      rcases Nat.lt_trichotomy oc ci with h1 | rfl | h1
      · rw [List.getElem?_append_left (by omega), List.getElem?_take_of_lt h1] at hK
        refine Or.inr (Or.inr ⟨by simp, ?_, hK⟩)
        rw [container_nil_cons, if_neg (by omega)]
      · rw [List.getElem?_append_right (by omega), hlen1, Nat.sub_self] at hK
        simp only [List.getElem?_cons_zero, Option.some.injEq] at hK
        refine Or.inr (Or.inl ⟨⟨⟨[], oc⟩, ei⟩, by rw [container_nil_cons, if_pos rfl], colci,
          litCapAux k p rest j h, ?_, heil, ?_⟩)
        · show (Tree.node cols).colAt ⟨[], oc⟩ = some colci
          unfold Tree.colAt; simp [Tree.forestAt, Tree.cols, hcolci]
        · rw [← hK, hei]; rfl
      · rw [List.getElem?_eq_none (by simp; omega)] at hK
        cases hK
    | cons s rest' =>
      obtain ⟨c0, e0⟩ := s
      rw [colAt_cons] at hK
      rcases Nat.lt_trichotomy c0 ci with h1 | rfl | h1
      · rw [List.getElem?_append_left (by omega), List.getElem?_take_of_lt h1] at hK
        refine Or.inr (Or.inr ⟨by simp; omega, container_cons_ne _ _ _ _ _ _ (by simp; omega), ?_⟩)
        rw [colAt_cons]; exact hK
      · rw [List.getElem?_append_right (by omega), hlen1, Nat.sub_self] at hK
        simp only [List.getElem?_cons_zero, Option.bind_some] at hK
        rcases Nat.lt_trichotomy e0 ei with h2 | rfl | h2
        · rw [List.getElem?_append_left (by omega), List.getElem?_take_of_lt h2] at hK
          refine Or.inr (Or.inr ⟨by simp; omega, container_cons_ne _ _ _ _ _ _ (by simp; omega), ?_⟩)
          rw [colAt_cons, hcolci]; exact hK
        · rw [List.getElem?_append_right (by omega), hlen2, Nat.sub_self] at hK
          simp only [List.getElem?_cons_zero, Option.bind_some] at hK
          have hFo : (Tree.node cols).colAt ⟨(c0, e0) :: rest', oc⟩ = h.colAt ⟨rest', oc⟩ := by
            rw [colAt_cons, hx]; rfl
          rcases litCapAux_colAt_any_D7 k p rest j h hc ⟨rest', oc⟩ col hK with
            ⟨h3, h4⟩ | ⟨e', he', colE, h', hcolE, hlt, hcol⟩ | ⟨h3, h4, h5⟩
          · simp only [ColAddr.mk.injEq] at h3
            obtain ⟨rfl, rfl⟩ := h3
            exact Or.inl ⟨rfl, by rw [hFc]; exact h4⟩
          · refine Or.inr (Or.inl ⟨⟨⟨(c0, e0) :: rest', oc⟩, e'.idx⟩, ?_, colE, h',
              (by rw [hFo]; exact hcolE), hlt, hcol⟩)
            rw [container_cons, he']; rfl
          · refine Or.inr (Or.inr ⟨?_, ?_, by rw [hFo]; exact h5⟩)
            · intro h6
              simp only [ColAddr.mk.injEq, List.cons.injEq] at h6
              exact h3 (by simp [h6.1.2, h6.2])
            · rw [container_cons, h4]; rfl
        · rw [List.getElem?_eq_none (by simp; omega)] at hK
          cases hK
      · rw [List.getElem?_eq_none (by simp; omega)] at hK
        cases hK

-- D7 (literal-cap helper): `litCapAux_colAt_any_D7` for `litCap`
theorem litCap_colAt_any_D7 {E : Forest} {c : ColAddr} {k p : Nat} (hc : c ∈ E.colAddrs)
    {o : ColAddr} {col : Column} (hK : (litCap E c k p).colAt o = some col) :
    (o = c ∧ col = ((E.colAt c).getD []).take k ++ [(p, Tree.empty)]) ∨
      (∃ e, o.container c = some e ∧ ∃ colE h', E.colAt o = some colE ∧
          e.idx < colE.length ∧ col = colE.take e.idx ++ [((colE[e.idx]?.map Prod.fst).getD 0, h')]) ∨
      (o ≠ c ∧ o.container c = none ∧ E.colAt o = some col) := by
  have hcs : (E.colAt c).isSome := (Tree.mem_colAddrs_iff _ _).mp hc
  have hK' : litCap E c k p = litCapAux k p c.path c.col E := by
    show litCapBody E c k p = _
    unfold litCapBody
    rw [if_pos hcs]
  rw [hK'] at hK
  exact litCapAux_colAt_any_D7 k p c.path c.col E hcs o col hK

-- D7 (route helper): the containers of a route column are route columns
theorem container_mem_routeCols_D7 {E : Forest} {c o : ColAddr} {e : EntryAddr}
    (hc : c ∈ routeCols E) (he : o.container c = some e) : o ∈ routeCols E := by
  obtain ⟨hr, -, -, -⟩ := (Scan.mem_routeCols_iff E c).mp hc
  obtain ⟨hecol, t, ht⟩ := (ColAddr.container_spec _ _ _).mp he
  rw [EntryAddr.heightPath, hecol, List.append_assoc] at ht
  have hlt : o.path.length < c.path.length := by
    have := congrArg List.length ht; simp at this; omega
  refine (Scan.mem_routeCols_iff E o).mpr ⟨fun d hd => ?_, ?_⟩
  · obtain ⟨F, hF, hl⟩ := hr d (by omega)
    refine ⟨F, ?_, ?_⟩
    · rw [← ht, List.take_append_of_le_length (by omega)] at hF; exact hF
    · rw [hl, ← ht, List.getElem?_append_left hd]
  · obtain ⟨F, hF, hl⟩ := hr o.path.length hlt
    rw [← ht, List.take_left] at hF
    rw [← ht, List.getElem?_append_right le_rfl, Nat.sub_self] at hl
    obtain ⟨col, -, -, -, -, hs, -⟩ := Scan.lastStep?_eq_some hl
    simp only [List.cons_append, List.getElem?_cons_zero] at hl
    simp only [Prod.mk.injEq] at hs
    refine ⟨F, hF, ?_⟩
    have : F.cols ≠ [] := by
      intro h0
      simp [Tree.lastStep?, h0] at hl
    have := List.length_pos_of_ne_nil this
    omega

-- L-G010.21a (D7): a `⊤`-free query never passes a source key `⊤`
theorem cursor_append_top_D7 :
    ∀ (W : List (WithTop Key)) (l : List (WithTop Key)), (∀ w ∈ W, w ≠ ⊤) →
      cursor (l ++ [⊤]) W ≤ l.length
  | [], l, _ => by cases l <;> simp [cursor]
  | y :: ys, l, hT => by
    have hy : y < ⊤ := lt_top_iff_ne_top.mpr (hT y (by simp))
    have hys : ∀ w ∈ ys, w ≠ ⊤ := fun w hw => hT w (by simp [hw])
    induction l with
    | nil =>
      rw [List.nil_append, cursor, if_neg (not_lt.mpr hy.le), if_neg (ne_of_gt hy)]
      exact cursor_append_top_D7 ys [] hys
    | cons x xs ih =>
      rw [List.cons_append, cursor]
      split_ifs with h1 h2
      · simp only [List.length_cons]; omega
      · have := cursor_append_top_D7 ys xs hys
        simp only [List.length_cons]; omega
      · have := cursor_append_top_D7 ys (x :: xs) hys
        simpa using this

-- D7 (helper): the column of `E` under a height lies in that entry's height
theorem entry_of_heightCol_D7 {E : Forest} {e : EntryAddr} {j : Nat} {col : Column}
    (h : E.colAt ⟨e.heightPath, j⟩ = some col) :
    ∃ q H, E.entryAt e = some (q, H) ∧ H.cols[j]? = some col := by
  unfold Tree.colAt at h
  rw [Tree.forestAt_heightPath] at h
  unfold Tree.heightAt at h
  cases he : E.entryAt e with
  | none => rw [he] at h; cases h
  | some x =>
    rw [he] at h
    exact ⟨x.1, x.2, rfl, h⟩

-- D7 (helper): I of `E` for a column under a height
theorem condI_col_D7 {E : Forest} (hI : CondI E) {e : EntryAddr} {j : Nat} {col : Column}
    (h : E.colAt ⟨e.heightPath, j⟩ = some col) :
    ∃ q H rest, col = (q, H) :: rest ∧ e.col.num 0 ≤ q := by
  obtain ⟨q, H, he, hj⟩ := entry_of_heightCol_D7 h
  have hmem : e ∈ E.entryAddrs := by rw [Tree.mem_entryAddrs_iff, he]; rfl
  have hne : H ≠ Tree.empty := by
    intro h0; rw [h0] at hj; simp [Tree.empty, Tree.cols] at hj
  exact hI e hmem q H he hne col (List.mem_of_getElem? hj)

-- T3.8li step 3 (D7, generic): V of a literal cap whose closing parent is visible
theorem condV_litCap_D7 {E : Forest} (hV : CondV E) {c : ColAddr} {k p : Nat}
    (hc : c ∈ E.colAddrs) (hk : k ≤ (parents E c).length) (hp : p < c.num 0) :
    CondV (litCap E c k p) := by
  rw [condV_iff_lt] at hV ⊢
  intro e _ q h hent
  have hent' := hent
  unfold Tree.entryAt at hent
  obtain ⟨col, hcol, hidx⟩ : ∃ col, (litCap E c k p).colAt e.col = some col ∧ col[e.idx]? = some (q, h) := by
    cases h1 : (litCap E c k p).colAt e.col with
    | none => rw [h1] at hent; cases hent
    | some col => rw [h1] at hent; exact ⟨col, rfl, hent⟩
  -- an entry of `E` at `e.col` with parent `q`
  have hE : ∀ colE H', E.colAt e.col = some colE → colE[e.idx]? = some (q, H') → q < e.col.num 0 :=
    fun colE H' h1 h2 => hV e (by rw [Tree.mem_entryAddrs_iff]; simp [Tree.entryAt, h1, h2]) q H'
      (by simp [Tree.entryAt, h1, h2])
  rcases litCap_colAt_any_D7 hc hcol with ⟨rfl, hcl⟩ | ⟨e', he', colE, h', hcolE, hlt, hcl⟩ |
      ⟨-, -, hcolE⟩
  · subst hcl
    obtain ⟨colE, hcolE⟩ := Option.isSome_iff_exists.mp ((Tree.mem_colAddrs_iff _ _).mp hc)
    rw [hcolE, Option.getD_some] at hidx
    rcases Nat.lt_or_ge e.idx (colE.take k).length with h1 | h1
    · rw [List.getElem?_append_left h1, List.getElem?_take_of_lt (by simp at h1; omega)] at hidx
      exact hE colE h hcolE hidx
    · have hlen : (colE.take k).length = k := by
        simp [parents, hcolE] at hk; simp; omega
      rcases Nat.eq_or_lt_of_le h1 with h2 | h2
      · rw [List.getElem?_append_right (le_of_eq h2), ← h2, Nat.sub_self] at hidx
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hidx
        rw [← hidx.1]; exact hp
      · rw [List.getElem?_eq_none (by simp at h2 ⊢; omega)] at hidx; cases hidx
  · subst hcl
    have hlen : (colE.take e'.idx).length = e'.idx := by simp; omega
    rcases Nat.lt_or_ge e.idx e'.idx with h1 | h1
    · rw [List.getElem?_append_left (by omega), List.getElem?_take_of_lt h1] at hidx
      exact hE colE h hcolE hidx
    · rcases Nat.eq_or_lt_of_le h1 with h2 | h2
      · rw [List.getElem?_append_right (by omega), hlen, ← h2, Nat.sub_self] at hidx
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hidx
        have hq : q = (colE[e'.idx]'hlt).1 := by
          rw [← hidx.1, List.getElem?_eq_getElem hlt]; rfl
        exact hE colE (colE[e'.idx]'hlt).2 hcolE (by rw [← h2, List.getElem?_eq_getElem hlt, hq])
      · rw [List.getElem?_eq_none (by simp; omega)] at hidx; cases hidx
  · exact hE col h hcolE hidx

-- T3.8li step 4 (D7, generic): I of a literal cap; the only new I-constraint is a column-start
-- cap (`k = 0`) inside a height, whose closing parent must be at least the host
theorem condI_litCap_D7 {E : Forest} (hI : CondI E) {c : ColAddr} {k p : Nat}
    (hc : c ∈ E.colAddrs) (hk : k ≤ (parents E c).length)
    (hp : k = 0 → ∀ π ci ei, c.path = π ++ [(ci, ei)] → (⟨π, ci⟩ : ColAddr).num 0 ≤ p) :
    CondI (litCap E c k p) := by
  intro e _ q h hent _ col hcol
  obtain ⟨j, hj⟩ := List.mem_iff_getElem?.mp hcol
  have hKcol : (litCap E c k p).colAt ⟨e.heightPath, j⟩ = some col := by
    unfold Tree.colAt; rw [Tree.forestAt_heightPath]; unfold Tree.heightAt; rw [hent]; exact hj
  rcases litCap_colAt_any_D7 hc hKcol with ⟨hoc, hcl⟩ | ⟨e', he', colE, h', hcolE, hlt, hcl⟩ |
      ⟨-, -, hcolE⟩
  · obtain ⟨colE, hcolE⟩ := Option.isSome_iff_exists.mp ((Tree.mem_colAddrs_iff _ _).mp hc)
    rw [hcolE, Option.getD_some] at hcl
    have hcolE' : E.colAt ⟨e.heightPath, j⟩ = some colE := by rw [hoc]; exact hcolE
    obtain ⟨q0, H0, rest0, hq0, hnum⟩ := condI_col_D7 hI hcolE'
    subst hcl hq0
    cases k with
    | zero =>
      refine ⟨p, Tree.empty, [], by simp, hp rfl e.col.path e.col.col e.idx ?_⟩
      rw [← hoc]; rfl
    | succ k => exact ⟨q0, H0, rest0.take k ++ [(p, Tree.empty)], by simp, hnum⟩
  · obtain ⟨q0, H0, rest0, hq0, hnum⟩ := condI_col_D7 hI hcolE
    subst hcl hq0
    rcases Nat.eq_zero_or_pos e'.idx with h0 | h0
    · exact ⟨q0, h', [], by simp [h0], hnum⟩
    · obtain ⟨v, hv⟩ : ∃ v, e'.idx = v + 1 := ⟨e'.idx - 1, by omega⟩
      exact ⟨q0, H0, rest0.take v ++ [((((q0, H0) :: rest0)[e'.idx]?.map Prod.fst).getD 0, h')],
        by rw [hv]; simp, hnum⟩
  · exact condI_col_D7 hI hcolE

-- L-G010.1 (D7, bridge, edge form): on the stack of the cap column, the decorated system of an
-- upward literal cap is `activeKeys` of the capped expression (every `⊤`-free query)
theorem respEdge_litCap_activeKeys_D7 {E : Forest} {c : ColAddr} {k p : Nat}
    (hup : IsUpward E c k p) {W : List (WithTop Key)} (hT : ∀ w ∈ W, w ≠ ⊤) (x : Nat) :
    respEdge (litCap E c k p) (capKeys (litCap E c k p) (routeCols (litCap E c k p))) c W x =
      respEdge E (activeKeys_D7 E c) c W x := by
  have hc := mem_colAddrs_of_upward hup
  have hcK : c ∈ routeCols (litCap E c k p) := (stopData_spec (stopData_litCap hup)).2.2.2.1
  have hcKm := Scan.mem_colAddrs_of_mem_routeCols hcK
  unfold respEdge
  cases hres : c.resolve 0 x with
  | none => rfl
  | some o =>
    simp only [Option.bind_some]
    have ho : c.OnStack o := ((ColAddr.resolve_spec 0 _ _ _).mp hres).1
    obtain ⟨h1, h2⟩ := colAt_litCap_onStack (k := k) (p := p) hc ho
    rw [resp_eq_parents, resp_eq_parents]
    cases hce : o.container c with
    | none =>
      have hKo := h2 hce
      have hnr : o ∉ routeCols (litCap E c k p) := by
        intro hr
        obtain ⟨v, -, hv⟩ := routeCols_visible hcKm hr hres
        have := (ColAddr.container_spec o c ⟨o, v⟩).mpr ⟨rfl, hv⟩
        rw [hce] at this; cases this
      have hks : capKeys (litCap E c k p) (routeCols (litCap E c k p)) o = activeKeys_D7 E c o := by
        rw [capKeys_of_not_mem hnr]
        simp only [activeKeys_D7, hce, actualKeys, hKo]
      rw [hks]
      simp only [parents, hKo]
    | some e =>
      obtain ⟨hpar, hkeys⟩ := h1 e hce
      have hroute := container_mem_routeCols_D7 hcK hce
      obtain ⟨hecol, hecont⟩ := (ColAddr.container_spec _ _ _).mp hce
      have hemem := mem_entryAddrs_of_contains hc hecont
      have helt : e.idx < (parents E o).length := by
        have h1 : (E.entryAt e).isSome := (Tree.mem_entryAddrs_iff _ _).mp hemem
        have h2 : (parents E o)[e.idx]? = (E.entryAt ⟨o, e.idx⟩).map Prod.fst :=
          parents_getElem? E o e.idx
        have h3 : (⟨o, e.idx⟩ : EntryAddr) = e := by rw [← hecol]
        rw [h3] at h2
        obtain ⟨x, hx⟩ := Option.isSome_iff_exists.mp h1
        rw [hx] at h2
        exact (List.getElem?_eq_some_iff.mp h2).1
      have hlenK : (actualKeys (litCap E c k p) o).length = e.idx + 1 := by
        rw [length_actualKeys, ← List.length_map (f := Prod.fst)]
        show (parents _ _).length = _
        rw [hpar, List.length_take]; omega
      have hks : capKeys (litCap E c k p) (routeCols (litCap E c k p)) o = activeKeys_D7 E c o := by
        have hne : actualKeys (litCap E c k p) o ≠ [] := by
          intro h0; rw [h0] at hlenK; simp at hlenK
        obtain ⟨y, hy⟩ := Option.ne_none_iff_exists'.mp (mt List.getLast?_eq_none_iff.mp hne)
        simp only [capKeys, if_pos hroute, hy, Option.map_some, Option.toList_some, activeKeys_D7, hce]
        rw [List.dropLast_eq_take, hlenK, Nat.add_sub_cancel, hkeys]
      rw [hks]
      have hcur : cursor (activeKeys_D7 E c o) W ≤ e.idx := by
        simp only [activeKeys_D7, hce]
        have := cursor_append_top_D7 W ((actualKeys E o).take e.idx) hT
        rw [List.length_take, length_actualKeys] at this
        omega
      rw [hpar, List.getElem?_take_of_lt (by omega)]

-- L-G010.1 (D7, bridge, path form)
theorem path_litCap_activeKeys_D7 {E : Forest} {c : ColAddr} {k p : Nat} (hup : IsUpward E c k p)
    {W : List (WithTop Key)} (hT : ∀ w ∈ W, w ≠ ⊤) (x y : Nat) :
    Path (litCap E c k p) (capKeys (litCap E c k p) (routeCols (litCap E c k p))) c W x y ↔
      Path E (activeKeys_D7 E c) c W x y := by
  have h : ∀ a b, Edge (litCap E c k p) (capKeys (litCap E c k p) (routeCols (litCap E c k p))) c W a b ↔
      Edge E (activeKeys_D7 E c) c W a b := fun a b => by
    rw [edge_iff, edge_iff, respEdge_litCap_activeKeys_D7 hup hT]
  unfold Path
  exact ⟨fun hp => Relation.ReflTransGen.mono (fun a b => (h a b).mp) x y hp,
    fun hp => Relation.ReflTransGen.mono (fun a b => (h a b).mpr) x y hp⟩

-- L-G010.19/20 steps 2 and 6 (D7): the final test of an upward literal cap, read in `E`
theorem aAt_litCap_final_D7 {E : Forest} {c : ColAddr} {k p : Nat} (hup : IsUpward E c k p) :
    AAt (litCap E c k p) (capKeys (litCap E c k p) (routeCols (litCap E c k p))) c k ↔
      Path E (activeKeys_D7 E c) c (cutQuery (actualKeys E c) k) (cutStart E c k) p := by
  obtain ⟨hcol, hlen⟩ := litCap_colAt_self hup
  have hkle : k ≤ ((E.colAt c).getD []).length := by
    have := hlen; rw [List.length_take] at this; omega
  have hparK : parents (litCap E c k p) c =
      (((E.colAt c).getD []).take k).map Prod.fst ++ [p] := by
    simp [parents, hcol]
  have hpk : (parents (litCap E c k p) c)[k]? = some p := by
    rw [hparK, List.getElem?_append_right (by simp), List.length_map, hlen, Nat.sub_self]
    rfl
  have hQ : cutQuery (capKeys (litCap E c k p) (routeCols (litCap E c k p)) c) k =
      cutQuery (actualKeys E c) k := by
    rw [cutQuery_capKeys _ _ c (by rw [hcol]; simp only [Option.getD_some, List.length_append,
      hlen, List.length_singleton]; omega)]
    unfold cutQuery
    congr 1
    simp only [actualKeys, hcol, Option.getD_some, List.map_append]
    rw [List.take_left' (by simp only [List.length_map]; exact hlen), List.map_take]
  have hS : cutStart (litCap E c k p) c k = cutStart E c k := by
    unfold cutStart
    split_ifs with h0
    · rfl
    · rw [hparK, List.getElem?_append_left (by simp; omega), List.getElem?_map,
        List.getElem?_take_of_lt (by omega)]
      simp [parents, List.getElem?_map]
  have hT := ne_top_of_mem_cutQuery_D7 E c k
  constructor
  · intro hA
    have := hA p hpk
    rw [hQ, hS] at this
    exact (path_litCap_activeKeys_D7 hup hT _ _).mp this
  · intro hP p' hp'
    rw [hpk] at hp'
    cases hp'
    rw [hQ, hS]
    exact (path_litCap_activeKeys_D7 hup hT _ _).mpr hP

-- D7 (helper): nothing lies inside the closing entry `(p, ∅)` of a literal cap
theorem not_contains_closing_D7 {E : Forest} {c : ColAddr} {k p : Nat} (hup : IsUpward E c k p)
    {c' : ColAddr} (hc' : c' ∈ (litCap E c k p).colAddrs) :
    ¬ (⟨c, k⟩ : EntryAddr).Contains c' := by
  rintro ⟨t, ht⟩
  obtain ⟨hcol, hlen⟩ := litCap_colAt_self hup
  have hent : (litCap E c k p).heightAt ⟨c, k⟩ = some Tree.empty := by
    simp only [Tree.heightAt, Tree.entryAt, hcol, Option.bind_some]
    rw [List.getElem?_append_right (by omega), hlen, Nat.sub_self]
    rfl
  rw [Tree.mem_colAddrs_iff] at hc'
  unfold Tree.colAt at hc'
  rw [← ht, Tree.forestAt_append, Tree.forestAt_heightPath, hent] at hc'
  cases t with
  | nil => simp [Tree.forestAt, Tree.empty, Tree.cols] at hc'
  | cons s t =>
    obtain ⟨a, b⟩ := s
    simp [Tree.forestAt, Tree.empty, Tree.cols] at hc'

-- T3.8li step 5, retained tests (D7, generic; L2.3 barrier and L2.4b capping): every A-test of
-- an upward literal cap of an `L`-expression other than its final test holds in the cap's
-- decorated system
theorem litCap_retained_D7 {E : Forest} (hL : InL E) {c : ColAddr} {k p : Nat}
    (hup : IsUpward E c k p) {c' : ColAddr} (hc' : c' ∈ (litCap E c k p).colAddrs) {i : Nat}
    (hi : c' = c → i ≠ k) :
    AAt (litCap E c k p) (capKeys (litCap E c k p) (routeCols (litCap E c k p))) c' i := by
  obtain ⟨hV, -, -, hA, hS⟩ := hL
  have hc := mem_colAddrs_of_upward hup
  have hcK : c ∈ routeCols (litCap E c k p) := (stopData_spec (stopData_litCap hup)).2.2.2.1
  obtain ⟨hcolc, hlenc⟩ := litCap_colAt_self hup
  intro p' hp'
  obtain ⟨colK, hcolK⟩ := Option.isSome_iff_exists.mp ((Tree.mem_colAddrs_iff _ _).mp hc')
  have hilt : i < colK.length := by
    have := (List.getElem?_eq_some_iff.mp hp').1
    simpa [parents, hcolK] using this
  -- the column of `c'` agrees with that of `E` up to and including entry `i`
  obtain ⟨colE, hcolE, htake, hget⟩ : ∃ colE, E.colAt c' = some colE ∧ colK.take i = colE.take i ∧
      colK[i]?.map Prod.fst = colE[i]?.map Prod.fst := by
    rcases litCap_colAt_any_D7 hc hcolK with ⟨rfl, hcl⟩ | ⟨e', he', colE, h', hcolE, hlt, hcl⟩ |
        ⟨-, -, hcolE⟩
    · obtain ⟨colE, hcolE⟩ := Option.isSome_iff_exists.mp ((Tree.mem_colAddrs_iff _ _).mp hc)
      rw [hcolE, Option.getD_some] at hcl hlenc
      have hik : i < k := by
        have := hi rfl; subst hcl; simp at hilt; omega
      subst hcl
      refine ⟨colE, hcolE, ?_, ?_⟩
      · rw [List.take_append_of_le_length (by omega), List.take_take, Nat.min_eq_left hik.le]
      · rw [List.getElem?_append_left (by omega), List.getElem?_take_of_lt hik]
    · subst hcl
      have hlen2 : (colE.take e'.idx).length = e'.idx := by simp; omega
      have hiv : i ≤ e'.idx := by simp at hilt; omega
      refine ⟨colE, hcolE, ?_, ?_⟩
      · rw [List.take_append_of_le_length (by omega), List.take_take, Nat.min_eq_left hiv]
      · rcases Nat.eq_or_lt_of_le hiv with h1 | h1
        · rw [List.getElem?_append_right (by omega), hlen2, h1, Nat.sub_self,
            List.getElem?_eq_getElem hlt]
          simp
        · rw [List.getElem?_append_left (by omega), List.getElem?_take_of_lt h1]
    · exact ⟨colK, hcolE, rfl, rfl⟩
  have hc'E : c' ∈ E.colAddrs := by rw [Tree.mem_colAddrs_iff, hcolE]; rfl
  have hpE : (parents E c')[i]? = some p' := by
    have : (parents (litCap E c k p) c')[i]? = (colK[i]?).map Prod.fst := by
      simp [parents, hcolK, List.getElem?_map]
    rw [this, hget] at hp'
    simpa [parents, hcolE, List.getElem?_map] using hp'
  have hik : i ≤ (parents E c').length := (List.getElem?_eq_some_iff.mp hpE).1.le
  have hQ : cutQuery (capKeys (litCap E c k p) (routeCols (litCap E c k p)) c') i =
      cutQuery (actualKeys E c') i := by
    rw [cutQuery_capKeys _ _ c' (by rw [hcolK]; exact hilt)]
    unfold cutQuery
    congr 1
    simp only [actualKeys, hcolK, hcolE, Option.getD_some]
    rw [← List.map_take, ← List.map_take, htake]
  have hSt : cutStart (litCap E c k p) c' i = cutStart E c' i := by
    unfold cutStart
    split_ifs with h0
    · rfl
    · have e1 : (parents (litCap E c k p) c')[i - 1]? = ((colK.take i)[i - 1]?).map Prod.fst := by
        rw [List.getElem?_take_of_lt (by omega)]; simp [parents, hcolK, List.getElem?_map]
      have e2 : (parents E c')[i - 1]? = ((colE.take i)[i - 1]?).map Prod.fst := by
        rw [List.getElem?_take_of_lt (by omega)]; simp [parents, hcolE, List.getElem?_map]
      rw [e1, e2, htake]
  have hAE := hA c' hc'E i p' hpE
  set W := cutQuery (actualKeys E c') i with hW
  have hT := ne_top_of_mem_cutQuery_D7 E c' i
  have hWn : Noninc W := cutQuery_noninc _ _
  have hx : (if i = 0 then c'.num 0 - 1 else ((parents E c')[i - 1]?).getD 0) = cutStart E c' i := rfl
  rw [hx] at hAE
  rw [hQ, hSt]
  -- transfer the old cut path edge by edge
  suffices H : ∀ z, Path E (actualKeys E) c' W (cutStart E c' i) z →
      Path (litCap E c k p) (capKeys (litCap E c k p) (routeCols (litCap E c k p))) c' W
        (cutStart E c' i) z from H p' hAE
  intro z hz
  induction hz with
  | refl => exact Relation.ReflTransGen.refl
  | @tail b z' hxb hbz ih =>
    obtain ⟨o, ho, hresp⟩ := hbz
    refine ih.tail ⟨o, ho, ?_⟩
    have hos : c'.OnStack o := ((ColAddr.resolve_spec 0 _ _ _).mp ho).1
    have hoK : o ∈ (litCap E c k p).colAddrs := mem_colAddrs_of_onStack hc' hos
    have hbnum : o.num 0 = b := ColAddr.resolve_num ho
    have hbar : ∀ v', (⟨o, v'⟩ : EntryAddr) ∈ E.entryAddrs → (⟨o, v'⟩ : EntryAddr).Contains c' →
        cursor (actualKeys E o) W ≤ v' := by
      intro v' hv' hcont
      have hb := cut_barrier hV hA hS hv' hc'E hcont hik (by simp only; rw [hbnum]; exact hxb)
      rw [boundary_eq_cutQuery] at hb
      have hvl : v' < (actualKeys E o).length := by
        rw [length_actualKeys]; exact idx_lt_of_mem_entryAddrs hv'
      exact cursor_le_of_lt_cutQuery hWn hvl hb
    obtain ⟨colKo, hcolKo⟩ := Option.isSome_iff_exists.mp ((Tree.mem_colAddrs_iff _ _).mp hoK)
    rw [resp_eq_parents] at hresp ⊢
    rcases litCap_colAt_any_D7 hc hcolKo with ⟨hoc, hcl⟩ | ⟨e', he', colEo, h', hcolEo, hlt, hcl⟩ |
        ⟨-, -, hcolEo⟩
    · -- the cap column contains `c'` through an entry before the closing one
      rw [hoc] at ho hcolKo hresp hbar ⊢
      obtain ⟨v, hvK, hvc⟩ := routeCols_visible hc' hcK ho
      have hvk : v < k := by
        have h1 := idx_lt_of_mem_entryAddrs hvK
        rw [hcolc] at h1
        simp only [Option.getD_some, List.length_append, hlenc, List.length_singleton] at h1
        rcases Nat.lt_or_ge v k with h2 | h2
        · exact h2
        · exfalso
          have : v = k := by omega
          subst this
          exact not_contains_closing_D7 hup hc' hvc
      obtain ⟨colEc, hcolEc⟩ := Option.isSome_iff_exists.mp ((Tree.mem_colAddrs_iff _ _).mp hc)
      have hvE : (⟨c, v⟩ : EntryAddr) ∈ E.entryAddrs := mem_entryAddrs_of_contains hc'E hvc
      have hcE := hbar v hvE hvc
      have hks : capKeys (litCap E c k p) (routeCols (litCap E c k p)) c =
          (actualKeys E c).take k ++ [⊤] := by
        simp only [capKeys, if_pos hcK, actualKeys, hcolc, hcolEc, Option.getD_some,
          List.map_append, List.map_cons, List.map_nil, List.dropLast_concat,
          List.getLast?_concat, Option.map_some, Option.toList_some, List.map_take]
      have hcur : cursor (capKeys (litCap E c k p) (routeCols (litCap E c k p)) c) W =
          cursor (actualKeys E c) W := by
        rw [hks]
        refine cursor_eq_of_take_eq (u := k) ?_ ?_ (by omega)
        · rw [List.take_left' (by simp [actualKeys, hcolEc]; rw [hcolEc] at hlenc; simp at hlenc; omega)]
        · have := cursor_append_top_D7 W ((actualKeys E c).take k) hT
          simp at this; omega
      rw [hcur]
      have hkE : k ≤ colEc.length := by
        have := hlenc; rw [hcolEc] at this; simp at this; omega
      rw [hcolEc, Option.getD_some] at hcolc
      have : (parents (litCap E c k p) c)[cursor (actualKeys E c) W]? =
          (parents E c)[cursor (actualKeys E c) W]? := by
        simp only [parents, hcolc, hcolEc, Option.getD_some, List.getElem?_map]
        rw [List.getElem?_append_left (by rw [List.length_take]; omega),
          List.getElem?_take_of_lt (by omega)]
      rw [this]; exact hresp
    · -- a container of the cap column
      have hroute := container_mem_routeCols_D7 hcK he'
      obtain ⟨v, hvK, hvc⟩ := routeCols_visible hc' hroute ho
      have hos' : c.OnStack o := onStack_of_container he'
      obtain ⟨h1, -⟩ := colAt_litCap_onStack (k := k) (p := p) hc hos'
      obtain ⟨hpar, hkeys⟩ := h1 e' he'
      have hvle : v ≤ e'.idx := by
        have := idx_lt_of_mem_entryAddrs hvK
        rw [hcolKo, hcl] at this
        simp at this; omega
      have hvE : (⟨o, v⟩ : EntryAddr) ∈ E.entryAddrs := mem_entryAddrs_of_contains hc'E hvc
      have hcE := hbar v hvE hvc
      have hlenK : (actualKeys (litCap E c k p) o).length = e'.idx + 1 := by
        rw [length_actualKeys, hcolKo, hcl]; simp; omega
      have hks : capKeys (litCap E c k p) (routeCols (litCap E c k p)) o =
          (actualKeys E o).take e'.idx ++ [⊤] := by
        have hne : actualKeys (litCap E c k p) o ≠ [] := by
          intro h0; rw [h0] at hlenK; simp at hlenK
        obtain ⟨y, hy⟩ := Option.ne_none_iff_exists'.mp (mt List.getLast?_eq_none_iff.mp hne)
        simp only [capKeys, if_pos hroute, hy, Option.map_some, Option.toList_some]
        rw [List.dropLast_eq_take, hlenK, Nat.add_sub_cancel, hkeys]
      have hcur : cursor (capKeys (litCap E c k p) (routeCols (litCap E c k p)) o) W =
          cursor (actualKeys E o) W := by
        rw [hks]
        refine cursor_eq_of_take_eq (u := e'.idx) ?_ ?_ (by omega)
        · rw [List.take_left' (by simp [actualKeys, hcolEo]; omega)]
        · have := cursor_append_top_D7 W ((actualKeys E o).take e'.idx) hT
          simp at this; omega
      rw [hcur, hpar, List.getElem?_take_of_lt (by omega)]
      exact hresp
    · -- an unchanged column
      have hkeq : actualKeys (litCap E c k p) o = actualKeys E o := by
        simp [actualKeys, hcolKo, hcolEo]
      have hpeq : parents (litCap E c k p) o = parents E o := by
        simp [parents, hcolKo, hcolEo]
      have hcap : cursor (capKeys (litCap E c k p) (routeCols (litCap E c k p)) o) W =
          cursor (actualKeys E o) W ∨
          (parents (litCap E c k p) o)[cursor (capKeys (litCap E c k p)
            (routeCols (litCap E c k p)) o) W]? = (parents E o)[cursor (actualKeys E o) W]? := by
        by_cases hor : o ∈ routeCols (litCap E c k p)
        · right
          obtain ⟨v, hvK, hvc⟩ := routeCols_visible hc' hor ho
          have hvE : (⟨o, v⟩ : EntryAddr) ∈ E.entryAddrs := by
            rw [Tree.mem_entryAddrs_iff] at hvK ⊢
            simpa [Tree.entryAt, hcolKo, hcolEo] using hvK
          have hcE := hbar v hvE hvc
          have hnx : cursor (actualKeys (litCap E c k p) o) W <
              (actualKeys (litCap E c k p) o).length := by
            rw [hkeq]
            have := idx_lt_of_mem_entryAddrs hvE
            simp only at this
            rw [length_actualKeys]; omega
          have := resp_capKeys (sel := routeCols (litCap E c k p)) hnx
          rw [resp_eq_parents, resp_eq_parents, hkeq, hpeq] at this
          rw [hpeq]; exact this
        · left; rw [capKeys_of_not_mem hor, hkeq]
      rcases hcap with h | h
      · rw [h, hpeq]; exact hresp
      · rw [h]; exact hresp

-- T3.8li step 5 (D7): decorated A of an upward literal cap of an `L`-expression is its final
-- test
theorem condAK_litCap_D7 {E : Forest} (hL : InL E) {c : ColAddr} {k p : Nat}
    (hup : IsUpward E c k p)
    (hfin : Path E (activeKeys_D7 E c) c (cutQuery (actualKeys E c) k) (cutStart E c k) p) :
    CondAK (litCap E c k p) (capKeys (litCap E c k p) (routeCols (litCap E c k p))) := by
  rw [condAK_iff]
  intro c' hc' i
  by_cases h : c' = c ∧ i = k
  · obtain ⟨rfl, rfl⟩ := h
    exact (aAt_litCap_final_D7 hup).mpr hfin
  · exact litCap_retained_D7 hL hup hc' fun h1 h2 => h ⟨h1, h2⟩

-- D7: the closing parent of an upward V cap is visible from the cap column
theorem lt_num_of_litCap_D7 {B : Forest} {c : ColAddr} {k ρ : Nat} (hup : IsUpward B c k ρ)
    (hV : CondV (litCap B c k ρ)) : ρ < c.num 0 := by
  obtain ⟨hcol, hlen⟩ := litCap_colAt_self hup
  have hent : (litCap B c k ρ).entryAt ⟨c, k⟩ = some (ρ, Tree.empty) := by
    simp only [Tree.entryAt, hcol, Option.bind_some]
    rw [List.getElem?_append_right (by omega), hlen, Nat.sub_self]
    rfl
  have hmem : (⟨c, k⟩ : EntryAddr) ∈ (litCap B c k ρ).entryAddrs := by
    rw [Tree.mem_entryAddrs_iff, hent]; rfl
  exact (condV_iff_lt _).mp hV _ hmem _ _ hent

/-! ### Phase pairs: numbers, parents, cut queries, cut starts -/

-- L-G010.17 (D7): the query part of a head is the phase-`(i−1)` copy of the old terminal's
theorem headQuery_prefix_D7 (S : OrdStep) {i : Nat} {c : ColAddr} (hi : 1 ≤ i ∧ i ≤ S.n)
    (hc : phaseCol S.sd S.rd i S.rd.col = some c) :
    S.m ≤ (parents S.B c).length ∧
      (parents S.B c).take S.m =
        ((parents S.A S.sd.col).take S.m).map (shiftVal S.sd.r ((i - 1) * S.d)) ∧
      (actualKeys S.B c).take S.m =
        kappaQ S.sd.r S.d (i - 1) ((actualKeys S.A S.sd.col).take S.m) := by
  obtain ⟨hcol, -, ht, -⟩ := stopData_spec S.hsd
  obtain ⟨-, -, -, hrnum, hrt, -⟩ := rootData_spec S.hsd S.hrd
  obtain ⟨col, hBcol, hlen, htake, -⟩ := colAt_head S.inL S.kind S.hsd S.hrd S.out hi hc
  have hm : S.sd.Q.length = S.m := rfl
  have hnum := num_phaseCol S.inL S.kind S.hsd S.hrd (Or.inl rfl) hi.1 hc
  rw [hrnum] at hnum
  simp only [phaseOff, isQMat_rdcol S, Bool.false_eq_true, if_false] at hnum
  have hBpar : parents S.B c = col.map Prod.fst := by simp [parents, hBcol]
  refine ⟨by rw [hBpar, List.length_map, hlen]; omega, ?_, ?_⟩
  · rw [hBpar, ← List.map_take, ← hm, htake, mapCol_eq_map]
    simp only [parents, hcol, Option.getD_some, List.map_append, List.map_map]
    rw [List.take_left' (by simp), List.map_map]
    rfl
  · simp only [actualKeys, hBcol, hcol, Option.getD_some, ← List.map_take, ← hm, htake,
      mapCol_eq_map, List.map_map, kappaQ]
    rw [List.take_left' (by simp)]
    congr 1
    funext y
    simp only [Function.comp_apply, WithTop.map_coe]
    rw [hnum, ← ht]
    have : S.sd.r + i * period S.sd = S.sd.t + (i - 1) * S.d := by
      simp only [OrdStep.d, period]
      have : i * (S.sd.t - S.sd.r) = (i - 1) * (S.sd.t - S.sd.r) + (S.sd.t - S.sd.r) := by
        rw [← Nat.succ_mul]; congr 1; omega
      omega
    rw [this]
    exact congrArg _ (relKey_shift S.sd.r S.d (i - 1) S.sd.t hrt.le y.2)

-- D7: numbers of a phase pair
theorem phasePair_num_D7 (S : OrdStep) {j φ : Nat} (hj : 1 ≤ j ∧ j ≤ S.n) {a c : ColAddr}
    (hp : PhasePair_D7 S j a c φ) : S.sd.r < a.num 0 ∧ c.num 0 = a.num 0 + φ * S.d := by
  rcases hp with ⟨ha, hc, rfl⟩ | ⟨rfl, hc, rfl⟩
  · exact ⟨tmplCol_num_gt S ha, num_phaseCol S.inL S.kind S.hsd S.hrd (Or.inr ha) hj.1 hc⟩
  · obtain ⟨-, -, ht, -⟩ := stopData_spec S.hsd
    obtain ⟨-, -, -, hrnum, hrt, -⟩ := rootData_spec S.hsd S.hrd
    have hnum := num_phaseCol S.inL S.kind S.hsd S.hrd (Or.inl rfl) hj.1 hc
    rw [hrnum] at hnum
    simp only [phaseOff, isQMat_rdcol S, Bool.false_eq_true, if_false] at hnum
    have hd : S.d = S.sd.t - S.sd.r := rfl
    refine ⟨by omega, ?_⟩
    rw [hnum, ← ht]
    have : j * S.d = (j - 1) * S.d + S.d := by
      rw [← Nat.succ_mul]; congr 1; omega
    simp only [OrdStep.d, period] at this ⊢
    omega

-- L-G010.18 (D7): the start of a pure phase-`φ` cut lies outside `[r, s_φ)` and projects to the
-- old start
theorem cutStart_phase_D7 (S : OrdStep) {φ : Nat} {a c : ColAddr} {k : Nat}
    (ha : S.sd.r < a.num 0) (hnum : c.num 0 = a.num 0 + φ * S.d) (hk : k ≤ (parents S.A a).length)
    (hpre : (parents S.B c).take k = ((parents S.A a).take k).map (shiftVal S.sd.r (φ * S.d))) :
    (cutStart S.B c k < S.sd.r ∨ S.s φ ≤ cutStart S.B c k) ∧
      S.proj φ (cutStart S.B c k) = cutStart S.A a k := by
  -- the projection of a shifted value `≥ r` (or of a value `< r`)
  have key : ∀ p, (shiftVal S.sd.r (φ * S.d) p < S.sd.r ∨ S.s φ ≤ shiftVal S.sd.r (φ * S.d) p) ∧
      S.proj φ (shiftVal S.sd.r (φ * S.d) p) = p := by
    intro p
    unfold shiftVal OrdStep.proj OrdStep.s
    by_cases hp : S.sd.r ≤ p
    · simp only [hp, if_true]
      refine ⟨Or.inr (by omega), ?_⟩
      by_cases hlt : S.sd.r + φ * S.d < p + φ * S.d
      · rw [if_pos hlt]; omega
      · rw [if_neg hlt, if_pos (by omega)]; omega
    · simp only [hp, if_false]
      refine ⟨Or.inl (by omega), ?_⟩
      rw [if_neg (by omega), if_neg (by omega)]
  rcases Nat.eq_zero_or_pos k with rfl | hk0
  · simp only [cutStart, if_true]
    have : c.num 0 - 1 = shiftVal S.sd.r (φ * S.d) (a.num 0 - 1) := by
      simp only [shiftVal, if_pos (show S.sd.r ≤ a.num 0 - 1 by omega)]; omega
    rw [this]
    exact key _
  · have hne : k ≠ 0 := by omega
    have hlt : k - 1 < k := by omega
    have hB : (parents S.B c)[k - 1]? = ((parents S.A a)[k - 1]?).map (shiftVal S.sd.r (φ * S.d)) := by
      rw [← List.getElem?_take_of_lt hlt, hpre, List.getElem?_map, List.getElem?_take_of_lt hlt]
    obtain ⟨p, hp⟩ : ∃ p, (parents S.A a)[k - 1]? = some p :=
      ⟨_, List.getElem?_eq_getElem (by omega)⟩
    simp only [cutStart, hne, if_false, hB, hp, Option.map_some, Option.getD_some]
    exact key p

/-! ### The decorated head path (L-G010.10) -/

-- D7 (helper): the root column is on the stack of both members of a phase pair, below them in
-- path order; the copy is placed under the stopping column
theorem phasePair_root_D7 (S : OrdStep) {j φ : Nat} {a c : ColAddr}
    (hp : PhasePair_D7 S j a c φ) :
    a.resolve 0 S.sd.r = some S.rd.col ∧ c.resolve 0 S.sd.r = some S.rd.col ∧
      S.rd.col.path <+: a.path ∧ ∃ b, c = underCol S.sd.col b := by
  obtain ⟨hres, hrnum, -, hpre, -⟩ := rootData_path S.hsd S.hrd
  obtain ⟨-, -, ht, -⟩ := stopData_spec S.hsd
  obtain ⟨-, -, -, -, hrt, -⟩ := rootData_spec S.hsd S.hrd
  have hsdR : S.sd.col.OnStack S.rd.col := ((ColAddr.resolve_spec 0 _ _ _).mp hres).1
  obtain ⟨b, hb⟩ : ∃ b, c = underCol S.sd.col b := by
    rcases hp with ⟨-, hc, -⟩ | ⟨-, hc, -⟩
    · unfold phaseCol at hc; obtain ⟨a', -, ha'⟩ := Option.map_eq_some_iff.mp hc; exact ⟨_, ha'.symm⟩
    · unfold phaseCol at hc; obtain ⟨a', -, ha'⟩ := Option.map_eq_some_iff.mp hc; exact ⟨_, ha'.symm⟩
  have hcR : c.resolve 0 S.sd.r = some S.rd.col := by
    rw [hb]
    exact (ColAddr.resolve_spec 0 _ _ _).mpr ⟨(onStack_underCol _ _ _).mpr (Or.inl hsdR), hrnum⟩
  refine ⟨?_, hcR, ?_, b, hb⟩
  · rcases hp with ⟨ha, -, -⟩ | ⟨rfl, -, -⟩
    · by_cases haq : isQMat S.sd a = true
      · obtain ⟨q, rest, hq, -⟩ := isQMat_spec S.sd haq
        have hsa : a.OnStack S.sd.col := by
          refine onStack_of_container (e := ⟨S.sd.col, q⟩) ?_
          rw [ColAddr.container_spec]
          exact ⟨rfl, rest, by simp [EntryAddr.heightPath, hq]⟩
        have := (ColAddr.onStack_iff_of_onStack 0 hsa (by rw [hrnum, ← ht]; exact hrt)).mp hsdR
        exact (ColAddr.resolve_spec 0 _ _ _).mpr ⟨this, hrnum⟩
      · obtain ⟨a', ha'⟩ := Option.isSome_iff_exists.mp ha.2.2.2
        exact (ColAddr.resolve_spec 0 _ _ _).mpr
          ⟨onStack_rdcol S ha' (by simpa using haq) ha.2.2.1, hrnum⟩
    · exact hres
  · rcases hp with ⟨ha, -, -⟩ | ⟨rfl, -, -⟩
    · by_cases haq : isQMat S.sd a = true
      · obtain ⟨q, rest, hq, -⟩ := isQMat_spec S.sd haq
        rw [hq]; exact hpre.trans (List.prefix_append _ _)
      · obtain ⟨a', ha'⟩ := Option.isSome_iff_exists.mp ha.2.2.2
        obtain ⟨suf, hsuf, -⟩ := kerCol_tail_spec S ha' (by simpa using haq)
        rw [hsuf]; exact List.prefix_append _ _
    · exact hpre

-- D7 (helper): keys normalized at or below `r`, capped or not, are `κ`-fixed
theorem kappaQ_fix_D7 (r d φ : Nat) (E : Forest) {o : ColAddr} (ho : o.num 0 ≤ r) :
    kappaQ r d φ (actualKeys E o) = actualKeys E o ∧
      ∀ v, kappaQ r d φ ((actualKeys E o).take v ++ [⊤]) = (actualKeys E o).take v ++ [⊤] := by
  have h1 : kappaQ r d φ (actualKeys E o) = actualKeys E o := by
    unfold kappaQ actualKeys
    rw [List.map_map]
    congr 1
    funext x
    simp only [Function.comp_apply, WithTop.map_coe, kappa_fix r d φ _ ho]
  refine ⟨h1, fun v => ?_⟩
  unfold kappaQ at h1 ⊢
  rw [List.map_append, List.map_take, h1]
  rfl

-- L-G010.4, fixed region (D7; L-G010.4c): below `r` both stacks are the root's, and the
-- decorated responses agree
theorem respEdge_fixed_D7 (S : OrdStep) {j φ : Nat} {a c : ColAddr}
    (hp : PhasePair_D7 S j a c φ) {W : List (WithTop Key)} (_hT : ∀ w ∈ W, w ≠ ⊤) {x : Nat}
    (hx : x < S.sd.r) :
    respEdge S.B (activeKeys_D7 S.B c) c (kappaQ S.sd.r S.d φ W) x =
      respEdge S.A (activeKeys_D7 S.A a) a W x := by
  obtain ⟨hRa, hRc, hpa, b, hb⟩ := phasePair_root_D7 S hp
  obtain ⟨hres, hrnum, -, hpre, -⟩ := rootData_path S.hsd S.hrd
  have hpc : S.rd.col.path <+: c.path := by
    rw [hb]
    refine hpre.trans ?_
    obtain ⟨bp, bc⟩ := b
    cases bp with
    | nil => exact List.prefix_refl _
    | cons y ys => obtain ⟨y1, y2⟩ := y; exact List.prefix_append _ _
  unfold respEdge
  rw [← ColAddr.resolve_of_resolve_lt hRc hx, ← ColAddr.resolve_of_resolve_lt hRa hx]
  cases ho : S.rd.col.resolve 0 x with
  | none => rfl
  | some o =>
    simp only [Option.bind_some]
    have hon : o.num 0 = x := ColAddr.resolve_num ho
    have hsdo : S.sd.col.OnStack o := by
      have := ColAddr.resolve_of_resolve_lt hres hx
      rw [ho] at this
      exact ((ColAddr.resolve_spec 0 _ _ _).mp this.symm).1
    -- the containers at `o` of `a`, `c` and the stopping column are those of the root
    have hcont : ∀ X : ColAddr, X.resolve 0 S.sd.r = some S.rd.col → S.rd.col.path <+: X.path →
        o.container X = o.container S.rd.col := by
      intro X hX hpX
      apply Option.ext; intro e
      rw [ColAddr.container_spec, ColAddr.container_spec]
      constructor
      · rintro ⟨h1, h2⟩
        exact ⟨h1, EntryAddr.contains_of_resolve h2 hX (by rw [h1]; omega)⟩
      · rintro ⟨h1, h2⟩; exact ⟨h1, h2.trans hpX⟩
    have hca := hcont a hRa hpa
    have hcc := hcont c hRc hpc
    have hcs := hcont S.sd.col hres hpre
    -- the column of `o` in `B` is its context column
    have hE : S.A ≠ Tree.empty := by
      intro h
      have := S.hsd
      rw [h, stopData_eq_none_of_lastCol (Or.inl rfl)] at this
      cases this
    obtain ⟨Z, hB⟩ : ∃ Z, S.B = context S.A S.sd Z := by
      have := expand_eq_iterate hE S.inL.1 S.inL.2.1 S.kind S.hsd S.hrd S.kernelDefined S.n
      rw [S.out] at this
      exact ⟨_, Option.some.inj this⟩
    obtain ⟨hpar, htake, hnone⟩ := colAt_context_onStack S.hsd Z hsdo
    rw [← hB] at hpar htake hnone
    have hfix := kappaQ_fix_D7 S.sd.r S.d φ S.A (o := o) (by omega)
    have hks : activeKeys_D7 S.B c o = activeKeys_D7 S.A a o ∧
        kappaQ S.sd.r S.d φ (activeKeys_D7 S.A a o) = activeKeys_D7 S.A a o := by
      cases hce : o.container S.rd.col with
      | none =>
        have hBo := hnone (hcs.trans hce)
        refine ⟨?_, ?_⟩
        · simp only [activeKeys_D7, hca, hcc, hce, actualKeys, hBo]
        · simp only [activeKeys_D7, hca, hce]; exact hfix.1
      | some e =>
        have h1 := htake e (hcs.trans hce)
        have h2 : (actualKeys S.B o).take e.idx = (actualKeys S.A o).take e.idx := by
          simp only [actualKeys, ← List.map_take]
          congr 1
          cases hBo : S.B.colAt o with
          | none =>
            cases hAo : S.A.colAt o with
            | none => rfl
            | some _ => rw [hBo, hAo] at h1; cases h1
          | some C1 =>
            cases hAo : S.A.colAt o with
            | none => rw [hBo, hAo] at h1; cases h1
            | some C2 =>
              rw [hBo, hAo] at h1
              simpa using h1
        refine ⟨?_, ?_⟩
        · simp only [activeKeys_D7, hca, hcc, hce, h2]
        · simp only [activeKeys_D7, hca, hce]; exact hfix.2 _
    have hc : cursor (activeKeys_D7 S.A a o) (kappaQ S.sd.r S.d φ W) =
        cursor (activeKeys_D7 S.A a o) W := by
      have := cursor_map (kappaQry_strictMono S.sd.r S.d φ) (activeKeys_D7 S.A a o) W
      have h2 := hks.2
      unfold kappaQ at h2 ⊢
      rw [h2] at this
      exact this
    rw [resp_eq_parents, resp_eq_parents, hks.1, hpar, hc]

-- F7 (helper): parents and actual keys have the same length
theorem length_parents_F7 (E : Forest) (o : ColAddr) :
    (parents E o).length = (actualKeys E o).length := by
  simp [parents, actualKeys]

-- F7 (helper): `κ` maps actual keys to `⊤`-free lists
theorem kappaQ_actual_ne_top_F7 (r d φ : Nat) (E : Forest) (o : ColAddr) :
    ∀ w ∈ kappaQ r d φ (actualKeys E o), w ≠ ⊤ := by
  intro w hw
  simp only [kappaQ, actualKeys, List.map_map, List.mem_map] at hw
  obtain ⟨x, -, rfl⟩ := hw
  simp

-- L-G010.4 (F7, reduction): a response read through related columns is related, when the key
-- lists are actual or capped at a final `⊤` and the query is `⊤`-free
theorem respEdge_of_rel_F7 {A B : Forest} {ksA ksB : KeySys} {a c o o' : ColAddr}
    {x x' r d φ : Nat} {W : List (WithTop Key)} (hT : ∀ w ∈ W, w ≠ ⊤)
    (ho : a.resolve 0 x = some o) (ho' : c.resolve 0 x' = some o')
    (hks : ksB o' = kappaQ r d φ (ksA o))
    (hksA : ksA o = actualKeys A o ∨ ∃ l, ksA o = l ++ [⊤])
    (hksB : ksB o' = actualKeys B o' ∨ ∃ l, ksB o' = l ++ [⊤])
    (hpar : ∀ v, v < (ksA o).length →
      (parents B o')[v]? = ((parents A o)[v]?).map (shiftVal r (φ * d))) :
    respEdge B ksB c (kappaQ r d φ W) x' = (respEdge A ksA a W x).map (shiftVal r (φ * d)) := by
  unfold respEdge
  rw [ho, ho']
  simp only [Option.bind_some]
  rw [resp_eq_parents, resp_eq_parents, hks]
  have hcur : cursor (kappaQ r d φ (ksA o)) (kappaQ r d φ W) = cursor (ksA o) W :=
    cursor_map (kappaQry_strictMono r d φ) _ _
  rw [hcur]
  by_cases hlt : cursor (ksA o) W < (ksA o).length
  · exact hpar _ hlt
  · have hle := cursor_le_length (ksA o) W
    have heq : cursor (ksA o) W = (ksA o).length := by omega
    rcases hksA with hA | ⟨l, hl⟩
    · have hA1 : (parents A o)[cursor (ksA o) W]? = none := by
        rw [List.getElem?_eq_none]; rw [heq, hA, length_parents_F7]
      rcases hksB with hB | ⟨l', hl'⟩
      · have hB1 : (parents B o')[cursor (ksA o) W]? = none := by
          rw [List.getElem?_eq_none]
          rw [heq, length_parents_F7, ← hB, hks]
          simp [kappaQ]
        rw [hA1, hB1]; rfl
      · exfalso
        have hmem : (⊤ : WithTop Key) ∈ kappaQ r d φ (ksA o) := by
          rw [← hks, hl']; simp
        rw [hA] at hmem
        exact kappaQ_actual_ne_top_F7 r d φ A o _ hmem rfl
    · exfalso
      have := cursor_append_top_D7 W l hT
      rw [← hl] at this
      have h2 : (ksA o).length = l.length + 1 := by rw [hl]; simp
      omega


-- L-G010.4b (F7, assembly): related containers and related contents before the active entry give
-- related active key systems and related parents
theorem activeKeys_rel_F7 {A B : Forest} {a c o o' : ColAddr} {r d φ : Nat}
    (hcont : o'.container c = (o.container a).map (fun e => ⟨o', e.idx⟩))
    (hkeys : ∀ u, (∀ e, o.container a = some e → u ≤ e.idx) →
      (actualKeys B o').take u = kappaQ r d φ ((actualKeys A o).take u))
    (hpar : ∀ v, (∀ e, o.container a = some e → v ≤ e.idx) →
      (parents B o')[v]? = ((parents A o)[v]?).map (shiftVal r (φ * d))) :
    activeKeys_D7 B c o' = kappaQ r d φ (activeKeys_D7 A a o) ∧
      (activeKeys_D7 A a o = actualKeys A o ∨ ∃ l, activeKeys_D7 A a o = l ++ [⊤]) ∧
      (activeKeys_D7 B c o' = actualKeys B o' ∨ ∃ l, activeKeys_D7 B c o' = l ++ [⊤]) ∧
      ∀ v, v < (activeKeys_D7 A a o).length →
        (parents B o')[v]? = ((parents A o)[v]?).map (shiftVal r (φ * d)) := by
  cases hca : o.container a with
  | none =>
    rw [hca, Option.map_none] at hcont
    have hu : ∀ e, o.container a = some e → (actualKeys A o).length + (actualKeys B o').length ≤ e.idx := by
      intro e he; rw [hca] at he; cases he
    have hk := hkeys _ hu
    rw [List.take_of_length_le (by omega), List.take_of_length_le (by omega)] at hk
    simp only [activeKeys_D7, hca, hcont]
    refine ⟨hk, Or.inl trivial, Or.inl trivial, fun v _ => hpar v ?_⟩
    intro e he; rw [hca] at he; cases he
  | some e =>
    rw [hca, Option.map_some] at hcont
    have hk := hkeys e.idx (fun e' he' => by rw [hca] at he'; cases he'; exact le_rfl)
    simp only [activeKeys_D7, hca, hcont]
    refine ⟨?_, Or.inr ⟨_, rfl⟩, Or.inr ⟨_, rfl⟩, fun v hv => hpar v ?_⟩
    · rw [hk]; simp [kappaQ]
    · intro e' he'
      rw [hca] at he'
      cases he'
      simp only [List.length_append, List.length_take, List.length_singleton] at hv
      omega


-- F7 (helper): the number of a phase-`h` copy of a non-Q template column
theorem num_copyCol_F7 (S : OrdStep) {h : Nat} {o : ColAddr} (ho : IsTmplCol S.A S.sd S.rd o)
    (hoq : isQMat S.sd o = false) : (S.copyCol h o).num 0 = o.num 0 + h * S.d := by
  rcases Nat.eq_zero_or_pos h with rfl | hpos
  · simp [OrdStep.copyCol]
  · obtain ⟨o', ho'⟩ : ∃ o', phaseCol S.sd S.rd h o = some o' := by
      obtain ⟨b, hb⟩ := Option.isSome_iff_exists.mp ho.2.2.2
      exact ⟨_, by unfold phaseCol; rw [hb]; rfl⟩
    have := num_phaseCol S.inL S.kind S.hsd S.hrd (Or.inr ho) hpos ho'
    simp only [OrdStep.copyCol, if_neg (show h ≠ 0 by omega), ho', Option.getD_some, this,
      phaseOff, hoq, Bool.false_eq_true, if_false, OrdStep.d]

-- L-G010.4b (F7, contents of non-Q copies): the phase-`h` copy of a non-Q template column has
-- the shifted parents, and its keys are `κ_h`-images before the entry containing the stopping
-- column (all keys if it contains none)
theorem copyCol_content_F7 (S : OrdStep) {h : Nat} (hh : h ≤ S.n) {o : ColAddr}
    (ho : IsTmplCol S.A S.sd S.rd o) (hoq : isQMat S.sd o = false) :
    parents S.B (S.copyCol h o) = (parents S.A o).map (shiftVal S.sd.r (h * S.d)) ∧
    ∀ u, (∀ e, o.container S.sd.col = some e → u ≤ e.idx) →
      (actualKeys S.B (S.copyCol h o)).take u =
        kappaQ S.sd.r S.d h ((actualKeys S.A o).take u) := by
  obtain ⟨Z, hBcol⟩ := colAt_copyCol S hh ho hoq
  have hnum := num_copyCol_F7 S (h := h) ho hoq
  have hro := tmplCol_num_gt S ho
  set C := ((context S.A S.sd Z).colAt o).getD [] with hC
  have hBget : (S.B.colAt (S.copyCol h o)).getD [] = Tree.mapCol (shiftVal S.sd.r (h * S.d)) C := by
    rw [hBcol, hC]
    cases (context S.A S.sd Z).colAt o <;> simp [Tree.mapCol]
  have hBkeys : actualKeys S.B (S.copyCol h o) =
      kappaQ S.sd.r S.d h (actualKeys (context S.A S.sd Z) o) := by
    simp only [actualKeys, hBget, mapCol_eq_map, List.map_map, kappaQ, ← hC]
    congr 1
    funext y
    simp only [Function.comp_apply, WithTop.map_coe]
    rw [hnum]
    exact congrArg _ (relKey_shift S.sd.r S.d h (o.num 0) (by omega) y.2)
  have hBpar : parents S.B (S.copyCol h o) =
      (parents (context S.A S.sd Z) o).map (shiftVal S.sd.r (h * S.d)) := by
    simp only [parents, hBget, mapCol_eq_map, List.map_map, ← hC]
    rfl
  cases hce : o.container S.sd.col with
  | none =>
    have hctx := colAt_context_of_not_route S.hsd Z ho.1 ho.2.1
      (sdcol_container_none S ho.1 hoq) hce
    refine ⟨by rw [hBpar]; simp only [parents, hctx], fun u _ => ?_⟩
    rw [hBkeys]
    unfold kappaQ
    rw [List.map_take]
    simp only [actualKeys, hctx]
  | some e =>
    obtain ⟨hcpar, hctake, -⟩ := colAt_context_onStack S.hsd Z (onStack_of_container hce)
    refine ⟨by rw [hBpar, hcpar], fun u hu => ?_⟩
    have hue := hu e rfl
    rw [hBkeys]
    unfold kappaQ
    rw [← List.map_take]
    congr 1
    have := hctake e hce
    have e1 : (actualKeys (context S.A S.sd Z) o).take u =
        ((actualKeys (context S.A S.sd Z) o).take e.idx).take u := by
      rw [List.take_take, Nat.min_eq_left hue]
    have e2 : (actualKeys S.A o).take u = ((actualKeys S.A o).take e.idx).take u := by
      rw [List.take_take, Nat.min_eq_left hue]
    rw [e1, e2]
    congr 1
    simp only [actualKeys, ← List.map_take]
    congr 1
    cases h1 : (context S.A S.sd Z).colAt o with
    | none =>
      rw [h1] at this
      cases h2 : S.A.colAt o with
      | none => rfl
      | some _ => rw [h2] at this; cases this
    | some C1 =>
      rw [h1] at this
      cases h2 : S.A.colAt o with
      | none => rw [h2] at this; cases this
      | some C2 =>
        rw [h2] at this
        simpa using this


-- L-G010.4b (F7, contents of closed copies): off the hole route a phase copy is a pure copy
theorem phaseCol_content_closed_F7 (S : OrdStep) {h : Nat} (hh : 1 ≤ h ∧ h ≤ S.n)
    {o o' : ColAddr} (ho : IsTmplCol S.A S.sd S.rd o) (hroute : ¬ OnHoleRoute S.sd o)
    (ho' : phaseCol S.sd S.rd h o = some o') :
    parents S.B o' = (parents S.A o).map (shiftVal S.sd.r (phaseOff S.sd h o * S.d)) ∧
      actualKeys S.B o' = kappaQ S.sd.r S.d (phaseOff S.sd h o) (actualKeys S.A o) := by
  have hB := colAt_phaseCol S.inL S.kind S.hsd S.hrd S.out hh ho hroute ho'
  have hnum := num_phaseCol S.inL S.kind S.hsd S.hrd (Or.inr ho) hh.1 ho'
  have hro := tmplCol_num_gt S ho
  have hBget : (S.B.colAt o').getD [] =
      Tree.mapCol (shiftVal S.sd.r (phaseOff S.sd h o * S.d)) ((S.A.colAt o).getD []) := by
    rw [hB]
    cases S.A.colAt o <;> simp [Tree.mapCol, OrdStep.d]
  refine ⟨?_, ?_⟩
  · simp only [parents, hBget, mapCol_eq_map, List.map_map]
    rfl
  · simp only [actualKeys, hBget, mapCol_eq_map, List.map_map, kappaQ]
    congr 1
    funext y
    simp only [Function.comp_apply, WithTop.map_coe]
    rw [hnum]
    exact congrArg _ (relKey_shift S.sd.r S.d _ (o.num 0) (by omega) y.2)

-- G9.4b generalized (F7): for every placed address `c` of layer `i` and every phase `h < i`, the
-- phase-`h` copies of the stopping column's stack columns between `r` and `t` are on the stack of
-- `c` at numbers `x + h d`, and they contain `c` exactly when the old columns contain the stopping
-- column, through the same entry
theorem resolve_copyCol_gen_F7 (S : OrdStep) {i : Nat} {b₀ c kh : ColAddr}
    (hkh : kerCol S.sd S.rd S.sd.col = some kh)
    (hcdef : c = underCol S.sd.col ((underCol kh)^[i - 1] b₀)) {h : Nat} (hh : h < i)
    {x : Nat} {o : ColAddr} (hx : S.sd.r < x) (ho : S.sd.col.resolve 0 x = some o) :
    c.resolve 0 (x + h * S.d) = some (S.copyCol h o) ∧
      (S.copyCol h o).container c =
        (o.container S.sd.col).map (fun e => ⟨S.copyCol h o, e.idx⟩) := by
  obtain ⟨hst, hnum⟩ := (ColAddr.resolve_spec 0 _ _ _).mp ho
  obtain ⟨-, -, ht, -⟩ := stopData_spec S.hsd
  obtain ⟨-, -, -, hrnum, hrt, -⟩ := rootData_spec S.hsd S.hrd
  have hsdq : isQMat S.sd S.sd.col = false := isQMat_of_short S.sd le_rfl
  obtain ⟨hoker, hoq⟩ := kerCol_of_onStack_tail S hkh hsdq hst (by omega)
  obtain ⟨o', ho'⟩ := Option.isSome_iff_exists.mp hoker
  have hne : o ≠ S.rd.col := by
    intro h; rw [h] at hnum; omega
  have hsplit : 0 < h → (underCol kh)^[i - 1] b₀ =
      (underCol kh)^[h - 1] ((underCol kh)^[i - h] b₀) := by
    intro hpos
    rw [← Function.iterate_add_apply]
    congr 1
    omega
  obtain ⟨j, hj⟩ : ∃ j, i - h = j + 1 := ⟨i - h - 1, by omega⟩
  have hkho' : kh.OnStack o' :=
    (onStack_kerCol_tail S hkh hsdq o').mpr ⟨o, hst, by omega, hoq, ho'⟩
  have hcopy : 0 < h → S.copyCol h o = underCol S.sd.col ((underCol kh)^[h - 1] o') := by
    intro hpos
    simp only [OrdStep.copyCol, if_neg (show h ≠ 0 by omega)]
    rw [phaseCol_eq_iterate S hkh ho']
    rfl
  refine ⟨?_, ?_⟩
  · -- resolution
    rw [ColAddr.resolve_spec]
    rcases Nat.eq_zero_or_pos h with h0 | hpos
    · subst h0
      simp only [OrdStep.copyCol, if_true, Nat.zero_mul, Nat.add_zero]
      exact ⟨by rw [hcdef]; exact (onStack_underCol _ _ _).mpr (Or.inl hst), hnum⟩
    · have hZ : ((underCol kh)^[i - h] b₀).OnStack o' := by
        rw [hj, Function.iterate_succ_apply']
        exact (onStack_underCol kh _ _).mpr (Or.inl hkho')
      rw [hcopy hpos]
      refine ⟨?_, ?_⟩
      · rw [hcdef, hsplit hpos]
        exact (onStack_underCol _ _ _).mpr
          (Or.inr ⟨_, iterate_underCol_onStack kh (h - 1) hZ, rfl⟩)
      · have h1 := num_kerCol_tail S hkh hsdq
        have h2 := num_kerCol_tail S ho' hoq
        rw [num_underCol, num_iterate_underCol]
        simp only [OrdStep.d, period]
        rw [← ht] at h1
        have : (h - 1) * kh.num 0 + kh.num 0 = h * kh.num 0 := by
          rw [← Nat.succ_mul]; congr 1; omega
        have hd : kh.num 0 = S.sd.t - S.sd.r := by omega
        rw [← hd]
        omega
  · -- containment
    rcases Nat.eq_zero_or_pos h with h0 | hpos
    · subst h0
      simp only [OrdStep.copyCol, if_true]
      rw [hcdef, container_underCol_of_onStack hst]
      cases hce : o.container S.sd.col with
      | none => rfl
      | some e =>
        simp only [Option.map_some, Option.some.injEq]
        rw [← container_col hce]
    · rw [hcopy hpos, hcdef, hsplit hpos, container_underCol, iterate_underCol_container, hj,
        Function.iterate_succ_apply', container_underCol_of_onStack hkho',
        container_kerCol S hkh ho' hsdq]
      simp only [if_neg hne, Option.map_map]
      rfl

-- F7 (helper): a stack column of a column of `A` that contains the stopping column contains the
-- column too, at an entry no later than the stopping column's
theorem container_le_sdcol_F7 (S : OrdStep) {a o : ColAddr} (ha : a ∈ S.A.colAddrs) {x : Nat}
    (ho : a.resolve 0 x = some o) {e' : EntryAddr} (he' : o.container S.sd.col = some e') :
    ∃ e, o.container a = some e ∧ e.idx ≤ e'.idx := by
  obtain ⟨-, -, -, hroute, -⟩ := stopData_spec S.hsd
  have hor : o ∈ routeCols S.A := container_mem_routeCols_D7 hroute he'
  obtain ⟨v, hv, hcv⟩ := routeCols_visible ha hor ho
  refine ⟨⟨o, v⟩, (ColAddr.container_spec _ _ _).mpr ⟨rfl, hcv⟩, ?_⟩
  have hlast := container_sdcol_last S he'
  have hent := (Tree.mem_entryAddrs_iff _ _).mp hv
  unfold Tree.entryAt at hent
  have hvlt : v < (parents S.A o).length := by
    simp only [parents, List.length_map]
    cases hc : S.A.colAt o with
    | none => rw [hc] at hent; cases hent
    | some col =>
      rw [hc] at hent
      simp only [Option.bind_some, Option.getD_some] at hent ⊢
      exact (List.getElem?_eq_some_iff.mp (Option.get_mem hent)).1
  show v ≤ e'.idx
  omega


-- F7 (helper): Q-material is the placement of its kernel image under the stopping column
theorem qmat_underCol_F7 (S : OrdStep) {a a₀ : ColAddr} (haq : isQMat S.sd a = true)
    (ha₀ : kerCol S.sd S.rd a = some a₀) : a = underCol S.sd.col a₀ := by
  obtain ⟨q, rest, hp, -⟩ := isQMat_spec S.sd haq
  rw [kerCol_qmat S haq hp, Option.some.injEq] at ha₀
  subst ha₀
  show (⟨a.path, a.col⟩ : ColAddr) = _
  simp [underCol, hp]

-- L-G010.4b (F7, the stopping column's stack): for a placed address `c` of layer `j`, the
-- phase-`(j−1)` copies of the stopping column's stack columns above `r` are related to them
theorem phase_stack_sd_F7 (S : OrdStep) {j : Nat} (hj : 1 ≤ j ∧ j ≤ S.n) {a b₀ c kh : ColAddr}
    (hkh : kerCol S.sd S.rd S.sd.col = some kh)
    (hcdef : c = underCol S.sd.col ((underCol kh)^[j - 1] b₀)) {x : Nat} (hx : S.sd.r < x)
    {o : ColAddr} (ho : S.sd.col.resolve 0 x = some o)
    (hca : o.container a = o.container S.sd.col) :
    ∃ o', c.resolve 0 (x + (j - 1) * S.d) = some o' ∧
      o'.container c = (o.container a).map (fun e => ⟨o', e.idx⟩) ∧
      (∀ u, (∀ e, o.container a = some e → u ≤ e.idx) →
        (actualKeys S.B o').take u = kappaQ S.sd.r S.d (j - 1) ((actualKeys S.A o).take u)) ∧
      (∀ v, (∀ e, o.container a = some e → v ≤ e.idx) →
        (parents S.B o')[v]? = ((parents S.A o)[v]?).map (shiftVal S.sd.r ((j - 1) * S.d))) := by
  obtain ⟨-, -, ht, -⟩ := stopData_spec S.hsd
  have hxt : x < S.sd.t := by rw [ht]; exact ColAddr.resolve_lt ho
  obtain ⟨hres, hcont⟩ := resolve_copyCol_gen_F7 S hkh hcdef (h := j - 1) (by omega) hx ho
  obtain ⟨hot, hoq⟩ := tmplCol_of_sdstack S hx hxt ho
  obtain ⟨hpar, hkeys⟩ := copyCol_content_F7 S (h := j - 1) (by omega) hot hoq
  refine ⟨_, hres, by rw [hcont, hca], fun u hu => hkeys u (by rw [← hca]; exact hu),
    fun v _ => by rw [hpar, List.getElem?_map]⟩

-- L-G010.4b (F7, root-tail template copies, `φ = j`)
theorem phase_stack_tail_F7 (S : OrdStep) {j : Nat} (hj : 1 ≤ j ∧ j ≤ S.n) {a c : ColAddr}
    (ha : IsTmplCol S.A S.sd S.rd a) (haq : isQMat S.sd a = false)
    (hc : phaseCol S.sd S.rd j a = some c) {x : Nat} (hx : S.sd.r < x) {o : ColAddr}
    (ho : a.resolve 0 x = some o) :
    ∃ o', c.resolve 0 (x + j * S.d) = some o' ∧
      o'.container c = (o.container a).map (fun e => ⟨o', e.idx⟩) ∧
      (∀ u, (∀ e, o.container a = some e → u ≤ e.idx) →
        (actualKeys S.B o').take u = kappaQ S.sd.r S.d j ((actualKeys S.A o).take u)) ∧
      (∀ v, (∀ e, o.container a = some e → v ≤ e.idx) →
        (parents S.B o')[v]? = ((parents S.A o)[v]?).map (shiftVal S.sd.r (j * S.d))) := by
  obtain ⟨hst, hnum⟩ := (ColAddr.resolve_spec 0 _ _ _).mp ho
  obtain ⟨-, -, -, hrnum, -⟩ := rootData_spec S.hsd S.hrd
  obtain ⟨a₀, ha₀⟩ := Option.isSome_iff_exists.mp ha.2.2.2
  obtain ⟨kh, hkh⟩ := kerCol_sdcol S
  obtain ⟨hoker, hoq⟩ := kerCol_of_onStack_tail S ha₀ haq hst (by omega)
  obtain ⟨o₀, ho₀⟩ := Option.isSome_iff_exists.mp hoker
  have hne : o ≠ S.rd.col := by intro h; rw [h] at hnum; omega
  have hot : IsTmplCol S.A S.sd S.rd o := by
    refine ⟨mem_colAddrs_of_onStack ha.1 hst, ?_, hne, hoker⟩
    intro h; rw [h] at hst; exact not_onStack_sdcol S ha.1 haq hst
  have hcdef : c = underCol S.sd.col ((underCol kh)^[j - 1] a₀) := by
    rw [phaseCol_eq_iterate S hkh ha₀] at hc
    exact (Option.some.inj hc).symm
  have hcopy : S.copyCol j o = underCol S.sd.col ((underCol kh)^[j - 1] o₀) := by
    simp only [OrdStep.copyCol, if_neg (show j ≠ 0 by omega)]
    rw [phaseCol_eq_iterate S hkh ho₀]
    rfl
  have hst₀ : a₀.OnStack o₀ := onStack_kerCol_tail_mpr S ha₀ haq hst (by omega) hoq ho₀
  obtain ⟨hpar, hkeys⟩ := copyCol_content_F7 S (h := j) hj.2 hot hoq
  refine ⟨S.copyCol j o, ?_, ?_, fun u hu => hkeys u ?_, fun v _ => ?_⟩
  · rw [ColAddr.resolve_spec]
    refine ⟨?_, by rw [num_copyCol_F7 S hot hoq, hnum]⟩
    rw [hcdef, hcopy]
    exact (onStack_underCol _ _ _).mpr (Or.inr ⟨_, iterate_underCol_onStack kh (j - 1) hst₀, rfl⟩)
  · rw [hcopy, hcdef, container_underCol, iterate_underCol_container,
      container_kerCol S ha₀ ho₀ haq]
    simp only [if_neg hne, Option.map_map]
    rfl
  · intro e' he'
    obtain ⟨e, he, hle⟩ := container_le_sdcol_F7 S ha.1 ho he'
    exact (hu e he).trans hle
  · rw [hpar, List.getElem?_map]


-- F7 (helper): the kernel hole has number `d`
theorem num_kerHole_F7 (S : OrdStep) {kh : ColAddr} (hkh : kerCol S.sd S.rd S.sd.col = some kh) :
    kh.num 0 = S.d := by
  obtain ⟨-, -, ht, -⟩ := stopData_spec S.hsd
  have h1 := num_kerCol_tail S hkh (isQMat_of_short S.sd le_rfl)
  simp only [OrdStep.d, period]
  omega

-- L-G010.4b (F7, Q-material copies, `φ = j − 1`; L-G010.9 at `x = t`)
theorem phase_stack_qmat_F7 (S : OrdStep) {j : Nat} (hj : 1 ≤ j ∧ j ≤ S.n) {a c : ColAddr}
    (ha : IsTmplCol S.A S.sd S.rd a) (haq : isQMat S.sd a = true)
    (hc : phaseCol S.sd S.rd j a = some c) {x : Nat} (hx : S.sd.r < x) {o : ColAddr}
    (ho : a.resolve 0 x = some o) :
    ∃ o', c.resolve 0 (x + (j - 1) * S.d) = some o' ∧
      o'.container c = (o.container a).map (fun e => ⟨o', e.idx⟩) ∧
      (∀ u, (∀ e, o.container a = some e → u ≤ e.idx) →
        (actualKeys S.B o').take u = kappaQ S.sd.r S.d (j - 1) ((actualKeys S.A o).take u)) ∧
      (∀ v, (∀ e, o.container a = some e → v ≤ e.idx) →
        (parents S.B o')[v]? = ((parents S.A o)[v]?).map (shiftVal S.sd.r ((j - 1) * S.d))) := by
  obtain ⟨hst, hnum⟩ := (ColAddr.resolve_spec 0 _ _ _).mp ho
  obtain ⟨-, -, ht, -⟩ := stopData_spec S.hsd
  obtain ⟨-, -, -, hrnum, hrt, -⟩ := rootData_spec S.hsd S.hrd
  obtain ⟨a₀, ha₀⟩ := Option.isSome_iff_exists.mp ha.2.2.2
  obtain ⟨kh, hkh⟩ := kerCol_sdcol S
  obtain ⟨q, rest, hap, hq⟩ := isQMat_spec S.sd haq
  have ha₀def : a₀ = ⟨(0, q) :: rest, a.col⟩ := by
    rw [kerCol_qmat S haq hap] at ha₀; exact (Option.some.inj ha₀).symm
  have haU : a = underCol S.sd.col a₀ := qmat_underCol_F7 S haq ha₀
  have hcdef : c = underCol S.sd.col ((underCol kh)^[j - 1] a₀) := by
    rw [phaseCol_eq_iterate S hkh ha₀] at hc
    exact (Option.some.inj hc).symm
  have hkhd := num_kerHole_F7 S hkh
  have h0st : a₀.OnStack ⟨[], 0⟩ := by
    rw [ha₀def]; exact Or.inl ⟨0, 0, q, rfl, rfl, le_rfl⟩
  have hsdA : a.OnStack S.sd.col := by
    rw [haU]
    refine (onStack_underCol _ _ _).mpr (Or.inr ⟨_, h0st, ?_⟩)
    simp [underCol]
  have hresT : a.resolve 0 S.sd.t = some S.sd.col :=
    (ColAddr.resolve_spec 0 _ _ _).mpr ⟨hsdA, ht.symm⟩
  rcases Nat.lt_trichotomy x S.sd.t with hxt | rfl | hxt
  · -- below `t`: the stopping column's stack, copied in phase `j − 1`
    have ho' : S.sd.col.resolve 0 x = some o := by
      rw [ColAddr.resolve_of_resolve_lt hresT hxt]; exact ho
    have hsdo : S.sd.col.OnStack o := ((ColAddr.resolve_spec 0 _ _ _).mp ho').1
    have hca : o.container a = o.container S.sd.col := by
      rw [haU]; exact container_underCol_of_onStack hsdo a₀
    exact phase_stack_sd_F7 S hj hkh hcdef hx ho' hca
  · -- at `t`: the stopping column, copied to the head of layer `j`
    have hoe : o = S.sd.col := by rw [hresT] at ho; exact (Option.some.inj ho).symm
    subst hoe
    set hd := underCol S.sd.col ((underCol kh)^[j - 1] (⟨[], 0⟩ : ColAddr)) with hhd
    have hhead : phaseCol S.sd S.rd j S.rd.col = some hd := phaseCol_eq_iterate S hkh (kerCol_rdcol S)
    have hca : S.sd.col.container a = some ⟨S.sd.col, q⟩ := by
      rw [ColAddr.container_spec]
      exact ⟨rfl, (rest), by simp [EntryAddr.heightPath, hap]⟩
    have h0c : (⟨[], 0⟩ : ColAddr).container a₀ = some ⟨⟨[], 0⟩, q⟩ := by
      rw [ha₀def]; simp [ColAddr.container]
    obtain ⟨-, hparB, hkeyB⟩ := headQuery_prefix_D7 S hj hhead
    refine ⟨hd, ?_, ?_, fun u hu => ?_, fun v hv => ?_⟩
    · rw [ColAddr.resolve_spec]
      refine ⟨?_, ?_⟩
      · rw [hcdef, hhd]
        exact (onStack_underCol _ _ _).mpr
          (Or.inr ⟨_, iterate_underCol_onStack kh (j - 1) h0st, rfl⟩)
      · rw [hhd, num_underCol, num_iterate_underCol, hkhd, ← ht]
        simp [ColAddr.num]
    · rw [hca, hhd, hcdef, container_underCol, iterate_underCol_container, h0c]
      rfl
    · have hu' := hu _ hca
      simp only at hu'
      have hum : u ≤ S.m := by simp only [OrdStep.m]; omega
      have e1 : (actualKeys S.B hd).take u = ((actualKeys S.B hd).take S.m).take u := by
        rw [List.take_take, Nat.min_eq_left hum]
      have e2 : (actualKeys S.A S.sd.col).take u =
          ((actualKeys S.A S.sd.col).take S.m).take u := by
        rw [List.take_take, Nat.min_eq_left hum]
      rw [e1, e2, hkeyB]
      simp only [kappaQ, List.map_take]
    · have hv' := hv _ hca
      simp only at hv'
      have hvm : v < S.m := by simp only [OrdStep.m]; omega
      rw [← List.getElem?_take_of_lt hvm, hparB, List.getElem?_map, List.getElem?_take_of_lt hvm]
  · -- above `t`: Q-material, copied in phase `j − 1`
    rw [haU] at hst
    rcases (onStack_underCol _ _ _).mp hst with hsdo | ⟨o₁, hst₁, rfl⟩
    · have := ColAddr.num_lt_of_onStack 0 hsdo; omega
    rcases (onStack_kerCol_qmat S ha₀ haq o₁).mp hst₁ with rfl | ⟨o₂, hst₂, hq₂, ho₂⟩
    · have : underCol S.sd.col ⟨[], 0⟩ = S.sd.col := by simp [underCol]
      rw [this] at hnum; omega
    have hoU : o₂ = underCol S.sd.col o₁ := qmat_underCol_F7 S hq₂ ho₂
    subst hoU
    have hot : IsTmplCol S.A S.sd S.rd (underCol S.sd.col o₁) := by
      refine ⟨mem_colAddrs_of_onStack ha.1 hst₂, ?_, ?_, by rw [ho₂]; rfl⟩
      · intro h; rw [h] at hnum; omega
      · intro h; rw [h] at hnum; omega
    have hroute : ¬ OnHoleRoute S.sd (underCol S.sd.col o₁) := fun h => by
      have := isQMat_of_short S.sd h.length_le
      rw [hq₂] at this; cases this
    have hc' := phaseCol_eq_iterate S hkh (i := j) ho₂
    obtain ⟨hpar, hkeys⟩ := phaseCol_content_closed_F7 S hj hot hroute hc'
    have hφ : phaseOff S.sd j (underCol S.sd.col o₁) = j - 1 := by simp [phaseOff, hq₂]
    rw [hφ] at hpar hkeys
    refine ⟨_, ?_, ?_, fun u _ => by rw [hkeys]; unfold kappaQ; rw [List.map_take],
      fun v _ => by rw [hpar, List.getElem?_map]⟩
    · rw [ColAddr.resolve_spec]
      refine ⟨?_, ?_⟩
      · rw [hcdef]
        exact (onStack_underCol _ _ _).mpr
          (Or.inr ⟨_, iterate_underCol_onStack kh (j - 1) hst₁, rfl⟩)
      · rw [← hnum, num_underCol, num_underCol, num_iterate_underCol, hkhd]
        omega
    · rw [hcdef, container_underCol, haU, container_underCol, iterate_underCol_container,
        Option.map_map, Option.map_map]
      rfl


-- L-G010.4b (F7; T3.2i, the three stack correspondences): above `r`, the stack of `a` at `x` and
-- the stack of `c` at `x + φd` hold related columns, with related containers and related contents
-- before the active entry
theorem phase_stack_F7 (S : OrdStep) {j φ : Nat} (hj : 1 ≤ j ∧ j ≤ S.n) {a c : ColAddr}
    (hp : PhasePair_D7 S j a c φ) {x : Nat} (hx : S.sd.r < x) {o : ColAddr}
    (ho : a.resolve 0 x = some o) :
    ∃ o', c.resolve 0 (x + φ * S.d) = some o' ∧
      o'.container c = (o.container a).map (fun e => ⟨o', e.idx⟩) ∧
      (∀ u, (∀ e, o.container a = some e → u ≤ e.idx) →
        (actualKeys S.B o').take u = kappaQ S.sd.r S.d φ ((actualKeys S.A o).take u)) ∧
      (∀ v, (∀ e, o.container a = some e → v ≤ e.idx) →
        (parents S.B o')[v]? = ((parents S.A o)[v]?).map (shiftVal S.sd.r (φ * S.d))) := by
  rcases hp with ⟨ha, hc, rfl⟩ | ⟨rfl, hc, rfl⟩
  · by_cases haq : isQMat S.sd a = true
    · have hφ : phaseOff S.sd j a = j - 1 := by simp [phaseOff, haq]
      rw [hφ]
      exact phase_stack_qmat_F7 S hj ha haq hc hx ho
    · have haq' : isQMat S.sd a = false := by simpa using haq
      have hφ : phaseOff S.sd j a = j := by simp [phaseOff, haq']
      rw [hφ]
      exact phase_stack_tail_F7 S hj ha haq' hc hx ho
  · obtain ⟨kh, hkh⟩ := kerCol_sdcol S
    have hcdef : c = underCol S.sd.col ((underCol kh)^[j - 1] ⟨[], 0⟩) := by
      rw [phaseCol_eq_iterate S hkh (kerCol_rdcol S)] at hc
      exact (Option.some.inj hc).symm
    exact phase_stack_sd_F7 S hj hkh hcdef hx ho rfl

-- L-G010.4, phase region (D7; L-G010.4b): above `r`, phase-`φ` material is copied edge by edge
theorem respEdge_phase_D7 (S : OrdStep) {j φ : Nat} (hj : 1 ≤ j ∧ j ≤ S.n) {a c : ColAddr}
    (hp : PhasePair_D7 S j a c φ) {W : List (WithTop Key)} (hT : ∀ w ∈ W, w ≠ ⊤) {x : Nat}
    (hx : S.sd.r < x) :
    respEdge S.B (activeKeys_D7 S.B c) c (kappaQ S.sd.r S.d φ W) (x + φ * S.d) =
      (respEdge S.A (activeKeys_D7 S.A a) a W x).map (shiftVal S.sd.r (φ * S.d)) := by
  obtain ⟨-, hnum⟩ := phasePair_num_D7 S hj hp
  by_cases hxa : x < a.num 0
  · obtain ⟨o, ho⟩ : ∃ o, a.resolve 0 x = some o :=
      Option.isSome_iff_exists.mp ((ColAddr.resolve_isSome_iff 0 a x).mpr ⟨Nat.zero_le _, hxa⟩)
    obtain ⟨o', ho', hcont, hkeys, hpar⟩ := phase_stack_F7 S hj hp hx ho
    obtain ⟨hks, hksA, hksB, hparv⟩ := activeKeys_rel_F7 hcont hkeys hpar
    exact respEdge_of_rel_F7 hT ho ho' hks hksA hksB hparv
  · have h1 : a.resolve 0 x = none := by
      cases h : a.resolve 0 x with
      | none => rfl
      | some o => exact absurd (ColAddr.resolve_lt h) hxa
    have h2 : c.resolve 0 (x + φ * S.d) = none := by
      cases h : c.resolve 0 (x + φ * S.d) with
      | none => rfl
      | some o => have := ColAddr.resolve_lt h; omega
    simp [respEdge, h1, h2]

-- L-G010.4 (D7; T3.2q step 1, txt:524-530): phase-`φ` material is copied edge by edge, and the
-- fixed region below `r` is shared, for every `⊤`-free query
theorem respEdge_phase_active_D7 (S : OrdStep) {j φ : Nat} (hj : 1 ≤ j ∧ j ≤ S.n) {a c : ColAddr}
    (hp : PhasePair_D7 S j a c φ) {W : List (WithTop Key)} (hT : ∀ w ∈ W, w ≠ ⊤) (x : Nat) :
    (S.sd.r < x → respEdge S.B (activeKeys_D7 S.B c) c (kappaQ S.sd.r S.d φ W) (x + φ * S.d) =
      (respEdge S.A (activeKeys_D7 S.A a) a W x).map (shiftVal S.sd.r (φ * S.d))) ∧
    (x < S.sd.r → respEdge S.B (activeKeys_D7 S.B c) c (kappaQ S.sd.r S.d φ W) x =
      respEdge S.A (activeKeys_D7 S.A a) a W x) :=
  ⟨fun h => respEdge_phase_D7 S hj hp hT h, fun h => respEdge_fixed_D7 S hp hT h⟩

/-- D-G010.4 (F7): an admissible capping of the root's key list: its actual keys, or its actual
keys capped at an entry `u ≥ c_A`. -/
def RootCap_F7 (S : OrdStep) (ks : List (WithTop Key)) : Prop :=
  ks = actualKeys S.A S.rd.col ∨
    ∃ u, S.rd.cursor ≤ u ∧ u < (actualKeys S.A S.rd.col).length ∧
      ks = (actualKeys S.A S.rd.col).take u ++ [⊤]

-- F7 (helper): the root's key lists are `κ`-fixed
theorem rootCap_kappa_F7 (S : OrdStep) {ks : List (WithTop Key)} (hks : RootCap_F7 S ks)
    (φ : Nat) : kappaQ S.sd.r S.d φ ks = ks := by
  obtain ⟨-, -, -, hrnum, -⟩ := rootData_spec S.hsd S.hrd
  have hfix := kappaQ_fix_D7 S.sd.r S.d φ S.A (o := S.rd.col) (by omega)
  rcases hks with rfl | ⟨u, -, -, rfl⟩
  · exact hfix.1
  · exact hfix.2 u

-- F7 (helper): scans of a `κ`-fixed list do not see `κ`
theorem rootCap_cursor_F7 (S : OrdStep) {ks : List (WithTop Key)} (hks : RootCap_F7 S ks)
    (φ : Nat) (W : List (WithTop Key)) :
    cursor ks (kappaQ S.sd.r S.d φ W) = cursor ks W := by
  have := cursor_map (kappaQry_strictMono S.sd.r S.d φ) ks W
  have h2 := rootCap_kappa_F7 S hks φ
  unfold kappaQ at this h2
  rw [h2] at this
  exact this

-- F7 (helper): the query part of the stopping column's keys
theorem sdcol_keys_take_F7 (S : OrdStep) :
    (actualKeys S.A S.sd.col).take S.m = (queryKeys S.sd).map (↑) := by
  obtain ⟨hcol, -, ht, -⟩ := stopData_spec S.hsd
  simp only [actualKeys, hcol, Option.getD_some, List.map_append, queryKeys, List.map_map, ← ht]
  rw [List.take_left' (by simp [OrdStep.m])]
  rfl

-- F7 (helper): the root's actual keys are its root keys
theorem rdcol_keys_F7 (S : OrdStep) :
    actualKeys S.A S.rd.col = (rootKeys S.A S.rd).map (↑) := by
  simp only [actualKeys, rootKeys, List.map_map]
  rfl

-- F7 (helper): the root cursor is the scan of the root's keys against the old complete query
theorem rdcursor_eq_F7 (S : OrdStep) :
    S.rd.cursor = cursor (actualKeys S.A S.rd.col) S.termZ := by
  obtain ⟨-, -, -, -, -, -, hcur, -⟩ := rootData_spec S.hsd S.hrd
  unfold OrdStep.termZ cutQuery
  rw [cursor_nu, sdcol_keys_take_F7, rdcol_keys_F7, cursor_map WithTop.coe_strictMono, hcur]

-- F7 (helper): the complete query is `⊤`-free
theorem termZ_ne_top_F7 (S : OrdStep) : ∀ w ∈ S.termZ, w ≠ ⊤ :=
  ne_top_of_mem_cutQuery_D7 _ _ _

-- F7 (helper): `dropWhile` of an all-true list is empty
theorem dropWhile_all_F7 {β : Type} (p : β → Bool) :
    ∀ (l : List β), (∀ y ∈ l, p y = true) → l.dropWhile p = []
  | [], _ => rfl
  | x :: xs, h => by
    simp only [List.dropWhile, h x (by simp)]
    exact dropWhile_all_F7 p xs (fun y hy => h y (by simp [hy]))

-- F7 (helper): a `⊤` appended to a `⊤`-free list deletes everything
theorem nu_append_top_F7 (l : List (WithTop Key)) (hl : ∀ w ∈ l, w ≠ ⊤) :
    nu (l ++ [⊤]) = [⊤] := by
  rw [nu_append_singleton, nuStep]
  have hall : ∀ y ∈ (nu l).reverse, decide (y < ⊤) = true := by
    intro y hy
    rw [List.mem_reverse] at hy
    have := hl y ((nu_sublist l).subset hy)
    simpa [lt_top_iff_ne_top] using this
  rw [dropWhile_all_F7 _ _ hall]
  rfl

-- F7 (helper): every `⊤`-free list is below `[⊤]`
theorem lt_top_singleton_F7 (W : List (WithTop Key)) (hW : ∀ w ∈ W, w ≠ ⊤) : W < [⊤] := by
  cases W with
  | nil => exact List.nil_lt_cons _ _
  | cons w ws =>
    have : w < ⊤ := lt_top_iff_ne_top.mpr (hW w (by simp))
    exact List.Lex.rel this

-- L-G010.7 (F7): the head hypotheses of `head_cursor` for an admissible root capping
theorem rootCap_headHyp_F7 (S : OrdStep) {ks : List (WithTop Key)} (hks : RootCap_F7 S ks) :
    S.rd.cursor ≤ ks.length ∧ cutQuery ks S.rd.cursor ≤ S.termZ ∧
      (S.rd.cursor < ks.length → S.termZ < cutQuery ks (S.rd.cursor + 1)) := by
  have hcur := rdcursor_eq_F7 S
  have hZn : Noninc S.termZ := cutQuery_noninc _ _
  obtain ⟨h1, h2⟩ := cursor_spec (actualKeys S.A S.rd.col) S.termZ hZn
  rw [← hcur] at h1 h2
  have hle := cursor_le_length (actualKeys S.A S.rd.col) S.termZ
  rw [← hcur] at hle
  rcases hks with rfl | ⟨u, hu1, hu2, rfl⟩
  · exact ⟨hle, h1, h2⟩
  · have hlen : ((actualKeys S.A S.rd.col).take u ++ [⊤]).length = u + 1 := by
      simp only [List.length_append, List.length_take, List.length_singleton]; omega
    refine ⟨by omega, ?_, fun _ => ?_⟩
    · have : cutQuery ((actualKeys S.A S.rd.col).take u ++ [⊤]) S.rd.cursor =
          cutQuery (actualKeys S.A S.rd.col) S.rd.cursor := by
        unfold cutQuery
        rw [List.take_append_of_le_length (by simp; omega), List.take_take, Nat.min_eq_left hu1]
      rw [this]; exact h1
    · rcases Nat.eq_or_lt_of_le hu1 with heq | hlt
      · subst heq
        unfold cutQuery
        rw [List.take_of_length_le (by rw [hlen]), nu_append_top_F7]
        · exact lt_top_singleton_F7 _ (termZ_ne_top_F7 S)
        · intro w hw
          have := List.mem_of_mem_take hw
          simp only [actualKeys, List.mem_map] at this
          obtain ⟨x, -, rfl⟩ := this
          exact WithTop.coe_ne_top
      · have : cutQuery ((actualKeys S.A S.rd.col).take u ++ [⊤]) (S.rd.cursor + 1) =
            cutQuery (actualKeys S.A S.rd.col) (S.rd.cursor + 1) := by
          unfold cutQuery
          rw [List.take_append_of_le_length (by simp; omega), List.take_take,
            Nat.min_eq_left (by omega)]
        rw [this]; exact h2 (by omega)

-- L-G010.8 (F7): below the complete query every admissible root capping scans like the root,
-- and stops at or before `c_A`
theorem rootCap_low_F7 (S : OrdStep) {ks : List (WithTop Key)} (hks : RootCap_F7 S ks)
    {W : List (WithTop Key)} (hW : Noninc W) (hT : ∀ w ∈ W, w ≠ ⊤) (hlow : W < S.termZ) :
    cursor ks W = cursor (actualKeys S.A S.rd.col) W ∧
      cursor (actualKeys S.A S.rd.col) W ≤ S.rd.cursor := by
  have hcur := rdcursor_eq_F7 S
  have hZn : Noninc S.termZ := cutQuery_noninc _ _
  have hle : cursor (actualKeys S.A S.rd.col) W ≤ S.rd.cursor := by
    rw [hcur]; exact cursor_mono _ hW hZn hlow.le
  refine ⟨?_, hle⟩
  rcases hks with rfl | ⟨u, hu1, hu2, rfl⟩
  · rfl
  · obtain ⟨-, -, h2⟩ := rootCap_headHyp_F7 S (Or.inl rfl)
    have hlt : W < cutQuery (actualKeys S.A S.rd.col) (u + 1) :=
      lt_of_lt_of_le (lt_of_lt_of_le hlow (le_of_lt (h2 (by omega))))
        (cutQuery_mono _ (by omega))
    exact ((cursor_cappedAt _ W u hu2 hW hT hlt).2).symm


-- F7 (helper): the number of the head of layer `h ≥ 1` is `s_h`
theorem num_headCol_F7 (S : OrdStep) {h : Nat} (hh : 1 ≤ h) : (S.headCol h).num 0 = S.s h := by
  obtain ⟨-, -, -, hrnum, -⟩ := rootData_spec S.hsd S.hrd
  rw [num_phaseCol S.inL S.kind S.hsd S.hrd (Or.inl rfl) hh (phaseCol_headCol S h), hrnum]
  simp [phaseOff, isQMat_rdcol, OrdStep.s, OrdStep.d]

-- F7 (helper): the head `⟨[], 0⟩` is on the stack of the kernel hole, and contains it exactly
-- when the root contains the stopping column (through the restored image of that entry)
theorem kerHole_head_F7 (S : OrdStep) {kh : ColAddr} (hkh : kerCol S.sd S.rd S.sd.col = some kh) :
    kh.OnStack ⟨[], 0⟩ ∧ (⟨[], 0⟩ : ColAddr).container kh =
      (S.rd.col.container S.sd.col).map (fun e => ⟨⟨[], 0⟩, S.m + (e.idx - S.rd.cursor)⟩) := by
  obtain ⟨hres, hrnum, -⟩ := rootData_path S.hsd S.hrd
  have hsdq : isQMat S.sd S.sd.col = false := isQMat_of_short S.sd le_rfl
  have hsd_rd : S.sd.col.OnStack S.rd.col := ((ColAddr.resolve_spec 0 _ _ _).mp hres).1
  refine ⟨(onStack_kerCol_tail S hkh hsdq _).mpr ⟨S.rd.col, hsd_rd, by rw [hrnum],
    isQMat_rdcol S, kerCol_rdcol S⟩, ?_⟩
  rw [container_kerCol S hkh (kerCol_rdcol S) hsdq]
  simp

-- L-G010.5 (F7, the stack part): the heads `s_1, …, s_φ` are on the stack of the copy `c` of a
-- phase pair; below layer `j` a head contains `c` exactly when the root contains the stopping
-- column, and at layer `j` (root-tail template) exactly when the root contains `a`, through the
-- restored image of the same entry
theorem head_stack_F7 (S : OrdStep) {j φ : Nat} (hj : 1 ≤ j ∧ j ≤ S.n) {a c : ColAddr}
    (hp : PhasePair_D7 S j a c φ) {h : Nat} (hh1 : 1 ≤ h) (hh : h ≤ φ) :
    c.resolve 0 (S.s h) = some (S.headCol h) ∧
      (h < j → (S.headCol h).container c = (S.rd.col.container S.sd.col).map
        (fun e => ⟨S.headCol h, S.m + (e.idx - S.rd.cursor)⟩)) ∧
      (h = j → IsTmplCol S.A S.sd S.rd a ∧ isQMat S.sd a = false ∧
        (S.headCol h).container c = (S.rd.col.container a).map
          (fun e => ⟨S.headCol h, S.m + (e.idx - S.rd.cursor)⟩)) := by
  obtain ⟨hres, hrnum, -⟩ := rootData_path S.hsd S.hrd
  obtain ⟨kh, hkh⟩ := kerCol_sdcol S
  obtain ⟨hkh0, hkhc⟩ := kerHole_head_F7 S hkh
  -- the copy as a placement of `b₀`
  obtain ⟨b₀, hcdef, hφj, hjcase⟩ : ∃ b₀, c = underCol S.sd.col ((underCol kh)^[j - 1] b₀) ∧
      φ ≤ j ∧ (h = j → IsTmplCol S.A S.sd S.rd a ∧ isQMat S.sd a = false ∧
        kerCol S.sd S.rd a = some b₀) := by
    rcases hp with ⟨ha, hc, rfl⟩ | ⟨rfl, hc, rfl⟩
    · obtain ⟨b₀, hb₀⟩ := Option.isSome_iff_exists.mp ha.2.2.2
      refine ⟨b₀, ?_, by unfold phaseOff; split_ifs <;> omega, fun hhj => ⟨ha, ?_, hb₀⟩⟩
      · rw [phaseCol_eq_iterate S hkh hb₀] at hc; exact (Option.some.inj hc).symm
      · cases hq : isQMat S.sd a
        · rfl
        · simp only [phaseOff, hq, if_true] at hh; omega
    · refine ⟨⟨[], 0⟩, ?_, by omega, fun hhj => by omega⟩
      rw [phaseCol_eq_iterate S hkh (kerCol_rdcol S)] at hc; exact (Option.some.inj hc).symm
  have hhj : h ≤ j := by omega
  have hsplit : (underCol kh)^[j - 1] b₀ = (underCol kh)^[h - 1] ((underCol kh)^[j - h] b₀) := by
    rw [← Function.iterate_add_apply]
    congr 1
    omega
  have hhead := headCol_eq S hkh h
  -- `Z = G^{j−h} b₀` has the head on its stack; its containment by the head
  have hZ : ((underCol kh)^[j - h] b₀).OnStack ⟨[], 0⟩ ∧
      (h < j → (⟨[], 0⟩ : ColAddr).container ((underCol kh)^[j - h] b₀) =
        (S.rd.col.container S.sd.col).map (fun e => ⟨⟨[], 0⟩, S.m + (e.idx - S.rd.cursor)⟩)) ∧
      (h = j → (⟨[], 0⟩ : ColAddr).container ((underCol kh)^[j - h] b₀) =
        (S.rd.col.container a).map (fun e => ⟨⟨[], 0⟩, S.m + (e.idx - S.rd.cursor)⟩)) := by
    rcases Nat.eq_or_lt_of_le hhj with heq | hlt
    · obtain ⟨ha, haq, hb₀⟩ := hjcase heq
      rw [heq, Nat.sub_self, Function.iterate_zero_apply]
      refine ⟨(onStack_kerCol_tail S hb₀ haq _).mpr ⟨S.rd.col, onStack_rdcol S hb₀ haq ha.2.2.1,
        by rw [hrnum], isQMat_rdcol S, kerCol_rdcol S⟩, fun h' => by omega, fun _ => ?_⟩
      rw [container_kerCol S hb₀ (kerCol_rdcol S) haq]
      simp
    · obtain ⟨k, hk⟩ : ∃ k, j - h = k + 1 := ⟨j - h - 1, by omega⟩
      rw [hk, Function.iterate_succ_apply']
      refine ⟨(onStack_underCol kh _ _).mpr (Or.inl hkh0), fun _ => ?_, fun h' => by omega⟩
      rw [container_underCol_of_onStack hkh0, hkhc]
  have hst : c.OnStack (S.headCol h) := by
    rw [hcdef, hhead, hsplit]
    exact (onStack_underCol _ _ _).mpr (Or.inr ⟨_, iterate_underCol_onStack kh (h - 1) hZ.1, rfl⟩)
  have hcont : (S.headCol h).container c =
      ((⟨[], 0⟩ : ColAddr).container ((underCol kh)^[j - h] b₀)).map
        (fun e => ⟨S.headCol h, e.idx⟩) := by
    rw [hcdef, hhead, hsplit, container_underCol, iterate_underCol_container, Option.map_map]
    rfl
  refine ⟨(ColAddr.resolve_spec 0 _ _ _).mpr ⟨hst, num_headCol_F7 S hh1⟩, fun hlt => ?_,
    fun heq => ?_⟩
  · rw [hcont, hZ.2.1 hlt, Option.map_map]; rfl
  · obtain ⟨ha, haq, -⟩ := hjcase heq
    refine ⟨ha, haq, ?_⟩
    rw [hcont, hZ.2.2 heq, Option.map_map]; rfl


-- L-G010.5 (F7, the content part): the head of layer `h` holds the phase-`(h−1)` copy of the
-- query, then the restored root suffix: parents `R[c_A:]`, keys those of `R[c_A:]` except
-- possibly the last (a continuation, owner case)
theorem head_content_F7 (S : OrdStep) {h : Nat} (hh : 1 ≤ h ∧ h ≤ S.n) :
    parents S.B (S.headCol h) =
        ((parents S.A S.sd.col).take S.m).map (shiftVal S.sd.r ((h - 1) * S.d)) ++
          (parents S.A S.rd.col).drop S.rd.cursor ∧
      (actualKeys S.B (S.headCol h)).take S.m =
        kappaQ S.sd.r S.d (h - 1) ((actualKeys S.A S.sd.col).take S.m) ∧
      ((actualKeys S.B (S.headCol h)).drop S.m).length =
        ((actualKeys S.A S.rd.col).drop S.rd.cursor).length ∧
      ∀ v, ¬ (S.rd.owner = true ∧ v + 1 = ((actualKeys S.A S.rd.col).drop S.rd.cursor).length) →
        ((actualKeys S.B (S.headCol h)).drop S.m)[v]? =
          ((actualKeys S.A S.rd.col).drop S.rd.cursor)[v]? := by
  obtain ⟨-, -, -, hrnum, -⟩ := rootData_spec S.hsd S.hrd
  obtain ⟨hmB, hparB, hkeyB⟩ := headQuery_prefix_D7 S hh (phaseCol_headCol S h)
  obtain ⟨col, hBcol, hlen, -, hrest⟩ :=
    colAt_head S.inL S.kind S.hsd S.hrd S.out hh (phaseCol_headCol S h)
  have hm : S.sd.Q.length = S.m := rfl
  have hU : unconsumed S.A S.rd = ((S.A.colAt S.rd.col).getD []).drop S.rd.cursor := rfl
  have hnum := num_headCol_F7 S hh.1
  have hBpar : parents S.B (S.headCol h) = col.map Prod.fst := by simp [parents, hBcol]
  have hBkeys : actualKeys S.B (S.headCol h) =
      col.map (fun x => ((relKey (S.s h) x.2 : Key) : WithTop Key)) := by
    simp [actualKeys, hBcol, hnum]
  have hUlen : ((actualKeys S.A S.rd.col).drop S.rd.cursor).length =
      (unconsumed S.A S.rd).length := by
    rw [hU]; simp [actualKeys]
  -- the restored entries
  have hent : ∀ v, v < (unconsumed S.A S.rd).length → ∃ x y, (unconsumed S.A S.rd)[v]? = some x ∧
      col[S.m + v]? = some y ∧ y.1 = x.1 ∧
      (¬ (S.rd.owner = true ∧ v + 1 = (unconsumed S.A S.rd).length) → y.2 = shift S.sd.r (h * S.d) x.2) := by
    intro v hv
    obtain ⟨y, hy, hy1, hy2⟩ := hrest v _ (List.getElem?_eq_getElem hv)
    exact ⟨_, y, List.getElem?_eq_getElem hv, hy, hy1, fun hn => by rw [hy2 hn]; rfl⟩
  have hdropLen : (col.drop S.m).length = (unconsumed S.A S.rd).length := by
    rw [List.length_drop, hlen, hm]; omega
  refine ⟨?_, hkeyB, ?_, ?_⟩
  · have hdrop : (parents S.B (S.headCol h)).drop S.m = (parents S.A S.rd.col).drop S.rd.cursor := by
      apply List.ext_getElem?
      intro v
      rw [hBpar, ← List.map_drop, List.getElem?_map, List.getElem?_drop]
      have hpd : (parents S.A S.rd.col).drop S.rd.cursor = (unconsumed S.A S.rd).map Prod.fst := by
        rw [hU]; simp [parents, List.map_drop]
      rw [hpd, List.getElem?_map]
      by_cases hv : v < (unconsumed S.A S.rd).length
      · obtain ⟨x, y, hx, hy, hxy, -⟩ := hent v hv
        rw [hx, hy]; simp [hxy]
      · rw [List.getElem?_eq_none (by omega), List.getElem?_eq_none (by omega)]
    rw [← List.take_append_drop S.m (parents S.B (S.headCol h)), hparB, hdrop]
  · rw [hBkeys, ← List.map_drop, List.length_map, hdropLen, hUlen]
  · intro v hn
    rw [hUlen] at hn
    rw [hBkeys, ← List.map_drop, List.getElem?_map, List.getElem?_drop]
    have hkd : (actualKeys S.A S.rd.col).drop S.rd.cursor =
        (unconsumed S.A S.rd).map (fun x => ((relKey S.sd.r x.2 : Key) : WithTop Key)) := by
      rw [hU]; simp [actualKeys, List.map_drop, hrnum]
    rw [hkd, List.getElem?_map]
    by_cases hv : v < (unconsumed S.A S.rd).length
    · obtain ⟨x, y, hx, hy, -, hy2⟩ := hent v hv
      rw [hx, hy]
      simp only [Option.map_some, Option.some.injEq, WithTop.coe_inj]
      rw [hy2 hn]
      have : S.s h = S.sd.r + h * S.d := rfl
      rw [this, relKey_shift S.sd.r S.d h S.sd.r le_rfl, kappa_fix S.sd.r S.d h S.sd.r le_rfl]
    · rw [List.getElem?_eq_none (by omega), List.getElem?_eq_none (by omega)]; rfl


-- F7 (helper): a container entry of a column of `E` exists
theorem container_idx_lt_F7 {E : Forest} {o a : ColAddr} {e : EntryAddr} (ha : a ∈ E.colAddrs)
    (he : o.container a = some e) : e.idx < (actualKeys E o).length := by
  have hc := (ColAddr.container_spec _ _ _).mp he
  have hmem := mem_entryAddrs_of_contains ha hc.2
  have hent := (Tree.mem_entryAddrs_iff _ _).mp hmem
  unfold Tree.entryAt at hent
  rw [hc.1] at hent
  rw [length_actualKeys]
  cases hco : E.colAt o with
  | none => rw [hco] at hent; cases hent
  | some col =>
    rw [hco] at hent
    simp only [Option.bind_some, Option.getD_some] at hent ⊢
    exact (List.getElem?_eq_some_iff.mp (Option.get_mem hent)).1

-- L-G010.5 (F7, keys of a head): uncapped (body case) and capped at a restored entry
theorem head_keys_F7 (S : OrdStep) {h : Nat} (hh : 1 ≤ h ∧ h ≤ S.n) :
    (S.rd.owner = false → actualKeys S.B (S.headCol h) =
      kappaQ S.sd.r S.d (h - 1) ((actualKeys S.A S.sd.col).take S.m) ++
        (actualKeys S.A S.rd.col).drop S.rd.cursor) ∧
    ∀ u, S.rd.cursor ≤ u → u < (actualKeys S.A S.rd.col).length →
      (actualKeys S.B (S.headCol h)).take (S.m + (u - S.rd.cursor)) ++ [⊤] =
        kappaQ S.sd.r S.d (h - 1) ((actualKeys S.A S.sd.col).take S.m) ++
          ((actualKeys S.A S.rd.col).take u ++ [⊤]).drop S.rd.cursor := by
  obtain ⟨-, hkeyB, hlenB, hentB⟩ := head_content_F7 S hh
  refine ⟨fun hown => ?_, fun u hu1 hu2 => ?_⟩
  · rw [← List.take_append_drop S.m (actualKeys S.B (S.headCol h)), hkeyB]
    congr 1
    apply List.ext_getElem?
    intro v
    exact hentB v (by rw [hown]; simp)
  · rw [List.take_add, hkeyB, List.append_assoc]
    congr 1
    rw [List.drop_append_of_le_length (by simp; omega), List.drop_take]
    congr 1
    apply List.ext_getElem?
    intro v
    rw [List.getElem?_take, List.getElem?_take]
    split_ifs with hv
    · exact hentB v (by simp; omega)
    · rfl

-- L-G010.5 (F7; `activeKeys_head`): at a head `s_h`, `1 ≤ h ≤ φ`, the copy's capped keys are the
-- phase-`(h−1)` query keys followed by an admissible root capping from `c_A` on (the capping of
-- `a`'s root at `h = φ`), and the parents are the shifted query parents, then `R[c_A:]`
theorem activeKeys_head_F7 (S : OrdStep) {j φ : Nat} (hj : 1 ≤ j ∧ j ≤ S.n) {a c : ColAddr}
    (hp : PhasePair_D7 S j a c φ) {h : Nat} (hh1 : 1 ≤ h) (hh : h ≤ φ) :
    ∃ ks, c.resolve 0 (S.s h) = some (S.headCol h) ∧ RootCap_F7 S ks ∧
      (h = φ → ks = activeKeys_D7 S.A a S.rd.col) ∧
      activeKeys_D7 S.B c (S.headCol h) =
        kappaQ S.sd.r S.d (h - 1) ((actualKeys S.A S.sd.col).take S.m) ++ ks.drop S.rd.cursor ∧
      parents S.B (S.headCol h) =
        ((parents S.A S.sd.col).take S.m).map (shiftVal S.sd.r ((h - 1) * S.d)) ++
          (parents S.A S.rd.col).drop S.rd.cursor := by
  obtain ⟨hres, -, -, hpre, -, hown, hlast⟩ := rootData_path S.hsd S.hrd
  have hφj : φ ≤ j := by
    rcases hp with ⟨-, -, rfl⟩ | ⟨-, -, rfl⟩
    · unfold phaseOff; split_ifs <;> omega
    · omega
  have hhn : 1 ≤ h ∧ h ≤ S.n := ⟨hh1, by omega⟩
  obtain ⟨hst, hlt, heq⟩ := head_stack_F7 S hj hp hh1 hh
  obtain ⟨hparB, -⟩ := head_content_F7 S hhn
  obtain ⟨hbody, hcap⟩ := head_keys_F7 S hhn
  have hlenR : (actualKeys S.A S.rd.col).length = ((S.A.colAt S.rd.col).getD []).length :=
    length_actualKeys _ _
  -- the capped form of an entry `u ≥ c_A`
  have hcapped : ∀ e : EntryAddr, S.rd.cursor ≤ e.idx → e.idx < (actualKeys S.A S.rd.col).length →
      (S.headCol h).container c = some ⟨S.headCol h, S.m + (e.idx - S.rd.cursor)⟩ →
      activeKeys_D7 S.B c (S.headCol h) =
        kappaQ S.sd.r S.d (h - 1) ((actualKeys S.A S.sd.col).take S.m) ++
          ((actualKeys S.A S.rd.col).take e.idx ++ [⊤]).drop S.rd.cursor := by
    intro e h1 h2 hce
    simp only [activeKeys_D7, hce]
    exact hcap e.idx h1 h2
  have hbody' : S.rd.owner = false → (S.headCol h).container c = none →
      activeKeys_D7 S.B c (S.headCol h) =
        kappaQ S.sd.r S.d (h - 1) ((actualKeys S.A S.sd.col).take S.m) ++
          (actualKeys S.A S.rd.col).drop S.rd.cursor := by
    intro ho hce
    simp only [activeKeys_D7, hce]
    exact hbody ho
  rcases Nat.lt_or_ge h j with hhj | hhj
  · -- below layer `j`: the head contains `c` iff the root contains the stopping column
    have hce := hlt hhj
    -- at `h = φ` the pair is Q-material or the head pair: `R` contains `a` as it contains `sd.col`
    have hRa : h = φ → S.rd.col.container a = S.rd.col.container S.sd.col := by
      intro hhφ
      rcases hp with ⟨ha, hc, rfl⟩ | ⟨rfl, -, -⟩
      · have haq : isQMat S.sd a = true := by
          cases hq : isQMat S.sd a
          · simp only [phaseOff, hq, Bool.false_eq_true, if_false] at hhφ; omega
          · rfl
        obtain ⟨a₀, ha₀⟩ := Option.isSome_iff_exists.mp ha.2.2.2
        rw [qmat_underCol_F7 S haq ha₀]
        exact container_underCol_of_onStack ((ColAddr.resolve_spec 0 _ _ _).mp hres).1 a₀
      · rfl
    cases hRs : S.rd.col.container S.sd.col with
    | none =>
      have ho : S.rd.owner = false := by
        cases h' : S.rd.owner
        · rfl
        · have := hown.mp h'; rw [hRs] at this; cases this
      rw [hRs, Option.map_none] at hce
      refine ⟨actualKeys S.A S.rd.col, hst, Or.inl rfl, fun hhφ => ?_, hbody' ho hce, hparB⟩
      simp only [activeKeys_D7, hRa hhφ, hRs]
    | some e =>
      rw [hRs, Option.map_some] at hce
      have hl := hlast e hRs
      unfold Packet.rootLenOf at hl
      have ho : S.rd.owner = true := hown.mpr (by rw [hRs]; rfl)
      have hkd := S.kernelDefined ho
      have hcA : S.rd.cursor < (actualKeys S.A S.rd.col).length := by
        unfold unconsumed rootCol at hkd
        rw [hlenR]
        by_contra hcon
        exact hkd (List.drop_eq_nil_of_le (by omega))
      refine ⟨(actualKeys S.A S.rd.col).take e.idx ++ [⊤], hst,
        Or.inr ⟨e.idx, by omega, by omega, rfl⟩, fun hhφ => ?_,
        hcapped e (by omega) (by omega) hce, hparB⟩
      simp only [activeKeys_D7, hRa hhφ, hRs]
  · -- at layer `j`: a root-tail template, contained by the head iff by the root
    have hhj' : h = j := by omega
    obtain ⟨ha, haq, hce⟩ := heq hhj'
    obtain ⟨a₀, ha₀⟩ := Option.isSome_iff_exists.mp ha.2.2.2
    obtain ⟨suf, hsuf, hcases⟩ := kerCol_tail_spec S ha₀ haq
    have hφ : h = φ := by
      rcases hp with ⟨-, -, rfl⟩ | ⟨rfl, -, -⟩
      · simp only [phaseOff, haq, Bool.false_eq_true, if_false]; omega
      · exact absurd ha.2.1 (by simp)
    cases hRa : S.rd.col.container a with
    | none =>
      have ho : S.rd.owner = false := by
        rcases hcases with ⟨rfl, hc, -⟩ | ⟨-, -, ho, -⟩ | ⟨e, rest, rfl, -, -⟩ | ⟨-, -, -, -, -, ho, -⟩
        · exfalso; apply ha.2.2.1
          show (⟨a.path, a.col⟩ : ColAddr) = ⟨S.rd.col.path, S.rd.col.col⟩
          rw [hsuf, hc, List.append_nil]
        · exact ho
        · exfalso
          have : S.rd.col.container a = some ⟨S.rd.col, e⟩ :=
            (ColAddr.container_spec _ _ _).mpr ⟨rfl, ⟨rest, by simp [EntryAddr.heightPath, hsuf]⟩⟩
          rw [hRa] at this; cases this
        · exact ho
      rw [hRa, Option.map_none] at hce
      refine ⟨actualKeys S.A S.rd.col, hst, Or.inl rfl, fun _ => ?_, hbody' ho hce, hparB⟩
      simp only [activeKeys_D7, hRa]
    | some e =>
      rw [hRa, Option.map_some] at hce
      have hcA : S.rd.cursor ≤ e.idx := by
        obtain ⟨he1, t, ht⟩ := (ColAddr.container_spec _ _ _).mp hRa
        rw [EntryAddr.heightPath, he1, List.append_assoc, hsuf] at ht
        have ht' := List.append_cancel_left ht
        rcases hcases with ⟨rfl, -, -⟩ | ⟨rfl, -, -, -⟩ | ⟨e', rest, rfl, he', -⟩ |
            ⟨ci, e', rest, rfl, hci, -, -⟩
        · simp at ht'
        · simp at ht'
        · simp only [List.singleton_append, List.cons.injEq, Prod.mk.injEq, true_and] at ht'
          omega
        · simp only [List.singleton_append, List.cons.injEq, Prod.mk.injEq] at ht'
          omega
      have hlt' := container_idx_lt_F7 ha.1 hRa
      refine ⟨(actualKeys S.A S.rd.col).take e.idx ++ [⊤], hst,
        Or.inr ⟨e.idx, hcA, hlt', rfl⟩, fun _ => ?_, hcapped e hcA hlt' hce, hparB⟩
      simp only [activeKeys_D7, hRa]


-- F7 (helper): `κ_j` preserves and reflects `≤` of queries
theorem kappaQ_le_iff_F7 (r d j : Nat) (W Z : List (WithTop Key)) :
    kappaQ r d j W ≤ kappaQ r d j Z ↔ W ≤ Z := by
  rw [← not_lt, ← not_lt, kappaQ_lt_iff]

-- F7 (helper): the query part of the stopping column has `m` keys
theorem length_sdcol_take_F7 (S : OrdStep) : ((actualKeys S.A S.sd.col).take S.m).length = S.m := by
  obtain ⟨hcol, -⟩ := stopData_spec S.hsd
  rw [List.length_take, length_actualKeys, hcol]
  simp [OrdStep.m]

-- F7 (helper): `head_cursor` at a head of layer `h ≥ 1` with an admissible root capping, at the
-- query `κ_{h−1}(W')`
theorem head_scan_F7 (S : OrdStep) {ks : List (WithTop Key)} (hks : RootCap_F7 S ks) (h : Nat)
    {W' : List (WithTop Key)} (hW' : Noninc W') :
    (W' < S.termZ → cursor (kappaQ S.sd.r S.d h ((actualKeys S.A S.sd.col).take S.m) ++
        ks.drop S.rd.cursor) (kappaQ S.sd.r S.d h W') < S.m) ∧
    (S.termZ ≤ W' → S.rd.cursor ≤ cursor ks W' ∧
      cursor (kappaQ S.sd.r S.d h ((actualKeys S.A S.sd.col).take S.m) ++ ks.drop S.rd.cursor)
        (kappaQ S.sd.r S.d h W') = S.m + (cursor ks W' - S.rd.cursor)) := by
  obtain ⟨hc, h1, h2⟩ := rootCap_headHyp_F7 S hks
  have hfix := rootCap_kappa_F7 S hks h
  have hnu : nu (kappaQ S.sd.r S.d h ((actualKeys S.A S.sd.col).take S.m)) =
      kappaQ S.sd.r S.d h S.termZ := by
    unfold kappaQ OrdStep.termZ cutQuery
    rw [nu_map (kappaQry_strictMono _ _ _)]
  have hcq : ∀ k, cutQuery ks k = kappaQ S.sd.r S.d h (cutQuery ks k) := by
    intro k
    conv_lhs => rw [← hfix]
    unfold kappaQ
    rw [cutQuery_map (kappaQry_strictMono _ _ _)]
  have H := head_cursor (V := kappaQ S.sd.r S.d h W')
    (kappaQ S.sd.r S.d h ((actualKeys S.A S.sd.col).take S.m)) ks hc
    (by rw [hnu, hcq, kappaQ_le_iff_F7]; exact h1)
    (fun hlt => by rw [hnu, hcq, kappaQ_lt_iff]; exact h2 hlt)
    (kappaQ_noninc _ _ _ hW')
  have hlen : (kappaQ S.sd.r S.d h ((actualKeys S.A S.sd.col).take S.m)).length = S.m := by
    unfold kappaQ; rw [List.length_map, length_sdcol_take_F7]
  refine ⟨fun hlow => ?_, fun hhigh => ?_⟩
  · have := H.1 (by rw [hnu, kappaQ_lt_iff]; exact hlow)
    rwa [hlen] at this
  · have := H.2 (by rw [hnu, kappaQ_le_iff_F7]; exact hhigh)
    rw [rootCap_cursor_F7 S hks, hlen] at this
    exact this

-- L-G010.14 (D7; T3.2q step 2, high case, txt:390-391): a high scan at the head `s_φ` returns the
-- old root response at `W`
theorem respEdge_head_high_D7 (S : OrdStep) {j φ : Nat} (hj : 1 ≤ j ∧ j ≤ S.n) {a c : ColAddr}
    (hp : PhasePair_D7 S j a c φ) (hφ : 1 ≤ φ) {W : List (WithTop Key)} (hW : Noninc W)
    (_hT : ∀ w ∈ W, w ≠ ⊤) (hhigh : S.termZ ≤ kappaQ S.sd.r S.d 1 W) :
    respEdge S.B (activeKeys_D7 S.B c) c (kappaQ S.sd.r S.d φ W) (S.s φ) =
      respEdge S.A (activeKeys_D7 S.A a) a W S.sd.r := by
  obtain ⟨ks, hst, hRC, hkseq, hkeys, hpar⟩ := activeKeys_head_F7 S hj hp hφ le_rfl
  obtain ⟨hRa, -⟩ := phasePair_root_D7 S hp
  have hks := hkseq rfl
  have hV : kappaQ S.sd.r S.d φ W = kappaQ S.sd.r S.d (φ - 1) (kappaQ S.sd.r S.d 1 W) := by
    rw [kappaQ_add, show φ - 1 + 1 = φ by omega]
  obtain ⟨hge, hcur⟩ := (head_scan_F7 S hRC (φ - 1) (kappaQ_noninc _ _ 1 hW)).2 hhigh
  rw [rootCap_cursor_F7 S hRC] at hge hcur
  unfold respEdge
  rw [hst, hRa]
  simp only [Option.bind_some]
  rw [resp_eq_parents, resp_eq_parents, hkeys, hV, hcur, hpar, ← hks]
  have hlm : (((parents S.A S.sd.col).take S.m).map (shiftVal S.sd.r ((φ - 1) * S.d))).length =
      S.m := by
    have := length_sdcol_take_F7 S
    rw [List.length_take] at this
    rw [List.length_map, List.length_take, length_parents_F7, this]
  rw [List.getElem?_append_right (by omega), hlm, Nat.add_sub_cancel_left, List.getElem?_drop,
    Nat.add_sub_cancel' hge]

-- L-G010.14 corollary (D7): the old root response lies below `r`
theorem respEdge_root_lt_D7 (S : OrdStep) {j φ : Nat} (_hj : 1 ≤ j ∧ j ≤ S.n) {a c : ColAddr}
    (_hp : PhasePair_D7 S j a c φ) (_hφ : 1 ≤ φ) {W : List (WithTop Key)} {p : Nat}
    (he : respEdge S.A (activeKeys_D7 S.A a) a W S.sd.r = some p) : p < S.sd.r :=
  edge_lt S.inL.1 ((edge_iff _ _ _ _ _ _).mpr he)

-- F7 (helper): paths only read the key lists of the columns on the stack
theorem path_congr_F7 {E : Forest} {ks ks' : KeySys} {c : ColAddr} {W : List (WithTop Key)}
    (hks : ∀ x o, c.resolve 0 x = some o → ks o = ks' o) {x y : Nat}
    (h : Path E ks c W x y) : Path E ks' c W x y := by
  induction h with
  | refl => exact Relation.ReflTransGen.refl
  | tail _ he ih =>
    obtain ⟨o, ho, hr⟩ := he
    refine ih.tail ⟨o, ho, ?_⟩
    unfold resp at hr ⊢
    rw [← hks _ _ ho]
    exact hr

-- L-G010.2 (F7): below a stack column `c'` of `c`, the active systems of `c` and `c'` agree
theorem respEdge_activeKeys_onStack_F7 (E : Forest) {c c' : ColAddr} {z : Nat}
    (hc' : c.resolve 0 z = some c') (W : List (WithTop Key)) {x : Nat} (hx : x < z) :
    respEdge E (activeKeys_D7 E c) c W x = respEdge E (activeKeys_D7 E c') c' W x := by
  unfold respEdge
  rw [ColAddr.resolve_of_resolve_lt hc' hx]
  cases ho : c.resolve 0 x with
  | none => rfl
  | some o =>
    simp only [Option.bind_some]
    have hon : o.num 0 = x := ColAddr.resolve_num ho
    have hcc' : c'.path <+: c.path := onStack_prefix ((ColAddr.resolve_spec 0 _ _ _).mp hc').1
    have hcont : o.container c = o.container c' := by
      apply Option.ext
      intro e
      constructor
      · intro he
        obtain ⟨he1, he2⟩ := (ColAddr.container_spec _ _ _).mp he
        have := EntryAddr.contains_of_resolve he2 hc' (by rw [he1]; omega)
        exact (ColAddr.container_spec _ _ _).mpr ⟨he1, this⟩
      · intro he
        obtain ⟨he1, he2⟩ := (ColAddr.container_spec _ _ _).mp he
        exact (ColAddr.container_spec _ _ _).mpr ⟨he1, he2.trans hcc'⟩
    unfold resp
    simp only [activeKeys_D7, hcont]

-- L-G010.2 (F7, path form)
theorem path_activeKeys_onStack_F7 (E : Forest) (hV : CondV E) {c c' : ColAddr} {z : Nat}
    (hc' : c.resolve 0 z = some c') {W : List (WithTop Key)} {x y : Nat} (hx : x < z)
    (h : Path E (activeKeys_D7 E c') c' W x y) : Path E (activeKeys_D7 E c) c W x y := by
  induction h using Relation.ReflTransGen.head_induction_on with
  | refl => exact Relation.ReflTransGen.refl
  | @head x x' hxx' _ ih =>
    have hlt := edge_lt hV hxx'
    rw [edge_iff, ← respEdge_activeKeys_onStack_F7 E hc' W hx] at hxx'
    exact Relation.ReflTransGen.head ((edge_iff _ _ _ _ _ _).mpr hxx') (ih (by omega))

-- L-G010.3 (F7): on the stopping column's stack, the route-capped system of `A` is capped at the
-- active containers of the stopping column
theorem activeKeys_stopCol_F7 (S : OrdStep) {x : Nat} {o : ColAddr}
    (ho : S.sd.col.resolve 0 x = some o) :
    capKeys S.A (routeCols S.A) o = activeKeys_D7 S.A S.sd.col o := by
  obtain ⟨hcol, -, -, hroute, -⟩ := stopData_spec S.hsd
  have hmem : S.sd.col ∈ S.A.colAddrs := by rw [Tree.mem_colAddrs_iff, hcol]; rfl
  cases hce : o.container S.sd.col with
  | some e =>
    have hor : o ∈ routeCols S.A := container_mem_routeCols_D7 hroute hce
    have hl := container_sdcol_last S hce
    rw [length_parents_F7] at hl
    simp only [capKeys, hor, if_true, activeKeys_D7, hce]
    obtain ⟨l, x, hlx⟩ : ∃ l x, actualKeys S.A o = l ++ [x] := by
      cases h : actualKeys S.A o using List.reverseRecOn with
      | nil => rw [h] at hl; simp at hl
      | append_singleton l x _ => exact ⟨l, x, rfl⟩
    rw [hlx] at hl ⊢
    simp only [List.length_append, List.length_singleton] at hl
    rw [List.dropLast_concat, List.getLast?_concat, List.take_left' (by omega)]
    rfl
  | none =>
    have hnr : o ∉ routeCols S.A := by
      intro hor
      obtain ⟨v, -, hv⟩ := routeCols_visible hmem hor ho
      have := (ColAddr.container_spec _ _ _).mpr ⟨rfl, hv⟩
      rw [hce] at this; cases this
    simp only [capKeys, hnr, if_false, activeKeys_D7, hce]

-- G9.3 decorated (F7): at a reduced query `W' < Z` the old terminal answers with a query parent
-- `q`, and `q` reaches `r` by a path in the system capped at the stopping column's active
-- containers (decorated A of `A`, path nesting)
theorem term_detour_active_F7 (S : OrdStep) {W : List (WithTop Key)} (hW : Noninc W)
    (hlow : W < S.termZ) :
    cursor (actualKeys S.A S.sd.col) W < S.m ∧
      ∃ q, (parents S.A S.sd.col)[cursor (actualKeys S.A S.sd.col) W]? = some q ∧
        S.sd.r ≤ q ∧ q < S.sd.t ∧
        Path S.A (activeKeys_D7 S.A S.sd.col) S.sd.col W q S.sd.r := by
  obtain ⟨hj, q, hq, hrq, hqt, -⟩ := term_detour S hW hlow
  refine ⟨hj, q, hq, hrq, hqt, ?_⟩
  obtain ⟨hcol, -⟩ := stopData_spec S.hsd
  have hVA : CondV S.A := S.inL.1
  have hAK : CondAK S.A (capKeys S.A (routeCols S.A)) :=
    capping_forward S.inL.1 S.inL.2.2.2.1 S.inL.2.2.2.2 (fun _ h => h)
  have hpar : parents S.A S.sd.col = S.sd.Q.map Prod.fst ++ [S.sd.r] := by
    simp [parents, hcol]
  have hplen : (parents S.A S.sd.col).length = S.m + 1 := by
    rw [hpar]; simp [OrdStep.m]
  have hclen : ((S.A.colAt S.sd.col).getD []).length = S.m + 1 := by
    rw [hcol]; simp [OrdStep.m]
  have hmem : S.sd.col ∈ S.A.colAddrs := by rw [Tree.mem_colAddrs_iff, hcol]; rfl
  set j := cursor (actualKeys S.A S.sd.col) W with hjdef
  set P : Nat → Nat := fun l => ((parents S.A S.sd.col)[l]?).getD 0 with hP
  have hPget : ∀ l, l ≤ S.m → (parents S.A S.sd.col)[l]? = some (P l) := by
    intro l hl
    have : l < (parents S.A S.sd.col).length := by omega
    simp [hP, List.getElem?_eq_getElem this]
  have hPm : P S.m = S.sd.r := by
    simp [hP, hpar, OrdStep.m]
  have hPj : P j = q := by
    have := hPget j hj.le
    rw [hq] at this
    exact (Option.some.inj this).symm
  have hWlt : W < cutQuery (actualKeys S.A S.sd.col) (j + 1) :=
    (cursor_spec _ W hW).2 (by rw [length_actualKeys, hclen]; omega)
  have hchain : ∀ n, j + n ≤ S.m →
      Path S.A (capKeys S.A (routeCols S.A)) S.sd.col W (P j) (P (j + n)) := by
    intro n
    induction n with
    | zero => intro _; exact Relation.ReflTransGen.refl
    | succ n ih =>
      intro hn
      have h1 := ih (by omega)
      have hA := hAK S.sd.col hmem (j + n + 1) (P (j + n + 1)) (hPget _ hn)
      simp only [Nat.add_one_ne_zero, if_false, Nat.add_sub_cancel] at hA
      rw [cutQuery_capKeys _ _ _ (by rw [hclen]; omega)] at hA
      have hA' : Path S.A (capKeys S.A (routeCols S.A)) S.sd.col
          (cutQuery (actualKeys S.A S.sd.col) (j + n + 1)) (P (j + n)) (P (j + n + 1)) := hA
      have hle : W ≤ cutQuery (actualKeys S.A S.sd.col) (j + n + 1) :=
        le_of_lt (lt_of_lt_of_le hWlt (cutQuery_mono _ (by omega)))
      exact h1.trans (path_nesting_path hVA hAK S.sd.col hW (cutQuery_noninc _ _) hle hA')
  have hqr := hchain (S.m - j) (by omega)
  rw [show j + (S.m - j) = S.m by omega, hPm, hPj] at hqr
  exact path_congr_F7 (fun x o ho => activeKeys_stopCol_F7 S ho) hqr


-- L-G010.4c (F7, path form): below `r` the decorated paths of the copy are old paths
theorem path_fixed_F7 (S : OrdStep) {j φ : Nat} {a c : ColAddr} (hp : PhasePair_D7 S j a c φ)
    {W : List (WithTop Key)} (hT : ∀ w ∈ W, w ≠ ⊤) {x y : Nat} (hx : x < S.sd.r)
    (h : Path S.B (activeKeys_D7 S.B c) c (kappaQ S.sd.r S.d φ W) x y) :
    Path S.A (activeKeys_D7 S.A a) a W x y := by
  have hVB : CondV S.B := condV_ord S.inL S.kind S.out
  induction h using Relation.ReflTransGen.head_induction_on with
  | refl => exact Relation.ReflTransGen.refl
  | @head x x' hxx' _ ih =>
    have hlt := edge_lt hVB hxx'
    rw [edge_iff, respEdge_fixed_D7 S hp hT hx] at hxx'
    exact Relation.ReflTransGen.head ((edge_iff _ _ _ _ _ _).mpr hxx') (ih (by omega))

-- F7 (helper): a vertex whose decorated edge in `B` is the old edge out of `r` leads, along a
-- path to an end below `r`, to an old path from `r`
theorem path_of_root_edge_F7 (S : OrdStep) {j φ : Nat} {a c : ColAddr}
    (hp : PhasePair_D7 S j a c φ) {W : List (WithTop Key)} (hT : ∀ w ∈ W, w ≠ ⊤) {z y : Nat}
    (hzy : y < z)
    (he : respEdge S.B (activeKeys_D7 S.B c) c (kappaQ S.sd.r S.d φ W) z =
      respEdge S.A (activeKeys_D7 S.A a) a W S.sd.r)
    (h : Path S.B (activeKeys_D7 S.B c) c (kappaQ S.sd.r S.d φ W) z y) :
    Path S.A (activeKeys_D7 S.A a) a W S.sd.r y := by
  rcases Relation.ReflTransGen.cases_head h with h0 | ⟨p, hzp, hpy⟩
  · omega
  · rw [edge_iff, he] at hzp
    have hpr : p < S.sd.r := edge_lt S.inL.1 ((edge_iff _ _ _ _ _ _).mpr hzp)
    exact Relation.ReflTransGen.head ((edge_iff _ _ _ _ _ _).mpr hzp)
      (path_fixed_F7 S hp hT hpr hpy)

-- L-G010.6 (F7): the root reads alike in both active systems below the complete query
theorem respEdge_root_low_F7 (S : OrdStep) {j φ : Nat} (hj : 1 ≤ j ∧ j ≤ S.n) {a c : ColAddr}
    (hp : PhasePair_D7 S j a c φ) (hφ : 1 ≤ φ) {W : List (WithTop Key)} (hW : Noninc W)
    (hT : ∀ w ∈ W, w ≠ ⊤) (hlow : kappaQ S.sd.r S.d 1 W < S.termZ) (ψ : Nat) :
    respEdge S.B (activeKeys_D7 S.B c) c (kappaQ S.sd.r S.d ψ W) S.sd.r =
        (parents S.A S.rd.col)[cursor (actualKeys S.A S.rd.col) (kappaQ S.sd.r S.d 1 W)]? ∧
      respEdge S.A (activeKeys_D7 S.A a) a W S.sd.r =
        (parents S.A S.rd.col)[cursor (actualKeys S.A S.rd.col) (kappaQ S.sd.r S.d 1 W)]? := by
  obtain ⟨hRa, hRc, -, b, hb⟩ := phasePair_root_D7 S hp
  obtain ⟨hres, -, -, -, -, hown, hlast⟩ := rootData_path S.hsd S.hrd
  have hsdR : S.sd.col.OnStack S.rd.col := ((ColAddr.resolve_spec 0 _ _ _).mp hres).1
  have hT1 : ∀ w ∈ kappaQ S.sd.r S.d 1 W, w ≠ ⊤ := by
    intro w hw
    simp only [kappaQ, List.mem_map] at hw
    obtain ⟨w', hw', rfl⟩ := hw
    have := hT w' hw'
    cases w' with
    | top => exact absurd rfl this
    | coe k => simp
  have hW1 : Noninc (kappaQ S.sd.r S.d 1 W) := kappaQ_noninc _ _ _ hW
  -- the A side: `a`'s root capping is admissible (L-G010.5 at `h = φ`)
  obtain ⟨ks, -, hRC, hkseq, -⟩ := activeKeys_head_F7 S hj hp hφ le_rfl
  have hksA := hkseq rfl
  -- the B side: `B` keeps the root column, capped as the stopping column's container
  have hE : S.A ≠ Tree.empty := by
    intro h
    have := S.hsd
    rw [h, stopData_eq_none_of_lastCol (Or.inl rfl)] at this
    cases this
  obtain ⟨Z, hB⟩ : ∃ Z, S.B = context S.A S.sd Z := by
    have := expand_eq_iterate hE S.inL.1 S.inL.2.1 S.kind S.hsd S.hrd S.kernelDefined S.n
    rw [S.out] at this
    exact ⟨_, Option.some.inj this⟩
  obtain ⟨hpar, htake, hnone⟩ := colAt_context_onStack S.hsd Z hsdR
  rw [← hB] at hpar htake hnone
  have hcR : S.rd.col.container c = S.rd.col.container S.sd.col := by
    rw [hb]; exact container_underCol_of_onStack hsdR b
  obtain ⟨ksB, hRCB, hksB⟩ : ∃ ksB, RootCap_F7 S ksB ∧ activeKeys_D7 S.B c S.rd.col = ksB := by
    cases hRs : S.rd.col.container S.sd.col with
    | none =>
      refine ⟨actualKeys S.A S.rd.col, Or.inl rfl, ?_⟩
      simp only [activeKeys_D7, hcR, hRs, actualKeys, hnone hRs]
    | some e =>
      have hl := hlast e hRs
      unfold Packet.rootLenOf at hl
      have ho : S.rd.owner = true := hown.mpr (by rw [hRs]; rfl)
      have hkd := S.kernelDefined ho
      have hlenR := length_actualKeys S.A S.rd.col
      have hcA : S.rd.cursor < (actualKeys S.A S.rd.col).length := by
        unfold unconsumed rootCol at hkd
        rw [hlenR]
        by_contra hcon
        exact hkd (List.drop_eq_nil_of_le (by omega))
      refine ⟨(actualKeys S.A S.rd.col).take e.idx ++ [⊤], Or.inr ⟨e.idx, by omega, by omega, rfl⟩, ?_⟩
      simp only [activeKeys_D7, hcR, hRs]
      congr 1
      have h1 := htake e hRs
      simp only [actualKeys, ← List.map_take]
      congr 1
      cases hBo : S.B.colAt S.rd.col with
      | none =>
        cases hAo : S.A.colAt S.rd.col with
        | none => rfl
        | some _ => rw [hBo, hAo] at h1; cases h1
      | some C1 =>
        cases hAo : S.A.colAt S.rd.col with
        | none => rw [hBo, hAo] at h1; cases h1
        | some C2 =>
          rw [hBo, hAo] at h1
          simpa using h1
  have hcurB : cursor ksB (kappaQ S.sd.r S.d ψ W) =
      cursor (actualKeys S.A S.rd.col) (kappaQ S.sd.r S.d 1 W) := by
    rw [rootCap_cursor_F7 S hRCB, ← rootCap_cursor_F7 S hRCB 1]
    exact (rootCap_low_F7 S hRCB hW1 hT1 hlow).1
  have hcurA : cursor ks W = cursor (actualKeys S.A S.rd.col) (kappaQ S.sd.r S.d 1 W) := by
    rw [← rootCap_cursor_F7 S hRC 1]
    exact (rootCap_low_F7 S hRC hW1 hT1 hlow).1
  refine ⟨?_, ?_⟩
  · unfold respEdge
    rw [hRc]
    simp only [Option.bind_some]
    rw [resp_eq_parents, hksB, hcurB, hpar]
  · unfold respEdge
    rw [hRa]
    simp only [Option.bind_some]
    rw [resp_eq_parents, ← hksA, hcurA]


-- F7 (helper): `κ` keeps queries `⊤`-free
theorem kappaQ_ne_top_F7 (r d j : Nat) {W : List (WithTop Key)} (hT : ∀ w ∈ W, w ≠ ⊤) :
    ∀ w ∈ kappaQ r d j W, w ≠ ⊤ := by
  intro w hw
  simp only [kappaQ, List.mem_map] at hw
  obtain ⟨w', hw', rfl⟩ := hw
  have := hT w' hw'
  cases w' with
  | top => exact absurd rfl this
  | coe k => simp

-- L-G010.15 step 2, low case (F7): at a low head `s_h` the decorated path detours along the
-- phase-`(h−1)` copy of the old terminal-to-root path to `s_{h−1}`
theorem head_low_detour_F7 (S : OrdStep) {j φ : Nat} (hj : 1 ≤ j ∧ j ≤ S.n) {a c : ColAddr}
    (hp : PhasePair_D7 S j a c φ) {h : Nat} (hh1 : 1 ≤ h) (hh : h ≤ φ)
    {W' : List (WithTop Key)} (hW' : Noninc W') (hT' : ∀ w ∈ W', w ≠ ⊤) (hlow : W' < S.termZ) :
    Path S.B (activeKeys_D7 S.B c) c (kappaQ S.sd.r S.d (h - 1) W') (S.s h) (S.s (h - 1)) := by
  have hVA : CondV S.A := S.inL.1
  have hVB : CondV S.B := condV_ord S.inL S.kind S.out
  have hφj : φ ≤ j := by
    rcases hp with ⟨-, -, rfl⟩ | ⟨-, -, rfl⟩
    · unfold phaseOff; split_ifs <;> omega
    · omega
  obtain ⟨ks, hst, hRC, -, hkeys, hpar⟩ := activeKeys_head_F7 S hj hp hh1 hh
  obtain ⟨hjm, q, hq, hrq, hqt, hpathA⟩ := term_detour_active_F7 S hW' hlow
  have hdt : S.sd.r + S.d = S.sd.t := by
    have := (rootData_spec S.hsd S.hrd).2.2.2.2.1
    simp only [OrdStep.d, period]; omega
  -- the head edge `s_h → τ_{h−1}(q)`
  have hedge : respEdge S.B (activeKeys_D7 S.B c) c (kappaQ S.sd.r S.d (h - 1) W') (S.s h) =
      some (q + (h - 1) * S.d) := by
    have hcl := (head_scan_F7 S hRC (h - 1) hW').1 hlow
    have hlenq : (kappaQ S.sd.r S.d (h - 1) ((actualKeys S.A S.sd.col).take S.m)).length = S.m := by
      unfold kappaQ; rw [List.length_map, length_sdcol_take_F7]
    have hcur : cursor (kappaQ S.sd.r S.d (h - 1) ((actualKeys S.A S.sd.col).take S.m) ++
        ks.drop S.rd.cursor) (kappaQ S.sd.r S.d (h - 1) W') =
        cursor (actualKeys S.A S.sd.col) W' := by
      have e1 := cursor_take (kappaQ S.sd.r S.d (h - 1) ((actualKeys S.A S.sd.col).take S.m) ++
        ks.drop S.rd.cursor) (kappaQ S.sd.r S.d (h - 1) W') S.m
      rw [List.take_left' hlenq] at e1
      unfold kappaQ at e1
      rw [cursor_map (kappaQry_strictMono _ _ _), cursor_take] at e1
      unfold kappaQ at hcl ⊢
      omega
    unfold respEdge
    rw [hst]
    simp only [Option.bind_some]
    rw [resp_eq_parents, hkeys, hcur, hpar]
    have hlm : (((parents S.A S.sd.col).take S.m).map (shiftVal S.sd.r ((h - 1) * S.d))).length =
        S.m := by
      have := length_sdcol_take_F7 S
      rw [List.length_take] at this
      rw [List.length_map, List.length_take, length_parents_F7, this]
    rw [List.getElem?_append_left (by omega), List.getElem?_map, List.getElem?_take_of_lt hjm, hq]
    simp [shiftVal, hrq]
  -- the copied old path, read in the head's active system
  have hp' : PhasePair_D7 S h S.sd.col (S.headCol h) (h - 1) :=
    Or.inr ⟨rfl, phaseCol_headCol S h, rfl⟩
  have hcopy : ∀ x, Path S.A (activeKeys_D7 S.A S.sd.col) S.sd.col W' x S.sd.r →
      Path S.B (activeKeys_D7 S.B (S.headCol h)) (S.headCol h) (kappaQ S.sd.r S.d (h - 1) W')
        (x + (h - 1) * S.d) (S.sd.r + (h - 1) * S.d) := by
    intro x hx
    induction hx using Relation.ReflTransGen.head_induction_on with
    | refl => exact Relation.ReflTransGen.refl
    | @head x x' hxx' hx'r ih =>
      have hlt := edge_lt hVA hxx'
      have hr' := path_le hVA hx'r
      rw [edge_iff] at hxx'
      have he := respEdge_phase_D7 S ⟨hh1, by omega⟩ hp' hT' (x := x) (by omega)
      rw [hxx'] at he
      have he' : respEdge S.B (activeKeys_D7 S.B (S.headCol h)) (S.headCol h)
          (kappaQ S.sd.r S.d (h - 1) W') (x + (h - 1) * S.d) = some (x' + (h - 1) * S.d) := by
        rw [he]; simp [shiftVal, hr']
      exact Relation.ReflTransGen.head ((edge_iff _ _ _ _ _ _).mpr he') ih
  have hlift := path_activeKeys_onStack_F7 S.B hVB hst
    (x := q + (h - 1) * S.d) (by
      simp only [OrdStep.s]
      have : h * S.d = (h - 1) * S.d + S.d := by rw [← Nat.succ_mul]; congr 1; omega
      omega) (hcopy q hpathA)
  have hs : S.s (h - 1) = S.sd.r + (h - 1) * S.d := rfl
  rw [hs]
  exact Relation.ReflTransGen.head ((edge_iff _ _ _ _ _ _).mpr hedge) hlift

-- L-G010.15 (D7; T3.2q steps 2-3, low case, txt:391-394, 527-530): below the complete query the
-- detours through the heads are deleted: a path from `s_φ` to an end below `r` is an old path
-- from `r`
theorem path_head_low_D7 (S : OrdStep) {j φ : Nat} (hj : 1 ≤ j ∧ j ≤ S.n) {a c : ColAddr}
    (hp : PhasePair_D7 S j a c φ) (hφ : 1 ≤ φ) {W : List (WithTop Key)} (hW : Noninc W)
    (hT : ∀ w ∈ W, w ≠ ⊤) (hlow : kappaQ S.sd.r S.d 1 W < S.termZ) {y : Nat} (hy : y < S.sd.r)
    (hpath : Path S.B (activeKeys_D7 S.B c) c (kappaQ S.sd.r S.d φ W) (S.s φ) y) :
    Path S.A (activeKeys_D7 S.A a) a W S.sd.r y := by
  have hVB : CondV S.B := condV_ord S.inL S.kind S.out
  have hW1 : Noninc (kappaQ S.sd.r S.d 1 W) := kappaQ_noninc _ _ _ hW
  have hT1 := kappaQ_ne_top_F7 S.sd.r S.d 1 hT
  obtain ⟨hrootB, hrootA⟩ := respEdge_root_low_F7 S hj hp hφ hW hT hlow φ
  have key : ∀ h, h ≤ φ →
      Path S.B (activeKeys_D7 S.B c) c (kappaQ S.sd.r S.d φ W) (S.s h) y →
      Path S.A (activeKeys_D7 S.A a) a W S.sd.r y := by
    intro h
    induction h with
    | zero =>
      intro _ hP
      have hs0 : S.s 0 = S.sd.r := by simp [OrdStep.s]
      rw [hs0] at hP
      exact path_of_root_edge_F7 S hp hT hy (hrootB.trans hrootA.symm) hP
    | succ h ih =>
      intro hh hP
      have hV : kappaQ S.sd.r S.d φ W = kappaQ S.sd.r S.d h (kappaQ S.sd.r S.d (φ - h) W) := by
        rw [kappaQ_add, show h + (φ - h) = φ by omega]
      have hsr : S.sd.r < S.s (h + 1) := by
        have hd : 1 ≤ S.d := by
          have := (rootData_spec S.hsd S.hrd).2.2.2.2.1
          simp only [OrdStep.d, period]; omega
        simp only [OrdStep.s]
        have : 1 ≤ (h + 1) * S.d := Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero (by omega) (by omega))
        omega
      by_cases hhi : S.termZ ≤ kappaQ S.sd.r S.d (φ - h) W
      · -- high head: the old root response
        obtain ⟨ks, hst, hRC, -, hkeys, hpar⟩ := activeKeys_head_F7 S hj hp (h := h + 1) (by omega) hh
        obtain ⟨hge, hcur⟩ := (head_scan_F7 S hRC h (kappaQ_noninc _ _ _ hW)).2 hhi
        have hks : cursor ks (kappaQ S.sd.r S.d (φ - h) W) = S.rd.cursor := by
          have h1 : cursor ks (kappaQ S.sd.r S.d (φ - h) W) =
              cursor (actualKeys S.A S.rd.col) (kappaQ S.sd.r S.d 1 W) := by
            rw [rootCap_cursor_F7 S hRC, ← rootCap_cursor_F7 S hRC 1]
            exact (rootCap_low_F7 S hRC hW1 hT1 hlow).1
          have h2 := (rootCap_low_F7 S hRC hW1 hT1 hlow).2
          omega
        have he : respEdge S.B (activeKeys_D7 S.B c) c (kappaQ S.sd.r S.d φ W) (S.s (h + 1)) =
            respEdge S.A (activeKeys_D7 S.A a) a W S.sd.r := by
          rw [hrootA]
          unfold respEdge
          rw [hst]
          simp only [Option.bind_some]
          rw [resp_eq_parents, hkeys, hV, Nat.add_sub_cancel, hcur, hks, Nat.sub_self,
            Nat.add_zero, hpar, Nat.add_sub_cancel]
          have hlm : (((parents S.A S.sd.col).take S.m).map
              (shiftVal S.sd.r (h * S.d))).length = S.m := by
            have := length_sdcol_take_F7 S
            rw [List.length_take] at this
            rw [List.length_map, List.length_take, length_parents_F7, this]
          rw [List.getElem?_append_right (by omega), hlm]
          simp only [Nat.add_zero, Nat.sub_self, List.getElem?_drop]
          have h1 : cursor ks (kappaQ S.sd.r S.d (φ - h) W) =
              cursor (actualKeys S.A S.rd.col) (kappaQ S.sd.r S.d 1 W) := by
            rw [rootCap_cursor_F7 S hRC, ← rootCap_cursor_F7 S hRC 1]
            exact (rootCap_low_F7 S hRC hW1 hT1 hlow).1
          rw [← h1, hks]
        exact path_of_root_edge_F7 S hp hT (by omega) he hP
      · -- low head: the detour to `s_h`
        have hdet := head_low_detour_F7 S hj hp (h := h + 1) (by omega) hh
          (kappaQ_noninc _ _ _ hW) (kappaQ_ne_top_F7 _ _ _ hT) (lt_of_not_ge hhi)
        rw [Nat.add_sub_cancel, ← hV] at hdet
        have hys : y ≤ S.s h := by simp only [OrdStep.s]; omega
        exact ih (by omega) (path_functional hVB hdet hP hys)
  exact key φ le_rfl hpath

-- L-G010.10 (D7; T3.2q.3, G-010): paths in the system capped at the active containers of the
-- copy `c` project to paths in the system capped at the active containers of `a`, for every
-- reduced `⊤`-free query, from every start outside `[r, s_φ)` to every end outside `(r, s_φ)`
theorem head_path_active_D7 (S : OrdStep) {j φ : Nat} (hj : 1 ≤ j ∧ j ≤ S.n) {a c : ColAddr}
    (hp : PhasePair_D7 S j a c φ) (hφ : 1 ≤ φ)
    {W : List (WithTop Key)} (hW : Noninc W) (hT : ∀ w ∈ W, w ≠ ⊤)
    {x y : Nat} (hx : x < S.sd.r ∨ S.s φ ≤ x) (hy : y ≤ S.sd.r ∨ S.s φ ≤ y)
    (hpath : Path S.B (activeKeys_D7 S.B c) c (kappaQ S.sd.r S.d φ W) x y) :
    Path S.A (activeKeys_D7 S.A a) a W (S.proj φ x) (S.proj φ y) := by
  have hVB : CondV S.B := condV_ord S.inL S.kind S.out
  obtain ⟨-, -, -, -, hrt, -⟩ := rootData_spec S.hsd S.hrd
  have hd : 1 ≤ S.d := by simp only [OrdStep.d, period]; omega
  have hφd : 1 ≤ φ * S.d := Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero (by omega) (by omega))
  have hsφ : S.s φ = S.sd.r + φ * S.d := rfl
  -- the projection on the three regions
  have hproj_lt : ∀ z, z ≤ S.sd.r → S.proj φ z = z := by
    intro z hz
    unfold OrdStep.proj
    rw [if_neg (by omega)]
    by_cases h : z = S.s φ
    · omega
    · rw [if_neg h]
  have hproj_s : S.proj φ (S.s φ) = S.sd.r := by
    unfold OrdStep.proj; rw [if_neg (lt_irrefl _), if_pos rfl]
  have hproj_gt : ∀ z, S.sd.r < z → S.proj φ (z + φ * S.d) = z := by
    intro z hz
    unfold OrdStep.proj; rw [if_pos (by omega)]; omega
  have hproj_τ : ∀ z, S.proj φ (shiftVal S.sd.r (φ * S.d) z) = z := by
    intro z
    unfold shiftVal
    by_cases hz : S.sd.r ≤ z
    · rw [if_pos hz]
      rcases Nat.eq_or_lt_of_le hz with h | h
      · rw [← h, ← hsφ, hproj_s]
      · exact hproj_gt z h
    · rw [if_neg hz]; exact hproj_lt z (by omega)
  -- the end projects to itself when it is at most `r`
  revert hx
  induction hpath using Relation.ReflTransGen.head_induction_on with
  | refl => intro _; exact Relation.ReflTransGen.refl
  | @head x x' hxx' hx'y ih =>
    intro hx
    have hx'x : x' < x := edge_lt hVB hxx'
    have hyx' : y ≤ x' := path_le hVB hx'y
    rw [edge_iff] at hxx'
    rcases hx with hxr | hsx
    · -- below `r`: the same edge
      have he := (respEdge_phase_active_D7 S hj hp hT x).2 hxr
      rw [he] at hxx'
      rw [hproj_lt x hxr.le]
      have := ih (Or.inl (by omega))
      rw [hproj_lt x' (by omega)] at this
      exact Relation.ReflTransGen.head ((edge_iff _ _ _ _ _ _).mpr hxx') this
    · rcases Nat.eq_or_lt_of_le hsx with hxs | hxs
      · -- at the head `s_φ`
        subst hxs
        rw [hproj_s]
        have hyr : y ≤ S.sd.r := by
          rcases hy with h | h
          · exact h
          · omega
        rw [hproj_lt y hyr]
        rcases Nat.eq_or_lt_of_le hyr with hyr' | hyr'
        · rw [hyr']; exact Relation.ReflTransGen.refl
        · by_cases hhigh : S.termZ ≤ kappaQ S.sd.r S.d 1 W
          · have he := respEdge_head_high_D7 S hj hp hφ hW hT hhigh
            rw [he] at hxx'
            have hx'r := respEdge_root_lt_D7 S hj hp hφ hxx'
            have := ih (Or.inl hx'r)
            rw [hproj_lt x' hx'r.le, hproj_lt y hyr] at this
            exact Relation.ReflTransGen.head ((edge_iff _ _ _ _ _ _).mpr hxx') this
          · exact path_head_low_D7 S hj hp hφ hW hT (lt_of_not_ge hhigh) hyr'
              (Relation.ReflTransGen.head ((edge_iff _ _ _ _ _ _).mpr hxx') hx'y)
      · -- above `s_φ`: the shifted copy of an old edge
        obtain ⟨z, rfl⟩ : ∃ z, x = z + φ * S.d := ⟨x - φ * S.d, by omega⟩
        have hzr : S.sd.r < z := by omega
        have he := (respEdge_phase_active_D7 S hj hp hT z).1 hzr
        rw [he] at hxx'
        obtain ⟨z', hz', rfl⟩ := Option.map_eq_some_iff.mp hxx'
        rw [hproj_gt z hzr]
        have := ih (by
          rcases shiftVal_dich S.sd.r (φ * S.d) z' with h | h
          · exact Or.inl h
          · exact Or.inr h)
        rw [hproj_τ] at this
        exact Relation.ReflTransGen.head ((edge_iff _ _ _ _ _ _).mpr hz') this

-- L-G010.19/20 (D7): the final test of a pure phase-`φ` cut projects to the old final test
theorem phase_finalTest_D7 (S : OrdStep) {j φ : Nat} (hj : 1 ≤ j ∧ j ≤ S.n) {a c : ColAddr}
    (hp : PhasePair_D7 S j a c φ) (hφ : 1 ≤ φ) {k ρ : Nat}
    (hkA : k ≤ (parents S.A a).length)
    (hpre : (parents S.B c).take k = ((parents S.A a).take k).map (shiftVal S.sd.r (φ * S.d)))
    (hQ : cutQuery (actualKeys S.B c) k = kappaQ S.sd.r S.d φ (cutQuery (actualKeys S.A a) k))
    (hρ : ρ ≤ S.sd.r ∨ S.s φ ≤ ρ)
    (hK : Path S.B (activeKeys_D7 S.B c) c (cutQuery (actualKeys S.B c) k) (cutStart S.B c k) ρ) :
    Path S.A (activeKeys_D7 S.A a) a (cutQuery (actualKeys S.A a) k) (cutStart S.A a k)
      (S.proj φ ρ) := by
  obtain ⟨hra, hnum⟩ := phasePair_num_D7 S hj hp
  obtain ⟨hx, hproj⟩ := cutStart_phase_D7 S hra hnum hkA hpre
  rw [hQ] at hK
  have := head_path_active_D7 S hj hp hφ (cutQuery_noninc _ _) (ne_top_of_mem_cutQuery_D7 _ _ _)
    hx hρ hK
  rwa [hproj] at this

/-! ### T3.8li -/

-- T3.8li step 1 (D7): the phase of a template copy with `i ≥ 2` for Q-material is at least `1`
theorem phaseOff_pos_D7 {sd : StopData} {i : Nat} {a : ColAddr} (hi : 1 ≤ i)
    (hq : isQMat sd a = true → 2 ≤ i) : 1 ≤ phaseOff sd i a := by
  unfold phaseOff
  split_ifs with h
  · have := hq h; omega
  · exact hi

-- T3.8li step 2 (D7): upwardness of the projected cap
theorem projection_upward_D7 (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat}
    (hi : 1 ≤ i ∧ i ≤ S.n) (ha : IsTmplCol S.A S.sd S.rd a) (hc : phaseCol S.sd S.rd i a = some c)
    (hup : IsUpward S.B c k ρ) (hρ : ρ ≤ S.sd.r ∨ S.s (phaseOff S.sd i a) ≤ ρ) :
    IsUpward S.A a k (S.proj (phaseOff S.sd i a) ρ) := by
  obtain ⟨-, hkB, hqB⟩ := isUpward_iff_parents_D7.mp hup
  have hpar := parents_phaseCol_D7 S hi ha hc
  refine isUpward_iff_parents_D7.mpr ⟨ha.1, by rw [hpar, List.length_map] at hkB; exact hkB,
    fun q hq => ?_⟩
  have hq' := hqB _ (by rw [hpar, List.getElem?_map, hq]; rfl)
  unfold shiftVal at hq'
  unfold OrdStep.proj OrdStep.s at *
  by_cases hrq : S.sd.r ≤ q
  · rw [if_pos hrq] at hq'
    rcases hρ with h | h
    · omega
    · rw [if_pos (by omega)]; omega
  · rw [if_neg hrq] at hq'
    split_ifs <;> omega

-- T3.8li step 3 (D7): the projected closing parent is visible
theorem projection_lt_num_D7 (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat}
    (hi : 1 ≤ i ∧ i ≤ S.n) (ha : IsTmplCol S.A S.sd S.rd a) (hc : phaseCol S.sd S.rd i a = some c)
    (hup : IsUpward S.B c k ρ) (hKL : InL (litCap S.B c k ρ))
    (hρ : ρ ≤ S.sd.r ∨ S.s (phaseOff S.sd i a) ≤ ρ) :
    S.proj (phaseOff S.sd i a) ρ < a.num 0 := by
  have h1 := lt_num_of_litCap_D7 hup hKL.1
  have h2 := num_phaseCol S.inL S.kind S.hsd S.hrd (Or.inr ha) hi.1 hc
  have h3 := tmplCol_num_gt S ha
  rw [show period S.sd = S.d from rfl] at h2
  unfold OrdStep.proj
  by_cases h4 : S.s (phaseOff S.sd i a) < ρ
  · rw [if_pos h4]; unfold OrdStep.s at h4; omega
  · rw [if_neg h4]
    by_cases h5 : ρ = S.s (phaseOff S.sd i a)
    · rw [if_pos h5]; omega
    · rw [if_neg h5]; unfold OrdStep.s at h4 h5 hρ; omega

-- F7 (helper): a container has a number at most that of the direct host
theorem num_container_le_host_F7 {o c : ColAddr} {e : EntryAddr} (he : o.container c = some e)
    {π : List (Nat × Nat)} {ci ei : Nat} (hpc : c.path = π ++ [(ci, ei)]) :
    o.num 0 ≤ (⟨π, ci⟩ : ColAddr).num 0 := by
  obtain ⟨he1, t, ht⟩ := (ColAddr.container_spec _ _ _).mp he
  rw [EntryAddr.heightPath, he1, hpc] at ht
  rcases t.eq_nil_or_concat with rfl | ⟨t', x, rfl⟩
  · rw [List.append_nil] at ht
    have := List.append_inj' ht rfl
    simp only [List.cons.injEq, Prod.mk.injEq, and_true] at this
    obtain ⟨h1, h2, -⟩ := this
    simp [ColAddr.num, h1, h2]
  · rw [List.concat_eq_append, ← List.append_assoc] at ht
    have := List.append_inj' ht rfl
    obtain ⟨h1, -⟩ := this
    rw [← h1]
    simp only [ColAddr.num, List.map_append, List.sum_append, List.map_cons, List.sum_cons,
      List.map_nil, List.sum_nil]
    omega

-- F7 (helper): in a literal cap at a column start, every container of the cap column has a
-- number at most the closing parent (I of the cap)
theorem litCap_host_F7 {B : Forest} {c : ColAddr} {ρ : Nat} (hup : IsUpward B c 0 ρ)
    (hKI : CondI (litCap B c 0 ρ)) {o : ColAddr} {e : EntryAddr} (he : o.container c = some e) :
    o.num 0 ≤ ρ := by
  obtain ⟨-, t, ht⟩ := (ColAddr.container_spec _ _ _).mp he
  obtain ⟨π, ci, ei, hpc⟩ : ∃ π ci ei, c.path = π ++ [(ci, ei)] := by
    rcases c.path.eq_nil_or_concat with h0 | ⟨π, x, hx⟩
    · rw [h0] at ht; simp [EntryAddr.heightPath] at ht
    · exact ⟨π, x.1, x.2, by rw [hx, List.concat_eq_append]⟩
  refine (num_container_le_host_F7 he hpc).trans ?_
  obtain ⟨hcol, -⟩ := litCap_colAt_self hup
  simp only [List.take_zero, List.nil_append] at hcol
  set e'' : EntryAddr := ⟨⟨π, ci⟩, ei⟩
  have hhp : e''.heightPath = c.path := by simp [e'', EntryAddr.heightPath, hpc]
  have hcol' : (litCap B c 0 ρ).colAt ⟨e''.heightPath, c.col⟩ = some [(ρ, Tree.empty)] := by
    rw [hhp]; exact hcol
  obtain ⟨q, H, hent, hH⟩ := entry_of_heightCol_D7 hcol'
  have hmem : e'' ∈ (litCap B c 0 ρ).entryAddrs := by
    rw [Tree.mem_entryAddrs_iff, hent]; rfl
  have hHne : H ≠ Tree.empty := by
    intro h0; rw [h0] at hH; simp [Tree.empty, Tree.cols] at hH
  obtain ⟨q', H', rest, hcq, hle⟩ :=
    hKI e'' hmem q H hent hHne [(ρ, Tree.empty)] (List.mem_of_getElem? hH)
  simp only [List.cons.injEq, Prod.mk.injEq] at hcq
  rw [hcq.1.1]
  exact hle

-- T3.8li step 4 (D7; VERIFY-U2 F7): the host bound of a column-start projection inside a height
theorem projection_host_D7 (S : OrdStep) {i : Nat} {a c : ColAddr} {ρ : Nat}
    (hi : 1 ≤ i ∧ i ≤ S.n) (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c 0 ρ)
    (hKL : InL (litCap S.B c 0 ρ)) (_hρ : ρ ≤ S.sd.r ∨ S.s (phaseOff S.sd i a) ≤ ρ)
    {π : List (Nat × Nat)} {ci ei : Nat} (hpa : a.path = π ++ [(ci, ei)]) :
    (⟨π, ci⟩ : ColAddr).num 0 ≤ S.proj (phaseOff S.sd i a) ρ := by
  have hφ := phaseOff_pos_D7 hi.1 hq
  have hKI : CondI (litCap S.B c 0 ρ) := hKL.2.1
  have hp : PhasePair_D7 S i a c (phaseOff S.sd i a) := Or.inl ⟨ha, hc, rfl⟩
  have hcontA : (⟨⟨π, ci⟩, ei⟩ : EntryAddr).Contains a := by
    show EntryAddr.heightPath _ <+: _
    simp [EntryAddr.heightPath, hpa]
  have hha : (⟨π, ci⟩ : ColAddr).container a = some ⟨⟨π, ci⟩, ei⟩ :=
    (ColAddr.container_spec _ _ _).mpr ⟨rfl, hcontA⟩
  have hres : a.resolve 0 ((⟨π, ci⟩ : ColAddr).num 0) = some ⟨π, ci⟩ :=
    EntryAddr.resolve_host hcontA
  obtain ⟨hRa, -, -, b, hb⟩ := phasePair_root_D7 S hp
  obtain ⟨hresR, -, -, hpre, -⟩ := rootData_path S.hsd S.hrd
  have hsφ : S.s (phaseOff S.sd i a) = S.sd.r + phaseOff S.sd i a * S.d := rfl
  rcases lt_trichotomy ((⟨π, ci⟩ : ColAddr).num 0) S.sd.r with hlt | heq | hgt
  · -- a host below `r` contains the copy too
    have hcR := EntryAddr.contains_of_resolve hcontA hRa hlt
    have hpc : S.rd.col.path <+: c.path := by
      rw [hb]
      refine hpre.trans ?_
      obtain ⟨bp, bc⟩ := b
      cases bp with
      | nil => exact List.prefix_refl _
      | cons y ys => obtain ⟨y1, y2⟩ := y; exact List.prefix_append _ _
    have hcc : (⟨π, ci⟩ : ColAddr).container c = some ⟨⟨π, ci⟩, ei⟩ :=
      (ColAddr.container_spec _ _ _).mpr ⟨rfl, hcR.trans hpc⟩
    have := litCap_host_F7 hup hKI hcc
    unfold OrdStep.proj
    split_ifs <;> omega
  · -- the root: the head `s_φ` contains the copy
    have hhR : (⟨π, ci⟩ : ColAddr) = S.rd.col := by
      rw [heq] at hres; rw [hRa] at hres; exact (Option.some.inj hres).symm
    have hRa' : S.rd.col.container a = some ⟨⟨π, ci⟩, ei⟩ := by rw [← hhR]; exact hha
    obtain ⟨-, hlt', heq'⟩ := head_stack_F7 S hi hp hφ le_rfl
    have hcont : ∃ e, (S.headCol (phaseOff S.sd i a)).container c = some e := by
      rcases Nat.lt_or_ge (phaseOff S.sd i a) i with hφi | hφi
      · rw [hlt' hφi]
        have haq : isQMat S.sd a = true := by
          cases h' : isQMat S.sd a
          · simp only [phaseOff, h', Bool.false_eq_true, if_false] at hφi; omega
          · rfl
        obtain ⟨a₀, ha₀⟩ := Option.isSome_iff_exists.mp ha.2.2.2
        have := container_underCol_of_onStack ((ColAddr.resolve_spec 0 _ _ _).mp hresR).1 a₀
        rw [← qmat_underCol_F7 S haq ha₀, hRa'] at this
        rw [← this]
        exact ⟨_, rfl⟩
      · obtain ⟨-, -, h3⟩ := heq' (by unfold phaseOff at hφi ⊢; split_ifs at hφi ⊢ <;> omega)
        rw [h3, hRa']
        exact ⟨_, rfl⟩
    obtain ⟨e, he⟩ := hcont
    have := litCap_host_F7 hup hKI he
    rw [num_headCol_F7 S hφ] at this
    unfold OrdStep.proj
    split_ifs <;> omega
  · -- above `r`: the phase copy of the host contains the copy
    obtain ⟨o', ho', hcont, -⟩ := phase_stack_F7 S hi hp hgt hres
    rw [hha] at hcont
    have := litCap_host_F7 hup hKI hcont
    rw [ColAddr.resolve_num ho'] at this
    unfold OrdStep.proj
    split_ifs <;> omega

-- L-G010.19 (D7; T3.8li step 5, final test): the final test of the projected cap, read in `A`
theorem projection_finalTest_D7 (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat}
    (hi : 1 ≤ i ∧ i ≤ S.n) (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hend : capPos S.B c k < mu S.B)
    (hρ : ρ ≤ S.sd.r ∨ S.s (phaseOff S.sd i a) ≤ ρ) :
    Path S.A (activeKeys_D7 S.A a) a (cutQuery (actualKeys S.A a) k) (cutStart S.A a k)
      (S.proj (phaseOff S.sd i a) ρ) := by
  have hφ := phaseOff_pos_D7 hi.1 hq
  have hpar := parents_phaseCol_D7 S hi ha hc
  obtain ⟨-, hkB, -⟩ := isUpward_iff_parents_D7.mp hup
  have hkA : k ≤ (parents S.A a).length := by
    rw [hpar, List.length_map] at hkB; exact hkB
  have hpre : (parents S.B c).take k =
      ((parents S.A a).take k).map (shiftVal S.sd.r (phaseOff S.sd i a * S.d)) := by
    rw [hpar, List.map_take]
  -- the cut query of `c` is `κ_φ` of the old one
  have hQ : cutQuery (actualKeys S.B c) k =
      kappaQ S.sd.r S.d (phaseOff S.sd i a) (cutQuery (actualKeys S.A a) k) := by
    rw [← capQ_eq_kappaQ S hi ha hq hc hup hend]
    obtain ⟨hKcol, hKlen⟩ := litCap_colAt_self hup
    unfold OrdStep.capQ cutQuery
    congr 1
    simp only [actualKeys, hKcol, Option.getD_some, List.map_append]
    rw [List.take_left' (by rw [List.length_map, hKlen]), ← List.map_take]
  -- `K`'s decorated final test, read in `B`
  have hKA := capping_forward hKL.1 hKL.2.2.2.1 hKL.2.2.2.2 (sel := routeCols (litCap S.B c k ρ))
    (fun _ h => h)
  obtain ⟨hcK, hlenK⟩ := litCap_parents_self hup
  have hfin : AAt (litCap S.B c k ρ) (capKeys (litCap S.B c k ρ) (routeCols (litCap S.B c k ρ)))
      c k := (condAK_iff _ _).mp hKA c hcK k
  have hB := (aAt_litCap_final_D7 hup).mp hfin
  exact phase_finalTest_D7 S hi (Or.inl ⟨ha, hc, rfl⟩) hφ hkA hpre hQ hρ hB

-- T3.8li (txt:520-541): projection of a material cut to an old cap (moved here from before
-- T3.8lj, brief rule 5: its proof uses the G-009 and G-010 helpers)
theorem projection (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hend : capPos S.B c k < mu S.B)
    (hρ : ρ ≤ S.sd.r ∨ S.s (phaseOff S.sd i a) ≤ ρ) :
    let K' := litCap S.A a k (S.proj (phaseOff S.sd i a) ρ)
    IsUpward S.A a k (S.proj (phaseOff S.sd i a) ρ) ∧ CondV K' ∧ CondI K' ∧
      CondAK K' (capKeys K' (routeCols K')) := by
  intro K'
  have hup' := projection_upward_D7 S hi ha hc hup hρ
  obtain ⟨hca, hka, -⟩ := isUpward_iff_parents_D7.mp hup'
  refine ⟨hup', ?_, ?_, ?_⟩
  · exact condV_litCap_D7 S.inL.1 hca hka (projection_lt_num_D7 S hi ha hc hup hKL hρ)
  · refine condI_litCap_D7 S.inL.2.1 hca hka ?_
    intro hk0 π ci ei hpa
    subst hk0
    exact projection_host_D7 S hi ha hq hc hup hKL hρ hpa
  · exact condAK_litCap_D7 S.inL hup' (projection_finalTest_D7 S hi ha hq hc hup hKL hend hρ)

-- T3.8lq–T3.8ls (moved here from after T3.8lp, brief rule 5: T3.8lq uses T3.8li `projection`).

-- T3.8lq (G4, helper): the root cursor of a literal cap, as a scan of its actual root keys
-- against the cut query of the capped column
theorem rootCursor_litCap_G4 {E : Forest} {c : ColAddr} {k ρ : Nat} (hup : IsUpward E c k ρ)
    {rd : RootData} (hrd : rootData (litCap E c k ρ) = some rd) :
    rd.cursor = cursor (actualKeys (litCap E c k ρ) rd.col) (cutQuery (actualKeys E c) k) := by
  have hsd := stopData_litCap hup
  obtain ⟨-, -, -, -, hcur, -⟩ := rootData_path hsd hrd
  obtain ⟨hcol, hlen⟩ := litCap_colAt_self hup
  have hq : (actualKeys E c).take k =
      (queryKeys ⟨colDepth c, c, c.num 0, ρ, ((E.colAt c).getD []).take k⟩).map (↑) := by
    simp only [actualKeys, queryKeys, List.map_map, ← List.map_take]
    rfl
  have hkeys : actualKeys (litCap E c k ρ) rd.col =
      (rootKeys (litCap E c k ρ) rd).map (↑) := by
    simp only [actualKeys, rootKeys, List.map_map]
    rfl
  unfold cutQuery
  rw [cursor_nu, hq, hkeys, cursor_map WithTop.coe_strictMono, hcur]

-- T3.8lq (G4, helper): a literal cap cuts a container column after its containing entry, whose
-- height is the literal cap of that height
theorem litCapAux_colAt_split_G4 (k p j : Nat) (σ : List (Nat × Nat)) (ci ei : Nat) (col : Column)
    (q : Nat) (h : Forest) :
    ∀ (π : List (Nat × Nat)) (F : Forest), F.colAt ⟨π, ci⟩ = some col → col[ei]? = some (q, h) →
      (litCapAux k p (π ++ (ci, ei) :: σ) j F).colAt ⟨π, ci⟩ =
        some (col.take ei ++ [(q, litCapAux k p σ j h)])
  | [], .node cols, hcol, hei => by
    have hcol' : cols[ci]? = some col := by
      unfold Tree.colAt at hcol; simpa [Tree.forestAt, Tree.cols] using hcol
    have hci : ci < cols.length := (List.getElem?_eq_some_iff.mp hcol').1
    have hlen1 : (cols.take ci).length = ci := by rw [List.length_take]; omega
    simp only [List.nil_append, litCapAux, List.getD_eq_getElem?_getD, hcol', Option.getD_some,
      hei]
    unfold Tree.colAt
    simp only [Tree.forestAt, Option.bind_some, Tree.cols]
    rw [List.getElem?_append_right (le_of_eq hlen1), hlen1, Nat.sub_self]
    rfl
  | (c0, e0) :: π, .node cols, hcol, hei => by
    rw [colAt_cons] at hcol
    obtain ⟨x, hx⟩ : ∃ x, (cols[c0]?).bind (·[e0]?) = some x := by
      cases h1 : (cols[c0]?).bind (·[e0]?) with
      | none => rw [h1] at hcol; cases hcol
      | some x => exact ⟨x, rfl⟩
    obtain ⟨q0, h0⟩ := x
    rw [hx] at hcol
    simp only [Option.bind_some] at hcol
    obtain ⟨colc, hcolc, he0⟩ : ∃ colc, cols[c0]? = some colc ∧ colc[e0]? = some (q0, h0) := by
      cases h1 : cols[c0]? with
      | none => rw [h1] at hx; cases hx
      | some colc => rw [h1] at hx; exact ⟨colc, rfl, hx⟩
    have hc0 : c0 < cols.length := (List.getElem?_eq_some_iff.mp hcolc).1
    have he0l : e0 < colc.length := (List.getElem?_eq_some_iff.mp he0).1
    have hlen1 : (cols.take c0).length = c0 := by rw [List.length_take]; omega
    have hlen2 : (colc.take e0).length = e0 := by rw [List.length_take]; omega
    have ih := litCapAux_colAt_split_G4 k p j σ ci ei col q h π h0 hcol hei
    simp only [List.cons_append, litCapAux, List.getD_eq_getElem?_getD, hcolc, Option.getD_some,
      he0]
    rw [colAt_cons]
    rw [List.getElem?_append_right (le_of_eq hlen1), hlen1, Nat.sub_self]
    simp only [List.getElem?_cons_zero, Option.bind_some]
    rw [List.getElem?_append_right (le_of_eq hlen2), hlen2, Nat.sub_self]
    simp only [List.getElem?_cons_zero, Option.bind_some]
    exact ih

-- T3.8lq (G4, helper): a word at any depth has `µ` atoms
theorem len_wordAt_G4 (e : Nat) (X : Forest) : (wordAt e X).length = mu X := by
  have := wordAt_add 0 e X
  rw [Nat.zero_add] at this
  rw [this, List.length_map]; rfl

-- T3.8lq (G4, helper; L2.5c `sign_of_agreement`): the key of a literal cap of a height and the key
-- of the complete height compare alike with the key of any height among the first `k` entries of
-- the capped column
theorem sign_litCapAux_G4 (r t k p : Nat) (σ : List (Nat × Nat)) (j : Nat) {H G : Forest}
    {col : Column} (hG : H.forestAt σ = some G) (hcol : G.cols[j]? = some col) {v : Nat}
    (hv : v < k) {x : Nat × Forest} (hx : col[v]? = some x) :
    compare ((relKey r (litCapAux k p σ j H) : Key) : WithTop Key) ((relKey t x.2 : Key) : WithTop Key) =
      compare ((relKey r H : Key) : WithTop Key) ((relKey t x.2 : Key) : WithTop Key) := by
  obtain ⟨Apre, S, hw, -, hcap, -⟩ := capDecomp_E5 σ 0 j H G col hG hcol
  rw [Nat.zero_add] at hw hcap
  set e := σ.length with he
  have hjl : j < G.cols.length := (List.getElem?_eq_some_iff.mp hcol).1
  have hdrop : G.cols.drop j = col :: G.cols.drop (j + 1) := by
    rw [List.drop_eq_getElem_cons hjl, (List.getElem?_eq_some_iff.mp hcol).2]
  have hvl : v < col.length := (List.getElem?_eq_some_iff.mp hx).1
  have hL : col.take k ≠ [] := by
    intro h0
    rcases List.take_eq_nil_iff.1 h0 with h0 | h0
    · omega
    · subst h0; simp at hvl
  -- the common prefix `C`
  set C := Apre ++ wordCol e (col.take k) with hC
  have hwH : word H = C ++ (wordLater e (col.drop k) ++ wordCols e (G.cols.drop (j + 1)) ++ S) := by
    show wordAt 0 H = _
    rw [hw, hdrop, wordCols]
    conv_lhs => rw [← List.take_append_drop k col]
    rw [ker_wordCol_append e hL]
    simp only [hC, List.append_assoc]
  have hwH' : word (litCapAux k p σ j H) = C ++ [toLex (2 * e + 1, toLex (0, p))] := by
    show wordAt 0 _ = _
    rw [hcap k p, ker_wordCol_append e hL]
    simp [hC, wordLater, Tree.empty, wordAt, wordCols]
  -- the query height lies inside `C`
  have hxC : mu x.2 + 1 ≤ C.length := by
    have hvx : (col.take k)[v]? = some x := by rw [List.getElem?_take_of_lt hv]; exact hx
    have hvk : v < (col.take k).length := (List.getElem?_eq_some_iff.mp hvx).1
    have hsplit : col.take k = (col.take k).take v ++ x :: (col.take k).drop (v + 1) := by
      conv_lhs => rw [← List.take_append_drop v (col.take k)]
      rw [List.drop_eq_getElem_cons hvk, (List.getElem?_eq_some_iff.mp hvx).2]
    have h1 := wordCol_split_E5 e ((col.take k).take v) x.1 x.2 ((col.take k).drop (v + 1))
    rw [← hsplit] at h1
    have h2 := len_wordCol_snoc_le_E5 e ((col.take k).take v) x.1
    have h3 := len_wordAt_G4 (e + 1) x.2
    have h4 : (wordCol e (col.take k)).length ≥ 1 + mu x.2 := by
      rw [h1]; simp only [List.length_append]; omega
    rw [hC, List.length_append]; omega
  have hlen : mu x.2 < mu (litCapAux k p σ j H) := by
    show mu x.2 < (word (litCapAux k p σ j H)).length
    rw [hwH', List.length_append, List.length_singleton]; omega
  have hagree : (word (litCapAux k p σ j H)).take (mu x.2 + 1) = (word H).take (mu x.2 + 1) := by
    rw [hwH', hwH, List.take_append_of_le_length hxC, List.take_append_of_le_length hxC]
  exact sign_of_agreement_compare r t hlen hagree

-- T3.8lq (G4, helper): when the root of `A` contains the stopping column (owner case), it
-- contains every template column
theorem tmpl_container_rdcol_G4 (S : OrdStep) {a : ColAddr} (ha : IsTmplCol S.A S.sd S.rd a)
    {e : EntryAddr} (he : S.rd.col.container S.sd.col = some e) :
    ∃ e', S.rd.col.container a = some e' := by
  by_cases haq : isQMat S.sd a = true
  · obtain ⟨j, rest, hp, -⟩ := isQMat_spec S.sd haq
    obtain ⟨h1, h2⟩ := (ColAddr.container_spec _ _ _).mp he
    exact ⟨e, (ColAddr.container_spec _ _ _).mpr ⟨h1, h2.trans (by rw [hp]; exact List.prefix_append _ _)⟩⟩
  · have haq' : isQMat S.sd a = false := by simpa using haq
    obtain ⟨a', ha'⟩ := Option.isSome_iff_exists.mp ha.2.2.2
    obtain ⟨suf, hsuf, hcases⟩ := kerCol_tail_spec S ha' haq'
    obtain ⟨-, -, -, -, -, hown, -⟩ := rootData_path S.hsd S.hrd
    have howner : S.rd.owner = true := hown.mpr (by rw [he]; rfl)
    rcases hcases with ⟨rfl, hcol, -⟩ | ⟨-, -, hown', -⟩ | ⟨e', rest, rfl, -, -⟩ |
        ⟨-, -, -, -, -, hown', -⟩
    · exfalso
      apply ha.2.2.1
      obtain ⟨ap, ac⟩ := a
      simp only at hsuf hcol
      rw [hsuf, List.append_nil, hcol]
    · rw [howner] at hown'; cases hown'
    · refine ⟨⟨S.rd.col, e'⟩, (ColAddr.container_spec _ _ _).mpr ⟨rfl, ?_⟩⟩
      rw [hsuf, EntryAddr.heightPath]
      exact ⟨rest, by simp⟩
    · rw [howner] at hown'; cases hown'

-- T3.8lq (G4, helper; L2.5 trace fact (3), cursor form): sources agreeing before `u`, whose keys
-- at `u` compare alike with every query key, have the same final cursor for a run ending by `u`
theorem cursor_agree_G4 {α : Type} [LinearOrder α] {src₁ src₂ qry : List α} {u : Nat}
    (hpre : src₁.take u = src₂.take u) {x₁ x₂ : α} (h₁ : src₁[u]? = some x₁) (h₂ : src₂[u]? = some x₂)
    (hs : ∀ y ∈ qry, compare x₁ y = compare x₂ y) (hrun : cursor src₁ qry ≤ u) :
    cursor src₁ qry = cursor src₂ qry :=
  cursor_eq_of_trace_eq (traceFrom_agree u src₁ src₂ qry 0 0 hpre ⟨x₁, x₂, h₁, h₂, hs⟩ hrun)

-- T3.8lq (txt:564-571): fixed roots `ρ ≤ r`: the actual source cursors agree.
-- VERIFY-U2 (F3): the owner flags need not agree (`ρ = r`, cut in a restored origin: the old
-- cap's root `R` contains the cut, the new cap's root does not; 106 bounded cases), so the
-- drafted conjunct `rdN.owner = rdO.owner` is removed; T3.8lr/T3.8ls use only cursor and column.
theorem root_fixed_cursor (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat}
    (hi : 1 ≤ i ∧ i ≤ S.n) (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hend : capPos S.B c k < mu S.B) (hρ : ρ ≤ S.sd.r)
    {rdN rdO : RootData} (hN : rootData (litCap S.B c k ρ) = some rdN)
    (hO : rootData (litCap S.A a k ρ) = some rdO) :
    rdN.cursor = rdO.cursor ∧ rdN.col = rdO.col := by
  -- the projected cap `K' = litCap A a k ρ` (T3.8li): upward, V, I, decorated A, hence S and A
  have hφ := phaseOff_pos_D7 hi.1 hq
  have hrt : S.sd.r < S.sd.t := (rootData_spec S.hsd S.hrd).2.2.2.2.1
  have hd : 1 ≤ S.d := by simp only [OrdStep.d, period]; omega
  have hproj : S.proj (phaseOff S.sd i a) ρ = ρ := by
    unfold OrdStep.proj OrdStep.s
    have : S.d ≤ phaseOff S.sd i a * S.d := Nat.le_mul_of_pos_left _ (by omega)
    rw [if_neg (by omega), if_neg (by omega)]
  have hP := projection S hi ha hq hc hup hKL hend (Or.inl hρ)
  simp only [hproj] at hP
  obtain ⟨hupA, hVO, hIO, hAO⟩ := hP
  have hSO := upward_condS S.inL.1 S.inL.2.1 S.inL.2.2.1 S.condP hupA hVO hIO
  have hAO' := capping_reverse hVO hSO (sel := routeCols (litCap S.A a k ρ)) (fun _ h => h) hAO
  have hsdN := stopData_litCap hup
  have hsdO := stopData_litCap hupA
  obtain ⟨hresN, -, -, -, -, hownN, -⟩ := rootData_path hsdN hN
  obtain ⟨hresO, -, -, -, -, hownO, -⟩ := rootData_path hsdO hO
  simp only at hresN hresO hownN hownO
  -- the root columns agree (both are the root's stack below `r`, or the root itself)
  obtain ⟨hRa, hRc, hpa, b, hb⟩ := phasePair_root_D7 S (Or.inl ⟨ha, hc, rfl⟩)
  obtain ⟨hres, -, -, -, -, hown, -⟩ := rootData_path S.hsd S.hrd
  have hcol : rdN.col = rdO.col := by
    rcases Nat.lt_or_ge ρ S.sd.r with hlt | hge
    · rw [← ColAddr.resolve_of_resolve_lt hRc hlt, ColAddr.resolve_of_resolve_lt hRa hlt,
        hresO] at hresN
      exact (Option.some.inj hresN).symm
    · have e : ρ = S.sd.r := by omega
      rw [e, hRc] at hresN
      rw [e, hRa] at hresO
      rw [← Option.some.inj hresN, ← Option.some.inj hresO]
  refine ⟨?_, hcol⟩
  set o := rdO.col with ho_def
  rw [hcol] at hresN hownN
  have hon : o.num 0 = ρ := ColAddr.resolve_num hresO
  -- the cursors as scans of the actual root keys against the old cut query `W`
  set W := cutQuery (actualKeys S.A a) k with hW
  have hcurN : rdN.cursor = cursor (actualKeys (litCap S.B c k ρ) o) W := by
    rw [rootCursor_litCap_G4 hup hN, hcol]
    have hQ : cutQuery (actualKeys S.B c) k = kappaQ S.sd.r S.d (phaseOff S.sd i a) W := by
      rw [← capQ_eq_kappaQ S hi ha hq hc hup hend]
      obtain ⟨hKcol, hKlen⟩ := litCap_colAt_self hup
      unfold OrdStep.capQ cutQuery
      congr 1
      simp only [actualKeys, hKcol, Option.getD_some, List.map_append]
      rw [List.take_left' (by rw [List.length_map, hKlen]), ← List.map_take]
    rw [hQ]
    have hfix := (kappaQ_fix_D7 S.sd.r S.d (phaseOff S.sd i a) (litCap S.B c k ρ) (o := o)
      (by omega)).1
    have := cursor_map (kappaQry_strictMono S.sd.r S.d (phaseOff S.sd i a))
      (actualKeys (litCap S.B c k ρ) o) W
    unfold kappaQ at hfix ⊢
    rw [hfix] at this
    exact this
  have hcurO : rdO.cursor = cursor (actualKeys (litCap S.A a k ρ) o) W := rootCursor_litCap_G4 hupA hO
  rw [hcurN, hcurO]
  -- the stacks: `o` is on the stack of the stopping column, and `c` is placed under it
  obtain ⟨-, -, -, hpre, -⟩ := rootData_path S.hsd S.hrd
  have hcB : c ∈ S.B.colAddrs := mem_colAddrs_of_upward hup
  have hcst : c.OnStack o := ((ColAddr.resolve_spec 0 _ _ _).mp hresN).1
  have hast : a.OnStack o := ((ColAddr.resolve_spec 0 _ _ _).mp hresO).1
  have hsdres : S.sd.col.resolve 0 ρ = some o := by
    rcases Nat.lt_or_ge ρ S.sd.r with hlt | hge
    · rw [← ColAddr.resolve_of_resolve_lt hres hlt, ColAddr.resolve_of_resolve_lt hRc hlt, hresN]
    · have e : ρ = S.sd.r := by omega
      rw [e, hres]
      rw [e, hRa] at hresO
      exact hresO
  have hsdst : S.sd.col.OnStack o := ((ColAddr.resolve_spec 0 _ _ _).mp hsdres).1
  have hcc : o.container c = o.container S.sd.col := by
    rw [hb]; exact container_underCol_of_onStack hsdst b
  -- `B` is a context of `A`, which keeps the stack columns of the stopping column
  have hE : S.A ≠ Tree.empty := by
    intro h
    have := S.hsd
    rw [h, stopData_eq_none_of_lastCol (Or.inl rfl)] at this
    cases this
  obtain ⟨Z, hBZ⟩ : ∃ Z, S.B = context S.A S.sd Z := by
    have := expand_eq_iterate hE S.inL.1 S.inL.2.1 S.kind S.hsd S.hrd S.kernelDefined S.n
    rw [S.out] at this
    exact ⟨_, Option.some.inj this⟩
  obtain ⟨hpar, htake, hnone⟩ := colAt_context_onStack S.hsd Z hsdst
  rw [← hBZ] at hpar htake hnone
  obtain ⟨hK1, hK2⟩ := colAt_litCap_onStack (k := k) (p := ρ) hcB hcst
  obtain ⟨hK'1, hK'2⟩ := colAt_litCap_onStack (k := k) (p := ρ) ha.1 hast
  cases hea : o.container a with
  | none =>
    -- neither cap cuts the root column: both read the root column of `A`
    have hsdnone : o.container S.sd.col = none := by
      rcases Nat.lt_or_ge ρ S.sd.r with hlt | hge
      · have hcont : ∀ X : ColAddr, X.resolve 0 S.sd.r = some S.rd.col → S.rd.col.path <+: X.path →
            o.container X = o.container S.rd.col := by
          intro X hX hpX
          apply Option.ext; intro e
          rw [ColAddr.container_spec, ColAddr.container_spec]
          constructor
          · rintro ⟨h1, h2⟩
            exact ⟨h1, EntryAddr.contains_of_resolve h2 hX (by rw [h1]; omega)⟩
          · rintro ⟨h1, h2⟩; exact ⟨h1, h2.trans hpX⟩
        rw [hcont S.sd.col hres hpre, ← hcont a hRa hpa]; exact hea
      · have e : ρ = S.sd.r := by omega
        have hoR : o = S.rd.col := by
          rw [e, hRa] at hresO; exact (Option.some.inj hresO).symm
        cases hs : o.container S.sd.col with
        | none => rfl
        | some e₂ =>
          rw [hoR] at hs hea
          obtain ⟨e', he'⟩ := tmpl_container_rdcol_G4 S ha hs
          rw [hea] at he'; cases he'
    have h1 := hK2 (by rw [hcc]; exact hsdnone)
    have h2 := hK'2 hea
    have h3 := hnone hsdnone
    simp only [actualKeys, h1, h2, h3]
  | some e₁ =>
    -- `K'` cuts the root column after its containing entry `e₁`, whose height `H` is capped
    obtain ⟨he1col, σ, hσ⟩ := (ColAddr.container_spec _ _ _).mp hea
    have hapath : a.path = o.path ++ (o.col, e₁.idx) :: σ := by
      rw [← hσ, EntryAddr.heightPath, he1col]; simp
    obtain ⟨colA, hcolA⟩ := Option.isSome_iff_exists.mp ((Tree.mem_colAddrs_iff _ _).mp ha.1)
    have hfa : S.A.forestAt a.path = (S.A.heightAt e₁).bind fun f => f.forestAt σ := by
      rw [← hσ, Tree.forestAt_append, Tree.forestAt_heightPath]
    obtain ⟨H, hH⟩ : ∃ H, S.A.heightAt e₁ = some H := by
      cases h : S.A.heightAt e₁ with
      | none =>
        unfold Tree.colAt at hcolA
        rw [hfa, h] at hcolA; cases hcolA
      | some H => exact ⟨H, rfl⟩
    obtain ⟨G, hG, hGa⟩ : ∃ G, H.forestAt σ = some G ∧ G.cols[a.col]? = some colA := by
      unfold Tree.colAt at hcolA
      rw [hfa, hH, Option.bind_some] at hcolA
      cases h : H.forestAt σ with
      | none => rw [h] at hcolA; cases hcolA
      | some G => rw [h, Option.bind_some] at hcolA; exact ⟨G, rfl, hcolA⟩
    obtain ⟨⟨q, H₀⟩, hent⟩ : ∃ x, S.A.entryAt e₁ = some x := by
      unfold Tree.heightAt at hH
      cases h : S.A.entryAt e₁ with
      | none => rw [h] at hH; cases hH
      | some x => exact ⟨x, rfl⟩
    have hHH : H₀ = H := by
      unfold Tree.heightAt at hH; rw [hent] at hH; exact Option.some.inj hH
    subst hHH
    obtain ⟨colO, hcolO, hqO⟩ : ∃ colO, S.A.colAt o = some colO ∧ colO[e₁.idx]? = some (q, H₀) := by
      unfold Tree.entryAt at hent
      rw [he1col] at hent
      cases h : S.A.colAt o with
      | none => rw [h] at hent; cases hent
      | some colO => rw [h, Option.bind_some] at hent; exact ⟨colO, rfl, hent⟩
    have hidx : e₁.idx < colO.length := (List.getElem?_eq_some_iff.mp hqO).1
    have hK'col : (litCap S.A a k ρ).colAt o =
        some (colO.take e₁.idx ++ [(q, litCapAux k ρ σ a.col H₀)]) := by
      have hlit : litCap S.A a k ρ = litCapAux k ρ a.path a.col S.A := by
        show litCapBody S.A a k ρ = _
        unfold litCapBody
        rw [if_pos (by rw [hcolA]; rfl)]
      rw [hlit, hapath]
      exact litCapAux_colAt_split_G4 k ρ a.col σ o.col e₁.idx colO q H₀ o.path S.A hcolO hqO
    have hkeysO : actualKeys (litCap S.A a k ρ) o =
        (colO.take e₁.idx).map (fun x => ((relKey (o.num 0) x.2 : Key) : WithTop Key)) ++
          [((relKey (o.num 0) (litCapAux k ρ σ a.col H₀) : Key) : WithTop Key)] := by
      simp [actualKeys, hK'col]
    have hkeysA : actualKeys S.A o =
        colO.map (fun x => ((relKey (o.num 0) x.2 : Key) : WithTop Key)) := by
      simp [actualKeys, hcolO]
    have hlenO : (colO.take e₁.idx).length = e₁.idx := by rw [List.length_take]; omega
    -- `K'` is an owner whose root scan is not exhausted (L2.4c)
    have hrunO : cursor (actualKeys (litCap S.A a k ρ) o) W ≤ e₁.idx := by
      have hne := owner_root_nonexhaust hVO hAO' hSO hsdO hO (hownO.mpr (by rw [hea]; rfl))
      rw [hcurO, ← ho_def, hK'col, Option.getD_some, List.length_append, hlenO] at hne
      simp at hne; omega
    have hpreO : (actualKeys (litCap S.A a k ρ) o).take e₁.idx = (actualKeys S.A o).take e₁.idx := by
      rw [hkeysO, hkeysA, List.take_left' (by simp; omega), List.map_take]
    have hxO : (actualKeys (litCap S.A a k ρ) o)[e₁.idx]? =
        some ((relKey (o.num 0) (litCapAux k ρ σ a.col H₀) : Key) : WithTop Key) := by
      rw [hkeysO, List.getElem?_append_right (by rw [List.length_map, hlenO]), List.length_map,
        hlenO, Nat.sub_self]
      rfl
    have hxA : (actualKeys S.A o)[e₁.idx]? = some ((relKey (o.num 0) H₀ : Key) : WithTop Key) := by
      rw [hkeysA, List.getElem?_map, hqO]; rfl
    -- the capped height and the complete height compare alike with every query key (L2.5c)
    have hsign : ∀ y ∈ W, compare ((relKey (o.num 0) (litCapAux k ρ σ a.col H₀) : Key) : WithTop Key) y =
        compare ((relKey (o.num 0) H₀ : Key) : WithTop Key) y := by
      intro y hy
      have hy' : y ∈ (actualKeys S.A a).take k := (nu_sublist _).subset hy
      obtain ⟨v, hv, hyv⟩ := List.getElem_of_mem hy'
      have hvk : v < k := by
        have := hv; rw [List.length_take] at this; omega
      have hva : v < colA.length := by
        have := hv; simp [actualKeys, hcolA] at this; omega
      obtain ⟨x, hx⟩ : ∃ x, colA[v]? = some x := ⟨_, List.getElem?_eq_getElem hva⟩
      have hyx : y = ((relKey (a.num 0) x.2 : Key) : WithTop Key) := by
        rw [← hyv, List.getElem_take]
        simp [actualKeys, hcolA, (List.getElem?_eq_some_iff.mp hx).2]
      rw [hyx]
      exact sign_litCapAux_G4 (o.num 0) (a.num 0) k ρ σ a.col hG hGa hvk hx
    cases hsd : o.container S.sd.col with
    | none =>
      -- `K` keeps the whole root column of `A`
      have h1 : actualKeys (litCap S.B c k ρ) o = actualKeys S.A o := by
        simp only [actualKeys, hK2 (by rw [hcc]; exact hsd), hnone hsd]
      rw [h1]
      exact (cursor_agree_G4 hpreO hxO hxA hsign hrunO).symm
    | some e₂ =>
      -- `K` cuts the root column after the last entry `e₂ ≥ e₁` (the stopping column is on the
      -- route)
      have hl := container_sdcol_last S hsd
      have hlenA : (parents S.A o).length = colO.length := by simp [parents, hcolO]
      obtain ⟨hKp, hKk⟩ := hK1 e₂ (by rw [hcc]; exact hsd)
      have hBt := htake e₂ hsd
      have hBk : (actualKeys S.B o).take e₂.idx = (actualKeys S.A o).take e₂.idx := by
        simp only [actualKeys, ← List.map_take]
        congr 1
        cases hB : S.B.colAt o with
        | none => rw [hB, hcolO] at hBt; cases hBt
        | some C1 =>
          rw [hB, hcolO] at hBt
          simp only [Option.map_some, Option.some.injEq] at hBt
          simp only [Option.getD_some, hBt, hcolO]
      have hKt : (actualKeys (litCap S.B c k ρ) o).take e₂.idx = (actualKeys S.A o).take e₂.idx := by
        rw [hKk, hBk]
      have hKlen : (actualKeys (litCap S.B c k ρ) o).length = e₂.idx + 1 := by
        have : (parents (litCap S.B c k ρ) o).length = e₂.idx + 1 := by
          rw [hKp, hpar, List.length_take]; omega
        simpa [parents, actualKeys] using this
      rcases Nat.lt_or_ge e₁.idx e₂.idx with hlt | hge
      · -- the old cut lies in an earlier restored origin: sign agreement at `e₁`
        have hpreN : (actualKeys (litCap S.B c k ρ) o).take e₁.idx =
            (actualKeys S.A o).take e₁.idx := by
          rw [← Nat.min_eq_left hlt.le, ← List.take_take, hKt, List.take_take]
        have hxN : (actualKeys (litCap S.B c k ρ) o)[e₁.idx]? =
            some ((relKey (o.num 0) H₀ : Key) : WithTop Key) := by
          rw [← List.getElem?_take_of_lt hlt, hKt, List.getElem?_take_of_lt hlt, hxA]
        exact (cursor_agree_G4 (hpreO.trans hpreN.symm) hxO hxN hsign hrunO).symm
      · -- the same containing entry: both scans stop by `e₁` (L2.4c), so they agree
        have he : e₁.idx = e₂.idx := by omega
        have hrunN : cursor (actualKeys (litCap S.B c k ρ) o) W ≤ e₁.idx := by
          have hne := owner_root_nonexhaust hKL.1 hKL.2.2.2.1 hKL.2.2.2.2 hsdN hN
            (hownN.mpr (by rw [hcc, hsd]; rfl))
          rw [hcurN, hcol] at hne
          have : (((litCap S.B c k ρ).colAt o).getD []).length =
              (actualKeys (litCap S.B c k ρ) o).length := by simp [actualKeys]
          omega
        have hpreN : (actualKeys (litCap S.B c k ρ) o).take e₁.idx =
            (actualKeys S.A o).take e₁.idx := by rw [he]; exact hKt
        exact cursor_eq_of_take_eq (hpreN.trans hpreO.symm) hrunN hrunO

-- T3.8lr/T3.8ls (G4, helper; N2.2 `capDecomp_E5` with its rest characterized): the rest `S`
-- after the columns of the forest at `σ` is empty exactly when `σ` is a route path
theorem capDecomp_route_G4 : ∀ (σ : List (Nat × Nat)) (e j : Nat) (F G : Forest) (col : Column),
    F.forestAt σ = some G → G.cols[j]? = some col →
    ∃ A S, wordAt e F = A ++ wordCols (e + σ.length) (G.cols.drop j) ++ S ∧
      (∀ y ∈ S.head?, (ofLex y).1 < 2 * (e + σ.length)) ∧
      (∀ k p, wordAt e (litCapAux k p σ j F) =
        A ++ wordCol (e + σ.length) (col.take k ++ [(p, Tree.empty)])) ∧
      (∀ k, A.length < k → ∃ G', (spF k F).1.forestAt σ = some G' ∧
        G'.cols = G.cols.take j ++ (spCols (k - A.length) (G.cols.drop j)).1) ∧
      (Scan.IsRoutePath F σ ↔ S = [])
  | [], e, j, .node cols, G, col, hG, hcol => by
    simp only [Tree.forestAt, Option.some.injEq] at hG
    subst hG
    simp only [Tree.cols] at hcol
    refine ⟨wordCols e (cols.take j), [], ?_, by simp, ?_, ?_,
      ⟨fun _ => rfl, fun _ d hd => absurd hd (Nat.not_lt_zero _)⟩⟩
    · simp only [wordAt, List.length_nil, Nat.add_zero, List.append_nil, Tree.cols]
      rw [← wordCols_append, List.take_append_drop]
    · intro k p
      have hg : cols.getD j [] = col := by rw [List.getD_eq_getElem?_getD, hcol]; rfl
      simp only [litCapAux, wordAt, hg, wordCols_append, List.length_nil, Nat.add_zero, wordCols,
        List.append_nil]
    · intro k hk
      refine ⟨_, rfl, ?_⟩
      simp only [spF, Tree.cols]
      have h1 := spCols_append_E5 k (cols.take j) (cols.drop j)
      rw [List.take_append_drop] at h1
      have hs := (spCols_spec e k (cols.take j)).2
      have hne : (spCols k (cols.take j)).2 ≠ 0 := by rw [hs]; omega
      rw [h1, spCols_full_E5 hne, hs]
  | (ci, ei) :: rest, e, j, .node cols, G, col, hG, hcol => by
    rw [ker_forestAt_cons] at hG
    cases hcC : cols[ci]? with
    | none => simp [Tree.cols, hcC] at hG
    | some colC =>
      cases hent : colC[ei]? with
      | none => simp [Tree.cols, hcC, hent] at hG
      | some x =>
        obtain ⟨q, h⟩ := x
        simp only [Tree.cols, hcC, hent, Option.bind_some] at hG
        obtain ⟨A', S', hw, hS, hcap, hsp, hroute⟩ := capDecomp_route_G4 rest (e + 1) j h G col hG hcol
        have hci : ci < cols.length := by
          by_contra hh; rw [List.getElem?_eq_none (by omega)] at hcC; cases hcC
        have hei : ei < colC.length := by
          by_contra hh; rw [List.getElem?_eq_none (by omega)] at hent; cases hent
        obtain ⟨_, hcolE⟩ := List.getElem?_eq_some_iff.1 hcC
        obtain ⟨_, hentE⟩ := List.getElem?_eq_some_iff.1 hent
        have hcols : cols = cols.take ci ++ colC :: cols.drop (ci + 1) := by
          conv_lhs => rw [← List.take_append_drop ci cols]
          rw [List.drop_eq_getElem_cons hci, hcolE]
        have hcol2 : colC = colC.take ei ++ (q, h) :: colC.drop (ei + 1) := by
          conv_lhs => rw [← List.take_append_drop ei colC]
          rw [List.drop_eq_getElem_cons hei, hentE]
        have hlen : e + ((ci, ei) :: rest).length = e + 1 + rest.length := by
          simp; omega
        rw [hlen]
        refine ⟨wordCols e (cols.take ci) ++ wordCol e (colC.take ei ++ [(q, Tree.empty)]) ++ A',
          S' ++ wordLater e (colC.drop (ei + 1)) ++ wordCols e (cols.drop (ci + 1)), ?_, ?_, ?_, ?_, ?_⟩
        · show wordCols e cols = _
          conv_lhs => rw [hcols]
          rw [wordCols_append]
          simp only [wordCols]
          conv_lhs => rw [hcol2]
          rw [wordCol_split_E5, hw]
          simp only [List.append_assoc]
        · intro y hy
          cases S' with
          | cons s S' =>
            simp only [List.cons_append, List.head?_cons, Option.mem_def,
              Option.some.injEq] at hy
            subst hy
            exact hS s rfl
          | nil =>
            simp only [List.nil_append] at hy
            cases hL : wordLater e (colC.drop (ei + 1)) with
            | cons l L =>
              rw [hL] at hy
              simp only [List.cons_append, List.head?_cons, Option.mem_def,
                Option.some.injEq] at hy
              subst hy
              have := wordLater_head_E5 e (colC.drop (ei + 1)) l (by rw [hL]; rfl)
              omega
            | nil =>
              rw [hL, List.nil_append] at hy
              have := wordCols_head_E5 e (cols.drop (ci + 1)) y hy
              omega
        · intro k p
          rw [ker_litCapAux_cons k p ci ei j rest cols hcC hent]
          show wordCols e _ = _
          rw [wordCols_append]
          simp only [wordCols, List.append_nil]
          rw [show colC.take ei ++ [(q, litCapAux k p rest j h)] =
              colC.take ei ++ (q, litCapAux k p rest j h) :: [] from rfl, wordCol_split_E5,
            hcap k p]
          simp only [wordLater, List.append_nil, List.append_assoc]
        · intro k hk
          simp only [List.length_append] at hk
          obtain ⟨hc1, -, -⟩ := spCols_col_E5 e hcC (k := k) (by omega)
          have he1 := spCol_entry_E5 e hent
            (r := k - (wordCols e (cols.take ci)).length) (by omega)
          obtain ⟨G', hG', hGc⟩ := hsp (k - (wordCols e (cols.take ci)).length -
            (wordCol e (colC.take ei ++ [(q, Tree.empty)])).length) (by omega)
          refine ⟨G', ?_, ?_⟩
          · simp only [spF]
            rw [ker_forestAt_cons]
            simp only [Tree.cols]
            rw [hc1, Option.bind_some, he1, Option.bind_some]
            exact hG'
          · rw [hGc, List.length_append, List.length_append]
            congr 3
            omega
        · constructor
          intro hr
          obtain ⟨hl, h₁, hh₁, hr'⟩ := Scan.isRoutePath_cons.mp hr
          obtain ⟨colL, qL, hL, hcl, hel, hs, -⟩ := Scan.lastStep?_eq_some hl
          simp only [Tree.cols, Prod.mk.injEq] at hcl hs
          obtain ⟨hcie, heie⟩ := hs
          have hci' : cols[ci]? = some colL := by
            rw [hcie, ← List.getLast?_eq_getElem?]; exact hcl
          rw [hcC] at hci'
          cases hci'
          have hh : h₁ = h := by
            rw [ker_forestAt_cons] at hh₁
            simp only [Tree.cols, hcC, hent, Option.bind_some, Tree.forestAt] at hh₁
            exact (Option.some.inj hh₁).symm
          subst hh
          rw [hroute.mp hr', List.drop_eq_nil_of_le (by omega), List.drop_eq_nil_of_le (by omega)]
          simp [wordLater, wordCols]
          intro hS
          simp only [List.append_eq_nil_iff] at hS
          obtain ⟨⟨hS', hL⟩, hC⟩ := hS
          have hd1 : colC.drop (ei + 1) = [] := by
            cases h' : colC.drop (ei + 1) with
            | nil => rfl
            | cons x xs => rw [h'] at hL; obtain ⟨p, H⟩ := x; simp [wordLater] at hL
          have hd2 : cols.drop (ci + 1) = [] := by
            cases h' : cols.drop (ci + 1) with
            | nil => rfl
            | cons x xs =>
              rw [h'] at hC
              simp only [wordCols, List.append_eq_nil_iff] at hC
              exact absurd hC.1 (spx_wordCol_ne e x)
          have hci_last : ci + 1 = cols.length := by
            have := List.drop_eq_nil_iff.mp hd2; omega
          have hei_last : ei + 1 = colC.length := by
            have := List.drop_eq_nil_iff.mp hd1; omega
          have hlastC : cols.getLast? = some colC := by
            rw [List.getLast?_eq_getElem?, show cols.length - 1 = ci by omega, hcC]
          have hCne : colC ≠ [] := by intro h0; rw [h0] at hent; cases hent
          refine Scan.isRoutePath_cons.mpr ⟨?_, h, ?_, hroute.mpr hS'⟩
          · unfold Tree.lastStep?
            simp only [Tree.cols, hlastC, Option.bind_some, List.isEmpty_iff, hCne, if_false,
              Option.some.injEq, Prod.mk.injEq]
            omega
          · rw [ker_forestAt_cons]
            simp [Tree.cols, hcC, hent, Tree.forestAt]

-- T3.8lr/T3.8ls (G4, helper): a prefix of a route path is a route path
theorem isRoutePath_prefix_G4 {E : Forest} {π π' : List (Nat × Nat)} (h : π <+: π')
    (hr : Scan.IsRoutePath E π') : Scan.IsRoutePath E π := by
  obtain ⟨t, rfl⟩ := h
  intro d hd
  obtain ⟨F, hF, hl⟩ := hr d (by simp; omega)
  refine ⟨F, ?_, ?_⟩
  · rwa [List.take_append_of_le_length (by omega)] at hF
  · rw [hl, List.getElem?_append_left hd]

-- T3.8lr/T3.8ls (G4, helper; N2.2): when the forest of `c` is on the route, its local suffix runs to
-- the end of the word
theorem route_capPos_G4 {E : Forest} {c : ColAddr} (hc : c ∈ E.colAddrs)
    (hr : Scan.IsRoutePath E c.path) : capPos E c 0 + mu (localSuffix E c) = mu E := by
  obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff E c).1 hc)
  have hcol' := hcol
  unfold Tree.colAt at hcol'
  cases hG : E.forestAt c.path with
  | none => rw [hG] at hcol'; cases hcol'
  | some G =>
  rw [hG, Option.bind_some] at hcol'
  obtain ⟨Apre, S, hw, -, hcap, -, hroute⟩ := capDecomp_route_G4 c.path 0 c.col E G col hG hcol'
  rw [hroute.mp hr, List.append_nil, Nat.zero_add] at hw
  rw [Nat.zero_add] at hcap
  have hK : litCap E c 0 0 = litCapAux 0 0 c.path c.col E := by
    show litCapBody E c 0 0 = _
    unfold litCapBody
    rw [if_pos (by rw [hcol]; rfl)]
  have hcp : capPos E c 0 = Apre.length := by
    unfold capPos
    rw [hK]
    show (wordAt 0 _).length - 1 = _
    rw [hcap 0 0]
    simp [wordCol, Tree.empty, wordAt, wordCols, wordLater]
  have hloc : mu (localSuffix E c) = (wordCols c.path.length (G.cols.drop c.col)).length := by
    unfold localSuffix mu word
    rw [hG, Option.getD_some, len_wordCols_E5]
    rfl
  rw [hcp, hloc]
  unfold mu word
  rw [hw, List.length_append]

-- T3.8lr/T3.8ls (G4, helper): a root tail read from the root forest
theorem rootTail_of_forestAt_G4 {D F : Forest} {rd : RootData} (hidx : rd.idx = rd.col.col)
    (hF : D.forestAt rd.col.path = some F) (γ : Nat) :
    rootTail D rd γ = .node (((F.cols[rd.col.col]?).getD []).drop γ :: F.cols.drop (rd.col.col + 1)) := by
  unfold rootTail Tree.colAt; rw [hF, hidx]; rfl

-- T3.8lr/T3.8ls (G4, helper): the root tail of a context `C_E(Z)` from a column `o` on the stopping
-- column's stack is the root tail of `E` with its continuation hole (at relative depth
-- `ℓ − |o.path|`) filled by `Z`; that root tail has a route to the hole
theorem rootTail_context_G4 {E : Forest} {sd : StopData} (hsd : stopData E = some sd) (Z : Forest)
    {rd : RootData} (hidx : rd.idx = rd.col.col) (hst : sd.col.OnStack rd.col) {γ : Nat}
    (hγ : ∀ e, rd.col.container sd.col = some e → γ ≤ e.idx) :
    rootTail (context E sd Z) rd γ =
        replaceAt 0 0 Z (sd.depth - rd.col.path.length) (rootTail E rd γ) ∧
      KerRoute (sd.depth - rd.col.path.length) (rootTail E rd γ) ∧
      (sd.depth - rd.col.path.length = 0 → 2 ≤ (rootTail E rd γ).cols.length) := by
  obtain ⟨-, hdep, -, hmem, -⟩ := stopData_spec hsd
  obtain ⟨hpath, -⟩ := (Scan.mem_routeCols_iff E sd.col).1 hmem
  -- `rd.col` lies at level `j` of the stopping route
  obtain ⟨j, hj, hop⟩ : ∃ j, j ≤ sd.depth ∧ rd.col.path = sd.col.path.take j := by
    rcases hst with ⟨k, ck, ik, hk, hp, -⟩ | ⟨hp, -⟩
    · refine ⟨k, ?_, hp⟩
      have := (List.getElem?_eq_some_iff.mp hk).1; omega
    · exact ⟨sd.depth, le_rfl, by rw [hp, hdep, List.take_length]⟩
  have hjo : rd.col.path.length = j := by
    rw [hop, List.length_take]; omega
  obtain ⟨G, hG, hGR⟩ := ker_routeTo_of_stop hsd j hj
  have hC := ker_context_forestAt hsd Z j hj G hG
  rw [← hop] at hG hC
  obtain ⟨cols⟩ := G
  have hrtE := rootTail_of_forestAt_G4 hidx hG γ
  simp only [Tree.cols] at hrtE
  rw [hjo]
  rcases Nat.eq_zero_or_pos (sd.depth - j) with h0 | hpos
  · -- the hole is in the root forest: the root is an earlier column of the stopping forest
    have hjd : j = sd.depth := by omega
    have hos : rd.col.path = sd.col.path := by rw [hop, hjd, hdep, List.take_length]
    obtain ⟨F, hF, hFlen, -⟩ := ker_stopForest hsd
    rw [← hos, hG] at hF
    cases hF
    simp only [Tree.cols] at hFlen
    have hlt : rd.col.col < sd.col.col := by
      rcases hst with ⟨k, ck, ik, hk, hp, -⟩ | ⟨-, hlt⟩
      · exfalso
        have h1 := (List.getElem?_eq_some_iff.mp hk).1
        have h2 : rd.col.path.length = k := by rw [hp, List.length_take]; omega
        rw [hos] at h2; omega
      · exact hlt
    have hne : cols.drop (rd.col.col + 1) ≠ [] := by
      intro h; have := congrArg List.length h; simp at this; omega
    have hcne : cols ≠ [] := by intro h; rw [h] at hFlen; simp at hFlen
    rw [h0] at hC ⊢
    rw [ker_replaceAt_zero_zero _ _ hcne] at hC
    refine ⟨?_, ?_, fun _ => ?_⟩
    · rw [rootTail_of_forestAt_G4 hidx hC γ, hrtE, ker_replaceAt_zero_zero _ _ (List.cons_ne_nil _ _)]
      simp only [Tree.cols]
      rw [List.getElem?_append_left (by simp; omega), List.drop_append_of_le_length (by simp; omega),
        List.dropLast_cons_of_ne_nil hne, List.dropLast_drop_eq_drop_dropLast,
        List.getElem?_dropLast, if_pos (by omega)]
      rfl
    · rw [hrtE]; exact List.cons_ne_nil _ _
    · rw [hrtE]; simp only [Tree.cols, List.length_cons]
      have := List.length_pos_of_ne_nil hne; omega
  · -- the hole is deeper: the last column of the root forest is filled along its last entry
    obtain ⟨m, hm⟩ : ∃ m, sd.depth - j = m + 1 := ⟨sd.depth - j - 1, by omega⟩
    rw [hm] at hC hGR ⊢
    rw [ker_replaceAt_zero_succ] at hC
    obtain ⟨colL, p, H, hcl, hel, hR⟩ := hGR
    have hR' := ker_routeTo_route m H _ hR
    simp only [Tree.cols] at hcl
    have hcne : cols ≠ [] := by intro h; rw [h] at hcl; cases hcl
    have hcolne : colL ≠ [] := by intro h; rw [h] at hel; cases hel
    have hcl0 := List.length_pos_of_ne_nil hcne
    -- the route step at level `j`
    have hls : (Tree.node cols).lastStep? = some (cols.length - 1, colL.length - 1) := by
      unfold Tree.lastStep?
      simp only [Tree.cols, hcl, Option.bind_some, List.isEmpty_iff, hcolne, if_false]
    have hjl : j < sd.col.path.length := by rw [← hdep]; omega
    have hstep : sd.col.path[j]? = some (cols.length - 1, colL.length - 1) := by
      obtain ⟨F', hF', hl⟩ := hpath j hjl
      rw [← hop, hG] at hF'
      cases hF'
      rw [← hl, hls]
    -- the root is a column of its forest
    have hol : rd.col.col < cols.length := by
      rcases hst with ⟨k, ck, ik, hk, hp, hle⟩ | ⟨hp, -⟩
      · have h2 : k = j := by
          have h1 := (List.getElem?_eq_some_iff.mp hk).1
          rw [← hjo, hp, List.length_take]; omega
        subst h2
        rw [hstep] at hk
        simp only [Option.some.injEq, Prod.mk.injEq] at hk
        omega
      · exfalso; rw [hp] at hjo; rw [hdep] at hm; omega
    rcases Nat.lt_or_ge (rd.col.col + 1) cols.length with hlt | hge
    · have hne : cols.drop (rd.col.col + 1) ≠ [] := by
        intro h; have := congrArg List.length h; simp at this; omega
      refine ⟨?_, ?_, fun h => by omega⟩
      · rw [rootTail_of_forestAt_G4 hidx hC γ, hrtE, ker_replaceAt_zero_succ,
          ker_mapLast_cons _ _ _ hne]
        simp only [Tree.cols]
        rw [ker_mapLast_drop]
        congr 3
        rw [mapLast_eq, List.getElem?_append_left (by simp; omega), List.getElem?_map,
          List.getElem?_dropLast, if_pos (by omega)]
        cases cols[rd.col.col]? <;> rfl
      · rw [hrtE]
        refine ⟨colL, p, H, ?_, hel, hR'⟩
        simp only [Tree.cols]
        rw [List.getLast?_cons, List.getLast?_drop, if_neg (by omega), hcl]
        rfl
    · -- the root is the last column: it contains the stopping column through its last entry
      have hoc : rd.col.col = cols.length - 1 := by omega
      have hcolO : cols[rd.col.col]? = some colL := by
        rw [hoc, ← List.getLast?_eq_getElem?]; exact hcl
      have hcont : rd.col.container sd.col = some ⟨rd.col, colL.length - 1⟩ := by
        rw [ColAddr.container_spec]
        refine ⟨rfl, ?_⟩
        show rd.col.path ++ [(rd.col.col, colL.length - 1)] <+: sd.col.path
        rw [hop]
        rw [← hoc] at hstep
        have : sd.col.path.take j ++ [(rd.col.col, colL.length - 1)] = sd.col.path.take (j + 1) := by
          rw [List.take_add_one, hstep]; rfl
        rw [this]
        exact List.take_prefix _ _
      have hγk : γ ≤ colL.length - 1 := hγ _ hcont
      have hdrop : cols.drop (rd.col.col + 1) = [] := List.drop_eq_nil_of_le (by omega)
      refine ⟨?_, ?_, fun h => by omega⟩
      · rw [rootTail_of_forestAt_G4 hidx hC γ, hrtE, hdrop, ker_replaceAt_zero_succ, hcolO]
        simp only [Tree.cols, Option.getD_some]
        have h1 : (mapLast id (mapLast id fun x : Nat × Forest => (x.1, replaceAt 0 0 Z m x.2))
            cols)[rd.col.col]? =
            some (mapLast id (fun x : Nat × Forest => (x.1, replaceAt 0 0 Z m x.2)) colL) := by
          rw [mapLast_eq, List.getElem?_append_right (by simp; omega)]
          simp [hcl, show rd.col.col - (cols.length - 1) = 0 by omega]
        have hd2 : (mapLast id (mapLast id fun x : Nat × Forest => (x.1, replaceAt 0 0 Z m x.2))
            cols).drop (rd.col.col + 1) = [] :=
          List.drop_eq_nil_of_le (by rw [ker_length_mapLast]; omega)
        rw [h1, Option.getD_some, hd2, ker_mapLast_drop]
        simp [mapLast]
      · rw [hrtE, hdrop, hcolO]
        refine ⟨colL.drop γ, p, H, rfl, ?_, hR'⟩
        have := List.length_pos_of_ne_nil hcolne
        rw [List.getLast?_drop, if_neg (by omega), hel]

-- T3.8lr/T3.8ls (G4, helper): a forest with a route to depth `δ` keeps a column after the hole
-- is filled
theorem replaceAt_cols_ne_G4 {G : Forest} {δ : Nat} (hR : KerRoute δ G)
    (hG2 : δ = 0 → 2 ≤ G.cols.length) (Z : Forest) : (replaceAt 0 0 Z δ G).cols ≠ [] := by
  obtain ⟨cols⟩ := G
  cases δ with
  | zero =>
    have h2 := hG2 rfl
    simp only [Tree.cols] at h2
    have hne : cols ≠ [] := by intro h; rw [h] at h2; simp at h2
    rw [ker_replaceAt_zero_zero _ _ hne]
    simp only [Tree.cols]
    intro h
    have := congrArg List.length h
    simp at this; omega
  | succ m =>
    obtain ⟨col, p, H, hcl, -, -⟩ := hR
    rw [ker_replaceAt_zero_succ]
    simp only [Tree.cols] at hcl ⊢
    intro h
    have := congrArg List.length h
    rw [ker_length_mapLast] at this
    simp at this
    rw [this] at hcl; cases hcl

-- T3.8lr/T3.8ls (G4, helper; L3.5 (2)): prepending `Q` to a shifted hole filling: the word is a
-- fixed prefix followed by the relabelled word of the filling at the hole's depth
theorem word_diamond_fill_G4 {G : Forest} {δ : Nat} (hR : KerRoute δ G)
    (hG2 : δ = 0 → 2 ≤ G.cols.length) (Q : Column) (ρ a : Nat) :
    ∃ P, ∀ Z, word (diamond Q (shift ρ a (replaceAt 0 0 Z δ G))) =
      P ++ (wordAt δ Z).map (WordAtom.relabel (shiftVal ρ a)) := by
  have hR' : KerRoute δ (shift ρ a G) := ker_route_shift hR
  have hG2' : δ = 0 → 2 ≤ (shift ρ a G).cols.length := by
    intro h; have := hG2 h
    obtain ⟨cols⟩ := G
    rw [ker_shift_node]; simpa only [Tree.cols, List.length_map] using this
  have hX : ∀ Z, shift ρ a (replaceAt 0 0 Z δ G) = replaceAt 0 0 (shift ρ a Z) δ (shift ρ a G) := by
    intro Z; rw [shift_replaceAt, replaceAt_eq_shift]
  have hW : ∀ Z, word (replaceAt 0 0 (shift ρ a Z) δ (shift ρ a G)) =
      word (replaceAt 0 0 Tree.empty δ (shift ρ a G)) ++
        (wordAt δ Z).map (WordAtom.relabel (shiftVal ρ a)) := by
    intro Z
    have := ker_wordAt_replaceAt (shift ρ a Z) δ (shift ρ a G) 0 hR'
    rw [Nat.zero_add] at this
    unfold word
    rw [this]
    unfold shift
    rw [wordAt_map]
  -- the unfilled part has a first atom
  obtain ⟨a₀, T₀, hW₀⟩ : ∃ a₀ T₀, word (replaceAt 0 0 Tree.empty δ (shift ρ a G)) = a₀ :: T₀ := by
    have hne := replaceAt_cols_ne_G4 hR' hG2' Tree.empty
    generalize replaceAt 0 0 Tree.empty δ (shift ρ a G) = X0 at hne ⊢
    obtain ⟨cs⟩ := X0
    simp only [Tree.cols] at hne
    obtain ⟨c, cs, rfl⟩ := List.exists_cons_of_ne_nil hne
    cases hw : word (Tree.node (c :: cs)) with
    | nil =>
      exfalso
      simp only [word, wordAt, wordCols] at hw
      have := spx_wordCol_ne 0 c
      rw [List.append_eq_nil_iff] at hw
      exact this hw.1
    | cons a₀ T₀ => exact ⟨a₀, T₀, rfl⟩
  refine ⟨(if Q = [] then [] else word (Tree.node [Q])) ++
    (if Q = [] then a₀ :: T₀ else encHd_E5 a₀ ++ T₀), fun Z => ?_⟩
  have hne := replaceAt_cols_ne_G4 hR' hG2' (shift ρ a Z)
  rw [hX]
  have hXne : replaceAt 0 0 (shift ρ a Z) δ (shift ρ a G) ≠ Tree.empty := by
    intro h; rw [h] at hne; exact hne rfl
  rw [cancel_eq Q hXne, List.append_assoc]
  congr 1
  unfold encEps
  by_cases hQ : Q = []
  · rw [if_pos hQ, if_pos hQ, hW, hW₀]
  · rw [if_neg hQ, if_neg hQ]
    have hw := hW Z
    rw [hW₀] at hw
    generalize replaceAt 0 0 (shift ρ a Z) δ (shift ρ a G) = XZ at hne hw ⊢
    obtain ⟨cs⟩ := XZ
    simp only [Tree.cols] at hne
    obtain ⟨c, cs, rfl⟩ := List.exists_cons_of_ne_nil hne
    obtain ⟨a₁, T₁, hw₁, he₁⟩ := encOne_word_E5 c cs
    rw [hw₁, List.cons_append, List.cons.injEq] at hw
    obtain ⟨rfl, rfl⟩ := hw
    rw [he₁, List.append_assoc]

-- T3.8lr/T3.8ls (G4, helper): an ordinary input is its own context at its terminal column
theorem context_self_G4 {E : Forest} {sd : StopData} (hsd : stopData E = some sd) :
    context E sd (Tree.node [sd.Q ++ [(sd.r, Tree.empty)]]) = E := by
  obtain ⟨G, hG, hR⟩ := ker_routeTo_of_stop hsd 0 (Nat.zero_le _)
  simp only [List.take_zero, Tree.forestAt, Option.some.injEq] at hG
  subst hG
  exact ker_replaceAt_self _ _ _ hR

-- T3.8lr/T3.8ls (G4, helper): a safe prefix of a context, cut inside the filling, is the context
-- of a safe prefix of the filling
theorem safePrefix_context_G4 {E : Forest} {sd : StopData} (hsd : stopData E = some sd) (Z : Forest)
    {π : Nat} (hπ : (word (context E sd Tree.empty)).length ≤ π) :
    safePrefix (context E sd Z) π =
      context E sd (safePrefix Z (π - (word (context E sd Tree.empty)).length)) := by
  apply word_injective
  rw [word_safePrefix, word_context hsd Z, word_context hsd (safePrefix Z _), word_safePrefix,
    List.take_append, List.take_of_length_le hπ, List.map_take]

-- T3.8lr/T3.8ls (G4, helper): the word of the old terminal filling `[Q ⌢ (r, ∅)]` is `U ⌢ [z]`
-- where `U` (the query part) starts the word of every kernel output
theorem word_Z0_G4 (S : OrdStep) (X : Forest) :
    ∃ U z, word (Tree.node [S.sd.Q ++ [(S.sd.r, Tree.empty)]]) = U ++ [z] ∧
      U <+: word (kernel S.A S.sd S.rd X) := by
  obtain ⟨V, cs, hK, -⟩ := ker_kernel_firstCol (ker_unconsumed_lt S.inL.1 S.hsd S.hrd) X
  rw [hK]
  by_cases hQ : S.sd.Q = []
  · refine ⟨[], toLex (0, toLex (1, S.sd.r)), ?_, List.nil_prefix⟩
    rw [hQ]; simp [word, wordAt, wordCols, wordCol, Tree.empty, wordLater]
  · refine ⟨wordCol 0 S.sd.Q, toLex (1, toLex (0, S.sd.r)), ?_, ?_⟩
    · simp only [word, wordAt, wordCols, List.append_nil]
      rw [ker_wordCol_append 0 hQ]
      simp [wordLater, Tree.empty, wordAt, wordCols]
    · simp only [word, wordAt, wordCols]
      rw [ker_wordCol_append 0 hQ, List.append_assoc]
      exact List.prefix_append _ _

/-- T3.8lr/T3.8ls (G4, helper): an address of a kernel output placed after the query part of its
head column (not the head itself, not a Q-height). -/
def AfterQ_G4 (m : Nat) (b : ColAddr) : Prop :=
  match b.path with
  | [] => 1 ≤ b.col
  | (c0, e0) :: _ => 1 ≤ c0 ∨ m ≤ e0

theorem afterQ_underCol_G4 {m : Nat} {h : ColAddr} (hh : AfterQ_G4 m h) (y : ColAddr) :
    AfterQ_G4 m (underCol h y) := by
  obtain ⟨hp, hc⟩ := h
  obtain ⟨yp, yc⟩ := y
  cases yp with
  | nil =>
    cases hp with
    | nil => simp only [AfterQ_G4, underCol] at hh ⊢; omega
    | cons x rest => obtain ⟨c0, e0⟩ := x; simpa [AfterQ_G4, underCol] using hh
  | cons x rest =>
    obtain ⟨c0, e0⟩ := x
    cases hp with
    | nil => simp only [AfterQ_G4, underCol, List.nil_append] at hh ⊢; omega
    | cons z zs => obtain ⟨d0, f0⟩ := z; simpa [AfterQ_G4, underCol] using hh

theorem afterQ_kerCol_G4 (S : OrdStep) {x x' : ColAddr} (hx : kerCol S.sd S.rd x = some x')
    (hxq : isQMat S.sd x = false) (hne : x ≠ S.rd.col) : AfterQ_G4 S.m x' := by
  obtain ⟨suf, hsuf, hcases⟩ := kerCol_tail_spec S hx hxq
  rcases hcases with ⟨rfl, hcol, -⟩ | ⟨-, hlt, -, rfl⟩ | ⟨e, rest, -, -, rfl⟩ |
      ⟨ci, e, rest, -, hlt, -, rfl⟩
  · exfalso; apply hne
    obtain ⟨xp, xc⟩ := x
    simp only at hsuf hcol
    rw [hsuf, List.append_nil, hcol]
  · simp only [AfterQ_G4]; omega
  · simp only [AfterQ_G4]; omega
  · simp only [AfterQ_G4]; omega

-- T3.8lr/T3.8ls (G4, helper): the phase copy `c = phaseCol i a` sits under the stopping column after
-- the query part of the first head
theorem afterQ_phaseCol_G4 (S : OrdStep) {i : Nat} {a c : ColAddr} (hi : 1 ≤ i)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) : ∃ b, c = underCol S.sd.col b ∧ AfterQ_G4 S.m b := by
  obtain ⟨kh, hkh⟩ := kerCol_sdcol S
  have hsdne : S.sd.col ≠ S.rd.col := by
    intro h
    obtain ⟨-, -, -, hrnum, hrt, -⟩ := rootData_spec S.hsd S.hrd
    obtain ⟨-, -, ht, -⟩ := stopData_spec S.hsd
    rw [← h] at hrnum; omega
  have hkhA : AfterQ_G4 S.m kh := afterQ_kerCol_G4 S hkh (isQMat_of_short S.sd le_rfl) hsdne
  have hhole : kerHole S.sd S.rd = kh := by unfold kerHole; rw [hkh]; rfl
  unfold phaseCol at hc
  obtain ⟨a', ha', rfl⟩ := Option.map_eq_some_iff.mp hc
  refine ⟨_, rfl, ?_⟩
  rw [hhole]
  rcases Nat.eq_zero_or_pos (i - 1) with h0 | hpos
  · rw [h0, Function.iterate_zero, id]
    have haq : isQMat S.sd a = false := by
      cases h : isQMat S.sd a with
      | false => rfl
      | true => have := hq h; omega
    exact afterQ_kerCol_G4 S ha' haq ha.2.2.1
  · obtain ⟨j, hj⟩ : ∃ j, i - 1 = j + 1 := ⟨i - 2, by omega⟩
    rw [hj, Function.iterate_succ_apply']
    exact afterQ_underCol_G4 hkhA _

-- T3.8lr/T3.8ls (G4, helper): no column of `A` lies under the stopping column after its query part
theorem colAt_underCol_none_G4 (S : OrdStep) {b : ColAddr} (hb : AfterQ_G4 S.m b) :
    S.A.colAt (underCol S.sd.col b) = none := by
  obtain ⟨F, hF, hFlen, hFc⟩ := ker_stopForest S.hsd
  obtain ⟨bp, bc⟩ := b
  cases bp with
  | nil =>
    simp only [AfterQ_G4] at hb
    unfold Tree.colAt
    simp only [underCol]
    rw [hF, Option.bind_some]
    exact List.getElem?_eq_none (by omega)
  | cons x rest =>
    obtain ⟨c0, e0⟩ := x
    simp only [AfterQ_G4] at hb
    unfold Tree.colAt
    simp only [underCol]
    rw [Tree.forestAt_append, hF, Option.bind_some, ker_forestAt_cons]
    rcases hb with hc0 | he0
    · rw [List.getElem?_eq_none (by omega)]; rfl
    · rw [show S.sd.col.col + c0 = S.sd.col.col + c0 from rfl]
      cases hc : c0 with
      | succ c0' => rw [List.getElem?_eq_none (by omega)]; rfl
      | zero =>
        rw [Nat.add_zero, hFc, Option.bind_some]
        rcases Nat.lt_or_ge S.m e0 with hlt | hge
        · rw [List.getElem?_eq_none (by simp [OrdStep.m] at hlt ⊢; omega)]; rfl
        · have he : e0 = S.sd.Q.length := by simp only [OrdStep.m] at he0 hge; omega
          rw [he, List.getElem?_append_right le_rfl, Nat.sub_self]
          simp only [List.getElem?_cons_zero, Option.bind_some]
          cases rest with
          | nil => simp [Tree.forestAt, Tree.empty, Tree.cols]
          | cons y ys => obtain ⟨y1, y2⟩ := y; simp [Tree.forestAt, Tree.empty, Tree.cols]

-- T3.8lr/T3.8ls (G4, helper; N2.2): a filled phase-copy cap of `B` is a context of `A` whose filling
-- starts with the query part `U` of the old terminal filling `U ⌢ [z]` and extends beyond it
theorem capContext_G4 (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ) {sdN : StopData}
    (hsdN : stopData (litCap S.B c k ρ) = some sdN) :
    ∃ Z U z, context (litCap S.B c k ρ) sdN (localSuffix S.B c) = context S.A S.sd Z ∧
      word (Tree.node [S.sd.Q ++ [(S.sd.r, Tree.empty)]]) = U ++ [z] ∧ U <+: word Z ∧
      U.length < (word Z).length := by
  have hE : S.A ≠ Tree.empty := by
    intro h
    have := S.hsd
    rw [h, stopData_eq_none_of_lastCol (Or.inl rfl)] at this
    cases this
  set Zn := (kernel S.A S.sd S.rd)^[S.n] Tree.empty with hZn
  have hB : S.B = context S.A S.sd Zn := by
    have := expand_eq_iterate hE S.inL.1 S.inL.2.1 S.kind S.hsd S.hrd S.kernelDefined S.n
    rw [S.out] at this
    exact Option.some.inj this
  obtain ⟨U, z, hZ0, hUZ⟩ : ∃ U z, word (Tree.node [S.sd.Q ++ [(S.sd.r, Tree.empty)]]) = U ++ [z] ∧
      U <+: word Zn := by
    obtain ⟨n', hn'⟩ : ∃ n', S.n = n' + 1 := ⟨S.n - 1, by have := S.pos; omega⟩
    rw [hZn, hn', Function.iterate_succ_apply']
    exact word_Z0_G4 S _
  set W0 := word (context S.A S.sd Tree.empty) with hW0
  have hwA : word S.A = W0 ++ (U ++ [z]).map (depthShift S.sd.depth) := by
    conv_lhs => rw [← context_self_G4 S.hsd]
    rw [word_context S.hsd, hZ0]
  have hwB : word S.B = W0 ++ (word Zn).map (depthShift S.sd.depth) := by
    rw [hB, word_context S.hsd]
  have hmuA : mu S.A = W0.length + U.length + 1 := by
    unfold mu; rw [hwA]; simp; omega
  -- the filled cap is a safe prefix of `B`
  have hcB : c ∈ S.B.colAddrs := mem_colAddrs_of_upward hup
  set πB := capPos S.B c 0 + mu (localSuffix S.B c) with hπB
  have hD := context_litCap_localSuffix hup hsdN
  rw [← hπB] at hD
  have hπmu : πB ≤ mu S.B := by
    obtain ⟨Sx, hw, -⟩ := word_localSuffix hcB
    have h1 := capPos_le_mu_E5 hcB 0
    have := congrArg List.length hw
    simp only [List.length_append, List.length_take, List.length_map] at this
    unfold mu at h1 ⊢
    rw [hπB]; unfold mu
    rw [Nat.min_eq_left h1] at this
    omega
  -- the cut lies beyond the old terminal's query part (the copy is placed after it)
  have hπA : mu S.A ≤ πB := by
    by_contra hlt
    rw [Nat.not_le] at hlt
    have htake : (word S.B).take πB = (word S.A).take πB := by
      obtain ⟨T, hT⟩ := hUZ
      have hle : πB ≤ (W0 ++ U.map (depthShift S.sd.depth)).length := by
        simp only [List.length_append, List.length_map]; omega
      rw [hwA, hwB, ← hT, List.map_append, List.map_append, ← List.append_assoc,
        ← List.append_assoc, List.take_append_of_le_length hle, List.take_append_of_le_length hle]
    have hDA : context (litCap S.B c k ρ) sdN (localSuffix S.B c) = safePrefix S.A πB := by
      rw [hD]; apply word_injective; rw [word_safePrefix, word_safePrefix, htake]
    -- `c` is a column of the filled cap
    have hcD : ((context (litCap S.B c k ρ) sdN (localSuffix S.B c)).colAt c).isSome := by
      have hsdE : sdN = ⟨colDepth c, c, c.num 0, ρ, ((S.B.colAt c).getD []).take k⟩ :=
        Option.some.inj (hsdN.symm.trans (stopData_litCap hup))
      obtain ⟨F, hF, hFlen, -⟩ := ker_stopForest hsdN
      have hdep : sdN.depth = sdN.col.path.length := (stopData_spec hsdN).2.1
      have hCF := ker_context_forestAt hsdN (localSuffix S.B c) sdN.depth le_rfl F
        (by rw [hdep, List.take_length]; exact hF)
      rw [hdep, List.take_length, Nat.sub_self] at hCF
      have hcne : F.cols ≠ [] := by intro h; rw [h] at hFlen; simp at hFlen
      obtain ⟨Fc⟩ := F
      simp only [Tree.cols] at hcne
      rw [ker_replaceAt_zero_zero _ _ hcne] at hCF
      have hsc : sdN.col = c := by rw [hsdE]
      rw [hsc] at hCF hFlen
      simp only [Tree.cols] at hFlen
      obtain ⟨colc, hcolc⟩ := Option.isSome_iff_exists.mp ((Tree.mem_colAddrs_iff _ _).mp hcB)
      obtain ⟨G, hG, hGc⟩ : ∃ G, S.B.forestAt c.path = some G ∧ G.cols[c.col]? = some colc := by
        unfold Tree.colAt at hcolc
        cases h : S.B.forestAt c.path with
        | none => rw [h] at hcolc; cases hcolc
        | some G => rw [h] at hcolc; exact ⟨G, rfl, hcolc⟩
      unfold Tree.colAt
      rw [hCF, Option.bind_some]
      show ((Fc.dropLast ++ (localSuffix S.B c).cols)[c.col]?).isSome = true
      rw [List.getElem?_append_right (by simp; omega)]
      have hloc : (localSuffix S.B c).cols = G.cols.drop c.col := by
        unfold localSuffix; rw [hG]; rfl
      rw [hloc, List.getElem?_drop, show c.col + (c.col - Fc.dropLast.length) = c.col by
        simp; omega, hGc]
      rfl
    rw [hDA] at hcD
    obtain ⟨col', hcol'⟩ := Option.isSome_iff_exists.mp hcD
    obtain ⟨col, hcolA, -⟩ := colAt_safePrefix hcol'
    obtain ⟨b, rfl, hb⟩ := afterQ_phaseCol_G4 S hi ha hq hc
    rw [colAt_underCol_none_G4 S hb] at hcolA
    cases hcolA
  have hW0le : W0.length ≤ πB := by omega
  refine ⟨safePrefix Zn (πB - W0.length), U, z, ?_, hZ0, ?_, ?_⟩
  · rw [hD, hB, safePrefix_context_G4 S.hsd Zn hW0le]
  · rw [word_safePrefix]
    obtain ⟨T, hT⟩ := hUZ
    have hle : U.length ≤ πB - W0.length := by omega
    rw [← hT, List.take_append, List.take_of_length_le hle]
    exact ⟨_, rfl⟩
  · rw [word_safePrefix, List.length_take]
    have : πB ≤ W0.length + (word Zn).length := by
      have := hπmu; unfold mu at this; rw [hwB] at this; simpa using this
    omega

-- T3.8lr/T3.8ls (G4, helper): relabelling commutes with prepending a relabelled query
theorem diamond_map_G4 (f : Nat → Nat) (Q : Column) (X : Forest) :
    diamond (Tree.mapCol f Q) (Tree.map f X) = Tree.map f (diamond Q X) := by
  obtain ⟨cols⟩ := X
  cases cols with
  | nil => rfl
  | cons c cs =>
    simp only [Tree.map, Tree.mapCols, diamond, ker_mapCol_append]

-- T3.8lr/T3.8ls (G4, helper; from G9.6 `capQ_eq_kappaQ`): off the full cut, the first `k` entries of
-- the copy `c` are the `τ_φ`-images of those of `a`
theorem capCol_phase_G4 (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ)
    (hend : capPos S.B c k < mu S.B) :
    ((S.B.colAt c).getD []).take k =
      Tree.mapCol (shiftVal S.sd.r (phaseOff S.sd i a * S.d)) (((S.A.colAt a).getD []).take k) := by
  obtain ⟨hKcol, hKlen⟩ := litCap_colAt_self hup
  set f := shiftVal S.sd.r (phaseOff S.sd i a * S.d) with hf
  rw [mapCol_eq_map]
  by_cases haq : isQMat S.sd a = true
  · have hroute : ¬ OnHoleRoute S.sd a := fun h => by
      have := isQMat_of_short S.sd h.length_le
      rw [haq] at this
      cases this
    have hB := colAt_phaseCol S.inL S.kind S.hsd S.hrd S.out hi ha hroute hc
    rw [hB]
    cases S.A.colAt a with
    | none => simp
    | some col => simp [mapCol_eq_map, List.map_take, hf, OrdStep.d]
  · have haq' : isQMat S.sd a = false := by simpa using haq
    have hφ : phaseOff S.sd i a = i := by simp [phaseOff, haq']
    obtain ⟨Z, hZ⟩ := colAt_copyCol S (h := i) hi.2 ha haq'
    have hcopy : S.copyCol i a = c := by
      simp only [OrdStep.copyCol, if_neg (show i ≠ 0 by omega), hc, Option.getD_some]
    rw [hcopy] at hZ
    rw [hZ]
    have hctx : (((context S.A S.sd Z).colAt a).getD []).take k = ((S.A.colAt a).getD []).take k := by
      cases hce : a.container S.sd.col with
      | none =>
        rw [colAt_context_of_not_route S.hsd Z ha.1 ha.2.1 (sdcol_container_none S ha.1 haq') hce]
      | some e =>
        have hst := onStack_of_container hce
        obtain ⟨hpar, htk, -⟩ := colAt_context_onStack S.hsd Z hst
        have hkle : k ≤ e.idx := by
          have hk1 : k ≤ ((S.B.colAt c).getD []).length := by
            have := hKlen; rw [List.length_take] at this; omega
          have hBlen : ((S.B.colAt c).getD []).length = (parents S.A a).length := by
            rw [hZ, ← hpar]
            simp only [parents, List.length_map]
            cases (context S.A S.sd Z).colAt a with
            | none => rfl
            | some col => simp [mapCol_eq_map]
          have hl := container_sdcol_last S hce
          by_contra hcon
          have hk : k = e.idx + 1 := by omega
          subst hk
          have := fullCut_container_end S hi ha haq' hc hce hup
          omega
        have h1 := htk e hce
        have key : ∀ (o1 o2 : Option Column), o1.map (·.take e.idx) = o2.map (·.take e.idx) →
            (o1.getD []).take k = (o2.getD []).take k := by
          intro o1 o2 h12
          cases o1 with
          | none =>
            cases o2 with
            | none => rfl
            | some _ => cases h12
          | some C1 =>
            cases o2 with
            | none => cases h12
            | some C2 =>
              simp only [Option.map_some, Option.some.injEq] at h12
              simp only [Option.getD_some]
              rw [← Nat.min_eq_left hkle, ← List.take_take, h12, List.take_take]
        exact key _ _ h1
    rw [← hctx]
    simp only [hf, hφ]
    cases (context S.A S.sd Z).colAt a with
    | none => simp
    | some col => simp [mapCol_eq_map, List.map_take]

-- T3.8lr/T3.8ls (G4, helper; PS-U2-1, L3.5 (1) with T3.2h (3)): the kernel of the phase-copy cap is
-- the `τ_φ`-image of the old query prepended to the old-period shift of its root tail
theorem kernel_phaseCap_G4 (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat}
    (hi : 1 ≤ i ∧ i ≤ S.n) (ha : IsTmplCol S.A S.sd S.rd a)
    (hc : phaseCol S.sd S.rd i a = some c) (hup : IsUpward S.B c k ρ)
    (hKV : CondV (litCap S.B c k ρ)) (hend : capPos S.B c k < mu S.B) (hρ : ρ ≤ S.sd.r)
    {sdN : StopData} {rdN rdO : RootData} (hsdN : stopData (litCap S.B c k ρ) = some sdN)
    (hrdN : rootData (litCap S.B c k ρ) = some rdN) (hcol : rdN.col = rdO.col)
    (hcur : rdN.cursor = rdO.cursor) (hidxO : rdO.idx = rdO.col.col) (Y : Forest) :
    kernel (litCap S.B c k ρ) sdN rdN Y =
      shift S.sd.r (phaseOff S.sd i a * S.d) (diamond (((S.A.colAt a).getD []).take k)
        (shift ρ (a.num 0 - ρ) (rootTail (context (litCap S.B c k ρ) sdN Y) rdO rdO.cursor))) := by
  have hsdE : sdN = ⟨colDepth c, c, c.num 0, ρ, ((S.B.colAt c).getD []).take k⟩ :=
    Option.some.inj (hsdN.symm.trans (stopData_litCap hup))
  have hidxN : rdN.idx = rdN.col.col := (rootData_spec hsdN hrdN).2.2.1
  have hrt : ∀ D, rootTail D rdN rdN.cursor = rootTail D rdO rdO.cursor := by
    intro D; unfold rootTail; rw [hidxN, hidxO, hcol, hcur]
  have hnum : c.num 0 = a.num 0 + phaseOff S.sd i a * S.d :=
    num_phaseCol S.inL S.kind S.hsd S.hrd (Or.inr ha) hi.1 hc
  have hra : S.sd.r ≤ a.num 0 := (tmplCol_num_gt S ha).le
  rw [filling_identity hKV hsdN hrdN Y, hrt]
  have hQ : sdN.Q = Tree.mapCol (shiftVal S.sd.r (phaseOff S.sd i a * S.d))
      (((S.A.colAt a).getD []).take k) := by
    rw [hsdE]; exact capCol_phase_G4 S hi ha hc hup hend
  have hshift : ∀ X, shift sdN.r (period sdN) X =
      shift S.sd.r (phaseOff S.sd i a * S.d) (shift ρ (a.num 0 - ρ) X) := by
    intro X
    have hr : sdN.r = ρ := by rw [hsdE]
    have hp : period sdN = a.num 0 + phaseOff S.sd i a * S.d - ρ := by
      unfold period; rw [hsdE]; simp only; rw [hnum]
    rw [hr, hp]
    unfold shift
    rw [treeMap_map]
    congr 1
    funext p
    exact shiftVal_comp hρ hra p
  rw [hQ, hshift]
  exact diamond_map_G4 _ _ _

-- T3.8lr/T3.8ls (G4, helper): a root `≤ r` visible from a template column is on the stack of the
-- stopping column
theorem root_sdres_G4 (S : OrdStep) {a : ColAddr} (ha : IsTmplCol S.A S.sd S.rd a) {ρ : Nat}
    (hρ : ρ ≤ S.sd.r) {o : ColAddr} (ho : a.resolve 0 ρ = some o) :
    S.sd.col.resolve 0 ρ = some o := by
  obtain ⟨hres, -⟩ := rootData_path S.hsd S.hrd
  obtain ⟨hRa, -, -, -⟩ := phasePair_root_D7 S (j := 1) (a := a) (c := (phaseCol S.sd S.rd 1 a).getD a)
    (φ := phaseOff S.sd 1 a) (Or.inl ⟨ha, by
      obtain ⟨a', ha'⟩ := Option.isSome_iff_exists.mp ha.2.2.2
      simp [phaseCol, ha'], rfl⟩)
  rcases Nat.lt_or_ge ρ S.sd.r with hlt | hge
  · rw [← ColAddr.resolve_of_resolve_lt hres hlt, ColAddr.resolve_of_resolve_lt hRa hlt, ho]
  · have e : ρ = S.sd.r := by omega
    rw [e] at ho ⊢
    rw [hres, ← ho, hRa]

-- T3.8lr/T3.8ls (G4, helper; L2.4c): the root cursor of the phase-copy cap stops by the containing
-- entry of a root that contains the stopping column
theorem root_cursor_le_G4 (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat}
    (ha : IsTmplCol S.A S.sd S.rd a) (hc : phaseCol S.sd S.rd i a = some c)
    (hup : IsUpward S.B c k ρ) (hKL : InL (litCap S.B c k ρ)) {rdN : RootData}
    (hrdN : rootData (litCap S.B c k ρ) = some rdN) (hsdst : S.sd.col.OnStack rdN.col) :
    ∀ e, rdN.col.container S.sd.col = some e → rdN.cursor ≤ e.idx := by
  intro e he
  have hsdN := stopData_litCap hup
  obtain ⟨hresN, -, -, -, -, hownN, -⟩ := rootData_path hsdN hrdN
  simp only at hresN hownN
  obtain ⟨-, -, -, b, hb⟩ := phasePair_root_D7 S (Or.inl ⟨ha, hc, rfl⟩)
  have hcc : rdN.col.container c = rdN.col.container S.sd.col := by
    rw [hb]; exact container_underCol_of_onStack hsdst b
  have hcst : c.OnStack rdN.col := ((ColAddr.resolve_spec 0 _ _ _).mp hresN).1
  have hne := owner_root_nonexhaust hKL.1 hKL.2.2.2.1 hKL.2.2.2.2 hsdN hrdN
    (hownN.mpr (by rw [hcc, he]; rfl))
  obtain ⟨hK1, -⟩ := colAt_litCap_onStack (k := k) (p := ρ) (mem_colAddrs_of_upward hup) hcst
  obtain ⟨hKp, -⟩ := hK1 e (by rw [hcc]; exact he)
  have hE : S.A ≠ Tree.empty := by
    intro h
    have := S.hsd
    rw [h, stopData_eq_none_of_lastCol (Or.inl rfl)] at this
    cases this
  obtain ⟨Z, hBZ⟩ : ∃ Z, S.B = context S.A S.sd Z := by
    have := expand_eq_iterate hE S.inL.1 S.inL.2.1 S.kind S.hsd S.hrd S.kernelDefined S.n
    rw [S.out] at this
    exact ⟨_, Option.some.inj this⟩
  have hpar := (colAt_context_onStack S.hsd Z hsdst).1
  rw [← hBZ] at hpar
  have hl := container_sdcol_last S he
  have hlen : (((litCap S.B c k ρ).colAt rdN.col).getD []).length = e.idx + 1 := by
    have : (parents (litCap S.B c k ρ) rdN.col).length = e.idx + 1 := by
      rw [hKp, hpar, List.length_take]; omega
    simpa [parents] using this
  omega

-- T3.8lr (G4, helper): a route path reaching a forest with columns is a prefix of the stopping path
theorem route_prefix_G4 {E : Forest} {sd : StopData} (hsd : stopData E = some sd)
    {π : List (Nat × Nat)} (hr : Scan.IsRoutePath E π) {G : Forest} (hG : E.forestAt π = some G)
    (hGne : G.cols ≠ []) : π <+: sd.col.path := by
  obtain ⟨-, -, -, hmem, -⟩ := stopData_spec hsd
  obtain ⟨hP, -⟩ := (Scan.mem_routeCols_iff E sd.col).1 hmem
  set P := sd.col.path with hPdef
  -- the two route paths agree as long as both are defined
  have hagree : ∀ d, d ≤ π.length → d ≤ P.length → π.take d = P.take d := by
    intro d
    induction d with
    | zero => intros; simp
    | succ d ih =>
      intro h1 h2
      have e := ih (by omega) (by omega)
      obtain ⟨F₁, hF₁, hl₁⟩ := hr d (by omega)
      obtain ⟨F₂, hF₂, hl₂⟩ := hP d (by omega)
      rw [e, hF₂] at hF₁
      cases hF₁
      rw [List.take_add_one, List.take_add_one, e, ← hl₁, hl₂]
  rcases Nat.lt_or_ge P.length π.length with hlt | hle
  · exfalso
    have e := hagree P.length hlt.le le_rfl
    rw [List.take_length] at e
    obtain ⟨F₁, hF₁, hl₁⟩ := hr P.length hlt
    rw [e] at hF₁
    obtain ⟨F, hF, hFlen, hFc⟩ := ker_stopForest hsd
    rw [hF] at hF₁
    have hFF : F = F₁ := Option.some.inj hF₁
    subst hFF
    -- the last entry of the stopping column has an empty height
    have hFl : F.cols.getLast? = some (sd.Q ++ [(sd.r, Tree.empty)]) := by
      rw [List.getLast?_eq_getElem?, show F.cols.length - 1 = sd.col.col by omega, hFc]
    have hls : F.lastStep? = some (sd.col.col, sd.Q.length) := by
      unfold Tree.lastStep?
      simp [hFl]; omega
    rw [hls] at hl₁
    have hπ : π.take (P.length + 1) = P ++ [(sd.col.col, sd.Q.length)] := by
      rw [List.take_add_one, e, ← hl₁]; rfl
    have hFe : E.forestAt (π.take (P.length + 1)) = some Tree.empty := by
      rw [hπ, Tree.forestAt_append, hF, Option.bind_some, ker_forestAt_cons]
      simp [hFc, Tree.forestAt]
    rcases Nat.lt_or_ge (P.length + 1) π.length with hlt2 | hle2
    · obtain ⟨F₂, hF₂, hl₂⟩ := hr (P.length + 1) hlt2
      rw [hFe] at hF₂
      cases hF₂
      have : π[P.length + 1]? ≠ none := by
        rw [List.getElem?_eq_getElem hlt2]; simp
      rw [← hl₂] at this
      exact this (by simp [Tree.lastStep?, Tree.empty, Tree.cols])
    · have hπe : π = π.take (P.length + 1) := by rw [List.take_of_length_le (by omega)]
      rw [← hπe, hG] at hFe
      cases hFe
      exact hGne rfl
  · have e := hagree π.length le_rfl hle
    rw [List.take_length] at e
    rw [e]
    exact List.take_prefix _ _

-- T3.8lr (G4, helper; N2.2): the local suffix of a column off the hole route ends before the
-- terminal: something shallower follows it
theorem closed_end_G4 {E : Forest} {sd : StopData} (hsd : stopData E = some sd) {a : ColAddr}
    (ha : a ∈ E.colAddrs) (hroute : ¬ a.path <+: sd.col.path) :
    capPos E a 0 + mu (localSuffix E a) < mu E := by
  obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff E a).1 ha)
  have hcol' := hcol
  unfold Tree.colAt at hcol'
  cases hG : E.forestAt a.path with
  | none => rw [hG] at hcol'; cases hcol'
  | some G =>
  rw [hG, Option.bind_some] at hcol'
  obtain ⟨Apre, S, hw, -, hcap, -, hroute'⟩ := capDecomp_route_G4 a.path 0 a.col E G col hG hcol'
  rw [Nat.zero_add] at hw hcap
  have hS : S ≠ [] := by
    intro h0
    have hGne : G.cols ≠ [] := by intro h; rw [h] at hcol'; cases hcol'
    exact hroute (route_prefix_G4 hsd (hroute'.mpr h0) hG hGne)
  have hK : litCap E a 0 0 = litCapAux 0 0 a.path a.col E := by
    show litCapBody E a 0 0 = _
    unfold litCapBody
    rw [if_pos (by rw [hcol]; rfl)]
  have hcp : capPos E a 0 = Apre.length := by
    unfold capPos
    rw [hK]
    show (wordAt 0 _).length - 1 = _
    rw [hcap 0 0]
    simp [wordCol, Tree.empty, wordAt, wordCols, wordLater]
  have hloc : mu (localSuffix E a) = (wordCols a.path.length (G.cols.drop a.col)).length := by
    unfold localSuffix mu word
    rw [hG, Option.getD_some, len_wordCols_E5]
    rfl
  rw [hcp, hloc]
  have := List.length_pos_of_ne_nil hS
  unfold mu word
  rw [hw]
  simp only [List.length_append]
  omega

-- T3.8lr (G4, helper): the columns before `c` in a list contribute at least the columns before
-- `j < c` and the column `j`
theorem len_wordCols_take_G4 (e : Nat) {cols : List Column} {j c : Nat} {colj : Column}
    (hj : cols[j]? = some colj) (hjc : j < c) :
    (wordCols e (cols.take j)).length + (wordCol e colj).length ≤
      (wordCols e (cols.take c)).length := by
  have hjl : j < cols.length := (List.getElem?_eq_some_iff.mp hj).1
  have h1 : cols.take (j + 1) = cols.take j ++ [colj] := by
    rw [List.take_add_one, hj]; rfl
  have h2 : cols.take c = cols.take (j + 1) ++ (cols.take c).drop (j + 1) := by
    conv_lhs => rw [← List.take_append_drop (j + 1) (cols.take c)]
    rw [List.take_take, Nat.min_eq_left (by omega)]
  rw [h2, wordCols_append, h1, wordCols_append]
  simp only [wordCols, List.length_append, List.append_nil]
  omega

-- T3.8lr (G4, helper): a column cut after `γ ≤ |col|` entries is no longer than the column with one
-- more atom
theorem len_wordCol_cut_G4 (e p : Nat) (col : Column) (γ : Nat) :
    (wordCol e (col.take γ ++ [(p, Tree.empty)])).length ≤ (wordCol e col).length + 1 := by
  by_cases ht : col.take γ = []
  · rw [ht]; simp [wordCol, Tree.empty, wordAt, wordCols, wordLater]
  · rw [len_wordCol_snoc_E5 e ht]
    have : (wordCol e col).length = (wordCol e (col.take γ)).length +
        (wordLater e (col.drop γ)).length := by
      conv_lhs => rw [← List.take_append_drop γ col]
      rw [ker_wordCol_append e ht, List.length_append]
    omega

-- T3.8lr (G4, helper): cutting a column after `γ` entries is no longer than cutting it later,
-- through an entry `e₀ ≥ γ`
theorem len_wordCol_cut_le_G4 (e p q : Nat) (col : Column) {γ e₀ : Nat} (h : γ ≤ e₀) (X : Forest) :
    (wordCol e (col.take γ ++ [(p, Tree.empty)])).length ≤
      (wordCol e (col.take e₀ ++ [(q, X)])).length := by
  have hsplit : col.take e₀ ++ [(q, X)] = col.take γ ++ ((col.take e₀).drop γ ++ [(q, X)]) := by
    conv_lhs => rw [← List.take_append_drop γ (col.take e₀), List.take_take,
      Nat.min_eq_left h]
    rw [List.append_assoc]
  have hM : ((col.take e₀).drop γ ++ [(q, X)]) ≠ [] := by simp
  rw [hsplit]
  by_cases ht : col.take γ = []
  · rw [ht]
    simp only [List.nil_append]
    have := len_wordCol_snoc_le_E5 e ((col.take e₀).drop γ) q
    obtain ⟨⟨q', h'⟩, M', hM'⟩ := List.exists_cons_of_ne_nil hM
    rw [hM']
    simp [wordCol, Tree.empty, wordAt, wordCols, wordLater]
  · rw [len_wordCol_snoc_E5 e ht, ker_wordCol_append e ht, List.length_append,
      len_wordLater_E5 e hM]
    have := List.length_pos_of_ne_nil (spx_wordCol_ne e ((col.take e₀).drop γ ++ [(q, X)]))
    omega

-- T3.8lr (G4, helper): along a common address, a literal cap at an earlier stack position has a
-- word no longer than the cap at the start of a later column
theorem capLen_stack_G4 (γ p p' j' : Nat) (τ : List (Nat × Nat)) :
    ∀ (π : List (Nat × Nat)) (j e : Nat) (F : Forest),
      (F.colAt ⟨π ++ τ, j'⟩).isSome →
      (τ = [] → j < j') →
      (∀ c0 e0 σ, τ = (c0, e0) :: σ → j < c0 ∨ (j = c0 ∧ γ ≤ e0)) →
      γ ≤ ((F.colAt ⟨π, j⟩).getD []).length →
      (wordAt e (litCapAux γ p π j F)).length ≤ (wordAt e (litCapAux 0 p' (π ++ τ) j' F)).length
  | [], j, e, .node cols, hsome, hτ1, hτ2, hγ => by
    have hcolj : (Tree.node cols).colAt ⟨[], j⟩ = cols[j]? := rfl
    rw [hcolj] at hγ
    rw [List.nil_append] at hsome ⊢
    have hL : (wordAt e (litCapAux γ p [] j (Tree.node cols))).length =
        (wordCols e (cols.take j)).length +
          (wordCol e (((cols[j]?).getD []).take γ ++ [(p, Tree.empty)])).length := by
      have hgd : cols.getD j [] = (cols[j]?).getD [] := by simp [List.getD_eq_getElem?_getD]
      simp only [litCapAux, hgd, wordAt, wordCols_append, wordCols, List.append_nil,
        List.length_append]
    rw [hL]
    cases τ with
    | nil =>
      have hj' := hτ1 rfl
      have hsome' : (cols[j']?).isSome := hsome
      have hj'l : j' < cols.length := by
        cases h : cols[j']? with
        | none => rw [h] at hsome'; cases hsome'
        | some _ => exact (List.getElem?_eq_some_iff.mp h).1
      obtain ⟨colj, hcj⟩ : ∃ colj, cols[j]? = some colj := ⟨_, List.getElem?_eq_getElem (by omega)⟩
      rw [hcj, Option.getD_some] at hγ ⊢
      have h1 := len_wordCols_take_G4 e hcj hj'
      have h2 := len_wordCol_cut_G4 e p colj γ
      have hR : (wordAt e (litCapAux 0 p' [] j' (Tree.node cols))).length =
          (wordCols e (cols.take j')).length + 1 := by
        simp only [litCapAux, wordAt, wordCols_append, wordCols, List.append_nil,
          List.length_append, List.take_zero, List.nil_append]
        simp [wordCol, Tree.empty, wordAt, wordCols, wordLater]
      rw [hR]
      omega
    | cons s σ =>
      obtain ⟨c0, e0⟩ := s
      rw [colAt_cons] at hsome
      obtain ⟨colc, hcc, x, hx⟩ : ∃ colc, cols[c0]? = some colc ∧ ∃ x, colc[e0]? = some x := by
        cases h1 : cols[c0]? with
        | none => simp [h1] at hsome
        | some colc =>
          cases h2 : colc[e0]? with
          | none => simp [h1, h2] at hsome
          | some x => exact ⟨colc, rfl, x, h2⟩
      obtain ⟨q, h⟩ := x
      have hgd' : cols.getD c0 [] = colc := by simp [List.getD_eq_getElem?_getD, hcc]
      have hR : (wordAt e (litCapAux 0 p' ((c0, e0) :: σ) j' (Tree.node cols))).length =
          (wordCols e (cols.take c0)).length +
            (wordCol e (colc.take e0 ++ [(q, litCapAux 0 p' σ j' h)])).length := by
        simp only [litCapAux, hgd', hx, wordAt, wordCols_append, wordCols, List.append_nil,
          List.length_append]
      rw [hR]
      rcases hτ2 c0 e0 σ rfl with hlt | ⟨rfl, hle⟩
      · obtain ⟨colj, hcj⟩ : ∃ colj, cols[j]? = some colj := by
          have : c0 < cols.length := (List.getElem?_eq_some_iff.mp hcc).1
          exact ⟨_, List.getElem?_eq_getElem (by omega)⟩
        rw [hcj, Option.getD_some]
        have h1 := len_wordCols_take_G4 e hcj hlt
        have h2 := len_wordCol_cut_G4 e p colj γ
        have h3 := List.length_pos_of_ne_nil
          (spx_wordCol_ne e (colc.take e0 ++ [(q, litCapAux 0 p' σ j' h)]))
        omega
      · rw [hcc, Option.getD_some]
        have := len_wordCol_cut_le_G4 e p q colc hle (litCapAux 0 p' σ j' h)
        omega
  | (ci, ei) :: π, j, e, .node cols, hsome, hτ1, hτ2, hγ => by
    rw [List.cons_append, colAt_cons] at hsome
    obtain ⟨colc, hcc, x, hx⟩ : ∃ colc, cols[ci]? = some colc ∧ ∃ x, colc[ei]? = some x := by
      cases h1 : cols[ci]? with
      | none => simp [h1] at hsome
      | some colc =>
        cases h2 : colc[ei]? with
        | none => simp [h1, h2] at hsome
        | some x => exact ⟨colc, rfl, x, h2⟩
    obtain ⟨q, h⟩ := x
    rw [hcc, Option.bind_some, hx, Option.bind_some] at hsome
    rw [colAt_cons, hcc, Option.bind_some, hx, Option.bind_some] at hγ
    have ih := capLen_stack_G4 γ p p' j' τ π j (e + 1) h hsome hτ1 hτ2 hγ
    have hgd : cols.getD ci [] = colc := by simp [List.getD_eq_getElem?_getD, hcc]
    simp only [List.cons_append, litCapAux, hgd, hx, wordAt, wordCols_append, wordCols,
      List.append_nil, List.length_append]
    have hL := length_wordCol_last_D7 e (colc.take ei) q Tree.empty (litCapAux γ p π j h)
    have hR := length_wordCol_last_D7 e (colc.take ei) q Tree.empty
      (litCapAux 0 p' (π ++ τ) j' h)
    simp only [Tree.empty, wordAt, wordCols, List.length_nil, Nat.add_zero] at hL hR
    omega

-- T3.8lr (G4, helper): a cut at an earlier stack position (before the containing entry, if any)
-- lies no later than the start of the column
theorem capPos_stack_G4 {E : Forest} {o a : ColAddr} (ha : a ∈ E.colAddrs) (ho : o ∈ E.colAddrs)
    (hst : a.OnStack o) {γ : Nat} (hcont : ∀ e, o.container a = some e → γ ≤ e.idx)
    (hγ : γ ≤ ((E.colAt o).getD []).length) : capPos E o γ ≤ capPos E a 0 := by
  have hla : litCap E a 0 0 = litCapAux 0 0 a.path a.col E := by
    show litCapBody E a 0 0 = _
    unfold litCapBody
    rw [if_pos ((Tree.mem_colAddrs_iff _ _).mp ha)]
  have hlo : litCap E o γ 0 = litCapAux γ 0 o.path o.col E := by
    show litCapBody E o γ 0 = _
    unfold litCapBody
    rw [if_pos ((Tree.mem_colAddrs_iff _ _).mp ho)]
  have haS : (E.colAt a).isSome := (Tree.mem_colAddrs_iff _ _).mp ha
  unfold capPos
  rw [hla, hlo]
  show (wordAt 0 _).length - 1 ≤ (wordAt 0 _).length - 1
  suffices H : (wordAt 0 (litCapAux γ 0 o.path o.col E)).length ≤
      (wordAt 0 (litCapAux 0 0 a.path a.col E)).length by omega
  rcases hst with ⟨k, ck, ik, hk, hp, hle⟩ | ⟨hp, hlt⟩
  · have hkl : k < a.path.length := (List.getElem?_eq_some_iff.mp hk).1
    have hsplit : a.path = o.path ++ (ck, ik) :: a.path.drop (k + 1) := by
      rw [hp]
      conv_lhs => rw [← List.take_append_drop k a.path]
      rw [List.drop_eq_getElem_cons hkl, (List.getElem?_eq_some_iff.mp hk).2]
    have hcol := capLen_stack_G4 γ 0 0 a.col ((ck, ik) :: a.path.drop (k + 1)) o.path o.col 0 E
      (by rw [← hsplit]; exact haS) (fun h => by cases h)
      (by
        intro c0 e0 σ hτ
        simp only [List.cons.injEq, Prod.mk.injEq] at hτ
        obtain ⟨⟨rfl, rfl⟩, -⟩ := hτ
        rcases Nat.lt_or_ge o.col ck with h1 | h1
        · exact Or.inl h1
        · refine Or.inr ⟨by omega, hcont ⟨o, ik⟩ ?_⟩
          rw [ColAddr.container_spec]
          refine ⟨rfl, ?_⟩
          show o.path ++ [(o.col, ik)] <+: a.path
          rw [hsplit, show o.col = ck by omega]
          exact ⟨a.path.drop (k + 1), by simp⟩)
      hγ
    rw [← hsplit] at hcol
    exact hcol
  · have hcol := capLen_stack_G4 γ 0 0 a.col [] o.path o.col 0 E
      (by rw [List.append_nil, hp]; exact haS) (fun _ => hlt) (fun _ _ _ h => by cases h) hγ
    rw [List.append_nil] at hcol
    rw [← hp]
    exact hcol

-- T3.8lr (G4, helper; L3.5c): the root tail of a safe prefix cut after the root entry `γ`, when the
-- root forest is on the route, is a proper safe prefix of the root tail
theorem rootTail_safePrefix_G4 {E : Forest} {rd : RootData} (hidx : rd.idx = rd.col.col)
    (hcol : rd.col ∈ E.colAddrs) (hr : Scan.IsRoutePath E rd.col.path) {γ π : Nat}
    (hγ : capPos E rd.col γ < π) (hπ : π < mu E) :
    ∃ n, 1 ≤ n ∧ n < mu (rootTail E rd γ) ∧
      rootTail (safePrefix E π) rd γ = safePrefix (rootTail E rd γ) n := by
  obtain ⟨col, hcolS⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff E rd.col).1 hcol)
  have hcol' := hcolS
  unfold Tree.colAt at hcol'
  cases hG : E.forestAt rd.col.path with
  | none => rw [hG] at hcol'; cases hcol'
  | some G =>
  rw [hG, Option.bind_some] at hcol'
  obtain ⟨A, S, hw, -, hcap, hsp, hroute⟩ := capDecomp_route_G4 rd.col.path 0 rd.col.col E G col hG hcol'
  rw [Nat.zero_add] at hw hcap
  rw [hroute.mp hr, List.append_nil] at hw
  have hj : rd.col.col < G.cols.length := by
    by_contra hh; rw [List.getElem?_eq_none (by omega)] at hcol'; cases hcol'
  have hGd : G.cols.drop rd.col.col = col :: G.cols.drop (rd.col.col + 1) := by
    rw [List.drop_eq_getElem_cons hj]
    obtain ⟨_, h⟩ := List.getElem?_eq_some_iff.1 hcol'
    rw [h]
  obtain ⟨R, hR⟩ : ∃ R, G.cols.drop (rd.col.col + 1) = R := ⟨_, rfl⟩
  rw [hR] at hGd
  rw [hGd] at hw
  have hcp : capPos E rd.col γ =
      A.length + (wordCol rd.col.path.length (col.take γ ++ [(0, Tree.empty)])).length - 1 := by
    unfold capPos litCap litCapBody
    rw [if_pos (by rw [hcolS]; rfl)]
    show (wordAt 0 _).length - 1 = _
    rw [hcap, List.length_append]
  rw [len_capCol_E5] at hcp
  have hmu : mu E = A.length + (wordCols rd.col.path.length (col :: R)).length := by
    unfold mu word; rw [hw, List.length_append]
  have hA : A.length < π := by split_ifs at hcp <;> omega
  obtain ⟨G', hG', hG'c⟩ := hsp π hA
  rw [hGd] at hG'c
  have hm0 : π - A.length ≠ 0 := by omega
  simp only [spCols, hm0, if_false] at hG'c
  have hrt1 : rootTail (safePrefix E π) rd γ = Tree.node ((spCol (π - A.length) col).1.drop γ ::
      (spCols (spCol (π - A.length) col).2 R).1) := by
    have htk : (G.cols.take rd.col.col).length = rd.col.col := by simp; omega
    have hD1 : safePrefix E π = (spF π E).1 := rfl
    unfold rootTail
    rw [hD1, hidx]
    unfold Tree.colAt
    rw [hG', Option.bind_some, Option.getD_some, hG'c, List.getElem?_append_right (by omega),
      htk, Nat.sub_self, List.getElem?_cons_zero, Option.getD_some, List.drop_append,
      show (G.cols.take rd.col.col).drop (rd.col.col + 1) = [] from
        List.drop_eq_nil_of_le (by omega), List.nil_append, htk,
      show rd.col.col + 1 - rd.col.col = 1 by omega]
    rfl
  have hrt2 : rootTail E rd γ = Tree.node (col.drop γ :: R) := by
    unfold rootTail
    rw [hidx, hcolS, hG, Option.getD_some, Option.getD_some, hR]
  rw [hrt1, hrt2]
  have hγ' : col.take γ ≠ [] → (wordCol 0 (col.take γ)).length < π - A.length := by
    intro ht
    rw [if_neg ht] at hcp
    rw [← len_wordCol_E5 rd.col.path.length]
    omega
  obtain ⟨n, hn1, hnlen, heq⟩ := rt_sp_E5 col R (π - A.length) γ (by omega) hγ'
  refine ⟨n, hn1, ?_, heq⟩
  rw [len_wordCols_E5] at hmu
  omega

-- T3.8lr (txt:576-582): closed side targets with fixed root
theorem closed_side (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hq : isQMat S.sd a = true → 2 ≤ i)
    (hc : phaseCol S.sd S.rd i a = some c) (hroute : ¬ OnHoleRoute S.sd a)
    (hup : IsUpward S.B c k ρ) (hKL : InL (litCap S.B c k ρ)) (hend : capPos S.B c k < mu S.B)
    (hρ : ρ ≤ S.sd.r) (hold : Success (litCap S.A a k ρ) (localSuffix S.A a)) :
    Success (litCap S.B c k ρ) (localSuffix S.B c) := by
  have hφpos := phaseOff_pos_D7 hi.1 hq
  -- the old cap `K'` and its success
  have hrt : S.sd.r < S.sd.t := (rootData_spec S.hsd S.hrd).2.2.2.2.1
  have hd : 1 ≤ S.d := by simp only [OrdStep.d, period]; omega
  have hproj : S.proj (phaseOff S.sd i a) ρ = ρ := by
    unfold OrdStep.proj OrdStep.s
    have : S.d ≤ phaseOff S.sd i a * S.d := Nat.le_mul_of_pos_left _ (by omega)
    rw [if_neg (by omega), if_neg (by omega)]
  have hP := projection S hi ha hq hc hup hKL hend (Or.inl hρ)
  simp only [hproj] at hP
  obtain ⟨hupA, hVO, -, -⟩ := hP
  obtain ⟨sdO, rdO, hsdO, hrdO, hdefO, hltO⟩ := hold
  -- the new cap `K`
  have hBI : CondI S.B := condI_ord S.inL S.kind S.out
  have hord := litCap_ordinary hBI hup hKL.1 hKL.2.1
  have hsdN := stopData_litCap hup
  obtain ⟨rdN, hrdN⟩ := Option.isSome_iff_exists.mp (rootData_of_ordinary hord)
  have hdefN := kernelDefined_of_inL_E5 hKL hord hsdN hrdN
  -- T3.8lq: the root columns and the cursors agree
  obtain ⟨hcur, hcol⟩ := root_fixed_cursor S hi ha hq hc hup hKL hend hρ hrdN hrdO
  have hidxO : rdO.idx = rdO.col.col := (rootData_spec hsdO hrdO).2.2.1
  have hsdOE := Option.some.inj (hsdO.symm.trans (stopData_litCap hupA))
  -- the common root `o` is on the stacks of `a` and of the stopping column
  have hres := (rootData_path hsdO hrdO).1
  rw [hsdOE] at hres
  simp only at hres
  have hsdst : S.sd.col.OnStack rdO.col :=
    ((ColAddr.resolve_spec 0 _ _ _).mp (root_sdres_G4 S ha hρ hres)).1
  have hast : a.OnStack rdO.col := ((ColAddr.resolve_spec 0 _ _ _).mp hres).1
  have hγle : ∀ e, rdO.col.container S.sd.col = some e → rdO.cursor ≤ e.idx := by
    intro e he
    rw [← hcur]
    have hsdst' : S.sd.col.OnStack rdN.col := hcol ▸ hsdst
    exact root_cursor_le_G4 S ha hc hup hKL hrdN hsdst' e (hcol ▸ he)
  -- the root tail of `A` with its hole
  set Z0 : Forest := Tree.node [S.sd.Q ++ [(S.sd.r, Tree.empty)]] with hZ0
  set G := rootTail S.A rdO rdO.cursor with hG
  set δ := S.sd.depth - rdO.col.path.length with hδ
  set Q' := ((S.A.colAt a).getD []).take k with hQ'
  have hRT := fun Z => rootTail_context_G4 S.hsd Z hidxO hsdst hγle
  obtain ⟨hGZ0, hGR, hG2⟩ := hRT Z0
  rw [context_self_G4 S.hsd] at hGZ0
  rw [← hG, ← hδ] at hGZ0 hGR hG2
  -- the old filled cap is a safe prefix of `A` ending before the terminal (closed side)
  have hD1 := context_litCap_localSuffix hupA hsdO
  have hπA := closed_end_G4 S.hsd ha.1 hroute
  have hoA : rdO.col ∈ S.A.colAddrs := mem_colAddrs_of_sdstack S hsdst
  have hrO : Scan.IsRoutePath S.A rdO.col.path := by
    obtain ⟨-, -, -, hmem, -⟩ := stopData_spec S.hsd
    exact isRoutePath_prefix_G4 (onStack_prefix hsdst) ((Scan.mem_routeCols_iff _ _).1 hmem).1
  -- the root entry `γ` of the old cap starts before the end of `a`'s forest
  have hcapO : capPos S.A rdO.col rdO.cursor < capPos S.A a 0 + mu (localSuffix S.A a) := by
    have hcurO := (rootData_spec hsdO hrdO).2.2.2.2.2.2.1
    obtain ⟨-, -, -, -, -, hownO, -⟩ := rootData_path hsdO hrdO
    rw [hsdOE] at hownO
    simp only at hownO
    obtain ⟨hK1, hK2⟩ := colAt_litCap_onStack (k := k) (p := ρ) ha.1 hast
    have hlenK : (((litCap S.A a k ρ).colAt rdO.col).getD []).length ≤
        ((S.A.colAt rdO.col).getD []).length := by
      cases he : rdO.col.container a with
      | none => rw [hK2 he]
      | some e =>
        have := congrArg List.length (hK1 e he).1
        simp only [parents, List.length_map, List.length_take] at this
        omega
    have hcle : rdO.cursor ≤ (((litCap S.A a k ρ).colAt rdO.col).getD []).length := by
      rw [hcurO]
      have := cursor_le_length (rootKeys (litCap S.A a k ρ) rdO) (queryKeys sdO)
      simpa [rootKeys] using this
    have hcont : ∀ e, rdO.col.container a = some e → rdO.cursor ≤ e.idx := by
      intro e he
      have hdef := hdefO (hownO.mpr (by rw [he]; rfl))
      have hlt : rdO.cursor < (((litCap S.A a k ρ).colAt rdO.col).getD []).length := by
        by_contra hge
        apply hdef
        unfold unconsumed rootCol
        exact List.drop_eq_nil_of_le (by omega)
      have := congrArg List.length (hK1 e he).1
      simp only [parents, List.length_map, List.length_take] at this
      omega
    have h1 := capPos_stack_G4 ha.1 hoA hast hcont (hcle.trans hlenK)
    have h2 : 1 ≤ mu (localSuffix S.A a) := by
      obtain ⟨colA, hcolA⟩ := Option.isSome_iff_exists.mp ((Tree.mem_colAddrs_iff _ _).mp ha.1)
      unfold localSuffix mu word
      unfold Tree.colAt at hcolA
      cases hF : S.A.forestAt a.path with
      | none => rw [hF] at hcolA; cases hcolA
      | some F =>
        rw [hF, Option.bind_some] at hcolA
        have hlt := (List.getElem?_eq_some_iff.mp hcolA).1
        rw [Option.getD_some, List.drop_eq_getElem_cons hlt]
        simp only [wordAt, wordCols, List.length_append]
        have := List.length_pos_of_ne_nil (spx_wordCol_ne 0 (F.cols[a.col]'hlt))
        omega
    omega
  obtain ⟨n, hn1, hnlt, hX1⟩ := rootTail_safePrefix_G4 hidxO hoA hrO hcapO hπA
  rw [← hG] at hnlt hX1
  -- the new filled cap: a context of `A` whose filling extends the query part `U`
  obtain ⟨Zs, U, z, hCN, hwZ0, hUZ, hUlen⟩ := capContext_G4 S hi.1 ha hq hc hup hsdN
  have hK : kernel (litCap S.B c k ρ) (⟨colDepth c, c, c.num 0, ρ, ((S.B.colAt c).getD []).take k⟩)
      rdN (localSuffix S.B c) =
      shift S.sd.r (phaseOff S.sd i a * S.d)
        (diamond Q' (shift ρ (a.num 0 - ρ) (replaceAt 0 0 Zs δ G))) := by
    rw [kernel_phaseCap_G4 S hi ha hc hup hKL.1 hend hρ hsdN hrdN hcol hcur hidxO, hCN,
      (hRT Zs).1]
  -- the old kernel is a proper prefix-comparison below the new one (L3.5c)
  have hL1 : kernel (litCap S.A a k ρ) sdO rdO (localSuffix S.A a) =
      diamond Q' (shift ρ (a.num 0 - ρ) (safePrefix G n)) := by
    rw [filling_identity hVO hsdO hrdO, hD1, hX1, hsdOE]
    rfl
  have hwG := ker_wordAt_replaceAt Z0 δ G 0 hGR
  have hwX := ker_wordAt_replaceAt Zs δ G 0 hGR
  rw [← hGZ0, Nat.zero_add, ← map_depthShift_word_E5 δ Z0, hwZ0] at hwG
  rw [Nat.zero_add, ← map_depthShift_word_E5 δ Zs] at hwX
  have hlt12 : kernel (litCap S.A a k ρ) sdO rdO (localSuffix S.A a) <
      diamond Q' (shift ρ (a.num 0 - ρ) (replaceAt 0 0 Zs δ G)) := by
    rw [hL1]
    obtain ⟨T, hT⟩ := hUZ
    have hmuG : mu G = (wordAt 0 (replaceAt 0 0 Tree.empty δ G)).length + U.length + 1 := by
      unfold mu word; rw [hwG]; simp; omega
    have hmuX : mu (replaceAt 0 0 Zs δ G) =
        (wordAt 0 (replaceAt 0 0 Tree.empty δ G)).length + (word Zs).length := by
      unfold mu word; rw [hwX]; simp; rfl
    have hnU : n ≤ (wordAt 0 (replaceAt 0 0 Tree.empty δ G)).length + U.length := by omega
    refine diamond_lt_of_prefix_E5 (X₁ := safePrefix G n) (X₂ := replaceAt 0 0 Zs δ G) ?_
      (replaceAt_cols_ne_G4 hGR hG2 Zs) hn1 (by omega) ?_ Q' (shiftVal ρ (a.num 0 - ρ))
    · intro h0
      have hw0 : word (safePrefix G n) = [] := by
        generalize safePrefix G n = X at h0 ⊢
        obtain ⟨cs⟩ := X
        simp only [Tree.cols] at h0
        rw [h0]; rfl
      rw [word_safePrefix] at hw0
      have h4 : (word G).length ≥ 1 := by
        have := hmuG; unfold mu at this; omega
      have h3 := congrArg List.length hw0
      rw [List.length_take, List.length_nil] at h3
      omega
    · rw [word_safePrefix]
      show (wordAt 0 G).take n = (wordAt 0 _).take n
      have hl : n ≤ (wordAt 0 (replaceAt 0 0 Tree.empty δ G) ++
          List.map (depthShift δ) U).length := by simp; omega
      rw [hwG, hwX, ← hT, List.map_append, List.map_append, ← List.append_assoc,
        ← List.append_assoc, List.take_append_of_le_length hl, List.take_append_of_le_length hl]
  -- the target suffix is the `τ_φ`-image of a forest `≤ Y'` (T3.2i, T3.2l)
  obtain ⟨W, hYK, hWle⟩ : ∃ W, localSuffix S.B c = shift S.sd.r (phaseOff S.sd i a * S.d) W ∧
      W ≤ localSuffix S.A a := by
    obtain ⟨A'', hA''⟩ := Option.isSome_iff_exists.mp
      (expand_isSome S.inL.1 S.inL.2.1 S.inL.2.2.2.1 S.inL.2.2.2.2 (S.n - i))
    have hYK := localSuffix_phase S.inL S.kind S.hsd S.hrd S.out hi ha hc hA''
    by_cases haq : isQMat S.sd a = true
    · rw [if_pos haq] at hYK
      refine ⟨localSuffix S.A a, ?_, le_rfl⟩
      rw [hYK]
      simp [phaseOff, haq, OrdStep.d]
    · rw [if_neg haq] at hYK
      refine ⟨localSuffix A'' a, ?_,
        (localSuffix_cont_le S.inL S.kind S.hsd S.hrd hA'' (Or.inl ha)).1⟩
      rw [hYK]
      simp [phaseOff, haq, OrdStep.d]
  refine ⟨_, rdN, hsdN, hrdN, hdefN, ?_⟩
  rw [hK, hYK]
  exact (shift_lt_shift _ _).mpr (lt_of_le_of_lt hWle (lt_trans hltO hlt12))

-- T3.8ls (txt:583-605): direct body targets with fixed root (remainders (4), delayed change)
theorem direct_body (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
    (ha : IsTmplCol S.A S.sd S.rd a) (hc : phaseCol S.sd S.rd i a = some c)
    (hroute : OnHoleRoute S.sd a) (hup : IsUpward S.B c k ρ) (hKL : InL (litCap S.B c k ρ))
    (hend : capPos S.B c k < mu S.B) (hρ : ρ ≤ S.sd.r)
    (hold : Success (litCap S.A a k ρ) (localSuffix S.A a)) :
    Success (litCap S.B c k ρ) (localSuffix S.B c) := by
  -- `a` lies on the hole route: no Q-material, phase `i`
  have haq : isQMat S.sd a = false := isQMat_of_short S.sd hroute.length_le
  have hq : isQMat S.sd a = true → 2 ≤ i := fun h => by rw [haq] at h; cases h
  have hφ : phaseOff S.sd i a = i := by simp [phaseOff, haq]
  -- the old cap `K'` and its success
  have hrt : S.sd.r < S.sd.t := (rootData_spec S.hsd S.hrd).2.2.2.2.1
  have hd : 1 ≤ S.d := by simp only [OrdStep.d, period]; omega
  have hproj : S.proj (phaseOff S.sd i a) ρ = ρ := by
    unfold OrdStep.proj OrdStep.s
    have : S.d ≤ phaseOff S.sd i a * S.d := Nat.le_mul_of_pos_left _ (by rw [hφ]; omega)
    rw [if_neg (by omega), if_neg (by omega)]
  have hP := projection S hi ha hq hc hup hKL hend (Or.inl hρ)
  simp only [hproj] at hP
  obtain ⟨hupA, hVO, -, -⟩ := hP
  obtain ⟨sdO, rdO, hsdO, hrdO, hdefO, hltO⟩ := hold
  -- the new cap `K`
  have hBI : CondI S.B := condI_ord S.inL S.kind S.out
  have hord := litCap_ordinary hBI hup hKL.1 hKL.2.1
  have hsdN := stopData_litCap hup
  obtain ⟨rdN, hrdN⟩ := Option.isSome_iff_exists.mp (rootData_of_ordinary hord)
  have hdefN := kernelDefined_of_inL_E5 hKL hord hsdN hrdN
  -- T3.8lq: the root columns and the cursors agree
  obtain ⟨hcur, hcol⟩ := root_fixed_cursor S hi ha hq hc hup hKL hend hρ hrdN hrdO
  have hidxO : rdO.idx = rdO.col.col := (rootData_spec hsdO hrdO).2.2.1
  -- the old filled cap is `A` itself (the forest of `a` is on the route)
  have hrA : Scan.IsRoutePath S.A a.path := by
    obtain ⟨-, -, -, hmem, -⟩ := stopData_spec S.hsd
    exact isRoutePath_prefix_G4 hroute ((Scan.mem_routeCols_iff _ _).1 hmem).1
  have hCO : context (litCap S.A a k ρ) sdO (localSuffix S.A a) = S.A := by
    rw [context_litCap_localSuffix hupA hsdO, route_capPos_G4 ha.1 hrA]
    exact safePrefix_of_le le_rfl
  have hsdOE := Option.some.inj (hsdO.symm.trans (stopData_litCap hupA))
  -- the root of `K'` is on the stack of the stopping column
  have hres := (rootData_path hsdO hrdO).1
  rw [hsdOE] at hres
  simp only at hres
  have hsdst : S.sd.col.OnStack rdO.col :=
    ((ColAddr.resolve_spec 0 _ _ _).mp (root_sdres_G4 S ha hρ hres)).1
  have hγle : ∀ e, rdO.col.container S.sd.col = some e → rdO.cursor ≤ e.idx := by
    intro e he
    rw [← hcur]
    have hsdst' : S.sd.col.OnStack rdN.col := hcol ▸ hsdst
    exact root_cursor_le_G4 S ha hc hup hKL hrdN hsdst' e (hcol ▸ he)
  -- the root tail of `A` with its hole, and the words of the fillings (PS-U2-1)
  set Z0 : Forest := Tree.node [S.sd.Q ++ [(S.sd.r, Tree.empty)]] with hZ0
  set G := rootTail S.A rdO rdO.cursor with hG
  set δ := S.sd.depth - rdO.col.path.length with hδ
  set Q' := ((S.A.colAt a).getD []).take k with hQ'
  have hRT := fun Z => rootTail_context_G4 S.hsd Z hidxO hsdst hγle
  obtain ⟨-, hGR, hG2⟩ := hRT Z0
  obtain ⟨P, hPw⟩ := word_diamond_fill_G4 hGR hG2 Q' ρ (a.num 0 - ρ)
  -- the old kernel `L`
  have hL : kernel (litCap S.A a k ρ) sdO rdO (localSuffix S.A a) =
      diamond Q' (shift ρ (a.num 0 - ρ) (replaceAt 0 0 Z0 δ G)) := by
    rw [filling_identity hVO hsdO hrdO, hCO, ← (hRT Z0).1, context_self_G4 S.hsd, hsdOE]
    rfl
  -- the new cap: a context of `A` whose filling extends the query part `U`
  obtain ⟨Zs, U, z, hCN, hwZ0, hUZ, hUlen⟩ := capContext_G4 S hi.1 ha hq hc hup hsdN
  have hK : kernel (litCap S.B c k ρ) (⟨colDepth c, c, c.num 0, ρ, ((S.B.colAt c).getD []).take k⟩)
      rdN (localSuffix S.B c) =
      shift S.sd.r (phaseOff S.sd i a * S.d)
        (diamond Q' (shift ρ (a.num 0 - ρ) (replaceAt 0 0 Zs δ G))) := by
    rw [kernel_phaseCap_G4 S hi ha hc hup hKL.1 hend hρ hsdN hrdN hcol hcur hidxO, hCN,
      (hRT Zs).1]
  -- the shorter output `A_{n−i}` and the target suffix `Y_K = τ_i(Y_x(A_{n−i}))`
  obtain ⟨A'', hA''⟩ := Option.isSome_iff_exists.mp
    (expand_isSome S.inL.1 S.inL.2.1 S.inL.2.2.2.1 S.inL.2.2.2.2 (S.n - i))
  have hYK := localSuffix_phase S.inL S.kind S.hsd S.hrd S.out hi ha hc hA''
  rw [haq] at hYK
  simp only [Bool.false_eq_true, if_false] at hYK
  -- remainders: delayed change (L3.7) at the old terminal
  have hlt' : localSuffix A'' a <
      diamond Q' (shift ρ (a.num 0 - ρ) (replaceAt 0 0 Zs δ G)) := by
    rw [← word_lt_iff]
    have hRL := (word_lt_iff _ _).mpr hltO
    rw [hL] at hRL
    have hR := (word_lt_iff _ _).mpr
      ((localSuffix_cont_le S.inL S.kind S.hsd S.hrd hA'' (Or.inl ha)).2 (Or.inl hroute))
    obtain ⟨T, hT⟩ := hUZ
    have hw1 := hPw Z0
    have hw2 := hPw Zs
    rw [← map_depthShift_word_E5, hwZ0] at hw1
    rw [← map_depthShift_word_E5, ← hT] at hw2
    simp only [List.map_append, List.map_map] at hw1 hw2
    refine delayed_change (lam := P.length + U.length) hRL ?_ ?_ ?_ hR
    · -- `|Y'| < |L|`: the kernel's prefix is nonempty (D3.3b)
      have hk := word_kernel hVO hsdO hrdO hdefO (localSuffix S.A a)
      rw [hL] at hk
      have hne := kerPrefix_ne_nil (litCap S.A a k ρ) sdO rdO
      have h1 := congrArg List.length hk
      rw [hw1] at h1
      simp only [List.length_append, List.length_map, List.length_singleton] at h1
      have := List.length_pos_of_ne_nil hne
      omega
    · rw [hw1, hw2, ← List.append_assoc, ← List.append_assoc, List.take_left' (by simp),
        List.take_left' (by simp)]
    · rw [hw2]; simp only [List.length_append, List.length_map]; omega
  refine ⟨_, rdN, hsdN, hrdN, hdefN, ?_⟩
  rw [hK, hYK, hφ]
  have hdd : period S.sd = S.d := rfl
  rw [hdd]
  exact (shift_lt_shift _ _).mpr hlt'

-- D7: the parents of the stopping column are at least `r` (H, ending in `(r, ∅)`)
theorem sdcol_parent_ge_D7 (S : OrdStep) {v q : Nat} (h : (parents S.A S.sd.col)[v]? = some q) :
    S.sd.r ≤ q := by
  obtain ⟨hcol, -⟩ := stopData_spec S.hsd
  have hH : CondH S.A := S.inL.2.2.1
  have hmem : S.sd.col ∈ S.A.colAddrs := by rw [Tree.mem_colAddrs_iff, hcol]; rfl
  set col := S.sd.Q ++ [(S.sd.r, Tree.empty)] with hcoldef
  have hlast : col[S.sd.Q.length]? = some (S.sd.r, Tree.empty) := by
    rw [hcoldef, List.getElem?_append_right le_rfl, Nat.sub_self]; rfl
  have hpar : parents S.A S.sd.col = col.map Prod.fst := by
    simp only [parents, hcol, Option.getD_some]
  rw [hpar, List.getElem?_map] at h
  obtain ⟨x, hx, rfl⟩ := Option.map_eq_some_iff.mp h
  have hvlen : v ≤ S.sd.Q.length := by
    have := (List.getElem?_eq_some_iff.mp hx).1
    simp [hcoldef] at this; omega
  -- parents are nonincreasing down to the last entry `(r, ∅)`
  have hclen : col.length = S.sd.Q.length + 1 := by simp [hcoldef]
  have hmono : ∀ j, j ≤ S.sd.Q.length - v → ∀ y, col[S.sd.Q.length - j]? = some y →
      S.sd.r ≤ y.1 := by
    intro j
    induction j with
    | zero =>
      intro _ y hy
      rw [Nat.sub_zero, hlast] at hy
      obtain rfl := Option.some.inj hy
      exact le_rfl
    | succ j ih =>
      intro hj y hy
      have hzl : S.sd.Q.length - j < col.length := by omega
      obtain ⟨z, hz⟩ : ∃ z, col[S.sd.Q.length - j]? = some z :=
        ⟨_, List.getElem?_eq_getElem hzl⟩
      have hle := hH S.sd.col hmem (S.sd.Q.length - (j + 1)) y z (by rw [hcol]; exact hy)
        (by rw [hcol, show S.sd.Q.length - (j + 1) + 1 = S.sd.Q.length - j by omega]; exact hz)
      have := ih (by omega) z hz
      rcases hle with h1 | ⟨h1, -⟩ <;> omega
  exact hmono (S.sd.Q.length - v) le_rfl x
    (by rw [show S.sd.Q.length - (S.sd.Q.length - v) = v by omega]; exact hx)

-- T3.8lb step 4 (D7; I): the host bound of a column-start head-query cap
theorem headQuery_host_D7 (S : OrdStep) {i : Nat} {c : ColAddr} {ρ : Nat} (hi : 2 ≤ i ∧ i ≤ S.n)
    (hc : phaseCol S.sd S.rd i S.rd.col = some c) (hup : IsUpward S.B c 0 ρ)
    (hKL : InL (litCap S.B c 0 ρ)) (hρ : S.s (i - 1) < ρ)
    {π : List (Nat × Nat)} {ci ei : Nat} (hpa : S.sd.col.path = π ++ [(ci, ei)]) :
    (⟨π, ci⟩ : ColAddr).num 0 ≤ ρ - (i - 1) * S.d := by
  have hKI : CondI (litCap S.B c 0 ρ) := hKL.2.1
  have hp : PhasePair_D7 S i S.sd.col c (i - 1) := Or.inr ⟨rfl, hc, rfl⟩
  have hcontA : (⟨⟨π, ci⟩, ei⟩ : EntryAddr).Contains S.sd.col := by
    show EntryAddr.heightPath _ <+: _
    simp [EntryAddr.heightPath, hpa]
  have hha : (⟨π, ci⟩ : ColAddr).container S.sd.col = some ⟨⟨π, ci⟩, ei⟩ :=
    (ColAddr.container_spec _ _ _).mpr ⟨rfl, hcontA⟩
  have hres : S.sd.col.resolve 0 ((⟨π, ci⟩ : ColAddr).num 0) = some ⟨π, ci⟩ :=
    EntryAddr.resolve_host hcontA
  have hs : S.s (i - 1) = S.sd.r + (i - 1) * S.d := rfl
  by_cases hgt : S.sd.r < (⟨π, ci⟩ : ColAddr).num 0
  · obtain ⟨o', ho', hcont, -⟩ := phase_stack_F7 S ⟨by omega, hi.2⟩ hp hgt hres
    rw [hha] at hcont
    have := litCap_host_F7 hup hKI hcont
    rw [ColAddr.resolve_num ho'] at this
    omega
  · omega

-- T3.8lb (txt:607-608, with the method of T3.8li): the old terminal cap of a head-query cut
-- (moved here from before T3.8lc, brief rule 5: its proof uses the G-010 helpers)
theorem headQuery_oldCap (S : OrdStep) {i : Nat} {c : ColAddr} {k ρ : Nat} (hi : 2 ≤ i ∧ i ≤ S.n)
    (hc : phaseCol S.sd S.rd i S.rd.col = some c) (hk : k < S.m ∨ (k = S.m ∧ S.s (i - 1) < ρ))
    (hup : IsUpward S.B c k ρ) (hKL : InL (litCap S.B c k ρ)) :
    let K' := litCap S.A S.sd.col k (ρ - (i - 1) * S.d)
    S.s (i - 1) < ρ ∧ IsUpward S.A S.sd.col k (ρ - (i - 1) * S.d) ∧ CondV K' ∧ CondI K' ∧
      CondAK K' (capKeys K' (routeCols K')) := by
  intro K'
  have hi1 : 1 ≤ i ∧ i ≤ S.n := ⟨by omega, hi.2⟩
  obtain ⟨hmB, hparB, hkeyB⟩ := headQuery_prefix_D7 S hi1 hc
  obtain ⟨hcol, -, ht, -⟩ := stopData_spec S.hsd
  obtain ⟨-, -, -, hrnum, hrt, -⟩ := rootData_spec S.hsd S.hrd
  have hparA : parents S.A S.sd.col = S.sd.Q.map Prod.fst ++ [S.sd.r] := by
    simp [parents, hcol]
  have hlenA : (parents S.A S.sd.col).length = S.m + 1 := by
    rw [hparA]; simp [OrdStep.m]
  have hkm : k ≤ S.m := by rcases hk with h | ⟨h, -⟩ <;> omega
  obtain ⟨hcB, hkB, hupB⟩ := isUpward_iff_parents_D7.mp hup
  have hmemA : S.sd.col ∈ S.A.colAddrs := by rw [Tree.mem_colAddrs_iff, hcol]; rfl
  -- the parents of the head before `m` are the shifted query parents
  have hparBk : ∀ v, v < S.m → (parents S.B c)[v]? =
      ((parents S.A S.sd.col)[v]?).map (shiftVal S.sd.r ((i - 1) * S.d)) := by
    intro v hv
    rw [← List.getElem?_take_of_lt hv, hparB, List.getElem?_map, List.getElem?_take_of_lt hv]
  -- the closing parent beats the shifted old next parent
  have hnext : ∀ q, (parents S.A S.sd.col)[k]? = some q → q + (i - 1) * S.d < ρ := by
    intro q hq
    have hrq := sdcol_parent_ge_D7 S hq
    rcases hk with hk | ⟨rfl, hρ⟩
    · have := hupB _ (by rw [hparBk k hk, hq]; rfl)
      simpa [shiftVal, hrq] using this
    · rw [hparA, List.getElem?_append_right (by simp [OrdStep.m]),
        show S.m - (S.sd.Q.map Prod.fst).length = 0 by simp [OrdStep.m]] at hq
      simp only [List.getElem?_cons_zero, Option.some.injEq] at hq
      subst hq
      simpa [OrdStep.s] using hρ
  have hρ : S.s (i - 1) < ρ := by
    obtain ⟨q, hq⟩ : ∃ q, (parents S.A S.sd.col)[k]? = some q :=
      ⟨_, List.getElem?_eq_getElem (by omega)⟩
    have := hnext q hq
    have := sdcol_parent_ge_D7 S hq
    simp only [OrdStep.s]
    omega
  have hupA : IsUpward S.A S.sd.col k (ρ - (i - 1) * S.d) := by
    refine isUpward_iff_parents_D7.mpr ⟨hmemA, by omega, fun q hq => ?_⟩
    have := hnext q hq
    omega
  obtain ⟨-, hnum⟩ := phasePair_num_D7 S hi1 (Or.inr ⟨rfl, hc, rfl⟩)
  refine ⟨hρ, hupA, ?_, ?_, ?_⟩
  · -- V
    have := lt_num_of_litCap_D7 hup hKL.1
    exact condV_litCap_D7 S.inL.1 hmemA (by omega) (by omega)
  · -- I
    refine condI_litCap_D7 S.inL.2.1 hmemA (by omega) ?_
    intro hk0 π ci ei hpa
    subst hk0
    exact headQuery_host_D7 S hi hc hup hKL hρ hpa
  · -- decorated A: the final test, through the head pair `(sd.col, c, i − 1)`
    refine condAK_litCap_D7 S.inL hupA ?_
    have hpre : (parents S.B c).take k =
        ((parents S.A S.sd.col).take k).map (shiftVal S.sd.r ((i - 1) * S.d)) := by
      have e : (parents S.B c).take k = ((parents S.B c).take S.m).take k := by
        rw [List.take_take, Nat.min_eq_left hkm]
      rw [e, hparB, List.map_take, List.take_take, Nat.min_eq_left hkm, List.map_take]
    have hQ : cutQuery (actualKeys S.B c) k =
        kappaQ S.sd.r S.d (i - 1) (cutQuery (actualKeys S.A S.sd.col) k) := by
      have e : (actualKeys S.B c).take k = ((actualKeys S.B c).take S.m).take k := by
        rw [List.take_take, Nat.min_eq_left hkm]
      unfold cutQuery
      rw [e, hkeyB]
      unfold kappaQ
      rw [List.map_take, List.take_take, Nat.min_eq_left hkm, ← List.map_take,
        nu_map (kappaQry_strictMono _ _ _)]
    have hKA := capping_forward hKL.1 hKL.2.2.2.1 hKL.2.2.2.2
      (sel := routeCols (litCap S.B c k ρ)) (fun _ h => h)
    obtain ⟨hcK, -⟩ := litCap_parents_self hup
    have hB := (aAt_litCap_final_D7 hup).mp ((condAK_iff _ _).mp hKA c hcK k)
    have := phase_finalTest_D7 S hi1 (Or.inr ⟨rfl, hc, rfl⟩) (by omega) (by omega) hpre hQ
      (Or.inr hρ.le) hB
    have hproj : S.proj (i - 1) ρ = ρ - (i - 1) * S.d := by
      simp [OrdStep.proj, hρ]
    rwa [hproj] at this

-- T3.8la (helper): `w(A) = X ⌢ [z]` with `z` the atom of the closing entry `(r, ∅)`, and
-- `w(B) = X ⌢ T` with `T` below `[z]` (D3.3a, D3.3b)
theorem ordStep_word_F6 (S : OrdStep) :
    ∃ X T, word S.A = X ++ [capAtomAt S.sd.depth S.m S.sd.r] ∧ word S.B = X ++ T ∧
      (S.m = 0 → ∃ y, T.head? = some y ∧ (ofLex y).1 = 2 * S.sd.depth) ∧
      ∀ y ∈ T.head?, y < capAtomAt S.sd.depth S.m S.sd.r := by
  have hV := S.inL.1
  have hI := S.inL.2.1
  obtain ⟨hBeq, hkd⟩ := ker_expand_out hV hI S.kind S.hsd S.hrd S.out
  have hkd := hkd S.pos
  -- `A` is its own context filled with its stopping column
  have hA : S.A = context S.A S.sd (Tree.node [S.sd.Q ++ [(S.sd.r, Tree.empty)]]) := by
    obtain ⟨G, hG, hR⟩ := ker_routeTo_of_stop S.hsd 0 (Nat.zero_le _)
    simp only [List.take_zero, forestAt_nil_path, Option.some.injEq, Nat.sub_zero] at hG hR
    subst hG
    unfold context
    rw [ker_replaceAt_self _ _ _ hR]
  -- the filling of `B` starts with the column `Q ++ V`
  obtain ⟨n', hn'⟩ : ∃ n', S.n = n' + 1 := ⟨S.n - 1, by have := S.pos; omega⟩
  set Z := (kernel S.A S.sd S.rd)^[S.n] Tree.empty with hZ
  obtain ⟨V, hV0, -⟩ := ker_kernel_col0 S.A S.sd S.rd ((kernel S.A S.sd S.rd)^[n'] Tree.empty)
  have hZc : ∃ more, Z = Tree.node ((S.sd.Q ++ V) :: more) := by
    rw [hZ, hn', Function.iterate_succ_apply']
    revert hV0
    generalize kernel S.A S.sd S.rd ((kernel S.A S.sd S.rd)^[n'] Tree.empty) = W
    intro hV0
    obtain ⟨cols⟩ := W
    cases cols with
    | nil => simp [colAt_node_nil] at hV0
    | cons c cs =>
      rw [colAt_node_nil] at hV0
      simp only [List.getElem?_cons_zero, Option.some.injEq] at hV0
      exact ⟨cs, by rw [hV0]⟩
  obtain ⟨more, hZc⟩ := hZc
  have hm : S.m = S.sd.Q.length := rfl
  have hwA : word S.A = word (context S.A S.sd Tree.empty) ++
      ((if S.m = 0 then [] else wordCol 0 S.sd.Q) ++ [capAtomAt 0 S.m S.sd.r]).map
        (depthShift S.sd.depth) := by
    conv_lhs => rw [hA]
    rw [word_context S.hsd]
    congr 2
    have h1 : S.sd.Q = (S.sd.Q ++ [(S.sd.r, Tree.empty)]).take S.m := by
      rw [hm, List.take_left]
    simp only [word, wordAt, wordCols, List.append_nil]
    conv_lhs => rw [h1]
    rw [wordCol_take_snoc 0 _ _ _ (by simp [hm]), ← h1]
  have hwB : word S.B = word (context S.A S.sd Tree.empty) ++
      ((if S.m = 0 then [] else wordCol 0 S.sd.Q) ++
        (if S.m = 0 then wordCol 0 V else wordLater 0 V) ++ wordCols 0 more).map
        (depthShift S.sd.depth) := by
    rw [hBeq, word_context S.hsd, hZc]
    congr 2
    simp only [word, wordAt, wordCols]
    by_cases h0 : S.m = 0
    · rw [if_pos h0, if_pos h0]
      have : S.sd.Q = [] := List.eq_nil_of_length_eq_zero (by rw [← hm]; exact h0)
      rw [this]; simp
    · rw [if_neg h0, if_neg h0]
      have hne : S.sd.Q ≠ [] := by intro h; apply h0; rw [hm, h]; rfl
      rw [wordCol_append' 0 hne]
  have hz : depthShift S.sd.depth (capAtomAt 0 S.m S.sd.r) = capAtomAt S.sd.depth S.m S.sd.r := by
    unfold depthShift capAtomAt
    split_ifs
    · simp
    · simp only [ofLex_toLex]; congr 2; omega
  set X := word (context S.A S.sd Tree.empty) ++
    (if S.m = 0 then [] else wordCol 0 S.sd.Q).map (depthShift S.sd.depth) with hX
  set T := ((if S.m = 0 then wordCol 0 V else wordLater 0 V) ++ wordCols 0 more).map
    (depthShift S.sd.depth) with hT
  have hwA' : word S.A = X ++ [capAtomAt S.sd.depth S.m S.sd.r] := by
    rw [hwA, List.map_append, List.map_singleton, hz, hX, List.append_assoc]
  have hwB' : word S.B = X ++ T := by
    rw [hwB, hX, hT, List.map_append, List.map_append, List.append_assoc, List.append_assoc,
      List.map_append]
  refine ⟨X, T, hwA', hwB', fun h0 => ?_, ?_⟩
  · rw [hT, if_pos h0]
    cases V with
    | nil => exact ⟨_, rfl, by simp [depthShift]⟩
    | cons x V' =>
      obtain ⟨p, h⟩ := x
      exact ⟨_, rfl, by simp [depthShift]⟩
  -- `B < A` and the common prefix `X`
  have hAne : S.A ≠ Tree.empty := by
    intro h; have := S.hsd; rw [h] at this
    simp [stopData, stopDataBody, stopF, stopCols, Tree.empty] at this
  have hlt : word S.B < word S.A := (word_lt_iff _ _).2 (expand_lt hAne hV hI S.out)
  rw [hwA', hwB', ker_append_lt_append_iff] at hlt
  intro y hy
  clear_value T
  cases T with
  | nil => simp at hy
  | cons t T' =>
    simp only [List.head?_cons, Option.mem_def, Option.some.injEq] at hy
    subst hy
    rcases List.cons_lt_cons_iff.1 hlt with h | ⟨-, h⟩
    · exact h
    · exact absurd h (List.not_lt_nil _)


-- T3.8la (helper): the full cut of a nonempty route column appends one atom at the end of the word
theorem wordAt_litCapAux_full_F6 (p : Nat) :
    ∀ (π : List (Nat × Nat)) (j : Nat) (F : Forest) (col : Column) (e : Nat),
      (∀ d < π.length, ∃ G, F.forestAt (π.take d) = some G ∧ G.lastStep? = π[d]?) →
      (∃ G, F.forestAt π = some G ∧ G.cols.length = j + 1) →
      F.colAt ⟨π, j⟩ = some col → col ≠ [] →
      wordAt e (litCapAux col.length p π j F) =
        wordAt e F ++ [capAtomAt (e + π.length) col.length p]
  | [], j, .node cols, col, e, _, hG, hcol, hne => by
    obtain ⟨G, hG, hl⟩ := hG
    rw [forestAt_nil_path] at hG; obtain rfl := Option.some.inj hG
    rw [colAt_node_nil] at hcol
    simp only [Tree.cols] at hl
    have hcolj : cols.getD j [] = col := by rw [List.getD_eq_getElem?_getD, hcol]; rfl
    rw [litCapAux_nil, hcolj, List.take_length]
    have hd : cols.drop (j + 1) = [] := List.drop_eq_nil_of_le (by omega)
    simp only [wordAt, wordCols_append, wordCols, List.append_nil, List.length_nil]
    rw [wordCols_split e hcol, hd]
    have := wordCol_take_snoc e col col.length p le_rfl
    rw [List.take_length, if_neg (by simpa using hne)] at this
    rw [this]
    simp [wordCols]
  | (ci, ei) :: π, j, .node cols, col, e, hroute, hG, hcol, hne => by
    obtain ⟨G0, hG0, hls⟩ := hroute 0 (by simp)
    simp only [List.take_zero, forestAt_nil_path, Option.some.injEq] at hG0
    subst hG0
    simp only [Tree.lastStep?, Tree.cols, List.getElem?_cons_zero] at hls
    obtain ⟨colL, hL, hls⟩ := Option.bind_eq_some_iff.1 hls
    split_ifs at hls with hLe
    obtain ⟨rfl, rfl⟩ := Prod.mk.inj (Option.some.inj hls)
    have hcolsne : cols ≠ [] := by rintro rfl; simp at hL
    have hLi : cols[cols.length - 1]? = some colL := by rw [← List.getLast?_eq_getElem?]; exact hL
    have hLne : colL ≠ [] := by simpa using hLe
    rw [colAt_node_cons, hLi] at hcol
    simp only [Option.bind_some] at hcol
    obtain ⟨x, hx, hcolx⟩ := Option.bind_eq_some_iff.1 hcol
    obtain ⟨q, H⟩ := x
    have ih := wordAt_litCapAux_full_F6 p π j H col (e + 1) (fun d hd => by
        obtain ⟨G, hG, hl⟩ := hroute (d + 1) (by simp; omega)
        refine ⟨G, ?_, by simpa using hl⟩
        rw [List.take_succ_cons, forestAt_node_cons, hLi] at hG
        simpa [hx] using hG)
      (by
        obtain ⟨G, hG, hl⟩ := hG
        rw [forestAt_node_cons, hLi] at hG
        exact ⟨G, by simpa [hx] using hG, hl⟩) hcolx hne
    have hLg : cols.getD (cols.length - 1) [] = colL := by
      rw [List.getD_eq_getElem?_getD, hLi]; rfl
    rw [litCapAux_cons _ _ _ _ _ _ _ (by rw [hLg]; exact hx), hLg]
    have hc1 : cols = cols.take (cols.length - 1) ++ [colL] := by
      conv_lhs => rw [← List.take_append_drop (cols.length - 1) cols,
        List.drop_eq_getElem_cons (by have := List.length_pos_of_ne_nil hcolsne; omega),
        (List.getElem?_eq_some_iff.1 hLi).2]
      rw [List.drop_eq_nil_of_le (by omega)]
    have hc2 : colL = colL.take (colL.length - 1) ++ [(q, H)] := by
      conv_lhs => rw [← List.take_append_drop (colL.length - 1) colL,
        List.drop_eq_getElem_cons (by have := List.length_pos_of_ne_nil hLne; omega),
        (List.getElem?_eq_some_iff.1 hx).2]
      rw [List.drop_eq_nil_of_le (by omega)]
    have hw : wordAt e (Tree.node cols) = wordCols e (cols.take (cols.length - 1)) ++
        wordCol e (colL.take (colL.length - 1) ++ [(q, Tree.empty)]) ++ wordAt (e + 1) H := by
      conv_lhs => rw [hc1, hc2]
      simp only [wordAt, wordCols_append, wordCols, List.append_nil]
      rw [wordCol_snoc, ← wordAt, List.append_assoc]
    rw [hw, List.length_cons]
    simp only [wordAt, wordCols_append, wordCols, List.append_nil]
    rw [wordCol_snoc, ← wordAt, ih]
    simp only [List.append_assoc]
    rw [show e + 1 + π.length = e + (π.length + 1) by omega]

-- T3.8la (helper): the full cut of a nonempty route column is at the end of the word
theorem capPos_full_route_F6 {E : Forest} {c : ColAddr} (hc : c ∈ routeCols E) {col : Column}
    (hcol : E.colAt c = some col) (hne : col ≠ []) : mu E ≤ capPos E c col.length := by
  obtain ⟨hroute, G, hG, hl⟩ := (mem_routeCols_iff E c).1 hc
  have h := wordAt_litCapAux_full_F6 0 c.path c.col E col 0 hroute ⟨G, hG, hl⟩ hcol hne
  unfold capPos mu word
  rw [litCap_eq_aux hcol, h]
  simp


-- T3.8la (helper): a cut of `B` at a column `c` of `A` that is not above `A` lies at the end of
-- `A`'s query part: it is the old closing slot `(sd.col, m)`, or a full cut of a route column of
-- `A` (otherwise its cap is a cap of `A`, which lies above `A` by L3.1c)
theorem cut_in_A_F6 (S : OrdStep) {c : ColAddr} {k ρ : Nat} (hup : IsUpward S.B c k ρ)
    (hle : ¬ S.A < litCap S.B c k ρ) {colA : Column} (hcolA : S.A.colAt c = some colA)
    (hk : k ≤ colA.length) :
    (c = S.sd.col ∧ k = S.m ∧ ρ ≤ S.sd.r) ∨
      (k = colA.length ∧ k ≠ 0 ∧ (routeCols S.A)[colDepth c]? = some c) := by
  obtain ⟨X, T, hwA, hwB, hT0, hT⟩ := ordStep_word_F6 S
  have hdepth := (stopData_spec S.hsd).2.1
  set z := capAtomAt S.sd.depth S.m S.sd.r with hz
  obtain ⟨R, hwR, hcapA, hnext, hπle⟩ := litCap_word_data hcolA hk
  set π := capPos S.A c k with hπ
  set e := colDepth c with he
  have hRlen : π + R.length = X.length + 1 := by
    have := congrArg List.length hwR
    rw [List.length_append, List.length_take_of_le hπle, hwA] at this
    simpa using this.symm
  have hcB : c ∈ S.B.colAddrs := mem_colAddrs_of_upward hup
  have hcA : c ∈ S.A.colAddrs := by rw [Tree.mem_colAddrs_iff, hcolA]; rfl
  obtain ⟨colB0, hcolB0, hkB0, -⟩ := isUpward_iff_exists.1 hup
  -- transfer of the cap of `A` to `B` along a common word prefix (N2.1)
  have transfer : ∀ (Sx : List WordAtom), word S.B = (word S.A).take π ++ Sx →
      (k ≠ 0 → HeadLe (2 * e + 1) Sx) →
      (k = 0 → ∃ y, Sx.head? = some y ∧ (ofLex y).1 = 2 * e) →
      litCap S.B c k ρ = litCap S.A c k ρ ∧ capPos S.B c k = π := by
    intro Sx hSx h1 h0
    obtain ⟨colB, hcolB, hkB, -, hcapB⟩ := litCap_transfer k c.path c.col S.A colA 0
      ((word S.A).take π) hcolA hk (fun p => by
        have := hcapA p
        rw [litCap_eq_aux hcolA, capAtom_eq] at this
        simpa [word, colDepth] using this) S.B Sx (by simpa [word] using hSx)
      (by simpa [he, colDepth] using h1) (by simpa [he, colDepth] using h0)
    have hwKB : ∀ p, word (litCap S.B c k p) = (word S.A).take π ++ [capAtom c k p] := by
      intro p
      rw [litCap_eq_aux hcolB, word, hcapB p, capAtom_eq, colDepth]; simp
    refine ⟨word_injective (by rw [hwKB, hcapA]), ?_⟩
    unfold capPos; rw [hwKB]; simp [List.length_take_of_le hπle, π]
  -- the next atom of `A` after the cut
  have hR1 : k ≠ 0 → HeadLe (2 * e + 1) R := by
    intro hk0 y hy
    cases hck : colA[k]? with
    | some x =>
      obtain ⟨q, h⟩ := x
      rw [hnext.1 q h hck] at hy
      simp only [Option.mem_def, Option.some.injEq] at hy
      subst hy; simp [capAtomAt, hk0]
    | none =>
      have := hnext.2.1 (le_antisymm hk (List.getElem?_eq_none_iff.1 hck)) hk0 y hy
      omega
  have hR0 : k = 0 → ∃ y, R.head? = some y ∧ (ofLex y).1 = 2 * e := by
    intro hk0
    cases hck : colA[k]? with
    | some x =>
      obtain ⟨q, h⟩ := x
      exact ⟨_, hnext.1 q h hck, by simp [capAtomAt, hk0]⟩
    | none =>
      exact ⟨_, hnext.2.2 (le_antisymm hk (List.getElem?_eq_none_iff.1 hck)) hk0, rfl⟩
  have hAtake : (word S.A).take π ++ R = X ++ [z] := by rw [← hwR, hwA]
  rcases Nat.lt_or_ge π X.length with hlt | hge
  · -- (i) the cut lies inside the common prefix `X`: `K` is the cap of `A` at `(c, k)`
    have hPX : (word S.A).take π = X.take π := by
      rw [hwA, List.take_append_of_le_length (by omega)]
    have hPB : (word S.B).take π = X.take π := by
      rw [hwB, List.take_append_of_le_length (by omega)]
    have hatB : (word S.B)[π]? = (word S.A)[π]? := by
      rw [hwB, hwA, List.getElem?_append_left hlt, List.getElem?_append_left hlt]
    have hatA : (word S.A)[π]? = R.head? := by
      conv_lhs => rw [hwR]
      rw [List.getElem?_append_right (by rw [List.length_take_of_le hπle]),
        List.length_take_of_le hπle, Nat.sub_self, List.head?_eq_getElem?]
    have hdrop : ((word S.B).drop π).head? = R.head? := by
      rw [List.head?_drop, hatB, hatA]
    obtain ⟨hKeq, hposB⟩ := transfer ((word S.B).drop π)
      (by rw [hPX, ← hPB, List.take_append_drop])
      (fun hk0 y hy => hR1 hk0 y (by rw [← hdrop]; exact hy))
      (fun hk0 => by rw [hdrop]; exact hR0 hk0)
    have hupA : IsUpward S.A c k ρ := by
      rw [isUpward_iff_atom hcA (by rw [hcolA]; exact hk)]
      intro y hy
      have hB := (isUpward_iff_atom hcB (by rw [hcolB0]; exact hkB0)).1 hup
      exact hB y (by rw [hposB, hatB]; exact hy)
    exact absurd (hKeq ▸ lt_litCap hupA) hle
  rcases Nat.eq_or_lt_of_le hge with heq | hgt
  · -- (ii) the cut is right before the old closing atom `z`
    have hR : R = [z] := by
      have hPX : (word S.A).take π = X := by
        rw [hwA, ← heq, List.take_left]
      rw [hPX] at hAtake
      exact List.append_cancel_left hAtake
    cases hck : colA[k]? with
    | some x =>
      obtain ⟨q, h⟩ := x
      have hzq := hnext.1 q h hck
      rw [hR] at hzq
      simp only [List.head?_cons, Option.some.injEq] at hzq
      have hAeq : litCap S.A c k q = S.A := by
        apply word_injective
        rw [hcapA q]
        conv_rhs => rw [hwR, hR]
        rw [capAtom_eq, ← he, ← hzq]
      have hs := stopData_litCap' hcolA k q
      rw [hAeq, S.hsd, Option.some.injEq] at hs
      have hcs : c = S.sd.col := by rw [hs]
      have hkm : k = S.m := by
        show k = S.sd.Q.length
        rw [hs]; simp [List.length_take_of_le hk]
      have hqr : q = S.sd.r := by rw [hs]
      left
      refine ⟨hcs, hkm, ?_⟩
      by_contra hρq
      -- a larger closing parent: `K` is the cap of `A` at the old closing slot, above `A`
      have hPX : (word S.A).take π = X := by rw [hwA, ← heq, List.take_left]
      have he' : e = S.sd.depth := by rw [he, colDepth, hcs, hdepth]
      obtain ⟨hKeq, -⟩ := transfer T (by rw [hPX, hwB])
        (fun hk0 y hy => by
          have := hT y hy
          rw [hz, ← hkm, ← he', capAtomAt, if_neg hk0, Prod.Lex.lt_iff] at this
          rcases this with h | ⟨h, -⟩ <;> simp at h <;> omega)
        (fun hk0 => by
          obtain ⟨y, hy, hy'⟩ := hT0 (by rw [← hkm]; exact hk0)
          exact ⟨y, hy, by rw [hy', he']⟩)
      have hupA : IsUpward S.A c k ρ :=
        isUpward_iff_exists.2 ⟨colA, hcolA, hk, fun q' h' hq' => by
          rw [hck, Option.some.injEq, Prod.mk.injEq] at hq'
          rw [← hq'.1, hqr]; omega⟩
      exact hle (hKeq ▸ lt_litCap hupA)
    | none =>
      have hkl : k = colA.length := le_antisymm hk (List.getElem?_eq_none_iff.1 hck)
      by_cases hk0 : k = 0
      · exfalso
        have := hnext.2.2 hkl hk0
        rw [hR] at this
        simp only [List.head?_cons, Option.some.injEq, hz, capAtomAt] at this
        split_ifs at this <;> simp only [Prod.mk.injEq, toLex_inj] at this <;> omega
      · exfalso
        have hzle : (ofLex z).1 ≤ 2 * e := hnext.2.1 hkl hk0 z (by rw [hR]; rfl)
        have hzlt : z < capAtom c k ρ := by
          rw [capAtom_eq, capAtomAt, if_neg hk0, ← he]
          rw [Prod.Lex.lt_iff]; left; simpa using Nat.lt_succ_of_le hzle
        have hPX : (word S.A).take π = X := by rw [hwA, ← heq, List.take_left]
        have hAK : S.A < litCap S.A c k ρ := by
          rw [← word_lt_iff, hcapA ρ, hPX]
          conv_lhs => rw [hwA]
          rw [ker_append_lt_append_iff]
          exact List.cons_lt_cons_iff.2 (Or.inl hzlt)
        obtain ⟨hKeq, -⟩ := transfer T (by rw [hPX, hwB])
          (fun _ y hy => by
            have := hT y hy
            rw [Prod.Lex.lt_iff] at this
            rcases this with h | ⟨h, -⟩ <;> omega)
          (fun h => absurd h hk0)
        exact hle (hKeq ▸ hAK)
  · -- (iii) the cut is at the end of `w(A)`: a full cut of a route column of `A`
    have hR : R = [] := by
      apply List.eq_nil_of_length_eq_zero; omega
    cases hck : colA[k]? with
    | some x =>
      obtain ⟨q, h⟩ := x
      have := hnext.1 q h hck
      rw [hR] at this; simp at this
    | none =>
      have hkl : k = colA.length := le_antisymm hk (List.getElem?_eq_none_iff.1 hck)
      have hk0 : k ≠ 0 := by
        intro hk0
        have := hnext.2.2 hkl hk0
        rw [hR] at this; simp at this
      right
      refine ⟨hkl, hk0, ?_⟩
      have hw : word (litCap S.A c k 0) = word S.A ++
          [if decide (k = 0) then toLex (2 * e, toLex (1, 0)) else toLex (2 * e + 1, toLex (0, 0))] := by
        rw [hcapA 0, capAtom_eq_if, ← he]
        congr 1
        conv_rhs => rw [hwR, hR, List.append_nil]
      obtain ⟨c', k', -, hk', hlast, -, -, -, -, hroute⟩ := routeCols_of_word_snoc hw
      have hc' : c' = c := by
        have := (stopData_spec (stopData_litCap' hcolA k 0)).2.2.2.2.1
        rw [hlast] at this
        exact Option.some.inj this
      subst hc'
      have hk'0 : k' ≠ 0 := by
        intro h; have := hk'.1 h; simp [hk0] at this
      exact (hroute hk'0).1


-- T3.8la (helper): two route paths of one forest are prefixes of each other
theorem routePath_prefix_F6 {E : Forest} {π σ : List (Nat × Nat)} (hπ : IsRoutePath E π)
    (hσ : IsRoutePath E σ) (hle : π.length ≤ σ.length) : π = σ.take π.length := by
  have key : ∀ d, d ≤ π.length → π.take d = σ.take d := by
    intro d
    induction d with
    | zero => intro _; simp
    | succ d ih =>
      intro hd
      have h1 := ih (by omega)
      obtain ⟨F, hF, hl⟩ := hπ d (by omega)
      obtain ⟨F', hF', hl'⟩ := hσ d (by omega)
      rw [h1, hF'] at hF
      cases hF
      rw [List.take_add_one, List.take_add_one, h1, ← hl, hl']
  conv_lhs => rw [← List.take_length (l := π)]
  exact key _ le_rfl

-- T3.8la (helper): a placement below depth `0` keeps the last step and the number of columns
theorem replaceAt_succ_lastStep_F6 (Z : Forest) (m : Nat) (G : Forest) :
    (replaceAt 0 0 Z (m + 1) G).lastStep? = G.lastStep? ∧
      (replaceAt 0 0 Z (m + 1) G).cols.length = G.cols.length := by
  obtain ⟨cols⟩ := G
  rw [ker_replaceAt_zero_succ]
  simp only [Tree.lastStep?, Tree.cols]
  refine ⟨?_, ker_length_mapLast _ _ _⟩
  rw [ker_getLast?_mapLast, ker_length_mapLast]
  cases cols.getLast? with
  | none => rfl
  | some col =>
    simp only [Option.map_some, Option.bind_some, ker_length_mapLast]
    congr 1
    have : (mapLast id (fun x : Nat × Forest => (x.1, replaceAt 0 0 Z m x.2)) col).isEmpty =
        col.isEmpty := by
      rw [Bool.eq_iff_iff, List.isEmpty_iff, List.isEmpty_iff, ← List.length_eq_zero_iff,
        ← List.length_eq_zero_iff, ker_length_mapLast]
    rw [this]

-- T3.8la (helper): a route column of `A` above the stopping depth is a route column of any
-- context `C_A(Z)`
theorem routeCols_context_F6 {A : Forest} {sd : StopData} (hsd : stopData A = some sd)
    (Z : Forest) {c : ColAddr} (hc : c ∈ routeCols A) (hlt : c.path.length < sd.depth) :
    c ∈ routeCols (context A sd Z) := by
  obtain ⟨hroute, G, hG, hl⟩ := (mem_routeCols_iff A c).1 hc
  obtain ⟨-, hdep, -, hsdr, -⟩ := stopData_spec hsd
  obtain ⟨hsroute, -⟩ := (mem_routeCols_iff A sd.col).1 hsdr
  have hpre := routePath_prefix_F6 hroute hsroute (by rw [← hdep]; omega)
  have hctx : ∀ d, d ≤ c.path.length → ∀ G', A.forestAt (c.path.take d) = some G' →
      (context A sd Z).forestAt (c.path.take d) =
        some (replaceAt 0 0 Z (sd.depth - d - 1 + 1) G') := by
    intro d hd G' hG'
    have : c.path.take d = sd.col.path.take d := by
      rw [hpre, List.take_take, Nat.min_eq_left hd]
    rw [this] at hG' ⊢
    rw [ker_context_forestAt hsd Z d (by omega) G' hG', show sd.depth - d - 1 + 1 = sd.depth - d by
      omega]
  rw [mem_routeCols_iff]
  refine ⟨fun d hd => ?_, ?_⟩
  · obtain ⟨G', hG', hl'⟩ := hroute d hd
    refine ⟨_, hctx d (by omega) G' hG', ?_⟩
    rw [(replaceAt_succ_lastStep_F6 Z _ G').1, hl']
  · have := hctx c.path.length le_rfl G (by rw [List.take_length]; exact hG)
    rw [List.take_length] at this
    exact ⟨_, this, by rw [(replaceAt_succ_lastStep_F6 Z _ G).2, hl]⟩


-- T3.8la (txt:511-519): where a cap not above `A` and not at the end of `B` can sit
-- (moved here from after T3.8c, brief rule 5: its proof uses the G9 address lemmas
-- `colAt_context_onStack`, `colAt_context_of_not_route`, `onStack_of_container`, `isQMat_spec`,
-- `kerCol_qmat`; nothing in between uses it)
theorem cut_location (S : OrdStep) {c : ColAddr} {k ρ : Nat} (hup : IsUpward S.B c k ρ)
    (hKL : InL (litCap S.B c k ρ)) (hle : ¬ S.A < litCap S.B c k ρ)
    (hend : capPos S.B c k < mu S.B) :
    (c = S.sd.col ∧ S.m ≤ k) ∨
      (∃ i, 2 ≤ i ∧ i ≤ S.n ∧ phaseCol S.sd S.rd i S.rd.col = some c) ∨
      (∃ i a, 1 ≤ i ∧ i ≤ S.n ∧ IsTmplCol S.A S.sd S.rd a ∧ (isQMat S.sd a = true → 2 ≤ i) ∧
        phaseCol S.sd S.rd i a = some c) := by
  have hV := S.inL.1
  have hI := S.inL.2.1
  obtain ⟨hBeq, -⟩ := ker_expand_out hV hI S.kind S.hsd S.hrd S.out
  obtain ⟨hsdcol, hdep, -, -, hsdlast, hroutelen⟩ := stopData_spec S.hsd
  have hcB : c ∈ S.B.colAddrs := mem_colAddrs_of_upward hup
  obtain ⟨colB, hcolB, hkB, -⟩ := isUpward_iff_exists.1 hup
  obtain ⟨kh, hkh⟩ := kerCol_sdcol S
  rcases classify_cols S.inL S.kind S.hsd S.hrd S.out hcB with ⟨hctx, hne⟩ |
      ⟨i, a, hi1, hin, ha, hc, -⟩
  · -- a context column: its cap is a cap of `A`, or it is a full cut at the end of `B`
    exfalso
    obtain ⟨hRA, hHA⟩ := ker_stop_hole S.hsd
    have hnu : ¬ KerUnder S.sd.col c := by
      intro hu
      rw [← hHA] at hu
      obtain ⟨y, hy, -⟩ := ker_under_exhaust Tree.empty hRA hu hctx
      rw [Tree.mem_colAddrs_iff] at hy
      cases hp : y.path with
      | nil => simp [Tree.colAt, hp, Tree.forestAt, Tree.empty, Tree.cols] at hy
      | cons x rest =>
        obtain ⟨x1, x2⟩ := x
        simp [Tree.colAt, hp, Tree.forestAt, Tree.empty, Tree.cols] at hy
    have hcA : c ∈ S.A.colAddrs := by
      rw [Tree.mem_colAddrs_iff] at hctx ⊢
      rw [← ker_off_isSome Tree.empty _ _ hRA c (by rw [hHA]; exact hnu)]
      exact hctx
    obtain ⟨colA, hcolA⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff _ _).1 hcA)
    have hpar : parents S.B c = parents S.A c := by
      rw [hBeq]
      by_cases hs : S.sd.col.OnStack c
      · exact (colAt_context_onStack S.hsd _ hs).1
      · have h1 : c.container S.sd.col = none := by
          cases h : c.container S.sd.col with
          | none => rfl
          | some e => exact absurd (onStack_of_container h) hs
        have h2 : S.sd.col.container c = none := by
          cases h : S.sd.col.container c with
          | none => rfl
          | some e =>
            exfalso; apply hnu
            obtain ⟨he1, ⟨t, ht⟩⟩ := (ColAddr.container_spec _ _ e).mp h
            right
            refine ⟨S.sd.col.col, e.idx, t, ?_, le_rfl⟩
            rw [← ht]; unfold EntryAddr.heightPath; rw [he1]; simp
        unfold parents
        rw [colAt_context_of_not_route S.hsd _ hcA hne h2 h1]
    have hlen : colB.length = colA.length := by
      have := congrArg List.length hpar
      simpa [parents, hcolB, hcolA] using this
    rcases cut_in_A_F6 S hup hle hcolA (by omega) with ⟨h, -⟩ | ⟨hkl, hk0, hr⟩
    · exact hne h
    · have hcr : c ∈ routeCols S.A := List.mem_of_getElem? hr
      have hlt : c.path.length < S.sd.depth := by
        rcases Nat.lt_trichotomy (colDepth c) S.sd.depth with h | h | h
        · exact h
        · exfalso; apply hne
          rw [List.getLast?_eq_getElem?, hroutelen, Nat.add_sub_cancel, ← h, hr] at hsdlast
          exact Option.some.inj hsdlast
        · exfalso
          rw [List.getElem?_eq_none (by omega)] at hr; cases hr
      have hcrB : c ∈ routeCols S.B := by
        rw [hBeq]; exact routeCols_context_F6 S.hsd _ hcr hlt
      have hBne : colB ≠ [] := by
        intro h; rw [h] at hlen; simp at hlen; omega
      have := capPos_full_route_F6 hcrB hcolB hBne
      rw [hlen, ← hkl] at this
      omega
  · rcases ha with rfl | ha
    · by_cases hi2 : 2 ≤ i
      · exact Or.inr (Or.inl ⟨i, hi2, hin, hc⟩)
      · -- head 1 is the stopping column; a cut inside `Q` is a cap of `A`
        have hi : i = 1 := by omega
        subst hi
        rw [phaseCol_eq_iterate S hkh (kerCol_rdcol S), Option.some.injEq] at hc
        subst hc
        left
        refine ⟨rfl, ?_⟩
        by_contra hkm
        rcases cut_in_A_F6 S hup hle hsdcol (by simp [OrdStep.m] at hkm ⊢; omega) with
          ⟨-, h, -⟩ | ⟨h, -⟩
        · omega
        · simp [OrdStep.m] at h hkm; omega
    · by_cases hq : isQMat S.sd a = true ∧ i = 1
      · -- Q-material of head 1 is a column of `A` at the same address
        exfalso
        obtain ⟨hq, rfl⟩ := hq
        obtain ⟨j, rest, hp, hj⟩ := isQMat_spec S.sd hq
        have hcq : phaseCol S.sd S.rd 1 a = some a := by
          rw [phaseCol_eq_iterate S hkh (kerCol_qmat S hq hp)]
          obtain ⟨ap, ac⟩ := a
          simp only at hp
          subst hp
          simp [underCol]
        rw [hcq, Option.some.injEq] at hc
        subst hc
        have hroute : ¬ OnHoleRoute S.sd a := by
          intro h
          have := h.length_le
          rw [hp] at this; simp at this
        have hcolc := colAt_phaseCol S.inL S.kind S.hsd S.hrd S.out ⟨le_rfl, S.pos⟩ ha hroute hcq
        obtain ⟨colA, hcolA⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff _ _).1 ha.1)
        rw [hcolA, hcolB, Option.map_some, Option.some.injEq] at hcolc
        have hlen : colB.length = colA.length := by rw [hcolc, treeMapCol_eq_map, List.length_map]
        rcases cut_in_A_F6 S hup hle hcolA (by omega) with ⟨h, -⟩ | ⟨-, -, hr⟩
        · exact ha.2.1 h
        · rw [List.getElem?_eq_none (by rw [hroutelen, colDepth, hp, hdep]; simp)] at hr
          cases hr
      · exact Or.inr (Or.inr ⟨i, a, hi1, hin, ha, fun h => by
          by_contra h'; exact hq ⟨h, by omega⟩, hc⟩)

-- T3.8l (txt:511-643): the ordinary induction step
theorem KS_ordinary (S : OrdStep) : KS S.B := by
  intro c k ρ hup hKL
  have hBL : InL S.B := inL_expand S.inL S.out
  have hCC : CC S.A := cap_completion S.inL S.condP S.cof
  have hsdK := stopData_litCap hup
  have hAne : S.A ≠ Tree.empty := by
    intro h; have := S.hsd; rw [h, stopData_eq_none_of_lastCol (Or.inl rfl)] at this; cases this
  have hlastA : S.A.cols.getLast? ≠ some [] := by
    intro h; have := S.hsd; rw [stopData_eq_none_of_lastCol (Or.inr h)] at this; cases this
  have hKne : litCap S.B c k ρ ≠ Tree.empty := by
    intro h; rw [h, stopData_eq_none_of_lastCol (Or.inl rfl)] at hsdK; cases hsdK
  have hdef : ∀ rd, rootData (litCap S.B c k ρ) = some rd → KernelDefined (litCap S.B c k ρ) rd :=
    fun rd hrd => ker_kernelDefined hKL hsdK hrd
  have hcov : Success (litCap S.B c k ρ) (localSuffix S.B c) → Covers (litCap S.B c k ρ) S.B :=
    (covers_iff_success hBL.2.1 hup hKL.1 hKL.2.1 hdef).2
  -- the seam: some approximant of `K` is `A[n+1] > B` (T3.8ld, T3.8b)
  have hseam : ∀ i, 1 ≤ i → i ≤ S.n → phaseCol S.sd S.rd i S.rd.col = some c → k = S.m →
      ρ = S.s (i - 1) → Covers (litCap S.B c k ρ) S.B := by
    intro i hi1 hin hc hk hρ
    subst hk hρ
    have hs := expand_seam S ⟨hi1, hin⟩ hc (S.n - i + 2)
    rw [show i - 1 + (S.n - i + 2) = S.n + 1 by omega] at hs
    obtain ⟨A', hA'⟩ := Option.ne_none_iff_exists'.1 (inL_expand_ne_none S.inL (S.n + 1))
    exact ⟨_, A', hs.trans hA', expand_strictMono S.inL hlastA hAne (Nat.lt_succ_self _) S.out hA'⟩
  -- restored-suffix cuts (T3.8lg, L3.6, T3.8lh)
  have hrest : ∀ i, 1 ≤ i → i ≤ S.n → phaseCol S.sd S.rd i S.rd.col = some c → S.m < k →
      capPos S.B c k < mu S.B → Covers (litCap S.B c k ρ) S.B := by
    intro i hi1 hin hc hkm hend
    obtain ⟨hup', hV', hI', hA'⟩ := restored_oldCap S ⟨hi1, hin⟩ hc hkm hup hKL hend
    exact hcov (restored_cut S ⟨hi1, hin⟩ hc hkm hup hKL hend (hCC _ _ _ hup' hV' hI' hA'))
  -- 1. above the old target
  by_cases hAK : S.A < litCap S.B c k ρ
  · refine covers_of_gt S.cof hKL hKne ?_ hAK
      (le_of_lt (expand_lt hAne S.inL.1 S.inL.2.1 S.out)) ?_
    · intro h; rw [stopData_eq_none_of_lastCol (Or.inr h)] at hsdK; cases hsdK
    · intro K0 h0; exact expand_zero_litCap_lt hBL.2.1 hup hKL.1 hKL.2.1 h0
  -- a full cut at the end of `B` (L3.4f)
  have hπle : capPos S.B c k ≤ mu S.B := by
    obtain ⟨col, hcol, hk, -⟩ := isUpward_iff_exists.1 hup
    obtain ⟨-, -, -, -, h⟩ := litCap_word_data hcol hk
    exact h
  rcases Nat.lt_or_ge (capPos S.B c k) (mu S.B) with hend | hge
  swap
  · exact hcov (fullCut_success hup hKL (le_antisymm hπle hge))
  -- 2. the three cut locations (T3.8la)
  rcases cut_location S hup hKL hAK hend with ⟨rfl, hkm⟩ | ⟨i, hi2, hin, hc⟩ |
      ⟨i, a, hi1, hin, ha, hq, hc⟩
  · -- (a) head 1, the stopping column
    have hc1 : phaseCol S.sd S.rd 1 S.rd.col = some S.sd.col := by
      obtain ⟨kh, hkh⟩ := kerCol_sdcol S
      rw [phaseCol_eq_iterate S hkh (kerCol_rdcol S)]
      rfl
    rcases Nat.eq_or_lt_of_le hkm with hkm | hkm
    · subst hkm
      have hρ1 : S.s (1 - 1) ≤ ρ := seam_parent S ⟨le_rfl, S.pos⟩ hc1 hup hKL
      have hsdcol := (stopData_spec S.hsd).1
      have hρ2 : ρ ≤ S.sd.r := by
        rcases cut_in_A_F6 S hup hAK hsdcol (by simp [OrdStep.m]) with ⟨-, -, h⟩ | ⟨h, -⟩
        · exact h
        · simp [OrdStep.m] at h
      exact hseam 1 le_rfl S.pos hc1 rfl (by simp [OrdStep.s] at hρ1 ⊢; omega)
    · exact hrest 1 le_rfl S.pos hc1 hkm hend
  · -- (b) the head of a layer `i ≥ 2`
    rcases Nat.lt_trichotomy k S.m with hkm | hkm | hkm
    · exact headQuery_cut S ⟨hi2, hin⟩ hc (Or.inl hkm) hup hKL
    · subst hkm
      rcases Nat.lt_trichotomy ρ (S.s (i - 1)) with hρ | hρ | hρ
      · exact absurd (seam_parent S ⟨by omega, hin⟩ hc hup hKL) (by omega)
      · exact hseam i (by omega) hin hc rfl hρ
      · exact headQuery_cut S ⟨hi2, hin⟩ hc (Or.inr ⟨rfl, hρ⟩) hup hKL
    · exact hrest i (by omega) hin hc hkm hend
  · -- (c) phase material of a template column `a` (T3.8li, L3.6, T3.8lj–T3.8ls)
    have hproj := fun hρ => projection S ⟨hi1, hin⟩ ha hq hc hup hKL hend hρ
    rcases Nat.lt_or_ge (S.s (phaseOff S.sd i a)) ρ with hρ | hρ
    · obtain ⟨hup', hV', hI', hA'⟩ := hproj (Or.inr hρ.le)
      have hpr : S.proj (phaseOff S.sd i a) ρ = ρ - phaseOff S.sd i a * S.d := by
        simp [OrdStep.proj, hρ]
      rw [hpr] at hup' hV' hI' hA'
      exact hcov (root_current S ⟨hi1, hin⟩ ha hq hc hup hKL hend hρ (hCC _ _ _ hup' hV' hI' hA'))
    rcases Nat.eq_or_lt_of_le hρ with hρ | hρ
    · obtain ⟨hup', hV', hI', hA'⟩ := hproj (Or.inr hρ.ge)
      have hpr : S.proj (phaseOff S.sd i a) ρ = S.sd.r := by
        simp [OrdStep.proj, hρ]
      rw [hpr] at hup' hV' hI' hA'
      exact hcov (root_head S ⟨hi1, hin⟩ ha hq hc hup hKL hend hρ (hCC _ _ _ hup' hV' hI' hA'))
    rcases Nat.lt_or_ge S.sd.r ρ with hρr | hρr
    · exact hcov (root_prev S ⟨hi1, hin⟩ ha hq hc hup hKL hend hρr hρ)
    · obtain ⟨hup', hV', hI', hA'⟩ := hproj (Or.inl hρr)
      have hpr : S.proj (phaseOff S.sd i a) ρ = ρ := by
        unfold OrdStep.proj
        rw [if_neg (by omega)]
        split_ifs with h
        · simp [OrdStep.s] at h; omega
        · rfl
      rw [hpr] at hup' hV' hI' hA'
      have hold := hCC _ _ _ hup' hV' hI' hA'
      by_cases hroute : OnHoleRoute S.sd a
      · exact hcov (direct_body S ⟨hi1, hin⟩ ha hc hroute hup hKL hend hρr hold)
      · exact hcov (closed_side S ⟨hi1, hin⟩ ha hq hc hroute hup hKL hend hρr hold)

theorem KS_empty_E5 : KS Tree.empty := by
  intro c k p hup
  exfalso
  obtain ⟨P, j⟩ := c
  unfold IsUpward at hup
  cases P with
  | nil => simp [Tree.colAt, Tree.forestAt, Tree.empty, Tree.cols] at hup
  | cons x P => obtain ⟨a, b⟩ := x; simp [Tree.colAt, Tree.forestAt, Tree.empty, Tree.cols] at hup

-- T3.8m (txt:504): kernel success for every standard target, by induction on generation
theorem KS_std {B : Forest} (hB : IsStd B) : KS B := by
  induction hB with
  | seed m => exact KS_seed m
  | @expand A B' n hA hexp ih =>
    have hL := std_inL hA
    have hcof := cof_of_KS hL ih
    by_cases hA0 : A = Tree.empty
    · subst hA0
      rw [expand_empty] at hexp
      cases hexp
      exact KS_empty_E5
    obtain ⟨knd, hknd⟩ := Option.isSome_iff_exists.1 (stepKind_isSome hA0 hL.1 hL.2.1)
    cases knd with
    | deletion =>
      obtain ⟨j, -, rfl⟩ := expand_safePrefix hA0 hL.1 hL.2.1 (Or.inl hknd) hexp
      exact KS_safePrefix hL hcof j
    | special => exact KS_special hL hcof hknd hexp
    | ordinary =>
      rcases Nat.eq_zero_or_pos n with rfl | hn
      · obtain ⟨j, -, rfl⟩ := expand_safePrefix hA0 hL.1 hL.2.1 (Or.inr ⟨hknd, rfl⟩) hexp
        exact KS_safePrefix hL hcof j
      · obtain ⟨sd, hsd⟩ := Option.isSome_iff_exists.1 (stopData_of_stepKind hknd (by decide))
        obtain ⟨rd, hrd⟩ := Option.isSome_iff_exists.1 (rootData_of_ordinary hknd)
        exact KS_ordinary ⟨A, sd, rd, n, B', hA, hL, std_condP hA, hcof, hknd, hsd, hrd, hn, hexp⟩

-- provides: U2, T3.8 (cofinality; moved from `Spine.lean`, brief rule 5)
theorem cofinal {B E : Forest} (hB : IsStd B) (hE : Scan.InL E) (hlt : B < E) :
    ∃ n E', expand E n = some E' ∧ B ≤ E' ∧ E' < E :=
  cof_of_KS (std_inL hB) (KS_std hB) E hE hlt

-- provides: U2, T3.8 (the explicit bound when `E` ends in a nonempty outer column)
theorem cofinal_bound {B E : Forest} (hB : IsStd B) (hE : Scan.InL E) (hlt : B < E)
    (hlast : E.cols.getLast? ≠ some []) :
    ∃ n E', 1 ≤ n ∧ n ≤ Scan.mu B + 1 ∧ expand E n = some E' ∧ B < E' :=
  bound_of_KS (std_inL hB) (KS_std hB) hE hlt hlast

