theorem applyMove_eq_body (E : Forest) (m : Move) : applyMove E m = applyMoveBody E m := rfl

theorem moveAddr_eq_body (ms : List Move) (b : EntryAddr) : moveAddr ms b = moveAddrBody ms b :=
  rfl

theorem movesValid_eq_body (K : Forest) (ms : List Move) : MovesValid K ms = MovesValidBody K ms :=
  rfl

theorem repairList_eq_body (K : Forest) (b : EntryAddr) (ms : List Move) :
    RepairList K b ms = RepairListBody K b ms := rfl

theorem origin_eq_body {E : Forest} (w : AdmCap E) : w.origin = originBody w := rfl

/-! ### D3.1a helpers (stop data, index maps, roles of moves and literal caps) -/

/-- helper: stop data read below a prefix path. -/
def sdPrepend (π : List (Nat × Nat)) (sd : StopData) : StopData :=
  { depth := π.length + sd.depth, col := ⟨π ++ sd.col.path, sd.col.col⟩,
    t := (π.map (·.1 + 1)).sum + sd.t, r := sd.r, Q := sd.Q }

theorem sdPrepend_append (π π' : List (Nat × Nat)) (sd : StopData) :
    sdPrepend π (sdPrepend π' sd) = sdPrepend (π ++ π') sd := by
  simp only [sdPrepend, List.length_append, List.append_assoc, List.map_append, List.sum_append]
  congr 1 <;> omega

mutual
theorem stopF_prepend : ∀ (π : List (Nat × Nat)) (F : Forest),
    stopF π F = (stopF [] F).map (sdPrepend π)
  | π, .node cols => by simp only [stopF]; exact stopCols_prepend π 0 cols
theorem stopCols_prepend : ∀ (π : List (Nat × Nat)) (ci : Nat) (cols : List Column),
    stopCols π ci cols = (stopCols [] ci cols).map (sdPrepend π)
  | _, _, [] => by simp [stopCols]
  | π, ci, [col] => by simp only [stopCols]; exact stopCol_prepend π ci 0 [] col
  | π, ci, _ :: _ :: rest => by simp only [stopCols]; exact stopCols_prepend π (ci + 1) (_ :: rest)
theorem stopCol_prepend : ∀ (π : List (Nat × Nat)) (ci ei : Nat) (Q : Column) (col : Column),
    stopCol π ci ei Q col = (stopCol [] ci ei Q col).map (sdPrepend π)
  | _, _, _, _, [] => by simp [stopCol]
  | π, ci, ei, Q, [(p, .node [])] => by
    simp only [stopCol, Option.map_some, sdPrepend, ColAddr.num, List.append_nil, List.length_nil,
      List.map_nil, List.sum_nil]
    simp only [StopData.mk.injEq, Nat.add_zero, Nat.zero_add, true_and, and_true]
  | π, ci, ei, Q, [(_, .node (g :: gs))] => by
    simp only [stopCol]
    rw [stopCols_prepend (π ++ [(ci, ei)]) 0 (g :: gs), stopCols_prepend ([] ++ [(ci, ei)]) 0 (g :: gs),
      Option.map_map]
    congr 1
    funext sd
    simp only [Function.comp, sdPrepend_append, List.nil_append]
  | π, ci, ei, Q, x :: y :: rest => by
    simp only [stopCol]; exact stopCol_prepend π ci (ei + 1) (Q ++ [x]) (y :: rest)
end

theorem stopCols_snoc (π : List (Nat × Nat)) (col : Column) :
    ∀ (ci : Nat) (pre : List Column),
      stopCols π ci (pre ++ [col]) = stopCol π (ci + pre.length) 0 [] col
  | ci, [] => by simp [stopCols]
  | ci, [a] => by simp [stopCols]
  | ci, a :: b :: pre => by
    rw [List.cons_append, List.cons_append, stopCols, ← List.cons_append,
      stopCols_snoc π col (ci + 1) (b :: pre)]
    simp only [List.length_cons]; congr 1; omega

theorem stopCol_snoc (π : List (Nat × Nat)) (ci : Nat) (x : Nat × Forest) :
    ∀ (ei : Nat) (Q0 pre : Column),
      stopCol π ci ei Q0 (pre ++ [x]) = stopCol π ci (ei + pre.length) (Q0 ++ pre) [x]
  | ei, Q0, [] => by simp
  | ei, Q0, a :: pre => by
    rw [List.cons_append]
    cases pre with
    | nil => simp [stopCol]
    | cons b pre =>
      simp only [List.cons_append]
      rw [stopCol, ← List.cons_append, stopCol_snoc π ci x (ei + 1) (Q0 ++ [a]) (b :: pre)]
      simp only [List.length_cons, List.append_assoc, List.singleton_append]
      congr 1; omega

/-- helper: `stopF` at a forest whose last column ends in `(q, h)`. -/
theorem stopF_snoc (π : List (Nat × Nat)) (pre : List Column) (Q : Column) (q : Nat) (h : Forest) :
    stopF π (.node (pre ++ [Q ++ [(q, h)]])) =
      if h = Tree.empty then
        some { depth := π.length, col := ⟨π, pre.length⟩, t := ColAddr.num 0 ⟨π, pre.length⟩,
               r := q, Q := Q }
      else stopF (π ++ [(pre.length, Q.length)]) h := by
  rw [stopF, stopCols_snoc, stopCol_snoc]
  simp only [Nat.zero_add, List.nil_append]
  obtain ⟨gs⟩ := h
  cases gs with
  | nil => simp [stopCol, Tree.empty]
  | cons g gs => simp [stopCol, Tree.empty, stopF]

/-- helper: decomposition of a successful `stopF` at its first level. -/
theorem stopF_some_iff {F : Forest} {sd : StopData} :
    stopF [] F = some sd ↔ ∃ pre Q q h, F = .node (pre ++ [Q ++ [(q, h)]]) ∧
      ((h = Tree.empty ∧ sd = { depth := 0, col := ⟨[], pre.length⟩, t := pre.length, r := q, Q := Q }) ∨
       (h ≠ Tree.empty ∧ ∃ sd', stopF [] h = some sd' ∧ sd = sdPrepend [(pre.length, Q.length)] sd')) := by
  constructor
  · intro hs
    obtain ⟨cols⟩ := F
    rcases List.eq_nil_or_concat' cols with rfl | ⟨pre, col, rfl⟩
    · simp [stopF, stopCols] at hs
    rcases List.eq_nil_or_concat' col with rfl | ⟨Q, ⟨q, h⟩, rfl⟩
    · rw [stopF, stopCols_snoc] at hs; simp [stopCol] at hs
    refine ⟨pre, Q, q, h, rfl, ?_⟩
    rw [stopF_snoc] at hs
    by_cases hh : h = Tree.empty
    · simp only [hh, if_true, Option.some.injEq] at hs
      left; refine ⟨hh, ?_⟩; rw [← hs]; simp [ColAddr.num]
    · simp only [hh, if_false] at hs
      right; refine ⟨hh, ?_⟩
      rw [stopF_prepend] at hs
      cases h' : stopF [] h with
      | none => rw [h'] at hs; simp at hs
      | some sd' => rw [h'] at hs; simp only [Option.map_some, Option.some.injEq] at hs; exact ⟨sd', rfl, hs.symm⟩
  · rintro ⟨pre, Q, q, h, rfl, (⟨hh, rfl⟩ | ⟨hh, sd', hs, rfl⟩)⟩
    · rw [stopF_snoc, if_pos hh]; simp [ColAddr.num]
    · rw [stopF_snoc, if_neg hh, stopF_prepend, hs]; rfl

theorem list_modify_snoc {α : Type} (pre : List α) (x : α) (g : α → α) :
    (pre ++ [x]).modify pre.length g = pre ++ [g x] := by
  induction pre with
  | nil => rfl
  | cons a pre ih => simp only [List.cons_append, List.length_cons, List.modify_succ_cons, ih]

theorem stopF_ne_empty {F : Forest} {sd : StopData} (h : stopF [] F = some sd) : F ≠ Tree.empty := by
  rintro rfl; simp [stopF, stopCols, Tree.empty] at h

/-- helper: the forest at a path through the first level. -/
theorem forestAt_node_cons (cols : List Column) (a b : Nat) (rest : List (Nat × Nat)) :
    (Tree.node cols).forestAt ((a, b) :: rest) =
      ((cols[a]?).bind (·[b]?)).bind fun x => x.2.forestAt rest := by
  simp only [Tree.forestAt, Tree.cols]
  cases (cols[a]?).bind (·[b]?) with
  | none => rfl
  | some x => obtain ⟨_, _⟩ := x; rfl

theorem colAt_node_cons (cols : List Column) (a b : Nat) (rest : List (Nat × Nat)) (j : Nat) :
    (Tree.node cols).colAt ⟨(a, b) :: rest, j⟩ =
      ((cols[a]?).bind (·[b]?)).bind fun x => x.2.colAt ⟨rest, j⟩ := by
  simp only [Tree.colAt, forestAt_node_cons]
  cases (cols[a]?).bind (·[b]?) with
  | none => rfl
  | some x => rfl

theorem colAt_node_nil (cols : List Column) (j : Nat) : (Tree.node cols).colAt ⟨[], j⟩ = cols[j]? := rfl

/-- helper: stop data of a literal cap at a valid address (cf. T3.8c `stopData_litCap`). -/
theorem stopF_litCapAux (k p : Nat) : ∀ (ρ : List (Nat × Nat)) (j : Nat) (F : Forest) (col : Column),
    F.colAt ⟨ρ, j⟩ = some col →
    stopF [] (litCapAux k p ρ j F) =
      some { depth := ρ.length, col := ⟨ρ, j⟩, t := ColAddr.num 0 ⟨ρ, j⟩, r := p, Q := col.take k }
  | [], j, .node cols, col, h => by
    rw [colAt_node_nil] at h
    have hj : j < cols.length := (List.getElem?_eq_some_iff.1 h).1
    simp only [litCapAux, List.getD_eq_getElem?_getD, h, Option.getD_some]
    rw [stopF_snoc, if_pos rfl, List.length_take_of_le (by omega)]
  | (ci, ei) :: ρ, j, .node cols, col, h => by
    rw [colAt_node_cons] at h
    cases he : (cols[ci]?).bind (·[ei]?) with
    | none => rw [he] at h; simp at h
    | some x =>
      obtain ⟨q, H⟩ := x
      rw [he] at h
      simp only [Option.bind_some] at h
      have ih := stopF_litCapAux k p ρ j H col h
      obtain ⟨colc, hc, hx⟩ := Option.bind_eq_some_iff.1 he
      have hci : ci < cols.length := (List.getElem?_eq_some_iff.1 hc).1
      have hei : ei < colc.length := (List.getElem?_eq_some_iff.1 hx).1
      simp only [litCapAux, List.getD_eq_getElem?_getD, hc, Option.getD_some, hx]
      rw [stopF_snoc, if_neg (stopF_ne_empty ih), stopF_prepend, ih, List.length_take_of_le (by omega),
        List.length_take_of_le (by omega)]
      simp only [Option.map_some, sdPrepend, ColAddr.num, Option.some.injEq, StopData.mk.injEq]
      simp
      omega

theorem litCap_eq_aux {E : Forest} {c : ColAddr} {col : Column} (h : E.colAt c = some col) (k p : Nat) :
    litCap E c k p = litCapAux k p c.path c.col E := by
  simp [litCap, litCapBody, h]

/-- helper (cf. T3.8c `stopData_litCap`): stop data of a literal cap. -/
theorem stopData_litCap' {E : Forest} {c : ColAddr} {col : Column} (h : E.colAt c = some col)
    (k p : Nat) :
    stopData (litCap E c k p) =
      some { depth := c.path.length, col := c, t := c.num 0, r := p, Q := col.take k } := by
  rw [litCap_eq_aux h]
  exact stopF_litCapAux k p c.path c.col E col h

/-- helper: `stopF` after deleting entries `i … e-1` of a column on the route. -/
theorem stopF_modifyColAux (c e i : Nat) (rest : List (Nat × Nat)) (hi : i ≤ e) :
    ∀ (P : List (Nat × Nat)) (F : Forest) (sd : StopData), stopF [] F = some sd →
      sd.col.path = P ++ (c, e) :: rest →
      stopF [] (modifyColAux (fun col => col.take i ++ col.drop e) P c F) =
        some { sd with col := ⟨P ++ (c, i) :: rest, sd.col.col⟩ }
  | [], F, sd, hs, hp => by
    obtain ⟨pre, Q, q, h, rfl, (⟨hh, rfl⟩ | ⟨hh, sd', hs', rfl⟩)⟩ := stopF_some_iff.1 hs
    · simp at hp
    · simp only [sdPrepend, List.singleton_append, List.nil_append, List.cons.injEq,
        Prod.mk.injEq] at hp
      obtain ⟨⟨rfl, rfl⟩, rfl⟩ := hp
      simp only [modifyColAux, list_modify_snoc]
      have hf : (Q ++ [(q, h)]).take i ++ (Q ++ [(q, h)]).drop Q.length = Q.take i ++ [(q, h)] := by
        rw [List.take_append_of_le_length hi, List.drop_left]
      rw [hf]
      refine stopF_some_iff.2 ⟨pre, Q.take i, q, h, rfl, Or.inr ⟨hh, sd', hs', ?_⟩⟩
      rw [List.length_take_of_le hi]
      simp [sdPrepend]
  | (a, b) :: P, F, sd, hs, hp => by
    obtain ⟨pre, Q, q, h, rfl, (⟨hh, rfl⟩ | ⟨hh, sd', hs', rfl⟩)⟩ := stopF_some_iff.1 hs
    · simp at hp
    · simp only [sdPrepend, List.singleton_append, List.cons_append, List.cons.injEq,
        Prod.mk.injEq] at hp
      obtain ⟨⟨rfl, rfl⟩, hp⟩ := hp
      have ih := stopF_modifyColAux c e i rest hi P h sd' hs' hp
      simp only [modifyColAux, list_modify_snoc]
      refine stopF_some_iff.2 ⟨pre, Q, q, _, rfl, Or.inr ⟨stopF_ne_empty ih, _, ih, ?_⟩⟩
      simp [sdPrepend]

/-! ### helpers: index maps of moves -/

theorem fwdIdx_bwdIdx (m : Move) (e : Nat) : m.fwdIdx (m.bwdIdx e) = e := by
  unfold Move.fwdIdx Move.bwdIdx; split_ifs <;> omega

theorem mapPath_through (g : Nat → Nat) (m : Move) (e : Nat) (D : List (Nat × Nat)) :
    m.mapPath g (m.col.path ++ (m.col.col, e) :: D) = m.col.path ++ (m.col.col, g e) :: D := by
  simp [Move.mapPath]

theorem mapPath_off (g : Nat → Nat) (m : Move) (π : List (Nat × Nat))
    (h : ∀ e D, π ≠ m.col.path ++ (m.col.col, e) :: D) : m.mapPath g π = π := by
  unfold Move.mapPath
  split_ifs with h1
  · split
    · next c e he =>
      split_ifs with h3
      · exfalso
        have hl : m.col.path.length < π.length := (List.getElem?_eq_some_iff.1 he).1
        apply h e (π.drop (m.col.path.length + 1))
        conv_lhs => rw [← List.take_append_drop m.col.path.length π]
        rw [h1, List.drop_eq_getElem_cons hl]
        have := (List.getElem?_eq_some_iff.1 he).2
        rw [this, h3]
      · rfl
    · rfl
  · rfl

theorem mapPath_cases (m : Move) (π : List (Nat × Nat)) :
    (∃ e D, π = m.col.path ++ (m.col.col, e) :: D) ∨ ∀ e D, π ≠ m.col.path ++ (m.col.col, e) :: D := by
  by_cases h : ∃ e D, π = m.col.path ++ (m.col.col, e) :: D
  · exact Or.inl h
  · exact Or.inr fun e D he => h ⟨e, D, he⟩

theorem mapPath_comp (g g' : Nat → Nat) (m : Move) (π : List (Nat × Nat)) :
    m.mapPath g' (m.mapPath g π) = m.mapPath (g' ∘ g) π := by
  rcases mapPath_cases m π with ⟨e, D, rfl⟩ | h
  · simp only [mapPath_through, Function.comp]
  · rw [mapPath_off g m π h, mapPath_off g' m π h, mapPath_off _ m π h]

theorem mapPath_id (m : Move) (π : List (Nat × Nat)) : m.mapPath id π = π := by
  rcases mapPath_cases m π with ⟨e, D, rfl⟩ | h
  · simp only [mapPath_through, id]
  · exact mapPath_off id m π h

theorem mapPath_eq_colPath_iff (g : Nat → Nat) (m : Move) (π : List (Nat × Nat)) :
    m.mapPath g π = m.col.path ↔ π = m.col.path := by
  rcases mapPath_cases m π with ⟨e, D, rfl⟩ | h
  · rw [mapPath_through]
    constructor <;> intro h' <;> exact absurd (congrArg List.length h') (by simp)
  · rw [mapPath_off g m π h]

theorem colAddr_mapPath_eq_iff (g : Nat → Nat) (m : Move) (π : List (Nat × Nat)) (cc : Nat) :
    ((⟨m.mapPath g π, cc⟩ : ColAddr) = m.col) ↔ ((⟨π, cc⟩ : ColAddr) = m.col) := by
  have h := mapPath_eq_colPath_iff g m π
  obtain ⟨⟨P, c⟩, i, j⟩ := m
  simp only [ColAddr.mk.injEq] at h ⊢
  rw [h]

theorem mapEntry_col (g : Nat → Nat) (m : Move) (b : EntryAddr) :
    (m.mapEntry g b).col = ⟨m.mapPath g b.col.path, b.col.col⟩ := by
  unfold Move.mapEntry; dsimp only; split_ifs <;> rfl

theorem mapEntry_comp (g g' : Nat → Nat) (m : Move) (b : EntryAddr) :
    m.mapEntry g' (m.mapEntry g b) = m.mapEntry (g' ∘ g) b := by
  have hc := mapEntry_col g m b
  have h1 := colAddr_mapPath_eq_iff g m b.col.path b.col.col
  have h2 := colAddr_mapPath_eq_iff g' m (m.mapPath g b.col.path) b.col.col
  have h3 := colAddr_mapPath_eq_iff (g' ∘ g) m b.col.path b.col.col
  unfold Move.mapEntry at hc ⊢
  dsimp only at hc ⊢
  rw [hc]
  dsimp only
  rw [mapPath_comp]
  rw [mapPath_comp] at h2
  by_cases h : (⟨b.col.path, b.col.col⟩ : ColAddr) = m.col
  · rw [if_pos (h1.2 h), if_pos (h3.2 h), if_pos (h3.2 h)]; rfl
  · rw [if_neg (fun h' => h (h1.1 h')), if_neg (fun h' => h (h3.1 h')),
      if_neg (fun h' => h (h3.1 h'))]

theorem mapEntry_id (m : Move) (b : EntryAddr) : m.mapEntry id b = b := by
  unfold Move.mapEntry; dsimp only
  rw [mapPath_id]
  split_ifs <;> rfl

theorem mapRole_fwd_bwd (m : Move) (x : Role) : m.mapRole m.fwdIdx (m.mapRole m.bwdIdx x) = x := by
  have hid : m.fwdIdx ∘ m.bwdIdx = id := funext (fwdIdx_bwdIdx m)
  cases x with
  | ord c => simp only [Move.mapRole, mapPath_comp, hid, mapPath_id]
  | slot e => simp only [Move.mapRole, mapEntry_comp, hid, mapEntry_id]

theorem mapRole_bwd_injective (m : Move) : Function.Injective (m.mapRole m.bwdIdx) := fun x y h => by
  rw [← mapRole_fwd_bwd m x, h, mapRole_fwd_bwd]

/-- helper: undo a list of moves, last first (the role part of `originBody`). -/
def backRole (ms : List Move) (x : Role) : Role := ms.foldr (fun m y => m.mapRole m.bwdIdx y) x

theorem backRole_injective (ms : List Move) : Function.Injective (backRole ms) := by
  induction ms with
  | nil => exact fun x y h => h
  | cons m ms ih => exact fun x y h => ih (mapRole_bwd_injective m h)

theorem backRole_append (ms : List Move) (m : Move) (x : Role) :
    backRole (ms ++ [m]) x = backRole ms (m.mapRole m.bwdIdx x) := by
  simp [backRole, List.foldr_append]

theorem originBody_eq {E : Forest} (w : AdmCap E) (x : Role) :
    w.origin x = if backRole w.moves x = .slot ⟨w.col, w.cut⟩ then none else some (backRole w.moves x) :=
  rfl

/-! ### helpers: forests after `modifyColAux` -/

theorem forestAt_nil_path (F : Forest) : F.forestAt [] = some F := by cases F; rfl

theorem list_getElem?_modify_self {α : Type} (l : List α) (i : Nat) (f : α → α) :
    (l.modify i f)[i]? = l[i]?.map f := by
  rw [List.getElem?_modify]; cases l[i]? <;> simp

theorem list_getElem?_modify_ne {α : Type} (l : List α) {i j : Nat} (f : α → α) (h : i ≠ j) :
    (l.modify i f)[j]? = l[j]? := by
  rw [List.getElem?_modify]; cases l[j]? <;> simp [h]

theorem forestAt_modifyColAux_prefix (f : Column → Column) (c : Nat) :
    ∀ (P π : List (Nat × Nat)) (F : Forest), π <+: P →
      (modifyColAux f P c F).forestAt π = (F.forestAt π).map (modifyColAux f (P.drop π.length) c)
  | P, [], F, _ => by simp [forestAt_nil_path]
  | [], _ :: _, _, h => absurd (List.eq_nil_of_prefix_nil h) (List.cons_ne_nil _ _)
  | (a, b) :: P, (a', b') :: π, .node cols, h => by
    obtain ⟨hab, hp⟩ := List.cons_prefix_cons.1 h
    obtain ⟨rfl, rfl⟩ := Prod.mk.inj hab
    simp only [modifyColAux, forestAt_node_cons]
    rw [list_getElem?_modify_self]
    cases hc : cols[a']? with
    | none => rfl
    | some colc =>
      simp only [Option.map_some, Option.bind_some]
      rw [list_getElem?_modify_self]
      cases hx : colc[b']? with
      | none => rfl
      | some x =>
        simp only [Option.map_some, Option.bind_some, List.length_cons, List.drop_succ_cons]
        exact forestAt_modifyColAux_prefix f c P π x.2 hp

theorem forestAt_through_col (c b : Nat) (rest : List (Nat × Nat)) :
    ∀ (P : List (Nat × Nat)) (F : Forest),
      F.forestAt (P ++ (c, b) :: rest) = ((F.colAt ⟨P, c⟩).bind (·[b]?)).bind fun x => x.2.forestAt rest
  | [], .node cols => by simp only [List.nil_append, forestAt_node_cons, colAt_node_nil]
  | (a, b0) :: P, .node cols => by
    rw [List.cons_append, forestAt_node_cons, colAt_node_cons]
    cases (cols[a]?).bind (·[b0]?) with
    | none => rfl
    | some x => exact forestAt_through_col c b rest P x.2

theorem forestAt_modifyColAux_through (f : Column → Column) (c b : Nat) (rest : List (Nat × Nat)) :
    ∀ (P : List (Nat × Nat)) (F : Forest),
      (modifyColAux f P c F).forestAt (P ++ (c, b) :: rest) =
        ((F.colAt ⟨P, c⟩).bind fun col => (f col)[b]?).bind fun x => x.2.forestAt rest
  | [], .node cols => by
    simp only [modifyColAux, List.nil_append, forestAt_node_cons, colAt_node_nil]
    rw [list_getElem?_modify_self]
    cases cols[c]? <;> rfl
  | (a, b0) :: P, .node cols => by
    simp only [modifyColAux, List.cons_append, forestAt_node_cons, colAt_node_cons]
    rw [list_getElem?_modify_self]
    cases hc : cols[a]? with
    | none => rfl
    | some colc =>
      simp only [Option.map_some, Option.bind_some]
      rw [list_getElem?_modify_self]
      cases hx : colc[b0]? with
      | none => rfl
      | some x =>
        simp only [Option.map_some, Option.bind_some]
        exact forestAt_modifyColAux_through f c b rest P x.2

theorem forestAt_modifyColAux_off (f : Column → Column) (c : Nat) :
    ∀ (P π : List (Nat × Nat)) (F : Forest), ¬ π <+: P → (∀ b rest, π ≠ P ++ (c, b) :: rest) →
      (modifyColAux f P c F).forestAt π = F.forestAt π
  | _, [], _, h, _ => absurd (List.nil_prefix) h
  | [], (a, b) :: π, .node cols, _, h' => by
    have hac : a ≠ c := fun hac => h' b π (by rw [hac]; rfl)
    simp only [modifyColAux, forestAt_node_cons]
    rw [list_getElem?_modify_ne _ _ (Ne.symm hac)]
  | (a0, b0) :: P, (a, b) :: π, .node cols, h, h' => by
    simp only [modifyColAux, forestAt_node_cons]
    by_cases ha : a0 = a
    · subst ha
      rw [list_getElem?_modify_self]
      cases hc : cols[a0]? with
      | none => rfl
      | some colc =>
        simp only [Option.map_some, Option.bind_some]
        by_cases hb : b0 = b
        · subst hb
          rw [list_getElem?_modify_self]
          cases colc[b0]? with
          | none => rfl
          | some x =>
            simp only [Option.map_some, Option.bind_some]
            exact forestAt_modifyColAux_off f c P π x.2 (fun hp => h (List.cons_prefix_cons.2 ⟨rfl, hp⟩))
              (fun b rest he => h' b rest (by rw [he]; rfl))
        · rw [list_getElem?_modify_ne _ _ hb]
    · rw [list_getElem?_modify_ne _ _ ha]

theorem cols_length_modifyColAux (f : Column → Column) (c : Nat) :
    ∀ (P : List (Nat × Nat)) (F : Forest), (modifyColAux f P c F).cols.length = F.cols.length
  | [], .node cols => by simp [modifyColAux, Tree.cols]
  | (_, _) :: _, .node cols => by simp [modifyColAux, Tree.cols]

theorem colLen_modifyColAux (f : Column → Column) (c c' : Nat) (P : List (Nat × Nat)) (F : Forest)
    (h : P ≠ [] ∨ c' ≠ c) :
    ((modifyColAux f P c F).cols[c']?).map List.length = (F.cols[c']?).map List.length := by
  obtain ⟨cols⟩ := F
  cases P with
  | nil =>
    simp only [modifyColAux, Tree.cols]
    rw [list_getElem?_modify_ne _ _ (Ne.symm (h.resolve_left (by simp)))]
  | cons ab P =>
    obtain ⟨a, b⟩ := ab
    simp only [modifyColAux, Tree.cols]
    by_cases ha : a = c'
    · subst ha; rw [list_getElem?_modify_self]; cases cols[a]? <;> simp
    · rw [list_getElem?_modify_ne _ _ ha]

/-- helper: the deleted-block column map `col ↦ col.take i ++ col.drop j` reads index `b` of the
result at `bwdIdx b`. -/
theorem getElem?_moveFun (m : Move) (col : Column) (hij : m.i ≤ m.j) (hj : m.j ≤ col.length) (b : Nat) :
    (col.take m.i ++ col.drop m.j)[b]? = col[m.bwdIdx b]? := by
  unfold Move.bwdIdx
  have hl : (col.take m.i).length = m.i := List.length_take_of_le (by omega)
  split_ifs with hb
  · rw [List.getElem?_append_right (by omega), hl, List.getElem?_drop]
    congr 1; omega
  · rw [List.getElem?_append_left (by omega), List.getElem?_take_of_lt (by omega)]

/-! ### helpers: a valid move -/

/-- helper: the column map of a move. -/
def moveFun (m : Move) (col : Column) : Column := col.take m.i ++ col.drop m.j

theorem applyMove_eq_mod {K : Forest} {m : Move} {col : Column} (hcol : K.colAt m.col = some col)
    (hij : m.i < m.j) (hj : m.j < col.length) :
    applyMove K m = modifyColAux (moveFun m) m.col.path m.col.col K := by
  simp only [applyMove, applyMoveBody, hcol, if_pos (And.intro hij hj)]; rfl

theorem colAt_mod_self (f : Column → Column) (K : Forest) (c : ColAddr) :
    (modifyColAux f c.path c.col K).colAt c = (K.colAt c).map f := by
  simp only [Tree.colAt]
  rw [forestAt_modifyColAux_prefix f c.col c.path c.path K (List.prefix_refl _), List.drop_length]
  cases K.forestAt c.path with
  | none => rfl
  | some G =>
    obtain ⟨cols⟩ := G
    simp only [Option.map_some, Option.bind_some, modifyColAux, Tree.cols]
    exact list_getElem?_modify_self _ _ _

theorem forestAt_mod_bwd {K : Forest} {m : Move} {col : Column} (hcol : K.colAt m.col = some col)
    (hij : m.i < m.j) (hj : m.j < col.length) :
    ∀ π G', (modifyColAux (moveFun m) m.col.path m.col.col K).forestAt π = some G' →
      ∃ G, K.forestAt (m.mapPath m.bwdIdx π) = some G ∧ G'.cols.length = G.cols.length ∧
        ∀ c', ¬ (π = m.col.path ∧ c' = m.col.col) →
          (G'.cols[c']?).map List.length = (G.cols[c']?).map List.length := by
  intro π G' hG'
  by_cases h1 : π <+: m.col.path
  · rw [forestAt_modifyColAux_prefix _ _ _ _ _ h1] at hG'
    obtain ⟨G, hG, rfl⟩ := Option.map_eq_some_iff.1 hG'
    have hoff : ∀ e D, π ≠ m.col.path ++ (m.col.col, e) :: D := by
      intro e D he; have := h1.length_le; rw [he] at this; simp at this
    refine ⟨G, by rw [mapPath_off _ _ _ hoff]; exact hG, cols_length_modifyColAux _ _ _ _, ?_⟩
    intro c' hc'
    apply colLen_modifyColAux
    by_cases hπ : π = m.col.path
    · exact Or.inr fun h => hc' ⟨hπ, h⟩
    · left
      intro hd
      apply hπ
      have := List.prefix_iff_eq_take.1 h1
      have hl : m.col.path.length ≤ π.length := by
        have := congrArg List.length hd; simp at this; omega
      rw [this, List.take_of_length_le (by have := h1.length_le; omega)]
  by_cases h2 : ∃ e D, π = m.col.path ++ (m.col.col, e) :: D
  · obtain ⟨e, D, rfl⟩ := h2
    rw [forestAt_modifyColAux_through, show (⟨m.col.path, m.col.col⟩ : ColAddr) = m.col from rfl,
      hcol] at hG'
    simp only [Option.bind_some, moveFun] at hG'
    rw [getElem?_moveFun m col hij.le hj.le] at hG'
    refine ⟨G', ?_, rfl, fun _ _ => rfl⟩
    rw [mapPath_through, forestAt_through_col, show (⟨m.col.path, m.col.col⟩ : ColAddr) = m.col from rfl,
      hcol]
    exact hG'
  · have hoff : ∀ e D, π ≠ m.col.path ++ (m.col.col, e) :: D := fun e D he => h2 ⟨e, D, he⟩
    rw [forestAt_modifyColAux_off _ _ _ _ _ h1 hoff] at hG'
    exact ⟨G', by rw [mapPath_off _ _ _ hoff]; exact hG', rfl, fun _ _ => rfl⟩

/-- helper: every role of the moved tree undoes to a role of the original tree. -/
theorem roles_applyMove_bwd {K : Forest} {m : Move} {col : Column} (hcol : K.colAt m.col = some col)
    (hij : m.i < m.j) (hj : m.j < col.length) :
    ∀ x ∈ (applyMove K m).roles, m.mapRole m.bwdIdx x ∈ K.roles := by
  rw [applyMove_eq_mod hcol hij hj]
  intro x hx
  rw [Tree.mem_roles_iff] at hx ⊢
  cases x with
  | ord a =>
    simp only [Move.mapRole]
    simp only [Tree.colAt, Option.isSome_iff_exists, Option.bind_eq_some_iff] at hx ⊢
    obtain ⟨y, G', hG', hy⟩ := hx
    obtain ⟨G, hG, hlen, -⟩ := forestAt_mod_bwd hcol hij hj a.path G' hG'
    have : a.col < G.cols.length := hlen ▸ (List.getElem?_eq_some_iff.1 hy).1
    exact ⟨_, G, hG, (List.getElem?_eq_some_iff.2 ⟨this, rfl⟩)⟩
  | slot e =>
    obtain ⟨⟨π, c'⟩, idx⟩ := e
    simp only [Move.mapRole]
    by_cases hm : π = m.col.path ∧ c' = m.col.col
    · obtain ⟨rfl, rfl⟩ := hm
      have hme : m.mapEntry m.bwdIdx ⟨m.col, idx⟩ = ⟨m.col, m.bwdIdx idx⟩ := by
        unfold Move.mapEntry; dsimp only
        rw [mapPath_off _ _ _ (fun e D he => by have := congrArg List.length he; simp at this)]
        rw [if_pos rfl]
      rw [show (⟨⟨m.col.path, m.col.col⟩, idx⟩ : EntryAddr) = ⟨m.col, idx⟩ from rfl, hme]
      rw [show (⟨⟨m.col.path, m.col.col⟩, idx⟩ : EntryAddr) = ⟨m.col, idx⟩ from rfl] at hx
      simp only [Tree.entryAt] at hx ⊢
      rw [colAt_mod_self, hcol] at hx
      rw [hcol]
      simp only [Option.map_some, Option.bind_some] at hx ⊢
      rw [moveFun, getElem?_moveFun m col hij.le hj.le] at hx
      exact hx
    · have hne : ¬ ((⟨m.mapPath m.bwdIdx π, c'⟩ : ColAddr) = m.col) := by
        rw [colAddr_mapPath_eq_iff]
        intro h; apply hm; rw [← h]; exact ⟨rfl, rfl⟩
      have hme : m.mapEntry m.bwdIdx ⟨⟨π, c'⟩, idx⟩ = ⟨⟨m.mapPath m.bwdIdx π, c'⟩, idx⟩ := by
        unfold Move.mapEntry; dsimp only; rw [if_neg hne]
      rw [hme]
      simp only [Tree.entryAt, Tree.colAt, Option.isSome_iff_exists, Option.bind_eq_some_iff] at hx ⊢
      obtain ⟨y, col', ⟨G', hG', hcol'⟩, hy⟩ := hx
      obtain ⟨G, hG, -, hlen⟩ := forestAt_mod_bwd hcol hij hj π G' hG'
      have hl := hlen c' hm
      rw [hcol'] at hl
      obtain ⟨col0, hcol0, hl0⟩ := Option.map_eq_some_iff.1 hl.symm
      have hidx : idx < col0.length := hl0 ▸ (List.getElem?_eq_some_iff.1 hy).1
      exact ⟨_, col0, ⟨G, hG, hcol0⟩, List.getElem?_eq_some_iff.2 ⟨hidx, rfl⟩⟩

/-! ### helpers: forests of a literal cap -/

theorem list_getElem?_take_snoc {α : Type} (l : List α) (n : Nat) (x : α) (h : n ≤ l.length) (a : Nat) :
    (l.take n ++ [x])[a]? = if a < n then l[a]? else if a = n then some x else none := by
  have hl : (l.take n).length = n := List.length_take_of_le h
  split_ifs with h1 h2
  · rw [List.getElem?_append_left (by omega), List.getElem?_take_of_lt h1]
  · subst h2; rw [List.getElem?_append_right (by omega), hl]; simp
  · rw [List.getElem?_append_right (by omega), hl]; simp; omega

theorem forestAt_empty_node_cons (x : Nat × Nat) (rest : List (Nat × Nat)) :
    (Tree.empty : Forest).forestAt (x :: rest) = none := by
  obtain ⟨a, b⟩ := x; simp [Tree.empty, forestAt_node_cons]

/-- helper: what a literal cap keeps, read at an arbitrary path. -/
theorem forestAt_litCapAux (k p : Nat) :
    ∀ (ρ : List (Nat × Nat)) (j : Nat) (F : Forest) (col : Column), F.colAt ⟨ρ, j⟩ = some col →
      k ≤ col.length → ∀ π G', (litCapAux k p ρ j F).forestAt π = some G' →
      (π = ρ ++ [(j, k)] ∧ G' = Tree.empty) ∨ ∃ G, F.forestAt π = some G ∧
        G'.cols.length ≤ G.cols.length ∧ ∀ c' col', G'.cols[c']? = some col' →
          ∃ col0, G.cols[c']? = some col0 ∧ ∀ idx < col'.length,
            idx < col0.length ∨ (π = ρ ∧ c' = j ∧ idx = k)
  | [], j, .node cols, col, hcol, hk, π, G', hG' => by
    rw [colAt_node_nil] at hcol
    have hj : j < cols.length := (List.getElem?_eq_some_iff.1 hcol).1
    simp only [litCapAux, List.getD_eq_getElem?_getD, hcol, Option.getD_some] at hG'
    cases π with
    | nil =>
      rw [forestAt_nil_path] at hG'
      obtain rfl := Option.some.inj hG'
      right
      refine ⟨_, forestAt_nil_path _, ?_, ?_⟩
      · simp only [Tree.cols, List.length_append, List.length_take, List.length_singleton]; omega
      · intro c' col' hc'
        simp only [Tree.cols] at hc' ⊢
        rw [list_getElem?_take_snoc _ _ _ hj.le] at hc'
        split_ifs at hc' with h1 h2
        · exact ⟨col', hc', fun idx hidx => Or.inl hidx⟩
        · subst h2
          obtain rfl := Option.some.inj hc'
          refine ⟨col, hcol, fun idx hidx => ?_⟩
          simp only [List.length_append, List.length_take, List.length_singleton] at hidx
          by_cases hik : idx = k
          · exact Or.inr (by simp [hik])
          · left; omega
    | cons ab rest =>
      obtain ⟨a, b⟩ := ab
      rw [forestAt_node_cons, list_getElem?_take_snoc _ _ _ hj.le] at hG'
      split_ifs at hG' with h1 h2
      · right; exact ⟨G', by rw [forestAt_node_cons]; exact hG', le_refl _,
          fun c' col' h => ⟨col', h, fun idx hidx => Or.inl hidx⟩⟩
      · subst h2
        simp only [Option.bind_some] at hG'
        rw [list_getElem?_take_snoc _ _ _ hk] at hG'
        split_ifs at hG' with h3 h4
        · right
          refine ⟨G', ?_, le_refl _, fun c' col' h => ⟨col', h, fun idx hidx => Or.inl hidx⟩⟩
          rw [forestAt_node_cons, hcol]; exact hG'
        · subst h4
          simp only [Option.bind_some] at hG'
          cases rest with
          | nil =>
            rw [forestAt_nil_path] at hG'
            exact Or.inl ⟨rfl, (Option.some.inj hG').symm⟩
          | cons x rest => rw [forestAt_empty_node_cons] at hG'; simp at hG'
        · simp at hG'
      · simp at hG'
  | (ci, ei) :: ρ, j, .node cols, col, hcol, hk, π, G', hG' => by
    rw [colAt_node_cons] at hcol
    obtain ⟨x, hx, hcolx⟩ := Option.bind_eq_some_iff.1 hcol
    obtain ⟨colc, hc, hx'⟩ := Option.bind_eq_some_iff.1 hx
    have hci : ci < cols.length := (List.getElem?_eq_some_iff.1 hc).1
    have hei : ei < colc.length := (List.getElem?_eq_some_iff.1 hx').1
    obtain ⟨q, H⟩ := x
    simp only [litCapAux, List.getD_eq_getElem?_getD, hc, Option.getD_some, hx'] at hG'
    cases π with
    | nil =>
      rw [forestAt_nil_path] at hG'
      obtain rfl := Option.some.inj hG'
      right
      refine ⟨_, forestAt_nil_path _, ?_, ?_⟩
      · simp only [Tree.cols, List.length_append, List.length_take, List.length_singleton]; omega
      · intro c' col' hc'
        simp only [Tree.cols] at hc' ⊢
        rw [list_getElem?_take_snoc _ _ _ hci.le] at hc'
        split_ifs at hc' with h1 h2
        · exact ⟨col', hc', fun idx hidx => Or.inl hidx⟩
        · subst h2
          obtain rfl := Option.some.inj hc'
          refine ⟨colc, hc, fun idx hidx => ?_⟩
          simp only [List.length_append, List.length_take, List.length_singleton] at hidx
          left; omega
    | cons ab rest =>
      obtain ⟨a, b⟩ := ab
      rw [forestAt_node_cons, list_getElem?_take_snoc _ _ _ hci.le] at hG'
      split_ifs at hG' with h1 h2
      · right; exact ⟨G', by rw [forestAt_node_cons]; exact hG', le_refl _,
          fun c' col' h => ⟨col', h, fun idx hidx => Or.inl hidx⟩⟩
      · subst h2
        simp only [Option.bind_some] at hG'
        rw [list_getElem?_take_snoc _ _ _ hei.le] at hG'
        split_ifs at hG' with h3 h4
        · right
          refine ⟨G', ?_, le_refl _, fun c' col' h => ⟨col', h, fun idx hidx => Or.inl hidx⟩⟩
          rw [forestAt_node_cons, hc]; exact hG'
        · subst h4
          simp only [Option.bind_some] at hG'
          rcases forestAt_litCapAux k p ρ j H col hcolx hk rest G' hG' with ⟨rfl, rfl⟩ | ⟨G, hG, hl, hcc⟩
          · exact Or.inl ⟨rfl, rfl⟩
          · right
            refine ⟨G, ?_, hl, fun c' col' h => ?_⟩
            · rw [forestAt_node_cons, hc]; simp only [Option.bind_some, hx']; exact hG
            · obtain ⟨col0, h0, hidx⟩ := hcc c' col' h
              refine ⟨col0, h0, fun idx hi => ?_⟩
              rcases hidx idx hi with h | ⟨rfl, rfl, rfl⟩
              · exact Or.inl h
              · exact Or.inr ⟨rfl, rfl, rfl⟩
        · simp at hG'
      · simp at hG'

/-- helper: every role of a literal cap is a role of `E` or the appended closing slot. -/
theorem roles_litCap {E : Forest} {c : ColAddr} {col : Column} (hcol : E.colAt c = some col)
    {k : Nat} (hk : k ≤ col.length) (p : Nat) :
    ∀ x ∈ (litCap E c k p).roles, x = .slot ⟨c, k⟩ ∨ x ∈ E.roles := by
  rw [litCap_eq_aux hcol]
  intro x hx
  rw [Tree.mem_roles_iff] at hx
  cases x with
  | ord a =>
    right
    rw [Tree.mem_roles_iff]
    simp only [Tree.colAt, Option.isSome_iff_exists, Option.bind_eq_some_iff] at hx ⊢
    obtain ⟨y, G', hG', hy⟩ := hx
    rcases forestAt_litCapAux k p c.path c.col E col hcol hk a.path G' hG' with ⟨-, rfl⟩ | ⟨G, hG, hl, -⟩
    · simp [Tree.empty, Tree.cols] at hy
    · have : a.col < G.cols.length := by have := (List.getElem?_eq_some_iff.1 hy).1; omega
      exact ⟨_, G, hG, List.getElem?_eq_some_iff.2 ⟨this, rfl⟩⟩
  | slot e =>
    obtain ⟨⟨π, c'⟩, idx⟩ := e
    simp only [Tree.entryAt, Tree.colAt, Option.isSome_iff_exists, Option.bind_eq_some_iff] at hx
    obtain ⟨y, col', ⟨G', hG', hcol'⟩, hy⟩ := hx
    rcases forestAt_litCapAux k p c.path c.col E col hcol hk π G' hG' with ⟨-, rfl⟩ | ⟨G, hG, -, hcc⟩
    · simp [Tree.empty, Tree.cols] at hcol'
    · obtain ⟨col0, h0, hidx⟩ := hcc c' col' hcol'
      rcases hidx idx (List.getElem?_eq_some_iff.1 hy).1 with h | ⟨rfl, rfl, rfl⟩
      · right
        rw [Tree.mem_roles_iff]
        simp only [Tree.entryAt, Tree.colAt, Option.isSome_iff_exists, Option.bind_eq_some_iff]
        exact ⟨_, col0, ⟨G, hG, h0⟩, List.getElem?_eq_some_iff.2 ⟨h, rfl⟩⟩
      · left; rfl

/-! ### helpers: stop data along legal moves -/

theorem stopData_applyMove {K : Forest} {m : Move} (hm : MoveOK K m) {sd : StopData}
    (hsd : stopData K = some sd) :
    ∃ rest, sd.col.path = m.col.path ++ (m.col.col, m.j) :: rest ∧
      stopData (applyMove K m) =
        some { sd with col := ⟨m.col.path ++ (m.col.col, m.i) :: rest, sd.col.col⟩ } := by
  obtain ⟨col, sd0, hcol, hsd0, hj, hij, hpre, -, -, -⟩ := hm
  rw [hsd] at hsd0
  obtain rfl := Option.some.inj hsd0
  obtain ⟨rest, hrest⟩ := hpre
  have hpath : sd.col.path = m.col.path ++ (m.col.col, m.j) :: rest := by
    rw [← hrest]; simp [EntryAddr.heightPath]
  refine ⟨rest, hpath, ?_⟩
  rw [applyMove_eq_mod hcol hij (by omega)]
  exact stopF_modifyColAux m.col.col m.j m.i rest hij.le m.col.path K sd hsd hpath

theorem bwd_moved_slot (m : Move) (hij : m.i ≤ m.j) (rest : List (Nat × Nat)) (cc n : Nat) :
    m.mapRole m.bwdIdx (.slot ⟨⟨m.col.path ++ (m.col.col, m.i) :: rest, cc⟩, n⟩) =
      .slot ⟨⟨m.col.path ++ (m.col.col, m.j) :: rest, cc⟩, n⟩ := by
  simp only [Move.mapRole, Move.mapEntry, mapPath_through]
  have hb : m.bwdIdx m.i = m.j := by unfold Move.bwdIdx; rw [if_pos le_rfl]; omega
  rw [hb]
  rw [if_neg]
  intro h
  have := congrArg (fun c : ColAddr => c.path.length) h
  simp at this

theorem movesValid_append {K : Forest} {ms : List Move} {m : Move} (h : MovesValid K (ms ++ [m])) :
    MovesValid K ms ∧ MoveOK (applyMoves K ms) m := by
  refine ⟨fun idx hidx => ?_, ?_⟩
  · have := h idx (by simp; omega)
    rw [List.take_append_of_le_length hidx.le, List.getElem_append_left hidx] at this
    exact this
  · have := h ms.length (by simp)
    rw [List.take_left, List.getElem_append_right (by omega)] at this
    simpa using this

theorem applyMoves_snoc (K : Forest) (ms : List Move) (m : Move) :
    applyMoves K (ms ++ [m]) = applyMove (applyMoves K ms) m := by
  simp [applyMoves, List.foldl_append]

theorem isUpward_iff_exists {E : Forest} {c : ColAddr} {k p : Nat} :
    IsUpward E c k p ↔ ∃ col, E.colAt c = some col ∧ k ≤ col.length ∧
      ∀ q h, col[k]? = some (q, h) → q < p := by
  unfold IsUpward
  cases hcol : E.colAt c with
  | none => simp
  | some col =>
    simp only [Option.some.injEq, exists_eq_left']
    cases hk : col[k]? with
    | none =>
      have := List.getElem?_eq_none_iff.1 hk
      simp only [reduceCtorEq, false_implies, implies_true, and_true]
      omega
    | some x =>
      obtain ⟨q, h⟩ := x
      have := (List.getElem?_eq_some_iff.1 hk).1
      simp only [Option.some.injEq, Prod.mk.injEq]
      constructor
      · intro hq; exact ⟨this.le, fun q' h' he => he.1 ▸ hq⟩
      · intro ⟨_, h⟩; exact h q _ ⟨rfl, rfl⟩

/-- helper: the invariant behind `origin_spec`: roles of the moved cap undo to roles of the literal
cap, and the closing slot undoes to the appended slot. -/
theorem adm_invariant {E : Forest} {c : ColAddr} {k p : Nat} (hup : IsUpward E c k p) :
    ∀ ms : List Move, MovesValid (litCap E c k p) ms →
      (∀ x ∈ (applyMoves (litCap E c k p) ms).roles, backRole ms x ∈ (litCap E c k p).roles) ∧
      ∃ sd, stopData (applyMoves (litCap E c k p) ms) = some sd ∧
        backRole ms (.slot (closingSlot sd)) = .slot ⟨c, k⟩ := by
  intro ms
  induction ms using List.reverseRecOn with
  | nil =>
    intro _
    refine ⟨fun x hx => hx, ?_⟩
    obtain ⟨col, hcol, hk, -⟩ := isUpward_iff_exists.1 hup
    refine ⟨_, stopData_litCap' hcol k p, ?_⟩
    simp [backRole, closingSlot, List.length_take_of_le hk]
  | append_singleton ms m ih =>
    intro hv
    obtain ⟨hv, hm⟩ := movesValid_append hv
    obtain ⟨ihr, sd, hsd, hback⟩ := ih hv
    rw [applyMoves_snoc]
    have hm' := hm
    obtain ⟨col, -, hcol, -, hj, hij, -⟩ := hm'
    refine ⟨fun x hx => ?_, ?_⟩
    · rw [backRole_append]
      exact ihr _ (roles_applyMove_bwd hcol hij (by omega) x hx)
    · obtain ⟨rest, hpath, hsd'⟩ := stopData_applyMove hm hsd
      refine ⟨_, hsd', ?_⟩
      rw [backRole_append]
      simp only [closingSlot]
      rw [bwd_moved_slot m hij.le, ← hpath]
      exact hback

-- provides: U2, D3.1a (`origin_spec`†: χ is injective on the roles of `w.H`, `none` exactly on
-- the closing slot, and the identity on every role of a literal cap other than that slot)
theorem origin_spec {E : Forest} (w : AdmCap E) :
    (∀ x ∈ w.H.roles, ∀ y ∈ w.H.roles, ∀ z, w.origin x = some z → w.origin y = some z → x = y) ∧
    (∀ x ∈ w.H.roles, w.origin x = none ↔
      ∃ sd, stopData w.H = some sd ∧ x = .slot (closingSlot sd)) ∧
    (w.moves = [] → ∀ x ∈ w.H.roles, x ≠ .slot ⟨w.col, w.cut⟩ → w.origin x = some x) ∧
    (∀ x ∈ w.H.roles, ∀ z, w.origin x = some z → z ∈ E.roles) := by
  obtain ⟨hroles, sdf, hsdf, hback⟩ := adm_invariant w.upward w.moves w.movesValid
  have hsome : ∀ x z, w.origin x = some z → backRole w.moves x = z ∧
      backRole w.moves x ≠ .slot ⟨w.col, w.cut⟩ := by
    intro x z h
    rw [originBody_eq] at h
    split_ifs at h with h1
    exact ⟨Option.some.inj h, h1⟩
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro x _ y _ z hx hy
    obtain ⟨hx, -⟩ := hsome x z hx
    obtain ⟨hy, -⟩ := hsome y z hy
    exact backRole_injective _ (hx.trans hy.symm)
  · intro x _
    rw [originBody_eq]
    constructor
    · intro h
      split_ifs at h with h1
      refine ⟨sdf, hsdf, backRole_injective w.moves ?_⟩
      rw [h1, hback]
    · rintro ⟨sd, hsd, rfl⟩
      have : sd = sdf := Option.some.inj ((hsd.symm.trans hsdf))
      subst this
      rw [if_pos hback]
  · intro h0 x _ hx
    rw [originBody_eq]
    simp only [h0, backRole, List.foldr_nil]
    rw [if_neg hx]
  · intro x hx z hz
    obtain ⟨rfl, hne⟩ := hsome x z hz
    obtain ⟨col, hcol, hk, -⟩ := isUpward_iff_exists.1 w.upward
    rcases roles_litCap hcol hk w.par _ (hroles x hx) with h | h
    · exact absurd h hne
    · exact h


/-! ## §W — U2 half of the S-6 word library -/

section Words

variable {α : Type} [LinearOrder α]

/-- T3.2b: `X'` is a decrease of `X` whose first change is exactly at position `a`: they agree
before `a`, and at `a` either `X'` ends (while `X` continues) or has a smaller letter. -/
def FirstDec (X X' : List α) (a : Nat) : Prop :=
  X'.take a = X.take a ∧ a ≤ X'.length ∧
    ((X'.length = a ∧ a < X.length) ∨ ∃ x x', X[a]? = some x ∧ X'[a]? = some x' ∧ x' < x)

/-- S-6 helper: the list order through its decision position `i`: `X` and `Y` agree before
`i`, `Y` has a letter `y` at `i`, and `X` ends at `i` or has a smaller letter there. -/
theorem ker_lt_iff : ∀ (X Y : List α),
    X < Y ↔ ∃ i y, X.take i = Y.take i ∧ Y[i]? = some y ∧
      (X[i]? = none ∨ ∃ x, X[i]? = some x ∧ x < y)
  | [], [] => by simp
  | [], y :: Y => by
    simp only [List.nil_lt_cons, true_iff]
    exact ⟨0, y, rfl, rfl, Or.inl rfl⟩
  | x :: X, [] => by
    simp only [List.not_lt_nil, false_iff, not_exists, not_and]
    intro i y _ h; simp at h
  | x :: X, y :: Y => by
    rw [List.cons_lt_cons_iff, ker_lt_iff X Y]
    constructor
    · rintro (h | ⟨rfl, i, z, h1, h2, h3⟩)
      · exact ⟨0, y, rfl, rfl, Or.inr ⟨x, rfl, h⟩⟩
      · exact ⟨i + 1, z, by simp [h1], by simpa using h2, by simpa using h3⟩
    · rintro ⟨i, z, h1, h2, h3⟩
      cases i with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq] at h2
        subst h2
        rcases h3 with h3 | ⟨x', h3, h4⟩
        · simp at h3
        · simp only [List.getElem?_cons_zero, Option.some.injEq] at h3
          subst h3; exact Or.inl h4
      | succ i =>
        simp only [List.take_succ_cons, List.cons.injEq, List.getElem?_cons_succ] at h1 h2 h3
        exact Or.inr ⟨h1.1, i, z, h1.2, h2, h3⟩

/-- S-6 helper: agreement before `j` gives agreement at every `i < j`. -/
theorem ker_getElem?_of_take {l₁ l₂ : List α} {i j : Nat} (h : l₁.take j = l₂.take j)
    (hij : i < j) : l₁[i]? = l₂[i]? := by
  rw [← List.getElem?_take_of_lt hij, h, List.getElem?_take_of_lt hij]

/-- S-6 helper: agreement before `j` gives agreement before every `i ≤ j`. -/
theorem ker_take_of_take {l₁ l₂ : List α} {i j : Nat} (h : l₁.take j = l₂.take j)
    (hij : i ≤ j) : l₁.take i = l₂.take i := by
  rw [← Nat.min_eq_left hij, ← List.take_take, h, List.take_take]

/-- S-6 helper: the decision position of `X < Y` is at most `|X|`. -/
theorem ker_lt_pos_le {X Y : List α} {i : Nat} {y : α} (h1 : X.take i = Y.take i)
    (h2 : Y[i]? = some y) (h3 : X[i]? = none ∨ ∃ x, X[i]? = some x ∧ x < y) : i ≤ X.length := by
  rcases h3 with h3 | ⟨x, h3, _⟩
  · have hY : i < Y.length := by
      by_contra h; rw [List.getElem?_eq_none (by omega)] at h2; cases h2
    have := congrArg List.length h1
    rw [List.length_take, List.length_take] at this
    omega
  · by_contra h; rw [List.getElem?_eq_none (by omega)] at h3; cases h3

/-- S-6 helper: a comparison `X < Y` decided at `i` survives any change of `Y` after `i`. -/
theorem ker_lt_of_agree {X Y Y' : List α} {i : Nat} {y : α} (h1 : X.take i = Y.take i)
    (h2 : Y[i]? = some y) (h3 : X[i]? = none ∨ ∃ x, X[i]? = some x ∧ x < y)
    (hY : Y'.take (i + 1) = Y.take (i + 1)) : X < Y' := by
  rw [ker_lt_iff]
  refine ⟨i, y, ?_, ?_, h3⟩
  · rw [h1, ker_take_of_take hY (Nat.le_succ i)]
  · rw [ker_getElem?_of_take hY (Nat.lt_succ_self i), h2]

-- T3.2b (txt:304-307, first part)
theorem lt_of_firstDec {X Y X' Y' : List α} {a b : Nat} (hXY : X < Y) (hX : FirstDec X X' a)
    (hY : Y'.take b = Y.take b ∧ b ≤ Y'.length) (hab : a < b) : X' < Y' := by
  obtain ⟨hXa, haX', hdec⟩ := hX
  obtain ⟨hYb, hbY'⟩ := hY
  obtain ⟨δ, y, h1, h2, h3⟩ := (ker_lt_iff X Y).1 hXY
  rw [ker_lt_iff]
  rcases Nat.lt_or_ge δ a with hδ | hδ
  · -- decided before the change of `X`
    refine ⟨δ, y, ?_, ?_, ?_⟩
    · rw [ker_take_of_take hXa (le_of_lt hδ), h1, ker_take_of_take hYb (by omega)]
    · rw [ker_getElem?_of_take hYb (by omega), h2]
    · rw [ker_getElem?_of_take hXa hδ]; exact h3
  · -- `X'` decreases at `a ≤ δ`, before any change of `Y`
    have hYa : a < Y.length := by
      have := ker_lt_pos_le h1 h2 h3
      have hY : δ < Y.length := by
        by_contra h; rw [List.getElem?_eq_none (by omega)] at h2; cases h2
      omega
    obtain ⟨y', hy'⟩ : ∃ y', Y[a]? = some y' := ⟨Y[a], List.getElem?_eq_getElem hYa⟩
    refine ⟨a, y', ?_, ?_, ?_⟩
    · rw [hXa, ker_take_of_take h1 hδ, ker_take_of_take hYb (le_of_lt hab)]
    · rw [ker_getElem?_of_take hYb hab, hy']
    · rcases hdec with ⟨hlen, _⟩ | ⟨x, x', hx, hx', hlt⟩
      · left; exact List.getElem?_eq_none (by omega)
      · right
        refine ⟨x', hx', ?_⟩
        rcases Nat.lt_or_ge a δ with hlt' | hge
        · have : X[a]? = Y[a]? := ker_getElem?_of_take h1 hlt'
          rw [hx, hy'] at this
          cases this
          exact hlt
        · have had : a = δ := by omega
          subst had
          rw [hy'] at h2
          cases h2
          rcases h3 with h3 | ⟨x₀, h3, h4⟩
          · rw [h3] at hx; cases hx
          · rw [h3] at hx; cases hx
            exact lt_trans hlt h4

-- T3.2b (txt:306-307, second part: changes of `Y` only after position `|X|`)
theorem lt_of_take_succ {X Y Y' : List α} (hXY : X < Y)
    (h : Y'.take (X.length + 1) = Y.take (X.length + 1)) : X < Y' := by
  obtain ⟨δ, y, h1, h2, h3⟩ := (ker_lt_iff X Y).1 hXY
  have hδ := ker_lt_pos_le h1 h2 h3
  exact ker_lt_of_agree h1 h2 h3 (ker_take_of_take h (by omega))

/-- L3.4: the kernel's iterates on words: `kerIter P σ q = P Σ(P) ⋯ Σ^{q-1}(P)`. -/
def kerIter (P : List α) (σ : α → α) : Nat → List α
  | 0 => []
  | q + 1 => P ++ (kerIter P σ q).map σ

/-- L3.4a helper: the length of an iterate. -/
theorem ker_kerIter_len (P : List α) (σ : α → α) :
    ∀ q, (kerIter P σ q).length = q * P.length
  | 0 => by simp [kerIter]
  | q + 1 => by
    simp only [kerIter, List.length_append, List.length_map, ker_kerIter_len P σ q, Nat.succ_mul]
    omega

-- L3.4a: iterates are proper-prefix increasing
theorem kerIter_prefix (P : List α) (σ : α → α) (hP : P ≠ []) (q : Nat) :
    kerIter P σ q <+: kerIter P σ (q + 1) ∧ kerIter P σ q ≠ kerIter P σ (q + 1) := by
  refine ⟨?_, ?_⟩
  · induction q with
    | zero => exact List.nil_prefix
    | succ q ih =>
      show P ++ (kerIter P σ q).map σ <+: P ++ (kerIter P σ (q + 1)).map σ
      exact (List.prefix_append_right_inj P).2 (ih.map σ)
  · intro h
    have := congrArg List.length h
    rw [ker_kerIter_len, ker_kerIter_len, Nat.succ_mul] at this
    have := List.length_pos_of_ne_nil hP
    omega

theorem kerIter_length (P : List α) (σ : α → α) (q : Nat) :
    (kerIter P σ q).length = q * P.length := ker_kerIter_len P σ q

/-- helper: a proper extension is larger. -/
theorem ker_lt_append {t : List α} (ht : t ≠ []) :
    ∀ l : List α, l < l ++ t
  | [] => by
    obtain ⟨x, xs, rfl⟩ := List.exists_cons_of_ne_nil ht
    exact List.nil_lt_cons _ _
  | x :: l => by
    rw [List.cons_append, List.cons_lt_cons_iff]
    exact Or.inr ⟨rfl, ker_lt_append ht l⟩

theorem ker_kerIter_prefix_succ (P : List α) (σ : α → α) :
    ∀ m, kerIter P σ m <+: kerIter P σ (m + 1)
  | 0 => List.nil_prefix
  | q + 1 => by
    show P ++ (kerIter P σ q).map σ <+: P ++ (kerIter P σ (q + 1)).map σ
    exact (List.prefix_append_right_inj P).2 ((ker_kerIter_prefix_succ P σ q).map σ)

theorem ker_kerIter_prefix_le (P : List α) (σ : α → α) {n n' : Nat} (h : n ≤ n') :
    kerIter P σ n <+: kerIter P σ n' := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le h
  clear h
  induction k with
  | zero => exact List.prefix_refl _
  | succ k ih => exact ih.trans (ker_kerIter_prefix_succ P σ (n + k))


/-- L3.4 helper: `F(U) = P ⌢ σ(U)` turns agreement on `t` letters into agreement on `|P| + t`. -/
theorem ker_F_take (P : List α) (σ : α → α) {U V : List α} {t : Nat} (h : U.take t = V.take t) :
    (P ++ U.map σ).take (P.length + t) = (P ++ V.map σ).take (P.length + t) := by
  rw [List.take_length_add_append, List.take_length_add_append, ← List.map_take, h,
    List.map_take]

/-- L3.4 helper: if `Y < F(Y)`, every iterate longer than `|Y|` covers `Y`. -/
theorem ker_cover (P : List α) {σ : α → α} (hP : P ≠ []) {Y : List α}
    (h : Y < P ++ Y.map σ) {q : Nat} (hq : Y.length < q * P.length) : Y < kerIter P σ q := by
  obtain ⟨δ, z, h1, h2, h3⟩ := (ker_lt_iff Y _).1 h
  have hδ := ker_lt_pos_le h1 h2 h3
  have hPpos := List.length_pos_of_ne_nil hP
  -- the iterates agree with `Y` before `min δ (q' |P|)`
  have hagree : ∀ q', Y.take (min δ (q' * P.length)) =
      (kerIter P σ q').take (min δ (q' * P.length)) := by
    intro q'
    induction q' with
    | zero => simp
    | succ q' ih =>
      have hF := ker_F_take P σ ih
      have hm : min δ ((q' + 1) * P.length) ≤ min δ (P.length + min δ (q' * P.length)) := by
        rw [Nat.succ_mul]; omega
      apply ker_take_of_take _ hm
      rw [ker_take_of_take h1 (Nat.min_le_left _ _)]
      exact ker_take_of_take hF (Nat.min_le_right _ _)
  cases q with
  | zero => simp at hq
  | succ q =>
    have hF := ker_F_take P σ (hagree q)
    apply ker_lt_of_agree h1 h2 h3
    symm
    apply ker_take_of_take hF
    rw [Nat.succ_mul] at hq
    omega

-- L3.4b (txt:427-436): success iff some iterate covers
theorem word_criterion (P : List α) {σ : α → α} (hP : P ≠ []) (hσ : StrictMono σ)
    (Y : List α) : Y < P ++ Y.map σ ↔ ∃ q, Y < kerIter P σ q := by
  have hPpos := List.length_pos_of_ne_nil hP
  constructor
  · intro h
    refine ⟨Y.length + 1, ker_cover P hP h ?_⟩
    rw [Nat.succ_mul]
    have : Y.length ≤ Y.length * P.length := Nat.le_mul_of_pos_right _ hPpos
    omega
  · rintro ⟨q, hq⟩
    obtain ⟨δ, z, h1, h2, h3⟩ := (ker_lt_iff Y _).1 hq
    cases q with
    | zero => simp [kerIter] at h2
    | succ q =>
      have hδK : δ < (kerIter P σ (q + 1)).length := by
        by_contra h; rw [List.getElem?_eq_none (by omega)] at h2; cases h2
      have hpre := ker_kerIter_prefix_le P σ (Nat.le_succ q)
      set t := min δ (kerIter P σ q).length with ht
      have hYt : Y.take t = (kerIter P σ q).take t := by
        rw [ker_take_of_take h1 (Nat.min_le_left _ _)]
        obtain ⟨u, hu⟩ := hpre
        rw [← hu, List.take_append_of_le_length (Nat.min_le_right _ _)]
      have hF := ker_F_take P σ hYt
      have hlen := kerIter_length P σ (q + 1)
      have hlen' := kerIter_length P σ q
      apply ker_lt_of_agree h1 h2 h3
      apply ker_take_of_take hF
      rw [Nat.succ_mul] at hlen
      omega

-- L3.4c: success is downward closed in the target
theorem success_anti (P : List α) {σ : α → α} (hP : P ≠ []) (hσ : StrictMono σ)
    {Y Y' : List α} (hle : Y' ≤ Y) (h : Y < P ++ Y.map σ) : Y' < P ++ Y'.map σ := by
  obtain ⟨q, hq⟩ := (word_criterion P hP hσ Y).1 h
  exact (word_criterion P hP hσ Y').2 ⟨q, lt_of_le_of_lt hle hq⟩

-- L3.4d: the explicit iteration bound `q |P| > |w(Y)|`
theorem cover_of_success (P : List α) {σ : α → α} (hP : P ≠ []) (hσ : StrictMono σ)
    {Y : List α} (h : Y < P ++ Y.map σ) {q : Nat} (hq : Y.length < q * P.length) :
    Y < kerIter P σ q := ker_cover P hP h hq

-- L3.4e: equality `F(Y) = Y` is impossible by length
theorem kernel_ne (P : List α) (σ : α → α) (hP : P ≠ []) (Y : List α) : P ++ Y.map σ ≠ Y := by
  intro h
  have := congrArg List.length h
  rw [List.length_append, List.length_map] at this
  have := List.length_pos_of_ne_nil hP
  omega

-- L3.7 (txt:482-487): delayed change
theorem delayed_change {L R L' R' : List α} {lam : Nat} (hRL : R < L) (hlen : R.length ≤ lam)
    (hagree : L'.take lam = L.take lam) (hL' : lam ≤ L'.length) (hR : R' < R) : R' < L' := by
  obtain ⟨δ, y, h1, h2, h3⟩ := (ker_lt_iff R L).1 hRL
  have hδ := ker_lt_pos_le h1 h2 h3
  apply lt_of_lt_of_le hR
  rcases Nat.lt_or_ge δ lam with hlt | hge
  · exact le_of_lt (ker_lt_of_agree h1 h2 h3 (ker_take_of_take hagree hlt))
  · -- `R` is a prefix of `L'`
    have hRe : R.take δ = R := List.take_of_length_le (by omega)
    have hRL' : R = L'.take δ := by rw [← hRe, h1, ker_take_of_take hagree (by omega)]
    obtain ⟨t, ht⟩ := List.take_prefix δ L'
    rw [hRL']
    conv_rhs => rw [← ht]
    by_cases h0 : t = []
    · rw [h0, List.append_nil]
    · exact le_of_lt (ker_lt_append h0 _)

/-- T3.2p helper: a word between `T ⌢ D` (letters of `D` below `K`) and `T ⌢ [K]` (letters of `T`
at least `K`) keeps exactly `T` as its run of letters `≥ K`. -/
theorem spx_takeWhile_between {K : α} : ∀ (T D Z : List α), (∀ t ∈ T, K ≤ t) →
    (∀ d ∈ D, d < K) → T ++ D ≤ Z → Z < T ++ [K] →
      Z.takeWhile (fun y => decide (K ≤ y)) = T
  | [], D, [], _, _, _, _ => rfl
  | [], D, z :: Z, _, _, _, h2 => by
    rcases List.cons_lt_cons_iff.1 h2 with h | ⟨-, h⟩
    · simp [not_le.2 h]
    · exact absurd h (List.not_lt_nil _)
  | t :: T, D, [], _, _, h1, _ => by
    exact absurd (List.nil_lt_cons t (T ++ D)) (not_lt.2 h1)
  | t :: T, D, z :: Z, hT, hD, h1, h2 => by
    have h1' : ¬ z :: Z < t :: (T ++ D) := not_lt.2 h1
    rw [List.cons_lt_cons_iff] at h1'
    have h2' := List.cons_lt_cons_iff.1 h2
    have hzt : z = t := by
      rcases h2' with h | ⟨h, -⟩
      · exact absurd (Or.inl h) h1'
      · exact h
    subst hzt
    have h2'' : Z < T ++ [K] := by
      rcases h2' with h | ⟨-, h⟩
      · exact absurd h (lt_irrefl _)
      · exact h
    have h1'' : T ++ D ≤ Z := by
      rw [← not_lt]; intro h; exact h1' (Or.inr ⟨rfl, h⟩)
    have hK : K ≤ z := hT z List.mem_cons_self
    rw [List.takeWhile_cons, if_pos (by simpa using hK),
      spx_takeWhile_between T D Z (fun t ht => hT t (List.mem_cons_of_mem _ ht)) hD h1'' h2'']

/-- T3.2p helper: the one-step reset. -/
theorem spx_reset_one (ks Z : List α) {c : Nat} (hc : c < ks.length)
    (hZ : Z.Pairwise fun x y => y ≤ x) (h1 : cutQuery ks c ≤ Z) (h2 : Z < cutQuery ks (c + 1)) :
    nu (Z ++ [ks[c]]) = cutQuery ks (c + 1) := by
  have hB := cutQuery_noninc ks c
  rw [nu_append_singleton, nu_of_noninc hZ, nuStep_eq_takeWhile hZ, cutQuery_succ hc,
    nuStep_eq_takeWhile hB]
  rw [cutQuery_succ hc, nuStep_eq_takeWhile hB] at h2
  congr 1
  set B := cutQuery ks c
  refine spx_takeWhile_between _ (B.dropWhile fun y => decide (ks[c] ≤ y)) Z ?_ ?_ ?_ h2
  · intro t ht; simpa using mem_takeWhile_imp_of ht
  · intro d hd
    -- the letters after the run are below `ks[c]` (the word is nonincreasing)
    have hsplit := List.takeWhile_append_dropWhile (p := fun y => decide (ks[c] ≤ y)) (l := B)
    cases hdw : B.dropWhile (fun y => decide (ks[c] ≤ y)) with
    | nil => rw [hdw] at hd; simp at hd
    | cons d₀ ds =>
      have hd₀ : d₀ < ks[c] := by
        have := List.head_dropWhile_not (fun y => decide (ks[c] ≤ y)) (l := B) (by simp [hdw])
        simp only [hdw, List.head_cons] at this
        simpa using this
      rw [hdw] at hd
      rcases List.mem_cons.1 hd with rfl | hd
      · exact hd₀
      · have hnon : (d₀ :: ds).Pairwise fun x y => y ≤ x := by
          rw [← hdw]; exact hB.sublist (List.dropWhile_sublist _)
        exact lt_of_le_of_lt (List.rel_of_pairwise_cons hnon hd) hd₀
  · rw [List.takeWhile_append_dropWhile]; exact h1

-- T3.2p (txt:377-382): the reset identity `ν(Z ⌢ [K_c]) = B_c`, iterated through the suffix
theorem reset_nu (ks Z : List α) {c : Nat} (hc : c < ks.length)
    (hZ : Z.Pairwise fun x y => y ≤ x) (h1 : cutQuery ks c ≤ Z) (h2 : Z < cutQuery ks (c + 1))
    {v : Nat} (hv1 : 1 ≤ v) (hv : c + v ≤ ks.length) :
    nu (Z ++ (ks.drop c).take v) = cutQuery ks (c + v) := by
  obtain ⟨w, rfl⟩ : ∃ w, v = w + 1 := ⟨v - 1, by omega⟩
  rw [List.drop_eq_getElem_cons hc, List.take_succ_cons,
    show Z ++ ks[c] :: (ks.drop (c + 1)).take w = (Z ++ [ks[c]]) ++ (ks.drop (c + 1)).take w by simp,
    ← nu_append_nu, spx_reset_one ks Z hc hZ h1 h2, cutQuery, nu_append_nu, ← List.take_add,
    show c + 1 + w = c + (w + 1) by omega]
  rfl

-- T3.2p (txt:386-389): the head cursor `m + γ − c` (including exhaustion)
theorem head_cursor (qs ks : List α) {c : Nat} (hc : c ≤ ks.length)
    (h1 : cutQuery ks c ≤ nu qs) (h2 : c < ks.length → nu qs < cutQuery ks (c + 1))
    {V : List α} (hV : V.Pairwise fun x y => y ≤ x) :
    (V < nu qs → cursor (qs ++ ks.drop c) V < qs.length) ∧
    (nu qs ≤ V → c ≤ cursor ks V ∧
      cursor (qs ++ ks.drop c) V = qs.length + (cursor ks V - c)) := by
  refine ⟨fun hlt => ?_, fun hle => ?_⟩
  · have hq : cursor qs V < qs.length := by
      have := cursor_le_length qs V
      rcases Nat.lt_or_eq_of_le this with h | h
      · exact h
      · exact absurd ((cursor_eq_length_iff qs hV).1 h) (not_le.2 hlt)
    rw [cursor_append_of_lt _ hq]; exact hq
  · have hcm : c ≤ cursor ks V := le_cursor_of_cutQuery_le hV hc (le_trans h1 hle)
    refine ⟨hcm, ?_⟩
    set m := cursor ks V with hm
    have hmL : m ≤ ks.length := cursor_le_length ks V
    obtain ⟨hlo, hhi⟩ := cursor_spec ks V hV
    -- the cut queries of the concatenated source past `qs`
    have hcut : ∀ w, c + w ≤ ks.length →
        cutQuery (qs ++ ks.drop c) (qs.length + w) = if w = 0 then nu qs else cutQuery ks (c + w) := by
      intro w hw
      rw [cutQuery, List.take_append, List.take_of_length_le (by omega), Nat.add_sub_cancel_left,
        ← nu_append_nu]
      split_ifs with hw0
      · subst hw0; simp [nu_of_noninc (nu_noninc qs)]
      · exact reset_nu ks (nu qs) (by omega) (nu_noninc qs) h1 (h2 (by omega)) (by omega) hw
    apply cursor_unique hV
    · simp only [List.length_append, List.length_drop]; omega
    · rw [hcut (m - c) (by omega)]
      split_ifs with h0
      · exact hle
      · rw [show c + (m - c) = m by omega]; exact hlo
    · intro hlt
      simp only [List.length_append, List.length_drop] at hlt
      rw [show qs.length + (m - c) + 1 = qs.length + (m - c + 1) by omega,
        hcut (m - c + 1) (by omega), if_neg (by omega), show c + (m - c + 1) = m + 1 by omega]
      exact hhi (by omega)

end Words

/-! ## L3.1 — profile and repair -/

/-! ### L3.1b helpers: the first-entry branch is a pure tower -/

/-- helper: the first-entry branch of a height with host number `a + k`, as V, I and H shape it:
the first column starts with an entry of parent `a + k`, its entries are nonincreasing, and the
branch continues in the height of that entry when nonempty. -/
inductive BranchOK (a : Nat) : Nat → Forest → Prop
  | mk {k : Nat} {h₀ : Forest} {rest : List (Nat × Forest)} {cs : List Column} :
      (∀ i x y, ((a + k, h₀) :: rest)[i]? = some x → ((a + k, h₀) :: rest)[i + 1]? = some y →
        EntryLe y x) →
      (h₀ ≠ Tree.empty → BranchOK a (k + 1) h₀) →
      BranchOK a k (.node (((a + k, h₀) :: rest) :: cs))

/-- helper: a nonincreasing column starting with `(q, ∅)`: its run of parent `q` has empty
heights, and the entry after the run has a smaller parent. -/
theorem run_split {q : Nat} :
    ∀ (rest : List (Nat × Forest)),
      (∀ i x y, ((q, Tree.empty) :: rest)[i]? = some x → ((q, Tree.empty) :: rest)[i + 1]? = some y →
        EntryLe y x) →
      rest = List.replicate (rest.takeWhile fun x => x.1 == q).length (q, Tree.empty) ++
        rest.dropWhile (fun x => x.1 == q) ∧
      ∀ y ∈ (rest.dropWhile fun x => x.1 == q).head?, y.1 < q
  | [], _ => by simp
  | y :: rest, h => by
    have h0 := h 0 _ _ rfl rfl
    rcases h0 with hlt | ⟨heq, hle⟩
    · have hne : (y.1 == q) = false := by simp; omega
      simp [List.takeWhile_cons, List.dropWhile_cons, hne, hlt]
    · have hy : y.2 = Tree.empty := by
        by_contra hne
        exact absurd hle (not_le.2 (Forest.empty_lt hne))
      obtain ⟨y1, y2⟩ := y
      simp only at heq hy; subst heq hy
      have ih := run_split rest (fun i x z hx hz => h (i + 1) x z hx hz)
      simp only [List.takeWhile_cons, List.dropWhile_cons, beq_self_eq_true, if_true,
        List.length_cons, List.replicate_succ, List.cons_append]
      exact ⟨by rw [← ih.1], ih.2⟩

theorem relLabel_host (a k : Nat) : relLabel a (a + k) = (true, k) := by
  unfold relLabel; rw [if_neg (by omega)]; simp

theorem relKey_node (a : Nat) (cols : List Column) :
    relKey a (.node cols) = .node (Tree.mapCols (relLabel a) cols) := rfl

theorem cmpCol_rep_append {α : Type} (c : α → α → Ordering) [Std.ReflCmp c] (X : α × Tree α) :
    ∀ (m : Nat) (A B : List (α × Tree α)),
      Tree.cmpCol c (List.replicate m X ++ A) (List.replicate m X ++ B) = Tree.cmpCol c A B
  | 0, A, B => rfl
  | m + 1, A, B => by
    obtain ⟨x, h⟩ := X
    simp only [List.replicate_succ, List.cons_append, Tree.cmpCol, Std.ReflCmp.compare_self,
      Tree.cmp_self, Ordering.eq_then]
    exact cmpCol_rep_append c (x, h) m A B

theorem profileAux_branch {a : Nat} : ∀ {k : Nat} {J : Forest}, BranchOK a k J →
    ∃ d m, profileAux k J = toLex (d, m) ∧ 1 ≤ m ∧ k ≤ d := by
  intro k J hb
  induction hb with
  | @mk k h₀ rest cs hH hrec ih =>
    obtain ⟨gs⟩ := h₀
    cases gs with
    | nil => exact ⟨k, 1 + (rest.takeWhile fun x => x.1 == a + k).length, by simp [profileAux],
        by omega, le_refl _⟩
    | cons g gs =>
      obtain ⟨d, m, h1, h2, h3⟩ := ih (by simp [Tree.empty])
      exact ⟨d, m, by simp only [profileAux]; exact h1, h2, by omega⟩

/-- helper: the relabelled first column of a branch level with empty first height. -/
theorem mapCol_run (a k : Nat) (rest : List (Nat × Forest))
    (hH : ∀ i x y, ((a + k, Tree.empty) :: rest)[i]? = some x →
      ((a + k, Tree.empty) :: rest)[i + 1]? = some y → EntryLe y x) :
    ∃ A, Tree.mapCol (relLabel a) ((a + k, (Tree.empty : Forest)) :: rest) =
      List.replicate (1 + (rest.takeWhile fun x => x.1 == a + k).length) ((true, k), Tree.empty) ++ A ∧
      ∀ y ∈ A.head?, keyLabelCmp y.1 (true, k) = .lt := by
  obtain ⟨h1, h2⟩ := run_split rest hH
  refine ⟨Tree.mapCol (relLabel a) (rest.dropWhile fun x => x.1 == a + k), ?_, ?_⟩
  · conv_lhs => rw [h1]
    rw [treeMapCol_eq_map, treeMapCol_eq_map]
    simp only [List.map_cons, List.map_append, List.map_replicate, relLabel_host]
    rw [Nat.add_comm 1, List.replicate_succ]
    simp [Tree.empty, Tree.map, Tree.mapCols]
  · intro y hy
    rw [treeMapCol_eq_map] at hy
    cases hd : (rest.dropWhile fun x => x.1 == a + k) with
    | nil => rw [hd] at hy; simp at hy
    | cons z zs =>
      rw [hd] at hy h2
      simp only [List.map_cons, List.head?_cons, Option.mem_def, Option.some.injEq] at hy
      subst hy
      have := h2 z (by simp)
      rw [← relLabel_host a k, keyLabelCmp_relLabel]
      exact Nat.compare_eq_lt.2 this

theorem relKey_lt_tower {a : Nat} : ∀ {k : Nat} {J : Forest}, BranchOK a k J →
    ∀ {d m : Nat}, profileAux k J = toLex (d, m) →
      keyCmp (relKey a J) (towKeyAt k (d - k) (m + 1)) = .lt := by
  intro k J hb
  induction hb with
  | @mk k h₀ rest cs hH hrec ih =>
    intro d m hp
    obtain ⟨gs⟩ := h₀
    cases gs with
    | nil =>
      simp only [profileAux] at hp
      obtain ⟨hd, hm⟩ := Prod.mk.inj (toLex.injective hp)
      rw [← hd, ← hm]
      obtain ⟨A, hA, hAh⟩ := mapCol_run a k rest hH
      rw [Nat.sub_self, towKeyAt, keyCmp, relKey_node, Tree.mapCols, Tree.cmp]
      rw [Tree.cmpCols]
      simp only [Tree.empty] at hA ⊢
      rw [hA, List.replicate_succ', cmpCol_rep_append]
      cases A with
      | nil => rfl
      | cons y A =>
        obtain ⟨l, h⟩ := y
        simp only [Tree.cmpCol]
        rw [hAh (l, h) rfl]; rfl
    | cons g gs =>
      have hne : Tree.node (g :: gs) ≠ (Tree.empty : Forest) := by simp [Tree.empty]
      have hp' : profileAux (k + 1) (.node (g :: gs)) = toLex (d, m) := by
        simp only [profileAux] at hp; exact hp
      obtain ⟨d', m', h1, -, h3⟩ := profileAux_branch (hrec hne)
      rw [hp'] at h1; obtain ⟨hd, -⟩ := Prod.mk.inj (toLex.injective h1)
      have ih' := ih hne hp'
      rw [show d - k = (d - (k + 1)) + 1 by omega, towKeyAt, keyCmp, relKey_node, Tree.mapCols,
        Tree.cmp, Tree.cmpCols, Tree.mapCol, Tree.cmpCol, relLabel_host]
      rw [keyCmp, relKey_eq_map] at ih'
      simp only [Std.ReflCmp.compare_self, Ordering.eq_then]
      rw [ih']; rfl

theorem ordering_then_ne_gt {a b : Ordering} (ha : a ≠ .gt) (hb : b ≠ .gt) : a.then b ≠ .gt := by
  cases a <;> simp_all [Ordering.then]

theorem cmpCols_nil_ne_gt {α : Type} (c : α → α → Ordering) (l : List (List (α × Tree α))) :
    Tree.cmpCols c [] l ≠ .gt := by cases l <;> simp [Tree.cmpCols]

theorem cmpCol_nil_ne_gt {α : Type} (c : α → α → Ordering) (l : List (α × Tree α)) :
    Tree.cmpCol c [] l ≠ .gt := by cases l <;> simp [Tree.cmpCol]

theorem tower_le_relKey {a : Nat} : ∀ {k : Nat} {J : Forest}, BranchOK a k J →
    ∀ {d m : Nat}, k ≤ d → (toLex (d, m) : Nat ×ₗ Nat) < profileAux k J →
      keyCmp (towKeyAt k (d - k) (m + 1)) (relKey a J) ≠ .gt := by
  intro k J hb
  induction hb with
  | @mk k h₀ rest cs hH hrec ih =>
    intro d m hkd hp
    obtain ⟨gs⟩ := h₀
    cases gs with
    | nil =>
      simp only [profileAux] at hp
      rw [Prod.Lex.toLex_lt_toLex] at hp
      have hd : d = k := by rcases hp with h | ⟨h, -⟩ <;> omega
      have hm : m < 1 + (rest.takeWhile fun x => x.1 == a + k).length := by
        rcases hp with h | ⟨-, h⟩
        · omega
        · exact h
      subst hd
      obtain ⟨A, hA, -⟩ := mapCol_run a d rest hH
      rw [Nat.sub_self, towKeyAt, keyCmp, relKey_node, Tree.mapCols, Tree.cmp, Tree.cmpCols]
      simp only [Tree.empty] at hA ⊢
      rw [hA]
      obtain ⟨r, hr⟩ : ∃ r, 1 + (rest.takeWhile fun x => x.1 == a + d).length = (m + 1) + r :=
        ⟨_, (Nat.add_sub_cancel' hm).symm⟩
      rw [hr, List.replicate_add (m + 1) r, List.append_assoc]
      have := cmpCol_rep_append keyLabelCmp ((true, d), (Tree.node [] : Key)) (m + 1) []
        (List.replicate r ((true, d), Tree.node []) ++ A)
      rw [List.append_nil] at this
      rw [this]
      exact ordering_then_ne_gt (cmpCol_nil_ne_gt _ _) (cmpCols_nil_ne_gt _ _)
    | cons g gs =>
      have hne : Tree.node (g :: gs) ≠ (Tree.empty : Forest) := by simp [Tree.empty]
      have hp' : (toLex (d, m) : Nat ×ₗ Nat) < profileAux (k + 1) (.node (g :: gs)) := by
        simp only [profileAux] at hp; exact hp
      rcases Nat.eq_or_lt_of_le hkd with rfl | hlt
      · rw [Nat.sub_self, towKeyAt, keyCmp, relKey_node, Tree.mapCols, Tree.cmp, Tree.cmpCols,
          List.replicate_succ, Tree.mapCol, Tree.cmpCol, relLabel_host]
        simp only [Std.ReflCmp.compare_self, Ordering.eq_then]
        have : Tree.cmp keyLabelCmp (Tree.empty : Key) (Tree.map (relLabel a) (.node (g :: gs))) = .lt := by
          simp [Tree.empty, Tree.map, Tree.mapCols, Tree.cmp, Tree.cmpCols]
        rw [this]; simp [Ordering.then]
      · have ih' := ih hne (by omega) hp'
        rw [show d - k = (d - (k + 1)) + 1 by omega, towKeyAt, keyCmp, relKey_node, Tree.mapCols,
          Tree.cmp, Tree.cmpCols, Tree.mapCol, Tree.cmpCol, relLabel_host]
        rw [keyCmp, relKey_eq_map] at ih'
        simp only [Std.ReflCmp.compare_self, Ordering.eq_then]
        exact ordering_then_ne_gt (ordering_then_ne_gt ih' (cmpCol_nil_ne_gt _ _))
          (cmpCols_nil_ne_gt _ _)

theorem heightAt_of_entryAt {E : Forest} {e : EntryAddr} {p : Nat} {J : Forest}
    (h : E.entryAt e = some (p, J)) : E.heightAt e = some J := by
  simp [Tree.heightAt, h]

/-- helper: the first column and first entry of the height of `f`. -/
theorem first_of_height {E : Forest} {f : EntryAddr} {cols : List Column} {col0 : Column}
    (hf : E.heightAt f = some (.node cols)) (h0 : cols[0]? = some col0) :
    E.colAt ⟨f.heightPath, 0⟩ = some col0 := by
  simp only [Tree.colAt]
  rw [Tree.forestAt_heightPath, hf]; exact h0

theorem num_heightPath (f : EntryAddr) (j : Nat) :
    ColAddr.num 0 ⟨f.heightPath, j⟩ = f.col.num 0 + 1 + j := by
  simp [ColAddr.num, EntryAddr.heightPath]; omega

theorem branchOK_of_height {E : Forest} (hV : CondV E) (hI : CondI E) (hH : CondH E) (a : Nat) :
    ∀ (J : Forest) (f : EntryAddr) (k : Nat), E.heightAt f = some J → f.col.num 0 = a + k →
      J ≠ Tree.empty → BranchOK a k J
  | .node [], _, _, _, _, hne => absurd rfl hne
  | .node ([] :: cs), f, k, hf, _, hne => by
    exfalso
    obtain ⟨x, hx⟩ : ∃ x, E.entryAt f = some x := by
      simp only [Tree.heightAt, Option.map_eq_some_iff] at hf
      obtain ⟨x, hx, -⟩ := hf; exact ⟨x, hx⟩
    obtain ⟨p, H⟩ := x
    have hHJ : H = .node ([] :: cs) := by
      rw [heightAt_of_entryAt hx] at hf; exact Option.some.inj hf
    subst hHJ
    obtain ⟨q, H', rest, h, -⟩ := hI f ((Tree.mem_entryAddrs_iff E f).2 (by rw [hx]; rfl)) p _ hx hne
      [] (by simp [Tree.cols])
    simp at h
  | .node (((q₀, h₀) :: rest) :: cs), f, k, hf, hn, hne => by
    obtain ⟨x, hx⟩ : ∃ x, E.entryAt f = some x := by
      simp only [Tree.heightAt, Option.map_eq_some_iff] at hf
      obtain ⟨x, hx, -⟩ := hf; exact ⟨x, hx⟩
    obtain ⟨p, H⟩ := x
    have hHJ : H = .node (((q₀, h₀) :: rest) :: cs) := by
      rw [heightAt_of_entryAt hx] at hf; exact Option.some.inj hf
    subst hHJ
    have hfm : f ∈ E.entryAddrs := (Tree.mem_entryAddrs_iff E f).2 (by rw [hx]; rfl)
    obtain ⟨q, H', rest', h, hq⟩ := hI f hfm p _ hx hne ((q₀, h₀) :: rest) (by simp [Tree.cols])
    simp only [List.cons.injEq, Prod.mk.injEq] at h
    obtain ⟨⟨rfl, rfl⟩, rfl⟩ := h
    have hcol := first_of_height (col0 := (q₀, h₀) :: rest) hf (by simp)
    let f₀ : EntryAddr := ⟨⟨f.heightPath, 0⟩, 0⟩
    have he₀ : E.entryAt f₀ = some (q₀, h₀) := by simp [f₀, Tree.entryAt, hcol]
    have hf₀ : f₀ ∈ E.entryAddrs := (Tree.mem_entryAddrs_iff E f₀).2 (by rw [he₀]; rfl)
    have hv := (ColAddr.resolve_isSome_iff 0 f₀.col q₀).1 (hV f₀ hf₀ q₀ h₀ he₀)
    have hnum : f₀.col.num 0 = f.col.num 0 + 1 := by simpa [f₀] using num_heightPath f 0
    have hqa : q₀ = a + k := by omega
    subst hqa
    refine BranchOK.mk ?_ ?_
    · intro i x y hx' hy'
      have hc : f₀.col ∈ E.colAddrs := (Tree.mem_colAddrs_iff E f₀.col).2 (by rw [hcol]; rfl)
      exact hH f₀.col hc i x y (by rw [hcol]; exact hx') (by rw [hcol]; exact hy')
    · intro hne'
      exact branchOK_of_height hV hI hH a h₀ f₀ (k + 1) (heightAt_of_entryAt he₀)
        (by rw [hnum, hn]; omega) hne'

theorem profileAux_of_height {E : Forest} (hI : CondI E) :
    ∀ (J : Forest) (f : EntryAddr) (k : Nat), E.heightAt f = some J → J ≠ Tree.empty →
      ∃ d m, profileAux k J = toLex (d, m) ∧ 1 ≤ m
  | .node [], _, _, _, hne => absurd rfl hne
  | .node ([] :: cs), f, k, hf, hne => by
    exfalso
    obtain ⟨x, hx⟩ : ∃ x, E.entryAt f = some x := by
      simp only [Tree.heightAt, Option.map_eq_some_iff] at hf
      obtain ⟨x, hx, -⟩ := hf; exact ⟨x, hx⟩
    obtain ⟨p, H⟩ := x
    have hHJ : H = .node ([] :: cs) := by
      rw [heightAt_of_entryAt hx] at hf; exact Option.some.inj hf
    subst hHJ
    obtain ⟨q, H', rest, h, -⟩ := hI f ((Tree.mem_entryAddrs_iff E f).2 (by rw [hx]; rfl)) p _ hx hne
      [] (by simp [Tree.cols])
    simp at h
  | .node (((q₀, h₀) :: rest) :: cs), f, k, hf, hne => by
    obtain ⟨gs⟩ := h₀
    cases gs with
    | nil => exact ⟨k, 1 + (rest.takeWhile fun x => x.1 == q₀).length, by simp [profileAux], by omega⟩
    | cons g gs =>
      have hcol := first_of_height (col0 := (q₀, .node (g :: gs)) :: rest) hf (by simp)
      let f₀ : EntryAddr := ⟨⟨f.heightPath, 0⟩, 0⟩
      have he₀ : E.entryAt f₀ = some (q₀, .node (g :: gs)) := by simp [f₀, Tree.entryAt, hcol]
      obtain ⟨d, m, h1, h2⟩ := profileAux_of_height hI (.node (g :: gs)) f₀ (k + 1)
        (heightAt_of_entryAt he₀) (by simp [Tree.empty])
      exact ⟨d, m, by simp only [profileAux]; exact h1, h2⟩

theorem profile_of_ne {J : Forest} (h : J ≠ Tree.empty) :
    profile J = ((profileAux 0 J : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by
  obtain ⟨cols⟩ := J
  cases cols with
  | nil => exact absurd rfl h
  | cons c cs => rfl

-- L3.1b (txt:265-266, G-002: needs V, I, H): the first-entry branch of a nonempty height is a
-- pure tower; `h_a(J)` is strictly below the tower with one more terminal entry
theorem relKey_lt_towKey {E : Forest} (hV : CondV E) (hI : CondI E) (hH : CondH E)
    {e : EntryAddr} {p : Nat} {J : Forest} (he : E.entryAt e = some (p, J)) (hJ : J ≠ Tree.empty)
    {d m : Nat} (hπ : profile J = ((toLex (d, m) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat))) :
    relKey (e.col.num 0) J < towKey d (m + 1) := by
  rw [profile_of_ne hJ, WithBot.coe_inj] at hπ
  have hb := branchOK_of_height hV hI hH (e.col.num 0) J e 0 (heightAt_of_entryAt he) rfl hJ
  have := relKey_lt_tower hb hπ
  rw [Nat.sub_zero] at this
  exact this


-- L3.1b: and above every tower of smaller profile
theorem towKey_le_relKey {E : Forest} (hV : CondV E) (hI : CondI E) (hH : CondH E)
    {e : EntryAddr} {p : Nat} {H : Forest} (he : E.entryAt e = some (p, H)) {d m : Nat}
    (hπ : ((toLex (d, m) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) < profile H) :
    towKey d (m + 1) ≤ relKey (e.col.num 0) H := by
  have hH0 : H ≠ Tree.empty := by
    rintro rfl; exact absurd hπ (by simp [profile, profileBody, Tree.empty])
  rw [profile_of_ne hH0, WithBot.coe_lt_coe] at hπ
  have hb := branchOK_of_height hV hI hH (e.col.num 0) H e 0 (heightAt_of_entryAt he) rfl hH0
  have := tower_le_relKey hb (Nat.zero_le d) hπ
  rw [Nat.sub_zero] at this
  exact this


-- L3.1b: profiles of I-legal nonempty heights are `(d, m)` with `m ≥ 1`
theorem profile_of_entry {E : Forest} (hI : CondI E) {e : EntryAddr} {p : Nat} {J : Forest}
    (he : E.entryAt e = some (p, J)) (hJ : J ≠ Tree.empty) :
    ∃ d m, 1 ≤ m ∧ profile J = ((toLex (d, m) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by
  obtain ⟨d, m, h1, h2⟩ := profileAux_of_height hI J e 0 (heightAt_of_entryAt he) hJ
  exact ⟨d, m, h2, by rw [profile_of_ne hJ, h1]⟩

/-- helper: the height of an entry that contains another entry's column is nonempty. -/
theorem height_ne_of_contains {E : Forest} {e₀ e : EntryAddr} (hc : e₀.heightPath <+: e.col.path)
    (he : (E.entryAt e).isSome) :
    ∃ H, E.heightAt e₀ = some H ∧ H ≠ Tree.empty := by
  obtain ⟨rest, hrest⟩ := hc
  simp only [Tree.entryAt, Option.isSome_iff_exists, Option.bind_eq_some_iff] at he
  obtain ⟨x, col, hcol, -⟩ := he
  simp only [Tree.colAt, Option.bind_eq_some_iff] at hcol
  obtain ⟨G, hG, hGc⟩ := hcol
  rw [← hrest, Tree.forestAt_append, Tree.forestAt_heightPath, Option.bind_eq_some_iff] at hG
  obtain ⟨H, hH, hG⟩ := hG
  refine ⟨H, hH, ?_⟩
  rintro rfl
  cases rest with
  | nil =>
    rw [forestAt_nil_path] at hG; obtain rfl := Option.some.inj hG
    simp [Tree.empty, Tree.cols] at hGc
  | cons x rest => rw [forestAt_empty_node_cons] at hG; simp at hG

-- provides: U2, L3.1a (G-002: `V ∧ I ∧ H ∧ P ⇒ S`). Moved here from `Plan/Spine.lean` (brief rule 5):
-- its proof needs L3.1b; nothing in between uses it.
theorem condS_of_condP {E : Forest} (hV : Scan.CondV E) (hI : Scan.CondI E) (hH : Scan.CondH E)
    (hP : CondP E) : Scan.CondS E := by
  intro e₀ he₀ e he hown
  have hP' := hP e₀ he₀ e he hown
  obtain ⟨hc, q, J, hJ, -⟩ := hown
  obtain ⟨H, hHe, hHne⟩ := height_ne_of_contains hc (by rw [hJ]; rfl)
  obtain ⟨p₀, hp₀⟩ : ∃ p₀, E.entryAt e₀ = some (p₀, H) := by
    simp only [Tree.heightAt, Option.map_eq_some_iff] at hHe
    obtain ⟨⟨p₀, H'⟩, h1, h2⟩ := hHe
    exact ⟨p₀, by simp only at h2; rw [h1, h2]⟩
  rw [hHe, Option.getD_some] at hP' ⊢
  rw [heightAt_of_entryAt hJ, Option.getD_some] at hP' ⊢
  by_cases hJ0 : J = Tree.empty
  · subst hJ0
    obtain ⟨cols⟩ := H
    cases cols with
    | nil => exact absurd rfl hHne
    | cons c cs => rfl
  · obtain ⟨d, m, -, hπ⟩ := profile_of_entry hI hJ hJ0
    rw [hπ] at hP'
    exact lt_of_lt_of_le (relKey_lt_towKey hV hI hH hJ hJ0 hπ) (towKey_le_relKey hV hI hH hp₀ hP')


/-! ### L3.1c helpers: words of literal caps -/

theorem wordLater_append' (e : Nat) (l₁ l₂ : Column) :
    wordLater e (l₁ ++ l₂) = wordLater e l₁ ++ wordLater e l₂ := by
  induction l₁ with
  | nil => rfl
  | cons x l ih => obtain ⟨p, h⟩ := x; simp only [List.cons_append, wordLater, ih, List.append_assoc]

theorem wordCol_append' (e : Nat) {l₁ : Column} (h : l₁ ≠ []) (l₂ : Column) :
    wordCol e (l₁ ++ l₂) = wordCol e l₁ ++ wordLater e l₂ := by
  cases l₁ with
  | nil => exact absurd rfl h
  | cons x l => obtain ⟨p, h⟩ := x; simp only [List.cons_append, wordCol, wordLater_append', List.append_assoc]

theorem wordAt_empty (e : Nat) : wordAt e (Tree.empty : Forest) = [] := by
  simp [Tree.empty, wordAt, wordCols]

/-- helper: the atom of the `k`-th entry with parent `p` of a column at depth `d`. -/
def capAtomAt (d k p : Nat) : WordAtom :=
  if k = 0 then toLex (2 * d, toLex (1, p)) else toLex (2 * d + 1, toLex (0, p))

theorem wordCol_take_snoc (e : Nat) (col : Column) (k p : Nat) (hk : k ≤ col.length) :
    wordCol e (col.take k ++ [(p, Tree.empty)]) =
      (if k = 0 then [] else wordCol e (col.take k)) ++ [capAtomAt e k p] := by
  unfold capAtomAt
  by_cases hk0 : k = 0
  · subst hk0; simp [wordCol, wordAt_empty, wordLater]
  · rw [if_neg hk0, if_neg hk0]
    have hc : col.take k ≠ [] := by
      rw [ne_eq, List.take_eq_nil_iff]; rintro (h | rfl) <;> simp_all
    rw [wordCol_append' e hc]; simp [wordLater, wordAt_empty]

/-- helper: the next atom of `w(E)` after the part kept by a cap at `(col, k)` at depth `d`. -/
def NextAtom (d k : Nat) (col : Column) (R : List WordAtom) : Prop :=
  (∀ q h, col[k]? = some (q, h) → R.head? = some (capAtomAt d k q)) ∧
  (k = col.length → k ≠ 0 → ∀ y ∈ R.head?, (ofLex y).1 ≤ 2 * d) ∧
  (k = col.length → k = 0 → R.head? = some (toLex (2 * d, toLex (0, 0))))

theorem wordCols_cons' (e : Nat) (col : Column) (rest : List Column) :
    wordCols e (col :: rest) = wordCol e col ++ wordCols e rest := rfl

theorem wordCols_split (e : Nat) {cols : List Column} {j : Nat} {col : Column}
    (h : cols[j]? = some col) :
    wordCols e cols = wordCols e (cols.take j) ++ wordCol e col ++ wordCols e (cols.drop (j + 1)) := by
  have hj : j < cols.length := (List.getElem?_eq_some_iff.1 h).1
  conv_lhs => rw [← List.take_append_drop j cols, List.drop_eq_getElem_cons hj]
  rw [wordCols_append, wordCols_cons', (List.getElem?_eq_some_iff.1 h).2, List.append_assoc]

theorem head_wordCols_fst (e : Nat) (cols : List Column) :
    ∀ y ∈ (wordCols e cols).head?, (ofLex y).1 ≤ 2 * e := by
  intro y hy
  cases cols with
  | nil => simp [wordCols] at hy
  | cons col rest =>
    cases col with
    | nil => simp [wordCols, wordCol] at hy; subst hy; simp
    | cons x l => obtain ⟨p, h⟩ := x; simp [wordCols, wordCol] at hy; subst hy; simp

theorem head_wordLater_fst (e : Nat) (l : Column) :
    ∀ y ∈ (wordLater e l).head?, (ofLex y).1 ≤ 2 * e + 1 := by
  intro y hy
  cases l with
  | nil => simp [wordLater] at hy
  | cons x l => obtain ⟨p, h⟩ := x; simp [wordLater] at hy; subst hy; simp

/-- helper (L3.1c): the word of a literal cap is a prefix of the word plus one atom. -/
theorem wordAt_litCapAux (k : Nat) :
    ∀ (ρ : List (Nat × Nat)) (j : Nat) (F : Forest) (col : Column) (e : Nat),
      F.colAt ⟨ρ, j⟩ = some col → k ≤ col.length →
      ∃ P R, wordAt e F = P ++ R ∧
        (∀ p, wordAt e (litCapAux k p ρ j F) = P ++ [capAtomAt (e + ρ.length) k p]) ∧
        NextAtom (e + ρ.length) k col R
  | [], j, .node cols, col, e, hcol, hk => by
    rw [colAt_node_nil] at hcol
    refine ⟨wordCols e (cols.take j) ++ (if k = 0 then [] else wordCol e (col.take k)),
      (if k = 0 then wordCol e col else wordLater e (col.drop k)) ++ wordCols e (cols.drop (j + 1)),
      ?_, ?_, ?_⟩
    · rw [wordAt, wordCols_split e hcol]
      by_cases hk0 : k = 0
      · simp [hk0]
      · rw [if_neg hk0, if_neg hk0]
        have hc : col.take k ≠ [] := by
          rw [ne_eq, List.take_eq_nil_iff]; rintro (h | rfl) <;> simp_all
        conv_lhs => rw [← List.take_append_drop k col, wordCol_append' e hc]
        simp only [List.append_assoc]
    · intro p
      simp only [litCapAux, List.getD_eq_getElem?_getD, hcol, Option.getD_some, wordAt,
        wordCols_append, wordCols_cons', wordCols, List.append_nil, List.length_nil, Nat.add_zero]
      rw [wordCol_take_snoc e col k p hk, List.append_assoc]
    · simp only [List.length_nil, Nat.add_zero]
      refine ⟨fun q h hq => ?_, fun hkl hk0 y hy => ?_, fun hkl hk0 => ?_⟩
      · by_cases hk0 : k = 0
        · subst hk0
          cases col with
          | nil => simp at hq
          | cons x l =>
            simp at hq; subst hq
            simp [wordCol, capAtomAt]
        · rw [if_neg hk0, List.drop_eq_getElem_cons (List.getElem?_eq_some_iff.1 hq).1,
            (List.getElem?_eq_some_iff.1 hq).2]
          simp [wordLater, capAtomAt, hk0]
      · rw [if_neg hk0, hkl, List.drop_length] at hy
        exact head_wordCols_fst e _ y (by simpa [wordLater] using hy)
      · subst hk0
        have : col = [] := List.eq_nil_of_length_eq_zero hkl.symm
        subst this
        simp [wordCol]
  | (ci, ei) :: ρ, j, .node cols, col, e, hcol, hk => by
    rw [colAt_node_cons] at hcol
    obtain ⟨x, hx, hcolx⟩ := Option.bind_eq_some_iff.1 hcol
    obtain ⟨colc, hc, hx'⟩ := Option.bind_eq_some_iff.1 hx
    obtain ⟨q, H⟩ := x
    obtain ⟨P', R', hw, hcap, hnext⟩ := wordAt_litCapAux k ρ j H col (e + 1) hcolx hk
    have hei : ei < colc.length := (List.getElem?_eq_some_iff.1 hx').1
    refine ⟨wordCols e (cols.take ci) ++ wordCol e (colc.take ei ++ [(q, Tree.empty)]) ++ P',
      R' ++ wordLater e (colc.drop (ei + 1)) ++ wordCols e (cols.drop (ci + 1)), ?_, ?_, ?_⟩
    · rw [wordAt, wordCols_split e hc]
      have hne : colc.take ei ++ [(q, H)] ≠ [] := by simp
      have hsplit : colc = (colc.take ei ++ [(q, H)]) ++ colc.drop (ei + 1) := by
        conv_lhs => rw [← List.take_append_drop ei colc, List.drop_eq_getElem_cons hei]
        rw [(List.getElem?_eq_some_iff.1 hx').2]; simp
      conv_lhs => rw [hsplit, wordCol_append' e hne, wordCol_snoc, hw]
      simp only [List.append_assoc]
    · intro p
      simp only [litCapAux, List.getD_eq_getElem?_getD, hc, Option.getD_some, hx', wordAt,
        wordCols_append, wordCols_cons', wordCols, List.append_nil]
      rw [wordCol_snoc, ← wordAt, hcap p]
      simp only [List.append_assoc, List.length_cons]
      rw [show e + (ρ.length + 1) = e + 1 + ρ.length by omega]
    · have he : e + ((ci, ei) :: ρ).length = e + 1 + ρ.length := by simp; omega
      rw [he]
      obtain ⟨h1, h2, h3⟩ := hnext
      refine ⟨fun q' h' hq => ?_, fun hkl hk0 y hy => ?_, fun hkl hk0 => ?_⟩
      · obtain ⟨z, zs, hz⟩ : ∃ z zs, R' = z :: zs := by
          have := h1 q' h' hq; cases R' with
          | nil => simp at this
          | cons z zs => exact ⟨z, zs, rfl⟩
        have := h1 q' h' hq; rw [hz] at this ⊢; simpa using this
      · cases R' with
        | nil =>
          simp only [List.nil_append] at hy
          cases hl : colc.drop (ei + 1) with
          | nil =>
            rw [hl] at hy
            have := head_wordCols_fst e _ y (by simpa [wordLater] using hy); omega
          | cons z zs =>
            rw [hl] at hy
            obtain ⟨pz, hz⟩ := z
            simp only [wordLater, List.cons_append, List.head?_cons, Option.mem_def,
              Option.some.injEq] at hy
            subst hy; simp; omega
        | cons z zs =>
          simp only [List.cons_append, List.head?_cons, Option.mem_def, Option.some.injEq] at hy
          exact h2 hkl hk0 y (by simp [hy])
      · have := h3 hkl hk0
        cases R' with
        | nil => simp at this
        | cons z zs => simpa using this

theorem capAtom_eq (c : ColAddr) (k p : Nat) : capAtom c k p = capAtomAt (colDepth c) k p := rfl

theorem capAtomAt_lt_iff (d k q p : Nat) : capAtomAt d k q < capAtomAt d k p ↔ q < p := by
  unfold capAtomAt; split_ifs <;> simp [Prod.Lex.toLex_lt_toLex]

/-- helper (L3.1c): the word data of a literal cap at a column `col` of `E`. -/
theorem litCap_word_data {E : Forest} {c : ColAddr} {col : Column} (hcol : E.colAt c = some col)
    {k : Nat} (hk : k ≤ col.length) :
    ∃ R, word E = (word E).take (capPos E c k) ++ R ∧
      (∀ p, word (litCap E c k p) = (word E).take (capPos E c k) ++ [capAtom c k p]) ∧
      NextAtom (colDepth c) k col R ∧ capPos E c k ≤ (word E).length := by
  obtain ⟨P, R, hw, hcap, hnext⟩ := wordAt_litCapAux k c.path c.col E col 0 hcol hk
  have hcap' : ∀ p, word (litCap E c k p) = P ++ [capAtom c k p] := by
    intro p; rw [litCap_eq_aux hcol, word, hcap p, capAtom_eq, colDepth, Nat.zero_add]
  have hpos : capPos E c k = P.length := by simp [capPos, hcap' 0]
  have htake : (word E).take (capPos E c k) = P := by
    rw [hpos, word, hw, List.take_left]
  refine ⟨R, ?_, ?_, ?_, ?_⟩
  · rw [htake]; exact hw
  · intro p; rw [htake]; exact hcap' p
  · rw [colDepth]; simpa using hnext
  · rw [hpos, word, hw]; simp

theorem upward_of_nextAtom {d k p : Nat} {col : Column} {R : List WordAtom} (h : NextAtom d k col R)
    (hk : k ≤ col.length) (hup : ∀ q h, col[k]? = some (q, h) → q < p) :
    ∀ y, R.head? = some y → y < capAtomAt d k p := by
  intro y hy
  obtain ⟨h1, h2, h3⟩ := h
  cases hc : col[k]? with
  | some x =>
    obtain ⟨q, H⟩ := x
    rw [h1 q H hc] at hy
    obtain rfl := Option.some.inj hy
    exact (capAtomAt_lt_iff d k q p).2 (hup q H hc)
  | none =>
    have hkl : k = col.length := le_antisymm hk (List.getElem?_eq_none_iff.1 hc)
    by_cases hk0 : k = 0
    · rw [h3 hkl hk0] at hy
      obtain rfl := Option.some.inj hy
      simp [capAtomAt, hk0, Prod.Lex.toLex_lt_toLex]
    · have := h2 hkl hk0 y hy
      unfold capAtomAt; rw [if_neg hk0, Prod.Lex.lt_iff]; left; simp; omega

-- provides: U2, L3.1c (a literal cap is a safe prefix of `w(E)` followed by one atom)
theorem word_litCap {E : Forest} {c : ColAddr} {k : Nat} (hc : c ∈ E.colAddrs)
    (hk : k ≤ ((E.colAt c).getD []).length) (p : Nat) :
    word (litCap E c k p) = (word E).take (capPos E c k) ++ [capAtom c k p] := by
  obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff E c).1 hc)
  rw [hcol, Option.getD_some] at hk
  obtain ⟨R, -, hcap, -⟩ := litCap_word_data hcol hk
  exact hcap p


-- L3.1c: upwardness is "the appended atom beats the next atom of `w(E)`"
theorem isUpward_iff_atom {E : Forest} {c : ColAddr} {k p : Nat} (hc : c ∈ E.colAddrs)
    (hk : k ≤ ((E.colAt c).getD []).length) :
    IsUpward E c k p ↔ ∀ y, (word E)[capPos E c k]? = some y → y < capAtom c k p := by
  obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff E c).1 hc)
  rw [hcol, Option.getD_some] at hk
  obtain ⟨R, hw, -, hnext, hle⟩ := litCap_word_data hcol hk
  have hat : (word E)[capPos E c k]? = R.head? := by
    have hl : ((word E).take (capPos E c k)).length = capPos E c k := List.length_take_of_le hle
    conv_lhs => rw [hw]
    rw [List.getElem?_append_right (by omega), hl, Nat.sub_self, List.head?_eq_getElem?]
  rw [hat, capAtom_eq]
  constructor
  · intro hup
    obtain ⟨col', hcol', -, hq⟩ := isUpward_iff_exists.1 hup
    rw [hcol] at hcol'; obtain rfl := Option.some.inj hcol'
    exact upward_of_nextAtom hnext hk hq
  · intro h
    refine isUpward_iff_exists.2 ⟨col, hcol, hk, fun q H hq => ?_⟩
    have := h _ (hnext.1 q H hq)
    exact (capAtomAt_lt_iff _ _ _ _).1 this


-- L3.1c: an upward cap is strictly larger
theorem lt_litCap {E : Forest} {c : ColAddr} {k p : Nat} (h : IsUpward E c k p) :
    E < litCap E c k p := by
  obtain ⟨col, hcol, hk, hq⟩ := isUpward_iff_exists.1 h
  obtain ⟨R, hw, hcap, hnext, -⟩ := litCap_word_data hcol hk
  rw [← word_lt_iff, hcap p]
  conv_lhs => rw [hw]
  apply List.append_left_lt
  have hat := upward_of_nextAtom hnext hk hq
  cases R with
  | nil => exact List.nil_lt_cons _ _
  | cons y R => exact List.cons_lt_cons_iff.2 (Or.inl (by rw [capAtom_eq]; exact hat y rfl))


/-! ### N2.1 helpers: unique decoding of words -/

mutual
theorem wordAt_fst_ge : ∀ (e : Nat) (F : Forest), ∀ y ∈ wordAt e F, 2 * e ≤ (ofLex y).1
  | e, .node cols => wordCols_fst_ge e cols
theorem wordCols_fst_ge : ∀ (e : Nat) (cols : List Column), ∀ y ∈ wordCols e cols, 2 * e ≤ (ofLex y).1
  | _, [] => by simp [wordCols]
  | e, col :: rest => by
    intro y hy
    rw [wordCols_cons', List.mem_append] at hy
    rcases hy with hy | hy
    · exact wordCol_fst_ge e col y hy
    · exact wordCols_fst_ge e rest y hy
theorem wordCol_fst_ge : ∀ (e : Nat) (col : Column), ∀ y ∈ wordCol e col, 2 * e ≤ (ofLex y).1
  | e, [] => by intro y hy; simp [wordCol] at hy; subst hy; simp
  | e, (p, h) :: rest => by
    intro y hy
    simp only [wordCol, List.mem_cons, List.mem_append] at hy
    rcases hy with rfl | hy | hy
    · simp
    · have := wordAt_fst_ge (e + 1) h y hy; omega
    · have := wordLater_fst_ge e rest y hy; omega
theorem wordLater_fst_ge : ∀ (e : Nat) (col : Column), ∀ y ∈ wordLater e col, 2 * e + 1 ≤ (ofLex y).1
  | _, [] => by simp [wordLater]
  | e, (p, h) :: rest => by
    intro y hy
    simp only [wordLater, List.mem_cons, List.mem_append] at hy
    rcases hy with rfl | hy | hy
    · simp
    · have := wordAt_fst_ge (e + 1) h y hy; omega
    · exact wordLater_fst_ge e rest y hy
end

/-- helper: every head of `X` has depth coordinate `≤ b`. -/
def HeadLe (b : Nat) (X : List WordAtom) : Prop := ∀ y ∈ X.head?, (ofLex y).1 ≤ b

theorem headLe_append_of_ne {b : Nat} {X : List WordAtom} (Y : List WordAtom) (hX : X ≠ [])
    (h : HeadLe b X) : HeadLe b (X ++ Y) := by
  cases X with
  | nil => exact absurd rfl hX
  | cons x X => intro y hy; exact h y (by simpa using hy)

theorem headLe_append {b : Nat} {X Y : List WordAtom} (hX : HeadLe b X) (hY : HeadLe b Y) :
    HeadLe b (X ++ Y) := by
  cases X with
  | nil => simpa using hY
  | cons x X => intro y hy; exact hX y (by simpa using hy)

theorem headLe_mono {a b : Nat} {X : List WordAtom} (h : HeadLe a X) (hab : a ≤ b) : HeadLe b X :=
  fun y hy => le_trans (h y hy) hab

theorem headLe_wordCols (e : Nat) (cols : List Column) : HeadLe (2 * e) (wordCols e cols) :=
  head_wordCols_fst e cols

theorem headLe_wordLater (e : Nat) (l : Column) : HeadLe (2 * e + 1) (wordLater e l) :=
  head_wordLater_fst e l

theorem headLe_wordCol (e : Nat) (col : Column) : HeadLe (2 * e) (wordCol e col) := by
  intro y hy
  cases col with
  | nil => simp [wordCol] at hy; subst hy; simp
  | cons x l => obtain ⟨p, h⟩ := x; simp [wordCol] at hy; subst hy; simp

theorem headLe_cons_iff {b : Nat} {x : WordAtom} {X : List WordAtom} :
    HeadLe b (x :: X) ↔ (ofLex x).1 ≤ b := by simp [HeadLe]

mutual
theorem decode_forest : ∀ (e : Nat) (F₁ F₂ : Forest) (X₁ X₂ : List WordAtom),
    HeadLe (2 * e - 1) X₁ → (X₁ ≠ [] → 0 < e) → HeadLe (2 * e - 1) X₂ → (X₂ ≠ [] → 0 < e) →
    wordAt e F₁ ++ X₁ = wordAt e F₂ ++ X₂ → F₁ = F₂ ∧ X₁ = X₂
  | e, .node l₁, .node l₂, X₁, X₂, h₁, h₁', h₂, h₂', h => by
    obtain ⟨rfl, rfl⟩ := decode_cols e l₁ l₂ X₁ X₂ h₁ h₁' h₂ h₂' h
    exact ⟨rfl, rfl⟩
theorem decode_cols : ∀ (e : Nat) (l₁ l₂ : List Column) (X₁ X₂ : List WordAtom),
    HeadLe (2 * e - 1) X₁ → (X₁ ≠ [] → 0 < e) → HeadLe (2 * e - 1) X₂ → (X₂ ≠ [] → 0 < e) →
    wordCols e l₁ ++ X₁ = wordCols e l₂ ++ X₂ → l₁ = l₂ ∧ X₁ = X₂
  | _, [], [], _, _, _, _, _, _, h => ⟨rfl, by simpa [wordCols] using h⟩
  | e, [], c :: l, X₁, X₂, h₁, h₁', _, _, h => by
    exfalso
    have hne : wordCol e c ≠ [] := by cases c <;> simp [wordCol]
    have hX : X₁ ≠ [] := by
      rintro rfl; simp [wordCols] at h; exact hne h.1
    obtain ⟨x, X, rfl⟩ := List.exists_cons_of_ne_nil hX
    have hl := headLe_wordCol e c
    obtain ⟨y, Y, hy⟩ := List.exists_cons_of_ne_nil hne
    rw [hy] at hl
    simp only [wordCols, List.nil_append, wordCols_cons', hy, List.cons_append, List.cons.injEq] at h
    have h1 := (headLe_cons_iff.1 h₁)
    have h2 : 2 * e ≤ (ofLex y).1 := wordCol_fst_ge e c y (by rw [hy]; simp)
    rw [h.1] at h1; have := h₁' (by simp); omega
  | e, c :: l, [], X₁, X₂, _, _, h₂, h₂', h => by
    exfalso
    have hne : wordCol e c ≠ [] := by cases c <;> simp [wordCol]
    have hX : X₂ ≠ [] := by
      rintro rfl; simp [wordCols] at h; exact hne h.1
    obtain ⟨x, X, rfl⟩ := List.exists_cons_of_ne_nil hX
    obtain ⟨y, Y, hy⟩ := List.exists_cons_of_ne_nil hne
    simp only [wordCols, List.nil_append, wordCols_cons', hy, List.cons_append, List.cons.injEq] at h
    have h1 := (headLe_cons_iff.1 h₂)
    have h2 : 2 * e ≤ (ofLex y).1 := wordCol_fst_ge e c y (by rw [hy]; simp)
    rw [← h.1] at h1; have := h₂' (by simp); omega
  | e, c₁ :: l₁, c₂ :: l₂, X₁, X₂, h₁, h₁', h₂, h₂', h => by
    simp only [wordCols_cons', List.append_assoc] at h
    have hc₁ : HeadLe (2 * e) (wordCols e l₁ ++ X₁) :=
      headLe_append (headLe_wordCols e l₁) (headLe_mono h₁ (by omega))
    have hc₂ : HeadLe (2 * e) (wordCols e l₂ ++ X₂) :=
      headLe_append (headLe_wordCols e l₂) (headLe_mono h₂ (by omega))
    obtain ⟨rfl, h'⟩ := decode_col e c₁ c₂ _ _ hc₁ hc₂ h
    obtain ⟨rfl, rfl⟩ := decode_cols e l₁ l₂ X₁ X₂ h₁ h₁' h₂ h₂' h'
    exact ⟨rfl, rfl⟩
theorem decode_col : ∀ (e : Nat) (c₁ c₂ : Column) (X₁ X₂ : List WordAtom),
    HeadLe (2 * e) X₁ → HeadLe (2 * e) X₂ →
    wordCol e c₁ ++ X₁ = wordCol e c₂ ++ X₂ → c₁ = c₂ ∧ X₁ = X₂
  | _, [], [], _, _, _, _, h => ⟨rfl, by simpa [wordCol] using h⟩
  | e, [], (p, H) :: l, _, _, _, _, h => by simp [wordCol] at h
  | e, (p, H) :: l, [], _, _, _, _, h => by simp [wordCol] at h
  | e, (p₁, H₁) :: l₁, (p₂, H₂) :: l₂, X₁, X₂, h₁, h₂, h => by
    simp only [wordCol, List.cons_append, List.cons.injEq, List.append_assoc] at h
    obtain ⟨hp, h⟩ := h
    have hp' : p₁ = p₂ := by simpa using hp
    subst hp'
    have hc₁ : HeadLe (2 * (e + 1) - 1) (wordLater e l₁ ++ X₁) :=
      headLe_append (headLe_mono (headLe_wordLater e l₁) (by omega)) (headLe_mono h₁ (by omega))
    have hc₂ : HeadLe (2 * (e + 1) - 1) (wordLater e l₂ ++ X₂) :=
      headLe_append (headLe_mono (headLe_wordLater e l₂) (by omega)) (headLe_mono h₂ (by omega))
    obtain ⟨rfl, h'⟩ := decode_forest (e + 1) H₁ H₂ _ _ hc₁ (fun _ => by omega) hc₂ (fun _ => by omega) h
    obtain ⟨rfl, rfl⟩ := decode_later e l₁ l₂ X₁ X₂ h₁ h₂ h'
    exact ⟨rfl, rfl⟩
theorem decode_later : ∀ (e : Nat) (l₁ l₂ : Column) (X₁ X₂ : List WordAtom),
    HeadLe (2 * e) X₁ → HeadLe (2 * e) X₂ →
    wordLater e l₁ ++ X₁ = wordLater e l₂ ++ X₂ → l₁ = l₂ ∧ X₁ = X₂
  | _, [], [], _, _, _, _, h => ⟨rfl, by simpa [wordLater] using h⟩
  | e, [], (p, H) :: l, X₁, _, h₁, _, h => by
    exfalso
    simp only [wordLater, List.nil_append, List.cons_append] at h
    rw [h] at h₁; have := headLe_cons_iff.1 h₁; simp at this
  | e, (p, H) :: l, [], _, X₂, _, h₂, h => by
    exfalso
    simp only [wordLater, List.nil_append, List.cons_append] at h
    rw [← h] at h₂; have := headLe_cons_iff.1 h₂; simp at this
  | e, (p₁, H₁) :: l₁, (p₂, H₂) :: l₂, X₁, X₂, h₁, h₂, h => by
    simp only [wordLater, List.cons_append, List.cons.injEq, List.append_assoc] at h
    obtain ⟨hp, h⟩ := h
    have hp' : p₁ = p₂ := by simpa using hp
    subst hp'
    have hc₁ : HeadLe (2 * (e + 1) - 1) (wordLater e l₁ ++ X₁) :=
      headLe_append (headLe_mono (headLe_wordLater e l₁) (by omega)) (headLe_mono h₁ (by omega))
    have hc₂ : HeadLe (2 * (e + 1) - 1) (wordLater e l₂ ++ X₂) :=
      headLe_append (headLe_mono (headLe_wordLater e l₂) (by omega)) (headLe_mono h₂ (by omega))
    obtain ⟨rfl, h'⟩ := decode_forest (e + 1) H₁ H₂ _ _ hc₁ (fun _ => by omega) hc₂ (fun _ => by omega) h
    obtain ⟨rfl, rfl⟩ := decode_later e l₁ l₂ X₁ X₂ h₁ h₂ h'
    exact ⟨rfl, rfl⟩
end

theorem decode_cols_prefix (e : Nat) : ∀ (xpre ycols : List Column) (T : List WordAtom),
    HeadLe (2 * e) T → wordCols e ycols = wordCols e xpre ++ T →
    ycols.take xpre.length = xpre ∧ wordCols e (ycols.drop xpre.length) = T
  | [], ycols, T, _, h => by simpa [wordCols] using h
  | x :: xs, [], T, _, h => by
    exfalso
    have hne : wordCol e x ≠ [] := by cases x <;> simp [wordCol]
    simp [wordCols] at h; exact hne h.1
  | x :: xs, y :: ys, T, hT, h => by
    simp only [wordCols_cons', List.append_assoc] at h
    obtain ⟨rfl, h'⟩ := decode_col e y x _ _ (headLe_wordCols e ys)
      (headLe_append (headLe_wordCols e xs) hT) h
    obtain ⟨h1, h2⟩ := decode_cols_prefix e xs ys T hT h'
    exact ⟨by simp [h1], by simpa using h2⟩

theorem decode_later_prefix (e : Nat) : ∀ (cr yr : Column) (A S : List WordAtom),
    HeadLe (2 * e) A → HeadLe (2 * e + 1) S → wordLater e yr ++ A = wordLater e cr ++ S →
    yr.take cr.length = cr ∧ wordLater e (yr.drop cr.length) ++ A = S
  | [], yr, A, S, _, _, h => by simpa [wordLater] using h
  | (p₁, H₁) :: cr, [], A, S, hA, _, h => by
    exfalso
    simp only [wordLater, List.nil_append, List.cons_append] at h
    rw [h] at hA; have := headLe_cons_iff.1 hA; simp at this
  | (p₁, H₁) :: cr, (py, Hy) :: yr, A, S, hA, hS, h => by
    simp only [wordLater, List.cons_append, List.cons.injEq, List.append_assoc] at h
    obtain ⟨hp, h⟩ := h
    have hp' : py = p₁ := by simpa using hp
    subst hp'
    have hc₁ : HeadLe (2 * (e + 1) - 1) (wordLater e yr ++ A) :=
      headLe_append (headLe_mono (headLe_wordLater e yr) (by omega)) (headLe_mono hA (by omega))
    have hc₂ : HeadLe (2 * (e + 1) - 1) (wordLater e cr ++ S) :=
      headLe_append (headLe_mono (headLe_wordLater e cr) (by omega)) (headLe_mono hS (by omega))
    obtain ⟨rfl, h'⟩ := decode_forest (e + 1) Hy H₁ _ _ hc₁ (fun _ => by omega) hc₂ (fun _ => by omega) h
    obtain ⟨h1, h2⟩ := decode_later_prefix e cr yr A S hA hS h'
    exact ⟨by simp [h1], by simpa using h2⟩

theorem decode_col_prefix (e : Nat) (cpre yc : Column) (A S : List WordAtom) (hc : cpre ≠ [])
    (hA : HeadLe (2 * e) A) (hS : HeadLe (2 * e + 1) S) (h : wordCol e yc ++ A = wordCol e cpre ++ S) :
    yc.take cpre.length = cpre ∧ wordLater e (yc.drop cpre.length) ++ A = S := by
  obtain ⟨⟨p₀, H₀⟩, cr, rfl⟩ := List.exists_cons_of_ne_nil hc
  cases yc with
  | nil => simp [wordCol] at h
  | cons y yr =>
    obtain ⟨py, Hy⟩ := y
    simp only [wordCol, List.cons_append, List.cons.injEq, List.append_assoc] at h
    obtain ⟨hp, h⟩ := h
    have hp' : py = p₀ := by simpa using hp
    subst hp'
    have hc₁ : HeadLe (2 * (e + 1) - 1) (wordLater e yr ++ A) :=
      headLe_append (headLe_mono (headLe_wordLater e yr) (by omega)) (headLe_mono hA (by omega))
    have hc₂ : HeadLe (2 * (e + 1) - 1) (wordLater e cr ++ S) :=
      headLe_append (headLe_mono (headLe_wordLater e cr) (by omega)) (headLe_mono hS (by omega))
    obtain ⟨rfl, h'⟩ := decode_forest (e + 1) Hy H₀ _ _ hc₁ (fun _ => by omega) hc₂ (fun _ => by omega) h
    obtain ⟨h1, h2⟩ := decode_later_prefix e cr yr A S hA hS h'
    exact ⟨by simp [h1], by simpa using h2⟩

theorem split_of_deep {L C P S : List WordAtom} {b : Nat} (hP : ∀ y ∈ P, b + 1 ≤ (ofLex y).1)
    (hC : HeadLe b C) (h : L ++ C = P ++ S) : ∃ Sin, L = P ++ Sin ∧ S = Sin ++ C := by
  rcases List.append_eq_append_iff.1 h with ⟨a', rfl, hC'⟩ | ⟨c', hL, hS⟩
  · cases a' with
    | nil => exact ⟨[], by simp, by simpa using hC'.symm⟩
    | cons x a' =>
      exfalso
      rw [hC'] at hC
      have h1 := headLe_cons_iff.1 (headLe_append_of_ne S (List.cons_ne_nil x a') hC)
      have h2 := hP x (by simp)
      omega
  · exact ⟨c', hL, hS⟩

theorem getElem?_of_drop_eq_cons {α : Type} {l : List α} {j : Nat} {x : α} {xs : List α}
    (h : l.drop j = x :: xs) : l[j]? = some x := by
  have := congrArg (·[0]?) h
  simpa [List.getElem?_drop] using this

/-- helper (N2.1): a literal cap of `X` whose word prefix is also a prefix of `w(Y)`, followed in
`w(Y)` by a suitable atom, is a literal cap of `Y` with the same internal part. -/
theorem litCap_transfer (k : Nat) :
    ∀ (ρ : List (Nat × Nat)) (j : Nat) (X : Forest) (col : Column) (e : Nat) (P : List WordAtom),
      X.colAt ⟨ρ, j⟩ = some col → k ≤ col.length →
      (∀ p, wordAt e (litCapAux k p ρ j X) = P ++ [capAtomAt (e + ρ.length) k p]) →
      ∀ (Y : Forest) (S : List WordAtom), wordAt e Y = P ++ S →
      (k ≠ 0 → HeadLe (2 * (e + ρ.length) + 1) S) →
      (k = 0 → ∃ y, S.head? = some y ∧ (ofLex y).1 = 2 * (e + ρ.length)) →
      ∃ colY, Y.colAt ⟨ρ, j⟩ = some colY ∧ k ≤ colY.length ∧ colY.take k = col.take k ∧
        ∀ p, wordAt e (litCapAux k p ρ j Y) = P ++ [capAtomAt (e + ρ.length) k p]
  | [], j, .node xcols, col, e, P, hcol, hk, hP, .node ycols, S, hY, hS1, hS0 => by
    rw [colAt_node_nil] at hcol
    have hj : j < xcols.length := (List.getElem?_eq_some_iff.1 hcol).1
    have hPeq : P = wordCols e (xcols.take j) ++ (if k = 0 then [] else wordCol e (col.take k)) := by
      have h0 := hP 0
      simp only [litCapAux, List.getD_eq_getElem?_getD, hcol, Option.getD_some, wordAt,
        wordCols_append, wordCols_cons', wordCols, List.append_nil, List.length_nil, Nat.add_zero] at h0
      rw [wordCol_take_snoc e col k 0 hk, ← List.append_assoc] at h0
      exact (List.append_cancel_right h0).symm
    subst hPeq
    simp only [List.length_nil, Nat.add_zero] at hS1 hS0 ⊢
    have hT : HeadLe (2 * e) ((if k = 0 then [] else wordCol e (col.take k)) ++ S) := by
      by_cases hk0 : k = 0
      · obtain ⟨y, hy, hy'⟩ := hS0 hk0
        rw [if_pos hk0, List.nil_append]; intro y' hy''; rw [hy] at hy''
        cases hy''; omega
      · rw [if_neg hk0]; apply headLe_append_of_ne _ (by cases col.take k <;> simp [wordCol])
        exact headLe_wordCol e _
    have hY' : wordCols e ycols = wordCols e (xcols.take j) ++
        ((if k = 0 then [] else wordCol e (col.take k)) ++ S) := by
      rw [← List.append_assoc]; exact hY
    obtain ⟨h1, h2⟩ := decode_cols_prefix e _ _ _ hT hY'
    rw [List.length_take_of_le hj.le] at h1 h2
    have hTne : (if k = 0 then [] else wordCol e (col.take k)) ++ S ≠ [] := by
      by_cases hk0 : k = 0
      · obtain ⟨y, hy, -⟩ := hS0 hk0; rw [if_pos hk0, List.nil_append]; rintro rfl; simp at hy
      · rw [if_neg hk0]; cases col.take k <;> simp [wordCol]
    cases hd : ycols.drop j with
    | nil => rw [hd] at h2; exact absurd h2.symm (by simpa [wordCols] using hTne)
    | cons yc ys =>
      rw [hd, wordCols_cons'] at h2
      have hyc : ycols[j]? = some yc := getElem?_of_drop_eq_cons hd
      by_cases hk0 : k = 0
      · subst hk0
        refine ⟨yc, by rw [colAt_node_nil]; exact hyc, Nat.zero_le _, by simp, fun p => ?_⟩
        simp only [litCapAux, List.getD_eq_getElem?_getD, hyc, Option.getD_some, wordAt,
          wordCols_append, wordCols_cons', wordCols, List.append_nil, h1]
        rw [wordCol_take_snoc e yc 0 p (Nat.zero_le _)]
        simp
      · rw [if_neg hk0] at h2
        have hne : col.take k ≠ [] := by
          rw [ne_eq, List.take_eq_nil_iff]; rintro (h | rfl) <;> simp_all
        obtain ⟨h3, -⟩ := decode_col_prefix e (col.take k) yc (wordCols e ys) S hne
          (headLe_wordCols e ys) (hS1 hk0) h2
        rw [List.length_take_of_le hk] at h3
        have hkY : k ≤ yc.length := by
          have := congrArg List.length h3; simp at this; omega
        refine ⟨yc, by rw [colAt_node_nil]; exact hyc, hkY, h3, fun p => ?_⟩
        simp only [litCapAux, List.getD_eq_getElem?_getD, hyc, Option.getD_some, wordAt,
          wordCols_append, wordCols_cons', wordCols, List.append_nil, h1]
        rw [wordCol_take_snoc e yc k p hkY, h3, if_neg hk0, List.append_assoc]
  | (ci, ei) :: ρ, j, .node xcols, col, e, P, hcol, hk, hP, .node ycols, S, hY, hS1, hS0 => by
    rw [colAt_node_cons] at hcol
    obtain ⟨x, hx, hcolx⟩ := Option.bind_eq_some_iff.1 hcol
    obtain ⟨colc, hc, hx'⟩ := Option.bind_eq_some_iff.1 hx
    obtain ⟨q, H⟩ := x
    have hci : ci < xcols.length := (List.getElem?_eq_some_iff.1 hc).1
    have hei : ei < colc.length := (List.getElem?_eq_some_iff.1 hx').1
    obtain ⟨P', R', hw', hcap', -⟩ := wordAt_litCapAux k ρ j H col (e + 1) hcolx hk
    have hidx : e + ((ci, ei) :: ρ).length = e + 1 + ρ.length := by simp; omega
    simp only [hidx] at hP hS1 hS0 ⊢
    have hPeq : P = wordCols e (xcols.take ci) ++ wordCol e (colc.take ei ++ [(q, Tree.empty)]) ++ P' := by
      have h0 := hP 0
      simp only [litCapAux, List.getD_eq_getElem?_getD, hc, Option.getD_some, hx', wordAt,
        wordCols_append, wordCols_cons', wordCols, List.append_nil] at h0
      rw [wordCol_snoc, ← wordAt, hcap' 0] at h0
      simp only [← List.append_assoc] at h0
      exact (List.append_cancel_right h0).symm
    subst hPeq
    have hT : HeadLe (2 * e) (wordCol e (colc.take ei ++ [(q, Tree.empty)]) ++ P' ++ S) := by
      rw [List.append_assoc]
      exact headLe_append_of_ne _ (by cases (colc.take ei ++ [(q, Tree.empty)]) <;> simp [wordCol])
        (headLe_wordCol e _)
    have hY' : wordCols e ycols = wordCols e (xcols.take ci) ++
        (wordCol e (colc.take ei ++ [(q, Tree.empty)]) ++ P' ++ S) := by
      simp only [← List.append_assoc]; exact hY
    obtain ⟨h1, h2⟩ := decode_cols_prefix e _ _ _ hT hY'
    rw [List.length_take_of_le hci.le] at h1 h2
    cases hd : ycols.drop ci with
    | nil =>
      rw [hd] at h2
      exfalso
      have hne : wordCol e (colc.take ei ++ [(q, Tree.empty)]) ≠ [] := by
        cases (colc.take ei ++ [(q, Tree.empty)]) <;> simp [wordCol]
      simp only [wordCols] at h2
      exact hne (List.append_eq_nil_iff.1 (List.append_eq_nil_iff.1 h2.symm).1).1
    | cons yc ys =>
      rw [hd, wordCols_cons'] at h2
      have hyc : ycols[ci]? = some yc := getElem?_of_drop_eq_cons hd
      -- decode the containing column up to the containing entry
      obtain ⟨Hy, yr, hyc_eq, hrest⟩ : ∃ Hy yr, yc = colc.take ei ++ (q, Hy) :: yr ∧
          wordAt (e + 1) Hy ++ (wordLater e yr ++ wordCols e ys) = P' ++ S := by
        by_cases hei0 : ei = 0
        · subst hei0
          cases yc with
          | nil => simp [wordCol, wordAt_empty, wordLater] at h2
          | cons y yr =>
            obtain ⟨q', Hy⟩ := y
            simp only [List.take_zero, List.nil_append, wordCol, wordAt_empty, wordLater,
              List.append_nil, List.cons_append, List.singleton_append, List.cons.injEq,
              List.append_assoc] at h2
            obtain ⟨hq, h2⟩ := h2
            have : q' = q := by simpa using hq
            subst this
            exact ⟨Hy, yr, by simp, h2⟩
        · rw [wordCol_take_snoc e colc ei q hei.le, if_neg hei0] at h2
          have hne : colc.take ei ≠ [] := by
            rw [ne_eq, List.take_eq_nil_iff]; rintro (h | h) <;> simp_all
          have hS' : HeadLe (2 * e + 1) ([capAtomAt e ei q] ++ P' ++ S) := by
            intro y hy; simp [capAtomAt, hei0] at hy; subst hy; simp
          simp only [List.append_assoc] at h2 hS'
          obtain ⟨h3, h4⟩ := decode_col_prefix e (colc.take ei) yc (wordCols e ys) _ hne
            (headLe_wordCols e ys) hS' h2
          rw [List.length_take_of_le hei.le] at h3 h4
          cases hdy : yc.drop ei with
          | nil =>
            exfalso
            rw [hdy] at h4
            have := headLe_wordCols e ys
            rw [show wordLater e [] = [] from rfl, List.nil_append] at h4
            rw [h4] at this
            have := headLe_cons_iff.1 this; simp [capAtomAt, hei0] at this
          | cons y yr =>
            obtain ⟨q', Hy⟩ := y
            rw [hdy] at h4
            simp only [wordLater, List.cons_append, List.singleton_append, List.cons.injEq,
              List.append_assoc, capAtomAt, if_neg hei0] at h4
            obtain ⟨hq, h4⟩ := h4
            have : q' = q := by simpa using hq
            subst this
            refine ⟨Hy, yr, ?_, h4⟩
            rw [← List.take_append_drop ei yc, h3, hdy]
      -- the containing entry's height starts with the inner cap prefix
      have hdeep : ∀ y ∈ P', 2 * e + 1 + 1 ≤ (ofLex y).1 := by
        intro y hy
        have := wordAt_fst_ge (e + 1) (litCapAux k 0 ρ j H) y (by rw [hcap' 0]; simp [hy])
        omega
      have hC : HeadLe (2 * e + 1) (wordLater e yr ++ wordCols e ys) :=
        headLe_append (headLe_wordLater e yr) (headLe_mono (headLe_wordCols e ys) (by omega))
      obtain ⟨Sin, hHy, hS⟩ := split_of_deep hdeep hC hrest
      have hS1' : k ≠ 0 → HeadLe (2 * (e + 1 + ρ.length) + 1) Sin := by
        intro hk0 y hy
        cases Sin with
        | nil => simp at hy
        | cons z Sin => exact hS1 hk0 y (by rw [hS]; simpa using hy)
      have hS0' : k = 0 → ∃ y, Sin.head? = some y ∧ (ofLex y).1 = 2 * (e + 1 + ρ.length) := by
        intro hk0
        obtain ⟨y, hy, hy'⟩ := hS0 hk0
        cases Sin with
        | nil =>
          exfalso
          rw [hS, List.nil_append] at hy
          have := hC y (by rw [hy]; rfl)
          omega
        | cons z Sin => exact ⟨y, by rw [hS] at hy; simpa using hy, hy'⟩
      obtain ⟨colY, hcolY, hkY, htake, hcapY⟩ :=
        litCap_transfer k ρ j H col (e + 1) P' hcolx hk hcap' Hy Sin hHy hS1' hS0'
      have hyx : yc[ei]? = some (q, Hy) := by
        rw [hyc_eq, List.getElem?_append_right (by simp)]
        simp [List.length_take_of_le hei.le]
      refine ⟨colY, ?_, hkY, htake, fun p => ?_⟩
      · rw [colAt_node_cons, hyc]; simp only [Option.bind_some, hyx]; exact hcolY
      · have hyt : yc.take ei = colc.take ei := by
          rw [hyc_eq, List.take_left' (by simp; omega)]
        simp only [litCapAux, List.getD_eq_getElem?_getD, hyc, Option.getD_some, hyx, wordAt,
          wordCols_append, wordCols_cons', wordCols, List.append_nil, h1, hyt]
        rw [wordCol_snoc, ← wordAt, hcapY p]
        simp only [List.append_assoc]

theorem litCapAux_route (Q : Column) (r j : Nat) :
    ∀ (ρ : List (Nat × Nat)) (F : Forest),
      (∀ d < ρ.length, ∃ G, F.forestAt (ρ.take d) = some G ∧ G.lastStep? = ρ[d]?) →
      (∃ G, F.forestAt ρ = some G ∧ G.cols.length = j + 1) →
      F.colAt ⟨ρ, j⟩ = some (Q ++ [(r, Tree.empty)]) → litCapAux Q.length r ρ j F = F
  | [], .node cols, _, hG, hcol => by
    obtain ⟨G, hG, hl⟩ := hG
    rw [forestAt_nil_path] at hG; obtain rfl := Option.some.inj hG
    rw [colAt_node_nil] at hcol
    simp only [Tree.cols] at hl
    simp only [litCapAux, List.getD_eq_getElem?_getD, hcol, Option.getD_some, List.take_left]
    congr 1
    conv_rhs => rw [← List.take_append_drop j cols, List.drop_eq_getElem_cons (by omega),
      (List.getElem?_eq_some_iff.1 hcol).2]
    rw [List.drop_eq_nil_of_le (by omega)]
  | (ci, ei) :: ρ, .node cols, hroute, hG, hcol => by
    obtain ⟨G0, hG0, hls⟩ := hroute 0 (by simp)
    simp only [List.take_zero, forestAt_nil_path, Option.some.injEq] at hG0
    subst hG0
    simp only [Tree.lastStep?, Tree.cols, List.getElem?_cons_zero] at hls
    obtain ⟨colL, hL, hls⟩ := Option.bind_eq_some_iff.1 hls
    split_ifs at hls with hne
    obtain ⟨rfl, rfl⟩ := Prod.mk.inj (Option.some.inj hls)
    have hcolsne : cols ≠ [] := by rintro rfl; simp at hL
    have hLi : cols[cols.length - 1]? = some colL := by rw [← List.getLast?_eq_getElem?]; exact hL
    have hLne : colL ≠ [] := by simpa using hne
    rw [colAt_node_cons, hLi] at hcol
    simp only [Option.bind_some] at hcol
    obtain ⟨x, hx, hcolx⟩ := Option.bind_eq_some_iff.1 hcol
    obtain ⟨q, H⟩ := x
    have ih := litCapAux_route Q r j ρ H (fun d hd => by
        obtain ⟨G, hG, hl⟩ := hroute (d + 1) (by simp; omega)
        refine ⟨G, ?_, by simpa using hl⟩
        rw [List.take_succ_cons, forestAt_node_cons, hLi] at hG
        simpa [hx] using hG)
      (by
        obtain ⟨G, hG, hl⟩ := hG
        rw [forestAt_node_cons, hLi] at hG
        exact ⟨G, by simpa [hx] using hG, hl⟩) hcolx
    simp only [litCapAux, List.getD_eq_getElem?_getD, hLi, Option.getD_some, hx, ih]
    congr 1
    have hc1 : cols = cols.take (cols.length - 1) ++ [colL] := by
      conv_lhs => rw [← List.take_append_drop (cols.length - 1) cols,
        List.drop_eq_getElem_cons (by have := List.length_pos_of_ne_nil hcolsne; omega),
        (List.getElem?_eq_some_iff.1 hLi).2]
      rw [List.drop_eq_nil_of_le (by omega)]
    have hc2 : colL = colL.take (colL.length - 1) ++ [(q, H)] := by
      conv_lhs => rw [← List.take_append_drop (colL.length - 1) colL,
        List.drop_eq_getElem_cons (by have := List.length_pos_of_ne_nil hLne; omega),
        (List.getElem?_eq_some_iff.1 hx).2]
      rw [List.drop_eq_nil_of_le (by omega)]
    rw [← hc2, ← hc1]

/-- helper: a forest whose last route column ends with `(r, ∅)` is its own literal cap there. -/
theorem litCap_of_lastRoute {E : Forest} {c : ColAddr} {Q : Column} {r : Nat}
    (hc : (routeCols E).getLast? = some c) (hcol : E.colAt c = some (Q ++ [(r, Tree.empty)])) :
    litCap E c Q.length r = E := by
  rw [litCap_eq_aux hcol]
  have hmem : c ∈ routeCols E := List.mem_of_getLast? hc
  obtain ⟨hroute, G, hG, hl⟩ := (mem_routeCols_iff E c).1 hmem
  exact litCapAux_route Q r c.col c.path E hroute ⟨G, hG, hl⟩ hcol

-- N2.1 (converse of L3.1c): a prefix of `w(B)` followed by a valid closing atom is a literal
-- cap of `B`, provided the next atom of `B` is smaller (and, for a column-start atom, not
-- shallower than the new column)
theorem exists_litCap_of_word {B E : Forest} {π e p : Nat} {first : Bool}
    (hw : word E = (word B).take π ++
      [if first then toLex (2 * e, toLex (1, p)) else toLex (2 * e + 1, toLex (0, p))])
    (hπ : π ≤ mu B)
    (hnext : ∀ y, (word B)[π]? = some y →
      y < (if first then toLex (2 * e, toLex (1, p)) else toLex (2 * e + 1, toLex (0, p))))
    (hfirst : first = true → ∃ y, (word B)[π]? = some y ∧ 2 * e ≤ (ofLex y).1) :
    ∃ c k, c ∈ B.colAddrs ∧ k ≤ ((B.colAt c).getD []).length ∧ colDepth c = e ∧
      (k = 0 ↔ first = true) ∧ capPos B c k = π ∧ IsUpward B c k p ∧ litCap B c k p = E := by
  have hG : word (safePrefix B π) = (word B).take π := word_safePrefix B π
  obtain ⟨c, k, hce, hkf, hlast, hentry, hlen, -, -, -⟩ :=
    routeCols_of_word_snoc (G := safePrefix B π) (E := E) (e := e) (p := p) (first := first)
      (by rw [hG]; exact hw)
  obtain ⟨col, hcol, hck⟩ := Tree.colAt_of_entryAt hentry
  rw [hcol, Option.getD_some] at hlen
  have hcol' : E.colAt c = some (col.take k ++ [(p, Tree.empty)]) := by
    rw [hcol]; congr 1
    conv_lhs => rw [← List.take_append_drop k col, List.drop_eq_getElem_cons (by omega),
      (List.getElem?_eq_some_iff.1 hck).2]
    rw [List.drop_eq_nil_of_le (by omega)]
  have hkk : (col.take k).length = k := List.length_take_of_le (by omega)
  have hEcap : litCap E c k p = E := by
    have := litCap_of_lastRoute hlast hcol'; rwa [hkk] at this
  have hz : capAtom c k p =
      (if first then toLex (2 * e, toLex (1, p)) else toLex (2 * e + 1, toLex (0, p))) := by
    unfold capAtom colDepth; rw [hce]
    cases first <;> simp_all
  obtain ⟨-, -, hcapE, -, -⟩ := litCap_word_data hcol (k := k) (by omega)
  have hPE : (word E).take (capPos E c k) = (word B).take π := by
    have h1 := hcapE p
    rw [hEcap, hz] at h1
    exact List.append_cancel_right (h1.symm.trans hw)
  have hS1 : k ≠ 0 → HeadLe (2 * (0 + c.path.length) + 1) ((word B).drop π) := by
    intro hk0 y hy
    have hf : first = false := by cases first <;> simp_all
    have := hnext y (by rw [List.head?_drop] at hy; exact hy)
    rw [hf, if_neg (by simp), Prod.Lex.lt_iff] at this
    rw [hce]; simp at this ⊢
    rcases this with h | ⟨h, -⟩ <;> omega
  have hS0 : k = 0 → ∃ y, ((word B).drop π).head? = some y ∧
      (ofLex y).1 = 2 * (0 + c.path.length) := by
    intro hk0
    have hf : first = true := hkf.1 hk0
    obtain ⟨y, hy, hy'⟩ := hfirst hf
    refine ⟨y, by rw [List.head?_drop]; exact hy, ?_⟩
    have := hnext y hy
    rw [hf, if_pos rfl, Prod.Lex.lt_iff] at this
    rw [hce]; simp at this ⊢
    rcases this with h | ⟨h, -⟩ <;> omega
  obtain ⟨colY, hcolY, hkY, -, hcapB⟩ := litCap_transfer k c.path c.col E col 0 ((word B).take π)
    hcol (by omega) (fun p' => by
      have := hcapE p'
      rw [litCap_eq_aux hcol, word, hPE, capAtom_eq, colDepth] at this
      simpa using this)
    B ((word B).drop π) (by rw [← word, List.take_append_drop]) hS1 hS0
  have hcapB' : ∀ p', word (litCap B c k p') = (word B).take π ++ [capAtom c k p'] := by
    intro p'; rw [litCap_eq_aux hcolY, word, hcapB p', capAtom_eq, colDepth]; simp
  have hpos : capPos B c k = π := by
    simp only [capPos, hcapB' 0, List.length_append, List.length_take, List.length_singleton]
    unfold mu at hπ; omega
  refine ⟨c, k, (Tree.mem_colAddrs_iff B c).2 (by rw [hcolY]; rfl), by rw [hcolY]; exact hkY,
    by rw [colDepth, hce], hkf, hpos, ?_, ?_⟩
  · rw [isUpward_iff_atom ((Tree.mem_colAddrs_iff B c).2 (by rw [hcolY]; rfl))
      (by rw [hcolY]; exact hkY), hpos, hz]
    exact hnext
  · apply word_injective
    rw [hcapB' p, hw, hz]


/-! ### L3.1d helpers -/

theorem cmpCol_append_same {α : Type} (c : α → α → Ordering) [Std.ReflCmp c] :
    ∀ (P A B : List (α × Tree α)), Tree.cmpCol c (P ++ A) (P ++ B) = Tree.cmpCol c A B
  | [], A, B => rfl
  | (x, h) :: P, A, B => by
    simp only [List.cons_append, Tree.cmpCol, Std.ReflCmp.compare_self, Tree.cmp_self,
      Ordering.eq_then]
    exact cmpCol_append_same c P A B

/-- helper: a branch level with empty first height is `m` copies of `(a+k, ∅)` then a part
whose first parent is smaller. -/
theorem run_split' {a k : Nat} {rest : List (Nat × Forest)}
    (hH : ∀ i x y, ((a + k, Tree.empty) :: rest)[i]? = some x →
      ((a + k, Tree.empty) :: rest)[i + 1]? = some y → EntryLe y x) :
    ∃ after, (a + k, (Tree.empty : Forest)) :: rest =
        List.replicate (1 + (rest.takeWhile fun x => x.1 == a + k).length) (a + k, Tree.empty) ++ after ∧
      ∀ y ∈ after.head?, y.1 < a + k := by
  obtain ⟨h1, h2⟩ := run_split rest hH
  refine ⟨_, ?_, h2⟩
  conv_lhs => rw [h1]
  rw [Nat.add_comm 1, List.replicate_succ]; rfl

/-- helper: the relabelled form of `rep m (a+k, ∅) ++ W` against the level-`k` tower column. -/
theorem cmpCol_run_lt (a k m : Nat) (W : List (Nat × Forest))
    (hW : ∀ y ∈ W.head?, y.1 < a + k) :
    Tree.cmpCol keyLabelCmp (Tree.mapCol (relLabel a) (List.replicate m (a + k, Tree.empty) ++ W))
      (List.replicate (m + 1) ((true, k), (Tree.empty : Key))) = .lt := by
  rw [treeMapCol_eq_map, List.map_append, List.map_replicate, List.replicate_succ']
  have hX : ((relLabel a (a + k, (Tree.empty : Forest)).1, Tree.map (relLabel a) (a + k, (Tree.empty : Forest)).2) :
      (Bool × Nat) × Key) = ((true, k), (Tree.empty : Key)) := by
    simp [relLabel_host, Tree.empty, Tree.map, Tree.mapCols]
  rw [hX, cmpCol_append_same]
  cases W with
  | nil => rfl
  | cons y W =>
    obtain ⟨q, h⟩ := y
    have := hW (q, h) rfl
    simp only [List.map_cons, Tree.cmpCol]
    rw [← relLabel_host a k, keyLabelCmp_relLabel, Nat.compare_eq_lt.2 this]; rfl

theorem litCapAux_nil (k p j : Nat) (cols : List Column) :
    litCapAux k p [] j (.node cols) = .node (cols.take j ++ [(cols.getD j []).take k ++ [(p, Tree.empty)]]) :=
  rfl

theorem litCapAux_cons (k p ci ei j : Nat) (ρ : List (Nat × Nat)) (cols : List Column) {q : Nat}
    {H : Forest} (h : (cols.getD ci [])[ei]? = some (q, H)) :
    litCapAux k p ((ci, ei) :: ρ) j (.node cols) =
      .node (cols.take ci ++ [(cols.getD ci []).take ei ++ [(q, litCapAux k p ρ j H)]]) := by
  show (match (cols.getD ci [])[ei]? with
    | some (q, h) => Tree.node (cols.take ci ++ [(cols.getD ci []).take ei ++ [(q, litCapAux k p ρ j h)]])
    | none => Tree.node cols) = _
  rw [h]

/-- helper: a capped tower level that keeps a complete nonempty first entry is strictly below. -/
theorem keep_first_lt {a kk : Nat} {h₀ : Forest} {T : Key} (hlt : keyCmp (relKey a h₀) T = .lt)
    (R : List (Nat × Forest)) (cs : List Column) :
    keyCmp (relKey a (.node (((a + kk, h₀) :: R) :: cs))) (.node [[((true, kk), T)]]) = .lt := by
  rw [keyCmp, relKey_node, Tree.mapCols, Tree.cmp, Tree.cmpCols, Tree.mapCol, Tree.cmpCol,
    relLabel_host]
  rw [keyCmp, relKey_eq_map] at hlt
  simp only [Std.ReflCmp.compare_self, Ordering.eq_then]
  rw [hlt]; rfl

theorem keep_run_lt {a kk m : Nat} (W : List (Nat × Forest)) (hW : ∀ y ∈ W.head?, y.1 < a + kk)
    (cs : List Column) :
    keyCmp (relKey a (.node ((List.replicate m (a + kk, Tree.empty) ++ W) :: cs)))
      (.node [List.replicate (m + 1) ((true, kk), Tree.empty)]) = .lt := by
  rw [keyCmp, relKey_node, Tree.mapCols, Tree.cmp, Tree.cmpCols, cmpCol_run_lt a kk m W hW]; rfl

theorem colAt_empty_none (ρ : List (Nat × Nat)) (j : Nat) : (Tree.empty : Forest).colAt ⟨ρ, j⟩ = none := by
  cases ρ with
  | nil => rfl
  | cons x ρ => simp [Tree.colAt, forestAt_empty_node_cons]

theorem capKey_le_tower {a k p : Nat} : ∀ {kk : Nat} {J : Forest}, BranchOK a kk J →
    ∀ (ρ : List (Nat × Nat)) (j : Nat) (col : Column) {d m : Nat},
      J.colAt ⟨ρ, j⟩ = some col → k ≤ col.length → (∀ q h, col[k]? = some (q, h) → q < p) →
      p < a + kk + 1 + ((ρ.map (·.1 + 1)).sum + j) → profileAux kk J = toLex (d, m) →
      keyCmp (relKey a (litCapAux k p ρ j J)) (towKeyAt kk (d - kk) (m + 1)) ≠ .gt := by
  intro kk J hb
  induction hb with
  | @mk kk h₀ rest cs hH hrec ih =>
    intro ρ j col d m hcol hk hup hV hp
    obtain ⟨gs⟩ := h₀
    cases gs with
    | cons g gs =>
      have hne : Tree.node (g :: gs) ≠ (Tree.empty : Forest) := by simp [Tree.empty]
      have hp' : profileAux (kk + 1) (.node (g :: gs)) = toLex (d, m) := by
        simp only [profileAux] at hp; exact hp
      obtain ⟨d', m', h1, -, h3⟩ := profileAux_branch (hrec hne)
      rw [hp'] at h1; obtain ⟨hd, -⟩ := Prod.mk.inj (toLex.injective h1)
      have hlt := relKey_lt_tower (hrec hne) hp'
      rw [show d - kk = (d - (kk + 1)) + 1 by omega, towKeyAt]
      cases ρ with
      | nil =>
        rw [colAt_node_nil] at hcol
        rw [litCapAux_nil]
        cases j with
        | zero =>
          simp only [List.getElem?_cons_zero, Option.some.injEq] at hcol
          subst hcol
          cases k with
          | zero =>
            exfalso; have := hup _ _ rfl; simp at hV; omega
          | succ k =>
            simp only [List.take_zero, List.nil_append, List.getD_cons_zero, List.take_succ_cons,
              List.cons_append]
            rw [keep_first_lt hlt]; simp
        | succ j =>
          simp only [List.take_succ_cons, List.cons_append]
          rw [keep_first_lt hlt]; simp
      | cons ce ρ =>
        obtain ⟨ci, ei⟩ := ce
        rw [colAt_node_cons] at hcol
        obtain ⟨x, hx, hcolx⟩ := Option.bind_eq_some_iff.1 hcol
        obtain ⟨colc, hc, hx'⟩ := Option.bind_eq_some_iff.1 hx
        obtain ⟨q', H'⟩ := x
        have hget : ((((a + kk, Tree.node (g :: gs)) :: rest) :: cs).getD ci [])[ei]? = some (q', H') := by
          rw [List.getD_eq_getElem?_getD, hc, Option.getD_some]; exact hx'
        rw [litCapAux_cons k p ci ei j ρ _ hget]
        cases ci with
        | succ ci =>
          simp only [List.take_succ_cons, List.cons_append]
          rw [keep_first_lt hlt]; simp
        | zero =>
          simp only [List.getElem?_cons_zero, Option.some.injEq] at hc
          subst hc
          cases ei with
          | succ ei =>
            simp only [List.take_zero, List.nil_append, List.getD_cons_zero, List.take_succ_cons,
              List.cons_append]
            rw [keep_first_lt hlt]; simp
          | zero =>
            simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hx'
            obtain ⟨rfl, rfl⟩ := hx'
            have hih := ih hne ρ j col hcolx hk hup (by simp at hV ⊢; omega) hp'
            simp only [List.take_zero, List.nil_append, List.getD_cons_zero]
            rw [keyCmp, relKey_node, Tree.mapCols, Tree.cmp, Tree.cmpCols, Tree.mapCol, Tree.cmpCol,
              relLabel_host]
            rw [keyCmp, relKey_eq_map] at hih
            simp only [Std.ReflCmp.compare_self, Ordering.eq_then]
            exact ordering_then_ne_gt (ordering_then_ne_gt hih (by simp [Tree.mapCol, Tree.cmpCol]))
              (by simp [Tree.mapCols, Tree.cmpCols])
    | nil =>
      simp only [profileAux] at hp
      obtain ⟨hd, hm⟩ := Prod.mk.inj (toLex.injective hp)
      rw [← hd, Nat.sub_self, towKeyAt]
      obtain ⟨after, hsplit, hafter⟩ := run_split' (a := a) (k := kk) (rest := rest) hH
      rw [hm] at hsplit
      have hsplit' : (a + kk, (Tree.node [] : Forest)) :: rest =
          List.replicate m (a + kk, Tree.empty) ++ after := hsplit
      have hlenc : ((a + kk, (Tree.node [] : Forest)) :: rest).length = m + after.length := by
        rw [hsplit']; simp
      have hrun : ∀ i < m, ((a + kk, (Tree.node [] : Forest)) :: rest)[i]? = some (a + kk, Tree.empty) := by
        intro i hi; rw [hsplit', List.getElem?_append_left (by simp; omega)]; simp [hi]
      have hlate : ∀ i, ((a + kk, (Tree.node [] : Forest)) :: rest)[m + i]? = after[i]? := by
        intro i; rw [hsplit', List.getElem?_append_right (by simp)]; simp
      have htake : ∀ t, m ≤ t → ((a + kk, (Tree.node [] : Forest)) :: rest).take t =
          List.replicate m (a + kk, Tree.empty) ++ after.take (t - m) := by
        intro t ht; rw [hsplit', List.take_append, List.take_of_length_le (by simp; omega)]
        simp
      cases ρ with
      | nil =>
        rw [colAt_node_nil] at hcol
        rw [litCapAux_nil]
        cases j with
        | zero =>
          simp only [List.getElem?_cons_zero, Option.some.injEq] at hcol
          subst hcol
          simp only [List.take_zero, List.nil_append, List.getD_cons_zero]
          simp only [List.map_nil, List.sum_nil, Nat.add_zero] at hV
          rcases lt_trichotomy k m with hkm | rfl | hkm
          · exfalso; have := hup _ _ (hrun k hkm); omega
          · rw [htake k le_rfl, Nat.sub_self, List.take_zero, List.append_nil]
            rw [keyCmp, relKey_node, Tree.mapCols, Tree.cmp, Tree.cmpCols, treeMapCol_eq_map,
              List.map_append, List.map_replicate, List.replicate_succ']
            have hX : ((relLabel a (a + kk, (Tree.empty : Forest)).1,
                Tree.map (relLabel a) (a + kk, (Tree.empty : Forest)).2) : (Bool × Nat) × Key) =
                ((true, kk), (Tree.empty : Key)) := by
              simp [relLabel_host, Tree.empty, Tree.map, Tree.mapCols]
            rw [hX, cmpCol_append_same]
            simp only [List.map_cons, List.map_nil, Tree.cmpCol, Tree.mapCols, Tree.cmpCols]
            rw [← relLabel_host a kk, keyLabelCmp_relLabel]
            have : Tree.cmp keyLabelCmp (Tree.map (relLabel a) (Tree.empty : Forest)) (Tree.empty : Key) = .eq := by
              simp [Tree.empty, Tree.map, Tree.mapCols, Tree.cmp, Tree.cmpCols]
            rw [this]
            rcases Nat.lt_or_eq_of_le (Nat.lt_succ_iff.1 hV) with h | h
            · rw [Nat.compare_eq_lt.2 h]; simp
            · rw [h, Nat.compare_eq_eq.2 rfl]; simp
          · have hne : after ≠ [] := by
              rintro rfl; simp at hlenc hk; omega
            obtain ⟨z, after', rfl⟩ := List.exists_cons_of_ne_nil hne
            rw [htake k hkm.le, List.append_assoc]
            rw [show k - m = (k - m - 1) + 1 by omega, List.take_succ_cons, keep_run_lt]
            · simp
            · intro y hy; simp at hy; subst hy; exact hafter z (by simp)
        | succ j =>
          simp only [List.take_succ_cons, List.cons_append]
          rw [hsplit', keep_run_lt after hafter]; simp
      | cons ce ρ =>
        obtain ⟨ci, ei⟩ := ce
        rw [colAt_node_cons] at hcol
        obtain ⟨x, hx, hcolx⟩ := Option.bind_eq_some_iff.1 hcol
        obtain ⟨colc, hc, hx'⟩ := Option.bind_eq_some_iff.1 hx
        obtain ⟨q', H'⟩ := x
        have hget : ((((a + kk, Tree.node []) :: rest) :: cs).getD ci [])[ei]? = some (q', H') := by
          rw [List.getD_eq_getElem?_getD, hc, Option.getD_some]; exact hx'
        rw [litCapAux_cons k p ci ei j ρ _ hget]
        cases ci with
        | succ ci =>
          simp only [List.take_succ_cons, List.cons_append]
          rw [hsplit', keep_run_lt after hafter]; simp
        | zero =>
          simp only [List.getElem?_cons_zero, Option.some.injEq] at hc
          subst hc
          have hH' : H' ≠ Tree.empty := by
            rintro rfl; rw [colAt_empty_none] at hcolx; simp at hcolx
          have hei : m ≤ ei := by
            by_contra hlt
            have := hrun ei (by omega)
            rw [hx'] at this
            exact hH' (Prod.mk.inj (Option.some.inj this)).2
          have heil : ei < m + after.length := by
            have := (List.getElem?_eq_some_iff.1 hx').1; omega
          have hne : after ≠ [] := by rintro rfl; simp at heil; omega
          obtain ⟨z, after', rfl⟩ := List.exists_cons_of_ne_nil hne
          simp only [List.take_zero, List.nil_append, List.getD_cons_zero]
          rw [htake ei hei, List.append_assoc, keep_run_lt]
          · simp
          · intro y hy
            rcases Nat.eq_or_lt_of_le hei with rfl | hlt
            · simp at hy; subst hy
              have := hlate 0; rw [Nat.add_zero, hx'] at this
              simp at this
              have hq : q' = z.1 := congrArg Prod.fst this
              have hz := hafter z (by simp)
              rw [← hq] at hz
              simpa using hz
            · rw [show ei - m = (ei - m - 1) + 1 by omega, List.take_succ_cons] at hy
              simp at hy; subst hy; exact hafter _ (by simp)

theorem forestAt_litCapAux_prefix (k p j : Nat) :
    ∀ (ρ π : List (Nat × Nat)) (F : Forest), π <+: ρ → (∃ col, F.colAt ⟨ρ, j⟩ = some col) →
      (litCapAux k p ρ j F).forestAt π = (F.forestAt π).map (litCapAux k p (ρ.drop π.length) j)
  | ρ, [], F, _, _ => by simp [forestAt_nil_path]
  | [], _ :: _, _, h, _ => absurd (List.eq_nil_of_prefix_nil h) (List.cons_ne_nil _ _)
  | (ci, ei) :: ρ, (a, b) :: π, .node cols, h, ⟨col, hcol⟩ => by
    obtain ⟨hab, hp⟩ := List.cons_prefix_cons.1 h
    obtain ⟨rfl, rfl⟩ := Prod.mk.inj hab
    rw [colAt_node_cons] at hcol
    obtain ⟨x, hx, hcolx⟩ := Option.bind_eq_some_iff.1 hcol
    obtain ⟨colc, hc, hx'⟩ := Option.bind_eq_some_iff.1 hx
    obtain ⟨q, H⟩ := x
    have hci : a < cols.length := (List.getElem?_eq_some_iff.1 hc).1
    have hei : b < colc.length := (List.getElem?_eq_some_iff.1 hx').1
    have hget : (cols.getD a [])[b]? = some (q, H) := by
      rw [List.getD_eq_getElem?_getD, hc, Option.getD_some]; exact hx'
    rw [litCapAux_cons k p a b j ρ cols hget, forestAt_node_cons, forestAt_node_cons,
      list_getElem?_take_snoc _ _ _ hci.le, if_neg (lt_irrefl _), if_pos rfl, hc]
    simp only [Option.bind_some, List.getD_eq_getElem?_getD, hc, Option.getD_some]
    rw [list_getElem?_take_snoc _ _ _ hei.le, if_neg (lt_irrefl _), if_pos rfl, hx']
    simp only [Option.bind_some, List.length_cons, List.drop_succ_cons]
    exact forestAt_litCapAux_prefix k p j ρ π H hp ⟨col, hcolx⟩

-- L3.1d (txt:269-272): every V, I-legal upward literal cap of a nonempty height `J` is at most
-- `Γ(J)`, read at the heights of the cap's containing entries
theorem capKey_le_towKey {E : Forest} (hV : CondV E) (hI : CondI E) (hH : CondH E)
    {c : ColAddr} {k p : Nat} (hup : IsUpward E c k p) (hKV : CondV (litCap E c k p))
    (hKI : CondI (litCap E c k p)) {e : EntryAddr} (hcont : e.heightPath <+: c.path)
    {q : Nat} {J : Forest} (he : E.entryAt e = some (q, J)) {d m : Nat}
    (hπ : profile J = ((toLex (d, m) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat))) :
    relKey (e.col.num 0) (((litCap E c k p).heightAt e).getD Tree.empty) ≤ towKey d (m + 1) := by
  obtain ⟨col, hcol, hk, hq⟩ := isUpward_iff_exists.1 hup
  obtain ⟨ρ, hρ⟩ := hcont
  have hJ := heightAt_of_entryAt he
  have hJcol : J.colAt ⟨ρ, c.col⟩ = some col := by
    rw [← hcol]
    simp only [Tree.colAt]
    rw [← hρ, Tree.forestAt_append, Tree.forestAt_heightPath, hJ]; rfl
  have hJne : J ≠ Tree.empty := by rintro rfl; rw [colAt_empty_none] at hJcol; simp at hJcol
  have hK : (litCap E c k p).heightAt e = some (litCapAux k p ρ c.col J) := by
    rw [litCap_eq_aux hcol, ← Tree.forestAt_heightPath,
      forestAt_litCapAux_prefix k p c.col c.path e.heightPath E ⟨ρ, hρ⟩ ⟨col, hcol⟩,
      Tree.forestAt_heightPath, hJ]
    simp [← hρ]
  -- V in the cap at its closing entry
  have hKe : (litCap E c k p).entryAt ⟨c, k⟩ = some (p, Tree.empty) := by
    rw [litCap_eq_aux hcol]
    simp only [Tree.entryAt, Tree.colAt]
    rw [forestAt_litCapAux_prefix k p c.col c.path c.path E (List.prefix_refl _) ⟨col, hcol⟩]
    simp only [Tree.colAt] at hcol
    obtain ⟨G, hG, hGc⟩ := Option.bind_eq_some_iff.1 hcol
    rw [hG]
    obtain ⟨gcols⟩ := G
    have hj : c.col < gcols.length := (List.getElem?_eq_some_iff.1 hGc).1
    simp only [Option.map_some, Option.bind_some, List.drop_length, litCapAux_nil, Tree.cols]
    rw [list_getElem?_take_snoc _ _ _ hj.le, if_neg (lt_irrefl _), if_pos rfl]
    simp only [Option.bind_some, List.getD_eq_getElem?_getD]
    simp only [Tree.cols] at hGc
    rw [hGc, Option.getD_some, List.getElem?_append_right (by simp),
      List.length_take_of_le hk, Nat.sub_self]; rfl
  have hVp := (ColAddr.resolve_isSome_iff 0 c p).1
    (hKV ⟨c, k⟩ ((Tree.mem_entryAddrs_iff _ _).2 (by rw [hKe]; rfl)) p Tree.empty hKe)
  have hnum : c.num 0 = e.col.num 0 + 0 + 1 + ((ρ.map (·.1 + 1)).sum + c.col) := by
    have h1 := num_heightPath e 0
    simp only [ColAddr.num] at h1 ⊢
    rw [← hρ, List.map_append, List.sum_append]; omega
  rw [profile_of_ne hJne, WithBot.coe_inj] at hπ
  have hb := branchOK_of_height hV hI hH (e.col.num 0) J e 0 hJ rfl hJne
  have := capKey_le_tower hb ρ c.col col hJcol hk hq (by omega) hπ
  rw [Nat.sub_zero] at this
  rw [hK, Option.getD_some]
  exact this


/-! ### L3.1e helpers: entries of a literal cap -/

theorem forestAt_litCapAux_off (k p j : Nat) :
    ∀ (ρ π : List (Nat × Nat)) (F G' : Forest),
      (∃ col, F.colAt ⟨ρ, j⟩ = some col ∧ k ≤ col.length) →
      ¬ π <+: ρ → π ≠ ρ ++ [(j, k)] → (litCapAux k p ρ j F).forestAt π = some G' →
      F.forestAt π = some G'
  | _, [], _, _, _, h, _, _ => absurd List.nil_prefix h
  | [], (a, b) :: π, .node cols, G', ⟨col, hcol, hk⟩, _, hne, hG => by
    rw [colAt_node_nil] at hcol
    have hj : j < cols.length := (List.getElem?_eq_some_iff.1 hcol).1
    rw [litCapAux_nil, forestAt_node_cons, list_getElem?_take_snoc _ _ _ hj.le] at hG
    rw [forestAt_node_cons]
    split_ifs at hG with h1 h2
    · exact hG
    · subst h2
      rw [hcol]
      simp only [Option.bind_some, List.getD_eq_getElem?_getD, hcol, Option.getD_some] at hG ⊢
      by_cases hbk : b < k
      · rw [List.getElem?_append_left (by simp; omega), List.getElem?_take_of_lt hbk] at hG
        exact hG
      · rw [List.getElem?_append_right (by simp; omega)] at hG
        by_cases hb : b = k
        · subst hb
          have hl : (col.take b).length = b := List.length_take_of_le hk
          simp only [hl, Nat.sub_self, List.getElem?_cons_zero, Option.bind_some] at hG
          cases π with
          | nil => exact absurd rfl hne
          | cons x π => rw [forestAt_empty_node_cons] at hG; simp at hG
        · rw [List.length_take_of_le hk, List.getElem?_eq_none (by simp; omega)] at hG; simp at hG
    · simp at hG
  | (ci, ei) :: ρ, (a, b) :: π, .node cols, G', ⟨col, hcol, hk⟩, hpre, hne, hG => by
    rw [colAt_node_cons] at hcol
    obtain ⟨x, hx, hcolx⟩ := Option.bind_eq_some_iff.1 hcol
    obtain ⟨colc, hc, hx'⟩ := Option.bind_eq_some_iff.1 hx
    obtain ⟨q, H⟩ := x
    have hci : ci < cols.length := (List.getElem?_eq_some_iff.1 hc).1
    have hei : ei < colc.length := (List.getElem?_eq_some_iff.1 hx').1
    have hget : (cols.getD ci [])[ei]? = some (q, H) := by
      rw [List.getD_eq_getElem?_getD, hc, Option.getD_some]; exact hx'
    rw [litCapAux_cons k p ci ei j ρ cols hget, forestAt_node_cons,
      list_getElem?_take_snoc _ _ _ hci.le] at hG
    rw [forestAt_node_cons]
    split_ifs at hG with h1 h2
    · exact hG
    · subst h2
      rw [hc]
      simp only [Option.bind_some, List.getD_eq_getElem?_getD, hc, Option.getD_some] at hG ⊢
      rw [list_getElem?_take_snoc _ _ _ hei.le] at hG
      split_ifs at hG with h3 h4
      · simpa [List.getElem?_take_of_lt h3] using hG
      · subst h4
        rw [hx']
        simp only [Option.bind_some] at hG ⊢
        exact forestAt_litCapAux_off k p j ρ π H G' ⟨col, hcolx, hk⟩
          (fun h => hpre (List.cons_prefix_cons.2 ⟨rfl, h⟩))
          (fun h => hne (by rw [h]; rfl)) hG
      · simp at hG
    · simp at hG

theorem colAt_litCapAux_self {E : Forest} {c : ColAddr} {col : Column} (hcol : E.colAt c = some col)
    (k p : Nat) : (litCapAux k p c.path c.col E).colAt c = some (col.take k ++ [(p, Tree.empty)]) := by
  simp only [Tree.colAt]
  rw [forestAt_litCapAux_prefix k p c.col c.path c.path E (List.prefix_refl _) ⟨col, hcol⟩]
  simp only [Tree.colAt] at hcol
  obtain ⟨G, hG, hGc⟩ := Option.bind_eq_some_iff.1 hcol
  rw [hG]
  obtain ⟨gcols⟩ := G
  have hj : c.col < gcols.length := (List.getElem?_eq_some_iff.1 hGc).1
  simp only [Option.map_some, Option.bind_some, List.drop_length, litCapAux_nil, Tree.cols]
  rw [list_getElem?_take_snoc _ _ _ hj.le, if_neg (lt_irrefl _), if_pos rfl]
  simp only [Tree.cols] at hGc
  simp [List.getD_eq_getElem?_getD, hGc]

/-- helper: an entry of a literal cap is the appended closing slot, a container of the cap
column, or an unchanged entry of `E`. -/
theorem entryAt_litCap_cases {E : Forest} {c : ColAddr} {col : Column} (hcol : E.colAt c = some col)
    {k p : Nat} (hk : k ≤ col.length) {e : EntryAddr} {x : Nat × Forest} (h : (litCap E c k p).entryAt e = some x) :
    e = ⟨c, k⟩ ∨ e.heightPath <+: c.path ∨ E.entryAt e = some x := by
  rw [litCap_eq_aux hcol] at h
  obtain ⟨⟨π, cc⟩, idx⟩ := e
  simp only [Tree.entryAt, Tree.colAt, Option.bind_eq_some_iff] at h
  obtain ⟨colx, ⟨G', hG', hcc⟩, hidx⟩ := h
  by_cases hpre : π <+: c.path
  · rw [forestAt_litCapAux_prefix k p c.col c.path π E hpre ⟨col, hcol⟩] at hG'
    obtain ⟨G, hG, rfl⟩ := Option.map_eq_some_iff.1 hG'
    obtain ⟨rest, hrest⟩ := hpre
    have hdrop : c.path.drop π.length = rest := by rw [← hrest]; simp
    rw [hdrop] at hcc
    have hEc : G.colAt ⟨rest, c.col⟩ = some col := by
      rw [← hcol]; simp only [Tree.colAt]; rw [← hrest, Tree.forestAt_append, hG]; rfl
    obtain ⟨gcols⟩ := G
    cases rest with
    | nil =>
      rw [colAt_node_nil] at hEc
      have hj : c.col < gcols.length := (List.getElem?_eq_some_iff.1 hEc).1
      simp only [List.append_nil] at hrest
      rw [litCapAux_nil] at hcc
      simp only [Tree.cols] at hcc
      rw [list_getElem?_take_snoc _ _ _ hj.le] at hcc
      split_ifs at hcc with h1 h2
      · right; right
        simp only [Tree.entryAt, Tree.colAt, hG, Option.bind_some, Tree.cols, hcc, hidx]
      · subst h2
        obtain rfl := Option.some.inj hcc
        simp only [List.getD_eq_getElem?_getD, hEc, Option.getD_some] at hidx
        by_cases hik : idx < k
        · right; right
          rw [List.getElem?_append_left (by simp; omega), List.getElem?_take_of_lt hik] at hidx
          simp only [Tree.entryAt, Tree.colAt, hG, Option.bind_some, Tree.cols, hEc, hidx]
        · rw [List.getElem?_append_right (by simp; omega)] at hidx
          by_cases hi : idx = k
          · left; subst hi; subst hrest; rfl
          · rw [List.length_take_of_le hk, List.getElem?_eq_none (by simp; omega)] at hidx
            simp at hidx
    | cons ce rest =>
      obtain ⟨ci, ei⟩ := ce
      rw [colAt_node_cons] at hEc
      obtain ⟨y, hy, hcoly⟩ := Option.bind_eq_some_iff.1 hEc
      obtain ⟨colc, hc, hy'⟩ := Option.bind_eq_some_iff.1 hy
      obtain ⟨q, H⟩ := y
      have hci : ci < gcols.length := (List.getElem?_eq_some_iff.1 hc).1
      have hei : ei < colc.length := (List.getElem?_eq_some_iff.1 hy').1
      have hget : (gcols.getD ci [])[ei]? = some (q, H) := by
        rw [List.getD_eq_getElem?_getD, hc, Option.getD_some]; exact hy'
      rw [litCapAux_cons k p ci ei c.col rest gcols hget] at hcc
      simp only [Tree.cols] at hcc
      rw [list_getElem?_take_snoc _ _ _ hci.le] at hcc
      split_ifs at hcc with h1 h2
      · right; right
        simp only [Tree.entryAt, Tree.colAt, hG, Option.bind_some, Tree.cols, hcc, hidx]
      · subst h2
        obtain rfl := Option.some.inj hcc
        simp only [List.getD_eq_getElem?_getD, hc, Option.getD_some] at hidx
        rw [list_getElem?_take_snoc _ _ _ hei.le] at hidx
        split_ifs at hidx with h3 h4
        · right; right
          simp only [Tree.entryAt, Tree.colAt, hG, Option.bind_some, Tree.cols, hc, hidx]
        · subst h4
          right; left
          exact ⟨rest, by rw [← hrest]; simp [EntryAddr.heightPath]⟩
  · by_cases hcap : π = c.path ++ [(c.col, k)]
    · exfalso
      subst hcap
      rw [forestAt_through_col, show (⟨c.path, c.col⟩ : ColAddr) = c from rfl,
        colAt_litCapAux_self hcol k p] at hG'
      simp only [Option.bind_some, List.getElem?_append_right (by simp : (col.take k).length ≤ k),
        List.length_take_of_le hk, Nat.sub_self, List.getElem?_cons_zero, forestAt_nil_path,
        Option.some.injEq] at hG'
      subst hG'
      simp [Tree.empty, Tree.cols] at hcc
    · right; right
      have := forestAt_litCapAux_off k p c.col c.path π E G' ⟨col, hcol, hk⟩ hpre hcap hG'
      simp only [Tree.entryAt, Tree.colAt, this, Option.bind_some, hcc, hidx]

theorem entryAt_litCap_closing {E : Forest} {c : ColAddr} {col : Column} (hcol : E.colAt c = some col)
    {k : Nat} (hk : k ≤ col.length) (p : Nat) :
    (litCap E c k p).entryAt ⟨c, k⟩ = some (p, Tree.empty) := by
  rw [litCap_eq_aux hcol]
  simp only [Tree.entryAt]
  rw [colAt_litCapAux_self hcol k p]
  simp [List.getElem?_append_right, List.length_take_of_le hk]

theorem heightAt_of_prefix {E : Forest} {c : ColAddr} {col : Column} (hcol : E.colAt c = some col)
    {e : EntryAddr} (hc : e.heightPath <+: c.path) : ∃ q H, E.entryAt e = some (q, H) := by
  obtain ⟨ρ, hρ⟩ := hc
  simp only [Tree.colAt] at hcol
  rw [← hρ, Tree.forestAt_append, Tree.forestAt_heightPath] at hcol
  cases hH : E.heightAt e with
  | none => rw [hH] at hcol; simp at hcol
  | some H =>
    simp only [Tree.heightAt, Option.map_eq_some_iff] at hH
    obtain ⟨⟨q, H'⟩, h1, h2⟩ := hH
    exact ⟨q, H', h1⟩

theorem entryAt_litCap_container {E : Forest} {c : ColAddr} {col : Column}
    (hcol : E.colAt c = some col) {k p : Nat} {e : EntryAddr} {ρ : List (Nat × Nat)}
    (hρ : e.heightPath ++ ρ = c.path) {q : Nat} {J : Forest} (he : E.entryAt e = some (q, J)) :
    (litCap E c k p).entryAt e = some (q, litCapAux k p ρ c.col J) := by
  rw [litCap_eq_aux hcol]
  have hpre : e.col.path <+: c.path := ⟨(e.col.col, e.idx) :: ρ, by rw [← hρ]; simp [EntryAddr.heightPath]⟩
  simp only [Tree.entryAt, Tree.colAt] at he ⊢
  rw [forestAt_litCapAux_prefix k p c.col c.path e.col.path E hpre ⟨col, hcol⟩]
  obtain ⟨colx, ⟨G, hG, hGc⟩, hx⟩ := by simpa only [Option.bind_eq_some_iff] using he
  rw [hG]
  have hdrop : c.path.drop e.col.path.length = (e.col.col, e.idx) :: ρ := by
    rw [← hρ]; simp [EntryAddr.heightPath]
  obtain ⟨gcols⟩ := G
  have hget : (gcols.getD e.col.col [])[e.idx]? = some (q, J) := by
    simp only [Tree.cols] at hGc; rw [List.getD_eq_getElem?_getD, hGc, Option.getD_some]; exact hx
  simp only [Option.map_some, Option.bind_some, hdrop]
  rw [litCapAux_cons k p e.col.col e.idx c.col ρ gcols hget]
  simp only [Tree.cols] at hGc ⊢
  have hci : e.col.col < gcols.length := (List.getElem?_eq_some_iff.1 hGc).1
  have hei : e.idx < colx.length := (List.getElem?_eq_some_iff.1 hx).1
  rw [list_getElem?_take_snoc _ _ _ hci.le, if_neg (lt_irrefl _), if_pos rfl]
  simp only [Option.bind_some, List.getD_eq_getElem?_getD, hGc, Option.getD_some]
  rw [list_getElem?_take_snoc _ _ _ hei.le, if_neg (lt_irrefl _), if_pos rfl]

theorem relKey_empty_lt {a b : Nat} {H : Forest} (h : Tree.empty < H) :
    relKey a Tree.empty < relKey b H := by
  obtain ⟨cols⟩ := H
  cases cols with
  | nil => exact absurd h (lt_irrefl _)
  | cons c cs => rfl

theorem empty_le_forest (H : Forest) : (Tree.empty : Forest) ≤ H := by
  by_cases h : H = Tree.empty
  · rw [h]
  · exact le_of_lt (Forest.empty_lt h)

-- provides: U2, L3.1e (`upward_condS`†, txt:274-282)
theorem upward_condS {E : Forest} (hV : CondV E) (hI : CondI E) (hH : CondH E) (hP : CondP E)
    {c : ColAddr} {k p : Nat} (hup : IsUpward E c k p) (hKV : CondV (litCap E c k p))
    (hKI : CondI (litCap E c k p)) : CondS (litCap E c k p) := by
  obtain ⟨col, hcol, hk, hq⟩ := isUpward_iff_exists.1 hup
  have hS := condS_of_condP hV hI hH hP
  intro e₀ he₀ e he hown
  have hown' := hown
  obtain ⟨hc, q, J', hJ', hres⟩ := hown
  obtain ⟨⟨p₀, H₀'⟩, hx₀⟩ := Option.isSome_iff_exists.1 ((Tree.mem_entryAddrs_iff _ _).1 he₀)
  rw [heightAt_of_entryAt hJ', heightAt_of_entryAt hx₀, Option.getD_some, Option.getD_some]
  have hmemE : ∀ f : EntryAddr, (E.entryAt f).isSome → f ∈ E.entryAddrs :=
    fun f h => (Tree.mem_entryAddrs_iff _ _).2 h
  -- the closing slot has an empty height, so it is not an owner
  have hne₀ : e₀ ≠ ⟨c, k⟩ := by
    rintro rfl
    obtain ⟨H, hH', hHne⟩ := height_ne_of_contains hc (by rw [hJ']; rfl)
    rw [heightAt_of_entryAt (entryAt_litCap_closing hcol hk p)] at hH'
    exact hHne (Option.some.inj hH').symm
  by_cases hcont₀ : e₀.heightPath <+: c.path
  · obtain ⟨ρ₀, hρ₀⟩ := hcont₀
    obtain ⟨p₁, H₀, hE₀⟩ := heightAt_of_prefix hcol ⟨ρ₀, hρ₀⟩
    rw [entryAt_litCap_container hcol hρ₀ hE₀] at hx₀
    obtain ⟨rfl, rfl⟩ := Prod.mk.inj (Option.some.inj hx₀)
    -- the cap strictly raises the owner height
    have hcol₀ : H₀.colAt ⟨ρ₀, c.col⟩ = some col := by
      rw [← hcol]; simp only [Tree.colAt]
      rw [← hρ₀, Tree.forestAt_append, Tree.forestAt_heightPath, heightAt_of_entryAt hE₀]; rfl
    have hup₀ : IsUpward H₀ ⟨ρ₀, c.col⟩ k p := isUpward_iff_exists.2 ⟨col, hcol₀, hk, hq⟩
    have hlt₀ : H₀ < litCapAux k p ρ₀ c.col H₀ := by
      have := lt_litCap hup₀; rwa [litCap_eq_aux hcol₀] at this
    have hkey₀ := (relKey_lt_iff (e₀.col.num 0) _ _).2 hlt₀
    rcases entryAt_litCap_cases hcol hk hJ' with rfl | hcont | hEe
    · rw [entryAt_litCap_closing hcol hk p] at hJ'
      obtain ⟨-, rfl⟩ := Prod.mk.inj (Option.some.inj hJ')
      exact relKey_empty_lt (lt_of_le_of_lt (empty_le_forest H₀) hlt₀)
    · obtain ⟨ρ, hρ⟩ := hcont
      obtain ⟨q₁, J, hEe⟩ := heightAt_of_prefix hcol ⟨ρ, hρ⟩
      rw [entryAt_litCap_container hcol hρ hEe] at hJ'
      obtain ⟨rfl, rfl⟩ := Prod.mk.inj (Option.some.inj hJ')
      have hownE : IsOwnerReturn E e₀ e := ⟨hc, q₁, J, hEe, hres⟩
      have hJne : J ≠ Tree.empty := by
        rintro rfl
        have hJc : (Tree.empty : Forest).colAt ⟨ρ, c.col⟩ = some col := by
          rw [← hcol]; simp only [Tree.colAt]
          rw [← hρ, Tree.forestAt_append, Tree.forestAt_heightPath, heightAt_of_entryAt hEe]; rfl
        rw [colAt_empty_none] at hJc; simp at hJc
      obtain ⟨d, m, -, hπ⟩ := profile_of_entry hI hEe hJne
      have hPJ := hP e₀ (hmemE _ (by rw [hE₀]; rfl)) e (hmemE _ (by rw [hEe]; rfl)) hownE
      rw [heightAt_of_entryAt hEe, heightAt_of_entryAt hE₀, Option.getD_some, Option.getD_some,
        hπ] at hPJ
      have h1 := capKey_le_towKey hV hI hH hup hKV hKI ⟨ρ, hρ⟩ hEe hπ
      rw [heightAt_of_entryAt (entryAt_litCap_container hcol hρ hEe), Option.getD_some] at h1
      exact lt_of_le_of_lt (le_trans h1 (towKey_le_relKey hV hI hH hE₀ hPJ)) hkey₀
    · have hownE : IsOwnerReturn E e₀ e := ⟨hc, q, J', hEe, hres⟩
      have := hS e₀ (hmemE _ (by rw [hE₀]; rfl)) e (hmemE _ (by rw [hEe]; rfl)) hownE
      rw [heightAt_of_entryAt hEe, heightAt_of_entryAt hE₀, Option.getD_some, Option.getD_some] at this
      exact lt_trans this hkey₀
  · have hE₀ : E.entryAt e₀ = some (p₀, H₀') := by
      rcases entryAt_litCap_cases hcol hk hx₀ with h | h | h
      · exact absurd h hne₀
      · exact absurd h hcont₀
      · exact h
    have hEe : E.entryAt e = some (q, J') := by
      rcases entryAt_litCap_cases hcol hk hJ' with h | h | h
      · exfalso; subst h; exact hcont₀ hc
      · exfalso; apply hcont₀
        exact hc.trans ((List.prefix_append _ _).trans h)
      · exact h
    have hownE : IsOwnerReturn E e₀ e := ⟨hc, q, J', hEe, hres⟩
    have := hS e₀ (hmemE _ (by rw [hE₀]; rfl)) e (hmemE _ (by rw [hEe]; rfl)) hownE
    rwa [heightAt_of_entryAt hEe, heightAt_of_entryAt hE₀, Option.getD_some, Option.getD_some] at this


/-! ### L3.1f helpers -/

theorem list_append_lt_append_iff {α : Type} [LinearOrder α] (T : List α) {U V : List α} :
    T ++ U < T ++ V ↔ U < V := by
  induction T with
  | nil => rfl
  | cons t T ih => simp only [List.cons_append, List.cons_lt_cons_iff, lt_irrefl, false_or, true_and, ih]

theorem list_between {α : Type} [LinearOrder α] :
    ∀ (T R S W : List α), ¬ W < T ++ R → W < T ++ S → ∃ U, W = T ++ U
  | [], _, _, W, _, _ => ⟨W, rfl⟩
  | t :: T, R, S, [], h1, _ => by
    exfalso; exact h1 (List.nil_lt_cons _ _)
  | t :: T, R, S, w :: W, h1, h2 => by
    simp only [List.cons_append] at h1 h2
    rw [List.cons_lt_cons_iff] at h1 h2
    rcases h2 with h2 | ⟨rfl, h2⟩
    · exact absurd (Or.inl h2) h1
    · obtain ⟨U, rfl⟩ := list_between T R S W (fun h => h1 (Or.inr ⟨rfl, h⟩)) h2
      exact ⟨U, rfl⟩

theorem capAtom_eq_if (c : ColAddr) (k p : Nat) :
    capAtom c k p = (if decide (k = 0) = true then toLex (2 * colDepth c, toLex (1, p))
      else toLex (2 * colDepth c + 1, toLex (0, p))) := by
  unfold capAtom; simp only [decide_eq_true_eq]

theorem word_le_of_le {X Y : Forest} (h : X ≤ Y) : word X ≤ word Y := by
  rcases lt_or_eq_of_le h with h | rfl
  · exact le_of_lt ((word_lt_iff X Y).2 h)
  · exact le_refl _

-- L3.1f (txt:286-288): the interval fact
theorem interval_cap {X Y : Forest} {c : ColAddr} {k p : Nat} (hup : IsUpward X c k p)
    (hXY : X ≤ Y) (hYC : Y < litCap X c k p) :
    IsUpward Y c k p ∧ litCap Y c k p = litCap X c k p := by
  obtain ⟨col, hcol, hk, hq⟩ := isUpward_iff_exists.1 hup
  obtain ⟨R, hwX, hcap, hnext, hle⟩ := litCap_word_data hcol hk
  set T := (word X).take (capPos X c k) with hT
  have hTl : T.length = capPos X c k := List.length_take_of_le hle
  have h1 : ¬ word Y < T ++ R := by rw [← hwX]; exact not_lt.2 (word_le_of_le hXY)
  have h2 : word Y < T ++ [capAtom c k p] := by rw [← hcap p]; exact (word_lt_iff _ _).2 hYC
  obtain ⟨U, hU⟩ := list_between T R [capAtom c k p] (word Y) h1 h2
  rw [hU] at h1 h2
  rw [list_append_lt_append_iff] at h2
  rw [list_append_lt_append_iff] at h1
  have hUz : ∀ y, U.head? = some y → y < capAtom c k p := by
    intro y hy
    cases U with
    | nil => simp at hy
    | cons u U =>
      simp only [List.head?_cons, Option.some.injEq] at hy; subst hy
      rcases List.cons_lt_cons_iff.1 h2 with h | ⟨-, h⟩
      · exact h
      · exact absurd h (List.not_lt_nil _)
  have hat : ∀ y, (word Y)[capPos X c k]? = some y → y < capAtom c k p := by
    intro y hy
    rw [hU, List.getElem?_append_right (by omega), hTl, Nat.sub_self, ← List.head?_eq_getElem?] at hy
    exact hUz y hy
  have hπ : capPos X c k ≤ mu Y := by
    unfold mu; rw [hU]; simp; omega
  have hwC : word (litCap X c k p) = (word Y).take (capPos X c k) ++
      [if decide (k = 0) then toLex (2 * colDepth c, toLex (1, p))
        else toLex (2 * colDepth c + 1, toLex (0, p))] := by
    rw [hcap p, hU, List.take_left' hTl, capAtom_eq_if]
  have hfirst : decide (k = 0) = true → ∃ y, (word Y)[capPos X c k]? = some y ∧
      2 * colDepth c ≤ (ofLex y).1 := by
    intro hk0; simp only [decide_eq_true_eq] at hk0
    subst hk0
    have hR : ∃ r, R.head? = some r ∧ (ofLex r).1 = 2 * colDepth c := by
      cases hc0 : col[0]? with
      | some x =>
        obtain ⟨q, H⟩ := x
        exact ⟨_, hnext.1 q H hc0, by simp [capAtomAt]⟩
      | none =>
        have : col.length = 0 := by
          have := List.getElem?_eq_none_iff.1 hc0; omega
        exact ⟨_, hnext.2.2 this.symm rfl, by simp⟩
    obtain ⟨r, hr, hr'⟩ := hR
    cases R with
    | nil => simp at hr
    | cons r' R =>
      simp only [List.head?_cons, Option.some.injEq] at hr; subst hr
      cases U with
      | nil => exact absurd (List.nil_lt_cons _ _) h1
      | cons u U =>
        refine ⟨u, by rw [hU, List.getElem?_append_right (by omega), hTl]; simp, ?_⟩
        have : r' ≤ u := by
          rw [List.cons_lt_cons_iff] at h1
          exact not_lt.1 (fun h => h1 (Or.inl h))
        rw [Prod.Lex.le_iff] at this
        rcases this with h | ⟨h, -⟩ <;> omega
  have hnext' : ∀ y, (word Y)[capPos X c k]? = some y →
      y < (if decide (k = 0) then toLex (2 * colDepth c, toLex (1, p))
        else toLex (2 * colDepth c + 1, toLex (0, p))) := by
    intro y hy
    rw [← capAtom_eq_if]; exact hat y hy
  obtain ⟨c', k', hc', hk', hd', hkf, hpos, hup', hcapY⟩ :=
    exists_litCap_of_word hwC hπ hnext' hfirst
  obtain ⟨colY, hcolY, hkY, -⟩ := isUpward_iff_exists.1 hup'
  have hs1 := stopData_litCap' hcolY k' p
  have hs2 := stopData_litCap' hcol k p
  rw [hcapY, hs2] at hs1
  simp only [Option.some.injEq, StopData.mk.injEq] at hs1
  obtain ⟨-, rfl, -, -, hQ⟩ := hs1
  have : k' = k := by
    have := congrArg List.length hQ
    rw [List.length_take_of_le hk, List.length_take_of_le hkY] at this; exact this.symm
  subst this
  exact ⟨hup', hcapY⟩


/-! ### L3.1g helpers: the moved tree, read backwards -/

theorem path_split_at {π : List (Nat × Nat)} {d : Nat} (hd : d < π.length) :
    π = π.take d ++ π[d] :: π.drop (d + 1) := by
  conv_lhs => rw [← List.take_append_drop d π, List.drop_eq_getElem_cons hd]


/-- helper: the backward column map of a move. -/
def bwdC (m : Move) (a : ColAddr) : ColAddr := ⟨m.mapPath m.bwdIdx a.path, a.col⟩

theorem mapPath_length (g : Nat → Nat) (m : Move) (π : List (Nat × Nat)) :
    (m.mapPath g π).length = π.length := by
  rcases mapPath_cases m π with ⟨e, D, rfl⟩ | h
  · simp [mapPath_through]
  · rw [mapPath_off g m π h]

theorem mapPath_fst (g : Nat → Nat) (m : Move) (π : List (Nat × Nat)) :
    (m.mapPath g π).map Prod.fst = π.map Prod.fst := by
  rcases mapPath_cases m π with ⟨e, D, rfl⟩ | h
  · simp [mapPath_through]
  · rw [mapPath_off g m π h]

theorem mapPath_getElem_fst (g : Nat → Nat) (m : Move) (π : List (Nat × Nat)) (k : Nat) :
    ((m.mapPath g π)[k]?).map Prod.fst = (π[k]?).map Prod.fst := by
  rw [← List.getElem?_map, ← List.getElem?_map, mapPath_fst]

theorem take_append_cons {α : Type} (P D : List α) (x : α) {n : Nat} (hn : P.length < n) :
    (P ++ x :: D).take n = P ++ x :: D.take (n - P.length - 1) := by
  rw [List.take_append, List.take_of_length_le (by omega),
    show n - P.length = (n - P.length - 1) + 1 by omega, List.take_succ_cons, Nat.add_sub_cancel]

theorem mapPath_take (g : Nat → Nat) (m : Move) (π : List (Nat × Nat)) (n : Nat) :
    (m.mapPath g π).take n = m.mapPath g (π.take n) := by
  rcases mapPath_cases m π with ⟨e, D, rfl⟩ | h
  · rw [mapPath_through]
    by_cases hn : n ≤ m.col.path.length
    · rw [List.take_append_of_le_length hn, List.take_append_of_le_length hn,
        mapPath_off g m _ (fun e' D' he => by
          have := congrArg List.length he; simp at this; omega)]
    · rw [take_append_cons _ _ _ (by omega), take_append_cons _ _ _ (by omega), mapPath_through]
  · rw [mapPath_off g m π h]
    by_cases ht : ∃ e D, π.take n = m.col.path ++ (m.col.col, e) :: D
    · obtain ⟨e, D, hD⟩ := ht
      exfalso; apply h e (D ++ π.drop n)
      conv_lhs => rw [← List.take_append_drop n π, hD]
      simp
    · rw [mapPath_off g m _ (fun e D he => ht ⟨e, D, he⟩)]

theorem num_bwdC (m : Move) (a : ColAddr) (b : Nat) : (bwdC m a).num b = a.num b := by
  simp only [bwdC, ColAddr.num]
  have := congrArg (fun l => (l.map (· + 1)).sum) (mapPath_fst m.bwdIdx m a.path)
  simp only [List.map_map] at this
  rw [show (fun x : Nat × Nat => x.1 + 1) = ((· + 1) ∘ Prod.fst) from rfl, this]

theorem bwdC_col (m : Move) : bwdC m m.col = m.col := by
  simp only [bwdC]
  rw [mapPath_off _ _ _ (fun e D he => by have := congrArg List.length he; simp at this)]

/-- helper: columns of a forest after `modifyColAux` keep their parent labels. -/
theorem cols_modifyColAux_labels (f : Column → Column) (cc : Nat) (Q : List (Nat × Nat)) (G : Forest)
    (c' : Nat) (h : ¬ (Q = [] ∧ c' = cc)) :
    ((modifyColAux f Q cc G).cols[c']?).map (·.map Prod.fst) = (G.cols[c']?).map (·.map Prod.fst) := by
  obtain ⟨cols⟩ := G
  cases Q with
  | nil =>
    simp only [modifyColAux, Tree.cols]
    rw [list_getElem?_modify_ne _ _ (fun h' => h ⟨rfl, h'.symm⟩)]
  | cons ab Q =>
    obtain ⟨a, b⟩ := ab
    simp only [modifyColAux, Tree.cols]
    by_cases ha : a = c'
    · subst ha; rw [list_getElem?_modify_self]
      cases cols[a]? with
      | none => rfl
      | some col =>
        simp only [Option.map_some, Option.some.injEq]
        apply List.ext_getElem?
        intro n
        simp only [List.getElem?_map, List.getElem?_modify]
        cases col[n]? with
        | none => rfl
        | some v => simp only [Option.map_some]; split <;> rfl
    · rw [list_getElem?_modify_ne _ _ ha]

theorem cols_modifyColAux_entry (f : Column → Column) (cc : Nat) (Q : List (Nat × Nat)) (G : Forest)
    (c' idx : Nat) (h : ¬ (Q = [] ∧ c' = cc)) (h' : ¬ [(c', idx)] <+: Q) :
    ((modifyColAux f Q cc G).cols[c']?).bind (·[idx]?) = (G.cols[c']?).bind (·[idx]?) := by
  obtain ⟨cols⟩ := G
  cases Q with
  | nil =>
    simp only [modifyColAux, Tree.cols]
    rw [list_getElem?_modify_ne _ _ (fun h'' => h ⟨rfl, h''.symm⟩)]
  | cons ab Q =>
    obtain ⟨a, b⟩ := ab
    simp only [modifyColAux, Tree.cols]
    by_cases ha : a = c'
    · subst ha; rw [list_getElem?_modify_self]
      cases cols[a]? with
      | none => rfl
      | some col =>
        simp only [Option.map_some, Option.bind_some]
        have hb : b ≠ idx := by
          rintro rfl; exact h' (List.cons_prefix_cons.2 ⟨rfl, List.nil_prefix⟩)
        rw [list_getElem?_modify_ne _ _ hb]
    · rw [list_getElem?_modify_ne _ _ ha]

theorem forestAt_mod_corr {K : Forest} {m : Move} {col : Column} (hcol : K.colAt m.col = some col)
    (hij : m.i < m.j) (hj : m.j < col.length) :
    ∀ π G', (modifyColAux (moveFun m) m.col.path m.col.col K).forestAt π = some G' →
      ∃ G, K.forestAt (m.mapPath m.bwdIdx π) = some G ∧ G'.cols.length = G.cols.length ∧
        ∀ c', ¬ (π = m.col.path ∧ c' = m.col.col) →
          (G'.cols[c']?).map (·.map Prod.fst) = (G.cols[c']?).map (·.map Prod.fst) ∧
          ∀ idx, ¬ (π ++ [(c', idx)] <+: m.col.path) →
            (G'.cols[c']?).bind (·[idx]?) = (G.cols[c']?).bind (·[idx]?) := by
  intro π G' hG'
  by_cases h1 : π <+: m.col.path
  · rw [forestAt_modifyColAux_prefix _ _ _ _ _ h1] at hG'
    obtain ⟨G, hG, rfl⟩ := Option.map_eq_some_iff.1 hG'
    have hoff : ∀ e D, π ≠ m.col.path ++ (m.col.col, e) :: D := by
      intro e D he; have := h1.length_le; rw [he] at this; simp at this
    refine ⟨G, by rw [mapPath_off _ _ _ hoff]; exact hG, cols_length_modifyColAux _ _ _ _, ?_⟩
    obtain ⟨Q, hQ⟩ := h1
    have hdrop : m.col.path.drop π.length = Q := by rw [← hQ]; simp
    rw [hdrop]
    intro c' hc'
    have hne : ¬ (Q = [] ∧ c' = m.col.col) := by
      rintro ⟨rfl, h⟩; exact hc' ⟨by simpa using hQ, h⟩
    refine ⟨cols_modifyColAux_labels _ _ _ _ _ hne, fun idx hidx => ?_⟩
    apply cols_modifyColAux_entry _ _ _ _ _ _ hne
    intro hpre; apply hidx; rw [← hQ]; exact (List.prefix_append_right_inj π).2 hpre
  by_cases h2 : ∃ e D, π = m.col.path ++ (m.col.col, e) :: D
  · obtain ⟨e, D, rfl⟩ := h2
    rw [forestAt_modifyColAux_through, show (⟨m.col.path, m.col.col⟩ : ColAddr) = m.col from rfl,
      hcol] at hG'
    simp only [Option.bind_some, moveFun] at hG'
    rw [getElem?_moveFun m col hij.le hj.le] at hG'
    refine ⟨G', ?_, rfl, fun _ _ => ⟨rfl, fun _ _ => rfl⟩⟩
    rw [mapPath_through, forestAt_through_col, show (⟨m.col.path, m.col.col⟩ : ColAddr) = m.col from rfl,
      hcol]
    exact hG'
  · have hoff : ∀ e D, π ≠ m.col.path ++ (m.col.col, e) :: D := fun e D he => h2 ⟨e, D, he⟩
    rw [forestAt_modifyColAux_off _ _ _ _ _ h1 hoff] at hG'
    exact ⟨G', by rw [mapPath_off _ _ _ hoff]; exact hG', rfl, fun _ _ => ⟨rfl, fun _ _ => rfl⟩⟩

/-- helper: a column of the moved tree read at its backward address. -/
theorem colAt_mod_corr {K : Forest} {m : Move} {col : Column} (hcol : K.colAt m.col = some col)
    (hij : m.i < m.j) (hj : m.j < col.length) {a : ColAddr} {col' : Column}
    (h : (applyMove K m).colAt a = some col') :
    ∃ col0, K.colAt (bwdC m a) = some col0 ∧
      (a = m.col → col' = moveFun m col ∧ col0 = col) ∧
      (a ≠ m.col → col'.map Prod.fst = col0.map Prod.fst ∧
        ∀ idx, ¬ (a.path ++ [(a.col, idx)] <+: m.col.path) → col'[idx]? = col0[idx]?) := by
  rw [applyMove_eq_mod hcol hij hj] at h
  by_cases ha : a = m.col
  · subst ha
    have := colAt_mod_self (moveFun m) K m.col
    rw [hcol, h] at this
    refine ⟨col, by rw [bwdC_col]; exact hcol, fun _ => ⟨Option.some.inj this, rfl⟩, fun h' => absurd rfl h'⟩
  · simp only [Tree.colAt, Option.bind_eq_some_iff] at h
    obtain ⟨G', hG', hc'⟩ := h
    obtain ⟨G, hG, -, hcorr⟩ := forestAt_mod_corr hcol hij hj a.path G' hG'
    have hne : ¬ (a.path = m.col.path ∧ a.col = m.col.col) := by
      rintro ⟨h1, h2⟩; exact ha (by cases a; cases m.col; simp_all)
    obtain ⟨hl, he⟩ := hcorr a.col hne
    rw [hc'] at hl he
    obtain ⟨col0, hcol0, hl0⟩ := Option.map_eq_some_iff.1 hl.symm
    refine ⟨col0, by simp only [Tree.colAt, bwdC, hG, Option.bind_some]; exact hcol0,
      fun h' => absurd h' ha, fun _ => ⟨hl0.symm, fun idx hidx => ?_⟩⟩
    have := he idx hidx
    rw [hcol0] at this
    simpa using this

theorem forestAt_take_some {E : Forest} {π : List (Nat × Nat)} {F : Forest} (h : E.forestAt π = some F)
    (d : Nat) : ∃ G, E.forestAt (π.take d) = some G := by
  rw [← List.take_append_drop d π, Tree.forestAt_append] at h
  cases h' : E.forestAt (π.take d) with
  | none => rw [h'] at h; simp at h
  | some G => exact ⟨G, rfl⟩

theorem mapPath_getElem_of_ne (g : Nat → Nat) (m : Move) (π : List (Nat × Nat)) (d : Nat)
    (h : ¬ (d = m.col.path.length ∧ π.take d = m.col.path)) : (m.mapPath g π)[d]? = π[d]? := by
  rcases mapPath_cases m π with ⟨e, D, rfl⟩ | h'
  · rw [mapPath_through]
    rcases lt_trichotomy d m.col.path.length with hd | hd | hd
    · rw [List.getElem?_append_left hd, List.getElem?_append_left hd]
    · exact absurd ⟨hd, by subst hd; simp⟩ h
    · rw [List.getElem?_append_right hd.le, List.getElem?_append_right hd.le,
        show d - m.col.path.length = (d - m.col.path.length - 1) + 1 by omega]
      rfl
  · rw [mapPath_off g m π h']

/-- helper: the route of `K` passes through the move column, which is the last column of its
forest with last entry `j`. -/
theorem moveOK_route {K : Forest} {m : Move} (hm : MoveOK K m) :
    (∀ d < m.col.path.length, ∃ F, K.forestAt (m.col.path.take d) = some F ∧
      F.lastStep? = m.col.path[d]?) ∧
    ∃ F, K.forestAt m.col.path = some F ∧ F.lastStep? = some (m.col.col, m.j) := by
  obtain ⟨col, sd, hcol, hsd, hj, hij, hpre, -⟩ := hm
  obtain ⟨-, -, -, hmem, -⟩ := stopData_spec hsd
  obtain ⟨hroute, -⟩ := (mem_routeCols_iff K sd.col).1 hmem
  obtain ⟨rest, hrest⟩ := hpre
  simp only [EntryAddr.heightPath, List.append_assoc, List.singleton_append] at hrest
  refine ⟨fun d hd => ?_, ?_⟩
  · obtain ⟨F, hF, hl⟩ := hroute d (by rw [← hrest]; simp; omega)
    refine ⟨F, ?_, ?_⟩
    · rw [← hrest, List.take_append_of_le_length hd.le] at hF; exact hF
    · rw [hl, ← hrest, List.getElem?_append_left hd]
  · obtain ⟨F, hF, hl⟩ := hroute m.col.path.length (by rw [← hrest]; simp)
    refine ⟨F, ?_, ?_⟩
    · rw [← hrest, List.take_left] at hF; exact hF
    · rw [hl, ← hrest]; simp

theorem lastStep_eq {F : Forest} : F.lastStep? = (F.cols[F.cols.length - 1]?).bind fun col =>
    if col.isEmpty then none else some (F.cols.length - 1, col.length - 1) := by
  simp only [Tree.lastStep?, List.getLast?_eq_getElem?]

theorem lastStep_corr {K : Forest} {m : Move} (hm : MoveOK K m) {col : Column}
    (hcol : K.colAt m.col = some col) (hij : m.i < m.j) (hj : m.j + 1 = col.length)
    {π : List (Nat × Nat)} {G' G : Forest}
    (hG' : (modifyColAux (moveFun m) m.col.path m.col.col K).forestAt π = some G')
    (hG : K.forestAt (m.mapPath m.bwdIdx π) = some G) (hlen : G'.cols.length = G.cols.length)
    (hcorr : ∀ c', ¬ (π = m.col.path ∧ c' = m.col.col) →
      (G'.cols[c']?).map (·.map Prod.fst) = (G.cols[c']?).map (·.map Prod.fst)) :
    (π = m.col.path → G'.lastStep? = some (m.col.col, m.i) ∧ G.lastStep? = some (m.col.col, m.j)) ∧
    (π ≠ m.col.path → G'.lastStep? = G.lastStep?) := by
  constructor
  · rintro rfl
    obtain ⟨-, F, hF, hlF⟩ := moveOK_route hm
    rw [mapPath_off _ _ _ (fun e D he => by have := congrArg List.length he; simp at this), hF] at hG
    obtain rfl := Option.some.inj hG
    refine ⟨?_, hlF⟩
    have hG'c : G'.cols[m.col.col]? = some (moveFun m col) := by
      have := colAt_mod_self (moveFun m) K m.col
      rw [hcol] at this
      simp only [Tree.colAt, hG', Option.bind_some] at this; exact this
    have hFc : F.cols[m.col.col]? = some col := by
      simp only [Tree.colAt, hF, Option.bind_some] at hcol; exact hcol
    rw [lastStep_eq] at hlF ⊢
    obtain ⟨colL, hL, hls⟩ := Option.bind_eq_some_iff.1 hlF
    split_ifs at hls with hne
    obtain ⟨h1, h2⟩ := Prod.mk.inj (Option.some.inj hls)
    rw [hlen, h1, hG'c]
    simp only [Option.bind_some]
    have hmf : (moveFun m col).length = m.i + 1 := by
      simp only [moveFun, List.length_append, List.length_take, List.length_drop]; omega
    rw [hmf, if_neg (by simp [List.isEmpty_iff, ← List.length_eq_zero_iff, hmf])]
    rfl
  · intro hπ
    rw [lastStep_eq, lastStep_eq, hlen]
    have h := hcorr (G.cols.length - 1) (fun h => hπ h.1)
    cases h1 : G'.cols[G.cols.length - 1]? with
    | none =>
      rw [h1] at h
      cases h2 : G.cols[G.cols.length - 1]? with
      | none => rfl
      | some c => rw [h2] at h; simp at h
    | some c' =>
      rw [h1] at h
      cases h2 : G.cols[G.cols.length - 1]? with
      | none => rw [h2] at h; simp at h
      | some c =>
        rw [h2] at h
        have hl : c'.length = c.length := by
          have := congrArg List.length (Option.some.inj h); simpa using this
        simp only [Option.bind_some, List.isEmpty_iff, ← List.length_eq_zero_iff, hl]

theorem routeCols_corr {K : Forest} {m : Move} (hm : MoveOK K m) {col : Column}
    (hcol : K.colAt m.col = some col) (hij : m.i < m.j) (hj : m.j + 1 = col.length) {a : ColAddr}
    (ha : ((applyMove K m).colAt a).isSome) :
    a ∈ routeCols (applyMove K m) ↔ bwdC m a ∈ routeCols K := by
  have hj' : m.j < col.length := by omega
  rw [mem_routeCols_iff, mem_routeCols_iff]
  rw [applyMove_eq_mod hcol hij hj'] at ha ⊢
  obtain ⟨col', hcol'⟩ := Option.isSome_iff_exists.1 ha
  simp only [Tree.colAt, Option.bind_eq_some_iff] at hcol'
  obtain ⟨F'0, hF'0, -⟩ := hcol'
  obtain ⟨F0, hF0, hlen0, -⟩ := forestAt_mod_corr hcol hij hj' a.path F'0 hF'0
  have hroute : Scan.IsRoutePath (modifyColAux (moveFun m) m.col.path m.col.col K) a.path ↔
      Scan.IsRoutePath K (m.mapPath m.bwdIdx a.path) := by
    simp only [Scan.IsRoutePath, mapPath_length]
    refine forall_congr' fun d => forall_congr' fun hd => ?_
    obtain ⟨G', hG'⟩ := forestAt_take_some hF'0 d
    obtain ⟨G, hG, hlen, hcorr⟩ := forestAt_mod_corr hcol hij hj' _ G' hG'
    have hG2 : K.forestAt ((m.mapPath m.bwdIdx a.path).take d) = some G := by
      rw [mapPath_take]; exact hG
    have hls := lastStep_corr hm hcol hij hj hG' hG hlen (fun c' h => (hcorr c' h).1)
    constructor
    · rintro ⟨G₁, hG₁, hl₁⟩
      rw [hG'] at hG₁; obtain rfl := Option.some.inj hG₁
      refine ⟨G, hG2, ?_⟩
      by_cases hP : a.path.take d = m.col.path
      · obtain ⟨h1, h2⟩ := hls.1 hP
        rw [h1] at hl₁; rw [h2]
        have hdL : d = m.col.path.length := by
          have := congrArg List.length hP; simp at this; omega
        have hx : a.path[d] = (m.col.col, m.i) := by
          have := hl₁.symm; rw [List.getElem?_eq_getElem hd] at this; exact Option.some.inj this
        have hsplit : a.path = m.col.path ++ (m.col.col, m.i) :: a.path.drop (d + 1) := by
          conv_lhs => rw [path_split_at hd]
          rw [hP, hx]
        rw [hsplit, mapPath_through]
        have : m.bwdIdx m.i = m.j := by unfold Move.bwdIdx; rw [if_pos le_rfl]; omega
        rw [this, hdL]; simp
      · rw [← hls.2 hP, hl₁]
        exact (mapPath_getElem_of_ne m.bwdIdx m a.path d (fun h => hP h.2)).symm
    · rintro ⟨G₁, hG₁, hl₁⟩
      rw [hG2] at hG₁; obtain rfl := Option.some.inj hG₁
      refine ⟨G', hG', ?_⟩
      by_cases hP : a.path.take d = m.col.path
      · obtain ⟨h1, h2⟩ := hls.1 hP
        rw [h2] at hl₁; rw [h1]
        have hdL : d = m.col.path.length := by
          have := congrArg List.length hP; simp at this; omega
        obtain ⟨x, hx⟩ : ∃ x, a.path[d]? = some x := ⟨_, List.getElem?_eq_getElem hd⟩
        have hsplit : a.path = m.col.path ++ x :: a.path.drop (d + 1) := by
          conv_lhs => rw [path_split_at hd]
          rw [hP, (List.getElem?_eq_some_iff.1 hx).2]
        obtain ⟨x1, x2⟩ := x
        by_cases hx1 : x1 = m.col.col
        · subst hx1
          rw [hsplit, mapPath_through, hdL] at hl₁
          simp only [List.getElem?_append_right le_rfl, Nat.sub_self, List.getElem?_cons_zero,
            Option.some.injEq, Prod.mk.injEq, true_and] at hl₁
          have hx2 : x2 = m.i := by unfold Move.bwdIdx at hl₁; split_ifs at hl₁ <;> omega
          rw [hx, hx2]
        · exfalso
          rw [hsplit, mapPath_off _ _ _ (fun e D he => by
            simp only [List.append_cancel_left_eq, List.cons.injEq, Prod.mk.injEq] at he
            exact hx1 he.1.1), hdL] at hl₁
          simp at hl₁; exact hx1 hl₁.1.symm
      · rw [hls.2 hP, hl₁]
        exact mapPath_getElem_of_ne m.bwdIdx m a.path d (fun h => hP h.2)
  rw [hroute]
  apply and_congr_right
  intro _
  constructor
  · rintro ⟨F, hF, hFl⟩; rw [hF'0] at hF; obtain rfl := Option.some.inj hF
    exact ⟨F0, hF0, hlen0 ▸ hFl⟩
  · rintro ⟨F, hF, hFl⟩; simp only [bwdC] at hF hFl; rw [hF0] at hF; obtain rfl := Option.some.inj hF
    exact ⟨F'0, hF'0, hlen0.symm ▸ hFl⟩

/-- helper: in `K`, every column containing the move column is a route column whose last entry
contains it (the move column itself is a route column). -/
theorem container_route_K {K : Forest} {m : Move} (hm : MoveOK K m) {a : ColAddr} {idx : Nat}
    (h : a.path ++ [(a.col, idx)] <+: m.col.path ∨ (a = m.col ∧ idx = m.j)) :
    a ∈ routeCols K ∧ ∃ col0, K.colAt a = some col0 ∧ idx + 1 = col0.length := by
  obtain ⟨hlev, F, hF, hlF⟩ := moveOK_route hm
  rcases h with ⟨rest, hrest⟩ | ⟨rfl, rfl⟩
  · have hd : a.path.length < m.col.path.length := by rw [← hrest]; simp
    have htake : m.col.path.take a.path.length = a.path := by rw [← hrest]; simp
    have hget : m.col.path[a.path.length]? = some (a.col, idx) := by rw [← hrest]; simp
    obtain ⟨G, hG, hlG⟩ := hlev a.path.length hd
    rw [htake] at hG
    rw [hget, lastStep_eq] at hlG
    obtain ⟨colL, hL, hls⟩ := Option.bind_eq_some_iff.1 hlG
    split_ifs at hls with hne
    obtain ⟨h1, h2⟩ := Prod.mk.inj (Option.some.inj hls)
    refine ⟨(mem_routeCols_iff K a).2 ⟨fun d hd' => ?_, G, hG, by
      have := (List.getElem?_eq_some_iff.1 hL).1; omega⟩, colL, ?_, ?_⟩
    · obtain ⟨G₁, hG₁, hl₁⟩ := hlev d (by omega)
      refine ⟨G₁, ?_, ?_⟩
      · rw [← htake, List.take_take, Nat.min_eq_left hd'.le]; exact hG₁
      · rw [hl₁, ← htake, List.getElem?_take_of_lt hd']
    · simp only [Tree.colAt, hG, Option.bind_some]; rw [← h1]; exact hL
    · have : colL.length ≠ 0 := by simpa [List.isEmpty_iff, ← List.length_eq_zero_iff] using hne
      omega
  · rw [lastStep_eq] at hlF
    obtain ⟨colL, hL, hls⟩ := Option.bind_eq_some_iff.1 hlF
    split_ifs at hls with hne
    obtain ⟨h1, h2⟩ := Prod.mk.inj (Option.some.inj hls)
    refine ⟨(mem_routeCols_iff K m.col).2 ⟨hlev, F, hF, by
      have := (List.getElem?_eq_some_iff.1 hL).1; omega⟩, colL, ?_, ?_⟩
    · simp only [Tree.colAt, hF, Option.bind_some]; rw [← h1]; exact hL
    · have : colL.length ≠ 0 := by simpa [List.isEmpty_iff, ← List.length_eq_zero_iff] using hne
      omega

theorem capKeys_corr {K : Forest} {m : Move} (hm : MoveOK K m) {col : Column}
    (hcol : K.colAt m.col = some col) (hij : m.i < m.j) (hj : m.j + 1 = col.length) {a : ColAddr}
    (ha : ((applyMove K m).colAt a).isSome) (hne : a ≠ m.col) :
    capKeys (applyMove K m) (routeCols (applyMove K m)) a = capKeys K (routeCols K) (bwdC m a) := by
  have hj' : m.j < col.length := by omega
  obtain ⟨col', hcol'⟩ := Option.isSome_iff_exists.1 ha
  obtain ⟨col0, hcol0, -, hcorr⟩ := colAt_mod_corr hcol hij hj' hcol'
  obtain ⟨hlab, hent⟩ := hcorr hne
  have hlen : col'.length = col0.length := by
    have := congrArg List.length hlab; simpa using this
  -- an entry containing the move column is the last entry of a route column
  have hcont : ∀ idx, a.path ++ [(a.col, idx)] <+: m.col.path →
      bwdC m a ∈ routeCols K ∧ idx + 1 = col0.length := by
    intro idx h
    have hba : bwdC m a = a := by
      simp only [bwdC]
      rw [mapPath_off _ _ _ (fun e D he => by
        have h1 := h.length_le; rw [he] at h1; simp at h1)]
    obtain ⟨hr, c0, hc0, hl0⟩ := container_route_K hm (Or.inl h)
    rw [hba] at hcol0 ⊢
    rw [hcol0] at hc0; obtain rfl := Option.some.inj hc0
    exact ⟨hr, hl0⟩
  simp only [capKeys, actualKeys]
  rw [hcol', hcol0, Option.getD_some, Option.getD_some, num_bwdC]
  have hrc := routeCols_corr hm hcol hij hj ha
  by_cases hr : bwdC m a ∈ routeCols K
  · rw [if_pos (hrc.2 hr), if_pos hr]
    have hdl : col'.dropLast = col0.dropLast := by
      apply List.ext_getElem?
      intro n
      rw [List.getElem?_dropLast, List.getElem?_dropLast, hlen]
      split_ifs with hn
      · apply hent
        intro h; have := (hcont n h).2; omega
      · rfl
    rw [← List.map_dropLast, ← List.map_dropLast, hdl, List.getLast?_map, List.getLast?_map]
    congr 2
    by_cases hc : col0 = []
    · have : col' = [] := List.eq_nil_of_length_eq_zero (by rw [hlen, hc]; rfl)
      rw [this, hc]
    · have hc' : col' ≠ [] := fun h => hc (List.eq_nil_of_length_eq_zero (by rw [← hlen, h]; rfl))
      rw [List.getLast?_eq_some_getLast hc, List.getLast?_eq_some_getLast hc']; rfl
  · rw [if_neg (fun h => hr (hrc.1 h)), if_neg hr]
    have : col' = col0 := by
      apply List.ext_getElem?
      intro n
      apply hent
      intro h; exact hr (hcont n h).1
    rw [this]

/-- helper: the capped keys of the move column, before and after the move. -/
theorem capKeys_moved {K : Forest} {m : Move} (hm : MoveOK K m) {col : Column}
    (hcol : K.colAt m.col = some col) (hij : m.i < m.j) (hj : m.j + 1 = col.length) :
    capKeys K (routeCols K) m.col =
      (col.map fun x => ((relKey (m.col.num 0) x.2 : Key) : WithTop Key)).take m.j ++ [⊤] ∧
    capKeys (applyMove K m) (routeCols (applyMove K m)) m.col =
      (col.map fun x => ((relKey (m.col.num 0) x.2 : Key) : WithTop Key)).take m.i ++ [⊤] := by
  have hj' : m.j < col.length := by omega
  have hr : m.col ∈ routeCols K := (container_route_K hm (Or.inr ⟨rfl, rfl⟩)).1
  have hK' : (applyMove K m).colAt m.col = some (moveFun m col) := by
    rw [applyMove_eq_mod hcol hij hj', colAt_mod_self, hcol]; rfl
  have hr' : m.col ∈ routeCols (applyMove K m) := by
    rw [routeCols_corr hm hcol hij hj (by rw [hK']; rfl), bwdC_col]; exact hr
  have hmf : moveFun m col = col.take m.i ++ [col.getD m.j (0, Tree.empty)] := by
    simp only [moveFun]
    congr 1
    rw [List.drop_eq_getElem_cons hj', List.drop_eq_nil_of_le (by omega)]
    simp [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hj']
  constructor
  · simp only [capKeys, actualKeys, if_pos hr, hcol, Option.getD_some]
    rw [List.dropLast_eq_take, List.length_map, ← hj, Nat.add_sub_cancel]
    cases h : (col.map fun x => ((relKey (m.col.num 0) x.2 : Key) : WithTop Key)).getLast? with
    | none => simp at h; subst h; simp at hj
    | some _ => rfl
  · simp only [capKeys, actualKeys, if_pos hr', hK', Option.getD_some, hmf, List.map_append,
      List.map_cons, List.map_nil]
    rw [List.dropLast_concat, List.getLast?_concat, List.map_take]
    rfl

theorem nu_mem {α : Type} [LinearOrder α] {P : α → Prop} :
    ∀ (l acc : List α), (∀ y ∈ acc, P y) → (∀ y ∈ l, P y) → ∀ y ∈ l.foldl nuStep acc, P y
  | [], acc, hacc, _ => hacc
  | x :: l, acc, hacc, hl => by
    apply nu_mem l (nuStep acc x) _ (fun y hy => hl y (by simp [hy]))
    intro y hy
    simp only [nuStep, List.mem_append, List.mem_reverse, List.mem_singleton] at hy
    rcases hy with hy | rfl
    · exact hacc y (List.mem_reverse.1 ((List.dropWhile_sublist _).subset hy))
    · exact hl _ (by simp)

theorem cutQuery_mem {α : Type} [LinearOrder α] {P : α → Prop} (ks : List α) (t : Nat)
    (h : ∀ y ∈ ks, P y) : ∀ y ∈ cutQuery ks t, P y := by
  intro y hy
  simp only [cutQuery, nu_eq_foldl] at hy
  exact nu_mem _ [] (by simp) (fun z hz => h z (List.mem_of_mem_take hz)) y hy

/-! #### scans against `⊤`-free queries -/

theorem cursor_top_zero : ∀ (V : List (WithTop Key)), (∀ y ∈ V, y ≠ ⊤) → cursor [⊤] V = 0
  | [], _ => by rw [cursor_nil_right]
  | y :: V, h => by
    rw [cursor]
    have hy : y ≠ ⊤ := h y (by simp)
    rw [if_neg (not_top_lt), if_neg (fun h' => hy h'.symm)]
    exact cursor_top_zero V (fun z hz => h z (by simp [hz]))

theorem cursor_snoc_top_le (X W : List (WithTop Key)) (hW : ∀ y ∈ W, y ≠ ⊤) :
    cursor (X ++ [⊤]) W ≤ X.length := by
  rcases Nat.lt_or_eq_of_le (cursor_le_length X W) with h | h
  · rw [cursor_append_of_lt _ h]; exact h.le
  · rw [(cursor_append_of_exhausted [⊤] h).1, cursor_top_zero _ (fun y hy => hW y (List.mem_of_mem_drop hy))]
    simp

/-- helper: the scan of the move column after the move ends at the same parent. -/
theorem resp_moved_eq {col : Column} {m : Move} (hij : m.i < m.j) (hj : m.j + 1 = col.length)
    (hpar : ∀ x, m.i ≤ x → x ≤ m.j → (col.getD x (0, Tree.empty)).1 = (col.getD m.j (0, Tree.empty)).1)
    (L : List (WithTop Key)) (hL : L.length = col.length) (W : List (WithTop Key))
    (hW : ∀ y ∈ W, y ≠ ⊤) :
    ((moveFun m col)[cursor (L.take m.i ++ [⊤]) W]?).map Prod.fst =
      (col[cursor (L.take m.j ++ [⊤]) W]?).map Prod.fst := by
  set t := cursor (L.take m.j ++ [⊤]) W with ht
  have htle : t ≤ m.j := by
    have := cursor_snoc_top_le (L.take m.j) W hW; simp at this; omega
  have htake : (L.take m.j ++ [⊤]).take m.i = L.take m.i := by
    rw [List.take_append_of_le_length (by simp; omega), List.take_take, Nat.min_eq_left hij.le]
  have hc := cursor_take (L.take m.j ++ [⊤]) W m.i
  rw [htake, ← ht] at hc
  have hlA : (L.take m.i).length = m.i := by simp; omega
  have hmf : ∀ x, x < m.i → (moveFun m col)[x]? = col[x]? := by
    intro x hx
    simp only [moveFun]
    rw [List.getElem?_append_left (by simp; omega), List.getElem?_take_of_lt hx]
  have hmfi : (moveFun m col)[m.i]? = col[m.j]? := by
    rw [moveFun, getElem?_moveFun m col hij.le (by omega)]
    unfold Move.bwdIdx; rw [if_pos le_rfl]; congr 1; omega
  rcases Nat.lt_or_ge t m.i with hlt | hge
  · rw [Nat.min_eq_right hlt.le] at hc
    rw [cursor_append_of_lt _ (by omega), hc, hmf t hlt]
  · rw [Nat.min_eq_left hge] at hc
    rw [(cursor_append_of_exhausted [⊤] (by omega)).1, cursor_top_zero _
      (fun y hy => hW y (List.mem_of_mem_drop hy)), hlA, Nat.add_zero, hmfi]
    rw [List.getElem?_eq_getElem (by omega), List.getElem?_eq_getElem (by omega)]
    simp only [Option.map_some]
    have h1 := hpar t hge htle
    simp only [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (show t < col.length by omega),
      List.getElem?_eq_getElem (show m.j < col.length by omega), Option.getD_some] at h1
    rw [h1]

/-! #### stacks and edges -/

theorem onStack_bwdC (m : Move) {a o : ColAddr} (h : a.OnStack o) : (bwdC m a).OnStack (bwdC m o) := by
  rcases h with ⟨k, ck, ik, hk, hp, hc⟩ | ⟨hp, hc⟩
  · left
    have := mapPath_getElem_fst m.bwdIdx m a.path k
    rw [hk] at this
    obtain ⟨⟨ck', ik'⟩, h1, h2⟩ := Option.map_eq_some_iff.1 this
    simp only at h2; subst h2
    exact ⟨k, ck', ik', h1, by simp only [bwdC]; rw [hp, mapPath_take], hc⟩
  · right; exact ⟨by simp only [bwdC]; rw [hp], hc⟩

theorem onStack_of_bwdC (m : Move) {a o : ColAddr} (h : (bwdC m a).OnStack o) :
    ∃ o', a.OnStack o' ∧ bwdC m o' = o := by
  rcases h with ⟨k, ck, ik, hk, hp, hc⟩ | ⟨hp, hc⟩
  · have := mapPath_getElem_fst m.bwdIdx m a.path k
    simp only [bwdC] at hk hp
    rw [hk] at this
    obtain ⟨⟨ck', ik'⟩, h1, h2⟩ := Option.map_eq_some_iff.1 this.symm
    simp only at h2; subst h2
    refine ⟨⟨a.path.take k, o.col⟩, Or.inl ⟨k, ck', ik', h1, rfl, hc⟩, ?_⟩
    simp only [bwdC]; rw [← mapPath_take, ← hp]
  · simp only [bwdC] at hp hc
    refine ⟨⟨a.path, o.col⟩, Or.inr ⟨rfl, hc⟩, ?_⟩
    simp only [bwdC]; rw [← hp]

theorem resolve_bwdC (m : Move) (a : ColAddr) (x : Nat) :
    (bwdC m a).resolve 0 x = (a.resolve 0 x).map (bwdC m) := by
  cases h : a.resolve 0 x with
  | some o' =>
    obtain ⟨hs, hn⟩ := (ColAddr.resolve_spec 0 a o' x).1 h
    exact (ColAddr.resolve_spec 0 _ _ x).2 ⟨onStack_bwdC m hs, by rw [num_bwdC]; exact hn⟩
  | none =>
    cases h' : (bwdC m a).resolve 0 x with
    | none => rfl
    | some o =>
      exfalso
      obtain ⟨hs, hn⟩ := (ColAddr.resolve_spec 0 _ o x).1 h'
      obtain ⟨o', hs', rfl⟩ := onStack_of_bwdC m hs
      rw [num_bwdC] at hn
      rw [(ColAddr.resolve_spec 0 a o' x).2 ⟨hs', hn⟩] at h
      simp at h

theorem onStack_colAt {E : Forest} {a o : ColAddr} (ha : (E.colAt a).isSome) (h : a.OnStack o) :
    (E.colAt o).isSome := by
  obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ha
  rcases h with ⟨k, ck, ik, hk, hp, hc⟩ | ⟨hp, hc⟩
  · have hkl : k < a.path.length := (List.getElem?_eq_some_iff.1 hk).1
    have hsplit : a.path = a.path.take k ++ (ck, ik) :: a.path.drop (k + 1) := by
      conv_lhs => rw [path_split_at hkl]
      rw [(List.getElem?_eq_some_iff.1 hk).2]
    simp only [Tree.colAt, Option.bind_eq_some_iff] at hcol
    obtain ⟨F, hF, -⟩ := hcol
    rw [hsplit, forestAt_through_col] at hF
    obtain ⟨y, hy, -⟩ := Option.bind_eq_some_iff.1 hF
    obtain ⟨colk, hcolk, -⟩ := Option.bind_eq_some_iff.1 hy
    simp only [Tree.colAt, Option.bind_eq_some_iff] at hcolk
    obtain ⟨G, hG, hGc⟩ := hcolk
    have hckl : ck < G.cols.length := (List.getElem?_eq_some_iff.1 hGc).1
    simp only [Tree.colAt, hp, hG, Option.bind_some]
    exact Option.isSome_iff_exists.2 ⟨_, List.getElem?_eq_getElem (by omega)⟩
  · simp only [Tree.colAt, Option.bind_eq_some_iff] at hcol
    obtain ⟨F, hF, hFc⟩ := hcol
    have hcl : a.col < F.cols.length := (List.getElem?_eq_some_iff.1 hFc).1
    simp only [Tree.colAt, hp, hF, Option.bind_some]
    exact Option.isSome_iff_exists.2 ⟨_, List.getElem?_eq_getElem (by omega)⟩

theorem resp_corr {K : Forest} {m : Move} (hm : MoveOK K m) {col : Column}
    (hcol : K.colAt m.col = some col) (hij : m.i < m.j) (hj : m.j + 1 = col.length)
    (hpar : ∀ x, m.i ≤ x → x ≤ m.j → (col.getD x (0, Tree.empty)).1 = (col.getD m.j (0, Tree.empty)).1)
    {o : ColAddr} (ho : ((applyMove K m).colAt o).isSome) {W : List (WithTop Key)}
    (hW : ∀ y ∈ W, y ≠ ⊤) :
    resp (applyMove K m) (capKeys (applyMove K m) (routeCols (applyMove K m))) o W =
      resp K (capKeys K (routeCols K)) (bwdC m o) W := by
  have hj' : m.j < col.length := by omega
  by_cases hom : o = m.col
  · subst hom
    obtain ⟨h1, h2⟩ := capKeys_moved hm hcol hij hj
    have hK' : (applyMove K m).colAt m.col = some (moveFun m col) := by
      rw [applyMove_eq_mod hcol hij hj', colAt_mod_self, hcol]; rfl
    simp only [resp, bwdC_col, hK', hcol, Option.getD_some, h1, h2]
    exact resp_moved_eq hij hj hpar _ (by simp) W hW
  · obtain ⟨col', hcol'⟩ := Option.isSome_iff_exists.1 ho
    obtain ⟨col0, hcol0, -, hcorr⟩ := colAt_mod_corr hcol hij hj' hcol'
    obtain ⟨hlab, -⟩ := hcorr hom
    simp only [resp, hcol', hcol0, Option.getD_some]
    rw [capKeys_corr hm hcol hij hj ho hom, ← List.getElem?_map, ← List.getElem?_map, hlab]

theorem edge_corr {K : Forest} {m : Move} (hm : MoveOK K m) {col : Column}
    (hcol : K.colAt m.col = some col) (hij : m.i < m.j) (hj : m.j + 1 = col.length)
    (hpar : ∀ x, m.i ≤ x → x ≤ m.j → (col.getD x (0, Tree.empty)).1 = (col.getD m.j (0, Tree.empty)).1)
    {a : ColAddr} (ha : ((applyMove K m).colAt a).isSome) {W : List (WithTop Key)}
    (hW : ∀ y ∈ W, y ≠ ⊤) {x y : Nat} (h : Edge K (capKeys K (routeCols K)) (bwdC m a) W x y) :
    Edge (applyMove K m) (capKeys (applyMove K m) (routeCols (applyMove K m))) a W x y := by
  obtain ⟨o, ho, hr⟩ := h
  rw [resolve_bwdC] at ho
  obtain ⟨o', ho', rfl⟩ := Option.map_eq_some_iff.1 ho
  have hst := ((ColAddr.resolve_spec 0 a o' x).1 ho').1
  exact ⟨o', ho', by rw [resp_corr hm hcol hij hj hpar (onStack_colAt ha hst) hW]; exact hr⟩

theorem mapPath_snoc (g : Nat → Nat) (m : Move) (π : List (Nat × Nat)) (x : Nat × Nat)
    (h : ¬ (π = m.col.path ∧ x.1 = m.col.col)) :
    m.mapPath g (π ++ [x]) = m.mapPath g π ++ [x] := by
  rcases mapPath_cases m (π ++ [x]) with ⟨e, D, hD⟩ | hoff
  · rcases List.eq_nil_or_concat' D with rfl | ⟨D', y, rfl⟩
    · exfalso; apply h
      obtain ⟨h1, h2⟩ := List.append_inj' hD rfl
      simp only [List.cons.injEq, and_true] at h2
      exact ⟨h1, by rw [h2]⟩
    · have : π ++ [x] = (m.col.path ++ (m.col.col, e) :: D') ++ [y] := by rw [hD]; simp
      obtain ⟨h1, h2⟩ := List.append_inj' this rfl
      simp only [List.cons.injEq, and_true] at h2
      subst h2; subst h1
      rw [List.append_assoc, List.cons_append, mapPath_through, mapPath_through]; simp
  · rw [mapPath_off g m _ hoff, mapPath_off g m π (fun e D hD => hoff e (D ++ [x]) (by rw [hD]; simp))]

theorem heightPath_bwd {m : Move} (e : EntryAddr) :
    ∃ idx0, m.mapPath m.bwdIdx e.heightPath = (bwdC m e.col).path ++ [((bwdC m e.col).col, idx0)] := by
  by_cases h : e.col.path = m.col.path ∧ e.col.col = m.col.col
  · refine ⟨m.bwdIdx e.idx, ?_⟩
    simp only [EntryAddr.heightPath, bwdC]
    rw [h.1, h.2]
    have := mapPath_through m.bwdIdx m e.idx []
    rw [this, mapPath_off _ _ _ (fun e D he => by have := congrArg List.length he; simp at this)]
  · refine ⟨e.idx, ?_⟩
    simp only [EntryAddr.heightPath, bwdC]
    exact mapPath_snoc _ _ _ _ h

-- L3.1g (txt:289-293): a legal move keeps every decorated response, hence decorated A
theorem decoratedA_applyMove {K : Forest} {m : Move} (hm : MoveOK K m) (hV : CondV K)
    (hA : CondAK K (capKeys K (routeCols K))) :
    CondV (applyMove K m) ∧ (CondI K → CondI (applyMove K m)) ∧
      CondAK (applyMove K m) (capKeys (applyMove K m) (routeCols (applyMove K m))) := by
  have hm' := hm
  obtain ⟨col, sd, hcol, -, hj, hij, -, hpar, -, -⟩ := hm'
  have hj' : m.j < col.length := by omega
  have hK' : (applyMove K m).colAt m.col = some (moveFun m col) := by
    rw [applyMove_eq_mod hcol hij hj', colAt_mod_self, hcol]; rfl
  have hmfl : (moveFun m col).length = m.i + 1 := by
    simp only [moveFun, List.length_append, List.length_take, List.length_drop]; omega
  have hmf : ∀ x, x < m.i → (moveFun m col)[x]? = col[x]? := by
    intro x hx
    simp only [moveFun]
    rw [List.getElem?_append_left (by simp; omega), List.getElem?_take_of_lt hx]
  have hmfi : (moveFun m col)[m.i]? = col[m.j]? := by
    rw [moveFun, getElem?_moveFun m col hij.le hj'.le]
    unfold Move.bwdIdx; rw [if_pos le_rfl]; congr 1; omega
  have hparj : ∀ x, m.i ≤ x → x ≤ m.j → ∀ z, col[x]? = some z → z.1 = (col.getD m.j (0, Tree.empty)).1 := by
    intro x h1 h2 z hz
    have := hpar x h1 h2
    simp only [List.getD_eq_getElem?_getD, hz, Option.getD_some] at this
    simpa [List.getD_eq_getElem?_getD] using this
  refine ⟨?_, ?_, ?_⟩
  · -- V
    rw [condV_iff_lt] at hV ⊢
    intro e he p h hep
    obtain ⟨col', hcol', hidx⟩ := Tree.colAt_of_entryAt hep
    obtain ⟨col0, hcol0, hmc, hnc⟩ := colAt_mod_corr hcol hij hj' hcol'
    by_cases hem : e.col = m.col
    · obtain ⟨rfl, -⟩ := hmc hem
      rw [moveFun, getElem?_moveFun m col hij.le hj'.le] at hidx
      have hKe : K.entryAt ⟨m.col, m.bwdIdx e.idx⟩ = some (p, h) := by
        simp only [Tree.entryAt, hcol, Option.bind_some]; exact hidx
      have := hV _ ((Tree.mem_entryAddrs_iff _ _).2 (by rw [hKe]; rfl)) p h hKe
      rw [hem]; exact this
    · obtain ⟨hlab, -⟩ := hnc hem
      have h1 := congrArg (·[e.idx]?) hlab
      simp only [List.getElem?_map, hidx, Option.map_some] at h1
      obtain ⟨⟨p0, h0⟩, h2, h3⟩ := Option.map_eq_some_iff.1 h1.symm
      simp only at h3; subst h3
      have hKe : K.entryAt ⟨bwdC m e.col, e.idx⟩ = some (p0, h0) := by
        simp only [Tree.entryAt, hcol0, Option.bind_some]; exact h2
      have := hV _ ((Tree.mem_entryAddrs_iff _ _).2 (by rw [hKe]; rfl)) p0 h0 hKe
      rw [num_bwdC] at this; exact this
  · -- I
    intro hI e he p h' hep hne col'' hcol''
    have hH' : (applyMove K m).forestAt e.heightPath = some h' := by
      rw [Tree.forestAt_heightPath, heightAt_of_entryAt hep]
    rw [applyMove_eq_mod hcol hij hj'] at hH'
    obtain ⟨G, hG, hlen, hcorr⟩ := forestAt_mod_corr hcol hij hj' _ _ hH'
    obtain ⟨idx0, hidx0⟩ := heightPath_bwd (m := m) e
    let e₀ : EntryAddr := ⟨bwdC m e.col, idx0⟩
    have hhp : e₀.heightPath = m.mapPath m.bwdIdx e.heightPath := by rw [hidx0]; rfl
    have hKh : K.heightAt e₀ = some G := by rw [← Tree.forestAt_heightPath, hhp]; exact hG
    obtain ⟨⟨p₀, G₀⟩, hKe, hG₀⟩ := Option.map_eq_some_iff.1 hKh
    simp only at hG₀; subst hG₀
    have hGne : G₀ ≠ Tree.empty := by
      intro hG0; apply hne
      obtain ⟨cs⟩ := h'
      subst hG0
      cases cs with
      | nil => rfl
      | cons c cs => simp [Tree.empty, Tree.cols] at hlen
    obtain ⟨c'', hc''⟩ := List.mem_iff_getElem?.1 hcol''
    by_cases hP : e.heightPath = m.col.path ∧ c'' = m.col.col
    · -- the moved column itself
      have hGc : G₀.cols[m.col.col]? = some col := by
        have hb : m.mapPath m.bwdIdx e.heightPath = m.col.path := by
          rw [hP.1, mapPath_off _ _ _ (fun e D he => by have := congrArg List.length he; simp at this)]
        rw [hb] at hG
        simp only [Tree.colAt, hG, Option.bind_some] at hcol; exact hcol
      have h'c : h'.cols[m.col.col]? = some (moveFun m col) := by
        have := hK'
        rw [applyMove_eq_mod hcol hij hj'] at this
        have hH'' := hH'
        rw [hP.1] at hH''
        simp only [Tree.colAt, hH'', Option.bind_some] at this; exact this
      rw [hP.2, h'c] at hc''
      obtain rfl := Option.some.inj hc''
      obtain ⟨q, H, rest, hcq, hq⟩ := hI e₀ ((Tree.mem_entryAddrs_iff _ _).2 (by rw [hKe]; rfl)) p₀ G₀ hKe
        hGne col (List.mem_of_getElem? hGc)
      rw [show e₀.col.num 0 = e.col.num 0 from num_bwdC m e.col 0] at hq
      by_cases hi0 : m.i = 0
      · obtain ⟨z, hz⟩ : ∃ z, (moveFun m col)[0]? = some z := by
          cases h : (moveFun m col)[0]? with
          | none => rw [List.getElem?_eq_none_iff] at h; omega
          | some z => exact ⟨z, rfl⟩
        have hz' := hz
        rw [← hi0, hmfi] at hz'
        have h1 := hparj m.j (by omega) le_rfl z hz'
        have h2 := hparj 0 (by omega) (by omega) (q, H) (by rw [hcq]; rfl)
        cases hmc : moveFun m col with
        | nil => simp [hmc] at hmfl
        | cons y ys =>
          rw [hmc] at hz; simp at hz; subst hz
          exact ⟨y.1, y.2, ys, rfl, by simp at h1 h2; omega⟩
      · have h0 : (moveFun m col)[0]? = some (q, H) := by rw [hmf 0 (by omega), hcq]; rfl
        cases hmc : moveFun m col with
        | nil => simp [hmc] at hmfl
        | cons y ys =>
          rw [hmc] at h0; simp at h0; subst h0
          exact ⟨q, H, ys, rfl, hq⟩
    · obtain ⟨hlab, -⟩ := hcorr c'' hP
      rw [hc''] at hlab
      obtain ⟨colG, hcolG, hlG⟩ := Option.map_eq_some_iff.1 hlab.symm
      obtain ⟨q, H, rest, hcq, hq⟩ := hI e₀ ((Tree.mem_entryAddrs_iff _ _).2 (by rw [hKe]; rfl)) p₀ G₀ hKe
        hGne colG (List.mem_of_getElem? hcolG)
      rw [show e₀.col.num 0 = e.col.num 0 from num_bwdC m e.col 0] at hq
      cases col'' with
      | nil => subst hcq; simp at hlG
      | cons y ys =>
        subst hcq
        simp only [List.map_cons, List.cons.injEq] at hlG
        exact ⟨y.1, y.2, ys, rfl, by rw [← hlG.1]; exact hq⟩
  · -- decorated A
    intro a ha t y hy
    have ham : ((applyMove K m).colAt a).isSome := (Tree.mem_colAddrs_iff _ _).1 ha
    obtain ⟨col', hcol'⟩ := Option.isSome_iff_exists.1 ham
    obtain ⟨col0, hcol0, hmc, hnc⟩ := colAt_mod_corr hcol hij hj' hcol'
    have hbm : bwdC m a ∈ K.colAddrs := (Tree.mem_colAddrs_iff _ _).2 (by rw [hcol0]; rfl)
    have htr : ∀ W : List (WithTop Key), (∀ z ∈ W, z ≠ ⊤) → ∀ x z,
        Path K (capKeys K (routeCols K)) (bwdC m a) W x z →
        Path (applyMove K m) (capKeys (applyMove K m) (routeCols (applyMove K m))) a W x z :=
      by
        intro W hW x z h
        induction h with
        | refl => exact Relation.ReflTransGen.refl
        | tail _ he ih => exact ih.tail (edge_corr hm hcol hij hj hpar ham hW he)
    have hcoe : ∀ (L : List (Nat × Forest)) (b : Nat) (s : Nat), ∀ z ∈ cutQuery
        (L.map fun x => ((relKey b x.2 : Key) : WithTop Key)) s, z ≠ ⊤ := by
      intro L b s
      apply cutQuery_mem
      intro z hz; simp only [List.mem_map] at hz; obtain ⟨_, -, rfl⟩ := hz; exact WithTop.coe_ne_top
    by_cases ham' : a = m.col
    · subst ham'
      obtain ⟨hc1, -⟩ := hmc rfl
      subst hc1
      rw [bwdC_col] at htr hbm
      obtain ⟨h1, h2⟩ := capKeys_moved hm hcol hij hj
      simp only [parents, hcol', Option.getD_some, List.getElem?_map] at hy
      have ht : t ≤ m.i := by
        have := (List.getElem?_eq_some_iff.1 (Option.map_eq_some_iff.1 hy).choose_spec.1).1; omega
      set L := col.map fun x => ((relKey (m.col.num 0) x.2 : Key) : WithTop Key) with hLdef
      have hLl : L.length = col.length := by simp [hLdef]
      have hq : cutQuery (L.take m.i ++ [⊤]) t = cutQuery (L.take m.j ++ [⊤]) t := by
        simp only [cutQuery]
        rw [List.take_append_of_le_length (by simp; omega), List.take_append_of_le_length (by simp; omega),
          List.take_take, List.take_take, Nat.min_eq_left ht, Nat.min_eq_left (by omega)]
      have hq' : cutQuery (L.take m.j ++ [⊤]) t = cutQuery L t := by
        simp only [cutQuery]
        rw [List.take_append_of_le_length (by simp; omega), List.take_take, Nat.min_eq_left (by omega)]
      have hyK : (parents K m.col)[t]? = some y := by
        simp only [parents, hcol, Option.getD_some, List.getElem?_map]
        rcases Nat.lt_or_eq_of_le ht with hlt | hti
        · rw [← hmf t hlt]; exact hy
        · subst hti
          rw [hmfi] at hy
          obtain ⟨z, hz, rfl⟩ := Option.map_eq_some_iff.1 hy
          obtain ⟨w, hw⟩ : ∃ w, col[m.i]? = some w := ⟨_, List.getElem?_eq_getElem (by omega)⟩
          rw [hw]
          have e1 := hparj m.i le_rfl (by omega) w hw
          have e2 := hparj m.j (by omega) le_rfl z hz
          simp only [Option.map_some, Option.some.injEq]; rw [e1, e2]
      have hP := hA m.col hbm t y hyK
      rw [h1, hq'] at hP
      rw [h2, hq, hq']
      have hstart : (if t = 0 then m.col.num 0 - 1 else ((parents (applyMove K m) m.col)[t - 1]?).getD 0) =
          (if t = 0 then m.col.num 0 - 1 else ((parents K m.col)[t - 1]?).getD 0) := by
        split_ifs with h0
        · rfl
        · simp only [parents, hcol', hcol, Option.getD_some, List.getElem?_map]
          rw [hmf (t - 1) (by omega)]
      rw [hstart]
      exact htr _ (hcoe col _ t) _ _ hP
    · obtain ⟨hlab, -⟩ := hnc ham'
      have hpe : parents (applyMove K m) a = parents K (bwdC m a) := by
        simp only [parents, hcol', hcol0, Option.getD_some, hlab]
      rw [hpe] at hy ⊢
      rw [capKeys_corr hm hcol hij hj ham ham']
      have hP := hA (bwdC m a) hbm t y hy
      rw [num_bwdC] at hP
      have htl : t < col0.length := by
        have := (List.getElem?_eq_some_iff.1 hy).1; simpa [parents, hcol0] using this
      have hW : ∀ z ∈ cutQuery (capKeys K (routeCols K) (bwdC m a)) t, z ≠ ⊤ := by
        rw [cutQuery_capKeys K _ _ (by rw [hcol0]; exact htl)]
        simp only [actualKeys, hcol0, Option.getD_some]
        exact hcoe col0 _ t
      exact htr _ hW _ _ hP


/-! ### L3.1h helpers -/

theorem mod_litCapAux (k p jj cc i j : Nat) (rest : List (Nat × Nat)) (hij : i < j) :
    ∀ (P : List (Nat × Nat)) (F : Forest) (Fcol : Column) (q : Nat) (Hi Hj : Forest),
      F.colAt ⟨P, cc⟩ = some Fcol → Fcol[i]? = some (q, Hi) → Fcol[j]? = some (q, Hj) →
      litCapAux k p rest jj Hj = litCapAux k p rest jj Hi →
      modifyColAux (fun col => col.take i ++ col.drop j) P cc
          (litCapAux k p (P ++ (cc, j) :: rest) jj F) =
        litCapAux k p (P ++ (cc, i) :: rest) jj F
  | [], .node cols, Fcol, q, Hi, Hj, hcol, hi, hj, hC => by
    rw [colAt_node_nil] at hcol
    have hcc : cc < cols.length := (List.getElem?_eq_some_iff.1 hcol).1
    have hjl : j < Fcol.length := (List.getElem?_eq_some_iff.1 hj).1
    have hgj : (cols.getD cc [])[j]? = some (q, Hj) := by
      rw [List.getD_eq_getElem?_getD, hcol, Option.getD_some]; exact hj
    have hgi : (cols.getD cc [])[i]? = some (q, Hi) := by
      rw [List.getD_eq_getElem?_getD, hcol, Option.getD_some]; exact hi
    simp only [List.nil_append]
    rw [litCapAux_cons k p cc j jj rest cols hgj, litCapAux_cons k p cc i jj rest cols hgi]
    simp only [modifyColAux]
    have hl : (cols.take cc).length = cc := List.length_take_of_le hcc.le
    have hm := list_modify_snoc (cols.take cc)
      ((cols.getD cc []).take j ++ [(q, litCapAux k p rest jj Hj)]) (fun col => col.take i ++ col.drop j)
    rw [hl] at hm
    rw [hm, List.getD_eq_getElem?_getD, hcol, Option.getD_some, hC]
    congr 3
    have hl2 : (Fcol.take j).length = j := List.length_take_of_le hjl.le
    rw [List.take_append_of_le_length (by omega), List.take_take, Nat.min_eq_left hij.le,
      List.drop_left' hl2]
  | (a, b) :: P, .node cols, Fcol, q, Hi, Hj, hcol, hi, hj, hC => by
    rw [colAt_node_cons] at hcol
    obtain ⟨x, hx, hcolx⟩ := Option.bind_eq_some_iff.1 hcol
    obtain ⟨colc, hc, hx'⟩ := Option.bind_eq_some_iff.1 hx
    obtain ⟨q', H'⟩ := x
    have hci : a < cols.length := (List.getElem?_eq_some_iff.1 hc).1
    have hei : b < colc.length := (List.getElem?_eq_some_iff.1 hx').1
    have hget : (cols.getD a [])[b]? = some (q', H') := by
      rw [List.getD_eq_getElem?_getD, hc, Option.getD_some]; exact hx'
    simp only [List.cons_append]
    rw [litCapAux_cons k p a b jj _ cols hget, litCapAux_cons k p a b jj _ cols hget]
    simp only [modifyColAux]
    have hl : (cols.take a).length = a := List.length_take_of_le hci.le
    have hl' : ((cols.getD a []).take b).length = b := by
      rw [List.getD_eq_getElem?_getD, hc, Option.getD_some]; exact List.length_take_of_le hei.le
    have hm := list_modify_snoc (cols.take a)
      ((cols.getD a []).take b ++ [(q', litCapAux k p (P ++ (cc, j) :: rest) jj H')])
      (fun col => col.modify b fun x => (x.1, modifyColAux (fun col => col.take i ++ col.drop j) P cc x.2))
    rw [hl] at hm
    rw [hm]
    have hm' := list_modify_snoc ((cols.getD a []).take b) (q', litCapAux k p (P ++ (cc, j) :: rest) jj H')
      (fun x => (x.1, modifyColAux (fun col => col.take i ++ col.drop j) P cc x.2))
    rw [hl'] at hm'
    rw [hm']
    try simp only
    rw [mod_litCapAux k p jj cc i j rest hij P H' Fcol q Hi Hj hcolx hi hj hC]

theorem colAt_through {E : Forest} {P rest : List (Nat × Nat)} {cc b j : Nat} {col : Column}
    (h : E.colAt ⟨P ++ (cc, b) :: rest, j⟩ = some col) :
    ∃ Ecol q H, E.colAt ⟨P, cc⟩ = some Ecol ∧ Ecol[b]? = some (q, H) ∧ H.colAt ⟨rest, j⟩ = some col := by
  simp only [Tree.colAt] at h
  rw [forestAt_through_col] at h
  obtain ⟨G, hG, hGc⟩ := Option.bind_eq_some_iff.1 h
  obtain ⟨x, hx, hxG⟩ := Option.bind_eq_some_iff.1 hG
  obtain ⟨Ecol, hE, hEx⟩ := Option.bind_eq_some_iff.1 hx
  exact ⟨Ecol, x.1, x.2, hE, hEx, by simp only [Tree.colAt, hxG, Option.bind_some]; exact hGc⟩

theorem colAt_through_of {E : Forest} {P rest : List (Nat × Nat)} {cc b j : Nat} {Ecol : Column}
    {q : Nat} {H : Forest} (hE : E.colAt ⟨P, cc⟩ = some Ecol) (hb : Ecol[b]? = some (q, H)) :
    E.colAt ⟨P ++ (cc, b) :: rest, j⟩ = H.colAt ⟨rest, j⟩ := by
  simp only [Tree.colAt]
  rw [forestAt_through_col, hE]
  simp only [Option.bind_some, hb]

/-- helper (L3.1h): one legal move of an upward literal cap of an `H`-expression gives the literal
cap at the relocated column. -/
theorem litCap_move_step {E : Forest} (hH : CondH E) {cs : ColAddr} {k p : Nat}
    (hup : IsUpward E cs k p) {m : Move} (hm : MoveOK (litCap E cs k p) m) :
    ∃ rest, cs.path = m.col.path ++ (m.col.col, m.j) :: rest ∧
      IsUpward E ⟨m.col.path ++ (m.col.col, m.i) :: rest, cs.col⟩ k p ∧
      applyMove (litCap E cs k p) m = litCap E ⟨m.col.path ++ (m.col.col, m.i) :: rest, cs.col⟩ k p ∧
      ((E.colAt ⟨m.col.path ++ (m.col.col, m.i) :: rest, cs.col⟩).getD []).take k =
        ((E.colAt cs).getD []).take k := by
  obtain ⟨col0, hcol0, hk0, hq0⟩ := isUpward_iff_exists.1 hup
  obtain ⟨col, sd, hcolK, hsd, hj, hij, hpre, hpar, hlt, -⟩ := hm
  rw [stopData_litCap' hcol0] at hsd
  obtain rfl := Option.some.inj hsd
  obtain ⟨rest, hrest⟩ := hpre
  simp only [EntryAddr.heightPath, List.append_assoc, List.singleton_append] at hrest
  refine ⟨rest, hrest.symm, ?_⟩
  set P := m.col.path
  set cc := m.col.col
  have hcs : cs = ⟨P ++ (cc, m.j) :: rest, cs.col⟩ := by rw [hrest]
  have hcol0' := hcol0
  rw [hcs] at hcol0'
  obtain ⟨Ecol, qj, Hj, hEcol, hEj, hHj⟩ := colAt_through hcol0'
  -- the cap's column at the move
  have hKcol : (litCap E cs k p).colAt m.col = some (Ecol.take m.j ++ [(qj, litCapAux k p rest cs.col Hj)]) := by
    rw [litCap_eq_aux hcol0]
    simp only [Tree.colAt] at hEcol ⊢
    have hpreP : P <+: cs.path := ⟨(cc, m.j) :: rest, hrest⟩
    rw [forestAt_litCapAux_prefix k p cs.col cs.path P E hpreP ⟨col0, hcol0⟩]
    obtain ⟨G, hG, hGc⟩ := Option.bind_eq_some_iff.1 hEcol
    rw [hG]
    have hdrop : cs.path.drop P.length = (cc, m.j) :: rest := by rw [← hrest]; simp
    obtain ⟨gcols⟩ := G
    have hget : (gcols.getD cc [])[m.j]? = some (qj, Hj) := by
      simp only [Tree.cols] at hGc; rw [List.getD_eq_getElem?_getD, hGc, Option.getD_some]; exact hEj
    simp only [Option.map_some, Option.bind_some, hdrop]
    rw [litCapAux_cons k p cc m.j cs.col rest gcols hget]
    simp only [Tree.cols] at hGc ⊢
    have hci : cc < gcols.length := (List.getElem?_eq_some_iff.1 hGc).1
    rw [list_getElem?_take_snoc _ _ _ hci.le, if_neg (lt_irrefl _), if_pos rfl]
    all_goals simp [List.getD_eq_getElem?_getD, hGc]
  have hcolK' : (litCap E cs k p).colAt m.col = some col := hcolK
  rw [hKcol] at hcolK'
  obtain rfl := Option.some.inj hcolK'
  have hjE : m.j < Ecol.length := (List.getElem?_eq_some_iff.1 hEj).1
  have hlen : (Ecol.take m.j ++ [(qj, litCapAux k p rest cs.col Hj)]).length = m.j + 1 := by
    simp [List.length_take_of_le hjE.le]
  have hgetK : ∀ x, x < m.j → (Ecol.take m.j ++ [(qj, litCapAux k p rest cs.col Hj)]).getD x (0, Tree.empty) =
      Ecol.getD x (0, Tree.empty) := by
    intro x hx
    simp only [List.getD_eq_getElem?_getD]
    rw [List.getElem?_append_left (by simp; omega), List.getElem?_take_of_lt hx]
  have hgetKj : (Ecol.take m.j ++ [(qj, litCapAux k p rest cs.col Hj)]).getD m.j (0, Tree.empty) =
      (qj, litCapAux k p rest cs.col Hj) := by
    simp only [List.getD_eq_getElem?_getD]
    rw [List.getElem?_append_right (by simp)]; simp [List.length_take_of_le hjE.le]
  -- entries i … j of E share the parent qj
  have hparE : ∀ x, m.i ≤ x → x < m.j → (Ecol.getD x (0, Tree.empty)).1 = qj := by
    intro x h1 h2
    have := hpar x h1 h2.le
    rw [hgetK x h2, hgetKj] at this; exact this
  obtain ⟨qi, Hi, hEi⟩ : ∃ qi Hi, Ecol[m.i]? = some (qi, Hi) := by
    cases h : Ecol[m.i]? with
    | none => have := List.getElem?_eq_none_iff.1 h; omega
    | some x => exact ⟨x.1, x.2, rfl⟩
  have hqi : qi = qj := by
    have := hparE m.i le_rfl hij
    simp only [List.getD_eq_getElem?_getD, hEi, Option.getD_some] at this; exact this
  subst hqi
  have hltE : Hi < litCapAux k p rest cs.col Hj := by
    have := hlt
    rw [hgetK m.i hij, hgetKj] at this
    simpa [List.getD_eq_getElem?_getD, hEi] using this
  -- H gives `Hj ≤ Hi`
  have hmemc : m.col ∈ E.colAddrs := (Tree.mem_colAddrs_iff E m.col).2 (by
    show (E.colAt ⟨P, cc⟩).isSome; rw [hEcol]; rfl)
  have hchain : ∀ n, m.i + n ≤ m.j → Hj ≤ (Ecol.getD (m.j - n) (0, Tree.empty)).2 := by
    intro n
    induction n with
    | zero => intro _; simp [List.getD_eq_getElem?_getD, hEj]
    | succ n ih =>
      intro hn
      have h1 := ih (by omega)
      have hx : Ecol[m.j - (n + 1)]? = some (Ecol.getD (m.j - (n + 1)) (0, Tree.empty)) := by
        rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (by omega)]; simp
      have hy : Ecol[m.j - (n + 1) + 1]? = some (Ecol.getD (m.j - n) (0, Tree.empty)) := by
        rw [show m.j - (n + 1) + 1 = m.j - n by omega, List.getD_eq_getElem?_getD,
          List.getElem?_eq_getElem (by omega)]; simp
      have hle := hH m.col hmemc (m.j - (n + 1)) _ _ (by rw [show m.col = ⟨P, cc⟩ from rfl, hEcol]; exact hx)
        (by rw [show m.col = ⟨P, cc⟩ from rfl, hEcol]; exact hy)
      have hp1 : (Ecol.getD (m.j - (n + 1)) (0, Tree.empty)).1 = qi := hparE _ (by omega) (by omega)
      have hp2 : (Ecol.getD (m.j - n) (0, Tree.empty)).1 = qi := by
        rcases Nat.eq_zero_or_pos n with rfl | hn0
        · simp [List.getD_eq_getElem?_getD, hEj]
        · exact hparE _ (by omega) (by omega)
      rcases hle with h | ⟨-, h⟩
      · omega
      · exact le_trans h1 h
  have hHjHi : Hj ≤ Hi := by
    have := hchain (m.j - m.i) (by omega)
    rw [show m.j - (m.j - m.i) = m.i by omega] at this
    simpa [List.getD_eq_getElem?_getD, hEi] using this
  -- the interval fact inside the moved height
  have hupJ : IsUpward Hj ⟨rest, cs.col⟩ k p := isUpward_iff_exists.2 ⟨col0, hHj, hk0, hq0⟩
  obtain ⟨hupI, heq⟩ := interval_cap hupJ hHjHi (by rw [litCap_eq_aux hHj]; exact hltE)
  obtain ⟨colI, hcolI, hkI, hqI⟩ := isUpward_iff_exists.1 hupI
  have hEI : E.colAt ⟨P ++ (cc, m.i) :: rest, cs.col⟩ = some colI := by
    rw [colAt_through_of hEcol hEi]; exact hcolI
  refine ⟨isUpward_iff_exists.2 ⟨colI, hEI, hkI, hqI⟩, ?_, ?_⟩
  · rw [applyMove_eq_mod hKcol hij (by rw [hlen]; omega), litCap_eq_aux hcol0, litCap_eq_aux hEI]
    have hC : litCapAux k p rest cs.col Hj = litCapAux k p rest cs.col Hi := by
      rw [← litCap_eq_aux hHj, ← litCap_eq_aux hcolI, heq]
    have := mod_litCapAux k p cs.col cc m.i m.j rest hij P E Ecol qi Hi Hj hEcol hEi hEj hC
    rw [← hrest]
    exact this
  · rw [hEI, hcol0, Option.getD_some, Option.getD_some]
    have h1 := stopData_litCap' hcolI k p
    have h2 := stopData_litCap' hHj k p
    rw [heq, h2] at h1
    simp only [Option.some.injEq, StopData.mk.injEq] at h1
    exact h1.2.2.2.2.symm

-- L3.1h (txt:286-288, 294-295): after legal moves an upward literal cap of an `H`-expression is
-- again an upward literal cap of it, with the same cut, parent and internal cap
theorem applyMoves_litCap {E : Forest} (hH : CondH E) {c : ColAddr} {k p : Nat}
    (hup : IsUpward E c k p) {ms : List Move} (hms : MovesValid (litCap E c k p) ms) :
    ∃ c', IsUpward E c' k p ∧ applyMoves (litCap E c k p) ms = litCap E c' k p ∧
      ((E.colAt c').getD []).take k = ((E.colAt c).getD []).take k := by
  revert hms
  induction ms using List.reverseRecOn with
  | nil => intro _; exact ⟨c, hup, rfl, rfl⟩
  | append_singleton ms m ih =>
    intro hms
    obtain ⟨hv, hm⟩ := movesValid_append hms
    obtain ⟨c', hup', heq, htk⟩ := ih hv
    rw [applyMoves_snoc, heq]
    rw [heq] at hm
    obtain ⟨rest, -, hup'', hmove, htk'⟩ := litCap_move_step hH hup' hm
    exact ⟨_, hup'', hmove, htk'.trans htk⟩


/-! ### L3.1 helpers -/

/-- helper: the column of a literal cap at one of its containing columns. -/
theorem colAt_litCap_container {E : Forest} {cs : ColAddr} {col0 : Column}
    (hcol0 : E.colAt cs = some col0) {π rest : List (Nat × Nat)} {a e : Nat}
    (hpath : cs.path = π ++ (a, e) :: rest) (k p : Nat) :
    ∃ Ecol q H, E.colAt ⟨π, a⟩ = some Ecol ∧ Ecol[e]? = some (q, H) ∧
      H.colAt ⟨rest, cs.col⟩ = some col0 ∧
      (litCap E cs k p).colAt ⟨π, a⟩ = some (Ecol.take e ++ [(q, litCapAux k p rest cs.col H)]) := by
  have hcol0' : E.colAt ⟨π ++ (a, e) :: rest, cs.col⟩ = some col0 := by rw [← hpath]; exact hcol0
  obtain ⟨Ecol, q, H, hEcol, hEe, hH⟩ := colAt_through hcol0'
  refine ⟨Ecol, q, H, hEcol, hEe, hH, ?_⟩
  rw [litCap_eq_aux hcol0]
  simp only [Tree.colAt] at hEcol ⊢
  have hpreP : π <+: cs.path := ⟨(a, e) :: rest, hpath.symm⟩
  rw [forestAt_litCapAux_prefix k p cs.col cs.path π E hpreP ⟨col0, hcol0⟩]
  obtain ⟨G, hG, hGc⟩ := Option.bind_eq_some_iff.1 hEcol
  rw [hG]
  have hdrop : cs.path.drop π.length = (a, e) :: rest := by rw [hpath]; simp
  obtain ⟨gcols⟩ := G
  have hget : (gcols.getD a [])[e]? = some (q, H) := by
    simp only [Tree.cols] at hGc; rw [List.getD_eq_getElem?_getD, hGc, Option.getD_some]; exact hEe
  simp only [Option.map_some, Option.bind_some, hdrop]
  rw [litCapAux_cons k p a e cs.col rest gcols hget]
  simp only [Tree.cols] at hGc ⊢
  have hci : a < gcols.length := (List.getElem?_eq_some_iff.1 hGc).1
  rw [list_getElem?_take_snoc _ _ _ hci.le, if_neg (lt_irrefl _), if_pos rfl]
  all_goals simp [List.getD_eq_getElem?_getD, hGc]

theorem movesValid_snoc {K : Forest} {ms : List Move} {m : Move} (h : MovesValid K ms)
    (hm : MoveOK (applyMoves K ms) m) : MovesValid K (ms ++ [m]) := by
  intro idx hidx
  simp only [List.length_append, List.length_singleton] at hidx
  rcases Nat.lt_or_eq_of_le (Nat.lt_succ_iff.1 hidx) with hlt | rfl
  · rw [List.take_append_of_le_length hlt.le, List.getElem_append_left hlt]; exact h idx hlt
  · rw [List.take_left, List.getElem_append_right (by omega)]; simpa using hm

/-- helper: the columns of a literal cap: the cap column, a containing column (a prefix of the
original column followed by its containing entry with a new height), or an unchanged column. -/
theorem colAt_litCap_cases {E : Forest} {c : ColAddr} {col : Column} (hcol : E.colAt c = some col)
    {k : Nat} (hk : k ≤ col.length) (p : Nat) {a : ColAddr} {col' : Column}
    (h : (litCap E c k p).colAt a = some col') :
    (a = c ∧ col' = col.take k ++ [(p, Tree.empty)]) ∨
    (∃ e rest Ecol q H H', c.path = a.path ++ (a.col, e) :: rest ∧ E.colAt a = some Ecol ∧
      Ecol[e]? = some (q, H) ∧ col' = Ecol.take e ++ [(q, H')]) ∨
    E.colAt a = some col' := by
  obtain ⟨π, cc⟩ := a
  have h' := h
  rw [litCap_eq_aux hcol] at h
  simp only [Tree.colAt, Option.bind_eq_some_iff] at h
  obtain ⟨G', hG', hcc⟩ := h
  by_cases hpre : π <+: c.path
  · rw [forestAt_litCapAux_prefix k p c.col c.path π E hpre ⟨col, hcol⟩] at hG'
    obtain ⟨G, hG, rfl⟩ := Option.map_eq_some_iff.1 hG'
    obtain ⟨rest, hrest⟩ := hpre
    have hdrop : c.path.drop π.length = rest := by rw [← hrest]; simp
    rw [hdrop] at hcc
    have hEc : G.colAt ⟨rest, c.col⟩ = some col := by
      rw [← hcol]; simp only [Tree.colAt]; rw [← hrest, Tree.forestAt_append, hG]; rfl
    obtain ⟨gcols⟩ := G
    cases rest with
    | nil =>
      rw [colAt_node_nil] at hEc
      have hj : c.col < gcols.length := (List.getElem?_eq_some_iff.1 hEc).1
      simp only [List.append_nil] at hrest
      rw [litCapAux_nil] at hcc
      simp only [Tree.cols] at hcc
      rw [list_getElem?_take_snoc _ _ _ hj.le] at hcc
      split_ifs at hcc with h1 h2
      · right; right
        simp only [Tree.colAt, hG, Option.bind_some, Tree.cols, hcc]
      · subst h2
        left
        refine ⟨by subst hrest; rfl, ?_⟩
        obtain rfl := Option.some.inj hcc
        simp [List.getD_eq_getElem?_getD, hEc]
    | cons ce rest =>
      obtain ⟨ci, ei⟩ := ce
      rw [colAt_node_cons] at hEc
      obtain ⟨y, hy, hcoly⟩ := Option.bind_eq_some_iff.1 hEc
      obtain ⟨colc, hc, hy'⟩ := Option.bind_eq_some_iff.1 hy
      obtain ⟨q, H⟩ := y
      have hci : ci < gcols.length := (List.getElem?_eq_some_iff.1 hc).1
      have hget : (gcols.getD ci [])[ei]? = some (q, H) := by
        rw [List.getD_eq_getElem?_getD, hc, Option.getD_some]; exact hy'
      rw [litCapAux_cons k p ci ei c.col rest gcols hget] at hcc
      simp only [Tree.cols] at hcc
      rw [list_getElem?_take_snoc _ _ _ hci.le] at hcc
      split_ifs at hcc with h1 h2
      · right; right
        simp only [Tree.colAt, hG, Option.bind_some, Tree.cols, hcc]
      · subst h2
        right; left
        obtain rfl := Option.some.inj hcc
        refine ⟨ei, rest, colc, q, H, litCapAux k p rest c.col H, hrest.symm, ?_, hy', ?_⟩
        · simp only [Tree.colAt, hG, Option.bind_some, Tree.cols, hc]
        · simp [List.getD_eq_getElem?_getD, hc]
  · by_cases hcap : π = c.path ++ [(c.col, k)]
    · exfalso
      subst hcap
      rw [forestAt_through_col, show (⟨c.path, c.col⟩ : ColAddr) = c from rfl,
        colAt_litCapAux_self hcol k p] at hG'
      simp only [Option.bind_some, List.getElem?_append_right (by simp : (col.take k).length ≤ k),
        List.length_take_of_le hk, Nat.sub_self, List.getElem?_cons_zero, forestAt_nil_path,
        Option.some.injEq] at hG'
      subst hG'
      simp [Tree.empty, Tree.cols] at hcc
    · right; right
      have := forestAt_litCapAux_off k p c.col c.path π E G' ⟨col, hcol, hk⟩ hpre hcap hG'
      simp only [Tree.colAt, this, Option.bind_some, hcc]

/-- helper: at level `d` of the cap address, the containing entry is entry-ordered after its
predecessor in the cap. -/
def LastOK (K : Forest) (cs : ColAddr) (d : Nat) : Prop :=
  ∀ a e (x y : Nat × Forest), cs.path[d]? = some (a, e) →
    ((K.colAt ⟨cs.path.take d, a⟩).getD [])[e]? = some x →
    ((K.colAt ⟨cs.path.take d, a⟩).getD [])[e - 1]? = some y → 1 ≤ e → EntryLe x y

/-- helper: H for a literal cap of an H-expression whose containing entries and closing entry are
entry-ordered after their predecessors. -/
theorem condH_litCap {E : Forest} (hH : CondH E) {cs : ColAddr} {col : Column}
    (hcol : E.colAt cs = some col) {k p : Nat} (hk : k ≤ col.length)
    (hlast : ∀ d, d < cs.path.length → LastOK (litCap E cs k p) cs d)
    (hcap : 1 ≤ k → ∀ y, col[k - 1]? = some y → p ≤ y.1) : CondH (litCap E cs k p) := by
  intro a ha t x y hx hy
  obtain ⟨col', hcol'⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff _ _).1 ha)
  rw [hcol', Option.getD_some] at hx hy
  rcases colAt_litCap_cases hcol hk p hcol' with ⟨rfl, rfl⟩ | ⟨e, rest, Ecol, q, H, H', hpath, hEa, hEe, rfl⟩ | hEa
  · have hamem : a ∈ E.colAddrs := (Tree.mem_colAddrs_iff _ _).2 (by rw [hcol]; rfl)
    have hl : (col.take k).length = k := List.length_take_of_le hk
    by_cases ht : t + 1 < k
    · rw [List.getElem?_append_left (by omega), List.getElem?_take_of_lt (by omega)] at hx hy
      exact hH a hamem t x y (by rw [hcol]; exact hx) (by rw [hcol]; exact hy)
    · have ht' : t + 1 = k := by
        have := (List.getElem?_eq_some_iff.1 hy).1; simp at this; omega
      rw [List.getElem?_append_left (by omega), List.getElem?_take_of_lt (by omega)] at hx
      rw [List.getElem?_append_right (by omega), hl, ht', Nat.sub_self] at hy
      simp only [List.getElem?_cons_zero, Option.some.injEq] at hy
      subst hy
      have := hcap (by omega) x (by rw [show k - 1 = t by omega]; exact hx)
      rcases Nat.lt_or_eq_of_le this with h | h
      · exact Or.inl h
      · exact Or.inr ⟨h, empty_le_forest _⟩
  · have hamem : a ∈ E.colAddrs := (Tree.mem_colAddrs_iff _ _).2 (by rw [hEa]; rfl)
    have he : e < Ecol.length := (List.getElem?_eq_some_iff.1 hEe).1
    have hl : (Ecol.take e).length = e := List.length_take_of_le he.le
    by_cases ht : t + 1 < e
    · rw [List.getElem?_append_left (by omega), List.getElem?_take_of_lt (by omega)] at hx hy
      exact hH a hamem t x y (by rw [hEa]; exact hx) (by rw [hEa]; exact hy)
    · have ht' : t + 1 = e := by
        have := (List.getElem?_eq_some_iff.1 hy).1; simp at this; omega
      subst ht'
      have hd : a.path.length < cs.path.length := by rw [hpath]; simp
      have hpd : cs.path[a.path.length]? = some (a.col, t + 1) := by rw [hpath]; simp
      have htk : cs.path.take a.path.length = a.path := by rw [hpath]; simp
      have := hlast a.path.length hd a.col (t + 1) y x hpd
      rw [htk, show (⟨a.path, a.col⟩ : ColAddr) = a from rfl, hcol', Option.getD_some] at this
      exact this hy (by rw [show t + 1 - 1 = t by omega]; exact hx) (by omega)
  · have hamem : a ∈ E.colAddrs := (Tree.mem_colAddrs_iff _ _).2 (by rw [hEa]; rfl)
    exact hH a hamem t x y (by rw [hEa]; exact hx) (by rw [hEa]; exact hy)

theorem forestAt_applyMove_through {K : Forest} {m : Move} {col : Column}
    (hcol : K.colAt m.col = some col) (hij : m.i < m.j) (hj : m.j < col.length) (R : List (Nat × Nat)) :
    (applyMove K m).forestAt (m.col.path ++ (m.col.col, m.i) :: R) =
      K.forestAt (m.col.path ++ (m.col.col, m.j) :: R) := by
  rw [applyMove_eq_mod hcol hij hj, forestAt_modifyColAux_through, forestAt_through_col,
    show (⟨m.col.path, m.col.col⟩ : ColAddr) = m.col from rfl, hcol]
  simp only [Option.bind_some, moveFun]
  rw [getElem?_moveFun m col hij.le hj.le]
  have : m.bwdIdx m.i = m.j := by unfold Move.bwdIdx; rw [if_pos le_rfl]; omega
  rw [this]

/-- helper: parents of an A-column are nonincreasing between any two indices. -/
theorem parents_antitone_le {E : Forest} (hV : CondV E) {ks : KeySys} (hA : CondAK E ks)
    {b : ColAddr} {Ecol : Column} (hb : E.colAt b = some Ecol) :
    ∀ n x, x + n < Ecol.length → (Ecol.getD (x + n) (0, Tree.empty)).1 ≤ (Ecol.getD x (0, Tree.empty)).1 := by
  have hbm : b ∈ E.colAddrs := (Tree.mem_colAddrs_iff _ _).2 (by rw [hb]; rfl)
  intro n
  induction n with
  | zero => intro x _; exact le_refl _
  | succ n ih =>
    intro x hx
    have h1 := ih x (by omega)
    have h2 := parents_antitone hV hA hbm (i := x + n)
      (p := (Ecol.getD (x + n + 1) (0, Tree.empty)).1) (q := (Ecol.getD (x + n) (0, Tree.empty)).1)
      (by simp [parents, hb, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (show x + n + 1 < Ecol.length by omega)])
      (by simp [parents, hb, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (show x + n < Ecol.length by omega)])
    rw [show x + (n + 1) = x + n + 1 by omega]
    exact le_trans h2 h1

theorem getD_take_snoc_lt {Ecol : Column} {e x : Nat} (z : Nat × Forest) (he : e ≤ Ecol.length)
    (hx : x < e) : (Ecol.take e ++ [z]).getD x (0, Tree.empty) = Ecol.getD x (0, Tree.empty) := by
  simp only [List.getD_eq_getElem?_getD]
  rw [List.getElem?_append_left (by rw [List.length_take_of_le he]; exact hx), List.getElem?_take_of_lt hx]

theorem getD_take_snoc_self {Ecol : Column} {e : Nat} (z : Nat × Forest) (he : e ≤ Ecol.length) :
    (Ecol.take e ++ [z]).getD e (0, Tree.empty) = z := by
  simp only [List.getD_eq_getElem?_getD]
  rw [List.getElem?_append_right (by rw [List.length_take_of_le he]), List.length_take_of_le he]
  simp

theorem getElem?_eq_getD {Ecol : Column} {x : Nat} (hx : x < Ecol.length) :
    Ecol[x]? = some (Ecol.getD x (0, Tree.empty)) := by
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hx]; rfl

/-- helper: the invariant of the inside-out repair after the levels `≥ ℓ` are repaired. -/
def RepairState (E : Forest) (c : ColAddr) (k p ℓ : Nat) : Prop :=
  ∃ (ms : List Move) (cs : ColAddr), MovesValid (litCap E c k p) ms ∧
    applyMoves (litCap E c k p) ms = litCap E cs k p ∧ IsUpward E cs k p ∧
    ((E.colAt cs).getD []).take k = ((E.colAt c).getD []).take k ∧
    cs.path.length = c.path.length ∧ CondV (litCap E cs k p) ∧ CondI (litCap E cs k p) ∧
    CondAK (litCap E cs k p) (capKeys (litCap E cs k p) (routeCols (litCap E cs k p))) ∧
    ∀ d, ℓ ≤ d → d < cs.path.length → LastOK (litCap E cs k p) cs d

theorem repair_step {E : Forest} (hL : InL E) {c : ColAddr} {k p d : Nat} (hd : d < c.path.length)
    (h : RepairState E c k p (d + 1)) : RepairState E c k p d := by
  classical
  obtain ⟨ms, cs, hmv, heq, hup', htk, hlen, hV', hI', hA', hlast⟩ := h
  obtain ⟨col_s, hcol_s, hk_s, -⟩ := isUpward_iff_exists.1 hup'
  have hd' : d < cs.path.length := by omega
  obtain ⟨a, e, T, R, hTl, hsplit⟩ : ∃ a e T R, T.length = d ∧ cs.path = T ++ (a, e) :: R := by
    refine ⟨cs.path[d].1, cs.path[d].2, cs.path.take d, cs.path.drop (d + 1), by simp; omega, ?_⟩
    exact path_split_at hd'
  have hgetT : ∀ (x : Nat × Nat) (d'' : Nat), d < d'' → (T ++ x :: R)[d'']? = R[d'' - d - 1]? := by
    intro x d'' h
    rw [List.getElem?_append_right (by omega), hTl, show d'' - d = (d'' - d - 1) + 1 by omega]; rfl
  have htakeT : ∀ (x : Nat × Nat) (d'' : Nat), d < d'' →
      (T ++ x :: R).take d'' = T ++ x :: R.take (d'' - d - 1) := by
    intro x d'' h
    rw [List.take_append, List.take_of_length_le (by omega), hTl,
      show d'' - d = (d'' - d - 1) + 1 by omega, List.take_succ_cons, Nat.add_sub_cancel]
  obtain ⟨Ecol, q, H, hEcol, hEe, hHcol, hKcol⟩ := colAt_litCap_container hcol_s hsplit k p
  have he : e < Ecol.length := (List.getElem?_eq_some_iff.1 hEe).1
  have hqe : (Ecol.getD e (0, Tree.empty)).1 = q := by
    simp [List.getD_eq_getElem?_getD, hEe]
  have hantiE := parents_antitone_le hL.1 hL.2.2.2.1 hEcol
  have hbK : (⟨T, a⟩ : ColAddr) ∈ (litCap E cs k p).colAddrs :=
    (Tree.mem_colAddrs_iff _ _).2 (by rw [hKcol]; rfl)
  have hpK : ∀ x, x < e → (parents (litCap E cs k p) ⟨T, a⟩)[x]? = some (Ecol.getD x (0, Tree.empty)).1 := by
    intro x hx
    simp only [parents, hKcol, Option.getD_some, List.getElem?_map]
    rw [List.getElem?_append_left (by rw [List.length_take_of_le he.le]; exact hx),
      List.getElem?_take_of_lt hx, getElem?_eq_getD (by omega)]; rfl
  have hpKe : (parents (litCap E cs k p) ⟨T, a⟩)[e]? = some q := by
    simp only [parents, hKcol, Option.getD_some, List.getElem?_map]
    rw [List.getElem?_append_right (by rw [List.length_take_of_le he.le]), List.length_take_of_le he.le]
    simp
  by_cases hv : ∃ x, x < e ∧ (Ecol.getD x (0, Tree.empty)).1 = q ∧
      (Ecol.getD x (0, Tree.empty)).2 < litCapAux k p R cs.col H
  · -- a violation: move the containing entry back to the least admissible index
    have hi := Nat.find_spec hv
    have hmin : ∀ x < Nat.find hv, ¬ (x < e ∧ (Ecol.getD x (0, Tree.empty)).1 = q ∧
        (Ecol.getD x (0, Tree.empty)).2 < litCapAux k p R cs.col H) := fun x hx => Nat.find_min hv hx
    generalize Nat.find hv = i at hi hmin
    let m : Move := ⟨⟨T, a⟩, i, e⟩
    have hparE : ∀ x, i ≤ x → x ≤ e → (Ecol.getD x (0, Tree.empty)).1 = q := by
      intro x h1 h2
      have u1 := hantiE (x - i) i (by omega)
      have u2 := hantiE (e - x) x (by omega)
      rw [show i + (x - i) = x by omega, hi.2.1] at u1
      rw [show x + (e - x) = e by omega, hqe] at u2
      omega
    have hmok : MoveOK (litCap E cs k p) m := by
      refine ⟨Ecol.take e ++ [(q, litCapAux k p R cs.col H)], _, hKcol, stopData_litCap' hcol_s k p,
        ?_, hi.1, ?_, ?_, ?_, ?_⟩
      · simp [m, List.length_take_of_le he.le]
      · show (T ++ [(a, e)]) <+: cs.path
        exact ⟨R, by rw [hsplit]; simp⟩
      · intro x h1 h2
        show ((Ecol.take e ++ [(q, litCapAux k p R cs.col H)]).getD x (0, Tree.empty)).1 =
          ((Ecol.take e ++ [(q, litCapAux k p R cs.col H)]).getD e (0, Tree.empty)).1
        rw [getD_take_snoc_self _ he.le]
        rcases Nat.lt_or_eq_of_le h2 with h | rfl
        · rw [getD_take_snoc_lt _ he.le h]; exact hparE x h1 h.le
        · rw [getD_take_snoc_self _ he.le]
      · show ((Ecol.take e ++ [(q, litCapAux k p R cs.col H)]).getD i (0, Tree.empty)).2 <
          ((Ecol.take e ++ [(q, litCapAux k p R cs.col H)]).getD e (0, Tree.empty)).2
        rw [getD_take_snoc_lt _ he.le hi.1, getD_take_snoc_self _ he.le]; exact hi.2.2
      · intro x hx hq'
        show ¬ ((Ecol.take e ++ [(q, litCapAux k p R cs.col H)]).getD x (0, Tree.empty)).2 <
          ((Ecol.take e ++ [(q, litCapAux k p R cs.col H)]).getD e (0, Tree.empty)).2
        change ((Ecol.take e ++ [(q, litCapAux k p R cs.col H)]).getD x (0, Tree.empty)).1 =
          ((Ecol.take e ++ [(q, litCapAux k p R cs.col H)]).getD e (0, Tree.empty)).1 at hq'
        have hxe : x < e := by have := hi.1; simp [m] at hx; omega
        rw [getD_take_snoc_lt _ he.le hxe, getD_take_snoc_self _ he.le] at hq' ⊢
        exact fun hlt => hmin x hx ⟨hxe, hq', hlt⟩
    obtain ⟨rest', hrest', hupN, hmove, htk'⟩ := litCap_move_step hL.2.2.1 hup' hmok
    have hR' : rest' = R := by
      have h1 : T ++ (a, e) :: rest' = T ++ (a, e) :: R := hrest'.symm.trans hsplit
      simpa using h1
    subst hR'
    obtain ⟨hVN, hIN, hAN⟩ := decoratedA_applyMove hmok hV' hA'
    rw [hmove] at hVN hIN hAN
    have hKcolN : (litCap E ⟨T ++ (a, i) :: rest', cs.col⟩ k p).colAt ⟨T, a⟩ =
        some (Ecol.take i ++ [(q, litCapAux k p rest' cs.col H)]) := by
      show (litCap E ⟨m.col.path ++ (m.col.col, m.i) :: rest', cs.col⟩ k p).colAt m.col = _
      rw [← hmove, applyMove_eq_mod hKcol hi.1 (by simp [m, List.length_take_of_le he.le]),
        colAt_mod_self, hKcol]
      simp only [Option.map_some, moveFun, m]
      congr 1
      rw [List.take_append_of_le_length (by rw [List.length_take_of_le he.le]; omega), List.take_take,
        Nat.min_eq_left hi.1.le, List.drop_left' (List.length_take_of_le he.le)]
    refine ⟨ms ++ [m], ⟨T ++ (a, i) :: rest', cs.col⟩, movesValid_snoc hmv (by rw [heq]; exact hmok),
      by rw [applyMoves_snoc, heq, hmove], hupN, htk'.trans htk, ?_, hVN, hIN hI', hAN, ?_⟩
    · have := congrArg List.length hsplit; simp at this ⊢; omega
    · intro d'' h1 h2
      rcases Nat.lt_or_eq_of_le h1 with hlt | rfl
      · intro a' e' x y hpd hx hy he1
        have hlt' := hlast d'' (by omega) (by simp at h2; rw [hsplit]; simp; omega) a' e' x y
        rw [hsplit, hgetT _ _ hlt] at hlt'
        simp only at hpd
        rw [hgetT _ _ hlt] at hpd
        rw [htakeT _ _ hlt] at hx hy
        rw [htakeT _ _ hlt] at hlt'
        have hcolEq : (litCap E ⟨T ++ (a, i) :: rest', cs.col⟩ k p).colAt
            ⟨T ++ (a, i) :: rest'.take (d'' - d - 1), a'⟩ =
            (litCap E cs k p).colAt ⟨T ++ (a, e) :: rest'.take (d'' - d - 1), a'⟩ := by
          simp only [Tree.colAt]
          rw [← hmove]
          have := forestAt_applyMove_through (m := m) hKcol hi.1
            (by simp [m, List.length_take_of_le he.le]) (rest'.take (d'' - d - 1))
          simp only [m] at this
          rw [this]
        rw [hcolEq] at hx hy
        exact hlt' hpd hx hy he1
      · intro a' e' x y hpd hx hy he1
        simp only at hpd
        rw [List.getElem?_append_right (by omega), hTl, Nat.sub_self] at hpd
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hpd
        obtain ⟨rfl, rfl⟩ := hpd
        simp only at hx hy
        rw [List.take_left' hTl, hKcolN, Option.getD_some] at hx hy
        rw [List.getElem?_append_right (by rw [List.length_take_of_le (by omega)]),
          List.length_take_of_le (by omega), Nat.sub_self] at hx
        simp only [List.getElem?_cons_zero, Option.some.injEq] at hx
        subst hx
        rw [List.getElem?_append_left (by rw [List.length_take_of_le (by omega)]; omega),
          List.getElem?_take_of_lt (by omega), getElem?_eq_getD (by omega), Option.some.injEq] at hy
        subst hy
        have hanti := hantiE 1 (i - 1) (by omega)
        rw [show i - 1 + 1 = i by omega, hi.2.1] at hanti
        by_cases hyq : (Ecol.getD (i - 1) (0, Tree.empty)).1 = q
        · right
          refine ⟨hyq.symm, not_lt.1 fun hlt => hmin (i - 1) (by omega) ⟨by omega, hyq, hlt⟩⟩
        · left; omega
  · -- no violation at this level
    refine ⟨ms, cs, hmv, heq, hup', htk, hlen, hV', hI', hA', ?_⟩
    intro d'' h1 h2
    rcases Nat.lt_or_eq_of_le h1 with hlt | rfl
    · exact hlast d'' hlt h2
    · intro a' e' x y hpd hx hy he1
      rw [hsplit, List.getElem?_append_right (by omega), hTl, Nat.sub_self] at hpd
      simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hpd
      obtain ⟨rfl, rfl⟩ := hpd
      rw [hsplit, List.take_left' hTl, hKcol, Option.getD_some] at hx hy
      rw [List.getElem?_append_right (by rw [List.length_take_of_le he.le]),
        List.length_take_of_le he.le, Nat.sub_self] at hx
      simp only [List.getElem?_cons_zero, Option.some.injEq] at hx
      subst hx
      rw [List.getElem?_append_left (by rw [List.length_take_of_le he.le]; omega),
        List.getElem?_take_of_lt (by omega), getElem?_eq_getD (by omega), Option.some.injEq] at hy
      subst hy
      have hanti := parents_antitone hV' hA' hbK (i := e - 1) (p := q)
        (q := (Ecol.getD (e - 1) (0, Tree.empty)).1) (by rw [show e - 1 + 1 = e by omega]; exact hpKe)
        (hpK _ (by omega))
      by_cases hyq : (Ecol.getD (e - 1) (0, Tree.empty)).1 = q
      · right
        exact ⟨hyq.symm, not_lt.1 fun hlt => hv ⟨e - 1, by omega, hyq, hlt⟩⟩
      · left; omega

-- provides: U2, L3.1 (`repair`†, txt:283-298)
theorem repair {E : Forest} (hL : InL E) (hP : CondP E) {c : ColAddr} {k p : Nat}
    (hup : IsUpward E c k p) (hKV : CondV (litCap E c k p)) (hKI : CondI (litCap E c k p))
    (hKA : CondAK (litCap E c k p) (capKeys (litCap E c k p) (routeCols (litCap E c k p)))) :
    ∃ w : AdmCap E, w.col = c ∧ w.cut = k ∧ w.par = p ∧
      (∃ sd, stopData w.H = some sd ∧ sd.r = p ∧ sd.Q = ((E.colAt c).getD []).take k) ∧
      ∃ c', IsUpward E c' k p ∧ w.H = litCap E c' k p := by
  have hR : ∀ t, t ≤ c.path.length → RepairState E c k p (c.path.length - t) := by
    intro t
    induction t with
    | zero =>
      intro _
      refine ⟨[], c, fun idx h => absurd h (by simp), rfl, hup, rfl, rfl, hKV, hKI, hKA, ?_⟩
      intro d h1 h2; omega
    | succ t ih =>
      intro ht
      have := repair_step hL (c := c) (k := k) (p := p) (d := c.path.length - (t + 1)) (by omega)
        (by rw [show c.path.length - (t + 1) + 1 = c.path.length - t by omega]; exact ih (by omega))
      exact this
  obtain ⟨ms, cs, hmv, heq, hup', htk, hlen, hV', hI', hA', hlast⟩ := hR c.path.length le_rfl
  rw [Nat.sub_self] at hlast
  obtain ⟨col, hcol, hk, -⟩ := isUpward_iff_exists.1 hup'
  have hcsK : (litCap E cs k p).colAt cs = some (col.take k ++ [(p, Tree.empty)]) := by
    rw [litCap_eq_aux hcol]; exact colAt_litCapAux_self hcol k p
  have hcsm : cs ∈ (litCap E cs k p).colAddrs := (Tree.mem_colAddrs_iff _ _).2 (by rw [hcsK]; rfl)
  have hcap : 1 ≤ k → ∀ y, col[k - 1]? = some y → p ≤ y.1 := by
    intro hk1 y hy
    have hy' : (col.take k ++ [(p, Tree.empty)])[k - 1]? = some y := by
      rw [List.getElem?_append_left (by rw [List.length_take_of_le hk]; omega),
        List.getElem?_take_of_lt (by omega)]; exact hy
    have hp' : (col.take k ++ [(p, Tree.empty)])[k]? = some (p, Tree.empty) := by
      rw [List.getElem?_append_right (by rw [List.length_take_of_le hk]), List.length_take_of_le hk]
      simp
    refine parents_antitone hV' hA' hcsm (i := k - 1) ?_ ?_
    · simp only [parents, hcsK, Option.getD_some, List.getElem?_map]
      rw [show k - 1 + 1 = k by omega, hp']; rfl
    · simp only [parents, hcsK, Option.getD_some, List.getElem?_map, hy']; rfl
  have hHf := condH_litCap hL.2.2.1 hcol hk (fun d hd => hlast d (Nat.zero_le d) hd) hcap
  have hSf := upward_condS hL.1 hL.2.1 hL.2.2.1 hP hup' hV' hI'
  have hAf := (capping_iff hV' hSf (sel := routeCols (litCap E cs k p)) (fun a h => h)).2 hA'
  have hinL : InL (applyMoves (litCap E c k p) ms) := by
    rw [heq]; exact ⟨hV', hI', hHf, hAf, hSf⟩
  refine ⟨⟨c, k, p, ms, hup, hmv, hinL⟩, rfl, rfl, rfl, ?_, cs, hup', heq⟩
  refine ⟨⟨cs.path.length, cs, cs.num 0, p, col.take k⟩, ?_, rfl, ?_⟩
  · show stopData (applyMoves (litCap E c k p) ms) = _
    rw [heq, stopData_litCap' hcol k p]
  · show col.take k = _
    rw [← htk, hcol, Option.getD_some]


/-! ## D3.1d, D3.1e — integration additions (requested by U3 R10–R13, R15, R18, R19 and U5 R16,
R17; formerly stubs in `U3.lean` / `U5.lean`) -/

/-! ### D3.1d helpers: origins of ordinary roles and slots -/

theorem backRole_ord : ∀ (ms : List Move) (c : ColAddr),
    ∃ c', backRole ms (.ord c) = .ord c' ∧ c'.num 0 = c.num 0
  | [], c => ⟨c, rfl, rfl⟩
  | m :: ms, c => by
    obtain ⟨c', h1, h2⟩ := backRole_ord ms c
    refine ⟨bwdC m c', ?_, by rw [num_bwdC, h2]⟩
    show m.mapRole m.bwdIdx (backRole ms (.ord c)) = _
    rw [h1]; rfl

theorem origin_ord {E : Forest} (w : AdmCap E) (c : ColAddr) :
    ∃ c', w.origin (.ord c) = some (.ord c') ∧ c'.num 0 = c.num 0 := by
  obtain ⟨c', h1, h2⟩ := backRole_ord w.moves c
  exact ⟨c', by rw [originBody_eq, h1, if_neg (by simp)], h2⟩

/-- helper: an entry of the moved tree, undone, keeps its label and its column. -/
theorem adm_entries {K : Forest} :
    ∀ ms : List Move, MovesValid K ms → ∀ e, ((applyMoves K ms).entryAt e).isSome →
      ∃ e₀, backRole ms (.slot e) = .slot e₀ ∧ backRole ms (.ord e.col) = .ord e₀.col ∧
        ((applyMoves K ms).entryAt e).map Prod.fst = (K.entryAt e₀).map Prod.fst := by
  intro ms
  induction ms using List.reverseRecOn with
  | nil => intro _ e _; exact ⟨e, rfl, rfl, rfl⟩
  | append_singleton ms m ih =>
    intro hv e he
    obtain ⟨hv, hm⟩ := movesValid_append hv
    obtain ⟨col, -, hcol, -, hj, hij, -⟩ := hm
    have hj' : m.j < col.length := by omega
    rw [applyMoves_snoc] at he ⊢
    -- the backward entry of `e` in the tree before the move
    obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 he
    obtain ⟨col', hcol', hidx⟩ := Tree.colAt_of_entryAt hx
    obtain ⟨col0, hcol0, hmc, hnc⟩ := colAt_mod_corr hcol hij hj' hcol'
    have hlab : ∃ y, (applyMoves K ms).entryAt (m.mapEntry m.bwdIdx e) = some y ∧ y.1 = x.1 := by
      by_cases hem : e.col = m.col
      · obtain ⟨rfl, -⟩ := hmc hem
        have hme : m.mapEntry m.bwdIdx e = ⟨m.col, m.bwdIdx e.idx⟩ := by
          unfold Move.mapEntry; dsimp only
          have : (⟨m.mapPath m.bwdIdx e.col.path, e.col.col⟩ : ColAddr) = m.col := by
            rw [hem, mapPath_off _ _ _ (fun e D he => by have := congrArg List.length he; simp at this)]
          rw [if_pos this, this]
        rw [moveFun, getElem?_moveFun m col hij.le hj'.le] at hidx
        refine ⟨x, ?_, rfl⟩
        rw [hme]; simp only [Tree.entryAt, hcol, Option.bind_some]; exact hidx
      · obtain ⟨hl, -⟩ := hnc hem
        have h1 := congrArg (·[e.idx]?) hl
        simp only [List.getElem?_map, hidx, Option.map_some] at h1
        obtain ⟨y, hy, hyx⟩ := Option.map_eq_some_iff.1 h1.symm
        have hme : m.mapEntry m.bwdIdx e = ⟨bwdC m e.col, e.idx⟩ := by
          unfold Move.mapEntry; dsimp only
          rw [if_neg]; rfl
          intro h'; apply hem
          have := (colAddr_mapPath_eq_iff m.bwdIdx m e.col.path e.col.col).1 h'
          exact this
        refine ⟨y, ?_, hyx⟩
        rw [hme]; simp only [Tree.entryAt, hcol0, Option.bind_some]; exact hy
    obtain ⟨y, hy, hyx⟩ := hlab
    obtain ⟨e₀, h1, h2, h3⟩ := ih hv (m.mapEntry m.bwdIdx e) (by rw [hy]; rfl)
    refine ⟨e₀, ?_, ?_, ?_⟩
    · rw [backRole_append]; exact h1
    · rw [backRole_append]
      show backRole ms (.ord ⟨m.mapPath m.bwdIdx e.col.path, e.col.col⟩) = _
      rw [← mapEntry_col]; exact h2
    · rw [hx, ← h3, hy]; simp [hyx]

theorem bwd_moved_ord (m : Move) (hij : m.i ≤ m.j) (rest : List (Nat × Nat)) (cc : Nat) :
    m.mapRole m.bwdIdx (.ord ⟨m.col.path ++ (m.col.col, m.i) :: rest, cc⟩) =
      .ord ⟨m.col.path ++ (m.col.col, m.j) :: rest, cc⟩ := by
  simp only [Move.mapRole, mapPath_through]
  have hb : m.bwdIdx m.i = m.j := by unfold Move.bwdIdx; rw [if_pos le_rfl]; omega
  rw [hb]

/-- helper: the stop data of an admissible cap and the origins of its stopping column. -/
theorem adm_stop {E : Forest} {c : ColAddr} {k p : Nat} {col : Column} (hcol : E.colAt c = some col) :
    ∀ ms : List Move, MovesValid (litCap E c k p) ms →
      ∃ c', stopData (applyMoves (litCap E c k p) ms) =
          some { depth := c.path.length, col := c', t := c.num 0, r := p, Q := col.take k } ∧
        backRole ms (.ord c') = .ord c ∧ ∀ n, backRole ms (.slot ⟨c', n⟩) = .slot ⟨c, n⟩ := by
  intro ms
  induction ms using List.reverseRecOn with
  | nil => intro _; exact ⟨c, stopData_litCap' hcol k p, rfl, fun _ => rfl⟩
  | append_singleton ms m ih =>
    intro hv
    obtain ⟨hv, hm⟩ := movesValid_append hv
    obtain ⟨c', hsd, hord, hslot⟩ := ih hv
    obtain ⟨rest, hpath, hsd'⟩ := stopData_applyMove hm hsd
    obtain ⟨-, -, -, -, -, hij, -⟩ := hm
    rw [applyMoves_snoc]
    refine ⟨_, hsd', ?_, fun n => ?_⟩
    · rw [backRole_append]
      simp only at hpath ⊢
      rw [bwd_moved_ord m hij.le, ← hpath]; exact hord
    · rw [backRole_append]
      simp only at hpath ⊢
      rw [bwd_moved_slot m hij.le, ← hpath]; exact hslot n

theorem container_eq (o c : ColAddr) {k ck ik : Nat} (hp : o.path = c.path.take k)
    (hk : c.path[k]? = some (ck, ik)) :
    o.container c = if ck = o.col then some ⟨o, ik⟩ else none := by
  have hkl : k < c.path.length := (List.getElem?_eq_some_iff.1 hk).1
  have hn : o.path.length = k := by rw [hp]; simp; omega
  unfold ColAddr.container
  rw [hn, List.drop_eq_getElem_cons hkl, (List.getElem?_eq_some_iff.1 hk).2]
  simp only
  by_cases h : ck = o.col
  · rw [if_pos ⟨hp.symm, h⟩, if_pos h]
  · rw [if_neg (fun h' => h h'.2), if_neg h]

theorem container_bwdC (m : Move) {c o : ColAddr} (h : c.OnStack o) :
    (bwdC m o).container (bwdC m c) = (o.container c).map (m.mapEntry m.bwdIdx) := by
  rcases h with ⟨k, ck, ik, hk, hp, hc⟩ | ⟨hp, hc⟩
  · have hkl : k < c.path.length := (List.getElem?_eq_some_iff.1 hk).1
    have hfst := mapPath_getElem_fst m.bwdIdx m c.path k
    rw [hk] at hfst
    obtain ⟨⟨ck', ik'⟩, hk', hck'⟩ := Option.map_eq_some_iff.1 hfst
    simp only at hck'; subst hck'
    have hp' : (bwdC m o).path = (bwdC m c).path.take k := by
      simp only [bwdC]; rw [hp, mapPath_take]
    rw [container_eq o c hp hk, container_eq (bwdC m o) (bwdC m c) hp' hk']
    by_cases hck : ck' = o.col
    · rw [if_pos hck, if_pos (show ck' = (bwdC m o).col from hck)]
      simp only [bwdC, Option.map_some, Option.some.injEq]
      unfold Move.mapEntry; dsimp only
      -- compare the backward entry index with `ik'`
      rcases mapPath_cases m c.path with ⟨e, D, hD⟩ | hoff
      · rw [hD, mapPath_through] at hk'
        rw [hD] at hk hp
        rcases lt_trichotomy k m.col.path.length with hlt | heq | hgt
        · rw [List.getElem?_append_left hlt] at hk hk'
          rw [hk] at hk'; obtain ⟨-, rfl⟩ := Prod.mk.inj (Option.some.inj hk')
          rw [if_neg]
          intro h'
          have := congrArg (fun c : ColAddr => c.path.length) h'
          simp only [mapPath_length, hp, List.length_take, List.length_append, List.length_cons] at this
          omega
        · subst heq
          simp only [List.getElem?_append_right le_rfl, Nat.sub_self, List.getElem?_cons_zero,
            Option.some.injEq, Prod.mk.injEq] at hk hk'
          obtain ⟨rfl, rfl⟩ := hk
          obtain ⟨-, rfl⟩ := hk'
          have hop : o.path = m.col.path := by rw [hp]; simp
          rw [if_pos]
          rw [hop, mapPath_off _ _ _ (fun e D he => by have := congrArg List.length he; simp at this)]
          rw [← hck]
        · rw [List.getElem?_append_right hgt.le,
            show k - m.col.path.length = (k - m.col.path.length - 1) + 1 by omega] at hk hk'
          simp only [List.getElem?_cons_succ] at hk hk'
          rw [hk] at hk'; obtain ⟨-, rfl⟩ := Prod.mk.inj (Option.some.inj hk')
          rw [if_neg]
          intro h'
          have := congrArg (fun c : ColAddr => c.path.length) h'
          simp only [mapPath_length, hp, List.length_take, List.length_append, List.length_cons] at this
          omega
      · rw [mapPath_off _ _ _ hoff] at hk'
        rw [hk] at hk'; obtain ⟨-, rfl⟩ := Prod.mk.inj (Option.some.inj hk')
        rw [if_neg]
        intro h'
        rw [colAddr_mapPath_eq_iff] at h'
        apply hoff ik (c.path.drop (k + 1))
        have h1 : o.path = m.col.path := congrArg ColAddr.path h'
        have h2 : o.col = m.col.col := congrArg ColAddr.col h'
        conv_lhs => rw [path_split_at hkl]
        rw [(List.getElem?_eq_some_iff.1 hk).2, ← hp, h1, hck, h2]
    · rw [if_neg hck, if_neg (show ¬ ck' = (bwdC m o).col from hck)]; rfl
  · unfold ColAddr.container
    simp only [bwdC, hp, List.drop_length]
    rfl

theorem rep_bwdC (m : Move) (c : ColAddr) (q : Nat) :
    (bwdC m c).rep 0 q = (c.rep 0 q).map (fun ov => (m.mapRole m.bwdIdx ov.1, m.mapRole m.bwdIdx ov.2)) := by
  simp only [ColAddr.rep, resolve_bwdC]
  cases h : c.resolve 0 q with
  | none => rfl
  | some o =>
    simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq]
    have hst := ((ColAddr.resolve_spec 0 c o q).1 h).1
    rw [container_bwdC m hst]
    refine ⟨rfl, ?_⟩
    cases o.container c with
    | none => rfl
    | some e => rfl

/-- helper: undo a list of moves on a column address. -/
def backC (ms : List Move) (c : ColAddr) : ColAddr := ms.foldr (fun m c => bwdC m c) c

theorem backRole_ord_eq : ∀ (ms : List Move) (c : ColAddr), backRole ms (.ord c) = .ord (backC ms c)
  | [], _ => rfl
  | m :: ms, c => by
    show m.mapRole m.bwdIdx (backRole ms (.ord c)) = _
    rw [backRole_ord_eq ms c]; rfl

theorem rep_backC : ∀ (ms : List Move) (c : ColAddr) (q : Nat),
    (backC ms c).rep 0 q = (c.rep 0 q).map (fun ov => (backRole ms ov.1, backRole ms ov.2))
  | [], c, q => by simp [backC, backRole]
  | m :: ms, c, q => by
    show (bwdC m (backC ms c)).rep 0 q = _
    rw [rep_bwdC, rep_backC ms c q, Option.map_map]
    rfl

theorem heightAt_ne_of_col {E : Forest} {c : ColAddr} {e : EntryAddr} (hc : (E.colAt c).isSome)
    (he : e.heightPath <+: c.path) : ∃ H, E.heightAt e = some H ∧ H ≠ Tree.empty := by
  obtain ⟨rest, hrest⟩ := he
  obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 hc
  simp only [Tree.colAt, Option.bind_eq_some_iff] at hcol
  obtain ⟨G, hG, hGc⟩ := hcol
  rw [← hrest, Tree.forestAt_append, Tree.forestAt_heightPath, Option.bind_eq_some_iff] at hG
  obtain ⟨H, hH, hG⟩ := hG
  refine ⟨H, hH, ?_⟩
  rintro rfl
  cases rest with
  | nil =>
    rw [forestAt_nil_path] at hG; obtain rfl := Option.some.inj hG
    simp [Tree.empty, Tree.cols] at hGc
  | cons x rest => rw [forestAt_empty_node_cons] at hG; simp at hG

/-- helper (D3.1d, representatives clause of `origin_spec_full`). -/
theorem origin_reps {E : Forest} (w : AdmCap E) :
    ∀ c c', Role.ord c ∈ w.H.roles → w.origin (.ord c) = some (.ord c') → ∀ q, q < c.num 0 →
      (c.rep 0 q).map (fun ov => (Packet.anchorD E (some w) ov.1, Packet.anchorD E (some w) ov.2)) =
        c'.rep 0 q := by
  intro c c' hc h q _
  rw [originBody_eq, backRole_ord_eq, if_neg (by simp)] at h
  obtain rfl := Role.ord.inj (Option.some.inj h)
  rw [rep_backC]
  have hcs : (w.H.colAt c).isSome := (Tree.mem_roles_iff _ _).1 hc
  obtain ⟨col, hcol, hk, -⟩ := isUpward_iff_exists.1 w.upward
  obtain ⟨cs, hsd, -, hslot⟩ := adm_stop (k := w.cut) (p := w.par) hcol w.moves w.movesValid
  have hanD : ∀ x, backRole w.moves x ≠ .slot ⟨w.col, w.cut⟩ →
      Packet.anchorD E (some w) x = backRole w.moves x := by
    intro x hx
    simp only [Packet.anchorD, anchorOrigin, originBody_eq, if_neg hx, Option.getD_some]
  simp only [ColAddr.rep]
  cases hr : c.resolve 0 q with
  | none => rfl
  | some o =>
    simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq]
    refine ⟨hanD _ (by rw [backRole_ord_eq]; simp), ?_⟩
    cases hco : o.container c with
    | none => exact hanD _ (by rw [backRole_ord_eq]; simp)
    | some e =>
      apply hanD
      intro heq
      rw [← hslot w.cut] at heq
      have heq' := backRole_injective _ heq
      obtain rfl := Role.slot.inj heq'
      have hcont := ((ColAddr.container_spec o c _).1 hco).2
      obtain ⟨H, hH, hne⟩ := heightAt_ne_of_col hcs hcont
      obtain ⟨hcolsd, -⟩ := stopData_spec hsd
      have hentry : w.H.entryAt ⟨cs, w.cut⟩ = some (w.par, Tree.empty) := by
        simp only [Tree.entryAt]
        show ((applyMoves (litCap E w.col w.cut w.par) w.moves).colAt cs).bind _ = _
        rw [hcolsd]
        simp only [Option.bind_some]
        rw [List.getElem?_append_right (by simp), List.length_take_of_le hk]; simp
      rw [heightAt_of_entryAt hentry] at hH
      exact hne (Option.some.inj hH).symm

theorem modify_split {α : Type} {l : List α} {n : Nat} {x : α} (h : l[n]? = some x) (f : α → α) :
    l = l.take n ++ x :: l.drop (n + 1) ∧ l.modify n f = l.take n ++ f x :: l.drop (n + 1) := by
  have hn : n < l.length := (List.getElem?_eq_some_iff.1 h).1
  have hx : l[n] = x := (List.getElem?_eq_some_iff.1 h).2
  constructor
  · conv_lhs => rw [← List.take_append_drop n l, List.drop_eq_getElem_cons hn, hx]
  · rw [List.modify_eq_take_drop, List.drop_eq_getElem_cons hn, hx]; rfl

/-! ### D3.1e helpers: roles of a literal cap -/

theorem rolesCols_append {α : Type} (π : List (Nat × Nat)) :
    ∀ (c : Nat) (l₁ l₂ : List (List (α × Tree α))),
      Tree.rolesCols π c (l₁ ++ l₂) = Tree.rolesCols π c l₁ ++ Tree.rolesCols π (c + l₁.length) l₂
  | c, [], l₂ => by simp [Tree.rolesCols]
  | c, x :: l₁, l₂ => by
    rw [List.length_cons, show c + (l₁.length + 1) = c + 1 + l₁.length by omega]
    simp only [List.cons_append, Tree.rolesCols, rolesCols_append π (c + 1) l₁ l₂,
      List.append_assoc, List.cons_append]

theorem rolesCol_append {α : Type} (π : List (Nat × Nat)) (c : Nat) :
    ∀ (i : Nat) (l₁ l₂ : List (α × Tree α)),
      Tree.rolesCol π c i (l₁ ++ l₂) = Tree.rolesCol π c i l₁ ++ Tree.rolesCol π c (i + l₁.length) l₂
  | i, [], l₂ => by simp [Tree.rolesCol]
  | i, (x, h) :: l₁, l₂ => by
    rw [List.length_cons, show i + (l₁.length + 1) = i + 1 + l₁.length by omega]
    simp only [List.cons_append, Tree.rolesCol, rolesCol_append π c (i + 1) l₁ l₂,
      List.append_assoc, List.cons_append]

theorem rolesF_empty {α : Type} (π : List (Nat × Nat)) : Tree.rolesF π (Tree.empty : Tree α) = [] := by
  simp [Tree.empty, Tree.rolesF, Tree.rolesCols]

theorem roles_litCapAux (k p : Nat) :
    ∀ (ρ : List (Nat × Nat)) (j : Nat) (F : Forest) (col : Column) (π : List (Nat × Nat)),
      F.colAt ⟨ρ, j⟩ = some col → k ≤ col.length →
      ∃ n, n ≤ (Tree.rolesF π F).length ∧
        Tree.rolesF π (litCapAux k p ρ j F) = (Tree.rolesF π F).take n ++ [.slot ⟨⟨π ++ ρ, j⟩, k⟩]
  | [], j, .node cols, col, π, hcol, hk => by
    rw [colAt_node_nil] at hcol
    have hj : j < cols.length := (List.getElem?_eq_some_iff.1 hcol).1
    obtain ⟨h1, -⟩ := modify_split hcol id
    have hl : (cols.take j).length = j := List.length_take_of_le hj.le
    have hkl : (col.take k).length = k := List.length_take_of_le hk
    have hKr : Tree.rolesF π (litCapAux k p [] j (.node cols)) =
        Tree.rolesCols π 0 (cols.take j) ++ Role.ord ⟨π, j⟩ ::
          (Tree.rolesCol π j 0 (col.take k) ++ [Role.slot ⟨⟨π, j⟩, k⟩]) := by
      rw [litCapAux_nil, List.getD_eq_getElem?_getD, hcol, Option.getD_some]
      simp only [Tree.rolesF]
      rw [rolesCols_append, hl]
      simp only [Tree.rolesCols, List.append_nil]
      rw [rolesCol_append, Nat.zero_add, hkl]
      simp [Tree.rolesCol, rolesF_empty]
    have hEr : Tree.rolesF π (.node cols) =
        Tree.rolesCols π 0 (cols.take j) ++ Role.ord ⟨π, j⟩ ::
          (Tree.rolesCol π j 0 (col.take k) ++ (Tree.rolesCol π j k (col.drop k) ++
            Tree.rolesCols π (j + 1) (cols.drop (j + 1)))) := by
      simp only [Tree.rolesF]
      conv_lhs => rw [h1]
      rw [rolesCols_append, hl]
      simp only [Tree.rolesCols]
      conv_lhs => rw [← List.take_append_drop k col]
      rw [rolesCol_append]
      simp only [Nat.zero_add, hkl, List.append_assoc]
    rw [hKr, hEr]
    set A := Tree.rolesCols π 0 (cols.take j)
    set B := Tree.rolesCol π j 0 (col.take k)
    refine ⟨A.length + 1 + B.length, by simp; omega, ?_⟩
    rw [show A.length + 1 + B.length = (A ++ Role.ord ⟨π, j⟩ :: B).length by simp; omega]
    rw [show A ++ Role.ord ⟨π, j⟩ :: (B ++ (Tree.rolesCol π j k (col.drop k) ++
        Tree.rolesCols π (j + 1) (cols.drop (j + 1)))) = (A ++ Role.ord ⟨π, j⟩ :: B) ++
        (Tree.rolesCol π j k (col.drop k) ++ Tree.rolesCols π (j + 1) (cols.drop (j + 1))) by simp,
      List.take_left]
    simp
  | (ci, ei) :: ρ, j, .node cols, col, π, hcol, hk => by
    rw [colAt_node_cons] at hcol
    obtain ⟨x, hx, hcolx⟩ := Option.bind_eq_some_iff.1 hcol
    obtain ⟨colc, hc, hx'⟩ := Option.bind_eq_some_iff.1 hx
    obtain ⟨q, H⟩ := x
    have hci : ci < cols.length := (List.getElem?_eq_some_iff.1 hc).1
    have hei : ei < colc.length := (List.getElem?_eq_some_iff.1 hx').1
    have hget : (cols.getD ci [])[ei]? = some (q, H) := by
      rw [List.getD_eq_getElem?_getD, hc, Option.getD_some]; exact hx'
    obtain ⟨n', hn', hih⟩ := roles_litCapAux k p ρ j H col (π ++ [(ci, ei)]) hcolx hk
    obtain ⟨h1, -⟩ := modify_split hc id
    obtain ⟨h3, -⟩ := modify_split hx' id
    have hl : (cols.take ci).length = ci := List.length_take_of_le hci.le
    have hl' : (colc.take ei).length = ei := List.length_take_of_le hei.le
    have hKr : Tree.rolesF π (litCapAux k p ((ci, ei) :: ρ) j (.node cols)) =
        Tree.rolesCols π 0 (cols.take ci) ++ Role.ord ⟨π, ci⟩ ::
          (Tree.rolesCol π ci 0 (colc.take ei) ++ Role.slot ⟨⟨π, ci⟩, ei⟩ ::
            ((Tree.rolesF (π ++ [(ci, ei)]) H).take n' ++
              [Role.slot ⟨⟨π ++ [(ci, ei)] ++ ρ, j⟩, k⟩])) := by
      rw [litCapAux_cons k p ci ei j ρ cols hget, List.getD_eq_getElem?_getD, hc, Option.getD_some]
      simp only [Tree.rolesF]
      rw [rolesCols_append, hl]
      simp only [Tree.rolesCols, List.append_nil]
      rw [rolesCol_append]
      simp only [Nat.zero_add, hl', Tree.rolesCol, List.append_nil]
      rw [hih]
    have hEr : Tree.rolesF π (.node cols) =
        Tree.rolesCols π 0 (cols.take ci) ++ Role.ord ⟨π, ci⟩ ::
          (Tree.rolesCol π ci 0 (colc.take ei) ++ Role.slot ⟨⟨π, ci⟩, ei⟩ ::
            (Tree.rolesF (π ++ [(ci, ei)]) H ++ (Tree.rolesCol π ci (ei + 1) (colc.drop (ei + 1)) ++
              Tree.rolesCols π (ci + 1) (cols.drop (ci + 1))))) := by
      simp only [Tree.rolesF]
      conv_lhs => rw [h1]
      rw [rolesCols_append, hl]
      simp only [Tree.rolesCols]
      conv_lhs => rw [h3]
      rw [rolesCol_append]
      simp only [Nat.zero_add, hl', Tree.rolesCol, List.append_assoc, List.cons_append]
    rw [hKr, hEr]
    set A := Tree.rolesCols π 0 (cols.take ci)
    set B := Tree.rolesCol π ci 0 (colc.take ei)
    set R := Tree.rolesF (π ++ [(ci, ei)]) H
    refine ⟨(A ++ Role.ord ⟨π, ci⟩ :: (B ++ [Role.slot ⟨⟨π, ci⟩, ei⟩])).length + n', by
      simp only [List.length_append, List.length_cons, List.length_singleton, List.length_nil]; omega, ?_⟩
    have e1 : ∀ (X T : List Role), (X ++ (R ++ T)).take (X.length + n') = X ++ R.take n' := by
      intro X T
      rw [List.take_append, List.take_of_length_le (Nat.le_add_right _ _), Nat.add_sub_cancel_left,
        List.take_append_of_le_length hn']
    have e2 := e1 (A ++ Role.ord ⟨π, ci⟩ :: (B ++ [Role.slot ⟨⟨π, ci⟩, ei⟩]))
      (Tree.rolesCol π ci (ei + 1) (colc.drop (ei + 1)) ++ Tree.rolesCols π (ci + 1) (cols.drop (ci + 1)))
    simp only [List.append_assoc, List.cons_append, List.singleton_append, List.nil_append] at e2 ⊢
    rw [e2]
    simp

/-! ### reading order under a move -/

theorem mapRole_off (g : Nat → Nat) (m : Move) (x : Role)
    (h1 : ∀ e D, x.path ≠ m.col.path ++ (m.col.col, e) :: D) (h2 : ∀ e, x ≠ .slot ⟨m.col, e⟩) :
    m.mapRole g x = x := by
  cases x with
  | ord c => simp only [Move.mapRole]; rw [mapPath_off g m c.path h1]
  | slot e =>
    simp only [Move.mapRole]
    unfold Move.mapEntry; dsimp only
    rw [mapPath_off g m e.col.path h1, if_neg]
    intro h; apply h2 e.idx; rw [← h]

mutual
/-- helper: relabelling the entry index of one step of the path of every role of a height. -/
theorem rolesF_relabel (g : Nat → Nat) (m : Move) :
    ∀ (e : Nat) (R : List (Nat × Nat)) (h : Forest),
      (Tree.rolesF (m.col.path ++ (m.col.col, e) :: R) h).map (m.mapRole g) =
        Tree.rolesF (m.col.path ++ (m.col.col, g e) :: R) h
  | e, R, .node cols => by simp only [Tree.rolesF]; exact rolesCols_relabel g m e R 0 cols
theorem rolesCols_relabel (g : Nat → Nat) (m : Move) :
    ∀ (e : Nat) (R : List (Nat × Nat)) (c : Nat) (cols : List Column),
      (Tree.rolesCols (m.col.path ++ (m.col.col, e) :: R) c cols).map (m.mapRole g) =
        Tree.rolesCols (m.col.path ++ (m.col.col, g e) :: R) c cols
  | _, _, _, [] => by simp [Tree.rolesCols]
  | e, R, c, col :: rest => by
    simp only [Tree.rolesCols, List.map_cons, List.map_append]
    rw [rolesCol_relabel g m e R c 0 col, rolesCols_relabel g m e R (c + 1) rest]
    simp only [Move.mapRole, mapPath_through]
theorem rolesCol_relabel (g : Nat → Nat) (m : Move) :
    ∀ (e : Nat) (R : List (Nat × Nat)) (c i : Nat) (col : Column),
      (Tree.rolesCol (m.col.path ++ (m.col.col, e) :: R) c i col).map (m.mapRole g) =
        Tree.rolesCol (m.col.path ++ (m.col.col, g e) :: R) c i col
  | _, _, _, _, [] => by simp [Tree.rolesCol]
  | e, R, c, i, (x, h) :: rest => by
    simp only [Tree.rolesCol, List.map_cons, List.map_append]
    have h1 := rolesF_relabel g m e (R ++ [(c, i)]) h
    simp only [List.append_assoc, List.cons_append] at h1 ⊢
    rw [h1, rolesCol_relabel g m e R c (i + 1) rest]
    congr 1
    simp only [Move.mapRole]
    unfold Move.mapEntry; dsimp only
    rw [mapPath_through, if_neg]
    intro h'; have := congrArg (fun c : ColAddr => c.path.length) h'; simp at this
end

mutual
theorem rolesF_path : ∀ (π : List (Nat × Nat)) (h : Forest), ∀ x ∈ Tree.rolesF π h, π <+: x.path
  | π, .node cols => by
    intro x hx
    simp only [Tree.rolesF] at hx
    obtain ⟨c', -, -, h⟩ := rolesCols_path π 0 cols x hx
    rcases h with rfl | ⟨e, rfl | h⟩
    · exact List.prefix_refl _
    · exact List.prefix_refl _
    · exact (List.prefix_append _ _).trans h
theorem rolesCols_path : ∀ (π : List (Nat × Nat)) (c : Nat) (cols : List Column),
    ∀ x ∈ Tree.rolesCols π c cols, ∃ c', c ≤ c' ∧ c' < c + cols.length ∧
      (x = .ord ⟨π, c'⟩ ∨ ∃ e, x = .slot ⟨⟨π, c'⟩, e⟩ ∨ π ++ [(c', e)] <+: x.path)
  | _, _, [] => by simp [Tree.rolesCols]
  | π, c, col :: rest => by
    intro x hx
    simp only [Tree.rolesCols, List.mem_cons, List.mem_append] at hx
    rcases hx with rfl | hx | hx
    · exact ⟨c, le_rfl, by simp, Or.inl rfl⟩
    · obtain ⟨e, -, -, h⟩ := rolesCol_path π c 0 col x hx
      exact ⟨c, le_rfl, by simp, Or.inr ⟨e, h⟩⟩
    · obtain ⟨c', h1, h2, h⟩ := rolesCols_path π (c + 1) rest x hx
      exact ⟨c', by omega, by simp; omega, h⟩
theorem rolesCol_path : ∀ (π : List (Nat × Nat)) (c i : Nat) (col : Column),
    ∀ x ∈ Tree.rolesCol π c i col, ∃ e, i ≤ e ∧ e < i + col.length ∧
      (x = .slot ⟨⟨π, c⟩, e⟩ ∨ π ++ [(c, e)] <+: x.path)
  | _, _, _, [] => by simp [Tree.rolesCol]
  | π, c, i, (y, h) :: rest => by
    intro x hx
    simp only [Tree.rolesCol, List.mem_cons, List.mem_append] at hx
    rcases hx with rfl | hx | hx
    · exact ⟨i, le_rfl, by simp, Or.inl rfl⟩
    · exact ⟨i, le_rfl, by simp, Or.inr (rolesF_path _ h x hx)⟩
    · obtain ⟨e, h1, h2, h⟩ := rolesCol_path π c (i + 1) rest x hx
      exact ⟨e, by omega, by simp; omega, h⟩
end

theorem path_ne_of_div {π P D : List (Nat × Nat)} {x y : Nat × Nat} (hxy : x ≠ y) :
    ∀ D', π ++ x :: D ≠ π ++ y :: D' := by
  intro D' h; simp at h; exact hxy h.1

/-- helper: roles at the move level, in columns other than the move column, are fixed. -/
theorem off_base (g : Nat → Nat) (m : Move) (c0 : Nat) (cols : List Column)
    (hcc : ¬ (c0 ≤ m.col.col ∧ m.col.col < c0 + cols.length)) :
    ∀ x ∈ Tree.rolesCols m.col.path c0 cols, m.mapRole g x = x := by
  intro x hx
  obtain ⟨c', h1, h2, h⟩ := rolesCols_path _ _ _ x hx
  have hc' : c' ≠ m.col.col := fun h' => hcc ⟨h' ▸ h1, h' ▸ h2⟩
  apply mapRole_off
  · intro e D he
    rcases h with rfl | ⟨e', rfl | ⟨D', hD'⟩⟩
    · simp [Role.path] at he
    · simp [Role.path] at he
    · rw [he] at hD'; simp at hD'; exact hc' hD'.1.1
  · intro e he
    rcases h with rfl | ⟨e', rfl | ⟨D', hD'⟩⟩
    · simp at he
    · simp at he; exact hc' (congrArg ColAddr.col he.1)
    · rw [he] at hD'; simp [Role.path] at hD'

/-- helper: roles above the move level, off the move's path, are fixed. -/
theorem off_step_cols (g : Nat → Nat) (m : Move) {π P'' : List (Nat × Nat)} {a b : Nat}
    (hP : m.col.path = π ++ (a, b) :: P'') (c0 : Nat) (cols : List Column)
    (ha : ¬ (c0 ≤ a ∧ a < c0 + cols.length)) :
    ∀ x ∈ Tree.rolesCols π c0 cols, m.mapRole g x = x := by
  intro x hx
  obtain ⟨c', h1, h2, h⟩ := rolesCols_path _ _ _ x hx
  have hc' : c' ≠ a := fun h' => ha ⟨h' ▸ h1, h' ▸ h2⟩
  apply mapRole_off
  · intro e D he
    rw [hP] at he
    rcases h with rfl | ⟨e', rfl | ⟨D', hD'⟩⟩
    · simp [Role.path] at he
    · simp [Role.path] at he
    · rw [he] at hD'; simp at hD'; exact hc' hD'.1.1
  · intro e he
    have hl : x.path = m.col.path := by rw [he]; rfl
    rw [hP] at hl
    rcases h with rfl | ⟨e', rfl | ⟨D', hD'⟩⟩
    · simp [Role.path] at hl
    · simp [Role.path] at hl
    · rw [hl] at hD'; simp at hD'; exact hc' hD'.1.1

theorem off_step_col (g : Nat → Nat) (m : Move) {π P'' : List (Nat × Nat)} {a b : Nat}
    (hP : m.col.path = π ++ (a, b) :: P'') (i : Nat) (col : Column)
    (hb : ¬ (i ≤ b ∧ b < i + col.length)) :
    ∀ x ∈ Tree.rolesCol π a i col, m.mapRole g x = x := by
  intro x hx
  obtain ⟨e', h1, h2, h⟩ := rolesCol_path _ _ _ _ x hx
  have he' : e' ≠ b := fun h' => hb ⟨h' ▸ h1, h' ▸ h2⟩
  apply mapRole_off
  · intro e D he
    rw [hP] at he
    rcases h with rfl | ⟨D', hD'⟩
    · simp [Role.path] at he
    · rw [he] at hD'; simp at hD'; exact he' hD'.1
  · intro e he
    have hl : x.path = m.col.path := by rw [he]; rfl
    rw [hP] at hl
    rcases h with rfl | ⟨D', hD'⟩
    · simp [Role.path] at hl
    · rw [hl] at hD'; simp at hD'; exact he' hD'.1

theorem off_short (g : Nat → Nat) (m : Move) {x : Role} (h : x.path.length < m.col.path.length) :
    m.mapRole g x = x := by
  apply mapRole_off
  · intro e D he; rw [he] at h; simp at h
  · intro e he; rw [he] at h; simp [Role.path] at h

/-- helper: column-level relabelling of the move column's entries by a shift. -/
theorem rolesCol_shift (g : Nat → Nat) (m : Move) :
    ∀ (s : Nat) (l : Column), (∀ t, t < l.length → g (s + t) = g s + t) →
      (Tree.rolesCol m.col.path m.col.col s l).map (m.mapRole g) =
        Tree.rolesCol m.col.path m.col.col (g s) l
  | _, [], _ => by simp [Tree.rolesCol]
  | s, (y, h) :: rest, hg => by
    simp only [Tree.rolesCol, List.map_cons, List.map_append]
    have h1 := rolesF_relabel g m s [] h
    rw [h1]
    rw [rolesCol_shift g m (s + 1) rest (fun t ht => by
      rw [show s + 1 + t = s + (t + 1) by omega, hg (t + 1) (by simp; omega),
        hg 1 (by simp; omega)]; omega)]
    have key : Tree.rolesCol m.col.path m.col.col (g (s + 1)) rest =
        Tree.rolesCol m.col.path m.col.col (g s + 1) rest := by
      cases rest with
      | nil => simp [Tree.rolesCol]
      | cons _ _ => rw [hg 1 (by simp)]
    rw [key]
    congr 1
    simp only [Move.mapRole]
    unfold Move.mapEntry; dsimp only
    rw [mapPath_off _ _ _ (fun e D he => by have := congrArg List.length he; simp at this), if_pos rfl]

theorem map_eq_self_of {α : Type} {f : α → α} : ∀ {l : List α}, (∀ x ∈ l, f x = x) → l.map f = l
  | [], _ => rfl
  | x :: l, h => by
    simp only [List.map_cons]
    rw [h x (by simp), map_eq_self_of (fun y hy => h y (by simp [hy]))]

/-- helper: the roles of the moved tree, read backwards, are a sublist of the original roles. -/
theorem roles_mod_sublist (m : Move) {col : Column} (hij : m.i < m.j) (hj : m.j < col.length) :
    ∀ (P' π : List (Nat × Nat)) (F : Forest), π ++ P' = m.col.path → F.colAt ⟨P', m.col.col⟩ = some col →
      List.Sublist ((Tree.rolesF π (modifyColAux (moveFun m) P' m.col.col F)).map (m.mapRole m.bwdIdx))
        (Tree.rolesF π F)
  | [], π, .node cols, hπ, hcol => by
    simp only [List.append_nil] at hπ
    subst hπ
    rw [colAt_node_nil] at hcol
    have hcc : m.col.col < cols.length := (List.getElem?_eq_some_iff.1 hcol).1
    obtain ⟨h1, h2⟩ := modify_split hcol (moveFun m)
    have hl : (cols.take m.col.col).length = m.col.col := List.length_take_of_le hcc.le
    simp only [modifyColAux, Tree.rolesF]
    rw [h2]
    conv_rhs => rw [h1]
    rw [rolesCols_append, rolesCols_append, hl]
    simp only [Tree.rolesCols, List.map_append, List.map_cons]
    have hti : (col.take m.i).length = m.i := List.length_take_of_le (by omega)
    have hcolsplit : col = col.take m.i ++ ((col.take m.j).drop m.i ++ col.drop m.j) := by
      have : col.take m.i ++ (col.take m.j).drop m.i = col.take m.j := by
        conv_rhs => rw [← List.take_append_drop m.i (col.take m.j)]
        rw [List.take_take, Nat.min_eq_left hij.le]
      rw [← List.append_assoc, this, List.take_append_drop]
    have hmid : ((col.take m.j).drop m.i).length = m.j - m.i := by simp; omega
    conv_rhs => rw [hcolsplit]
    simp only [moveFun]
    rw [rolesCol_append, rolesCol_append, rolesCol_append, hti, hmid]
    simp only [Nat.zero_add]
    rw [show m.i + (m.j - m.i) = m.j by omega]
    rw [map_eq_self_of (off_base _ m 0 _ (by simp [hl])),
      map_eq_self_of (off_base _ m (m.col.col + 1) _ (by omega)),
      mapRole_off _ m (.ord m.col) (fun e D he => by have := congrArg List.length he; simp [Role.path] at this)
        (fun e he => by simp at he)]
    simp only [List.map_append]
    rw [rolesCol_shift _ m m.i (col.drop m.j) (fun t ht => by unfold Move.bwdIdx; split_ifs <;> omega)]
    have hb0 : (Tree.rolesCol m.col.path m.col.col 0 (col.take m.i)).map (m.mapRole m.bwdIdx) =
        Tree.rolesCol m.col.path m.col.col 0 (col.take m.i) := by
      rcases Nat.eq_zero_or_pos m.i with h0 | h0
      · rw [h0]; simp [Tree.rolesCol]
      · rw [rolesCol_shift _ m 0 _ (fun t ht => by
          simp at ht; unfold Move.bwdIdx; split_ifs <;> omega)]
        unfold Move.bwdIdx; rw [if_neg (by omega)]
    rw [hb0, show m.bwdIdx m.i = m.j by unfold Move.bwdIdx; rw [if_pos le_rfl]; omega]
    simp only [List.append_assoc, List.cons_append]
    exact List.Sublist.append_left (List.Sublist.cons_cons _ (List.Sublist.append_left
      (List.sublist_append_right _ _) _)) _
  | (a, b) :: P'', π, .node cols, hπ, hcol => by
    rw [colAt_node_cons] at hcol
    obtain ⟨x, hx, hcolx⟩ := Option.bind_eq_some_iff.1 hcol
    obtain ⟨colc, hc, hx'⟩ := Option.bind_eq_some_iff.1 hx
    obtain ⟨q, H⟩ := x
    have hP : m.col.path = π ++ (a, b) :: P'' := hπ.symm
    have hci : a < cols.length := (List.getElem?_eq_some_iff.1 hc).1
    have hei : b < colc.length := (List.getElem?_eq_some_iff.1 hx').1
    have ih := roles_mod_sublist m hij hj P'' (π ++ [(a, b)]) H (by rw [hP]; simp) hcolx
    obtain ⟨h1, h2⟩ := modify_split hc (fun col => col.modify b fun x => (x.1, modifyColAux (moveFun m) P'' m.col.col x.2))
    obtain ⟨h3, h4⟩ := modify_split hx' (fun x => (x.1, modifyColAux (moveFun m) P'' m.col.col x.2))
    have hl : (cols.take a).length = a := List.length_take_of_le hci.le
    have hl' : (colc.take b).length = b := List.length_take_of_le hei.le
    have hshort : π.length < m.col.path.length := by rw [hP]; simp
    simp only [modifyColAux, Tree.rolesF]
    rw [h2]
    conv_rhs => rw [h1]
    rw [rolesCols_append, rolesCols_append, hl]
    simp only [Tree.rolesCols, List.map_append, List.map_cons]
    rw [h4]
    conv_rhs => rw [h3]
    rw [rolesCol_append, rolesCol_append, hl']
    simp only [Tree.rolesCol, Nat.zero_add, List.map_append, List.map_cons]
    rw [map_eq_self_of (off_step_cols _ m hP 0 _ (by simp [hl])),
      map_eq_self_of (off_step_cols _ m hP (a + 1) _ (by omega)),
      map_eq_self_of (off_step_col _ m hP 0 _ (by simp [hl'])),
      map_eq_self_of (off_step_col _ m hP (b + 1) _ (by omega)),
      off_short _ m (x := .ord ⟨π, a⟩) (by simpa [Role.path] using hshort),
      off_short _ m (x := .slot ⟨⟨π, a⟩, b⟩) (by simpa [Role.path] using hshort)]
    simp only [List.append_assoc, List.cons_append]
    exact List.Sublist.append_left (List.Sublist.cons_cons _ (List.Sublist.append_left
      (List.Sublist.cons_cons _ (List.Sublist.append_right ih _)) _)) _

/-- helper: `x` occurs before `y` in `l`. -/
def ListBefore {α : Type} (l : List α) (x y : α) : Prop :=
  ∃ i j : Nat, l[i]? = some x ∧ l[j]? = some y ∧ i < j

theorem before_map {α β : Type} (f : α → β) {l : List α} {x y : α} (h : ListBefore l x y) :
    ListBefore (l.map f) (f x) (f y) := by
  obtain ⟨i, j, hi, hj, hij⟩ := h
  exact ⟨i, j, by simp [hi], by simp [hj], hij⟩

theorem before_sublist {α : Type} {l₁ l₂ : List α} (hs : List.Sublist l₁ l₂) :
    ∀ {x y : α}, ListBefore l₁ x y → ListBefore l₂ x y := by
  induction hs with
  | slnil => intro x y ⟨i, j, hi, _, _⟩; simp at hi
  | cons a _ ih =>
    intro x y h
    obtain ⟨i, j, hi, hj, hij⟩ := ih h
    exact ⟨i + 1, j + 1, by simpa using hi, by simpa using hj, by omega⟩
  | cons_cons a hsub ih =>
    intro x y ⟨i, j, hi, hj, hij⟩
    rcases i with _ | i
    · simp at hi; subst hi
      obtain ⟨j', hj'⟩ : ∃ j', j = j' + 1 := ⟨j - 1, by omega⟩
      subst hj'
      simp at hj
      obtain ⟨k, hk⟩ := List.mem_iff_getElem?.1 (hsub.subset (List.mem_of_getElem? hj))
      exact ⟨0, k + 1, rfl, by simpa using hk, by omega⟩
    · obtain ⟨j', hj'⟩ : ∃ j', j = j' + 1 := ⟨j - 1, by omega⟩
      subst hj'
      obtain ⟨i₂, j₂, h1, h2, h3⟩ := ih ⟨i, j', by simpa using hi, by simpa using hj, by omega⟩
      exact ⟨i₂ + 1, j₂ + 1, by simpa using h1, by simpa using h2, by omega⟩

theorem before_applyMove {K : Forest} {m : Move} (hm : MoveOK K m) {x y : Role}
    (h : ListBefore (applyMove K m).roles x y) :
    ListBefore K.roles (m.mapRole m.bwdIdx x) (m.mapRole m.bwdIdx y) := by
  obtain ⟨col, -, hcol, -, hj, hij, -⟩ := hm
  have hj' : m.j < col.length := by omega
  rw [applyMove_eq_mod hcol hij hj'] at h
  have hs := roles_mod_sublist m hij hj' m.col.path [] K (by simp) hcol
  exact before_sublist hs (before_map _ h)

theorem before_applyMoves {K : Forest} :
    ∀ ms : List Move, MovesValid K ms → ∀ {x y : Role}, ListBefore (applyMoves K ms).roles x y →
      ListBefore K.roles (backRole ms x) (backRole ms y) := by
  intro ms
  induction ms using List.reverseRecOn with
  | nil => intro _ x y h; exact h
  | append_singleton ms m ih =>
    intro hv x y h
    obtain ⟨hv, hm⟩ := movesValid_append hv
    rw [applyMoves_snoc] at h
    rw [backRole_append, backRole_append]
    exact ih hv (before_applyMove hm h)

/-- helper (D3.1d, reading-order clause of `origin_spec_full`). -/
theorem origin_order {E : Forest} (w : AdmCap E) :
    ∀ x y, (∃ i j : Nat, w.H.roles[i]? = some x ∧ w.H.roles[j]? = some y ∧ i < j) →
      (w.origin x).isSome → (w.origin y).isSome →
      ∃ i j : Nat, E.roles[i]? = some (Packet.anchorD E (some w) x) ∧
        E.roles[j]? = some (Packet.anchorD E (some w) y) ∧ i < j := by
  intro x y hxy hx hy
  have hb := before_applyMoves w.moves w.movesValid hxy
  have hxo : ∀ z, (w.origin z).isSome → Packet.anchorD E (some w) z = backRole w.moves z ∧
      backRole w.moves z ≠ .slot ⟨w.col, w.cut⟩ := by
    intro z hz
    rw [originBody_eq] at hz
    split_ifs at hz with h
    · simp at hz
    · refine ⟨?_, h⟩
      simp only [Packet.anchorD, anchorOrigin, originBody_eq, if_neg h, Option.getD_some]
  obtain ⟨hax, hnx⟩ := hxo x hx
  obtain ⟨hay, hny⟩ := hxo y hy
  rw [hax, hay]
  obtain ⟨col, hcol, hk, -⟩ := isUpward_iff_exists.1 w.upward
  obtain ⟨n, hn, hroles⟩ := roles_litCapAux w.cut w.par w.col.path w.col.col E col [] hcol hk
  have hK : (litCap E w.col w.cut w.par).roles = E.roles.take n ++ [.slot ⟨w.col, w.cut⟩] := by
    show Tree.rolesF [] _ = _
    rw [litCap_eq_aux hcol, hroles]; rfl
  obtain ⟨i, j, hi, hj, hij⟩ := hb
  rw [hK] at hi hj
  have hln : (E.roles.take n).length = n := List.length_take_of_le hn
  have hjn : j < n := by
    by_contra hc
    rw [List.getElem?_append_right (by omega), hln] at hj
    rcases Nat.lt_or_ge (j - n) 1 with h | h
    · rw [show j - n = 0 by omega] at hj; simp at hj; exact hny hj.symm
    · rw [List.getElem?_eq_none (by simp; omega)] at hj; simp at hj
  rw [List.getElem?_append_left (by omega), List.getElem?_take_of_lt (by omega)] at hi
  rw [List.getElem?_append_left (by omega), List.getElem?_take_of_lt hjn] at hj
  exact ⟨i, j, hi, hj, hij⟩

-- provides: U2, D3.1d (requested by U3 R10; refines `origin_spec`†): χ is injective on the
-- roles of `w.H`, `none` exactly on the closing slot, valued in `E`, sends ordinary roles to
-- ordinary roles of the same printed number, keeps labels and hosts of slots, commutes with
-- representatives, and preserves reading order.
theorem origin_spec_full {E : Forest} (hE : InL E) (w : AdmCap E) :
    Set.InjOn w.origin {x | x ∈ w.H.roles} ∧
    (∀ x ∈ w.H.roles, w.origin x = none ↔ ∃ sd, stopData w.H = some sd ∧
      x = .slot (closingSlot sd)) ∧
    (∀ x ∈ w.H.roles, ∀ y, w.origin x = some y → y ∈ E.roles) ∧
    (∀ c, Role.ord c ∈ w.H.roles → (∃ c', w.origin (.ord c) = some (.ord c')) ∨ w.origin (.ord c) = none) ∧
    (∀ c c', Role.ord c ∈ w.H.roles → w.origin (.ord c) = some (.ord c') → c'.num 0 = c.num 0) ∧
    (∀ e e', Role.slot e ∈ w.H.roles → w.origin (.slot e) = some (.slot e') →
      (w.H.entryAt e).map Prod.fst = (E.entryAt e').map Prod.fst ∧
      w.origin (.ord e.col) = some (.ord e'.col)) ∧
    (∀ c c', Role.ord c ∈ w.H.roles → w.origin (.ord c) = some (.ord c') → ∀ q, q < c.num 0 →
      (c.rep 0 q).map (fun ov => (Packet.anchorD E (some w) ov.1, Packet.anchorD E (some w) ov.2)) =
        c'.rep 0 q) ∧
    (∀ x y, (∃ i j : Nat, w.H.roles[i]? = some x ∧ w.H.roles[j]? = some y ∧ i < j) →
      (w.origin x).isSome → (w.origin y).isSome →
      ∃ i j : Nat, E.roles[i]? = some (Packet.anchorD E (some w) x) ∧
        E.roles[j]? = some (Packet.anchorD E (some w) y) ∧ i < j) := by
  obtain ⟨hinj, hnone, -, hval⟩ := origin_spec w
  refine ⟨fun x hx y hy hxy => ?_, hnone, hval, fun c _ => ?_, fun c c' _ h => ?_,
    fun e e' he h => ?_, origin_reps w, origin_order w⟩
  · cases h : w.origin x with
    | none =>
      have hy' : w.origin y = none := by rw [← hxy, h]
      obtain ⟨sd, hsd, rfl⟩ := (hnone x hx).1 h
      obtain ⟨sd', hsd', rfl⟩ := (hnone y hy).1 hy'
      rw [hsd] at hsd'; obtain rfl := Option.some.inj hsd'; rfl
    | some z => exact hinj x hx y hy z h (by rw [← hxy, h])
  · obtain ⟨c', h1, -⟩ := origin_ord w c; exact Or.inl ⟨c', h1⟩
  · obtain ⟨c'', h1, h2⟩ := origin_ord w c
    rw [h1] at h; obtain rfl := Role.ord.inj (Option.some.inj h); exact h2
  · obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 ((Tree.mem_roles_iff _ _).1 he)
    have hx' : (applyMoves (litCap E w.col w.cut w.par) w.moves).entryAt e = some x := hx
    obtain ⟨e₀, h1, h2, h3⟩ := adm_entries w.moves w.movesValid e (by rw [hx']; rfl)
    rw [originBody_eq, h1] at h
    split_ifs at h with hne
    obtain rfl := Role.slot.inj (Option.some.inj h)
    refine ⟨?_, by rw [originBody_eq, h2, if_neg (by simp)]⟩
    show ((applyMoves (litCap E w.col w.cut w.par) w.moves).entryAt e).map Prod.fst = _
    rw [h3]
    obtain ⟨col, hcol, hk, -⟩ := isUpward_iff_exists.1 w.upward
    obtain ⟨y, hy⟩ : ∃ y, (litCap E w.col w.cut w.par).entryAt e₀ = some y := by
      cases h4 : (litCap E w.col w.cut w.par).entryAt e₀ with
      | none => rw [h4] at h3; rw [hx'] at h3; simp at h3
      | some y => exact ⟨y, rfl⟩
    rw [hy]
    rcases entryAt_litCap_cases hcol hk hy with h' | ⟨ρ, hρ⟩ | h'
    · exact absurd (by rw [h']) hne
    · obtain ⟨q, J, hE⟩ := heightAt_of_prefix hcol ⟨ρ, hρ⟩
      rw [entryAt_litCap_container hcol hρ hE] at hy
      rw [← hy, hE]; rfl
    · rw [h']

/-! ### D3.1d helpers: the stopping column of an admissible cap -/

-- provides: U2, D3.1d (requested by U3 R15): the query of an admissible cap is the cut prefix of
-- `E`'s column, with origins at the same indices.
theorem admCap_query {E : Forest} (hE : InL E) (w : AdmCap E) {sd : StopData}
    (hsd : stopData w.H = some sd) :
    sd.t = w.col.num 0 ∧ sd.r = w.par ∧ sd.Q.length = w.cut ∧
    w.origin (.ord sd.col) = some (.ord w.col) ∧
    ∀ j < w.cut, w.origin (.slot ⟨sd.col, j⟩) = some (.slot ⟨w.col, j⟩) ∧
      (sd.Q[j]?) = ((E.colAt w.col).getD [])[j]? := by
  obtain ⟨col, hcol, hk, -⟩ := isUpward_iff_exists.1 w.upward
  obtain ⟨c', hsd', hord, hslot⟩ := adm_stop (k := w.cut) (p := w.par) hcol w.moves w.movesValid
  have : sd = _ := Option.some.inj (hsd.symm.trans hsd')
  subst this
  refine ⟨rfl, rfl, List.length_take_of_le hk, ?_, fun j hj => ⟨?_, ?_⟩⟩
  · rw [originBody_eq]; simp only; rw [hord, if_neg (by simp)]
  · rw [originBody_eq]; simp only; rw [hslot j, if_neg (by simp; omega)]
  · simp only; rw [hcol, Option.getD_some, List.getElem?_take_of_lt hj]


theorem mem_takeWhile_ne_of_lt {α : Type} [DecidableEq α] :
    ∀ (l : List α) {z y : α} {i j : Nat}, l.Nodup → l[j]? = some z → i < j → l[i]? = some y →
      y ∈ l.takeWhile (· != z)
  | [], _, _, _, _, _, h, _, _ => by simp at h
  | a :: l, z, y, i, j, hnd, hj, hij, hi => by
    rcases j with _ | j
    · omega
    have haz : a ≠ z := by
      intro h; subst h
      have := List.mem_of_getElem? (show l[j]? = some a by simpa using hj)
      exact (List.nodup_cons.1 hnd).1 this
    rw [List.takeWhile_cons, if_pos (by simp [haz])]
    rcases i with _ | i
    · simp at hi; subst hi; simp
    · exact List.mem_cons_of_mem _ (mem_takeWhile_ne_of_lt l (i := i) (j := j) (List.nodup_cons.1 hnd).2
        (by simpa using hj) (by omega) (by simpa using hi))

theorem lt_of_mem_takeWhile_ne {α : Type} [DecidableEq α] :
    ∀ (l : List α) {z x : α}, x ∈ l.takeWhile (· != z) → z ∈ l →
      ∃ i j : Nat, l[i]? = some x ∧ l[j]? = some z ∧ i < j
  | [], _, _, h, _ => by simp at h
  | a :: l, z, x, hx, hz => by
    by_cases haz : a = z
    · subst haz; simp at hx
    · rw [List.takeWhile_cons, if_pos (by simp [haz])] at hx
      have hz' : z ∈ l := by
        rcases List.mem_cons.1 hz with h | h
        · exact absurd h.symm haz
        · exact h
      rcases List.mem_cons.1 hx with rfl | hx
      · obtain ⟨j, hj⟩ := List.mem_iff_getElem?.1 hz'
        exact ⟨0, j + 1, rfl, by simpa using hj, by omega⟩
      · obtain ⟨i, j, h1, h2, h3⟩ := lt_of_mem_takeWhile_ne l hx hz'
        exact ⟨i + 1, j + 1, by simpa using h1, by simpa using h2, by omega⟩

-- provides: U2, D3.1d (requested by U5 R16): the origin of the stopping role exists, the origin map
-- is injective, and every pre-stop role of the anchor has an origin strictly before the origin of
-- the stopping role.
theorem anchorOrigin_prefix {E : Forest} {cap : Option (AdmCap E)} (hE : InL (anchor E cap))
    {sd : StopData}
    (hsd : stopData (anchor E cap) = some sd) :
    ∃ T', anchorOrigin E cap (.ord sd.col) = some T' ∧
    (∀ x x' y, anchorOrigin E cap x = some y → anchorOrigin E cap x' = some y → x = x') ∧
    ∀ x ∈ Packet.rolesBefore (anchor E cap) (.ord sd.col),
      ∃ y, anchorOrigin E cap x = some y ∧ y ∈ Packet.rolesBefore E T' ∧ y ∈ E.roles := by
  cases cap with
  | none =>
    refine ⟨.ord sd.col, rfl, fun x x' y h1 h2 => ?_, fun x hx => ⟨x, rfl, hx, ?_⟩⟩
    · simp only [anchorOrigin] at h1 h2; exact (Option.some.inj h1).trans (Option.some.inj h2).symm
    · exact (List.takeWhile_sublist _).subset hx
  | some w =>
    simp only [anchor] at hsd ⊢
    obtain ⟨col, hcol, hk, -⟩ := isUpward_iff_exists.1 w.upward
    obtain ⟨c', hsd', hord, hslot⟩ := adm_stop (k := w.cut) (p := w.par) hcol w.moves w.movesValid
    have : sd = _ := Option.some.inj (hsd.symm.trans hsd')
    subst this
    have hosd : w.origin (.ord c') = some (.ord w.col) := by
      rw [originBody_eq, hord, if_neg (by simp)]
    refine ⟨.ord w.col, hosd, fun x x' y h1 h2 => ?_, fun x hx => ?_⟩
    · simp only [anchorOrigin, originBody_eq] at h1 h2
      split_ifs at h1 h2
      exact backRole_injective _ ((Option.some.inj h1).trans (Option.some.inj h2).symm)
    · simp only [anchorOrigin]
      -- `x` precedes the stopping column, hence is not the closing slot
      have hmem : Role.ord c' ∈ w.H.roles := by
        have := stopData_col_mem hsd; exact this
      obtain ⟨i, j, hi, hj, hij⟩ := lt_of_mem_takeWhile_ne _ hx hmem
      have hxm : x ∈ w.H.roles := List.mem_of_getElem? hi
      obtain ⟨-, -, -, -, -, qs, hqs, -⟩ := stopData_roles hsd
      have hnd := Tree.roles_nodup w.H
      let sd0 : StopData := ⟨w.col.path.length, c', ColAddr.num 0 w.col, w.par, List.take w.cut col⟩
      have hxc : x ≠ .slot (closingSlot sd0) := by
        rintro rfl
        rw [hqs] at hnd
        have h1 : Role.slot (closingSlot sd0) ∈ Packet.rolesBefore w.H (.ord c') := hx
        have h2 := List.nodup_append.1 hnd
        exact h2.2.2 _ h1 _ (List.mem_cons_of_mem _ (List.mem_append_right _ (List.mem_singleton_self _))) rfl
      obtain ⟨-, hnone, -, -⟩ := origin_spec w
      have hxs : (w.origin x).isSome := by
        cases h : w.origin x with
        | some _ => rfl
        | none =>
          obtain ⟨sd2, hsd2, rfl⟩ := (hnone x hxm).1 h
          rw [hsd] at hsd2; obtain rfl := Option.some.inj hsd2
          exact absurd rfl hxc
      obtain ⟨y, hy⟩ := Option.isSome_iff_exists.1 hxs
      obtain ⟨i', j', hi', hj', hij'⟩ := origin_order w x (.ord c') ⟨i, j, hi, hj, hij⟩ hxs
        (by rw [hosd]; rfl)
      simp only [Packet.anchorD, anchorOrigin, hy, hosd, Option.getD_some] at hi' hj'
      exact ⟨y, hy, mem_takeWhile_ne_of_lt _ (Tree.roles_nodup E) hj' hij' hi',
        List.mem_of_getElem? hi'⟩


/-! ### D3.1d helpers: legal moves raise the expression -/

theorem cmpCols_append_same {α : Type} (c : α → α → Ordering) [Std.ReflCmp c] :
    ∀ (P A B : List (List (α × Tree α))), Tree.cmpCols c (P ++ A) (P ++ B) = Tree.cmpCols c A B
  | [], A, B => rfl
  | x :: P, A, B => by
    simp only [List.cons_append, Tree.cmpCols, Tree.cmpCol_self, Ordering.eq_then]
    exact cmpCols_append_same c P A B

/-- helper: a legal move strictly raises the expression. -/
theorem cmp_modifyColAux_lt (f : Column → Column) (cc : Nat) :
    ∀ (P : List (Nat × Nat)) (K : Forest) (col : Column), K.colAt ⟨P, cc⟩ = some col →
      Tree.cmpCol compare col (f col) = .lt →
      Tree.cmp compare K (modifyColAux f P cc K) = .lt
  | [], .node cols, col, hcol, hlt => by
    rw [colAt_node_nil] at hcol
    obtain ⟨h1, h2⟩ := modify_split hcol f
    simp only [modifyColAux, Tree.cmp]
    rw [h2]
    generalize cols.take cc = T at h1 ⊢
    generalize cols.drop (cc + 1) = D at h1 ⊢
    subst h1
    rw [cmpCols_append_same, Tree.cmpCols, hlt]; rfl
  | (a, b) :: P, .node cols, col, hcol, hlt => by
    rw [colAt_node_cons] at hcol
    obtain ⟨x, hx, hcolx⟩ := Option.bind_eq_some_iff.1 hcol
    obtain ⟨colc, hc, hx'⟩ := Option.bind_eq_some_iff.1 hx
    obtain ⟨q, H⟩ := x
    have ih := cmp_modifyColAux_lt f cc P H col hcolx hlt
    simp only [modifyColAux, Tree.cmp]
    obtain ⟨h1, h2⟩ := modify_split hc
      (fun col => col.modify b fun x => (x.1, modifyColAux f P cc x.2))
    rw [h2]
    generalize cols.take a = T at h1 ⊢
    generalize cols.drop (a + 1) = D at h1 ⊢
    subst h1
    rw [cmpCols_append_same, Tree.cmpCols]
    obtain ⟨h3, h4⟩ := modify_split hx' (fun x => (x.1, modifyColAux f P cc x.2))
    rw [h4]
    generalize colc.take b = T' at h3 ⊢
    generalize colc.drop (b + 1) = D' at h3 ⊢
    subst h3
    rw [cmpCol_append_same, Tree.cmpCol]
    simp only [Std.ReflCmp.compare_self, Ordering.eq_then]
    rw [show Tree.cmp compare H (modifyColAux f P cc H) = .lt from ih]; rfl

theorem lt_applyMove {K : Forest} {m : Move} (hm : MoveOK K m) : K < applyMove K m := by
  obtain ⟨col, sd, hcol, -, hj, hij, -, hpar, hlt, -⟩ := hm
  have hj' : m.j < col.length := by omega
  rw [applyMove_eq_mod hcol hij hj', Forest.lt_iff_cmp]
  apply cmp_modifyColAux_lt _ _ _ _ col hcol
  -- compare the column with its moved version at index `i`
  have hi : col[m.i]? = some (col.getD m.i (0, Tree.empty)) := by
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (by omega)]; rfl
  have hjx : col[m.j]? = some (col.getD m.j (0, Tree.empty)) := by
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (by omega)]; rfl
  have hc1 : col = col.take m.i ++ col.getD m.i (0, Tree.empty) :: col.drop (m.i + 1) :=
    (modify_split hi id).1
  have hc2 : moveFun m col = col.take m.i ++ col.getD m.j (0, Tree.empty) :: col.drop (m.j + 1) := by
    simp only [moveFun]
    rw [List.drop_eq_getElem_cons hj', (List.getElem?_eq_some_iff.1 hjx).2]
  rw [hc2]
  have hp := hpar m.i le_rfl hij.le
  generalize col.getD m.i (0, Tree.empty) = x1 at hc1 hp hlt
  generalize col.getD m.j (0, Tree.empty) = x2 at hp hlt ⊢
  generalize col.take m.i = T at hc1 ⊢
  generalize col.drop (m.j + 1) = D
  generalize col.drop (m.i + 1) = D0 at hc1
  subst hc1
  rw [cmpCol_append_same]
  obtain ⟨p1, H1⟩ := x1
  obtain ⟨p2, H2⟩ := x2
  simp only at hp hlt
  subst hp
  simp only [Tree.cmpCol, Std.ReflCmp.compare_self, Ordering.eq_then]
  rw [show Tree.cmp compare H1 H2 = .lt from hlt]; rfl

theorem le_applyMoves {K : Forest} : ∀ {ms : List Move}, MovesValid K ms → K ≤ applyMoves K ms := by
  intro ms
  induction ms using List.reverseRecOn with
  | nil => intro _; exact le_rfl
  | append_singleton ms m ih =>
    intro h
    obtain ⟨hv, hm⟩ := movesValid_append h
    rw [applyMoves_snoc]
    exact le_trans (ih hv) (le_of_lt (lt_applyMove hm))

-- provides: U2, D3.1d (requested by U5 R17): an admissible upward cap lies strictly above `E`.
theorem lt_admCap {E : Forest} (w : AdmCap E) : E < w.H :=
  lt_of_lt_of_le (lt_litCap w.upward) (le_applyMoves w.movesValid)


-- provides: U2, D3.1e (requested by U3 R11): roles and stopping data of a literal cap.
theorem litCap_spec {E : Forest} {c : ColAddr} {k p : Nat} (hc : c ∈ E.colAddrs)
    (hk : k ≤ (parents E c).length) :
    let K := litCap E c k p
    (∃ m, K.roles = E.roles.take m ++ [.slot ⟨c, k⟩]) ∧
    (∀ e ∈ K.entryAddrs, e ≠ ⟨c, k⟩ → (K.entryAt e).map Prod.fst = (E.entryAt e).map Prod.fst) ∧
    (∀ e ∈ K.entryAddrs, e ≠ ⟨c, k⟩ → ¬ e.heightPath <+: c.path → K.entryAt e = E.entryAt e) ∧
    K.entryAt ⟨c, k⟩ = some (p, Tree.empty) ∧
    (c.path ≠ [] → CondI E → CondV K →
      ∃ sd, stopData K = some sd ∧ sd.col = c ∧ sd.r = p ∧
        sd.Q = ((E.colAt c).getD []).take k) := by
  obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff E c).1 hc)
  have hk' : k ≤ col.length := by simpa [parents, hcol] using hk
  intro K
  refine ⟨?_, ?_, ?_, entryAt_litCap_closing hcol hk' p, ?_⟩
  · obtain ⟨n, -, h⟩ := roles_litCapAux k p c.path c.col E col [] hcol hk'
    refine ⟨n, ?_⟩
    show Tree.rolesF [] (litCap E c k p) = _
    rw [litCap_eq_aux hcol, h]; rfl
  · intro e he hne
    obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 ((Tree.mem_entryAddrs_iff _ _).1 he)
    rcases entryAt_litCap_cases hcol hk' hx with h | ⟨ρ, hρ⟩ | h
    · exact absurd h hne
    · obtain ⟨q, J, hE⟩ := heightAt_of_prefix hcol ⟨ρ, hρ⟩
      show ((litCap E c k p).entryAt e).map Prod.fst = _
      rw [entryAt_litCap_container hcol hρ hE, hE]; rfl
    · show ((litCap E c k p).entryAt e).map Prod.fst = _
      rw [hx, h]
  · intro e he hne hnc
    obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 ((Tree.mem_entryAddrs_iff _ _).1 he)
    rcases entryAt_litCap_cases hcol hk' hx with h | h | h
    · exact absurd h hne
    · exact absurd h hnc
    · show (litCap E c k p).entryAt e = _
      rw [hx, h]
  · intro _ _ _
    refine ⟨_, stopData_litCap' hcol k p, rfl, rfl, by rw [hcol]; rfl⟩


/-- D3.1e (G-016 / BP-04): every move avoids the marked height at its *current* address
(after the earlier moves have relocated it). -/
def MovesOutside (ms : List Move) (b : EntryAddr) : Prop :=
  ∀ idx (h : idx < ms.length), ¬ (moveAddr (ms.take idx) b).heightPath <+: (ms[idx]).col.path

-- provides: U2, D3.1e (requested by U3 R13): every move of an admissible cap is legal for the
-- expression produced by the moves before it (`MoveOK` unfolded).
theorem moves_violate {E : Forest} (w : AdmCap E) :
    ∀ idx (hidx : idx < w.moves.length),
      ∃ (col : List (Nat × Forest)) (sd : StopData) (q : Nat) (Hi C : Forest),
        (applyMoves (litCap E w.col w.cut w.par) (w.moves.take idx)).colAt
          w.moves[idx].col = some col ∧
        stopData (applyMoves (litCap E w.col w.cut w.par) (w.moves.take idx)) = some sd ∧
        w.moves[idx].j + 1 = col.length ∧ w.moves[idx].i < w.moves[idx].j ∧
        (⟨w.moves[idx].col, w.moves[idx].j⟩ : EntryAddr).heightPath <+: sd.col.path ∧
        col[w.moves[idx].i]? = some (q, Hi) ∧ col[w.moves[idx].j]? = some (q, C) ∧
        (∀ x, w.moves[idx].i ≤ x → x ≤ w.moves[idx].j → (col[x]?).map Prod.fst = some q) ∧
        Hi < C := by
  intro idx hidx
  obtain ⟨col, sd, hcol, hsd, hj, hij, hpre, hpar, hlt, -⟩ := w.movesValid idx hidx
  refine ⟨col, sd, (col.getD w.moves[idx].j (0, Tree.empty)).1,
    (col.getD w.moves[idx].i (0, Tree.empty)).2, (col.getD w.moves[idx].j (0, Tree.empty)).2,
    hcol, hsd, hj, hij, hpre, ?_, ?_, ?_, hlt⟩
  · have := hpar w.moves[idx].i le_rfl hij.le
    rw [List.getElem?_eq_getElem (by omega), ← this]
    simp [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (show w.moves[idx].i < col.length by omega)]
  · rw [List.getElem?_eq_getElem (by omega)]
    simp [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (show w.moves[idx].j < col.length by omega)]
  · intro x h1 h2
    have := hpar x h1 h2
    rw [List.getElem?_eq_getElem (by omega)]
    simp only [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (show x < col.length by omega),
      List.getElem?_eq_getElem (show w.moves[idx].j < col.length by omega), Option.getD_some] at this
    simp [this, List.getElem?_eq_getElem (show w.moves[idx].j < col.length by omega)]


theorem moveAddr_snoc (ms : List Move) (m : Move) (b : EntryAddr) :
    moveAddr (ms ++ [m]) b = m.mapEntry m.fwdIdx (moveAddr ms b) := by
  simp [moveAddr, moveAddrBody, List.foldl_append]

theorem fwdIdx_j (m : Move) (hij : m.i < m.j) : m.fwdIdx m.j = m.i := by
  unfold Move.fwdIdx; rw [if_pos le_rfl]; omega

theorem heightPath_mapEntry (g : Nat → Nat) (m : Move) (e : EntryAddr) :
    (m.mapEntry g e).heightPath = m.mapPath g e.heightPath := by
  by_cases h : e.col.path = m.col.path ∧ e.col.col = m.col.col
  · have hc : e.col = m.col := by
      rcases e with ⟨⟨_, _⟩, _⟩; rcases m with ⟨⟨_, _⟩, _, _⟩; simp only at h ⊢; rw [h.1, h.2]
    have hme : m.mapEntry g e = ⟨m.col, g e.idx⟩ := by
      unfold Move.mapEntry; dsimp only
      rw [h.1, mapPath_off _ _ _ (fun e D he => by have := congrArg List.length he; simp at this)]
      rw [if_pos (by rw [h.2]), ← hc]
    rw [hme]
    simp only [EntryAddr.heightPath]
    rw [hc]
    have := mapPath_through g m e.idx []
    rw [this]
  · have hme : (m.mapEntry g e).col = ⟨m.mapPath g e.col.path, e.col.col⟩ := mapEntry_col g m e
    have hidx : (m.mapEntry g e).idx = e.idx := by
      unfold Move.mapEntry; dsimp only
      split_ifs with h'
      · exfalso; apply h
        have := congrArg ColAddr.path h'; have h2 := congrArg ColAddr.col h'
        simp only at this h2
        exact ⟨(mapPath_eq_colPath_iff g m _).1 this, h2⟩
      · rfl
    simp only [EntryAddr.heightPath, hme, hidx]
    exact (mapPath_snoc g m _ _ h).symm

-- provides: U2, D3.1e (requested by U3 R18): address form of L3.1h — each prefix of the repair
-- is the literal cap of `E` at the relocated column.
theorem applyMoves_litCap_addr {E : Forest} (hH : CondH E) (w : AdmCap E)
    {b : EntryAddr} (hb : b.heightPath <+: w.col.path) (hout : MovesOutside w.moves b) :
    ∀ q, q ≤ w.moves.length →
      IsUpward E ⟨(moveAddr (w.moves.take q) b).heightPath ++
          w.col.path.drop b.heightPath.length, w.col.col⟩ w.cut w.par ∧
      applyMoves (litCap E w.col w.cut w.par) (w.moves.take q) =
        litCap E ⟨(moveAddr (w.moves.take q) b).heightPath ++
          w.col.path.drop b.heightPath.length, w.col.col⟩ w.cut w.par ∧
      ((E.colAt ⟨(moveAddr (w.moves.take q) b).heightPath ++
          w.col.path.drop b.heightPath.length, w.col.col⟩).getD []).take w.cut =
        ((E.colAt w.col).getD []).take w.cut := by
  intro q
  induction q with
  | zero =>
    intro _
    have hc : (⟨(moveAddr (w.moves.take 0) b).heightPath ++ w.col.path.drop b.heightPath.length,
        w.col.col⟩ : ColAddr) = w.col := by
      simp only [List.take_zero]
      show (⟨b.heightPath ++ w.col.path.drop b.heightPath.length, w.col.col⟩ : ColAddr) = w.col
      obtain ⟨S, hS⟩ := hb
      rw [show w.col.path.drop b.heightPath.length = S by rw [← hS]; simp, hS]
    rw [hc]
    exact ⟨w.upward, rfl, rfl⟩
  | succ q ih =>
    intro hq
    obtain ⟨hup, heq, htk⟩ := ih (by omega)
    set bq := moveAddr (w.moves.take q) b with hbq
    set S := w.col.path.drop b.heightPath.length
    set m := w.moves[q]
    have hm : MoveOK (litCap E ⟨bq.heightPath ++ S, w.col.col⟩ w.cut w.par) m := by
      have := w.movesValid q (by omega)
      rw [heq] at this; exact this
    obtain ⟨rest, hrest, hup', hmove, htk'⟩ := litCap_move_step hH hup hm
    have htake : w.moves.take (q + 1) = w.moves.take q ++ [m] := (List.take_concat_get' _ _ _).symm
    -- the move lies at `bq` or at one of its containers
    have hno := hout q (by omega)
    simp only at hrest
    obtain ⟨T, hT⟩ : ∃ T, bq.heightPath = m.col.path ++ (m.col.col, m.j) :: T := by
      have h1 : bq.heightPath <+: m.col.path ++ (m.col.col, m.j) :: rest := ⟨S, hrest⟩
      have h2 : m.col.path ++ [(m.col.col, m.j)] <+: m.col.path ++ (m.col.col, m.j) :: rest :=
        ⟨rest, by simp⟩
      rcases List.prefix_or_prefix_of_prefix h1 h2 with h | h
      · obtain ⟨U, hU⟩ := h
        rcases List.eq_nil_or_concat' U with rfl | ⟨U', u, rfl⟩
        · exact ⟨[], by simpa using hU⟩
        · exfalso; apply hno
          rw [← List.append_assoc] at hU
          obtain ⟨hU1, -⟩ := List.append_inj' hU rfl
          exact ⟨U', hU1⟩
      · obtain ⟨T, hTT⟩ := h; exact ⟨T, by rw [← hTT]; simp⟩
    have hrestT : rest = T ++ S := by
      rw [hT] at hrest; simpa using hrest.symm
    have hij : m.i < m.j := by obtain ⟨_, _, _, _, _, hij, _⟩ := hm; exact hij
    have hb1 : (moveAddr (w.moves.take (q + 1)) b).heightPath =
        m.col.path ++ (m.col.col, m.i) :: T := by
      rw [htake, moveAddr_snoc, heightPath_mapEntry, ← hbq, hT, mapPath_through, fwdIdx_j m hij]
    have hc1 : (⟨(moveAddr (w.moves.take (q + 1)) b).heightPath ++ S, w.col.col⟩ : ColAddr) =
        ⟨m.col.path ++ (m.col.col, m.i) :: rest, w.col.col⟩ := by
      rw [hb1, hrestT]; simp
    rw [hc1, htake, applyMoves_snoc, heq]
    exact ⟨hup', hmove, htk'.trans htk⟩


theorem num_mapPath (g : Nat → Nat) (m : Move) (π : List (Nat × Nat)) (c b : Nat) :
    ColAddr.num b ⟨m.mapPath g π, c⟩ = ColAddr.num b ⟨π, c⟩ := by
  simp only [ColAddr.num]
  have := congrArg (fun l => (l.map (· + 1)).sum) (mapPath_fst g m π)
  simp only [List.map_map] at this
  rw [show (fun x : Nat × Nat => x.1 + 1) = ((· + 1) ∘ Prod.fst) from rfl, this]

theorem mapEntry_num (g : Nat → Nat) (m : Move) (b : EntryAddr) :
    (m.mapEntry g b).col.num 0 = b.col.num 0 := by
  rw [mapEntry_col]
  exact num_mapPath g m b.col.path b.col.col 0

-- provides: U2, D3.1e (requested by U3 R19(a)): a move rewrites only entry indices.
theorem moveAddr_num (ms : List Move) (b : EntryAddr) :
    (moveAddr ms b).col.num 0 = b.col.num 0 := by
  induction ms generalizing b with
  | nil => rfl
  | cons m ms ih =>
    show (moveAddrBody ms (m.mapEntry m.fwdIdx b)).col.num 0 = b.col.num 0
    rw [← moveAddr_eq_body, ih, mapEntry_num]


theorem repairList_append {K : Forest} {b : EntryAddr} {ms : List Move} {m : Move}
    (h : RepairList K b (ms ++ [m])) :
    RepairList K b ms ∧ RepairStepOK (applyMoves K ms) (moveAddr ms b) m := by
  refine ⟨fun idx hidx => ?_, ?_⟩
  · have := h idx (by simp; omega)
    rw [List.take_append_of_le_length hidx.le, List.getElem_append_left hidx] at this
    exact this
  · have := h ms.length (by simp)
    rw [List.take_left, List.getElem_append_right (by omega)] at this
    simpa using this

theorem heightAt_repairStep {K : Forest} {b : EntryAddr} {m : Move} (h : RepairStepOK K b m) :
    (applyMove K m).heightAt (m.mapEntry m.fwdIdx b) = K.heightAt b := by
  obtain ⟨col, hcol, hij, hj, -, -, hb⟩ := h
  rw [← Tree.forestAt_heightPath, ← Tree.forestAt_heightPath]
  rcases hb with rfl | ⟨R, hR⟩
  · have hme : m.mapEntry m.fwdIdx ⟨m.col, m.j⟩ = ⟨m.col, m.i⟩ := by
      unfold Move.mapEntry; dsimp only
      rw [mapPath_off _ _ _ (fun e D he => by have := congrArg List.length he; simp at this), if_pos rfl,
        fwdIdx_j m hij]
    rw [hme]
    simp only [EntryAddr.heightPath]
    exact forestAt_applyMove_through hcol hij hj []
  · simp only [EntryAddr.heightPath, List.append_assoc, List.singleton_append] at hR
    have hme : m.mapEntry m.fwdIdx b = ⟨⟨m.col.path ++ (m.col.col, m.i) :: R, b.col.col⟩, b.idx⟩ := by
      unfold Move.mapEntry; dsimp only
      rw [← hR, mapPath_through, fwdIdx_j m hij, if_neg]
      intro h'; have := congrArg (fun c : ColAddr => c.path.length) h'; simp at this
    rw [hme]
    simp only [EntryAddr.heightPath]
    rw [← hR, List.append_assoc, List.cons_append, List.append_assoc, List.cons_append]
    exact forestAt_applyMove_through hcol hij hj _

-- provides: U2, D3.1e (requested by U3 R19(b)): a repair list carries the marked height.
theorem repairList_height {K : Forest} {b : EntryAddr} {ms : List Move}
    (h : RepairList K b ms) :
    (applyMoves K ms).heightAt (moveAddr ms b) = K.heightAt b := by
  revert h
  induction ms using List.reverseRecOn with
  | nil => intro _; rfl
  | append_singleton ms m ih =>
    intro h
    obtain ⟨h1, h2⟩ := repairList_append h
    rw [applyMoves_snoc, moveAddr_snoc, heightAt_repairStep h2, ih h1]

/-! ### D3.1e helpers: truncations, height replacement and moves -/

theorem setAux_eq_mod (h : Forest) : ∀ (π : List (Nat × Nat)) (j i : Nat) (t : Forest),
    Tree.setAux h π j i t = modifyColAux (fun col => col.modify i fun x => (x.1, h)) π j t
  | [], j, i, .node cols => rfl
  | (c, i₀) :: π, j, i, .node cols => by
    simp only [Tree.setAux, modifyColAux]
    congr 1
    congr 1; funext col; congr 1; funext x; rw [setAux_eq_mod h π j i x.2]

theorem modifyColAux_comp (f g : Column → Column) (c : Nat) :
    ∀ (P : List (Nat × Nat)) (T : Forest),
      modifyColAux f P c (modifyColAux g P c T) = modifyColAux (f ∘ g) P c T
  | [], .node cols => by
    simp only [modifyColAux, List.modify_modify_eq]
  | (a, b) :: P, .node cols => by
    simp only [modifyColAux, List.modify_modify_eq]
    congr 1; congr 1; funext col
    simp only [Function.comp, List.modify_modify_eq]
    congr 1; funext x
    simp only [Function.comp]
    rw [modifyColAux_comp f g c P x.2]

theorem modifyColAux_append (g : Column → Column) (bc : Nat) (c e : Nat) (R : List (Nat × Nat)) :
    ∀ (P : List (Nat × Nat)) (T : Forest),
      modifyColAux g (P ++ (c, e) :: R) bc T =
        modifyColAux (fun col => col.modify e fun x => (x.1, modifyColAux g R bc x.2)) P c T
  | [], .node cols => rfl
  | (a, b) :: P, .node cols => by
    simp only [List.cons_append, modifyColAux]
    congr 1; congr 1; funext col; congr 1; funext x
    rw [modifyColAux_append g bc c e R P x.2]

theorem litCapAux_trunc (k p jj bc bi : Nat) (ρ : List (Nat × Nat)) :
    ∀ (Bp : List (Nat × Nat)) (E : Forest) (colb : Column) (q : Nat) (H : Forest),
      E.colAt ⟨Bp, bc⟩ = some colb → colb[bi]? = some (q, H) →
      litCapAux k p (Bp ++ (bc, bi) :: ρ) jj E =
        Tree.setAux (litCapAux k p ρ jj H) Bp bc bi (Tree.truncAux Bp bc bi E)
  | [], .node cols, colb, q, H, hcol, hb => by
    rw [colAt_node_nil] at hcol
    have hbc : bc < cols.length := (List.getElem?_eq_some_iff.1 hcol).1
    have hbi : bi < colb.length := (List.getElem?_eq_some_iff.1 hb).1
    have hget : (cols.getD bc [])[bi]? = some (q, H) := by
      rw [List.getD_eq_getElem?_getD, hcol, Option.getD_some]; exact hb
    simp only [List.nil_append]
    rw [litCapAux_cons k p bc bi jj ρ cols hget]
    simp only [Tree.truncAux, Tree.setAux, List.getD_eq_getElem?_getD, hcol, Option.getD_some]
    have hl : (cols.take bc).length = bc := List.length_take_of_le hbc.le
    have hm := list_modify_snoc (cols.take bc) (colb.take (bi + 1))
      (fun col => col.modify bi fun x => (x.1, litCapAux k p ρ jj H))
    rw [hl] at hm
    rw [hm]
    congr 3
    have hsp : colb.take (bi + 1) = colb.take bi ++ [(q, H)] := by
      rw [List.take_add_one, hb]; rfl
    rw [hsp]
    have hl' : (colb.take bi).length = bi := List.length_take_of_le hbi.le
    have hm' := list_modify_snoc (colb.take bi) (q, H) (fun x => (x.1, litCapAux k p ρ jj H))
    rw [hl'] at hm'
    rw [hm']
  | (a, e) :: Bp, .node cols, colb, q, H, hcol, hb => by
    rw [colAt_node_cons] at hcol
    obtain ⟨x, hx, hcolx⟩ := Option.bind_eq_some_iff.1 hcol
    obtain ⟨colc, hc, hx'⟩ := Option.bind_eq_some_iff.1 hx
    obtain ⟨q', H'⟩ := x
    have hci : a < cols.length := (List.getElem?_eq_some_iff.1 hc).1
    have hei : e < colc.length := (List.getElem?_eq_some_iff.1 hx').1
    have hget : (cols.getD a [])[e]? = some (q', H') := by
      rw [List.getD_eq_getElem?_getD, hc, Option.getD_some]; exact hx'
    simp only [List.cons_append]
    rw [litCapAux_cons k p a e jj _ cols hget]
    simp only [Tree.truncAux, Tree.setAux, List.getD_eq_getElem?_getD, hc, Option.getD_some, hx',
      Option.map_some, Option.toList_some]
    have hl : (cols.take a).length = a := List.length_take_of_le hci.le
    have hm := list_modify_snoc (cols.take a) (colc.take e ++ [(q', Tree.truncAux Bp bc bi H')])
      (fun col => col.modify e fun x => (x.1, Tree.setAux (litCapAux k p ρ jj H) Bp bc bi x.2))
    rw [hl] at hm
    rw [hm]
    have hl' : (colc.take e).length = e := List.length_take_of_le hei.le
    have hm' := list_modify_snoc (colc.take e) (q', Tree.truncAux Bp bc bi H')
      (fun x => (x.1, Tree.setAux (litCapAux k p ρ jj H) Bp bc bi x.2))
    rw [hl'] at hm'
    rw [hm', litCapAux_trunc k p jj bc bi ρ Bp H' colb q H hcolx hb]

theorem modifyColAux_congr {f g : Column → Column} (c : Nat) :
    ∀ (P : List (Nat × Nat)) (T : Forest), (∀ col, T.colAt ⟨P, c⟩ = some col → f col = g col) →
      modifyColAux f P c T = modifyColAux g P c T
  | [], .node cols, h => by
    simp only [modifyColAux]
    congr 1
    apply List.ext_getElem?; intro n
    rw [List.getElem?_modify, List.getElem?_modify]
    by_cases hn : c = n
    · subst hn
      cases hc : cols[c]? with
      | none => rfl
      | some col =>
        have := h col (by rw [colAt_node_nil]; exact hc)
        simp [this]
    · simp [hn]
  | (a, b) :: P, .node cols, h => by
    simp only [modifyColAux]
    congr 1
    apply List.ext_getElem?; intro n
    rw [List.getElem?_modify, List.getElem?_modify]
    by_cases hn : a = n
    · subst hn
      cases hc : cols[a]? with
      | none => rfl
      | some col =>
        simp only [if_true, Option.map_eq_map, Option.map_some, Option.some.injEq]
        apply List.ext_getElem?; intro n'
        rw [List.getElem?_modify, List.getElem?_modify]
        by_cases hn' : b = n'
        · subst hn'
          cases hx : col[b]? with
          | none => rfl
          | some x =>
            simp only [if_true, Option.map_eq_map, Option.map_some, Option.some.injEq, Prod.mk.injEq,
              true_and]
            apply modifyColAux_congr c P x.2
            intro col' hcol'
            apply h col'
            rw [colAt_node_cons, hc]; simp only [Option.bind_some, hx]; exact hcol'
        · simp [hn']
    · simp [hn]

theorem moveFun_modify (m : Move) (hij : m.i < m.j) {col : Column} (hj : m.j < col.length)
    (φ : Nat × Forest → Nat × Forest) :
    moveFun m (col.modify m.j φ) = (moveFun m col).modify m.i φ := by
  apply List.ext_getElem?; intro n
  rw [moveFun, getElem?_moveFun m _ hij.le (by simp; omega), List.getElem?_modify, moveFun,
    List.getElem?_modify, getElem?_moveFun m _ hij.le hj.le]
  have hb : m.bwdIdx m.i = m.j := by unfold Move.bwdIdx; rw [if_pos le_rfl]; omega
  have hiff : (m.j = m.bwdIdx n) ↔ (m.i = n) := by
    constructor
    · intro h'
      have := congrArg m.fwdIdx h'
      rw [fwdIdx_bwdIdx, ← hb, fwdIdx_bwdIdx] at this; exact this
    · rintro rfl; exact hb.symm
  simp only [hiff]

/-- helper: the entry function by which a height replacement below a column acts on it. -/
def setFun (R : List (Nat × Nat)) (X : Forest) : Nat × Forest → Nat × Forest :=
  match R.reverse with
  | [] => fun x => (x.1, X)
  | (bc, bi) :: Drev => fun x => (x.1, modifyColAux (fun col => col.modify bi fun y => (y.1, X)) Drev.reverse bc x.2)

theorem setFun_fst (R : List (Nat × Nat)) (X : Forest) (x : Nat × Forest) : (setFun R X x).1 = x.1 := by
  unfold setFun
  generalize R.reverse = l
  cases l with
  | nil => rfl
  | cons a l => rfl

theorem setHeight_as_mod {T : Forest} {b' : EntryAddr} {P R : List (Nat × Nat)} {cc e : Nat}
    (he : (T.entryAt b').isSome) (hb : b'.heightPath = P ++ (cc, e) :: R) (X : Forest) :
    T.setHeight b' X = modifyColAux (fun col => col.modify e (setFun R X)) P cc T := by
  show (if (T.entryAt b').isSome then Tree.setAux X b'.col.path b'.col.col b'.idx T else T) = _
  rw [if_pos he, setAux_eq_mod]
  simp only [EntryAddr.heightPath] at hb
  rcases List.eq_nil_or_concat' R with rfl | ⟨D, ⟨bc, bi⟩, rfl⟩
  · obtain ⟨h1, h2⟩ := List.append_inj' hb rfl
    simp only [List.cons.injEq, Prod.mk.injEq, and_true] at h2
    rw [h1, h2.1, h2.2]
    simp [setFun]
  · have hb' : b'.col.path ++ [(b'.col.col, b'.idx)] = (P ++ (cc, e) :: D) ++ [(bc, bi)] := by
      rw [hb]; simp
    obtain ⟨h1, h2⟩ := List.append_inj' hb' rfl
    simp only [List.cons.injEq, Prod.mk.injEq, and_true] at h2
    rw [h1, h2.1, h2.2, modifyColAux_append]
    simp [setFun]

theorem applyMove_setHeight {T : Forest} {m : Move} {col : Column} (hcol : T.colAt m.col = some col)
    (hij : m.i < m.j) (hj : m.j < col.length) {b' : EntryAddr} {R : List (Nat × Nat)}
    (hb' : b'.heightPath = m.col.path ++ (m.col.col, m.j) :: R) (he : (T.entryAt b').isSome)
    (X : Forest) :
    applyMove (T.setHeight b' X) m = (applyMove T m).setHeight (m.mapEntry m.fwdIdx b') X := by
  have hfb : (m.mapEntry m.fwdIdx b').heightPath = m.col.path ++ (m.col.col, m.i) :: R := by
    rw [heightPath_mapEntry, hb', mapPath_through, fwdIdx_j m hij]
  have he' : ((applyMove T m).entryAt (m.mapEntry m.fwdIdx b')).isSome := by
    have h1 : (applyMove T m).forestAt (m.mapEntry m.fwdIdx b').heightPath = T.forestAt b'.heightPath := by
      rw [hfb, hb']; exact forestAt_applyMove_through hcol hij hj R
    rw [Tree.forestAt_heightPath, Tree.forestAt_heightPath] at h1
    simp only [Tree.heightAt] at h1
    cases h2 : (applyMove T m).entryAt (m.mapEntry m.fwdIdx b') with
    | some _ => rfl
    | none => rw [h2] at h1; cases h3 : T.entryAt b' <;> simp_all
  rw [setHeight_as_mod he hb', setHeight_as_mod he' hfb]
  have hcol' : (modifyColAux (fun col => col.modify m.j (setFun R X)) m.col.path m.col.col T).colAt m.col =
      some (col.modify m.j (setFun R X)) := by
    rw [colAt_mod_self, hcol]; rfl
  rw [applyMove_eq_mod hcol' hij (by simp; omega), applyMove_eq_mod hcol hij hj, modifyColAux_comp,
    modifyColAux_comp]
  apply modifyColAux_congr
  intro col' hc'
  rw [show (⟨m.col.path, m.col.col⟩ : ColAddr) = m.col from rfl, hcol] at hc'
  obtain rfl := Option.some.inj hc'
  exact moveFun_modify m hij hj _

theorem repairList_snoc {K : Forest} {b : EntryAddr} {ms : List Move} {m : Move}
    (h : RepairList K b ms) (hm : RepairStepOK (applyMoves K ms) (moveAddr ms b) m) :
    RepairList K b (ms ++ [m]) := by
  intro idx hidx
  simp only [List.length_append, List.length_singleton] at hidx
  rcases Nat.lt_or_eq_of_le (Nat.lt_succ_iff.1 hidx) with hlt | rfl
  · rw [List.take_append_of_le_length hlt.le, List.getElem_append_left hlt]; exact h idx hlt
  · rw [List.take_left, List.getElem_append_right (by omega)]; simpa using hm

-- provides: U2, D3.1e (requested by U3 R12): the moves of an admissible cap that avoid the
-- marked height `B` form a repair list for `b` and commute with replacing `B`.
-- G-016: `hout` is `MovesOutside` (the original static exclusion is false, BP-04).
-- Moved here from before `moves_violate` (brief rule 5): its proof needs `applyMoves_litCap_addr`,
-- `moveAddr_num` and `repairList_height`; nothing in between uses it.
theorem moves_spec {E : Forest} (hE : InL E) (w : AdmCap E) (b : EntryAddr)
    (hb : b.heightPath <+: w.col.path) (hout : MovesOutside w.moves b) :
    RepairList (E.truncAfter b) b w.moves ∧
    (moveAddr w.moves b).col.num 0 = b.col.num 0 ∧
    (∀ X, applyMoves ((E.truncAfter b).setHeight b X) w.moves =
      (applyMoves (E.truncAfter b) w.moves).setHeight (moveAddr w.moves b) X) ∧
    (applyMoves (E.truncAfter b) w.moves).heightAt (moveAddr w.moves b) = E.heightAt b ∧
    w.H = (applyMoves (E.truncAfter b) w.moves).setHeight (moveAddr w.moves b)
      ((w.H.heightAt (moveAddr w.moves b)).getD Tree.empty) := by
  obtain ⟨col, hcol, hk, -⟩ := isUpward_iff_exists.1 w.upward
  obtain ⟨qb, Hb, hEb⟩ := heightAt_of_prefix hcol hb
  have hbE : b ∈ E.entryAddrs := (Tree.mem_entryAddrs_iff _ _).2 (by rw [hEb]; rfl)
  set T := E.truncAfter b with hT
  have hTb : T.entryAt b = E.entryAt b := Tree.entryAt_truncAfter hbE
  obtain ⟨S, hS⟩ := hb
  set X0 := litCapAux w.cut w.par S w.col.col Hb
  -- the literal cap is the truncation with the height at `b` replaced
  have hK0 : litCap E w.col w.cut w.par = T.setHeight b X0 := by
    obtain ⟨colb, hcolb, hbi⟩ := Tree.colAt_of_entryAt hEb
    rw [litCap_eq_aux hcol]
    have hpath : w.col.path = b.col.path ++ (b.col.col, b.idx) :: S := by
      rw [← hS]; simp [EntryAddr.heightPath]
    rw [hpath, litCapAux_trunc w.cut w.par w.col.col b.col.col b.idx S b.col.path E colb qb Hb hcolb hbi]
    show _ = (if (T.entryAt b).isSome then Tree.setAux X0 b.col.path b.col.col b.idx T else T)
    rw [hTb, hEb, if_pos (show (some (qb, Hb)).isSome = true from rfl)]
    show _ = Tree.setAux X0 b.col.path b.col.col b.idx
      (if (E.entryAt b).isSome then Tree.truncAux b.col.path b.col.col b.idx E else E)
    rw [hEb, if_pos (show (some (qb, Hb)).isSome = true from rfl)]
  have hH := hE.2.2.1
  -- the joint induction along the moves
  have key : ∀ q, q ≤ w.moves.length →
      RepairList T b (w.moves.take q) ∧
      ((applyMoves T (w.moves.take q)).entryAt (moveAddr (w.moves.take q) b)).isSome ∧
      ∀ X, applyMoves (T.setHeight b X) (w.moves.take q) =
        (applyMoves T (w.moves.take q)).setHeight (moveAddr (w.moves.take q) b) X := by
    intro q
    induction q with
    | zero => intro _; exact ⟨fun idx h => absurd h (by simp),
        by simp [moveAddr, moveAddrBody, applyMoves, hTb, hEb],
        fun X => by simp [moveAddr, moveAddrBody, applyMoves]⟩
    | succ q ih =>
      intro hq
      obtain ⟨hrl, hent, hcomm⟩ := ih (by omega)
      set bq := moveAddr (w.moves.take q) b
      set Tq := applyMoves T (w.moves.take q)
      set m := w.moves[q]
      have htake : w.moves.take (q + 1) = w.moves.take q ++ [m] := (List.take_concat_get' _ _ _).symm
      -- the move, read on the cap
      obtain ⟨hupq, heqq, -⟩ := applyMoves_litCap_addr hH w ⟨S, hS⟩ hout q (by omega)
      have hm : MoveOK (litCap E ⟨bq.heightPath ++ w.col.path.drop b.heightPath.length, w.col.col⟩
          w.cut w.par) m := by
        have := w.movesValid q (by omega); rw [heqq] at this; exact this
      have hSd : w.col.path.drop b.heightPath.length = S := by rw [← hS]; simp
      rw [hSd] at hm hupq heqq
      obtain ⟨rest, hrest, -, -, -⟩ := litCap_move_step hH hupq hm
      have hno := hout q (by omega)
      simp only at hrest
      obtain ⟨T', hT'⟩ : ∃ T', bq.heightPath = m.col.path ++ (m.col.col, m.j) :: T' := by
        have h1 : bq.heightPath <+: m.col.path ++ (m.col.col, m.j) :: rest := ⟨S, hrest⟩
        have h2 : m.col.path ++ [(m.col.col, m.j)] <+: m.col.path ++ (m.col.col, m.j) :: rest :=
          ⟨rest, by simp⟩
        rcases List.prefix_or_prefix_of_prefix h1 h2 with h | h
        · obtain ⟨U, hU⟩ := h
          rcases List.eq_nil_or_concat' U with rfl | ⟨U', u, rfl⟩
          · exact ⟨[], by simpa using hU⟩
          · exfalso; apply hno
            rw [← List.append_assoc] at hU
            obtain ⟨hU1, -⟩ := List.append_inj' hU rfl
            exact ⟨U', hU1⟩
        · obtain ⟨T', hTT⟩ := h; exact ⟨T', by rw [← hTT]; simp⟩
      -- the cap is the moved truncation with the height at `bq` replaced
      have hKq : applyMoves (litCap E w.col w.cut w.par) (w.moves.take q) = Tq.setHeight bq X0 := by
        rw [hK0, hcomm]
      rw [heqq] at hKq
      obtain ⟨colK, sdK, hcolK, -, hjK, hijK, -, hparK, -, -⟩ := hm
      rw [hKq, setHeight_as_mod hent hT', colAt_mod_self] at hcolK
      obtain ⟨colT, hcolT, rfl⟩ := Option.map_eq_some_iff.1 hcolK
      have hjT : m.j < colT.length := by simp at hjK; omega
      have hlab : ∀ x, ((colT.modify m.j (setFun T' X0)).getD x (0, Tree.empty)).1 =
          (colT.getD x (0, Tree.empty)).1 := by
        intro x
        simp only [List.getD_eq_getElem?_getD, List.getElem?_modify]
        cases colT[x]? with
        | none => rfl
        | some y =>
          simp only [Option.map_eq_map, Option.map_some, Option.getD_some]
          split
          · exact setFun_fst T' X0 y
          · rfl
      have hstep : RepairStepOK Tq bq m := by
        refine ⟨colT, hcolT, hijK, hjT, ?_, fun x h1 h2 => ?_, ?_⟩
        · rcases List.eq_nil_or_concat' T' with rfl | ⟨D, d, rfl⟩
          · left
            simp only [EntryAddr.heightPath] at hT'
            obtain ⟨h1, h2⟩ := List.append_inj' hT' rfl
            simp only [List.cons.injEq, Prod.mk.injEq, and_true] at h2
            show m.col = bq.col
            rcases m with ⟨⟨mp, mc⟩, mi, mj⟩; rcases bq with ⟨⟨bp, bc⟩, bi⟩
            simp_all
          · right; refine ⟨m.j, D, ?_⟩
            simp only [EntryAddr.heightPath] at hT' ⊢
            have : bq.col.path ++ [(bq.col.col, bq.idx)] = (m.col.path ++ (m.col.col, m.j) :: D) ++ [d] := by
              rw [hT']; simp
            obtain ⟨h1, -⟩ := List.append_inj' this rfl
            rw [h1]; simp
        · have := hparK x h1 h2; rw [hlab, hlab] at this; exact this
        · rcases List.eq_nil_or_concat' T' with rfl | ⟨D, d, rfl⟩
          · left
            simp only [EntryAddr.heightPath] at hT'
            obtain ⟨h1, h2⟩ := List.append_inj' hT' rfl
            simp only [List.cons.injEq, Prod.mk.injEq, and_true] at h2
            rcases m with ⟨⟨mp, mc⟩, mi, mj⟩; rcases bq with ⟨⟨bp, bc⟩, bi⟩
            simp_all
          · right; refine ⟨D, ?_⟩
            simp only [EntryAddr.heightPath] at hT' ⊢
            have : bq.col.path ++ [(bq.col.col, bq.idx)] = (m.col.path ++ (m.col.col, m.j) :: D) ++ [d] := by
              rw [hT']; simp
            obtain ⟨h1, -⟩ := List.append_inj' this rfl
            rw [h1]; simp
      refine ⟨by rw [htake]; exact repairList_snoc hrl hstep, ?_, fun X => ?_⟩
      · rw [htake, applyMoves_snoc, moveAddr_snoc]
        have := heightAt_repairStep hstep
        simp only [Tree.heightAt] at this
        cases h1 : (applyMove Tq m).entryAt (m.mapEntry m.fwdIdx bq) with
        | some _ => rfl
        | none => rw [h1] at this; cases h2 : Tq.entryAt bq <;> simp_all
      · rw [htake, applyMoves_snoc, applyMoves_snoc, moveAddr_snoc, hcomm X]
        exact applyMove_setHeight hcolT hijK hjT hT' hent X
  obtain ⟨hrl, hent, hcomm⟩ := key w.moves.length le_rfl
  rw [List.take_length] at hrl hent hcomm
  have hbn : moveAddr w.moves b ∈ (applyMoves T w.moves).entryAddrs :=
    (Tree.mem_entryAddrs_iff _ _).2 hent
  refine ⟨hrl, moveAddr_num _ _, hcomm, ?_, ?_⟩
  · rw [repairList_height hrl, Tree.heightAt, hTb]; rfl
  · have hwH : w.H = (applyMoves T w.moves).setHeight (moveAddr w.moves b) X0 := by
      show applyMoves (litCap E w.col w.cut w.par) w.moves = _
      rw [hK0, hcomm]
    rw [hwH, (Tree.setHeight_basic _ _ X0 hbn).2.1, Option.getD_some]



/-! ## D3.3, L3.5 — kernels, contexts, filling identity, cancellation -/

/-- D3.3: the root forest `F = F_j` (the forest containing the root column). -/
def rootForest (E : Forest) (rd : RootData) : Forest := (E.forestAt rd.col.path).getD Tree.empty

/-- D3.3: the root column `R`. -/
def rootCol (E : Forest) (rd : RootData) : Column := (E.colAt rd.col).getD []

/-- D3.3: the unconsumed root suffix `U = R[c:]`. -/
def unconsumed (E : Forest) (rd : RootData) : Column := (rootCol E rd).drop rd.cursor

/-- D3.3: the period `d = t − r`. -/
def period (sd : StopData) : Nat := sd.t - sd.r

/-- D3.3: the hole depth `ℓ − j` (relative to the root forest). -/
def holeDepth (sd : StopData) (rd : RootData) : Nat := sd.depth - rd.layer

/-- D3.3: the kernel is defined unless the owner root is exhausted (txt:129). -/
def KernelDefined (E : Forest) (rd : RootData) : Prop := rd.owner = true → unconsumed E rd ≠ []

/-- D3.3 (txt:421-422): the kernel `F_E(X)`: one period of the ordinary loop with its rightmost
continuation hole filled by `T_{r,t−r}(X)`. Body case: head `Q ⌢ U'` then
`A_{r,d,ℓ−j,T_d X}(F[i+1:])`; owner case: the head alone, its last restored height using
`A_{r,d,ℓ−j−1,T_d X}`. -/
def kernel (E : Forest) (sd : StopData) (rd : RootData) (X : Forest) : Forest :=
  let r := sd.r
  let d := period sd
  let U := unconsumed E rd
  if rd.owner then
    .node [sd.Q ++ mapLast (fun x => (x.1, shift r d x.2))
      (fun x => (x.1, replaceAt r d (shift r d X) (holeDepth sd rd - 1) x.2)) U]
  else
    .node ((sd.Q ++ U.map fun x => (x.1, shift r d x.2)) ::
      (replaceAt r d (shift r d X) (holeDepth sd rd)
        (.node ((rootForest E rd).cols.drop (rd.idx + 1)))).cols)

/-- D3.3 (txt:422): the terminal context `C_E(Z) = A_{0,0,ℓ,Z}(E)`; also the paper's
`fill(K, Y)` (txt:440). -/
def context (E : Forest) (sd : StopData) (Z : Forest) : Forest := replaceAt 0 0 Z sd.depth E

/-- D3.3b: the kernel's word prefix `P = w(F_E(∅))`. -/
def kerPrefix (E : Forest) (sd : StopData) (rd : RootData) : List WordAtom :=
  word (kernel E sd rd Tree.empty)

/-- D3.3b: the letterwise embedding `Σ`: depth translation by `2(ℓ−j)`, parent shift `T_{r,d}`.
VERIFY-U2 (F1): the parent shift is applied only to entry atoms. An empty-column atom `(2e, 0, 0)`
(even depth coordinate, marker `0`) keeps its third coordinate: shifting it would turn `(2e,0,0)`
into `(2e,0,d)` when `r = 0`, and `word_kernel` would fail (e.g. `E = seed 1`, `X = [[],[]]`). -/
def kerSigma (sd : StopData) (rd : RootData) (A : WordAtom) : WordAtom :=
  toLex ((ofLex A).1 + 2 * holeDepth sd rd,
    toLex ((ofLex (ofLex A).2).1,
      if (ofLex A).1 % 2 = 0 ∧ (ofLex (ofLex A).2).1 = 0 then (ofLex (ofLex A).2).2
      else shiftVal sd.r (period sd) (ofLex (ofLex A).2).2))

/-- D3.3b: depth translation of an atom by `e` levels. -/
def depthShift (e : Nat) (A : WordAtom) : WordAtom := toLex ((ofLex A).1 + 2 * e, (ofLex A).2)

/-! ### D3.3a helpers: the loop identity -/

/-- D3.3a helper: the columns of a relabelled tree. -/
theorem ker_map_cols {α β : Type} (f : α → β) (T : Tree α) :
    (Tree.map f T).cols = T.cols.map (Tree.mapCol f) := by
  obtain ⟨cs⟩ := T
  simp only [Tree.map, Tree.cols]
  exact treeMapCols_eq_map f cs

/-- D3.3a helper: a shift of a node. -/
theorem ker_shift_node (r a : Nat) (cs : List Column) :
    shift r a (Tree.node cs) = Tree.node (cs.map (Tree.mapCol (shiftVal r a))) := by
  simp only [shift, Tree.map]
  rw [treeMapCols_eq_map]

/-- D3.3a helper: `mapCol` distributes over an append. -/
theorem ker_mapCol_append {α β : Type} (f : α → β) (l₁ l₂ : List (α × Tree α)) :
    Tree.mapCol f (l₁ ++ l₂) = Tree.mapCol f l₁ ++ Tree.mapCol f l₂ := by
  rw [treeMapCol_eq_map, treeMapCol_eq_map, treeMapCol_eq_map, List.map_append]

/-- D3.3a helper: `mapCol (shiftVal r 0)` is the identity. -/
theorem ker_mapCol_zero (r : Nat) (l : Column) : Tree.mapCol (shiftVal r 0) l = l := by
  rw [shiftVal_zero_fun, treeMapCol_id]

/-- D3.3a helper: a shift fixes the outer parents `< r` of a column whose heights are shifted. -/
theorem ker_mapCol_heights {r a b : Nat} {l : Column} (hl : ∀ x ∈ l, x.1 < r) :
    Tree.mapCol (shiftVal r a) (l.map fun x => (x.1, shift r b x.2)) =
      l.map fun x => (x.1, shift r (a + b) x.2) := by
  rw [treeMapCol_eq_map, List.map_map]
  apply List.map_congr_left
  intro x hx
  simp only [Function.comp]
  have h1 : shiftVal r a x.1 = x.1 := by
    have := hl x hx
    unfold shiftVal; rw [if_neg (by omega)]
  rw [h1]
  exact Prod.ext rfl (shift_add r a b x.2)

/-- D3.3a helper: a shift composes with a shifted placement. -/
theorem ker_shift_replaceAt (r a b k : Nat) (Y G : Forest) :
    shift r a (replaceAt r b Y k G) = replaceAt r (a + b) (shift r a Y) k G := by
  rw [replaceAt_eq_shift r b, shift_replaceAt, replaceAt_eq_shift r a, shift_add,
    ← replaceAt_eq_shift]

/-- D3.3a helper: the outer parents of the unconsumed root suffix are `< r` (V). -/
theorem ker_unconsumed_lt {E : Forest} {sd : StopData} {rd : RootData} (hV : CondV E)
    (hsd : stopData E = some sd) (hrd : rootData E = some rd) :
    ∀ x ∈ unconsumed E rd, x.1 < sd.r := by
  intro x hx
  obtain ⟨-, -, -, hnum, -, hmem, -⟩ := rootData_spec hsd hrd
  have hx' : x ∈ rootCol E rd := List.mem_of_mem_drop hx
  unfold rootCol at hx'
  obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff E rd.col).1 hmem)
  rw [hcol, Option.getD_some] at hx'
  obtain ⟨i, hi, hxi⟩ := List.getElem_of_mem hx'
  have he : E.entryAt ⟨rd.col, i⟩ = some x := by
    simp only [Tree.entryAt, hcol, Option.bind_some, List.getElem?_eq_getElem hi, hxi]
  have hmemE : (⟨rd.col, i⟩ : EntryAddr) ∈ E.entryAddrs :=
    (Tree.mem_entryAddrs_iff _ _).2 (by rw [he]; rfl)
  have := (condV_iff_lt E).1 hV ⟨rd.col, i⟩ hmemE x.1 x.2 he
  rw [hnum] at this
  exact this

/-- D3.3a helper: pass `k + 1` of the loop on a `τ_{kd}`-shifted input is the `τ_{kd}`-shift of
pass `1` (outer parents of `U` are `< r`). -/
theorem ker_ordStep_shift {sd : StopData} {rd : RootData} {F : Forest} {U : Column}
    (hU : ∀ x ∈ U, x.1 < sd.r) (k : Nat) (Y : Forest) :
    ordStep sd rd F U (k + 1) (shift sd.r (k * (sd.t - sd.r)) Y) =
      shift sd.r (k * (sd.t - sd.r)) (ordStep sd rd F U 1 Y) := by
  unfold ordStep
  simp only [Nat.add_sub_cancel, Nat.sub_self, Nat.zero_mul, Nat.one_mul, ker_mapCol_zero]
  have hkd : (k + 1) * (sd.t - sd.r) = k * (sd.t - sd.r) + (sd.t - sd.r) := Nat.succ_mul _ _
  by_cases ho : rd.owner = true
  · simp only [ho, if_true]
    rw [ker_shift_node, List.map_cons, List.map_nil, ker_mapCol_append, ker_mapCol_append]
    have hdl : ∀ x ∈ U.dropLast, x.1 < sd.r := fun x hx => hU x (List.mem_of_mem_dropLast hx)
    rw [ker_mapCol_heights hdl, ← hkd]
    congr 3
    cases hl : U.getLast? with
    | none => rfl
    | some u =>
      have hu := hU u (List.mem_of_getLast? hl)
      simp only [Option.map_some, Option.toList_some, Tree.mapCol]
      have h1 : shiftVal sd.r (k * (sd.t - sd.r)) u.1 = u.1 := by
        unfold shiftVal; rw [if_neg (by omega)]
      rw [h1]
      congr 2
      show replaceAt _ _ _ _ _ = shift sd.r _ (replaceAt _ _ _ _ _)
      rw [ker_shift_replaceAt, hkd]
  · simp only [ho, Bool.false_eq_true, if_false]
    rw [ker_shift_node, List.map_cons, ker_mapCol_append, ker_mapCol_heights hU, ← hkd]
    congr 2
    rw [← ker_map_cols]
    show (replaceAt _ _ _ _ _).cols = (shift sd.r _ (replaceAt _ _ _ _ _)).cols
    rw [ker_shift_replaceAt, hkd]

/-- D3.3a helper: pass `1` on a `T_d`-shifted input is the kernel. -/
theorem ker_ordStep_one (E : Forest) (sd : StopData) (rd : RootData) (X : Forest) :
    ordStep sd rd (rootForest E rd) (unconsumed E rd) 1 (shift sd.r (sd.t - sd.r) X) =
      kernel E sd rd X := by
  unfold ordStep kernel
  simp only [Nat.sub_self, Nat.zero_mul, Nat.one_mul, ker_mapCol_zero]
  by_cases ho : rd.owner = true
  · simp only [ho, if_true, mapLast_eq, List.append_assoc]
    rfl
  · simp only [ho, Bool.false_eq_true, if_false]
    rfl

/-- D3.3a helper: after the passes `k, …, 1` on `τ_{kd}(F^m ∅)` the loop variable is
`F^{m+k} ∅`. -/
theorem ker_ordLoop {E : Forest} {sd : StopData} {rd : RootData}
    (hU : ∀ x ∈ unconsumed E rd, x.1 < sd.r) :
    ∀ (k m : Nat), ordLoop (ordStep sd rd (rootForest E rd) (unconsumed E rd)) k
      (shift sd.r (k * (sd.t - sd.r)) ((kernel E sd rd)^[m] Tree.empty)) =
        (kernel E sd rd)^[m + k] Tree.empty
  | 0, m => by simp only [ordLoop, Nat.zero_mul, shift_zero, Nat.add_zero]
  | k + 1, m => by
    simp only [ordLoop]
    rw [Nat.succ_mul, ← shift_add, ker_ordStep_shift hU, ker_ordStep_one,
      ← Function.iterate_succ_apply' (kernel E sd rd) m, ker_ordLoop hU k (m + 1)]
    rw [Nat.add_assoc, Nat.add_comm 1 k]

/-- D3.3a helper: the final loop variable of an ordinary step is the `n`-th kernel iterate. -/
theorem ker_ordZ {E : Forest} {sd : StopData} {rd : RootData} (hV : CondV E)
    (hsd : stopData E = some sd) (hrd : rootData E = some rd) (n : Nat) :
    ordZ E sd rd n = (kernel E sd rd)^[n] Tree.empty := by
  have h := ker_ordLoop (ker_unconsumed_lt hV hsd hrd) n 0
  rw [Function.iterate_zero_apply, Nat.zero_add] at h
  have he : shift sd.r (n * (sd.t - sd.r)) Tree.empty = Tree.empty := rfl
  rw [he] at h
  exact h

-- provides: U2, D3.3a (txt:422: `H[q] = C_H(F_H^q(∅))`)
theorem expand_eq_iterate {E : Forest} {sd : StopData} {rd : RootData} (hE : E ≠ Tree.empty)
    (hV : CondV E) (hI : CondI E) (hk : stepKind E = some .ordinary)
    (hsd : stopData E = some sd) (hrd : rootData E = some rd) (hdef : KernelDefined E rd)
    (n : Nat) : expand E n = some (context E sd ((kernel E sd rd)^[n] Tree.empty)) := by
  rw [expand_eq_paperOp hE hV hI, paperOp_ordinary hk hsd hrd]
  have hc : (rd.owner && n != 0 && (((E.colAt rd.col).getD []).drop rd.cursor).isEmpty) = false := by
    by_cases ho : rd.owner = true
    · have hU : unconsumed E rd ≠ [] := hdef ho
      unfold unconsumed rootCol at hU
      simp [hU]
    · simp [ho]
  simp only [hc, Bool.false_eq_true, if_false]
  rw [← ker_ordZ hV hsd hrd]
  rfl

-- D3.3a: the exhausted owner root is the only undefined case
theorem expand_none_iff {E : Forest} {sd : StopData} {rd : RootData} (hE : E ≠ Tree.empty)
    (hV : CondV E) (hI : CondI E) (hk : stepKind E = some .ordinary)
    (hsd : stopData E = some sd) (hrd : rootData E = some rd) (n : Nat) :
    expand E n = none ↔ (1 ≤ n ∧ ¬ KernelDefined E rd) := by
  rw [expand_eq_paperOp hE hV hI, paperOp_ordinary hk hsd hrd]
  unfold KernelDefined unconsumed rootCol
  by_cases hc : (rd.owner && n != 0 && (((E.colAt rd.col).getD []).drop rd.cursor).isEmpty) = true
  · rw [if_pos hc]
    simp only [Bool.and_eq_true, bne_iff_ne, ne_eq, List.isEmpty_iff] at hc
    obtain ⟨⟨ho, hn⟩, hU⟩ := hc
    simp only [true_iff]
    exact ⟨by omega, fun h => h ho hU⟩
  · rw [if_neg hc]
    simp only [reduceCtorEq, false_iff, not_and, not_not]
    intro hn ho
    simp only [Bool.and_eq_true, bne_iff_ne, ne_eq, List.isEmpty_iff, not_and] at hc
    exact hc ⟨ho, by omega⟩

-- VERIFY-U2 (F2): D3.3a part 3: at parameter `0` the ordinary output is `C_E(∅)` with no
-- `KernelDefined` hypothesis (the exhausted owner root only matters for `n ≥ 1`); needed by
-- T3.2g and `expand_lt` (V, I only) and by T3.8c.3
theorem expand_zero_eq_context {E : Forest} {sd : StopData} (hE : E ≠ Tree.empty)
    (hV : CondV E) (hI : CondI E) (hk : stepKind E = some .ordinary)
    (hsd : stopData E = some sd) : expand E 0 = some (context E sd Tree.empty) := by
  rw [expand_eq_paperOp hE hV hI, paperOp_ordinary_zero hk hsd]
  rfl

/-! ### D3.3b helpers: the route to the hole and words of placements -/

/-- D3.3b helper: the last-column, last-entry route of `F` reaches a column at depth `k` (so
`replaceAt _ _ _ k F` places its filling there). -/
def KerRoute : Nat → Forest → Prop
  | 0, F => F.cols ≠ []
  | k + 1, F => ∃ col p H, F.cols.getLast? = some col ∧ col.getLast? = some (p, H) ∧ KerRoute k H

/-- D3.3b helper: `word_put` for an arbitrary forest whose route reaches depth `k`. -/
theorem ker_wordAt_replaceAt (Z : Forest) :
    ∀ (k : Nat) (F : Forest) (e : Nat), KerRoute k F →
      wordAt e (replaceAt 0 0 Z k F) = wordAt e (replaceAt 0 0 Tree.empty k F) ++ wordAt (e + k) Z
  | 0, .node cols, e, h => by
    obtain ⟨zc⟩ := Z
    cases cols with
    | nil => exact absurd rfl h
    | cons c cs =>
      simp only [replaceAt, wordAt, Tree.cols, Tree.empty, List.append_nil, wordCols_append,
        Nat.add_zero]
  | k + 1, .node cols, e, h => by
    obtain ⟨col, p, H, hc, hl, hk⟩ := h
    have ih := ker_wordAt_replaceAt Z k H (e + 1) hk
    simp only [Tree.cols] at hc
    simp only [replaceAt, mapLast_eq, hc, hl, Option.map_some, Option.toList_some, wordAt,
      wordCols_append, wordCols, List.append_nil]
    rw [wordCol_snoc, wordCol_snoc e _ _ (replaceAt 0 0 Tree.empty k H), ih]
    simp only [List.append_assoc]
    rw [show e + 1 + k = e + (k + 1) by omega]

/-- D3.3b helper: relabelling keeps the route. -/
theorem ker_route_map {f : Nat → Nat} :
    ∀ (k : Nat) (F : Forest), KerRoute k F → KerRoute k (Tree.map f F)
  | 0, F, h => by
    show (Tree.map f F).cols ≠ []
    rw [ker_map_cols]
    exact fun h' => h (List.map_eq_nil_iff.1 h')
  | k + 1, F, h => by
    obtain ⟨col, p, H, hc, hl, hk⟩ := h
    refine ⟨Tree.mapCol f col, f p, Tree.map f H, ?_, ?_, ker_route_map k H hk⟩
    · rw [ker_map_cols, List.getLast?_map, hc]; rfl
    · rw [treeMapCol_eq_map, List.getLast?_map, hl]; rfl

/-- D3.3b helper: shifting keeps the route. -/
theorem ker_route_shift {r d k : Nat} {F : Forest} (h : KerRoute k F) : KerRoute k (shift r d F) :=
  ker_route_map k F h

/-- D3.3b helper: one step down the route. -/
theorem ker_forestAt_lastStep {G : Forest} {col : Column} {p : Nat} {H : Forest}
    (hc : G.cols.getLast? = some col) (hl : col.getLast? = some (p, H)) :
    G.forestAt [(G.cols.length - 1, col.length - 1)] = some H := by
  have h1 : G.cols[G.cols.length - 1]? = some col := by rw [← List.getLast?_eq_getElem?]; exact hc
  have h2 : col[col.length - 1]? = some (p, H) := by rw [← List.getLast?_eq_getElem?]; exact hl
  simp only [Tree.forestAt, h1, Option.bind_some, h2]

/-- D3.3b helper: along the stopping route, the forest at depth `j` has a route of depth `ℓ − j`. -/
theorem ker_route_of_stop {E : Forest} {sd : StopData} (hsd : stopData E = some sd) :
    ∀ j, j ≤ sd.depth →
      ∃ G, E.forestAt (sd.col.path.take j) = some G ∧ KerRoute (sd.depth - j) G := by
  obtain ⟨-, hdep, -, hmem, -⟩ := stopData_spec hsd
  obtain ⟨hpath, F, hF, hFlen⟩ := (Scan.mem_routeCols_iff E sd.col).1 hmem
  suffices h : ∀ m j, j + m = sd.col.path.length →
      ∃ G, E.forestAt (sd.col.path.take j) = some G ∧ KerRoute m G by
    intro j hj
    exact h (sd.depth - j) j (by omega)
  intro m
  induction m with
  | zero =>
    intro j hj
    refine ⟨F, ?_, ?_⟩
    · rw [List.take_of_length_le (by omega)]; exact hF
    · show F.cols ≠ []
      intro h; rw [h] at hFlen; simp at hFlen
  | succ m ih =>
    intro j hj
    obtain ⟨H, hH, hHr⟩ := ih (j + 1) (by omega)
    obtain ⟨G, hG, hlast⟩ := hpath j (by omega)
    refine ⟨G, hG, ?_⟩
    have hj' : j < sd.col.path.length := by omega
    rw [List.getElem?_eq_getElem hj'] at hlast
    unfold Tree.lastStep? at hlast
    cases hgc : G.cols.getLast? with
    | none => rw [hgc] at hlast; simp at hlast
    | some col =>
      rw [hgc] at hlast
      simp only [Option.bind_some] at hlast
      split at hlast
      · simp at hlast
      · rename_i hne
        have hstep : sd.col.path[j] = (G.cols.length - 1, col.length - 1) :=
          (Option.some.inj hlast).symm
        have hcol : col ≠ [] := by simpa using hne
        obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 (List.getLast?_isSome.2 hcol)
        obtain ⟨p, H'⟩ := x
        rw [List.take_add_one, List.getElem?_eq_getElem hj', Option.toList_some,
          Tree.forestAt_append, hG, Option.bind_some, hstep, ker_forestAt_lastStep hgc hx] at hH
        cases hH
        exact ⟨col, p, H, hgc, hx, hHr⟩

/-- D3.3b helper: the root forest has a route of depth `ℓ − j`. -/
theorem ker_route_rootForest {E : Forest} {sd : StopData} {rd : RootData}
    (hsd : stopData E = some sd) (hrd : rootData E = some rd) :
    E.forestAt rd.col.path = some (rootForest E rd) ∧
      KerRoute (holeDepth sd rd) (rootForest E rd) := by
  obtain ⟨-, -, hlay, hpre, -⟩ := rootData_path hsd hrd
  obtain ⟨-, hdep, -⟩ := stopData_spec hsd
  have hle : rd.layer ≤ sd.depth := rootData_layer_le hsd hrd
  obtain ⟨G, hG, hR⟩ := ker_route_of_stop hsd rd.layer hle
  have hp : rd.col.path = sd.col.path.take rd.layer := by
    rw [hlay]; exact List.prefix_iff_eq_take.1 hpre
  rw [← hp] at hG
  have : rootForest E rd = G := by unfold rootForest; rw [hG]; rfl
  rw [this]
  exact ⟨hG, hR⟩

/-- D3.3b helper: shifts fix the empty forest. -/
theorem ker_shift_empty (r d : Nat) : shift r d Tree.empty = Tree.empty := rfl

/-- D3.3b helper: words of a node are the words of its columns. -/
theorem ker_wordCols_cols (e : Nat) (T : Forest) : wordCols e T.cols = wordAt e T := by
  obtain ⟨cs⟩ := T; rfl

/-- D3.3b helper: the word of a shifted forest placed at depth `δ`. -/
theorem ker_wordAt_shift (sd : StopData) (rd : RootData) (X : Forest) :
    wordAt (holeDepth sd rd) (shift sd.r (period sd) X) = (word X).map (kerSigma sd rd) := by
  rw [show holeDepth sd rd = 0 + holeDepth sd rd by omega, wordAt_add, shift, wordAt_map,
    List.map_map]
  unfold word
  apply List.map_congr_left
  intro A _
  simp only [Function.comp, WordAtom.relabel, kerSigma]
  split_ifs <;> rfl

-- D3.3b: the context appends the word of its filling at depth `ℓ`
theorem word_context {E : Forest} {sd : StopData} (hsd : stopData E = some sd) (Z : Forest) :
    word (context E sd Z) = word (context E sd Tree.empty) ++ (word Z).map (depthShift sd.depth) := by
  obtain ⟨G, hG, hR⟩ := ker_route_of_stop hsd 0 (Nat.zero_le _)
  simp only [List.take_zero, Tree.forestAt, Option.some.injEq] at hG
  subst hG
  rw [Nat.sub_zero] at hR
  unfold context word
  rw [ker_wordAt_replaceAt Z _ _ 0 hR, Nat.zero_add, show sd.depth = 0 + sd.depth by omega,
    wordAt_add, Nat.zero_add]
  rfl

-- D3.3b (txt:422): `w(F_E(X)) = P ⌢ Σ(w(X))`
theorem word_kernel {E : Forest} {sd : StopData} {rd : RootData} (hV : CondV E)
    (hsd : stopData E = some sd) (hrd : rootData E = some rd) (hkd : KernelDefined E rd)
    (X : Forest) :
    word (kernel E sd rd X) = kerPrefix E sd rd ++ (word X).map (kerSigma sd rd) := by
  rw [← ker_wordAt_shift]
  obtain ⟨hF, hR⟩ := ker_route_rootForest hsd hrd
  obtain ⟨-, -, hidx, -, -, hmem, -, hown⟩ := rootData_spec hsd hrd
  obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff E rd.col).1 hmem)
  have hcolF : (rootForest E rd).cols[rd.idx]? = some col := by
    unfold Tree.colAt at hcol; rw [hF, Option.bind_some, ← hidx] at hcol; exact hcol
  have hidxlt : rd.idx < (rootForest E rd).cols.length := by
    by_contra h; rw [List.getElem?_eq_none (by omega)] at hcolF; cases hcolF
  unfold kerPrefix kernel
  by_cases ho : rd.owner = true
  · simp only [ho, if_true]
    have hlast : rd.idx + 1 = (rootForest E rd).cols.length := by
      obtain ⟨F', hF', h'⟩ := hown.1 ho
      rw [hF] at hF'; cases hF'; rw [hidx]; exact h'
    have hlay := rootData_layer_lt hsd hrd ho
    have hδ : holeDepth sd rd = (holeDepth sd rd - 1) + 1 := by unfold holeDepth; omega
    have hR' := hR
    rw [hδ] at hR'
    obtain ⟨lcol, p, H, hlc, hlh, hHR⟩ := hR'
    have hlcol : lcol = col := by
      rw [List.getLast?_eq_getElem?, ← hlast, Nat.add_sub_cancel, hcolF] at hlc
      exact (Option.some.inj hlc).symm
    subst hlcol
    have hU : unconsumed E rd ≠ [] := hkd ho
    have hUl : (unconsumed E rd).getLast? = some (p, H) := by
      unfold unconsumed rootCol
      rw [hcol, Option.getD_some, List.getLast?_drop, if_neg, hlh]
      intro hle
      apply hU
      unfold unconsumed rootCol
      rw [hcol, Option.getD_some]
      exact List.drop_eq_nil_of_le hle
    simp only [mapLast_eq, hUl, Option.map_some, Option.toList_some, word, wordAt, wordCols,
      List.append_nil, ← List.append_assoc, ker_shift_empty,
      replaceAt_eq_shift sd.r (period sd)]
    rw [wordCol_snoc, wordCol_snoc 0 _ _ (replaceAt 0 0 Tree.empty _ _),
      ker_wordAt_replaceAt _ _ _ _ (ker_route_shift hHR),
      show 0 + 1 + (holeDepth sd rd - 1) = holeDepth sd rd by omega]
    simp only [List.append_assoc]
  · simp only [ho, Bool.false_eq_true, if_false]
    have hlt : rd.idx + 1 < (rootForest E rd).cols.length := by
      rcases Nat.lt_or_ge (rd.idx + 1) (rootForest E rd).cols.length with h | h
      · exact h
      · exact absurd (hown.2 ⟨_, hF, by rw [← hidx]; omega⟩) ho
    have hRb : KerRoute (holeDepth sd rd) (Tree.node ((rootForest E rd).cols.drop (rd.idx + 1))) := by
      cases hδ : holeDepth sd rd with
      | zero =>
        show (rootForest E rd).cols.drop (rd.idx + 1) ≠ []
        intro h; have := congrArg List.length h; simp at this; omega
      | succ k =>
        rw [hδ] at hR
        obtain ⟨lcol, p, H, hlc, hlh, hHR⟩ := hR
        refine ⟨lcol, p, H, ?_, hlh, hHR⟩
        show ((rootForest E rd).cols.drop (rd.idx + 1)).getLast? = some lcol
        rw [List.getLast?_drop, if_neg (by omega), hlc]
    simp only [word, wordAt, wordCols, ker_wordCols_cols, ker_shift_empty,
      replaceAt_eq_shift sd.r (period sd)]
    rw [ker_wordAt_replaceAt _ _ _ 0 (ker_route_shift hRb), Nat.zero_add, List.append_assoc]

-- D3.3b: `|P| > 0` and `Σ` is an order embedding
theorem kerPrefix_ne_nil (E : Forest) (sd : StopData) (rd : RootData) : kerPrefix E sd rd ≠ [] := by
  have hcol : ∀ (c : Column) (cs : List Column), word (Tree.node (c :: cs)) ≠ [] := by
    intro c cs
    simp only [word, wordAt, wordCols]
    cases c with
    | nil => simp [wordCol]
    | cons x xs => obtain ⟨p, h⟩ := x; simp [wordCol]
  unfold kerPrefix kernel
  split
  · exact hcol _ _
  · exact hcol _ _

/-- D3.3b helper: `shiftVal` is strictly increasing. -/
theorem ker_shiftVal_strictMono (r d : Nat) : StrictMono (shiftVal r d) := by
  intro p q h
  unfold shiftVal
  split_ifs <;> omega

theorem kerSigma_strictMono (sd : StopData) (rd : RootData) : StrictMono (kerSigma sd rd) := by
  intro A B h
  unfold kerSigma
  rw [Prod.Lex.lt_iff] at h ⊢
  rw [Prod.Lex.lt_iff] at h
  simp only [ofLex_toLex]
  rw [Prod.Lex.toLex_lt_toLex]
  rcases h with h | ⟨h1, h | ⟨h2, h3⟩⟩
  · left; omega
  · right; exact ⟨by omega, Or.inl h⟩
  · right
    refine ⟨by omega, Or.inr ⟨h2, ?_⟩⟩
    simp only
    rw [h1, h2]
    split_ifs
    · exact h3
    · exact ker_shiftVal_strictMono _ _ h3

theorem depthShift_strictMono (e : Nat) : StrictMono (depthShift e) := by
  intro A B h
  unfold depthShift
  rw [Prod.Lex.lt_iff] at h ⊢
  simp only [ofLex_toLex]
  rcases h with h | ⟨h1, h2⟩
  · left; omega
  · right; exact ⟨by omega, h2⟩

/-- L3.5: `rt_{ρ,c}(D)`: the root forest suffix from the root column, with the first `c` entries
of that column deleted (the column is retained even if empty). -/
def rootTail (D : Forest) (rd : RootData) (c : Nat) : Forest :=
  .node ((((D.colAt rd.col).getD []).drop c) ::
    ((D.forestAt rd.col.path).getD Tree.empty).cols.drop (rd.idx + 1))

/-- L3.5: `Q ⋄ X` prepends `Q` to the first column of a nonempty `X`. -/
def diamond (Q : Column) (X : Forest) : Forest :=
  match X with
  | .node (c :: cs) => .node ((Q ++ c) :: cs)
  | .node [] => .node []

/-- L3.5: `e_1(X)`: the first column's entries encoded as continuation entries (no marker),
then the remaining columns. -/
def encOne (X : Forest) : List WordAtom :=
  match X with
  | .node (c :: cs) => wordLater 0 c ++ wordCols 0 cs
  | .node [] => []

/-- L3.5: `e_ε(Q)(X)`. -/
def encEps (Q : Column) (X : Forest) : List WordAtom := if Q = [] then word X else encOne X

/-! ### L3.5 helpers: unshifted placements along the route -/

theorem ker_mapLast_cons {β γ : Type} (f g : β → γ) (a : β) {l : List β} (hl : l ≠ []) :
    mapLast f g (a :: l) = f a :: mapLast f g l := by
  cases l with
  | nil => exact absurd rfl hl
  | cons b bs => simp only [mapLast]

/-- L3.5 helper: `mapLast` over an append with a nonempty right part. -/
theorem ker_mapLast_append {β γ : Type} (f g : β → γ) (A B : List β) (hB : B ≠ []) :
    mapLast f g (A ++ B) = A.map f ++ mapLast f g B := by
  induction A with
  | nil => rfl
  | cons a A ih =>
    rw [List.cons_append, ker_mapLast_cons _ _ _ (by simp [hB]), ih]
    rfl

theorem ker_length_mapLast {β γ : Type} (f g : β → γ) :
    ∀ (l : List β), (mapLast f g l).length = l.length
  | [] => by simp [mapLast]
  | [x] => by simp [mapLast]
  | x :: y :: ys => by simp only [mapLast, List.length_cons, ker_length_mapLast f g (y :: ys)]

theorem ker_getLast?_mapLast {β γ : Type} (f g : β → γ) (l : List β) :
    (mapLast f g l).getLast? = l.getLast?.map g := by
  rw [mapLast_eq]
  cases h : l.getLast? with
  | none => simp at h; subst h; simp
  | some x => simp

theorem ker_mapLast_drop {β γ : Type} (f g : β → γ) :
    ∀ (l : List β) (c : Nat), (mapLast f g l).drop c = mapLast f g (l.drop c)
  | [], c => by simp [mapLast]
  | l, 0 => rfl
  | [x], c + 1 => by simp [mapLast]
  | x :: y :: ys, c + 1 => by
    rw [mapLast, List.drop_succ_cons, List.drop_succ_cons, ker_mapLast_drop f g (y :: ys) c]

theorem ker_mapLast_congr {β γ : Type} {f f' g g' : β → γ} :
    ∀ (l : List β), (∀ x ∈ l, f x = f' x) → (∀ x ∈ l, g x = g' x) →
      mapLast f g l = mapLast f' g' l
  | [], _, _ => by simp [mapLast]
  | [x], _, hg => by simp only [mapLast]; rw [hg x (by simp)]
  | x :: y :: ys, hf, hg => by
    simp only [mapLast]
    rw [hf x (by simp), ker_mapLast_congr (y :: ys) (fun z hz => hf z (by simp [hz]))
      (fun z hz => hg z (by simp [hz]))]

/-- L3.5 helper: the unshifted placement at depth `m + 1` in list form. -/
theorem ker_replaceAt_zero_succ (Y : Forest) (m : Nat) (cols : List Column) :
    replaceAt 0 0 Y (m + 1) (Tree.node cols) =
      Tree.node (mapLast id (mapLast id (fun x : Nat × Forest => (x.1, replaceAt 0 0 Y m x.2)))
        cols) := by
  simp only [replaceAt]
  rw [shiftVal_zero_fun, treeMapCol_id_fun]
  have h1 : (fun x : Nat × Forest => match x with | (p, h) => (id p, Tree.map id h)) = id := by
    funext x; obtain ⟨p, h⟩ := x; simp [treeMap_id]
  have h2 : (fun x : Nat × Forest => match x with | (p, h) => (id p, replaceAt 0 0 Y m h)) =
      (fun x : Nat × Forest => (x.1, replaceAt 0 0 Y m x.2)) := by
    funext x; obtain ⟨p, h⟩ := x; rfl
  rw [h1, h2]

/-- L3.5 helper: the unshifted placement at depth `0` of a nonempty forest. -/
theorem ker_replaceAt_zero_zero (Y : Forest) (cols : List Column) (h : cols ≠ []) :
    replaceAt 0 0 Y 0 (Tree.node cols) = Tree.node (cols.dropLast ++ Y.cols) := by
  cases cols with
  | nil => exact absurd rfl h
  | cons c cs =>
    simp only [replaceAt]
    rw [shiftVal_zero_fun, treeMapCol_id_fun, List.map_id]

/-- L3.5 helper: a placement through the last column leaves the first `i` columns alone. -/
theorem ker_replaceAt_split (Y : Forest) (δ : Nat) (cs : List Column) (i : Nat)
    (hi : i < cs.length) :
    (replaceAt 0 0 Y δ (Tree.node cs)).cols =
      cs.take i ++ (replaceAt 0 0 Y δ (Tree.node (cs.drop i))).cols := by
  have hne : cs.drop i ≠ [] := by
    intro h; have := congrArg List.length h; simp at this; omega
  have hcs : cs ≠ [] := by intro h; subst h; simp at hi
  cases δ with
  | zero =>
    rw [ker_replaceAt_zero_zero Y _ hcs, ker_replaceAt_zero_zero Y _ hne]
    simp only [Tree.cols]
    conv_lhs => rw [← List.take_append_drop i cs]
    rw [List.dropLast_append_of_ne_nil hne, List.append_assoc]
  | succ m =>
    rw [ker_replaceAt_zero_succ, ker_replaceAt_zero_succ]
    simp only [Tree.cols]
    conv_lhs => rw [← List.take_append_drop i cs]
    rw [ker_mapLast_append _ _ _ _ hne, List.map_id]

/-- L3.5 helper: the unshifted placement at depth `m + 1` descends along the last step. -/
theorem ker_replaceAt_forestAt_last (Y : Forest) (m : Nat) {G : Forest} {col : Column} {p : Nat}
    {H : Forest} (hc : G.cols.getLast? = some col) (hl : col.getLast? = some (p, H)) :
    (replaceAt 0 0 Y (m + 1) G).forestAt [(G.cols.length - 1, col.length - 1)] =
      some (replaceAt 0 0 Y m H) := by
  obtain ⟨cols⟩ := G
  rw [ker_replaceAt_zero_succ]
  have hlen : (Tree.node cols).cols.length = (Tree.node (mapLast id (mapLast id
      (fun x : Nat × Forest => (x.1, replaceAt 0 0 Y m x.2))) cols)).cols.length := by
    simp only [Tree.cols]; rw [ker_length_mapLast]
  have hlen2 : col.length = (mapLast id (fun x : Nat × Forest => (x.1, replaceAt 0 0 Y m x.2))
      col).length := (ker_length_mapLast _ _ _).symm
  rw [hlen, hlen2]
  apply ker_forestAt_lastStep (p := p)
  · show (mapLast id _ cols).getLast? = _
    rw [ker_getLast?_mapLast]
    simp only [Tree.cols] at hc
    rw [hc]
    rfl
  · rw [ker_getLast?_mapLast, hl]
    rfl

/-- L3.5 helper (fill law along the route): the context places `Y` at depth `ℓ − j` inside the
forest at depth `j` of the stopping route. -/
theorem ker_context_forestAt {K : Forest} {sd : StopData} (hsd : stopData K = some sd)
    (Y : Forest) : ∀ j, j ≤ sd.depth → ∀ G, K.forestAt (sd.col.path.take j) = some G →
      (context K sd Y).forestAt (sd.col.path.take j) = some (replaceAt 0 0 Y (sd.depth - j) G) := by
  obtain ⟨-, hdep, -, hmem, -⟩ := stopData_spec hsd
  obtain ⟨hpath, -⟩ := (Scan.mem_routeCols_iff K sd.col).1 hmem
  intro j
  induction j with
  | zero =>
    intro _ G hG
    simp only [List.take_zero, Tree.forestAt, Option.some.injEq] at hG ⊢
    subst hG
    rfl
  | succ j ih =>
    intro hj G hG
    have hj' : j < sd.col.path.length := by omega
    obtain ⟨G0, hG0, hlast⟩ := hpath j hj'
    have ih' := ih (by omega) G0 hG0
    rw [List.getElem?_eq_getElem hj'] at hlast
    unfold Tree.lastStep? at hlast
    cases hgc : G0.cols.getLast? with
    | none => rw [hgc] at hlast; simp at hlast
    | some col =>
      rw [hgc] at hlast
      simp only [Option.bind_some] at hlast
      split at hlast
      · simp at hlast
      · rename_i hne
        have hstep : sd.col.path[j] = (G0.cols.length - 1, col.length - 1) :=
          (Option.some.inj hlast).symm
        have hcol : col ≠ [] := by simpa using hne
        obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 (List.getLast?_isSome.2 hcol)
        obtain ⟨p, H⟩ := x
        rw [List.take_add_one, List.getElem?_eq_getElem hj', Option.toList_some,
          Tree.forestAt_append, hG0, Option.bind_some, hstep, ker_forestAt_lastStep hgc hx] at hG
        cases hG
        rw [List.take_add_one, List.getElem?_eq_getElem hj', Option.toList_some,
          Tree.forestAt_append, ih', Option.bind_some, hstep,
          show sd.depth - j = (sd.depth - (j + 1)) + 1 by omega]
        exact ker_replaceAt_forestAt_last Y _ hgc hx

/-- L3.5 helper: the root column lies on the stopping route. -/
theorem ker_rootPath {K : Forest} {sd : StopData} {rd : RootData} (hsd : stopData K = some sd)
    (hrd : rootData K = some rd) :
    rd.col.path = sd.col.path.take rd.layer ∧ rd.layer ≤ sd.depth := by
  obtain ⟨-, -, hlay, hpre, -⟩ := rootData_path hsd hrd
  refine ⟨?_, rootData_layer_le hsd hrd⟩
  rw [hlay]; exact List.prefix_iff_eq_take.1 hpre

/-- L3.5 helper: a shift of a column whose outer parents are `< r` shifts only heights. -/
theorem ker_mapCol_fix {r a : Nat} {l : Column} (hl : ∀ x ∈ l, x.1 < r) :
    Tree.mapCol (shiftVal r a) l = l.map fun x => (x.1, shift r a x.2) := by
  rw [treeMapCol_eq_map]
  apply List.map_congr_left
  intro x hx
  have := hl x hx
  rw [show shiftVal r a x.1 = x.1 by unfold shiftVal; rw [if_neg (by omega)]]
  rfl

-- provides: U2, L3.5 (1) (txt:438-447): the filling identity, with frozen cursor
theorem filling_identity {K : Forest} {sd : StopData} {rd : RootData} (hV : CondV K)
    (hsd : stopData K = some sd) (hrd : rootData K = some rd) (Y : Forest) :
    kernel K sd rd Y = diamond sd.Q (shift sd.r (period sd) (rootTail (context K sd Y) rd rd.cursor)) := by
  obtain ⟨hF, -⟩ := ker_route_rootForest hsd hrd
  obtain ⟨hpath, hle⟩ := ker_rootPath hsd hrd
  have hC : (context K sd Y).forestAt rd.col.path =
      some (replaceAt 0 0 Y (holeDepth sd rd) (rootForest K rd)) := by
    rw [hpath] at hF ⊢
    rw [ker_context_forestAt hsd Y rd.layer hle _ hF]
    rfl
  have hUlt := ker_unconsumed_lt hV hsd hrd
  obtain ⟨-, -, hidx, -, -, hmem, -, hown⟩ := rootData_spec hsd hrd
  obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff K rd.col).1 hmem)
  have hcolF : (rootForest K rd).cols[rd.idx]? = some col := by
    unfold Tree.colAt at hcol; rw [hF, Option.bind_some, ← hidx] at hcol; exact hcol
  have hidxlt : rd.idx < (rootForest K rd).cols.length := by
    by_contra h; rw [List.getElem?_eq_none (by omega)] at hcolF; cases hcolF
  have hU : unconsumed K rd = col.drop rd.cursor := by
    unfold unconsumed rootCol; rw [hcol]; rfl
  unfold rootTail kernel
  simp only [Tree.colAt, hC, Option.bind_some, Option.getD_some, ← hidx]
  rcases hFF : rootForest K rd with ⟨cs⟩
  rw [hFF] at hcolF hidxlt
  simp only [Tree.cols] at hcolF hidxlt
  by_cases ho : rd.owner = true
  · simp only [ho, if_true]
    have hlast : rd.idx + 1 = cs.length := by
      obtain ⟨F', hF', h'⟩ := hown.1 ho
      rw [hF, hFF] at hF'; cases hF'; rw [hidx]; exact h'
    have hlay := rootData_layer_lt hsd hrd ho
    obtain ⟨m, hm⟩ : ∃ m, holeDepth sd rd = m + 1 := ⟨holeDepth sd rd - 1, by unfold holeDepth; omega⟩
    rw [hm, ker_replaceAt_zero_succ, Nat.add_sub_cancel]
    simp only [Tree.cols]
    have hcsl : cs.getLast? = some col := by
      rw [List.getLast?_eq_getElem?, ← hlast, Nat.add_sub_cancel, hcolF]
    have hA : (mapLast id (mapLast id (fun x : Nat × Forest => (x.1, replaceAt 0 0 Y m x.2))) cs)[rd.idx]? =
        some (mapLast id (fun x : Nat × Forest => (x.1, replaceAt 0 0 Y m x.2)) col) := by
      rw [show rd.idx = (mapLast id (mapLast id (fun x : Nat × Forest =>
          (x.1, replaceAt 0 0 Y m x.2))) cs).length - 1 by rw [ker_length_mapLast]; omega,
        ← List.getLast?_eq_getElem?, ker_getLast?_mapLast, hcsl]
      rfl
    have hB : (mapLast id (mapLast id (fun x : Nat × Forest => (x.1, replaceAt 0 0 Y m x.2))) cs).drop
        (rd.idx + 1) = [] := List.drop_eq_nil_of_le (by rw [ker_length_mapLast]; omega)
    rw [hA, Option.getD_some, hB, ker_mapLast_drop, ← hU, ker_shift_node, List.map_cons,
      List.map_nil]
    simp only [diamond]
    congr 3
    rw [treeMapCol_eq_map, map_mapLast]
    apply ker_mapLast_congr
    · intro x hx
      simp only [Function.comp, id]
      rw [show shiftVal sd.r (period sd) x.1 = x.1 by
        have := hUlt x hx; unfold shiftVal; rw [if_neg (by omega)]]
      rfl
    · intro x hx
      simp only [Function.comp]
      rw [show shiftVal sd.r (period sd) x.1 = x.1 by
        have := hUlt x hx; unfold shiftVal; rw [if_neg (by omega)]]
      congr 1
      exact (shift_replaceAt _ _ _ _ _).symm
  · simp only [ho, Bool.false_eq_true, if_false]
    have hlt : rd.idx + 1 < cs.length := by
      rcases Nat.lt_or_ge (rd.idx + 1) cs.length with h | h
      · exact h
      · exact absurd (hown.2 ⟨_, hF, by rw [hFF, ← hidx]; simp only [Tree.cols]; omega⟩) ho
    have hsplit := ker_replaceAt_split Y (holeDepth sd rd) cs (rd.idx + 1) hlt
    have hA : (replaceAt 0 0 Y (holeDepth sd rd) (Tree.node cs)).cols[rd.idx]? = some col := by
      rw [hsplit, List.getElem?_append_left (by simp; omega), List.getElem?_take_of_lt (by omega),
        hcolF]
    have hB : (replaceAt 0 0 Y (holeDepth sd rd) (Tree.node cs)).cols.drop (rd.idx + 1) =
        (replaceAt 0 0 Y (holeDepth sd rd) (Tree.node (cs.drop (rd.idx + 1)))).cols := by
      rw [hsplit, List.drop_append_of_le_length (by simp; omega),
        List.drop_eq_nil_of_le (by simp), List.nil_append]
    rw [hA, Option.getD_some, hB, ← hU, ker_shift_node, List.map_cons]
    simp only [diamond]
    rw [ker_mapCol_fix hUlt, ← ker_map_cols]
    congr 3
    simp only [Tree.cols]
    exact (shift_replaceAt _ _ _ _ _).symm

-- L3.5 (2) (txt:448-458): cancellation of a prefix `Q`
/-- L3.5 helper: the continuation word of a column splits over an append. -/
theorem ker_wordLater_append (e : Nat) (l₁ l₂ : Column) :
    wordLater e (l₁ ++ l₂) = wordLater e l₁ ++ wordLater e l₂ := by
  induction l₁ with
  | nil => rfl
  | cons x l ih =>
    obtain ⟨p, h⟩ := x
    simp only [List.cons_append, wordLater, ih, List.append_assoc]

theorem cancel_eq (Q : Column) {X : Forest} (hX : X ≠ Tree.empty) :
    word (diamond Q X) = (if Q = [] then [] else word (.node [Q])) ++ encEps Q X := by
  obtain ⟨cols⟩ := X
  cases cols with
  | nil => exact absurd rfl hX
  | cons c cs =>
    unfold encEps
    cases Q with
    | nil => simp [diamond]
    | cons q qs =>
      obtain ⟨p, h⟩ := q
      simp only [diamond, encOne, reduceCtorEq, if_false, word, wordAt, wordCols, List.cons_append,
        wordCol, ker_wordLater_append, List.append_nil, List.append_assoc]

/-- L3.5 helper: a common prefix cancels in the list order. -/
theorem ker_append_lt_append_iff {α : Type} [LinearOrder α] (P a b : List α) :
    P ++ a < P ++ b ↔ a < b := by
  induction P with
  | nil => rfl
  | cons x P ih =>
    rw [List.cons_append, List.cons_append, List.cons_lt_cons_iff, ih]
    simp

-- L3.5 (2): comparisons after deleting the same nonempty prefix
theorem diamond_lt_iff {Q : Column} (hQ : Q ≠ []) {X X' : Forest} (hX : X ≠ Tree.empty)
    (hX' : X' ≠ Tree.empty) : diamond Q X < diamond Q X' ↔ encOne X < encOne X' := by
  rw [← word_lt_iff, cancel_eq Q hX, cancel_eq Q hX']
  unfold encEps
  rw [if_neg hQ, if_neg hQ, if_neg hQ, ker_append_lt_append_iff]

-- L3.5c (txt:476-478, 579-580): root restriction preserves proper word extension when the cut of
-- the shorter filling lies after the start of the retained root entry
-- C5 (statement change): `hidx : rd.idx = rd.col.col` added. `rootTail` drops the columns up to
-- `rd.idx`, so for an arbitrary `rd` the later columns of the root forest can be lost and the
-- inequality fails. Counterexample (checked by `#eval`): `D₂ = [[],[],[]]`,
-- `rd.col = ⟨[], 0⟩`, `rd.idx = 5`, `γ = 0`, `π = 2`: `capPos D₂ rd.col 0 = 0 < 2 < 3 = µ(D₂)`,
-- `hlast` holds (depth `0`), and both root tails are `[[]]`. Every `rd` from `rootData` has
-- `rd.idx = rd.col.col` (`rootData_spec`).
theorem rootTail_extension {D₁ D₂ : Forest} {rd : RootData} {γ π : Nat}
    (hidx : rd.idx = rd.col.col)
    (hD : D₁ = safePrefix D₂ π) (hπ : π < mu D₂) (hcol : rd.col ∈ D₂.colAddrs)
    (hγ : capPos D₂ rd.col γ < π)
    (hlast : ∀ y ∈ (word D₂).drop (capPos D₂ rd.col γ), 2 * colDepth rd.col ≤ (ofLex y).1)
    (Q : Column) (ρ δ : Nat) :
    diamond Q (shift ρ δ (rootTail D₁ rd γ)) < diamond Q (shift ρ δ (rootTail D₂ rd γ)) := by
  sorry

/-- D3.3c: kernel success at a target suffix `Y`. -/
def Success (K Y : Forest) : Prop :=
  ∃ sd rd, stopData K = some sd ∧ rootData K = some rd ∧ KernelDefined K rd ∧
    Y < kernel K sd rd Y

/-- D3.3c: some approximant of `K` strictly exceeds `B`. -/
def Covers (K B : Forest) : Prop := ∃ q K', expand K q = some K' ∧ B < K'

/-- D3.3c helper (= T3.2h `shiftVal_conj`, stated here for use before it): phase conjugacy of
root shifts. -/
theorem ker_shiftVal_conj {r ρ' δ d : Nat} (hr : r ≤ ρ') (p : Nat) :
    shiftVal (ρ' + δ) d (shiftVal r δ p) = shiftVal r δ (shiftVal ρ' d p) := by
  unfold shiftVal
  split_ifs <;> omega

-- D3.3c: kernel conjugacy under a phase shift (txt:542-546, 547-552)
theorem kernel_conj {K K' : Forest} {sd sd' : StopData} {rd rd' : RootData} {r δ : Nat}
    (hr : r ≤ sd'.r) (hQ : sd.Q = Tree.mapCol (shiftVal r δ) sd'.Q) (hρ : sd.r = sd'.r + δ)
    (ht : sd.t = sd'.t + δ) (hU : unconsumed K rd = Tree.mapCol (shiftVal r δ) (unconsumed K' rd'))
    (howner : rd.owner = rd'.owner) (hhole : holeDepth sd rd = holeDepth sd' rd')
    (hbody : Tree.node ((rootForest K rd).cols.drop (rd.idx + 1)) =
      shift r δ (.node ((rootForest K' rd').cols.drop (rd'.idx + 1))))
    (X : Forest) : kernel K sd rd (shift r δ X) = shift r δ (kernel K' sd' rd' X) := by
  have hd : period sd = period sd' := by unfold period; omega
  have hconj : ∀ F : Forest,
      shift sd.r (period sd) (shift r δ F) = shift r δ (shift sd'.r (period sd') F) := by
    intro F
    rw [hd, hρ]
    unfold shift
    rw [treeMap_map, treeMap_map]
    congr 1
    funext p
    exact ker_shiftVal_conj hr p
  have hrep : ∀ k (Z G : Forest), shift r δ (replaceAt sd'.r (period sd') Z k G) =
      replaceAt sd.r (period sd) (shift r δ Z) k (shift r δ G) := by
    intro k Z G
    rw [replaceAt_eq_shift sd'.r, shift_replaceAt, replaceAt_eq_shift r δ,
      replaceAt_eq_shift sd.r, hconj]
  have hent : ∀ x : Nat × Forest,
      (shiftVal r δ x.1, shift sd.r (period sd) (Tree.map (shiftVal r δ) x.2)) =
        (shiftVal r δ x.1, Tree.map (shiftVal r δ) (shift sd'.r (period sd') x.2)) := by
    intro x
    show (_, shift sd.r (period sd) (shift r δ x.2)) = (_, shift r δ (shift sd'.r (period sd') x.2))
    rw [hconj]
  unfold kernel
  simp only []
  rw [howner, hhole, hU, hQ, hbody]
  by_cases ho : rd'.owner = true
  · simp only [ho, if_true]
    rw [ker_shift_node, List.map_cons, List.map_nil, ker_mapCol_append]
    congr 3
    rw [treeMapCol_eq_map, treeMapCol_eq_map, mapLast_map, map_mapLast]
    congr 1
    · funext x; exact hent x
    · funext x
      simp only [Function.comp]
      congr 1
      show replaceAt _ _ _ _ (shift r δ x.2) = shift r δ (replaceAt _ _ _ _ x.2)
      rw [hrep, hconj]
  · simp only [ho, Bool.false_eq_true, if_false]
    conv_rhs => rw [ker_shift_node, List.map_cons, ker_mapCol_append]
    congr 2
    · simp only [treeMapCol_eq_map, List.map_map]
      congr 1
      apply List.map_congr_left
      intro x _
      exact hent x
    · rw [← ker_map_cols]
      show (replaceAt _ _ _ _ _).cols = (shift r δ (replaceAt _ _ _ _ _)).cols
      rw [hrep, hconj]

/-! ### Helpers shared by T3.2i, T3.2l, T3.8: outputs as contexts, fill laws off the route -/

/-- helper: an ordinary output is the context of the `n`-th kernel iterate (the kernel is
defined whenever `n ≥ 1` and the output exists). -/
theorem ker_expand_out {A A' : Forest} {sd : StopData} {rd : RootData} {n : Nat} (hV : CondV A)
    (hI : CondI A) (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) (hA' : expand A n = some A') :
    A' = context A sd ((kernel A sd rd)^[n] Tree.empty) ∧ (1 ≤ n → KernelDefined A rd) := by
  have hE : A ≠ Tree.empty := by
    intro h; subst h
    simp [stopData, stopDataBody, stopF, stopCols, Tree.empty] at hsd
  by_cases hkd : KernelDefined A rd
  · rw [expand_eq_iterate hE hV hI hk hsd hrd hkd] at hA'
    exact ⟨(Option.some.inj hA').symm, fun _ => hkd⟩
  · rcases Nat.eq_zero_or_pos n with rfl | hn
    · rw [expand_zero_eq_context hE hV hI hk hsd] at hA'
      exact ⟨(Option.some.inj hA').symm, fun h => absurd h (by omega)⟩
    · have := (expand_none_iff hE hV hI hk hsd hrd n).2 ⟨hn, hkd⟩
      rw [this] at hA'; cases hA'

/-- helper: the path trichotomy (prefix, extension, divergence). -/
theorem ker_path_cases : ∀ (σ π : List (Nat × Nat)),
    σ <+: π ∨ (∃ x rest, σ = π ++ x :: rest) ∨
      ∃ j, j < σ.length ∧ j < π.length ∧ σ.take j = π.take j ∧ σ[j]? ≠ π[j]?
  | [], _ => Or.inl List.nil_prefix
  | x :: σ, [] => Or.inr (Or.inl ⟨x, σ, rfl⟩)
  | x :: σ, y :: π => by
    by_cases hxy : x = y
    · subst hxy
      rcases ker_path_cases σ π with h | ⟨z, rest, h⟩ | ⟨j, h1, h2, h3, h4⟩
      · exact Or.inl ((List.prefix_cons_inj x).2 h)
      · exact Or.inr (Or.inl ⟨z, rest, by rw [h]; rfl⟩)
      · refine Or.inr (Or.inr ⟨j + 1, by simp; omega, by simp; omega, ?_, by simpa using h4⟩)
        simp [h3]
    · exact Or.inr (Or.inr ⟨0, by simp, by simp, rfl, by simpa using hxy⟩)

theorem ker_mapLast_getElem?_lt {β γ : Type} (f g : β → γ) :
    ∀ {l : List β} {i : Nat}, i + 1 < l.length → (mapLast f g l)[i]? = l[i]?.map f
  | [], _, h => by simp at h
  | [_], _, h => by simp at h
  | x :: y :: ys, 0, _ => by simp [mapLast]
  | x :: y :: ys, i + 1, h => by
    simp only [mapLast, List.getElem?_cons_succ]
    exact ker_mapLast_getElem?_lt f g (l := y :: ys) (by simp at h ⊢; omega)

theorem ker_mapLast_getElem?_ge {β γ : Type} (f g : β → γ) {l : List β} {i : Nat}
    (h : l.length ≤ i) : (mapLast f g l)[i]? = none :=
  List.getElem?_eq_none (by rw [ker_length_mapLast]; exact h)

theorem ker_mapLast_getElem?_last {β γ : Type} (f g : β → γ) (l : List β) :
    (mapLast f g l)[l.length - 1]? = l.getLast?.map g := by
  rw [← ker_length_mapLast f g l, ← List.getLast?_eq_getElem?, ker_getLast?_mapLast]

/-- helper: off the last step, an unshifted placement at depth `m + 1` leaves entries alone. -/
theorem ker_replaceAt_step_other (Y : Forest) (m : Nat) {G : Forest} {col : Column}
    (hc : G.cols.getLast? = some col) (c' e' : Nat)
    (hne : (c', e') ≠ (G.cols.length - 1, col.length - 1)) :
    ((replaceAt 0 0 Y (m + 1) G).cols[c']?).bind (·[e']?) = (G.cols[c']?).bind (·[e']?) := by
  obtain ⟨cols⟩ := G
  rw [ker_replaceAt_zero_succ]
  simp only [Tree.cols] at hc hne ⊢
  rcases Nat.lt_or_ge (c' + 1) cols.length with h1 | h1
  · rw [ker_mapLast_getElem?_lt _ _ h1]
    cases cols[c']? <;> rfl
  · rcases Nat.lt_or_ge c' cols.length with h2 | h2
    · have hc' : c' = cols.length - 1 := by omega
      subst hc'
      rw [ker_mapLast_getElem?_last, hc, ← List.getLast?_eq_getElem?, hc]
      simp only [Option.map_some, Option.bind_some]
      have he : e' ≠ col.length - 1 := fun h => hne (by rw [h])
      rcases Nat.lt_or_ge (e' + 1) col.length with h3 | h3
      · rw [ker_mapLast_getElem?_lt _ _ h3]; cases col[e']? <;> rfl
      · rw [ker_mapLast_getElem?_ge _ _ (by omega), List.getElem?_eq_none (by omega)]
    · rw [ker_mapLast_getElem?_ge _ _ h2, List.getElem?_eq_none h2]

/-- helper: the step lookup of `forestAt`. -/
theorem ker_forestAt_cons {α : Type} (T : Tree α) (c e : Nat) (rest : List (Nat × Nat)) :
    T.forestAt ((c, e) :: rest) = ((T.cols[c]?).bind (·[e]?)).bind fun x => x.2.forestAt rest := by
  simp only [Tree.forestAt]
  cases (T.cols[c]?).bind (·[e]?) with
  | none => rfl
  | some x => rfl

/-- helper (fill law off the route): a path that leaves the stopping route above the stopping
forest reads the same forest in every context. -/
theorem ker_context_forestAt_diverge {K : Forest} {sd : StopData} (hsd : stopData K = some sd)
    (Y : Forest) {σ : List (Nat × Nat)} {j : Nat} (hj : j < sd.col.path.length)
    (hjσ : j < σ.length) (htake : σ.take j = sd.col.path.take j)
    (hne : σ[j]? ≠ sd.col.path[j]?) :
    (context K sd Y).forestAt σ = K.forestAt σ := by
  obtain ⟨-, hdep, -, hmem, -⟩ := stopData_spec hsd
  obtain ⟨hpath, -⟩ := (Scan.mem_routeCols_iff K sd.col).1 hmem
  obtain ⟨G0, hG0, hlast⟩ := hpath j hj
  have hC := ker_context_forestAt hsd Y j (by omega) G0 hG0
  rw [List.getElem?_eq_getElem hj] at hlast hne
  unfold Tree.lastStep? at hlast
  cases hgc : G0.cols.getLast? with
  | none => rw [hgc] at hlast; simp at hlast
  | some col =>
    rw [hgc] at hlast
    simp only [Option.bind_some] at hlast
    split at hlast
    · simp at hlast
    · have hstep : sd.col.path[j] = (G0.cols.length - 1, col.length - 1) :=
        (Option.some.inj hlast).symm
      have hσ : σ = σ.take j ++ σ[j] :: σ.drop (j + 1) := by
        rw [← List.drop_eq_getElem_cons hjσ, List.take_append_drop]
      have hσj : σ[j]? = some σ[j] := List.getElem?_eq_getElem hjσ
      rw [hσ, Tree.forestAt_append, Tree.forestAt_append, htake, hC, hG0, Option.bind_some,
        Option.bind_some]
      rcases hx : σ[j] with ⟨c', e'⟩
      have hne' : (c', e') ≠ (G0.cols.length - 1, col.length - 1) := by
        rw [← hstep, ← hx]; intro h; exact hne (by rw [hσj, h])
      rw [ker_forestAt_cons, ker_forestAt_cons, show sd.depth - j = (sd.depth - j - 1) + 1 by omega,
        ker_replaceAt_step_other Y _ hgc c' e' hne']

/-- helper: the stopping forest of `K` and its last column. -/
theorem ker_stopForest {K : Forest} {sd : StopData} (hsd : stopData K = some sd) :
    ∃ G, K.forestAt sd.col.path = some G ∧ G.cols.length = sd.col.col + 1 ∧
      G.cols[sd.col.col]? = some (sd.Q ++ [(sd.r, Tree.empty)]) := by
  obtain ⟨hcol, -, -, hmem, -⟩ := stopData_spec hsd
  obtain ⟨-, F, hF, hFlen⟩ := (Scan.mem_routeCols_iff K sd.col).1 hmem
  refine ⟨F, hF, hFlen, ?_⟩
  unfold Tree.colAt at hcol
  rw [hF, Option.bind_some] at hcol
  exact hcol

/-- helper (fill law at the stopping forest): an entry of a column before the stopping column,
or a query entry of the stopping column when the filling starts with `Q`, reads the same forest
below it. -/
theorem ker_context_forestAt_stop {K : Forest} {sd : StopData} (hsd : stopData K = some sd)
    (Y : Forest) {c' e' : Nat} (rest : List (Nat × Nat))
    (hce : c' < sd.col.col ∨
      (c' = sd.col.col ∧ e' < sd.Q.length ∧ ∃ V cs, Y = Tree.node ((sd.Q ++ V) :: cs))) :
    (context K sd Y).forestAt (sd.col.path ++ (c', e') :: rest) =
      K.forestAt (sd.col.path ++ (c', e') :: rest) := by
  obtain ⟨G, hG, hGlen, hGc⟩ := ker_stopForest hsd
  obtain ⟨-, hdep, -⟩ := stopData_spec hsd
  have hC := ker_context_forestAt hsd Y sd.depth le_rfl G (by rw [hdep, List.take_length]; exact hG)
  rw [hdep, List.take_length, Nat.sub_self] at hC
  rw [Tree.forestAt_append, Tree.forestAt_append, hC, hG, Option.bind_some, Option.bind_some,
    ker_forestAt_cons, ker_forestAt_cons]
  obtain ⟨cols⟩ := G
  simp only [Tree.cols] at hGlen hGc
  have hne : cols ≠ [] := by intro h; subst h; simp at hGlen
  rw [ker_replaceAt_zero_zero Y cols hne]
  simp only [Tree.cols]
  rcases hce with h | ⟨rfl, he, V, cs, rfl⟩
  · rw [List.getElem?_append_left (by simp; omega), List.getElem?_dropLast, if_pos (by omega)]
  · rw [List.getElem?_append_right (by simp; omega), show sd.col.col - cols.dropLast.length = 0 by
      simp; omega, hGc]
    simp only [List.getElem?_cons_zero, Option.bind_some, List.getElem?_append_left he]

/-- helper: under `∅` the query heights disappear. -/
theorem ker_context_empty_forestAt_stop {K : Forest} {sd : StopData} (hsd : stopData K = some sd)
    (e' : Nat) (rest : List (Nat × Nat)) :
    (context K sd Tree.empty).forestAt (sd.col.path ++ (sd.col.col, e') :: rest) = none := by
  obtain ⟨G, hG, hGlen, hGc⟩ := ker_stopForest hsd
  obtain ⟨-, hdep, -⟩ := stopData_spec hsd
  have hC := ker_context_forestAt hsd Tree.empty sd.depth le_rfl G
    (by rw [hdep, List.take_length]; exact hG)
  rw [hdep, List.take_length, Nat.sub_self] at hC
  rw [Tree.forestAt_append, hC, Option.bind_some, ker_forestAt_cons]
  obtain ⟨cols⟩ := G
  simp only [Tree.cols] at hGlen hGc
  have hne : cols ≠ [] := by intro h; subst h; simp at hGlen
  rw [ker_replaceAt_zero_zero _ cols hne]
  simp only [Tree.cols, Tree.empty, List.append_nil]
  rw [List.getElem?_dropLast, if_neg (by omega)]
  rfl

/-- helper: the route of a forest reaches a given column at depth `k`. -/
def KerRouteTo : Nat → Forest → Column → Prop
  | 0, F, X => F.cols.getLast? = some X
  | k + 1, F, X => ∃ col p H, F.cols.getLast? = some col ∧ col.getLast? = some (p, H) ∧
      KerRouteTo k H X

theorem ker_routeTo_route : ∀ (k : Nat) (F : Forest) (X : Column), KerRouteTo k F X → KerRoute k F
  | 0, F, X, h => by
    show F.cols ≠ []
    intro h'; unfold KerRouteTo at h; rw [h'] at h; cases h
  | k + 1, F, X, ⟨col, p, H, h1, h2, h3⟩ => ⟨col, p, H, h1, h2, ker_routeTo_route k H X h3⟩

/-- helper: filling the end of a route with its own last column changes nothing. -/
theorem ker_replaceAt_self :
    ∀ (k : Nat) (F : Forest) (X : Column), KerRouteTo k F X →
      replaceAt 0 0 (Tree.node [X]) k F = F
  | 0, .node cols, X, h => by
    have hne : cols ≠ [] := by intro h'; subst h'; cases h
    rw [ker_replaceAt_zero_zero _ cols hne]
    simp only [Tree.cols]
    have hX : X = cols.getLast hne := by
      unfold KerRouteTo at h; simp only [Tree.cols] at h
      rw [List.getLast?_eq_some_getLast hne] at h; exact (Option.some.inj h).symm
    rw [hX, List.dropLast_concat_getLast]
  | k + 1, .node cols, X, ⟨col, p, H, h1, h2, h3⟩ => by
    rw [ker_replaceAt_zero_succ]
    simp only [Tree.cols] at h1
    have hcol : mapLast id (fun x : Nat × Forest => (x.1, replaceAt 0 0 (Tree.node [X]) k x.2)) col
        = col := by
      have hne : col ≠ [] := by intro h'; subst h'; cases h2
      rw [mapLast_eq, h2, List.map_id]
      simp only [Option.map_some, Option.toList_some, ker_replaceAt_self k H X h3]
      have : (p, H) = col.getLast hne := by
        rw [List.getLast?_eq_some_getLast hne] at h2; exact (Option.some.inj h2).symm
      rw [this, List.dropLast_concat_getLast]
    have hne : cols ≠ [] := by intro h'; subst h'; cases h1
    rw [mapLast_eq, h1, List.map_id]
    simp only [Option.map_some, Option.toList_some, hcol]
    have : col = cols.getLast hne := by
      rw [List.getLast?_eq_some_getLast hne] at h1; exact (Option.some.inj h1).symm
    rw [this, List.dropLast_concat_getLast]

theorem ker_routeTo_drop (k : Nat) (cs : List Column) (X : Column) (i : Nat) (hi : i < cs.length)
    (h : KerRouteTo k (Tree.node cs) X) : KerRouteTo k (Tree.node (cs.drop i)) X := by
  cases k with
  | zero =>
    unfold KerRouteTo at h ⊢; simp only [Tree.cols] at h ⊢
    rw [List.getLast?_drop, if_neg (by omega), h]
  | succ k =>
    obtain ⟨col, p, H, h1, h2, h3⟩ := h
    refine ⟨col, p, H, ?_, h2, h3⟩
    simp only [Tree.cols] at h1 ⊢
    rw [List.getLast?_drop, if_neg (by omega), h1]

/-- helper: along the stopping route the forest at depth `j` routes to the stopping column. -/
theorem ker_routeTo_of_stop {E : Forest} {sd : StopData} (hsd : stopData E = some sd) :
    ∀ j, j ≤ sd.depth →
      ∃ G, E.forestAt (sd.col.path.take j) = some G ∧
        KerRouteTo (sd.depth - j) G (sd.Q ++ [(sd.r, Tree.empty)]) := by
  obtain ⟨-, hdep, -, hmem, -⟩ := stopData_spec hsd
  obtain ⟨hpath, -⟩ := (Scan.mem_routeCols_iff E sd.col).1 hmem
  obtain ⟨F, hF, hFlen, hFc⟩ := ker_stopForest hsd
  suffices h : ∀ m j, j + m = sd.col.path.length →
      ∃ G, E.forestAt (sd.col.path.take j) = some G ∧
        KerRouteTo m G (sd.Q ++ [(sd.r, Tree.empty)]) by
    intro j hj
    exact h (sd.depth - j) j (by omega)
  intro m
  induction m with
  | zero =>
    intro j hj
    refine ⟨F, ?_, ?_⟩
    · rw [List.take_of_length_le (by omega)]; exact hF
    · show F.cols.getLast? = _
      rw [List.getLast?_eq_getElem?, hFlen, Nat.add_sub_cancel, hFc]
  | succ m ih =>
    intro j hj
    obtain ⟨H, hH, hHr⟩ := ih (j + 1) (by omega)
    obtain ⟨G, hG, hlast⟩ := hpath j (by omega)
    refine ⟨G, hG, ?_⟩
    have hj' : j < sd.col.path.length := by omega
    rw [List.getElem?_eq_getElem hj'] at hlast
    unfold Tree.lastStep? at hlast
    cases hgc : G.cols.getLast? with
    | none => rw [hgc] at hlast; simp at hlast
    | some col =>
      rw [hgc] at hlast
      simp only [Option.bind_some] at hlast
      split at hlast
      · simp at hlast
      · rename_i hne
        have hstep : sd.col.path[j] = (G.cols.length - 1, col.length - 1) :=
          (Option.some.inj hlast).symm
        have hcol : col ≠ [] := by simpa using hne
        obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 (List.getLast?_isSome.2 hcol)
        obtain ⟨p, H'⟩ := x
        rw [List.take_add_one, List.getElem?_eq_getElem hj', Option.toList_some,
          Tree.forestAt_append, hG, Option.bind_some, hstep, ker_forestAt_lastStep hgc hx] at hH
        cases hH
        exact ⟨col, p, H, hgc, hx, hHr⟩

/-- helper: a node is the node of its columns. -/
theorem ker_node_cols {α : Type} (T : Tree α) : Tree.node T.cols = T := by cases T; rfl

/-- helper: local suffixes of route columns are placements. For a column `a` whose forest lies
on the stopping route, the local suffix of `K` routes to the stopping column, and the local
suffix of `C_K(Y)` is that suffix with its stopping column replaced by `Y`. -/
theorem ker_localSuffix_prefix {K : Forest} {sd : StopData} (hsd : stopData K = some sd)
    {a : ColAddr} (hpre : a.path <+: sd.col.path) (ha : a ∈ K.colAddrs) :
    KerRouteTo (sd.depth - a.path.length) (localSuffix K a) (sd.Q ++ [(sd.r, Tree.empty)]) ∧
      ∀ Y, localSuffix (context K sd Y) a =
        replaceAt 0 0 Y (sd.depth - a.path.length) (localSuffix K a) := by
  obtain ⟨-, hdep, -⟩ := stopData_spec hsd
  have hlen : a.path.length ≤ sd.depth := by rw [hdep]; exact hpre.length_le
  have hpa : a.path = sd.col.path.take a.path.length := List.prefix_iff_eq_take.1 hpre
  obtain ⟨G, hG, hR⟩ := ker_routeTo_of_stop hsd a.path.length hlen
  rw [← hpa] at hG
  obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff K a).1 ha)
  unfold Tree.colAt at hcol
  rw [hG, Option.bind_some] at hcol
  obtain ⟨cs⟩ := G
  have hac : a.col < cs.length := by
    by_contra h; simp only [Tree.cols] at hcol; rw [List.getElem?_eq_none (by omega)] at hcol
    cases hcol
  have hL : localSuffix K a = Tree.node (cs.drop a.col) := by
    unfold localSuffix; rw [hG]; rfl
  refine ⟨hL ▸ ker_routeTo_drop _ cs _ a.col hac hR, ?_⟩
  intro Y
  have hC := ker_context_forestAt hsd Y a.path.length hlen _ (by rw [← hpa]; exact hG)
  rw [← hpa] at hC
  unfold localSuffix
  rw [hC, hG, Option.getD_some, Option.getD_some,
    ker_replaceAt_split Y _ cs a.col hac, List.drop_append_of_le_length (by simp; omega),
    List.drop_eq_nil_of_le (by simp), List.nil_append, ker_node_cols]
  rfl

/-- helper: comparison of columns after a common prefix. -/
theorem ker_cmpCol_append_left :
    ∀ (Q V W : Column), Tree.cmpCol compare (Q ++ V) (Q ++ W) = Tree.cmpCol compare V W
  | [], _, _ => rfl
  | (p, h) :: Q, V, W => by
    simp only [List.cons_append, Tree.cmpCol]
    rw [Tree.cmp_self compare h, ker_cmpCol_append_left Q V W]
    rw [show compare p p = .eq from Nat.compare_eq_eq.2 rfl]
    rfl

/-- helper: the first column of a kernel output is `Q` followed by entries with parents `< r`. -/
theorem ker_kernel_firstCol {K : Forest} {sd : StopData} {rd : RootData}
    (hU : ∀ x ∈ unconsumed K rd, x.1 < sd.r) (X : Forest) :
    ∃ V cs, kernel K sd rd X = Tree.node ((sd.Q ++ V) :: cs) ∧ ∀ v ∈ V.head?, v.1 < sd.r := by
  unfold kernel
  split
  · refine ⟨_, [], rfl, ?_⟩
    intro v hv
    cases hU' : unconsumed K rd with
    | nil => rw [hU'] at hv; simp [mapLast] at hv
    | cons u us =>
      rw [hU'] at hv
      cases us with
      | nil => simp [mapLast] at hv; rw [← hv]; exact hU u (by rw [hU']; simp)
      | cons u' us' => simp [mapLast] at hv; rw [← hv]; exact hU u (by rw [hU']; simp)
  · refine ⟨_, _, rfl, ?_⟩
    intro v hv
    cases hU' : unconsumed K rd with
    | nil => rw [hU'] at hv; simp at hv
    | cons u us => rw [hU'] at hv; simp at hv; rw [← hv]; exact hU u (by rw [hU']; simp)

/-- helper: a kernel output is smaller than the stopping column it replaces. -/
theorem ker_kernel_lt_stop {K : Forest} {sd : StopData} {rd : RootData}
    (hU : ∀ x ∈ unconsumed K rd, x.1 < sd.r) (X : Forest) :
    kernel K sd rd X < Tree.node [sd.Q ++ [(sd.r, Tree.empty)]] := by
  obtain ⟨V, cs, hk, hV⟩ := ker_kernel_firstCol hU X
  rw [hk]
  show Tree.cmp compare _ _ = .lt
  simp only [Tree.cmp, Tree.cmpCols]
  rw [ker_cmpCol_append_left]
  cases V with
  | nil => rfl
  | cons v vs =>
    obtain ⟨p, h⟩ := v
    have hp : p < sd.r := hV _ rfl
    simp only [Tree.cmpCol]
    rw [Nat.compare_eq_lt.2 hp]
    rfl

/-- helper: every kernel iterate is smaller than the stopping column. -/
theorem ker_iterate_lt_stop {K : Forest} {sd : StopData} {rd : RootData}
    (hU : ∀ x ∈ unconsumed K rd, x.1 < sd.r) (n : Nat) :
    (kernel K sd rd)^[n] Tree.empty < Tree.node [sd.Q ++ [(sd.r, Tree.empty)]] := by
  cases n with
  | zero => exact Forest.empty_lt (by simp [Tree.empty])
  | succ n =>
    rw [Function.iterate_succ_apply']
    exact ker_kernel_lt_stop hU _

/-- helper: placing a smaller filling into the same route gives a smaller forest. -/
theorem ker_replaceAt_lt {k : Nat} {L : Forest} (hL : KerRoute k L) {Y Y' : Forest}
    (h : Y < Y') : replaceAt 0 0 Y k L < replaceAt 0 0 Y' k L := by
  rw [← word_lt_iff]
  unfold word
  rw [ker_wordAt_replaceAt Y k L 0 hL, ker_wordAt_replaceAt Y' k L 0 hL,
    ker_append_lt_append_iff, Nat.zero_add, show k = 0 + k by omega, wordAt_add, wordAt_add]
  exact List.map_lt (fun x y hxy => depthShift_strictMono k hxy) ((word_lt_iff Y Y').2 h)


/-! ## §T3.2 — closure -/

/-- T3.2d: the word of a key (U1's generic word at labels `Bool ×ₗ Nat`); positions and length
equal those of the underlying forest's word (`relKey` is a relabelling). -/
def keyWord (K : Key) : List (Nat ×ₗ Nat ×ₗ WithBot (Bool ×ₗ Nat)) :=
  gwordAt 0 (K.map fun x => (toLex x : Bool ×ₗ Nat))

/-- T3.2h (txt:331-336): `κ_j` on key labels: add `j·d` to a false field `(0, p)` with `p ≥ r`. -/
def kappaLabel (r d j : Nat) (x : Bool × Nat) : Bool × Nat :=
  if x.1 = false ∧ r ≤ x.2 then (false, x.2 + j * d) else x

def kappa (r d j : Nat) (K : Key) : Key := K.map (kappaLabel r d j)

/-- T3.2h helper: on false fields `κ_j` is the parent shift `T_{r,jd}`. -/
theorem ker_kappaLabel_false (r d j p : Nat) :
    kappaLabel r d j (false, p) = (false, shiftVal r (j * d) p) := by
  unfold kappaLabel shiftVal
  by_cases h : r ≤ p <;> simp [h]

theorem ker_kappaLabel_true (r d j p : Nat) : kappaLabel r d j (true, p) = (true, p) := by
  unfold kappaLabel; simp

/-- T3.2h helper: shifts preserve `compare`. -/
theorem ker_compare_shiftVal (r d p q : Nat) :
    compare (shiftVal r d p) (shiftVal r d q) = compare p q := by
  rcases Nat.lt_trichotomy p q with h | rfl | h
  · rw [Nat.compare_eq_lt.2 h, Nat.compare_eq_lt.2 (ker_shiftVal_strictMono r d h)]
  · rw [Nat.compare_eq_eq.2 rfl, Nat.compare_eq_eq.2 rfl]
  · rw [Nat.compare_eq_gt.2 h, Nat.compare_eq_gt.2 (ker_shiftVal_strictMono r d h)]

/-- T3.2h helper: `κ_j` preserves the key-label comparison. -/
theorem ker_kappaLabel_cmp (r d j : Nat) (x y : Bool × Nat) :
    keyLabelCmp (kappaLabel r d j x) (kappaLabel r d j y) = keyLabelCmp x y := by
  obtain ⟨a, p⟩ := x
  obtain ⟨b, q⟩ := y
  cases a <;> cases b <;>
    simp only [ker_kappaLabel_false, ker_kappaLabel_true, keyLabelCmp, ker_compare_shiftVal] <;> rfl

-- T3.2h: `h_{x+jd}(τ_j H) = κ_j(h_x(H))` for `x ≥ r`
theorem relKey_shift (r d j x : Nat) (hx : r ≤ x) (H : Forest) :
    relKey (x + j * d) (shift r (j * d) H) = kappa r d j (relKey x H) := by
  unfold relKey shift kappa
  rw [treeMap_map, treeMap_map]
  congr 1
  funext p
  simp only [Function.comp]
  by_cases h1 : p < r
  · have h2 : p < x := by omega
    rw [show shiftVal r (j * d) p = p by unfold shiftVal; rw [if_neg (by omega)],
      if_pos (by omega), if_pos h2, ker_kappaLabel_false]
    unfold shiftVal; rw [if_neg (by omega)]
  · by_cases h2 : p < x
    · rw [show shiftVal r (j * d) p = p + j * d by unfold shiftVal; rw [if_pos (by omega)],
        if_pos (by omega), if_pos h2, ker_kappaLabel_false]
      unfold shiftVal; rw [if_pos (by omega)]
    · rw [show shiftVal r (j * d) p = p + j * d by unfold shiftVal; rw [if_pos (by omega)],
        if_neg (by omega), if_neg h2, ker_kappaLabel_true]
      congr 1; omega

-- T3.2h: `κ_i κ_j = κ_{i+j}`
theorem kappa_add (r d i j : Nat) (K : Key) : kappa r d i (kappa r d j K) = kappa r d (i + j) K := by
  unfold kappa
  rw [treeMap_map]
  congr 1
  funext x
  obtain ⟨b, p⟩ := x
  cases b
  · simp only [Function.comp, ker_kappaLabel_false]
    unfold shiftVal
    by_cases h : r ≤ p
    · rw [if_pos h, if_pos (by omega), if_pos h]; congr 1; rw [Nat.add_mul]; omega
    · rw [if_neg h, if_neg h, if_neg h]
  · simp only [Function.comp, ker_kappaLabel_true]

-- T3.2h: `κ_j` is an order embedding of keys
theorem kappa_strictMono (r d j : Nat) : StrictMono (kappa r d j) := by
  intro K K' h
  show keyCmp (kappa r d j K) (kappa r d j K') = .lt
  unfold keyCmp kappa
  rw [Tree.cmp_map (ker_kappaLabel_cmp r d j)]
  exact h

-- T3.2h: `κ_j` commutes with `ν`
theorem kappa_nu (r d j : Nat) (l : List Key) : nu (l.map (kappa r d j)) = (nu l).map (kappa r d j) := by
  exact nu_map (kappa_strictMono r d j) l

-- T3.2h: keys normalized at or below `r` are fixed
theorem kappa_fix (r d j x : Nat) (hx : x ≤ r) (H : Forest) : kappa r d j (relKey x H) = relKey x H := by
  unfold kappa relKey
  rw [treeMap_map]
  congr 1
  funext p
  simp only [Function.comp]
  by_cases h : p < x
  · rw [if_pos h, ker_kappaLabel_false]
    unfold shiftVal; rw [if_neg (by omega)]
  · rw [if_neg h, ker_kappaLabel_true]

-- T3.2h (3) (txt:572-575): `T_{ρ,x+δ−ρ} = τ_δ ∘ T_{ρ,x−ρ}` for `ρ ≤ r ≤ x`
theorem shiftVal_comp {ρ r x δ : Nat} (hρ : ρ ≤ r) (hx : r ≤ x) (p : Nat) :
    shiftVal ρ (x + δ - ρ) p = shiftVal r δ (shiftVal ρ (x - ρ) p) := by
  unfold shiftVal
  split_ifs <;> omega

-- T3.2h: `T_{ρ'+δ,d} ∘ τ_δ = τ_δ ∘ T_{ρ',d}` for `r ≤ ρ'` (phase conjugacy of root shifts)
theorem shiftVal_conj {r ρ' δ d : Nat} (hr : r ≤ ρ') (p : Nat) :
    shiftVal (ρ' + δ) d (shiftVal r δ p) = shiftVal r δ (shiftVal ρ' d p) :=
  ker_shiftVal_conj hr p

-- T3.2h: shifts are order embeddings of forests
theorem shift_lt_shift (r d : Nat) {X Y : Forest} : shift r d X < shift r d Y ↔ X < Y := by
  show Tree.cmp compare (shift r d X) (shift r d Y) = .lt ↔ Tree.cmp compare X Y = .lt
  unfold shift
  rw [Tree.cmp_map (ker_compare_shiftVal r d)]

/-- T3.2i: placement of an address of a forest `X` whose columns are put at the hole column `h`
(the address-level fill law of `A_{r,d,ℓ,X}` and `C_E(X)`). -/
def underCol (h a : ColAddr) : ColAddr :=
  match a.path with
  | [] => ⟨h.path, h.col + a.col⟩
  | (c0, e0) :: rest => ⟨h.path ++ (h.col + c0, e0) :: rest, a.col⟩

/-- T3.2i: Q-height material: addresses inside the height of an entry `j < |Q|` of the stopping
column. -/
def isQMat (sd : StopData) (a : ColAddr) : Bool :=
  (a.path.take sd.col.path.length == sd.col.path) &&
    match a.path.drop sd.col.path.length with
    | (ci, j) :: _ => ci == sd.col.col && decide (j < sd.Q.length)
    | [] => false

/-- T3.2i: the template map of one period: an address of `A` in the copied region ↦ its address
relative to the kernel output. Q-heights go to the head's first `m` entries; the root column
goes to the head (column 0); restored heights (entries `c + v`) go to head entries `m + v`;
body columns `ι+1+z` go to column `1+z` (body case only). `none` outside the template. -/
def kerCol (sd : StopData) (rd : RootData) (a : ColAddr) : Option ColAddr :=
  let m := sd.Q.length
  if isQMat sd a then
    match a.path.drop sd.col.path.length with
    | (_, j) :: rest => some ⟨(0, j) :: rest, a.col⟩
    | [] => none
  else if a.path.take rd.col.path.length = rd.col.path then
    match a.path.drop rd.col.path.length with
    | (ci, e) :: rest =>
      if ci = rd.idx ∧ rd.cursor ≤ e then some ⟨(0, m + (e - rd.cursor)) :: rest, a.col⟩
      else if rd.idx < ci ∧ rd.owner = false then some ⟨(ci - rd.idx, e) :: rest, a.col⟩
      else none
    | [] =>
      if a.col = rd.idx then some ⟨[], 0⟩
      else if rd.idx < a.col ∧ rd.owner = false then some ⟨[], a.col - rd.idx⟩
      else none
  else none

/-- T3.2i: the hole of the kernel (the image of the stopping column). -/
def kerHole (sd : StopData) (rd : RootData) : ColAddr := (kerCol sd rd sd.col).getD ⟨[], 0⟩

/-- T3.2i: the address in `E[n] = C_E(F^n(∅))` of the phase-`i` copy (`i ≥ 1`, `i`-th kernel
layer from outside) of the template address `a`. -/
def phaseCol (sd : StopData) (rd : RootData) (i : Nat) (a : ColAddr) : Option ColAddr :=
  (kerCol sd rd a).map fun a' => underCol sd.col ((underCol (kerHole sd rd))^[i - 1] a')

/-- T3.2i: the phase of the copy: Q-heights in head `i` have phase `i − 1`, all other template
material in layer `i` has phase `i`. -/
def phaseOff (sd : StopData) (i : Nat) (a : ColAddr) : Nat := if isQMat sd a then i - 1 else i

/-- T3.2i: a template column of `A` (copied region, excluding the root and stopping columns). -/
def IsTmplCol (A : Forest) (sd : StopData) (rd : RootData) (a : ColAddr) : Prop :=
  a ∈ A.colAddrs ∧ a ≠ sd.col ∧ a ≠ rd.col ∧ (kerCol sd rd a).isSome

/-- T3.2i / T3.8: `a` lies in a forest on the route to the stopping column (its local suffix
contains the continuation hole). -/
def OnHoleRoute (sd : StopData) (a : ColAddr) : Prop := a.path <+: sd.col.path

/-! ### T3.2i helpers: numbers of placed addresses -/

theorem ker_num_cons (x : Nat × Nat) (p : List (Nat × Nat)) (c : Nat) :
    ColAddr.num 0 ⟨x :: p, c⟩ = x.1 + 1 + ColAddr.num 0 ⟨p, c⟩ := by
  unfold ColAddr.num; simp; omega

theorem ker_num_append (p q : List (Nat × Nat)) (c : Nat) :
    ColAddr.num 0 ⟨p ++ q, c⟩ = (p.map (·.1 + 1)).sum + ColAddr.num 0 ⟨q, c⟩ := by
  unfold ColAddr.num; simp [List.map_append, List.sum_append]; omega

theorem ker_num_underCol (h a : ColAddr) : (underCol h a).num 0 = h.num 0 + a.num 0 := by
  obtain ⟨p, c⟩ := a
  cases p with
  | nil => simp only [underCol]; unfold ColAddr.num; simp; omega
  | cons x rest =>
    obtain ⟨c0, e0⟩ := x
    simp only [underCol]
    rw [ker_num_append, ker_num_cons]
    unfold ColAddr.num; simp; omega

theorem ker_num_iterate (h : ColAddr) :
    ∀ (k : Nat) (a : ColAddr), ((underCol h)^[k] a).num 0 = k * h.num 0 + a.num 0
  | 0, a => by simp
  | k + 1, a => by
    rw [Function.iterate_succ_apply', ker_num_underCol, ker_num_iterate h k a, Nat.succ_mul]
    omega

/-- T3.2i helper: `kerCol` subtracts `t` (Q-material) or `r` (root-tail material) from numbers. -/
theorem ker_num_kerCol {A : Forest} {sd : StopData} {rd : RootData} (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) {a a' : ColAddr} (h : kerCol sd rd a = some a') :
    a'.num 0 + (if isQMat sd a then sd.t else sd.r) = a.num 0 := by
  obtain ⟨-, -, ht, -⟩ := stopData_spec hsd
  obtain ⟨-, -, hidx, hnum, -⟩ := rootData_spec hsd hrd
  have hsplit : ∀ (l : List (Nat × Nat)) (k : Nat), l = l.take k ++ l.drop k :=
    fun l k => (List.take_append_drop k l).symm
  unfold kerCol at h
  by_cases hq : isQMat sd a = true
  · rw [if_pos hq] at h ⊢
    have hq' := hq
    unfold isQMat at hq'
    rw [Bool.and_eq_true, beq_iff_eq] at hq'
    obtain ⟨h1, h2⟩ := hq'
    cases hd : a.path.drop sd.col.path.length with
    | nil => rw [hd] at h2; cases h2
    | cons x rest =>
      obtain ⟨ci, j⟩ := x
      rw [hd] at h h2
      simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at h2
      simp only [Option.some.injEq] at h
      subst h
      obtain ⟨a1, a2⟩ := a
      simp only at h1 hd h2 ⊢
      have hp := hsplit a1 sd.col.path.length
      rw [h1, hd] at hp
      rw [ht, hp, ker_num_append, ker_num_cons, ker_num_cons, h2.1]
      unfold ColAddr.num; omega
  · rw [if_neg hq] at h ⊢
    simp only [Bool.not_eq_true] at hq
    by_cases hρ : a.path.take rd.col.path.length = rd.col.path
    swap
    · rw [if_neg hρ] at h; cases h
    rw [if_pos hρ] at h
    obtain ⟨a1, a2⟩ := a
    simp only at hρ h ⊢
    have hp := hsplit a1 rd.col.path.length
    rw [hρ] at hp
    rw [← hnum]
    cases hd : a1.drop rd.col.path.length with
    | nil =>
      rw [hd] at h hp
      rw [List.append_nil] at hp
      simp only at h
      split_ifs at h with hc1 hc2
      · simp only [Option.some.injEq] at h; subst h
        rw [hp]; unfold ColAddr.num; simp; omega
      · simp only [Option.some.injEq] at h; subst h
        rw [hp]; unfold ColAddr.num; simp; omega
    | cons x rest =>
      obtain ⟨ci, e⟩ := x
      rw [hd] at h hp
      simp only at h
      split_ifs at h with hc1 hc2
      · simp only [Option.some.injEq] at h; subst h
        rw [hp, ker_num_append, ker_num_cons, ker_num_cons, hc1.1]
        unfold ColAddr.num; simp; omega
      · simp only [Option.some.injEq] at h; subst h
        rw [hp, ker_num_append, ker_num_cons, ker_num_cons]
        unfold ColAddr.num; simp; omega

/-- T3.2i helper: the kernel is defined on `L`. -/
theorem ker_kernelDefined {A : Forest} {sd : StopData} {rd : RootData} (hL : InL A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) : KernelDefined A rd := by
  obtain ⟨hV, -, -, hA, hS⟩ := hL
  intro ho h
  have := owner_root_nonexhaust hV hA hS hsd hrd ho
  unfold unconsumed rootCol at h
  have := congrArg List.length h
  simp at this
  omega

/-- T3.2i helper: where the stopping column lies relative to the root column. -/
theorem ker_stop_path {A : Forest} {sd : StopData} {rd : RootData} (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) (hkd : KernelDefined A rd) :
    (rd.owner = false ∧ ((sd.col.path = rd.col.path ∧ rd.idx < sd.col.col) ∨
        ∃ ci e rest, sd.col.path = rd.col.path ++ (ci, e) :: rest ∧ rd.idx < ci)) ∨
      (rd.owner = true ∧ ∃ e rest, sd.col.path = rd.col.path ++ (rd.idx, e) :: rest ∧
        rd.cursor ≤ e ∧ e + 1 = (rootCol A rd).length) := by
  obtain ⟨-, hnum, hlay, hpre, -, hown, hlen⟩ := rootData_path hsd hrd
  obtain ⟨-, -, hidx, -, hrt, hmem, -⟩ := rootData_spec hsd hrd
  obtain ⟨-, hdep, ht, hrmem, -⟩ := stopData_spec hsd
  obtain ⟨hpath, -⟩ := (Scan.mem_routeCols_iff A sd.col).1 hrmem
  obtain ⟨t, ht'⟩ := hpre
  cases t with
  | nil =>
    rw [List.append_nil] at ht'
    left
    have hown' : rd.owner = false := by
      cases ho : rd.owner
      · rfl
      · exfalso
        have := hown.1 ho
        unfold ColAddr.container at this
        rw [← ht', List.drop_length] at this
        cases this
    refine ⟨hown', Or.inl ⟨ht'.symm, ?_⟩⟩
    rw [hidx]
    have h1 : rd.col.num 0 < sd.col.num 0 := by rw [hnum, ← ht]; exact hrt
    unfold ColAddr.num at h1
    rw [← ht'] at h1
    omega
  | cons x rest =>
    obtain ⟨ci, e⟩ := x
    have hj : rd.col.path.length < sd.col.path.length := by rw [← ht']; simp
    obtain ⟨G, hG, hlast⟩ := hpath rd.col.path.length hj
    have htake : sd.col.path.take rd.col.path.length = rd.col.path := by
      rw [← ht', List.take_left' rfl]
    have hstep : sd.col.path[rd.col.path.length]? = some (ci, e) := by
      rw [← ht', List.getElem?_append_right (le_refl _), Nat.sub_self]; rfl
    rw [htake] at hG
    rw [hstep] at hlast
    -- `ci` is the last column of the root forest
    have hci : ci + 1 = G.cols.length := by
      unfold Tree.lastStep? at hlast
      cases hgc : G.cols.getLast? with
      | none => rw [hgc] at hlast; cases hlast
      | some col =>
        rw [hgc] at hlast
        simp only [Option.bind_some] at hlast
        split at hlast
        · cases hlast
        · simp only [Option.some.injEq, Prod.mk.injEq] at hlast
          have : G.cols.length ≠ 0 := by intro h0; rw [List.length_eq_zero_iff] at h0; rw [h0] at hgc; cases hgc
          omega
    have hidxlt : rd.idx < G.cols.length := by
      obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff A rd.col).1 hmem)
      unfold Tree.colAt at hcol
      rw [hG, Option.bind_some] at hcol
      rw [hidx]
      by_contra h; rw [List.getElem?_eq_none (by omega)] at hcol; cases hcol
    cases ho : rd.owner
    · left
      refine ⟨rfl, Or.inr ⟨ci, e, rest, ht'.symm, ?_⟩⟩
      have hne : ci ≠ rd.idx := by
        intro hc
        have hcont : (rd.col.container sd.col).isSome := by
          unfold ColAddr.container
          rw [← ht', List.drop_left' rfl, List.take_left' rfl]
          simp [hc, hidx]
        rw [← hown] at hcont
        rw [ho] at hcont; cases hcont
      omega
    · right
      have hcont := hown.1 ho
      obtain ⟨en, hen⟩ := Option.isSome_iff_exists.1 hcont
      have hen' := hen
      unfold ColAddr.container at hen'
      rw [← ht', List.drop_left' rfl, List.take_left' rfl] at hen'
      simp only at hen'
      split_ifs at hen' with hc
      simp only [Option.some.injEq] at hen'
      subst hen'
      have hl := hlen _ hen
      unfold Packet.rootLenOf at hl
      refine ⟨rfl, e, rest, ?_, ?_, ?_⟩
      · rw [← ht', hidx, hc.2]
      · have hU : unconsumed A rd ≠ [] := hkd ho
        unfold unconsumed at hU
        have : rd.cursor < (rootCol A rd).length := by
          by_contra h; exact hU (List.drop_eq_nil_of_le (by omega))
        unfold rootCol at this
        simp only at hl
        omega
      · unfold rootCol; simp only at hl; exact hl

/-- T3.2i helper: the hole of the kernel has number `d`. -/
theorem ker_kerCol_stop {A : Forest} {sd : StopData} {rd : RootData} (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) (hkd : KernelDefined A rd) :
    kerCol sd rd sd.col = some (kerHole sd rd) ∧ isQMat sd sd.col = false := by
  have hq : isQMat sd sd.col = false := by
    unfold isQMat
    simp [List.drop_length]
  refine ⟨?_, hq⟩
  have hsome : (kerCol sd rd sd.col).isSome := by
    unfold kerCol
    rw [if_neg (by simp [hq])]
    have hidx := (rootData_spec hsd hrd).2.2.1
    rcases ker_stop_path hsd hrd hkd with ⟨ho, ⟨hp, hlt⟩ | ⟨ci, e, rest, hp, hlt⟩⟩ |
        ⟨ho, e, rest, hp, hle, -⟩
    · rw [hp, List.take_length, if_pos rfl, List.drop_length]
      simp only
      rw [if_neg (by omega), if_pos ⟨hlt, ho⟩]
      rfl
    · rw [hp, List.take_left' rfl, if_pos rfl, List.drop_left' rfl]
      simp only
      rw [if_neg (by omega), if_pos ⟨hlt, ho⟩]
      rfl
    · rw [hp, List.take_left' rfl, if_pos rfl, List.drop_left' rfl]
      simp only
      rw [if_pos (by simp [hle])]
      rfl
  obtain ⟨h, hh⟩ := Option.isSome_iff_exists.1 hsome
  unfold kerHole
  rw [hh]
  rfl

theorem ker_num_kerHole {A : Forest} {sd : StopData} {rd : RootData} (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) (hkd : KernelDefined A rd) :
    (kerHole sd rd).num 0 + sd.r = sd.t := by
  obtain ⟨h1, h2⟩ := ker_kerCol_stop hsd hrd hkd
  have := ker_num_kerCol hsd hrd h1
  rw [h2, if_neg (by simp)] at this
  rw [this]
  exact (stopData_spec hsd).2.2.1.symm

/-! ### T3.2i helpers: placement under a hole -/

/-- T3.2i helper: the route hole of a forest at depth `k` (the last column reached at depth `k`
by following last columns and last entries). -/
def kerHoleAt : Nat → Forest → ColAddr
  | 0, F => ⟨[], F.cols.length - 1⟩
  | k + 1, F =>
    ⟨(F.cols.length - 1, (F.cols.getLast?.getD []).length - 1) ::
        (kerHoleAt k ((((F.cols.getLast?.getD []).getLast?).map Prod.snd).getD Tree.empty)).path,
      (kerHoleAt k ((((F.cols.getLast?.getD []).getLast?).map Prod.snd).getD Tree.empty)).col⟩

theorem ker_kerHoleAt_succ {G : Forest} {col : Column} {p : Nat} {H : Forest}
    (hc : G.cols.getLast? = some col) (hl : col.getLast? = some (p, H)) (k : Nat) :
    kerHoleAt (k + 1) G =
      ⟨(G.cols.length - 1, col.length - 1) :: (kerHoleAt k H).path, (kerHoleAt k H).col⟩ := by
  simp only [kerHoleAt, hc, hl, Option.getD_some, Option.map_some]

theorem ker_kerHoleAt_map (f : Nat → Nat) : ∀ (k : Nat) (G : Forest),
    kerHoleAt k (Tree.map f G) = kerHoleAt k G
  | 0, G => by simp only [kerHoleAt, ker_map_cols, List.length_map]
  | k + 1, G => by
    simp only [kerHoleAt, ker_map_cols, List.length_map, List.getLast?_map]
    cases hc : G.cols.getLast? with
    | none => simp only [Option.map_none, Option.getD_none]
    | some col =>
      simp only [Option.map_some, Option.getD_some]
      rw [treeMapCol_eq_map, List.length_map, List.getLast?_map]
      cases hl : col.getLast? with
      | none => simp only [Option.map_none, Option.getD_none]
      | some x => simp only [Option.map_some, Option.getD_some, ker_kerHoleAt_map f k x.2]

theorem ker_kerHoleAt_shift (r d k : Nat) (G : Forest) :
    kerHoleAt k (shift r d G) = kerHoleAt k G := ker_kerHoleAt_map _ k G

theorem ker_forestAt_cons' {α : Type} (T : Tree α) (x : Nat × Nat) (p : List (Nat × Nat)) :
    T.forestAt (x :: p) = (T.forestAt [x]).bind fun F => F.forestAt p := by
  rw [← Tree.forestAt_append]; rfl

/-- T3.2i helper: the forest of the hole after a placement: the columns before the hole followed by
the filling's columns. -/
theorem ker_hole_forest (Z : Forest) : ∀ (k : Nat) (G : Forest), KerRoute k G →
    ∃ L : List Column, (replaceAt 0 0 Z k G).forestAt (kerHoleAt k G).path =
      some (Tree.node (L ++ Z.cols)) ∧ L.length = (kerHoleAt k G).col
  | 0, .node cols, h => by
    have hne : cols ≠ [] := h
    refine ⟨cols.dropLast, ?_, ?_⟩
    · simp only [kerHoleAt, Tree.forestAt]; rw [ker_replaceAt_zero_zero _ _ hne]
    · simp [kerHoleAt, Tree.cols]
  | k + 1, G, ⟨col, p, H, hc, hl, hk⟩ => by
    obtain ⟨L, hL1, hL2⟩ := ker_hole_forest Z k H hk
    refine ⟨L, ?_, ?_⟩
    · rw [ker_kerHoleAt_succ hc hl, ker_forestAt_cons', ker_replaceAt_forestAt_last Z k hc hl,
        Option.bind_some, hL1]
    · rw [ker_kerHoleAt_succ hc hl]; exact hL2

/-- T3.2i helper (fill law under the hole): columns and local suffixes under the hole of a
placement are those of the filling. -/
theorem ker_hole_law (Z : Forest) {k : Nat} {G : Forest} (hG : KerRoute k G) (y : ColAddr) :
    (replaceAt 0 0 Z k G).colAt (underCol (kerHoleAt k G) y) = Z.colAt y ∧
      localSuffix (replaceAt 0 0 Z k G) (underCol (kerHoleAt k G) y) = localSuffix Z y := by
  obtain ⟨L, hL1, hL2⟩ := ker_hole_forest Z k G hG
  obtain ⟨yp, yc⟩ := y
  cases yp with
  | nil =>
    simp only [underCol]
    unfold Tree.colAt localSuffix
    simp only [hL1, Option.bind_some, Option.getD_some, Tree.forestAt, Tree.cols]
    rw [← hL2, List.getElem?_append_right (by omega), Nat.add_sub_cancel_left, ← List.drop_drop,
      List.drop_left]
    exact ⟨rfl, rfl⟩
  | cons x rest =>
    obtain ⟨c0, e0⟩ := x
    simp only [underCol]
    have hf : (replaceAt 0 0 Z k G).forestAt
        ((kerHoleAt k G).path ++ ((kerHoleAt k G).col + c0, e0) :: rest) =
          Z.forestAt ((c0, e0) :: rest) := by
      rw [Tree.forestAt_append, hL1, Option.bind_some, ker_forestAt_cons, ker_forestAt_cons]
      simp only [Tree.cols]
      rw [← hL2, List.getElem?_append_right (by omega), Nat.add_sub_cancel_left]
    unfold Tree.colAt localSuffix
    simp only
    rw [hf]
    exact ⟨rfl, rfl⟩

/-- T3.2i helper: along the stopping route, the route holes are the stopping column. -/
theorem ker_holeAt_of_stop {E : Forest} {sd : StopData} (hsd : stopData E = some sd) :
    ∀ j, j ≤ sd.depth → ∃ G, E.forestAt (sd.col.path.take j) = some G ∧
      kerHoleAt (sd.depth - j) G = ⟨sd.col.path.drop j, sd.col.col⟩ := by
  obtain ⟨-, hdep, -, hmem, -⟩ := stopData_spec hsd
  obtain ⟨hpath, -⟩ := (Scan.mem_routeCols_iff E sd.col).1 hmem
  obtain ⟨F, hF, hFlen, -⟩ := ker_stopForest hsd
  suffices h : ∀ m j, j + m = sd.col.path.length →
      ∃ G, E.forestAt (sd.col.path.take j) = some G ∧
        kerHoleAt m G = ⟨sd.col.path.drop j, sd.col.col⟩ by
    intro j hj
    exact h (sd.depth - j) j (by omega)
  intro m
  induction m with
  | zero =>
    intro j hj
    refine ⟨F, ?_, ?_⟩
    · rw [List.take_of_length_le (by omega)]; exact hF
    · simp only [kerHoleAt, hFlen, Nat.add_sub_cancel]
      rw [List.drop_of_length_le (by omega)]
  | succ m ih =>
    intro j hj
    obtain ⟨H, hH, hHr⟩ := ih (j + 1) (by omega)
    obtain ⟨G, hG, hlast⟩ := hpath j (by omega)
    refine ⟨G, hG, ?_⟩
    have hj' : j < sd.col.path.length := by omega
    rw [List.getElem?_eq_getElem hj'] at hlast
    unfold Tree.lastStep? at hlast
    cases hgc : G.cols.getLast? with
    | none => rw [hgc] at hlast; simp at hlast
    | some col =>
      rw [hgc] at hlast
      simp only [Option.bind_some] at hlast
      split at hlast
      · simp at hlast
      · rename_i hne
        have hstep : sd.col.path[j] = (G.cols.length - 1, col.length - 1) :=
          (Option.some.inj hlast).symm
        have hcol : col ≠ [] := by simpa using hne
        obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 (List.getLast?_isSome.2 hcol)
        obtain ⟨p, H'⟩ := x
        rw [List.take_add_one, List.getElem?_eq_getElem hj', Option.toList_some,
          Tree.forestAt_append, hG, Option.bind_some, hstep, ker_forestAt_lastStep hgc hx] at hH
        cases hH
        rw [ker_kerHoleAt_succ hgc hx, hHr, List.drop_eq_getElem_cons hj', hstep]

/-- T3.2i helper: the stopping column is the route hole of the whole expression. -/
theorem ker_stop_hole {E : Forest} {sd : StopData} (hsd : stopData E = some sd) :
    KerRoute sd.depth E ∧ kerHoleAt sd.depth E = sd.col := by
  obtain ⟨G, hG, hR⟩ := ker_route_of_stop hsd 0 (Nat.zero_le _)
  obtain ⟨G', hG', hH⟩ := ker_holeAt_of_stop hsd 0 (Nat.zero_le _)
  simp only [List.take_zero, Tree.forestAt, Option.some.injEq] at hG hG'
  subst hG hG'
  rw [Nat.sub_zero] at hR hH
  exact ⟨hR, by rw [hH]; rfl⟩

/-- T3.2i helper (context fill law). -/
theorem ker_context_law {E : Forest} {sd : StopData} (hsd : stopData E = some sd) (Z : Forest)
    (y : ColAddr) :
    (context E sd Z).colAt (underCol sd.col y) = Z.colAt y ∧
      localSuffix (context E sd Z) (underCol sd.col y) = localSuffix Z y := by
  obtain ⟨hR, hH⟩ := ker_stop_hole hsd
  have := ker_hole_law Z hR y
  rw [hH] at this
  exact this

/-- T3.2i helper: shifts relabel forests at every address. -/
theorem ker_forestAt_map (f : Nat → Nat) : ∀ (p : List (Nat × Nat)) (X : Forest),
    (Tree.map f X).forestAt p = (X.forestAt p).map (Tree.map f)
  | [], X => rfl
  | (c, e) :: rest, X => by
    rw [ker_forestAt_cons, ker_forestAt_cons, ker_map_cols, List.getElem?_map]
    cases hc : X.cols[c]? with
    | none => rfl
    | some col =>
      simp only [Option.map_some, Option.bind_some]
      rw [treeMapCol_eq_map, List.getElem?_map]
      cases he : col[e]? with
      | none => rfl
      | some x => simp only [Option.map_some, Option.bind_some]; exact ker_forestAt_map f rest x.2

theorem ker_shift_law (r d : Nat) (X : Forest) (y : ColAddr) :
    (shift r d X).colAt y = (X.colAt y).map (Tree.mapCol (shiftVal r d)) ∧
      localSuffix (shift r d X) y = shift r d (localSuffix X y) := by
  unfold shift Tree.colAt localSuffix
  rw [ker_forestAt_map]
  cases X.forestAt y.path with
  | none => simp [Tree.empty, Tree.cols, Tree.map, Tree.mapCols]
  | some F =>
    constructor
    · simp [ker_map_cols, List.getElem?_map]
    · simp only [Option.map_some, Option.getD_some, ker_map_cols]
      simp only [Tree.map]
      rw [treeMapCols_eq_map, List.map_drop]

/-- T3.2i helper: the kernel is a placement of `T_d X` into a kernel with an open hole. -/
def kerOpen (E : Forest) (sd : StopData) (rd : RootData) : Forest :=
  if rd.owner then
    .node [sd.Q ++ (unconsumed E rd).map fun x => (x.1, shift sd.r (period sd) x.2)]
  else
    .node ((sd.Q ++ (unconsumed E rd).map fun x => (x.1, shift sd.r (period sd) x.2)) ::
      (shift sd.r (period sd) (.node ((rootForest E rd).cols.drop (rd.idx + 1)))).cols)

theorem ker_route_cons {c : Column} {cs : List Column} (hcs : cs ≠ []) :
    ∀ k, KerRoute k (Tree.node cs) → KerRoute k (Tree.node (c :: cs))
  | 0, _ => by show c :: cs ≠ []; simp
  | k + 1, ⟨col, p, H, h1, h2, h3⟩ => by
    refine ⟨col, p, H, ?_, h2, h3⟩
    obtain ⟨y, ys, rfl⟩ := List.exists_cons_of_ne_nil hcs
    simp only [Tree.cols] at h1 ⊢
    rw [List.getLast?_cons_cons]; exact h1

theorem ker_route_drop : ∀ (k : Nat) (cs : List Column) (i : Nat), i < cs.length →
    KerRoute k (Tree.node cs) → KerRoute k (Tree.node (cs.drop i))
  | 0, cs, i, hi, _ => by
    show cs.drop i ≠ []
    intro h; have := congrArg List.length h; simp at this; omega
  | k + 1, cs, i, hi, ⟨col, p, H, h1, h2, h3⟩ => by
    refine ⟨col, p, H, ?_, h2, h3⟩
    simp only [Tree.cols] at h1 ⊢
    rw [List.getLast?_drop, if_neg (by omega), h1]

/-- helper: a placement through the last column leaves the first column alone. -/
theorem ker_replaceAt_cons (Z : Forest) (δ : Nat) (c : Column) {cs : List Column} (hcs : cs ≠ []) :
    replaceAt 0 0 Z δ (Tree.node (c :: cs)) =
      Tree.node (c :: (replaceAt 0 0 Z δ (Tree.node cs)).cols) := by
  have := ker_replaceAt_split Z δ (c :: cs) 1 (by
    obtain ⟨y, ys, rfl⟩ := List.exists_cons_of_ne_nil hcs; simp)
  simp only [List.take_succ_cons, List.take_zero, List.drop_succ_cons, List.drop_zero,
    List.singleton_append] at this
  rw [← ker_node_cols (replaceAt 0 0 Z δ (Tree.node (c :: cs))), this]

theorem ker_kernel_open {E : Forest} {sd : StopData} {rd : RootData} (hsd : stopData E = some sd)
    (hrd : rootData E = some rd) (hkd : KernelDefined E rd) (X : Forest) :
    kernel E sd rd X = replaceAt 0 0 (shift sd.r (period sd) X) (holeDepth sd rd) (kerOpen E sd rd) ∧
      KerRoute (holeDepth sd rd) (kerOpen E sd rd) ∧
      kerHoleAt (holeDepth sd rd) (kerOpen E sd rd) = kerHole sd rd := by
  obtain ⟨hF, hR⟩ := ker_route_rootForest hsd hrd
  obtain ⟨-, -, hidx, -, -, hmem, -, hown⟩ := rootData_spec hsd hrd
  obtain ⟨-, hdep, -⟩ := stopData_spec hsd
  obtain ⟨-, -, hlay, -⟩ := rootData_path hsd hrd
  obtain ⟨hkc, hq⟩ := ker_kerCol_stop hsd hrd hkd
  obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff E rd.col).1 hmem)
  have hcolF : (rootForest E rd).cols[rd.idx]? = some col := by
    unfold Tree.colAt at hcol; rw [hF, Option.bind_some, ← hidx] at hcol; exact hcol
  have hidxlt : rd.idx < (rootForest E rd).cols.length := by
    by_contra h; rw [List.getElem?_eq_none (by omega)] at hcolF; cases hcolF
  have hδ : holeDepth sd rd = sd.col.path.length - rd.col.path.length := by
    unfold holeDepth; rw [hdep, hlay]
  obtain ⟨Gh, hGh, hGhole⟩ := ker_holeAt_of_stop hsd rd.layer (rootData_layer_le hsd hrd)
  rw [← (ker_rootPath hsd hrd).1, hF] at hGh
  cases hGh
  rw [show sd.depth - rd.layer = holeDepth sd rd from rfl] at hGhole
  unfold kerCol at hkc
  rw [if_neg (by simp [hq])] at hkc
  rcases hFF : rootForest E rd with ⟨cs⟩
  rw [hFF] at hcolF hidxlt hR hGhole hF
  simp only [Tree.cols] at hcolF hidxlt
  by_cases ho : rd.owner = true
  · -- owner case
    rcases ker_stop_path hsd hrd hkd with ⟨ho', -⟩ | ⟨-, e, rest, hp, hle, hlen⟩
    · rw [ho] at ho'; cases ho'
    rw [hp, List.take_left' rfl, if_pos rfl, List.drop_left' rfl] at hkc
    simp only at hkc
    rw [if_pos (by simp [hle])] at hkc
    have hhole := (Option.some.inj hkc).symm
    have hδs : holeDepth sd rd = rest.length + 1 := by rw [hδ, hp]; simp
    rw [hδs] at hR hGhole
    obtain ⟨lc, p, H, hlc, hlh, hHR⟩ := hR
    rw [ker_kerHoleAt_succ hlc hlh, hp, hlay, List.drop_left' rfl] at hGhole
    simp only [ColAddr.mk.injEq, List.cons.injEq, Prod.mk.injEq] at hGhole
    have hlast : rd.idx + 1 = cs.length := by
      obtain ⟨F', hF', h'⟩ := hown.1 ho
      rw [hF] at hF'; cases hF'; rw [hidx]; exact h'
    have hlcc : lc = col := by
      simp only [Tree.cols] at hlc
      rw [List.getLast?_eq_getElem?, ← hlast, Nat.add_sub_cancel, hcolF] at hlc
      exact (Option.some.inj hlc).symm
    subst hlcc
    have hU : unconsumed E rd ≠ [] := hkd ho
    have hUl : (unconsumed E rd).getLast? = some (p, H) := by
      unfold unconsumed rootCol
      rw [hcol, Option.getD_some, List.getLast?_drop, if_neg, hlh]
      intro hle'
      apply hU
      unfold unconsumed rootCol
      rw [hcol, Option.getD_some]
      exact List.drop_eq_nil_of_le hle'
    have hUlen : (unconsumed E rd).length = lc.length - rd.cursor := by
      unfold unconsumed rootCol; rw [hcol, Option.getD_some, List.length_drop]
    have hlcl : lc.length = (rootCol E rd).length := by unfold rootCol; rw [hcol]; rfl
    have hcol0 : (sd.Q ++ (unconsumed E rd).map fun x => (x.1, shift sd.r (period sd) x.2)).getLast?
        = some (p, shift sd.r (period sd) H) := by
      rw [List.getLast?_append, List.getLast?_map, hUl]; rfl
    have hkr : KerRoute (rest.length + 1) (kerOpen E sd rd) := by
      unfold kerOpen
      simp only [ho, if_true]
      exact ⟨_, p, shift sd.r (period sd) H, rfl, hcol0, ker_route_shift hHR⟩
    refine ⟨?_, by rw [hδs]; exact hkr, ?_⟩
    · unfold kernel kerOpen
      simp only [ho, if_true]
      rw [hδs, ker_replaceAt_zero_succ]
      simp only [mapLast]
      rw [ker_mapLast_append _ _ _ _ (by simp [hU]), List.map_id, mapLast_map]
      congr 3
      apply ker_mapLast_congr _ (fun x _ => rfl)
      intro x _
      simp only [Function.comp]
      rw [replaceAt_eq_shift sd.r (period sd), Nat.add_sub_cancel]
    · rw [hδs]
      unfold kerOpen
      simp only [ho, if_true]
      rw [ker_kerHoleAt_succ rfl hcol0, ker_kerHoleAt_shift, hhole]
      simp only [Tree.cols, List.length_singleton, Nat.sub_self, List.length_append,
        List.length_map, hUlen, ColAddr.mk.injEq]
      refine ⟨?_, hGhole.2⟩
      rw [hGhole.1.2]
      simp only [List.cons.injEq, Prod.mk.injEq, and_true, true_and]
      have := hGhole.1.1.2
      omega
  · -- body case
    have ho' : rd.owner = false := by simpa using ho
    have hlt : rd.idx + 1 < cs.length := by
      rcases Nat.lt_or_ge (rd.idx + 1) cs.length with h | h
      · exact h
      · exact absurd (hown.2 ⟨_, hF, by rw [← hidx]; simp only [Tree.cols]; omega⟩) ho
    have hcsne : (cs.drop (rd.idx + 1)).map (Tree.mapCol (shiftVal sd.r (period sd))) ≠ [] := by
      intro h; have := congrArg List.length h; simp at this; omega
    have hRb : KerRoute (holeDepth sd rd) (Tree.node ((cs.drop (rd.idx + 1)).map
        (Tree.mapCol (shiftVal sd.r (period sd))))) := by
      rw [← ker_shift_node]
      exact ker_route_shift (ker_route_drop _ cs _ hlt hR)
    refine ⟨?_, ?_, ?_⟩
    · unfold kernel kerOpen
      simp only [ho', Bool.false_eq_true, if_false]
      rw [hFF, replaceAt_eq_shift sd.r (period sd), ker_shift_node]
      simp only [Tree.cols]
      rw [ker_replaceAt_cons _ _ _ hcsne]
      rfl
    · unfold kerOpen
      simp only [ho', Bool.false_eq_true, if_false]
      rw [hFF, ker_shift_node]
      exact ker_route_cons hcsne _ hRb
    · unfold kerOpen
      simp only [ho', Bool.false_eq_true, if_false]
      rw [hFF, ker_shift_node]
      simp only [Tree.cols]
      rcases ker_stop_path hsd hrd hkd with ⟨-, ⟨hp, hlt'⟩ | ⟨ci, e, rest, hp, hlt'⟩⟩ |
          ⟨ho'', -⟩
      · rw [hp, List.take_length, if_pos rfl, List.drop_length] at hkc
        simp only at hkc
        rw [if_neg (by omega), if_pos ⟨hlt', ho'⟩] at hkc
        have hhole := (Option.some.inj hkc).symm
        have hδ0 : holeDepth sd rd = 0 := by rw [hδ, hp]; simp
        rw [hδ0, hhole]
        rw [hδ0] at hGhole
        simp only [kerHoleAt, Tree.cols, ColAddr.mk.injEq, List.length_cons, List.length_map,
          List.length_drop] at hGhole ⊢
        refine ⟨trivial, ?_⟩
        omega
      · rw [hp, List.take_left' rfl, if_pos rfl, List.drop_left' rfl] at hkc
        simp only at hkc
        rw [if_neg (by omega), if_pos ⟨hlt', ho'⟩] at hkc
        have hhole := (Option.some.inj hkc).symm
        have hδs : holeDepth sd rd = rest.length + 1 := by rw [hδ, hp]; simp
        rw [hδs] at hR hGhole
        rw [hδs, hhole]
        obtain ⟨lc, p, H, hlc, hlh, hHR⟩ := hR
        rw [ker_kerHoleAt_succ hlc hlh] at hGhole
        rw [hp, hlay, List.drop_left' rfl] at hGhole
        simp only [ColAddr.mk.injEq, List.cons.injEq, Prod.mk.injEq] at hGhole
        simp only [Tree.cols] at hlc
        have hlc' : ((cs.drop (rd.idx + 1)).map (Tree.mapCol (shiftVal sd.r (period sd)))).getLast?
            = some (Tree.mapCol (shiftVal sd.r (period sd)) lc) := by
          rw [List.getLast?_map, List.getLast?_drop, if_neg (by omega), hlc]; rfl
        have hlc'' : (Tree.node ((sd.Q ++ (unconsumed E rd).map fun x =>
            (x.1, shift sd.r (period sd) x.2)) :: (cs.drop (rd.idx + 1)).map
              (Tree.mapCol (shiftVal sd.r (period sd))))).cols.getLast? =
            some (Tree.mapCol (shiftVal sd.r (period sd)) lc) := by
          obtain ⟨y, ys, hy⟩ := List.exists_cons_of_ne_nil hcsne
          simp only [Tree.cols]
          rw [hy, List.getLast?_cons_cons, ← hy, hlc']
        have hlh' : (Tree.mapCol (shiftVal sd.r (period sd)) lc).getLast? =
            some (shiftVal sd.r (period sd) p, Tree.map (shiftVal sd.r (period sd)) H) := by
          rw [treeMapCol_eq_map, List.getLast?_map, hlh]; rfl
        simp only [Tree.cols] at hGhole
        rw [ker_kerHoleAt_succ hlc'' hlh', ker_kerHoleAt_map]
        simp only [Tree.cols, ColAddr.mk.injEq, List.cons.injEq, Prod.mk.injEq, List.length_cons,
          List.length_map, List.length_drop, treeMapCol_eq_map]
        refine ⟨⟨⟨by omega, by omega⟩, hGhole.1.2⟩, hGhole.2⟩
      · exact absurd ho'' ho

/-- T3.2i helper: the kernel hole law (columns under the hole are those of `T_d X`). -/
theorem ker_kernel_hole_law {E : Forest} {sd : StopData} {rd : RootData}
    (hsd : stopData E = some sd) (hrd : rootData E = some rd) (hkd : KernelDefined E rd)
    (X : Forest) (y : ColAddr) :
    (kernel E sd rd X).colAt (underCol (kerHole sd rd) y) = (shift sd.r (period sd) X).colAt y ∧
      localSuffix (kernel E sd rd X) (underCol (kerHole sd rd) y) =
        localSuffix (shift sd.r (period sd) X) y := by
  obtain ⟨h1, h2, h3⟩ := ker_kernel_open hsd hrd hkd X
  rw [h1, ← h3]
  exact ker_hole_law _ h2 y

/-- T3.2i helper: `k` kernel layers above an address shift it by `τ_k`. -/
theorem ker_iterate_law {E : Forest} {sd : StopData} {rd : RootData}
    (hsd : stopData E = some sd) (hrd : rootData E = some rd) (hkd : KernelDefined E rd) :
    ∀ (k m : Nat) (w : ColAddr),
      ((kernel E sd rd)^[m + k] Tree.empty).colAt ((underCol (kerHole sd rd))^[k] w) =
        (((kernel E sd rd)^[m] Tree.empty).colAt w).map
          (Tree.mapCol (shiftVal sd.r (k * period sd))) ∧
      localSuffix ((kernel E sd rd)^[m + k] Tree.empty) ((underCol (kerHole sd rd))^[k] w) =
        shift sd.r (k * period sd) (localSuffix ((kernel E sd rd)^[m] Tree.empty) w)
  | 0, m, w => by
    simp only [Nat.add_zero, Function.iterate_zero_apply, Nat.zero_mul, shift_zero]
    rw [shiftVal_zero_fun, treeMapCol_id_fun, Option.map_id]
    exact ⟨by simp, by simp⟩
  | k + 1, m, w => by
    rw [show m + (k + 1) = (m + k) + 1 by omega, Function.iterate_succ_apply',
      Function.iterate_succ_apply']
    obtain ⟨h1, h2⟩ := ker_kernel_hole_law hsd hrd hkd ((kernel E sd rd)^[m + k] Tree.empty)
      ((underCol (kerHole sd rd))^[k] w)
    obtain ⟨h3, h4⟩ := ker_shift_law sd.r (period sd) ((kernel E sd rd)^[m + k] Tree.empty)
      ((underCol (kerHole sd rd))^[k] w)
    obtain ⟨ih1, ih2⟩ := ker_iterate_law hsd hrd hkd k m w
    refine ⟨?_, ?_⟩
    · rw [h1, h3, ih1, Option.map_map]
      congr 1
      funext c
      rw [Function.comp, treeMapCol_map, shiftVal_add, Nat.succ_mul, Nat.add_comm]
    · rw [h2, h4, ih2, shift_add, Nat.succ_mul, Nat.add_comm]

/-- T3.2i helper: the root column is not query material. -/
theorem ker_isQMat_root {A : Forest} {sd : StopData} {rd : RootData} (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) : isQMat sd rd.col = false := by
  obtain ⟨hpath, hle⟩ := ker_rootPath hsd hrd
  obtain ⟨-, hdep, -⟩ := stopData_spec hsd
  obtain ⟨-, -, hlay, -⟩ := rootData_path hsd hrd
  unfold isQMat
  have hl : rd.col.path.length ≤ sd.col.path.length := by rw [← hlay, ← hdep]; exact hle
  rw [List.take_of_length_le hl]
  by_cases h : rd.col.path = sd.col.path
  · rw [h, List.drop_length]; simp
  · simp [h]

theorem ker_kerCol_root {A : Forest} {sd : StopData} {rd : RootData} (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) : kerCol sd rd rd.col = some ⟨[], 0⟩ := by
  have hq := ker_isQMat_root hsd hrd
  have hidx := (rootData_spec hsd hrd).2.2.1
  unfold kerCol
  rw [if_neg (by simp [hq]), if_pos (List.take_length), List.drop_length]
  simp only
  rw [if_pos hidx.symm]

/-- T3.2i helper: the head column of a kernel output. -/
theorem ker_kernel_col0 (E : Forest) (sd : StopData) (rd : RootData) (X : Forest) :
    ∃ V, (kernel E sd rd X).colAt ⟨[], 0⟩ = some (sd.Q ++ V) ∧
      V.length = (unconsumed E rd).length ∧
      ∀ v x, (unconsumed E rd)[v]? = some x → ∃ y, V[v]? = some y ∧ y.1 = x.1 ∧
        (¬ (rd.owner = true ∧ v + 1 = (unconsumed E rd).length) →
          y.2 = shift sd.r (period sd) x.2) := by
  unfold kernel
  by_cases ho : rd.owner = true
  · simp only [ho, if_true]
    refine ⟨_, rfl, ker_length_mapLast _ _ _, ?_⟩
    intro v x hx
    rcases Nat.lt_or_ge (v + 1) (unconsumed E rd).length with hlt | hge
    · rw [ker_mapLast_getElem?_lt _ _ hlt, hx]
      exact ⟨_, rfl, rfl, fun _ => rfl⟩
    · have hv : v < (unconsumed E rd).length := by
        by_contra h; rw [List.getElem?_eq_none (by omega)] at hx; cases hx
      have hve : v = (unconsumed E rd).length - 1 := by omega
      rw [hve, ker_mapLast_getElem?_last, List.getLast?_eq_getElem?, ← hve, hx]
      exact ⟨_, rfl, rfl, fun h => (h ⟨by simp [ho], by omega⟩).elim⟩
  · simp only [ho, Bool.false_eq_true, if_false]
    refine ⟨_, rfl, List.length_map _, ?_⟩
    intro v x hx
    rw [List.getElem?_map, hx]
    exact ⟨_, rfl, rfl, fun _ => rfl⟩

/-! ### T3.2i helpers: template material of one kernel layer -/

/-- helper: a forest relation at addresses gives the column and local-suffix relations. -/
theorem ker_cl_of_forestAt {T T' : Forest} {p p' : List (Nat × Nat)} (r d c : Nat)
    (h : T.forestAt p = (T'.forestAt p').map (shift r d)) :
    T.colAt ⟨p, c⟩ = (T'.colAt ⟨p', c⟩).map (Tree.mapCol (shiftVal r d)) ∧
      localSuffix T ⟨p, c⟩ = shift r d (localSuffix T' ⟨p', c⟩) := by
  unfold Tree.colAt localSuffix
  simp only
  rw [h]
  cases T'.forestAt p' with
  | none => simp [Tree.empty, Tree.cols, shift, Tree.map, Tree.mapCols]
  | some F =>
    simp only [Option.map_some, Option.bind_some, Option.getD_some]
    unfold shift
    rw [ker_map_cols, List.getElem?_map]
    refine ⟨rfl, ?_⟩
    simp only [Tree.map]
    rw [treeMapCols_eq_map, List.map_drop]

theorem ker_cl_of_forestAt_eq {T T' : Forest} {p p' : List (Nat × Nat)} (c : Nat)
    (h : T.forestAt p = T'.forestAt p') :
    T.colAt ⟨p, c⟩ = T'.colAt ⟨p', c⟩ ∧ localSuffix T ⟨p, c⟩ = localSuffix T' ⟨p', c⟩ := by
  unfold Tree.colAt localSuffix
  simp only
  rw [h]
  exact ⟨rfl, rfl⟩

/-- helper: query material of the kernel is the query material of `A`. -/
theorem ker_kernel_qmat {A : Forest} {sd : StopData} {rd : RootData} (hsd : stopData A = some sd)
    (X : Forest) {a a' : ColAddr} (hq : isQMat sd a = true) (ha' : kerCol sd rd a = some a') :
    (kernel A sd rd X).colAt a' = A.colAt a ∧ localSuffix (kernel A sd rd X) a' = localSuffix A a := by
  have hq' := hq
  unfold isQMat at hq'
  rw [Bool.and_eq_true, beq_iff_eq] at hq'
  obtain ⟨h1, h2⟩ := hq'
  unfold kerCol at ha'
  rw [if_pos hq] at ha'
  cases hd : a.path.drop sd.col.path.length with
  | nil => rw [hd] at h2; cases h2
  | cons x rest =>
    obtain ⟨ci, j⟩ := x
    rw [hd] at h2 ha'
    simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at h2
    simp only [Option.some.injEq] at ha'
    subst ha'
    obtain ⟨a1, a2⟩ := a
    simp only at h1 hd h2 ⊢
    have hp : a1 = sd.col.path ++ (sd.col.col, j) :: rest := by
      rw [← List.take_append_drop sd.col.path.length a1, h1, hd, h2.1]
    subst hp
    apply ker_cl_of_forestAt_eq
    obtain ⟨V, hV0, -⟩ := ker_kernel_col0 A sd rd X
    obtain ⟨G, hG, -, hGc⟩ := ker_stopForest hsd
    unfold Tree.colAt at hV0
    simp only [Tree.forestAt, Option.bind_some] at hV0
    rw [ker_forestAt_cons, hV0, Option.bind_some, Tree.forestAt_append, hG, Option.bind_some,
      ker_forestAt_cons, hGc, Option.bind_some, List.getElem?_append_left h2.2,
      List.getElem?_append_left h2.2]

/-- helper: the kernel output in explicit form (filling identity, root data unfolded). -/
theorem ker_kernel_explicit {A : Forest} {sd : StopData} {rd : RootData} (hV : CondV A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) (X : Forest) :
    (context A sd X).forestAt rd.col.path =
        some (replaceAt 0 0 X (holeDepth sd rd) (rootForest A rd)) ∧
      kernel A sd rd X = Tree.node ((sd.Q ++ Tree.mapCol (shiftVal sd.r (period sd))
        ((((replaceAt 0 0 X (holeDepth sd rd) (rootForest A rd)).cols[rd.idx]?).getD []).drop
          rd.cursor)) ::
        ((replaceAt 0 0 X (holeDepth sd rd) (rootForest A rd)).cols.drop (rd.idx + 1)).map
          (Tree.mapCol (shiftVal sd.r (period sd)))) := by
  obtain ⟨hF, -⟩ := ker_route_rootForest hsd hrd
  obtain ⟨hpath, hle⟩ := ker_rootPath hsd hrd
  have hidx := (rootData_spec hsd hrd).2.2.1
  have hC : (context A sd X).forestAt rd.col.path =
      some (replaceAt 0 0 X (holeDepth sd rd) (rootForest A rd)) := by
    rw [hpath] at hF ⊢
    rw [ker_context_forestAt hsd X rd.layer hle _ hF]
    rfl
  refine ⟨hC, ?_⟩
  rw [filling_identity hV hsd hrd X]
  unfold rootTail
  have hDcol : (context A sd X).colAt rd.col =
      (replaceAt 0 0 X (holeDepth sd rd) (rootForest A rd)).cols[rd.idx]? := by
    unfold Tree.colAt; rw [hC, Option.bind_some, hidx]
  rw [hDcol, hC, Option.getD_some, ker_shift_node, List.map_cons]
  rfl

/-- helper: root-tail material of the kernel is that of the context, shifted by `T_d`. -/
theorem ker_kernel_roottail {A : Forest} {sd : StopData} {rd : RootData} (hV : CondV A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) (X : Forest) {a a' : ColAddr}
    (hq : isQMat sd a = false) (hne : a ≠ rd.col) (ha' : kerCol sd rd a = some a') :
    (kernel A sd rd X).colAt a' =
        ((context A sd X).colAt a).map (Tree.mapCol (shiftVal sd.r (period sd))) ∧
      localSuffix (kernel A sd rd X) a' =
        shift sd.r (period sd) (localSuffix (context A sd X) a) := by
  obtain ⟨hC, hK⟩ := ker_kernel_explicit hV hsd hrd X
  have hidx := (rootData_spec hsd hrd).2.2.1
  generalize replaceAt 0 0 X (holeDepth sd rd) (rootForest A rd) = FD at hC hK
  obtain ⟨fcs⟩ := FD
  simp only [Tree.cols] at hK
  rw [hK]
  unfold kerCol at ha'
  rw [if_neg (by simp [hq])] at ha'
  by_cases hρ : a.path.take rd.col.path.length = rd.col.path
  swap
  · rw [if_neg hρ] at ha'; cases ha'
  rw [if_pos hρ] at ha'
  obtain ⟨a1, a2⟩ := a
  simp only at hρ ha' ⊢
  have hsplit : a1 = rd.col.path ++ a1.drop rd.col.path.length := by
    conv_lhs => rw [← List.take_append_drop rd.col.path.length a1, hρ]
  cases hd : a1.drop rd.col.path.length with
  | nil =>
    rw [hd] at ha' hsplit
    rw [List.append_nil] at hsplit
    subst hsplit
    simp only at ha'
    split_ifs at ha' with hc1 hc2
    · exact absurd (by rw [hc1, hidx]) hne
    · simp only [Option.some.injEq] at ha'
      subst ha'
      obtain ⟨c', hc'⟩ : ∃ c', a2 - rd.idx = c' + 1 := ⟨a2 - rd.idx - 1, by omega⟩
      have ha2 : a2 = rd.idx + 1 + c' := by omega
      unfold Tree.colAt localSuffix
      simp only [Tree.forestAt, Option.bind_some, Option.getD_some, hC]
      rw [hc']
      show (List.map _ (fcs.drop (rd.idx + 1)))[c']? = Option.map _ fcs[a2]? ∧
        Tree.node ((List.map _ (fcs.drop (rd.idx + 1))).drop c') = shift _ _ (Tree.node (fcs.drop a2))
      rw [List.getElem?_map, List.getElem?_drop, ← ha2, List.map_drop, List.drop_drop, ← ha2]
      refine ⟨rfl, ?_⟩
      unfold shift; simp only [Tree.map]; rw [treeMapCols_eq_map, List.map_drop]
  | cons x rest =>
    obtain ⟨ci, e⟩ := x
    rw [hd] at ha' hsplit
    subst hsplit
    simp only at ha'
    split_ifs at ha' with hc1 hc2
    · simp only [Option.some.injEq] at ha'
      subst ha'
      apply ker_cl_of_forestAt
      rw [ker_forestAt_cons, Tree.forestAt_append, hC, Option.bind_some, ker_forestAt_cons]
      show (((sd.Q ++ _) :: _)[0]?.bind (·[sd.Q.length + (e - rd.cursor)]?)).bind _ = _
      simp only [List.getElem?_cons_zero, Option.bind_some]
      rw [List.getElem?_append_right (by omega), Nat.add_sub_cancel_left, treeMapCol_eq_map,
        List.getElem?_map, List.getElem?_drop, show rd.cursor + (e - rd.cursor) = e by omega,
        hc1.1]
      show _ = Option.map _ (((fcs[rd.idx]?).bind (·[e]?)).bind _)
      cases fcs[rd.idx]? with
      | none => simp
      | some R =>
        simp only [Option.getD_some, Option.bind_some]
        cases R[e]? with
        | none => rfl
        | some y =>
          simp only [Option.map_some, Option.bind_some]
          exact ker_forestAt_map _ rest y.2
    · simp only [Option.some.injEq] at ha'
      subst ha'
      apply ker_cl_of_forestAt
      obtain ⟨ci', hci'⟩ : ∃ ci', ci - rd.idx = ci' + 1 := ⟨ci - rd.idx - 1, by omega⟩
      have hci : ci = rd.idx + 1 + ci' := by omega
      rw [hci', ker_forestAt_cons, Tree.forestAt_append, hC, Option.bind_some, ker_forestAt_cons]
      show (((_ :: List.map _ (fcs.drop (rd.idx + 1)))[ci' + 1]?).bind (·[e]?)).bind _ =
        Option.map _ (((fcs[ci]?).bind (·[e]?)).bind _)
      rw [List.getElem?_cons_succ, List.getElem?_map, List.getElem?_drop, ← hci]
      cases fcs[ci]? with
      | none => rfl
      | some R =>
        simp only [Option.map_some, Option.bind_some]
        rw [treeMapCol_eq_map, List.getElem?_map]
        cases R[e]? with
        | none => rfl
        | some y =>
          simp only [Option.map_some, Option.bind_some]
          exact ker_forestAt_map _ rest y.2

/-- helper: off the hole route, non-query template columns are unchanged by the context. -/
theorem ker_context_offroute {A : Forest} {sd : StopData} (hsd : stopData A = some sd) (X : Forest)
    {a : ColAddr} (ha : a ∈ A.colAddrs) (hq : isQMat sd a = false) (hroute : ¬ OnHoleRoute sd a) :
    (context A sd X).forestAt a.path = A.forestAt a.path := by
  rcases ker_path_cases a.path sd.col.path with hpre | ⟨x, rest, hx⟩ | ⟨j, hj1, hj2, hj3, hj4⟩
  · exact absurd hpre hroute
  · obtain ⟨c', e'⟩ := x
    obtain ⟨G, hG, hGlen, hGc⟩ := ker_stopForest hsd
    obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff A a).1 ha)
    unfold Tree.colAt at hcol
    rw [hx, Tree.forestAt_append, hG, Option.bind_some, ker_forestAt_cons] at hcol
    cases hgc : G.cols[c']? with
    | none => rw [hgc] at hcol; cases hcol
    | some gc =>
      rw [hgc, Option.bind_some] at hcol
      have hc'lt : c' < sd.col.col + 1 := by
        rw [← hGlen]; by_contra h; rw [List.getElem?_eq_none (by omega)] at hgc; cases hgc
      rcases Nat.lt_or_ge c' sd.col.col with hlt | hge
      · rw [hx]; exact ker_context_forestAt_stop hsd X rest (Or.inl hlt)
      · exfalso
        have hc' : c' = sd.col.col := by omega
        subst hc'
        rw [hGc] at hgc
        cases hgc
        rcases Nat.lt_or_ge e' sd.Q.length with he | he
        · -- query material
          have : isQMat sd a = true := by
            unfold isQMat
            rw [hx, List.take_left' rfl, List.drop_left' rfl]
            simp [he]
          rw [hq] at this; cases this
        · cases he' : (sd.Q ++ [(sd.r, Tree.empty)])[e']? with
          | none => rw [he'] at hcol; cases hcol
          | some y =>
            rw [he', Option.bind_some] at hcol
            have hy : y = (sd.r, Tree.empty) := by
              rw [List.getElem?_append_right he] at he'
              rcases Nat.lt_or_ge (e' - sd.Q.length) 1 with h1 | h1
              · rw [show e' - sd.Q.length = 0 by omega] at he'
                simp at he'; exact he'.symm
              · rw [List.getElem?_eq_none (by simp; omega)] at he'; cases he'
            subst hy
            cases rest with
            | nil => simp [Tree.forestAt, Tree.empty, Tree.cols] at hcol
            | cons z zs =>
              obtain ⟨z1, z2⟩ := z
              simp [ker_forestAt_cons, Tree.empty, Tree.cols] at hcol
  · exact ker_context_forestAt_diverge hsd X hj2 hj1 hj3 hj4

/-! ### T3.2i helpers: the hole region of a placement -/

/-- T3.2i helper: `c` is the hole `h`, lies right of it in its forest, or lies under such a
column (the region replaced by a placement at `h`). -/
def KerUnder (h c : ColAddr) : Prop :=
  (c.path = h.path ∧ h.col ≤ c.col) ∨ ∃ c0 e0 rest, c.path = h.path ++ (c0, e0) :: rest ∧ h.col ≤ c0

theorem ker_under_underCol (h y : ColAddr) : KerUnder h (underCol h y) := by
  obtain ⟨yp, yc⟩ := y
  cases yp with
  | nil => left; simp [underCol]
  | cons x rest =>
    obtain ⟨c0, e0⟩ := x
    right; exact ⟨h.col + c0, e0, rest, rfl, by omega⟩

theorem ker_under_cons (x : Nat × Nat) (p : List (Nat × Nat)) (hc : Nat) (rest : List (Nat × Nat))
    (c : Nat) : KerUnder ⟨x :: p, hc⟩ ⟨x :: rest, c⟩ ↔ KerUnder ⟨p, hc⟩ ⟨rest, c⟩ := by
  unfold KerUnder
  simp only [List.cons_append, List.cons.injEq, true_and]

/-- T3.2i helper: columns in the hole region come from the filling. -/
theorem ker_under_exhaust (Z : Forest) {k : Nat} {G : Forest} (hG : KerRoute k G) {c : ColAddr}
    (hu : KerUnder (kerHoleAt k G) c) (hc : c ∈ (replaceAt 0 0 Z k G).colAddrs) :
    ∃ y, y ∈ Z.colAddrs ∧ c = underCol (kerHoleAt k G) y := by
  obtain ⟨L, hL1, hL2⟩ := ker_hole_forest Z k G hG
  obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff _ c).1 hc)
  obtain ⟨cp, cc⟩ := c
  have hnc : (Tree.node (L ++ Z.cols)).cols = L ++ Z.cols := rfl
  rcases hu with ⟨hp, hle⟩ | ⟨c0, e0, rest, hp, hle⟩
  · have hle' : (kerHoleAt k G).col ≤ cc := hle
    simp only at hp
    subst hp
    unfold Tree.colAt at hcol
    rw [hL1, Option.bind_some, hnc, List.getElem?_append_right (by omega), hL2] at hcol
    refine ⟨⟨[], cc - (kerHoleAt k G).col⟩, ?_, ?_⟩
    · rw [Tree.mem_colAddrs_iff]
      unfold Tree.colAt
      rw [show Tree.forestAt Z ([] : List (Nat × Nat)) = some Z from rfl, Option.bind_some]
      simp only at hcol ⊢
      rw [hcol]; rfl
    · simp only [underCol, ColAddr.mk.injEq, true_and]
      omega
  · simp only at hp
    subst hp
    unfold Tree.colAt at hcol
    rw [Tree.forestAt_append, hL1, Option.bind_some, ker_forestAt_cons, hnc,
      List.getElem?_append_right (by omega), hL2] at hcol
    refine ⟨⟨(c0 - (kerHoleAt k G).col, e0) :: rest, cc⟩, ?_, ?_⟩
    · rw [Tree.mem_colAddrs_iff]
      unfold Tree.colAt
      rw [ker_forestAt_cons]
      simp only at hcol ⊢
      rw [hcol]; rfl
    · have hle' : (kerHoleAt k G).col ≤ c0 := hle
      simp only [underCol, ColAddr.mk.injEq, List.append_cancel_left_eq, List.cons.injEq,
        Prod.mk.injEq, and_true, true_and]
      omega

/-- T3.2i helper: outside the hole region, which addresses are columns does not depend on the
filling. -/
theorem ker_off_isSome (Z : Forest) : ∀ (k : Nat) (G : Forest), KerRoute k G → ∀ c : ColAddr,
    ¬ KerUnder (kerHoleAt k G) c →
      ((replaceAt 0 0 Z k G).colAt c).isSome = (G.colAt c).isSome
  | 0, .node cols, h, ⟨cp, cc⟩, hu => by
    have hne : cols ≠ [] := h
    rw [ker_replaceAt_zero_zero Z cols hne]
    simp only [KerUnder, kerHoleAt, Tree.cols, List.nil_append, not_or, not_and, not_le,
      not_exists] at hu
    obtain ⟨hu1, hu2⟩ := hu
    cases cp with
    | nil =>
      have := hu1 rfl
      unfold Tree.colAt
      simp only [Tree.forestAt, Option.bind_some, Tree.cols]
      rw [List.getElem?_append_left (by simp; omega), List.getElem?_dropLast, if_pos (by omega)]
    | cons x rest =>
      obtain ⟨c0, e0⟩ := x
      have := hu2 c0 e0 rest rfl
      unfold Tree.colAt
      rw [ker_forestAt_cons, ker_forestAt_cons]
      simp only [Tree.cols]
      rw [List.getElem?_append_left (by simp; omega), List.getElem?_dropLast, if_pos (by omega)]
  | k + 1, G, ⟨col, p, H, hc, hl, hk⟩, ⟨cp, cc⟩, hu => by
    rw [ker_kerHoleAt_succ hc hl] at hu
    cases cp with
    | nil =>
      obtain ⟨cols⟩ := G
      rw [ker_replaceAt_zero_succ]
      unfold Tree.colAt
      simp only [Tree.forestAt, Option.bind_some, Tree.cols]
      cases h1 : (mapLast id (mapLast id fun x : Nat × Forest => (x.1, replaceAt 0 0 Z k x.2))
          cols)[cc]? with
      | none =>
        rw [List.getElem?_eq_none_iff, ker_length_mapLast] at h1
        rw [List.getElem?_eq_none h1]
      | some x =>
        have : cc < cols.length := by
          have := (List.getElem?_eq_some_iff.1 h1).1; rw [ker_length_mapLast] at this; exact this
        rw [List.getElem?_eq_getElem this]; rfl
    | cons x rest =>
      obtain ⟨c0, e0⟩ := x
      by_cases hx : (c0, e0) = (G.cols.length - 1, col.length - 1)
      · rw [hx] at hu ⊢
        rw [ker_under_cons] at hu
        have ih := ker_off_isSome Z k H hk ⟨rest, cc⟩ hu
        unfold Tree.colAt at ih ⊢
        simp only at ih ⊢
        rw [ker_forestAt_cons' (replaceAt 0 0 Z (k + 1) G) _ rest, ker_forestAt_cons' G _ rest,
          ker_replaceAt_forestAt_last Z k hc hl, ker_forestAt_lastStep hc hl, Option.bind_some,
          Option.bind_some]
        exact ih
      · unfold Tree.colAt
        rw [ker_forestAt_cons, ker_forestAt_cons, ker_replaceAt_step_other Z k hc c0 e0 hx]

/-- T3.2i helper: in `A`, the region of the stopping column holds only the stopping column and
its query heights. -/
theorem ker_under_stop {A : Forest} {sd : StopData} (hsd : stopData A = some sd) {a : ColAddr}
    (ha : a ∈ A.colAddrs) (hu : KerUnder sd.col a) : a = sd.col ∨ isQMat sd a = true := by
  obtain ⟨G, hG, hGlen, hGc⟩ := ker_stopForest hsd
  obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff A a).1 ha)
  obtain ⟨ap, ac⟩ := a
  unfold Tree.colAt at hcol
  rcases hu with ⟨hp, hle⟩ | ⟨c0, e0, rest, hp, hle⟩
  · simp only at hp hle hcol
    subst hp
    rw [hG, Option.bind_some] at hcol
    left
    have : ac < sd.col.col + 1 := by
      rw [← hGlen]; by_contra h; rw [List.getElem?_eq_none (by omega)] at hcol; cases hcol
    have hac : ac = sd.col.col := by omega
    subst hac; rfl
  · simp only at hp hle hcol
    subst hp
    rw [Tree.forestAt_append, hG, Option.bind_some, ker_forestAt_cons] at hcol
    cases hgc : G.cols[c0]? with
    | none => rw [hgc] at hcol; cases hcol
    | some gc =>
      rw [hgc, Option.bind_some] at hcol
      have hc0 : c0 < sd.col.col + 1 := by
        rw [← hGlen]; by_contra h; rw [List.getElem?_eq_none (by omega)] at hgc; cases hgc
      have hc0' : c0 = sd.col.col := by omega
      subst hc0'
      rw [hGc] at hgc
      cases hgc
      right
      rcases Nat.lt_or_ge e0 sd.Q.length with he | he
      · unfold isQMat
        simp only [List.take_left' rfl, List.drop_left' rfl]
        simp [he]
      · exfalso
        cases he' : (sd.Q ++ [(sd.r, Tree.empty)])[e0]? with
        | none => rw [he'] at hcol; cases hcol
        | some y =>
          rw [he', Option.bind_some] at hcol
          have hy : y = (sd.r, Tree.empty) := by
            rw [List.getElem?_append_right he] at he'
            rcases Nat.lt_or_ge (e0 - sd.Q.length) 1 with h1 | h1
            · rw [show e0 - sd.Q.length = 0 by omega] at he'
              simp at he'; exact he'.symm
            · rw [List.getElem?_eq_none (by simp; omega)] at he'; cases he'
          subst hy
          cases rest with
          | nil => simp [Tree.forestAt, Tree.empty, Tree.cols] at hcol
          | cons z zs =>
            obtain ⟨z1, z2⟩ := z
            simp [ker_forestAt_cons, Tree.empty, Tree.cols] at hcol

/-! ### T3.2i helpers: the shapes of `kerCol` -/

/-- T3.2i helper: the five shapes of the template map. -/
theorem ker_kerCol_shape {sd : StopData} {rd : RootData} {a a' : ColAddr}
    (h : kerCol sd rd a = some a') :
    (isQMat sd a = true ∧ ∃ j rest, a.path = sd.col.path ++ (sd.col.col, j) :: rest ∧
        j < sd.Q.length ∧ a' = ⟨(0, j) :: rest, a.col⟩) ∨
      (isQMat sd a = false ∧ a.path = rd.col.path ∧ a.col = rd.idx ∧ a' = ⟨[], 0⟩) ∨
      (isQMat sd a = false ∧ a.path = rd.col.path ∧ rd.idx < a.col ∧ rd.owner = false ∧
        a' = ⟨[], a.col - rd.idx⟩) ∨
      (isQMat sd a = false ∧ ∃ e rest, a.path = rd.col.path ++ (rd.idx, e) :: rest ∧
        rd.cursor ≤ e ∧ a' = ⟨(0, sd.Q.length + (e - rd.cursor)) :: rest, a.col⟩) ∨
      (isQMat sd a = false ∧ ∃ ci e rest, a.path = rd.col.path ++ (ci, e) :: rest ∧
        rd.idx < ci ∧ rd.owner = false ∧ a' = ⟨(ci - rd.idx, e) :: rest, a.col⟩) := by
  unfold kerCol at h
  by_cases hq : isQMat sd a = true
  · rw [if_pos hq] at h
    left
    refine ⟨hq, ?_⟩
    have hq' := hq
    unfold isQMat at hq'
    rw [Bool.and_eq_true, beq_iff_eq] at hq'
    obtain ⟨h1, h2⟩ := hq'
    cases hd : a.path.drop sd.col.path.length with
    | nil => rw [hd] at h2; cases h2
    | cons x rest =>
      obtain ⟨ci, j⟩ := x
      rw [hd] at h2 h
      simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at h2
      simp only [Option.some.injEq] at h
      refine ⟨j, rest, ?_, h2.2, h.symm⟩
      rw [← List.take_append_drop sd.col.path.length a.path, h1, hd, h2.1]
  · rw [if_neg hq] at h
    simp only [Bool.not_eq_true] at hq
    right
    by_cases hρ : a.path.take rd.col.path.length = rd.col.path
    swap
    · rw [if_neg hρ] at h; cases h
    rw [if_pos hρ] at h
    have hsplit : a.path = rd.col.path ++ a.path.drop rd.col.path.length := by
      conv_lhs => rw [← List.take_append_drop rd.col.path.length a.path, hρ]
    cases hd : a.path.drop rd.col.path.length with
    | nil =>
      rw [hd] at h hsplit
      rw [List.append_nil] at hsplit
      simp only at h
      split_ifs at h with hc1 hc2
      · simp only [Option.some.injEq] at h
        exact Or.inl ⟨hq, hsplit, hc1, h.symm⟩
      · simp only [Option.some.injEq] at h
        exact Or.inr (Or.inl ⟨hq, hsplit, hc2.1, hc2.2, h.symm⟩)
    | cons x rest =>
      obtain ⟨ci, e⟩ := x
      rw [hd] at h hsplit
      simp only at h
      split_ifs at h with hc1 hc2
      · simp only [Option.some.injEq] at h
        refine Or.inr (Or.inr (Or.inl ⟨hq, e, rest, ?_, hc1.2, h.symm⟩))
        rw [hsplit, hc1.1]
      · simp only [Option.some.injEq] at h
        exact Or.inr (Or.inr (Or.inr ⟨hq, ci, e, rest, hsplit, hc2.1, hc2.2, h.symm⟩))

/-- T3.2i helper: the inverse of the template map. -/
def kerDecode (sd : StopData) (rd : RootData) (y : ColAddr) : ColAddr :=
  match y.path with
  | [] => ⟨rd.col.path, rd.idx + y.col⟩
  | (0, j) :: rest =>
    if j < sd.Q.length then ⟨sd.col.path ++ (sd.col.col, j) :: rest, y.col⟩
    else ⟨rd.col.path ++ (rd.idx, rd.cursor + (j - sd.Q.length)) :: rest, y.col⟩
  | (k + 1, e) :: rest => ⟨rd.col.path ++ (rd.idx + (k + 1), e) :: rest, y.col⟩

theorem ker_kerCol_decode {sd : StopData} {rd : RootData} {a y : ColAddr}
    (h : kerCol sd rd a = some y) : a = kerDecode sd rd y := by
  obtain ⟨ap, ac⟩ := a
  rcases ker_kerCol_shape h with ⟨-, j, rest, hp, hj, rfl⟩ | ⟨-, hp, hc, rfl⟩ |
      ⟨-, hp, hc, -, rfl⟩ | ⟨-, e, rest, hp, he, rfl⟩ | ⟨-, ci, e, rest, hp, hci, -, rfl⟩
  · simp only at hp ⊢; subst hp; simp [kerDecode, hj]
  · simp only at hp hc ⊢; subst hp hc; simp [kerDecode]
  · simp only at hp hc ⊢; subst hp; simp only [kerDecode]; congr 1; omega
  · simp only at hp ⊢; subst hp
    simp only [kerDecode, show ¬ (sd.Q.length + (e - rd.cursor) < sd.Q.length) by omega, if_false,
      ColAddr.mk.injEq, List.append_cancel_left_eq, List.cons.injEq, Prod.mk.injEq, true_and,
      and_true]
    omega
  · simp only at hp ⊢; subst hp
    obtain ⟨k, hk⟩ : ∃ k, ci - rd.idx = k + 1 := ⟨ci - rd.idx - 1, by omega⟩
    simp only [hk, kerDecode, ColAddr.mk.injEq, List.append_cancel_left_eq, List.cons.injEq,
      Prod.mk.injEq, true_and, and_true]
    omega

/-- T3.2i helper: the template map is injective. -/
theorem ker_kerCol_inj {sd : StopData} {rd : RootData} {a b y : ColAddr}
    (ha : kerCol sd rd a = some y) (hb : kerCol sd rd b = some y) : a = b := by
  rw [ker_kerCol_decode ha, ker_kerCol_decode hb]

/-! ### T3.2i helpers: the hole region and the template map -/

theorem ker_under_nil_nil (hc c : Nat) : KerUnder ⟨[], hc⟩ ⟨[], c⟩ ↔ hc ≤ c := by
  unfold KerUnder; simp

theorem ker_under_nil_cons (hc c c0 e0 : Nat) (q : List (Nat × Nat)) :
    KerUnder ⟨[], hc⟩ ⟨(c0, e0) :: q, c⟩ ↔ hc ≤ c0 := by
  unfold KerUnder
  simp only [List.nil_append, List.cons.injEq, Prod.mk.injEq, reduceCtorEq, false_and, false_or]
  constructor
  · rintro ⟨c1, e1, r, ⟨⟨rfl, rfl⟩, rfl⟩, h⟩; exact h
  · intro h; exact ⟨c0, e0, q, ⟨⟨rfl, rfl⟩, rfl⟩, h⟩

theorem ker_under_cons_nil (x : Nat × Nat) (p : List (Nat × Nat)) (hc c : Nat) :
    ¬ KerUnder ⟨x :: p, hc⟩ ⟨[], c⟩ := by
  unfold KerUnder; simp

theorem ker_under_cons_cons (x x' : Nat × Nat) (p q : List (Nat × Nat)) (hc c : Nat) :
    KerUnder ⟨x :: p, hc⟩ ⟨x' :: q, c⟩ ↔ x' = x ∧ KerUnder ⟨p, hc⟩ ⟨q, c⟩ := by
  unfold KerUnder
  simp only [List.cons_append, List.cons.injEq]
  constructor
  · rintro (⟨⟨h1, h2⟩, h3⟩ | ⟨c0, e0, r, ⟨h1, h2⟩, h3⟩)
    · exact ⟨h1, Or.inl ⟨h2, h3⟩⟩
    · exact ⟨h1, Or.inr ⟨c0, e0, r, h2, h3⟩⟩
  · rintro ⟨h1, ⟨h2, h3⟩ | ⟨c0, e0, r, h2, h3⟩⟩
    · exact Or.inl ⟨⟨h1, h2⟩, h3⟩
    · exact Or.inr ⟨c0, e0, r, ⟨h1, h2⟩, h3⟩

theorem ker_under_append (P p q : List (Nat × Nat)) (hc c : Nat) :
    KerUnder ⟨P ++ p, hc⟩ ⟨P ++ q, c⟩ ↔ KerUnder ⟨p, hc⟩ ⟨q, c⟩ := by
  induction P with
  | nil => rfl
  | cons x P ih => rw [List.cons_append, List.cons_append, ker_under_cons_cons, ih]; simp

theorem ker_under_pre_l (P q : List (Nat × Nat)) (hc c : Nat) :
    KerUnder ⟨P, hc⟩ ⟨P ++ q, c⟩ ↔ KerUnder ⟨[], hc⟩ ⟨q, c⟩ := by
  have := ker_under_append P [] q hc c
  rw [List.append_nil] at this; exact this

theorem ker_under_pre_r (P p : List (Nat × Nat)) (hc c : Nat) :
    KerUnder ⟨P ++ p, hc⟩ ⟨P, c⟩ ↔ KerUnder ⟨p, hc⟩ ⟨[], c⟩ := by
  have := ker_under_append P p [] hc c
  rw [List.append_nil] at this; exact this

theorem ker_under_pre (P : List (Nat × Nat)) (hc c : Nat) :
    KerUnder ⟨P, hc⟩ ⟨P, c⟩ ↔ hc ≤ c := by
  have := ker_under_append P [] [] hc c
  rw [List.append_nil] at this; rw [this, ker_under_nil_nil]

/-- T3.2i helper: query material lies in the region of the stopping column. -/
theorem ker_qmat_under {sd : StopData} {a : ColAddr} (hq : isQMat sd a = true) :
    KerUnder sd.col a := by
  unfold isQMat at hq
  rw [Bool.and_eq_true, beq_iff_eq] at hq
  obtain ⟨h1, h2⟩ := hq
  cases hd : a.path.drop sd.col.path.length with
  | nil => rw [hd] at h2; cases h2
  | cons x rest =>
    obtain ⟨ci, j⟩ := x
    rw [hd] at h2
    simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at h2
    right
    refine ⟨ci, j, rest, ?_, by omega⟩
    rw [← List.take_append_drop sd.col.path.length a.path, h1, hd]

/-- T3.2i helper: the explicit hole of the kernel. -/
theorem ker_kerHole_cases {A : Forest} {sd : StopData} {rd : RootData}
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) (hkd : KernelDefined A rd) :
    (rd.owner = false ∧ sd.col.path = rd.col.path ∧ rd.idx < sd.col.col ∧
        kerHole sd rd = ⟨[], sd.col.col - rd.idx⟩) ∨
      (rd.owner = false ∧ ∃ ci e rest, sd.col.path = rd.col.path ++ (ci, e) :: rest ∧
        rd.idx < ci ∧ kerHole sd rd = ⟨(ci - rd.idx, e) :: rest, sd.col.col⟩) ∨
      (rd.owner = true ∧ ∃ e rest, sd.col.path = rd.col.path ++ (rd.idx, e) :: rest ∧
        rd.cursor ≤ e ∧ kerHole sd rd = ⟨(0, sd.Q.length + (e - rd.cursor)) :: rest, sd.col.col⟩) := by
  obtain ⟨hkc, hq⟩ := ker_kerCol_stop hsd hrd hkd
  unfold kerCol at hkc
  rw [if_neg (by simp [hq])] at hkc
  rcases ker_stop_path hsd hrd hkd with ⟨ho, ⟨hp, hlt⟩ | ⟨ci, e, rest, hp, hlt⟩⟩ |
      ⟨ho, e, rest, hp, hle, -⟩
  · rw [hp, List.take_length, if_pos rfl, List.drop_length] at hkc
    simp only at hkc
    rw [if_neg (by omega), if_pos ⟨hlt, ho⟩] at hkc
    exact Or.inl ⟨ho, hp, hlt, (Option.some.inj hkc).symm⟩
  · rw [hp, List.take_left' rfl, if_pos rfl, List.drop_left' rfl] at hkc
    simp only at hkc
    rw [if_neg (by omega), if_pos ⟨hlt, ho⟩] at hkc
    exact Or.inr (Or.inl ⟨ho, ci, e, rest, hp, hlt, (Option.some.inj hkc).symm⟩)
  · rw [hp, List.take_left' rfl, if_pos rfl, List.drop_left' rfl] at hkc
    simp only at hkc
    rw [if_pos (by simp [hle])] at hkc
    exact Or.inr (Or.inr ⟨ho, e, rest, hp, hle, (Option.some.inj hkc).symm⟩)

/-- T3.2i helper: for root-tail material the template map carries the region of the stopping
column onto the region of the kernel hole. -/
theorem ker_under_transport {A : Forest} {sd : StopData} {rd : RootData}
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) (hkd : KernelDefined A rd)
    {a y : ColAddr}
    (h : (a.path = rd.col.path ∧ rd.idx < a.col ∧ rd.owner = false ∧ y = ⟨[], a.col - rd.idx⟩) ∨
      (∃ e rest, a.path = rd.col.path ++ (rd.idx, e) :: rest ∧ rd.cursor ≤ e ∧
        y = ⟨(0, sd.Q.length + (e - rd.cursor)) :: rest, a.col⟩) ∨
      (∃ ci e rest, a.path = rd.col.path ++ (ci, e) :: rest ∧ rd.idx < ci ∧ rd.owner = false ∧
        y = ⟨(ci - rd.idx, e) :: rest, a.col⟩)) :
    KerUnder (kerHole sd rd) y ↔ KerUnder sd.col a := by
  obtain ⟨ap, ac⟩ := a
  show KerUnder (kerHole sd rd) y ↔ KerUnder ⟨sd.col.path, sd.col.col⟩ ⟨ap, ac⟩
  rcases ker_kerHole_cases hsd hrd hkd with ⟨ho, hp, hlt, hkh⟩ | ⟨ho, ci, e, rest, hp, hlt, hkh⟩ |
      ⟨ho, e, rest, hp, hle, hkh⟩
  · rw [hkh, hp]
    generalize sd.col.col = sc at hlt ⊢
    rcases h with ⟨h1, h2, -, rfl⟩ | ⟨e', rest', h1, h2, rfl⟩ | ⟨ci', e', rest', h1, h2, -, rfl⟩ <;>
      simp only at h1 h2 ⊢ <;> subst h1
    · rw [ker_under_nil_nil, ker_under_pre]
      omega
    · rw [ker_under_pre_l, ker_under_nil_cons, ker_under_nil_cons]
      omega
    · rw [ker_under_pre_l, ker_under_nil_cons, ker_under_nil_cons]
      omega
  · rw [hkh, hp]
    generalize sd.col.col = sc
    rcases h with ⟨h1, h2, -, rfl⟩ | ⟨e', rest', h1, h2, rfl⟩ | ⟨ci', e', rest', h1, h2, -, rfl⟩ <;>
      simp only at h1 h2 ⊢ <;> subst h1
    · rw [ker_under_pre_r]
      exact iff_of_false (ker_under_cons_nil _ _ _ _) (ker_under_cons_nil _ _ _ _)
    · rw [ker_under_append, ker_under_cons_cons, ker_under_cons_cons]
      simp only [Prod.mk.injEq]
      constructor <;> rintro ⟨⟨h3, -⟩, -⟩ <;> omega
    · rw [ker_under_append, ker_under_cons_cons, ker_under_cons_cons]
      simp only [Prod.mk.injEq]
      constructor
      · rintro ⟨⟨h3, h4⟩, h5⟩; exact ⟨⟨by omega, h4⟩, h5⟩
      · rintro ⟨⟨h3, h4⟩, h5⟩; exact ⟨⟨by omega, h4⟩, h5⟩
  · rw [hkh, hp]
    generalize sd.col.col = sc
    rcases h with ⟨h1, h2, h3, rfl⟩ | ⟨e', rest', h1, h2, rfl⟩ | ⟨ci', e', rest', h1, h2, h3, rfl⟩
    · rw [ho] at h3; cases h3
    · simp only at h1 h2 ⊢; subst h1
      rw [ker_under_append, ker_under_cons_cons, ker_under_cons_cons]
      simp only [Prod.mk.injEq, true_and]
      constructor
      · rintro ⟨h3, h4⟩; exact ⟨by omega, h4⟩
      · rintro ⟨h3, h4⟩; exact ⟨by omega, h4⟩
    · rw [ho] at h3; cases h3

/-- T3.2i helper: addresses on the root column's forest are not query material. -/
theorem ker_isQMat_rootpath {A : Forest} {sd : StopData} {rd : RootData}
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) {a : ColAddr}
    (ha : a.path = rd.col.path) : isQMat sd a = false := by
  obtain ⟨hpath, hle⟩ := ker_rootPath hsd hrd
  obtain ⟨-, hdep, -⟩ := stopData_spec hsd
  obtain ⟨-, -, hlay, -⟩ := rootData_path hsd hrd
  unfold isQMat
  rw [ha]
  have hl : rd.col.path.length ≤ sd.col.path.length := by rw [← hlay, ← hdep]; exact hle
  rw [List.take_of_length_le hl]
  by_cases h : rd.col.path = sd.col.path
  · rw [h, List.drop_length]; simp
  · simp [h]

theorem ker_root_ne_stop {A : Forest} {sd : StopData} {rd : RootData}
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) : rd.col ≠ sd.col := by
  intro h
  obtain ⟨-, -, -, hnum, hrt, -⟩ := rootData_spec hsd hrd
  have ht := (stopData_spec hsd).2.2.1
  rw [h] at hnum
  omega

/-- T3.2i helper: template images avoid the region of the kernel hole. -/
theorem ker_kerCol_not_under {A : Forest} {sd : StopData} {rd : RootData}
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) (hkd : KernelDefined A rd)
    {a a' : ColAddr} (ha : a = rd.col ∨ IsTmplCol A sd rd a) (h : kerCol sd rd a = some a') :
    ¬ KerUnder (kerHole sd rd) a' := by
  intro hu
  have hamem : a ∈ A.colAddrs := by
    rcases ha with rfl | h'
    · exact (rootData_spec hsd hrd).2.2.2.2.2.1
    · exact h'.1
  have hane : a ≠ sd.col := by
    rcases ha with rfl | h'
    · exact ker_root_ne_stop hsd hrd
    · exact h'.2.1
  have key : KerUnder sd.col a → False := by
    intro hs
    rcases ker_under_stop hsd hamem hs with h1 | h1
    · exact hane h1
    · rcases ker_kerCol_shape h with ⟨-, -⟩ | ⟨hq, -⟩ | ⟨hq, -⟩ | ⟨hq, -⟩ | ⟨hq, -⟩
      · -- query material is never in the hole region of the kernel: handled below
        exact absurd hu (by
          rcases ker_kerCol_shape h with ⟨-, j, rest, -, hj, rfl⟩ | ⟨hq', -⟩ | ⟨hq', -⟩ |
              ⟨hq', -⟩ | ⟨hq', -⟩
          · rcases ker_kerHole_cases hsd hrd hkd with ⟨-, -, hlt, hkh⟩ |
                ⟨-, ci, e, rest', -, hlt, hkh⟩ | ⟨-, e, rest', -, -, hkh⟩ <;> rw [hkh]
            · rw [ker_under_nil_cons]; omega
            · rw [ker_under_cons_cons]; simp only [Prod.mk.injEq, not_and]; intro h0; omega
            · rw [ker_under_cons_cons]; simp only [Prod.mk.injEq, not_and]; intro _ h0; omega
          all_goals (rw [hq'] at h1; cases h1))
      all_goals (rw [hq] at h1; cases h1)
  rcases ker_kerCol_shape h with ⟨-, j, rest, -, hj, rfl⟩ | ⟨-, -, -, rfl⟩ |
      ⟨-, hp, hc, ho, rfl⟩ | ⟨-, e, rest, hp, he, rfl⟩ | ⟨-, ci, e, rest, hp, hci, ho, rfl⟩
  · rcases ker_kerHole_cases hsd hrd hkd with ⟨-, -, hlt, hkh⟩ |
        ⟨-, ci, e, rest', -, hlt, hkh⟩ | ⟨-, e, rest', -, -, hkh⟩ <;> rw [hkh] at hu
    · rw [ker_under_nil_cons] at hu; omega
    · rw [ker_under_cons_cons] at hu; simp only [Prod.mk.injEq] at hu; omega
    · rw [ker_under_cons_cons] at hu; simp only [Prod.mk.injEq] at hu; omega
  · rcases ker_kerHole_cases hsd hrd hkd with ⟨-, -, hlt, hkh⟩ |
        ⟨-, ci, e, rest', -, hlt, hkh⟩ | ⟨-, e, rest', -, -, hkh⟩ <;> rw [hkh] at hu
    · rw [ker_under_nil_nil] at hu; omega
    · exact ker_under_cons_nil _ _ _ _ hu
    · exact ker_under_cons_nil _ _ _ _ hu
  · exact key ((ker_under_transport hsd hrd hkd (Or.inl ⟨hp, hc, ho, rfl⟩)).1 hu)
  · exact key ((ker_under_transport hsd hrd hkd (Or.inr (Or.inl ⟨e, rest, hp, he, rfl⟩))).1 hu)
  · exact key ((ker_under_transport hsd hrd hkd
      (Or.inr (Or.inr ⟨ci, e, rest, hp, hci, ho, rfl⟩))).1 hu)

/-- T3.2i helper: shifting an entry does not change which addresses below it are columns. -/
theorem ker_isSome_shift_entry (r d : Nat) (o : Option (Nat × Forest)) (rest : List (Nat × Nat))
    (c : Nat) :
    (((o.map fun x => (shiftVal r d x.1, Tree.map (shiftVal r d) x.2)).bind
        fun x => x.2.forestAt rest).bind fun f => f.cols[c]?).isSome =
      ((o.bind fun x => x.2.forestAt rest).bind fun f => f.cols[c]?).isSome := by
  cases o with
  | none => rfl
  | some x =>
    simp only [Option.map_some, Option.bind_some]
    rw [ker_forestAt_map]
    cases x.2.forestAt rest with
    | none => rfl
    | some F => simp [ker_map_cols, List.getElem?_map]

theorem ker_isSome_shift_entry' (r d : Nat) (o : Option (Nat × Forest)) (rest : List (Nat × Nat))
    (c : Nat) :
    (((o.map fun x => (x.1, shift r d x.2)).bind
        fun x => x.2.forestAt rest).bind fun f => f.cols[c]?).isSome =
      ((o.bind fun x => x.2.forestAt rest).bind fun f => f.cols[c]?).isSome := by
  cases o with
  | none => rfl
  | some x =>
    simp only [Option.map_some, Option.bind_some]
    unfold shift
    rw [ker_forestAt_map]
    cases x.2.forestAt rest with
    | none => rfl
    | some F => simp [ker_map_cols, List.getElem?_map]

/-- T3.2i helper: every column of the open kernel outside its hole region is a template image. -/
theorem ker_kerOpen_preimage {A : Forest} {sd : StopData} {rd : RootData}
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) (hkd : KernelDefined A rd)
    {y : ColAddr} (hy : y ∈ (kerOpen A sd rd).colAddrs) (hu : ¬ KerUnder (kerHole sd rd) y) :
    ∃ a, (a = rd.col ∨ IsTmplCol A sd rd a) ∧ kerCol sd rd a = some y := by
  obtain ⟨hF, -⟩ := ker_route_rootForest hsd hrd
  obtain ⟨-, -, hidx, -, -, hmem, -⟩ := rootData_spec hsd hrd
  obtain ⟨hkc, -⟩ := ker_kerCol_stop hsd hrd hkd
  obtain ⟨G, hG, hGlen, hGc⟩ := ker_stopForest hsd
  have hne_stop : ∀ a, kerCol sd rd a = some y → a ≠ sd.col := by
    intro a ha h
    subst h
    rw [hkc] at ha
    cases ha
    exact hu ((ker_under_pre (kerHole sd rd).path _ _).2 le_rfl)
  have htmpl : ∀ a, a ∈ A.colAddrs → a ≠ rd.col → kerCol sd rd a = some y →
      ∃ a, (a = rd.col ∨ IsTmplCol A sd rd a) ∧ kerCol sd rd a = some y := by
    intro a ha hr hk
    exact ⟨a, Or.inr ⟨ha, hne_stop a hk, hr, by rw [hk]; rfl⟩, hk⟩
  rcases hFF : rootForest A rd with ⟨cs⟩
  rw [hFF] at hF
  have hU : unconsumed A rd = ((cs[rd.idx]?).getD []).drop rd.cursor := by
    unfold unconsumed rootCol Tree.colAt; rw [hF, Option.bind_some, hidx]; rfl
  have hK0 : (kerOpen A sd rd).cols[0]? = some (sd.Q ++ (unconsumed A rd).map fun x =>
      (x.1, shift sd.r (period sd) x.2)) := by
    unfold kerOpen; split <;> rfl
  have hK1 : ∀ k, (kerOpen A sd rd).cols[k + 1]? =
      if rd.owner then none else (cs[rd.idx + 1 + k]?).map
        (Tree.mapCol (shiftVal sd.r (period sd))) := by
    intro k
    unfold kerOpen
    split
    · rename_i ho; simp [ho, Tree.cols]
    · rename_i ho
      simp only [ho, Bool.false_eq_true, if_false, hFF, ker_shift_node, Tree.cols,
        List.getElem?_cons_succ, List.getElem?_map, List.getElem?_drop]
  have hcolA : ∀ c, A.colAt ⟨rd.col.path, c⟩ = cs[c]? := by
    intro c; unfold Tree.colAt; rw [hF]; rfl
  have hfA : ∀ ci e rest, A.forestAt (rd.col.path ++ (ci, e) :: rest) =
      ((cs[ci]?).bind (·[e]?)).bind fun x => x.2.forestAt rest := by
    intro ci e rest; rw [Tree.forestAt_append, hF, Option.bind_some, ker_forestAt_cons]; rfl
  obtain ⟨yp, yc⟩ := y
  rw [Tree.mem_colAddrs_iff] at hy
  cases yp with
  | nil =>
    cases yc with
    | zero => exact ⟨rd.col, Or.inl rfl, ker_kerCol_root hsd hrd⟩
    | succ k =>
      have hy' : ((kerOpen A sd rd).cols[k + 1]?).isSome := hy
      rw [hK1] at hy'
      by_cases ho : rd.owner = true
      · rw [if_pos ho] at hy'; cases hy'
      rw [if_neg ho] at hy'
      have ho' : rd.owner = false := by simpa using ho
      refine htmpl ⟨rd.col.path, rd.idx + (k + 1)⟩ ?_ ?_ ?_
      · rw [Tree.mem_colAddrs_iff, hcolA]
        rw [show rd.idx + (k + 1) = rd.idx + 1 + k by omega]
        simpa using hy'
      · intro h; have := congrArg ColAddr.col h; simp only at this; omega
      · have hq0 : isQMat sd ⟨rd.col.path, rd.idx + (k + 1)⟩ = false :=
          ker_isQMat_rootpath hsd hrd rfl
        unfold kerCol
        rw [if_neg (by rw [hq0]; simp), if_pos (List.take_length), List.drop_length]
        simp only
        rw [if_neg (by omega), if_pos ⟨by omega, ho'⟩]
        congr 2; omega
  | cons x rest =>
    obtain ⟨c0, e0⟩ := x
    have hy' : ((((kerOpen A sd rd).cols[c0]?).bind (·[e0]?)).bind fun x =>
        x.2.forestAt rest).bind (fun f => f.cols[yc]?) |>.isSome := by
      unfold Tree.colAt at hy; rw [ker_forestAt_cons] at hy; exact hy
    cases c0 with
    | zero =>
      rw [hK0, Option.bind_some] at hy'
      rcases Nat.lt_or_ge e0 sd.Q.length with he | he
      · -- query material
        rw [List.getElem?_append_left he] at hy'
        refine htmpl ⟨sd.col.path ++ (sd.col.col, e0) :: rest, yc⟩ ?_ ?_ ?_
        · rw [Tree.mem_colAddrs_iff]
          unfold Tree.colAt
          simp only
          rw [Tree.forestAt_append, hG, Option.bind_some, ker_forestAt_cons, hGc, Option.bind_some,
            List.getElem?_append_left he]
          exact hy'
        · intro h
          have := congrArg (fun c : ColAddr => c.path.length) h
          have hle := (ker_rootPath hsd hrd).2
          have hdep := (stopData_spec hsd).2.1
          have hlay := (rootData_path hsd hrd).2.2.1
          simp at this; omega
        · unfold kerCol
          have hq : isQMat sd ⟨sd.col.path ++ (sd.col.col, e0) :: rest, yc⟩ = true := by
            unfold isQMat; simp only [List.take_left' rfl, List.drop_left' rfl]; simp [he]
          rw [if_pos hq]
          simp only [List.drop_left' rfl]
      · -- restored root entries
        rw [List.getElem?_append_right he, List.getElem?_map, hU, List.getElem?_drop] at hy'
        set e := rd.cursor + (e0 - sd.Q.length) with he_def
        have hyform : (⟨(0, e0) :: rest, yc⟩ : ColAddr) =
            ⟨(0, sd.Q.length + (e - rd.cursor)) :: rest, yc⟩ := by
          congr 3; omega
        have htr := ker_under_transport hsd hrd hkd (a := ⟨rd.col.path ++ (rd.idx, e) :: rest, yc⟩)
          (Or.inr (Or.inl ⟨e, rest, rfl, by omega, hyform⟩))
        have hnu : ¬ KerUnder sd.col ⟨rd.col.path ++ (rd.idx, e) :: rest, yc⟩ :=
          fun h => hu (htr.2 h)
        have hq : isQMat sd ⟨rd.col.path ++ (rd.idx, e) :: rest, yc⟩ = false := by
          cases h : isQMat sd ⟨rd.col.path ++ (rd.idx, e) :: rest, yc⟩
          · rfl
          · exact absurd (ker_qmat_under h) hnu
        refine htmpl ⟨rd.col.path ++ (rd.idx, e) :: rest, yc⟩ ?_ ?_ ?_
        · rw [Tree.mem_colAddrs_iff]
          unfold Tree.colAt
          simp only
          rw [hfA]
          cases hR : cs[rd.idx]? with
          | none => rw [hR] at hy'; simp at hy'
          | some R =>
            rw [hR, Option.getD_some] at hy'
            rw [Option.bind_some, ← ker_isSome_shift_entry' sd.r (period sd)]
            exact hy'
        · intro h
          have := congrArg (fun c : ColAddr => c.path.length) h
          simp at this
        · unfold kerCol
          rw [if_neg (by rw [hq]; simp), if_pos (List.take_left' rfl), List.drop_left' rfl]
          simp only
          rw [if_pos (by refine ⟨?_, ?_⟩ <;> first | trivial | rfl | omega), ← hyform]
    | succ k =>
      rw [hK1] at hy'
      by_cases ho : rd.owner = true
      · rw [if_pos ho] at hy'; cases hy'
      rw [if_neg ho] at hy'
      have ho' : rd.owner = false := by simpa using ho
      set ci := rd.idx + 1 + k with hci
      have hyform : (⟨(k + 1, e0) :: rest, yc⟩ : ColAddr) = ⟨(ci - rd.idx, e0) :: rest, yc⟩ := by
        congr 3; omega
      have htr := ker_under_transport hsd hrd hkd (a := ⟨rd.col.path ++ (ci, e0) :: rest, yc⟩)
        (Or.inr (Or.inr ⟨ci, e0, rest, rfl, by omega, ho', hyform⟩))
      have hnu : ¬ KerUnder sd.col ⟨rd.col.path ++ (ci, e0) :: rest, yc⟩ := fun h => hu (htr.2 h)
      have hq : isQMat sd ⟨rd.col.path ++ (ci, e0) :: rest, yc⟩ = false := by
        cases h : isQMat sd ⟨rd.col.path ++ (ci, e0) :: rest, yc⟩
        · rfl
        · exact absurd (ker_qmat_under h) hnu
      refine htmpl ⟨rd.col.path ++ (ci, e0) :: rest, yc⟩ ?_ ?_ ?_
      · rw [Tree.mem_colAddrs_iff]
        unfold Tree.colAt
        simp only
        rw [hfA]
        cases hR : cs[ci]? with
        | none => rw [hR] at hy'; simp at hy'
        | some R =>
          rw [hR, Option.map_some, Option.bind_some, treeMapCol_eq_map, List.getElem?_map] at hy'
          rw [Option.bind_some, ← ker_isSome_shift_entry sd.r (period sd)]
          exact hy'
      · intro h
        have := congrArg (fun c : ColAddr => c.path.length) h
        simp at this
      · unfold kerCol
        rw [if_neg (by rw [hq]; simp), if_pos (List.take_left' rfl), List.drop_left' rfl]
        simp only
        rw [if_neg (by omega), if_pos ⟨by omega, ho'⟩, ← hyform]

/-- T3.2i helper: placement under a fixed hole is injective. -/
theorem ker_underCol_inj (h : ColAddr) {y y' : ColAddr} (hy : underCol h y = underCol h y') :
    y = y' := by
  obtain ⟨yp, yc⟩ := y
  obtain ⟨yp', yc'⟩ := y'
  cases yp with
  | nil =>
    cases yp' with
    | nil =>
      simp only [underCol, ColAddr.mk.injEq] at hy ⊢
      exact ⟨trivial, by omega⟩
    | cons x rest =>
      obtain ⟨c0, e0⟩ := x
      simp only [underCol, ColAddr.mk.injEq] at hy
      have := congrArg List.length hy.1; simp at this
  | cons x rest =>
    obtain ⟨c0, e0⟩ := x
    cases yp' with
    | nil =>
      simp only [underCol, ColAddr.mk.injEq] at hy
      have := congrArg List.length hy.1; simp at this
    | cons x' rest' =>
      obtain ⟨c0', e0'⟩ := x'
      simp only [underCol, ColAddr.mk.injEq, List.append_cancel_left_eq, List.cons.injEq,
        Prod.mk.injEq] at hy ⊢
      obtain ⟨⟨⟨h1, h2⟩, h3⟩, h4⟩ := hy
      exact ⟨⟨⟨by omega, h2⟩, h3⟩, h4⟩

/-- T3.2i helper: iterated placements of addresses outside the hole region are injective. -/
theorem ker_iter_inj (h : ColAddr) {b b' : ColAddr} (hb : ¬ KerUnder h b)
    (hb' : ¬ KerUnder h b') :
    ∀ p q, (underCol h)^[p] b = (underCol h)^[q] b' → p = q ∧ b = b'
  | 0, 0, e => ⟨rfl, e⟩
  | 0, q + 1, e => by
    rw [Function.iterate_zero_apply, Function.iterate_succ_apply'] at e
    have := ker_under_underCol h ((underCol h)^[q] b')
    rw [← e] at this
    exact absurd this hb
  | p + 1, 0, e => by
    rw [Function.iterate_zero_apply, Function.iterate_succ_apply'] at e
    have := ker_under_underCol h ((underCol h)^[p] b)
    rw [e] at this
    exact absurd this hb'
  | p + 1, q + 1, e => by
    rw [Function.iterate_succ_apply', Function.iterate_succ_apply'] at e
    obtain ⟨h1, h2⟩ := ker_iter_inj h hb hb' p q (ker_underCol_inj h e)
    exact ⟨by omega, h2⟩

-- T3.2i (txt:318-330): every column of the output is a context column or exactly one phase copy
theorem classify_cols {A B : Forest} {sd : StopData} {rd : RootData} {n : Nat} (hL : InL A)
    (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd) (hrd : rootData A = some rd)
    (hB : expand A n = some B) {c : ColAddr} (hc : c ∈ B.colAddrs) :
    (c ∈ (context A sd Tree.empty).colAddrs ∧ c ≠ sd.col) ∨
      ∃ i a, 1 ≤ i ∧ i ≤ n ∧ (a = rd.col ∨ IsTmplCol A sd rd a) ∧ phaseCol sd rd i a = some c ∧
        ∀ i' a', 1 ≤ i' → i' ≤ n → (a' = rd.col ∨ IsTmplCol A sd rd a') →
          phaseCol sd rd i' a' = some c → i' = i ∧ a' = a := by
  have hkd := ker_kernelDefined hL hsd hrd
  obtain ⟨hV, hI, -⟩ := hL
  obtain ⟨hBeq, -⟩ := ker_expand_out hV hI hk hsd hrd hB
  subst hBeq
  -- the columns of the iterates
  have hZ : ∀ m (y : ColAddr), y ∈ ((kernel A sd rd)^[m] Tree.empty).colAddrs →
      ∃ i a a', 1 ≤ i ∧ i ≤ m ∧ (a = rd.col ∨ IsTmplCol A sd rd a) ∧
        kerCol sd rd a = some a' ∧ y = (underCol (kerHole sd rd))^[i - 1] a' := by
    intro m
    induction m with
    | zero =>
      intro y hy
      rw [Tree.mem_colAddrs_iff] at hy
      exfalso
      unfold Tree.colAt at hy
      cases hp : y.path with
      | nil => rw [hp] at hy; simp [Tree.forestAt, Tree.empty, Tree.cols] at hy
      | cons x rest =>
        obtain ⟨c0, e0⟩ := x
        rw [hp, ker_forestAt_cons] at hy
        simp [Tree.empty, Tree.cols] at hy
    | succ m ih =>
      intro y hy
      rw [Function.iterate_succ_apply'] at hy
      obtain ⟨hko, hR, hH⟩ := ker_kernel_open hsd hrd hkd ((kernel A sd rd)^[m] Tree.empty)
      rw [hko] at hy
      by_cases hu : KerUnder (kerHole sd rd) y
      · have hu' := hu
        rw [← hH] at hu'
        obtain ⟨y', hy', rfl⟩ := ker_under_exhaust _ hR hu' hy
        have hy'' : y' ∈ ((kernel A sd rd)^[m] Tree.empty).colAddrs := by
          rw [Tree.mem_colAddrs_iff] at hy' ⊢
          rw [(ker_shift_law _ _ _ _).1] at hy'
          simpa using hy'
        obtain ⟨i, a, a', hi1, hi2, ha, hka, rfl⟩ := ih y' hy''
        refine ⟨i + 1, a, a', by omega, by omega, ha, hka, ?_⟩
        rw [hH, Nat.add_sub_cancel, show i = (i - 1) + 1 by omega, Function.iterate_succ_apply']
        simp only [Nat.add_sub_cancel]
      · have hu' := hu
        rw [← hH] at hu'
        have hk0 : y ∈ (kerOpen A sd rd).colAddrs := by
          rw [Tree.mem_colAddrs_iff] at hy ⊢
          rw [← ker_off_isSome _ _ _ hR y hu']
          exact hy
        obtain ⟨a, ha, hka⟩ := ker_kerOpen_preimage hsd hrd hkd hk0 hu
        exact ⟨1, a, y, le_rfl, by omega, ha, hka, rfl⟩
  obtain ⟨hRA, hHA⟩ := ker_stop_hole hsd
  have hc' : c ∈ (replaceAt 0 0 ((kernel A sd rd)^[n] Tree.empty) sd.depth A).colAddrs := hc
  by_cases hu : KerUnder sd.col c
  · right
    rw [← hHA] at hu
    obtain ⟨y, hy, rfl⟩ := ker_under_exhaust _ hRA hu hc'
    obtain ⟨i, a, a', hi1, hi2, ha, hka, rfl⟩ := hZ n y hy
    refine ⟨i, a, hi1, hi2, ha, ?_, ?_⟩
    · unfold phaseCol; rw [hka, hHA]; rfl
    · intro i' a'' hi1' hi2' ha'' hc''
      unfold phaseCol at hc''
      cases hk'' : kerCol sd rd a'' with
      | none => rw [hk''] at hc''; cases hc''
      | some b' =>
        rw [hk'', Option.map_some, Option.some.injEq, hHA] at hc''
        have e := ker_underCol_inj sd.col hc''
        obtain ⟨h1, h2⟩ := ker_iter_inj (kerHole sd rd)
          (ker_kerCol_not_under hsd hrd hkd ha'' hk'') (ker_kerCol_not_under hsd hrd hkd ha hka)
          _ _ e
        subst h2
        exact ⟨by omega, ker_kerCol_inj hk'' hka⟩
  · left
    refine ⟨?_, ?_⟩
    · rw [Tree.mem_colAddrs_iff] at hc' ⊢
      have hu' : ¬ KerUnder (kerHoleAt sd.depth A) c := by rw [hHA]; exact hu
      have h1 := ker_off_isSome ((kernel A sd rd)^[n] Tree.empty) _ _ hRA c hu'
      have h2 := ker_off_isSome Tree.empty _ _ hRA c hu'
      show ((replaceAt 0 0 Tree.empty sd.depth A).colAt c).isSome = true
      rw [h2, ← h1]
      exact hc'
    · intro h
      subst h
      exact hu ((ker_under_pre _ _ _).2 le_rfl)

-- T3.2i: printed numbers of phase copies
theorem num_phaseCol {A : Forest} {sd : StopData} {rd : RootData} {i : Nat} {a c : ColAddr}
    (hL : InL A) (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) (ha : a = rd.col ∨ IsTmplCol A sd rd a) (hi : 1 ≤ i)
    (hc : phaseCol sd rd i a = some c) : c.num 0 = a.num 0 + phaseOff sd i a * period sd := by
  have hkd := ker_kernelDefined hL hsd hrd
  have hrt := (rootData_spec hsd hrd).2.2.2.2.1
  have ht := (stopData_spec hsd).2.2.1
  unfold phaseCol at hc
  cases hk' : kerCol sd rd a with
  | none => rw [hk'] at hc; cases hc
  | some a' =>
    rw [hk', Option.map_some, Option.some.injEq] at hc
    subst hc
    have h1 := ker_num_kerCol hsd hrd hk'
    have h2 := ker_num_kerHole hsd hrd hkd
    rw [ker_num_underCol, ker_num_iterate, show (kerHole sd rd).num 0 = sd.t - sd.r by omega]
    unfold phaseOff period
    by_cases hq : isQMat sd a = true
    · rw [if_pos hq] at h1 ⊢
      omega
    · rw [if_neg hq] at h1 ⊢
      obtain ⟨i', rfl⟩ : ∃ i', i = i' + 1 := ⟨i - 1, by omega⟩
      rw [Nat.add_sub_cancel, Nat.succ_mul]
      omega

-- T3.2i: a closed template column is a pure copy (parents and heights shifted by its phase)
theorem colAt_phaseCol {A B : Forest} {sd : StopData} {rd : RootData} {n i : Nat} {a c : ColAddr}
    (hL : InL A) (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) (hB : expand A n = some B) (hi : 1 ≤ i ∧ i ≤ n)
    (ha : IsTmplCol A sd rd a) (hroute : ¬ OnHoleRoute sd a) (hc : phaseCol sd rd i a = some c) :
    B.colAt c = (A.colAt a).map (Tree.mapCol (shiftVal sd.r (phaseOff sd i a * period sd))) := by
  have hkd := ker_kernelDefined hL hsd hrd
  obtain ⟨hV, hI, -⟩ := hL
  obtain ⟨hBeq, -⟩ := ker_expand_out hV hI hk hsd hrd hB
  subst hBeq
  unfold phaseCol at hc
  cases hk' : kerCol sd rd a with
  | none => rw [hk'] at hc; cases hc
  | some a' =>
    rw [hk', Option.map_some, Option.some.injEq] at hc
    subst hc
    rw [(ker_context_law hsd _ _).1]
    have hit := (ker_iterate_law hsd hrd hkd (i - 1) (n - (i - 1)) a').1
    rw [show n - (i - 1) + (i - 1) = n by omega] at hit
    rw [hit, show n - (i - 1) = (n - i) + 1 by omega, Function.iterate_succ_apply']
    unfold phaseOff
    by_cases hq : isQMat sd a = true
    · rw [if_pos hq, (ker_kernel_qmat hsd _ hq hk').1]
    · rw [if_neg hq]
      simp only [Bool.not_eq_true] at hq
      rw [(ker_kernel_roottail hV hsd hrd _ hq ha.2.2.1 hk').1]
      have hoff := ker_context_offroute hsd ((kernel A sd rd)^[n - i] Tree.empty) ha.1 hq hroute
      have hcol : (context A sd ((kernel A sd rd)^[n - i] Tree.empty)).colAt a = A.colAt a := by
        unfold Tree.colAt; rw [hoff]
      rw [hcol, Option.map_map]
      congr 1
      funext x
      rw [Function.comp, treeMapCol_map, shiftVal_add]
      congr 2
      obtain ⟨i', rfl⟩ : ∃ i', i = i' + 1 := ⟨i - 1, by omega⟩
      rw [Nat.add_sub_cancel, Nat.succ_mul, Nat.add_comm]

-- T3.2i: the head column of layer `i`: `τ_{i−1}(Q)` then the restored entries of `U` with
-- phase-`i` heights (the last one a continuation in the owner case)
theorem colAt_head {A B : Forest} {sd : StopData} {rd : RootData} {n i : Nat} {c : ColAddr}
    (hL : InL A) (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) (hB : expand A n = some B) (hi : 1 ≤ i ∧ i ≤ n)
    (hc : phaseCol sd rd i rd.col = some c) :
    ∃ col, B.colAt c = some col ∧ col.length = sd.Q.length + (unconsumed A rd).length ∧
      col.take sd.Q.length = Tree.mapCol (shiftVal sd.r ((i - 1) * period sd)) sd.Q ∧
      ∀ v x, (unconsumed A rd)[v]? = some x → ∃ y, col[sd.Q.length + v]? = some y ∧ y.1 = x.1 ∧
        (¬ (rd.owner = true ∧ v + 1 = (unconsumed A rd).length) →
          y.2 = shift sd.r (i * period sd) x.2) := by
  have hkd := ker_kernelDefined hL hsd hrd
  obtain ⟨hV, hI, -⟩ := hL
  have hU := ker_unconsumed_lt hV hsd hrd
  obtain ⟨hBeq, -⟩ := ker_expand_out hV hI hk hsd hrd hB
  subst hBeq
  unfold phaseCol at hc
  rw [ker_kerCol_root hsd hrd, Option.map_some, Option.some.injEq] at hc
  subst hc
  rw [(ker_context_law hsd _ _).1]
  have hit := (ker_iterate_law hsd hrd hkd (i - 1) (n - (i - 1)) ⟨[], 0⟩).1
  rw [show n - (i - 1) + (i - 1) = n by omega] at hit
  rw [hit, show n - (i - 1) = (n - i) + 1 by omega, Function.iterate_succ_apply']
  obtain ⟨V, hV0, hVlen, hVent⟩ := ker_kernel_col0 A sd rd ((kernel A sd rd)^[n - i] Tree.empty)
  rw [hV0, Option.map_some]
  refine ⟨_, rfl, ?_, ?_, ?_⟩
  · rw [treeMapCol_eq_map, List.length_map, List.length_append, hVlen]
  · rw [ker_mapCol_append, List.take_left' (by rw [treeMapCol_eq_map, List.length_map])]
  · intro v x hx
    have hxm : x ∈ unconsumed A rd := List.mem_of_getElem? hx
    obtain ⟨y, hy, hy1, hy2⟩ := hVent v x hx
    have hlenQ : (Tree.mapCol (shiftVal sd.r ((i - 1) * period sd)) sd.Q).length ≤
        sd.Q.length + v := by rw [treeMapCol_eq_map, List.length_map]; omega
    rw [ker_mapCol_append, List.getElem?_append_right hlenQ, treeMapCol_eq_map, treeMapCol_eq_map,
      List.length_map, Nat.add_sub_cancel_left, List.getElem?_map, hy]
    have := hU x hxm
    refine ⟨_, rfl, ?_, fun h => ?_⟩
    · show shiftVal sd.r ((i - 1) * period sd) y.1 = x.1
      rw [hy1]; unfold shiftVal; rw [if_neg (by omega)]
    · show shift sd.r ((i - 1) * period sd) y.2 = _
      rw [hy2 h, shift_add]
      congr 1
      obtain ⟨i', rfl⟩ : ∃ i', i = i' + 1 := ⟨i - 1, by omega⟩
      rw [Nat.add_sub_cancel, Nat.succ_mul]

-- T3.2i/T3.2l: local suffixes of phase copies; root-tail material reads the shorter output
-- `A_{n−i}` (txt:586-592)
theorem localSuffix_phase {A B A' : Forest} {sd : StopData} {rd : RootData} {n i : Nat}
    {a c : ColAddr} (hL : InL A) (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) (hB : expand A n = some B) (hi : 1 ≤ i ∧ i ≤ n)
    (ha : IsTmplCol A sd rd a) (hc : phaseCol sd rd i a = some c)
    (hA' : expand A (n - i) = some A') :
    localSuffix B c = (if isQMat sd a then shift sd.r ((i - 1) * period sd) (localSuffix A a)
      else shift sd.r (i * period sd) (localSuffix A' a)) := by
  have hkd := ker_kernelDefined hL hsd hrd
  obtain ⟨hV, hI, -⟩ := hL
  obtain ⟨hBeq, -⟩ := ker_expand_out hV hI hk hsd hrd hB
  obtain ⟨hA'eq, -⟩ := ker_expand_out hV hI hk hsd hrd hA'
  subst hBeq hA'eq
  unfold phaseCol at hc
  cases hk' : kerCol sd rd a with
  | none => rw [hk'] at hc; cases hc
  | some a' =>
    rw [hk', Option.map_some, Option.some.injEq] at hc
    subst hc
    rw [(ker_context_law hsd _ _).2]
    have hit := (ker_iterate_law hsd hrd hkd (i - 1) (n - (i - 1)) a').2
    rw [show n - (i - 1) + (i - 1) = n by omega] at hit
    rw [hit, show n - (i - 1) = (n - i) + 1 by omega, Function.iterate_succ_apply']
    by_cases hq : isQMat sd a = true
    · rw [if_pos hq, (ker_kernel_qmat hsd _ hq hk').2]
    · rw [if_neg hq]
      simp only [Bool.not_eq_true] at hq
      rw [(ker_kernel_roottail hV hsd hrd _ hq ha.2.2.1 hk').2, shift_add]
      congr 1
      obtain ⟨i', rfl⟩ : ∃ i', i = i' + 1 := ⟨i - 1, by omega⟩
      rw [Nat.add_sub_cancel, Nat.succ_mul]

-- T3.2i: the local suffix at the head of layer `i` is the shifted remaining iterate
-- `τ_{i−1}(F^{n−i+1}(∅))`
theorem localSuffix_head {A B : Forest} {sd : StopData} {rd : RootData} {n i : Nat} {c : ColAddr}
    (hL : InL A) (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) (hB : expand A n = some B) (hi : 1 ≤ i ∧ i ≤ n)
    (hc : phaseCol sd rd i rd.col = some c) :
    localSuffix B c = shift sd.r ((i - 1) * period sd) ((kernel A sd rd)^[n - i + 1] Tree.empty) := by
  have hkd := ker_kernelDefined hL hsd hrd
  obtain ⟨hV, hI, -⟩ := hL
  obtain ⟨hBeq, -⟩ := ker_expand_out hV hI hk hsd hrd hB
  subst hBeq
  unfold phaseCol at hc
  rw [ker_kerCol_root hsd hrd, Option.map_some, Option.some.injEq] at hc
  subst hc
  rw [(ker_context_law hsd _ _).2]
  have hit := (ker_iterate_law hsd hrd hkd (i - 1) (n - (i - 1)) ⟨[], 0⟩).2
  rw [show n - (i - 1) + (i - 1) = n by omega] at hit
  rw [hit, show n - (i - 1) = n - i + 1 by omega]
  congr 1
  unfold localSuffix
  simp only [Tree.forestAt, Option.getD_some, List.drop_zero, ker_node_cols]

-- T3.2l (txt:345-349): a changed continuation is smaller than its complete prototype, with its
-- first difference at the old terminal
theorem localSuffix_cont_le {A A' : Forest} {sd : StopData} {rd : RootData} {n : Nat} {a : ColAddr}
    (hL : InL A) (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd)
    (hrd : rootData A = some rd) (hA' : expand A n = some A') (ha : IsTmplCol A sd rd a ∨ a = rd.col) :
    localSuffix A' a ≤ localSuffix A a ∧ (OnHoleRoute sd a ∨ a = rd.col ∧ rd.owner = true →
      localSuffix A' a < localSuffix A a) := by
  obtain ⟨hV, hI, -⟩ := hL
  obtain ⟨hA'eq, -⟩ := ker_expand_out hV hI hk hsd hrd hA'
  subst hA'eq
  have hU := ker_unconsumed_lt hV hsd hrd
  have hamem : a ∈ A.colAddrs := by
    rcases ha with h | rfl
    · exact h.1
    · exact (rootData_spec hsd hrd).2.2.2.2.2.1
  have hrdpre : rd.col.path <+: sd.col.path := (rootData_path hsd hrd).2.2.2.1
  rcases ker_path_cases a.path sd.col.path with hpre | ⟨x, rest, hx⟩ | ⟨j, hj1, hj2, hj3, hj4⟩
  · -- on the hole route: the hole is the last part of the local suffix
    obtain ⟨hR, hY⟩ := ker_localSuffix_prefix hsd hpre hamem
    have hlt : localSuffix (context A sd ((kernel A sd rd)^[n] Tree.empty)) a <
        localSuffix A a := by
      rw [hY]
      conv_rhs => rw [← ker_replaceAt_self _ _ _ hR]
      exact ker_replaceAt_lt (ker_routeTo_route _ _ _ hR) (ker_iterate_lt_stop hU n)
    exact ⟨le_of_lt hlt, fun _ => hlt⟩
  · -- below the stopping forest: unchanged, or deleted with the query (`n = 0`)
    have hnot : ¬ (OnHoleRoute sd a ∨ a = rd.col ∧ rd.owner = true) := by
      rintro (h | ⟨rfl, -⟩)
      · have := h.length_le; rw [hx] at this; simp at this
      · have := hrdpre.length_le; rw [hx] at this; simp at this
    refine ⟨?_, fun h => absurd h hnot⟩
    obtain ⟨c', e'⟩ := x
    obtain ⟨G, hG, hGlen, hGc⟩ := ker_stopForest hsd
    obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff A a).1 hamem)
    unfold Tree.colAt at hcol
    rw [hx, Tree.forestAt_append, hG, Option.bind_some, ker_forestAt_cons] at hcol
    cases hgc : G.cols[c']? with
    | none => rw [hgc] at hcol; cases hcol
    | some gc =>
      rw [hgc, Option.bind_some] at hcol
      have hc'lt : c' < sd.col.col + 1 := by
        rw [← hGlen]; by_contra h; rw [List.getElem?_eq_none (by omega)] at hgc; cases hgc
      have hequal : ∀ Y, (context A sd Y).forestAt a.path = A.forestAt a.path →
          localSuffix (context A sd Y) a ≤ localSuffix A a := by
        intro Y hY; unfold localSuffix; rw [hY]
      rcases Nat.lt_or_ge c' sd.col.col with hlt | hge
      · apply hequal
        rw [hx]
        exact ker_context_forestAt_stop hsd _ rest (Or.inl hlt)
      · have hc' : c' = sd.col.col := by omega
        subst hc'
        rw [hGc] at hgc
        cases hgc
        have he : e' < sd.Q.length := by
          rcases Nat.lt_or_ge e' sd.Q.length with h | h
          · exact h
          · exfalso
            cases he' : (sd.Q ++ [(sd.r, Tree.empty)])[e']? with
            | none => rw [he'] at hcol; cases hcol
            | some y =>
              rw [he', Option.bind_some] at hcol
              have hy : y = (sd.r, Tree.empty) := by
                rw [List.getElem?_append_right h] at he'
                rcases Nat.lt_or_ge (e' - sd.Q.length) 1 with h1 | h1
                · rw [show e' - sd.Q.length = 0 by omega] at he'
                  simp at he'; exact he'.symm
                · rw [List.getElem?_eq_none (by simp; omega)] at he'; cases he'
              subst hy
              cases rest with
              | nil => simp [Tree.forestAt, Tree.empty, Tree.cols] at hcol
              | cons z zs =>
                obtain ⟨z1, z2⟩ := z
                simp [ker_forestAt_cons, Tree.empty, Tree.cols] at hcol
        cases n with
        | zero =>
          have hnone : (context A sd ((kernel A sd rd)^[0] Tree.empty)).forestAt a.path = none := by
            rw [hx]; exact ker_context_empty_forestAt_stop hsd e' rest
          have hle : localSuffix (context A sd ((kernel A sd rd)^[0] Tree.empty)) a = Tree.empty := by
            unfold localSuffix; rw [hnone]; simp [Tree.empty, Tree.cols]
          rw [hle]
          by_cases h0 : localSuffix A a = Tree.empty
          · rw [h0]
          · exact le_of_lt (Forest.empty_lt h0)
        | succ n =>
          obtain ⟨V, cs, hker, -⟩ := ker_kernel_firstCol hU ((kernel A sd rd)^[n] Tree.empty)
          apply hequal
          rw [hx]
          refine ker_context_forestAt_stop hsd _ rest (Or.inr ⟨rfl, he, V, cs, ?_⟩)
          rw [Function.iterate_succ_apply', hker]
  · -- leaves the stopping route above the stopping forest: unchanged
    have hnot : ¬ (OnHoleRoute sd a ∨ a = rd.col ∧ rd.owner = true) := by
      rintro (h | ⟨rfl, -⟩)
      · exact hj4 (by rw [List.getElem?_eq_getElem hj1, List.getElem?_eq_getElem hj2,
          h.getElem hj1])
      · exact hj4 (by rw [List.getElem?_eq_getElem hj1, List.getElem?_eq_getElem hj2,
          hrdpre.getElem hj1])
    refine ⟨?_, fun h => absurd h hnot⟩
    unfold localSuffix
    rw [ker_context_forestAt_diverge hsd _ hj2 hj1 hj3 hj4]

/-! T3.2j helpers: first-parent paths. -/

/-- Under V and A every `g_W` path is a `g_∅` path (path nesting with `∅ ≤ W`). -/
theorem spx_path_nil {E : Forest} {ks : KeySys} (hV : CondV E) (hA : CondAK E ks) {c : ColAddr}
    {W : List (WithTop Key)} (hW : W.Pairwise fun x y => y ≤ x) {s t : Nat}
    (h : Path E ks c W s t) : Path E ks c [] s t :=
  path_replace hV (fun _ _ _ he => path_nesting hV hA c List.Pairwise.nil hW (nil_le_list W) he) h

/-- A `g_∅` edge from `x` reads the first parent of the column numbered `x`, and that first parent
is a `g_∅` ancestor of `x - 1` (A at entry `0`). -/
theorem spx_edge_nil {E : Forest} (hV : CondV E) (hA : CondA E) {c : ColAddr} {x y : Nat}
    (h : Edge E (actualKeys E) c [] x y) : Path E (actualKeys E) c [] (x - 1) y := by
  obtain ⟨o, ho, hr⟩ := h
  rw [resp_eq_parents, cursor_nil_right] at hr
  have hoE : o ∈ E.colAddrs := mem_colAddrs_of_parents hr
  have h0 := hA o hoE 0 y hr
  simp only [if_true, cutQuery_zero] at h0
  have hox : o.num 0 = x := ColAddr.resolve_num ho
  have hlt : y < o.num 0 := parent_lt_num hV hr
  rw [hox] at h0 hlt
  exact (path_congr_stack hV (fun q hq => ColAddr.resolve_of_resolve_lt ho hq) (by omega)).1 h0

-- T3.2j (txt:337-340): every body column on the stopping column's stack lies in the subtree of
-- `r`, is nonempty and has first parent at least `r`
theorem body_firstParent {A : Forest} {sd : StopData} (hL : InL A) (hk : stepKind A = some .ordinary)
    (hsd : stopData A = some sd) {x : Nat} (hx1 : sd.r < x) (hx2 : x < sd.t) {o : ColAddr}
    (ho : sd.col.resolve 0 x = some o) :
    ∃ q H rest, A.colAt o = some ((q, H) :: rest) ∧ sd.r ≤ q := by
  obtain ⟨hV, -, -, hA, -⟩ := hL
  obtain ⟨hcol, -, ht, -, -, -⟩ := stopData_spec hsd
  set c := sd.col
  have hcE : c ∈ A.colAddrs := (Tree.mem_colAddrs_iff A c).2 (by rw [hcol]; rfl)
  have hpar : parents A c = (sd.Q ++ [(sd.r, Tree.empty)]).map Prod.fst := by
    simp [parents, hcol]
  -- the A tests of the stopping column chain `t - 1` down to `r`
  have hchain : ∀ (i p : Nat), (parents A c)[i]? = some p → Path A (actualKeys A) c [] (sd.t - 1) p := by
    intro i
    induction i with
    | zero =>
      intro p hp
      have h0 := hA c hcE 0 p hp
      simp only [if_true, cutQuery_zero] at h0
      rw [ht]; exact h0
    | succ i ih =>
      intro p hp
      have hlt : i < (parents A c).length := by
        have := (List.getElem?_eq_some_iff.1 hp).1; omega
      obtain ⟨p', hp'⟩ : ∃ p', (parents A c)[i]? = some p' := ⟨_, List.getElem?_eq_getElem hlt⟩
      have h1 := hA c hcE (i + 1) p hp
      simp only [Nat.add_one_ne_zero, if_false, Nat.add_sub_cancel, hp', Option.getD_some] at h1
      exact (ih p' hp').trans (spx_path_nil hV hA (cutQuery_noninc _ _) h1)
  have hbase : Path A (actualKeys A) c [] (sd.t - 1) sd.r :=
    hchain sd.Q.length sd.r (by rw [hpar]; simp)
  -- downward induction: `r` is a `g_∅` ancestor of every `x` with `r ≤ x < t`
  have key : ∀ n x, x + n = sd.t - 1 → sd.r ≤ x → Path A (actualKeys A) c [] x sd.r := by
    intro n
    induction n with
    | zero => intro x hx _; rw [show x = sd.t - 1 by omega]; exact hbase
    | succ n ih =>
      intro x hx hrx
      rcases Relation.ReflTransGen.cases_head (ih (x + 1) (by omega) (by omega)) with h | ⟨y, hxy, hyr⟩
      · omega
      · have := spx_edge_nil hV hA hxy
        simp only [Nat.add_sub_cancel] at this
        exact this.trans hyr
  have hxr := key (sd.t - 1 - x) x (by omega) (le_of_lt hx1)
  rcases Relation.ReflTransGen.cases_head hxr with h | ⟨y, hxy, hyr⟩
  · omega
  · obtain ⟨o', ho', hr⟩ := hxy
    rw [ho, Option.some.injEq] at ho'
    subst ho'
    rw [resp_eq_parents, cursor_nil_right, parents_getElem?] at hr
    obtain ⟨⟨q, H⟩, he, rfl⟩ := Option.map_eq_some_iff.1 hr
    obtain ⟨col, hcol', hc0⟩ := Tree.colAt_of_entryAt he
    obtain ⟨⟨q', H'⟩, rest, rfl⟩ : ∃ x rest, col = x :: rest := by
      cases col with
      | nil => simp at hc0
      | cons x rest => exact ⟨x, rest, rfl⟩
    simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hc0
    obtain ⟨rfl, rfl⟩ := hc0
    exact ⟨q', H', rest, hcol', path_le hV hyr⟩


/-! T3.2c helpers: the structure of the budgeted walk `spF` behind `safePrefix`. -/

theorem spx_spF_snd_le (k : Nat) (T : Forest) : (spF k T).2 ≤ k := by
  rw [(spF_spec 0 k T).2]; omega

/-- A walk that leaves budget unused keeps the whole forest. -/
theorem spx_spF_full {k : Nat} {T : Forest} (h : (spF k T).2 ≠ 0) : (spF k T).1 = T := by
  rw [(spF_spec 0 k T).2] at h
  exact safePrefix_of_le (by unfold mu word; omega)

theorem spx_spLater_snd_le : ∀ (k : Nat) (col : Column), (spLater k col).2 ≤ k
  | k, [] => by simp [spLater]
  | k, (p, h) :: rest => by
    by_cases hk : k = 0
    · simp [spLater, hk]
    · simp only [spLater, hk, if_false]
      have := spx_spLater_snd_le (spF (k - 1) h).2 rest
      have := spx_spF_snd_le (k - 1) h
      omega

theorem spx_spCol_snd_le : ∀ (k : Nat) (col : Column), (spCol k col).2 ≤ k - 1
  | k, [] => by simp [spCol]
  | k, (p, h) :: rest => by
    simp only [spCol]
    have := spx_spLater_snd_le (spF (k - 1) h).2 rest
    have := spx_spF_snd_le (k - 1) h
    omega

theorem spx_spLater_get : ∀ (k : Nat) (col : Column) (i p : Nat) (h' : Forest),
    (spLater k col).1[i]? = some (p, h') →
      ∃ h k', col[i]? = some (p, h) ∧ h' = (spF k' h).1 ∧ k' < k
  | k, [], i, p, h', hi => by simp [spLater] at hi
  | k, (q, h) :: rest, i, p, h', hi => by
    by_cases hk : k = 0
    · simp [spLater, hk] at hi
    · simp only [spLater, hk, if_false] at hi
      cases i with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hi
        obtain ⟨rfl, rfl⟩ := hi
        exact ⟨h, k - 1, rfl, rfl, by omega⟩
      | succ i =>
        rw [List.getElem?_cons_succ] at hi
        obtain ⟨h₀, k', h1, h2, h3⟩ := spx_spLater_get _ rest i p h' hi
        have := spx_spF_snd_le (k - 1) h
        exact ⟨h₀, k', by simpa using h1, h2, by omega⟩

theorem spx_spCol_get {k : Nat} (hk : 1 ≤ k) {col : Column} {i p : Nat} {h' : Forest}
    (hi : (spCol k col).1[i]? = some (p, h')) :
    ∃ h k', col[i]? = some (p, h) ∧ h' = (spF k' h).1 ∧ k' < k := by
  cases col with
  | nil => simp [spCol] at hi
  | cons x rest =>
    obtain ⟨q, h⟩ := x
    simp only [spCol] at hi
    cases i with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hi
      obtain ⟨rfl, rfl⟩ := hi
      exact ⟨h, k - 1, rfl, rfl, by omega⟩
    | succ i =>
      rw [List.getElem?_cons_succ] at hi
      obtain ⟨h₀, k', h1, h2, h3⟩ := spx_spLater_get _ rest i p h' hi
      have := spx_spF_snd_le (k - 1) h
      exact ⟨h₀, k', by simpa using h1, h2, by omega⟩

theorem spx_spCols_get : ∀ (k : Nat) (cols : List Column) (j : Nat) (col' : Column),
    (spCols k cols).1[j]? = some col' →
      ∃ col k', cols[j]? = some col ∧ col' = (spCol k' col).1 ∧ 1 ≤ k' ∧ k' ≤ k
  | k, [], j, col', hj => by simp [spCols] at hj
  | k, c :: rest, j, col', hj => by
    by_cases hk : k = 0
    · simp [spCols, hk] at hj
    · simp only [spCols, hk, if_false] at hj
      cases j with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq] at hj
        exact ⟨c, k, rfl, hj.symm, by omega, le_rfl⟩
      | succ j =>
        rw [List.getElem?_cons_succ] at hj
        obtain ⟨col, k', h1, h2, h3, h4⟩ := spx_spCols_get _ rest j col' hj
        have := spx_spCol_snd_le k c
        exact ⟨col, k', by simpa using h1, h2, h3, by omega⟩

/-- In a kept column, every entry followed by a kept entry keeps its whole height. -/
theorem spx_spLater_full : ∀ (k : Nat) (col : Column) (i : Nat),
    ((spLater k col).1[i + 1]?).isSome → (spLater k col).1[i]? = col[i]?
  | k, [], i, hi => by simp [spLater] at hi
  | k, (q, h) :: rest, i, hi => by
    by_cases hk : k = 0
    · simp [spLater, hk] at hi
    · simp only [spLater, hk, if_false] at hi ⊢
      cases i with
      | zero =>
        simp only [List.getElem?_cons_zero, List.getElem?_cons_succ] at hi ⊢
        have hne : (spF (k - 1) h).2 ≠ 0 := by
          intro h0; rw [h0] at hi
          cases rest with
          | nil => simp [spLater] at hi
          | cons y ys => simp [spLater] at hi
        rw [spx_spF_full hne]
      | succ i =>
        simp only [List.getElem?_cons_succ] at hi ⊢
        exact spx_spLater_full _ rest i hi

theorem spx_spCol_full {k : Nat} {col : Column} {i : Nat}
    (hi : ((spCol k col).1[i + 1]?).isSome) : (spCol k col).1[i]? = col[i]? := by
  cases col with
  | nil => simp [spCol] at hi
  | cons x rest =>
    obtain ⟨q, h⟩ := x
    simp only [spCol] at hi ⊢
    cases i with
    | zero =>
      simp only [List.getElem?_cons_zero, List.getElem?_cons_succ] at hi ⊢
      have hne : (spF (k - 1) h).2 ≠ 0 := by
        intro h0; rw [h0] at hi
        cases rest with
        | nil => simp [spLater] at hi
        | cons y ys => simp [spLater] at hi
      rw [spx_spF_full hne]
    | succ i =>
      simp only [List.getElem?_cons_succ] at hi ⊢
      exact spx_spLater_full _ rest i hi

/-- Forests of a safe prefix are safe prefixes of the forests at the same path, with a smaller
budget below the outer level. -/
theorem spx_forestAt : ∀ (π : List (Nat × Nat)) (T : Forest) (k : Nat) (F' : Forest),
    (spF k T).1.forestAt π = some F' →
      ∃ F k', T.forestAt π = some F ∧ F' = (spF k' F).1 ∧ k' ≤ k ∧ (π ≠ [] → k' < k)
  | [], T, k, F', h => by
    simp only [Tree.forestAt, Option.some.injEq] at h
    exact ⟨T, k, rfl, h.symm, le_rfl, fun h => absurd rfl h⟩
  | (a, b) :: π, .node cols, k, F', h => by
    rw [spF, Tree.forestAt_cons] at h
    simp only [Tree.cols, Option.bind_eq_some_iff] at h
    obtain ⟨x, ⟨col', hcol', hx⟩, hF⟩ := h
    obtain ⟨col, k₁, hcol, rfl, hk₁, hk₁'⟩ := spx_spCols_get k cols a col' hcol'
    obtain ⟨p, h'⟩ := x
    obtain ⟨h, k₂, hh, rfl, hk₂⟩ := spx_spCol_get hk₁ hx
    obtain ⟨F, k₃, hF1, hF2, hk₃, -⟩ := spx_forestAt π h k₂ F' hF
    refine ⟨F, k₃, ?_, hF2, by omega, fun _ => by omega⟩
    rw [Tree.forestAt_cons]
    simp only [Tree.cols, hcol, Option.bind_some, hh]
    exact hF1

theorem spx_colAt {T : Forest} {k : Nat} {c : ColAddr} {col' : Column}
    (h : (spF k T).1.colAt c = some col') :
    ∃ col k', T.colAt c = some col ∧ col' = (spCol k' col).1 ∧ 1 ≤ k' ∧ k' ≤ k ∧
      (c.path ≠ [] → k' < k) := by
  rw [Tree.colAt, Option.bind_eq_some_iff] at h
  obtain ⟨F', hF', hc⟩ := h
  obtain ⟨F, k₁, hF, rfl, hk₁, hk₁'⟩ := spx_forestAt c.path T k F' hF'
  obtain ⟨cols⟩ := F
  rw [spF] at hc
  obtain ⟨col, k₂, hcol, rfl, hk₂, hk₂'⟩ := spx_spCols_get k₁ cols c.col col' hc
  refine ⟨col, k₂, ?_, rfl, hk₂, by omega, fun hp => by have := hk₁' hp; omega⟩
  rw [Tree.colAt, hF]; exact hcol

theorem spx_entryAt {T : Forest} {k : Nat} {e : EntryAddr} {p : Nat} {h' : Forest}
    (h : (spF k T).1.entryAt e = some (p, h')) :
    ∃ h k', T.entryAt e = some (p, h) ∧ h' = (spF k' h).1 ∧ k' < k := by
  rw [Tree.entryAt, Option.bind_eq_some_iff] at h
  obtain ⟨col', hc', hi⟩ := h
  obtain ⟨col, k₁, hcol, rfl, hk₁, hk₁', -⟩ := spx_colAt hc'
  obtain ⟨H, k₂, hH, rfl, hk₂⟩ := spx_spCol_get hk₁ hi
  exact ⟨H, k₂, by rw [Tree.entryAt, hcol]; exact hH, rfl, by omega⟩

theorem spx_spF_empty (k : Nat) : (spF k (Tree.empty : Forest)).1 = Tree.empty := by
  simp [Tree.empty, spF, spCols]

-- T3.2c (txt:311-312): safe prefixes keep V, I, H
theorem safePrefix_condV {E : Forest} (hV : CondV E) (k : Nat) : CondV (safePrefix E k) := by
  intro e _ p h' he
  obtain ⟨h, -, hE, -, -⟩ := spx_entryAt he
  exact hV e ((Tree.mem_entryAddrs_iff E e).2 (by rw [hE]; rfl)) p h hE

theorem safePrefix_condI {E : Forest} (hI : CondI E) (k : Nat) : CondI (safePrefix E k) := by
  intro e _ p h' he hne col' hcol'
  obtain ⟨h, k', hE, rfl, -⟩ := spx_entryAt he
  obtain ⟨hcols⟩ := h
  have hne' : Tree.node hcols ≠ Tree.empty := by
    intro h0; apply hne; rw [h0]; exact spx_spF_empty k'
  rw [spF] at hcol'
  obtain ⟨j, hj⟩ := List.mem_iff_getElem?.1 hcol'
  obtain ⟨col, k₂, hcol, rfl, hk₂, -⟩ := spx_spCols_get k' hcols j col' hj
  obtain ⟨q, H, rest, rfl, hq⟩ := hI e ((Tree.mem_entryAddrs_iff E e).2 (by rw [hE]; rfl)) p _ hE
    hne' col (List.mem_of_getElem? hcol)
  exact ⟨q, (spF (k₂ - 1) H).1, (spLater (spF (k₂ - 1) H).2 rest).1, by rw [spCol], hq⟩

theorem safePrefix_condH {E : Forest} (hH : CondH E) (k : Nat) : CondH (safePrefix E k) := by
  intro c hc i x y hx hy
  obtain ⟨col', hcol'⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff _ c).1 hc)
  change (spF k E).1.colAt c = some col' at hcol'
  change (((spF k E).1.colAt c).getD [])[i]? = some x at hx
  change (((spF k E).1.colAt c).getD [])[i + 1]? = some y at hy
  rw [hcol', Option.getD_some] at hx hy
  obtain ⟨col, k', hcol, rfl, hk', -⟩ := spx_colAt hcol'
  have hxi := spx_spCol_full (k := k') (col := col) (i := i) (by rw [hy]; rfl)
  rw [hx] at hxi
  obtain ⟨Y, k₂, hY, hYy, -⟩ := spx_spCol_get hk' hy
  have hle := hH c ((Tree.mem_colAddrs_iff E c).2 (by rw [hcol]; rfl)) i x (y.1, Y)
    (by rw [hcol]; exact hxi.symm) (by rw [hcol]; exact hY)
  rcases hle with hlt | ⟨heq, hle⟩
  · exact Or.inl hlt
  · refine Or.inr ⟨heq, le_trans ?_ hle⟩
    rw [hYy]; exact safePrefix_le Y k₂


/-! T3.2d helpers: key order as word order, truncated keys, entries below a height. -/

/-- A strict comparison survives truncating the smaller list strictly earlier. -/
theorem spx_take_lt_take {α : Type} [LinearOrder α] :
    ∀ (Y X : List α) (k₁ k₀ : Nat), Y < X → k₁ < k₀ → Y.take k₁ < X.take k₀
  | _, _, _, 0, _, hk => absurd hk (Nat.not_lt_zero _)
  | _, [], _, _ + 1, h, _ => absurd h (List.not_lt_nil _)
  | [], x :: xs, _, k₀ + 1, _, _ => by simp
  | _ :: _, x :: xs, 0, k₀ + 1, _, _ => by simp
  | y :: ys, x :: xs, k₁ + 1, k₀ + 1, h, hk => by
    rw [List.take_succ_cons, List.take_succ_cons, List.cons_lt_cons_iff]
    rcases List.cons_lt_cons_iff.1 h with h₁ | ⟨h₁, h₂⟩
    · exact Or.inl h₁
    · exact Or.inr ⟨h₁, spx_take_lt_take ys xs k₁ k₀ h₂ (by omega)⟩

/-- Key comparison is comparison of generic words over `Bool ×ₗ Nat`. -/
theorem spx_key_lt_iff (X Y : Key) :
    X < Y ↔ @gword (Lex (Bool × Nat)) X < @gword (Lex (Bool × Nat)) Y :=
  (gword_lt_iff (α := Lex (Bool × Nat)) X Y).symm

/-- The generic word of the key of a safe prefix is the truncated generic word. -/
theorem spx_gword_relKey_safePrefix (a k : Nat) (H : Forest) :
    @gword (Lex (Bool × Nat)) (relKey a (safePrefix H k)) =
      (@gword (Lex (Bool × Nat)) (relKey a H)).take k := by
  change (gword (relKey a (safePrefix H k)) : List (GAtom (Bool × Nat))) =
      (gword (relKey a H) : List (GAtom (Bool × Nat))).take k
  rw [relKey_eq_map, relKey_eq_map, gword_map, gword_map, gword_eq_map_word, gword_eq_map_word,
    word_safePrefix, List.map_take, List.map_take]

/-- T3.2b in key form: truncating the lower height strictly before the upper one keeps `<`. -/
theorem spx_relKey_safePrefix_lt {a b : Nat} {H J : Forest} (h : relKey b J < relKey a H)
    {k₁ k₀ : Nat} (hk : k₁ < k₀) : relKey b (safePrefix J k₁) < relKey a (safePrefix H k₀) := by
  rw [spx_key_lt_iff] at h ⊢
  rw [spx_gword_relKey_safePrefix, spx_gword_relKey_safePrefix]
  exact spx_take_lt_take (α := GAtom (Lex (Bool × Nat))) _ _ _ _ h hk

theorem spx_entryAt_append (t : Forest) (π ρ : List (Nat × Nat)) (j i : Nat) :
    t.entryAt ⟨⟨π ++ ρ, j⟩, i⟩ = (t.forestAt π).bind fun F => F.entryAt ⟨⟨ρ, j⟩, i⟩ := by
  simp only [Tree.entryAt, Tree.colAt, Tree.forestAt_append, Option.bind_assoc]

/-- An entry inside the height of `e0` is read in that height. -/
theorem spx_entryAt_inside (t : Forest) (e0 : EntryAddr) (ρ : List (Nat × Nat)) (j i : Nat) :
    t.entryAt ⟨⟨e0.heightPath ++ ρ, j⟩, i⟩ =
      (t.heightAt e0).bind fun F => F.entryAt ⟨⟨ρ, j⟩, i⟩ := by
  rw [spx_entryAt_append, Tree.forestAt_heightPath]

-- T3.2d (txt:308-311): safe prefixes keep S (containment offsets + word fact)
theorem safePrefix_condS {E : Forest} (hV : CondV E) (hS : CondS E) (k : Nat) :
    CondS (safePrefix E k) := by
  intro e0 he0 e he hret
  obtain ⟨⟨ρ, hρ⟩, q, J', hJ', hres⟩ := hret
  obtain ⟨⟨P, j⟩, i⟩ := e
  dsimp only at hρ
  subst hρ
  obtain ⟨x0, hx0⟩ := Option.isSome_iff_exists.1 ((Tree.mem_entryAddrs_iff _ e0).1 he0)
  obtain ⟨p0, H'⟩ := x0
  obtain ⟨H, k₀, hH, rfl, -⟩ := spx_entryAt (k := k) (T := E) hx0
  have hJ'' := hJ'
  rw [spx_entryAt_inside, Tree.heightAt, hx0] at hJ''
  simp only [Option.map_some, Option.bind_some] at hJ''
  obtain ⟨J, k₁, hJ, rfl, hk⟩ := spx_entryAt hJ''
  have hEe : E.entryAt ⟨⟨e0.heightPath ++ ρ, j⟩, i⟩ = some (q, J) := by
    rw [spx_entryAt_inside, Tree.heightAt, hH]; simpa using hJ
  have hret : IsOwnerReturn E e0 ⟨⟨e0.heightPath ++ ρ, j⟩, i⟩ := ⟨⟨ρ, rfl⟩, q, J, hEe, hres⟩
  have hSE := hS e0 ((Tree.mem_entryAddrs_iff E e0).2 (by rw [hH]; rfl)) _
    ((Tree.mem_entryAddrs_iff E _).2 (by rw [hEe]; rfl)) hret
  rw [Tree.heightAt, Tree.heightAt, hEe, hH] at hSE
  rw [Tree.heightAt, Tree.heightAt, hJ', hx0]
  exact spx_relKey_safePrefix_lt hSE hk


/-! T3.2e helpers: complete columns of a safe prefix, and capped cursors. -/

/-- A column walk that leaves budget unused keeps the whole column. -/
theorem spx_spCol_full_of {k : Nat} (hk : k ≠ 0) {col : Column} (h : (spCol k col).2 ≠ 0) :
    (spCol k col).1 = col := by
  have h2 : (spF k (Tree.node [col])).2 ≠ 0 := by simpa [spF, spCols, hk] using h
  have := spx_spF_full h2
  simp only [spF, spCols, hk, if_false, Tree.node.injEq] at this
  simpa using this

/-- In a safe prefix, a column followed by a kept column is complete. -/
theorem spx_spCols_full : ∀ (k : Nat) (cols : List Column) (j : Nat),
    ((spCols k cols).1[j + 1]?).isSome → (spCols k cols).1[j]? = cols[j]?
  | k, [], j, h => by simp [spCols] at h
  | k, c :: rest, j, h => by
    by_cases hk : k = 0
    · simp [spCols, hk] at h
    · simp only [spCols, hk, if_false] at h ⊢
      cases j with
      | zero =>
        simp only [List.getElem?_cons_zero, List.getElem?_cons_succ] at h ⊢
        have hne : (spCol k c).2 ≠ 0 := by
          intro h0; rw [h0] at h
          cases rest with
          | nil => simp [spCols] at h
          | cons y ys => simp [spCols] at h
        rw [spx_spCol_full_of hk hne]
      | succ j =>
        simp only [List.getElem?_cons_succ] at h ⊢
        exact spx_spCols_full _ rest j h

/-- In a kept column, all entries before a kept entry are complete. -/
theorem spx_spCol_prefix {k : Nat} {col : Column} {v : Nat} (hv : v < (spCol k col).1.length) :
    (spCol k col).1.take v = col.take v := by
  apply List.ext_getElem?
  intro j
  rw [List.getElem?_take, List.getElem?_take]
  split_ifs with hj
  · exact spx_spCol_full (by rw [List.getElem?_eq_getElem (by omega)]; rfl)
  · rfl

/-- Kept entries keep their parents. -/
theorem spx_spCol_fst {k : Nat} (hk : 1 ≤ k) {col : Column} {j : Nat}
    (hj : j < (spCol k col).1.length) :
    ((spCol k col).1[j]?).map Prod.fst = (col[j]?).map Prod.fst := by
  obtain ⟨⟨p, h'⟩, hx⟩ : ∃ x, (spCol k col).1[j]? = some x := ⟨_, List.getElem?_eq_getElem hj⟩
  obtain ⟨h, -, hh, -, -⟩ := spx_spCol_get hk hx
  rw [hx, hh]; rfl

/-- Every column of a safe prefix is complete or a route column of the prefix. -/
theorem spx_complete_or_route : ∀ (P : List (Nat × Nat)) (T : Forest) (k j : Nat),
    ((spF k T).1.colAt ⟨P, j⟩).isSome →
      (spF k T).1.colAt ⟨P, j⟩ = T.colAt ⟨P, j⟩ ∨ (⟨P, j⟩ : ColAddr) ∈ routeCols (spF k T).1
  | [], .node cols, k, j, h => by
    rw [spF] at h ⊢
    simp only [Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols] at h ⊢
    by_cases hj : j + 1 < (spCols k cols).1.length
    · exact Or.inl (spx_spCols_full k cols j (by rw [List.getElem?_eq_getElem hj]; rfl))
    · right
      rw [mem_routeCols_iff]
      refine ⟨fun d hd => absurd hd (Nat.not_lt_zero _), _, rfl, ?_⟩
      have := (Option.isSome_iff_exists.1 h)
      obtain ⟨x, hx⟩ := this
      have := (List.getElem?_eq_some_iff.1 hx).1
      simp only [Tree.cols]; omega
  | (a, b) :: P, .node cols, k, j, h => by
    rw [spF] at h ⊢
    rw [Tree.colAt_cons] at h
    simp only [Tree.cols] at h
    obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 h
    rw [Option.bind_eq_some_iff] at hx
    obtain ⟨⟨p, h'⟩, hab, hP⟩ := hx
    rw [Option.bind_eq_some_iff] at hab
    obtain ⟨colA', hA', hb'⟩ := hab
    obtain ⟨colA, k₁, hA, rfl, hk₁, -⟩ := spx_spCols_get k cols a colA' hA'
    obtain ⟨h₀, k₂, hb, rfl, -⟩ := spx_spCol_get hk₁ hb'
    have e1 : (Tree.node (spCols k cols).1).colAt ⟨(a, b) :: P, j⟩ =
        (spF k₂ h₀).1.colAt ⟨P, j⟩ := by
      rw [Tree.colAt_cons]; simp [Tree.cols, hA', hb']
    have e2 : (Tree.node cols).colAt ⟨(a, b) :: P, j⟩ = h₀.colAt ⟨P, j⟩ := by
      rw [Tree.colAt_cons]; simp [Tree.cols, hA, hb]
    have hfa : (Tree.node (spCols k cols).1).forestAt [(a, b)] = some (spF k₂ h₀).1 := by
      rw [Tree.forestAt_cons]; simp [Tree.cols, hA', hb', Tree.forestAt]
    rw [e1, e2]
    rcases spx_complete_or_route P h₀ k₂ j (by rw [hP]; rfl) with hc | hr
    · exact Or.inl hc
    · by_cases hlast : a + 1 = (spCols k cols).1.length ∧ b + 1 = (spCol k₁ colA).1.length
      · right
        rw [mem_routeCols_iff] at hr ⊢
        obtain ⟨hrp, F, hF, hFl⟩ := hr
        refine ⟨isRoutePath_cons.2 ⟨?_, _, hfa, hrp⟩, F, ?_, hFl⟩
        · have hne : (spCol k₁ colA).1 ≠ [] := by
            intro h0; rw [h0] at hlast; simp at hlast
          simp only [Tree.lastStep?, Tree.cols]
          rw [List.getLast?_eq_getElem?, show (spCols k cols).1.length - 1 = a by omega, hA',
            Option.bind_some]
          simp only [List.isEmpty_eq_false_iff.2 hne, if_false, Bool.false_eq_true]
          congr 2; omega
        · rw [Tree.forestAt_cons]; simp [Tree.cols, hA', hb', hF]
      · left
        have hfull : (spF k₂ h₀).1 = h₀ := by
          have haL : a < (spCols k cols).1.length := (List.getElem?_eq_some_iff.1 hA').1
          have hbL : b < (spCol k₁ colA).1.length := (List.getElem?_eq_some_iff.1 hb').1
          by_cases ha : a + 1 < (spCols k cols).1.length
          · have hf := spx_spCols_full k cols a (by rw [List.getElem?_eq_getElem ha]; rfl)
            rw [hA', hA] at hf
            have hf' := Option.some.inj hf
            rw [hf', hb] at hb'
            exact (Prod.mk.inj (Option.some.inj hb')).2.symm
          · have hb2 : b + 1 < (spCol k₁ colA).1.length := by omega
            have hf := spx_spCol_full (k := k₁) (col := colA) (i := b)
              (by rw [List.getElem?_eq_getElem hb2]; rfl)
            rw [hb', hb] at hf
            exact (Prod.mk.inj (Option.some.inj hf)).2
        rw [hfull]

/-- A reduced `⊤`-free query below the boundary of entry `v` has the same cursor in a source that
agrees with `ks` through entry `v`, or agrees before `v` and ends at `v` with `⊤`. -/
theorem spx_cursor_capped {ks ks' W : List (WithTop Key)} {v : Nat} (hv : v < ks.length)
    (hW : W.Pairwise fun x y => y ≤ x) (hT : ∀ y ∈ W, y ≠ ⊤) (hlt : W < cutQuery ks (v + 1))
    (hks : ks' = ks.take v ++ [⊤] ∨ (v < ks'.length ∧ ks'.take (v + 1) = ks.take (v + 1))) :
    cursor ks' W = cursor ks W := by
  rcases hks with rfl | ⟨hv', htk⟩
  · exact ((cursor_cappedAt ks W v hv hW hT hlt).2).symm
  · have hc := cursor_le_of_lt_cutQuery hW hv hlt
    have hlt' : W < cutQuery ks' (v + 1) := by
      unfold cutQuery at hlt ⊢; rw [htk]; exact hlt
    have hc' := cursor_le_of_lt_cutQuery hW hv' hlt'
    have e1 := cursor_take ks' W (v + 1)
    have e2 := cursor_take ks W (v + 1)
    rw [htk] at e1
    omega

-- T3.2e (txt:312-313): safe prefixes keep A (barrier + capping)
theorem safePrefix_condA {E : Forest} (hL : InL E) (k : Nat) : CondA (safePrefix E k) := by
  obtain ⟨hV, -, -, hA, hS⟩ := hL
  have hV' : CondV (safePrefix E k) := safePrefix_condV hV k
  have hS' : CondS (safePrefix E k) := safePrefix_condS hV hS k
  refine capping_reverse hV' hS' (sel := routeCols (safePrefix E k)) (fun a ha => ha) ?_
  rw [condAK_iff]
  intro c hc i p hp
  -- the column of `c` in the prefix
  obtain ⟨col', hcol'⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff _ c).1 hc)
  obtain ⟨col, k₁, hcol, rfl, hk₁, -, -⟩ := spx_colAt (k := k) (T := E) hcol'
  have hcE : c ∈ E.colAddrs := (Tree.mem_colAddrs_iff E c).2 (by rw [hcol]; rfl)
  have hpar : ∀ j, j < (spCol k₁ col).1.length →
      (parents (safePrefix E k) c)[j]? = (parents E c)[j]? := by
    intro j hj
    simp only [parents, List.getElem?_map]
    rw [hcol', hcol, Option.getD_some, Option.getD_some]
    exact spx_spCol_fst hk₁ hj
  have hiL : i < (spCol k₁ col).1.length := by
    have := (List.getElem?_eq_some_iff.1 hp).1
    simp only [parents, hcol', Option.getD_some, List.length_map] at this; exact this
  have hpE : (parents E c)[i]? = some p := by rw [← hpar i hiL]; exact hp
  have hiE : i < col.length := by
    have := (List.getElem?_eq_some_iff.1 hpE).1; simpa [parents, hcol] using this
  have hstart : cutStart (safePrefix E k) c i = cutStart E c i := by
    unfold cutStart
    split_ifs with h0
    · rfl
    · rw [hpar (i - 1) (by omega)]
  -- the query
  have hgk : ∀ (o : ColAddr) (colo : Column) (k₂ n : Nat), (safePrefix E k).colAt o =
      some (spCol k₂ colo).1 → E.colAt o = some colo →
      (spCol k₂ colo).1.take n = colo.take n →
      (actualKeys (safePrefix E k) o).take n = (actualKeys E o).take n := by
    intro o colo k₂ n h1 h2 h3
    simp only [actualKeys, h1, h2, Option.getD_some, ← List.map_take, h3]
  have hW : cutQuery (capKeys (safePrefix E k) (routeCols (safePrefix E k)) c) i =
      cutQuery (actualKeys E c) i := by
    rw [cutQuery_capKeys _ _ c (by rw [hcol']; simpa using hiL)]
    unfold cutQuery
    rw [hgk c col k₁ i hcol' hcol (spx_spCol_prefix hiL)]
  have hAE := (condAK_iff _ _).1 hA c hcE i p hpE
  rw [hW, hstart]
  set W := cutQuery (actualKeys E c) i with hWdef
  have hWn : W.Pairwise fun x y => y ≤ x := cutQuery_noninc _ _
  have hWT : ∀ y ∈ W, y ≠ ⊤ := by
    intro y hy
    have hy' := ((nu_sublist _).trans (List.take_sublist _ _)).subset hy
    simp only [actualKeys, List.mem_map] at hy'
    obtain ⟨_, -, rfl⟩ := hy'
    exact WithTop.coe_ne_top
  have hent : (⟨c, i⟩ : EntryAddr) ∈ (safePrefix E k).entryAddrs := by
    rw [Tree.mem_entryAddrs_iff, Tree.entryAt]
    rw [hcol', Option.bind_some, List.getElem?_eq_getElem hiL]; rfl
  -- transfer of the actual path of `E`, edge by edge
  have key : ∀ y, Path E (actualKeys E) c W (cutStart E c i) y →
      Path (safePrefix E k) (capKeys (safePrefix E k) (routeCols (safePrefix E k))) c W
        (cutStart E c i) y := by
    intro y h
    induction h with
    | refl => exact Relation.ReflTransGen.refl
    | @tail z y' hxz hzy ih =>
      obtain ⟨o, ho, hr⟩ := hzy
      refine ih.tail ⟨o, ho, ?_⟩
      have hoE' : ((safePrefix E k).colAt o).isSome := by
        have := (Tree.stack_mem_prefix hent).2.1 o ((ColAddr.resolve_spec 0 c o z).1 ho).1
        exact (Tree.mem_roles_ord o.path _ o.col).1 ((List.takeWhile_sublist _).subset this)
      by_cases hor : o ∈ routeCols (safePrefix E k)
      · -- a route column: a container of `c`; the barrier stops the scan at the container
        obtain ⟨v, hvE', hvc⟩ := routeCols_visible hc hor ho
        obtain ⟨colo', hcolo'⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff _ o).1
          (mem_colAddrs_of_mem_routeCols hor))
        obtain ⟨colo, k₂, hcolo, rfl, hk₂, -, -⟩ := spx_colAt (k := k) (T := E) hcolo'
        have hvL : v < (spCol k₂ colo).1.length := by
          have := (Tree.mem_entryAddrs_iff _ _).1 hvE'
          rw [Tree.entryAt] at this
          rw [hcolo', Option.bind_some] at this
          obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 this
          exact (List.getElem?_eq_some_iff.1 hx).1
        obtain ⟨xv, hxv⟩ : ∃ x, (spCol k₂ colo).1[v]? = some x :=
          ⟨_, List.getElem?_eq_getElem hvL⟩
        obtain ⟨Hv, -, hHv, -, -⟩ := spx_spCol_get hk₂ hxv
        have hvo : v < colo.length := (List.getElem?_eq_some_iff.1 hHv).1
        have hvE : (⟨o, v⟩ : EntryAddr) ∈ E.entryAddrs := by
          rw [Tree.mem_entryAddrs_iff, Tree.entryAt, hcolo, Option.bind_some, hHv]; rfl
        have hz : o.num 0 = z := ColAddr.resolve_num ho
        have hbar := cut_barrier hV hA hS hvE hcE hvc (k := i)
          (by simp [parents, hcol]; omega) (by rw [hz]; exact hxz)
        dsimp only at hbar
        rw [boundary_eq_cutQuery] at hbar
        set ks := actualKeys E o with hks
        have hksL : ks.length = colo.length := by simp [hks, actualKeys, hcolo]
        have hcap : capKeys (safePrefix E k) (routeCols (safePrefix E k)) o =
            (actualKeys (safePrefix E k) o).dropLast ++ [⊤] := by
          have hne : actualKeys (safePrefix E k) o ≠ [] := by
            simp only [actualKeys]
            rw [hcolo', Option.getD_some]
            intro h0; rw [List.map_eq_nil_iff] at h0; rw [h0] at hvL; simp at hvL
          obtain ⟨y, hy⟩ := Option.ne_none_iff_exists'.1 (mt List.getLast?_eq_none_iff.1 hne)
          simp [capKeys, hor, hy]
        have hlenA : (actualKeys (safePrefix E k) o).length = (spCol k₂ colo).1.length := by
          simp only [actualKeys, List.length_map]
          rw [hcolo', Option.getD_some]
        have hcur : cursor (capKeys (safePrefix E k) (routeCols (safePrefix E k)) o) W =
            cursor ks W := by
          refine spx_cursor_capped (by omega) hWn hWT hbar ?_
          rw [hcap]
          by_cases hv1 : v + 1 = (spCol k₂ colo).1.length
          · left
            rw [List.dropLast_eq_take, hlenA, show (spCol k₂ colo).1.length - 1 = v by omega,
              hgk o colo k₂ v hcolo' hcolo (spx_spCol_prefix hvL)]
          · right
            refine ⟨by simp; omega, ?_⟩
            rw [List.take_append_of_le_length (by rw [List.length_dropLast]; omega),
              List.dropLast_eq_take, List.take_take, Nat.min_eq_left (by omega)]
            exact hgk o colo k₂ (v + 1) hcolo' hcolo (spx_spCol_prefix (by omega))
        have hm : cursor ks W ≤ v := cursor_le_of_lt_cutQuery hWn (by omega) hbar
        unfold resp at hr ⊢
        rw [hcur]
        rw [hcolo', Option.getD_some, spx_spCol_fst hk₂ (by omega)]
        rw [hcolo, Option.getD_some] at hr
        exact hr
      · -- a non-route column is complete in the prefix
        have hcomp := (spx_complete_or_route o.path E k o.col hoE').resolve_right hor
        have hcomp' : (safePrefix E k).colAt o = E.colAt o := hcomp
        unfold resp at hr ⊢
        rw [capKeys_of_not_mem hor]
        unfold actualKeys at hr ⊢
        rw [hcomp']
        exact hr
  exact key p hAE


/-! T3.2f helpers: profiles of safe prefixes, pure towers. -/

/-- The profile recursion started `e` levels deeper adds `e` to the depth. -/
theorem spx_profileAux_add (e : Nat) (d : Nat) (H : Forest) :
    profileAux (d + e) H = toLex ((ofLex (profileAux d H)).1 + e, (ofLex (profileAux d H)).2) := by
  induction d, H using profileAux.induct with
  | case1 d p rest tail => simp [profileAux]
  | case2 d p rest tail head tail_1 ih =>
    rw [profileAux, profileAux, show d + e + 1 = d + 1 + e by omega]; exact ih
  | case3 d cols hne =>
    match cols, hne with
    | [], _ => simp [profileAux]
    | [] :: cs, _ => simp [profileAux]
    | ((p, h) :: rest) :: cs, hne => exact absurd rfl (hne p h rest cs)

theorem spx_profile_node {cols : List Column} (h : cols ≠ []) :
    profile (Tree.node cols) = ((profileAux 0 (Tree.node cols) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by
  cases cols with
  | nil => exact absurd rfl h
  | cons x xs => rfl

theorem spx_profileAux_one (H : Forest) :
    profileAux 1 H = toLex ((ofLex (profileAux 0 H)).1 + 1, (ofLex (profileAux 0 H)).2) :=
  spx_profileAux_add 1 0 H

/-- A pure tower: singleton levels with parents `ps`, ending in `m` entries `(q, ∅)`. -/
def spxTower : List Nat → Nat → Nat → Forest
  | [], q, m => .node [List.replicate m (q, Tree.empty)]
  | p :: ps, q, m => .node [[(p, spxTower ps q m)]]

theorem spx_tower_ne (ps : List Nat) (q m : Nat) : (spxTower ps q m).cols ≠ [] := by
  cases ps <;> simp [spxTower, Tree.cols]

theorem spx_profileAux_cons (d p : Nat) {h : Forest} (hh : h.cols ≠ []) (rest : Column)
    (tail : List Column) :
    profileAux d (Tree.node (((p, h) :: rest) :: tail)) = profileAux (d + 1) h := by
  obtain ⟨hc⟩ := h
  cases hc with
  | nil => simp [Tree.cols] at hh
  | cons x xs => rw [profileAux]

theorem spx_eta (T : Forest) : T = Tree.node T.cols := by cases T; rfl

theorem spx_profileAux_tower : ∀ (ps : List Nat) (q m : Nat),
    profileAux 0 (spxTower ps q (m + 1)) = toLex (ps.length, m + 1)
  | [], q, m => by
    show profileAux 0 (Tree.node [((q, Tree.node []) :: List.replicate m (q, Tree.node []))]) = _
    rw [profileAux]
    have : (List.replicate m (q, (Tree.node [] : Forest))).takeWhile (fun x => x.1 == q) =
        List.replicate m (q, Tree.node []) := by
      induction m with
      | zero => rfl
      | succ m ih => simp only [List.replicate_succ, List.takeWhile_cons, beq_self_eq_true,
          if_true, ih]
    rw [this, List.length_replicate]; simp; omega
  | p :: ps, q, m => by
    simp only [spxTower]
    rw [spx_profileAux_cons 0 p (spx_tower_ne ps q (m + 1)), spx_profileAux_one,
      spx_profileAux_tower ps q m]
    simp

theorem spx_profile_tower (ps : List Nat) (q m : Nat) :
    profile (spxTower ps q (m + 1)) = ((toLex (ps.length, m + 1) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by
  rw [spx_eta (spxTower ps q (m + 1)), spx_profile_node (spx_tower_ne ps q (m + 1)), ← spx_eta]
  exact congrArg _ (spx_profileAux_tower ps q m)

theorem spx_colAt_empty (c : ColAddr) : (Tree.empty : Forest).colAt c = none := by
  obtain ⟨P, j⟩ := c
  cases P with
  | nil => simp [Tree.colAt, Tree.forestAt, Tree.empty, Tree.cols]
  | cons x xs => obtain ⟨a, b⟩ := x; simp [Tree.colAt, Tree.forestAt, Tree.empty, Tree.cols]

/-- Every column of a tower is nonempty with constant parents. -/
theorem spx_tower_col : ∀ (ps : List Nat) (q m : Nat) (ρ : List (Nat × Nat)) (j : Nat) (col : Column),
    (spxTower ps q (m + 1)).colAt ⟨ρ, j⟩ = some col →
      ∃ q₀ H₀ rest, col = (q₀, H₀) :: rest ∧ ∀ x ∈ col, x.1 = q₀
  | [], q, m, [], j, col, h => by
    simp only [spxTower, Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols] at h
    cases j with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.some.injEq] at h
      subst h
      exact ⟨q, _, _, rfl, fun x hx => by rw [(List.eq_of_mem_replicate hx)]⟩
    | succ j => simp at h
  | [], q, m, (a, b) :: ρ, j, col, h => by
    rw [Tree.colAt_cons] at h
    simp only [spxTower, Tree.cols] at h
    cases a with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.bind_some] at h
      cases hb : (List.replicate (m + 1) (q, (Tree.empty : Forest)))[b]? with
      | none => rw [hb] at h; simp at h
      | some x =>
        rw [hb, Option.bind_some] at h
        have := List.eq_of_mem_replicate (List.mem_of_getElem? hb)
        rw [this] at h
        rw [spx_colAt_empty] at h; simp at h
    | succ a => simp at h
  | p :: ps, q, m, [], j, col, h => by
    simp only [spxTower, Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols] at h
    cases j with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.some.injEq] at h
      subst h
      exact ⟨p, _, _, rfl, fun x hx => by simp at hx; rw [hx]⟩
    | succ j => simp at h
  | p :: ps, q, m, (a, b) :: ρ, j, col, h => by
    rw [Tree.colAt_cons] at h
    simp only [spxTower, Tree.cols] at h
    cases a with
    | zero =>
      cases b with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.bind_some] at h
        exact spx_tower_col ps q m ρ j col h
      | succ b => simp at h
    | succ a => simp at h

/-- The heights of the outer entries of a tower have smaller profile. -/
theorem spx_tower_outer {ps : List Nat} {q m j i q' : Nat} {J : Forest}
    (h : (spxTower ps q (m + 1)).entryAt ⟨⟨[], j⟩, i⟩ = some (q', J)) :
    profile J < profile (spxTower ps q (m + 1)) := by
  rw [spx_profile_tower]
  cases ps with
  | nil =>
    simp only [spxTower, Tree.entryAt, Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols] at h
    cases j with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.bind_some] at h
      have := List.eq_of_mem_replicate (List.mem_of_getElem? h)
      simp only [Prod.mk.injEq] at this
      rw [this.2]
      exact WithBot.bot_lt_coe _
    | succ j => simp at h
  | cons p ps =>
    simp only [spxTower, Tree.entryAt, Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols] at h
    cases j with
    | zero =>
      cases i with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.bind_some, Option.some.injEq,
          Prod.mk.injEq] at h
        rw [← h.2, spx_profile_tower]
        exact WithBot.coe_lt_coe.2 (Prod.Lex.toLex_lt_toLex.2 (Or.inl (by simp)))
      | succ i => simp at h
    | succ j => simp at h

theorem spx_spF_emptyF (k : Nat) : spF k (Tree.empty : Forest) = (Tree.empty, k) := by
  simp [Tree.empty, spF, spCols]

theorem spx_spLater_zero (col : Column) : spLater 0 col = ([], 0) := by
  cases col <;> simp [spLater]

theorem spx_spCols_zero (cols : List Column) : spCols 0 cols = ([], 0) := by
  cases cols <;> simp [spCols]

theorem spx_spLater_fst : ∀ (k : Nat) (col : Column),
    (spLater k col).1.map Prod.fst <+: col.map Prod.fst
  | k, [] => by simp [spLater]
  | k, (q, h) :: rest => by
    by_cases hk : k = 0
    · simp [spLater, hk]
    · simp only [spLater, hk, if_false, List.map_cons]
      exact (List.prefix_cons_inj _).2 (spx_spLater_fst _ rest)

theorem spx_spLater_short : ∀ (k : Nat) (col : Column),
    (spLater k col).1.length < col.length → (spLater k col).2 = 0
  | k, [] => by simp [spLater]
  | k, (q, h) :: rest => by
    by_cases hk : k = 0
    · simp [spLater, hk]
    · simp only [spLater, hk, if_false, List.length_cons]
      intro hl
      exact spx_spLater_short _ rest (by omega)

/-- Runs of a parent in a prefix of the parent list. -/
theorem spx_takeWhile_prefix (p : Nat) : ∀ (l' l : Column), l'.map Prod.fst <+: l.map Prod.fst →
    (l'.takeWhile fun x => x.1 == p).length ≤ (l.takeWhile fun x => x.1 == p).length ∧
    ((l'.takeWhile fun x => x.1 == p).length < (l.takeWhile fun x => x.1 == p).length →
      (∀ x ∈ l', x.1 = p) ∧ l'.length < l.length)
  | [], l, _ => by
    refine ⟨by simp, fun h => ⟨by simp, ?_⟩⟩
    cases l with
    | nil => simp at h
    | cons x xs => simp
  | x' :: xs', [], h => by simp at h
  | x' :: xs', x :: xs, h => by
    simp only [List.map_cons, List.cons_prefix_cons] at h
    obtain ⟨hx, h⟩ := h
    have ih := spx_takeWhile_prefix p xs' xs h
    by_cases hp : x'.1 = p
    · have hp' : x.1 = p := hx ▸ hp
      have e1 : (x' :: xs').takeWhile (fun x => x.1 == p) = x' :: xs'.takeWhile (fun x => x.1 == p) := by
        simp [hp]
      have e2 : (x :: xs).takeWhile (fun x => x.1 == p) = x :: xs.takeWhile (fun x => x.1 == p) := by
        simp [hp']
      rw [e1, e2, List.length_cons, List.length_cons]
      refine ⟨Nat.succ_le_succ ih.1, fun hl => ⟨?_, ?_⟩⟩
      · intro y hy
        rcases List.mem_cons.1 hy with rfl | hy
        · exact hp
        · exact (ih.2 (Nat.lt_of_succ_lt_succ hl)).1 y hy
      · simp only [List.length_cons]
        exact Nat.succ_lt_succ (ih.2 (Nat.lt_of_succ_lt_succ hl)).2
    · have hp' : ¬ x.1 = p := hx ▸ hp
      have e1 : (x' :: xs').takeWhile (fun x => x.1 == p) = [] := by
        simp [hp]
      have e2 : (x :: xs).takeWhile (fun x => x.1 == p) = [] := by
        simp [hp']
      rw [e1, e2]; simp

/-- Nonincreasing columns. -/
def spxNoninc (col : Column) : Prop :=
  ∀ i x y, col[i]? = some x → col[i + 1]? = some y → EntryLe y x

theorem spx_le_empty {X : Forest} (h : X ≤ Tree.empty) : X = Tree.empty := by
  by_contra hne
  exact absurd h (not_le.2 (Forest.empty_lt hne))

/-- Under H the run of the first parent after an entry with empty height has empty heights. -/
theorem spx_run_empty (p : Nat) : ∀ (rest : Column), spxNoninc ((p, Tree.empty) :: rest) →
    ∀ x ∈ rest.takeWhile (fun x => x.1 == p), x = (p, Tree.empty)
  | [], _ => by simp
  | y :: ys, h => by
    by_cases hy : y.1 = p
    · have hle := h 0 (p, Tree.empty) y rfl rfl
      have hy2 : y.2 = Tree.empty := by
        rcases hle with hlt | ⟨-, hle⟩
        · exact absurd hlt (by simp [hy])
        · exact spx_le_empty hle
      have hyy : y = (p, Tree.empty) := Prod.ext hy hy2
      have h' : spxNoninc ((p, Tree.empty) :: ys) := by
        intro i x z hx hz
        apply h (i + 1) x z
        · cases i with
          | zero => simpa [hyy] using hx
          | succ i => simpa using hx
        · simpa using hz
      intro x hx
      simp only [List.takeWhile_cons, hy, beq_self_eq_true, if_true, List.mem_cons] at hx
      rcases hx with rfl | hx
      · exact hyy
      · exact spx_run_empty p ys h' x hx
    · simp [hy]

theorem spx_condH_col {T : Forest} (hH : CondH T) {c : ColAddr} {col : Column}
    (hc : T.colAt c = some col) : spxNoninc col := by
  intro i x y hx hy
  have := hH c ((Tree.mem_colAddrs_iff T c).2 (by rw [hc]; rfl)) i x y
  rw [hc, Option.getD_some] at this
  exact this hx hy

theorem spx_colAt_append (t : Forest) (π ρ : List (Nat × Nat)) (j : Nat) :
    t.colAt ⟨π ++ ρ, j⟩ = (t.forestAt π).bind fun F => F.colAt ⟨ρ, j⟩ := by
  simp only [Tree.colAt, Tree.forestAt_append, Option.bind_assoc]

/-- H passes to heights. -/
theorem spx_condH_height {T : Forest} (hH : CondH T) {g : EntryAddr} {G : Forest}
    (hg : T.heightAt g = some G) : CondH G := by
  intro c hc i x y hx hy
  have hcol : T.colAt ⟨g.heightPath ++ c.path, c.col⟩ = G.colAt c := by
    rw [spx_colAt_append, Tree.forestAt_heightPath, hg]; rfl
  obtain ⟨col, hcol'⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff G c).1 hc)
  rw [hcol'] at hcol hx hy
  exact spx_condH_col hH hcol i x y hx hy

/-- Profiles of safe prefixes: never larger, and when changed (and nonempty) a pure tower. -/
theorem spx_profile_sp (d : Nat) (H : Forest) : ∀ k, CondH H →
    profile (safePrefix H k) ≤ profile H ∧
      (profile (safePrefix H k) = profile H ∨
        (∃ ps q m, safePrefix H k = spxTower ps q (m + 1)) ∨ safePrefix H k = Tree.empty) := by
  induction d, H using profileAux.induct with
  | case1 d p rest tail =>
    intro k hH
    rcases Nat.eq_zero_or_pos k with rfl | hk
    · have : safePrefix (Tree.node (((p, Tree.node []) :: rest) :: tail)) 0 = Tree.empty := by
        simp [safePrefix, safePrefixBody, spF, spCols, Tree.empty]
      rw [this]; exact ⟨by simp [profile, profileBody, Tree.empty], Or.inr (Or.inr rfl)⟩
    · have hsp : safePrefix (Tree.node (((p, Tree.node []) :: rest) :: tail)) k =
          Tree.node (((p, Tree.node []) :: (spLater (k - 1) rest).1) ::
            (spCols (spLater (k - 1) rest).2 tail).1) := by
        show (spF k _).1 = _
        have := spx_spF_emptyF (k - 1)
        simp only [Tree.empty] at this
        simp only [spF, spCols, Nat.pos_iff_ne_zero.1 hk, if_false, spCol]
      rw [hsp, spx_profile_node (by simp), spx_profile_node (by simp), profileAux, profileAux]
      obtain ⟨hle, hlt⟩ := spx_takeWhile_prefix p _ rest (spx_spLater_fst (k - 1) rest)
      refine ⟨WithBot.coe_le_coe.2 (Prod.Lex.toLex_le_toLex.2 (Or.inr ⟨rfl,
        Nat.add_le_add_left hle 1⟩)), ?_⟩
      by_cases heq : ((spLater (k - 1) rest).1.takeWhile fun x => x.1 == p).length =
          (rest.takeWhile fun x => x.1 == p).length
      · left; rw [heq]
      · right; left
        obtain ⟨hall, hshort⟩ := hlt (Nat.lt_of_le_of_ne hle heq)
        have hrun := spx_run_empty p rest (spx_condH_col hH (c := ⟨[], 0⟩) rfl)
        have hb := spx_spLater_short _ _ hshort
        have hit : (spLater (k - 1) rest).1.length < (rest.takeWhile fun x => x.1 == p).length := by
          have e : ((spLater (k - 1) rest).1.takeWhile fun x => x.1 == p) =
              (spLater (k - 1) rest).1 := takeWhile_eq_self_of (fun x hx => by simp [hall x hx])
          rw [e] at hle heq; exact Nat.lt_of_le_of_ne hle heq
        have hkept : (spLater (k - 1) rest).1 =
            List.replicate (spLater (k - 1) rest).1.length (p, Tree.empty) := by
          apply List.ext_getElem (by simp)
          intro i hi _
          rw [List.getElem_replicate]
          obtain ⟨⟨q, h'⟩, hx⟩ : ∃ x, (spLater (k - 1) rest).1[i]? = some x :=
            ⟨_, List.getElem?_eq_getElem hi⟩
          obtain ⟨h₀, k', hr, rfl, -⟩ := spx_spLater_get _ _ i q h' hx
          have hq : q = p := hall _ (List.mem_of_getElem? hx)
          have hmem : (q, h₀) ∈ rest.takeWhile fun x => x.1 == p := by
            apply List.mem_of_getElem? (i := i)
            rw [List.prefix_iff_eq_take.1 (List.takeWhile_prefix _), List.getElem?_take,
              if_pos (by omega)]
            exact hr
          have := hrun _ hmem
          simp only [Prod.mk.injEq] at this
          rw [List.getElem?_eq_getElem hi] at hx
          rw [Option.some.inj hx, this.2, hq, spx_spF_emptyF]
        refine ⟨[], p, (spLater (k - 1) rest).1.length, ?_⟩
        rw [hb, spx_spCols_zero, hkept]
        simp only [spxTower, List.replicate_succ, List.length_replicate, Tree.empty]
  | case2 d p rest tail head tail_1 ih =>
    intro k hH
    have hHh : CondH (Tree.node (head :: tail_1)) := spx_condH_height hH (g := ⟨⟨[], 0⟩, 0⟩) rfl
    have ih' := ih
    generalize hh : Tree.node (head :: tail_1) = h at hHh ih'
    have hne : h.cols ≠ [] := by rw [← hh]; simp [Tree.cols]
    have hprof : profile (Tree.node (((p, h) :: rest) :: tail)) =
        ((profileAux 1 h : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by
      rw [spx_profile_node (by simp), spx_profileAux_cons 0 p hne]
    rcases Nat.eq_zero_or_pos k with rfl | hk
    · have : safePrefix (Tree.node (((p, h) :: rest) :: tail)) 0 = Tree.empty := by
        simp [safePrefix, safePrefixBody, spF, spCols, Tree.empty]
      rw [this]; exact ⟨by simp [profile, profileBody, Tree.empty], Or.inr (Or.inr rfl)⟩
    · have hsp : safePrefix (Tree.node (((p, h) :: rest) :: tail)) k =
          Tree.node (((p, (spF (k - 1) h).1) :: (spLater (spF (k - 1) h).2 rest).1) ::
            (spCols (spLater (spF (k - 1) h).2 rest).2 tail).1) := by
        show (spF k _).1 = _
        simp only [spF, spCols, Nat.pos_iff_ne_zero.1 hk, if_false, spCol]
      rw [hsp, hprof]
      by_cases hb : (spF (k - 1) h).2 = 0
      · rw [hb, spx_spLater_zero, spx_spCols_zero]
        obtain ⟨ihle, ihc⟩ := ih' (k - 1) hHh
        by_cases he : (spF (k - 1) h).1 = Tree.empty
        · rw [he]
          have ht : (Tree.node [[(p, Tree.empty)]] : Forest) = spxTower [] p (0 + 1) := rfl
          rw [ht, spx_profile_tower]
          refine ⟨WithBot.coe_le_coe.2 ?_, Or.inr (Or.inl ⟨[], p, 0, rfl⟩)⟩
          rw [spx_profileAux_one, Prod.Lex.toLex_le_toLex]
          left; simp
        · have hne' : (spF (k - 1) h).1.cols ≠ [] := by
            intro h0; apply he; rw [spx_eta (spF (k - 1) h).1, h0]; rfl
          have e1 : profile (Tree.node [[(p, (spF (k - 1) h).1)]]) =
              ((profileAux 1 (spF (k - 1) h).1 : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by
            rw [spx_profile_node (by simp), spx_profileAux_cons 0 p hne']
          have e2 : profile (spF (k - 1) h).1 =
              ((profileAux 0 (spF (k - 1) h).1 : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by
            rw [spx_eta (spF (k - 1) h).1, spx_profile_node hne', ← spx_eta]
          have e3 : profile h = ((profileAux 0 h : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by
            rw [spx_eta h, spx_profile_node hne, ← spx_eta]
          have ihle' : profile (spF (k - 1) h).1 ≤ profile h := ihle
          rw [e2, e3, WithBot.coe_le_coe] at ihle'
          rw [e1]
          refine ⟨WithBot.coe_le_coe.2 ?_, ?_⟩
          · rw [spx_profileAux_one, spx_profileAux_one]
            rw [Prod.Lex.le_iff] at ihle'
            rw [Prod.Lex.toLex_le_toLex]
            simp only at ihle' ⊢
            omega
          · rcases ihc with heq | ⟨ps, q, m, htw⟩ | hemp
            · left
              change profile (spF (k - 1) h).1 = profile h at heq
              rw [e2, e3, WithBot.coe_inj] at heq
              rw [spx_profileAux_one, spx_profileAux_one, heq]
            · right; left
              change (spF (k - 1) h).1 = _ at htw
              exact ⟨p :: ps, q, m, by rw [htw]; rfl⟩
            · exact absurd hemp he
      · rw [spx_spF_full hb]
        have e1 : profile (Tree.node (((p, h) :: (spLater (spF (k - 1) h).2 rest).1) ::
            (spCols (spLater (spF (k - 1) h).2 rest).2 tail).1)) =
            ((profileAux 1 h : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by
          rw [spx_profile_node (by simp), spx_profileAux_cons 0 p hne]
        rw [e1]
        exact ⟨le_refl _, Or.inl rfl⟩
  | case3 d cols hne =>
    intro k hH
    match cols, hne with
    | [], _ =>
      have : safePrefix (Tree.node []) k = Tree.empty := by
        have := spx_spF_emptyF k; simp only [Tree.empty] at this
        show (spF k _).1 = _; rw [this]; rfl
      rw [this]; exact ⟨le_of_eq (by rfl), Or.inr (Or.inr rfl)⟩
    | [] :: cs, _ =>
      rcases Nat.eq_zero_or_pos k with rfl | hk
      · have : safePrefix (Tree.node ([] :: cs)) 0 = Tree.empty := by
          simp [safePrefix, safePrefixBody, spF, spCols, Tree.empty]
        rw [this]; exact ⟨by simp [profile, profileBody, Tree.empty], Or.inr (Or.inr rfl)⟩
      · have hsp : safePrefix (Tree.node ([] :: cs)) k =
            Tree.node ([] :: (spCols (k - 1) cs).1) := by
          show (spF k _).1 = _
          simp only [spF, spCols, Nat.pos_iff_ne_zero.1 hk, if_false, spCol]
        rw [hsp, spx_profile_node (by simp), spx_profile_node (by simp), profileAux, profileAux]
        all_goals first | exact ⟨le_refl _, Or.inl rfl⟩ | simp
    | ((p, h) :: rest) :: cs, hne => exact absurd rfl (hne p h rest cs)

-- T3.2f (txt:314-318): safe prefixes keep P
theorem safePrefix_condP {E : Forest} (hL : InL E) (hP : CondP E) (k : Nat) :
    CondP (safePrefix E k) := by
  obtain ⟨-, hI, hH, -, -⟩ := hL
  have hI' : CondI (safePrefix E k) := safePrefix_condI hI k
  intro e0 he0 e he hret
  obtain ⟨⟨ρ, hρ⟩, q, J', hJ', hres⟩ := hret
  obtain ⟨⟨P, j⟩, i⟩ := e
  dsimp only at hρ
  subst hρ
  obtain ⟨x0, hx0⟩ := Option.isSome_iff_exists.1 ((Tree.mem_entryAddrs_iff _ e0).1 he0)
  obtain ⟨p0, H'⟩ := x0
  obtain ⟨H, k₀, hH0, rfl, -⟩ := spx_entryAt (k := k) (T := E) hx0
  have hJ'' := hJ'
  rw [spx_entryAt_inside, Tree.heightAt, hx0] at hJ''
  simp only [Option.map_some, Option.bind_some] at hJ''
  obtain ⟨J, k₁, hJ, rfl, hk⟩ := spx_entryAt hJ''
  have hEe : E.entryAt ⟨⟨e0.heightPath ++ ρ, j⟩, i⟩ = some (q, J) := by
    rw [spx_entryAt_inside, Tree.heightAt, hH0]; simpa using hJ
  have hretE : IsOwnerReturn E e0 ⟨⟨e0.heightPath ++ ρ, j⟩, i⟩ := ⟨⟨ρ, rfl⟩, q, J, hEe, hres⟩
  have hPE := hP e0 ((Tree.mem_entryAddrs_iff E e0).2 (by rw [hH0]; rfl)) _
    ((Tree.mem_entryAddrs_iff E _).2 (by rw [hEe]; rfl)) hretE
  rw [Tree.heightAt, Tree.heightAt, hEe, hH0] at hPE
  simp only [Option.map_some, Option.getD_some] at hPE
  rw [Tree.heightAt, Tree.heightAt, hJ', hx0]
  simp only [Option.map_some, Option.getD_some]
  have hHH : CondH H := spx_condH_height hH (g := e0) (by rw [Tree.heightAt, hH0]; rfl)
  have hHJ : CondH J :=
    spx_condH_height hH (g := ⟨⟨e0.heightPath ++ ρ, j⟩, i⟩) (by rw [Tree.heightAt, hEe]; rfl)
  obtain ⟨-, hcase⟩ := spx_profile_sp 0 H k₀ hHH
  rcases hcase with hsame | ⟨ps, q', m, htw⟩ | hemp
  · exact lt_of_le_of_lt (spx_profile_sp 0 J k₁ hHJ).1 (hsame ▸ hPE)
  · -- the prefix of `H` is a pure tower: only its outer entries can return to its host
    have htw' : (spF k₀ H).1 = spxTower ps q' (m + 1) := htw
    rw [htw'] at hJ'' ⊢
    rcases List.eq_nil_or_concat ρ with rfl | ⟨ρ₀, ⟨c₁, i₁⟩, rfl⟩
    · exact spx_tower_outer hJ''
    · exfalso
      obtain ⟨col, hcol, hci⟩ := Tree.colAt_of_entryAt hJ''
      obtain ⟨q₀, H₀, rest, rfl, hconst⟩ := spx_tower_col ps q' m _ j _ hcol
      have hqq : q = q₀ := hconst _ (List.mem_of_getElem? hci)
      -- the entry `g` whose height holds the returning column
      let g : EntryAddr := ⟨⟨e0.heightPath ++ ρ₀, c₁⟩, i₁⟩
      have hgp : g.heightPath = e0.heightPath ++ (ρ₀ ++ [(c₁, i₁)]) := by
        simp [g, EntryAddr.heightPath]
      have hcolE : (safePrefix E k).colAt ⟨g.heightPath, j⟩ = some ((q₀, H₀) :: rest) := by
        rw [hgp, spx_colAt_append, Tree.forestAt_heightPath, Tree.heightAt, hx0]
        simp only [Option.map_some, Option.bind_some]
        rw [htw']; simpa using hcol
      rw [Tree.colAt, Tree.forestAt_heightPath, Tree.heightAt] at hcolE
      obtain ⟨G, hG, hGc⟩ := Option.bind_eq_some_iff.1 hcolE
      obtain ⟨⟨pg, G'⟩, hgE, hGG⟩ := Option.map_eq_some_iff.1 hG
      simp only at hGG
      subst hGG
      have hGne : G' ≠ Tree.empty := by
        intro h0; rw [h0] at hGc; simp [Tree.empty, Tree.cols] at hGc
      obtain ⟨q'', H'', rest'', hc'', hle⟩ := hI' g ((Tree.mem_entryAddrs_iff _ g).2
        (by rw [hgE]; rfl)) pg G' hgE hGne _ (List.mem_of_getElem? hGc)
      simp only [List.cons.injEq, Prod.mk.injEq] at hc''
      have hnum : e0.col.num 0 = q := ColAddr.resolve_num hres
      have hg : e0.col.num 0 + 1 ≤ g.col.num 0 := by
        simp only [g, ColAddr.num, EntryAddr.heightPath, List.map_append, List.sum_append,
          List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]
        omega
      omega
  · have htw' : (spF k₀ H).1 = Tree.empty := hemp
    rw [htw'] at hJ''
    obtain ⟨col, hcol, -⟩ := Tree.colAt_of_entryAt hJ''
    rw [spx_colAt_empty] at hcol; cases hcol


/-! T3.2g helpers: a proper word prefix is a safe prefix; filling the hole with its own column. -/

/-- A forest whose word is a proper prefix of `w(E)` is a safe prefix of `E`. -/
theorem spx_safePrefix_of_word {E E' : Forest} {X : List WordAtom} (hX : X ≠ [])
    (h : word E = word E' ++ X) : ∃ k, k < mu E ∧ E' = safePrefix E k := by
  refine ⟨mu E', ?_, word_injective ?_⟩
  · unfold mu; rw [h, List.length_append]
    have := List.length_pos_of_ne_nil hX; omega
  · rw [word_safePrefix, h]
    show word E' = (word E' ++ X).take (word E').length
    simp

/-- Filling the hole at the end of a route path with the column found there restores the forest. -/
theorem spx_put_self : ∀ (π : List (Nat × Nat)) (F G : Forest), IsRoutePath F π →
    F.forestAt π = some G → G.cols ≠ [] →
      replaceAt 0 0 (Tree.node [G.cols.getLast?.getD []]) π.length F = F
  | [], .node cols, G, _, hG, hne => by
    simp only [Tree.forestAt, Option.some.injEq] at hG
    subst hG
    simp only [Tree.cols] at hne ⊢
    obtain ⟨ys, y, rfl⟩ := (List.eq_nil_or_concat cols).resolve_left hne
    cases ys with
    | nil => simp [replaceAt, shiftVal_zero_fun, treeMapCol_id_fun, Tree.cols]
    | cons c cs =>
      simp only [replaceAt, shiftVal_zero_fun, treeMapCol_id_fun, Tree.cols, List.map_id,
        List.length_nil]
      rw [List.concat_eq_append, List.dropLast_concat, List.getLast?_concat]; rfl
  | s :: π, .node cols, G, hr, hG, hne => by
    obtain ⟨hl, h, hh, hr'⟩ := isRoutePath_cons.1 hr
    obtain ⟨col, p, h', hcol, hcl, hs, hh'⟩ := lastStep?_eq_some hl
    rw [hh] at hh'
    cases hh'
    have hG' : h.forestAt π = some G := by
      rw [show s :: π = [s] ++ π from rfl, Tree.forestAt_append, hh] at hG
      exact hG
    have ih := spx_put_self π h G hr' hG' hne
    simp only [Tree.cols] at hcol
    obtain ⟨ys, rfl⟩ := List.getLast?_eq_some_iff.1 hcol
    obtain ⟨zs, rfl⟩ := List.getLast?_eq_some_iff.1 hcl
    simp only [List.length_cons, replaceAt, mapLast_eq, List.dropLast_concat, List.getLast?_concat,
      Option.map_some, Option.toList_some, shiftVal_zero_fun, treeMapCol_id_fun, id, treeMap_id,
      List.map_id, ih]
    simp

theorem spx_wordCol_ne (e : Nat) (c : Column) : wordCol e c ≠ [] := by
  cases c with
  | nil => simp [wordCol]
  | cons x xs => obtain ⟨p, h⟩ := x; simp [wordCol]

-- T3.2g: deletion steps and ordinary steps at parameter 0 are safe prefixes
theorem expand_safePrefix {E E' : Forest} {n : Nat} (hE : E ≠ Tree.empty) (hV : CondV E)
    (hI : CondI E) (hk : stepKind E = some .deletion ∨ (stepKind E = some .ordinary ∧ n = 0))
    (h : expand E n = some E') : ∃ k, k < mu E ∧ E' = safePrefix E k := by
  rcases hk with hd | ⟨ho, rfl⟩
  · rw [expand_deletion hd n, Option.some.injEq] at h
    subst h
    have hl := (stepKind_deletion_iff E).1 hd
    obtain ⟨ys, hys⟩ := List.getLast?_eq_some_iff.1 hl
    refine spx_safePrefix_of_word (X := [toLex (0, toLex (0, 0))]) (by simp) ?_
    obtain ⟨cols⟩ := E
    simp only [Tree.cols] at hys ⊢
    subst hys
    simp [word, wordAt, wordCols_append, wordCols, wordCol]
  · obtain ⟨sd, hsd⟩ := Option.isSome_iff_exists.1 (stopData_of_stepKind ho (by decide))
    rw [expand_zero_eq_context hE hV hI ho hsd, Option.some.injEq] at h
    subst h
    obtain ⟨-, hdep, -, hmem, -, hlen⟩ := stopData_spec hsd
    obtain ⟨hrp, F, hF, hFl⟩ := (mem_routeCols_iff E sd.col).1 hmem
    have hne : F.cols ≠ [] := by intro h0; rw [h0] at hFl; simp at hFl
    have hself := spx_put_self sd.col.path E F hrp hF hne
    have hput := word_put ⟨E, sd.depth⟩ (Tree.node [F.cols.getLast?.getD []]) (by simp; omega)
    simp only [Hole.put] at hput
    rw [hdep, hself, ← hdep] at hput
    refine spx_safePrefix_of_word ?_ hput
    simp only [wordAt, wordCols, List.append_nil]
    exact spx_wordCol_ne _ _


/-! ### T3.2k/T3.2x helpers (branch D3): relative V, I, H along the route

The ordinary output is `A_{0,0,ℓ,Z}(A)` with `Z = ordZ A sd rd n` (`paperOp_ordinary`). The
conditions V, I (and H below) are proved structurally: each is restated relative to the number of
the first column of a forest (`VRel_D3`, `IRel_D3`), shown stable under shifts and under the
unshifted route replacement `replaceAt 0 0 Z k` (`*_put_D3`), and carried through the loop
`ordStep` one phase at a time (`*_ordStep_D3`). -/

theorem num_cons_D3 (b j m : Nat) (P : List (Nat × Nat)) (c : Nat) :
    ColAddr.num b ⟨(j, m) :: P, c⟩ = ColAddr.num (b + j + 1) ⟨P, c⟩ := by
  simp only [ColAddr.num, List.map_cons, List.sum_cons]; omega

theorem num_nil_D3 (b c : Nat) : ColAddr.num b ⟨[], c⟩ = b + c := by
  simp [ColAddr.num]

theorem num_add_D3 (b d : Nat) (c : ColAddr) : c.num (b + d) = c.num b + d := by
  simp only [ColAddr.num]; omega

theorem entryAt_nil_D3 (cols : List Column) (j m : Nat) :
    (Tree.node cols).entryAt ⟨⟨[], j⟩, m⟩ = (cols[j]?).bind (·[m]?) := rfl

theorem entryAt_cons_D3 (cols : List Column) (j m : Nat) (P : List (Nat × Nat)) (c i : Nat) :
    (Tree.node cols).entryAt ⟨⟨(j, m) :: P, c⟩, i⟩ =
      ((cols[j]?).bind (·[m]?)).bind fun x => x.2.entryAt ⟨⟨P, c⟩, i⟩ :=
  Tree.entryAt_cons _ _ _ _ _ _

/-- Relative condition V: parents below the printed number, the outer forest starting at `b`. -/
def VRel_D3 (b : Nat) (F : Forest) : Prop :=
  ∀ e p h, F.entryAt e = some (p, h) → p < e.col.num b

theorem vrel_node_D3 (b : Nat) (cols : List Column) :
    VRel_D3 b (.node cols) ↔ ∀ (j : Nat) (col : Column), cols[j]? = some col →
      ∀ (m p : Nat) (h : Forest), col[m]? = some (p, h) →
      p < b + j ∧ VRel_D3 (b + j + 1) h := by
  constructor
  · intro hV j col hj m p h hm
    refine ⟨?_, ?_⟩
    · have := hV ⟨⟨[], j⟩, m⟩ p h (by rw [entryAt_nil_D3, hj]; exact hm)
      simpa [num_nil_D3] using this
    · intro e p' h' he
      obtain ⟨⟨P, c⟩, i⟩ := e
      have := hV ⟨⟨(j, m) :: P, c⟩, i⟩ p' h' (by rw [entryAt_cons_D3, hj]; simp [hm, he])
      simpa [num_cons_D3] using this
  · intro hV e p h he
    obtain ⟨⟨P, c⟩, i⟩ := e
    cases P with
    | nil =>
      rw [entryAt_nil_D3] at he
      cases hc : cols[c]? with
      | none => simp [hc] at he
      | some col =>
        simp only [hc, Option.bind_some] at he
        have := (hV c col hc i p h he).1
        simpa [num_nil_D3] using this
    | cons ab P =>
      obtain ⟨j, m⟩ := ab
      rw [entryAt_cons_D3] at he
      cases hc : cols[j]? with
      | none => simp [hc] at he
      | some col =>
        cases hm : col[m]? with
        | none => simp [hc, hm] at he
        | some x =>
          obtain ⟨q, hq⟩ := x
          simp only [hc, hm, Option.bind_some] at he
          have := (hV j col hc m q hq hm).2 ⟨⟨P, c⟩, i⟩ p h he
          simpa [num_cons_D3] using this

theorem condV_iff_vrel_D3 (E : Forest) : CondV E ↔ VRel_D3 0 E := by
  rw [condV_iff_lt]
  constructor
  · intro h e p hh he
    exact h e ((Tree.mem_entryAddrs_iff E e).2 (by rw [he]; rfl)) p hh he
  · intro h e _ p hh he
    exact h e p hh he


theorem cols_map_D3 (f : Nat → Nat) (F : Forest) :
    (Tree.map f F).cols = F.cols.map (Tree.mapCol f) := by
  obtain ⟨cols⟩ := F; simp [Tree.map, Tree.cols, treeMapCols_eq_map]

theorem forestAt_map_D3 (f : Nat → Nat) : ∀ (π : List (Nat × Nat)) (t : Forest),
    (Tree.map f t).forestAt π = (t.forestAt π).map (Tree.map f)
  | [], t => rfl
  | (c, i) :: rest, t => by
    rw [Tree.forestAt_cons, Tree.forestAt_cons, cols_map_D3]
    simp only [List.getElem?_map]
    cases hc : t.cols[c]? with
    | none => simp
    | some col =>
      simp only [Option.map_some, Option.bind_some, treeMapCol_eq_map, List.getElem?_map]
      cases hi : col[i]? with
      | none => simp
      | some x => simp [forestAt_map_D3 f rest x.2]

theorem colAt_map_D3 (f : Nat → Nat) (t : Forest) (c : ColAddr) :
    (Tree.map f t).colAt c = (t.colAt c).map (Tree.mapCol f) := by
  obtain ⟨π, j⟩ := c
  simp only [Tree.colAt, forestAt_map_D3]
  cases t.forestAt π with
  | none => simp
  | some F => simp [cols_map_D3, List.getElem?_map]

theorem entryAt_map_D3 (f : Nat → Nat) (t : Forest) (e : EntryAddr) :
    (Tree.map f t).entryAt e = (t.entryAt e).map fun x => (f x.1, Tree.map f x.2) := by
  obtain ⟨c, i⟩ := e
  simp only [Tree.entryAt, colAt_map_D3]
  cases t.colAt c with
  | none => simp
  | some col => simp [treeMapCol_eq_map, List.getElem?_map]

theorem shiftVal_le_D3 (r d p : Nat) : shiftVal r d p ≤ p + d := by
  unfold shiftVal; split <;> omega

theorem le_shiftVal_D3 (r d p : Nat) : p ≤ shiftVal r d p := by
  unfold shiftVal; split <;> omega

theorem shiftVal_mono_D3 (r d : Nat) {p q : Nat} (h : p ≤ q) : shiftVal r d p ≤ shiftVal r d q := by
  unfold shiftVal; split <;> split <;> omega

theorem shiftVal_strictMono_D3 (r d : Nat) {p q : Nat} (h : p < q) :
    shiftVal r d p < shiftVal r d q := by
  unfold shiftVal; split <;> split <;> omega

theorem vrel_shift_D3 {b : Nat} {F : Forest} (h : VRel_D3 b F) (r d : Nat) :
    VRel_D3 (b + d) (shift r d F) := by
  intro e p hh he
  rw [shift, entryAt_map_D3] at he
  cases h' : F.entryAt e with
  | none => simp [h'] at he
  | some x =>
    simp only [h', Option.map_some, Option.some.injEq, Prod.mk.injEq] at he
    obtain ⟨rfl, rfl⟩ := he
    have := h e x.1 x.2 h'
    rw [num_add_D3]
    have := shiftVal_le_D3 r d x.1
    omega

/-- The last-column, last-entry route reaches depth `k`. -/
def RouteOK_D3 : Nat → Forest → Prop
  | 0, F => F.cols ≠ []
  | k + 1, F => ∃ cs es p h, F = .node (cs ++ [es ++ [(p, h)]]) ∧ RouteOK_D3 k h

/-- The relative number of the route column at depth `k`. -/
def routeNum_D3 : Nat → Forest → Nat
  | 0, F => F.cols.length - 1
  | k + 1, F => F.cols.length + routeNum_D3 k (nextLayer F)

theorem nextLayer_snoc_D3 (cs : List Column) (es : Column) (p : Nat) (h : Forest) :
    nextLayer (.node (cs ++ [es ++ [(p, h)]])) = h := by
  simp [nextLayer, lastEntry?, Tree.cols]

theorem put_zero_D3 (Z : Forest) {cols : List Column} (hc : cols ≠ []) :
    replaceAt 0 0 Z 0 (.node cols) = .node (cols.dropLast ++ Z.cols) := by
  cases cols with
  | nil => exact absurd rfl hc
  | cons c cs =>
    simp only [replaceAt]
    rw [shiftVal_zero_fun 0, treeMapCol_id_fun, List.map_id]

theorem put_succ_D3 (Z : Forest) (k : Nat) (cs : List Column) (es : Column) (p : Nat)
    (h : Forest) :
    replaceAt 0 0 Z (k + 1) (.node (cs ++ [es ++ [(p, h)]])) =
      .node (cs ++ [es ++ [(p, replaceAt 0 0 Z k h)]]) := by
  simp only [replaceAt]
  rw [shiftVal_zero_fun 0, treeMapCol_id_fun]
  simp [mapLast_eq, treeMap_id]

theorem vrel_put_D3 (Z : Forest) : ∀ (k : Nat) (F : Forest) (b : Nat), RouteOK_D3 k F →
    VRel_D3 b F → VRel_D3 (b + routeNum_D3 k F) Z → VRel_D3 b (replaceAt 0 0 Z k F)
  | 0, .node cols, b, hR, hF, hZ => by
    have hc : cols ≠ [] := hR
    rw [put_zero_D3 Z hc]
    obtain ⟨zc⟩ := Z
    simp only [routeNum_D3, Tree.cols] at hZ ⊢
    rw [vrel_node_D3] at hF hZ ⊢
    intro j col hj m p h hm
    by_cases hjl : j < cols.length - 1
    · rw [List.getElem?_append_left (by simpa using hjl), List.getElem?_dropLast] at hj
      simp only [hjl, if_true] at hj
      exact hF j col hj m p h hm
    · rw [List.getElem?_append_right (by simp; omega)] at hj
      simp only [List.length_dropLast] at hj
      have := hZ _ col hj m p h hm
      have e : b + (cols.length - 1) + (j - (cols.length - 1)) = b + j := by omega
      rw [e] at this
      exact this
  | k + 1, F, b, hR, hF, hZ => by
    obtain ⟨cs, es, q, H, rfl, hR'⟩ := hR
    rw [put_succ_D3]
    simp only [routeNum_D3, nextLayer_snoc_D3, Tree.cols, List.length_append, List.length_singleton]
      at hZ
    rw [vrel_node_D3] at hF ⊢
    intro j col hj m p h hm
    by_cases hjl : j < cs.length
    · rw [List.getElem?_append_left hjl] at hj
      exact hF j col (by rw [List.getElem?_append_left hjl]; exact hj) m p h hm
    · have hjeq : j = cs.length := by
        have := (List.getElem?_eq_some_iff.1 hj).1; simp at this; omega
      subst hjeq
      simp only [List.getElem?_append_right (le_refl _), Nat.sub_self, List.getElem?_cons_zero,
        Option.some.injEq] at hj
      subst hj
      have hF' := hF cs.length (es ++ [(q, H)]) (by simp)
      by_cases hml : m < es.length
      · rw [List.getElem?_append_left hml] at hm
        exact hF' m p h (by rw [List.getElem?_append_left hml]; exact hm)
      · have hmeq : m = es.length := by
          have := (List.getElem?_eq_some_iff.1 hm).1; simp at this; omega
        subst hmeq
        simp only [List.getElem?_append_right (le_refl _), Nat.sub_self, List.getElem?_cons_zero,
          Option.some.injEq, Prod.mk.injEq] at hm
        obtain ⟨rfl, rfl⟩ := hm
        have := hF' es.length q H (by simp)
        refine ⟨this.1, vrel_put_D3 Z k H _ hR' this.2 ?_⟩
        have e : b + (cs.length + 1 + routeNum_D3 k H) = b + cs.length + 1 + routeNum_D3 k H := by
          omega
        rw [e] at hZ; exact hZ


/-- Column form of `VRel_D3`: a column numbered `b`. -/
def VCol_D3 (b : Nat) (col : Column) : Prop := ∀ x ∈ col, x.1 < b ∧ VRel_D3 (b + 1) x.2

/-- List-of-columns form of `VRel_D3`. -/
def VCols_D3 (b : Nat) (cols : List Column) : Prop :=
  ∀ (j : Nat) (col : Column), cols[j]? = some col → VCol_D3 (b + j) col

theorem vrel_iff_vcols_D3 (b : Nat) (cols : List Column) :
    VRel_D3 b (.node cols) ↔ VCols_D3 b cols := by
  rw [vrel_node_D3]
  constructor
  · intro h j col hj x hx
    obtain ⟨m, hm⟩ := List.getElem?_of_mem hx
    exact h j col hj m x.1 x.2 hm
  · intro h j col hj m p hh hm
    exact h j col hj (p, hh) (List.mem_of_getElem? hm)

theorem vrel_eq_vcols_D3 (b : Nat) (F : Forest) : VRel_D3 b F ↔ VCols_D3 b F.cols := by
  obtain ⟨cols⟩ := F; exact vrel_iff_vcols_D3 b cols

theorem vcols_nil_D3 (b : Nat) : VCols_D3 b [] := by
  intro j col hj; simp at hj

theorem vcols_cons_D3 (b : Nat) (c : Column) (cs : List Column) :
    VCols_D3 b (c :: cs) ↔ VCol_D3 b c ∧ VCols_D3 (b + 1) cs := by
  constructor
  · intro h
    refine ⟨by simpa using h 0 c rfl, fun j col hj => ?_⟩
    have := h (j + 1) col (by simpa using hj)
    rwa [show b + (j + 1) = b + 1 + j by omega] at this
  · rintro ⟨h1, h2⟩ j col hj
    cases j with
    | zero => simp at hj; subst hj; simpa using h1
    | succ j =>
      have := h2 j col (by simpa using hj)
      rw [show b + (j + 1) = b + 1 + j by omega]; exact this

theorem vcols_append_D3 (b : Nat) (cs ds : List Column) :
    VCols_D3 b (cs ++ ds) ↔ VCols_D3 b cs ∧ VCols_D3 (b + cs.length) ds := by
  induction cs generalizing b with
  | nil => simp [vcols_nil_D3]
  | cons c cs ih =>
    rw [List.cons_append, vcols_cons_D3, vcols_cons_D3, ih]
    simp only [List.length_cons, show b + 1 + cs.length = b + (cs.length + 1) by omega, and_assoc]

theorem vcols_single_D3 (b : Nat) (c : Column) : VCols_D3 b [c] ↔ VCol_D3 b c := by
  rw [vcols_cons_D3]; simp [vcols_nil_D3]

theorem vcol_append_D3 (b : Nat) (l₁ l₂ : Column) :
    VCol_D3 b (l₁ ++ l₂) ↔ VCol_D3 b l₁ ∧ VCol_D3 b l₂ := by
  simp only [VCol_D3, List.mem_append]
  constructor
  · intro h; exact ⟨fun x hx => h x (Or.inl hx), fun x hx => h x (Or.inr hx)⟩
  · rintro ⟨h1, h2⟩ x (hx | hx); exacts [h1 x hx, h2 x hx]

theorem vcol_mono_D3 {b b' : Nat} (hb : b ≤ b') {col : Column} (h : ∀ x ∈ col, x.1 < b)
    (h' : ∀ x ∈ col, VRel_D3 (b' + 1) x.2) : VCol_D3 b' col :=
  fun x hx => ⟨lt_of_lt_of_le (h x hx) hb, h' x hx⟩

theorem vrel_empty_D3 (b : Nat) : VRel_D3 b Tree.empty := by
  rw [show (Tree.empty : Forest) = .node [] from rfl, vrel_iff_vcols_D3]; exact vcols_nil_D3 b

/-- `VRel` inside a column of a forest. -/
theorem vrel_colAt_D3 {b : Nat} {F : Forest} (hF : VRel_D3 b F) {c : ColAddr} {col : Column}
    (hc : F.colAt c = some col) : VCol_D3 (c.num b) col := by
  intro x hx
  obtain ⟨m, hm⟩ := List.getElem?_of_mem hx
  have he : F.entryAt ⟨c, m⟩ = some (x.1, x.2) := by
    simp [Tree.entryAt, hc, hm]
  refine ⟨hF _ _ _ he, ?_⟩
  intro e p h he'
  obtain ⟨⟨P, j⟩, i⟩ := e
  have hG : F.forestAt c.path = some (.node ((F.forestAt c.path).getD Tree.empty).cols) := by
    cases hf : F.forestAt c.path with
    | none => simp [Tree.colAt, hf] at hc
    | some G => obtain ⟨gc⟩ := G; rfl
  have hcol : ((F.forestAt c.path).getD Tree.empty).cols[c.col]? = some col := by
    simp only [Tree.colAt] at hc
    cases hf : F.forestAt c.path with
    | none => simp [hf] at hc
    | some G => simp only [hf, Option.bind_some] at hc; simpa using hc
  have hf : F.forestAt (c.path ++ (c.col, m) :: P) = x.2.forestAt P := by
    rw [Tree.forestAt_append, hG]
    simp only [Option.bind_some]
    rw [Tree.forestAt_cons]
    have e : (Tree.node ((F.forestAt c.path).getD Tree.empty).cols).cols =
      ((F.forestAt c.path).getD Tree.empty).cols := rfl
    rw [e, hcol]; simp [hm]
  have : F.entryAt ⟨⟨c.path ++ (c.col, m) :: P, j⟩, i⟩ = some (p, h) := by
    rw [Tree.entryAt_eq_bind, hf, ← Tree.entryAt_eq_bind]; exact he'
  have := hF _ _ _ this
  simp only [ColAddr.num, List.map_append, List.map_cons, List.sum_append, List.sum_cons] at this ⊢
  omega

theorem vrel_forestAt_D3 {b : Nat} {F : Forest} (hF : VRel_D3 b F) {π : List (Nat × Nat)}
    {G : Forest} (hG : F.forestAt π = some G) :
    VRel_D3 (b + (π.map (·.1 + 1)).sum) G := by
  intro e p h he
  obtain ⟨⟨P, j⟩, i⟩ := e
  have : F.entryAt ⟨⟨π ++ P, j⟩, i⟩ = some (p, h) := by
    rw [Tree.entryAt_eq_bind, Tree.forestAt_append, hG]
    simp only [Option.bind_some]
    rw [Tree.entryAt_eq_bind] at he; exact he
  have := hF _ _ _ this
  simp only [ColAddr.num, List.map_append, List.sum_append] at this ⊢
  omega

theorem vcols_drop_D3 {b : Nat} {cols : List Column} (h : VCols_D3 b cols) (k : Nat) :
    VCols_D3 (b + k) (cols.drop k) := by
  intro j col hj
  rw [List.getElem?_drop] at hj
  have := h (k + j) col hj
  rwa [show b + (k + j) = b + k + j by omega] at this

theorem nextLayer_map_D3 (f : Nat → Nat) (F : Forest) :
    nextLayer (Tree.map f F) = Tree.map f (nextLayer F) := by
  obtain ⟨cols⟩ := F
  rcases List.eq_nil_or_concat cols with rfl | ⟨cs, c, rfl⟩
  · rfl
  rcases List.eq_nil_or_concat c with rfl | ⟨es, x, rfl⟩
  · simp [nextLayer, lastEntry?, Tree.map, Tree.cols, treeMapCols_eq_map, treeMapCol_eq_map,
      Tree.empty, Tree.mapCols]
  · simp [nextLayer, lastEntry?, Tree.map, Tree.cols, treeMapCols_eq_map, treeMapCol_eq_map]

theorem routeOK_shift_D3 (r d : Nat) : ∀ (k : Nat) (F : Forest),
    RouteOK_D3 k (shift r d F) ↔ RouteOK_D3 k F
  | 0, .node cols => by
    simp [RouteOK_D3, shift, Tree.map, Tree.cols, treeMapCols_eq_map]
  | k + 1, .node cols => by
    simp only [RouteOK_D3]
    constructor
    · rintro ⟨cs, es, p, h, he, hR⟩
      simp only [shift, Tree.map, treeMapCols_eq_map, Tree.node.injEq] at he
      rcases List.eq_nil_or_concat cols with rfl | ⟨cs', c, rfl⟩
      · simp at he
      rw [List.concat_eq_append, List.map_append, List.map_singleton] at he
      obtain ⟨hcs, hc⟩ := List.append_inj' he (by simp)
      simp only [List.cons.injEq, and_true] at hc
      rw [treeMapCol_eq_map] at hc
      rcases List.eq_nil_or_concat c with rfl | ⟨es', x, rfl⟩
      · simp at hc
      rw [List.concat_eq_append, List.map_append, List.map_singleton] at hc
      obtain ⟨-, hx⟩ := List.append_inj' hc (by simp)
      simp only [List.cons.injEq, and_true, Prod.mk.injEq] at hx
      refine ⟨cs', es', x.1, x.2, by simp, ?_⟩
      rw [← routeOK_shift_D3 r d k x.2]
      have : shift r d x.2 = h := hx.2
      rw [this]; exact hR
    · rintro ⟨cs, es, p, h, he, hR⟩
      cases he
      refine ⟨cs.map (Tree.mapCol (shiftVal r d)), es.map (fun x => (shiftVal r d x.1, Tree.map (shiftVal r d) x.2)),
        shiftVal r d p, shift r d h, ?_, (routeOK_shift_D3 r d k h).2 hR⟩
      simp [shift, Tree.map, treeMapCols_eq_map, treeMapCol_eq_map]

theorem routeNum_shift_D3 (r d : Nat) : ∀ (k : Nat) (F : Forest),
    routeNum_D3 k (shift r d F) = routeNum_D3 k F
  | 0, .node cols => by
    simp [routeNum_D3, shift, Tree.map, Tree.cols, treeMapCols_eq_map]
  | k + 1, .node cols => by
    simp only [routeNum_D3]
    have hlen : (shift r d (.node cols)).cols.length = (Tree.node cols).cols.length := by
      simp [shift, Tree.map, Tree.cols, treeMapCols_eq_map]
    have hnext : nextLayer (shift r d (.node cols)) = shift r d (nextLayer (.node cols)) :=
      nextLayer_map_D3 _ _
    rw [hlen, hnext, routeNum_shift_D3 r d k]


theorem leftCount_succ_D3 (E : Forest) (k : Nat) :
    leftCount E (k + 1) = leftCount E k + (skipLayers E k).cols.length := by
  rw [leftCount_eq_sum, leftCount_eq_sum, List.range_succ, List.map_append, List.sum_append]
  simp

theorem stop_route_D3 {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    ∀ i, i ≤ sd.depth → RouteOK_D3 i (skipLayers E (sd.depth - i)) ∧
      leftCount E (sd.depth - i) + routeNum_D3 i (skipLayers E (sd.depth - i)) = sd.t := by
  obtain ⟨h1, h2, h3, h4, h5, -, h7, -⟩ := stopData_core h
  intro i hi
  induction i with
  | zero =>
    simp only [Nat.sub_zero, RouteOK_D3, routeNum_D3]
    refine ⟨fun he => by rw [he] at h1; simp at h1, ?_⟩
    rw [h3, ← h7]; simp only [ColAddr.num]; omega
  | succ i ih =>
    obtain ⟨ih1, ih2⟩ := ih (by omega)
    obtain ⟨col, p, hc, hp, -, -⟩ := h5 (sd.depth - (i + 1)) (by omega)
    obtain ⟨cs, hcs⟩ := List.getLast?_eq_some_iff.1 hc
    obtain ⟨es, hes⟩ := List.getLast?_eq_some_iff.1 hp
    have hk : sd.depth - (i + 1) + 1 = sd.depth - i := by omega
    rw [hk] at hes
    have hF : skipLayers E (sd.depth - (i + 1)) = .node (cs ++ [es ++ [(p, skipLayers E (sd.depth - i))]]) := by
      rw [← hes, ← hcs]; cases skipLayers E (sd.depth - (i + 1)); rfl
    refine ⟨⟨cs, es, p, _, hF, ih1⟩, ?_⟩
    simp only [routeNum_D3]
    rw [hF, nextLayer_snoc_D3, ← hF]
    have := leftCount_succ_D3 E (sd.depth - (i + 1))
    rw [hk] at this
    omega

theorem stop_route_top_D3 {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    RouteOK_D3 sd.depth E ∧ routeNum_D3 sd.depth E = sd.t := by
  have := stop_route_D3 h sd.depth le_rfl
  simpa [skipLayers, leftCount] using this

theorem stop_pathSum_D3 {E : Forest} {sd : StopData} (h : stopData E = some sd) :
    ∀ k, k ≤ sd.depth → ((sd.col.path.take k).map (·.1 + 1)).sum = leftCount E k := by
  obtain ⟨-, h2, -, -, h5, -⟩ := stopData_core h
  intro k hk
  induction k with
  | zero => simp [leftCount]
  | succ k ih =>
    obtain ⟨col, p, hc, -, -, hpk⟩ := h5 k (by omega)
    rw [List.take_add_one, hpk, leftCount_succ_D3, ← ih (by omega)]
    have hne : (skipLayers E k).cols ≠ [] := by intro he; rw [he] at hc; simp at hc
    have : 0 < (skipLayers E k).cols.length := List.length_pos_iff.2 hne
    simp; omega

theorem root_facts_D3 {E : Forest} {sd : StopData} {rd : RootData} (hsd : stopData E = some sd)
    (hrd : rootData E = some rd) :
    rd.layer ≤ sd.depth ∧ E.forestAt rd.col.path = some (skipLayers E rd.layer) ∧
      sd.r = leftCount E rd.layer + rd.idx ∧ rd.idx < (skipLayers E rd.layer).cols.length ∧
      (rd.owner = true ↔ rd.idx + 1 = (skipLayers E rd.layer).cols.length) ∧
      E.colAt rd.col = (skipLayers E rd.layer).cols[rd.idx]? := by
  obtain ⟨-, hlay, hidx, hnum, -, hmem, -, hown⟩ := rootData_spec hsd hrd
  obtain ⟨-, -, -, hpre, -⟩ := rootData_path hsd hrd
  have hle := rootData_layer_le hsd hrd
  have hpath : rd.col.path = sd.col.path.take rd.layer := by
    obtain ⟨t, ht⟩ := hpre
    rw [hlay, ← ht, List.take_left' rfl]
  have hfa : E.forestAt rd.col.path = some (skipLayers E rd.layer) := by
    rw [hpath]; exact skipLayers_of_stopData hsd hle
  have hcol : E.colAt rd.col = (skipLayers E rd.layer).cols[rd.idx]? := by
    simp [Tree.colAt, hfa, hidx]
  refine ⟨hle, hfa, ?_, ?_, ?_, hcol⟩
  · rw [← hnum]; simp only [ColAddr.num]
    rw [hpath, stop_pathSum_D3 hsd _ hle, hidx]; omega
  · have := (Tree.mem_colAddrs_iff E rd.col).1 hmem
    rw [hcol] at this
    by_contra hc
    rw [List.getElem?_eq_none (by omega)] at this
    simp at this
  · rw [hown, hidx]
    constructor
    · rintro ⟨F, hF, h⟩; rw [hfa] at hF; cases hF; exact h
    · intro h; exact ⟨_, hfa, h⟩


theorem body_route_D3 {E : Forest} {sd : StopData} {rd : RootData} (hsd : stopData E = some sd)
    (hrd : rootData E = some rd) (hown : rd.owner = false) :
    RouteOK_D3 (sd.depth - rd.layer) (.node ((skipLayers E rd.layer).cols.drop (rd.idx + 1))) ∧
      sd.r + 1 + routeNum_D3 (sd.depth - rd.layer)
        (.node ((skipLayers E rd.layer).cols.drop (rd.idx + 1))) = sd.t := by
  obtain ⟨hle, -, hr, hidx, howner, -⟩ := root_facts_D3 hsd hrd
  have hlt : rd.idx + 1 < (skipLayers E rd.layer).cols.length := by
    have : ¬ rd.idx + 1 = (skipLayers E rd.layer).cols.length := by
      rw [← howner, hown]; simp
    omega
  obtain ⟨hR, hN⟩ := stop_route_D3 hsd (sd.depth - rd.layer) (by omega)
  rw [show sd.depth - (sd.depth - rd.layer) = rd.layer by omega] at hR hN
  generalize skipLayers E rd.layer = G at *
  generalize hi : sd.depth - rd.layer = i at hR hN ⊢
  cases i with
  | zero =>
    refine ⟨?_, ?_⟩
    · show G.cols.drop (rd.idx + 1) ≠ []
      intro h; rw [List.drop_eq_nil_iff] at h; omega
    · show sd.r + 1 + ((G.cols.drop (rd.idx + 1)).length - 1) = sd.t
      simp only [routeNum_D3] at hN
      rw [List.length_drop]; omega
  | succ i =>
    obtain ⟨cs, es, p, h, rfl, hR'⟩ := hR
    simp only [Tree.cols, List.length_append, List.length_singleton] at hlt
    have hdrop : (cs ++ [es ++ [(p, h)]]).drop (rd.idx + 1) =
        cs.drop (rd.idx + 1) ++ [es ++ [(p, h)]] := List.drop_append_of_le_length (by omega)
    simp only [Tree.cols, hdrop]
    refine ⟨⟨_, _, _, _, rfl, hR'⟩, ?_⟩
    simp only [routeNum_D3, nextLayer_snoc_D3, Tree.cols, List.length_append, List.length_singleton,
      List.length_drop] at hN ⊢
    omega

theorem owner_route_D3 {E : Forest} {sd : StopData} {rd : RootData} (hsd : stopData E = some sd)
    (hrd : rootData E = some rd) (hown : rd.owner = true) :
    ∃ es p h, E.colAt rd.col = some (es ++ [(p, h)]) ∧
      RouteOK_D3 (sd.depth - rd.layer - 1) h ∧
      sd.r + 1 + routeNum_D3 (sd.depth - rd.layer - 1) h = sd.t := by
  obtain ⟨hle, -, hr, hidx, howner, hcol⟩ := root_facts_D3 hsd hrd
  have hlt := rootData_layer_lt hsd hrd hown
  have hidx' := howner.1 hown
  obtain ⟨hR, hN⟩ := stop_route_D3 hsd (sd.depth - rd.layer) (by omega)
  rw [show sd.depth - (sd.depth - rd.layer) = rd.layer by omega] at hR hN
  obtain ⟨i, hi⟩ : ∃ i, sd.depth - rd.layer = i + 1 := ⟨sd.depth - rd.layer - 1, by omega⟩
  rw [hi] at hR hN
  obtain ⟨cs, es, p, h, hG, hR'⟩ := hR
  rw [hG] at hidx' hN hcol
  simp only [Tree.cols, List.length_append, List.length_singleton] at hidx'
  refine ⟨es, p, h, ?_, by rw [hi]; exact hR', ?_⟩
  · rw [hcol]; simp [Tree.cols, show rd.idx = cs.length by omega]
  · simp only [routeNum_D3, nextLayer_snoc_D3, Tree.cols, List.length_append,
      List.length_singleton] at hN
    rw [show sd.depth - rd.layer - 1 = i by omega]
    omega

theorem vcol_shift_D3 {b : Nat} {col : Column} (h : VCol_D3 b col) (r d : Nat) :
    VCol_D3 (b + d) (Tree.mapCol (shiftVal r d) col) := by
  rw [treeMapCol_eq_map]
  intro x hx
  obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx
  obtain ⟨h1, h2⟩ := h y hy
  refine ⟨lt_of_le_of_lt (shiftVal_le_D3 r d y.1) (by omega), ?_⟩
  have := vrel_shift_D3 h2 r d
  rwa [show b + 1 + d = b + d + 1 by omega] at this

theorem vcol_shiftH_D3 {b b' : Nat} {col : Column} (h : VCol_D3 b col) (hb : b ≤ b') (r d : Nat)
    (hd : b' = b + d) :
    VCol_D3 b' (col.map fun x => (x.1, shift r d x.2)) := by
  intro x hx
  obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx
  obtain ⟨h1, h2⟩ := h y hy
  refine ⟨by simp; omega, ?_⟩
  have := vrel_shift_D3 h2 r d
  rwa [show b + 1 + d = b' + 1 by omega] at this

theorem vcol_sub_D3 {b : Nat} {l l' : Column} (h : VCol_D3 b l) (hs : ∀ x ∈ l', x ∈ l) :
    VCol_D3 b l' := fun x hx => h x (hs x hx)

/-- Step `k` of the ordinary loop keeps relative V, one phase down. -/
theorem vrel_ordStep_D3 {sd : StopData} {rd : RootData} {F : Forest} {U : Column} {k : Nat}
    {Z : Forest} (hk : 1 ≤ k) (hrt : sd.r < sd.t) (hQ : VCol_D3 sd.t sd.Q) (hU : VCol_D3 sd.r U)
    (hbody : rd.owner = false →
      RouteOK_D3 (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) ∧
      VRel_D3 (sd.r + 1) (.node (F.cols.drop (rd.idx + 1))) ∧
      sd.r + 1 + routeNum_D3 (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) = sd.t)
    (howner : rd.owner = true → ∀ x, U.getLast? = some x →
      RouteOK_D3 (sd.depth - rd.layer - 1) x.2 ∧
      sd.r + 1 + routeNum_D3 (sd.depth - rd.layer - 1) x.2 = sd.t)
    (hZ : VRel_D3 (sd.t + k * (sd.t - sd.r)) Z) :
    VRel_D3 (sd.r + k * (sd.t - sd.r)) (ordStep sd rd F U k Z) := by
  have key : sd.t + (k - 1) * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) := by
    obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
    simp only [Nat.add_sub_cancel, Nat.succ_mul]; omega
  have hQ' : VCol_D3 (sd.r + k * (sd.t - sd.r))
      (Tree.mapCol (shiftVal sd.r ((k - 1) * (sd.t - sd.r))) sd.Q) := by
    rw [← key]; exact vcol_shift_D3 hQ _ _
  have hU' : ∀ l : Column, (∀ x ∈ l, x ∈ U) → VCol_D3 (sd.r + k * (sd.t - sd.r))
      (l.map fun x => (x.1, shift sd.r (k * (sd.t - sd.r)) x.2)) :=
    fun l hl => vcol_shiftH_D3 (vcol_sub_D3 hU hl) (by omega) _ _ rfl
  unfold ordStep
  simp only
  split
  · rename_i hown
    rw [vrel_iff_vcols_D3, vcols_single_D3, vcol_append_D3, vcol_append_D3]
    refine ⟨⟨hQ', hU' _ (fun x hx => List.mem_of_mem_dropLast hx)⟩, ?_⟩
    intro x hx
    cases hl : U.getLast? with
    | none => simp [hl] at hx
    | some u =>
      simp only [hl, Option.map_some, Option.toList_some, List.mem_singleton] at hx
      subst hx
      have hu : u ∈ U := List.mem_of_getLast? hl
      obtain ⟨hR, hN⟩ := howner hown u hl
      refine ⟨by simp; exact lt_of_lt_of_le (hU u hu).1 (by omega), ?_⟩
      simp only
      rw [Hole.fill_eq_put]
      refine vrel_put_D3 Z _ _ _ ((routeOK_shift_D3 _ _ _ _).2 hR) ?_ ?_
      · have := vrel_shift_D3 (hU u hu).2 sd.r (k * (sd.t - sd.r))
        rwa [show sd.r + 1 + k * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) + 1 by omega] at this
      · rw [routeNum_shift_D3]
        rwa [show sd.r + k * (sd.t - sd.r) + 1 + routeNum_D3 (sd.depth - rd.layer - 1) u.2 =
          sd.t + k * (sd.t - sd.r) by omega]
  · rename_i hown
    have hown' : rd.owner = false := by simpa using hown
    obtain ⟨hR, hB, hN⟩ := hbody hown'
    rw [vrel_iff_vcols_D3, vcols_cons_D3, vcol_append_D3, ← vrel_eq_vcols_D3]
    refine ⟨⟨hQ', hU' U (fun x hx => hx)⟩, ?_⟩
    rw [Hole.fill_eq_put]
    refine vrel_put_D3 Z _ _ _ ((routeOK_shift_D3 _ _ _ _).2 hR) ?_ ?_
    · have := vrel_shift_D3 hB sd.r (k * (sd.t - sd.r))
      rwa [show sd.r + 1 + k * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) + 1 by omega] at this
    · rw [routeNum_shift_D3]
      rwa [show sd.r + k * (sd.t - sd.r) + 1 + routeNum_D3 (sd.depth - rd.layer)
        (.node (F.cols.drop (rd.idx + 1))) = sd.t + k * (sd.t - sd.r) by omega]

theorem ordLoop_induct_D3 {step : Nat → Forest → Forest} {P : Nat → Forest → Prop}
    (hstep : ∀ k Z, 1 ≤ k → P k Z → P (k - 1) (step k Z)) :
    ∀ m Z, P m Z → P 0 (ordLoop step m Z)
  | 0, Z, h => h
  | m + 1, Z, h => ordLoop_induct_D3 hstep m _ (by simpa using hstep (m + 1) Z (by omega) h)


theorem ne_empty_of_stepKind_D3 {E : Forest} {k : StepKind} (h : stepKind E = some k) :
    E ≠ Tree.empty := by
  rintro rfl; simp [stepKind, stepKindBody, Tree.empty, Tree.cols] at h

/-- The ordinary output, unfolded: `B = A_{0,0,ℓ,Z}(A)` with `Z = ordZ A sd rd n`. -/
theorem ord_output_D3 {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .ordinary)
    (hB : expand A n = some B) :
    ∃ sd rd, stopData A = some sd ∧ rootData A = some rd ∧
      B = replaceAt 0 0 (ordZ A sd rd n) sd.depth A ∧
      ¬ (rd.owner = true ∧ n ≠ 0 ∧ ((A.colAt rd.col).getD []).drop rd.cursor = []) := by
  obtain ⟨sd, hsd⟩ := Option.isSome_iff_exists.mp (stopData_of_stepKind hk (by decide))
  obtain ⟨rd, hrd⟩ := Option.isSome_iff_exists.mp (rootData_of_ordinary hk)
  rw [expand_eq_paperOp (ne_empty_of_stepKind_D3 hk) hL.1 hL.2.1, paperOp_ordinary hk hsd hrd] at hB
  refine ⟨sd, rd, hsd, hrd, ?_⟩
  split at hB
  · cases hB
  · rename_i hc
    cases hB
    refine ⟨rfl, ?_⟩
    rintro ⟨h1, h2, h3⟩
    apply hc
    simp [h1, h2, h3]

/-- The data of an ordinary step used by the structural closure proofs. -/
theorem ord_vdata_D3 {A : Forest} {sd : StopData} {rd : RootData} (hV : CondV A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) :
    let F := (A.forestAt rd.col.path).getD Tree.empty
    let U := ((A.colAt rd.col).getD []).drop rd.cursor
    sd.r < sd.t ∧ VCol_D3 sd.t sd.Q ∧ VCol_D3 sd.r U ∧
    (rd.owner = false →
      RouteOK_D3 (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) ∧
      VRel_D3 (sd.r + 1) (.node (F.cols.drop (rd.idx + 1))) ∧
      sd.r + 1 + routeNum_D3 (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) = sd.t) ∧
    (rd.owner = true → ∀ x, U.getLast? = some x →
      RouteOK_D3 (sd.depth - rd.layer - 1) x.2 ∧
      sd.r + 1 + routeNum_D3 (sd.depth - rd.layer - 1) x.2 = sd.t) := by
  intro F U
  have hA := (condV_iff_vrel_D3 A).1 hV
  obtain ⟨-, -, hidx, hnum, hrt, hmem, -, -⟩ := rootData_spec hsd hrd
  obtain ⟨hle, hfa, hr, -, -, -⟩ := root_facts_D3 hsd hrd
  obtain ⟨hcolsd, -, ht, -⟩ := stopData_spec hsd
  have hF : F = skipLayers A rd.layer := by simp [F, hfa]
  refine ⟨hrt, ?_, ?_, ?_, ?_⟩
  · have := vrel_colAt_D3 hA hcolsd
    rw [ht]; exact ((vcol_append_D3 _ _ _).1 this).1
  · obtain ⟨R, hR⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff A rd.col).1 hmem)
    have := vrel_colAt_D3 hA hR
    rw [show rd.col.num 0 = sd.r from hnum] at this
    simp only [U, hR, Option.getD_some]
    exact vcol_sub_D3 this (fun x hx => List.mem_of_mem_drop hx)
  · intro hown
    obtain ⟨h1, h2⟩ := body_route_D3 hsd hrd hown
    rw [hF]
    refine ⟨h1, ?_, h2⟩
    have hG := vrel_forestAt_D3 hA hfa
    have hsum : (rd.col.path.map (·.1 + 1)).sum = leftCount A rd.layer := by
      have : rd.col.num 0 = (rd.col.path.map (·.1 + 1)).sum + rd.col.col := by
        simp [ColAddr.num]
      omega
    rw [Nat.zero_add, hsum] at hG
    rw [vrel_eq_vcols_D3] at hG
    rw [vrel_iff_vcols_D3]
    have := vcols_drop_D3 hG (rd.idx + 1)
    rwa [show leftCount A rd.layer + (rd.idx + 1) = sd.r + 1 by omega] at this
  · intro hown x hx
    obtain ⟨es, p, h, hc, h1, h2⟩ := owner_route_D3 hsd hrd hown
    have hx' : x = (p, h) := by
      simp only [U, hc, Option.getD_some, List.getLast?_drop] at hx
      split at hx
      · cases hx
      · simp at hx; exact hx.symm
    subst hx'
    exact ⟨h1, h2⟩


/-! ### Relative condition I -/

theorem Tree.treeMapCol_append_D3 (f : Nat → Nat) (l₁ l₂ : Column) :
    Tree.mapCol f (l₁ ++ l₂) = Tree.mapCol f l₁ ++ Tree.mapCol f l₂ := by
  simp [treeMapCol_eq_map]

/-- The column's first parent is at least the host (vacuous without a host). -/
def FirstOK_D3 (host : Option Nat) (col : Column) : Prop :=
  ∀ a, host = some a → ∃ q H rest, col = (q, H) :: rest ∧ a ≤ q

/-- The host number of column `c` (the outer host `host` at top level). -/
def hostNum_D3 (b : Nat) (host : Option Nat) (c : ColAddr) : Option Nat :=
  match c.path.getLast? with
  | none => host
  | some x => some (ColAddr.num b ⟨c.path.dropLast, x.1⟩)

/-- Relative condition I: every column's first parent is at least its host. -/
def IRel_D3 (b : Nat) (host : Option Nat) (F : Forest) : Prop :=
  ∀ c col, F.colAt c = some col → FirstOK_D3 (hostNum_D3 b host c) col

def ICols_D3 (b : Nat) (host : Option Nat) (cols : List Column) : Prop :=
  ∀ (j : Nat) (col : Column), cols[j]? = some col →
    FirstOK_D3 host col ∧ ∀ x ∈ col, IRel_D3 (b + j + 1) (some (b + j)) x.2

theorem hostNum_nil_D3 (b : Nat) (host : Option Nat) (k : Nat) :
    hostNum_D3 b host ⟨[], k⟩ = host := rfl

theorem hostNum_cons_D3 (b : Nat) (host : Option Nat) (j m : Nat) (P : List (Nat × Nat)) (k : Nat) :
    hostNum_D3 b host ⟨(j, m) :: P, k⟩ = hostNum_D3 (b + j + 1) (some (b + j)) ⟨P, k⟩ := by
  rcases List.eq_nil_or_concat' P with rfl | ⟨P', x, rfl⟩
  · simp [hostNum_D3, ColAddr.num]
  · simp only [hostNum_D3, ← List.cons_append, List.getLast?_append, List.getLast?_singleton,
      Option.some_or, List.dropLast_concat]
    rw [num_cons_D3]

theorem colAt_nil_D3 (cols : List Column) (k : Nat) :
    (Tree.node cols).colAt ⟨[], k⟩ = cols[k]? := rfl

theorem colAt_cons_D3 (cols : List Column) (j m : Nat) (P : List (Nat × Nat)) (k : Nat) :
    (Tree.node cols).colAt ⟨(j, m) :: P, k⟩ =
      ((cols[j]?).bind (·[m]?)).bind fun x => x.2.colAt ⟨P, k⟩ :=
  Tree.colAt_cons _ _ _ _ _

theorem irel_iff_icols_D3 (b : Nat) (host : Option Nat) (cols : List Column) :
    IRel_D3 b host (.node cols) ↔ ICols_D3 b host cols := by
  constructor
  · intro hI j col hj
    refine ⟨by simpa [hostNum_nil_D3] using hI ⟨[], j⟩ col (by rw [colAt_nil_D3]; exact hj), ?_⟩
    intro x hx c col' hc
    obtain ⟨m, hm⟩ := List.getElem?_of_mem hx
    obtain ⟨P, k⟩ := c
    have := hI ⟨(j, m) :: P, k⟩ col' (by rw [colAt_cons_D3, hj]; simp [hm, hc])
    rwa [hostNum_cons_D3] at this
  · intro hI c col hc
    obtain ⟨P, k⟩ := c
    cases P with
    | nil =>
      rw [colAt_nil_D3] at hc
      rw [hostNum_nil_D3]; exact (hI k col hc).1
    | cons ab P =>
      obtain ⟨j, m⟩ := ab
      rw [colAt_cons_D3] at hc
      cases hcj : cols[j]? with
      | none => simp [hcj] at hc
      | some cj =>
        cases hm : cj[m]? with
        | none => simp [hcj, hm] at hc
        | some x =>
          simp only [hcj, hm, Option.bind_some] at hc
          rw [hostNum_cons_D3]
          exact (hI j cj hcj).2 x (List.mem_of_getElem? hm) _ col hc

theorem irel_eq_icols_D3 (b : Nat) (host : Option Nat) (F : Forest) :
    IRel_D3 b host F ↔ ICols_D3 b host F.cols := by
  obtain ⟨cols⟩ := F; exact irel_iff_icols_D3 b host cols

theorem condI_iff_irel_D3 (E : Forest) : CondI E ↔ IRel_D3 0 none E := by
  constructor
  · intro hI c col hc a ha
    obtain ⟨P, k⟩ := c
    rcases List.eq_nil_or_concat' P with rfl | ⟨π, x, rfl⟩
    · simp [hostNum_D3] at ha
    obtain ⟨ci, ei⟩ := x
    simp only [hostNum_D3, List.getLast?_concat, List.dropLast_concat, Option.some.injEq] at ha
    subst ha
    have hfa : E.forestAt (π ++ [(ci, ei)]) = E.heightAt ⟨⟨π, ci⟩, ei⟩ :=
      Tree.forestAt_heightPath E ⟨⟨π, ci⟩, ei⟩
    cases hh : E.heightAt ⟨⟨π, ci⟩, ei⟩ with
    | none => simp [Tree.colAt, hfa, hh] at hc
    | some h =>
      simp only [Tree.colAt, hfa, hh, Option.bind_some] at hc
      obtain ⟨p, hp⟩ : ∃ p, E.entryAt ⟨⟨π, ci⟩, ei⟩ = some (p, h) := by
        simp only [Tree.heightAt] at hh
        cases he : E.entryAt ⟨⟨π, ci⟩, ei⟩ with
        | none => simp [he] at hh
        | some y => simp [he] at hh; exact ⟨y.1, by rw [← hh]⟩
      have hne : h ≠ Tree.empty := by
        rintro rfl; simp [Tree.empty, Tree.cols] at hc
      exact hI _ ((Tree.mem_entryAddrs_iff E _).2 (by rw [hp]; rfl)) p h hp hne col
        (List.mem_of_getElem? hc)
  · intro hI e _ p h he hne col hcol
    obtain ⟨k, hk⟩ := List.getElem?_of_mem hcol
    have hc : E.colAt ⟨e.heightPath, k⟩ = some col := by
      simp only [Tree.colAt, Tree.forestAt_heightPath, Tree.heightAt, he, Option.map_some,
        Option.bind_some]
      exact hk
    have := hI _ col hc (e.col.num 0)
    apply this
    simp [hostNum_D3, EntryAddr.heightPath]

theorem firstOK_mono_D3 {a a' : Nat} (h : a' ≤ a) {col : Column} (hc : FirstOK_D3 (some a) col) :
    FirstOK_D3 (some a') col := by
  intro x hx; cases hx
  obtain ⟨q, H, rest, rfl, hq⟩ := hc a rfl
  exact ⟨q, H, rest, rfl, le_trans h hq⟩

theorem firstOK_none_D3 (col : Column) : FirstOK_D3 none col := by
  intro a ha; cases ha

theorem firstOK_shift_D3 {host : Option Nat} {col : Column} (h : FirstOK_D3 host col) (r d : Nat) :
    FirstOK_D3 (host.map (shiftVal r d)) (Tree.mapCol (shiftVal r d) col) := by
  intro a ha
  cases host with
  | none => cases ha
  | some a0 =>
    simp only [Option.map_some, Option.some.injEq] at ha; subst ha
    obtain ⟨q, H, rest, rfl, hq⟩ := h a0 rfl
    exact ⟨_, _, _, rfl, shiftVal_mono_D3 r d hq⟩

/-- `FirstOK` reads only the first parent. -/
theorem firstOK_of_fst_D3 {host : Option Nat} {col col' : Column} (h : FirstOK_D3 host col)
    (hfst : ∀ x, col.head? = some x → ∃ y, col'.head? = some y ∧ y.1 = x.1) :
    FirstOK_D3 host col' := by
  intro a ha
  obtain ⟨q, H, rest, rfl, hq⟩ := h a ha
  obtain ⟨y, hy, hyq⟩ := hfst _ rfl
  cases col' with
  | nil => simp at hy
  | cons y' ys => simp at hy; subst hy; exact ⟨y'.1, y'.2, ys, rfl, by rw [hyq]; exact hq⟩

theorem hostNum_shift_D3 {b r : Nat} (hrb : r ≤ b) (d : Nat) (host : Option Nat) (c : ColAddr) :
    hostNum_D3 (b + d) (host.map (shiftVal r d)) c = (hostNum_D3 b host c).map (shiftVal r d) := by
  simp only [hostNum_D3]
  cases c.path.getLast? with
  | none => rfl
  | some x =>
    simp only [Option.map_some, Option.some.injEq]
    rw [num_add_D3]
    have : b ≤ ColAddr.num b ⟨c.path.dropLast, x.1⟩ := by simp only [ColAddr.num]; omega
    unfold shiftVal; rw [if_pos (by omega)]

theorem irel_shift_D3 {b : Nat} {host : Option Nat} {F : Forest} (h : IRel_D3 b host F) {r : Nat}
    (hrb : r ≤ b) (d : Nat) : IRel_D3 (b + d) (host.map (shiftVal r d)) (shift r d F) := by
  intro c col hc
  rw [shift, colAt_map_D3] at hc
  cases h' : F.colAt c with
  | none => simp [h'] at hc
  | some col0 =>
    simp only [h', Option.map_some, Option.some.injEq] at hc
    subst hc
    rw [hostNum_shift_D3 hrb]
    exact firstOK_shift_D3 (h c col0 h') r d

theorem irel_empty_D3 (b : Nat) (host : Option Nat) : IRel_D3 b host Tree.empty := by
  intro c col hc
  obtain ⟨P, k⟩ := c
  cases P with
  | nil => simp [Tree.colAt, Tree.forestAt, Tree.empty, Tree.cols] at hc
  | cons ab P => simp [Tree.colAt, Tree.forestAt, Tree.empty, Tree.cols] at hc

theorem icols_nil_D3 (b : Nat) (host : Option Nat) : ICols_D3 b host [] := by
  intro j col hj; simp at hj

theorem icols_cons_D3 (b : Nat) (host : Option Nat) (c : Column) (cs : List Column) :
    ICols_D3 b host (c :: cs) ↔
      (FirstOK_D3 host c ∧ ∀ x ∈ c, IRel_D3 (b + 1) (some b) x.2) ∧ ICols_D3 (b + 1) host cs := by
  constructor
  · intro h
    refine ⟨by simpa using h 0 c rfl, fun j col hj => ?_⟩
    have := h (j + 1) col (by simpa using hj)
    rwa [show b + (j + 1) = b + 1 + j by omega] at this
  · rintro ⟨h1, h2⟩ j col hj
    cases j with
    | zero => simp at hj; subst hj; simpa using h1
    | succ j =>
      have := h2 j col (by simpa using hj)
      rw [show b + (j + 1) = b + 1 + j by omega]; exact this

theorem icols_append_D3 (b : Nat) (host : Option Nat) (cs ds : List Column) :
    ICols_D3 b host (cs ++ ds) ↔ ICols_D3 b host cs ∧ ICols_D3 (b + cs.length) host ds := by
  induction cs generalizing b with
  | nil => simp [icols_nil_D3]
  | cons c cs ih =>
    rw [List.cons_append, icols_cons_D3, icols_cons_D3, ih]
    simp only [List.length_cons, show b + 1 + cs.length = b + (cs.length + 1) by omega, and_assoc]

theorem icols_single_D3 (b : Nat) (host : Option Nat) (c : Column) :
    ICols_D3 b host [c] ↔ FirstOK_D3 host c ∧ ∀ x ∈ c, IRel_D3 (b + 1) (some b) x.2 := by
  rw [icols_cons_D3]; simp [icols_nil_D3]

theorem icols_drop_D3 {b : Nat} {host : Option Nat} {cols : List Column}
    (h : ICols_D3 b host cols) (k : Nat) : ICols_D3 (b + k) host (cols.drop k) := by
  intro j col hj
  rw [List.getElem?_drop] at hj
  have := h (k + j) col hj
  rwa [show b + (k + j) = b + k + j by omega] at this

/-- The host of the route forest at depth `k`. -/
def routeHost_D3 : Nat → Option Nat → Nat → Forest → Option Nat
  | _, host, 0, _ => host
  | b, _, k + 1, F => routeHost_D3 (b + F.cols.length) (some (b + (F.cols.length - 1))) k (nextLayer F)

theorem irel_put_D3 (Z : Forest) : ∀ (k : Nat) (F : Forest) (b : Nat) (host : Option Nat),
    RouteOK_D3 k F → IRel_D3 b host F →
    IRel_D3 (b + routeNum_D3 k F) (routeHost_D3 b host k F) Z →
    IRel_D3 b host (replaceAt 0 0 Z k F)
  | 0, .node cols, b, host, hR, hF, hZ => by
    have hc : cols ≠ [] := hR
    rw [put_zero_D3 Z hc]
    obtain ⟨zc⟩ := Z
    simp only [routeNum_D3, routeHost_D3, Tree.cols] at hZ ⊢
    rw [irel_iff_icols_D3] at hF hZ ⊢
    have hlen : (cols.dropLast).length = cols.length - 1 := List.length_dropLast
    rw [icols_append_D3, hlen]
    refine ⟨?_, hZ⟩
    have := (List.dropLast_append_getLast hc)
    rw [← this, icols_append_D3] at hF
    exact hF.1
  | k + 1, F, b, host, hR, hF, hZ => by
    obtain ⟨cs, es, q, H, rfl, hR'⟩ := hR
    rw [put_succ_D3]
    simp only [routeNum_D3, routeHost_D3, nextLayer_snoc_D3, Tree.cols, List.length_append,
      List.length_singleton] at hZ
    rw [irel_iff_icols_D3, icols_append_D3, icols_single_D3] at hF ⊢
    obtain ⟨hF1, hF2, hF3⟩ := hF
    refine ⟨hF1, ?_, ?_⟩
    · refine firstOK_of_fst_D3 hF2 ?_
      intro x hx
      cases es with
      | nil => simp at hx; subst hx; exact ⟨_, rfl, rfl⟩
      | cons e es => simp at hx; subst hx; exact ⟨_, rfl, rfl⟩
    · intro x hx
      rw [List.mem_append, List.mem_singleton] at hx
      rcases hx with hx | rfl
      · exact hF3 x (List.mem_append_left _ hx)
      · refine irel_put_D3 Z k H _ _ hR' (hF3 (q, H) (by simp)) ?_
        have e1 : b + cs.length + 1 + routeNum_D3 k H = b + (cs.length + 1 + routeNum_D3 k H) := by
          omega
        have e2 : b + cs.length + 1 - 1 = b + cs.length := by omega
        rw [e1]
        convert hZ using 2
        · omega
        · rw [show b + (cs.length + 1 - 1) = b + cs.length by omega]


theorem routeHost_split_D3 : ∀ (k1 k2 b : Nat) (h : Option Nat) (F : Forest),
    routeHost_D3 b h (k1 + k2) F =
      routeHost_D3 (b + leftCount F k1) (routeHost_D3 b h k1 F) k2 (skipLayers F k1)
  | 0, k2, b, h, F => by simp [routeHost_D3, leftCount, skipLayers]
  | k1 + 1, k2, b, h, F => by
    rw [show k1 + 1 + k2 = (k1 + k2) + 1 by omega]
    simp only [routeHost_D3, leftCount, skipLayers]
    rw [routeHost_split_D3 k1 k2]
    congr 1; omega

theorem routeHost_shiftBase_D3 (δ : Nat) : ∀ (k b : Nat) (X : Option Nat) (F : Forest),
    routeHost_D3 (b + δ) (X.map (· + δ)) k F = (routeHost_D3 b X k F).map (· + δ)
  | 0, b, X, F => rfl
  | k + 1, b, X, F => by
    simp only [routeHost_D3]
    have := routeHost_shiftBase_D3 δ k (b + F.cols.length) (some (b + (F.cols.length - 1)))
      (nextLayer F)
    simp only [Option.map_some] at this
    rw [show b + δ + F.cols.length = b + F.cols.length + δ by omega,
      show b + δ + (F.cols.length - 1) = b + (F.cols.length - 1) + δ by omega]
    exact this

theorem routeHost_shift_D3 (r d : Nat) : ∀ (k b : Nat) (X : Option Nat) (F : Forest),
    routeHost_D3 b X k (shift r d F) = routeHost_D3 b X k F
  | 0, b, X, F => rfl
  | k + 1, b, X, F => by
    simp only [routeHost_D3]
    have hlen : (shift r d F).cols.length = F.cols.length := by
      obtain ⟨cols⟩ := F; simp [shift, Tree.map, Tree.cols, treeMapCols_eq_map]
    rw [hlen, show nextLayer (shift r d F) = shift r d (nextLayer F) from nextLayer_map_D3 _ _,
      routeHost_shift_D3 r d k]

theorem routeHost_bound_D3 : ∀ (k b : Nat) (h : Option Nat) (F : Forest) (a : Nat),
    RouteOK_D3 k F → routeHost_D3 b h k F = some a →
      h = some a ∨ (b ≤ a ∧ a < b + leftCount F k)
  | 0, b, h, F, a, _, hh => Or.inl hh
  | k + 1, b, h, F, a, hR, hh => by
    obtain ⟨cs, es, p, H, rfl, hR'⟩ := hR
    simp only [routeHost_D3, nextLayer_snoc_D3, Tree.cols, List.length_append,
      List.length_singleton] at hh
    rcases routeHost_bound_D3 k _ _ H a hR' hh with h1 | ⟨h1, h2⟩
    · simp at h1
      right; simp only [leftCount, Tree.cols, List.length_append, List.length_singleton]; omega
    · right; simp only [leftCount, Tree.cols, List.length_append, List.length_singleton,
        nextLayer_snoc_D3]
      omega

theorem routeOK_le_D3 : ∀ (k : Nat) (F : Forest) (j : Nat), RouteOK_D3 k F → j ≤ k → RouteOK_D3 j F
  | 0, F, j, h, hj => by rw [show j = 0 by omega]; exact h
  | k + 1, F, 0, h, _ => by
    obtain ⟨cs, es, p, H, rfl, -⟩ := h
    simp [RouteOK_D3, Tree.cols]
  | k + 1, F, j + 1, h, hj => by
    obtain ⟨cs, es, p, H, rfl, hR'⟩ := h
    exact ⟨cs, es, p, H, rfl, routeOK_le_D3 k H j hR' (by omega)⟩

theorem leftCount_mono_D3 (E : Forest) {j k : Nat} (h : j ≤ k) : leftCount E j ≤ leftCount E k := by
  induction k with
  | zero => rw [show j = 0 by omega]
  | succ k ih =>
    rcases Nat.lt_or_ge j (k + 1) with hj | hj
    · rw [leftCount_succ_D3]; have := ih (by omega); omega
    · rw [show j = k + 1 by omega]

theorem irel_skip_D3 : ∀ (k b : Nat) (host : Option Nat) (F : Forest), RouteOK_D3 k F →
    IRel_D3 b host F → IRel_D3 (b + leftCount F k) (routeHost_D3 b host k F) (skipLayers F k)
  | 0, b, host, F, _, h => by simpa [leftCount, skipLayers, routeHost_D3] using h
  | k + 1, b, host, F, hR, h => by
    obtain ⟨cs, es, p, H, rfl, hR'⟩ := hR
    simp only [leftCount, skipLayers, routeHost_D3, nextLayer_snoc_D3, Tree.cols,
      List.length_append, List.length_singleton]
    rw [irel_iff_icols_D3, icols_append_D3, icols_single_D3] at h
    have hH := h.2.2 (p, H) (by simp)
    have := irel_skip_D3 k _ _ H hR' hH
    rw [show b + (cs.length + 1 + leftCount H k) = b + cs.length + 1 + leftCount H k by omega,
      show b + (cs.length + 1) = b + cs.length + 1 by omega,
      show b + (cs.length + 1 - 1) = b + cs.length by omega]
    exact this

theorem vrel_skip_D3 : ∀ (k b : Nat) (F : Forest), RouteOK_D3 k F →
    VRel_D3 b F → VRel_D3 (b + leftCount F k) (skipLayers F k)
  | 0, b, F, _, h => by simpa [leftCount, skipLayers] using h
  | k + 1, b, F, hR, h => by
    obtain ⟨cs, es, p, H, rfl, hR'⟩ := hR
    simp only [leftCount, skipLayers, nextLayer_snoc_D3, Tree.cols,
      List.length_append, List.length_singleton]
    rw [vrel_iff_vcols_D3, vcols_append_D3, vcols_single_D3] at h
    have hH := (h.2 (p, H) (by simp)).2
    have := vrel_skip_D3 k _ H hR' hH
    rwa [show b + cs.length + 1 + leftCount H k = b + (cs.length + 1 + leftCount H k) by omega]
      at this

theorem irel_host_mono_D3 {b : Nat} {h h' : Option Nat} {F : Forest} (hF : IRel_D3 b h F)
    (hh : ∀ a', h' = some a' → ∃ a, h = some a ∧ a' ≤ a) : IRel_D3 b h' F := by
  intro c col hc
  have := hF c col hc
  simp only [hostNum_D3] at this ⊢
  cases hl : c.path.getLast? with
  | none =>
    rw [hl] at this
    intro a' ha'
    obtain ⟨a, rfl, ha⟩ := hh a' ha'
    exact firstOK_mono_D3 ha this a' rfl
  | some x => rw [hl] at this; exact this


theorem firstOK_map_fst_D3 {host : Option Nat} {col : Column} (h : FirstOK_D3 host col)
    (g : Nat × Forest → Nat × Forest) (hg : ∀ x, (g x).1 = x.1) : FirstOK_D3 host (col.map g) :=
  firstOK_of_fst_D3 h (fun x hx => ⟨g x, by cases col <;> simp_all, hg x⟩)

theorem firstOK_append_D3 {host : Option Nat} {l₁ l₂ : Column} (h : FirstOK_D3 host l₁)
    (hne : l₁ ≠ []) : FirstOK_D3 host (l₁ ++ l₂) :=
  firstOK_of_fst_D3 h (fun x hx => ⟨x, by cases l₁ <;> simp_all, rfl⟩)

theorem head_mapLast_fst_D3 {col : Column}
    (f g : Nat × Forest → Nat × Forest) (hf : ∀ x, (f x).1 = x.1) (hg : ∀ x, (g x).1 = x.1) :
    ∀ x, col.head? = some x → ∃ y, (mapLast f g col).head? = some y ∧ y.1 = x.1 := by
  intro x hx
  match col, hx with
  | [y], hx => simp at hx; subst hx; exact ⟨g y, by simp [mapLast], hg y⟩
  | y :: z :: zs, hx => simp at hx; subst hx; exact ⟨f y, by simp [mapLast], hf y⟩

/-- Step `k` of the ordinary loop keeps relative I, one phase down. -/
theorem irel_ordStep_D3 {sd : StopData} {rd : RootData} {F : Forest} {U : Column} {k : Nat}
    {Z : Forest} {hostSd : Option Nat} (hk : 1 ≤ k) (hrt : sd.r < sd.t)
    (hlt : ∀ a, hostSd = some a → a < sd.t)
    (hQ1 : FirstOK_D3 hostSd (sd.Q ++ [(sd.r, Tree.empty)]))
    (hQ2 : ∀ x ∈ sd.Q, IRel_D3 (sd.t + 1) (some sd.t) x.2)
    (hU2 : ∀ x ∈ U, IRel_D3 (sd.r + 1) (some sd.r) x.2)
    (hQnil : sd.Q = [] → ∀ a, hostSd = some a → a < sd.r ∧ FirstOK_D3 (some a) U)
    (hbodyR : rd.owner = false →
      RouteOK_D3 (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) ∧
      sd.r + 1 + routeNum_D3 (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) = sd.t)
    (hbody0 : rd.owner = false → sd.depth - rd.layer = 0 →
      IRel_D3 (sd.r + 1) hostSd (.node (F.cols.drop (rd.idx + 1))) ∧
      ∀ a, hostSd = some a → a < sd.r)
    (hbody1 : rd.owner = false → 1 ≤ sd.depth - rd.layer →
      IRel_D3 (sd.r + 1) (some sd.r) (.node (F.cols.drop (rd.idx + 1))) ∧
      routeHost_D3 (sd.r + 1) (some sd.r) (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) =
        hostSd ∧ ∀ a, hostSd = some a → sd.r ≤ a)
    (hownerR : rd.owner = true → ∀ x, U.getLast? = some x →
      RouteOK_D3 (sd.depth - rd.layer - 1) x.2 ∧
      sd.r + 1 + routeNum_D3 (sd.depth - rd.layer - 1) x.2 = sd.t)
    (howner : rd.owner = true → ∀ x, U.getLast? = some x →
      routeHost_D3 (sd.r + 1) (some sd.r) (sd.depth - rd.layer - 1) x.2 = hostSd ∧
      ∀ a, hostSd = some a → sd.r ≤ a)
    (hZ : IRel_D3 (sd.t + k * (sd.t - sd.r)) (hostSd.map (shiftVal sd.r (k * (sd.t - sd.r)))) Z) :
    IRel_D3 (sd.r + k * (sd.t - sd.r)) (hostSd.map (shiftVal sd.r ((k - 1) * (sd.t - sd.r))))
      (ordStep sd rd F U k Z) := by
  have key : sd.t + (k - 1) * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) := by
    obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
    simp only [Nat.add_sub_cancel, Nat.succ_mul]; omega
  -- the head column's heights
  have hQh : ∀ x ∈ Tree.mapCol (shiftVal sd.r ((k - 1) * (sd.t - sd.r))) sd.Q,
      IRel_D3 (sd.r + k * (sd.t - sd.r) + 1) (some (sd.r + k * (sd.t - sd.r))) x.2 := by
    intro x hx
    rw [treeMapCol_eq_map] at hx
    obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx
    have := irel_shift_D3 (hQ2 y hy) (r := sd.r) (by omega) ((k - 1) * (sd.t - sd.r))
    simp only [Option.map_some] at this
    rw [show shiftVal sd.r ((k - 1) * (sd.t - sd.r)) sd.t = sd.t + (k - 1) * (sd.t - sd.r) by
      unfold shiftVal; rw [if_pos (by omega)]] at this
    rw [show sd.t + 1 + (k - 1) * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) + 1 by omega, key] at this
    exact this
  have hUh : ∀ x ∈ U, IRel_D3 (sd.r + k * (sd.t - sd.r) + 1) (some (sd.r + k * (sd.t - sd.r)))
      (shift sd.r (k * (sd.t - sd.r)) x.2) := by
    intro x hx
    have := irel_shift_D3 (hU2 x hx) (r := sd.r) (by omega) (k * (sd.t - sd.r))
    simp only [Option.map_some] at this
    rw [show shiftVal sd.r (k * (sd.t - sd.r)) sd.r = sd.r + k * (sd.t - sd.r) by
      unfold shiftVal; rw [if_pos le_rfl]] at this
    rwa [show sd.r + 1 + k * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) + 1 by omega] at this
  -- the head column's first parent
  have hfirst : ∀ (rest : Column), (∀ x, U.head? = some x → ∃ y, rest.head? = some y ∧ y.1 = x.1) →
      FirstOK_D3 (hostSd.map (shiftVal sd.r ((k - 1) * (sd.t - sd.r))))
        (Tree.mapCol (shiftVal sd.r ((k - 1) * (sd.t - sd.r))) sd.Q ++ rest) := by
    intro rest hrest
    by_cases hQ : sd.Q = []
    · rw [hQ]
      simp only [Tree.mapCol, List.nil_append]
      intro a ha
      cases hs : hostSd with
      | none => rw [hs] at ha; cases ha
      | some a0 =>
        rw [hs] at ha
        simp only [Option.map_some, Option.some.injEq] at ha
        obtain ⟨h1, h2⟩ := hQnil hQ a0 hs
        rw [show shiftVal sd.r ((k - 1) * (sd.t - sd.r)) a0 = a0 by
          unfold shiftVal; rw [if_neg (by omega)]] at ha
        subst ha
        exact firstOK_of_fst_D3 h2 hrest a0 rfl
    · have h1 := firstOK_shift_D3 hQ1 sd.r ((k - 1) * (sd.t - sd.r))
      rw [Tree.treeMapCol_append_D3] at h1
      have hne : Tree.mapCol (shiftVal sd.r ((k - 1) * (sd.t - sd.r))) sd.Q ≠ [] := by
        rw [treeMapCol_eq_map]; simpa using hQ
      refine firstOK_of_fst_D3 h1 (fun x hx => ⟨x, ?_, rfl⟩)
      cases hq : Tree.mapCol (shiftVal sd.r ((k - 1) * (sd.t - sd.r))) sd.Q with
      | nil => exact absurd hq hne
      | cons y ys => rw [hq] at hx; simp at hx ⊢; exact hx
  unfold ordStep
  simp only
  split
  · rename_i hown
    rw [irel_iff_icols_D3, icols_single_D3]
    refine ⟨?_, ?_⟩
    · rw [List.append_assoc]
      refine hfirst _ (fun x hx => ?_)
      have e := mapLast_eq (fun x : Nat × Forest => (x.1, shift sd.r (k * (sd.t - sd.r)) x.2))
        (fun x : Nat × Forest => (x.1, Hole.fill ⟨x.2, sd.depth - rd.layer - 1⟩ sd.r
          (k * (sd.t - sd.r)) Z)) U
      rw [← e]
      exact head_mapLast_fst_D3 (fun x : Nat × Forest => (x.1, shift sd.r (k * (sd.t - sd.r)) x.2))
        (fun x : Nat × Forest => (x.1, Hole.fill ⟨x.2, sd.depth - rd.layer - 1⟩ sd.r
          (k * (sd.t - sd.r)) Z)) (fun _ => rfl) (fun _ => rfl) x hx
    · intro x hx
      rw [List.mem_append, List.mem_append] at hx
      rcases hx with (hx | hx) | hx
      · exact hQh x hx
      · obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx
        exact hUh y (List.mem_of_mem_dropLast hy)
      · cases hl : U.getLast? with
        | none => simp [hl] at hx
        | some u =>
          simp only [hl, Option.map_some, Option.toList_some, List.mem_singleton] at hx
          subst hx
          have hu : u ∈ U := List.mem_of_getLast? hl
          obtain ⟨hR, hN⟩ := hownerR hown u hl
          obtain ⟨hH, hge⟩ := howner hown u hl
          simp only
          rw [Hole.fill_eq_put]
          refine irel_put_D3 Z _ _ _ _ ((routeOK_shift_D3 _ _ _ _).2 hR) (hUh u hu) ?_
          rw [routeNum_shift_D3, routeHost_shift_D3]
          have := routeHost_shiftBase_D3 (k * (sd.t - sd.r)) (sd.depth - rd.layer - 1) (sd.r + 1)
            (some sd.r) u.2
          simp only [Option.map_some] at this
          rw [show sd.r + k * (sd.t - sd.r) + 1 = sd.r + 1 + k * (sd.t - sd.r) by omega,
            show sd.r + k * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) from rfl]
          rw [show sd.r + k * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) from rfl] at this
          rw [this, hH]
          rw [show sd.r + 1 + k * (sd.t - sd.r) + routeNum_D3 (sd.depth - rd.layer - 1) u.2 =
            sd.t + k * (sd.t - sd.r) by omega]
          have hmap : hostSd.map (· + k * (sd.t - sd.r)) = hostSd.map (shiftVal sd.r (k * (sd.t - sd.r))) := by
            cases hs : hostSd with
            | none => rfl
            | some a =>
              simp only [Option.map_some, Option.some.injEq]
              unfold shiftVal; rw [if_pos (hge a hs)]
          rw [hmap]; exact hZ
  · rename_i hown
    have hown' : rd.owner = false := by simpa using hown
    obtain ⟨hR, hN⟩ := hbodyR hown'
    rw [irel_iff_icols_D3, icols_cons_D3, ← irel_eq_icols_D3]
    refine ⟨⟨hfirst _ (fun x hx => ?_), ?_⟩, ?_⟩
    · cases U with
      | nil => simp at hx
      | cons u us =>
        simp at hx; subst hx
        exact ⟨(u.1, shift sd.r (k * (sd.t - sd.r)) u.2), by simp, rfl⟩
    · intro x hx
      rw [List.mem_append] at hx
      rcases hx with hx | hx
      · exact hQh x hx
      · obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx
        exact hUh y hy
    · rw [Hole.fill_eq_put]
      by_cases hd0 : sd.depth - rd.layer = 0
      · obtain ⟨hB, hlt'⟩ := hbody0 hown' hd0
        have hfix : ∀ δ, hostSd.map (shiftVal sd.r δ) = hostSd := by
          intro δ
          cases hs : hostSd with
          | none => rfl
          | some a =>
            simp only [Option.map_some, Option.some.injEq]
            unfold shiftVal; rw [if_neg (by have := hlt' a hs; omega)]
        rw [hfix]
        have hB' := irel_shift_D3 hB (r := sd.r) (by omega) (k * (sd.t - sd.r))
        rw [hfix, show sd.r + 1 + k * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) + 1 by omega] at hB'
        refine irel_put_D3 Z _ _ _ _ ((routeOK_shift_D3 _ _ _ _).2 hR) hB' ?_
        rw [routeNum_shift_D3, hd0]
        simp only [routeHost_D3]
        rw [hfix] at hZ
        rw [hd0] at hN
        rwa [show sd.r + k * (sd.t - sd.r) + 1 + routeNum_D3 0 (.node (F.cols.drop (rd.idx + 1))) =
          sd.t + k * (sd.t - sd.r) by omega]
      · obtain ⟨hB, hH, hge⟩ := hbody1 hown' (by omega)
        have hB' := irel_shift_D3 hB (r := sd.r) (by omega) (k * (sd.t - sd.r))
        simp only [Option.map_some] at hB'
        rw [show shiftVal sd.r (k * (sd.t - sd.r)) sd.r = sd.r + k * (sd.t - sd.r) by
          unfold shiftVal; rw [if_pos le_rfl],
          show sd.r + 1 + k * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) + 1 by omega] at hB'
        have hB'' : IRel_D3 (sd.r + k * (sd.t - sd.r) + 1)
            (hostSd.map (shiftVal sd.r ((k - 1) * (sd.t - sd.r))))
            (shift sd.r (k * (sd.t - sd.r)) (.node (F.cols.drop (rd.idx + 1)))) := by
          refine irel_host_mono_D3 hB' (fun a' ha' => ⟨_, rfl, ?_⟩)
          cases hs : hostSd with
          | none => rw [hs] at ha'; cases ha'
          | some a =>
            rw [hs] at ha'
            simp only [Option.map_some, Option.some.injEq] at ha'
            subst ha'
            have := hlt a hs
            have := shiftVal_le_D3 sd.r ((k - 1) * (sd.t - sd.r)) a
            omega
        refine irel_put_D3 Z _ _ _ _ ((routeOK_shift_D3 _ _ _ _).2 hR) hB'' ?_
        rw [routeNum_shift_D3, routeHost_shift_D3]
        obtain ⟨hd', hd'eq⟩ : ∃ hd', sd.depth - rd.layer = hd' + 1 := ⟨_, (Nat.succ_pred_eq_of_ne_zero hd0).symm⟩
        rw [hd'eq] at hH hN ⊢
        have hind : ∀ X Y : Option Nat, ∀ b,
            routeHost_D3 b X (hd' + 1) (.node (F.cols.drop (rd.idx + 1))) =
            routeHost_D3 b Y (hd' + 1) (.node (F.cols.drop (rd.idx + 1))) := fun _ _ _ => rfl
        rw [hind _ ((some sd.r).map (· + k * (sd.t - sd.r)))]
        have := routeHost_shiftBase_D3 (k * (sd.t - sd.r)) (hd' + 1) (sd.r + 1) (some sd.r)
          (.node (F.cols.drop (rd.idx + 1)))
        rw [show sd.r + k * (sd.t - sd.r) + 1 = sd.r + 1 + k * (sd.t - sd.r) by omega, this, hH]
        rw [show sd.r + 1 + k * (sd.t - sd.r) +
            routeNum_D3 (hd' + 1) (.node (F.cols.drop (rd.idx + 1))) = sd.t + k * (sd.t - sd.r) by
          omega]
        have hmap : hostSd.map (· + k * (sd.t - sd.r)) = hostSd.map (shiftVal sd.r (k * (sd.t - sd.r))) := by
          cases hs : hostSd with
          | none => rfl
          | some a =>
            simp only [Option.map_some, Option.some.injEq]
            unfold shiftVal; rw [if_pos (hge a hs)]
        rw [hmap]; exact hZ


theorem getElem_of_getLast_D3 {l : List Column} {x : Column} {k : Nat} (h : l.getLast? = some x)
    (hk : k + 1 = l.length) : l[k]? = some x := by
  rw [List.getLast?_eq_getElem?] at h; rwa [show k = l.length - 1 by omega]

/-- Data of an ordinary step for relative I, part 1: the stopping column and the root column. -/
theorem ord_idata1_D3 {A : Forest} {sd : StopData} {rd : RootData} (hI : CondI A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) :
    (∀ a, routeHost_D3 0 none sd.depth A = some a → a < sd.t) ∧
    FirstOK_D3 (routeHost_D3 0 none sd.depth A) (sd.Q ++ [(sd.r, Tree.empty)]) ∧
    (∀ x ∈ sd.Q, IRel_D3 (sd.t + 1) (some sd.t) x.2) ∧
    (∀ x ∈ ((A.colAt rd.col).getD []).drop rd.cursor, IRel_D3 (sd.r + 1) (some sd.r) x.2) := by
  have hA : IRel_D3 0 none A := (condI_iff_irel_D3 A).1 hI
  obtain ⟨h1, -, -, h4, -⟩ := stopData_core hsd
  obtain ⟨hRA, -⟩ := stop_route_top_D3 hsd
  obtain ⟨-, htd⟩ := stop_route_D3 hsd 0 (Nat.zero_le _)
  simp only [Nat.sub_zero, routeNum_D3] at htd
  obtain ⟨hle, -, hr, hidx, -, hcol⟩ := root_facts_D3 hsd hrd
  have hRj : RouteOK_D3 rd.layer A := routeOK_le_D3 _ _ _ hRA hle
  have hIj := irel_skip_D3 rd.layer 0 none A hRj hA
  have hId := irel_skip_D3 sd.depth 0 none A hRA hA
  rw [Nat.zero_add] at hIj hId
  rw [irel_eq_icols_D3] at hIj hId
  have hcolsd := getElem_of_getLast_D3 h4 h1
  obtain ⟨hQ1, hQ2⟩ := hId _ _ hcolsd
  refine ⟨?_, hQ1, ?_, ?_⟩
  · intro a ha
    rcases routeHost_bound_D3 _ _ _ _ a hRA ha with h | ⟨-, h⟩
    · cases h
    · omega
  · intro x hx
    have := hQ2 x (List.mem_append_left _ hx)
    rwa [show leftCount A sd.depth + sd.col.col = sd.t by omega] at this
  · intro x hx
    cases hc : A.colAt rd.col with
    | none => simp [hc] at hx
    | some R =>
      rw [hc, Option.getD_some] at hx
      rw [hcol] at hc
      have := (hIj _ _ hc).2 x (List.mem_of_mem_drop hx)
      rwa [← hr] at this

/-- Data of an ordinary step for relative I, part 2: an empty query. -/
theorem ord_idata2_D3 {A : Forest} {sd : StopData} {rd : RootData} (hL : InL A)
    (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd) (hrd : rootData A = some rd) :
    sd.Q = [] → ∀ a, routeHost_D3 0 none sd.depth A = some a →
      a < sd.r ∧ FirstOK_D3 (some a) (((A.colAt rd.col).getD []).drop rd.cursor) := by
  intro hQ a ha
  have hA : IRel_D3 0 none A := (condI_iff_irel_D3 A).1 hL.2.1
  obtain ⟨h1, -, -, h4, h5, -⟩ := stopData_core hsd
  obtain ⟨hRA, -⟩ := stop_route_top_D3 hsd
  obtain ⟨-, htd⟩ := stop_route_D3 hsd 0 (Nat.zero_le _)
  simp only [Nat.sub_zero, routeNum_D3] at htd
  obtain ⟨hle, -, hr, hidx, -, hcol⟩ := root_facts_D3 hsd hrd
  obtain ⟨-, hQ1, -, -⟩ := ord_idata1_D3 hL.2.1 hsd hrd
  have hpos : 0 < sd.depth := by
    rcases Nat.eq_zero_or_pos sd.depth with h0 | h0
    · rw [h0] at ha; simp [routeHost_D3] at ha
    · exact h0
  -- the host is the last container: `a + 1 = leftCount A depth`
  have ha1 : a + 1 = leftCount A sd.depth := by
    have := routeHost_split_D3 (sd.depth - 1) 1 0 none A
    rw [show sd.depth - 1 + 1 = sd.depth by omega, ha] at this
    simp only [routeHost_D3, Nat.zero_add] at this
    obtain ⟨col, p, hc, -⟩ := h5 (sd.depth - 1) (by omega)
    have hne : (skipLayers A (sd.depth - 1)).cols ≠ [] := by intro he; rw [he] at hc; simp at hc
    have hlen := List.length_pos_iff.2 hne
    have := leftCount_succ_D3 A (sd.depth - 1)
    rw [show sd.depth - 1 + 1 = sd.depth by omega] at this
    simp only [Option.some.injEq] at *
    omega
  have hns := (stepKind_ordinary_iff_unfold (ne_empty_of_stepKind_D3 hk) hL.1 hL.2.1).1 hk
  obtain ⟨sd', hsd', hspec, -⟩ := hns
  rw [hsd] at hsd'; cases hsd'
  have har : a ≤ sd.r := by
    rw [hQ] at hQ1
    obtain ⟨q, H, rest, he, hq⟩ := hQ1 a ha
    simp at he; omega
  have hne : sd.r ≠ a := by
    intro he; apply hspec; exact ⟨hpos, hQ, by omega⟩
  refine ⟨by omega, ?_⟩
  -- the root lies in the stopping forest
  have hj : rd.layer = sd.depth := by
    by_contra hj
    have := leftCount_succ_D3 A rd.layer
    have := leftCount_mono_D3 A (show rd.layer + 1 ≤ sd.depth by omega)
    omega
  have hcur : rd.cursor = 0 := by
    obtain ⟨-, -, -, -, -, -, hc, -⟩ := rootData_spec hsd hrd
    rw [hc, queryKeys, hQ]; exact cursor_nil_right _
  have hId := irel_skip_D3 sd.depth 0 none A hRA hA
  rw [Nat.zero_add, irel_eq_icols_D3] at hId
  rw [hcur, List.drop_zero]
  have hc' : A.colAt rd.col = (skipLayers A sd.depth).cols[rd.idx]? := by rw [hcol, hj]
  cases hc : A.colAt rd.col with
  | none => rw [hc] at hc'; rw [hj] at hidx; rw [List.getElem?_eq_getElem hidx] at hc'; cases hc'
  | some R =>
    rw [Option.getD_some]
    rw [hc] at hc'
    intro a' ha'; cases ha'
    exact (hId _ _ hc'.symm).1 a ha


/-- Data of an ordinary step for relative I, part 3: the body and the owner's last height. -/
theorem ord_idata3_D3 {A : Forest} {sd : StopData} {rd : RootData} (hL : InL A)
    (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd) (hrd : rootData A = some rd) :
    let hostSd := routeHost_D3 0 none sd.depth A
    let F := (A.forestAt rd.col.path).getD Tree.empty
    let U := ((A.colAt rd.col).getD []).drop rd.cursor
    (rd.owner = false → sd.depth - rd.layer = 0 →
      IRel_D3 (sd.r + 1) hostSd (.node (F.cols.drop (rd.idx + 1))) ∧
      ∀ a, hostSd = some a → a < sd.r) ∧
    (rd.owner = false → 1 ≤ sd.depth - rd.layer →
      IRel_D3 (sd.r + 1) (some sd.r) (.node (F.cols.drop (rd.idx + 1))) ∧
      routeHost_D3 (sd.r + 1) (some sd.r) (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) =
        hostSd ∧ ∀ a, hostSd = some a → sd.r ≤ a) ∧
    (rd.owner = true → ∀ x, U.getLast? = some x →
      routeHost_D3 (sd.r + 1) (some sd.r) (sd.depth - rd.layer - 1) x.2 = hostSd ∧
      ∀ a, hostSd = some a → sd.r ≤ a) := by
  intro hostSd F U
  have hA : IRel_D3 0 none A := (condI_iff_irel_D3 A).1 hL.2.1
  obtain ⟨-, -, -, -, h5, -⟩ := stopData_core hsd
  obtain ⟨hRA, -⟩ := stop_route_top_D3 hsd
  obtain ⟨hle, hfa, hr, hidx, howner, hcol⟩ := root_facts_D3 hsd hrd
  obtain ⟨-, -, hidx', hnum, -, -, -, -⟩ := rootData_spec hsd hrd
  obtain ⟨-, -, -, hpre, -⟩ := rootData_path hsd hrd
  have hF : F = skipLayers A rd.layer := by simp [F, hfa]
  have hRj : RouteOK_D3 rd.layer A := routeOK_le_D3 _ _ _ hRA hle
  have hIj := irel_skip_D3 rd.layer 0 none A hRj hA
  rw [Nat.zero_add, irel_eq_icols_D3] at hIj
  have hsplit : hostSd = routeHost_D3 (leftCount A rd.layer) (routeHost_D3 0 none rd.layer A)
      (sd.depth - rd.layer) (skipLayers A rd.layer) := by
    have := routeHost_split_D3 rd.layer (sd.depth - rd.layer) 0 none A
    rw [Nat.add_sub_cancel' hle, Nat.zero_add] at this
    exact this
  obtain ⟨hRs, -⟩ := stop_route_D3 hsd (sd.depth - rd.layer) (by omega)
  rw [show sd.depth - (sd.depth - rd.layer) = rd.layer by omega] at hRs
  rw [hF]
  refine ⟨?_, ?_, ?_⟩
  · intro hown hd0
    rw [hd0] at hsplit
    simp only [routeHost_D3] at hsplit
    refine ⟨?_, ?_⟩
    · rw [irel_iff_icols_D3, hsplit]
      have := icols_drop_D3 hIj (rd.idx + 1)
      rwa [show leftCount A rd.layer + (rd.idx + 1) = sd.r + 1 by omega] at this
    · intro a ha
      rw [hsplit] at ha
      rcases routeHost_bound_D3 _ _ _ _ a hRj ha with h | ⟨-, h⟩
      · cases h
      · omega
  · intro hown hd1
    obtain ⟨i, hi⟩ : ∃ i, sd.depth - rd.layer = i + 1 := ⟨_, (Nat.succ_pred_eq_of_ne_zero (by omega)).symm⟩
    rw [hi] at hRs hsplit ⊢
    obtain ⟨cs, es, p, h, hG, hR'⟩ := hRs
    have hlen : (skipLayers A rd.layer).cols.length = cs.length + 1 := by rw [hG]; simp [Tree.cols]
    have hlt : rd.idx + 1 < (skipLayers A rd.layer).cols.length := by
      have : ¬ rd.idx + 1 = (skipLayers A rd.layer).cols.length := by
        rw [← howner, hown]; simp
      omega
    have hdrop : (skipLayers A rd.layer).cols.drop (rd.idx + 1) =
        cs.drop (rd.idx + 1) ++ [es ++ [(p, h)]] := by
      rw [hG]; exact List.drop_append_of_le_length (by omega)
    have hsum : (rd.col.path.map (·.1 + 1)).sum = leftCount A rd.layer := by
      have : rd.col.num 0 = (rd.col.path.map (·.1 + 1)).sum + rd.col.col := by simp [ColAddr.num]
      omega
    refine ⟨?_, ?_, ?_⟩
    · rw [irel_iff_icols_D3]
      intro z col hz
      have hz' : (skipLayers A rd.layer).cols[rd.idx + 1 + z]? = some col := by
        rw [← List.getElem?_drop]; exact hz
      have hzlt : rd.idx + 1 + z < (skipLayers A rd.layer).cols.length :=
        (List.getElem?_eq_some_iff.1 hz').1
      refine ⟨?_, ?_⟩
      · -- the body column's first parent is at least `r` (T3.2j)
        have hres : sd.col.resolve 0 (sd.r + 1 + z) = some ⟨rd.col.path, rd.idx + 1 + z⟩ := by
          rw [ColAddr.resolve_spec]
          refine ⟨Or.inl ?_, ?_⟩
          · obtain ⟨col', p', hc', -, -, hpk⟩ := h5 rd.layer (by omega)
            refine ⟨rd.layer, _, _, hpk, ?_, ?_⟩
            · obtain ⟨t, ht⟩ := hpre
              obtain ⟨-, hlay, -⟩ := rootData_spec hsd hrd
              show rd.col.path = sd.col.path.take rd.layer
              rw [hlay, ← ht]; simp
            · simp only; omega
          · simp only [ColAddr.num]; omega
        have htt : sd.t = sd.col.num 0 := (stopData_spec hsd).2.2.1
        obtain ⟨q, H, rest, hc, hq⟩ := body_firstParent hL hk hsd (x := sd.r + 1 + z) (by omega)
          (by rw [htt]; exact ColAddr.resolve_lt hres) hres
        have : A.colAt ⟨rd.col.path, rd.idx + 1 + z⟩ = some col := by
          simp only [Tree.colAt, hfa, Option.bind_some]; exact hz'
        rw [this] at hc; cases hc
        intro a ha; cases ha
        exact ⟨q, H, rest, rfl, hq⟩
      · intro x hx
        have := (hIj _ _ hz').2 x hx
        rwa [show leftCount A rd.layer + (rd.idx + 1 + z) = sd.r + 1 + z by omega] at this
    · rw [hsplit, hdrop, hG]
      simp only [routeHost_D3, nextLayer_snoc_D3, Tree.cols, List.length_append,
        List.length_singleton]
      have e1 : sd.r + 1 + ((cs.drop (rd.idx + 1)).length + 1) = leftCount A rd.layer + (cs.length + 1) := by
        rw [List.length_drop]; omega
      have e2 : sd.r + 1 + ((cs.drop (rd.idx + 1)).length + 1 - 1) =
          leftCount A rd.layer + (cs.length + 1 - 1) := by
        rw [List.length_drop]; omega
      rw [e1, e2]
    · intro a ha
      rw [hsplit, hG] at ha
      simp only [routeHost_D3, nextLayer_snoc_D3, Tree.cols, List.length_append,
        List.length_singleton] at ha
      rcases routeHost_bound_D3 _ _ _ _ a hR' ha with h' | ⟨h', -⟩
      · simp at h'; omega
      · omega
  · intro hown x hx
    have hlt := rootData_layer_lt hsd hrd hown
    obtain ⟨i, hi⟩ : ∃ i, sd.depth - rd.layer = i + 1 := ⟨_, (Nat.succ_pred_eq_of_ne_zero (by omega)).symm⟩
    rw [hi] at hRs hsplit
    obtain ⟨cs, es, p, h, hG, hR'⟩ := hRs
    have hidx2 := howner.1 hown
    rw [hG] at hidx2 hcol
    simp only [Tree.cols, List.length_append, List.length_singleton] at hidx2
    have hcol' : A.colAt rd.col = some (es ++ [(p, h)]) := by
      rw [hcol]; simp [Tree.cols, show rd.idx = cs.length by omega]
    have hx' : x = (p, h) := by
      simp only [U, hcol', Option.getD_some, List.getLast?_drop] at hx
      split at hx
      · cases hx
      · simp at hx; exact hx.symm
    subst hx'
    rw [show sd.depth - rd.layer - 1 = i by omega]
    rw [hsplit, hG]
    simp only [routeHost_D3, nextLayer_snoc_D3, Tree.cols, List.length_append,
      List.length_singleton]
    refine ⟨?_, ?_⟩
    · congr 1
      · omega
      · congr 1; omega
    · intro a ha
      rcases routeHost_bound_D3 _ _ _ _ a hR' ha with h' | ⟨h', -⟩
      · simp at h'; omega
      · omega

-- T3.2k (txt:340-344): ordinary outputs satisfy V and I
theorem condV_ord {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .ordinary)
    (hB : expand A n = some B) : CondV B := by
  obtain ⟨sd, rd, hsd, hrd, rfl, -⟩ := ord_output_D3 hL hk hB
  obtain ⟨hrt, hQ, hU, hbody, howner⟩ := ord_vdata_D3 hL.1 hsd hrd
  obtain ⟨hR, hN⟩ := stop_route_top_D3 hsd
  rw [condV_iff_vrel_D3]
  refine vrel_put_D3 _ _ _ _ hR ((condV_iff_vrel_D3 A).1 hL.1) ?_
  rw [hN, Nat.zero_add]
  have := ordLoop_induct_D3 (step := ordStep sd rd ((A.forestAt rd.col.path).getD Tree.empty)
      (((A.colAt rd.col).getD []).drop rd.cursor))
    (P := fun k Z => VRel_D3 (sd.t + k * (sd.t - sd.r)) Z) ?_ n Tree.empty (vrel_empty_D3 _)
  · simpa [ordZ] using this
  · intro k Z hk1 hZ
    have := vrel_ordStep_D3 hk1 hrt hQ hU hbody howner hZ
    have e : sd.t + (k - 1) * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) := by
      obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
      simp only [Nat.add_sub_cancel, Nat.succ_mul]; omega
    show VRel_D3 (sd.t + (k - 1) * (sd.t - sd.r)) _
    rw [e]; exact this
theorem condI_ord {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .ordinary)
    (hB : expand A n = some B) : CondI B := by
  obtain ⟨sd, rd, hsd, hrd, rfl, -⟩ := ord_output_D3 hL hk hB
  obtain ⟨hrt, -, -, hbodyR, hownerR⟩ := ord_vdata_D3 hL.1 hsd hrd
  obtain ⟨hlt, hQ1, hQ2, hU2⟩ := ord_idata1_D3 hL.2.1 hsd hrd
  have hQnil := ord_idata2_D3 hL hk hsd hrd
  obtain ⟨hbody0, hbody1, howner⟩ := ord_idata3_D3 hL hk hsd hrd
  obtain ⟨hR, hN⟩ := stop_route_top_D3 hsd
  rw [condI_iff_irel_D3]
  refine irel_put_D3 _ _ _ _ _ hR ((condI_iff_irel_D3 A).1 hL.2.1) ?_
  rw [hN, Nat.zero_add]
  have := ordLoop_induct_D3 (step := ordStep sd rd ((A.forestAt rd.col.path).getD Tree.empty)
      (((A.colAt rd.col).getD []).drop rd.cursor))
    (P := fun k Z => IRel_D3 (sd.t + k * (sd.t - sd.r))
      ((routeHost_D3 0 none sd.depth A).map (shiftVal sd.r (k * (sd.t - sd.r)))) Z) ?_ n Tree.empty
    (irel_empty_D3 _ _)
  · simp only [Nat.zero_mul, Nat.add_zero, shiftVal_zero_fun, Option.map_id] at this
    simpa [ordZ] using this
  · intro k Z hk1 hZ
    have := irel_ordStep_D3 hk1 hrt hlt hQ1 hQ2 hU2 hQnil
      (fun h => ⟨(hbodyR h).1, (hbodyR h).2.2⟩) hbody0 hbody1 hownerR howner hZ
    have e : sd.t + (k - 1) * (sd.t - sd.r) = sd.r + k * (sd.t - sd.r) := by
      obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
      simp only [Nat.add_sub_cancel, Nat.succ_mul]; omega
    show IRel_D3 (sd.t + (k - 1) * (sd.t - sd.r)) _ _
    rw [e]; exact this

/-! ### Relative condition H -/

/-- The entries of a column are nonincreasing. -/
def ColH_D3 (col : Column) : Prop := List.IsChain (fun x y => EntryLe y x) col

def HRel_D3 (F : Forest) : Prop := ∀ c col, F.colAt c = some col → ColH_D3 col

def HCols_D3 (cols : List Column) : Prop :=
  ∀ (j : Nat) (col : Column), cols[j]? = some col → ColH_D3 col ∧ ∀ x ∈ col, HRel_D3 x.2

theorem hrel_iff_hcols_D3 (cols : List Column) : HRel_D3 (.node cols) ↔ HCols_D3 cols := by
  constructor
  · intro hH j col hj
    refine ⟨hH ⟨[], j⟩ col hj, ?_⟩
    intro x hx c col' hc
    obtain ⟨m, hm⟩ := List.getElem?_of_mem hx
    obtain ⟨P, k⟩ := c
    exact hH ⟨(j, m) :: P, k⟩ col' (by rw [Tree.colAt_cons]; simp [Tree.cols, hj, hm, hc])
  · intro hH c col hc
    obtain ⟨P, k⟩ := c
    cases P with
    | nil => exact (hH k col hc).1
    | cons ab P =>
      obtain ⟨j, m⟩ := ab
      rw [Tree.colAt_cons] at hc
      cases hcj : (Tree.node cols).cols[j]? with
      | none => simp [hcj] at hc
      | some cj =>
        cases hm : cj[m]? with
        | none => simp [hcj, hm] at hc
        | some x =>
          simp only [hcj, hm, Option.bind_some] at hc
          exact (hH j cj hcj).2 x (List.mem_of_getElem? hm) _ col hc

theorem hrel_eq_hcols_D3 (F : Forest) : HRel_D3 F ↔ HCols_D3 F.cols := by
  obtain ⟨cols⟩ := F; exact hrel_iff_hcols_D3 cols

theorem condH_iff_hrel_D3 (E : Forest) : CondH E ↔ HRel_D3 E := by
  constructor
  · intro hH c col hc
    have hmem : c ∈ E.colAddrs := (Tree.mem_colAddrs_iff E c).2 (by rw [hc]; rfl)
    rw [ColH_D3, List.isChain_iff_getElem]
    intro i hi
    exact hH c hmem i _ _ (by rw [hc]; simp [List.getElem?_eq_getElem (show i < col.length by omega)])
      (by rw [hc]; simp [List.getElem?_eq_getElem hi])
  · intro hH c hc i x y hx hy
    obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff E c).1 hc)
    rw [hcol, Option.getD_some] at hx hy
    have := hH c col hcol
    rw [ColH_D3, List.isChain_iff_getElem] at this
    obtain ⟨hi, rfl⟩ := List.getElem?_eq_some_iff.1 hy
    obtain ⟨hi', rfl⟩ := List.getElem?_eq_some_iff.1 hx
    exact this i hi

theorem hcols_nil_D3 : HCols_D3 [] := by intro j col hj; simp at hj

theorem hcols_cons_D3 (c : Column) (cs : List Column) :
    HCols_D3 (c :: cs) ↔ (ColH_D3 c ∧ ∀ x ∈ c, HRel_D3 x.2) ∧ HCols_D3 cs := by
  constructor
  · intro h
    exact ⟨h 0 c rfl, fun j col hj => h (j + 1) col (by simpa using hj)⟩
  · rintro ⟨h1, h2⟩ j col hj
    cases j with
    | zero => simp at hj; subst hj; exact h1
    | succ j => exact h2 j col (by simpa using hj)

theorem hcols_append_D3 (cs ds : List Column) :
    HCols_D3 (cs ++ ds) ↔ HCols_D3 cs ∧ HCols_D3 ds := by
  induction cs with
  | nil => simp [hcols_nil_D3]
  | cons c cs ih => rw [List.cons_append, hcols_cons_D3, hcols_cons_D3, ih]; simp only [and_assoc]

theorem hcols_single_D3 (c : Column) : HCols_D3 [c] ↔ ColH_D3 c ∧ ∀ x ∈ c, HRel_D3 x.2 := by
  rw [hcols_cons_D3]; simp [hcols_nil_D3]

theorem hcols_drop_D3 {cols : List Column} (h : HCols_D3 cols) (k : Nat) : HCols_D3 (cols.drop k) := by
  intro j col hj
  rw [List.getElem?_drop] at hj
  exact h (k + j) col hj

theorem hrel_empty_D3 : HRel_D3 Tree.empty := by
  rw [show (Tree.empty : Forest) = .node [] from rfl, hrel_iff_hcols_D3]; exact hcols_nil_D3

theorem hrel_colAt_D3 {F : Forest} (hF : HRel_D3 F) {c : ColAddr} {col : Column}
    (hc : F.colAt c = some col) : ColH_D3 col ∧ ∀ x ∈ col, HRel_D3 x.2 := by
  refine ⟨hF c col hc, ?_⟩
  intro x hx c' col' hc'
  obtain ⟨m, hm⟩ := List.getElem?_of_mem hx
  obtain ⟨P, k⟩ := c'
  have hG : F.forestAt c.path = some (.node ((F.forestAt c.path).getD Tree.empty).cols) := by
    cases hf : F.forestAt c.path with
    | none => simp [Tree.colAt, hf] at hc
    | some G => obtain ⟨gc⟩ := G; rfl
  have hcol : ((F.forestAt c.path).getD Tree.empty).cols[c.col]? = some col := by
    simp only [Tree.colAt] at hc
    cases hf : F.forestAt c.path with
    | none => simp [hf] at hc
    | some G => simp only [hf, Option.bind_some] at hc; simpa using hc
  have hf : F.forestAt (c.path ++ (c.col, m) :: P) = x.2.forestAt P := by
    rw [Tree.forestAt_append, hG]
    simp only [Option.bind_some]
    rw [Tree.forestAt_cons]
    have e : (Tree.node ((F.forestAt c.path).getD Tree.empty).cols).cols =
      ((F.forestAt c.path).getD Tree.empty).cols := rfl
    rw [e, hcol]; simp [hm]
  exact hF ⟨c.path ++ (c.col, m) :: P, k⟩ col' (by simp only [Tree.colAt]; rw [hf]; exact hc')

theorem hrel_forestAt_D3 {F : Forest} (hF : HRel_D3 F) {π : List (Nat × Nat)} {G : Forest}
    (hG : F.forestAt π = some G) : HRel_D3 G := by
  intro c col hc
  apply hF ⟨π ++ c.path, c.col⟩ col
  simp only [Tree.colAt, Tree.forestAt_append, hG, Option.bind_some]
  exact hc

/-! Shifts are order embeddings of forests. -/

theorem compare_shiftVal_D3 (r d x y : Nat) :
    compare (shiftVal r d x) (shiftVal r d y) = compare x y := by
  rcases lt_trichotomy x y with h | rfl | h
  · rw [compare_lt_iff_lt.2 h, compare_lt_iff_lt.2 (shiftVal_strictMono_D3 r d h)]
  · simp
  · rw [compare_gt_iff_gt.2 h, compare_gt_iff_gt.2 (shiftVal_strictMono_D3 r d h)]

theorem cmp_shift_D3 (r d : Nat) (X Y : Forest) :
    Tree.cmp compare (shift r d X) (shift r d Y) = Tree.cmp compare X Y :=
  Tree.cmp_map (compare_shiftVal_D3 r d) X Y

theorem shift_le_shift_D3 (r d : Nat) {X Y : Forest} (h : X ≤ Y) : shift r d X ≤ shift r d Y := by
  show Tree.cmp compare _ _ ≠ .gt
  rw [cmp_shift_D3]; exact h

theorem entryLe_shift_D3 (r d : Nat) {x y : Nat × Forest} (h : EntryLe y x) :
    EntryLe (shiftVal r d y.1, shift r d y.2) (shiftVal r d x.1, shift r d x.2) := by
  rcases h with h | ⟨h1, h2⟩
  · exact Or.inl (shiftVal_strictMono_D3 r d h)
  · exact Or.inr ⟨by rw [h1], shift_le_shift_D3 r d h2⟩

theorem colH_shift_D3 {col : Column} (h : ColH_D3 col) (r d : Nat) :
    ColH_D3 (Tree.mapCol (shiftVal r d) col) := by
  rw [ColH_D3, treeMapCol_eq_map, List.isChain_map]
  exact h.imp (fun a b hab => entryLe_shift_D3 r d hab)

theorem colH_shiftH_D3 {col : Column} (h : ColH_D3 col) (r d : Nat) :
    ColH_D3 (col.map fun x => (x.1, shift r d x.2)) := by
  rw [ColH_D3, List.isChain_map]
  refine h.imp (fun a b hab => ?_)
  rcases hab with h | ⟨h1, h2⟩
  · exact Or.inl h
  · exact Or.inr ⟨h1, shift_le_shift_D3 r d h2⟩

theorem hrel_shift_D3 {F : Forest} (h : HRel_D3 F) (r d : Nat) : HRel_D3 (shift r d F) := by
  intro c col hc
  rw [shift, colAt_map_D3] at hc
  cases h' : F.colAt c with
  | none => simp [h'] at hc
  | some col0 =>
    simp only [h', Option.map_some, Option.some.injEq] at hc
    subst hc
    exact colH_shift_D3 (h c col0 h') r d

/-! Route replacement and the order. -/

/-- The route column at depth `k`. -/
def routeCol_D3 (k : Nat) (F : Forest) : Column := ((skipLayers F k).cols.getLast?).getD []

theorem cmpCol_self_D3 (x : Column) : Tree.cmpCol (compare : Nat → Nat → Ordering) x x = .eq := by
  have : Tree.cmp (compare : Nat → Nat → Ordering) (Tree.node [x]) (Tree.node [x]) = .eq :=
    Std.ReflCmp.compare_self
  simp only [Tree.cmp, Tree.cmpCols] at this
  cases h : Tree.cmpCol compare x x <;> simp_all [Ordering.then]

theorem cmpCols_append_left_D3 (P a b : List Column) :
    Tree.cmpCols (compare : Nat → Nat → Ordering) (P ++ a) (P ++ b) = Tree.cmpCols compare a b := by
  induction P with
  | nil => rfl
  | cons x P ih => simp only [List.cons_append, Tree.cmpCols, cmpCol_self_D3, ih, Ordering.then]

theorem cmpCol_append_left_D3 (P a b : Column) :
    Tree.cmpCol (compare : Nat → Nat → Ordering) (P ++ a) (P ++ b) = Tree.cmpCol compare a b := by
  induction P with
  | nil => rfl
  | cons x P ih =>
    obtain ⟨p, h⟩ := x
    simp only [List.cons_append, Tree.cmpCol, ih]
    have : Tree.cmp (compare : Nat → Nat → Ordering) h h = .eq := Std.ReflCmp.compare_self
    simp [this, Ordering.then]

theorem cmp_put_D3 (Z Z' : Forest) : ∀ (k : Nat) (F : Forest), RouteOK_D3 k F →
    Tree.cmp compare (replaceAt 0 0 Z k F) (replaceAt 0 0 Z' k F) = Tree.cmp compare Z Z'
  | 0, .node cols, hR => by
    have hc : cols ≠ [] := hR
    rw [put_zero_D3 Z hc, put_zero_D3 Z' hc]
    obtain ⟨zc⟩ := Z; obtain ⟨zc'⟩ := Z'
    simp only [Tree.cmp, Tree.cols]
    exact cmpCols_append_left_D3 _ _ _
  | k + 1, F, hR => by
    obtain ⟨cs, es, q, H, rfl, hR'⟩ := hR
    rw [put_succ_D3, put_succ_D3]
    simp only [Tree.cmp]
    rw [cmpCols_append_left_D3]
    simp only [Tree.cmpCols, cmpCol_append_left_D3, Tree.cmpCol, cmp_put_D3 Z Z' k H hR']
    rw [show compare q q = Ordering.eq from compare_eq_iff_eq.2 rfl]
    cases Tree.cmp compare Z Z' <;> rfl

theorem put_self_D3 : ∀ (k : Nat) (F : Forest), RouteOK_D3 k F →
    replaceAt 0 0 (.node [routeCol_D3 k F]) k F = F
  | 0, .node cols, hR => by
    have hc : cols ≠ [] := hR
    rw [put_zero_D3 _ hc]
    simp only [routeCol_D3, skipLayers, Tree.cols]
    obtain ⟨l, hl⟩ : ∃ l, cols.getLast? = some l := by
      cases h : cols.getLast? with
      | none => simp at h; exact absurd h hc
      | some l => exact ⟨l, rfl⟩
    rw [hl, Option.getD_some]
    obtain ⟨ys, rfl⟩ := List.getLast?_eq_some_iff.1 hl
    simp
  | k + 1, F, hR => by
    obtain ⟨cs, es, q, H, rfl, hR'⟩ := hR
    rw [put_succ_D3]
    have : routeCol_D3 (k + 1) (.node (cs ++ [es ++ [(q, H)]])) = routeCol_D3 k H := by
      simp only [routeCol_D3, skipLayers, nextLayer_snoc_D3]
    rw [this, put_self_D3 k H hR']

theorem put_le_D3 {Z : Forest} {k : Nat} {F : Forest} (hR : RouteOK_D3 k F)
    (hZ : Z ≤ .node [routeCol_D3 k F]) : replaceAt 0 0 Z k F ≤ F := by
  have h1 := cmp_put_D3 Z (.node [routeCol_D3 k F]) k F hR
  rw [put_self_D3 k F hR] at h1
  show Tree.cmp compare _ _ ≠ .gt
  rw [h1]; exact hZ

theorem put_lt_D3 {Z : Forest} {k : Nat} {F : Forest} (hR : RouteOK_D3 k F)
    (hZ : Z < .node [routeCol_D3 k F]) : replaceAt 0 0 Z k F < F := by
  have h1 := cmp_put_D3 Z (.node [routeCol_D3 k F]) k F hR
  rw [put_self_D3 k F hR] at h1
  show Tree.cmp compare _ _ = .lt
  rw [h1]; exact hZ

theorem colH_snoc_D3 {l : Column} {a : Nat × Forest} :
    ColH_D3 (l ++ [a]) ↔ ColH_D3 l ∧ ∀ x ∈ l.getLast?, EntryLe a x := by
  rw [ColH_D3, List.isChain_append]
  simp [ColH_D3]

theorem entryLe_trans_le_D3 {x y : Nat × Forest} {h' : Forest} (h : EntryLe y x)
    (hh : h' ≤ y.2) : EntryLe (y.1, h') x := by
  rcases h with h | ⟨h1, h2⟩
  · exact Or.inl h
  · exact Or.inr ⟨h1, le_trans hh h2⟩

theorem hrel_put_D3 (Z : Forest) : ∀ (k : Nat) (F : Forest), RouteOK_D3 k F → HRel_D3 F →
    HRel_D3 Z → Z ≤ .node [routeCol_D3 k F] → HRel_D3 (replaceAt 0 0 Z k F)
  | 0, .node cols, hR, hF, hZ, _ => by
    have hc : cols ≠ [] := hR
    rw [put_zero_D3 Z hc]
    obtain ⟨zc⟩ := Z
    simp only [Tree.cols]
    rw [hrel_iff_hcols_D3] at hF hZ ⊢
    rw [hcols_append_D3]
    refine ⟨?_, hZ⟩
    rw [← List.dropLast_append_getLast hc, hcols_append_D3] at hF
    exact hF.1
  | k + 1, F, hR, hF, hZ, hle => by
    obtain ⟨cs, es, q, H, rfl, hR'⟩ := hR
    have hle' : Z ≤ .node [routeCol_D3 k H] := by
      simpa [routeCol_D3, skipLayers, nextLayer_snoc_D3] using hle
    rw [put_succ_D3]
    rw [hrel_iff_hcols_D3, hcols_append_D3, hcols_single_D3] at hF ⊢
    obtain ⟨hF1, hF2, hF3⟩ := hF
    refine ⟨hF1, ?_, ?_⟩
    · rw [colH_snoc_D3] at hF2 ⊢
      refine ⟨hF2.1, fun x hx => ?_⟩
      exact entryLe_trans_le_D3 (hF2.2 x hx) (put_le_D3 hR' hle')
    · intro x hx
      rw [List.mem_append, List.mem_singleton] at hx
      rcases hx with hx | rfl
      · exact hF3 x (List.mem_append_left _ hx)
      · exact hrel_put_D3 Z k H hR' (hF3 (q, H) (by simp)) hZ hle'


theorem routeCol_shift_D3 (r d : Nat) : ∀ (k : Nat) (F : Forest),
    routeCol_D3 k (shift r d F) = Tree.mapCol (shiftVal r d) (routeCol_D3 k F)
  | 0, .node cols => by
    simp only [routeCol_D3, skipLayers, shift, Tree.map, Tree.cols, treeMapCols_eq_map,
      List.getLast?_map]
    cases cols.getLast? <;> rfl
  | k + 1, F => by
    simp only [routeCol_D3, skipLayers]
    rw [show nextLayer (shift r d F) = shift r d (nextLayer F) from nextLayer_map_D3 _ _]
    exact routeCol_shift_D3 r d k (nextLayer F)

/-- A head column `Q' ⌢ V` whose continuation starts below the closing parent `ρ` is smaller
than the stopping column `Q' ⌢ [(ρ, ∅)]`. -/
theorem head_lt_D3 {Q' V : Column} {rest : List Column} {ρ : Nat}
    (hV : ∀ v ∈ V.head?, v.1 < ρ) :
    (Tree.node ((Q' ++ V) :: rest) : Forest) < .node [Q' ++ [(ρ, Tree.empty)]] := by
  show Tree.cmp compare _ _ = .lt
  simp only [Tree.cmp, Tree.cmpCols, cmpCol_append_left_D3]
  cases V with
  | nil => rfl
  | cons v vs =>
    have : compare v.1 ρ = .lt := compare_lt_iff_lt.2 (hV v (by simp))
    obtain ⟨p, h⟩ := v
    simp only [Tree.cmpCol] at this ⊢
    rw [this]; rfl

/-- Step `k` of the ordinary loop keeps relative H, and its output lies below the stopping column
of the previous phase. -/
theorem hrel_ordStep_D3 {sd : StopData} {rd : RootData} {F : Forest} {U : Column} {k : Nat}
    {Z : Forest}
    (hQ : ColH_D3 (sd.Q ++ [(sd.r, Tree.empty)])) (hQh : ∀ x ∈ sd.Q, HRel_D3 x.2)
    (hU : ColH_D3 U) (hUh : ∀ x ∈ U, HRel_D3 x.2) (hUr : ∀ x ∈ U, x.1 < sd.r)
    (hbody : rd.owner = false →
      RouteOK_D3 (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) ∧
      HRel_D3 (.node (F.cols.drop (rd.idx + 1))) ∧
      routeCol_D3 (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) = sd.Q ++ [(sd.r, Tree.empty)])
    (howner : rd.owner = true → ∀ x, U.getLast? = some x →
      RouteOK_D3 (sd.depth - rd.layer - 1) x.2 ∧
      routeCol_D3 (sd.depth - rd.layer - 1) x.2 = sd.Q ++ [(sd.r, Tree.empty)])
    (hZ : HRel_D3 Z)
    (hZle : Z ≤ .node [Tree.mapCol (shiftVal sd.r (k * (sd.t - sd.r))) (sd.Q ++ [(sd.r, Tree.empty)])]) :
    HRel_D3 (ordStep sd rd F U k Z) ∧
      ordStep sd rd F U k Z <
        .node [Tree.mapCol (shiftVal sd.r ((k - 1) * (sd.t - sd.r))) (sd.Q ++ [(sd.r, Tree.empty)])] := by
  set δ := (k - 1) * (sd.t - sd.r) with hδ
  set Q' := Tree.mapCol (shiftVal sd.r δ) sd.Q with hQ'
  have hmapQ : Tree.mapCol (shiftVal sd.r δ) (sd.Q ++ [(sd.r, Tree.empty)]) =
      Q' ++ [(shiftVal sd.r δ sd.r, Tree.empty)] := by
    simp [hQ', treeMapCol_eq_map, Tree.map, Tree.mapCols, Tree.empty]
  rw [colH_snoc_D3] at hQ
  have hQ'c : ColH_D3 Q' := colH_shift_D3 hQ.1 _ _
  have hQr : ∀ x ∈ Q'.getLast?, sd.r ≤ x.1 := by
    intro x hx
    rw [hQ', treeMapCol_eq_map, List.getLast?_map] at hx
    cases hl : sd.Q.getLast? with
    | none => rw [hl] at hx; cases hx
    | some q =>
      rw [hl] at hx; simp only [Option.map_some, Option.mem_def, Option.some.injEq] at hx
      subst hx
      have := hQ.2 q hl
      have h2 := le_shiftVal_D3 sd.r δ q.1
      simp only
      rcases this with h | ⟨h, -⟩ <;> omega
  have hQ'h : ∀ x ∈ Q', HRel_D3 x.2 := by
    intro x hx
    rw [hQ', treeMapCol_eq_map] at hx
    obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx
    exact hrel_shift_D3 (hQh y hy) _ _
  -- the head: `Q'` followed by a continuation `V` with the parents of `U`
  have hhead : ∀ V : Column, ColH_D3 V → (∀ v ∈ V.head?, v.1 < sd.r) →
      ColH_D3 (Q' ++ V) := by
    intro V hV hVr
    rw [ColH_D3, List.isChain_append]
    refine ⟨hQ'c, hV, fun x hx y hy => Or.inl ?_⟩
    have := hQr x hx; have := hVr y hy; omega
  have hρ : sd.r ≤ shiftVal sd.r δ sd.r := le_shiftVal_D3 _ _ _
  unfold ordStep
  simp only
  rw [← hδ, ← hQ', hmapQ]
  split
  · rename_i hown
    have hcols : ColH_D3 (U.dropLast.map (fun x => (x.1, shift sd.r (k * (sd.t - sd.r)) x.2)) ++
        (U.getLast?.map fun x => (x.1, Hole.fill ⟨x.2, sd.depth - rd.layer - 1⟩ sd.r
          (k * (sd.t - sd.r)) Z)).toList) := by
      cases hl : U.getLast? with
      | none =>
        have : U = [] := by simpa using hl
        subst this; simp [ColH_D3]
      | some u =>
        obtain ⟨R, rfl⟩ := List.getLast?_eq_some_iff.1 hl
        simp only [List.dropLast_concat, Option.map_some, Option.toList_some]
        rw [colH_snoc_D3] at hU ⊢
        refine ⟨colH_shiftH_D3 hU.1 _ _, fun x hx => ?_⟩
        rw [List.getLast?_map] at hx
        cases hR : R.getLast? with
        | none => rw [hR] at hx; cases hx
        | some w =>
          rw [hR] at hx; simp only [Option.map_some, Option.mem_def, Option.some.injEq] at hx
          subst hx
          obtain ⟨hRo, hRc⟩ := howner hown u (by simp)
          have hle : Hole.fill ⟨u.2, sd.depth - rd.layer - 1⟩ sd.r (k * (sd.t - sd.r)) Z ≤
              shift sd.r (k * (sd.t - sd.r)) u.2 := by
            rw [Hole.fill_eq_put]
            refine put_le_D3 ((routeOK_shift_D3 _ _ _ _).2 hRo) ?_
            rw [routeCol_shift_D3, hRc]; exact hZle
          rcases hU.2 w hR with h | ⟨h1, h2⟩
          · exact Or.inl h
          · exact Or.inr ⟨h1, le_trans hle (shift_le_shift_D3 _ _ h2)⟩
    have hVr : ∀ v ∈ (U.dropLast.map (fun x => (x.1, shift sd.r (k * (sd.t - sd.r)) x.2)) ++
        (U.getLast?.map fun x => (x.1, Hole.fill ⟨x.2, sd.depth - rd.layer - 1⟩ sd.r
          (k * (sd.t - sd.r)) Z)).toList).head?, v.1 < sd.r := by
      intro v hv
      have e := mapLast_eq (fun x : Nat × Forest => (x.1, shift sd.r (k * (sd.t - sd.r)) x.2))
        (fun x : Nat × Forest => (x.1, Hole.fill ⟨x.2, sd.depth - rd.layer - 1⟩ sd.r
          (k * (sd.t - sd.r)) Z)) U
      rw [← e] at hv
      cases hU0 : U.head? with
      | none =>
        cases U with
        | nil => simp [mapLast] at hv
        | cons _ _ => simp at hU0
      | some u0 =>
        obtain ⟨y, hy, hyu⟩ := head_mapLast_fst_D3
          (fun x : Nat × Forest => (x.1, shift sd.r (k * (sd.t - sd.r)) x.2))
          (fun x : Nat × Forest => (x.1, Hole.fill ⟨x.2, sd.depth - rd.layer - 1⟩ sd.r
            (k * (sd.t - sd.r)) Z)) (fun _ => rfl) (fun _ => rfl) u0 hU0
        rw [hy] at hv; cases hv
        rw [hyu]; exact hUr u0 (List.mem_of_head? hU0)
    refine ⟨?_, ?_⟩
    · rw [hrel_iff_hcols_D3, hcols_single_D3, List.append_assoc]
      refine ⟨hhead _ hcols hVr, fun x hx => ?_⟩
      rw [List.mem_append, List.mem_append] at hx
      rcases hx with hx | hx | hx
      · exact hQ'h x hx
      · obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx
        exact hrel_shift_D3 (hUh y (List.mem_of_mem_dropLast hy)) _ _
      · cases hl : U.getLast? with
        | none => simp [hl] at hx
        | some u =>
          simp only [hl, Option.map_some, Option.toList_some, List.mem_singleton] at hx
          subst hx
          obtain ⟨hRo, hRc⟩ := howner hown u hl
          simp only
          rw [Hole.fill_eq_put]
          refine hrel_put_D3 Z _ _ ((routeOK_shift_D3 _ _ _ _).2 hRo)
            (hrel_shift_D3 (hUh u (List.mem_of_getLast? hl)) _ _) hZ ?_
          rw [routeCol_shift_D3, hRc]; exact hZle
    · rw [List.append_assoc]
      have := head_lt_D3 (Q' := Q') (rest := []) (ρ := shiftVal sd.r δ sd.r) (fun v hv =>
        lt_of_lt_of_le (hVr v hv) hρ)
      exact this
  · rename_i hown
    have hown' : rd.owner = false := by simpa using hown
    obtain ⟨hR, hB, hRc⟩ := hbody hown'
    have hVr : ∀ v ∈ (U.map fun x => (x.1, shift sd.r (k * (sd.t - sd.r)) x.2)).head?, v.1 < sd.r := by
      intro v hv
      cases U with
      | nil => simp at hv
      | cons u us => simp at hv; subst hv; exact hUr u (by simp)
    refine ⟨?_, head_lt_D3 (fun v hv => lt_of_lt_of_le (hVr v hv) hρ)⟩
    rw [hrel_iff_hcols_D3, hcols_cons_D3, ← hrel_eq_hcols_D3]
    refine ⟨⟨hhead _ (colH_shiftH_D3 hU _ _) hVr, fun x hx => ?_⟩, ?_⟩
    · rw [List.mem_append] at hx
      rcases hx with hx | hx
      · exact hQ'h x hx
      · obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx
        exact hrel_shift_D3 (hUh y hy) _ _
    · rw [Hole.fill_eq_put]
      refine hrel_put_D3 Z _ _ ((routeOK_shift_D3 _ _ _ _).2 hR) (hrel_shift_D3 hB _ _) hZ ?_
      rw [routeCol_shift_D3, hRc]; exact hZle


theorem routeCol_skip_D3 (F : Forest) (k : Nat) : routeCol_D3 k F = routeCol_D3 0 (skipLayers F k) := by
  simp [routeCol_D3, skipLayers]

/-- Data of an ordinary step for relative H. -/
theorem ord_hdata_D3 {A : Forest} {sd : StopData} {rd : RootData} (hH : CondH A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) :
    let F := (A.forestAt rd.col.path).getD Tree.empty
    let U := ((A.colAt rd.col).getD []).drop rd.cursor
    ColH_D3 (sd.Q ++ [(sd.r, Tree.empty)]) ∧ (∀ x ∈ sd.Q, HRel_D3 x.2) ∧
    ColH_D3 U ∧ (∀ x ∈ U, HRel_D3 x.2) ∧
    (rd.owner = false → HRel_D3 (.node (F.cols.drop (rd.idx + 1))) ∧
      routeCol_D3 (sd.depth - rd.layer) (.node (F.cols.drop (rd.idx + 1))) =
        sd.Q ++ [(sd.r, Tree.empty)]) ∧
    (rd.owner = true → ∀ x, U.getLast? = some x →
      routeCol_D3 (sd.depth - rd.layer - 1) x.2 = sd.Q ++ [(sd.r, Tree.empty)]) := by
  intro F U
  have hA := (condH_iff_hrel_D3 A).1 hH
  obtain ⟨h1, -, -, h4, -⟩ := stopData_core hsd
  obtain ⟨hcolsd, -⟩ := stopData_spec hsd
  obtain ⟨hle, hfa, hr, hidx, howner, hcol⟩ := root_facts_D3 hsd hrd
  obtain ⟨-, -, -, -, -, hmem, -, -⟩ := rootData_spec hsd hrd
  have hF : F = skipLayers A rd.layer := by simp [F, hfa]
  obtain ⟨hQc, hQh⟩ := hrel_colAt_D3 hA hcolsd
  obtain ⟨R, hR⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff A rd.col).1 hmem)
  obtain ⟨hRc, hRh⟩ := hrel_colAt_D3 hA hR
  have hU : U = R.drop rd.cursor := by simp [U, hR]
  have hlast : ∀ m, rd.layer + m = sd.depth → routeCol_D3 m (skipLayers A rd.layer) =
      sd.Q ++ [(sd.r, Tree.empty)] := by
    intro m hm
    rw [routeCol_skip_D3, skipLayers_add, hm]
    simp [routeCol_D3, skipLayers, h4]
  refine ⟨hQc, fun x hx => hQh x (List.mem_append_left _ hx), ?_, ?_, ?_, ?_⟩
  · rw [hU]; exact hRc.drop _
  · rw [hU]; exact fun x hx => hRh x (List.mem_of_mem_drop hx)
  · intro hown
    rw [hF]
    have hlt : rd.idx + 1 < (skipLayers A rd.layer).cols.length := by
      have : ¬ rd.idx + 1 = (skipLayers A rd.layer).cols.length := by rw [← howner, hown]; simp
      omega
    refine ⟨?_, ?_⟩
    · rw [hrel_iff_hcols_D3]
      exact hcols_drop_D3 ((hrel_eq_hcols_D3 _).1 (hrel_forestAt_D3 hA hfa)) _
    · rcases Nat.eq_zero_or_pos (sd.depth - rd.layer) with h0 | h0
      · rw [h0]
        have := hlast 0 (by omega)
        simp only [routeCol_D3, skipLayers] at this ⊢
        show ((skipLayers A rd.layer).cols.drop (rd.idx + 1)).getLast?.getD [] = _
        rw [List.getLast?_drop, if_neg (by omega)]; exact this
      · obtain ⟨i, hi⟩ : ∃ i, sd.depth - rd.layer = i + 1 := ⟨_, (Nat.succ_pred_eq_of_ne_zero (by omega)).symm⟩
        rw [hi]
        have := hlast (i + 1) (by omega)
        have hnx : nextLayer (.node ((skipLayers A rd.layer).cols.drop (rd.idx + 1))) =
            nextLayer (skipLayers A rd.layer) := by
          have e : (Tree.node ((skipLayers A rd.layer).cols.drop (rd.idx + 1))).cols.getLast? =
              (skipLayers A rd.layer).cols.getLast? := by
            show ((skipLayers A rd.layer).cols.drop (rd.idx + 1)).getLast? = _
            rw [List.getLast?_drop, if_neg (by omega)]
          simp only [nextLayer, lastEntry?, e]
        simp only [routeCol_D3, skipLayers] at this ⊢
        rw [hnx]; exact this
  · intro hown x hx
    have hidx' := howner.1 hown
    rw [hU] at hx
    have hx' : R.getLast? = some x := by
      rw [List.getLast?_drop] at hx; split at hx
      · cases hx
      · exact hx
    have hsome : (skipLayers A rd.layer).cols.getLast? = some R := by
      rw [List.getLast?_eq_getElem?, show (skipLayers A rd.layer).cols.length - 1 = rd.idx by omega,
        ← hcol, hR]
    have hnx := nextLayer_of_last hsome (show R.getLast? = some (x.1, x.2) from hx')
    have := hlast (sd.depth - rd.layer) (by omega)
    rw [routeCol_skip_D3] at this ⊢
    have hlt := rootData_layer_lt hsd hrd hown
    rw [show sd.depth - rd.layer = (sd.depth - rd.layer - 1) + 1 by omega, skipLayers, hnx] at this
    exact this

theorem empty_le_D3 (X : Forest) : (Tree.empty : Forest) ≤ X := by
  show Tree.cmp compare _ _ ≠ .gt
  obtain ⟨xc⟩ := X
  cases xc <;> simp [Tree.empty, Tree.cmp, Tree.cmpCols]

-- T3.2x (txt:345-349): ordinary outputs satisfy H (strict decrease is the spine's `expand_lt`)
theorem condH_ord {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .ordinary)
    (hB : expand A n = some B) : CondH B := by
  obtain ⟨sd, rd, hsd, hrd, rfl, -⟩ := ord_output_D3 hL hk hB
  obtain ⟨hrt, -, hU, hbodyR, hownerR⟩ := ord_vdata_D3 hL.1 hsd hrd
  obtain ⟨hQc, hQh, hUc, hUh, hbody, howner⟩ := ord_hdata_D3 hL.2.2.1 hsd hrd
  obtain ⟨hR, -⟩ := stop_route_top_D3 hsd
  obtain ⟨-, -, -, h4, -⟩ := stopData_core hsd
  have hrc : routeCol_D3 sd.depth A = sd.Q ++ [(sd.r, Tree.empty)] := by
    simp [routeCol_D3, h4]
  rw [condH_iff_hrel_D3]
  have := ordLoop_induct_D3 (step := ordStep sd rd ((A.forestAt rd.col.path).getD Tree.empty)
      (((A.colAt rd.col).getD []).drop rd.cursor))
    (P := fun k Z => HRel_D3 Z ∧
      Z ≤ .node [Tree.mapCol (shiftVal sd.r (k * (sd.t - sd.r))) (sd.Q ++ [(sd.r, Tree.empty)])]) ?_ n
    Tree.empty ⟨hrel_empty_D3, empty_le_D3 _⟩
  · simp only [Nat.zero_mul, shiftVal_zero_fun, treeMapCol_id_fun, id] at this
    refine hrel_put_D3 _ _ _ hR ((condH_iff_hrel_D3 A).1 hL.2.2.1) this.1 ?_
    rw [hrc]; exact this.2
  · intro k Z _ hZ
    have := hrel_ordStep_D3 (F := (A.forestAt rd.col.path).getD Tree.empty) (k := k) hQc hQh hUc hUh
      (fun x hx => (hU x hx).1)
      (fun h => ⟨(hbodyR h).1, (hbody h).1, (hbody h).2⟩)
      (fun h x hx => ⟨(hownerR h x hx).1, howner h x hx⟩) hZ.1 hZ.2
    exact ⟨this.1, le_of_lt this.2⟩

-- T3.2m (txt:350-362): every owner return of an ordinary output has an old origin; the key
-- words of both heights are the phase images of the old ones, changed only by decreases whose
-- first changes respect the containment offset (or the lower height is unchanged and ends
-- before the upper change)
theorem ownerReturn_origin {A B : Forest} {sd : StopData} {rd : RootData} {n : Nat} (hL : InL A)
    (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd) (hrd : rootData A = some rd)
    (hB : expand A n = some B) {e0' e' : EntryAddr} (he0 : e0' ∈ B.entryAddrs)
    (he : e' ∈ B.entryAddrs) (hret : IsOwnerReturn B e0' e') :
    ∃ e0 e j, e0 ∈ A.entryAddrs ∧ e ∈ A.entryAddrs ∧ IsOwnerReturn A e0 e ∧
      let J := (A.heightAt e).getD Tree.empty
      let H := (A.heightAt e0).getD Tree.empty
      let J' := (B.heightAt e').getD Tree.empty
      let H' := (B.heightAt e0').getD Tree.empty
      let kJ := keyWord (kappa sd.r (period sd) j (relKey (e.col.num 0) J))
      let kH := keyWord (kappa sd.r (period sd) j (relKey (e0.col.num 0) H))
      let kJ' := keyWord (relKey (e'.col.num 0) J')
      let kH' := keyWord (relKey (e0'.col.num 0) H')
      (kH' = kH ∨ ∃ b, kH'.take b = kH.take b ∧ b ≤ kH'.length ∧ kH' ≤ kH ∧
        (kJ' = kJ ∧ kJ.length < b ∨ ∃ a, a < b ∧ FirstDec kJ kJ' a)) ∧
      (kH' = kH → kJ' = kJ) := by sorry

/-- T3.2n helper (branch D3): key-word order is key order. -/
theorem keyWord_lt_iff_D3 (K K' : Key) : keyWord K < keyWord K' ↔ K < K' := by
  unfold keyWord
  rw [← gword, ← gword, gword_lt_iff,
    Tree.cmp_map (c := keyLabelCmp) (fun x y => (keyLabelCmp_eq x y).symm)]
  rfl

-- T3.2n (txt:363-366): ordinary outputs satisfy S (no output A is used)
theorem condS_ord {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .ordinary)
    (hB : expand A n = some B) : CondS B := by
  obtain ⟨sd, hsd⟩ := Option.isSome_iff_exists.mp (stopData_of_stepKind hk (by decide))
  obtain ⟨rd, hrd⟩ := Option.isSome_iff_exists.mp (rootData_of_ordinary hk)
  intro e0' he0 e' he hret
  obtain ⟨e0, e, j, he0A, heA, hretA, hpos, heq⟩ :=
    ownerReturn_origin hL hk hsd hrd hB he0 he hret
  have hSA := hL.2.2.2.2 e0 he0A e heA hretA
  have hlt : keyWord (kappa sd.r (period sd) j (relKey (e.col.num 0) ((A.heightAt e).getD Tree.empty))) <
      keyWord (kappa sd.r (period sd) j (relKey (e0.col.num 0) ((A.heightAt e0).getD Tree.empty))) :=
    (keyWord_lt_iff_D3 _ _).2 (kappa_strictMono _ _ _ hSA)
  rw [← keyWord_lt_iff_D3]
  rcases hpos with hH | ⟨b, hb1, hb2, -, hJ | ⟨a, hab, hfd⟩⟩
  · rw [hH, heq hH]; exact hlt
  · rw [hJ.1]
    refine lt_of_take_succ hlt ?_
    have h1 := congrArg (List.take (keyWord (kappa sd.r (period sd) j
      (relKey (e.col.num 0) ((A.heightAt e).getD Tree.empty)))).length.succ) hb1
    rw [List.take_take, List.take_take] at h1
    rwa [min_eq_left (by omega)] at h1
  · exact lt_of_firstDec hlt hfd ⟨hb1, hb2⟩ hab

-- T3.2o (txt:367-376): P is preserved by ordinary steps
theorem condP_ord {A B : Forest} {n : Nat} (hL : InL A) (hP : CondP A)
    (hk : stepKind A = some .ordinary) (hB : expand A n = some B) : CondP B := by sorry

-- T3.2q (txt:390-394, 524-530): read on the stack of a phase-`φ` copy `c` of `a`, a
-- `g_{κ_φ W}` path from a vertex `x ≥ s_φ` to an endpoint `y < r` is the copy of an old `g_W`
-- path from `x − φd` (from `r` when `x = s_φ`): low heads detour through the previous phase,
-- high heads return the old root response at `W` (all root keys are `κ`-fixed)
theorem head_path {A B : Forest} {sd : StopData} {rd : RootData} {n j : Nat} (hL : InL A)
    (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd) (hrd : rootData A = some rd)
    (hB : expand A n = some B) (hj : 1 ≤ j ∧ j ≤ n) {a c : ColAddr}
    (ha : IsTmplCol A sd rd a) (hc : phaseCol sd rd j a = some c)
    {W : List (WithTop Key)} (hW : W.Pairwise fun x y => y ≤ x) {x y : Nat} (hy : y < sd.r)
    (hx : sd.r + phaseOff sd j a * period sd ≤ x)
    (hpath : Path B (actualKeys B) c
      (W.map (WithTop.map (kappa sd.r (period sd) (phaseOff sd j a)))) x y) :
    Path A (actualKeys A) a W
      (if x = sd.r + phaseOff sd j a * period sd then sd.r else x - phaseOff sd j a * period sd) y := by
  sorry

-- T3.2q: the converse transfer, old path to new path (used by T3.2r).
-- VERIFY-U2 (F4): the new path is read in the decorated system of `B` (route last keys `⊤`).
-- With actual keys of `B` the statement is false: a continuation last key of a head is smaller
-- than the old root key and can be consumed (bounded test: 176 failures on own cut queries).
theorem head_path_rev {A B : Forest} {sd : StopData} {rd : RootData} {n j : Nat} (hL : InL A)
    (hk : stepKind A = some .ordinary) (hsd : stopData A = some sd) (hrd : rootData A = some rd)
    (hB : expand A n = some B) (hj : 1 ≤ j ∧ j ≤ n) {a c : ColAddr}
    (ha : IsTmplCol A sd rd a) (hc : phaseCol sd rd j a = some c)
    {W : List (WithTop Key)} (hW : W.Pairwise fun x y => y ≤ x) {x0 y : Nat} (hy : y < sd.r)
    (hx0 : sd.r ≤ x0) (hpath : Path A (actualKeys A) a W x0 y) :
    Path B (capKeys B (routeCols B)) c
      (W.map (WithTop.map (kappa sd.r (period sd) (phaseOff sd j a))))
      (if x0 = sd.r then sd.r + phaseOff sd j a * period sd else x0 + phaseOff sd j a * period sd) y := by
  sorry

-- T3.2r (txt:377-403): ordinary outputs satisfy A (decorated A, then uncapping by S)
theorem condA_ord {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .ordinary)
    (hB : expand A n = some B) : CondA B := by sorry

/-! T3.2s helpers: column-local conditions, and replacing the last column at the end of a route. -/

/-- A column-local condition `φ`, read at every column with its printed number from `base`. -/
def spxAll (φ : Nat → Column → Prop) (base : Nat) (T : Forest) : Prop :=
  ∀ c col, T.colAt c = some col → φ (c.num base) col

theorem spx_num_cons (base a b : Nat) (ρ : List (Nat × Nat)) (j : Nat) :
    ColAddr.num base ⟨(a, b) :: ρ, j⟩ = ColAddr.num (base + a + 1) ⟨ρ, j⟩ := by
  simp only [ColAddr.num, List.map_cons, List.sum_cons]; omega

theorem spxAll_node {φ : Nat → Column → Prop} {base : Nat} {cols : List Column} :
    spxAll φ base (Tree.node cols) ↔
      ∀ j col, cols[j]? = some col → φ (base + j) col ∧ ∀ x ∈ col, spxAll φ (base + j + 1) x.2 := by
  constructor
  · intro h j col hj
    refine ⟨?_, fun x hx c col' hc => ?_⟩
    · have := h ⟨[], j⟩ col (by simpa [Tree.colAt, Tree.forestAt, Tree.cols] using hj)
      simpa [ColAddr.num] using this
    · obtain ⟨i, hi⟩ := List.mem_iff_getElem?.1 hx
      have := h ⟨(j, i) :: c.path, c.col⟩ col' (by
        rw [Tree.colAt_cons]; simp [Tree.cols, hj, hi, hc])
      rwa [spx_num_cons] at this
  · intro h c col hc
    obtain ⟨P, j⟩ := c
    cases P with
    | nil =>
      have hj : cols[j]? = some col := by simpa [Tree.colAt, Tree.forestAt, Tree.cols] using hc
      simpa [ColAddr.num] using (h j col hj).1
    | cons s ρ =>
      obtain ⟨a, b⟩ := s
      rw [Tree.colAt_cons] at hc
      simp only [Tree.cols, Option.bind_eq_some_iff] at hc
      obtain ⟨x, ⟨colA, hA, hb⟩, hx⟩ := hc
      rw [spx_num_cons]
      exact (h a colA hA).2 x (List.mem_of_getElem? hb) ⟨ρ, j⟩ col hx

theorem spx_replaceAt_zero (Z : Forest) (ys : List Column) (y : Column) :
    replaceAt 0 0 Z 0 (Tree.node (ys ++ [y])) = Tree.node (ys ++ Z.cols) := by
  cases ys with
  | nil => simp [replaceAt, shiftVal_zero_fun, treeMapCol_id_fun]
  | cons c cs =>
    simp only [replaceAt, shiftVal_zero_fun, treeMapCol_id_fun, List.map_id]
    rw [List.dropLast_concat]
    simp only [List.cons_append]

theorem spx_replaceAt_succ (Z : Forest) (k : Nat) (ys : List Column) (zs : Column) (q : Nat)
    (h : Forest) :
    replaceAt 0 0 Z (k + 1) (Tree.node (ys ++ [zs ++ [(q, h)]])) =
      Tree.node (ys ++ [zs ++ [(q, replaceAt 0 0 Z k h)]]) := by
  simp only [replaceAt, mapLast_eq, List.dropLast_concat, List.getLast?_concat,
    Option.map_some, Option.toList_some, shiftVal_zero_fun, treeMapCol_id_fun, id, treeMap_id,
    List.map_id]
  simp

/-- Replacing the last column at the end of a route path keeps a column-local condition, given
the condition at the new column and below it, and a relation `R` between the old and new heights
of the containers along which `φ` passes. -/
theorem spxAll_replace {φ : Nat → Column → Prop} (R : Forest → Forest → Prop) {c' col : Column}
    (hR0 : ∀ cs, R (Tree.node (cs ++ [c'])) (Tree.node (cs ++ [col])))
    (hRs : ∀ ys zs q h h', R h' h →
      R (Tree.node (ys ++ [zs ++ [(q, h')]])) (Tree.node (ys ++ [zs ++ [(q, h)]])))
    (hφ : ∀ n zs q h h', R h' h → φ n (zs ++ [(q, h)]) → φ n (zs ++ [(q, h')])) :
    ∀ (π : List (Nat × Nat)) (F G : Forest) (cs : List Column) (base : Nat), IsRoutePath F π →
      F.forestAt π = some G → G.cols = cs ++ [col] → spxAll φ base F →
      φ (ColAddr.num base ⟨π, cs.length⟩) c' →
      (∀ x ∈ c', spxAll φ (ColAddr.num base ⟨π, cs.length⟩ + 1) x.2) →
      spxAll φ base (replaceAt 0 0 (Tree.node [c']) π.length F) ∧
        R (replaceAt 0 0 (Tree.node [c']) π.length F) F
  | [], F, G, cs, base, _, hG, hGc, hF, hc', hsub => by
    simp only [Tree.forestAt, Option.some.injEq] at hG
    subst hG
    obtain ⟨cols⟩ := F
    simp only [Tree.cols] at hGc
    subst hGc
    simp only [List.length_nil, spx_replaceAt_zero, Tree.cols]
    refine ⟨?_, hR0 cs⟩
    rw [spxAll_node] at hF ⊢
    intro j c hj
    by_cases hjc : j = cs.length
    · subst hjc
      simp only [List.getElem?_append_right (le_refl _), Nat.sub_self, List.getElem?_cons_zero,
        Option.some.injEq] at hj
      subst hj
      simpa [ColAddr.num] using And.intro hc' hsub
    · have : (cs ++ [col])[j]? = some c := by
        rcases Nat.lt_or_gt_of_ne hjc with hlt | hgt
        · rw [List.getElem?_append_left hlt] at hj ⊢; exact hj
        · rw [List.getElem?_append_right (by omega)] at hj ⊢
          simp [show j - cs.length ≠ 0 by omega] at hj
      exact hF j c this
  | s :: π, .node cols, G, cs, base, hr, hG, hGc, hF, hc', hsub => by
    obtain ⟨hl, h, hh, hr'⟩ := isRoutePath_cons.1 hr
    obtain ⟨colL, q, h₀, hcol, hcl, hs, hh'⟩ := lastStep?_eq_some hl
    rw [hh] at hh'
    cases hh'
    have hG' : h.forestAt π = some G := by
      rw [show s :: π = [s] ++ π from rfl, Tree.forestAt_append, hh] at hG
      exact hG
    simp only [Tree.cols] at hcol hs
    obtain ⟨ys, rfl⟩ := List.getLast?_eq_some_iff.1 hcol
    obtain ⟨zs, rfl⟩ := List.getLast?_eq_some_iff.1 hcl
    subst hs
    simp only [List.length_append, List.length_singleton, Nat.add_sub_cancel] at hF hc' hsub ⊢
    rw [List.length_cons, spx_replaceAt_succ]
    rw [spxAll_node] at hF
    have hFy := hF ys.length (zs ++ [(q, h)]) (by simp)
    have hn : ∀ n, ColAddr.num base ⟨(ys.length, zs.length) :: π, n⟩ =
        ColAddr.num (base + ys.length + 1) ⟨π, n⟩ := fun n => spx_num_cons _ _ _ _ _
    rw [hn] at hc' hsub
    obtain ⟨ih1, ih2⟩ := spxAll_replace R hR0 hRs hφ π h G cs (base + ys.length + 1) hr' hG' hGc
      (hFy.2 (q, h) (by simp)) hc' hsub
    refine ⟨?_, hRs ys zs q h _ ih2⟩
    rw [spxAll_node]
    intro j c hj
    by_cases hjc : j = ys.length
    · subst hjc
      simp only [List.getElem?_append_right (le_refl _), Nat.sub_self, List.getElem?_cons_zero,
        Option.some.injEq] at hj
      subst hj
      refine ⟨hφ _ zs q h _ ih2 hFy.1, ?_⟩
      intro x hx
      rcases List.mem_append.1 hx with hx | hx
      · exact hFy.2 x (List.mem_append_left _ hx)
      · simp only [List.mem_singleton] at hx; subst hx; exact ih1
    · have : (ys ++ [zs ++ [(q, h)]])[j]? = some c := by
        rcases Nat.lt_or_gt_of_ne hjc with hlt | hgt
        · rw [List.getElem?_append_left hlt] at hj ⊢; exact hj
        · rw [List.getElem?_append_right (by omega)] at hj ⊢
          simp [show j - ys.length ≠ 0 by omega] at hj
      exact hF j c this

theorem spx_then_eq (o : Ordering) : o.then .eq = o := by cases o <;> rfl

theorem spx_compare_self (q : Nat) : compare q q = .eq := compare_eq_iff_eq.2 rfl

theorem spx_cmpCols_append (ys X Y : List Column) :
    Tree.cmpCols compare (ys ++ X) (ys ++ Y) = Tree.cmpCols compare X Y := by
  induction ys with
  | nil => rfl
  | cons y ys ih =>
    simp only [List.cons_append, Tree.cmpCols, Tree.cmpCol_self, ih]; rfl

theorem spx_cmpCol_append (zs X Y : Column) :
    Tree.cmpCol compare (zs ++ X) (zs ++ Y) = Tree.cmpCol compare X Y := by
  induction zs with
  | nil => rfl
  | cons z zs ih =>
    obtain ⟨q, h⟩ := z
    simp only [List.cons_append, Tree.cmpCol, Tree.cmp_self, spx_compare_self, ih]; rfl

/-- Lowering the height of the last entry of the last column lowers the forest. -/
theorem spx_le_last (ys : List Column) (zs : Column) (q : Nat) {h h' : Forest} (hh : h' ≤ h) :
    Tree.node (ys ++ [zs ++ [(q, h')]]) ≤ Tree.node (ys ++ [zs ++ [(q, h)]]) := by
  rw [Forest.le_iff_cmp] at hh ⊢
  show Tree.cmpCols compare _ _ ≠ .gt
  rw [spx_cmpCols_append]
  simp only [Tree.cmpCols, spx_then_eq]
  rw [spx_cmpCol_append]
  simp only [Tree.cmpCol, spx_compare_self, spx_then_eq]
  exact hh

/-- Lowering the last column lowers the forest. -/
theorem spx_le_lastCol (cs : List Column) {c' col : Column} (h : Tree.cmpCol compare c' col ≠ .gt) :
    Tree.node (cs ++ [c']) ≤ Tree.node (cs ++ [col]) := by
  rw [Forest.le_iff_cmp]
  show Tree.cmpCols compare _ _ ≠ .gt
  rw [spx_cmpCols_append]
  simp only [Tree.cmpCols, spx_then_eq]
  exact h

/-- Dropping the last column is a decrease. -/
theorem spx_dropLast_lt {Fl : Forest} (h : Fl.cols ≠ []) : Tree.node Fl.cols.dropLast < Fl := by
  rw [Forest.lt_iff_cmp]
  obtain ⟨L, x, hL⟩ := (List.eq_nil_or_concat Fl.cols).resolve_left h
  rw [spx_eta Fl, hL]
  show Tree.cmpCols compare _ _ = .lt
  simp only [Tree.cols]
  rw [List.concat_eq_append, List.dropLast_concat]
  have := spx_cmpCols_append L [] [x]
  rw [List.append_nil] at this
  rw [this]; rfl

/-! The three column-local conditions V, I, H. -/

def spxφV (n : Nat) (col : Column) : Prop := ∀ x ∈ col, x.1 < n

def spxφI (n : Nat) (col : Column) : Prop :=
  ∀ x ∈ col, x.2 ≠ Tree.empty → ∀ cc ∈ x.2.cols, ∃ q H rest, cc = (q, H) :: rest ∧ n ≤ q

def spxφH (_ : Nat) (col : Column) : Prop := spxNoninc col

theorem spx_condV_iff (E : Forest) : CondV E ↔ spxAll spxφV 0 E := by
  rw [condV_iff_lt]
  constructor
  · intro h c col hc x hx
    obtain ⟨i, hi⟩ := List.mem_iff_getElem?.1 hx
    have he : E.entryAt ⟨c, i⟩ = some x := by rw [Tree.entryAt, hc]; exact hi
    exact h ⟨c, i⟩ ((Tree.mem_entryAddrs_iff _ _).2 (by rw [he]; rfl)) x.1 x.2 he
  · intro h e _ p H he
    obtain ⟨col, hc, hi⟩ := Tree.colAt_of_entryAt he
    exact h e.col col hc (p, H) (List.mem_of_getElem? hi)

theorem spx_condI_iff (E : Forest) : CondI E ↔ spxAll spxφI 0 E := by
  constructor
  · intro h c col hc x hx hne cc hcc
    obtain ⟨i, hi⟩ := List.mem_iff_getElem?.1 hx
    have he : E.entryAt ⟨c, i⟩ = some x := by rw [Tree.entryAt, hc]; exact hi
    exact h ⟨c, i⟩ ((Tree.mem_entryAddrs_iff _ _).2 (by rw [he]; rfl)) x.1 x.2 he hne cc hcc
  · intro h e _ p H he hne cc hcc
    obtain ⟨col, hc, hi⟩ := Tree.colAt_of_entryAt he
    exact h e.col col hc (p, H) (List.mem_of_getElem? hi) hne cc hcc

theorem spx_condH_iff (E : Forest) : CondH E ↔ spxAll spxφH 0 E := by
  constructor
  · intro h c col hc
    exact spx_condH_col h hc
  · intro h c _ i x y hx hy
    obtain ⟨col, hc⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff _ c).1 ‹_›)
    rw [hc, Option.getD_some] at hx hy
    exact h c col hc i x y hx hy

/-- Column-local conditions pass to the heights of a column's entries. -/
theorem spxAll_height {φ : Nat → Column → Prop} {base : Nat} {T : Forest} (h : spxAll φ base T)
    {c : ColAddr} {col : Column} (hc : T.colAt c = some col) :
    ∀ x ∈ col, spxAll φ (c.num base + 1) x.2 := by
  intro x hx c'' col'' hc''
  obtain ⟨i, hi⟩ := List.mem_iff_getElem?.1 hx
  have hcol : T.colAt ⟨c.path ++ (c.col, i) :: c''.path, c''.col⟩ = some col'' := by
    rw [show c.path ++ (c.col, i) :: c''.path = (⟨c, i⟩ : EntryAddr).heightPath ++ c''.path by
      simp [EntryAddr.heightPath], spx_colAt_append, Tree.forestAt_heightPath, Tree.heightAt,
      Tree.entryAt, hc]
    simp [hi, hc'']
  have := h _ _ hcol
  have hn : ColAddr.num base ⟨c.path ++ (c.col, i) :: c''.path, c''.col⟩ =
      ColAddr.num (c.num base + 1) c'' := by
    simp only [ColAddr.num, List.map_append, List.map_cons, List.sum_append, List.sum_cons]; omega
  rwa [hn] at this

/-- Column-local conditions hold for a forest made of a prefix of the columns. -/
theorem spxAll_dropLast {φ : Nat → Column → Prop} {base : Nat} {Fl : Forest}
    (h : spxAll φ base Fl) : spxAll φ base (Tree.node Fl.cols.dropLast) := by
  rw [spx_eta Fl, spxAll_node] at h
  rw [spxAll_node]
  intro j col hj
  exact h j col (by rw [List.getElem?_dropLast] at hj; split_ifs at hj; exact hj)

/-- Lowering the height of the last entry keeps a column nonincreasing. -/
theorem spx_noninc_lower {zs : Column} {q : Nat} {h h' : Forest} (hc : spxNoninc (zs ++ [(q, h)]))
    (hh : h' ≤ h) : spxNoninc (zs ++ [(q, h')]) := by
  intro i x y hx hy
  by_cases hi : i + 1 < zs.length
  · rw [List.getElem?_append_left (by omega)] at hx
    rw [List.getElem?_append_left hi] at hy
    exact hc i x y (by rw [List.getElem?_append_left (by omega)]; exact hx)
      (by rw [List.getElem?_append_left hi]; exact hy)
  · have hil : i + 1 = zs.length := by
      have := (List.getElem?_eq_some_iff.1 hy).1; simp at this; omega
    rw [List.getElem?_append_left (by omega)] at hx
    rw [List.getElem?_append_right (by omega), hil, Nat.sub_self] at hy
    simp only [List.getElem?_cons_zero, Option.some.injEq] at hy
    subst hy
    have := hc i x (q, h) (by rw [List.getElem?_append_left (by omega)]; exact hx)
      (by rw [List.getElem?_append_right (by omega), hil, Nat.sub_self]; rfl)
    rcases this with hlt | ⟨heq, hle⟩
    · exact Or.inl hlt
    · exact Or.inr ⟨heq, le_trans hh hle⟩

/-- Repeating the last entry keeps a column nonincreasing. -/
theorem spx_noninc_replicate {L : Column} {z : Nat × Forest} (hc : spxNoninc (L ++ [z])) (N : Nat) :
    spxNoninc (L ++ List.replicate N z) := by
  intro i x y hx hy
  by_cases hi : i + 1 < L.length
  · rw [List.getElem?_append_left (by omega)] at hx
    rw [List.getElem?_append_left hi] at hy
    exact hc i x y (by rw [List.getElem?_append_left (by omega)]; exact hx)
      (by rw [List.getElem?_append_left hi]; exact hy)
  · by_cases hil : i + 1 = L.length
    · rw [List.getElem?_append_left (by omega)] at hx
      rw [List.getElem?_append_right (by omega), hil, Nat.sub_self] at hy
      have hy' := List.eq_of_mem_replicate (List.mem_of_getElem? hy)
      subst hy'
      exact hc i x _ (by rw [List.getElem?_append_left (by omega)]; exact hx)
        (by rw [List.getElem?_append_right (by omega), hil, Nat.sub_self]; rfl)
    · rw [List.getElem?_append_right (by omega)] at hx hy
      have hx' := List.eq_of_mem_replicate (List.mem_of_getElem? hx)
      have hy' := List.eq_of_mem_replicate (List.mem_of_getElem? hy)
      subst hx' hy'
      exact Or.inr ⟨rfl, le_refl _⟩

/-- The special output: the owner column `P ⌢ [(p, Fl)]` at the end of the route path `π` becomes
`P ⌢ [(p, C)]^N`, `C` being `Fl` without its last column, with `N ≥ 1` when `P = []`. -/
theorem spx_special_shape {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .special)
    (hB : expand A n = some B) :
    ∃ (π : List (Nat × Nat)) (G : Forest) (cs : List Column) (P : Column) (p : Nat) (Fl : Forest)
      (N : Nat), IsRoutePath A π ∧ A.forestAt π = some G ∧ G.cols = cs ++ [P ++ [(p, Fl)]] ∧
      Fl.cols ≠ [] ∧ (P = [] → 1 ≤ N) ∧
      B = replaceAt 0 0 (Tree.node [P ++ List.replicate N (p, Tree.node Fl.cols.dropLast)])
        π.length A := by
  obtain ⟨hV, hI, -, -, -⟩ := hL
  have hE : A ≠ Tree.empty := by
    rintro rfl; simp [stepKind, stepKindBody, Tree.empty, Tree.cols] at hk
  rw [expand_eq_paperOp hE hV hI] at hB
  obtain ⟨sd, hsd⟩ := Option.isSome_iff_exists.1 (stopData_of_stepKind hk (by decide))
  obtain ⟨oe, hoe⟩ := Option.isSome_iff_exists.1 (ownerEntry_of_special hk hsd)
  obtain ⟨-, hhp, -, col, p, Fl, hcol, hlast, -, hFl⟩ := ownerEntry_spec hk hsd hoe
  rw [paperOp_special hk hsd hoe hcol hlast n, Option.some.injEq, Hole.fill_zero] at hB
  obtain ⟨-, hdep, -, hmem, -, -⟩ := stopData_spec hsd
  obtain ⟨hrp, -⟩ := (mem_routeCols_iff A sd.col).1 hmem
  rw [← hhp] at hrp hdep
  have hrpπ : IsRoutePath A oe.col.path := by
    intro d hd
    obtain ⟨F, hF, hFl'⟩ := hrp d (by simp [EntryAddr.heightPath]; omega)
    refine ⟨F, ?_, ?_⟩
    · rw [EntryAddr.heightPath, List.take_append_of_le_length (le_of_lt hd)] at hF; exact hF
    · rw [EntryAddr.heightPath, List.getElem?_append_left hd] at hFl'; exact hFl'
  obtain ⟨G, hG, hGl⟩ := hrp oe.col.path.length (by simp [EntryAddr.heightPath])
  simp only [EntryAddr.heightPath, List.take_left', List.getElem?_append_right (le_refl _),
    Nat.sub_self, List.getElem?_cons_zero] at hG hGl
  obtain ⟨colL, q', h', hcolL, -, hs, -⟩ := lastStep?_eq_some hGl
  simp only [Prod.mk.injEq] at hs
  obtain ⟨hs1, -⟩ := hs
  have hcc : col = colL := by
    rw [Tree.colAt, hG, Option.bind_some, hs1, ← List.getLast?_eq_getElem?, hcolL] at hcol
    exact (Option.some.inj hcol).symm
  subst hcc
  obtain ⟨cs, hcs⟩ := List.getLast?_eq_some_iff.1 hcolL
  obtain ⟨P, hP⟩ := List.getLast?_eq_some_iff.1 hlast
  have hFl' : Fl.cols ≠ [] := by intro h0; rw [h0] at hFl; simp at hFl
  refine ⟨oe.col.path, G, cs, P, p, Fl, n + (if col.dropLast.isEmpty then 1 else 0), hrpπ, hG,
    by rw [hcs, hP], hFl', fun hP0 => by simp [hP, hP0], ?_⟩
  rw [← hB, Hole.put]
  simp only [hdep, EntryAddr.heightPath, List.length_append, List.length_singleton,
    Nat.add_sub_cancel, hP, List.dropLast_concat]

theorem spx_mem_special {P : Column} {N p : Nat} {C : Forest} {x : Nat × Forest}
    (hx : x ∈ P ++ List.replicate N (p, C)) : x ∈ P ∨ x = (p, C) := by
  rcases List.mem_append.1 hx with hx | hx
  · exact Or.inl hx
  · exact Or.inr (List.eq_of_mem_replicate hx)

-- T3.2s (txt:404-407): special outputs satisfy V, I, H
theorem condVIH_special {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .special)
    (hB : expand A n = some B) : CondV B ∧ CondI B ∧ CondH B := by
  obtain ⟨π, G, cs, P, p, Fl, N, hrp, hG, hGc, hFl, hN, rfl⟩ := spx_special_shape hL hk hB
  obtain ⟨hV, hI, hH, -, -⟩ := hL
  have hcolA : A.colAt ⟨π, cs.length⟩ = some (P ++ [(p, Fl)]) := by
    simp [Tree.colAt, hG, hGc]
  have hCFl : Tree.node Fl.cols.dropLast < Fl := spx_dropLast_lt hFl
  have hFlne : Fl ≠ Tree.empty := by intro h0; rw [h0] at hFl; exact hFl rfl
  refine ⟨?_, ?_, ?_⟩
  · -- V: parents are unchanged
    rw [spx_condV_iff] at hV ⊢
    refine (spxAll_replace (φ := spxφV) (fun _ _ => True) (fun _ => trivial)
      (fun _ _ _ _ _ _ => trivial) ?_ π A G cs 0 hrp hG hGc hV ?_ ?_).1
    · intro m zs q h h' _ hφ x hx
      rcases List.mem_append.1 hx with hx | hx
      · exact hφ x (List.mem_append_left _ hx)
      · simp only [List.mem_singleton] at hx; subst hx; exact hφ (q, h) (by simp)
    · intro x hx
      rcases spx_mem_special hx with hx | rfl
      · exact hV _ _ hcolA x (List.mem_append_left _ hx)
      · exact hV _ _ hcolA (p, Fl) (by simp)
    · intro x hx
      rcases spx_mem_special hx with hx | rfl
      · exact spxAll_height hV hcolA x (List.mem_append_left _ hx)
      · exact spxAll_dropLast (spxAll_height hV hcolA (p, Fl) (by simp))
  · -- I: first parents of all columns are unchanged
    rw [spx_condI_iff] at hI ⊢
    let f : Column → Option Nat := fun cc => cc.head?.map Prod.fst
    refine (spxAll_replace (φ := spxφI) (fun h' h => h'.cols.map f = h.cols.map f) ?_ ?_ ?_
      π A G cs 0 hrp hG hGc hI ?_ ?_).1
    · intro cs'
      simp only [Tree.cols, List.map_append, List.map_cons, List.map_nil, f]
      congr 2
      cases P with
      | nil =>
        obtain ⟨N', rfl⟩ : ∃ N', N = N' + 1 := ⟨N - 1, by have := hN rfl; omega⟩
        simp [List.replicate_succ]
      | cons x xs => simp
    · intro ys zs q h h' _
      simp only [Tree.cols, List.map_append, List.map_cons, List.map_nil, f]
      cases zs <;> simp
    · intro m zs q h h' hR hφ x hx hne cc hcc
      rcases List.mem_append.1 hx with hx | hx
      · exact hφ x (List.mem_append_left _ hx) hne cc hcc
      · simp only [List.mem_singleton] at hx
        subst hx
        dsimp only at hne hcc
        obtain ⟨i, hi⟩ := List.mem_iff_getElem?.1 hcc
        have hlen : h'.cols.length = h.cols.length := by simpa using congrArg List.length hR
        have hi' : i < h.cols.length := by have := (List.getElem?_eq_some_iff.1 hi).1; omega
        have hne' : h ≠ Tree.empty := by
          intro h0; rw [h0] at hi'; simp [Tree.empty, Tree.cols] at hi'
        obtain ⟨q₀, H₀, rest₀, hc₀, hq₀⟩ := hφ (q, h) (by simp) hne' _
          (List.getElem_mem hi')
        have hf := congrArg (fun l => l[i]?) hR
        simp only [List.getElem?_map, hi, List.getElem?_eq_getElem hi', hc₀, Option.map_some,
          f] at hf
        obtain ⟨⟨q₁, H₁⟩, rest₁, rfl⟩ : ∃ y rest, cc = y :: rest := by
          cases cc with
          | nil => simp at hf
          | cons y rest => exact ⟨y, rest, rfl⟩
        simp only [List.head?_cons, Option.map_some, Option.some.injEq] at hf
        exact ⟨q₁, H₁, rest₁, rfl, hf ▸ hq₀⟩
    · intro x hx hne cc hcc
      rcases spx_mem_special hx with hx | rfl
      · exact hI _ _ hcolA x (List.mem_append_left _ hx) hne cc hcc
      · exact hI _ _ hcolA (p, Fl) (by simp) hFlne cc (List.mem_of_mem_dropLast hcc)
    · intro x hx
      rcases spx_mem_special hx with hx | rfl
      · exact spxAll_height hI hcolA x (List.mem_append_left _ hx)
      · exact spxAll_dropLast (spxAll_height hI hcolA (p, Fl) (by simp))
  · -- H: the changed heights only decrease
    rw [spx_condH_iff] at hH ⊢
    refine (spxAll_replace (φ := spxφH) (fun h' h => h' ≤ h) ?_ ?_ ?_
      π A G cs 0 hrp hG hGc hH ?_ ?_).1
    · intro cs'
      apply spx_le_lastCol
      rw [spx_cmpCol_append]
      cases N with
      | zero => simp [Tree.cmpCol]
      | succ N =>
        simp only [List.replicate_succ, Tree.cmpCol, spx_compare_self]
        rw [show Tree.cmp compare (Tree.node Fl.cols.dropLast) Fl = .lt from hCFl]
        simp
    · intro ys zs q h h' hh; exact spx_le_last ys zs q hh
    · intro m zs q h h' hh hφ; exact spx_noninc_lower hφ hh
    · exact spx_noninc_replicate (spx_noninc_lower (hH _ _ hcolA) (le_of_lt hCFl)) N
    · intro x hx
      rcases spx_mem_special hx with hx | rfl
      · exact spxAll_height hH hcolA x (List.mem_append_left _ hx)
      · exact spxAll_dropLast (spxAll_height hH hcolA (p, Fl) (by simp))


/-! T3.2t helpers (branch E2): owner-return conditions as column-local conditions. -/

/-- Returns into a height `H` attached to a column with printed number `n`, checked by `ψ`
(`ψ m J n H` reads the return height `J` in a column with number `m`). -/
def retIn_E2 (ψ : Nat → Forest → Nat → Forest → Prop) (n : Nat) (H : Forest) : Prop :=
  spxAll (fun m col' => ∀ y ∈ col', y.1 = n → ψ m y.2 n H) (n + 1) H

/-- The column-local form of an owner-return condition: every height of the column. -/
def retAll_E2 (ψ : Nat → Forest → Nat → Forest → Prop) (n : Nat) (col : Column) : Prop :=
  ∀ x ∈ col, retIn_E2 ψ n x.2

theorem num_base_E2 (b : Nat) (c : ColAddr) : c.num b = b + c.num 0 := by
  simp only [ColAddr.num]; omega

theorem num_heightPath_E2 (e0 : EntryAddr) (ρ : List (Nat × Nat)) (j : Nat) :
    ColAddr.num 0 ⟨e0.heightPath ++ ρ, j⟩ = ColAddr.num (e0.col.num 0 + 1) ⟨ρ, j⟩ := by
  simp only [ColAddr.num, EntryAddr.heightPath, List.map_append, List.sum_append, List.map_cons,
    List.map_nil, List.sum_cons, List.sum_nil]
  omega

/-- An owner-return condition is the column-local condition `retAll_E2`. -/
theorem spx_ret_iff_E2 (ψ : Nat → Forest → Nat → Forest → Prop) (E : Forest) :
    (∀ e0 ∈ E.entryAddrs, ∀ e ∈ E.entryAddrs, IsOwnerReturn E e0 e →
      ψ (e.col.num 0) ((E.heightAt e).getD Tree.empty) (e0.col.num 0)
        ((E.heightAt e0).getD Tree.empty)) ↔
    spxAll (retAll_E2 ψ) 0 E := by
  constructor
  · intro h c col hc x hx c' col' hc' y hy hy1
    obtain ⟨i, hi⟩ := List.mem_iff_getElem?.1 hx
    obtain ⟨k, hk⟩ := List.mem_iff_getElem?.1 hy
    have he0 : E.entryAt ⟨c, i⟩ = some x := by rw [Tree.entryAt, hc]; exact hi
    have hn : c.num 0 = ColAddr.num 0 c := rfl
    have he : E.entryAt ⟨⟨(⟨c, i⟩ : EntryAddr).heightPath ++ c'.path, c'.col⟩, k⟩ = some y := by
      rw [spx_entryAt_inside, Tree.heightAt, he0]
      simp only [Option.map_some, Option.bind_some, Tree.entryAt]
      rw [hc']; exact hk
    have hcont : (⟨c, i⟩ : EntryAddr).Contains ⟨(⟨c, i⟩ : EntryAddr).heightPath ++ c'.path, c'.col⟩ :=
      ⟨c'.path, rfl⟩
    have hret : IsOwnerReturn E ⟨c, i⟩ ⟨⟨(⟨c, i⟩ : EntryAddr).heightPath ++ c'.path, c'.col⟩, k⟩ := by
      refine ⟨hcont, y.1, y.2, he, ?_⟩
      have := EntryAddr.resolve_host hcont
      simp only [hy1]
      rw [num_base_E2] at this ⊢
      simpa using this
    have := h _ ((Tree.mem_entryAddrs_iff E _).2 (by rw [he0]; rfl)) _
      ((Tree.mem_entryAddrs_iff E _).2 (by rw [he]; rfl)) hret
    simp only [Tree.heightAt, he, he0, Option.map_some, Option.getD_some] at this
    rw [num_heightPath_E2] at this
    exact this
  · intro h e0 he0 e he hret
    obtain ⟨⟨ρ, hρ⟩, q, J, hJ, hres⟩ := hret
    obtain ⟨⟨P, j⟩, i⟩ := e
    dsimp only at hρ
    subst hρ
    obtain ⟨x0, hx0⟩ := Option.isSome_iff_exists.1 ((Tree.mem_entryAddrs_iff _ e0).1 he0)
    obtain ⟨col, hcol, hi⟩ := Tree.colAt_of_entryAt hx0
    have hR := h e0.col col hcol x0 (List.mem_of_getElem? hi)
    have hJ' := hJ
    rw [spx_entryAt_inside, Tree.heightAt, hx0] at hJ'
    simp only [Option.map_some, Option.bind_some] at hJ'
    obtain ⟨col', hcol', hk⟩ := Tree.colAt_of_entryAt hJ'
    have hq : e0.col.num 0 = q := ColAddr.resolve_num hres
    have := hR ⟨ρ, j⟩ col' hcol' (q, J) (List.mem_of_getElem? hk) hq.symm
    simp only [Tree.heightAt, hJ, hx0, Option.map_some, Option.getD_some]
    rw [num_heightPath_E2]
    exact this

/-- Every entry of a forest, at any depth, has a height satisfying `Q`. -/
def allEnt_E2 (Q : Forest → Prop) (T : Forest) : Prop :=
  ∀ c col, T.colAt c = some col → ∀ y ∈ col, Q y.2

/-- An entry correspondence: every entry of `h'` (any depth) has an entry of `h` in a column with
the same relative number, with the same parent, related by `Rel`. -/
def entCorr_E2 (Rel : Forest → Forest → Prop) (h' h : Forest) : Prop :=
  ∀ c' col', h'.colAt c' = some col' → ∀ y' ∈ col', ∃ c col, h.colAt c = some col ∧
    c.num 0 = c'.num 0 ∧ ∃ y ∈ col, y.1 = y'.1 ∧ Rel y'.2 y.2

theorem retIn_of_entCorr_E2 {ψ : Nat → Forest → Nat → Forest → Prop}
    {Rel : Forest → Forest → Prop} {h' h : Forest} {n : Nat} (hC : entCorr_E2 Rel h' h)
    (hψ : ∀ m J' J, Rel J' J → ψ m J n h → ψ m J' n h') (hR : retIn_E2 ψ n h) :
    retIn_E2 ψ n h' := by
  intro c' col' hc' y' hy' hy1
  obtain ⟨c, col, hc, hnum, y, hy, hyy, hrel⟩ := hC c' col' hc' y' hy'
  have := hR c col hc y hy (hyy.trans hy1)
  rw [num_base_E2, hnum, ← num_base_E2] at this
  exact hψ _ _ _ hrel this

theorem retIn_of_allEnt_E2 {ψ : Nat → Forest → Nat → Forest → Prop} {n : Nat} {h : Forest}
    (hA : allEnt_E2 (fun J => ∀ m, ψ m J n h) h) : retIn_E2 ψ n h := by
  intro c col hc y hy _
  exact hA c col hc y hy _

theorem entCorr_mono_E2 {Rel Rel' : Forest → Forest → Prop} {h' h : Forest}
    (hC : entCorr_E2 Rel h' h) (hm : ∀ J' J, Rel J' J → Rel' J' J) : entCorr_E2 Rel' h' h := by
  intro c' col' hc' y' hy'
  obtain ⟨c, col, hc, hnum, y, hy, hyy, hrel⟩ := hC c' col' hc' y' hy'
  exact ⟨c, col, hc, hnum, y, hy, hyy, hm _ _ hrel⟩

theorem colAt_dropLast_E2 {F : Forest} {c : ColAddr} {col : Column}
    (h : (Tree.node F.cols.dropLast).colAt c = some col) : F.colAt c = some col := by
  obtain ⟨P, j⟩ := c
  rw [spx_eta F]
  cases P with
  | nil =>
    simp only [Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols] at h ⊢
    rw [List.getElem?_dropLast] at h
    split_ifs at h; exact h
  | cons s ρ =>
    obtain ⟨a, b⟩ := s
    rw [Tree.colAt_cons] at h ⊢
    simp only [Tree.cols] at h ⊢
    rw [List.getElem?_dropLast] at h
    split_ifs at h
    · exact h
    · simp at h

/-- A forest made of a prefix of the columns corresponds to the whole forest. -/
theorem entCorr_dropLast_E2 {Rel : Forest → Forest → Prop} {F : Forest}
    (hA : allEnt_E2 (fun J => Rel J J) (Tree.node F.cols.dropLast)) :
    entCorr_E2 Rel (Tree.node F.cols.dropLast) F := by
  intro c' col' hc' y' hy'
  exact ⟨c', col', colAt_dropLast_E2 hc', rfl, y', hy', rfl, hA c' col' hc' y' hy'⟩

/-- The entry of `cols` at `(a, b)`. -/
def getEnt_E2 (cols : List Column) (a b : Nat) : Option (Nat × Forest) :=
  (cols[a]?).bind (·[b]?)

theorem colAt_cons_E2 (cols : List Column) (a b : Nat) (ρ : List (Nat × Nat)) (j : Nat) :
    (Tree.node cols).colAt ⟨(a, b) :: ρ, j⟩ =
      (getEnt_E2 cols a b).bind fun x => x.2.colAt ⟨ρ, j⟩ := by
  rw [Tree.colAt_cons]; rfl

theorem colAt_nil_E2 (cols : List Column) (j : Nat) :
    (Tree.node cols).colAt ⟨[], j⟩ = cols[j]? := by
  simp [Tree.colAt, Tree.forestAt, Tree.cols]

theorem getEnt_snoc_E2 {ys : List Column} {zs : Column} {q : Nat} (X Y : Forest) {a b : Nat}
    (hab : ¬ (a = ys.length ∧ b = zs.length)) :
    getEnt_E2 (ys ++ [zs ++ [(q, X)]]) a b = getEnt_E2 (ys ++ [zs ++ [(q, Y)]]) a b := by
  unfold getEnt_E2
  rcases Nat.lt_trichotomy a ys.length with ha | rfl | ha
  · rw [List.getElem?_append_left ha, List.getElem?_append_left ha]
  · rw [List.getElem?_append_right (le_refl _), List.getElem?_append_right (le_refl _)]
    simp only [Nat.sub_self, List.getElem?_cons_zero, Option.bind_some]
    have hb : b ≠ zs.length := fun h => hab ⟨rfl, h⟩
    rcases Nat.lt_or_gt_of_ne hb with hb | hb
    · rw [List.getElem?_append_left hb, List.getElem?_append_left hb]
    · rw [List.getElem?_append_right (by omega), List.getElem?_append_right (by omega)]
      simp [show b - zs.length ≠ 0 by omega]
  · rw [List.getElem?_append_right (by omega), List.getElem?_append_right (by omega)]
    simp [show a - ys.length ≠ 0 by omega]

theorem getEnt_snoc_self_E2 (ys : List Column) (zs : Column) (q : Nat) (X : Forest) :
    getEnt_E2 (ys ++ [zs ++ [(q, X)]]) ys.length zs.length = some (q, X) := by
  simp [getEnt_E2]

/-- Propagation of an entry correspondence through one level of the route. -/
theorem entCorr_snoc_E2 {Rel Rel' : Forest → Forest → Prop} {ys : List Column} {zs : Column}
    {q : Nat} {h h' : Forest} (hC : entCorr_E2 Rel h' h) (hm : ∀ J' J, Rel J' J → Rel' J' J)
    (hhh : Rel' h' h)
    (hT : allEnt_E2 (fun J => Rel' J J) (Tree.node (ys ++ [zs ++ [(q, Tree.empty)]]))) :
    entCorr_E2 Rel' (Tree.node (ys ++ [zs ++ [(q, h')]])) (Tree.node (ys ++ [zs ++ [(q, h)]])) := by
  intro c' col' hc' y' hy'
  obtain ⟨P, j⟩ := c'
  cases P with
  | nil =>
    rw [colAt_nil_E2] at hc'
    rcases Nat.lt_trichotomy j ys.length with hj | rfl | hj
    · rw [List.getElem?_append_left hj] at hc'
      refine ⟨⟨[], j⟩, col', by rw [colAt_nil_E2, List.getElem?_append_left hj, hc'], rfl, y', hy',
        rfl, hT ⟨[], j⟩ col' (by rw [colAt_nil_E2, List.getElem?_append_left hj, hc']) y' hy'⟩
    · simp only [List.getElem?_append_right (le_refl _), Nat.sub_self, List.getElem?_cons_zero,
        Option.some.injEq] at hc'
      subst hc'
      rcases List.mem_append.1 hy' with hy | hy
      · refine ⟨⟨[], ys.length⟩, zs ++ [(q, h)], by simp [colAt_nil_E2], rfl, y',
          List.mem_append_left _ hy, rfl, hT ⟨[], ys.length⟩ (zs ++ [(q, Tree.empty)])
            (by simp [colAt_nil_E2]) y' (List.mem_append_left _ hy)⟩
      · simp only [List.mem_singleton] at hy
        subst hy
        exact ⟨⟨[], ys.length⟩, zs ++ [(q, h)], by simp [colAt_nil_E2], rfl, (q, h), by simp, rfl,
          hhh⟩
    · rw [List.getElem?_append_right (by omega)] at hc'
      simp [show j - ys.length ≠ 0 by omega] at hc'
  | cons s ρ =>
    obtain ⟨a, b⟩ := s
    rw [colAt_cons_E2, Option.bind_eq_some_iff] at hc'
    obtain ⟨x', hx', hcx⟩ := hc'
    by_cases hab : a = ys.length ∧ b = zs.length
    · obtain ⟨rfl, rfl⟩ := hab
      rw [getEnt_snoc_self_E2] at hx'
      cases hx'
      obtain ⟨c, col, hc, hnum, y, hy, hyy, hrel⟩ := hC ⟨ρ, j⟩ col' hcx y' hy'
      refine ⟨⟨(ys.length, zs.length) :: c.path, c.col⟩, col, ?_, ?_, y, hy, hyy, hm _ _ hrel⟩
      · rw [colAt_cons_E2, getEnt_snoc_self_E2]; exact hc
      · rw [spx_num_cons, spx_num_cons, num_base_E2, num_base_E2 (0 + _ + 1)]
        exact congrArg _ hnum
    · have e1 := getEnt_snoc_E2 h' h hab (q := q)
      have e2 := getEnt_snoc_E2 h' Tree.empty hab (q := q)
      refine ⟨⟨(a, b) :: ρ, j⟩, col', ?_, rfl, y', hy', rfl, hT ⟨(a, b) :: ρ, j⟩ col' ?_ y' hy'⟩
      · rw [colAt_cons_E2, ← e1, hx']; exact hcx
      · rw [colAt_cons_E2, ← e2, hx']; exact hcx

/-- The entry correspondence at the replaced owner column. -/
theorem entCorr_top_E2 {Rel : Forest → Forest → Prop} {cs : List Column} {P : Column}
    {p N : Nat} {Fl : Forest}
    (hT : allEnt_E2 (fun J => Rel J J) (Tree.node (cs ++ [P])))
    (hCe : N ≠ 0 → allEnt_E2 (fun J => Rel J J) (Tree.node Fl.cols.dropLast))
    (hCF : N ≠ 0 → Rel (Tree.node Fl.cols.dropLast) Fl) :
    entCorr_E2 Rel (Tree.node (cs ++ [P ++ List.replicate N (p, Tree.node Fl.cols.dropLast)]))
      (Tree.node (cs ++ [P ++ [(p, Fl)]])) := by
  intro c' col' hc' y' hy'
  obtain ⟨Pa, j⟩ := c'
  cases Pa with
  | nil =>
    rw [colAt_nil_E2] at hc'
    rcases Nat.lt_trichotomy j cs.length with hj | rfl | hj
    · rw [List.getElem?_append_left hj] at hc'
      refine ⟨⟨[], j⟩, col', by rw [colAt_nil_E2, List.getElem?_append_left hj, hc'], rfl, y', hy',
        rfl, hT ⟨[], j⟩ col' (by rw [colAt_nil_E2, List.getElem?_append_left hj, hc']) y' hy'⟩
    · simp only [List.getElem?_append_right (le_refl _), Nat.sub_self, List.getElem?_cons_zero,
        Option.some.injEq] at hc'
      subst hc'
      rcases List.mem_append.1 hy' with hy | hy
      · refine ⟨⟨[], cs.length⟩, P ++ [(p, Fl)], by simp [colAt_nil_E2], rfl, y',
          List.mem_append_left _ hy, rfl, hT ⟨[], cs.length⟩ P (by simp [colAt_nil_E2]) y' hy⟩
      · have hN : N ≠ 0 := by rintro rfl; simp at hy
        rw [List.eq_of_mem_replicate hy]
        exact ⟨⟨[], cs.length⟩, P ++ [(p, Fl)], by simp [colAt_nil_E2], rfl, (p, Fl), by simp, rfl,
          hCF hN⟩
    · rw [List.getElem?_append_right (by omega)] at hc'
      simp [show j - cs.length ≠ 0 by omega] at hc'
  | cons s ρ =>
    obtain ⟨a, b⟩ := s
    rw [colAt_cons_E2, Option.bind_eq_some_iff] at hc'
    obtain ⟨x', hx', hcx⟩ := hc'
    by_cases hab : a = cs.length ∧ P.length ≤ b
    · obtain ⟨rfl, hb⟩ := hab
      have hx'' : x' = (p, Tree.node Fl.cols.dropLast) ∧ N ≠ 0 := by
        simp only [getEnt_E2, List.getElem?_append_right (le_refl _), Nat.sub_self,
          List.getElem?_cons_zero, Option.bind_some, List.getElem?_append_right hb] at hx'
        have hm := List.mem_of_getElem? hx'
        exact ⟨List.eq_of_mem_replicate hm, by rintro rfl; simp at hm⟩
      obtain ⟨rfl, hN⟩ := hx''
      refine ⟨⟨(cs.length, P.length) :: ρ, j⟩, col', ?_, ?_, y', hy', rfl,
        hCe hN ⟨ρ, j⟩ col' hcx y' hy'⟩
      · rw [colAt_cons_E2]
        simp only [getEnt_E2, List.getElem?_append_right (le_refl _), Nat.sub_self,
          List.getElem?_cons_zero, Option.bind_some]
        exact colAt_dropLast_E2 hcx
      · rw [spx_num_cons, spx_num_cons]
    · have e1 : getEnt_E2 (cs ++ [P ++ List.replicate N (p, Tree.node Fl.cols.dropLast)]) a b =
          getEnt_E2 (cs ++ [P]) a b ∧ getEnt_E2 (cs ++ [P ++ [(p, Fl)]]) a b =
          getEnt_E2 (cs ++ [P]) a b := by
        unfold getEnt_E2
        rcases Nat.lt_trichotomy a cs.length with ha | rfl | ha
        · constructor <;> simp [List.getElem?_append_left ha]
        · have hb : b < P.length := by omega
          constructor <;> simp [List.getElem?_append_left hb]
        · simp only [List.getElem?_append_right (show cs.length ≤ a by omega)]
          simp [show a - cs.length ≠ 0 by omega]
      refine ⟨⟨(a, b) :: ρ, j⟩, col', ?_, rfl, y', hy', rfl, hT ⟨(a, b) :: ρ, j⟩ col' ?_ y' hy'⟩
      · rw [colAt_cons_E2, e1.2, ← e1.1, hx']; exact hcx
      · rw [colAt_cons_E2, ← e1.1, hx']; exact hcx


/-! T3.2t helpers (branch E2): decreases of words, the S correspondence. -/

/-- `X'` is a decrease of `X` first changing at `a`: they agree before `a`, and at `a` either `X'`
ends while `X` continues, or the letter of `X'` has a smaller depth `d`. -/
def decAt_E2 {β : Type} (d : β → Nat) (X X' : List β) (a : Nat) : Prop :=
  X'.take a = X.take a ∧ a ≤ X'.length ∧
    ((X'.length = a ∧ a < X.length) ∨ ∃ x x', X[a]? = some x ∧ X'[a]? = some x' ∧ d x' < d x)

theorem lt_of_take_succ_E2 {β : Type} [LinearOrder β] : ∀ {X Y Y' : List β}, X < Y →
    Y'.take (X.length + 1) = Y.take (X.length + 1) → X < Y'
  | [], [], _, h, _ => absurd h (List.not_lt_nil _)
  | [], y :: ys, Y', _, ht => by
    cases Y' with
    | nil => simp at ht
    | cons y' ys' => exact List.nil_lt_cons _ _
  | x :: xs, [], _, h, _ => absurd h (List.not_lt_nil _)
  | x :: xs, y :: ys, Y', h, ht => by
    cases Y' with
    | nil => simp at ht
    | cons y' ys' =>
      simp only [List.length_cons, List.take_succ_cons, List.cons.injEq] at ht
      obtain ⟨rfl, ht⟩ := ht
      rcases List.cons_lt_cons_iff.1 h with h1 | ⟨h1, h2⟩
      · exact List.cons_lt_cons_iff.2 (Or.inl h1)
      · exact List.cons_lt_cons_iff.2 (Or.inr ⟨h1, lt_of_take_succ_E2 h2 ht⟩)

theorem lt_of_decAt_E2 {β : Type} [LinearOrder β] {d : β → Nat}
    (hd : ∀ x y, d x < d y → x < y) (a : Nat) :
    ∀ {X Y X' Y' : List β} {b : Nat}, X < Y → decAt_E2 d X X' a →
      Y'.take b = Y.take b → b ≤ Y'.length → a < b → X' < Y' := by
  induction a with
  | zero =>
    intro X Y X' Y' b hXY hdec hYb hbl hab
    obtain ⟨_, _, hc⟩ := hdec
    obtain ⟨y', ys', rfl⟩ : ∃ y' ys', Y' = y' :: ys' := by
      cases Y' with
      | nil => simp at hbl; omega
      | cons y' ys' => exact ⟨_, _, rfl⟩
    obtain ⟨y, ys, rfl⟩ : ∃ y ys, Y = y :: ys := by
      cases Y with
      | nil => exact absurd hXY (List.not_lt_nil _)
      | cons y ys => exact ⟨_, _, rfl⟩
    have hyy : y' = y := by
      obtain ⟨b', rfl⟩ : ∃ b', b = b' + 1 := ⟨b - 1, by omega⟩
      simp only [List.take_succ_cons, List.cons.injEq] at hYb; exact hYb.1
    subst hyy
    rcases hc with ⟨hl, -⟩ | ⟨x, x', hx, hx', hlt⟩
    · rw [List.length_eq_zero_iff] at hl; subst hl; exact List.nil_lt_cons _ _
    · obtain ⟨xs, rfl⟩ : ∃ xs, X = x :: xs := by
        cases X with
        | nil => simp at hx
        | cons z zs => simp at hx; exact ⟨zs, by rw [hx]⟩
      obtain ⟨xs', rfl⟩ : ∃ xs', X' = x' :: xs' := by
        cases X' with
        | nil => simp at hx'
        | cons z zs => simp at hx'; exact ⟨zs, by rw [hx']⟩
      have hxy : x ≤ y' := by
        rcases List.cons_lt_cons_iff.1 hXY with h1 | ⟨h1, -⟩
        · exact le_of_lt h1
        · exact le_of_eq h1
      exact List.cons_lt_cons_iff.2 (Or.inl (lt_of_lt_of_le (hd _ _ hlt) hxy))
  | succ a ih =>
    intro X Y X' Y' b hXY hdec hYb hbl hab
    obtain ⟨ht, hl, hc⟩ := hdec
    obtain ⟨x', xs', rfl⟩ : ∃ x' xs', X' = x' :: xs' := by
      cases X' with
      | nil => simp at hl
      | cons z zs => exact ⟨_, _, rfl⟩
    obtain ⟨x, xs, rfl⟩ : ∃ x xs, X = x :: xs := by
      cases X with
      | nil =>
        rcases hc with ⟨-, h⟩ | ⟨x, -, h, -⟩
        · simp at h
        · simp at h
      | cons z zs => exact ⟨_, _, rfl⟩
    obtain ⟨y, ys, rfl⟩ : ∃ y ys, Y = y :: ys := by
      cases Y with
      | nil => exact absurd hXY (List.not_lt_nil _)
      | cons y ys => exact ⟨_, _, rfl⟩
    obtain ⟨y', ys', rfl⟩ : ∃ y' ys', Y' = y' :: ys' := by
      cases Y' with
      | nil => simp at hbl; omega
      | cons y' ys' => exact ⟨_, _, rfl⟩
    obtain ⟨b', rfl⟩ : ∃ b', b = b' + 1 := ⟨b - 1, by omega⟩
    simp only [List.take_succ_cons, List.cons.injEq] at ht hYb
    obtain ⟨rfl, ht⟩ := ht
    obtain ⟨rfl, hYb⟩ := hYb
    simp only [List.length_cons, Nat.add_le_add_iff_right] at hl hbl
    have hdec : decAt_E2 d xs xs' a := by
      refine ⟨ht, hl, ?_⟩
      rcases hc with ⟨h1, h2⟩ | ⟨z, z', h1, h2, h3⟩
      · left; simp only [List.length_cons] at h1 h2; omega
      · right; exact ⟨z, z', by simpa using h1, by simpa using h2, h3⟩
    rcases List.cons_lt_cons_iff.1 hXY with h1 | ⟨h1, h2⟩
    · exact List.cons_lt_cons_iff.2 (Or.inl h1)
    · exact List.cons_lt_cons_iff.2 (Or.inr ⟨h1, ih h2 hdec hYb hbl (by omega)⟩)

theorem decAt_map_E2 {β γ : Type} {d : β → Nat} {d' : γ → Nat} {g : β → γ}
    (hg : ∀ x y, d x < d y → d' (g x) < d' (g y)) {X X' : List β} {a : Nat}
    (h : decAt_E2 d X X' a) : decAt_E2 d' (X.map g) (X'.map g) a := by
  obtain ⟨ht, hl, hc⟩ := h
  refine ⟨by rw [← List.map_take, ← List.map_take, ht], by simpa using hl, ?_⟩
  rcases hc with ⟨h1, h2⟩ | ⟨x, x', h1, h2, h3⟩
  · left; simp only [List.length_map]; exact ⟨h1, h2⟩
  · right; exact ⟨g x, g x', by simp [h1], by simp [h2], hg _ _ h3⟩

theorem decAt_append_E2 {β : Type} {d : β → Nat} (pre : List β) {X X' : List β} {a : Nat}
    (h : decAt_E2 d X X' a) : decAt_E2 d (pre ++ X) (pre ++ X') (pre.length + a) := by
  obtain ⟨ht, hl, hc⟩ := h
  refine ⟨?_, by simp only [List.length_append]; omega, ?_⟩
  · rw [List.take_append, List.take_append,
      List.take_of_length_le (by omega : pre.length ≤ pre.length + a), Nat.add_sub_cancel_left, ht]
  · rcases hc with ⟨h1, h2⟩ | ⟨x, x', h1, h2, h3⟩
    · left; simp only [List.length_append]; omega
    · right
      refine ⟨x, x', ?_, ?_, h3⟩
      · rw [List.getElem?_append_right (by omega), Nat.add_sub_cancel_left]; exact h1
      · rw [List.getElem?_append_right (by omega), Nat.add_sub_cancel_left]; exact h2

/-- The depth coordinate of a word atom. -/
def wdep_E2 (A : WordAtom) : Nat := (ofLex A).1

/-- A word atom read in the key word at threshold `b`. -/
def katom_E2 (b : Nat) (A : WordAtom) : GAtom (Lex (Bool × Nat)) := GAtom.map (relLabel b) (toGAtom A)

/-- The depth coordinate of a key-word atom. -/
def gdep_E2 (A : GAtom (Lex (Bool × Nat))) : Nat := (ofLex A).1

/-- The key word of a relative key is a relabelling of the word, keeping depths. -/
theorem gword_relKey_E2 (a : Nat) (H : Forest) :
    @gword (Lex (Bool × Nat)) (relKey a H) = (word H).map (katom_E2 a) := by
  change (gword (relKey a H) : List (GAtom (Bool × Nat))) = _
  rw [relKey_eq_map, gword_map, gword_eq_map_word, List.map_map]; rfl

theorem gatom_lt_of_dep_E2 {α : Type} [LinearOrder α] (x y : GAtom α)
    (h : (ofLex x).1 < (ofLex y).1) : x < y :=
  Prod.Lex.lt_iff.2 (Or.inl h)

/-- The S relation between a new and an old return height. -/
def relS_E2 (a : Nat) (J' J : Forest) : Prop :=
  (J' = J ∧ mu J < a) ∨ ∃ a', a' < a ∧ decAt_E2 wdep_E2 (word J) (word J') a'

/-- The S correspondence between a new and an old height. -/
def corrS_E2 (h' h : Forest) : Prop :=
  ∃ a, decAt_E2 wdep_E2 (word h) (word h') a ∧ entCorr_E2 (relS_E2 a) h' h

/-- The key condition of S. -/
def psiS_E2 (m : Nat) (J : Forest) (n : Nat) (H : Forest) : Prop := relKey m J < relKey n H

theorem condS_iff_ret_E2 (E : Forest) : CondS E ↔ spxAll (retAll_E2 psiS_E2) 0 E :=
  spx_ret_iff_E2 psiS_E2 E

theorem psiS_transfer_E2 {m n a : Nat} {J J' h h' : Forest} (hR : relS_E2 a J' J)
    (hd : decAt_E2 wdep_E2 (word h) (word h') a) (hlt : psiS_E2 m J n h) : psiS_E2 m J' n h' := by
  unfold psiS_E2 at hlt ⊢
  rw [spx_key_lt_iff, gword_relKey_E2, gword_relKey_E2] at hlt ⊢
  have hg : ∀ (b : Nat) (x y : WordAtom), wdep_E2 x < wdep_E2 y →
      gdep_E2 (katom_E2 b x) < gdep_E2 (katom_E2 b y) := fun _ _ _ h => h
  have hdM := decAt_map_E2 (d := wdep_E2) (d' := gdep_E2) (g := katom_E2 n) (hg n) hd
  rcases hR with ⟨hJJ, hJa⟩ | ⟨a', ha', hdJ⟩
  · rw [hJJ]
    apply lt_of_take_succ_E2 hlt
    have h1 := congrArg (List.take ((word J).length + 1)) hdM.1
    simp only [List.length_map]
    rwa [List.take_take, List.take_take, min_eq_left (by unfold mu at hJa; omega)] at h1
  · exact lt_of_decAt_E2 (gatom_lt_of_dep_E2) a' hlt
      (decAt_map_E2 (d := wdep_E2) (d' := gdep_E2) (g := katom_E2 m) (hg m) hdJ) hdM.1 hdM.2.1 ha'

/-! Word lengths. -/

theorem wordAt_length_E2 (e : Nat) (X : Forest) : (wordAt e X).length = mu X := by
  have := wordAt_add 0 e X
  rw [Nat.zero_add] at this
  rw [this, List.length_map]; rfl

theorem wordLater_length_mem_E2 (e : Nat) : ∀ (col : Column) (y : Nat × Forest), y ∈ col →
    mu y.2 < (wordLater e col).length
  | [], y, hy => by simp at hy
  | (p, h) :: rest, y, hy => by
    simp only [wordLater, List.length_cons, List.length_append, wordAt_length_E2]
    rcases List.mem_cons.1 hy with rfl | hy
    · show mu h < _; omega
    · have := wordLater_length_mem_E2 e rest y hy; omega

theorem wordCol_length_mem_E2 (e : Nat) {col : Column} {y : Nat × Forest} (hy : y ∈ col) :
    mu y.2 < (wordCol e col).length := by
  cases col with
  | nil => simp at hy
  | cons x rest =>
    obtain ⟨p, h⟩ := x
    simp only [wordCol, List.length_cons, List.length_append, wordAt_length_E2]
    rcases List.mem_cons.1 hy with rfl | hy
    · show mu h < _; omega
    · have := wordLater_length_mem_E2 e rest y hy; omega

theorem wordCols_length_mem_E2 (e : Nat) : ∀ {cols : List Column} {col : Column}, col ∈ cols →
    (wordCol e col).length ≤ (wordCols e cols).length
  | [], col, h => by simp at h
  | c :: cs, col, h => by
    simp only [wordCols, List.length_append]
    rcases List.mem_cons.1 h with rfl | h
    · omega
    · have := wordCols_length_mem_E2 e h; omega

theorem mu_node_E2 (cols : List Column) : mu (Tree.node cols) = (wordCols 0 cols).length := rfl

/-- Containment: an entry at any depth of `T` has a shorter word. -/
theorem mu_lt_of_colAt_E2 : ∀ (P : List (Nat × Nat)) (T : Forest) (j : Nat) {col : Column}
    {y : Nat × Forest}, T.colAt ⟨P, j⟩ = some col → y ∈ col → mu y.2 < mu T
  | [], .node cols, j, col, y, hc, hy => by
    rw [colAt_nil_E2] at hc
    rw [mu_node_E2]
    have := wordCol_length_mem_E2 0 hy
    have := wordCols_length_mem_E2 0 (List.mem_of_getElem? hc)
    omega
  | (a, b) :: ρ, .node cols, j, col, y, hc, hy => by
    rw [colAt_cons_E2, Option.bind_eq_some_iff] at hc
    obtain ⟨x, hx, hcx⟩ := hc
    have h1 := mu_lt_of_colAt_E2 ρ x.2 j hcx hy
    unfold getEnt_E2 at hx
    rw [Option.bind_eq_some_iff] at hx
    obtain ⟨colA, hA, hb⟩ := hx
    have h2 := mu_lt_of_colAt_E2 [] (Tree.node cols) a (col := colA) (y := x)
      (by rw [colAt_nil_E2]; exact hA) (List.mem_of_getElem? hb)
    omega

theorem allEnt_mu_E2 {T : Forest} {a : Nat} (h : mu T ≤ a) :
    allEnt_E2 (fun J => mu J < a) T := by
  intro c col hc y hy
  obtain ⟨P, j⟩ := c
  have := mu_lt_of_colAt_E2 P T j hc hy
  omega

theorem allEnt_relS_E2 {T : Forest} {a : Nat} (h : mu T ≤ a) :
    allEnt_E2 (fun J => relS_E2 a J J) T := by
  intro c col hc y hy
  exact Or.inl ⟨rfl, allEnt_mu_E2 h c col hc y hy⟩

/-! Words of the route levels. -/

theorem wordLater_append_E2 (e : Nat) : ∀ (l m : Column),
    wordLater e (l ++ m) = wordLater e l ++ wordLater e m
  | [], m => rfl
  | (p, h) :: l, m => by
    simp only [List.cons_append, wordLater, wordLater_append_E2 e l m, List.append_assoc]

theorem wordCol_cons_append_E2 (e : Nat) (x : Nat × Forest) (l m : Column) :
    wordCol e ((x :: l) ++ m) = wordCol e (x :: l) ++ wordLater e m := by
  obtain ⟨p, h⟩ := x
  simp only [List.cons_append, wordCol, wordLater_append_E2, List.append_assoc, List.cons_append]

theorem word_snoc_E2 (ys : List Column) (zs : Column) (q : Nat) (X : Forest) :
    word (Tree.node (ys ++ [zs ++ [(q, X)]])) =
      word (Tree.node (ys ++ [zs ++ [(q, Tree.empty)]])) ++
        (word X).map fun A => toLex ((ofLex A).1 + 2 * 1, (ofLex A).2) := by
  have := wordAt_add 0 1 X
  rw [Nat.zero_add] at this
  simp only [word, wordAt, wordCols_append, wordCols, List.append_nil]
  rw [wordCol_snoc, ← this]
  simp only [List.append_assoc]

theorem word_dropLast_E2 (e : Nat) {F : Forest} (hF : F.cols ≠ []) :
    ∃ last, wordAt e F = wordAt e (Tree.node F.cols.dropLast) ++ wordCol e last := by
  obtain ⟨cols⟩ := F
  simp only [Tree.cols] at hF ⊢
  obtain ⟨L, x, rfl⟩ := (List.eq_nil_or_concat cols).resolve_left hF
  refine ⟨x, ?_⟩
  simp only [wordAt]
  rw [List.concat_eq_append, List.dropLast_concat, wordCols_append]
  simp [wordCols]

theorem wordCol_ne_E2 (e : Nat) (c : Column) : wordCol e c ≠ [] := by
  cases c with
  | nil => simp [wordCol]
  | cons x r => obtain ⟨p, h⟩ := x; simp [wordCol]

theorem wordCol_head_E2 (e : Nat) (c : Column) : ∃ A rest, wordCol e c = A :: rest ∧
    wdep_E2 A = 2 * e := by
  cases c with
  | nil => exact ⟨_, _, rfl, rfl⟩
  | cons x r => obtain ⟨p, h⟩ := x; exact ⟨_, _, rfl, rfl⟩

theorem decAt_dropLast_E2 {F : Forest} (hF : F.cols ≠ []) :
    decAt_E2 wdep_E2 (word F) (word (Tree.node F.cols.dropLast)) (mu (Tree.node F.cols.dropLast)) := by
  obtain ⟨last, hw⟩ := word_dropLast_E2 0 hF
  change decAt_E2 wdep_E2 (wordAt 0 F) (wordAt 0 (Tree.node F.cols.dropLast)) _
  rw [hw]
  have hne := wordCol_ne_E2 0 last
  refine ⟨?_, le_refl _, Or.inl ⟨rfl, ?_⟩⟩
  · rw [List.take_append]; simp [mu, word]
  · simp only [List.length_append]
    have : (wordCol 0 last).length ≠ 0 := by simpa using hne
    change (wordAt 0 _).length < _
    omega

theorem mu_pos_E2 {F : Forest} (hF : F.cols ≠ []) : 0 < mu F := by
  obtain ⟨last, hw⟩ := word_dropLast_E2 0 hF
  have hne := wordCol_ne_E2 0 last
  unfold mu word
  rw [hw, List.length_append]
  have : (wordCol 0 last).length ≠ 0 := by simpa using hne
  omega

/-! The S correspondence: the three closure properties used by `spxAll_replace`. -/

/-- At the copies: `C` against `F`. -/
theorem corrS_dropLast_E2 {F : Forest} (hF : F.cols ≠ []) :
    corrS_E2 (Tree.node F.cols.dropLast) F :=
  ⟨_, decAt_dropLast_E2 hF, entCorr_dropLast_E2 (allEnt_relS_E2 (le_refl _))⟩

theorem retIn_of_corrS_E2 {h' h : Forest} {n : Nat} (hC : corrS_E2 h' h)
    (hR : retIn_E2 psiS_E2 n h) : retIn_E2 psiS_E2 n h' := by
  obtain ⟨a, hd, hE⟩ := hC
  exact retIn_of_entCorr_E2 hE (fun m J' J hr hl => psiS_transfer_E2 hr hd hl) hR

theorem corrS_snoc_E2 (ys : List Column) (zs : Column) (q : Nat) (h h' : Forest)
    (hC : corrS_E2 h' h) :
    corrS_E2 (Tree.node (ys ++ [zs ++ [(q, h')]])) (Tree.node (ys ++ [zs ++ [(q, h)]])) := by
  obtain ⟨a, hd, hE⟩ := hC
  set T : Forest := Tree.node (ys ++ [zs ++ [(q, Tree.empty)]]) with hT
  have hTpos : 0 < mu T := mu_pos_E2 (by simp [hT, Tree.cols])
  refine ⟨mu T + a, ?_, ?_⟩
  · rw [word_snoc_E2 ys zs q h, word_snoc_E2 ys zs q h']
    have := decAt_append_E2 (word T)
      (decAt_map_E2 (d' := wdep_E2) (g := fun A : WordAtom => toLex ((ofLex A).1 + 2 * 1, (ofLex A).2))
        (fun x y h => by unfold wdep_E2 at h ⊢; simp only [ofLex_toLex]; omega) hd)
    exact this
  · refine entCorr_snoc_E2 hE ?_ ?_ (allEnt_relS_E2 (by show mu T ≤ mu T + a; omega))
    · intro J' J hr
      rcases hr with ⟨h1, h2⟩ | ⟨a', h1, h2⟩
      · exact Or.inl ⟨h1, by omega⟩
      · exact Or.inr ⟨a', by omega, h2⟩
    · exact Or.inr ⟨a, by omega, hd⟩

theorem corrS_top_E2 (cs : List Column) {P : Column} {p N : Nat} {Fl : Forest}
    (hFl : Fl.cols ≠ []) (hN : P = [] → 1 ≤ N) :
    corrS_E2 (Tree.node (cs ++ [P ++ List.replicate N (p, Tree.node Fl.cols.dropLast)]))
      (Tree.node (cs ++ [P ++ [(p, Fl)]])) := by
  set C : Forest := Tree.node Fl.cols.dropLast with hC
  have hw : ∀ c : Column, word (Tree.node (cs ++ [c])) = wordCols 0 cs ++ wordCol 0 c := by
    intro c; simp [word, wordAt, wordCols_append, wordCols]
  have hTmu : mu (Tree.node (cs ++ [P])) = (wordCols 0 cs).length + (wordCol 0 P).length := by
    unfold mu; rw [hw, List.length_append]
  cases N with
  | zero =>
    obtain ⟨x, Pt, rfl⟩ : ∃ x Pt, P = x :: Pt := by
      cases P with
      | nil => exact absurd (hN rfl) (by omega)
      | cons x Pt => exact ⟨x, Pt, rfl⟩
    refine ⟨(wordCols 0 cs).length + (wordCol 0 (x :: Pt)).length, ?_, ?_⟩
    · rw [hw, hw, List.replicate_zero, List.append_nil, wordCol_cons_append_E2, ← List.append_assoc]
      refine ⟨?_, by simp, Or.inl ⟨by simp, ?_⟩⟩
      · rw [List.take_append, List.take_append, List.take_of_length_le (by simp),
          List.take_of_length_le (by simp)]
        simp
      · simp [wordLater]
    · refine entCorr_top_E2 (allEnt_relS_E2 (by rw [hTmu])) (fun h => absurd rfl h)
        (fun h => absurd rfl h)
  | succ N =>
    have hrep : P ++ List.replicate (N + 1) (p, C) = (P ++ [(p, C)]) ++ List.replicate N (p, C) := by
      rw [List.replicate_succ, List.append_assoc]; rfl
    obtain ⟨last, hwl⟩ := word_dropLast_E2 1 hFl
    set pre := wordCols 0 cs ++ wordCol 0 (P ++ [(p, Tree.empty)]) ++ wordAt 1 C with hpre
    have hwB : word (Tree.node (cs ++ [P ++ List.replicate (N + 1) (p, C)])) =
        pre ++ wordLater 0 (List.replicate N (p, C)) := by
      rw [hw, hrep]
      obtain ⟨y, ys, hys⟩ : ∃ y ys, P ++ [(p, C)] = y :: ys := by
        cases P with
        | nil => exact ⟨_, _, rfl⟩
        | cons y ys => exact ⟨_, _, rfl⟩
      rw [hys, wordCol_cons_append_E2, ← hys, wordCol_snoc, hpre]
      simp only [List.append_assoc]
    have hwA : word (Tree.node (cs ++ [P ++ [(p, Fl)]])) = pre ++ wordCol 1 last := by
      rw [hw, wordCol_snoc, hwl, hpre]
      simp only [List.append_assoc]; rfl
    have hCpre : mu C + 1 ≤ pre.length := by
      have := wordCol_ne_E2 0 (P ++ [(p, Tree.empty)])
      have : (wordCol 0 (P ++ [(p, Tree.empty)])).length ≠ 0 := by simpa using this
      simp only [hpre, List.length_append, wordAt_length_E2]
      omega
    have hPpre : mu (Tree.node (cs ++ [P])) ≤ pre.length := by
      rw [hTmu]
      have : (wordCol 0 P).length ≤ (wordCol 0 (P ++ [(p, Tree.empty)])).length := by
        cases P with
        | nil => simp [wordCol, wordLater, Tree.empty, wordAt, wordCols]
        | cons y ys => rw [wordCol_cons_append_E2]; simp
      simp only [hpre, List.length_append]
      omega
    refine ⟨pre.length, ?_, ?_⟩
    · rw [hwA, hwB]
      have h0 : decAt_E2 wdep_E2 (wordCol 1 last) (wordLater 0 (List.replicate N (p, C))) 0 := by
        obtain ⟨A, rest, hA, hdA⟩ := wordCol_head_E2 1 last
        refine ⟨by simp, by simp, ?_⟩
        cases N with
        | zero => left; simp [wordLater, hA]
        | succ N =>
          right
          refine ⟨A, _, by rw [hA]; rfl, by rw [List.replicate_succ]; rfl, ?_⟩
          rw [hdA]; simp [wdep_E2]
      have := decAt_append_E2 pre h0
      rwa [Nat.add_zero] at this
    · refine entCorr_top_E2 (allEnt_relS_E2 hPpre) (fun _ => allEnt_relS_E2 (show mu C ≤ _ by omega))
        (fun _ => Or.inr ⟨mu C, by omega, decAt_dropLast_E2 hFl⟩)


theorem retAll_corrS_E2 (n : Nat) (zs : Column) (q : Nat) (h h' : Forest) (hC : corrS_E2 h' h)
    (hφ : retAll_E2 psiS_E2 n (zs ++ [(q, h)])) : retAll_E2 psiS_E2 n (zs ++ [(q, h')]) := by
  intro x hx
  rcases List.mem_append.1 hx with hx | hx
  · exact hφ x (List.mem_append_left _ hx)
  · simp only [List.mem_singleton] at hx; subst hx
    exact retIn_of_corrS_E2 hC (hφ (q, h) (by simp))

-- T3.2t (txt:406-409): special outputs satisfy S, and P when present
theorem condS_special {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .special)
    (hB : expand A n = some B) : CondS B := by
  obtain ⟨π, G, cs, P, p, Fl, N, hrp, hG, hGc, hFl, hN, rfl⟩ := spx_special_shape hL hk hB
  have hS := hL.2.2.2.2
  have hcolA : A.colAt ⟨π, cs.length⟩ = some (P ++ [(p, Fl)]) := by
    simp [Tree.colAt, hG, hGc]
  rw [condS_iff_ret_E2] at hS ⊢
  refine (spxAll_replace (φ := retAll_E2 psiS_E2) corrS_E2 (fun cs' => corrS_top_E2 cs' hFl hN)
    corrS_snoc_E2 retAll_corrS_E2 π A G cs 0 hrp hG hGc hS ?_ ?_).1
  · intro x hx
    rcases spx_mem_special hx with hx | rfl
    · exact hS _ _ hcolA x (List.mem_append_left _ hx)
    · exact retIn_of_corrS_E2 (corrS_dropLast_E2 hFl) (hS _ _ hcolA (p, Fl) (by simp))
  · intro x hx
    rcases spx_mem_special hx with hx | rfl
    · exact spxAll_height hS hcolA x (List.mem_append_left _ hx)
    · exact spxAll_dropLast (spxAll_height hS hcolA (p, Fl) (by simp))

/-! T3.2t helpers (branch E2): the P correspondence. -/

/-- The profile condition of P. -/
def psiP_E2 (_m : Nat) (J : Forest) (_n : Nat) (H : Forest) : Prop := profile J < profile H

/-- The P relation between a new and an old return height. -/
def relP_E2 (J' J : Forest) : Prop := profile J' ≤ profile J

/-- The P correspondence between a new and an old height: the profile does not increase, entries
correspond with nonincreasing profiles, and either the profile is unchanged or every entry of the
new height has a smaller profile (the shortened pure tower). -/
def corrP_E2 (h' h : Forest) : Prop :=
  h'.cols ≠ [] ∧ profile h' ≤ profile h ∧ entCorr_E2 relP_E2 h' h ∧
    (profile h' = profile h ∨ allEnt_E2 (fun J => profile J < profile h') h')

theorem condP_iff_ret_E2 (E : Forest) : CondP E ↔ spxAll (retAll_E2 psiP_E2) 0 E :=
  spx_ret_iff_E2 psiP_E2 E

theorem allEnt_refl_E2 {Rel : Forest → Forest → Prop} (hR : ∀ J, Rel J J) (T : Forest) :
    allEnt_E2 (fun J => Rel J J) T := fun _ _ _ y _ => hR y.2

theorem retIn_of_corrP_E2 {h' h : Forest} {n : Nat} (hC : corrP_E2 h' h)
    (hR : retIn_E2 psiP_E2 n h) : retIn_E2 psiP_E2 n h' := by
  obtain ⟨-, -, hE, heq | htw⟩ := hC
  · exact retIn_of_entCorr_E2 hE
      (fun m J' J hr hl => by unfold psiP_E2 at hl ⊢; rw [heq]; exact lt_of_le_of_lt hr hl) hR
  · exact retIn_of_allEnt_E2 (fun c col hc y hy m => htw c col hc y hy)

theorem profile_some_E2 {F : Forest} (h : F.cols ≠ []) :
    profile F = ((profileAux 0 F : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat)) := by
  rw [spx_eta F, spx_profile_node h]

theorem profile_nil_E2 {F : Forest} (h : F.cols = []) : profile F = ⊥ := by
  rw [spx_eta F, h]; rfl

theorem profileAux_first_E2 (d : Nat) (c : Column) (r1 r2 : List Column) :
    profileAux d (Tree.node (c :: r1)) = profileAux d (Tree.node (c :: r2)) := by
  cases c with
  | nil => simp [profileAux]
  | cons x rest => obtain ⟨p, ⟨hc⟩⟩ := x; cases hc <;> simp [profileAux]

theorem profile_first_E2 (c : Column) (r1 r2 : List Column) :
    profile (Tree.node (c :: r1)) = profile (Tree.node (c :: r2)) := by
  rw [spx_profile_node (by simp), spx_profile_node (by simp), profileAux_first_E2 0 c r1 r2]

theorem takeWhile_fst_E2 (p : Nat) : ∀ (r1 r2 : Column), r1.map Prod.fst = r2.map Prod.fst →
    (r1.takeWhile fun x => x.1 == p).length = (r2.takeWhile fun x => x.1 == p).length
  | [], [], _ => rfl
  | [], _ :: _, h => by simp at h
  | _ :: _, [], h => by simp at h
  | x :: xs, y :: ys, h => by
    simp only [List.map_cons, List.cons.injEq] at h
    simp only [List.takeWhile_cons, h.1]
    split_ifs
    · simp only [List.length_cons]; rw [takeWhile_fst_E2 p xs ys h.2]
    · rfl

theorem profileAux_parents_E2 (d p0 : Nat) (h0 : Forest) {r1 r2 : Column}
    (hr : r1.map Prod.fst = r2.map Prod.fst) (t1 t2 : List Column) :
    profileAux d (Tree.node (((p0, h0) :: r1) :: t1)) =
      profileAux d (Tree.node (((p0, h0) :: r2) :: t2)) := by
  obtain ⟨hc⟩ := h0
  cases hc with
  | nil => simp only [profileAux]; rw [takeWhile_fst_E2 p0 r1 r2 hr]
  | cons y ys => simp [profileAux]

theorem profile_single_E2 (q : Nat) {X : Forest} (hX : X.cols ≠ []) :
    profile (Tree.node [[(q, X)]]) =
      ((toLex ((ofLex (profileAux 0 X)).1 + 1, (ofLex (profileAux 0 X)).2) : Nat ×ₗ Nat) :
        WithBot (Nat ×ₗ Nat)) := by
  rw [spx_profile_node (by simp), spx_profileAux_cons 0 q hX, spx_profileAux_one]

theorem lex_shift_le_E2 {u v : Nat ×ₗ Nat} (h : u ≤ v) :
    (toLex ((ofLex u).1 + 1, (ofLex u).2) : Nat ×ₗ Nat) ≤ toLex ((ofLex v).1 + 1, (ofLex v).2) := by
  rw [Prod.Lex.le_iff] at h
  rw [Prod.Lex.toLex_le_toLex]
  rcases h with h | ⟨h1, h2⟩
  · left; simp only; omega
  · right; exact ⟨by simp only; omega, h2⟩

theorem lex_lt_shift_E2 (u : Nat ×ₗ Nat) :
    u < (toLex ((ofLex u).1 + 1, (ofLex u).2) : Nat ×ₗ Nat) := by
  rw [Prod.Lex.lt_iff]; left; simp

theorem allEnt_single_E2 {Q : Forest → Prop} {q : Nat} {h : Forest} (hh : Q h)
    (hA : allEnt_E2 Q h) : allEnt_E2 Q (Tree.node [[(q, h)]]) := by
  intro c col hc y hy
  obtain ⟨P, j⟩ := c
  cases P with
  | nil =>
    rw [colAt_nil_E2] at hc
    cases j with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.some.injEq] at hc
      subst hc
      simp only [List.mem_singleton] at hy; subst hy; exact hh
    | succ j => simp at hc
  | cons s ρ =>
    obtain ⟨a, b⟩ := s
    rw [colAt_cons_E2, Option.bind_eq_some_iff] at hc
    obtain ⟨x, hx, hcx⟩ := hc
    have : x = (q, h) := by
      unfold getEnt_E2 at hx
      cases a with
      | zero =>
        cases b with
        | zero => simpa using hx.symm
        | succ b => simp at hx
      | succ a => simp at hx
    subst this
    exact hA _ _ hcx y hy

theorem corrP_snoc_E2 (ys : List Column) (zs : Column) (q : Nat) (h h' : Forest)
    (hC : corrP_E2 h' h) :
    corrP_E2 (Tree.node (ys ++ [zs ++ [(q, h')]])) (Tree.node (ys ++ [zs ++ [(q, h)]])) := by
  obtain ⟨hne, hle, hE, hdisj⟩ := hC
  have hhne : h.cols ≠ [] := by
    intro h0
    rw [profile_nil_E2 h0, profile_some_E2 hne] at hle
    exact absurd hle (not_le.2 (WithBot.bot_lt_coe _))
  have hEc : entCorr_E2 relP_E2 (Tree.node (ys ++ [zs ++ [(q, h')]]))
      (Tree.node (ys ++ [zs ++ [(q, h)]])) :=
    entCorr_snoc_E2 hE (fun _ _ h => h) hle (allEnt_refl_E2 (fun J => le_refl (profile J)) _)
  have hsame : ¬ (ys = [] ∧ zs = []) → profile (Tree.node (ys ++ [zs ++ [(q, h')]])) =
      profile (Tree.node (ys ++ [zs ++ [(q, h)]])) := by
    intro hyz
    cases ys with
    | cons y ys => exact profile_first_E2 y _ _
    | nil =>
      cases zs with
      | nil => exact absurd ⟨rfl, rfl⟩ hyz
      | cons z zs =>
        obtain ⟨p0, h0⟩ := z
        simp only [List.nil_append, List.cons_append]
        rw [spx_profile_node (by simp), spx_profile_node (by simp),
          profileAux_parents_E2 0 p0 h0 (r1 := zs ++ [(q, h')]) (r2 := zs ++ [(q, h)]) (by simp)]
  refine ⟨by simp [Tree.cols], ?_, hEc, ?_⟩
  · by_cases hyz : ys = [] ∧ zs = []
    · obtain ⟨rfl, rfl⟩ := hyz
      simp only [List.nil_append]
      rw [profile_single_E2 q hne, profile_single_E2 q hhne, WithBot.coe_le_coe]
      rw [profile_some_E2 hne, profile_some_E2 hhne, WithBot.coe_le_coe] at hle
      exact lex_shift_le_E2 hle
    · rw [hsame hyz]
  · by_cases hyz : ys = [] ∧ zs = []
    · obtain ⟨rfl, rfl⟩ := hyz
      simp only [List.nil_append]
      rcases hdisj with heq | htw
      · left
        rw [profile_some_E2 hne, profile_some_E2 hhne, WithBot.coe_inj] at heq
        rw [profile_single_E2 q hne, profile_single_E2 q hhne, heq]
      · right
        have hlt : profile h' < profile (Tree.node [[(q, h')]]) := by
          rw [profile_single_E2 q hne, profile_some_E2 hne, WithBot.coe_lt_coe]
          exact lex_lt_shift_E2 _
        refine allEnt_single_E2 hlt ?_
        intro c col hc y hy
        exact lt_trans (htw c col hc y hy) hlt
    · left; exact hsame hyz

theorem dropLast_first_E2 {l : List Column} (h : l.dropLast ≠ []) :
    ∃ c0 r1 r2, l = c0 :: r1 ∧ l.dropLast = c0 :: r2 := by
  cases l with
  | nil => simp at h
  | cons c0 r1 =>
    cases r1 with
    | nil => simp at h
    | cons x xs => exact ⟨c0, x :: xs, (x :: xs).dropLast, rfl, List.dropLast_cons_of_ne_nil (by simp)⟩

theorem profile_dropLast_E2 {F : Forest} (h : F.cols.dropLast ≠ []) :
    profile (Tree.node F.cols.dropLast) = profile F := by
  obtain ⟨c0, r1, r2, h1, h2⟩ := dropLast_first_E2 h
  rw [h2, spx_eta F, h1]
  exact profile_first_E2 c0 r2 r1

theorem profile_dropLast_le_E2 (F : Forest) : profile (Tree.node F.cols.dropLast) ≤ profile F := by
  by_cases h : F.cols.dropLast = []
  · rw [profile_nil_E2 (show (Tree.node F.cols.dropLast).cols = [] from h)]; exact bot_le
  · rw [profile_dropLast_E2 h]

theorem retIn_copyP_E2 {F : Forest} {n : Nat} (hR : retIn_E2 psiP_E2 n F) :
    retIn_E2 psiP_E2 n (Tree.node F.cols.dropLast) := by
  by_cases h : F.cols.dropLast = []
  · intro c col hc
    rw [h, show (Tree.node [] : Forest) = Tree.empty from rfl, spx_colAt_empty] at hc
    cases hc
  · refine retIn_of_entCorr_E2 (entCorr_dropLast_E2 (allEnt_refl_E2 (Rel := relP_E2)
      (fun J => le_refl (profile J)) _)) (fun m J' J hr hl => ?_) hR
    unfold psiP_E2 at hl ⊢
    rw [profile_dropLast_E2 h]
    exact lt_of_le_of_lt hr hl

theorem corrP_top_E2 (cs : List Column) {P : Column} {p N : Nat} {Fl : Forest}
    (hFl : Fl.cols ≠ []) (hN : P = [] → 1 ≤ N) (hnon : spxNoninc (P ++ [(p, Fl)])) :
    corrP_E2 (Tree.node (cs ++ [P ++ List.replicate N (p, Tree.node Fl.cols.dropLast)]))
      (Tree.node (cs ++ [P ++ [(p, Fl)]])) := by
  set C : Forest := Tree.node Fl.cols.dropLast with hC
  have hEc := entCorr_top_E2 (Rel := relP_E2) (cs := cs) (P := P) (p := p) (N := N) (Fl := Fl)
    (allEnt_refl_E2 (fun J => le_refl (profile J)) _)
    (fun _ => allEnt_refl_E2 (fun J => le_refl (profile J)) _)
    (fun _ => profile_dropLast_le_E2 Fl)
  -- the profile is unchanged, or the tower case
  have key : profile (Tree.node (cs ++ [P ++ List.replicate N (p, C)])) =
      profile (Tree.node (cs ++ [P ++ [(p, Fl)]])) ∨
      (profile (Tree.node (cs ++ [P ++ List.replicate N (p, C)])) <
        profile (Tree.node (cs ++ [P ++ [(p, Fl)]])) ∧
        allEnt_E2 (fun J => profile J < profile (Tree.node (cs ++ [P ++ List.replicate N (p, C)])))
          (Tree.node (cs ++ [P ++ List.replicate N (p, C)]))) := by
    cases cs with
    | cons c0 cs => left; exact profile_first_E2 c0 _ _
    | nil =>
      simp only [List.nil_append]
      cases P with
      | cons x Pt =>
        left
        obtain ⟨p0, h0⟩ := x
        by_cases h0e : h0.cols = []
        · have h0E : h0 = Tree.node [] := by rw [spx_eta h0, h0e]
          subst h0E
          simp only [List.cons_append]
          rw [spx_profile_node (by simp), spx_profile_node (by simp)]
          congr 1
          simp only [profileAux]
          congr 3
          rw [List.takeWhile_append, List.takeWhile_append]
          split_ifs with hall
          · have hpp : p ≠ p0 := by
              intro hpp
              have hrun := spx_run_empty p0 (Pt ++ [(p, Fl)]) hnon
              have hmem : (p, Fl) ∈ (Pt ++ [(p, Fl)]).takeWhile (fun x => x.1 == p0) := by
                rw [List.takeWhile_append, if_pos hall]; simp [hpp]
              have := hrun _ hmem
              simp only [Prod.mk.injEq] at this
              exact hFl (by rw [this.2]; rfl)
            have e1 : ([(p, Fl)] : Column).takeWhile (fun x => x.1 == p0) = [] := by simp [hpp]
            have e2 : (List.replicate N (p, C)).takeWhile (fun x => x.1 == p0) = [] := by
              cases N with
              | zero => rfl
              | succ N => simp [List.replicate_succ, hpp]
            rw [e1, e2]
          · rfl
        · rw [spx_profile_node (by simp), spx_profile_node (by simp)]
          simp only [List.cons_append]
          rw [spx_profileAux_cons 0 p0 h0e, spx_profileAux_cons 0 p0 h0e]
      | nil =>
        obtain ⟨N', rfl⟩ : ∃ N', N = N' + 1 := ⟨N - 1, by have := hN rfl; omega⟩
        simp only [List.nil_append, List.replicate_succ]
        rw [profile_single_E2 p hFl]
        by_cases hCe : C.cols = []
        · right
          have hC0 : C = Tree.node [] := by rw [spx_eta C, hCe]
          rw [spx_profile_node (by simp)]
          have hlt : ((profileAux 0 (Tree.node [(p, C) :: List.replicate N' (p, C)]) : Nat ×ₗ Nat) :
              WithBot (Nat ×ₗ Nat)) <
              ((toLex ((ofLex (profileAux 0 Fl)).1 + 1, (ofLex (profileAux 0 Fl)).2) : Nat ×ₗ Nat) :
                WithBot (Nat ×ₗ Nat)) := by
            rw [WithBot.coe_lt_coe, hC0]
            simp only [profileAux]
            rw [Prod.Lex.lt_iff]; left; simp
          refine ⟨hlt, ?_⟩
          intro c col hc y hy
          obtain ⟨Pa, j⟩ := c
          cases Pa with
          | nil =>
            rw [colAt_nil_E2] at hc
            cases j with
            | zero =>
              simp only [List.getElem?_cons_zero, Option.some.injEq] at hc
              subst hc
              have hy' : y = (p, C) := by
                rcases List.mem_cons.1 hy with h | h
                · exact h
                · exact List.eq_of_mem_replicate h
              rw [hy', profile_nil_E2 hCe]
              exact WithBot.bot_lt_coe _
            | succ j => simp at hc
          | cons s ρ =>
            obtain ⟨a, b⟩ := s
            rw [colAt_cons_E2, Option.bind_eq_some_iff] at hc
            obtain ⟨x, hx, hcx⟩ := hc
            have hx2 : x.2 = C := by
              unfold getEnt_E2 at hx
              cases a with
              | zero =>
                simp only [List.getElem?_cons_zero, Option.bind_some] at hx
                have := List.mem_of_getElem? hx
                rcases List.mem_cons.1 this with h | h
                · rw [h]
                · rw [List.eq_of_mem_replicate h]
              | succ a => simp at hx
            rw [hx2, hC0, show (Tree.node [] : Forest) = Tree.empty from rfl, spx_colAt_empty] at hcx
            cases hcx
        · left
          rw [spx_profile_node (by simp), spx_profileAux_cons 0 p hCe, spx_profileAux_one]
          obtain ⟨c0, r1, r2, h1, h2⟩ := dropLast_first_E2 (l := Fl.cols) hCe
          have : profileAux 0 C = profileAux 0 Fl := by
            rw [hC, h2, spx_eta Fl, h1]; exact profileAux_first_E2 0 c0 r2 r1
          rw [this]
  refine ⟨by simp [Tree.cols], ?_, hEc, ?_⟩
  · rcases key with h | ⟨h, -⟩
    · rw [h]
    · exact le_of_lt h
  · rcases key with h | ⟨-, h⟩
    · left; exact h
    · right; exact h

theorem retAll_corrP_E2 (n : Nat) (zs : Column) (q : Nat) (h h' : Forest) (hC : corrP_E2 h' h)
    (hφ : retAll_E2 psiP_E2 n (zs ++ [(q, h)])) : retAll_E2 psiP_E2 n (zs ++ [(q, h')]) := by
  intro x hx
  rcases List.mem_append.1 hx with hx | hx
  · exact hφ x (List.mem_append_left _ hx)
  · simp only [List.mem_singleton] at hx; subst hx
    exact retIn_of_corrP_E2 hC (hφ (q, h) (by simp))

theorem condP_special {A B : Forest} {n : Nat} (hL : InL A) (hP : CondP A)
    (hk : stepKind A = some .special) (hB : expand A n = some B) : CondP B := by
  obtain ⟨π, G, cs, P, p, Fl, N, hrp, hG, hGc, hFl, hN, rfl⟩ := spx_special_shape hL hk hB
  have hcolA : A.colAt ⟨π, cs.length⟩ = some (P ++ [(p, Fl)]) := by
    simp [Tree.colAt, hG, hGc]
  have hnon : spxNoninc (P ++ [(p, Fl)]) := spx_condH_col hL.2.2.1 hcolA
  rw [condP_iff_ret_E2] at hP ⊢
  refine (spxAll_replace (φ := retAll_E2 psiP_E2) corrP_E2
    (fun cs' => corrP_top_E2 cs' hFl hN hnon)
    corrP_snoc_E2 retAll_corrP_E2 π A G cs 0 hrp hG hGc hP ?_ ?_).1
  · intro x hx
    rcases spx_mem_special hx with hx | rfl
    · exact hP _ _ hcolA x (List.mem_append_left _ hx)
    · exact retIn_copyP_E2 (hP _ _ hcolA (p, Fl) (by simp))
  · intro x hx
    rcases spx_mem_special hx with hx | rfl
    · exact spxAll_height hP hcolA x (List.mem_append_left _ hx)
    · exact spxAll_dropLast (spxAll_height hP hcolA (p, Fl) (by simp))

/-! T3.2u helpers (branch E2): addresses of a special output read in the input. -/

/-- The address map of a special output into its input: a path through the `i`-th entry
(`i ≥ i0`) of column `j0` at the end of the route path `π` (a copy) goes through entry `i0`. -/
def projP_E2 (j0 i0 : Nat) : List (Nat × Nat) → List (Nat × Nat) → List (Nat × Nat)
  | [], [] => []
  | [], (a, i) :: ρ => if a = j0 ∧ i0 ≤ i then (j0, i0) :: ρ else (a, i) :: ρ
  | _ :: _, [] => []
  | s :: π, x :: σ => if x = s then x :: projP_E2 j0 i0 π σ else x :: σ

theorem projP_fst_E2 (j0 i0 : Nat) : ∀ (π σ : List (Nat × Nat)),
    (projP_E2 j0 i0 π σ).map Prod.fst = σ.map Prod.fst
  | [], [] => rfl
  | [], (a, i) :: ρ => by
    simp only [projP_E2]; split_ifs with h
    · simp [h.1]
    · rfl
  | _ :: _, [] => rfl
  | s :: π, x :: σ => by
    simp only [projP_E2]; split_ifs
    · simp [projP_fst_E2 j0 i0 π σ]
    · rfl

theorem projP_length_E2 (j0 i0 : Nat) (π σ : List (Nat × Nat)) :
    (projP_E2 j0 i0 π σ).length = σ.length := by
  have := congrArg List.length (projP_fst_E2 j0 i0 π σ)
  simpa using this

theorem projP_nil_E2 (j0 i0 : Nat) (π : List (Nat × Nat)) : projP_E2 j0 i0 π [] = [] := by
  cases π <;> rfl

theorem projP_take_E2 (j0 i0 : Nat) : ∀ (π σ : List (Nat × Nat)) (k : Nat),
    (projP_E2 j0 i0 π σ).take k = projP_E2 j0 i0 π (σ.take k)
  | π, [], k => by simp [projP_nil_E2]
  | π, x :: σ, 0 => by simp [projP_nil_E2]
  | [], (a, i) :: ρ, k + 1 => by
    by_cases h : a = j0 ∧ i0 ≤ i <;> simp [projP_E2, h]
  | s :: π, x :: σ, k + 1 => by
    by_cases hx : x = s
    · simp [projP_E2, hx, projP_take_E2 j0 i0 π σ k]
    · simp [projP_E2, hx]

theorem projP_prefix_E2 (j0 i0 : Nat) (π : List (Nat × Nat)) {τ σ : List (Nat × Nat)}
    (h : τ <+: σ) : projP_E2 j0 i0 π τ <+: projP_E2 j0 i0 π σ := by
  obtain ⟨t, rfl⟩ := h
  have := projP_take_E2 j0 i0 π (τ ++ t) τ.length
  rw [List.take_left' rfl] at this
  rw [← this]
  exact List.take_prefix _ _

theorem projP_getElem_fst_E2 (j0 i0 : Nat) (π σ : List (Nat × Nat)) (k : Nat) :
    ((projP_E2 j0 i0 π σ)[k]?).map Prod.fst = (σ[k]?).map Prod.fst := by
  rw [← List.getElem?_map, ← List.getElem?_map, projP_fst_E2]

/-- The entry index map: copies of the owner column go to the replaced entry. -/
def projI_E2 (π : List (Nat × Nat)) (j0 i0 : Nat) (e : EntryAddr) : Nat :=
  if e.col.path = π ∧ e.col.col = j0 ∧ i0 ≤ e.idx then i0 else e.idx

theorem projP_snoc_E2 (j0 i0 : Nat) : ∀ (π path : List (Nat × Nat)) (cc idx : Nat),
    projP_E2 j0 i0 π (path ++ [(cc, idx)]) =
      projP_E2 j0 i0 π path ++
        [(cc, if path = π ∧ cc = j0 ∧ i0 ≤ idx then i0 else idx)]
  | [], [], cc, idx => by
    by_cases h : cc = j0 ∧ i0 ≤ idx
    · simp [projP_E2, h, h.1]
    · simp [projP_E2, h]
  | [], (a, i) :: ρ, cc, idx => by
    by_cases h : a = j0 ∧ i0 ≤ i <;> simp [projP_E2, h]
  | s :: π, [], cc, idx => by
    by_cases h : (cc, idx) = s <;> simp [projP_E2, h, projP_nil_E2]
  | s :: π, x :: path, cc, idx => by
    by_cases hx : x = s
    · subst hx; simp [projP_E2, projP_snoc_E2 j0 i0 π path cc idx]
    · simp [projP_E2, hx]

/-- Column addresses read in the input. -/
def projC_E2 (π : List (Nat × Nat)) (j0 i0 : Nat) (c : ColAddr) : ColAddr :=
  ⟨projP_E2 j0 i0 π c.path, c.col⟩

/-- Entry addresses read in the input. -/
def projE_E2 (π : List (Nat × Nat)) (j0 i0 : Nat) (e : EntryAddr) : EntryAddr :=
  ⟨projC_E2 π j0 i0 e.col, projI_E2 π j0 i0 e⟩

theorem projE_heightPath_E2 (π : List (Nat × Nat)) (j0 i0 : Nat) (e : EntryAddr) :
    (projE_E2 π j0 i0 e).heightPath = projP_E2 j0 i0 π e.heightPath := by
  simp only [EntryAddr.heightPath, projE_E2, projC_E2, projI_E2]
  rw [projP_snoc_E2]

theorem projE_contains_E2 (π : List (Nat × Nat)) (j0 i0 : Nat) {e : EntryAddr} {c : ColAddr}
    (h : e.Contains c) : (projE_E2 π j0 i0 e).Contains (projC_E2 π j0 i0 c) := by
  unfold EntryAddr.Contains at h ⊢
  rw [projE_heightPath_E2]
  exact projP_prefix_E2 j0 i0 π h

theorem projC_num_E2 (π : List (Nat × Nat)) (j0 i0 : Nat) (b : Nat) (c : ColAddr) :
    (projC_E2 π j0 i0 c).num b = c.num b := by
  simp only [ColAddr.num, projC_E2]
  have := projP_fst_E2 j0 i0 π c.path
  have h2 : ((projP_E2 j0 i0 π c.path).map (·.1 + 1)) = (c.path.map (·.1 + 1)) := by
    have e1 : (projP_E2 j0 i0 π c.path).map (·.1 + 1) =
        ((projP_E2 j0 i0 π c.path).map Prod.fst).map (· + 1) := by simp
    have e2 : c.path.map (·.1 + 1) = (c.path.map Prod.fst).map (· + 1) := by simp
    rw [e1, e2, this]
  rw [h2]

theorem projC_resolve_E2 (π : List (Nat × Nat)) (j0 i0 : Nat) {c o : ColAddr} {z : Nat}
    (h : c.resolve 0 z = some o) :
    (projC_E2 π j0 i0 c).resolve 0 z = some (projC_E2 π j0 i0 o) := by
  obtain ⟨hs, hn⟩ := (ColAddr.resolve_spec 0 c o z).1 h
  refine (ColAddr.resolve_spec 0 _ _ z).2 ⟨?_, by rw [projC_num_E2]; exact hn⟩
  rcases hs with ⟨k, ck, ik, hk, hp, hc⟩ | ⟨hp, hc⟩
  · have hk' := projP_getElem_fst_E2 j0 i0 π c.path k
    rw [hk] at hk'
    obtain ⟨⟨ck', ik'⟩, hk'', hck⟩ := Option.map_eq_some_iff.1 hk'
    simp only at hck
    subst hck
    refine Or.inl ⟨k, ck', ik', hk'', ?_, hc⟩
    simp only [projC_E2]
    rw [hp, projP_take_E2]
  · exact Or.inr ⟨by simp only [projC_E2]; rw [hp], hc⟩

/-- A column on the route path `π` above its end: the last column at depth `d < |π|`. -/
def isCont_E2 (π σ : List (Nat × Nat)) (j : Nat) : Prop :=
  ∃ d < π.length, σ = π.take d ∧ ∃ e, π[d]? = some (j, e)

theorem lastStep_snoc_E2 (ys : List Column) (zs : Column) (q : Nat) (h : Forest) :
    (Tree.node (ys ++ [zs ++ [(q, h)]])).lastStep? = some (ys.length, zs.length) := by
  simp [Tree.lastStep?, Tree.cols]

/-- The route of a special output still reaches the owner column. -/
theorem route_replace_E2 {c' : Column} (cs : List Column) {col : Column} :
    ∀ (π : List (Nat × Nat)) (F G : Forest), IsRoutePath F π → F.forestAt π = some G →
      G.cols = cs ++ [col] →
      IsRoutePath (replaceAt 0 0 (Tree.node [c']) π.length F) π ∧
        (replaceAt 0 0 (Tree.node [c']) π.length F).forestAt π = some (Tree.node (cs ++ [c']))
  | [], F, G, hr, hG, hGc => by
    simp only [Tree.forestAt, Option.some.injEq] at hG
    subst hG
    obtain ⟨cols⟩ := F
    simp only [Tree.cols] at hGc
    subst hGc
    simp only [List.length_nil, spx_replaceAt_zero, Tree.cols, Tree.forestAt]
    exact ⟨fun d hd => absurd hd (Nat.not_lt_zero _), trivial⟩
  | s :: π, .node cols, G, hr, hG, hGc => by
    obtain ⟨hl, h, hh, hr'⟩ := Scan.isRoutePath_cons.1 hr
    obtain ⟨colL, q, h₀, hcol, hcl, hs, hh'⟩ := lastStep?_eq_some hl
    rw [hh] at hh'
    cases hh'
    have hG' : h.forestAt π = some G := by
      rw [show s :: π = [s] ++ π from rfl, Tree.forestAt_append, hh] at hG
      exact hG
    simp only [Tree.cols] at hcol hs
    obtain ⟨ys, rfl⟩ := List.getLast?_eq_some_iff.1 hcol
    obtain ⟨zs, rfl⟩ := List.getLast?_eq_some_iff.1 hcl
    subst hs
    simp only [List.length_append, List.length_singleton, Nat.add_sub_cancel]
    rw [List.length_cons, spx_replaceAt_succ]
    obtain ⟨ih1, ih2⟩ := route_replace_E2 cs π h G hr' hG' hGc
    have hstep : (Tree.node (ys ++ [zs ++ [(q, replaceAt 0 0 (Tree.node [c']) π.length h)]])).forestAt
        [(ys.length, zs.length)] = some (replaceAt 0 0 (Tree.node [c']) π.length h) := by
      rw [Tree.forestAt_cons]; simp [Tree.cols, Tree.forestAt]
    refine ⟨Scan.isRoutePath_cons.2 ⟨lastStep_snoc_E2 _ _ _ _, _, hstep, ih1⟩, ?_⟩
    rw [show (ys.length, zs.length) :: π = [(ys.length, zs.length)] ++ π from rfl,
      Tree.forestAt_append, hstep]
    exact ih2

theorem isRoutePath_take_E2 {E : Forest} {π : List (Nat × Nat)} (h : IsRoutePath E π) (k : Nat) :
    IsRoutePath E (π.take k) := by
  intro d hd
  have hd' : d < π.length := by simp at hd; omega
  obtain ⟨F, hF, hl⟩ := h d hd'
  refine ⟨F, ?_, ?_⟩
  · rw [List.take_take, Nat.min_eq_left (by simp at hd; omega)]; exact hF
  · rw [List.getElem?_take, if_pos (by simp at hd; omega)]; exact hl

theorem mem_routeCols_cont_E2 {E : Forest} {π σ : List (Nat × Nat)} {j : Nat}
    (h : IsRoutePath E π) (hc : isCont_E2 π σ j) : (⟨σ, j⟩ : ColAddr) ∈ routeCols E := by
  obtain ⟨d, hd, rfl, e, he⟩ := hc
  rw [mem_routeCols_iff]
  refine ⟨isRoutePath_take_E2 h d, ?_⟩
  obtain ⟨F, hF, hl⟩ := h d hd
  rw [he] at hl
  obtain ⟨col, q, h', hcol, -, hs, -⟩ := lastStep?_eq_some hl
  simp only [Prod.mk.injEq] at hs
  have hne : F.cols ≠ [] := by intro h0; rw [h0] at hcol; simp at hcol
  have : 0 < F.cols.length := List.length_pos_of_ne_nil hne
  refine ⟨F, hF, ?_⟩
  show F.cols.length = j + 1
  omega

theorem mem_routeCols_end_E2 {E : Forest} {π : List (Nat × Nat)} (h : IsRoutePath E π)
    {cs : List Column} {c' : Column} (hG : E.forestAt π = some (Tree.node (cs ++ [c']))) :
    (⟨π, cs.length⟩ : ColAddr) ∈ routeCols E := by
  rw [mem_routeCols_iff]
  exact ⟨h, _, hG, by simp [Tree.cols]⟩

/-- The columns of a special output, read in the input: the owner column, a route container
(the same column but the last height), or the same column. -/
theorem colAt_corr_E2 {P : Column} {p N : Nat} {Fl : Forest} (cs : List Column) :
    ∀ (π : List (Nat × Nat)) (F G : Forest), IsRoutePath F π → F.forestAt π = some G →
      G.cols = cs ++ [P ++ [(p, Fl)]] → ∀ (σ : List (Nat × Nat)) (j : Nat) (col' : Column),
      (replaceAt 0 0 (Tree.node [P ++ List.replicate N (p, Tree.node Fl.cols.dropLast)]) π.length
        F).colAt ⟨σ, j⟩ = some col' →
      ∃ colA, F.colAt ⟨projP_E2 cs.length P.length π σ, j⟩ = some colA ∧
        ((σ = π ∧ j = cs.length ∧ col' = P ++ List.replicate N (p, Tree.node Fl.cols.dropLast) ∧
            colA = P ++ [(p, Fl)]) ∨
          (isCont_E2 π σ j ∧ col'.dropLast = colA.dropLast ∧
            col'.map Prod.fst = colA.map Prod.fst) ∨
          (¬ (σ = π ∧ j = cs.length) ∧ col' = colA))
  | [], F, G, hr, hG, hGc, σ, j, col', hc' => by
    simp only [Tree.forestAt, Option.some.injEq] at hG
    subst hG
    obtain ⟨cols⟩ := F
    simp only [Tree.cols] at hGc
    subst hGc
    rw [List.length_nil, spx_replaceAt_zero] at hc'
    change (Tree.node (cs ++ [P ++ List.replicate N (p, Tree.node Fl.cols.dropLast)])).colAt
      ⟨σ, j⟩ = some col' at hc'
    cases σ with
    | nil =>
      rw [show projP_E2 cs.length P.length [] [] = [] from rfl]
      rw [colAt_nil_E2] at hc' ⊢
      rcases Nat.lt_trichotomy j cs.length with hj | rfl | hj
      · rw [List.getElem?_append_left hj] at hc' ⊢
        exact ⟨col', hc', Or.inr (Or.inr ⟨fun h => by omega, rfl⟩)⟩
      · rw [List.getElem?_append_right (le_refl _), Nat.sub_self, List.getElem?_cons_zero,
          Option.some.injEq] at hc'
        refine ⟨P ++ [(p, Fl)], by simp, Or.inl ⟨rfl, rfl, hc'.symm, rfl⟩⟩
      · rw [List.getElem?_append_right (by omega)] at hc'
        simp [show j - cs.length ≠ 0 by omega] at hc'
    | cons s ρ =>
      obtain ⟨a, b⟩ := s
      rw [colAt_cons_E2, Option.bind_eq_some_iff] at hc'
      obtain ⟨x', hx', hcx⟩ := hc'
      simp only [projP_E2]
      split_ifs with hab
      · obtain ⟨rfl, hb⟩ := hab
        have hx'' : x' = (p, Tree.node Fl.cols.dropLast) := by
          simp only [getEnt_E2, List.getElem?_append_right (le_refl _), Nat.sub_self,
            List.getElem?_cons_zero, Option.bind_some, List.getElem?_append_right hb] at hx'
          exact List.eq_of_mem_replicate (List.mem_of_getElem? hx')
        subst hx''
        refine ⟨col', ?_, Or.inr (Or.inr ⟨fun h => by simp at h, rfl⟩)⟩
        rw [colAt_cons_E2]
        simp only [getEnt_E2, List.getElem?_append_right (le_refl _), Nat.sub_self,
          List.getElem?_cons_zero, Option.bind_some]
        exact colAt_dropLast_E2 hcx
      · have e1 : getEnt_E2 (cs ++ [P ++ List.replicate N (p, Tree.node Fl.cols.dropLast)]) a b =
            getEnt_E2 (cs ++ [P ++ [(p, Fl)]]) a b := by
          unfold getEnt_E2
          rcases Nat.lt_trichotomy a cs.length with ha | rfl | ha
          · simp only [List.getElem?_append_left ha]
          · have hb : b < P.length := by omega
            simp [List.getElem?_append_left hb]
          · simp only [List.getElem?_append_right (show cs.length ≤ a by omega)]
            simp [show a - cs.length ≠ 0 by omega]
        refine ⟨col', ?_, Or.inr (Or.inr ⟨fun h => by simp at h, rfl⟩)⟩
        rw [colAt_cons_E2, ← e1, hx']; exact hcx
  | s :: π, .node cols, G, hr, hG, hGc, σ, j, col', hc' => by
    obtain ⟨hl, h, hh, hr'⟩ := Scan.isRoutePath_cons.1 hr
    obtain ⟨colL, q, h₀, hcol, hcl, hs, hh'⟩ := lastStep?_eq_some hl
    rw [hh] at hh'
    cases hh'
    have hG' : h.forestAt π = some G := by
      rw [show s :: π = [s] ++ π from rfl, Tree.forestAt_append, hh] at hG
      exact hG
    simp only [Tree.cols] at hcol hs
    obtain ⟨ys, rfl⟩ := List.getLast?_eq_some_iff.1 hcol
    obtain ⟨zs, rfl⟩ := List.getLast?_eq_some_iff.1 hcl
    subst hs
    simp only [List.length_append, List.length_singleton, Nat.add_sub_cancel] at hc' ⊢
    rw [List.length_cons, spx_replaceAt_succ] at hc'
    cases σ with
    | nil =>
      simp only [projP_E2]
      rw [colAt_nil_E2] at hc' ⊢
      rcases Nat.lt_trichotomy j ys.length with hj | rfl | hj
      · rw [List.getElem?_append_left hj] at hc' ⊢
        exact ⟨col', hc', Or.inr (Or.inr ⟨fun h => by simp at h, rfl⟩)⟩
      · simp only [List.getElem?_append_right (le_refl _), Nat.sub_self, List.getElem?_cons_zero,
          Option.some.injEq] at hc' ⊢
        subst hc'
        refine ⟨_, rfl, Or.inr (Or.inl ⟨⟨0, by simp, rfl, zs.length, rfl⟩, by simp, by simp⟩)⟩
      · rw [List.getElem?_append_right (by omega)] at hc'
        simp [show j - ys.length ≠ 0 by omega] at hc'
    | cons x ρ =>
      rw [colAt_cons_E2, Option.bind_eq_some_iff] at hc'
      obtain ⟨x', hx', hcx⟩ := hc'
      obtain ⟨a, b⟩ := x
      by_cases hab : (a, b) = (ys.length, zs.length)
      · simp only [Prod.mk.injEq] at hab
        obtain ⟨rfl, rfl⟩ := hab
        rw [getEnt_snoc_self_E2] at hx'
        cases hx'
        obtain ⟨colA, hA, hrel⟩ := colAt_corr_E2 cs π h G hr' hG' hGc ρ j col' hcx
        refine ⟨colA, ?_, ?_⟩
        · simp only [projP_E2, if_true]
          rw [colAt_cons_E2, getEnt_snoc_self_E2]; exact hA
        · rcases hrel with ⟨h1, h2, h3, h4⟩ | ⟨⟨d, hd, h1, e, he⟩, h2, h3⟩ | ⟨h1, h2⟩
          · exact Or.inl ⟨by rw [h1], h2, h3, h4⟩
          · exact Or.inr (Or.inl ⟨⟨d + 1, by simp; omega, by simp [h1], e, by simpa using he⟩,
              h2, h3⟩)
          · exact Or.inr (Or.inr ⟨fun hh => h1 ⟨by simpa using hh.1, hh.2⟩, h2⟩)
      · have hab' : ¬ (a = ys.length ∧ b = zs.length) := fun hh => hab (by rw [hh.1, hh.2])
        have e1 := getEnt_snoc_E2 (replaceAt 0 0 (Tree.node [P ++ List.replicate N (p,
          Tree.node Fl.cols.dropLast)]) π.length h) h hab' (q := q)
        refine ⟨col', ?_, Or.inr (Or.inr ⟨fun hh => hab (List.cons.inj hh.1).1, rfl⟩)⟩
        simp only [projP_E2, hab, if_false]
        rw [colAt_cons_E2, ← e1, hx']; exact hcx


/-! T3.2u helpers (branch E2): cursors of capped columns. -/

theorem cursor_le_top_E2 : ∀ (src W : List (WithTop Key)), (∀ y ∈ W, y ≠ ⊤) →
    ∀ k, src[k]? = some ⊤ → cursor src W ≤ k := by
  intro src W
  induction src, W using cursor.induct with
  | case1 qry => intro _ k _; simp [cursor]
  | case2 x xs => intro _ k _; simp [cursor]
  | case3 x xs y ys h ih =>
    intro hW k hk
    cases k with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.some.injEq] at hk
      subst hk
      exact absurd h (not_lt.2 le_top)
    | succ k =>
      simp only [cursor, if_pos h]
      have := ih hW k (by simpa using hk)
      omega
  | case4 xs y ys _ ih =>
    intro hW k hk
    cases k with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.some.injEq] at hk
      exact absurd hk (hW y (by simp))
    | succ k =>
      simp only [cursor, lt_irrefl, if_false, if_true]
      have := ih (fun z hz => hW z (by simp [hz])) k (by simpa using hk)
      omega
  | case5 x xs y ys h1 h2 ih =>
    intro hW k hk
    simp only [cursor, if_neg h1, if_neg h2]
    exact ih (fun z hz => hW z (by simp [hz])) k hk

theorem capped_cases_E2 {K KA : List (WithTop Key)} {v : Nat} (hv : v < K.length)
    (hag : K.take (v + 1) = KA.take (v + 1) ∨ (v + 1 = K.length ∧ K.take v = KA.take v)) :
    K.dropLast ++ [⊤] = KA.take v ++ [⊤] ∨
      (v < (K.dropLast ++ [⊤]).length ∧ (K.dropLast ++ [⊤]).take (v + 1) = KA.take (v + 1)) := by
  by_cases hv1 : v + 1 = K.length
  · left
    have hKv : K.take v = KA.take v := by
      rcases hag with h | ⟨-, h⟩
      · have := congrArg (List.take v) h
        rwa [List.take_take, List.take_take, Nat.min_eq_left (by omega)] at this
      · exact h
    rw [List.dropLast_eq_take, show K.length - 1 = v by omega, hKv]
  · right
    have h1 : K.take (v + 1) = KA.take (v + 1) := by
      rcases hag with h | ⟨h, -⟩
      · exact h
      · exact absurd h hv1
    refine ⟨by simp; omega, ?_⟩
    rw [List.take_append_of_le_length (by rw [List.length_dropLast]; omega), List.dropLast_eq_take,
      List.take_take, Nat.min_eq_left (by omega), h1]

theorem capKeys_mem_E2 {E : Forest} {sel : List ColAddr} {o : ColAddr} (ho : o ∈ sel)
    (hne : actualKeys E o ≠ []) : capKeys E sel o = (actualKeys E o).dropLast ++ [⊤] := by
  obtain ⟨y, hy⟩ := Option.ne_none_iff_exists'.1 (mt List.getLast?_eq_none_iff.1 hne)
  simp [capKeys, ho, hy]

theorem colAt_isSome_of_resolve_E2 {E : Forest} {c o : ColAddr} {z i : Nat}
    (he : (⟨c, i⟩ : EntryAddr) ∈ E.entryAddrs) (ho : c.resolve 0 z = some o) :
    (E.colAt o).isSome := by
  have := (Tree.stack_mem_prefix he).2.1 o ((ColAddr.resolve_spec 0 c o z).1 ho).1
  exact (Tree.mem_roles_ord o.path _ o.col).1 ((List.takeWhile_sublist _).subset this)


-- T3.2u (txt:410-412): special outputs satisfy A
theorem condA_special {A B : Forest} {n : Nat} (hL : InL A) (hk : stepKind A = some .special)
    (hB : expand A n = some B) : CondA B := by
  have hVB : CondV B := (condVIH_special hL hk hB).1
  have hSB : CondS B := condS_special hL hk hB
  obtain ⟨π, G, cs, P, p, Fl, N, hrp, hG, hGc, hFl, hN, rfl⟩ := spx_special_shape hL hk hB
  obtain ⟨hV, -, -, hAA, hSA⟩ := hL
  have hcorr := colAt_corr_E2 (N := N) cs π A G hrp hG hGc
  obtain ⟨hrB, hGB⟩ := route_replace_E2
    (c' := P ++ List.replicate N (p, Tree.node Fl.cols.dropLast)) cs π A G hrp hG hGc
  set C : Forest := Tree.node Fl.cols.dropLast with hCdef
  set B := replaceAt 0 0 (Tree.node [P ++ List.replicate N (p, C)]) π.length A with hBdef
  have hmo : (⟨π, cs.length⟩ : ColAddr) ∈ routeCols B := mem_routeCols_end_E2 hrB hGB
  have hmc : ∀ σ j, isCont_E2 π σ j → (⟨σ, j⟩ : ColAddr) ∈ routeCols B :=
    fun σ j h => mem_routeCols_cont_E2 hrB h
  have hcolo : B.colAt ⟨π, cs.length⟩ = some (P ++ List.replicate N (p, C)) := by
    simp [Tree.colAt, hGB, Tree.cols]
  -- one edge of an old path is an edge of the new capped system
  have hresp : ∀ (c : ColAddr) (i : Nat), (⟨c, i⟩ : EntryAddr) ∈ B.entryAddrs →
      c ∈ B.colAddrs → projC_E2 π cs.length P.length c ∈ A.colAddrs →
      i ≤ (parents A (projC_E2 π cs.length P.length c)).length → ∀ (z y : Nat),
      Path A (actualKeys A) (projC_E2 π cs.length P.length c)
        (cutQuery (actualKeys A (projC_E2 π cs.length P.length c)) i)
        (cutStart A (projC_E2 π cs.length P.length c) i) z →
      Edge A (actualKeys A) (projC_E2 π cs.length P.length c)
        (cutQuery (actualKeys A (projC_E2 π cs.length P.length c)) i) z y →
      Edge B (capKeys B (routeCols B)) c
        (cutQuery (actualKeys A (projC_E2 π cs.length P.length c)) i) z y := by
    intro c i hent hc hcA hiA z y hpath hedge
    obtain ⟨oA, hoA, hrA⟩ := hedge
    set W := cutQuery (actualKeys A (projC_E2 π cs.length P.length c)) i with hWdef
    have hWn : W.Pairwise fun x y => y ≤ x := cutQuery_noninc _ _
    have hWT : ∀ y ∈ W, y ≠ ⊤ := by
      intro y hy
      have hy' := ((Scan.nu_sublist _).trans (List.take_sublist _ _)).subset hy
      simp only [actualKeys, List.mem_map] at hy'
      obtain ⟨_, -, rfl⟩ := hy'
      exact WithTop.coe_ne_top
    have hz : z < c.num 0 := by
      have := ColAddr.resolve_lt hoA; rwa [projC_num_E2] at this
    obtain ⟨oB, hoB⟩ := Option.isSome_iff_exists.1
      ((ColAddr.resolve_isSome_iff 0 c z).2 ⟨Nat.zero_le _, hz⟩)
    have hpo : projC_E2 π cs.length P.length oB = oA := by
      have := projC_resolve_E2 π cs.length P.length hoB
      rw [hoA] at this; exact (Option.some.inj this).symm
    subst hpo
    refine ⟨oB, hoB, ?_⟩
    obtain ⟨colB, hcolB⟩ := Option.isSome_iff_exists.1 (colAt_isSome_of_resolve_E2 hent hoB)
    obtain ⟨colA, hcolA, hrel⟩ := hcorr oB.path oB.col colB hcolB
    have hcolA' : A.colAt (projC_E2 π cs.length P.length oB) = some colA := hcolA
    have hnum : (projC_E2 π cs.length P.length oB).num 0 = oB.num 0 := projC_num_E2 _ _ _ 0 oB
    have hzo : oB.num 0 = z := ColAddr.resolve_num hoB
    have hkB : actualKeys B oB = colB.map fun x => ((relKey (oB.num 0) x.2 : Key) : WithTop Key) := by
      simp [actualKeys, hcolB]
    have hkA : actualKeys A (projC_E2 π cs.length P.length oB) =
        colA.map fun x => ((relKey (oB.num 0) x.2 : Key) : WithTop Key) := by
      simp [actualKeys, hcolA', hnum]
    unfold resp at hrA ⊢
    rw [hcolB, Option.getD_some]
    rw [hcolA', Option.getD_some] at hrA
    by_cases hor : oB ∈ routeCols B
    · obtain ⟨v, hvB, hvc⟩ := routeCols_visible hc hor hoB
      have hvL : v < colB.length := by
        have := (Tree.mem_entryAddrs_iff _ _).1 hvB
        rw [Tree.entryAt, hcolB, Option.bind_some] at this
        obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 this
        exact (List.getElem?_eq_some_iff.1 hx).1
      have hvcA := projE_contains_E2 π cs.length P.length hvc
      have hcne : actualKeys B oB ≠ [] := by
        rw [hkB]; intro h0; rw [List.map_eq_nil_iff] at h0; rw [h0] at hvL; simp at hvL
      have hcap := capKeys_mem_E2 (E := B) hor hcne
      -- the barrier at the containing entry, read in the input
      have hbarG : ∀ (w : Nat), projI_E2 π cs.length P.length ⟨oB, v⟩ = w → w < colA.length →
          W < cutQuery (actualKeys A (projC_E2 π cs.length P.length oB)) (w + 1) := by
        intro w hw hwl
        have hvA : projE_E2 π cs.length P.length ⟨oB, v⟩ ∈ A.entryAddrs := by
          rw [Tree.mem_entryAddrs_iff, Tree.entryAt]
          simp only [projE_E2, hw]
          rw [hcolA', Option.bind_some, List.getElem?_eq_getElem hwl]; rfl
        have hbar := cut_barrier hV hAA hSA hvA hcA hvcA hiA
          (by simp only [projE_E2]; rw [hnum, hzo]; exact hpath)
        rw [boundary_eq_cutQuery] at hbar
        simpa only [projE_E2, hw] using hbar
      rcases hrel with ⟨hσ, hj, hcB, hcAe⟩ | ⟨hcont, hdl, hfst⟩ | ⟨hno, heq⟩
      · -- the owner column
        have hoBe : oB = ⟨π, cs.length⟩ := by
          obtain ⟨σ, j⟩ := oB; simp only at hσ hj; rw [hσ, hj]
        subst hcB hcAe
        have hKA : actualKeys A (projC_E2 π cs.length P.length oB) =
            P.map (fun x => ((relKey (oB.num 0) x.2 : Key) : WithTop Key)) ++
              [((relKey (oB.num 0) Fl : Key) : WithTop Key)] := by
          rw [hkA]; simp
        have hKB : actualKeys B oB =
            P.map (fun x => ((relKey (oB.num 0) x.2 : Key) : WithTop Key)) ++
              List.replicate N ((relKey (oB.num 0) C : Key) : WithTop Key) := by
          rw [hkB]; simp
        by_cases hvP : v < P.length
        · have hw : projI_E2 π cs.length P.length ⟨oB, v⟩ = v := by
            unfold projI_E2; rw [if_neg (fun h => absurd h.2.2 (by show ¬ P.length ≤ v; omega))]
          have hbar := hbarG v hw (by simp; omega)
          have hag : (actualKeys B oB).take (v + 1) =
              (actualKeys A (projC_E2 π cs.length P.length oB)).take (v + 1) := by
            rw [hKA, hKB, List.take_append_of_le_length (by simp; omega),
              List.take_append_of_le_length (by simp; omega)]
          have hcur : cursor (capKeys B (routeCols B) oB) W =
              cursor (actualKeys A (projC_E2 π cs.length P.length oB)) W := by
            refine spx_cursor_capped (by rw [hKA]; simp; omega) hWn hWT hbar ?_
            rw [hcap]
            exact capped_cases_E2 (by rw [hKB]; simp; omega) (Or.inl hag)
          have hle := cursor_le_of_lt_cutQuery hWn (by rw [hKA]; simp; omega) hbar
          rw [hcur]
          rw [List.getElem?_append_left (by omega)] at hrA ⊢
          exact hrA
        · have hNpos : N ≠ 0 := by
            rintro rfl; simp at hvL; omega
          have hw : projI_E2 π cs.length P.length ⟨oB, v⟩ = P.length := by
            unfold projI_E2
            rw [if_pos ⟨by rw [hoBe], by rw [hoBe], by show P.length ≤ v; omega⟩]
          have hbar := hbarG P.length hw (by simp)
          have hleA := cursor_le_of_lt_cutQuery hWn (by rw [hKA]; simp) hbar
          have htk : (capKeys B (routeCols B) oB).take P.length =
              (actualKeys A (projC_E2 π cs.length P.length oB)).take P.length := by
            rw [hcap, List.take_append_of_le_length (by rw [List.length_dropLast, hKB]; simp; omega),
              List.dropLast_eq_take, List.take_take, Nat.min_eq_left (by rw [hKB]; simp; omega),
              hKA, hKB, List.take_append_of_le_length (by simp),
              List.take_append_of_le_length (by simp)]
          have e1 := cursor_take (capKeys B (routeCols B) oB) W P.length
          have e2 := cursor_take (actualKeys A (projC_E2 π cs.length P.length oB)) W P.length
          rw [htk, e2] at e1
          by_cases hlt : cursor (actualKeys A (projC_E2 π cs.length P.length oB)) W < P.length
          · have hcur : cursor (capKeys B (routeCols B) oB) W =
                cursor (actualKeys A (projC_E2 π cs.length P.length oB)) W := by omega
            rw [hcur]
            rw [List.getElem?_append_left hlt] at hrA ⊢
            exact hrA
          · have hcA0 : cursor (actualKeys A (projC_E2 π cs.length P.length oB)) W = P.length := by
              omega
            rw [hcA0] at hrA
            simp only [List.getElem?_append_right (le_refl _), Nat.sub_self,
              List.getElem?_cons_zero, Option.map_some, Option.some.injEq] at hrA
            subst hrA
            have hge : P.length ≤ cursor (capKeys B (routeCols B) oB) W := by omega
            have hle : cursor (capKeys B (routeCols B) oB) W ≤ P.length + N - 1 := by
              have := cursor_le_top_E2 (capKeys B (routeCols B) oB) W hWT
                (actualKeys B oB).dropLast.length (by
                  rw [hcap, List.getElem?_append_right (le_refl _), Nat.sub_self]; rfl)
              rw [List.length_dropLast, hKB] at this
              simpa using this
            rw [List.getElem?_append_right hge]
            have hlt2 : cursor (capKeys B (routeCols B) oB) W - P.length < N := by omega
            rw [List.getElem?_replicate, if_pos hlt2]
            rfl
      · -- a route container: the same column but its last height
        have hlen : colB.length = colA.length := by
          have := congrArg List.length hfst; simpa using this
        have hw : projI_E2 π cs.length P.length ⟨oB, v⟩ = v := by
          unfold projI_E2
          rw [if_neg]
          rintro ⟨h1, -, -⟩
          obtain ⟨d, hd, h2, -⟩ := hcont
          have := congrArg List.length (h1.symm.trans h2)
          simp at this; omega
        have hbar := hbarG v hw (by omega)
        have hag : (actualKeys B oB).take (v + 1) =
              (actualKeys A (projC_E2 π cs.length P.length oB)).take (v + 1) ∨
            (v + 1 = (actualKeys B oB).length ∧ (actualKeys B oB).take v =
              (actualKeys A (projC_E2 π cs.length P.length oB)).take v) := by
          rw [hkA, hkB]
          by_cases hv1 : v + 1 = colB.length
          · right
            refine ⟨by simp; omega, ?_⟩
            rw [← List.map_take, ← List.map_take]
            congr 1
            rw [show v = colB.length - 1 by omega, ← List.dropLast_eq_take, hdl, hlen,
              List.dropLast_eq_take]
          · left
            rw [← List.map_take, ← List.map_take]
            congr 1
            have h1 : colB.take (v + 1) = colB.dropLast.take (v + 1) := by
              rw [List.dropLast_eq_take, List.take_take, Nat.min_eq_left (by omega)]
            have h2 : colA.take (v + 1) = colA.dropLast.take (v + 1) := by
              rw [List.dropLast_eq_take, List.take_take, Nat.min_eq_left (by omega)]
            rw [h1, h2, hdl]
        have hcur : cursor (capKeys B (routeCols B) oB) W =
            cursor (actualKeys A (projC_E2 π cs.length P.length oB)) W := by
          refine spx_cursor_capped (by rw [hkA]; simp; omega) hWn hWT hbar ?_
          rw [hcap]
          exact capped_cases_E2 (by rw [hkB]; simp; omega) hag
        rw [hcur, ← List.getElem?_map, hfst, List.getElem?_map]
        exact hrA
      · -- the same column
        subst heq
        have hw : projI_E2 π cs.length P.length ⟨oB, v⟩ = v := by
          unfold projI_E2
          rw [if_neg]
          rintro ⟨h1, h2, -⟩
          exact hno ⟨h1, h2⟩
        have hbar := hbarG v hw hvL
        have hKe : actualKeys B oB = actualKeys A (projC_E2 π cs.length P.length oB) := by
          rw [hkA, hkB]
        have hcur : cursor (capKeys B (routeCols B) oB) W =
            cursor (actualKeys A (projC_E2 π cs.length P.length oB)) W := by
          refine spx_cursor_capped (by rw [hkA]; simp; omega) hWn hWT hbar ?_
          rw [hcap]
          exact capped_cases_E2 (by rw [hkB]; simp; omega) (Or.inl (by rw [hKe]))
        rw [hcur]
        exact hrA
    · -- a column off the route is unchanged
      rw [capKeys_of_not_mem hor]
      have heq : colB = colA := by
        rcases hrel with ⟨hσ, hj, -, -⟩ | ⟨hcont, -, -⟩ | ⟨-, h⟩
        · exfalso; apply hor
          obtain ⟨σ, j⟩ := oB; simp only at hσ hj; rw [hσ, hj]; exact hmo
        · exact absurd (hmc _ _ hcont) hor
        · exact h
      subst heq
      have hKe : actualKeys B oB = actualKeys A (projC_E2 π cs.length P.length oB) := by
        rw [hkA, hkB]
      rw [hKe]
      exact hrA
  refine capping_reverse hVB hSB (sel := routeCols B) (fun a ha => ha) ?_
  rw [condAK_iff]
  intro c hc i q hq
  obtain ⟨col', hcol'⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff _ c).1 hc)
  have hiL : i < col'.length := by
    have := (List.getElem?_eq_some_iff.1 hq).1
    simpa [parents, hcol'] using this
  have hent : (⟨c, i⟩ : EntryAddr) ∈ B.entryAddrs := by
    rw [Tree.mem_entryAddrs_iff, Tree.entryAt, hcol', Option.bind_some,
      List.getElem?_eq_getElem hiL]; rfl
  rw [cutQuery_capKeys B _ c (by rw [hcol']; simpa using hiL)]
  obtain ⟨colA, hcolA, hrel⟩ := hcorr c.path c.col col' hcol'
  have hcolA' : A.colAt (projC_E2 π cs.length P.length c) = some colA := hcolA
  have hnum : (projC_E2 π cs.length P.length c).num 0 = c.num 0 := projC_num_E2 _ _ _ 0 c
  have hqB : (col'.map Prod.fst)[i]? = some q := by simpa [parents, hcol'] using hq
  by_cases hlate : c = ⟨π, cs.length⟩ ∧ P.length < i
  · -- later copies: the reflexive test from the repeated parent
    obtain ⟨hc0, hi⟩ := hlate
    rw [hc0] at hcol'
    rw [hcolo, Option.some.injEq] at hcol'
    subst hcol'
    have hq' : q = p := by
      rw [List.getElem?_map, List.getElem?_append_right (by omega), List.getElem?_replicate,
        if_pos (by simp at hiL; omega)] at hqB
      simpa using hqB.symm
    have hs : cutStart B c i = p := by
      unfold cutStart
      rw [if_neg (by omega), parents, hc0, hcolo, Option.getD_some, List.getElem?_map,
        List.getElem?_append_right (by omega), List.getElem?_replicate, if_pos (by simp at hiL; omega)]
      rfl
    rw [hs, hq']
    exact Relation.ReflTransGen.refl
  · -- the old test at the corresponding entry
    have hagree : col'.take i = colA.take i ∧ (col'.map Prod.fst).take (i + 1) =
        (colA.map Prod.fst).take (i + 1) ∧ i < colA.length := by
      rcases hrel with ⟨hσ, hj, hcB, hcAe⟩ | ⟨hcont, hdl, hfst⟩ | ⟨-, heq⟩
      · have hc0 : c = ⟨π, cs.length⟩ := by
          obtain ⟨σ, j⟩ := c; simp only at hσ hj; rw [hσ, hj]
        have hiP : i ≤ P.length := by
          by_contra h; exact hlate ⟨hc0, by omega⟩
        subst hcB hcAe
        refine ⟨?_, ?_, by simp; omega⟩
        · rw [List.take_append_of_le_length hiP, List.take_append_of_le_length hiP]
        · rcases Nat.lt_or_eq_of_le hiP with hiP | hiP
          · rw [List.map_append, List.map_append, List.take_append_of_le_length (by simp; omega),
              List.take_append_of_le_length (by simp; omega)]
          · have hN1 : N ≠ 0 := by rintro rfl; simp at hiL; omega
            obtain ⟨N', rfl⟩ : ∃ N', N = N' + 1 := ⟨N - 1, by omega⟩
            subst hiP
            simp only [List.replicate_succ, List.map_append, List.map_cons, List.map_replicate,
              List.map_nil]
            rw [List.take_append, List.take_append]
            simp
      · have hlen : col'.length = colA.length := by
          have := congrArg List.length hfst; simpa using this
        refine ⟨?_, ?_, by omega⟩
        · have h1 : col'.take i = col'.dropLast.take i := by
            rw [List.dropLast_eq_take, List.take_take, Nat.min_eq_left (by omega)]
          have h2 : colA.take i = colA.dropLast.take i := by
            rw [List.dropLast_eq_take, List.take_take, Nat.min_eq_left (by omega)]
          rw [h1, h2, hdl]
        · rw [hfst]
      · subst heq; exact ⟨rfl, rfl, hiL⟩
    obtain ⟨htk, hfk, hiA⟩ := hagree
    have hW : cutQuery (actualKeys B c) i = cutQuery (actualKeys A (projC_E2 π cs.length P.length c)) i := by
      unfold cutQuery
      congr 1
      simp only [actualKeys, hcol', hcolA', Option.getD_some, ← List.map_take, htk, hnum]
    have hpar : ∀ k ≤ i, (parents B c)[k]? = (parents A (projC_E2 π cs.length P.length c))[k]? := by
      intro k hk
      simp only [parents, hcol', hcolA', Option.getD_some]
      have := congrArg (fun l => l[k]?) hfk
      simp only [List.getElem?_take, if_pos (show k < i + 1 by omega)] at this
      exact this
    have hstart : cutStart B c i = cutStart A (projC_E2 π cs.length P.length c) i := by
      unfold cutStart
      rw [hnum]
      split_ifs with h0
      · rfl
      · rw [hpar (i - 1) (by omega)]
    have hqA : (parents A (projC_E2 π cs.length P.length c))[i]? = some q := by
      rw [← hpar i (le_refl _)]; exact hq
    have hcA : projC_E2 π cs.length P.length c ∈ A.colAddrs := by
      rw [Tree.mem_colAddrs_iff, hcolA']; rfl
    have hiA' : i ≤ (parents A (projC_E2 π cs.length P.length c)).length := by
      simp [parents, hcolA']; omega
    have hAt := (condAK_iff _ _).1 hAA _ hcA i q hqA
    rw [hW, hstart]
    have key : ∀ y, Path A (actualKeys A) (projC_E2 π cs.length P.length c)
        (cutQuery (actualKeys A (projC_E2 π cs.length P.length c)) i)
        (cutStart A (projC_E2 π cs.length P.length c) i) y →
        Path B (capKeys B (routeCols B)) c
          (cutQuery (actualKeys A (projC_E2 π cs.length P.length c)) i)
          (cutStart A (projC_E2 π cs.length P.length c) i) y := by
      intro y h
      induction h with
      | refl => exact Relation.ReflTransGen.refl
      | @tail z y' hxz hzy ih => exact ih.tail (hresp c i hent hc hcA hiA' z y' hxz hzy)
    exact key q hAt

/-! T3.2v helpers: the columns of a seed. -/

/-- The height below the branch entry with parent `l` of `L_{m+1}`. -/
def spxSeedH (l s : Nat) : Forest := if s = 0 then Tree.empty else .node [branch (l + 1) (s - 1)]

theorem spx_branch (l s : Nat) : branch l s = [(l, spxSeedH l s)] := by
  cases s <;> rfl

/-- Columns of a branch forest. -/
theorem spx_branch_colAt : ∀ (k i : Nat) (P : List (Nat × Nat)) (j : Nat) (col : Column),
    (Tree.node [branch i k]).colAt ⟨P, j⟩ = some col →
      ∃ l ≤ k, P = List.replicate l (0, 0) ∧ j = 0 ∧ col = branch (i + l) (k - l)
  | k, i, [], j, col, h => by
    simp only [Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols] at h
    cases j with
    | zero => simp only [List.getElem?_cons_zero, Option.some.injEq] at h; exact ⟨0, by omega, rfl, rfl, by simp [h]⟩
    | succ j => simp at h
  | k, i, (a, b) :: P, j, col, h => by
    rw [Tree.colAt_cons] at h
    simp only [Tree.cols] at h
    cases a with
    | succ a => simp at h
    | zero =>
      cases k with
      | zero => cases b <;> simp [branch, spx_colAt_empty] at h
      | succ k =>
        cases b with
        | succ b => simp [branch] at h
        | zero =>
          simp only [branch, List.getElem?_cons_zero, Option.bind_some] at h
          obtain ⟨l, hl, rfl, rfl, rfl⟩ := spx_branch_colAt k (i + 1) P j col h
          exact ⟨l + 1, by omega, by simp [List.replicate_succ], rfl, by
            rw [show i + 1 + l = i + (l + 1) by omega, show k - l = k + 1 - (l + 1) by omega]⟩

/-- Columns of `L_{m+1}`: the empty outer column, and one singleton column per level. -/
theorem spx_seed_colAt (m : Nat) (c : ColAddr) (col : Column)
    (h : (seed (m + 1)).colAt c = some col) :
    (c = ⟨[], 0⟩ ∧ col = []) ∨ ∃ l ≤ m, c.num 0 = l + 1 ∧ col = branch l (m - l) := by
  obtain ⟨P, j⟩ := c
  cases P with
  | nil =>
    simp only [seed, Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols] at h
    match j, h with
    | 0, h => left; simp at h; exact ⟨rfl, h⟩
    | 1, h => right; simp at h; exact ⟨0, by omega, by simp [ColAddr.num], by simp [h]⟩
    | j + 2, h => simp at h
  | cons x P =>
    obtain ⟨a, b⟩ := x
    rw [seed, Tree.colAt_cons] at h
    simp only [Tree.cols] at h
    match a, b, h with
    | 0, b, h => simp at h
    | a + 2, b, h => simp at h
    | 1, b + 1, h => simp [spx_branch] at h
    | 1, 0, h =>
      cases m with
      | zero => simp [branch, spx_colAt_empty] at h
      | succ k =>
        simp only [branch, List.getElem?_cons_succ, List.getElem?_cons_zero, Option.bind_some] at h
        obtain ⟨l, hl, rfl, rfl, rfl⟩ := spx_branch_colAt k 1 P j col h
        right
        refine ⟨l + 1, by omega, ?_, by rw [show 1 + l = l + 1 by omega,
          show k - l = k + 1 - (l + 1) by omega]⟩
        simp [ColAddr.num, List.map_replicate, List.sum_replicate]; omega

/-- Entries of `L_{m+1}`: the entry at level `l` has parent `l`, column number `l + 1`. -/
theorem spx_seed_entryAt (m : Nat) (e : EntryAddr) (q : Nat) (h : Forest)
    (he : (seed (m + 1)).entryAt e = some (q, h)) :
    ∃ l ≤ m, e.idx = 0 ∧ e.col.num 0 = l + 1 ∧ q = l ∧ h = spxSeedH l (m - l) := by
  obtain ⟨col, hcol, hi⟩ := Tree.colAt_of_entryAt he
  rcases spx_seed_colAt m e.col col hcol with ⟨-, rfl⟩ | ⟨l, hl, hn, rfl⟩
  · simp at hi
  · rw [spx_branch] at hi
    cases hidx : e.idx with
    | zero =>
      rw [hidx] at hi
      simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hi
      exact ⟨l, hl, rfl, hn, hi.1.symm, hi.2.symm⟩
    | succ i => rw [hidx] at hi; simp at hi

theorem spx_profile_branch : ∀ (s i : Nat),
    profile (Tree.node [branch i s]) = ((toLex (s, 1) : Nat ×ₗ Nat) : WithBot (Nat ×ₗ Nat))
  | 0, i => by simp [branch, profile, profileBody, profileAux, Tree.empty]
  | s + 1, i => by
    rw [spx_profile_node (by simp), branch, spx_profileAux_cons 0 i (by simp [Tree.cols]),
      spx_profileAux_one]
    have := spx_profile_branch s (i + 1)
    rw [spx_profile_node (by simp), WithBot.coe_inj] at this
    rw [this]; rfl

theorem spx_seed_zero_entryAt (e : EntryAddr) : (seed 0).entryAt e = none := by
  obtain ⟨⟨P, j⟩, i⟩ := e
  cases P with
  | nil =>
    simp only [seed, Tree.entryAt, Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols]
    cases j <;> simp
  | cons x P =>
    obtain ⟨a, b⟩ := x
    rw [seed, Tree.entryAt, Tree.colAt_cons]
    cases a <;> simp [Tree.cols]

theorem spx_empty_entryAddrs : (Tree.empty : Forest).entryAddrs = [] := rfl
theorem spx_empty_colAddrs : (Tree.empty : Forest).colAddrs = [] := rfl

-- T3.2v (txt:412-413): seeds lie in L and satisfy P (`seed_condP` is stated first: the proof
-- of `seed_inL` gets S from P by L3.1a)
theorem seed_condP (m : Nat) : CondP (seed m) := by
  intro e0 he0 e he hret
  obtain ⟨-, q, J, hJ, hres⟩ := hret
  cases m with
  | zero => exact absurd hJ (by rw [spx_seed_zero_entryAt]; simp)
  | succ m =>
    obtain ⟨x0, hx0⟩ := Option.isSome_iff_exists.1 ((Tree.mem_entryAddrs_iff _ e0).1 he0)
    obtain ⟨q0, H0⟩ := x0
    obtain ⟨l0, hl0, -, hn0, -, rfl⟩ := spx_seed_entryAt m e0 q0 H0 hx0
    obtain ⟨l1, hl1, -, -, hq1, hJ1⟩ := spx_seed_entryAt m e q J hJ
    have hq : e0.col.num 0 = l1 := hq1 ▸ ColAddr.resolve_num hres
    rw [Tree.heightAt, Tree.heightAt, hJ, hx0, hJ1]
    simp only [Option.map_some, Option.getD_some]
    have hm : m - l0 = m - l1 + 1 := by omega
    rw [hm]
    simp only [spxSeedH, Nat.add_one_ne_zero, if_false, Nat.add_sub_cancel]
    rw [show l0 + 1 = l1 by omega, spx_profile_branch]
    by_cases hs : m - l1 = 0
    · simp only [hs, if_true]; exact WithBot.bot_lt_coe _
    · rw [if_neg hs, spx_profile_branch]
      exact WithBot.coe_lt_coe.2 (Prod.Lex.toLex_lt_toLex.2 (Or.inl (by simp; omega)))

theorem seed_inL (m : Nat) : InL (seed m) := by
  have hV : CondV (seed m) := by
    rw [condV_iff_lt]
    intro e _ q h he
    cases m with
    | zero => rw [spx_seed_zero_entryAt] at he; cases he
    | succ m =>
      obtain ⟨l, -, -, hn, rfl, -⟩ := spx_seed_entryAt m e q h he
      omega
  have hI : CondI (seed m) := by
    intro e _ q h he hne col hcol
    cases m with
    | zero => rw [spx_seed_zero_entryAt] at he; cases he
    | succ m =>
      obtain ⟨l, -, -, hn, -, rfl⟩ := spx_seed_entryAt m e q _ he
      unfold spxSeedH at hne hcol
      split_ifs at hne hcol with hs
      · exact absurd rfl hne
      · simp only [Tree.cols, List.mem_singleton] at hcol
        subst hcol
        rw [spx_branch]
        exact ⟨l + 1, _, [], rfl, by omega⟩
  have hH : CondH (seed m) := by
    intro c hc i x y hx hy
    obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff _ c).1 hc)
    rw [hcol, Option.getD_some] at hx hy
    cases m with
    | zero =>
      have he : (seed 0).entryAt ⟨c, i⟩ = some x := by rw [Tree.entryAt, hcol]; exact hx
      rw [spx_seed_zero_entryAt] at he; cases he
    | succ m =>
      rcases spx_seed_colAt m c col hcol with ⟨-, rfl⟩ | ⟨l, -, -, rfl⟩
      · simp at hx
      · rw [spx_branch] at hy; simp at hy
  have hA : CondA (seed m) := by
    intro c _ i p hp
    rw [parents_getElem?] at hp
    obtain ⟨⟨q, h⟩, he, rfl⟩ := Option.map_eq_some_iff.1 hp
    cases m with
    | zero => rw [spx_seed_zero_entryAt] at he; cases he
    | succ m =>
      obtain ⟨l, -, hi, hn, rfl, -⟩ := spx_seed_entryAt m ⟨c, i⟩ q h he
      simp only at hi hn
      subst hi
      simp only [if_true, hn, Nat.add_sub_cancel]
      exact Relation.ReflTransGen.refl
  exact ⟨hV, hI, hH, hA, condS_of_condP hV hI hH (seed_condP m)⟩

-- T3.2w: the empty forest lies in L and satisfies P
theorem inL_empty : InL Tree.empty := by
  refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;> intro c hc <;> simp [spx_empty_entryAddrs, spx_empty_colAddrs] at hc

theorem condP_empty : CondP Tree.empty := by
  intro e0 he0; simp [spx_empty_entryAddrs] at he0


/-! ### T3.2 — the closure theorem

The six spine contracts of T3.2 below were moved here from `Plan/Spine.lean` (brief rule 5,
branch D3): their proofs use the T3.2 sub-lemmas of this section; nothing in between used them. -/

/-- The output of a loop step lies below the previous phase's stopping column (only the parents
of `U` are used). -/
theorem ordStep_lt_D3 {sd : StopData} {rd : RootData} {F : Forest} {U : Column} {k : Nat}
    {Z : Forest} (hUr : ∀ x ∈ U, x.1 < sd.r) :
    ordStep sd rd F U k Z <
      .node [Tree.mapCol (shiftVal sd.r ((k - 1) * (sd.t - sd.r))) (sd.Q ++ [(sd.r, Tree.empty)])] := by
  have hmapQ : Tree.mapCol (shiftVal sd.r ((k - 1) * (sd.t - sd.r))) (sd.Q ++ [(sd.r, Tree.empty)]) =
      Tree.mapCol (shiftVal sd.r ((k - 1) * (sd.t - sd.r))) sd.Q ++
        [(shiftVal sd.r ((k - 1) * (sd.t - sd.r)) sd.r, Tree.empty)] := by
    simp [treeMapCol_eq_map, Tree.map, Tree.mapCols, Tree.empty]
  have hρ : sd.r ≤ shiftVal sd.r ((k - 1) * (sd.t - sd.r)) sd.r := le_shiftVal_D3 _ _ _
  unfold ordStep
  simp only
  rw [hmapQ]
  split
  · rw [List.append_assoc]
    refine head_lt_D3 (rest := []) (fun v hv => lt_of_lt_of_le ?_ hρ)
    have e := mapLast_eq (fun x : Nat × Forest => (x.1, shift sd.r (k * (sd.t - sd.r)) x.2))
      (fun x : Nat × Forest => (x.1, Hole.fill ⟨x.2, sd.depth - rd.layer - 1⟩ sd.r
        (k * (sd.t - sd.r)) Z)) U
    rw [← e] at hv
    cases hU0 : U.head? with
    | none =>
      cases U with
      | nil => simp [mapLast] at hv
      | cons _ _ => simp at hU0
    | some u0 =>
      obtain ⟨y, hy, hyu⟩ := head_mapLast_fst_D3
        (fun x : Nat × Forest => (x.1, shift sd.r (k * (sd.t - sd.r)) x.2))
        (fun x : Nat × Forest => (x.1, Hole.fill ⟨x.2, sd.depth - rd.layer - 1⟩ sd.r
          (k * (sd.t - sd.r)) Z)) (fun _ => rfl) (fun _ => rfl) u0 hU0
      rw [hy] at hv; cases hv
      rw [hyu]; exact hUr u0 (List.mem_of_head? hU0)
  · refine head_lt_D3 (fun v hv => lt_of_lt_of_le ?_ hρ)
    cases U with
    | nil => simp at hv
    | cons u us => simp at hv; subst hv; exact hUr u (by simp)

theorem ordZ_lt_D3 {A : Forest} {sd : StopData} {rd : RootData} (hV : CondV A)
    (hsd : stopData A = some sd) (hrd : rootData A = some rd) (n : Nat) :
    ordZ A sd rd n < .node [sd.Q ++ [(sd.r, Tree.empty)]] := by
  obtain ⟨-, -, hU, -, -⟩ := ord_vdata_D3 hV hsd hrd
  have := ordLoop_induct_D3 (step := ordStep sd rd ((A.forestAt rd.col.path).getD Tree.empty)
      (((A.colAt rd.col).getD []).drop rd.cursor))
    (P := fun k Z => Z <
      .node [Tree.mapCol (shiftVal sd.r (k * (sd.t - sd.r))) (sd.Q ++ [(sd.r, Tree.empty)])]) ?_ n
    Tree.empty (Forest.empty_lt (by simp [Tree.empty]))
  · simpa [ordZ, shiftVal_zero_fun, treeMapCol_id_fun] using this
  · intro k Z _ _
    exact ordStep_lt_D3 (fun x hx => (hU x hx).1)

/-- The special output is below the input: the owner column `P ⌢ [(p, C ⌢ [[(a,∅)]])]` becomes
`P ⌢ [(p, C)]^m`. -/
theorem special_col_lt_D3 (P : Column) (p : Nat) (Fl : Forest) (hFl : Fl.cols ≠ []) (m : Nat) :
    (Tree.node [P ++ List.replicate m (p, Tree.node Fl.cols.dropLast)] : Forest) <
      .node [P ++ [(p, Fl)]] := by
  show Tree.cmp compare _ _ = .lt
  simp only [Tree.cmp, Tree.cmpCols, cmpCol_append_left_D3]
  cases m with
  | zero => rfl
  | succ m =>
    rw [List.replicate_succ]
    simp only [Tree.cmpCol]
    rw [show compare p p = Ordering.eq from compare_eq_iff_eq.2 rfl]
    obtain ⟨fc⟩ := Fl
    have hc : Tree.cmp compare (Tree.node fc.dropLast : Forest) (Tree.node fc) = .lt := by
      simp only [Tree.cmp, Tree.cols] at hFl ⊢
      conv => rhs; skip
      have := cmpCols_append_left_D3 fc.dropLast [] [fc.getLast hFl]
      rw [List.append_nil, List.dropLast_append_getLast hFl] at this
      rw [this]; rfl
    have e : (Tree.node fc).cols = fc := rfl
    rw [e, hc]; rfl

-- provides: U2, T3.2
theorem inL_safePrefix {E : Forest} (hE : Scan.InL E) (k : Nat) :
    Scan.InL (Scan.safePrefix E k) :=
  ⟨safePrefix_condV hE.1 k, safePrefix_condI hE.2.1 k, safePrefix_condH hE.2.2.1 k,
    safePrefix_condA hE k, safePrefix_condS hE.1 hE.2.2.2.2 k⟩

-- provides: U2, T3.2
theorem inL_expand {E E' : Forest} {n : Nat} (hE : Scan.InL E) (h : expand E n = some E') :
    Scan.InL E' := by
  by_cases hE0 : E = Tree.empty
  · subst hE0; rw [expand_empty] at h; cases h; exact inL_empty
  obtain ⟨k, hk⟩ := Option.isSome_iff_exists.1 (stepKind_isSome hE0 hE.1 hE.2.1)
  cases k with
  | deletion =>
    obtain ⟨j, -, rfl⟩ := expand_safePrefix hE0 hE.1 hE.2.1 (Or.inl hk) h
    exact inL_safePrefix hE j
  | special =>
    obtain ⟨hV, hI, hH⟩ := condVIH_special hE hk h
    exact ⟨hV, hI, hH, condA_special hE hk h, condS_special hE hk h⟩
  | ordinary =>
    exact ⟨condV_ord hE hk h, condI_ord hE hk h, condH_ord hE hk h, condA_ord hE hk h,
      condS_ord hE hk h⟩

-- provides: U2, T3.2 (P is preserved when present, S-6)
theorem condP_expand {E E' : Forest} {n : Nat} (hE : Scan.InL E) (hP : CondP E)
    (h : expand E n = some E') : CondP E' := by
  by_cases hE0 : E = Tree.empty
  · subst hE0; rw [expand_empty] at h; cases h; exact condP_empty
  obtain ⟨k, hk⟩ := Option.isSome_iff_exists.1 (stepKind_isSome hE0 hE.1 hE.2.1)
  cases k with
  | deletion =>
    obtain ⟨j, -, rfl⟩ := expand_safePrefix hE0 hE.1 hE.2.1 (Or.inl hk) h
    exact safePrefix_condP hE hP j
  | special => exact condP_special hE hP hk h
  | ordinary => exact condP_ord hE hP hk h

-- provides: U2, T3.2
theorem std_inL {E : Forest} (h : IsStd E) : Scan.InL E := by
  induction h with
  | seed m => exact seed_inL m
  | expand n _ hexp ih => exact inL_expand ih hexp

-- provides: U2, T3.2
theorem std_condP {E : Forest} (h : IsStd E) : CondP E := by
  induction h with
  | seed m => exact seed_condP m
  | expand n hstd hexp ih => exact condP_expand (std_inL hstd) ih hexp

-- provides: U2, T3.2 (strict decrease; the paper's statement asks only V, I)
theorem expand_lt {E E' : Forest} {n : Nat} (hE : E ≠ Tree.empty) (hV : Scan.CondV E)
    (hI : Scan.CondI E) (h : expand E n = some E') : E' < E := by
  obtain ⟨k, hk⟩ := Option.isSome_iff_exists.1 (stepKind_isSome hE hV hI)
  cases k with
  | deletion =>
    rw [expand_deletion hk] at h
    cases h
    obtain ⟨cs, hcs⟩ := List.getLast?_eq_some_iff.1 ((stepKind_deletion_iff E).1 hk)
    obtain ⟨cols⟩ := E
    simp only [Tree.cols] at hcs ⊢
    subst hcs
    show Tree.cmp compare _ _ = .lt
    simp only [Tree.cmp, List.dropLast_concat]
    have := cmpCols_append_left_D3 cs [] [[]]
    rw [List.append_nil] at this
    rw [this]; rfl
  | special =>
    obtain ⟨sd, hsd⟩ := Option.isSome_iff_exists.mp (stopData_of_stepKind hk (by decide))
    obtain ⟨sd', hsd', hs⟩ := (stepKind_special_iff E).mp hk
    rw [hsd] at hsd'; cases hsd'
    have hpos : 0 < sd.depth := by
      simp only [specialStop, Bool.and_eq_true, decide_eq_true_eq] at hs; exact hs.1.1
    obtain ⟨oe, col, p0, hoe, -, hcol, hlastc, -⟩ := ownerEntry_data hsd hpos
    obtain ⟨-, -, -, col', p, Fl, hcol', hlast, -, hFl⟩ := ownerEntry_spec hk hsd hoe
    rw [hcol] at hcol'; cases hcol'
    rw [expand_eq_paperOp hE hV hI, paperOp_special hk hsd hoe hcol hlast] at h
    cases h
    obtain ⟨hR, -⟩ := stop_route_top_D3 hsd
    have hR' : RouteOK_D3 (sd.depth - 1) E := routeOK_le_D3 _ _ _ hR (by omega)
    have hrc : routeCol_D3 (sd.depth - 1) E = col := by simp [routeCol_D3, hlastc]
    rw [Hole.fill_eq_put, shift_zero]
    refine put_lt_D3 hR' ?_
    rw [hrc]
    obtain ⟨P, rfl⟩ := List.getLast?_eq_some_iff.1 hlast
    rw [List.dropLast_concat]
    exact special_col_lt_D3 P p Fl (by intro he; rw [he] at hFl; simp at hFl) _
  | ordinary =>
    obtain ⟨sd, hsd⟩ := Option.isSome_iff_exists.mp (stopData_of_stepKind hk (by decide))
    obtain ⟨rd, hrd⟩ := Option.isSome_iff_exists.mp (rootData_of_ordinary hk)
    rw [expand_eq_paperOp hE hV hI, paperOp_ordinary hk hsd hrd] at h
    split at h
    · cases h
    · cases h
      obtain ⟨hR, -⟩ := stop_route_top_D3 hsd
      obtain ⟨-, -, -, h4, -⟩ := stopData_core hsd
      have hrc : routeCol_D3 sd.depth E = sd.Q ++ [(sd.r, Tree.empty)] := by
        simp [routeCol_D3, h4]
      show replaceAt 0 0 _ sd.depth E < E
      refine put_lt_D3 hR ?_
      rw [hrc]; exact ordZ_lt_D3 hV hsd hrd n

/-! ## §T3.8 — cofinality -/

/-- T3.8n: cofinality with target `B` (the statement of T3.8 for one fixed target). -/
def Cof (B : Forest) : Prop :=
  ∀ E, InL E → B < E → ∃ n E', expand E n = some E' ∧ B ≤ E' ∧ E' < E

/-- T3.8n: kernel success for every upward literal `L` cap of `B`, in the covering form. -/
def KS (B : Forest) : Prop :=
  ∀ c k p, IsUpward B c k p → InL (litCap B c k p) → Covers (litCap B c k p) B

/-- L3.6: the conclusion of cap completion for target `B` (caps with V, I, decorated A). -/
def CC (B : Forest) : Prop :=
  ∀ c k p, IsUpward B c k p → CondV (litCap B c k p) → CondI (litCap B c k p) →
    CondAK (litCap B c k p) (capKeys (litCap B c k p) (routeCols (litCap B c k p))) →
    Success (litCap B c k p) (localSuffix B c)

-- T3.8a (txt:493): an empty last column is the least column
/-- T3.8a helper: the empty-column atom `(0, 0, 0)` is the least atom. -/
theorem ker_not_lt_bot (y : WordAtom) : ¬ y < toLex (0, toLex (0, 0)) := by
  intro h
  rw [Prod.Lex.lt_iff] at h
  simp only [ofLex_toLex] at h
  rcases h with h | ⟨_, h⟩
  · exact Nat.not_lt_zero _ h
  · rw [Prod.Lex.lt_iff] at h
    simp only [ofLex_toLex] at h
    rcases h with h | ⟨_, h⟩ <;> exact Nat.not_lt_zero _ h

/-- T3.8a helper: nothing lies strictly between `u` and `u ⌢ [(0,0,0)]` above `u`. -/
theorem ker_not_lt_append_bot :
    ∀ (u w : List WordAtom), u < w → ¬ w < u ++ [toLex (0, toLex (0, 0))]
  | [], [], h => absurd h (List.not_lt_nil _)
  | [], y :: w, _ => by
    intro h
    rw [List.nil_append, List.cons_lt_cons_iff] at h
    rcases h with h | ⟨_, h⟩
    · exact ker_not_lt_bot y h
    · exact List.not_lt_nil _ h
  | x :: u, [], h => absurd h (List.not_lt_nil _)
  | x :: u, y :: w, h => by
    intro h'
    rw [List.cons_lt_cons_iff] at h
    rw [List.cons_append, List.cons_lt_cons_iff] at h'
    rcases h with h | ⟨rfl, h⟩
    · rcases h' with h' | ⟨rfl, _⟩
      · exact lt_asymm h h'
      · exact lt_irrefl _ h
    · rcases h' with h' | ⟨_, h'⟩
      · exact lt_irrefl _ h'
      · exact ker_not_lt_append_bot u w h h'

theorem le_of_lt_append_empty {B F : Forest} (h : B < Tree.node (F.cols ++ [[]])) : B ≤ F := by
  rcases le_or_gt B F with h' | h'
  · exact h'
  · exfalso
    rw [← word_lt_iff] at h h'
    have hw : word (Tree.node (F.cols ++ [[]])) = word F ++ [toLex (0, toLex (0, 0))] := by
      unfold word
      rw [← ker_wordCols_cols 0 F]
      simp only [wordAt]
      rw [wordCols_append]
      rfl
    rw [hw] at h
    exact ker_not_lt_append_bot _ _ h' h

/-- T3.8b helper: words of kernel iterates are the word iterates. -/
theorem ker_word_iterate {E : Forest} {sd : StopData} {rd : RootData} (hV : CondV E)
    (hsd : stopData E = some sd) (hrd : rootData E = some rd) (hkd : KernelDefined E rd) :
    ∀ n, word ((kernel E sd rd)^[n] Tree.empty) = kerIter (kerPrefix E sd rd) (kerSigma sd rd) n
  | 0 => rfl
  | n + 1 => by
    rw [Function.iterate_succ_apply', word_kernel hV hsd hrd hkd, ker_word_iterate hV hsd hrd hkd n]
    rfl

/-- helper: KerRoute is downward closed. -/
theorem ker_route_pred : ∀ (k : Nat) (F : Forest), KerRoute (k + 1) F → KerRoute k F
  | 0, F, ⟨col, p, H, h1, _, _⟩ => by
    show F.cols ≠ []
    intro h; rw [h] at h1; cases h1
  | k + 1, F, ⟨col, p, H, h1, h2, h3⟩ => ⟨col, p, H, h1, h2, ker_route_pred k H h3⟩

/-- helper: the word of a column splits after a nonempty head. -/
theorem ker_wordCol_append (e : Nat) {l₁ : Column} (h : l₁ ≠ []) (l₂ : Column) :
    wordCol e (l₁ ++ l₂) = wordCol e l₁ ++ wordLater e l₂ := by
  obtain ⟨x, xs, rfl⟩ := List.exists_cons_of_ne_nil h
  obtain ⟨p, H⟩ := x
  simp only [List.cons_append, wordCol, ker_wordLater_append, List.append_assoc]

-- T3.8b: approximants strictly increase
theorem expand_strictMono {E X Y : Forest} {n n' : Nat} (hL : InL E)
    (hlast : E.cols.getLast? ≠ some []) (hE : E ≠ Tree.empty) (hnn : n < n')
    (hX : expand E n = some X) (hY : expand E n' = some Y) : X < Y := by
  obtain ⟨hV, hI, -⟩ := hL
  obtain ⟨knd, hknd⟩ := Option.isSome_iff_exists.1 (stepKind_isSome hE hV hI)
  cases knd with
  | deletion => exact absurd ((stepKind_deletion_iff E).1 hknd) hlast
  | ordinary =>
    obtain ⟨sd, hsd⟩ := Option.isSome_iff_exists.1 (stopData_of_stepKind hknd (by decide))
    obtain ⟨rd, hrd⟩ := Option.isSome_iff_exists.1 (rootData_of_ordinary hknd)
    obtain ⟨hX', -⟩ := ker_expand_out hV hI hknd hsd hrd hX
    obtain ⟨hY', hkd⟩ := ker_expand_out hV hI hknd hsd hrd hY
    have hkd := hkd (by omega)
    subst hX' hY'
    rw [← word_lt_iff, word_context hsd ((kernel E sd rd)^[n] Tree.empty),
      word_context hsd ((kernel E sd rd)^[n'] Tree.empty), ker_append_lt_append_iff,
      ker_word_iterate hV hsd hrd hkd, ker_word_iterate hV hsd hrd hkd]
    apply List.map_lt (fun x y h => depthShift_strictMono _ h)
    obtain ⟨t, ht⟩ := ker_kerIter_prefix_le (kerPrefix E sd rd) (kerSigma sd rd) (le_of_lt hnn)
    rw [← ht]
    apply ker_lt_append
    rintro rfl
    have := congrArg List.length ht
    rw [List.append_nil, kerIter_length, kerIter_length] at this
    have hP := List.length_pos_of_ne_nil (kerPrefix_ne_nil E sd rd)
    have := Nat.eq_of_mul_eq_mul_right hP this
    omega
  | special =>
    obtain ⟨sd, hsd, hspec⟩ := (stepKind_special_iff E).1 hknd
    obtain ⟨oe, hoe⟩ := Option.isSome_iff_exists.1 (ownerEntry_of_special hknd hsd)
    obtain ⟨-, -, -, col, p, Fl, hcol, hlastc, -, -⟩ := ownerEntry_spec hknd hsd hoe
    rw [expand_eq_paperOp hE hV hI, paperOp_special hknd hsd hoe hcol hlastc] at hX hY
    cases hX; cases hY
    have hdpos : 0 < sd.depth := by
      unfold specialStop at hspec
      simp only [Bool.and_eq_true, decide_eq_true_eq] at hspec
      exact hspec.1.1
    obtain ⟨G, hG, hR⟩ := ker_route_of_stop hsd 0 (Nat.zero_le _)
    simp only [List.take_zero, Tree.forestAt, Option.some.injEq] at hG
    subst hG
    have hR' : KerRoute (sd.depth - 1) E :=
      ker_route_pred _ _ (by rw [show sd.depth - 1 + 1 = sd.depth - 0 by omega]; exact hR)
    rw [← word_lt_iff]
    show wordAt 0 (replaceAt 0 0 _ (sd.depth - 1) E) < wordAt 0 (replaceAt 0 0 _ (sd.depth - 1) E)
    conv_lhs => rw [ker_wordAt_replaceAt _ _ _ 0 hR']
    conv_rhs => rw [ker_wordAt_replaceAt _ _ _ 0 hR']
    rw [ker_append_lt_append_iff, Nat.zero_add, show sd.depth - 1 = 0 + (sd.depth - 1) by omega,
      wordAt_add, wordAt_add]
    apply List.map_lt (fun x y h => depthShift_strictMono _ h)
    have hne : col.dropLast ++ List.replicate (n + if col.dropLast.isEmpty then 1 else 0)
        (p, Tree.node Fl.cols.dropLast) ≠ [] := by
      by_cases hA : col.dropLast = []
      · rw [hA]; simp
      · intro h; exact hA (List.append_eq_nil_iff.1 h).1
    have hsplit : col.dropLast ++ List.replicate (n' + if col.dropLast.isEmpty then 1 else 0)
        (p, Tree.node Fl.cols.dropLast) =
        (col.dropLast ++ List.replicate (n + if col.dropLast.isEmpty then 1 else 0)
          (p, Tree.node Fl.cols.dropLast)) ++
          List.replicate (n' - n) (p, Tree.node Fl.cols.dropLast) := by
      rw [List.append_assoc, ← List.replicate_add]
      congr 2
      omega
    simp only [wordAt, wordCols, List.append_nil]
    rw [hsplit, ker_wordCol_append 0 hne]
    apply ker_lt_append
    obtain ⟨m, hm⟩ : ∃ m, n' - n = m + 1 := ⟨n' - n - 1, by omega⟩
    rw [hm, List.replicate_succ]
    simp [wordLater]

-- T3.8c: stop data of a literal cap
/-! ### T3.8c helpers: the route of a literal cap -/

theorem ker_stopCols_snoc (π : List (Nat × Nat)) (X : Column) :
    ∀ (A : List Column) (ci : Nat), stopCols π ci (A ++ [X]) = stopCol π (ci + A.length) 0 [] X
  | [], ci => by simp [stopCols]
  | a :: A, ci => by
    obtain ⟨y, ys, h⟩ := List.exists_cons_of_ne_nil (by simp : A ++ [X] ≠ [])
    rw [List.cons_append, h]
    simp only [stopCols]
    rw [← h, ker_stopCols_snoc π X A (ci + 1)]
    congr 1
    simp; omega

theorem ker_stopCol_snoc_stop (π : List (Nat × Nat)) (ci p : Nat) :
    ∀ (T : Column) (ei : Nat) (Q0 : Column),
      stopCol π ci ei Q0 (T ++ [(p, Tree.node [])]) =
        some ⟨π.length, ⟨π, ci⟩, ColAddr.num 0 ⟨π, ci⟩, p, Q0 ++ T⟩
  | [], ei, Q0 => by simp [stopCol]
  | t :: T, ei, Q0 => by
    obtain ⟨y, ys, h⟩ := List.exists_cons_of_ne_nil (by simp : T ++ [(p, Tree.node [])] ≠ [])
    rw [List.cons_append, h]
    simp only [stopCol]
    rw [← h, ker_stopCol_snoc_stop π ci p T (ei + 1) (Q0 ++ [t])]
    simp

theorem ker_stopCol_snoc_descend (π : List (Nat × Nat)) (ci q : Nat) (g : Column)
    (gs : List Column) :
    ∀ (T : Column) (ei : Nat) (Q0 : Column),
      stopCol π ci ei Q0 (T ++ [(q, Tree.node (g :: gs))]) =
        stopCols (π ++ [(ci, ei + T.length)]) 0 (g :: gs)
  | [], ei, Q0 => by simp [stopCol]
  | t :: T, ei, Q0 => by
    obtain ⟨y, ys, h⟩ := List.exists_cons_of_ne_nil
      (by simp : T ++ [(q, Tree.node (g :: gs))] ≠ [])
    rw [List.cons_append, h]
    simp only [stopCol]
    rw [← h, ker_stopCol_snoc_descend π ci q g gs T (ei + 1) (Q0 ++ [t])]
    congr 3
    simp; omega

/-- helper: unfolding one level of `litCapAux` at an existing entry. -/
theorem ker_litCapAux_cons (k p ci ei j : Nat) (rest : List (Nat × Nat)) (cols : List Column)
    {col : Column} {q : Nat} {h : Forest} (hc : cols[ci]? = some col) (he : col[ei]? = some (q, h)) :
    litCapAux k p ((ci, ei) :: rest) j (Tree.node cols) =
      Tree.node (cols.take ci ++ [col.take ei ++ [(q, litCapAux k p rest j h)]]) := by
  have hg : cols.getD ci [] = col := by rw [List.getD_eq_getElem?_getD, hc]; rfl
  simp only [litCapAux, hg, he]

/-- helper: the lookup of a column address one level down. -/
theorem ker_colAt_cons {α : Type} (cols : List (List (α × Tree α))) (ci ei j : Nat)
    (rest : List (Nat × Nat)) :
    (Tree.node cols).colAt ⟨(ci, ei) :: rest, j⟩ =
      ((cols[ci]?).bind (·[ei]?)).bind fun x => x.2.colAt ⟨rest, j⟩ := by
  unfold Tree.colAt
  simp only [ker_forestAt_cons, Tree.cols]
  cases (cols[ci]?).bind (·[ei]?) with
  | none => rfl
  | some x => rfl

/-- helper: a literal cap at an existing column is a nonempty forest. -/
theorem ker_litCapAux_ne (k p : Nat) :
    ∀ (σ : List (Nat × Nat)) (j : Nat) (F : Forest), (F.colAt ⟨σ, j⟩).isSome →
      ∃ g gs, litCapAux k p σ j F = Tree.node (g :: gs) ∧
        ∃ x xs, (g :: gs).getLast? = some (x :: xs)
  | [], j, .node cols, _ => by
    obtain ⟨g, gs, h⟩ := List.exists_cons_of_ne_nil
      (by simp : cols.take j ++ [(cols.getD j []).take k ++ [(p, Tree.empty)]] ≠ [])
    refine ⟨g, gs, by simp only [litCapAux]; rw [h], ?_⟩
    rw [← h, List.getLast?_append, List.getLast?_singleton]
    obtain ⟨x, xs, hx⟩ := List.exists_cons_of_ne_nil
      (by simp : (cols.getD j []).take k ++ [(p, Tree.empty)] ≠ [])
    exact ⟨x, xs, by rw [hx]; rfl⟩
  | (ci, ei) :: rest, j, .node cols, hc => by
    rw [ker_colAt_cons] at hc
    cases hcol : cols[ci]? with
    | none => rw [hcol] at hc; cases hc
    | some col =>
      rw [hcol, Option.bind_some] at hc
      cases hent : col[ei]? with
      | none => rw [hent] at hc; cases hc
      | some x =>
        obtain ⟨q, h⟩ := x
        rw [ker_litCapAux_cons k p ci ei j rest cols hcol hent]
        obtain ⟨g, gs, hg⟩ := List.exists_cons_of_ne_nil
          (by simp : cols.take ci ++ [col.take ei ++ [(q, litCapAux k p rest j h)]] ≠ [])
        refine ⟨g, gs, by rw [hg], ?_⟩
        rw [← hg, List.getLast?_append, List.getLast?_singleton]
        obtain ⟨y, ys, hy⟩ := List.exists_cons_of_ne_nil
          (by simp : col.take ei ++ [(q, litCapAux k p rest j h)] ≠ [])
        exact ⟨y, ys, by rw [hy]; rfl⟩

/-- helper: the route of a literal cap stops at its cap column. -/
theorem ker_stopF_litCapAux (k p : Nat) :
    ∀ (σ : List (Nat × Nat)) (j : Nat) (F : Forest) (π : List (Nat × Nat)),
      (F.colAt ⟨σ, j⟩).isSome →
      stopF π (litCapAux k p σ j F) =
        some ⟨(π ++ σ).length, ⟨π ++ σ, j⟩, ColAddr.num 0 ⟨π ++ σ, j⟩, p,
          ((F.colAt ⟨σ, j⟩).getD []).take k⟩
  | [], j, .node cols, π, hc => by
    have hj : j < cols.length := by
      unfold Tree.colAt at hc
      simp only [Tree.forestAt, Option.bind_some, Tree.cols] at hc
      by_contra h; rw [List.getElem?_eq_none (by omega)] at hc; cases hc
    simp only [litCapAux, stopF]
    rw [ker_stopCols_snoc, List.length_take, Nat.min_eq_left (by omega), Nat.zero_add]
    rw [show (p, Tree.empty) = (p, (Tree.node [] : Forest)) from rfl, ker_stopCol_snoc_stop]
    simp only [List.append_nil, List.nil_append]
    congr 3
  | (ci, ei) :: rest, j, .node cols, π, hc => by
    have hc' := hc
    rw [ker_colAt_cons] at hc'
    cases hcol : cols[ci]? with
    | none => rw [hcol] at hc'; cases hc'
    | some col =>
      rw [hcol, Option.bind_some] at hc'
      cases hent : col[ei]? with
      | none => rw [hent] at hc'; cases hc'
      | some x =>
        obtain ⟨q, h⟩ := x
        rw [hent, Option.bind_some] at hc'
        have hci : ci < cols.length := by
          by_contra hh; rw [List.getElem?_eq_none (by omega)] at hcol; cases hcol
        have hei : ei < col.length := by
          by_contra hh; rw [List.getElem?_eq_none (by omega)] at hent; cases hent
        rw [ker_litCapAux_cons k p ci ei j rest cols hcol hent]
        obtain ⟨g, gs, hg, -⟩ := ker_litCapAux_ne k p rest j h hc'
        simp only [stopF]
        rw [ker_stopCols_snoc, List.length_take, Nat.min_eq_left (by omega), Nat.zero_add, hg,
          ker_stopCol_snoc_descend, List.length_take, Nat.min_eq_left (by omega), Nat.zero_add]
        have ih := ker_stopF_litCapAux k p rest j h (π ++ [(ci, ei)]) hc'
        rw [hg] at ih
        simp only [stopF] at ih
        rw [ih, ker_colAt_cons, hcol, Option.bind_some, hent, Option.bind_some]
        simp only [List.append_assoc, List.singleton_append]

/-- helper: replacing the cap column by `∅` gives a forest below the original. -/
theorem ker_cmpCols_append_left (A B C : List Column) :
    Tree.cmpCols compare (A ++ B) (A ++ C) = Tree.cmpCols compare B C := by
  induction A with
  | nil => rfl
  | cons a A ih =>
    simp only [List.cons_append, Tree.cmpCols]
    rw [Tree.cmpCol_self compare a, ih]
    rfl

theorem ker_cmp_snoc_lt (A R : List Column) (T R2 : Column) (q : Nat) {X' H : Forest}
    (hX : X' < H) :
    Tree.cmp compare (Tree.node (A ++ [T ++ [(q, X')]])) (Tree.node (A ++ (T ++ (q, H) :: R2) :: R))
      = .lt := by
  simp only [Tree.cmp]
  rw [ker_cmpCols_append_left]
  simp only [Tree.cmpCols]
  rw [ker_cmpCol_append_left]
  simp only [Tree.cmpCol]
  have hX' : Tree.cmp compare X' H = .lt := hX
  rw [hX', Nat.compare_eq_eq.2 rfl]
  rfl

theorem ker_context_litCapAux_lt (k p : Nat) :
    ∀ (σ : List (Nat × Nat)) (j : Nat) (F : Forest), (F.colAt ⟨σ, j⟩).isSome →
      replaceAt 0 0 Tree.empty σ.length (litCapAux k p σ j F) < F
  | [], j, .node cols, hc => by
    have hj : j < cols.length := by
      unfold Tree.colAt at hc
      simp only [Tree.forestAt, Option.bind_some, Tree.cols] at hc
      by_contra h; rw [List.getElem?_eq_none (by omega)] at hc; cases hc
    simp only [litCapAux, List.length_nil]
    rw [ker_replaceAt_zero_zero _ _ (by simp)]
    simp only [Tree.empty, Tree.cols, List.append_nil]
    rw [List.dropLast_concat]
    show Tree.cmp compare _ _ = .lt
    obtain ⟨y, ys, hy⟩ := List.exists_cons_of_ne_nil
      (by intro h; have := congrArg List.length h; simp at this; omega : cols.drop j ≠ [])
    have hsplit : cols = cols.take j ++ y :: ys := by rw [← hy, List.take_append_drop]
    have key : Tree.cmp compare (Tree.node (cols.take j ++ [])) (Tree.node (cols.take j ++ y :: ys))
        = .lt := by
      simp only [Tree.cmp]; rw [ker_cmpCols_append_left]; rfl
    rw [← hsplit, List.append_nil] at key
    exact key
  | (ci, ei) :: rest, j, .node cols, hc => by
    have hc' := hc
    rw [ker_colAt_cons] at hc'
    cases hcol : cols[ci]? with
    | none => rw [hcol] at hc'; cases hc'
    | some col =>
      rw [hcol, Option.bind_some] at hc'
      cases hent : col[ei]? with
      | none => rw [hent] at hc'; cases hc'
      | some x =>
        obtain ⟨q, h⟩ := x
        rw [hent, Option.bind_some] at hc'
        have hci : ci < cols.length := by
          by_contra hh; rw [List.getElem?_eq_none (by omega)] at hcol; cases hcol
        have hei : ei < col.length := by
          by_contra hh; rw [List.getElem?_eq_none (by omega)] at hent; cases hent
        have ih := ker_context_litCapAux_lt k p rest j h hc'
        rw [ker_litCapAux_cons k p ci ei j rest cols hcol hent, List.length_cons,
          ker_replaceAt_zero_succ, ker_mapLast_append _ _ _ _ (by simp), List.map_id]
        simp only [mapLast]
        rw [ker_mapLast_append _ _ _ _ (by simp), List.map_id]
        simp only [mapLast]
        obtain ⟨_, hcolE⟩ := List.getElem?_eq_some_iff.1 hcol
        obtain ⟨_, hentE⟩ := List.getElem?_eq_some_iff.1 hent
        have hcols : cols = cols.take ci ++ col :: cols.drop (ci + 1) := by
          conv_lhs => rw [← List.take_append_drop ci cols]
          rw [List.drop_eq_getElem_cons hci, hcolE]
        have hcol2 : col = col.take ei ++ (q, h) :: col.drop (ei + 1) := by
          conv_lhs => rw [← List.take_append_drop ei col]
          rw [List.drop_eq_getElem_cons hei, hentE]
        have key := ker_cmp_snoc_lt (cols.take ci) (cols.drop (ci + 1)) (col.take ei)
          (col.drop (ei + 1)) q ih
        rw [← hcol2, ← hcols] at key
        exact key

theorem stopData_litCap {B : Forest} {c : ColAddr} {k p : Nat} (hup : IsUpward B c k p) :
    stopData (litCap B c k p) =
      some ⟨colDepth c, c, c.num 0, p, ((B.colAt c).getD []).take k⟩ := by
  have hc : (B.colAt c).isSome := by
    unfold IsUpward at hup
    split at hup
    · rename_i col hcol; rw [hcol]; rfl
    · exact hup.elim
  unfold stopData stopDataBody litCap litCapBody
  rw [if_pos hc, ker_stopF_litCapAux k p c.path c.col B [] hc]
  rfl

-- T3.8c (txt:539-540): an upward cap of an I-expression that satisfies V and I is ordinary
theorem litCap_ordinary {B : Forest} (hI : CondI B) {c : ColAddr} {k p : Nat}
    (hup : IsUpward B c k p) (hKV : CondV (litCap B c k p)) (hKI : CondI (litCap B c k p)) :
    stepKind (litCap B c k p) = some .ordinary := by
  have hsd := stopData_litCap hup
  obtain ⟨col, hcol⟩ : ∃ col, B.colAt c = some col := by
    unfold IsUpward at hup
    split at hup
    · rename_i col hcol; exact ⟨col, hcol⟩
    · exact hup.elim
  have hc : (B.colAt c).isSome := by rw [hcol]; rfl
  rw [hcol, Option.getD_some] at hsd
  obtain ⟨g, gs, hg, x, xs, hlast⟩ := ker_litCapAux_ne k p c.path c.col B hc
  have hK : litCap B c k p = Tree.node (g :: gs) := by
    unfold litCap litCapBody; rw [if_pos hc]; exact hg
  have hspec : specialStop ⟨colDepth c, c, c.num 0, p, col.take k⟩ = false := by
    unfold specialStop
    by_contra hcon
    simp only [Bool.not_eq_false, Bool.and_eq_true, decide_eq_true_eq, List.isEmpty_iff,
      beq_iff_eq] at hcon
    obtain ⟨⟨hd, hQ⟩, hnum⟩ := hcon
    unfold colDepth at hd
    have hpne : c.path ≠ [] := by intro h; rw [h] at hd; simp at hd
    obtain ⟨pre, last, hpath⟩ : ∃ pre last, c.path = pre ++ [last] :=
      ⟨c.path.dropLast, c.path.getLast hpne, (List.dropLast_append_getLast hpne).symm⟩
    obtain ⟨ci, ei⟩ := last
    have hfa : B.forestAt c.path = B.heightAt ⟨⟨pre, ci⟩, ei⟩ := by
      rw [← Tree.forestAt_heightPath]
      simp [EntryAddr.heightPath, hpath]
    have hcol' := hcol
    unfold Tree.colAt at hcol'
    cases hF : B.forestAt c.path with
    | none => rw [hF] at hcol'; cases hcol'
    | some h =>
      rw [hF, Option.bind_some] at hcol'
      have hh : B.heightAt ⟨⟨pre, ci⟩, ei⟩ = some h := by rw [← hfa, hF]
      obtain ⟨y, hy⟩ : ∃ y, B.entryAt ⟨⟨pre, ci⟩, ei⟩ = some (y, h) := by
        unfold Tree.heightAt at hh
        cases hE : B.entryAt ⟨⟨pre, ci⟩, ei⟩ with
        | none => rw [hE] at hh; cases hh
        | some z =>
          rw [hE] at hh
          simp only [Option.map_some, Option.some.injEq] at hh
          exact ⟨z.1, by rw [← hh]⟩
      have hmem : (⟨⟨pre, ci⟩, ei⟩ : EntryAddr) ∈ B.entryAddrs :=
        (Tree.mem_entryAddrs_iff _ _).2 (by rw [hy]; rfl)
      have hne : h ≠ Tree.empty := by
        intro h0; subst h0; simp [Tree.empty, Tree.cols] at hcol'
      have hcolmem : col ∈ h.cols := List.mem_of_getElem? hcol'
      obtain ⟨q, H, rest, hcq, hq⟩ := hI _ hmem y h hy hne col hcolmem
      have hk0 : k = 0 := by
        rw [hcq] at hQ
        rcases List.take_eq_nil_iff.1 hQ with h0 | h0
        · exact h0
        · cases h0
      subst hk0
      unfold IsUpward at hup
      rw [hcol, hcq] at hup
      simp only [List.getElem?_cons_zero] at hup
      have hpn : p = ColAddr.num 0 ⟨pre, ci⟩ := by
        unfold ColAddr.num at hnum ⊢
        simp only [hpath, List.map_append, List.sum_append, List.map_cons,
          List.map_nil, List.sum_cons, List.sum_nil] at hnum ⊢
        omega
      have hq' : ColAddr.num 0 ⟨pre, ci⟩ ≤ q := hq
      omega
  have hres : (c.resolve 0 p).isSome := by
    obtain ⟨hcolK, -⟩ := stopData_spec hsd
    have hent : (litCap B c k p).entryAt ⟨c, (col.take k).length⟩ = some (p, Tree.empty) := by
      unfold Tree.entryAt; rw [hcolK]; simp
    have hmemK := (Tree.mem_entryAddrs_iff _ _).2 (by rw [hent]; rfl)
    exact hKV _ hmemK p Tree.empty hent
  unfold stepKind stepKindBody
  have hl' : (litCap B c k p).cols.getLast? = some (x :: xs) := by rw [hK]; exact hlast
  rw [hl']
  simp only []
  rw [show stopDataBody (litCap B c k p) = _ from hsd]
  simp only [hspec, hres, Bool.false_eq_true, if_false, if_true]

-- T3.8c: the approximant at `0` of a cap lies strictly below its target
-- VERIFY-U2 (F6): `hI` added (the doc's proof uses part 2, which needs I of `B`)
theorem expand_zero_litCap_lt {B : Forest} (hI : CondI B) {c : ColAddr} {k p : Nat}
    (hup : IsUpward B c k p)
    (hKV : CondV (litCap B c k p)) (hKI : CondI (litCap B c k p)) {K0 : Forest}
    (h0 : expand (litCap B c k p) 0 = some K0) : K0 < B := by
  have hsd := stopData_litCap hup
  have hord := litCap_ordinary hI hup hKV hKI
  have hKne : litCap B c k p ≠ Tree.empty := by
    intro h; rw [h] at hsd; simp [stopData, stopDataBody, stopF, stopCols, Tree.empty] at hsd
  rw [expand_zero_eq_context hKne hKV hKI hord hsd] at h0
  cases h0
  have hc : (B.colAt c).isSome := by
    unfold IsUpward at hup
    split at hup
    · rename_i col hcol; rw [hcol]; rfl
    · exact hup.elim
  unfold context litCap litCapBody
  rw [if_pos hc]
  exact ker_context_litCapAux_lt k p c.path c.col B hc

-- N2.2: the word of `B` at a column: context prefix, local suffix at depth `e`, shallower rest
theorem word_localSuffix {B : Forest} {c : ColAddr} (hc : c ∈ B.colAddrs) :
    ∃ S, word B = (word B).take (capPos B c 0) ++ (word (localSuffix B c)).map (depthShift (colDepth c)) ++ S ∧
      ∀ y ∈ S.head?, (ofLex y).1 < 2 * colDepth c := by sorry

-- N2.2: filling a cap with its complete local suffix restores the target up to the end of the
-- cap column's forest (all of the target when that forest is on the target's route)
theorem context_litCap_localSuffix {B : Forest} {c : ColAddr} {k p : Nat} (hup : IsUpward B c k p)
    {sd : StopData} (hsd : stopData (litCap B c k p) = some sd) :
    context (litCap B c k p) sd (localSuffix B c) =
      safePrefix B (capPos B c 0 + mu (localSuffix B c)) := by sorry

-- T3.8d (txt:496-499): between `E[1]` and `E`, `E` is an upward literal cap of the target
theorem ordinary_cap_of_between {E B E1 : Forest} {sd : StopData} (hL : InL E)
    (hk : stepKind E = some .ordinary) (hsd : stopData E = some sd) (h1 : expand E 1 = some E1)
    (hlo : E1 < B) (hhi : B < E) :
    IsUpward B sd.col sd.Q.length sd.r ∧ litCap B sd.col sd.Q.length sd.r = E := by sorry

-- T3.8e (txt:500-503): special steps cover within the bound
theorem special_cover {E B : Forest} (hL : InL E) (hB : InL B) (hk : stepKind E = some .special)
    (hlt : B < E) : ∃ n E', 1 ≤ n ∧ n ≤ mu B + 1 ∧ expand E n = some E' ∧ B < E' := by sorry

-- T3.8f: covering is kernel success at the complete local suffix (word criterion + context)
theorem covers_iff_success {B : Forest} {c : ColAddr} {k p : Nat} (hB : CondI B)
    (hup : IsUpward B c k p) (hKV : CondV (litCap B c k p)) (hKI : CondI (litCap B c k p))
    (hdef : ∀ rd, rootData (litCap B c k p) = some rd → KernelDefined (litCap B c k p) rd) :
    Covers (litCap B c k p) B ↔ Success (litCap B c k p) (localSuffix B c) := by sorry

-- T3.8f: the explicit bound
theorem covers_bound {B : Forest} {c : ColAddr} {k p : Nat} (hB : CondI B)
    (hup : IsUpward B c k p) (hKL : InL (litCap B c k p))
    (h : Success (litCap B c k p) (localSuffix B c)) :
    ∃ q K', 1 ≤ q ∧ q ≤ mu B + 1 ∧ expand (litCap B c k p) q = some K' ∧ B < K' := by sorry

-- L3.4f (txt:428-429, 436-437): a full cut at the end of the target succeeds
theorem fullCut_success {B : Forest} {c : ColAddr} {k p : Nat} (hup : IsUpward B c k p)
    (hKL : InL (litCap B c k p)) (hend : capPos B c k = mu B) :
    Success (litCap B c k p) (localSuffix B c) := by sorry

-- T3.8h (txt:511-512): a cap above a covered old target is covered
theorem covers_of_gt {A B K : Forest} (hcof : Cof A) (hKL : InL K) (hKne : K ≠ Tree.empty)
    (hlast : K.cols.getLast? ≠ some []) (hAK : A < K) (hBA : B ≤ A)
    (hK0 : ∀ K0, expand K 0 = some K0 → K0 < B) : Covers K B := by sorry

-- T3.8g: kernel success for all caps gives cofinality with the bound
theorem cof_of_KS {B : Forest} (hB : InL B) (hKS : KS B) : Cof B := by sorry
theorem bound_of_KS {B E : Forest} (hB : InL B) (hKS : KS B) (hE : InL E) (hlt : B < E)
    (hlast : E.cols.getLast? ≠ some []) :
    ∃ n E', 1 ≤ n ∧ n ≤ mu B + 1 ∧ expand E n = some E' ∧ B < E' := by sorry

-- L3.6a (txt:463-465): reversing one repair: the complete old suffixes compare `Y_i ≥ Y_j`
theorem repair_suffix_ge {B : Forest} (hH : CondH B) {cj ci : ColAddr} {k p : Nat}
    (hj : IsUpward B cj k p) (hi : IsUpward B ci k p)
    (hmove : ∃ m, MoveOK (litCap B cj k p) m ∧ applyMove (litCap B cj k p) m = litCap B ci k p) :
    localSuffix B cj ≤ localSuffix B ci := by sorry

-- L3.6b (txt:466-481): success transfers backward through one legal move
-- VERIFY-U2 (F5): `hP` added; step 1 gets S of the cap from L3.1e, which needs P of `B`
theorem success_unmove {B : Forest} (hL : InL B) (hP : CondP B) {cj ci : ColAddr} {k p : Nat}
