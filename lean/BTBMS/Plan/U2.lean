-- T3.8lk (txt:547-552): current head root `ρ = s_φ`: high scans conjugate, low scans win
theorem root_head (S : OrdStep) {i : Nat} {a c : ColAddr} {k ρ : Nat} (hi : 1 ≤ i ∧ i ≤ S.n)
