/-! ## D3.1 — profiles, tower keys, literal caps, cap positions -/

/-- D3.1 bridge (`rfl` once the body replaces the spine's `sorry`). -/
theorem profile_eq_body (H : Forest) : profile H = profileBody H := by sorry

/-- D3.1b: the pure tower key at relative level `k`: `d` further singleton levels with labels
`(true, k), (true, k+1), …`, ending in a column of `m` entries `((true, k+d), ∅)`. -/
def towKeyAt : Nat → Nat → Nat → Key
  | k, 0, m => .node [List.replicate m ((true, k), Tree.empty)]
  | k, d + 1, m => .node [[((true, k), towKeyAt (k + 1) d m)]]

/-- D3.1b: `h_a(Γ)` for the tower `Γ` of depth `d` and terminal multiplicity `m` (txt:269-272:
`Γ(J)` is `towKey d (m+1)` when `π(J) = (d, m)`). -/
def towKey (d m : Nat) : Key := towKeyAt 0 d m

/-- D3.1 bridge. -/
theorem litCap_eq_body (E : Forest) (c : ColAddr) (k p : Nat) :
    litCap E c k p = litCapBody E c k p := by sorry

/-- D3.1c: depth of a column address (`0` for the outer forest). -/
def colDepth (c : ColAddr) : Nat := c.path.length

/-- D3.1c: the word atom of the appended closing entry `(p, ∅)` of a cap at cut `k`: a column
marker `(2e, 1, p)` at cut `0`, a continuation `(2e+1, 0, p)` otherwise. -/
def capAtom (c : ColAddr) (k p : Nat) : WordAtom :=
  if k = 0 then toLex (2 * colDepth c, toLex (1, p)) else toLex (2 * colDepth c + 1, toLex (0, p))

/-- D3.1c: the cut position of `(c, k)` in `w(E)`: the number of atoms of `w(E)` kept by a
literal cap at `(c, k)` (L3.1c shows the cap's word is that prefix plus `capAtom`). -/
def capPos (E : Forest) (c : ColAddr) (k : Nat) : Nat := (word (litCap E c k 0)).length - 1

/-- D3.1c: the complete local suffix at column `c`: the columns `c, c+1, …` of the forest that
contains `c` (txt:460, 478). -/
def localSuffix (B : Forest) (c : ColAddr) : Forest :=
  .node (((B.forestAt c.path).getD Tree.empty).cols.drop c.col)

