namespace BTBMS

universe u

/-! D6.1a helpers on trees: labels kept by truncation, roles and labels kept by `setHeight`. -/

namespace Tree

variable {α : Type}

/-- D6.1a helper: every entry of `t'` is an entry of `t` with the same label. -/
def LabelSub (t' t : Tree α) : Prop :=
  ∀ e' y, t'.entryAt e' = some y → ∃ h, t.entryAt e' = some (y.1, h)

theorem LabelSub.refl (t : Tree α) : LabelSub t t := fun _ y hy => ⟨y.2, by simp [hy]⟩

theorem entryAt_nil (cols : List (List (α × Tree α))) (j i : Nat) :
    (Tree.node cols).entryAt ⟨⟨[], j⟩, i⟩ = cols[j]?.bind (·[i]?) := rfl

theorem labelSub_node {cols' cols : List (List (α × Tree α))}
    (h : ∀ (a b : Nat) (y : α × Tree α), (cols'[a]?.bind (·[b]?)) = some y →
      ∃ y' : α × Tree α, cols[a]?.bind (·[b]?) = some y' ∧ y.1 = y'.1 ∧ LabelSub y.2 y'.2) :
    LabelSub (Tree.node cols') (Tree.node cols) := by
  rintro ⟨⟨P, j⟩, i⟩ y hy
  cases P with
  | nil =>
    rw [entryAt_nil] at hy ⊢
    obtain ⟨y', hy', h1, -⟩ := h j i y hy
    exact ⟨y'.2, by rw [hy', h1]⟩
  | cons ab P =>
    obtain ⟨a, b⟩ := ab
    rw [entryAt_cons, Option.bind_eq_some_iff] at hy
    obtain ⟨z, hz, hy⟩ := hy
    obtain ⟨z', hz', -, hsub⟩ := h a b z hz
    obtain ⟨h', hh'⟩ := hsub _ y hy
    refine ⟨h', ?_⟩
    rw [entryAt_cons, Option.bind_eq_some_iff]
    exact ⟨z', hz', hh'⟩

theorem getElem?_take_bind {β : Type} {l : List β} {n m : Nat} {x : β} (h : (l.take n)[m]? = some x) :
    l[m]? = some x := by
  rw [List.getElem?_take] at h
  split_ifs at h; exact h

/-- D6.1a helper: truncation keeps the labels of the entries it keeps. -/
theorem labelSub_truncAux (P : List (Nat × Nat)) :
    ∀ (t : Tree α) (j i : Nat), LabelSub (truncAux P j i t) t := by
  induction P with
  | nil =>
    rintro ⟨cols⟩ j i
    apply labelSub_node
    intro a b y hy
    refine ⟨y, ?_, rfl, LabelSub.refl _⟩
    rw [Option.bind_eq_some_iff] at hy ⊢
    obtain ⟨col', hcol', hy⟩ := hy
    rw [List.getElem?_append] at hcol'
    split_ifs at hcol' with ha
    · exact ⟨col', getElem?_take_bind hcol', hy⟩
    · simp only [List.length_take] at ha hcol'
      rw [List.getElem?_singleton] at hcol'
      split_ifs at hcol' with ha'
      cases hcol'
      rw [List.getD_eq_getElem?_getD] at hy
      cases hj : cols[j]? with
      | none => rw [hj] at hy; simp at hy
      | some col =>
        rw [hj, Option.getD_some] at hy
        have hjl : j < cols.length := (List.getElem?_eq_some_iff.1 hj).1
        have : a = j := by omega
        subst this
        exact ⟨col, hj ▸ rfl, getElem?_take_bind hy⟩
  | cons ci P ih =>
    obtain ⟨c, i₀⟩ := ci
    rintro ⟨cols⟩ j i
    apply labelSub_node
    intro a b y hy
    rw [Option.bind_eq_some_iff] at hy
    obtain ⟨col', hcol', hy⟩ := hy
    rw [List.getElem?_append] at hcol'
    split_ifs at hcol' with ha
    · exact ⟨y, by rw [getElem?_take_bind hcol']; simpa using hy, rfl, LabelSub.refl _⟩
    · simp only [List.length_take] at ha hcol'
      rw [List.getElem?_singleton] at hcol'
      split_ifs at hcol' with ha'
      cases hcol'
      rw [List.getD_eq_getElem?_getD] at hy
      cases hc : cols[c]? with
      | none => rw [hc] at hy; simp at hy
      | some col =>
      rw [hc, Option.getD_some] at hy
      have hcl : c < cols.length := (List.getElem?_eq_some_iff.1 hc).1
      have : a = c := by omega
      subst this
      rw [List.getElem?_append] at hy
      split_ifs at hy with hb
      · exact ⟨y, by rw [hc]; simpa using getElem?_take_bind hy, rfl, LabelSub.refl _⟩
      · simp only [List.length_take] at hb hy
        cases hx : col[i₀]? with
        | none => rw [hx] at hy; simp at hy
        | some x =>
          rw [hx] at hy
          simp only [Option.map_some, Option.toList_some, List.getElem?_singleton] at hy
          split_ifs at hy with hb'
          cases hy
          have hil : i₀ < col.length := (List.getElem?_eq_some_iff.1 hx).1
          have : b = i₀ := by omega
          subst this
          exact ⟨x, by rw [hc]; simpa using hx, rfl, ih x.2 j i⟩

theorem labelSub_truncAfter (t : Tree α) (e : EntryAddr) : LabelSub (t.truncAfter e) t := by
  show LabelSub (t.truncAfterBody e) t
  unfold truncAfterBody
  split_ifs
  · exact labelSub_truncAux _ _ _ _
  · exact LabelSub.refl _

theorem getElem?_modify_modify (cols : List (List (α × Tree α))) (a b : Nat)
    (g : α × Tree α → α × Tree α) (a' b' : Nat) :
    ((cols.modify a (fun col => col.modify b g))[a']?.bind (·[b']?)) =
      if a' = a ∧ b' = b then (cols[a]?.bind (·[b]?)).map g else cols[a']?.bind (·[b']?) := by
  rw [List.getElem?_modify]
  cases hc : cols[a']? with
  | none =>
    by_cases h : a' = a
    · subst h; simp [hc]
    · simp [h]
  | some col =>
    by_cases h : a' = a
    · subst h
      simp only [Option.map_eq_map, Option.map_some, if_true, Option.bind_some, hc]
      rw [List.getElem?_modify]
      by_cases hb : b' = b
      · subst hb; simp
      · simp [hb, Ne.symm hb]
    · simp [h, Ne.symm h]

/-- D6.1a helper: `setAux` keeps the label of every entry outside the replaced height. -/
theorem entryAt_setAux_label (h : Tree α) (P : List (Nat × Nat)) :
    ∀ (t : Tree α) (j i : Nat) (e' : EntryAddr) (y : α × Tree α),
      (setAux h P j i t).entryAt e' = some y → ¬ (P ++ [(j, i)]) <+: e'.col.path →
      ∃ h', t.entryAt e' = some (y.1, h') := by
  induction P with
  | nil =>
    rintro ⟨cols⟩ j i ⟨⟨P', j'⟩, i'⟩ y hy hpre
    simp only [setAux] at hy
    cases P' with
    | nil =>
      rw [entryAt_nil, getElem?_modify_modify] at hy
      rw [entryAt_nil]
      split_ifs at hy with hab
      · obtain ⟨rfl, rfl⟩ := hab
        obtain ⟨x, hx, rfl⟩ := Option.map_eq_some_iff.1 hy
        exact ⟨x.2, hx⟩
      · exact ⟨y.2, by simp [hy]⟩
    | cons ab P' =>
      obtain ⟨a, b⟩ := ab
      rw [entryAt_cons] at hy
      simp only [Tree.cols] at hy
      rw [getElem?_modify_modify] at hy
      rw [entryAt_cons]
      simp only [Tree.cols]
      have hab : ¬ (a = j ∧ b = i) := by
        rintro ⟨rfl, rfl⟩; exact hpre ⟨P', by simp⟩
      rw [if_neg hab] at hy
      exact ⟨y.2, by simpa using hy⟩
  | cons ci P ih =>
    obtain ⟨c, i₀⟩ := ci
    rintro ⟨cols⟩ j i ⟨⟨P', j'⟩, i'⟩ y hy hpre
    simp only [setAux] at hy
    cases P' with
    | nil =>
      rw [entryAt_nil, getElem?_modify_modify] at hy
      rw [entryAt_nil]
      split_ifs at hy with hab
      · obtain ⟨rfl, rfl⟩ := hab
        obtain ⟨x, hx, rfl⟩ := Option.map_eq_some_iff.1 hy
        exact ⟨x.2, hx⟩
      · exact ⟨y.2, by simp [hy]⟩
    | cons ab P' =>
      obtain ⟨a, b⟩ := ab
      rw [entryAt_cons] at hy
      simp only [Tree.cols] at hy
      rw [getElem?_modify_modify] at hy
      rw [entryAt_cons]
      simp only [Tree.cols]
      split_ifs at hy with hab
      · obtain ⟨rfl, rfl⟩ := hab
        rw [Option.bind_eq_some_iff] at hy
        obtain ⟨z, hz, hy⟩ := hy
        obtain ⟨x, hx, rfl⟩ := Option.map_eq_some_iff.1 hz
        have hpre' : ¬ (P ++ [(j, i)]) <+: P' := by
          rintro ⟨u, hu⟩; exact hpre ⟨u, by simp [← hu]⟩
        obtain ⟨h', hh'⟩ := ih x.2 j i ⟨⟨P', j'⟩, i'⟩ y hy hpre'
        exact ⟨h', by rw [hx]; simpa using hh'⟩
      · exact ⟨y.2, by simpa using hy⟩

/-- D6.1a helper: the roles of `setAux` around the replaced entry. -/
theorem roles_setAux (h : Tree α) (P : List (Nat × Nat)) :
    ∀ (t : Tree α) (j i : Nat) (p : α) (H : Tree α), t.entryAt ⟨⟨P, j⟩, i⟩ = some (p, H) →
    ∃ pre post, t.roles = pre ++ Role.slot ⟨⟨P, j⟩, i⟩ ::
        (H.roles.map (Role.under (P ++ [(j, i)])) ++ post) ∧
      (setAux h P j i t).roles = pre ++ Role.slot ⟨⟨P, j⟩, i⟩ ::
        (h.roles.map (Role.under (P ++ [(j, i)])) ++ post) := by
  induction P with
  | nil =>
    rintro ⟨cols⟩ j i p H he
    change (cols[j]?.bind (·[i]?)) = some (p, H) at he
    rw [Option.bind_eq_some_iff] at he
    obtain ⟨col, hcol, hx⟩ := he
    have hj : j < cols.length := (List.getElem?_eq_some_iff.1 hcol).1
    have hi : i < col.length := (List.getElem?_eq_some_iff.1 hx).1
    have hcj : cols[j] = col := (List.getElem?_eq_some_iff.1 hcol).2
    have hci : col[i] = (p, H) := (List.getElem?_eq_some_iff.1 hx).2
    have key : ∀ K : Tree α, (Tree.node (cols.take j ++ (col.take i ++ (p, K) :: col.drop (i + 1)) ::
        cols.drop (j + 1))).roles =
        (rolesCols [] 0 (cols.take j) ++ Role.ord ⟨[], j⟩ :: rolesCol [] j 0 (col.take i)) ++
          Role.slot ⟨⟨[], j⟩, i⟩ :: (K.roles.map (Role.under ([] ++ [(j, i)])) ++
            (rolesCol [] j (i + 1) (col.drop (i + 1)) ++ rolesCols [] (j + 1) (cols.drop (j + 1)))) := by
      intro K
      rw [roles, rolesF, rolesCols_append, rolesCols, rolesCol_append, rolesCol, ← rolesF_eq_map_under]
      simp only [List.length_take, Nat.min_eq_left (Nat.le_of_lt hj), Nat.min_eq_left (Nat.le_of_lt hi),
        Nat.zero_add, List.append_assoc, List.cons_append, List.nil_append]
    refine ⟨rolesCols [] 0 (cols.take j) ++ Role.ord ⟨[], j⟩ :: rolesCol [] j 0 (col.take i),
      rolesCol [] j (i + 1) (col.drop (i + 1)) ++ rolesCols [] (j + 1) (cols.drop (j + 1)), ?_, ?_⟩
    · rw [← key H]
      congr 1
      conv_lhs => rw [list_split_of_getElem? hcol]
      congr 2
      exact congrArg (· :: _) (list_split_of_getElem? hx)
    · rw [← key h]
      simp only [setAux]
      congr 1
      rw [List.modify_eq_take_cons_drop hj, hcj, List.modify_eq_take_cons_drop hi, hci]
  | cons ab P ih =>
    obtain ⟨a, b⟩ := ab
    rintro ⟨cols⟩ j i p H he
    rw [entryAt_cons, Option.bind_eq_some_iff] at he
    obtain ⟨⟨p', h'⟩, hab, he'⟩ := he
    simp only [Tree.cols, Option.bind_eq_some_iff] at hab
    obtain ⟨col, hcol, hx⟩ := hab
    have ha : a < cols.length := (List.getElem?_eq_some_iff.1 hcol).1
    have hb : b < col.length := (List.getElem?_eq_some_iff.1 hx).1
    have hca : cols[a] = col := (List.getElem?_eq_some_iff.1 hcol).2
    have hcb : col[b] = (p', h') := (List.getElem?_eq_some_iff.1 hx).2
    obtain ⟨pre', post', hr', hs'⟩ := ih h' j i p H he'
    have key : ∀ K : Tree α, (Tree.node (cols.take a ++ (col.take b ++ (p', K) :: col.drop (b + 1)) ::
        cols.drop (a + 1))).roles =
        rolesCols [] 0 (cols.take a) ++ Role.ord ⟨[], a⟩ :: (rolesCol [] a 0 (col.take b) ++
          Role.slot ⟨⟨[], a⟩, b⟩ :: (K.roles.map (Role.under [(a, b)]) ++
            (rolesCol [] a (b + 1) (col.drop (b + 1)) ++ rolesCols [] (a + 1) (cols.drop (a + 1))))) := by
      intro K
      rw [roles, rolesF, rolesCols_append, rolesCols, rolesCol_append, rolesCol, rolesF_eq_map_under]
      simp only [List.length_take, Nat.min_eq_left (Nat.le_of_lt ha), Nat.min_eq_left (Nat.le_of_lt hb),
        Nat.zero_add, List.append_assoc, List.cons_append, List.nil_append]
    have hu : (Role.under [(a, b)] ∘ Role.under (P ++ [(j, i)])) =
        Role.under ((a, b) :: P ++ [(j, i)]) := by
      funext x; simp [Role.under_under]
    refine ⟨rolesCols [] 0 (cols.take a) ++ Role.ord ⟨[], a⟩ :: (rolesCol [] a 0 (col.take b) ++
          Role.slot ⟨⟨[], a⟩, b⟩ :: pre'.map (Role.under [(a, b)])),
        post'.map (Role.under [(a, b)]) ++ (rolesCol [] a (b + 1) (col.drop (b + 1)) ++
          rolesCols [] (a + 1) (cols.drop (a + 1))), ?_, ?_⟩
    · have : Tree.node cols = Tree.node (cols.take a ++ (col.take b ++ (p', h') :: col.drop (b + 1)) ::
          cols.drop (a + 1)) := by
        congr 1
        conv_lhs => rw [list_split_of_getElem? hcol]
        congr 2
        exact list_split_of_getElem? hx
      rw [this, key h', hr']
      simp only [List.map_append, List.map_cons, List.map_map, hu, List.append_assoc,
        List.cons_append]
      rfl
    · have : setAux h ((a, b) :: P) j i (Tree.node cols) =
          Tree.node (cols.take a ++ (col.take b ++ (p', setAux h P j i h') :: col.drop (b + 1)) ::
            cols.drop (a + 1)) := by
        simp only [setAux]
        congr 1
        rw [List.modify_eq_take_cons_drop ha, hca, List.modify_eq_take_cons_drop hb, hcb]
      rw [this, key, hs']
      simp only [List.map_append, List.map_cons, List.map_map, hu, List.append_assoc,
        List.cons_append]
      rfl

/-- D6.1a helper: a role of `t` whose path passes through the height of `e` is a role of that
height placed under `e`. -/
theorem mem_height_of_prefix {t : Tree α} {e : EntryAddr} {p : α} {H : Tree α}
    (he : t.entryAt e = some (p, H)) {x : Role} (hx : x ∈ t.roles) (hp : e.heightPath <+: x.path) :
    x ∈ H.roles.map (Role.under e.heightPath) := by
  obtain ⟨σ, hσ⟩ := hp
  have hf : t.forestAt e.heightPath = some H := by rw [forestAt_heightPath]; simp [heightAt, he]
  have hcol : ∀ c : ColAddr, c.path = e.heightPath ++ σ → t.colAt c = H.colAt ⟨σ, c.col⟩ := by
    intro c hc
    unfold colAt
    rw [hc, forestAt_append, hf]
    rfl
  cases x with
  | ord c =>
    rw [mem_roles_iff] at hx
    simp only [Role.path] at hσ
    refine List.mem_map.2 ⟨.ord ⟨σ, c.col⟩, ?_, ?_⟩
    · rw [mem_roles_iff]; show (H.colAt _).isSome; rw [← hcol c hσ.symm]; exact hx
    · simp [Role.under, hσ]
  | slot e' =>
    rw [mem_roles_iff] at hx
    simp only [Role.path] at hσ
    refine List.mem_map.2 ⟨.slot ⟨⟨σ, e'.col.col⟩, e'.idx⟩, ?_, ?_⟩
    · rw [mem_roles_iff]
      have : t.entryAt e' = H.entryAt ⟨⟨σ, e'.col.col⟩, e'.idx⟩ := by
        unfold entryAt; rw [hcol e'.col hσ.symm]
      show (H.entryAt _).isSome; rw [← this]; exact hx
    · simp [Role.under, hσ]

/-! D7.1a helpers on trees: relabelling and reading inside a height. -/

theorem cols_map {β : Type} (f : α → β) (t : Tree α) :
    (t.map f).cols = t.cols.map (fun col => col.map fun x => (f x.1, x.2.map f)) := by
  cases t with
  | node cols =>
    show Tree.mapCols f cols = _
    rw [Scan.treeMapCols_eq_map]
    simp only [Tree.cols]
    congr 1
    funext col
    exact Scan.treeMapCol_eq_map f col

theorem forestAt_map {β : Type} (f : α → β) :
    ∀ (π : List (Nat × Nat)) (t : Tree α), (t.map f).forestAt π = (t.forestAt π).map (Tree.map f)
  | [], t => rfl
  | (c, i) :: rest, t => by
    rw [forestAt_cons, forestAt_cons, cols_map]
    cases h : t.cols[c]? with
    | none => simp [h]
    | some col =>
      simp only [List.getElem?_map, h, Option.map_some, Option.bind_some]
      cases h' : col[i]? with
      | none => simp
      | some x => simp [forestAt_map f rest x.2]

theorem colAt_map {β : Type} (f : α → β) (t : Tree α) (c : ColAddr) :
    (t.map f).colAt c = (t.colAt c).map (fun col => col.map fun x => (f x.1, x.2.map f)) := by
  unfold colAt
  rw [forestAt_map]
  cases t.forestAt c.path with
  | none => rfl
  | some F => simp [cols_map]

theorem entryAt_map {β : Type} (f : α → β) (t : Tree α) (e : EntryAddr) :
    (t.map f).entryAt e = (t.entryAt e).map (fun x => (f x.1, x.2.map f)) := by
  unfold entryAt
  rw [colAt_map]
  cases t.colAt e.col with
  | none => rfl
  | some col => simp

/-- D7.1a helper: columns and entries read inside the height of `e`. -/
theorem colAt_under {t : Tree α} {e : EntryAddr} {B : Tree α} (hB : t.heightAt e = some B)
    (P : List (Nat × Nat)) (j : Nat) : t.colAt ⟨e.heightPath ++ P, j⟩ = B.colAt ⟨P, j⟩ := by
  unfold colAt
  simp only
  rw [forestAt_append, forestAt_heightPath, hB]
  rfl

theorem entryAt_under {t : Tree α} {e : EntryAddr} {B : Tree α} (hB : t.heightAt e = some B)
    (P : List (Nat × Nat)) (j i : Nat) :
    t.entryAt ⟨⟨e.heightPath ++ P, j⟩, i⟩ = B.entryAt ⟨⟨P, j⟩, i⟩ := by
  unfold entryAt
  simp only
  rw [colAt_under hB]

theorem under_mem_roles {t : Tree α} {e : EntryAddr} {B : Tree α} (hB : t.heightAt e = some B)
    {r : Role} (hr : r ∈ B.roles) : r.under e.heightPath ∈ t.roles := by
  cases r with
  | ord c =>
    rw [mem_roles_iff] at hr ⊢
    show (t.colAt ⟨e.heightPath ++ c.path, c.col⟩).isSome
    rw [colAt_under hB]; exact hr
  | slot e' =>
    rw [mem_roles_iff] at hr ⊢
    show (t.entryAt ⟨⟨e.heightPath ++ e'.col.path, e'.col.col⟩, e'.idx⟩).isSome
    rw [entryAt_under hB]; exact hr

/-! L6.2a helpers on trees: roles do not read labels. -/

-- (merge) `rolesF_map` / `rolesCols_map` / `rolesCol_map`: identical statements are proved in U1 (D1.4b helpers).

theorem rolesCols_map' {β : Type} (f : α → β) (π : List (Nat × Nat)) (c : Nat) (cols : List (List (α × Tree α))) :
    rolesCols π c (cols.map (mapCol f)) = rolesCols π c cols := by
  rw [← Scan.treeMapCols_eq_map, rolesCols_map]

theorem rolesCol_map' {β : Type} (f : α → β) (π : List (Nat × Nat)) (c i : Nat) (col : List (α × Tree α)) :
    rolesCol π c i (col.map fun x => (f x.1, x.2.map f)) = rolesCol π c i col := by
  rw [← Scan.treeMapCol_eq_map, rolesCol_map]

end Tree

namespace Packet

open Hier

/-! ## D6.1a  Ownership of graph atoms, reading order, truncation and prefix lemmas -/

/-- D6.1a: the owner of a non-order atom: `lim x ↦ x`, `elem y x ↦ x` (the later column of an
ordinary pair), `edge s c o ↦ s` (the slot whose head edge it is). Order atoms have no owner. -/
def atomOwner {V : Type} : BaseAtom V → Option V
  | .lim x => some x
  | .elem _ x => some x
  | .edge s _ _ => some s
  | .lt _ _ => none
  | .le _ _ => none
  | .eq _ _ => none

/-- D6.1a: the atoms of `D` owned by the role `z`. -/
def ownedBy (D : List (BaseAtom Role)) (z : Role) : List (BaseAtom Role) :=
  D.filter fun a => atomOwner a == some z

/-- D6.1a: `x` strictly precedes `y` in the reading order of `E`. -/
def Before (E : Forest) (x y : Role) : Prop :=
  ∃ i j : Nat, E.roles[i]? = some x ∧ E.roles[j]? = some y ∧ i < j

/-- D6.1a helper: membership in `Γ(E)`, by the four parts of `graph`. -/
theorem mem_graph_iff (E : Forest) (a : BaseAtom Role) :
    a ∈ graph E ↔
      (∃ x ∈ E.roles, a = .lim x) ∨
      (∃ (i : Nat) (x y : Role), E.roles[i]? = some x ∧ E.roles[i + 1]? = some y ∧ a = .lt x y) ∨
      (∃ c : ColAddr, Role.ord c ∈ E.roles ∧ Role.ord ⟨c.path, c.col + 1⟩ ∈ E.roles ∧
        a = .elem (.ord c) (.ord ⟨c.path, c.col + 1⟩)) ∨
      (∃ (e : EntryAddr) (p : Nat) (o v : Role), (E.entryAt e).map Prod.fst = some p ∧
        e.col.rep 0 p = some (o, v) ∧
        (a = .edge (.slot e) (.ord e.col) o ∨ a = .edge (.slot e) (.ord e.col) v)) := by
  unfold graph
  simp only [List.mem_append, List.mem_map, List.mem_filterMap, List.mem_flatMap, or_assoc]
  apply or_congr
  · constructor
    · rintro ⟨x, hx, rfl⟩; exact ⟨x, hx, rfl⟩
    · rintro ⟨x, hx, rfl⟩; exact ⟨x, hx, rfl⟩
  apply or_congr
  · constructor
    · rintro ⟨⟨x, y⟩, hxy, rfl⟩
      obtain ⟨i, hi⟩ := List.mem_iff_getElem?.1 hxy
      rw [List.getElem?_zip_eq_some, List.getElem?_tail] at hi
      exact ⟨i, x, y, hi.1, hi.2, rfl⟩
    · rintro ⟨i, x, y, hx, hy, rfl⟩
      refine ⟨(x, y), List.mem_iff_getElem?.2 ⟨i, ?_⟩, rfl⟩
      rw [List.getElem?_zip_eq_some, List.getElem?_tail]
      exact ⟨hx, hy⟩
  apply or_congr
  · constructor
    · rintro ⟨c, hc, hc'⟩
      split_ifs at hc' with h
      cases hc'
      refine ⟨c, ?_, ?_, rfl⟩
      · rw [Tree.mem_roles_iff]; exact (Tree.mem_colAddrs_iff _ _).1 hc
      · rw [Tree.mem_roles_iff]; exact h
    · rintro ⟨c, hc, hc', rfl⟩
      refine ⟨c, (Tree.mem_colAddrs_iff _ _).2 ((Tree.mem_roles_iff _ _).1 hc), ?_⟩
      rw [if_pos ((Tree.mem_roles_iff _ _).1 hc')]
  · constructor
    · rintro ⟨e, he, ha⟩
      split at ha
      · rename_i p h' hpe
        split at ha
        · rename_i o v hov
          refine ⟨e, p, o, v, by simp [hpe], hov, ?_⟩
          simpa using ha
        · simp at ha
      · simp at ha
    · rintro ⟨e, p, o, v, hp, hov, ha⟩
      obtain ⟨⟨p', h'⟩, hpe, rfl⟩ := Option.map_eq_some_iff.1 hp
      refine ⟨e, (Tree.mem_entryAddrs_iff _ _).2 (by simp [hpe]), ?_⟩
      simp only [hpe, hov]
      simpa using ha

/-- D6.1a helper: both representatives read by an entry lie in its prefix. -/
theorem rep_mem_prefix {E : Forest} {e : EntryAddr} (he : e ∈ E.entryAddrs) {q : Nat}
    {o v : Role} (h : e.col.rep 0 q = some (o, v)) :
    o ∈ prefixRoles E e ∧ v ∈ prefixRoles E e := by
  obtain ⟨-, hstack, hcont⟩ := Tree.stack_mem_prefix he
  unfold ColAddr.rep at h
  obtain ⟨o', ho', hov⟩ := Option.map_eq_some_iff.1 h
  have hs := ((ColAddr.resolve_spec 0 _ _ _).1 ho').1
  simp only [Prod.mk.injEq] at hov
  obtain ⟨rfl, rfl⟩ := hov
  refine ⟨hstack o' hs, ?_⟩
  split
  · rename_i e'' he''
    obtain ⟨-, hc⟩ := (ColAddr.container_spec _ _ _).1 he''
    exact hcont e'' hc
  · exact hstack o' hs

theorem prefixRoles_sub {E : Forest} {e : EntryAddr} {x : Role} (h : x ∈ prefixRoles E e) :
    x ∈ E.roles :=
  (List.takeWhile_prefix _).mem h

/-- D7.1a helper: a stack occurrence's path is a prefix of the column's path. -/
theorem onStack_path_prefix {c o : ColAddr} (h : c.OnStack o) : o.path <+: c.path := by
  rcases h with ⟨k, -, -, -, hp, -⟩ | ⟨hp, -⟩
  · rw [hp]; exact List.take_prefix _ _
  · rw [hp]

theorem rep_isSome_iff (c : ColAddr) (q : Nat) : (c.rep 0 q).isSome ↔ q < c.num 0 := by
  unfold ColAddr.rep
  rw [Option.isSome_map, ColAddr.resolve_isSome_iff]
  omega

-- provides: U3, D6.1a (every atom of `Γ(E)` is a consecutive order atom or is owned by a role)
theorem graph_atom_cases (E : Forest) (a : BaseAtom Role) (ha : a ∈ graph E) :
    (∃ (i : Nat) (x y : Role), a = .lt x y ∧ E.roles[i]? = some x ∧ E.roles[i + 1]? = some y) ∨
    (∃ z ∈ E.roles, atomOwner a = some z) := by
  rcases (mem_graph_iff E a).1 ha with ⟨x, hx, rfl⟩ | ⟨i, x, y, hx, hy, rfl⟩ | ⟨c, -, hc, rfl⟩ |
    ⟨e, p, o, v, hp, -, ha⟩
  · exact Or.inr ⟨x, hx, rfl⟩
  · exact Or.inl ⟨i, x, y, rfl, hx, hy⟩
  · exact Or.inr ⟨_, hc, rfl⟩
  · refine Or.inr ⟨.slot e, ?_, by rcases ha with rfl | rfl <;> rfl⟩
    rw [Tree.mem_roles_iff]
    obtain ⟨x, hx, -⟩ := Option.map_eq_some_iff.1 hp
    simp [hx]

-- provides: U3, D6.1a (the order atoms of `Γ(E)` are exactly the consecutive pairs)
theorem graph_lt_iff (E : Forest) (x y : Role) :
    BaseAtom.lt x y ∈ graph E ↔ ∃ i : Nat, E.roles[i]? = some x ∧ E.roles[i + 1]? = some y := by
  rw [mem_graph_iff]
  constructor
  · rintro (⟨_, -, h⟩ | ⟨i, x', y', hx, hy, h⟩ | ⟨c, -, -, h⟩ | ⟨e, p, o, v, -, -, h | h⟩)
    · cases h
    · cases h; exact ⟨i, hx, hy⟩
    · cases h
    · cases h
    · cases h
  · rintro ⟨i, hx, hy⟩
    exact Or.inr (Or.inl ⟨i, x, y, hx, hy, rfl⟩)

-- provides: U3, D6.1a (every variable of an atom of `Γ(E)` is a role of `E`)
theorem graph_vars_roles (E : Forest) (a : BaseAtom Role) (ha : a ∈ graph E) :
    ∀ v ∈ a.vars, v ∈ E.roles := by
  rcases (mem_graph_iff E a).1 ha with ⟨x, hx, rfl⟩ | ⟨i, x, y, hx, hy, rfl⟩ | ⟨c, hc, hc', rfl⟩ |
    ⟨e, p, o, v, hp, hov, ha⟩
  · simpa [BaseAtom.vars] using hx
  · simp only [BaseAtom.vars, List.mem_cons, List.not_mem_nil, or_false]
    rintro v (rfl | rfl)
    · exact List.mem_of_getElem? hx
    · exact List.mem_of_getElem? hy
  · simp only [BaseAtom.vars, List.mem_cons, List.not_mem_nil, or_false]
    rintro v (rfl | rfl) <;> assumption
  · obtain ⟨x, hx, -⟩ := Option.map_eq_some_iff.1 hp
    have he : e ∈ E.entryAddrs := (Tree.mem_entryAddrs_iff _ _).2 (by simp [hx])
    have hslot : Role.slot e ∈ E.roles := by rw [Tree.mem_roles_iff]; simp [hx]
    obtain ⟨hord, -, -⟩ := Tree.stack_mem_prefix he
    obtain ⟨ho, hv⟩ := rep_mem_prefix he hov
    rcases ha with rfl | rfl <;>
    · simp only [BaseAtom.vars, List.mem_cons, List.not_mem_nil, or_false]
      rintro w (rfl | rfl | rfl)
      · exact hslot
      · exact prefixRoles_sub hord
      · first | exact prefixRoles_sub ho | exact prefixRoles_sub hv

/-- D6.1a helper: strict increase along `E.roles` from consecutive order atoms that hold. -/
theorem lt_of_consec {E : Forest} {α : Role → Ordinal.{u}} (m : Nat)
    (hcons : ∀ i x y, i + 1 < m → E.roles[i]? = some x → E.roles[i + 1]? = some y → α x < α y) :
    ∀ (d i : Nat) {x y : Role}, i + d + 1 < m → E.roles[i]? = some x →
      E.roles[i + d + 1]? = some y → α x < α y := by
  intro d
  induction d with
  | zero => intro i x y hm hx hy; exact hcons i x y hm hx hy
  | succ d ih =>
    intro i x y hm hx hy
    have hlen : i + d + 1 < E.roles.length := by
      have := (List.getElem?_eq_some_iff.1 hy).1; omega
    have hz : E.roles[i + d + 1]? = some (E.roles[i + d + 1]) := List.getElem?_eq_getElem hlen
    exact (ih i (by omega) hx hz).trans
      (hcons (i + d + 1) _ y (by omega) hz (by rw [← hy]; congr 1))

-- provides: U3, D6.1a (a configuration is strictly increasing along the reading order)
theorem isConfig_before {P : Prims.{u}} {E : Forest} {α : Role → Ordinal.{u}}
    (h : IsConfig P E α) {x y : Role} (hxy : Before E x y) : α x < α y := by
  obtain ⟨i, j, hx, hy, hij⟩ := hxy
  obtain ⟨d, rfl⟩ : ∃ d, j = i + d + 1 := ⟨j - i - 1, by omega⟩
  refine lt_of_consec (E := E) (i + d + 2) (fun k x y _ hx hy => ?_) d i (by omega) hx hy
  exact h _ ((graph_lt_iff E x y).2 ⟨k, hx, hy⟩)

-- provides: U3, D6.1a
theorem le_cfgMax (E : Forest) (α : Role → Ordinal.{u}) {x : Role} (hx : x ∈ E.roles) :
    α x ≤ cfgMax E α := by
  unfold cfgMax
  generalize E.roles = l at hx
  induction l with
  | nil => simp at hx
  | cons y l ih =>
    simp only [List.map_cons, List.foldr_cons]
    rcases List.mem_cons.1 hx with rfl | hx
    · exact le_max_left _ _
    · exact (ih hx).trans (le_max_right _ _)

-- provides: U3, D6.1a
theorem cfgMax_lt (E : Forest) (α : Role → Ordinal.{u}) {θ : Ordinal.{u}} (hθ : 0 < θ)
    (h : ∀ x ∈ E.roles, α x < θ) : cfgMax E α < θ := by
  unfold cfgMax
  generalize E.roles = l at h
  induction l with
  | nil => simpa using hθ
  | cons y l ih =>
    simp only [List.map_cons, List.foldr_cons]
    exact max_lt (h y (List.mem_cons_self ..)) (ih fun x hx => h x (List.mem_cons_of_mem _ hx))

theorem getElem?_of_prefix {β : Type} {S L : List β} (h : S <+: L) {k : Nat} (hk : k < S.length) :
    L[k]? = S[k]? := by
  rw [List.prefix_iff_eq_take.1 h, List.getElem?_take, if_pos hk]

/-- D6.1a helper: atoms of `Γ(F)` inside a common prefix `S` of the reading orders of `F` and `t`
are atoms of `Γ(t)`, when the entries with slots in `S` have the same labels. -/
theorem restrict_graph_of_common {F t : Forest} {S : List Role} (hF : S <+: F.roles)
    (ht : S <+: t.roles)
    (hlab : ∀ e, Role.slot e ∈ S → (F.entryAt e).map Prod.fst = (t.entryAt e).map Prod.fst)
    (a : BaseAtom Role) : a ∈ restrictTo (graph F) S → a ∈ restrictTo (graph t) S := by
  unfold restrictTo
  rw [List.mem_filter, List.mem_filter]
  rintro ⟨ha, hv⟩
  refine ⟨?_, hv⟩
  have hv' : ∀ v ∈ a.vars, v ∈ S := by simpa using hv
  rw [mem_graph_iff]
  rcases (mem_graph_iff F a).1 ha with ⟨x, hx, rfl⟩ | ⟨i, x, y, hx, hy, rfl⟩ | ⟨c, hc, hc', rfl⟩ |
    ⟨e, p, o, v, hp, hov, ha⟩
  · exact Or.inl ⟨x, ht.mem (hv' x (by simp [BaseAtom.vars])), rfl⟩
  · have hyS := hv' y (by simp [BaseAtom.vars])
    obtain ⟨k, hk⟩ := List.mem_iff_getElem?.1 hyS
    have hkS : k < S.length := (List.getElem?_eq_some_iff.1 hk).1
    have hkF : F.roles[k]? = some y := by rw [getElem?_of_prefix hF hkS]; exact hk
    have hkl : k < F.roles.length := (List.getElem?_eq_some_iff.1 hkF).1
    have hki : k = i + 1 := (List.getElem?_inj hkl (Tree.roles_nodup F)).1 (hkF.trans hy.symm)
    subst hki
    refine Or.inr (Or.inl ⟨i, x, y, ?_, ?_, rfl⟩)
    · rw [getElem?_of_prefix ht (by omega), ← getElem?_of_prefix hF (by omega)]; exact hx
    · rw [getElem?_of_prefix ht hkS]; exact hk
  · refine Or.inr (Or.inr (Or.inl ⟨c, ht.mem (hv' _ (by simp [BaseAtom.vars])),
      ht.mem (hv' _ (by simp [BaseAtom.vars])), rfl⟩))
  · have hs : Role.slot e ∈ S := hv' _ (by rcases ha with rfl | rfl <;> simp [BaseAtom.vars])
    exact Or.inr (Or.inr (Or.inr ⟨e, p, o, v, by rw [← hlab e hs]; exact hp, hov, ha⟩))

theorem restrict_graph_self (F : Forest) (a : BaseAtom Role) :
    a ∈ restrictTo (graph F) F.roles ↔ a ∈ graph F := by
  unfold restrictTo
  rw [List.mem_filter]
  constructor
  · exact fun h => h.1
  · intro h
    exact ⟨h, by simpa using graph_vars_roles F a h⟩

-- provides: U3, D6.1a (truncation after an entry restricts the graph)
theorem graph_truncAfter (t : Forest) (e : EntryAddr) (he : e ∈ t.entryAddrs) (a : BaseAtom Role) :
    a ∈ graph (t.truncAfter e) ↔ a ∈ restrictTo (graph t) (t.truncAfter e).roles := by
  have hF := Tree.truncAfter_roles_under he
  obtain ⟨post, hr, -⟩ := Tree.roles_entry he
  have hpre : (t.truncAfter e).roles <+: t.roles := by
    rw [hF, hr]
    exact ⟨post, by simp⟩
  have hlab : ∀ e', Role.slot e' ∈ (t.truncAfter e).roles →
      ((t.truncAfter e).entryAt e').map Prod.fst = (t.entryAt e').map Prod.fst := by
    intro e' he'
    rw [Tree.mem_roles_iff] at he'
    obtain ⟨y, hy⟩ := Option.isSome_iff_exists.1 he'
    obtain ⟨h', hh'⟩ := Tree.labelSub_truncAfter t e e' y hy
    rw [hy, hh']; rfl
  rw [← restrict_graph_self]
  constructor
  · exact restrict_graph_of_common (List.prefix_refl _) hpre hlab a
  · exact restrict_graph_of_common hpre (List.prefix_refl _) (fun e' he' => (hlab e' he').symm) a

/-- D6.1a helper: `setHeight` keeps the roles before the slot and their labels. -/
theorem setHeight_decomp (t : Forest) (e : EntryAddr) (h : Forest) {p : Nat} {H : Forest}
    (he : t.entryAt e = some (p, H)) :
    ∃ post, t.roles = prefixRoles t e ++ Role.slot e :: (H.roles.map (Role.under e.heightPath) ++ post) ∧
      (t.setHeight e h).roles = prefixRoles t e ++ Role.slot e ::
        (h.roles.map (Role.under e.heightPath) ++ post) ∧
      ∀ e', Role.slot e' ∈ prefixRoles t e →
        ((t.setHeight e h).entryAt e').map Prod.fst = (t.entryAt e').map Prod.fst := by
  obtain ⟨⟨P, j⟩, i⟩ := e
  have hsh : t.setHeight ⟨⟨P, j⟩, i⟩ h = Tree.setAux h P j i t := by
    show t.setHeightBody _ h = _
    rw [Tree.setHeightBody, if_pos (by rw [he]; rfl)]
  obtain ⟨pre, post, hr, hs⟩ := Tree.roles_setAux h P t j i p H he
  have hpre : prefixRoles t ⟨⟨P, j⟩, i⟩ = pre := Tree.prefixRoles_of_decomp hr
  rw [hpre, hsh]
  refine ⟨post, hr, hs, ?_⟩
  intro e' he'
  have hin : Role.slot e' ∈ (Tree.setAux h P j i t).roles := by rw [hs]; simp [he']
  rw [Tree.mem_roles_iff] at hin
  obtain ⟨y, hy⟩ := Option.isSome_iff_exists.1 hin
  have hnot : ¬ (P ++ [(j, i)]) <+: e'.col.path := by
    intro hp
    have hmem := Tree.mem_height_of_prefix he (x := .slot e') (by rw [hr]; simp [he'])
      (by simpa [EntryAddr.heightPath, Role.path] using hp)
    have hnd := Tree.roles_nodup t
    rw [hr, List.nodup_append] at hnd
    exact hnd.2.2 _ he' _ (List.mem_cons_of_mem _ (List.mem_append_left _ hmem)) rfl
  obtain ⟨h', hh'⟩ := Tree.entryAt_setAux_label h P t j i e' y hy hnot
  rw [hy, hh']; rfl

-- provides: U3, D6.1a (replacing a height leaves the prefix before its slot unchanged)
theorem prefixGraph_setHeight (t : Forest) (e : EntryAddr) (h : Forest) (he : e ∈ t.entryAddrs) :
    prefixRoles (t.setHeight e h) e = prefixRoles t e ∧
    ∀ a, a ∈ prefixGraph (t.setHeight e h) e ↔ a ∈ prefixGraph t e := by
  rw [Tree.mem_entryAddrs_iff] at he
  obtain ⟨⟨p, H⟩, hx⟩ := Option.isSome_iff_exists.1 he
  obtain ⟨post, hr, hs, hlab⟩ := setHeight_decomp t e h hx
  have hpre : prefixRoles (t.setHeight e h) e = prefixRoles t e := Tree.prefixRoles_of_decomp hs
  refine ⟨hpre, fun a => ?_⟩
  unfold prefixGraph
  rw [hpre]
  have h1 : prefixRoles t e <+: (t.setHeight e h).roles := by rw [hs]; exact List.prefix_append _ _
  have h2 : prefixRoles t e <+: t.roles := by rw [hr]; exact List.prefix_append _ _
  constructor
  · exact restrict_graph_of_common h1 h2 hlab a
  · exact restrict_graph_of_common h2 h1 (fun e' he' => (hlab e' he').symm) a

-- [Changed in verification] D6.1a item 4b: strict increase along a realized prefix of `Γ(E)`
-- (used by L7.6a step 8(b), where only `restrictTo (graph E) P_E` is realized).
theorem before_of_restrict {P : Prims.{u}} {E : Forest} {α : Role → Ordinal.{u}} {m : Nat}
    (h : BaseHolds P (restrictTo (graph E) (E.roles.take m)) α) {x y : Role}
    (hx : x ∈ E.roles.take m) (hy : y ∈ E.roles.take m) (hxy : Before E x y) : α x < α y := by
  obtain ⟨i, j, hxi, hyj, hij⟩ := hxy
  have hjm : j < m := by
    obtain ⟨k, hk⟩ := List.mem_iff_getElem?.1 hy
    rw [List.getElem?_take] at hk
    split_ifs at hk with hkm
    · have hk' : k < E.roles.length := (List.getElem?_eq_some_iff.1 hk).1
      have := (List.getElem?_inj hk' (Tree.roles_nodup E)).1 (hk.trans hyj.symm)
      omega
  obtain ⟨d, rfl⟩ : ∃ d, j = i + d + 1 := ⟨j - i - 1, by omega⟩
  refine lt_of_consec (E := E) m (fun k x y hk hx hy => ?_) d i hjm hxi hyj
  refine h (BaseAtom.lt x y) ?_
  unfold restrictTo
  rw [List.mem_filter]
  refine ⟨(graph_lt_iff E x y).2 ⟨k, hx, hy⟩, ?_⟩
  simp only [BaseAtom.vars, List.all_cons, List.all_nil, Bool.and_true, Bool.and_eq_true,
    decide_eq_true_eq]
  refine ⟨List.mem_iff_getElem?.2 ⟨k, ?_⟩, List.mem_iff_getElem?.2 ⟨k + 1, ?_⟩⟩
  · rw [List.getElem?_take, if_pos (by omega)]; exact hx
  · rw [List.getElem?_take, if_pos hk]; exact hy

-- [Changed in verification] D6.1a item 8: truncation at a slot (keep `U_e`, clear its height)
-- restricts the graph (used by L7.4 step 6 for the reindexed internal cap `S_A`).
theorem graph_truncClear (t : Forest) (e : EntryAddr) (he : e ∈ t.entryAddrs) (a : BaseAtom Role) :
    a ∈ graph ((t.truncAfter e).setHeight e Tree.empty) ↔
      a ∈ restrictTo (graph t) ((t.truncAfter e).setHeight e Tree.empty).roles := by
  have hx' := he
  rw [Tree.mem_entryAddrs_iff] at hx'
  obtain ⟨⟨p, H⟩, hx⟩ := Option.isSome_iff_exists.1 hx'
  have hFe : (t.truncAfter e).entryAt e = some (p, H) := by rw [Tree.entryAt_truncAfter he, hx]
  obtain ⟨post, hr, hs, hlab⟩ := setHeight_decomp (t.truncAfter e) e Tree.empty hFe
  have hF := Tree.truncAfter_roles_under he
  have hpF : prefixRoles (t.truncAfter e) e = prefixRoles t e := (Tree.truncAfter_spec t e he).2.2.2.2.2
  rw [hpF] at hr hs hlab
  have hpost : post = [] := by
    rw [hF, show t.heightAt e = some H by simp [Tree.heightAt, hx], Option.getD_some] at hr
    have := congrArg List.length hr
    simp only [List.length_append, List.length_cons, List.length_map] at this
    exact List.eq_nil_of_length_eq_zero (by omega)
  subst hpost
  have hroles : ((t.truncAfter e).setHeight e Tree.empty).roles = prefixRoles t e ++ [Role.slot e] := by
    rw [hs]; rfl
  obtain ⟨post', hr', -⟩ := Tree.roles_entry he
  have hpre : ((t.truncAfter e).setHeight e Tree.empty).roles <+: t.roles := by
    rw [hroles, hr']
    exact ⟨((t.heightAt e).getD Tree.empty).roles.map (Role.under e.heightPath) ++ post', by simp⟩
  have hlab' : ∀ e', Role.slot e' ∈ ((t.truncAfter e).setHeight e Tree.empty).roles →
      (((t.truncAfter e).setHeight e Tree.empty).entryAt e').map Prod.fst =
        (t.entryAt e').map Prod.fst := by
    intro e' he'
    rw [hroles, List.mem_append, List.mem_singleton] at he'
    rcases he' with he' | he'
    · rw [hlab e' he']
      have hin : Role.slot e' ∈ (t.truncAfter e).roles := by rw [hF]; simp [he']
      rw [Tree.mem_roles_iff] at hin
      obtain ⟨y, hy⟩ := Option.isSome_iff_exists.1 hin
      obtain ⟨h', hh'⟩ := Tree.labelSub_truncAfter t e e' y hy
      rw [hy, hh']; rfl
    · cases he'
      have hmem : e ∈ (t.truncAfter e).entryAddrs := (Tree.truncAfter_spec t e he).2.1
      rw [(Tree.setHeight_basic _ e Tree.empty hmem).2.2.2.2.2, hFe, hx]
  rw [← restrict_graph_self]
  constructor
  · exact restrict_graph_of_common (List.prefix_refl _) hpre hlab' a
  · exact restrict_graph_of_common hpre (List.prefix_refl _) (fun e' he' => (hlab' e' he').symm) a

/-! ## D6.1c  Syntactic helpers (moved from U5 N5.7 at integration; real bodies) -/

/-- D6.1c: elementarity-carrying atoms (ordinary pairs and edges). -/
def isStruct {V : Type} : BaseAtom V → Bool
  | .elem _ _ => true
  | .edge _ _ _ => true
  | _ => false

/-- D6.1c: the parent of entry `e` of `E` (`0` if `e` is not an entry). -/
def entrySel (E : Forest) (e : EntryAddr) : Nat := ((E.entryAt e).map Prod.fst).getD 0

/-- D6.1c: the relative key `h_a(H_e)` of the height of entry `e` (host `a = e.col.num 0`). -/
def entryKey (E : Forest) (e : EntryAddr) : Key :=
  relKey (e.col.num 0) ((E.heightAt e).getD Tree.empty)

/-- D6.1c: the `E`-prefix read by labels of an anchored ordinary input: roles of `E` strictly
before the `E`-origin `χ(T)` of the stopping ordinary role (empty if `χ(T)` is undefined). -/
def ePrefix (E : Forest) (cap : Option (Closure.AdmCap E)) (sd : Scan.StopData) : List Role :=
  match Closure.anchorOrigin E cap (.ord sd.col) with
  | some T' => rolesBefore E T'
  | none => []

/-- D6.1c: the query atoms of an ordinary step: atoms of `Γ(H)` inside `P ∪ {T} ∪ Q` that involve
`T` or `Q`. By definition this is `ScanSetup.queryGraph` of any setup anchored at `H`. -/
def queryAtoms (H : Forest) (rs : RoleSets) : List (BaseAtom Role) :=
  (restrictTo (graph H) (rs.P ++ [rs.T] ++ rs.Q)).filter fun a =>
    a.vars.any fun v => decide (v ∈ rs.T :: rs.Q)

/-- D6.1c: the retained structural atoms of an ordinary step: elementarity atoms of `Γ(H)` inside
`D` that involve `K` (txt:940-941, 961). Atoms involving only `R` and pre-root roles are excluded:
the only such atom is the old pair `elem A_prev R`, whose `f`-image is not an atom of
`Γ(H[m+1])`; the root-to-next-column pair involves `K` and stays. -/
def retAtoms (H : Forest) (rs : RoleSets) : List (BaseAtom Role) :=
  (restrictTo (graph H) rs.D).filter fun a =>
    isStruct a && a.vars.any fun v => decide (v ∈ rs.K)

/-- D6.1c: the key of the special copies `(p, C)`: the owner entry's height without its last
column `[(a, ∅)]` (txt:105-107, 1325-1327). -/
def specialKey (H : Forest) (e : EntryAddr) : Key :=
  relKey (e.col.num 0) (.node ((H.heightAt e).getD Tree.empty).cols.dropLast)

/-! ## L6.2a  Stage addresses and the explicit occurrence maps (R-3) -/

-- SCR2 applied at integration: the bridge holds by `rfl`
theorem qMap_eq_def : qMap = qMapDef := rfl
-- SCR2 applied at integration: the bridge holds by `rfl`
theorem fMap_eq_def : fMap = fMapDef := rfl

/-- L6.2a: the roles of stage `m` of `H[n]` in reading order: the head, the query copy, the
retained copy. -/
def stageRoles (H : Forest) (n : Nat) (rs : RoleSets) (m : Nat) : List Role :=
  qMap H n m rs.T :: (rs.Q.map (qMap H n m) ++ rs.K.map (fMap H n m))

theorem transCols_ord_nil (π : List (Nat × Nat)) (c j : Nat) :
    transCols [] π 0 c (.ord ⟨[], j⟩) = .ord ⟨π, j + c⟩ := by
  simp [transCols, relocCols]

theorem transCols_under (π : List (Nat × Nat)) (c k i : Nat) (x : Role) :
    transCols [] π 0 c (x.under [(k, i)]) = x.under (π ++ [(k + c, i)]) := by
  cases x with
  | ord d => simp [transCols, relocCols, Role.under]
  | slot e => simp [transCols, relocCols, Role.under]

theorem transCols_slot_nil (π : List (Nat × Nat)) (c k i : Nat) :
    transCols [] π 0 c (.slot ⟨⟨[], k⟩, i⟩) = .slot ⟨⟨π, k + c⟩, i⟩ := by
  simp [transCols, relocCols]

/-- L6.2a helper: the roles of columns placed at path `π` from column `c + k` are those placed at
`[]` from column `k`, relocated by `transCols [] π 0 c`. -/
theorem rolesCol_place (π : List (Nat × Nat)) (c k : Nat) :
    ∀ (i : Nat) (col : List (Nat × Forest)),
      Tree.rolesCol π (k + c) i col = (Tree.rolesCol [] k i col).map (transCols [] π 0 c)
  | _, [] => rfl
  | i, (p, h) :: rest => by
    rw [Tree.rolesCol, Tree.rolesCol, rolesCol_place π c k (i + 1) rest, List.map_cons, List.map_append,
      transCols_slot_nil, Tree.rolesF_eq_map_under, Tree.rolesF_eq_map_under, List.map_map]
    congr 2
    apply List.map_congr_left
    intro x _
    simp only [Function.comp_apply, List.nil_append, transCols_under]

theorem rolesCols_place (π : List (Nat × Nat)) (c : Nat) :
    ∀ (k : Nat) (cols : List (List (Nat × Forest))),
      Tree.rolesCols π (k + c) cols = (Tree.rolesCols [] k cols).map (transCols [] π 0 c)
  | _, [] => rfl
  | k, col :: rest => by
    rw [Tree.rolesCols, Tree.rolesCols, show k + c + 1 = (k + 1) + c by omega,
      rolesCols_place π c (k + 1) rest, rolesCol_place π c k 0 col, List.map_cons, List.map_append,
      transCols_ord_nil]

/-- L6.2a helper: route columns of `routeColsAux` are columns of the forest placed under `σ`. -/
theorem routeColsAux_mem_roles : ∀ (fuel : Nat) (F : Forest) (σ : List (Nat × Nat)) (c : ColAddr),
    c ∈ Scan.routeColsAux fuel F σ → Role.ord c ∈ Tree.rolesF σ F := by
  intro fuel F σ c h
  rw [Scan.mem_routeColsAux_iff] at h
  obtain ⟨τ, hp, -, -, G, hG, hGl⟩ := h
  rw [Tree.rolesF_eq_map_under]
  refine List.mem_map.2 ⟨.ord ⟨τ, c.col⟩, ?_, by obtain ⟨cp, cc⟩ := c; simp_all [Role.under]⟩
  rw [Tree.mem_roles_iff]
  show (F.colAt ⟨τ, c.col⟩).isSome
  unfold Tree.colAt
  rw [hG]
  simp only [Option.bind_some]
  rw [List.getElem?_eq_getElem (by omega)]
  rfl

theorem takeWhile_append_of_mem {l₁ l₂ : List Role} {x : Role} (hnd : (l₁ ++ l₂).Nodup)
    (hx : x ∈ l₂) : (l₁ ++ l₂).takeWhile (· != x) = l₁ ++ l₂.takeWhile (· != x) := by
  rw [List.takeWhile_append_of_pos]
  intro y hy
  simp only [bne_iff_ne, ne_eq]
  rintro rfl
  exact (List.nodup_append.1 hnd).2.2 _ hy _ hx rfl

theorem roles_replaceAt_aux (r d : Nat) (Z : Forest) :
    ∀ (ℓ fuel : Nat) (F : Forest) (σ π : List (Nat × Nat)) (c : Nat),
      (Scan.routeColsAux fuel F σ)[ℓ]? = some ⟨π, c⟩ →
      Tree.rolesF σ (replaceAt r d Z ℓ F) =
        (Tree.rolesF σ F).takeWhile (· != .ord ⟨π, c⟩) ++ Z.roles.map (transCols [] π 0 c) := by
  intro ℓ
  induction ℓ with
  | zero =>
    rintro (_ | fuel) ⟨cols⟩ σ π c h
    · simp [Scan.routeColsAux] at h
    · simp only [Scan.routeColsAux, Tree.cols] at h
      cases hl : cols.getLast? with
      | none => rw [hl] at h; simp at h
      | some col =>
        rw [hl] at h
        simp only [List.getElem?_cons_zero, Option.some.injEq, ColAddr.mk.injEq] at h
        obtain ⟨rfl, rfl⟩ := h
        obtain ⟨A, rfl⟩ : ∃ A, cols = A ++ [col] := ⟨_, (List.dropLast_append_getLast? col hl).symm⟩
        have hrep : replaceAt r d Z 0 (Tree.node (A ++ [col])) =
            Tree.node (A.map (Tree.mapCol (shiftVal r d)) ++ Z.cols) := by
          obtain ⟨y, ys, hys⟩ := List.exists_cons_of_ne_nil (show A ++ [col] ≠ [] by simp)
          rw [hys]
          simp only [replaceAt]
          rw [← hys, List.dropLast_concat]
        have hlen : (A ++ [col]).length - 1 = 0 + A.length := by simp
        rw [hrep, Tree.rolesF, Tree.rolesCols_append, Tree.rolesCols_map', List.length_map, hlen,
          Tree.rolesF, Tree.rolesCols_append, Tree.rolesCols]
        have hnd := Tree.nodup_rolesF σ (Tree.node (A ++ [col]))
        rw [Tree.rolesF, Tree.rolesCols_append, Tree.rolesCols] at hnd
        simp only [Nat.zero_add] at hnd ⊢
        rw [takeWhile_append_of_mem hnd (List.mem_cons_self ..), List.takeWhile_cons_of_neg (by simp),
          List.append_nil]
        congr 1
        cases Z with
        | node zc =>
          have := rolesCols_place σ A.length 0 zc
          rw [Nat.zero_add] at this
          exact this
  | succ k ih =>
    rintro (_ | fuel) ⟨cols⟩ σ π c h
    · simp [Scan.routeColsAux] at h
    · simp only [Scan.routeColsAux, Tree.cols] at h
      cases hl : cols.getLast? with
      | none => rw [hl] at h; simp at h
      | some col =>
        rw [hl] at h
        simp only [List.getElem?_cons_succ] at h
        cases hl' : col.getLast? with
        | none => rw [hl'] at h; simp at h
        | some ph =>
          obtain ⟨p, hh⟩ := ph
          rw [hl'] at h
          simp only at h
          obtain ⟨A, rfl⟩ : ∃ A, cols = A ++ [col] := ⟨_, (List.dropLast_append_getLast? col hl).symm⟩
          obtain ⟨B, rfl⟩ : ∃ B, col = B ++ [(p, hh)] :=
            ⟨_, (List.dropLast_append_getLast? _ hl').symm⟩
          simp only [List.length_append, List.length_singleton, Nat.add_sub_cancel] at h
          have IH := ih fuel hh _ π c h
          have hmem := routeColsAux_mem_roles fuel hh _ _ (List.mem_of_getElem? h)
          have hrep : replaceAt r d Z (k + 1) (Tree.node (A ++ [B ++ [(p, hh)]])) =
              Tree.node (A.map (Tree.mapCol (shiftVal r d)) ++
                [B.map (fun x => (shiftVal r d x.1, Tree.map (shiftVal r d) x.2)) ++
                  [(shiftVal r d p, replaceAt r d Z k hh)]]) := by
            simp only [replaceAt, Scan.mapLast_eq, List.dropLast_concat, List.getLast?_concat,
              Option.map_some, Option.toList_some]
          have key : ∀ (X : List (List (Nat × Forest))) (Y : List (Nat × Forest)) (q : Nat) (W : Forest),
              Tree.rolesCols σ 0 X = Tree.rolesCols σ 0 A →
              Tree.rolesCol σ A.length 0 Y = Tree.rolesCol σ A.length 0 B →
              X.length = A.length → Y.length = B.length →
              Tree.rolesF σ (Tree.node (X ++ [Y ++ [(q, W)]])) =
                (Tree.rolesCols σ 0 A ++ Role.ord ⟨σ, A.length⟩ ::
                  (Tree.rolesCol σ A.length 0 B ++ [Role.slot ⟨⟨σ, A.length⟩, B.length⟩])) ++
                      Tree.rolesF (σ ++ [(A.length, B.length)]) W := by
            intro X Y q W hX hY hXl hYl
            rw [Tree.rolesF, Tree.rolesCols_append, hX, hXl, Nat.zero_add, Tree.rolesCols,
              Tree.rolesCol_append, hY, hYl, Nat.zero_add, Tree.rolesCol]
            simp [Tree.rolesCols, Tree.rolesCol]
          rw [hrep, key _ _ _ _ (Tree.rolesCols_map' _ _ _ _) (Tree.rolesCol_map' _ _ _ _ _)
            (by rw [List.length_map]) (by rw [List.length_map]), IH]
          rw [key _ _ _ _ rfl rfl rfl rfl] at ⊢
          have hnd := Tree.nodup_rolesF σ (Tree.node (A ++ [B ++ [(p, hh)]]))
          rw [key _ _ _ _ rfl rfl rfl rfl] at hnd
          rw [takeWhile_append_of_mem hnd hmem]
          simp only [List.append_assoc, List.cons_append]

-- provides: U3, L6.2a (roles of `A_{r,d,ℓ,Z}`: the old roles before the replaced route column,
-- then the roles of `Z` placed at its position)
theorem roles_replaceAt (r d ℓ : Nat) (Z F : Forest) {π : List (Nat × Nat)} {c : Nat}
    (hroute : (Scan.routeCols F)[ℓ]? = some ⟨π, c⟩) :
    (replaceAt r d Z ℓ F).roles = rolesBefore F (.ord ⟨π, c⟩) ++ Z.roles.map (transCols [] π 0 c) :=
  roles_replaceAt_aux r d Z ℓ _ F [] π c hroute

-- provides: U3, L6.2a (stack transport: copied entries keep shifted parents, and the
-- representatives read on the copied stack are the mapped old representatives)
theorem rep_stage {H H' : Forest} {n : Nat} {rs : RoleSets} {sd : Scan.StopData}
    {rd : Scan.RootData} (hH : H ≠ Tree.empty) (hV : Scan.CondV H) (hI : Scan.CondI H)
    (hk : Scan.stepKind H = some .ordinary) (hrs : roleSets H = some rs)
    (hsd : Scan.stopData H = some sd) (hrd : Scan.rootData H = some rd)
    (hexp : expand H n = some H') {m : Nat} (hm1 : 1 ≤ m) (hmn : m ≤ n) :
    (∀ e : EntryAddr, Role.slot e ∈ rs.Q → ∀ p, (H.entryAt e).map Prod.fst = some p →
      ∃ e', qMap H n m (.slot e) = .slot e' ∧ qMap H n m (.ord e.col) = .ord e'.col ∧
        (H'.entryAt e').map Prod.fst = some (shiftVal sd.r ((m - 1) * (sd.t - sd.r)) p) ∧
        e'.col.rep 0 (shiftVal sd.r ((m - 1) * (sd.t - sd.r)) p) =
          (e.col.rep 0 p).map fun ov => (qMap H n m ov.1, qMap H n m ov.2)) ∧
    (∀ e : EntryAddr, Role.slot e ∈ rs.K → ∀ p, (H.entryAt e).map Prod.fst = some p →
      ∃ e', fMap H n m (.slot e) = .slot e' ∧ fMap H n m (.ord e.col) = .ord e'.col ∧
        (H'.entryAt e').map Prod.fst = some (shiftVal sd.r (m * (sd.t - sd.r)) p) ∧
        e'.col.rep 0 (shiftVal sd.r (m * (sd.t - sd.r)) p) =
          (e.col.rep 0 p).map fun ov => (fMap H n m ov.1, fMap H n m ov.2)) := by sorry

/-! ## L6.2  Occurrence-map identity; L6.2b deletion; L6.2c special; L6.2d prefix -/

-- provides: U3, L6.2 (refined form of the spine's `occurrence_map_identity`†)
theorem occurrence_map_identity {H H' : Forest} {n : Nat} {rs : RoleSets}
    (hH : H ≠ Tree.empty) (hV : Scan.CondV H) (hI : Scan.CondI H)
    (hk : Scan.stepKind H = some .ordinary) (hrs : roleSets H = some rs)
    (hexp : expand H n = some H') :
    H'.roles = rs.P ++ (List.range n).flatMap (fun m => stageRoles H n rs (m + 1)) ∧
    (∀ z ∈ rs.P, ∀ a, a ∈ ownedBy (graph H') z ↔ a ∈ ownedBy (graph H) z) ∧
    (∀ m, 1 ≤ m → m ≤ n → ∀ x ∈ rs.T :: rs.Q, ∀ a,
      a ∈ ownedBy (graph H') (qMap H n m x) ↔
        ∃ a₀ ∈ ownedBy (graph H) x, a = a₀.map (qMap H n m)) ∧
    (∀ m, 1 ≤ m → m ≤ n → ∀ x ∈ rs.K, ∀ a,
      a ∈ ownedBy (graph H') (fMap H n m x) ↔
        ∃ a₀ ∈ ownedBy (graph H) x, a = a₀.map (fMap H n m)) := by sorry

/-- L6.2 helper: in a list `A ++ z :: X` without repetitions, the roles before `z` are `A`. -/
theorem takeWhile_ne_of_decomp {A X : List Role} {z : Role} (hnd : (A ++ z :: X).Nodup) :
    (A ++ z :: X).takeWhile (· != z) = A := by
  rw [List.takeWhile_append_of_pos, List.takeWhile_cons_of_neg (by simp), List.append_nil]
  intro y hy
  simp only [bne_iff_ne, ne_eq]
  rintro rfl
  exact (List.nodup_append.1 hnd).2.2 _ hy _ (List.mem_cons_self ..) rfl

/-- L6.2 helper: the roles before a role of a prefix lie in that prefix. -/
theorem rolesBefore_sub_prefix {E : Forest} {S : List Role} (hS : S <+: E.roles) {z : Role}
    (hz : z ∈ S) {v : Role} (hv : v ∈ rolesBefore E z) : v ∈ S := by
  obtain ⟨X, hX⟩ := hS
  obtain ⟨S₁, S₂, rfl⟩ := List.append_of_mem hz
  have hnd := Tree.roles_nodup E
  unfold rolesBefore at hv
  rw [← hX] at hnd hv
  rw [show S₁ ++ z :: S₂ ++ X = S₁ ++ z :: (S₂ ++ X) by simp] at hnd hv
  rw [takeWhile_ne_of_decomp hnd] at hv
  exact List.mem_append_left _ hv

/-- L6.2 helper: the roles of a forest of `t` form a block of the reading order of `t`. -/
theorem roles_forest_decomp {t : Forest} {p : List (Nat × Nat)} {F : Forest}
    (h : t.forestAt p = some F) : ∃ A B, t.roles = A ++ Tree.rolesCols p 0 F.cols ++ B := by
  rcases List.eq_nil_or_concat p with rfl | ⟨π, ⟨a, b⟩, rfl⟩
  · simp only [Tree.forestAt, Option.some.injEq] at h
    subst h
    refine ⟨[], [], ?_⟩
    cases t; simp [Tree.roles, Tree.rolesF, Tree.cols]
  · set E : EntryAddr := ⟨⟨π, a⟩, b⟩ with hE
    have hhp : E.heightPath = π ++ [(a, b)] := rfl
    simp only [List.concat_eq_append] at h
    rw [← hhp, Tree.forestAt_heightPath] at h
    have he : E ∈ t.entryAddrs := by
      rw [Tree.mem_entryAddrs_iff]
      unfold Tree.heightAt at h
      obtain ⟨x, hx, -⟩ := Option.map_eq_some_iff.1 h
      rw [hx]; rfl
    obtain ⟨post, hr, -⟩ := Tree.roles_entry he
    rw [h, Option.getD_some, ← Tree.rolesF_eq_map_under, hhp] at hr
    refine ⟨prefixRoles t E ++ [Role.slot E], post, ?_⟩
    rw [hr]
    cases F
    simp [Tree.rolesF, Tree.cols]

/-- L6.2 helper: the roles of a column follow its ordinary role in reading order. -/
theorem roles_col_decomp {t : Forest} {c : ColAddr} {col : Column} (h : t.colAt c = some col) :
    ∃ A B, t.roles = A ++ Role.ord c :: (Tree.rolesCol c.path c.col 0 col ++ B) := by
  unfold Tree.colAt at h
  rw [Option.bind_eq_some_iff] at h
  obtain ⟨F, hF, hcol⟩ := h
  obtain ⟨A, B, hAB⟩ := roles_forest_decomp hF
  have hjl : c.col < F.cols.length := (List.getElem?_eq_some_iff.1 hcol).1
  refine ⟨A ++ Tree.rolesCols c.path 0 (F.cols.take c.col),
    Tree.rolesCols c.path (c.col + 1) (F.cols.drop (c.col + 1)) ++ B, ?_⟩
  rw [hAB]
  conv_lhs => rw [Tree.list_split_of_getElem? hcol]
  rw [Tree.rolesCols_append, Tree.rolesCols, List.length_take, Nat.min_eq_left (Nat.le_of_lt hjl),
    Nat.zero_add]
  simp

/-- L6.2 helper: an earlier column of a forest precedes a later one. -/
theorem ord_before_next {t : Forest} {c : ColAddr} (hc : (t.colAt ⟨c.path, c.col + 1⟩).isSome) :
    Role.ord c ∈ rolesBefore t (.ord ⟨c.path, c.col + 1⟩) := by
  obtain ⟨col, hcol⟩ := Option.isSome_iff_exists.1 hc
  unfold Tree.colAt at hcol
  rw [Option.bind_eq_some_iff] at hcol
  obtain ⟨F, hF, hcol⟩ := hcol
  obtain ⟨A, B, hAB⟩ := roles_forest_decomp hF
  have hjl : c.col + 1 < F.cols.length := (List.getElem?_eq_some_iff.1 hcol).1
  have hsplit : Tree.rolesCols c.path 0 F.cols = Tree.rolesCols c.path 0 (F.cols.take (c.col + 1)) ++
      Role.ord ⟨c.path, c.col + 1⟩ :: (Tree.rolesCol c.path (c.col + 1) 0 col ++
        Tree.rolesCols c.path (c.col + 2) (F.cols.drop (c.col + 2))) := by
    conv_lhs => rw [Tree.list_split_of_getElem? hcol]
    rw [Tree.rolesCols_append, Tree.rolesCols, List.length_take, Nat.min_eq_left (Nat.le_of_lt hjl),
      Nat.zero_add]
  have hnd := Tree.roles_nodup t
  unfold rolesBefore
  rw [hAB, hsplit] at hnd ⊢
  rw [show ∀ (A X : List Role) (y : Role) (Y B : List Role), A ++ (X ++ y :: Y) ++ B =
      (A ++ X) ++ y :: (Y ++ B) by intros; simp] at hnd ⊢
  rw [takeWhile_ne_of_decomp hnd]
  refine List.mem_append_right _ ?_
  rw [Tree.mem_rolesCols_iff]
  refine ⟨c.col, F.cols[c.col]'(by omega), ?_, Or.inl (by simp)⟩
  rw [List.getElem?_take, if_pos (by omega)]
  simp

/-- L6.2 helper: an atom owned by `z` reads only roles at or before `z`. -/
theorem owned_before {H : Forest} {z : Role} {a : BaseAtom Role} (ha : a ∈ ownedBy (graph H) z)
    {v : Role} (hv : v ∈ a.vars) : v ∈ rolesBefore H z ∨ v = z := by
  unfold ownedBy at ha
  rw [List.mem_filter, beq_iff_eq] at ha
  obtain ⟨ha, hown⟩ := ha
  rcases (mem_graph_iff H a).1 ha with ⟨x, -, rfl⟩ | ⟨i, x, y, -, -, rfl⟩ | ⟨c, hc, hc', rfl⟩ |
    ⟨e, p, o, w, hp, hov, ha'⟩
  · simp only [atomOwner, Option.some.injEq] at hown
    simp only [BaseAtom.vars, List.mem_singleton] at hv
    exact Or.inr (hv.trans hown)
  · simp [atomOwner] at hown
  · simp only [atomOwner, Option.some.injEq] at hown
    subst hown
    simp only [BaseAtom.vars, List.mem_cons, List.not_mem_nil, or_false] at hv
    rcases hv with rfl | rfl
    · left
      rw [Tree.mem_roles_iff] at hc'
      exact ord_before_next hc'
    · exact Or.inr rfl
  · have he : e ∈ H.entryAddrs := by
      rw [Tree.mem_entryAddrs_iff]
      obtain ⟨x, hx, -⟩ := Option.map_eq_some_iff.1 hp
      rw [hx]; rfl
    have hown' : z = .slot e := by
      rcases ha' with rfl | rfl <;> simpa [atomOwner] using hown.symm
    subst hown'
    obtain ⟨hord, -, -⟩ := Tree.stack_mem_prefix he
    obtain ⟨ho, hw⟩ := rep_mem_prefix he hov
    rcases ha' with rfl | rfl <;>
    · simp only [BaseAtom.vars, List.mem_cons, List.not_mem_nil, or_false] at hv
      rcases hv with rfl | rfl | rfl
      · exact Or.inr rfl
      · exact Or.inl hord
      · first | exact Or.inl ho | exact Or.inl hw

theorem inEntry_iff (x : Role) (e : EntryAddr) :
    x.inEntry e = true ↔ x = .slot e ∨ e.heightPath <+: x.path := by
  simp [Role.inEntry, List.isPrefixOf_iff_prefix]

/-- L6.2 helper: an atom owned by `z` reads only roles whose containing entries contain `z`. -/
theorem owned_inEntry {H : Forest} {z : Role} {a : BaseAtom Role} (ha : a ∈ ownedBy (graph H) z)
    {v : Role} (hv : v ∈ a.vars) (E : EntryAddr) (hE : v.inEntry E = true) : z.inEntry E = true := by
  unfold ownedBy at ha
  rw [List.mem_filter, beq_iff_eq] at ha
  obtain ⟨ha, hown⟩ := ha
  rw [inEntry_iff] at hE ⊢
  rcases (mem_graph_iff H a).1 ha with ⟨x, -, rfl⟩ | ⟨i, x, y, -, -, rfl⟩ | ⟨c, hc, hc', rfl⟩ |
    ⟨e, p, o, w, hp, hov, ha'⟩
  · simp only [atomOwner, Option.some.injEq] at hown
    simp only [BaseAtom.vars, List.mem_singleton] at hv
    rw [← hown, ← hv]; exact hE
  · simp [atomOwner] at hown
  · simp only [atomOwner, Option.some.injEq] at hown
    subst hown
    simp only [BaseAtom.vars, List.mem_cons, List.not_mem_nil, or_false] at hv
    rcases hv with rfl | rfl
    · rcases hE with h | h
      · cases h
      · exact Or.inr h
    · exact hE
  · have hown' : z = .slot e := by
      rcases ha' with rfl | rfl <;> simpa [atomOwner] using hown.symm
    subst hown'
    -- the representatives lie on the stack of `e.col`
    have hrep : ∀ x, (x = o ∨ x = w) → x = .slot E ∨ E.heightPath <+: x.path →
        E.heightPath <+: e.col.path := by
      unfold ColAddr.rep at hov
      obtain ⟨o', ho', hov'⟩ := Option.map_eq_some_iff.1 hov
      have hs := ((ColAddr.resolve_spec 0 _ _ _).1 ho').1
      have hpre := onStack_path_prefix hs
      simp only [Prod.mk.injEq] at hov'
      obtain ⟨rfl, rfl⟩ := hov'
      rintro x (rfl | rfl) hx
      · rcases hx with h | h
        · cases h
        · exact h.trans hpre
      · split at hx
        · rename_i e'' he''
          obtain ⟨h1, h2⟩ := (ColAddr.container_spec _ _ _).1 he''
          rcases hx with h | h
          · cases h; exact h2
          · simp only [Role.path] at h
            rw [h1] at h
            exact h.trans hpre
        · rcases hx with h | h
          · cases h
          · exact h.trans hpre
    have hcase : v = .slot e ∨ v = .ord e.col ∨ v = o ∨ v = w := by
      rcases ha' with rfl | rfl <;>
      · simp only [BaseAtom.vars, List.mem_cons, List.not_mem_nil, or_false] at hv
        rcases hv with h | h | h
        · exact Or.inl h
        · exact Or.inr (Or.inl h)
        · first | exact Or.inr (Or.inr (Or.inl h)) | exact Or.inr (Or.inr (Or.inr h))
    rcases hcase with rfl | rfl | rfl | rfl
    · exact hE
    · rcases hE with h | h
      · cases h
      · exact Or.inr h
    · exact Or.inr (hrep _ (Or.inl rfl) hE)
    · exact Or.inr (hrep _ (Or.inr rfl) hE)

/-- L6.2 helper: the role sets of an ordinary step, unfolded. -/
theorem roleSets_unfold {H : Forest} {rs : RoleSets} (hrs : roleSets H = some rs) :
    ∃ sd rd, Scan.stopData H = some sd ∧ Scan.rootData H = some rd ∧
      rs = (let rsl := H.roles
        let T : Role := .ord sd.col
        let R : Role := .ord rd.col
        let N : Role := .slot (Scan.closingSlot sd)
        let P := rsl.takeWhile (· != T)
        let pre := rsl.takeWhile (· != R)
        let between := (P.dropWhile (· != R)).drop 1
        let consumed : Role → Bool := fun x => (List.range rd.cursor).any fun i => x.inEntry ⟨rd.col, i⟩
        let K := between.filter fun x => !consumed x
        ⟨R, T, N, ((rsl.dropWhile (· != T)).drop 1).takeWhile (· != N), K, pre ++ [R] ++ K, P⟩) := by
  unfold roleSets at hrs
  cases hsd : Scan.stopData H with
  | none => rw [hsd] at hrs; simp at hrs
  | some sd =>
  cases hrd : Scan.rootData H with
  | none => rw [hsd, hrd] at hrs; simp at hrs
  | some rd =>
  rw [hsd, hrd] at hrs
  simp only [Option.pure_def, Option.bind_eq_bind, Option.bind_some, Option.some.injEq] at hrs
  exact ⟨sd, rd, rfl, rfl, hrs.symm⟩

theorem stepKind_of_rootData {H : Forest} {rd : Scan.RootData} (hrd : Scan.rootData H = some rd) :
    Scan.stepKind H = some .ordinary := by
  have h1 : Scan.rootDataBody H = some rd := hrd
  unfold Scan.rootDataBody at h1
  show Scan.stepKindBody H = _
  split at h1
  · assumption
  · simp at h1

theorem colAddr_eq {c d : ColAddr} (h1 : c.path = d.path) (h2 : c.col = d.col) : c = d := by
  cases c; cases d; simp_all

-- provides: U3, L6.2 (query and retained atoms read only `D ∪ {T} ∪ Q`, resp. `D`)
-- [Changed in verification] hypothesis `InL H` replaces `CondV H`: with V alone the owner's
-- active root entry can be consumed and the statement fails (counterexample in the unit doc).
theorem owned_reads {H : Forest} {rs : RoleSets} (hL : Scan.InL H)
    (hk : Scan.stepKind H = some .ordinary) (hrs : roleSets H = some rs) :
    (∀ x ∈ rs.T :: rs.Q, ∀ a ∈ ownedBy (graph H) x, ∀ v ∈ a.vars, v ∈ rs.D ∨ v ∈ rs.T :: rs.Q) ∧
    (∀ x ∈ rs.K, ∀ a ∈ ownedBy (graph H) x, ∀ v ∈ a.vars, v ∈ rs.D) := by
  obtain ⟨sd, rd, hsd, hrd, rfl⟩ := roleSets_unfold hrs
  simp only
  have hne : H ≠ Tree.empty := by
    rintro rfl; simp [Scan.stepKind, Scan.stepKindBody, Tree.empty, Tree.cols] at hk
  obtain ⟨hV, hI, -, hCA, hS⟩ := hL
  obtain ⟨hcolT, -, htnum, hmemT, -, -⟩ := Scan.stopData_spec hsd
  obtain ⟨hRres, -, -, hRnum, hrt, hRcol, -, howner⟩ := Scan.rootData_spec hsd hrd
  set T : Role := .ord sd.col with hTdef
  set R : Role := .ord rd.col with hRdef
  set Ne : EntryAddr := Scan.closingSlot sd with hNedef
  set QR := Tree.rolesCol sd.col.path sd.col.col 0 sd.Q with hQRdef
  -- the reading order around the stopping column
  obtain ⟨A, B, hAB⟩ := roles_col_decomp hcolT
  have hlastc : Tree.rolesCol sd.col.path sd.col.col (0 + sd.Q.length) [(sd.r, Tree.empty)] =
      [Role.slot Ne] := by
    simp [Tree.rolesCol, Tree.rolesF, Tree.rolesCols, Tree.empty, hNedef, Scan.closingSlot]
  rw [Tree.rolesCol_append, hlastc, ← hQRdef] at hAB
  have hroles : H.roles = A ++ T :: (QR ++ Role.slot Ne :: B) := by rw [hAB]; simp [hTdef]
  have hnd := Tree.roles_nodup H
  rw [hroles] at hnd
  have hP : H.roles.takeWhile (· != T) = A := by rw [hroles]; exact takeWhile_ne_of_decomp hnd
  have hnd2 : (QR ++ Role.slot Ne :: B).Nodup := (List.nodup_cons.1 (List.nodup_append.1 hnd).2.1).2
  have hQ : ((H.roles.dropWhile (· != T)).drop 1).takeWhile (· != Role.slot Ne) = QR := by
    rw [hroles, List.dropWhile_append_of_pos, List.dropWhile_cons_of_neg (by simp), List.drop_one,
      List.tail_cons, takeWhile_ne_of_decomp hnd2]
    intro y hy
    simp only [bne_iff_ne, ne_eq]
    rintro rfl
    exact (List.nodup_append.1 hnd).2.2 _ hy _ (List.mem_cons_self ..) rfl
  rw [hP, hQ]
  -- members of `Q` lie in the query entries
  have hQmem : ∀ z ∈ QR, ∃ j, z = .slot ⟨sd.col, j⟩ ∨ (⟨sd.col, j⟩ : EntryAddr).heightPath <+: z.path := by
    intro z hz
    rw [hQRdef, Tree.mem_rolesCol_iff] at hz
    obtain ⟨m, p, h, -, hz⟩ := hz
    refine ⟨m, ?_⟩
    rcases hz with rfl | hz
    · left; simp
    · right
      obtain ⟨σ, hσ⟩ := Tree.path_of_mem_rolesF hz
      rw [hσ]
      exact ⟨σ, by simp [EntryAddr.heightPath]⟩
  -- the root column lies on the stack of the stopping column
  have hRstack : sd.col.OnStack rd.col := ((ColAddr.resolve_spec 0 _ _ _).1 hRres).1
  have hRpre : rd.col.path <+: sd.col.path := onStack_path_prefix hRstack
  have hRne : rd.col ≠ sd.col := by
    intro h; have := congrArg (ColAddr.num 0) h; omega
  -- `R` precedes `T`
  have hNe : Ne ∈ H.entryAddrs := by
    rw [Tree.mem_entryAddrs_iff]
    simp [Tree.entryAt, hcolT, hNedef, Scan.closingSlot]
  have hRA : R ∈ A := by
    have h1 := (Tree.stack_mem_prefix hNe).2.1 rd.col hRstack
    have hpre : prefixRoles H Ne = A ++ T :: QR := by
      have hnd3 : ((A ++ T :: QR) ++ Role.slot Ne :: B).Nodup := by simpa using hnd
      unfold prefixRoles rolesBefore
      rw [hroles, show A ++ T :: (QR ++ Role.slot Ne :: B) = (A ++ T :: QR) ++ Role.slot Ne :: B by simp]
      exact takeWhile_ne_of_decomp hnd3
    rw [hpre] at h1
    rcases List.mem_append.1 h1 with h | h
    · exact h
    · rcases List.mem_cons.1 h with h | h
      · exact absurd (Role.ord.inj h) hRne
      · exfalso
        obtain ⟨j, hj | hj⟩ := hQmem _ h
        · cases hj
        · have := hj.length_le
          have := hRpre.length_le
          simp [EntryAddr.heightPath, Role.path] at *
          omega
  obtain ⟨A₁, A₂, hA⟩ := List.append_of_mem hRA
  have hnd' := Tree.roles_nodup H
  rw [hroles, hA, show A₁ ++ R :: A₂ ++ T :: (QR ++ Role.slot Ne :: B) =
    A₁ ++ R :: (A₂ ++ T :: (QR ++ Role.slot Ne :: B)) by simp] at hnd'
  have hpre : H.roles.takeWhile (· != R) = A₁ := by
    rw [hroles, hA, show A₁ ++ R :: A₂ ++ T :: (QR ++ Role.slot Ne :: B) =
      A₁ ++ R :: (A₂ ++ T :: (QR ++ Role.slot Ne :: B)) by simp]
    exact takeWhile_ne_of_decomp hnd'
  have hbetween : ((A.dropWhile (· != R)).drop 1) = A₂ := by
    rw [hA, List.dropWhile_append_of_pos, List.dropWhile_cons_of_neg (by simp)]
    · rfl
    · intro y hy
      simp only [bne_iff_ne, ne_eq]
      rintro rfl
      exact (List.nodup_append.1 hnd').2.2 _ hy _ (List.mem_cons_self ..) rfl
  rw [hpre, hbetween]
  -- consumption
  set consumed : Role → Bool := fun x => (List.range rd.cursor).any fun i => x.inEntry ⟨rd.col, i⟩
    with hcons
  have hcons_iff : ∀ x, consumed x = true ↔ ∃ i < rd.cursor, x.inEntry ⟨rd.col, i⟩ = true := by
    intro x; simp [hcons]
  have hprop : ∀ {z : Role} {a : BaseAtom Role}, a ∈ ownedBy (graph H) z → consumed z = false →
      ∀ v ∈ a.vars, consumed v = false := by
    intro z a ha hz v hv
    rw [Bool.eq_false_iff] at hz ⊢
    intro hv'
    obtain ⟨i, hi, hvi⟩ := (hcons_iff v).1 hv'
    exact hz ((hcons_iff z).2 ⟨i, hi, owned_inEntry ha hv _ hvi⟩)
  have hD : ∀ v ∈ A, consumed v = false → v ∈ A₁ ++ [R] ++ A₂.filter fun x => !consumed x := by
    intro v hv hcv
    rw [hA] at hv
    simp only [List.mem_append, List.mem_cons, List.mem_singleton, List.mem_filter, hcv,
      Bool.not_false, and_true] at hv ⊢
    tauto
  -- the stopping column is not inside a consumed root entry (this is where `InL` is used)
  have hTnc : consumed T = false := by
    rw [Bool.eq_false_iff]
    intro hT
    obtain ⟨i, hi, hTi⟩ := (hcons_iff T).1 hT
    rw [inEntry_iff] at hTi
    rcases hTi with h | hTi
    · simp [hTdef] at h
    simp only [hTdef, Role.path] at hTi
    have hroute := ((Scan.mem_routeCols_iff H sd.col).1 hmemT).1
    have hlen : rd.col.path.length < sd.col.path.length := by
      have := hTi.length_le; simp [EntryAddr.heightPath] at this; omega
    obtain ⟨F, hF, hls⟩ := hroute _ hlen
    have htake : sd.col.path.take rd.col.path.length = rd.col.path := by
      obtain ⟨σ, hσ⟩ := hTi
      rw [← hσ]; simp [EntryAddr.heightPath]
    have hget : sd.col.path[rd.col.path.length]? = some (rd.col.col, i) := by
      obtain ⟨σ, hσ⟩ := hTi
      rw [← hσ]; simp [EntryAddr.heightPath]
    rw [htake] at hF
    rw [hget] at hls
    obtain ⟨col, p, h', hcl, hcl', hs, -⟩ := Scan.lastStep?_eq_some hls
    simp only [Prod.mk.injEq] at hs
    obtain ⟨hs1, hs2⟩ := hs
    have hown : rd.owner = true := howner.2 ⟨F, hF, by
      have : F.cols.length ≠ 0 := by intro h0; simp [List.getLast?_eq_none_iff.2 (List.eq_nil_of_length_eq_zero h0)] at hcl
      omega⟩
    have hrootcol : H.colAt rd.col = some col := by
      unfold Tree.colAt
      rw [hF, Option.bind_some, hs1, ← List.getLast?_eq_getElem?]
      exact hcl
    have hdef := Scan.expand_isSome hV hI hCA hS 1
    rw [Scan.expand_eq_paperOp hne hV hI, Scan.paperOp_ordinary hk hsd hrd 1, hrootcol] at hdef
    simp only [Option.getD_some] at hdef
    have hcl1 : col ≠ [] := by
      intro h0; subst h0; simp at hcl'
    split_ifs at hdef with hc
    · simp at hdef
    · have hc' : ¬ (col.drop rd.cursor).isEmpty = true := by
        intro h0; apply hc; simp [hown, h0]
      rw [List.isEmpty_iff, List.drop_eq_nil_iff] at hc'
      have : col.length ≠ 0 := fun h0 => hcl1 (List.eq_nil_of_length_eq_zero h0)
      omega
  have hQnc : ∀ z ∈ QR, consumed z = false := by
    intro z hz
    rw [Bool.eq_false_iff]
    intro hz'
    obtain ⟨i, hi, hzi⟩ := (hcons_iff z).1 hz'
    obtain ⟨j, hj⟩ := hQmem z hz
    have hTi : ¬ (⟨rd.col, i⟩ : EntryAddr).heightPath <+: sd.col.path := by
      intro h
      have : consumed T = true := (hcons_iff T).2 ⟨i, hi, by rw [inEntry_iff]; exact Or.inr h⟩
      rw [hTnc] at this; cases this
    have hzpath : sd.col.path <+: z.path := by
      rcases hj with rfl | hj
      · exact List.prefix_refl _
      · exact (List.prefix_append _ _).trans hj
    rw [inEntry_iff] at hzi
    rcases hzi with rfl | hzi
    · rcases hj with hj | hj
      · injection hj with hj
        injection hj with h1 h2
        exact hRne h1
      · have := hj.length_le
        have := hRpre.length_le
        simp [EntryAddr.heightPath, Role.path] at *
        omega
    · by_cases hl : (⟨rd.col, i⟩ : EntryAddr).heightPath.length ≤ sd.col.path.length
      · exact hTi (List.prefix_of_prefix_length_le hzi hzpath hl)
      · have hlen := hRpre.length_le
        simp [EntryAddr.heightPath] at hl
        have hRp : rd.col.path = sd.col.path :=
          hRpre.eq_of_length (by omega)
        rcases hj with rfl | hj
        · have := hzi.length_le
          simp [EntryAddr.heightPath, Role.path] at this
          omega
        · -- both entries are read at the position `|T.path|` of `z.path`
          have h1 := hzi.getElem (i := sd.col.path.length) (by simp [EntryAddr.heightPath, hRp])
          have h2 := hj.getElem (i := sd.col.path.length) (by simp [EntryAddr.heightPath])
          simp [EntryAddr.heightPath, hRp] at h1 h2
          rw [← h1] at h2
          apply hRne
          exact colAddr_eq hRp (by simp only [Prod.mk.injEq] at h2; omega)
  refine ⟨?_, ?_⟩
  · intro x hx a ha v hv
    have hxS : x ∈ A ++ T :: QR := List.mem_append_right _ hx
    have hS : A ++ T :: QR <+: H.roles := by rw [hroles]; exact ⟨Role.slot Ne :: B, by simp⟩
    have hvS : v ∈ A ++ T :: QR := by
      rcases owned_before ha hv with h | rfl
      · exact rolesBefore_sub_prefix hS hxS h
      · exact hxS
    have hxc : consumed x = false := by
      rcases List.mem_cons.1 hx with rfl | hx
      · exact hTnc
      · exact hQnc x hx
    rcases List.mem_append.1 hvS with h | h
    · exact Or.inl (hD v h (hprop ha hxc v hv))
    · exact Or.inr h
  · intro x hx a ha v hv
    have hxA : x ∈ A := by
      rw [hA]; exact List.mem_append_right _ (List.mem_cons_of_mem _ (List.mem_filter.1 hx).1)
    have hxc : consumed x = false := by
      have h2 := (List.mem_filter.1 hx).2
      refine Bool.eq_false_iff.2 (fun h => ?_)
      have h' : ((List.range rd.cursor).any fun i => x.inEntry ⟨rd.col, i⟩) = true := h
      rw [h'] at h2
      exact absurd h2 (by decide)
    have hS : A <+: H.roles := by rw [hroles]; exact List.prefix_append _ _
    have hvA : v ∈ A := by
      rcases owned_before ha hv with h | rfl
      · exact rolesBefore_sub_prefix hS hxA h
      · exact hxA
    exact hD v hvA (hprop ha hxc v hv)

-- provides: U3, L6.2b (deletion step)
theorem graph_deletion {E E' : Forest} {n : Nat} (h : Scan.stepKind E = some .deletion)
    (hexp : expand E n = some E') :
    E'.roles = E.roles.dropLast ∧ ∀ a, a ∈ graph E' ↔ a ∈ restrictTo (graph E) E'.roles := by sorry

-- provides: U3, L6.2d (the spine's `graph_prefix`†: the prefix before any old pre-stop role is
-- unchanged in `H[n]`; used by U5 with `ι = id`)
theorem graph_prefix {H H' : Forest} {n : Nat} {rs : RoleSets}
    (hH : H ≠ Tree.empty) (hV : Scan.CondV H) (hI : Scan.CondI H)
    (hk : Scan.stepKind H = some .ordinary) (hrs : roleSets H = some rs)
    (hexp : expand H n = some H') {x : Role} (hx : x ∈ rs.P) :
    rolesBefore H' x = rolesBefore H x ∧
    ∀ a, a ∈ restrictTo (graph H') (rolesBefore H x) ↔ a ∈ restrictTo (graph H) (rolesBefore H x) :=
  by sorry

/-! ## D6.1b  Graph transport along the surviving-role map of an anchor -/

/-- D6.1b: roles of `E` that are origins of roles of the anchor. -/
def originRange (E : Forest) (cap : Option (Closure.AdmCap E)) : List Role :=
  (Closure.anchor E cap).roles.filterMap (Closure.anchorOrigin E cap)

theorem baseAtom_vars_map {V W : Type} (f : V → W) (a : BaseAtom V) :
    (a.map f).vars = a.vars.map f := by
  cases a <;> rfl

/-- D6.1b helper: the representative pair `(A_o, A_o)` of the number just below a column is its
predecessor in the same forest. -/
theorem prev_of_rep {c₁ c₂ : ColAddr} {q : Nat} (h : c₂.rep 0 q = some (.ord c₁, .ord c₁))
    (hq : q + 1 = c₂.num 0) : c₁ = ⟨c₂.path, c₂.col - 1⟩ ∧ 1 ≤ c₂.col := by
  unfold ColAddr.rep at h
  obtain ⟨o, ho, hov⟩ := Option.map_eq_some_iff.1 h
  simp only [Prod.mk.injEq, Role.ord.injEq] at hov
  obtain ⟨rfl, hcont⟩ := hov
  have hcont' : o.container c₂ = none := by
    cases hc : o.container c₂ with
    | none => rfl
    | some e => rw [hc] at hcont; cases hcont
  obtain ⟨hs, hn⟩ := (ColAddr.resolve_spec 0 c₂ o q).1 ho
  rcases hs with ⟨k, ck, ik, hk, hp, hc⟩ | ⟨hp, hc⟩
  · exfalso
    have h1 := ColAddr.wsum_take_succ hk
    have h2 := ColAddr.wsum_take_le c₂.path (k + 1)
    have hkl : k < c₂.path.length := (List.getElem?_eq_some_iff.1 hk).1
    have hol : o.path.length = k := by rw [hp]; simp; omega
    simp only [ColAddr.num, hp] at hn hq
    have hcol : o.col = ck := by omega
    have : o.container c₂ = some ⟨o, ik⟩ := by
      rw [ColAddr.container_spec]
      refine ⟨rfl, ?_⟩
      show o.path ++ [(o.col, ik)] <+: c₂.path
      rw [hp, hcol]
      conv_rhs => rw [Tree.list_split_of_getElem? hk]
      exact ⟨c₂.path.drop (k + 1), by simp⟩
    rw [hcont'] at this
    cases this
  · simp only [ColAddr.num, hp] at hn hq
    have hoc : o.col = c₂.col - 1 := by omega
    exact ⟨colAddr_eq hp hoc, by omega⟩

/-- D6.1b helper: the origin of a slot is a slot (or undefined). -/
theorem origin_slot {E : Forest} (w : Closure.AdmCap E) (e : EntryAddr) :
    w.origin (.slot e) = none ∨ ∃ e', w.origin (.slot e) = some (.slot e') := by
  have hfold : ∀ ms : List Closure.Move, ∃ e', ms.foldr (fun m y => m.mapRole m.bwdIdx y) (Role.slot e) =
      .slot e' := by
    intro ms
    induction ms with
    | nil => exact ⟨e, rfl⟩
    | cons m ms ih =>
      obtain ⟨e', he'⟩ := ih
      refine ⟨m.mapEntry m.bwdIdx e', ?_⟩
      simp only [List.foldr_cons, he']
      rfl
  obtain ⟨e', he'⟩ := hfold w.moves
  show Closure.originBody w (.slot e) = none ∨ ∃ e'', Closure.originBody w (.slot e) = some (.slot e'')
  unfold Closure.originBody
  simp only [he']
  split_ifs
  · exact Or.inl rfl
  · exact Or.inr ⟨e', rfl⟩

/-- D6.1b helper: the column before a column of a forest exists. -/
theorem prev_col_mem {t : Forest} {d : ColAddr} (hd : Role.ord d ∈ t.roles) (h1 : 1 ≤ d.col) :
    Role.ord ⟨d.path, d.col - 1⟩ ∈ t.roles := by
  rw [Tree.mem_roles_iff] at hd ⊢
  show (t.colAt ⟨d.path, d.col - 1⟩).isSome
  change (t.colAt d).isSome at hd
  unfold Tree.colAt at hd ⊢
  cases hF : t.forestAt d.path with
  | none => rw [hF] at hd; simp at hd
  | some F =>
    rw [hF] at hd
    simp only [Option.bind_some] at hd ⊢
    obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 hd
    have hl := (List.getElem?_eq_some_iff.1 hx).1
    rw [List.getElem?_eq_getElem (by omega)]
    rfl

/-- D6.1b helper: the closing slot contains no column. -/
theorem not_contains_closing {H : Forest} {sd : Scan.StopData} (hsd : Scan.stopData H = some sd)
    {c : ColAddr} (hc : Role.ord c ∈ H.roles) : ¬ (Scan.closingSlot sd).heightPath <+: c.path := by
  rintro ⟨σ, hσ⟩
  obtain ⟨hcolT, -⟩ := Scan.stopData_spec hsd
  have hN : H.heightAt (Scan.closingSlot sd) = some Tree.empty := by
    simp [Tree.heightAt, Tree.entryAt, hcolT, Scan.closingSlot]
  rw [Tree.mem_roles_iff] at hc
  change (H.colAt c).isSome at hc
  obtain ⟨cp, cc⟩ := c
  simp only at hσ
  subst hσ
  rw [Tree.colAt_under hN] at hc
  cases σ with
  | nil => simp [Tree.colAt, Tree.forestAt, Tree.empty, Tree.cols] at hc
  | cons s σ =>
    obtain ⟨a, b⟩ := s
    rw [Tree.colAt_cons] at hc
    simp [Tree.empty, Tree.cols] at hc

/-- D6.1b helper: the representative pair of the number just below the next column of a forest. -/
theorem rep_next (c : ColAddr) :
    (⟨c.path, c.col + 1⟩ : ColAddr).rep 0 (c.num 0) = some (.ord c, .ord c) := by
  have hres : (⟨c.path, c.col + 1⟩ : ColAddr).resolve 0 (c.num 0) = some c := by
    rw [ColAddr.resolve_spec]
    exact ⟨Or.inr ⟨rfl, by simp⟩, rfl⟩
  unfold ColAddr.rep
  rw [hres]
  have : c.container ⟨c.path, c.col + 1⟩ = none := by
    cases h : c.container ⟨c.path, c.col + 1⟩ with
    | none => rfl
    | some e =>
      obtain ⟨h1, h2⟩ := (ColAddr.container_spec _ _ _).1 h
      have := h2.length_le
      simp [EntryAddr.heightPath, h1] at this
  simp [this]

-- provides: U3, D6.1b (non-order atoms correspond exactly; order is preserved)
theorem graph_origin {E : Forest} (hE : Scan.InL E) (cap : Option (Closure.AdmCap E)) :
    (∀ a, atomOwner a ≠ none →
      ((∃ a₀ ∈ graph (Closure.anchor E cap),
          (∀ v ∈ a₀.vars, (Closure.anchorOrigin E cap v).isSome) ∧ a = a₀.map (anchorD E cap)) ↔
        (a ∈ graph E ∧ ∀ v ∈ a.vars, v ∈ originRange E cap))) ∧
    (∀ x y, Before (Closure.anchor E cap) x y → (Closure.anchorOrigin E cap x).isSome →
      (Closure.anchorOrigin E cap y).isSome → Before E (anchorD E cap x) (anchorD E cap y)) := by
  cases cap with
  | none =>
    have hD : anchorD E none = id := by funext x; rfl
    have hR : originRange E none = E.roles := by
      simp [originRange, Closure.anchor, Closure.anchorOrigin]
    simp only [Closure.anchor, hD, hR]
    refine ⟨fun a _ => ?_, fun x y h _ _ => h⟩
    have hmap : ∀ a₀ : BaseAtom Role, a₀.map id = a₀ := by intro a₀; cases a₀ <;> rfl
    constructor
    · rintro ⟨a₀, ha₀, -, rfl⟩
      rw [hmap]
      exact ⟨ha₀, graph_vars_roles E a₀ ha₀⟩
    · rintro ⟨ha, -⟩
      exact ⟨a, ha, fun v _ => rfl, (hmap a).symm⟩
  | some w =>
    obtain ⟨hinj, hnone, hval, hord, hnum, hslot, hrep, horder⟩ := Closure.origin_spec_full hE w
    set H := w.H with hHdef
    have hanc : Closure.anchor E (some w) = H := rfl
    have hχ : Closure.anchorOrigin E (some w) = w.origin := rfl
    set chi := anchorD E (some w) with hchi
    have hchidef : ∀ x, chi x = (w.origin x).getD x := fun x => rfl
    have hchisome : ∀ x y, w.origin x = some y → chi x = y := by
      intro x y h; rw [hchidef, h]; rfl
    have hRng : ∀ v, v ∈ originRange E (some w) ↔ ∃ x ∈ H.roles, w.origin x = some v := by
      intro v; simp [originRange, Closure.anchor, Closure.anchorOrigin, hHdef]
    -- every non-closing role of `H` has an origin
    have hsome : ∀ x ∈ H.roles, (∀ sd, Scan.stopData H = some sd → x ≠ .slot (Scan.closingSlot sd)) →
        ∃ y, w.origin x = some y := by
      intro x hx hne
      cases h : w.origin x with
      | none =>
        obtain ⟨sd, hsd, rfl⟩ := (hnone x hx).1 h
        exact absurd rfl (hne sd hsd)
      | some y => exact ⟨y, rfl⟩
    have hord_some : ∀ c, Role.ord c ∈ H.roles → ∃ c', w.origin (.ord c) = some (.ord c') := by
      intro c hc
      rcases hord c hc with h | h
      · exact h
      · obtain ⟨sd, -, h'⟩ := (hnone _ hc).1 h
        cases h'
    rw [hanc, hχ]
    refine ⟨fun a hown => ?_, ?_⟩
    · constructor
      · rintro ⟨a₀, ha₀, hor, rfl⟩
        have hvars₀ := graph_vars_roles H a₀ ha₀
        refine ⟨?_, ?_⟩
        · rw [mem_graph_iff]
          rcases (mem_graph_iff H a₀).1 ha₀ with ⟨x, hx, rfl⟩ | ⟨i, x, y, -, -, rfl⟩ | ⟨c, hc, hc', rfl⟩ |
            ⟨e, p, o, v, hp, hov, ha'⟩
          · obtain ⟨u, hu⟩ := Option.isSome_iff_exists.1 (hor x (by simp [BaseAtom.vars]))
            exact Or.inl ⟨u, hval x hx u hu, by simp [BaseAtom.map, hchisome x u hu]⟩
          · simp [atomOwner, BaseAtom.map] at hown
          · obtain ⟨c₁, hc₁⟩ := hord_some c hc
            obtain ⟨c₂, hc₂⟩ := hord_some _ hc'
            have hn₂ := hnum _ _ hc' hc₂
            have hr := hrep _ _ hc' hc₂ (c.num 0) (by simp [ColAddr.num])
            rw [rep_next] at hr
            simp only [Option.map_some, hchisome _ _ hc₁] at hr
            obtain ⟨hc₁e, h1⟩ := prev_of_rep hr.symm (by simp [ColAddr.num] at hn₂ ⊢; omega)
            refine Or.inr (Or.inr (Or.inl ⟨c₁, hval _ hc _ hc₁, ?_, ?_⟩))
            · rw [hc₁e]; simp only [Nat.sub_add_cancel h1]; exact hval _ hc' _ hc₂
            · simp only [BaseAtom.map, hchisome _ _ hc₁, hchisome _ _ hc₂, hc₁e, Nat.sub_add_cancel h1]
          · have he : e ∈ H.entryAddrs := by
              rw [Tree.mem_entryAddrs_iff]
              obtain ⟨x, hx, -⟩ := Option.map_eq_some_iff.1 hp
              rw [hx]; rfl
            have hsl : Role.slot e ∈ H.roles := by rw [Tree.mem_roles_iff]; exact (Tree.mem_entryAddrs_iff _ _).1 he
            have hoc : Role.ord e.col ∈ H.roles := prefixRoles_sub (Tree.stack_mem_prefix he).1
            obtain ⟨u, hu⟩ := Option.isSome_iff_exists.1 (hor (.slot e) (by
              rcases ha' with rfl | rfl <;> simp [BaseAtom.vars]))
            rcases origin_slot w e with h | ⟨e', he'⟩
            · rw [h] at hu; cases hu
            rw [he'] at hu
            cases hu
            obtain ⟨hlab, hcol⟩ := hslot e e' hsl he'
            have hpl : p < e.col.num 0 := (rep_isSome_iff e.col p).1 (by rw [hov]; rfl)
            have hr := hrep _ _ hoc hcol p hpl
            rw [hov] at hr
            simp only [Option.map_some] at hr
            refine Or.inr (Or.inr (Or.inr ⟨e', p, chi o, chi v, by rw [← hlab]; exact hp, hr.symm, ?_⟩))
            rcases ha' with rfl | rfl
            · left; simp [BaseAtom.map, hchisome _ _ he', hchisome _ _ hcol]
            · right; simp [BaseAtom.map, hchisome _ _ he', hchisome _ _ hcol]
        · intro v hv
          rw [baseAtom_vars_map] at hv
          obtain ⟨v₀, hv₀, rfl⟩ := List.mem_map.1 hv
          obtain ⟨u, hu⟩ := Option.isSome_iff_exists.1 (hor v₀ hv₀)
          rw [hRng, hchisome _ _ hu]
          exact ⟨v₀, hvars₀ v₀ hv₀, hu⟩
      · rintro ⟨ha, hvars⟩
        have hvars' : ∀ v ∈ a.vars, ∃ x ∈ H.roles, w.origin x = some v := fun v hv => (hRng v).1 (hvars v hv)
        rcases (mem_graph_iff E a).1 ha with ⟨x, -, rfl⟩ | ⟨i, x, y, -, -, rfl⟩ | ⟨c, hc, hc', rfl⟩ |
          ⟨e, p, o, v, hp, hov, ha'⟩
        · obtain ⟨x₀, hx₀, hu⟩ := hvars' x (by simp [BaseAtom.vars])
          refine ⟨.lim x₀, (mem_graph_iff H _).2 (Or.inl ⟨x₀, hx₀, rfl⟩), ?_, ?_⟩
          · intro v hv; simp [BaseAtom.vars] at hv; subst hv; rw [hu]; rfl
          · simp [BaseAtom.map, hchisome _ _ hu]
        · simp [atomOwner] at hown
        · obtain ⟨z₀, hz₀, hu⟩ := hvars' (.ord ⟨c.path, c.col + 1⟩) (by simp [BaseAtom.vars])
          -- the preimage of `A_{c+1}` is an ordinary role
          obtain ⟨d₀, rfl⟩ : ∃ d₀, z₀ = .ord d₀ := by
            cases z₀ with
            | ord d₀ => exact ⟨d₀, rfl⟩
            | slot e₀ =>
              rcases origin_slot w e₀ with h | ⟨e', he'⟩
              · rw [h] at hu; cases hu
              · rw [he'] at hu; cases hu
          have hn := hnum _ _ hz₀ hu
          have hr := hrep _ _ hz₀ hu (c.num 0) (by simp [ColAddr.num] at hn ⊢; omega)
          rw [rep_next] at hr
          cases hrd : d₀.rep 0 (c.num 0) with
          | none => rw [hrd] at hr; cases hr
          | some ov =>
            rw [hrd] at hr
            simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq] at hr
            obtain ⟨h1, h2⟩ := hr
            -- the first representative is an ordinary role, so is the second
            obtain ⟨o₁, ho₁⟩ : ∃ o₁, ov.1 = .ord o₁ := by
              unfold ColAddr.rep at hrd
              obtain ⟨o', -, rfl⟩ := Option.map_eq_some_iff.1 hrd
              exact ⟨o', rfl⟩
            have hov2 : ov.2 = .ord o₁ := by
              unfold ColAddr.rep at hrd
              obtain ⟨o', -, hov'⟩ := Option.map_eq_some_iff.1 hrd
              rw [← hov'] at ho₁ h2 ⊢
              simp only [Role.ord.injEq] at ho₁
              subst ho₁
              split at h2
              · rename_i e'' _
                rcases origin_slot w e'' with h | ⟨e3, he3⟩
                · rw [hchidef, h] at h2; cases h2
                · rw [hchisome _ _ he3] at h2; cases h2
              · rfl
            have hrd' : d₀.rep 0 (c.num 0) = some (.ord o₁, .ord o₁) := by
              rw [hrd]
              obtain ⟨o1, o2⟩ := ov
              simp only at ho₁ hov2
              rw [ho₁, hov2]
            obtain ⟨ho₁e, hd1⟩ := prev_of_rep hrd' (by simp [ColAddr.num] at hn ⊢; omega)
            have ho₁m : Role.ord o₁ ∈ H.roles := by rw [ho₁e]; exact prev_col_mem hz₀ hd1
            obtain ⟨c₁', hc₁'⟩ := hord_some o₁ ho₁m
            have hχo₁ : chi (.ord o₁) = .ord c := by rw [← h1, ho₁]
            refine ⟨.elem (.ord o₁) (.ord ⟨o₁.path, o₁.col + 1⟩), ?_, ?_, ?_⟩
            · rw [mem_graph_iff]
              refine Or.inr (Or.inr (Or.inl ⟨o₁, ho₁m, ?_, rfl⟩))
              rw [ho₁e]; simp only [Nat.sub_add_cancel hd1]; exact hz₀
            · intro v hv
              simp only [BaseAtom.vars, List.mem_cons, List.not_mem_nil, or_false] at hv
              rcases hv with rfl | rfl
              · rw [hc₁']; rfl
              · rw [ho₁e]; simp only [Nat.sub_add_cancel hd1]; rw [hu]; rfl
            · have : (⟨o₁.path, o₁.col + 1⟩ : ColAddr) = d₀ := by
                rw [ho₁e]; simp only [Nat.sub_add_cancel hd1]
              simp only [BaseAtom.map, hχo₁, this, hchisome _ _ hu]
        · obtain ⟨x₀, hx₀, hu⟩ := hvars' (.slot e) (by rcases ha' with rfl | rfl <;> simp [BaseAtom.vars])
          obtain ⟨e₀, rfl⟩ : ∃ e₀, x₀ = .slot e₀ := by
            cases x₀ with
            | slot e₀ => exact ⟨e₀, rfl⟩
            | ord c₀ =>
              obtain ⟨c', hc'⟩ := hord_some c₀ hx₀
              rw [hc'] at hu; cases hu
          obtain ⟨hlab, hcol⟩ := hslot e₀ e hx₀ hu
          have he₀ : e₀ ∈ H.entryAddrs := by
            rw [Tree.mem_entryAddrs_iff]; rw [Tree.mem_roles_iff] at hx₀; exact hx₀
          have hoc : Role.ord e₀.col ∈ H.roles := prefixRoles_sub (Tree.stack_mem_prefix he₀).1
          have hn := hnum _ _ hoc hcol
          have hpl : p < e.col.num 0 := (rep_isSome_iff e.col p).1 (by rw [hov]; rfl)
          have hr := hrep _ _ hoc hcol p (by omega)
          rw [hov] at hr
          cases hr₀ : e₀.col.rep 0 p with
          | none => rw [hr₀] at hr; cases hr
          | some ov =>
            rw [hr₀] at hr
            simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq] at hr
            obtain ⟨h1, h2⟩ := hr
            obtain ⟨hm1, hm2⟩ := rep_mem_prefix he₀ hr₀
            -- the representatives are not the closing slot
            have hnc : ∀ x, (x = ov.1 ∨ x = ov.2) → ∃ y, w.origin x = some y := by
              rintro x hx
              apply hsome x (by rcases hx with rfl | rfl <;> first | exact prefixRoles_sub hm1 | exact prefixRoles_sub hm2)
              intro sd hsd hxN
              unfold ColAddr.rep at hr₀
              obtain ⟨o', -, hov'⟩ := Option.map_eq_some_iff.1 hr₀
              rw [← hov'] at hx
              rcases hx with hx | hx
              · rw [hxN] at hx; cases hx
              · try simp only at hx
                split at hx
                · rename_i e'' he''
                  have heq : e'' = Scan.closingSlot sd := Role.slot.inj (hx.symm.trans hxN)
                  obtain ⟨-, h3⟩ := (ColAddr.container_spec _ _ _).1 he''
                  rw [heq] at h3
                  exact not_contains_closing hsd hoc h3
                · rw [hxN] at hx; cases hx
            obtain ⟨y1, hy1⟩ := hnc ov.1 (Or.inl rfl)
            obtain ⟨y2, hy2⟩ := hnc ov.2 (Or.inr rfl)
            have hp₀ : (H.entryAt e₀).map Prod.fst = some p := by rw [hlab]; exact hp
            rcases ha' with rfl | rfl
            · refine ⟨.edge (.slot e₀) (.ord e₀.col) ov.1, (mem_graph_iff H _).2
                (Or.inr (Or.inr (Or.inr ⟨e₀, p, ov.1, ov.2, hp₀, hr₀, Or.inl rfl⟩))), ?_, ?_⟩
              · intro x hx
                simp only [BaseAtom.vars, List.mem_cons, List.not_mem_nil, or_false] at hx
                rcases hx with rfl | rfl | rfl
                · rw [hu]; rfl
                · rw [hcol]; rfl
                · rw [hy1]; rfl
              · simp [BaseAtom.map, hchisome _ _ hu, hchisome _ _ hcol, h1]
            · refine ⟨.edge (.slot e₀) (.ord e₀.col) ov.2, (mem_graph_iff H _).2
                (Or.inr (Or.inr (Or.inr ⟨e₀, p, ov.1, ov.2, hp₀, hr₀, Or.inr rfl⟩))), ?_, ?_⟩
              · intro x hx
                simp only [BaseAtom.vars, List.mem_cons, List.not_mem_nil, or_false] at hx
                rcases hx with rfl | rfl | rfl
                · rw [hu]; rfl
                · rw [hcol]; rfl
                · rw [hy2]; rfl
              · simp [BaseAtom.map, hchisome _ _ hu, hchisome _ _ hcol, h2]
    · intro x y hxy hx hy
      exact horder x y hxy hx hy

/-! ## D7.1a  Frames and blocks read inside a tree -/

/-- D7.1a: inverse of `Role.under` on roles below `pfx`. -/
def relRole (pfx : List (Nat × Nat)) : Role → Role
  | .ord d => .ord ⟨d.path.drop pfx.length, d.col⟩
  | .slot e => .slot ⟨⟨e.col.path.drop pfx.length, e.col.col⟩, e.idx⟩

/-- D7.1a: a column inside the height of `e`, with its address made relative to that height. -/
def relCol (e : EntryAddr) (d : ColAddr) : ColAddr := ⟨d.path.drop e.heightPath.length, d.col⟩

-- provides: U3, D7.1a (a visible column sees the same representatives below its own number)
theorem rep_visible (c o : ColAddr) (ho : c.resolve 0 (o.num 0) = some o) :
    ∀ q, q < o.num 0 → o.rep 0 q = c.rep 0 q := by
  intro q hq
  have hs : c.OnStack o := ((ColAddr.resolve_spec 0 c o _).1 ho).1
  unfold ColAddr.rep
  rw [ColAddr.resolve_of_resolve_lt ho hq]
  cases hr : c.resolve 0 q with
  | none => rfl
  | some r =>
    have hrq : r.num 0 = q := ColAddr.resolve_num hr
    have hcont : r.container o = r.container c := by
      apply Option.ext
      intro e
      rw [ColAddr.container_spec, ColAddr.container_spec]
      constructor
      · rintro ⟨h1, h2⟩; exact ⟨h1, h2.trans (onStack_path_prefix hs)⟩
      · rintro ⟨h1, h2⟩
        refine ⟨h1, EntryAddr.contains_of_resolve (c := c) h2 ho ?_⟩
        rw [h1, hrq]; exact hq
    simp only [Option.map_some, hcont]

/-- D7.1a helper: `resolveAux` passes the levels below the number it resolves. -/
theorem resolveAux_skip (rest : List (Nat × Nat)) (j q : Nat) :
    ∀ (π pre : List (Nat × Nat)) (start : Nat), start + (π.map (·.1 + 1)).sum ≤ q →
      ColAddr.resolveAux start pre (π ++ rest) j q =
        ColAddr.resolveAux (start + (π.map (·.1 + 1)).sum) (pre ++ π) rest j q
  | [], pre, start, _ => by simp
  | (ck, ik) :: π, pre, start, h => by
    simp only [List.map_cons, List.sum_cons] at h
    simp only [List.cons_append, ColAddr.resolveAux]
    rw [if_neg (by omega), resolveAux_skip rest j q π (pre ++ [(ck, ik)]) (start + ck + 1) (by omega)]
    simp only [List.map_cons, List.sum_cons, List.append_assoc, List.singleton_append]
    congr 1
    omega

/-- D7.1a helper: `resolveAux` commutes with prefixing a path and shifting the numbers. -/
theorem resolveAux_shift (π : List (Nat × Nat)) (j k : Nat) :
    ∀ (rest pre : List (Nat × Nat)) (start q : Nat),
      ColAddr.resolveAux (start + k) (π ++ pre) rest j (q + k) =
        (ColAddr.resolveAux start pre rest j q).map (fun o => ⟨π ++ o.path, o.col⟩)
  | [], pre, start, q => by
    simp only [ColAddr.resolveAux]
    by_cases h : start ≤ q ∧ q < start + j
    · rw [if_pos (by omega), if_pos h]
      simp only [Option.map_some]
      congr 2; omega
    · rw [if_neg (by omega), if_neg h]; rfl
  | (ck, ik) :: rest, pre, start, q => by
    simp only [ColAddr.resolveAux]
    by_cases h : start ≤ q ∧ q ≤ start + ck
    · rw [if_pos (by omega), if_pos h]
      simp only [Option.map_some]
      congr 2; omega
    · rw [if_neg (by omega), if_neg h]
      have := resolveAux_shift π j k rest (pre ++ [(ck, ik)]) (start + ck + 1) q
      rw [← this, List.append_assoc]
      congr 1
      omega

/-- D7.1a helper: containers read under a common path prefix. -/
theorem container_under (σ τ : List (Nat × Nat)) (o : ColAddr) (dc : Nat) :
    ColAddr.container ⟨σ ++ o.path, o.col⟩ ⟨σ ++ τ, dc⟩ =
      (o.container ⟨τ, dc⟩).map (fun e' => ⟨⟨σ ++ e'.col.path, e'.col.col⟩, e'.idx⟩) := by
  apply Option.ext
  intro E
  rw [ColAddr.container_spec]
  constructor
  · rintro ⟨h1, h2⟩
    refine Option.mem_map.2 ⟨⟨o, E.idx⟩, ?_, ?_⟩
    · show o.container ⟨τ, dc⟩ = some ⟨o, E.idx⟩
      rw [ColAddr.container_spec]
      refine ⟨rfl, ?_⟩
      simp only [EntryAddr.heightPath, h1, List.append_assoc] at h2
      exact (List.prefix_append_right_inj σ).1 h2
    · obtain ⟨⟨Ep, Ec⟩, Ei⟩ := E
      simp only at h1
      cases h1
      rfl
  · intro h
    obtain ⟨e', he', rfl⟩ := Option.mem_map.1 h
    have he'' : o.container ⟨τ, dc⟩ = some e' := he'
    rw [ColAddr.container_spec] at he''
    have he' := he''
    obtain ⟨h1, h2⟩ := he'
    subst h1
    refine ⟨rfl, ?_⟩
    simp only [EntryAddr.heightPath, List.append_assoc]
    exact (List.prefix_append_right_inj σ).2 h2

-- provides: U3, D7.1a (the visible stack seen from inside the height of `e`)
theorem rep_inside (e : EntryAddr) (d : ColAddr) (hd : e.heightPath <+: d.path) :
    (∀ q, q < e.col.num 0 → d.rep 0 q = e.col.rep 0 q) ∧
    d.rep 0 (e.col.num 0) = some (.ord e.col, .slot e) ∧
    (∀ w, 1 ≤ w → d.rep 0 (e.col.num 0 + w) =
      ((relCol e d).rep 1 w).map fun ov => (Role.under e.heightPath ov.1, Role.under e.heightPath ov.2)) ∧
    d.num 0 = e.col.num 0 + (relCol e d).num 1 := by
  have hc : e.Contains d := hd
  have hres := EntryAddr.resolve_host hc
  obtain ⟨dp, dc⟩ := d
  obtain ⟨σ, hσ⟩ := hd
  simp only at hσ
  subst hσ
  have hrel : relCol e ⟨e.heightPath ++ σ, dc⟩ = ⟨σ, dc⟩ := by simp [relCol]
  have hwid : (e.heightPath.map (·.1 + 1)).sum = e.col.num 0 + 1 := by
    simp [EntryAddr.heightPath, ColAddr.num]; omega
  refine ⟨fun q hq => (rep_visible _ e.col hres q hq).symm, ?_, ?_, ?_⟩
  · unfold ColAddr.rep
    rw [hres]
    simp only [Option.map_some, (EntryAddr.contains_iff_container e _).1 hc]
  · intro w hw
    have hr : ColAddr.resolve 0 ⟨e.heightPath ++ σ, dc⟩ (e.col.num 0 + w) =
        ((ColAddr.resolve 1 ⟨σ, dc⟩ w)).map (fun o => ⟨e.heightPath ++ o.path, o.col⟩) := by
      unfold ColAddr.resolve
      simp only
      rw [resolveAux_skip σ dc _ e.heightPath [] 0 (by omega)]
      have := resolveAux_shift e.heightPath dc (e.col.num 0) σ [] 1 w
      simp only [List.append_nil] at this
      rw [← this]
      congr 1
      · omega
      · omega
    unfold ColAddr.rep
    rw [hr, hrel]
    cases (ColAddr.resolve 1 ⟨σ, dc⟩ w) with
    | none => rfl
    | some o =>
      simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq]
      refine ⟨rfl, ?_⟩
      rw [container_under e.heightPath σ o dc]
      cases o.container ⟨σ, dc⟩ with
      | none => rfl
      | some e' => rfl
  · rw [hrel]
    simp only [ColAddr.num, EntryAddr.heightPath, List.map_append, List.sum_append]
    simp
    omega

/-- D7.1a: the first `m` columns of a forest (the "proper prefix" of Case 1). -/
def takeCols (X : Forest) (m : Nat) : Forest := .node (X.cols.take m)

theorem takeCols_roles_prefix (B : Forest) (m : Nat) : (takeCols B m).roles <+: B.roles := by
  cases B with
  | node cols =>
    show Tree.rolesCols [] 0 (cols.take m) <+: Tree.rolesCols [] 0 cols
    conv_rhs => rw [← List.take_append_drop m cols, Tree.rolesCols_append]
    exact List.prefix_append _ _

theorem takeCols_entryAt (B : Forest) (m : Nat) (e' : EntryAddr) (y : Nat × Forest)
    (h : (takeCols B m).entryAt e' = some y) : B.entryAt e' = some y := by
  cases B with
  | node cols =>
    obtain ⟨⟨P, j⟩, i⟩ := e'
    cases P with
    | nil =>
      rw [takeCols, Tree.entryAt_nil, Option.bind_eq_some_iff] at h
      obtain ⟨col, hcol, hy⟩ := h
      simp only [Tree.cols] at hcol
      rw [Tree.entryAt_nil, Tree.getElem?_take_bind hcol]; exact hy
    | cons ab P =>
      obtain ⟨a, b⟩ := ab
      rw [takeCols, Tree.entryAt_cons, Option.bind_eq_some_iff] at h
      obtain ⟨z, hz, hy⟩ := h
      simp only [Tree.cols, Option.bind_eq_some_iff] at hz
      obtain ⟨col, hcol, hz⟩ := hz
      rw [Tree.entryAt_cons, Option.bind_eq_some_iff]
      exact ⟨z, by simp [Tree.cols, Tree.getElem?_take_bind hcol, hz], hy⟩

theorem takeCols_length (B : Forest) : takeCols B B.cols.length = B := by
  cases B with
  | node cols => simp [takeCols, Tree.cols]

/-- D7.1a helper: entries of a relative key of a column prefix of the height of `e`, read in `F`. -/
theorem key_entry {F : Forest} {e : EntryAddr} {B : Forest} (hB : F.heightAt e = some B) (m : Nat)
    {e' : EntryAddr} {lab : Bool × Nat} {hh : Key}
    (h : (relKey (e.col.num 0) (takeCols B m)).entryAt e' = some (lab, hh)) :
    ∃ p h₀, F.entryAt ⟨⟨e.heightPath ++ e'.col.path, e'.col.col⟩, e'.idx⟩ = some (p, h₀) ∧
      lab = (if p < e.col.num 0 then (false, p) else (true, p - e.col.num 0)) := by
  rw [relKey, Tree.entryAt_map] at h
  obtain ⟨⟨p, h₀⟩, hp, hy⟩ := Option.map_eq_some_iff.1 h
  simp only [Prod.mk.injEq] at hy
  refine ⟨p, h₀, ?_, hy.1.symm⟩
  rw [Tree.entryAt_under hB]
  exact takeCols_entryAt B m e' _ hp

theorem relCol_under (e : EntryAddr) (c : ColAddr) :
    relCol e ⟨e.heightPath ++ c.path, c.col⟩ = c := by
  simp [relCol]

/-- D7.1a helper: the edges read by an internal entry, in the three cases of its key label. -/
theorem inner_edges {e : EntryAddr} (e' : EntryAddr) (p : Nat) :
    let E' : EntryAddr := ⟨⟨e.heightPath ++ e'.col.path, e'.col.col⟩, e'.idx⟩
    (p < e.col.num 0 → E'.col.rep 0 p = e.col.rep 0 p) ∧
    (p = e.col.num 0 → E'.col.rep 0 p = some (.ord e.col, .slot e)) ∧
    (∀ v, p = e.col.num 0 + (v + 1) → E'.col.rep 0 p =
      (e'.col.rep 1 (v + 1)).map fun ov => (Role.under e.heightPath ov.1, Role.under e.heightPath ov.2)) := by
  intro E'
  have hd : e.heightPath <+: E'.col.path := List.prefix_append _ _
  obtain ⟨h1, h2, h3, -⟩ := rep_inside e E'.col hd
  refine ⟨h1 p, fun h => h ▸ h2, fun v hv => ?_⟩
  rw [hv, h3 (v + 1) (by omega)]
  simp only [E', relCol_under]

/-- D7.1a helper: `freeBlock_graph` without condition V (which its proof does not use). -/
theorem freeBlock_graph_core {F : Forest} {e : EntryAddr} (he : e ∈ F.entryAddrs) (m : Nat) :
    ∀ a ∈ freeBlock (relKey (e.col.num 0) (takeCols ((F.heightAt e).getD Tree.empty) m)),
      a.map (blockMap e) ∈ graph F := by
  obtain ⟨post, hr, -⟩ := Tree.roles_entry he
  have he' := he
  rw [Tree.mem_entryAddrs_iff] at he'
  obtain ⟨⟨p0, B⟩, hx⟩ := Option.isSome_iff_exists.1 he'
  have hB : F.heightAt e = some B := by simp [Tree.heightAt, hx]
  rw [hB, Option.getD_some] at hr ⊢
  have hslot : Role.slot e ∈ F.roles := by rw [hr]; simp
  have hKr : ∀ r, r ∈ (relKey (e.col.num 0) (takeCols B m)).roles → r.under e.heightPath ∈ F.roles :=
    fun r h => Tree.under_mem_roles hB ((takeCols_roles_prefix B m).mem (by rwa [relKey_roles] at h))
  intro a ha
  unfold freeBlock at ha
  simp only [List.mem_cons, List.mem_append, List.mem_map, List.mem_filterMap,
    List.mem_flatMap] at ha
  rw [mem_graph_iff]
  rcases ha with ((((rfl | ⟨r, hr', rfl⟩) | ⟨⟨x, y⟩, hxy, rfl⟩) | ⟨c, hc, hc'⟩) | ⟨e', he', ha⟩)
  · exact Or.inl ⟨_, hslot, rfl⟩
  · obtain ⟨r', hr'', rfl⟩ := hr'
    exact Or.inl ⟨_, hKr r' hr'', rfl⟩
  · -- order atoms: consecutive in `slot e :: K.roles.map (under hp)`, a segment of `F.roles`
    set rs := (relKey (e.col.num 0) (takeCols B m)).roles.map BlkVar.inner
    obtain ⟨i, hi⟩ := List.mem_iff_getElem?.1 hxy
    have hrs : rs = (BlkVar.owner :: rs).tail := rfl
    rw [hrs, List.getElem?_zip_eq_some, List.getElem?_tail] at hi
    have hM : (BlkVar.owner :: rs).map (blockMap e) =
        Role.slot e :: (takeCols B m).roles.map (Role.under e.heightPath) := by
      simp only [rs, List.map_cons, List.map_map, relKey_roles]
      rfl
    obtain ⟨X, hX⟩ := takeCols_roles_prefix B m
    have hF : F.roles = prefixRoles F e ++ ((BlkVar.owner :: rs).map (blockMap e) ++
        (X.map (Role.under e.heightPath) ++ post)) := by
      rw [hM, hr, ← hX]; simp
    have hget : ∀ k z, (BlkVar.owner :: rs)[k]? = some z →
        F.roles[(prefixRoles F e).length + k]? = some (blockMap e z) := by
      intro k z hz
      rw [hF, List.getElem?_append_right (by omega), Nat.add_sub_cancel_left,
        List.getElem?_append_left (by
          have := (List.getElem?_eq_some_iff.1 hz).1
          simpa using this), List.getElem?_map, hz]
      rfl
    refine Or.inr (Or.inl ⟨(prefixRoles F e).length + i, _, _, hget i x hi.1,
      by rw [show (prefixRoles F e).length + i + 1 = (prefixRoles F e).length + (i + 1) by omega];
         exact hget (i + 1) y hi.2, rfl⟩)
  · split_ifs at hc' with h
    cases hc'
    rw [Tree.mem_colAddrs_iff] at hc
    refine Or.inr (Or.inr (Or.inl ⟨⟨e.heightPath ++ c.path, c.col⟩, ?_, ?_, rfl⟩))
    · exact hKr (.ord c) (by rw [Tree.mem_roles_iff]; exact hc)
    · exact hKr (.ord ⟨c.path, c.col + 1⟩) (by rw [Tree.mem_roles_iff]; exact h)
  · rw [Tree.mem_entryAddrs_iff] at he'
    obtain ⟨⟨lab, hh⟩, hK⟩ := Option.isSome_iff_exists.1 he'
    obtain ⟨p, h₀, hE, hlab⟩ := key_entry hB m hK
    rw [hK] at ha
    obtain ⟨hlt, heq, hgt⟩ := inner_edges (e := e) e' p
    refine Or.inr (Or.inr (Or.inr ⟨⟨⟨e.heightPath ++ e'.col.path, e'.col.col⟩, e'.idx⟩, p, ?_⟩))
    rw [hE]
    by_cases hpa : p < e.col.num 0
    · rw [if_pos hpa] at hlab
      subst hlab
      obtain ⟨⟨o, v⟩, hov⟩ := Option.isSome_iff_exists.1 ((rep_isSome_iff e.col p).2 hpa)
      refine ⟨o, v, rfl, by rw [hlt hpa, hov], ?_⟩
      simp only [List.mem_cons, List.not_mem_nil, or_false] at ha
      rcases ha with rfl | rfl
      · left; simp [BaseAtom.map, blockMap, hov, Role.under]
      · right; simp [BaseAtom.map, blockMap, hov, Role.under]
    · rw [if_neg hpa] at hlab
      subst hlab
      obtain ⟨v, hv⟩ : ∃ v, p - e.col.num 0 = v := ⟨_, rfl⟩
      cases v with
      | zero =>
        rw [hv] at ha
        refine ⟨.ord e.col, .slot e, rfl, heq (by omega), ?_⟩
        simp only [List.mem_cons, List.not_mem_nil, or_false] at ha
        rcases ha with rfl | rfl
        · left; rfl
        · right; rfl
      | succ v =>
        rw [hv] at ha
        simp only at ha
        cases hr1 : e'.col.rep 1 (v + 1) with
        | none => rw [hr1] at ha; simp at ha
        | some ow =>
          obtain ⟨o, w⟩ := ow
          rw [hr1] at ha
          refine ⟨o.under e.heightPath, w.under e.heightPath, rfl,
            by rw [hgt v (by omega), hr1]; rfl, ?_⟩
          simp only [List.mem_cons, List.not_mem_nil, or_false] at ha
          rcases ha with rfl | rfl
          · left; rfl
          · right; rfl

-- provides: U3, D7.1a (a free block of a column prefix of a height lies in the graph)
theorem freeBlock_graph {F : Forest} {e : EntryAddr} (he : e ∈ F.entryAddrs) (hV : Scan.CondV F)
    (m : Nat) :
    ∀ a ∈ freeBlock (relKey (e.col.num 0) (takeCols ((F.heightAt e).getD Tree.empty) m)),
      a.map (blockMap e) ∈ graph F :=
  freeBlock_graph_core he m

-- provides: U3, D7.1a (the two heads of the positive block are the entry's own heads)
theorem posBlock_heads_graph {F : Forest} {e : EntryAddr} (he : e ∈ F.entryAddrs)
    (hV : Scan.CondV F) :
    ∀ a ∈ posBlock (relKey (e.col.num 0) ((F.heightAt e).getD Tree.empty))
        (((F.entryAt e).map Prod.fst).getD 0),
      a.map (blockMap e) ∈ graph F := by
  intro a ha
  unfold posBlock at ha
  rcases List.mem_append.1 ha with ha | ha
  · have := freeBlock_graph_core he ((F.heightAt e).getD Tree.empty).cols.length a
    rw [takeCols_length] at this
    exact this ha
  · have he' := he
    rw [Tree.mem_entryAddrs_iff] at he'
    obtain ⟨⟨p0, B⟩, hx⟩ := Option.isSome_iff_exists.1 he'
    have hres := hV e he p0 B hx
    obtain ⟨⟨o, v⟩, hov⟩ := Option.isSome_iff_exists.1
      ((rep_isSome_iff e.col p0).2 ((ColAddr.resolve_isSome_iff 0 e.col p0).1 hres).2)
    rw [hx] at ha
    rw [mem_graph_iff]
    refine Or.inr (Or.inr (Or.inr ⟨e, p0, o, v, by rw [hx]; rfl, hov, ?_⟩))
    simp only [Option.map_some, Option.getD_some, List.mem_cons, List.not_mem_nil, or_false] at ha
    rcases ha with rfl | rfl
    · left; simp [BaseAtom.map, blockMap, hov]
    · right; simp [BaseAtom.map, blockMap, hov]

/-- D7.1a helper: `graph_owned_block` without condition V (which its proof does not use). -/
theorem graph_owned_block_core {F : Forest} {e : EntryAddr} (he : e ∈ F.entryAddrs)
    (z : Role) (hz : z = .slot e ∨ e.heightPath <+: z.path) :
    ∀ a ∈ ownedBy (graph F) z, ∃ a₀ ∈ posBlock (relKey (e.col.num 0) ((F.heightAt e).getD Tree.empty))
      (((F.entryAt e).map Prod.fst).getD 0), a = a₀.map (blockMap e) := by
  have he' := he
  rw [Tree.mem_entryAddrs_iff] at he'
  obtain ⟨⟨p0, B⟩, hx⟩ := Option.isSome_iff_exists.1 he'
  have hB : F.heightAt e = some B := by simp [Tree.heightAt, hx]
  rw [hB, hx, Option.getD_some]
  simp only [Option.map_some, Option.getD_some]
  set K := relKey (e.col.num 0) B with hKdef
  have hKroles : K.roles = B.roles := relKey_roles _ _
  have hKcol : ∀ c, (K.colAt c).isSome = (B.colAt c).isSome := by
    intro c; rw [hKdef, relKey, Tree.colAt_map]; cases B.colAt c <;> rfl
  have hKent : ∀ e', K.entryAt e' = (B.entryAt e').map
      (fun x => (if x.1 < e.col.num 0 then (false, x.1) else (true, x.1 - e.col.num 0),
        relKey (e.col.num 0) x.2)) := by
    intro e'; rw [hKdef, relKey, Tree.entryAt_map]; rfl
  have hfree : ∀ a₀, a₀ ∈ freeBlock K → a₀ ∈ posBlock K p0 := fun a₀ h =>
    List.mem_append_left _ h
  intro a ha
  unfold ownedBy at ha
  rw [List.mem_filter, beq_iff_eq] at ha
  obtain ⟨ha, hown⟩ := ha
  rcases (mem_graph_iff F a).1 ha with ⟨x, hx', rfl⟩ | ⟨i, x, y, -, -, rfl⟩ | ⟨c, hc, hc', rfl⟩ |
    ⟨E', p, o, v, hp, hov, ha'⟩
  · simp only [atomOwner, Option.some.injEq] at hown
    subst hown
    rcases hz with rfl | hz
    · exact ⟨.lim .owner, hfree _ (by unfold freeBlock; simp), rfl⟩
    · obtain ⟨r, hr, rfl⟩ := List.mem_map.1 (Tree.mem_height_of_prefix hx hx' hz)
      refine ⟨.lim (.inner r), hfree _ ?_, rfl⟩
      unfold freeBlock
      simp only [List.mem_cons, List.mem_append, List.mem_map]
      exact Or.inl (Or.inl (Or.inl (Or.inr ⟨_, ⟨r, by rw [hKroles]; exact hr, rfl⟩, rfl⟩)))
  · simp [atomOwner] at hown
  · simp only [atomOwner, Option.some.injEq] at hown
    subst hown
    rcases hz with h | hz
    · cases h
    · obtain ⟨τ, hτ⟩ := hz
      simp only [Role.path] at hτ
      obtain ⟨cp, cc⟩ := c
      simp only at hτ hc hc' ⊢
      subst hτ
      rw [Tree.mem_roles_iff] at hc hc'
      change (F.colAt ⟨e.heightPath ++ τ, cc⟩).isSome at hc
      change (F.colAt ⟨e.heightPath ++ τ, cc + 1⟩).isSome at hc'
      rw [Tree.colAt_under hB] at hc hc'
      refine ⟨.elem (.inner (.ord ⟨τ, cc⟩)) (.inner (.ord ⟨τ, cc + 1⟩)), hfree _ ?_, rfl⟩
      unfold freeBlock
      simp only [List.mem_cons, List.mem_append, List.mem_filterMap]
      refine Or.inl (Or.inr ⟨⟨τ, cc⟩, ?_, ?_⟩)
      · rw [Tree.mem_colAddrs_iff, hKcol]; exact hc
      · rw [if_pos (by rw [hKcol]; exact hc')]
  · have hown' : z = .slot E' := by
      rcases ha' with rfl | rfl <;> simpa [atomOwner] using hown.symm
    subst hown'
    obtain ⟨⟨p', H'⟩, hE', rfl⟩ := Option.map_eq_some_iff.1 hp
    rcases hz with h | hz
    · cases h
      rw [hx] at hE'
      cases hE'
      simp only at hov
      rcases ha' with rfl | rfl
      · exact ⟨.edge .owner .host (.ord p0), List.mem_append_right _ (List.mem_cons_self ..),
          by simp [BaseAtom.map, blockMap, hov]⟩
      · exact ⟨.edge .owner .host (.cur p0),
          List.mem_append_right _ (List.mem_cons_of_mem _ (List.mem_cons_self ..)),
          by simp [BaseAtom.map, blockMap, hov]⟩
    · obtain ⟨τ, hτ⟩ := hz
      obtain ⟨⟨Ep, cc⟩, ii⟩ := E'
      simp only [Role.path] at hτ
      subst hτ
      have hBe : B.entryAt ⟨⟨τ, cc⟩, ii⟩ = some (p', H') := by
        rw [← Tree.entryAt_under hB]; exact hE'
      have hKe := hKent ⟨⟨τ, cc⟩, ii⟩
      rw [hBe] at hKe
      simp only [Option.map_some] at hKe
      have hmem : (⟨⟨τ, cc⟩, ii⟩ : EntryAddr) ∈ K.entryAddrs := by
        rw [Tree.mem_entryAddrs_iff, hKe]; rfl
      obtain ⟨hlt, heq, hgt⟩ := inner_edges (e := e) ⟨⟨τ, cc⟩, ii⟩ p'
      simp only at hlt heq hgt hov
      have hfb : ∀ a₀, (a₀ ∈ (match K.entryAt ⟨⟨τ, cc⟩, ii⟩ with
          | some ((false, q), _) => [BaseAtom.edge (BlkVar.inner (.slot ⟨⟨τ, cc⟩, ii⟩))
              (BlkVar.inner (.ord ⟨τ, cc⟩)) (.ord q), BaseAtom.edge (BlkVar.inner (.slot ⟨⟨τ, cc⟩, ii⟩))
              (BlkVar.inner (.ord ⟨τ, cc⟩)) (.cur q)]
          | some ((true, 0), _) => [BaseAtom.edge (BlkVar.inner (.slot ⟨⟨τ, cc⟩, ii⟩))
              (BlkVar.inner (.ord ⟨τ, cc⟩)) .host, BaseAtom.edge (BlkVar.inner (.slot ⟨⟨τ, cc⟩, ii⟩))
              (BlkVar.inner (.ord ⟨τ, cc⟩)) .owner]
          | some ((true, v + 1), _) =>
            match (ColAddr.mk τ cc).rep 1 (v + 1) with
            | some (o, w) => [BaseAtom.edge (BlkVar.inner (.slot ⟨⟨τ, cc⟩, ii⟩))
                (BlkVar.inner (.ord ⟨τ, cc⟩)) (.inner o), BaseAtom.edge (BlkVar.inner (.slot ⟨⟨τ, cc⟩, ii⟩))
                (BlkVar.inner (.ord ⟨τ, cc⟩)) (.inner w)]
            | none => []
          | none => [] : List (BaseAtom BlkVar))) → a₀ ∈ posBlock K p0 := by
        intro a₀ ha₀
        apply hfree
        unfold freeBlock
        simp only [List.mem_cons, List.mem_append, List.mem_flatMap]
        exact Or.inr ⟨_, hmem, ha₀⟩
      by_cases hpa : p' < e.col.num 0
      · rw [if_pos hpa] at hKe
        rw [hlt hpa] at hov
        rcases ha' with rfl | rfl
        · exact ⟨_, hfb _ (by simp only [hKe]; exact List.mem_cons_self ..),
            by simp [BaseAtom.map, blockMap, Role.under, hov]⟩
        · exact ⟨_, hfb _ (by simp only [hKe]; exact List.mem_cons_of_mem _ (List.mem_cons_self ..)),
            by simp [BaseAtom.map, blockMap, Role.under, hov]⟩
      · rw [if_neg hpa] at hKe
        obtain ⟨w, hw⟩ : ∃ w, p' - e.col.num 0 = w := ⟨_, rfl⟩
        cases w with
        | zero =>
          rw [hw] at hKe
          rw [heq (by omega)] at hov
          simp only [Option.some.injEq, Prod.mk.injEq] at hov
          obtain ⟨rfl, rfl⟩ := hov
          rcases ha' with rfl | rfl
          · exact ⟨_, hfb _ (by simp only [hKe]; exact List.mem_cons_self ..),
              by simp [BaseAtom.map, blockMap, Role.under]⟩
          · exact ⟨_, hfb _ (by simp only [hKe]; exact List.mem_cons_of_mem _ (List.mem_cons_self ..)),
              by simp [BaseAtom.map, blockMap, Role.under]⟩
        | succ w =>
          rw [hw] at hKe
          rw [hgt w (by omega)] at hov
          obtain ⟨⟨o₁, v₁⟩, hr1, hov'⟩ := Option.map_eq_some_iff.1 hov
          simp only [Prod.mk.injEq] at hov'
          obtain ⟨rfl, rfl⟩ := hov'
          rcases ha' with rfl | rfl
          · exact ⟨_, hfb _ (by simp only [hKe, hr1]; exact List.mem_cons_self ..),
              by simp [BaseAtom.map, blockMap, Role.under]⟩
          · exact ⟨_, hfb _ (by simp only [hKe, hr1]; exact List.mem_cons_of_mem _ (List.mem_cons_self ..)),
              by simp [BaseAtom.map, blockMap, Role.under]⟩

-- provides: U3, D7.1a (converse: every atom owned by the slot of `e` or by a role inside its
-- height is the image of an atom of the positive block)
theorem graph_owned_block {F : Forest} {e : EntryAddr} (he : e ∈ F.entryAddrs) (hV : Scan.CondV F)
    (z : Role) (hz : z = .slot e ∨ e.heightPath <+: z.path) :
    ∀ a ∈ ownedBy (graph F) z, ∃ a₀ ∈ posBlock (relKey (e.col.num 0) ((F.heightAt e).getD Tree.empty))
      (((F.entryAt e).map Prod.fst).getD 0), a = a₀.map (blockMap e) :=
  graph_owned_block_core he z hz

/-! ## L6.2c  Graph of a special step (moved below D7.1a, unchanged: its proof uses the block
lemmas of D7.1a; nothing in between uses it) -/

/-- L6.2c: the roles of the special owner entry `e` that are copied: its slot and its height
without the stopping column (txt:107-109). -/
def specialRoles (H : Forest) (sd : Scan.StopData) (e : EntryAddr) : List Role :=
  (H.roles.dropWhile (· != .slot e)).takeWhile (· != .ord sd.col)

/-- L6.2c: the `x`-th copy (`x < n + ε`) of the special owner entry `e`, at index `e.idx + x`. -/
def specialCopy (e : EntryAddr) (x : Nat) : Role → Role :=
  transColumn e.col e.col (fun i => if i = e.idx then e.idx + x else i)

/-- L6.2e helper: a column list obtained by replacing (or deleting) the last entry of the last
column keeps the labels of the other entries. -/
theorem labelSub_lastEntry {A : List (List (Nat × Forest))} {B : List (Nat × Forest)} {p : Nat}
    {h h' : Forest} (hsub : Tree.LabelSub h' h) :
    Tree.LabelSub (Tree.node (A ++ [B ++ [(p, h')]])) (Tree.node (A ++ [B ++ [(p, h)]])) := by
  apply Tree.labelSub_node
  intro a b y hy
  rw [Option.bind_eq_some_iff] at hy
  obtain ⟨col', hcol', hy⟩ := hy
  rw [List.getElem?_append] at hcol'
  split_ifs at hcol' with ha
  · exact ⟨y, by rw [List.getElem?_append_left ha, hcol']; exact hy, rfl, Tree.LabelSub.refl _⟩
  · rw [List.getElem?_singleton] at hcol'
    split_ifs at hcol' with ha'
    cases hcol'
    have hidx : a = A.length := by omega
    subst hidx
    rw [List.getElem?_append] at hy
    split_ifs at hy with hb
    · exact ⟨y, by simp [List.getElem?_append_left hb, hy], rfl, Tree.LabelSub.refl _⟩
    · rw [List.getElem?_singleton] at hy
      split_ifs at hy with hb'
      cases hy
      have : b = B.length := by omega
      subst this
      exact ⟨(p, h), by simp, rfl, hsub⟩

theorem labelSub_dropLast (cols : List (List (Nat × Forest))) :
    Tree.LabelSub (Tree.node cols.dropLast) (Tree.node cols) := by
  apply Tree.labelSub_node
  intro a b y hy
  rw [Option.bind_eq_some_iff] at hy
  obtain ⟨col', hcol', hy⟩ := hy
  rw [List.dropLast_eq_take] at hcol'
  exact ⟨y, by rw [Tree.getElem?_take_bind hcol']; exact hy, rfl, Tree.LabelSub.refl _⟩

/-- L6.2e helper: the unshifted deletion of the route column at depth `ℓ` keeps labels. -/
theorem labelSub_replaceAt_empty :
    ∀ (ℓ : Nat) (F : Forest), Tree.LabelSub (replaceAt 0 0 Tree.empty ℓ F) F := by
  intro ℓ
  induction ℓ with
  | zero =>
    rintro ⟨cols⟩
    cases cols with
    | nil => exact Tree.LabelSub.refl _
    | cons x xs =>
      have : replaceAt 0 0 Tree.empty 0 (Tree.node (x :: xs)) = Tree.node (x :: xs).dropLast := by
        simp only [replaceAt, Scan.shiftVal_zero_fun, Scan.treeMapCol_id_fun, List.map_id]
        simp [Tree.empty, Tree.cols]
      rw [this]
      exact labelSub_dropLast _
  | succ k ih =>
    rintro ⟨cols⟩
    cases hl : cols.getLast? with
    | none =>
      rw [List.getLast?_eq_none_iff] at hl
      subst hl
      simp only [replaceAt, mapLast]
      exact Tree.LabelSub.refl _
    | some col =>
      obtain ⟨A, rfl⟩ : ∃ A, cols = A ++ [col] := ⟨_, (List.dropLast_append_getLast? col hl).symm⟩
      cases hl' : col.getLast? with
      | none =>
        rw [List.getLast?_eq_none_iff] at hl'
        subst hl'
        simp only [replaceAt, Scan.mapLast_eq, List.dropLast_concat, List.getLast?_concat,
          Option.map_some, Option.toList_some, Scan.shiftVal_zero_fun, Scan.treeMapCol_id_fun,
          List.map_id]
        exact Tree.LabelSub.refl _
      | some x =>
        obtain ⟨B, rfl⟩ : ∃ B, col = B ++ [x] := ⟨_, (List.dropLast_append_getLast? x hl').symm⟩
        obtain ⟨p, h⟩ := x
        simp only [replaceAt, Scan.mapLast_eq, List.dropLast_concat, List.getLast?_concat,
          Option.map_some, Option.toList_some, Scan.shiftVal_zero_fun, Scan.treeMapCol_id_fun,
          List.map_id, Scan.treeMap_id, id_eq]
        have : (B.map fun x : Nat × Forest => (x.1, x.2)) = B := by
          conv_rhs => rw [← List.map_id B]
          rfl
        rw [this]
        exact labelSub_lastEntry (ih h)

/-- L6.2c helper: replacing the route column at depth `ℓ` by a column `c₁` keeps the labels of
the entries that survive replacing it by a column `c₂` extending `c₁`. -/
theorem labelSub_replaceAt_col {c₁ c₂ : Column} (hc : c₁ <+: c₂) :
    ∀ (ℓ : Nat) (F : Forest), Tree.LabelSub (replaceAt 0 0 (Tree.node [c₁]) ℓ F)
      (replaceAt 0 0 (Tree.node [c₂]) ℓ F) := by
  intro ℓ
  induction ℓ with
  | zero =>
    rintro ⟨cols⟩
    cases cols with
    | nil => exact Tree.LabelSub.refl _
    | cons x xs =>
      simp only [replaceAt, Scan.shiftVal_zero_fun, Scan.treeMapCol_id_fun, List.map_id, Tree.cols]
      apply Tree.labelSub_node
      intro a b y hy
      refine ⟨y, ?_, rfl, Tree.LabelSub.refl _⟩
      rw [Option.bind_eq_some_iff] at hy ⊢
      obtain ⟨col, hcol, hy⟩ := hy
      rw [List.getElem?_append] at hcol ⊢
      split_ifs at hcol ⊢ with ha
      · exact ⟨col, hcol, hy⟩
      · rw [List.getElem?_singleton] at hcol ⊢
        split_ifs at hcol ⊢ with ha'
        cases hcol
        refine ⟨c₂, rfl, ?_⟩
        obtain ⟨t, rfl⟩ := hc
        rw [List.getElem?_append_left (List.getElem?_eq_some_iff.1 hy).1]; exact hy
  | succ k ih =>
    rintro ⟨cols⟩
    cases hl : cols.getLast? with
    | none =>
      rw [List.getLast?_eq_none_iff] at hl
      subst hl
      simp only [replaceAt, mapLast]
      exact Tree.LabelSub.refl _
    | some col =>
      obtain ⟨A, rfl⟩ : ∃ A, cols = A ++ [col] := ⟨_, (List.dropLast_append_getLast? col hl).symm⟩
      cases hl' : col.getLast? with
      | none =>
        rw [List.getLast?_eq_none_iff] at hl'
        subst hl'
        simp only [replaceAt, Scan.mapLast_eq, List.dropLast_concat, List.getLast?_concat,
          Option.map_some, Option.toList_some, Scan.shiftVal_zero_fun, Scan.treeMapCol_id_fun,
          List.map_id]
        exact Tree.LabelSub.refl _
      | some x =>
        obtain ⟨B, rfl⟩ : ∃ B, col = B ++ [x] := ⟨_, (List.dropLast_append_getLast? x hl').symm⟩
        obtain ⟨p, h⟩ := x
        simp only [replaceAt, Scan.mapLast_eq, List.dropLast_concat, List.getLast?_concat,
          Option.map_some, Option.toList_some, Scan.shiftVal_zero_fun, Scan.treeMapCol_id_fun,
          List.map_id, Scan.treeMap_id, id_eq]
        exact labelSub_lastEntry (ih h)

/-- L6.2c helper: the route columns of `routeColsAux` at depth `d` have paths of length `|σ| + d`,
extending `σ`. -/
theorem routeColsAux_path : ∀ (fuel : Nat) (F : Forest) (σ : List (Nat × Nat)) (d : Nat)
    (c : ColAddr), (Scan.routeColsAux fuel F σ)[d]? = some c → ∃ τ, c.path = σ ++ τ ∧ τ.length = d
  | 0, _, _, _, _, h => by simp [Scan.routeColsAux] at h
  | fuel + 1, ⟨cols⟩, σ, d, c, h => by
    simp only [Scan.routeColsAux, Tree.cols] at h
    cases hl : cols.getLast? with
    | none => rw [hl] at h; simp at h
    | some col =>
      rw [hl] at h
      cases d with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq] at h
        exact ⟨[], by rw [← h]; simp, rfl⟩
      | succ d =>
        simp only [List.getElem?_cons_succ] at h
        cases hl' : col.getLast? with
        | none => rw [hl'] at h; simp at h
        | some ph =>
          obtain ⟨p, hh⟩ := ph
          rw [hl'] at h
          simp only at h
          obtain ⟨τ, hτ, hlen⟩ := routeColsAux_path fuel hh _ d c h
          exact ⟨(cols.length - 1, col.length - 1) :: τ, by rw [hτ]; simp, by simp [hlen]⟩

/-- L6.2c helper: replacing the route column by itself is the identity. -/
theorem replaceAt_self : ∀ (ℓ fuel : Nat) (F : Forest) (σ π : List (Nat × Nat)) (c : Nat)
    (col : Column), (Scan.routeColsAux fuel F σ)[ℓ]? = some ⟨σ ++ π, c⟩ →
    F.colAt ⟨π, c⟩ = some col → replaceAt 0 0 (Tree.node [col]) ℓ F = F := by
  intro ℓ
  induction ℓ with
  | zero =>
    rintro (_ | fuel) ⟨cols⟩ σ π c col h hcol
    · simp [Scan.routeColsAux] at h
    · simp only [Scan.routeColsAux, Tree.cols] at h
      cases hl : cols.getLast? with
      | none => rw [hl] at h; simp at h
      | some col' =>
        rw [hl] at h
        simp only [List.getElem?_cons_zero, Option.some.injEq, ColAddr.mk.injEq] at h
        obtain ⟨h1, rfl⟩ := h
        have hπ : π = [] := by simpa using h1
        subst hπ
        obtain ⟨A, rfl⟩ : ∃ A, cols = A ++ [col'] := ⟨_, (List.dropLast_append_getLast? col' hl).symm⟩
        have : col = col' := by
          simp [Tree.colAt, Tree.forestAt, Tree.cols] at hcol
          exact hcol.symm
        subst this
        obtain ⟨y, ys, hys⟩ := List.exists_cons_of_ne_nil (show A ++ [col] ≠ [] by simp)
        rw [hys]
        simp only [replaceAt]
        rw [← hys, List.dropLast_concat, Scan.shiftVal_zero_fun, Scan.treeMapCol_id_fun, List.map_id]
        rfl
  | succ k ih =>
    rintro (_ | fuel) ⟨cols⟩ σ π c col h hcol
    · simp [Scan.routeColsAux] at h
    · simp only [Scan.routeColsAux, Tree.cols] at h
      cases hl : cols.getLast? with
      | none => rw [hl] at h; simp at h
      | some col' =>
        rw [hl] at h
        simp only [List.getElem?_cons_succ] at h
        cases hl' : col'.getLast? with
        | none => rw [hl'] at h; simp at h
        | some ph =>
          obtain ⟨p, hh⟩ := ph
          rw [hl'] at h
          simp only at h
          obtain ⟨A, rfl⟩ : ∃ A, cols = A ++ [col'] := ⟨_, (List.dropLast_append_getLast? col' hl).symm⟩
          obtain ⟨B, rfl⟩ : ∃ B, col' = B ++ [(p, hh)] :=
            ⟨_, (List.dropLast_append_getLast? _ hl').symm⟩
          simp only [List.length_append, List.length_singleton, Nat.add_sub_cancel] at h
          obtain ⟨τ, hτ, -⟩ := routeColsAux_path fuel hh _ k _ h
          simp only [List.append_assoc, List.singleton_append] at hτ
          have hπ : π = (A.length, B.length) :: τ := List.append_cancel_left hτ
          subst hπ
          have hcol' : hh.colAt ⟨τ, c⟩ = some col := by
            rw [Tree.colAt_cons] at hcol
            simpa [Tree.cols] using hcol
          have IH := ih fuel hh (σ ++ [(A.length, B.length)]) τ c col (by simpa using h) hcol'
          simp only [replaceAt, Scan.mapLast_eq, List.dropLast_concat, List.getLast?_concat,
            Option.map_some, Option.toList_some, Scan.shiftVal_zero_fun, Scan.treeMapCol_id_fun,
            List.map_id, Scan.treeMap_id, id_eq, IH]
          have : (B.map fun x : Nat × Forest => (x.1, x.2)) = B := by
            conv_rhs => rw [← List.map_id B]
            rfl
          rw [this]

/-- L6.2c helper: after replacing the route column by a single column `z`, the column at the
route address is `z`. -/
theorem colAt_replaceAt : ∀ (ℓ fuel : Nat) (F : Forest) (σ π : List (Nat × Nat)) (c : Nat)
    (z : Column), (Scan.routeColsAux fuel F σ)[ℓ]? = some ⟨σ ++ π, c⟩ →
    (replaceAt 0 0 (Tree.node [z]) ℓ F).colAt ⟨π, c⟩ = some z := by
  intro ℓ
  induction ℓ with
  | zero =>
    rintro (_ | fuel) ⟨cols⟩ σ π c z h
    · simp [Scan.routeColsAux] at h
    · simp only [Scan.routeColsAux, Tree.cols] at h
      cases hl : cols.getLast? with
      | none => rw [hl] at h; simp at h
      | some col' =>
        rw [hl] at h
        simp only [List.getElem?_cons_zero, Option.some.injEq, ColAddr.mk.injEq] at h
        obtain ⟨h1, rfl⟩ := h
        have hπ : π = [] := by simpa using h1
        subst hπ
        obtain ⟨A, rfl⟩ : ∃ A, cols = A ++ [col'] := ⟨_, (List.dropLast_append_getLast? col' hl).symm⟩
        obtain ⟨y, ys, hys⟩ := List.exists_cons_of_ne_nil (show A ++ [col'] ≠ [] by simp)
        rw [hys]
        simp only [replaceAt]
        rw [← hys, List.dropLast_concat]
        simp [Tree.colAt, Tree.forestAt, Tree.cols]
  | succ k ih =>
    rintro (_ | fuel) ⟨cols⟩ σ π c z h
    · simp [Scan.routeColsAux] at h
    · simp only [Scan.routeColsAux, Tree.cols] at h
      cases hl : cols.getLast? with
      | none => rw [hl] at h; simp at h
      | some col' =>
        rw [hl] at h
        simp only [List.getElem?_cons_succ] at h
        cases hl' : col'.getLast? with
        | none => rw [hl'] at h; simp at h
        | some ph =>
          obtain ⟨p, hh⟩ := ph
          rw [hl'] at h
          simp only at h
          obtain ⟨A, rfl⟩ : ∃ A, cols = A ++ [col'] := ⟨_, (List.dropLast_append_getLast? col' hl).symm⟩
          obtain ⟨B, rfl⟩ : ∃ B, col' = B ++ [(p, hh)] :=
            ⟨_, (List.dropLast_append_getLast? _ hl').symm⟩
          simp only [List.length_append, List.length_singleton, Nat.add_sub_cancel] at h
          obtain ⟨τ, hτ, -⟩ := routeColsAux_path fuel hh _ k _ h
          simp only [List.append_assoc, List.singleton_append] at hτ
          have hπ : π = (A.length, B.length) :: τ := List.append_cancel_left hτ
          subst hπ
          have IH := ih fuel hh (σ ++ [(A.length, B.length)]) τ c z (by simpa using h)
          simp only [replaceAt, Scan.mapLast_eq, List.dropLast_concat, List.getLast?_concat,
            Option.map_some, Option.toList_some]
          rw [Tree.colAt_cons]
          simp [Tree.cols, IH]

/-- L6.2c helper: consecutive route columns: the next one lies in the last entry of the previous. -/
theorem routeColsAux_succ : ∀ (fuel : Nat) (F : Forest) (σ : List (Nat × Nat)) (d : Nat)
    (c c' : ColAddr), (Scan.routeColsAux fuel F σ)[d]? = some c →
    (Scan.routeColsAux fuel F σ)[d + 1]? = some c' → ∃ i, c'.path = c.path ++ [(c.col, i)]
  | 0, _, _, _, _, _, h, _ => by simp [Scan.routeColsAux] at h
  | fuel + 1, ⟨cols⟩, σ, d, c, c', h, h' => by
    simp only [Scan.routeColsAux, Tree.cols] at h h'
    cases hl : cols.getLast? with
    | none => rw [hl] at h; simp at h
    | some col =>
      rw [hl] at h h'
      simp only at h h'
      cases hl' : col.getLast? with
      | none =>
        rw [hl'] at h'
        cases d <;> simp at h'
      | some ph =>
        obtain ⟨p, hh⟩ := ph
        rw [hl'] at h h'
        simp only at h h'
        cases d with
        | zero =>
          simp only [List.getElem?_cons_zero, Option.some.injEq] at h
          simp only [List.getElem?_cons_succ] at h'
          subst h
          obtain ⟨τ, hτ, hlen⟩ := routeColsAux_path fuel hh _ 0 c' h'
          simp only [List.length_eq_zero_iff] at hlen
          subst hlen
          exact ⟨col.length - 1, by simp [hτ]⟩
        | succ d =>
          simp only [List.getElem?_cons_succ] at h h'
          exact routeColsAux_succ fuel hh _ d c c' h h'

/-- L6.2c helper: the special owner column is the route column one level above the stop. -/
theorem route_ownerCol {H : Forest} {sd : Scan.StopData} {e : EntryAddr}
    (hk : Scan.stepKind H = some .special) (hsd : Scan.stopData H = some sd)
    (he : sd.ownerEntry = some e) :
    1 ≤ sd.depth ∧ (Scan.routeCols H)[sd.depth - 1]? = some e.col := by
  obtain ⟨-, hhp, -⟩ := Scan.ownerEntry_spec hk hsd he
  obtain ⟨-, hdepth, -, -, hlast, hlen⟩ := Scan.stopData_spec hsd
  have hd : 1 ≤ sd.depth := by
    rw [hdepth, ← hhp]; simp [EntryAddr.heightPath]
  refine ⟨hd, ?_⟩
  have hT : (Scan.routeCols H)[sd.depth]? = some sd.col := by
    rw [List.getLast?_eq_getElem?, hlen] at hlast; simpa using hlast
  obtain ⟨c₀, hc₀⟩ : ∃ c₀, (Scan.routeCols H)[sd.depth - 1]? = some c₀ :=
    ⟨_, List.getElem?_eq_getElem (by omega)⟩
  obtain ⟨i, hi⟩ := routeColsAux_succ _ H [] (sd.depth - 1) c₀ sd.col hc₀
    (by rw [show sd.depth - 1 + 1 = sd.depth by omega]; exact hT)
  rw [← hhp] at hi
  simp only [EntryAddr.heightPath] at hi
  have h1 := List.append_inj' hi rfl
  simp only [List.cons.injEq, Prod.mk.injEq, and_true] at h1
  rw [hc₀]
  congr 1
  exact colAddr_eq h1.1.symm h1.2.1.symm

theorem rolesCol_replicate (π : List (Nat × Nat)) (c : Nat) (x : Nat × Forest) :
    ∀ (N i : Nat), Tree.rolesCol π c i (List.replicate N x) =
      (List.range N).flatMap (fun k => Role.slot ⟨⟨π, c⟩, i + k⟩ :: Tree.rolesF (π ++ [(c, i + k)]) x.2)
  | 0, i => by simp [Tree.rolesCol]
  | N + 1, i => by
    obtain ⟨p, h⟩ := x
    rw [List.replicate_succ, Tree.rolesCol, rolesCol_replicate π c (p, h) N (i + 1),
      List.range_succ_eq_map, List.flatMap_cons, List.flatMap_map]
    simp only [Nat.add_zero, List.cons_append]
    congr 2
    apply List.flatMap_congr
    intro k _
    rw [show i + 1 + k = i + (k + 1) by omega]

/-- L6.2c helper: the structure of the output of a special step. -/
theorem special_struct {H H' : Forest} {n : Nat} {sd : Scan.StopData} {e : EntryAddr}
    (hH : H ≠ Tree.empty) (hV : Scan.CondV H) (hI : Scan.CondI H)
    (hk : Scan.stepKind H = some .special) (hsd : Scan.stopData H = some sd)
    (he : sd.ownerEntry = some e) (hexp : expand H n = some H') :
    ∃ (p : Nat) (Fl : Forest), H.entryAt e = some (p, Fl) ∧
      H'.roles = prefixRoles H e ++ (List.range (n + if e.idx = 0 then 1 else 0)).flatMap
        (fun x => Role.slot ⟨e.col, e.idx + x⟩ ::
          (Tree.node Fl.cols.dropLast).roles.map (Role.under (⟨e.col, e.idx + x⟩ : EntryAddr).heightPath)) ∧
      (∀ x, x < n + (if e.idx = 0 then 1 else 0) →
        H'.entryAt ⟨e.col, e.idx + x⟩ = some (p, Tree.node Fl.cols.dropLast)) ∧
      ∃ G : Forest, G.roles = prefixRoles H e ∧ Tree.LabelSub G H ∧ Tree.LabelSub G H' := by
  obtain ⟨-, -, -, col, p, Fl, hcol, hlast, hidx, -⟩ := Scan.ownerEntry_spec hk hsd he
  have hpo := Scan.paperOp_special hk hsd he hcol hlast n
  rw [← Scan.expand_eq_paperOp hH hV hI, hexp] at hpo
  have hdl : col.dropLast.length = e.idx := by rw [List.length_dropLast]; omega
  have heps : (if col.dropLast.isEmpty then 1 else 0) = (if e.idx = 0 then 1 else 0) := by
    by_cases h0 : e.idx = 0
    · rw [if_pos h0, if_pos]; rw [List.isEmpty_iff, ← List.length_eq_zero_iff, hdl, h0]
    · rw [if_neg h0, if_neg]; rw [List.isEmpty_iff, ← List.length_eq_zero_iff, hdl]; exact h0
  rw [heps] at hpo
  set N := n + (if e.idx = 0 then 1 else 0) with hN
  set C : Forest := Tree.node Fl.cols.dropLast with hC
  set newcol : Column := col.dropLast ++ List.replicate N (p, C) with hnew
  cases hpo
  obtain ⟨-, hroute⟩ := route_ownerCol hk hsd he
  have hroute' : (Scan.routeCols H)[sd.depth - 1]? = some ⟨e.col.path, e.col.col⟩ := hroute
  have hcolsplit : col = col.dropLast ++ [(p, Fl)] := (List.dropLast_append_getLast? _ hlast).symm
  have hentry : H.entryAt e = some (p, Fl) := by
    unfold Tree.entryAt
    rw [hcol, Option.bind_some, List.getLast?_eq_getElem?] at *
    rw [show e.idx = col.length - 1 by omega]
    exact hlast
  -- the reading order of `H` around column `e.col`
  obtain ⟨A, B, hAB⟩ := roles_col_decomp hcol
  have hcolroles : Tree.rolesCol e.col.path e.col.col 0 col =
      Tree.rolesCol e.col.path e.col.col 0 col.dropLast ++ Role.slot e ::
        (Tree.rolesF (e.col.path ++ [(e.col.col, e.idx)]) Fl) := by
    conv_lhs => rw [hcolsplit]
    rw [Tree.rolesCol_append, hdl, Nat.zero_add]
    simp [Tree.rolesCol]
  have hnd := Tree.roles_nodup H
  rw [hAB] at hnd
  have hA : rolesBefore H (.ord e.col) = A := by
    unfold rolesBefore; rw [hAB]; exact takeWhile_ne_of_decomp hnd
  have hpre : prefixRoles H e = A ++ Role.ord e.col :: Tree.rolesCol e.col.path e.col.col 0 col.dropLast := by
    unfold prefixRoles rolesBefore
    rw [hAB, hcolroles]
    rw [hcolroles] at hnd
    have hnd' : ((A ++ Role.ord e.col :: Tree.rolesCol e.col.path e.col.col 0 col.dropLast) ++
        Role.slot e :: (Tree.rolesF (e.col.path ++ [(e.col.col, e.idx)]) Fl ++ B)).Nodup := by
      simpa using hnd
    rw [show A ++ Role.ord e.col :: (Tree.rolesCol e.col.path e.col.col 0 col.dropLast ++ Role.slot e ::
        Tree.rolesF (e.col.path ++ [(e.col.col, e.idx)]) Fl ++ B) =
      (A ++ Role.ord e.col :: Tree.rolesCol e.col.path e.col.col 0 col.dropLast) ++
        Role.slot e :: (Tree.rolesF (e.col.path ++ [(e.col.col, e.idx)]) Fl ++ B) by simp]
    exact takeWhile_ne_of_decomp hnd'
  -- roles of a single-column replacement
  have hZroles : ∀ z : Column, (replaceAt 0 0 (Tree.node [z]) (sd.depth - 1) H).roles =
      A ++ Role.ord e.col :: Tree.rolesCol e.col.path e.col.col 0 z := by
    intro z
    rw [roles_replaceAt 0 0 (sd.depth - 1) _ H hroute', hA]
    congr 1
    have := rolesCols_place e.col.path e.col.col 0 [z]
    rw [Nat.zero_add] at this
    rw [show (Tree.node [z]).roles = Tree.rolesCols [] 0 [z] from rfl, ← this]
    simp [Tree.rolesCols]
  refine ⟨p, Fl, hentry, ?_, ?_, ?_⟩
  · rw [show Scan.Hole.fill ⟨H, sd.depth - 1⟩ 0 0 (Tree.node [newcol]) =
      replaceAt 0 0 (Tree.node [newcol]) (sd.depth - 1) H from rfl, hZroles, hpre, hnew,
      Tree.rolesCol_append, hdl, Nat.zero_add, rolesCol_replicate]
    simp only [List.append_assoc, List.cons_append]
    congr 3
    apply List.flatMap_congr
    intro k _
    congr 1
    rw [Tree.rolesF_eq_map_under]
    rfl
  · intro x hx
    have hc := colAt_replaceAt (sd.depth - 1) _ H [] e.col.path e.col.col newcol hroute'
    show (replaceAt 0 0 (Tree.node [newcol]) (sd.depth - 1) H).entryAt ⟨e.col, e.idx + x⟩ = _
    unfold Tree.entryAt
    rw [show (⟨e.col, e.idx + x⟩ : EntryAddr).col = ⟨e.col.path, e.col.col⟩ from rfl, hc, Option.bind_some]
    show newcol[e.idx + x]? = _
    rw [hnew, List.getElem?_append_right (by omega), hdl, Nat.add_sub_cancel_left,
      List.getElem?_replicate, if_pos hx]
  · refine ⟨replaceAt 0 0 (Tree.node [col.dropLast]) (sd.depth - 1) H, ?_, ?_, ?_⟩
    · rw [hZroles, hpre]
    · have h1 := labelSub_replaceAt_col (List.dropLast_prefix col) (sd.depth - 1) H
      rwa [replaceAt_self (sd.depth - 1) _ H [] e.col.path e.col.col col hroute' hcol] at h1
    · exact labelSub_replaceAt_col (List.prefix_append _ _) (sd.depth - 1) H

/-- L6.2f helper: an atom of `Γ(H')` owned by a role of a common prefix `S` of `H'` and `H` whose
labels agree (through a forest `G` with roles `S`) is an atom of `Γ(H)` reading only `S`. -/
theorem owned_common_prefix {H H' G : Forest} (hGH : Tree.LabelSub G H) (hGH' : Tree.LabelSub G H')
    (hS : G.roles <+: H.roles) (hS' : G.roles <+: H'.roles) {z : Role} (hz : z ∈ G.roles)
    {a : BaseAtom Role} (ha : a ∈ ownedBy (graph H') z) :
    a ∈ graph H ∧ ∀ v ∈ a.vars, v ∈ G.roles := by
  have hvars : ∀ v ∈ a.vars, v ∈ G.roles := by
    intro v hv
    rcases owned_before ha hv with h | rfl
    · exact rolesBefore_sub_prefix hS' hz h
    · exact hz
  have hlab : ∀ e', Role.slot e' ∈ G.roles →
      (H'.entryAt e').map Prod.fst = (H.entryAt e').map Prod.fst := by
    intro e' he'
    rw [Tree.mem_roles_iff] at he'
    obtain ⟨y, hy⟩ := Option.isSome_iff_exists.1 he'
    obtain ⟨h₁, hh₁⟩ := hGH e' y hy
    obtain ⟨h₂, hh₂⟩ := hGH' e' y hy
    rw [hh₁, hh₂]; rfl
  have ha' : a ∈ graph H' := by
    unfold ownedBy at ha; exact (List.mem_filter.1 ha).1
  have := restrict_graph_of_common hS' hS hlab a (by
    unfold restrictTo; rw [List.mem_filter]; exact ⟨ha', by simpa using hvars⟩)
  unfold restrictTo at this
  exact ⟨(List.mem_filter.1 this).1, hvars⟩

theorem atomOwner_map {V W : Type} (f : V → W) (a : BaseAtom V) :
    atomOwner (a.map f) = (atomOwner a).map f := by
  cases a <;> rfl

theorem baseAtom_map_map {U V W : Type} (f : U → V) (g : V → W) (a : BaseAtom U) :
    (a.map f).map g = a.map (g ∘ f) := by
  cases a <;> rfl

/-- L6.2c helper: the copy map moves entry `e` to index `e.idx + x` and fixes the stack of `e.col`. -/
theorem specialCopy_slot (e : EntryAddr) (x : Nat) :
    specialCopy e x (.slot e) = .slot ⟨e.col, e.idx + x⟩ := by
  simp [specialCopy, transColumn]

theorem specialCopy_under (e : EntryAddr) (x : Nat) (r : Role) :
    specialCopy e x (r.under e.heightPath) = r.under (⟨e.col, e.idx + x⟩ : EntryAddr).heightPath := by
  have hpre : e.col.path.isPrefixOf (e.col.path ++ (e.col.col, e.idx) :: r.path) = true := by
    rw [List.isPrefixOf_iff_prefix]; exact List.prefix_append _ _
  cases r with
  | ord c =>
    have hne : (⟨e.col.path ++ [(e.col.col, e.idx)] ++ c.path, c.col⟩ : ColAddr) ≠ e.col := by
      intro h
      have := congrArg (fun d : ColAddr => d.path.length) h
      simp at this
    simp only [specialCopy, transColumn, Role.under, EntryAddr.heightPath, relocCol, if_neg hne]
    rw [if_pos (by rw [List.isPrefixOf_iff_prefix]; simp)]
    simp
  | slot e' =>
    have hne : (⟨e.col.path ++ [(e.col.col, e.idx)] ++ e'.col.path, e'.col.col⟩ : ColAddr) ≠ e.col := by
      intro h
      have := congrArg (fun d : ColAddr => d.path.length) h
      simp at this
    simp only [specialCopy, transColumn, Role.under, EntryAddr.heightPath, if_neg hne, relocCol]
    rw [if_pos (by rw [List.isPrefixOf_iff_prefix]; simp)]
    simp

theorem specialCopy_stack (e : EntryAddr) (x : Nat) {o : ColAddr} (ho : e.col.OnStack o) :
    specialCopy e x (.ord o) = .ord o ∧
      ∀ i, specialCopy e x (.slot ⟨o, i⟩) = .slot ⟨o, i⟩ := by
  have hne : o ≠ e.col := by
    intro h; subst h
    have := ColAddr.num_lt_of_onStack 0 ho; omega
  have hrel : relocCol e.col e.col (fun i => if i = e.idx then e.idx + x else i) o = o := by
    unfold relocCol
    rw [if_neg hne]
    split_ifs with hp
    · have hp' : e.col.path <+: o.path := List.isPrefixOf_iff_prefix.1 hp
      have hp'' := onStack_path_prefix ho
      have heq : o.path = e.col.path := List.IsPrefix.eq_of_length hp'' (Nat.le_antisymm
        hp''.length_le hp'.length_le) |>.symm ▸ rfl
      rw [show o.path.drop e.col.path.length = [] by
        rw [List.drop_eq_nil_iff]; exact hp''.length_le]
    · rfl
  refine ⟨by simp [specialCopy, transColumn, hrel], fun i => ?_⟩
  simp [specialCopy, transColumn, hne, hrel]

/-- L6.2c helper: the copy map turns the block map of `e` into that of the copy. -/
theorem specialCopy_blockMap (e : EntryAddr) (x : Nat) (w : BlkVar) :
    specialCopy e x (blockMap e w) = blockMap ⟨e.col, e.idx + x⟩ w := by
  have hrep : ∀ q ov, e.col.rep 0 q = some ov →
      specialCopy e x ov.1 = ov.1 ∧ specialCopy e x ov.2 = ov.2 := by
    intro q ov h
    unfold ColAddr.rep at h
    obtain ⟨o', ho', rfl⟩ := Option.map_eq_some_iff.1 h
    have hs := ((ColAddr.resolve_spec 0 _ _ _).1 ho').1
    obtain ⟨h1, h2⟩ := specialCopy_stack e x hs
    refine ⟨h1, ?_⟩
    split
    · rename_i e'' he''
      obtain ⟨hc, -⟩ := (ColAddr.container_spec _ _ _).1 he''
      obtain ⟨c'', i''⟩ := e''
      simp only at hc
      subst hc
      exact h2 i''
    · exact h1
  have hcol : specialCopy e x (.ord e.col) = .ord e.col := by
    simp [specialCopy, transColumn, relocCol]
  cases w with
  | host => exact hcol
  | ord q =>
    simp only [blockMap]
    cases h : e.col.rep 0 q with
    | none => exact hcol
    | some ov => exact (hrep q ov h).1
  | cur q =>
    simp only [blockMap]
    cases h : e.col.rep 0 q with
    | none => exact hcol
    | some ov => exact (hrep q ov h).2
  | owner => exact specialCopy_slot e x
  | inner r => exact specialCopy_under e x r

/-- L6.2c helper: owners of block atoms are the owner or internal variables. -/
theorem posBlock_owner {K : Key} {sel : Nat} {a : BaseAtom BlkVar} (ha : a ∈ posBlock K sel)
    {w : BlkVar} (hw : atomOwner a = some w) : w = .owner ∨ ∃ r, w = .inner r := by
  unfold posBlock freeBlock at ha
  simp only [List.mem_append, List.mem_cons, List.mem_map, List.mem_filterMap, List.mem_flatMap,
    List.not_mem_nil, or_false] at ha
  rcases ha with (((((rfl | ⟨_, ⟨r, -, rfl⟩, rfl⟩) | ⟨_, -, rfl⟩) | ⟨c, -, hc⟩) | ⟨e', -, ha⟩) | rfl | rfl)
  · simp [atomOwner] at hw; exact Or.inl hw.symm
  · simp [atomOwner] at hw; exact Or.inr ⟨r, hw.symm⟩
  · simp [atomOwner] at hw
  · split_ifs at hc; cases hc; simp [atomOwner] at hw; exact Or.inr ⟨_, hw.symm⟩
  · split at ha
    · simp only [List.mem_cons, List.not_mem_nil, or_false] at ha
      rcases ha with rfl | rfl <;> (simp [atomOwner] at hw; exact Or.inr ⟨_, hw.symm⟩)
    · simp only [List.mem_cons, List.not_mem_nil, or_false] at ha
      rcases ha with rfl | rfl <;> (simp [atomOwner] at hw; exact Or.inr ⟨_, hw.symm⟩)
    · split at ha
      · simp only [List.mem_cons, List.not_mem_nil, or_false] at ha
        rcases ha with rfl | rfl <;> (simp [atomOwner] at hw; exact Or.inr ⟨_, hw.symm⟩)
      · simp at ha
    · simp at ha
  · simp [atomOwner] at hw; exact Or.inl hw.symm
  · simp [atomOwner] at hw; exact Or.inl hw.symm

/-- L6.2c helper: the index of a column address at the outermost level. -/
def headIdx (d : ColAddr) : Nat :=
  match d.path with
  | [] => d.col
  | (a, _) :: _ => a

theorem takeCols_colAt (B : Forest) (m : Nat) (d : ColAddr) :
    (takeCols B m).colAt d = if headIdx d < m then B.colAt d else none := by
  obtain ⟨cols⟩ := B
  obtain ⟨dp, dc⟩ := d
  cases dp with
  | nil =>
    show (cols.take m)[dc]? = if dc < m then cols[dc]? else none
    rw [List.getElem?_take]
  | cons ab rest =>
    obtain ⟨a, b⟩ := ab
    show _ = if a < m then _ else none
    rw [takeCols, Tree.colAt_cons, Tree.colAt_cons]
    simp only [Tree.cols, List.getElem?_take]
    by_cases ha : a < m
    · rw [if_pos ha, if_pos ha]
    · rw [if_neg ha, if_neg ha]; rfl

theorem takeCols_entryAt_eq (B : Forest) (m : Nat) (e' : EntryAddr) :
    (takeCols B m).entryAt e' = if headIdx e'.col < m then B.entryAt e' else none := by
  unfold Tree.entryAt
  rw [takeCols_colAt]
  split_ifs <;> simp

/-- L6.2c helper: a free-block atom of a height whose owner lies in the first `m` columns is a
free-block atom of the first `m` columns. -/
theorem freeBlock_restrict {B : Forest} {a m : Nat} {x : BaseAtom BlkVar}
    (hx : x ∈ freeBlock (relKey a B)) {w : BlkVar} (hw : atomOwner x = some w)
    (hw' : w = .owner ∨ ∃ r ∈ (takeCols B m).roles, w = .inner r) :
    x ∈ freeBlock (relKey a (takeCols B m)) := by
  have hKcol : ∀ X : Forest, ∀ d, ((relKey a X).colAt d).isSome = (X.colAt d).isSome := by
    intro X d; rw [relKey, Tree.colAt_map]; cases X.colAt d <;> rfl
  have hKent : ∀ e', (relKey a (takeCols B m)).entryAt e' =
      if headIdx e'.col < m then (relKey a B).entryAt e' else none := by
    intro e'
    rw [relKey, relKey, Tree.entryAt_map, Tree.entryAt_map, takeCols_entryAt_eq]
    split_ifs <;> rfl
  have hroles : ∀ r, r ∈ (takeCols B m).roles → r ∈ (relKey a (takeCols B m)).roles := by
    intro r hr; rwa [relKey_roles]
  unfold freeBlock at hx ⊢
  simp only [List.mem_cons, List.mem_append, List.mem_map, List.mem_filterMap,
    List.mem_flatMap] at hx ⊢
  rcases hx with ((((rfl | ⟨_, ⟨r, hr, rfl⟩, rfl⟩) | ⟨⟨y, z⟩, hyz, rfl⟩) | ⟨c, hc, hc'⟩) | ⟨e', he', hx⟩)
  · exact Or.inl (Or.inl (Or.inl (Or.inl rfl)))
  · simp only [atomOwner, Option.some.injEq] at hw
    subst hw
    rcases hw' with h | ⟨r', hr', h⟩
    · cases h
    · simp only [BlkVar.inner.injEq] at h
      subst h
      exact Or.inl (Or.inl (Or.inl (Or.inr ⟨_, ⟨r, hroles r hr', rfl⟩, rfl⟩)))
  · simp [atomOwner] at hw
  · split_ifs at hc' with h
    cases hc'
    simp only [atomOwner, Option.some.injEq] at hw
    subst hw
    rcases hw' with h' | ⟨r', hr', h'⟩
    · cases h'
    · cases h'
      rw [Tree.mem_roles_iff] at hr'
      change ((takeCols B m).colAt ⟨c.path, c.col + 1⟩).isSome at hr'
      rw [takeCols_colAt] at hr'
      split_ifs at hr' with hm
      · have hm' : headIdx c < m := by
          obtain ⟨cp, cc⟩ := c
          cases cp <;> simp [headIdx] at hm ⊢ <;> omega
        refine Or.inl (Or.inr ⟨c, ?_, ?_⟩)
        · rw [Tree.mem_colAddrs_iff, hKcol, takeCols_colAt, if_pos hm', ← hKcol]
          exact (Tree.mem_colAddrs_iff _ _).1 hc
        · rw [if_pos (by rw [hKcol, takeCols_colAt, if_pos hm]; exact hr')]
      · simp at hr'
  · -- every edge of an internal entry is owned by its slot
    have howner : ∀ y ∈ (match (relKey a B).entryAt e' with
        | some ((false, q), _) => [BaseAtom.edge (BlkVar.inner (.slot e')) (BlkVar.inner (.ord e'.col)) (.ord q),
            BaseAtom.edge (BlkVar.inner (.slot e')) (BlkVar.inner (.ord e'.col)) (.cur q)]
        | some ((true, 0), _) => [BaseAtom.edge (BlkVar.inner (.slot e')) (BlkVar.inner (.ord e'.col)) .host,
            BaseAtom.edge (BlkVar.inner (.slot e')) (BlkVar.inner (.ord e'.col)) .owner]
        | some ((true, v + 1), _) =>
          match e'.col.rep 1 (v + 1) with
          | some (o, w) => [BaseAtom.edge (BlkVar.inner (.slot e')) (BlkVar.inner (.ord e'.col)) (.inner o),
              BaseAtom.edge (BlkVar.inner (.slot e')) (BlkVar.inner (.ord e'.col)) (.inner w)]
          | none => []
        | none => [] : List (BaseAtom BlkVar)), atomOwner y = some (.inner (.slot e')) := by
      intro y hy
      split at hy
      · simp only [List.mem_cons, List.not_mem_nil, or_false] at hy
        rcases hy with rfl | rfl <;> rfl
      · simp only [List.mem_cons, List.not_mem_nil, or_false] at hy
        rcases hy with rfl | rfl <;> rfl
      · split at hy
        · simp only [List.mem_cons, List.not_mem_nil, or_false] at hy
          rcases hy with rfl | rfl <;> rfl
        · simp at hy
      · simp at hy
    have hxo := howner x hx
    rw [hw, Option.some.injEq] at hxo
    subst hxo
    rcases hw' with h' | ⟨r', hr', h'⟩
    · cases h'
    · cases h'
      rw [Tree.mem_roles_iff] at hr'
      change ((takeCols B m).entryAt e').isSome at hr'
      rw [takeCols_entryAt_eq] at hr'
      split_ifs at hr' with hm
      · refine Or.inr ⟨e', ?_, ?_⟩
        · rw [Tree.mem_entryAddrs_iff, hKent, if_pos hm]
          exact (Tree.mem_entryAddrs_iff _ _).1 he'
        · rw [hKent, if_pos hm]; exact hx
      · simp at hr'

-- provides: U3, L6.2c (special step)
theorem graph_special {H H' : Forest} {n : Nat} {sd : Scan.StopData} {e : EntryAddr}
    (hH : H ≠ Tree.empty) (hV : Scan.CondV H) (hI : Scan.CondI H)
    (hk : Scan.stepKind H = some .special) (hsd : Scan.stopData H = some sd)
    (he : sd.ownerEntry = some e) (hexp : expand H n = some H') :
    let ε := if e.idx = 0 then 1 else 0
    H'.roles = prefixRoles H e ++
      (List.range (n + ε)).flatMap (fun x => (specialRoles H sd e).map (specialCopy e x)) ∧
    (∀ z ∈ prefixRoles H e, ∀ a, a ∈ ownedBy (graph H') z ↔ a ∈ ownedBy (graph H) z) ∧
    (∀ x, x < n + ε → ∀ y ∈ specialRoles H sd e, ∀ a,
      a ∈ ownedBy (graph H') (specialCopy e x y) ↔
        ∃ a₀ ∈ ownedBy (graph H) y, a = a₀.map (specialCopy e x)) := by
  intro ε
  obtain ⟨p, Fl, hent, hroles, hcopies, G, hGr, hGH, hGH'⟩ := special_struct hH hV hI hk hsd he hexp
  obtain ⟨-, hhp, -, col, p', Fl', hcol, hlast, hidx, hFl⟩ := Scan.ownerEntry_spec hk hsd he
  have hFF : (p', Fl') = (p, Fl) := by
    have : H.entryAt e = some (p', Fl') := by
      unfold Tree.entryAt
      rw [hcol, Option.bind_some, show e.idx = col.length - 1 by omega, ← List.getLast?_eq_getElem?]
      exact hlast
    rw [hent] at this
    exact (Option.some.inj this).symm
  simp only [Prod.mk.injEq] at hFF
  obtain ⟨h1, h2⟩ := hFF
  subst p' Fl'
  obtain ⟨-, -, -, hmemT, -⟩ := Scan.stopData_spec hsd
  set C : Forest := Tree.node Fl.cols.dropLast with hC
  have hemem : e ∈ H.entryAddrs := by rw [Tree.mem_entryAddrs_iff, hent]; rfl
  have hheight : H.heightAt e = some Fl := by simp [Tree.heightAt, hent]
  -- the copied roles: `U_e` and the roles of the height without its last column
  have hspec : specialRoles H sd e = Role.slot e :: C.roles.map (Role.under e.heightPath) := by
    obtain ⟨post, hr, -⟩ := Tree.roles_entry hemem
    rw [hheight, Option.getD_some] at hr
    obtain ⟨-, F, hF, hFlen⟩ := (Scan.mem_routeCols_iff H sd.col).1 hmemT
    rw [← hhp, Tree.forestAt_heightPath, hheight, Option.some.injEq] at hF
    subst hF
    have hsplit : Fl.cols = Fl.cols.dropLast ++ [[(sd.r, Tree.empty)]] :=
      (List.dropLast_append_getLast? _ hFl).symm
    have hdl : Fl.cols.dropLast.length = sd.col.col := by rw [List.length_dropLast]; omega
    have hT : Role.ord sd.col = Role.ord ⟨e.heightPath, Fl.cols.dropLast.length⟩ := by
      rw [hdl, hhp]
    have hFr : Fl.roles.map (Role.under e.heightPath) = Tree.rolesCols e.heightPath 0 Fl.cols.dropLast ++
        Role.ord ⟨e.heightPath, Fl.cols.dropLast.length⟩ ::
          (Tree.rolesCol e.heightPath Fl.cols.dropLast.length 0 [(sd.r, Tree.empty)]) := by
      rw [← Tree.rolesF_eq_map_under]
      cases Fl with
      | node fc =>
        simp only [Tree.cols] at hsplit ⊢
        rw [Tree.rolesF]
        conv_lhs => rw [hsplit]
        rw [Tree.rolesCols_append, Nat.zero_add]
        simp [Tree.rolesCols]
    have hnd := Tree.roles_nodup H
    rw [hr, hFr] at hnd
    unfold specialRoles
    rw [hr, hFr, List.dropWhile_append_of_pos, List.dropWhile_cons_of_neg (by simp),
      List.takeWhile_cons_of_pos (by simp), hT]
    · congr 1
      rw [show Tree.rolesCols e.heightPath 0 Fl.cols.dropLast ++ (Role.ord ⟨e.heightPath,
          Fl.cols.dropLast.length⟩ :: Tree.rolesCol e.heightPath Fl.cols.dropLast.length 0
            [(sd.r, Tree.empty)]) ++ post = Tree.rolesCols e.heightPath 0 Fl.cols.dropLast ++
          Role.ord ⟨e.heightPath, Fl.cols.dropLast.length⟩ :: (Tree.rolesCol e.heightPath
            Fl.cols.dropLast.length 0 [(sd.r, Tree.empty)] ++ post) by simp]
      rw [takeWhile_ne_of_decomp]
      · rw [← Tree.rolesF_eq_map_under]; rfl
      · have := (List.nodup_cons.1 (List.nodup_append.1 hnd).2.1).2
        simpa using this
    · intro y hy
      simp only [bne_iff_ne, ne_eq]
      rintro rfl
      exact (List.nodup_append.1 hnd).2.2 _ hy _ (List.mem_cons_self ..) rfl
  have hcp_spec : ∀ x, (specialRoles H sd e).map (specialCopy e x) =
      Role.slot ⟨e.col, e.idx + x⟩ :: C.roles.map (Role.under (⟨e.col, e.idx + x⟩ : EntryAddr).heightPath) := by
    intro x
    rw [hspec, List.map_cons, List.map_map, specialCopy_slot]
    congr 1
    apply List.map_congr_left
    intro r _
    exact specialCopy_under e x r
  have hS' : G.roles <+: H'.roles := by rw [hGr, hroles]; exact List.prefix_append _ _
  have hS : G.roles <+: H.roles := by rw [hGr]; exact List.takeWhile_prefix _
  refine ⟨?_, ?_, ?_⟩
  · rw [hroles]
    congr 1
    apply List.flatMap_congr
    intro x _
    rw [hcp_spec]
  · intro z hz a
    rw [← hGr] at hz
    constructor
    · intro ha
      have hown := (List.mem_filter.1 ha).2
      exact List.mem_filter.2 ⟨(owned_common_prefix hGH hGH' hS hS' hz ha).1, hown⟩
    · intro ha
      have hown := (List.mem_filter.1 ha).2
      exact List.mem_filter.2 ⟨(owned_common_prefix hGH' hGH hS' hS hz ha).1, hown⟩
  · intro x hx y hy a
    set ex : EntryAddr := ⟨e.col, e.idx + x⟩ with hex
    have hentx : H'.entryAt ex = some (p, C) := hcopies x hx
    have hexm : ex ∈ H'.entryAddrs := by rw [Tree.mem_entryAddrs_iff, hentx]; rfl
    have hhx : H'.heightAt ex = some C := by simp [Tree.heightAt, hentx]
    rw [hspec] at hy
    have hyform : y = .slot e ∨ ∃ r ∈ C.roles, y = r.under e.heightPath := by
      rcases List.mem_cons.1 hy with h | h
      · exact Or.inl h
      · obtain ⟨r, hr, rfl⟩ := List.mem_map.1 h
        exact Or.inr ⟨r, hr, rfl⟩
    have hslot_ne : ∀ r : Role, Role.slot ex ≠ r.under ex.heightPath := by
      intro r h
      have := congrArg Role.path h
      rw [Role.path_under] at this
      have := congrArg List.length this
      simp [Role.path, EntryAddr.heightPath] at this
    have hslot_ne' : ∀ r : Role, Role.slot e ≠ r.under e.heightPath := by
      intro r h
      have := congrArg Role.path h
      rw [Role.path_under] at this
      have := congrArg List.length this
      simp [Role.path, EntryAddr.heightPath] at this
    have hcy : specialCopy e x y = .slot ex ∨ ex.heightPath <+: (specialCopy e x y).path := by
      rcases hyform with rfl | ⟨r, -, rfl⟩
      · left; exact specialCopy_slot e x
      · right; rw [specialCopy_under, Role.path_under]; exact List.prefix_append _ _
    have hy' : y = .slot e ∨ e.heightPath <+: y.path := by
      rcases hyform with rfl | ⟨r, -, rfl⟩
      · left; rfl
      · right; rw [Role.path_under]; exact List.prefix_append _ _
    have hmap : ∀ a₁ : BaseAtom BlkVar, a₁.map (blockMap ex) = (a₁.map (blockMap e)).map (specialCopy e x) := by
      intro a₁
      rw [baseAtom_map_map]
      congr 1
      funext w
      exact (specialCopy_blockMap e x w).symm
    -- injectivity of the copy on the copied region
    have hinj : ∀ w : BlkVar, (w = .owner ∨ ∃ r, w = .inner r) →
        specialCopy e x (blockMap e w) = specialCopy e x y → blockMap e w = y := by
      rintro w (rfl | ⟨r, rfl⟩) hw
      · simp only [blockMap, specialCopy_slot] at hw
        rcases hyform with rfl | ⟨r', -, rfl⟩
        · rfl
        · rw [specialCopy_under] at hw; exact absurd hw (hslot_ne r')
      · simp only [blockMap, specialCopy_under] at hw
        rcases hyform with rfl | ⟨r', -, rfl⟩
        · rw [specialCopy_slot] at hw; exact absurd hw.symm (hslot_ne r)
        · rw [specialCopy_under] at hw
          rw [Role.under_injective _ hw]
          rfl
    have hC' : takeCols Fl (Fl.cols.length - 1) = C := by
      simp [takeCols, hC, List.dropLast_eq_take]
    constructor
    · intro ha
      obtain ⟨a₁, ha₁, rfl⟩ := graph_owned_block_core hexm _ hcy a ha
      rw [hhx, hentx] at ha₁
      simp only [Option.getD_some, Option.map_some] at ha₁
      have hown := (List.mem_filter.1 ha).2
      rw [beq_iff_eq, atomOwner_map] at hown
      obtain ⟨w, hw, hwy⟩ := Option.map_eq_some_iff.1 hown
      refine ⟨a₁.map (blockMap e), ?_, hmap a₁⟩
      refine List.mem_filter.2 ⟨?_, ?_⟩
      · unfold posBlock at ha₁
        rcases List.mem_append.1 ha₁ with h | h
        · have := freeBlock_graph_core hemem (Fl.cols.length - 1) a₁
          rw [hheight, Option.getD_some, hC'] at this
          exact this h
        · have := posBlock_heads_graph hemem hV a₁
          rw [hheight, hent] at this
          exact this (List.mem_append_right _ h)
      · rw [beq_iff_eq, atomOwner_map, hw, Option.map_some]
        congr 1
        apply hinj w (posBlock_owner ha₁ hw)
        rw [specialCopy_blockMap]
        exact hwy
    · rintro ⟨a₀, ha₀, rfl⟩
      obtain ⟨a₁, ha₁, rfl⟩ := graph_owned_block_core hemem y hy' a₀ ha₀
      rw [hheight, hent] at ha₁
      simp only [Option.getD_some, Option.map_some] at ha₁
      have hown := (List.mem_filter.1 ha₀).2
      rw [beq_iff_eq, atomOwner_map] at hown
      obtain ⟨w, hw, hwy⟩ := Option.map_eq_some_iff.1 hown
      rw [← hmap]
      refine List.mem_filter.2 ⟨?_, ?_⟩
      · unfold posBlock at ha₁
        rcases List.mem_append.1 ha₁ with h | h
        · have hw' : w = .owner ∨ ∃ r ∈ (takeCols Fl (Fl.cols.length - 1)).roles, w = .inner r := by
            rcases posBlock_owner (List.mem_append_left _ h : a₁ ∈ posBlock _ p) hw with h1 | ⟨r, rfl⟩
            · exact Or.inl h1
            · right
              refine ⟨r, ?_, rfl⟩
              rw [hC']
              rcases hyform with rfl | ⟨r', hr', hry⟩
              · exact absurd hwy (hslot_ne' r).symm
              · simp only [blockMap] at hwy
                rw [Role.under_injective _ (hwy.trans hry)]
                exact hr'
          have h2 := freeBlock_restrict h hw hw'
          rw [hC'] at h2
          have := freeBlock_graph_core hexm C.cols.length a₁
          rw [hhx, Option.getD_some, takeCols_length] at this
          exact this h2
        · -- the two heads of the copy
          obtain ⟨⟨o, v⟩, hov⟩ := Option.isSome_iff_exists.1
            ((rep_isSome_iff e.col p).2 ((ColAddr.resolve_isSome_iff 0 e.col p).1
              (hV e hemem p Fl hent)).2)
          rw [mem_graph_iff]
          refine Or.inr (Or.inr (Or.inr ⟨ex, p, o, v, by rw [hentx]; rfl, hov, ?_⟩))
          simp only [List.mem_cons, List.not_mem_nil, or_false] at h
          rcases h with rfl | rfl
          · left; simp [BaseAtom.map, blockMap, hov, hex]
          · right; simp [BaseAtom.map, blockMap, hov, hex]
      · rw [beq_iff_eq, atomOwner_map, hw, Option.map_some, ← specialCopy_blockMap e x w, hwy]

/-! ## N3.1  Finite-name amalgamation and packing (S-6) -/

-- provides: U3, N3.1
theorem _root_.BTBMS.Hier.BaseAtom.holds_map {V W : Type} (P : Prims.{u}) (f : V → W) (a : W → Ordinal.{u})
    (x : BaseAtom V) : (x.map f).Holds P a ↔ x.Holds P (a ∘ f) := by
  cases x <;> rfl

-- provides: U3, N3.1
theorem _root_.BTBMS.Hier.baseHolds_map {V W : Type} (P : Prims.{u}) (f : V → W) (D : List (BaseAtom V))
    (a : W → Ordinal.{u}) : BaseHolds P (D.map (BaseAtom.map f)) a ↔ BaseHolds P D (a ∘ f) := by
  unfold BaseHolds
  simp only [List.forall_mem_map, BaseAtom.holds_map]

-- provides: U3, N3.1
theorem _root_.BTBMS.Hier.Diagram.holds_append {V : Type} (P : Prims.{u}) (a : V → Ordinal.{u})
    (D₁ D₂ : Diagram V) : (D₁ ++ D₂).Holds P a ↔ D₁.Holds P a ∧ D₂.Holds P a := by
  unfold Diagram.Holds
  exact List.forall_mem_append

-- provides: U3, N3.1
theorem _root_.BTBMS.Hier.Diagram.holds_map {V W : Type} (P : Prims.{u}) (f : V → W) (a : W → Ordinal.{u})
    (D : Diagram V) : (D.map f).Holds P a ↔ D.Holds P (a ∘ f) := by
  unfold Diagram.Holds Diagram.map
  simp only [List.forall_mem_map]
  apply forall_congr'; intro x; apply imp_congr_right; intro _
  cases x with
  | base b => exact BaseAtom.holds_map P f a b
  | noReal D fr u L =>
    simp only [Atom.map, Atom.Holds, Option.map_map]
    rfl

/-- N3.1 helper: a base atom reads only its variables. -/
theorem amalg_baseAtom_congr {V : Type} (P : Prims.{u}) {a a' : V → Ordinal.{u}}
    (x : BaseAtom V) (h : ∀ v ∈ x.vars, a v = a' v) : x.Holds P a ↔ x.Holds P a' := by
  cases x <;> simp_all [BaseAtom.vars, BaseAtom.Holds]

theorem amalg_baseHolds_congr {V : Type} (P : Prims.{u}) {a a' : V → Ordinal.{u}}
    (D : List (BaseAtom V)) (h : ∀ v ∈ baseVars D, a v = a' v) : BaseHolds P D a ↔ BaseHolds P D a' := by
  unfold BaseHolds
  apply forall_congr'; intro x; apply imp_congr_right; intro hx
  exact amalg_baseAtom_congr P x fun v hv => h v (List.mem_flatMap.2 ⟨x, hx, hv⟩)

/-- N3.1 helper: `BlockAbove` reads the frame only on the variables of the block. -/
theorem amalg_blockAbove_congr {W : Type} (P : Prims.{u}) (D : List (BaseAtom W))
    {fr fr' : W → Option Ordinal.{u}} (hfr : ∀ x ∈ baseVars D, fr x = fr' x) (L w : Ordinal.{u}) :
    BlockAbove P D fr L w → BlockAbove P D fr' L w := by
  classical
  rintro ⟨β, h1, h2, h3, h4⟩
  refine ⟨fun x => if x ∈ baseVars D then β x else (fr' x).getD 0, ?_, ?_, ?_, ?_⟩
  · intro x o hx
    by_cases hm : x ∈ baseVars D
    · simp only [if_pos hm]; exact h1 x o (by rw [hfr x hm]; exact hx)
    · simp only [if_neg hm, hx]; rfl
  · intro x hx hn
    simp only [if_pos hx]; exact h2 x hx (by rw [hfr x hx]; exact hn)
  · intro x hx
    simp only [if_pos hx]; exact h3 x hx
  · exact (amalg_baseHolds_congr P D fun v hv => by simp only [if_pos hv]).1 h4

/-- N3.1 helper: an atom reads only its variables. -/
theorem amalg_atom_congr {V : Type} (P : Prims.{u}) {a a' : V → Ordinal.{u}}
    (x : Atom V) (h : ∀ v ∈ x.vars, a v = a' v) : x.Holds P a ↔ x.Holds P a' := by
  cases x with
  | base b => exact amalg_baseAtom_congr P b h
  | noReal D fr u L =>
    simp only [Atom.vars, List.mem_cons, forall_eq_or_imp] at h
    obtain ⟨hu, hL, hr⟩ := h
    simp only [Atom.Holds, hu, hL]
    have hfr : ∀ x ∈ baseVars D, (fr x).map a = (fr x).map a' := by
      intro x hx
      cases hf : fr x with
      | none => rfl
      | some v => simp [hr v (List.mem_filterMap.2 ⟨x, hx, hf⟩)]
    exact not_congr ⟨amalg_blockAbove_congr P D hfr _ _,
      amalg_blockAbove_congr P D (fun x hx => (hfr x hx).symm) _ _⟩

-- provides: U3, N3.1
theorem _root_.BTBMS.Hier.Diagram.amalgamate {V : Type} [DecidableEq V] (P : Prims.{u}) (D₁ D₂ : Diagram V)
    (a₁ a₂ : V → Ordinal.{u}) (h₁ : D₁.Holds P a₁) (h₂ : D₂.Holds P a₂)
    (hshare : ∀ x ∈ D₁.vars, x ∈ D₂.vars → a₁ x = a₂ x) :
    (D₁ ++ D₂).Holds P (fun x => if x ∈ D₁.vars then a₁ x else a₂ x) := by
  rw [Diagram.holds_append]
  constructor
  · intro x hx
    refine (amalg_atom_congr P x fun v hv => ?_).2 (h₁ x hx)
    have : v ∈ D₁.vars := List.mem_flatMap.2 ⟨x, hx, hv⟩
    simp [this]
  · intro x hx
    refine (amalg_atom_congr P x fun v hv => ?_).2 (h₂ x hx)
    have : v ∈ D₂.vars := List.mem_flatMap.2 ⟨x, hx, hv⟩
    by_cases h : v ∈ D₁.vars
    · simp [h, hshare v h this]
    · simp [h]

/-- N3.1 helper: facts about `foldr max`. -/
theorem foldr_max_spec {L : Ordinal.{u}} :
    ∀ l : List Ordinal.{u}, L ≤ l.foldr max L ∧ ∀ x ∈ l, x ≤ l.foldr max L
  | [] => ⟨le_rfl, by simp⟩
  | y :: l => by
    obtain ⟨h1, h2⟩ := foldr_max_spec (L := L) l
    refine ⟨h1.trans (le_max_right _ _), fun x hx => ?_⟩
    rcases List.mem_cons.1 hx with rfl | hx
    · exact le_max_left _ _
    · exact (h2 x hx).trans (le_max_right _ _)

theorem foldr_max_lt {L θ : Ordinal.{u}} (hL : L < θ) :
    ∀ l : List Ordinal.{u}, (∀ x ∈ l, x < θ) → l.foldr max L < θ
  | [], _ => hL
  | y :: l, hl => max_lt (hl y (List.mem_cons_self ..))
      (foldr_max_lt hL l fun x hx => hl x (List.mem_cons_of_mem _ hx))

-- provides: U3, N3.1 (finitely many coordinates below a limit fit below one stage above a floor)
theorem pack_below {u' L : Ordinal.{u}} (hu : IsLim u') (hL : L < u') (l : List Ordinal.{u})
    (hl : ∀ x ∈ l, x < u') : ∃ β, L ≤ β ∧ β < u' ∧ ∀ x ∈ l, x < β := by
  obtain ⟨hLm, hm⟩ := foldr_max_spec (L := L) l
  refine ⟨Order.succ (l.foldr max L), hLm.trans (Order.le_succ _),
    hu.1.succ_lt (foldr_max_lt hL l hl), fun x hx => ?_⟩
  exact Order.lt_succ_iff.2 (hm x hx)

/-! ## D4.1b  Facts about admitted records -/

/-- D4.1b helper: the hosts of a scan or descendant record: the source host is the anchor's
`r`, the target host is its `t`. -/
theorem anchor_hosts_D8 {E : Forest} (hE : IsStd E) {cap : Option (Closure.AdmCap E)} {i j : Nat}
    {a b : EntryAddr} (hA : SrcRecord.AnchorAt E cap i j b)
    (hsrc : SrcRecord.anchorSrc E cap i = some a) :
    ∃ sd, Scan.stopData (Closure.anchor E cap) = some sd ∧ a.col.num 0 = sd.r ∧
      b.col.num 0 = sd.t ∧ sd.r < sd.t := by
  obtain ⟨sd, rd, -, hsd, hrd, hor, hreach, -⟩ := hA
  obtain ⟨hres, hnum, -⟩ := Scan.rootData_path hsd hrd
  have ha : a = ⟨rd.col, i⟩ := by
    simp only [SrcRecord.anchorSrc, hrd, Option.map_some] at hsrc
    exact (Option.some.inj hsrc).symm
  have hj : j < sd.Q.length := by
    obtain ⟨-, x, y, -, hy, -⟩ := hreach
    have := List.getElem?_eq_some_iff.1 hy
    simpa [Scan.queryKeys] using this.1
  have ht : sd.t = sd.col.num 0 := (Scan.stopData_spec hsd).2.2.1
  refine ⟨sd, hsd, by rw [ha]; exact hnum, ?_, ?_⟩
  · cases cap with
    | none =>
      simp only [Closure.anchorOrigin, Option.some.injEq, Role.slot.injEq] at hor
      rw [← hor, ht]
    | some w =>
      obtain ⟨hnt, -, hlen, -, hq⟩ := Closure.admCap_query (Closure.std_inL hE) w hsd
      have := (hq j (hlen ▸ hj)).1
      simp only [Closure.anchorOrigin] at hor
      rw [hor, Option.some.injEq, Role.slot.injEq] at this
      rw [this, hnt]
  · rw [ht]; exact ColAddr.resolve_lt hres

-- provides: U3, D4.1b (source host at most target host; equal exactly for repair records)
theorem admitted_hosts {rk : SrcRecord} (h : rk.Admitted) :
    rk.a.col.num 0 ≤ rk.b.col.num 0 ∧
    (∀ ms, rk.kind = .repair ms → rk.a.col.num 0 = rk.b.col.num 0) ∧
    (∀ cap i j, (rk.kind = .scan cap i j ∨ rk.kind = .desc cap i j) →
      rk.a.col.num 0 < rk.b.col.num 0) := by
  obtain ⟨hE, -, -, -, -, -, hk⟩ := h
  have hrep : ∀ ms, rk.kind = .repair ms → rk.a.col.num 0 = rk.b.col.num 0 := by
    intro ms hms
    rw [hms] at hk
    obtain ⟨-, ha, -⟩ := hk
    rw [ha, Closure.moveAddr_num]
  have hsc : ∀ cap i j, (rk.kind = .scan cap i j ∨ rk.kind = .desc cap i j) →
      rk.a.col.num 0 < rk.b.col.num 0 := by
    intro cap i j hkind
    rcases hkind with hkind | hkind <;> rw [hkind] at hk
    · obtain ⟨sd, -, h1, h2, h3⟩ := anchor_hosts_D8 hE hk.1 hk.2.1; omega
    · obtain ⟨sd, -, h1, h2, h3⟩ := anchor_hosts_D8 hE hk.1 hk.2.1; omega
  refine ⟨?_, hrep, hsc⟩
  cases hkind : rk.kind with
  | scan cap i j => exact (hsc cap i j (Or.inl hkind)).le
  | desc cap i j => exact (hsc cap i j (Or.inr hkind)).le
  | repair ms => exact (hrep ms hkind).le

-- provides: U3, D4.1b (both marked heights are nonempty or the target is empty)
theorem admitted_src_ne {rk : SrcRecord} (h : rk.Admitted) : rk.srcHeight ≠ Tree.empty := by
  intro he
  have hlt : keyCmp rk.tgtKey rk.srcKey = .lt := h.2.2.2.2.2.1
  rw [SrcRecord.srcKey, he] at hlt
  simp only [keyCmp, relKey, Tree.empty, Tree.map, Tree.mapCols] at hlt
  generalize rk.tgtKey = X at hlt
  obtain ⟨cols⟩ := X
  cases cols <;> simp [Tree.cmp, Tree.cmpCols] at hlt

/-! ## L4.2  First differences: the classifier, κ-transfer, path transfer, cap legality -/

-- SCR2 applied at integration: the bridge holds by `rfl`
theorem firstDiff_eq_def (rk : SrcRecord) : rk.firstDiff = firstDiffDef rk := rfl

/-- L4.2: the part of a tree strictly before a position: the containing structure along `π`,
the columns `0 … j-1` of the forest at `π`, and (if `k = some k'`) the first `k'` entries of
column `j`. -/
def cutBefore {α : Type} : List (Nat × Nat) → Nat → Option Nat → Tree α → Tree α
  | [], j, none, .node cols => .node (cols.take j)
  | [], j, some k, .node cols => .node (cols.take j ++ [((cols[j]?).getD []).take k])
  | (ci, ii) :: rest, j, k, .node cols =>
    match cols[ci]? with
    | some col =>
      match col[ii]? with
      | some (l, h) => .node (cols.take ci ++ [col.take ii ++ [(l, cutBefore rest j k h)]])
      | none => .node cols
    | none => .node cols

/-- D4.1a helper: the meaning of a `diff` result of the walker at absolute path `π` on the keys
`X` (target) and `Y` (source). -/
def FDSpec_D8 (t : Nat) (π : List (Nat × Nat)) (top : Bool) (X Y : Key) :
    SrcRecord.FirstDiff → Prop
  | .wholeEnds => top = true ∧ X.cols <+: Y.cols ∧ X.cols.length < Y.cols.length
  | .childEnds π' => ∃ ρ X0 Y0, π' = π ++ ρ ∧ (top = true → ρ ≠ []) ∧
      X.forestAt ρ = some X0 ∧ Y.forestAt ρ = some Y0 ∧ X0.cols.length < Y0.cols.length ∧
      cutBefore ρ X0.cols.length none X = cutBefore ρ X0.cols.length none Y
  | .capAt c k p => ∃ ρ, c.path = π ++ ρ ∧
      cutBefore ρ c.col (some k) X = cutBefore ρ c.col (some k) Y ∧
      (X.colAt ⟨ρ, c.col⟩).isSome ∧
      ((X.entryAt ⟨⟨ρ, c.col⟩, k⟩ = none ∧ ∃ l hs, Y.entryAt ⟨⟨ρ, c.col⟩, k⟩ = some (l, hs) ∧
          p = labelAbs t l) ∨
       (∃ l₁ h₁ l₂ h₂, X.entryAt ⟨⟨ρ, c.col⟩, k⟩ = some (l₁, h₁) ∧
          Y.entryAt ⟨⟨ρ, c.col⟩, k⟩ = some (l₂, h₂) ∧ keyLabelCmp l₁ l₂ = .lt ∧
          p = labelAbs t l₂))

/-- D4.1a helper: the three outcomes of a walker step. -/
def FDRes_D8 (r : FDStep) (eqP gtP : Prop) (spec : SrcRecord.FirstDiff → Prop) : Prop :=
  match r with
  | .same => eqP
  | .stop => gtP
  | .diff d => spec d

/-- D4.1a helper: the forest reached through entry `(|pre|, |cpre|)` is that entry's height. -/
theorem forestAt_lift_D8 {α : Type} (pre : List (List (α × Tree α))) (cpre es : List (α × Tree α))
    (xs : List (List (α × Tree α))) (l : α) (h : Tree α) (ρ : List (Nat × Nat)) :
    (Tree.node (pre ++ (cpre ++ (l, h) :: es) :: xs)).forestAt ((pre.length, cpre.length) :: ρ) =
      h.forestAt ρ := by
  simp [Tree.forestAt, Tree.cols]

/-- D4.1a helper: `cutBefore` through entry `(|pre|, |cpre|)`. -/
theorem cutBefore_lift_D8 {α : Type} (pre : List (List (α × Tree α))) (cpre es : List (α × Tree α))
    (xs : List (List (α × Tree α))) (l : α) (h : Tree α) (ρ : List (Nat × Nat)) (j : Nat)
    (k : Option Nat) :
    cutBefore ((pre.length, cpre.length) :: ρ) j k (Tree.node (pre ++ (cpre ++ (l, h) :: es) :: xs)) =
      .node (pre ++ [cpre ++ [(l, cutBefore ρ j k h)]]) := by
  simp [cutBefore]

/-- D4.1a helper: a difference found inside the height of a common entry is a difference of the
surrounding forests. -/
theorem fd_lift_D8 (t : Nat) (π : List (Nat × Nat)) (top : Bool)
    (pre : List (List ((Bool × Nat) × Key))) (cpre es fs : List ((Bool × Nat) × Key))
    (xs ys : List (List ((Bool × Nat) × Key))) (l : Bool × Nat) (h1 h2 : Key) (d : SrcRecord.FirstDiff)
    (hd : FDSpec_D8 t (π ++ [(pre.length, cpre.length)]) false h1 h2 d) :
    FDSpec_D8 t π top (.node (pre ++ (cpre ++ (l, h1) :: es) :: xs))
      (.node (pre ++ (cpre ++ (l, h2) :: fs) :: ys)) d := by
  match d, hd with
  | .wholeEnds, hd => exact absurd hd.1 (by simp)
  | .childEnds π', ⟨ρ, X0, Y0, hπ, _, hX, hY, hlt, hcut⟩ =>
    refine ⟨(pre.length, cpre.length) :: ρ, X0, Y0, by simp [hπ], fun _ => by simp, ?_, ?_, hlt, ?_⟩
    · rw [forestAt_lift_D8]; exact hX
    · rw [forestAt_lift_D8]; exact hY
    · rw [cutBefore_lift_D8, cutBefore_lift_D8, hcut]
  | .capAt c k p, ⟨ρ, hπ, hcut, hcol, hent⟩ =>
    refine ⟨(pre.length, cpre.length) :: ρ, by simp [hπ], ?_, ?_, ?_⟩
    · rw [cutBefore_lift_D8, cutBefore_lift_D8, hcut]
    · simpa [Tree.colAt, forestAt_lift_D8] using hcol
    · simpa [Tree.entryAt, Tree.colAt, forestAt_lift_D8] using hent

mutual
/-- D4.1a helper: the walker's outcomes (`same`: equal; `stop`: target larger; `diff d`: the
meaning `FDSpec_D8`), by mutual structural recursion on the target key. -/
theorem fdForest_spec_D8 (t : Nat) (π : List (Nat × Nat)) (top : Bool) :
    (X Y : Key) → FDRes_D8 (fdForest t π top X Y) (X = Y) (keyCmp X Y = .gt)
      (FDSpec_D8 t π top X Y)
  | .node xs, .node ys => by
    have := fdCols_spec_D8 t π top 0 xs ys [] rfl
    simp only [fdForest, keyCmp, Tree.cmp]
    revert this
    cases fdCols t π top 0 xs ys <;> simp [FDRes_D8]
termination_by structural X _ => X

theorem fdCols_spec_D8 (t : Nat) (π : List (Nat × Nat)) (top : Bool) :
    (ci : Nat) → (xs ys : List (List ((Bool × Nat) × Key))) →
    (pre : List (List ((Bool × Nat) × Key))) → pre.length = ci →
    FDRes_D8 (fdCols t π top ci xs ys) (xs = ys) (Tree.cmpCols keyLabelCmp xs ys = .gt)
      (FDSpec_D8 t π top (.node (pre ++ xs)) (.node (pre ++ ys)))
  | _, [], [], _, _ => by simp [fdCols, FDRes_D8]
  | ci, [], y :: ys, pre, hpre => by
    simp only [fdCols, FDRes_D8]
    cases top
    · refine ⟨[], .node pre, .node (pre ++ y :: ys), by simp, by simp, by simp [Tree.forestAt],
        by simp [Tree.forestAt], by simp [Tree.cols], ?_⟩
      simp [cutBefore, Tree.cols]
    · exact ⟨rfl, by simp [Tree.cols], by simp [Tree.cols]⟩
  | _, _ :: _, [], _, _ => by simp [fdCols, FDRes_D8, Tree.cmpCols]
  | ci, x :: xs, y :: ys, pre, hpre => by
    have hc := fdCol_spec_D8 t π ci 0 x y pre [] xs ys top hpre rfl
    simp only [List.nil_append] at hc
    simp only [fdCols]
    revert hc
    cases hr : fdCol t π ci 0 x y with
    | same =>
      intro hc
      simp only [FDRes_D8] at hc
      subst hc
      have := fdCols_spec_D8 t π top (ci + 1) xs ys (pre ++ [x]) (by simp [hpre])
      simp only [List.append_assoc, List.cons_append, List.nil_append] at this
      revert this
      cases fdCols t π top (ci + 1) xs ys <;>
        simp [FDRes_D8, Tree.cmpCols, Tree.cmpCol_self]
    | stop =>
      intro hc
      simp only [FDRes_D8] at hc ⊢
      simp [Tree.cmpCols, hc]
    | diff d =>
      intro hc
      exact hc
termination_by structural _ xs => xs

theorem fdCol_spec_D8 (t : Nat) (π : List (Nat × Nat)) :
    (ci k : Nat) → (es fs : List ((Bool × Nat) × Key)) →
    (pre : List (List ((Bool × Nat) × Key))) → (cpre : List ((Bool × Nat) × Key)) →
    (xs ys : List (List ((Bool × Nat) × Key))) → (top : Bool) → pre.length = ci → cpre.length = k →
    FDRes_D8 (fdCol t π ci k es fs) (es = fs) (Tree.cmpCol keyLabelCmp es fs = .gt)
      (FDSpec_D8 t π top (.node (pre ++ (cpre ++ es) :: xs)) (.node (pre ++ (cpre ++ fs) :: ys)))
  | _, _, [], [], _, _, _, _, _, _, _ => by simp [fdCol, FDRes_D8]
  | ci, k, [], (l, hs) :: fs, pre, cpre, xs, ys, top, hpre, hcpre => by
    simp only [fdCol, FDRes_D8]
    refine ⟨[], by simp, ?_, ?_, Or.inl ⟨?_, l, hs, ?_, rfl⟩⟩
    · subst hpre hcpre; simp [cutBefore]
    · subst hpre; simp [Tree.colAt, Tree.forestAt, Tree.cols]
    · subst hpre hcpre; simp [Tree.entryAt, Tree.colAt, Tree.forestAt, Tree.cols]
    · subst hpre hcpre; simp [Tree.entryAt, Tree.colAt, Tree.forestAt, Tree.cols]
  | _, _, _ :: _, [], _, _, _, _, _, _, _ => by simp [fdCol, FDRes_D8, Tree.cmpCol]
  | ci, k, (l1, h1) :: es, (l2, h2) :: fs, pre, cpre, xs, ys, top, hpre, hcpre => by
    simp only [fdCol]
    cases hl : keyLabelCmp l1 l2 with
    | lt =>
      simp only [FDRes_D8]
      refine ⟨[], by simp, ?_, ?_, Or.inr ⟨l1, h1, l2, h2, ?_, ?_, hl, rfl⟩⟩
      · subst hpre hcpre; simp [cutBefore]
      · subst hpre; simp [Tree.colAt, Tree.forestAt, Tree.cols]
      · subst hpre hcpre; simp [Tree.entryAt, Tree.colAt, Tree.forestAt, Tree.cols]
      · subst hpre hcpre; simp [Tree.entryAt, Tree.colAt, Tree.forestAt, Tree.cols]
    | gt => simp [FDRes_D8, Tree.cmpCol, hl]
    | eq =>
      have hl' : l1 = l2 := Std.LawfulEqCmp.eq_of_compare hl
      subst hl'
      simp only
      have hf := fdForest_spec_D8 t (π ++ [(ci, k)]) false h1 h2
      revert hf
      cases hr : fdForest t (π ++ [(ci, k)]) false h1 h2 with
      | same =>
        intro hf
        simp only [FDRes_D8] at hf
        subst hf
        have := fdCol_spec_D8 t π ci (k + 1) es fs pre (cpre ++ [(l1, h1)]) xs ys top hpre
          (by simp [hcpre])
        simp only [List.append_assoc, List.cons_append, List.nil_append] at this
        revert this
        cases fdCol t π ci (k + 1) es fs <;>
          simp [FDRes_D8, Tree.cmpCol, Tree.cmp_self, hl]
      | stop =>
        intro hf
        simp only [FDRes_D8] at hf ⊢
        simp [Tree.cmpCol, hl, show Tree.cmp keyLabelCmp h1 h2 = .gt from hf]
      | diff d =>
        intro hf
        simp only [FDRes_D8] at hf ⊢
        subst hpre hcpre
        exact fd_lift_D8 t π top pre cpre es fs xs ys l1 h1 h2 d hf
termination_by structural _ _ es => es
end

-- provides: U3, L4.2 (meaning of the classifier)
theorem firstDiff_spec {rk : SrcRecord} (h : rk.Admitted) :
    (rk.firstDiff = .wholeEnds →
      rk.tgtKey.cols <+: rk.srcKey.cols ∧ rk.tgtKey.cols.length < rk.srcKey.cols.length) ∧
    (∀ π, rk.firstDiff = .childEnds π → ∃ ρ X Y, π = rk.b.heightPath ++ ρ ∧ ρ ≠ [] ∧
      rk.tgtKey.forestAt ρ = some X ∧ rk.srcKey.forestAt ρ = some Y ∧
      X.cols.length < Y.cols.length ∧
      cutBefore ρ X.cols.length none rk.tgtKey = cutBefore ρ X.cols.length none rk.srcKey) ∧
    (∀ c k p, rk.firstDiff = .capAt c k p → ∃ ρ, c.path = rk.b.heightPath ++ ρ ∧
      cutBefore ρ c.col (some k) rk.tgtKey = cutBefore ρ c.col (some k) rk.srcKey ∧
      (rk.tgtKey.colAt ⟨ρ, c.col⟩).isSome ∧
      ((rk.tgtKey.entryAt ⟨⟨ρ, c.col⟩, k⟩ = none ∧ ∃ l hs, rk.srcKey.entryAt ⟨⟨ρ, c.col⟩, k⟩ = some (l, hs) ∧
          p = labelAbs (rk.b.col.num 0) l) ∨
       (∃ l₁ h₁ l₂ h₂, rk.tgtKey.entryAt ⟨⟨ρ, c.col⟩, k⟩ = some (l₁, h₁) ∧
          rk.srcKey.entryAt ⟨⟨ρ, c.col⟩, k⟩ = some (l₂, h₂) ∧ keyLabelCmp l₁ l₂ = .lt ∧
          p = labelAbs (rk.b.col.num 0) l₂))) := by
  have hlt : keyCmp rk.tgtKey rk.srcKey = .lt := h.2.2.2.2.2.1
  have hs := fdForest_spec_D8 (rk.b.col.num 0) rk.b.heightPath true rk.tgtKey rk.srcKey
  have hfd : rk.firstDiff = match fdForest (rk.b.col.num 0) rk.b.heightPath true rk.tgtKey
      rk.srcKey with
    | .diff d => d
    | _ => .wholeEnds := rfl
  revert hs hfd
  cases fdForest (rk.b.col.num 0) rk.b.heightPath true rk.tgtKey rk.srcKey with
  | same =>
    intro hs; simp only [FDRes_D8] at hs
    rw [hs, keyCmp, Tree.cmp_self] at hlt; exact absurd hlt (by decide)
  | stop =>
    intro hs; simp only [FDRes_D8] at hs
    rw [hs] at hlt; exact absurd hlt (by decide)
  | diff d =>
    intro hs hfd
    simp only [FDRes_D8] at hs hfd
    rw [hfd]
    refine ⟨fun hd => ?_, fun π hd => ?_, fun c k p hd => ?_⟩
    · subst hd; exact hs.2
    · subst hd
      obtain ⟨ρ, X0, Y0, hπ, hne, hX, hY, hl, hc⟩ := hs
      exact ⟨ρ, X0, Y0, hπ, hne rfl, hX, hY, hl, hc⟩
    · subst hd; exact hs

/-- L4.2a: the label map `κ` from source normalization (threshold `≥ r`) to target normalization
(threshold shifted by `t - r`): false fields below `r` are fixed, other false fields move by
`t - r`, true fields are fixed. -/
def kappa (r t : Nat) : Bool × Nat → Bool × Nat
  | (false, q) => if q < r then (false, q) else (false, q + (t - r))
  | (true, v) => (true, v)

-- provides: U3, L4.2a (`κ` is an order embedding of labels)
theorem kappa_cmp {r t : Nat} (h : r ≤ t) (x y : Bool × Nat) :
    keyLabelCmp (kappa r t x) (kappa r t y) = keyLabelCmp x y := by
  obtain ⟨bx, x⟩ := x; obtain ⟨b2, y⟩ := y
  have key : ∀ x' y' : Nat, (x' < y' ↔ x < y) → (x' = y' ↔ x = y) →
      compare x' y' = compare x y := by
    intro x' y' h1 h2
    rcases Nat.lt_trichotomy x y with hl | he | hg
    · rw [Nat.compare_eq_lt.2 hl, Nat.compare_eq_lt.2 (h1.2 hl)]
    · rw [Nat.compare_eq_eq.2 he, Nat.compare_eq_eq.2 (h2.2 he)]
    · rw [Nat.compare_eq_gt.2 hg, Nat.compare_eq_gt.2 (by
        rcases Nat.lt_trichotomy x' y' with a | a | a
        · exact absurd (h1.1 a) (by omega)
        · exact absurd (h2.1 a) (by omega)
        · exact a)]
  cases bx <;> cases b2 <;> simp only [kappa, keyLabelCmp] <;> (try split_ifs) <;>
    simp only [] <;> (try rfl) <;> (congr 1; apply key <;> omega)

-- provides: U3, L4.2a (an order embedding of labels is an order embedding of keys)
theorem keyCmp_map {f : Bool × Nat → Bool × Nat} (hf : ∀ x y, keyLabelCmp (f x) (f y) = keyLabelCmp x y)
    (K K' : Key) : keyCmp (K.map f) (K'.map f) = keyCmp K K' := Tree.cmp_map hf K K'

mutual
/-- L4.2a helper: if two relabellings agree, and agreement of labels determines the second label
by `σ`, the second tree is the `σ`-relabelling of the first. -/
theorem map_eq_map_D8 {α β γ : Type} {f : α → γ} {g : β → γ} {σ : α → β}
    (hσ : ∀ a b, f a = g b → b = σ a) :
    (X : Tree α) → (Y : Tree β) → X.map f = Y.map g → Y = X.map σ
  | .node xs, .node ys, h => by
    simp only [Tree.map] at h ⊢
    rw [mapCols_eq_mapCols_D8 hσ xs ys (Tree.node.inj h)]
theorem mapCols_eq_mapCols_D8 {α β γ : Type} {f : α → γ} {g : β → γ} {σ : α → β}
    (hσ : ∀ a b, f a = g b → b = σ a) :
    (xs : List (List (α × Tree α))) → (ys : List (List (β × Tree β))) →
      Tree.mapCols f xs = Tree.mapCols g ys → ys = Tree.mapCols σ xs
  | [], [], _ => rfl
  | [], _ :: _, h => by simp [Tree.mapCols] at h
  | _ :: _, [], h => by simp [Tree.mapCols] at h
  | x :: xs, y :: ys, h => by
    simp only [Tree.mapCols, List.cons.injEq] at h ⊢
    exact ⟨mapCol_eq_mapCol_D8 hσ x y h.1, mapCols_eq_mapCols_D8 hσ xs ys h.2⟩
theorem mapCol_eq_mapCol_D8 {α β γ : Type} {f : α → γ} {g : β → γ} {σ : α → β}
    (hσ : ∀ a b, f a = g b → b = σ a) :
    (xs : List (α × Tree α)) → (ys : List (β × Tree β)) →
      Tree.mapCol f xs = Tree.mapCol g ys → ys = Tree.mapCol σ xs
  | [], [], _ => rfl
  | [], _ :: _, h => by simp [Tree.mapCol] at h
  | _ :: _, [], h => by simp [Tree.mapCol] at h
  | (p, hp) :: xs, (q, hq) :: ys, h => by
    simp only [Tree.mapCol, List.cons.injEq, Prod.mk.injEq] at h ⊢
    exact ⟨⟨hσ p q h.1.1, map_eq_map_D8 hσ hp hq h.1.2⟩, mapCol_eq_mapCol_D8 hσ xs ys h.2⟩
end

-- provides: U3, L4.2a (common relative syntax: κ carries source keys to target keys)
theorem relKey_kappa {r t s : Nat} {X Y : Forest} (hrt : r ≤ t) (hrs : r ≤ s)
    (h : relKey r X = relKey t Y) : (relKey s X).map (kappa r t) = relKey (s + (t - r)) Y := by
  have hY : Y = X.map (shiftVal r (t - r)) := by
    refine map_eq_map_D8 (f := relLabel r) (g := relLabel t) ?_ X Y h
    intro a b hab
    simp only [relLabel, shiftVal] at hab ⊢
    by_cases ha : a < r <;> by_cases hb : b < t <;>
      simp [ha, hb, Nat.not_le.2, Nat.le_of_not_lt] at hab ⊢ <;> omega
  subst hY
  rw [relKey_eq_map, relKey_eq_map, Scan.treeMap_map, Scan.treeMap_map]
  congr 1
  funext p
  simp only [Function.comp, relLabel, shiftVal]
  by_cases hp : p < r
  · have hps : p < s := by omega
    have hps' : p < s + (t - r) := by omega
    simp [hp, hps, hps', kappa, Nat.not_le.2 hp]
  · by_cases hps : p < s
    · have hps' : p + (t - r) < s + (t - r) := by omega
      simp [hp, hps, hps', kappa, Nat.le_of_not_lt hp]
    · have hps' : ¬ p + (t - r) < s + (t - r) := by omega
      simp [hps, hps', kappa, Nat.le_of_not_lt hp]
      omega

-- provides: U3, L4.2a (κ fixes keys normalized at or below `r`)
theorem relKey_kappa_low {r t s : Nat} (hsr : s ≤ r) (X : Forest) :
    (relKey s X).map (kappa r t) = relKey s X := by
  rw [relKey_eq_map, Scan.treeMap_map]
  congr 1
  funext p
  simp only [Function.comp, relLabel]
  by_cases hp : p < s
  · have hpr : p < r := by omega
    simp [hp, kappa, hpr]
  · simp [hp, kappa]

/-- L4.2b: the key list of a column cut after entry `u` with key `u` raised to `⊤`. -/
def cappedAt (ks : List (WithTop Key)) (u : Nat) : List (WithTop Key) := ks.take u ++ [⊤]

/-- L4.2b helper: a source whose first letter is above every query letter is never consumed. -/
theorem cursor_cons_of_lt_D8 {α : Type} [LinearOrder α] (x : α) (xs : List α) :
    ∀ (V : List α), (∀ v ∈ V, v < x) → Scan.cursor (x :: xs) V = 0
  | [], _ => by simp [Scan.cursor]
  | v :: V, h => by
    have hv : v < x := h v List.mem_cons_self
    rw [Scan.cursor, if_neg (not_lt.2 hv.le), if_neg (ne_of_gt hv)]
    exact cursor_cons_of_lt_D8 x xs V fun w hw => h w (List.mem_cons_of_mem _ hw)

/-- L4.2b helper: a one-letter source that is never consumed is above every query letter. -/
theorem lt_of_cursor_singleton_D8 {α : Type} [LinearOrder α] (x : α) :
    ∀ (V : List α), Scan.cursor [x] V = 0 → ∀ v ∈ V, v < x
  | [], _ => by simp
  | v :: V, h => by
    by_cases h1 : x < v
    · rw [Scan.cursor, if_pos h1] at h; simp at h
    by_cases h2 : x = v
    · rw [Scan.cursor, if_neg h1, if_pos h2] at h; simp at h
    rw [Scan.cursor, if_neg h1, if_neg h2] at h
    intro w hw
    rcases List.mem_cons.1 hw with rfl | hw
    · exact lt_of_le_of_ne (not_lt.1 h1) (Ne.symm h2)
    · exact lt_of_cursor_singleton_D8 x V h w hw

/-- L4.2b helper: a `⊤`-terminated source is never scanned past its `⊤`. -/
theorem cursor_append_top_le_D8 (blk W : List (WithTop Key)) (hW : ∀ y ∈ W, y ≠ ⊤) :
    Scan.cursor (blk ++ [⊤]) W ≤ blk.length := by
  rcases Nat.lt_or_ge (Scan.cursor blk W) blk.length with h | h
  · rw [Scan.cursor_append_of_lt _ h]; exact h.le
  · have he : Scan.cursor blk W = blk.length := le_antisymm (Scan.cursor_le_length _ _) h
    rw [(Scan.cursor_append_of_exhausted [⊤] he).1, Scan.cursor_singleton_of_lt _ _
      (fun v hv => WithTop.lt_top_iff_ne_top.2 (hW v (List.mem_of_mem_drop hv)))]
    omega

-- provides: U3, L4.2b (a capped same-parent block answers like one capped entry; txt:680-681)
theorem capped_block_resp (pre blk : List (WithTop Key)) (ppre : List Nat) (p : Nat)
    (W : List (WithTop Key)) (hW : ∀ y ∈ W, y ≠ ⊤) (hlen : ppre.length = pre.length) :
    (ppre ++ List.replicate (blk.length + 1) p)[Scan.cursor (pre ++ blk ++ [⊤]) W]? =
      (ppre ++ [p])[Scan.cursor (pre ++ [⊤]) W]? := by
  rcases Nat.lt_or_ge (Scan.cursor pre W) pre.length with h | h
  · rw [List.append_assoc, Scan.cursor_append_of_lt _ h, Scan.cursor_append_of_lt _ h,
      List.getElem?_append_left (by omega), List.getElem?_append_left (by omega)]
  · have he : Scan.cursor pre W = pre.length := le_antisymm (Scan.cursor_le_length _ _) h
    have hW' : ∀ y ∈ W.drop (Scan.qcursor pre W), y ≠ ⊤ := fun y hy => hW y (List.mem_of_mem_drop hy)
    rw [List.append_assoc, (Scan.cursor_append_of_exhausted _ he).1,
      (Scan.cursor_append_of_exhausted _ he).1,
      Scan.cursor_singleton_of_lt _ _ (fun v hv => WithTop.lt_top_iff_ne_top.2 (hW' v hv))]
    have hm := cursor_append_top_le_D8 blk _ hW'
    rw [List.getElem?_append_right (by omega), List.getElem?_append_right (by omega),
      List.getElem?_replicate]
    simp [hlen]; omega

-- provides: U3, L4.2b (raising an unconsumed key and restoring later entries; txt:675-676)
theorem cursor_raise (pre : List (WithTop Key)) (x x' : WithTop Key) (post W : List (WithTop Key))
    (hxx' : x ≤ x') (hc : Scan.cursor (pre ++ [x]) W ≤ pre.length) :
    Scan.cursor (pre ++ x' :: post) W = Scan.cursor (pre ++ [x]) W := by
  rcases Nat.lt_or_ge (Scan.cursor pre W) pre.length with h | h
  · rw [Scan.cursor_append_of_lt _ h, Scan.cursor_append_of_lt _ h]
  · have he : Scan.cursor pre W = pre.length := le_antisymm (Scan.cursor_le_length _ _) h
    rw [(Scan.cursor_append_of_exhausted _ he).1] at hc ⊢
    rw [(Scan.cursor_append_of_exhausted _ he).1]
    have h0 : Scan.cursor [x] (W.drop (Scan.qcursor pre W)) = 0 := by omega
    rw [h0, cursor_cons_of_lt_D8 _ _ _ fun v hv =>
      lt_of_lt_of_le (lt_of_cursor_singleton_D8 x _ h0 v hv) hxx']

section CapLegal_D8
open Scan

/-- L4.2d helper: the cut index of an upward cap is at most the column length. -/
theorem upward_cut_le_D8 {E : Forest} {c : ColAddr} {k p : Nat} (hup : Closure.IsUpward E c k p) :
    k ≤ (parents E c).length := by
  unfold Closure.IsUpward at hup
  cases hcol : E.colAt c with
  | none => rw [hcol] at hup; exact hup.elim
  | some col =>
    simp only [hcol] at hup
    simp only [parents, hcol, Option.getD_some, List.length_map]
    cases hk : col[k]? with
    | none => rw [hk] at hup; omega
    | some x => exact (List.getElem?_eq_some_iff.1 hk).1.le

/-- L4.2d helper (step 3): V for the literal cap. Retained entries keep their labels (R11); the
closing parent `p` is reached from the cut start, so it lies below `c`'s number. -/
theorem litCap_condV_D8 {E : Forest} (hV : CondV E) {c : ColAddr} {k p : Nat}
    (hc : c ∈ E.colAddrs) (hdepth : c.path ≠ []) (hup : Closure.IsUpward E c k p)
    (hpath : Path E (actualKeys E) c (cutQuery (actualKeys E c) k) (cutStart E c k) p) :
    CondV (Closure.litCap E c k p) := by
  have hk := upward_cut_le_D8 hup
  obtain ⟨-, hlab, -, hcl, -⟩ := Closure.litCap_spec (p := p) hc hk
  intro e he q h hqh
  by_cases hec : e = ⟨c, k⟩
  · subst hec
    rw [hcl] at hqh
    cases hqh
    have hpos : 0 < c.num 0 := by
      obtain ⟨s, rest, hs⟩ := List.exists_cons_of_ne_nil hdepth
      simp [ColAddr.num, hs]
    have h1 := cutStart_lt hV hc hk hpos
    have h2 := path_le hV hpath
    rw [ColAddr.resolve_isSome_iff]
    exact ⟨Nat.zero_le _, show p < c.num 0 by omega⟩
  · have := hlab e he hec
    rw [hqh] at this
    obtain ⟨⟨q', h'⟩, hE, hq⟩ := Option.map_eq_some_iff.1 this.symm
    simp only at hq
    subst hq
    exact hV e ((Tree.mem_entryAddrs_iff E e).2 (by rw [hE]; rfl)) q' h' hE

/-- L4.2d helper: one containing step of `litCapAux` (cut column `ci` after entry `ei` and
put `x` there). -/
theorem capStep_getElem_D8 {β : Type} (cols : List (List β)) (ci ei : Nat) (x : β)
    (hci : ci < cols.length) (hei : ei ≤ (cols.getD ci []).length) :
    let cols' := cols.take ci ++ [(cols.getD ci []).take ei ++ [x]]
    cols'.length = ci + 1 ∧ (∀ c' < ci, cols'[c']? = cols[c']?) ∧
      cols'[ci]? = some ((cols.getD ci []).take ei ++ [x]) ∧
      (∀ y < ei, ((cols.getD ci []).take ei ++ [x])[y]? = (cols.getD ci [])[y]?) ∧
      ((cols.getD ci []).take ei ++ [x])[ei]? = some x ∧
      ((cols.getD ci []).take ei ++ [x]).length = ei + 1 := by
  intro cols'
  have hl : (cols.take ci).length = ci := by rw [List.length_take]; omega
  have hl2 : ((cols.getD ci []).take ei).length = ei := by rw [List.length_take]; omega
  refine ⟨by simp only [cols', List.length_append, hl, List.length_singleton], fun c' hc' => ?_, ?_,
    fun y hy => ?_, ?_, by rw [List.length_append, hl2, List.length_singleton]⟩
  · simp only [cols']
    rw [List.getElem?_append_left (by omega), List.getElem?_take_of_lt hc']
  · simp only [cols']
    rw [List.getElem?_append_right (by omega), hl]; simp
  · rw [List.getElem?_append_left (by omega), List.getElem?_take_of_lt hy]
  · rw [List.getElem?_append_right (by omega), hl2]; simp

/-- L4.2d helper: the forests of the literal cap along the cap path are literal caps of the
forests of `X` there. -/
theorem forestAt_litCapAux_D8 (k p j : Nat) : ∀ (ρ : List (Nat × Nat)) (X : Forest) (n : Nat),
    (X.forestAt ρ).isSome → n ≤ ρ.length →
    (Closure.litCapAux k p ρ j X).forestAt (ρ.take n) =
      (X.forestAt (ρ.take n)).map (Closure.litCapAux k p (ρ.drop n) j)
  | [], X, n, _, hn => by
    have : n = 0 := by simpa using hn
    subst this; rfl
  | (ci, ei) :: rest, .node cols, n, hv, hn => by
    rw [Tree.forestAt_cons] at hv
    obtain ⟨⟨q, h⟩, hqh, hv'⟩ : ∃ x, (cols[ci]?).bind (·[ei]?) = some x ∧
        (x.2.forestAt rest).isSome := by
      cases hx : (cols[ci]?).bind (·[ei]?) with
      | none => simp [Tree.cols, hx] at hv
      | some x => simp only [Tree.cols, hx, Option.bind_some] at hv; exact ⟨x, rfl, hv⟩
    obtain ⟨col, hcol, hei⟩ := Option.bind_eq_some_iff.1 hqh
    have hci : ci < cols.length := (List.getElem?_eq_some_iff.1 hcol).1
    have hgd : cols.getD ci [] = col := by simp [List.getD_eq_getElem?_getD, hcol]
    have hei' : ei < col.length := (List.getElem?_eq_some_iff.1 hei).1
    cases n with
    | zero => rfl
    | succ n =>
      have hlit : Closure.litCapAux k p ((ci, ei) :: rest) j (.node cols) =
          .node (cols.take ci ++ [(cols.getD ci []).take ei ++ [(q, Closure.litCapAux k p rest j h)]]) := by
        simp only [Closure.litCapAux, hgd, hei]
      obtain ⟨-, -, h2, -, h3, -⟩ := capStep_getElem_D8 cols ci ei (q, Closure.litCapAux k p rest j h)
        hci (by rw [hgd]; omega)
      rw [hlit, List.take_succ_cons, List.drop_succ_cons, Tree.forestAt_cons, Tree.forestAt_cons]
      simp only [Tree.cols, h2, Option.bind_some, h3, hqh]
      exact forestAt_litCapAux_D8 k p j rest h n hv' (by simp at hn; omega)

/-- L4.2d helper: the cut column of the literal cap. -/
theorem colAt_litCapAux_self_D8 (k p j : Nat) (ρ : List (Nat × Nat)) (X : Forest)
    (hv : (X.colAt ⟨ρ, j⟩).isSome) :
    (Closure.litCapAux k p ρ j X).colAt ⟨ρ, j⟩ =
      some (((X.colAt ⟨ρ, j⟩).getD []).take k ++ [(p, Tree.empty)]) := by
  have hf : (X.forestAt ρ).isSome := by
    unfold Tree.colAt at hv
    cases h : X.forestAt ρ with
    | none => rw [h] at hv; simp at hv
    | some _ => rfl
  have h1 := forestAt_litCapAux_D8 k p j ρ X ρ.length hf le_rfl
  rw [List.take_length, List.drop_length] at h1
  obtain ⟨Y, hY⟩ := Option.isSome_iff_exists.1 hf
  obtain ⟨cols⟩ := Y
  have hj : j < cols.length := by
    simp only [Tree.colAt, hY, Option.bind_some, Tree.cols] at hv
    simpa using hv
  simp only [Tree.colAt, h1, hY, Option.map_some, Option.bind_some, Closure.litCapAux, Tree.cols]
  rw [List.getElem?_append_right (by rw [List.length_take]; omega)]
  simp [List.length_take, Nat.min_eq_left hj.le, List.getD_eq_getElem?_getD]

/-- L4.2d helper: a containing column of the cut column in the literal cap: cut after the
containing entry, whose height is capped. -/
theorem colAt_litCapAux_container_D8 (k p j : Nat) (ρ : List (Nat × Nat)) (X : Forest)
    (hv : (X.forestAt ρ).isSome) {d : ColAddr} {i : Nat}
    (hd : (⟨d, i⟩ : EntryAddr).heightPath <+: ρ) :
    ∃ colX q h, X.colAt d = some colX ∧ colX[i]? = some (q, h) ∧
      (Closure.litCapAux k p ρ j X).colAt d =
        some (colX.take i ++ [(q, Closure.litCapAux k p (ρ.drop (d.path.length + 1)) j h)]) := by
  obtain ⟨tl, htl⟩ := hd
  have hρ : ρ = d.path ++ (d.col, i) :: tl := by
    rw [← htl, EntryAddr.heightPath]; simp
  have hn : ρ.take d.path.length = d.path := by rw [hρ]; simp
  have hdrop : ρ.drop d.path.length = (d.col, i) :: tl := by rw [hρ]; simp
  have hdrop' : ρ.drop (d.path.length + 1) = tl := by rw [hρ]; simp
  have h1 := forestAt_litCapAux_D8 k p j ρ X d.path.length hv (by rw [hρ]; simp)
  rw [hn, hdrop] at h1
  have hv' := hv
  rw [hρ, Tree.forestAt_append] at hv'
  obtain ⟨Y, hY⟩ : ∃ Y, X.forestAt d.path = some Y := by
    cases h : X.forestAt d.path with
    | none => rw [h] at hv'; simp at hv'
    | some Y => exact ⟨Y, rfl⟩
  rw [hY, Option.bind_some, Tree.forestAt_cons] at hv'
  obtain ⟨cols⟩ := Y
  obtain ⟨⟨q, h⟩, hqh⟩ : ∃ x, (cols[d.col]?).bind (·[i]?) = some x := by
    cases hx : (cols[d.col]?).bind (·[i]?) with
    | none => simp [Tree.cols, hx] at hv'
    | some x => exact ⟨x, rfl⟩
  obtain ⟨col, hcol, hei⟩ := Option.bind_eq_some_iff.1 hqh
  have hci : d.col < cols.length := (List.getElem?_eq_some_iff.1 hcol).1
  have hgd : cols.getD d.col [] = col := by simp [List.getD_eq_getElem?_getD, hcol]
  have hei' : i < col.length := (List.getElem?_eq_some_iff.1 hei).1
  refine ⟨col, q, h, by simp [Tree.colAt, hY, Tree.cols, hcol], hei, ?_⟩
  obtain ⟨-, -, h2, -, -, -⟩ := capStep_getElem_D8 cols d.col i (q, Closure.litCapAux k p tl j h)
    hci (by rw [hgd]; omega)
  rw [hdrop']
  simp only [Tree.colAt, h1, hY, Option.map_some, Option.bind_some, Closure.litCapAux, hgd, hei,
    Tree.cols]
  rw [hgd] at h2
  exact h2

/-- L4.2d helper: indexing a list cut after index `ci` with one new element there. -/
theorem getElem?_cutPut_D8 {β : Type} (l : List β) (ci : Nat) (x : β) (hci : ci ≤ l.length)
    (y : Nat) : (l.take ci ++ [x])[y]? =
      if y < ci then l[y]? else if y = ci then some x else none := by
  have hl : (l.take ci).length = ci := by rw [List.length_take]; omega
  split_ifs with h1 h2
  · rw [List.getElem?_append_left (by omega), List.getElem?_take_of_lt h1]
  · subst h2; rw [List.getElem?_append_right (by omega), hl]; simp
  · rw [List.getElem?_eq_none]; simp [hl]; omega

/-- L4.2d helper: a column of the literal cap that is neither the cut column nor one of its
containers is a column of `X`, unchanged. -/
theorem colAt_litCapAux_retained_D8 (k p j : Nat) : ∀ (ρ : List (Nat × Nat)) (X : Forest)
    (d : ColAddr), (X.colAt ⟨ρ, j⟩).isSome → k ≤ ((X.colAt ⟨ρ, j⟩).getD []).length →
    ((Closure.litCapAux k p ρ j X).colAt d).isSome → d ≠ ⟨ρ, j⟩ →
    (∀ i, ¬ (⟨d, i⟩ : EntryAddr).heightPath <+: ρ) →
    (Closure.litCapAux k p ρ j X).colAt d = X.colAt d
  | [], .node cols, d, hv, hk, hs, hne, _ => by
    have hj : j < cols.length := by simpa [Tree.colAt, Tree.forestAt, Tree.cols] using hv
    obtain ⟨col, hcol⟩ : ∃ col, cols[j]? = some col := ⟨cols[j], by simp [hj]⟩
    have hgd : cols.getD j [] = col := by simp [List.getD_eq_getElem?_getD, hcol]
    have hk' : k ≤ col.length := by
      simpa [Tree.colAt, Tree.forestAt, Tree.cols, hcol] using hk
    have hlit : Closure.litCapAux k p [] j (.node cols) =
        .node (cols.take j ++ [col.take k ++ [(p, Tree.empty)]]) := by
      simp [Closure.litCapAux, hcol]
    rw [hlit] at hs ⊢
    obtain ⟨P, dc⟩ := d
    cases P with
    | nil =>
      simp only [Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols,
        getElem?_cutPut_D8 cols j _ hj.le] at hs ⊢
      split_ifs at hs ⊢ with h1 h2
      · rfl
      · exact absurd (by rw [h2]) hne
      · simp at hs
    | cons ab P =>
      obtain ⟨a, b⟩ := ab
      simp only [Tree.colAt_cons, Tree.cols, getElem?_cutPut_D8 cols j _ hj.le] at hs ⊢
      split_ifs at hs ⊢ with h1 h2
      · rfl
      · subst h2
        rw [hcol]
        simp only [Option.bind_some, getElem?_cutPut_D8 col k _ hk'] at hs ⊢
        split_ifs at hs ⊢ with h3 h4
        · rfl
        · exfalso
          simp only [Option.bind_some] at hs
          cases P <;> simp [Tree.colAt, Tree.forestAt, Tree.empty, Tree.cols] at hs
        · simp at hs
      · simp at hs
  | (c0, e0) :: rest, .node cols, d, hv, hk, hs, hne, hnc => by
    rw [Tree.colAt_cons] at hv hk
    obtain ⟨⟨q, h⟩, hqh, hv'⟩ : ∃ x, (cols[c0]?).bind (·[e0]?) = some x ∧
        (x.2.colAt ⟨rest, j⟩).isSome := by
      cases hx : (cols[c0]?).bind (·[e0]?) with
      | none => simp [Tree.cols, hx] at hv
      | some x => simp only [Tree.cols, hx, Option.bind_some] at hv; exact ⟨x, rfl, hv⟩
    simp only [Tree.cols, hqh, Option.bind_some] at hk
    obtain ⟨col, hcol, hei⟩ := Option.bind_eq_some_iff.1 hqh
    have hci : c0 < cols.length := (List.getElem?_eq_some_iff.1 hcol).1
    have hgd : cols.getD c0 [] = col := by simp [List.getD_eq_getElem?_getD, hcol]
    have hei' : e0 < col.length := (List.getElem?_eq_some_iff.1 hei).1
    have hlit : Closure.litCapAux k p ((c0, e0) :: rest) j (.node cols) =
        .node (cols.take c0 ++ [col.take e0 ++ [(q, Closure.litCapAux k p rest j h)]]) := by
      simp only [Closure.litCapAux, hgd, hei]
    rw [hlit] at hs ⊢
    obtain ⟨P, dc⟩ := d
    cases P with
    | nil =>
      simp only [Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols,
        getElem?_cutPut_D8 cols c0 _ hci.le] at hs ⊢
      split_ifs at hs ⊢ with h1 h2
      · rfl
      · exfalso; subst h2
        exact hnc e0 ⟨rest, by simp [EntryAddr.heightPath]⟩
      · simp at hs
    | cons ab P =>
      obtain ⟨a, b⟩ := ab
      simp only [Tree.colAt_cons, Tree.cols, getElem?_cutPut_D8 cols c0 _ hci.le] at hs ⊢
      split_ifs at hs ⊢ with h1 h2
      · rfl
      · subst h2
        rw [hcol]
        simp only [Option.bind_some, getElem?_cutPut_D8 col e0 _ hei'.le] at hs ⊢
        split_ifs at hs ⊢ with h3 h4
        · rfl
        · subst h4
          rw [hei]
          simp only [Option.bind_some] at hs ⊢
          refine colAt_litCapAux_retained_D8 k p j rest h ⟨P, dc⟩ hv' hk hs ?_ ?_
          · intro he; apply hne; simp only [ColAddr.mk.injEq] at he ⊢
            exact ⟨by rw [he.1], he.2⟩
          · intro i hi
            apply hnc i
            obtain ⟨tl, htl⟩ := hi
            exact ⟨tl, by simp [EntryAddr.heightPath] at htl ⊢; exact htl⟩
        · simp at hs
      · simp at hs

/-- L4.2d helper: the forests of the literal cap along the cap path: the route step at each
level is the cap path's step, and the last level ends with the closing entry `(p, ∅)`. -/
theorem litCapAux_level_D8 (k p j : Nat) (ρ : List (Nat × Nat)) (X : Forest)
    (hv : (X.colAt ⟨ρ, j⟩).isSome) (hk : k ≤ ((X.colAt ⟨ρ, j⟩).getD []).length) (n : Nat)
    (hn : n ≤ ρ.length) :
    ∃ F, (Closure.litCapAux k p ρ j X).forestAt (ρ.take n) = some F ∧
      (∀ s, ρ[n]? = some s → F.cols.length = s.1 + 1 ∧ F.lastStep? = some s) ∧
      (n = ρ.length → F.cols.length = j + 1 ∧ F.lastStep? = some (j, k) ∧
        F.forestAt [(j, k)] = some Tree.empty) := by
  have hf : (X.forestAt ρ).isSome := by
    unfold Tree.colAt at hv
    cases h : X.forestAt ρ with
    | none => rw [h] at hv; simp at hv
    | some _ => rfl
  have h1 := forestAt_litCapAux_D8 k p j ρ X n hf hn
  have hρ : ρ = ρ.take n ++ ρ.drop n := (List.take_append_drop n ρ).symm
  obtain ⟨Y, hY⟩ : ∃ Y, X.forestAt (ρ.take n) = some Y := by
    have := hf; rw [hρ, Tree.forestAt_append] at this
    cases h : X.forestAt (ρ.take n) with
    | none => rw [h] at this; simp at this
    | some Y => exact ⟨Y, rfl⟩
  rw [hY, Option.map_some] at h1
  refine ⟨_, h1, ?_, ?_⟩
  · intro s hs
    have hd : ρ.drop n = s :: ρ.drop (n + 1) := by
      rw [List.drop_eq_getElem_cons (List.getElem?_eq_some_iff.1 hs).1]
      congr; exact (List.getElem?_eq_some_iff.1 hs).2
    obtain ⟨ci, ei⟩ := s
    have hv2 := hv
    rw [Tree.colAt, hρ, Tree.forestAt_append, hY, Option.bind_some, hd, Tree.forestAt_cons] at hv2
    obtain ⟨cols⟩ := Y
    obtain ⟨⟨q, h⟩, hqh⟩ : ∃ x, (cols[ci]?).bind (·[ei]?) = some x := by
      cases hx : (cols[ci]?).bind (·[ei]?) with
      | none => simp [Tree.cols, hx] at hv2
      | some x => exact ⟨x, rfl⟩
    obtain ⟨col, hcol, hei⟩ := Option.bind_eq_some_iff.1 hqh
    have hci : ci < cols.length := (List.getElem?_eq_some_iff.1 hcol).1
    have hgd : cols.getD ci [] = col := by simp [List.getD_eq_getElem?_getD, hcol]
    have hei' : ei < col.length := (List.getElem?_eq_some_iff.1 hei).1
    rw [hd]
    simp only [Closure.litCapAux, hgd, hei]
    have hl : (cols.take ci).length = ci := by rw [List.length_take]; omega
    have hl2 : (col.take ei).length = ei := by rw [List.length_take]; omega
    refine ⟨by simp only [Tree.cols, List.length_append, hl, List.length_singleton], ?_⟩
    simp [Tree.lastStep?, Tree.cols, hl, hl2]
  · intro hnl
    subst hnl
    rw [List.drop_length]
    have hv2 := hv
    rw [List.take_length] at hY
    unfold Tree.colAt at hv2 hk
    rw [hY, Option.bind_some] at hv2 hk
    obtain ⟨cols⟩ := Y
    obtain ⟨col, hcol⟩ : ∃ col, cols[j]? = some col := Option.isSome_iff_exists.1 hv2
    have hj : j < cols.length := (List.getElem?_eq_some_iff.1 hcol).1
    simp only [Tree.cols, hcol, Option.getD_some] at hk
    have hl : (cols.take j).length = j := by rw [List.length_take]; omega
    have hl2 : (col.take k).length = k := by rw [List.length_take]; omega
    have hlit : Closure.litCapAux k p [] j (.node cols) =
        .node (cols.take j ++ [col.take k ++ [(p, Tree.empty)]]) := by
      simp [Closure.litCapAux, hcol]
    rw [hlit]
    refine ⟨by simp only [Tree.cols, List.length_append, hl, List.length_singleton], ?_, ?_⟩
    · simp [Tree.lastStep?, Tree.cols, hl, hl2]
    · rw [Tree.forestAt_cons]
      simp only [Tree.cols, getElem?_cutPut_D8 cols j _ hj.le, lt_irrefl, if_false, if_true,
        Option.bind_some, getElem?_cutPut_D8 col k _ hk]
      rfl

/-- L4.2d helper: the literal cap at a column of `E` is `litCapAux` along its path. -/
theorem litCap_eq_D8 {E : Forest} {c : ColAddr} (hc : c ∈ E.colAddrs) (k p : Nat) :
    Closure.litCap E c k p = Closure.litCapAux k p c.path c.col E := by
  show Closure.litCapBody E c k p = _
  rw [Closure.litCapBody, if_pos ((Tree.mem_colAddrs_iff E c).1 hc)]

/-- L4.2d helper: `parents` length is the column length. -/
theorem parents_length_D8 (E : Forest) (c : ColAddr) :
    (parents E c).length = ((E.colAt c).getD []).length := by simp [parents]

/-- L4.2d helper (R11 shape): the route columns of the literal cap are the cut column and its
containing columns. -/
theorem routeCols_litCap_D8 {E : Forest} {c : ColAddr} {k p : Nat} (hc : c ∈ E.colAddrs)
    (hk : k ≤ (parents E c).length) (d : ColAddr) :
    d ∈ routeCols (Closure.litCap E c k p) ↔
      d = c ∨ ∃ i, (⟨d, i⟩ : EntryAddr).heightPath <+: c.path := by
  have hv : (E.colAt ⟨c.path, c.col⟩).isSome := (Tree.mem_colAddrs_iff E c).1 hc
  have hk' : k ≤ ((E.colAt ⟨c.path, c.col⟩).getD []).length := by
    rwa [parents_length_D8] at hk
  have hlev := litCapAux_level_D8 k p c.col c.path E hv hk'
  rw [litCap_eq_D8 hc, Scan.mem_routeCols_iff]
  constructor
  · rintro ⟨hr, F, hF, hFl⟩
    -- the route path of the cap is a prefix of the cap path
    have key : ∀ m, m ≤ d.path.length → d.path.take m = c.path.take m ∧ m ≤ c.path.length := by
      intro m
      induction m with
      | zero => intro _; simp
      | succ m ih =>
        intro hm
        obtain ⟨h1, h2⟩ := ih (by omega)
        obtain ⟨G, hG, hGl⟩ := hr m (by omega)
        obtain ⟨F', hF', hs, hlast⟩ := hlev m h2
        rw [h1, hF'] at hG
        cases hG
        rcases Nat.lt_or_ge m c.path.length with hmc | hmc
        · obtain ⟨s, hs'⟩ : ∃ s, c.path[m]? = some s := ⟨c.path[m], by simp [hmc]⟩
          have := (hs s hs').2
          rw [this] at hGl
          refine ⟨?_, by omega⟩
          rw [List.take_add_one, List.take_add_one, h1, hs', ← hGl]
        · exfalso
          have hmc' : m = c.path.length := by omega
          obtain ⟨-, hl2, hl3⟩ := hlast hmc'
          rw [hl2] at hGl
          have hdm : d.path[m]? = some (c.col, k) := hGl.symm
          have htk : d.path.take (m + 1) = c.path ++ [(c.col, k)] := by
            rw [List.take_add_one, h1, hdm, hmc', List.take_length]; rfl
          have hE : (Closure.litCapAux k p c.path c.col E).forestAt (d.path.take (m + 1)) =
              some Tree.empty := by
            rw [htk, Tree.forestAt_append]
            rw [hmc', List.take_length] at hF'
            rw [hF', Option.bind_some, hl3]
          rcases Nat.lt_or_ge (m + 1) d.path.length with hm1 | hm1
          · obtain ⟨G, hG, hGl⟩ := hr (m + 1) hm1
            rw [hE] at hG; cases hG
            have : d.path[m + 1]? ≠ none := by simp; omega
            rw [← hGl] at this
            exact this (by simp [Tree.lastStep?, Tree.empty, Tree.cols])
          · have hdp : d.path.take (m + 1) = d.path := List.take_of_length_le hm1
            rw [hdp, hF] at hE; cases hE
            simp [Tree.empty, Tree.cols] at hFl
    obtain ⟨h1, h2⟩ := key d.path.length le_rfl
    rw [List.take_length] at h1
    obtain ⟨F', hF', hs, hlast⟩ := hlev d.path.length h2
    rw [← h1, hF] at hF'
    cases hF'
    rcases Nat.lt_or_ge d.path.length c.path.length with hlt | hge
    · obtain ⟨s, hs'⟩ : ∃ s, c.path[d.path.length]? = some s := ⟨_, List.getElem?_eq_getElem hlt⟩
      have hcol := (hs s hs').1
      right
      refine ⟨s.2, c.path.drop (d.path.length + 1), ?_⟩
      have hdc : d.col = s.1 := by omega
      rw [EntryAddr.heightPath, h1, hdc, List.append_assoc, List.singleton_append]
      conv_rhs => rw [← List.take_append_drop d.path.length c.path]
      rw [List.drop_eq_getElem_cons hlt, (List.getElem?_eq_some_iff.1 hs').2]
      simp [List.length_take, Nat.min_eq_left h2]
    · have hdl : d.path.length = c.path.length := by omega
      obtain ⟨hcol, -⟩ := hlast hdl
      left
      have hp : d.path = c.path := by rw [h1, hdl, List.take_length]
      cases d; cases c
      simp only at hp hcol hFl ⊢
      subst hp
      simp only [ColAddr.mk.injEq, true_and]
      omega
  · intro hd
    -- the levels below the column's own level are route steps
    have hroute : ∀ n, n ≤ c.path.length →
        Scan.IsRoutePath (Closure.litCapAux k p c.path c.col E) (c.path.take n) := by
      intro n hn m hm
      rw [List.length_take] at hm
      obtain ⟨F', hF', hs, -⟩ := hlev m (by omega)
      refine ⟨F', by rw [List.take_take, Nat.min_eq_left (by omega)]; exact hF', ?_⟩
      have hmc : m < c.path.length := by omega
      rw [(hs _ (List.getElem?_eq_getElem hmc)).2, List.getElem?_take_of_lt (by omega),
        List.getElem?_eq_getElem hmc]
    rcases hd with rfl | ⟨i, tl, htl⟩
    · obtain ⟨F', hF', -, hlast⟩ := hlev d.path.length le_rfl
      rw [List.take_length] at hF'
      exact ⟨by have := hroute d.path.length le_rfl; rwa [List.take_length] at this, F', hF',
        (hlast rfl).1⟩
    · have hρ : c.path = d.path ++ (d.col, i) :: tl := by
        rw [← htl, EntryAddr.heightPath]; simp
      have hn : c.path.take d.path.length = d.path := by rw [hρ]; simp
      have hnl : d.path.length < c.path.length := by rw [hρ]; simp
      obtain ⟨F', hF', hs, -⟩ := hlev d.path.length hnl.le
      have hs' : c.path[d.path.length]? = some (d.col, i) := by rw [hρ]; simp
      rw [hn] at hF'
      refine ⟨by have := hroute d.path.length hnl.le; rwa [hn] at this, F', hF', (hs _ hs').1⟩

/-- L4.2d helper: the first entries of the columns of a literal cap: the same first labels as
in `X`, except a cut column cut at `0`, whose first label is `p`. -/
theorem litCapAux_firstLabels_D8 (k p j a : Nat) (ρ : List (Nat × Nat)) (X : Forest)
    (hv : (X.colAt ⟨ρ, j⟩).isSome)
    (hX : ∀ col ∈ X.cols, ∃ q H rest, col = (q, H) :: rest ∧ a ≤ q)
    (hp : ρ = [] → k = 0 → a ≤ p) :
    ∀ col ∈ (Closure.litCapAux k p ρ j X).cols, ∃ q H rest, col = (q, H) :: rest ∧ a ≤ q := by
  obtain ⟨cols⟩ := X
  cases ρ with
  | nil =>
    obtain ⟨col, hcol⟩ : ∃ col, cols[j]? = some col := by
      simpa [Tree.colAt, Tree.forestAt, Tree.cols, Option.isSome_iff_exists] using hv
    have hlit : Closure.litCapAux k p [] j (.node cols) =
        .node (cols.take j ++ [col.take k ++ [(p, Tree.empty)]]) := by
      simp [Closure.litCapAux, hcol]
    rw [hlit]
    intro col' hcol'
    simp only [Tree.cols, List.mem_append, List.mem_singleton] at hcol' hX
    rcases hcol' with h1 | rfl
    · exact hX col' (List.mem_of_mem_take h1)
    · cases k with
      | zero => exact ⟨p, Tree.empty, [], by simp, hp rfl rfl⟩
      | succ k =>
        obtain ⟨q, H, rest, rfl, hq⟩ := hX col (List.mem_of_getElem? hcol)
        exact ⟨q, H, rest.take k ++ [(p, Tree.empty)], by simp, hq⟩
  | cons s rest =>
    obtain ⟨ci, ei⟩ := s
    rw [Tree.colAt_cons] at hv
    obtain ⟨⟨q, h⟩, hqh⟩ : ∃ x, (cols[ci]?).bind (·[ei]?) = some x := by
      cases hx : (cols[ci]?).bind (·[ei]?) with
      | none => simp [Tree.cols, hx] at hv
      | some x => exact ⟨x, rfl⟩
    obtain ⟨col, hcol, hei⟩ := Option.bind_eq_some_iff.1 hqh
    have hgd : cols.getD ci [] = col := by simp [List.getD_eq_getElem?_getD, hcol]
    have hlit : Closure.litCapAux k p ((ci, ei) :: rest) j (.node cols) =
        .node (cols.take ci ++ [col.take ei ++ [(q, Closure.litCapAux k p rest j h)]]) := by
      simp only [Closure.litCapAux, hgd, hei]
    rw [hlit]
    intro col' hcol'
    simp only [Tree.cols, List.mem_append, List.mem_singleton] at hcol' hX
    rcases hcol' with h1 | rfl
    · exact hX col' (List.mem_of_mem_take h1)
    · obtain ⟨q0, H0, rest0, hc0, hq0⟩ := hX col (List.mem_of_getElem? hcol)
      subst hc0
      cases ei with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq, Prod.mk.injEq] at hei
        obtain ⟨rfl, -⟩ := hei
        exact ⟨q0, Closure.litCapAux k p rest j h, [], by simp, hq0⟩
      | succ ei => exact ⟨q0, H0, rest0.take ei ++ [(q, Closure.litCapAux k p rest j h)], by simp, hq0⟩

/-- L4.2d helper (step 4): I for the literal cap. -/
theorem litCap_condI_D8 {E : Forest} (hI : CondI E) {c : ColAddr} {k p : Nat}
    (hc : c ∈ E.colAddrs) (hup : Closure.IsUpward E c k p) :
    CondI (Closure.litCap E c k p) := by
  have hk := upward_cut_le_D8 hup
  obtain ⟨-, -, hsame, hcl, -⟩ := Closure.litCap_spec (p := p) hc hk
  intro e he q h hqh hne col hcol
  by_cases hec : e = ⟨c, k⟩
  · subst hec; rw [hcl] at hqh; cases hqh; exact absurd rfl hne
  by_cases hcont : e.heightPath <+: c.path
  · have hv : (E.forestAt c.path).isSome := by
      have := (Tree.mem_colAddrs_iff E c).1 hc
      unfold Tree.colAt at this
      cases h : E.forestAt c.path with
      | none => rw [h] at this; simp at this
      | some _ => rfl
    obtain ⟨colX, q', h0, hX, hq', hK⟩ :=
      colAt_litCapAux_container_D8 k p c.col c.path E hv (d := e.col) (i := e.idx) hcont
    rw [← litCap_eq_D8 hc] at hK
    have hent : (Closure.litCap E c k p).entryAt e = some (q', Closure.litCapAux k p
        (c.path.drop (e.col.path.length + 1)) c.col h0) := by
      have hl : (colX.take e.idx).length = e.idx := by
        rw [List.length_take]; have := (List.getElem?_eq_some_iff.1 hq').1; omega
      simp only [Tree.entryAt, hK, Option.bind_some]
      rw [List.getElem?_append_right (by omega), hl]; simp
    rw [hent] at hqh
    simp only [Option.some.injEq, Prod.mk.injEq] at hqh
    obtain ⟨rfl, rfl⟩ := hqh
    clear hne
    have hEe : E.entryAt e = some (q', h0) := by simp [Tree.entryAt, hX, hq']
    have heE : e ∈ E.entryAddrs := (Tree.mem_entryAddrs_iff E e).2 (by rw [hEe]; rfl)
    obtain ⟨tl, htl⟩ := hcont
    have hρ : c.path = e.heightPath ++ tl := htl.symm
    have hdrop : c.path.drop (e.col.path.length + 1) = tl := by
      rw [hρ, EntryAddr.heightPath]; simp
    rw [hdrop] at hcol
    have hcolE : (E.colAt c).isSome := (Tree.mem_colAddrs_iff E c).1 hc
    have hv' : (h0.colAt ⟨tl, c.col⟩).isSome := by
      have : E.colAt c = h0.colAt ⟨tl, c.col⟩ := by
        rw [Tree.colAt, hρ, Tree.forestAt_append, Tree.forestAt_heightPath, Tree.heightAt, hEe]
        rfl
      rwa [← this]
    have hh0 : h0 ≠ Tree.empty := by
      intro h0e; subst h0e
      cases tl <;> simp [Tree.colAt, Tree.forestAt, Tree.empty, Tree.cols] at hv'
    refine litCapAux_firstLabels_D8 k p c.col _ tl h0 hv' (hI e heE q' h0 hEe hh0) ?_ col hcol
    intro htl0 hk0
    subst htl0 hk0
    -- `c` is a column of `h0`: its first parent is at least the host and below `p`
    obtain ⟨colc, hcolc⟩ := Option.isSome_iff_exists.1 hv'
    have hmem : colc ∈ h0.cols := by
      simp only [Tree.colAt, Tree.forestAt, Option.bind_some] at hcolc
      exact List.mem_of_getElem? hcolc
    obtain ⟨q0, H0, rest0, rfl, hq0⟩ := hI e heE q' h0 hEe hh0 colc hmem
    have hEc : E.colAt c = some ((q0, H0) :: rest0) := by
      rw [Tree.colAt, hρ, Tree.forestAt_append, Tree.forestAt_heightPath, Tree.heightAt, hEe]
      simpa [Tree.colAt] using hcolc
    unfold Closure.IsUpward at hup
    simp only [hEc, List.getElem?_cons_zero] at hup
    omega
  · rw [hsame e he hec hcont] at hqh
    exact hI e ((Tree.mem_entryAddrs_iff E e).2 (by rw [hqh]; rfl)) q h hqh hne col hcol

/-- L4.2d helper: the columns on the visible stack of a column of a tree are columns of it. -/
theorem mem_colAddrs_of_onStack_D8 {α : Type} {T : Tree α} {o o' : ColAddr}
    (ho : o ∈ T.colAddrs) (hs : o.OnStack o') : o' ∈ T.colAddrs := by
  rw [Tree.mem_colAddrs_iff] at ho ⊢
  unfold Tree.colAt at ho ⊢
  rcases hs with ⟨n, ck, ik, hn, hp, hle⟩ | ⟨hp, hlt⟩
  · have hsplit : o.path = o.path.take n ++ (ck, ik) :: o.path.drop (n + 1) := by
      obtain ⟨hlt, heq⟩ := List.getElem?_eq_some_iff.1 hn
      rw [← heq, ← List.drop_eq_getElem_cons hlt, List.take_append_drop]
    rw [hsplit, Tree.forestAt_append] at ho
    rw [hp]
    cases hF : T.forestAt (o.path.take n) with
    | none => rw [hF] at ho; simp at ho
    | some F =>
      rw [hF, Option.bind_some, Tree.forestAt_cons] at ho
      simp only [Option.bind_some]
      have : ck < F.cols.length := by
        cases h : F.cols[ck]? with
        | none => rw [h] at ho; simp at ho
        | some _ => exact (List.getElem?_eq_some_iff.1 h).1
      simpa using (show o'.col < F.cols.length by omega)
  · rw [hp]
    cases hF : T.forestAt o.path with
    | none => rw [hF] at ho; simp at ho
    | some F =>
      rw [hF, Option.bind_some] at ho
      simp only [Option.bind_some]
      have : o.col < F.cols.length := by simpa using ho
      simpa using (show o'.col < F.cols.length by omega)

section LitCapCols
variable {E : Forest} {c : ColAddr} {k p : Nat}

/-- L4.2d helper (R11 shape): the cut column of the literal cap. -/
theorem litCap_colAt_self_D8 (hc : c ∈ E.colAddrs) :
    (Closure.litCap E c k p).colAt c = some (((E.colAt c).getD []).take k ++ [(p, Tree.empty)]) := by
  rw [litCap_eq_D8 hc]
  exact colAt_litCapAux_self_D8 k p c.col c.path E ((Tree.mem_colAddrs_iff E c).1 hc)

theorem forestAt_isSome_of_col_D8 {α : Type} {T : Tree α} {c : ColAddr} (hc : c ∈ T.colAddrs) :
    (T.forestAt c.path).isSome := by
  have := (Tree.mem_colAddrs_iff T c).1 hc
  unfold Tree.colAt at this
  cases h : T.forestAt c.path with
  | none => rw [h] at this; simp at this
  | some _ => rfl

/-- L4.2d helper (R11 shape): a containing column of the cut column. -/
theorem litCap_colAt_container_D8 (hc : c ∈ E.colAddrs) {d : ColAddr} {i : Nat}
    (hd : (⟨d, i⟩ : EntryAddr).heightPath <+: c.path) :
    ∃ colX q h h', E.colAt d = some colX ∧ colX[i]? = some (q, h) ∧
      (Closure.litCap E c k p).colAt d = some (colX.take i ++ [(q, h')]) := by
  obtain ⟨colX, q, h, h1, h2, h3⟩ :=
    colAt_litCapAux_container_D8 k p c.col c.path E (forestAt_isSome_of_col_D8 hc) hd
  exact ⟨colX, q, h, _, h1, h2, by rw [litCap_eq_D8 hc]; exact h3⟩

/-- L4.2d helper (R11 shape): the other columns of the literal cap are columns of `E`. -/
theorem litCap_colAt_retained_D8 (hc : c ∈ E.colAddrs) (hk : k ≤ (parents E c).length)
    {d : ColAddr} (hs : ((Closure.litCap E c k p).colAt d).isSome) (hne : d ≠ c)
    (hnc : ∀ i, ¬ (⟨d, i⟩ : EntryAddr).heightPath <+: c.path) :
    (Closure.litCap E c k p).colAt d = E.colAt d := by
  rw [litCap_eq_D8 hc] at hs ⊢
  exact colAt_litCapAux_retained_D8 k p c.col c.path E d ((Tree.mem_colAddrs_iff E c).1 hc)
    (by rwa [parents_length_D8] at hk) hs hne hnc

/-- L4.2d helper: nothing lies inside the closing entry `(p, ∅)`. -/
theorem litCap_not_inside_closing_D8 (hc : c ∈ E.colAddrs) (hk : k ≤ (parents E c).length)
    {d : ColAddr} (hs : ((Closure.litCap E c k p).colAt d).isSome) :
    ¬ (⟨c, k⟩ : EntryAddr).heightPath <+: d.path := by
  rintro ⟨tl, htl⟩
  obtain ⟨F, hF, -, hlast⟩ := litCapAux_level_D8 k p c.col c.path E
    ((Tree.mem_colAddrs_iff E c).1 hc) (by rwa [parents_length_D8] at hk) c.path.length le_rfl
  obtain ⟨-, -, h3⟩ := hlast rfl
  rw [List.take_length] at hF
  rw [litCap_eq_D8 hc] at hs
  unfold Tree.colAt at hs
  rw [← htl, EntryAddr.heightPath, List.append_assoc, Tree.forestAt_append, hF, Option.bind_some,
    Tree.forestAt_append, h3, Option.bind_some] at hs
  cases tl with
  | nil => simp [Tree.forestAt, Tree.empty, Tree.cols] at hs
  | cons s tl =>
    obtain ⟨a, b⟩ := s
    simp [Tree.forestAt_cons, Tree.empty, Tree.cols] at hs

/-- L4.2d helper: every column of the literal cap is a column of `E`. -/
theorem litCap_colAddrs_sub_D8 (hc : c ∈ E.colAddrs) (hk : k ≤ (parents E c).length)
    {d : ColAddr} (hs : d ∈ (Closure.litCap E c k p).colAddrs) : d ∈ E.colAddrs := by
  rw [Tree.mem_colAddrs_iff] at hs
  by_cases hdc : d = c
  · subst hdc; exact hc
  by_cases hcont : ∃ i, (⟨d, i⟩ : EntryAddr).heightPath <+: c.path
  · obtain ⟨i, hi⟩ := hcont
    obtain ⟨colX, -, -, -, h1, -, -⟩ := litCap_colAt_container_D8 (k := k) (p := p) hc hi
    rw [Tree.mem_colAddrs_iff, h1]; rfl
  · simp only [not_exists] at hcont
    rw [Tree.mem_colAddrs_iff, ← litCap_colAt_retained_D8 hc hk hs hdc hcont]
    exact hs

end LitCapCols

/-- L4.2d helper (R7 with a truncated capped column): a column cut after entry `u` and capped
there answers like the uncut column, under the barrier at an entry `v ≤ u`. -/
theorem resp_trunc_D8 {E K : Forest} {sel : List ColAddr} {o : ColAddr} {colE : Column}
    {u v : Nat} {x : Nat × Forest} (hsel : o ∈ sel) (hE : E.colAt o = some colE)
    (hK : K.colAt o = some (colE.take u ++ [x])) (hu : u ≤ colE.length) (hvu : v ≤ u)
    (hv : v < colE.length) (hlab : v = u → (colE[u]?).map Prod.fst = some x.1)
    {W : List (WithTop Key)} (hW : W.Pairwise fun x y => y ≤ x) (hT : ∀ y ∈ W, y ≠ ⊤)
    (hbar : W < cutQuery (actualKeys E o) (v + 1)) :
    resp K (capKeys K sel) o W = resp E (actualKeys E) o W := by
  set f : Nat × Forest → WithTop Key := fun y => ((relKey (o.num 0) y.2 : Key) : WithTop Key)
  have hksE : actualKeys E o = colE.map f := by simp [actualKeys, hE, f]
  have hksK : capKeys K sel o = (actualKeys E o).take u ++ [⊤] := by
    simp only [capKeys, hsel, if_true, actualKeys, hK, Option.getD_some, List.map_append,
      List.map_cons, List.map_nil, List.dropLast_concat, List.getLast?_concat, Option.map_some,
      Option.toList_some, hE, List.map_take]
  have hlen : v < (actualKeys E o).length := by rw [hksE, List.length_map]; exact hv
  obtain ⟨hc1, hc2⟩ := cursor_cappedAt (actualKeys E o) W v hlen hW hT hbar
  have hcur : cursor (capKeys K sel o) W = cursor (actualKeys E o) W := by
    rw [hksK]
    rcases Nat.lt_or_ge v u with hvu' | hvu'
    · have hlt : cursor ((actualKeys E o).take u) W < ((actualKeys E o).take u).length := by
        rw [cursor_take, List.length_take]
        have : u ≤ (actualKeys E o).length := by rw [hksE, List.length_map]; exact hu
        omega
      rw [cursor_append_of_lt _ hlt, cursor_take]
      omega
    · have : v = u := by omega
      subst this
      exact hc2.symm
  simp only [resp, hcur, hK, hE, Option.getD_some]
  rcases Nat.lt_or_ge (cursor (actualKeys E o) W) u with hlt | hge
  · rw [List.getElem?_append_left (by rw [List.length_take]; omega), List.getElem?_take_of_lt hlt]
  · have hcu : cursor (actualKeys E o) W = u := by omega
    have hvu' : v = u := by omega
    rw [hcu, List.getElem?_append_right (by rw [List.length_take]; omega)]
    simp only [List.length_take, Nat.min_eq_left hu, Nat.sub_self, List.getElem?_cons_zero,
      Option.map_some]
    exact (hlab hvu').symm

/-- L4.2d helper: actual cut queries contain no `⊤`. -/
theorem cutQuery_actualKeys_ne_top_D8 (E : Forest) (o : ColAddr) (e : Nat) :
    ∀ y ∈ cutQuery (actualKeys E o) e, y ≠ ⊤ := by
  intro y hy
  have h1 := (nu_sublist _).subset hy
  have h2 := List.mem_of_mem_take h1
  simp only [actualKeys, List.mem_map] at h2
  obtain ⟨_, -, rfl⟩ := h2
  exact WithTop.coe_ne_top

/-- L4.2d helper: the decorated keys of a truncated route column. -/
theorem capKeys_trunc_D8 {E K : Forest} {sel : List ColAddr} {o : ColAddr} {colE : Column}
    {u : Nat} {x : Nat × Forest} (hsel : o ∈ sel) (hE : E.colAt o = some colE)
    (hK : K.colAt o = some (colE.take u ++ [x])) :
    capKeys K sel o = (actualKeys E o).take u ++ [⊤] := by
  simp only [capKeys, hsel, if_true, actualKeys, hK, Option.getD_some, List.map_append,
    List.map_cons, List.map_nil, List.dropLast_concat, List.getLast?_concat, Option.map_some,
    Option.toList_some, hE, List.map_take]

/-- L4.2d helper: the A-test data of a truncated route column agree with those of `E` up to its
last entry. -/
theorem trunc_test_D8 {E K : Forest} {sel : List ColAddr} {o : ColAddr} {colE : Column}
    {u : Nat} {x : Nat × Forest} (hsel : o ∈ sel) (hE : E.colAt o = some colE)
    (hK : K.colAt o = some (colE.take u ++ [x])) (hu : u ≤ colE.length) {i q : Nat}
    (hq : (parents K o)[i]? = some q) :
    i ≤ u ∧ cutQuery (capKeys K sel o) i = cutQuery (actualKeys E o) i ∧
      cutStart K o i = cutStart E o i ∧ (i < u → (parents E o)[i]? = some q) ∧
      (i = u → q = x.1) := by
  have hpK : parents K o = (colE.take u).map Prod.fst ++ [x.1] := by
    simp [parents, hK]
  have hpE : parents E o = colE.map Prod.fst := by simp [parents, hE]
  have hlt : (colE.take u).length = u := by rw [List.length_take]; omega
  have hi : i ≤ u := by
    have := (List.getElem?_eq_some_iff.1 hq).1
    rw [hpK] at this; simp at this; omega
  have hpre : ∀ i' < u, (parents K o)[i']? = (parents E o)[i']? := by
    intro i' hi'
    rw [hpK, hpE, List.getElem?_append_left (by simp; omega), List.getElem?_map,
      List.getElem?_map, List.getElem?_take_of_lt hi']
  refine ⟨hi, ?_, ?_, fun h => by rw [← hpre i h]; exact hq, fun h => ?_⟩
  · rw [capKeys_trunc_D8 hsel hE hK, cutQuery, cutQuery,
      List.take_append_of_le_length (by rw [List.length_take, actualKeys, hE]; simp; omega),
      List.take_take, Nat.min_eq_left hi]
  · show (if i = 0 then o.num 0 - 1 else ((parents K o)[i - 1]?).getD 0) =
      (if i = 0 then o.num 0 - 1 else ((parents E o)[i - 1]?).getD 0)
    split_ifs with h0
    · rfl
    · rw [hpre (i - 1) (by omega)]
  · subst h
    rw [hpK, List.getElem?_append_right (by simp only [List.length_map, hlt]; omega), List.length_map, hlt,
      Nat.sub_self] at hq
    simpa using hq.symm

section LitCapA
variable {E : Forest} {c : ColAddr} {k p : Nat}

/-- L4.2d helper (step 7, the edge step): along an actual cut chain of a column of the literal
cap, its decorated responses are the actual responses of `E` (R7, R8, R11). -/
theorem litCap_resp_eq_D8 (hE : InL E) (hc : c ∈ E.colAddrs) (hk : k ≤ (parents E c).length)
    {o : ColAddr} (ho : o ∈ (Closure.litCap E c k p).colAddrs) {e : Nat}
    (he : e ≤ (parents E o).length) {y : Nat}
    (hy : Path E (actualKeys E) o (cutQuery (actualKeys E o) e) (cutStart E o e) y)
    {o' : ColAddr} (ho' : o.resolve 0 y = some o') :
    resp (Closure.litCap E c k p)
        (capKeys (Closure.litCap E c k p) (routeCols (Closure.litCap E c k p))) o'
        (cutQuery (actualKeys E o) e) =
      resp E (actualKeys E) o' (cutQuery (actualKeys E o) e) := by
  set K := Closure.litCap E c k p
  have hoE : o ∈ E.colAddrs := litCap_colAddrs_sub_D8 hc hk ho
  have ho'K : o' ∈ K.colAddrs :=
    mem_colAddrs_of_onStack_D8 ho ((ColAddr.resolve_spec 0 o o' y).1 ho').1
  have hW := cutQuery_noninc (actualKeys E o) e
  have hT := cutQuery_actualKeys_ne_top_D8 E o e
  by_cases hr : o' ∈ routeCols K
  · obtain ⟨v, hvK, hvc⟩ := routeCols_visible ho hr ho'
    have hcont : o'.container o = some ⟨o', v⟩ := (ColAddr.container_spec o' o _).2 ⟨rfl, hvc⟩
    have hbar : cutQuery (actualKeys E o) e < cutQuery (actualKeys E o') (v + 1) :=
      cut_barrier_read hE hoE he hy ho' hcont
    have hvl : v < ((K.colAt o').getD []).length := idx_lt_of_mem_entryAddrs hvK
    rcases (routeCols_litCap_D8 hc hk o').1 hr with rfl | ⟨i, hi⟩
    · have hKc := litCap_colAt_self_D8 (k := k) (p := p) hc
      obtain ⟨colE, hcolE⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff E _).1 hc)
      rw [hcolE, Option.getD_some] at hKc
      have hkl : k ≤ colE.length := by rw [parents_length_D8, hcolE] at hk; simpa using hk
      rw [hKc, Option.getD_some, List.length_append, List.length_take, Nat.min_eq_left hkl,
        List.length_singleton] at hvl
      have hvk : v ≠ k := by
        rintro rfl
        exact litCap_not_inside_closing_D8 hc hk ((Tree.mem_colAddrs_iff _ _).1 ho) hvc
      exact resp_trunc_D8 hr hcolE hKc hkl (by omega) (by omega) (fun h => absurd h hvk) hW hT
        hbar
    · obtain ⟨colX, q, h, h', hX, hq, hK⟩ := litCap_colAt_container_D8 (k := k) (p := p) hc hi
      have hil : i < colX.length := (List.getElem?_eq_some_iff.1 hq).1
      rw [hK, Option.getD_some, List.length_append, List.length_take, Nat.min_eq_left hil.le,
        List.length_singleton] at hvl
      exact resp_trunc_D8 hr hX hK hil.le (by omega) (by omega)
        (fun h0 => by subst h0; rw [hq]; rfl) hW hT hbar
  · have hne : o' ≠ c := fun h => hr ((routeCols_litCap_D8 hc hk o').2 (Or.inl h))
    have hnc : ∀ i, ¬ (⟨o', i⟩ : EntryAddr).heightPath <+: c.path :=
      fun i h => hr ((routeCols_litCap_D8 hc hk o').2 (Or.inr ⟨i, h⟩))
    have hret : K.colAt o' = E.colAt o' :=
      litCap_colAt_retained_D8 hc hk ((Tree.mem_colAddrs_iff _ _).1 ho'K) hne hnc
    simp only [resp, capKeys_of_not_mem hr, actualKeys, hret]

/-- L4.2d helper (step 7): actual cut chains of columns of the literal cap are decorated chains
of the cap. -/
theorem litCap_path_D8 (hE : InL E) (hc : c ∈ E.colAddrs) (hk : k ≤ (parents E c).length)
    {o : ColAddr} (ho : o ∈ (Closure.litCap E c k p).colAddrs) {e : Nat}
    (he : e ≤ (parents E o).length) {y : Nat}
    (hy : Path E (actualKeys E) o (cutQuery (actualKeys E o) e) (cutStart E o e) y) :
    Path (Closure.litCap E c k p)
      (capKeys (Closure.litCap E c k p) (routeCols (Closure.litCap E c k p))) o
      (cutQuery (actualKeys E o) e) (cutStart E o e) y := by
  induction hy with
  | refl => exact Relation.ReflTransGen.refl
  | tail hxz hzy ih =>
    obtain ⟨o', ho', hr⟩ := hzy
    exact ih.tail ⟨o', ho', (litCap_resp_eq_D8 hE hc hk ho he hxz ho').trans hr⟩

/-- L4.2d helper (step 7): decorated A for the literal cap: every test of the cap is a test of
`E` (or the hypothesised cut test at the closing entry), transferred by `litCap_path_D8`. -/
theorem litCap_decA_D8 (hE : InL E) (hc : c ∈ E.colAddrs) (hup : Closure.IsUpward E c k p)
    (hpath : Path E (actualKeys E) c (cutQuery (actualKeys E c) k) (cutStart E c k) p) :
    CondAK (Closure.litCap E c k p)
      (capKeys (Closure.litCap E c k p) (routeCols (Closure.litCap E c k p))) := by
  set K := Closure.litCap E c k p
  have hk := upward_cut_le_D8 hup
  have hA : CondAK E (actualKeys E) := hE.2.2.2.1
  intro o ho i q hq
  change Path K (capKeys K (routeCols K)) o (cutQuery (capKeys K (routeCols K) o) i)
    (cutStart K o i) q
  have hoE : o ∈ E.colAddrs := litCap_colAddrs_sub_D8 hc hk ho
  have hlen : ∀ {i q}, (parents E o)[i]? = some q → i ≤ (parents E o).length :=
    fun h => (List.getElem?_eq_some_iff.1 h).1.le
  by_cases hr : o ∈ routeCols K
  · rcases (routeCols_litCap_D8 hc hk o).1 hr with rfl | ⟨j, hj⟩
    · have hKc : K.colAt o = some (((E.colAt o).getD []).take k ++ [(p, Tree.empty)]) :=
        litCap_colAt_self_D8 hc
      obtain ⟨colE, hcolE⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff E _).1 hc)
      rw [hcolE, Option.getD_some] at hKc
      have hkl : k ≤ colE.length := by rw [parents_length_D8, hcolE] at hk; simpa using hk
      obtain ⟨hi, hQ, hS, hlt, heq⟩ := trunc_test_D8 hr hcolE hKc hkl hq
      rw [hQ, hS]
      rcases Nat.lt_or_ge i k with hik | hik
      · have hpq := hlt hik
        exact litCap_path_D8 hE hc hk ho (hlen hpq) (hA o hoE i q hpq)
      · have hik' : i = k := by omega
        subst hik'
        have hqp : q = p := heq rfl
        subst hqp
        exact litCap_path_D8 hE hc hk ho hk hpath
    · obtain ⟨colX, q', h, h', hX, hq', hK⟩ := litCap_colAt_container_D8 (k := k) (p := p) hc hj
      have hjl : j < colX.length := (List.getElem?_eq_some_iff.1 hq').1
      obtain ⟨hi, hQ, hS, hlt, heq⟩ := trunc_test_D8 hr hX hK hjl.le hq
      rw [hQ, hS]
      have hpq : (parents E o)[i]? = some q := by
        rcases Nat.lt_or_ge i j with hij | hij
        · exact hlt hij
        · have : i = j := by omega
          subst this
          rw [heq rfl]
          simp [parents, hX, hq']
      exact litCap_path_D8 hE hc hk ho (hlen hpq) (hA o hoE i q hpq)
  · have hne : o ≠ c := fun h => hr ((routeCols_litCap_D8 hc hk o).2 (Or.inl h))
    have hnc : ∀ i, ¬ (⟨o, i⟩ : EntryAddr).heightPath <+: c.path :=
      fun i h => hr ((routeCols_litCap_D8 hc hk o).2 (Or.inr ⟨i, h⟩))
    have hret : K.colAt o = E.colAt o :=
      litCap_colAt_retained_D8 hc hk ((Tree.mem_colAddrs_iff _ _).1 ho) hne hnc
    have hpar : parents K o = parents E o := by simp only [parents, hret]
    have hks : capKeys K (routeCols K) o = actualKeys E o := by
      rw [capKeys_of_not_mem hr]; simp only [actualKeys, hret]
    have hst : cutStart K o i = cutStart E o i := by simp only [cutStart, hpar]
    rw [hks, hst]
    rw [hpar] at hq
    exact litCap_path_D8 hE hc hk ho (hlen hq) (hA o hoE i q hq)

end LitCapA

end CapLegal_D8

section PathTransfer_D8
open Scan

/-- L4.2 helper: equal cuts before entry `k` of column `j` give equal first `k` entries. -/
theorem cutBefore_col_D8 {α : Type} (j k : Nat) :
    ∀ (ρ : List (Nat × Nat)) (X Y : Tree α) (cx cy : List (α × Tree α)),
    cutBefore ρ j (some k) X = cutBefore ρ j (some k) Y → X.colAt ⟨ρ, j⟩ = some cx →
    Y.colAt ⟨ρ, j⟩ = some cy → cx.take k = cy.take k
  | [], .node xs, .node ys, cx, cy, hcut, hx, hy => by
    simp only [cutBefore, Tree.node.injEq] at hcut
    simp only [Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols] at hx hy
    have := congrArg List.getLast? hcut
    simp only [List.getLast?_append, List.getLast?_singleton, Option.some_or, hx, hy,
      Option.getD_some, Option.some.injEq] at this
    exact this
  | (ci, ii) :: rest, .node xs, .node ys, cx, cy, hcut, hx, hy => by
    rw [Tree.colAt_cons] at hx hy
    simp only [Tree.cols] at hx hy
    cases hxc : xs[ci]? with
    | none => rw [hxc] at hx; simp at hx
    | some colx =>
      cases hyc : ys[ci]? with
      | none => rw [hyc] at hy; simp at hy
      | some coly =>
        rw [hxc, Option.bind_some] at hx
        rw [hyc, Option.bind_some] at hy
        cases hxe : colx[ii]? with
        | none => rw [hxe] at hx; simp at hx
        | some ex =>
          cases hye : coly[ii]? with
          | none => rw [hye] at hy; simp at hy
          | some ey =>
            obtain ⟨lx, hX⟩ := ex
            obtain ⟨ly, hY⟩ := ey
            rw [hxe, Option.bind_some] at hx
            rw [hye, Option.bind_some] at hy
            simp only [cutBefore, hxc, hyc, hxe, hye, Tree.node.injEq] at hcut
            have := congrArg List.getLast? hcut
            simp only [List.getLast?_append, List.getLast?_singleton, Option.some_or,
              Option.some.injEq] at this
            have := congrArg List.getLast? this
            simp only [List.getLast?_append, List.getLast?_singleton, Option.some_or,
              Option.some.injEq, Prod.mk.injEq] at this
            exact cutBefore_col_D8 j k rest hX hY cx cy this.2 hx hy


/-- L4.2c helper: relabelling commutes with `forestAt`. -/
theorem forestAt_map_D8 {α β : Type} (f : α → β) :
    ∀ (π : List (Nat × Nat)) (X : Tree α), (X.map f).forestAt π = (X.forestAt π).map (Tree.map f)
  | [], _ => rfl
  | (ci, ei) :: rest, .node cols => by
    rw [Tree.forestAt_cons, Tree.forestAt_cons]
    simp only [Tree.map, Tree.cols, Scan.treeMapCols_eq_map, List.getElem?_map]
    cases hc : cols[ci]? with
    | none => rfl
    | some col =>
      simp only [Option.map_some, Option.bind_some, Scan.treeMapCol_eq_map, List.getElem?_map]
      cases hx : col[ei]? with
      | none => rfl
      | some x => exact forestAt_map_D8 f rest x.2

/-- L4.2c helper: relabelling commutes with `colAt`. -/
theorem colAt_map_D8 {α β : Type} (f : α → β) (X : Tree α) (d : ColAddr) :
    (X.map f).colAt d = (X.colAt d).map (Tree.mapCol f) := by
  unfold Tree.colAt
  rw [forestAt_map_D8]
  cases X.forestAt d.path with
  | none => rfl
  | some F =>
    obtain ⟨cols⟩ := F
    simp [Tree.map, Tree.cols, Scan.treeMapCols_eq_map, List.getElem?_map]

/-- L4.2c helper: relabelling commutes with `entryAt`. -/
theorem entryAt_map_D8 {α β : Type} (f : α → β) (X : Tree α) (e : EntryAddr) :
    (X.map f).entryAt e = (X.entryAt e).map fun x => (f x.1, x.2.map f) := by
  unfold Tree.entryAt
  rw [colAt_map_D8]
  cases X.colAt e.col with
  | none => rfl
  | some col => simp [Scan.treeMapCol_eq_map, List.getElem?_map]

/-- L4.2c helper: a column of the height of an entry, read in the whole tree. -/
theorem colAt_heightPath_D8 {α : Type} {X : Tree α} {e : EntryAddr} {h : Tree α}
    (he : X.heightAt e = some h) (ρ : List (Nat × Nat)) (j : Nat) :
    X.colAt ⟨e.heightPath ++ ρ, j⟩ = h.colAt ⟨ρ, j⟩ := by
  simp only [Tree.colAt, Tree.forestAt_append, Tree.forestAt_heightPath, he, Option.bind_some]

/-- L4.2c helper: the same for entries. -/
theorem entryAt_heightPath_D8 {α : Type} {X : Tree α} {e : EntryAddr} {h : Tree α}
    (he : X.heightAt e = some h) (ρ : List (Nat × Nat)) (j i : Nat) :
    X.entryAt ⟨⟨e.heightPath ++ ρ, j⟩, i⟩ = h.entryAt ⟨⟨ρ, j⟩, i⟩ := by
  simp only [Tree.entryAt, colAt_heightPath_D8 he]

/-- L4.2c/L4.2 helper: the column of a first-difference cap lies in the target height and is a
column of `E`. -/
theorem capAt_col_D8 {rk : SrcRecord} (h : rk.Admitted) {c : ColAddr} {k p : Nat}
    (hfd : rk.firstDiff = .capAt c k p) :
    rk.b.heightPath <+: c.path ∧ c ∈ rk.E.colAddrs := by
  obtain ⟨-, -, hcap⟩ := firstDiff_spec h
  obtain ⟨ρ, hρ, -, hcol, -⟩ := hcap c k p hfd
  refine ⟨⟨ρ, hρ.symm⟩, ?_⟩
  have hb : rk.E.heightAt rk.b = some rk.tgtHeight := by
    have hb := h.2.1
    rw [Tree.mem_entryAddrs_iff, Option.isSome_iff_exists] at hb
    obtain ⟨x, hx⟩ := hb
    simp [SrcRecord.tgtHeight, Tree.heightAt, hx]
  rw [Tree.mem_colAddrs_iff]
  have : c = ⟨rk.b.heightPath ++ ρ, c.col⟩ := by cases c; simp_all
  rw [this, colAt_heightPath_D8 hb]
  rw [SrcRecord.tgtKey, relKey_eq_map, colAt_map_D8] at hcol
  simpa using hcol

/-- G011-D2: κ (L4.2a) on `WithTop Key` (`⊤ ↦ ⊤`). -/
def kappaW_D8 (r t : Nat) : WithTop Key → WithTop Key := WithTop.map (Tree.map (kappa r t))

/-- G011-D2: σ, the number map of L4.2c: numbers below `r` are fixed, the others move up by
`t - r`. -/
def sigmaNum_D8 (r t y : Nat) : Nat := if y < r then y else y + (t - r)

/-- G011-D2: the source column `c'` of a target column `c` inside the marked height. -/
def srcCol_D8 (rk : SrcRecord) (c : ColAddr) : ColAddr :=
  ⟨rk.a.heightPath ++ c.path.drop rk.b.heightPath.length, c.col⟩

/-- G011-D2 helper: numbers of a column inside the height of an entry. -/
theorem num_heightPath_D8 (e : EntryAddr) (ρ : List (Nat × Nat)) (j : Nat) :
    (⟨e.heightPath ++ ρ, j⟩ : ColAddr).num 0 = e.col.num 0 + (⟨ρ, j⟩ : ColAddr).num 1 := by
  simp only [ColAddr.num, EntryAddr.heightPath, List.map_append, List.sum_append, List.map_cons,
    List.map_nil, List.sum_cons, List.sum_nil]
  omega

/-- G011-D2 helper: `relLabel` equality between thresholds `r ≤ t` is σ. -/
theorem relLabel_eq_sigma_D8 {r t x y : Nat} (hrt : r ≤ t) (h : relLabel r x = relLabel t y) :
    y = sigmaNum_D8 r t x := by
  unfold relLabel at h; unfold sigmaNum_D8
  by_cases hx : x < r <;> by_cases hy : y < t <;> simp [hx, hy] at h ⊢ <;> omega

/-- G011-D2 helper: `labelAbs` of a source label is σ of its parent. -/
theorem labelAbs_relLabel_D8 {r t q : Nat} (hrt : r ≤ t) :
    labelAbs t (relLabel r q) = sigmaNum_D8 r t q := by
  unfold relLabel sigmaNum_D8
  by_cases hq : q < r <;> simp [hq, labelAbs]; omega

/-- G011-D2: κ is strictly monotone on `WithTop Key` (L4.2a `kappa_cmp`, `keyCmp_map`). -/
theorem kappaW_strictMono_D8 {r t : Nat} (h : r ≤ t) : StrictMono (kappaW_D8 r t) := by
  apply WithTop.strictMono_map_iff.mpr
  intro x y hxy
  show keyCmp _ _ = .lt
  rw [keyCmp_map (kappa_cmp h)]
  exact hxy

/-- G011-L3 setup: the target column `c`, its source column `c'`, their common entries before
`k`, the source entry `k` and the numbers of both columns. -/
theorem capSetup_D8 {rk : SrcRecord} (h : rk.Admitted) {c : ColAddr} {k p : Nat}
    (hfd : rk.firstDiff = .capAt c k p) :
    ∃ ρ colB colA, c.path = rk.b.heightPath ++ ρ ∧
      srcCol_D8 rk c = ⟨rk.a.heightPath ++ ρ, c.col⟩ ∧
      rk.E.colAt c = some colB ∧ rk.F.colAt (srcCol_D8 rk c) = some colA ∧
      (∀ e < k, ∃ qB HB qA HA, colB[e]? = some (qB, HB) ∧ colA[e]? = some (qA, HA) ∧
        relLabel (rk.b.col.num 0) qB = relLabel (rk.a.col.num 0) qA ∧
        relKey (rk.b.col.num 0) HB = relKey (rk.a.col.num 0) HA) ∧
      k ≤ colB.length ∧
      (∃ q' H', colA[k]? = some (q', H') ∧ p = labelAbs (rk.b.col.num 0) (relLabel (rk.a.col.num 0) q')) ∧
      c.num 0 = rk.b.col.num 0 + (⟨ρ, c.col⟩ : ColAddr).num 1 ∧
      (srcCol_D8 rk c).num 0 = rk.a.col.num 0 + (⟨ρ, c.col⟩ : ColAddr).num 1 := by
  obtain ⟨-, -, hcap⟩ := firstDiff_spec h
  obtain ⟨ρ, hρ, hcut, hcol, halt⟩ := hcap c k p hfd
  set t := rk.b.col.num 0
  set r := rk.a.col.num 0
  have hb : rk.E.heightAt rk.b = some rk.tgtHeight := by
    have hb := h.2.1
    rw [Tree.mem_entryAddrs_iff, Option.isSome_iff_exists] at hb
    obtain ⟨x, hx⟩ := hb
    simp [SrcRecord.tgtHeight, Tree.heightAt, hx]
  have ha : rk.F.heightAt rk.a = some rk.srcHeight := by
    have ha := h.2.2.1
    rw [Tree.mem_entryAddrs_iff, Option.isSome_iff_exists] at ha
    obtain ⟨x, hx⟩ := ha
    simp [SrcRecord.srcHeight, Tree.heightAt, hx]
  have hcc : c = ⟨rk.b.heightPath ++ ρ, c.col⟩ := by cases c; simp_all
  have hsrc : srcCol_D8 rk c = ⟨rk.a.heightPath ++ ρ, c.col⟩ := by
    simp [srcCol_D8, hρ]
  have hcE : rk.E.colAt c = rk.tgtHeight.colAt ⟨ρ, c.col⟩ := by
    rw [hcc, colAt_heightPath_D8 hb]
  have hcF : rk.F.colAt (srcCol_D8 rk c) = rk.srcHeight.colAt ⟨ρ, c.col⟩ := by
    rw [hsrc, colAt_heightPath_D8 ha]
  have htk : rk.tgtKey.colAt ⟨ρ, c.col⟩ =
      (rk.tgtHeight.colAt ⟨ρ, c.col⟩).map (Tree.mapCol (relLabel t)) := by
    rw [SrcRecord.tgtKey, relKey_eq_map, colAt_map_D8]
  have hsk : rk.srcKey.colAt ⟨ρ, c.col⟩ =
      (rk.srcHeight.colAt ⟨ρ, c.col⟩).map (Tree.mapCol (relLabel r)) := by
    rw [SrcRecord.srcKey, relKey_eq_map, colAt_map_D8]
  obtain ⟨colB, hcolB⟩ : ∃ col, rk.tgtHeight.colAt ⟨ρ, c.col⟩ = some col := by
    rw [htk] at hcol
    simpa [Option.isSome_iff_exists] using hcol
  -- the source entry `k`
  have hsrcK : ∃ l hs, rk.srcKey.entryAt ⟨⟨ρ, c.col⟩, k⟩ = some (l, hs) ∧ p = labelAbs t l := by
    rcases halt with ⟨-, l, hs, h1, h2⟩ | ⟨-, -, l, hs, -, h1, -, h2⟩
    · exact ⟨l, hs, h1, h2⟩
    · exact ⟨l, hs, h1, h2⟩
  obtain ⟨l, hs, hsome, hp⟩ := hsrcK
  rw [SrcRecord.srcKey, relKey_eq_map, entryAt_map_D8] at hsome
  obtain ⟨⟨q', H'⟩, hA, hAl⟩ := Option.map_eq_some_iff.1 hsome
  simp only [Prod.mk.injEq] at hAl
  obtain ⟨colA, hcolA, hAk⟩ := Tree.colAt_of_entryAt hA
  have htk' : rk.tgtKey.colAt ⟨ρ, c.col⟩ = some (Tree.mapCol (relLabel t) colB) := by
    rw [htk, hcolB]; rfl
  have hsk' : rk.srcKey.colAt ⟨ρ, c.col⟩ = some (Tree.mapCol (relLabel r) colA) := by
    rw [hsk, hcolA]; rfl
  have htake := cutBefore_col_D8 c.col k ρ _ _ _ _ hcut htk' hsk'
  rw [Scan.treeMapCol_eq_map, Scan.treeMapCol_eq_map, ← List.map_take, ← List.map_take] at htake
  have hAl' : k < colA.length := (List.getElem?_eq_some_iff.1 hAk).1
  have hlenB : k ≤ colB.length := by
    have := congrArg List.length htake
    rw [List.length_map, List.length_map, List.length_take, List.length_take] at this
    omega
  refine ⟨ρ, colB, colA, hρ, hsrc, by rw [hcE, hcolB], by rw [hcF, hcolA], ?_, hlenB,
    ⟨q', H', hAk, by rw [hp, ← hAl.1]⟩, by rw [hcc]; exact num_heightPath_D8 _ _ _,
    by rw [hsrc]; exact num_heightPath_D8 _ _ _⟩
  intro e he
  have hBe : e < colB.length := by omega
  have hAe : e < colA.length := by omega
  have := congrArg (·[e]?) htake
  simp only [List.getElem?_map, List.getElem?_take_of_lt he, List.getElem?_eq_getElem hBe,
    List.getElem?_eq_getElem hAe, Option.map_some, Option.some.injEq, Prod.mk.injEq] at this
  exact ⟨_, _, _, _, List.getElem?_eq_getElem hBe, List.getElem?_eq_getElem hAe, this.1, this.2⟩

/-- G011-L3 (L4.2c steps 0–1). The source column exists with an entry `k`, whose parent `p'`
maps to `p` by σ; the target query is the κ-image of the source query; the starts correspond by
σ. -/
theorem query_transfer_D8 {rk : SrcRecord} (h : rk.Admitted) {c : ColAddr} {k p : Nat}
    (hfd : rk.firstDiff = .capAt c k p) :
    srcCol_D8 rk c ∈ rk.F.colAddrs ∧ k ≤ (parents rk.E c).length ∧
    (∃ p', (parents rk.F (srcCol_D8 rk c))[k]? = some p' ∧
      p = sigmaNum_D8 (rk.a.col.num 0) (rk.b.col.num 0) p') ∧
    cutQuery (actualKeys rk.E c) k =
      (cutQuery (actualKeys rk.F (srcCol_D8 rk c)) k).map
        (kappaW_D8 (rk.a.col.num 0) (rk.b.col.num 0)) ∧
    cutStart rk.E c k =
      sigmaNum_D8 (rk.a.col.num 0) (rk.b.col.num 0) (cutStart rk.F (srcCol_D8 rk c) k) := by
  obtain ⟨ρ, colB, colA, hρ, hsrc, hB, hA, hcom, hkB, ⟨q', H', hAk, hp⟩, hnB, hnA⟩ :=
    capSetup_D8 h hfd
  have hrt : rk.a.col.num 0 ≤ rk.b.col.num 0 := (admitted_hosts h).1
  set t := rk.b.col.num 0
  set r := rk.a.col.num 0
  have hn1 : 1 ≤ (⟨ρ, c.col⟩ : ColAddr).num 1 := by simp only [ColAddr.num]; omega
  refine ⟨by rw [Tree.mem_colAddrs_iff, hA]; rfl, by simp [parents, hB, hkB],
    ⟨q', by simp [parents, hA, hAk], by rw [hp, labelAbs_relLabel_D8 hrt]⟩, ?_, ?_⟩
  · rw [← cutQuery_map (kappaW_strictMono_D8 hrt), cutQuery, cutQuery]
    congr 1
    apply List.ext_getElem?
    intro e
    rcases Nat.lt_or_ge e k with he | he
    · obtain ⟨qB, HB, qA, HA, h1, h2, -, h4⟩ := hcom e he
      rw [List.getElem?_take_of_lt he, List.getElem?_take_of_lt he]
      simp only [actualKeys, hB, hA, Option.getD_some, List.getElem?_map, h1, h2, Option.map_some,
        kappaW_D8, WithTop.map_coe]
      rw [relKey_kappa hrt (by omega) h4.symm]
      congr 3
      omega
    · rw [List.getElem?_eq_none (by simp; omega), List.getElem?_eq_none (by simp; omega)]
  · unfold cutStart
    split_ifs with hk0
    · simp only [sigmaNum_D8]
      rw [if_neg (by omega)]
      omega
    · obtain ⟨qB, HB, qA, HA, h1, h2, h3, -⟩ := hcom (k - 1) (by omega)
      simp only [parents, hB, hA, Option.getD_some, List.getElem?_map, h1, h2, Option.map_some]
      exact relLabel_eq_sigma_D8 hrt h3.symm

/-- G011-L4 helper: placing a column under a prefix. -/
def shiftCol_D8 (pfx : List (Nat × Nat)) (o : ColAddr) : ColAddr := ⟨pfx ++ o.path, o.col⟩

/-- G011-L4 helper: stacks commute with placing under a prefix. -/
theorem onStack_shift_D8 (pfx : List (Nat × Nat)) {c o : ColAddr} (h : c.OnStack o) :
    (shiftCol_D8 pfx c).OnStack (shiftCol_D8 pfx o) := by
  rcases h with ⟨m, ck, ik, hm, hp, hle⟩ | ⟨hp, hlt⟩
  · refine Or.inl ⟨pfx.length + m, ck, ik, ?_, ?_, hle⟩
    · simp [shiftCol_D8, List.getElem?_append_right, hm]
    · simp [shiftCol_D8, hp, List.take_append]
  · exact Or.inr ⟨by simp [shiftCol_D8, hp], hlt⟩

/-- G011-L4 helper (`rep_inside` (c), resolve form): above the host of an entry, the stack of a
column inside its height resolves like the relative stack. -/
theorem resolve_heightPath_D8 (e : EntryAddr) (ρ : List (Nat × Nat)) (j w : Nat) (hw : 1 ≤ w) :
    (⟨e.heightPath ++ ρ, j⟩ : ColAddr).resolve 0 (e.col.num 0 + w) =
      ((⟨ρ, j⟩ : ColAddr).resolve 1 w).map (shiftCol_D8 e.heightPath) := by
  cases hr : (⟨ρ, j⟩ : ColAddr).resolve 1 w with
  | none =>
    simp only [Option.map_none]
    have h1 := (ColAddr.resolve_isSome_iff 1 ⟨ρ, j⟩ w)
    rw [hr] at h1
    simp only [Option.isSome_none, Bool.false_eq_true, false_iff, not_and, not_lt] at h1
    have h2 := h1 hw
    cases h3 : (⟨e.heightPath ++ ρ, j⟩ : ColAddr).resolve 0 (e.col.num 0 + w) with
    | none => rfl
    | some o =>
      have := ColAddr.resolve_lt h3
      rw [num_heightPath_D8] at this
      omega
  | some o =>
    simp only [Option.map_some]
    obtain ⟨hs, hn⟩ := (ColAddr.resolve_spec 1 _ o w).1 hr
    rw [ColAddr.resolve_spec]
    refine ⟨onStack_shift_D8 e.heightPath hs, ?_⟩
    rw [shiftCol_D8, num_heightPath_D8, hn]

/-- G011-L4 helper: containment commutes with placing under a prefix. -/
theorem container_shift_D8 (pfx : List (Nat × Nat)) (o c : ColAddr) :
    (shiftCol_D8 pfx o).container (shiftCol_D8 pfx c) =
      (o.container c).map fun e => ⟨shiftCol_D8 pfx e.col, e.idx⟩ := by
  unfold ColAddr.container shiftCol_D8
  have hd : (pfx ++ c.path).drop (pfx ++ o.path).length = c.path.drop o.path.length := by
    simp [List.drop_append]
  have ht : (pfx ++ c.path).take (pfx ++ o.path).length = pfx ++ c.path.take o.path.length := by
    simp [List.take_append]
  simp only [hd, ht]
  cases c.path.drop o.path.length with
  | nil => rfl
  | cons s rest =>
    obtain ⟨k, i⟩ := s
    simp only
    by_cases h1 : c.path.take o.path.length = o.path ∧ k = o.col
    · rw [if_pos h1, if_pos ⟨by rw [h1.1], h1.2⟩]; rfl
    · rw [if_neg h1, if_neg]
      · rfl
      · rintro ⟨h2, h3⟩
        exact h1 ⟨List.append_cancel_left h2, h3⟩

/-- G011-L4 helper: the stack of a column one level down. -/
theorem onStack_cons_D8 {s : Nat × Nat} {rest : List (Nat × Nat)} {j : Nat} {d : ColAddr}
    (h : (⟨s :: rest, j⟩ : ColAddr).OnStack d) :
    (d.path = [] ∧ d.col ≤ s.1) ∨
      ∃ P, d.path = s :: P ∧ (⟨rest, j⟩ : ColAddr).OnStack ⟨P, d.col⟩ := by
  rcases h with ⟨m, ck, ik, hm, hp, hle⟩ | ⟨hp, hlt⟩
  · rcases Nat.eq_zero_or_pos m with rfl | hpos
    · simp only [List.getElem?_cons_zero, Option.some.injEq] at hm
      left; subst hm; exact ⟨by simpa using hp, hle⟩
    · obtain ⟨m, rfl⟩ : ∃ m', m = m' + 1 := ⟨m - 1, by omega⟩
      right
      refine ⟨rest.take m, by simpa using hp, Or.inl ⟨m, ck, ik, by simpa using hm, rfl, hle⟩⟩
  · right; exact ⟨rest, hp, Or.inr ⟨rfl, hlt⟩⟩

/-- G011-L4 helper: equal cuts agree on every column of the visible stack of the cut column:
completely on the columns that do not contain it, and before and at the active entry on the
containing ones. -/
theorem cutBefore_agree_D8 {α : Type} (j k : Nat) : ∀ (ρ : List (Nat × Nat)) (X Y : Tree α),
    cutBefore ρ j (some k) X = cutBefore ρ j (some k) Y →
    (X.colAt ⟨ρ, j⟩).isSome → (Y.colAt ⟨ρ, j⟩).isSome →
    ∀ d : ColAddr, (⟨ρ, j⟩ : ColAddr).OnStack d →
      (d.container ⟨ρ, j⟩ = none → X.colAt d = Y.colAt d) ∧
      (∀ u, d.container ⟨ρ, j⟩ = some ⟨d, u⟩ → ∃ cx cy, X.colAt d = some cx ∧
        Y.colAt d = some cy ∧ cx.take u = cy.take u ∧
        (cx[u]?).map Prod.fst = (cy[u]?).map Prod.fst ∧ u < cx.length ∧ u < cy.length)
  | [], .node xs, .node ys, hcut, hx, hy, d, hd => by
    have hjx : j < xs.length := by simpa [Tree.colAt, Tree.forestAt, Tree.cols] using hx
    have hjy : j < ys.length := by simpa [Tree.colAt, Tree.forestAt, Tree.cols] using hy
    simp only [cutBefore, Tree.node.injEq] at hcut
    have htk : xs.take j = ys.take j :=
      (List.append_inj hcut (by simp; omega)).1
    rcases hd with ⟨m, ck, ik, hm, -, -⟩ | ⟨hp, hlt⟩
    · simp at hm
    · have hnone : d.container ⟨[], j⟩ = none := by
        simp [ColAddr.container, hp]
      refine ⟨fun _ => ?_, fun u hu => by rw [hnone] at hu; cases hu⟩
      obtain ⟨P, dc⟩ := d
      simp only at hp hlt; subst hp
      simp only [Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols]
      have := congrArg (·[dc]?) htk
      simpa [List.getElem?_take_of_lt hlt] using this
  | (ci, ii) :: rest, .node xs, .node ys, hcut, hx, hy, d, hd => by
    rw [Tree.colAt_cons] at hx hy
    simp only [Tree.cols] at hx hy
    obtain ⟨colx, hcx⟩ : ∃ col, xs[ci]? = some col := by
      cases h : xs[ci]? with
      | none => rw [h] at hx; simp at hx
      | some col => exact ⟨col, rfl⟩
    obtain ⟨coly, hcy⟩ : ∃ col, ys[ci]? = some col := by
      cases h : ys[ci]? with
      | none => rw [h] at hy; simp at hy
      | some col => exact ⟨col, rfl⟩
    rw [hcx, Option.bind_some] at hx
    rw [hcy, Option.bind_some] at hy
    obtain ⟨⟨lx, hX⟩, hex⟩ : ∃ e, colx[ii]? = some e := by
      cases h : colx[ii]? with
      | none => rw [h] at hx; simp at hx
      | some e => exact ⟨e, rfl⟩
    obtain ⟨⟨ly, hY⟩, hey⟩ : ∃ e, coly[ii]? = some e := by
      cases h : coly[ii]? with
      | none => rw [h] at hy; simp at hy
      | some e => exact ⟨e, rfl⟩
    rw [hex, Option.bind_some] at hx
    rw [hey, Option.bind_some] at hy
    have hcix : ci < xs.length := (List.getElem?_eq_some_iff.1 hcx).1
    have hciy : ci < ys.length := (List.getElem?_eq_some_iff.1 hcy).1
    have hiix : ii < colx.length := (List.getElem?_eq_some_iff.1 hex).1
    have hiiy : ii < coly.length := (List.getElem?_eq_some_iff.1 hey).1
    simp only [cutBefore, hcx, hcy, hex, hey, Tree.node.injEq] at hcut
    obtain ⟨htk, hcut2⟩ := List.append_inj hcut (by simp; omega)
    simp only [List.cons.injEq, and_true] at hcut2
    obtain ⟨htk2, hcut3⟩ := List.append_inj hcut2 (by simp; omega)
    simp only [List.cons.injEq, Prod.mk.injEq, and_true] at hcut3
    obtain ⟨hl, hrec⟩ := hcut3
    rcases onStack_cons_D8 hd with ⟨hp, hle⟩ | ⟨P, hp, hP⟩
    · obtain ⟨dp, dc⟩ := d
      simp only at hp hle; subst hp
      rcases Nat.lt_or_ge dc ci with hlt | hge
      · have hnone : (⟨[], dc⟩ : ColAddr).container ⟨(ci, ii) :: rest, j⟩ = none := by
          simp [ColAddr.container]; omega
        refine ⟨fun _ => ?_, fun u hu => by rw [hnone] at hu; cases hu⟩
        simp only [Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols]
        have := congrArg (·[dc]?) htk
        simpa [List.getElem?_take_of_lt hlt] using this
      · have hdc : dc = ci := by omega
        subst hdc
        have hsome : (⟨[], dc⟩ : ColAddr).container ⟨(dc, ii) :: rest, j⟩ = some ⟨⟨[], dc⟩, ii⟩ := by
          simp [ColAddr.container]
        refine ⟨fun h => (by rw [hsome] at h; cases h), fun u hu => ?_⟩
        rw [hsome] at hu
        simp only [Option.some.injEq, EntryAddr.mk.injEq, true_and] at hu
        subst hu
        refine ⟨colx, coly, by simp [Tree.colAt, Tree.forestAt, Tree.cols, hcx],
          by simp [Tree.colAt, Tree.forestAt, Tree.cols, hcy], htk2, by rw [hex, hey, hl]; rfl,
          hiix, hiiy⟩
    · obtain ⟨dp, dc⟩ := d
      simp only at hp hP; subst hp
      have IH := cutBefore_agree_D8 j k rest hX hY hrec hx hy ⟨P, dc⟩ hP
      have hcolx : (Tree.node xs).colAt ⟨(ci, ii) :: P, dc⟩ = hX.colAt ⟨P, dc⟩ := by
        simp [Tree.colAt_cons, Tree.cols, hcx, hex]
      have hcoly : (Tree.node ys).colAt ⟨(ci, ii) :: P, dc⟩ = hY.colAt ⟨P, dc⟩ := by
        simp [Tree.colAt_cons, Tree.cols, hcy, hey]
      have hcont := container_shift_D8 [(ci, ii)] ⟨P, dc⟩ ⟨rest, j⟩
      simp only [shiftCol_D8, List.singleton_append] at hcont
      rw [hcolx, hcoly, hcont]
      refine ⟨fun h => IH.1 (by simpa using h), fun u hu => ?_⟩
      cases h2 : (⟨P, dc⟩ : ColAddr).container ⟨rest, j⟩ with
      | none => rw [h2] at hu; cases hu
      | some e =>
        rw [h2] at hu
        simp only [Option.map_some, Option.some.injEq, EntryAddr.mk.injEq] at hu
        obtain ⟨he1, rfl⟩ := hu
        have he : e = ⟨⟨P, dc⟩, e.idx⟩ := by
          obtain ⟨⟨ep, ec⟩, ei⟩ := e
          simp only [ColAddr.mk.injEq, List.cons.injEq, true_and] at he1
          simp [he1]
        rw [he] at h2
        exact IH.2 e.idx h2

/-- G011-L4 helper: two columns with equal relative keys (target at `t`, source at `r`) have
κ-related actual keys at numbers `t + w`, `r + w`, and σ-related parents. -/
theorem colRel_D8 {r t w : Nat} (hrt : r ≤ t) :
    ∀ {LB LA : Column}, Tree.mapCol (relLabel t) LB = Tree.mapCol (relLabel r) LA →
    LB.map (fun x => ((relKey (t + w) x.2 : Key) : WithTop Key)) =
        (LA.map (fun x => ((relKey (r + w) x.2 : Key) : WithTop Key))).map (kappaW_D8 r t) ∧
      LB.map Prod.fst = (LA.map Prod.fst).map (sigmaNum_D8 r t)
  | [], [], _ => ⟨rfl, rfl⟩
  | [], _ :: _, h => by simp [Tree.mapCol] at h
  | _ :: _, [], h => by simp [Tree.mapCol] at h
  | (qB, HB) :: LB, (qA, HA) :: LA, h => by
    simp only [Tree.mapCol, List.cons.injEq, Prod.mk.injEq] at h
    obtain ⟨⟨h1, h2⟩, h3⟩ := h
    obtain ⟨ih1, ih2⟩ := colRel_D8 hrt h3
    refine ⟨?_, ?_⟩
    · rw [List.map_cons, List.map_cons, List.map_cons, ih1]
      congr 1
      simp only [kappaW_D8, WithTop.map_coe]
      rw [relKey_kappa hrt (by omega) h2.symm, show r + w + (t - r) = t + w by omega]
    · simp only [List.map_cons, ih2, List.cons.injEq, and_true]
      exact relLabel_eq_sigma_D8 hrt h1.symm

/-- G011-L4 (L4.2c step 2). An edge of the source chain at a vertex `y > r` has its σ-twin on
the target chain (the target chain reaching `σ y` supplies R8 in `E`). -/
theorem internal_edge_eq_D8 {rk : SrcRecord} (h : rk.Admitted) {c : ColAddr} {k p : Nat}
    (hfd : rk.firstDiff = .capAt c k p) {y : Nat} (hy : rk.a.col.num 0 < y)
    (hsrc : Path rk.F (actualKeys rk.F) (srcCol_D8 rk c)
      (cutQuery (actualKeys rk.F (srcCol_D8 rk c)) k) (cutStart rk.F (srcCol_D8 rk c) k) y)
    (htgt : Path rk.E (actualKeys rk.E) c (cutQuery (actualKeys rk.E c) k) (cutStart rk.E c k)
      (sigmaNum_D8 (rk.a.col.num 0) (rk.b.col.num 0) y)) :
    respEdge rk.E (actualKeys rk.E) c (cutQuery (actualKeys rk.E c) k)
        (sigmaNum_D8 (rk.a.col.num 0) (rk.b.col.num 0) y) =
      (respEdge rk.F (actualKeys rk.F) (srcCol_D8 rk c)
        (cutQuery (actualKeys rk.F (srcCol_D8 rk c)) k) y).map
        (sigmaNum_D8 (rk.a.col.num 0) (rk.b.col.num 0)) := by
  obtain ⟨-, -, hcap⟩ := firstDiff_spec h
  obtain ⟨ρ, hρ, hcut, hcolT, -⟩ := hcap c k p hfd
  obtain ⟨ρ', colB, colA, hρ', hsrcc, hB, hA, -, -, ⟨q', H', hAk, -⟩, -, -⟩ := capSetup_D8 h hfd
  have : ρ' = ρ := by rw [hρ] at hρ'; exact (List.append_cancel_left hρ').symm
  subst ρ'
  have hcc : c = ⟨rk.b.heightPath ++ ρ, c.col⟩ := by
    obtain ⟨cp, cc⟩ := c; simp only at hρ ⊢; rw [hρ]
  obtain ⟨hc'F, hkE, -, hW, -⟩ := query_transfer_D8 h hfd
  obtain ⟨-, hcE⟩ := capAt_col_D8 h hfd
  have hrt : rk.a.col.num 0 ≤ rk.b.col.num 0 := (admitted_hosts h).1
  set t := rk.b.col.num 0 with ht
  set r := rk.a.col.num 0 with hr
  set c' := srcCol_D8 rk c
  have hkF : k ≤ (parents rk.F c').length := by
    simp [parents, hA]; exact (List.getElem?_eq_some_iff.1 hAk).1.le
  have hEL : InL rk.E := Closure.std_inL h.1
  have hFL : InL rk.F := h.2.2.2.1
  obtain ⟨w, rfl⟩ : ∃ w, y = r + w := ⟨y - r, by omega⟩
  have hw : 1 ≤ w := by omega
  have hσ : sigmaNum_D8 r t (r + w) = t + w := by simp [sigmaNum_D8]; omega
  rw [hσ] at htgt ⊢
  have hb : rk.E.heightAt rk.b = some rk.tgtHeight := by
    have hb := h.2.1
    rw [Tree.mem_entryAddrs_iff, Option.isSome_iff_exists] at hb
    obtain ⟨x, hx⟩ := hb
    simp [SrcRecord.tgtHeight, Tree.heightAt, hx]
  have ha : rk.F.heightAt rk.a = some rk.srcHeight := by
    have ha := h.2.2.1
    rw [Tree.mem_entryAddrs_iff, Option.isSome_iff_exists] at ha
    obtain ⟨x, hx⟩ := ha
    simp [SrcRecord.srcHeight, Tree.heightAt, hx]
  have hcres : c.resolve 0 (t + w) =
      ((⟨ρ, c.col⟩ : ColAddr).resolve 1 w).map (shiftCol_D8 rk.b.heightPath) := by
    conv_lhs => rw [hcc]
    exact resolve_heightPath_D8 rk.b ρ c.col w hw
  have hc'res : c'.resolve 0 (r + w) =
      ((⟨ρ, c.col⟩ : ColAddr).resolve 1 w).map (shiftCol_D8 rk.a.heightPath) := by
    rw [hsrcc]; exact resolve_heightPath_D8 rk.a ρ c.col w hw
  have hsk : (rk.srcKey.colAt ⟨ρ, c.col⟩).isSome := by
    rw [SrcRecord.srcKey, relKey_eq_map, colAt_map_D8]
    have : rk.F.colAt c' = rk.srcHeight.colAt ⟨ρ, c.col⟩ := by
      rw [hsrcc, colAt_heightPath_D8 ha]
    rw [← this, hA]; rfl
  unfold respEdge
  rw [hcres, hc'res]
  cases horel : (⟨ρ, c.col⟩ : ColAddr).resolve 1 w with
  | none => rfl
  | some o =>
    simp only [Option.map_some, Option.bind_some]
    obtain ⟨hos, hon⟩ := (ColAddr.resolve_spec 1 _ o w).1 horel
    have agree := cutBefore_agree_D8 c.col k ρ _ _ hcut hcolT hsk o hos
    have hEo : rk.E.colAt (shiftCol_D8 rk.b.heightPath o) = rk.tgtHeight.colAt o := by
      rw [shiftCol_D8, colAt_heightPath_D8 hb]
    have hFo : rk.F.colAt (shiftCol_D8 rk.a.heightPath o) = rk.srcHeight.colAt o := by
      rw [shiftCol_D8, colAt_heightPath_D8 ha]
    have hTo : rk.tgtKey.colAt o = (rk.tgtHeight.colAt o).map (Tree.mapCol (relLabel t)) := by
      rw [SrcRecord.tgtKey, relKey_eq_map, colAt_map_D8]
    have hSo : rk.srcKey.colAt o = (rk.srcHeight.colAt o).map (Tree.mapCol (relLabel r)) := by
      rw [SrcRecord.srcKey, relKey_eq_map, colAt_map_D8]
    have hnb : (shiftCol_D8 rk.b.heightPath o).num 0 = t + w := by
      rw [shiftCol_D8, num_heightPath_D8, hon]
    have hna : (shiftCol_D8 rk.a.heightPath o).num 0 = r + w := by
      rw [shiftCol_D8, num_heightPath_D8, hon]
    cases hcont : o.container ⟨ρ, c.col⟩ with
    | none =>
      have heq := agree.1 hcont
      rw [hTo, hSo] at heq
      rw [hW]
      cases hBo : rk.tgtHeight.colAt o with
      | none =>
        rw [hBo] at heq
        cases hAo : rk.srcHeight.colAt o with
        | none => simp [resp, hEo, hFo, hBo, hAo]
        | some _ => rw [hAo] at heq; cases heq
      | some colBo =>
        rw [hBo] at heq
        cases hAo : rk.srcHeight.colAt o with
        | none => rw [hAo] at heq; cases heq
        | some colAo =>
          rw [hAo] at heq
          simp only [Option.map_some, Option.some.injEq] at heq
          obtain ⟨hk1, hk2⟩ := colRel_D8 (w := w) hrt heq
          have hkE' : actualKeys rk.E (shiftCol_D8 rk.b.heightPath o) =
              colBo.map (fun x => ((relKey (t + w) x.2 : Key) : WithTop Key)) := by
            simp [actualKeys, hEo, hBo, hnb]
          have hkF' : actualKeys rk.F (shiftCol_D8 rk.a.heightPath o) =
              colAo.map (fun x => ((relKey (r + w) x.2 : Key) : WithTop Key)) := by
            simp [actualKeys, hFo, hAo, hna]
          simp only [resp, hEo, hFo, hBo, hAo, Option.getD_some]
          rw [hkE', hkF', hk1, cursor_map (kappaW_strictMono_D8 hrt)]
          have := congrArg (·[cursor (colAo.map fun x => ((relKey (r + w) x.2 : Key) :
            WithTop Key)) (cutQuery (actualKeys rk.F c') k)]?) hk2
          simp only [List.getElem?_map] at this
          rw [this, Option.map_map]
    | some e =>
      obtain ⟨he1, -⟩ := (ColAddr.container_spec o ⟨ρ, c.col⟩ e).1 hcont
      obtain ⟨eo, u⟩ := e
      simp only at he1; subst eo
      obtain ⟨cx, cy, hcx, hcy, htake, hlab, hux, huy⟩ := agree.2 u hcont
      rw [hTo] at hcx; rw [hSo] at hcy
      obtain ⟨colBo, hBo, rfl⟩ := Option.map_eq_some_iff.1 hcx
      obtain ⟨colAo, hAo, rfl⟩ := Option.map_eq_some_iff.1 hcy
      -- barriers in both trees
      have hcontE : (shiftCol_D8 rk.b.heightPath o).container c =
          some ⟨shiftCol_D8 rk.b.heightPath o, u⟩ := by
        rw [hcc]
        have := container_shift_D8 rk.b.heightPath o ⟨ρ, c.col⟩
        simp only [shiftCol_D8] at this ⊢
        rw [this, hcont]; rfl
      have hcontF : (shiftCol_D8 rk.a.heightPath o).container c' =
          some ⟨shiftCol_D8 rk.a.heightPath o, u⟩ := by
        show _ = _
        rw [show c' = ⟨rk.a.heightPath ++ ρ, c.col⟩ from hsrcc]
        have := container_shift_D8 rk.a.heightPath o ⟨ρ, c.col⟩
        simp only [shiftCol_D8] at this ⊢
        rw [this, hcont]; rfl
      have hbarE := cut_barrier_read hEL hcE hkE htgt (by rw [hcres, horel]; rfl) hcontE
      have hbarF := cut_barrier_read hFL hc'F hkF hsrc (by rw [hc'res, horel]; rfl) hcontF
      simp only at hbarE hbarF
      have hlenB : u < (actualKeys rk.E (shiftCol_D8 rk.b.heightPath o)).length := by
        simp [actualKeys, hEo, hBo]; rw [Scan.treeMapCol_eq_map] at hux; simpa using hux
      have hlenA : u < (actualKeys rk.F (shiftCol_D8 rk.a.heightPath o)).length := by
        simp [actualKeys, hFo, hAo]; rw [Scan.treeMapCol_eq_map] at huy; simpa using huy
      obtain ⟨hcE1, hcE2⟩ := cursor_cappedAt _ _ u hlenB (cutQuery_noninc _ _)
        (cutQuery_actualKeys_ne_top_D8 _ _ _) hbarE
      obtain ⟨hcF1, hcF2⟩ := cursor_cappedAt _ _ u hlenA (cutQuery_noninc _ _)
        (cutQuery_actualKeys_ne_top_D8 _ _ _) hbarF
      -- the capped lists correspond under κ
      rw [Scan.treeMapCol_eq_map, Scan.treeMapCol_eq_map, ← List.map_take, ← List.map_take] at htake
      rw [← Scan.treeMapCol_eq_map, ← Scan.treeMapCol_eq_map] at htake
      obtain ⟨hk1, hk2⟩ := colRel_D8 (w := w) hrt htake
      have hkE' : actualKeys rk.E (shiftCol_D8 rk.b.heightPath o) =
          colBo.map (fun x => ((relKey (t + w) x.2 : Key) : WithTop Key)) := by
        simp [actualKeys, hEo, hBo, hnb]
      have hkF' : actualKeys rk.F (shiftCol_D8 rk.a.heightPath o) =
          colAo.map (fun x => ((relKey (r + w) x.2 : Key) : WithTop Key)) := by
        simp [actualKeys, hFo, hAo, hna]
      have hcap : (actualKeys rk.E (shiftCol_D8 rk.b.heightPath o)).take u ++ [⊤] =
          ((actualKeys rk.F (shiftCol_D8 rk.a.heightPath o)).take u ++ [⊤]).map
            (kappaW_D8 r t) := by
        rw [hkE', hkF', ← List.map_take, ← List.map_take, hk1, List.map_append]
        rfl
      have hcur : cursor (actualKeys rk.E (shiftCol_D8 rk.b.heightPath o))
          (cutQuery (actualKeys rk.E c) k) =
          cursor (actualKeys rk.F (shiftCol_D8 rk.a.heightPath o))
            (cutQuery (actualKeys rk.F c') k) := by
        rw [hcE2, hcF2, hcap, hW, cursor_map (kappaW_strictMono_D8 hrt)]
      simp only [resp, hEo, hFo, hBo, hAo, Option.getD_some, hcur]
      set cur := cursor (actualKeys rk.F (shiftCol_D8 rk.a.heightPath o))
        (cutQuery (actualKeys rk.F c') k)
      have hcu : cur ≤ u := by rw [← hcur]; exact hcE1
      rcases Nat.lt_or_ge cur u with hlt | hge
      · have := congrArg (·[cur]?) hk2
        simp only [List.getElem?_map, List.getElem?_take_of_lt hlt] at this
        rw [this, Option.map_map]
      · have hcu' : cur = u := by omega
        rw [hcu']
        simp only [Scan.treeMapCol_eq_map, List.getElem?_map] at hlab
        have hux' : u < colBo.length := by rw [Scan.treeMapCol_eq_map] at hux; simpa using hux
        have huy' : u < colAo.length := by rw [Scan.treeMapCol_eq_map] at huy; simpa using huy
        cases hbu : colBo[u]? with
        | none => exact absurd hbu (by simp [hux'])
        | some xb =>
          cases hau : colAo[u]? with
          | none => exact absurd hau (by simp [huy'])
          | some xa =>
            rw [hbu, hau] at hlab
            simp only [Option.map_some, Option.some.injEq] at hlab ⊢
            exact relLabel_eq_sigma_D8 hrt hlab.symm

/-- G011-L7 helper: the host column of an entry is on the stack of every column inside its
height. -/
theorem resolve_host_D8 {e : EntryAddr} {d : ColAddr} (hd : e.heightPath <+: d.path) :
    d.resolve 0 (e.col.num 0) = some e.col := by
  rw [ColAddr.resolve_spec]
  refine ⟨Or.inl ⟨e.col.path.length, e.col.col, e.idx, ?_, ?_, le_rfl⟩, rfl⟩
  · obtain ⟨tl, htl⟩ := hd
    rw [← htl, EntryAddr.heightPath]; simp
  · obtain ⟨tl, htl⟩ := hd
    rw [← htl, EntryAddr.heightPath]; simp

/-- G011-L6 helper: a `⊤`-free nonincreasing word is below `[⊤]`. -/
theorem lt_top_singleton_D8 (Z : List (WithTop Key)) (hZ : ∀ y ∈ Z, y ≠ ⊤) : Z < [⊤] := by
  cases Z with
  | nil => exact List.nil_lt_cons _ _
  | cons z Z =>
    exact List.cons_lt_cons_iff.2 (Or.inl (WithTop.lt_top_iff_ne_top.2 (hZ z List.mem_cons_self)))

/-- G011-L6 (L4.2c step 4(b2)). The decorated host edge: read from any stack owner `d` that
resolves `sd.t` to the stopping column, the decorated stopping column answers `sd.r` to the query
of its full query prefix. -/
theorem decorated_host_edge_D8 {H : Forest} {sd : StopData} (hsd : stopData H = some sd)
    {d : ColAddr} (hd : d.resolve 0 sd.t = some sd.col) :
    Edge H (capKeys H (routeCols H)) d (cutQuery (actualKeys H sd.col) sd.Q.length) sd.t sd.r := by
  obtain ⟨hcol, -, -, hmem, -, -⟩ := stopData_spec hsd
  set f : Nat × Forest → WithTop Key := fun x => ((relKey (sd.col.num 0) x.2 : Key) : WithTop Key)
  have hks : actualKeys H sd.col = sd.Q.map f ++ [f (sd.r, Tree.empty)] := by
    simp [actualKeys, hcol, f]
  have hksD : capKeys H (routeCols H) sd.col = sd.Q.map f ++ [⊤] := by
    simp [capKeys, hmem, hks]
  have hZ : cutQuery (actualKeys H sd.col) sd.Q.length = nu (sd.Q.map f) := by
    rw [cutQuery, hks, List.take_left' (by simp)]
  refine ⟨sd.col, hd, ?_⟩
  have hT : ∀ y ∈ nu (sd.Q.map f), y ≠ ⊤ := by
    intro y hy
    have := (nu_sublist _).subset hy
    simp only [List.mem_map, f] at this
    obtain ⟨_, -, rfl⟩ := this
    exact WithTop.coe_ne_top
  have hcur : cursor (capKeys H (routeCols H) sd.col)
      (cutQuery (actualKeys H sd.col) sd.Q.length) = sd.Q.length := by
    rw [hksD, hZ]
    apply cursor_unique (nu_noninc _) (by simp)
    · rw [cutQuery, List.take_left' (by simp)]
    · intro _
      rw [cutQuery, List.take_of_length_le (by simp), nu_append_singleton,
        nuStep_eq_takeWhile (nu_noninc _)]
      have : (nu (sd.Q.map f)).takeWhile (fun y => decide (⊤ ≤ y)) = [] := by
        cases hn : nu (sd.Q.map f) with
        | nil => rfl
        | cons z zs =>
          have hz : z ≠ ⊤ := hT z (by rw [hn]; exact List.mem_cons_self)
          simp only [List.takeWhile_cons, top_le_iff, hz, decide_false, Bool.false_eq_true,
            if_false]
      rw [this, List.nil_append]
      exact lt_top_singleton_D8 _ hT
  simp [resp, hcur, hcol]

/-- G011-L8 for an `E` anchor: the host crossing through the decorated stopping column of `E`
itself (R8, `capping_forward`, `path_nesting`, and the capped/actual path transfer of L2.4b). -/
theorem host_crossing_none_D8 {E : Forest} (hE : InL E) {sd : StopData}
    (hsd : stopData E = some sd) {j : Nat} (hj : j < sd.Q.length) {c : ColAddr}
    (hc : c ∈ E.colAddrs) (hbc : (⟨sd.col, j⟩ : EntryAddr).heightPath <+: c.path) {k : Nat}
    (hk : k ≤ (parents E c).length)
    (hreach : Path E (actualKeys E) c (cutQuery (actualKeys E c) k) (cutStart E c k) sd.t) :
    Path E (actualKeys E) c (cutQuery (actualKeys E c) k) (cutStart E c k) sd.r := by
  obtain ⟨hV, hI, hH, hA, hS⟩ := id hE
  have hcut : ∀ e ∈ E.entryAddrs, e.Contains c → CutBound E e c k :=
    fun e he hec => (barrier_joint hV hA hS he hc hec hk).1
  have ht : sd.t = sd.col.num 0 := (stopData_spec hsd).2.2.1
  have hres : c.resolve 0 sd.t = some sd.col := by
    rw [ht]; exact resolve_host_D8 (e := ⟨sd.col, j⟩) hbc
  have hcont : sd.col.container c = some ⟨sd.col, j⟩ :=
    (ColAddr.container_spec _ c _).2 ⟨rfl, hbc⟩
  have hbar : cutQuery (actualKeys E c) k < cutQuery (actualKeys E sd.col) (j + 1) :=
    cut_barrier_read hE hc hk hreach hres hcont
  have hWZ : cutQuery (actualKeys E c) k ≤ cutQuery (actualKeys E sd.col) sd.Q.length :=
    le_of_lt (lt_of_lt_of_le hbar (cutQuery_mono _ (by omega)))
  have hedge := decorated_host_edge_D8 hsd hres
  have hdecA : CondAK E (capKeys E (routeCols E)) := capping_forward hV hA hS (fun _ h => h)
  have hp1 := path_nesting hV hdecA c (cutQuery_noninc _ _) (cutQuery_noninc _ _) hWZ hedge
  have hp0 := capped_path_of_actual hV (sel := routeCols E) (fun _ h => h) hc hcut hreach
  exact actual_path_of_capped hV (fun _ h => h) hc hcut (hp0.trans hp1)

/-- G011-D1 (owner U2). Block form of a column `colH` with active index `eH` against a column
`colE` with active index `eE`: `colH` ends at `eH`, agrees with `colE` before `eH`, and the
entries `eH … eE` of `colE` all carry the label of `colH[eH]` (a deleted same-parent block
followed by the active entry). `eH = eE` is the unmoved case. -/
def BlockForm_D8 (colH colE : Column) (eH eE : Nat) : Prop :=
  colH.length = eH + 1 ∧ eH ≤ eE ∧ eE < colE.length ∧ colH.take eH = colE.take eH ∧
    ∀ x, eH ≤ x → x ≤ eE → (colE[x]?).map Prod.fst = (colH[eH]?).map Prod.fst

/-- G011-L5 (L4.2b item 1 with R7 on the `E` side). Two columns in block form give the same
response: `E`'s actual response under the `E`-barrier at its active entry equals the response of
`H`'s column capped at its active entry. -/
theorem resp_blockForm_D8 {E H : Forest} {oE oH : ColAddr} {eE eH : Nat}
    (hnum : oH.num 0 = oE.num 0)
    (hbf : BlockForm_D8 ((H.colAt oH).getD []) ((E.colAt oE).getD []) eH eE)
    {W : List (WithTop Key)} (hW : W.Pairwise fun x y => y ≤ x) (hT : ∀ y ∈ W, y ≠ ⊤)
    (hbar : W < cutQuery (actualKeys E oE) (eE + 1)) :
    resp E (actualKeys E) oE W = (parents H oH)[cursor (cappedAt (actualKeys H oH) eH) W]? := by
  obtain ⟨hlH, hle, hlE, htake, hlab⟩ := hbf
  set colH := (H.colAt oH).getD []
  set colE := (E.colAt oE).getD []
  set f : Nat × Forest → WithTop Key := fun x => ((relKey (oE.num 0) x.2 : Key) : WithTop Key)
  have hksE : actualKeys E oE = colE.map f := rfl
  have hksH : actualKeys H oH = colH.map f := by
    show colH.map _ = colH.map f; simp only [f, hnum]
  obtain ⟨q, hq⟩ : ∃ q, (colH[eH]?).map Prod.fst = some q := by
    have : eH < colH.length := by omega
    exact ⟨_, by rw [List.getElem?_eq_getElem this]; rfl⟩
  -- R7 on the `E` side
  have hlenE : eE < (actualKeys E oE).length := by rw [hksE, List.length_map]; exact hlE
  obtain ⟨hc1, hc2⟩ := cursor_cappedAt (actualKeys E oE) W eE hlenE hW hT hbar
  -- the capped `E` list is `pre ++ blk ++ [⊤]`
  set pre := (colH.map f).take eH
  set blk := ((colE.map f).drop eH).take (eE - eH)
  have hsplit : (actualKeys E oE).take eE ++ [⊤] = pre ++ blk ++ [⊤] := by
    have h1 : (colE.map f).take eE = (colE.map f).take eH ++ blk := by
      simp only [blk]
      rw [List.take_drop, show eH + (eE - eH) = eE by omega]
      conv_lhs => rw [← List.take_append_drop eH ((colE.map f).take eE)]
      rw [List.take_take, Nat.min_eq_left hle, List.drop_take]
    have h2 : (colE.map f).take eH = pre := by
      simp only [pre, ← List.map_take, htake]
    rw [hksE, h1, h2, List.append_assoc]
  have hcapH : cappedAt (actualKeys H oH) eH = pre ++ [⊤] := by simp [cappedAt, hksH, pre]
  have hblk : blk.length = eE - eH := by simp [blk]; omega
  have hpre : pre.length = eH := by simp [pre]; omega
  -- parents
  set ppre := (colH.take eH).map Prod.fst
  have hpH : parents H oH = ppre ++ [q] := by
    have hlt : eH < colH.length := by omega
    have hc : colH = colH.take eH ++ [colH[eH]] := by
      rw [List.take_append_getElem hlt, List.take_of_length_le (by omega)]
    have hq' : colH[eH].1 = q := by
      rw [List.getElem?_eq_getElem hlt] at hq; simpa using hq
    show colH.map Prod.fst = _
    rw [hc, List.map_append, List.map_singleton, hq']
  have hpE : (parents E oE).take (eE + 1) = ppre ++ List.replicate (blk.length + 1) q := by
    have hpl : ppre.length = eH := by simp [ppre]; omega
    apply List.ext_getElem?
    intro x
    rcases Nat.lt_or_ge x (eE + 1) with hx | hx
    · rw [List.getElem?_take_of_lt hx, show parents E oE = colE.map Prod.fst from rfl,
        List.getElem?_map]
      rcases Nat.lt_or_ge x eH with hxe | hxe
      · rw [List.getElem?_append_left (by omega)]
        simp only [ppre, List.getElem?_map, List.getElem?_take_of_lt hxe]
        have := congrArg (·[x]?) htake
        simp only [List.getElem?_take_of_lt hxe] at this
        rw [this]
      · rw [List.getElem?_append_right (by omega), hpl, List.getElem?_replicate,
          if_pos (by omega), hlab x hxe (by omega), hq]
    · rw [List.getElem?_eq_none (by simp; omega), List.getElem?_eq_none (by simp; omega)]
  have hcur : cursor (actualKeys E oE) W ≤ eE := hc1
  have hresp : resp E (actualKeys E) oE W =
      ((parents E oE).take (eE + 1))[cursor (actualKeys E oE) W]? := by
    simp only [resp, List.getElem?_take_of_lt (by omega : cursor (actualKeys E oE) W < eE + 1)]
    simp [parents, List.getElem?_map]
  rw [hresp, hpE, hc2, hsplit, hpH, hcapH]
  exact capped_block_resp pre blk ppre q W hT (by simp [ppre, hpre]; omega)

/-- G011-L11 helper: the containing entry of a column also contains every column inside the
height of an entry it contains. -/
theorem container_trans_D8 {o d : ColAddr} {e : EntryAddr} {u : Nat}
    (ho : o.container e.col = some ⟨o, u⟩) (hd : e.heightPath <+: d.path) :
    o.container d = some ⟨o, u⟩ := by
  obtain ⟨-, h2⟩ := (ColAddr.container_spec _ _ _).1 ho
  exact (ColAddr.container_spec _ _ _).2 ⟨rfl, h2.trans ((List.prefix_append _ _).trans hd)⟩

/-- G011-L1/L2 helper: the forests of `modifyColAux` along its path. -/
theorem forestAt_modifyColAux_take_E8 (f : Column → Column) (j : Nat) :
    ∀ (P : List (Nat × Nat)) (t : Forest) (n : Nat), n ≤ P.length →
    (Closure.modifyColAux f P j t).forestAt (P.take n) =
      (t.forestAt (P.take n)).map (Closure.modifyColAux f (P.drop n) j)
  | [], t, n, hn => by
    have : n = 0 := by simpa using hn
    subst this; rfl
  | (c0, i0) :: rest, .node cols, n, hn => by
    cases n with
    | zero => rfl
    | succ n =>
      rw [List.take_succ_cons, List.drop_succ_cons, Tree.forestAt_cons, Tree.forestAt_cons]
      simp only [Closure.modifyColAux, Tree.cols, List.getElem?_modify_eq]
      cases hc : cols[c0]? with
      | none => rfl
      | some col =>
        simp only [Option.map_eq_map, Option.map_some, Option.bind_some, List.getElem?_modify_eq]
        cases hx : col[i0]? with
        | none => rfl
        | some x =>
          simp only [Option.map_some, Option.bind_some]
          exact forestAt_modifyColAux_take_E8 f j rest x.2 n (by simp at hn; omega)

/-- G011-L1/L2 helper: `modifyColAux` at a containing level. -/
theorem modifyColAux_cons_E8 (f : Column → Column) (s : Nat × Nat) (rest : List (Nat × Nat))
    (j : Nat) (cols : List Column) :
    Closure.modifyColAux f (s :: rest) j (.node cols) =
      .node (cols.modify s.1 fun col =>
        col.modify s.2 fun x => (x.1, Closure.modifyColAux f rest j x.2)) := by
  obtain ⟨a, b⟩ := s; rfl

/-- G011-L1/L2 helper: `modifyColAux` at the level of the column. -/
theorem modifyColAux_nil_E8 (f : Column → Column) (j : Nat) (cols : List Column) :
    Closure.modifyColAux f [] j (.node cols) = .node (cols.modify j f) := rfl

/-- G011-L1/L2 helper: a column strictly above the modified column. -/
theorem colAt_modifyColAux_above_E8 (f : Column → Column) (π : List (Nat × Nat)) (J : Nat)
    (X : Forest) {L : Nat} (hL : L < π.length) (x : Nat) :
    (x ≠ π[L].1 → (Closure.modifyColAux f π J X).colAt ⟨π.take L, x⟩ = X.colAt ⟨π.take L, x⟩) ∧
    (Closure.modifyColAux f π J X).colAt ⟨π.take L, π[L].1⟩ =
      (X.colAt ⟨π.take L, π[L].1⟩).map (fun col => col.modify π[L].2
        (fun y => (y.1, Closure.modifyColAux f (π.drop (L + 1)) J y.2))) := by
  have h1 := forestAt_modifyColAux_take_E8 f J π X L hL.le
  rw [List.drop_eq_getElem_cons hL] at h1
  unfold Tree.colAt
  simp only
  rw [h1]
  cases X.forestAt (π.take L) with
  | none => simp
  | some F =>
    obtain ⟨cols⟩ := F
    simp only [Option.map_some, Option.bind_some, modifyColAux_cons_E8, Tree.cols]
    refine ⟨fun hx => ?_, ?_⟩
    · rw [List.getElem?_modify_ne _ _ (Ne.symm hx)]
    · rw [List.getElem?_modify_eq]; rfl

/-- G011-L1/L2 helper: a column at the level of the modified column. -/
theorem colAt_modifyColAux_at_E8 (f : Column → Column) (π : List (Nat × Nat)) (J : Nat)
    (X : Forest) (x : Nat) :
    (x ≠ J → (Closure.modifyColAux f π J X).colAt ⟨π, x⟩ = X.colAt ⟨π, x⟩) ∧
    (Closure.modifyColAux f π J X).colAt ⟨π, J⟩ = (X.colAt ⟨π, J⟩).map f := by
  have h1 := forestAt_modifyColAux_take_E8 f J π X π.length le_rfl
  rw [List.take_length, List.drop_length] at h1
  unfold Tree.colAt
  simp only
  rw [h1]
  cases X.forestAt π with
  | none => simp
  | some F =>
    obtain ⟨cols⟩ := F
    simp only [Option.map_some, Option.bind_some, modifyColAux_nil_E8, Tree.cols]
    refine ⟨fun hx => ?_, ?_⟩
    · rw [List.getElem?_modify_ne _ _ (Ne.symm hx)]
    · rw [List.getElem?_modify_eq]; rfl

/-- G011-L1/L2 helper: inside the modified column, an entry `e'` of the new column that is the
old entry `e` carries the same forests. -/
theorem forestAt_modifyColAux_inside_E8 (f : Column → Column) (π : List (Nat × Nat)) (J : Nat)
    {X : Forest} {col : Column} (hcol : X.colAt ⟨π, J⟩ = some col) {e e' : Nat}
    (he : (f col)[e']? = col[e]?) (σ : List (Nat × Nat)) :
    (Closure.modifyColAux f π J X).forestAt (π ++ (J, e') :: σ) =
      X.forestAt (π ++ (J, e) :: σ) := by
  have h1 := forestAt_modifyColAux_take_E8 f J π X π.length le_rfl
  rw [List.take_length, List.drop_length] at h1
  unfold Tree.colAt at hcol
  simp only at hcol
  rw [Tree.forestAt_append, Tree.forestAt_append, h1]
  cases hF : X.forestAt π with
  | none => rw [hF] at hcol; simp at hcol
  | some F =>
    rw [hF, Option.bind_some] at hcol
    obtain ⟨cols⟩ := F
    simp only [Tree.cols] at hcol
    simp only [Option.map_some, Option.bind_some, modifyColAux_nil_E8, Tree.forestAt_cons,
      Tree.cols, List.getElem?_modify_eq, hcol, Option.map_eq_map, Option.map_some, he]

/-- G011-L1/L2 helper: a legal move is the column modification `take i ++ drop j`. -/
theorem applyMove_eq_E8 {X : Forest} {m : Closure.Move} {col : Column}
    (hcol : X.colAt m.col = some col) (hij : m.i < m.j) (hj : m.j < col.length) :
    Closure.applyMove X m = Closure.modifyColAux (fun col => col.take m.i ++ col.drop m.j)
      m.col.path m.col.col X := by
  show Closure.applyMoveBody X m = _
  simp only [Closure.applyMoveBody, hcol, if_pos (And.intro hij hj)]
  rfl

/-- G011-L1/L2 helper: the retained entry of a move is at index `i`. -/
theorem moveCol_getElem_E8 {col : Column} {i j : Nat} (hij : i < j) (hj : j < col.length) :
    (col.take i ++ col.drop j)[i]? = col[j]? := by
  rw [List.getElem?_append_right (by simp)]
  simp only [List.length_take, Nat.min_eq_left (by omega : i ≤ col.length), Nat.sub_self,
    List.getElem?_drop, Nat.add_zero]

/-- G011-L1/L2 helper: a move of the last entry `j` to `i` leaves `i + 1` entries. -/
theorem moveCol_length_E8 {col : Column} {i j : Nat} (hij : i < j) (hj : j + 1 = col.length) :
    (col.take i ++ col.drop j).length = i + 1 := by
  simp only [List.length_append, List.length_take, List.length_drop]; omega

/-- G011-L1 helper: modifying the column list keeps the last step when column lengths are kept. -/
theorem lastStep_modify_E8 (cols : List Column) (a : Nat) (g : Column → Column)
    (hg : ∀ col, (g col).length = col.length) :
    Tree.lastStep? (Tree.node (cols.modify a g)) = Tree.lastStep? (Tree.node cols) := by
  unfold Tree.lastStep?
  simp only [Tree.cols]
  rw [List.getLast?_eq_getElem?, List.getLast?_eq_getElem?, List.length_modify,
    List.getElem?_modify]
  cases cols[cols.length - 1]? with
  | none => rfl
  | some col =>
    simp only [Option.map_eq_map, Option.map_some, Option.bind_some]
    have he : (g col).isEmpty = col.isEmpty := by
      have := hg col
      revert this
      cases g col <;> cases col <;> simp
    by_cases ha : a = cols.length - 1
    · simp only [ha, if_true, he, hg]
    · simp only [ha, if_false]

/-- G011-L1/L2 helper: column numbers read only column indices. -/
theorem num_of_fst_E8 {p p' : List (Nat × Nat)} (hp : p'.map Prod.fst = p.map Prod.fst)
    (x b : Nat) : (⟨p', x⟩ : ColAddr).num b = (⟨p, x⟩ : ColAddr).num b := by
  simp only [ColAddr.num]
  have : ∀ l : List (Nat × Nat), l.map (·.1 + 1) = (l.map Prod.fst).map (· + 1) := by
    intro l; simp [List.map_map, Function.comp_def]
  rw [this p', this p, hp]

/-- G011-L1/L2 helper: `resolve` reads only column indices. -/
theorem resolve_fst_E8 {c c' o : ColAddr} {q : Nat}
    (hp : c'.path.map Prod.fst = c.path.map Prod.fst) (hc : c'.col = c.col)
    (h : c.resolve 0 q = some o) :
    c'.resolve 0 q = some ⟨c'.path.take o.path.length, o.col⟩ := by
  obtain ⟨hs, hn⟩ := (ColAddr.resolve_spec 0 c o q).1 h
  rw [ColAddr.resolve_spec]
  have hlen : c'.path.length = c.path.length := by simpa using congrArg List.length hp
  have hget : ∀ k : Nat, (c'.path[k]?).map Prod.fst = (c.path[k]?).map Prod.fst := by
    intro k; rw [← List.getElem?_map, ← List.getElem?_map, hp]
  have hnum : ∀ L, (⟨c'.path.take L, o.col⟩ : ColAddr).num 0 = (⟨c.path.take L, o.col⟩ : ColAddr).num 0 := by
    intro L; apply num_of_fst_E8; rw [List.map_take, List.map_take, hp]
  rcases hs with ⟨k, ck, ik, hk, hpth, hle⟩ | ⟨hpth, hlt⟩
  · have hk' : k < c.path.length := (List.getElem?_eq_some_iff.1 hk).1
    obtain ⟨ik', hk''⟩ : ∃ ik', c'.path[k]? = some (ck, ik') := by
      have := hget k; rw [hk] at this
      cases h' : c'.path[k]? with
      | none => simp [h'] at this
      | some s => obtain ⟨a, b⟩ := s; simp [h'] at this; exact ⟨b, by rw [this]⟩
    have hol : o.path.length = k := by rw [hpth, List.length_take]; omega
    refine ⟨Or.inl ⟨k, ck, ik', hk'', by simp [hol], hle⟩, ?_⟩
    rw [hol, hnum, ← hpth, ← hn]
  · have hol : o.path.length = c.path.length := by rw [hpth]
    refine ⟨Or.inr ⟨by simp [hol, hlen], by simp [hc]; exact hlt⟩, ?_⟩
    rw [hnum, hol, List.take_length, ← hpth, ← hn]

/-- G011-L1/L2 helper: the container of a stack-level column, read from the path. -/
theorem container_take_E8 (c : ColAddr) (L x : Nat) :
    (⟨c.path.take L, x⟩ : ColAddr).container c =
      (c.path[L]?).bind (fun s => if s.1 = x then some ⟨⟨c.path.take L, x⟩, s.2⟩ else none) := by
  unfold ColAddr.container
  simp only [List.length_take]
  rcases Nat.lt_or_ge L c.path.length with hL | hL
  · rw [Nat.min_eq_left hL.le, List.drop_eq_getElem_cons hL, List.getElem?_eq_getElem hL]
    simp
  · rw [Nat.min_eq_right hL, List.drop_length, List.getElem?_eq_none hL]
    rfl

/-- G011-L1/L2 helper: a stack column is read along the path. -/
theorem onStack_eq_take_E8 {c o : ColAddr} (h : c.OnStack o) :
    o = ⟨c.path.take o.path.length, o.col⟩ := by
  have := List.prefix_iff_eq_take.1 (onStack_path_prefix h)
  obtain ⟨op, oc⟩ := o
  simp only at this ⊢
  rw [← this]

/-- G011-L1/L2: the alternative of the stack correspondence at one number. -/
def StackAlt_E8 (E X : Forest) (c oX cE oE : ColAddr) : Prop :=
  (oX.container c = none ∧ oE.container cE = none ∧ X.colAt oX = E.colAt oE) ∨
  (∃ eX eE, oX.container c = some ⟨oX, eX⟩ ∧ oE.container cE = some ⟨oE, eE⟩ ∧
    BlockForm_D8 ((X.colAt oX).getD []) ((E.colAt oE).getD []) eX eE)

/-- G011-L1/L2: the stack correspondence below the number of `cE`. -/
def StackRel_E8 (E : Forest) (cE : ColAddr) (X : Forest) (c : ColAddr) : Prop :=
  ∀ q, q < cE.num 0 → ∃ oX oE, c.resolve 0 q = some oX ∧ cE.resolve 0 q = some oE ∧
    StackAlt_E8 E X c oX cE oE

/-- G011-L1/L2 helper: transfer of the alternative to a new column. -/
theorem stackAlt_transfer_E8 {E X X' : Forest} {c c' oX oX' cE oE : ColAddr}
    (halt : StackAlt_E8 E X c oX cE oE)
    (hcl : oX.container c = none → oX'.container c' = none ∧ X'.colAt oX' = X.colAt oX)
    (hbl : ∀ e, oX.container c = some ⟨oX, e⟩ → ∀ eE, BlockForm_D8 ((X.colAt oX).getD [])
      ((E.colAt oE).getD []) e eE → ∃ e', oX'.container c' = some ⟨oX', e'⟩ ∧
        BlockForm_D8 ((X'.colAt oX').getD []) ((E.colAt oE).getD []) e' eE) :
    StackAlt_E8 E X' c' oX' cE oE := by
  rcases halt with ⟨h1, h2, h3⟩ | ⟨eX, eE, h1, h2, h3⟩
  · obtain ⟨h4, h5⟩ := hcl h1
    exact Or.inl ⟨h4, h2, h5.trans h3⟩
  · obtain ⟨e', h4, h5⟩ := hbl eX h1 eE h3
    exact Or.inr ⟨e', eE, h4, h2, h5⟩

/-- G011-L1/L2 helper: block form survives a change of heights of the active entry. -/
theorem blockForm_modify_E8 {col colE : Column} {e eE : Nat} (g : Forest → Forest)
    (h : BlockForm_D8 col colE e eE) :
    BlockForm_D8 (col.modify e fun y => (y.1, g y.2)) colE e eE := by
  obtain ⟨h1, h2, h3, h4, h5⟩ := h
  refine ⟨by rw [List.length_modify]; exact h1, h2, h3, ?_, ?_⟩
  · rw [List.take_modify, List.modify_eq_self (by simp)]; exact h4
  · intro x hx1 hx2
    rw [h5 x hx1 hx2, List.getElem?_modify_eq]
    cases col[e]? <;> rfl

/-- G011-L1 step (route level): block form after a move in the column. -/
theorem blockForm_move_E8 {col colE : Column} {i j eE : Nat} (hbf : BlockForm_D8 col colE j eE)
    (hij : i < j)
    (hlab : ∀ x, i ≤ x → x ≤ j → (col[x]?).map Prod.fst = (col[j]?).map Prod.fst) :
    BlockForm_D8 (col.take i ++ col.drop j) colE i eE := by
  obtain ⟨h1, h2, h3, h4, h5⟩ := hbf
  have hi : (col.take i ++ col.drop j)[i]? = col[j]? := moveCol_getElem_E8 hij (by omega)
  refine ⟨moveCol_length_E8 hij h1.symm, by omega, h3, ?_, ?_⟩
  · rw [List.take_left' (by simp; omega)]
    have : col.take i = (col.take j).take i := by rw [List.take_take, Nat.min_eq_left hij.le]
    rw [this, h4, List.take_take, Nat.min_eq_left hij.le]
  · intro x hx1 hx2
    rw [hi]
    rcases Nat.lt_or_ge x j with hxj | hxj
    · have := congrArg (·[x]?) h4
      simp only [List.getElem?_take_of_lt hxj] at this
      rw [← this]; exact hlab x hx1 hxj.le
    · exact h5 x hxj hx2

/-- G011-L1/L2 helper: equal path steps at a level give the same container shape. -/
theorem container_shape_E8 {c c' : ColAddr} {L x : Nat} (h : c'.path[L]? = c.path[L]?) :
    (⟨c'.path.take L, x⟩ : ColAddr).container c' =
      ((⟨c.path.take L, x⟩ : ColAddr).container c).map
        (fun e => ⟨⟨c'.path.take L, x⟩, e.idx⟩) := by
  rw [container_take_E8, container_take_E8, h]
  cases c.path[L]? with
  | none => rfl
  | some s => simp only [Option.bind_some]; split_ifs <;> rfl

/-- G011-L1/L2 helper: an unchanged column keeps the alternative. -/
theorem stackAlt_same_E8 {E X X' : Forest} {c c' oX oX' cE oE : ColAddr}
    (halt : StackAlt_E8 E X c oX cE oE)
    (hcont : oX'.container c' = (oX.container c).map (fun e => ⟨oX', e.idx⟩))
    (hcol : X'.colAt oX' = X.colAt oX) : StackAlt_E8 E X' c' oX' cE oE := by
  refine stackAlt_transfer_E8 halt (fun h => ⟨by rw [hcont, h]; rfl, hcol⟩) ?_
  intro e he eE hbf
  exact ⟨e, by rw [hcont, he]; rfl, by rw [hcol]; exact hbf⟩

/-- G011-L1/L2 helper: a containing column whose active height changed keeps the
alternative. -/
theorem stackAlt_modify_E8 {E X X' : Forest} {c c' oX oX' cE oE : ColAddr} {e : Nat}
    (g : Forest → Forest) (halt : StackAlt_E8 E X c oX cE oE)
    (hc : oX.container c = some ⟨oX, e⟩) (hc' : oX'.container c' = some ⟨oX', e⟩)
    (hcol : X'.colAt oX' = (X.colAt oX).map (fun col => col.modify e fun y => (y.1, g y.2))) :
    StackAlt_E8 E X' c' oX' cE oE := by
  refine stackAlt_transfer_E8 halt (fun h => by rw [hc] at h; cases h) ?_
  intro e₁ he₁ eE hbf
  rw [hc] at he₁
  simp only [Option.some.injEq, EntryAddr.mk.injEq, true_and] at he₁
  subst he₁
  refine ⟨e, hc', ?_⟩
  cases hX : X.colAt oX with
  | none => rw [hX] at hbf; exact absurd hbf.1 (by simp)
  | some colo =>
    rw [hcol, hX]; rw [hX] at hbf
    exact blockForm_modify_E8 g hbf

/-- G011-L1/L2 step helper: a stack column strictly above the move column. -/
theorem stackAlt_above_E8 {E X : Forest} {c c' cE oE : ColAddr} (f : Column → Column)
    (π : List (Nat × Nat)) (J : Nat) {L x : Nat} (hL : L < π.length)
    (h1 : c.path.take L = π.take L) (h1' : c'.path.take L = π.take L)
    (h2 : c.path[L]? = π[L]?) (h2' : c'.path[L]? = π[L]?)
    (halt : StackAlt_E8 E X c ⟨π.take L, x⟩ cE oE) :
    StackAlt_E8 E (Closure.modifyColAux f π J X) c' ⟨π.take L, x⟩ cE oE := by
  have hc1 := container_take_E8 c L x
  have hc2 := container_take_E8 c' L x
  rw [h1, h2, List.getElem?_eq_getElem hL, Option.bind_some] at hc1
  rw [h1', h2', List.getElem?_eq_getElem hL, Option.bind_some] at hc2
  have hab := colAt_modifyColAux_above_E8 f π J X hL x
  by_cases hx : π[L].1 = x
  · rw [if_pos hx] at hc1 hc2
    subst hx
    exact stackAlt_modify_E8 _ halt hc1 hc2 hab.2
  · rw [if_neg hx] at hc1 hc2
    exact stackAlt_same_E8 halt (by rw [hc1, hc2]; rfl) (hab.1 (Ne.symm hx))

/-- G011-L1/L2 helper: prefixes of a path through a middle step. -/
theorem take_mid_E8 (π ρ : List (Nat × Nat)) (s : Nat × Nat) (t : Nat) :
    (π ++ s :: ρ).take (π.length + 1 + t) = π ++ s :: ρ.take t := by
  rw [List.take_append, List.take_of_length_le (by omega),
    show π.length + 1 + t - π.length = t + 1 by omega, List.take_succ_cons]

/-- G011-L1/L2 helper: steps of a path after a middle step. -/
theorem getElem_mid_E8 (π ρ : List (Nat × Nat)) (s : Nat × Nat) (t : Nat) :
    (π ++ s :: ρ)[π.length + 1 + t]? = ρ[t]? := by
  rw [List.getElem?_append_right (by omega), show π.length + 1 + t - π.length = t + 1 by omega,
    List.getElem?_cons_succ]

/-- G011-L1/L2 step: one move in a containing column (or in the column itself) carries the stack
correspondence to the moved column. -/
theorem stackRel_move_E8 {E X : Forest} {cE c : ColAddr} {m : Closure.Move} {col : Column}
    (hcol : X.colAt m.col = some col) (hij : m.i < m.j) (hj : m.j + 1 = col.length)
    (hlab : ∀ x, m.i ≤ x → x ≤ m.j → (col[x]?).map Prod.fst = (col[m.j]?).map Prod.fst)
    (hpos : m.col = c ∨ (⟨m.col, m.j⟩ : EntryAddr).heightPath <+: c.path)
    (hst : StackRel_E8 E cE X c) :
    StackRel_E8 E cE (Closure.applyMove X m) ⟨m.mapPath m.fwdIdx c.path, c.col⟩ := by
  obtain ⟨⟨π, J⟩, i, j⟩ := m
  simp only at hcol hij hj hlab hpos ⊢
  rw [applyMove_eq_E8 hcol hij (by show j < col.length; omega)]
  simp only
  set f : Column → Column := fun col => col.take i ++ col.drop j with hf
  rcases hpos with hpos | hpre
  · -- the move is in the column itself
    subst hpos
    have hmp : Closure.Move.mapPath (Closure.Move.fwdIdx ⟨⟨π, J⟩, i, j⟩) ⟨⟨π, J⟩, i, j⟩ π = π := by
      unfold Closure.Move.mapPath; simp
    rw [hmp]
    intro q hq
    obtain ⟨oX, oE, hoX, hoE, halt⟩ := hst q hq
    have hs : (⟨π, J⟩ : ColAddr).OnStack oX := ((ColAddr.resolve_spec 0 _ oX q).1 hoX).1
    have hpfx := onStack_path_prefix hs
    obtain ⟨op, x⟩ := oX
    obtain ⟨L, hLc, rfl⟩ : ∃ L, L ≤ π.length ∧ op = π.take L :=
      ⟨op.length, hpfx.length_le, List.prefix_iff_eq_take.1 hpfx⟩
    refine ⟨_, oE, hoX, hoE, ?_⟩
    rcases Nat.lt_or_ge L π.length with hlt | hge
    · exact stackAlt_above_E8 f π J hlt rfl rfl rfl rfl halt
    · have hL : L = π.length := by omega
      subst hL
      have hxJ : x < J := by
        rcases hs with ⟨k, ck, ik, hk, hp, -⟩ | ⟨-, hlt⟩
        · exfalso
          have h1 : k < π.length := (List.getElem?_eq_some_iff.1 hk).1
          have h2 := congrArg List.length hp
          simp only [List.length_take] at h2
          omega
        · exact hlt
      have hc1 := container_take_E8 ⟨π, J⟩ π.length x
      simp only [List.getElem?_eq_none (le_refl π.length), Option.bind_none] at hc1
      exact stackAlt_same_E8 halt (by rw [hc1]; rfl)
        (by rw [List.take_length]; exact (colAt_modifyColAux_at_E8 f π J X x).1 (by omega))
  · -- the move column contains the column
    obtain ⟨ρ, hρ⟩ := hpre
    obtain ⟨cp, cc⟩ := c
    simp only [EntryAddr.heightPath, List.append_assoc, List.singleton_append] at hρ
    subst hρ
    have hmp : Closure.Move.mapPath (Closure.Move.fwdIdx ⟨⟨π, J⟩, i, j⟩) ⟨⟨π, J⟩, i, j⟩
        (π ++ (J, j) :: ρ) = π ++ (J, i) :: ρ := by
      unfold Closure.Move.mapPath Closure.Move.fwdIdx; simp; omega
    rw [hmp]
    intro q hq
    obtain ⟨oX, oE, hoX, hoE, halt⟩ := hst q hq
    have hs : (⟨π ++ (J, j) :: ρ, cc⟩ : ColAddr).OnStack oX :=
      ((ColAddr.resolve_spec 0 _ oX q).1 hoX).1
    have hpfx := onStack_path_prefix hs
    have hres := @resolve_fst_E8 ⟨π ++ (J, j) :: ρ, cc⟩ ⟨π ++ (J, i) :: ρ, cc⟩ _ _ (by simp) rfl hoX
    obtain ⟨op, x⟩ := oX
    obtain ⟨L, hLc, rfl⟩ : ∃ L, L ≤ (π ++ (J, j) :: ρ).length ∧ op = (π ++ (J, j) :: ρ).take L :=
      ⟨op.length, hpfx.length_le, List.prefix_iff_eq_take.1 hpfx⟩
    simp only [List.length_take, Nat.min_eq_left hLc] at hres
    refine ⟨_, oE, hres, hoE, ?_⟩
    simp only
    rcases Nat.lt_trichotomy L π.length with hlt | heq | hgt
    · rw [List.take_append_of_le_length hlt.le] at halt ⊢
      exact stackAlt_above_E8 f π J hlt (List.take_append_of_le_length hlt.le)
        (List.take_append_of_le_length hlt.le) (List.getElem?_append_left hlt)
        (List.getElem?_append_left hlt) halt
    · subst heq
      rw [List.take_left' rfl] at halt ⊢
      have hc1 := container_take_E8 ⟨π ++ (J, j) :: ρ, cc⟩ π.length x
      have hc2 := container_take_E8 ⟨π ++ (J, i) :: ρ, cc⟩ π.length x
      simp only [List.take_left' rfl, List.getElem?_append_right (le_refl _), Nat.sub_self,
        List.getElem?_cons_zero, Option.bind_some] at hc1 hc2
      have hat := colAt_modifyColAux_at_E8 f π J X x
      by_cases hx : J = x
      · rw [if_pos hx] at hc1 hc2
        subst hx
        refine stackAlt_transfer_E8 halt (fun h => by rw [hc1] at h; cases h) ?_
        intro e he eE hbf
        rw [hc1] at he
        simp only [Option.some.injEq, EntryAddr.mk.injEq, true_and] at he
        subst he
        refine ⟨i, hc2, ?_⟩
        have hcol' : X.colAt ⟨π, J⟩ = some col := hcol
        rw [hat.2, hcol', Option.map_some, Option.getD_some]
        rw [hcol', Option.getD_some] at hbf
        exact blockForm_move_E8 hbf hij hlab
      · rw [if_neg hx] at hc1 hc2
        exact stackAlt_same_E8 halt (by rw [hc1, hc2]; rfl) (hat.1 (Ne.symm hx))
    · obtain ⟨t, rfl⟩ : ∃ t, L = π.length + 1 + t := ⟨L - π.length - 1, by omega⟩
      have hcs := container_shape_E8 (c := ⟨π ++ (J, j) :: ρ, cc⟩) (c' := ⟨π ++ (J, i) :: ρ, cc⟩)
        (L := π.length + 1 + t) (x := x) (by simp only [getElem_mid_E8])
      refine stackAlt_same_E8 halt hcs ?_
      have hcol' : X.colAt ⟨π, J⟩ = some col := hcol
      unfold Tree.colAt
      simp only [take_mid_E8]
      rw [forestAt_modifyColAux_inside_E8 f π J hcol' (moveCol_getElem_E8 hij (by omega))]

/-- G011-L1 helper: route paths are prefixes of each other. -/
theorem isRoutePath_take_E8 {X : Forest} {π σ : List (Nat × Nat)} (hπ : IsRoutePath X π)
    (hσ : IsRoutePath X σ) (hle : π.length ≤ σ.length) : σ.take π.length = π := by
  suffices h : ∀ d, d ≤ π.length → σ.take d = π.take d by
    rw [h _ le_rfl, List.take_length]
  intro d
  induction d with
  | zero => intro _; rfl
  | succ d ih =>
    intro hd
    have h1 := ih (by omega)
    obtain ⟨F, hF, hl⟩ := hπ d (by omega)
    obtain ⟨F', hF', hl'⟩ := hσ d (by omega)
    rw [h1, hF] at hF'
    cases hF'
    rw [List.take_add_one, List.take_add_one, h1, ← hl', hl]

/-- G011-L1 helper: a route column whose column ends with an empty height is not followed by
another route column. -/
theorem route_stop_not_lt_E8 {X : Forest} {c d : ColAddr} (hc : c ∈ routeCols X)
    (hd : d ∈ routeCols X) {Q : Column} {r : Nat}
    (hcc : X.colAt c = some (Q ++ [(r, Tree.empty)])) : ¬ c.path.length < d.path.length := by
  intro hlt
  obtain ⟨hrc, F, hF, hFl⟩ := (Scan.mem_routeCols_iff X c).1 hc
  obtain ⟨hrd, G, hG, hGl⟩ := (Scan.mem_routeCols_iff X d).1 hd
  have htk := isRoutePath_take_E8 hrc hrd hlt.le
  have hFc : F.cols[c.col]? = some (Q ++ [(r, Tree.empty)]) := by
    simpa [Tree.colAt, hF] using hcc
  have hlast : F.lastStep? = some (c.col, Q.length) := by
    unfold Tree.lastStep?
    rw [List.getLast?_eq_getElem?, show F.cols.length - 1 = c.col by omega, hFc]
    simp
  obtain ⟨F', hF', hl'⟩ := hrd c.path.length hlt
  rw [htk, hF] at hF'
  cases hF'
  rw [hlast] at hl'
  have hE : X.forestAt (d.path.take (c.path.length + 1)) = some Tree.empty := by
    rw [List.take_add_one, htk, ← hl', Option.toList_some, Tree.forestAt_append, hF,
      Option.bind_some, Tree.forestAt_cons, hFc]
    simp [Tree.forestAt]
  rcases Nat.lt_or_ge (c.path.length + 1) d.path.length with h2 | h2
  · obtain ⟨F'', hF'', hl''⟩ := hrd (c.path.length + 1) h2
    rw [hE] at hF''
    cases hF''
    have : d.path[c.path.length + 1]? ≠ none := by simp; omega
    rw [← hl''] at this
    exact this (by simp [Tree.lastStep?, Tree.empty, Tree.cols])
  · rw [List.take_of_length_le h2, hG] at hE
    cases hE
    simp [Tree.empty, Tree.cols] at hGl

/-- G011-L1 helper: a route column whose column ends with an empty height is the only one. -/
theorem route_stop_unique_E8 {X : Forest} {c d : ColAddr} (hc : c ∈ routeCols X)
    (hd : d ∈ routeCols X) {Q Q' : Column} {r r' : Nat}
    (hcc : X.colAt c = some (Q ++ [(r, Tree.empty)]))
    (hdc : X.colAt d = some (Q' ++ [(r', Tree.empty)])) : c = d := by
  have h1 := route_stop_not_lt_E8 hc hd hcc
  have h2 := route_stop_not_lt_E8 hd hc hdc
  obtain ⟨hrc, F, hF, hFl⟩ := (Scan.mem_routeCols_iff X c).1 hc
  obtain ⟨hrd, G, hG, hGl⟩ := (Scan.mem_routeCols_iff X d).1 hd
  have hlen : c.path.length = d.path.length := by omega
  have htk := isRoutePath_take_E8 hrc hrd hlen.le
  rw [hlen, List.take_length] at htk
  rw [← htk, hG] at hF
  cases hF
  obtain ⟨cp, cc⟩ := c
  obtain ⟨dp, dc⟩ := d
  simp only at htk hFl hGl ⊢
  subst htk
  simp only [ColAddr.mk.injEq, true_and]
  omega

/-- G011-L1 helper: the moved column is a route column of the moved expression. -/
theorem routeCols_move_E8 {X : Forest} {π ρ : List (Nat × Nat)} {J i j cc : Nat} {col : Column}
    (hc : (⟨π ++ (J, j) :: ρ, cc⟩ : ColAddr) ∈ routeCols X) (hcol : X.colAt ⟨π, J⟩ = some col)
    (hij : i < j) (hj : j + 1 = col.length) :
    (⟨π ++ (J, i) :: ρ, cc⟩ : ColAddr) ∈
      routeCols (Closure.modifyColAux (fun col => col.take i ++ col.drop j) π J X) := by
  set f : Column → Column := fun col => col.take i ++ col.drop j with hf
  obtain ⟨hr, F, hF, hFl⟩ := (Scan.mem_routeCols_iff X _).1 hc
  have hin : ∀ σ, (Closure.modifyColAux f π J X).forestAt (π ++ (J, i) :: σ) =
      X.forestAt (π ++ (J, j) :: σ) :=
    forestAt_modifyColAux_inside_E8 f π J hcol (moveCol_getElem_E8 hij (by omega))
  rw [Scan.mem_routeCols_iff]
  refine ⟨?_, F, by simp only; rw [hin]; exact hF, hFl⟩
  intro d hd
  simp only [List.length_append, List.length_cons] at hd
  rcases Nat.lt_trichotomy d π.length with hlt | heq | hgt
  · obtain ⟨F0, hF0, hl0⟩ := hr d (by simp; omega)
    simp only [List.take_append_of_le_length hlt.le, List.getElem?_append_left hlt] at hF0 hl0 ⊢
    have h1 := forestAt_modifyColAux_take_E8 f J π X d hlt.le
    rw [hF0, Option.map_some, List.drop_eq_getElem_cons hlt] at h1
    refine ⟨_, h1, ?_⟩
    obtain ⟨cols⟩ := F0
    rw [modifyColAux_cons_E8, lastStep_modify_E8 _ _ _ (fun col => List.length_modify _ _ _)]
    exact hl0
  · subst heq
    obtain ⟨F0, hF0, hl0⟩ := hr π.length (by simp)
    simp only [List.take_left' rfl, List.getElem?_append_right (le_refl _), Nat.sub_self,
      List.getElem?_cons_zero] at hF0 hl0 ⊢
    have h1 := forestAt_modifyColAux_take_E8 f J π X π.length le_rfl
    rw [List.take_length, List.drop_length, hF0, Option.map_some] at h1
    refine ⟨_, h1, ?_⟩
    obtain ⟨col0, p0, h0, hc0, he0, hs0, -⟩ := Scan.lastStep?_eq_some hl0
    simp only [Prod.mk.injEq] at hs0
    obtain ⟨hJ, hj0⟩ := hs0
    have hFc : F0.cols[J]? = some col := by simpa [Tree.colAt, hF0] using hcol
    obtain ⟨cols⟩ := F0
    simp only [Tree.cols] at hFc hJ hc0 ⊢
    rw [modifyColAux_nil_E8]
    unfold Tree.lastStep?
    simp only [Tree.cols]
    rw [List.getLast?_eq_getElem?, List.length_modify, ← hJ, List.getElem?_modify_eq, hFc]
    have hlen : (f col).length = i + 1 := moveCol_length_E8 hij hj
    have hne : (f col).isEmpty = false := by
      cases h : f col with
      | nil => rw [h] at hlen; simp at hlen
      | cons _ _ => rfl
    simp only [Option.map_eq_map, Option.map_some, Option.bind_some, hne, Bool.false_eq_true,
      if_false, hlen, Nat.add_sub_cancel]
  · obtain ⟨t, rfl⟩ : ∃ t, d = π.length + 1 + t := ⟨d - π.length - 1, by omega⟩
    obtain ⟨F0, hF0, hl0⟩ := hr (π.length + 1 + t) (by simp; omega)
    rw [take_mid_E8] at hF0 ⊢
    rw [getElem_mid_E8] at hl0 ⊢
    exact ⟨F0, by rw [hin]; exact hF0, hl0⟩

/-- G011-L1 (I1): after a legal move of the stopping route, the stopping column is the moved
column. -/
theorem stop_move_E8 {X : Forest} {sd sd' : StopData} {m : Closure.Move} {col : Column}
    (hsd : stopData X = some sd) (hcol : X.colAt m.col = some col) (hij : m.i < m.j)
    (hj : m.j + 1 = col.length) (hpre : (⟨m.col, m.j⟩ : EntryAddr).heightPath <+: sd.col.path)
    (hsd' : stopData (Closure.applyMove X m) = some sd') :
    sd'.col = ⟨m.mapPath m.fwdIdx sd.col.path, sd.col.col⟩ := by
  obtain ⟨hcolsd, -, -, hmem, -, -⟩ := stopData_spec hsd
  obtain ⟨hcolsd', -, -, hmem', -, -⟩ := stopData_spec hsd'
  generalize sd.col = c at hcolsd hmem hpre ⊢
  obtain ⟨⟨π, J⟩, i, j⟩ := m
  simp only at hcol hij hj hpre hsd' hmem' hcolsd' ⊢
  rw [applyMove_eq_E8 hcol hij (by show j < col.length; omega)] at hmem' hcolsd'
  simp only at hmem' hcolsd'
  obtain ⟨ρ, hρ⟩ := hpre
  obtain ⟨cp, cc⟩ := c
  simp only [EntryAddr.heightPath, List.append_assoc, List.singleton_append] at hρ
  subst hρ
  have hmp : Closure.Move.mapPath (Closure.Move.fwdIdx ⟨⟨π, J⟩, i, j⟩) ⟨⟨π, J⟩, i, j⟩
      (π ++ (J, j) :: ρ) = π ++ (J, i) :: ρ := by
    unfold Closure.Move.mapPath Closure.Move.fwdIdx; simp; omega
  simp only
  rw [hmp]
  have hc' := routeCols_move_E8 hmem hcol hij hj
  have hcc' : (Closure.modifyColAux (fun col => col.take i ++ col.drop j) π J X).colAt
      ⟨π ++ (J, i) :: ρ, cc⟩ = some (sd.Q ++ [(sd.r, Tree.empty)]) := by
    rw [← hcolsd]
    unfold Tree.colAt
    simp only
    rw [forestAt_modifyColAux_inside_E8 _ π J hcol (moveCol_getElem_E8 hij (by omega))]
  exact route_stop_unique_E8 hmem' hc' hcolsd' hcc'

/-- G011-L1/L2 helper: a move rewrites only entry indices of paths. -/
theorem mapPath_fst_E8 (m : Closure.Move) (g : Nat → Nat) (π : List (Nat × Nat)) :
    (m.mapPath g π).map Prod.fst = π.map Prod.fst := by
  unfold Closure.Move.mapPath
  split_ifs with h1
  · split
    · rename_i c e he
      split_ifs with h2
      · have hlt : m.col.path.length < π.length := (List.getElem?_eq_some_iff.1 he).1
        have hget := (List.getElem?_eq_some_iff.1 he).2
        conv_rhs => rw [← List.take_append_drop m.col.path.length π, List.drop_eq_getElem_cons hlt]
        rw [hget]
        simp
      · rfl
    · rfl
  · rfl

/-- G011-L1/L2 base helper: a truncated active column is in block form against itself. -/
theorem blockForm_trunc_E8 {col : Column} {u q : Nat} {X X' : Forest}
    (hu : col[u]? = some (q, X)) : BlockForm_D8 (col.take u ++ [(q, X')]) col u u := by
  have hul : u < col.length := (List.getElem?_eq_some_iff.1 hu).1
  refine ⟨by simp; omega, le_rfl, hul, by rw [List.take_left' (by simp; omega)], ?_⟩
  intro x h1 h2
  have : x = u := by omega
  subst this
  rw [hu, List.getElem?_append_right (by simp)]
  simp [Nat.min_eq_left hul.le]

/-- G011-L1/L2 base: a tree that keeps the closed stack columns and truncates the containing ones
at their active entries is in stack correspondence with the original. -/
theorem stackRel_base_E8 {E G : Forest} {c : ColAddr}
    (hcl : ∀ o, c.OnStack o → o.container c = none → G.colAt o = E.colAt o)
    (hbl : ∀ o u, o.container c = some ⟨o, u⟩ → ∃ (col : Column) (q : Nat) (X X' : Forest),
      E.colAt o = some col ∧ col[u]? = some (q, X) ∧ G.colAt o = some (col.take u ++ [(q, X')])) :
    StackRel_E8 E c G c := by
  intro q hq
  obtain ⟨o, ho⟩ := Option.isSome_iff_exists.1
    ((ColAddr.resolve_isSome_iff 0 c q).2 ⟨Nat.zero_le _, hq⟩)
  have hs : c.OnStack o := ((ColAddr.resolve_spec 0 c o q).1 ho).1
  refine ⟨o, o, ho, ho, ?_⟩
  rcases hc : o.container c with _ | e
  · exact Or.inl ⟨hc, hc, hcl o hs hc⟩
  · obtain ⟨he, -⟩ := (ColAddr.container_spec _ _ _).1 hc
    obtain ⟨eo, u⟩ := e
    simp only at he
    subst he
    obtain ⟨col, q', X, X', h1, h2, h3⟩ := hbl eo u hc
    exact Or.inr ⟨u, u, hc, hc, by rw [h1, h3]; exact blockForm_trunc_E8 h2⟩

/-- G011-L1 base: the literal cap. -/
theorem cap_base_E8 {E : Forest} {c : ColAddr} {k p : Nat} (hc : c ∈ E.colAddrs) :
    StackRel_E8 E c (Closure.litCap E c k p) c := by
  refine stackRel_base_E8 (fun o ho hno => (Closure.colAt_litCap_onStack hc ho).2 hno)
    (fun o u hou => ?_)
  obtain ⟨-, hd⟩ := (ColAddr.container_spec _ _ _).1 hou
  obtain ⟨colX, q, h, h', h1, h2, h3⟩ := litCap_colAt_container_D8 (k := k) (p := p) hc hd
  exact ⟨colX, q, h, h', h1, h2, h3⟩

/-- G011-L1/L2 helper: one more move. -/
theorem applyMoves_take_succ_E8 (K : Forest) (ms : List Closure.Move) {n : Nat}
    (hn : n < ms.length) :
    Closure.applyMoves K (ms.take (n + 1)) =
      Closure.applyMove (Closure.applyMoves K (ms.take n)) ms[n] := by
  rw [List.take_add_one, List.getElem?_eq_getElem hn, Option.toList_some]
  simp only [Closure.applyMoves, List.foldl_append, List.foldl_cons, List.foldl_nil]

/-- G011-L1: the induction along the moves of an admissible cap. -/
theorem cap_inv_E8 {E : Forest} (w : Closure.AdmCap E) :
    ∀ n, n ≤ w.moves.length → ∀ sd, stopData (Closure.applyMoves
        (Closure.litCap E w.col w.cut w.par) (w.moves.take n)) = some sd →
      sd.col.path.map Prod.fst = w.col.path.map Prod.fst ∧ sd.col.col = w.col.col ∧
      StackRel_E8 E w.col (Closure.applyMoves (Closure.litCap E w.col w.cut w.par)
        (w.moves.take n)) sd.col := by
  have hc : w.col ∈ E.colAddrs := by
    have hup := w.upward
    unfold Closure.IsUpward at hup
    rw [Tree.mem_colAddrs_iff]
    split at hup
    · rename_i col hcol; rw [hcol]; rfl
    · exact hup.elim
  intro n
  induction n with
  | zero =>
    intro _ sd hsd
    simp only [List.take_zero] at hsd ⊢
    have h0 : Closure.applyMoves (Closure.litCap E w.col w.cut w.par) [] =
        Closure.litCap E w.col w.cut w.par := rfl
    rw [h0, Closure.stopData_litCap w.upward] at hsd
    cases hsd
    rw [h0]
    exact ⟨rfl, rfl, cap_base_E8 hc⟩
  | succ n ih =>
    intro hn sd hsd
    have hn' : n < w.moves.length := by omega
    obtain ⟨col, sd0, q, Hi, C, hcol, hsd0, hj, hij, hpre, hi, hjq, hlab0, -⟩ :=
      Closure.moves_violate w n hn'
    obtain ⟨hf, hcc, hst⟩ := ih (by omega) sd0 hsd0
    rw [applyMoves_take_succ_E8 _ _ hn'] at hsd ⊢
    generalize Closure.applyMoves (Closure.litCap E w.col w.cut w.par) (w.moves.take n) = X
      at hsd hcol hsd0 hst ⊢
    generalize w.moves[n] = m at hsd hcol hj hij hpre hi hjq hlab0 ⊢
    have hlab : ∀ x, m.i ≤ x → x ≤ m.j →
        (col[x]?).map Prod.fst = (col[m.j]?).map Prod.fst := by
      intro x h1 h2
      rw [hlab0 x h1 h2, hjq]; rfl
    rw [stop_move_E8 hsd0 hcol hij hj hpre hsd]
    exact ⟨by rw [mapPath_fst_E8, hf], hcc, stackRel_move_E8 hcol hij hj hlab (Or.inr hpre) hst⟩


/-- G011-L1 (owner U2; requested by U3 L4.2c steps 4(b3), 4(c)). The stack of an admissible cap
against `E`: below the host number `sd.t`, the stopping column of `w.H` and the cap column
`w.col` resolve to columns that are either both closed and equal, or both containing (active
entries `eH`, `eE`) and in block form. -/
theorem admCap_stack_D8 {E : Forest} (hE : InL E) (w : Closure.AdmCap E) {sd : StopData}
    (hsd : stopData w.H = some sd) :
    ∀ q, q < sd.t → ∃ oH oE, sd.col.resolve 0 q = some oH ∧ w.col.resolve 0 q = some oE ∧
      ((oH.container sd.col = none ∧ oE.container w.col = none ∧ w.H.colAt oH = E.colAt oE) ∨
       (∃ eH eE, oH.container sd.col = some ⟨oH, eH⟩ ∧ oE.container w.col = some ⟨oE, eE⟩ ∧
         BlockForm_D8 ((w.H.colAt oH).getD []) ((E.colAt oE).getD []) eH eE)) := by
  intro q hq
  have hM := cap_inv_E8 w w.moves.length le_rfl sd (by rw [List.take_length]; exact hsd)
  rw [List.take_length] at hM
  obtain ⟨hf, hcc, hst⟩ := hM
  have ht : sd.t = w.col.num 0 := by
    rw [(stopData_spec hsd).2.2.1]
    calc sd.col.num 0 = (⟨sd.col.path, sd.col.col⟩ : ColAddr).num 0 := rfl
      _ = (⟨w.col.path, sd.col.col⟩ : ColAddr).num 0 := num_of_fst_E8 hf _ _
      _ = w.col.num 0 := by rw [hcc]
  obtain ⟨oH, oE, h1, h2, h3⟩ := hst q (ht ▸ hq)
  exact ⟨oH, oE, h1, h2, h3⟩

/-- G011-L7 helper: the containing columns of a route column are route columns. -/
theorem container_mem_routeCols_D8 {H : Forest} {T o : ColAddr} (hT : T ∈ routeCols H) {e : Nat}
    (ho : o.container T = some ⟨o, e⟩) : o ∈ routeCols H := by
  obtain ⟨hr, -⟩ := (Scan.mem_routeCols_iff H T).1 hT
  obtain ⟨-, tl, htl⟩ := (ColAddr.container_spec _ _ _).1 ho
  simp only [EntryAddr.heightPath] at htl
  have hP : T.path = o.path ++ (o.col, e) :: tl := by rw [← htl]; simp
  have hm : o.path.length < T.path.length := by rw [hP]; simp
  rw [Scan.mem_routeCols_iff]
  obtain ⟨F, hF, hl⟩ := hr o.path.length hm
  have htk : T.path.take o.path.length = o.path := by rw [hP]; simp
  rw [htk] at hF
  have hs : T.path[o.path.length]? = some (o.col, e) := by rw [hP]; simp
  rw [hs] at hl
  obtain ⟨col, -, -, hcl, -, hs', -⟩ := Scan.lastStep?_eq_some hl
  simp only [Prod.mk.injEq] at hs'
  have hFne : 0 < F.cols.length := by
    cases hc : F.cols with
    | nil => rw [hc] at hcl; simp at hcl
    | cons _ _ => simp
  refine ⟨fun d hd => ?_, F, hF, by omega⟩
  obtain ⟨G, hG, hGl⟩ := hr d (by omega)
  refine ⟨G, ?_, ?_⟩
  · rw [← htk, List.take_take, Nat.min_eq_left (by omega)]; exact hG
  · rw [hGl, ← htk, List.getElem?_take_of_lt hd]

/-- G011-L7 helper: a column on the stack of the stopping column that contains a column inside
the height of a query entry contains the stopping column. -/
theorem contains_of_contains_inside_D8 {T o : ColAddr} (hs : T.OnStack o) {j : Nat}
    {ρ : List (Nat × Nat)} {v : Nat}
    (hv : (⟨o, v⟩ : EntryAddr).heightPath <+: ((⟨T, j⟩ : EntryAddr).heightPath ++ ρ)) :
    ∃ e, o.container T = some ⟨o, e⟩ := by
  obtain ⟨tl, htl⟩ := hv
  have htl' : o.path ++ (o.col, v) :: tl = T.path ++ (T.col, j) :: ρ := by
    rw [← List.singleton_append, ← List.append_assoc]
    simpa [EntryAddr.heightPath] using htl
  rcases hs with ⟨m, ck, ik, hm, hp, hle⟩ | ⟨hp, hlt⟩
  · have hmT : m < T.path.length := (List.getElem?_eq_some_iff.1 hm).1
    have hol : o.path.length = m := by rw [hp, List.length_take]; omega
    have h1 : (o.path ++ (o.col, v) :: tl)[m]? = (T.path ++ (T.col, j) :: ρ)[m]? := by rw [htl']
    rw [List.getElem?_append_right (by omega), hol, Nat.sub_self, List.getElem?_cons_zero,
      List.getElem?_append_left hmT, hm] at h1
    simp only [Option.some.injEq, Prod.mk.injEq] at h1
    refine ⟨v, (ColAddr.container_spec _ _ _).2 ⟨rfl, ?_⟩⟩
    show o.path ++ [(o.col, v)] <+: T.path
    have h2 : T.path.take (m + 1) = T.path.take m ++ [(o.col, v)] := by
      rw [List.take_add_one, hm, h1.1, h1.2]; rfl
    rw [hp, ← h2]; exact List.take_prefix _ _
  · exfalso
    have h1 : (o.path ++ (o.col, v) :: tl)[T.path.length]? =
        (T.path ++ (T.col, j) :: ρ)[T.path.length]? := by rw [htl']
    rw [List.getElem?_append_right (by rw [hp]), List.getElem?_append_right le_rfl, hp,
      Nat.sub_self, List.getElem?_cons_zero, List.getElem?_cons_zero] at h1
    simp only [Option.some.injEq, Prod.mk.injEq] at h1
    omega

/-- G011-L5: the decorated keys of a route column are its actual keys capped at its last
index. -/
theorem capKeys_route_D8 {H : Forest} {sel : List ColAddr} {o : ColAddr} (ho : o ∈ sel) {e : Nat}
    (hl : (actualKeys H o).length = e + 1) :
    capKeys H sel o = (actualKeys H o).take e ++ [⊤] := by
  simp only [capKeys, ho, if_true]
  set L := actualKeys H o
  have hsplit : L = L.take e ++ [L[e]'(by omega)] := by
    rw [List.take_append_getElem (by omega), List.take_of_length_le (by omega)]
  conv_lhs => rw [hsplit]
  simp only [List.dropLast_concat, List.getLast?_concat, Option.map_some, Option.toList_some]

/-- G011-L8 for an admissible-cap anchor (step 4(b3) with a moved cap anchor, F13): the decorated
host path of `w.H` transferred to `E` through the stack correspondence of the cap (G011-L1). -/
theorem host_crossing_cap_D8 {E : Forest} (hE : InL E) (w : Closure.AdmCap E) {sd : StopData}
    (hsd : stopData w.H = some sd) {j : Nat} (hj : j < sd.Q.length) {b : EntryAddr}
    (hb : w.origin (.slot ⟨sd.col, j⟩) = some (.slot b))
    {c : ColAddr} (hc : c ∈ E.colAddrs) (hbc : b.heightPath <+: c.path) {k : Nat}
    (hk : k ≤ (parents E c).length)
    (hreach : Path E (actualKeys E) c (cutQuery (actualKeys E c) k) (cutStart E c k) sd.t) :
    Path E (actualKeys E) c (cutQuery (actualKeys E c) k) (cutStart E c k) sd.r := by
  obtain ⟨hst, -, hlen, -, hq⟩ := Closure.admCap_query hE w hsd
  have hbw : b = ⟨w.col, j⟩ := by
    have := (hq j (hlen ▸ hj)).1
    rw [hb, Option.some.injEq, Role.slot.injEq] at this
    exact this
  subst hbw
  have hHL : InL w.H := w.inL
  obtain ⟨hHV, -, -, hHA, hHS⟩ := id hHL
  obtain ⟨hHT, -, hTt, hTmem, -, -⟩ := stopData_spec hsd
  set T := sd.col
  set W := cutQuery (actualKeys E c) k
  have hW := cutQuery_noninc (actualKeys E c) k
  have hTop := cutQuery_actualKeys_ne_top_D8 E c k
  obtain ⟨ρ, hρ⟩ := hbc
  set d : ColAddr := ⟨(⟨T, j⟩ : EntryAddr).heightPath ++ ρ, c.col⟩
  have hcc : c = ⟨(⟨w.col, j⟩ : EntryAddr).heightPath ++ ρ, c.col⟩ := by
    obtain ⟨cp, cc⟩ := c; simp only at hρ ⊢; rw [hρ]
  have hdres : d.resolve 0 sd.t = some T := by
    rw [hTt]; exact resolve_host_D8 (e := ⟨T, j⟩) ⟨ρ, rfl⟩
  have hcres : c.resolve 0 sd.t = some w.col := by
    rw [hst]; exact resolve_host_D8 (e := ⟨w.col, j⟩) ⟨ρ, hρ⟩
  -- the common query prefix of `T` (in `w.H`) and `w.col` (in `E`)
  have hQE : ∀ x < sd.Q.length, ((w.H.colAt T).getD [])[x]? = ((E.colAt w.col).getD [])[x]? := by
    intro x hx
    rw [hHT, Option.getD_some, List.getElem?_append_left hx, (hq x (hlen ▸ hx)).2]
  have hkeys : ∀ n ≤ sd.Q.length, (actualKeys w.H T).take n = (actualKeys E w.col).take n := by
    intro n hn
    apply List.ext_getElem?
    intro x
    rcases Nat.lt_or_ge x n with hx | hx
    · rw [List.getElem?_take_of_lt hx, List.getElem?_take_of_lt hx]
      simp only [actualKeys, List.getElem?_map, hQE x (by omega), ← hTt, hst]
    · rw [List.getElem?_eq_none (by simp; omega), List.getElem?_eq_none (by simp; omega)]
  -- (b1) the `E`-barrier at the host
  have hcont : w.col.container c = some ⟨w.col, j⟩ :=
    (ColAddr.container_spec _ c _).2 ⟨rfl, ⟨ρ, hρ⟩⟩
  have hbar : W < cutQuery (actualKeys E w.col) (j + 1) := by
    have := cut_barrier_read hE hc hk hreach hcres hcont; simpa using this
  have hWZ : W ≤ cutQuery (actualKeys w.H T) sd.Q.length := by
    rw [cutQuery, hkeys _ le_rfl]
    exact le_of_lt (lt_of_lt_of_le hbar (cutQuery_mono _ (by omega)))
  -- (b2) the decorated host path in `w.H`
  have hdecA : CondAK w.H (capKeys w.H (routeCols w.H)) := capping_forward hHV hHA hHS (fun _ h => h)
  have hpH := path_nesting hHV hdecA d hW (cutQuery_noninc _ _) hWZ
    (decorated_host_edge_D8 hsd hdres)
  -- (b3) transfer, edge by edge
  have hedge : ∀ z, z ≤ sd.t →
      Path E (actualKeys E) c W (cutStart E c k) z →
      respEdge w.H (capKeys w.H (routeCols w.H)) d W z = respEdge E (actualKeys E) c W z := by
    intro z hz hzE
    unfold respEdge
    rcases Nat.lt_or_ge z sd.t with hlt | hge
    · have hdz := ColAddr.resolve_of_resolve_lt hdres hlt
      have hcz := ColAddr.resolve_of_resolve_lt hcres hlt
      obtain ⟨oH, oE, hoH, hoE, halt⟩ := admCap_stack_D8 hE w hsd z hlt
      rw [← hdz, hoH, ← hcz, hoE]
      simp only [Option.bind_some]
      have honH : oH.num 0 = z := ColAddr.resolve_num hoH
      have honE : oE.num 0 = z := ColAddr.resolve_num hoE
      have hsT : T.OnStack oH := ((ColAddr.resolve_spec 0 _ _ _).1 hoH).1
      rcases halt with ⟨hnc, -, hcol⟩ | ⟨eH, eE, hcH, hcEw, hbf⟩
      · have hnr : oH ∉ routeCols w.H := by
          intro hr
          have hdH : d ∈ w.H.colAddrs := by
            have hbE : (⟨w.col, j⟩ : EntryAddr) ∈ E.entryAddrs :=
              mem_entryAddrs_of_contains hc ⟨ρ, hρ⟩
            obtain ⟨⟨qb, B⟩, hB⟩ := Option.isSome_iff_exists.1
              ((Tree.mem_entryAddrs_iff _ _).1 hbE)
            have hEh : E.heightAt ⟨w.col, j⟩ = some B := by simp [Tree.heightAt, hB]
            have hHh : w.H.heightAt ⟨T, j⟩ = some B := by
              obtain ⟨colE, hcolE, hj'⟩ := Tree.colAt_of_entryAt hB
              have := hQE j hj
              rw [hcolE, Option.getD_some, hj'] at this
              simp only [Tree.heightAt, Tree.entryAt]
              cases hHc : w.H.colAt T with
              | none => rw [hHc] at this; simp at this
              | some colH => rw [hHc, Option.getD_some] at this; simp [this]
            rw [Tree.mem_colAddrs_iff, show d = ⟨(⟨T, j⟩ : EntryAddr).heightPath ++ ρ, c.col⟩ from rfl,
              colAt_heightPath_D8 hHh, ← colAt_heightPath_D8 hEh, ← hcc]
            exact (Tree.mem_colAddrs_iff _ _).1 hc
          obtain ⟨v, -, hvc⟩ := routeCols_visible hdH hr (by rw [← hdz, hoH])
          obtain ⟨e, he⟩ := contains_of_contains_inside_D8 hsT hvc
          rw [hnc] at he; cases he
        have hks : actualKeys w.H oH = actualKeys E oE := by
          simp only [actualKeys, hcol, honH, honE]
        simp only [resp, capKeys_of_not_mem hnr, hks, hcol]
      · have hr : oH ∈ routeCols w.H := container_mem_routeCols_D8 hTmem hcH
        have hcEc : oE.container c = some ⟨oE, eE⟩ := by
          rw [hcc]; exact container_trans_D8 (e := ⟨w.col, j⟩) hcEw ⟨ρ, rfl⟩
        have hbarE : W < cutQuery (actualKeys E oE) (eE + 1) := by
          have := cut_barrier_read hE hc hk hzE (by rw [← hcz, hoE]) hcEc; simpa using this
        rw [resp_blockForm_D8 (by rw [honH, honE]) hbf hW hTop hbarE]
        have hlH : ((w.H.colAt oH).getD []).length = eH + 1 := hbf.1
        have hks : capKeys w.H (routeCols w.H) oH = cappedAt (actualKeys w.H oH) eH :=
          capKeys_route_D8 hr (by rw [length_actualKeys, hlH])
        simp [resp, hks, parents, List.getElem?_map]
        rfl
    · have hzt : z = sd.t := by omega
      subst hzt
      rw [hdres, hcres]
      simp only [Option.bind_some]
      -- R7 on both sides at the query entry `j`
      have hlE : j < (actualKeys E w.col).length := by
        rw [length_actualKeys]
        exact idx_lt_of_mem_entryAddrs (mem_entryAddrs_of_contains hc ⟨ρ, hρ⟩)
      obtain ⟨hcE1, hcE2⟩ := cursor_cappedAt (actualKeys E w.col) W j hlE hW hTop hbar
      have hlT : (actualKeys w.H T).length = sd.Q.length + 1 := by
        rw [length_actualKeys, hHT]; simp
      have hksD : capKeys w.H (routeCols w.H) T = (actualKeys w.H T).take sd.Q.length ++ [⊤] :=
        capKeys_route_D8 hTmem hlT
      have hlD : j < (capKeys w.H (routeCols w.H) T).length := by
        rw [hksD, List.length_append, List.length_take, hlT]; simp; omega
      have hbarD : W < cutQuery (capKeys w.H (routeCols w.H) T) (j + 1) := by
        rw [hksD, cutQuery, List.take_append_of_le_length (by simp; omega), List.take_take,
          Nat.min_eq_left (by omega), hkeys _ (by omega)]
        exact hbar
      obtain ⟨hcD1, hcD2⟩ := cursor_cappedAt (capKeys w.H (routeCols w.H) T) W j hlD hW hTop hbarD
      have hcur : cursor (capKeys w.H (routeCols w.H) T) W = cursor (actualKeys E w.col) W := by
        rw [hcD2, hcE2, hksD, List.take_append_of_le_length (by simp; omega), List.take_take,
          Nat.min_eq_left (by omega), hkeys _ (by omega)]
      simp only [resp, hcur]
      have hcj : cursor (actualKeys E w.col) W < sd.Q.length := by omega
      rw [hQE _ hcj]
  -- induction along the decorated path
  have key : ∀ z, Path w.H (capKeys w.H (routeCols w.H)) d W sd.t z →
      Path E (actualKeys E) c W (cutStart E c k) z := by
    intro z hz
    induction hz with
    | refl => exact hreach
    | @tail y z hyz hzz ih =>
      have hy : y ≤ sd.t := path_le hHV hyz
      have h1 := (edge_iff _ _ _ _ _ _).1 hzz
      rw [hedge y hy ih] at h1
      exact ih.tail ((edge_iff _ _ _ _ _ _).2 h1)
  exact key sd.r hpH

/-- G011-L8 (L4.2c step 4(b), scan and descendant records, `E` or cap anchor). If the target
chain reaches the host `t = sd.t`, it continues to the source host `r = sd.r`. -/
theorem host_crossing_D8 {E : Forest} (hE : InL E) {cap : Option (Closure.AdmCap E)}
    {sd : StopData} (hsd : stopData (Closure.anchor E cap) = some sd) {j : Nat}
    (hj : j < sd.Q.length) {b : EntryAddr}
    (hb : Closure.anchorOrigin E cap (.slot ⟨sd.col, j⟩) = some (.slot b))
    {c : ColAddr} (hc : c ∈ E.colAddrs) (hbc : b.heightPath <+: c.path) {k : Nat}
    (hk : k ≤ (parents E c).length)
    (hreach : Path E (actualKeys E) c (cutQuery (actualKeys E c) k) (cutStart E c k) sd.t) :
    Path E (actualKeys E) c (cutQuery (actualKeys E c) k) (cutStart E c k) sd.r := by
  cases cap with
  | none =>
    simp only [Closure.anchorOrigin, Option.some.injEq, Role.slot.injEq] at hb
    subst hb
    exact host_crossing_none_D8 hE hsd hj hc hbc hk hreach
  | some w => exact host_crossing_cap_D8 hE w hsd hj hb hc hbc hk hreach

/-- G011-T2 helper: a list is never below one of its prefixes. -/
theorem not_lt_of_prefix_D8 {γ : Type} [LinearOrder γ] :
    ∀ {l m : List γ}, l <+: m → ¬ m < l
  | [], m, _ => List.not_lt_nil m
  | x :: l, m, ⟨tl, htl⟩ => by
    subst htl
    intro h
    rw [List.cons_append, List.cons_lt_cons_iff] at h
    rcases h with h | ⟨-, h⟩
    · exact lt_irrefl x h
    · exact not_lt_of_prefix_D8 ⟨tl, rfl⟩ h

/-- G011-T2 helper: truncation after an entry gives a smaller forest. -/
theorem truncAfter_le_D8 (X : Forest) (e : EntryAddr) : X.truncAfter e ≤ X := by
  rw [← not_lt, ← word_lt_iff]
  exact not_lt_of_prefix_D8 (word_truncAfter_prefix X e)

/-- G011-T2 helper: lexicographic comparison of column lists modified at one index. -/
theorem cmpCols_modify_D8 {α : Type} (c : α → α → Ordering) [Std.ReflCmp c] :
    ∀ (l : List (List (α × Tree α))) (n : Nat) (f g : List (α × Tree α) → List (α × Tree α)),
    (hn : n < l.length) → Tree.cmpCols c (l.modify n f) (l.modify n g) = Tree.cmpCol c (f l[n]) (g l[n])
  | [], _, _, _, hn => absurd hn (Nat.not_lt_zero _)
  | x :: xs, 0, f, g, _ => by
    simp only [List.modify_zero_cons, Tree.cmpCols, Tree.cmpCols_self, Ordering.then_eq,
      List.getElem_cons_zero]
  | x :: xs, n + 1, f, g, hn => by
    simp only [List.modify_succ_cons, Tree.cmpCols, Tree.cmpCol_self, Ordering.eq_then,
      List.getElem_cons_succ]
    exact cmpCols_modify_D8 c xs n f g (by simpa using hn)

/-- G011-T2 helper: lexicographic comparison of columns whose entry `n` gets a new height. -/
theorem cmpCol_modify_D8 {α : Type} (c : α → α → Ordering) [Std.ReflCmp c] :
    ∀ (l : List (α × Tree α)) (n : Nat) (f g : Tree α → Tree α), (hn : n < l.length) →
    Tree.cmpCol c (l.modify n fun x => (x.1, f x.2)) (l.modify n fun x => (x.1, g x.2)) =
      Tree.cmp c (f l[n].2) (g l[n].2)
  | [], _, _, _, hn => absurd hn (Nat.not_lt_zero _)
  | x :: xs, 0, f, g, _ => by
    simp only [List.modify_zero_cons, Tree.cmpCol, Std.ReflCmp.compare_self, Ordering.eq_then,
      Tree.cmpCol_self, Ordering.then_eq, List.getElem_cons_zero]
  | x :: xs, n + 1, f, g, hn => by
    simp only [List.modify_succ_cons, Tree.cmpCol, Std.ReflCmp.compare_self, Ordering.eq_then,
      List.getElem_cons_succ]
    exact cmpCol_modify_D8 c xs n f g (by simpa using hn)

/-- G011-T2 helper: replacing a height compares like the two heights. -/
theorem cmp_setAux_D8 (h h' : Forest) (j i : Nat) :
    ∀ (P : List (Nat × Nat)) (t : Forest), (t.entryAt ⟨⟨P, j⟩, i⟩).isSome →
    Tree.cmp compare (Tree.setAux h P j i t) (Tree.setAux h' P j i t) = Tree.cmp compare h h'
  | [], .node cols, hv => by
    obtain ⟨col, hcol, hx⟩ : ∃ col, cols[j]? = some col ∧ (col[i]?).isSome := by
      simp only [Tree.entryAt, Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols] at hv
      cases h1 : cols[j]? with
      | none => rw [h1] at hv; simp at hv
      | some col => rw [h1] at hv; exact ⟨col, rfl, hv⟩
    have hj : j < cols.length := (List.getElem?_eq_some_iff.1 hcol).1
    have hi : i < col.length := by simpa using hx
    simp only [Tree.setAux, Tree.cmp]
    rw [cmpCols_modify_D8 compare cols j _ _ hj]
    have : cols[j] = col := (List.getElem?_eq_some_iff.1 hcol).2
    rw [this]
    exact cmpCol_modify_D8 compare col i (fun _ => h) (fun _ => h') hi
  | (c0, i0) :: rest, .node cols, hv => by
    rw [Tree.entryAt_cons] at hv
    simp only [Tree.cols] at hv
    obtain ⟨col, hcol⟩ : ∃ col, cols[c0]? = some col := by
      cases h1 : cols[c0]? with
      | none => rw [h1] at hv; simp at hv
      | some col => exact ⟨col, rfl⟩
    rw [hcol, Option.bind_some] at hv
    obtain ⟨x, hx⟩ : ∃ x, col[i0]? = some x := by
      cases h1 : col[i0]? with
      | none => rw [h1] at hv; simp at hv
      | some x => exact ⟨x, rfl⟩
    rw [hx, Option.bind_some] at hv
    have hj : c0 < cols.length := (List.getElem?_eq_some_iff.1 hcol).1
    have hi : i0 < col.length := (List.getElem?_eq_some_iff.1 hx).1
    simp only [Tree.setAux, Tree.cmp]
    rw [cmpCols_modify_D8 compare cols c0 _ _ hj]
    have : cols[c0] = col := (List.getElem?_eq_some_iff.1 hcol).2
    rw [this]
    rw [cmpCol_modify_D8 compare col i0 (fun y => Tree.setAux h rest j i y)
      (fun y => Tree.setAux h' rest j i y) hi]
    have : col[i0] = x := (List.getElem?_eq_some_iff.1 hx).2
    rw [this]
    exact cmp_setAux_D8 h h' j i rest x.2 hv

/-- G011-T2 helper: replacing a height by a smaller one gives a smaller forest. -/
theorem setHeight_mono_D8 {t : Forest} {e : EntryAddr} (he : e ∈ t.entryAddrs) {h h' : Forest}
    (hh : h ≤ h') : t.setHeight e h ≤ t.setHeight e h' := by
  have he' : (t.entryAt e).isSome := (Tree.mem_entryAddrs_iff t e).1 he
  show Tree.cmp compare _ _ ≠ .gt
  rw [Tree.setHeight_eq_body, Tree.setHeight_eq_body, Tree.setHeightBody, Tree.setHeightBody,
    if_pos he', if_pos he']
  obtain ⟨⟨P, j⟩, i⟩ := e
  rw [cmp_setAux_D8 h h' j i P t he']
  exact hh

/-- G011-T2 (owner U1; used by G011-L9). Truncating after `e` and lowering the height of `e`
gives a smaller tree. -/
theorem truncSet_le_D8 {X : Forest} {e : EntryAddr} (he : e ∈ X.entryAddrs) {h : Forest}
    (hh : h ≤ (X.heightAt e).getD Tree.empty) : (X.truncAfter e).setHeight e h ≤ X := by
  obtain ⟨-, he2, hh2, -, -⟩ := Tree.truncAfter_spec X e he
  obtain ⟨⟨q, A⟩, hA⟩ := Option.isSome_iff_exists.1 ((Tree.mem_entryAddrs_iff X e).1 he)
  have hXA : X.heightAt e = some A := by simp [Tree.heightAt, hA]
  rw [hXA, Option.getD_some] at hh
  calc (X.truncAfter e).setHeight e h ≤ (X.truncAfter e).setHeight e A := setHeight_mono_D8 he2 hh
    _ = X.truncAfter e := (Tree.setHeight_basic _ e A he2).2.2.2.1 (by rw [hh2, hXA])
    _ ≤ X := truncAfter_le_D8 X e

/-- G011-T1 helper: the forests of a truncation along its path. -/
theorem forestAt_truncAux_take_D8 {α : Type} (j i : Nat) :
    ∀ (P : List (Nat × Nat)) (t : Tree α) (n : Nat), n ≤ P.length →
    (Tree.truncAux P j i t).forestAt (P.take n) =
      (t.forestAt (P.take n)).map (Tree.truncAux (P.drop n) j i)
  | [], t, n, hn => by
    have : n = 0 := by simpa using hn
    subst this; rfl
  | (c0, i0) :: rest, .node cols, n, hn => by
    cases n with
    | zero => rfl
    | succ n =>
      rw [List.take_succ_cons, List.drop_succ_cons, Tree.forestAt_cons, Tree.forestAt_cons]
      simp only [Tree.truncAux, Tree.cols]
      rw [Tree.truncStep_getElem?]
      cases (cols[c0]?).bind (·[i0]?) with
      | none => rfl
      | some x =>
        simp only [Option.map_some, Option.bind_some]
        exact forestAt_truncAux_take_D8 j i rest x.2 n (by simp at hn; omega)

/-- G011-T1 helper: the forests of a height replacement along its path. -/
theorem forestAt_setAux_take_D8 {α : Type} (h : Tree α) (j i : Nat) :
    ∀ (P : List (Nat × Nat)) (t : Tree α) (n : Nat), n ≤ P.length →
    (Tree.setAux h P j i t).forestAt (P.take n) =
      (t.forestAt (P.take n)).map (Tree.setAux h (P.drop n) j i)
  | [], t, n, hn => by
    have : n = 0 := by simpa using hn
    subst this; rfl
  | (c0, i0) :: rest, .node cols, n, hn => by
    cases n with
    | zero => rfl
    | succ n =>
      rw [List.take_succ_cons, List.drop_succ_cons, Tree.forestAt_cons, Tree.forestAt_cons]
      simp only [Tree.setAux, Tree.cols, List.getElem?_modify_eq]
      cases hc : cols[c0]? with
      | none => rfl
      | some col =>
        simp only [Option.map_eq_map, Option.map_some, Option.bind_some, List.getElem?_modify_eq]
        cases hx : col[i0]? with
        | none => rfl
        | some x =>
          simp only [Option.map_some, Option.bind_some]
          exact forestAt_setAux_take_D8 h j i rest x.2 n (by simp at hn; omega)

/-- G011-T1(a) helper: truncation keeps the non-containing columns of the visible stack of the
truncated column. -/
theorem colAt_truncAux_stack_D8 {α : Type} (j i : Nat) :
    ∀ (P : List (Nat × Nat)) (t : Tree α) (d : ColAddr), (t.colAt ⟨P, j⟩).isSome →
    (⟨P, j⟩ : ColAddr).OnStack d → (∀ u, ¬ (⟨d, u⟩ : EntryAddr).heightPath <+: P) →
    (Tree.truncAux P j i t).colAt d = t.colAt d
  | [], .node cols, d, hv, hd, _ => by
    have hj : j < cols.length := by simpa [Tree.colAt, Tree.forestAt, Tree.cols] using hv
    rcases hd with ⟨m, ck, ik, hm, -, -⟩ | ⟨hp, hlt⟩
    · simp at hm
    · obtain ⟨dp, dc⟩ := d
      simp only at hp hlt; subst hp
      simp only [Tree.truncAux, Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols]
      rw [List.getElem?_append_left (by simp; omega), List.getElem?_take_of_lt hlt]
  | (c0, i0) :: rest, .node cols, d, hv, hd, hnc => by
    have hc0 : c0 < cols.length := by
      rw [Tree.colAt_cons] at hv
      simp only [Tree.cols] at hv
      cases h1 : cols[c0]? with
      | none => rw [h1] at hv; simp at hv
      | some _ => exact (List.getElem?_eq_some_iff.1 h1).1
    rcases onStack_cons_D8 hd with ⟨hp, hle⟩ | ⟨P', hp, hP'⟩
    · obtain ⟨dp, dc⟩ := d
      simp only at hp hle; subst hp
      have hlt : dc < c0 := by
        rcases Nat.lt_or_ge dc c0 with h | h
        · exact h
        · exfalso
          have : dc = c0 := by omega
          subst this
          exact hnc i0 ⟨rest, by simp [EntryAddr.heightPath]⟩
      simp only [Tree.truncAux, Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols]
      rw [List.getElem?_append_left (by simp; omega), List.getElem?_take_of_lt hlt]
    · obtain ⟨dp, dc⟩ := d
      simp only at hp hP'; subst hp
      rw [Tree.colAt_cons, Tree.colAt_cons]
      simp only [Tree.truncAux, Tree.cols]
      rw [Tree.truncStep_getElem?]
      rw [Tree.colAt_cons] at hv
      simp only [Tree.cols] at hv
      cases hx : (cols[c0]?).bind (·[i0]?) with
      | none => rfl
      | some x =>
        rw [hx, Option.bind_some] at hv
        simp only [Option.map_some, Option.bind_some]
        refine colAt_truncAux_stack_D8 j i rest x.2 ⟨P', dc⟩ hv hP' fun u hu => hnc u ?_
        obtain ⟨tl, htl⟩ := hu
        exact ⟨tl, by simp [EntryAddr.heightPath] at htl ⊢; exact htl⟩

/-- G011-T1(a) helper: a height replacement keeps the columns of the visible stack of the
replaced entry's column. -/
theorem colAt_setAux_stack_D8 {α : Type} (h : Tree α) (j i : Nat) :
    ∀ (P : List (Nat × Nat)) (t : Tree α) (d : ColAddr), (⟨P, j⟩ : ColAddr).OnStack d →
    (∀ u, ¬ (⟨d, u⟩ : EntryAddr).heightPath <+: P) →
    (Tree.setAux h P j i t).colAt d = t.colAt d
  | [], .node cols, d, hd, _ => by
    rcases hd with ⟨m, ck, ik, hm, -, -⟩ | ⟨hp, hlt⟩
    · simp at hm
    · obtain ⟨dp, dc⟩ := d
      simp only at hp hlt; subst hp
      simp only [Tree.setAux, Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols]
      rw [List.getElem?_modify_ne _ _ (Nat.ne_of_gt hlt)]
  | (c0, i0) :: rest, .node cols, d, hd, hnc => by
    rcases onStack_cons_D8 hd with ⟨hp, hle⟩ | ⟨P', hp, hP'⟩
    · obtain ⟨dp, dc⟩ := d
      simp only at hp hle; subst hp
      have hne : dc ≠ c0 := by
        rintro rfl
        exact hnc i0 ⟨rest, by simp [EntryAddr.heightPath]⟩
      simp only [Tree.setAux, Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols]
      rw [List.getElem?_modify_ne _ _ (Ne.symm hne)]
    · obtain ⟨dp, dc⟩ := d
      simp only at hp hP'; subst hp
      rw [Tree.colAt_cons, Tree.colAt_cons]
      simp only [Tree.setAux, Tree.cols, List.getElem?_modify_eq]
      cases hc : cols[c0]? with
      | none => rfl
      | some col =>
        simp only [Option.map_eq_map, Option.map_some, Option.bind_some, List.getElem?_modify_eq]
        cases hx : col[i0]? with
        | none => rfl
        | some x =>
          simp only [Option.map_some, Option.bind_some]
          refine colAt_setAux_stack_D8 h j i rest x.2 ⟨P', dc⟩ hP' fun u hu => hnc u ?_
          obtain ⟨tl, htl⟩ := hu
          exact ⟨tl, by simp [EntryAddr.heightPath] at htl ⊢; exact htl⟩

/-- G011-T1(b) (owner U1; used by G011-L9). The column of `e`, and every column containing `e`
(active entry `u`), keep their first `u` entries and the label of entry `u`, and end at `u`; the
new height of entry `u` is below the old one when the new height of `e` is. -/
theorem colAt_truncSet_active_D8 {H : Forest} {a : EntryAddr} (ha : a ∈ H.entryAddrs)
    (A' : Forest) {o : ColAddr} {u : Nat}
    (hou : (o = a.col ∧ u = a.idx) ∨ o.container a.col = some ⟨o, u⟩) :
    ∃ (col : Column) (q : Nat) (X X' : Forest), H.colAt o = some col ∧ col[u]? = some (q, X) ∧
      ((H.truncAfter a).setHeight a A').colAt o = some (col.take u ++ [(q, X')]) ∧
      (A' ≤ (H.heightAt a).getD Tree.empty → X' ≤ X) := by
  have hav : (H.entryAt a).isSome := (Tree.mem_entryAddrs_iff H a).1 ha
  obtain ⟨⟨P, j⟩, i⟩ := a
  have hT : H.truncAfter ⟨⟨P, j⟩, i⟩ = Tree.truncAux P j i H := by
    rw [Tree.truncAfter_eq_body, Tree.truncAfterBody, if_pos hav]
  have hTe : (Tree.truncAux P j i H).entryAt ⟨⟨P, j⟩, i⟩ = H.entryAt ⟨⟨P, j⟩, i⟩ :=
    Tree.entryAt_truncAux P H j i
  have hG : (H.truncAfter ⟨⟨P, j⟩, i⟩).setHeight ⟨⟨P, j⟩, i⟩ A' =
      Tree.setAux A' P j i (Tree.truncAux P j i H) := by
    rw [hT, Tree.setHeight_eq_body, Tree.setHeightBody, if_pos (by rw [hTe]; exact hav)]
  rw [hG]
  rcases hou with ⟨h1, h2⟩ | hcont
  · -- `o` is the column of the entry
    simp only at h1 h2
    subst o; subst u
    obtain ⟨F0, hF0⟩ : ∃ F, H.forestAt P = some F := by
      simp only [Tree.entryAt, Tree.colAt] at hav
      cases h1 : H.forestAt P with
      | none => rw [h1] at hav; simp at hav
      | some F => exact ⟨F, rfl⟩
    obtain ⟨cols⟩ := F0
    obtain ⟨col, hcol⟩ : ∃ col, cols[j]? = some col := by
      simp only [Tree.entryAt, Tree.colAt, hF0, Option.bind_some, Tree.cols] at hav
      cases h1 : cols[j]? with
      | none => rw [h1] at hav; simp at hav
      | some col => exact ⟨col, rfl⟩
    obtain ⟨⟨q, X⟩, hx⟩ : ∃ x, col[i]? = some x := by
      simp only [Tree.entryAt, Tree.colAt, hF0, Option.bind_some, Tree.cols, hcol] at hav
      exact Option.isSome_iff_exists.1 hav
    have hj : j < cols.length := (List.getElem?_eq_some_iff.1 hcol).1
    have hi : i < col.length := (List.getElem?_eq_some_iff.1 hx).1
    refine ⟨col, q, X, A', by simp [Tree.colAt, hF0, Tree.cols, hcol], hx, ?_, fun h => ?_⟩
    · simp only [Tree.colAt, Tree.forestAt_setAux, Tree.forestAt_truncAux, hF0, Option.map_some,
        Option.bind_some, Tree.truncAux, Tree.setAux, Tree.cols]
      rw [List.getElem?_modify_eq]
      have hgd : cols.getD j [] = col := by simp [List.getD_eq_getElem?_getD, hcol]
      rw [List.getElem?_append_right (by simp only [List.length_take]; omega), hgd]
      simp only [List.length_take, Nat.min_eq_left hj.le, Nat.sub_self, List.getElem?_cons_zero,
        Option.map_eq_map, Option.map_some, Option.some.injEq]
      rw [List.take_add_one, List.getElem?_eq_getElem hi]
      simp only [Option.toList_some]
      rw [Tree.list_modify_append_singleton _ _ _ (by simp; omega)]
      simp [(List.getElem?_eq_some_iff.1 hx).2]
    · simpa [Tree.heightAt, Tree.entryAt, Tree.colAt, hF0, Tree.cols, hcol, hx] using h
  · -- `o` contains the entry's column
    obtain ⟨-, tl, htl⟩ := (ColAddr.container_spec o ⟨P, j⟩ ⟨o, u⟩).1 hcont
    simp only [EntryAddr.heightPath] at htl
    set n := o.path.length
    have hP : P = o.path ++ (o.col, u) :: tl := by rw [← htl]; simp
    have hn : n ≤ P.length := by rw [hP]; simp [n]
    have htake : P.take n = o.path := by rw [hP]; simp [n]
    have hdrop : P.drop n = (o.col, u) :: tl := by rw [hP]; simp [n]
    obtain ⟨F0, hF0⟩ : ∃ F, H.forestAt o.path = some F := by
      have := hav
      simp only [Tree.entryAt, Tree.colAt] at this
      rw [hP, Tree.forestAt_append] at this
      cases h1 : H.forestAt o.path with
      | none => rw [h1] at this; simp at this
      | some F => exact ⟨F, rfl⟩
    obtain ⟨cols⟩ := F0
    have hav2 := hav
    simp only [Tree.entryAt, Tree.colAt] at hav2
    rw [hP, Tree.forestAt_append, hF0, Option.bind_some, Tree.forestAt_cons] at hav2
    simp only [Tree.cols] at hav2
    obtain ⟨col, hcol⟩ : ∃ col, cols[o.col]? = some col := by
      cases h1 : cols[o.col]? with
      | none => rw [h1] at hav2; simp at hav2
      | some col => exact ⟨col, rfl⟩
    rw [hcol, Option.bind_some] at hav2
    obtain ⟨⟨q, X⟩, hx⟩ : ∃ x, col[u]? = some x := by
      cases h1 : col[u]? with
      | none => rw [h1] at hav2; simp at hav2
      | some x => exact ⟨x, rfl⟩
    have hcl : o.col < cols.length := (List.getElem?_eq_some_iff.1 hcol).1
    have hul : u < col.length := (List.getElem?_eq_some_iff.1 hx).1
    have hgd : cols.getD o.col [] = col := by simp [List.getD_eq_getElem?_getD, hcol]
    refine ⟨col, q, X, Tree.setAux A' tl j i (Tree.truncAux tl j i X),
      by simp [Tree.colAt, hF0, Tree.cols, hcol], hx, ?_, fun h => ?_⟩
    · have h1 := forestAt_setAux_take_D8 A' j i P (Tree.truncAux P j i H) n hn
      have h2 := forestAt_truncAux_take_D8 j i P H n hn
      rw [htake, hdrop] at h1 h2
      rw [hF0, Option.map_some] at h2
      rw [h2, Option.map_some] at h1
      simp only [Tree.colAt, h1, Option.bind_some, Tree.truncAux, Tree.setAux, Tree.cols, hgd]
      rw [List.getElem?_modify_eq, List.getElem?_append_right (by simp only [List.length_take]; omega)]
      simp only [List.length_take, Nat.min_eq_left hcl.le, Nat.sub_self, List.getElem?_cons_zero,
        Option.map_eq_map, Option.map_some, Option.some.injEq, hx, Option.toList_some]
      rw [Tree.list_modify_append_singleton _ _ _ (by simp; omega)]
    · -- the new height of the active entry is below the old one
      have hXe : X.entryAt ⟨⟨tl, j⟩, i⟩ = H.entryAt ⟨⟨P, j⟩, i⟩ := by
        have hXh : H.heightAt ⟨o, u⟩ = some X := by
          simp [Tree.heightAt, Tree.entryAt, Tree.colAt, hF0, Tree.cols, hcol, hx]
        rw [hP, show o.path ++ (o.col, u) :: tl = (⟨o, u⟩ : EntryAddr).heightPath ++ tl by
          simp [EntryAddr.heightPath], entryAt_heightPath_D8 hXh]
      have hXv : (⟨⟨tl, j⟩, i⟩ : EntryAddr) ∈ X.entryAddrs := by
        rw [Tree.mem_entryAddrs_iff, hXe]; exact hav
      have hTX : Tree.truncAux tl j i X = X.truncAfter ⟨⟨tl, j⟩, i⟩ := by
        rw [Tree.truncAfter_eq_body, Tree.truncAfterBody, if_pos (by rw [hXe]; exact hav)]
      have hSX : Tree.setAux A' tl j i (Tree.truncAux tl j i X) =
          (X.truncAfter ⟨⟨tl, j⟩, i⟩).setHeight ⟨⟨tl, j⟩, i⟩ A' := by
        rw [hTX, Tree.setHeight_eq_body, Tree.setHeightBody, if_pos]
        rw [← hTX, Tree.entryAt_truncAux, hXe]; exact hav
      rw [hSX]
      apply truncSet_le_D8 hXv
      simpa [Tree.heightAt, hXe] using h

/-- G011-T1(a) (owner U1; used by G011-L10). Truncating after `e` and then replacing the
height of `e` leaves every column of `e`'s visible stack that does not contain `e` unchanged. -/
theorem colAt_truncSet_closed_D8 {t : Forest} {e : EntryAddr} (he : e ∈ t.entryAddrs) (h : Forest)
    {o : ColAddr} (ho : e.col.OnStack o) (hno : ∀ u, ¬ (⟨o, u⟩ : EntryAddr).heightPath <+: e.col.path) :
    ((t.truncAfter e).setHeight e h).colAt o = t.colAt o := by
  have hav : (t.entryAt e).isSome := (Tree.mem_entryAddrs_iff t e).1 he
  obtain ⟨⟨P, j⟩, i⟩ := e
  have hT : t.truncAfter ⟨⟨P, j⟩, i⟩ = Tree.truncAux P j i t := by
    rw [Tree.truncAfter_eq_body, Tree.truncAfterBody, if_pos hav]
  have hTe : (Tree.truncAux P j i t).entryAt ⟨⟨P, j⟩, i⟩ = t.entryAt ⟨⟨P, j⟩, i⟩ :=
    Tree.entryAt_truncAux P t j i
  rw [hT, Tree.setHeight_eq_body, Tree.setHeightBody, if_pos (by rw [hTe]; exact hav),
    colAt_setAux_stack_D8 h j i P _ o ho (fun u hu => hno u hu)]
  have hcv : (t.colAt ⟨P, j⟩).isSome := by
    simp only [Tree.entryAt] at hav
    cases h1 : t.colAt ⟨P, j⟩ with
    | none => rw [h1] at hav; simp at hav
    | some _ => rfl
  exact colAt_truncAux_stack_D8 j i P t o hcv ho (fun u hu => hno u hu)

/-- G011-L9 (L4.2c step 4(c), the descendant identification at the source host). Let
`F = (H.truncAfter a).setHeight a A'` with `A' ≤ A_a`, and let `o` be `a`'s column or a column
containing it, with active entry `u`. If `F`'s scan of `o` stops at or before `u`, then `H`'s scan
of `o` has the same cursor and the same response (`cursor_raise` after the `F`-barrier). -/
theorem src_host_resp_D8 {H : Forest} {a : EntryAddr} (ha : a ∈ H.entryAddrs) {A' : Forest}
    (hA : A' ≤ (H.heightAt a).getD Tree.empty) {o : ColAddr} {u : Nat}
    (hou : (o = a.col ∧ u = a.idx) ∨ o.container a.col = some ⟨o, u⟩)
    {W : List (WithTop Key)}
    (hcur : cursor (actualKeys ((H.truncAfter a).setHeight a A') o) W ≤ u) :
    cursor (actualKeys H o) W = cursor (actualKeys ((H.truncAfter a).setHeight a A') o) W ∧
    resp H (actualKeys H) o W =
      resp ((H.truncAfter a).setHeight a A') (actualKeys ((H.truncAfter a).setHeight a A')) o W := by
  obtain ⟨col, q, X, X', hH, hu, hG, hle⟩ := colAt_truncSet_active_D8 ha A' hou
  have hXX := hle hA
  set G := (H.truncAfter a).setHeight a A'
  set f : Nat × Forest → WithTop Key := fun x => ((relKey (o.num 0) x.2 : Key) : WithTop Key)
  have hul : u < col.length := (List.getElem?_eq_some_iff.1 hu).1
  have hksH : actualKeys H o = (col.map f).take u ++ f (q, X) :: (col.map f).drop (u + 1) := by
    have hd : (col.map f).drop u = f (q, X) :: (col.map f).drop (u + 1) := by
      rw [List.drop_eq_getElem_cons (by simp; omega)]
      simp [(List.getElem?_eq_some_iff.1 hu).2]
    have : actualKeys H o = col.map f := by simp [actualKeys, hH, f]
    rw [this, ← hd, List.take_append_drop]
  have hksG : actualKeys G o = (col.map f).take u ++ [f (q, X')] := by
    simp [actualKeys, hG, f, List.map_take]
  have hkey : f (q, X') ≤ f (q, X) := by
    simp only [f, WithTop.coe_le_coe]
    rw [← not_lt, relKey_lt_iff, not_lt]
    exact hXX
  have hlen : ((col.map f).take u).length = u := by simp; omega
  have hc : cursor (actualKeys H o) W = cursor (actualKeys G o) W := by
    rw [hksH, hksG]
    exact cursor_raise _ _ _ _ _ hkey (by rw [← hksG, hlen]; exact hcur)
  refine ⟨hc, ?_⟩
  simp only [resp, hc, hH, hG, Option.getD_some]
  rcases Nat.lt_or_ge (cursor (actualKeys G o) W) u with hlt | hge
  · rw [List.getElem?_append_left (by simp; omega), List.getElem?_take_of_lt hlt]
  · have : cursor (actualKeys G o) W = u := by omega
    rw [this, List.getElem?_append_right (by simp only [List.length_take]; omega), hu,
      List.length_take, Nat.min_eq_left hul.le, Nat.sub_self]
    rfl

/-- G011-D2: κ fixes the actual keys of a column whose number is at most `r` (L4.2a
`relKey_kappa_low`). -/
theorem kappaW_actualKeys_low_D8 {F : Forest} {o : ColAddr} {r t : Nat} (ho : o.num 0 ≤ r) :
    (actualKeys F o).map (kappaW_D8 r t) = actualKeys F o := by
  simp only [actualKeys, List.map_map]
  apply List.map_congr_left
  intro x _
  simp only [Function.comp, kappaW_D8, WithTop.map_coe]
  rw [relKey_kappa_low ho]

/-- G011-L10 setup: the source context of a scan or descendant record is the anchor truncated
after the source entry, with a source height below the anchor's. -/
theorem srcCtx_D8 {rk : SrcRecord} (h : rk.Admitted) {cap : Option (Closure.AdmCap rk.E)}
    {i j : Nat} (hkind : rk.kind = .scan cap i j ∨ rk.kind = .desc cap i j) :
    rk.a ∈ (Closure.anchor rk.E cap).entryAddrs ∧
    rk.F = ((Closure.anchor rk.E cap).truncAfter rk.a).setHeight rk.a rk.srcHeight ∧
    rk.srcHeight ≤ ((Closure.anchor rk.E cap).heightAt rk.a).getD Tree.empty := by
  set H := Closure.anchor rk.E cap
  have haF : rk.a ∈ rk.F.entryAddrs := h.2.2.1
  have hk := h.2.2.2.2.2.2
  have htrunc_id : rk.a ∉ H.entryAddrs → H.truncAfter rk.a = H := by
    intro hn
    rw [Tree.truncAfter_eq_body, Tree.truncAfterBody, if_neg]
    rwa [← Tree.mem_entryAddrs_iff]
  have hFh : rk.F.heightAt rk.a = some rk.srcHeight := by
    obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 ((Tree.mem_entryAddrs_iff _ _).1 haF)
    simp [SrcRecord.srcHeight, Tree.heightAt, hx]
  rcases hkind with hkind | hkind <;> rw [hkind] at hk
  · obtain ⟨-, -, hF⟩ := hk
    have haH : rk.a ∈ H.entryAddrs := by
      by_contra hn
      rw [htrunc_id hn] at hF
      rw [hF] at haF
      exact hn haF
    obtain ⟨-, -, hh2, -, -⟩ := Tree.truncAfter_spec H rk.a haH
    have hHh : (H.heightAt rk.a).getD Tree.empty = rk.srcHeight := by
      rw [← hh2, ← hF, hFh]; rfl
    refine ⟨haH, ?_, le_of_eq hHh.symm⟩
    obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 ((Tree.mem_entryAddrs_iff _ _).1 haH)
    have hTa := (Tree.truncAfter_spec H rk.a haH).2.1
    rw [(Tree.setHeight_basic _ _ _ hTa).2.2.2.1 (by rw [← hF]; exact hFh)]
    exact hF
  · obtain ⟨-, -, hF, hle⟩ := hk
    have haH : rk.a ∈ H.entryAddrs := by
      by_contra hn
      rw [htrunc_id hn] at hF
      have := (Tree.setHeight_basic rk.F rk.a ((H.heightAt rk.a).getD Tree.empty) haF).1
      rw [hF] at this
      exact hn this
    refine ⟨haH, ?_, hle⟩
    rw [← hF, (Tree.setHeight_basic rk.F rk.a _ haF).2.2.1,
      (Tree.setHeight_basic rk.F rk.a _ haF).2.2.2.1 hFh]

/-- G011-L10 for an `E` anchor (L4.2c step 4(c)): at every vertex `y ≤ r` reached by both
chains, the source edge equals the target edge (κ fixes the low keys; the source-host
identification `src_host_resp_D8` on the active columns, `colAt_truncSet_closed_D8` on the
others). -/
theorem low_edge_eq_none_D8 {rk : SrcRecord} (h : rk.Admitted) {i j : Nat}
    (hkind : rk.kind = .scan none i j ∨ rk.kind = .desc none i j) {c : ColAddr}
    {k p : Nat} (hfd : rk.firstDiff = .capAt c k p) {y : Nat} (hyr : y ≤ rk.a.col.num 0)
    (hsrc : Path rk.F (actualKeys rk.F) (srcCol_D8 rk c)
      (cutQuery (actualKeys rk.F (srcCol_D8 rk c)) k) (cutStart rk.F (srcCol_D8 rk c) k) y)
    (htgt : Path rk.E (actualKeys rk.E) c (cutQuery (actualKeys rk.E c) k) (cutStart rk.E c k) y) :
    respEdge rk.F (actualKeys rk.F) (srcCol_D8 rk c) (cutQuery (actualKeys rk.F (srcCol_D8 rk c)) k)
        y =
      respEdge rk.E (actualKeys rk.E) c (cutQuery (actualKeys rk.E c) k) y := by
  have hk' := h.2.2.2.2.2.2
  obtain ⟨hA, hsrcA⟩ : SrcRecord.AnchorAt rk.E none i j rk.b ∧
      SrcRecord.anchorSrc rk.E none i = some rk.a := by
    rcases hkind with hkind | hkind <;> rw [hkind] at hk' <;> exact ⟨hk'.1, hk'.2.1⟩
  obtain ⟨sd, hsd, hr, ht, hrt⟩ := anchor_hosts_D8 h.1 hA hsrcA
  obtain ⟨sd', rd, -, hsd', hrd, hor, -, -⟩ := hA
  rw [hsd] at hsd'; cases hsd'
  simp only [Closure.anchorOrigin, Option.some.injEq, Role.slot.injEq] at hor
  simp only [Closure.anchor] at hsd hrd
  have hbcol : rk.b.col = sd.col := by rw [← hor]
  have ha : rk.a = ⟨rd.col, i⟩ := by
    simp only [SrcRecord.anchorSrc, Closure.anchor, hrd, Option.map_some] at hsrcA
    exact (Option.some.inj hsrcA).symm
  obtain ⟨hres, -⟩ := rootData_path hsd hrd
  obtain ⟨haE, hFeq, hAle⟩ := srcCtx_D8 h hkind
  simp only [Closure.anchor] at haE hFeq hAle
  obtain ⟨ρ, colB, colA, hρ, hsrcc, hB, hcA, -, -, ⟨q', H', hAk, -⟩, -, -⟩ := capSetup_D8 h hfd
  obtain ⟨hc'F, hkE, -, hW, -⟩ := query_transfer_D8 h hfd
  set r := rk.a.col.num 0
  set t := rk.b.col.num 0
  set c' := srcCol_D8 rk c
  have hFL : InL rk.F := h.2.2.2.1
  have hkF : k ≤ (parents rk.F c').length := by
    simp [parents, hcA]; exact (List.getElem?_eq_some_iff.1 hAk).1.le
  have hcc : c = ⟨rk.b.heightPath ++ ρ, c.col⟩ := by
    obtain ⟨cp, cc⟩ := c; simp only at hρ ⊢; rw [hρ]
  -- the two stacks below `r`
  have hc'r : c'.resolve 0 r = some rk.a.col := by
    rw [show c' = ⟨rk.a.heightPath ++ ρ, c.col⟩ from hsrcc]
    exact resolve_host_D8 (e := rk.a) ⟨ρ, by simp⟩
  have hct : c.resolve 0 t = some sd.col := by
    have := resolve_host_D8 (e := rk.b) (d := ⟨rk.b.heightPath ++ ρ, c.col⟩) ⟨ρ, rfl⟩
    rw [← hcc] at this
    rw [← hbcol]; exact this
  have hcr : c.resolve 0 r = some rk.a.col := by
    have h1 := ColAddr.resolve_of_resolve_lt hct (q := r) (by omega)
    rw [← h1, hr, hres, ha]
  have hsame : c'.resolve 0 y = c.resolve 0 y := by
    rcases Nat.lt_or_ge y r with hlt | hge
    · rw [← ColAddr.resolve_of_resolve_lt hc'r hlt, ← ColAddr.resolve_of_resolve_lt hcr hlt]
    · have : y = r := by omega
      rw [this, hc'r, hcr]
  unfold respEdge
  rw [hsame]
  cases hoy : c.resolve 0 y with
  | none => rfl
  | some o =>
    simp only [Option.bind_some]
    have hres' : c'.resolve 0 y = some o := by rw [hsame, hoy]
    have hon : o.num 0 = y := ColAddr.resolve_num hoy
    -- A: κ fixes the low keys
    have hA' : cursor (actualKeys rk.F o) (cutQuery (actualKeys rk.E c) k) =
        cursor (actualKeys rk.F o) (cutQuery (actualKeys rk.F c') k) := by
      rw [hW]
      conv_lhs => rw [← kappaW_actualKeys_low_D8 (F := rk.F) (o := o) (r := r) (t := t) (by omega)]
      exact cursor_map (kappaW_strictMono_D8 (show r ≤ t by omega)) _ _
    have hrespA : resp rk.F (actualKeys rk.F) o (cutQuery (actualKeys rk.F c') k) =
        resp rk.F (actualKeys rk.F) o (cutQuery (actualKeys rk.E c) k) := by
      simp only [resp, hA']
    rw [hrespA]
    by_cases hact : ∃ u, (o = rk.a.col ∧ u = rk.a.idx) ∨ o.container rk.a.col = some ⟨o, u⟩
    · obtain ⟨u, hou⟩ := hact
      have hcont' : o.container c' = some ⟨o, u⟩ := by
        rw [ColAddr.container_spec]
        refine ⟨rfl, ?_⟩
        have hac : rk.a.heightPath <+: c'.path := by
          rw [show c' = ⟨rk.a.heightPath ++ ρ, c.col⟩ from hsrcc]; exact ⟨ρ, rfl⟩
        rcases hou with ⟨rfl, rfl⟩ | hco
        · exact hac
        · obtain ⟨-, h2⟩ := (ColAddr.container_spec _ _ _).1 hco
          exact h2.trans ((List.prefix_append _ _).trans hac)
      have hbar : cutQuery (actualKeys rk.F c') k < cutQuery (actualKeys rk.F o) (u + 1) :=
        cut_barrier_read hFL hc'F hkF hsrc hres' hcont'
      have huF : u < (actualKeys rk.F o).length := by
        rw [length_actualKeys]
        exact idx_lt_of_mem_entryAddrs (mem_entryAddrs_of_contains hc'F
          ((ColAddr.container_spec _ _ _).1 hcont').2)
      have hcur := cursor_le_of_lt_cutQuery (cutQuery_noninc _ _) huF hbar
      rw [← hA'] at hcur
      rw [hFeq] at hcur ⊢
      exact (src_host_resp_D8 haE hAle hou hcur).2.symm
    · -- a closed column of `a`'s stack
      have hy : y < r := by
        rcases Nat.lt_or_ge y r with hlt | hge
        · exact hlt
        · exfalso; apply hact
          refine ⟨rk.a.idx, Or.inl ⟨?_, rfl⟩⟩
          have : y = r := by omega
          rw [this, hcr] at hoy; exact (Option.some.inj hoy).symm
      have hst : rk.a.col.OnStack o := by
        have := ColAddr.resolve_of_resolve_lt hcr hy
        rw [hoy] at this
        exact ((ColAddr.resolve_spec 0 _ o y).1 this).1
      have hno : ∀ u, ¬ (⟨o, u⟩ : EntryAddr).heightPath <+: rk.a.col.path := by
        intro u hu
        exact hact ⟨u, Or.inr ((ColAddr.container_spec _ _ _).2 ⟨rfl, hu⟩)⟩
      have hcl := colAt_truncSet_closed_D8 haE rk.srcHeight hst hno
      rw [← hFeq] at hcl
      simp only [resp, actualKeys, hcl]

/-- G011-L10 helper (the levels of the root column): a column of the root column's stack (or the
root column itself) that contains the stopping column is the root column or contains it. -/
theorem contains_root_D8 {T R o : ColAddr} (hRT : T.resolve 0 (R.num 0) = some R)
    (ho : R.OnStack o ∨ o = R) {e : Nat} (hcont : o.container T = some ⟨o, e⟩) :
    o = R ∨ ∃ u, o.container R = some ⟨o, u⟩ := by
  rcases ho with ho | rfl
  · right
    obtain ⟨hTR, -⟩ := (ColAddr.resolve_spec 0 T R _).1 hRT
    obtain ⟨-, tl, htl⟩ := (ColAddr.container_spec _ _ _).1 hcont
    simp only [EntryAddr.heightPath] at htl
    -- `o`'s level on `T`'s path
    have hT : T.path = o.path ++ (o.col, e) :: tl := by rw [← htl]; simp
    rcases ho with ⟨m, ck, ik, hm, hp, hle⟩ | ⟨hp, hlt⟩
    · -- `o` sits at level `m` of `R`'s path
      have hmR : m < R.path.length := (List.getElem?_eq_some_iff.1 hm).1
      -- `R`'s path is a prefix of `T`'s
      have hRpre : R.path <+: T.path := by
        rcases hTR with ⟨m', ck', ik', hm', hp', -⟩ | ⟨hp', -⟩
        · rw [hp']; exact List.take_prefix _ _
        · rw [hp']
      have hTm : T.path[m]? = some (ck, ik) := by
        obtain ⟨tl', htl'⟩ := hRpre
        rw [← htl', List.getElem?_append_left hmR, hm]
      have hol : o.path.length = m := by rw [hp, List.length_take]; omega
      have hTo : T.path[o.path.length]? = some (o.col, e) := by rw [hT]; simp
      rw [hol, hTm] at hTo
      simp only [Option.some.injEq, Prod.mk.injEq] at hTo
      obtain ⟨rfl, rfl⟩ := hTo
      refine ⟨ik, (ColAddr.container_spec _ _ _).2 ⟨rfl, ?_⟩⟩
      show o.path ++ [(o.col, ik)] <+: R.path
      have h1 : R.path.take (m + 1) = R.path.take m ++ [(o.col, ik)] := by
        rw [List.take_add_one, hm]; rfl
      rw [hp, ← h1]
      exact List.take_prefix _ _
    · -- `o` is an earlier column of `R`'s forest: it cannot contain `T`
      exfalso
      rcases hTR with ⟨m', ck', ik', hm', hp', hle'⟩ | ⟨hp', hlt'⟩
      · have hm'l := (List.getElem?_eq_some_iff.1 hm').1
        have hl : o.path.length = m' := by rw [hp, hp', List.length_take]; omega
        have hTo : T.path[o.path.length]? = some (o.col, e) := by rw [hT]; simp
        rw [hl, hm'] at hTo
        simp only [Option.some.injEq, Prod.mk.injEq] at hTo
        omega
      · have : T.path.length = o.path.length := by rw [hp, hp']
        rw [hT] at this; simp at this
  · left; rfl

/-- G011-L10 for an admissible-cap anchor (L4.2c step 4(c), "H versus E" through the stack
correspondence of the cap, G011-L1). -/
theorem low_edge_eq_cap_D8 {rk : SrcRecord} (h : rk.Admitted) {w : Closure.AdmCap rk.E}
    {i j : Nat} (hkind : rk.kind = .scan (some w) i j ∨ rk.kind = .desc (some w) i j)
    {c : ColAddr} {k p : Nat} (hfd : rk.firstDiff = .capAt c k p) {y : Nat}
    (hyr : y ≤ rk.a.col.num 0)
    (hsrc : Path rk.F (actualKeys rk.F) (srcCol_D8 rk c)
      (cutQuery (actualKeys rk.F (srcCol_D8 rk c)) k) (cutStart rk.F (srcCol_D8 rk c) k) y)
    (htgt : Path rk.E (actualKeys rk.E) c (cutQuery (actualKeys rk.E c) k) (cutStart rk.E c k) y) :
    respEdge rk.F (actualKeys rk.F) (srcCol_D8 rk c) (cutQuery (actualKeys rk.F (srcCol_D8 rk c)) k)
        y =
      respEdge rk.E (actualKeys rk.E) c (cutQuery (actualKeys rk.E c) k) y := by
  have hk' := h.2.2.2.2.2.2
  obtain ⟨hA, hsrcA⟩ : SrcRecord.AnchorAt rk.E (some w) i j rk.b ∧
      SrcRecord.anchorSrc rk.E (some w) i = some rk.a := by
    rcases hkind with hkind | hkind <;> rw [hkind] at hk' <;> exact ⟨hk'.1, hk'.2.1⟩
  have hEL : InL rk.E := Closure.std_inL h.1
  obtain ⟨sd, hsd, hr, ht, hrt⟩ := anchor_hosts_D8 h.1 hA hsrcA
  obtain ⟨sd', rd, -, hsd', hrd, hor, hreach, -⟩ := hA
  rw [hsd] at hsd'; cases hsd'
  simp only [Closure.anchorOrigin, Closure.anchor] at hor hsd hrd hsrcA
  have hj : j < sd.Q.length := by
    obtain ⟨-, x, y, -, hy, -⟩ := hreach
    have := List.getElem?_eq_some_iff.1 hy
    simpa [queryKeys] using this.1
  obtain ⟨hst, -, hlen, -, hq⟩ := Closure.admCap_query hEL w hsd
  have hbw : rk.b = ⟨w.col, j⟩ := by
    have := (hq j (hlen ▸ hj)).1
    rw [hor, Option.some.injEq, Role.slot.injEq] at this
    exact this
  have ha : rk.a = ⟨rd.col, i⟩ := by
    simp only [SrcRecord.anchorSrc, Closure.anchor, hrd, Option.map_some] at hsrcA
    exact (Option.some.inj hsrcA).symm
  obtain ⟨hres, -⟩ := rootData_path hsd hrd
  obtain ⟨haH, hFeq, hAle⟩ := srcCtx_D8 h hkind
  simp only [Closure.anchor] at haH hFeq hAle
  obtain ⟨ρ, colB, colA, hρ, hsrcc, hB, hcA, -, -, ⟨q', H', hAk, -⟩, -, -⟩ := capSetup_D8 h hfd
  obtain ⟨hc'F, hkE, -, hW, -⟩ := query_transfer_D8 h hfd
  obtain ⟨-, hcE⟩ := capAt_col_D8 h hfd
  set r := rk.a.col.num 0
  set t := rk.b.col.num 0
  set c' := srcCol_D8 rk c
  have hFL : InL rk.F := h.2.2.2.1
  have hkF : k ≤ (parents rk.F c').length := by
    simp [parents, hcA]; exact (List.getElem?_eq_some_iff.1 hAk).1.le
  have hcc : c = ⟨rk.b.heightPath ++ ρ, c.col⟩ := by
    obtain ⟨cp, cc⟩ := c; simp only at hρ ⊢; rw [hρ]
  have hac : rk.a.heightPath <+: c'.path := by
    rw [show c' = ⟨rk.a.heightPath ++ ρ, c.col⟩ from hsrcc]; exact ⟨ρ, rfl⟩
  have hbc : rk.b.heightPath <+: c.path := by rw [hcc]; exact ⟨ρ, rfl⟩
  have hc'r : c'.resolve 0 r = some rk.a.col := resolve_host_D8 hac
  have hct : c.resolve 0 t = some w.col := by
    have := resolve_host_D8 hbc
    rw [show w.col = rk.b.col by rw [hbw]]; exact this
  have hTr : sd.col.resolve 0 r = some rk.a.col := by rw [hr, hres, ha]
  -- the source stack below `r` is the stopping column's stack in `H`
  have hsame : ∀ y, y ≤ r → c'.resolve 0 y = sd.col.resolve 0 y := by
    intro y hy
    rcases Nat.lt_or_ge y r with hlt | hge
    · rw [← ColAddr.resolve_of_resolve_lt hc'r hlt, ← ColAddr.resolve_of_resolve_lt hTr hlt]
    · have : y = r := by omega
      rw [this, hc'r, hTr]
  have hcE' : c.resolve 0 y = w.col.resolve 0 y := by
    rw [← ColAddr.resolve_of_resolve_lt hct (show y < t by omega)]
  have hysd : y < sd.t := by omega
  obtain ⟨oH, oE, hoH, hoE, halt⟩ := admCap_stack_D8 hEL w hsd y hysd
  have hres' : c'.resolve 0 y = some oH := by rw [hsame y hyr, hoH]
  have hresE : c.resolve 0 y = some oE := by rw [hcE', hoE]
  have hon : oH.num 0 = y := ColAddr.resolve_num hoH
  have honE : oE.num 0 = y := ColAddr.resolve_num hoE
  unfold respEdge
  rw [hres', hresE]
  simp only [Option.bind_some]
  -- A: κ fixes the low keys
  have hA' : cursor (actualKeys rk.F oH) (cutQuery (actualKeys rk.E c) k) =
      cursor (actualKeys rk.F oH) (cutQuery (actualKeys rk.F c') k) := by
    rw [hW]
    conv_lhs => rw [← kappaW_actualKeys_low_D8 (F := rk.F) (o := oH) (r := r) (t := t) (by omega)]
    exact cursor_map (kappaW_strictMono_D8 (show r ≤ t by omega)) _ _
  have hrespA : resp rk.F (actualKeys rk.F) oH (cutQuery (actualKeys rk.F c') k) =
      resp rk.F (actualKeys rk.F) oH (cutQuery (actualKeys rk.E c) k) := by
    simp only [resp, hA']
  rw [hrespA]
  set W := cutQuery (actualKeys rk.E c) k
  -- B: `F` versus `H`, on the active columns of `a` with the cursor bound
  have hB : ∀ u, ((oH = rk.a.col ∧ u = rk.a.idx) ∨ oH.container rk.a.col = some ⟨oH, u⟩) →
      cursor (actualKeys w.H oH) W ≤ u ∧
        resp rk.F (actualKeys rk.F) oH W = resp w.H (actualKeys w.H) oH W := by
    intro u hou
    have hcont' : oH.container c' = some ⟨oH, u⟩ := by
      rw [ColAddr.container_spec]
      refine ⟨rfl, ?_⟩
      rcases hou with ⟨rfl, rfl⟩ | hco
      · exact hac
      · obtain ⟨-, h2⟩ := (ColAddr.container_spec _ _ _).1 hco
        exact h2.trans ((List.prefix_append _ _).trans hac)
    have hbar : cutQuery (actualKeys rk.F c') k < cutQuery (actualKeys rk.F oH) (u + 1) :=
      cut_barrier_read hFL hc'F hkF hsrc hres' hcont'
    have huF : u < (actualKeys rk.F oH).length := by
      rw [length_actualKeys]
      exact idx_lt_of_mem_entryAddrs (mem_entryAddrs_of_contains hc'F
        ((ColAddr.container_spec _ _ _).1 hcont').2)
    have hcur := cursor_le_of_lt_cutQuery (cutQuery_noninc _ _) huF hbar
    rw [← hA'] at hcur
    rw [hFeq] at hcur ⊢
    obtain ⟨h1, h2⟩ := src_host_resp_D8 haH hAle hou hcur
    exact ⟨by rw [h1]; exact hcur, h2.symm⟩
  rcases halt with ⟨hnc, -, hcol⟩ | ⟨eH, eE, hcH, hcEw, hbf⟩
  · -- closed: `oH` does not contain the stopping column, hence not `a`'s column either
    have hBF : resp rk.F (actualKeys rk.F) oH W = resp w.H (actualKeys w.H) oH W := by
      by_cases hact : ∃ u, (oH = rk.a.col ∧ u = rk.a.idx) ∨ oH.container rk.a.col = some ⟨oH, u⟩
      · obtain ⟨u, hou⟩ := hact
        exact (hB u hou).2
      · have hy : y < r := by
          rcases Nat.lt_or_ge y r with hlt | hge
          · exact hlt
          · exfalso; apply hact
            refine ⟨rk.a.idx, Or.inl ⟨?_, rfl⟩⟩
            have : y = r := by omega
            rw [this, hTr] at hoH; exact (Option.some.inj hoH).symm
        have hst' : rk.a.col.OnStack oH := by
          have := ColAddr.resolve_of_resolve_lt hTr hy
          rw [hoH] at this
          exact ((ColAddr.resolve_spec 0 _ oH y).1 this).1
        have hno : ∀ u, ¬ (⟨oH, u⟩ : EntryAddr).heightPath <+: rk.a.col.path := by
          intro u hu
          exact hact ⟨u, Or.inr ((ColAddr.container_spec _ _ _).2 ⟨rfl, hu⟩)⟩
        have hcl := colAt_truncSet_closed_D8 haH rk.srcHeight hst' hno
        rw [← hFeq] at hcl
        simp only [resp, actualKeys, hcl]
    rw [hBF]
    simp only [resp, actualKeys, hcol, hon, honE]
  · -- route: block form, the cursor bound from B, and the `E`-barrier
    have hroot : oH = rk.a.col ∨ ∃ u, oH.container rk.a.col = some ⟨oH, u⟩ := by
      have hR : sd.col.resolve 0 (rk.a.col.num 0) = some rk.a.col := hTr
      refine contains_root_D8 hR ?_ hcH
      rcases Nat.lt_or_ge y r with hlt | hge
      · left
        have := ColAddr.resolve_of_resolve_lt hTr hlt
        rw [hoH] at this
        exact ((ColAddr.resolve_spec 0 _ oH y).1 this).1
      · right
        have : y = r := by omega
        rw [this, hTr] at hoH; exact (Option.some.inj hoH).symm
    obtain ⟨u, hou⟩ : ∃ u, (oH = rk.a.col ∧ u = rk.a.idx) ∨
        oH.container rk.a.col = some ⟨oH, u⟩ := by
      rcases hroot with h1 | ⟨u, h2⟩
      · exact ⟨rk.a.idx, Or.inl ⟨h1, rfl⟩⟩
      · exact ⟨u, Or.inr h2⟩
    obtain ⟨hcurH, hBF⟩ := hB u hou
    rw [hBF]
    -- `u` is an entry of `oH` in `H`, whose column ends at `eH`
    have huH : u ≤ eH := by
      have hmem : (⟨oH, u⟩ : EntryAddr) ∈ w.H.entryAddrs := by
        rcases hou with ⟨rfl, rfl⟩ | hco
        · exact haH
        · exact mem_entryAddrs_of_contains (Tree.mem_entryAddrs_iff _ _ |>.1 haH |> fun _ =>
            (Tree.mem_colAddrs_iff _ _).2 (by
              have := (Tree.mem_entryAddrs_iff _ _).1 haH
              simp only [Tree.entryAt] at this
              cases h' : w.H.colAt rk.a.col with
              | none => rw [h'] at this; simp at this
              | some _ => rfl)) ((ColAddr.container_spec _ _ _).1 hco).2
      have := idx_lt_of_mem_entryAddrs hmem
      rw [hbf.1] at this
      simpa using this
    have hcEc : oE.container c = some ⟨oE, eE⟩ := by
      rw [hbw] at hbc
      exact container_trans_D8 (e := ⟨w.col, j⟩) hcEw hbc
    have hbarE : W < cutQuery (actualKeys rk.E oE) (eE + 1) := by
      have := cut_barrier_read hEL hcE hkE htgt hresE hcEc
      simpa using this
    have hT := cutQuery_actualKeys_ne_top_D8 rk.E c k
    rw [resp_blockForm_D8 (by rw [hon, honE]) hbf (cutQuery_noninc _ _) hT hbarE]
    -- the decorated cursor of `H` is its actual cursor (`cursor_raise` to `⊤`)
    have hlH : (actualKeys w.H oH).length = eH + 1 := by rw [length_actualKeys, hbf.1]
    have hsplit : actualKeys w.H oH = (actualKeys w.H oH).take eH ++ [(actualKeys w.H oH)[eH]] := by
      rw [List.take_append_getElem (by omega), List.take_of_length_le (by omega)]
    have hcr := cursor_raise ((actualKeys w.H oH).take eH) ((actualKeys w.H oH)[eH]'(by omega)) ⊤ []
      W le_top (by rw [← hsplit, List.length_take]; omega)
    simp only [cappedAt]
    rw [hcr, ← hsplit]
    simp [resp, parents, List.getElem?_map]

/-- G011-L10 (L4.2c step 4(c), scan and descendant records). At every vertex `y ≤ r` reached by
both chains, the source edge (in `F`, query `W'`) equals the target edge (in `E`, query `W`). -/
theorem low_edge_eq_D8 {rk : SrcRecord} (h : rk.Admitted) {cap : Option (Closure.AdmCap rk.E)}
    {i j : Nat} (hkind : rk.kind = .scan cap i j ∨ rk.kind = .desc cap i j) {c : ColAddr}
    {k p : Nat} (hfd : rk.firstDiff = .capAt c k p) {y : Nat} (hyr : y ≤ rk.a.col.num 0)
    (hsrc : Path rk.F (actualKeys rk.F) (srcCol_D8 rk c)
      (cutQuery (actualKeys rk.F (srcCol_D8 rk c)) k) (cutStart rk.F (srcCol_D8 rk c) k) y)
    (htgt : Path rk.E (actualKeys rk.E) c (cutQuery (actualKeys rk.E c) k) (cutStart rk.E c k) y) :
    respEdge rk.F (actualKeys rk.F) (srcCol_D8 rk c) (cutQuery (actualKeys rk.F (srcCol_D8 rk c)) k)
        y =
      respEdge rk.E (actualKeys rk.E) c (cutQuery (actualKeys rk.E c) k) y := by
  cases cap with
  | none => exact low_edge_eq_none_D8 h hkind hfd hyr hsrc htgt
  | some w => exact low_edge_eq_cap_D8 h hkind hfd hyr hsrc htgt

/-- G011-L11 helper: a height replacement changes the column of the replaced entry, and every
column containing it, only at the height of the active entry. -/
theorem setHeight_colAt_active_D8 {t : Forest} {e : EntryAddr} (he : e ∈ t.entryAddrs) (h : Forest)
    {o : ColAddr} {u : Nat} (hou : (o = e.col ∧ u = e.idx) ∨ o.container e.col = some ⟨o, u⟩) :
    ∃ g : Forest → Forest, (t.setHeight e h).colAt o =
      (t.colAt o).map fun col => col.modify u fun x => (x.1, g x.2) := by
  have hav : (t.entryAt e).isSome := (Tree.mem_entryAddrs_iff t e).1 he
  obtain ⟨⟨P, j⟩, i⟩ := e
  rw [Tree.setHeight_eq_body, Tree.setHeightBody, if_pos hav]
  rcases hou with ⟨h1, h2⟩ | hcont
  · simp only at h1 h2
    subst o; subst u
    refine ⟨fun _ => h, ?_⟩
    simp only [Tree.colAt, Tree.forestAt_setAux]
    cases t.forestAt P with
    | none => rfl
    | some F =>
      obtain ⟨cols⟩ := F
      simp [Tree.setAux, Tree.cols, List.getElem?_modify_eq]
  · obtain ⟨-, tl, htl⟩ := (ColAddr.container_spec o ⟨P, j⟩ ⟨o, u⟩).1 hcont
    simp only [EntryAddr.heightPath] at htl
    have hP : P = o.path ++ (o.col, u) :: tl := by rw [← htl]; simp
    have hn : o.path.length ≤ P.length := by rw [hP]; simp
    have htake : P.take o.path.length = o.path := by rw [hP]; simp
    have hdrop : P.drop o.path.length = (o.col, u) :: tl := by rw [hP]; simp
    refine ⟨fun x => Tree.setAux h tl j i x, ?_⟩
    have h1 := forestAt_setAux_take_D8 h j i P t o.path.length hn
    rw [htake, hdrop] at h1
    simp only [Tree.colAt, h1]
    cases t.forestAt o.path with
    | none => rfl
    | some F =>
      obtain ⟨cols⟩ := F
      simp [Tree.setAux, Tree.cols, List.getElem?_modify_eq]

/-- G011-L11 helper: a height replacement keeps the closed columns of the visible stack of the
replaced entry's column. -/
theorem setHeight_colAt_stack_D8 {t : Forest} {e : EntryAddr} (he : e ∈ t.entryAddrs) (h : Forest)
    {o : ColAddr} (ho : e.col.OnStack o)
    (hno : ∀ u, ¬ (⟨o, u⟩ : EntryAddr).heightPath <+: e.col.path) :
    (t.setHeight e h).colAt o = t.colAt o := by
  have hav : (t.entryAt e).isSome := (Tree.mem_entryAddrs_iff t e).1 he
  obtain ⟨⟨P, j⟩, i⟩ := e
  rw [Tree.setHeight_eq_body, Tree.setHeightBody, if_pos hav]
  exact colAt_setAux_stack_D8 _ j i P t o ho (fun u hu => hno u hu)

/-- G011-L11 helper: block form reads only the prefix and the labels, not the active height. -/
theorem blockForm_modify_D8 {colH colE : Column} {eH eE : Nat} (hbf : BlockForm_D8 colH colE eH eE)
    (g : Forest → Forest) :
    BlockForm_D8 (colH.modify eH fun x => (x.1, g x.2)) colE eH eE := by
  obtain ⟨h1, h2, h3, h4, h5⟩ := hbf
  refine ⟨by simp [h1], h2, h3, ?_, fun x hx1 hx2 => ?_⟩
  · rw [← h4]
    apply List.ext_getElem?
    intro n
    rcases Nat.lt_or_ge n eH with hn | hn
    · rw [List.getElem?_take_of_lt hn, List.getElem?_take_of_lt hn, List.getElem?_modify_ne _ _
        (Nat.ne_of_gt hn)]
    · rw [List.getElem?_eq_none (by simp; omega), List.getElem?_eq_none (by simp; omega)]
  · rw [h5 x hx1 hx2, List.getElem?_modify_eq]
    cases colH[eH]? <;> rfl

/-- G011-D2 helper: κ is the identity when the two hosts agree. -/
theorem kappaW_self_D8 (r : Nat) : kappaW_D8 r r = id := by
  funext x
  have : kappa r r = id := by
    funext l; obtain ⟨b, q⟩ := l
    cases b <;> simp [kappa]
  cases x with
  | top => rfl
  | coe K =>
    show WithTop.map (Tree.map (kappa r r)) (K : WithTop Key) = K
    rw [this, WithTop.map_coe, Scan.treeMap_id]

/-- G011-L2 base: the truncation after `b`. -/
theorem repair_base_E8 {E : Forest} {b : EntryAddr} (hb : b ∈ E.entryAddrs) :
    BlockForm_D8 (((E.truncAfter b).colAt b.col).getD []) ((E.colAt b.col).getD []) b.idx b.idx ∧
    StackRel_E8 E b.col (E.truncAfter b) b.col := by
  set A := (E.heightAt b).getD Tree.empty
  have hbT := (Tree.truncAfter_spec E b hb).2.1
  have hid : (E.truncAfter b).setHeight b A = E.truncAfter b := by
    apply (Tree.setHeight_basic (E.truncAfter b) b A hbT).2.2.2.1
    rw [(Tree.truncAfter_spec E b hb).2.2.1]
    obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 ((Tree.mem_entryAddrs_iff E b).1 hb)
    simp [A, Tree.heightAt, hx]
  refine ⟨?_, stackRel_base_E8 (fun o ho hno => ?_) (fun o u hou => ?_)⟩
  · obtain ⟨col, q, X, X', h1, h2, h3, -⟩ := colAt_truncSet_active_D8 hb A (Or.inl ⟨rfl, rfl⟩)
    rw [hid] at h3
    rw [h1, h3]; exact blockForm_trunc_E8 h2
  · rw [← hid]
    refine colAt_truncSet_closed_D8 hb A ho (fun u hu => ?_)
    have := (ColAddr.container_spec o b.col ⟨o, u⟩).2 ⟨rfl, hu⟩
    rw [hno] at this; cases this
  · obtain ⟨col, q, X, X', h1, h2, h3, -⟩ := colAt_truncSet_active_D8 hb A (Or.inr hou)
    rw [hid] at h3
    exact ⟨col, q, X, X', h1, h2, h3⟩

/-- G011-L2 helper: the marked address after one more move. -/
theorem moveAddr_take_succ_E8 (b : EntryAddr) (ms : List Closure.Move) {n : Nat}
    (hn : n < ms.length) :
    Closure.moveAddr (ms.take (n + 1)) b =
      ms[n].mapEntry ms[n].fwdIdx (Closure.moveAddr (ms.take n) b) := by
  rw [List.take_add_one, List.getElem?_eq_getElem hn, Option.toList_some]
  simp only [Closure.moveAddr, Closure.moveAddrBody, List.foldl_append, List.foldl_cons,
    List.foldl_nil]

/-- G011-L2 helper: the moved entry `j` goes to `i`. -/
theorem mapEntry_self_E8 (m : Closure.Move) (hij : m.i < m.j) :
    m.mapEntry m.fwdIdx ⟨m.col, m.j⟩ = ⟨m.col, m.i⟩ := by
  obtain ⟨⟨π, J⟩, i, j⟩ := m
  simp only at hij ⊢
  have hmp : Closure.Move.mapPath (Closure.Move.fwdIdx ⟨⟨π, J⟩, i, j⟩) ⟨⟨π, J⟩, i, j⟩ π = π := by
    unfold Closure.Move.mapPath; simp
  unfold Closure.Move.mapEntry
  simp only [hmp, if_true]
  congr 1
  simp only [Closure.Move.fwdIdx]
  split <;> omega

/-- G011-L2 helper: an entry inside the moved entry follows it. -/
theorem mapEntry_inside_E8 (m : Closure.Move) (hij : m.i < m.j) (ρ : List (Nat × Nat))
    (cc idx : Nat) :
    m.mapEntry m.fwdIdx ⟨⟨m.col.path ++ (m.col.col, m.j) :: ρ, cc⟩, idx⟩ =
      ⟨⟨m.col.path ++ (m.col.col, m.i) :: ρ, cc⟩, idx⟩ := by
  obtain ⟨⟨π, J⟩, i, j⟩ := m
  simp only at hij ⊢
  have hmp : Closure.Move.mapPath (Closure.Move.fwdIdx ⟨⟨π, J⟩, i, j⟩) ⟨⟨π, J⟩, i, j⟩
      (π ++ (J, j) :: ρ) = π ++ (J, i) :: ρ := by
    unfold Closure.Move.mapPath Closure.Move.fwdIdx; simp; omega
  have hne : (⟨π ++ (J, i) :: ρ, cc⟩ : ColAddr) ≠ ⟨π, J⟩ := by
    intro h; have := congrArg (fun c : ColAddr => c.path.length) h; simp at this
  unfold Closure.Move.mapEntry
  simp only [hmp, if_neg hne]

/-- G011-L2: the induction along the repair list. -/
theorem repair_inv_E8 {E : Forest} {b : EntryAddr} (hb : b ∈ E.entryAddrs)
    {ms : List Closure.Move} (hms : Closure.RepairList (E.truncAfter b) b ms) :
    ∀ n, n ≤ ms.length →
      (Closure.moveAddr (ms.take n) b).col.path.map Prod.fst = b.col.path.map Prod.fst ∧
      (Closure.moveAddr (ms.take n) b).col.col = b.col.col ∧
      BlockForm_D8 (((Closure.applyMoves (E.truncAfter b) (ms.take n)).colAt
          (Closure.moveAddr (ms.take n) b).col).getD [])
        ((E.colAt b.col).getD []) (Closure.moveAddr (ms.take n) b).idx b.idx ∧
      StackRel_E8 E b.col (Closure.applyMoves (E.truncAfter b) (ms.take n))
        (Closure.moveAddr (ms.take n) b).col := by
  intro n
  induction n with
  | zero =>
    intro _
    obtain ⟨h1, h2⟩ := repair_base_E8 hb
    exact ⟨rfl, rfl, h1, h2⟩
  | succ n ih =>
    intro hn
    have hn' : n < ms.length := by omega
    obtain ⟨hf, hcc, hbf, hst⟩ := ih (by omega)
    have hstep := hms n hn'
    rw [applyMoves_take_succ_E8 _ _ hn', moveAddr_take_succ_E8 _ _ hn']
    generalize Closure.applyMoves (E.truncAfter b) (ms.take n) = X at *
    generalize Closure.moveAddr (ms.take n) b = a at *
    generalize ms[n] = m at *
    obtain ⟨col, hcol, hij, hjl, -, hlab0, hret⟩ := hstep
    have hlab : ∀ x, m.i ≤ x → x ≤ m.j →
        (col[x]?).map Prod.fst = (col[m.j]?).map Prod.fst := by
      intro x h1 h2
      have := hlab0 x h1 h2
      rw [List.getElem?_eq_getElem (by omega), List.getElem?_eq_getElem hjl]
      simp only [Option.map_some, Option.some.injEq]
      simpa [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (by omega : x < col.length),
        List.getElem?_eq_getElem hjl] using this
    have hmove := applyMove_eq_E8 hcol hij hjl
    rcases hret with hret | hpre
    · -- the move is at the marked entry itself
      subst hret
      have hj : m.j + 1 = col.length := by
        have := hbf.1; rw [hcol, Option.getD_some] at this; simp only at this; omega
      have hst' := stackRel_move_E8 hcol hij hj hlab (Or.inl rfl) hst
      have hmp : m.mapPath m.fwdIdx m.col.path = m.col.path := by
        unfold Closure.Move.mapPath; simp
      rw [hmp] at hst'
      rw [mapEntry_self_E8 m hij]
      refine ⟨hf, hcc, ?_, hst'⟩
      rw [hmove, (colAt_modifyColAux_at_E8 _ m.col.path m.col.col X m.col.col).2]
      have hcol' : X.colAt ⟨m.col.path, m.col.col⟩ = some col := hcol
      rw [hcol', Option.map_some, Option.getD_some]
      rw [hcol, Option.getD_some] at hbf
      exact blockForm_move_E8 hbf hij hlab
    · -- the move is in a containing column
      have hq : m.col.num 0 < b.col.num 0 := by
        have h1 := ColAddr.resolve_lt (resolve_host_D8 hpre)
        have h2 : a.col.num 0 = b.col.num 0 := by
          calc a.col.num 0 = (⟨a.col.path, a.col.col⟩ : ColAddr).num 0 := rfl
            _ = (⟨b.col.path, a.col.col⟩ : ColAddr).num 0 := num_of_fst_E8 hf _ _
            _ = b.col.num 0 := by rw [hcc]
        exact h2 ▸ h1
      obtain ⟨oX, oE, hoX, hoE, halt⟩ := hst _ hq
      rw [resolve_host_D8 hpre] at hoX
      cases hoX
      have hcont : m.col.container a.col = some ⟨m.col, m.j⟩ :=
        (ColAddr.container_spec _ _ _).2 ⟨rfl, hpre⟩
      have hj : m.j + 1 = col.length := by
        rcases halt with ⟨h1, -, -⟩ | ⟨eX, eE, h1, -, h3⟩
        · rw [hcont] at h1; cases h1
        · rw [hcont] at h1
          simp only [Option.some.injEq, EntryAddr.mk.injEq, true_and] at h1
          subst h1
          have := h3.1; rw [hcol, Option.getD_some] at this; omega
      have hst' := stackRel_move_E8 hcol hij hj hlab (Or.inr hpre) hst
      obtain ⟨ρ, hρ⟩ := hpre
      obtain ⟨⟨ap, ac⟩, ai⟩ := a
      simp only [EntryAddr.heightPath, List.append_assoc, List.singleton_append] at hρ
      subst hρ
      have hmp : m.mapPath m.fwdIdx (m.col.path ++ (m.col.col, m.j) :: ρ) =
          m.col.path ++ (m.col.col, m.i) :: ρ := by
        obtain ⟨⟨π, J⟩, i, j⟩ := m
        simp only at hij ⊢
        unfold Closure.Move.mapPath Closure.Move.fwdIdx; simp; omega
      simp only at hst' hf hcc hbf ⊢
      rw [hmp] at hst'
      rw [mapEntry_inside_E8 m hij]
      refine ⟨?_, hcc, ?_, hst'⟩
      · rw [← hf]; simp
      · rw [hmove]
        have hcol' : X.colAt ⟨m.col.path, m.col.col⟩ = some col := hcol
        unfold Tree.colAt
        simp only
        rw [forestAt_modifyColAux_inside_E8 _ _ _ hcol' (moveCol_getElem_E8 hij hjl)]
        exact hbf


/-- G011-L2 (owner U2; requested by U3 L4.2c step 4(c), repair records). The stack of a repair
list: the moved truncation `applyMoves (E.truncAfter b) ms` read along the stack of
`moveAddr ms b`, against `E` read along the stack of `b`. The column of `b` itself is in block
form with active indices `(moveAddr ms b).idx` and `b.idx`; below the host, the stacks resolve to
columns of equal number, closed and equal, or both containing and in block form. -/
theorem repairList_stack_D8 {E : Forest} {b : EntryAddr} (hb : b ∈ E.entryAddrs)
    {ms : List Closure.Move} (hms : Closure.RepairList (E.truncAfter b) b ms) :
    (Closure.moveAddr ms b).col.num 0 = b.col.num 0 ∧
    Closure.moveAddr ms b ∈ (Closure.applyMoves (E.truncAfter b) ms).entryAddrs ∧
    BlockForm_D8 (((Closure.applyMoves (E.truncAfter b) ms).colAt (Closure.moveAddr ms b).col).getD [])
      ((E.colAt b.col).getD []) (Closure.moveAddr ms b).idx b.idx ∧
    ∀ q, q < b.col.num 0 → ∃ oX oE, (Closure.moveAddr ms b).col.resolve 0 q = some oX ∧
      b.col.resolve 0 q = some oE ∧ oX.num 0 = oE.num 0 ∧
      ((oX.container (Closure.moveAddr ms b).col = none ∧ oE.container b.col = none ∧
          (Closure.applyMoves (E.truncAfter b) ms).colAt oX = E.colAt oE) ∨
       (∃ eX eE, oX.container (Closure.moveAddr ms b).col = some ⟨oX, eX⟩ ∧
         oE.container b.col = some ⟨oE, eE⟩ ∧
         BlockForm_D8 (((Closure.applyMoves (E.truncAfter b) ms).colAt oX).getD [])
           ((E.colAt oE).getD []) eX eE)) := by
  have hM := repair_inv_E8 hb hms ms.length le_rfl
  rw [List.take_length] at hM
  obtain ⟨hf, hcc, hbf, hst⟩ := hM
  generalize Closure.applyMoves (E.truncAfter b) ms = X at *
  generalize Closure.moveAddr ms b = a at *
  refine ⟨?_, ?_, hbf, fun q hq => ?_⟩
  · calc a.col.num 0 = (⟨a.col.path, a.col.col⟩ : ColAddr).num 0 := rfl
      _ = (⟨b.col.path, a.col.col⟩ : ColAddr).num 0 := num_of_fst_E8 hf _ _
      _ = b.col.num 0 := by rw [hcc]
  · have hl := hbf.1
    rw [Tree.mem_entryAddrs_iff, Tree.entryAt]
    cases hX : X.colAt a.col with
    | none => rw [hX] at hl; simp at hl
    | some colX =>
      rw [hX, Option.getD_some] at hl
      rw [Option.bind_some, List.getElem?_eq_getElem (by omega)]; rfl
  · obtain ⟨oX, oE, h1, h2, h3⟩ := hst q hq
    exact ⟨oX, oE, h1, h2, by rw [ColAddr.resolve_num h1, ColAddr.resolve_num h2], h3⟩

/-- G011-L11 (L4.2c step 4(c), repair records). The same for repair records (`r = t`, κ = id),
through the repair list's block form. -/
theorem low_edge_eq_repair_D8 {rk : SrcRecord} (h : rk.Admitted) {ms : List Closure.Move}
    (hkind : rk.kind = .repair ms) {c : ColAddr} {k p : Nat} (hfd : rk.firstDiff = .capAt c k p)
    {y : Nat} (hyr : y ≤ rk.a.col.num 0)
    (hsrc : Path rk.F (actualKeys rk.F) (srcCol_D8 rk c)
      (cutQuery (actualKeys rk.F (srcCol_D8 rk c)) k) (cutStart rk.F (srcCol_D8 rk c) k) y)
    (htgt : Path rk.E (actualKeys rk.E) c (cutQuery (actualKeys rk.E c) k) (cutStart rk.E c k) y) :
    respEdge rk.F (actualKeys rk.F) (srcCol_D8 rk c) (cutQuery (actualKeys rk.F (srcCol_D8 rk c)) k)
        y =
      respEdge rk.E (actualKeys rk.E) c (cutQuery (actualKeys rk.E c) k) y := by
  have hk' := h.2.2.2.2.2.2
  rw [hkind] at hk'
  obtain ⟨hms, ha, hFX⟩ := hk'
  have hbE : rk.b ∈ rk.E.entryAddrs := h.2.1
  obtain ⟨hnum, haX, hbf0, hst⟩ := repairList_stack_D8 hbE hms
  rw [← ha] at hnum haX hbf0 hst
  set X := Closure.applyMoves (rk.E.truncAfter rk.b) ms
  have hrt : rk.a.col.num 0 = rk.b.col.num 0 := (admitted_hosts h).2.1 ms hkind
  -- `F` is `X` with the source height at `a`
  have haF : rk.a ∈ rk.F.entryAddrs := h.2.2.1
  have hFh : rk.F.heightAt rk.a = some rk.srcHeight := by
    obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 ((Tree.mem_entryAddrs_iff _ _).1 haF)
    simp [SrcRecord.srcHeight, Tree.heightAt, hx]
  have hFeq : rk.F = X.setHeight rk.a rk.srcHeight := by
    rw [← hFX, (Tree.setHeight_basic rk.F rk.a _ haF).2.2.1,
      (Tree.setHeight_basic rk.F rk.a _ haF).2.2.2.1 hFh]
  obtain ⟨ρ, colB, colA, hρ, hsrcc, hB, hcA, -, -, ⟨q', H', hAk, -⟩, -, -⟩ := capSetup_D8 h hfd
  obtain ⟨hc'F, hkE, -, hW, -⟩ := query_transfer_D8 h hfd
  obtain ⟨-, hcE⟩ := capAt_col_D8 h hfd
  rw [hrt, kappaW_self_D8, List.map_id] at hW
  set c' := srcCol_D8 rk c
  have hFL : InL rk.F := h.2.2.2.1
  have hEL : InL rk.E := Closure.std_inL h.1
  have hkF : k ≤ (parents rk.F c').length := by
    simp [parents, hcA]; exact (List.getElem?_eq_some_iff.1 hAk).1.le
  have hcc : c = ⟨rk.b.heightPath ++ ρ, c.col⟩ := by
    obtain ⟨cp, cc⟩ := c; simp only at hρ ⊢; rw [hρ]
  have hac : rk.a.heightPath <+: c'.path := by
    rw [show c' = ⟨rk.a.heightPath ++ ρ, c.col⟩ from hsrcc]; exact ⟨ρ, rfl⟩
  have hbc : rk.b.heightPath <+: c.path := by rw [hcc]; exact ⟨ρ, rfl⟩
  have hc't : c'.resolve 0 (rk.a.col.num 0) = some rk.a.col := resolve_host_D8 hac
  have hct : c.resolve 0 (rk.b.col.num 0) = some rk.b.col := resolve_host_D8 hbc
  have hW' := cutQuery_noninc (actualKeys rk.E c) k
  have hT := cutQuery_actualKeys_ne_top_D8 rk.E c k
  have hsrcF := hsrc
  unfold respEdge
  rw [← hW] at hsrc ⊢
  rcases Nat.lt_or_ge y (rk.a.col.num 0) with hy | hy
  · -- below the host: the stack correspondence of the repair list
    obtain ⟨oX, oE, hoX, hoE, hnumo, halt⟩ := hst y (by omega)
    have hres' : c'.resolve 0 y = some oX := by
      rw [← ColAddr.resolve_of_resolve_lt hc't hy, hoX]
    have hresE : c.resolve 0 y = some oE := by
      rw [← ColAddr.resolve_of_resolve_lt hct (by omega), hoE]
    rw [hres', hresE]
    simp only [Option.bind_some]
    rcases halt with ⟨hnX, -, hcol⟩ | ⟨eX, eE, hcX, hcE', hbf⟩
    · -- closed columns are unchanged and equal
      have hstX : rk.a.col.OnStack oX := ((ColAddr.resolve_spec 0 _ _ _).1 hoX).1
      have hno : ∀ u, ¬ (⟨oX, u⟩ : EntryAddr).heightPath <+: rk.a.col.path := by
        intro u hu
        rw [(ColAddr.container_spec _ _ ⟨oX, u⟩).2 ⟨rfl, hu⟩] at hnX
        cases hnX
      have hset : rk.F.colAt oX = X.colAt oX := by
        rw [hFeq]; exact setHeight_colAt_stack_D8 haX _ hstX hno
      simp only [resp, actualKeys, hset, hcol, hnumo]
    · -- containing columns: barriers on both sides, then the block-form response
      have hcF : oX.container c' = some ⟨oX, eX⟩ := container_trans_D8 hcX hac
      have hcEc : oE.container c = some ⟨oE, eE⟩ := container_trans_D8 hcE' hbc
      have hbarF : cutQuery (actualKeys rk.E c) k < cutQuery (actualKeys rk.F oX) (eX + 1) := by
        have := cut_barrier_read hFL hc'F hkF hsrcF hres' hcF
        rw [← hW] at this; simpa using this
      have hbarE : cutQuery (actualKeys rk.E c) k < cutQuery (actualKeys rk.E oE) (eE + 1) := by
        have := cut_barrier_read hEL hcE hkE htgt hresE hcEc
        simpa using this
      obtain ⟨g, hg⟩ := setHeight_colAt_active_D8 haX rk.srcHeight (Or.inr hcX)
      rw [← hFeq] at hg
      have hbfF : BlockForm_D8 ((rk.F.colAt oX).getD []) ((rk.E.colAt oE).getD []) eX eE := by
        rw [hg]
        cases hXo : X.colAt oX with
        | none =>
          rw [hXo] at hbf; exact absurd hbf.1 (by simp)
        | some colX =>
          rw [hXo] at hbf
          exact blockForm_modify_D8 hbf g
      have hlenF : eX < (actualKeys rk.F oX).length := by
        rw [length_actualKeys, hbfF.1]; omega
      obtain ⟨-, hcap⟩ := cursor_cappedAt (actualKeys rk.F oX) _ eX hlenF hW' hT hbarF
      rw [resp_blockForm_D8 hnumo hbfF hW' hT hbarE]
      simp only [resp, hcap, cappedAt]
      simp [parents, List.getElem?_map]
  · -- at the host: the own columns `a.col` and `b.col`
    have hy' : y = rk.a.col.num 0 := by omega
    subst hy'
    rw [hc't, hrt, hct]
    simp only [Option.bind_some]
    have hcF : rk.a.col.container c' = some rk.a :=
      (ColAddr.container_spec _ _ _).2 ⟨rfl, hac⟩
    have hcEc : rk.b.col.container c = some rk.b :=
      (ColAddr.container_spec _ _ _).2 ⟨rfl, hbc⟩
    have hbarF : cutQuery (actualKeys rk.E c) k < cutQuery (actualKeys rk.F rk.a.col) (rk.a.idx + 1) := by
      have := cut_barrier_read hFL hc'F hkF hsrcF hc't hcF
      rw [← hW] at this; exact this
    have htgt' := htgt
    rw [hrt] at htgt'
    have hbarE : cutQuery (actualKeys rk.E c) k < cutQuery (actualKeys rk.E rk.b.col) (rk.b.idx + 1) :=
      cut_barrier_read hEL hcE hkE htgt' hct hcEc
    obtain ⟨g, hg⟩ := setHeight_colAt_active_D8 haX rk.srcHeight (Or.inl ⟨rfl, rfl⟩)
    rw [← hFeq] at hg
    have hbfF : BlockForm_D8 ((rk.F.colAt rk.a.col).getD []) ((rk.E.colAt rk.b.col).getD [])
        rk.a.idx rk.b.idx := by
      rw [hg]
      cases hXo : X.colAt rk.a.col with
      | none => rw [hXo] at hbf0; exact absurd hbf0.1 (by simp)
      | some colX =>
        rw [hXo] at hbf0
        exact blockForm_modify_D8 hbf0 g
    have hlenF : rk.a.idx < (actualKeys rk.F rk.a.col).length := by
      rw [length_actualKeys, hbfF.1]; omega
    obtain ⟨-, hcap⟩ := cursor_cappedAt (actualKeys rk.F rk.a.col) _ rk.a.idx hlenF hW' hT hbarF
    rw [resp_blockForm_D8 hnum hbfF hW' hT hbarE]
    simp only [resp, hcap, cappedAt]
    simp [parents, List.getElem?_map]

/-- L4.2c helper (step 4(b)): for every record kind, a target chain that reaches the target host
`t` continues to the source host `r` (repair records: `r = t`; scan and descendant records:
`host_crossing_D8`). -/
theorem crossing_D8 {rk : SrcRecord} (h : rk.Admitted) {c : ColAddr} {k p : Nat}
    (hfd : rk.firstDiff = .capAt c k p)
    (ht : Path rk.E (actualKeys rk.E) c (cutQuery (actualKeys rk.E c) k) (cutStart rk.E c k)
      (rk.b.col.num 0)) :
    Path rk.E (actualKeys rk.E) c (cutQuery (actualKeys rk.E c) k) (cutStart rk.E c k)
      (rk.a.col.num 0) := by
  obtain ⟨-, hrep, -⟩ := admitted_hosts h
  obtain ⟨hbc, hc⟩ := capAt_col_D8 h hfd
  have hk := (query_transfer_D8 h hfd).2.1
  have hk' := h.2.2.2.2.2.2
  cases hkind : rk.kind with
  | repair ms => rw [hrep ms hkind]; exact ht
  | scan cap i j =>
    rw [hkind] at hk'
    obtain ⟨sd, hsd, hr, ht', -⟩ := anchor_hosts_D8 h.1 hk'.1 hk'.2.1
    obtain ⟨sd', rd, -, hsd', -, hor, hreach, -⟩ := hk'.1
    rw [hsd] at hsd'; cases hsd'
    have hj : j < sd.Q.length := by
      obtain ⟨-, x, y, -, hy, -⟩ := hreach
      have := List.getElem?_eq_some_iff.1 hy
      simpa [queryKeys] using this.1
    rw [hr]
    exact host_crossing_D8 (Closure.std_inL h.1) hsd hj hor hc hbc hk (ht' ▸ ht)
  | desc cap i j =>
    rw [hkind] at hk'
    obtain ⟨sd, hsd, hr, ht', -⟩ := anchor_hosts_D8 h.1 hk'.1 hk'.2.1
    obtain ⟨sd', rd, -, hsd', -, hor, hreach, -⟩ := hk'.1
    rw [hsd] at hsd'; cases hsd'
    have hj : j < sd.Q.length := by
      obtain ⟨-, x, y, -, hy, -⟩ := hreach
      have := List.getElem?_eq_some_iff.1 hy
      simpa [queryKeys] using this.1
    rw [hr]
    exact host_crossing_D8 (Closure.std_inL h.1) hsd hj hor hc hbc hk (ht' ▸ ht)

/-- L4.2c helper (step 4(c)): the low edges for every record kind. -/
theorem low_edge_D8 {rk : SrcRecord} (h : rk.Admitted) {c : ColAddr} {k p : Nat}
    (hfd : rk.firstDiff = .capAt c k p) {y : Nat} (hyr : y ≤ rk.a.col.num 0)
    (hsrc : Path rk.F (actualKeys rk.F) (srcCol_D8 rk c)
      (cutQuery (actualKeys rk.F (srcCol_D8 rk c)) k) (cutStart rk.F (srcCol_D8 rk c) k) y)
    (htgt : Path rk.E (actualKeys rk.E) c (cutQuery (actualKeys rk.E c) k) (cutStart rk.E c k) y) :
    respEdge rk.F (actualKeys rk.F) (srcCol_D8 rk c) (cutQuery (actualKeys rk.F (srcCol_D8 rk c)) k)
        y =
      respEdge rk.E (actualKeys rk.E) c (cutQuery (actualKeys rk.E c) k) y := by
  cases hkind : rk.kind with
  | scan cap i j => exact low_edge_eq_D8 h (Or.inl hkind) hfd hyr hsrc htgt
  | desc cap i j => exact low_edge_eq_D8 h (Or.inr hkind) hfd hyr hsrc htgt
  | repair ms => exact low_edge_eq_repair_D8 h hkind hfd hyr hsrc htgt

end PathTransfer_D8

-- provides: U3, L4.2c (path transfer: the new parent is on the target's actual cut chain)
theorem firstDiff_path {rk : SrcRecord} (h : rk.Admitted) {c : ColAddr} {k p : Nat}
    (hfd : rk.firstDiff = .capAt c k p) :
    Scan.Path rk.E (Scan.actualKeys rk.E) c (Scan.cutQuery (Scan.actualKeys rk.E c) k)
      (Scan.cutStart rk.E c k) p := by
  set r := rk.a.col.num 0
  set t := rk.b.col.num 0
  have hrt : r ≤ t := (admitted_hosts h).1
  obtain ⟨hc', hk, ⟨p', hp', hpp⟩, hW, hx⟩ := query_transfer_D8 h hfd
  -- the source test: condition A in `F` at the entry `k` of `c'`
  have hsrcA : Scan.Path rk.F (Scan.actualKeys rk.F) (srcCol_D8 rk c)
      (Scan.cutQuery (Scan.actualKeys rk.F (srcCol_D8 rk c)) k) (Scan.cutStart rk.F (srcCol_D8 rk c) k) p' :=
    h.2.2.2.1.2.2.2.1 _ hc' k p' hp'
  have hσr : sigmaNum_D8 r t r = t := by simp [sigmaNum_D8]; omega
  have hσlt : ∀ y, y < r → sigmaNum_D8 r t y = y := fun y hy => by simp [sigmaNum_D8, hy]
  -- the invariant along the source chain
  have key : ∀ y, Scan.Path rk.F (Scan.actualKeys rk.F) (srcCol_D8 rk c)
      (Scan.cutQuery (Scan.actualKeys rk.F (srcCol_D8 rk c)) k) (Scan.cutStart rk.F (srcCol_D8 rk c) k) y →
      Scan.Path rk.E (Scan.actualKeys rk.E) c (Scan.cutQuery (Scan.actualKeys rk.E c) k) (Scan.cutStart rk.E c k)
        (sigmaNum_D8 r t y) ∧
      (y ≤ r → Scan.Path rk.E (Scan.actualKeys rk.E) c (Scan.cutQuery (Scan.actualKeys rk.E c) k)
        (Scan.cutStart rk.E c k) y) := by
    -- crossing at a vertex `≤ r` reached as `σ y`
    have low : ∀ y, y ≤ r → Scan.Path rk.E (Scan.actualKeys rk.E) c (Scan.cutQuery (Scan.actualKeys rk.E c) k)
        (Scan.cutStart rk.E c k) (sigmaNum_D8 r t y) →
        Scan.Path rk.E (Scan.actualKeys rk.E) c (Scan.cutQuery (Scan.actualKeys rk.E c) k) (Scan.cutStart rk.E c k) y := by
      intro y hyr hy
      rcases Nat.lt_or_ge y r with hlt | hge
      · rwa [hσlt y hlt] at hy
      · have hyr' : y = r := by omega
        subst hyr'
        rw [hσr] at hy
        exact crossing_D8 h hfd hy
    intro y hy
    induction hy with
    | refl =>
      have h0 : Scan.Path rk.E (Scan.actualKeys rk.E) c (Scan.cutQuery (Scan.actualKeys rk.E c) k) (Scan.cutStart rk.E c k)
          (sigmaNum_D8 r t (Scan.cutStart rk.F (srcCol_D8 rk c) k)) := by
        rw [← hx]; exact Relation.ReflTransGen.refl
      exact ⟨h0, fun hle => low _ hle h0⟩
    | @tail y z hxy hyz ih =>
      obtain ⟨ih1, ih2⟩ := ih
      have hzy : z < y := Scan.edge_lt h.2.2.2.1.1 hyz
      have hE : Scan.respEdge rk.F (Scan.actualKeys rk.F) (srcCol_D8 rk c)
          (Scan.cutQuery (Scan.actualKeys rk.F (srcCol_D8 rk c)) k) y = some z := (Scan.edge_iff _ _ _ _ _ _).1 hyz
      rcases Nat.lt_or_ge r y with hry | hyr
      · -- internal edge
        have := internal_edge_eq_D8 h hfd hry hxy ih1
        rw [hE, Option.map_some] at this
        have h1 : Scan.Path rk.E (Scan.actualKeys rk.E) c (Scan.cutQuery (Scan.actualKeys rk.E c) k) (Scan.cutStart rk.E c k)
            (sigmaNum_D8 r t z) := ih1.tail ((Scan.edge_iff _ _ _ _ _ _).2 this)
        exact ⟨h1, fun hle => low _ hle h1⟩
      · -- low edge
        have := low_edge_D8 h hfd hyr hxy (ih2 hyr)
        rw [hE] at this
        have h1 : Scan.Path rk.E (Scan.actualKeys rk.E) c (Scan.cutQuery (Scan.actualKeys rk.E c) k) (Scan.cutStart rk.E c k)
            z := (ih2 hyr).tail ((Scan.edge_iff _ _ _ _ _ _).2 this.symm)
        exact ⟨by rwa [hσlt z (by omega)], fun _ => h1⟩
  rw [hpp]
  exact (key p' hsrcA).1


-- provides: U3, L4.2d (an upward literal cap on the actual cut chain is an ordinary V,I,S cap
-- with decorated A)
theorem cap_legal {E : Forest} (hE : IsStd E) {c : ColAddr} {k p : Nat} (hc : c ∈ E.colAddrs)
    (hdepth : c.path ≠ []) (hup : Closure.IsUpward E c k p)
    (hpath : Scan.Path E (Scan.actualKeys E) c (Scan.cutQuery (Scan.actualKeys E c) k)
      (Scan.cutStart E c k) p) :
    let K := Closure.litCap E c k p
    Scan.CondV K ∧ Scan.CondI K ∧ Scan.CondS K ∧
    Scan.CondAK K (Scan.capKeys K (Scan.routeCols K)) ∧ Scan.stepKind K = some .ordinary := by
  intro K
  have hL := Closure.std_inL hE
  have hP := Closure.std_condP hE
  obtain ⟨hV, hI, hH, -, -⟩ := id hL
  have hKV : Scan.CondV K := litCap_condV_D8 hV hc hdepth hup hpath
  have hKI : Scan.CondI K := litCap_condI_D8 hI hc hup
  exact ⟨hKV, hKI, Closure.upward_condS hV hI hH hP hup hKV hKI, litCap_decA_D8 hL hc hup hpath,
    Closure.litCap_ordinary hI hup hKV hKI⟩

section FirstDiffCap_D8
open Scan

/-- L4.2 helper: `labelAbs t` turns a source label above a target label into a larger parent. -/
theorem label_lt_D8 {r t q q' : Nat}
    (h : keyLabelCmp (relLabel t q) (relLabel r q') = .lt) :
    q < labelAbs t (relLabel r q') := by
  unfold relLabel at h ⊢
  by_cases hq : q < t <;> by_cases hq' : q' < r <;>
    simp only [hq, hq', if_true, if_false, keyLabelCmp, labelAbs] at h ⊢
  · rw [show compare false false = Ordering.eq from rfl, Ordering.eq_then] at h
    exact Nat.compare_eq_lt.1 h
  · omega
  · rw [show compare true false = Ordering.gt from rfl] at h
    exact absurd h (by simp [Ordering.then])
  · rw [show compare true true = Ordering.eq from rfl, Ordering.eq_then] at h
    have := Nat.compare_eq_lt.1 h; omega

/-- L4.2 helper: the cap of a first difference is upward. -/
theorem capAt_upward_D8 {rk : SrcRecord} (h : rk.Admitted) {c : ColAddr} {k p : Nat}
    (hfd : rk.firstDiff = .capAt c k p) : Closure.IsUpward rk.E c k p := by
  obtain ⟨-, -, hcap⟩ := firstDiff_spec h
  obtain ⟨ρ, hρ, hcut, hcol, halt⟩ := hcap c k p hfd
  have hb : rk.E.heightAt rk.b = some rk.tgtHeight := by
    have hb := h.2.1
    rw [Tree.mem_entryAddrs_iff, Option.isSome_iff_exists] at hb
    obtain ⟨x, hx⟩ := hb
    simp [SrcRecord.tgtHeight, Tree.heightAt, hx]
  have hcE : rk.E.colAt c = rk.tgtHeight.colAt ⟨ρ, c.col⟩ := by
    have : c = ⟨rk.b.heightPath ++ ρ, c.col⟩ := by cases c; simp_all
    rw [this, colAt_heightPath_D8 hb]
  have htk : rk.tgtKey.colAt ⟨ρ, c.col⟩ =
      (rk.tgtHeight.colAt ⟨ρ, c.col⟩).map (Tree.mapCol (relLabel (rk.b.col.num 0))) := by
    rw [SrcRecord.tgtKey, relKey_eq_map, colAt_map_D8]
  have hsk : ∀ d, rk.srcKey.entryAt d = (rk.srcHeight.entryAt d).map
      fun x => (relLabel (rk.a.col.num 0) x.1, x.2.map (relLabel (rk.a.col.num 0))) := by
    intro d; rw [SrcRecord.srcKey, relKey_eq_map, entryAt_map_D8]
  have htke : ∀ d, rk.tgtKey.entryAt d = (rk.tgtHeight.entryAt d).map
      fun x => (relLabel (rk.b.col.num 0) x.1, x.2.map (relLabel (rk.b.col.num 0))) := by
    intro d; rw [SrcRecord.tgtKey, relKey_eq_map, entryAt_map_D8]
  obtain ⟨colB, hcolB⟩ : ∃ col, rk.tgtHeight.colAt ⟨ρ, c.col⟩ = some col := by
    rw [htk] at hcol
    simpa [Option.isSome_iff_exists] using hcol
  unfold Closure.IsUpward
  rw [hcE, hcolB]
  simp only
  rcases halt with ⟨hnone, l, hs, hsome, hp⟩ | ⟨l₁, h₁, l₂, h₂, h1, h2, hlt, hp⟩
  · -- the target column ends at `k`
    rw [htke] at hnone
    have hBk : colB[k]? = none := by
      simpa [Tree.entryAt, hcolB] using hnone
    rw [hBk]
    simp only
    rw [hsk] at hsome
    obtain ⟨⟨q', H'⟩, hA, -⟩ := Option.map_eq_some_iff.1 hsome
    obtain ⟨colA, hcolA, hAk⟩ := Tree.colAt_of_entryAt hA
    have hcolA' : rk.srcKey.colAt ⟨ρ, c.col⟩ = some (Tree.mapCol (relLabel (rk.a.col.num 0)) colA) := by
      rw [SrcRecord.srcKey, relKey_eq_map, colAt_map_D8, hcolA]; rfl
    have htk' : rk.tgtKey.colAt ⟨ρ, c.col⟩ = some (Tree.mapCol (relLabel (rk.b.col.num 0)) colB) := by
      rw [htk, hcolB]; rfl
    have htake := cutBefore_col_D8 c.col k ρ _ _ _ _ hcut htk' hcolA'
    have hl1 := congrArg List.length htake
    rw [Scan.treeMapCol_eq_map, Scan.treeMapCol_eq_map, List.length_take, List.length_take,
      List.length_map, List.length_map] at hl1
    have hAl : k < colA.length := (List.getElem?_eq_some_iff.1 hAk).1
    have hBl : colB.length ≤ k := List.getElem?_eq_none_iff.1 hBk
    omega
  · rw [htke] at h1
    rw [hsk] at h2
    obtain ⟨⟨q, H⟩, hB, hBl⟩ := Option.map_eq_some_iff.1 h1
    obtain ⟨⟨q', H'⟩, hA, hAl⟩ := Option.map_eq_some_iff.1 h2
    simp only [Prod.mk.injEq] at hBl hAl
    have hBk : colB[k]? = some (q, H) := by simpa [Tree.entryAt, hcolB] using hB
    rw [hBk]
    simp only
    rw [hp, ← hAl.1]
    rw [← hBl.1, ← hAl.1] at hlt
    exact label_lt_D8 hlt

end FirstDiffCap_D8

-- provides: U3, L4.2 (the spine's `firstDiff_cap`†; consumer: U5 L8.8 Case 3)
theorem firstDiff_cap {rk : SrcRecord} (h : rk.Admitted) {c : ColAddr} {k p : Nat}
    (hfd : rk.firstDiff = .capAt c k p) :
    let K := Closure.litCap rk.E c k p
    rk.b.heightPath <+: c.path ∧ c ∈ rk.E.colAddrs ∧ Closure.IsUpward rk.E c k p ∧
    Scan.CondV K ∧ Scan.CondI K ∧ Scan.CondS K ∧
    Scan.CondAK K (Scan.capKeys K (Scan.routeCols K)) ∧
    Scan.stepKind K = some .ordinary ∧
    Scan.Path rk.E (Scan.actualKeys rk.E) c (Scan.cutQuery (Scan.actualKeys rk.E c) k)
      (Scan.cutStart rk.E c k) p := by
  intro K
  obtain ⟨hbc, hc⟩ := capAt_col_D8 h hfd
  have hup := capAt_upward_D8 h hfd
  have hpath := firstDiff_path h hfd
  have hdepth : c.path ≠ [] := by
    obtain ⟨tl, htl⟩ := hbc
    rw [← htl, EntryAddr.heightPath]; simp
  obtain ⟨h1, h2, h3, h4, h5⟩ := cap_legal h.1 hc hdepth hup hpath
  exact ⟨hbc, hc, hup, h1, h2, h3, h4, h5, hpath⟩

/-! ## L4.3  Source reduction -/

/-- L4.3a: an operation of `F` is confined to the marked height of `a`: the stopping column lies
inside that height and, for a special step, so does the owner entry (X-04). -/
def Confined (F : Forest) (a : EntryAddr) : Prop :=
  ∃ sd, Scan.stopData F = some sd ∧ a.heightPath <+: sd.col.path ∧
    (Scan.stepKind F = some .special → ∃ e, sd.ownerEntry = some e ∧ a.heightPath <+: e.col.path)

/-- L4.3a helper: the take-structure of a truncated entry at the last level. -/
theorem take_succ_of_getElem?_E1 {β : Type} {l : List β} {i : Nat} {x : β} (h : l[i]? = some x) :
    l.take (i + 1) = l.take i ++ [x] := by
  rw [List.take_add_one, h]; rfl

theorem length_take_of_getElem?_E1 {β : Type} {l : List β} {i : Nat} {x : β} (h : l[i]? = some x) :
    (l.take i).length = i := by
  have := (List.getElem?_eq_some_iff.mp h).1
  simp; omega

/-- L4.3a helper: the word of a truncated tree with the marked height replaced splits off the
word of that height. -/
theorem wordAt_setAux_trunc_E1 (X : Forest) : ∀ (P : List (Nat × Nat)) (t : Forest) (j i e : Nat),
    (t.entryAt ⟨⟨P, j⟩, i⟩).isSome →
    Scan.wordAt e (Tree.setAux X P j i (Tree.truncAux P j i t)) =
      Scan.wordAt e (Tree.setAux Tree.empty P j i (Tree.truncAux P j i t)) ++
        Scan.wordAt (e + P.length + 1) X
  | [], .node cols, j, i, e, he => by
    rw [Tree.entryAt_eq_bind] at he
    simp only [Tree.forestAt, Option.bind_some, Tree.cols] at he
    obtain ⟨col, hc, hx⟩ : ∃ col, cols[j]? = some col ∧ (col[i]?).isSome := by
      cases hc : cols[j]? with
      | none => rw [hc] at he; simp at he
      | some col => rw [hc] at he; exact ⟨col, rfl, by simpa using he⟩
    obtain ⟨x, hx⟩ := Option.isSome_iff_exists.mp hx
    have hgd : cols.getD j [] = col := by simp [List.getD, hc]
    simp only [Tree.truncAux, hgd, take_succ_of_getElem?_E1 hx, Tree.setAux]
    rw [Tree.list_modify_append_singleton _ _ _ (length_take_of_getElem?_E1 hc),
      Tree.list_modify_append_singleton _ _ _ (length_take_of_getElem?_E1 hx),
      Tree.list_modify_append_singleton _ _ _ (length_take_of_getElem?_E1 hc),
      Tree.list_modify_append_singleton _ _ _ (length_take_of_getElem?_E1 hx)]
    simp only [Scan.wordAt, Scan.wordCols_append', Scan.wordCols, List.append_nil]
    rw [Scan.wordCol_snoc e _ x.1 X]
    simp
  | (c, i₀) :: rest, .node cols, j, i, e, he => by
    rw [Tree.entryAt_cons] at he
    obtain ⟨col, hc, y, hy, hyr⟩ : ∃ col, cols[c]? = some col ∧ ∃ y, col[i₀]? = some y ∧
        (y.2.entryAt ⟨⟨rest, j⟩, i⟩).isSome := by
      simp only [Tree.cols] at he
      cases hc : cols[c]? with
      | none => rw [hc] at he; simp at he
      | some col =>
        cases hy : col[i₀]? with
        | none => simp [hc, hy] at he
        | some y => exact ⟨col, rfl, y, hy, by simpa [hc, hy] using he⟩
    have hgd : cols.getD c [] = col := by simp [List.getD, hc]
    have ih := wordAt_setAux_trunc_E1 X rest y.2 j i (e + 1) hyr
    simp only [Tree.truncAux, hgd, hy, Option.map_some, Option.toList_some, Tree.setAux]
    rw [Tree.list_modify_append_singleton _ _ _ (length_take_of_getElem?_E1 hc),
      Tree.list_modify_append_singleton _ _ _ (length_take_of_getElem?_E1 hy),
      Tree.list_modify_append_singleton _ _ _ (length_take_of_getElem?_E1 hc),
      Tree.list_modify_append_singleton _ _ _ (length_take_of_getElem?_E1 hy)]
    simp only [Scan.wordAt, Scan.wordCols_append', Scan.wordCols, List.append_nil]
    rw [Scan.wordCol_snoc e _ y.1 (Tree.setAux X rest j i (Tree.truncAux rest j i y.2)),
      Scan.wordCol_snoc e _ y.1 (Tree.setAux Tree.empty rest j i (Tree.truncAux rest j i y.2)), ih]
    simp only [List.length_cons, List.append_assoc]
    congr 4
    omega

/-- L4.3a helper: for a tree truncated after `a`, the word of `F.setHeight a X` is the word of
`F.setHeight a ∅` followed by the word of `X` at the depth of `a`'s height. -/
theorem word_setHeight_E1 {F : Forest} {a : EntryAddr} (ha : a ∈ F.entryAddrs)
    (htr : F.truncAfter a = F) (X : Forest) :
    Scan.word (F.setHeight a X) =
      Scan.word (F.setHeight a Tree.empty) ++ Scan.wordAt a.heightPath.length X := by
  have hs : (F.entryAt a).isSome := (Tree.mem_entryAddrs_iff _ _).mp ha
  have ht : Tree.truncAux a.col.path a.col.col a.idx F = F := by
    rw [Tree.truncAfter_eq_body] at htr
    simpa [Tree.truncAfterBody, hs] using htr
  simp only [Tree.setHeight, Tree.setHeightBody, hs, if_true, Scan.word]
  rw [← ht]
  have := wordAt_setAux_trunc_E1 X a.col.path F a.col.col a.idx 0 hs
  rw [this]
  simp [EntryAddr.heightPath]

/-- L4.3a helper: comparing words at a common depth compares the forests. -/
theorem wordAt_lt_iff_E1 (d : Nat) (X Y : Forest) : Scan.wordAt d X < Scan.wordAt d Y ↔ X < Y := by
  rw [← Scan.word_lt_iff]
  have h := fun Z : Forest => Scan.wordAt_add 0 d Z
  simp only [Nat.zero_add] at h
  rw [h X, h Y]
  refine Scan.list_map_lt_iff (S := Set.univ) ?_ (fun _ _ => trivial) (fun _ _ => trivial)
  intro A _ B _ hAB
  obtain ⟨⟨a1, a2⟩, rfl⟩ : ∃ p, toLex p = A := ⟨ofLex A, rfl⟩
  obtain ⟨⟨b1, b2⟩, rfl⟩ : ∃ p, toLex p = B := ⟨ofLex B, rfl⟩
  simp only [ofLex_toLex]
  rw [Prod.Lex.toLex_lt_toLex] at hAB ⊢
  rcases hAB with h1 | ⟨h1, h2⟩
  · left; omega
  · right; exact ⟨by omega, h2⟩


/-- L4.3a helper: replacing along the route through the marked entry replaces inside its height. -/
theorem replaceAt_trunc_E1 (Z : Forest) : ∀ (P : List (Nat × Nat)) (t : Forest) (j i : Nat)
    (p : Nat) (H : Forest) (ℓ : Nat), t.entryAt ⟨⟨P, j⟩, i⟩ = some (p, H) → P.length + 1 ≤ ℓ →
    replaceAt 0 0 Z ℓ (Tree.truncAux P j i t) =
      Tree.setAux (replaceAt 0 0 Z (ℓ - (P.length + 1)) H) P j i (Tree.truncAux P j i t)
  | [], .node cols, j, i, p, H, ℓ + 1, he, _ => by
    rw [Tree.entryAt_eq_bind] at he
    simp only [Tree.forestAt, Option.bind_some, Tree.cols] at he
    obtain ⟨col, hc, hx⟩ : ∃ col, cols[j]? = some col ∧ col[i]? = some (p, H) := by
      cases hc : cols[j]? with
      | none => simp [hc] at he
      | some col => exact ⟨col, rfl, by simpa [hc] using he⟩
    have hgd : cols.getD j [] = col := by simp [List.getD, hc]
    simp only [Tree.truncAux, hgd, take_succ_of_getElem?_E1 hx, Tree.setAux, replaceAt]
    rw [Tree.list_modify_append_singleton _ _ _ (length_take_of_getElem?_E1 hc),
      Tree.list_modify_append_singleton _ _ _ (length_take_of_getElem?_E1 hx)]
    simp only [Scan.mapLast_eq, List.dropLast_concat, List.getLast?_concat, Option.map_some,
      Option.toList_some, Scan.shiftVal_zero_fun, Scan.treeMap_id, Scan.treeMapCol_id_fun, List.map_id]
    simp
  | (c, i₀) :: rest, .node cols, j, i, p, H, ℓ + 1, he, hℓ => by
    rw [Tree.entryAt_cons] at he
    obtain ⟨col, hc, y, hy, hyr⟩ : ∃ col, cols[c]? = some col ∧ ∃ y, col[i₀]? = some y ∧
        y.2.entryAt ⟨⟨rest, j⟩, i⟩ = some (p, H) := by
      simp only [Tree.cols] at he
      cases hc : cols[c]? with
      | none => simp [hc] at he
      | some col =>
        cases hy : col[i₀]? with
        | none => simp [hc, hy] at he
        | some y => exact ⟨col, rfl, y, hy, by simpa [hc, hy] using he⟩
    have hgd : cols.getD c [] = col := by simp [List.getD, hc]
    have ih := replaceAt_trunc_E1 Z rest y.2 j i p H ℓ hyr (by simp at hℓ; omega)
    simp only [Tree.truncAux, hgd, hy, Option.map_some, Option.toList_some, Tree.setAux, replaceAt]
    rw [Tree.list_modify_append_singleton _ _ _ (length_take_of_getElem?_E1 hc),
      Tree.list_modify_append_singleton _ _ _ (length_take_of_getElem?_E1 hy)]
    simp only [Scan.mapLast_eq, List.dropLast_concat, List.getLast?_concat, Option.map_some,
      Option.toList_some, Scan.shiftVal_zero_fun, Scan.treeMap_id, Scan.treeMapCol_id_fun, List.map_id]
    simp only [id, ih, List.length_cons]
    have h1 : ℓ + 1 - (rest.length + 1 + 1) = ℓ - (rest.length + 1) := by omega
    rw [h1]
    simp


-- provides: U3, L4.3a (a confined operation only replaces the marked height, and decreases it)
theorem expand_confined {F F' : Forest} {a : EntryAddr} {k : Nat} (hF : Scan.InL F)
    (ha : a ∈ F.entryAddrs) (htr : F.truncAfter a = F) (hc : Confined F a)
    (hexp : expand F k = some F') :
    ∃ A'', F' = F.setHeight a A'' ∧ A'' < (F.heightAt a).getD Tree.empty := by
  have hs : (F.entryAt a).isSome := (Tree.mem_entryAddrs_iff _ _).mp ha
  obtain ⟨⟨p, H⟩, hpH⟩ := Option.isSome_iff_exists.mp hs
  have ht : Tree.truncAux a.col.path a.col.col a.idx F = F := by
    rw [Tree.truncAfter_eq_body] at htr
    simpa [Tree.truncAfterBody, hs] using htr
  have hne : F ≠ Tree.empty := by
    rintro rfl
    simp only [Tree.empty, Tree.entryAt, Tree.colAt] at hpH
    cases hp : a.col.path with
    | nil => simp [hp, Tree.forestAt, Tree.cols] at hpH
    | cons x rest => simp [hp, Tree.forestAt, Tree.cols] at hpH
  have key : ∀ Z ℓ, a.heightPath.length ≤ ℓ →
      replaceAt 0 0 Z ℓ F = F.setHeight a (replaceAt 0 0 Z (ℓ - a.heightPath.length) H) := by
    intro Z ℓ hℓ
    have h1 := replaceAt_trunc_E1 Z a.col.path F a.col.col a.idx p H ℓ hpH
      (by simpa [EntryAddr.heightPath] using hℓ)
    rw [ht] at h1
    rw [h1]
    simp [Tree.setHeight, Tree.setHeightBody, hs, EntryAddr.heightPath]
  obtain ⟨sd, hsd, hin, hsp⟩ := hc
  obtain ⟨-, hdepth, -⟩ := Scan.stopData_spec hsd
  have hexp0 := hexp
  rw [Scan.expand_eq_paperOp hne hF.1 hF.2.1 k] at hexp
  obtain ⟨A'', hF'⟩ : ∃ A'', F' = F.setHeight a A'' := by
    obtain ⟨kd, hkd⟩ := Option.isSome_iff_exists.mp (Scan.stepKind_isSome hne hF.1 hF.2.1)
    cases kd with
    | deletion =>
      exfalso
      obtain ⟨x, xs, hx⟩ := Scan.lastCol_of_stopData hsd
      rw [(Scan.stepKind_deletion_iff F).mp hkd] at hx
      simp at hx
    | special =>
      obtain ⟨oe, hoe, hoein⟩ := hsp hkd
      obtain ⟨-, hoeh, -, col, q, Fl, hcol, hlast, -, -⟩ := Scan.ownerEntry_spec hkd hsd hoe
      rw [Scan.paperOp_special hkd hsd hoe hcol hlast] at hexp
      obtain rfl := Option.some.inj hexp
      refine ⟨_, key _ _ ?_⟩
      show a.heightPath.length ≤ sd.depth - 1
      have h1 := hoein.length_le
      have h2 : oe.heightPath.length = oe.col.path.length + 1 := by simp [EntryAddr.heightPath]
      rw [hoeh] at h2
      omega
    | ordinary =>
      obtain ⟨rd, hrd⟩ := Option.isSome_iff_exists.mp (Scan.rootData_of_ordinary hkd)
      rw [Scan.paperOp_ordinary hkd hsd hrd] at hexp
      split at hexp
      · simp at hexp
      · obtain rfl := Option.some.inj hexp
        refine ⟨_, key _ _ ?_⟩
        show a.heightPath.length ≤ sd.depth
        have h1 := hin.length_le
        omega
  refine ⟨A'', hF', ?_⟩
  have hlt := Closure.expand_lt hne hF.1 hF.2.1 hexp0
  have hsome : F.heightAt a = some H := by simp [Tree.heightAt, hpH]
  have hFF : F.setHeight a H = F := (Tree.setHeight_basic F a H ha).2.2.2.1 hsome
  rw [hsome, Option.getD_some]
  rw [hF', ← Scan.word_lt_iff] at hlt
  conv at hlt => rhs; rw [← hFF]
  rw [word_setHeight_E1 ha htr A'', word_setHeight_E1 ha htr H, Scan.list_append_lt_append_left,
    wordAt_lt_iff_E1] at hlt
  exact hlt

-- provides: U3, L4.3a (a safe prefix cutting inside the marked height)
theorem safePrefix_inside {F : Forest} {a : EntryAddr} (ha : a ∈ F.entryAddrs)
    (htr : F.truncAfter a = F) {k : Nat}
    (hk : Scan.mu (F.setHeight a Tree.empty) ≤ k) :
    ∃ A'', Scan.safePrefix F k = F.setHeight a A'' ∧ A'' ≤ (F.heightAt a).getD Tree.empty := by
  set A' := (F.heightAt a).getD Tree.empty with hA'
  have hsome : F.heightAt a = some A' := by
    have hs : (F.entryAt a).isSome := (Tree.mem_entryAddrs_iff _ _).mp ha
    obtain ⟨x, hx⟩ := Option.isSome_iff_exists.mp hs
    simp [hA', Tree.heightAt, hx]
  have hFF : F.setHeight a A' = F := (Tree.setHeight_basic F a A' ha).2.2.2.1 hsome
  set W0 := Scan.word (F.setHeight a Tree.empty) with hW0
  have hk' : W0.length ≤ k := hk
  refine ⟨Scan.safePrefix A' (k - W0.length), ?_, Scan.safePrefix_le _ _⟩
  apply Scan.word_injective
  rw [word_setHeight_E1 ha htr, Scan.word_safePrefix, ← hW0]
  conv_lhs => rw [← hFF, word_setHeight_E1 ha htr, ← hW0]
  rw [List.take_append, List.take_of_length_le hk']
  congr 1
  exact (Scan.spF_spec _ _ _).1.symm

/-- L4.3: scan records become descendant records after a source reduction. -/
def RecKind.toDesc {E : Forest} : RecKind E → RecKind E
  | .scan cap i j => .desc cap i j
  | k => k

/-- L4.3 helper: truncating after `a` keeps the height of `a`. -/
theorem heightAt_truncAfter_self_E1 (H : Forest) (a : EntryAddr) :
    (H.truncAfter a).heightAt a = H.heightAt a := by
  by_cases ha : a ∈ H.entryAddrs
  · exact (Tree.truncAfter_spec H a ha).2.2.1
  · have hn : ¬ (H.entryAt a).isSome := fun h => ha ((Tree.mem_entryAddrs_iff _ _).mpr h)
    rw [Tree.truncAfter_eq_body]
    simp [Tree.truncAfterBody, hn]

/-- L4.3 helper: a tree with an entry `a` is unchanged by re-setting the height of `a`. -/
theorem setHeight_heightAt_self_E1 {F : Forest} {a : EntryAddr} (ha : a ∈ F.entryAddrs) :
    F.setHeight a ((F.heightAt a).getD Tree.empty) = F := by
  apply (Tree.setHeight_basic F a _ ha).2.2.2.1
  have hs : (F.entryAt a).isSome := (Tree.mem_entryAddrs_iff _ _).mp ha
  obtain ⟨x, hx⟩ := Option.isSome_iff_exists.mp hs
  simp [Tree.heightAt, hx]

-- provides: U3, L4.3 (the spine's `reduce_confined`†; consumers: U5 L8.8 Case 2, W)
theorem reduce_confined {rk : SrcRecord} (h : rk.Admitted) {A'' : Forest}
    (hle : A'' ≤ rk.srcHeight) (hL : Scan.InL (rk.F.setHeight rk.a A''))
    (hlt : rk.tgtKey < relKey (rk.a.col.num 0) A'') :
    ({ rk with F := rk.F.setHeight rk.a A'', kind := rk.kind.toDesc } : SrcRecord).Admitted := by
  obtain ⟨E, b, F, a, kind⟩ := rk
  obtain ⟨hstd, hb, ha, -, htr, -, hk⟩ := h
  dsimp only [SrcRecord.srcHeight] at hle hL hlt ha htr hk hb hstd ⊢
  have hSB := Tree.setHeight_basic F a A'' ha
  have hidem : ∀ X, (F.setHeight a A'').setHeight a X = F.setHeight a X := hSB.2.2.1
  have hsrc : ((F.setHeight a A'').heightAt a).getD Tree.empty = A'' := by
    simp [hSB.2.1]
  refine ⟨hstd, hb, hSB.1, hL, hSB.2.2.2.2.1 htr, ?_, ?_⟩
  · show _ < relKey _ (((F.setHeight a A'').heightAt a).getD Tree.empty)
    rw [hsrc]; exact hlt
  · cases kind with
    | scan cap i j =>
      obtain ⟨hA, hS, hF⟩ := hk
      refine ⟨hA, hS, ?_, ?_⟩
      · rw [hidem, ← heightAt_truncAfter_self_E1, ← hF]
        exact setHeight_heightAt_self_E1 ha
      · show ((F.setHeight a A'').heightAt a).getD Tree.empty ≤ _
        rw [hsrc]
        refine le_trans hle ?_
        rw [hF, heightAt_truncAfter_self_E1]
    | desc cap i j =>
      obtain ⟨hA, hS, hF, hle'⟩ := hk
      refine ⟨hA, hS, ?_, ?_⟩
      · rw [hidem]; exact hF
      · show ((F.setHeight a A'').heightAt a).getD Tree.empty ≤ _
        rw [hsrc]; exact le_trans hle hle'
    | repair ms =>
      obtain ⟨hR, hm, hF⟩ := hk
      refine ⟨hR, hm, ?_⟩
      show (F.setHeight a A'').setHeight a _ = _
      rw [hidem]; exact hF

/-- L4.3 helper: a literal cap through a containing entry is the tree truncated after that
entry, with the entry's height replaced by the relative literal cap. -/
theorem litCapAux_split_E1 (k p : Nat) (R : List (Nat × Nat)) (j : Nat) :
    ∀ (Q : List (Nat × Nat)) (t : Forest) (j' i' q : Nat) (h : Forest),
      t.entryAt ⟨⟨Q, j'⟩, i'⟩ = some (q, h) →
      Closure.litCapAux k p (Q ++ (j', i') :: R) j t =
        Tree.setAux (Closure.litCapAux k p R j h) Q j' i' (Tree.truncAux Q j' i' t)
  | [], .node cols, j', i', q, h, he => by
    rw [Tree.entryAt_eq_bind] at he
    simp only [Tree.forestAt, Option.bind_some, Tree.cols] at he
    obtain ⟨col, hc, hx⟩ : ∃ col, cols[j']? = some col ∧ col[i']? = some (q, h) := by
      cases hc : cols[j']? with
      | none => simp [hc] at he
      | some col => exact ⟨col, rfl, by simpa [hc] using he⟩
    have hgd : cols.getD j' [] = col := by simp [List.getD, hc]
    simp only [List.nil_append, Closure.litCapAux, hgd, hx, Tree.truncAux,
      take_succ_of_getElem?_E1 hx, Tree.setAux]
    rw [Tree.list_modify_append_singleton _ _ _ (length_take_of_getElem?_E1 hc),
      Tree.list_modify_append_singleton _ _ _ (length_take_of_getElem?_E1 hx)]
  | (a, b) :: Q, .node cols, j', i', q, h, he => by
    rw [Tree.entryAt_cons] at he
    obtain ⟨col, hc, y, hy, hyr⟩ : ∃ col, cols[a]? = some col ∧ ∃ y, col[b]? = some y ∧
        y.2.entryAt ⟨⟨Q, j'⟩, i'⟩ = some (q, h) := by
      simp only [Tree.cols] at he
      cases hc : cols[a]? with
      | none => simp [hc] at he
      | some col =>
        cases hy : col[b]? with
        | none => simp [hc, hy] at he
        | some y => exact ⟨col, rfl, y, hy, by simpa [hc, hy] using he⟩
    have hgd : cols.getD a [] = col := by simp [List.getD, hc]
    have ih := litCapAux_split_E1 k p R j Q y.2 j' i' q h hyr
    simp only [List.cons_append, Closure.litCapAux, hgd, hy, Tree.truncAux, Option.map_some,
      Option.toList_some, Tree.setAux, ih]
    rw [Tree.list_modify_append_singleton _ _ _ (length_take_of_getElem?_E1 hc),
      Tree.list_modify_append_singleton _ _ _ (length_take_of_getElem?_E1 hy)]

/-- L4.3 helper: an entry containing a column of `E` is an entry of `E`. -/
theorem mem_entryAddrs_of_container_E1 {E : Forest} {c : ColAddr} {e : EntryAddr}
    (hc : c ∈ E.colAddrs) (he : e.heightPath <+: c.path) : e ∈ E.entryAddrs := by
  rw [Tree.mem_entryAddrs_iff]
  have h1 := (Tree.mem_colAddrs_iff _ _).mp hc
  obtain ⟨ρ, hρ⟩ := he
  unfold Tree.colAt at h1
  rw [← hρ, Tree.forestAt_append, Tree.forestAt_heightPath] at h1
  unfold Tree.heightAt at h1
  cases hx : E.entryAt e with
  | none => simp [hx] at h1
  | some _ => rfl

/-- L4.3 helper: the literal cap at a column inside the height of `e` is `E` truncated after `e`
with the height of `e` replaced. -/
theorem litCap_eq_setHeight_E1 {E : Forest} {c : ColAddr} {e : EntryAddr} (hc : c ∈ E.colAddrs)
    (he : e.heightPath <+: c.path) (k p : Nat) :
    Closure.litCap E c k p = (E.truncAfter e).setHeight e
      (Closure.litCapAux k p (c.path.drop e.heightPath.length) c.col
        ((E.heightAt e).getD Tree.empty)) := by
  have heE := mem_entryAddrs_of_container_E1 hc he
  have hs : (E.entryAt e).isSome := (Tree.mem_entryAddrs_iff _ _).mp heE
  obtain ⟨⟨q, h⟩, hqh⟩ := Option.isSome_iff_exists.mp hs
  have hcs : (E.colAt c).isSome := (Tree.mem_colAddrs_iff _ _).mp hc
  obtain ⟨ρ, hρ⟩ := he
  have hpath : c.path = e.col.path ++ (e.col.col, e.idx) :: ρ := by
    rw [← hρ]; simp [EntryAddr.heightPath]
  have htr : E.truncAfter e = Tree.truncAux e.col.path e.col.col e.idx E := by
    rw [Tree.truncAfter_eq_body]; simp [Tree.truncAfterBody, hs]
  have hts : ((Tree.truncAux e.col.path e.col.col e.idx E).entryAt e).isSome := by
    rw [← htr, Tree.entryAt_truncAfter heE]; exact hs
  have hdrop : c.path.drop e.heightPath.length = ρ := by
    rw [← hρ]; simp
  rw [hdrop]
  simp only [Closure.litCap, Closure.litCapBody, hcs, if_true]
  rw [hpath, litCapAux_split_E1 k p ρ c.col e.col.path E e.col.col e.idx q h hqh]
  rw [htr]
  simp only [Tree.setHeight, Tree.setHeightBody, hts, if_true, Tree.heightAt, hqh,
    Option.map_some, Option.getD_some]

/-- L4.3 helper: setting a container's height in a literal cap is setting it in `E` truncated
after that container. -/
theorem litCap_setHeight_E1 {E : Forest} {c : ColAddr} {e : EntryAddr} (hc : c ∈ E.colAddrs)
    (he : e.heightPath <+: c.path) (k p : Nat) (X : Forest) :
    (Closure.litCap E c k p).setHeight e X = (E.truncAfter e).setHeight e X := by
  have heE := mem_entryAddrs_of_container_E1 hc he
  rw [litCap_eq_setHeight_E1 hc he k p]
  exact (Tree.setHeight_basic _ e _ (Tree.truncAfter_spec E e heE).2.1).2.2.1 X

/-- L4.3 helper: a literal cap is truncated after each container of its column. -/
theorem litCap_truncAfter_E1 {E : Forest} {c : ColAddr} {e : EntryAddr} (hc : c ∈ E.colAddrs)
    (he : e.heightPath <+: c.path) (k p : Nat) :
    (Closure.litCap E c k p).truncAfter e = Closure.litCap E c k p := by
  have heE := mem_entryAddrs_of_container_E1 hc he
  rw [litCap_eq_setHeight_E1 hc he k p]
  exact (Tree.setHeight_basic _ e _ (Tree.truncAfter_spec E e heE).2.1).2.2.2.2.1
    (Tree.truncAfter_spec E e heE).1


/-- L4.3 helper: on a tree truncated after `a`, `setHeight a` is strictly monotone. -/
theorem setHeight_lt_iff_E1 {F : Forest} {a : EntryAddr} (ha : a ∈ F.entryAddrs)
    (htr : F.truncAfter a = F) (X Y : Forest) : F.setHeight a X < F.setHeight a Y ↔ X < Y := by
  rw [← Scan.word_lt_iff, word_setHeight_E1 ha htr X, word_setHeight_E1 ha htr Y,
    Scan.list_append_lt_append_left, wordAt_lt_iff_E1]

/-- L4.3b helper: what follows a column's entry and its forest's later columns starts shallow. -/
theorem head_later_cols_E1 (d : Nat) (es : Column) (cs : List Column) :
    ∀ y ∈ (Scan.wordLater d es ++ Scan.wordCols d cs).head?, (ofLex y).1 ≤ 2 * d + 1 := by
  intro y hy
  cases es with
  | cons e es =>
    obtain ⟨p, h⟩ := e
    simp [Scan.wordLater] at hy; subst hy; simp
  | nil =>
    cases cs with
    | nil => simp [Scan.wordLater, Scan.wordCols] at hy
    | cons c cs =>
      cases c with
      | nil => simp [Scan.wordLater, Scan.wordCols, Scan.wordCol] at hy; subst hy; simp
      | cons e es' =>
        obtain ⟨p, h⟩ := e
        simp [Scan.wordLater, Scan.wordCols, Scan.wordCol] at hy; subst hy; simp

/-- L4.3b helper: the word of a tree is the word of its truncation after an entry, followed by
atoms that start outside that entry's height. -/
theorem wordAt_truncAux_post_E1 : ∀ (ρ : List (Nat × Nat)) (s : Forest) (j i d : Nat)
    (x : Nat × Forest), s.entryAt ⟨⟨ρ, j⟩, i⟩ = some x →
    ∃ post, Scan.wordAt d s = Scan.wordAt d (Tree.truncAux ρ j i s) ++ post ∧
      ∀ y ∈ post.head?, (ofLex y).1 < 2 * (d + ρ.length + 1)
  | [], .node cols, j, i, d, x, he => by
    rw [Tree.entryAt_eq_bind] at he
    simp only [Tree.forestAt, Option.bind_some, Tree.cols] at he
    cases hc : cols[j]? with
    | none => rw [hc] at he; simp at he
    | some col =>
      rw [hc, Option.bind_some] at he
      obtain ⟨cols₁, cols₂, rfl, rfl⟩ := Tree.exists_split_of_getElem? hc
      obtain ⟨es₁, es₂, rfl, rfl⟩ := Tree.exists_split_of_getElem? he
      refine ⟨Scan.wordLater d es₂ ++ Scan.wordCols d cols₂, ?_, ?_⟩
      · simp only [Tree.truncAux, List.getD_eq_getElem?_getD, List.getElem?_append_right le_rfl,
          Nat.sub_self, List.getElem?_cons_zero, Option.getD_some, List.take_append_of_le_length le_rfl,
          List.take_length, List.take_append, List.length_cons, List.take_succ_cons,
          List.take_zero, Nat.sub_self, List.take_of_length_le le_rfl]
        simp only [Scan.wordAt, Scan.wordCols_append', Scan.wordCols, List.append_nil]
        rw [show es₁ ++ x :: es₂ = (es₁ ++ [x]) ++ es₂ by simp,
          Scan.wordCol_append_of_ne_nil d (by simp) es₂]
        simp [List.take_of_length_le (show es₁.length ≤ es₁.length + 1 by omega)]
      · intro y hy
        have := head_later_cols_E1 d es₂ cols₂ y hy
        simp; omega
  | (c₀, i₀) :: ρ, .node cols, j, i, d, x, he => by
    rw [Tree.entryAt_eq_bind, Tree.forestAt_cons] at he
    simp only [Tree.cols] at he
    cases hc : cols[c₀]? with
    | none => rw [hc] at he; simp at he
    | some col =>
      rw [hc, Option.bind_some] at he
      cases hi : col[i₀]? with
      | none => rw [hi] at he; simp at he
      | some y =>
        obtain ⟨p₀, h₀⟩ := y
        rw [hi, Option.bind_some] at he
        replace he : h₀.entryAt ⟨⟨ρ, j⟩, i⟩ = some x := by rw [Tree.entryAt_eq_bind]; exact he
        obtain ⟨post', hpost', hhead'⟩ := wordAt_truncAux_post_E1 ρ h₀ j i (d + 1) x he
        obtain ⟨cols₁, cols₂, rfl, rfl⟩ := Tree.exists_split_of_getElem? hc
        obtain ⟨es₁, es₂, rfl, rfl⟩ := Tree.exists_split_of_getElem? hi
        refine ⟨post' ++ Scan.wordLater d es₂ ++ Scan.wordCols d cols₂, ?_, ?_⟩
        · simp only [Tree.truncAux, List.getD_eq_getElem?_getD, List.getElem?_append_right le_rfl,
            Nat.sub_self, List.getElem?_cons_zero, Option.getD_some, List.take_append_of_le_length le_rfl,
            List.take_length, Option.map_some, Option.toList_some]
          simp only [Scan.wordAt, Scan.wordCols_append', Scan.wordCols, List.append_nil]
          rw [show es₁ ++ (p₀, h₀) :: es₂ = (es₁ ++ [(p₀, h₀)]) ++ es₂ by simp,
            Scan.wordCol_append_of_ne_nil d (by simp) es₂, Scan.wordCol_snoc d es₁ p₀ h₀,
            Scan.wordCol_snoc d es₁ p₀ (Tree.truncAux ρ j i h₀), hpost']
          simp
        · intro y hy
          cases post' with
          | cons z zs =>
            simp at hy; subst hy
            have := hhead' z (by simp)
            simp only [List.length_cons]; omega
          | nil =>
            simp only [List.nil_append] at hy
            have := head_later_cols_E1 d es₂ cols₂ y hy
            simp only [List.length_cons]; omega


/-- L4.3b helper: a strict decrease of a deep word survives shallow continuations. -/
theorem append_lt_append_of_lt_E1 (D : Nat) :
    ∀ (u v p₁ p₂ : List Scan.WordAtom), u < v → (∀ a ∈ v, 2 * D ≤ (ofLex a).1) →
      (∀ y ∈ p₁.head?, (ofLex y).1 < 2 * D) → u ++ p₁ < v ++ p₂
  | _, [], _, _, h, _, _ => absurd h (List.not_lt_nil _)
  | [], b :: v, [], p₂, _, _, _ => by simp
  | [], b :: v, y :: p₁, p₂, _, hv, hp => by
    have h1 := hp y (by simp)
    have h2 := hv b (by simp)
    simp only [List.nil_append, List.cons_append]
    apply List.Lex.rel
    obtain ⟨⟨y1, y2⟩, rfl⟩ : ∃ q, toLex q = y := ⟨ofLex y, rfl⟩
    obtain ⟨⟨b1, b2⟩, rfl⟩ : ∃ q, toLex q = b := ⟨ofLex b, rfl⟩
    simp only [ofLex_toLex] at h1 h2
    show toLex (y1, y2) < toLex (b1, b2)
    rw [Prod.Lex.toLex_lt_toLex]; left; omega
  | a :: u, b :: v, p₁, p₂, h, hv, hp => by
    rw [List.cons_lt_cons_iff] at h
    simp only [List.cons_append]
    rw [List.cons_lt_cons_iff]
    rcases h with h | ⟨rfl, h⟩
    · exact Or.inl h
    · exact Or.inr ⟨rfl, append_lt_append_of_lt_E1 D u v p₁ p₂ h
        (fun x hx => hv x (List.mem_cons_of_mem _ hx)) hp⟩

/-- L4.3b helper: atoms of a word at depth `d` have depth coordinate at least `2d`. -/
theorem wordAt_fst_ge_E1 (d : Nat) (X : Forest) : ∀ a ∈ Scan.wordAt d X, 2 * d ≤ (ofLex a).1 := by
  intro a ha
  have h := Scan.wordAt_add 0 d X
  rw [Nat.zero_add] at h
  rw [h, List.mem_map] at ha
  obtain ⟨b, -, rfl⟩ := ha
  simp

/-- L4.3b helper: the word of `X` around an entry `e`: the part before `e`'s height, the height's
word, and a shallow rest. -/
theorem word_around_E1 {X : Forest} {e : EntryAddr} (he : e ∈ X.entryAddrs) :
    ∃ post, Scan.word X = Scan.word ((X.truncAfter e).setHeight e Tree.empty) ++
        Scan.wordAt e.heightPath.length ((X.heightAt e).getD Tree.empty) ++ post ∧
      ∀ y ∈ post.head?, (ofLex y).1 < 2 * e.heightPath.length := by
  have hs : (X.entryAt e).isSome := (Tree.mem_entryAddrs_iff _ _).mp he
  obtain ⟨x, hx⟩ := Option.isSome_iff_exists.mp hs
  obtain ⟨post, hpost, hhead⟩ := wordAt_truncAux_post_E1 e.col.path X e.col.col e.idx 0 x hx
  have hT := Tree.truncAfter_spec X e he
  have htr : X.truncAfter e = Tree.truncAux e.col.path e.col.col e.idx X := by
    rw [Tree.truncAfter_eq_body]; simp [Tree.truncAfterBody, hs]
  refine ⟨post, ?_, ?_⟩
  · have h1 := word_setHeight_E1 hT.2.1 hT.1 ((X.heightAt e).getD Tree.empty)
    rw [← hT.2.2.1, setHeight_heightAt_self_E1 hT.2.1, hT.2.2.1] at h1
    rw [Scan.word, hpost, ← htr, ← Scan.word, h1]
  · intro y hy
    have := hhead y hy
    simp [EntryAddr.heightPath] at this ⊢; omega

/-- L4.3b helper: two trees that agree before the height of `e` (and are ordered) have ordered
heights at `e`. -/
theorem height_le_of_common_E1 {X Y : Forest} {e : EntryAddr} (hXY : X ≤ Y)
    (hX : e ∈ X.entryAddrs) (hY : e ∈ Y.entryAddrs)
    (hT : (X.truncAfter e).setHeight e Tree.empty = (Y.truncAfter e).setHeight e Tree.empty) :
    (X.heightAt e).getD Tree.empty ≤ (Y.heightAt e).getD Tree.empty := by
  by_contra hcon
  have hlt := lt_of_not_ge hcon
  obtain ⟨pX, hwX, hpX⟩ := word_around_E1 hX
  obtain ⟨pY, hwY, hpY⟩ := word_around_E1 hY
  have : Y < X := by
    rw [← Scan.word_lt_iff, hwX, hwY, hT, List.append_assoc, List.append_assoc,
      Scan.list_append_lt_append_left]
    exact append_lt_append_of_lt_E1 _ _ _ _ _ ((wordAt_lt_iff_E1 _ _ _).mpr hlt)
      (wordAt_fst_ge_E1 _ _) hpY
  exact absurd hXY (not_le.mpr this)

/-- L4.3b helper: equal literal caps through a container `e` give equal trees before `e`'s
height. -/
theorem common_of_litCap_E1 {X Y : Forest} {c : ColAddr} {e : EntryAddr} {k p : Nat}
    (hcX : c ∈ X.colAddrs) (hcY : c ∈ Y.colAddrs) (he : e.heightPath <+: c.path)
    (h : Closure.litCap X c k p = Closure.litCap Y c k p) :
    (X.truncAfter e).setHeight e Tree.empty = (Y.truncAfter e).setHeight e Tree.empty := by
  rw [← litCap_setHeight_E1 hcX he k p, ← litCap_setHeight_E1 hcY he k p, h]


/-- L4.3b helper: a move rewrites the step of a path through its column. -/
theorem mapPath_through_E1 (g : Nat → Nat) (m : Closure.Move) (e : Nat) (τ : List (Nat × Nat)) :
    m.mapPath g (m.col.path ++ (m.col.col, e) :: τ) = m.col.path ++ (m.col.col, g e) :: τ := by
  unfold Closure.Move.mapPath; simp

/-- L4.3b helper: a move fixes its own column. -/
theorem mapPath_self_E1 (g : Nat → Nat) (m : Closure.Move) : m.mapPath g m.col.path = m.col.path := by
  unfold Closure.Move.mapPath; simp

/-- L4.3b helper: heights along a same-parent run are nonincreasing under H. -/
theorem condH_run_E1 {E : Forest} (hH : Scan.CondH E) {M : ColAddr} {colE : Column}
    (hM : E.colAt M = some colE) {i j q : Nat}
    (hpar : ∀ x, i ≤ x → x ≤ j → (colE[x]?).map Prod.fst = some q) (hj : j < colE.length) :
    ∀ x, i ≤ x → x ≤ j → (colE.getD j (0, Tree.empty)).2 ≤ (colE.getD x (0, Tree.empty)).2 := by
  have hME : M ∈ E.colAddrs := (Tree.mem_colAddrs_iff _ _).mpr (by simp [hM])
  have hget : ∀ x, x < colE.length → colE[x]? = some (colE.getD x (0, Tree.empty)) := by
    intro x hx
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hx]; simp
  have key : ∀ d, d ≤ j - i →
      (colE.getD j (0, Tree.empty)).2 ≤ (colE.getD (j - d) (0, Tree.empty)).2 := by
    intro d
    induction d with
    | zero => intro _; simp
    | succ d ih =>
      intro hd
      refine le_trans (ih (by omega)) ?_
      have hx := hget (j - (d + 1)) (by omega)
      have hx1 := hget (j - (d + 1) + 1) (by omega)
      have hle := hH M hME (j - (d + 1)) _ _ (by rw [hM]; exact hx) (by rw [hM]; exact hx1)
      have p1 := hpar (j - (d + 1)) (by omega) (by omega)
      have p2 := hpar (j - (d + 1) + 1) (by omega) (by omega)
      rw [hx] at p1; rw [hx1] at p2
      simp only [Option.map_some, Option.some.injEq] at p1 p2
      rw [show j - d = j - (d + 1) + 1 by omega]
      rcases hle with hlt | ⟨-, hle⟩
      · omega
      · exact hle
  intro x hix hxj
  have := key (j - x) (by omega)
  rwa [show j - (j - x) = x by omega] at this

/-- L4.3b helper: upwardness only reads the column. -/
theorem isUpward_congr_E1 {X Y : Forest} {c d : ColAddr} {k p : Nat} (h : X.colAt c = Y.colAt d)
    (hup : Closure.IsUpward X c k p) : Closure.IsUpward Y d k p := by
  unfold Closure.IsUpward at hup ⊢; rw [← h]; exact hup

/-- L4.3b helper: an upward cap column is a column. -/
theorem colAddrs_of_isUpward_E1 {X : Forest} {c : ColAddr} {k p : Nat}
    (hup : Closure.IsUpward X c k p) : c ∈ X.colAddrs := by
  rw [Tree.mem_colAddrs_iff]
  unfold Closure.IsUpward at hup
  split at hup
  · rename_i col hcol; rw [hcol]; rfl
  · exact hup.elim

/-- L4.3b step (txt:699-704): one move of the repair does not decrease the old target height at
the moved marked address. -/
theorem marked_step_E1 {E : Forest} (hH : Scan.CondH E) {bq : EntryAddr}
    {ρ : List (Nat × Nat)} {cc k p : Nat}
    (hup : Closure.IsUpward E ⟨bq.heightPath ++ ρ, cc⟩ k p)
    {m : Closure.Move} {col : Column} {q : Nat} {Hi C : Forest}
    (hcol : (Closure.litCap E ⟨bq.heightPath ++ ρ, cc⟩ k p).colAt m.col = some col)
    (hj : m.j + 1 = col.length) (hij : m.i < m.j)
    (hin : (⟨m.col, m.j⟩ : EntryAddr).heightPath <+: bq.heightPath ++ ρ)
    (hi : col[m.i]? = some (q, Hi)) (hjC : col[m.j]? = some (q, C))
    (hpar : ∀ x, m.i ≤ x → x ≤ m.j → (col[x]?).map Prod.fst = some q)
    (hlt : Hi < C) (hout : ¬ bq.heightPath <+: m.col.path) :
    (E.heightAt bq).getD Tree.empty ≤ (E.heightAt (m.mapEntry m.fwdIdx bq)).getD Tree.empty := by
  set cq : ColAddr := ⟨bq.heightPath ++ ρ, cc⟩ with hcq
  set X := Closure.litCap E cq k p with hX
  set M := m.col with hMdef
  -- the literal cap `X` (U2 `litCap_spec`)
  obtain ⟨colq, hcolq, hkc⟩ : ∃ colq, E.colAt cq = some colq ∧ k ≤ colq.length := by
    have hup' := hup
    unfold Closure.IsUpward at hup'
    split at hup'
    · rename_i colq hc
      refine ⟨colq, hc, ?_⟩
      split at hup'
      · rename_i hk
        exact (List.getElem?_eq_some_iff.mp hk).1.le
      · omega
    · exact hup'.elim
  have hcqE : cq ∈ E.colAddrs := (Tree.mem_colAddrs_iff _ _).mpr (by simp [hcolq])
  have hkp : k ≤ (Scan.parents E cq).length := by simp [Scan.parents, hcolq, hkc]
  obtain ⟨-, hlab, hsame, -, -⟩ := Closure.litCap_spec (p := p) hcqE hkp
  rw [← hX] at hlab hsame
  have hcqp : cq.path = bq.heightPath ++ ρ := rfl
  have hMlen : M.path.length < cq.path.length := by
    have := hin.length_le
    rw [hcqp]
    simp [EntryAddr.heightPath] at this ⊢; omega
  have hMne : ∀ x, (⟨M, x⟩ : EntryAddr) ≠ ⟨cq, k⟩ := by
    intro x h
    have := congrArg (fun e : EntryAddr => e.col.path.length) h
    simp only at this; omega
  have hXent : ∀ x, x < col.length → (⟨M, x⟩ : EntryAddr) ∈ X.entryAddrs := by
    intro x hx
    rw [Tree.mem_entryAddrs_iff]
    simp [Tree.entryAt, hcol, List.getElem?_eq_getElem hx]
  -- the column `M` in `E`
  have hEj : (E.entryAt ⟨M, m.j⟩).map Prod.fst = some q := by
    rw [← hlab _ (hXent m.j (by omega)) (hMne _)]
    simp [Tree.entryAt, hcol, hjC]
  obtain ⟨colE, hcolE⟩ : ∃ colE, E.colAt M = some colE := by
    cases h : E.colAt M with
    | none => simp [Tree.entryAt, h] at hEj
    | some colE => exact ⟨colE, rfl⟩
  have hlabE : ∀ x, x ≤ m.j → (colE[x]?).map Prod.fst = (col[x]?).map Prod.fst := by
    intro x hx
    have := hlab _ (hXent x (by omega)) (hMne x)
    simp only [Tree.entryAt, hcol, hcolE, Option.bind_some] at this
    exact this.symm
  have hjE : m.j < colE.length := by
    have := hlabE m.j le_rfl
    rw [hjC] at this
    by_contra hc
    rw [List.getElem?_eq_none (by omega)] at this
    simp at this
  have hparE : ∀ x, m.i ≤ x → x ≤ m.j → (colE[x]?).map Prod.fst = some q := by
    intro x h1 h2; rw [hlabE x h2]; exact hpar x h1 h2
  have hrun := condH_run_E1 hH hcolE hparE hjE m.i le_rfl hij.le
  set Xj := (colE.getD m.j (0, Tree.empty)).2 with hXj
  set Xi := (colE.getD m.i (0, Tree.empty)).2 with hXi
  have hEXj : E.heightAt ⟨M, m.j⟩ = some Xj := by
    simp [Tree.heightAt, Tree.entryAt, hcolE, List.getElem?_eq_getElem hjE, hXj,
      List.getD_eq_getElem?_getD]
  have hEXi : E.heightAt ⟨M, m.i⟩ = some Xi := by
    simp [Tree.heightAt, Tree.entryAt, hcolE, List.getElem?_eq_getElem (show m.i < colE.length by omega),
      hXi, List.getD_eq_getElem?_getD]
  -- entry `i` is closed in `X`, so `Hi = Xi`
  have hin' : (⟨M, m.j⟩ : EntryAddr).heightPath <+: cq.path := hin
  have hiclosed : ¬ (⟨M, m.i⟩ : EntryAddr).heightPath <+: cq.path := by
    intro h
    have h2 := List.prefix_of_prefix_length_le h hin' (by simp [EntryAddr.heightPath])
    have h3 := h2.eq_of_length (by simp [EntryAddr.heightPath])
    simp [EntryAddr.heightPath] at h3
    omega
  have hHi : Hi = Xi := by
    have := hsame _ (hXent m.i (by omega)) (hMne _) hiclosed
    simp only [Tree.entryAt, hcol, hcolE, Option.bind_some, hi] at this
    rw [List.getElem?_eq_getElem (show m.i < colE.length by omega)] at this
    simp only [Option.some.injEq] at this
    rw [hXi, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (show m.i < colE.length by omega)]
    simp [← this]
  -- entry `j` contains `cq`: `C` is the relative literal cap of `Xj`
  have hjc : (⟨M, m.j⟩ : EntryAddr).heightPath <+: cq.path := hin
  have hCX : C = Closure.litCapAux k p (cq.path.drop (⟨M, m.j⟩ : EntryAddr).heightPath.length) cc Xj := by
    have h1 := litCap_eq_setHeight_E1 hcqE hjc k p
    have hjE' : (⟨M, m.j⟩ : EntryAddr) ∈ E.entryAddrs := mem_entryAddrs_of_container_E1 hcqE hjc
    have h2 := (Tree.setHeight_basic _ _ (Closure.litCapAux k p
      (cq.path.drop (⟨M, m.j⟩ : EntryAddr).heightPath.length) cq.col
      ((E.heightAt ⟨M, m.j⟩).getD Tree.empty)) (Tree.truncAfter_spec E _ hjE').2.1).2.1
    rw [← h1, ← hX] at h2
    have h3 : X.heightAt ⟨M, m.j⟩ = some C := by simp [Tree.heightAt, Tree.entryAt, hcol, hjC]
    rw [h3, hEXj] at h2
    exact (Option.some.inj h2)
  -- the marked entry relative to `M`
  have hbq_of : bq.heightPath = (⟨M, m.j⟩ : EntryAddr).heightPath → bq = ⟨M, m.j⟩ := by
    intro hbeq
    have := List.append_inj' hbeq rfl
    obtain ⟨h1, h2⟩ := this
    simp only [List.cons.injEq, Prod.mk.injEq, and_true] at h2
    obtain ⟨⟨a, b⟩, i⟩ := bq
    simp only at h1 h2
    obtain ⟨rfl, rfl⟩ := h2
    subst h1
    rfl
  have hcaseA : bq = ⟨M, m.j⟩ →
      (E.heightAt bq).getD Tree.empty ≤ (E.heightAt (m.mapEntry m.fwdIdx bq)).getD Tree.empty := by
    intro hbq
    subst hbq
    have hme : m.mapEntry m.fwdIdx ⟨M, m.j⟩ = ⟨M, m.i⟩ := by
      unfold Closure.Move.mapEntry
      dsimp only
      rw [hMdef, mapPath_self_E1, if_pos rfl]
      simp [Closure.Move.fwdIdx]; omega
    rw [hme, hEXj, hEXi]
    simpa using hrun
  rcases List.prefix_or_prefix_of_prefix (List.prefix_append bq.heightPath ρ) hin with hb | hb
  · -- `bq` is `⟨M, j⟩` itself
    apply hcaseA
    apply hbq_of
    by_contra hne
    apply hout
    have hlen : bq.heightPath.length < (⟨M, m.j⟩ : EntryAddr).heightPath.length := by
      rcases Nat.lt_or_ge bq.heightPath.length (⟨M, m.j⟩ : EntryAddr).heightPath.length with h | h
      · exact h
      · exact absurd (hb.eq_of_length (le_antisymm hb.length_le h)) hne
    simp only [EntryAddr.heightPath] at hb hlen
    exact List.prefix_of_prefix_length_le hb (List.prefix_append _ _) (by
      simp only [EntryAddr.heightPath, List.length_append, List.length_singleton] at hlen ⊢
      omega)
  · -- `bq` lies inside `⟨M, j⟩`
    obtain ⟨σ, hσ⟩ := hb
    cases σ with
    | nil => exact hcaseA (hbq_of (by simpa using hσ.symm))
    | cons s0 σ0 =>
    set σ := s0 :: σ0 with hσdef
    set hm := (⟨M, m.j⟩ : EntryAddr).heightPath with hhm
    have hσne : σ ≠ [] := by simp [hσdef]
    have hσsplit : σ = σ.dropLast ++ [σ.getLast hσne] := (List.dropLast_append_getLast hσne).symm
    have hbsplit : bq.col.path ++ [(bq.col.col, bq.idx)] = (hm ++ σ.dropLast) ++ [σ.getLast hσne] := by
      rw [List.append_assoc, ← hσsplit]; exact hσ.symm
    obtain ⟨hbcol, hblast⟩ := List.append_inj' hbsplit rfl
    simp only [List.cons.injEq, and_true] at hblast
    set σ' := σ.dropLast
    set brel : EntryAddr := ⟨⟨σ', bq.col.col⟩, bq.idx⟩ with hbrel
    have hbrelH : brel.heightPath = σ := by
      simp only [hbrel, EntryAddr.heightPath, hblast]; exact hσsplit.symm
    have hbqeq : bq = ⟨⟨hm ++ σ', bq.col.col⟩, bq.idx⟩ := by
      obtain ⟨⟨a, b⟩, i⟩ := bq; simp only at hbcol ⊢; rw [hbcol]
    -- the old height at `bq` and at its moved address
    have hBq : E.heightAt bq = Xj.heightAt brel := by
      rw [hbqeq]; unfold Tree.heightAt
      rw [Tree.entryAt_under hEXj]
    have hme : m.mapEntry m.fwdIdx bq = ⟨⟨(⟨M, m.i⟩ : EntryAddr).heightPath ++ σ', bq.col.col⟩, bq.idx⟩ := by
      rw [hbqeq]
      unfold Closure.Move.mapEntry
      dsimp only
      have hp : hm ++ σ' = m.col.path ++ (m.col.col, m.j) :: σ' := by
        simp [hhm, EntryAddr.heightPath, hMdef]
      rw [hp, mapPath_through_E1]
      have hfj : m.fwdIdx m.j = m.i := by simp [Closure.Move.fwdIdx]; omega
      rw [hfj, if_neg]
      · simp [EntryAddr.heightPath, hMdef]
      · intro h
        have := congrArg (fun c : ColAddr => c.path.length) h
        simp at this
    have hBq1 : E.heightAt (m.mapEntry m.fwdIdx bq) = Xi.heightAt brel := by
      rw [hme]; unfold Tree.heightAt
      rw [Tree.entryAt_under hEXi]
    rw [hBq, hBq1]
    -- the relative cap column and the interval fact (U2 L3.1f)
    set crel : ColAddr := ⟨σ ++ ρ, cc⟩ with hcrel
    have hcq' : cq = ⟨hm ++ (σ ++ ρ), cc⟩ := by
      simp only [hcq, ← hσ, List.append_assoc]
    have hcolrel : E.colAt cq = Xj.colAt crel := by
      rw [hcq']; exact Tree.colAt_under hEXj (σ ++ ρ) cc
    have hupj : Closure.IsUpward Xj crel k p := isUpward_congr_E1 hcolrel hup
    have hcrelE : crel ∈ Xj.colAddrs := colAddrs_of_isUpward_E1 hupj
    have hCcap : C = Closure.litCap Xj crel k p := by
      rw [hCX]
      have hd : cq.path.drop hm.length = σ ++ ρ := by rw [hcq']; simp
      have hs : (Xj.colAt ⟨σ ++ ρ, cc⟩).isSome := (Tree.mem_colAddrs_iff _ _).mp hcrelE
      simp only [Closure.litCap, Closure.litCapBody, hd, hcrel]
      rw [if_pos hs]
    have hXY : Xj ≤ Xi := by simpa using hrun
    have hYC : Xi < Closure.litCap Xj crel k p := by rw [← hCcap, ← hHi]; exact hlt
    obtain ⟨hupi, hcapeq⟩ := Closure.interval_cap hupj hXY hYC
    have hcrelI : crel ∈ Xi.colAddrs := colAddrs_of_isUpward_E1 hupi
    have hbc : brel.heightPath <+: crel.path := by rw [hbrelH]; exact List.prefix_append _ _
    have hT := common_of_litCap_E1 hcrelE hcrelI hbc hcapeq.symm
    exact height_le_of_common_E1 hXY (mem_entryAddrs_of_container_E1 hcrelE hbc)
      (mem_entryAddrs_of_container_E1 hcrelI hbc) hT

/-! ### L4.3c helpers (F1) -/

/-- L4.3c helper: the literal cap recursion on trees of any label type. -/
def capT_F1 {α : Type} (k : Nat) (l : α) : List (Nat × Nat) → Nat → Tree α → Tree α
  | [], j, .node cols => .node (cols.take j ++ [(cols.getD j []).take k ++ [(l, Tree.empty)]])
  | (ci, ei) :: rest, j, .node cols =>
    match (cols.getD ci [])[ei]? with
    | some (q, h) => .node (cols.take ci ++ [(cols.getD ci []).take ei ++ [(q, capT_F1 k l rest j h)]])
    | none => .node cols

theorem litCapAux_eq_capT_F1 (k p : Nat) :
    ∀ (ρ : List (Nat × Nat)) (j : Nat) (X : Forest), Closure.litCapAux k p ρ j X = capT_F1 k p ρ j X
  | [], j, .node cols => rfl
  | (ci, ei) :: rest, j, .node cols => by
    simp only [Closure.litCapAux, capT_F1]
    cases (cols.getD ci [])[ei]? with
    | none => rfl
    | some x => obtain ⟨q, h⟩ := x; simp only [litCapAux_eq_capT_F1 k p rest j h]

theorem capT_map_F1 {α β : Type} (f : α → β) (k : Nat) (l : α) :
    ∀ (ρ : List (Nat × Nat)) (j : Nat) (X : Tree α),
      Tree.map f (capT_F1 k l ρ j X) = capT_F1 k (f l) ρ j (Tree.map f X)
  | [], j, .node cols => by
    simp only [capT_F1, Tree.map, Scan.treeMapCols_eq_map, Scan.treeMapCol_eq_map, List.map_append,
      List.map_take, List.map_cons, List.map_nil, List.getD_eq_getElem?_getD, List.getElem?_map]
    cases cols[j]? <;> simp [Tree.empty, Tree.map, Tree.mapCols, Scan.treeMapCol_eq_map]
  | (ci, ei) :: rest, j, .node cols => by
    simp only [capT_F1, Tree.map, Scan.treeMapCols_eq_map, List.getD_eq_getElem?_getD,
      List.getElem?_map]
    cases hc : cols[ci]? with
    | none =>
      simp only [Option.map_none, Option.getD_none, List.getElem?_nil]
      simp [Tree.map, Scan.treeMapCols_eq_map]
    | some col =>
      simp only [Option.map_some, Option.getD_some, Scan.treeMapCol_eq_map, List.getElem?_map]
      cases he : col[ei]? with
      | none => simp [Tree.map, Scan.treeMapCols_eq_map]
      | some x =>
        obtain ⟨q, h⟩ := x
        simp only [Option.map_some, Tree.map, Scan.treeMapCols_eq_map, List.map_append,
          List.map_take, List.map_cons, List.map_nil, Scan.treeMapCol_eq_map,
          capT_map_F1 f k l rest j h]


theorem capT_cut_F1 {α : Type} (k : Nat) (l : α) :
    ∀ (ρ : List (Nat × Nat)) (j : Nat) (X Y : Tree α),
      (X.colAt ⟨ρ, j⟩).isSome → (Y.colAt ⟨ρ, j⟩).isSome →
      cutBefore ρ j (some k) X = cutBefore ρ j (some k) Y →
      capT_F1 k l ρ j X = capT_F1 k l ρ j Y
  | [], j, .node xs, .node ys, hx, hy, hcut => by
    have hjx : j < xs.length := by simpa [Tree.colAt, Tree.forestAt, Tree.cols] using hx
    have hjy : j < ys.length := by simpa [Tree.colAt, Tree.forestAt, Tree.cols] using hy
    simp only [cutBefore, Tree.node.injEq] at hcut
    obtain ⟨h1, h2⟩ := List.append_inj hcut (by simp; omega)
    simp only [List.cons.injEq, and_true] at h2
    simp only [capT_F1, List.getD_eq_getElem?_getD, h1, h2]
  | (ci, ii) :: rest, j, .node xs, .node ys, hx, hy, hcut => by
    rw [Tree.colAt_cons] at hx hy
    simp only [Tree.cols] at hx hy
    cases hxc : xs[ci]? with
    | none => rw [hxc] at hx; simp at hx
    | some colx =>
      cases hyc : ys[ci]? with
      | none => rw [hyc] at hy; simp at hy
      | some coly =>
        rw [hxc, Option.bind_some] at hx
        rw [hyc, Option.bind_some] at hy
        cases hxe : colx[ii]? with
        | none => rw [hxe] at hx; simp at hx
        | some ex =>
          cases hye : coly[ii]? with
          | none => rw [hye] at hy; simp at hy
          | some ey =>
            obtain ⟨lx, hX⟩ := ex
            obtain ⟨ly, hY⟩ := ey
            rw [hxe, Option.bind_some] at hx
            rw [hye, Option.bind_some] at hy
            simp only [cutBefore, hxc, hyc, hxe, hye, Tree.node.injEq] at hcut
            have hcx : ci < xs.length := (List.getElem?_eq_some_iff.1 hxc).1
            have hcy : ci < ys.length := (List.getElem?_eq_some_iff.1 hyc).1
            have hex : ii < colx.length := (List.getElem?_eq_some_iff.1 hxe).1
            have hey : ii < coly.length := (List.getElem?_eq_some_iff.1 hye).1
            obtain ⟨h1, h2⟩ := List.append_inj hcut (by simp; omega)
            simp only [List.cons.injEq, and_true] at h2
            obtain ⟨h3, h4⟩ := List.append_inj h2 (by simp; omega)
            simp only [List.cons.injEq, and_true, Prod.mk.injEq] at h4
            obtain ⟨rfl, h5⟩ := h4
            simp only [capT_F1, List.getD_eq_getElem?_getD, hxc, hyc, Option.getD_some, hxe, hye,
              h1, h3, capT_cut_F1 k l rest j hX hY hx hy h5]


/-- L4.3c helper: H holds inside every height of an H-forest. -/
theorem condH_sub_F1 {T H : Forest} {e : EntryAddr} (hT : Scan.CondH T) (hH : T.heightAt e = some H) :
    Scan.CondH H := by
  intro c hc i x y hx hy
  have hcol := Tree.colAt_under hH c.path c.col
  have hc' : (⟨e.heightPath ++ c.path, c.col⟩ : ColAddr) ∈ T.colAddrs := by
    rw [Tree.mem_colAddrs_iff, hcol]; exact (Tree.mem_colAddrs_iff _ _).1 hc
  refine hT _ hc' i x y ?_ ?_
  · rw [hcol]; exact hx
  · rw [hcol]; exact hy

/-- L4.3c helper: label order through `relLabel`. -/
theorem relLabel_lt_iff_F1 {t r a b a' b' : Nat} (ha : relLabel t a = relLabel r a')
    (hb : relLabel t b = relLabel r b') : a < b ↔ a' < b' := by
  have h1 := keyLabelCmp_relLabel t a b
  have h2 := keyLabelCmp_relLabel r a' b'
  rw [ha, hb, h2] at h1
  rw [← Nat.compare_eq_lt, ← Nat.compare_eq_lt, h1]

theorem relLabel_eq_iff_F1 {t r a b a' b' : Nat} (ha : relLabel t a = relLabel r a')
    (hb : relLabel t b = relLabel r b') : a = b ↔ a' = b' := by
  have h1 := keyLabelCmp_relLabel t a b
  have h2 := keyLabelCmp_relLabel r a' b'
  rw [ha, hb, h2] at h1
  rw [← Nat.compare_eq_eq, ← Nat.compare_eq_eq, h1]

theorem relKey_le_iff_F1 {t r : Nat} {X Y X' Y' : Forest} (hX : relKey t X = relKey r X')
    (hY : relKey t Y = relKey r Y') : X ≤ Y ↔ X' ≤ Y' := by
  rw [← not_lt, ← not_lt, ← relKey_lt_iff t, ← relKey_lt_iff r, hX, hY]

/-- L4.3c helper: H transfers along equal relative keys. -/
theorem condH_relKey_F1 {t r : Nat} {X Y : Forest} (hXY : relKey t X = relKey r Y)
    (hY : Scan.CondH Y) : Scan.CondH X := by
  intro c hc i x y hx hy
  have hcX := congrArg (fun T => T.colAt c) hXY
  simp only [relKey_eq_map, colAt_map_D8] at hcX
  obtain ⟨colX, hcolX⟩ : ∃ col, X.colAt c = some col := by
    have := (Tree.mem_colAddrs_iff _ _).1 hc
    exact Option.isSome_iff_exists.1 this
  rw [hcolX] at hcX hx hy
  simp only [Option.getD_some] at hx hy
  obtain ⟨colY, hcolY, hmap⟩ : ∃ colY, Y.colAt c = some colY ∧
      Tree.mapCol (relLabel r) colY = Tree.mapCol (relLabel t) colX := by
    cases hcy : Y.colAt c with
    | none => rw [hcy] at hcX; simp at hcX
    | some colY => rw [hcy] at hcX; exact ⟨colY, rfl, (Option.some.inj hcX).symm⟩
  rw [Scan.treeMapCol_eq_map, Scan.treeMapCol_eq_map] at hmap
  have hcY : c ∈ Y.colAddrs := by rw [Tree.mem_colAddrs_iff, hcolY]; rfl
  have hget : ∀ (n : Nat) (z : Nat × Forest), colX[n]? = some z → ∃ z' : Nat × Forest, colY[n]? = some z' ∧
      relLabel t z.1 = relLabel r z'.1 ∧ relKey t z.2 = relKey r z'.2 := by
    intro n z hz
    have := congrArg (·[n]?) hmap
    simp only [List.getElem?_map, hz, Option.map_some] at this
    cases hz' : colY[n]? with
    | none => rw [hz'] at this; simp at this
    | some z' =>
      rw [hz'] at this
      simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq] at this
      exact ⟨z', rfl, this.1.symm, this.2.symm⟩
  obtain ⟨x', hx', hx1, hx2⟩ := hget i x hx
  obtain ⟨y', hy', hy1, hy2⟩ := hget (i + 1) y hy
  have hle := hY c hcY i x' y' (by rw [hcolY]; exact hx') (by rw [hcolY]; exact hy')
  unfold Scan.EntryLe at hle ⊢
  rw [relLabel_lt_iff_F1 hy1 hx1, relLabel_eq_iff_F1 hy1 hx1, relKey_le_iff_F1 hy2 hx2]
  exact hle


/-- L4.3c helper: a word atom squeezed between two consecutive cap atoms is the smaller one. -/
theorem capAtom_squeeze_F1 (c : ColAddr) (k p : Nat) (y : Scan.WordAtom)
    (h1 : Closure.capAtom c k p ≤ y) (h2 : y < Closure.capAtom c k (p + 1)) :
    y = Closure.capAtom c k p := by
  have e : y = toLex ((ofLex y).1, toLex ((ofLex (ofLex y).2).1, (ofLex (ofLex y).2).2)) := rfl
  generalize (ofLex y).1 = a at e
  generalize (ofLex (ofLex y).2).1 = b at e
  generalize (ofLex (ofLex y).2).2 = d at e
  subst e
  unfold Closure.capAtom at h1 h2 ⊢
  split_ifs at h1 h2 ⊢ <;>
  · simp only [Prod.Lex.toLex_le_toLex, Prod.Lex.toLex_lt_toLex] at h1 h2
    simp only [EmbeddingLike.apply_eq_iff_eq, Prod.mk.injEq]
    omega

/-- L4.3c helper: cutting a column before an existing entry and appending that entry's parent
with an empty height is a safe prefix. -/
theorem litCap_safePrefix_F1 {F : Forest} {c : ColAddr} {col : Column} {k p : Nat} {hs : Forest}
    (hcol : F.colAt c = some col) (hk : col[k]? = some (p, hs)) :
    ∃ n, Closure.litCap F c k p = Scan.safePrefix F n := by
  have hc : c ∈ F.colAddrs := by rw [Tree.mem_colAddrs_iff, hcol]; rfl
  have hkl : k < col.length := (List.getElem?_eq_some_iff.1 hk).1
  have hk' : k ≤ ((F.colAt c).getD []).length := by rw [hcol]; simp; omega
  have hup1 : Closure.IsUpward F c k (p + 1) := by
    unfold Closure.IsUpward; rw [hcol]; simp [hk]
  have hnup : ¬ Closure.IsUpward F c k p := by
    unfold Closure.IsUpward; rw [hcol]; simp [hk]
  rw [Closure.isUpward_iff_atom hc hk'] at hup1 hnup
  push Not at hnup
  obtain ⟨y, hy, hge⟩ := hnup
  have hy' := capAtom_squeeze_F1 c k p y hge (hup1 y hy)
  refine ⟨Closure.capPos F c k + 1, Scan.word_injective ?_⟩
  rw [Closure.word_litCap hc hk' p, Scan.word_safePrefix, List.take_add_one, hy, ← hy']
  rfl

/-- L4.3c helper: the route from a forest only reads the column indices of its address prefix
(the entry indices are relabelled). -/
theorem stopF_reloc_F1 : ∀ (n : Nat) (F : Forest), sizeOf F = n → ∀ (π π' : List (Nat × Nat))
    (sd : Scan.StopData), Scan.stopF π F = some sd → π.map Prod.fst = π'.map Prod.fst →
    ∃ R, sd.col.path = π ++ R ∧
      Scan.stopF π' F = some { sd with col := ⟨π' ++ R, sd.col.col⟩ } := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro F hn π π' sd hs hπ
  have hlen : π.length = π'.length := by
    have := congrArg List.length hπ; simpa using this
  rw [Scan.stopF_eq] at hs ⊢
  rcases hc : F.cols.getLast? with _ | col
  · simp [hc] at hs
  rcases he : col.getLast? with _ | ⟨p, h⟩
  · simp [hc, he] at hs
  simp only [hc, he] at hs ⊢
  by_cases hh : h.cols.isEmpty
  · simp only [hh, if_true, Option.some.injEq] at hs ⊢
    subst hs
    refine ⟨[], by simp, ?_⟩
    simp only [List.append_nil]
    congr 1
    · exact hlen.symm
    · have : π.map (·.1 + 1) = π'.map (·.1 + 1) := by
        have := congrArg (List.map (· + 1)) hπ
        simp only [List.map_map] at this
        exact this
      simp only [ColAddr.num, this]
  · simp only [hh, Bool.false_eq_true, if_false] at hs ⊢
    have hlt : sizeOf h < n := hn ▸ Scan.sizeOf_lt_of_last hc he
    obtain ⟨R, hR, hs'⟩ := ih (sizeOf h) hlt h rfl _ (π' ++ [(F.cols.length - 1, col.length - 1)])
      sd hs (by simp [hπ])
    exact ⟨(F.cols.length - 1, col.length - 1) :: R, by rw [hR]; simp, by simpa using hs'⟩


theorem modifyColAux_cols_length_F1 (f : Column → Column) :
    ∀ (P : List (Nat × Nat)) (cc : Nat) (G : Forest),
      (Closure.modifyColAux f P cc G).cols.length = G.cols.length
  | [], cc, .node cols => by simp [Closure.modifyColAux, Tree.cols]
  | (c₀, e₀) :: P, cc, .node cols => by simp [Closure.modifyColAux, Tree.cols]

theorem getLast?_modify_last_F1 {β : Type} (l : List β) (g : β → β) (x : β)
    (h : l.getLast? = some x) : (l.modify (l.length - 1) g).getLast? = some (g x) := by
  rw [List.getLast?_eq_getElem?, List.length_modify, List.getElem?_modify,
    ← List.getLast?_eq_getElem?, h]
  simp

/-- L4.3c helper: modifying a route column whose last entry is kept relocates the stop. -/
theorem stopF_modifyColAux_F1 (f : Column → Column) :
    ∀ (P : List (Nat × Nat)) (cc : Nat) (G : Forest) (π : List (Nat × Nat)) (sd : Scan.StopData)
      (j : Nat) (R : List (Nat × Nat)) (col : Column),
    Scan.stopF π G = some sd → sd.col.path = π ++ P ++ (cc, j) :: R → G.colAt ⟨P, cc⟩ = some col →
    j + 1 = col.length → (f col).getLast? = col.getLast? →
    Scan.stopF π (Closure.modifyColAux f P cc G) =
      some { sd with col := ⟨π ++ P ++ (cc, (f col).length - 1) :: R, sd.col.col⟩ }
  | [], cc, .node cols, π, sd, j, R, col, hs, hp, hcol, hj, hf => by
    rw [Scan.stopF_eq, show (Tree.node cols).cols = cols from rfl] at hs
    rcases hc : cols.getLast? with _ | colL
    · simp [hc] at hs
    rcases he : colL.getLast? with _ | ⟨q, h⟩
    · simp [hc, he] at hs
    simp only [hc, he] at hs
    by_cases hh : h.cols.isEmpty
    · simp only [hh, if_true, Option.some.injEq] at hs
      subst hs
      have := congrArg List.length hp
      simp at this
    simp only [hh, Bool.false_eq_true, if_false] at hs
    obtain ⟨R', hR', hs'⟩ := stopF_reloc_F1 _ h rfl _ (π ++ [(cols.length - 1, (f col).length - 1)])
      sd hs (by simp)
    rw [hp] at hR'
    simp only [List.append_nil, List.append_assoc, List.singleton_append, List.append_cancel_left_eq,
      List.cons.injEq, Prod.mk.injEq] at hR'
    obtain ⟨⟨hcc, hjj⟩, rfl⟩ := hR'
    have hcolL : col = colL := by
      have h1 : cols[cc]? = some col := by simpa [Tree.colAt, Tree.forestAt, Tree.cols] using hcol
      rw [List.getLast?_eq_getElem?, ← hcc, h1] at hc
      exact Option.some.inj hc
    subst hcolL
    rw [show Closure.modifyColAux f [] cc (Tree.node cols) = Tree.node (cols.modify cc f) from rfl,
      Scan.stopF_eq, show (Tree.node (cols.modify cc f)).cols = cols.modify cc f from rfl, hcc,
      getLast?_modify_last_F1 _ _ _ hc]
    dsimp only
    rw [hf, he]
    dsimp only
    rw [if_neg hh, List.length_modify, hs']
    simp
  | (c₀, e₀) :: P, cc, .node cols, π, sd, j, R, col, hs, hp, hcol, hj, hf => by
    rw [Scan.stopF_eq, show (Tree.node cols).cols = cols from rfl] at hs
    rcases hc : cols.getLast? with _ | colL
    · simp [hc] at hs
    rcases he : colL.getLast? with _ | ⟨q, h⟩
    · simp [hc, he] at hs
    simp only [hc, he] at hs
    by_cases hh : h.cols.isEmpty
    · simp only [hh, if_true, Option.some.injEq] at hs
      subst hs
      have := congrArg List.length hp
      simp at this
    simp only [hh, Bool.false_eq_true, if_false] at hs
    obtain ⟨R', hR', -⟩ := stopF_reloc_F1 _ h rfl _ (π ++ [(cols.length - 1, colL.length - 1)])
      sd hs rfl
    rw [hp] at hR'
    simp only [List.append_assoc, List.cons_append,
      List.append_cancel_left_eq, List.cons.injEq, Prod.mk.injEq] at hR'
    obtain ⟨⟨hc0, he0⟩, -⟩ := hR'
    subst hc0 he0
    have hcL : cols[cols.length - 1]? = some colL := by rw [← List.getLast?_eq_getElem?]; exact hc
    have heL : colL[colL.length - 1]? = some (q, h) := by rw [← List.getLast?_eq_getElem?]; exact he
    have hcolh : h.colAt ⟨P, cc⟩ = some col := by
      rw [Tree.colAt_cons] at hcol
      simpa [Tree.cols, hcL, heL] using hcol
    have hp' : sd.col.path = (π ++ [(cols.length - 1, colL.length - 1)]) ++ P ++ (cc, j) :: R := by
      rw [hp]; simp
    have ih := stopF_modifyColAux_F1 f P cc h _ sd j R col hs hp' hcolh hj hf
    have hne : ¬ (Closure.modifyColAux f P cc h).cols.isEmpty := by
      rw [List.isEmpty_iff, ← List.length_eq_zero_iff, modifyColAux_cols_length_F1,
        List.length_eq_zero_iff, ← List.isEmpty_iff]
      exact hh
    rw [show Closure.modifyColAux f ((cols.length - 1, colL.length - 1) :: P) cc (Tree.node cols) =
      Tree.node (cols.modify (cols.length - 1) fun col => col.modify (colL.length - 1)
        fun x => (x.1, Closure.modifyColAux f P cc x.2)) from rfl,
      Scan.stopF_eq, show ∀ cs : List Column, (Tree.node cs).cols = cs from fun _ => rfl,
      getLast?_modify_last_F1 _ _ _ hc]
    dsimp only
    rw [getLast?_modify_last_F1 _ _ _ he]
    dsimp only
    rw [if_neg hne, List.length_modify, List.length_modify, ih]
    simp


/-- L4.3c helper: a legal move relocates the stopping column through the moved entry. -/
theorem stopData_applyMove_F1 {X : Forest} {m : Closure.Move} {col : Column} {sd : Scan.StopData}
    (hcol : X.colAt m.col = some col) (hsd : Scan.stopData X = some sd) (hj : m.j + 1 = col.length)
    (hij : m.i < m.j) (hin : (⟨m.col, m.j⟩ : EntryAddr).heightPath <+: sd.col.path) :
    ∃ sd', Scan.stopData (Closure.applyMove X m) = some sd' ∧
      sd'.col = ⟨m.mapPath m.fwdIdx sd.col.path, sd.col.col⟩ := by
  obtain ⟨R, hR⟩ := hin
  have hp : sd.col.path = [] ++ m.col.path ++ (m.col.col, m.j) :: R := by
    rw [← hR]; simp [EntryAddr.heightPath]
  have hA : Closure.applyMove X m = Closure.modifyColAux (fun col => col.take m.i ++ col.drop m.j)
      m.col.path m.col.col X := by
    show Closure.applyMoveBody X m = _
    unfold Closure.applyMoveBody
    rw [hcol]
    simp only
    rw [if_pos ⟨hij, by omega⟩]
    rfl
  have hdrop : col.drop m.j = [col[m.j]'(by omega)] := by
    rw [List.drop_eq_getElem_cons (by omega), List.drop_eq_nil_of_le (by omega)]
  have hf : (col.take m.i ++ col.drop m.j).getLast? = col.getLast? := by
    rw [hdrop, List.getLast?_append, List.getLast?_singleton]
    simp only [Option.some_or]
    rw [List.getLast?_eq_getElem?, show col.length - 1 = m.j by omega,
      List.getElem?_eq_getElem (by omega)]
  have hlen : (col.take m.i ++ col.drop m.j).length - 1 = m.i := by
    rw [hdrop]; simp; omega
  have := stopF_modifyColAux_F1 (fun col => col.take m.i ++ col.drop m.j) m.col.path m.col.col X []
    sd m.j R col hsd hp hcol hj hf
  rw [hlen] at this
  refine ⟨_, by rw [hA]; exact this, ?_⟩
  have hfw : m.fwdIdx m.j = m.i := by simp [Closure.Move.fwdIdx]; omega
  have hpp : sd.col.path = m.col.path ++ (m.col.col, m.j) :: R := by simpa using hp
  simp only [hpp, mapPath_through_E1, hfw, List.nil_append]

/-- L4.3c helper: a move outside the marked height keeps the marked entry on the route. -/
theorem mapEntry_route_F1 (g : Nat → Nat) (m : Closure.Move) (b : EntryAddr)
    (π : List (Nat × Nat)) (hb : b.heightPath <+: π)
    (hm : (⟨m.col, m.j⟩ : EntryAddr).heightPath <+: π) (hout : ¬ b.heightPath <+: m.col.path) :
    (m.mapEntry g b).heightPath <+: m.mapPath g π ∧
      (b = ⟨m.col, m.j⟩ ∨ (⟨m.col, m.j⟩ : EntryAddr).heightPath <+: b.col.path) := by
  have hbq_of : b.heightPath = (⟨m.col, m.j⟩ : EntryAddr).heightPath → b = ⟨m.col, m.j⟩ := by
    intro hbeq
    obtain ⟨h1, h2⟩ := List.append_inj' hbeq rfl
    simp only [List.cons.injEq, Prod.mk.injEq, and_true] at h2
    obtain ⟨⟨a, b⟩, i⟩ := b
    simp only at h1 h2
    obtain ⟨rfl, rfl⟩ := h2
    subst h1
    rfl
  have hcaseA : b = ⟨m.col, m.j⟩ → (m.mapEntry g b).heightPath <+: m.mapPath g π := by
    intro hbq
    subst hbq
    have hme : m.mapEntry g ⟨m.col, m.j⟩ = ⟨m.col, g m.j⟩ := by
      unfold Closure.Move.mapEntry
      dsimp only
      rw [mapPath_self_E1, if_pos rfl]
    rw [hme]
    obtain ⟨τ, hτ⟩ := hm
    rw [← hτ]
    simp only [EntryAddr.heightPath, List.append_assoc, List.singleton_append, mapPath_through_E1]
    exact ⟨τ, by simp⟩
  rcases List.prefix_or_prefix_of_prefix hb hm with h1 | h1
  · -- `b` is the moved entry itself
    simp only [EntryAddr.heightPath] at h1
    rcases List.prefix_concat_iff.1 h1 with h2 | h2
    · have hb' := hbq_of h2
      exact ⟨hcaseA hb', Or.inl hb'⟩
    · exact absurd h2 hout
  · rcases List.prefix_concat_iff.1 (show (⟨m.col, m.j⟩ : EntryAddr).heightPath <+:
        b.col.path ++ [(b.col.col, b.idx)] from h1) with h2 | h2
    · have hb' := hbq_of h2.symm
      exact ⟨hcaseA hb', Or.inl hb'⟩
    · refine ⟨?_, Or.inr h2⟩
      obtain ⟨σ, hσ⟩ := h2
      obtain ⟨τ, hτ⟩ := hb
      have hbc : b.col.path = m.col.path ++ (m.col.col, m.j) :: σ := by
        rw [← hσ]; simp [EntryAddr.heightPath]
      have hme : m.mapEntry g b = ⟨⟨m.col.path ++ (m.col.col, g m.j) :: σ, b.col.col⟩, b.idx⟩ := by
        unfold Closure.Move.mapEntry
        dsimp only
        rw [hbc, mapPath_through_E1, if_neg]
        intro h
        have := congrArg (fun c : ColAddr => c.path.length) h
        simp at this
      rw [hme, ← hτ]
      simp only [EntryAddr.heightPath, hbc, List.append_assoc, List.cons_append,
        mapPath_through_E1]
      simp


/-- L4.3c helper: `relLabel` at the target host of σ of a source parent is its source label. -/
theorem relLabel_sigma_F1 {r t : Nat} (hrt : r ≤ t) (q : Nat) :
    relLabel t (sigmaNum_D8 r t q) = relLabel r q := by
  unfold relLabel sigmaNum_D8
  by_cases hq : q < r
  · simp [hq, show q < t by omega]
  · simp only [hq, if_false, show ¬ q + (t - r) < t by omega]
    congr 1; omega

/-- L4.3c (step 3–5): the internal cap of a first-difference cap satisfies H: its relative key is
that of the reindexed safe source prefix. -/
theorem internal_cap_condH_F1 {rk : SrcRecord} (h : rk.Admitted) {c : ColAddr} {k p : Nat}
    (hfd : rk.firstDiff = .capAt c k p) :
    ∃ BK, (Closure.litCap rk.E c k p).heightAt rk.b = some BK ∧ Scan.CondH BK := by
  obtain ⟨ρ, colB, colA, hρ, hsrc, hcolB, hcolA, -, hkB, ⟨q', H', hAk, hp⟩, -, -⟩ :=
    capSetup_D8 h hfd
  obtain ⟨-, -, hcap⟩ := firstDiff_spec h
  obtain ⟨ρ', hρ', hcut, htcol, -⟩ := hcap c k p hfd
  obtain rfl : ρ = ρ' := by rw [hρ] at hρ'; exact List.append_cancel_left hρ'
  set t := rk.b.col.num 0 with ht
  set r := rk.a.col.num 0 with hr
  have hrt : r ≤ t := (admitted_hosts h).1
  have hb : rk.E.heightAt rk.b = some rk.tgtHeight := by
    have hb := h.2.1
    rw [Tree.mem_entryAddrs_iff, Option.isSome_iff_exists] at hb
    obtain ⟨x, hx⟩ := hb
    simp [SrcRecord.tgtHeight, Tree.heightAt, hx]
  have ha : rk.F.heightAt rk.a = some rk.srcHeight := by
    have ha := h.2.2.1
    rw [Tree.mem_entryAddrs_iff, Option.isSome_iff_exists] at ha
    obtain ⟨x, hx⟩ := ha
    simp [SrcRecord.srcHeight, Tree.heightAt, hx]
  obtain ⟨hbc, hcE⟩ := capAt_col_D8 h hfd
  -- the internal cap
  have hKe := litCap_eq_setHeight_E1 hcE hbc k p
  have hdrop : c.path.drop rk.b.heightPath.length = ρ := by rw [hρ]; simp
  rw [hdrop, hb, Option.getD_some] at hKe
  have hbT : rk.b ∈ (rk.E.truncAfter rk.b).entryAddrs := (Tree.truncAfter_spec _ _ h.2.1).2.1
  refine ⟨Closure.litCapAux k p ρ c.col rk.tgtHeight, ?_, ?_⟩
  · rw [hKe]; exact (Tree.setHeight_basic _ _ _ hbT).2.1
  -- the reindexed safe source prefix
  set c'' := srcCol_D8 rk c with hc''
  have hc''F : c'' ∈ rk.F.colAddrs := by rw [Tree.mem_colAddrs_iff, hcolA]; rfl
  have hac : rk.a.heightPath <+: c''.path := by rw [hsrc]; exact List.prefix_append _ _
  obtain ⟨n, hn⟩ := litCap_safePrefix_F1 hcolA hAk
  have hSL : Scan.InL (Closure.litCap rk.F c'' k q') := by
    rw [hn]; exact Closure.inL_safePrefix h.2.2.2.1 n
  have hSe := litCap_eq_setHeight_E1 hc''F hac k q'
  have hdrop' : c''.path.drop rk.a.heightPath.length = ρ := by rw [hsrc]; simp
  have hcc : c''.col = c.col := by rw [hsrc]
  rw [hdrop', hcc, ha, Option.getD_some] at hSe
  have haT : rk.a ∈ (rk.F.truncAfter rk.a).entryAddrs := (Tree.truncAfter_spec _ _ h.2.2.1).2.1
  have hSa : (Closure.litCap rk.F c'' k q').heightAt rk.a =
      some (Closure.litCapAux k q' ρ c.col rk.srcHeight) := by
    rw [hSe]; exact (Tree.setHeight_basic _ _ _ haT).2.1
  have hSH : Scan.CondH (Closure.litCapAux k q' ρ c.col rk.srcHeight) :=
    condH_sub_F1 hSL.2.2.1 hSa
  refine condH_relKey_F1 (t := t) (r := r) ?_ hSH
  rw [relKey_eq_map, relKey_eq_map, litCapAux_eq_capT_F1, litCapAux_eq_capT_F1, capT_map_F1,
    capT_map_F1, ← relKey_eq_map, ← relKey_eq_map]
  have hlab : relLabel t p = relLabel r q' := by
    rw [hp, labelAbs_relLabel_D8 hrt, relLabel_sigma_F1 hrt]
  rw [hlab]
  have hsk : (rk.srcKey.colAt ⟨ρ, c.col⟩).isSome := by
    rw [SrcRecord.srcKey, relKey_eq_map, colAt_map_D8, ← colAt_heightPath_D8 ha, ← hsrc, hcolA]
    rfl
  exact capT_cut_F1 k _ ρ c.col _ _ htcol hsk hcut

-- provides: U3, L4.3c (the internal cap already satisfies H, so repairs are outside `B`)
-- Moved down from after `setHeight_lt_iff_E1` (brief rule 5; unchanged statement): the proof
-- uses the L4.3b helpers `mapPath_through_E1`, `mapPath_self_E1`, `condH_run_E1`.
theorem repair_moves_outside {rk : SrcRecord} (h : rk.Admitted) {c : ColAddr} {k p : Nat}
    (hfd : rk.firstDiff = .capAt c k p) (w : Closure.AdmCap rk.E)
    (hw : w.col = c ∧ w.cut = k ∧ w.par = p) : Closure.MovesOutside w.moves rk.b := by
  obtain ⟨BK, hKb, hBKH⟩ := internal_cap_condH_F1 h hfd
  obtain ⟨hbc, -, hup, -⟩ := firstDiff_cap h hfd
  obtain ⟨hwc, hwk, hwp⟩ := hw
  subst hwc hwk hwp
  set K := Closure.litCap rk.E w.col w.cut w.par with hK
  have hvalid : ∀ q (hq : q < w.moves.length),
      Closure.MoveOK (Closure.applyMoves K (w.moves.take q)) w.moves[q] := w.movesValid
  have hX : ∀ q (hq : q < w.moves.length), Closure.applyMoves K (w.moves.take (q + 1)) =
      Closure.applyMove (Closure.applyMoves K (w.moves.take q)) w.moves[q] := by
    intro q hq
    rw [List.take_add_one, List.getElem?_eq_getElem hq]
    simp only [Closure.applyMoves, List.foldl_append, Option.toList_some, List.foldl_cons,
      List.foldl_nil]
  have hB : ∀ q (hq : q < w.moves.length), Closure.moveAddr (w.moves.take (q + 1)) rk.b =
      w.moves[q].mapEntry w.moves[q].fwdIdx (Closure.moveAddr (w.moves.take q) rk.b) := by
    intro q hq
    rw [List.take_add_one, List.getElem?_eq_getElem hq]
    simp only [Closure.moveAddr, Closure.moveAddrBody, Option.toList_some, List.foldl_append,
      List.foldl_cons, List.foldl_nil]
  intro n0 hn0
  by_contra hbad0
  classical
  have hex : ∃ n, ∃ hn : n < w.moves.length,
      (Closure.moveAddr (w.moves.take n) rk.b).heightPath <+: (w.moves[n]).col.path :=
    ⟨n0, hn0, hbad0⟩
  obtain ⟨hn, hnbad⟩ := Nat.find_spec hex
  set n := Nat.find hex with hndef
  have hmin : ∀ q (hq : q < n), ¬ (Closure.moveAddr (w.moves.take q) rk.b).heightPath <+:
      (w.moves[q]'(by omega)).col.path := by
    intro q hq hc; exact Nat.find_min hex hq ⟨_, hc⟩
  -- the stopping column stays inside the marked height before the first bad move
  have inv : ∀ q, q ≤ n → ∃ sd, Scan.stopData (Closure.applyMoves K (w.moves.take q)) = some sd ∧
      (Closure.moveAddr (w.moves.take q) rk.b).heightPath <+: sd.col.path := by
    intro q
    induction q with
    | zero =>
      intro _
      refine ⟨_, Closure.stopData_litCap hup, ?_⟩
      simpa [Closure.moveAddr, Closure.moveAddrBody] using hbc
    | succ q ih =>
      intro hq
      obtain ⟨sd, hsd, hbsd⟩ := ih (by omega)
      obtain ⟨col, sd', hcol, hsd', hj, hij, hin, -, -, -⟩ := hvalid q (by omega)
      rw [hsd] at hsd'; obtain rfl := Option.some.inj hsd'
      obtain ⟨sd'', hsd'', hcol''⟩ := stopData_applyMove_F1 hcol hsd hj hij hin
      refine ⟨sd'', by rw [hX q (by omega)]; exact hsd'', ?_⟩
      rw [hB q (by omega), hcol'']
      exact (mapEntry_route_F1 _ _ _ _ hbsd hin (hmin q (by omega))).1
  -- the earlier moves form a repair list for `b`
  have hstep : ∀ q (hq : q < n), Closure.RepairStepOK (Closure.applyMoves K (w.moves.take q))
      (Closure.moveAddr (w.moves.take q) rk.b) (w.moves[q]'(by omega)) := by
    intro q hq
    obtain ⟨sd, hsd, hbsd⟩ := inv q hq.le
    obtain ⟨col, sd', hcol, hsd', hj, hij, hin, hpar, -, -⟩ := hvalid q (by omega)
    rw [hsd] at hsd'; obtain rfl := Option.some.inj hsd'
    have hr := (mapEntry_route_F1 (w.moves[q]'(by omega)).fwdIdx _ _ _ hbsd hin (hmin q hq)).2
    refine ⟨col, hcol, hij, by omega, ?_, hpar, ?_⟩
    · rcases hr with hr | hr
      · left; rw [hr]
      · right; exact ⟨_, hr⟩
    · rcases hr with hr | hr
      · left; exact hr.symm
      · right; exact hr
  have hRL : Closure.RepairList K rk.b (w.moves.take n) := by
    show Closure.RepairListBody K rk.b (w.moves.take n)
    intro q hq
    have hqn : q < n := by simp at hq; omega
    rw [List.take_take, Nat.min_eq_left hqn.le, List.getElem_take]
    exact hstep q hqn
  have hheight := Closure.repairList_height hRL
  rw [hKb] at hheight
  -- the first bad move contradicts H inside the marked height
  obtain ⟨col, sd, hcol, hsd, hj, hij, hin, hpar, hlt, -⟩ := hvalid n hn
  obtain ⟨σ, hσ⟩ := hnbad
  have hcolB : BK.colAt ⟨σ, (w.moves[n]).col.col⟩ = some col := by
    rw [← Tree.colAt_under hheight σ, hσ]; exact hcol
  have hpar' : ∀ x, (w.moves[n]).i ≤ x → x ≤ (w.moves[n]).j →
      (col[x]?).map Prod.fst = some (col.getD (w.moves[n]).j (0, Tree.empty)).1 := by
    intro x h1 h2
    rw [← hpar x h1 h2, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (by omega)]
    rfl
  have hrun := condH_run_E1 hBKH hcolB hpar' (by omega) (w.moves[n]).i le_rfl hij.le
  exact absurd hlt (not_lt.mpr hrun)

-- provides: U3, L4.3b ((6): the old target at the moved address is at least `B`)
-- [Changed in verification] adds the literal-cap form of the repaired cap (item 1), which
-- `repair_output` and `repair_output_exists` use.
theorem marked_height_mono {rk : SrcRecord} (h : rk.Admitted) {c : ColAddr} {k p : Nat}
    (hfd : rk.firstDiff = .capAt c k p) (w : Closure.AdmCap rk.E)
    (hw : w.col = c ∧ w.cut = k ∧ w.par = p) :
    let bm := Closure.moveAddr w.moves rk.b
    let c' : ColAddr := ⟨bm.heightPath ++ c.path.drop rk.b.heightPath.length, c.col⟩
    (w.H = Closure.litCap rk.E c' k p ∧ Closure.IsUpward rk.E c' k p ∧
      bm.col.num 0 = rk.b.col.num 0) ∧
    bm ∈ rk.E.entryAddrs ∧
    rk.tgtHeight ≤ (rk.E.heightAt bm).getD Tree.empty := by
  dsimp only
  have hL : Scan.InL rk.E := Closure.std_inL h.1
  obtain ⟨hbc, -⟩ := firstDiff_cap h hfd
  have hout := repair_moves_outside h hfd w hw
  obtain ⟨hwc, hwk, hwp⟩ := hw
  subst hwc hwk hwp
  have hA := Closure.applyMoves_litCap_addr hL.2.2.1 w hbc hout
  obtain ⟨hupm, hlitm, -⟩ := hA w.moves.length le_rfl
  rw [List.take_length] at hupm hlitm
  refine ⟨⟨hlitm, hupm, Closure.moveAddr_num _ _⟩,
    mem_entryAddrs_of_container_E1 (colAddrs_of_isUpward_E1 hupm) (List.prefix_append _ _), ?_⟩
  -- (6): induction along the moves, one `marked_step_E1` per move
  have key : ∀ q, q ≤ w.moves.length → rk.tgtHeight ≤
      (rk.E.heightAt (Closure.moveAddr (w.moves.take q) rk.b)).getD Tree.empty := by
    intro q
    induction q with
    | zero => intro _; simp [SrcRecord.tgtHeight, Closure.moveAddr, Closure.moveAddrBody]
    | succ q ih =>
      intro hq
      refine le_trans (ih (by omega)) ?_
      obtain ⟨hupq, hlitq, -⟩ := hA q (by omega)
      obtain ⟨col, sd, q', Hi, C, hcol, hsd, hj, hij, hin, hi, hjC, hpar, hlt⟩ :=
        Closure.moves_violate w q (by omega)
      rw [hlitq] at hcol hsd
      rw [Closure.stopData_litCap hupq] at hsd
      obtain rfl := Option.some.inj hsd
      have hma : Closure.moveAddr (w.moves.take (q + 1)) rk.b =
          w.moves[q].mapEntry w.moves[q].fwdIdx (Closure.moveAddr (w.moves.take q) rk.b) := by
        rw [List.take_add_one, List.getElem?_eq_getElem (by omega)]
        simp only [Closure.moveAddr, Closure.moveAddrBody, Option.toList_some, List.foldl_append,
          List.foldl_cons, List.foldl_nil]
      rw [hma]
      exact marked_step_E1 hL.2.2.1 hupq hcol hj hij hin hi hjC hpar hlt (hout q (by omega))
  have := key w.moves.length le_rfl
  rwa [List.take_length] at this

/-! ### G-012 helpers, moved up from L7.5d (names and statements unchanged; used by L4.3
`repair_output` and L7.5a `frame_repair`) -/

end Packet

namespace Tree

/-- D1.2g helper (G-012): `takeWhile` passes a block all of whose members satisfy the test. -/
theorem takeWhile_append_of_forall {p : Role → Bool} :
    ∀ (l₁ l₂ : List Role), (∀ a ∈ l₁, p a = true) → (l₁ ++ l₂).takeWhile p = l₁ ++ l₂.takeWhile p
  | [], _, _ => rfl
  | a :: l₁, l₂, h => by
    have ha : p a = true := h a (List.mem_cons_self ..)
    have ih := takeWhile_append_of_forall l₁ l₂ (fun b hb => h b (List.mem_cons_of_mem _ hb))
    simp only [List.cons_append, List.takeWhile_cons, ha, if_true, ih]

/-- D1.2g helper (G-012): a role of `t` whose path extends `e.heightPath` is a role of the height
of `e`, placed under `e.heightPath`. -/
theorem mem_under_of_inEntry {t : Forest} {e : EntryAddr} (he : e ∈ t.entryAddrs) {x : Role}
    (hx : x ∈ t.roles) (hpath : e.heightPath <+: x.path) :
    x ∈ ((t.heightAt e).getD Tree.empty).roles.map (Role.under e.heightPath) := by
  obtain ⟨h, hh⟩ : ∃ h, t.heightAt e = some h := by
    have h1 := (mem_entryAddrs_iff _ _).mp he
    cases hE : t.entryAt e with
    | none => simp [hE] at h1
    | some v => exact ⟨v.2, by simp [Tree.heightAt, hE]⟩
  rw [hh, Option.getD_some, List.mem_map]
  obtain ⟨π', hπ'⟩ := hpath
  have hcol : ∀ d : ColAddr, d.path = e.heightPath ++ π' →
      t.colAt d = h.colAt ⟨π', d.col⟩ := by
    intro d hd
    unfold Tree.colAt
    rw [hd, forestAt_append, forestAt_heightPath, hh]
    rfl
  cases x with
  | ord d =>
    simp only [Role.path] at hπ'
    refine ⟨.ord ⟨π', d.col⟩, ?_, ?_⟩
    · have hx' := (mem_roles_iff _ _).mp hx
      rw [mem_roles_iff]
      simp only at hx' ⊢
      rwa [hcol d hπ'.symm] at hx'
    · simp only [Role.under]
      rw [hπ']
  | slot d =>
    simp only [Role.path] at hπ'
    refine ⟨.slot ⟨⟨π', d.col.col⟩, d.idx⟩, ?_, ?_⟩
    · have hx' := (mem_roles_iff _ _).mp hx
      rw [mem_roles_iff]
      simp only at hx' ⊢
      unfold Tree.entryAt at hx' ⊢
      rwa [hcol d.col hπ'.symm] at hx'
    · simp only [Role.under]
      rw [hπ']

/-- D1.2g item 2 (G-012): no role of the prefix `P(t, e)` lies inside `e`. -/
theorem not_inEntry_of_mem_prefix {t : Forest} {e : EntryAddr} (he : e ∈ t.entryAddrs)
    {y : Role} (hy : y ∈ Packet.prefixRoles t e) : y.inEntry e = false := by
  obtain ⟨post, hroles, -⟩ := roles_entry he
  have hnd := roles_nodup t
  rw [hroles] at hnd
  have hdis := List.disjoint_of_nodup_append hnd
  have hyt : y ∈ t.roles := (List.takeWhile_sublist _).subset hy
  by_contra hin
  have hin' : y.inEntry e = true := by simpa using hin
  have hne : y ≠ .slot e := by
    rintro rfl
    exact hdis hy (List.mem_cons_self ..)
  have hpath : e.heightPath <+: y.path := by
    simpa [Role.inEntry, hne, List.isPrefixOf_iff_prefix] using hin'
  exact hdis hy (List.mem_cons_of_mem _ (List.mem_append_left _ (mem_under_of_inEntry he hyt hpath)))

/-- D1.2g item 1 (G-012): the prefix of an entry and its slot precede every other role inside
the entry. -/
theorem prefix_slot_before_inEntry {t : Forest} {e : EntryAddr} (he : e ∈ t.entryAddrs)
    {x : Role} (hx : x ∈ t.roles) (hin : x.inEntry e = true) (hne : x ≠ .slot e) :
    Packet.prefixRoles t e ++ [.slot e] <+: Packet.rolesBefore t x := by
  obtain ⟨post, hroles, -⟩ := roles_entry he
  have hxP : x ∉ Packet.prefixRoles t e := fun h => by
    have h1 := not_inEntry_of_mem_prefix he h
    rw [hin] at h1
    exact absurd h1 (by decide)
  unfold Packet.rolesBefore
  rw [hroles, takeWhile_append_of_forall]
  · simp only [List.takeWhile_cons, bne_iff_ne, ne_eq, Ne.symm hne, not_false_eq_true,
      if_true]
    exact ⟨_, by rw [List.append_assoc]; rfl⟩
  · intro a ha
    simp only [bne_iff_ne, ne_eq]
    rintro rfl
    exact hxP ha

end Tree

namespace Packet

open Hier

/-- L7.5a-1 (G-012): a repair step that retains `e` (or a container of `e`) is undone by the
backward index map, on `U_e` and on `A_{e.col}`. -/
theorem mapEntry_bwd_fwd {K : Forest} {e : EntryAddr} {m : Closure.Move}
    (h : Closure.RepairStepOK K e m) :
    m.mapEntry m.bwdIdx (m.mapEntry m.fwdIdx e) = e ∧
      m.mapRole m.bwdIdx (m.mapRole m.fwdIdx (.ord e.col)) = .ord e.col := by
  obtain ⟨col, -, hij, -, -, -, hret⟩ := h
  rcases hret with hret | ⟨ρ, hρ⟩
  · -- the retained entry is `e` itself: `e.col = m.col`, `e.idx = m.j`
    subst hret
    have hp : ∀ g : Nat → Nat, m.mapPath g m.col.path = m.col.path := by
      intro g; unfold Closure.Move.mapPath; simp
    have hc : (⟨m.col.path, m.col.col⟩ : ColAddr) = m.col := rfl
    refine ⟨?_, ?_⟩
    · simp only [Closure.Move.mapEntry, hp, hc, if_true]
      congr 1
      simp only [Closure.Move.fwdIdx, Closure.Move.bwdIdx]
      split <;> split <;> omega
    · simp only [Closure.Move.mapRole, hp]
  · -- the retained entry contains `e.col`: `e.col.path = m.col.path ++ (m.col.col, m.j) :: ρ`
    obtain ⟨⟨π, cc⟩, idx⟩ := e
    simp only [EntryAddr.heightPath, List.append_assoc, List.singleton_append] at hρ
    subst hρ
    have hmp : ∀ (g : Nat → Nat) (x : Nat),
        m.mapPath g (m.col.path ++ (m.col.col, x) :: ρ) = m.col.path ++ (m.col.col, g x) :: ρ := by
      intro g x; unfold Closure.Move.mapPath; simp
    have hne : ∀ x : Nat, (⟨m.col.path ++ (m.col.col, x) :: ρ, cc⟩ : ColAddr) ≠ m.col := by
      intro x h
      have h' := congrArg (fun c : ColAddr => c.path.length) h
      simp at h'
    have hji : m.bwdIdx (m.fwdIdx m.j) = m.j := by
      simp only [Closure.Move.fwdIdx, Closure.Move.bwdIdx]
      split <;> split <;> omega
    refine ⟨?_, ?_⟩
    · simp only [Closure.Move.mapEntry, hmp, if_neg (hne _), hji]
    · simp only [Closure.Move.mapRole, hmp, hji]

/-- L7.5a-1 (G-012): along a repair list for `b`, undoing the moves (last first) sends the moved
slot and host column back to `U_b` and `A_{b.col}`. -/
theorem foldr_bwd_moveAddr {K : Forest} {b : EntryAddr} {ms : List Closure.Move}
    (h : Closure.RepairList K b ms) :
    ms.foldr (fun m y => m.mapRole m.bwdIdx y) (.slot (Closure.moveAddr ms b)) = .slot b ∧
      ms.foldr (fun m y => m.mapRole m.bwdIdx y) (.ord (Closure.moveAddr ms b).col) =
        .ord b.col := by
  induction ms using List.reverseRecOn with
  | nil => exact ⟨rfl, rfl⟩
  | append_singleton ms m ih =>
    -- the prefix is a repair list, and the last step retains the current marked entry
    have hpre : Closure.RepairList K b ms := by
      intro idx hidx
      have h' := h idx (by simp; omega)
      rwa [List.take_append_of_le_length (by omega), List.getElem_append_left hidx] at h'
    have hlast : Closure.RepairStepOK (Closure.applyMoves K ms) (Closure.moveAddr ms b) m := by
      have h' := h ms.length (by simp)
      simpa using h'
    obtain ⟨ih1, ih2⟩ := ih hpre
    obtain ⟨hb1, hb2⟩ := mapEntry_bwd_fwd hlast
    have hma : Closure.moveAddr (ms ++ [m]) b = m.mapEntry m.fwdIdx (Closure.moveAddr ms b) := by
      show Closure.moveAddrBody _ _ = _
      simp [Closure.moveAddrBody, List.foldl_append]; rfl
    have hcol : ∀ (g : Nat → Nat) (e : EntryAddr),
        (m.mapEntry g e).col = ⟨m.mapPath g e.col.path, e.col.col⟩ := by
      intro g e
      unfold Closure.Move.mapEntry
      dsimp only
      split <;> rfl
    rw [hma, List.foldr_append, List.foldr_append]
    constructor
    · simp only [List.foldr_cons, List.foldr_nil, Closure.Move.mapRole, hb1]
      exact ih1
    · have hb2' : m.mapRole m.bwdIdx (.ord (m.mapEntry m.fwdIdx (Closure.moveAddr ms b)).col) =
          .ord (Closure.moveAddr ms b).col := by
        rw [hcol]; exact hb2
      simp only [List.foldr_cons, List.foldr_nil, hb2']
      exact ih2

/-- L7.5a-2 (G-012; consumers L7.5d `marked_slot`, `marked_host`): the moved marked entry and its
host column have origins `U_b` and `A_{b.col}`. -/
theorem origin_moveAddr {E : Forest} (hE : Scan.InL E) (w : Closure.AdmCap E) {b : EntryAddr}
    (hbc : b.heightPath <+: w.col.path) (hout : Closure.MovesOutside w.moves b) :
    w.origin (.slot (Closure.moveAddr w.moves b)) = some (.slot b) ∧
      w.origin (.ord (Closure.moveAddr w.moves b).col) = some (.ord b.col) := by
  obtain ⟨h1, h2⟩ := foldr_bwd_moveAddr (Closure.moves_spec hE w b hbc hout).1
  have hne : (Role.slot b) ≠ .slot ⟨w.col, w.cut⟩ := by
    intro h
    have hb : b = ⟨w.col, w.cut⟩ := Role.slot.inj h
    have hlen := hbc.length_le
    simp [hb, EntryAddr.heightPath] at hlen
  constructor
  · show Closure.originBody w _ = _
    simp only [Closure.originBody, h1, if_neg hne]
  · show Closure.originBody w _ = _
    simp only [Closure.originBody, h2]
    simp

/-- L7.5a-3 (G-012; consumers L7.5d `marked_mem`, `stop_inside`, `marked_prefix`): the moved
marked entry `bm` is an entry of `w.H`; `w.H` is the literal cap at the relocated column `c'`
inside `bm`; the stopping column and the closing slot lie inside `bm`; every role of `P(w.H, bm)`
has an origin. -/
theorem marked_entry_cap {E : Forest} (hE : IsStd E) (w : Closure.AdmCap E) {b : EntryAddr}
    (hb : b ∈ E.entryAddrs) (hbc : b.heightPath <+: w.col.path)
    (hout : Closure.MovesOutside w.moves b) :
    Closure.moveAddr w.moves b ∈ w.H.entryAddrs ∧
    w.H = Closure.litCap E ⟨(Closure.moveAddr w.moves b).heightPath ++
      w.col.path.drop b.heightPath.length, w.col.col⟩ w.cut w.par ∧
    (∀ sd, Scan.stopData w.H = some sd →
      sd.col = ⟨(Closure.moveAddr w.moves b).heightPath ++ w.col.path.drop b.heightPath.length,
        w.col.col⟩ ∧
      (Role.ord sd.col).inEntry (Closure.moveAddr w.moves b) = true ∧
      (Role.slot (Scan.closingSlot sd)).inEntry (Closure.moveAddr w.moves b) = true) ∧
    ∀ x ∈ prefixRoles w.H (Closure.moveAddr w.moves b), (w.origin x).isSome := by
  have hL : Scan.InL E := Closure.std_inL hE
  obtain ⟨-, -, -, hG, hH⟩ := Closure.moves_spec hL w b hbc hout
  -- `bm` is an entry of `w.H` (U2 `moves_spec` items 4-5, U1 `setHeight_basic`)
  have hbE : (E.heightAt b).isSome := by
    have h := (Tree.mem_entryAddrs_iff _ _).mp hb
    simpa [Tree.heightAt] using h
  have hbmG : Closure.moveAddr w.moves b ∈
      (Closure.applyMoves (E.truncAfter b) w.moves).entryAddrs := by
    rw [Tree.mem_entryAddrs_iff]
    have h : ((Closure.applyMoves (E.truncAfter b) w.moves).heightAt
        (Closure.moveAddr w.moves b)).isSome := by rw [hG]; exact hbE
    simpa [Tree.heightAt] using h
  have hmem : Closure.moveAddr w.moves b ∈ w.H.entryAddrs := by
    rw [hH]; exact (Tree.setHeight_basic _ _ _ hbmG).1
  -- `w.H` is the literal cap at the relocated column (U2 `applyMoves_litCap_addr`, all moves)
  obtain ⟨hup', hlit, -⟩ :=
    Closure.applyMoves_litCap_addr hL.2.2.1 w hbc hout w.moves.length le_rfl
  rw [List.take_length] at hup' hlit
  have hwH : w.H = Closure.litCap E ⟨(Closure.moveAddr w.moves b).heightPath ++
      w.col.path.drop b.heightPath.length, w.col.col⟩ w.cut w.par := hlit
  -- the stopping column and the closing slot lie inside `bm` (U2 T3.8c `stopData_litCap`)
  have hin : ∀ sd, Scan.stopData w.H = some sd →
      sd.col = ⟨(Closure.moveAddr w.moves b).heightPath ++ w.col.path.drop b.heightPath.length,
        w.col.col⟩ ∧
      (Role.ord sd.col).inEntry (Closure.moveAddr w.moves b) = true ∧
      (Role.slot (Scan.closingSlot sd)).inEntry (Closure.moveAddr w.moves b) = true := by
    intro sd hsd
    rw [hwH, Closure.stopData_litCap hup'] at hsd
    obtain rfl := Option.some.inj hsd
    refine ⟨rfl, ?_, ?_⟩ <;>
      simp [Role.inEntry, Role.path, Scan.closingSlot, List.isPrefixOf_iff_prefix]
  refine ⟨hmem, hwH, hin, ?_⟩
  -- origins on the prefix: `none` only at the closing slot (U2 `origin_spec_full` item 2), which
  -- is inside `bm`, hence not in `P(w.H, bm)` (D1.2g item 2)
  intro x hx
  by_contra hno
  have hxH : x ∈ w.H.roles := (List.takeWhile_sublist _).subset hx
  obtain ⟨sd, hsd, rfl⟩ := ((Closure.origin_spec_full hL w).2.1 x hxH).mp
    (Option.not_isSome_iff_eq_none.mp hno)
  have h1 := Tree.not_inEntry_of_mem_prefix hmem hx
  rw [(hin sd hsd).2.2] at h1
  exact absurd h1 (by decide)

-- provides: U3, L4.3 (the spine's `repair_output`†; consumer: U5 L8.8 Case 3)
theorem repair_output {rk : SrcRecord} (h : rk.Admitted) {c : ColAddr} {k p : Nat}
    (hfd : rk.firstDiff = .capAt c k p) (w : Closure.AdmCap rk.E)
    (hw : w.col = c ∧ w.cut = k ∧ w.par = p) {n : Nat} {Hk : Forest}
    (hexp : expand w.H n = some Hk) (habove : rk.E < Hk) :
    let bm := Closure.moveAddr w.moves rk.b
    bm ∈ Hk.entryAddrs ∧ Hk.truncAfter bm = Hk ∧
    (rk.E.heightAt bm).getD Tree.empty < (Hk.heightAt bm).getD Tree.empty ∧
    rk.tgtHeight < (Hk.heightAt bm).getD Tree.empty ∧
    ({ E := rk.E, b := rk.b, F := Hk.truncAfter bm, a := bm, kind := .repair w.moves } :
      SrcRecord).Admitted := by
  intro bm
  have hstd : IsStd rk.E := h.1
  have hL : Scan.InL rk.E := Closure.std_inL hstd
  obtain ⟨hbc, -⟩ := firstDiff_cap h hfd
  have hbc' : rk.b.heightPath <+: w.col.path := hw.1 ▸ hbc
  have hout := repair_moves_outside h hfd w hw
  have hMH := marked_height_mono h hfd w hw
  dsimp only at hMH
  obtain ⟨⟨hlit, hup', hnum⟩, hbmE, hBle⟩ := hMH
  obtain ⟨hmem, -, hin, -⟩ := marked_entry_cap hstd w h.2.1 hbc' hout
  -- the cap column `c'` lies inside `bm`
  set c' : ColAddr := ⟨bm.heightPath ++ c.path.drop rk.b.heightPath.length, c.col⟩ with hc'
  have hc'E : c' ∈ rk.E.colAddrs := by
    rw [Tree.mem_colAddrs_iff]
    unfold Closure.IsUpward at hup'
    split at hup'
    · rename_i col hcol; rw [hcol]; rfl
    · exact hup'.elim
  have hbmc' : bm.heightPath <+: c'.path := ⟨_, rfl⟩
  have htrH : w.H.truncAfter bm = w.H := by
    rw [hlit]; exact litCap_truncAfter_E1 hc'E hbmc' k p
  -- the step of `w.H` is confined to `bm`
  have hHL : Scan.InL w.H := w.inL
  have hord : Scan.stepKind w.H = some .ordinary := by
    rw [hlit] at hHL ⊢
    exact Closure.litCap_ordinary hL.2.1 hup' hHL.1 hHL.2.1
  obtain ⟨sd, hsd⟩ := Option.isSome_iff_exists.mp (Scan.stopData_of_stepKind hord (by decide))
  have hconf : Confined w.H bm := by
    refine ⟨sd, hsd, ?_, fun hsp => by rw [hord] at hsp; cases hsp⟩
    have h1 := (hin sd hsd).2.1
    have hne : Role.ord sd.col ≠ Role.slot bm := by simp
    simpa [Role.inEntry, hne, Role.path, List.isPrefixOf_iff_prefix] using h1
  obtain ⟨B', hHk, hB'lt⟩ := expand_confined hHL hmem htrH hconf hexp
  have hSB := Tree.setHeight_basic w.H bm B' hmem
  have hHkB' : (Hk.heightAt bm).getD Tree.empty = B' := by rw [hHk, hSB.2.1]; rfl
  have hHkmem : bm ∈ Hk.entryAddrs := hHk ▸ hSB.1
  have hHktr : Hk.truncAfter bm = Hk := hHk ▸ hSB.2.2.2.2.1 htrH
  -- comparison with `E`: `Hk = (E.truncAfter bm).setHeight bm B'`
  have hHkE : Hk = (rk.E.truncAfter bm).setHeight bm B' := by
    rw [hHk, hlit]; exact litCap_setHeight_E1 hc'E hbmc' k p B'
  have hgood : (rk.E.heightAt bm).getD Tree.empty < B' := by
    by_contra hcon
    have hle : B' ≤ (rk.E.heightAt bm).getD Tree.empty := le_of_not_gt hcon
    have hTspec := Tree.truncAfter_spec rk.E bm hbmE
    have hT : (rk.E.truncAfter bm).setHeight bm ((rk.E.heightAt bm).getD Tree.empty) =
        rk.E.truncAfter bm := by
      rw [← hTspec.2.2.1]; exact setHeight_heightAt_self_E1 hTspec.2.1
    have h1 : Hk ≤ rk.E.truncAfter bm := by
      rw [hHkE]
      rcases hle.lt_or_eq with hlt | heq
      · conv_rhs => rw [← hT]
        exact le_of_lt ((setHeight_lt_iff_E1 hTspec.2.1 hTspec.1 _ _).mpr hlt)
      · rw [heq, hT]
    obtain ⟨m, hm⟩ := Scan.truncAfter_safePrefix hbmE
    have h2 : rk.E.truncAfter bm ≤ rk.E := hm ▸ Scan.safePrefix_le _ _
    exact absurd (lt_of_lt_of_le habove (le_trans h1 h2)) (lt_irrefl _)
  -- admission of the repair record
  obtain ⟨hRL, -, -, hY, hH5⟩ := Closure.moves_spec hL w rk.b hbc' hout
  set Y := Closure.applyMoves (rk.E.truncAfter rk.b) w.moves with hYdef
  have hbmY : bm ∈ Y.entryAddrs := by
    rw [Tree.mem_entryAddrs_iff]
    have : (Y.heightAt bm).isSome := by
      rw [hY]
      have := (Tree.mem_entryAddrs_iff _ _).mp h.2.1
      simpa [Tree.heightAt] using this
    simpa [Tree.heightAt] using this
  refine ⟨hHkmem, hHktr, hHkB' ▸ hgood, hHkB' ▸ lt_of_le_of_lt hBle hgood, ?_⟩
  refine ⟨hstd, h.2.1, hHktr.symm ▸ hHkmem, hHktr.symm ▸ Closure.inL_expand hHL hexp,
    by rw [hHktr, hHktr], ?_, hRL, rfl, ?_⟩
  · show relKey (rk.b.col.num 0) rk.tgtHeight <
      relKey (bm.col.num 0) (((Hk.truncAfter bm).heightAt bm).getD Tree.empty)
    rw [hHktr, hHkB', hnum, relKey_lt_iff]
    exact lt_of_le_of_lt hBle hgood
  · show (Hk.truncAfter bm).setHeight bm rk.tgtHeight = Y
    rw [hHktr, hHk, hSB.2.2.1, hH5, (Tree.setHeight_basic Y bm _ hbmY).2.2.1]
    apply (Tree.setHeight_basic Y bm _ hbmY).2.2.2.1
    rw [hY]
    have := (Tree.mem_entryAddrs_iff _ _).mp h.2.1
    obtain ⟨x, hx⟩ := Option.isSome_iff_exists.mp this
    simp [SrcRecord.tgtHeight, Tree.heightAt, hx]

-- provides: U3, L4.3 (cofinality supplies a positive output above `E`)
theorem repair_output_exists {rk : SrcRecord} (h : rk.Admitted) {c : ColAddr} {k p : Nat}
    (hfd : rk.firstDiff = .capAt c k p) (w : Closure.AdmCap rk.E)
    (hw : w.col = c ∧ w.cut = k ∧ w.par = p) :
    ∃ n Hk, 1 ≤ n ∧ expand w.H n = some Hk ∧ rk.E < Hk := by
  have hstd : IsStd rk.E := h.1
  have hL : Scan.InL rk.E := Closure.std_inL hstd
  obtain ⟨c', hup', hH', -⟩ := Closure.applyMoves_litCap hL.2.2.1 w.upward w.movesValid
  have hsd := Closure.stopData_litCap hup'
  rw [← hH'] at hsd
  obtain ⟨x, xs, hx⟩ := Scan.lastCol_of_stopData hsd
  have hlast : w.H.cols.getLast? ≠ some [] := by
    show (Closure.applyMoves _ _).cols.getLast? ≠ some []
    rw [hx]; simp
  obtain ⟨n, E', hn, -, hexp, hlt⟩ := Closure.cofinal_bound hstd w.inL (Closure.lt_admCap w) hlast
  exact ⟨n, E', hn, hexp, hlt⟩

/-- L4.3 helper: a height containing an entry has at least two more roles than that entry's
height (its column role and its slot). -/
theorem size_entry_E1 {B : Forest} {P : List (Nat × Nat)} {j i q : Nat} {J : Forest}
    (he : B.entryAt ⟨⟨P, j⟩, i⟩ = some (q, J)) : J.size + 2 ≤ B.size := by
  obtain ⟨pre, post, hroles, -, hord, -, -⟩ := Tree.roles_decomp P B j i q J he
  have hpre : 1 ≤ pre.length := List.length_pos_of_mem hord
  unfold Tree.size
  rw [hroles]
  simp only [List.length_append, List.length_cons, List.length_map]
  omega

-- provides: U3, L4.3 (the spine's `query_size_bound`†, (7); consumer: U5 L8.8 Case 3)
theorem query_size_bound {rk : SrcRecord} (h : rk.Admitted) {c : ColAddr} {k p : Nat}
    (hfd : rk.firstDiff = .capAt c k p) (w : Closure.AdmCap rk.E)
    (hw : w.col = c ∧ w.cut = k ∧ w.par = p) {sd : Scan.StopData}
    (hsd : Scan.stopData w.H = some sd) :
    sd.Q.length = k ∧
    (∀ j < sd.Q.length,
      w.origin (.slot ⟨sd.col, j⟩) = some (.slot ⟨c, j⟩) ∧
      rk.b.heightPath <+: c.path ∧ (rk.E.heightAt ⟨c, j⟩) = (sd.Q[j]?).map Prod.snd) ∧
    ∀ J ∈ sd.Q, J.2.size + 2 ≤ rk.tgtHeight.size := by
  obtain ⟨hbc, hcE, -⟩ := firstDiff_cap h hfd
  have hL : Scan.InL rk.E := Closure.std_inL h.1
  obtain ⟨-, -, hlen, -, hq⟩ := Closure.admCap_query hL w hsd
  obtain ⟨hwc, hwk, -⟩ := hw
  subst hwc hwk
  obtain ⟨col, hcol⟩ : ∃ col, rk.E.colAt w.col = some col := by
    have := (Tree.mem_colAddrs_iff _ _).mp hcE
    exact Option.isSome_iff_exists.mp this
  have hQ : ∀ j < sd.Q.length, sd.Q[j]? = col[j]? := by
    intro j hj
    rw [(hq j (by omega)).2, hcol, Option.getD_some]
  refine ⟨hlen, fun j hj => ⟨(hq j (by omega)).1, hbc, ?_⟩, ?_⟩
  · simp only [Tree.heightAt, Tree.entryAt, hcol, Option.bind_some, hQ j hj]
  · intro J hJ
    obtain ⟨j, hj, hJj⟩ := List.getElem_of_mem hJ
    have hJ' : sd.Q[j]? = some J := by rw [List.getElem?_eq_getElem hj, hJj]
    rw [hQ j hj] at hJ'
    obtain ⟨ρ, hρ⟩ := hbc
    obtain ⟨B, hB⟩ : ∃ B, rk.E.heightAt rk.b = some B := by
      have := (Tree.mem_entryAddrs_iff _ _).mp h.2.1
      obtain ⟨x, hx⟩ := Option.isSome_iff_exists.mp this
      exact ⟨x.2, by simp [Tree.heightAt, hx]⟩
    have hent : rk.E.entryAt ⟨w.col, j⟩ = some J := by
      simp only [Tree.entryAt, hcol, Option.bind_some, hJ']
    have hent' : B.entryAt ⟨⟨ρ, w.col.col⟩, j⟩ = some (J.1, J.2) := by
      rw [← Tree.entryAt_under hB]
      rw [show (⟨⟨rk.b.heightPath ++ ρ, w.col.col⟩, j⟩ : EntryAddr) = ⟨w.col, j⟩ by
        rw [hρ]]
      exact hent
    have := size_entry_E1 hent'
    simpa [SrcRecord.tgtHeight, hB] using this

/-! ### L4.3 `reduce_childEnds` helpers (F1) -/

/-- L4.3 helper: replace the columns from `j` on of the forest at path `ρ` by `Zc`, removing all
later context along `ρ` (the output shape of a confined step). -/
def putAt_F1 {α : Type} (j : Nat) (Zc : List (List (α × Tree α))) :
    List (Nat × Nat) → Tree α → Tree α
  | [], .node cols => .node (cols.take j ++ Zc)
  | (ci, ei) :: rest, .node cols =>
    match (cols.getD ci [])[ei]? with
    | some (q, h) => .node (cols.take ci ++ [(cols.getD ci []).take ei ++ [(q, putAt_F1 j Zc rest h)]])
    | none => .node cols

theorem litCapAux_putAt_F1 (p j : Nat) :
    ∀ (ρ : List (Nat × Nat)) (X : Forest),
      Closure.litCapAux 0 p ρ j X = putAt_F1 j [[(p, Tree.empty)]] ρ X
  | [], .node cols => by simp [Closure.litCapAux, putAt_F1]
  | (ci, ei) :: rest, .node cols => by
    simp only [Closure.litCapAux, putAt_F1]
    cases (cols.getD ci [])[ei]? with
    | none => rfl
    | some x => obtain ⟨q, h⟩ := x; simp only [litCapAux_putAt_F1 p j rest h]

theorem putAt_map_F1 {α β : Type} (f : α → β) (j : Nat) (Zc : List (List (α × Tree α))) :
    ∀ (ρ : List (Nat × Nat)) (X : Tree α),
      Tree.map f (putAt_F1 j Zc ρ X) = putAt_F1 j (Zc.map (Tree.mapCol f)) ρ (Tree.map f X)
  | [], .node cols => by
    simp [putAt_F1, Tree.map, Scan.treeMapCols_eq_map, List.map_take]
  | (ci, ei) :: rest, .node cols => by
    simp only [putAt_F1, Tree.map, Scan.treeMapCols_eq_map, List.getD_eq_getElem?_getD,
      List.getElem?_map]
    cases hc : cols[ci]? with
    | none =>
      simp only [Option.map_none, Option.getD_none, List.getElem?_nil]
      simp [Tree.map, Scan.treeMapCols_eq_map]
    | some col =>
      simp only [Option.map_some, Option.getD_some, Scan.treeMapCol_eq_map, List.getElem?_map]
      cases he : col[ei]? with
      | none => simp [Tree.map, Scan.treeMapCols_eq_map]
      | some x =>
        obtain ⟨q, h⟩ := x
        simp only [Option.map_some, Tree.map, Scan.treeMapCols_eq_map, List.map_append,
          List.map_take, List.map_cons, List.map_nil, Scan.treeMapCol_eq_map,
          putAt_map_F1 f j Zc rest h]

theorem forestAt_putAt_F1 {α : Type} (j : Nat) (Zc : List (List (α × Tree α))) (P' : List (Nat × Nat)) :
    ∀ (P : List (Nat × Nat)) (T : Tree α), (T.forestAt P).isSome →
      (putAt_F1 j Zc (P ++ P') T).forestAt P = (T.forestAt P).map (putAt_F1 j Zc P')
  | [], T, _ => rfl
  | (ci, ei) :: rest, .node cols, hs => by
    rw [Tree.forestAt_cons] at hs
    simp only [Tree.cols] at hs
    cases hc : cols[ci]? with
    | none => rw [hc] at hs; simp at hs
    | some col =>
      cases he : col[ei]? with
      | none => rw [hc, Option.bind_some, he] at hs; simp at hs
      | some x =>
        obtain ⟨q, h⟩ := x
        rw [hc, Option.bind_some, he, Option.bind_some] at hs
        have hcl : ci < cols.length := (List.getElem?_eq_some_iff.1 hc).1
        have hel : ei < col.length := (List.getElem?_eq_some_iff.1 he).1
        have hput : putAt_F1 j Zc ((ci, ei) :: rest ++ P') (Tree.node cols) =
            Tree.node (cols.take ci ++ [col.take ei ++ [(q, putAt_F1 j Zc (rest ++ P') h)]]) := by
          simp only [List.cons_append, putAt_F1, List.getD_eq_getElem?_getD, hc, Option.getD_some, he]
        rw [hput, Tree.forestAt_cons, Tree.forestAt_cons]
        simp only [Tree.cols, hc, he, Option.bind_some]
        rw [List.getElem?_append_right (by simp)]
        simp only [List.length_take, Nat.min_eq_left hcl.le, Nat.sub_self, List.getElem?_cons_zero,
          Option.bind_some]
        rw [List.getElem?_append_right (by simp)]
        simp only [List.length_take, Nat.min_eq_left hel.le, Nat.sub_self, List.getElem?_cons_zero,
          Option.bind_some]
        exact forestAt_putAt_F1 j Zc P' rest h hs

theorem cutBefore_putAt_F1 {α : Type} (j : Nat) (Zc : List (List (α × Tree α))) :
    ∀ (ρ : List (Nat × Nat)) (T Y : Tree α), T.forestAt ρ = some Y → j ≤ Y.cols.length →
      cutBefore ρ j none (putAt_F1 j Zc ρ T) = cutBefore ρ j none T
  | [], .node cols, Y, hY, hj => by
    simp only [Tree.forestAt, Option.some.injEq] at hY
    subst hY
    simp only [Tree.cols] at hj
    simp only [putAt_F1, cutBefore]
    rw [List.take_append_of_le_length (by simp; omega), List.take_take, Nat.min_self]
  | (ci, ei) :: rest, .node cols, Y, hY, hj => by
    rw [Tree.forestAt_cons] at hY
    simp only [Tree.cols] at hY
    cases hc : cols[ci]? with
    | none => rw [hc] at hY; simp at hY
    | some col =>
      rw [hc, Option.bind_some] at hY
      cases he : col[ei]? with
      | none => rw [he] at hY; simp at hY
      | some x =>
        obtain ⟨q, h⟩ := x
        rw [he, Option.bind_some] at hY
        have hcl : ci < cols.length := (List.getElem?_eq_some_iff.1 hc).1
        have hel : ei < col.length := (List.getElem?_eq_some_iff.1 he).1
        simp only [putAt_F1, List.getD_eq_getElem?_getD, hc, Option.getD_some, he]
        simp only [cutBefore, hc, he]
        rw [List.getElem?_append_right (by simp)]
        simp only [List.length_take, Nat.min_eq_left hcl.le, Nat.sub_self, List.getElem?_cons_zero]
        rw [List.getElem?_append_right (by simp)]
        simp only [List.length_take, Nat.min_eq_left hel.le, Nat.sub_self, List.getElem?_cons_zero,
          cutBefore_putAt_F1 j Zc rest h Y hY hj]
        simp [hcl.le, hel.le]


/-- L4.3 helper: placing `Z` along a literal cap path is `putAt` there (the bottom is given). -/
theorem replaceAt_litCapAux_F1 (Z : Forest) (k p j jc : Nat) (R : List (Nat × Nat)) :
    ∀ (P : List (Nat × Nat)) (X : Forest), (X.forestAt P).isSome →
      (∀ Y, X.forestAt P = some Y →
        replaceAt 0 0 Z 0 (Closure.litCapAux k p R j Y) = putAt_F1 jc Z.cols [] Y) →
      replaceAt 0 0 Z P.length (Closure.litCapAux k p (P ++ R) j X) = putAt_F1 jc Z.cols P X
  | [], X, _, hb => hb X rfl
  | (ci, ei) :: P, .node cols, hs, hb => by
    rw [Tree.forestAt_cons] at hs hb
    simp only [Tree.cols] at hs hb
    cases hc : cols[ci]? with
    | none => rw [hc] at hs; simp at hs
    | some col =>
      cases he : col[ei]? with
      | none => rw [hc, Option.bind_some, he] at hs; simp at hs
      | some x =>
        obtain ⟨q, h⟩ := x
        rw [hc, Option.bind_some, he, Option.bind_some] at hs hb
        have hgd : cols.getD ci [] = col := by simp [List.getD, hc]
        have ih := replaceAt_litCapAux_F1 Z k p j jc R P h hs hb
        simp only [List.cons_append, Closure.litCapAux, hgd, he, putAt_F1, List.length_cons,
          replaceAt]
        simp only [Scan.mapLast_eq, List.dropLast_concat, List.getLast?_concat, Option.map_some,
          Option.toList_some, Scan.shiftVal_zero_fun, Scan.treeMap_id, Scan.treeMapCol_id_fun,
          List.map_id, id, ih]
        simp

theorem replaceAt_bottom_end_F1 (Z : Forest) (k p j : Nat) (Y : Forest) :
    replaceAt 0 0 Z 0 (Closure.litCapAux k p [] j Y) = putAt_F1 j Z.cols [] Y := by
  obtain ⟨cols⟩ := Y
  simp only [Closure.litCapAux, replaceAt, putAt_F1]
  split
  · rename_i h; simp at h
  · simp [Scan.shiftVal_zero_fun, Scan.treeMapCol_id_fun]

theorem replaceAt_bottom_cont_F1 (Z : Forest) (k p j c₀ i₀ : Nat) (Y : Forest)
    (hY : ((Y.cols[c₀]?).bind (·[i₀]?)).isSome) :
    replaceAt 0 0 Z 0 (Closure.litCapAux k p [(c₀, i₀)] j Y) = putAt_F1 c₀ Z.cols [] Y := by
  obtain ⟨cols⟩ := Y
  simp only [Tree.cols] at hY
  cases hc : cols[c₀]? with
  | none => rw [hc] at hY; simp at hY
  | some col =>
    cases he : col[i₀]? with
    | none => rw [hc, Option.bind_some, he] at hY; simp at hY
    | some x =>
      obtain ⟨q, h⟩ := x
      have hgd : cols.getD c₀ [] = col := by simp [List.getD, hc]
      simp only [Closure.litCapAux, hgd, he, replaceAt, putAt_F1]
      split
      · rename_i h; simp at h
      · simp [Scan.shiftVal_zero_fun, Scan.treeMapCol_id_fun]

section CmpF1
variable {α : Type} (c : α → α → Ordering) [Std.ReflCmp c]

theorem cmpCols_append_left_F1 :
    ∀ (P a b : List (List (α × Tree α))), Tree.cmpCols c (P ++ a) (P ++ b) = Tree.cmpCols c a b
  | [], a, b => rfl
  | x :: P, a, b => by
    rw [List.cons_append, List.cons_append, Tree.cmpCols, Tree.cmpCol_self c x,
      cmpCols_append_left_F1 P a b]; rfl

theorem cmpCol_append_left_F1 :
    ∀ (P a b : List (α × Tree α)), Tree.cmpCol c (P ++ a) (P ++ b) = Tree.cmpCol c a b
  | [], a, b => rfl
  | (p, h) :: P, a, b => by
    rw [List.cons_append, List.cons_append, Tree.cmpCol, Std.ReflCmp.compare_self (cmp := c),
      Tree.cmp_self c h, cmpCol_append_left_F1 P a b]; rfl

/-- L4.3 helper: a tree is smaller when it agrees up to the forest at `ρ` and that forest is
smaller from column `j` on. -/
theorem cmp_path_F1 (j : Nat) :
    ∀ (ρ : List (Nat × Nat)) (T U X Y : Tree α), cutBefore ρ j none T = cutBefore ρ j none U →
      T.forestAt ρ = some X → U.forestAt ρ = some Y → j ≤ X.cols.length → j ≤ Y.cols.length →
      Tree.cmpCols c (X.cols.drop j) (Y.cols.drop j) = .lt → Tree.cmp c T U = .lt
  | [], .node xs, .node ys, X, Y, hcut, hX, hY, hjx, hjy, hlt => by
    simp only [Tree.forestAt, Option.some.injEq] at hX hY
    subst hX hY
    simp only [cutBefore, Tree.node.injEq] at hcut
    simp only [Tree.cols] at hjx hjy hlt
    rw [Tree.cmp, ← List.take_append_drop j xs, ← List.take_append_drop j ys, hcut,
      cmpCols_append_left_F1]
    exact hlt
  | (ci, ii) :: rest, .node xs, .node ys, X, Y, hcut, hX, hY, hjx, hjy, hlt => by
    rw [Tree.forestAt_cons] at hX hY
    simp only [Tree.cols] at hX hY
    cases hxc : xs[ci]? with
    | none => rw [hxc] at hX; simp at hX
    | some colx =>
      cases hyc : ys[ci]? with
      | none => rw [hyc] at hY; simp at hY
      | some coly =>
        cases hxe : colx[ii]? with
        | none => rw [hxc, Option.bind_some, hxe] at hX; simp at hX
        | some ex =>
          cases hye : coly[ii]? with
          | none => rw [hyc, Option.bind_some, hye] at hY; simp at hY
          | some ey =>
            obtain ⟨lx, hx⟩ := ex
            obtain ⟨ly, hy⟩ := ey
            rw [hxc, Option.bind_some, hxe, Option.bind_some] at hX
            rw [hyc, Option.bind_some, hye, Option.bind_some] at hY
            simp only [cutBefore, hxc, hyc, hxe, hye, Tree.node.injEq] at hcut
            have hcx : ci < xs.length := (List.getElem?_eq_some_iff.1 hxc).1
            have hcy : ci < ys.length := (List.getElem?_eq_some_iff.1 hyc).1
            have hex : ii < colx.length := (List.getElem?_eq_some_iff.1 hxe).1
            have hey : ii < coly.length := (List.getElem?_eq_some_iff.1 hye).1
            obtain ⟨h1, h2⟩ := List.append_inj hcut (by simp; omega)
            simp only [List.cons.injEq, and_true] at h2
            obtain ⟨h3, h4⟩ := List.append_inj h2 (by simp; omega)
            simp only [List.cons.injEq, and_true, Prod.mk.injEq] at h4
            obtain ⟨rfl, h5⟩ := h4
            have ih := cmp_path_F1 j rest hx hy X Y h5 hX hY hjx hjy hlt
            obtain ⟨xs₁, xs₂, hxs, hxl⟩ := Tree.exists_split_of_getElem? hxc
            obtain ⟨ys₁, ys₂, hys, hyl⟩ := Tree.exists_split_of_getElem? hyc
            obtain ⟨cx₁, cx₂, hcxs, hcxl⟩ := Tree.exists_split_of_getElem? hxe
            obtain ⟨cy₁, cy₂, hcys, hcyl⟩ := Tree.exists_split_of_getElem? hye
            have e1 : xs₁ = ys₁ := by
              rw [hxs, hys, List.take_left' hxl, List.take_left' hyl] at h1; exact h1
            have e2 : cx₁ = cy₁ := by
              rw [hcxs, hcys, List.take_left' hcxl, List.take_left' hcyl] at h3; exact h3
            rw [hxs, hys, Tree.cmp, e1, cmpCols_append_left_F1, Tree.cmpCols, hcxs, hcys, e2,
              cmpCol_append_left_F1, Tree.cmpCol, Std.ReflCmp.compare_self (cmp := c), ih]
            rfl

omit [Std.ReflCmp c] in
theorem cmpCol_replicate_F1 (e : α × Tree α) :
    ∀ (L : List (α × Tree α)) (N : Nat), (∀ x ∈ L, (c x.1 e.1).then (Tree.cmp c x.2 e.2) ≠ .gt) →
      L.length < N → Tree.cmpCol c L (List.replicate N e) = .lt
  | [], N, _, hN => by
    obtain ⟨N', rfl⟩ : ∃ N', N = N' + 1 := ⟨N - 1, by simp at hN; omega⟩
    rw [List.replicate_succ]; rfl
  | x :: L, N, hx, hN => by
    obtain ⟨N', rfl⟩ : ∃ N', N = N' + 1 := ⟨N - 1, by simp at hN; omega⟩
    rw [List.replicate_succ]
    obtain ⟨p, h⟩ := x
    rw [Tree.cmpCol]
    have h0 := hx (p, h) (by simp)
    have ih := cmpCol_replicate_F1 e L N' (fun y hy => hx y (by simp [hy])) (by simp at hN; omega)
    simp only at h0
    revert h0
    cases (c p e.1).then (Tree.cmp c h e.2) <;> simp [ih]

end CmpF1

theorem cutBefore_split_F1 {α : Type} (c₀ i₀ m : Nat) :
    ∀ (ρ₀ : List (Nat × Nat)) (T U : Tree α),
      cutBefore (ρ₀ ++ [(c₀, i₀)]) m none T = cutBefore (ρ₀ ++ [(c₀, i₀)]) m none U →
      (T.forestAt (ρ₀ ++ [(c₀, i₀)])).isSome → (U.forestAt (ρ₀ ++ [(c₀, i₀)])).isSome →
      cutBefore ρ₀ c₀ none T = cutBefore ρ₀ c₀ none U ∧
      ∃ tc uc lt ht lu hu, T.colAt ⟨ρ₀, c₀⟩ = some tc ∧ U.colAt ⟨ρ₀, c₀⟩ = some uc ∧
        tc[i₀]? = some (lt, ht) ∧ uc[i₀]? = some (lu, hu) ∧ tc.take i₀ = uc.take i₀ ∧ lt = lu ∧
        ht.cols.take m = hu.cols.take m
  | [], .node xs, .node ys, hcut, hX, hY => by
    simp only [List.nil_append] at hcut hX hY
    rw [Tree.forestAt_cons] at hX hY
    simp only [Tree.cols] at hX hY
    cases hxc : xs[c₀]? with
    | none => rw [hxc] at hX; simp at hX
    | some colx =>
      cases hyc : ys[c₀]? with
      | none => rw [hyc] at hY; simp at hY
      | some coly =>
        cases hxe : colx[i₀]? with
        | none => rw [hxc, Option.bind_some, hxe] at hX; simp at hX
        | some ex =>
          cases hye : coly[i₀]? with
          | none => rw [hyc, Option.bind_some, hye] at hY; simp at hY
          | some ey =>
            obtain ⟨lx, hx⟩ := ex
            obtain ⟨ly, hy⟩ := ey
            simp only [cutBefore, hxc, hyc, hxe, hye, Tree.node.injEq] at hcut
            have hcx : c₀ < xs.length := (List.getElem?_eq_some_iff.1 hxc).1
            have hcy : c₀ < ys.length := (List.getElem?_eq_some_iff.1 hyc).1
            have hex : i₀ < colx.length := (List.getElem?_eq_some_iff.1 hxe).1
            have hey : i₀ < coly.length := (List.getElem?_eq_some_iff.1 hye).1
            obtain ⟨h1, h2⟩ := List.append_inj hcut (by simp; omega)
            simp only [List.cons.injEq, and_true] at h2
            obtain ⟨h3, h4⟩ := List.append_inj h2 (by simp; omega)
            simp only [List.cons.injEq, and_true, Prod.mk.injEq] at h4
            obtain ⟨rfl, h5⟩ := h4
            obtain ⟨hxc'⟩ := hx
            obtain ⟨hyc'⟩ := hy
            simp only [cutBefore, Tree.node.injEq] at h5
            refine ⟨by simp only [cutBefore, h1], colx, coly, lx, _, lx, _, ?_, ?_, hxe, hye, h3, rfl,
              by simpa [Tree.cols] using h5⟩
            · simp [Tree.colAt, Tree.forestAt, Tree.cols, hxc]
            · simp [Tree.colAt, Tree.forestAt, Tree.cols, hyc]
  | (ci, ii) :: rest, .node xs, .node ys, hcut, hX, hY => by
    simp only [List.cons_append] at hcut hX hY
    rw [Tree.forestAt_cons] at hX hY
    simp only [Tree.cols] at hX hY
    cases hxc : xs[ci]? with
    | none => rw [hxc] at hX; simp at hX
    | some colx =>
      cases hyc : ys[ci]? with
      | none => rw [hyc] at hY; simp at hY
      | some coly =>
        cases hxe : colx[ii]? with
        | none => rw [hxc, Option.bind_some, hxe] at hX; simp at hX
        | some ex =>
          cases hye : coly[ii]? with
          | none => rw [hyc, Option.bind_some, hye] at hY; simp at hY
          | some ey =>
            obtain ⟨lx, hx⟩ := ex
            obtain ⟨ly, hy⟩ := ey
            rw [hxc, Option.bind_some, hxe, Option.bind_some] at hX
            rw [hyc, Option.bind_some, hye, Option.bind_some] at hY
            simp only [cutBefore, hxc, hyc, hxe, hye, Tree.node.injEq] at hcut
            have hcx : ci < xs.length := (List.getElem?_eq_some_iff.1 hxc).1
            have hcy : ci < ys.length := (List.getElem?_eq_some_iff.1 hyc).1
            have hex : ii < colx.length := (List.getElem?_eq_some_iff.1 hxe).1
            have hey : ii < coly.length := (List.getElem?_eq_some_iff.1 hye).1
            obtain ⟨h1, h2⟩ := List.append_inj hcut (by simp; omega)
            simp only [List.cons.injEq, and_true] at h2
            obtain ⟨h3, h4⟩ := List.append_inj h2 (by simp; omega)
            simp only [List.cons.injEq, and_true, Prod.mk.injEq] at h4
            obtain ⟨rfl, h5⟩ := h4
            obtain ⟨ih1, tc, uc, lt, ht, lu, hu, ih2⟩ := cutBefore_split_F1 c₀ i₀ m rest hx hy h5 hX hY
            refine ⟨?_, tc, uc, lt, ht, lu, hu, ?_⟩
            · simp only [cutBefore, hxc, hyc, hxe, hye, h1, h3, ih1]
            · simpa [Tree.colAt_cons, Tree.cols, hxc, hyc, hxe, hye] using ih2

/-- L4.3 helper: a literal cap re-using the parent of the existing entry `k` is the truncation
after that entry with its height cleared. -/
theorem litCapAux_truncSet_F1 (k p j : Nat) :
    ∀ (P : List (Nat × Nat)) (X : Forest) (col : Column) (hs : Forest),
      X.colAt ⟨P, j⟩ = some col → col[k]? = some (p, hs) →
      Closure.litCapAux k p P j X = Tree.setAux Tree.empty P j k (Tree.truncAux P j k X)
  | [], .node cols, col, hs, hc, hk => by
    have hc' : cols[j]? = some col := by simpa [Tree.colAt, Tree.forestAt, Tree.cols] using hc
    have hgd : cols.getD j [] = col := by simp [List.getD, hc']
    simp only [Closure.litCapAux, Tree.truncAux, Tree.setAux, hgd, take_succ_of_getElem?_E1 hk]
    rw [Tree.list_modify_append_singleton _ _ _ (length_take_of_getElem?_E1 hc'),
      Tree.list_modify_append_singleton _ _ _ (length_take_of_getElem?_E1 hk)]
  | (ci, ei) :: rest, .node cols, col, hs, hc, hk => by
    rw [Tree.colAt_cons] at hc
    simp only [Tree.cols] at hc
    cases hcc : cols[ci]? with
    | none => rw [hcc] at hc; simp at hc
    | some colc =>
      cases he : colc[ei]? with
      | none => rw [hcc, Option.bind_some, he] at hc; simp at hc
      | some x =>
        obtain ⟨q, h⟩ := x
        rw [hcc, Option.bind_some, he, Option.bind_some] at hc
        have hgd : cols.getD ci [] = colc := by simp [List.getD, hcc]
        have ih := litCapAux_truncSet_F1 k p j rest h col hs hc hk
        simp only [Closure.litCapAux, Tree.truncAux, Tree.setAux, hgd, he, Option.map_some,
          Option.toList_some]
        rw [Tree.list_modify_append_singleton _ _ _ (length_take_of_getElem?_E1 hcc),
          Tree.list_modify_append_singleton _ _ _ (length_take_of_getElem?_E1 he), ih]

theorem litCap_truncClear_F1 {F : Forest} {c : ColAddr} {col : Column} {k p : Nat} {hs : Forest}
    (hcol : F.colAt c = some col) (hk : col[k]? = some (p, hs)) :
    Closure.litCap F c k p = (F.truncAfter ⟨c, k⟩).setHeight ⟨c, k⟩ Tree.empty := by
  have hent : (F.entryAt ⟨c, k⟩).isSome := by simp [Tree.entryAt, hcol, hk]
  have he : (⟨c, k⟩ : EntryAddr) ∈ F.entryAddrs := (Tree.mem_entryAddrs_iff _ _).2 hent
  have htrE : (⟨c, k⟩ : EntryAddr) ∈ (F.truncAfter ⟨c, k⟩).entryAddrs :=
    (Tree.truncAfter_spec F _ he).2.1
  have hent' := (Tree.mem_entryAddrs_iff _ _).1 htrE
  have hcs : (F.colAt c).isSome := by rw [hcol]; rfl
  rw [Tree.setHeight, Tree.setHeightBody, if_pos hent', Tree.truncAfter_eq_body,
    Tree.truncAfterBody, if_pos hent, Closure.litCap, Closure.litCapBody, if_pos hcs]
  exact litCapAux_truncSet_F1 k p c.col c.path F col hs hcol hk

/-- L4.3 helper: the roles of a truncate-and-clear are a prefix of the roles. -/
theorem truncClear_roles_F1 (t : Forest) (e : EntryAddr) (he : e ∈ t.entryAddrs) :
    ((t.truncAfter e).setHeight e Tree.empty).roles <+: t.roles := by
  have hx' := he
  rw [Tree.mem_entryAddrs_iff] at hx'
  obtain ⟨⟨p, H⟩, hx⟩ := Option.isSome_iff_exists.1 hx'
  have hFe : (t.truncAfter e).entryAt e = some (p, H) := by rw [Tree.entryAt_truncAfter he, hx]
  obtain ⟨post, hr, hs, -⟩ := setHeight_decomp (t.truncAfter e) e Tree.empty hFe
  have hF := Tree.truncAfter_roles_under he
  have hpF : prefixRoles (t.truncAfter e) e = prefixRoles t e := (Tree.truncAfter_spec t e he).2.2.2.2.2
  rw [hpF] at hr hs
  have hpost : post = [] := by
    rw [hF, show t.heightAt e = some H by simp [Tree.heightAt, hx], Option.getD_some] at hr
    have := congrArg List.length hr
    simp only [List.length_append, List.length_cons, List.length_map] at this
    exact List.eq_nil_of_length_eq_zero (by omega)
  subst hpost
  have hroles : ((t.truncAfter e).setHeight e Tree.empty).roles = prefixRoles t e ++ [Role.slot e] := by
    rw [hs]; rfl
  obtain ⟨post', hr', -⟩ := Tree.roles_entry he
  rw [hroles, hr']
  exact ⟨((t.heightAt e).getD Tree.empty).roles.map (Role.under e.heightPath) ++ post', by simp⟩

theorem truncClear_graph_F1 (t : Forest) (e : EntryAddr) (he : e ∈ t.entryAddrs) :
    ∀ x ∈ graph ((t.truncAfter e).setHeight e Tree.empty), x ∈ graph t := by
  intro x hx
  have := (graph_truncClear t e he x).1 hx
  unfold restrictTo at this
  exact (List.mem_filter.1 this).1

/-- L4.3 helper: under H every later entry of a column is at most an earlier one. -/
theorem entryLe_chain_F1 {E : Forest} (hH : Scan.CondH E) {d : ColAddr} {col : Column}
    (hd : E.colAt d = some col) {i : Nat} {x : Nat × Forest} (hx : col[i]? = some x) :
    ∀ n y, col[i + n]? = some y → Scan.EntryLe y x
  | 0, y, hy => by
    rw [Nat.add_zero, hx] at hy; cases hy
    right; exact ⟨rfl, le_rfl⟩
  | n + 1, y, hy => by
    have hl : i + n < col.length := by
      have := (List.getElem?_eq_some_iff.1 hy).1; omega
    have hz : col[i + n]? = some col[i + n] := List.getElem?_eq_getElem hl
    have h1 := entryLe_chain_F1 hH hd hx n _ hz
    have hdE : d ∈ E.colAddrs := (Tree.mem_colAddrs_iff _ _).2 (by rw [hd]; rfl)
    have h2 := hH d hdE (i + n) _ y (by rw [hd]; exact hz) (by rw [hd]; exact hy)
    unfold Scan.EntryLe at h1 h2 ⊢
    rcases h1 with h1 | ⟨h1, h1'⟩ <;> rcases h2 with h2 | ⟨h2, h2'⟩
    · left; omega
    · left; omega
    · left; omega
    · right; exact ⟨h2.trans h1, h2'.trans h1'⟩

theorem colAt_split_F1 {α : Type} {T : Tree α} {P : List (Nat × Nat)} {c : Nat}
    {col : List (α × Tree α)} (hc : T.colAt ⟨P, c⟩ = some col) :
    ∃ T0, T.forestAt P = some T0 ∧ T0.cols[c]? = some col := by
  unfold Tree.colAt at hc
  cases hf : T.forestAt P with
  | none => rw [hf] at hc; simp at hc
  | some T0 => rw [hf] at hc; exact ⟨T0, rfl, hc⟩

theorem forestAt_snoc_F1 {α : Type} {T : Tree α} {P : List (Nat × Nat)} {c i : Nat}
    {col : List (α × Tree α)} {l : α} {h : Tree α} (hc : T.colAt ⟨P, c⟩ = some col)
    (hi : col[i]? = some (l, h)) : T.forestAt (P ++ [(c, i)]) = some h := by
  obtain ⟨T0, hT0, hcol⟩ := colAt_split_F1 hc
  rw [Tree.forestAt_append, hT0, Option.bind_some, Tree.forestAt_cons, hcol, Option.bind_some, hi]
  rfl

-- provides: U3, L4.3 (the spine's `reduce_childEnds`†; consumer: U5 L8.8 Case 2)
theorem reduce_childEnds {rk : SrcRecord} (h : rk.Admitted) {π : List (Nat × Nat)}
    (hfd : rk.firstDiff = .childEnds π) :
    ∃ A₁ : Forest,
      Scan.InL (rk.F.setHeight rk.a A₁) ∧ A₁ ≤ rk.srcHeight ∧ rk.tgtKey < relKey (rk.a.col.num 0) A₁ ∧
      (rk.F.setHeight rk.a A₁).roles <+: rk.F.roles ∧
      (∀ x ∈ graph (rk.F.setHeight rk.a A₁), x ∈ graph rk.F) ∧
      Confined (rk.F.setHeight rk.a A₁) rk.a ∧
      ((Scan.stepKind (rk.F.setHeight rk.a A₁) = some .special) ∨
        (Scan.stepKind (rk.F.setHeight rk.a A₁) = some .ordinary ∧
          ∃ sd rd, Scan.stopData (rk.F.setHeight rk.a A₁) = some sd ∧ sd.Q = [] ∧
            Scan.rootData (rk.F.setHeight rk.a A₁) = some rd ∧ rk.a.heightPath <+: rd.col.path)) ∧
      ∃ (k : Nat) (A₂ : Forest),
        expand (rk.F.setHeight rk.a A₁) k = some (rk.F.setHeight rk.a A₂) ∧
        rk.tgtKey < relKey (rk.a.col.num 0) A₂ ∧ A₂ < rk.srcHeight ∧
        ({ rk with F := rk.F.setHeight rk.a A₂, kind := rk.kind.toDesc } : SrcRecord).Admitted := by
  obtain ⟨-, hce, -⟩ := firstDiff_spec h
  obtain ⟨ρ, X, Y, -, hρne, hX, hY, hm, hcut⟩ := hce π hfd
  set m := X.cols.length with hmdef
  set t := rk.b.col.num 0 with ht
  set r := rk.a.col.num 0 with hr
  have hEL : Scan.InL rk.E := Closure.std_inL h.1
  have hb : rk.E.heightAt rk.b = some rk.tgtHeight := by
    have hb := h.2.1
    rw [Tree.mem_entryAddrs_iff, Option.isSome_iff_exists] at hb
    obtain ⟨x, hx⟩ := hb
    simp [SrcRecord.tgtHeight, Tree.heightAt, hx]
  have ha : rk.F.heightAt rk.a = some rk.srcHeight := by
    have ha := h.2.2.1
    rw [Tree.mem_entryAddrs_iff, Option.isSome_iff_exists] at ha
    obtain ⟨x, hx⟩ := ha
    simp [SrcRecord.srcHeight, Tree.heightAt, hx]
  have haE : rk.a ∈ rk.F.entryAddrs := h.2.2.1
  have hFL : Scan.InL rk.F := h.2.2.2.1
  have htr : rk.F.truncAfter rk.a = rk.F := h.2.2.2.2.1
  have hsk : rk.srcKey = relKey r rk.srcHeight := rfl
  have htk : rk.tgtKey = relKey t rk.tgtHeight := rfl
  -- the source forest `G` at `ρ`
  obtain ⟨G, hG, hYG⟩ : ∃ G, rk.srcHeight.forestAt ρ = some G ∧ Y = Tree.map (relLabel r) G := by
    rw [hsk, relKey_eq_map, forestAt_map_D8] at hY
    obtain ⟨G, hG, hYG⟩ := Option.map_eq_some_iff.1 hY
    exact ⟨G, hG, hYG.symm⟩
  have hGlen : G.cols.length = Y.cols.length := by rw [hYG, Tree.cols_map, List.length_map]
  -- `ρ = ρ₀ ++ [(c₀, i₀)]`; the entry `e₀` of `F` whose height is `G`
  obtain ⟨ρ₀, ⟨c₀, i₀⟩, hρ⟩ : ∃ ρ₀ x, ρ = ρ₀ ++ [x] :=
    ⟨ρ.dropLast, ρ.getLast hρne, (List.dropLast_append_getLast hρne).symm⟩
  set e₀ : EntryAddr := ⟨⟨rk.a.heightPath ++ ρ₀, c₀⟩, i₀⟩ with he₀
  have he₀hp : e₀.heightPath = rk.a.heightPath ++ ρ := by
    simp [he₀, EntryAddr.heightPath, hρ]
  have hFe₀ : rk.F.heightAt e₀ = some G := by
    rw [← Tree.forestAt_heightPath, he₀hp, Tree.forestAt_append, Tree.forestAt_heightPath, ha,
      Option.bind_some, hG]
  obtain ⟨q₀, hent₀⟩ : ∃ q₀, rk.F.entryAt e₀ = some (q₀, G) := by
    unfold Tree.heightAt at hFe₀
    obtain ⟨⟨q₀, G'⟩, h1, h2⟩ := Option.map_eq_some_iff.1 hFe₀
    simp only at h2; subst h2
    exact ⟨q₀, h1⟩
  have he₀E : e₀ ∈ rk.F.entryAddrs := (Tree.mem_entryAddrs_iff _ _).2 (by rw [hent₀]; rfl)
  -- column `m` of `G`: its first entry `(p₀, h₀)` with `p₀` at least the host `a₀` of `e₀`
  obtain ⟨colm, hcolmG⟩ : ∃ colm, G.cols[m]? = some colm :=
    ⟨_, List.getElem?_eq_getElem (by omega)⟩
  set cm : ColAddr := ⟨e₀.heightPath, m⟩ with hcm
  have hcolm : rk.F.colAt cm = some colm := by
    rw [hcm, ← List.append_nil e₀.heightPath, colAt_heightPath_D8 hFe₀]
    simpa [Tree.colAt, Tree.forestAt] using hcolmG
  have hGne : G ≠ Tree.empty := by
    intro h0; rw [h0] at hcolmG; simp [Tree.empty, Tree.cols] at hcolmG
  obtain ⟨p₀, h₀, rest₀, hcolm_eq, ha₀⟩ :=
    hFL.2.1 e₀ he₀E q₀ G hent₀ hGne colm (List.mem_of_getElem? hcolmG)
  set a₀ := e₀.col.num 0 with ha₀def
  have hk0 : colm[0]? = some (p₀, h₀) := by rw [hcolm_eq]; rfl
  -- the reduced source `A₁` and `F₁`
  set A₁ := Closure.litCapAux 0 p₀ ρ m rk.srcHeight with hA₁
  have hcmF : cm ∈ rk.F.colAddrs := (Tree.mem_colAddrs_iff _ _).2 (by rw [hcolm]; rfl)
  have hacm : rk.a.heightPath <+: cm.path := by rw [hcm, he₀hp]; exact List.prefix_append _ _
  have hF₁ : Closure.litCap rk.F cm 0 p₀ = rk.F.setHeight rk.a A₁ := by
    rw [litCap_eq_setHeight_E1 hcmF hacm 0 p₀, htr, ha, Option.getD_some]
    congr 2
    rw [hcm, he₀hp]; simp
  set F₁ := rk.F.setHeight rk.a A₁ with hF₁def
  obtain ⟨n, hn⟩ := litCap_safePrefix_F1 hcolm hk0
  have hF₁L : Scan.InL F₁ := by rw [← hF₁, hn]; exact Closure.inL_safePrefix hFL n
  have hSB := Tree.setHeight_basic rk.F rk.a A₁ haE
  have haF₁ : rk.a ∈ F₁.entryAddrs := hSB.1
  have hF₁a : F₁.heightAt rk.a = some A₁ := hSB.2.1
  have htr₁ : F₁.truncAfter rk.a = F₁ := hSB.2.2.2.2.1 htr
  have hidem : ∀ Z, F₁.setHeight rk.a Z = rk.F.setHeight rk.a Z := hSB.2.2.1
  have hFF : rk.F.setHeight rk.a rk.srcHeight = rk.F := (Tree.setHeight_basic _ _ _ haE).2.2.2.1 ha
  -- `A₁ ≤ A'`
  have hA₁le : A₁ ≤ rk.srcHeight := by
    have h1 : F₁ ≤ rk.F := by rw [← hF₁, hn]; exact Scan.safePrefix_le _ _
    by_contra hc
    have h2 := (setHeight_lt_iff_E1 haE htr rk.srcHeight A₁).2 (lt_of_not_ge hc)
    rw [hFF] at h2
    exact absurd h1 (not_le.2 h2)
  -- the target ends at column `m` of the forest at `ρ`: any source with a column there is larger
  have hcmpEnd : ∀ Zc : List Column, Zc ≠ [] →
      rk.tgtKey < relKey r (putAt_F1 m Zc ρ rk.srcHeight) := by
    intro Zc hZ
    rw [relKey_eq_map, putAt_map_F1, ← relKey_eq_map, ← hsk, Key.lt_iff_keyCmp]
    set Zc' := Zc.map (Tree.mapCol (relLabel r))
    have hZ' : Zc' ≠ [] := by simpa [Zc'] using hZ
    have hfa : (putAt_F1 m Zc' ρ rk.srcKey).forestAt ρ = some (Tree.node (Y.cols.take m ++ Zc')) := by
      have := forestAt_putAt_F1 m Zc' [] ρ rk.srcKey (by rw [hY]; rfl)
      rw [List.append_nil] at this
      rw [this, hY]
      obtain ⟨ycols⟩ := Y
      rfl
    refine cmp_path_F1 keyLabelCmp m ρ _ _ X _ ?_ hX hfa le_rfl
      (by show m ≤ (Y.cols.take m ++ Zc').length; simp; omega) ?_
    · rw [cutBefore_putAt_F1 m _ ρ _ Y hY hm.le]; exact hcut
    · show Tree.cmpCols _ (X.cols.drop m) ((Y.cols.take m ++ Zc').drop m) = _
      rw [List.drop_eq_nil_of_le (by omega), List.drop_append_of_le_length (by simp; omega),
        List.drop_eq_nil_of_le (by simp), List.nil_append]
      obtain ⟨z, zs, hzz⟩ := List.exists_cons_of_ne_nil hZ'
      rw [hzz]; rfl
  have hA₁key : rk.tgtKey < relKey r A₁ := by
    rw [hA₁, litCapAux_putAt_F1]; exact hcmpEnd _ (by simp)
  -- roles and graph: `F₁` truncates after the first entry of column `m` and clears its height
  have he₁ : (⟨cm, 0⟩ : EntryAddr) ∈ rk.F.entryAddrs :=
    (Tree.mem_entryAddrs_iff _ _).2 (by simp [Tree.entryAt, hcolm, hk0])
  have hF₁tc : F₁ = (rk.F.truncAfter ⟨cm, 0⟩).setHeight ⟨cm, 0⟩ Tree.empty := by
    rw [← hF₁]; exact litCap_truncClear_F1 hcolm hk0
  -- the stop of `F₁`
  have hsd₁ : Scan.stopData F₁ = some ⟨cm.path.length, cm, cm.num 0, p₀, []⟩ := by
    have hc : (rk.F.colAt cm).isSome := by rw [hcolm]; rfl
    rw [← hF₁]
    unfold Scan.stopData Scan.stopDataBody Closure.litCap Closure.litCapBody
    rw [if_pos hc, Closure.ker_stopF_litCapAux 0 p₀ cm.path cm.col rk.F [] hc]
    simp
  set sd₁ : Scan.StopData := ⟨cm.path.length, cm, cm.num 0, p₀, []⟩ with hsd₁def
  have hcmpath : cm.path = (rk.a.heightPath ++ ρ₀) ++ [(c₀, i₀)] := by
    rw [hcm, he₀hp, hρ, List.append_assoc]
  have hoe : sd₁.ownerEntry = some e₀ := by
    simp only [hsd₁def, Scan.StopData.ownerEntry, hcmpath, List.getLast?_append,
      List.getLast?_singleton, Option.some_or, Option.map_some, List.dropLast_concat, he₀]
  have hconf : Confined F₁ rk.a :=
    ⟨sd₁, hsd₁, hacm, fun _ => ⟨e₀, hoe, by rw [he₀]; exact List.prefix_append _ _⟩⟩
  have hF₁ne : F₁ ≠ Tree.empty := by
    intro h0
    obtain ⟨x, xs, hx⟩ := Scan.lastCol_of_stopData hsd₁
    rw [h0] at hx
    simp [Tree.empty, Tree.cols] at hx
  have hkind : Scan.stepKind F₁ = some .special ∨ Scan.stepKind F₁ = some .ordinary := by
    obtain ⟨kd, hkd⟩ := Option.isSome_iff_exists.1 (Scan.stepKind_isSome hF₁ne hF₁L.1 hF₁L.2.1)
    cases kd with
    | deletion =>
      exfalso
      obtain ⟨x, xs, hx⟩ := Scan.lastCol_of_stopData hsd₁
      rw [(Scan.stepKind_deletion_iff F₁).1 hkd] at hx
      simp at hx
    | special => exact Or.inl hkd
    | ordinary => exact Or.inr hkd
  have hexpP : ∀ k, expand F₁ k = Scan.paperOp F₁ k :=
    Scan.expand_eq_paperOp hF₁ne hF₁L.1 hF₁L.2.1
  have hF₁lit : F₁ = Closure.litCapAux 0 p₀ cm.path m rk.F := by
    rw [← hF₁]; exact litCap_eq_D8 hcmF 0 p₀
  -- the common end: the output replaces inside the marked height and the record is admitted
  have finish : ∀ (k j : Nat) (ρ' : List (Nat × Nat)) (Zc : List Column),
      expand F₁ k = some (putAt_F1 j Zc (rk.a.heightPath ++ ρ') rk.F) →
      rk.tgtKey < relKey r (putAt_F1 j Zc ρ' rk.srcHeight) →
      ∃ (k : Nat) (A₂ : Forest), expand F₁ k = some (rk.F.setHeight rk.a A₂) ∧
        rk.tgtKey < relKey r A₂ ∧ A₂ < rk.srcHeight ∧
        ({ rk with F := rk.F.setHeight rk.a A₂, kind := rk.kind.toDesc } : SrcRecord).Admitted := by
    intro k j ρ' Zc hexp hlt
    obtain ⟨A'', hF₂, hA''⟩ := expand_confined hF₁L haF₁ htr₁ hconf hexp
    rw [hidem] at hF₂
    rw [hF₁a, Option.getD_some] at hA''
    have hA2 : (putAt_F1 j Zc (rk.a.heightPath ++ ρ') rk.F).heightAt rk.a =
        some (putAt_F1 j Zc ρ' rk.srcHeight) := by
      rw [← Tree.forestAt_heightPath, forestAt_putAt_F1 j Zc ρ' rk.a.heightPath rk.F
        (by rw [Tree.forestAt_heightPath, ha]; rfl), Tree.forestAt_heightPath, ha]
      rfl
    rw [hF₂, (Tree.setHeight_basic _ _ _ haE).2.1] at hA2
    have hAeq : A'' = putAt_F1 j Zc ρ' rk.srcHeight := Option.some.inj hA2
    rw [← hAeq] at hlt
    have hlt' : A'' < rk.srcHeight := lt_of_lt_of_le hA'' hA₁le
    refine ⟨k, A'', by rw [hexp, hF₂], hlt, hlt', ?_⟩
    exact reduce_confined h hlt'.le (by rw [← hF₂]; exact Closure.inL_expand hF₁L hexp) hlt
  refine ⟨A₁, hF₁L, hA₁le, hA₁key, ?_, ?_, hconf, ?_⟩
  · change F₁.roles <+: _
    rw [hF₁tc]; exact truncClear_roles_F1 _ _ he₁
  · change ∀ x ∈ graph F₁, _
    rw [hF₁tc]; exact truncClear_graph_F1 _ _ he₁
  have hvF : (rk.F.forestAt cm.path).isSome := by
    rw [hcm, he₀hp, Tree.forestAt_append, Tree.forestAt_heightPath, ha, Option.bind_some, hG]; rfl
  rcases hkind with hk | hk
  · -- special: the owner column of the stop is repeated
    refine ⟨Or.inl hk, ?_⟩
    obtain ⟨colX, q, hh, hcolX, hqX, hcol₁⟩ := colAt_litCapAux_container_D8 0 p₀ m cm.path rk.F hvF
      (d := e₀.col) (i := i₀) (List.prefix_refl _)
    have hqh : q = q₀ ∧ hh = G := by
      have : rk.F.entryAt e₀ = some (q, hh) := by
        simp only [Tree.entryAt, hcolX, Option.bind_some]; exact hqX
      rw [hent₀] at this
      simp only [Option.some.injEq, Prod.mk.injEq] at this
      exact ⟨this.1.symm, this.2.symm⟩
    obtain ⟨rfl, rfl⟩ := hqh
    have hdrop : cm.path.drop (e₀.col.path.length + 1) = [] := by
      rw [hcmpath]; simp [he₀]; omega
    rw [hdrop] at hcol₁
    have hcapG : Closure.litCapAux 0 p₀ [] m hh = Tree.node (hh.cols.take m ++ [[(p₀, Tree.empty)]]) := by
      obtain ⟨gcols⟩ := hh; simp [Closure.litCapAux, Tree.cols]
    rw [hcapG, ← hF₁lit] at hcol₁
    set col₁ := colX.take i₀ ++ [(q, Tree.node (hh.cols.take m ++ [[(p₀, Tree.empty)]]))] with hcol₁def
    have hlast : col₁.getLast? = some (q, Tree.node (hh.cols.take m ++ [[(p₀, Tree.empty)]])) := by
      simp [hcol₁def]
    set ε := if (colX.take i₀).isEmpty then 1 else 0 with hε
    set C' : Nat → Column := fun k =>
      colX.take i₀ ++ List.replicate (k + ε) (q, Tree.node (hh.cols.take m)) with hC'
    have hexpS : ∀ k, expand F₁ k = some (putAt_F1 c₀ [C' k] (rk.a.heightPath ++ ρ₀) rk.F) := by
      intro k
      rw [hexpP, Scan.paperOp_special hk hsd₁ hoe hcol₁ hlast k]
      have hd1 : col₁.dropLast = colX.take i₀ := by simp [hcol₁def]
      have hd2 : (Tree.node (hh.cols.take m ++ [[(p₀, Tree.empty)]])).cols.dropLast = hh.cols.take m := by
        simp [Tree.cols]
      rw [hd1, hd2]
      show some (replaceAt 0 0 (Tree.node [C' k]) (sd₁.depth - 1) F₁) = _
      have hdep : sd₁.depth - 1 = (rk.a.heightPath ++ ρ₀).length := by
        simp only [hsd₁def, hcmpath, List.length_append, List.length_singleton]; omega
      have hv0 : (rk.F.forestAt (rk.a.heightPath ++ ρ₀)).isSome := by
        rw [hcmpath, Tree.forestAt_append] at hvF
        cases hf : rk.F.forestAt (rk.a.heightPath ++ ρ₀) with
        | none => rw [hf] at hvF; simp at hvF
        | some _ => rfl
      have hbot : ∀ Y', rk.F.forestAt (rk.a.heightPath ++ ρ₀) = some Y' →
          replaceAt 0 0 (Tree.node [C' k]) 0 (Closure.litCapAux 0 p₀ [(c₀, i₀)] m Y') =
            putAt_F1 c₀ (Tree.node [C' k]).cols [] Y' := by
        intro Y' hY'
        apply replaceAt_bottom_cont_F1
        rw [hcmpath, Tree.forestAt_append, hY', Option.bind_some, Tree.forestAt_cons] at hvF
        cases hb : (Y'.cols[c₀]?.bind fun x => x[i₀]?) with
        | none => rw [hb] at hvF; simp at hvF
        | some _ => rfl
      rw [hdep, hF₁lit, hcmpath, replaceAt_litCapAux_F1 _ 0 p₀ m c₀ [(c₀, i₀)] _ rk.F hv0 hbot]
      rfl
    -- the target and source columns at the owner column
    have hXs : (rk.tgtKey.forestAt (ρ₀ ++ [(c₀, i₀)])).isSome := by rw [← hρ, hX]; rfl
    have hYs : (rk.srcKey.forestAt (ρ₀ ++ [(c₀, i₀)])).isSome := by rw [← hρ, hY]; rfl
    obtain ⟨hcut0, tc, uc, lt, ht', lu, hu, htc, huc, htci, huci, htake, hl, hhm⟩ :=
      cutBefore_split_F1 c₀ i₀ m ρ₀ rk.tgtKey rk.srcKey (by rw [← hρ]; exact hcut) hXs hYs
    have hXht : X = ht' := by
      have := forestAt_snoc_F1 htc htci; rw [← hρ, hX] at this; exact Option.some.inj this
    have hcolA0 : rk.srcHeight.colAt ⟨ρ₀, c₀⟩ = some colX := by
      rw [← colAt_heightPath_D8 ha]; exact hcolX
    have huc' : uc = Tree.mapCol (relLabel r) colX := by
      rw [hsk, relKey_eq_map, colAt_map_D8, hcolA0] at huc; exact (Option.some.inj huc).symm
    have hlu : lu = relLabel r q ∧ hu = relKey r hh := by
      have h1 := huci
      rw [huc', Scan.treeMapCol_eq_map, List.getElem?_map, hqX] at h1
      simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq] at h1
      exact ⟨h1.1.symm, h1.2.symm⟩
    obtain ⟨Bcol, hBcol, htcB⟩ : ∃ Bcol, rk.tgtHeight.colAt ⟨ρ₀, c₀⟩ = some Bcol ∧
        tc = Tree.mapCol (relLabel t) Bcol := by
      have h1 := htc
      rw [htk, relKey_eq_map, colAt_map_D8] at h1
      obtain ⟨Bcol, h2, h3⟩ := Option.map_eq_some_iff.1 h1
      exact ⟨Bcol, h2, h3.symm⟩
    have hBcolE : rk.E.colAt ⟨rk.b.heightPath ++ ρ₀, c₀⟩ = some Bcol := by
      rw [colAt_heightPath_D8 hb]; exact hBcol
    -- every later target entry is at most the target entry `(lt, ht')`
    have hall : ∀ x ∈ tc.drop i₀, (keyLabelCmp x.1 lt).then (Tree.cmp keyLabelCmp x.2 ht') ≠ .gt := by
      intro x hx
      obtain ⟨n, hn⟩ := List.mem_iff_getElem?.1 hx
      rw [List.getElem?_drop, htcB, Scan.treeMapCol_eq_map, List.getElem?_map] at hn
      have h1 := htci
      rw [htcB, Scan.treeMapCol_eq_map, List.getElem?_map] at h1
