/-! ## L4.2  First differences: the classifier, κ-transfer, path transfer, cap legality -/

-- SCR2 applied at integration: the bridge holds by `rfl`
theorem firstDiff_eq_def (rk : SrcRecord) : rk.firstDiff = firstDiffDef rk := by sorry

/-- L4.2: the part of a tree strictly before a position: the containing structure along `π`,
the columns `0 … j-1` of the forest at `π`, and (if `k = some k'`) the first `k'` entries of
column `j`. -/
def cutBefore {α : Type} : List (Nat × Nat) → Nat → Option Nat → Tree α → Tree α
  | [], j, none, .node cols => .node (cols.take j)
  | [], j, some k, .node cols => .node (cols.take j ++ [((cols[j]?).getD []).take k])
  | (ci, ii) :: rest, j, k, .node cols =>
    match cols[ci]? with
    | some col =>
      match col[ii]? with
      | some (l, h) => .node (cols.take ci ++ [col.take ii ++ [(l, cutBefore rest j k h)]])
      | none => .node cols
    | none => .node cols

-- provides: U3, L4.2 (meaning of the classifier)
theorem firstDiff_spec {rk : SrcRecord} (h : rk.Admitted) :
    (rk.firstDiff = .wholeEnds →
      rk.tgtKey.cols <+: rk.srcKey.cols ∧ rk.tgtKey.cols.length < rk.srcKey.cols.length) ∧
    (∀ π, rk.firstDiff = .childEnds π → ∃ ρ X Y, π = rk.b.heightPath ++ ρ ∧ ρ ≠ [] ∧
      rk.tgtKey.forestAt ρ = some X ∧ rk.srcKey.forestAt ρ = some Y ∧
      X.cols.length < Y.cols.length ∧
      cutBefore ρ X.cols.length none rk.tgtKey = cutBefore ρ X.cols.length none rk.srcKey) ∧
    (∀ c k p, rk.firstDiff = .capAt c k p → ∃ ρ, c.path = rk.b.heightPath ++ ρ ∧
      cutBefore ρ c.col (some k) rk.tgtKey = cutBefore ρ c.col (some k) rk.srcKey ∧
      (rk.tgtKey.colAt ⟨ρ, c.col⟩).isSome ∧
      ((rk.tgtKey.entryAt ⟨⟨ρ, c.col⟩, k⟩ = none ∧ ∃ l hs, rk.srcKey.entryAt ⟨⟨ρ, c.col⟩, k⟩ = some (l, hs) ∧
          p = labelAbs (rk.b.col.num 0) l) ∨
       (∃ l₁ h₁ l₂ h₂, rk.tgtKey.entryAt ⟨⟨ρ, c.col⟩, k⟩ = some (l₁, h₁) ∧
          rk.srcKey.entryAt ⟨⟨ρ, c.col⟩, k⟩ = some (l₂, h₂) ∧ keyLabelCmp l₁ l₂ = .lt ∧
          p = labelAbs (rk.b.col.num 0) l₂))) := by sorry

/-- L4.2a: the label map `κ` from source normalization (threshold `≥ r`) to target normalization
(threshold shifted by `t - r`): false fields below `r` are fixed, other false fields move by
`t - r`, true fields are fixed. -/
def kappa (r t : Nat) : Bool × Nat → Bool × Nat
  | (false, q) => if q < r then (false, q) else (false, q + (t - r))
  | (true, v) => (true, v)

-- provides: U3, L4.2a (`κ` is an order embedding of labels)
theorem kappa_cmp {r t : Nat} (h : r ≤ t) (x y : Bool × Nat) :
    keyLabelCmp (kappa r t x) (kappa r t y) = keyLabelCmp x y := by sorry

-- provides: U3, L4.2a (an order embedding of labels is an order embedding of keys)
theorem keyCmp_map {f : Bool × Nat → Bool × Nat} (hf : ∀ x y, keyLabelCmp (f x) (f y) = keyLabelCmp x y)
    (K K' : Key) : keyCmp (K.map f) (K'.map f) = keyCmp K K' := by sorry

-- provides: U3, L4.2a (common relative syntax: κ carries source keys to target keys)
theorem relKey_kappa {r t s : Nat} {X Y : Forest} (hrt : r ≤ t) (hrs : r ≤ s)
    (h : relKey r X = relKey t Y) : (relKey s X).map (kappa r t) = relKey (s + (t - r)) Y := by
  sorry

-- provides: U3, L4.2a (κ fixes keys normalized at or below `r`)
theorem relKey_kappa_low {r t s : Nat} (hsr : s ≤ r) (X : Forest) :
    (relKey s X).map (kappa r t) = relKey s X := by sorry

/-- L4.2b: the key list of a column cut after entry `u` with key `u` raised to `⊤`. -/
def cappedAt (ks : List (WithTop Key)) (u : Nat) : List (WithTop Key) := ks.take u ++ [⊤]

-- provides: U3, L4.2b (a capped same-parent block answers like one capped entry; txt:680-681)
theorem capped_block_resp (pre blk : List (WithTop Key)) (ppre : List Nat) (p : Nat)
    (W : List (WithTop Key)) (hW : ∀ y ∈ W, y ≠ ⊤) (hlen : ppre.length = pre.length) :
    (ppre ++ List.replicate (blk.length + 1) p)[Scan.cursor (pre ++ blk ++ [⊤]) W]? =
      (ppre ++ [p])[Scan.cursor (pre ++ [⊤]) W]? := by sorry

-- provides: U3, L4.2b (raising an unconsumed key and restoring later entries; txt:675-676)
theorem cursor_raise (pre : List (WithTop Key)) (x x' : WithTop Key) (post W : List (WithTop Key))
    (hxx' : x ≤ x') (hc : Scan.cursor (pre ++ [x]) W ≤ pre.length) :
    Scan.cursor (pre ++ x' :: post) W = Scan.cursor (pre ++ [x]) W := by sorry

-- provides: U3, L4.2c (path transfer: the new parent is on the target's actual cut chain)
theorem firstDiff_path {rk : SrcRecord} (h : rk.Admitted) {c : ColAddr} {k p : Nat}
    (hfd : rk.firstDiff = .capAt c k p) :
    Scan.Path rk.E (Scan.actualKeys rk.E) c (Scan.cutQuery (Scan.actualKeys rk.E c) k)
      (Scan.cutStart rk.E c k) p := by sorry

-- provides: U3, L4.2d (an upward literal cap on the actual cut chain is an ordinary V,I,S cap
-- with decorated A)
theorem cap_legal {E : Forest} (hE : IsStd E) {c : ColAddr} {k p : Nat} (hc : c ∈ E.colAddrs)
    (hdepth : c.path ≠ []) (hup : Closure.IsUpward E c k p)
    (hpath : Scan.Path E (Scan.actualKeys E) c (Scan.cutQuery (Scan.actualKeys E c) k)
      (Scan.cutStart E c k) p) :
    let K := Closure.litCap E c k p
    Scan.CondV K ∧ Scan.CondI K ∧ Scan.CondS K ∧
    Scan.CondAK K (Scan.capKeys K (Scan.routeCols K)) ∧ Scan.stepKind K = some .ordinary := by
  sorry

-- provides: U3, L4.2 (the spine's `firstDiff_cap`†; consumer: U5 L8.8 Case 3)
theorem firstDiff_cap {rk : SrcRecord} (h : rk.Admitted) {c : ColAddr} {k p : Nat}
    (hfd : rk.firstDiff = .capAt c k p) :
    let K := Closure.litCap rk.E c k p
    rk.b.heightPath <+: c.path ∧ c ∈ rk.E.colAddrs ∧ Closure.IsUpward rk.E c k p ∧
    Scan.CondV K ∧ Scan.CondI K ∧ Scan.CondS K ∧
    Scan.CondAK K (Scan.capKeys K (Scan.routeCols K)) ∧
    Scan.stepKind K = some .ordinary ∧
    Scan.Path rk.E (Scan.actualKeys rk.E) c (Scan.cutQuery (Scan.actualKeys rk.E c) k)
      (Scan.cutStart rk.E c k) p := by sorry

/-! ## L4.3  Source reduction -/

/-- L4.3a: an operation of `F` is confined to the marked height of `a`: the stopping column lies
inside that height and, for a special step, so does the owner entry (X-04). -/
def Confined (F : Forest) (a : EntryAddr) : Prop :=
  ∃ sd, Scan.stopData F = some sd ∧ a.heightPath <+: sd.col.path ∧
    (Scan.stepKind F = some .special → ∃ e, sd.ownerEntry = some e ∧ a.heightPath <+: e.col.path)

-- provides: U3, L4.3a (a confined operation only replaces the marked height, and decreases it)
theorem expand_confined {F F' : Forest} {a : EntryAddr} {k : Nat} (hF : Scan.InL F)
    (ha : a ∈ F.entryAddrs) (htr : F.truncAfter a = F) (hc : Confined F a)
    (hexp : expand F k = some F') :
    ∃ A'', F' = F.setHeight a A'' ∧ A'' < (F.heightAt a).getD Tree.empty := by sorry

-- provides: U3, L4.3a (a safe prefix cutting inside the marked height)
theorem safePrefix_inside {F : Forest} {a : EntryAddr} (ha : a ∈ F.entryAddrs)
    (htr : F.truncAfter a = F) {k : Nat}
    (hk : Scan.mu (F.setHeight a Tree.empty) ≤ k) :
    ∃ A'', Scan.safePrefix F k = F.setHeight a A'' ∧ A'' ≤ (F.heightAt a).getD Tree.empty := by
  sorry

/-- L4.3: scan records become descendant records after a source reduction. -/
def RecKind.toDesc {E : Forest} : RecKind E → RecKind E
  | .scan cap i j => .desc cap i j
  | k => k

-- provides: U3, L4.3 (the spine's `reduce_confined`†; consumers: U5 L8.8 Case 2, W)
theorem reduce_confined {rk : SrcRecord} (h : rk.Admitted) {A'' : Forest}
    (hle : A'' ≤ rk.srcHeight) (hL : Scan.InL (rk.F.setHeight rk.a A''))
    (hlt : rk.tgtKey < relKey (rk.a.col.num 0) A'') :
    ({ rk with F := rk.F.setHeight rk.a A'', kind := rk.kind.toDesc } : SrcRecord).Admitted := by
  sorry

-- provides: U3, L4.3c (the internal cap already satisfies H, so repairs are outside `B`)
theorem repair_moves_outside {rk : SrcRecord} (h : rk.Admitted) {c : ColAddr} {k p : Nat}
    (hfd : rk.firstDiff = .capAt c k p) (w : Closure.AdmCap rk.E)
    (hw : w.col = c ∧ w.cut = k ∧ w.par = p) : Closure.MovesOutside w.moves rk.b := by sorry

-- provides: U3, L4.3b ((6): the old target at the moved address is at least `B`)
-- [Changed in verification] adds the literal-cap form of the repaired cap (item 1), which
-- `repair_output` and `repair_output_exists` use.
theorem marked_height_mono {rk : SrcRecord} (h : rk.Admitted) {c : ColAddr} {k p : Nat}
    (hfd : rk.firstDiff = .capAt c k p) (w : Closure.AdmCap rk.E)
    (hw : w.col = c ∧ w.cut = k ∧ w.par = p) :
    let bm := Closure.moveAddr w.moves rk.b
    let c' : ColAddr := ⟨bm.heightPath ++ c.path.drop rk.b.heightPath.length, c.col⟩
    (w.H = Closure.litCap rk.E c' k p ∧ Closure.IsUpward rk.E c' k p ∧
      bm.col.num 0 = rk.b.col.num 0) ∧
    bm ∈ rk.E.entryAddrs ∧
    rk.tgtHeight ≤ (rk.E.heightAt bm).getD Tree.empty := by sorry

-- provides: U3, L4.3 (the spine's `repair_output`†; consumer: U5 L8.8 Case 3)
theorem repair_output {rk : SrcRecord} (h : rk.Admitted) {c : ColAddr} {k p : Nat}
    (hfd : rk.firstDiff = .capAt c k p) (w : Closure.AdmCap rk.E)
    (hw : w.col = c ∧ w.cut = k ∧ w.par = p) {n : Nat} {Hk : Forest}
    (hexp : expand w.H n = some Hk) (habove : rk.E < Hk) :
    let bm := Closure.moveAddr w.moves rk.b
    bm ∈ Hk.entryAddrs ∧ Hk.truncAfter bm = Hk ∧
    (rk.E.heightAt bm).getD Tree.empty < (Hk.heightAt bm).getD Tree.empty ∧
    rk.tgtHeight < (Hk.heightAt bm).getD Tree.empty ∧
    ({ E := rk.E, b := rk.b, F := Hk.truncAfter bm, a := bm, kind := .repair w.moves } :
      SrcRecord).Admitted := by
  sorry

-- provides: U3, L4.3 (cofinality supplies a positive output above `E`)
theorem repair_output_exists {rk : SrcRecord} (h : rk.Admitted) {c : ColAddr} {k p : Nat}
    (hfd : rk.firstDiff = .capAt c k p) (w : Closure.AdmCap rk.E)
    (hw : w.col = c ∧ w.cut = k ∧ w.par = p) :
    ∃ n Hk, 1 ≤ n ∧ expand w.H n = some Hk ∧ rk.E < Hk := by sorry

-- provides: U3, L4.3 (the spine's `query_size_bound`†, (7); consumer: U5 L8.8 Case 3)
theorem query_size_bound {rk : SrcRecord} (h : rk.Admitted) {c : ColAddr} {k p : Nat}
    (hfd : rk.firstDiff = .capAt c k p) (w : Closure.AdmCap rk.E)
    (hw : w.col = c ∧ w.cut = k ∧ w.par = p) {sd : Scan.StopData}
    (hsd : Scan.stopData w.H = some sd) :
    sd.Q.length = k ∧
    (∀ j < sd.Q.length,
      w.origin (.slot ⟨sd.col, j⟩) = some (.slot ⟨c, j⟩) ∧
      rk.b.heightPath <+: c.path ∧ (rk.E.heightAt ⟨c, j⟩) = (sd.Q[j]?).map Prod.snd) ∧
    ∀ J ∈ sd.Q, J.2.size + 2 ≤ rk.tgtHeight.size := by sorry

-- provides: U3, L4.3 (the spine's `reduce_childEnds`†; consumer: U5 L8.8 Case 2)
theorem reduce_childEnds {rk : SrcRecord} (h : rk.Admitted) {π : List (Nat × Nat)}
    (hfd : rk.firstDiff = .childEnds π) :
    ∃ A₁ : Forest,
      Scan.InL (rk.F.setHeight rk.a A₁) ∧ A₁ ≤ rk.srcHeight ∧ rk.tgtKey < relKey (rk.a.col.num 0) A₁ ∧
      (rk.F.setHeight rk.a A₁).roles <+: rk.F.roles ∧
      (∀ x ∈ graph (rk.F.setHeight rk.a A₁), x ∈ graph rk.F) ∧
      Confined (rk.F.setHeight rk.a A₁) rk.a ∧
      ((Scan.stepKind (rk.F.setHeight rk.a A₁) = some .special) ∨
        (Scan.stepKind (rk.F.setHeight rk.a A₁) = some .ordinary ∧
          ∃ sd rd, Scan.stopData (rk.F.setHeight rk.a A₁) = some sd ∧ sd.Q = [] ∧
            Scan.rootData (rk.F.setHeight rk.a A₁) = some rd ∧ rk.a.heightPath <+: rd.col.path)) ∧
      ∃ (k : Nat) (A₂ : Forest),
        expand (rk.F.setHeight rk.a A₁) k = some (rk.F.setHeight rk.a A₂) ∧
        rk.tgtKey < relKey (rk.a.col.num 0) A₂ ∧ A₂ < rk.srcHeight ∧
        ({ rk with F := rk.F.setHeight rk.a A₂, kind := rk.kind.toDesc } : SrcRecord).Admitted := by
  sorry

/-! ## D7.2c  Fresh names -/

/-- D7.2c: the instance tag of a name (`0` for auxiliary names). -/
def tagOf : Name → Nat
  | .role t _ => t
  | .aux _ => 0

/-- D7.2c: a tag above every tag of a finite list of names. -/
def freshTag (ns : List Name) : Nat := (ns.map tagOf).foldr max 0 + 1

-- provides: U3, D7.2c
theorem freshTag_fresh (ns : List Name) (r : Role) : Name.role (freshTag ns) r ∉ ns := by sorry

/-! ## L7.3  Factorization -/

-- L7.3: the spine's `factorization` (SCR1 applied at integration: hypothesis `ha` added);
-- the former local workaround `factorization_mem` is removed.

-- provides: U3, L7.3b (the converse direction: a target block gives a realization of the
-- positive block above the floor)
theorem targetAbove_blockAbove {P : Prims.{u}} (pk : SourcePacket.{u}) {L : Ordinal.{u}}
    (h : pk.TargetAbove P L) :
    BlockAbove P (posBlock pk.rk.tgtKey pk.rk.tgtSel)
      (fun w => (pk.tgtFrame.toFr w).map pk.asg) L (pk.asg pk.owner) := by sorry

-- provides: U3, L7.3a ((23): the failure label in the grammar; consumer: U5 L8.8)
theorem factorization_noB {P : Prims.{u}} (pk : SourcePacket.{u}) (hv : pk.Valid P)
    (ha : pk.rk.a ∈ pk.rk.F.entryAddrs) {L : Ordinal.{u}} (hL : L < pk.asg pk.owner)
    (hfail : ¬ pk.TargetAbove P L) (ℓ : Name) (hℓ : ℓ ≠ pk.owner)
    (hℓf : ℓ ∉ (baseVars (posBlock pk.rk.tgtKey pk.rk.tgtSel)).filterMap pk.tgtFrame.toFr) :
    ∃ Ls, L ≤ Ls ∧ Ls < pk.asg pk.owner ∧ (∀ x ∈ pk.lowNames, pk.asg x < Ls) ∧
      (noB pk.rk.tgtKey pk.rk.tgtSel pk.tgtFrame pk.owner ℓ).Holds P
        (Function.update pk.asg ℓ Ls) := by sorry

/-! ## L7.4  Joint cap -/

/-- L7.4: the chart `κ` of the first-difference cap: the target prefix chart before `U_b`, and the
source chart of the corresponding source role (through `b ↦ a`) from `U_b` on (owner, common
internal prefix, closing slot). -/
def capChart (pk : SourcePacket.{u}) (y : Role) : Name :=
  if y ∈ prefixRoles pk.rk.E pk.rk.b then pk.tgtChart y
  else pk.srcChart (transEntry pk.rk.b pk.rk.a y)

-- provides: U3, L7.4 (the spine's `joint_cap`†; consumer: U5 L8.8 Case 3)
theorem joint_cap {P : Prims.{u}} (pk : SourcePacket.{u}) (hadm : pk.rk.Admitted) (hv : pk.Valid P)
    {c : ColAddr} {k p : Nat} (hfd : pk.rk.firstDiff = .capAt c k p) :
    let K := Closure.litCap pk.rk.E c k p
    let κ := capChart pk
    IsConfig P K (pk.asg ∘ κ) ∧
    (∀ y ∈ prefixRoles pk.rk.E pk.rk.b, κ y = pk.tgtChart y) ∧ κ (.slot pk.rk.b) = pk.owner ∧
    (∀ y ∈ K.roles, y ∉ prefixRoles pk.rk.E pk.rk.b →
      κ y = pk.srcChart (transEntry pk.rk.b pk.rk.a y)) ∧
    pk.asg pk.owner < pk.asg (κ (.ord c)) ∧ pk.asg (κ (.ord c)) < pk.asg (κ (.slot ⟨c, k⟩)) ∧
    (∀ y ∈ rolesBefore K (.ord c), pk.asg (κ y) < pk.asg (κ (.ord c))) ∧
    (∀ x ∈ pk.lowNames, pk.asg x < pk.asg (κ (.ord c))) ∧
    BaseHolds P ((restrictTo (graph pk.rk.E) (rolesBefore pk.rk.E (.ord c))).map (BaseAtom.map κ))
      pk.asg := by sorry

/-! ## L7.5  Joint repair, frame survival, readmission (closure of the packet class) -/

/-- L7.5: the roles of the repaired cap read in the literal cap: the origin in `E` (same address
in `litCap`), and the closing slot `⟨c, k⟩` for the appended closing entry. -/
def capRole {E : Forest} (w : Closure.AdmCap E) (x : Role) : Role :=
  (w.origin x).getD (.slot ⟨w.col, w.cut⟩)

-- provides: U3, L7.5a (the whole external frame survives same-parent repairs)
theorem frame_repair {E : Forest} (hE : IsStd E) (w : Closure.AdmCap E) {b : EntryAddr}
    (hb : b ∈ E.entryAddrs) (hbc : b.heightPath <+: w.col.path)
    (hout : Closure.MovesOutside w.moves b) :
    let bm := Closure.moveAddr w.moves b
    (frameOf bm).map (capRole w) = frameOf b ∧ capRole w (.slot bm) = .slot b ∧
    (∀ x ∈ prefixRoles w.H bm, capRole w x ∈ prefixRoles E b) ∧
    Set.InjOn (capRole w) {x | x ∈ prefixRoles w.H bm} := by sorry

-- provides: U3, L7.5 (the spine's `joint_repair`†; consumer: U5 L8.8 Case 3)
theorem joint_repair {P : Prims.{u}} (pk : SourcePacket.{u}) (hadm : pk.rk.Admitted)
    (hv : pk.Valid P) {c : ColAddr} {k p : Nat} (hfd : pk.rk.firstDiff = .capAt c k p)
    (w : Closure.AdmCap pk.rk.E) (hw : w.col = c ∧ w.cut = k ∧ w.par = p) :
    let κ := capChart pk
    let bm := Closure.moveAddr w.moves pk.rk.b
    let α := pk.asg ∘ κ ∘ capRole w
    IsConfig P w.H α ∧
    α (.slot bm) = pk.asg pk.owner ∧ α (.ord bm.col) = pk.asg pk.host ∧
    (frameOf bm).map (κ ∘ capRole w) = pk.tgtFrame ∧
    (∀ x ∈ prefixRoles w.H bm, κ (capRole w x) = pk.tgtChart (capRole w x)) ∧
    (∀ sd, Scan.stopData w.H = some sd →
      α (.ord sd.col) = pk.asg (κ (.ord c)) ∧
      α (.slot (Scan.closingSlot sd)) = pk.asg (κ (.slot ⟨c, k⟩)) ∧
      ∀ x ∈ rolesBefore w.H (.ord sd.col), α x < α (.ord sd.col)) ∧
    (∀ x y, Closure.anchorOrigin pk.rk.E (some w) x = some y → κ y = κ (capRole w x)) := by sorry

namespace SourcePacket

variable (pk : SourcePacket.{u})

/-- D7.2c: every name of a packet whose value is fixed by readmission. -/
def usedNames : List Name := pk.lowNames ++ [pk.owner]

end SourcePacket

/-- L7.5b: readmission after a confined source reduction (§8.5 Case 2): same target data, same
source prefix, the marked slot and its new height under fresh names with values `δ`. -/
noncomputable def readmitHeight (pk : SourcePacket.{u}) (F' : Forest) (kind' : RecKind pk.rk.E)
    (δ : Role → Ordinal.{u}) : SourcePacket.{u} :=
  let tg := freshTag pk.usedNames
  { rk := { pk.rk with F := F', kind := kind' }
    tgtChart := pk.tgtChart
    srcChart := fun x => if x ∈ prefixRoles pk.rk.F pk.rk.a then pk.srcChart x else .role tg x
    aux := pk.aux
    asg := fun nm => match nm with
      | .role t x => if t = tg then δ x else pk.asg nm
      | .aux _ => pk.asg nm }

-- provides: U3, L7.5b (closure of the packet class under §8.5 Case 2; consumer: U5 L8.8)
theorem readmit_height {P : Prims.{u}} (pk : SourcePacket.{u}) (hadm : pk.rk.Admitted)
    (hv : pk.Valid P) {A'' : Forest} (kind' : RecKind pk.rk.E)
    (hadm' : ({ pk.rk with F := pk.rk.F.setHeight pk.rk.a A'', kind := kind' } : SrcRecord).Admitted)
    (δ : Role → Ordinal.{u})
    (hgraph : BaseHolds P (graph (pk.rk.F.setHeight pk.rk.a A''))
      (fun x => if x ∈ prefixRoles pk.rk.F pk.rk.a then pk.asg (pk.srcChart x) else δ x))
    (hheads : ∃ o v, pk.tgtFrame.reps[pk.rk.tgtSel]? = some (o, v) ∧
      P.Edge (δ (.slot pk.rk.a)) (pk.asg pk.host) (pk.asg o) ∧
      P.Edge (δ (.slot pk.rk.a)) (pk.asg pk.host) (pk.asg v))
    (hlow : ∀ x ∈ pk.lowNames, pk.asg x < δ (.slot pk.rk.a)) :
    let pk' := readmitHeight pk (pk.rk.F.setHeight pk.rk.a A'') kind' δ
    pk'.rk.Admitted ∧ pk'.Valid P ∧ pk'.asg pk'.owner = δ (.slot pk.rk.a) ∧
    pk'.host = pk.host ∧ pk'.tgtFrame = pk.tgtFrame ∧ pk'.lowNames = pk.lowNames ∧
    (∀ x ∈ pk.lowNames, pk'.asg x = pk.asg x) ∧ pk'.rk.tgtKey = pk.rk.tgtKey ∧
    pk'.rk.tgtSel = pk.rk.tgtSel := by sorry

/-- L7.5c: readmission after the repaired-cap descent (§8.5 Case 3): a repair record for the
original target; the source prefix is the surviving restriction of the target prefix (names
`tgtChart ∘ capRole`); the marked slot and height of the output get fresh names with values `γ`;
all old names get the values `b'`. -/
noncomputable def readmitRepair (pk : SourcePacket.{u}) (w : Closure.AdmCap pk.rk.E) (Hk : Forest)
    (γ : Role → Ordinal.{u}) (b' : Name → Ordinal.{u}) : SourcePacket.{u} :=
  let tg := freshTag pk.usedNames
  let bm := Closure.moveAddr w.moves pk.rk.b
  { rk := { E := pk.rk.E, b := pk.rk.b, F := Hk.truncAfter bm, a := bm, kind := .repair w.moves }
    tgtChart := pk.tgtChart
    srcChart := fun x =>
      if x ∈ prefixRoles (Hk.truncAfter bm) bm then pk.tgtChart (capRole w x) else .role tg x
    aux := pk.aux
    asg := fun nm => match nm with
      | .role t x => if t = tg then γ x else b' nm
      | .aux _ => b' nm }

-- provides: U3, L7.5c (closure of the packet class under §8.5 Case 3; consumer: U5 L8.8)
theorem readmit_repair {P : Prims.{u}} (pk : SourcePacket.{u}) (hadm : pk.rk.Admitted)
    (hv : pk.Valid P) {c : ColAddr} {k p : Nat} (hfd : pk.rk.firstDiff = .capAt c k p)
    (w : Closure.AdmCap pk.rk.E) (hw : w.col = c ∧ w.cut = k ∧ w.par = p)
    {n : Nat} {Hk : Forest} (hexp : expand w.H n = some Hk) (habove : pk.rk.E < Hk)
    (γ : Role → Ordinal.{u}) (b' : Name → Ordinal.{u})
    (hsrc : BaseHolds P (graph (Hk.truncAfter (Closure.moveAddr w.moves pk.rk.b))) γ)
    (hshare : ∀ x ∈ prefixRoles w.H (Closure.moveAddr w.moves pk.rk.b),
      γ x = b' (pk.tgtChart (capRole w x)))
    (htgt : BaseHolds P ((prefixGraph pk.rk.E pk.rk.b).map (BaseAtom.map pk.tgtChart)) b')
    (haux : pk.aux.Holds P b')
    (hheads : ∃ o v, pk.tgtFrame.reps[pk.rk.tgtSel]? = some (o, v) ∧
      P.Edge (γ (.slot (Closure.moveAddr w.moves pk.rk.b))) (b' pk.host) (b' o) ∧
      P.Edge (γ (.slot (Closure.moveAddr w.moves pk.rk.b))) (b' pk.host) (b' v))
    (hlow : ∀ x ∈ pk.lowNames, b' x < γ (.slot (Closure.moveAddr w.moves pk.rk.b))) :
    let bm := Closure.moveAddr w.moves pk.rk.b
    let pk' := readmitRepair pk w Hk γ b'
    pk'.rk.Admitted ∧ pk'.Valid P ∧ pk'.asg pk'.owner = γ (.slot bm) ∧ pk'.host = pk.host ∧
    pk'.tgtFrame = pk.tgtFrame ∧ (∀ x ∈ pk.lowNames, pk'.asg x = b' x) ∧
    pk'.rk.tgtKey = pk.rk.tgtKey ∧ pk'.rk.tgtSel = pk.rk.tgtSel ∧ pk'.rk.E = pk.rk.E ∧
    pk'.rk.b = pk.rk.b := by sorry

-- SCR2 applied at integration: the bridge holds by `rfl`
theorem ScanSetup.valid_iff_def (S : ScanSetup.{u}) (P : Prims.{u}) :
    S.Valid P ↔ S.ValidDef P := by sorry

/-! ## L7.6a  The explicit packet at a scan state and the fitting extension -/

namespace ScanSetup

variable (S : ScanSetup.{u})

/-- L7.6a: names already used by the setup (target prefix, `ρ`, bank, auxiliary data). -/
def usedNames : List Name :=
  S.PE.map S.ePre ++ [S.stopNm] ++ S.bankRoles.map S.bankNm ++ S.aux.vars

/-- L7.6a: the fresh tag of the fitted target names. -/
def fitTag : Nat := freshTag S.usedNames

/-- L7.6a: the stopping column of the anchor read in `E`. -/
def cE : ColAddr := match S.TE with
  | .ord c => c
  | .slot _ => S.sd.col

/-- L7.6a: a role of `E` inside the query column, read in `H`. -/
def toH (y : Role) : Role := transColumn S.cE S.sd.col id y

/-- L7.6a: the target chart of the scan packet: `ePre` on `P_E`, `ρ` on `T_E`, fresh fitted names
on the earlier query entries. -/
def pkTgtChart (y : Role) : Name :=
  if y ∈ S.PE then S.ePre y else if y = S.TE then S.stopNm else .role S.fitTag (S.toH y)

/-- L7.6a: the source chart of the scan packet: the shared pre-root chart, `ρ` on `R`, the bank. -/
def pkSrcChart (x : Role) : Name :=
  if x ∈ S.preRoot then S.ePre (S.chi x) else if x = S.R then S.stopNm else S.bankNm x

/-- L7.6a: the joint assignment: fitted names read `β`, all other names keep the setup's values. -/
noncomputable def pkAsg (β : Role → Ordinal.{u}) (nm : Name) : Ordinal.{u} :=
  match nm with
  | .role tg x => if tg = S.fitTag then β x else S.asg nm
  | .aux _ => S.asg nm

/-- L7.6a: the complete source packet at scan state `(i, j)`. -/
noncomputable def scanPacket (i j : Nat) (β : Role → Ordinal.{u}) : SourcePacket.{u} :=
  { rk := S.scanRecord i j, tgtChart := S.pkTgtChart, srcChart := S.pkSrcChart, aux := S.aux,
    asg := S.pkAsg β }

/-- L7.6a: the fitting of query entry `j` read off a target block `γ`. -/
noncomputable def extendFit (j : Nat) (β : Role → Ordinal.{u}) (γ : BlkVar → Ordinal.{u})
    (x : Role) : Ordinal.{u} :=
  if x ∈ S.entryRoles j then
    (if x = .slot ⟨S.sd.col, j⟩ then γ .owner
      else γ (.inner (relRole (EntryAddr.heightPath ⟨S.sd.col, j⟩) x)))
  else β x

end ScanSetup

-- provides: U3, L7.6a (explicit form of the spine's `scan_packet`)
theorem scanPacket_spec {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) {i j : Nat}
    (hij : Scan.ReachesGT (Scan.rootKeys S.H S.rd) (Scan.queryKeys S.sd) i j)
    {β : Role → Ordinal.{u}} (hfit : S.Fitted P j β) (h17a : S.Lmax j β < S.ownerVal i)
    (hheads : S.HeadsAt P j i β) :
    let pk := S.scanPacket i j β
    pk.rk = S.scanRecord i j ∧ pk.rk.Admitted ∧ pk.Valid P ∧ pk.asg pk.owner = S.ownerVal i ∧
    ∀ L, S.Lmax j β ≤ L → ∀ γ : BlkVar → Ordinal.{u},
      (∀ w x, pk.tgtFrame.toFr w = some x → γ w = pk.asg x) →
      (∀ w ∈ baseVars (posBlock pk.rk.tgtKey pk.rk.tgtSel), pk.tgtFrame.toFr w = none →
        L < γ w ∧ ∀ x ∈ pk.lowNames, pk.asg x < γ w) →
      (∀ w ∈ baseVars (posBlock pk.rk.tgtKey pk.rk.tgtSel), γ w < pk.asg pk.owner) →
      BaseHolds P (posBlock pk.rk.tgtKey pk.rk.tgtSel) γ →
      S.Fitted P (j + 1) (S.extendFit j β γ) ∧ (∀ x ∈ S.fittedRoles j, S.extendFit j β γ x = β x) ∧
      ∀ x ∈ S.entryRoles j, L < S.extendFit j β γ x ∧ S.extendFit j β γ x < S.ownerVal i := by
  sorry

/-! ## Integration additions (nodes D7.1b, L6.2e, L6.2f, D7.2d, L7.6b, L4.3d, L7.5d; requested
by U5 R10, R18, R19, R22, R23, R25–R27, R29, R30; formerly stubs in `U5.lean`) -/

-- provides: U3, D7.1b (requested by U5 R18, second conjunct): the block map agrees with the frame
-- of `e` on every frame variable.
theorem blockMap_frame (e : EntryAddr) :
    ∀ w x, (frameOf e).toFr w = some x → blockMap e w = x := by sorry

-- provides: U3, D7.1b (requested by U5 R10): every number below a column's printed number is
-- visible, so `reps0` has one pair per number, and `reps0[q]? = rep 0 q`.
theorem reps0_length (c : ColAddr) : c.reps0.length = c.num 0 := by sorry

theorem reps0_getElem? (c : ColAddr) (q : Nat) : c.reps0[q]? = c.rep 0 q := by sorry

-- provides: U3, D7.1b (requested by U5 R10): a column whose stack passes through column `c` sees
-- `c`'s frame below `c`'s number.
theorem reps0_take {c d : ColAddr} (h : d.resolve 0 (c.num 0) = some c) :
    d.reps0.take (c.num 0) = c.reps0 := by sorry

-- provides: U3, D7.1b (requested by U5 R19): frame roles lie in the prefix `P(E, e)`.
theorem frameOf_mem_prefix {E : Forest} {e : EntryAddr} (he : e ∈ E.entryAddrs) :
    Role.ord e.col ∈ prefixRoles E e ∧
      ∀ ov ∈ e.col.reps0, ov.1 ∈ prefixRoles E e ∧ ov.2 ∈ prefixRoles E e := by sorry

-- provides: U3, L6.2e (requested by U5 R22, stage zero): `H[0]` is the restriction to `P`, and
-- `f_0` is the identity on `D`.
theorem stage_zero {H : Forest} (hL : Scan.InL H) {rs : RoleSets} (hrs : roleSets H = some rs)
    {G : Forest} (hG : expand H 0 = some G) :
    G.roles = rs.P ∧ (∀ a ∈ graph G, a ∈ graph H) ∧ ∀ x ∈ rs.D, fMap H 0 0 x = x := by sorry

-- provides: U3, L6.2e (requested by U5 R22, one stage): roles and elementarity atoms of `H[m+1]`
-- from `H[m]`.
theorem stage_succ {H : Forest} (hL : Scan.InL H) {rs : RoleSets} (hrs : roleSets H = some rs)
    {m : Nat} {G G' : Forest} (hG : expand H m = some G) (hG' : expand H (m + 1) = some G') :
    G'.roles = G.roles ++ (fMap H (m + 1) (m + 1) rs.R ::
      (rs.Q.map (qMap H (m + 1) (m + 1)) ++ rs.K.map (fMap H (m + 1) (m + 1)))) ∧
    qMap H (m + 1) (m + 1) rs.T = fMap H (m + 1) (m + 1) rs.R ∧
    (∀ x ∈ rs.D, qMap H (m + 1) (m + 1) x = fMap H m m x) ∧
    (∀ x ∈ rolesBefore H rs.R, fMap H (m + 1) (m + 1) x = x) ∧
    ∀ a ∈ graph G', isStruct a = true → a ∈ graph G ∨
      (∃ a' ∈ queryAtoms H rs, isStruct a' = true ∧ a = a'.map (qMap H (m + 1) (m + 1))) ∨
      (∃ a' ∈ retAtoms H rs, a = a'.map (fMap H (m + 1) (m + 1))) := by sorry

-- provides: U3, L6.2e (requested by U5 R23, txt:941): structural query atoms read only
-- `D ∪ {T} ∪ Q`.
theorem queryAtoms_struct_vars {H : Forest} (hL : Scan.InL H) {rs : RoleSets}
    (hrs : roleSets H = some rs) :
    ∀ a ∈ queryAtoms H rs, isStruct a = true → ∀ v ∈ a.vars,
      v ∈ rs.D ∨ v = rs.T ∨ v ∈ rs.Q := by sorry

-- provides: U3, L6.2f (requested by U5 R27): roles and elementarity atoms of a special output:
-- the prefix `P(H, e)` and `N = n + ε` copies of the shortened positive block.
theorem special_graph {H : Forest} (hL : Scan.InL H) (hk : Scan.stepKind H = some .special)
    {sd : Scan.StopData} {e : EntryAddr} (hsd : Scan.stopData H = some sd)
    (he : sd.ownerEntry = some e) {k : Nat} {H' : Forest} (hH' : expand H k = some H') :
    ∃ (N : Nat) (cm : Nat → BlkVar → Role),
      H'.roles = prefixRoles H e ++ (List.range N).flatMap (fun i =>
        (BlkVar.owner :: (specialKey H e).roles.map BlkVar.inner).map (cm i)) ∧
      (∀ i w x, (frameOf e).toFr w = some x → cm i w = x) ∧
      ∀ a ∈ graph H', isStruct a = true →
        (a ∈ graph H ∧ ∀ v ∈ a.vars, v ∈ prefixRoles H e) ∨
        ∃ i < N, ∃ a' ∈ posBlock (specialKey H e) (entrySel H e), a = a'.map (cm i) := by sorry

-- provides: U3, D7.2d (requested by U5 R25): the target of the scan record at `(i, j)` is query
-- entry `j`'s height.
theorem scanRecord_tgtHeight {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) {i j : Nat}
    (hj : j < S.sd.Q.length) :
    (S.scanRecord i j).tgtHeight = ((S.sd.Q[j]?).map Prod.snd).getD Tree.empty := by sorry

-- provides: U3, L7.6b (requested by U5 R26, target advance txt:1160-1162): a positive block of query
-- entry `j` above `L ≥ L_j` at the fitted frame extends a fitting by entry `j`.
theorem fit_of_block {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) {j : Nat}
    (hj : j < S.sd.Q.length) {β : Role → Ordinal.{u}} (hfit : S.Fitted P j β)
    {L : Ordinal.{u}} (hL : S.Lmax j β ≤ L) {βb : BlkVar → Ordinal.{u}}
    (hfr : ∀ w x, (frameOf ⟨S.sd.col, j⟩).toFr w = some x → βb w = S.fitVal β x)
    (hnew : ∀ w ∈ baseVars (posBlock (((Scan.queryKeys S.sd)[j]?).getD Tree.empty)
        (((S.sd.Q[j]?).map Prod.fst).getD 0)),
      (frameOf ⟨S.sd.col, j⟩).toFr w = none → L < βb w)
    (hholds : BaseHolds P (posBlock (((Scan.queryKeys S.sd)[j]?).getD Tree.empty)
        (((S.sd.Q[j]?).map Prod.fst).getD 0)) βb) :
    ∃ β', S.Fitted P (j + 1) β' ∧ (∀ x ∈ S.fittedRoles j, β' x = β x) ∧
      ∀ x ∈ S.entryRoles j, ∃ w ∈ baseVars (posBlock (((Scan.queryKeys S.sd)[j]?).getD Tree.empty)
          (((S.sd.Q[j]?).map Prod.fst).getD 0)),
        (frameOf ⟨S.sd.col, j⟩).toFr w = none ∧ β' x = βb w := by sorry

/-- L4.3d (moved from U5 `Req.ChildData`; requested by U5 R29): the data of §8.5 Case 2
(txt:1364-1368): a safe truncation `F₁` of the source context, a confined step of it, and the
admitted record of its output. -/
structure ChildData (pk : SourcePacket.{u}) where
  F₁ : Forest
  k : Nat
  F₂ : Forest
  sd₁ : Scan.StopData
  kind' : RecKind pk.rk.E
  inL : Scan.InL F₁
  roles_pre : F₁.roles <+: pk.rk.F.roles
  graph_sub : ∀ a ∈ graph F₁, a ∈ graph pk.rk.F
  stop : Scan.stopData F₁ = some sd₁
  stop_inside : (Role.ord sd₁.col).inEntry pk.rk.a = true
  step : expand F₁ k = some F₂
  branch : (Scan.stepKind F₁ = some .ordinary ∧ sd₁.Q = [] ∧
      ∃ rd₁, Scan.rootData F₁ = some rd₁ ∧ (Role.ord rd₁.col).inEntry pk.rk.a = true) ∨
    (Scan.stepKind F₁ = some .special ∧
      ∃ e, sd₁.ownerEntry = some e ∧ (Role.slot e).inEntry pk.rk.a = true ∧ e ≠ pk.rk.a)
  persist : prefixRoles F₂ pk.rk.a = prefixRoles pk.rk.F pk.rk.a
  admitted : ({ E := pk.rk.E, b := pk.rk.b, F := F₂, a := pk.rk.a, kind := kind' } :
    SrcRecord).Admitted

-- provides: U3, L4.3d (requested by U5 R29): the Case 2 data exist.
theorem childEnds_package (pk : SourcePacket.{u}) (hadm : pk.rk.Admitted)
    {π : List (Nat × Nat)} (hfd : pk.rk.firstDiff = .childEnds π) : Nonempty (ChildData pk) := by
  sorry

/-- L7.5d (moved from U5 `Req.CapData`; requested by U5 R30): the data of §8.5 Case 3: the repaired
first-difference cap, the charts of its `E`-prefix and of `Γ(H)`, an extended assignment, the
marked entry's survival, and readmission of the repair records. -/
structure CapData (P : Prims.{u}) (pk : SourcePacket.{u}) where
  w : Closure.AdmCap pk.rk.E
  sd : Scan.StopData
  rd : Scan.RootData
  nm : Role → Name
  nmH : Role → Name
  asg' : Name → Ordinal.{u}
  ordinary : Scan.stepKind w.H = some .ordinary
  stop : Scan.stopData w.H = some sd
  root : Scan.rootData w.H = some rd
  qsize : ∀ J ∈ sd.Q, J.2.size + 2 ≤ pk.rk.tgtHeight.size
  nm_tgt : ∀ y ∈ prefixRoles pk.rk.E pk.rk.b, nm y = pk.tgtChart y
  nm_owner : nm (.slot pk.rk.b) = pk.owner
  pre_sub : ∀ y ∈ prefixRoles pk.rk.E pk.rk.b, y ∈ ePrefix pk.rk.E (some w) sd
  nm_inj : Set.InjOn nm {y | y ∈ ePrefix pk.rk.E (some w) sd}
  nmH_inj : Set.InjOn nmH {x | x ∈ w.H.roles}
  compat : ∀ x ∈ rolesBefore w.H (.ord sd.col), ∀ y, w.origin x = some y → nmH x = nm y
  asg_old : ∀ x, x ∈ pk.lowNames ∨ x = pk.owner → asg' x = pk.asg x
  config : IsConfig P w.H (asg' ∘ nmH)
  ePrefix_holds : BaseHolds P (restrictTo (graph pk.rk.E) (ePrefix pk.rk.E (some w) sd))
    (asg' ∘ nm)
  ePrefix_below : ∀ y ∈ ePrefix pk.rk.E (some w) sd, asg' (nm y) < asg' (nmH (.ord sd.col))
  marked_mem : Closure.moveAddr w.moves pk.rk.b ∈ w.H.entryAddrs
  marked_slot : w.origin (.slot (Closure.moveAddr w.moves pk.rk.b)) = some (.slot pk.rk.b)
  marked_host : w.origin (.ord (Closure.moveAddr w.moves pk.rk.b).col) = some (.ord pk.rk.b.col)
  marked_prefix : ∀ x ∈ prefixRoles w.H (Closure.moveAddr w.moves pk.rk.b),
    ∃ y ∈ prefixRoles pk.rk.E pk.rk.b, w.origin x = some y
  marked_frame : ((frameOf (Closure.moveAddr w.moves pk.rk.b)).map nmH).reps = pk.tgtFrame.reps
  stop_inside : (Role.ord sd.col).inEntry (Closure.moveAddr w.moves pk.rk.b) = true
  owner_lt : pk.asg pk.owner < asg' (nmH (.ord sd.col))
  readmit : ∀ k H', expand w.H k = some H' → pk.rk.E < H' →
    ({ E := pk.rk.E, b := pk.rk.b, F := H'.truncAfter (Closure.moveAddr w.moves pk.rk.b),
       a := Closure.moveAddr w.moves pk.rk.b, kind := .repair w.moves } : SrcRecord).Admitted

