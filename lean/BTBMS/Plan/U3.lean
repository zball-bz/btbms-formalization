/-! ## D7.2c  Fresh names -/

/-- D7.2c: the instance tag of a name (`0` for auxiliary names). -/
def tagOf : Name → Nat
  | .role t _ => t
  | .aux _ => 0

/-- D7.2c: a tag above every tag of a finite list of names. -/
def freshTag (ns : List Name) : Nat := (ns.map tagOf).foldr max 0 + 1

-- provides: U3, D7.2c
theorem freshTag_fresh (ns : List Name) (r : Role) : Name.role (freshTag ns) r ∉ ns := by
  intro h
  have hle : ∀ (l : List Nat) (x : Nat), x ∈ l → x ≤ l.foldr max 0 := by
    intro l
    induction l with
    | nil => simp
    | cons y l ih =>
      intro x hx
      rcases List.mem_cons.1 hx with rfl | hx
      · exact le_max_left _ _
      · exact (ih x hx).trans (le_max_right _ _)
  have := hle (ns.map tagOf) (tagOf (Name.role (freshTag ns) r)) (List.mem_map_of_mem h)
  simp only [tagOf, freshTag] at this
  omega

/-! ## L7.3  Factorization -/

-- L7.3: the spine's `factorization` (SCR1 applied at integration: hypothesis `ha` added);
-- the former local workaround `factorization_mem` is removed.

-- provides: U3, L7.3 (factorization; hypothesis `ha` added by SCR1 of U3, applied at integration)
-- Moved here from `Plan/Spine.lean` (brief rule 5; name and statement unchanged): the proof uses
-- N3.1 `pack_below`; nothing between the spine and this point uses it.
theorem factorization {P : Prims.{u}} (pk : SourcePacket.{u}) (hv : pk.Valid P)
    (ha : pk.rk.a ∈ pk.rk.F.entryAddrs) {L : Ordinal.{u}} (hL : L < pk.asg pk.owner) :
    ∃ Ls, L ≤ Ls ∧ Ls < pk.asg pk.owner ∧ (∀ x ∈ pk.lowNames, pk.asg x < Ls) ∧
      (BlockAbove P (posBlock pk.rk.tgtKey pk.rk.tgtSel)
          (fun w => (pk.tgtFrame.toFr w).map pk.asg) Ls (pk.asg pk.owner) →
        pk.TargetAbove P L) := by
  obtain ⟨-, -, -, -, hj, -, hlow⟩ := hv
  -- the owner is a limit: `Lim (U_a)` is an atom of `Γ(F)`
  have hslot : Role.slot pk.rk.a ∈ pk.rk.F.roles := by
    rw [Tree.entryAddrs, List.mem_filterMap] at ha
    obtain ⟨x, hx, hxa⟩ := ha
    rcases x with c | e
    · cases hxa
    · cases hxa; exact hx
  have hlim : IsLim (pk.asg pk.owner) := by
    have hat : BaseAtom.lim (Role.slot pk.rk.a) ∈ graph pk.rk.F := by
      unfold graph
      simp only [List.mem_append]
      exact Or.inl (Or.inl (Or.inl (List.mem_map_of_mem hslot)))
    have hmem : Atom.base (BaseAtom.map pk.srcChart (BaseAtom.lim (Role.slot pk.rk.a))) ∈
        pk.joint := by
      unfold SourcePacket.joint Diagram.ofBase
      simp only [List.mem_append]
      exact Or.inl (Or.inr (List.mem_map_of_mem (List.mem_map_of_mem hat)))
    exact hj _ hmem
  obtain ⟨Ls, hLs, hLsu, hlowLs⟩ := pack_below hlim hL (pk.lowNames.map pk.asg)
    (fun x hx => by
      obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx
      exact hlow y hy)
  refine ⟨Ls, hLs, hLsu, fun x hx => hlowLs _ (List.mem_map_of_mem hx), ?_⟩
  rintro ⟨β, h1, h2, h3, h4⟩
  refine ⟨β, fun w x hw => h1 w _ (by simp only [hw]; rfl), fun w hw hn => ?_, h3, h4⟩
  have hb := h2 w hw (by simp only [hn]; rfl)
  exact ⟨lt_of_le_of_lt hLs hb, fun x hx => (hlowLs _ (List.mem_map_of_mem hx)).trans hb⟩

-- provides: U3, L7.3b (the converse direction: a target block gives a realization of the
-- positive block above the floor)
theorem targetAbove_blockAbove {P : Prims.{u}} (pk : SourcePacket.{u}) {L : Ordinal.{u}}
    (h : pk.TargetAbove P L) :
    BlockAbove P (posBlock pk.rk.tgtKey pk.rk.tgtSel)
      (fun w => (pk.tgtFrame.toFr w).map pk.asg) L (pk.asg pk.owner) := by sorry

-- provides: U3, L7.3a ((23): the failure label in the grammar; consumer: U5 L8.8)
theorem factorization_noB {P : Prims.{u}} (pk : SourcePacket.{u}) (hv : pk.Valid P)
    (ha : pk.rk.a ∈ pk.rk.F.entryAddrs) {L : Ordinal.{u}} (hL : L < pk.asg pk.owner)
    (hfail : ¬ pk.TargetAbove P L) (ℓ : Name) (hℓ : ℓ ≠ pk.owner)
    (hℓf : ℓ ∉ (baseVars (posBlock pk.rk.tgtKey pk.rk.tgtSel)).filterMap pk.tgtFrame.toFr) :
    ∃ Ls, L ≤ Ls ∧ Ls < pk.asg pk.owner ∧ (∀ x ∈ pk.lowNames, pk.asg x < Ls) ∧
      (noB pk.rk.tgtKey pk.rk.tgtSel pk.tgtFrame pk.owner ℓ).Holds P
        (Function.update pk.asg ℓ Ls) := by sorry

/-! ## L7.4  Joint cap -/

/-- L7.4: the chart `κ` of the first-difference cap: the target prefix chart before `U_b`, and the
source chart of the corresponding source role (through `b ↦ a`) from `U_b` on (owner, common
internal prefix, closing slot). -/
def capChart (pk : SourcePacket.{u}) (y : Role) : Name :=
  if y ∈ prefixRoles pk.rk.E pk.rk.b then pk.tgtChart y
  else pk.srcChart (transEntry pk.rk.b pk.rk.a y)

/-! ## L7.5  Joint repair, frame survival, readmission (closure of the packet class) -/

/-- L7.5: the roles of the repaired cap read in the literal cap: the origin in `E` (same address
in `litCap`), and the closing slot `⟨c, k⟩` for the appended closing entry. -/
def capRole {E : Forest} (w : Closure.AdmCap E) (x : Role) : Role :=
  (w.origin x).getD (.slot ⟨w.col, w.cut⟩)

-- Moved up from the L7.5d helpers (unchanged): L7.5a `frame_repair` uses it.
/-- L7.5d-3 (G-012): `capRole` is the origin wherever the origin is defined. -/
theorem capRole_of_origin {E : Forest} (w : Closure.AdmCap E) {x y : Role}
    (h : w.origin x = some y) : capRole w x = y := by
  simp [capRole, h]

/-- D7.1b helper: `filterMap` over a range whose values are all defined. -/
theorem filterMap_range_getElem? {β : Type} (f : Nat → Option β) :
    ∀ n, (∀ q < n, (f q).isSome) → ∀ q, ((List.range n).filterMap f)[q]? = if q < n then f q else none
  | 0, _, q => by simp
  | n + 1, h, q => by
    rw [List.range_succ, List.filterMap_append]
    obtain ⟨b, hb⟩ := Option.isSome_iff_exists.1 (h n (by omega))
    have hl : ((List.range n).filterMap f).length = n := by
      have := filterMap_range_getElem? f n (fun q hq => h q (by omega))
      apply Nat.le_antisymm
      · by_contra hc
        have h1 := this n
        rw [if_neg (by omega), List.getElem?_eq_none_iff] at h1
        omega
      · by_contra hc
        have h1 := this (n - 1)
        rw [if_pos (by omega), List.getElem?_eq_none (by omega)] at h1
        have := h (n - 1) (by omega)
        rw [← h1] at this
        simp at this
    simp only [List.filterMap_cons, List.filterMap_nil, hb]
    rw [List.getElem?_append]
    split_ifs with h1 h2 h3
    · rw [filterMap_range_getElem? f n (fun q hq => h q (by omega)), if_pos (by omega)]
    · omega
    · have : q = n := by omega
      subst this; simp [hl, hb]
    · rw [List.getElem?_singleton, if_neg (by omega)]

-- Moved up from after `reps0_length` (unchanged): `blockMap_frame` and `reps0_length` use it.
-- Moved up again from the integration additions (unchanged): L7.5a `frame_repair` uses it.
theorem reps0_getElem? (c : ColAddr) (q : Nat) : c.reps0[q]? = c.rep 0 q := by
  unfold ColAddr.reps0
  rw [filterMap_range_getElem? _ _ (fun q hq => (rep_isSome_iff c q).2 hq)]
  split_ifs with h
  · rfl
  · cases hr : c.rep 0 q with
    | none => rfl
    | some _ =>
      have := (rep_isSome_iff c q).1 (by rw [hr]; rfl)
      omega

-- Moved up from the integration additions (unchanged): L7.5a `frame_repair` uses it.
-- provides: U3, D7.1b (requested by U5 R19): frame roles lie in the prefix `P(E, e)`.
theorem frameOf_mem_prefix {E : Forest} {e : EntryAddr} (he : e ∈ E.entryAddrs) :
    Role.ord e.col ∈ prefixRoles E e ∧
      ∀ ov ∈ e.col.reps0, ov.1 ∈ prefixRoles E e ∧ ov.2 ∈ prefixRoles E e := by
  refine ⟨(Tree.stack_mem_prefix he).1, ?_⟩
  rintro ⟨o, v⟩ hov
  obtain ⟨q, hq⟩ := List.mem_iff_getElem?.1 hov
  rw [reps0_getElem?] at hq
  exact rep_mem_prefix he hq

/-- L7.5a helper (G-012): a role before `y` in `takeWhile` order has an earlier index. -/
theorem exists_lt_of_mem_takeWhile_ne_E1 :
    ∀ {l : List Role} {x y : Role}, x ∈ l.takeWhile (· != y) → y ∈ l →
      ∃ i j : Nat, l[i]? = some x ∧ l[j]? = some y ∧ i < j
  | [], _, _, hx, _ => by simp at hx
  | a :: l, x, y, hx, hy => by
    by_cases hay : a = y
    · subst hay; simp at hx
    · simp only [List.takeWhile_cons, bne_iff_ne, ne_eq, hay, not_false_eq_true, if_true,
        List.mem_cons] at hx
      have hy' : y ∈ l := by
        rcases List.mem_cons.mp hy with h | h
        · exact absurd h.symm hay
        · exact h
      rcases hx with rfl | hx
      · obtain ⟨j, hj⟩ := List.mem_iff_getElem?.mp hy'
        exact ⟨0, j + 1, rfl, by simpa using hj, by omega⟩
      · obtain ⟨i, j, hi, hj, hij⟩ := exists_lt_of_mem_takeWhile_ne_E1 hx hy'
        exact ⟨i + 1, j + 1, by simpa using hi, by simpa using hj, by omega⟩

/-- L7.5a helper: in a duplicate-free list, an element at an earlier index than `y` lies in
`takeWhile (· != y)`. -/
theorem mem_takeWhile_ne_of_lt_E1 :
    ∀ {l : List Role}, l.Nodup → ∀ {x y : Role} {i j : Nat}, l[i]? = some x → l[j]? = some y →
      i < j → x ∈ l.takeWhile (· != y)
  | [], _, _, _, _, _, hi, _, _ => by simp at hi
  | a :: l, hnd, x, y, i, j, hi, hj, hij => by
    obtain ⟨j', rfl⟩ : ∃ j', j = j' + 1 := ⟨j - 1, by omega⟩
    have hay : a ≠ y := by
      intro hay
      subst hay
      have hmem : a ∈ l := List.mem_of_getElem? (by simpa using hj)
      exact (List.nodup_cons.mp hnd).1 hmem
    simp only [List.takeWhile_cons, bne_iff_ne, ne_eq, hay, not_false_eq_true, if_true,
      List.mem_cons]
    cases i with
    | zero => left; simpa using hi.symm
    | succ i' =>
      right
      exact mem_takeWhile_ne_of_lt_E1 (List.nodup_cons.mp hnd).2 (by simpa using hi)
        (by simpa using hj) (by omega)

/-! ### L7.4 `joint_cap` helpers (F1) -/

/-- L7.4 helper (L4.3c step 3): the internal cap `BK` of the first-difference cap and the
reindexed safe source prefix `SA` have equal relative keys. -/
theorem capPair_F1 {rk : SrcRecord} (h : rk.Admitted) {c : ColAddr} {k p : Nat}
    (hfd : rk.firstDiff = .capAt c k p) :
    ∃ ρ q' BK SA, c.path = rk.b.heightPath ++ ρ ∧
      srcCol_D8 rk c = ⟨rk.a.heightPath ++ ρ, c.col⟩ ∧
      Closure.litCap rk.E c k p = (rk.E.truncAfter rk.b).setHeight rk.b BK ∧
      Closure.litCap rk.F (srcCol_D8 rk c) k q' = rk.F.setHeight rk.a SA ∧
      Closure.litCap rk.F (srcCol_D8 rk c) k q' =
        (rk.F.truncAfter ⟨srcCol_D8 rk c, k⟩).setHeight ⟨srcCol_D8 rk c, k⟩ Tree.empty ∧
      (⟨srcCol_D8 rk c, k⟩ : EntryAddr) ∈ rk.F.entryAddrs ∧
      relKey (rk.b.col.num 0) BK = relKey (rk.a.col.num 0) SA := by
  obtain ⟨ρ, colB, colA, hρ, hsrc, hcolB, hcolA, -, hkB, ⟨q', H', hAk, hp⟩, -, -⟩ :=
    capSetup_D8 h hfd
  obtain ⟨-, -, hcap⟩ := firstDiff_spec h
  obtain ⟨ρ', hρ', hcut, htcol, -⟩ := hcap c k p hfd
  obtain rfl : ρ = ρ' := by rw [hρ] at hρ'; exact List.append_cancel_left hρ'
  set t := rk.b.col.num 0 with ht
  set r := rk.a.col.num 0 with hr
  have hrt : r ≤ t := (admitted_hosts h).1
  have hb : rk.E.heightAt rk.b = some rk.tgtHeight := by
    have hb := h.2.1
    rw [Tree.mem_entryAddrs_iff, Option.isSome_iff_exists] at hb
    obtain ⟨x, hx⟩ := hb
    simp [SrcRecord.tgtHeight, Tree.heightAt, hx]
  have ha : rk.F.heightAt rk.a = some rk.srcHeight := by
    have ha := h.2.2.1
    rw [Tree.mem_entryAddrs_iff, Option.isSome_iff_exists] at ha
    obtain ⟨x, hx⟩ := ha
    simp [SrcRecord.srcHeight, Tree.heightAt, hx]
  obtain ⟨hbc, hcE⟩ := capAt_col_D8 h hfd
  have hKe := litCap_eq_setHeight_E1 hcE hbc k p
  have hdrop : c.path.drop rk.b.heightPath.length = ρ := by rw [hρ]; simp
  rw [hdrop, hb, Option.getD_some] at hKe
  set c'' := srcCol_D8 rk c with hc''
  have hc''F : c'' ∈ rk.F.colAddrs := by rw [Tree.mem_colAddrs_iff, hcolA]; rfl
  have hac : rk.a.heightPath <+: c''.path := by rw [hsrc]; exact List.prefix_append _ _
  have hSe := litCap_eq_setHeight_E1 hc''F hac k q'
  have hdrop' : c''.path.drop rk.a.heightPath.length = ρ := by rw [hsrc]; simp
  have hcc : c''.col = c.col := by rw [hsrc]
  rw [hdrop', hcc, ha, Option.getD_some, h.2.2.2.2.1] at hSe
  refine ⟨ρ, q', _, _, hρ, hsrc, hKe, hSe, litCap_truncClear_F1 hcolA hAk,
    (Tree.mem_entryAddrs_iff _ _).2 (by simp [Tree.entryAt, hcolA, hAk]), ?_⟩
  rw [relKey_eq_map, relKey_eq_map, litCapAux_eq_capT_F1, litCapAux_eq_capT_F1, capT_map_F1,
    capT_map_F1, ← relKey_eq_map, ← relKey_eq_map]
  have hlab : relLabel t p = relLabel r q' := by
    rw [hp, labelAbs_relLabel_D8 hrt, relLabel_sigma_F1 hrt]
  rw [hlab]
  have hsk : (rk.srcKey.colAt ⟨ρ, c.col⟩).isSome := by
    rw [SrcRecord.srcKey, relKey_eq_map, colAt_map_D8, ← colAt_heightPath_D8 ha, ← hsrc, hcolA]
    rfl
  exact capT_cut_F1 k _ ρ c.col _ _ htcol hsk hcut

/-- L7.4 helper: the roles of a tree truncated after `e` with the height of `e` replaced. -/
theorem roles_truncSet_F1 (t : Forest) (e : EntryAddr) (he : e ∈ t.entryAddrs) (X : Forest) :
    ((t.truncAfter e).setHeight e X).roles =
      prefixRoles t e ++ Role.slot e :: X.roles.map (Role.under e.heightPath) := by
  have hx' := he
  rw [Tree.mem_entryAddrs_iff] at hx'
  obtain ⟨⟨p, H⟩, hx⟩ := Option.isSome_iff_exists.1 hx'
  have hFe : (t.truncAfter e).entryAt e = some (p, H) := by rw [Tree.entryAt_truncAfter he, hx]
  obtain ⟨post, hr, hs, -⟩ := setHeight_decomp (t.truncAfter e) e X hFe
  have hF := Tree.truncAfter_roles_under he
  have hpF : prefixRoles (t.truncAfter e) e = prefixRoles t e := (Tree.truncAfter_spec t e he).2.2.2.2.2
  rw [hpF] at hr hs
  have hpost : post = [] := by
    rw [hF, show t.heightAt e = some H by simp [Tree.heightAt, hx], Option.getD_some] at hr
    have := congrArg List.length hr
    simp only [List.length_append, List.length_cons, List.length_map] at this
    exact List.eq_nil_of_length_eq_zero (by omega)
  subst hpost
  rw [hs, List.append_nil]

theorem transEntry_under_F1 (b a : EntryAddr) (r : Role) :
    transEntry b a (Role.under b.heightPath r) = Role.under a.heightPath r := by
  cases r with
  | ord d =>
    simp [Role.under, transEntry, relocEntryCol, List.isPrefixOf_iff_prefix]
  | slot e =>
    have hne : (⟨⟨b.heightPath ++ e.col.path, e.col.col⟩, e.idx⟩ : EntryAddr) ≠ b := by
      intro h
      have := congrArg (fun x : EntryAddr => x.col.path.length) h
      simp [EntryAddr.heightPath] at this
    simp only [Role.under, transEntry, if_neg hne, relocEntryCol, List.isPrefixOf_iff_prefix,
      List.prefix_append, if_true, List.drop_left]

theorem holds_map_F1 {V W : Type} (P : Prims.{u}) (f : V → W) (α : W → Ordinal.{u})
    (x : BaseAtom V) : (x.map f).Holds P α ↔ x.Holds P (α ∘ f) := by
  cases x <;> rfl

theorem holds_congr_F1 {V : Type} (P : Prims.{u}) {α β : V → Ordinal.{u}} (x : BaseAtom V)
    (h : ∀ v ∈ x.vars, α v = β v) : x.Holds P α ↔ x.Holds P β := by
  cases x <;> simp only [BaseAtom.vars, List.mem_cons, List.not_mem_nil, or_false] at h <;>
    simp only [BaseAtom.Holds] <;>
    simp [h]

/-- L7.4 helper: the variables of a free block. -/
theorem freeBlock_vars_F1 (K : Key) (x : BaseAtom BlkVar) (hx : x ∈ freeBlock K) (v : BlkVar)
    (hv : v ∈ x.vars) :
    v = .host ∨ v = .owner ∨ (∃ r, v = .inner r) ∨
      ∃ q e h, K.entryAt e = some ((false, q), h) ∧ (v = .ord q ∨ v = .cur q) := by
  unfold freeBlock at hx
  simp only [List.cons_append, List.mem_cons, List.mem_append, List.mem_map, List.mem_filterMap,
    List.mem_flatMap] at hx
  rcases hx with rfl | (((⟨_, ⟨r, -, rfl⟩, rfl⟩ | ⟨⟨y, z⟩, hyz, rfl⟩) | ⟨d, -, hd⟩) | ⟨e, -, he⟩)
  · simp [BaseAtom.vars] at hv; exact Or.inr (Or.inl hv)
  · simp [BaseAtom.vars] at hv; exact Or.inr (Or.inr (Or.inl ⟨_, hv⟩))
  · have hz := List.of_mem_zip hyz
    simp only [BaseAtom.vars, List.mem_cons, List.not_mem_nil, or_false] at hv
    rcases hv with rfl | rfl
    · rcases List.mem_cons.1 hz.1 with h | h
      · exact Or.inr (Or.inl h)
      · obtain ⟨r, -, rfl⟩ := List.mem_map.1 h
        exact Or.inr (Or.inr (Or.inl ⟨r, rfl⟩))
    · obtain ⟨r, -, rfl⟩ := List.mem_map.1 hz.2
      exact Or.inr (Or.inr (Or.inl ⟨r, rfl⟩))
  · split_ifs at hd
    cases hd
    simp only [BaseAtom.vars, List.mem_cons, List.not_mem_nil, or_false] at hv
    rcases hv with rfl | rfl <;> exact Or.inr (Or.inr (Or.inl ⟨_, rfl⟩))
  · cases hent : K.entryAt e with
    | none => simp [hent] at he
    | some y =>
      obtain ⟨⟨bb, q⟩, h0⟩ := y
      cases bb with
      | false =>
        simp only [hent, List.mem_cons, List.not_mem_nil, or_false] at he
        rcases he with rfl | rfl <;>
        · simp only [BaseAtom.vars, List.mem_cons, List.not_mem_nil, or_false] at hv
          rcases hv with rfl | rfl | rfl
          · exact Or.inr (Or.inr (Or.inl ⟨_, rfl⟩))
          · exact Or.inr (Or.inr (Or.inl ⟨_, rfl⟩))
          · first
            | exact Or.inr (Or.inr (Or.inr ⟨q, e, h0, hent, Or.inl rfl⟩))
            | exact Or.inr (Or.inr (Or.inr ⟨q, e, h0, hent, Or.inr rfl⟩))
      | true =>
        cases q with
        | zero =>
          simp only [hent, List.mem_cons, List.not_mem_nil, or_false] at he
          rcases he with rfl | rfl <;>
          · simp only [BaseAtom.vars, List.mem_cons, List.not_mem_nil, or_false] at hv
            rcases hv with rfl | rfl | rfl
            · exact Or.inr (Or.inr (Or.inl ⟨_, rfl⟩))
            · exact Or.inr (Or.inr (Or.inl ⟨_, rfl⟩))
            · first | exact Or.inl rfl | exact Or.inr (Or.inl rfl)
        | succ v' =>
          simp only [hent] at he
          cases hrep : ColAddr.rep 1 e.col (v' + 1) with
          | none => simp [hrep] at he
          | some ow =>
            obtain ⟨o, w⟩ := ow
            simp only [hrep, List.mem_cons, List.not_mem_nil, or_false] at he
            rcases he with rfl | rfl <;>
            · simp only [BaseAtom.vars, List.mem_cons, List.not_mem_nil, or_false] at hv
              rcases hv with rfl | rfl | rfl <;> exact Or.inr (Or.inr (Or.inl ⟨_, rfl⟩))

/-- L7.4 helper: `takeWhile (· != x)` stops inside a prefix that contains `x`. -/
theorem takeWhile_ne_take_F1 : ∀ (l : List Role) (m : Nat) (x : Role), x ∈ l.take m →
    l.takeWhile (· != x) = (l.take m).takeWhile (· != x)
  | [], _, _, _ => by simp
  | y :: l, 0, x, hx => by simp at hx
  | y :: l, m + 1, x, hx => by
    rw [List.take_succ_cons]
    by_cases hyx : y = x
    · subst hyx; simp
    · have hx' : x ∈ l.take m := by
        rcases List.mem_cons.1 (by simpa using hx) with h | h
        · exact absurd h.symm hyx
        · exact h
      simp only [List.takeWhile_cons, bne_iff_ne, ne_eq, hyx, not_false_eq_true, if_true]
      rw [takeWhile_ne_take_F1 l m x hx']

-- provides: U3, L7.4 (the spine's `joint_cap`†; consumer: U5 L8.8 Case 3)
-- Moved down from after `capChart` (brief rule 5; unchanged statement): the proof uses
-- `reps0_getElem?` and `exists_lt_of_mem_takeWhile_ne_E1`, declared in between.
theorem joint_cap {P : Prims.{u}} (pk : SourcePacket.{u}) (hadm : pk.rk.Admitted) (hv : pk.Valid P)
    {c : ColAddr} {k p : Nat} (hfd : pk.rk.firstDiff = .capAt c k p) :
    let K := Closure.litCap pk.rk.E c k p
    let κ := capChart pk
    IsConfig P K (pk.asg ∘ κ) ∧
    (∀ y ∈ prefixRoles pk.rk.E pk.rk.b, κ y = pk.tgtChart y) ∧ κ (.slot pk.rk.b) = pk.owner ∧
    (∀ y ∈ K.roles, y ∉ prefixRoles pk.rk.E pk.rk.b →
      κ y = pk.srcChart (transEntry pk.rk.b pk.rk.a y)) ∧
    pk.asg pk.owner < pk.asg (κ (.ord c)) ∧ pk.asg (κ (.ord c)) < pk.asg (κ (.slot ⟨c, k⟩)) ∧
    (∀ y ∈ rolesBefore K (.ord c), pk.asg (κ y) < pk.asg (κ (.ord c))) ∧
    (∀ x ∈ pk.lowNames, pk.asg x < pk.asg (κ (.ord c))) ∧
    BaseHolds P ((restrictTo (graph pk.rk.E) (rolesBefore pk.rk.E (.ord c))).map (BaseAtom.map κ))
      pk.asg := by
  intro K κ
  obtain ⟨ρ, q', BK, SA, hρ, hsrc, hK, hS, hSt, he', hkey⟩ := capPair_F1 hadm hfd
  obtain ⟨hvt, hvs, hhost, hframe, hjoint, hheads, hlow⟩ := hv
  have hbE : pk.rk.b ∈ pk.rk.E.entryAddrs := hadm.2.1
  have haF : pk.rk.a ∈ pk.rk.F.entryAddrs := hadm.2.2.1
  have htrF : pk.rk.F.truncAfter pk.rk.a = pk.rk.F := hadm.2.2.2.2.1
  set PB := prefixRoles pk.rk.E pk.rk.b with hPB
  set PA := prefixRoles pk.rk.F pk.rk.a with hPA
  set t := pk.rk.b.col.num 0 with ht
  set r := pk.rk.a.col.num 0 with hr
  have hrt : r ≤ t := (admitted_hosts hadm).1
  -- the source side `F' = F.setHeight a SA`, a truncate-and-clear of `F`
  set F' := pk.rk.F.setHeight pk.rk.a SA with hF'
  have hF'sub : ∀ x ∈ graph F', x ∈ graph pk.rk.F := by
    rw [← hS, hSt]; exact truncClear_graph_F1 _ _ he'
  have hSB := Tree.setHeight_basic pk.rk.F pk.rk.a SA haF
  have haF' : pk.rk.a ∈ F'.entryAddrs := hSB.1
  have hF'a : F'.heightAt pk.rk.a = some SA := hSB.2.1
  -- roles of `K` and of `F'`
  have hroK : K.roles = PB ++ Role.slot pk.rk.b :: BK.roles.map (Role.under pk.rk.b.heightPath) := by
    show (Closure.litCap pk.rk.E c k p).roles = _
    rw [hK]; exact roles_truncSet_F1 _ _ hbE BK
  have hroF' : F'.roles = PA ++ Role.slot pk.rk.a :: SA.roles.map (Role.under pk.rk.a.heightPath) := by
    have := roles_truncSet_F1 pk.rk.F pk.rk.a haF SA
    rw [htrF] at this; exact this
  have hBS : BK.roles = SA.roles := by
    have := congrArg Tree.roles hkey
    rwa [relKey_eq_map, relKey_eq_map, Tree.roles_map, Tree.roles_map] at this
  have hndK := Tree.roles_nodup K
  have hbK : pk.rk.b ∈ K.entryAddrs := by
    show pk.rk.b ∈ (Closure.litCap pk.rk.E c k p).entryAddrs
    rw [hK]; exact (Tree.setHeight_basic _ _ _ (Tree.truncAfter_spec _ _ hbE).2.1).1
  have hKb : K.heightAt pk.rk.b = some BK := by
    show (Closure.litCap pk.rk.E c k p).heightAt pk.rk.b = _
    rw [hK]; exact (Tree.setHeight_basic _ _ _ (Tree.truncAfter_spec _ _ hbE).2.1).2.1
  have hKlab : (K.entryAt pk.rk.b).map Prod.fst = (pk.rk.E.entryAt pk.rk.b).map Prod.fst := by
    show ((Closure.litCap pk.rk.E c k p).entryAt pk.rk.b).map Prod.fst = _
    rw [hK, (Tree.setHeight_basic _ _ _ (Tree.truncAfter_spec _ _ hbE).2.1).2.2.2.2.2,
      Tree.entryAt_truncAfter hbE]
  have hpreK : prefixRoles K pk.rk.b = PB := by
    unfold prefixRoles rolesBefore
    rw [hroK, takeWhile_ne_of_decomp (by rw [← hroK]; exact hndK)]
  -- the charts realize their graphs
  have hsrcCfg : ∀ x ∈ graph pk.rk.F, x.Holds P (pk.asg ∘ pk.srcChart) := by
    intro x hx
    have h1 := hjoint (Atom.base (x.map pk.srcChart)) (by
      simp only [SourcePacket.joint, Diagram.ofBase, List.mem_append, List.mem_map]
      exact Or.inl (Or.inr ⟨_, ⟨x, hx, rfl⟩, rfl⟩))
    exact (holds_map_F1 P _ _ x).1 h1
  have htgtPre : ∀ x ∈ prefixGraph pk.rk.E pk.rk.b, x.Holds P (pk.asg ∘ pk.tgtChart) := by
    intro x hx
    have h1 := hjoint (Atom.base (x.map pk.tgtChart)) (by
      simp only [SourcePacket.joint, Diagram.ofBase, List.mem_append, List.mem_map]
      exact Or.inl (Or.inl ⟨_, ⟨x, hx, rfl⟩, rfl⟩))
    exact (holds_map_F1 P _ _ x).1 h1
  have hlowPB : ∀ y ∈ PB, pk.asg (pk.tgtChart y) < pk.asg pk.owner := fun y hy =>
    hlow _ (by simp only [SourcePacket.lowNames, List.mem_append, List.mem_map]
               exact Or.inl (Or.inl ⟨y, hy, rfl⟩))
  -- the chart `κ`
  have hκPB : ∀ y ∈ PB, κ y = pk.tgtChart y := fun y hy => by
    show capChart pk y = _; unfold capChart; rw [if_pos hy]
  have hκout : ∀ y, y ∉ PB → κ y = pk.srcChart (transEntry pk.rk.b pk.rk.a y) := fun y hy => by
    show capChart pk y = _; unfold capChart; rw [if_neg hy]
  have hinPB : ∀ y, y.inEntry pk.rk.b = true → y ∉ PB := by
    intro y hy hyP
    have := Tree.not_inEntry_of_mem_prefix hbE hyP
    rw [hy] at this; exact absurd this (by decide)
  have hslotPB : Role.slot pk.rk.b ∉ PB := hinPB _ (by simp [Role.inEntry])
  have hκb : κ (.slot pk.rk.b) = pk.owner := by
    rw [hκout _ hslotPB]; simp [transEntry, SourcePacket.owner]
  have hunderIn : ∀ r', (Role.under pk.rk.b.heightPath r').inEntry pk.rk.b = true := by
    intro r'; rw [inEntry_iff]; right
    cases r' <;> simp [Role.under, Role.path]
  have hκunder : ∀ r', κ (Role.under pk.rk.b.heightPath r') =
      pk.srcChart (Role.under pk.rk.a.heightPath r') := by
    intro r'; rw [hκout _ (hinPB _ (hunderIn r')), transEntry_under_F1]
  -- the two tails of the reading orders correspond through `transEntry`
  have hPBK : PB <+: K.roles := by rw [hroK]; exact List.prefix_append _ _
  have hPBE : PB <+: pk.rk.E.roles := List.takeWhile_prefix _
  set Lb := Role.slot pk.rk.b :: BK.roles.map (Role.under pk.rk.b.heightPath) with hLb
  have hLa : Role.slot pk.rk.a :: SA.roles.map (Role.under pk.rk.a.heightPath) =
      Lb.map (transEntry pk.rk.b pk.rk.a) := by
    rw [hLb, List.map_cons, List.map_map, ← hBS]
    congr 1
    · simp [transEntry]
    · apply List.map_congr_left; intro r' _; simp [transEntry_under_F1]
  have hLbPB : ∀ y ∈ Lb, y ∉ PB := by
    intro y hy
    rw [hLb] at hy
    rcases List.mem_cons.1 hy with rfl | hy
    · exact hslotPB
    · obtain ⟨r', -, rfl⟩ := List.mem_map.1 hy; exact hinPB _ (hunderIn r')
  have hlabPB : ∀ e, Role.slot e ∈ PB →
      (K.entryAt e).map Prod.fst = (pk.rk.E.entryAt e).map Prod.fst := by
    intro e he
    have hT := Tree.truncAfter_spec pk.rk.E pk.rk.b hbE
    obtain ⟨⟨pb, Bb⟩, hFe⟩ := Option.isSome_iff_exists.1 ((Tree.mem_entryAddrs_iff _ _).1 hT.2.1)
    obtain ⟨-, -, -, hlab⟩ := setHeight_decomp (pk.rk.E.truncAfter pk.rk.b) pk.rk.b BK hFe
    rw [hT.2.2.2.2.2] at hlab
    show ((Closure.litCap pk.rk.E c k p).entryAt e).map Prod.fst = _
    rw [hK, hlab e he]
    have hin : Role.slot e ∈ (pk.rk.E.truncAfter pk.rk.b).roles := by
      rw [Tree.truncAfter_roles_under hbE]; simp [← hPB, he]
    rw [Tree.mem_roles_iff] at hin
    obtain ⟨y, hy⟩ := Option.isSome_iff_exists.1 hin
    obtain ⟨h', hh'⟩ := Tree.labelSub_truncAfter _ _ e y hy
    rw [hy, hh']; rfl
  -- (a): the cap is a configuration through `κ`
  have hcfg : IsConfig P K (pk.asg ∘ κ) := by
    intro x hx
    rcases graph_atom_cases K x hx with ⟨i, y, z, rfl, hy, hz⟩ | ⟨w, hw, hown⟩
    · show pk.asg (κ y) < pk.asg (κ z)
      rw [hroK] at hy hz
      by_cases hi1 : i + 1 < PB.length
      · rw [List.getElem?_append_left (by omega)] at hy hz
        have hyP : y ∈ PB := List.mem_of_getElem? hy
        have hzP : z ∈ PB := List.mem_of_getElem? hz
        rw [hκPB y hyP, hκPB z hzP]
        have hmem : BaseAtom.lt y z ∈ prefixGraph pk.rk.E pk.rk.b := by
          unfold prefixGraph restrictTo; rw [List.mem_filter]
          refine ⟨(graph_lt_iff _ y z).2 ⟨i, ?_, ?_⟩, ?_⟩
          · rw [getElem?_of_prefix hPBE (by omega)]; exact hy
          · rw [getElem?_of_prefix hPBE (by omega)]; exact hz
          · simp [BaseAtom.vars, ← hPB, hyP, hzP]
        exact htgtPre _ hmem
      · by_cases hi2 : i + 1 = PB.length
        · rw [List.getElem?_append_left (by omega)] at hy
          rw [List.getElem?_append_right (by omega), hi2, Nat.sub_self] at hz
          simp only [hLb, List.getElem?_cons_zero, Option.some.injEq] at hz
          subst hz
          have hyP : y ∈ PB := List.mem_of_getElem? hy
          rw [hκPB y hyP, hκb]
          exact hlowPB y hyP
        · have hj : PB.length ≤ i := by omega
          rw [List.getElem?_append_right hj] at hy
          rw [List.getElem?_append_right (by omega)] at hz
          have hyL : y ∈ Lb := List.mem_of_getElem? hy
          have hzL : z ∈ Lb := List.mem_of_getElem? hz
          rw [hκout y (hLbPB y hyL), hκout z (hLbPB z hzL)]
          have hlt : BaseAtom.lt (transEntry pk.rk.b pk.rk.a y) (transEntry pk.rk.b pk.rk.a z) ∈
              graph F' := by
            rw [graph_lt_iff]
            refine ⟨PA.length + (i - PB.length), ?_, ?_⟩
            · rw [hroF', List.getElem?_append_right (by omega), hLa]
              simp [hy]
            · rw [hroF', List.getElem?_append_right (by omega), hLa,
                show PA.length + (i - PB.length) + 1 - PA.length = i + 1 - PB.length by omega]
              simp [hz]
          exact hsrcCfg _ (hF'sub _ hlt)
    · have hxown : x ∈ ownedBy (graph K) w := by
        unfold ownedBy; rw [List.mem_filter]; exact ⟨hx, by simp [hown]⟩
      by_cases hwP : w ∈ PB
      · have hvars : ∀ v ∈ x.vars, v ∈ PB := fun v hv => by
          rcases owned_before hxown hv with h | h
          · exact rolesBefore_sub_prefix hPBK hwP h
          · rw [h]; exact hwP
        have hxE : x ∈ prefixGraph pk.rk.E pk.rk.b := by
          refine restrict_graph_of_common (F := K) (t := pk.rk.E) hPBK hPBE
            (fun e he => hlabPB e he) x ?_
          unfold restrictTo; rw [List.mem_filter]; exact ⟨hx, by simpa using hvars⟩
        exact (holds_congr_F1 P x (fun v hv => by
          simp only [Function.comp_apply, hκPB v (hvars v hv)])).2 (htgtPre x hxE)
      · have hwL : w ∈ Lb := by
          rw [hroK] at hw
          rcases List.mem_append.1 hw with h | h
          · exact absurd h hwP
          · exact h
        have hz : w = .slot pk.rk.b ∨ pk.rk.b.heightPath <+: w.path := by
          rcases List.mem_cons.1 hwL with h | h
          · exact Or.inl h
          · obtain ⟨r', -, rfl⟩ := List.mem_map.1 h
            right; cases r' <;> simp [Role.under, Role.path]
        obtain ⟨a₀, ha₀, rfl⟩ := graph_owned_block_core hbK w hz x hxown
        rw [holds_map_F1]
        rw [hKb, Option.getD_some, hKlab] at ha₀
        unfold posBlock at ha₀
        rcases List.mem_append.1 ha₀ with ha₀ | ha₀
        · -- the free block: transfer through the reindexed safe source prefix
          rw [hkey] at ha₀
          have hfb := freeBlock_graph_core haF' SA.cols.length a₀
            (by rw [hF'a, Option.getD_some, takeCols_length]; exact ha₀)
          have h1 := hsrcCfg _ (hF'sub _ hfb)
          rw [holds_map_F1] at h1
          refine (holds_congr_F1 P a₀ ?_).2 h1
          intro v hv
          simp only [Function.comp_apply]
          rcases freeBlock_vars_F1 _ a₀ ha₀ v hv with rfl | rfl | ⟨r', rfl⟩ | ⟨q, e, h0, hent, hqv⟩
          · simp only [blockMap]; rw [hκPB _ (Tree.stack_mem_prefix hbE).1, hhost]; rfl
          · simp only [blockMap]; rw [hκb]; rfl
          · simp only [blockMap]; rw [hκunder]
          · -- a false label `q < r`: both frames agree below `r` (Valid clause 3)
            obtain ⟨y, hSAe, hlabq⟩ : ∃ y : Nat × Forest, SA.entryAt e = some y ∧
                relLabel r y.1 = (false, q) := by
              rw [relKey_eq_map, entryAt_map_D8] at hent
              obtain ⟨y, hy, hyeq⟩ := Option.map_eq_some_iff.1 hent
              exact ⟨y, hy, by simp only [Prod.mk.injEq] at hyeq; exact hyeq.1⟩
            have hqr : q < r := by
              unfold relLabel at hlabq
              split_ifs at hlabq with hh
              · simp only [Prod.mk.injEq, true_and] at hlabq; omega
              · simp at hlabq
            obtain ⟨⟨ob, vb⟩, hrb⟩ :=
              Option.isSome_iff_exists.1 ((rep_isSome_iff pk.rk.b.col q).2 (by omega))
            obtain ⟨⟨oa, va⟩, hra⟩ :=
              Option.isSome_iff_exists.1 ((rep_isSome_iff pk.rk.a.col q).2 hqr)
            have hfr := congrArg (·[q]?) hframe
            simp only [List.getElem?_take, if_pos hqr, SourcePacket.srcFrame, SourcePacket.tgtFrame,
              Frame.map, frameOf, List.getElem?_map, reps0_getElem?, hrb, hra, Option.map_some,
              Option.some.injEq, Prod.mk.injEq] at hfr
            have hobP := rep_mem_prefix hbE hrb
            rcases hqv with rfl | rfl
            · simp only [blockMap, hrb, hra, Option.map_some, Option.getD_some]
              rw [hκPB _ hobP.1, hfr.1]
            · simp only [blockMap, hrb, hra, Option.map_some, Option.getD_some]
              rw [hκPB _ hobP.2, hfr.2]
        · -- the two target heads (Valid clause 5)
          obtain ⟨o, v, hov, he1, he2⟩ := hheads
          have hreps := hov
          simp only [SourcePacket.tgtFrame, Frame.map, frameOf, List.getElem?_map,
            reps0_getElem?] at hreps
          obtain ⟨⟨ob, vb⟩, hrb, hobv⟩ := Option.map_eq_some_iff.1 hreps
          simp only [Prod.mk.injEq] at hobv
          have hobP := rep_mem_prefix hbE hrb
          have hsel : ((pk.rk.E.entryAt pk.rk.b).map Prod.fst).getD 0 = pk.rk.tgtSel := rfl
          simp only [List.mem_cons, List.not_mem_nil, or_false] at ha₀
          rcases ha₀ with rfl | rfl
          · show P.Edge _ _ _
            simp only [Function.comp_apply, blockMap, hsel, hrb, Option.map_some, Option.getD_some]
            rw [hκb, hκPB _ (Tree.stack_mem_prefix hbE).1, hhost, hκPB _ hobP.1, hobv.1]
            exact he1
          · show P.Edge _ _ _
            simp only [Function.comp_apply, blockMap, hsel, hrb, Option.map_some, Option.getD_some]
            rw [hκb, hκPB _ (Tree.stack_mem_prefix hbE).1, hhost, hκPB _ hobP.2, hobv.2]
            exact he2
  -- positions of `A_c` and of the closing slot in `K`
  obtain ⟨-, colB, -, -, -, hcolB, -, -, hkB, -⟩ := capSetup_D8 hadm hfd
  obtain ⟨hbc, hcE⟩ := capAt_col_D8 hadm hfd
  have hcolK : K.colAt c = some (colB.take k ++ [(p, Tree.empty)]) := by
    show (Closure.litCap pk.rk.E c k p).colAt c = _
    rw [litCap_colAt_self_D8 hcE, hcolB]; rfl
  have hcK : Role.ord c ∈ K.roles := by
    rw [Tree.mem_roles_iff]; show (K.colAt c).isSome; rw [hcolK]; rfl
  have hckK : (⟨c, k⟩ : EntryAddr) ∈ K.entryAddrs := by
    rw [Tree.mem_entryAddrs_iff]
    simp [Tree.entryAt, hcolK, Nat.min_eq_left hkB]
  have hckR : Role.slot (⟨c, k⟩ : EntryAddr) ∈ K.roles := by
    rw [Tree.mem_roles_iff]; exact (Tree.mem_entryAddrs_iff _ _).1 hckK
  have hcin : (Role.ord c).inEntry pk.rk.b = true := by
    rw [inEntry_iff]; right; exact hbc
  have hbefore1 : Before K (.slot pk.rk.b) (.ord c) := by
    have := Tree.prefix_slot_before_inEntry hbK hcK hcin (by simp)
    exact exists_lt_of_mem_takeWhile_ne_E1 (this.mem (by simp)) hcK
  have hbefore2 : Before K (.ord c) (.slot ⟨c, k⟩) :=
    exists_lt_of_mem_takeWhile_ne_E1 (Tree.stack_mem_prefix hckK).1 hckR
  have hd1 : pk.asg pk.owner < pk.asg (κ (.ord c)) := by
    have := isConfig_before hcfg hbefore1
    rwa [Function.comp_apply, hκb] at this
  have hd2 := isConfig_before hcfg hbefore2
  refine ⟨hcfg, hκPB, hκb, fun y _ hy => hκout y hy, hd1, hd2, ?_, ?_, ?_⟩
  · intro y hy; exact isConfig_before hcfg (exists_lt_of_mem_takeWhile_ne_E1 hy hcK)
  · intro x hx; exact (hlow x hx).trans hd1
  · -- (f): the `E`-prefix before `A_c` is common to `E` and `K`
    have hkpar : k ≤ (Scan.parents pk.rk.E c).length := by simp [Scan.parents, hcolB, hkB]
    obtain ⟨⟨m, hKm⟩, hlabK, -, -, -⟩ := Closure.litCap_spec (p := p) hcE hkpar
    have hcm : Role.ord c ∈ pk.rk.E.roles.take m := by
      have h1 : Role.ord c ∈ K.roles := hcK
      rw [show K.roles = _ from hKm] at h1
      rcases List.mem_append.1 h1 with h | h
      · exact h
      · simp at h
    have hSeq : rolesBefore pk.rk.E (.ord c) = (pk.rk.E.roles.take m).takeWhile (· != .ord c) :=
      takeWhile_ne_take_F1 _ _ _ hcm
    have hSK : rolesBefore pk.rk.E (.ord c) <+: K.roles := by
      rw [hSeq, show K.roles = _ from hKm]
      exact (List.takeWhile_prefix _).trans (List.prefix_append _ _)
    have hSE : rolesBefore pk.rk.E (.ord c) <+: pk.rk.E.roles := List.takeWhile_prefix _
    have hlabS : ∀ e, Role.slot e ∈ rolesBefore pk.rk.E (.ord c) →
        (pk.rk.E.entryAt e).map Prod.fst = (K.entryAt e).map Prod.fst := by
      intro e he
      have heK : e ∈ K.entryAddrs := by
        rw [Tree.mem_entryAddrs_iff]
        have := hSK.mem he; rw [Tree.mem_roles_iff] at this; exact this
      have hne : e ≠ ⟨c, k⟩ := by
        rintro rfl
        have hnd := hndK
        rw [show K.roles = _ from hKm] at hnd
        have hmem : Role.slot (⟨c, k⟩ : EntryAddr) ∈ pk.rk.E.roles.take m := by
          rw [hSeq] at he; exact (List.takeWhile_sublist _).subset he
        exact (List.nodup_append.1 hnd).2.2 _ hmem _ (List.mem_singleton_self _) rfl
      exact (hlabK e heK hne).symm
    intro y hy
    obtain ⟨x, hx, rfl⟩ := List.mem_map.1 hy
    rw [holds_map_F1]
    have hxK := restrict_graph_of_common hSE hSK hlabS x hx
    unfold restrictTo at hxK
    exact hcfg x (List.mem_filter.1 hxK).1

-- provides: U3, L7.5a (the whole external frame survives same-parent repairs)
theorem frame_repair {E : Forest} (hE : IsStd E) (w : Closure.AdmCap E) {b : EntryAddr}
    (hb : b ∈ E.entryAddrs) (hbc : b.heightPath <+: w.col.path)
    (hout : Closure.MovesOutside w.moves b) :
    let bm := Closure.moveAddr w.moves b
    (frameOf bm).map (capRole w) = frameOf b ∧ capRole w (.slot bm) = .slot b ∧
    (∀ x ∈ prefixRoles w.H bm, capRole w x ∈ prefixRoles E b) ∧
    Set.InjOn (capRole w) {x | x ∈ prefixRoles w.H bm} := by
  intro bm
  have hL : Scan.InL E := Closure.std_inL hE
  obtain ⟨hmem, -, -, horig⟩ := marked_entry_cap hE w hb hbc hout
  obtain ⟨hOs, hOc⟩ := origin_moveAddr hL w hbc hout
  obtain ⟨hinj, -, -, -, -, -, hrep, hord⟩ := Closure.origin_spec_full hL w
  have hcr : ∀ x ∈ prefixRoles w.H bm, w.origin x = some (capRole w x) := by
    intro x hx
    obtain ⟨z, hz⟩ := Option.isSome_iff_exists.mp (horig x hx)
    rw [hz, capRole_of_origin w hz]
  have hanc : ∀ x ∈ prefixRoles w.H bm, anchorD E (some w) x = capRole w x := by
    intro x hx
    simp [anchorD, Closure.anchorOrigin, hcr x hx]
  have hpre := frameOf_mem_prefix hmem
  have hbmcol : Role.ord bm.col ∈ w.H.roles := (List.takeWhile_sublist _).subset hpre.1
  have hrep' := hrep bm.col b.col hbmcol hOc
  have hmemR : Role.slot bm ∈ w.H.roles :=
    (Tree.mem_roles_iff _ _).mpr ((Tree.mem_entryAddrs_iff _ _).mp hmem)
  refine ⟨?_, capRole_of_origin w hOs, ?_, ?_⟩
  · have hnum : bm.col.num 0 = b.col.num 0 := Closure.moveAddr_num _ _
    simp only [frameOf, Frame.map, Frame.mk.injEq]
    refine ⟨capRole_of_origin w hOc, ?_⟩
    unfold ColAddr.reps0
    rw [List.map_filterMap, hnum]
    apply List.filterMap_congr
    intro q hq
    have hq' : q < bm.col.num 0 := by rw [hnum]; exact List.mem_range.mp hq
    rw [← hrep' q hq']
    cases hr : bm.col.rep 0 q with
    | none => rfl
    | some ov =>
      have hov : ov ∈ bm.col.reps0 := by
        unfold ColAddr.reps0
        exact List.mem_filterMap.mpr ⟨q, List.mem_range.mpr hq', hr⟩
      obtain ⟨h1, h2⟩ := hpre.2 ov hov
      simp only [Option.map_some, hanc _ h1, hanc _ h2]
  · intro x hx
    obtain ⟨i, j, hi, hj, hij⟩ := exists_lt_of_mem_takeWhile_ne_E1 hx hmemR
    obtain ⟨i', j', hi', hj', hij'⟩ := hord x (.slot bm) ⟨i, j, hi, hj, hij⟩ (horig x hx)
      (by rw [hOs]; rfl)
    have e1 : anchorD E (some w) x = capRole w x := hanc x hx
    have e2 : anchorD E (some w) (.slot bm) = .slot b := by
      show (w.origin (Role.slot (Closure.moveAddr w.moves b))).getD _ = _
      rw [hOs]
      rfl
    rw [e1] at hi'
    rw [e2] at hj'
    exact mem_takeWhile_ne_of_lt_E1 (Tree.roles_nodup E) hi' hj' hij'
  · intro x hx y hy hxy
    have hxH : x ∈ w.H.roles := (List.takeWhile_sublist _).subset hx
    have hyH : y ∈ w.H.roles := (List.takeWhile_sublist _).subset hy
    exact hinj hxH hyH (by rw [hcr x hx, hcr y hy, hxy])

-- Moved up from the L7.5d helpers (unchanged): L7.5 `joint_repair` uses them.
/-- L7.5d-2 helper (G-012): `takeWhile (· != x)` stops inside a prefix that contains `x`. -/
theorem takeWhile_ne_take_append {x : Role} :
    ∀ (l r : List Role) (m : Nat), x ∈ l.take m →
      (l.take m ++ r).takeWhile (· != x) = l.takeWhile (· != x)
  | [], _, _, h => by simp at h
  | _ :: _, _, 0, h => by simp at h
  | y :: l, r, m + 1, h => by
    by_cases hy : y = x
    · subst hy; simp
    · have h' : x ∈ l.take m := by
        simp only [List.take_succ_cons, List.mem_cons] at h
        rcases h with h | h
        · exact absurd h.symm hy
        · exact h
      simp only [List.take_succ_cons, List.cons_append, List.takeWhile_cons]
      simp [hy, takeWhile_ne_take_append l r m h']

/-- L7.5d-2 (G-012): the literal cap keeps `A_c` and everything before it. -/
theorem litCap_rolesBefore_col {E : Forest} {c : ColAddr} {k p : Nat}
    (hup : Closure.IsUpward E c k p) :
    Role.ord c ∈ (Closure.litCap E c k p).roles ∧
      rolesBefore (Closure.litCap E c k p) (.ord c) = rolesBefore E (.ord c) := by
  have hcol : ∃ col, E.colAt c = some col ∧ k ≤ col.length := by
    unfold Closure.IsUpward at hup
    split at hup
    · rename_i col hc
      refine ⟨col, hc, ?_⟩
      split at hup
      · rename_i hk
        exact (List.getElem?_eq_some_iff.mp hk).1.le
      · omega
    · exact hup.elim
  obtain ⟨col, hc, hk⟩ := hcol
  have hcE : c ∈ E.colAddrs := (Tree.mem_colAddrs_iff _ _).mpr (by simp [hc])
  have hkp : k ≤ (Scan.parents E c).length := by simp [Scan.parents, hc, hk]
  obtain ⟨⟨m, hm⟩, -⟩ := Closure.litCap_spec (p := p) hcE hkp
  have hmem : Role.ord c ∈ (Closure.litCap E c k p).roles :=
    Scan.stopData_col_mem (Closure.stopData_litCap hup)
  refine ⟨hmem, ?_⟩
  have h1 : Role.ord c ∈ E.roles.take m := by
    rw [hm] at hmem
    simpa using hmem
  unfold rolesBefore
  rw [hm]
  exact takeWhile_ne_take_append _ _ m h1

/-- L7.5 helper: the path map of a move, as a function of the move column only. -/
def mpE1 (g : Nat → Nat) (P : List (Nat × Nat)) (J : Nat) (π : List (Nat × Nat)) :
    List (Nat × Nat) :=
  Closure.Move.mapPath g ⟨⟨P, J⟩, 0, 0⟩ π

theorem mapPath_eq_mp_E1 (g : Nat → Nat) (m : Closure.Move) (π : List (Nat × Nat)) :
    m.mapPath g π = mpE1 g m.col.path m.col.col π := rfl

theorem mp_nil_nil_E1 (g : Nat → Nat) (J : Nat) : mpE1 g [] J [] = [] := by
  simp [mpE1, Closure.Move.mapPath]

theorem mp_nil_cons_E1 (g : Nat → Nat) (J c e : Nat) (π : List (Nat × Nat)) :
    mpE1 g [] J ((c, e) :: π) = if c = J then (c, g e) :: π else (c, e) :: π := by
  simp only [mpE1, Closure.Move.mapPath]
  split_ifs <;> simp_all

theorem mp_cons_nil_E1 (g : Nat → Nat) (P : List (Nat × Nat)) (J ci ei : Nat) :
    mpE1 g ((ci, ei) :: P) J [] = [] := by
  simp [mpE1, Closure.Move.mapPath]

theorem mp_cons_same_E1 (g : Nat → Nat) (P : List (Nat × Nat)) (J ci ei : Nat)
    (π : List (Nat × Nat)) :
    mpE1 g ((ci, ei) :: P) J ((ci, ei) :: π) = (ci, ei) :: mpE1 g P J π := by
  simp only [mpE1, Closure.Move.mapPath, List.length_cons, List.take_succ_cons,
    List.cons.injEq, true_and, List.getElem?_cons_succ, List.drop_succ_cons]
  split_ifs with h1
  · split
    · split_ifs <;> rfl
    · rfl
  · rfl

theorem mp_cons_ne_E1 (g : Nat → Nat) (P : List (Nat × Nat)) (J ci ei c e : Nat)
    (h : (c, e) ≠ (ci, ei)) (π : List (Nat × Nat)) :
    mpE1 g ((ci, ei) :: P) J ((c, e) :: π) = (c, e) :: π := by
  simp only [mpE1, Closure.Move.mapPath, List.length_cons, List.take_succ_cons, List.cons.injEq]
  rw [if_neg]
  rintro ⟨h1, -⟩
  exact h (by simpa using h1)

theorem mp_length_E1 (g : Nat → Nat) (P : List (Nat × Nat)) (J : Nat) (π : List (Nat × Nat)) :
    (mpE1 g P J π).length = π.length := by
  simp only [mpE1, Closure.Move.mapPath]
  split_ifs with h1
  · split
    · rename_i c e he
      split_ifs
      · have := (List.getElem?_eq_some_iff.mp he).1
        simp only [List.length_append, List.length_take, List.length_cons, List.length_drop]
        omega
      · rfl
    · rfl
  · rfl

theorem mp_eq_self_E1 (g : Nat → Nat) (P : List (Nat × Nat)) (J : Nat) :
    mpE1 g P J P = P := by
  simp only [mpE1, Closure.Move.mapPath, List.take_length, if_true, List.getElem?_eq_none le_rfl]

theorem mp_eq_P_E1 {g : Nat → Nat} {P : List (Nat × Nat)} {J : Nat} {π : List (Nat × Nat)}
    (h : mpE1 g P J π = P) : π = P := by
  have hl := mp_length_E1 g P J π
  rw [h] at hl
  revert h
  simp only [mpE1, Closure.Move.mapPath]
  split_ifs with h1
  · intro _
    rw [← h1, List.take_of_length_le (by omega)]
  · exact id

theorem getElem?_modify_eq_E1 {β : Type} (l : List β) (n : Nat) (f : β → β) :
    (l.modify n f)[n]? = l[n]?.map f := by
  simp

theorem getElem?_modify_ne_E1 {β : Type} (l : List β) {n m : Nat} (f : β → β) (h : n ≠ m) :
    (l.modify n f)[m]? = l[m]? := by
  simp [h]

/-- L7.5 helper: the entries of a column after the move, read back through `bwdIdx`. -/
theorem getElem?_move_E1 {β : Type} {col : List β} {i j e : Nat} {x : β} (hij : i ≤ j)
    (h : (col.take i ++ col.drop j)[e]? = some x) :
    col[if i ≤ e then e + (j - i) else e]? = some x := by
  by_cases hlen : i ≤ col.length
  · have ht : (col.take i).length = i := by simp; omega
    by_cases he : e < i
    · rw [List.getElem?_append_left (by omega), List.getElem?_take_of_lt he] at h
      rw [if_neg (by omega)]; exact h
    · rw [List.getElem?_append_right (by omega), ht, List.getElem?_drop] at h
      rw [if_pos (by omega)]
      have : j + (e - i) = e + (j - i) := by omega
      rw [← this]; exact h
  · have hd : col.drop j = [] := List.drop_eq_nil_of_le (by omega)
    have ht : col.take i = col := List.take_of_length_le (by omega)
    rw [hd, ht, List.append_nil] at h
    have := (List.getElem?_eq_some_iff.mp h).1
    rw [if_neg (by omega)]; exact h

/-- L7.5 helper: columns of a tree after modifying one column, read back through the path map. -/
theorem colAt_modifyColAux_E1 (f : Column → Column) (g : Nat → Nat) (J : Nat) :
    ∀ (P : List (Nat × Nat)) (t : Forest) (d : ColAddr) (col' : Column),
      (Closure.modifyColAux f P J t).colAt d = some col' →
      (∀ (col : Column) (e : Nat) (x : Nat × Forest), (f col)[e]? = some x → col[g e]? = some x) →
      ∃ col, t.colAt ⟨mpE1 g P J d.path, d.col⟩ = some col ∧
        (d = ⟨P, J⟩ → col' = f col) ∧ (d ≠ ⟨P, J⟩ → col'.length = col.length)
  | [], .node cols, ⟨[], dc⟩, col', h, hf => by
    rw [mp_nil_nil_E1]
    simp only [Closure.modifyColAux, Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols] at h ⊢
    by_cases hdc : dc = J
    · subst hdc
      rw [getElem?_modify_eq_E1] at h
      obtain ⟨col, hc, rfl⟩ := Option.map_eq_some_iff.mp h
      exact ⟨col, hc, fun _ => rfl, fun hne => absurd rfl hne⟩
    · rw [getElem?_modify_ne_E1 _ _ (Ne.symm hdc)] at h
      exact ⟨col', h, fun hd => absurd (congrArg ColAddr.col hd) hdc, fun _ => rfl⟩
  | [], .node cols, ⟨(c, e) :: π, dc⟩, col', h, hf => by
    rw [mp_nil_cons_E1]
    simp only [Closure.modifyColAux] at h
    rw [Tree.colAt_cons] at h
    simp only [Tree.cols] at h
    have hne : (⟨(c, e) :: π, dc⟩ : ColAddr) ≠ ⟨[], J⟩ := by simp
    by_cases hc : c = J
    · subst hc
      rw [if_pos rfl, Tree.colAt_cons]
      simp only [Tree.cols]
      rw [getElem?_modify_eq_E1] at h
      cases hcol : cols[c]? with
      | none => rw [hcol] at h; simp at h
      | some col =>
        rw [hcol] at h
        simp only [Option.map_some, Option.bind_some] at h
        cases hx : (f col)[e]? with
        | none => rw [hx] at h; simp at h
        | some x =>
          rw [hx] at h
          simp only [Option.bind_some] at h
          simp only [Option.bind_some, hf col e x hx]
          exact ⟨col', h, fun hd => absurd hd hne, fun _ => rfl⟩
    · rw [if_neg hc, Tree.colAt_cons]
      simp only [Tree.cols]
      rw [getElem?_modify_ne_E1 _ _ (Ne.symm hc)] at h
      exact ⟨col', h, fun hd => absurd hd hne, fun _ => rfl⟩
  | (ci, ei) :: P, .node cols, ⟨[], dc⟩, col', h, hf => by
    rw [mp_cons_nil_E1]
    simp only [Closure.modifyColAux, Tree.colAt, Tree.forestAt, Option.bind_some, Tree.cols] at h ⊢
    have hne : (⟨[], dc⟩ : ColAddr) ≠ ⟨(ci, ei) :: P, J⟩ := by simp
    by_cases hdc : dc = ci
    · subst hdc
      rw [getElem?_modify_eq_E1] at h
      obtain ⟨col, hc, rfl⟩ := Option.map_eq_some_iff.mp h
      exact ⟨col, hc, fun hd => absurd hd hne, fun _ => by simp⟩
    · rw [getElem?_modify_ne_E1 _ _ (Ne.symm hdc)] at h
      exact ⟨col', h, fun hd => absurd hd hne, fun _ => rfl⟩
  | (ci, ei) :: P, .node cols, ⟨(c, e) :: π, dc⟩, col', h, hf => by
    simp only [Closure.modifyColAux] at h
    rw [Tree.colAt_cons] at h
    simp only [Tree.cols] at h
    by_cases hce : (c, e) = (ci, ei)
    · obtain ⟨rfl, rfl⟩ := Prod.mk.inj hce
      rw [mp_cons_same_E1, Tree.colAt_cons]
      simp only [Tree.cols]
      rw [getElem?_modify_eq_E1] at h
      cases hcol : cols[c]? with
      | none => rw [hcol] at h; simp at h
      | some col =>
        rw [hcol] at h
        simp only [Option.map_some, Option.bind_some] at h
        rw [getElem?_modify_eq_E1] at h
        cases hx : col[e]? with
        | none => rw [hx] at h; simp at h
        | some x =>
          rw [hx] at h
          simp only [Option.map_some, Option.bind_some] at h
          obtain ⟨col0, h0, h1, h2⟩ := colAt_modifyColAux_E1 f g J P x.2 ⟨π, dc⟩ col' h hf
          refine ⟨col0, by simpa [hx] using h0, fun hd => h1 (by simp_all), fun hd => h2 ?_⟩
          intro hd'; apply hd; simp_all
    · rw [mp_cons_ne_E1 _ _ _ _ _ _ _ hce, Tree.colAt_cons]
      simp only [Tree.cols]
      have hne : (⟨(c, e) :: π, dc⟩ : ColAddr) ≠ ⟨(ci, ei) :: P, J⟩ := by
        intro hd; apply hce; simp_all
      refine ⟨col', ?_, fun hd => absurd hd hne, fun _ => rfl⟩
      by_cases h1 : ci = c
      · subst h1
        rw [getElem?_modify_eq_E1] at h
        cases hcol : cols[ci]? with
        | none => rw [hcol] at h; simp at h
        | some col =>
          rw [hcol] at h
          simp only [Option.map_some, Option.bind_some] at h
          have he : e ≠ ei := fun he => hce (by rw [he])
          rw [getElem?_modify_ne_E1 _ _ (Ne.symm he)] at h
          simpa [hcol] using h
      · rw [getElem?_modify_ne_E1 _ _ h1] at h
        exact h


/-- L7.5 helper: a role of the tree after a legal move, read back through the backward index
map, is a role of the tree before the move. -/
theorem mapRole_applyMove_E1 {X : Forest} {m : Closure.Move} {col : Column}
    (hcol : X.colAt m.col = some col) (hij : m.i < m.j) (hj : m.j < col.length)
    {x : Role} (hx : x ∈ (Closure.applyMove X m).roles) : m.mapRole m.bwdIdx x ∈ X.roles := by
  have hX' : Closure.applyMove X m =
      Closure.modifyColAux (fun col => col.take m.i ++ col.drop m.j) m.col.path m.col.col X := by
    show Closure.applyMoveBody X m = _
    simp only [Closure.applyMoveBody, hcol, hij, hj, and_self, if_true]
    rfl
  have hf : ∀ (col : Column) (e : Nat) (x : Nat × Forest),
      (col.take m.i ++ col.drop m.j)[e]? = some x → col[m.bwdIdx e]? = some x :=
    fun col e x h => getElem?_move_E1 hij.le h
  rw [hX'] at hx
  rw [Tree.mem_roles_iff] at hx ⊢
  cases x with
  | ord d =>
    simp only at hx
    obtain ⟨col', hcol'⟩ := Option.isSome_iff_exists.mp hx
    obtain ⟨col0, h0, -, -⟩ := colAt_modifyColAux_E1 _ m.bwdIdx m.col.col m.col.path X d col'
      hcol' hf
    show (X.colAt ⟨mpE1 m.bwdIdx m.col.path m.col.col d.path, d.col⟩).isSome
    rw [h0]; rfl
  | slot e =>
    simp only at hx
    unfold Tree.entryAt at hx
    obtain ⟨col', hcol'⟩ : ∃ col', (Closure.modifyColAux (fun col => col.take m.i ++ col.drop m.j)
        m.col.path m.col.col X).colAt e.col = some col' := by
      cases hc : (Closure.modifyColAux _ m.col.path m.col.col X).colAt e.col with
      | none => rw [hc] at hx; simp at hx
      | some c => exact ⟨c, rfl⟩
    rw [hcol'] at hx
    simp only [Option.bind_some] at hx
    obtain ⟨col0, h0, h1, h2⟩ := colAt_modifyColAux_E1 _ m.bwdIdx m.col.col m.col.path X e.col col'
      hcol' hf
    show (X.entryAt (m.mapEntry m.bwdIdx e)).isSome
    unfold Closure.Move.mapEntry
    dsimp only
    split_ifs with hc'
    · have hp : mpE1 m.bwdIdx m.col.path m.col.col e.col.path = m.col.path :=
        congrArg ColAddr.path hc'
      have hcc := congrArg ColAddr.col hc'
      simp only at hcc
      have hem : e.col = m.col := colAddr_eq (mp_eq_P_E1 hp) hcc
      have h0' : X.colAt m.col = some col0 := by rw [← hc']; exact h0
      unfold Tree.entryAt
      rw [hc', h0']
      have h1' := h1 hem
      subst h1'
      obtain ⟨y, hy⟩ := Option.isSome_iff_exists.mp hx
      simp [hf col0 e.idx y hy]
    · have hem : e.col ≠ m.col := by
        intro hem
        apply hc'
        rw [hem]
        show (⟨mpE1 m.bwdIdx m.col.path m.col.col m.col.path, m.col.col⟩ : ColAddr) = m.col
        rw [mp_eq_self_E1]
      unfold Tree.entryAt
      have h0' : X.colAt ⟨m.mapPath m.bwdIdx e.col.path, e.col.col⟩ = some col0 := h0
      rw [h0']
      simp only [Option.bind_some]
      have hl := h2 hem
      rw [Option.isSome_iff_ne_none, ne_eq, List.getElem?_eq_none_iff, not_le] at hx ⊢
      omega

/-- L7.5 helper: undoing legal moves (last first) sends roles of the result to roles of the
start. -/
theorem foldr_mapRole_mem_E1 (K : Forest) : ∀ (ms : List Closure.Move), Closure.MovesValid K ms →
    ∀ x ∈ (Closure.applyMoves K ms).roles, ms.foldr (fun m y => m.mapRole m.bwdIdx y) x ∈ K.roles := by
  intro ms
  induction ms using List.reverseRecOn with
  | nil => intro _ x hx; exact hx
  | append_singleton ms m ih =>
    intro hv x hx
    have hpre : Closure.MovesValid K ms := by
      intro idx hidx
      have h' := hv idx (by simp; omega)
      rwa [List.take_append_of_le_length (by omega), List.getElem_append_left hidx] at h'
    have hlast : Closure.MoveOK (Closure.applyMoves K ms) m := by
      have h' := hv ms.length (by simp)
      simpa using h'
    obtain ⟨col, sd, hcol, -, hj, hij, -⟩ := hlast
    have hA : Closure.applyMoves K (ms ++ [m]) = Closure.applyMove (Closure.applyMoves K ms) m := by
      simp [Closure.applyMoves, List.foldl_append]
    rw [hA] at hx
    rw [List.foldr_append]
    simp only [List.foldr_cons, List.foldr_nil]
    exact ih hpre _ (mapRole_applyMove_E1 hcol hij (by omega) hx)

/-- L7.5 helper: the origin of a role of an admissible cap is a role of the literal cap other
than its closing slot. -/
theorem origin_mem_litCap_E1 {E : Forest} (w : Closure.AdmCap E) {x y : Role}
    (hx : x ∈ w.H.roles) (h : w.origin x = some y) :
    y ∈ (Closure.litCap E w.col w.cut w.par).roles ∧ y ≠ .slot ⟨w.col, w.cut⟩ := by
  have h' : Closure.originBody w x = some y := h
  unfold Closure.originBody at h'
  dsimp only at h'
  split_ifs at h' with hne
  obtain rfl := Option.some.inj h'
  exact ⟨foldr_mapRole_mem_E1 _ w.moves w.movesValid x hx, hne⟩


/-- L7.5 helper: indices in a duplicate-free list are unique. -/
theorem nodup_idx_E1 {β : Type} {l : List β} (h : l.Nodup) {i j : Nat} {x : β}
    (hi : l[i]? = some x) (hj : l[j]? = some x) : i = j := by
  obtain ⟨hi1, hi2⟩ := List.getElem?_eq_some_iff.mp hi
  obtain ⟨hj1, hj2⟩ := List.getElem?_eq_some_iff.mp hj
  exact (h.getElem_inj_iff).mp (hi2.trans hj2.symm)

/-- L7.5 helper (step 2-3 of L7.5): a configuration of the literal cap transports to the repaired
cap through `capRole`. -/
theorem config_cap_E1 {P : Prims.{u}} {E : Forest} (hL : Scan.InL E) (w : Closure.AdmCap E)
    {β : Role → Ordinal.{u}} (hK : IsConfig P (Closure.litCap E w.col w.cut w.par) β) :
    IsConfig P w.H (β ∘ capRole w) := by
  set K := Closure.litCap E w.col w.cut w.par with hKdef
  -- the literal cap: roles and labels (U2 `litCap_spec`)
  obtain ⟨col, hcol, hkc⟩ : ∃ col, E.colAt w.col = some col ∧ w.cut ≤ col.length := by
    have hup := w.upward
    unfold Closure.IsUpward at hup
    split at hup
    · rename_i col hc
      refine ⟨col, hc, ?_⟩
      split at hup
      · rename_i hk
        exact (List.getElem?_eq_some_iff.mp hk).1.le
      · omega
    · exact hup.elim
  have hcE : w.col ∈ E.colAddrs := (Tree.mem_colAddrs_iff _ _).mpr (by simp [hcol])
  have hkp : w.cut ≤ (Scan.parents E w.col).length := by simp [Scan.parents, hcol, hkc]
  obtain ⟨⟨m, hm⟩, hlab, -, hKN, -⟩ := Closure.litCap_spec (p := w.par) hcE hkp
  rw [← hKdef] at hm hlab hKN
  set S := E.roles.take m with hSdef
  set NK : Role := .slot ⟨w.col, w.cut⟩ with hNK
  have hKnd : (S ++ [NK]).Nodup := hm ▸ Tree.roles_nodup K
  have hNKS : NK ∉ S := fun h => (List.nodup_append.mp hKnd).2.2 NK h NK (List.mem_singleton_self _) rfl
  -- the stop data of `w.H` and its closing slot `N`, the last role
  obtain ⟨c', hup', hH', -⟩ := Closure.applyMoves_litCap hL.2.2.1 w.upward w.movesValid
  obtain ⟨sd, hsd⟩ : ∃ sd, Scan.stopData w.H = some sd :=
    ⟨_, (show w.H = _ from hH') ▸ Closure.stopData_litCap hup'⟩
  obtain ⟨-, -, -, hT, -⟩ := Closure.admCap_query hL w hsd
  obtain ⟨-, -, -, hNe, -, qs, hroles, -⟩ := Scan.stopData_roles hsd
  set N : Role := .slot (Scan.closingSlot sd) with hNdef
  have hroles' : w.H.roles = (rolesBefore w.H (.ord sd.col) ++ .ord sd.col :: qs) ++ [N] := by
    rw [hroles]; simp
  set L := rolesBefore w.H (.ord sd.col) ++ .ord sd.col :: qs
  have hnd : (L ++ [N]).Nodup := hroles' ▸ Tree.roles_nodup w.H
  have hNL : N ∉ L := fun h => (List.nodup_append.mp hnd).2.2 N h N (List.mem_singleton_self _) rfl
  have hlast : ∀ i x, w.H.roles[i]? = some x → x = N → i = L.length := by
    intro i x hi hx
    rw [hroles'] at hi
    by_contra hne
    rcases Nat.lt_or_gt_of_ne hne with h1 | h1
    · rw [List.getElem?_append_left h1] at hi
      exact hNL (hx ▸ List.mem_of_getElem? hi)
    · have : (L ++ [N]).length ≤ i := by simp; omega
      rw [List.getElem?_eq_none this] at hi; cases hi
  have hlen : w.H.roles.length = L.length + 1 := by rw [hroles']; simp
  have hNbefore : ∀ z ∈ w.H.roles, N ∉ rolesBefore w.H z := by
    intro z hz hNz
    obtain ⟨i, j, hi, hj, hij⟩ := exists_lt_of_mem_takeWhile_ne_E1 hNz hz
    have := hlast i N hi rfl
    have := (List.getElem?_eq_some_iff.mp hj).1
    omega
  -- origins exist off `N` and lie in `S`
  obtain ⟨-, hnone, -, -, -, -, hrep, hord⟩ := Closure.origin_spec_full hL w
  have hsome : ∀ x ∈ w.H.roles, x ≠ N → ∃ y, w.origin x = some y ∧ y ∈ S := by
    intro x hx hxN
    cases ho : w.origin x with
    | none =>
      obtain ⟨sd', hsd', rfl⟩ := (hnone x hx).mp ho
      rw [hsd] at hsd'; obtain rfl := Option.some.inj hsd'
      exact absurd rfl hxN
    | some y =>
      obtain ⟨hyK, hyN⟩ := origin_mem_litCap_E1 w hx ho
      rw [hm, List.mem_append, List.mem_singleton] at hyK
      exact ⟨y, rfl, hyK.resolve_right hyN⟩
  have hcapN : capRole w N = NK := by
    have : w.origin N = none := (hnone N (by rw [hroles']; simp)).mpr ⟨sd, hsd, rfl⟩
    simp [capRole, this, hNK]
  have hanc : ∀ x y, w.origin x = some y → anchorD E (some w) x = y := by
    intro x y h; simp [anchorD, Closure.anchorOrigin, h]
  -- positions of `S` in `K`
  have hidx : ∀ {x i}, x ∈ S → E.roles[i]? = some x → i < m ∧ K.roles[i]? = some x := by
    intro x i hxS hi
    obtain ⟨i', hi'⟩ := List.mem_iff_getElem?.mp hxS
    have hi'm : i' < m := by
      have := (List.getElem?_eq_some_iff.mp hi').1
      simp [hSdef] at this; omega
    rw [hSdef, List.getElem?_take_of_lt hi'm] at hi'
    obtain rfl := nodup_idx_E1 (Tree.roles_nodup E) hi hi'
    refine ⟨hi'm, ?_⟩
    have hilt := (List.getElem?_eq_some_iff.mp hi).1
    rw [hm, List.getElem?_append_left (by simp [hSdef]; omega), hSdef,
      List.getElem?_take_of_lt hi'm, hi]
  have hBK : ∀ x y, x ∈ S → y ∈ S → Before E x y → Before K x y := by
    rintro x y hx hy ⟨i, j, hi, hj, hij⟩
    exact ⟨i, j, (hidx hx hi).2, (hidx hy hj).2, hij⟩
  have hBKN : ∀ x ∈ S, Before K x NK := by
    intro x hx
    obtain ⟨i, hi⟩ := List.mem_iff_getElem?.mp hx
    have hiS := (List.getElem?_eq_some_iff.mp hi).1
    refine ⟨i, S.length, ?_, ?_, hiS⟩
    · rw [hm, List.getElem?_append_left hiS]; exact hi
    · rw [hm]; simp
  have hmemN : N ∈ w.H.roles := by rw [hroles']; simp
  have hNpre : ∀ x ∈ rolesBefore w.H N, x ≠ N := by
    intro x hx hxN
    have := Scan.mem_takeWhile_imp_of (p := fun y => y != N) hx
    simp [hxN] at this
  intro a ha
  rcases graph_atom_cases w.H a ha with ⟨i, x, y, rfl, hx, hy⟩ | ⟨z, hz, hown⟩
  · -- order atoms
    have hxH : x ∈ w.H.roles := List.mem_of_getElem? hx
    have hyH : y ∈ w.H.roles := List.mem_of_getElem? hy
    have hxN : x ≠ N := by
      intro hxN
      have := hlast i x hx hxN
      have := (List.getElem?_eq_some_iff.mp hy).1
      omega
    obtain ⟨x', hx', hx'S⟩ := hsome x hxH hxN
    show β (capRole w x) < β (capRole w y)
    rw [capRole_of_origin w hx']
    by_cases hyN : y = N
    · rw [hyN, hcapN]
      exact isConfig_before hK (hBKN x' hx'S)
    · obtain ⟨y', hy', hy'S⟩ := hsome y hyH hyN
      rw [capRole_of_origin w hy']
      have hB := (graph_origin hL (some w)).2 x y ⟨i, i + 1, hx, hy, by omega⟩
        (by simp [Closure.anchorOrigin, hx']) (by simp [Closure.anchorOrigin, hy'])
      rw [hanc x x' hx', hanc y y' hy'] at hB
      exact isConfig_before hK (hBK x' y' hx'S hy'S hB)
  · by_cases hzN : z = N
    · -- atoms owned by the closing slot
      rw [hzN] at hown
      rcases (mem_graph_iff w.H a).mp ha with ⟨x, -, rfl⟩ | ⟨i, x, y, -, -, rfl⟩ |
          ⟨c₁, -, -, rfl⟩ | ⟨e, p', o, v, hp', hrep', hav⟩
      · simp only [atomOwner, Option.some.injEq] at hown
        rw [hown]
        show IsLim (β (capRole w N))
        rw [hcapN]
        exact hK _ ((mem_graph_iff K _).mpr (Or.inl ⟨NK, by rw [hm]; simp, rfl⟩))
      · simp [atomOwner] at hown
      · simp [atomOwner, hNdef] at hown
      · have hse : Role.slot e = N := by
          rcases hav with rfl | rfl <;> simpa [atomOwner] using hown
        have he : e = Scan.closingSlot sd := Role.slot.inj hse
        subst he
        rw [hNe] at hp'
        simp only [Option.map_some, Option.some.injEq] at hp'
        subst hp'
        have hr : sd.r = w.par := (Closure.admCap_query hL w hsd).2.1
        have hTmem : Role.ord sd.col ∈ w.H.roles := Scan.stopData_col_mem hsd
        have hrep'' : sd.col.rep 0 sd.r = some (o, v) := hrep'
        have hrq : sd.r < sd.col.num 0 := (rep_isSome_iff _ _).mp (by rw [hrep'']; rfl)
        have hcrep := hrep sd.col w.col hTmem hT sd.r hrq
        rw [hrep''] at hcrep
        have hcsE : Scan.closingSlot sd ∈ w.H.entryAddrs := by
          rw [Tree.mem_entryAddrs_iff, hNe]; rfl
        obtain ⟨ho, hv'⟩ := rep_mem_prefix hcsE hrep''
        obtain ⟨o', ho', -⟩ := hsome o ((List.takeWhile_sublist _).subset ho) (hNpre o ho)
        obtain ⟨v', hv'', -⟩ := hsome v ((List.takeWhile_sublist _).subset hv') (hNpre v hv')
        simp only [Option.map_some] at hcrep
        rw [hanc o o' ho', hanc v v' hv'', hr] at hcrep
        have hKe : ∀ t, t = o' ∨ t = v' → BaseAtom.edge NK (.ord w.col) t ∈ graph K := by
          intro t ht
          refine (mem_graph_iff K _).mpr (Or.inr (Or.inr (Or.inr ⟨⟨w.col, w.cut⟩, w.par, o', v',
            by rw [hKN]; rfl, hcrep.symm, ?_⟩)))
          rcases ht with rfl | rfl
          · exact Or.inl rfl
          · exact Or.inr rfl
        have hcT : capRole w (.ord sd.col) = .ord w.col := capRole_of_origin w hT
        rcases hav with rfl | rfl
        · show P.Edge (β (capRole w N)) (β (capRole w (.ord sd.col))) (β (capRole w o))
          rw [hcapN, hcT, capRole_of_origin w ho']
          exact hK _ (hKe o' (Or.inl rfl))
        · show P.Edge (β (capRole w N)) (β (capRole w (.ord sd.col))) (β (capRole w v))
          rw [hcapN, hcT, capRole_of_origin w hv'']
          exact hK _ (hKe v' (Or.inr rfl))
    · -- atoms owned before the closing slot: D6.1b into `Γ(E)`, then into `Γ(K)`
      have hvars : ∀ v ∈ a.vars, ∃ y, w.origin v = some y ∧ y ∈ S := by
        intro v hv
        have hvown : a ∈ ownedBy (graph w.H) z := by
          unfold ownedBy; rw [List.mem_filter]; exact ⟨ha, by simp [hown]⟩
        rcases owned_before hvown hv with h1 | rfl
        · have hvH : v ∈ w.H.roles := (List.takeWhile_sublist _).subset h1
          refine hsome v hvH ?_
          rintro rfl; exact hNbefore z hz h1
        · exact hsome v hz hzN
      have hown' : atomOwner (a.map (anchorD E (some w))) ≠ none := by
        rw [atomOwner_map, hown]; simp
      have hG := ((graph_origin hL (some w)).1 _ hown').mp ⟨a, ha, fun v hv => by
        obtain ⟨y, hy, -⟩ := hvars v hv; simp [Closure.anchorOrigin, hy], rfl⟩
      have hres : a.map (anchorD E (some w)) ∈ restrictTo (graph E) S := by
        unfold restrictTo
        rw [List.mem_filter]
        refine ⟨hG.1, ?_⟩
        rw [List.all_eq_true]
        intro v hv
        rw [baseAtom_vars_map, List.mem_map] at hv
        obtain ⟨v0, hv0, rfl⟩ := hv
        obtain ⟨y, hy, hyS⟩ := hvars v0 hv0
        rw [hanc v0 y hy]; simpa using hyS
      have hlab' : ∀ e, Role.slot e ∈ S →
          (E.entryAt e).map Prod.fst = (K.entryAt e).map Prod.fst := by
        intro e he
        have heK : e ∈ K.entryAddrs := by
          rw [Tree.mem_entryAddrs_iff]
          have : Role.slot e ∈ K.roles := by rw [hm]; exact List.mem_append_left _ he
          simpa [Tree.mem_roles_iff] using this
        have hne : e ≠ ⟨w.col, w.cut⟩ := by rintro rfl; exact hNKS he
        exact (hlab e heK hne).symm
      have hSK : S <+: K.roles := by rw [hm]; exact List.prefix_append _ _
      have hSE : S <+: E.roles := List.take_prefix _ _
      have hresK := restrict_graph_of_common hSE hSK hlab' _ hres
      have hgK : a.map (anchorD E (some w)) ∈ graph K := by
        unfold restrictTo at hresK; exact (List.mem_filter.mp hresK).1
      have h1 := hK _ hgK
      rw [BaseAtom.holds_map] at h1
      refine (amalg_baseAtom_congr P a ?_).mp h1
      intro v hv
      obtain ⟨y, hy, -⟩ := hvars v hv
      simp [Function.comp, hanc v y hy, capRole_of_origin w hy]


theorem frame_map_comp_E1 {U V W : Type} (f : V → W) (g : U → V) (fr : Frame U) :
    fr.map (f ∘ g) = (fr.map g).map f := by
  simp [Frame.map, List.map_map]

-- provides: U3, L7.5 (the spine's `joint_repair`†; consumer: U5 L8.8 Case 3)
theorem joint_repair {P : Prims.{u}} (pk : SourcePacket.{u}) (hadm : pk.rk.Admitted)
    (hv : pk.Valid P) {c : ColAddr} {k p : Nat} (hfd : pk.rk.firstDiff = .capAt c k p)
    (w : Closure.AdmCap pk.rk.E) (hw : w.col = c ∧ w.cut = k ∧ w.par = p) :
    let κ := capChart pk
    let bm := Closure.moveAddr w.moves pk.rk.b
    let α := pk.asg ∘ κ ∘ capRole w
    IsConfig P w.H α ∧
    α (.slot bm) = pk.asg pk.owner ∧ α (.ord bm.col) = pk.asg pk.host ∧
    (frameOf bm).map (κ ∘ capRole w) = pk.tgtFrame ∧
    (∀ x ∈ prefixRoles w.H bm, κ (capRole w x) = pk.tgtChart (capRole w x)) ∧
    (∀ sd, Scan.stopData w.H = some sd →
      α (.ord sd.col) = pk.asg (κ (.ord c)) ∧
      α (.slot (Scan.closingSlot sd)) = pk.asg (κ (.slot ⟨c, k⟩)) ∧
      ∀ x ∈ rolesBefore w.H (.ord sd.col), α x < α (.ord sd.col)) ∧
    (∀ x y, Closure.anchorOrigin pk.rk.E (some w) x = some y → κ y = κ (capRole w x)) := by
  dsimp only
  have hstd : IsStd pk.rk.E := hadm.1
  have hL : Scan.InL pk.rk.E := Closure.std_inL hstd
  obtain ⟨hbc, -, hup, -⟩ := firstDiff_cap hadm hfd
  have hbc' : pk.rk.b.heightPath <+: w.col.path := hw.1 ▸ hbc
  have hout := repair_moves_outside hadm hfd w hw
  have hFR := frame_repair hstd w hadm.2.1 hbc' hout
  dsimp only at hFR
  obtain ⟨-, hOc⟩ := origin_moveAddr hL w hbc' hout
  have JC := joint_cap pk hadm hv hfd
  dsimp only at JC
  obtain ⟨hKcfg, hκtgt, hκown, -, -, -, hbelow, -, -⟩ := JC
  have hfr := frameOf_mem_prefix hadm.2.1
  obtain ⟨hwc, hwk, hwp⟩ := hw
  subst hwc hwk hwp
  refine ⟨config_cap_E1 hL w hKcfg, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · show pk.asg (capChart pk (capRole w (.slot (Closure.moveAddr w.moves pk.rk.b)))) = _
    rw [hFR.2.1, hκown]
  · show pk.asg (capChart pk (capRole w (.ord (Closure.moveAddr w.moves pk.rk.b).col))) = _
    rw [capRole_of_origin w hOc, hκtgt _ hfr.1, hv.2.2.1]
  · rw [frame_map_comp_E1, hFR.1]
    simp only [SourcePacket.tgtFrame, frameOf, Frame.map, Frame.mk.injEq]
    refine ⟨hκtgt _ hfr.1, List.map_congr_left fun ov hov => ?_⟩
    rw [hκtgt _ (hfr.2 ov hov).1, hκtgt _ (hfr.2 ov hov).2]
  · intro x hx
    exact hκtgt _ (hFR.2.2.1 x hx)
  · intro sd hsd
    obtain ⟨-, -, -, hT, -⟩ := Closure.admCap_query hL w hsd
    have hcT : capRole w (.ord sd.col) = .ord w.col := capRole_of_origin w hT
    obtain ⟨-, -, -, hNe, -⟩ := Scan.stopData_roles hsd
    have hNmem : Role.slot (Scan.closingSlot sd) ∈ w.H.roles := by
      rw [Tree.mem_roles_iff]; simp [hNe]
    have hNo : w.origin (.slot (Scan.closingSlot sd)) = none :=
      ((Closure.origin_spec_full hL w).2.1 _ hNmem).mpr ⟨sd, hsd, rfl⟩
    refine ⟨?_, ?_, ?_⟩
    · show pk.asg (capChart pk (capRole w (.ord sd.col))) = _
      rw [hcT]
    · show pk.asg (capChart pk (capRole w _)) = _
      simp [capRole, hNo]
    · intro x hx
      obtain ⟨T', hT', -, hpre⟩ := Closure.anchorOrigin_prefix (cap := some w) w.inL hsd
      have hT'' : T' = .ord w.col := by
        have : Closure.anchorOrigin pk.rk.E (some w) (.ord sd.col) = some (.ord w.col) := hT
        rw [this] at hT'; exact (Option.some.inj hT').symm
      subst hT''
      obtain ⟨y, hy, hyb, -⟩ := hpre x hx
      show pk.asg (capChart pk (capRole w x)) < pk.asg (capChart pk (capRole w (.ord sd.col)))
      rw [capRole_of_origin w hy, hcT]
      apply hbelow
      rw [(litCap_rolesBefore_col hup).2]
      exact hyb
  · intro x y h
    rw [capRole_of_origin w h]

namespace SourcePacket

variable (pk : SourcePacket.{u})

/-- D7.2c: every name of a packet whose value is fixed by readmission. -/
def usedNames : List Name := pk.lowNames ++ [pk.owner]

end SourcePacket

/-- L7.5b: readmission after a confined source reduction (§8.5 Case 2): same target data, same
source prefix, the marked slot and its new height under fresh names with values `δ`. -/
noncomputable def readmitHeight (pk : SourcePacket.{u}) (F' : Forest) (kind' : RecKind pk.rk.E)
    (δ : Role → Ordinal.{u}) : SourcePacket.{u} :=
  let tg := freshTag pk.usedNames
  { rk := { pk.rk with F := F', kind := kind' }
    tgtChart := pk.tgtChart
    srcChart := fun x => if x ∈ prefixRoles pk.rk.F pk.rk.a then pk.srcChart x else .role tg x
    aux := pk.aux
    asg := fun nm => match nm with
      | .role t x => if t = tg then δ x else pk.asg nm
      | .aux _ => pk.asg nm }

-- provides: U3, L7.5b (closure of the packet class under §8.5 Case 2; consumer: U5 L8.8)
theorem readmit_height {P : Prims.{u}} (pk : SourcePacket.{u}) (hadm : pk.rk.Admitted)
    (hv : pk.Valid P) {A'' : Forest} (kind' : RecKind pk.rk.E)
    (hadm' : ({ pk.rk with F := pk.rk.F.setHeight pk.rk.a A'', kind := kind' } : SrcRecord).Admitted)
    (δ : Role → Ordinal.{u})
    (hgraph : BaseHolds P (graph (pk.rk.F.setHeight pk.rk.a A''))
      (fun x => if x ∈ prefixRoles pk.rk.F pk.rk.a then pk.asg (pk.srcChart x) else δ x))
    (hheads : ∃ o v, pk.tgtFrame.reps[pk.rk.tgtSel]? = some (o, v) ∧
      P.Edge (δ (.slot pk.rk.a)) (pk.asg pk.host) (pk.asg o) ∧
      P.Edge (δ (.slot pk.rk.a)) (pk.asg pk.host) (pk.asg v))
    (hlow : ∀ x ∈ pk.lowNames, pk.asg x < δ (.slot pk.rk.a)) :
    let pk' := readmitHeight pk (pk.rk.F.setHeight pk.rk.a A'') kind' δ
    pk'.rk.Admitted ∧ pk'.Valid P ∧ pk'.asg pk'.owner = δ (.slot pk.rk.a) ∧
    pk'.host = pk.host ∧ pk'.tgtFrame = pk.tgtFrame ∧ pk'.lowNames = pk.lowNames ∧
    (∀ x ∈ pk.lowNames, pk'.asg x = pk.asg x) ∧ pk'.rk.tgtKey = pk.rk.tgtKey ∧
    pk'.rk.tgtSel = pk.rk.tgtSel := by sorry

/-- L7.5c: readmission after the repaired-cap descent (§8.5 Case 3): a repair record for the
original target; the source prefix is the surviving restriction of the target prefix (names
`tgtChart ∘ capRole`); the marked slot and height of the output get fresh names with values `γ`;
all old names get the values `b'`. -/
noncomputable def readmitRepair (pk : SourcePacket.{u}) (w : Closure.AdmCap pk.rk.E) (Hk : Forest)
    (γ : Role → Ordinal.{u}) (b' : Name → Ordinal.{u}) : SourcePacket.{u} :=
  let tg := freshTag pk.usedNames
  let bm := Closure.moveAddr w.moves pk.rk.b
  { rk := { E := pk.rk.E, b := pk.rk.b, F := Hk.truncAfter bm, a := bm, kind := .repair w.moves }
    tgtChart := pk.tgtChart
    srcChart := fun x =>
      if x ∈ prefixRoles (Hk.truncAfter bm) bm then pk.tgtChart (capRole w x) else .role tg x
    aux := pk.aux
    asg := fun nm => match nm with
      | .role t x => if t = tg then γ x else b' nm
      | .aux _ => b' nm }

-- provides: U3, L7.5c (closure of the packet class under §8.5 Case 3; consumer: U5 L8.8)
theorem readmit_repair {P : Prims.{u}} (pk : SourcePacket.{u}) (hadm : pk.rk.Admitted)
    (hv : pk.Valid P) {c : ColAddr} {k p : Nat} (hfd : pk.rk.firstDiff = .capAt c k p)
    (w : Closure.AdmCap pk.rk.E) (hw : w.col = c ∧ w.cut = k ∧ w.par = p)
    {n : Nat} {Hk : Forest} (hexp : expand w.H n = some Hk) (habove : pk.rk.E < Hk)
    (γ : Role → Ordinal.{u}) (b' : Name → Ordinal.{u})
    (hsrc : BaseHolds P (graph (Hk.truncAfter (Closure.moveAddr w.moves pk.rk.b))) γ)
    (hshare : ∀ x ∈ prefixRoles w.H (Closure.moveAddr w.moves pk.rk.b),
      γ x = b' (pk.tgtChart (capRole w x)))
    (htgt : BaseHolds P ((prefixGraph pk.rk.E pk.rk.b).map (BaseAtom.map pk.tgtChart)) b')
    (haux : pk.aux.Holds P b')
    (hheads : ∃ o v, pk.tgtFrame.reps[pk.rk.tgtSel]? = some (o, v) ∧
      P.Edge (γ (.slot (Closure.moveAddr w.moves pk.rk.b))) (b' pk.host) (b' o) ∧
      P.Edge (γ (.slot (Closure.moveAddr w.moves pk.rk.b))) (b' pk.host) (b' v))
    (hlow : ∀ x ∈ pk.lowNames, b' x < γ (.slot (Closure.moveAddr w.moves pk.rk.b))) :
    let bm := Closure.moveAddr w.moves pk.rk.b
    let pk' := readmitRepair pk w Hk γ b'
    pk'.rk.Admitted ∧ pk'.Valid P ∧ pk'.asg pk'.owner = γ (.slot bm) ∧ pk'.host = pk.host ∧
    pk'.tgtFrame = pk.tgtFrame ∧ (∀ x ∈ pk.lowNames, pk'.asg x = b' x) ∧
    pk'.rk.tgtKey = pk.rk.tgtKey ∧ pk'.rk.tgtSel = pk.rk.tgtSel ∧ pk'.rk.E = pk.rk.E ∧
    pk'.rk.b = pk.rk.b := by sorry

-- SCR2 applied at integration: the bridge holds by `rfl`
theorem ScanSetup.valid_iff_def (S : ScanSetup.{u}) (P : Prims.{u}) :
    S.Valid P ↔ S.ValidDef P := Iff.rfl

/-! ## L7.6a  The explicit packet at a scan state and the fitting extension -/

namespace ScanSetup

variable (S : ScanSetup.{u})

/-- L7.6a: names already used by the setup (target prefix, `ρ`, bank, auxiliary data). -/
def usedNames : List Name :=
  S.PE.map S.ePre ++ [S.stopNm] ++ S.bankRoles.map S.bankNm ++ S.aux.vars

/-- L7.6a: the fresh tag of the fitted target names. -/
def fitTag : Nat := freshTag S.usedNames

/-- L7.6a: the stopping column of the anchor read in `E`. -/
def cE : ColAddr := match S.TE with
  | .ord c => c
  | .slot _ => S.sd.col

/-- L7.6a: a role of `E` inside the query column, read in `H`. -/
def toH (y : Role) : Role := transColumn S.cE S.sd.col id y

/-- L7.6a: the target chart of the scan packet: `ePre` on `P_E`, `ρ` on `T_E`, fresh fitted names
on the earlier query entries. -/
def pkTgtChart (y : Role) : Name :=
  if y ∈ S.PE then S.ePre y else if y = S.TE then S.stopNm else .role S.fitTag (S.toH y)

/-- L7.6a: the source chart of the scan packet: the shared pre-root chart, `ρ` on `R`, the bank. -/
def pkSrcChart (x : Role) : Name :=
  if x ∈ S.preRoot then S.ePre (S.chi x) else if x = S.R then S.stopNm else S.bankNm x

/-- L7.6a: the joint assignment: fitted names read `β`, all other names keep the setup's values. -/
noncomputable def pkAsg (β : Role → Ordinal.{u}) (nm : Name) : Ordinal.{u} :=
  match nm with
  | .role tg x => if tg = S.fitTag then β x else S.asg nm
  | .aux _ => S.asg nm

/-- L7.6a: the complete source packet at scan state `(i, j)`. -/
noncomputable def scanPacket (i j : Nat) (β : Role → Ordinal.{u}) : SourcePacket.{u} :=
  { rk := S.scanRecord i j, tgtChart := S.pkTgtChart, srcChart := S.pkSrcChart, aux := S.aux,
    asg := S.pkAsg β }

/-- L7.6a: the fitting of query entry `j` read off a target block `γ`. -/
noncomputable def extendFit (j : Nat) (β : Role → Ordinal.{u}) (γ : BlkVar → Ordinal.{u})
    (x : Role) : Ordinal.{u} :=
  if x ∈ S.entryRoles j then
    (if x = .slot ⟨S.sd.col, j⟩ then γ .owner
      else γ (.inner (relRole (EntryAddr.heightPath ⟨S.sd.col, j⟩) x)))
  else β x

end ScanSetup

-- L7.6a `scanPacket_spec` and L7.6 `scan_packet`: moved below L7.6b `fit_of_block` (brief rule 5;
-- names and statements unchanged; nothing in between uses them).

/-! ## Integration additions (nodes D7.1b, L6.2e, L6.2f, D7.2d, L7.6b, L4.3d, L7.5d; requested
by U5 R10, R18, R19, R22, R23, R25–R27, R29, R30; formerly stubs in `U5.lean`) -/

-- provides: U3, D7.1b (requested by U5 R18, second conjunct): the block map agrees with the frame
-- of `e` on every frame variable.
theorem blockMap_frame (e : EntryAddr) :
    ∀ w x, (frameOf e).toFr w = some x → blockMap e w = x := by
  intro w x hw
  cases w with
  | host => simpa [frameOf, Frame.toFr, blockMap] using hw
  | ord q =>
    simp only [frameOf, Frame.toFr, reps0_getElem?] at hw
    simp [blockMap, hw]
  | cur q =>
    simp only [frameOf, Frame.toFr, reps0_getElem?] at hw
    simp [blockMap, hw]
  | owner => simp [Frame.toFr] at hw
  | inner r => simp [Frame.toFr] at hw

-- provides: U3, D7.1b (requested by U5 R10): every number below a column's printed number is
-- visible, so `reps0` has one pair per number, and `reps0[q]? = rep 0 q`.
theorem reps0_length (c : ColAddr) : c.reps0.length = c.num 0 := by
  apply Nat.le_antisymm
  · by_contra hc
    have h1 := reps0_getElem? c (c.num 0)
    rw [List.getElem?_eq_getElem (by omega)] at h1
    have := (rep_isSome_iff c (c.num 0)).1 (by rw [← h1]; rfl)
    omega
  · by_contra hc
    have h1 := reps0_getElem? c (c.num 0 - 1)
    rw [List.getElem?_eq_none (by omega)] at h1
    have := (rep_isSome_iff c (c.num 0 - 1)).2 (by omega)
    rw [← h1] at this
    simp at this

-- provides: U3, D7.1b (requested by U5 R10): a column whose stack passes through column `c` sees
-- `c`'s frame below `c`'s number.
theorem reps0_take {c d : ColAddr} (h : d.resolve 0 (c.num 0) = some c) :
    d.reps0.take (c.num 0) = c.reps0 := by
  apply List.ext_getElem?
  intro q
  rw [List.getElem?_take, reps0_getElem?, reps0_getElem?]
  split_ifs with hq
  · exact (rep_visible d c h q hq).symm
  · cases hr : c.rep 0 q with
    | none => rfl
    | some _ =>
      have := (rep_isSome_iff c q).1 (by rw [hr]; rfl)
      omega

-- provides: U3, L6.2e (requested by U5 R22, stage zero): `H[0]` is the restriction to `P`, and
-- `f_0` is the identity on `D`.
theorem stage_zero {H : Forest} (hL : Scan.InL H) {rs : RoleSets} (hrs : roleSets H = some rs)
    {G : Forest} (hG : expand H 0 = some G) :
    G.roles = rs.P ∧ (∀ a ∈ graph G, a ∈ graph H) ∧ ∀ x ∈ rs.D, fMap H 0 0 x = x := by
  unfold roleSets at hrs
  cases hsd : Scan.stopData H with
  | none => rw [hsd] at hrs; simp at hrs
  | some sd =>
  cases hrd : Scan.rootData H with
  | none => rw [hsd, hrd] at hrs; simp at hrs
  | some rd =>
  rw [hsd, hrd] at hrs
  simp only [Option.pure_def, Option.bind_eq_bind, Option.bind_some, Option.some.injEq] at hrs
  subst hrs
  have hk : Scan.stepKind H = some .ordinary := by
    have h1 : Scan.rootDataBody H = some rd := hrd
    unfold Scan.rootDataBody at h1
    show Scan.stepKindBody H = _
    split at h1
    · assumption
    · simp at h1
  have hne : H ≠ Tree.empty := by
    rintro rfl; simp [Scan.stepKind, Scan.stepKindBody, Tree.empty, Tree.cols] at hk
  obtain ⟨hV, hI, -⟩ := hL
  rw [Scan.expand_eq_paperOp hne hV hI, Scan.paperOp_ordinary_zero hk hsd] at hG
  cases hG
  obtain ⟨-, -, -, hmem, hlast, hlen⟩ := Scan.stopData_spec hsd
  have hroute : (Scan.routeCols H)[sd.depth]? = some sd.col := by
    rw [List.getLast?_eq_getElem?, hlen] at hlast
    simpa using hlast
  have hroles : (Scan.Hole.put ⟨H, sd.depth⟩ Tree.empty).roles = rolesBefore H (.ord sd.col) := by
    show (replaceAt 0 0 Tree.empty sd.depth H).roles = _
    rw [roles_replaceAt 0 0 sd.depth Tree.empty H (π := sd.col.path) (c := sd.col.col)
      (by simpa using hroute)]
    simp [Tree.empty, Tree.roles, Tree.rolesF, Tree.rolesCols]
  refine ⟨hroles, fun a ha => ?_, fun x _ => rfl⟩
  have hpre : (Scan.Hole.put ⟨H, sd.depth⟩ Tree.empty).roles <+: H.roles := by
    rw [hroles]; exact List.takeWhile_prefix _
  have hlab : ∀ e', Role.slot e' ∈ (Scan.Hole.put ⟨H, sd.depth⟩ Tree.empty).roles →
      ((Scan.Hole.put ⟨H, sd.depth⟩ Tree.empty).entryAt e').map Prod.fst = (H.entryAt e').map Prod.fst := by
    intro e' he'
    rw [Tree.mem_roles_iff] at he'
    obtain ⟨y, hy⟩ := Option.isSome_iff_exists.1 he'
    obtain ⟨h', hh'⟩ := labelSub_replaceAt_empty sd.depth H e' y hy
    rw [hy, hh']; rfl
  have := restrict_graph_of_common (List.prefix_refl _) hpre hlab a ((restrict_graph_self _ a).2 ha)
  unfold restrictTo at this
  exact (List.mem_filter.1 this).1

-- provides: U3, L6.2e (requested by U5 R22, one stage): roles and elementarity atoms of `H[m+1]`
-- from `H[m]`.
theorem stage_succ {H : Forest} (hL : Scan.InL H) {rs : RoleSets} (hrs : roleSets H = some rs)
    {m : Nat} {G G' : Forest} (hG : expand H m = some G) (hG' : expand H (m + 1) = some G') :
    G'.roles = G.roles ++ (fMap H (m + 1) (m + 1) rs.R ::
      (rs.Q.map (qMap H (m + 1) (m + 1)) ++ rs.K.map (fMap H (m + 1) (m + 1)))) ∧
    qMap H (m + 1) (m + 1) rs.T = fMap H (m + 1) (m + 1) rs.R ∧
    (∀ x ∈ rs.D, qMap H (m + 1) (m + 1) x = fMap H m m x) ∧
    (∀ x ∈ rolesBefore H rs.R, fMap H (m + 1) (m + 1) x = x) ∧
    ∀ a ∈ graph G', isStruct a = true → a ∈ graph G ∨
      (∃ a' ∈ queryAtoms H rs, isStruct a' = true ∧ a = a'.map (qMap H (m + 1) (m + 1))) ∨
      (∃ a' ∈ retAtoms H rs, a = a'.map (fMap H (m + 1) (m + 1))) := by sorry

/-- L6.2e helper: the reading order of `H` around the stopping column: `P`, `T`, `Q`, `N`. -/
theorem roleSets_roles {H : Forest} {rs : RoleSets} (hrs : roleSets H = some rs) :
    ∃ B, H.roles = rs.P ++ rs.T :: (rs.Q ++ rs.N :: B) := by
  obtain ⟨sd, rd, hsd, hrd, rfl⟩ := roleSets_unfold hrs
  simp only
  obtain ⟨hcolT, -⟩ := Scan.stopData_spec hsd
  obtain ⟨A, B, hAB⟩ := roles_col_decomp hcolT
  have hlastc : Tree.rolesCol sd.col.path sd.col.col (0 + sd.Q.length) [(sd.r, Tree.empty)] =
      [Role.slot (Scan.closingSlot sd)] := by
    simp [Tree.rolesCol, Tree.rolesF, Tree.rolesCols, Tree.empty, Scan.closingSlot]
  rw [Tree.rolesCol_append, hlastc] at hAB
  set QR := Tree.rolesCol sd.col.path sd.col.col 0 sd.Q
  have hroles : H.roles = A ++ Role.ord sd.col :: (QR ++ Role.slot (Scan.closingSlot sd) :: B) := by
    rw [hAB]; simp
  have hnd := Tree.roles_nodup H
  rw [hroles] at hnd
  have hP : H.roles.takeWhile (· != Role.ord sd.col) = A := by
    rw [hroles]; exact takeWhile_ne_of_decomp hnd
  have hnd2 : (QR ++ Role.slot (Scan.closingSlot sd) :: B).Nodup :=
    (List.nodup_cons.1 (List.nodup_append.1 hnd).2.1).2
  have hQ : ((H.roles.dropWhile (· != Role.ord sd.col)).drop 1).takeWhile
      (· != Role.slot (Scan.closingSlot sd)) = QR := by
    rw [hroles, List.dropWhile_append_of_pos, List.dropWhile_cons_of_neg (by simp), List.drop_one,
      List.tail_cons, takeWhile_ne_of_decomp hnd2]
    intro y hy
    simp only [bne_iff_ne, ne_eq]
    rintro rfl
    exact (List.nodup_append.1 hnd).2.2 _ hy _ (List.mem_cons_self ..) rfl
  rw [hP, hQ]
  exact ⟨B, hroles⟩

-- provides: U3, L6.2e (requested by U5 R23, txt:941): structural query atoms read only
-- `D ∪ {T} ∪ Q`.
theorem queryAtoms_struct_vars {H : Forest} (hL : Scan.InL H) {rs : RoleSets}
    (hrs : roleSets H = some rs) :
    ∀ a ∈ queryAtoms H rs, isStruct a = true → ∀ v ∈ a.vars,
      v ∈ rs.D ∨ v = rs.T ∨ v ∈ rs.Q := by
  obtain ⟨sd, rd, -, hrd, -⟩ := roleSets_unfold hrs
  have hk := stepKind_of_rootData hrd
  have hor := (owned_reads hL hk hrs).1
  obtain ⟨B, hroles⟩ := roleSets_roles hrs
  have hnd := Tree.roles_nodup H
  rw [hroles] at hnd
  have hPpre : rs.P <+: H.roles := by rw [hroles]; exact List.prefix_append _ _
  intro a ha hs v hv
  unfold queryAtoms restrictTo at ha
  rw [List.mem_filter, List.mem_filter] at ha
  obtain ⟨⟨ha, hvars⟩, hany⟩ := ha
  have hvars' : ∀ w ∈ a.vars, w ∈ rs.P ++ [rs.T] ++ rs.Q := by simpa using hvars
  obtain ⟨w, hw, hwTQ⟩ : ∃ w ∈ a.vars, w ∈ rs.T :: rs.Q := by simpa using hany
  -- the owner of a structural atom is one of its variables
  obtain ⟨z, hz, hzv⟩ : ∃ z, atomOwner a = some z ∧ z ∈ a.vars := by
    cases a <;> simp_all [isStruct, atomOwner, BaseAtom.vars]
  have hown : a ∈ ownedBy (graph H) z := by
    unfold ownedBy; rw [List.mem_filter]; exact ⟨ha, by simp [hz]⟩
  have hzS := hvars' z hzv
  have hzS' : z ∈ rs.P ∨ z ∈ rs.T :: rs.Q := by
    simp only [List.mem_append, List.mem_singleton] at hzS
    rcases hzS with (h | h) | h
    · exact Or.inl h
    · exact Or.inr (List.mem_cons.2 (Or.inl h))
    · exact Or.inr (List.mem_cons_of_mem _ h)
  rcases hzS' with hzP | hzTQ
  · exfalso
    have hwP : w ∈ rs.P := by
      rcases owned_before hown hw with h | rfl
      · exact rolesBefore_sub_prefix hPpre hzP h
      · exact hzP
    rw [List.nodup_append] at hnd
    have : w ∈ rs.T :: (rs.Q ++ rs.N :: B) := by
      rcases List.mem_cons.1 hwTQ with h | h
      · exact List.mem_cons.2 (Or.inl h)
      · exact List.mem_cons_of_mem _ (List.mem_append_left _ h)
    exact hnd.2.2 _ hwP _ this rfl
  · rcases hor z hzTQ a hown v hv with h | h
    · exact Or.inl h
    · rcases List.mem_cons.1 h with h | h
      · exact Or.inr (Or.inl h)
      · exact Or.inr (Or.inr h)

-- provides: U3, L6.2f (requested by U5 R27): roles and elementarity atoms of a special output:
-- the prefix `P(H, e)` and `N = n + ε` copies of the shortened positive block.
theorem special_graph {H : Forest} (hL : Scan.InL H) (hk : Scan.stepKind H = some .special)
    {sd : Scan.StopData} {e : EntryAddr} (hsd : Scan.stopData H = some sd)
    (he : sd.ownerEntry = some e) {k : Nat} {H' : Forest} (hH' : expand H k = some H') :
    ∃ (N : Nat) (cm : Nat → BlkVar → Role),
      H'.roles = prefixRoles H e ++ (List.range N).flatMap (fun i =>
        (BlkVar.owner :: (specialKey H e).roles.map BlkVar.inner).map (cm i)) ∧
      (∀ i w x, (frameOf e).toFr w = some x → cm i w = x) ∧
      ∀ a ∈ graph H', isStruct a = true →
        (a ∈ graph H ∧ ∀ v ∈ a.vars, v ∈ prefixRoles H e) ∨
        ∃ i < N, ∃ a' ∈ posBlock (specialKey H e) (entrySel H e), a = a'.map (cm i) := by
  have hH : H ≠ Tree.empty := by
    rintro rfl; simp [Scan.stepKind, Scan.stepKindBody, Tree.empty, Tree.cols] at hk
  obtain ⟨hV, hI, -⟩ := hL
  obtain ⟨p, Fl, hent, hroles, hcopies, G, hGr, hGH, hGH'⟩ := special_struct hH hV hI hk hsd he hH'
  have hheight : H.heightAt e = some Fl := by simp [Tree.heightAt, hent]
  have hkey : specialKey H e = relKey (e.col.num 0) (Tree.node Fl.cols.dropLast) := by
    simp [specialKey, hheight]
  have hsel : entrySel H e = p := by simp [entrySel, hent]
  refine ⟨k + (if e.idx = 0 then 1 else 0), fun i => blockMap ⟨e.col, e.idx + i⟩, ?_, ?_, ?_⟩
  · rw [hroles, hkey, relKey_roles]
    congr 1
    apply List.flatMap_congr
    intro i _
    simp only [List.map_cons, List.map_map]
    rfl
  · intro i w x hw
    exact blockMap_frame ⟨e.col, e.idx + i⟩ w x hw
  · intro a ha hs
    obtain ⟨z, hzr, hz⟩ : ∃ z ∈ H'.roles, atomOwner a = some z := by
      rcases graph_atom_cases H' a ha with ⟨i, x, y, rfl, -⟩ | h
      · simp [isStruct] at hs
      · exact h
    have hown : a ∈ ownedBy (graph H') z := by
      unfold ownedBy; rw [List.mem_filter]; exact ⟨ha, by simp [hz]⟩
    have hS' : G.roles <+: H'.roles := by rw [hGr, hroles]; exact List.prefix_append _ _
    have hS : G.roles <+: H.roles := by rw [hGr]; exact List.takeWhile_prefix _
    rw [hroles, List.mem_append] at hzr
    rcases hzr with hzP | hzc
    · left
      rw [← hGr]
      exact owned_common_prefix hGH hGH' hS hS' (by rw [hGr]; exact hzP) hown
    · right
      obtain ⟨i, hi, hzi⟩ := List.mem_flatMap.1 hzc
      rw [List.mem_range] at hi
      have hei : (⟨e.col, e.idx + i⟩ : EntryAddr) ∈ H'.entryAddrs := by
        rw [Tree.mem_entryAddrs_iff, hcopies i hi]; rfl
      have hzz : z = .slot ⟨e.col, e.idx + i⟩ ∨
          (⟨e.col, e.idx + i⟩ : EntryAddr).heightPath <+: z.path := by
        rcases List.mem_cons.1 hzi with h | h
        · exact Or.inl h
        · obtain ⟨r, -, rfl⟩ := List.mem_map.1 h
          exact Or.inr ⟨r.path, by rw [Role.path_under]⟩
      obtain ⟨a₀, ha₀, rfl⟩ := graph_owned_block_core hei z hzz a hown
      refine ⟨i, hi, a₀, ?_, rfl⟩
      have h1 : H'.heightAt ⟨e.col, e.idx + i⟩ = some (Tree.node Fl.cols.dropLast) := by
        simp [Tree.heightAt, hcopies i hi]
      rw [h1, hcopies i hi] at ha₀
      rw [hkey, hsel]
      simpa using ha₀

-- provides: U3, D7.2d (requested by U5 R25): the target of the scan record at `(i, j)` is query
-- entry `j`'s height.
theorem scanRecord_tgtHeight {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) {i j : Nat}
    (hj : j < S.sd.Q.length) :
    (S.scanRecord i j).tgtHeight = ((S.sd.Q[j]?).map Prod.snd).getD Tree.empty := by
  obtain ⟨⟨hstd, -, -, hsd, -, -, -⟩, -⟩ := hS
  simp only [SrcRecord.tgtHeight, ScanSetup.scanRecord]
  have hQj : S.sd.Q[j]? = some S.sd.Q[j] := List.getElem?_eq_getElem hj
  simp only [ScanSetup.H] at hsd
  revert hsd
  generalize S.cap = cap
  intro hsd
  cases cap with
  | none =>
    simp only [Closure.anchorOrigin]
    have hcol := (Scan.stopData_spec hsd).1
    simp only [Closure.anchor] at hcol
    simp only [Tree.heightAt, Tree.entryAt, hcol, Option.bind_some,
      List.getElem?_append_left hj, hQj, Option.map_some]
  | some w =>
    obtain ⟨-, -, hlen, -, hq⟩ := Closure.admCap_query (Closure.std_inL hstd) w hsd
    obtain ⟨ho, hQ⟩ := hq j (hlen ▸ hj)
    simp only [Closure.anchorOrigin, ho]
    cases hc : S.E.colAt w.col with
    | none => rw [hc] at hQ; simp [hQj] at hQ
    | some col =>
      rw [hc, Option.getD_some] at hQ
      simp only [Tree.heightAt, Tree.entryAt, hc, Option.bind_some, ← hQ]

section FitBlock_E8

/-- L7.6b helper: a role lies in at most one entry of a column. -/
theorem inEntry_unique_E8 {x : Role} {c : ColAddr} {j k : Nat}
    (hj : x.inEntry ⟨c, j⟩ = true) (hk : x.inEntry ⟨c, k⟩ = true) : j = k := by
  rcases (inEntry_iff _ _).1 hj with rfl | hj <;> rcases (inEntry_iff _ _).1 hk with h | hk
  · cases h; rfl
  · have := hk.length_le; simp [EntryAddr.heightPath, Role.path] at this
  · cases h; have := hj.length_le; simp [EntryAddr.heightPath, Role.path] at this
  · have := Tree.prefix_step_eq hj hk
    simp only [Prod.mk.injEq] at this
    exact this.2

/-- L7.6b helper: `relRole` undoes `Role.under`. -/
theorem relRole_under_E8 (pfx : List (Nat × Nat)) (r : Role) :
    relRole pfx (Role.under pfx r) = r := by
  cases r <;> simp [relRole, Role.under]

/-- L7.6b helper: a role of `t` inside the height of `e` is a role of that height placed under
`e`'s height path (as `Tree.mem_under_of_inEntry`, G-012). -/
theorem mem_under_of_inEntry_E8 {t : Forest} {e : EntryAddr} (he : e ∈ t.entryAddrs) {x : Role}
    (hx : x ∈ t.roles) (hpath : e.heightPath <+: x.path) :
    x ∈ ((t.heightAt e).getD Tree.empty).roles.map (Role.under e.heightPath) := by
  obtain ⟨h, hh⟩ : ∃ h, t.heightAt e = some h := by
    have h1 := (Tree.mem_entryAddrs_iff _ _).mp he
    cases hE : t.entryAt e with
    | none => simp [hE] at h1
    | some v => exact ⟨v.2, by simp [Tree.heightAt, hE]⟩
  rw [hh, Option.getD_some, List.mem_map]
  obtain ⟨π', hπ'⟩ := hpath
  have hcol : ∀ d : ColAddr, d.path = e.heightPath ++ π' →
      t.colAt d = h.colAt ⟨π', d.col⟩ := by
    intro d hd
    unfold Tree.colAt
    rw [hd, Tree.forestAt_append, Tree.forestAt_heightPath, hh]
    rfl
  cases x with
  | ord d =>
    simp only [Role.path] at hπ'
    refine ⟨.ord ⟨π', d.col⟩, ?_, ?_⟩
    · have hx' := (Tree.mem_roles_iff _ _).mp hx
      rw [Tree.mem_roles_iff]
      simp only at hx' ⊢
      rwa [hcol d hπ'.symm] at hx'
    · simp only [Role.under]
      rw [hπ']
  | slot d =>
    simp only [Role.path] at hπ'
    refine ⟨.slot ⟨⟨π', d.col.col⟩, d.idx⟩, ?_, ?_⟩
    · have hx' := (Tree.mem_roles_iff _ _).mp hx
      rw [Tree.mem_roles_iff]
      simp only at hx' ⊢
      unfold Tree.entryAt at hx' ⊢
      rwa [hcol d.col hπ'.symm] at hx'
    · simp only [Role.under]
      rw [hπ']

/-- L7.6b helper: no role of the prefix `P(t, e)` lies inside `e` (as
`Tree.not_inEntry_of_mem_prefix`, G-012). -/
theorem not_inEntry_of_mem_prefix_E8 {t : Forest} {e : EntryAddr} (he : e ∈ t.entryAddrs)
    {y : Role} (hy : y ∈ prefixRoles t e) : y.inEntry e = false := by
  obtain ⟨post, hroles, -⟩ := Tree.roles_entry he
  have hnd := Tree.roles_nodup t
  rw [hroles] at hnd
  have hdis := List.disjoint_of_nodup_append hnd
  have hyt : y ∈ t.roles := (List.takeWhile_sublist _).subset hy
  by_contra hin
  have hin' : y.inEntry e = true := by simpa using hin
  have hne : y ≠ .slot e := by
    rintro rfl
    exact hdis hy (List.mem_cons_self ..)
  have hpath : e.heightPath <+: y.path := by
    simpa [Role.inEntry, hne, List.isPrefixOf_iff_prefix] using hin'
  exact hdis hy (List.mem_cons_of_mem _
    (List.mem_append_left _ (mem_under_of_inEntry_E8 he hyt hpath)))

theorem takeWhile_ne_E8 {A B : List Role} {y : Role} (hy : y ∉ A) :
    (A ++ y :: B).takeWhile (· != y) = A := by
  induction A with
  | nil => simp
  | cons a A ih =>
    have ha : a ≠ y := fun h => hy (h ▸ List.mem_cons_self)
    simp only [List.cons_append, List.takeWhile_cons, bne_iff_ne, ne_eq, ha, not_false_eq_true,
      if_true, ih (fun h => hy (List.mem_cons_of_mem _ h))]

theorem dropWhile_ne_E8 {A B : List Role} {y : Role} (hy : y ∉ A) :
    (A ++ y :: B).dropWhile (· != y) = y :: B := by
  induction A with
  | nil => simp
  | cons a A ih =>
    have ha : a ≠ y := fun h => hy (h ▸ List.mem_cons_self)
    simp only [List.cons_append, List.dropWhile_cons, bne_iff_ne, ne_eq, ha, not_false_eq_true,
      if_true, ih (fun h => hy (List.mem_cons_of_mem _ h))]

theorem rolesBefore_of_decomp_E8 {E : Forest} {x : Role} {pre rest : List Role}
    (hr : E.roles = pre ++ x :: rest) : rolesBefore E x = pre := by
  have hnd := Tree.roles_nodup E
  rw [hr, List.nodup_append] at hnd
  have hne : x ∉ pre := fun hm => hnd.2.2 _ hm _ List.mem_cons_self rfl
  unfold rolesBefore
  rw [hr, takeWhile_ne_E8 hne]

/-- L7.6b helper: the stopping column in reading order: `P⁻`, `T`, the query, the closing slot,
later roles; the query is the `rolesCol` of `Q`. -/
theorem stop_roles_E8 {S : ScanSetup.{u}} (hsd : Scan.stopData S.H = some S.sd) :
    ∃ post, S.H.roles = S.preStop ++ Role.ord S.sd.col ::
      (S.queryRoles ++ Role.slot (Scan.closingSlot S.sd) :: post) ∧
      S.queryRoles = Tree.rolesCol S.sd.col.path S.sd.col.col 0 S.sd.Q := by
  obtain ⟨hcol, -⟩ := Scan.stopData_spec hsd
  obtain ⟨pre, post, hr⟩ := roles_col_decomp hcol
  have hrc : Tree.rolesCol S.sd.col.path S.sd.col.col 0 (S.sd.Q ++ [(S.sd.r, Tree.empty)]) =
      Tree.rolesCol S.sd.col.path S.sd.col.col 0 S.sd.Q ++ [Role.slot (Scan.closingSlot S.sd)] := by
    rw [Tree.rolesCol_append]
    simp [Tree.rolesCol, Scan.closingSlot, Tree.empty, Tree.rolesF, Tree.rolesCols]
  have hr' : S.H.roles = pre ++ Role.ord S.sd.col ::
      (Tree.rolesCol S.sd.col.path S.sd.col.col 0 S.sd.Q ++
        Role.slot (Scan.closingSlot S.sd) :: post) := by
    rw [hr, hrc]; simp
  have hpre : S.preStop = pre := rolesBefore_of_decomp_E8 hr'
  have hnd := Tree.roles_nodup S.H
  rw [hr', List.nodup_append, List.nodup_cons, List.nodup_append] at hnd
  have hTpre : Role.ord S.sd.col ∉ pre := fun hm => hnd.2.2 _ hm _ List.mem_cons_self rfl
  have hNQ : Role.slot (Scan.closingSlot S.sd) ∉
      Tree.rolesCol S.sd.col.path S.sd.col.col 0 S.sd.Q :=
    fun hm => hnd.2.1.2.2.2 _ hm _ List.mem_cons_self rfl
  have hQ : S.queryRoles = Tree.rolesCol S.sd.col.path S.sd.col.col 0 S.sd.Q := by
    unfold ScanSetup.queryRoles
    rw [hr', dropWhile_ne_E8 hTpre]
    simp only [List.drop_succ_cons, List.drop_zero]
    rw [takeWhile_ne_E8 hNQ]
  refine ⟨post, ?_, hQ⟩
  rw [hpre, hQ]; exact hr'

/-- L7.6b helper: a false label `(false, q)` of `h_a(B)` has `q < a`. -/
theorem relKey_false_lt_E8 {a : Nat} {B : Forest} {e : EntryAddr} {q : Nat} {h : Key}
    (he : (relKey a B).entryAt e = some ((false, q), h)) : q < a := by
  rw [relKey_eq_map, Tree.entryAt_map] at he
  obtain ⟨⟨p, h'⟩, -, hx⟩ := Option.map_eq_some_iff.1 he
  simp only [relLabel, Prod.mk.injEq] at hx
  split_ifs at hx with hp
  · obtain ⟨⟨-, rfl⟩, -⟩ := hx; exact hp
  · simp at hx

/-- L7.6b helper: the frame fields read by a positive block of `h_a(B)` are visible below `a`
or the selector (false labels). -/
theorem posBlock_ordcur_E8 {a : Nat} {B : Forest} {sel : Nat} {w : BlkVar}
    (hw : w ∈ baseVars (posBlock (relKey a B) sel)) {q : Nat} (hq : w = .ord q ∨ w = .cur q) :
    q < a ∨ q = sel := by
  simp only [baseVars, List.mem_flatMap] at hw
  obtain ⟨b, hb, hwb⟩ := hw
  simp only [posBlock, freeBlock, List.mem_append, List.mem_cons, List.mem_map,
    List.mem_filterMap, List.mem_flatMap, List.not_mem_nil] at hb
  have hno : ∀ x, (x = BlkVar.owner ∨ ∃ r, x = .inner r) → ¬ (x = .ord q ∨ x = .cur q) := by
    rintro x (rfl | ⟨r, rfl⟩) (h | h) <;> cases h
  rcases hb with ((((rfl | ⟨_, ⟨r, -, rfl⟩, rfl⟩) | ⟨xy, hxy, rfl⟩) | ⟨c, -, hca⟩) | ⟨e, -, hea⟩) |
    rfl | rfl | hF
  · simp only [BaseAtom.vars, List.mem_singleton] at hwb
    exact absurd (hwb ▸ hq) (hno _ (Or.inl rfl))
  · simp only [BaseAtom.vars, List.mem_singleton] at hwb
    exact absurd (hwb ▸ hq) (hno _ (Or.inr ⟨r, rfl⟩))
  · obtain ⟨h1, h2⟩ := List.of_mem_zip hxy
    simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false] at hwb
    rcases hwb with rfl | rfl
    · rcases List.mem_cons.1 h1 with h | h
      · exact absurd hq (hno _ (Or.inl h))
      · obtain ⟨r, -, hr⟩ := List.mem_map.1 h
        exact absurd hq (hno _ (Or.inr ⟨r, hr.symm⟩))
    · obtain ⟨r, -, hr⟩ := List.mem_map.1 h2
      exact absurd hq (hno _ (Or.inr ⟨r, hr.symm⟩))
  · split_ifs at hca
    cases hca
    simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false] at hwb
    rcases hwb with rfl | rfl <;> exact absurd hq (hno _ (Or.inr ⟨_, rfl⟩))
  · cases hx : (relKey a B).entryAt e with
    | none => rw [hx] at hea; simp at hea
    | some x =>
      obtain ⟨⟨bb, q'⟩, h⟩ := x
      rw [hx] at hea
      cases bb with
      | false =>
        have hlt := relKey_false_lt_E8 hx
        simp only [List.mem_cons, List.mem_nil_iff, or_false] at hea
        rcases hea with rfl | rfl <;>
          simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false] at hwb <;>
          rcases hwb with rfl | rfl | rfl
        all_goals first
          | exact absurd hq (hno _ (Or.inr ⟨_, rfl⟩))
          | (rcases hq with h | h <;> cases h <;> exact Or.inl hlt)
      | true =>
        cases q' with
        | zero =>
          simp only [List.mem_cons, List.mem_nil_iff, or_false] at hea
          rcases hea with rfl | rfl <;>
            simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false] at hwb <;>
            rcases hwb with rfl | rfl | rfl
          all_goals first
            | exact absurd hq (hno _ (Or.inr ⟨_, rfl⟩))
            | exact absurd hq (hno _ (Or.inl rfl))
            | (rcases hq with h | h <;> cases h)
        | succ v =>
          simp only at hea
          cases hr : e.col.rep 1 (v + 1) with
          | none => rw [hr] at hea; simp at hea
          | some ow =>
            rw [hr] at hea
            simp only [List.mem_cons, List.mem_nil_iff, or_false] at hea
            rcases hea with rfl | rfl <;>
              simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false] at hwb <;>
              rcases hwb with rfl | rfl | rfl <;> exact absurd hq (hno _ (Or.inr ⟨_, rfl⟩))
  · simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false] at hwb
    rcases hwb with rfl | rfl | rfl
    · exact absurd hq (hno _ (Or.inl rfl))
    · rcases hq with h | h <;> cases h
    · rcases hq with h | h <;> cases h; exact Or.inr rfl
  · simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false] at hwb
    rcases hwb with rfl | rfl | rfl
    · exact absurd hq (hno _ (Or.inl rfl))
    · rcases hq with h | h <;> cases h
    · rcases hq with h | h <;> cases h; exact Or.inr rfl
  · exact hF.elim


theorem nodup_getElem?_inj_E8 {β : Type} {l : List β} (h : l.Nodup) {i k : Nat} {x : β}
    (h1 : l[i]? = some x) (h2 : l[k]? = some x) : i = k := by
  obtain ⟨hi, hx1⟩ := List.getElem?_eq_some_iff.1 h1
  obtain ⟨hk, hx2⟩ := List.getElem?_eq_some_iff.1 h2
  exact (h.getElem_inj_iff (hi := hi) (hj := hk)).1 (hx1.trans hx2.symm)

end FitBlock_E8

/-- L7.6b with the explicit fitting `extendFit j β βb` (L7.6a step 12). -/
theorem fitExtend_E8 {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) {j : Nat}
    (hj : j < S.sd.Q.length) {β : Role → Ordinal.{u}} (hfit : S.Fitted P j β)
    {L : Ordinal.{u}} (hL : S.Lmax j β ≤ L) {βb : BlkVar → Ordinal.{u}}
    (hfr : ∀ w x, (frameOf ⟨S.sd.col, j⟩).toFr w = some x → βb w = S.fitVal β x)
    (hnew : ∀ w ∈ baseVars (posBlock (((Scan.queryKeys S.sd)[j]?).getD Tree.empty)
        (((S.sd.Q[j]?).map Prod.fst).getD 0)),
      (frameOf ⟨S.sd.col, j⟩).toFr w = none → L < βb w)
    (hholds : BaseHolds P (posBlock (((Scan.queryKeys S.sd)[j]?).getD Tree.empty)
        (((S.sd.Q[j]?).map Prod.fst).getD 0)) βb) :
    S.Fitted P (j + 1) (S.extendFit j β βb) ∧
      (∀ x ∈ S.fittedRoles j, S.extendFit j β βb x = β x) ∧
      ∀ x ∈ S.entryRoles j, ∃ w ∈ baseVars (posBlock (((Scan.queryKeys S.sd)[j]?).getD Tree.empty)
          (((S.sd.Q[j]?).map Prod.fst).getD 0)),
        (frameOf ⟨S.sd.col, j⟩).toFr w = none ∧ S.extendFit j β βb x = βb w := by
  obtain ⟨⟨-, hInL, -, hsd, -, -, -⟩, ⟨-, -, hPE⟩, -⟩ := hS
  have hV : Scan.CondV S.H := hInL.1
  obtain ⟨post, hroles, hQ⟩ := stop_roles_E8 hsd
  obtain ⟨hcol, -, ht, -⟩ := Scan.stopData_spec hsd
  set e : EntryAddr := ⟨S.sd.col, j⟩ with he_def
  have hQj : S.sd.Q[j]? = some S.sd.Q[j] := List.getElem?_eq_getElem hj
  have hent : S.H.entryAt e = some S.sd.Q[j] := by
    simp [Tree.entryAt, e, hcol, List.getElem?_append_left hj, hQj]
  have he : e ∈ S.H.entryAddrs := (Tree.mem_entryAddrs_iff _ _).2 (by rw [hent]; rfl)
  have hB : S.H.heightAt e = some S.sd.Q[j].2 := by simp [Tree.heightAt, hent]
  have hK : ((Scan.queryKeys S.sd)[j]?).getD Tree.empty =
      relKey (e.col.num 0) ((S.H.heightAt e).getD Tree.empty) := by
    simp [Scan.queryKeys, List.getElem?_map, hQj, hB, ht, e]
  have hsel : ((S.sd.Q[j]?).map Prod.fst).getD 0 = ((S.H.entryAt e).map Prod.fst).getD 0 := by
    simp [hQj, hent]
  rw [hK, hsel] at hnew hholds ⊢
  set K := relKey (e.col.num 0) ((S.H.heightAt e).getD Tree.empty) with hKdef
  set p := ((S.H.entryAt e).map Prod.fst).getD 0 with hpdef
  have hplt : p < e.col.num 0 := by
    have h1 := hV e he S.sd.Q[j].1 S.sd.Q[j].2 hent
    have h2 : p = S.sd.Q[j].1 := by simp [hpdef, hent]
    rw [h2]
    exact ((ColAddr.resolve_isSome_iff 0 _ _).1 h1).2
  -- reading order around the stopping column
  have hnd := Tree.roles_nodup S.H
  have hnd' := hnd
  rw [hroles, List.nodup_append, List.nodup_cons] at hnd'
  have hTq : Role.ord S.sd.col ∉ S.queryRoles := fun h => hnd'.2.1.1 (List.mem_append_left _ h)
  have hPq : ∀ x ∈ S.preStop, x ∉ S.queryRoles := fun x hx h =>
    hnd'.2.2 _ hx _ (List.mem_cons_of_mem _ (List.mem_append_left _ h)) rfl
  have hPT : ∀ x ∈ S.preStop, x ≠ Role.ord S.sd.col := fun x hx h =>
    hnd'.2.2 _ hx _ List.mem_cons_self h
  have hQ2 : S.queryRoles = Tree.rolesCol S.sd.col.path S.sd.col.col 0 (S.sd.Q.take j) ++
      Tree.rolesCol S.sd.col.path S.sd.col.col j (S.sd.Q.drop j) := by
    rw [hQ]
    conv_lhs => rw [← List.take_append_drop j S.sd.Q]
    rw [Tree.rolesCol_append, List.length_take, Nat.min_eq_left hj.le, Nat.zero_add]
  have hdrop : Tree.rolesCol S.sd.col.path S.sd.col.col j (S.sd.Q.drop j) = Role.slot e ::
      (Tree.rolesF e.heightPath S.sd.Q[j].2 ++
        Tree.rolesCol S.sd.col.path S.sd.col.col (j + 1) (S.sd.Q.drop (j + 1))) := by
    rw [List.drop_eq_getElem_cons hj]
    rfl
  set A := Tree.rolesCol S.sd.col.path S.sd.col.col 0 (S.sd.Q.take j) with hA
  have hpre : prefixRoles S.H e = S.preStop ++ Role.ord S.sd.col :: A := by
    have hr2 : S.H.roles = (S.preStop ++ Role.ord S.sd.col :: A) ++ Role.slot e ::
        (Tree.rolesF e.heightPath S.sd.Q[j].2 ++
          (Tree.rolesCol S.sd.col.path S.sd.col.col (j + 1) (S.sd.Q.drop (j + 1)) ++
            Role.slot (Scan.closingSlot S.sd) :: post)) := by
      rw [hroles, hQ2, hdrop]; simp
    exact rolesBefore_of_decomp_E8 hr2
  have hnotin : ∀ x ∈ prefixRoles S.H e, x.inEntry e = false := fun x hx =>
    not_inEntry_of_mem_prefix_E8 he hx
  have hsub : ∀ x, (x ∈ S.preStop ∨ x = Role.ord S.sd.col ∨ x ∈ S.fittedRoles j) →
      x ∈ prefixRoles S.H e := by
    rintro x (hx | rfl | hx)
    · rw [hpre]; exact List.mem_append_left _ hx
    · rw [hpre]; simp
    · rw [hpre]
      obtain ⟨hxq, hany⟩ := List.mem_filter.1 hx
      obtain ⟨j', hj', hin⟩ := List.any_eq_true.1 hany
      rw [List.mem_range] at hj'
      refine List.mem_append_right _ (List.mem_cons_of_mem _ ?_)
      rw [hQ2] at hxq
      rcases List.mem_append.1 hxq with h | h
      · exact h
      · exfalso
        obtain ⟨k, hk1, -, hk⟩ := Scan.rolesCol_inEntry _ _ _ j x h
        have := inEntry_unique_E8 hin hk
        omega
  have hFR1 : ∀ x ∈ S.fittedRoles (j + 1), x ∈ S.fittedRoles j ∨ x ∈ S.entryRoles j := by
    intro x hx
    obtain ⟨hxq, hany⟩ := List.mem_filter.1 hx
    obtain ⟨j', hj', hin⟩ := List.any_eq_true.1 hany
    rw [List.mem_range] at hj'
    rcases Nat.lt_or_ge j' j with h | h
    · exact Or.inl (List.mem_filter.2 ⟨hxq, List.any_eq_true.2 ⟨j', List.mem_range.2 h, hin⟩⟩)
    · have hjj : j' = j := by omega
      exact Or.inr (List.mem_filter.2 ⟨hxq, hjj ▸ hin⟩)
  have hdisj : ∀ x ∈ S.fittedRoles j, x ∉ S.entryRoles j := by
    intro x hx hx'
    obtain ⟨-, hany⟩ := List.mem_filter.1 hx
    obtain ⟨j', hj', hin⟩ := List.any_eq_true.1 hany
    have := inEntry_unique_E8 hin (List.mem_filter.1 hx').2
    rw [List.mem_range] at hj'; omega
  -- the extended fitting
  set β' := S.extendFit j β βb with hβ'
  have hβout : ∀ x, x ∉ S.entryRoles j → β' x = β x := by
    intro x hx; simp only [hβ', ScanSetup.extendFit, if_neg hx]
  have hslotq : Role.slot e ∈ S.queryRoles := by rw [hQ2, hdrop]; simp
  have hslotE : Role.slot e ∈ S.entryRoles j :=
    List.mem_filter.2 ⟨hslotq, by simp [Role.inEntry, e]⟩
  have hβslot : β' (.slot e) = βb .owner := by
    simp only [hβ', ScanSetup.extendFit, if_pos hslotE]
    rw [if_pos rfl]
  have hβin : ∀ x ∈ S.entryRoles j, x ≠ .slot e →
      β' x = βb (.inner (relRole e.heightPath x)) := by
    intro x hx hne
    simp only [hβ', ScanSetup.extendFit, if_pos hx]
    rw [if_neg (show ¬ (x = Role.slot ⟨S.sd.col, j⟩) from hne)]
  have hblk : ∀ x ∈ S.entryRoles j, x ≠ .slot e → ∃ r ∈ K.roles, x = Role.under e.heightPath r := by
    intro x hx hne
    obtain ⟨hxq, hin⟩ := List.mem_filter.1 hx
    have hxr : x ∈ S.H.roles := by rw [hroles]; simp [hxq]
    have hpath : e.heightPath <+: x.path := by
      rcases (inEntry_iff x e).1 hin with h | h
      · exact absurd h hne
      · exact h
    obtain ⟨r, hr, rfl⟩ := List.mem_map.1 (mem_under_of_inEntry_E8 he hxr hpath)
    exact ⟨r, by rw [hKdef, relKey_roles]; exact hr, rfl⟩
  have hfree_sub : ∀ w ∈ baseVars (freeBlock K), w ∈ baseVars (posBlock K p) := by
    intro w hw
    simp only [posBlock, baseVars, List.flatMap_append, List.mem_append]
    exact Or.inl hw
  have hinner_mem : ∀ r ∈ K.roles, BlkVar.inner r ∈ baseVars (posBlock K p) := by
    intro r hr
    refine hfree_sub _ (List.mem_flatMap.2 ⟨BaseAtom.lim (.inner r), ?_, by simp [BaseAtom.vars]⟩)
    simp only [freeBlock, List.mem_append, List.mem_cons, List.mem_map]
    exact Or.inl (Or.inl (Or.inl (Or.inr ⟨_, ⟨r, hr, rfl⟩, rfl⟩)))
  have howner_mem : BlkVar.owner ∈ baseVars (posBlock K p) :=
    hfree_sub _ (List.mem_flatMap.2 ⟨BaseAtom.lim .owner, by simp [freeBlock], by
      simp [BaseAtom.vars]⟩)
  have hnewv : ∀ x ∈ S.entryRoles j, ∃ w ∈ baseVars (posBlock K p),
      (frameOf e).toFr w = none ∧ β' x = βb w := by
    intro x hx
    by_cases hxs : x = .slot e
    · subst hxs; exact ⟨.owner, howner_mem, rfl, hβslot⟩
    · obtain ⟨r, hr, rfl⟩ := hblk x hx hxs
      exact ⟨.inner r, hinner_mem r hr, rfl, by rw [hβin _ hx hxs, relRole_under_E8]⟩
  -- the fitted values agree with the block on the variables it reads
  have hcong : ∀ w ∈ baseVars (posBlock K p),
      blockMap e w ∈ S.preStop ++ [Role.ord S.sd.col] ++ S.fittedRoles (j + 1) →
      S.fitVal β' (blockMap e w) = βb w := by
    intro w hw hmem
    cases hfw : (frameOf e).toFr w with
    | some x0 =>
      have hx0 : x0 ∈ prefixRoles S.H e := by
        cases w with
        | host =>
          simp only [frameOf, Frame.toFr, Option.some.injEq] at hfw
          subst hfw; exact (Tree.stack_mem_prefix he).1
        | ord q =>
          simp only [frameOf, Frame.toFr, reps0_getElem?] at hfw
          obtain ⟨⟨o, v⟩, hov, rfl⟩ := Option.map_eq_some_iff.1 hfw
          exact (rep_mem_prefix he hov).1
        | cur q =>
          simp only [frameOf, Frame.toFr, reps0_getElem?] at hfw
          obtain ⟨⟨o, v⟩, hov, rfl⟩ := Option.map_eq_some_iff.1 hfw
          exact (rep_mem_prefix he hov).2
        | owner => cases hfw
        | inner r => cases hfw
      have hx0E : x0 ∉ S.entryRoles j := fun h => by
        have := hnotin x0 hx0; rw [(List.mem_filter.1 h).2] at this; cases this
      rw [blockMap_frame e w x0 hfw, hfr w x0 hfw]
      simp only [ScanSetup.fitVal]
      split_ifs
      · rw [hβout x0 hx0E]
      · rfl
    | none =>
      cases w with
      | host => simp [frameOf, Frame.toFr] at hfw
      | owner =>
        show S.fitVal β' (.slot e) = _
        unfold ScanSetup.fitVal
        rw [if_pos hslotq]
        exact hβslot
      | inner r =>
        simp only [blockMap] at hmem ⊢
        have hin : (Role.under e.heightPath r).inEntry e = true := by
          rw [inEntry_iff]; right; rw [Role.path_under]; exact List.prefix_append _ _
        have hq : Role.under e.heightPath r ∈ S.entryRoles j := by
          simp only [List.mem_append, List.mem_singleton] at hmem
          rcases hmem with (h | h) | h
          · exfalso; have := hnotin _ (hsub _ (Or.inl h)); rw [hin] at this; cases this
          · exfalso; have := hnotin _ (hsub _ (Or.inr (Or.inl h))); rw [hin] at this; cases this
          · rcases hFR1 _ h with h | h
            · exfalso; have := hnotin _ (hsub _ (Or.inr (Or.inr h))); rw [hin] at this; cases this
            · exact h
        have hne : Role.under e.heightPath r ≠ .slot e := by
          intro h
          have h2 : (Role.under e.heightPath r).path.length = (Role.slot e).path.length := by
            rw [h]
          rw [Role.path_under] at h2
          simp only [Role.path, EntryAddr.heightPath, List.length_append,
            List.length_singleton] at h2
          omega
        simp only [ScanSetup.fitVal, if_pos (List.mem_filter.1 hq).1, hβin _ hq hne,
          relRole_under_E8]
      | ord q =>
        exfalso
        have hn : e.col.rep 0 q = none := by
          simpa [frameOf, Frame.toFr, reps0_getElem?] using hfw
        have hq' : ¬ q < e.col.num 0 := by
          intro hlt
          have := (rep_isSome_iff e.col q).2 hlt
          rw [hn] at this; cases this
        rcases posBlock_ordcur_E8 hw (Or.inl rfl) with h | h
        · exact hq' h
        · exact hq' (h ▸ hplt)
      | cur q =>
        exfalso
        have hn : e.col.rep 0 q = none := by
          simpa [frameOf, Frame.toFr, reps0_getElem?] using hfw
        have hq' : ¬ q < e.col.num 0 := by
          intro hlt
          have := (rep_isSome_iff e.col q).2 hlt
          rw [hn] at this; cases this
        rcases posBlock_ordcur_E8 hw (Or.inr rfl) with h | h
        · exact hq' h
        · exact hq' (h ▸ hplt)
  -- values outside the block are at most `L_j`
  have hLmax : ∀ x, (x ∈ S.preStop ∨ x = Role.ord S.sd.col ∨ x ∈ S.fittedRoles j) →
      S.fitVal β' x ≤ S.Lmax j β := by
    obtain ⟨hL1, hL2⟩ := foldr_max_spec (L := S.asg S.stopNm) ((S.fittedRoles j).map β)
    rintro x (hx | rfl | hx)
    · have hxq := hPq x hx
      simp only [ScanSetup.fitVal, if_neg hxq, ScanSetup.baseVal, if_neg (hPT x hx)]
      obtain ⟨T', hT', -, hpre'⟩ := Closure.anchorOrigin_prefix hInL hsd
      obtain ⟨y, hy, hyPE, -⟩ := hpre' x hx
      rw [hy]
      simp only [Option.map_some, Option.getD_some]
      have hyPE' : y ∈ S.PE := by
        simp only [ScanSetup.PE, ScanSetup.TE, ScanSetup.chi, anchorD, hT', Option.getD_some]
        exact hyPE
      exact (hPE y hyPE').le.trans hL1
    · simp only [ScanSetup.fitVal, if_neg hTq, ScanSetup.baseVal, if_true]
      exact hL1
    · have hxq := (List.mem_filter.1 hx).1
      simp only [ScanSetup.fitVal, if_pos hxq, hβout x (hdisj x hx)]
      exact hL2 _ (List.mem_map_of_mem hx)
  -- order atoms around entry `j`
  obtain ⟨post', hroles', hpost'⟩ := Tree.roles_entry he
  have hord_exit : ∀ i x y, S.H.roles[i]? = some x → S.H.roles[i + 1]? = some y →
      x.inEntry e = true → y ∈ prefixRoles S.H e → False := by
    intro i x y hx hy hxin hyp
    obtain ⟨k, hk⟩ := List.mem_iff_getElem?.1 hyp
    have hkl : k < (prefixRoles S.H e).length := (List.getElem?_eq_some_iff.1 hk).1
    have hk' : S.H.roles[k]? = some y := by
      rw [hroles', List.getElem?_append_left hkl]; exact hk
    have hki := nodup_getElem?_inj_E8 hnd hk' hy
    have hix : (prefixRoles S.H e)[i]? = some x := by
      rw [hroles', List.getElem?_append_left (by omega)] at hx; exact hx
    have := hnotin x (List.mem_of_getElem? hix)
    rw [hxin] at this; cases this
  have hblock_lt : ∀ i x y, S.H.roles[i]? = some x → S.H.roles[i + 1]? = some y →
      x.inEntry e = true → y.inEntry e = true →
      ∃ w1 w2, BaseAtom.lt w1 w2 ∈ posBlock K p ∧ blockMap e w1 = x ∧ blockMap e w2 = y := by
    intro i x y hx hy hxin hyin
    set n := (prefixRoles S.H e).length
    set rs : List BlkVar := K.roles.map BlkVar.inner
    have hW : (BlkVar.owner :: rs).map (blockMap e) = Role.slot e ::
        ((S.H.heightAt e).getD Tree.empty).roles.map (Role.under e.heightPath) := by
      simp only [List.map_cons, List.map_map, rs, hKdef, relKey_roles]
      rfl
    have hroles2 : S.H.roles = prefixRoles S.H e ++
        ((BlkVar.owner :: rs).map (blockMap e) ++ post') := by
      rw [hW, hroles']; simp
    have hin : n ≤ i := by
      by_contra hlt
      have hix : (prefixRoles S.H e)[i]? = some x := by
        rw [hroles2, List.getElem?_append_left (by omega)] at hx; exact hx
      have := hnotin x (List.mem_of_getElem? hix)
      rw [hxin] at this; cases this
    have hlen : i + 1 < n + ((BlkVar.owner :: rs).map (blockMap e)).length := by
      by_contra hge
      rw [hroles2, List.getElem?_append_right (by omega), List.getElem?_append_right (by omega)]
        at hy
      have := hpost' y (List.mem_of_getElem? hy)
      rw [hyin] at this; cases this
    obtain ⟨k, rfl⟩ : ∃ k, i = n + k := ⟨i - n, by omega⟩
    have hx' : ((BlkVar.owner :: rs).map (blockMap e))[k]? = some x := by
      have h0 := hx
      rw [hroles2, List.getElem?_append_right (by omega), List.getElem?_append_left (by omega)]
        at h0
      have hk : n + k - n = k := by omega
      rwa [hk] at h0
    have hy' : ((BlkVar.owner :: rs).map (blockMap e))[k + 1]? = some y := by
      have h0 := hy
      rw [hroles2, List.getElem?_append_right (by omega), List.getElem?_append_left (by omega)]
        at h0
      have hk : n + k + 1 - n = k + 1 := by omega
      rwa [hk] at h0
    clear hx hy
    rw [List.getElem?_map] at hx' hy'
    obtain ⟨w1, hw1, rfl⟩ := Option.map_eq_some_iff.1 hx'
    obtain ⟨w2, hw2, rfl⟩ := Option.map_eq_some_iff.1 hy'
    rw [List.getElem?_cons_succ] at hw2
    refine ⟨w1, w2, ?_, rfl, rfl⟩
    simp only [posBlock, freeBlock, List.mem_append]
    refine Or.inl (Or.inl (Or.inl (Or.inr ?_)))
    have hz : ((BlkVar.owner :: rs).zip rs)[k]? = some (w1, w2) :=
      List.getElem?_zip_eq_some.2 ⟨hw1, hw2⟩
    exact List.mem_map_of_mem (f := fun xy : BlkVar × BlkVar => BaseAtom.lt xy.1 xy.2)
      (List.mem_of_getElem? hz)
  refine ⟨fun a ha => ?_, fun x hx => hβout x (hdisj x hx), hnewv⟩
  obtain ⟨haq, hall⟩ := List.mem_filter.1 ha
  have hvars : ∀ v ∈ a.vars, v ∈ S.preStop ++ [Role.ord S.sd.col] ++ S.fittedRoles (j + 1) := by
    intro v hv; simpa using List.all_eq_true.1 hall v hv
  have hag : a ∈ graph S.H := (List.mem_filter.1 (List.mem_filter.1 haq).1).1
  by_cases hA : ∃ v ∈ a.vars, v ∈ S.entryRoles j
  · obtain ⟨v0, hv0, hv0e⟩ := hA
    rcases graph_atom_cases S.H a hag with ⟨i, x, y, rfl, hx, hy⟩ | ⟨z, hz, hown⟩
    · -- an order atom
      have hvx := hvars x (by simp [BaseAtom.vars])
      have hvy := hvars y (by simp [BaseAtom.vars])
      show S.fitVal β' x < S.fitVal β' y
      by_cases hxE : x ∈ S.entryRoles j
      · have hxin := (List.mem_filter.1 hxE).2
        by_cases hyE : y ∈ S.entryRoles j
        · obtain ⟨w1, w2, hw12, rfl, rfl⟩ := hblock_lt i x y hx hy hxin (List.mem_filter.1 hyE).2
          have h12 := hholds _ hw12
          have hw1 : w1 ∈ baseVars (posBlock K p) :=
            List.mem_flatMap.2 ⟨_, hw12, by simp [BaseAtom.vars]⟩
          have hw2 : w2 ∈ baseVars (posBlock K p) :=
            List.mem_flatMap.2 ⟨_, hw12, by simp [BaseAtom.vars]⟩
          rw [hcong w1 hw1 hvx, hcong w2 hw2 hvy]
          exact h12
        · exfalso
          refine hord_exit i x y hx hy hxin (hsub y ?_)
          simp only [List.mem_append, List.mem_singleton] at hvy
          rcases hvy with (h | h) | h
          · exact Or.inl h
          · exact Or.inr (Or.inl h)
          · rcases hFR1 y h with h | h
            · exact Or.inr (Or.inr h)
            · exact absurd h hyE
      · have hyE : y ∈ S.entryRoles j := by
          simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false] at hv0
          rcases hv0 with rfl | rfl
          · exact absurd hv0e hxE
          · exact hv0e
        have hxs : x ∈ S.preStop ∨ x = Role.ord S.sd.col ∨ x ∈ S.fittedRoles j := by
          simp only [List.mem_append, List.mem_singleton] at hvx
          rcases hvx with (h | h) | h
          · exact Or.inl h
          · exact Or.inr (Or.inl h)
          · rcases hFR1 x h with h | h
            · exact Or.inr (Or.inr h)
            · exact absurd h hxE
        obtain ⟨w, hw, hwn, hwv⟩ := hnewv y hyE
        have hyq := (List.mem_filter.1 hyE).1
        have hfy : S.fitVal β' y = β' y := by simp only [ScanSetup.fitVal, if_pos hyq]
        rw [hfy, hwv]
        exact lt_of_le_of_lt ((hLmax x hxs).trans hL) (hnew w hw hwn)
    · -- an owned atom
      have hao : a ∈ ownedBy (graph S.H) z := List.mem_filter.2 ⟨hag, by simp [hown]⟩
      have hzin : z.inEntry e = true := owned_inEntry hao hv0 e (List.mem_filter.1 hv0e).2
      obtain ⟨a₀, ha₀, rfl⟩ := graph_owned_block_core he z ((inEntry_iff z e).1 hzin) _ hao
      rw [BaseAtom.holds_map]
      refine (amalg_baseAtom_congr P a₀ (fun w hw => ?_)).1 (hholds a₀ ha₀)
      have hwD : w ∈ baseVars (posBlock K p) := List.mem_flatMap.2 ⟨a₀, ha₀, hw⟩
      have hwm : blockMap e w ∈ S.preStop ++ [Role.ord S.sd.col] ++ S.fittedRoles (j + 1) :=
        hvars _ (by rw [baseAtom_vars_map]; exact List.mem_map_of_mem hw)
      exact (hcong w hwD hwm).symm
  · push Not at hA
    have h1 : a ∈ restrictTo S.queryGraph (S.preStop ++ [Role.ord S.sd.col] ++ S.fittedRoles j) := by
      refine List.mem_filter.2 ⟨haq, List.all_eq_true.2 fun v hv => ?_⟩
      have := hvars v hv
      simp only [List.mem_append, List.mem_singleton, decide_eq_true_eq] at this ⊢
      rcases this with (h | h) | h
      · exact Or.inl (Or.inl h)
      · exact Or.inl (Or.inr h)
      · rcases hFR1 v h with h | h
        · exact Or.inr h
        · exact absurd h (hA v hv)
    refine (amalg_baseAtom_congr P a (fun v hv => ?_)).1 (hfit a h1)
    simp only [ScanSetup.fitVal]
    split_ifs
    · exact (hβout v (hA v hv)).symm
    · rfl


-- provides: U3, L7.6b (requested by U5 R26, target advance txt:1160-1162): a positive block of query
-- entry `j` above `L ≥ L_j` at the fitted frame extends a fitting by entry `j`.
theorem fit_of_block {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) {j : Nat}
    (hj : j < S.sd.Q.length) {β : Role → Ordinal.{u}} (hfit : S.Fitted P j β)
    {L : Ordinal.{u}} (hL : S.Lmax j β ≤ L) {βb : BlkVar → Ordinal.{u}}
    (hfr : ∀ w x, (frameOf ⟨S.sd.col, j⟩).toFr w = some x → βb w = S.fitVal β x)
    (hnew : ∀ w ∈ baseVars (posBlock (((Scan.queryKeys S.sd)[j]?).getD Tree.empty)
        (((S.sd.Q[j]?).map Prod.fst).getD 0)),
      (frameOf ⟨S.sd.col, j⟩).toFr w = none → L < βb w)
    (hholds : BaseHolds P (posBlock (((Scan.queryKeys S.sd)[j]?).getD Tree.empty)
        (((S.sd.Q[j]?).map Prod.fst).getD 0)) βb) :
    ∃ β', S.Fitted P (j + 1) β' ∧ (∀ x ∈ S.fittedRoles j, β' x = β x) ∧
      ∀ x ∈ S.entryRoles j, ∃ w ∈ baseVars (posBlock (((Scan.queryKeys S.sd)[j]?).getD Tree.empty)
          (((S.sd.Q[j]?).map Prod.fst).getD 0)),
        (frameOf ⟨S.sd.col, j⟩).toFr w = none ∧ β' x = βb w := by
  exact ⟨_, fitExtend_E8 S hS hj hfit hL hfr hnew hholds⟩

section ScanPacket_E8

/-- L7.6a step 3 helper: the target of a scan record is query entry `j` read in `E`, at the
`E`-copy `cE` of the stopping column; `χ̂` carries `T`, the slot of entry `j` and the
representatives of `T`'s stack to those of `cE`. -/
theorem scan_target_E8 {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) {i j : Nat}
    (hj : j < S.sd.Q.length) :
    (S.scanRecord i j).b = ⟨S.cE, j⟩ ∧ S.TE = .ord S.cE ∧ S.cE.num 0 = S.sd.col.num 0 ∧
    S.E.entryAt ⟨S.cE, j⟩ = some S.sd.Q[j] ∧
    ∀ q < S.sd.col.num 0,
      (S.sd.col.rep 0 q).map (fun ov => (S.chi ov.1, S.chi ov.2)) = S.cE.rep 0 q := by
  obtain ⟨⟨hstd, -, -, hsd, -, -, -⟩, -⟩ := hS
  have hcolH := (Scan.stopData_spec hsd).1
  have hQj : S.sd.Q[j]? = some S.sd.Q[j] := List.getElem?_eq_getElem hj
  simp only [ScanSetup.cE, ScanSetup.TE, ScanSetup.chi, ScanSetup.scanRecord]
  simp only [ScanSetup.H] at hsd hcolH
  revert hsd hcolH
  generalize S.cap = cap
  intro hsd hcolH
  cases cap with
  | none =>
    simp only [anchorD, Closure.anchorOrigin, Option.getD_some]
    refine ⟨by simp, by simp, by simp, ?_, fun q _ => by cases S.sd.col.rep 0 q <;> rfl⟩
    simp only [Closure.anchor] at hcolH
    simp [Tree.entryAt, hcolH, List.getElem?_append_left hj, hQj]
  | some w =>
    have hE := Closure.std_inL hstd
    obtain ⟨ht, -, hlen, hT, hq⟩ := Closure.admCap_query hE w hsd
    obtain ⟨ho, hQ⟩ := hq j (hlen ▸ hj)
    have hTd : anchorD S.E (some w) (.ord S.sd.col) = .ord w.col := by
      simp [anchorD, Closure.anchorOrigin, hT]
    simp only [hTd, Closure.anchorOrigin, ho]
    refine ⟨by simp, by simp, ?_, ?_, fun q hq' => ?_⟩
    · rw [← ht, (Scan.stopData_spec hsd).2.2.1]
    · cases hc : S.E.colAt w.col with
      | none => rw [hc] at hQ; simp [hQj] at hQ
      | some col =>
        rw [hc, Option.getD_some] at hQ
        simp [Tree.entryAt, hc, ← hQ, hQj]
    · have h7 := (Closure.origin_spec_full hE w).2.2.2.2.2.2.1 S.sd.col w.col
        (Scan.stopData_col_mem hsd) hT q hq'
      exact h7

/-- L7.6a step 2 helper: the indices of a reached state. -/
theorem reach_idx_E8 {S : ScanSetup.{u}} {i j : Nat}
    (hij : Scan.ReachesGT (Scan.rootKeys S.H S.rd) (Scan.queryKeys S.sd) i j) :
    i < rootLenOf S.H S.rd ∧ j < S.sd.Q.length := by
  obtain ⟨-, x, y, hx, hy, -⟩ := hij
  constructor
  · have := (List.getElem?_eq_some_iff.1 hx).1
    simpa [Scan.rootKeys, rootLenOf] using this
  · have := (List.getElem?_eq_some_iff.1 hy).1
    simpa [Scan.queryKeys] using this

/-- D7.2c / L7.6a helper: the fitted tag is fresh, so `pkAsg` keeps the values of used names. -/
theorem pkAsg_used_E8 (S : ScanSetup.{u}) (β : Role → Ordinal.{u}) {n : Name}
    (hn : n ∈ S.usedNames) : S.pkAsg β n = S.asg n := by
  cases n with
  | role tg x =>
    simp only [ScanSetup.pkAsg]
    rw [if_neg]
    rintro rfl
    exact freshTag_fresh S.usedNames x hn
  | aux k => rfl

/-- L7.6a step 11: the owner of the scan packet is the bank owner `u_i`. -/
theorem scan_owner_E8 {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) {i j : Nat}
    (hij : Scan.ReachesGT (Scan.rootKeys S.H S.rd) (Scan.queryKeys S.sd) i j)
    (β : Role → Ordinal.{u}) :
    (S.scanPacket i j β).asg (S.scanPacket i j β).owner = S.ownerVal i := by
  obtain ⟨⟨-, -, -, hsd, hrd, -, -⟩, -⟩ := hS
  obtain ⟨hi, -⟩ := reach_idx_E8 hij
  obtain ⟨-, -, -, -, -, hmem, hcur, -⟩ := Scan.rootData_spec hsd hrd
  obtain ⟨colR, hcolR⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff _ _).1 hmem)
  have hiR : i < colR.length := by simpa [rootLenOf, hcolR] using hi
  obtain ⟨⟨p0, h0⟩, hpi⟩ : ∃ y, colR[i]? = some y := ⟨_, List.getElem?_eq_getElem hiR⟩
  have hic : i ≤ S.rd.cursor := by
    rw [hcur]; exact Scan.trace_fst_le_cursor _ _ hij.1
  have hent : S.H.entryAt ⟨S.rd.col, i⟩ = some (p0, h0) := by simp [Tree.entryAt, hcolR, hpi]
  have hslotH : Role.slot ⟨S.rd.col, i⟩ ∈ S.H.roles := by
    rw [Tree.mem_roles_iff]; simp [hent]
  have hbank : Role.slot ⟨S.rd.col, i⟩ ∈ S.bankRoles := by
    refine List.mem_filter.2 ⟨hslotH, List.any_eq_true.2 ⟨i, List.mem_range.2 (by omega), ?_⟩⟩
    simp [Role.inEntry]
  have hpre : Role.slot ⟨S.rd.col, i⟩ ∉ S.preRoot := by
    obtain ⟨A, B, hr⟩ := roles_col_decomp hcolR
    have hR : S.preRoot = A := rolesBefore_of_decomp_E8 hr
    rw [hR]
    have hnd := Tree.roles_nodup S.H
    rw [hr, List.nodup_append] at hnd
    have hin : Role.slot ⟨S.rd.col, i⟩ ∈ Role.ord S.rd.col ::
        (Tree.rolesCol S.rd.col.path S.rd.col.col 0 colR ++ B) := by
      refine List.mem_cons_of_mem _ (List.mem_append_left _ ?_)
      exact Tree.mem_rolesCol_iff.2 ⟨i, p0, h0, hpi, Or.inl (by simp)⟩
    exact fun h => hnd.2.2 _ h _ hin rfl
  have hown : (S.scanPacket i j β).owner = S.bankNm (.slot ⟨S.rd.col, i⟩) := by
    show S.pkSrcChart (.slot ⟨S.rd.col, i⟩) = _
    simp only [ScanSetup.pkSrcChart, if_neg hpre]
    rw [if_neg (by simp [ScanSetup.R])]
  rw [hown]
  show S.pkAsg β _ = _
  rw [pkAsg_used_E8 S β (by
    simp only [ScanSetup.usedNames, List.mem_append, List.mem_map]
    exact Or.inl (Or.inr ⟨_, hbank, rfl⟩))]
  rfl

/-- L7.6a step 7 helper: `T` is followed by the slot of the first entry of the stopping column. -/
theorem stop_first_E8 {S : ScanSetup.{u}} (hsd : Scan.stopData S.H = some S.sd) :
    (⟨S.sd.col, 0⟩ : EntryAddr) ∈ S.H.entryAddrs ∧
    prefixRoles S.H ⟨S.sd.col, 0⟩ = S.preStop ++ [Role.ord S.sd.col] := by
  obtain ⟨hcol, -⟩ := Scan.stopData_spec hsd
  obtain ⟨post, hroles, hQ⟩ := stop_roles_E8 hsd
  refine ⟨(Tree.mem_entryAddrs_iff _ _).2 ?_, ?_⟩
  · cases hQc : S.sd.Q with
    | nil => simp [Tree.entryAt, hcol, hQc]
    | cons q0 Qt => simp [Tree.entryAt, hcol, hQc]
  · rcases hQc : S.sd.Q with _ | ⟨q0, Qt⟩
    · refine rolesBefore_of_decomp_E8 (rest := post) ?_
      rw [hroles, hQ, hQc]
      simp [Scan.closingSlot, hQc, Tree.rolesCol]
    · refine rolesBefore_of_decomp_E8 (rest := Tree.rolesF (S.sd.col.path ++ [(S.sd.col.col, 0)])
        q0.2 ++ (Tree.rolesCol S.sd.col.path S.sd.col.col 1 Qt ++
          Role.slot (Scan.closingSlot S.sd) :: post)) ?_
      rw [hroles, hQ, hQc]
      simp [Tree.rolesCol]

/-- L7.6a steps 7, 12 helper: the target frame of the scan packet has the shape of the frame of
query entry `j` in `H`, and its values are the fitted values of the `H`-frame. -/
theorem scan_frame_E8 {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) {i j : Nat}
    (hj : j < S.sd.Q.length) (β : Role → Ordinal.{u}) :
    (∀ w, (frameOf ⟨S.sd.col, j⟩).toFr w = none → (S.scanPacket i j β).tgtFrame.toFr w = none) ∧
    ∀ w x, (frameOf ⟨S.sd.col, j⟩).toFr w = some x →
      ∃ x', (S.scanPacket i j β).tgtFrame.toFr w = some x' ∧
        (S.scanPacket i j β).asg x' = S.fitVal β x := by
  have hS' := hS
  obtain ⟨⟨-, hInL, -, hsd, -, -, -⟩, -⟩ := hS'
  obtain ⟨hb, hTE, hnum, -, hrep⟩ := scan_target_E8 S hS (i := i) hj
  obtain ⟨post, hroles, hQ⟩ := stop_roles_E8 hsd
  have hnd := Tree.roles_nodup S.H
  rw [hroles, List.nodup_append, List.nodup_cons] at hnd
  have hTq : Role.ord S.sd.col ∉ S.queryRoles := fun h => hnd.2.1.1 (List.mem_append_left _ h)
  have hPq : ∀ x ∈ S.preStop, x ∉ S.queryRoles := fun x hx h =>
    hnd.2.2 _ hx _ (List.mem_cons_of_mem _ (List.mem_append_left _ h)) rfl
  have hPT : ∀ x ∈ S.preStop, x ≠ Role.ord S.sd.col := fun x hx h =>
    hnd.2.2 _ hx _ List.mem_cons_self h
  have htf : (S.scanPacket i j β).tgtFrame = (frameOf ⟨S.cE, j⟩).map S.pkTgtChart := by
    show (frameOf (S.scanRecord i j).b).map S.pkTgtChart = _
    rw [hb]
  obtain ⟨he0, hpre0⟩ := stop_first_E8 hsd
  have hstopv : S.pkAsg β S.stopNm = S.asg S.stopNm :=
    pkAsg_used_E8 S β (by simp [ScanSetup.usedNames])
  have hTEc : S.pkTgtChart (.ord S.cE) = S.stopNm := by
    have hnot : Role.ord S.cE ∉ S.PE := by
      intro h
      have := List.all_eq_true.1 List.all_takeWhile _ h
      rw [← hTE] at this
      simp at this
    rw [← hTE] at hnot ⊢
    simp only [ScanSetup.pkTgtChart, if_neg hnot, if_true]
  have hrepv : ∀ q x v, S.sd.col.rep 0 q = some (x, v) →
      S.pkAsg β (S.pkTgtChart (S.chi x)) = S.fitVal β x ∧
      S.pkAsg β (S.pkTgtChart (S.chi v)) = S.fitVal β v := by
    intro q x v h
    have hq : q < S.sd.col.num 0 := (rep_isSome_iff _ _).1 (by rw [h]; rfl)
    obtain ⟨hxP, hvP⟩ := rep_mem_prefix he0 h
    rw [hpre0] at hxP hvP
    have hne : x ≠ Role.ord S.sd.col ∧ v ≠ Role.ord S.sd.col := by
      unfold ColAddr.rep at h
      obtain ⟨o, ho, hov⟩ := Option.map_eq_some_iff.1 h
      have hon := ColAddr.resolve_num ho
      have hne : o ≠ S.sd.col := by rintro rfl; omega
      simp only [Prod.mk.injEq] at hov
      obtain ⟨rfl, rfl⟩ := hov
      refine ⟨by simp [hne], ?_⟩
      split <;> simp [hne]
    have hP : ∀ y, y ∈ S.preStop ++ [Role.ord S.sd.col] → y ≠ Role.ord S.sd.col →
        S.pkAsg β (S.pkTgtChart (S.chi y)) = S.fitVal β y := by
      intro y hy hyT
      have hyP : y ∈ S.preStop := by
        rcases List.mem_append.1 hy with h | h
        · exact h
        · exact absurd (List.mem_singleton.1 h) hyT
      obtain ⟨T', hT', -, hpre'⟩ := Closure.anchorOrigin_prefix hInL hsd
      obtain ⟨y', hy', hyPE, -⟩ := hpre' y hyP
      have hchi : S.chi y = y' := by simp [ScanSetup.chi, anchorD, hy']
      have hy'PE : y' ∈ S.PE := by
        simp only [ScanSetup.PE, ScanSetup.TE, ScanSetup.chi, anchorD, hT', Option.getD_some]
        exact hyPE
      rw [hchi]
      simp only [ScanSetup.pkTgtChart, if_pos hy'PE]
      rw [pkAsg_used_E8 S β (by
        simp only [ScanSetup.usedNames, List.mem_append]
        exact Or.inl (Or.inl (Or.inl (List.mem_map_of_mem hy'PE))))]
      simp only [ScanSetup.fitVal, if_neg (hPq y hyP), ScanSetup.baseVal, if_neg hyT, hy',
        Option.map_some, Option.getD_some]
    exact ⟨hP x hxP hne.1, hP v hvP hne.2⟩
  rw [htf]
  refine ⟨fun w hw => ?_, fun w x hw => ?_⟩
  · cases w with
    | host => simp [frameOf, Frame.toFr] at hw
    | ord q =>
      have hn : S.sd.col.rep 0 q = none := by simpa [frameOf, Frame.toFr, reps0_getElem?] using hw
      have hq : ¬ q < S.sd.col.num 0 := fun hq => by
        have := (rep_isSome_iff S.sd.col q).2 hq; rw [hn] at this; cases this
      have hn' : S.cE.rep 0 q = none := by
        cases hc : S.cE.rep 0 q with
        | none => rfl
        | some _ => exact absurd (hnum ▸ (rep_isSome_iff S.cE q).1 (by rw [hc]; rfl)) hq
      simp [Frame.map, frameOf, Frame.toFr, List.getElem?_map, reps0_getElem?, hn']
    | cur q =>
      have hn : S.sd.col.rep 0 q = none := by simpa [frameOf, Frame.toFr, reps0_getElem?] using hw
      have hq : ¬ q < S.sd.col.num 0 := fun hq => by
        have := (rep_isSome_iff S.sd.col q).2 hq; rw [hn] at this; cases this
      have hn' : S.cE.rep 0 q = none := by
        cases hc : S.cE.rep 0 q with
        | none => rfl
        | some _ => exact absurd (hnum ▸ (rep_isSome_iff S.cE q).1 (by rw [hc]; rfl)) hq
      simp [Frame.map, frameOf, Frame.toFr, List.getElem?_map, reps0_getElem?, hn']
    | owner => rfl
    | inner r => rfl
  · cases w with
    | host =>
      simp only [frameOf, Frame.toFr, Option.some.injEq] at hw
      subst hw
      refine ⟨S.stopNm, by simp [Frame.map, frameOf, Frame.toFr, hTEc], ?_⟩
      show S.pkAsg β S.stopNm = _
      rw [hstopv]
      simp [ScanSetup.fitVal, hTq, ScanSetup.baseVal]
    | ord q =>
      simp only [frameOf, Frame.toFr, reps0_getElem?] at hw
      obtain ⟨⟨x0, v0⟩, hov, rfl⟩ := Option.map_eq_some_iff.1 hw
      have hq : q < S.sd.col.num 0 := (rep_isSome_iff _ _).1 (by rw [hov]; rfl)
      have hc := hrep q hq
      rw [hov] at hc
      refine ⟨S.pkTgtChart (S.chi x0), ?_, (hrepv q x0 v0 hov).1⟩
      simp [Frame.map, frameOf, Frame.toFr, List.getElem?_map, reps0_getElem?, ← hc]
    | cur q =>
      simp only [frameOf, Frame.toFr, reps0_getElem?] at hw
      obtain ⟨⟨x0, v0⟩, hov, rfl⟩ := Option.map_eq_some_iff.1 hw
      have hq : q < S.sd.col.num 0 := (rep_isSome_iff _ _).1 (by rw [hov]; rfl)
      have hc := hrep q hq
      rw [hov] at hc
      refine ⟨S.pkTgtChart (S.chi v0), ?_, (hrepv q x0 v0 hov).2⟩
      simp [Frame.map, frameOf, Frame.toFr, List.getElem?_map, reps0_getElem?, ← hc]
    | owner => cases hw
    | inner r => cases hw

/-- L7.6a step 3 helper: `χ` carries the slot of query entry `j` to entry `j` of `cE`. -/
theorem scan_origin_E8 {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) {j : Nat}
    (hj : j < S.sd.Q.length) :
    Closure.anchorOrigin S.E S.cap (.slot ⟨S.sd.col, j⟩) = some (.slot ⟨S.cE, j⟩) := by
  obtain ⟨⟨hstd, -, -, hsd, -, -, -⟩, -⟩ := hS
  simp only [ScanSetup.cE, ScanSetup.TE, ScanSetup.chi]
  simp only [ScanSetup.H] at hsd
  revert hsd
  generalize S.cap = cap
  intro hsd
  cases cap with
  | none => simp [anchorD, Closure.anchorOrigin]
  | some w =>
    obtain ⟨-, -, hlen, hT, hq⟩ := Closure.admCap_query (Closure.std_inL hstd) w hsd
    obtain ⟨ho, -⟩ := hq j (hlen ▸ hj)
    have hTd : anchorD S.E (some w) (.ord S.sd.col) = .ord w.col := by
      simp [anchorD, Closure.anchorOrigin, hT]
    simp only [hTd, Closure.anchorOrigin, ho]

/-- L7.6a steps 2–3: the scan record at a reached state is admitted. -/
theorem scanPacket_admitted_E8 {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) {i j : Nat}
    (hij : Scan.ReachesGT (Scan.rootKeys S.H S.rd) (Scan.queryKeys S.sd) i j) :
    (S.scanRecord i j).Admitted := by
  have hS' := hS
  obtain ⟨⟨hstd, hInL, hstep, hsd, hrd, hcurlt, hclosed⟩, -⟩ := hS'
  obtain ⟨hi, hj⟩ := reach_idx_E8 hij
  obtain ⟨hb, -, hnum, hentE, -⟩ := scan_target_E8 S hS (i := i) hj
  have horig := scan_origin_E8 S hS hj
  obtain ⟨-, -, -, -, -, hmem, hcur, -⟩ := Scan.rootData_spec hsd hrd
  obtain ⟨-, hrnum, -, -, -, -, hlast⟩ := Scan.rootData_path hsd hrd
  obtain ⟨colR, hcolR⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff _ _).1 hmem)
  have hiR : i < colR.length := by simpa [rootLenOf, hcolR] using hi
  have hQj : S.sd.Q[j]? = some S.sd.Q[j] := List.getElem?_eq_getElem hj
  have hRi : colR[i]? = some colR[i] := List.getElem?_eq_getElem hiR
  have hentH : S.H.entryAt ⟨S.rd.col, i⟩ = some colR[i] := by
    simp [Tree.entryAt, hcolR, hRi]
  have haH : (⟨S.rd.col, i⟩ : EntryAddr) ∈ S.H.entryAddrs :=
    (Tree.mem_entryAddrs_iff _ _).2 (by rw [hentH]; rfl)
  obtain ⟨htt, haF, hhF, -, -, -⟩ := Tree.truncAfter_spec S.H _ haH
  obtain ⟨k, hk⟩ := Scan.truncAfter_safePrefix (E := S.H) haH
  have hic : i ≤ S.rd.cursor := by
    rw [hcur]; exact Scan.trace_fst_le_cursor _ _ hij.1
  refine ⟨hstd, ?_, haF, ?_, htt, ?_, ?_⟩
  · show (S.scanRecord i j).b ∈ S.E.entryAddrs
    rw [hb, Tree.mem_entryAddrs_iff, hentE]; rfl
  · show Scan.InL (S.H.truncAfter ⟨S.rd.col, i⟩)
    rw [hk]; exact Closure.inL_safePrefix hInL k
  · -- the strict source: `y_j < x_i`
    obtain ⟨-, x, y, hx, hy, hxy⟩ := hij
    have hy' : (S.scanRecord i j).tgtKey = y := by
      have h1 := scanRecord_tgtHeight S hS (i := i) hj
      show relKey ((S.scanRecord i j).b.col.num 0) (S.scanRecord i j).tgtHeight = y
      rw [h1, hb, hnum, ← (Scan.stopData_spec hsd).2.2.1]
      simp only [Scan.queryKeys, List.getElem?_map, hQj, Option.map_some,
        Option.some.injEq] at hy
      simp [hQj, hy]
    have hx' : (S.scanRecord i j).srcKey = x := by
      show relKey (S.rd.col.num 0) (((S.H.truncAfter ⟨S.rd.col, i⟩).heightAt ⟨S.rd.col, i⟩).getD
        Tree.empty) = x
      rw [hhF]
      simp only [Scan.rootKeys, hcolR, Option.getD_some, List.getElem?_map, hRi, Option.map_some,
        Option.some.injEq] at hx
      simp [Tree.heightAt, hentH, hx]
    rw [hy', hx']; exact hxy
  · show SrcRecord.AnchorAt S.E S.cap i j (S.scanRecord i j).b ∧
      SrcRecord.anchorSrc S.E S.cap i = some ⟨S.rd.col, i⟩ ∧
      S.H.truncAfter ⟨S.rd.col, i⟩ = (Closure.anchor S.E S.cap).truncAfter ⟨S.rd.col, i⟩
    refine ⟨⟨S.sd, S.rd, hstep, hsd, hrd, by rw [hb]; exact horig, hij, ?_⟩, ?_, rfl⟩
    · intro hc
      have h1 := hlast _ hc
      simp only [rootLenOf] at h1 hi hcurlt
      have : i = S.rd.cursor := by
        simp only [ScanSetup.rootLen, rootLenOf] at hcurlt
        omega
      exact hclosed (this ▸ hc)
    · show (Scan.rootData S.H).map (fun rd => (⟨rd.col, i⟩ : EntryAddr)) = _
      rw [hrd]; rfl

section ScanValid_E8

/-- L7.6a helper: the representatives of `T`'s stack lie in `P⁻`. -/
theorem stop_reps_E8 {S : ScanSetup.{u}} (hsd : Scan.stopData S.H = some S.sd) {q : Nat}
    {x v : Role} (h : S.sd.col.rep 0 q = some (x, v)) : x ∈ S.preStop ∧ v ∈ S.preStop := by
  obtain ⟨he0, hpre0⟩ := stop_first_E8 hsd
  have hq : q < S.sd.col.num 0 := (rep_isSome_iff _ _).1 (by rw [h]; rfl)
  obtain ⟨hxP, hvP⟩ := rep_mem_prefix he0 h
  rw [hpre0] at hxP hvP
  have hne : x ≠ Role.ord S.sd.col ∧ v ≠ Role.ord S.sd.col := by
    unfold ColAddr.rep at h
    obtain ⟨o, ho, hov⟩ := Option.map_eq_some_iff.1 h
    have hon := ColAddr.resolve_num ho
    have hne : o ≠ S.sd.col := by rintro rfl; omega
    simp only [Prod.mk.injEq] at hov
    obtain ⟨rfl, rfl⟩ := hov
    refine ⟨by simp [hne], ?_⟩
    split <;> simp [hne]
  refine ⟨?_, ?_⟩
  · rcases List.mem_append.1 hxP with h | h
    · exact h
    · exact absurd (List.mem_singleton.1 h) hne.1
  · rcases List.mem_append.1 hvP with h | h
    · exact h
    · exact absurd (List.mem_singleton.1 h) hne.2

/-- L7.6a helper: on `P⁻`, `χ̂` lands in `P_E`, and the packet charts read the transported
values. -/
theorem scan_pre_val_E8 {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P)
    (β : Role → Ordinal.{u}) {y : Role} (hy : y ∈ S.preStop) :
    S.chi y ∈ S.PE ∧ S.pkTgtChart (S.chi y) = S.ePre (S.chi y) ∧
    S.pkAsg β (S.ePre (S.chi y)) = S.asg (S.ePre (S.chi y)) ∧
    S.fitVal β y = S.asg (S.ePre (S.chi y)) := by
  obtain ⟨⟨-, hInL, -, hsd, -, -, -⟩, -⟩ := hS
  obtain ⟨post, hroles, -⟩ := stop_roles_E8 hsd
  have hnd := Tree.roles_nodup S.H
  rw [hroles, List.nodup_append, List.nodup_cons] at hnd
  have hPq : y ∉ S.queryRoles := fun h =>
    hnd.2.2 _ hy _ (List.mem_cons_of_mem _ (List.mem_append_left _ h)) rfl
  have hPT : y ≠ Role.ord S.sd.col := fun h => hnd.2.2 _ hy _ List.mem_cons_self h
  obtain ⟨T', hT', -, hpre'⟩ := Closure.anchorOrigin_prefix hInL hsd
  obtain ⟨y', hy', hyPE, -⟩ := hpre' y hy
  have hchi : S.chi y = y' := by simp [ScanSetup.chi, anchorD, hy']
  have hy'PE : y' ∈ S.PE := by
    simp only [ScanSetup.PE, ScanSetup.TE, ScanSetup.chi, anchorD, hT', Option.getD_some]
    exact hyPE
  rw [hchi]
  refine ⟨hy'PE, by simp only [ScanSetup.pkTgtChart, if_pos hy'PE], ?_, ?_⟩
  · exact pkAsg_used_E8 S β (by
      simp only [ScanSetup.usedNames, List.mem_append]
      exact Or.inl (Or.inl (Or.inl (List.mem_map_of_mem hy'PE))))
  · simp only [ScanSetup.fitVal, if_neg hPq, ScanSetup.baseVal, if_neg hPT, hy',
      Option.map_some, Option.getD_some]

/-- L7.6a helper: `T_E` and `R` are both read as `ρ`. -/
theorem scan_hosts_E8 {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) :
    S.pkTgtChart S.TE = S.stopNm ∧ S.pkSrcChart S.R = S.stopNm := by
  refine ⟨?_, ?_⟩
  · have hnot : S.TE ∉ S.PE := by
      intro h
      have := List.all_eq_true.1 List.all_takeWhile _ h
      simp at this
    simp only [ScanSetup.pkTgtChart, if_neg hnot, if_true]
  · have hnot : S.R ∉ S.preRoot := by
      intro h
      have := List.all_eq_true.1 List.all_takeWhile _ h
      simp at this
    simp only [ScanSetup.pkSrcChart, if_neg hnot, if_true]

/-- L7.6a step 6 (Valid clause 3): both host roles are named `ρ`. -/
theorem scan_valid3_E8 {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) {i j : Nat}
    (hj : j < S.sd.Q.length) (β : Role → Ordinal.{u}) :
    (S.scanPacket i j β).tgtChart (.ord (S.scanPacket i j β).rk.b.col) =
      (S.scanPacket i j β).host := by
  obtain ⟨hb, hTE, -, -, -⟩ := scan_target_E8 S hS (i := i) hj
  obtain ⟨h1, h2⟩ := scan_hosts_E8 S hS
  show S.pkTgtChart (.ord (S.scanRecord i j).b.col) = S.pkSrcChart (.ord S.rd.col)
  rw [hb]
  rw [hTE] at h1
  rw [h1]
  exact h2.symm

/-- L7.6a step 9 (Valid clause 5): both target heads at the source owner. -/
theorem scan_valid6_E8 {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) {i j : Nat}
    (hij : Scan.ReachesGT (Scan.rootKeys S.H S.rd) (Scan.queryKeys S.sd) i j)
    {β : Role → Ordinal.{u}} (hheads : S.HeadsAt P j i β) :
    ∃ o v, (S.scanPacket i j β).tgtFrame.reps[(S.scanPacket i j β).rk.tgtSel]? = some (o, v) ∧
      P.Edge ((S.scanPacket i j β).asg (S.scanPacket i j β).owner)
        ((S.scanPacket i j β).asg (S.scanPacket i j β).host) ((S.scanPacket i j β).asg o) ∧
      P.Edge ((S.scanPacket i j β).asg (S.scanPacket i j β).owner)
        ((S.scanPacket i j β).asg (S.scanPacket i j β).host) ((S.scanPacket i j β).asg v) := by
  have hS' := hS
  obtain ⟨⟨-, -, -, hsd, -, -, -⟩, -⟩ := hS'
  have hj := (reach_idx_E8 hij).2
  obtain ⟨hb, -, hnum, hentE, hrep⟩ := scan_target_E8 S hS (i := i) hj
  have hown := scan_owner_E8 S hS hij β
  obtain ⟨p, o, v, hp, hov, he1, he2⟩ := hheads
  have hQj : S.sd.Q[j]? = some S.sd.Q[j] := List.getElem?_eq_getElem hj
  have hsel : (S.scanPacket i j β).rk.tgtSel = p := by
    show (((S.scanRecord i j).E.entryAt (S.scanRecord i j).b).map Prod.fst).getD 0 = p
    rw [hb]
    rw [hQj] at hp
    simp only [Option.map_some, Option.some.injEq] at hp
    simp [ScanSetup.scanRecord, hentE, hp]
  have hov' : S.sd.col.rep 0 p = some (o, v) := by
    simpa [frameOf, reps0_getElem?] using hov
  have hp' : p < S.sd.col.num 0 := (rep_isSome_iff _ _).1 (by rw [hov']; rfl)
  have hc := hrep p hp'
  rw [hov'] at hc
  obtain ⟨hoP, hvP⟩ := stop_reps_E8 hsd hov'
  obtain ⟨-, ho1, ho2, ho3⟩ := scan_pre_val_E8 S hS β hoP
  obtain ⟨-, hv1, hv2, hv3⟩ := scan_pre_val_E8 S hS β hvP
  have hhost : (S.scanPacket i j β).asg (S.scanPacket i j β).host = S.asg S.stopNm := by
    show S.pkAsg β (S.pkSrcChart (.ord S.rd.col)) = _
    have := (scan_hosts_E8 S hS).2
    simp only [ScanSetup.R] at this
    rw [this]
    exact pkAsg_used_E8 S β (by simp [ScanSetup.usedNames])
  refine ⟨S.pkTgtChart (S.chi o), S.pkTgtChart (S.chi v), ?_, ?_, ?_⟩
  · show ((frameOf (S.scanRecord i j).b).map S.pkTgtChart).reps[(S.scanPacket i j β).rk.tgtSel]? = _
    rw [hsel, hb]
    simp [Frame.map, frameOf, List.getElem?_map, reps0_getElem?, ← hc]
  · rw [hown, hhost]
    show P.Edge _ _ (S.pkAsg β (S.pkTgtChart (S.chi o)))
    rw [ho1, ho2, ← ho3]; exact he1
  · rw [hown, hhost]
    show P.Edge _ _ (S.pkAsg β (S.pkTgtChart (S.chi v)))
    rw [hv1, hv2, ← hv3]; exact he2

/-- L7.6a helper: the representatives of a stack are not the column itself. -/
theorem rep_ne_self_E8 {c : ColAddr} {q : Nat} {x v : Role} (h : c.rep 0 q = some (x, v)) :
    x ≠ Role.ord c ∧ v ≠ Role.ord c := by
  have hq : q < c.num 0 := (rep_isSome_iff _ _).1 (by rw [h]; rfl)
  unfold ColAddr.rep at h
  obtain ⟨o, ho, hov⟩ := Option.map_eq_some_iff.1 h
  have hon := ColAddr.resolve_num ho
  have hne : o ≠ c := by rintro rfl; omega
  simp only [Prod.mk.injEq] at hov
  obtain ⟨rfl, rfl⟩ := hov
  refine ⟨by simp [hne], ?_⟩
  split <;> simp [hne]

/-- L7.6a helper: `R` is followed by the slot of the first root entry. -/
theorem root_first_E8 {S : ScanSetup.{u}} (hsd : Scan.stopData S.H = some S.sd)
    (hrd : Scan.rootData S.H = some S.rd) (hlen : 0 < rootLenOf S.H S.rd) :
    (⟨S.rd.col, 0⟩ : EntryAddr) ∈ S.H.entryAddrs ∧
    prefixRoles S.H ⟨S.rd.col, 0⟩ = S.preRoot ++ [S.R] := by
  obtain ⟨-, -, -, -, -, hmem, -, -⟩ := Scan.rootData_spec hsd hrd
  obtain ⟨colR, hcolR⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff _ _).1 hmem)
  obtain ⟨A, B, hr⟩ := roles_col_decomp hcolR
  have hR : S.preRoot = A := rolesBefore_of_decomp_E8 hr
  rcases hc : colR with _ | ⟨c0, ct⟩
  · simp [rootLenOf, hcolR, hc] at hlen
  · refine ⟨(Tree.mem_entryAddrs_iff _ _).2 (by simp [Tree.entryAt, hcolR, hc]), ?_⟩
    rw [hR]
    refine rolesBefore_of_decomp_E8 (rest := Tree.rolesF (S.rd.col.path ++ [(S.rd.col.col, 0)])
      c0.2 ++ (Tree.rolesCol S.rd.col.path S.rd.col.col 1 ct ++ B)) ?_
    rw [hr, hc]
    simp [Tree.rolesCol, ScanSetup.R]

/-- L7.6a step 7 (Valid clause 4): the source frame below `r` is the target frame. -/
theorem scan_valid4_E8 {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) {i j : Nat}
    (hj : j < S.sd.Q.length) (β : Role → Ordinal.{u}) :
    (S.scanPacket i j β).srcFrame.reps.take ((S.scanPacket i j β).rk.a.col.num 0) =
      (S.scanPacket i j β).tgtFrame.reps.take ((S.scanPacket i j β).rk.a.col.num 0) := by
  have hS' := hS
  obtain ⟨⟨-, -, -, hsd, hrd, hcurlt, -⟩, -⟩ := hS'
  obtain ⟨hb, -, -, -, hrep⟩ := scan_target_E8 S hS (i := i) hj
  obtain ⟨hres, -, -, hrnum, hrt, -, -, -⟩ := Scan.rootData_spec hsd hrd
  have ht := (Scan.stopData_spec hsd).2.2.1
  have hlen : 0 < rootLenOf S.H S.rd := by
    simp only [ScanSetup.rootLen] at hcurlt; omega
  obtain ⟨he0R, hpre0R⟩ := root_first_E8 hsd hrd hlen
  have hvis : S.sd.col.resolve 0 (S.rd.col.num 0) = some S.rd.col := by rw [hrnum]; exact hres
  show ((frameOf ⟨S.rd.col, i⟩).map S.pkSrcChart).reps.take (S.rd.col.num 0) =
    ((frameOf (S.scanRecord i j).b).map S.pkTgtChart).reps.take (S.rd.col.num 0)
  rw [hb]
  apply List.ext_getElem?
  intro q
  simp only [Frame.map, frameOf, List.getElem?_take, List.getElem?_map, reps0_getElem?]
  split_ifs with hq
  · have h1 := rep_visible S.sd.col S.rd.col hvis q hq
    have h2 := hrep q (by omega)
    rw [h1, ← h2]
    cases h : S.sd.col.rep 0 q with
    | none => rfl
    | some xv =>
      obtain ⟨x, v⟩ := xv
      have hR : S.rd.col.rep 0 q = some (x, v) := by rw [h1]; exact h
      obtain ⟨hxP, hvP⟩ := rep_mem_prefix he0R hR
      rw [hpre0R] at hxP hvP
      obtain ⟨hxR, hvR⟩ := rep_ne_self_E8 hR
      have hxR' : x ∈ S.preRoot := by
        rcases List.mem_append.1 hxP with h | h
        · exact h
        · exact absurd (List.mem_singleton.1 h) hxR
      have hvR' : v ∈ S.preRoot := by
        rcases List.mem_append.1 hvP with h | h
        · exact h
        · exact absurd (List.mem_singleton.1 h) hvR
      obtain ⟨hxS, hvS⟩ := stop_reps_E8 hsd h
      have hx := (scan_pre_val_E8 S hS β hxS).2.1
      have hv := (scan_pre_val_E8 S hS β hvS).2.1
      simp only [Option.map_some, ScanSetup.pkSrcChart, if_pos hxR', if_pos hvR', hx, hv]
  · rfl

section ScanLow_E8

/-- L7.6a helper: relocating a column moves the roles under its entries. -/
theorem transColumn_under_E8 (c c' : ColAddr) (k : Nat) (r : Role) :
    transColumn c c' id (Role.under (c.path ++ [(c.col, k)]) r) =
      Role.under (c'.path ++ [(c'.col, k)]) r := by
  have hne : ∀ d : ColAddr, d.path = c.path ++ (c.col, k) :: d.path.drop (c.path.length + 1) →
      relocCol c c' id d = ⟨c'.path ++ (c'.col, k) :: d.path.drop (c.path.length + 1), d.col⟩ := by
    intro d hd
    have h1 : d ≠ c := by
      intro h; rw [h] at hd; have := congrArg List.length hd; simp at this
    unfold relocCol
    rw [if_neg h1, if_pos (by rw [List.isPrefixOf_iff_prefix, hd]; exact List.prefix_append _ _)]
    rw [hd]
    simp
  cases r with
  | ord d =>
    simp only [Role.under, transColumn]
    rw [hne ⟨c.path ++ [(c.col, k)] ++ d.path, d.col⟩ (by simp)]
    simp
  | slot e =>
    simp only [Role.under, transColumn]
    have h1 : (⟨c.path ++ [(c.col, k)] ++ e.col.path, e.col.col⟩ : ColAddr) ≠ c := by
      intro h; have := congrArg (fun x : ColAddr => x.path.length) h
      simp at this
    rw [if_neg h1, hne ⟨c.path ++ [(c.col, k)] ++ e.col.path, e.col.col⟩ (by simp)]
    simp

/-- L7.6a helper: relocating a column maps its entry roles to those of the new column. -/
theorem rolesCol_transColumn_E8 (c c' : ColAddr) :
    ∀ (L : Column) (i : Nat), (Tree.rolesCol c.path c.col i L).map (transColumn c c' id) =
      Tree.rolesCol c'.path c'.col i L
  | [], _ => rfl
  | (p, h) :: rest, i => by
    simp only [Tree.rolesCol, List.map_cons, List.map_append, Tree.rolesF_eq_map_under,
      List.map_map]
    rw [rolesCol_transColumn_E8 c c' rest (i + 1)]
    have hs : transColumn c c' id (.slot ⟨⟨c.path, c.col⟩, i⟩) = .slot ⟨⟨c'.path, c'.col⟩, i⟩ := by
      simp [transColumn]
    rw [hs]
    congr 2
    apply List.map_congr_left
    intro r _
    exact transColumn_under_E8 c c' i r

/-- L7.6a helper: the column of `cE` in `E` agrees with the query before `|Q|`. -/
theorem scan_col_E8 {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) :
    ∃ colE, S.E.colAt S.cE = some colE ∧ ∀ j' < S.sd.Q.length, colE[j']? = S.sd.Q[j']? := by
  obtain ⟨⟨hstd, -, -, hsd, -, -, -⟩, -⟩ := hS
  have hcolH := (Scan.stopData_spec hsd).1
  simp only [ScanSetup.cE, ScanSetup.TE, ScanSetup.chi]
  simp only [ScanSetup.H] at hsd hcolH
  revert hsd hcolH
  generalize S.cap = cap
  intro hsd hcolH
  cases cap with
  | none =>
    simp only [anchorD, Closure.anchorOrigin, Option.getD_some]
    simp only [Closure.anchor] at hcolH
    exact ⟨_, hcolH, fun j' hj' => List.getElem?_append_left hj'⟩
  | some w =>
    obtain ⟨-, -, hlen, hT, hq⟩ := Closure.admCap_query (Closure.std_inL hstd) w hsd
    have hTd : anchorD S.E (some w) (.ord S.sd.col) = .ord w.col := by
      simp [anchorD, Closure.anchorOrigin, hT]
    simp only [hTd]
    cases hc : S.E.colAt w.col with
    | none =>
      exfalso
      have hup := w.upward
      unfold Closure.IsUpward at hup
      rw [hc] at hup
      exact hup
    | some colE =>
      refine ⟨colE, rfl, fun j' hj' => ?_⟩
      have := (hq j' (hlen ▸ hj')).2
      rw [hc, Option.getD_some] at this
      exact this.symm

/-- L7.6a helper: the prefix of entry `j` of a column: the roles before the column, the column,
and the roles of its entries before `j`. -/
theorem col_prefix_E8 {t : Forest} {c : ColAddr} {col : Column} (h : t.colAt c = some col)
    {j : Nat} (hj : j < col.length) :
    prefixRoles t ⟨c, j⟩ = rolesBefore t (.ord c) ++
      Role.ord c :: Tree.rolesCol c.path c.col 0 (col.take j) := by
  obtain ⟨A, B, hr⟩ := roles_col_decomp h
  rw [rolesBefore_of_decomp_E8 hr]
  have hsplit : Tree.rolesCol c.path c.col 0 col = Tree.rolesCol c.path c.col 0 (col.take j) ++
      Role.slot ⟨c, j⟩ :: (Tree.rolesF (c.path ++ [(c.col, j)]) col[j].2 ++
        Tree.rolesCol c.path c.col (j + 1) (col.drop (j + 1))) := by
    conv_lhs => rw [← List.take_append_drop j col, List.drop_eq_getElem_cons hj]
    rw [Tree.rolesCol_append, List.length_take, Nat.min_eq_left hj.le, Nat.zero_add]
    rfl
  refine rolesBefore_of_decomp_E8 (rest := Tree.rolesF (c.path ++ [(c.col, j)]) col[j].2 ++
    (Tree.rolesCol c.path c.col (j + 1) (col.drop (j + 1)) ++ B)) ?_
  rw [hr, hsplit]; simp

theorem mem_zip_tail_iff_E8 {β : Type} {l : List β} {a b : β} :
    (a, b) ∈ l.zip l.tail ↔ ∃ s t, l = s ++ a :: b :: t := by
  induction l with
  | nil => simp
  | cons x l ih =>
    cases l with
    | nil =>
      simp only [List.tail_cons, List.zip_nil_right, List.not_mem_nil, false_iff, not_exists]
      intro s t h
      have := congrArg List.length h
      simp at this
      omega
    | cons y l =>
      simp only [List.tail_cons, List.zip_cons_cons, List.mem_cons, Prod.mk.injEq] at ih ⊢
      rw [ih]
      constructor
      · rintro (⟨rfl, rfl⟩ | ⟨s, t, h⟩)
        · exact ⟨[], l, rfl⟩
        · exact ⟨x :: s, t, by rw [h]; rfl⟩
      · rintro ⟨s, t, h⟩
        cases s with
        | nil =>
          simp only [List.nil_append, List.cons.injEq] at h
          exact Or.inl ⟨h.1.symm, h.2.1.symm⟩
        | cons z s =>
          simp only [List.cons_append, List.cons.injEq] at h
          exact Or.inr ⟨s, t, h.2⟩

theorem lt_chain_graph_E8 {E : Forest} {pre l post : List Role}
    (h : E.roles = pre ++ l ++ post) :
    ∀ xy ∈ l.zip l.tail, BaseAtom.lt xy.1 xy.2 ∈ graph E := by
  rintro ⟨a, b⟩ hab
  obtain ⟨s, t, rfl⟩ := mem_zip_tail_iff_E8.1 hab
  simp only [graph, List.mem_append]
  refine Or.inl (Or.inl (Or.inr (List.mem_map.2 ⟨(a, b), ?_, rfl⟩)))
  exact mem_zip_tail_iff_E8.2 ⟨pre ++ s, t ++ post, by rw [h]; simp⟩

theorem chain_pairwise_E8 {P : Prims.{u}} {V : Type} {D : List (BaseAtom V)}
    {β : V → Ordinal.{u}} {l : List V} (hl : ∀ xy ∈ l.zip l.tail, BaseAtom.lt xy.1 xy.2 ∈ D)
    (hD : BaseHolds P D β) : l.Pairwise fun x y => β x < β y := by
  induction l with
  | nil => exact List.Pairwise.nil
  | cons x rest ih =>
    cases rest with
    | nil => exact List.pairwise_singleton _ _
    | cons y rest' =>
      have hxy : β x < β y := hD _ (hl (x, y) (by simp))
      have ih' := ih fun xy h => hl xy (by
        simp only [List.tail_cons, List.zip_cons_cons, List.mem_cons] at h ⊢
        exact Or.inr h)
      refine List.pairwise_cons.2 ⟨fun z hz => ?_, ih'⟩
      rcases List.mem_cons.1 hz with rfl | hz
      · exact hxy
      · exact hxy.trans (List.rel_of_pairwise_cons ih' hz)

/-- L7.6a step 10 helper (S5): `R` followed by the bank is strictly increasing at the bank
values. -/
theorem bank_chain_E8 {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) :
    ∃ colR, S.H.colAt S.rd.col = some colR ∧ S.rd.cursor < colR.length ∧
      (S.R :: Tree.rolesCol S.rd.col.path S.rd.col.col 0 (colR.take (S.rd.cursor + 1))).Pairwise
        fun a b => S.bankVal a < S.bankVal b := by
  obtain ⟨⟨-, -, -, hsd, hrd, hcur, -⟩, -, -, -, h5, -⟩ := hS
  obtain ⟨-, -, -, -, -, hmem, -, -⟩ := Scan.rootData_spec hsd hrd
  obtain ⟨colR, hcolR⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff _ _).1 hmem)
  obtain ⟨pre, post, hr⟩ := roles_col_decomp hcolR
  have hpre : S.preRoot = pre := rolesBefore_of_decomp_E8 hr
  simp only [ScanSetup.rootLen, rootLenOf, hcolR, Option.getD_some] at hcur
  refine ⟨colR, hcolR, hcur, ?_⟩
  set BK := Tree.rolesCol S.rd.col.path S.rd.col.col 0 (colR.take (S.rd.cursor + 1)) with hBK
  have hsplit : Tree.rolesCol S.rd.col.path S.rd.col.col 0 colR =
      BK ++ Tree.rolesCol S.rd.col.path S.rd.col.col (colR.take (S.rd.cursor + 1)).length
        (colR.drop (S.rd.cursor + 1)) := by
    conv_lhs => rw [← List.take_append_drop (S.rd.cursor + 1) colR]
    rw [Tree.rolesCol_append, Nat.zero_add]
  have hr' : S.H.roles = S.preRoot ++ (S.R :: BK) ++
      (Tree.rolesCol S.rd.col.path S.rd.col.col (colR.take (S.rd.cursor + 1)).length
        (colR.drop (S.rd.cursor + 1)) ++ post) := by
    rw [hr, hsplit, hpre]; simp [ScanSetup.R]
  have hbank : ∀ x ∈ BK, x ∈ S.bankRoles := by
    intro x hx
    refine List.mem_filter.2 ⟨by rw [hr']; simp [hx], List.any_eq_true.2 ?_⟩
    obtain ⟨k, -, hk, hin⟩ := Scan.rolesCol_inEntry _ _ _ 0 x hx
    simp only [List.length_take] at hk
    exact ⟨k, List.mem_range.2 (by omega), hin⟩
  refine chain_pairwise_E8 (D := S.bankGraph) (fun xy hxy => ?_) h5
  have hlt := lt_chain_graph_E8 hr' xy hxy
  obtain ⟨a, b⟩ := xy
  obtain ⟨s, t, hst⟩ := mem_zip_tail_iff_E8.1 hxy
  have hb : b ∈ BK := by
    cases s with
    | nil => simp only [List.nil_append, List.cons.injEq] at hst; rw [hst.2]; simp
    | cons z s =>
      simp only [List.cons_append, List.cons.injEq] at hst
      rw [hst.2]; simp
  have ha : a = S.R ∨ a ∈ BK := by
    have : a ∈ S.R :: BK := by rw [hst]; simp
    simpa using this
  refine List.mem_filter.2 ⟨List.mem_filter.2 ⟨hlt, ?_⟩, ?_⟩
  · simp only [BaseAtom.vars, List.all_cons, List.all_nil, Bool.and_true, Bool.and_eq_true,
      decide_eq_true_eq, List.mem_append, List.mem_singleton]
    refine ⟨?_, Or.inr (hbank b hb)⟩
    rcases ha with rfl | ha
    · exact Or.inl (Or.inr rfl)
    · exact Or.inr (hbank a ha)
  · simp only [BaseAtom.vars, List.any_cons, List.any_nil, Bool.or_false, Bool.or_eq_true,
      decide_eq_true_eq]
    exact Or.inr (List.mem_cons_of_mem _ (hbank b hb))

/-- L7.6a helper: `P_R ⊆ P⁻` (the root column lies on the stopping column's stack). -/
theorem preRoot_sub_preStop_E8 {S : ScanSetup.{u}} (hsd : Scan.stopData S.H = some S.sd)
    (hrd : Scan.rootData S.H = some S.rd) {y : Role} (hy : y ∈ S.preRoot) : y ∈ S.preStop := by
  obtain ⟨hres, -⟩ := Scan.rootData_spec hsd hrd
  obtain ⟨v, hv⟩ : ∃ v, S.sd.col.rep 0 S.sd.r = some (Role.ord S.rd.col, v) := by
    unfold ColAddr.rep; rw [hres]; exact ⟨_, rfl⟩
  have hR := (stop_reps_E8 hsd hv).1
  exact rolesBefore_sub_prefix (List.takeWhile_prefix _) hR hy

end ScanLow_E8

section ScanInj_E8

/-- L7.6a step 4 helper: the target prefix `P(E, b) = P_E ++ T_E :: fE`, with `fE` moved onto the
fitted roles of `H` by `toH`. -/
theorem scan_tgt_prefix_E8 {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) {i j : Nat}
    (hj : j < S.sd.Q.length) :
    ∃ fE, prefixRoles S.E (S.scanRecord i j).b = S.PE ++ S.TE :: fE ∧
      fE.map S.toH = Tree.rolesCol S.sd.col.path S.sd.col.col 0 (S.sd.Q.take j) := by
  obtain ⟨hb, hTE, -, -, -⟩ := scan_target_E8 S hS (i := i) hj
  obtain ⟨colE, hcolE, hagree⟩ := scan_col_E8 S hS
  have hjE : j < colE.length := (List.getElem?_eq_some_iff.1
    ((hagree j hj).trans (List.getElem?_eq_getElem hj))).1
  have hpre := col_prefix_E8 hcolE hjE
  have hPEd : rolesBefore S.E (.ord S.cE) = S.PE := by simp only [ScanSetup.PE, hTE]
  have htake : colE.take j = S.sd.Q.take j := by
    apply List.ext_getElem?
    intro k
    simp only [List.getElem?_take]
    split_ifs with hk
    · exact hagree k (by omega)
    · rfl
  refine ⟨Tree.rolesCol S.cE.path S.cE.col 0 (colE.take j), ?_, ?_⟩
  · rw [hb, hpre, hPEd, hTE]
  · rw [htake]; exact rolesCol_transColumn_E8 S.cE S.sd.col _ 0

/-- L7.6a step 4 helper: the fitted entries of `H` before `j` are fitted roles, without
repetition. -/
theorem fitted_rolesCol_E8 {S : ScanSetup.{u}} (hsd : Scan.stopData S.H = some S.sd) (j : Nat) :
    (Tree.rolesCol S.sd.col.path S.sd.col.col 0 (S.sd.Q.take j)).Nodup ∧
    ∀ z ∈ Tree.rolesCol S.sd.col.path S.sd.col.col 0 (S.sd.Q.take j), z ∈ S.fittedRoles j := by
  obtain ⟨post, hroles, hQ⟩ := stop_roles_E8 hsd
  have hsplit : Tree.rolesCol S.sd.col.path S.sd.col.col 0 S.sd.Q =
      Tree.rolesCol S.sd.col.path S.sd.col.col 0 (S.sd.Q.take j) ++
        Tree.rolesCol S.sd.col.path S.sd.col.col (0 + (S.sd.Q.take j).length) (S.sd.Q.drop j) := by
    rw [← Tree.rolesCol_append, List.take_append_drop]
  have hnd := Tree.roles_nodup S.H
  rw [hroles, hQ, hsplit] at hnd
  refine ⟨?_, fun z hz => ?_⟩
  · refine hnd.sublist ?_
    exact (List.sublist_append_left _ _).trans ((List.sublist_append_left _ _).trans
      ((List.sublist_cons_self _ _).trans (List.sublist_append_right _ _)))
  · obtain ⟨k, -, hk, hin⟩ := Scan.rolesCol_inEntry _ _ _ 0 _ hz
    simp only [List.length_take, Nat.zero_add] at hk
    refine List.mem_filter.2 ⟨?_, List.any_eq_true.2 ⟨k, List.mem_range.2 (by omega), hin⟩⟩
    rw [hQ, hsplit]
    exact List.mem_append_left _ hz

/-- L7.6a step 4 helper: `Γ(F)`'s roles are `P_R`, `R` and bank roles. -/
theorem scan_src_roles_E8 {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) {i j : Nat}
    (hij : Scan.ReachesGT (Scan.rootKeys S.H S.rd) (Scan.queryKeys S.sd) i j) :
    ∃ Bk, (S.scanRecord i j).F.roles = S.preRoot ++ S.R :: Bk ∧ ∀ z ∈ Bk, z ∈ S.bankRoles := by
  have hS' := hS
  obtain ⟨⟨-, -, -, hsd, hrd, -, -⟩, -⟩ := hS'
  obtain ⟨hi, -⟩ := reach_idx_E8 hij
  obtain ⟨colR, hcolR, hcurR, -⟩ := bank_chain_E8 S hS
  obtain ⟨-, -, -, -, -, -, hcur, -⟩ := Scan.rootData_spec hsd hrd
  have hic : i ≤ S.rd.cursor := by rw [hcur]; exact Scan.trace_fst_le_cursor _ _ hij.1
  have hiR : i < colR.length := by omega
  have haH : (⟨S.rd.col, i⟩ : EntryAddr) ∈ S.H.entryAddrs := by
    rw [Tree.mem_entryAddrs_iff]; simp [Tree.entryAt, hcolR, List.getElem?_eq_getElem hiR]
  have hroles := Tree.truncAfter_roles_under haH
  rw [col_prefix_E8 hcolR hiR] at hroles
  obtain ⟨A, B, hr⟩ := roles_col_decomp hcolR
  have hsplit : Tree.rolesCol S.rd.col.path S.rd.col.col 0 colR =
      Tree.rolesCol S.rd.col.path S.rd.col.col 0 (colR.take i) ++
        Tree.rolesCol S.rd.col.path S.rd.col.col (0 + (colR.take i).length) (colR.drop i) := by
    rw [← Tree.rolesCol_append, List.take_append_drop]
  have hbankOf : ∀ z, z ∈ S.H.roles → ∀ k ≤ S.rd.cursor, z.inEntry ⟨S.rd.col, k⟩ = true →
      z ∈ S.bankRoles := fun z hz k hk hin =>
    List.mem_filter.2 ⟨hz, List.any_eq_true.2 ⟨k, List.mem_range.2 (by omega), hin⟩⟩
  refine ⟨Tree.rolesCol S.rd.col.path S.rd.col.col 0 (colR.take i) ++
    Role.slot ⟨S.rd.col, i⟩ :: List.map (Role.under (⟨S.rd.col, i⟩ : EntryAddr).heightPath)
      ((S.H.heightAt ⟨S.rd.col, i⟩).getD Tree.empty).roles, ?_, fun z hz => ?_⟩
  · show (S.H.truncAfter ⟨S.rd.col, i⟩).roles = _
    rw [hroles]; simp [ScanSetup.preRoot, ScanSetup.R]
  rcases List.mem_append.1 hz with hz | hz
  · obtain ⟨k, -, hk, hin⟩ := Scan.rolesCol_inEntry _ _ _ 0 z hz
    simp only [List.length_take, Nat.zero_add] at hk
    refine hbankOf z ?_ k (by omega) hin
    rw [hr, hsplit]; simp [hz]
  · rcases List.mem_cons.1 hz with rfl | hz
    · refine hbankOf _ ?_ i hic (by simp [Role.inEntry])
      rw [Tree.mem_roles_iff]; simp [Tree.entryAt, hcolR, List.getElem?_eq_getElem hiR]
    · obtain ⟨r, hr', rfl⟩ := List.mem_map.1 hz
      obtain ⟨Bh, hBh⟩ : ∃ Bh, S.H.heightAt ⟨S.rd.col, i⟩ = some Bh := by
        simp [Tree.heightAt, Tree.entryAt, hcolR, List.getElem?_eq_getElem hiR]
      rw [hBh, Option.getD_some] at hr'
      refine hbankOf _ (Tree.under_mem_roles hBh hr') i hic ?_
      rw [inEntry_iff]; right; rw [Role.path_under]; exact List.prefix_append _ _

end ScanInj_E8

/-- L7.6a step 5 (Valid clause 1): the target chart is injective on `P(E, b)`. -/
theorem scan_valid1_E8 {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) {i j : Nat}
    (hj : j < S.sd.Q.length) (β : Role → Ordinal.{u}) :
    Set.InjOn (S.scanPacket i j β).tgtChart
      {x | x ∈ prefixRoles (S.scanPacket i j β).rk.E (S.scanPacket i j β).rk.b} := by
  have hS' := hS
  obtain ⟨⟨-, -, -, hsd, -, -, -⟩, ⟨hinj, -, hPE⟩, -⟩ := hS'
  obtain ⟨fE, hpre, hmap⟩ := scan_tgt_prefix_E8 S hS (i := i) hj
  obtain ⟨hndF, -⟩ := fitted_rolesCol_E8 hsd j
  have hnd : (prefixRoles S.E (S.scanRecord i j).b).Nodup :=
    (Tree.roles_nodup S.E).sublist (List.takeWhile_sublist _)
  rw [hpre] at hnd
  have hnd' := List.nodup_append.1 hnd
  have hTfE : S.TE ∉ fE := (List.nodup_cons.1 hnd'.2.1).1
  have hfEP : ∀ y ∈ fE, y ∉ S.PE := fun y hy h =>
    hnd'.2.2 _ h _ (List.mem_cons_of_mem _ hy) rfl
  have hTP : S.TE ∉ S.PE := fun h => hnd'.2.2 _ h _ List.mem_cons_self rfl
  obtain ⟨hTc, -⟩ := scan_hosts_E8 S hS
  have hfresh : ∀ n ∈ S.usedNames, ∀ r, n ≠ Name.role S.fitTag r := by
    rintro n hn r rfl; exact freshTag_fresh S.usedNames r hn
  have hPEu : ∀ y ∈ S.PE, S.ePre y ∈ S.usedNames := fun y hy => by
    simp only [ScanSetup.usedNames, List.mem_append]
    exact Or.inl (Or.inl (Or.inl (List.mem_map_of_mem hy)))
  have hstopu : S.stopNm ∈ S.usedNames := by simp [ScanSetup.usedNames]
  have hval : ∀ y ∈ S.PE, S.ePre y ≠ S.stopNm := fun y hy h => by
    have := hPE y hy; rw [h] at this; exact lt_irrefl _ this
  -- the chart on each part
  have hcP : ∀ y ∈ S.PE, S.pkTgtChart y = S.ePre y := fun y hy => by
    simp only [ScanSetup.pkTgtChart, if_pos hy]
  have hcF : ∀ y ∈ fE, S.pkTgtChart y = .role S.fitTag (S.toH y) := fun y hy => by
    have h1 := hfEP y hy
    have h2 : y ≠ S.TE := fun h => hTfE (h ▸ hy)
    simp only [ScanSetup.pkTgtChart, if_neg h1, if_neg h2]
  intro x hx y hy hxy
  change S.pkTgtChart x = S.pkTgtChart y at hxy
  have hx' : x ∈ S.PE ++ S.TE :: fE := by
    have : (S.scanPacket i j β).rk.b = (S.scanRecord i j).b := rfl
    rw [← hpre]; exact hx
  have hy' : y ∈ S.PE ++ S.TE :: fE := by
    rw [← hpre]; exact hy
  simp only [List.mem_append, List.mem_cons] at hx' hy'
  rcases hx' with hx' | rfl | hx' <;> rcases hy' with hy' | rfl | hy'
  · rw [hcP x hx', hcP y hy'] at hxy; exact hinj hx' hy' hxy
  · rw [hcP x hx', hTc] at hxy; exact absurd hxy (hval x hx')
  · rw [hcP x hx', hcF y hy'] at hxy; exact absurd hxy (hfresh _ (hPEu x hx') _)
  · rw [hcP y hy', hTc] at hxy; exact absurd hxy.symm (hval y hy')
  · rfl
  · rw [hTc, hcF y hy'] at hxy; exact absurd hxy (hfresh _ hstopu _)
  · rw [hcP y hy', hcF x hx'] at hxy; exact absurd hxy.symm (hfresh _ (hPEu y hy') _)
  · rw [hTc, hcF x hx'] at hxy; exact absurd hxy.symm (hfresh _ hstopu _)
  · rw [hcF x hx', hcF y hy'] at hxy
    simp only [Name.role.injEq, true_and] at hxy
    refine List.inj_on_of_nodup_map ?_ hx' hy' hxy
    rw [hmap]; exact hndF

/-- L7.6a step 5 (Valid clause 2): the source chart is injective on `Γ(F)`. -/
theorem scan_valid2_E8 {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) {i j : Nat}
    (hij : Scan.ReachesGT (Scan.rootKeys S.H S.rd) (Scan.queryKeys S.sd) i j)
    (β : Role → Ordinal.{u}) :
    Set.InjOn (S.scanPacket i j β).srcChart {x | x ∈ (S.scanPacket i j β).rk.F.roles} := by
  have hS' := hS
  obtain ⟨⟨-, hInL, -, hsd, hrd, -, -⟩, ⟨hinj, -, hPE⟩, -, -, -, ⟨-, hbinj, -, -, hbfresh⟩⟩ := hS'
  obtain ⟨Bk, hroles, hBk⟩ := scan_src_roles_E8 S hS hij
  have hnd := Tree.roles_nodup (S.scanRecord i j).F
  rw [hroles] at hnd
  have hnd' := List.nodup_append.1 hnd
  have hRB : S.R ∉ Bk := (List.nodup_cons.1 hnd'.2.1).1
  have hBP : ∀ y ∈ Bk, y ∉ S.preRoot := fun y hy h => hnd'.2.2 _ h _ (List.mem_cons_of_mem _ hy) rfl
  have hRP : S.R ∉ S.preRoot := fun h => hnd'.2.2 _ h _ List.mem_cons_self rfl
  obtain ⟨-, hRc⟩ := scan_hosts_E8 S hS
  have hcP : ∀ y ∈ S.preRoot, S.pkSrcChart y = S.ePre (S.chi y) := fun y hy => by
    simp only [ScanSetup.pkSrcChart, if_pos hy]
  have hcB : ∀ y ∈ Bk, S.pkSrcChart y = S.bankNm y := fun y hy => by
    have h2 : y ≠ S.R := fun h => hRB (h ▸ hy)
    simp only [ScanSetup.pkSrcChart, if_neg (hBP y hy), if_neg h2]
  have hPv : ∀ y ∈ S.preRoot, S.chi y ∈ S.PE := fun y hy =>
    (scan_pre_val_E8 S hS (fun _ => 0) (preRoot_sub_preStop_E8 hsd hrd hy)).1
  have hval : ∀ y ∈ S.preRoot, S.ePre (S.chi y) ≠ S.stopNm := fun y hy h => by
    have := hPE _ (hPv y hy); rw [h] at this; exact lt_irrefl _ this
  -- `χ̂` is injective on `P_R`
  obtain ⟨T', -, horig, hpre'⟩ := Closure.anchorOrigin_prefix hInL hsd
  have hchi : ∀ y ∈ S.preRoot, Closure.anchorOrigin S.E S.cap y = some (S.chi y) := by
    intro y hy
    obtain ⟨y', hy', -, -⟩ := hpre' y (preRoot_sub_preStop_E8 hsd hrd hy)
    simp [ScanSetup.chi, anchorD, hy']
  intro x hx y hy hxy
  change S.pkSrcChart x = S.pkSrcChart y at hxy
  have hx' : x ∈ S.preRoot ++ S.R :: Bk := by rw [← hroles]; exact hx
  have hy' : y ∈ S.preRoot ++ S.R :: Bk := by rw [← hroles]; exact hy
  simp only [List.mem_append, List.mem_cons] at hx' hy'
  rcases hx' with hx' | rfl | hx' <;> rcases hy' with hy' | rfl | hy'
  · rw [hcP x hx', hcP y hy'] at hxy
    have h1 := hinj (hPv x hx') (hPv y hy') hxy
    exact horig x y _ (hchi x hx') (h1 ▸ hchi y hy')
  · rw [hcP x hx', hRc] at hxy; exact absurd hxy (hval x hx')
  · rw [hcP x hx', hcB y hy'] at hxy
    exact absurd (hxy ▸ List.mem_map_of_mem (hPv x hx')) (hbfresh y (hBk y hy')).1
  · rw [hcP y hy', hRc] at hxy; exact absurd hxy.symm (hval y hy')
  · rfl
  · rw [hRc, hcB y hy'] at hxy; exact absurd hxy.symm (hbfresh y (hBk y hy')).2.1
  · rw [hcP y hy', hcB x hx'] at hxy
    exact absurd (hxy.symm ▸ List.mem_map_of_mem (hPv y hy')) (hbfresh x (hBk x hx')).1
  · rw [hRc, hcB x hx'] at hxy; exact absurd hxy (hbfresh x (hBk x hx')).2.1
  · rw [hcB x hx', hcB y hy'] at hxy; exact hbinj (hBk x hx') (hBk y hy') hxy

/-- L7.6a step 8(a) helper: the owner of an atom is one of its variables. -/
theorem atomOwner_mem_vars_G8 {V : Type} {a : BaseAtom V} {z : V} (h : atomOwner a = some z) :
    z ∈ a.vars := by
  cases a <;> simp_all [atomOwner, BaseAtom.vars]

/-- L7.6a step 8(a) helper: `χ̂` sends a slot to a slot. -/
theorem chi_slot_G8 (S : ScanSetup.{u}) (e : EntryAddr) : ∃ e', S.chi (.slot e) = .slot e' := by
  unfold ScanSetup.chi anchorD
  cases hc : S.cap with
  | none => exact ⟨e, by simp [Closure.anchorOrigin]⟩
  | some w =>
    rcases origin_slot w e with h | ⟨e', h⟩
    · exact ⟨e, by simp [Closure.anchorOrigin, h]⟩
    · exact ⟨e', by simp [Closure.anchorOrigin, h]⟩

/-- L7.6a step 8(a) helper: an atom of `Γ(H)` inside `P⁻ ∪ {T} ∪ fitted_j` that reads `T` or a
query role is fitted. -/
theorem scan_fit_atom_G8 {P : Prims.{u}} (S : ScanSetup.{u}) {j : Nat} {β : Role → Ordinal.{u}}
    (hfit : S.Fitted P j β) {a : BaseAtom Role} (ha : a ∈ graph S.H)
    (hv : ∀ v ∈ a.vars, v ∈ S.preStop ++ [Role.ord S.sd.col] ++ S.fittedRoles j)
    (hq : ∃ v ∈ a.vars, v ∈ Role.ord S.sd.col :: S.queryRoles) : a.Holds P (S.fitVal β) := by
  apply hfit
  unfold restrictTo ScanSetup.queryGraph restrictTo
  refine List.mem_filter.2 ⟨List.mem_filter.2 ⟨List.mem_filter.2 ⟨ha, ?_⟩, ?_⟩, ?_⟩
  · refine List.all_eq_true.2 fun v hv' => ?_
    have := hv v hv'
    simp only [List.mem_append, List.mem_singleton, decide_eq_true_eq] at this ⊢
    rcases this with (h | h) | h
    · exact Or.inl (Or.inl h)
    · exact Or.inl (Or.inr h)
    · exact Or.inr (List.mem_filter.1 h).1
  · obtain ⟨v, hv', hvq⟩ := hq
    exact List.any_eq_true.2 ⟨v, hv', by simpa using hvq⟩
  · exact List.all_eq_true.2 fun v hv' => by simpa using hv v hv'

/-- L7.6a step 8(a): the target prefix graph through the target chart. -/
theorem scan_joint_tgt_E8 {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) {i j : Nat}
    (hij : Scan.ReachesGT (Scan.rootKeys S.H S.rd) (Scan.queryKeys S.sd) i j)
    {β : Role → Ordinal.{u}} (hfit : S.Fitted P j β) :
    BaseHolds P ((prefixGraph S.E (S.scanRecord i j).b).map (BaseAtom.map S.pkTgtChart))
      (S.pkAsg β) := by
  have hS' := hS
  obtain ⟨⟨-, hInL, -, hsd, -, -, -⟩, ⟨-, h2, hPE⟩, -, -, -, -⟩ := hS'
  obtain ⟨-, hj⟩ := reach_idx_E8 hij
  obtain ⟨hb, hTE, hnum, -, hrep⟩ := scan_target_E8 S hS (i := i) hj
  obtain ⟨colE, hcolE, hagree⟩ := scan_col_E8 S hS
  have hcolH := (Scan.stopData_spec hsd).1
  have hjE : j < colE.length := (List.getElem?_eq_some_iff.1
    ((hagree j hj).trans (List.getElem?_eq_getElem hj))).1
  have htake : colE.take j = S.sd.Q.take j := by
    apply List.ext_getElem?
    intro k
    simp only [List.getElem?_take]
    split_ifs with hk
    · exact hagree k (by omega)
    · rfl
  set fE := Tree.rolesCol S.cE.path S.cE.col 0 (S.sd.Q.take j) with hfEdef
  set fH := Tree.rolesCol S.sd.col.path S.sd.col.col 0 (S.sd.Q.take j) with hfHdef
  have hPEd : rolesBefore S.E (.ord S.cE) = S.PE := by simp only [ScanSetup.PE, hTE]
  have hpre : prefixRoles S.E (S.scanRecord i j).b = S.PE ++ S.TE :: fE := by
    rw [hb, col_prefix_E8 hcolE hjE, hPEd, hTE, htake]
  have hfE : fE.map S.toH = fH := rolesCol_transColumn_E8 S.cE S.sd.col _ 0
  obtain ⟨hfnd, hfsub⟩ := fitted_rolesCol_E8 hsd j
  have hPb : S.PE ++ S.TE :: fE <+: S.E.roles := by rw [← hpre]; exact List.takeWhile_prefix _
  have hPEpre : S.PE <+: S.E.roles := (List.prefix_append _ _).trans hPb
  have hPnd : (S.PE ++ S.TE :: fE).Nodup := (Tree.roles_nodup S.E).sublist hPb.sublist
  have hPnd' := List.nodup_append.1 hPnd
  have hTf : S.TE ∉ fE := (List.nodup_cons.1 hPnd'.2.1).1
  have hTP : S.TE ∉ S.PE := fun h => hPnd'.2.2 _ h _ List.mem_cons_self rfl
  have hfP : ∀ v ∈ fE, v ∉ S.PE := fun v hv h => hPnd'.2.2 _ h _ (List.mem_cons_of_mem _ hv) rfl
  have hTEH : S.toH S.TE = .ord S.sd.col := by
    rw [hTE]; simp [ScanSetup.toH, transColumn, relocCol]
  obtain ⟨post, hroles, hQ⟩ := stop_roles_E8 hsd
  have hndH := Tree.roles_nodup S.H
  rw [hroles, List.nodup_append, List.nodup_cons] at hndH
  have hTq : Role.ord S.sd.col ∉ S.queryRoles := fun h => hndH.2.1.1 (List.mem_append_left _ h)
  have hTH : Role.ord S.sd.col ∈ S.H.roles := by rw [hroles]; simp
  have hpreH : ∀ y ∈ S.preStop, y ∈ S.H.roles := fun y hy => by rw [hroles]; simp [hy]
  -- values of the target chart
  have hstopv : S.pkAsg β S.stopNm = S.asg S.stopNm :=
    pkAsg_used_E8 S β (by simp [ScanSetup.usedNames])
  have hfitT : S.fitVal β (.ord S.sd.col) = S.asg S.stopNm := by
    simp [ScanSetup.fitVal, hTq, ScanSetup.baseVal]
  intro x hx
  obtain ⟨a, ha, rfl⟩ := List.mem_map.1 hx
  rw [BaseAtom.holds_map]
  set α : Role → Ordinal.{u} := S.pkAsg β ∘ S.pkTgtChart with hα
  have hαP : ∀ v ∈ S.PE, α v = S.asg (S.ePre v) := by
    intro v hv
    simp only [hα, Function.comp_apply, ScanSetup.pkTgtChart, if_pos hv]
    exact pkAsg_used_E8 S β (by
      simp only [ScanSetup.usedNames, List.mem_append]
      exact Or.inl (Or.inl (Or.inl (List.mem_map_of_mem hv))))
  have hαT : α S.TE = S.asg S.stopNm := by
    simp only [hα, Function.comp_apply, (scan_hosts_E8 S hS).1, hstopv]
  have hαf : ∀ v ∈ fE, α v = S.fitVal β (S.toH v) ∧ S.toH v ∈ S.fittedRoles j ∧
      S.toH v ∈ S.queryRoles := by
    intro v hv
    have hvH : S.toH v ∈ S.fittedRoles j := hfsub _ (by
      have := List.mem_map_of_mem (f := S.toH) hv; rwa [hfE] at this)
    have hvq : S.toH v ∈ S.queryRoles := (List.mem_filter.1 hvH).1
    have hvT : v ≠ S.TE := fun h => hTf (h ▸ hv)
    refine ⟨?_, hvH, hvq⟩
    simp only [hα, Function.comp_apply, ScanSetup.pkTgtChart, if_neg (hfP v hv), if_neg hvT,
      ScanSetup.pkAsg, if_true, ScanSetup.fitVal, if_pos hvq]
  have hαL : ∀ v ∈ S.TE :: fE, α v = S.fitVal β (S.toH v) ∧
      S.toH v ∈ S.preStop ++ [Role.ord S.sd.col] ++ S.fittedRoles j := by
    intro v hv
    rcases List.mem_cons.1 hv with rfl | hv
    · rw [hαT, hTEH, hfitT]; exact ⟨rfl, by simp⟩
    · obtain ⟨h1, h2, -⟩ := hαf v hv
      exact ⟨h1, List.mem_append_right _ h2⟩
  have hαpre : ∀ y ∈ S.preStop, α (S.chi y) = S.fitVal β y := by
    intro y hy
    obtain ⟨-, h1, h2, h3⟩ := scan_pre_val_E8 S hS β hy
    simp only [hα, Function.comp_apply, h1, h2, h3]
  unfold prefixGraph restrictTo at ha
  obtain ⟨haE, hall⟩ := List.mem_filter.1 ha
  have hvars : ∀ v ∈ a.vars, v ∈ S.PE ++ S.TE :: fE := by
    intro v hv; rw [← hpre]; simpa using List.all_eq_true.1 hall v hv
  by_cases hA : ∀ v ∈ a.vars, v ∈ S.PE
  · -- an atom inside `P_E` (S2)
    have hin : a ∈ restrictTo (graph S.E) S.PE :=
      List.mem_filter.2 ⟨haE, List.all_eq_true.2 fun v hv => by simpa using hA v hv⟩
    have := h2 _ (List.mem_map_of_mem hin)
    rw [BaseAtom.holds_map] at this
    exact (amalg_baseAtom_congr P a (fun v hv => hαP v (hA v hv))).2 this
  rcases graph_atom_cases S.E a haE with ⟨k, x, y, rfl, hx, hy⟩ | ⟨z, -, hown⟩
  · -- an order atom
    have hyP := hvars y (by simp [BaseAtom.vars])
    obtain ⟨m, hm⟩ := List.mem_iff_getElem?.1 hyP
    have hmlt : m < (S.PE ++ S.TE :: fE).length := (List.getElem?_eq_some_iff.1 hm).1
    have hmE : S.E.roles[m]? = some y := by rw [getElem?_of_prefix hPb hmlt]; exact hm
    have hmk : m = k + 1 :=
      (List.getElem?_inj (List.getElem?_eq_some_iff.1 hmE).1 (Tree.roles_nodup S.E)).1
        (hmE.trans hy.symm)
    subst hmk
    have hxP : (S.PE ++ S.TE :: fE)[k]? = some x := by
      rw [← getElem?_of_prefix hPb (by omega)]; exact hx
    show α x < α y
    rcases lt_trichotomy (k + 1) S.PE.length with hlt | heq | hgt
    · exfalso; apply hA; intro v hv
      simp only [BaseAtom.vars, List.mem_cons, List.not_mem_nil, or_false] at hv
      rcases hv with rfl | rfl
      · rw [List.getElem?_append_left (by omega)] at hxP; exact List.mem_of_getElem? hxP
      · rw [List.getElem?_append_left hlt] at hm; exact List.mem_of_getElem? hm
    · rw [List.getElem?_append_left (by omega)] at hxP
      rw [List.getElem?_append_right (by omega), heq, Nat.sub_self] at hm
      simp only [List.getElem?_cons_zero, Option.some.injEq] at hm
      subst hm
      rw [hαP x (List.mem_of_getElem? hxP), hαT]
      exact hPE x (List.mem_of_getElem? hxP)
    · rw [List.getElem?_append_right (by omega)] at hxP hm
      have hk1 : k + 1 - S.PE.length = (k - S.PE.length) + 1 := by omega
      rw [hk1] at hm
      have hyf : y ∈ fE := by
        simp only [List.getElem?_cons_succ] at hm; exact List.mem_of_getElem? hm
      have hL : (S.TE :: fE).map S.toH = Role.ord S.sd.col :: fH := by
        rw [List.map_cons, hTEH, hfE]
      have hsplit : S.queryRoles = fH ++ Tree.rolesCol S.sd.col.path S.sd.col.col
          (0 + (S.sd.Q.take j).length) (S.sd.Q.drop j) := by
        rw [hQ, hfHdef, ← Tree.rolesCol_append, List.take_append_drop]
      have hH : S.H.roles = S.preStop ++ ((S.TE :: fE).map S.toH ++
          (Tree.rolesCol S.sd.col.path S.sd.col.col (0 + (S.sd.Q.take j).length) (S.sd.Q.drop j) ++
            Role.slot (Scan.closingSlot S.sd) :: post)) := by
        rw [hroles, hL, hsplit]; simp
      have hget : ∀ t, t < (S.TE :: fE).length → ∀ v, (S.TE :: fE)[t]? = some v →
          S.H.roles[S.preStop.length + t]? = some (S.toH v) := by
        intro t ht v hv
        rw [hH, List.getElem?_append_right (by omega), Nat.add_sub_cancel_left,
          List.getElem?_append_left (by simpa using ht), List.getElem?_map, hv]
        rfl
      have hx' := hget _ (List.getElem?_eq_some_iff.1 hxP).1 _ hxP
      have hy' := hget _ (List.getElem?_eq_some_iff.1 hm).1 _ hm
      have hlt' := (graph_lt_iff S.H _ _).2 ⟨_, hx', by rw [← Nat.add_assoc] at hy'; exact hy'⟩
      obtain ⟨hvx, hix⟩ := hαL x (List.mem_of_getElem? hxP)
      obtain ⟨hvy, hiy⟩ := hαL y (List.mem_of_getElem? hm)
      have := scan_fit_atom_G8 S hfit hlt' (fun v hv => by
          simp only [BaseAtom.vars, List.mem_cons, List.not_mem_nil, or_false] at hv
          rcases hv with rfl | rfl
          · exact hix
          · exact hiy)
        ⟨S.toH y, by simp [BaseAtom.vars], List.mem_cons_of_mem _ (hαf y hyf).2.2⟩
      rw [hvx, hvy]; exact this
  · -- an owned atom
    have hzv : z ∈ a.vars := atomOwner_mem_vars_G8 hown
    have hzP := hvars z hzv
    have hownE : a ∈ ownedBy (graph S.E) z := List.mem_filter.2 ⟨haE, by simp [hown]⟩
    rcases List.mem_append.1 hzP with hzPE | hzT
    · exfalso; apply hA; intro v hv
      rcases owned_before hownE hv with h | rfl
      · exact rolesBefore_sub_prefix hPEpre hzPE h
      · exact hzPE
    rcases List.mem_cons.1 hzT with rfl | hzf
    · -- owned by `T_E`
      rcases (mem_graph_iff S.E a).1 haE with ⟨x, -, rfl⟩ | ⟨_, x, y, -, -, rfl⟩ |
        ⟨c, -, -, rfl⟩ | ⟨e, p, o, v, -, -, ha'⟩
      · simp only [atomOwner, Option.some.injEq] at hown
        subst hown
        have hl : BaseAtom.lim (Role.ord S.sd.col) ∈ graph S.H :=
          (mem_graph_iff _ _).2 (Or.inl ⟨_, hTH, rfl⟩)
        have := scan_fit_atom_G8 S hfit hl (by simp [BaseAtom.vars])
          ⟨_, by simp [BaseAtom.vars], List.mem_cons_self⟩
        show IsLim (α S.TE)
        rw [hαT, ← hfitT]; exact this
      · simp [atomOwner] at hown
      · simp only [atomOwner, Option.some.injEq] at hown
        rw [hTE, Role.ord.injEq] at hown
        have hq1 : c.num 0 + 1 = S.sd.col.num 0 := by
          rw [← hnum, ← hown]; simp [ColAddr.num]; omega
        have hrn := rep_next c
        rw [hown] at hrn
        have hr := hrep (c.num 0) (by omega)
        rw [hrn] at hr
        cases hsr : S.sd.col.rep 0 (c.num 0) with
        | none => rw [hsr] at hr; cases hr
        | some xv =>
          obtain ⟨x0, v0⟩ := xv
          rw [hsr] at hr
          simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq] at hr
          obtain ⟨hx0, hv0⟩ := hr
          have hsr' := hsr
          unfold ColAddr.rep at hsr'
          obtain ⟨o, hres, hov⟩ := Option.map_eq_some_iff.1 hsr'
          simp only [Prod.mk.injEq] at hov
          obtain ⟨rfl, rfl⟩ := hov
          have hso : S.sd.col.rep 0 (c.num 0) = some (.ord o, .ord o) := by
            cases hco : o.container S.sd.col with
            | some e' =>
              simp only [hco] at hv0
              obtain ⟨e'', he''⟩ := chi_slot_G8 S e'
              rw [he''] at hv0; cases hv0
            | none =>
              unfold ColAddr.rep; rw [hres]; simp [hco]
          obtain ⟨hoe, hcol1⟩ := prev_of_rep hso hq1
          have hoP : Role.ord o ∈ S.preStop := (stop_reps_E8 hsd hso).1
          have hsdc : (⟨o.path, o.col + 1⟩ : ColAddr) = S.sd.col := by
            rw [hoe]; exact colAddr_eq rfl (by simp; omega)
          have hel : BaseAtom.elem (.ord o) (.ord S.sd.col) ∈ graph S.H := by
            rw [mem_graph_iff]
            refine Or.inr (Or.inr (Or.inl ⟨o, hpreH _ hoP, by rw [hsdc]; exact hTH, by rw [hsdc]⟩))
          have := scan_fit_atom_G8 S hfit hel (fun v hv => by
              simp only [BaseAtom.vars, List.mem_cons, List.not_mem_nil, or_false] at hv
              rcases hv with rfl | rfl
              · exact List.mem_append_left _ (List.mem_append_left _ hoP)
              · simp)
            ⟨_, by simp [BaseAtom.vars], List.mem_cons_self⟩
          show P.Elem (α (.ord c)) (α (.ord ⟨c.path, c.col + 1⟩))
          rw [hown, ← hTE, hαT, ← hfitT]
          have hx0' : S.chi (Role.ord o) = Role.ord c := hx0
          rw [← hx0', hαpre _ hoP]
          exact this
      · exfalso
        rcases ha' with rfl | rfl <;> simp [atomOwner, hTE] at hown
    · -- owned by a role of an earlier query entry: block transport
      obtain ⟨m, p, h, hm, hzm⟩ := Tree.mem_rolesCol_iff.1 hzf
      rw [Nat.zero_add] at hzm
      have hm' := hm
      rw [List.getElem?_take] at hm'
      split_ifs at hm' with hmj
      have hmQ : m < S.sd.Q.length := by omega
      have hentE : S.E.entryAt ⟨S.cE, m⟩ = some (p, h) := by
        simp [Tree.entryAt, hcolE, hagree m hmQ, hm']
      have hentH : S.H.entryAt ⟨S.sd.col, m⟩ = some (p, h) := by
        simp [Tree.entryAt, hcolH, List.getElem?_append_left hmQ, hm']
      have heE : (⟨S.cE, m⟩ : EntryAddr) ∈ S.E.entryAddrs :=
        (Tree.mem_entryAddrs_iff _ _).2 (by rw [hentE]; rfl)
      have heH : (⟨S.sd.col, m⟩ : EntryAddr) ∈ S.H.entryAddrs :=
        (Tree.mem_entryAddrs_iff _ _).2 (by rw [hentH]; rfl)
      have hz' : z = .slot ⟨S.cE, m⟩ ∨ (⟨S.cE, m⟩ : EntryAddr).heightPath <+: z.path := by
        rcases hzm with h1 | h1
        · exact Or.inl h1
        · right
          rw [Tree.rolesF_eq_map_under] at h1
          obtain ⟨r, -, rfl⟩ := List.mem_map.1 h1
          rw [Role.path_under]; exact List.prefix_append _ _
      obtain ⟨a₀, ha₀, rfl⟩ := graph_owned_block_core heE z hz' a hownE
      have hblkH := posBlock_heads_graph heH hInL.1 a₀ (by
        simpa [Tree.heightAt, hentE, hentH, hnum] using ha₀)
      -- the block variables
      have hmemf : ∀ r ∈ h.roles, Role.under (⟨S.cE, m⟩ : EntryAddr).heightPath r ∈ fE := by
        intro r hr
        refine Tree.mem_rolesCol_iff.2 ⟨m, p, h, hm, Or.inr ?_⟩
        rw [Tree.rolesF_eq_map_under, Nat.zero_add]; exact List.mem_map_of_mem hr
      have hslf : Role.slot (⟨S.cE, m⟩ : EntryAddr) ∈ fE :=
        Tree.mem_rolesCol_iff.2 ⟨m, p, h, hm, Or.inl (by rw [Nat.zero_add])⟩
      have hhost : α (.ord S.cE) = S.fitVal β (.ord S.sd.col) ∧
          Role.ord S.sd.col ∈ S.preStop ++ [Role.ord S.sd.col] ++ S.fittedRoles j := by
        rw [← hTE, hαT, hfitT]; exact ⟨rfl, by simp⟩
      have hvar : ∀ w ∈ a₀.vars, α (blockMap ⟨S.cE, m⟩ w) = S.fitVal β (blockMap ⟨S.sd.col, m⟩ w) ∧
          blockMap ⟨S.sd.col, m⟩ w ∈ S.preStop ++ [Role.ord S.sd.col] ++ S.fittedRoles j ∧
          ((w = .owner ∨ ∃ r, w = .inner r) → blockMap ⟨S.sd.col, m⟩ w ∈ S.queryRoles) := by
        intro w hw
        have hwP : blockMap ⟨S.cE, m⟩ w ∈ S.PE ++ S.TE :: fE :=
          hvars _ (by rw [baseAtom_vars_map]; exact List.mem_map_of_mem hw)
        cases w with
        | host => exact ⟨hhost.1, hhost.2, fun h => by rcases h with h | ⟨r, h⟩ <;> cases h⟩
        | ord q =>
          suffices hh : α (blockMap ⟨S.cE, m⟩ (.ord q)) = S.fitVal β (blockMap ⟨S.sd.col, m⟩ (.ord q)) ∧
              blockMap ⟨S.sd.col, m⟩ (.ord q) ∈ S.preStop ++ [Role.ord S.sd.col] ++ S.fittedRoles j from
            ⟨hh.1, hh.2, fun h => by rcases h with h | ⟨r, h⟩ <;> cases h⟩
          by_cases hq : q < S.sd.col.num 0
          · obtain ⟨⟨x0, v0⟩, hxv⟩ := Option.isSome_iff_exists.1 ((rep_isSome_iff _ _).2 hq)
            have hc : S.cE.rep 0 q = some (S.chi x0, S.chi v0) := by rw [← hrep q hq, hxv]; rfl
            have hx0 := (stop_reps_E8 hsd hxv).1
            simp only [blockMap, hxv, hc, Option.map_some, Option.getD_some]
            exact ⟨hαpre _ hx0, List.mem_append_left _ (List.mem_append_left _ hx0)⟩
          · have hn : S.sd.col.rep 0 q = none := by
              cases h' : S.sd.col.rep 0 q with
              | none => rfl
              | some _ => exact absurd ((rep_isSome_iff _ _).1 (by rw [h']; rfl)) hq
            have hn' : S.cE.rep 0 q = none := by
              cases h' : S.cE.rep 0 q with
              | none => rfl
              | some _ => exact absurd (hnum ▸ (rep_isSome_iff _ _).1 (by rw [h']; rfl)) hq
            simp only [blockMap, hn, hn', Option.map_none, Option.getD_none]
            exact hhost
        | cur q =>
          suffices hh : α (blockMap ⟨S.cE, m⟩ (.cur q)) = S.fitVal β (blockMap ⟨S.sd.col, m⟩ (.cur q)) ∧
              blockMap ⟨S.sd.col, m⟩ (.cur q) ∈ S.preStop ++ [Role.ord S.sd.col] ++ S.fittedRoles j from
            ⟨hh.1, hh.2, fun h => by rcases h with h | ⟨r, h⟩ <;> cases h⟩
          by_cases hq : q < S.sd.col.num 0
          · obtain ⟨⟨x0, v0⟩, hxv⟩ := Option.isSome_iff_exists.1 ((rep_isSome_iff _ _).2 hq)
            have hc : S.cE.rep 0 q = some (S.chi x0, S.chi v0) := by rw [← hrep q hq, hxv]; rfl
            have hv0 := (stop_reps_E8 hsd hxv).2
            simp only [blockMap, hxv, hc, Option.map_some, Option.getD_some]
            exact ⟨hαpre _ hv0, List.mem_append_left _ (List.mem_append_left _ hv0)⟩
          · have hn : S.sd.col.rep 0 q = none := by
              cases h' : S.sd.col.rep 0 q with
              | none => rfl
              | some _ => exact absurd ((rep_isSome_iff _ _).1 (by rw [h']; rfl)) hq
            have hn' : S.cE.rep 0 q = none := by
              cases h' : S.cE.rep 0 q with
              | none => rfl
              | some _ => exact absurd (hnum ▸ (rep_isSome_iff _ _).1 (by rw [h']; rfl)) hq
            simp only [blockMap, hn, hn', Option.map_none, Option.getD_none]
            exact hhost
        | owner =>
          have hto : S.toH (.slot ⟨S.cE, m⟩) = .slot ⟨S.sd.col, m⟩ := by
            simp [ScanSetup.toH, transColumn]
          obtain ⟨h1, h2, h3⟩ := hαf _ hslf
          rw [hto] at h1 h2 h3
          exact ⟨h1, List.mem_append_right _ h2, fun _ => h3⟩
        | inner r =>
          have hvE : Role.under (⟨S.cE, m⟩ : EntryAddr).heightPath r ∈ S.E.roles := hPb.subset hwP
          have hmem := mem_under_of_inEntry_E8 heE hvE
            (by rw [Role.path_under]; exact List.prefix_append _ _)
          rw [show S.E.heightAt ⟨S.cE, m⟩ = some h by simp [Tree.heightAt, hentE],
            Option.getD_some] at hmem
          obtain ⟨r', hr', hrr⟩ := List.mem_map.1 hmem
          have hr'r := Role.under_injective _ hrr
          subst hr'r
          have hto : S.toH (Role.under (⟨S.cE, m⟩ : EntryAddr).heightPath r') =
              Role.under (⟨S.sd.col, m⟩ : EntryAddr).heightPath r' :=
            transColumn_under_E8 S.cE S.sd.col m r'
          obtain ⟨h1, h2, h3⟩ := hαf _ (hmemf r' hr')
          rw [hto] at h1 h2 h3
          exact ⟨h1, List.mem_append_right _ h2, fun _ => h3⟩
      -- the owner variable of the block atom
      rw [atomOwner_map] at hown
      obtain ⟨w0, hw0, -⟩ := Option.map_eq_some_iff.1 hown
      have hw0v := atomOwner_mem_vars_G8 hw0
      have hw0k := posBlock_owner ha₀ hw0
      have hH' := scan_fit_atom_G8 S hfit hblkH (fun v hv => by
          rw [baseAtom_vars_map] at hv
          obtain ⟨w, hw, rfl⟩ := List.mem_map.1 hv
          exact (hvar w hw).2.1)
        ⟨_, by rw [baseAtom_vars_map]; exact List.mem_map_of_mem hw0v,
          List.mem_cons_of_mem _ ((hvar w0 hw0v).2.2 hw0k)⟩
      rw [BaseAtom.holds_map] at hH' ⊢
      exact (amalg_baseAtom_congr P a₀ (fun w hw => (hvar w hw).1)).2 hH'

/-- L7.6a step 8(b) helper: roles inside a root entry are not pre-root roles. -/
theorem preRoot_not_bank_E8 {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) {v : Role}
    (hv : v ∈ S.preRoot) : v ∉ S.bankRoles := by
  obtain ⟨⟨-, -, -, hsd, hrd, -, -⟩, -⟩ := hS
  obtain ⟨-, -, -, -, -, hmem, -, -⟩ := Scan.rootData_spec hsd hrd
  obtain ⟨colR, hcolR⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff _ _).1 hmem)
  obtain ⟨A, B, hr⟩ := roles_col_decomp hcolR
  have hpre : S.preRoot = A := rolesBefore_of_decomp_E8 hr
  intro hb
  obtain ⟨hvH, hany⟩ := List.mem_filter.1 hb
  obtain ⟨k, -, hin⟩ := List.any_eq_true.1 hany
  -- `v` is a role of root entry `k`
  have hk : (⟨S.rd.col, k⟩ : EntryAddr) ∈ S.H.entryAddrs ∧ v ∈ Tree.rolesCol S.rd.col.path
      S.rd.col.col 0 colR := by
    rcases (inEntry_iff _ _).1 hin with rfl | hp
    · have hk : (S.H.entryAt ⟨S.rd.col, k⟩).isSome := by
        have := (Tree.mem_roles_iff _ _).1 hvH; exact this
      obtain ⟨⟨p0, h0⟩, hx⟩ := Option.isSome_iff_exists.1 hk
      obtain ⟨col', hc', hk'⟩ := Tree.colAt_of_entryAt hx
      rw [hcolR] at hc'; cases hc'
      exact ⟨(Tree.mem_entryAddrs_iff _ _).2 hk, Tree.mem_rolesCol_iff.2 ⟨k, p0, h0, hk',
        Or.inl (by simp)⟩⟩
    · have he : (⟨S.rd.col, k⟩ : EntryAddr) ∈ S.H.entryAddrs := by
        obtain ⟨tl, htl⟩ := hp
        have hfa : (S.H.forestAt (⟨S.rd.col, k⟩ : EntryAddr).heightPath).isSome := by
          have hv' := (Tree.mem_roles_iff _ _).1 hvH
          cases v with
          | ord d =>
            simp only [Role.path] at htl
            simp only [Tree.colAt, ← htl, Tree.forestAt_append] at hv'
            cases h : S.H.forestAt (⟨S.rd.col, k⟩ : EntryAddr).heightPath with
            | none => rw [h] at hv'; simp at hv'
            | some _ => rfl
          | slot d =>
            simp only [Role.path] at htl
            simp only [Tree.entryAt, Tree.colAt, ← htl, Tree.forestAt_append] at hv'
            cases h : S.H.forestAt (⟨S.rd.col, k⟩ : EntryAddr).heightPath with
            | none => rw [h] at hv'; simp at hv'
            | some _ => rfl
        rw [Tree.forestAt_heightPath] at hfa
        rw [Tree.mem_entryAddrs_iff]
        unfold Tree.heightAt at hfa
        cases h : S.H.entryAt ⟨S.rd.col, k⟩ with
        | none => rw [h] at hfa; simp at hfa
        | some _ => rfl
      refine ⟨he, ?_⟩
      obtain ⟨⟨p0, h0⟩, hx⟩ := Option.isSome_iff_exists.1 ((Tree.mem_entryAddrs_iff _ _).1 he)
      obtain ⟨col', hc', hk'⟩ := Tree.colAt_of_entryAt hx
      rw [hcolR] at hc'; cases hc'
      refine Tree.mem_rolesCol_iff.2 ⟨k, p0, h0, hk', Or.inr ?_⟩
      have := mem_under_of_inEntry_E8 he hvH hp
      have hB : S.H.heightAt ⟨S.rd.col, k⟩ = some h0 := by simp [Tree.heightAt, hx]
      rw [hB, Option.getD_some] at this
      rw [Tree.rolesF_eq_map_under]
      simpa [EntryAddr.heightPath] using this
  have hnd := Tree.roles_nodup S.H
  rw [hr, List.nodup_append] at hnd
  rw [hpre] at hv
  exact hnd.2.2 _ hv _ (List.mem_cons_of_mem _ (List.mem_append_left _ hk.2)) rfl

/-- L7.6a step 8(b): `Γ(F)` through the source chart: bank atoms by S5, `P_R` atoms by D6.1b
(transported by `χ̂` into `P_E`) and S2. -/
theorem scan_joint_src_E8 {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) {i j : Nat}
    (hij : Scan.ReachesGT (Scan.rootKeys S.H S.rd) (Scan.queryKeys S.sd) i j)
    (β : Role → Ordinal.{u}) :
    BaseHolds P ((graph (S.scanRecord i j).F).map (BaseAtom.map S.pkSrcChart)) (S.pkAsg β) := by
  have hS' := hS
  obtain ⟨⟨hstd, hInL, -, hsd, hrd, -, -⟩, ⟨-, h2, hPE⟩, -, -, h5, -⟩ := hS'
  have hE := Closure.std_inL hstd
  obtain ⟨hi, -⟩ := reach_idx_E8 hij
  obtain ⟨Bk, hroles, hBk⟩ := scan_src_roles_E8 S hS hij
  have hndF := Tree.roles_nodup (S.scanRecord i j).F
  rw [hroles] at hndF
  have hndF' := List.nodup_append.1 hndF
  have hRB : S.R ∉ Bk := (List.nodup_cons.1 hndF'.2.1).1
  have hBP : ∀ y ∈ Bk, y ∉ S.preRoot := fun y hy h =>
    hndF'.2.2 _ h _ (List.mem_cons_of_mem _ hy) rfl
  have hRP : S.R ∉ S.preRoot := fun h => hndF'.2.2 _ h _ List.mem_cons_self rfl
  obtain ⟨-, hRc⟩ := scan_hosts_E8 S hS
  have hstopv : S.pkAsg β S.stopNm = S.asg S.stopNm :=
    pkAsg_used_E8 S β (by simp [ScanSetup.usedNames])
  -- values on the source roles
  have hvP : ∀ v ∈ S.preRoot, S.pkAsg β (S.pkSrcChart v) = S.asg (S.ePre (S.chi v)) := by
    intro v hv
    obtain ⟨-, -, h3, -⟩ := scan_pre_val_E8 S hS β (preRoot_sub_preStop_E8 hsd hrd hv)
    simp only [ScanSetup.pkSrcChart, if_pos hv, h3]
  have hvR : S.pkAsg β (S.pkSrcChart S.R) = S.asg S.stopNm := by rw [hRc, hstopv]
  have hvB : ∀ v ∈ Bk, S.pkAsg β (S.pkSrcChart v) = S.asg (S.bankNm v) := by
    intro v hv
    have h2' : v ≠ S.R := fun h => hRB (h ▸ hv)
    simp only [ScanSetup.pkSrcChart, if_neg (hBP v hv), if_neg h2']
    exact pkAsg_used_E8 S β (by
      simp only [ScanSetup.usedNames, List.mem_append]
      exact Or.inl (Or.inr (List.mem_map_of_mem (hBk v hv))))
  -- `Γ(F)` is `Γ(H)` restricted to the roles of `F`
  have haH : (⟨S.rd.col, i⟩ : EntryAddr) ∈ S.H.entryAddrs := by
    obtain ⟨colR, hcolR, hcurR, -⟩ := bank_chain_E8 S hS
    have hiR : i < colR.length := by simpa [rootLenOf, hcolR] using hi
    rw [Tree.mem_entryAddrs_iff]; simp [Tree.entryAt, hcolR, List.getElem?_eq_getElem hiR]
  intro b hb
  obtain ⟨a, ha, rfl⟩ := List.mem_map.1 hb
  rw [BaseAtom.holds_map]
  have ha' := (graph_truncAfter S.H _ haH a).1 ha
  obtain ⟨haH', hall⟩ := List.mem_filter.1 ha'
  have hvars : ∀ v ∈ a.vars, v ∈ S.preRoot ++ S.R :: Bk := by
    intro v hv
    have := List.all_eq_true.1 hall v hv
    simp only [decide_eq_true_eq] at this
    rw [← hroles]; exact this
  by_cases hA : ∃ v ∈ a.vars, v ∈ S.R :: Bk
  · -- an atom of the bank graph (S5)
    have hbg : a ∈ S.bankGraph := by
      refine List.mem_filter.2 ⟨List.mem_filter.2 ⟨haH', List.all_eq_true.2 fun v hv => ?_⟩, ?_⟩
      · have := hvars v hv
        simp only [List.mem_append, List.mem_cons, decide_eq_true_eq] at this ⊢
        rcases this with h | h | h
        · exact Or.inl (Or.inl h)
        · exact Or.inl (Or.inr (Or.inl h))
        · exact Or.inr (hBk v h)
      · obtain ⟨v, hv, hvRB⟩ := hA
        refine List.any_eq_true.2 ⟨v, hv, ?_⟩
        simp only [decide_eq_true_eq, List.mem_cons] at hvRB ⊢
        rcases hvRB with h | h
        · exact Or.inl h
        · exact Or.inr (hBk v h)
    refine (amalg_baseAtom_congr P a (fun v hv => ?_)).1 (h5 a hbg)
    have := hvars v hv
    simp only [List.mem_append, List.mem_cons] at this
    rcases this with h | rfl | h
    · rw [Function.comp_apply, hvP v h]
      have hvR' : v ≠ S.R := fun he => hRP (he ▸ h)
      simp only [ScanSetup.bankVal, if_neg hvR', if_neg (preRoot_not_bank_E8 S hS h)]
    · rw [Function.comp_apply, hvR]
      simp [ScanSetup.bankVal]
    · rw [Function.comp_apply, hvB v h]
      have hvR' : v ≠ S.R := fun he => hRB (he ▸ h)
      simp only [ScanSetup.bankVal, if_neg hvR', if_pos (hBk v h)]
  · -- an atom inside `P_R`: transported to `P_E` by `χ̂` (D6.1b), then S2
    push Not at hA
    have hvP' : ∀ v ∈ a.vars, v ∈ S.preRoot := by
      intro v hv
      have := hvars v hv
      rcases List.mem_append.1 this with h | h
      · exact h
      · exact absurd h (hA v hv)
    obtain ⟨T', -, -, hpre'⟩ := Closure.anchorOrigin_prefix hInL hsd
    have horig : ∀ v ∈ S.preRoot, Closure.anchorOrigin S.E S.cap v = some (S.chi v) := by
      intro v hv
      obtain ⟨y', hy', -, -⟩ := hpre' v (preRoot_sub_preStop_E8 hsd hrd hv)
      simp [ScanSetup.chi, anchorD, hy']
    have hPEv : ∀ v ∈ S.preRoot, S.chi v ∈ S.PE := fun v hv =>
      (scan_pre_val_E8 S hS β (preRoot_sub_preStop_E8 hsd hrd hv)).1
    have hS2 : BaseHolds P (restrictTo (graph S.E) S.PE) (S.asg ∘ S.ePre) :=
      (baseHolds_map P S.ePre _ S.asg).1 h2
    have hcongr : ∀ v ∈ a.vars, (S.pkAsg β ∘ S.pkSrcChart) v = (S.asg ∘ S.ePre ∘ S.chi) v := by
      intro v hv
      simp only [Function.comp_apply]; exact hvP v (hvP' v hv)
    refine (amalg_baseAtom_congr P a hcongr).2 ?_
    rcases graph_atom_cases S.H a haH' with ⟨k, x, y, rfl, hx, hy⟩ | ⟨z, hz, hown⟩
    · -- an order atom: `χ̂` preserves the reading order, and `P_E` is increasing (S2)
      have hxP := hvP' x (by simp [BaseAtom.vars])
      have hyP := hvP' y (by simp [BaseAtom.vars])
      have hbef : Before S.H x y := ⟨k, k + 1, hx, hy, by omega⟩
      have hbefE := (graph_origin hE S.cap).2 x y hbef (by rw [horig x hxP]; rfl)
        (by rw [horig y hyP]; rfl)
      have hPEt : S.PE = S.E.roles.take S.PE.length :=
        List.prefix_iff_eq_take.1 (List.takeWhile_prefix _)
      have hS2' : BaseHolds P (restrictTo (graph S.E) (S.E.roles.take S.PE.length))
          (S.asg ∘ S.ePre) := by rw [← hPEt]; exact hS2
      show (S.asg ∘ S.ePre) (S.chi x) < (S.asg ∘ S.ePre) (S.chi y)
      refine before_of_restrict hS2' ?_ ?_ hbefE
      · rw [← hPEt]; exact hPEv x hxP
      · rw [← hPEt]; exact hPEv y hyP
    · -- an owned atom: its `χ̂`-image is an atom of `Γ(E)` inside `P_E`
      have hown' : atomOwner a ≠ none := by rw [hown]; simp
      have himg : a.map (anchorD S.E S.cap) ∈ graph S.E := by
        have h1 := ((graph_origin hE S.cap).1 (a.map (anchorD S.E S.cap))
          (by rw [atomOwner_map]; intro h; apply hown'; cases h' : atomOwner a <;> simp_all)).1
          ⟨a, haH', fun v hv => by rw [horig v (hvP' v hv)]; rfl, rfl⟩
        exact h1.1
      have hin : a.map S.chi ∈ restrictTo (graph S.E) S.PE := by
        refine List.mem_filter.2 ⟨himg, List.all_eq_true.2 fun v hv => ?_⟩
        rw [baseAtom_vars_map] at hv
        obtain ⟨w, hw, rfl⟩ := List.mem_map.1 hv
        simpa using hPEv w (hvP' w hw)
      have := hS2 _ hin
      rw [BaseAtom.holds_map] at this
      exact this

/-- L7.6a step 8 (Valid clause 4 of the paper, the joint diagram): `prefixGraph E b` through the
target chart, `Γ(F)` through the source chart, and the auxiliary diagram hold at `pkAsg β`. -/
theorem scan_valid5_E8 {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) {i j : Nat}
    (hij : Scan.ReachesGT (Scan.rootKeys S.H S.rd) (Scan.queryKeys S.sd) i j)
    {β : Role → Ordinal.{u}} (hfit : S.Fitted P j β) :
    (S.scanPacket i j β).joint.Holds P (S.scanPacket i j β).asg := by
  have hS' := hS
  obtain ⟨-, -, ⟨haux, -⟩, -⟩ := hS'
  have hbase : ∀ (D : List (BaseAtom Name)), BaseHolds P D (S.pkAsg β) →
      (Diagram.ofBase D).Holds P (S.pkAsg β) := by
    intro D hD x hx
    obtain ⟨b, hb, rfl⟩ := List.mem_map.1 hx
    exact hD b hb
  show (Diagram.ofBase ((prefixGraph S.E (S.scanRecord i j).b).map (BaseAtom.map S.pkTgtChart)) ++
    Diagram.ofBase ((graph (S.scanRecord i j).F).map (BaseAtom.map S.pkSrcChart)) ++ S.aux).Holds P
      (S.pkAsg β)
  rw [Diagram.holds_append, Diagram.holds_append]
  refine ⟨⟨hbase _ (scan_joint_tgt_E8 S hS hij hfit), hbase _ (scan_joint_src_E8 S hS hij β)⟩, ?_⟩
  intro x hx
  refine (amalg_atom_congr P x (fun v hv => ?_)).1 (haux x hx)
  exact (pkAsg_used_E8 S β (by
    simp only [ScanSetup.usedNames]
    exact List.mem_append_right _ (List.mem_flatMap.2 ⟨x, hx, hv⟩))).symm

/-- L7.6a step 10 (Valid clause 6): the low certificate lies below the owner `u_i`. -/
theorem scan_valid7_E8 {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) {i j : Nat}
    (hij : Scan.ReachesGT (Scan.rootKeys S.H S.rd) (Scan.queryKeys S.sd) i j)
    {β : Role → Ordinal.{u}} (h17a : S.Lmax j β < S.ownerVal i) :
    ∀ x ∈ (S.scanPacket i j β).lowNames,
      (S.scanPacket i j β).asg x < (S.scanPacket i j β).asg (S.scanPacket i j β).owner := by
  have hS' := hS
  obtain ⟨⟨-, -, -, hsd, hrd, -, -⟩, ⟨-, -, hPE⟩, ⟨-, hauxlt⟩, -⟩ := hS'
  obtain ⟨hi, hj⟩ := reach_idx_E8 hij
  rw [scan_owner_E8 S hS hij β]
  obtain ⟨hb, hTE, -, -, -⟩ := scan_target_E8 S hS (i := i) hj
  obtain ⟨colE, hcolE, hagree⟩ := scan_col_E8 S hS
  obtain ⟨colR, hcolR, hcurR, hchain⟩ := bank_chain_E8 S hS
  obtain ⟨-, -, -, -, -, -, hcur, -⟩ := Scan.rootData_spec hsd hrd
  have hic : i ≤ S.rd.cursor := by rw [hcur]; exact Scan.trace_fst_le_cursor _ _ hij.1
  have hiR : i < colR.length := by omega
  obtain ⟨hTc, hRc⟩ := scan_hosts_E8 S hS
  have hstopv : S.pkAsg β S.stopNm = S.asg S.stopNm :=
    pkAsg_used_E8 S β (by simp [ScanSetup.usedNames])
  -- the bank chain: `R` and the roles of root entries `< i` are below `u_i`
  set BKi := Tree.rolesCol S.rd.col.path S.rd.col.col 0 (colR.take i) with hBKi
  have hBK : Tree.rolesCol S.rd.col.path S.rd.col.col 0 (colR.take (S.rd.cursor + 1)) =
      BKi ++ Role.slot ⟨S.rd.col, i⟩ :: (Tree.rolesF (S.rd.col.path ++ [(S.rd.col.col, i)])
        colR[i].2 ++ Tree.rolesCol S.rd.col.path S.rd.col.col (i + 1)
          ((colR.take (S.rd.cursor + 1)).drop (i + 1))) := by
    have hl : i < (colR.take (S.rd.cursor + 1)).length := by simp; omega
    conv_lhs => rw [← List.take_append_drop i (colR.take (S.rd.cursor + 1)),
      List.drop_eq_getElem_cons hl]
    rw [Tree.rolesCol_append, List.take_take, Nat.min_eq_left (by omega : i ≤ S.rd.cursor + 1),
      List.length_take, Nat.min_eq_left (by omega : i ≤ colR.length), Nat.zero_add]
    simp only [List.getElem_take]
    rfl
  rw [hBK] at hchain
  have hslotH : Role.slot ⟨S.rd.col, i⟩ ∈ S.H.roles := by
    rw [Tree.mem_roles_iff]
    simp [Tree.entryAt, hcolR, List.getElem?_eq_getElem hiR]
  have hslotB : Role.slot ⟨S.rd.col, i⟩ ∈ S.bankRoles :=
    List.mem_filter.2 ⟨hslotH, List.any_eq_true.2 ⟨i, List.mem_range.2 (by omega),
      by simp [Role.inEntry]⟩⟩
  have hvalslot : S.bankVal (.slot ⟨S.rd.col, i⟩) = S.ownerVal i := by
    simp [ScanSetup.bankVal, ScanSetup.R, hslotB, ScanSetup.ownerVal]
  have hρu : S.asg S.stopNm < S.ownerVal i := by
    have := List.rel_of_pairwise_cons hchain (List.mem_append_right _ List.mem_cons_self)
    rw [hvalslot] at this
    simpa [ScanSetup.bankVal] using this
  have hBKlt : ∀ y ∈ BKi, S.bankVal y < S.ownerVal i := by
    intro y hy
    have h2 := (List.pairwise_append.1 (List.pairwise_cons.1 hchain).2).2.2 y hy _
      List.mem_cons_self
    rwa [hvalslot] at h2
  intro x hx
  simp only [SourcePacket.lowNames, List.mem_append, List.mem_map] at hx
  rcases hx with (⟨y, hy, rfl⟩ | ⟨y, hy, rfl⟩) | hx
  · -- the target prefix
    have hjE : j < colE.length := (List.getElem?_eq_some_iff.1
      ((hagree j hj).trans (List.getElem?_eq_getElem hj))).1
    have hpre := col_prefix_E8 hcolE hjE
    have hnd : (prefixRoles S.E ⟨S.cE, j⟩).Nodup :=
      (Tree.roles_nodup S.E).sublist (List.takeWhile_sublist _)
    have hPEd : rolesBefore S.E (.ord S.cE) = S.PE := by
      simp only [ScanSetup.PE, hTE]
    rw [hPEd] at hpre
    show S.pkAsg β (S.pkTgtChart y) < _
    have hy' : y ∈ prefixRoles S.E ⟨S.cE, j⟩ := by
      have : (S.scanPacket i j β).rk.b = ⟨S.cE, j⟩ := hb
      rw [← this]; exact hy
    rw [hpre] at hy' hnd
    rcases List.mem_append.1 hy' with hyP | hyT
    · simp only [ScanSetup.pkTgtChart, if_pos hyP]
      rw [pkAsg_used_E8 S β (by
        simp only [ScanSetup.usedNames, List.mem_append]
        exact Or.inl (Or.inl (Or.inl (List.mem_map_of_mem hyP))))]
      exact (hPE y hyP).trans hρu
    · rcases List.mem_cons.1 hyT with rfl | hyF
      · rw [← hTE, hTc, hstopv]; exact hρu
      · have hnd' := List.nodup_append.1 hnd
        have hyP : y ∉ S.PE := fun h => hnd'.2.2 _ h _ (List.mem_cons_of_mem _ hyF) rfl
        have hyT' : y ≠ S.TE := by
          rw [hTE]; intro h; subst h
          exact (List.nodup_cons.1 hnd'.2.1).1 hyF
        simp only [ScanSetup.pkTgtChart, if_neg hyP, if_neg hyT', ScanSetup.pkAsg, if_true]
        -- `toH y` is a fitted role
        have htake : colE.take j = S.sd.Q.take j := by
          apply List.ext_getElem?
          intro k
          simp only [List.getElem?_take]
          split_ifs with hk
          · exact hagree k (by omega)
          · rfl
        have hmap := rolesCol_transColumn_E8 S.cE S.sd.col (colE.take j) 0
        have hz : S.toH y ∈ Tree.rolesCol S.sd.col.path S.sd.col.col 0 (S.sd.Q.take j) := by
          rw [← htake, ← hmap]; exact List.mem_map_of_mem hyF
        have hzF : S.toH y ∈ S.fittedRoles j := by
          obtain ⟨post, -, hQ⟩ := stop_roles_E8 hsd
          obtain ⟨k, -, hk, hin⟩ := Scan.rolesCol_inEntry _ _ _ 0 _ hz
          simp only [List.length_take, Nat.zero_add] at hk
          refine List.mem_filter.2 ⟨?_, List.any_eq_true.2 ⟨k, List.mem_range.2 (by omega), hin⟩⟩
          have hsplit : Tree.rolesCol S.sd.col.path S.sd.col.col 0 S.sd.Q =
              Tree.rolesCol S.sd.col.path S.sd.col.col 0 (S.sd.Q.take j) ++
                Tree.rolesCol S.sd.col.path S.sd.col.col (0 + (S.sd.Q.take j).length)
                  (S.sd.Q.drop j) := by
            rw [← Tree.rolesCol_append, List.take_append_drop]
          rw [hQ, hsplit]
          exact List.mem_append_left _ hz
        obtain ⟨-, hL2⟩ := foldr_max_spec (L := S.asg S.stopNm) ((S.fittedRoles j).map β)
        exact lt_of_le_of_lt (hL2 _ (List.mem_map_of_mem hzF)) h17a
  · -- the source prefix
    have hpre := col_prefix_E8 hcolR hiR
    have hF : prefixRoles (S.scanPacket i j β).rk.F (S.scanPacket i j β).rk.a =
        prefixRoles S.H ⟨S.rd.col, i⟩ := by
      have haH : (⟨S.rd.col, i⟩ : EntryAddr) ∈ S.H.entryAddrs := by
        rw [Tree.mem_entryAddrs_iff]; simp [Tree.entryAt, hcolR, List.getElem?_eq_getElem hiR]
      exact (Tree.truncAfter_spec S.H _ haH).2.2.2.2.2
    rw [hF, hpre] at hy
    have hnd : (prefixRoles S.H ⟨S.rd.col, i⟩).Nodup :=
      (Tree.roles_nodup S.H).sublist (List.takeWhile_sublist _)
    rw [hpre] at hnd
    show S.pkAsg β (S.pkSrcChart y) < _
    rcases List.mem_append.1 hy with hyP | hyT
    · have hyP : y ∈ S.preRoot := hyP
      simp only [ScanSetup.pkSrcChart, if_pos hyP]
      obtain ⟨hchi, -, hv, -⟩ := scan_pre_val_E8 S hS β (preRoot_sub_preStop_E8 hsd hrd hyP)
      rw [hv]
      exact (hPE _ hchi).trans hρu
    · rcases List.mem_cons.1 hyT with rfl | hyB
      · have : S.pkSrcChart (Role.ord S.rd.col) = S.stopNm := hRc
        rw [this, hstopv]; exact hρu
      · have hnd' := List.nodup_append.1 hnd
        have hyP : y ∉ S.preRoot := fun h => hnd'.2.2 _ (show y ∈ rolesBefore S.H (.ord S.rd.col)
          from h) _ (List.mem_cons_of_mem _ hyB) rfl
        have hyR : y ≠ S.R := by
          simp only [ScanSetup.R]; intro h; subst h
          exact (List.nodup_cons.1 hnd'.2.1).1 hyB
        have hyBank : y ∈ S.bankRoles := by
          refine List.mem_filter.2 ⟨?_, List.any_eq_true.2 ?_⟩
          · obtain ⟨A, B, hr⟩ := roles_col_decomp hcolR
            rw [hr]
            refine List.mem_append_right _ (List.mem_cons_of_mem _ (List.mem_append_left _ ?_))
            have hsplit : Tree.rolesCol S.rd.col.path S.rd.col.col 0 colR =
                Tree.rolesCol S.rd.col.path S.rd.col.col 0 (colR.take i) ++
                  Tree.rolesCol S.rd.col.path S.rd.col.col (0 + (colR.take i).length)
                    (colR.drop i) := by
              rw [← Tree.rolesCol_append, List.take_append_drop]
            rw [hsplit]
            exact List.mem_append_left _ hyB
          · obtain ⟨k, -, hk, hin⟩ := Scan.rolesCol_inEntry _ _ _ 0 _ hyB
            simp only [List.length_take, Nat.zero_add] at hk
            exact ⟨k, List.mem_range.2 (by omega), hin⟩
        simp only [ScanSetup.pkSrcChart, if_neg hyP, if_neg hyR]
        rw [pkAsg_used_E8 S β (by
          simp only [ScanSetup.usedNames, List.mem_append]
          exact Or.inl (Or.inr (List.mem_map_of_mem hyBank)))]
        have := hBKlt y hyB
        simpa [ScanSetup.bankVal, hyR, hyBank] using this
  · -- the auxiliary names
    show S.pkAsg β x < _
    rw [pkAsg_used_E8 S β (by
      simp only [ScanSetup.usedNames]
      exact List.mem_append_right _ hx)]
    exact (hauxlt x hx).trans hρu

end ScanValid_E8

/-- L7.6a steps 4–10: the scan packet is valid. -/
theorem scanPacket_valid_E8 {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) {i j : Nat}
    (hij : Scan.ReachesGT (Scan.rootKeys S.H S.rd) (Scan.queryKeys S.sd) i j)
    {β : Role → Ordinal.{u}} (hfit : S.Fitted P j β) (h17a : S.Lmax j β < S.ownerVal i)
    (hheads : S.HeadsAt P j i β) : (S.scanPacket i j β).Valid P := by
  have hj := (reach_idx_E8 hij).2
  exact ⟨scan_valid1_E8 S hS hj β, scan_valid2_E8 S hS hij β, scan_valid3_E8 S hS hj β,
    scan_valid4_E8 S hS hj β, scan_valid5_E8 S hS hij hfit, scan_valid6_E8 S hS hij hheads,
    scan_valid7_E8 S hS hij h17a⟩

end ScanPacket_E8

-- provides: U3, L7.6a (explicit form of the spine's `scan_packet`)
theorem scanPacket_spec {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) {i j : Nat}
    (hij : Scan.ReachesGT (Scan.rootKeys S.H S.rd) (Scan.queryKeys S.sd) i j)
    {β : Role → Ordinal.{u}} (hfit : S.Fitted P j β) (h17a : S.Lmax j β < S.ownerVal i)
    (hheads : S.HeadsAt P j i β) :
    let pk := S.scanPacket i j β
    pk.rk = S.scanRecord i j ∧ pk.rk.Admitted ∧ pk.Valid P ∧ pk.asg pk.owner = S.ownerVal i ∧
    ∀ L, S.Lmax j β ≤ L → ∀ γ : BlkVar → Ordinal.{u},
      (∀ w x, pk.tgtFrame.toFr w = some x → γ w = pk.asg x) →
      (∀ w ∈ baseVars (posBlock pk.rk.tgtKey pk.rk.tgtSel), pk.tgtFrame.toFr w = none →
        L < γ w ∧ ∀ x ∈ pk.lowNames, pk.asg x < γ w) →
      (∀ w ∈ baseVars (posBlock pk.rk.tgtKey pk.rk.tgtSel), γ w < pk.asg pk.owner) →
      BaseHolds P (posBlock pk.rk.tgtKey pk.rk.tgtSel) γ →
      S.Fitted P (j + 1) (S.extendFit j β γ) ∧ (∀ x ∈ S.fittedRoles j, S.extendFit j β γ x = β x) ∧
      ∀ x ∈ S.entryRoles j, L < S.extendFit j β γ x ∧ S.extendFit j β γ x < S.ownerVal i := by
  intro pk
  have hj := (reach_idx_E8 hij).2
  have hown := scan_owner_E8 S hS hij β
  refine ⟨rfl, scanPacket_admitted_E8 S hS hij, scanPacket_valid_E8 S hS hij hfit h17a hheads,
    hown, ?_⟩
  intro L hL γ g1 g2 g3 g4
  obtain ⟨hb, -, hnum, hentE, -⟩ := scan_target_E8 S hS (i := i) hj
  have hQj : S.sd.Q[j]? = some S.sd.Q[j] := List.getElem?_eq_getElem hj
  have hkey : pk.rk.tgtKey = ((Scan.queryKeys S.sd)[j]?).getD Tree.empty := by
    have h1 := scanRecord_tgtHeight S hS (i := i) hj
    show relKey ((S.scanRecord i j).b.col.num 0) (S.scanRecord i j).tgtHeight = _
    rw [h1, hb, hnum, ← (Scan.stopData_spec hS.1.2.2.2.1).2.2.1]
    simp [Scan.queryKeys, List.getElem?_map, hQj]
  have hsel : pk.rk.tgtSel = ((S.sd.Q[j]?).map Prod.fst).getD 0 := by
    show (((S.scanRecord i j).E.entryAt (S.scanRecord i j).b).map Prod.fst).getD 0 = _
    rw [hb]
    simp [ScanSetup.scanRecord, hentE, hQj]
  rw [hkey, hsel] at g2 g3 g4
  obtain ⟨hfnone, hfsome⟩ := scan_frame_E8 S hS (i := i) hj β
  have hfr : ∀ w x, (frameOf ⟨S.sd.col, j⟩).toFr w = some x → γ w = S.fitVal β x := by
    intro w x hx
    obtain ⟨x', hx', hv⟩ := hfsome w x hx
    rw [g1 w x' hx']
    exact hv
  have hnew : ∀ w ∈ baseVars (posBlock (((Scan.queryKeys S.sd)[j]?).getD Tree.empty)
      (((S.sd.Q[j]?).map Prod.fst).getD 0)), (frameOf ⟨S.sd.col, j⟩).toFr w = none → L < γ w :=
    fun w hw hn => (g2 w hw (hfnone w hn)).1
  obtain ⟨h1, h2, h3⟩ := fitExtend_E8 S hS hj hfit hL hfr hnew g4
  refine ⟨h1, h2, fun x hx => ?_⟩
  obtain ⟨w, hw, hwn, hwv⟩ := h3 x hx
  rw [hwv]
  exact ⟨(g2 w hw (hfnone w hwn)).1, (g3 w hw).trans_eq hown⟩

-- provides: U3, L7.6 (complete packets at a scan, (17))
-- Moved here from `Plan/Spine.lean` (brief rule 5; name and statement unchanged): the proof uses
-- L7.6a `scanPacket_spec`; nothing between the spine and this point uses it. `h17b` is not needed
-- (blueprint L7.6).
theorem scan_packet {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) {i j : Nat}
    (hij : Scan.ReachesGT (Scan.rootKeys S.H S.rd) (Scan.queryKeys S.sd) i j)
    {β : Role → Ordinal.{u}} (hfit : S.Fitted P j β) (h17a : S.Lmax j β < S.ownerVal i)
    (h17b : S.Lmax j β ≤ S.Cmax j) (hheads : S.HeadsAt P j i β) :
    ∃ pk : SourcePacket.{u}, pk.rk = S.scanRecord i j ∧ pk.rk.Admitted ∧ pk.Valid P ∧
      pk.asg pk.owner = S.ownerVal i ∧
      ∀ L, S.Lmax j β ≤ L → pk.TargetAbove P L →
        ∃ β', S.Fitted P (j + 1) β' ∧ (∀ x ∈ S.fittedRoles j, β' x = β x) ∧
          ∀ x ∈ S.entryRoles j, L < β' x ∧ β' x < S.ownerVal i := by
  obtain ⟨h1, h2, h3, h4, h5⟩ := scanPacket_spec S hS hij hfit h17a hheads
  refine ⟨S.scanPacket i j β, h1, h2, h3, h4, fun L hL hT => ?_⟩
  obtain ⟨γ, g1, g2, g3, g4⟩ := hT
  exact ⟨S.extendFit j β γ, h5 L hL γ g1 g2 g3 g4⟩

/-- L4.3d (moved from U5 `Req.ChildData`; requested by U5 R29): the data of §8.5 Case 2
(txt:1364-1368): a safe truncation `F₁` of the source context, a confined step of it, and the
admitted record of its output. -/
structure ChildData (pk : SourcePacket.{u}) where
  F₁ : Forest
  k : Nat
  F₂ : Forest
  sd₁ : Scan.StopData
  kind' : RecKind pk.rk.E
  inL : Scan.InL F₁
  roles_pre : F₁.roles <+: pk.rk.F.roles
  graph_sub : ∀ a ∈ graph F₁, a ∈ graph pk.rk.F
  stop : Scan.stopData F₁ = some sd₁
  stop_inside : (Role.ord sd₁.col).inEntry pk.rk.a = true
  step : expand F₁ k = some F₂
  branch : (Scan.stepKind F₁ = some .ordinary ∧ sd₁.Q = [] ∧
      ∃ rd₁, Scan.rootData F₁ = some rd₁ ∧ (Role.ord rd₁.col).inEntry pk.rk.a = true) ∨
    (Scan.stepKind F₁ = some .special ∧
      ∃ e, sd₁.ownerEntry = some e ∧ (Role.slot e).inEntry pk.rk.a = true ∧ e ≠ pk.rk.a)
  persist : prefixRoles F₂ pk.rk.a = prefixRoles pk.rk.F pk.rk.a
  admitted : ({ E := pk.rk.E, b := pk.rk.b, F := F₂, a := pk.rk.a, kind := kind' } :
    SrcRecord).Admitted

-- provides: U3, L4.3d (requested by U5 R29): the Case 2 data exist.
theorem childEnds_package (pk : SourcePacket.{u}) (hadm : pk.rk.Admitted)
    {π : List (Nat × Nat)} (hfd : pk.rk.firstDiff = .childEnds π) : Nonempty (ChildData pk) := by
  obtain ⟨A₁, hL₁, -, -, hroles, hgraph, ⟨sd₁, hsd₁, hin₁, hsp₁⟩, hbranch, k, A₂, hexp, -, -, hadm₂⟩ :=
    reduce_childEnds hadm hfd
  have hin : ∀ x : Role, pk.rk.a.heightPath <+: x.path → x.inEntry pk.rk.a = true := by
    intro x hx
    simp [Role.inEntry, List.isPrefixOf_iff_prefix.mpr hx]
  refine ⟨{
    F₁ := pk.rk.F.setHeight pk.rk.a A₁, k := k, F₂ := pk.rk.F.setHeight pk.rk.a A₂, sd₁ := sd₁,
    kind' := pk.rk.kind.toDesc, inL := hL₁, roles_pre := hroles, graph_sub := hgraph,
    stop := hsd₁, stop_inside := hin _ hin₁, step := hexp, branch := ?_,
    persist := (prefixGraph_setHeight _ _ _ hadm.2.2.1).1, admitted := hadm₂ }⟩
  rcases hbranch with hsp | ⟨hord, sd, rd, hsd, hQ, hrd, hrdin⟩
  · right
    obtain ⟨e, he, hein⟩ := hsp₁ hsp
    refine ⟨hsp, e, he, hin _ hein, ?_⟩
    rintro rfl
    have := hein.length_le
    simp [EntryAddr.heightPath] at this
  · left
    obtain rfl : sd = sd₁ := Option.some.inj (hsd.symm.trans hsd₁)
    exact ⟨hord, hQ, rd, hrd, hin _ hrdin⟩

/-- L7.5d (moved from U5 `Req.CapData`; requested by U5 R30): the data of §8.5 Case 3: the repaired
first-difference cap, the charts of its `E`-prefix and of `Γ(H)`, an extended assignment, the
marked entry's survival, and readmission of the repair records. -/
structure CapData (P : Prims.{u}) (pk : SourcePacket.{u}) where
  w : Closure.AdmCap pk.rk.E
  sd : Scan.StopData
  rd : Scan.RootData
  nm : Role → Name
  nmH : Role → Name
  asg' : Name → Ordinal.{u}
  ordinary : Scan.stepKind w.H = some .ordinary
  stop : Scan.stopData w.H = some sd
  root : Scan.rootData w.H = some rd
  qsize : ∀ J ∈ sd.Q, J.2.size + 2 ≤ pk.rk.tgtHeight.size
  nm_tgt : ∀ y ∈ prefixRoles pk.rk.E pk.rk.b, nm y = pk.tgtChart y
  nm_owner : nm (.slot pk.rk.b) = pk.owner
  pre_sub : ∀ y ∈ prefixRoles pk.rk.E pk.rk.b, y ∈ ePrefix pk.rk.E (some w) sd
  nm_inj : Set.InjOn nm {y | y ∈ ePrefix pk.rk.E (some w) sd}
  nmH_inj : Set.InjOn nmH {x | x ∈ w.H.roles}
  compat : ∀ x ∈ rolesBefore w.H (.ord sd.col), ∀ y, w.origin x = some y → nmH x = nm y
  asg_old : ∀ x, x ∈ pk.lowNames ∨ x = pk.owner → asg' x = pk.asg x
  config : IsConfig P w.H (asg' ∘ nmH)
  ePrefix_holds : BaseHolds P (restrictTo (graph pk.rk.E) (ePrefix pk.rk.E (some w) sd))
    (asg' ∘ nm)
  ePrefix_below : ∀ y ∈ ePrefix pk.rk.E (some w) sd, asg' (nm y) < asg' (nmH (.ord sd.col))
  marked_mem : Closure.moveAddr w.moves pk.rk.b ∈ w.H.entryAddrs
  marked_slot : w.origin (.slot (Closure.moveAddr w.moves pk.rk.b)) = some (.slot pk.rk.b)
  marked_host : w.origin (.ord (Closure.moveAddr w.moves pk.rk.b).col) = some (.ord pk.rk.b.col)
  marked_prefix : ∀ x ∈ prefixRoles w.H (Closure.moveAddr w.moves pk.rk.b),
    ∃ y ∈ prefixRoles pk.rk.E pk.rk.b, w.origin x = some y
  marked_frame : ((frameOf (Closure.moveAddr w.moves pk.rk.b)).map nmH).reps = pk.tgtFrame.reps
  stop_inside : (Role.ord sd.col).inEntry (Closure.moveAddr w.moves pk.rk.b) = true
  owner_lt : pk.asg pk.owner < asg' (nmH (.ord sd.col))
  readmit : ∀ k H', expand w.H k = some H' → pk.rk.E < H' →
    ({ E := pk.rk.E, b := pk.rk.b, F := H'.truncAfter (Closure.moveAddr w.moves pk.rk.b),
       a := Closure.moveAddr w.moves pk.rk.b, kind := .repair w.moves } : SrcRecord).Admitted

/-! ### L7.5d helpers (G-012; `blueprint/repairs/lean/G012.lean`, adapted to the integrated
contracts `Closure.MovesOutside`, `Closure.moves_spec`, `Closure.applyMoves_litCap_addr`,
`repair_moves_outside`) -/

/-- L7.5d-1 (G-012): value separation in its exact form. A configuration is strictly increasing
along the reading order, so a chart `f` through which a configuration `a ∘ f` is read is
injective on the roles. -/
theorem injOn_of_config {P : Prims.{u}} {E : Forest} {V : Type} {f : Role → V}
    {a : V → Ordinal.{u}} (h : IsConfig P E (a ∘ f)) : Set.InjOn f {x | x ∈ E.roles} := by
  intro x hx y hy hxy
  by_contra hne
  obtain ⟨i, hi⟩ := List.mem_iff_getElem?.mp hx
  obtain ⟨j, hj⟩ := List.mem_iff_getElem?.mp hy
  have hij : i ≠ j := by
    rintro rfl
    exact hne (Option.some.inj (hi.symm.trans hj))
  rcases Nat.lt_or_gt_of_ne hij with h1 | h1
  · have h2 := isConfig_before h ⟨i, j, hi, hj, h1⟩
    simp [Function.comp, hxy] at h2
  · have h2 := isConfig_before h ⟨j, i, hj, hi, h1⟩
    simp [Function.comp, hxy] at h2

-- provides: U3, L7.5d (requested by U5 R30): the Case 3 data exist.
theorem cap_package {P : Prims.{u}} (pk : SourcePacket.{u}) (hadm : pk.rk.Admitted)
    (hv : pk.Valid P) {c : ColAddr} {k p : Nat} (hfd : pk.rk.firstDiff = .capAt c k p) :
    Nonempty (CapData P pk) := by
  -- sources: L4.2 `firstDiff_cap`, U2 L3.1 `repair`, T3.2 `std_inL`/`std_condP`
  obtain ⟨hbc, hcE, hup, hKV, hKI, -, hKA, -, -⟩ := firstDiff_cap hadm hfd
  have hstd : IsStd pk.rk.E := hadm.1
  have hL : Scan.InL pk.rk.E := Closure.std_inL hstd
  obtain ⟨w, hwc, hwk, hwp, ⟨sd, hsd, -, -⟩, c₀, hup₀, hwH⟩ :=
    Closure.repair hL (Closure.std_condP hstd) hup hKV hKI hKA
  have hw : w.col = c ∧ w.cut = k ∧ w.par = p := ⟨hwc, hwk, hwp⟩
  -- `ordinary`: U2 T3.8c `litCap_ordinary` at the relocated column; `root`: spine
  have hHL : Scan.InL w.H := w.inL
  have hord : Scan.stepKind w.H = some .ordinary := by
    rw [hwH] at hHL ⊢
    exact Closure.litCap_ordinary hL.2.1 hup₀ hHL.1 hHL.2.1
  obtain ⟨rd, hrd⟩ := Option.isSome_iff_exists.mp (Scan.rootData_of_ordinary hord)
  -- sources: L7.4 `joint_cap`, L7.5 `joint_repair`
  have JC := joint_cap pk hadm hv hfd
  have JR := joint_repair pk hadm hv hfd w hw
  dsimp only at JC JR
  obtain ⟨hKcfg, hκtgt, hκown, -, hown_lt, -, hbelow, -, hholds⟩ := JC
  obtain ⟨hHcfg, -, -, hframe, -, -, -⟩ := JR
  -- the marked entry: L4.3c `repair_moves_outside`, L7.5a `frame_repair`, L7.5a-2, L7.5a-3
  have hbc' : pk.rk.b.heightPath <+: w.col.path := hwc ▸ hbc
  have hout := repair_moves_outside hadm hfd w hw
  have hME := marked_entry_cap hstd w hadm.2.1 hbc' hout
  have hOM := origin_moveAddr hL w hbc' hout
  have hFR := frame_repair hstd w hadm.2.1 hbc' hout
  dsimp only at hFR
  -- the `E`-prefix: U2 D3.1d `admCap_query`, L7.5d-2, D1.2g
  have hT : w.origin (.ord sd.col) = some (.ord c) := by
    have h := (Closure.admCap_query hL w hsd).2.2.2.1
    rwa [hwc] at h
  have hePre : ePrefix pk.rk.E (some w) sd = rolesBefore pk.rk.E (.ord c) := by
    simp [ePrefix, Closure.anchorOrigin, hT]
  have hlit := litCap_rolesBefore_col hup
  have hcapT : capRole w (.ord sd.col) = .ord c := capRole_of_origin w hT
  have hcE' : Role.ord c ∈ pk.rk.E.roles :=
    (Tree.mem_roles_iff _ _).mpr ((Tree.mem_colAddrs_iff _ _).mp hcE)
  have hcin : (Role.ord c).inEntry pk.rk.b = true := by
    simp [Role.inEntry, Role.path, List.isPrefixOf_iff_prefix.mpr hbc]
  have hpre := Tree.prefix_slot_before_inEntry hadm.2.1 hcE' hcin (by simp)
  refine ⟨{
    w := w, sd := sd, rd := rd, nm := capChart pk, nmH := capChart pk ∘ capRole w,
    asg' := pk.asg, ordinary := hord, stop := hsd, root := hrd,
    qsize := (query_size_bound hadm hfd w hw hsd).2.2,
    nm_tgt := hκtgt, nm_owner := hκown,
    pre_sub := fun y hy => by rw [hePre]; exact hpre.subset (List.mem_append_left _ hy),
    nm_inj := ?_, nmH_inj := injOn_of_config hHcfg,
    compat := fun x _ y h => by simp only [Function.comp, capRole_of_origin w h],
    asg_old := fun _ _ => rfl, config := hHcfg,
    ePrefix_holds := ?_, ePrefix_below := ?_,
    marked_mem := hME.1, marked_slot := hOM.1, marked_host := hOM.2,
    marked_prefix := ?_, marked_frame := congrArg Frame.reps hframe,
    stop_inside := (hME.2.2.1 sd hsd).2.1,
    owner_lt := ?_,
    readmit := fun n H' hexp habove => (repair_output hadm hfd w hw hexp habove).2.2.2.2 }⟩
  · -- `nm_inj`: L7.4 (a) and L7.5d-1 on `K`, since `ePrefix = rolesBefore K A_c ⊆ K.roles`
    intro y hy y' hy' h
    have h1 : y ∈ rolesBefore (Closure.litCap pk.rk.E c k p) (.ord c) := by
      rw [hlit.2, ← hePre]; exact hy
    have h2 : y' ∈ rolesBefore (Closure.litCap pk.rk.E c k p) (.ord c) := by
      rw [hlit.2, ← hePre]; exact hy'
    exact injOn_of_config hKcfg ((List.takeWhile_sublist _).subset h1)
      ((List.takeWhile_sublist _).subset h2) h
  · -- `ePrefix_holds`: L7.4 (f) and N3.1 `baseHolds_map`
    rw [hePre]
    exact (baseHolds_map P (capChart pk) _ pk.asg).mp hholds
  · -- `ePrefix_below`: L7.4 (e), `rolesBefore K A_c = rolesBefore E A_c`, `capRole T = A_c`
    intro y hy
    rw [hePre, ← hlit.2] at hy
    show pk.asg (capChart pk y) < pk.asg (capChart pk (capRole w (.ord sd.col)))
    rw [hcapT]
    exact hbelow y hy
  · -- `marked_prefix`: L7.5a (prefix clause) and L7.5a-3 (origins defined on the prefix)
    intro x hx
    obtain ⟨z, hz⟩ := Option.isSome_iff_exists.mp (hME.2.2.2 x hx)
    exact ⟨z, capRole_of_origin w hz ▸ hFR.2.2.1 x hx, hz⟩
  · -- `owner_lt`: L7.4 (d)
    show pk.asg pk.owner < pk.asg (capChart pk (capRole w (.ord sd.col)))
    rw [hcapT]
    exact hown_lt


