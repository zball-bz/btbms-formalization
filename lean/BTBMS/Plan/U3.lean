namespace BTBMS

universe u

/-! D6.1a helpers on trees: labels kept by truncation, roles and labels kept by `setHeight`. -/

namespace Tree

variable {α : Type}

/-- D6.1a helper: every entry of `t'` is an entry of `t` with the same label. -/
def LabelSub (t' t : Tree α) : Prop :=
  ∀ e' y, t'.entryAt e' = some y → ∃ h, t.entryAt e' = some (y.1, h)

theorem LabelSub.refl (t : Tree α) : LabelSub t t := fun _ y hy => ⟨y.2, by simp [hy]⟩

theorem entryAt_nil (cols : List (List (α × Tree α))) (j i : Nat) :
    (Tree.node cols).entryAt ⟨⟨[], j⟩, i⟩ = cols[j]?.bind (·[i]?) := rfl

theorem labelSub_node {cols' cols : List (List (α × Tree α))}
    (h : ∀ (a b : Nat) (y : α × Tree α), (cols'[a]?.bind (·[b]?)) = some y →
      ∃ y' : α × Tree α, cols[a]?.bind (·[b]?) = some y' ∧ y.1 = y'.1 ∧ LabelSub y.2 y'.2) :
    LabelSub (Tree.node cols') (Tree.node cols) := by
  rintro ⟨⟨P, j⟩, i⟩ y hy
  cases P with
  | nil =>
    rw [entryAt_nil] at hy ⊢
    obtain ⟨y', hy', h1, -⟩ := h j i y hy
    exact ⟨y'.2, by rw [hy', h1]⟩
  | cons ab P =>
    obtain ⟨a, b⟩ := ab
    rw [entryAt_cons, Option.bind_eq_some_iff] at hy
    obtain ⟨z, hz, hy⟩ := hy
    obtain ⟨z', hz', -, hsub⟩ := h a b z hz
    obtain ⟨h', hh'⟩ := hsub _ y hy
    refine ⟨h', ?_⟩
    rw [entryAt_cons, Option.bind_eq_some_iff]
    exact ⟨z', hz', hh'⟩

theorem getElem?_take_bind {β : Type} {l : List β} {n m : Nat} {x : β} (h : (l.take n)[m]? = some x) :
    l[m]? = some x := by
  rw [List.getElem?_take] at h
  split_ifs at h; exact h

/-- D6.1a helper: truncation keeps the labels of the entries it keeps. -/
theorem labelSub_truncAux (P : List (Nat × Nat)) :
    ∀ (t : Tree α) (j i : Nat), LabelSub (truncAux P j i t) t := by
  induction P with
  | nil =>
    rintro ⟨cols⟩ j i
    apply labelSub_node
    intro a b y hy
    refine ⟨y, ?_, rfl, LabelSub.refl _⟩
    rw [Option.bind_eq_some_iff] at hy ⊢
    obtain ⟨col', hcol', hy⟩ := hy
    rw [List.getElem?_append] at hcol'
    split_ifs at hcol' with ha
    · exact ⟨col', getElem?_take_bind hcol', hy⟩
    · simp only [List.length_take] at ha hcol'
      rw [List.getElem?_singleton] at hcol'
      split_ifs at hcol' with ha'
      cases hcol'
      rw [List.getD_eq_getElem?_getD] at hy
      cases hj : cols[j]? with
      | none => rw [hj] at hy; simp at hy
      | some col =>
        rw [hj, Option.getD_some] at hy
        have hjl : j < cols.length := (List.getElem?_eq_some_iff.1 hj).1
        have : a = j := by omega
        subst this
        exact ⟨col, hj ▸ rfl, getElem?_take_bind hy⟩
  | cons ci P ih =>
    obtain ⟨c, i₀⟩ := ci
    rintro ⟨cols⟩ j i
    apply labelSub_node
    intro a b y hy
    rw [Option.bind_eq_some_iff] at hy
    obtain ⟨col', hcol', hy⟩ := hy
    rw [List.getElem?_append] at hcol'
    split_ifs at hcol' with ha
    · exact ⟨y, by rw [getElem?_take_bind hcol']; simpa using hy, rfl, LabelSub.refl _⟩
    · simp only [List.length_take] at ha hcol'
      rw [List.getElem?_singleton] at hcol'
      split_ifs at hcol' with ha'
      cases hcol'
      rw [List.getD_eq_getElem?_getD] at hy
      cases hc : cols[c]? with
      | none => rw [hc] at hy; simp at hy
      | some col =>
      rw [hc, Option.getD_some] at hy
      have hcl : c < cols.length := (List.getElem?_eq_some_iff.1 hc).1
      have : a = c := by omega
      subst this
      rw [List.getElem?_append] at hy
      split_ifs at hy with hb
      · exact ⟨y, by rw [hc]; simpa using getElem?_take_bind hy, rfl, LabelSub.refl _⟩
      · simp only [List.length_take] at hb hy
        cases hx : col[i₀]? with
        | none => rw [hx] at hy; simp at hy
        | some x =>
          rw [hx] at hy
          simp only [Option.map_some, Option.toList_some, List.getElem?_singleton] at hy
          split_ifs at hy with hb'
          cases hy
          have hil : i₀ < col.length := (List.getElem?_eq_some_iff.1 hx).1
          have : b = i₀ := by omega
          subst this
          exact ⟨x, by rw [hc]; simpa using hx, rfl, ih x.2 j i⟩

theorem labelSub_truncAfter (t : Tree α) (e : EntryAddr) : LabelSub (t.truncAfter e) t := by
  show LabelSub (t.truncAfterBody e) t
  unfold truncAfterBody
  split_ifs
  · exact labelSub_truncAux _ _ _ _
  · exact LabelSub.refl _

theorem getElem?_modify_modify (cols : List (List (α × Tree α))) (a b : Nat)
    (g : α × Tree α → α × Tree α) (a' b' : Nat) :
    ((cols.modify a (fun col => col.modify b g))[a']?.bind (·[b']?)) =
      if a' = a ∧ b' = b then (cols[a]?.bind (·[b]?)).map g else cols[a']?.bind (·[b']?) := by
  rw [List.getElem?_modify]
  cases hc : cols[a']? with
  | none =>
    by_cases h : a' = a
    · subst h; simp [hc]
    · simp [h]
  | some col =>
    by_cases h : a' = a
    · subst h
      simp only [Option.map_eq_map, Option.map_some, if_true, Option.bind_some, hc]
      rw [List.getElem?_modify]
      by_cases hb : b' = b
      · subst hb; simp
      · simp [hb, Ne.symm hb]
    · simp [h, Ne.symm h]

/-- D6.1a helper: `setAux` keeps the label of every entry outside the replaced height. -/
theorem entryAt_setAux_label (h : Tree α) (P : List (Nat × Nat)) :
    ∀ (t : Tree α) (j i : Nat) (e' : EntryAddr) (y : α × Tree α),
      (setAux h P j i t).entryAt e' = some y → ¬ (P ++ [(j, i)]) <+: e'.col.path →
      ∃ h', t.entryAt e' = some (y.1, h') := by
  induction P with
  | nil =>
    rintro ⟨cols⟩ j i ⟨⟨P', j'⟩, i'⟩ y hy hpre
    simp only [setAux] at hy
    cases P' with
    | nil =>
      rw [entryAt_nil, getElem?_modify_modify] at hy
      rw [entryAt_nil]
      split_ifs at hy with hab
      · obtain ⟨rfl, rfl⟩ := hab
        obtain ⟨x, hx, rfl⟩ := Option.map_eq_some_iff.1 hy
        exact ⟨x.2, hx⟩
      · exact ⟨y.2, by simp [hy]⟩
    | cons ab P' =>
      obtain ⟨a, b⟩ := ab
      rw [entryAt_cons] at hy
      simp only [Tree.cols] at hy
      rw [getElem?_modify_modify] at hy
      rw [entryAt_cons]
      simp only [Tree.cols]
      have hab : ¬ (a = j ∧ b = i) := by
        rintro ⟨rfl, rfl⟩; exact hpre ⟨P', by simp⟩
      rw [if_neg hab] at hy
      exact ⟨y.2, by simpa using hy⟩
  | cons ci P ih =>
    obtain ⟨c, i₀⟩ := ci
    rintro ⟨cols⟩ j i ⟨⟨P', j'⟩, i'⟩ y hy hpre
    simp only [setAux] at hy
    cases P' with
    | nil =>
      rw [entryAt_nil, getElem?_modify_modify] at hy
      rw [entryAt_nil]
      split_ifs at hy with hab
      · obtain ⟨rfl, rfl⟩ := hab
        obtain ⟨x, hx, rfl⟩ := Option.map_eq_some_iff.1 hy
        exact ⟨x.2, hx⟩
      · exact ⟨y.2, by simp [hy]⟩
    | cons ab P' =>
      obtain ⟨a, b⟩ := ab
      rw [entryAt_cons] at hy
      simp only [Tree.cols] at hy
      rw [getElem?_modify_modify] at hy
      rw [entryAt_cons]
      simp only [Tree.cols]
      split_ifs at hy with hab
      · obtain ⟨rfl, rfl⟩ := hab
        rw [Option.bind_eq_some_iff] at hy
        obtain ⟨z, hz, hy⟩ := hy
        obtain ⟨x, hx, rfl⟩ := Option.map_eq_some_iff.1 hz
        have hpre' : ¬ (P ++ [(j, i)]) <+: P' := by
          rintro ⟨u, hu⟩; exact hpre ⟨u, by simp [← hu]⟩
        obtain ⟨h', hh'⟩ := ih x.2 j i ⟨⟨P', j'⟩, i'⟩ y hy hpre'
        exact ⟨h', by rw [hx]; simpa using hh'⟩
      · exact ⟨y.2, by simpa using hy⟩

/-- D6.1a helper: the roles of `setAux` around the replaced entry. -/
theorem roles_setAux (h : Tree α) (P : List (Nat × Nat)) :
    ∀ (t : Tree α) (j i : Nat) (p : α) (H : Tree α), t.entryAt ⟨⟨P, j⟩, i⟩ = some (p, H) →
    ∃ pre post, t.roles = pre ++ Role.slot ⟨⟨P, j⟩, i⟩ ::
        (H.roles.map (Role.under (P ++ [(j, i)])) ++ post) ∧
      (setAux h P j i t).roles = pre ++ Role.slot ⟨⟨P, j⟩, i⟩ ::
        (h.roles.map (Role.under (P ++ [(j, i)])) ++ post) := by
  induction P with
  | nil =>
    rintro ⟨cols⟩ j i p H he
    change (cols[j]?.bind (·[i]?)) = some (p, H) at he
    rw [Option.bind_eq_some_iff] at he
    obtain ⟨col, hcol, hx⟩ := he
    have hj : j < cols.length := (List.getElem?_eq_some_iff.1 hcol).1
    have hi : i < col.length := (List.getElem?_eq_some_iff.1 hx).1
    have hcj : cols[j] = col := (List.getElem?_eq_some_iff.1 hcol).2
    have hci : col[i] = (p, H) := (List.getElem?_eq_some_iff.1 hx).2
    have key : ∀ K : Tree α, (Tree.node (cols.take j ++ (col.take i ++ (p, K) :: col.drop (i + 1)) ::
        cols.drop (j + 1))).roles =
        (rolesCols [] 0 (cols.take j) ++ Role.ord ⟨[], j⟩ :: rolesCol [] j 0 (col.take i)) ++
          Role.slot ⟨⟨[], j⟩, i⟩ :: (K.roles.map (Role.under ([] ++ [(j, i)])) ++
            (rolesCol [] j (i + 1) (col.drop (i + 1)) ++ rolesCols [] (j + 1) (cols.drop (j + 1)))) := by
      intro K
      rw [roles, rolesF, rolesCols_append, rolesCols, rolesCol_append, rolesCol, ← rolesF_eq_map_under]
      simp only [List.length_take, Nat.min_eq_left (Nat.le_of_lt hj), Nat.min_eq_left (Nat.le_of_lt hi),
        Nat.zero_add, List.append_assoc, List.cons_append, List.nil_append]
    refine ⟨rolesCols [] 0 (cols.take j) ++ Role.ord ⟨[], j⟩ :: rolesCol [] j 0 (col.take i),
      rolesCol [] j (i + 1) (col.drop (i + 1)) ++ rolesCols [] (j + 1) (cols.drop (j + 1)), ?_, ?_⟩
    · rw [← key H]
      congr 1
      conv_lhs => rw [list_split_of_getElem? hcol]
      congr 2
      exact congrArg (· :: _) (list_split_of_getElem? hx)
    · rw [← key h]
      simp only [setAux]
      congr 1
      rw [List.modify_eq_take_cons_drop hj, hcj, List.modify_eq_take_cons_drop hi, hci]
  | cons ab P ih =>
    obtain ⟨a, b⟩ := ab
    rintro ⟨cols⟩ j i p H he
    rw [entryAt_cons, Option.bind_eq_some_iff] at he
    obtain ⟨⟨p', h'⟩, hab, he'⟩ := he
    simp only [Tree.cols, Option.bind_eq_some_iff] at hab
    obtain ⟨col, hcol, hx⟩ := hab
    have ha : a < cols.length := (List.getElem?_eq_some_iff.1 hcol).1
    have hb : b < col.length := (List.getElem?_eq_some_iff.1 hx).1
    have hca : cols[a] = col := (List.getElem?_eq_some_iff.1 hcol).2
    have hcb : col[b] = (p', h') := (List.getElem?_eq_some_iff.1 hx).2
    obtain ⟨pre', post', hr', hs'⟩ := ih h' j i p H he'
    have key : ∀ K : Tree α, (Tree.node (cols.take a ++ (col.take b ++ (p', K) :: col.drop (b + 1)) ::
        cols.drop (a + 1))).roles =
        rolesCols [] 0 (cols.take a) ++ Role.ord ⟨[], a⟩ :: (rolesCol [] a 0 (col.take b) ++
          Role.slot ⟨⟨[], a⟩, b⟩ :: (K.roles.map (Role.under [(a, b)]) ++
            (rolesCol [] a (b + 1) (col.drop (b + 1)) ++ rolesCols [] (a + 1) (cols.drop (a + 1))))) := by
      intro K
      rw [roles, rolesF, rolesCols_append, rolesCols, rolesCol_append, rolesCol, rolesF_eq_map_under]
      simp only [List.length_take, Nat.min_eq_left (Nat.le_of_lt ha), Nat.min_eq_left (Nat.le_of_lt hb),
        Nat.zero_add, List.append_assoc, List.cons_append, List.nil_append]
    have hu : (Role.under [(a, b)] ∘ Role.under (P ++ [(j, i)])) =
        Role.under ((a, b) :: P ++ [(j, i)]) := by
      funext x; simp [Role.under_under]
    refine ⟨rolesCols [] 0 (cols.take a) ++ Role.ord ⟨[], a⟩ :: (rolesCol [] a 0 (col.take b) ++
          Role.slot ⟨⟨[], a⟩, b⟩ :: pre'.map (Role.under [(a, b)])),
        post'.map (Role.under [(a, b)]) ++ (rolesCol [] a (b + 1) (col.drop (b + 1)) ++
          rolesCols [] (a + 1) (cols.drop (a + 1))), ?_, ?_⟩
    · have : Tree.node cols = Tree.node (cols.take a ++ (col.take b ++ (p', h') :: col.drop (b + 1)) ::
          cols.drop (a + 1)) := by
        congr 1
        conv_lhs => rw [list_split_of_getElem? hcol]
        congr 2
        exact list_split_of_getElem? hx
      rw [this, key h', hr']
      simp only [List.map_append, List.map_cons, List.map_map, hu, List.append_assoc,
        List.cons_append]
      rfl
    · have : setAux h ((a, b) :: P) j i (Tree.node cols) =
          Tree.node (cols.take a ++ (col.take b ++ (p', setAux h P j i h') :: col.drop (b + 1)) ::
            cols.drop (a + 1)) := by
        simp only [setAux]
        congr 1
        rw [List.modify_eq_take_cons_drop ha, hca, List.modify_eq_take_cons_drop hb, hcb]
      rw [this, key, hs']
      simp only [List.map_append, List.map_cons, List.map_map, hu, List.append_assoc,
        List.cons_append]
      rfl

/-- D6.1a helper: a role of `t` whose path passes through the height of `e` is a role of that
height placed under `e`. -/
theorem mem_height_of_prefix {t : Tree α} {e : EntryAddr} {p : α} {H : Tree α}
    (he : t.entryAt e = some (p, H)) {x : Role} (hx : x ∈ t.roles) (hp : e.heightPath <+: x.path) :
    x ∈ H.roles.map (Role.under e.heightPath) := by
  obtain ⟨σ, hσ⟩ := hp
  have hf : t.forestAt e.heightPath = some H := by rw [forestAt_heightPath]; simp [heightAt, he]
  have hcol : ∀ c : ColAddr, c.path = e.heightPath ++ σ → t.colAt c = H.colAt ⟨σ, c.col⟩ := by
    intro c hc
    unfold colAt
    rw [hc, forestAt_append, hf]
    rfl
  cases x with
  | ord c =>
    rw [mem_roles_iff] at hx
    simp only [Role.path] at hσ
    refine List.mem_map.2 ⟨.ord ⟨σ, c.col⟩, ?_, ?_⟩
    · rw [mem_roles_iff]; show (H.colAt _).isSome; rw [← hcol c hσ.symm]; exact hx
    · simp [Role.under, hσ]
  | slot e' =>
    rw [mem_roles_iff] at hx
    simp only [Role.path] at hσ
    refine List.mem_map.2 ⟨.slot ⟨⟨σ, e'.col.col⟩, e'.idx⟩, ?_, ?_⟩
    · rw [mem_roles_iff]
      have : t.entryAt e' = H.entryAt ⟨⟨σ, e'.col.col⟩, e'.idx⟩ := by
        unfold entryAt; rw [hcol e'.col hσ.symm]
      show (H.entryAt _).isSome; rw [← this]; exact hx
    · simp [Role.under, hσ]

/-! D7.1a helpers on trees: relabelling and reading inside a height. -/

theorem cols_map {β : Type} (f : α → β) (t : Tree α) :
    (t.map f).cols = t.cols.map (fun col => col.map fun x => (f x.1, x.2.map f)) := by
  cases t with
  | node cols =>
    show Tree.mapCols f cols = _
    rw [Scan.treeMapCols_eq_map]
    simp only [Tree.cols]
    congr 1
    funext col
    exact Scan.treeMapCol_eq_map f col

theorem forestAt_map {β : Type} (f : α → β) :
    ∀ (π : List (Nat × Nat)) (t : Tree α), (t.map f).forestAt π = (t.forestAt π).map (Tree.map f)
  | [], t => rfl
  | (c, i) :: rest, t => by
    rw [forestAt_cons, forestAt_cons, cols_map]
    cases h : t.cols[c]? with
    | none => simp [h]
    | some col =>
      simp only [List.getElem?_map, h, Option.map_some, Option.bind_some]
      cases h' : col[i]? with
      | none => simp
      | some x => simp [forestAt_map f rest x.2]

theorem colAt_map {β : Type} (f : α → β) (t : Tree α) (c : ColAddr) :
    (t.map f).colAt c = (t.colAt c).map (fun col => col.map fun x => (f x.1, x.2.map f)) := by
  unfold colAt
  rw [forestAt_map]
  cases t.forestAt c.path with
  | none => rfl
  | some F => simp [cols_map]

theorem entryAt_map {β : Type} (f : α → β) (t : Tree α) (e : EntryAddr) :
    (t.map f).entryAt e = (t.entryAt e).map (fun x => (f x.1, x.2.map f)) := by
  unfold entryAt
  rw [colAt_map]
  cases t.colAt e.col with
  | none => rfl
  | some col => simp

/-- D7.1a helper: columns and entries read inside the height of `e`. -/
theorem colAt_under {t : Tree α} {e : EntryAddr} {B : Tree α} (hB : t.heightAt e = some B)
    (P : List (Nat × Nat)) (j : Nat) : t.colAt ⟨e.heightPath ++ P, j⟩ = B.colAt ⟨P, j⟩ := by
  unfold colAt
  simp only
  rw [forestAt_append, forestAt_heightPath, hB]
  rfl

theorem entryAt_under {t : Tree α} {e : EntryAddr} {B : Tree α} (hB : t.heightAt e = some B)
    (P : List (Nat × Nat)) (j i : Nat) :
    t.entryAt ⟨⟨e.heightPath ++ P, j⟩, i⟩ = B.entryAt ⟨⟨P, j⟩, i⟩ := by
  unfold entryAt
  simp only
  rw [colAt_under hB]

theorem under_mem_roles {t : Tree α} {e : EntryAddr} {B : Tree α} (hB : t.heightAt e = some B)
    {r : Role} (hr : r ∈ B.roles) : r.under e.heightPath ∈ t.roles := by
  cases r with
  | ord c =>
    rw [mem_roles_iff] at hr ⊢
    show (t.colAt ⟨e.heightPath ++ c.path, c.col⟩).isSome
    rw [colAt_under hB]; exact hr
  | slot e' =>
    rw [mem_roles_iff] at hr ⊢
    show (t.entryAt ⟨⟨e.heightPath ++ e'.col.path, e'.col.col⟩, e'.idx⟩).isSome
    rw [entryAt_under hB]; exact hr

end Tree

namespace Packet

open Hier

/-! ## D6.1a  Ownership of graph atoms, reading order, truncation and prefix lemmas -/

/-- D6.1a: the owner of a non-order atom: `lim x ↦ x`, `elem y x ↦ x` (the later column of an
ordinary pair), `edge s c o ↦ s` (the slot whose head edge it is). Order atoms have no owner. -/
def atomOwner {V : Type} : BaseAtom V → Option V
  | .lim x => some x
  | .elem _ x => some x
  | .edge s _ _ => some s
  | .lt _ _ => none
  | .le _ _ => none
  | .eq _ _ => none

/-- D6.1a: the atoms of `D` owned by the role `z`. -/
def ownedBy (D : List (BaseAtom Role)) (z : Role) : List (BaseAtom Role) :=
  D.filter fun a => atomOwner a == some z

/-- D6.1a: `x` strictly precedes `y` in the reading order of `E`. -/
def Before (E : Forest) (x y : Role) : Prop :=
  ∃ i j : Nat, E.roles[i]? = some x ∧ E.roles[j]? = some y ∧ i < j

/-- D6.1a helper: membership in `Γ(E)`, by the four parts of `graph`. -/
theorem mem_graph_iff (E : Forest) (a : BaseAtom Role) :
    a ∈ graph E ↔
      (∃ x ∈ E.roles, a = .lim x) ∨
      (∃ (i : Nat) (x y : Role), E.roles[i]? = some x ∧ E.roles[i + 1]? = some y ∧ a = .lt x y) ∨
      (∃ c : ColAddr, Role.ord c ∈ E.roles ∧ Role.ord ⟨c.path, c.col + 1⟩ ∈ E.roles ∧
        a = .elem (.ord c) (.ord ⟨c.path, c.col + 1⟩)) ∨
      (∃ (e : EntryAddr) (p : Nat) (o v : Role), (E.entryAt e).map Prod.fst = some p ∧
        e.col.rep 0 p = some (o, v) ∧
        (a = .edge (.slot e) (.ord e.col) o ∨ a = .edge (.slot e) (.ord e.col) v)) := by
  unfold graph
  simp only [List.mem_append, List.mem_map, List.mem_filterMap, List.mem_flatMap, or_assoc]
  apply or_congr
  · constructor
    · rintro ⟨x, hx, rfl⟩; exact ⟨x, hx, rfl⟩
    · rintro ⟨x, hx, rfl⟩; exact ⟨x, hx, rfl⟩
  apply or_congr
  · constructor
    · rintro ⟨⟨x, y⟩, hxy, rfl⟩
      obtain ⟨i, hi⟩ := List.mem_iff_getElem?.1 hxy
      rw [List.getElem?_zip_eq_some, List.getElem?_tail] at hi
      exact ⟨i, x, y, hi.1, hi.2, rfl⟩
    · rintro ⟨i, x, y, hx, hy, rfl⟩
      refine ⟨(x, y), List.mem_iff_getElem?.2 ⟨i, ?_⟩, rfl⟩
      rw [List.getElem?_zip_eq_some, List.getElem?_tail]
      exact ⟨hx, hy⟩
  apply or_congr
  · constructor
    · rintro ⟨c, hc, hc'⟩
      split_ifs at hc' with h
      cases hc'
      refine ⟨c, ?_, ?_, rfl⟩
      · rw [Tree.mem_roles_iff]; exact (Tree.mem_colAddrs_iff _ _).1 hc
      · rw [Tree.mem_roles_iff]; exact h
    · rintro ⟨c, hc, hc', rfl⟩
      refine ⟨c, (Tree.mem_colAddrs_iff _ _).2 ((Tree.mem_roles_iff _ _).1 hc), ?_⟩
      rw [if_pos ((Tree.mem_roles_iff _ _).1 hc')]
  · constructor
    · rintro ⟨e, he, ha⟩
      split at ha
      · rename_i p h' hpe
        split at ha
        · rename_i o v hov
          refine ⟨e, p, o, v, by simp [hpe], hov, ?_⟩
          simpa using ha
        · simp at ha
      · simp at ha
    · rintro ⟨e, p, o, v, hp, hov, ha⟩
      obtain ⟨⟨p', h'⟩, hpe, rfl⟩ := Option.map_eq_some_iff.1 hp
      refine ⟨e, (Tree.mem_entryAddrs_iff _ _).2 (by simp [hpe]), ?_⟩
      simp only [hpe, hov]
      simpa using ha

/-- D6.1a helper: both representatives read by an entry lie in its prefix. -/
theorem rep_mem_prefix {E : Forest} {e : EntryAddr} (he : e ∈ E.entryAddrs) {q : Nat}
    {o v : Role} (h : e.col.rep 0 q = some (o, v)) :
    o ∈ prefixRoles E e ∧ v ∈ prefixRoles E e := by
  obtain ⟨-, hstack, hcont⟩ := Tree.stack_mem_prefix he
  unfold ColAddr.rep at h
  obtain ⟨o', ho', hov⟩ := Option.map_eq_some_iff.1 h
  have hs := ((ColAddr.resolve_spec 0 _ _ _).1 ho').1
  simp only [Prod.mk.injEq] at hov
  obtain ⟨rfl, rfl⟩ := hov
  refine ⟨hstack o' hs, ?_⟩
  split
  · rename_i e'' he''
    obtain ⟨-, hc⟩ := (ColAddr.container_spec _ _ _).1 he''
    exact hcont e'' hc
  · exact hstack o' hs

theorem prefixRoles_sub {E : Forest} {e : EntryAddr} {x : Role} (h : x ∈ prefixRoles E e) :
    x ∈ E.roles :=
  (List.takeWhile_prefix _).mem h

-- provides: U3, D6.1a (every atom of `Γ(E)` is a consecutive order atom or is owned by a role)
theorem graph_atom_cases (E : Forest) (a : BaseAtom Role) (ha : a ∈ graph E) :
    (∃ (i : Nat) (x y : Role), a = .lt x y ∧ E.roles[i]? = some x ∧ E.roles[i + 1]? = some y) ∨
    (∃ z ∈ E.roles, atomOwner a = some z) := by
  rcases (mem_graph_iff E a).1 ha with ⟨x, hx, rfl⟩ | ⟨i, x, y, hx, hy, rfl⟩ | ⟨c, -, hc, rfl⟩ |
    ⟨e, p, o, v, hp, -, ha⟩
  · exact Or.inr ⟨x, hx, rfl⟩
  · exact Or.inl ⟨i, x, y, rfl, hx, hy⟩
  · exact Or.inr ⟨_, hc, rfl⟩
  · refine Or.inr ⟨.slot e, ?_, by rcases ha with rfl | rfl <;> rfl⟩
    rw [Tree.mem_roles_iff]
    obtain ⟨x, hx, -⟩ := Option.map_eq_some_iff.1 hp
    simp [hx]

-- provides: U3, D6.1a (the order atoms of `Γ(E)` are exactly the consecutive pairs)
theorem graph_lt_iff (E : Forest) (x y : Role) :
    BaseAtom.lt x y ∈ graph E ↔ ∃ i : Nat, E.roles[i]? = some x ∧ E.roles[i + 1]? = some y := by
  rw [mem_graph_iff]
  constructor
  · rintro (⟨_, -, h⟩ | ⟨i, x', y', hx, hy, h⟩ | ⟨c, -, -, h⟩ | ⟨e, p, o, v, -, -, h | h⟩)
    · cases h
    · cases h; exact ⟨i, hx, hy⟩
    · cases h
    · cases h
    · cases h
  · rintro ⟨i, hx, hy⟩
    exact Or.inr (Or.inl ⟨i, x, y, hx, hy, rfl⟩)

-- provides: U3, D6.1a (every variable of an atom of `Γ(E)` is a role of `E`)
theorem graph_vars_roles (E : Forest) (a : BaseAtom Role) (ha : a ∈ graph E) :
    ∀ v ∈ a.vars, v ∈ E.roles := by
  rcases (mem_graph_iff E a).1 ha with ⟨x, hx, rfl⟩ | ⟨i, x, y, hx, hy, rfl⟩ | ⟨c, hc, hc', rfl⟩ |
    ⟨e, p, o, v, hp, hov, ha⟩
  · simpa [BaseAtom.vars] using hx
  · simp only [BaseAtom.vars, List.mem_cons, List.not_mem_nil, or_false]
    rintro v (rfl | rfl)
    · exact List.mem_of_getElem? hx
    · exact List.mem_of_getElem? hy
  · simp only [BaseAtom.vars, List.mem_cons, List.not_mem_nil, or_false]
    rintro v (rfl | rfl) <;> assumption
  · obtain ⟨x, hx, -⟩ := Option.map_eq_some_iff.1 hp
    have he : e ∈ E.entryAddrs := (Tree.mem_entryAddrs_iff _ _).2 (by simp [hx])
    have hslot : Role.slot e ∈ E.roles := by rw [Tree.mem_roles_iff]; simp [hx]
    obtain ⟨hord, -, -⟩ := Tree.stack_mem_prefix he
    obtain ⟨ho, hv⟩ := rep_mem_prefix he hov
    rcases ha with rfl | rfl <;>
    · simp only [BaseAtom.vars, List.mem_cons, List.not_mem_nil, or_false]
      rintro w (rfl | rfl | rfl)
      · exact hslot
      · exact prefixRoles_sub hord
      · first | exact prefixRoles_sub ho | exact prefixRoles_sub hv

/-- D6.1a helper: strict increase along `E.roles` from consecutive order atoms that hold. -/
theorem lt_of_consec {E : Forest} {α : Role → Ordinal.{u}} (m : Nat)
    (hcons : ∀ i x y, i + 1 < m → E.roles[i]? = some x → E.roles[i + 1]? = some y → α x < α y) :
    ∀ (d i : Nat) {x y : Role}, i + d + 1 < m → E.roles[i]? = some x →
      E.roles[i + d + 1]? = some y → α x < α y := by
  intro d
  induction d with
  | zero => intro i x y hm hx hy; exact hcons i x y hm hx hy
  | succ d ih =>
    intro i x y hm hx hy
    have hlen : i + d + 1 < E.roles.length := by
      have := (List.getElem?_eq_some_iff.1 hy).1; omega
    have hz : E.roles[i + d + 1]? = some (E.roles[i + d + 1]) := List.getElem?_eq_getElem hlen
    exact (ih i (by omega) hx hz).trans
      (hcons (i + d + 1) _ y (by omega) hz (by rw [← hy]; congr 1))

-- provides: U3, D6.1a (a configuration is strictly increasing along the reading order)
theorem isConfig_before {P : Prims.{u}} {E : Forest} {α : Role → Ordinal.{u}}
    (h : IsConfig P E α) {x y : Role} (hxy : Before E x y) : α x < α y := by
  obtain ⟨i, j, hx, hy, hij⟩ := hxy
  obtain ⟨d, rfl⟩ : ∃ d, j = i + d + 1 := ⟨j - i - 1, by omega⟩
  refine lt_of_consec (E := E) (i + d + 2) (fun k x y _ hx hy => ?_) d i (by omega) hx hy
  exact h _ ((graph_lt_iff E x y).2 ⟨k, hx, hy⟩)

-- provides: U3, D6.1a
theorem le_cfgMax (E : Forest) (α : Role → Ordinal.{u}) {x : Role} (hx : x ∈ E.roles) :
    α x ≤ cfgMax E α := by
  unfold cfgMax
  generalize E.roles = l at hx
  induction l with
  | nil => simp at hx
  | cons y l ih =>
    simp only [List.map_cons, List.foldr_cons]
    rcases List.mem_cons.1 hx with rfl | hx
    · exact le_max_left _ _
    · exact (ih hx).trans (le_max_right _ _)

-- provides: U3, D6.1a
theorem cfgMax_lt (E : Forest) (α : Role → Ordinal.{u}) {θ : Ordinal.{u}} (hθ : 0 < θ)
    (h : ∀ x ∈ E.roles, α x < θ) : cfgMax E α < θ := by
  unfold cfgMax
  generalize E.roles = l at h
  induction l with
  | nil => simpa using hθ
  | cons y l ih =>
    simp only [List.map_cons, List.foldr_cons]
    exact max_lt (h y (List.mem_cons_self ..)) (ih fun x hx => h x (List.mem_cons_of_mem _ hx))

theorem getElem?_of_prefix {β : Type} {S L : List β} (h : S <+: L) {k : Nat} (hk : k < S.length) :
    L[k]? = S[k]? := by
  rw [List.prefix_iff_eq_take.1 h, List.getElem?_take, if_pos hk]

/-- D6.1a helper: atoms of `Γ(F)` inside a common prefix `S` of the reading orders of `F` and `t`
are atoms of `Γ(t)`, when the entries with slots in `S` have the same labels. -/
theorem restrict_graph_of_common {F t : Forest} {S : List Role} (hF : S <+: F.roles)
    (ht : S <+: t.roles)
    (hlab : ∀ e, Role.slot e ∈ S → (F.entryAt e).map Prod.fst = (t.entryAt e).map Prod.fst)
    (a : BaseAtom Role) : a ∈ restrictTo (graph F) S → a ∈ restrictTo (graph t) S := by
  unfold restrictTo
  rw [List.mem_filter, List.mem_filter]
  rintro ⟨ha, hv⟩
  refine ⟨?_, hv⟩
  have hv' : ∀ v ∈ a.vars, v ∈ S := by simpa using hv
  rw [mem_graph_iff]
  rcases (mem_graph_iff F a).1 ha with ⟨x, hx, rfl⟩ | ⟨i, x, y, hx, hy, rfl⟩ | ⟨c, hc, hc', rfl⟩ |
    ⟨e, p, o, v, hp, hov, ha⟩
  · exact Or.inl ⟨x, ht.mem (hv' x (by simp [BaseAtom.vars])), rfl⟩
  · have hyS := hv' y (by simp [BaseAtom.vars])
    obtain ⟨k, hk⟩ := List.mem_iff_getElem?.1 hyS
    have hkS : k < S.length := (List.getElem?_eq_some_iff.1 hk).1
    have hkF : F.roles[k]? = some y := by rw [getElem?_of_prefix hF hkS]; exact hk
    have hkl : k < F.roles.length := (List.getElem?_eq_some_iff.1 hkF).1
    have hki : k = i + 1 := (List.getElem?_inj hkl (Tree.roles_nodup F)).1 (hkF.trans hy.symm)
    subst hki
    refine Or.inr (Or.inl ⟨i, x, y, ?_, ?_, rfl⟩)
    · rw [getElem?_of_prefix ht (by omega), ← getElem?_of_prefix hF (by omega)]; exact hx
    · rw [getElem?_of_prefix ht hkS]; exact hk
  · refine Or.inr (Or.inr (Or.inl ⟨c, ht.mem (hv' _ (by simp [BaseAtom.vars])),
      ht.mem (hv' _ (by simp [BaseAtom.vars])), rfl⟩))
  · have hs : Role.slot e ∈ S := hv' _ (by rcases ha with rfl | rfl <;> simp [BaseAtom.vars])
    exact Or.inr (Or.inr (Or.inr ⟨e, p, o, v, by rw [← hlab e hs]; exact hp, hov, ha⟩))

theorem restrict_graph_self (F : Forest) (a : BaseAtom Role) :
    a ∈ restrictTo (graph F) F.roles ↔ a ∈ graph F := by
  unfold restrictTo
  rw [List.mem_filter]
  constructor
  · exact fun h => h.1
  · intro h
    exact ⟨h, by simpa using graph_vars_roles F a h⟩

-- provides: U3, D6.1a (truncation after an entry restricts the graph)
theorem graph_truncAfter (t : Forest) (e : EntryAddr) (he : e ∈ t.entryAddrs) (a : BaseAtom Role) :
    a ∈ graph (t.truncAfter e) ↔ a ∈ restrictTo (graph t) (t.truncAfter e).roles := by
  have hF := Tree.truncAfter_roles_under he
  obtain ⟨post, hr, -⟩ := Tree.roles_entry he
  have hpre : (t.truncAfter e).roles <+: t.roles := by
    rw [hF, hr]
    exact ⟨post, by simp⟩
  have hlab : ∀ e', Role.slot e' ∈ (t.truncAfter e).roles →
      ((t.truncAfter e).entryAt e').map Prod.fst = (t.entryAt e').map Prod.fst := by
    intro e' he'
    rw [Tree.mem_roles_iff] at he'
    obtain ⟨y, hy⟩ := Option.isSome_iff_exists.1 he'
    obtain ⟨h', hh'⟩ := Tree.labelSub_truncAfter t e e' y hy
    rw [hy, hh']; rfl
  rw [← restrict_graph_self]
  constructor
  · exact restrict_graph_of_common (List.prefix_refl _) hpre hlab a
  · exact restrict_graph_of_common hpre (List.prefix_refl _) (fun e' he' => (hlab e' he').symm) a

/-- D6.1a helper: `setHeight` keeps the roles before the slot and their labels. -/
theorem setHeight_decomp (t : Forest) (e : EntryAddr) (h : Forest) {p : Nat} {H : Forest}
    (he : t.entryAt e = some (p, H)) :
    ∃ post, t.roles = prefixRoles t e ++ Role.slot e :: (H.roles.map (Role.under e.heightPath) ++ post) ∧
      (t.setHeight e h).roles = prefixRoles t e ++ Role.slot e ::
        (h.roles.map (Role.under e.heightPath) ++ post) ∧
      ∀ e', Role.slot e' ∈ prefixRoles t e →
        ((t.setHeight e h).entryAt e').map Prod.fst = (t.entryAt e').map Prod.fst := by
  obtain ⟨⟨P, j⟩, i⟩ := e
  have hsh : t.setHeight ⟨⟨P, j⟩, i⟩ h = Tree.setAux h P j i t := by
    show t.setHeightBody _ h = _
    rw [Tree.setHeightBody, if_pos (by rw [he]; rfl)]
  obtain ⟨pre, post, hr, hs⟩ := Tree.roles_setAux h P t j i p H he
  have hpre : prefixRoles t ⟨⟨P, j⟩, i⟩ = pre := Tree.prefixRoles_of_decomp hr
  rw [hpre, hsh]
  refine ⟨post, hr, hs, ?_⟩
  intro e' he'
  have hin : Role.slot e' ∈ (Tree.setAux h P j i t).roles := by rw [hs]; simp [he']
  rw [Tree.mem_roles_iff] at hin
  obtain ⟨y, hy⟩ := Option.isSome_iff_exists.1 hin
  have hnot : ¬ (P ++ [(j, i)]) <+: e'.col.path := by
    intro hp
    have hmem := Tree.mem_height_of_prefix he (x := .slot e') (by rw [hr]; simp [he'])
      (by simpa [EntryAddr.heightPath, Role.path] using hp)
    have hnd := Tree.roles_nodup t
    rw [hr, List.nodup_append] at hnd
    exact hnd.2.2 _ he' _ (List.mem_cons_of_mem _ (List.mem_append_left _ hmem)) rfl
  obtain ⟨h', hh'⟩ := Tree.entryAt_setAux_label h P t j i e' y hy hnot
  rw [hy, hh']; rfl

-- provides: U3, D6.1a (replacing a height leaves the prefix before its slot unchanged)
theorem prefixGraph_setHeight (t : Forest) (e : EntryAddr) (h : Forest) (he : e ∈ t.entryAddrs) :
    prefixRoles (t.setHeight e h) e = prefixRoles t e ∧
    ∀ a, a ∈ prefixGraph (t.setHeight e h) e ↔ a ∈ prefixGraph t e := by
  rw [Tree.mem_entryAddrs_iff] at he
  obtain ⟨⟨p, H⟩, hx⟩ := Option.isSome_iff_exists.1 he
  obtain ⟨post, hr, hs, hlab⟩ := setHeight_decomp t e h hx
  have hpre : prefixRoles (t.setHeight e h) e = prefixRoles t e := Tree.prefixRoles_of_decomp hs
  refine ⟨hpre, fun a => ?_⟩
  unfold prefixGraph
  rw [hpre]
  have h1 : prefixRoles t e <+: (t.setHeight e h).roles := by rw [hs]; exact List.prefix_append _ _
  have h2 : prefixRoles t e <+: t.roles := by rw [hr]; exact List.prefix_append _ _
  constructor
  · exact restrict_graph_of_common h1 h2 hlab a
  · exact restrict_graph_of_common h2 h1 (fun e' he' => (hlab e' he').symm) a

-- [Changed in verification] D6.1a item 4b: strict increase along a realized prefix of `Γ(E)`
-- (used by L7.6a step 8(b), where only `restrictTo (graph E) P_E` is realized).
theorem before_of_restrict {P : Prims.{u}} {E : Forest} {α : Role → Ordinal.{u}} {m : Nat}
    (h : BaseHolds P (restrictTo (graph E) (E.roles.take m)) α) {x y : Role}
    (hx : x ∈ E.roles.take m) (hy : y ∈ E.roles.take m) (hxy : Before E x y) : α x < α y := by
  obtain ⟨i, j, hxi, hyj, hij⟩ := hxy
  have hjm : j < m := by
    obtain ⟨k, hk⟩ := List.mem_iff_getElem?.1 hy
    rw [List.getElem?_take] at hk
    split_ifs at hk with hkm
    · have hk' : k < E.roles.length := (List.getElem?_eq_some_iff.1 hk).1
      have := (List.getElem?_inj hk' (Tree.roles_nodup E)).1 (hk.trans hyj.symm)
      omega
  obtain ⟨d, rfl⟩ : ∃ d, j = i + d + 1 := ⟨j - i - 1, by omega⟩
  refine lt_of_consec (E := E) m (fun k x y hk hx hy => ?_) d i hjm hxi hyj
  refine h (BaseAtom.lt x y) ?_
  unfold restrictTo
  rw [List.mem_filter]
  refine ⟨(graph_lt_iff E x y).2 ⟨k, hx, hy⟩, ?_⟩
  simp only [BaseAtom.vars, List.all_cons, List.all_nil, Bool.and_true, Bool.and_eq_true,
    decide_eq_true_eq]
  refine ⟨List.mem_iff_getElem?.2 ⟨k, ?_⟩, List.mem_iff_getElem?.2 ⟨k + 1, ?_⟩⟩
  · rw [List.getElem?_take, if_pos (by omega)]; exact hx
  · rw [List.getElem?_take, if_pos hk]; exact hy

-- [Changed in verification] D6.1a item 8: truncation at a slot (keep `U_e`, clear its height)
-- restricts the graph (used by L7.4 step 6 for the reindexed internal cap `S_A`).
theorem graph_truncClear (t : Forest) (e : EntryAddr) (he : e ∈ t.entryAddrs) (a : BaseAtom Role) :
    a ∈ graph ((t.truncAfter e).setHeight e Tree.empty) ↔
      a ∈ restrictTo (graph t) ((t.truncAfter e).setHeight e Tree.empty).roles := by
  have hx' := he
  rw [Tree.mem_entryAddrs_iff] at hx'
  obtain ⟨⟨p, H⟩, hx⟩ := Option.isSome_iff_exists.1 hx'
  have hFe : (t.truncAfter e).entryAt e = some (p, H) := by rw [Tree.entryAt_truncAfter he, hx]
  obtain ⟨post, hr, hs, hlab⟩ := setHeight_decomp (t.truncAfter e) e Tree.empty hFe
  have hF := Tree.truncAfter_roles_under he
  have hpF : prefixRoles (t.truncAfter e) e = prefixRoles t e := (Tree.truncAfter_spec t e he).2.2.2.2.2
  rw [hpF] at hr hs hlab
  have hpost : post = [] := by
    rw [hF, show t.heightAt e = some H by simp [Tree.heightAt, hx], Option.getD_some] at hr
    have := congrArg List.length hr
    simp only [List.length_append, List.length_cons, List.length_map] at this
    exact List.eq_nil_of_length_eq_zero (by omega)
  subst hpost
  have hroles : ((t.truncAfter e).setHeight e Tree.empty).roles = prefixRoles t e ++ [Role.slot e] := by
    rw [hs]; rfl
  obtain ⟨post', hr', -⟩ := Tree.roles_entry he
  have hpre : ((t.truncAfter e).setHeight e Tree.empty).roles <+: t.roles := by
    rw [hroles, hr']
    exact ⟨((t.heightAt e).getD Tree.empty).roles.map (Role.under e.heightPath) ++ post', by simp⟩
  have hlab' : ∀ e', Role.slot e' ∈ ((t.truncAfter e).setHeight e Tree.empty).roles →
      (((t.truncAfter e).setHeight e Tree.empty).entryAt e').map Prod.fst =
        (t.entryAt e').map Prod.fst := by
    intro e' he'
    rw [hroles, List.mem_append, List.mem_singleton] at he'
    rcases he' with he' | he'
    · rw [hlab e' he']
      have hin : Role.slot e' ∈ (t.truncAfter e).roles := by rw [hF]; simp [he']
      rw [Tree.mem_roles_iff] at hin
      obtain ⟨y, hy⟩ := Option.isSome_iff_exists.1 hin
      obtain ⟨h', hh'⟩ := Tree.labelSub_truncAfter t e e' y hy
      rw [hy, hh']; rfl
    · cases he'
      have hmem : e ∈ (t.truncAfter e).entryAddrs := (Tree.truncAfter_spec t e he).2.1
      rw [(Tree.setHeight_basic _ e Tree.empty hmem).2.2.2.2.2, hFe, hx]
  rw [← restrict_graph_self]
  constructor
  · exact restrict_graph_of_common (List.prefix_refl _) hpre hlab' a
  · exact restrict_graph_of_common hpre (List.prefix_refl _) (fun e' he' => (hlab' e' he').symm) a

/-! ## D6.1c  Syntactic helpers (moved from U5 N5.7 at integration; real bodies) -/

/-- D6.1c: elementarity-carrying atoms (ordinary pairs and edges). -/
def isStruct {V : Type} : BaseAtom V → Bool
  | .elem _ _ => true
  | .edge _ _ _ => true
  | _ => false

/-- D6.1c: the parent of entry `e` of `E` (`0` if `e` is not an entry). -/
def entrySel (E : Forest) (e : EntryAddr) : Nat := ((E.entryAt e).map Prod.fst).getD 0

/-- D6.1c: the relative key `h_a(H_e)` of the height of entry `e` (host `a = e.col.num 0`). -/
def entryKey (E : Forest) (e : EntryAddr) : Key :=
  relKey (e.col.num 0) ((E.heightAt e).getD Tree.empty)

/-- D6.1c: the `E`-prefix read by labels of an anchored ordinary input: roles of `E` strictly
before the `E`-origin `χ(T)` of the stopping ordinary role (empty if `χ(T)` is undefined). -/
def ePrefix (E : Forest) (cap : Option (Closure.AdmCap E)) (sd : Scan.StopData) : List Role :=
  match Closure.anchorOrigin E cap (.ord sd.col) with
  | some T' => rolesBefore E T'
  | none => []

/-- D6.1c: the query atoms of an ordinary step: atoms of `Γ(H)` inside `P ∪ {T} ∪ Q` that involve
`T` or `Q`. By definition this is `ScanSetup.queryGraph` of any setup anchored at `H`. -/
def queryAtoms (H : Forest) (rs : RoleSets) : List (BaseAtom Role) :=
  (restrictTo (graph H) (rs.P ++ [rs.T] ++ rs.Q)).filter fun a =>
    a.vars.any fun v => decide (v ∈ rs.T :: rs.Q)

/-- D6.1c: the retained structural atoms of an ordinary step: elementarity atoms of `Γ(H)` inside
`D` that involve `K` (txt:940-941, 961). Atoms involving only `R` and pre-root roles are excluded:
the only such atom is the old pair `elem A_prev R`, whose `f`-image is not an atom of
`Γ(H[m+1])`; the root-to-next-column pair involves `K` and stays. -/
def retAtoms (H : Forest) (rs : RoleSets) : List (BaseAtom Role) :=
  (restrictTo (graph H) rs.D).filter fun a =>
    isStruct a && a.vars.any fun v => decide (v ∈ rs.K)

/-- D6.1c: the key of the special copies `(p, C)`: the owner entry's height without its last
column `[(a, ∅)]` (txt:105-107, 1325-1327). -/
def specialKey (H : Forest) (e : EntryAddr) : Key :=
  relKey (e.col.num 0) (.node ((H.heightAt e).getD Tree.empty).cols.dropLast)

/-! ## L6.2a  Stage addresses and the explicit occurrence maps (R-3) -/

-- SCR2 applied at integration: the bridge holds by `rfl`
theorem qMap_eq_def : qMap = qMapDef := by sorry
-- SCR2 applied at integration: the bridge holds by `rfl`
theorem fMap_eq_def : fMap = fMapDef := by sorry

/-- L6.2a: the roles of stage `m` of `H[n]` in reading order: the head, the query copy, the
retained copy. -/
def stageRoles (H : Forest) (n : Nat) (rs : RoleSets) (m : Nat) : List Role :=
  qMap H n m rs.T :: (rs.Q.map (qMap H n m) ++ rs.K.map (fMap H n m))

-- provides: U3, L6.2a (roles of `A_{r,d,ℓ,Z}`: the old roles before the replaced route column,
-- then the roles of `Z` placed at its position)
theorem roles_replaceAt (r d ℓ : Nat) (Z F : Forest) {π : List (Nat × Nat)} {c : Nat}
    (hroute : (Scan.routeCols F)[ℓ]? = some ⟨π, c⟩) :
    (replaceAt r d Z ℓ F).roles = rolesBefore F (.ord ⟨π, c⟩) ++ Z.roles.map (transCols [] π 0 c) :=
  by sorry

-- provides: U3, L6.2a (stack transport: copied entries keep shifted parents, and the
-- representatives read on the copied stack are the mapped old representatives)
theorem rep_stage {H H' : Forest} {n : Nat} {rs : RoleSets} {sd : Scan.StopData}
    {rd : Scan.RootData} (hH : H ≠ Tree.empty) (hV : Scan.CondV H) (hI : Scan.CondI H)
    (hk : Scan.stepKind H = some .ordinary) (hrs : roleSets H = some rs)
    (hsd : Scan.stopData H = some sd) (hrd : Scan.rootData H = some rd)
    (hexp : expand H n = some H') {m : Nat} (hm1 : 1 ≤ m) (hmn : m ≤ n) :
    (∀ e : EntryAddr, Role.slot e ∈ rs.Q → ∀ p, (H.entryAt e).map Prod.fst = some p →
      ∃ e', qMap H n m (.slot e) = .slot e' ∧ qMap H n m (.ord e.col) = .ord e'.col ∧
        (H'.entryAt e').map Prod.fst = some (shiftVal sd.r ((m - 1) * (sd.t - sd.r)) p) ∧
        e'.col.rep 0 (shiftVal sd.r ((m - 1) * (sd.t - sd.r)) p) =
          (e.col.rep 0 p).map fun ov => (qMap H n m ov.1, qMap H n m ov.2)) ∧
    (∀ e : EntryAddr, Role.slot e ∈ rs.K → ∀ p, (H.entryAt e).map Prod.fst = some p →
      ∃ e', fMap H n m (.slot e) = .slot e' ∧ fMap H n m (.ord e.col) = .ord e'.col ∧
        (H'.entryAt e').map Prod.fst = some (shiftVal sd.r (m * (sd.t - sd.r)) p) ∧
        e'.col.rep 0 (shiftVal sd.r (m * (sd.t - sd.r)) p) =
          (e.col.rep 0 p).map fun ov => (fMap H n m ov.1, fMap H n m ov.2)) := by sorry

/-! ## L6.2  Occurrence-map identity; L6.2b deletion; L6.2c special; L6.2d prefix -/

-- provides: U3, L6.2 (refined form of the spine's `occurrence_map_identity`†)
theorem occurrence_map_identity {H H' : Forest} {n : Nat} {rs : RoleSets}
    (hH : H ≠ Tree.empty) (hV : Scan.CondV H) (hI : Scan.CondI H)
    (hk : Scan.stepKind H = some .ordinary) (hrs : roleSets H = some rs)
    (hexp : expand H n = some H') :
    H'.roles = rs.P ++ (List.range n).flatMap (fun m => stageRoles H n rs (m + 1)) ∧
    (∀ z ∈ rs.P, ∀ a, a ∈ ownedBy (graph H') z ↔ a ∈ ownedBy (graph H) z) ∧
    (∀ m, 1 ≤ m → m ≤ n → ∀ x ∈ rs.T :: rs.Q, ∀ a,
      a ∈ ownedBy (graph H') (qMap H n m x) ↔
        ∃ a₀ ∈ ownedBy (graph H) x, a = a₀.map (qMap H n m)) ∧
    (∀ m, 1 ≤ m → m ≤ n → ∀ x ∈ rs.K, ∀ a,
      a ∈ ownedBy (graph H') (fMap H n m x) ↔
        ∃ a₀ ∈ ownedBy (graph H) x, a = a₀.map (fMap H n m)) := by sorry

-- provides: U3, L6.2 (query and retained atoms read only `D ∪ {T} ∪ Q`, resp. `D`)
-- [Changed in verification] hypothesis `InL H` replaces `CondV H`: with V alone the owner's
-- active root entry can be consumed and the statement fails (counterexample in the unit doc).
theorem owned_reads {H : Forest} {rs : RoleSets} (hL : Scan.InL H)
    (hk : Scan.stepKind H = some .ordinary) (hrs : roleSets H = some rs) :
    (∀ x ∈ rs.T :: rs.Q, ∀ a ∈ ownedBy (graph H) x, ∀ v ∈ a.vars, v ∈ rs.D ∨ v ∈ rs.T :: rs.Q) ∧
    (∀ x ∈ rs.K, ∀ a ∈ ownedBy (graph H) x, ∀ v ∈ a.vars, v ∈ rs.D) := by sorry

-- provides: U3, L6.2b (deletion step)
theorem graph_deletion {E E' : Forest} {n : Nat} (h : Scan.stepKind E = some .deletion)
    (hexp : expand E n = some E') :
    E'.roles = E.roles.dropLast ∧ ∀ a, a ∈ graph E' ↔ a ∈ restrictTo (graph E) E'.roles := by sorry

/-- L6.2c: the roles of the special owner entry `e` that are copied: its slot and its height
without the stopping column (txt:107-109). -/
def specialRoles (H : Forest) (sd : Scan.StopData) (e : EntryAddr) : List Role :=
  (H.roles.dropWhile (· != .slot e)).takeWhile (· != .ord sd.col)

/-- L6.2c: the `x`-th copy (`x < n + ε`) of the special owner entry `e`, at index `e.idx + x`. -/
def specialCopy (e : EntryAddr) (x : Nat) : Role → Role :=
  transColumn e.col e.col (fun i => if i = e.idx then e.idx + x else i)

-- provides: U3, L6.2c (special step)
theorem graph_special {H H' : Forest} {n : Nat} {sd : Scan.StopData} {e : EntryAddr}
    (hH : H ≠ Tree.empty) (hV : Scan.CondV H) (hI : Scan.CondI H)
    (hk : Scan.stepKind H = some .special) (hsd : Scan.stopData H = some sd)
    (he : sd.ownerEntry = some e) (hexp : expand H n = some H') :
    let ε := if e.idx = 0 then 1 else 0
    H'.roles = prefixRoles H e ++
      (List.range (n + ε)).flatMap (fun x => (specialRoles H sd e).map (specialCopy e x)) ∧
    (∀ z ∈ prefixRoles H e, ∀ a, a ∈ ownedBy (graph H') z ↔ a ∈ ownedBy (graph H) z) ∧
    (∀ x, x < n + ε → ∀ y ∈ specialRoles H sd e, ∀ a,
      a ∈ ownedBy (graph H') (specialCopy e x y) ↔
        ∃ a₀ ∈ ownedBy (graph H) y, a = a₀.map (specialCopy e x)) := by sorry

-- provides: U3, L6.2d (the spine's `graph_prefix`†: the prefix before any old pre-stop role is
-- unchanged in `H[n]`; used by U5 with `ι = id`)
theorem graph_prefix {H H' : Forest} {n : Nat} {rs : RoleSets}
    (hH : H ≠ Tree.empty) (hV : Scan.CondV H) (hI : Scan.CondI H)
    (hk : Scan.stepKind H = some .ordinary) (hrs : roleSets H = some rs)
    (hexp : expand H n = some H') {x : Role} (hx : x ∈ rs.P) :
    rolesBefore H' x = rolesBefore H x ∧
    ∀ a, a ∈ restrictTo (graph H') (rolesBefore H x) ↔ a ∈ restrictTo (graph H) (rolesBefore H x) :=
  by sorry

/-! ## D6.1b  Graph transport along the surviving-role map of an anchor -/

/-- D6.1b: roles of `E` that are origins of roles of the anchor. -/
def originRange (E : Forest) (cap : Option (Closure.AdmCap E)) : List Role :=
  (Closure.anchor E cap).roles.filterMap (Closure.anchorOrigin E cap)

-- provides: U3, D6.1b (non-order atoms correspond exactly; order is preserved)
theorem graph_origin {E : Forest} (hE : Scan.InL E) (cap : Option (Closure.AdmCap E)) :
    (∀ a, atomOwner a ≠ none →
      ((∃ a₀ ∈ graph (Closure.anchor E cap),
          (∀ v ∈ a₀.vars, (Closure.anchorOrigin E cap v).isSome) ∧ a = a₀.map (anchorD E cap)) ↔
        (a ∈ graph E ∧ ∀ v ∈ a.vars, v ∈ originRange E cap))) ∧
    (∀ x y, Before (Closure.anchor E cap) x y → (Closure.anchorOrigin E cap x).isSome →
      (Closure.anchorOrigin E cap y).isSome → Before E (anchorD E cap x) (anchorD E cap y)) := by
  sorry

/-! ## D7.1a  Frames and blocks read inside a tree -/

/-- D7.1a: inverse of `Role.under` on roles below `pfx`. -/
def relRole (pfx : List (Nat × Nat)) : Role → Role
  | .ord d => .ord ⟨d.path.drop pfx.length, d.col⟩
  | .slot e => .slot ⟨⟨e.col.path.drop pfx.length, e.col.col⟩, e.idx⟩

/-- D7.1a: a column inside the height of `e`, with its address made relative to that height. -/
def relCol (e : EntryAddr) (d : ColAddr) : ColAddr := ⟨d.path.drop e.heightPath.length, d.col⟩

/-- D7.1a helper: a stack occurrence's path is a prefix of the column's path. -/
theorem onStack_path_prefix {c o : ColAddr} (h : c.OnStack o) : o.path <+: c.path := by
  rcases h with ⟨k, -, -, -, hp, -⟩ | ⟨hp, -⟩
  · rw [hp]; exact List.take_prefix _ _
  · rw [hp]

-- provides: U3, D7.1a (a visible column sees the same representatives below its own number)
theorem rep_visible (c o : ColAddr) (ho : c.resolve 0 (o.num 0) = some o) :
    ∀ q, q < o.num 0 → o.rep 0 q = c.rep 0 q := by
  intro q hq
  have hs : c.OnStack o := ((ColAddr.resolve_spec 0 c o _).1 ho).1
  unfold ColAddr.rep
  rw [ColAddr.resolve_of_resolve_lt ho hq]
  cases hr : c.resolve 0 q with
  | none => rfl
  | some r =>
    have hrq : r.num 0 = q := ColAddr.resolve_num hr
    have hcont : r.container o = r.container c := by
      apply Option.ext
      intro e
      rw [ColAddr.container_spec, ColAddr.container_spec]
      constructor
      · rintro ⟨h1, h2⟩; exact ⟨h1, h2.trans (onStack_path_prefix hs)⟩
      · rintro ⟨h1, h2⟩
        refine ⟨h1, EntryAddr.contains_of_resolve (c := c) h2 ho ?_⟩
        rw [h1, hrq]; exact hq
    simp only [Option.map_some, hcont]

/-- D7.1a helper: `resolveAux` passes the levels below the number it resolves. -/
theorem resolveAux_skip (rest : List (Nat × Nat)) (j q : Nat) :
    ∀ (π pre : List (Nat × Nat)) (start : Nat), start + (π.map (·.1 + 1)).sum ≤ q →
      ColAddr.resolveAux start pre (π ++ rest) j q =
        ColAddr.resolveAux (start + (π.map (·.1 + 1)).sum) (pre ++ π) rest j q
  | [], pre, start, _ => by simp
  | (ck, ik) :: π, pre, start, h => by
    simp only [List.map_cons, List.sum_cons] at h
    simp only [List.cons_append, ColAddr.resolveAux]
    rw [if_neg (by omega), resolveAux_skip rest j q π (pre ++ [(ck, ik)]) (start + ck + 1) (by omega)]
    simp only [List.map_cons, List.sum_cons, List.append_assoc, List.singleton_append]
    congr 1
    omega

/-- D7.1a helper: `resolveAux` commutes with prefixing a path and shifting the numbers. -/
theorem resolveAux_shift (π : List (Nat × Nat)) (j k : Nat) :
    ∀ (rest pre : List (Nat × Nat)) (start q : Nat),
      ColAddr.resolveAux (start + k) (π ++ pre) rest j (q + k) =
        (ColAddr.resolveAux start pre rest j q).map (fun o => ⟨π ++ o.path, o.col⟩)
  | [], pre, start, q => by
    simp only [ColAddr.resolveAux]
    by_cases h : start ≤ q ∧ q < start + j
    · rw [if_pos (by omega), if_pos h]
      simp only [Option.map_some]
      congr 2; omega
    · rw [if_neg (by omega), if_neg h]; rfl
  | (ck, ik) :: rest, pre, start, q => by
    simp only [ColAddr.resolveAux]
    by_cases h : start ≤ q ∧ q ≤ start + ck
    · rw [if_pos (by omega), if_pos h]
      simp only [Option.map_some]
      congr 2; omega
    · rw [if_neg (by omega), if_neg h]
      have := resolveAux_shift π j k rest (pre ++ [(ck, ik)]) (start + ck + 1) q
      rw [← this, List.append_assoc]
      congr 1
      omega

/-- D7.1a helper: containers read under a common path prefix. -/
theorem container_under (σ τ : List (Nat × Nat)) (o : ColAddr) (dc : Nat) :
    ColAddr.container ⟨σ ++ o.path, o.col⟩ ⟨σ ++ τ, dc⟩ =
      (o.container ⟨τ, dc⟩).map (fun e' => ⟨⟨σ ++ e'.col.path, e'.col.col⟩, e'.idx⟩) := by
  apply Option.ext
  intro E
  rw [ColAddr.container_spec]
  constructor
  · rintro ⟨h1, h2⟩
    refine Option.mem_map.2 ⟨⟨o, E.idx⟩, ?_, ?_⟩
    · show o.container ⟨τ, dc⟩ = some ⟨o, E.idx⟩
      rw [ColAddr.container_spec]
      refine ⟨rfl, ?_⟩
      simp only [EntryAddr.heightPath, h1, List.append_assoc] at h2
      exact (List.prefix_append_right_inj σ).1 h2
    · obtain ⟨⟨Ep, Ec⟩, Ei⟩ := E
      simp only at h1
      cases h1
      rfl
  · intro h
    obtain ⟨e', he', rfl⟩ := Option.mem_map.1 h
    have he'' : o.container ⟨τ, dc⟩ = some e' := he'
    rw [ColAddr.container_spec] at he''
    have he' := he''
    obtain ⟨h1, h2⟩ := he'
    subst h1
    refine ⟨rfl, ?_⟩
    simp only [EntryAddr.heightPath, List.append_assoc]
    exact (List.prefix_append_right_inj σ).2 h2

-- provides: U3, D7.1a (the visible stack seen from inside the height of `e`)
theorem rep_inside (e : EntryAddr) (d : ColAddr) (hd : e.heightPath <+: d.path) :
    (∀ q, q < e.col.num 0 → d.rep 0 q = e.col.rep 0 q) ∧
    d.rep 0 (e.col.num 0) = some (.ord e.col, .slot e) ∧
    (∀ w, 1 ≤ w → d.rep 0 (e.col.num 0 + w) =
      ((relCol e d).rep 1 w).map fun ov => (Role.under e.heightPath ov.1, Role.under e.heightPath ov.2)) ∧
    d.num 0 = e.col.num 0 + (relCol e d).num 1 := by
  have hc : e.Contains d := hd
  have hres := EntryAddr.resolve_host hc
  obtain ⟨dp, dc⟩ := d
  obtain ⟨σ, hσ⟩ := hd
  simp only at hσ
  subst hσ
  have hrel : relCol e ⟨e.heightPath ++ σ, dc⟩ = ⟨σ, dc⟩ := by simp [relCol]
  have hwid : (e.heightPath.map (·.1 + 1)).sum = e.col.num 0 + 1 := by
    simp [EntryAddr.heightPath, ColAddr.num]; omega
  refine ⟨fun q hq => (rep_visible _ e.col hres q hq).symm, ?_, ?_, ?_⟩
  · unfold ColAddr.rep
    rw [hres]
    simp only [Option.map_some, (EntryAddr.contains_iff_container e _).1 hc]
  · intro w hw
    have hr : ColAddr.resolve 0 ⟨e.heightPath ++ σ, dc⟩ (e.col.num 0 + w) =
        ((ColAddr.resolve 1 ⟨σ, dc⟩ w)).map (fun o => ⟨e.heightPath ++ o.path, o.col⟩) := by
      unfold ColAddr.resolve
      simp only
      rw [resolveAux_skip σ dc _ e.heightPath [] 0 (by omega)]
      have := resolveAux_shift e.heightPath dc (e.col.num 0) σ [] 1 w
      simp only [List.append_nil] at this
      rw [← this]
      congr 1
      · omega
      · omega
    unfold ColAddr.rep
    rw [hr, hrel]
    cases (ColAddr.resolve 1 ⟨σ, dc⟩ w) with
    | none => rfl
    | some o =>
      simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq]
      refine ⟨rfl, ?_⟩
      rw [container_under e.heightPath σ o dc]
      cases o.container ⟨σ, dc⟩ with
      | none => rfl
      | some e' => rfl
  · rw [hrel]
    simp only [ColAddr.num, EntryAddr.heightPath, List.map_append, List.sum_append]
    simp
    omega

/-- D7.1a: the first `m` columns of a forest (the "proper prefix" of Case 1). -/
def takeCols (X : Forest) (m : Nat) : Forest := .node (X.cols.take m)

theorem rep_isSome_iff (c : ColAddr) (q : Nat) : (c.rep 0 q).isSome ↔ q < c.num 0 := by
  unfold ColAddr.rep
  rw [Option.isSome_map, ColAddr.resolve_isSome_iff]
  omega

theorem takeCols_roles_prefix (B : Forest) (m : Nat) : (takeCols B m).roles <+: B.roles := by
  cases B with
  | node cols =>
    show Tree.rolesCols [] 0 (cols.take m) <+: Tree.rolesCols [] 0 cols
    conv_rhs => rw [← List.take_append_drop m cols, Tree.rolesCols_append]
    exact List.prefix_append _ _

theorem takeCols_entryAt (B : Forest) (m : Nat) (e' : EntryAddr) (y : Nat × Forest)
    (h : (takeCols B m).entryAt e' = some y) : B.entryAt e' = some y := by
  cases B with
  | node cols =>
    obtain ⟨⟨P, j⟩, i⟩ := e'
    cases P with
    | nil =>
      rw [takeCols, Tree.entryAt_nil, Option.bind_eq_some_iff] at h
      obtain ⟨col, hcol, hy⟩ := h
      simp only [Tree.cols] at hcol
      rw [Tree.entryAt_nil, Tree.getElem?_take_bind hcol]; exact hy
    | cons ab P =>
      obtain ⟨a, b⟩ := ab
      rw [takeCols, Tree.entryAt_cons, Option.bind_eq_some_iff] at h
      obtain ⟨z, hz, hy⟩ := h
      simp only [Tree.cols, Option.bind_eq_some_iff] at hz
      obtain ⟨col, hcol, hz⟩ := hz
      rw [Tree.entryAt_cons, Option.bind_eq_some_iff]
      exact ⟨z, by simp [Tree.cols, Tree.getElem?_take_bind hcol, hz], hy⟩

theorem takeCols_length (B : Forest) : takeCols B B.cols.length = B := by
  cases B with
  | node cols => simp [takeCols, Tree.cols]

/-- D7.1a helper: entries of a relative key of a column prefix of the height of `e`, read in `F`. -/
theorem key_entry {F : Forest} {e : EntryAddr} {B : Forest} (hB : F.heightAt e = some B) (m : Nat)
    {e' : EntryAddr} {lab : Bool × Nat} {hh : Key}
    (h : (relKey (e.col.num 0) (takeCols B m)).entryAt e' = some (lab, hh)) :
    ∃ p h₀, F.entryAt ⟨⟨e.heightPath ++ e'.col.path, e'.col.col⟩, e'.idx⟩ = some (p, h₀) ∧
      lab = (if p < e.col.num 0 then (false, p) else (true, p - e.col.num 0)) := by
  rw [relKey, Tree.entryAt_map] at h
  obtain ⟨⟨p, h₀⟩, hp, hy⟩ := Option.map_eq_some_iff.1 h
  simp only [Prod.mk.injEq] at hy
  refine ⟨p, h₀, ?_, hy.1.symm⟩
  rw [Tree.entryAt_under hB]
  exact takeCols_entryAt B m e' _ hp

theorem relCol_under (e : EntryAddr) (c : ColAddr) :
    relCol e ⟨e.heightPath ++ c.path, c.col⟩ = c := by
  simp [relCol]

/-- D7.1a helper: the edges read by an internal entry, in the three cases of its key label. -/
theorem inner_edges {e : EntryAddr} (e' : EntryAddr) (p : Nat) :
    let E' : EntryAddr := ⟨⟨e.heightPath ++ e'.col.path, e'.col.col⟩, e'.idx⟩
    (p < e.col.num 0 → E'.col.rep 0 p = e.col.rep 0 p) ∧
    (p = e.col.num 0 → E'.col.rep 0 p = some (.ord e.col, .slot e)) ∧
    (∀ v, p = e.col.num 0 + (v + 1) → E'.col.rep 0 p =
      (e'.col.rep 1 (v + 1)).map fun ov => (Role.under e.heightPath ov.1, Role.under e.heightPath ov.2)) := by
  intro E'
  have hd : e.heightPath <+: E'.col.path := List.prefix_append _ _
  obtain ⟨h1, h2, h3, -⟩ := rep_inside e E'.col hd
  refine ⟨h1 p, fun h => h ▸ h2, fun v hv => ?_⟩
  rw [hv, h3 (v + 1) (by omega)]
  simp only [E', relCol_under]

-- provides: U3, D7.1a (a free block of a column prefix of a height lies in the graph)
theorem freeBlock_graph {F : Forest} {e : EntryAddr} (he : e ∈ F.entryAddrs) (hV : Scan.CondV F)
    (m : Nat) :
    ∀ a ∈ freeBlock (relKey (e.col.num 0) (takeCols ((F.heightAt e).getD Tree.empty) m)),
      a.map (blockMap e) ∈ graph F := by
  obtain ⟨post, hr, -⟩ := Tree.roles_entry he
  have he' := he
  rw [Tree.mem_entryAddrs_iff] at he'
  obtain ⟨⟨p0, B⟩, hx⟩ := Option.isSome_iff_exists.1 he'
  have hB : F.heightAt e = some B := by simp [Tree.heightAt, hx]
  rw [hB, Option.getD_some] at hr ⊢
  have hslot : Role.slot e ∈ F.roles := by rw [hr]; simp
  have hKr : ∀ r, r ∈ (relKey (e.col.num 0) (takeCols B m)).roles → r.under e.heightPath ∈ F.roles :=
    fun r h => Tree.under_mem_roles hB ((takeCols_roles_prefix B m).mem (by rwa [relKey_roles] at h))
  intro a ha
  unfold freeBlock at ha
  simp only [List.mem_cons, List.mem_append, List.mem_map, List.mem_filterMap,
    List.mem_flatMap] at ha
  rw [mem_graph_iff]
  rcases ha with ((((rfl | ⟨r, hr', rfl⟩) | ⟨⟨x, y⟩, hxy, rfl⟩) | ⟨c, hc, hc'⟩) | ⟨e', he', ha⟩)
  · exact Or.inl ⟨_, hslot, rfl⟩
  · obtain ⟨r', hr'', rfl⟩ := hr'
    exact Or.inl ⟨_, hKr r' hr'', rfl⟩
  · -- order atoms: consecutive in `slot e :: K.roles.map (under hp)`, a segment of `F.roles`
    set rs := (relKey (e.col.num 0) (takeCols B m)).roles.map BlkVar.inner
    obtain ⟨i, hi⟩ := List.mem_iff_getElem?.1 hxy
    have hrs : rs = (BlkVar.owner :: rs).tail := rfl
    rw [hrs, List.getElem?_zip_eq_some, List.getElem?_tail] at hi
    have hM : (BlkVar.owner :: rs).map (blockMap e) =
        Role.slot e :: (takeCols B m).roles.map (Role.under e.heightPath) := by
      simp only [rs, List.map_cons, List.map_map, relKey_roles]
      rfl
    obtain ⟨X, hX⟩ := takeCols_roles_prefix B m
    have hF : F.roles = prefixRoles F e ++ ((BlkVar.owner :: rs).map (blockMap e) ++
        (X.map (Role.under e.heightPath) ++ post)) := by
      rw [hM, hr, ← hX]; simp
    have hget : ∀ k z, (BlkVar.owner :: rs)[k]? = some z →
        F.roles[(prefixRoles F e).length + k]? = some (blockMap e z) := by
      intro k z hz
      rw [hF, List.getElem?_append_right (by omega), Nat.add_sub_cancel_left,
        List.getElem?_append_left (by
          have := (List.getElem?_eq_some_iff.1 hz).1
          simpa using this), List.getElem?_map, hz]
      rfl
    refine Or.inr (Or.inl ⟨(prefixRoles F e).length + i, _, _, hget i x hi.1,
      by rw [show (prefixRoles F e).length + i + 1 = (prefixRoles F e).length + (i + 1) by omega];
         exact hget (i + 1) y hi.2, rfl⟩)
  · split_ifs at hc' with h
    cases hc'
    rw [Tree.mem_colAddrs_iff] at hc
    refine Or.inr (Or.inr (Or.inl ⟨⟨e.heightPath ++ c.path, c.col⟩, ?_, ?_, rfl⟩))
    · exact hKr (.ord c) (by rw [Tree.mem_roles_iff]; exact hc)
    · exact hKr (.ord ⟨c.path, c.col + 1⟩) (by rw [Tree.mem_roles_iff]; exact h)
  · rw [Tree.mem_entryAddrs_iff] at he'
    obtain ⟨⟨lab, hh⟩, hK⟩ := Option.isSome_iff_exists.1 he'
    obtain ⟨p, h₀, hE, hlab⟩ := key_entry hB m hK
    rw [hK] at ha
    obtain ⟨hlt, heq, hgt⟩ := inner_edges (e := e) e' p
    refine Or.inr (Or.inr (Or.inr ⟨⟨⟨e.heightPath ++ e'.col.path, e'.col.col⟩, e'.idx⟩, p, ?_⟩))
    rw [hE]
    by_cases hpa : p < e.col.num 0
    · rw [if_pos hpa] at hlab
      subst hlab
      obtain ⟨⟨o, v⟩, hov⟩ := Option.isSome_iff_exists.1 ((rep_isSome_iff e.col p).2 hpa)
      refine ⟨o, v, rfl, by rw [hlt hpa, hov], ?_⟩
      simp only [List.mem_cons, List.not_mem_nil, or_false] at ha
      rcases ha with rfl | rfl
      · left; simp [BaseAtom.map, blockMap, hov, Role.under]
      · right; simp [BaseAtom.map, blockMap, hov, Role.under]
    · rw [if_neg hpa] at hlab
      subst hlab
      obtain ⟨v, hv⟩ : ∃ v, p - e.col.num 0 = v := ⟨_, rfl⟩
      cases v with
      | zero =>
        rw [hv] at ha
        refine ⟨.ord e.col, .slot e, rfl, heq (by omega), ?_⟩
        simp only [List.mem_cons, List.not_mem_nil, or_false] at ha
        rcases ha with rfl | rfl
        · left; rfl
        · right; rfl
      | succ v =>
        rw [hv] at ha
        simp only at ha
        cases hr1 : e'.col.rep 1 (v + 1) with
        | none => rw [hr1] at ha; simp at ha
        | some ow =>
          obtain ⟨o, w⟩ := ow
          rw [hr1] at ha
          refine ⟨o.under e.heightPath, w.under e.heightPath, rfl,
            by rw [hgt v (by omega), hr1]; rfl, ?_⟩
          simp only [List.mem_cons, List.not_mem_nil, or_false] at ha
          rcases ha with rfl | rfl
          · left; rfl
          · right; rfl

-- provides: U3, D7.1a (the two heads of the positive block are the entry's own heads)
theorem posBlock_heads_graph {F : Forest} {e : EntryAddr} (he : e ∈ F.entryAddrs)
    (hV : Scan.CondV F) :
    ∀ a ∈ posBlock (relKey (e.col.num 0) ((F.heightAt e).getD Tree.empty))
        (((F.entryAt e).map Prod.fst).getD 0),
      a.map (blockMap e) ∈ graph F := by
  intro a ha
  unfold posBlock at ha
  rcases List.mem_append.1 ha with ha | ha
  · have := freeBlock_graph he hV ((F.heightAt e).getD Tree.empty).cols.length a
    rw [takeCols_length] at this
    exact this ha
  · have he' := he
    rw [Tree.mem_entryAddrs_iff] at he'
    obtain ⟨⟨p0, B⟩, hx⟩ := Option.isSome_iff_exists.1 he'
    have hres := hV e he p0 B hx
    obtain ⟨⟨o, v⟩, hov⟩ := Option.isSome_iff_exists.1
      ((rep_isSome_iff e.col p0).2 ((ColAddr.resolve_isSome_iff 0 e.col p0).1 hres).2)
    rw [hx] at ha
    rw [mem_graph_iff]
    refine Or.inr (Or.inr (Or.inr ⟨e, p0, o, v, by rw [hx]; rfl, hov, ?_⟩))
    simp only [Option.map_some, Option.getD_some, List.mem_cons, List.not_mem_nil, or_false] at ha
    rcases ha with rfl | rfl
    · left; simp [BaseAtom.map, blockMap, hov]
    · right; simp [BaseAtom.map, blockMap, hov]

-- provides: U3, D7.1a (converse: every atom owned by the slot of `e` or by a role inside its
-- height is the image of an atom of the positive block)
theorem graph_owned_block {F : Forest} {e : EntryAddr} (he : e ∈ F.entryAddrs) (hV : Scan.CondV F)
    (z : Role) (hz : z = .slot e ∨ e.heightPath <+: z.path) :
    ∀ a ∈ ownedBy (graph F) z, ∃ a₀ ∈ posBlock (relKey (e.col.num 0) ((F.heightAt e).getD Tree.empty))
      (((F.entryAt e).map Prod.fst).getD 0), a = a₀.map (blockMap e) := by
  have he' := he
  rw [Tree.mem_entryAddrs_iff] at he'
  obtain ⟨⟨p0, B⟩, hx⟩ := Option.isSome_iff_exists.1 he'
  have hB : F.heightAt e = some B := by simp [Tree.heightAt, hx]
  rw [hB, hx, Option.getD_some]
  simp only [Option.map_some, Option.getD_some]
  set K := relKey (e.col.num 0) B with hKdef
  have hKroles : K.roles = B.roles := relKey_roles _ _
  have hKcol : ∀ c, (K.colAt c).isSome = (B.colAt c).isSome := by
    intro c; rw [hKdef, relKey, Tree.colAt_map]; cases B.colAt c <;> rfl
  have hKent : ∀ e', K.entryAt e' = (B.entryAt e').map
      (fun x => (if x.1 < e.col.num 0 then (false, x.1) else (true, x.1 - e.col.num 0),
        relKey (e.col.num 0) x.2)) := by
    intro e'; rw [hKdef, relKey, Tree.entryAt_map]; rfl
  have hfree : ∀ a₀, a₀ ∈ freeBlock K → a₀ ∈ posBlock K p0 := fun a₀ h =>
    List.mem_append_left _ h
  intro a ha
  unfold ownedBy at ha
  rw [List.mem_filter, beq_iff_eq] at ha
  obtain ⟨ha, hown⟩ := ha
  rcases (mem_graph_iff F a).1 ha with ⟨x, hx', rfl⟩ | ⟨i, x, y, -, -, rfl⟩ | ⟨c, hc, hc', rfl⟩ |
    ⟨E', p, o, v, hp, hov, ha'⟩
  · simp only [atomOwner, Option.some.injEq] at hown
    subst hown
    rcases hz with rfl | hz
    · exact ⟨.lim .owner, hfree _ (by unfold freeBlock; simp), rfl⟩
    · obtain ⟨r, hr, rfl⟩ := List.mem_map.1 (Tree.mem_height_of_prefix hx hx' hz)
      refine ⟨.lim (.inner r), hfree _ ?_, rfl⟩
      unfold freeBlock
      simp only [List.mem_cons, List.mem_append, List.mem_map]
      exact Or.inl (Or.inl (Or.inl (Or.inr ⟨_, ⟨r, by rw [hKroles]; exact hr, rfl⟩, rfl⟩)))
  · simp [atomOwner] at hown
  · simp only [atomOwner, Option.some.injEq] at hown
    subst hown
    rcases hz with h | hz
    · cases h
    · obtain ⟨τ, hτ⟩ := hz
      simp only [Role.path] at hτ
      obtain ⟨cp, cc⟩ := c
      simp only at hτ hc hc' ⊢
      subst hτ
      rw [Tree.mem_roles_iff] at hc hc'
      change (F.colAt ⟨e.heightPath ++ τ, cc⟩).isSome at hc
      change (F.colAt ⟨e.heightPath ++ τ, cc + 1⟩).isSome at hc'
      rw [Tree.colAt_under hB] at hc hc'
      refine ⟨.elem (.inner (.ord ⟨τ, cc⟩)) (.inner (.ord ⟨τ, cc + 1⟩)), hfree _ ?_, rfl⟩
      unfold freeBlock
      simp only [List.mem_cons, List.mem_append, List.mem_filterMap]
      refine Or.inl (Or.inr ⟨⟨τ, cc⟩, ?_, ?_⟩)
      · rw [Tree.mem_colAddrs_iff, hKcol]; exact hc
      · rw [if_pos (by rw [hKcol]; exact hc')]
  · have hown' : z = .slot E' := by
      rcases ha' with rfl | rfl <;> simpa [atomOwner] using hown.symm
    subst hown'
    obtain ⟨⟨p', H'⟩, hE', rfl⟩ := Option.map_eq_some_iff.1 hp
    rcases hz with h | hz
    · cases h
      rw [hx] at hE'
      cases hE'
      simp only at hov
      rcases ha' with rfl | rfl
      · exact ⟨.edge .owner .host (.ord p0), List.mem_append_right _ (List.mem_cons_self ..),
          by simp [BaseAtom.map, blockMap, hov]⟩
      · exact ⟨.edge .owner .host (.cur p0),
          List.mem_append_right _ (List.mem_cons_of_mem _ (List.mem_cons_self ..)),
          by simp [BaseAtom.map, blockMap, hov]⟩
    · obtain ⟨τ, hτ⟩ := hz
      obtain ⟨⟨Ep, cc⟩, ii⟩ := E'
      simp only [Role.path] at hτ
      subst hτ
      have hBe : B.entryAt ⟨⟨τ, cc⟩, ii⟩ = some (p', H') := by
        rw [← Tree.entryAt_under hB]; exact hE'
      have hKe := hKent ⟨⟨τ, cc⟩, ii⟩
      rw [hBe] at hKe
      simp only [Option.map_some] at hKe
      have hmem : (⟨⟨τ, cc⟩, ii⟩ : EntryAddr) ∈ K.entryAddrs := by
        rw [Tree.mem_entryAddrs_iff, hKe]; rfl
      obtain ⟨hlt, heq, hgt⟩ := inner_edges (e := e) ⟨⟨τ, cc⟩, ii⟩ p'
      simp only at hlt heq hgt hov
      have hfb : ∀ a₀, (a₀ ∈ (match K.entryAt ⟨⟨τ, cc⟩, ii⟩ with
          | some ((false, q), _) => [BaseAtom.edge (BlkVar.inner (.slot ⟨⟨τ, cc⟩, ii⟩))
              (BlkVar.inner (.ord ⟨τ, cc⟩)) (.ord q), BaseAtom.edge (BlkVar.inner (.slot ⟨⟨τ, cc⟩, ii⟩))
              (BlkVar.inner (.ord ⟨τ, cc⟩)) (.cur q)]
          | some ((true, 0), _) => [BaseAtom.edge (BlkVar.inner (.slot ⟨⟨τ, cc⟩, ii⟩))
              (BlkVar.inner (.ord ⟨τ, cc⟩)) .host, BaseAtom.edge (BlkVar.inner (.slot ⟨⟨τ, cc⟩, ii⟩))
              (BlkVar.inner (.ord ⟨τ, cc⟩)) .owner]
          | some ((true, v + 1), _) =>
            match (ColAddr.mk τ cc).rep 1 (v + 1) with
            | some (o, w) => [BaseAtom.edge (BlkVar.inner (.slot ⟨⟨τ, cc⟩, ii⟩))
                (BlkVar.inner (.ord ⟨τ, cc⟩)) (.inner o), BaseAtom.edge (BlkVar.inner (.slot ⟨⟨τ, cc⟩, ii⟩))
                (BlkVar.inner (.ord ⟨τ, cc⟩)) (.inner w)]
            | none => []
          | none => [] : List (BaseAtom BlkVar))) → a₀ ∈ posBlock K p0 := by
        intro a₀ ha₀
        apply hfree
        unfold freeBlock
        simp only [List.mem_cons, List.mem_append, List.mem_flatMap]
        exact Or.inr ⟨_, hmem, ha₀⟩
      by_cases hpa : p' < e.col.num 0
      · rw [if_pos hpa] at hKe
        rw [hlt hpa] at hov
        rcases ha' with rfl | rfl
        · exact ⟨_, hfb _ (by simp only [hKe]; exact List.mem_cons_self ..),
            by simp [BaseAtom.map, blockMap, Role.under, hov]⟩
        · exact ⟨_, hfb _ (by simp only [hKe]; exact List.mem_cons_of_mem _ (List.mem_cons_self ..)),
            by simp [BaseAtom.map, blockMap, Role.under, hov]⟩
      · rw [if_neg hpa] at hKe
        obtain ⟨w, hw⟩ : ∃ w, p' - e.col.num 0 = w := ⟨_, rfl⟩
        cases w with
        | zero =>
          rw [hw] at hKe
          rw [heq (by omega)] at hov
          simp only [Option.some.injEq, Prod.mk.injEq] at hov
          obtain ⟨rfl, rfl⟩ := hov
          rcases ha' with rfl | rfl
          · exact ⟨_, hfb _ (by simp only [hKe]; exact List.mem_cons_self ..),
              by simp [BaseAtom.map, blockMap, Role.under]⟩
          · exact ⟨_, hfb _ (by simp only [hKe]; exact List.mem_cons_of_mem _ (List.mem_cons_self ..)),
              by simp [BaseAtom.map, blockMap, Role.under]⟩
        | succ w =>
          rw [hw] at hKe
          rw [hgt w (by omega)] at hov
          obtain ⟨⟨o₁, v₁⟩, hr1, hov'⟩ := Option.map_eq_some_iff.1 hov
          simp only [Prod.mk.injEq] at hov'
          obtain ⟨rfl, rfl⟩ := hov'
          rcases ha' with rfl | rfl
          · exact ⟨_, hfb _ (by simp only [hKe, hr1]; exact List.mem_cons_self ..),
              by simp [BaseAtom.map, blockMap, Role.under]⟩
          · exact ⟨_, hfb _ (by simp only [hKe, hr1]; exact List.mem_cons_of_mem _ (List.mem_cons_self ..)),
              by simp [BaseAtom.map, blockMap, Role.under]⟩

/-! ## N3.1  Finite-name amalgamation and packing (S-6) -/

-- provides: U3, N3.1
theorem _root_.BTBMS.Hier.BaseAtom.holds_map {V W : Type} (P : Prims.{u}) (f : V → W) (a : W → Ordinal.{u})
    (x : BaseAtom V) : (x.map f).Holds P a ↔ x.Holds P (a ∘ f) := by
  cases x <;> rfl

-- provides: U3, N3.1
theorem _root_.BTBMS.Hier.baseHolds_map {V W : Type} (P : Prims.{u}) (f : V → W) (D : List (BaseAtom V))
    (a : W → Ordinal.{u}) : BaseHolds P (D.map (BaseAtom.map f)) a ↔ BaseHolds P D (a ∘ f) := by
  unfold BaseHolds
  simp only [List.forall_mem_map, BaseAtom.holds_map]

-- provides: U3, N3.1
theorem _root_.BTBMS.Hier.Diagram.holds_append {V : Type} (P : Prims.{u}) (a : V → Ordinal.{u})
    (D₁ D₂ : Diagram V) : (D₁ ++ D₂).Holds P a ↔ D₁.Holds P a ∧ D₂.Holds P a := by
  unfold Diagram.Holds
  exact List.forall_mem_append

-- provides: U3, N3.1
theorem _root_.BTBMS.Hier.Diagram.holds_map {V W : Type} (P : Prims.{u}) (f : V → W) (a : W → Ordinal.{u})
    (D : Diagram V) : (D.map f).Holds P a ↔ D.Holds P (a ∘ f) := by
  unfold Diagram.Holds Diagram.map
  simp only [List.forall_mem_map]
  apply forall_congr'; intro x; apply imp_congr_right; intro _
  cases x with
  | base b => exact BaseAtom.holds_map P f a b
  | noReal D fr u L =>
    simp only [Atom.map, Atom.Holds, Option.map_map]
    rfl

/-- N3.1 helper: a base atom reads only its variables. -/
theorem amalg_baseAtom_congr {V : Type} (P : Prims.{u}) {a a' : V → Ordinal.{u}}
    (x : BaseAtom V) (h : ∀ v ∈ x.vars, a v = a' v) : x.Holds P a ↔ x.Holds P a' := by
  cases x <;> simp_all [BaseAtom.vars, BaseAtom.Holds]

theorem amalg_baseHolds_congr {V : Type} (P : Prims.{u}) {a a' : V → Ordinal.{u}}
    (D : List (BaseAtom V)) (h : ∀ v ∈ baseVars D, a v = a' v) : BaseHolds P D a ↔ BaseHolds P D a' := by
  unfold BaseHolds
  apply forall_congr'; intro x; apply imp_congr_right; intro hx
  exact amalg_baseAtom_congr P x fun v hv => h v (List.mem_flatMap.2 ⟨x, hx, hv⟩)

/-- N3.1 helper: `BlockAbove` reads the frame only on the variables of the block. -/
theorem amalg_blockAbove_congr {W : Type} (P : Prims.{u}) (D : List (BaseAtom W))
    {fr fr' : W → Option Ordinal.{u}} (hfr : ∀ x ∈ baseVars D, fr x = fr' x) (L w : Ordinal.{u}) :
    BlockAbove P D fr L w → BlockAbove P D fr' L w := by
  classical
  rintro ⟨β, h1, h2, h3, h4⟩
  refine ⟨fun x => if x ∈ baseVars D then β x else (fr' x).getD 0, ?_, ?_, ?_, ?_⟩
  · intro x o hx
    by_cases hm : x ∈ baseVars D
    · simp only [if_pos hm]; exact h1 x o (by rw [hfr x hm]; exact hx)
    · simp only [if_neg hm, hx]; rfl
  · intro x hx hn
    simp only [if_pos hx]; exact h2 x hx (by rw [hfr x hx]; exact hn)
  · intro x hx
    simp only [if_pos hx]; exact h3 x hx
  · exact (amalg_baseHolds_congr P D fun v hv => by simp only [if_pos hv]).1 h4

/-- N3.1 helper: an atom reads only its variables. -/
theorem amalg_atom_congr {V : Type} (P : Prims.{u}) {a a' : V → Ordinal.{u}}
    (x : Atom V) (h : ∀ v ∈ x.vars, a v = a' v) : x.Holds P a ↔ x.Holds P a' := by
  cases x with
  | base b => exact amalg_baseAtom_congr P b h
  | noReal D fr u L =>
    simp only [Atom.vars, List.mem_cons, forall_eq_or_imp] at h
    obtain ⟨hu, hL, hr⟩ := h
    simp only [Atom.Holds, hu, hL]
    have hfr : ∀ x ∈ baseVars D, (fr x).map a = (fr x).map a' := by
      intro x hx
      cases hf : fr x with
      | none => rfl
      | some v => simp [hr v (List.mem_filterMap.2 ⟨x, hx, hf⟩)]
    exact not_congr ⟨amalg_blockAbove_congr P D hfr _ _,
      amalg_blockAbove_congr P D (fun x hx => (hfr x hx).symm) _ _⟩

-- provides: U3, N3.1
theorem _root_.BTBMS.Hier.Diagram.amalgamate {V : Type} [DecidableEq V] (P : Prims.{u}) (D₁ D₂ : Diagram V)
    (a₁ a₂ : V → Ordinal.{u}) (h₁ : D₁.Holds P a₁) (h₂ : D₂.Holds P a₂)
    (hshare : ∀ x ∈ D₁.vars, x ∈ D₂.vars → a₁ x = a₂ x) :
    (D₁ ++ D₂).Holds P (fun x => if x ∈ D₁.vars then a₁ x else a₂ x) := by
  rw [Diagram.holds_append]
  constructor
  · intro x hx
    refine (amalg_atom_congr P x fun v hv => ?_).2 (h₁ x hx)
    have : v ∈ D₁.vars := List.mem_flatMap.2 ⟨x, hx, hv⟩
    simp [this]
  · intro x hx
    refine (amalg_atom_congr P x fun v hv => ?_).2 (h₂ x hx)
    have : v ∈ D₂.vars := List.mem_flatMap.2 ⟨x, hx, hv⟩
    by_cases h : v ∈ D₁.vars
    · simp [h, hshare v h this]
    · simp [h]

/-- N3.1 helper: facts about `foldr max`. -/
theorem foldr_max_spec {L : Ordinal.{u}} :
    ∀ l : List Ordinal.{u}, L ≤ l.foldr max L ∧ ∀ x ∈ l, x ≤ l.foldr max L
  | [] => ⟨le_rfl, by simp⟩
  | y :: l => by
    obtain ⟨h1, h2⟩ := foldr_max_spec (L := L) l
    refine ⟨h1.trans (le_max_right _ _), fun x hx => ?_⟩
    rcases List.mem_cons.1 hx with rfl | hx
    · exact le_max_left _ _
    · exact (h2 x hx).trans (le_max_right _ _)

theorem foldr_max_lt {L θ : Ordinal.{u}} (hL : L < θ) :
    ∀ l : List Ordinal.{u}, (∀ x ∈ l, x < θ) → l.foldr max L < θ
  | [], _ => hL
  | y :: l, hl => max_lt (hl y (List.mem_cons_self ..))
      (foldr_max_lt hL l fun x hx => hl x (List.mem_cons_of_mem _ hx))

-- provides: U3, N3.1 (finitely many coordinates below a limit fit below one stage above a floor)
theorem pack_below {u' L : Ordinal.{u}} (hu : IsLim u') (hL : L < u') (l : List Ordinal.{u})
    (hl : ∀ x ∈ l, x < u') : ∃ β, L ≤ β ∧ β < u' ∧ ∀ x ∈ l, x < β := by
  obtain ⟨hLm, hm⟩ := foldr_max_spec (L := L) l
  refine ⟨Order.succ (l.foldr max L), hLm.trans (Order.le_succ _),
    hu.1.succ_lt (foldr_max_lt hL l hl), fun x hx => ?_⟩
  exact Order.lt_succ_iff.2 (hm x hx)

/-! ## D4.1b  Facts about admitted records -/

-- provides: U3, D4.1b (source host at most target host; equal exactly for repair records)
theorem admitted_hosts {rk : SrcRecord} (h : rk.Admitted) :
    rk.a.col.num 0 ≤ rk.b.col.num 0 ∧
    (∀ ms, rk.kind = .repair ms → rk.a.col.num 0 = rk.b.col.num 0) ∧
    (∀ cap i j, (rk.kind = .scan cap i j ∨ rk.kind = .desc cap i j) →
      rk.a.col.num 0 < rk.b.col.num 0) := by sorry

-- provides: U3, D4.1b (both marked heights are nonempty or the target is empty)
theorem admitted_src_ne {rk : SrcRecord} (h : rk.Admitted) : rk.srcHeight ≠ Tree.empty := by sorry

/-! ## L4.2  First differences: the classifier, κ-transfer, path transfer, cap legality -/

-- SCR2 applied at integration: the bridge holds by `rfl`
theorem firstDiff_eq_def (rk : SrcRecord) : rk.firstDiff = firstDiffDef rk := by sorry

/-- L4.2: the part of a tree strictly before a position: the containing structure along `π`,
the columns `0 … j-1` of the forest at `π`, and (if `k = some k'`) the first `k'` entries of
column `j`. -/
def cutBefore {α : Type} : List (Nat × Nat) → Nat → Option Nat → Tree α → Tree α
  | [], j, none, .node cols => .node (cols.take j)
  | [], j, some k, .node cols => .node (cols.take j ++ [((cols[j]?).getD []).take k])
  | (ci, ii) :: rest, j, k, .node cols =>
    match cols[ci]? with
    | some col =>
      match col[ii]? with
      | some (l, h) => .node (cols.take ci ++ [col.take ii ++ [(l, cutBefore rest j k h)]])
      | none => .node cols
    | none => .node cols

-- provides: U3, L4.2 (meaning of the classifier)
theorem firstDiff_spec {rk : SrcRecord} (h : rk.Admitted) :
    (rk.firstDiff = .wholeEnds →
      rk.tgtKey.cols <+: rk.srcKey.cols ∧ rk.tgtKey.cols.length < rk.srcKey.cols.length) ∧
    (∀ π, rk.firstDiff = .childEnds π → ∃ ρ X Y, π = rk.b.heightPath ++ ρ ∧ ρ ≠ [] ∧
      rk.tgtKey.forestAt ρ = some X ∧ rk.srcKey.forestAt ρ = some Y ∧
      X.cols.length < Y.cols.length ∧
      cutBefore ρ X.cols.length none rk.tgtKey = cutBefore ρ X.cols.length none rk.srcKey) ∧
    (∀ c k p, rk.firstDiff = .capAt c k p → ∃ ρ, c.path = rk.b.heightPath ++ ρ ∧
      cutBefore ρ c.col (some k) rk.tgtKey = cutBefore ρ c.col (some k) rk.srcKey ∧
      (rk.tgtKey.colAt ⟨ρ, c.col⟩).isSome ∧
      ((rk.tgtKey.entryAt ⟨⟨ρ, c.col⟩, k⟩ = none ∧ ∃ l hs, rk.srcKey.entryAt ⟨⟨ρ, c.col⟩, k⟩ = some (l, hs) ∧
          p = labelAbs (rk.b.col.num 0) l) ∨
       (∃ l₁ h₁ l₂ h₂, rk.tgtKey.entryAt ⟨⟨ρ, c.col⟩, k⟩ = some (l₁, h₁) ∧
          rk.srcKey.entryAt ⟨⟨ρ, c.col⟩, k⟩ = some (l₂, h₂) ∧ keyLabelCmp l₁ l₂ = .lt ∧
          p = labelAbs (rk.b.col.num 0) l₂))) := by sorry

/-- L4.2a: the label map `κ` from source normalization (threshold `≥ r`) to target normalization
(threshold shifted by `t - r`): false fields below `r` are fixed, other false fields move by
`t - r`, true fields are fixed. -/
def kappa (r t : Nat) : Bool × Nat → Bool × Nat
  | (false, q) => if q < r then (false, q) else (false, q + (t - r))
  | (true, v) => (true, v)

-- provides: U3, L4.2a (`κ` is an order embedding of labels)
theorem kappa_cmp {r t : Nat} (h : r ≤ t) (x y : Bool × Nat) :
    keyLabelCmp (kappa r t x) (kappa r t y) = keyLabelCmp x y := by sorry

-- provides: U3, L4.2a (an order embedding of labels is an order embedding of keys)
theorem keyCmp_map {f : Bool × Nat → Bool × Nat} (hf : ∀ x y, keyLabelCmp (f x) (f y) = keyLabelCmp x y)
    (K K' : Key) : keyCmp (K.map f) (K'.map f) = keyCmp K K' := by sorry

-- provides: U3, L4.2a (common relative syntax: κ carries source keys to target keys)
theorem relKey_kappa {r t s : Nat} {X Y : Forest} (hrt : r ≤ t) (hrs : r ≤ s)
    (h : relKey r X = relKey t Y) : (relKey s X).map (kappa r t) = relKey (s + (t - r)) Y := by
  sorry

-- provides: U3, L4.2a (κ fixes keys normalized at or below `r`)
theorem relKey_kappa_low {r t s : Nat} (hsr : s ≤ r) (X : Forest) :
    (relKey s X).map (kappa r t) = relKey s X := by sorry

/-- L4.2b: the key list of a column cut after entry `u` with key `u` raised to `⊤`. -/
def cappedAt (ks : List (WithTop Key)) (u : Nat) : List (WithTop Key) := ks.take u ++ [⊤]

-- provides: U3, L4.2b (a capped same-parent block answers like one capped entry; txt:680-681)
theorem capped_block_resp (pre blk : List (WithTop Key)) (ppre : List Nat) (p : Nat)
    (W : List (WithTop Key)) (hW : ∀ y ∈ W, y ≠ ⊤) (hlen : ppre.length = pre.length) :
    (ppre ++ List.replicate (blk.length + 1) p)[Scan.cursor (pre ++ blk ++ [⊤]) W]? =
      (ppre ++ [p])[Scan.cursor (pre ++ [⊤]) W]? := by sorry

-- provides: U3, L4.2b (raising an unconsumed key and restoring later entries; txt:675-676)
theorem cursor_raise (pre : List (WithTop Key)) (x x' : WithTop Key) (post W : List (WithTop Key))
    (hxx' : x ≤ x') (hc : Scan.cursor (pre ++ [x]) W ≤ pre.length) :
    Scan.cursor (pre ++ x' :: post) W = Scan.cursor (pre ++ [x]) W := by sorry

-- provides: U3, L4.2c (path transfer: the new parent is on the target's actual cut chain)
theorem firstDiff_path {rk : SrcRecord} (h : rk.Admitted) {c : ColAddr} {k p : Nat}
    (hfd : rk.firstDiff = .capAt c k p) :
    Scan.Path rk.E (Scan.actualKeys rk.E) c (Scan.cutQuery (Scan.actualKeys rk.E c) k)
      (Scan.cutStart rk.E c k) p := by sorry

-- provides: U3, L4.2d (an upward literal cap on the actual cut chain is an ordinary V,I,S cap
-- with decorated A)
theorem cap_legal {E : Forest} (hE : IsStd E) {c : ColAddr} {k p : Nat} (hc : c ∈ E.colAddrs)
    (hdepth : c.path ≠ []) (hup : Closure.IsUpward E c k p)
    (hpath : Scan.Path E (Scan.actualKeys E) c (Scan.cutQuery (Scan.actualKeys E c) k)
      (Scan.cutStart E c k) p) :
    let K := Closure.litCap E c k p
    Scan.CondV K ∧ Scan.CondI K ∧ Scan.CondS K ∧
    Scan.CondAK K (Scan.capKeys K (Scan.routeCols K)) ∧ Scan.stepKind K = some .ordinary := by
  sorry

-- provides: U3, L4.2 (the spine's `firstDiff_cap`†; consumer: U5 L8.8 Case 3)
theorem firstDiff_cap {rk : SrcRecord} (h : rk.Admitted) {c : ColAddr} {k p : Nat}
    (hfd : rk.firstDiff = .capAt c k p) :
    let K := Closure.litCap rk.E c k p
    rk.b.heightPath <+: c.path ∧ c ∈ rk.E.colAddrs ∧ Closure.IsUpward rk.E c k p ∧
    Scan.CondV K ∧ Scan.CondI K ∧ Scan.CondS K ∧
    Scan.CondAK K (Scan.capKeys K (Scan.routeCols K)) ∧
    Scan.stepKind K = some .ordinary ∧
    Scan.Path rk.E (Scan.actualKeys rk.E) c (Scan.cutQuery (Scan.actualKeys rk.E c) k)
      (Scan.cutStart rk.E c k) p := by sorry

/-! ## L4.3  Source reduction -/

/-- L4.3a: an operation of `F` is confined to the marked height of `a`: the stopping column lies
inside that height and, for a special step, so does the owner entry (X-04). -/
def Confined (F : Forest) (a : EntryAddr) : Prop :=
  ∃ sd, Scan.stopData F = some sd ∧ a.heightPath <+: sd.col.path ∧
    (Scan.stepKind F = some .special → ∃ e, sd.ownerEntry = some e ∧ a.heightPath <+: e.col.path)

-- provides: U3, L4.3a (a confined operation only replaces the marked height, and decreases it)
theorem expand_confined {F F' : Forest} {a : EntryAddr} {k : Nat} (hF : Scan.InL F)
    (ha : a ∈ F.entryAddrs) (htr : F.truncAfter a = F) (hc : Confined F a)
    (hexp : expand F k = some F') :
    ∃ A'', F' = F.setHeight a A'' ∧ A'' < (F.heightAt a).getD Tree.empty := by sorry

-- provides: U3, L4.3a (a safe prefix cutting inside the marked height)
theorem safePrefix_inside {F : Forest} {a : EntryAddr} (ha : a ∈ F.entryAddrs)
    (htr : F.truncAfter a = F) {k : Nat}
    (hk : Scan.mu (F.setHeight a Tree.empty) ≤ k) :
    ∃ A'', Scan.safePrefix F k = F.setHeight a A'' ∧ A'' ≤ (F.heightAt a).getD Tree.empty := by
  sorry

/-- L4.3: scan records become descendant records after a source reduction. -/
def RecKind.toDesc {E : Forest} : RecKind E → RecKind E
  | .scan cap i j => .desc cap i j
  | k => k

-- provides: U3, L4.3 (the spine's `reduce_confined`†; consumers: U5 L8.8 Case 2, W)
theorem reduce_confined {rk : SrcRecord} (h : rk.Admitted) {A'' : Forest}
    (hle : A'' ≤ rk.srcHeight) (hL : Scan.InL (rk.F.setHeight rk.a A''))
    (hlt : rk.tgtKey < relKey (rk.a.col.num 0) A'') :
    ({ rk with F := rk.F.setHeight rk.a A'', kind := rk.kind.toDesc } : SrcRecord).Admitted := by
  sorry

-- provides: U3, L4.3c (the internal cap already satisfies H, so repairs are outside `B`)
theorem repair_moves_outside {rk : SrcRecord} (h : rk.Admitted) {c : ColAddr} {k p : Nat}
    (hfd : rk.firstDiff = .capAt c k p) (w : Closure.AdmCap rk.E)
    (hw : w.col = c ∧ w.cut = k ∧ w.par = p) : Closure.MovesOutside w.moves rk.b := by sorry

-- provides: U3, L4.3b ((6): the old target at the moved address is at least `B`)
-- [Changed in verification] adds the literal-cap form of the repaired cap (item 1), which
-- `repair_output` and `repair_output_exists` use.
theorem marked_height_mono {rk : SrcRecord} (h : rk.Admitted) {c : ColAddr} {k p : Nat}
    (hfd : rk.firstDiff = .capAt c k p) (w : Closure.AdmCap rk.E)
    (hw : w.col = c ∧ w.cut = k ∧ w.par = p) :
    let bm := Closure.moveAddr w.moves rk.b
    let c' : ColAddr := ⟨bm.heightPath ++ c.path.drop rk.b.heightPath.length, c.col⟩
    (w.H = Closure.litCap rk.E c' k p ∧ Closure.IsUpward rk.E c' k p ∧
      bm.col.num 0 = rk.b.col.num 0) ∧
    bm ∈ rk.E.entryAddrs ∧
    rk.tgtHeight ≤ (rk.E.heightAt bm).getD Tree.empty := by sorry

-- provides: U3, L4.3 (the spine's `repair_output`†; consumer: U5 L8.8 Case 3)
theorem repair_output {rk : SrcRecord} (h : rk.Admitted) {c : ColAddr} {k p : Nat}
    (hfd : rk.firstDiff = .capAt c k p) (w : Closure.AdmCap rk.E)
    (hw : w.col = c ∧ w.cut = k ∧ w.par = p) {n : Nat} {Hk : Forest}
    (hexp : expand w.H n = some Hk) (habove : rk.E < Hk) :
    let bm := Closure.moveAddr w.moves rk.b
    bm ∈ Hk.entryAddrs ∧ Hk.truncAfter bm = Hk ∧
    (rk.E.heightAt bm).getD Tree.empty < (Hk.heightAt bm).getD Tree.empty ∧
    rk.tgtHeight < (Hk.heightAt bm).getD Tree.empty ∧
    ({ E := rk.E, b := rk.b, F := Hk.truncAfter bm, a := bm, kind := .repair w.moves } :
      SrcRecord).Admitted := by
  sorry

-- provides: U3, L4.3 (cofinality supplies a positive output above `E`)
theorem repair_output_exists {rk : SrcRecord} (h : rk.Admitted) {c : ColAddr} {k p : Nat}
    (hfd : rk.firstDiff = .capAt c k p) (w : Closure.AdmCap rk.E)
    (hw : w.col = c ∧ w.cut = k ∧ w.par = p) :
    ∃ n Hk, 1 ≤ n ∧ expand w.H n = some Hk ∧ rk.E < Hk := by sorry

-- provides: U3, L4.3 (the spine's `query_size_bound`†, (7); consumer: U5 L8.8 Case 3)
theorem query_size_bound {rk : SrcRecord} (h : rk.Admitted) {c : ColAddr} {k p : Nat}
    (hfd : rk.firstDiff = .capAt c k p) (w : Closure.AdmCap rk.E)
    (hw : w.col = c ∧ w.cut = k ∧ w.par = p) {sd : Scan.StopData}
    (hsd : Scan.stopData w.H = some sd) :
    sd.Q.length = k ∧
    (∀ j < sd.Q.length,
      w.origin (.slot ⟨sd.col, j⟩) = some (.slot ⟨c, j⟩) ∧
      rk.b.heightPath <+: c.path ∧ (rk.E.heightAt ⟨c, j⟩) = (sd.Q[j]?).map Prod.snd) ∧
    ∀ J ∈ sd.Q, J.2.size + 2 ≤ rk.tgtHeight.size := by sorry

-- provides: U3, L4.3 (the spine's `reduce_childEnds`†; consumer: U5 L8.8 Case 2)
theorem reduce_childEnds {rk : SrcRecord} (h : rk.Admitted) {π : List (Nat × Nat)}
    (hfd : rk.firstDiff = .childEnds π) :
    ∃ A₁ : Forest,
      Scan.InL (rk.F.setHeight rk.a A₁) ∧ A₁ ≤ rk.srcHeight ∧ rk.tgtKey < relKey (rk.a.col.num 0) A₁ ∧
      (rk.F.setHeight rk.a A₁).roles <+: rk.F.roles ∧
      (∀ x ∈ graph (rk.F.setHeight rk.a A₁), x ∈ graph rk.F) ∧
      Confined (rk.F.setHeight rk.a A₁) rk.a ∧
      ((Scan.stepKind (rk.F.setHeight rk.a A₁) = some .special) ∨
        (Scan.stepKind (rk.F.setHeight rk.a A₁) = some .ordinary ∧
          ∃ sd rd, Scan.stopData (rk.F.setHeight rk.a A₁) = some sd ∧ sd.Q = [] ∧
            Scan.rootData (rk.F.setHeight rk.a A₁) = some rd ∧ rk.a.heightPath <+: rd.col.path)) ∧
      ∃ (k : Nat) (A₂ : Forest),
        expand (rk.F.setHeight rk.a A₁) k = some (rk.F.setHeight rk.a A₂) ∧
        rk.tgtKey < relKey (rk.a.col.num 0) A₂ ∧ A₂ < rk.srcHeight ∧
        ({ rk with F := rk.F.setHeight rk.a A₂, kind := rk.kind.toDesc } : SrcRecord).Admitted := by
  sorry

/-! ## D7.2c  Fresh names -/

/-- D7.2c: the instance tag of a name (`0` for auxiliary names). -/
def tagOf : Name → Nat
  | .role t _ => t
  | .aux _ => 0

/-- D7.2c: a tag above every tag of a finite list of names. -/
def freshTag (ns : List Name) : Nat := (ns.map tagOf).foldr max 0 + 1

-- provides: U3, D7.2c
theorem freshTag_fresh (ns : List Name) (r : Role) : Name.role (freshTag ns) r ∉ ns := by sorry

/-! ## L7.3  Factorization -/

-- L7.3: the spine's `factorization` (SCR1 applied at integration: hypothesis `ha` added);
-- the former local workaround `factorization_mem` is removed.

-- provides: U3, L7.3b (the converse direction: a target block gives a realization of the
-- positive block above the floor)
theorem targetAbove_blockAbove {P : Prims.{u}} (pk : SourcePacket.{u}) {L : Ordinal.{u}}
    (h : pk.TargetAbove P L) :
    BlockAbove P (posBlock pk.rk.tgtKey pk.rk.tgtSel)
      (fun w => (pk.tgtFrame.toFr w).map pk.asg) L (pk.asg pk.owner) := by sorry

-- provides: U3, L7.3a ((23): the failure label in the grammar; consumer: U5 L8.8)
theorem factorization_noB {P : Prims.{u}} (pk : SourcePacket.{u}) (hv : pk.Valid P)
    (ha : pk.rk.a ∈ pk.rk.F.entryAddrs) {L : Ordinal.{u}} (hL : L < pk.asg pk.owner)
    (hfail : ¬ pk.TargetAbove P L) (ℓ : Name) (hℓ : ℓ ≠ pk.owner)
    (hℓf : ℓ ∉ (baseVars (posBlock pk.rk.tgtKey pk.rk.tgtSel)).filterMap pk.tgtFrame.toFr) :
    ∃ Ls, L ≤ Ls ∧ Ls < pk.asg pk.owner ∧ (∀ x ∈ pk.lowNames, pk.asg x < Ls) ∧
      (noB pk.rk.tgtKey pk.rk.tgtSel pk.tgtFrame pk.owner ℓ).Holds P
        (Function.update pk.asg ℓ Ls) := by sorry

/-! ## L7.4  Joint cap -/

/-- L7.4: the chart `κ` of the first-difference cap: the target prefix chart before `U_b`, and the
source chart of the corresponding source role (through `b ↦ a`) from `U_b` on (owner, common
internal prefix, closing slot). -/
def capChart (pk : SourcePacket.{u}) (y : Role) : Name :=
  if y ∈ prefixRoles pk.rk.E pk.rk.b then pk.tgtChart y
  else pk.srcChart (transEntry pk.rk.b pk.rk.a y)

-- provides: U3, L7.4 (the spine's `joint_cap`†; consumer: U5 L8.8 Case 3)
theorem joint_cap {P : Prims.{u}} (pk : SourcePacket.{u}) (hadm : pk.rk.Admitted) (hv : pk.Valid P)
    {c : ColAddr} {k p : Nat} (hfd : pk.rk.firstDiff = .capAt c k p) :
    let K := Closure.litCap pk.rk.E c k p
    let κ := capChart pk
    IsConfig P K (pk.asg ∘ κ) ∧
    (∀ y ∈ prefixRoles pk.rk.E pk.rk.b, κ y = pk.tgtChart y) ∧ κ (.slot pk.rk.b) = pk.owner ∧
    (∀ y ∈ K.roles, y ∉ prefixRoles pk.rk.E pk.rk.b →
      κ y = pk.srcChart (transEntry pk.rk.b pk.rk.a y)) ∧
    pk.asg pk.owner < pk.asg (κ (.ord c)) ∧ pk.asg (κ (.ord c)) < pk.asg (κ (.slot ⟨c, k⟩)) ∧
    (∀ y ∈ rolesBefore K (.ord c), pk.asg (κ y) < pk.asg (κ (.ord c))) ∧
    (∀ x ∈ pk.lowNames, pk.asg x < pk.asg (κ (.ord c))) ∧
    BaseHolds P ((restrictTo (graph pk.rk.E) (rolesBefore pk.rk.E (.ord c))).map (BaseAtom.map κ))
      pk.asg := by sorry

/-! ## L7.5  Joint repair, frame survival, readmission (closure of the packet class) -/

/-- L7.5: the roles of the repaired cap read in the literal cap: the origin in `E` (same address
in `litCap`), and the closing slot `⟨c, k⟩` for the appended closing entry. -/
def capRole {E : Forest} (w : Closure.AdmCap E) (x : Role) : Role :=
  (w.origin x).getD (.slot ⟨w.col, w.cut⟩)

-- provides: U3, L7.5a (the whole external frame survives same-parent repairs)
theorem frame_repair {E : Forest} (hE : IsStd E) (w : Closure.AdmCap E) {b : EntryAddr}
    (hb : b ∈ E.entryAddrs) (hbc : b.heightPath <+: w.col.path)
    (hout : Closure.MovesOutside w.moves b) :
    let bm := Closure.moveAddr w.moves b
    (frameOf bm).map (capRole w) = frameOf b ∧ capRole w (.slot bm) = .slot b ∧
    (∀ x ∈ prefixRoles w.H bm, capRole w x ∈ prefixRoles E b) ∧
    Set.InjOn (capRole w) {x | x ∈ prefixRoles w.H bm} := by sorry

-- provides: U3, L7.5 (the spine's `joint_repair`†; consumer: U5 L8.8 Case 3)
theorem joint_repair {P : Prims.{u}} (pk : SourcePacket.{u}) (hadm : pk.rk.Admitted)
    (hv : pk.Valid P) {c : ColAddr} {k p : Nat} (hfd : pk.rk.firstDiff = .capAt c k p)
    (w : Closure.AdmCap pk.rk.E) (hw : w.col = c ∧ w.cut = k ∧ w.par = p) :
    let κ := capChart pk
    let bm := Closure.moveAddr w.moves pk.rk.b
    let α := pk.asg ∘ κ ∘ capRole w
    IsConfig P w.H α ∧
    α (.slot bm) = pk.asg pk.owner ∧ α (.ord bm.col) = pk.asg pk.host ∧
    (frameOf bm).map (κ ∘ capRole w) = pk.tgtFrame ∧
    (∀ x ∈ prefixRoles w.H bm, κ (capRole w x) = pk.tgtChart (capRole w x)) ∧
    (∀ sd, Scan.stopData w.H = some sd →
      α (.ord sd.col) = pk.asg (κ (.ord c)) ∧
      α (.slot (Scan.closingSlot sd)) = pk.asg (κ (.slot ⟨c, k⟩)) ∧
      ∀ x ∈ rolesBefore w.H (.ord sd.col), α x < α (.ord sd.col)) ∧
    (∀ x y, Closure.anchorOrigin pk.rk.E (some w) x = some y → κ y = κ (capRole w x)) := by sorry

namespace SourcePacket

variable (pk : SourcePacket.{u})

/-- D7.2c: every name of a packet whose value is fixed by readmission. -/
def usedNames : List Name := pk.lowNames ++ [pk.owner]

end SourcePacket

/-- L7.5b: readmission after a confined source reduction (§8.5 Case 2): same target data, same
source prefix, the marked slot and its new height under fresh names with values `δ`. -/
noncomputable def readmitHeight (pk : SourcePacket.{u}) (F' : Forest) (kind' : RecKind pk.rk.E)
    (δ : Role → Ordinal.{u}) : SourcePacket.{u} :=
  let tg := freshTag pk.usedNames
  { rk := { pk.rk with F := F', kind := kind' }
    tgtChart := pk.tgtChart
    srcChart := fun x => if x ∈ prefixRoles pk.rk.F pk.rk.a then pk.srcChart x else .role tg x
    aux := pk.aux
    asg := fun nm => match nm with
      | .role t x => if t = tg then δ x else pk.asg nm
      | .aux _ => pk.asg nm }

-- provides: U3, L7.5b (closure of the packet class under §8.5 Case 2; consumer: U5 L8.8)
theorem readmit_height {P : Prims.{u}} (pk : SourcePacket.{u}) (hadm : pk.rk.Admitted)
    (hv : pk.Valid P) {A'' : Forest} (kind' : RecKind pk.rk.E)
    (hadm' : ({ pk.rk with F := pk.rk.F.setHeight pk.rk.a A'', kind := kind' } : SrcRecord).Admitted)
    (δ : Role → Ordinal.{u})
    (hgraph : BaseHolds P (graph (pk.rk.F.setHeight pk.rk.a A''))
      (fun x => if x ∈ prefixRoles pk.rk.F pk.rk.a then pk.asg (pk.srcChart x) else δ x))
    (hheads : ∃ o v, pk.tgtFrame.reps[pk.rk.tgtSel]? = some (o, v) ∧
      P.Edge (δ (.slot pk.rk.a)) (pk.asg pk.host) (pk.asg o) ∧
      P.Edge (δ (.slot pk.rk.a)) (pk.asg pk.host) (pk.asg v))
    (hlow : ∀ x ∈ pk.lowNames, pk.asg x < δ (.slot pk.rk.a)) :
    let pk' := readmitHeight pk (pk.rk.F.setHeight pk.rk.a A'') kind' δ
    pk'.rk.Admitted ∧ pk'.Valid P ∧ pk'.asg pk'.owner = δ (.slot pk.rk.a) ∧
    pk'.host = pk.host ∧ pk'.tgtFrame = pk.tgtFrame ∧ pk'.lowNames = pk.lowNames ∧
    (∀ x ∈ pk.lowNames, pk'.asg x = pk.asg x) ∧ pk'.rk.tgtKey = pk.rk.tgtKey ∧
    pk'.rk.tgtSel = pk.rk.tgtSel := by sorry

/-- L7.5c: readmission after the repaired-cap descent (§8.5 Case 3): a repair record for the
original target; the source prefix is the surviving restriction of the target prefix (names
`tgtChart ∘ capRole`); the marked slot and height of the output get fresh names with values `γ`;
all old names get the values `b'`. -/
noncomputable def readmitRepair (pk : SourcePacket.{u}) (w : Closure.AdmCap pk.rk.E) (Hk : Forest)
    (γ : Role → Ordinal.{u}) (b' : Name → Ordinal.{u}) : SourcePacket.{u} :=
  let tg := freshTag pk.usedNames
  let bm := Closure.moveAddr w.moves pk.rk.b
  { rk := { E := pk.rk.E, b := pk.rk.b, F := Hk.truncAfter bm, a := bm, kind := .repair w.moves }
    tgtChart := pk.tgtChart
    srcChart := fun x =>
      if x ∈ prefixRoles (Hk.truncAfter bm) bm then pk.tgtChart (capRole w x) else .role tg x
    aux := pk.aux
    asg := fun nm => match nm with
      | .role t x => if t = tg then γ x else b' nm
      | .aux _ => b' nm }

-- provides: U3, L7.5c (closure of the packet class under §8.5 Case 3; consumer: U5 L8.8)
theorem readmit_repair {P : Prims.{u}} (pk : SourcePacket.{u}) (hadm : pk.rk.Admitted)
    (hv : pk.Valid P) {c : ColAddr} {k p : Nat} (hfd : pk.rk.firstDiff = .capAt c k p)
    (w : Closure.AdmCap pk.rk.E) (hw : w.col = c ∧ w.cut = k ∧ w.par = p)
    {n : Nat} {Hk : Forest} (hexp : expand w.H n = some Hk) (habove : pk.rk.E < Hk)
    (γ : Role → Ordinal.{u}) (b' : Name → Ordinal.{u})
    (hsrc : BaseHolds P (graph (Hk.truncAfter (Closure.moveAddr w.moves pk.rk.b))) γ)
    (hshare : ∀ x ∈ prefixRoles w.H (Closure.moveAddr w.moves pk.rk.b),
      γ x = b' (pk.tgtChart (capRole w x)))
    (htgt : BaseHolds P ((prefixGraph pk.rk.E pk.rk.b).map (BaseAtom.map pk.tgtChart)) b')
    (haux : pk.aux.Holds P b')
    (hheads : ∃ o v, pk.tgtFrame.reps[pk.rk.tgtSel]? = some (o, v) ∧
      P.Edge (γ (.slot (Closure.moveAddr w.moves pk.rk.b))) (b' pk.host) (b' o) ∧
      P.Edge (γ (.slot (Closure.moveAddr w.moves pk.rk.b))) (b' pk.host) (b' v))
    (hlow : ∀ x ∈ pk.lowNames, b' x < γ (.slot (Closure.moveAddr w.moves pk.rk.b))) :
    let bm := Closure.moveAddr w.moves pk.rk.b
    let pk' := readmitRepair pk w Hk γ b'
    pk'.rk.Admitted ∧ pk'.Valid P ∧ pk'.asg pk'.owner = γ (.slot bm) ∧ pk'.host = pk.host ∧
    pk'.tgtFrame = pk.tgtFrame ∧ (∀ x ∈ pk.lowNames, pk'.asg x = b' x) ∧
    pk'.rk.tgtKey = pk.rk.tgtKey ∧ pk'.rk.tgtSel = pk.rk.tgtSel ∧ pk'.rk.E = pk.rk.E ∧
    pk'.rk.b = pk.rk.b := by sorry

-- SCR2 applied at integration: the bridge holds by `rfl`
theorem ScanSetup.valid_iff_def (S : ScanSetup.{u}) (P : Prims.{u}) :
    S.Valid P ↔ S.ValidDef P := by sorry

/-! ## L7.6a  The explicit packet at a scan state and the fitting extension -/

namespace ScanSetup

variable (S : ScanSetup.{u})

/-- L7.6a: names already used by the setup (target prefix, `ρ`, bank, auxiliary data). -/
def usedNames : List Name :=
  S.PE.map S.ePre ++ [S.stopNm] ++ S.bankRoles.map S.bankNm ++ S.aux.vars

/-- L7.6a: the fresh tag of the fitted target names. -/
def fitTag : Nat := freshTag S.usedNames

/-- L7.6a: the stopping column of the anchor read in `E`. -/
def cE : ColAddr := match S.TE with
  | .ord c => c
  | .slot _ => S.sd.col

/-- L7.6a: a role of `E` inside the query column, read in `H`. -/
def toH (y : Role) : Role := transColumn S.cE S.sd.col id y

/-- L7.6a: the target chart of the scan packet: `ePre` on `P_E`, `ρ` on `T_E`, fresh fitted names
on the earlier query entries. -/
def pkTgtChart (y : Role) : Name :=
  if y ∈ S.PE then S.ePre y else if y = S.TE then S.stopNm else .role S.fitTag (S.toH y)

/-- L7.6a: the source chart of the scan packet: the shared pre-root chart, `ρ` on `R`, the bank. -/
def pkSrcChart (x : Role) : Name :=
  if x ∈ S.preRoot then S.ePre (S.chi x) else if x = S.R then S.stopNm else S.bankNm x

/-- L7.6a: the joint assignment: fitted names read `β`, all other names keep the setup's values. -/
noncomputable def pkAsg (β : Role → Ordinal.{u}) (nm : Name) : Ordinal.{u} :=
  match nm with
  | .role tg x => if tg = S.fitTag then β x else S.asg nm
  | .aux _ => S.asg nm

/-- L7.6a: the complete source packet at scan state `(i, j)`. -/
noncomputable def scanPacket (i j : Nat) (β : Role → Ordinal.{u}) : SourcePacket.{u} :=
  { rk := S.scanRecord i j, tgtChart := S.pkTgtChart, srcChart := S.pkSrcChart, aux := S.aux,
    asg := S.pkAsg β }

/-- L7.6a: the fitting of query entry `j` read off a target block `γ`. -/
noncomputable def extendFit (j : Nat) (β : Role → Ordinal.{u}) (γ : BlkVar → Ordinal.{u})
    (x : Role) : Ordinal.{u} :=
  if x ∈ S.entryRoles j then
    (if x = .slot ⟨S.sd.col, j⟩ then γ .owner
      else γ (.inner (relRole (EntryAddr.heightPath ⟨S.sd.col, j⟩) x)))
  else β x

end ScanSetup

-- provides: U3, L7.6a (explicit form of the spine's `scan_packet`)
theorem scanPacket_spec {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) {i j : Nat}
    (hij : Scan.ReachesGT (Scan.rootKeys S.H S.rd) (Scan.queryKeys S.sd) i j)
    {β : Role → Ordinal.{u}} (hfit : S.Fitted P j β) (h17a : S.Lmax j β < S.ownerVal i)
    (hheads : S.HeadsAt P j i β) :
    let pk := S.scanPacket i j β
    pk.rk = S.scanRecord i j ∧ pk.rk.Admitted ∧ pk.Valid P ∧ pk.asg pk.owner = S.ownerVal i ∧
    ∀ L, S.Lmax j β ≤ L → ∀ γ : BlkVar → Ordinal.{u},
      (∀ w x, pk.tgtFrame.toFr w = some x → γ w = pk.asg x) →
      (∀ w ∈ baseVars (posBlock pk.rk.tgtKey pk.rk.tgtSel), pk.tgtFrame.toFr w = none →
        L < γ w ∧ ∀ x ∈ pk.lowNames, pk.asg x < γ w) →
      (∀ w ∈ baseVars (posBlock pk.rk.tgtKey pk.rk.tgtSel), γ w < pk.asg pk.owner) →
      BaseHolds P (posBlock pk.rk.tgtKey pk.rk.tgtSel) γ →
      S.Fitted P (j + 1) (S.extendFit j β γ) ∧ (∀ x ∈ S.fittedRoles j, S.extendFit j β γ x = β x) ∧
      ∀ x ∈ S.entryRoles j, L < S.extendFit j β γ x ∧ S.extendFit j β γ x < S.ownerVal i := by
  sorry

/-! ## Integration additions (nodes D7.1b, L6.2e, L6.2f, D7.2d, L7.6b, L4.3d, L7.5d; requested
by U5 R10, R18, R19, R22, R23, R25–R27, R29, R30; formerly stubs in `U5.lean`) -/

/-- D7.1b helper: `filterMap` over a range whose values are all defined. -/
theorem filterMap_range_getElem? {β : Type} (f : Nat → Option β) :
    ∀ n, (∀ q < n, (f q).isSome) → ∀ q, ((List.range n).filterMap f)[q]? = if q < n then f q else none
  | 0, _, q => by simp
  | n + 1, h, q => by
    rw [List.range_succ, List.filterMap_append]
    obtain ⟨b, hb⟩ := Option.isSome_iff_exists.1 (h n (by omega))
    have hl : ((List.range n).filterMap f).length = n := by
      have := filterMap_range_getElem? f n (fun q hq => h q (by omega))
      apply Nat.le_antisymm
      · by_contra hc
        have h1 := this n
        rw [if_neg (by omega), List.getElem?_eq_none_iff] at h1
        omega
      · by_contra hc
        have h1 := this (n - 1)
        rw [if_pos (by omega), List.getElem?_eq_none (by omega)] at h1
        have := h (n - 1) (by omega)
        rw [← h1] at this
        simp at this
    simp only [List.filterMap_cons, List.filterMap_nil, hb]
    rw [List.getElem?_append]
    split_ifs with h1 h2 h3
    · rw [filterMap_range_getElem? f n (fun q hq => h q (by omega)), if_pos (by omega)]
    · omega
    · have : q = n := by omega
      subst this; simp [hl, hb]
    · rw [List.getElem?_singleton, if_neg (by omega)]

-- Moved up from after `reps0_length` (unchanged): `blockMap_frame` and `reps0_length` use it.
theorem reps0_getElem? (c : ColAddr) (q : Nat) : c.reps0[q]? = c.rep 0 q := by
  unfold ColAddr.reps0
  rw [filterMap_range_getElem? _ _ (fun q hq => (rep_isSome_iff c q).2 hq)]
  split_ifs with h
  · rfl
  · cases hr : c.rep 0 q with
    | none => rfl
    | some _ =>
      have := (rep_isSome_iff c q).1 (by rw [hr]; rfl)
      omega

-- provides: U3, D7.1b (requested by U5 R18, second conjunct): the block map agrees with the frame
-- of `e` on every frame variable.
theorem blockMap_frame (e : EntryAddr) :
    ∀ w x, (frameOf e).toFr w = some x → blockMap e w = x := by
  intro w x hw
  cases w with
  | host => simpa [frameOf, Frame.toFr, blockMap] using hw
  | ord q =>
    simp only [frameOf, Frame.toFr, reps0_getElem?] at hw
    simp [blockMap, hw]
  | cur q =>
    simp only [frameOf, Frame.toFr, reps0_getElem?] at hw
    simp [blockMap, hw]
  | owner => simp [Frame.toFr] at hw
  | inner r => simp [Frame.toFr] at hw

-- provides: U3, D7.1b (requested by U5 R10): every number below a column's printed number is
-- visible, so `reps0` has one pair per number, and `reps0[q]? = rep 0 q`.
theorem reps0_length (c : ColAddr) : c.reps0.length = c.num 0 := by
  apply Nat.le_antisymm
  · by_contra hc
    have h1 := reps0_getElem? c (c.num 0)
    rw [List.getElem?_eq_getElem (by omega)] at h1
    have := (rep_isSome_iff c (c.num 0)).1 (by rw [← h1]; rfl)
    omega
  · by_contra hc
    have h1 := reps0_getElem? c (c.num 0 - 1)
    rw [List.getElem?_eq_none (by omega)] at h1
    have := (rep_isSome_iff c (c.num 0 - 1)).2 (by omega)
    rw [← h1] at this
    simp at this

-- provides: U3, D7.1b (requested by U5 R10): a column whose stack passes through column `c` sees
-- `c`'s frame below `c`'s number.
theorem reps0_take {c d : ColAddr} (h : d.resolve 0 (c.num 0) = some c) :
    d.reps0.take (c.num 0) = c.reps0 := by
  apply List.ext_getElem?
  intro q
  rw [List.getElem?_take, reps0_getElem?, reps0_getElem?]
  split_ifs with hq
  · exact (rep_visible d c h q hq).symm
  · cases hr : c.rep 0 q with
    | none => rfl
    | some _ =>
      have := (rep_isSome_iff c q).1 (by rw [hr]; rfl)
      omega

-- provides: U3, D7.1b (requested by U5 R19): frame roles lie in the prefix `P(E, e)`.
theorem frameOf_mem_prefix {E : Forest} {e : EntryAddr} (he : e ∈ E.entryAddrs) :
    Role.ord e.col ∈ prefixRoles E e ∧
      ∀ ov ∈ e.col.reps0, ov.1 ∈ prefixRoles E e ∧ ov.2 ∈ prefixRoles E e := by
  refine ⟨(Tree.stack_mem_prefix he).1, ?_⟩
  rintro ⟨o, v⟩ hov
  obtain ⟨q, hq⟩ := List.mem_iff_getElem?.1 hov
  rw [reps0_getElem?] at hq
  exact rep_mem_prefix he hq

-- provides: U3, L6.2e (requested by U5 R22, stage zero): `H[0]` is the restriction to `P`, and
-- `f_0` is the identity on `D`.
theorem stage_zero {H : Forest} (hL : Scan.InL H) {rs : RoleSets} (hrs : roleSets H = some rs)
    {G : Forest} (hG : expand H 0 = some G) :
    G.roles = rs.P ∧ (∀ a ∈ graph G, a ∈ graph H) ∧ ∀ x ∈ rs.D, fMap H 0 0 x = x := by sorry

-- provides: U3, L6.2e (requested by U5 R22, one stage): roles and elementarity atoms of `H[m+1]`
-- from `H[m]`.
theorem stage_succ {H : Forest} (hL : Scan.InL H) {rs : RoleSets} (hrs : roleSets H = some rs)
    {m : Nat} {G G' : Forest} (hG : expand H m = some G) (hG' : expand H (m + 1) = some G') :
    G'.roles = G.roles ++ (fMap H (m + 1) (m + 1) rs.R ::
      (rs.Q.map (qMap H (m + 1) (m + 1)) ++ rs.K.map (fMap H (m + 1) (m + 1)))) ∧
    qMap H (m + 1) (m + 1) rs.T = fMap H (m + 1) (m + 1) rs.R ∧
    (∀ x ∈ rs.D, qMap H (m + 1) (m + 1) x = fMap H m m x) ∧
    (∀ x ∈ rolesBefore H rs.R, fMap H (m + 1) (m + 1) x = x) ∧
    ∀ a ∈ graph G', isStruct a = true → a ∈ graph G ∨
      (∃ a' ∈ queryAtoms H rs, isStruct a' = true ∧ a = a'.map (qMap H (m + 1) (m + 1))) ∨
      (∃ a' ∈ retAtoms H rs, a = a'.map (fMap H (m + 1) (m + 1))) := by sorry

-- provides: U3, L6.2e (requested by U5 R23, txt:941): structural query atoms read only
-- `D ∪ {T} ∪ Q`.
theorem queryAtoms_struct_vars {H : Forest} (hL : Scan.InL H) {rs : RoleSets}
    (hrs : roleSets H = some rs) :
    ∀ a ∈ queryAtoms H rs, isStruct a = true → ∀ v ∈ a.vars,
      v ∈ rs.D ∨ v = rs.T ∨ v ∈ rs.Q := by sorry

-- provides: U3, L6.2f (requested by U5 R27): roles and elementarity atoms of a special output:
-- the prefix `P(H, e)` and `N = n + ε` copies of the shortened positive block.
theorem special_graph {H : Forest} (hL : Scan.InL H) (hk : Scan.stepKind H = some .special)
    {sd : Scan.StopData} {e : EntryAddr} (hsd : Scan.stopData H = some sd)
    (he : sd.ownerEntry = some e) {k : Nat} {H' : Forest} (hH' : expand H k = some H') :
    ∃ (N : Nat) (cm : Nat → BlkVar → Role),
      H'.roles = prefixRoles H e ++ (List.range N).flatMap (fun i =>
        (BlkVar.owner :: (specialKey H e).roles.map BlkVar.inner).map (cm i)) ∧
      (∀ i w x, (frameOf e).toFr w = some x → cm i w = x) ∧
      ∀ a ∈ graph H', isStruct a = true →
        (a ∈ graph H ∧ ∀ v ∈ a.vars, v ∈ prefixRoles H e) ∨
        ∃ i < N, ∃ a' ∈ posBlock (specialKey H e) (entrySel H e), a = a'.map (cm i) := by sorry

-- provides: U3, D7.2d (requested by U5 R25): the target of the scan record at `(i, j)` is query
-- entry `j`'s height.
theorem scanRecord_tgtHeight {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) {i j : Nat}
    (hj : j < S.sd.Q.length) :
    (S.scanRecord i j).tgtHeight = ((S.sd.Q[j]?).map Prod.snd).getD Tree.empty := by sorry

-- provides: U3, L7.6b (requested by U5 R26, target advance txt:1160-1162): a positive block of query
-- entry `j` above `L ≥ L_j` at the fitted frame extends a fitting by entry `j`.
theorem fit_of_block {P : Prims.{u}} (S : ScanSetup.{u}) (hS : S.Valid P) {j : Nat}
    (hj : j < S.sd.Q.length) {β : Role → Ordinal.{u}} (hfit : S.Fitted P j β)
    {L : Ordinal.{u}} (hL : S.Lmax j β ≤ L) {βb : BlkVar → Ordinal.{u}}
    (hfr : ∀ w x, (frameOf ⟨S.sd.col, j⟩).toFr w = some x → βb w = S.fitVal β x)
    (hnew : ∀ w ∈ baseVars (posBlock (((Scan.queryKeys S.sd)[j]?).getD Tree.empty)
        (((S.sd.Q[j]?).map Prod.fst).getD 0)),
      (frameOf ⟨S.sd.col, j⟩).toFr w = none → L < βb w)
    (hholds : BaseHolds P (posBlock (((Scan.queryKeys S.sd)[j]?).getD Tree.empty)
        (((S.sd.Q[j]?).map Prod.fst).getD 0)) βb) :
    ∃ β', S.Fitted P (j + 1) β' ∧ (∀ x ∈ S.fittedRoles j, β' x = β x) ∧
      ∀ x ∈ S.entryRoles j, ∃ w ∈ baseVars (posBlock (((Scan.queryKeys S.sd)[j]?).getD Tree.empty)
          (((S.sd.Q[j]?).map Prod.fst).getD 0)),
        (frameOf ⟨S.sd.col, j⟩).toFr w = none ∧ β' x = βb w := by sorry

/-- L4.3d (moved from U5 `Req.ChildData`; requested by U5 R29): the data of §8.5 Case 2
(txt:1364-1368): a safe truncation `F₁` of the source context, a confined step of it, and the
admitted record of its output. -/
structure ChildData (pk : SourcePacket.{u}) where
  F₁ : Forest
  k : Nat
  F₂ : Forest
  sd₁ : Scan.StopData
  kind' : RecKind pk.rk.E
  inL : Scan.InL F₁
  roles_pre : F₁.roles <+: pk.rk.F.roles
  graph_sub : ∀ a ∈ graph F₁, a ∈ graph pk.rk.F
  stop : Scan.stopData F₁ = some sd₁
  stop_inside : (Role.ord sd₁.col).inEntry pk.rk.a = true
  step : expand F₁ k = some F₂
  branch : (Scan.stepKind F₁ = some .ordinary ∧ sd₁.Q = [] ∧
      ∃ rd₁, Scan.rootData F₁ = some rd₁ ∧ (Role.ord rd₁.col).inEntry pk.rk.a = true) ∨
    (Scan.stepKind F₁ = some .special ∧
      ∃ e, sd₁.ownerEntry = some e ∧ (Role.slot e).inEntry pk.rk.a = true ∧ e ≠ pk.rk.a)
  persist : prefixRoles F₂ pk.rk.a = prefixRoles pk.rk.F pk.rk.a
  admitted : ({ E := pk.rk.E, b := pk.rk.b, F := F₂, a := pk.rk.a, kind := kind' } :
    SrcRecord).Admitted

-- provides: U3, L4.3d (requested by U5 R29): the Case 2 data exist.
theorem childEnds_package (pk : SourcePacket.{u}) (hadm : pk.rk.Admitted)
    {π : List (Nat × Nat)} (hfd : pk.rk.firstDiff = .childEnds π) : Nonempty (ChildData pk) := by
  sorry

/-- L7.5d (moved from U5 `Req.CapData`; requested by U5 R30): the data of §8.5 Case 3: the repaired
first-difference cap, the charts of its `E`-prefix and of `Γ(H)`, an extended assignment, the
marked entry's survival, and readmission of the repair records. -/
structure CapData (P : Prims.{u}) (pk : SourcePacket.{u}) where
  w : Closure.AdmCap pk.rk.E
  sd : Scan.StopData
  rd : Scan.RootData
  nm : Role → Name
  nmH : Role → Name
  asg' : Name → Ordinal.{u}
  ordinary : Scan.stepKind w.H = some .ordinary
  stop : Scan.stopData w.H = some sd
  root : Scan.rootData w.H = some rd
  qsize : ∀ J ∈ sd.Q, J.2.size + 2 ≤ pk.rk.tgtHeight.size
  nm_tgt : ∀ y ∈ prefixRoles pk.rk.E pk.rk.b, nm y = pk.tgtChart y
  nm_owner : nm (.slot pk.rk.b) = pk.owner
  pre_sub : ∀ y ∈ prefixRoles pk.rk.E pk.rk.b, y ∈ ePrefix pk.rk.E (some w) sd
  nm_inj : Set.InjOn nm {y | y ∈ ePrefix pk.rk.E (some w) sd}
  nmH_inj : Set.InjOn nmH {x | x ∈ w.H.roles}
  compat : ∀ x ∈ rolesBefore w.H (.ord sd.col), ∀ y, w.origin x = some y → nmH x = nm y
  asg_old : ∀ x, x ∈ pk.lowNames ∨ x = pk.owner → asg' x = pk.asg x
  config : IsConfig P w.H (asg' ∘ nmH)
  ePrefix_holds : BaseHolds P (restrictTo (graph pk.rk.E) (ePrefix pk.rk.E (some w) sd))
    (asg' ∘ nm)
  ePrefix_below : ∀ y ∈ ePrefix pk.rk.E (some w) sd, asg' (nm y) < asg' (nmH (.ord sd.col))
  marked_mem : Closure.moveAddr w.moves pk.rk.b ∈ w.H.entryAddrs
  marked_slot : w.origin (.slot (Closure.moveAddr w.moves pk.rk.b)) = some (.slot pk.rk.b)
  marked_host : w.origin (.ord (Closure.moveAddr w.moves pk.rk.b).col) = some (.ord pk.rk.b.col)
  marked_prefix : ∀ x ∈ prefixRoles w.H (Closure.moveAddr w.moves pk.rk.b),
    ∃ y ∈ prefixRoles pk.rk.E pk.rk.b, w.origin x = some y
  marked_frame : ((frameOf (Closure.moveAddr w.moves pk.rk.b)).map nmH).reps = pk.tgtFrame.reps
  stop_inside : (Role.ord sd.col).inEntry (Closure.moveAddr w.moves pk.rk.b) = true
  owner_lt : pk.asg pk.owner < asg' (nmH (.ord sd.col))
  readmit : ∀ k H', expand w.H k = some H' → pk.rk.E < H' →
    ({ E := pk.rk.E, b := pk.rk.b, F := H'.truncAfter (Closure.moveAddr w.moves pk.rk.b),
       a := Closure.moveAddr w.moves pk.rk.b, kind := .repair w.moves } : SrcRecord).Admitted

/-! ### L7.5d helpers (G-012; `blueprint/repairs/lean/G012.lean`, adapted to the integrated
contracts `Closure.MovesOutside`, `Closure.moves_spec`, `Closure.applyMoves_litCap_addr`,
`repair_moves_outside`) -/

end Packet

namespace Tree

/-- D1.2g helper (G-012): `takeWhile` passes a block all of whose members satisfy the test. -/
theorem takeWhile_append_of_forall {p : Role → Bool} :
    ∀ (l₁ l₂ : List Role), (∀ a ∈ l₁, p a = true) → (l₁ ++ l₂).takeWhile p = l₁ ++ l₂.takeWhile p
  | [], _, _ => rfl
  | a :: l₁, l₂, h => by
    have ha : p a = true := h a (List.mem_cons_self ..)
    have ih := takeWhile_append_of_forall l₁ l₂ (fun b hb => h b (List.mem_cons_of_mem _ hb))
    simp only [List.cons_append, List.takeWhile_cons, ha, if_true, ih]

/-- D1.2g helper (G-012): a role of `t` whose path extends `e.heightPath` is a role of the height
of `e`, placed under `e.heightPath`. -/
theorem mem_under_of_inEntry {t : Forest} {e : EntryAddr} (he : e ∈ t.entryAddrs) {x : Role}
    (hx : x ∈ t.roles) (hpath : e.heightPath <+: x.path) :
    x ∈ ((t.heightAt e).getD Tree.empty).roles.map (Role.under e.heightPath) := by
  obtain ⟨h, hh⟩ : ∃ h, t.heightAt e = some h := by
    have h1 := (mem_entryAddrs_iff _ _).mp he
    cases hE : t.entryAt e with
    | none => simp [hE] at h1
    | some v => exact ⟨v.2, by simp [Tree.heightAt, hE]⟩
  rw [hh, Option.getD_some, List.mem_map]
  obtain ⟨π', hπ'⟩ := hpath
  have hcol : ∀ d : ColAddr, d.path = e.heightPath ++ π' →
      t.colAt d = h.colAt ⟨π', d.col⟩ := by
    intro d hd
    unfold Tree.colAt
    rw [hd, forestAt_append, forestAt_heightPath, hh]
    rfl
  cases x with
  | ord d =>
    simp only [Role.path] at hπ'
    refine ⟨.ord ⟨π', d.col⟩, ?_, ?_⟩
    · have hx' := (mem_roles_iff _ _).mp hx
      rw [mem_roles_iff]
      simp only at hx' ⊢
      rwa [hcol d hπ'.symm] at hx'
    · simp only [Role.under]
      rw [hπ']
  | slot d =>
    simp only [Role.path] at hπ'
    refine ⟨.slot ⟨⟨π', d.col.col⟩, d.idx⟩, ?_, ?_⟩
    · have hx' := (mem_roles_iff _ _).mp hx
      rw [mem_roles_iff]
      simp only at hx' ⊢
      unfold Tree.entryAt at hx' ⊢
      rwa [hcol d.col hπ'.symm] at hx'
    · simp only [Role.under]
      rw [hπ']

/-- D1.2g item 2 (G-012): no role of the prefix `P(t, e)` lies inside `e`. -/
theorem not_inEntry_of_mem_prefix {t : Forest} {e : EntryAddr} (he : e ∈ t.entryAddrs)
    {y : Role} (hy : y ∈ Packet.prefixRoles t e) : y.inEntry e = false := by
  obtain ⟨post, hroles, -⟩ := roles_entry he
  have hnd := roles_nodup t
  rw [hroles] at hnd
  have hdis := List.disjoint_of_nodup_append hnd
  have hyt : y ∈ t.roles := (List.takeWhile_sublist _).subset hy
  by_contra hin
  have hin' : y.inEntry e = true := by simpa using hin
  have hne : y ≠ .slot e := by
    rintro rfl
    exact hdis hy (List.mem_cons_self ..)
  have hpath : e.heightPath <+: y.path := by
    simpa [Role.inEntry, hne, List.isPrefixOf_iff_prefix] using hin'
  exact hdis hy (List.mem_cons_of_mem _ (List.mem_append_left _ (mem_under_of_inEntry he hyt hpath)))

/-- D1.2g item 1 (G-012): the prefix of an entry and its slot precede every other role inside
the entry. -/
theorem prefix_slot_before_inEntry {t : Forest} {e : EntryAddr} (he : e ∈ t.entryAddrs)
    {x : Role} (hx : x ∈ t.roles) (hin : x.inEntry e = true) (hne : x ≠ .slot e) :
    Packet.prefixRoles t e ++ [.slot e] <+: Packet.rolesBefore t x := by
  obtain ⟨post, hroles, -⟩ := roles_entry he
  have hxP : x ∉ Packet.prefixRoles t e := fun h => by
    have h1 := not_inEntry_of_mem_prefix he h
    rw [hin] at h1
    exact absurd h1 (by decide)
  unfold Packet.rolesBefore
  rw [hroles, takeWhile_append_of_forall]
  · simp only [List.takeWhile_cons, bne_iff_ne, ne_eq, Ne.symm hne, not_false_eq_true,
      if_true]
    exact ⟨_, by rw [List.append_assoc]; rfl⟩
  · intro a ha
    simp only [bne_iff_ne, ne_eq]
    rintro rfl
    exact hxP ha

end Tree

namespace Packet

open Hier

/-- L7.5a-1 (G-012): a repair step that retains `e` (or a container of `e`) is undone by the
backward index map, on `U_e` and on `A_{e.col}`. -/
theorem mapEntry_bwd_fwd {K : Forest} {e : EntryAddr} {m : Closure.Move}
    (h : Closure.RepairStepOK K e m) :
    m.mapEntry m.bwdIdx (m.mapEntry m.fwdIdx e) = e ∧
      m.mapRole m.bwdIdx (m.mapRole m.fwdIdx (.ord e.col)) = .ord e.col := by
  obtain ⟨col, -, hij, -, -, -, hret⟩ := h
  rcases hret with hret | ⟨ρ, hρ⟩
  · -- the retained entry is `e` itself: `e.col = m.col`, `e.idx = m.j`
    subst hret
    have hp : ∀ g : Nat → Nat, m.mapPath g m.col.path = m.col.path := by
      intro g; unfold Closure.Move.mapPath; simp
    have hc : (⟨m.col.path, m.col.col⟩ : ColAddr) = m.col := rfl
    refine ⟨?_, ?_⟩
    · simp only [Closure.Move.mapEntry, hp, hc, if_true]
      congr 1
      simp only [Closure.Move.fwdIdx, Closure.Move.bwdIdx]
      split <;> split <;> omega
    · simp only [Closure.Move.mapRole, hp]
  · -- the retained entry contains `e.col`: `e.col.path = m.col.path ++ (m.col.col, m.j) :: ρ`
    obtain ⟨⟨π, cc⟩, idx⟩ := e
    simp only [EntryAddr.heightPath, List.append_assoc, List.singleton_append] at hρ
    subst hρ
    have hmp : ∀ (g : Nat → Nat) (x : Nat),
        m.mapPath g (m.col.path ++ (m.col.col, x) :: ρ) = m.col.path ++ (m.col.col, g x) :: ρ := by
      intro g x; unfold Closure.Move.mapPath; simp
    have hne : ∀ x : Nat, (⟨m.col.path ++ (m.col.col, x) :: ρ, cc⟩ : ColAddr) ≠ m.col := by
      intro x h
      have h' := congrArg (fun c : ColAddr => c.path.length) h
      simp at h'
    have hji : m.bwdIdx (m.fwdIdx m.j) = m.j := by
      simp only [Closure.Move.fwdIdx, Closure.Move.bwdIdx]
      split <;> split <;> omega
    refine ⟨?_, ?_⟩
    · simp only [Closure.Move.mapEntry, hmp, if_neg (hne _), hji]
    · simp only [Closure.Move.mapRole, hmp, hji]

/-- L7.5a-1 (G-012): along a repair list for `b`, undoing the moves (last first) sends the moved
slot and host column back to `U_b` and `A_{b.col}`. -/
theorem foldr_bwd_moveAddr {K : Forest} {b : EntryAddr} {ms : List Closure.Move}
    (h : Closure.RepairList K b ms) :
    ms.foldr (fun m y => m.mapRole m.bwdIdx y) (.slot (Closure.moveAddr ms b)) = .slot b ∧
      ms.foldr (fun m y => m.mapRole m.bwdIdx y) (.ord (Closure.moveAddr ms b).col) =
        .ord b.col := by
  induction ms using List.reverseRecOn with
  | nil => exact ⟨rfl, rfl⟩
  | append_singleton ms m ih =>
    -- the prefix is a repair list, and the last step retains the current marked entry
    have hpre : Closure.RepairList K b ms := by
      intro idx hidx
      have h' := h idx (by simp; omega)
      rwa [List.take_append_of_le_length (by omega), List.getElem_append_left hidx] at h'
    have hlast : Closure.RepairStepOK (Closure.applyMoves K ms) (Closure.moveAddr ms b) m := by
      have h' := h ms.length (by simp)
      simpa using h'
    obtain ⟨ih1, ih2⟩ := ih hpre
    obtain ⟨hb1, hb2⟩ := mapEntry_bwd_fwd hlast
    have hma : Closure.moveAddr (ms ++ [m]) b = m.mapEntry m.fwdIdx (Closure.moveAddr ms b) := by
      show Closure.moveAddrBody _ _ = _
      simp [Closure.moveAddrBody, List.foldl_append]; rfl
    have hcol : ∀ (g : Nat → Nat) (e : EntryAddr),
        (m.mapEntry g e).col = ⟨m.mapPath g e.col.path, e.col.col⟩ := by
      intro g e
      unfold Closure.Move.mapEntry
      dsimp only
      split <;> rfl
    rw [hma, List.foldr_append, List.foldr_append]
    constructor
    · simp only [List.foldr_cons, List.foldr_nil, Closure.Move.mapRole, hb1]
      exact ih1
    · have hb2' : m.mapRole m.bwdIdx (.ord (m.mapEntry m.fwdIdx (Closure.moveAddr ms b)).col) =
          .ord (Closure.moveAddr ms b).col := by
        rw [hcol]; exact hb2
      simp only [List.foldr_cons, List.foldr_nil, hb2']
      exact ih2

/-- L7.5a-2 (G-012; consumers L7.5d `marked_slot`, `marked_host`): the moved marked entry and its
host column have origins `U_b` and `A_{b.col}`. -/
theorem origin_moveAddr {E : Forest} (hE : Scan.InL E) (w : Closure.AdmCap E) {b : EntryAddr}
    (hbc : b.heightPath <+: w.col.path) (hout : Closure.MovesOutside w.moves b) :
    w.origin (.slot (Closure.moveAddr w.moves b)) = some (.slot b) ∧
      w.origin (.ord (Closure.moveAddr w.moves b).col) = some (.ord b.col) := by
  obtain ⟨h1, h2⟩ := foldr_bwd_moveAddr (Closure.moves_spec hE w b hbc hout).1
  have hne : (Role.slot b) ≠ .slot ⟨w.col, w.cut⟩ := by
    intro h
    have hb : b = ⟨w.col, w.cut⟩ := Role.slot.inj h
    have hlen := hbc.length_le
    simp [hb, EntryAddr.heightPath] at hlen
  constructor
  · show Closure.originBody w _ = _
    simp only [Closure.originBody, h1, if_neg hne]
  · show Closure.originBody w _ = _
    simp only [Closure.originBody, h2]
    simp

/-- L7.5a-3 (G-012; consumers L7.5d `marked_mem`, `stop_inside`, `marked_prefix`): the moved
marked entry `bm` is an entry of `w.H`; `w.H` is the literal cap at the relocated column `c'`
inside `bm`; the stopping column and the closing slot lie inside `bm`; every role of `P(w.H, bm)`
has an origin. -/
theorem marked_entry_cap {E : Forest} (hE : IsStd E) (w : Closure.AdmCap E) {b : EntryAddr}
    (hb : b ∈ E.entryAddrs) (hbc : b.heightPath <+: w.col.path)
    (hout : Closure.MovesOutside w.moves b) :
    Closure.moveAddr w.moves b ∈ w.H.entryAddrs ∧
    w.H = Closure.litCap E ⟨(Closure.moveAddr w.moves b).heightPath ++
      w.col.path.drop b.heightPath.length, w.col.col⟩ w.cut w.par ∧
    (∀ sd, Scan.stopData w.H = some sd →
      sd.col = ⟨(Closure.moveAddr w.moves b).heightPath ++ w.col.path.drop b.heightPath.length,
        w.col.col⟩ ∧
      (Role.ord sd.col).inEntry (Closure.moveAddr w.moves b) = true ∧
      (Role.slot (Scan.closingSlot sd)).inEntry (Closure.moveAddr w.moves b) = true) ∧
    ∀ x ∈ prefixRoles w.H (Closure.moveAddr w.moves b), (w.origin x).isSome := by
  have hL : Scan.InL E := Closure.std_inL hE
  obtain ⟨-, -, -, hG, hH⟩ := Closure.moves_spec hL w b hbc hout
  -- `bm` is an entry of `w.H` (U2 `moves_spec` items 4-5, U1 `setHeight_basic`)
  have hbE : (E.heightAt b).isSome := by
    have h := (Tree.mem_entryAddrs_iff _ _).mp hb
    simpa [Tree.heightAt] using h
  have hbmG : Closure.moveAddr w.moves b ∈
      (Closure.applyMoves (E.truncAfter b) w.moves).entryAddrs := by
    rw [Tree.mem_entryAddrs_iff]
    have h : ((Closure.applyMoves (E.truncAfter b) w.moves).heightAt
        (Closure.moveAddr w.moves b)).isSome := by rw [hG]; exact hbE
    simpa [Tree.heightAt] using h
  have hmem : Closure.moveAddr w.moves b ∈ w.H.entryAddrs := by
    rw [hH]; exact (Tree.setHeight_basic _ _ _ hbmG).1
  -- `w.H` is the literal cap at the relocated column (U2 `applyMoves_litCap_addr`, all moves)
  obtain ⟨hup', hlit, -⟩ :=
    Closure.applyMoves_litCap_addr hL.2.2.1 w hbc hout w.moves.length le_rfl
  rw [List.take_length] at hup' hlit
  have hwH : w.H = Closure.litCap E ⟨(Closure.moveAddr w.moves b).heightPath ++
      w.col.path.drop b.heightPath.length, w.col.col⟩ w.cut w.par := hlit
  -- the stopping column and the closing slot lie inside `bm` (U2 T3.8c `stopData_litCap`)
  have hin : ∀ sd, Scan.stopData w.H = some sd →
      sd.col = ⟨(Closure.moveAddr w.moves b).heightPath ++ w.col.path.drop b.heightPath.length,
        w.col.col⟩ ∧
      (Role.ord sd.col).inEntry (Closure.moveAddr w.moves b) = true ∧
      (Role.slot (Scan.closingSlot sd)).inEntry (Closure.moveAddr w.moves b) = true := by
    intro sd hsd
    rw [hwH, Closure.stopData_litCap hup'] at hsd
    obtain rfl := Option.some.inj hsd
    refine ⟨rfl, ?_, ?_⟩ <;>
      simp [Role.inEntry, Role.path, Scan.closingSlot, List.isPrefixOf_iff_prefix]
  refine ⟨hmem, hwH, hin, ?_⟩
  -- origins on the prefix: `none` only at the closing slot (U2 `origin_spec_full` item 2), which
  -- is inside `bm`, hence not in `P(w.H, bm)` (D1.2g item 2)
  intro x hx
  by_contra hno
  have hxH : x ∈ w.H.roles := (List.takeWhile_sublist _).subset hx
  obtain ⟨sd, hsd, rfl⟩ := ((Closure.origin_spec_full hL w).2.1 x hxH).mp
    (Option.not_isSome_iff_eq_none.mp hno)
  have h1 := Tree.not_inEntry_of_mem_prefix hmem hx
  rw [(hin sd hsd).2.2] at h1
  exact absurd h1 (by decide)

/-- L7.5d-1 (G-012): value separation in its exact form. A configuration is strictly increasing
along the reading order, so a chart `f` through which a configuration `a ∘ f` is read is
injective on the roles. -/
theorem injOn_of_config {P : Prims.{u}} {E : Forest} {V : Type} {f : Role → V}
    {a : V → Ordinal.{u}} (h : IsConfig P E (a ∘ f)) : Set.InjOn f {x | x ∈ E.roles} := by
  intro x hx y hy hxy
  by_contra hne
  obtain ⟨i, hi⟩ := List.mem_iff_getElem?.mp hx
  obtain ⟨j, hj⟩ := List.mem_iff_getElem?.mp hy
  have hij : i ≠ j := by
    rintro rfl
    exact hne (Option.some.inj (hi.symm.trans hj))
  rcases Nat.lt_or_gt_of_ne hij with h1 | h1
  · have h2 := isConfig_before h ⟨i, j, hi, hj, h1⟩
    simp [Function.comp, hxy] at h2
  · have h2 := isConfig_before h ⟨j, i, hj, hi, h1⟩
    simp [Function.comp, hxy] at h2

/-- L7.5d-2 helper (G-012): `takeWhile (· != x)` stops inside a prefix that contains `x`. -/
theorem takeWhile_ne_take_append {x : Role} :
    ∀ (l r : List Role) (m : Nat), x ∈ l.take m →
      (l.take m ++ r).takeWhile (· != x) = l.takeWhile (· != x)
  | [], _, _, h => by simp at h
  | _ :: _, _, 0, h => by simp at h
  | y :: l, r, m + 1, h => by
    by_cases hy : y = x
    · subst hy; simp
    · have h' : x ∈ l.take m := by
        simp only [List.take_succ_cons, List.mem_cons] at h
        rcases h with h | h
        · exact absurd h.symm hy
        · exact h
      simp only [List.take_succ_cons, List.cons_append, List.takeWhile_cons]
      simp [hy, takeWhile_ne_take_append l r m h']

/-- L7.5d-2 (G-012): the literal cap keeps `A_c` and everything before it. -/
theorem litCap_rolesBefore_col {E : Forest} {c : ColAddr} {k p : Nat}
    (hup : Closure.IsUpward E c k p) :
    Role.ord c ∈ (Closure.litCap E c k p).roles ∧
      rolesBefore (Closure.litCap E c k p) (.ord c) = rolesBefore E (.ord c) := by
  have hcol : ∃ col, E.colAt c = some col ∧ k ≤ col.length := by
    unfold Closure.IsUpward at hup
    split at hup
    · rename_i col hc
      refine ⟨col, hc, ?_⟩
      split at hup
      · rename_i hk
        exact (List.getElem?_eq_some_iff.mp hk).1.le
      · omega
    · exact hup.elim
  obtain ⟨col, hc, hk⟩ := hcol
  have hcE : c ∈ E.colAddrs := (Tree.mem_colAddrs_iff _ _).mpr (by simp [hc])
  have hkp : k ≤ (Scan.parents E c).length := by simp [Scan.parents, hc, hk]
  obtain ⟨⟨m, hm⟩, -⟩ := Closure.litCap_spec (p := p) hcE hkp
  have hmem : Role.ord c ∈ (Closure.litCap E c k p).roles :=
    Scan.stopData_col_mem (Closure.stopData_litCap hup)
  refine ⟨hmem, ?_⟩
  have h1 : Role.ord c ∈ E.roles.take m := by
    rw [hm] at hmem
    simpa using hmem
  unfold rolesBefore
  rw [hm]
  exact takeWhile_ne_take_append _ _ m h1

/-- L7.5d-3 (G-012): `capRole` is the origin wherever the origin is defined. -/
theorem capRole_of_origin {E : Forest} (w : Closure.AdmCap E) {x y : Role}
    (h : w.origin x = some y) : capRole w x = y := by
  simp [capRole, h]

-- provides: U3, L7.5d (requested by U5 R30): the Case 3 data exist.
theorem cap_package {P : Prims.{u}} (pk : SourcePacket.{u}) (hadm : pk.rk.Admitted)
    (hv : pk.Valid P) {c : ColAddr} {k p : Nat} (hfd : pk.rk.firstDiff = .capAt c k p) :
    Nonempty (CapData P pk) := by
  -- sources: L4.2 `firstDiff_cap`, U2 L3.1 `repair`, T3.2 `std_inL`/`std_condP`
  obtain ⟨hbc, hcE, hup, hKV, hKI, -, hKA, -, -⟩ := firstDiff_cap hadm hfd
  have hstd : IsStd pk.rk.E := hadm.1
  have hL : Scan.InL pk.rk.E := Closure.std_inL hstd
  obtain ⟨w, hwc, hwk, hwp, ⟨sd, hsd, -, -⟩, c₀, hup₀, hwH⟩ :=
    Closure.repair hL (Closure.std_condP hstd) hup hKV hKI hKA
  have hw : w.col = c ∧ w.cut = k ∧ w.par = p := ⟨hwc, hwk, hwp⟩
  -- `ordinary`: U2 T3.8c `litCap_ordinary` at the relocated column; `root`: spine
  have hHL : Scan.InL w.H := w.inL
  have hord : Scan.stepKind w.H = some .ordinary := by
    rw [hwH] at hHL ⊢
    exact Closure.litCap_ordinary hL.2.1 hup₀ hHL.1 hHL.2.1
  obtain ⟨rd, hrd⟩ := Option.isSome_iff_exists.mp (Scan.rootData_of_ordinary hord)
  -- sources: L7.4 `joint_cap`, L7.5 `joint_repair`
  have JC := joint_cap pk hadm hv hfd
  have JR := joint_repair pk hadm hv hfd w hw
  dsimp only at JC JR
  obtain ⟨hKcfg, hκtgt, hκown, -, hown_lt, -, hbelow, -, hholds⟩ := JC
  obtain ⟨hHcfg, -, -, hframe, -, -, -⟩ := JR
  -- the marked entry: L4.3c `repair_moves_outside`, L7.5a `frame_repair`, L7.5a-2, L7.5a-3
  have hbc' : pk.rk.b.heightPath <+: w.col.path := hwc ▸ hbc
  have hout := repair_moves_outside hadm hfd w hw
  have hME := marked_entry_cap hstd w hadm.2.1 hbc' hout
  have hOM := origin_moveAddr hL w hbc' hout
  have hFR := frame_repair hstd w hadm.2.1 hbc' hout
  dsimp only at hFR
  -- the `E`-prefix: U2 D3.1d `admCap_query`, L7.5d-2, D1.2g
  have hT : w.origin (.ord sd.col) = some (.ord c) := by
    have h := (Closure.admCap_query hL w hsd).2.2.2.1
    rwa [hwc] at h
  have hePre : ePrefix pk.rk.E (some w) sd = rolesBefore pk.rk.E (.ord c) := by
    simp [ePrefix, Closure.anchorOrigin, hT]
  have hlit := litCap_rolesBefore_col hup
  have hcapT : capRole w (.ord sd.col) = .ord c := capRole_of_origin w hT
  have hcE' : Role.ord c ∈ pk.rk.E.roles :=
    (Tree.mem_roles_iff _ _).mpr ((Tree.mem_colAddrs_iff _ _).mp hcE)
  have hcin : (Role.ord c).inEntry pk.rk.b = true := by
    simp [Role.inEntry, Role.path, List.isPrefixOf_iff_prefix.mpr hbc]
  have hpre := Tree.prefix_slot_before_inEntry hadm.2.1 hcE' hcin (by simp)
  refine ⟨{
    w := w, sd := sd, rd := rd, nm := capChart pk, nmH := capChart pk ∘ capRole w,
    asg' := pk.asg, ordinary := hord, stop := hsd, root := hrd,
    qsize := (query_size_bound hadm hfd w hw hsd).2.2,
    nm_tgt := hκtgt, nm_owner := hκown,
    pre_sub := fun y hy => by rw [hePre]; exact hpre.subset (List.mem_append_left _ hy),
    nm_inj := ?_, nmH_inj := injOn_of_config hHcfg,
    compat := fun x _ y h => by simp only [Function.comp, capRole_of_origin w h],
    asg_old := fun _ _ => rfl, config := hHcfg,
    ePrefix_holds := ?_, ePrefix_below := ?_,
    marked_mem := hME.1, marked_slot := hOM.1, marked_host := hOM.2,
    marked_prefix := ?_, marked_frame := congrArg Frame.reps hframe,
    stop_inside := (hME.2.2.1 sd hsd).2.1,
    owner_lt := ?_,
    readmit := fun n H' hexp habove => (repair_output hadm hfd w hw hexp habove).2.2.2.2 }⟩
  · -- `nm_inj`: L7.4 (a) and L7.5d-1 on `K`, since `ePrefix = rolesBefore K A_c ⊆ K.roles`
    intro y hy y' hy' h
    have h1 : y ∈ rolesBefore (Closure.litCap pk.rk.E c k p) (.ord c) := by
      rw [hlit.2, ← hePre]; exact hy
    have h2 : y' ∈ rolesBefore (Closure.litCap pk.rk.E c k p) (.ord c) := by
      rw [hlit.2, ← hePre]; exact hy'
    exact injOn_of_config hKcfg ((List.takeWhile_sublist _).subset h1)
      ((List.takeWhile_sublist _).subset h2) h
  · -- `ePrefix_holds`: L7.4 (f) and N3.1 `baseHolds_map`
    rw [hePre]
    exact (baseHolds_map P (capChart pk) _ pk.asg).mp hholds
  · -- `ePrefix_below`: L7.4 (e), `rolesBefore K A_c = rolesBefore E A_c`, `capRole T = A_c`
    intro y hy
    rw [hePre, ← hlit.2] at hy
    show pk.asg (capChart pk y) < pk.asg (capChart pk (capRole w (.ord sd.col)))
    rw [hcapT]
    exact hbelow y hy
  · -- `marked_prefix`: L7.5a (prefix clause) and L7.5a-3 (origins defined on the prefix)
    intro x hx
    obtain ⟨z, hz⟩ := Option.isSome_iff_exists.mp (hME.2.2.2 x hx)
    exact ⟨z, capRole_of_origin w hz ▸ hFR.2.2.1 x hx, hz⟩
  · -- `owner_lt`: L7.4 (d)
    show pk.asg pk.owner < pk.asg (capChart pk (capRole w (.ord sd.col)))
    rw [hcapT]
    exact hown_lt


