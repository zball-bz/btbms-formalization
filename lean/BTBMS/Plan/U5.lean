/-! ## N5.3 Block problems: floor encoding, capture, monotonicity -/

/-- N5.3: the floor-variable encoding of a block problem over `Option W` (`none` = the floor):
the atoms of `D`, and `floor < x` for every new variable `x`. -/
def floorDiagram {W : Type} (D : List (BaseAtom W)) (fr : W → Option Ordinal.{u}) :
    Diagram (Option W) :=
  Diagram.ofBase (D.map (BaseAtom.map some) ++
    ((baseVars D).filter fun x => (fr x).isNone).map fun x => BaseAtom.lt none (some x))

/-- N5.3: fixed variables of the encoding: the floor and every frame variable. -/
def floorFixed {W : Type} (fr : W → Option Ordinal.{u}) : Option W → Prop
  | none => True
  | some x => (fr x).isSome = true

/-- N5.3: values of the fixed variables of the encoding. -/
noncomputable def floorSigma {W : Type} (fr : W → Option Ordinal.{u}) (L : Ordinal.{u}) :
    Option W → Ordinal.{u}
  | none => L
  | some x => (fr x).getD 0

/-- N5.3 (helper): variables of a renamed base atom. -/
theorem baseAtom_vars_map {V W : Type} (f : V → W) (b : BaseAtom V) :
    (b.map f).vars = b.vars.map f := by
  cases b <;> rfl

/-- N5.3 (helper): variables of a renamed base diagram. -/
theorem baseVars_map {V W : Type} (f : V → W) (D : List (BaseAtom V)) :
    baseVars (D.map (BaseAtom.map f)) = (baseVars D).map f := by
  simp [baseVars, List.flatMap_map, baseAtom_vars_map, List.map_flatMap]

/-- N5.3 (helper): variables of an embedded base diagram. -/
theorem ofBase_vars {V : Type} (D : List (BaseAtom V)) :
    (Diagram.ofBase D).vars = baseVars D := by
  simp [Diagram.vars, Diagram.ofBase, baseVars, List.flatMap_map, Atom.vars]

/-- N5.3 (helper): a renamed base atom holds iff the original holds at the composite. -/
theorem baseAtom_holds_map' {V W : Type} (P : Prims.{u}) (f : V → W) (a : W → Ordinal.{u})
    (b : BaseAtom V) : (b.map f).Holds P a ↔ b.Holds P (a ∘ f) := by
  cases b <;> rfl

/-- N5.3 (helper): a renamed base diagram holds iff the original holds at the composite. -/
theorem baseHolds_map' {V W : Type} (P : Prims.{u}) (f : V → W) (D : List (BaseAtom V))
    (a : W → Ordinal.{u}) : BaseHolds P (D.map (BaseAtom.map f)) a ↔ BaseHolds P D (a ∘ f) := by
  simp only [BaseHolds, List.mem_map, forall_exists_index, and_imp, forall_apply_eq_imp_iff₂,
    baseAtom_holds_map']

/-- N5.3 (helper): the variables of the floor encoding are the floor and the `some` copies of
the variables of `D`. -/
theorem floorDiagram_vars {W : Type} {D : List (BaseAtom W)} {fr : W → Option Ordinal.{u}}
    {z : Option W} (hz : z ∈ (floorDiagram D fr).vars) : ∀ x, z = some x → x ∈ baseVars D := by
  rintro x rfl
  simp only [floorDiagram, ofBase_vars, baseVars, List.flatMap_append, List.mem_append,
    List.mem_flatMap, List.mem_map, List.mem_filter] at hz
  rcases hz with ⟨b, ⟨b0, hb0, rfl⟩, hx⟩ | ⟨b, ⟨y, ⟨hy, -⟩, rfl⟩, hx⟩
  · rw [baseAtom_vars_map] at hx
    obtain ⟨y, hy, hyx⟩ := List.mem_map.1 hx
    cases hyx
    exact List.mem_flatMap.2 ⟨b0, hb0, hy⟩
  · simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false, reduceCtorEq,
      false_or, Option.some.injEq] at hx
    subst hx
    exact List.mem_flatMap.2 hy

/-- N5.3: `BlockAbove` is realizability of its floor encoding (for a floor below the budget). -/
theorem blockAbove_iff_floor (P : Prims.{u}) {W : Type} (D : List (BaseAtom W))
    (fr : W → Option Ordinal.{u}) {L w : Ordinal.{u}} (hL : L < w) :
    BlockAbove P D fr L w ↔
      (floorDiagram D fr).RealizableBelow P (floorFixed fr) (floorSigma fr L) w := by
  constructor
  · rintro ⟨β, hfix, hnew, hlt, hhold⟩
    refine ⟨fun z => Option.elim z L β, fun z hz => ?_, fun z hz => ?_, ?_⟩
    · cases z with
      | none => rfl
      | some x =>
        obtain ⟨o, ho⟩ := Option.isSome_iff_exists.1 hz
        simp [floorSigma, ho, hfix x o ho]
    · cases z with
      | none => exact hL
      | some x => exact hlt x (floorDiagram_vars hz x rfl)
    · rw [floorDiagram, holds_ofBase]
      intro b hb
      rcases List.mem_append.1 hb with hb | hb
      · obtain ⟨b0, hb0, rfl⟩ := List.mem_map.1 hb
        exact (baseAtom_holds_map' P some _ b0).2 (hhold b0 hb0)
      · obtain ⟨x, hx, rfl⟩ := List.mem_map.1 hb
        obtain ⟨hxD, hxn⟩ := List.mem_filter.1 hx
        exact hnew x hxD (Option.isNone_iff_eq_none.1 hxn)
  · rintro ⟨a, hfix, hlt, hhold⟩
    rw [floorDiagram, holds_ofBase] at hhold
    have hnone : a none = L := hfix none trivial
    refine ⟨fun x => a (some x), fun x o hx => ?_, fun x hx hn => ?_, fun x hx => ?_, ?_⟩
    · have := hfix (some x) (by simp [floorFixed, hx])
      simpa [floorSigma, hx] using this
    · have := hhold (BaseAtom.lt none (some x)) (List.mem_append.2 (Or.inr
        (List.mem_map.2 ⟨x, List.mem_filter.2 ⟨hx, by simp [hn]⟩, rfl⟩)))
      simpa [BaseAtom.Holds, hnone] using this
    · refine hlt (some x) ?_
      rw [floorDiagram, ofBase_vars, baseVars, List.flatMap_append]
      refine List.mem_append.2 (Or.inl ?_)
      rw [← baseVars, baseVars_map]
      exact List.mem_map_of_mem hx
    · intro b hb
      exact (baseAtom_holds_map' P some a b).1
        (hhold _ (List.mem_append.2 (Or.inl (List.mem_map_of_mem hb))))

/-- N5.3: capture of a block problem along `J_a ≺_{Σ1} J_b` (frame and floor below `a`). -/
theorem blockAbove_capture (I : Interface.{u}) {W : Type} {D : List (BaseAtom W)}
    {fr : W → Option Ordinal.{u}} {L a b : Ordinal.{u}} (hab : I.Elem a b) (hL : L < a)
    (hfr : ∀ x ∈ baseVars D, ∀ o, fr x = some o → o < a)
    (h : BlockAbove I.toPrims D fr L b) : BlockAbove I.toPrims D fr L a := by
  have hLb : L < b := hL.trans_le (I.elem_le hab)
  refine (blockAbove_iff_floor I.toPrims D fr hL).2 ?_
  refine I.capture (floorDiagram D fr) (floorFixed fr) (floorSigma fr L) hab ?_
    ((blockAbove_iff_floor I.toPrims D fr hLb).1 h)
  intro z hz hfz
  cases z with
  | none => exact hL
  | some x =>
    obtain ⟨o, ho⟩ := Option.isSome_iff_exists.1 hfz
    simpa [floorSigma, ho] using hfr x (floorDiagram_vars hz x rfl) o ho

/-- N5.3: `BlockAbove` is antitone in the floor and monotone in the budget. -/
theorem blockAbove_mono {P : Prims.{u}} {W : Type} {D : List (BaseAtom W)}
    {fr : W → Option Ordinal.{u}} {L L' w w' : Ordinal.{u}} (hL : L ≤ L') (hw : w ≤ w')
    (h : BlockAbove P D fr L' w) : BlockAbove P D fr L w' := by
  obtain ⟨β, hfix, hnew, hlt, hhold⟩ := h
  exact ⟨β, hfix, fun x hx hn => hL.trans_lt (hnew x hx hn),
    fun x hx => (hlt x hx).trans_le hw, hhold⟩

/-- N5.3: a `TargetAbove` witness is a `BlockAbove` witness at the owner value. -/
theorem blockAbove_of_targetAbove {P : Prims.{u}} (pk : SourcePacket.{u}) {L : Ordinal.{u}}
    (h : pk.TargetAbove P L) :
    BlockAbove P (posBlock pk.rk.tgtKey pk.rk.tgtSel) (fun w => (pk.tgtFrame.toFr w).map pk.asg)
      L (pk.asg pk.owner) := by
  obtain ⟨β, hfix, hnew, hlt, hhold⟩ := h
  refine ⟨β, fun x o hx => ?_, fun x hx hn => (hnew x hx (Option.map_eq_none_iff.1 hn)).1,
    hlt, hhold⟩
  obtain ⟨y, hy, rfl⟩ := Option.map_eq_some_iff.1 hx
  exact hfix x y hy

/-! ## N5.5 Fresh names -/

/-- N5.5: one more than the largest role tag in a finite list of names. -/
def tagBound (l : List Name) : Nat :=
  l.foldr (fun n k => max k (match n with
    | .role t _ => t + 1
    | .aux _ => 0)) 0

/-- N5.5: names with tag `tagBound l` are fresh for `l`. -/
theorem tagBound_fresh (l : List Name) (r : Role) : Name.role (tagBound l) r ∉ l := by
  have key : ∀ (l : List Name) (t : Nat) (r' : Role), Name.role t r' ∈ l → t < tagBound l := by
    intro l
    induction l with
    | nil => intro t r' h; simp at h
    | cons n rest ih =>
      intro t r' h
      simp only [tagBound, List.foldr_cons] at ih ⊢
      rcases List.mem_cons.1 h with rfl | h
      · exact lt_max_of_lt_right (Nat.lt_succ_self t)
      · exact lt_max_of_lt_left (ih t r' h)
  intro h
  exact lt_irrefl _ (key l _ r h)

/-! ## N5.6 Prefix monotonicity of free blocks -/

/-- N5.6 (helper): roles of a concatenation of column lists. -/
theorem rolesCols_append {α : Type} (π : List (Nat × Nat)) (cs ds : List (List (α × Tree α)))
    (c : Nat) : Tree.rolesCols π c (cs ++ ds) =
      Tree.rolesCols π c cs ++ Tree.rolesCols π (c + cs.length) ds := by
  induction cs generalizing c with
  | nil => simp [Tree.rolesCols]
  | cons col rest ih =>
    simp only [List.cons_append, Tree.rolesCols, ih, List.append_assoc, List.length_cons]
    rw [show c + 1 + rest.length = c + (rest.length + 1) by omega]

/-- N5.6 (helper): a forest at a nonempty path only reads the columns it passes through. -/
theorem forestAt_cons_mono {α : Type} {cs cs' : List (List (α × Tree α))}
    (h : ∀ (i : Nat) y, cs[i]? = some y → cs'[i]? = some y) (p : Nat × Nat)
    (rest : List (Nat × Nat))
    {f : Tree α} (hf : (Tree.node cs).forestAt (p :: rest) = some f) :
    (Tree.node cs').forestAt (p :: rest) = some f := by
  obtain ⟨ci, ii⟩ := p
  simp only [Tree.forestAt, Tree.cols] at hf ⊢
  cases hc : cs[ci]? with
  | none => simp [hc] at hf
  | some col => rw [h ci col hc]; rw [hc] at hf; exact hf

/-- N5.6 (helper): columns of a tree survive appending outer columns. -/
theorem colAt_mono_cols {α : Type} {cs cs' : List (List (α × Tree α))}
    (h : ∀ (i : Nat) y, cs[i]? = some y → cs'[i]? = some y) (d : ColAddr) {x : List (α × Tree α)}
    (hx : (Tree.node cs).colAt d = some x) : (Tree.node cs').colAt d = some x := by
  unfold Tree.colAt at hx ⊢
  cases hp : d.path with
  | nil =>
    rw [hp] at hx
    simp only [Tree.forestAt, Option.bind_some, Tree.cols] at hx ⊢
    exact h _ _ hx
  | cons p rest =>
    rw [hp] at hx
    cases hf : (Tree.node cs).forestAt (p :: rest) with
    | none => rw [hf] at hx; simp at hx
    | some f => rw [hf] at hx; rw [forestAt_cons_mono h p rest hf]; exact hx

/-- N5.6 (helper): entries of a tree survive appending outer columns. -/
theorem entryAt_mono_cols {α : Type} {cs cs' : List (List (α × Tree α))}
    (h : ∀ (i : Nat) y, cs[i]? = some y → cs'[i]? = some y) (e : EntryAddr) {x : α × Tree α}
    (hx : (Tree.node cs).entryAt e = some x) : (Tree.node cs').entryAt e = some x := by
  unfold Tree.entryAt at hx ⊢
  cases hc : (Tree.node cs).colAt e.col with
  | none => rw [hc] at hx; simp at hx
  | some col => rw [hc] at hx; rw [colAt_mono_cols h _ hc]; exact hx

/-- N5.6 (helper): zips of prefixes are prefixes. -/
theorem zip_prefix {α β : Type} {l₁ l₁' : List α} {l₂ l₂' : List β} (h₁ : l₁ <+: l₁')
    (h₂ : l₂ <+: l₂') : l₁.zip l₂ <+: l₁'.zip l₂' := by
  induction l₁ generalizing l₁' l₂ l₂' with
  | nil => exact List.nil_prefix
  | cons x xs ih =>
    obtain ⟨t₁, rfl⟩ := h₁
    cases l₂ with
    | nil => exact List.nil_prefix
    | cons y ys =>
      obtain ⟨t₂, rfl⟩ := h₂
      simp only [List.cons_append, List.zip_cons_cons]
      exact (List.prefix_cons_inj _).2 (ih ⟨t₁, rfl⟩ ⟨t₂, rfl⟩)

/-- N5.6: if `K` consists of the first outer columns of `K'`, every atom of `freeBlock K` is an
atom of `freeBlock K'`, and the roles of `K` are a prefix of those of `K'`. -/
theorem freeBlock_prefix {K K' : Key} (h : K.cols = K'.cols.take K.cols.length) :
    (∀ a ∈ freeBlock K, a ∈ freeBlock K') ∧ K.roles <+: K'.roles := by
  obtain ⟨cs⟩ := K
  obtain ⟨cs'⟩ := K'
  simp only [Tree.cols] at h
  have hcs : cs' = cs ++ cs'.drop cs.length := by
    conv_lhs => rw [← List.take_append_drop cs.length cs']
    rw [← h]
  have hget : ∀ (i : Nat) y, cs[i]? = some y → cs'[i]? = some y := by
    intro i y hy
    rw [h, List.getElem?_take] at hy
    split_ifs at hy
    exact hy
  have hroles : (Tree.node cs).roles <+: (Tree.node cs').roles := by
    refine ⟨Tree.rolesCols [] (0 + cs.length) (cs'.drop cs.length), ?_⟩
    simp only [Tree.roles, Tree.rolesF]
    conv_rhs => rw [hcs]
    rw [rolesCols_append]
  refine ⟨fun a ha => ?_, hroles⟩
  have hrs := hroles.map BlkVar.inner
  have hcolA : ∀ c, c ∈ (Tree.node cs).colAddrs → c ∈ (Tree.node cs').colAddrs :=
    fun c hc => (hroles.filterMap _).subset hc
  have hentA : ∀ e, e ∈ (Tree.node cs).entryAddrs → e ∈ (Tree.node cs').entryAddrs :=
    fun e he => (hroles.filterMap _).subset he
  simp only [freeBlock, List.mem_append, List.mem_cons, List.mem_map, List.mem_filterMap,
    List.mem_flatMap] at ha ⊢
  rcases ha with ((((rfl | ⟨r, hr, rfl⟩) | ⟨xy, hxy, rfl⟩) | ⟨c, hc, hca⟩) | ⟨e, he, hea⟩)
  · exact Or.inl (Or.inl (Or.inl (Or.inl rfl)))
  · obtain ⟨r0, hr0, rfl⟩ := hr
    exact Or.inl (Or.inl (Or.inl (Or.inr ⟨_, ⟨r0, hroles.subset hr0, rfl⟩, rfl⟩)))
  · refine Or.inl (Or.inl (Or.inr ⟨xy, ?_, rfl⟩))
    exact (zip_prefix ((List.prefix_cons_inj _).2 hrs) hrs).subset hxy
  · refine Or.inl (Or.inr ⟨c, hcolA c hc, ?_⟩)
    split_ifs at hca with hs
    obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 hs
    rw [colAt_mono_cols hget _ hx]
    simpa using hca
  · refine Or.inr ⟨e, hentA e he, ?_⟩
    cases hx : (Tree.node cs).entryAt e with
    | none => rw [hx] at hea; simp at hea
    | some x => rw [hx] at hea; rw [entryAt_mono_cols hget e hx]; exact hea

/-- N5.6: the same for positive blocks with the same selector. -/
theorem posBlock_prefix {K K' : Key} (h : K.cols = K'.cols.take K.cols.length) (sel : Nat) :
    ∀ a ∈ posBlock K sel, a ∈ posBlock K' sel := by
  intro a ha
  simp only [posBlock, List.mem_append] at ha ⊢
  rcases ha with ha | ha
  · exact Or.inl ((freeBlock_prefix h).1 a ha)
  · exact Or.inr ha

/-- N5.6 (helper): prefixes of a reachable path are reachable. -/
theorem forestAt_isSome_of_prefix {α : Type} {t : Tree α} {π π' : List (Nat × Nat)}
    (h : π' <+: π) (hs : (t.forestAt π).isSome) : (t.forestAt π').isSome := by
  obtain ⟨r, rfl⟩ := h
  rw [Tree.forestAt_append] at hs
  cases hf : t.forestAt π' with
  | none => rw [hf] at hs; simp at hs
  | some f => rfl

/-- N5.6 (helper): a forest reachable through `(ck, ik)` has a column `ck`. -/
theorem cols_isSome_of_forestAt_cons {α : Type} {f : Tree α} {ck ik : Nat}
    {rest : List (Nat × Nat)} (hs : (f.forestAt ((ck, ik) :: rest)).isSome) :
    (f.cols[ck]?).isSome := by
  simp only [Tree.forestAt] at hs
  cases hc : f.cols[ck]? with
  | none => rw [hc] at hs; simp at hs
  | some _ => rfl

/-- N5.6 (helper): every column on the visible stack of a column of `t` is a column of `t`. -/
theorem colAt_isSome_of_onStack {α : Type} {t : Tree α} {c o : ColAddr}
    (hc : (t.colAt c).isSome) (ho : c.OnStack o) : (t.colAt o).isSome := by
  unfold Tree.colAt at hc ⊢
  cases hf : t.forestAt c.path with
  | none => rw [hf] at hc; simp at hc
  | some f =>
    rw [hf] at hc
    simp only [Option.bind_some] at hc
    rcases ho with ⟨k, ck, ik, hk, hop, hoc⟩ | ⟨hop, hoc⟩
    · have hsplit : c.path = c.path.take k ++ (ck, ik) :: c.path.drop (k + 1) := by
        obtain ⟨hlt, heq⟩ := List.getElem?_eq_some_iff.1 hk
        conv_lhs => rw [← List.take_append_drop k c.path]
        rw [List.drop_eq_getElem_cons hlt, heq]
      have hs : (t.forestAt c.path).isSome := by rw [hf]; rfl
      rw [hsplit, Tree.forestAt_append] at hs
      rw [hop]
      cases hg : t.forestAt (c.path.take k) with
      | none => rw [hg] at hs; simp at hs
      | some g =>
        rw [hg] at hs
        simp only [Option.bind_some] at hs ⊢
        have := cols_isSome_of_forestAt_cons hs
        rw [Option.isSome_iff_exists] at this ⊢
        obtain ⟨col, hcol⟩ := this
        have hlt : ck < g.cols.length := (List.getElem?_eq_some_iff.1 hcol).1
        exact ⟨_, List.getElem?_eq_getElem (by omega)⟩
    · rw [hop, hf]
      simp only [Option.bind_some]
      rw [Option.isSome_iff_exists] at hc ⊢
      obtain ⟨col, hcol⟩ := hc
      have hlt : c.col < f.cols.length := (List.getElem?_eq_some_iff.1 hcol).1
      exact ⟨_, List.getElem?_eq_getElem (by omega)⟩

/-- N5.6 (helper): both representatives of a resolved number seen from a column of `t` are
roles of `t`. -/
theorem rep_mem_roles {α : Type} {t : Tree α} {c : ColAddr} (hc : (t.colAt c).isSome)
    {base q : Nat} {o w : Role} (hr : c.rep base q = some (o, w)) : o ∈ t.roles ∧ w ∈ t.roles := by
  unfold ColAddr.rep at hr
  cases hres : c.resolve base q with
  | none => rw [hres] at hr; simp at hr
  | some o' =>
    rw [hres] at hr
    simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq] at hr
    obtain ⟨rfl, rfl⟩ := hr
    have hst := ((ColAddr.resolve_spec base c o' q).1 hres).1
    have ho' : (t.colAt o').isSome := colAt_isSome_of_onStack hc hst
    refine ⟨(Tree.mem_roles_iff t (.ord o')).2 ho', ?_⟩
    cases hcont : o'.container c with
    | none => exact (Tree.mem_roles_iff t (.ord o')).2 ho'
    | some e' =>
      obtain ⟨-, hpre⟩ := (ColAddr.container_spec o' c e').1 hcont
      have hpath : (t.forestAt c.path).isSome := by
        unfold Tree.colAt at hc
        cases hf : t.forestAt c.path with
        | none => rw [hf] at hc; simp at hc
        | some _ => rfl
      have hh := forestAt_isSome_of_prefix hpre hpath
      rw [Tree.forestAt_heightPath] at hh
      refine (Tree.mem_roles_iff t (.slot e')).2 ?_
      show (t.entryAt e').isSome = true
      unfold Tree.heightAt at hh
      cases he : t.entryAt e' with
      | none => rw [he] at hh; simp at hh
      | some _ => rfl

/-- N5.6 [V-fix, new]: the variables of a positive (hence of a free) block are the frame
variables, the owner, and `inner r` for internal roles `r` of `K` only. -/
theorem posBlock_vars (K : Key) (sel : Nat) :
    ∀ w ∈ baseVars (posBlock K sel), w = .host ∨ w = .owner ∨ (∃ q, w = .ord q ∨ w = .cur q) ∨
      ∃ r ∈ K.roles, w = .inner r := by
  intro w hw
  simp only [baseVars, List.mem_flatMap] at hw
  obtain ⟨b, hb, hwb⟩ := hw
  simp only [posBlock, freeBlock, List.mem_append, List.mem_cons, List.mem_map,
    List.mem_filterMap, List.mem_flatMap, List.not_mem_nil] at hb
  suffices H : ∀ x ∈ b.vars, x = .host ∨ x = .owner ∨ (∃ q, x = .ord q ∨ x = .cur q) ∨
      ∃ r ∈ K.roles, x = .inner r from H w hwb
  clear hwb w
  have gI : ∀ r ∈ K.roles, BlkVar.inner r = .host ∨ BlkVar.inner r = .owner ∨
      (∃ q, BlkVar.inner r = .ord q ∨ BlkVar.inner r = .cur q) ∨
      ∃ r' ∈ K.roles, BlkVar.inner r = .inner r' := fun r hr => Or.inr (Or.inr (Or.inr ⟨r, hr, rfl⟩))
  have hcolR : ∀ c, c ∈ K.colAddrs → Role.ord c ∈ K.roles := by
    intro c hc
    obtain ⟨x, hx, hxc⟩ := List.mem_filterMap.1 hc
    cases x with
    | ord d => cases hxc; exact hx
    | slot _ => cases hxc
  have hentR : ∀ e, e ∈ K.entryAddrs → Role.slot e ∈ K.roles := by
    intro e he
    obtain ⟨x, hx, hxe⟩ := List.mem_filterMap.1 he
    cases x with
    | slot d => cases hxe; exact hx
    | ord _ => cases hxe
  rcases hb with ((((rfl | ⟨_, ⟨r, hr, rfl⟩, rfl⟩) | ⟨xy, hxy, rfl⟩) | ⟨c, hc, hca⟩) |
    ⟨e, he, hea⟩) | rfl | rfl | hF
  · simp [BaseAtom.vars]
  · simp only [BaseAtom.vars, List.mem_singleton, forall_eq]; exact gI r hr
  · obtain ⟨h1, h2⟩ := List.of_mem_zip hxy
    simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false, forall_eq_or_imp,
      forall_eq]
    obtain ⟨r2, hr2, hr2'⟩ := List.mem_map.1 h2
    refine ⟨?_, hr2' ▸ gI r2 hr2⟩
    rcases List.mem_cons.1 h1 with h1 | h1
    · exact Or.inr (Or.inl h1)
    · obtain ⟨r1, hr1, hr1'⟩ := List.mem_map.1 h1
      exact hr1' ▸ gI r1 hr1
  · split_ifs at hca with hs
    cases hca
    simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false, forall_eq_or_imp,
      forall_eq]
    exact ⟨gI _ (hcolR c hc), gI _ ((Tree.mem_roles_iff K (.ord _)).2 hs)⟩
  · have hslot := hentR e he
    cases hx : K.entryAt e with
    | none => rw [hx] at hea; simp at hea
    | some x =>
      obtain ⟨⟨bb, q⟩, h⟩ := x
      have hcol : Role.ord e.col ∈ K.roles := by
        obtain ⟨col, hcol, -⟩ := Tree.colAt_of_entryAt hx
        exact (Tree.mem_roles_iff K (.ord e.col)).2 (show (K.colAt e.col).isSome by
          rw [hcol]; rfl)
      rw [hx] at hea
      cases bb with
      | false =>
        simp only [List.mem_cons, List.mem_nil_iff, or_false] at hea
        rcases hea with rfl | rfl <;>
          simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false, forall_eq_or_imp,
            forall_eq] <;>
          exact ⟨gI _ hslot, gI _ hcol, by simp⟩
      | true =>
        cases q with
        | zero =>
          simp only [List.mem_cons, List.mem_nil_iff, or_false] at hea
          rcases hea with rfl | rfl <;>
            simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false,
              forall_eq_or_imp, forall_eq] <;>
            exact ⟨gI _ hslot, gI _ hcol, by simp⟩
        | succ v =>
          simp only at hea
          cases hr : e.col.rep 1 (v + 1) with
          | none => rw [hr] at hea; simp at hea
          | some ow =>
            obtain ⟨o, w'⟩ := ow
            rw [hr] at hea
            have hcs : (K.colAt e.col).isSome := (Tree.mem_roles_iff K (.ord e.col)).1 hcol
            obtain ⟨ho, hw'⟩ := rep_mem_roles hcs hr
            simp only [List.mem_cons, List.mem_nil_iff, or_false] at hea
            rcases hea with rfl | rfl <;>
              simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false,
                forall_eq_or_imp, forall_eq]
            · exact ⟨gI _ hslot, gI _ hcol, gI _ ho⟩
            · exact ⟨gI _ hslot, gI _ hcol, gI _ hw'⟩
  · simp [BaseAtom.vars]
  · simp [BaseAtom.vars]
  · exact hF.elim

/-! ## N5.8 Projections of packet validity -/

/-- N5.8 (helper): the three blocks of the joint diagram hold. -/
theorem joint_holds {P : Prims.{u}} (pk : SourcePacket.{u}) (hv : pk.Valid P) :
    BaseHolds P (prefixGraph pk.rk.E pk.rk.b) (pk.asg ∘ pk.tgtChart) ∧
      BaseHolds P (graph pk.rk.F) (pk.asg ∘ pk.srcChart) ∧ pk.aux.Holds P pk.asg := by
  have hj : pk.joint.Holds P pk.asg := hv.2.2.2.2.1
  have h1 : (Diagram.ofBase ((prefixGraph pk.rk.E pk.rk.b).map
      (BaseAtom.map pk.tgtChart))).Holds P pk.asg :=
    fun x hx => hj x (List.mem_append.2 (Or.inl (List.mem_append.2 (Or.inl hx))))
  have h2 : (Diagram.ofBase ((graph pk.rk.F).map (BaseAtom.map pk.srcChart))).Holds P pk.asg :=
    fun x hx => hj x (List.mem_append.2 (Or.inl (List.mem_append.2 (Or.inr hx))))
  rw [holds_ofBase, baseHolds_map'] at h1 h2
  exact ⟨h1, h2, fun x hx => hj x (List.mem_append.2 (Or.inr hx))⟩

/-- N5.8: the source context is configured by `asg ∘ srcChart` (Valid clause 4). -/
theorem valid_src_config {P : Prims.{u}} (pk : SourcePacket.{u}) (hv : pk.Valid P) :
    IsConfig P pk.rk.F (pk.asg ∘ pk.srcChart) :=
  (joint_holds pk hv).2.1

/-- N5.8: the target prefix graph holds through `tgtChart` (Valid clause 4). -/
theorem valid_tgt_prefix {P : Prims.{u}} (pk : SourcePacket.{u}) (hv : pk.Valid P) :
    BaseHolds P (prefixGraph pk.rk.E pk.rk.b) (pk.asg ∘ pk.tgtChart) :=
  (joint_holds pk hv).1

/-- N5.8: the auxiliary diagram holds (Valid clause 4). -/
theorem valid_aux {P : Prims.{u}} (pk : SourcePacket.{u}) (hv : pk.Valid P) :
    pk.aux.Holds P pk.asg :=
  (joint_holds pk hv).2.2

/-- N5.8: the host and the target frame names are low; the owner is not. -/
theorem lowNames_spec {P : Prims.{u}} (pk : SourcePacket.{u}) (hadm : pk.rk.Admitted)
    (hv : pk.Valid P) :
    pk.host ∈ pk.lowNames ∧ (∀ ov ∈ pk.tgtFrame.reps, ov.1 ∈ pk.lowNames ∧ ov.2 ∈ pk.lowNames) ∧
      pk.tgtFrame.host ∈ pk.lowNames ∧ pk.owner ∉ pk.lowNames := by
  obtain ⟨-, hb, ha, -⟩ := hadm
  have hlow : ∀ x ∈ pk.lowNames, pk.asg x < pk.asg pk.owner := hv.2.2.2.2.2.2
  have hT : ∀ x ∈ prefixRoles pk.rk.E pk.rk.b, pk.tgtChart x ∈ pk.lowNames := fun x hx =>
    List.mem_append.2 (Or.inl (List.mem_append.2 (Or.inl (List.mem_map_of_mem hx))))
  have hS : ∀ x ∈ prefixRoles pk.rk.F pk.rk.a, pk.srcChart x ∈ pk.lowNames := fun x hx =>
    List.mem_append.2 (Or.inl (List.mem_append.2 (Or.inr (List.mem_map_of_mem hx))))
  obtain ⟨hbcol, hbreps⟩ := frameOf_mem_prefix hb
  refine ⟨hS _ (frameOf_mem_prefix ha).1, fun ov hov => ?_, hT _ hbcol,
    fun h => lt_irrefl _ (hlow _ h)⟩
  simp only [SourcePacket.tgtFrame, Frame.map, frameOf, List.mem_map] at hov
  obtain ⟨ov0, hov0, rfl⟩ := hov
  exact ⟨hT _ (hbreps ov0 hov0).1, hT _ (hbreps ov0 hov0).2⟩

/-! ## L6.7 Seed lemma -/

/-- L6.7a: the column `A_i` of the seed `L_m` (`A_0` the empty outer column; `A_1` the second
outer column; `A_{i+2}` the column of the height of `U_{i+1}`). -/
def seedCol : Nat → ColAddr
  | 0 => ⟨[], 0⟩
  | 1 => ⟨[], 1⟩
  | i + 2 => ⟨(1, 0) :: List.replicate i (0, 0), 0⟩

/-- L6.7a: the ordinary role `A_i`. -/
def seedA (i : Nat) : Role := .ord (seedCol i)

/-- L6.7a: the slot `U_i` (`i ≥ 1`). -/
def seedU (i : Nat) : Role := .slot ⟨seedCol i, 0⟩

/-- L6.7a: reading order of `L_{m+1}`: `A_0, A_1, U_1, …, A_{m+1}, U_{m+1}` (txt:1001). -/
def seedRoles (m : Nat) : List Role :=
  seedA 0 :: (List.range (m + 1)).flatMap fun i => [seedA (i + 1), seedU (i + 1)]

/-- L6.7a: the graph of `L_{m+1}` (txt:1001-1004): limits, the reading chain, the outer pair
`A_0 ≺ A_1`, and the edges `R(U_1,A_1,A_0)` (twice), `R(U_i,A_i,A_{i-1})`, `R(U_i,A_i,U_{i-1})`. -/
def seedGraph (m : Nat) : List (BaseAtom Role) :=
  let rs := seedRoles m
  rs.map BaseAtom.lim ++ (rs.zip rs.tail).map (fun xy => BaseAtom.lt xy.1 xy.2) ++
  [BaseAtom.elem (seedA 0) (seedA 1)] ++
  (List.range (m + 1)).flatMap fun i =>
    [BaseAtom.edge (seedU (i + 1)) (seedA (i + 1)) (seedA i),
     BaseAtom.edge (seedU (i + 1)) (seedA (i + 1)) (if i = 0 then seedA 0 else seedU i)]

/-- L6.7a (helper): roles of a branch column. -/
theorem rolesCol_branch (π : List (Nat × Nat)) (c i k : Nat) :
    Tree.rolesCol π c 0 (branch i k) = .slot ⟨⟨π, c⟩, 0⟩ ::
      (List.range k).flatMap fun j => [Role.ord ⟨π ++ (c, 0) :: List.replicate j (0, 0), 0⟩,
        Role.slot ⟨⟨π ++ (c, 0) :: List.replicate j (0, 0), 0⟩, 0⟩] := by
  induction k generalizing π c i with
  | zero => simp [branch, Tree.rolesCol, Tree.rolesF, Tree.rolesCols, Tree.empty]
  | succ k ih =>
    simp only [branch, Tree.rolesCol, Tree.rolesF, Tree.rolesCols, ih, List.append_nil,
      List.range_succ_eq_map, List.flatMap_cons, List.flatMap_map, List.replicate,
      List.cons_append, List.nil_append]
    simp [List.append_assoc]

/-- L6.7a (testable; checked by `#eval` for `m ≤ 6`). -/
theorem seed_roles (m : Nat) : (seed (m + 1)).roles = seedRoles m := by
  simp [seed, Tree.roles, Tree.rolesF, Tree.rolesCols, Tree.rolesCol, rolesCol_branch,
    seedRoles, seedA, seedU, seedCol, List.range_succ_eq_map, List.flatMap_map]

/-- L6.7a (helper): the forest under `j` first entries of a branch. -/
theorem forestAt_branch : ∀ (j i k : Nat), j ≤ k →
    (Tree.node [branch i k]).forestAt (List.replicate j (0, 0)) =
      some (Tree.node [branch (i + j) (k - j)])
  | 0, i, k, _ => by simp [Tree.forestAt]
  | j + 1, i, k + 1, h => by
    simp only [List.replicate, Tree.forestAt, Tree.cols, branch]
    simp only [List.getElem?_cons_zero, Option.bind_some]
    rw [forestAt_branch j (i + 1) k (by omega), show i + (j + 1) = i + 1 + j by omega,
      show k + 1 - (j + 1) = k - j by omega]
  | j + 1, _, 0, h => absurd h (by omega)

/-- L6.7a (helper): the forest at the path of `seedCol (j + 2)`. -/
theorem forestAt_seed {m j : Nat} (hj : j < m) :
    (seed (m + 1)).forestAt ((1, 0) :: List.replicate j (0, 0)) =
      some (Tree.node [branch (1 + j) (m - 1 - j)]) := by
  obtain ⟨m', rfl⟩ : ∃ m', m = m' + 1 := ⟨m - 1, by omega⟩
  simp only [seed, Tree.forestAt, Tree.cols, branch, List.getElem?_cons_succ,
    List.getElem?_cons_zero, Option.bind_some]
  rw [forestAt_branch j 1 m' (by omega), show m' + 1 - 1 - j = m' - j by omega]

/-- L6.7a (helper): the first entry of a branch has parent `i`. -/
theorem branch_head (i k : Nat) : ∃ h, branch i k = [(i, h)] := by
  cases k <;> exact ⟨_, rfl⟩

/-- L6.7a (helper): the entry `U_{i+1}` of the seed has parent `i`. -/
theorem entryAt_seed {m i : Nat} (hi : i ≤ m) :
    ∃ h, (seed (m + 1)).entryAt ⟨seedCol (i + 1), 0⟩ = some (i, h) := by
  cases i with
  | zero =>
    obtain ⟨h, hh⟩ := branch_head 0 m
    exact ⟨h, by simp [Tree.entryAt, Tree.colAt, Tree.forestAt, Tree.cols, seedCol, seed, hh]⟩
  | succ j =>
    obtain ⟨h, hh⟩ := branch_head (j + 1) (m - 1 - j)
    refine ⟨h, ?_⟩
    simp only [Tree.entryAt, Tree.colAt, seedCol]
    rw [forestAt_seed (by omega), Nat.add_comm 1 j]
    simp [Tree.cols, hh]

/-- L6.7a (helper): resolution along a run of first entries. -/
theorem resolveAux_replicate : ∀ (n s : Nat) (pre : List (Nat × Nat)) (q : Nat), s ≤ q →
    q < s + n → ColAddr.resolveAux s pre (List.replicate n (0, 0)) 0 q =
      some ⟨pre ++ List.replicate (q - s) (0, 0), 0⟩
  | 0, s, pre, q, h1, h2 => absurd h2 (by omega)
  | n + 1, s, pre, q, h1, h2 => by
    simp only [List.replicate, ColAddr.resolveAux, Nat.add_zero]
    by_cases hq : q = s
    · subst hq; simp
    · rw [if_neg (by omega), resolveAux_replicate n (s + 1) _ q (by omega) (by omega)]
      obtain ⟨d, hd⟩ : ∃ d, q - s = d + 1 := ⟨q - s - 1, by omega⟩
      rw [hd, show q - (s + 1) = d by omega]
      simp [List.replicate]

/-- L6.7a (helper): the representatives of the parent of `U_{i+1}` (`[R9]` for `i ≥ 1`). -/
theorem rep_seed (i : Nat) :
    (seedCol (i + 1)).rep 0 i = some (seedA i, if i = 0 then seedA 0 else seedU i) := by
  match i with
  | 0 => rfl
  | 1 => rfl
  | j + 2 =>
    have hres : (seedCol (j + 3)).resolve 0 (j + 2) = some (seedCol (j + 2)) := by
      show ColAddr.resolveAux 0 [] ((1, 0) :: List.replicate (j + 1) (0, 0)) 0 (j + 2) = _
      simp only [ColAddr.resolveAux]
      rw [if_neg (by omega), resolveAux_replicate (j + 1) _ _ (j + 2) (by omega) (by omega)]
      simp [seedCol]
    have hcont : (seedCol (j + 2)).container (seedCol (j + 3)) = some ⟨seedCol (j + 2), 0⟩ := by
      simp only [ColAddr.container, seedCol, List.length_cons, List.length_replicate,
        List.drop_succ_cons, List.drop_replicate, List.take_succ_cons, List.take_replicate]
      simp
    simp only [ColAddr.rep, hres, Option.map_some, hcont, seedA, seedU]
    simp

/-- L6.7a (testable; checked by `#eval` for `m ≤ 6`). -/
theorem seed_graph_sub (m : Nat) : ∀ a ∈ graph (seed (m + 1)), a ∈ seedGraph m := by
  intro a ha
  have hr := seed_roles m
  have hmem : ∀ x ∈ seedRoles m,
      x = seedA 0 ∨ ∃ i, i ≤ m ∧ (x = seedA (i + 1) ∨ x = seedU (i + 1)) := by
    intro x hx
    simp only [seedRoles, List.mem_cons, List.mem_flatMap, List.mem_range] at hx
    rcases hx with rfl | ⟨i, hi, hx⟩
    · exact Or.inl rfl
    · simp only [List.mem_nil_iff, or_false] at hx
      exact Or.inr ⟨i, by omega, hx⟩
  simp only [graph, List.mem_append] at ha
  unfold seedGraph
  simp only [List.mem_append]
  rcases ha with ((h1 | h2) | h3) | h4
  · rw [hr] at h1; exact Or.inl (Or.inl (Or.inl h1))
  · rw [hr] at h2; exact Or.inl (Or.inl (Or.inr h2))
  · obtain ⟨c, hc, hca⟩ := List.mem_filterMap.1 h3
    have hcr : Role.ord c ∈ seedRoles m := by
      rw [← hr]
      obtain ⟨x, hx, hxc⟩ := List.mem_filterMap.1 hc
      cases x with
      | ord d => cases hxc; exact hx
      | slot _ => cases hxc
    split_ifs at hca with hs
    cases hca
    rcases hmem _ hcr with h0 | ⟨i, hi, hx | hx⟩
    · simp only [seedA, Role.ord.injEq] at h0
      subst h0
      exact Or.inl (Or.inr (by simp [seedA, seedCol]))
    · simp only [seedA, Role.ord.injEq] at hx
      subst hx
      exfalso
      cases i with
      | zero => simp [seedCol, Tree.colAt, Tree.forestAt, seed, Tree.cols] at hs
      | succ j =>
        simp only [seedCol, Tree.colAt] at hs
        rw [forestAt_seed (by omega)] at hs
        simp [Tree.cols] at hs
    · simp [seedU] at hx
  · obtain ⟨e, he, hea⟩ := List.mem_flatMap.1 h4
    have her : Role.slot e ∈ seedRoles m := by
      rw [← hr]
      obtain ⟨x, hx, hxe⟩ := List.mem_filterMap.1 he
      cases x with
      | slot d => cases hxe; exact hx
      | ord _ => cases hxe
    rcases hmem _ her with h0 | ⟨i, hi, hx | hx⟩
    · simp [seedA] at h0
    · simp [seedA] at hx
    · simp only [seedU, Role.slot.injEq] at hx
      subst hx
      obtain ⟨h, hh⟩ := entryAt_seed hi
      rw [hh] at hea
      simp only [rep_seed] at hea
      refine Or.inr (List.mem_flatMap.2 ⟨i, List.mem_range.2 (by omega), ?_⟩)
      simpa [seedU, seedA] using hea

/-- L6.7a: `L_0 = ()` has one role and one atom (testable). -/
theorem seed_zero_graph : (seed 0).roles = [.ord ⟨[], 0⟩] ∧
    graph (seed 0) = [BaseAtom.lim (.ord ⟨[], 0⟩)] :=
  ⟨rfl, rfl⟩

/-- L6.7b: the descending Mahlo chain (txt:1005-1011): from a weakly `k`-Mahlo `κ` and a limit
`w > κ`, values `a_0 < a_1 < v_1 < … < a_{k+1} = κ < v_{k+1} = w` with all seed edges. -/
theorem mahlo_chain (I : Interface.{u}) : ∀ (k : Nat) (κ : Cardinal.{u}) (w : Ordinal.{u}),
    IsWeaklyMahlo k κ → IsLim w → κ.ord < w →
    ∃ a v : Nat → Ordinal.{u}, a (k + 1) = κ.ord ∧ v (k + 1) = w ∧
      (∀ i, i ≤ k → I.Edge (v (i + 1)) (a (i + 1)) (a i)) ∧
      (∀ i, 1 ≤ i → i ≤ k → I.Edge (v (i + 1)) (a (i + 1)) (v i)) ∧
      (∀ i, 1 ≤ i → i ≤ k + 1 → a i < v i) := by
  intro k
  induction k with
  | zero =>
    intro κ w hκ hw hκw
    obtain ⟨hunc, hreg⟩ := hκ.uncountable_regular
    obtain ⟨C, hC, hCe⟩ := I.club_edge κ w hunc hreg hw hκw
    have h0 : (0 : Ordinal.{u}) < κ.ord := Ordinal.omega0_pos.trans (isLim_ord hunc).2
    obtain ⟨x, hxC, -⟩ := IsClub.exists_gt_ord hunc hC h0
    refine ⟨fun i => if i = 0 then x.1 else κ.ord, fun _ => w, rfl, rfl, ?_, ?_, ?_⟩
    · intro i hi
      obtain rfl : i = 0 := by omega
      simpa using hCe x hxC
    · intro i h1 h2; omega
    · intro i h1 h2
      obtain rfl : i = 1 := by omega
      simpa using hκw
  | succ k ih =>
    intro κ w hκ hw hκw
    obtain ⟨hunc, hreg⟩ := hκ.uncountable_regular
    obtain ⟨C, hC, hCe⟩ := I.club_edge κ w hunc hreg hw hκw
    obtain ⟨x, hxC, μ, hμ, hμx⟩ := StationaryIn.exists_mem_club hκ.stationary_pred hC
    obtain ⟨y, hyC, hxy⟩ := IsClub.exists_gt_ord hunc hC x.2
    have hylim : IsLim y.1 := (I.edge_lim (hCe y hyC)).1
    obtain ⟨a, v, ha, hv, h1, h2, h3⟩ := ih μ y.1 hμ hylim (hμx ▸ hxy)
    refine ⟨fun i => if i = k + 2 then κ.ord else a i, fun i => if i = k + 2 then w else v i,
      by simp, by simp, ?_, ?_, ?_⟩
    · intro i hi
      by_cases hik : i = k + 1
      · subst hik
        simp only [if_neg (show k + 1 ≠ k + 2 by omega), ha, hμx]
        exact hCe x hxC
      · simp only [if_neg (show i + 1 ≠ k + 2 by omega), if_neg (show i ≠ k + 2 by omega)]
        exact h1 i (by omega)
    · intro i hi1 hi2
      by_cases hik : i = k + 1
      · subst hik
        simp only [if_neg (show k + 1 ≠ k + 2 by omega), hv]
        exact hCe y hyC
      · simp only [if_neg (show i + 1 ≠ k + 2 by omega), if_neg (show i ≠ k + 2 by omega)]
        exact h2 i hi1 (by omega)
    · intro i hi1 hi2
      by_cases hik : i = k + 2
      · subst hik
        simpa using hκw
      · simp only [if_neg hik]
        exact h3 i hi1 (by omega)

/-- L6.7c: the seed assignment `A_i ↦ a_i`, `U_i ↦ v_i`. -/
noncomputable def seedVal (a v : Nat → Ordinal.{u}) : Role → Ordinal.{u}
  | .ord c => if c = ⟨[], 0⟩ then a 0 else a (c.path.length + 1)
  | .slot e => v (e.col.path.length + 1)

/-- L6.7c (helper): `seedVal` on the ordinary seed roles. -/
theorem seedVal_A (a v : Nat → Ordinal.{u}) (i : Nat) : seedVal a v (seedA i) = a i := by
  match i with
  | 0 => simp [seedVal, seedA, seedCol]
  | 1 => simp [seedVal, seedA, seedCol]
  | j + 2 => simp [seedVal, seedA, seedCol]

/-- L6.7c (helper): `seedVal` on the seed slots. -/
theorem seedVal_U (a v : Nat → Ordinal.{u}) (i : Nat) : seedVal a v (seedU (i + 1)) = v (i + 1) := by
  match i with
  | 0 => simp [seedVal, seedU, seedCol]
  | j + 1 => simp [seedVal, seedU, seedCol]

/-- L6.7c (helper): the reading order of `L_{m+2}` extends that of `L_{m+1}`. -/
theorem seedRoles_succ (m : Nat) :
    seedRoles (m + 1) = seedRoles m ++ [seedA (m + 2), seedU (m + 2)] := by
  simp [seedRoles, List.range_succ (n := m + 1), List.flatMap_append]

/-- L6.7c (helper): the last seed role is `U_{m+1}`. -/
theorem seedRoles_getLast? (m : Nat) : (seedRoles m).getLast? = some (seedU (m + 1)) := by
  cases m with
  | zero => rfl
  | succ m => rw [seedRoles_succ]; simp

/-- L6.7c (helper): a chain gives the relation on consecutive pairs. -/
theorem zip_tail_of_isChain {α : Type} {R : α → α → Prop} :
    ∀ {l : List α}, List.IsChain R l → ∀ xy ∈ l.zip l.tail, R xy.1 xy.2
  | [], _, xy, h => by simp at h
  | [_], _, xy, h => by simp at h
  | x :: y :: l, hc, xy, h => by
    rw [List.isChain_cons_cons] at hc
    simp only [List.tail_cons, List.zip_cons_cons, List.mem_cons] at h
    rcases h with rfl | h
    · exact hc.1
    · exact zip_tail_of_isChain hc.2 xy (by simpa using h)

/-- L6.7c: a Mahlo chain realizes the seed graph. -/
theorem seedGraph_holds (I : Interface.{u}) {m : Nat} {a v : Nat → Ordinal.{u}}
    (h1 : ∀ i, i ≤ m → I.Edge (v (i + 1)) (a (i + 1)) (a i))
    (h2 : ∀ i, 1 ≤ i → i ≤ m → I.Edge (v (i + 1)) (a (i + 1)) (v i))
    (h3 : ∀ i, 1 ≤ i → i ≤ m + 1 → a i < v i) :
    BaseHolds I.toPrims (seedGraph m) (seedVal a v) := by
  have hchain : ∀ m', m' ≤ m →
      List.IsChain (fun x y => seedVal a v x < seedVal a v y) (seedRoles m') := by
    intro m' hm'
    induction m' with
    | zero =>
      have := I.edge_lt (h1 0 (Nat.zero_le _))
      have hU1 : seedVal a v (seedU 1) = v 1 := seedVal_U a v 0
      show List.IsChain _ [seedA 0, seedA 1, seedU 1]
      simp only [List.isChain_cons_cons, List.isChain_singleton, and_true, seedVal_A, hU1]
      exact this
    | succ k ih =>
      rw [seedRoles_succ]
      refine (ih (by omega)).append (List.isChain_pair.2 ?_) ?_
      · rw [seedVal_A, seedVal_U]
        exact h3 (k + 2) (by omega) (by omega)
      · intro x hx y hy
        rw [seedRoles_getLast?, Option.mem_some_iff] at hx
        simp only [List.head?_cons, Option.mem_some_iff] at hy
        subst hx hy
        rw [seedVal_A, seedVal_U]
        exact (I.edge_lt (h2 (k + 1) (by omega) hm')).1
  have hlim : ∀ x ∈ seedRoles m, IsLim (seedVal a v x) := by
    intro x hx
    simp only [seedRoles, List.mem_cons, List.mem_flatMap, List.mem_range] at hx
    rcases hx with rfl | ⟨i, hi, hx⟩
    · rw [seedVal_A]; exact (I.edge_lim (h1 0 (Nat.zero_le _))).1
    · simp only [List.mem_nil_iff, or_false] at hx
      rcases hx with rfl | rfl
      · rw [seedVal_A]; exact (I.edge_lim (h1 i (by omega))).2.1
      · rw [seedVal_U]; exact (I.edge_lim (h1 i (by omega))).2.2
  intro b hb
  simp only [seedGraph, List.mem_append, List.mem_map, List.mem_singleton, List.mem_flatMap,
    List.mem_range] at hb
  rcases hb with (((⟨x, hx, rfl⟩ | ⟨xy, hxy, rfl⟩) | rfl) | ⟨i, hi, hb⟩)
  · exact hlim x hx
  · exact zip_tail_of_isChain (hchain m le_rfl) xy hxy
  · show I.Elem (seedVal a v (seedA 0)) (seedVal a v (seedA 1))
    rw [seedVal_A, seedVal_A]
    exact I.edge_elem_low (h1 0 (Nat.zero_le _))
  · simp only [List.mem_cons, List.mem_nil_iff, or_false] at hb
    rcases hb with rfl | rfl
    · show I.Edge _ _ _
      rw [seedVal_U, seedVal_A, seedVal_A]
      exact h1 i (by omega)
    · show I.Edge _ _ _
      rw [seedVal_U, seedVal_A]
      split_ifs with h0
      · subst h0; rw [seedVal_A]; exact h1 0 (Nat.zero_le _)
      · obtain ⟨j, rfl⟩ : ∃ j, i = j + 1 := ⟨i - 1, by omega⟩
        rw [seedVal_U]
        exact h2 (j + 1) (by omega) (by omega)

-- provides: U5, L6.7 (seed lemma); moved here from `Plan/Spine.lean` (brief rule 5): its proof uses
-- L6.7a–c and N5.4, declared in this file; nothing between the two places uses it.
/-- L6.7: every seed `L_m` has a configuration, given a weakly `(m-1)`-Mahlo cardinal. -/
theorem seed_config (I : Interface.{u}) (m : Nat)
    (hM : ∃ κ : Cardinal.{u}, IsWeaklyMahlo (m - 1) κ) : ∃ α, IsConfig I.toPrims (seed m) α := by
  obtain ⟨κ, hκ⟩ := hM
  obtain ⟨hunc, -⟩ := hκ.uncountable_regular
  cases m with
  | zero =>
    refine ⟨fun _ => κ.ord, fun b hb => ?_⟩
    rw [seed_zero_graph.2, List.mem_singleton] at hb
    subst hb
    exact isLim_ord hunc
  | succ m =>
    have hκ' : IsWeaklyMahlo m κ := by simpa using hκ
    obtain ⟨hwl, hκw⟩ := isLim_add_omega (isLim_ord hunc).2.le
    obtain ⟨a, v, -, -, h1, h2, h3⟩ := mahlo_chain I m κ _ hκ' hwl hκw
    exact ⟨seedVal a v, fun b hb => seedGraph_holds I h1 h2 h3 b (seed_graph_sub m b hb)⟩

/-! ## D8.1 / §8.1: failures, (19), the two-candidate fact, `S_0` -/

/-- D8.1b: a failure of `S_n` at floor `L`. -/
def Fails (P : Prims.{u}) (n : Nat) (pk : SourcePacket.{u}) (L : Ordinal.{u}) : Prop :=
  pk.rk.Admitted ∧ pk.Valid P ∧ pk.rk.tgtHeight.size = n ∧ L < pk.asg pk.owner ∧
    ¬ pk.TargetAbove P L

/-- D8.1b: the host-owner pair `(ρ, u)` of a packet, lexicographically ordered. -/
noncomputable def failPair (pk : SourcePacket.{u}) : Ordinal.{u} ×ₗ Ordinal.{u} :=
  toLex (pk.asg pk.host, pk.asg pk.owner)

/-- L8.2a: the elementarity atoms of `Γ(E)` that touch entry `e` (its slot or its height). -/
def localStruct (E : Forest) (e : EntryAddr) : List (BaseAtom Role) :=
  (graph E).filter fun a => isStruct a && a.vars.any fun v => v.inEntry e

/-- L8.2a: consecutive columns of one forest give an ordinary pair. -/
theorem elem_col_succ {E : Forest} {c : ColAddr} (hc : c ∈ E.colAddrs)
    (hs : (E.colAt ⟨c.path, c.col + 1⟩).isSome) :
    BaseAtom.elem (.ord c) (.ord ⟨c.path, c.col + 1⟩) ∈ graph E := by
  simp only [graph, List.mem_append]
  exact Or.inl (Or.inr (List.mem_filterMap.2 ⟨c, hc, by simp [hs]⟩))

/-- L8.2a (helper): both head edges of an entry `e` with parent `p` and representatives
`(o, v)` of `p` are atoms of `Γ(E)`. -/
theorem edge_mem_graph {E : Forest} {e : EntryAddr} (he : e ∈ E.entryAddrs) {p : Nat}
    {h : Forest} (hx : E.entryAt e = some (p, h)) {o v : Role} (hr : e.col.rep 0 p = some (o, v)) :
    BaseAtom.edge (.slot e) (.ord e.col) o ∈ graph E ∧
      BaseAtom.edge (.slot e) (.ord e.col) v ∈ graph E := by
  simp only [graph, List.mem_append]
  constructor <;> refine Or.inr (List.mem_flatMap.2 ⟨e, he, ?_⟩) <;> simp [hx, hr]

/-- L8.2a: under V an entry's column steps to its slot (`edge U_e A_c _`). -/
theorem step_col_slot {E : Forest} (hV : Scan.CondV E) {e : EntryAddr} (he : e ∈ E.entryAddrs) :
    ∃ o, BaseAtom.edge (.slot e) (.ord e.col) o ∈ graph E := by
  obtain ⟨⟨p, h⟩, hx⟩ := Option.isSome_iff_exists.1 ((Tree.mem_entryAddrs_iff E e).1 he)
  have hs : (e.col.rep 0 p).isSome := by
    simp only [ColAddr.rep, Option.isSome_map]; exact hV e he p h hx
  obtain ⟨⟨o, v⟩, hr⟩ := Option.isSome_iff_exists.1 hs
  exact ⟨_, (edge_mem_graph he hx hr).1⟩

/-- L8.2a: under V and I a slot with nonempty height steps to the height's first column: the
first parent there is the host number, read as `P(host) = U_e` (txt:1194-1195). -/
theorem step_slot_child {E : Forest} (hV : Scan.CondV E) (hI : Scan.CondI E) {e : EntryAddr}
    (he : e ∈ E.entryAddrs) {h : Forest} (hh : E.heightAt e = some h) (hne : h ≠ Tree.empty) :
    BaseAtom.edge (.slot ⟨⟨e.heightPath, 0⟩, 0⟩) (.ord ⟨e.heightPath, 0⟩) (.slot e) ∈ graph E := by
  obtain ⟨H₀, rest, hhd⟩ := Scan.firstParent_host hV hI he hh hne
  have hx : E.entryAt ⟨⟨e.heightPath, 0⟩, 0⟩ = some (e.col.num 0, H₀) := by
    simp only [Tree.entryAt, Tree.colAt, Tree.forestAt_heightPath, hh, Option.bind_some]
    rw [← List.head?_eq_getElem?, hhd]
    rfl
  have he₀ : (⟨⟨e.heightPath, 0⟩, 0⟩ : EntryAddr) ∈ E.entryAddrs :=
    (Tree.mem_entryAddrs_iff E _).2 (by rw [hx]; rfl)
  exact (edge_mem_graph he₀ hx (rep_inside e ⟨e.heightPath, 0⟩ (List.prefix_refl _)).2.1).2

/-- L8.2b (helper): `inEntry` unfolded. -/
theorem inEntry_iff (x : Role) (e : EntryAddr) :
    x.inEntry e = true ↔ x = .slot e ∨ e.heightPath <+: x.path := by
  simp [Role.inEntry]

/-- L8.2b (helper): a structural atom of `Γ(E)` reading a role inside `e` touches `e`. -/
theorem mem_localStruct {E : Forest} {e : EntryAddr} {a : BaseAtom Role} (ha : a ∈ graph E)
    (hs : isStruct a = true) {v : Role} (hv : v ∈ a.vars) (hin : v.inEntry e = true) :
    a ∈ localStruct E e :=
  List.mem_filter.2 ⟨ha, by simp only [hs, Bool.true_and, List.any_eq_true]; exact ⟨v, hv, hin⟩⟩

/-- L8.2b (helper): atoms touching an entry inside `e` touch `e`. -/
theorem localStruct_mono {E : Forest} {e e' : EntryAddr} (h : e.heightPath <+: e'.col.path) :
    ∀ a ∈ localStruct E e', a ∈ localStruct E e := by
  intro a ha
  obtain ⟨hg, hs⟩ := List.mem_filter.1 ha
  simp only [Bool.and_eq_true, List.any_eq_true] at hs
  obtain ⟨hst, v, hv, hin⟩ := hs
  refine mem_localStruct hg hst hv ((inEntry_iff v e).2 (Or.inr ?_))
  rcases (inEntry_iff v e').1 hin with rfl | hp
  · exact h
  · exact h.trans ((List.prefix_append _ _).trans hp)

/-- L8.2b (helper): the forest at the height path of an entry is its height. -/
theorem forestAt_isSome_entry {α : Type} {t : Tree α} {e : EntryAddr}
    (h : (t.forestAt e.heightPath).isSome) : (t.entryAt e).isSome := by
  rw [Tree.forestAt_heightPath] at h
  unfold Tree.heightAt at h
  cases he : t.entryAt e with
  | none => rw [he] at h; simp at h
  | some _ => rfl

/-- L8.2b (helper): a column is reachable along its path. -/
theorem forestAt_isSome_of_colAt {α : Type} {t : Tree α} {c : ColAddr}
    (h : (t.colAt c).isSome) : (t.forestAt c.path).isSome := by
  unfold Tree.colAt at h
  cases hf : t.forestAt c.path with
  | none => rw [hf] at h; simp at h
  | some _ => rfl

/-- L8.2b (helper): from `U_e` to every column `A_⟨hp, k⟩` of the height of `e`. -/
theorem chain_height_col {E : Forest} (hV : Scan.CondV E) (hI : Scan.CondI E) {e : EntryAddr}
    (he : e ∈ E.entryAddrs) : ∀ k, (E.colAt ⟨e.heightPath, k⟩).isSome →
      Relation.ReflTransGen (ElemStep (localStruct E e)) (.slot e) (.ord ⟨e.heightPath, k⟩) := by
  have hinc : ∀ k, (Role.ord ⟨e.heightPath, k⟩).inEntry e = true := fun k =>
    (inEntry_iff _ e).2 (Or.inr (List.prefix_refl _))
  intro k
  induction k with
  | zero =>
    intro hk
    obtain ⟨⟨p, h⟩, hx⟩ := Option.isSome_iff_exists.1 ((Tree.mem_entryAddrs_iff E e).1 he)
    have hh : E.heightAt e = some h := by simp [Tree.heightAt, hx]
    have hne : h ≠ Tree.empty := by
      rintro rfl
      simp [Tree.colAt, Tree.forestAt_heightPath, hh, Tree.empty, Tree.cols] at hk
    refine Relation.ReflTransGen.single (Or.inr (Or.inr ⟨.slot ⟨⟨e.heightPath, 0⟩, 0⟩, ?_⟩))
    exact mem_localStruct (v := .ord ⟨e.heightPath, 0⟩) (step_slot_child hV hI he hh hne) rfl
      (by simp [BaseAtom.vars]) (hinc 0)
  | succ k ih =>
    intro hk
    have hk' : (E.colAt ⟨e.heightPath, k⟩).isSome := by
      unfold Tree.colAt at hk ⊢
      cases hf : E.forestAt e.heightPath with
      | none => rw [hf] at hk; simp at hk
      | some f =>
        rw [hf] at hk
        simp only [Option.bind_some, Option.isSome_iff_exists, List.getElem?_eq_some_iff] at hk ⊢
        obtain ⟨_, hlt, -⟩ := hk
        exact ⟨_, by omega, rfl⟩
    refine (ih hk').tail (Or.inl ?_)
    exact mem_localStruct (elem_col_succ ((Tree.mem_colAddrs_iff E _).2 hk') hk) rfl
      (by simp [BaseAtom.vars]) (hinc k)

/-- L8.2b (helper): from `U_e` to every column inside the height of `e`, by induction on the
depth below `e`. -/
theorem chain_inside_col {E : Forest} (hV : Scan.CondV E) (hI : Scan.CondI E) :
    ∀ (n : Nat) (e : EntryAddr), e ∈ E.entryAddrs → ∀ (c : ColAddr) (rest : List (Nat × Nat)),
      c.path = e.heightPath ++ rest → rest.length = n → (E.colAt c).isSome →
      Relation.ReflTransGen (ElemStep (localStruct E e)) (.slot e) (.ord c) := by
  intro n
  induction n with
  | zero =>
    intro e he c rest hc hn hcs
    obtain rfl : rest = [] := List.eq_nil_of_length_eq_zero hn
    obtain ⟨cp, cc⟩ := c
    simp only [List.append_nil] at hc
    subst hc
    exact chain_height_col hV hI he cc hcs
  | succ n ih =>
    intro e he c rest hc hn hcs
    obtain ⟨⟨ci, ii⟩, rest', rfl⟩ : ∃ x rest', rest = x :: rest' := by
      cases rest with
      | nil => simp at hn
      | cons x rest' => exact ⟨x, rest', rfl⟩
    let e' : EntryAddr := ⟨⟨e.heightPath, ci⟩, ii⟩
    have hc' : c.path = e'.heightPath ++ rest' := by
      simp [e', EntryAddr.heightPath, hc]
    have he'x : (E.entryAt e').isSome := by
      refine forestAt_isSome_entry (forestAt_isSome_of_prefix ⟨rest', hc'.symm⟩ ?_)
      exact forestAt_isSome_of_colAt hcs
    have he' : e' ∈ E.entryAddrs := (Tree.mem_entryAddrs_iff E e').2 he'x
    have hcol : (E.colAt ⟨e.heightPath, ci⟩).isSome := by
      obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 he'x
      obtain ⟨col, hcol, -⟩ := Tree.colAt_of_entryAt hx
      show (E.colAt e'.col).isSome
      rw [hcol]; rfl
    have h1 := chain_height_col hV hI he ci hcol
    obtain ⟨o, ho⟩ := step_col_slot hV he'
    have h2 : ElemStep (localStruct E e) (.ord ⟨e.heightPath, ci⟩) (.slot e') :=
      Or.inr (Or.inl ⟨o, mem_localStruct (v := .ord ⟨e.heightPath, ci⟩) ho rfl
        (by simp [BaseAtom.vars, e']) ((inEntry_iff _ e).2 (Or.inr (List.prefix_refl _)))⟩)
    have h3 := ih e' he' c rest' hc' (by simpa using hn) hcs
    exact (h1.tail h2).trans (steps_mono (localStruct_mono (List.prefix_refl _)) h3)

/-- L8.2b: the owner path (txt:1194-1200), syntactically: every role inside the height of `e`
is reached from `U_e` by elementarity steps touching `e`. -/
theorem graph_chain {E : Forest} (hV : Scan.CondV E) (hI : Scan.CondI E) {e : EntryAddr}
    (he : e ∈ E.entryAddrs) {z : Role} (hz : z ∈ E.roles) (hin : z.inEntry e = true) :
    Relation.ReflTransGen (ElemStep (localStruct E e)) (.slot e) z := by
  rcases (inEntry_iff z e).1 hin with rfl | ⟨rest, hrest⟩
  · exact Relation.ReflTransGen.refl
  · cases z with
    | ord c =>
      exact chain_inside_col hV hI rest.length e he c rest hrest.symm rfl
        ((Tree.mem_roles_iff E (.ord c)).1 hz)
    | slot e'' =>
      have hx : (E.entryAt e'').isSome := (Tree.mem_roles_iff E (.slot e'')).1 hz
      have he'' : e'' ∈ E.entryAddrs := (Tree.mem_entryAddrs_iff E e'').2 hx
      have hcol : (E.colAt e''.col).isSome := by
        obtain ⟨x, hx'⟩ := Option.isSome_iff_exists.1 hx
        obtain ⟨col, hcol, -⟩ := Tree.colAt_of_entryAt hx'
        rw [hcol]; rfl
      have h1 := chain_inside_col hV hI rest.length e he e''.col rest hrest.symm rfl hcol
      obtain ⟨o, ho⟩ := step_col_slot hV he''
      refine h1.tail (Or.inr (Or.inl ⟨o, mem_localStruct (v := .ord e''.col) ho rfl
        (by simp [BaseAtom.vars]) ((inEntry_iff _ e).2 (Or.inr ?_))⟩))
      exact ⟨rest, hrest⟩

/-- L8.2c (helper): stack occurrences lie on the containing path. -/
theorem onStack_path_prefix {c o : ColAddr} (h : c.OnStack o) : o.path <+: c.path := by
  rcases h with ⟨k, ck, ik, -, hp, -⟩ | ⟨hp, -⟩
  · rw [hp]; exact List.take_prefix _ _
  · rw [hp]

/-- L8.2c (helper): roles placed under a path lie under it. -/
theorem under_path (π : List (Nat × Nat)) (r : Role) : (Role.under π r).path = π ++ r.path := by
  cases r <;> rfl

/-- L8.2c (helper): the representatives seen from a column `d` inside the height of `e`: the
frame of `e`, the host `A_{e.col}` or the slot `U_e`, or roles inside `e`. -/
theorem rep_inside_cases {e : EntryAddr} {d : ColAddr} (hd : e.heightPath <+: d.path) {p : Nat}
    {o v : Role} (hr : d.rep 0 p = some (o, v)) :
    ∀ x, (x = o ∨ x = v) → x.inEntry e = true ∨ x = .ord e.col ∨
      ∃ ov ∈ e.col.reps0, x = ov.1 ∨ x = ov.2 := by
  obtain ⟨h1, h2, h3, -⟩ := rep_inside e d hd
  intro x hx
  rcases lt_trichotomy p (e.col.num 0) with hlt | heq | hgt
  · rw [h1 p hlt] at hr
    refine Or.inr (Or.inr ⟨(o, v), List.mem_filterMap.2 ⟨p, List.mem_range.2 hlt, hr⟩, hx⟩)
  · subst heq
    rw [h2, Option.some.injEq, Prod.mk.injEq] at hr
    obtain ⟨rfl, rfl⟩ := hr
    rcases hx with rfl | rfl
    · exact Or.inr (Or.inl rfl)
    · exact Or.inl ((inEntry_iff _ e).2 (Or.inl rfl))
  · obtain ⟨w, rfl⟩ : ∃ w, p = e.col.num 0 + w := ⟨p - e.col.num 0, by omega⟩
    rw [h3 w (by omega)] at hr
    obtain ⟨ov, -, hov⟩ := Option.map_eq_some_iff.1 hr
    simp only [Prod.mk.injEq] at hov
    obtain ⟨rfl, rfl⟩ := hov
    left
    refine (inEntry_iff _ e).2 (Or.inr ?_)
    rcases hx with rfl | rfl <;> rw [under_path] <;> exact List.prefix_append _ _

/-- L8.2c: the atoms touching `e` read only `e`'s slot and height and `e`'s frame. -/
theorem localStruct_vars {E : Forest} (hV : Scan.CondV E) {e : EntryAddr}
    (he : e ∈ E.entryAddrs) :
    ∀ a ∈ localStruct E e, ∀ v ∈ a.vars,
      v.inEntry e = true ∨ v = .ord e.col ∨ ∃ ov ∈ e.col.reps0, v = ov.1 ∨ v = ov.2 := by
  intro a ha
  obtain ⟨hg, hs⟩ := List.mem_filter.1 ha
  simp only [Bool.and_eq_true, List.any_eq_true] at hs
  obtain ⟨hst, w, hw, hwin⟩ := hs
  simp only [graph, List.mem_append, List.mem_map, List.mem_filterMap, List.mem_flatMap] at hg
  rcases hg with (((⟨x, -, rfl⟩ | ⟨xy, -, rfl⟩) | ⟨c, hc, hca⟩) | ⟨e'', he'', hea⟩)
  · simp [isStruct] at hst
  · simp [isStruct] at hst
  · split_ifs at hca
    cases hca
    have hp : e.heightPath <+: c.path := by
      simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false] at hw
      rcases hw with rfl | rfl <;> rcases (inEntry_iff _ e).1 hwin with h | h
      · cases h
      · exact h
      · cases h
      · exact h
    intro v hv
    left
    simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false] at hv
    rcases hv with rfl | rfl <;> exact (inEntry_iff _ e).2 (Or.inr hp)
  · cases hx : E.entryAt e'' with
    | none => rw [hx] at hea; simp at hea
    | some ph =>
      obtain ⟨p, h⟩ := ph
      rw [hx] at hea
      simp only at hea
      cases hr : e''.col.rep 0 p with
      | none => rw [hr] at hea; simp at hea
      | some ov =>
        obtain ⟨o, v'⟩ := ov
        rw [hr] at hea
        simp only [List.mem_cons, List.mem_nil_iff, or_false] at hea
        -- the representatives through the resolved stack occurrence
        have hrep := hr
        unfold ColAddr.rep at hrep
        cases hres : e''.col.resolve 0 p with
        | none => rw [hres] at hrep; simp at hrep
        | some o' =>
          rw [hres] at hrep
          simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq] at hrep
          obtain ⟨rfl, hv'⟩ := hrep
          have hstk := onStack_path_prefix ((ColAddr.resolve_spec 0 _ o' p).1 hres).1
          -- a variable inside `e` forces `e''` to be `e` or inside `e`
          have hinside : e'' = e ∨ e.heightPath <+: e''.col.path := by
            have hw' : w = .slot e'' ∨ w = .ord e''.col ∨ w = .ord o' ∨ w = v' := by
              rcases hea with rfl | rfl <;>
                simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false] at hw <;>
                tauto
            rcases hw' with rfl | rfl | rfl | rfl
            · rcases (inEntry_iff _ e).1 hwin with h | h
              · exact Or.inl (Role.slot.inj h)
              · exact Or.inr h
            · rcases (inEntry_iff _ e).1 hwin with h | h
              · cases h
              · exact Or.inr h
            · rcases (inEntry_iff _ e).1 hwin with h | h
              · cases h
              · exact Or.inr (h.trans hstk)
            · revert hv'
              cases hcont : o'.container e''.col with
              | none =>
                intro hv'; subst hv'
                rcases (inEntry_iff _ e).1 hwin with h | h
                · cases h
                · exact Or.inr (h.trans hstk)
              | some e3 =>
                intro hv'; subst hv'
                obtain ⟨he3, he3p⟩ := (ColAddr.container_spec o' e''.col e3).1 hcont
                rcases (inEntry_iff _ e).1 hwin with h | h
                · cases Role.slot.inj h; exact Or.inr he3p
                · exact Or.inr (h.trans (by rw [Role.path, he3]; exact hstk))
          intro v hv
          have hv3 : v = .slot e'' ∨ v = .ord e''.col ∨ v = .ord o' ∨ v = v' := by
            rcases hea with rfl | rfl <;>
              simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false] at hv <;>
              tauto
          rcases hinside with rfl | hB
          · rcases hv3 with rfl | rfl | hv3 | hv3
            · exact Or.inl ((inEntry_iff _ _).2 (Or.inl rfl))
            · exact Or.inr (Or.inl rfl)
            all_goals
              refine Or.inr (Or.inr ⟨(.ord o', v'), List.mem_filterMap.2
                ⟨p, List.mem_range.2 (ColAddr.resolve_lt hres), hr⟩, ?_⟩)
              simp [hv3]
          · rcases hv3 with rfl | rfl | hv3 | hv3
            · exact Or.inl ((inEntry_iff _ e).2 (Or.inr hB))
            · exact Or.inl ((inEntry_iff _ e).2 (Or.inr hB))
            · exact rep_inside_cases hB hr v (Or.inl hv3)
            · exact rep_inside_cases hB hr v (Or.inr hv3)

/-- L8.2, (19): owner-path elementarity in any realized diagram containing the atoms touching
`e`: `J_{β(U_e)} ≺_{Σ1} J_{β z}` for every role `z` inside the height of `e`. -/
theorem owner_path_elem (I : Interface.{u}) {E : Forest} (hV : Scan.CondV E)
    (hI : Scan.CondI E) {e : EntryAddr} (he : e ∈ E.entryAddrs) {D : List (BaseAtom Role)}
    (hD : ∀ a ∈ localStruct E e, a ∈ D) {β : Role → Ordinal.{u}}
    (hβ : BaseHolds I.toPrims D β) (hlim : IsLim (β (.slot e))) {z : Role} (hz : z ∈ E.roles)
    (hin : z.inEntry e = true) : I.Elem (β (.slot e)) (β z) :=
  elem_of_steps I hβ hlim (steps_mono hD (graph_chain hV hI he hz hin))

/-- L8.2 (helper): the slot of an entry is a role. -/
theorem slot_mem_roles {α : Type} {t : Tree α} {e : EntryAddr} (he : e ∈ t.entryAddrs) :
    Role.slot e ∈ t.roles := by
  obtain ⟨x, hx, hxe⟩ := List.mem_filterMap.1 he
  cases x with
  | slot d => cases hxe; exact hx
  | ord _ => cases hxe

/-- L8.2, (19), for configurations. -/
theorem owner_path_elem_config (I : Interface.{u}) {E : Forest} (hV : Scan.CondV E)
    (hI : Scan.CondI E) {α : Role → Ordinal.{u}} (hα : IsConfig I.toPrims E α) {e : EntryAddr}
    (he : e ∈ E.entryAddrs) {z : Role} (hz : z ∈ E.roles) (hin : z.inEntry e = true) :
    I.Elem (α (.slot e)) (α z) :=
  owner_path_elem I hV hI he (fun _ ha => (List.mem_filter.1 ha).1) hα
    (config_lim hα (slot_mem_roles he)) hz hin

/-- L8.2d: roles on the terminal route towards the stopping column `T`: an ordinary role of a
route forest at or before that forest's route column, or the slot of a containing entry of
`T`. -/
def OnRoute (sd : Scan.StopData) : Role → Prop
  | .ord c => ∃ d, c.path = sd.col.path.take d ∧
      c.col ≤ (((sd.col.path ++ [(sd.col.col, 0)])[d]?).map Prod.fst).getD 0
  | .slot e => e.heightPath <+: sd.col.path

/-- L8.2d (helper): earlier columns of a forest exist. -/
theorem colAt_isSome_of_le {α : Type} {t : Tree α} {π : List (Nat × Nat)} {j k : Nat}
    (hjk : j ≤ k) (hk : (t.colAt ⟨π, k⟩).isSome) : (t.colAt ⟨π, j⟩).isSome := by
  unfold Tree.colAt at hk ⊢
  cases hf : t.forestAt π with
  | none => simp only [hf] at hk; simp at hk
  | some f =>
    simp only [hf, Option.bind_some, Option.isSome_iff_exists, List.getElem?_eq_some_iff] at hk ⊢
    obtain ⟨_, hlt, -⟩ := hk
    exact ⟨_, by omega, rfl⟩

/-- L8.2d (helper): consecutive columns of one forest form an elementarity chain. -/
theorem cols_chain {E : Forest} {π : List (Nat × Nat)} :
    ∀ {j k : Nat}, j ≤ k → (E.colAt ⟨π, k⟩).isSome →
      Relation.ReflTransGen (ElemStep (graph E)) (.ord ⟨π, j⟩) (.ord ⟨π, k⟩)
  | j, 0, hjk, _ => by obtain rfl : j = 0 := by omega
                       exact Relation.ReflTransGen.refl
  | j, k + 1, hjk, hk => by
    by_cases hj : j = k + 1
    · subst hj; exact Relation.ReflTransGen.refl
    · have hk' := colAt_isSome_of_le (Nat.le_succ k) hk
      exact (cols_chain (by omega) hk').tail
        (Or.inl (elem_col_succ ((Tree.mem_colAddrs_iff E _).2 hk') hk))

/-- L8.2d (helper): an entry whose height path leads to a column has a nonempty height. -/
theorem height_ne_empty_of_prefix {E : Forest} {e : EntryAddr} {c : ColAddr}
    (hp : e.heightPath <+: c.path) (hc : (E.colAt c).isSome) :
    ∃ h, E.heightAt e = some h ∧ h ≠ Tree.empty := by
  obtain ⟨rest, hrest⟩ := hp
  unfold Tree.colAt at hc
  rw [← hrest, Tree.forestAt_append, Tree.forestAt_heightPath] at hc
  cases hh : E.heightAt e with
  | none => rw [hh] at hc; simp at hc
  | some h =>
    refine ⟨h, rfl, ?_⟩
    rintro rfl
    rw [hh] at hc
    cases rest with
    | nil => simp [Tree.forestAt, Tree.empty, Tree.cols] at hc
    | cons x rest => simp [Tree.forestAt, Tree.empty, Tree.cols] at hc

/-- L8.2d (helper): the route below depth `d` leads to the stopping column. -/
theorem route_steps {H : Forest} (hV : Scan.CondV H) (hI : Scan.CondI H) {T : ColAddr}
    (hT : (H.colAt T).isSome) : ∀ (n d : Nat), T.path.length - d = n → ∀ c : ColAddr,
      c.path = T.path.take d →
      c.col ≤ (((T.path ++ [(T.col, 0)])[d]?).map Prod.fst).getD 0 →
      Relation.ReflTransGen (ElemStep (graph H)) (.ord c) (.ord T) := by
  intro n
  induction n with
  | zero =>
    intro d hd c hcp hcc
    have hlen : T.path.length ≤ d := by omega
    rw [List.take_of_length_le hlen] at hcp
    have hcol : c.col ≤ T.col := by
      rcases Nat.lt_or_ge T.path.length d with hlt | hge
      · rw [List.getElem?_eq_none (by simp; omega)] at hcc
        simp at hcc; omega
      · obtain rfl : d = T.path.length := by omega
        rw [List.getElem?_append_right le_rfl] at hcc
        simpa using hcc
    obtain ⟨cp, cc⟩ := c
    obtain ⟨tp, tc⟩ := T
    simp only at hcp hcol
    subst hcp
    exact cols_chain hcol hT
  | succ n ih =>
    intro d hd c hcp hcc
    have hlt : d < T.path.length := by omega
    obtain ⟨⟨ck, ik⟩, hk⟩ : ∃ x, T.path[d]? = some x :=
      ⟨_, List.getElem?_eq_getElem hlt⟩
    rw [List.getElem?_append_left hlt, hk] at hcc
    simp only [Option.map_some, Option.getD_some] at hcc
    let ed : EntryAddr := ⟨⟨T.path.take d, ck⟩, ik⟩
    have hhp : ed.heightPath = T.path.take (d + 1) := by
      simp [ed, EntryAddr.heightPath, List.take_add_one, hk]
    have hpre : ed.heightPath <+: T.path := by rw [hhp]; exact List.take_prefix _ _
    obtain ⟨h, hh, hne⟩ := height_ne_empty_of_prefix hpre hT
    have hedx : (H.entryAt ed).isSome := by
      unfold Tree.heightAt at hh
      cases hx : H.entryAt ed with
      | none => rw [hx] at hh; simp at hh
      | some _ => rfl
    have hed : ed ∈ H.entryAddrs := (Tree.mem_entryAddrs_iff H ed).2 hedx
    have hcolk : (H.colAt ⟨T.path.take d, ck⟩).isSome := by
      obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 hedx
      obtain ⟨col, hcol, -⟩ := Tree.colAt_of_entryAt hx
      show (H.colAt ed.col).isSome
      rw [hcol]; rfl
    obtain ⟨cp, cc⟩ := c
    simp only at hcp hcc
    subst hcp
    have h1 := cols_chain (E := H) hcc hcolk
    obtain ⟨o, ho⟩ := step_col_slot hV hed
    have h2 : ElemStep (graph H) (.ord ed.col) (.slot ed) := Or.inr (Or.inl ⟨o, ho⟩)
    have h3 : ElemStep (graph H) (.slot ed) (.ord ⟨ed.heightPath, 0⟩) :=
      Or.inr (Or.inr ⟨_, step_slot_child hV hI hed hh hne⟩)
    have h4 := ih (d + 1) (by omega) ⟨ed.heightPath, 0⟩ hhp (Nat.zero_le _)
    exact ((h1.tail h2).tail h3).trans h4

/-- L8.2d: route elementarity (txt:1289-1291): `J_{α v} ≺_{Σ1} J_{α T}` for `v` on the route. -/
theorem route_chain (I : Interface.{u}) {H : Forest} (hV : Scan.CondV H) (hI : Scan.CondI H)
    {sd : Scan.StopData} (hsd : Scan.stopData H = some sd) {α : Role → Ordinal.{u}}
    (hα : IsConfig I.toPrims H α) {v : Role} (hv : v ∈ H.roles) (hr : OnRoute sd v) :
    I.Elem (α v) (α (.ord sd.col)) := by
  have hT : (H.colAt sd.col).isSome :=
    (Tree.mem_roles_iff H (.ord sd.col)).1 (Scan.stopData_col_mem hsd)
  refine elem_of_steps I hα (config_lim hα hv) ?_
  cases v with
  | ord c =>
    obtain ⟨d, hcp, hcc⟩ := hr
    exact route_steps hV hI hT _ d rfl c hcp hcc
  | slot e =>
    have hpre : e.heightPath <+: sd.col.path := hr
    have hx : (H.entryAt e).isSome := (Tree.mem_roles_iff H (.slot e)).1 hv
    have he : e ∈ H.entryAddrs := (Tree.mem_entryAddrs_iff H e).2 hx
    obtain ⟨h, hh, hne⟩ := height_ne_empty_of_prefix hpre hT
    have h1 : ElemStep (graph H) (.slot e) (.ord ⟨e.heightPath, 0⟩) :=
      Or.inr (Or.inr ⟨_, step_slot_child hV hI he hh hne⟩)
    have hhp : e.heightPath = sd.col.path.take e.heightPath.length :=
      List.prefix_iff_eq_take.1 hpre
    exact Relation.ReflTransGen.head h1
      (route_steps hV hI hT _ e.heightPath.length rfl ⟨e.heightPath, 0⟩ hhp (Nat.zero_le _))

/-- L8.3: a realization of the free block problem of `K` at frame `fr` above floor `L`. -/
def IsFreeReal (P : Prims.{u}) (K : Key) (fr : BlkVar → Option Ordinal.{u}) (L : Ordinal.{u})
    (β : BlkVar → Ordinal.{u}) : Prop :=
  (∀ w o, fr w = some o → β w = o) ∧
    (∀ w ∈ baseVars (freeBlock K), fr w = none → L < β w) ∧ BaseHolds P (freeBlock K) β

/-- L8.3: the maximum of a block realization over its new variables (owner and inner roles). -/
noncomputable def blkMax (K : Key) (β : BlkVar → Ordinal.{u}) : Ordinal.{u} :=
  ((BlkVar.owner :: K.roles.map BlkVar.inner).map β).foldr max 0

/-- L8.3 (helper): a `foldr max 0` over a nonempty list is attained. -/
theorem foldr_max_mem : ∀ (x : Ordinal.{u}) (l : List Ordinal.{u}), (x :: l).foldr max 0 ∈ x :: l
  | x, [] => by simp
  | x, y :: l => by
    have ih := foldr_max_mem y l
    rw [List.foldr_cons]
    rcases max_choice x ((y :: l).foldr max 0) with h | h
    · rw [h]; exact List.mem_cons_self
    · rw [h]; exact List.mem_cons_of_mem _ ih

/-- L8.3 (helper): every element is at most the `foldr max 0`. -/
theorem le_foldr_max {l : List Ordinal.{u}} {x : Ordinal.{u}} (hx : x ∈ l) :
    x ≤ l.foldr max 0 := by
  induction l with
  | nil => simp at hx
  | cons y l ih =>
    rw [List.foldr_cons]
    rcases List.mem_cons.1 hx with rfl | hx
    · exact le_max_left _ _
    · exact (ih hx).trans (le_max_right _ _)

/-- L8.3 (helper): the `foldr max 0` is the least upper bound. -/
theorem foldr_max_le {l : List Ordinal.{u}} {c : Ordinal.{u}} (h : ∀ x ∈ l, x ≤ c) :
    l.foldr max 0 ≤ c := by
  induction l with
  | nil => exact zero_le
  | cons y l ih =>
    rw [List.foldr_cons]
    exact max_le (h y List.mem_cons_self) (ih fun x hx => h x (List.mem_cons_of_mem _ hx))

/-- L8.3 (helper): the owner is below the block maximum. -/
theorem le_blkMax_owner (K : Key) (β : BlkVar → Ordinal.{u}) : β .owner ≤ blkMax K β :=
  le_foldr_max (List.mem_map_of_mem List.mem_cons_self)

/-- L8.3 (helper): internal roles are below the block maximum. -/
theorem le_blkMax_inner {K : Key} (β : BlkVar → Ordinal.{u}) {r : Role} (hr : r ∈ K.roles) :
    β (.inner r) ≤ blkMax K β :=
  le_foldr_max (List.mem_map_of_mem (List.mem_cons_of_mem _ (List.mem_map_of_mem hr)))

/-- L8.3 (helper): a bound on the owner and the internal roles bounds the block maximum. -/
theorem blkMax_le {K : Key} {β : BlkVar → Ordinal.{u}} {c : Ordinal.{u}} (ho : β .owner ≤ c)
    (hi : ∀ r ∈ K.roles, β (.inner r) ≤ c) : blkMax K β ≤ c := by
  refine foldr_max_le fun x hx => ?_
  simp only [List.map_cons, List.map_map, List.mem_cons, List.mem_map, Function.comp] at hx
  rcases hx with rfl | ⟨r, hr, rfl⟩
  · exact ho
  · exact hi r hr

/-- L8.3 (helper): the block maximum is attained at the owner or at an internal role. -/
theorem blkMax_attained (K : Key) (β : BlkVar → Ordinal.{u}) :
    blkMax K β = β .owner ∨ ∃ r ∈ K.roles, blkMax K β = β (.inner r) := by
  have h := foldr_max_mem (β .owner) ((K.roles.map BlkVar.inner).map β)
  rw [← List.map_cons] at h
  change blkMax K β ∈ _ at h
  simp only [List.map_cons, List.map_map, List.mem_cons, List.mem_map, Function.comp] at h
  rcases h with h | ⟨r, hr, h⟩
  · exact Or.inl h
  · exact Or.inr ⟨r, hr, h.symm⟩

/-- L8.3 (helper): the owner is a variable of the free block. -/
theorem owner_mem_freeBlock (K : Key) : BlkVar.owner ∈ baseVars (freeBlock K) :=
  List.mem_flatMap.2 ⟨BaseAtom.lim .owner, by simp [freeBlock], by simp [BaseAtom.vars]⟩

/-- L8.3 (helper): internal roles are variables of the free block. -/
theorem inner_mem_freeBlock {K : Key} {r : Role} (hr : r ∈ K.roles) :
    BlkVar.inner r ∈ baseVars (freeBlock K) :=
  List.mem_flatMap.2 ⟨BaseAtom.lim (.inner r), by
    simp only [freeBlock, List.mem_append, List.mem_cons, List.mem_map]
    exact Or.inl (Or.inl (Or.inl (Or.inr ⟨_, ⟨r, hr, rfl⟩, rfl⟩))), by simp [BaseAtom.vars]⟩

/-- L8.3 (helper): an `inner` variable of the free block is an internal role (N5.6). -/
theorem inner_of_mem_freeBlock {K : Key} {r : Role}
    (hr : BlkVar.inner r ∈ baseVars (freeBlock K)) : r ∈ K.roles := by
  have h : BlkVar.inner r ∈ baseVars (posBlock K 0) := by
    simp only [posBlock, baseVars, List.flatMap_append, List.mem_append]
    exact Or.inl hr
  rcases posBlock_vars K 0 _ h with h | h | ⟨q, h | h⟩ | ⟨r', hr', h⟩
  · cases h
  · cases h
  · cases h
  · cases h
  · cases h; exact hr'

/-- L8.3 (helper): the two-candidate fact for an ordered pair of candidates: `A` before `B` in
the lexicographic order of (block maximum, owner). -/
theorem two_candidates_aux (I : Interface.{u}) {K : Key} {fr : BlkVar → Option Ordinal.{u}}
    {L : Ordinal.{u}} {A B : BlkVar → Ordinal.{u}}
    (hA : IsFreeReal I.toPrims K fr L A) (hB : IsFreeReal I.toPrims K fr L B)
    (hpB : ∀ r ∈ K.roles, I.Elem (B .owner) (B (.inner r)))
    (hfr : ∀ w ∈ baseVars (freeBlock K), ∀ o, fr w = some o → o ≤ L)
    (hnew : ∀ w ∈ baseVars (freeBlock K), fr w = none → w = .owner ∨ ∃ r, w = .inner r)
    (hle : blkMax K A ≤ blkMax K B) (heq : blkMax K A = blkMax K B → A .owner ≤ B .owner) :
    ∃ β, IsFreeReal I.toPrims K fr L β ∧ β .owner ≤ A .owner ∧ β .owner ≤ B .owner ∧
      blkMax K β ≤ blkMax K A ∧ blkMax K β ≤ blkMax K B := by
  by_cases hown : A .owner ≤ B .owner
  · exact ⟨A, hA, le_rfl, hown, le_rfl, hle⟩
  push Not at hown
  have hlt : blkMax K A < blkMax K B :=
    lt_of_le_of_ne hle fun h => absurd (heq h) (not_le.2 hown)
  have hom := owner_mem_freeBlock K
  have hfo : fr .owner = none := by
    cases hf : fr .owner with
    | none => rfl
    | some o => exact absurd ((hB.1 _ _ hf).trans (hA.1 _ _ hf).symm) (ne_of_lt hown)
  have hLB : L < B .owner := hB.2.1 _ hom hfo
  have hAo : A .owner ≤ blkMax K A := le_blkMax_owner K A
  obtain ⟨r, hr, hBr⟩ : ∃ r ∈ K.roles, blkMax K B = B (.inner r) := by
    rcases blkMax_attained K B with h | h
    · exact absurd (h ▸ hown.trans_le (hAo.trans hlt.le)) (lt_irrefl _)
    · exact h
  have hel : I.Elem (B .owner) (blkMax K B) := hBr ▸ hpB r hr
  have hblk : BlockAbove I.toPrims (freeBlock K) fr L (blkMax K B) := by
    refine ⟨A, hA.1, hA.2.1, fun w hw => ?_, hA.2.2⟩
    cases hfw : fr w with
    | some o =>
      rw [hA.1 w o hfw]
      exact (hfr w hw o hfw).trans_lt (hLB.trans (hown.trans (hAo.trans_lt hlt)))
    | none =>
      rcases hnew w hw hfw with rfl | ⟨r', rfl⟩
      · exact hAo.trans_lt hlt
      · exact (le_blkMax_inner A (inner_of_mem_freeBlock hw)).trans_lt hlt
  obtain ⟨β, hfix, hnewβ, hltβ, hholds⟩ := blockAbove_capture I hel hLB
    (fun w hw o hfw => (hfr w hw o hfw).trans_lt hLB) hblk
  have hβB : blkMax K β ≤ B .owner :=
    blkMax_le (hltβ _ hom).le fun r hr => (hltβ _ (inner_mem_freeBlock hr)).le
  exact ⟨β, ⟨hfix, hnewβ, hholds⟩, (hltβ _ hom).le.trans hown.le, (hltβ _ hom).le,
    hβB.trans (hown.le.trans hAo), hβB.trans (le_blkMax_owner K B)⟩

/-- L8.3, two-candidate fact (txt:1201-1210). Given two realizations of the same free problem
above the same floor, with owner paths and frame values at most the floor, some realization has
owner and maximum no larger than either candidate's. -/
theorem two_candidates (I : Interface.{u}) {K : Key} {fr : BlkVar → Option Ordinal.{u}}
    {L : Ordinal.{u}} {βX βY : BlkVar → Ordinal.{u}}
    (hX : IsFreeReal I.toPrims K fr L βX) (hY : IsFreeReal I.toPrims K fr L βY)
    (hpX : ∀ r ∈ K.roles, I.Elem (βX .owner) (βX (.inner r)))
    (hpY : ∀ r ∈ K.roles, I.Elem (βY .owner) (βY (.inner r)))
    (hfr : ∀ w ∈ baseVars (freeBlock K), ∀ o, fr w = some o → o ≤ L)
    (hnew : ∀ w ∈ baseVars (freeBlock K), fr w = none → w = .owner ∨ ∃ r, w = .inner r) :
    ∃ β, IsFreeReal I.toPrims K fr L β ∧ β .owner ≤ βX .owner ∧ β .owner ≤ βY .owner ∧
      blkMax K β ≤ blkMax K βX ∧ blkMax K β ≤ blkMax K βY := by
  by_cases h : blkMax K βX < blkMax K βY ∨ (blkMax K βX = blkMax K βY ∧ βX .owner ≤ βY .owner)
  · refine two_candidates_aux I hX hY hpY hfr hnew ?_ ?_
    · rcases h with h | h
      · exact h.le
      · exact h.1.le
    · intro he
      rcases h with h | h
      · exact absurd he (ne_of_lt h)
      · exact h.2
  · push Not at h
    obtain ⟨h1, h2⟩ := h
    obtain ⟨β, hβ, h3, h4, h5, h6⟩ := two_candidates_aux I hY hX hpX hfr hnew h1
      (fun he => (h2 he.symm).le)
    exact ⟨β, hβ, h4, h3, h6, h5⟩

/-- L8.4 (helper): a tree of size `0` is empty. -/
theorem eq_empty_of_size_zero_D4 {α : Type} {t : Tree α} (h : t.size = 0) : t = Tree.empty := by
  obtain ⟨cols⟩ := t
  cases cols with
  | nil => rfl
  | cons c cs => simp [Tree.size, Tree.roles, Tree.rolesF, Tree.rolesCols] at h

/-- L8.4 (helper): the free block of the empty key is the owner's `Lim` atom. -/
theorem freeBlock_empty_D4 : freeBlock Tree.empty = [BaseAtom.lim .owner] := rfl

/-- L8.4 (helper): the target frame names of a packet are low. -/
theorem toFr_tgtFrame_low_D4 {P : Prims.{u}} (pk : SourcePacket.{u}) (hadm : pk.rk.Admitted)
    (hv : pk.Valid P) {w : BlkVar} {x : Name} (h : pk.tgtFrame.toFr w = some x) :
    x ∈ pk.lowNames := by
  obtain ⟨-, hreps, hhost, -⟩ := lowNames_spec pk hadm hv
  cases w with
  | host => cases h; exact hhost
  | ord q =>
    obtain ⟨ov, hov, rfl⟩ := Option.map_eq_some_iff.1 h
    exact (hreps ov (List.mem_of_getElem? hov)).1
  | cur q =>
    obtain ⟨ov, hov, rfl⟩ := Option.map_eq_some_iff.1 h
    exact (hreps ov (List.mem_of_getElem? hov)).2
  | owner => cases h
  | inner _ => cases h

/-- L8.4 (helper): a nonempty source height gives a role `z` of `F` inside `a`, right after the
slot of `a` in reading order: `J_u ≺ J_{α z}` and `u < α z` (txt:1212). -/
theorem src_above_owner_D4 (I : Interface.{u}) (pk : SourcePacket.{u}) (hadm : pk.rk.Admitted)
    (hv : pk.Valid I.toPrims) (hne : pk.rk.srcHeight ≠ Tree.empty) :
    ∃ b, I.Elem (pk.asg pk.owner) b ∧ pk.asg pk.owner < b := by
  have ha : pk.rk.a ∈ pk.rk.F.entryAddrs := hadm.2.2.1
  obtain ⟨hV, hI, -⟩ := hadm.2.2.2.1
  have hα := valid_src_config pk hv
  obtain ⟨post, hroles, -⟩ := Tree.roles_entry ha
  change (pk.rk.F.heightAt pk.rk.a).getD Tree.empty ≠ Tree.empty at hne
  generalize (pk.rk.F.heightAt pk.rk.a).getD Tree.empty = X at hroles hne
  obtain ⟨cols⟩ := X
  cases cols with
  | nil => exact absurd rfl hne
  | cons col cs =>
    let z : Role := .ord ⟨pk.rk.a.heightPath, 0⟩
    have hz : pk.rk.F.roles = prefixRoles pk.rk.F pk.rk.a ++ .slot pk.rk.a :: z ::
        ((Tree.rolesCol [] 0 0 col ++ Tree.rolesCols [] 1 cs).map
          (Role.under pk.rk.a.heightPath) ++ post) := by
      rw [hroles]
      simp [Tree.roles, Tree.rolesF, Tree.rolesCols, Role.under, z]
    have hzm : z ∈ pk.rk.F.roles := by rw [hz]; simp
    have hin : z.inEntry pk.rk.a = true := by simp [Role.inEntry, z, Role.path]
    refine ⟨(pk.asg ∘ pk.srcChart) z, owner_path_elem_config I hV hI hα ha hzm hin, ?_⟩
    have hpw := config_pairwise hα
    rw [hz, List.pairwise_append] at hpw
    exact List.rel_of_pairwise_cons hpw.2.1 List.mem_cons_self

/-- L8.4, base `S_0` (txt:1211-1214; S-3 rejected: the capture along `J_u ≺ J_b` is kept). -/
theorem sStrict_zero (I : Interface.{u}) : SStrict I.toPrims 0 := by
  intro pk hadm hv hsz L hL
  have ha : pk.rk.a ∈ pk.rk.F.entryAddrs := hadm.2.2.1
  have hkey : pk.rk.tgtKey < pk.rk.srcKey := hadm.2.2.2.2.2.1
  have hB : pk.rk.tgtHeight = Tree.empty := eq_empty_of_size_zero_D4 hsz
  have hK : pk.rk.tgtKey = Tree.empty := relKey_eq_empty.2 hB
  have hsrc : pk.rk.srcHeight ≠ Tree.empty := by
    intro h
    have hS : pk.rk.srcKey = Tree.empty := relKey_eq_empty.2 h
    rw [hK, hS] at hkey
    exact lt_irrefl _ hkey
  obtain ⟨b, hub, hltb⟩ := src_above_owner_D4 I pk hadm hv hsrc
  obtain ⟨Ls, -, hLsu, -, hfac⟩ := factorization pk hv ha hL
  apply hfac
  have hlow : ∀ x ∈ pk.lowNames, pk.asg x < pk.asg pk.owner := hv.2.2.2.2.2.2
  obtain ⟨o, v, hov, heo, hev⟩ := hv.2.2.2.2.2.1
  have hhost : pk.tgtFrame.host = pk.host := hv.2.2.1
  have hfrlow : ∀ w x, pk.tgtFrame.toFr w = some x → pk.asg x < pk.asg pk.owner :=
    fun w x h => hlow x (toFr_tgtFrame_low_D4 pk hadm hv h)
  rw [hK]
  refine blockAbove_capture I hub hLsu ?_ ?_
  · intro w _ y hy
    obtain ⟨x, hx, rfl⟩ := Option.map_eq_some_iff.1 hy
    exact hfrlow w x hx
  · refine ⟨fun w => if w = .owner then pk.asg pk.owner
      else ((pk.tgtFrame.toFr w).map pk.asg).getD 0, fun w y hy => ?_, fun w hw hn => ?_,
      fun w hw => ?_, ?_⟩
    · have hw : w ≠ .owner := by rintro rfl; cases hy
      simp [hw, hy]
    · simp only [posBlock, freeBlock_empty_D4, baseVars, List.cons_append, List.nil_append,
        List.flatMap_cons, List.flatMap_nil, BaseAtom.vars, List.append_nil, List.mem_cons,
        List.mem_nil_iff, or_false] at hw
      rcases hw with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
        first | (simp [Frame.toFr, hov] at hn; done) | simpa using hLsu
    · by_cases hwo : w = .owner
      · simp [hwo, hltb]
      · simp only [hwo, if_false]
        cases hf : pk.tgtFrame.toFr w with
        | none => simp only [Option.map_none, Option.getD_none]
                  exact lt_of_le_of_lt zero_le hltb
        | some x => exact (hfrlow w x hf).trans hltb
    · have hl : IsLim (pk.asg pk.owner) := (I.edge_lim heo).2.2
      intro a hat
      simp only [posBlock, freeBlock_empty_D4, List.cons_append, List.nil_append, List.mem_cons,
        List.mem_nil_iff, or_false] at hat
      rcases hat with rfl | rfl | rfl
      · simpa [BaseAtom.Holds] using hl
      · simp [BaseAtom.Holds, Frame.toFr, hov, hhost]
        exact heo
      · simp [BaseAtom.Holds, Frame.toFr, hov, hhost]
        exact hev

/-! ## §8.2: `S_{<n} ⇒ W_{<n}` -/

/-- L8.5a: the roles of the source bank: root entries `0, …, c` (slots and heights). -/
def setupBank (S : ScanSetup.{u}) : List Role :=
  S.H.roles.filter fun x => (List.range (S.rd.cursor + 1)).any fun i => x.inEntry ⟨S.rd.col, i⟩

/-- L8.5a: the pre-root roles of the anchor. -/
def setupPreRoot (S : ScanSetup.{u}) : List Role := rolesBefore S.H (.ord S.rd.col)

/-- L8.5a: the bank graph: atoms of `Γ(H)` inside `preRoot ∪ {R} ∪ bank` involving `R` or the
bank (spine §c.11 S5). -/
def setupBankGraph (S : ScanSetup.{u}) : List (BaseAtom Role) :=
  (restrictTo (graph S.H) (setupPreRoot S ++ [.ord S.rd.col] ++ setupBank S)).filter fun a =>
    a.vars.any fun v => decide (v = .ord S.rd.col ∨ v ∈ setupBank S)

/-- L8.5a: bank values: bank roles through `bankNm`, `R ↦ ρ`, pre-root through `ePre ∘ χ`. -/
noncomputable def setupBankVal (S : ScanSetup.{u}) (x : Role) : Ordinal.{u} :=
  if x ∈ setupBank S then S.asg (S.bankNm x)
  else if x = .ord S.rd.col then S.asg S.stopNm else S.baseVal x

/-- L8.5a: values of the original positive query (spine §c.11 S4). -/
noncomputable def setupPosVal (S : ScanSetup.{u}) : Role → Ordinal.{u} :=
  S.fitVal fun x => S.asg (S.qNm x)

/-- L8.5a: the transported `E`-prefix domain `P_E` of a setup. -/
def setupEPrefix (S : ScanSetup.{u}) : List Role := ePrefix S.E S.cap S.sd

/-- L8.5a: the key and selector of query entry `j`. -/
def queryKey (S : ScanSetup.{u}) (j : Nat) : Key := ((Scan.queryKeys S.sd)[j]?).getD Tree.empty
def querySel (S : ScanSetup.{u}) (j : Nat) : Nat := ((S.sd.Q[j]?).map Prod.fst).getD 0

/-- L8.5a: owner and block maximum of the original positive query entry `j`. -/
noncomputable def queryOwnerVal (S : ScanSetup.{u}) (j : Nat) : Ordinal.{u} :=
  S.asg (S.qNm (.slot ⟨S.sd.col, j⟩))
noncomputable def queryBlockMax (S : ScanSetup.{u}) (j : Nat) : Ordinal.{u} :=
  ((S.entryRoles j).map fun x => S.asg (S.qNm x)).foldr max 0

/-- L8.5a: block maximum of bank entry `i` (`M_i`). -/
noncomputable def bankBlockMax (S : ScanSetup.{u}) (i : Nat) : Ordinal.{u} :=
  ((S.H.roles.filter fun x => x.inEntry ⟨S.rd.col, i⟩).map (setupBankVal S)).foldr max 0

/-- L8.5a: the clauses S1–S6 of `ScanSetup.Valid` (spine §c.11), written out. Equivalent to the
spine body `ScanSetup.ValidDef` (U3 D7.2b) by `valid_iff` (L8.5h). -/
def SetupClauses (P : Prims.{u}) (S : ScanSetup.{u}) : Prop :=
  -- S1
  (IsStd S.E ∧ Scan.InL S.H ∧ Scan.stepKind S.H = some .ordinary ∧
    Scan.stopData S.H = some S.sd ∧ Scan.rootData S.H = some S.rd ∧
    S.rd.cursor < ((S.H.colAt S.rd.col).getD []).length ∧
    S.rd.col.container S.sd.col ≠ some ⟨S.rd.col, S.rd.cursor⟩) ∧
  -- S2
  (Set.InjOn S.ePre {y | y ∈ setupEPrefix S} ∧
    BaseHolds P (restrictTo (graph S.E) (setupEPrefix S)) (S.asg ∘ S.ePre) ∧
    ∀ y ∈ setupEPrefix S, S.asg (S.ePre y) < S.asg S.stopNm) ∧
  -- S3
  (S.aux.Holds P S.asg ∧ ∀ v ∈ S.aux.vars, S.asg v < S.asg S.stopNm) ∧
  -- S4
  BaseHolds P S.queryGraph (setupPosVal S) ∧
  -- S5
  BaseHolds P (setupBankGraph S) (setupBankVal S) ∧
  -- S6
  (Set.InjOn S.qNm {x | x ∈ S.queryRoles} ∧ Set.InjOn S.bankNm {x | x ∈ setupBank S} ∧
    (∀ x ∈ S.queryRoles, S.qNm x ≠ S.stopNm ∧ S.qNm x ∉ S.aux.vars ∧
      (∀ y ∈ setupEPrefix S, S.qNm x ≠ S.ePre y) ∧ ∀ y ∈ setupBank S, S.qNm x ≠ S.bankNm y) ∧
    (∀ x ∈ setupBank S, S.bankNm x ≠ S.stopNm ∧ S.bankNm x ∉ S.aux.vars ∧
      ∀ y ∈ setupEPrefix S, S.bankNm x ≠ S.ePre y))

/-- L8.5h (helper): `takeWhile (· != y)` stops no later than `takeWhile (· != z)` when `y`
occurs before `z`. -/
theorem mem_rolesBefore_trans_D4 {l : List Role} {x y z : Role}
    (hx : x ∈ l.takeWhile (· != y)) (hy : y ∈ l.takeWhile (· != z)) :
    x ∈ l.takeWhile (· != z) := by
  induction l with
  | nil => simp at hx
  | cons a l ih =>
    by_cases hay : a = y
    · subst hay; simp at hx
    · by_cases haz : a = z
      · subst haz; simp at hy
      · simp only [List.takeWhile_cons, bne_iff_ne, ne_eq, hay, haz, not_false_eq_true,
          if_true, List.mem_cons] at hx hy ⊢
        rcases hx with rfl | hx
        · exact Or.inl rfl
        · rcases hy with rfl | hy
          · exact absurd rfl hay
          · exact Or.inr (ih hx hy)

/-- L8.5h (helper): a role before `y` is not `y`. -/
theorem ne_of_mem_rolesBefore_D4 {E : Forest} {x y : Role} (h : x ∈ rolesBefore E y) : x ≠ y := by
  have := List.all_eq_true.1 List.all_takeWhile x h
  simpa using this

/-- L8.5h (helper): the root column precedes the stopping column in reading order: it lies on
the visible stack of `T`, hence before the closing slot, and it is neither `T` nor in the query. -/
theorem root_before_stop_D4 {H : Forest} {sd : Scan.StopData} {rd : Scan.RootData}
    (hsd : Scan.stopData H = some sd) (hrd : Scan.rootData H = some rd) :
    Role.ord rd.col ∈ rolesBefore H (.ord sd.col) := by
  obtain ⟨hres, -, -, hpre, -⟩ := Scan.rootData_path hsd hrd
  obtain ⟨-, -, -, hN, -, qs, hroles, hqs⟩ := Scan.stopData_roles hsd
  obtain ⟨hon, -⟩ := (ColAddr.resolve_spec 0 sd.col rd.col sd.r).1 hres
  obtain ⟨pre, post, hr, -, -, hstk, -⟩ :=
    Tree.roles_decomp sd.col.path H sd.col.col sd.Q.length sd.r Tree.empty hN
  have h1 := Tree.prefixRoles_of_decomp hr
  have h2 : prefixRoles H ⟨⟨sd.col.path, sd.col.col⟩, sd.Q.length⟩ =
      rolesBefore H (.ord sd.col) ++ .ord sd.col :: qs := by
    refine Tree.prefixRoles_of_decomp (rest := []) ?_
    rw [hroles]
    simp [Scan.closingSlot]
  have hR := hstk rd.col hon
  rw [← h1, h2] at hR
  rcases List.mem_append.1 hR with h | h
  · exact h
  · rcases List.mem_cons.1 h with h | h
    · have := ColAddr.num_lt_of_onStack 0 hon
      rw [Role.ord.inj h] at this
      exact absurd this (lt_irrefl _)
    · have hq := hqs _ h
      simp only [inQueryRegion, List.any_eq_true, List.mem_range] at hq
      obtain ⟨j, -, hj⟩ := hq
      rcases (inEntry_iff _ _).1 hj with h | h
      · cases h
      · have h3 := h.length_le
        have h4 := hpre.length_le
        simp [EntryAddr.heightPath, Role.path] at h3
        omega

/-- L8.5h (helper): pre-root roles are pre-stop roles. -/
theorem preRoot_sub_preStop_D4 {S : ScanSetup.{u}} (hsd : Scan.stopData S.H = some S.sd)
    (hrd : Scan.rootData S.H = some S.rd) {x : Role} (hx : x ∈ setupPreRoot S) :
    x ∈ S.preStop :=
  mem_rolesBefore_trans_D4 hx (root_before_stop_D4 hsd hrd)

/-- L8.5h (helper): the root ordinary role is not a bank role. -/
theorem root_not_mem_bank_D4 (S : ScanSetup.{u}) : Role.ord S.rd.col ∉ setupBank S := by
  intro h
  obtain ⟨-, h⟩ := List.mem_filter.1 h
  simp only [List.any_eq_true] at h
  obtain ⟨i, -, hi⟩ := h
  rcases (inEntry_iff _ _).1 hi with h | h
  · cases h
  · have := h.length_le
    simp [EntryAddr.heightPath, Role.path] at this

/-- L8.5h (helper): variables of a restricted diagram lie in the restricting set. -/
theorem mem_of_restrictTo_D4 {D : List (BaseAtom Role)} {S : List Role} {a : BaseAtom Role}
    (ha : a ∈ restrictTo D S) {v : Role} (hv : v ∈ a.vars) : v ∈ S := by
  have := (List.mem_filter.1 ha).2
  simpa using List.all_eq_true.1 this v hv

/-- L8.5h (helper): the `E`-prefix of the spine's clause S2 is `setupEPrefix`. -/
theorem pe_eq_D4 (S : ScanSetup.{u}) (hL : Scan.InL S.H) (hsd : Scan.stopData S.H = some S.sd) :
    S.PE = setupEPrefix S := by
  obtain ⟨T', hT', -⟩ := Closure.anchorOrigin_prefix (E := S.E) (cap := S.cap) hL hsd
  simp only [ScanSetup.PE, ScanSetup.TE, ScanSetup.chi, anchorD, setupEPrefix, ePrefix, hT',
    Option.getD_some]

/-- L8.5h (helper): clause S5 of the spine reads the same graph at values agreeing on its
variables. -/
theorem bank_congr_D4 (P : Prims.{u}) (S : ScanSetup.{u}) (hL : Scan.InL S.H)
    (hsd : Scan.stopData S.H = some S.sd) (hrd : Scan.rootData S.H = some S.rd) :
    BaseHolds P S.bankGraph S.bankVal ↔ BaseHolds P (setupBankGraph S) (setupBankVal S) := by
  have hG : S.bankGraph = setupBankGraph S := by
    simp only [ScanSetup.bankGraph, setupBankGraph, ScanSetup.preRoot, setupPreRoot,
      ScanSetup.R, ScanSetup.bankRoles, setupBank]
    congr 1
    funext a
    congr 1
    funext v
    exact decide_eq_decide.2 List.mem_cons
  rw [hG]
  obtain ⟨T', -, -, horig⟩ := Closure.anchorOrigin_prefix (E := S.E) (cap := S.cap) hL hsd
  refine baseHolds_congr P _ _ _ fun x hx => ?_
  obtain ⟨a, ha, hxa⟩ := List.mem_flatMap.1 hx
  have hxS := mem_of_restrictTo_D4 (List.mem_filter.1 ha).1 hxa
  have hRb := root_not_mem_bank_D4 S
  by_cases hb : x ∈ setupBank S
  · have hxR : x ≠ S.R := fun h => hRb (by rw [h] at hb; exact hb)
    have hb' : x ∈ S.bankRoles := hb
    simp only [ScanSetup.bankVal, setupBankVal, hxR, if_false, hb, hb', if_true]
  · by_cases hxR : x = .ord S.rd.col
    · subst hxR
      simp only [ScanSetup.bankVal, setupBankVal, hb, if_false, ScanSetup.R, if_true]
    · have hpre : x ∈ setupPreRoot S := by
        simp only [List.mem_append, List.mem_singleton] at hxS
        rcases hxS with (h | h) | h
        · exact h
        · exact absurd h hxR
        · exact absurd h hb
      have hps := preRoot_sub_preStop_D4 hsd hrd hpre
      obtain ⟨y, hy, -⟩ := horig x hps
      have hxT : x ≠ .ord S.sd.col := ne_of_mem_rolesBefore_D4 hps
      have hxR' : x ≠ S.R := hxR
      have hb' : x ∉ S.bankRoles := hb
      simp only [ScanSetup.bankVal, setupBankVal, hxR', hb', hb, hxR, if_false, ScanSetup.baseVal,
        hxT, hy, Option.map_some, Option.getD_some, ScanSetup.chi, anchorD]

/-- L8.5h (formerly the stub `Req.valid_iff`, U5 R24): the spine's `ScanSetup.Valid` (body
`ScanSetup.ValidDef`, U3 D7.2b) is equivalent to the clauses `SetupClauses` written out by U5. -/
theorem valid_iff {P : Prims.{u}} (S : ScanSetup.{u}) : S.Valid P ↔ SetupClauses P S := by
  change S.ValidDef P ↔ _
  unfold ScanSetup.ValidDef SetupClauses
  refine and_congr_right fun h1 => ?_
  have hPE : S.PE = setupEPrefix S := pe_eq_D4 S h1.2.1 h1.2.2.2.1
  have h5 := bank_congr_D4 P S h1.2.1 h1.2.2.2.1 h1.2.2.2.2.1
  rw [hPE, baseHolds_map']
  refine and_congr Iff.rfl (and_congr Iff.rfl (and_congr Iff.rfl (and_congr h5 ?_)))
  simp only [List.mem_map, not_exists, not_and]
  constructor
  · rintro ⟨i1, i2, hqb, hq, hb⟩
    exact ⟨i1, i2, fun x hx => ⟨(hq x hx).2.1, (hq x hx).2.2, fun y hy h => (hq x hx).1 y hy h.symm,
      hqb x hx⟩, fun x hx => ⟨(hb x hx).2.1, (hb x hx).2.2, fun y hy h => (hb x hx).1 y hy h.symm⟩⟩
  · rintro ⟨i1, i2, hq, hb⟩
    exact ⟨i1, i2, fun x hx => (hq x hx).2.2.2, fun x hx => ⟨fun y hy h => (hq x hx).2.2.1 y hy h.symm,
      (hq x hx).1, (hq x hx).2.1⟩, fun x hx => ⟨fun y hy h => (hb x hx).2.2 y hy h.symm,
      (hb x hx).1, (hb x hx).2.1⟩⟩

/-! ### L8.5 helpers (D4): lists, maxima and reading order around a column -/

/-- L8.5 (helper): consecutive pairs of a list are exactly its adjacent sublists. -/
theorem mem_zip_tail_iff_D4 {β : Type} {l : List β} {a b : β} :
    (a, b) ∈ l.zip l.tail ↔ ∃ s t, l = s ++ a :: b :: t := by
  induction l with
  | nil => simp
  | cons x l ih =>
    cases l with
    | nil =>
      simp only [List.tail_cons, List.zip_nil_right, List.not_mem_nil, false_iff, not_exists]
      intro s t h
      have := congrArg List.length h
      simp at this
      omega
    | cons y l =>
      simp only [List.tail_cons, List.zip_cons_cons, List.mem_cons, Prod.mk.injEq] at ih ⊢
      rw [ih]
      constructor
      · rintro (⟨rfl, rfl⟩ | ⟨s, t, h⟩)
        · exact ⟨[], l, rfl⟩
        · exact ⟨x :: s, t, by rw [h]; rfl⟩
      · rintro ⟨s, t, h⟩
        cases s with
        | nil =>
          simp only [List.nil_append, List.cons.injEq] at h
          exact Or.inl ⟨h.1.symm, h.2.1.symm⟩
        | cons z s =>
          simp only [List.cons_append, List.cons.injEq] at h
          exact Or.inr ⟨s, t, h.2⟩

/-- L8.5 (helper): the `lt` chain of a block of consecutive roles lies in `Γ(E)`. -/
theorem lt_chain_graph_D4 {E : Forest} {pre l post : List Role}
    (h : E.roles = pre ++ l ++ post) :
    ∀ xy ∈ l.zip l.tail, BaseAtom.lt xy.1 xy.2 ∈ graph E := by
  rintro ⟨a, b⟩ hab
  obtain ⟨s, t, rfl⟩ := mem_zip_tail_iff_D4.1 hab
  simp only [graph, List.mem_append]
  refine Or.inl (Or.inl (Or.inr (List.mem_map.2 ⟨(a, b), ?_, rfl⟩)))
  exact mem_zip_tail_iff_D4.2 ⟨pre ++ s, t ++ post, by rw [h]; simp⟩

/-- L8.5 (helper): `takeWhile (· != y)` of a list through its first `y`. -/
theorem takeWhile_ne_D4 {A B : List Role} {y : Role} (hy : y ∉ A) :
    (A ++ y :: B).takeWhile (· != y) = A := by
  induction A with
  | nil => simp
  | cons a A ih =>
    have ha : a ≠ y := fun h => hy (h ▸ List.mem_cons_self)
    simp only [List.cons_append, List.takeWhile_cons, bne_iff_ne, ne_eq, ha, not_false_eq_true,
      if_true, ih (fun h => hy (List.mem_cons_of_mem _ h))]

/-- L8.5 (helper): `dropWhile (· != y)` of a list through its first `y`. -/
theorem dropWhile_ne_D4 {A B : List Role} {y : Role} (hy : y ∉ A) :
    (A ++ y :: B).dropWhile (· != y) = y :: B := by
  induction A with
  | nil => simp
  | cons a A ih =>
    have ha : a ≠ y := fun h => hy (h ▸ List.mem_cons_self)
    simp only [List.cons_append, List.dropWhile_cons, bne_iff_ne, ne_eq, ha, not_false_eq_true,
      if_true, ih (fun h => hy (List.mem_cons_of_mem _ h))]

/-- L8.5 (helper): the roles before a role, from any decomposition of the roles at it. -/
theorem rolesBefore_of_decomp_D4 {E : Forest} {x : Role} {pre rest : List Role}
    (hr : E.roles = pre ++ x :: rest) : rolesBefore E x = pre := by
  have hnd := Tree.roles_nodup E
  rw [hr, List.nodup_append] at hnd
  have hne : x ∉ pre := fun hm => hnd.2.2 _ hm _ List.mem_cons_self rfl
  unfold rolesBefore
  rw [hr, takeWhile_ne_D4 hne]

/-- L8.5 (helper): the initial value of a `foldr max` is below it. -/
theorem le_foldr_max_init_D4 (l : List Ordinal.{u}) (a : Ordinal.{u}) : a ≤ l.foldr max a := by
  induction l with
  | nil => exact le_rfl
  | cons y l ih => exact ih.trans (le_max_right _ _)

/-- L8.5 (helper): the members of the list are below its `foldr max`. -/
theorem le_foldr_max_mem_D4 {l : List Ordinal.{u}} {a x : Ordinal.{u}} (hx : x ∈ l) :
    x ≤ l.foldr max a := by
  induction l with
  | nil => simp at hx
  | cons y l ih =>
    rw [List.foldr_cons]
    rcases List.mem_cons.1 hx with rfl | hx
    · exact le_max_left _ _
    · exact (ih hx).trans (le_max_right _ _)

/-- L8.5 (helper): upper bounds of a `foldr max`. -/
theorem foldr_max_le_iff_D4 {l : List Ordinal.{u}} {a c : Ordinal.{u}} :
    l.foldr max a ≤ c ↔ a ≤ c ∧ ∀ x ∈ l, x ≤ c := by
  induction l with
  | nil => simp
  | cons y l ih =>
    rw [List.foldr_cons, max_le_iff, ih]
    simp only [List.mem_cons, forall_eq_or_imp]
    tauto

/-- L8.5 (helper): strict upper bounds of a `foldr max`. -/
theorem foldr_max_lt_iff_D4 {l : List Ordinal.{u}} {a c : Ordinal.{u}} :
    l.foldr max a < c ↔ a < c ∧ ∀ x ∈ l, x < c := by
  induction l with
  | nil => simp
  | cons y l ih =>
    rw [List.foldr_cons, max_lt_iff, ih]
    simp only [List.mem_cons, forall_eq_or_imp]
    tauto

/-- L8.5 (helper): the roles of a tree around a column `c`: earlier roles, `A_c`, the roles of its
entries (`rolesCol`), later roles. -/
theorem roles_col_D4 {α : Type} : ∀ (P : List (Nat × Nat)) (t : Tree α) (j : Nat)
    (col : List (α × Tree α)), t.colAt ⟨P, j⟩ = some col →
    ∃ pre post, t.roles = pre ++ Role.ord ⟨P, j⟩ :: (Tree.rolesCol P j 0 col ++ post)
  | [], ⟨cols⟩, j, col, h => by
    have hc : cols[j]? = some col := by simpa [Tree.colAt, Tree.forestAt, Tree.cols] using h
    have hj : j < cols.length := (List.getElem?_eq_some_iff.1 hc).1
    refine ⟨Tree.rolesCols [] 0 (cols.take j), Tree.rolesCols [] (j + 1) (cols.drop (j + 1)), ?_⟩
    show Tree.rolesCols [] 0 cols = _
    conv_lhs => rw [Tree.list_split_of_getElem? hc]
    rw [Tree.rolesCols_append]
    simp [Tree.rolesCols, List.length_take, Nat.min_eq_left hj.le]
  | (c, i₀) :: rest, ⟨cols⟩, j, col, h => by
    rw [Tree.colAt_cons] at h
    cases he : ((Tree.node cols).cols[c]?.bind (·[i₀]?)) with
    | none => rw [he] at h; simp at h
    | some ph =>
      obtain ⟨p₀, h₀⟩ := ph
      rw [he] at h
      have h' : h₀.colAt ⟨rest, j⟩ = some col := by simpa using h
      obtain ⟨pre', post', hr'⟩ := roles_col_D4 rest h₀ j col h'
      have hent : (Tree.node cols).entryAt ⟨⟨[], c⟩, i₀⟩ = some (p₀, h₀) := by
        simpa [Tree.entryAt, Tree.colAt, Tree.forestAt] using he
      obtain ⟨pre, post, hr, -⟩ := Tree.roles_decomp [] (Tree.node cols) c i₀ p₀ h₀ hent
      refine ⟨pre ++ Role.slot ⟨⟨[], c⟩, i₀⟩ :: pre'.map (Role.under [(c, i₀)]),
        post'.map (Role.under [(c, i₀)]) ++ post, ?_⟩
      rw [hr, hr']
      have := Tree.rolesCol_append_under [(c, i₀)] rest j 0 col
      simp only [List.nil_append, List.cons_append] at this
      simp [this, Role.under]

/-- L8.5 (helper): a role lies inside at most one entry of a column. -/
theorem inEntry_unique_D4 {x : Role} {c : ColAddr} {j k : Nat}
    (hj : x.inEntry ⟨c, j⟩ = true) (hk : x.inEntry ⟨c, k⟩ = true) : j = k := by
  rcases (inEntry_iff _ _).1 hj with rfl | hj <;> rcases (inEntry_iff _ _).1 hk with h | hk
  · cases h; rfl
  · have := hk.length_le; simp [EntryAddr.heightPath, Role.path] at this
  · cases h; have := hj.length_le; simp [EntryAddr.heightPath, Role.path] at this
  · have := Tree.prefix_step_eq hj hk
    simp only [Prod.mk.injEq] at this
    exact this.2

/-- L8.5 (helper): the roles inside entry `i` of a column lie in the column's `rolesCol`. -/
theorem mem_rolesCol_of_inEntry_D4 {t : Forest} {c : ColAddr} {col : Column}
    (hc : t.colAt c = some col) {i : Nat} (hi : i < col.length) {x : Role} (hx : x ∈ t.roles)
    (hin : x.inEntry ⟨c, i⟩ = true) : x ∈ Tree.rolesCol c.path c.col 0 col := by
  obtain ⟨⟨p, h⟩, hpi⟩ : ∃ y, col[i]? = some y := ⟨_, List.getElem?_eq_getElem hi⟩
  have hent : t.entryAt ⟨c, i⟩ = some (p, h) := by simp [Tree.entryAt, hc, hpi]
  have he : (⟨c, i⟩ : EntryAddr) ∈ t.entryAddrs := (Tree.mem_entryAddrs_iff _ _).2 (by rw [hent]; rfl)
  refine Tree.mem_rolesCol_iff.2 ⟨i, p, h, hpi, ?_⟩
  rcases (inEntry_iff _ _).1 hin with rfl | hp
  · exact Or.inl (by simp)
  · right
    have := Tree.mem_under_of_inEntry he hx hp
    rw [Tree.heightAt, hent] at this
    simp only [Option.map_some, Option.getD_some] at this
    rw [Tree.rolesF_eq_map_under]
    simpa [EntryAddr.heightPath] using this

/-- L8.5 (helper): the entry index of a role in a column's `rolesCol` is below the column length. -/
theorem inEntry_lt_of_mem_rolesCol_D4 {π : List (Nat × Nat)} {c i k : Nat} {col : Column}
    {x : Role} (hx : x ∈ Tree.rolesCol π c i col) (hk : x.inEntry ⟨⟨π, c⟩, k⟩ = true) :
    i ≤ k ∧ k < i + col.length := by
  obtain ⟨k', h1, h2, h3⟩ := Scan.rolesCol_inEntry π c col i x hx
  obtain rfl := inEntry_unique_D4 h3 hk
  exact ⟨h1, h2⟩

/-- L8.5 (helper): a role of an entry `k < m` lies in the roles of the first `m` entries. -/
theorem mem_rolesCol_take_D4 {π : List (Nat × Nat)} {c : Nat} {col : Column} {x : Role}
    (hx : x ∈ Tree.rolesCol π c 0 col) {k m : Nat} (hk : x.inEntry ⟨⟨π, c⟩, k⟩ = true)
    (hkm : k < m) : x ∈ Tree.rolesCol π c 0 (col.take m) := by
  have hklen := (inEntry_lt_of_mem_rolesCol_D4 hx hk).2
  rw [← List.take_append_drop m col, Tree.rolesCol_append] at hx
  rcases List.mem_append.1 hx with h | h
  · exact h
  · have := (inEntry_lt_of_mem_rolesCol_D4 h hk).1
    simp only [List.length_take, Nat.zero_add] at this
    omega

/-- L8.5 (helper): a role of an entry `k ≥ m` lies in the roles of the entries from `m` on. -/
theorem mem_rolesCol_drop_D4 {π : List (Nat × Nat)} {c : Nat} {col : Column} {x : Role}
    (hx : x ∈ Tree.rolesCol π c 0 col) {k m : Nat} (hk : x.inEntry ⟨⟨π, c⟩, k⟩ = true)
    (hkm : m ≤ k) : x ∈ Tree.rolesCol π c (col.take m).length (col.drop m) := by
  rw [← List.take_append_drop m col, Tree.rolesCol_append] at hx
  rcases List.mem_append.1 hx with h | h
  · have := (inEntry_lt_of_mem_rolesCol_D4 h hk).2
    simp only [List.length_take, Nat.zero_add] at this
    omega
  · simpa using h

/-- L8.5 (helper): the two parts of a column's roles at entry `m` are in order under a chain. -/
theorem rolesCol_split_lt_D4 {π : List (Nat × Nat)} {c : Nat} {col : Column} {f : Role → Ordinal.{u}}
    (hpw : (Tree.rolesCol π c 0 col).Pairwise fun a b => f a < f b) {x y : Role} {k l : Nat}
    (hx : x ∈ Tree.rolesCol π c 0 col) (hxk : x.inEntry ⟨⟨π, c⟩, k⟩ = true)
    (hy : y ∈ Tree.rolesCol π c 0 col) (hyl : y.inEntry ⟨⟨π, c⟩, l⟩ = true) (hkl : k < l) :
    f x < f y := by
  have hx' := mem_rolesCol_take_D4 hx hxk hkl
  have hy' := mem_rolesCol_drop_D4 hy hyl le_rfl
  rw [← List.take_append_drop l col, Tree.rolesCol_append, List.pairwise_append] at hpw
  exact hpw.2.2 x hx' y (by simpa using hy')

/-- L8.5 (helper): the stopping column in reading order: `P⁻`, `T`, the query, the closing slot,
later roles; the query is the `rolesCol` of `Q`. -/
theorem stop_roles_D4 {S : ScanSetup.{u}} (hsd : Scan.stopData S.H = some S.sd) :
    ∃ post, S.H.roles = S.preStop ++ Role.ord S.sd.col ::
      (S.queryRoles ++ Role.slot (Scan.closingSlot S.sd) :: post) ∧
      S.queryRoles = Tree.rolesCol S.sd.col.path S.sd.col.col 0 S.sd.Q := by
  obtain ⟨hcol, -⟩ := Scan.stopData_spec hsd
  obtain ⟨pre, post, hr⟩ := roles_col_D4 S.sd.col.path S.H S.sd.col.col _ hcol
  have hrc : Tree.rolesCol S.sd.col.path S.sd.col.col 0 (S.sd.Q ++ [(S.sd.r, Tree.empty)]) =
      Tree.rolesCol S.sd.col.path S.sd.col.col 0 S.sd.Q ++ [Role.slot (Scan.closingSlot S.sd)] := by
    rw [Tree.rolesCol_append]
    simp [Tree.rolesCol, Scan.closingSlot, Tree.empty, Tree.rolesF, Tree.rolesCols]
  have hr' : S.H.roles = pre ++ Role.ord S.sd.col ::
      (Tree.rolesCol S.sd.col.path S.sd.col.col 0 S.sd.Q ++
        Role.slot (Scan.closingSlot S.sd) :: post) := by
    rw [hr, hrc]; simp
  have hpre : S.preStop = pre := rolesBefore_of_decomp_D4 hr'
  have hnd := Tree.roles_nodup S.H
  rw [hr', List.nodup_append, List.nodup_cons, List.nodup_append] at hnd
  have hTpre : Role.ord S.sd.col ∉ pre := fun hm => hnd.2.2 _ hm _ List.mem_cons_self rfl
  have hNQ : Role.slot (Scan.closingSlot S.sd) ∉
      Tree.rolesCol S.sd.col.path S.sd.col.col 0 S.sd.Q :=
    fun hm => hnd.2.1.2.2.2 _ hm _ List.mem_cons_self rfl
  have hQ : S.queryRoles = Tree.rolesCol S.sd.col.path S.sd.col.col 0 S.sd.Q := by
    unfold ScanSetup.queryRoles
    rw [hr', dropWhile_ne_D4 hTpre]
    simp only [List.drop_succ_cons, List.drop_zero]
    rw [takeWhile_ne_D4 hNQ]
  refine ⟨post, ?_, hQ⟩
  rw [hpre, hQ]; exact hr'

/-- L8.5 (helper): query roles are the roles of `H` inside a query entry. -/
theorem mem_queryRoles_iff_D4 {S : ScanSetup.{u}} (hsd : Scan.stopData S.H = some S.sd)
    {x : Role} : x ∈ S.queryRoles ↔
      x ∈ S.H.roles ∧ ∃ j < S.sd.Q.length, x.inEntry ⟨S.sd.col, j⟩ = true := by
  obtain ⟨post, hr, hQ⟩ := stop_roles_D4 hsd
  obtain ⟨hcol, -⟩ := Scan.stopData_spec hsd
  constructor
  · intro hx
    refine ⟨by rw [hr]; simp [hx], ?_⟩
    rw [hQ] at hx
    obtain ⟨j, -, hj, hin⟩ := Scan.rolesCol_inEntry _ _ S.sd.Q 0 x hx
    exact ⟨j, by omega, hin⟩
  · rintro ⟨hx, j, hj, hin⟩
    have h := mem_rolesCol_of_inEntry_D4 hcol (by simp; omega) hx hin
    rw [Tree.rolesCol_append] at h
    rcases List.mem_append.1 h with h | h
    · rw [hQ]; exact h
    · simp only [Tree.rolesCol, List.mem_cons, Tree.rolesF, Tree.rolesCols, Tree.empty,
        List.append_nil, List.mem_nil_iff, or_false, Nat.zero_add] at h
      subst h
      have h2 : (Role.slot ⟨⟨S.sd.col.path, S.sd.col.col⟩, S.sd.Q.length⟩).inEntry
          ⟨S.sd.col, S.sd.Q.length⟩ = true := by simp [Role.inEntry]
      have := inEntry_unique_D4 hin h2
      omega

/-- L8.5 (helper): `P⁻` and `T` are not query roles. -/
theorem not_query_D4 {S : ScanSetup.{u}} (hsd : Scan.stopData S.H = some S.sd) {x : Role}
    (hx : x ∈ S.preStop ∨ x = .ord S.sd.col) : x ∉ S.queryRoles := by
  obtain ⟨post, hr, -⟩ := stop_roles_D4 hsd
  have hnd := Tree.roles_nodup S.H
  rw [hr, List.nodup_append, List.nodup_cons] at hnd
  intro hq
  rcases hx with hx | rfl
  · exact hnd.2.2 _ hx _ (List.mem_cons_of_mem _ (List.mem_append_left _ hq)) rfl
  · exact hnd.2.1.1 (List.mem_append_left _ hq)

/-- L8.5 (helper): the root column in reading order: pre-root roles, `R`, the roles of its
entries, later roles. -/
theorem root_roles_D4 {S : ScanSetup.{u}} (hsd : Scan.stopData S.H = some S.sd)
    (hrd : Scan.rootData S.H = some S.rd) :
    ∃ colR post, S.H.colAt S.rd.col = some colR ∧ S.H.roles = setupPreRoot S ++
      Role.ord S.rd.col :: (Tree.rolesCol S.rd.col.path S.rd.col.col 0 colR ++ post) := by
  obtain ⟨-, -, -, -, -, hmem, -⟩ := Scan.rootData_spec hsd hrd
  obtain ⟨colR, hcolR⟩ := Option.isSome_iff_exists.1 ((Tree.mem_colAddrs_iff _ _).1 hmem)
  obtain ⟨pre, post, hr⟩ := roles_col_D4 S.rd.col.path S.H S.rd.col.col colR hcolR
  exact ⟨colR, post, hcolR, by rw [setupPreRoot, rolesBefore_of_decomp_D4 hr]; exact hr⟩

/-- L8.5 (helper): bank roles are the roles of `H` inside root entries `0, …, c`. -/
theorem mem_bank_iff_D4 (S : ScanSetup.{u}) {x : Role} : x ∈ setupBank S ↔
    x ∈ S.H.roles ∧ ∃ i ≤ S.rd.cursor, x.inEntry ⟨S.rd.col, i⟩ = true := by
  simp only [setupBank, List.mem_filter, List.any_eq_true, List.mem_range]
  constructor
  · rintro ⟨h1, i, hi, h2⟩; exact ⟨h1, i, by omega, h2⟩
  · rintro ⟨h1, i, hi, h2⟩; exact ⟨h1, i, by omega, h2⟩

/-- L8.5 (helper): `R` followed by the bank is an `lt` chain of the bank graph, hence strictly
increasing at the bank values (S5). -/
theorem bank_pairwise_D4 {P : Prims.{u}} (S : ScanSetup.{u}) (hS : SetupClauses P S) :
    ∃ colR, S.H.colAt S.rd.col = some colR ∧ S.rd.cursor < colR.length ∧
      (Role.ord S.rd.col :: Tree.rolesCol S.rd.col.path S.rd.col.col 0
        (colR.take (S.rd.cursor + 1))).Pairwise fun a b => setupBankVal S a < setupBankVal S b := by
  obtain ⟨⟨-, -, -, hsd, hrd, hcur, -⟩, -, -, -, h5, -⟩ := hS
  obtain ⟨colR, post, hcolR, hr⟩ := root_roles_D4 hsd hrd
  rw [hcolR, Option.getD_some] at hcur
  refine ⟨colR, hcolR, hcur, ?_⟩
  set BK := Tree.rolesCol S.rd.col.path S.rd.col.col 0 (colR.take (S.rd.cursor + 1)) with hBK
  have hsplit : Tree.rolesCol S.rd.col.path S.rd.col.col 0 colR =
      BK ++ Tree.rolesCol S.rd.col.path S.rd.col.col (colR.take (S.rd.cursor + 1)).length
        (colR.drop (S.rd.cursor + 1)) := by
    conv_lhs => rw [← List.take_append_drop (S.rd.cursor + 1) colR]
    rw [Tree.rolesCol_append, Nat.zero_add]
  have hr' : S.H.roles = setupPreRoot S ++ (Role.ord S.rd.col :: BK) ++
      (Tree.rolesCol S.rd.col.path S.rd.col.col (colR.take (S.rd.cursor + 1)).length
        (colR.drop (S.rd.cursor + 1)) ++ post) := by
    rw [hr, hsplit]; simp
  have hbank : ∀ x ∈ BK, x ∈ setupBank S := by
    intro x hx
    refine (mem_bank_iff_D4 S).2 ⟨by rw [hr']; simp [hx], ?_⟩
    obtain ⟨i, -, hi, hin⟩ := Scan.rolesCol_inEntry _ _ _ 0 x hx
    simp only [List.length_take] at hi
    exact ⟨i, by omega, hin⟩
  refine chain_pairwise (D := setupBankGraph S) (fun xy hxy => ?_) h5
  have hlt := lt_chain_graph_D4 hr' xy hxy
  obtain ⟨a, b⟩ := xy
  obtain ⟨s, t, hst⟩ := mem_zip_tail_iff_D4.1 hxy
  have hb : b ∈ BK := by
    cases s with
    | nil => simp only [List.nil_append, List.cons.injEq] at hst; rw [hst.2]; simp
    | cons z s =>
      simp only [List.cons_append, List.cons.injEq] at hst
      rw [hst.2]; simp
  have ha : a = .ord S.rd.col ∨ a ∈ BK := by
    have : a ∈ Role.ord S.rd.col :: BK := by rw [hst]; simp
    simpa using this
  refine List.mem_filter.2 ⟨List.mem_filter.2 ⟨hlt, ?_⟩, ?_⟩
  · simp only [BaseAtom.vars, List.all_cons, List.all_nil, Bool.and_true, Bool.and_eq_true,
      decide_eq_true_eq, List.mem_append, List.mem_singleton]
    refine ⟨?_, Or.inr (hbank b hb)⟩
    rcases ha with rfl | ha
    · exact Or.inl (Or.inr rfl)
    · exact Or.inr (hbank a ha)
  · simp only [BaseAtom.vars, List.any_cons, List.any_nil, Bool.or_false, Bool.or_eq_true,
      decide_eq_true_eq]
    exact Or.inr (Or.inr (hbank b hb))

/-- L8.5 (helper): the bank value of `R` is `ρ`. -/
theorem setupBankVal_root_D4 (S : ScanSetup.{u}) :
    setupBankVal S (.ord S.rd.col) = S.asg S.stopNm := by
  simp [setupBankVal, root_not_mem_bank_D4 S]

/-- L8.5 (helper): the slot of root entry `i ≤ c` is a role of `H`. -/
theorem slot_root_mem_D4 {P : Prims.{u}} (S : ScanSetup.{u}) (hS : SetupClauses P S) {i : Nat}
    (hi : i ≤ S.rd.cursor) : Role.slot ⟨S.rd.col, i⟩ ∈ S.H.roles := by
  obtain ⟨colR, hcolR, hcur, -⟩ := bank_pairwise_D4 S hS
  refine (Tree.mem_roles_iff _ _).2 ?_
  show (S.H.entryAt ⟨S.rd.col, i⟩).isSome
  simp [Tree.entryAt, hcolR, List.getElem?_eq_getElem (show i < colR.length by omega)]

/-- L8.5 (helper): the slot of root entry `i ≤ c` is a bank role. -/
theorem slot_mem_bank_D4 {P : Prims.{u}} (S : ScanSetup.{u}) (hS : SetupClauses P S) {i : Nat}
    (hi : i ≤ S.rd.cursor) : Role.slot ⟨S.rd.col, i⟩ ∈ setupBank S :=
  (mem_bank_iff_D4 S).2 ⟨slot_root_mem_D4 S hS hi, i, hi, by simp [Role.inEntry]⟩

/-- L8.5 (helper): the bank value of the slot of root entry `i ≤ c` is `u_i`. -/
theorem setupBankVal_slot_D4 {P : Prims.{u}} (S : ScanSetup.{u}) (hS : SetupClauses P S) {i : Nat}
    (hi : i ≤ S.rd.cursor) : setupBankVal S (.slot ⟨S.rd.col, i⟩) = S.ownerVal i := by
  simp [setupBankVal, slot_mem_bank_D4 S hS hi, ScanSetup.ownerVal]

/-- L8.5 (helper): `R` is below every role of a bank entry (S5). -/
theorem bank_root_lt_D4 {P : Prims.{u}} (S : ScanSetup.{u}) (hS : SetupClauses P S) {y : Role}
    {l : Nat} (hy : y ∈ S.H.roles) (hyl : y.inEntry ⟨S.rd.col, l⟩ = true) (hl : l ≤ S.rd.cursor) :
    setupBankVal S (.ord S.rd.col) < setupBankVal S y := by
  obtain ⟨colR, hcolR, hcur, hpw⟩ := bank_pairwise_D4 S hS
  have hy1 := mem_rolesCol_of_inEntry_D4 hcolR (by omega) hy hyl
  have hy2 := mem_rolesCol_take_D4 (k := l) (m := S.rd.cursor + 1) hy1 hyl (by omega)
  exact List.rel_of_pairwise_cons hpw hy2

/-- L8.5 (helper): roles of an earlier bank entry are below the roles of a later one (S5). -/
theorem bank_entry_lt_D4 {P : Prims.{u}} (S : ScanSetup.{u}) (hS : SetupClauses P S)
    {x y : Role} {k l : Nat} (hx : x ∈ S.H.roles) (hxk : x.inEntry ⟨S.rd.col, k⟩ = true)
    (hy : y ∈ S.H.roles) (hyl : y.inEntry ⟨S.rd.col, l⟩ = true) (hkl : k < l)
    (hl : l ≤ S.rd.cursor) : setupBankVal S x < setupBankVal S y := by
  obtain ⟨colR, hcolR, hcur, hpw⟩ := bank_pairwise_D4 S hS
  have hx1 := mem_rolesCol_of_inEntry_D4 hcolR (by omega) hx hxk
  have hx2 := mem_rolesCol_take_D4 (m := S.rd.cursor + 1) hx1 hxk (by omega)
  have hy1 := mem_rolesCol_of_inEntry_D4 hcolR (by omega) hy hyl
  have hy2 := mem_rolesCol_take_D4 (m := S.rd.cursor + 1) hy1 hyl (by omega)
  exact rolesCol_split_lt_D4 (List.pairwise_cons.1 hpw).2 hx2 hxk hy2 hyl hkl

/-- L8.5 (helper): the variables of `Γ(E)` are roles of `E`. -/
theorem graph_vars_roles_D4 {E : Forest} {a : BaseAtom Role} (ha : a ∈ graph E) :
    ∀ v ∈ a.vars, v ∈ E.roles := by
  simp only [graph, List.mem_append, List.mem_map, List.mem_filterMap, List.mem_flatMap] at ha
  rcases ha with (((⟨x, hx, rfl⟩ | ⟨xy, hxy, rfl⟩) | ⟨c, hc, hca⟩) | ⟨e, he, hea⟩)
  · simpa [BaseAtom.vars] using hx
  · have := List.of_mem_zip hxy
    simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false]
    rintro v (rfl | rfl)
    · exact this.1
    · exact List.mem_of_mem_tail this.2
  · split_ifs at hca with hs
    cases hca
    simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false]
    rintro v (rfl | rfl)
    · exact (Tree.mem_roles_iff E (.ord c)).2 ((Tree.mem_colAddrs_iff E c).1 hc)
    · exact (Tree.mem_roles_iff E (.ord _)).2 hs
  · cases hx : E.entryAt e with
    | none => rw [hx] at hea; simp at hea
    | some ph =>
      obtain ⟨p, h⟩ := ph
      rw [hx] at hea
      simp only at hea
      cases hr : e.col.rep 0 p with
      | none => rw [hr] at hea; simp at hea
      | some ov =>
        obtain ⟨o, v'⟩ := ov
        rw [hr] at hea
        have hcol : (E.colAt e.col).isSome := by
          obtain ⟨col, hcol, -⟩ := Tree.colAt_of_entryAt hx
          rw [hcol]; rfl
        obtain ⟨ho, hv'⟩ := rep_mem_roles hcol hr
        have hs := slot_mem_roles he
        have hc := (Tree.mem_roles_iff E (.ord e.col)).2 hcol
        simp only [List.mem_cons, List.mem_nil_iff, or_false] at hea
        rcases hea with rfl | rfl <;>
          simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false] <;>
          rintro v (rfl | rfl | rfl) <;> assumption

/-- L8.5 (helper): both representatives seen from a column with a first entry come before the
column in reading order (stack columns and containing slots, D1.2e). -/
theorem rep_before_D4 {t : Forest} {c : ColAddr} {x : Nat × Forest} {col : Column}
    (hc : t.colAt c = some (x :: col)) {q : Nat} {o v : Role} (hr : c.rep 0 q = some (o, v)) :
    o ∈ rolesBefore t (.ord c) ∧ v ∈ rolesBefore t (.ord c) := by
  obtain ⟨pre', post', hr'⟩ := roles_col_D4 c.path t c.col (x :: col) hc
  obtain ⟨p, h⟩ := x
  have hent : t.entryAt ⟨⟨c.path, c.col⟩, 0⟩ = some (p, h) := by simp [Tree.entryAt, hc]
  obtain ⟨pre, post, hd, -, -, hstk, hcont⟩ := Tree.roles_decomp c.path t c.col 0 p h hent
  have h1 := Tree.prefixRoles_of_decomp hd
  have h2 : prefixRoles t ⟨⟨c.path, c.col⟩, 0⟩ = pre' ++ [.ord c] :=
    Tree.prefixRoles_of_decomp (rest := Tree.rolesF (c.path ++ [(c.col, 0)]) h ++
      Tree.rolesCol c.path c.col 1 col ++ post') (by rw [hr']; simp [Tree.rolesCol])
  have hbef : rolesBefore t (.ord c) = pre' := rolesBefore_of_decomp_D4 hr'
  unfold ColAddr.rep at hr
  cases hres : c.resolve 0 q with
  | none => rw [hres] at hr; simp at hr
  | some o' =>
    rw [hres] at hr
    simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq] at hr
    obtain ⟨rfl, hv⟩ := hr
    have hon := ((ColAddr.resolve_spec 0 c o' q).1 hres).1
    have hne : o' ≠ c := by
      rintro rfl; exact absurd (ColAddr.num_lt_of_onStack 0 hon) (lt_irrefl _)
    have hmem : ∀ y, y ∈ pre → y ≠ .ord c → y ∈ rolesBefore t (.ord c) := by
      intro y hy hyc
      rw [← h1, h2] at hy
      rw [hbef]
      rcases List.mem_append.1 hy with hy | hy
      · exact hy
      · simp only [List.mem_singleton] at hy; exact absurd hy hyc
    have ho : Role.ord o' ∈ rolesBefore t (.ord c) :=
      hmem _ (hstk o' hon) (fun h => hne (Role.ord.inj h))
    refine ⟨ho, ?_⟩
    revert hv
    cases hct : o'.container c with
    | none => intro hv; rw [← hv]; exact ho
    | some e3 =>
      intro hv
      rw [← hv]
      obtain ⟨-, hp⟩ := (ColAddr.container_spec o' c e3).1 hct
      exact hmem _ (hcont e3 hp) (by simp)

/-- L8.5 (helper): the stopping column has a first entry. -/
theorem stop_col_cons_D4 {S : ScanSetup.{u}} (hsd : Scan.stopData S.H = some S.sd) :
    ∃ x col, S.H.colAt S.sd.col = some (x :: col) := by
  obtain ⟨hcol, -⟩ := Scan.stopData_spec hsd
  cases hQ : S.sd.Q with
  | nil => exact ⟨_, [], by rw [hcol, hQ]; rfl⟩
  | cons q Q' => exact ⟨q, Q' ++ [(S.sd.r, Tree.empty)], by rw [hcol, hQ]; rfl⟩

/-- L8.5 (helper): the representatives seen from the stopping column are pre-stop roles. -/
theorem rep_preStop_D4 {S : ScanSetup.{u}} (hsd : Scan.stopData S.H = some S.sd) {q : Nat}
    {o v : Role} (hr : S.sd.col.rep 0 q = some (o, v)) : o ∈ S.preStop ∧ v ∈ S.preStop := by
  obtain ⟨x, col, hc⟩ := stop_col_cons_D4 hsd
  exact rep_before_D4 hc hr

/-- L8.5 (helper): the frame roles of the stopping column are pre-stop roles. -/
theorem reps0_preStop_D4 {S : ScanSetup.{u}} (hsd : Scan.stopData S.H = some S.sd)
    {ov : Role × Role} (hov : ov ∈ S.sd.col.reps0) : ov.1 ∈ S.preStop ∧ ov.2 ∈ S.preStop := by
  obtain ⟨q, -, hq⟩ := List.mem_filterMap.1 hov
  exact rep_preStop_D4 hsd hq

/-- L8.5 (helper): the query entry `j < |Q|`. -/
theorem query_entry_D4 {S : ScanSetup.{u}} (hsd : Scan.stopData S.H = some S.sd) {j : Nat}
    (hj : j < S.sd.Q.length) : ∃ p Jh, S.sd.Q[j]? = some (p, Jh) ∧
      S.H.entryAt ⟨S.sd.col, j⟩ = some (p, Jh) ∧ (⟨S.sd.col, j⟩ : EntryAddr) ∈ S.H.entryAddrs := by
  obtain ⟨hcol, -⟩ := Scan.stopData_spec hsd
  obtain ⟨⟨p, Jh⟩, hq⟩ : ∃ y, S.sd.Q[j]? = some y := ⟨_, List.getElem?_eq_getElem hj⟩
  have hent : S.H.entryAt ⟨S.sd.col, j⟩ = some (p, Jh) := by
    simp [Tree.entryAt, hcol, List.getElem?_append_left hj, hq]
  exact ⟨p, Jh, hq, hent, (Tree.mem_entryAddrs_iff _ _).2 (by rw [hent]; rfl)⟩

/-- L8.5 (helper, L8.2c): the structural atoms touching query entry `j` lie in the query graph. -/
theorem localStruct_query_D4 {S : ScanSetup.{u}} (hL : Scan.InL S.H)
    (hsd : Scan.stopData S.H = some S.sd) {j : Nat} (hj : j < S.sd.Q.length) :
    ∀ a ∈ localStruct S.H ⟨S.sd.col, j⟩, a ∈ S.queryGraph := by
  intro a ha
  obtain ⟨_, _, _, _, he⟩ := query_entry_D4 hsd hj
  have hvars := localStruct_vars hL.1 he a ha
  obtain ⟨hg, hs⟩ := List.mem_filter.1 ha
  simp only [Bool.and_eq_true, List.any_eq_true] at hs
  obtain ⟨-, w, hw, hwin⟩ := hs
  have hq : ∀ v ∈ a.vars, v.inEntry ⟨S.sd.col, j⟩ = true → v ∈ S.queryRoles := fun v hv hin =>
    (mem_queryRoles_iff_D4 hsd).2 ⟨graph_vars_roles_D4 hg v hv, j, hj, hin⟩
  refine List.mem_filter.2 ⟨List.mem_filter.2 ⟨hg, List.all_eq_true.2 fun v hv => ?_⟩, ?_⟩
  · simp only [List.mem_append, List.mem_singleton, decide_eq_true_eq]
    rcases hvars v hv with hin | rfl | ⟨ov, hov, h⟩
    · exact Or.inr (hq v hv hin)
    · exact Or.inl (Or.inr rfl)
    · have := reps0_preStop_D4 hsd hov
      rcases h with rfl | rfl
      · exact Or.inl (Or.inl this.1)
      · exact Or.inl (Or.inl this.2)
  · exact List.any_eq_true.2 ⟨w, hw, by simp [hq w hw hwin]⟩

/-- L8.5 (helper): the positive heads of query entry `j` at `h_j` (S4, D7.1 frame of entry `j`). -/
theorem query_heads_D4 {P : Prims.{u}} {S : ScanSetup.{u}} (hS : SetupClauses P S) {j : Nat}
    (hj : j < S.sd.Q.length) (β : Role → Ordinal.{u}) :
    ∃ p o v, (S.sd.Q[j]?).map Prod.fst = some p ∧
      (frameOf ⟨S.sd.col, j⟩).reps[p]? = some (o, v) ∧ o ∈ S.preStop ∧ v ∈ S.preStop ∧
      P.Edge (queryOwnerVal S j) (S.asg S.stopNm) (S.fitVal β o) ∧
      P.Edge (queryOwnerVal S j) (S.asg S.stopNm) (S.fitVal β v) := by
  have hsd := hS.1.2.2.2.1
  have hV := hS.1.2.1.1
  obtain ⟨p, Jh, hq, hent, he⟩ := query_entry_D4 hsd hj
  obtain ⟨⟨o, v⟩, hr⟩ := Option.isSome_iff_exists.1 (show (S.sd.col.rep 0 p).isSome by
    simp only [ColAddr.rep, Option.isSome_map]; exact hV _ he p Jh hent)
  obtain ⟨ho, hv⟩ := rep_preStop_D4 hsd hr
  have hTq : Role.ord S.sd.col ∉ S.queryRoles := not_query_D4 hsd (Or.inr rfl)
  have hoq : o ∉ S.queryRoles := not_query_D4 hsd (Or.inl ho)
  have hvq : v ∉ S.queryRoles := not_query_D4 hsd (Or.inl hv)
  have hsq : Role.slot ⟨S.sd.col, j⟩ ∈ S.queryRoles :=
    (mem_queryRoles_iff_D4 hsd).2 ⟨slot_mem_roles he, j, hj, by simp [Role.inEntry]⟩
  obtain ⟨he1, he2⟩ := edge_mem_graph he hent hr
  have hin : ∀ w, w = o ∨ w = v → w ∈ S.preStop → BaseAtom.edge (.slot ⟨S.sd.col, j⟩)
      (.ord S.sd.col) w ∈ graph S.H → BaseAtom.edge (.slot ⟨S.sd.col, j⟩) (.ord S.sd.col) w ∈
        S.queryGraph := by
    intro w _ hw hg
    refine List.mem_filter.2 ⟨List.mem_filter.2 ⟨hg, ?_⟩, ?_⟩
    · simp [BaseAtom.vars, hsq, hw]
    · simp [BaseAtom.vars]
  have h4 := hS.2.2.2.1
  have hbT : S.baseVal (.ord S.sd.col) = S.asg S.stopNm := by simp [ScanSetup.baseVal]
  refine ⟨p, o, v, by simp [hq], ?_, ho, hv, ?_, ?_⟩
  · show S.sd.col.reps0[p]? = some (o, v)
    rw [reps0_getElem?]; exact hr
  · have := h4 _ (hin o (Or.inl rfl) ho he1)
    simpa [BaseAtom.Holds, setupPosVal, ScanSetup.fitVal, hsq, hTq, hoq, hbT, queryOwnerVal]
      using this
  · have := h4 _ (hin v (Or.inr rfl) hv he2)
    simpa [BaseAtom.Holds, setupPosVal, ScanSetup.fitVal, hsq, hTq, hvq, hbT, queryOwnerVal]
      using this

/-- L8.5 (helper): bank roles have limit values (S5). -/
theorem bank_lim_D4 {P : Prims.{u}} {S : ScanSetup.{u}} (hS : SetupClauses P S) {x : Role}
    (hx : x ∈ setupBank S) : IsLim (setupBankVal S x) := by
  have hxr := ((mem_bank_iff_D4 S).1 hx).1
  have hg : BaseAtom.lim x ∈ graph S.H := by
    simp only [graph, List.mem_append]; exact Or.inl (Or.inl (Or.inl (List.mem_map_of_mem hxr)))
  refine hS.2.2.2.2.1 (BaseAtom.lim x) (List.mem_filter.2 ⟨List.mem_filter.2 ⟨hg, ?_⟩, ?_⟩)
  · simp [BaseAtom.vars, hx]
  · simp [BaseAtom.vars, hx]

/-- L8.5 (helper): the slot of query entry `j < |Q|` is a role of entry `j`. -/
theorem slot_entryRoles_D4 {S : ScanSetup.{u}} (hsd : Scan.stopData S.H = some S.sd) {j : Nat}
    (hj : j < S.sd.Q.length) : Role.slot ⟨S.sd.col, j⟩ ∈ S.entryRoles j := by
  obtain ⟨_, _, _, _, he⟩ := query_entry_D4 hsd hj
  refine List.mem_filter.2 ⟨(mem_queryRoles_iff_D4 hsd).2 ⟨slot_mem_roles he, j, hj, ?_⟩, ?_⟩ <;>
    simp [Role.inEntry]

/-- L8.5 (helper): `c_0` is attained at a role of query entry `j`. -/
theorem queryBlockMax_attained_D4 {S : ScanSetup.{u}} (hsd : Scan.stopData S.H = some S.sd)
    {j : Nat} (hj : j < S.sd.Q.length) :
    ∃ z ∈ S.entryRoles j, queryBlockMax S j = S.asg (S.qNm z) := by
  have hmem := slot_entryRoles_D4 hsd hj
  unfold queryBlockMax
  generalize S.entryRoles j = l at hmem ⊢
  cases l with
  | nil => simp at hmem
  | cons z0 l =>
    have h := foldr_max_mem (S.asg (S.qNm z0)) (l.map fun x => S.asg (S.qNm x))
    rw [List.map_cons]
    rcases List.mem_cons.1 h with h | h
    · exact ⟨z0, List.mem_cons_self, h⟩
    · obtain ⟨z, hz, hzv⟩ := List.mem_map.1 h
      exact ⟨z, List.mem_cons_of_mem _ hz, hzv.symm ▸ rfl⟩

/-- L8.5 (helper): forests of a relabelled tree. -/
theorem forestAt_map_D4 {α β : Type} (f : α → β) : ∀ (π : List (Nat × Nat)) (t : Tree α),
    (t.map f).forestAt π = (t.forestAt π).map (Tree.map f)
  | [], t => rfl
  | (c, i) :: rest, ⟨cols⟩ => by
    rw [Tree.forestAt_cons, Tree.forestAt_cons]
    simp only [Tree.map, Tree.cols, Scan.treeMapCols_eq_map, List.getElem?_map]
    cases h : cols[c]? with
    | none => simp
    | some col =>
      simp only [Option.map_some, Option.bind_some, Scan.treeMapCol_eq_map, List.getElem?_map]
      cases h' : col[i]? with
      | none => simp
      | some x => simp [forestAt_map_D4 f rest x.2]

/-- L8.5 (helper): entries of a relabelled tree. -/
theorem entryAt_map_D4 {α β : Type} (f : α → β) (t : Tree α) (e : EntryAddr) :
    (t.map f).entryAt e = (t.entryAt e).map fun x => (f x.1, x.2.map f) := by
  simp only [Tree.entryAt, Tree.colAt, forestAt_map_D4]
  cases t.forestAt e.col.path with
  | none => simp
  | some g =>
    obtain ⟨gc⟩ := g
    simp only [Option.map_some, Option.bind_some, Tree.map, Tree.cols, Scan.treeMapCols_eq_map,
      List.getElem?_map]
    cases gc[e.col.col]? with
    | none => simp
    | some col => simp [Scan.treeMapCol_eq_map, List.getElem?_map]

/-- L8.5 (helper): a false label `(false, q)` of `h_a(B)` has `q < a`. -/
theorem relKey_false_lt_D4 {a : Nat} {B : Forest} {e : EntryAddr} {q : Nat} {h : Key}
    (he : (relKey a B).entryAt e = some ((false, q), h)) : q < a := by
  rw [relKey_eq_map, entryAt_map_D4] at he
  obtain ⟨⟨p, h'⟩, -, hx⟩ := Option.map_eq_some_iff.1 he
  simp only [relLabel, Prod.mk.injEq] at hx
  split_ifs at hx with hp
  · obtain ⟨⟨-, rfl⟩, -⟩ := hx; exact hp
  · simp at hx

/-- L8.5 (helper): the frame fields read by a positive block of `h_a(B)` are visible below `a`
or the selector (false labels, D1.4). -/
theorem posBlock_ordcur_D4 {a : Nat} {B : Forest} {sel : Nat} {w : BlkVar}
    (hw : w ∈ baseVars (posBlock (relKey a B) sel)) {q : Nat} (hq : w = .ord q ∨ w = .cur q) :
    q < a ∨ q = sel := by
  simp only [baseVars, List.mem_flatMap] at hw
  obtain ⟨b, hb, hwb⟩ := hw
  simp only [posBlock, freeBlock, List.mem_append, List.mem_cons, List.mem_map,
    List.mem_filterMap, List.mem_flatMap, List.not_mem_nil] at hb
  have hno : ∀ x, (x = BlkVar.owner ∨ ∃ r, x = .inner r) → ¬ (x = .ord q ∨ x = .cur q) := by
    rintro x (rfl | ⟨r, rfl⟩) (h | h) <;> cases h
  rcases hb with ((((rfl | ⟨_, ⟨r, -, rfl⟩, rfl⟩) | ⟨xy, hxy, rfl⟩) | ⟨c, -, hca⟩) | ⟨e, -, hea⟩) |
    rfl | rfl | hF
  · simp only [BaseAtom.vars, List.mem_singleton] at hwb
    exact absurd (hwb ▸ hq) (hno _ (Or.inl rfl))
  · simp only [BaseAtom.vars, List.mem_singleton] at hwb
    exact absurd (hwb ▸ hq) (hno _ (Or.inr ⟨r, rfl⟩))
  · obtain ⟨h1, h2⟩ := List.of_mem_zip hxy
    simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false] at hwb
    rcases hwb with rfl | rfl
    · rcases List.mem_cons.1 h1 with h | h
      · exact absurd hq (hno _ (Or.inl h))
      · obtain ⟨r, -, hr⟩ := List.mem_map.1 h
        exact absurd hq (hno _ (Or.inr ⟨r, hr.symm⟩))
    · obtain ⟨r, -, hr⟩ := List.mem_map.1 h2
      exact absurd hq (hno _ (Or.inr ⟨r, hr.symm⟩))
  · split_ifs at hca
    cases hca
    simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false] at hwb
    rcases hwb with rfl | rfl <;> exact absurd hq (hno _ (Or.inr ⟨_, rfl⟩))
  · cases hx : (relKey a B).entryAt e with
    | none => rw [hx] at hea; simp at hea
    | some x =>
      obtain ⟨⟨bb, q'⟩, h⟩ := x
      rw [hx] at hea
      cases bb with
      | false =>
        have hlt := relKey_false_lt_D4 hx
        simp only [List.mem_cons, List.mem_nil_iff, or_false] at hea
        rcases hea with rfl | rfl <;>
          simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false] at hwb <;>
          rcases hwb with rfl | rfl | rfl
        all_goals first
          | exact absurd hq (hno _ (Or.inr ⟨_, rfl⟩))
          | (rcases hq with h | h <;> cases h <;> exact Or.inl hlt)
      | true =>
        cases q' with
        | zero =>
          simp only [List.mem_cons, List.mem_nil_iff, or_false] at hea
          rcases hea with rfl | rfl <;>
            simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false] at hwb <;>
            rcases hwb with rfl | rfl | rfl
          all_goals first
            | exact absurd hq (hno _ (Or.inr ⟨_, rfl⟩))
            | exact absurd hq (hno _ (Or.inl rfl))
            | (rcases hq with h | h <;> cases h)
        | succ v =>
          simp only at hea
          cases hr : e.col.rep 1 (v + 1) with
          | none => rw [hr] at hea; simp at hea
          | some ow =>
            rw [hr] at hea
            simp only [List.mem_cons, List.mem_nil_iff, or_false] at hea
            rcases hea with rfl | rfl <;>
              simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false] at hwb <;>
              rcases hwb with rfl | rfl | rfl <;> exact absurd hq (hno _ (Or.inr ⟨_, rfl⟩))
  · simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false] at hwb
    rcases hwb with rfl | rfl | rfl
    · exact absurd hq (hno _ (Or.inl rfl))
    · rcases hq with h | h <;> cases h
    · rcases hq with h | h <;> cases h; exact Or.inr rfl
  · simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false] at hwb
    rcases hwb with rfl | rfl | rfl
    · exact absurd hq (hno _ (Or.inl rfl))
    · rcases hq with h | h <;> cases h
    · rcases hq with h | h <;> cases h; exact Or.inr rfl
  · exact hF.elim

/-- L8.5 (helper): every atom of a positive block reads the host, the owner or an internal role. -/
theorem posBlock_has_new_D4 (K : Key) (sel : Nat) : ∀ b ∈ posBlock K sel,
    ∃ w ∈ b.vars, w = .host ∨ w = .owner ∨ ∃ r, w = .inner r := by
  intro b hb
  simp only [posBlock, freeBlock, List.mem_append, List.mem_cons, List.mem_map,
    List.mem_filterMap, List.mem_flatMap, List.not_mem_nil] at hb
  rcases hb with ((((rfl | ⟨_, ⟨r, -, rfl⟩, rfl⟩) | ⟨xy, hxy, rfl⟩) | ⟨c, -, hca⟩) | ⟨e, -, hea⟩) |
    rfl | rfl | hF
  · exact ⟨.owner, by simp [BaseAtom.vars], Or.inr (Or.inl rfl)⟩
  · exact ⟨.inner r, by simp [BaseAtom.vars], Or.inr (Or.inr ⟨r, rfl⟩)⟩
  · obtain ⟨-, h2⟩ := List.of_mem_zip hxy
    obtain ⟨r, -, hr⟩ := List.mem_map.1 h2
    exact ⟨xy.2, by simp [BaseAtom.vars], Or.inr (Or.inr ⟨r, hr.symm⟩)⟩
  · split_ifs at hca
    cases hca
    exact ⟨.inner (.ord c), by simp [BaseAtom.vars], Or.inr (Or.inr ⟨_, rfl⟩)⟩
  · have hme : ∀ c a', BaseAtom.edge (BlkVar.inner (.slot e)) c a' = b →
        ∃ w ∈ b.vars, w = .host ∨ w = .owner ∨ ∃ r, w = .inner r := by
      rintro c a' rfl; exact ⟨.inner (.slot e), by simp [BaseAtom.vars], Or.inr (Or.inr ⟨_, rfl⟩)⟩
    cases hx : K.entryAt e with
    | none => rw [hx] at hea; simp at hea
    | some x =>
      obtain ⟨⟨bb, q'⟩, h⟩ := x
      rw [hx] at hea
      cases bb with
      | false =>
        simp only [List.mem_cons, List.mem_nil_iff, or_false] at hea
        rcases hea with rfl | rfl <;> exact hme _ _ rfl
      | true =>
        cases q' with
        | zero =>
          simp only [List.mem_cons, List.mem_nil_iff, or_false] at hea
          rcases hea with rfl | rfl <;> exact hme _ _ rfl
        | succ v =>
          simp only at hea
          cases hr : e.col.rep 1 (v + 1) with
          | none => rw [hr] at hea; simp at hea
          | some ow =>
            rw [hr] at hea
            simp only [List.mem_cons, List.mem_nil_iff, or_false] at hea
            rcases hea with rfl | rfl <;> exact hme _ _ rfl
  · exact ⟨.owner, by simp [BaseAtom.vars], Or.inr (Or.inl rfl)⟩
  · exact ⟨.owner, by simp [BaseAtom.vars], Or.inr (Or.inl rfl)⟩
  · exact hF.elim

/-- L8.5 (helper): a realization of a free block puts the owner below every internal role. -/
theorem freeBlock_owner_lt_D4 {P : Prims.{u}} {K : Key} {β : BlkVar → Ordinal.{u}}
    (h : BaseHolds P (freeBlock K) β) {r : Role} (hr : r ∈ K.roles) : β .owner < β (.inner r) := by
  have hpw := chain_pairwise (D := freeBlock K) (l := BlkVar.owner :: K.roles.map BlkVar.inner)
    (fun xy hxy => by
      simp only [freeBlock]
      exact List.mem_append_left _ (List.mem_append_left _ (List.mem_append_right _
        (List.mem_map_of_mem (f := fun xy => BaseAtom.lt xy.1 xy.2) hxy)))) h
  exact List.rel_of_pairwise_cons hpw (List.mem_map_of_mem hr)

/-- L8.5 (helper): the frame of entry `e` reads `A_{e.col}` and representatives of its stack. -/
theorem toFr_frameOf_D4 {e : EntryAddr} {w : BlkVar} {x : Role}
    (h : (frameOf e).toFr w = some x) :
    x = .ord e.col ∨ ∃ ov ∈ e.col.reps0, x = ov.1 ∨ x = ov.2 := by
  cases w with
  | host => cases h; exact Or.inl rfl
  | ord q =>
    obtain ⟨ov, hov, rfl⟩ := Option.map_eq_some_iff.1 h
    exact Or.inr ⟨ov, List.mem_of_getElem? hov, Or.inl rfl⟩
  | cur q =>
    obtain ⟨ov, hov, rfl⟩ := Option.map_eq_some_iff.1 h
    exact Or.inr ⟨ov, List.mem_of_getElem? hov, Or.inr rfl⟩
  | owner => cases h
  | inner _ => cases h

/-- L8.5 (helper): a frame field below the column number is present. -/
theorem toFr_isSome_D4 (e : EntryAddr) {q : Nat} (hq : q < e.col.num 0) :
    ((frameOf e).toFr (.ord q)).isSome ∧ ((frameOf e).toFr (.cur q)).isSome := by
  have hs : (e.col.rep 0 q).isSome := by
    simp only [ColAddr.rep, Option.isSome_map]
    exact (ColAddr.resolve_isSome_iff 0 e.col q).2 ⟨Nat.zero_le _, hq⟩
  simp only [Frame.toFr, frameOf, reps0_getElem?, Option.isSome_map]
  exact ⟨hs, hs⟩

/-- L8.5 (helper): `T` followed by the query is an `lt` chain of the query graph, hence strictly
increasing at the original values (S4). -/
theorem query_pairwise_D4 {P : Prims.{u}} {S : ScanSetup.{u}} (hS : SetupClauses P S) :
    (Role.ord S.sd.col :: S.queryRoles).Pairwise
      fun a b => setupPosVal S a < setupPosVal S b := by
  have hsd := hS.1.2.2.2.1
  obtain ⟨post, hr, -⟩ := stop_roles_D4 hsd
  have hr' : S.H.roles = S.preStop ++ (Role.ord S.sd.col :: S.queryRoles) ++
      (Role.slot (Scan.closingSlot S.sd) :: post) := by rw [hr]; simp
  refine chain_pairwise (D := S.queryGraph) (fun xy hxy => ?_) hS.2.2.2.1
  have hlt := lt_chain_graph_D4 hr' xy hxy
  obtain ⟨a, b⟩ := xy
  obtain ⟨s, t, hst⟩ := mem_zip_tail_iff_D4.1 hxy
  have hb : b ∈ S.queryRoles := by
    cases s with
    | nil => simp only [List.nil_append, List.cons.injEq] at hst; rw [hst.2]; simp
    | cons z s =>
      simp only [List.cons_append, List.cons.injEq] at hst
      rw [hst.2]; simp
  have ha : a = .ord S.sd.col ∨ a ∈ S.queryRoles := by
    have : a ∈ Role.ord S.sd.col :: S.queryRoles := by rw [hst]; simp
    simpa using this
  refine List.mem_filter.2 ⟨List.mem_filter.2 ⟨hlt, ?_⟩, ?_⟩
  · simp only [BaseAtom.vars, List.all_cons, List.all_nil, Bool.and_true, Bool.and_eq_true,
      decide_eq_true_eq, List.mem_append, List.mem_singleton]
    refine ⟨?_, Or.inr hb⟩
    rcases ha with rfl | ha
    · exact Or.inl (Or.inr rfl)
    · exact Or.inr ha
  · simp only [BaseAtom.vars, List.any_cons, List.any_nil, Bool.or_false, Bool.or_eq_true,
      decide_eq_true_eq, List.mem_cons]
    exact Or.inr (Or.inr hb)

/-- L8.5 (helper): `ρ` is below every original query value. -/
theorem query_stop_lt_D4 {P : Prims.{u}} {S : ScanSetup.{u}} (hS : SetupClauses P S) {y : Role}
    (hy : y ∈ S.queryRoles) : S.asg S.stopNm < S.asg (S.qNm y) := by
  have h := List.rel_of_pairwise_cons (query_pairwise_D4 hS) hy
  have hT := not_query_D4 hS.1.2.2.2.1 (x := .ord S.sd.col) (Or.inr rfl)
  simpa [setupPosVal, ScanSetup.fitVal, hy, hT, ScanSetup.baseVal] using h

/-- L8.5 (helper): original values of an earlier query entry are below those of a later one. -/
theorem query_entry_lt_D4 {P : Prims.{u}} {S : ScanSetup.{u}} (hS : SetupClauses P S)
    {x y : Role} {k l : Nat} (hx : x ∈ S.queryRoles) (hxk : x.inEntry ⟨S.sd.col, k⟩ = true)
    (hy : y ∈ S.queryRoles) (hyl : y.inEntry ⟨S.sd.col, l⟩ = true) (hkl : k < l) :
    S.asg (S.qNm x) < S.asg (S.qNm y) := by
  obtain ⟨-, -, hQ⟩ := stop_roles_D4 hS.1.2.2.2.1
  have hpw := (List.pairwise_cons.1 (query_pairwise_D4 hS)).2
  rw [hQ] at hpw
  have h := rolesCol_split_lt_D4 hpw (by rw [← hQ]; exact hx) hxk (by rw [← hQ]; exact hy) hyl hkl
  simpa [setupPosVal, ScanSetup.fitVal, hx, hy] using h

/-- L8.5 (helper): `C_j` is below every original value of query entry `j`. -/
theorem Cmax_lt_entry_D4 {P : Prims.{u}} {S : ScanSetup.{u}} (hS : SetupClauses P S) {j : Nat}
    {y : Role} (hy : y ∈ S.entryRoles j) : S.Cmax j < S.asg (S.qNm y) := by
  obtain ⟨hyq, hyin⟩ := List.mem_filter.1 hy
  refine foldr_max_lt_iff_D4.2 ⟨query_stop_lt_D4 hS hyq, fun z hz => ?_⟩
  obtain ⟨x, hx, rfl⟩ := List.mem_map.1 hz
  obtain ⟨hxq, hxin⟩ := List.mem_filter.1 hx
  simp only [List.any_eq_true, List.mem_range] at hxin
  obtain ⟨k, hk, hxk⟩ := hxin
  exact query_entry_lt_D4 hS hxq hxk hyq hyin hk

/-- L8.5 (helper): fitted roles at `j + 1` are the fitted roles at `j` and the roles of entry `j`. -/
theorem mem_fittedRoles_succ_D4 (S : ScanSetup.{u}) {j : Nat} {x : Role} :
    x ∈ S.fittedRoles (j + 1) ↔ x ∈ S.fittedRoles j ∨ x ∈ S.entryRoles j := by
  simp only [ScanSetup.fittedRoles, ScanSetup.entryRoles, List.mem_filter, List.any_eq_true,
    List.mem_range]
  constructor
  · rintro ⟨hq, k, hk, hin⟩
    rcases Nat.lt_succ_iff_lt_or_eq.1 hk with hk | rfl
    · exact Or.inl ⟨hq, k, hk, hin⟩
    · exact Or.inr ⟨hq, hin⟩
  · rintro (⟨hq, k, hk, hin⟩ | ⟨hq, hin⟩)
    · exact ⟨hq, k, by omega, hin⟩
    · exact ⟨hq, j, by omega, hin⟩

/-- L8.5 (helper): the internal roles of an entry, placed under its height path, are roles of
the tree inside the entry. -/
theorem under_mem_D4 {t : Forest} {e : EntryAddr} (he : e ∈ t.entryAddrs) {Jh : Forest}
    (hh : t.heightAt e = some Jh) {r : Role} (hr : r ∈ Jh.roles) :
    Role.under e.heightPath r ∈ t.roles ∧ (Role.under e.heightPath r).inEntry e = true := by
  obtain ⟨post, hroles, -⟩ := Tree.roles_entry he
  rw [hh, Option.getD_some] at hroles
  refine ⟨by rw [hroles]; exact List.mem_append_right _ (List.mem_cons_of_mem _
    (List.mem_append_left _ (List.mem_map_of_mem hr))), (inEntry_iff _ _).2 (Or.inr ?_)⟩
  rw [Role.path_under]; exact List.prefix_append _ _

/-- L8.5 (helper): the positive candidate of query entry `j`: the fitted frame, and the original
values (S4) on the new variables. -/
noncomputable def posCand_D4 (S : ScanSetup.{u}) (j : Nat) (β : Role → Ordinal.{u}) (w : BlkVar) :
    Ordinal.{u} :=
  match (frameOf ⟨S.sd.col, j⟩).toFr w with
  | some x => S.fitVal β x
  | none => setupPosVal S (blockMap ⟨S.sd.col, j⟩ w)

/-- L8.5 (helper): the positive candidate realizes the positive block of query entry `j`; its new
variables are the owner and internal roles, read as roles of entry `j` with their original
values (D7.1a, S4, L8.2c). -/
theorem posCand_spec_D4 {P : Prims.{u}} {S : ScanSetup.{u}} (hS : SetupClauses P S) {j : Nat}
    (hj : j < S.sd.Q.length) (β : Role → Ordinal.{u}) :
    BaseHolds P (posBlock (queryKey S j) (querySel S j)) (posCand_D4 S j β) ∧
    (∀ w x, (frameOf ⟨S.sd.col, j⟩).toFr w = some x → posCand_D4 S j β w = S.fitVal β x) ∧
    (∀ w ∈ baseVars (posBlock (queryKey S j) (querySel S j)),
      (frameOf ⟨S.sd.col, j⟩).toFr w = none →
      (w = .owner ∨ ∃ r ∈ (queryKey S j).roles, w = .inner r) ∧
      blockMap ⟨S.sd.col, j⟩ w ∈ S.entryRoles j ∧
      posCand_D4 S j β w = S.asg (S.qNm (blockMap ⟨S.sd.col, j⟩ w))) := by
  have hsd := hS.1.2.2.2.1
  have hV := hS.1.2.1.1
  obtain ⟨-, -, ht, -⟩ := Scan.stopData_spec hsd
  obtain ⟨p, Jh, hq, hent, he⟩ := query_entry_D4 hsd hj
  have hhgt : S.H.heightAt ⟨S.sd.col, j⟩ = some Jh := by simp [Tree.heightAt, hent]
  have hK : queryKey S j = relKey (S.sd.col.num 0)
      ((S.H.heightAt ⟨S.sd.col, j⟩).getD Tree.empty) := by
    simp [queryKey, Scan.queryKeys, List.getElem?_map, hq, hhgt, ht]
  have hsel : querySel S j = ((S.H.entryAt ⟨S.sd.col, j⟩).map Prod.fst).getD 0 := by
    simp [querySel, hq, hent]
  have hplt : p < S.sd.col.num 0 :=
    ((ColAddr.resolve_isSome_iff 0 _ p).1 (hV _ he p Jh hent)).2
  have hKr : (queryKey S j).roles = Jh.roles := by rw [hK, relKey_roles, hhgt]; rfl
  have hentq : ∀ y ∈ S.entryRoles j, y ∈ S.queryRoles := fun y hy => (List.mem_filter.1 hy).1
  have hinner : ∀ r ∈ Jh.roles, Role.under (EntryAddr.heightPath ⟨S.sd.col, j⟩) r ∈
      S.entryRoles j := by
    intro r hr
    obtain ⟨h1, h2⟩ := under_mem_D4 he hhgt hr
    exact List.mem_filter.2 ⟨(mem_queryRoles_iff_D4 hsd).2 ⟨h1, j, hj, h2⟩, h2⟩
  have hsj := slot_entryRoles_D4 hsd hj
  have hTq : Role.ord S.sd.col ∉ S.queryRoles := not_query_D4 hsd (Or.inr rfl)
  have hfrq : ∀ w x, (frameOf ⟨S.sd.col, j⟩).toFr w = some x → x ∉ S.queryRoles := by
    intro w x hx
    rcases toFr_frameOf_D4 hx with rfl | ⟨ov, hov, rfl | rfl⟩
    · exact hTq
    · exact not_query_D4 hsd (Or.inl (reps0_preStop_D4 hsd hov).1)
    · exact not_query_D4 hsd (Or.inl (reps0_preStop_D4 hsd hov).2)
  have himg : ∀ w ∈ baseVars (posBlock (queryKey S j) (querySel S j)),
      blockMap ⟨S.sd.col, j⟩ w ∈ S.preStop ∨ blockMap ⟨S.sd.col, j⟩ w = .ord S.sd.col ∨
        blockMap ⟨S.sd.col, j⟩ w ∈ S.queryRoles := by
    intro w hw
    rcases posBlock_vars _ _ w hw with rfl | rfl | ⟨q, rfl | rfl⟩ | ⟨r, hr, rfl⟩
    · exact Or.inr (Or.inl rfl)
    · exact Or.inr (Or.inr (hentq _ hsj))
    · simp only [blockMap]
      cases hr : S.sd.col.rep 0 q with
      | none => exact Or.inr (Or.inl rfl)
      | some ov => exact Or.inl (rep_preStop_D4 hsd hr).1
    · simp only [blockMap]
      cases hr : S.sd.col.rep 0 q with
      | none => exact Or.inr (Or.inl rfl)
      | some ov => exact Or.inl (rep_preStop_D4 hsd hr).2
    · exact Or.inr (Or.inr (hentq _ (hinner r (hKr ▸ hr))))
  refine ⟨fun a ha => ?_, fun w x hx => by simp [posCand_D4, hx], fun w hw hn => ?_⟩
  · have hg := posBlock_heads_graph he hV a (by rw [← hK, ← hsel]; exact ha)
    have hqg : a.map (blockMap ⟨S.sd.col, j⟩) ∈ S.queryGraph := by
      refine List.mem_filter.2 ⟨List.mem_filter.2 ⟨hg, List.all_eq_true.2 fun v hv => ?_⟩, ?_⟩
      · rw [baseAtom_vars_map] at hv
        obtain ⟨w, hw, rfl⟩ := List.mem_map.1 hv
        have := himg w (List.mem_flatMap.2 ⟨a, ha, hw⟩)
        simp only [List.mem_append, List.mem_singleton, decide_eq_true_eq]
        tauto
      · obtain ⟨w, hw, hw'⟩ := posBlock_has_new_D4 _ _ a ha
        rw [baseAtom_vars_map]
        refine List.any_eq_true.2 ⟨blockMap ⟨S.sd.col, j⟩ w, List.mem_map_of_mem hw, ?_⟩
        simp only [decide_eq_true_eq, List.mem_cons]
        rcases hw' with rfl | rfl | ⟨r, rfl⟩
        · exact Or.inl rfl
        · exact Or.inr (hentq _ hsj)
        · have hw2 : BlkVar.inner r ∈ baseVars (posBlock (queryKey S j) (querySel S j)) :=
            List.mem_flatMap.2 ⟨a, ha, hw⟩
          obtain ⟨r', hr', h⟩ : ∃ r' ∈ (queryKey S j).roles, BlkVar.inner r = .inner r' := by
            rcases posBlock_vars _ _ _ hw2 with h | h | ⟨q, h | h⟩ | h
            · cases h
            · cases h
            · cases h
            · cases h
            · exact h
          cases h
          exact Or.inr (hentq _ (hinner r (hKr ▸ hr')))
    have h4 := hS.2.2.2.1 _ hqg
    rw [baseAtom_holds_map'] at h4
    refine (BaseAtom.holds_congr P a _ _ fun w _ => ?_).1 h4
    cases hx : (frameOf ⟨S.sd.col, j⟩).toFr w with
    | none => simp [posCand_D4, hx]
    | some x =>
      simp only [Function.comp, posCand_D4, hx]
      rw [blockMap_frame _ w x hx]
      simp [setupPosVal, ScanSetup.fitVal, hfrq w x hx]
  · have hw' : w ∈ baseVars (posBlock (relKey (S.sd.col.num 0)
        ((S.H.heightAt ⟨S.sd.col, j⟩).getD Tree.empty)) (querySel S j)) := by rw [← hK]; exact hw
    have hselp : querySel S j = p := by simp [querySel, hq]
    rcases posBlock_vars _ _ w hw with rfl | rfl | ⟨q, hq' | hq'⟩ | ⟨r, hr, rfl⟩
    · simp [Frame.toFr] at hn
    · refine ⟨Or.inl rfl, hsj, ?_⟩
      simp [posCand_D4, hn, blockMap, setupPosVal, ScanSetup.fitVal, hentq _ hsj]
    · exfalso
      have hlt : q < S.sd.col.num 0 := by
        rcases posBlock_ordcur_D4 hw' (Or.inl hq') with h | h
        · exact h
        · rw [h, hselp]; exact hplt
      subst hq'
      have := (toFr_isSome_D4 ⟨S.sd.col, j⟩ hlt).1
      rw [hn] at this; simp at this
    · exfalso
      have hlt : q < S.sd.col.num 0 := by
        rcases posBlock_ordcur_D4 hw' (Or.inr hq') with h | h
        · exact h
        · rw [h, hselp]; exact hplt
      subst hq'
      have := (toFr_isSome_D4 ⟨S.sd.col, j⟩ hlt).2
      rw [hn] at this; simp at this
    · have hr' := hinner r (hKr ▸ hr)
      refine ⟨Or.inr ⟨r, hr, rfl⟩, hr', ?_⟩
      simp [posCand_D4, hn, blockMap, setupPosVal, ScanSetup.fitVal, hentq _ hr']

/-- L8.5 (helper): `c_0` is at most `C_{j+1}`. -/
theorem queryBlockMax_le_Cmax_D4 (S : ScanSetup.{u}) (j : Nat) :
    queryBlockMax S j ≤ S.Cmax (j + 1) := by
  refine foldr_max_le_iff_D4.2 ⟨zero_le, fun z hz => ?_⟩
  obtain ⟨x, hx, rfl⟩ := List.mem_map.1 hz
  exact le_foldr_max_mem_D4 (List.mem_map_of_mem ((mem_fittedRoles_succ_D4 S).2 (Or.inr hx)))

/-- L8.5b: the scan invariant (17) at state `(i, j)`. -/
def ScanInv (P : Prims.{u}) (S : ScanSetup.{u}) (i j : Nat) (β : Role → Ordinal.{u}) : Prop :=
  S.Fitted P j β ∧ S.Lmax j β < S.ownerVal i ∧ S.Lmax j β ≤ S.Cmax j

/-- L8.5 (helper): (17) at `j + 1` from (17) at `j` and bounds on the values of entry `j`. -/
theorem inv_step_D4 {P : Prims.{u}} (S : ScanSetup.{u}) {i' j : Nat} {β β' : Role → Ordinal.{u}}
    (hfit : S.Fitted P (j + 1) β') (hagree : ∀ x ∈ S.fittedRoles j, β' x = β x)
    (h1 : S.Lmax j β < S.ownerVal i') (h2 : S.Lmax j β ≤ S.Cmax j)
    (hlt : ∀ x ∈ S.entryRoles j, β' x < S.ownerVal i')
    (hle : ∀ x ∈ S.entryRoles j, β' x ≤ S.Cmax (j + 1)) : ScanInv P S i' (j + 1) β' := by
  have hold : ∀ x ∈ S.fittedRoles j, β' x ≤ S.Lmax j β := fun x hx => by
    rw [hagree x hx]; exact le_foldr_max_mem_D4 (List.mem_map_of_mem hx)
  have hC : S.Cmax j ≤ S.Cmax (j + 1) := by
    refine foldr_max_le_iff_D4.2 ⟨le_foldr_max_init_D4 _ _, fun z hz => ?_⟩
    obtain ⟨x, hx, rfl⟩ := List.mem_map.1 hz
    exact le_foldr_max_mem_D4 (List.mem_map_of_mem ((mem_fittedRoles_succ_D4 S).2 (Or.inl hx)))
  refine ⟨hfit, foldr_max_lt_iff_D4.2 ⟨(le_foldr_max_init_D4 _ _).trans_lt h1, fun z hz => ?_⟩,
    foldr_max_le_iff_D4.2 ⟨le_foldr_max_init_D4 _ _, fun z hz => ?_⟩⟩
  · obtain ⟨x, hx, rfl⟩ := List.mem_map.1 hz
    rcases (mem_fittedRoles_succ_D4 S).1 hx with hx | hx
    · exact (hold x hx).trans_lt h1
    · exact hlt x hx
  · obtain ⟨x, hx, rfl⟩ := List.mem_map.1 hz
    rcases (mem_fittedRoles_succ_D4 S).1 hx with hx | hx
    · exact ((hold x hx).trans h2).trans hC
    · exact hle x hx

/-- L8.5b: (17) holds initially: `L_0 = C_0 = ρ < u_0` (txt:1220-1221). -/
theorem scan_init {P : Prims.{u}} (S : ScanSetup.{u}) (hS : SetupClauses P S)
    (β : Role → Ordinal.{u}) : ScanInv P S 0 0 β := by
  have hsd := hS.1.2.2.2.1
  have hf0 : S.fittedRoles 0 = [] := by simp [ScanSetup.fittedRoles]
  refine ⟨fun a ha => ?_, ?_, ?_⟩
  · rw [hf0, List.append_nil] at ha
    obtain ⟨haq, hav⟩ := List.mem_filter.1 ha
    refine (BaseAtom.holds_congr P a _ _ fun x hx => ?_).1 (hS.2.2.2.1 a haq)
    have hx' : x ∈ S.preStop ++ [.ord S.sd.col] := by
      simpa using List.all_eq_true.1 hav x hx
    have hnq : x ∉ S.queryRoles := not_query_D4 hsd (by simpa using hx')
    simp [setupPosVal, ScanSetup.fitVal, hnq]
  · rw [ScanSetup.Lmax, hf0, List.map_nil, List.foldr_nil, ← setupBankVal_root_D4 S,
      ← setupBankVal_slot_D4 S hS (Nat.zero_le _)]
    exact bank_root_lt_D4 S hS (slot_root_mem_D4 S hS (Nat.zero_le _)) (by simp [Role.inEntry])
      (Nat.zero_le _)
  · simp [ScanSetup.Lmax, ScanSetup.Cmax, hf0]

/-- L8.5c: `x_i < y_j`: advance the source cursor (txt:1222-1224). -/
theorem scan_lt {P : Prims.{u}} (S : ScanSetup.{u}) (hS : SetupClauses P S) {i j : Nat}
    {β : Role → Ordinal.{u}} (hinv : ScanInv P S i j β) (hi : i < S.rd.cursor) :
    ScanInv P S (i + 1) j β := by
  refine ⟨hinv.1, hinv.2.1.trans ?_, hinv.2.2⟩
  rw [← setupBankVal_slot_D4 S hS hi.le, ← setupBankVal_slot_D4 S hS hi]
  exact bank_entry_lt_D4 S hS (slot_root_mem_D4 S hS hi.le) (by simp [Role.inEntry])
    (slot_root_mem_D4 S hS hi) (by simp [Role.inEntry]) (Nat.lt_succ_self i) hi

/-- L8.5d: both target heads at `u_i` from the positive heads at `h`: restriction if `h ≥ u_i`,
extension through (19) and intermediate elementarity if `h < u_i ≤ c_0` (txt:1228-1231). -/
theorem heads_at_owner (I : Interface.{u}) (S : ScanSetup.{u}) (hS : SetupClauses I.toPrims S)
    {i j : Nat} (hj : j < S.sd.Q.length) (hi : i ≤ S.rd.cursor) (β : Role → Ordinal.{u})
    (hc0 : S.ownerVal i ≤ queryBlockMax S j) (hL : S.Lmax j β < S.ownerVal i) :
    S.HeadsAt I.toPrims j i β := by
  have hsd := hS.1.2.2.2.1
  have hL' := hS.1.2.1
  obtain ⟨p, o, v, hp, hov, -, -, heo, hev⟩ := query_heads_D4 hS hj β
  have hlim : IsLim (S.ownerVal i) := by
    have := bank_lim_D4 hS (slot_mem_bank_D4 S hS hi)
    rwa [setupBankVal_slot_D4 S hS hi] at this
  have hρ : S.asg S.stopNm < S.ownerVal i := (le_foldr_max_init_D4 _ _).trans_lt hL
  suffices H : ∀ w, I.Edge (queryOwnerVal S j) (S.asg S.stopNm) w →
      I.Edge (S.ownerVal i) (S.asg S.stopNm) w from ⟨p, o, v, hp, hov, H _ heo, H _ hev⟩
  intro w hw
  by_cases hle : S.ownerVal i ≤ queryOwnerVal S j
  · exact I.edge_restrict hw hlim hρ hle
  · push Not at hle
    obtain ⟨_, Jh, _, hent, he⟩ := query_entry_D4 hsd hj
    have hsq : Role.slot ⟨S.sd.col, j⟩ ∈ S.queryRoles :=
      (mem_queryRoles_iff_D4 hsd).2 ⟨slot_mem_roles he, j, hj, by simp [Role.inEntry]⟩
    obtain ⟨z, hz, hzc⟩ := queryBlockMax_attained_D4 hsd hj
    obtain ⟨hzq, hzin⟩ := List.mem_filter.1 hz
    have hzr := ((mem_queryRoles_iff_D4 hsd).1 hzq).1
    have hlh : IsLim (setupPosVal S (.slot ⟨S.sd.col, j⟩)) := by
      simpa [setupPosVal, ScanSetup.fitVal, hsq, queryOwnerVal] using (I.edge_lim hw).2.2
    have hel := owner_path_elem I hL'.1 hL'.2.1 he (localStruct_query_D4 hL' hsd hj)
      hS.2.2.2.1 hlh hzr hzin
    have hel' : I.Elem (queryOwnerVal S j) (queryBlockMax S j) := by
      simpa [setupPosVal, ScanSetup.fitVal, hsq, hzq, queryOwnerVal, hzc] using hel
    exact I.edge_extend hw (I.elem_mid hel' hle.le hc0 hlim)

/-- L8.5e: `x_i > y_j`: reuse the positive block below `u_i`, or call `S_{N(J_j)}` on the scan
packet (txt:1227-1234). -/
theorem scan_gt (I : Interface.{u}) {n : Nat} (hSn : ∀ m < n, SStrict I.toPrims m)
    (S : ScanSetup.{u}) (hS : S.Valid I.toPrims) (hQ : ∀ J ∈ S.sd.Q, J.2.size < n)
    {i j : Nat} {β : Role → Ordinal.{u}} (hinv : ScanInv I.toPrims S i j β)
    (hgt : Scan.ReachesGT (Scan.rootKeys S.H S.rd) (Scan.queryKeys S.sd) i j)
    (hi : i ≤ S.rd.cursor) : ∃ β', ScanInv I.toPrims S i (j + 1) β' := by
  have hS' := (valid_iff S).1 hS
  have hsd := hS'.1.2.2.2.1
  have hj : j < S.sd.Q.length := by
    obtain ⟨-, x, y, -, hy, -⟩ := hgt
    have := (List.getElem?_eq_some_iff.1 hy).1
    simpa [Scan.queryKeys] using this
  obtain ⟨hfit, h17a, h17b⟩ := hinv
  have hcb : ∀ y ∈ S.entryRoles j, S.asg (S.qNm y) ≤ queryBlockMax S j := fun y hy =>
    le_foldr_max_mem_D4 (List.mem_map_of_mem (f := fun x => S.asg (S.qNm x)) hy)
  by_cases hc : queryBlockMax S j < S.ownerVal i
  · -- reuse the positive block below `u_i`
    obtain ⟨hhold, hfr, hnew⟩ := posCand_spec_D4 hS' hj β
    obtain ⟨β', hfit', hagree, hent⟩ := fit_of_block S hS hj hfit (L := S.Lmax j β) le_rfl
      (βb := posCand_D4 S j β) hfr (fun w hw hn => by
        obtain ⟨-, hm, hv⟩ := hnew w hw hn
        rw [hv]
        exact h17b.trans_lt (Cmax_lt_entry_D4 hS' hm)) hhold
    refine ⟨β', inv_step_D4 S hfit' hagree h17a h17b (fun x hx => ?_) (fun x hx => ?_)⟩
    · obtain ⟨w, hw, hn, hx'⟩ := hent x hx
      obtain ⟨-, hm, hv⟩ := hnew w hw hn
      rw [hx', hv]
      exact (hcb _ hm).trans_lt hc
    · obtain ⟨w, hw, hn, hx'⟩ := hent x hx
      obtain ⟨-, hm, hv⟩ := hnew w hw hn
      rw [hx', hv]
      exact (hcb _ hm).trans (queryBlockMax_le_Cmax_D4 S j)
  · -- call `S_{N(J_j)}` on the scan packet
    push Not at hc
    have hheads := heads_at_owner I S hS' hj hi β hc h17a
    obtain ⟨pk, hrk, hadm, hv, hown, hcont⟩ := scan_packet S hS hgt hfit h17a h17b hheads
    have hsz : pk.rk.tgtHeight.size < n := by
      rw [hrk, scanRecord_tgtHeight S hS hj]
      obtain ⟨p, Jh, hq, -⟩ := query_entry_D4 hsd hj
      simpa [hq] using hQ _ (List.mem_of_getElem? hq)
    have hTA := hSn _ hsz pk hadm hv rfl (S.Lmax j β) (by rw [hown]; exact h17a)
    obtain ⟨β', hfit', hagree, hent⟩ := hcont _ le_rfl hTA
    exact ⟨β', inv_step_D4 S hfit' hagree h17a h17b (fun x hx => (hent x hx).2)
      (fun x hx => ((hent x hx).2.le.trans hc).trans (queryBlockMax_le_Cmax_D4 S j))⟩

/-! ### L8.5f helpers (D4): the bank candidate -/

/-- L8.5 (helper): the root column has a first entry. -/
theorem root_col_cons_D4 {P : Prims.{u}} {S : ScanSetup.{u}} (hS : SetupClauses P S) :
    ∃ colR, S.H.colAt S.rd.col = some colR ∧ S.rd.cursor < colR.length ∧
      ∃ x col, colR = x :: col := by
  obtain ⟨colR, hcolR, hcur, -⟩ := bank_pairwise_D4 S hS
  refine ⟨colR, hcolR, hcur, ?_⟩
  cases colR with
  | nil => simp at hcur
  | cons x col => exact ⟨x, col, rfl⟩

/-- L8.5 (helper): the representatives seen from the root column are pre-root roles. -/
theorem rep_preRoot_D4 {P : Prims.{u}} {S : ScanSetup.{u}} (hS : SetupClauses P S) {q : Nat}
    {o v : Role} (hr : S.rd.col.rep 0 q = some (o, v)) :
    o ∈ setupPreRoot S ∧ v ∈ setupPreRoot S := by
  obtain ⟨colR, hcolR, -, x, col, rfl⟩ := root_col_cons_D4 hS
  exact rep_before_D4 hcolR hr

/-- L8.5 (helper): pre-root roles are not bank roles. -/
theorem preRoot_not_bank_D4 {P : Prims.{u}} {S : ScanSetup.{u}} (hS : SetupClauses P S) {x : Role}
    (hx : x ∈ setupPreRoot S) : x ∉ setupBank S := by
  have hsd := hS.1.2.2.2.1
  have hrd := hS.1.2.2.2.2.1
  obtain ⟨colR, post, hcolR, hr⟩ := root_roles_D4 hsd hrd
  obtain ⟨colR', hcolR', hcur, -⟩ := bank_pairwise_D4 S hS
  rw [hcolR] at hcolR'
  cases hcolR'
  intro hb
  obtain ⟨hxr, i', hi', hin⟩ := (mem_bank_iff_D4 S).1 hb
  have hm := mem_rolesCol_of_inEntry_D4 hcolR (by omega) hxr hin
  have hnd := Tree.roles_nodup S.H
  rw [hr, List.nodup_append] at hnd
  exact hnd.2.2 _ hx _ (List.mem_cons_of_mem _ (List.mem_append_left _ hm)) rfl

/-- L8.5 (helper): on pre-root roles the bank values are the transported values. -/
theorem bankVal_preRoot_D4 {P : Prims.{u}} {S : ScanSetup.{u}} (hS : SetupClauses P S) {x : Role}
    (hx : x ∈ setupPreRoot S) : setupBankVal S x = S.baseVal x := by
  have hb := preRoot_not_bank_D4 hS hx
  have hR : x ≠ .ord S.rd.col := ne_of_mem_rolesBefore_D4 hx
  simp [setupBankVal, hb, hR]

/-- L8.5 (helper): transported values of pre-stop roles are below `ρ` (S2). -/
theorem baseVal_preStop_lt_D4 {P : Prims.{u}} {S : ScanSetup.{u}} (hS : SetupClauses P S)
    {x : Role} (hx : x ∈ S.preStop) : S.baseVal x < S.asg S.stopNm := by
  have hL := hS.1.2.1
  have hsd := hS.1.2.2.2.1
  obtain ⟨T', hT', -, horig⟩ := Closure.anchorOrigin_prefix (E := S.E) (cap := S.cap) hL hsd
  obtain ⟨y, hy, hyE, -⟩ := horig x hx
  have hxT : x ≠ .ord S.sd.col := ne_of_mem_rolesBefore_D4 hx
  have hyP : y ∈ setupEPrefix S := by simp [setupEPrefix, ePrefix, hT', hyE]
  simpa [ScanSetup.baseVal, hxT, hy] using hS.2.1.2.2 y hyP

/-- L8.5 (helper): the root entry `i ≤ c` whose key is `K`. -/
theorem root_entry_D4 {P : Prims.{u}} {S : ScanSetup.{u}} (hS : SetupClauses P S) {i : Nat}
    {K : Key} (hx : (Scan.rootKeys S.H S.rd)[i]? = some K) :
    ∃ pR Rh, S.H.entryAt ⟨S.rd.col, i⟩ = some (pR, Rh) ∧
      (⟨S.rd.col, i⟩ : EntryAddr) ∈ S.H.entryAddrs ∧ K = relKey (S.rd.col.num 0) Rh := by
  obtain ⟨colR, hcolR, -⟩ := root_col_cons_D4 hS
  simp only [Scan.rootKeys, hcolR, Option.getD_some, List.getElem?_map] at hx
  obtain ⟨⟨pR, Rh⟩, hxR, hK⟩ := Option.map_eq_some_iff.1 hx
  have hent : S.H.entryAt ⟨S.rd.col, i⟩ = some (pR, Rh) := by simp [Tree.entryAt, hcolR, hxR]
  exact ⟨pR, Rh, hent, (Tree.mem_entryAddrs_iff _ _).2 (by rw [hent]; rfl), hK.symm⟩

/-- L8.5 (helper, L8.2c): the structural atoms touching bank entry `i ≤ c` lie in the bank
graph. -/
theorem localStruct_bank_D4 {P : Prims.{u}} {S : ScanSetup.{u}} (hS : SetupClauses P S) {i : Nat}
    (hi : i ≤ S.rd.cursor) (he : (⟨S.rd.col, i⟩ : EntryAddr) ∈ S.H.entryAddrs) :
    ∀ a ∈ localStruct S.H ⟨S.rd.col, i⟩, a ∈ setupBankGraph S := by
  intro a ha
  have hvars := localStruct_vars hS.1.2.1.1 he a ha
  obtain ⟨hg, hs⟩ := List.mem_filter.1 ha
  simp only [Bool.and_eq_true, List.any_eq_true] at hs
  obtain ⟨-, w, hw, hwin⟩ := hs
  have hb : ∀ v ∈ a.vars, v.inEntry ⟨S.rd.col, i⟩ = true → v ∈ setupBank S := fun v hv hin =>
    (mem_bank_iff_D4 S).2 ⟨graph_vars_roles_D4 hg v hv, i, hi, hin⟩
  refine List.mem_filter.2 ⟨List.mem_filter.2 ⟨hg, List.all_eq_true.2 fun v hv => ?_⟩, ?_⟩
  · simp only [List.mem_append, List.mem_singleton, decide_eq_true_eq]
    rcases hvars v hv with hin | rfl | ⟨ov, hov, h⟩
    · exact Or.inr (hb v hv hin)
    · exact Or.inl (Or.inr rfl)
    · obtain ⟨q, -, hq⟩ := List.mem_filterMap.1 hov
      have := rep_preRoot_D4 hS hq
      rcases h with rfl | rfl
      · exact Or.inl (Or.inl this.1)
      · exact Or.inl (Or.inl this.2)
  · exact List.any_eq_true.2 ⟨w, hw, by simp [hb w hw hwin]⟩

/-- L8.5 (helper): the bank candidate of root entry `i`: the fitted frame of query entry `j`, and
the bank values (S5) on the new variables. -/
noncomputable def bankCand_D4 (S : ScanSetup.{u}) (i j : Nat) (β : Role → Ordinal.{u})
    (w : BlkVar) : Ordinal.{u} :=
  match (frameOf ⟨S.sd.col, j⟩).toFr w with
  | some x => S.fitVal β x
  | none => setupBankVal S (blockMap ⟨S.rd.col, i⟩ w)

/-- L8.5 (helper): the new variables of the free block of query entry `j`'s key are the owner and
the internal roles (the fitted frame is complete, R10). -/
theorem freeBlock_new_D4 {P : Prims.{u}} {S : ScanSetup.{u}} (hS : SetupClauses P S) {j : Nat}
    (hj : j < S.sd.Q.length) {w : BlkVar}
    (hw : w ∈ baseVars (posBlock (queryKey S j) (querySel S j)))
    (hn : (frameOf ⟨S.sd.col, j⟩).toFr w = none) :
    w = .owner ∨ ∃ r ∈ (queryKey S j).roles, w = .inner r := by
  have hsd := hS.1.2.2.2.1
  obtain ⟨p, Jh, hq, hent, he⟩ := query_entry_D4 hsd hj
  obtain ⟨-, -, ht, -⟩ := Scan.stopData_spec hsd
  have hK : queryKey S j = relKey (S.sd.col.num 0) Jh := by
    simp [queryKey, Scan.queryKeys, List.getElem?_map, hq, ht]
  have hselp : querySel S j = p := by simp [querySel, hq]
  have hplt : p < S.sd.col.num 0 :=
    ((ColAddr.resolve_isSome_iff 0 _ p).1 (hS.1.2.1.1 _ he p Jh hent)).2
  have hw' : w ∈ baseVars (posBlock (relKey (S.sd.col.num 0) Jh) (querySel S j)) := by
    rw [← hK]; exact hw
  rcases posBlock_vars _ _ w hw with rfl | rfl | ⟨q, hq' | hq'⟩ | h
  · simp [Frame.toFr] at hn
  · exact Or.inl rfl
  all_goals first
    | exact Or.inr h
    | (exfalso
       have hlt : q < S.sd.col.num 0 := by
         rcases posBlock_ordcur_D4 hw' (by first | exact Or.inl hq' | exact Or.inr hq') with h | h
         · exact h
         · rw [h, hselp]; exact hplt
       subst hq'
       have h1 := toFr_isSome_D4 ⟨S.sd.col, j⟩ hlt
       rw [hn] at h1; simp at h1)

/-- L8.5 (helper): the bank candidate realizes the free block of the common key `K` (D7.1a, S5,
R3, R10): its frame fields below `r` are the root's own representatives. -/
theorem bankCand_spec_D4 {P : Prims.{u}} {S : ScanSetup.{u}} (hS : SetupClauses P S) {i j : Nat}
    (hi : i ≤ S.rd.cursor) {K : Key}
    (hKR : (Scan.rootKeys S.H S.rd)[i]? = some K) (β : Role → Ordinal.{u}) :
    BaseHolds P (freeBlock K) (bankCand_D4 S i j β) ∧
    (∀ w x, (frameOf ⟨S.sd.col, j⟩).toFr w = some x → bankCand_D4 S i j β w = S.fitVal β x) ∧
    (∀ r ∈ K.roles, Role.under (EntryAddr.heightPath ⟨S.rd.col, i⟩) r ∈ S.H.roles ∧
      (Role.under (EntryAddr.heightPath ⟨S.rd.col, i⟩) r).inEntry ⟨S.rd.col, i⟩ = true) := by
  have hsd := hS.1.2.2.2.1
  have hrd := hS.1.2.2.2.2.1
  have hV := hS.1.2.1.1
  obtain ⟨pR, Rh, hent, he, hK⟩ := root_entry_D4 hS hKR
  have hhgt : S.H.heightAt ⟨S.rd.col, i⟩ = some Rh := by simp [Tree.heightAt, hent]
  have hKr : K.roles = Rh.roles := by rw [hK, relKey_roles]
  obtain ⟨hres, hnum, -⟩ := Scan.rootData_col hsd hrd
  have hvis := rep_visible S.sd.col S.rd.col (by rw [hnum]; exact hres)
  have hplt : pR < S.rd.col.num 0 :=
    ((ColAddr.resolve_isSome_iff 0 _ pR).1 (hV _ he pR Rh hent)).2
  have hinner : ∀ r ∈ K.roles, Role.under (EntryAddr.heightPath ⟨S.rd.col, i⟩) r ∈ S.H.roles ∧
      (Role.under (EntryAddr.heightPath ⟨S.rd.col, i⟩) r).inEntry ⟨S.rd.col, i⟩ = true :=
    fun r hr => under_mem_D4 he hhgt (hKr ▸ hr)
  have hsb := slot_mem_bank_D4 S hS hi
  have hK' : K = relKey (S.rd.col.num 0) ((S.H.heightAt ⟨S.rd.col, i⟩).getD Tree.empty) := by
    rw [hhgt]; exact hK
  -- every variable of the free block reads `R`, a pre-root role or a bank role
  have himg : ∀ w ∈ baseVars (freeBlock K),
      blockMap ⟨S.rd.col, i⟩ w ∈ setupPreRoot S ∨ blockMap ⟨S.rd.col, i⟩ w = .ord S.rd.col ∨
        blockMap ⟨S.rd.col, i⟩ w ∈ setupBank S := by
    intro w hw
    have hw' : w ∈ baseVars (posBlock K pR) := by
      simp only [posBlock, baseVars, List.flatMap_append, List.mem_append]; exact Or.inl hw
    rcases posBlock_vars _ _ w hw' with rfl | rfl | ⟨q, rfl | rfl⟩ | ⟨r, hr, rfl⟩
    · exact Or.inr (Or.inl rfl)
    · exact Or.inr (Or.inr hsb)
    · simp only [blockMap]
      cases hr : S.rd.col.rep 0 q with
      | none => exact Or.inr (Or.inl rfl)
      | some ov => exact Or.inl (rep_preRoot_D4 hS hr).1
    · simp only [blockMap]
      cases hr : S.rd.col.rep 0 q with
      | none => exact Or.inr (Or.inl rfl)
      | some ov => exact Or.inl (rep_preRoot_D4 hS hr).2
    · obtain ⟨h1, h2⟩ := hinner r hr
      exact Or.inr (Or.inr ((mem_bank_iff_D4 S).2 ⟨h1, i, hi, h2⟩))
  refine ⟨fun a ha => ?_, fun w x hx => by simp [bankCand_D4, hx], hinner⟩
  have ha' : a ∈ posBlock K pR := List.mem_append_left _ ha
  have hg := posBlock_heads_graph he hV a (by rw [← hK']; simpa [hent] using ha')
  have hbg : a.map (blockMap ⟨S.rd.col, i⟩) ∈ setupBankGraph S := by
    refine List.mem_filter.2 ⟨List.mem_filter.2 ⟨hg, List.all_eq_true.2 fun v hv => ?_⟩, ?_⟩
    · rw [baseAtom_vars_map] at hv
      obtain ⟨w, hw, rfl⟩ := List.mem_map.1 hv
      have := himg w (List.mem_flatMap.2 ⟨a, ha, hw⟩)
      simp only [List.mem_append, List.mem_singleton, decide_eq_true_eq]
      tauto
    · obtain ⟨w, hw, hw'⟩ := posBlock_has_new_D4 _ _ a ha'
      rw [baseAtom_vars_map]
      refine List.any_eq_true.2 ⟨blockMap ⟨S.rd.col, i⟩ w, List.mem_map_of_mem hw, ?_⟩
      simp only [decide_eq_true_eq]
      have hwv : w ∈ baseVars (freeBlock K) := List.mem_flatMap.2 ⟨a, ha, hw⟩
      rcases hw' with rfl | rfl | ⟨r, rfl⟩
      · exact Or.inl rfl
      · exact Or.inr hsb
      · rcases himg _ hwv with h | h | h
        · exfalso
          have hm : BlkVar.inner r ∈ baseVars (posBlock K pR) := by
            simp only [posBlock, baseVars, List.flatMap_append, List.mem_append]; exact Or.inl hwv
          obtain ⟨r', hr', hrr⟩ : ∃ r' ∈ K.roles, BlkVar.inner r = .inner r' := by
            rcases posBlock_vars _ _ _ hm with h | h | ⟨q, h | h⟩ | h
            · cases h
            · cases h
            · cases h
            · cases h
            · exact h
          cases hrr
          obtain ⟨h1, h2⟩ := hinner r hr'
          exact preRoot_not_bank_D4 hS h ((mem_bank_iff_D4 S).2 ⟨h1, i, hi, h2⟩)
        · exact Or.inl h
        · exact Or.inr h
  have h5 := hS.2.2.2.2.1 _ hbg
  rw [baseAtom_holds_map'] at h5
  refine (BaseAtom.holds_congr P a _ _ fun w hw => ?_).1 h5
  have hwv : w ∈ baseVars (freeBlock K) := List.mem_flatMap.2 ⟨a, ha, hw⟩
  cases hx : (frameOf ⟨S.sd.col, j⟩).toFr w with
  | none => simp [bankCand_D4, hx]
  | some x =>
    simp only [Function.comp, bankCand_D4, hx]
    have hw' : w ∈ baseVars (posBlock (relKey (S.rd.col.num 0) Rh) pR) := by
      rw [← hK]
      simp only [posBlock, baseVars, List.flatMap_append, List.mem_append]; exact Or.inl hwv
    cases w with
    | host =>
      cases hx
      rw [show blockMap ⟨S.rd.col, i⟩ .host = .ord S.rd.col from rfl, setupBankVal_root_D4]
      simp [frameOf, ScanSetup.fitVal, not_query_D4 hsd (x := .ord S.sd.col) (Or.inr rfl),
        ScanSetup.baseVal]
    | owner => cases hx
    | inner _ => cases hx
    | ord q =>
      have hq : q < S.rd.col.num 0 := by
        rcases posBlock_ordcur_D4 hw' (Or.inl rfl) with h | h
        · exact h
        · rw [h]; exact hplt
      simp only [Frame.toFr, frameOf, reps0_getElem?] at hx
      obtain ⟨⟨o, v⟩, hov, rfl⟩ := Option.map_eq_some_iff.1 hx
      have hov' : S.rd.col.rep 0 q = some (o, v) := by rw [hvis q hq]; exact hov
      simp only [blockMap, hov', Option.map_some, Option.getD_some]
      have hpre := (rep_preRoot_D4 hS hov').1
      rw [bankVal_preRoot_D4 hS hpre]
      simp [ScanSetup.fitVal, not_query_D4 hsd (Or.inl (preRoot_sub_preStop_D4 hsd hrd hpre))]
    | cur q =>
      have hq : q < S.rd.col.num 0 := by
        rcases posBlock_ordcur_D4 hw' (Or.inr rfl) with h | h
        · exact h
        · rw [h]; exact hplt
      simp only [Frame.toFr, frameOf, reps0_getElem?] at hx
      obtain ⟨⟨o, v⟩, hov, rfl⟩ := Option.map_eq_some_iff.1 hx
      have hov' : S.rd.col.rep 0 q = some (o, v) := by rw [hvis q hq]; exact hov
      simp only [blockMap, hov', Option.map_some, Option.getD_some]
      have hpre := (rep_preRoot_D4 hS hov').2
      rw [bankVal_preRoot_D4 hS hpre]
      simp [ScanSetup.fitVal, not_query_D4 hsd (Or.inl (preRoot_sub_preStop_D4 hsd hrd hpre))]

/-- L8.5f: `x_i = y_j`: the two-candidate fact on the bank block and the positive block
(txt:1235-1241). -/
theorem scan_eq (I : Interface.{u}) (S : ScanSetup.{u}) (hS : S.Valid I.toPrims) {i j : Nat}
    {β : Role → Ordinal.{u}} (hinv : ScanInv I.toPrims S i j β) {x : Key}
    (hx : (Scan.rootKeys S.H S.rd)[i]? = some x) (hy : (Scan.queryKeys S.sd)[j]? = some x)
    (hi : i < S.rd.cursor) : ∃ β', ScanInv I.toPrims S (i + 1) (j + 1) β' := by
  sorry

/-- L8.5g: the invariant along the whole actual trace (txt:1242-1244). -/
theorem scan_trace (I : Interface.{u}) {n : Nat} (hSn : ∀ m < n, SStrict I.toPrims m)
    (S : ScanSetup.{u}) (hS : S.Valid I.toPrims) (hQ : ∀ J ∈ S.sd.Q, J.2.size < n) :
    ∀ s ∈ Scan.trace (Scan.rootKeys S.H S.rd) (Scan.queryKeys S.sd),
      ∃ β, ScanInv I.toPrims S s.1 s.2 β := by
  have hS' := (valid_iff S).1 hS
  obtain ⟨-, -, -, hsd, hrd, -, -⟩ := hS'.1
  have hcur : S.rd.cursor = Scan.cursor (Scan.rootKeys S.H S.rd) (Scan.queryKeys S.sd) :=
    (Scan.rootData_spec hsd hrd).2.2.2.2.2.2.1
  obtain ⟨hhead, hstep, hbound, -⟩ := Scan.trace_spec (Scan.rootKeys S.H S.rd) (Scan.queryKeys S.sd)
  rw [← hcur] at hbound
  have key : ∀ (k : Nat) (s : Nat × Nat),
      (Scan.trace (Scan.rootKeys S.H S.rd) (Scan.queryKeys S.sd))[k]? = some s →
      ∃ β, ScanInv I.toPrims S s.1 s.2 β := by
    intro k
    induction k with
    | zero =>
      intro s hs
      rw [← List.head?_eq_getElem?, hhead, Option.some.injEq] at hs
      subst hs
      exact ⟨fun _ => 0, scan_init S hS' _⟩
    | succ k ih =>
      intro s' hs'
      obtain ⟨s, hs⟩ : ∃ s, (Scan.trace (Scan.rootKeys S.H S.rd) (Scan.queryKeys S.sd))[k]? =
          some s := by
        have hlt := (List.getElem?_eq_some_iff.1 hs').1
        exact ⟨_, List.getElem?_eq_getElem (by omega)⟩
      obtain ⟨β, hinv⟩ := ih s hs
      have hmem : s ∈ Scan.trace (Scan.rootKeys S.H S.rd) (Scan.queryKeys S.sd) :=
        List.mem_of_getElem? hs
      have hmem' : s' ∈ Scan.trace (Scan.rootKeys S.H S.rd) (Scan.queryKeys S.sd) :=
        List.mem_of_getElem? hs'
      obtain ⟨x, y, hx, hy, hcase⟩ := hstep k s s' hs hs'
      rcases hcase with ⟨hxy, rfl⟩ | ⟨rfl, rfl⟩ | ⟨hxy, rfl⟩
      · exact ⟨β, scan_lt S hS' hinv (by have := (hbound _ hmem').1; simp at this; omega)⟩
      · exact scan_eq I S hS hinv hx hy (by have := (hbound _ hmem').1; simp at this; omega)
      · exact scan_gt I hSn S hS hQ hinv ⟨hmem, x, y, hx, hy, hxy⟩ (hbound _ hmem).1
  intro s hs
  obtain ⟨k, hk⟩ := List.mem_iff_getElem?.1 hs
  exact key k s hk

/-- L8.5 (helper): every query role lies in a query entry, so the full fitting is the query. -/
theorem fittedRoles_all_D4 {S : ScanSetup.{u}} (hsd : Scan.stopData S.H = some S.sd) :
    S.fittedRoles S.sd.Q.length = S.queryRoles := by
  refine List.filter_eq_self.2 fun x hx => ?_
  obtain ⟨-, j, hj, hin⟩ := (mem_queryRoles_iff_D4 hsd).1 hx
  simp only [List.any_eq_true, List.mem_range]
  exact ⟨j, hj, hin⟩

/-- L8.5, `S_{<n} ⇒ W_{<n}` (txt:1216-1248). -/
theorem wFit_of_sStrict (I : Interface.{u}) (n : Nat) (h : ∀ m < n, SStrict I.toPrims m) :
    WFit I.toPrims n := by
  intro S hS hQ
  have hS' := (valid_iff S).1 hS
  obtain ⟨-, -, -, hsd, hrd, hlen, -⟩ := hS'.1
  have hcur : S.rd.cursor = Scan.cursor (Scan.rootKeys S.H S.rd) (Scan.queryKeys S.sd) :=
    (Scan.rootData_spec hsd hrd).2.2.2.2.2.2.1
  obtain ⟨-, -, -, jl, hlast, hjl⟩ :=
    Scan.trace_spec (Scan.rootKeys S.H S.rd) (Scan.queryKeys S.sd)
  rw [← hcur] at hlast hjl
  have hjQ : jl = S.sd.Q.length := by
    have := hjl (by simpa [Scan.rootKeys] using hlen)
    simpa [Scan.queryKeys] using this
  subst hjQ
  obtain ⟨β, hfit, h17a, -⟩ := scan_trace I h S hS hQ _ (List.mem_of_getLast? hlast)
  refine ⟨β, ?_, fun x hx => ?_⟩
  · have hsub : restrictTo S.queryGraph (S.preStop ++ [.ord S.sd.col] ++
        S.fittedRoles S.sd.Q.length) = S.queryGraph := by
      rw [fittedRoles_all_D4 hsd]
      exact List.filter_eq_self.2 fun a ha => (List.mem_filter.1 (List.mem_filter.1 ha).1).2
    have := hfit
    rw [ScanSetup.Fitted, hsub] at this
    exact this
  · have hx' : x ∈ S.fittedRoles S.sd.Q.length := by rw [fittedRoles_all_D4 hsd]; exact hx
    exact (le_foldr_max_mem_D4 (List.mem_map_of_mem hx')).trans_lt h17a

/-! ## §8.3: `W_{<n} ⇒ D_{<n}` -/

/-- L8.6a: the hypotheses of `DLab` for one anchored input and one label, bundled. -/
structure DLabHyps (P : Prims.{u}) (n : Nat) (E : Forest) (cap : Option (Closure.AdmCap E))
    (α : Role → Ordinal.{u}) (sd : Scan.StopData) (rd : Scan.RootData) (V : Type)
    (Λ : Diagram V) (ν eν : Role → V) (b : V → Ordinal.{u}) (Fix : V → Prop) : Prop where
  inL : Scan.InL (Closure.anchor E cap)
  ordinary : Scan.stepKind (Closure.anchor E cap) = some .ordinary
  stop : Scan.stopData (Closure.anchor E cap) = some sd
  root : Scan.rootData (Closure.anchor E cap) = some rd
  config : IsConfig P (Closure.anchor E cap) α
  query : sd.Q = [] ∨ (IsStd E ∧ ∀ J ∈ sd.Q, J.2.size < n)
  bind : ∀ x ∈ rolesBefore (Closure.anchor E cap) (.ord sd.col), b (ν x) = α x
  origin : ∀ x ∈ rolesBefore (Closure.anchor E cap) (.ord sd.col), ∀ y,
    Closure.anchorOrigin E cap x = some y → eν y = ν x
  pre : ∀ T' a, Closure.anchorOrigin E cap (.ord sd.col) = some T' →
    a ∈ restrictTo (graph E) (rolesBefore E T') → Atom.base (a.map eν) ∈ Λ
  holds : Λ.Holds P b
  below : ∀ v ∈ Λ.vars, b v < α (.ord sd.col)
  fixBelow : ∀ v ∈ Λ.vars, Fix v → b v < α (.ord rd.col)

/-- L8.6a: unfolding `DLab` into its bundled hypotheses. -/
theorem dLab_iff (P : Prims.{u}) (n : Nat) :
    DLab P n ↔ ∀ (E : Forest) (cap : Option (Closure.AdmCap E)) (α : Role → Ordinal.{u})
      (sd : Scan.StopData) (rd : Scan.RootData) (V : Type) (Λ : Diagram V) (ν eν : Role → V)
      (b : V → Ordinal.{u}) (Fix : V → Prop), DLabHyps P n E cap α sd rd V Λ ν eν b Fix →
      ∀ (k : Nat) (H' : Forest), expand (Closure.anchor E cap) k = some H' →
        ∃ (γ : Role → Ordinal.{u}) (b' : V → Ordinal.{u}),
          IsConfig P H' γ ∧ (∀ x ∈ H'.roles, γ x < α (.ord sd.col)) ∧
          (∀ v, Fix v → b' v = b v) ∧
          (∀ x ∈ rolesBefore (Closure.anchor E cap) (.ord sd.col),
            b' (ν x) = γ (iota (Closure.anchor E cap) k x)) ∧
          Λ.Holds P b' ∧ (∀ v ∈ Λ.vars, b' v < α (.ord sd.col)) ∧
          (∀ x ∈ rolesBefore (Closure.anchor E cap) (.ord rd.col), γ x = α x) ∧
          (0 < k → ∀ x ∈ rolesBefore (Closure.anchor E cap) (.ord sd.col),
            x ∉ rolesBefore (Closure.anchor E cap) (.ord rd.col) → ¬ Fix (ν x) →
              γ x < α (.ord rd.col)) := by
  sorry

/-- L8.6a: the role sets of an ordinary input are those of its branch data. -/
theorem roleSets_eq {H : Forest} {sd : Scan.StopData} {rd : Scan.RootData}
    (hsd : Scan.stopData H = some sd) (hrd : Scan.rootData H = some rd) :
    ∃ rs, roleSets H = some rs ∧ rs.T = .ord sd.col ∧ rs.R = .ord rd.col ∧
      rs.N = .slot (Scan.closingSlot sd) ∧ rs.P = rolesBefore H (.ord sd.col) ∧
      rs.D = rolesBefore H (.ord rd.col) ++ [.ord rd.col] ++ rs.K := by
  sorry

/-- L8.6a: labels read every pre-stop role (via the `lim` atoms of the `E`-prefix graph), so the
`Fix` bound applies to all of them; hence a fixed label variable reads only pre-root roles. -/
theorem nu_mem_vars {P : Prims.{u}} {n : Nat} {E : Forest} {cap : Option (Closure.AdmCap E)}
    {α : Role → Ordinal.{u}} {sd : Scan.StopData} {rd : Scan.RootData} {V : Type}
    {Λ : Diagram V} {ν eν : Role → V} {b : V → Ordinal.{u}} {Fix : V → Prop}
    (hyp : DLabHyps P n E cap α sd rd V Λ ν eν b Fix) :
    ∀ x ∈ rolesBefore (Closure.anchor E cap) (.ord sd.col), ν x ∈ Λ.vars := by
  sorry

/-- L8.6b, (20): the final control edge `R(C, W, p)` with `p < W < C` (txt:1253-1254). -/
theorem control_edge (I : Interface.{u}) {H : Forest} {α : Role → Ordinal.{u}}
    {sd : Scan.StopData} {rd : Scan.RootData} (hV : Scan.CondV H)
    (hsd : Scan.stopData H = some sd) (hrd : Scan.rootData H = some rd)
    (hα : IsConfig I.toPrims H α) :
    I.Edge (α (.slot (Scan.closingSlot sd))) (α (.ord sd.col)) (α (.ord rd.col)) ∧
      α (.ord rd.col) < α (.ord sd.col) ∧ α (.ord sd.col) < α (.slot (Scan.closingSlot sd)) := by
  sorry

/-- L8.6c: the first retained role `v` of `K` is absent, on the route (ordinary or active
owner), or the closed root owner at the final cursor (txt:1288-1297). -/
theorem firstK_cases {H : Forest} (hL : Scan.InL H) (hk : Scan.stepKind H = some .ordinary)
    {sd : Scan.StopData} {rd : Scan.RootData} (hsd : Scan.stopData H = some sd)
    (hrd : Scan.rootData H = some rd) {rs : RoleSets} (hrs : roleSets H = some rs) :
    rs.K = [] ∨ (∃ v rest, rs.K = v :: rest ∧ OnRoute sd v) ∨
      (∃ rest, rs.K = .slot ⟨rd.col, rd.cursor⟩ :: rest ∧
        rd.cursor < ((H.colAt rd.col).getD []).length ∧
        rd.col.container sd.col ≠ some ⟨rd.col, rd.cursor⟩) := by
  sorry

/-- L8.6d: variables of the transported stage problem: main roles of `H[m]`, label variables,
fresh reference names of the `E`-prefix, the original positive query, the head `t`. -/
inductive SVar (V : Type) where
  | main (x : Role)
  | lab (v : V)
  | ref (y : Role)
  | qry (x : Role)
  | top

/-- L8.6d: the reference chart of the whole `E`-prefix at stage `m`: shared with the latest
main copy `f_m` on `χ(D)`, fresh elsewhere (consumed and deleted blocks; txt:1268-1270). -/
def refVar {V : Type} (E : Forest) (cap : Option (Closure.AdmCap E)) (H : Forest)
    (rs : RoleSets) (m : Nat) (y : Role) : SVar V :=
  match rs.D.find? (fun x => Closure.anchorOrigin E cap x == some y) with
  | some x => .main (fMap H m m x)
  | none => .ref y

/-- L8.6d: how the original positive query reads its context: `T ↦ t`, `Q ↦` query variables,
the rest of `P` through the reference chart (`P⁻ ↦ ePre ∘ χ`, as in a scan setup). -/
def qryVar {V : Type} (E : Forest) (cap : Option (Closure.AdmCap E)) (H : Forest)
    (rs : RoleSets) (m : Nat) (x : Role) : SVar V :=
  if x = rs.T then .top else if x ∈ rs.Q then .qry x else
    match Closure.anchorOrigin E cap x with
    | some y => refVar E cap H rs m y
    | none => .top

/-- L8.6d: the transported stage problem (txt:1273-1281), ordinal form: the main graph `G_m`,
the label, the reference `E`-prefix graph, the original positive query at head `t`, the label
bindings `ν x = x` on `P`, and the budget `x < t` for every old coordinate ((21)). -/
def stageDiagram {V : Type} (E : Forest) (cap : Option (Closure.AdmCap E))
    (sd : Scan.StopData) (rs : RoleSets) (Λ : Diagram V) (ν : Role → V) (m : Nat)
    (G : Forest) : Diagram (SVar V) :=
  let H := Closure.anchor E cap
  Diagram.ofBase ((graph G).map (BaseAtom.map SVar.main)) ++
  Diagram.map SVar.lab Λ ++
  Diagram.ofBase ((restrictTo (graph E) (ePrefix E cap sd)).map
    (BaseAtom.map (refVar E cap H rs m))) ++
  Diagram.ofBase ((queryAtoms H rs).map (BaseAtom.map (qryVar E cap H rs m))) ++
  Diagram.ofBase (rs.P.map fun x => BaseAtom.eq (SVar.lab (ν x)) (SVar.main x)) ++
  Diagram.ofBase (G.roles.map fun x => BaseAtom.lt (SVar.main x) SVar.top) ++
  Diagram.ofBase (Λ.vars.map fun v => BaseAtom.lt (SVar.lab v) SVar.top) ++
  Diagram.ofBase ((ePrefix E cap sd).map fun y => BaseAtom.lt (refVar E cap H rs m y) SVar.top)

/-- L8.6d: fixed variables of the stage problem: pre-root main roles and fixed label variables. -/
def stageFixed {V : Type} (H : Forest) (rs : RoleSets) (Fix : V → Prop) : SVar V → Prop
  | .main x => x ∈ rolesBefore H rs.R
  | .lab v => Fix v
  | _ => False

/-- L8.6d: the stage-`m` values, with head value `t` (`t = α(T)` before transport, `t = α(R)`
after it). -/
noncomputable def stageSigma {V : Type} (α : Role → Ordinal.{u}) (g : Role → Ordinal.{u})
    (b' : V → Ordinal.{u}) (eb : Role → Ordinal.{u}) (t : Ordinal.{u}) :
    SVar V → Ordinal.{u}
  | .main x => g x
  | .lab v => b' v
  | .ref y => eb y
  | .qry x => α x
  | .top => t

/-- L8.6e: the stage invariant of §8.3 (txt:1264-1267), ordinal form. -/
def StageInv (P : Prims.{u}) (H : Forest) (rs : RoleSets) (α : Role → Ordinal.{u}) {V : Type}
    (Λ : Diagram V) (ν : Role → V) (b : V → Ordinal.{u}) (Fix : V → Prop) (m : Nat)
    (G : Forest) (g : Role → Ordinal.{u}) (b' : V → Ordinal.{u}) : Prop :=
  expand H m = some G ∧ IsConfig P G g ∧ (∀ x ∈ G.roles, g x < α rs.T) ∧
    g (fMap H m m rs.R) = α rs.R ∧ (∀ x ∈ rs.K, g (fMap H m m x) = α x) ∧
    (∀ x ∈ rolesBefore H rs.R, g x = α x) ∧
    (∀ v, Fix v → b' v = b v) ∧ (∀ x ∈ rs.P, b' (ν x) = g x) ∧
    Λ.Holds P b' ∧ (∀ v ∈ Λ.vars, b' v < α rs.T) ∧
    (0 < m → ∀ x ∈ rs.P, x ∉ rolesBefore H rs.R → ¬ Fix (ν x) → g x < α rs.R)

/-- L8.6e: stage zero is the restriction to `P` (txt:1267, 1312). -/
theorem stage_zero_inv {P : Prims.{u}} {n : Nat} {E : Forest} {cap : Option (Closure.AdmCap E)}
    {α : Role → Ordinal.{u}} {sd : Scan.StopData} {rd : Scan.RootData} {V : Type}
    {Λ : Diagram V} {ν eν : Role → V} {b : V → Ordinal.{u}} {Fix : V → Prop}
    (hyp : DLabHyps P n E cap α sd rd V Λ ν eν b Fix) {rs : RoleSets}
    (hrs : roleSets (Closure.anchor E cap) = some rs) :
    ∃ G, StageInv P (Closure.anchor E cap) rs α Λ ν b Fix 0 G α b := by
  sorry

/-- L8.6e: the pre-stop roles persist at their addresses in every `H[m]` (`ι_m = id`). -/
theorem persist_prefix {H : Forest} (hL : Scan.InL H) {rs : RoleSets}
    (hrs : roleSets H = some rs) {m : Nat} {G : Forest} (hG : expand H m = some G) :
    rs.P <+: G.roles := by
  sorry

/-- L8.6f: control transport of the whole stage problem from `t = W` to `t = p`, captured into
`J_W` (txt:1281-1287). -/
theorem stage_transport (I : Interface.{u}) {n : Nat} {E : Forest}
    {cap : Option (Closure.AdmCap E)} {α : Role → Ordinal.{u}} {sd : Scan.StopData}
    {rd : Scan.RootData} {V : Type} {Λ : Diagram V} {ν eν : Role → V} {b : V → Ordinal.{u}}
    {Fix : V → Prop} (hyp : DLabHyps I.toPrims n E cap α sd rd V Λ ν eν b Fix)
    {rs : RoleSets} (hrs : roleSets (Closure.anchor E cap) = some rs) {m : Nat} {G : Forest}
    {g : Role → Ordinal.{u}} {b' : V → Ordinal.{u}}
    (hinv : StageInv I.toPrims (Closure.anchor E cap) rs α Λ ν b Fix m G g b') :
    (stageDiagram E cap sd rs Λ ν m G).RealizableBelow I.toPrims
      (fun z => stageFixed (Closure.anchor E cap) rs Fix z ∨ z = SVar.top)
      (stageSigma α g b' (b ∘ eν) (α rs.R)) (α rs.T) := by
  sorry

/-- L8.6g: the scan setup of the closed-root-owner case of stage `m + 1`, built from a
transported realization `a` (txt:1295-1304): transported chart `role 0`, query `role 1`, bank
`role 2` at original values, stop `aux 0` at `a t = p`, no auxiliary diagram. -/
noncomputable def stageSetup {V : Type} (E : Forest) (cap : Option (Closure.AdmCap E))
    (sd : Scan.StopData) (rd : Scan.RootData) (rs : RoleSets) (m : Nat)
    (α : Role → Ordinal.{u}) (a : SVar V → Ordinal.{u}) : ScanSetup.{u} where
  E := E
  cap := cap
  sd := sd
  rd := rd
  ePre := fun y => .role 0 y
  stopNm := .aux 0
  qNm := fun x => .role 1 x
  bankNm := fun x => .role 2 x
  aux := []
  asg := fun nm => match nm with
    | .role 0 y => a (refVar E cap (Closure.anchor E cap) rs m y)
    | .role 1 x => a (.qry x)
    | .role 2 x => α x
    | .aux 0 => a .top
    | _ => 0

/-- L8.6g: the setup is valid when the first retained role is the closed root owner and the
anchor carries the standard/size hypotheses (every hypothesis of §7.3 and `W_{<n}` is present,
txt:1298-1303). -/
theorem stageSetup_clauses (I : Interface.{u}) {n : Nat} {E : Forest}
    {cap : Option (Closure.AdmCap E)} {α : Role → Ordinal.{u}} {sd : Scan.StopData}
    {rd : Scan.RootData} {V : Type} {Λ : Diagram V} {ν eν : Role → V} {b : V → Ordinal.{u}}
    {Fix : V → Prop} (hyp : DLabHyps I.toPrims n E cap α sd rd V Λ ν eν b Fix)
    {rs : RoleSets} (hrs : roleSets (Closure.anchor E cap) = some rs) (hstd : IsStd E)
    (hclosed : rd.cursor < ((((Closure.anchor E cap)).colAt rd.col).getD []).length ∧
      rd.col.container sd.col ≠ some ⟨rd.col, rd.cursor⟩)
    {m : Nat} {G : Forest} {a : SVar V → Ordinal.{u}}
    (ha : (stageDiagram E cap sd rs Λ ν m G).Holds I.toPrims a) (htop : a SVar.top = α rs.R)
    (hbelow : ∀ z ∈ (stageDiagram E cap sd rs Λ ν m G).vars, a z < α rs.T)
    -- [V-fix] added: S5 reads the pre-root chart through `main`, the bank at `α`
    (hfix : ∀ x ∈ rolesBefore (Closure.anchor E cap) rs.R, a (SVar.main x) = α x) :
    SetupClauses I.toPrims (stageSetup E cap sd rd rs m α a) := by
  sorry

/-- L8.6h: fit the transported query before the restored `K` (txt:1288-1304): a realization of
the stage problem with `t = p`, all values below `W`, and all query values below the first
value of `K` (or `W` if `K` is empty). -/
theorem stage_fit (I : Interface.{u}) {n : Nat} (hW : WFit I.toPrims n) {E : Forest}
    {cap : Option (Closure.AdmCap E)} {α : Role → Ordinal.{u}} {sd : Scan.StopData}
    {rd : Scan.RootData} {V : Type} {Λ : Diagram V} {ν eν : Role → V} {b : V → Ordinal.{u}}
    {Fix : V → Prop} (hyp : DLabHyps I.toPrims n E cap α sd rd V Λ ν eν b Fix)
    {rs : RoleSets} (hrs : roleSets (Closure.anchor E cap) = some rs) {m : Nat} {G : Forest}
    {σ : SVar V → Ordinal.{u}}
    (hT : (stageDiagram E cap sd rs Λ ν m G).RealizableBelow I.toPrims
      (fun z => stageFixed (Closure.anchor E cap) rs Fix z ∨ z = SVar.top) σ (α rs.T))
    (htop : σ SVar.top = α rs.R)
    -- [V-fix] added: the fixed values are the stage-zero ones (pre-root `α`, fixed labels `b`)
    (hσ : ∀ z, stageFixed (Closure.anchor E cap) rs Fix z →
      σ z = stageSigma α α b (b ∘ eν) (α rs.R) z) :
    ∃ a : SVar V → Ordinal.{u},
      (∀ z, (stageFixed (Closure.anchor E cap) rs Fix z ∨ z = SVar.top) → a z = σ z) ∧
      (∀ z ∈ (stageDiagram E cap sd rs Λ ν m G).vars, a z < α rs.T) ∧
      (stageDiagram E cap sd rs Λ ν m G).Holds I.toPrims a ∧
      ∀ x ∈ rs.Q, a (.qry x) < (match rs.K with
        | [] => α rs.T
        | v :: _ => α v) := by
  sorry

/-- L8.6i: restore `K` at its original values with the new root `p`; the union is `G_{m+1}` and
the stage invariant holds at `m + 1` (txt:1306-1311). -/
theorem stage_restore (I : Interface.{u}) {n : Nat} {E : Forest}
    {cap : Option (Closure.AdmCap E)} {α : Role → Ordinal.{u}} {sd : Scan.StopData}
    {rd : Scan.RootData} {V : Type} {Λ : Diagram V} {ν eν : Role → V} {b : V → Ordinal.{u}}
    {Fix : V → Prop} (hyp : DLabHyps I.toPrims n E cap α sd rd V Λ ν eν b Fix)
    {rs : RoleSets} (hrs : roleSets (Closure.anchor E cap) = some rs) {m : Nat} {G G' : Forest}
    (hG : expand (Closure.anchor E cap) m = some G)
    (hG' : expand (Closure.anchor E cap) (m + 1) = some G') {a : SVar V → Ordinal.{u}}
    (hfixed : ∀ z, stageFixed (Closure.anchor E cap) rs Fix z →
      a z = stageSigma α α b (b ∘ eν) (α rs.R) z)
    (htop : a SVar.top = α rs.R)
    (hbelow : ∀ z ∈ (stageDiagram E cap sd rs Λ ν m G).vars, a z < α rs.T)
    (hholds : (stageDiagram E cap sd rs Λ ν m G).Holds I.toPrims a)
    (hq : ∀ x ∈ rs.Q, a (.qry x) < (match rs.K with
        | [] => α rs.T
        | v :: _ => α v)) :
    ∃ g' b', StageInv I.toPrims (Closure.anchor E cap) rs α Λ ν b Fix (m + 1) G' g' b' := by
  sorry

/-- L8.6j: one copy stage (transport, fit, restore). -/
theorem stage_step (I : Interface.{u}) {n : Nat} (hW : WFit I.toPrims n) {E : Forest}
    {cap : Option (Closure.AdmCap E)} {α : Role → Ordinal.{u}} {sd : Scan.StopData}
    {rd : Scan.RootData} {V : Type} {Λ : Diagram V} {ν eν : Role → V} {b : V → Ordinal.{u}}
    {Fix : V → Prop} (hyp : DLabHyps I.toPrims n E cap α sd rd V Λ ν eν b Fix)
    {rs : RoleSets} (hrs : roleSets (Closure.anchor E cap) = some rs) {m : Nat} {G G' : Forest}
    {g : Role → Ordinal.{u}} {b' : V → Ordinal.{u}}
    (hinv : StageInv I.toPrims (Closure.anchor E cap) rs α Λ ν b Fix m G g b')
    (hG' : expand (Closure.anchor E cap) (m + 1) = some G') :
    ∃ g' b'', StageInv I.toPrims (Closure.anchor E cap) rs α Λ ν b Fix (m + 1) G' g' b'' := by
  sorry

/-- L8.6, `W_{<n} ⇒ D_{<n}` with labels (txt:1250-1323). -/
theorem dLab_of_wFit (I : Interface.{u}) (n : Nat) (hW : WFit I.toPrims n) :
    DLab I.toPrims n := by
  sorry

/-- D8.1a: the label-free core follows from `DLab` (`E = H`, no cap, `Λ` the prefix graph of
`H` before `T`, `ν = eν = id`, `b = α`, nothing fixed). -/
theorem dCore_of_dLab (P : Prims.{u}) (n : Nat) (h : DLab P n) : DCore P n := by
  sorry

/-! ## §8.4: special descent -/

/-- L8.7a: iterated capture of one positive block into `J_s` (txt:1329-1338): `N` copies with
new coordinates in increasing windows inside `(L, s)`. -/
theorem special_copies (I : Interface.{u}) {W : Type} {D : List (BaseAtom W)}
    {fr : W → Option Ordinal.{u}} {L s Wv : Ordinal.{u}} (hsW : I.Elem s Wv) (hL : L < s)
    (hfr : ∀ x ∈ baseVars D, ∀ o, fr x = some o → o < s)
    (h0 : ∃ β₀ : W → Ordinal.{u}, (∀ x o, fr x = some o → β₀ x = o) ∧ BaseHolds I.toPrims D β₀ ∧
      ∀ x ∈ baseVars D, fr x = none → s ≤ β₀ x ∧ β₀ x < Wv)
    (N : Nat) :
    ∃ βs : Nat → W → Ordinal.{u},
      (∀ i < N, (∀ x o, fr x = some o → βs i x = o) ∧ BaseHolds I.toPrims D (βs i) ∧
        ∀ x ∈ baseVars D, fr x = none → L < βs i x ∧ βs i x < s) ∧
      ∀ i j, i < j → j < N → ∀ x ∈ baseVars D, fr x = none → ∀ y ∈ baseVars D,
        fr y = none → βs i x < βs j y := by
  sorry

-- L8.7 itself is the spine contract `Descent.specialDesc` (txt:1325-1346); its proof plan is in
-- the unit doc and uses `special_copies`, `Packet.special_graph` (U3 L6.2f), `Packet.posBlock_heads_graph`
-- and `Packet.blockMap_frame` (U3 D7.1a, D7.1b),
-- `posBlock_prefix` and `owner_path_elem_config`.

/-! ## §8.5: `D_{<n} ⇒ S_n` -/

/-- L8.8a, (23): factorization turns a failure into a raised floor with a negative block. -/
theorem failure_floor {P : Prims.{u}} (pk : SourcePacket.{u}) (hv : pk.Valid P)
    (ha : pk.rk.a ∈ pk.rk.F.entryAddrs) {L : Ordinal.{u}} (hL : L < pk.asg pk.owner) (hf : ¬ pk.TargetAbove P L) :
    ∃ Ls, L ≤ Ls ∧ Ls < pk.asg pk.owner ∧ (∀ x ∈ pk.lowNames, pk.asg x < Ls) ∧
      ¬ BlockAbove P (posBlock pk.rk.tgtKey pk.rk.tgtSel)
        (fun w => (pk.tgtFrame.toFr w).map pk.asg) Ls (pk.asg pk.owner) := by
  sorry

/-- L8.8b: Case 1, the whole target ends first: contradiction (txt:1357-1363). -/
theorem case_wholeEnds (I : Interface.{u}) (pk : SourcePacket.{u}) (hadm : pk.rk.Admitted)
    (hv : pk.Valid I.toPrims) {Ls : Ordinal.{u}} (hLs : Ls < pk.asg pk.owner)
    (hlow : ∀ x ∈ pk.lowNames, pk.asg x < Ls)
    (h23 : ¬ BlockAbove I.toPrims (posBlock pk.rk.tgtKey pk.rk.tgtSel)
      (fun w => (pk.tgtFrame.toFr w).map pk.asg) Ls (pk.asg pk.owner))
    (hfd : pk.rk.firstDiff = .wholeEnds) : False := by
  sorry

/-- L8.8c: readmission by a second capture into `J_u` (txt:1375-1381, 1459-1470): a configured
new source context `F'` of an admitted record for the same target, keeping the low prefix and
the owner value `u`, below some `W` with `J_u ≺ J_W`, yields a valid packet at `(ρ, w)` with
`L_* < w < u` that fails at `L_*`. -/
theorem readmit_capture (I : Interface.{u}) (pk : SourcePacket.{u}) (hv : pk.Valid I.toPrims)
    {Ls : Ordinal.{u}} (hLs : Ls < pk.asg pk.owner) (hlow : ∀ x ∈ pk.lowNames, pk.asg x < Ls)
    (h23 : ¬ BlockAbove I.toPrims (posBlock pk.rk.tgtKey pk.rk.tgtSel)
      (fun w => (pk.tgtFrame.toFr w).map pk.asg) Ls (pk.asg pk.owner))
    (rk' : SrcRecord) (hadm' : rk'.Admitted) (hE : rk'.E = pk.rk.E) (hb : rk'.b = pk.rk.b)
    (srcChart' : Role → Name) (hinj : Set.InjOn srcChart' {x | x ∈ rk'.F.roles})
    (hhost : srcChart' (.ord rk'.a.col) = pk.host) (hown : srcChart' (.slot rk'.a) = pk.owner)
    (hframe : ((frameOf rk'.a).map srcChart').reps.take (rk'.a.col.num 0) =
      pk.tgtFrame.reps.take (rk'.a.col.num 0))
    (hpre : ∀ x ∈ prefixRoles rk'.F rk'.a, srcChart' x ∈ pk.lowNames)
    (hfresh : ∀ x ∈ rk'.F.roles, x ∉ prefixRoles rk'.F rk'.a → x ≠ .slot rk'.a →
      srcChart' x ∉ pk.lowNames ∧ srcChart' x ≠ pk.owner)
    {γ : Role → Ordinal.{u}} (hγ : IsConfig I.toPrims rk'.F γ)
    (hγpre : ∀ x ∈ prefixRoles rk'.F rk'.a, γ x = pk.asg (srcChart' x))
    (hγown : γ (.slot rk'.a) = pk.asg pk.owner)
    {W : Ordinal.{u}} (hW : I.Elem (pk.asg pk.owner) W) (hγW : ∀ x ∈ rk'.F.roles, γ x < W) :
    ∃ pk' : SourcePacket.{u}, pk'.rk = rk' ∧ pk'.Valid I.toPrims ∧
      pk'.asg pk'.host = pk.asg pk.host ∧ Ls < pk'.asg pk'.owner ∧
      pk'.asg pk'.owner < pk.asg pk.owner ∧ ¬ pk'.TargetAbove I.toPrims Ls := by
  sorry

/-- L8.8d: Case 2, a proper child forest ends first: a smaller failure (txt:1364-1381). -/
theorem case_childEnds (I : Interface.{u}) {n : Nat} (hD : DLab I.toPrims n)
    (hSp : SpecialDesc I.toPrims) (pk : SourcePacket.{u}) (hadm : pk.rk.Admitted)
    (hv : pk.Valid I.toPrims) (hsize : pk.rk.tgtHeight.size = n) {Ls : Ordinal.{u}}
    (hLs : Ls < pk.asg pk.owner) (hlow : ∀ x ∈ pk.lowNames, pk.asg x < Ls)
    (h23 : ¬ BlockAbove I.toPrims (posBlock pk.rk.tgtKey pk.rk.tgtSel)
      (fun w => (pk.tgtFrame.toFr w).map pk.asg) Ls (pk.asg pk.owner))
    {π : List (Nat × Nat)} (hfd : pk.rk.firstDiff = .childEnds π) :
    ∃ pk', Fails I.toPrims n pk' Ls ∧ failPair pk' < failPair pk := by
  sorry

/-- L8.8e: position of the root of an anchored step relative to a containing marked entry `e`:
strictly inside `e`, or at or before the host column `A_{e.col}` in reading order
(txt:1454-1455). -/
theorem root_position {H : Forest} (hV : Scan.CondV H) {sd : Scan.StopData}
    {rd : Scan.RootData} (hsd : Scan.stopData H = some sd) (hrd : Scan.rootData H = some rd)
    {e : EntryAddr} (he : e ∈ H.entryAddrs) (hin : (Role.ord sd.col).inEntry e = true) :
    (Role.ord rd.col).inEntry e = true ∨ rd.col = e.col ∨
      Role.ord rd.col ∈ rolesBefore H (.ord e.col) := by
  sorry

/-- L8.8f: Case 3, a parent differs or an existing column ends first: a smaller failure, by the
moving clause if `p ≤ ρ` and by a second capture if `p > ρ` (txt:1382-1470). The data of the
repaired cap are `Packet.CapData` (U3 L7.5d). -/
theorem case_cap (I : Interface.{u}) {n : Nat} (hD : DLab I.toPrims n) (pk : SourcePacket.{u})
    (hadm : pk.rk.Admitted) (hv : pk.Valid I.toPrims) (hsize : pk.rk.tgtHeight.size = n)
    {Ls : Ordinal.{u}} (hLs : Ls < pk.asg pk.owner) (hlow : ∀ x ∈ pk.lowNames, pk.asg x < Ls)
    (h23 : ¬ BlockAbove I.toPrims (posBlock pk.rk.tgtKey pk.rk.tgtSel)
      (fun w => (pk.tgtFrame.toFr w).map pk.asg) Ls (pk.asg pk.owner))
    {c : ColAddr} {k p : Nat} (hfd : pk.rk.firstDiff = .capAt c k p) :
    ∃ pk' L', Fails I.toPrims n pk' L' ∧ failPair pk' < failPair pk := by
  sorry

/-- L8.8g: the least-failure argument (txt:1349-1352): if every failure has a failure with a
lexicographically smaller host-owner pair, there is none. -/
theorem least_failure {P : Prims.{u}} {n : Nat}
    (hstep : ∀ pk L, Fails P n pk L → ∃ pk' L', Fails P n pk' L' ∧ failPair pk' < failPair pk) :
    SStrict P n := by
  intro pk hadm hv hsize L hL
  by_contra hT
  have key : ∀ p : Ordinal.{u} ×ₗ Ordinal.{u}, ∀ (pk : SourcePacket.{u}) (L : Ordinal.{u}),
      failPair pk = p → ¬ Fails P n pk L := by
    intro p
    induction p using WellFoundedLT.induction with
    | _ p ih =>
      intro pk L hp hF
      obtain ⟨pk', L', hF', hlt⟩ := hstep pk L hF
      exact ih (failPair pk') (hp ▸ hlt) pk' L' rfl hF'
  exact key _ pk L rfl ⟨hadm, hv, hsize, hL, hT⟩

/-- L8.8, `D_{<n} ⇒ S_n` (txt:1348-1474). -/
theorem sStrict_of_dLab (I : Interface.{u}) (n : Nat) (hD : DLab I.toPrims n) :
    SStrict I.toPrims n := by
  sorry

/-! ## §9: strict descent, the abstract theorem, `σ` -/

/-- T9.1b: deletion removes the empty last outer column, the largest role. -/
theorem deletion_config {P : Prims.{u}} {A A' : Forest} {k : Nat} {α : Role → Ordinal.{u}}
    (hk : Scan.stepKind A = some .deletion) (hA' : expand A k = some A')
    (hα : IsConfig P A α) : IsConfig P A' α ∧ cfgMax A' α < cfgMax A α := by
  sorry

/-- T9.1c: special case of (27): `max γ < α(U_e) ≤ max α`. -/
theorem descent_special (I : Interface.{u}) {A A' : Forest} {k : Nat} {α : Role → Ordinal.{u}}
    (hL : Scan.InL A) (hk : Scan.stepKind A = some .special) (hα : IsConfig I.toPrims A α)
    (hA' : expand A k = some A') : ∃ γ, IsConfig I.toPrims A' γ ∧ cfgMax A' γ < cfgMax A α := by
  sorry

/-- T9.1d: ordinary case of (27): `max γ < α(T) ≤ max α`, with `n` above every query size. -/
theorem descent_ordinary (I : Interface.{u}) {A A' : Forest} {k : Nat} {α : Role → Ordinal.{u}}
    (hA : IsStd A) (hk : Scan.stepKind A = some .ordinary) (hα : IsConfig I.toPrims A α)
    (hA' : expand A k = some A') : ∃ γ, IsConfig I.toPrims A' γ ∧ cfgMax A' γ < cfgMax A α := by
  sorry

/-- N5.1a: every nonempty standard expression has a configuration (induction on `IsStd`). -/
theorem std_configured {Conf : Forest → Ordinal.{u} → Prop} (h : FinalHyps Conf) {A : Forest}
    (hA : IsStd A) (hne : A ≠ Tree.empty) : ∃ θ, Conf A θ := by
  induction hA with
  | seed m => exact h.seed m
  | @expand e e' n hs he ih =>
    have hne' : e ≠ Tree.empty := by
      rintro rfl
      exact hne (Option.some.inj ((Scan.expand_empty n).symm.trans he)).symm
    obtain ⟨θ, hθ⟩ := ih hne'
    obtain ⟨θ', -, hθ'⟩ := h.descent e e' n θ hs hne' hθ he hne
    exact ⟨θ', hθ'⟩

/-- N5.1c: the empty forest is accessible (nothing is below it). -/
theorem acc_empty {Conf : Forest → Ordinal.{u} → Prop} (h : FinalHyps Conf) (B : Std)
    (hB : B.1 = Tree.empty) : Acc Std.lt B := by
  refine Acc.intro _ fun C hCB => ?_
  change C.1 < B.1 at hCB
  rw [hB] at hCB
  have hC : C.1 ≠ Tree.empty := by
    intro hh
    rw [hh] at hCB
    exact lt_irrefl _ hCB
  exact absurd (h.empty_least C.1 hC) (lt_asymm hCB)

/-- N5.1b (S-2, accessibility form): below a configured nonempty standard `A` of maximum `θ`,
every standard `B ≤ A` is accessible (induction on `θ`). -/
theorem acc_of_conf {Conf : Forest → Ordinal.{u} → Prop} (h : FinalHyps Conf) :
    ∀ (θ : Ordinal.{u}) (A : Forest), IsStd A → A ≠ Tree.empty → Conf A θ →
      ∀ B : Std, B.1 ≤ A → Acc Std.lt B := by
  intro θ
  induction θ using WellFoundedLT.induction with
  | _ θ ih =>
    intro A hA hne hconf B hBA
    refine Acc.intro _ fun C hCB => ?_
    by_cases hC : C.1 = Tree.empty
    · exact acc_empty h C hC
    · have hCA : C.1 < A := lt_of_lt_of_le hCB hBA
      obtain ⟨n, A', hex, hCA'⟩ := h.cofinal C.1 A C.2 (h.closure A hA) hCA
      have hne' : A' ≠ Tree.empty := by
        intro hh
        rw [hh] at hCA'
        exact not_lt_of_ge hCA' (h.empty_least C.1 hC)
      obtain ⟨θ', hlt, hconf'⟩ := h.descent A A' n θ hA hne hconf hex hne'
      exact ih θ' hlt A' (IsStd.expand n hA hex) hne' hconf' C hCA'

/-- R9.2: the ordinal interpretation `σ(∅) = 0`, `σ(E) = min {max α + 1 : α ⊨ Γ(E)}`. -/
noncomputable def sigma (P : Prims.{u}) (E : Forest) : Ordinal.{u} :=
  if E = Tree.empty then 0 else sInf {o | ∃ θ, Configured P E θ ∧ o = θ + 1}

/-- R9.2: `σ(E[k]) < σ(E)` for nonempty standard `E`, also when `E[k]` is empty. -/
theorem sigma_lt {P : Prims.{u}} (hD : StrictDescent P) {E E' : Forest} {k : Nat}
    (hE : IsStd E) (hne : E ≠ Tree.empty) (hC : ∃ θ, Configured P E θ)
    (h : expand E k = some E') : sigma P E' < sigma P E := by
  sorry

