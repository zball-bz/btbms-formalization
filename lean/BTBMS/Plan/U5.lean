/-! ## N5.3 Block problems: floor encoding, capture, monotonicity -/

/-- N5.3: the floor-variable encoding of a block problem over `Option W` (`none` = the floor):
the atoms of `D`, and `floor < x` for every new variable `x`. -/
def floorDiagram {W : Type} (D : List (BaseAtom W)) (fr : W → Option Ordinal.{u}) :
    Diagram (Option W) :=
  Diagram.ofBase (D.map (BaseAtom.map some) ++
    ((baseVars D).filter fun x => (fr x).isNone).map fun x => BaseAtom.lt none (some x))

/-- N5.3: fixed variables of the encoding: the floor and every frame variable. -/
def floorFixed {W : Type} (fr : W → Option Ordinal.{u}) : Option W → Prop
  | none => True
  | some x => (fr x).isSome = true

/-- N5.3: values of the fixed variables of the encoding. -/
noncomputable def floorSigma {W : Type} (fr : W → Option Ordinal.{u}) (L : Ordinal.{u}) :
    Option W → Ordinal.{u}
  | none => L
  | some x => (fr x).getD 0

/-- N5.3 (helper): variables of a renamed base atom. -/
theorem baseAtom_vars_map {V W : Type} (f : V → W) (b : BaseAtom V) :
    (b.map f).vars = b.vars.map f := by
  cases b <;> rfl

/-- N5.3 (helper): variables of a renamed base diagram. -/
theorem baseVars_map {V W : Type} (f : V → W) (D : List (BaseAtom V)) :
    baseVars (D.map (BaseAtom.map f)) = (baseVars D).map f := by
  simp [baseVars, List.flatMap_map, baseAtom_vars_map, List.map_flatMap]

/-- N5.3 (helper): variables of an embedded base diagram. -/
theorem ofBase_vars {V : Type} (D : List (BaseAtom V)) :
    (Diagram.ofBase D).vars = baseVars D := by
  simp [Diagram.vars, Diagram.ofBase, baseVars, List.flatMap_map, Atom.vars]

/-- N5.3 (helper): a renamed base atom holds iff the original holds at the composite. -/
theorem baseAtom_holds_map' {V W : Type} (P : Prims.{u}) (f : V → W) (a : W → Ordinal.{u})
    (b : BaseAtom V) : (b.map f).Holds P a ↔ b.Holds P (a ∘ f) := by
  cases b <;> rfl

/-- N5.3 (helper): a renamed base diagram holds iff the original holds at the composite. -/
theorem baseHolds_map' {V W : Type} (P : Prims.{u}) (f : V → W) (D : List (BaseAtom V))
    (a : W → Ordinal.{u}) : BaseHolds P (D.map (BaseAtom.map f)) a ↔ BaseHolds P D (a ∘ f) := by
  simp only [BaseHolds, List.mem_map, forall_exists_index, and_imp, forall_apply_eq_imp_iff₂,
    baseAtom_holds_map']

/-- N5.3 (helper): the variables of the floor encoding are the floor and the `some` copies of
the variables of `D`. -/
theorem floorDiagram_vars {W : Type} {D : List (BaseAtom W)} {fr : W → Option Ordinal.{u}}
    {z : Option W} (hz : z ∈ (floorDiagram D fr).vars) : ∀ x, z = some x → x ∈ baseVars D := by
  rintro x rfl
  simp only [floorDiagram, ofBase_vars, baseVars, List.flatMap_append, List.mem_append,
    List.mem_flatMap, List.mem_map, List.mem_filter] at hz
  rcases hz with ⟨b, ⟨b0, hb0, rfl⟩, hx⟩ | ⟨b, ⟨y, ⟨hy, -⟩, rfl⟩, hx⟩
  · rw [baseAtom_vars_map] at hx
    obtain ⟨y, hy, hyx⟩ := List.mem_map.1 hx
    cases hyx
    exact List.mem_flatMap.2 ⟨b0, hb0, hy⟩
  · simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false, reduceCtorEq,
      false_or, Option.some.injEq] at hx
    subst hx
    exact List.mem_flatMap.2 hy

/-- N5.3: `BlockAbove` is realizability of its floor encoding (for a floor below the budget). -/
theorem blockAbove_iff_floor (P : Prims.{u}) {W : Type} (D : List (BaseAtom W))
    (fr : W → Option Ordinal.{u}) {L w : Ordinal.{u}} (hL : L < w) :
    BlockAbove P D fr L w ↔
      (floorDiagram D fr).RealizableBelow P (floorFixed fr) (floorSigma fr L) w := by
  constructor
  · rintro ⟨β, hfix, hnew, hlt, hhold⟩
    refine ⟨fun z => Option.elim z L β, fun z hz => ?_, fun z hz => ?_, ?_⟩
    · cases z with
      | none => rfl
      | some x =>
        obtain ⟨o, ho⟩ := Option.isSome_iff_exists.1 hz
        simp [floorSigma, ho, hfix x o ho]
    · cases z with
      | none => exact hL
      | some x => exact hlt x (floorDiagram_vars hz x rfl)
    · rw [floorDiagram, holds_ofBase]
      intro b hb
      rcases List.mem_append.1 hb with hb | hb
      · obtain ⟨b0, hb0, rfl⟩ := List.mem_map.1 hb
        exact (baseAtom_holds_map' P some _ b0).2 (hhold b0 hb0)
      · obtain ⟨x, hx, rfl⟩ := List.mem_map.1 hb
        obtain ⟨hxD, hxn⟩ := List.mem_filter.1 hx
        exact hnew x hxD (Option.isNone_iff_eq_none.1 hxn)
  · rintro ⟨a, hfix, hlt, hhold⟩
    rw [floorDiagram, holds_ofBase] at hhold
    have hnone : a none = L := hfix none trivial
    refine ⟨fun x => a (some x), fun x o hx => ?_, fun x hx hn => ?_, fun x hx => ?_, ?_⟩
    · have := hfix (some x) (by simp [floorFixed, hx])
      simpa [floorSigma, hx] using this
    · have := hhold (BaseAtom.lt none (some x)) (List.mem_append.2 (Or.inr
        (List.mem_map.2 ⟨x, List.mem_filter.2 ⟨hx, by simp [hn]⟩, rfl⟩)))
      simpa [BaseAtom.Holds, hnone] using this
    · refine hlt (some x) ?_
      rw [floorDiagram, ofBase_vars, baseVars, List.flatMap_append]
      refine List.mem_append.2 (Or.inl ?_)
      rw [← baseVars, baseVars_map]
      exact List.mem_map_of_mem hx
    · intro b hb
      exact (baseAtom_holds_map' P some a b).1
        (hhold _ (List.mem_append.2 (Or.inl (List.mem_map_of_mem hb))))

/-- N5.3: capture of a block problem along `J_a ≺_{Σ1} J_b` (frame and floor below `a`). -/
theorem blockAbove_capture (I : Interface.{u}) {W : Type} {D : List (BaseAtom W)}
    {fr : W → Option Ordinal.{u}} {L a b : Ordinal.{u}} (hab : I.Elem a b) (hL : L < a)
    (hfr : ∀ x ∈ baseVars D, ∀ o, fr x = some o → o < a)
    (h : BlockAbove I.toPrims D fr L b) : BlockAbove I.toPrims D fr L a := by
  have hLb : L < b := hL.trans_le (I.elem_le hab)
  refine (blockAbove_iff_floor I.toPrims D fr hL).2 ?_
  refine I.capture (floorDiagram D fr) (floorFixed fr) (floorSigma fr L) hab ?_
    ((blockAbove_iff_floor I.toPrims D fr hLb).1 h)
  intro z hz hfz
  cases z with
  | none => exact hL
  | some x =>
    obtain ⟨o, ho⟩ := Option.isSome_iff_exists.1 hfz
    simpa [floorSigma, ho] using hfr x (floorDiagram_vars hz x rfl) o ho

/-- N5.3: `BlockAbove` is antitone in the floor and monotone in the budget. -/
theorem blockAbove_mono {P : Prims.{u}} {W : Type} {D : List (BaseAtom W)}
    {fr : W → Option Ordinal.{u}} {L L' w w' : Ordinal.{u}} (hL : L ≤ L') (hw : w ≤ w')
    (h : BlockAbove P D fr L' w) : BlockAbove P D fr L w' := by
  obtain ⟨β, hfix, hnew, hlt, hhold⟩ := h
  exact ⟨β, hfix, fun x hx hn => hL.trans_lt (hnew x hx hn),
    fun x hx => (hlt x hx).trans_le hw, hhold⟩

/-- N5.3: a `TargetAbove` witness is a `BlockAbove` witness at the owner value. -/
theorem blockAbove_of_targetAbove {P : Prims.{u}} (pk : SourcePacket.{u}) {L : Ordinal.{u}}
    (h : pk.TargetAbove P L) :
    BlockAbove P (posBlock pk.rk.tgtKey pk.rk.tgtSel) (fun w => (pk.tgtFrame.toFr w).map pk.asg)
      L (pk.asg pk.owner) := by
  obtain ⟨β, hfix, hnew, hlt, hhold⟩ := h
  refine ⟨β, fun x o hx => ?_, fun x hx hn => (hnew x hx (Option.map_eq_none_iff.1 hn)).1,
    hlt, hhold⟩
  obtain ⟨y, hy, rfl⟩ := Option.map_eq_some_iff.1 hx
  exact hfix x y hy

/-! ## N5.5 Fresh names -/

/-- N5.5: one more than the largest role tag in a finite list of names. -/
def tagBound (l : List Name) : Nat :=
  l.foldr (fun n k => max k (match n with
    | .role t _ => t + 1
    | .aux _ => 0)) 0

/-- N5.5: names with tag `tagBound l` are fresh for `l`. -/
theorem tagBound_fresh (l : List Name) (r : Role) : Name.role (tagBound l) r ∉ l := by
  have key : ∀ (l : List Name) (t : Nat) (r' : Role), Name.role t r' ∈ l → t < tagBound l := by
    intro l
    induction l with
    | nil => intro t r' h; simp at h
    | cons n rest ih =>
      intro t r' h
      simp only [tagBound, List.foldr_cons] at ih ⊢
      rcases List.mem_cons.1 h with rfl | h
      · exact lt_max_of_lt_right (Nat.lt_succ_self t)
      · exact lt_max_of_lt_left (ih t r' h)
  intro h
  exact lt_irrefl _ (key l _ r h)

/-! ## N5.6 Prefix monotonicity of free blocks -/

/-- N5.6 (helper): roles of a concatenation of column lists. -/
theorem rolesCols_append {α : Type} (π : List (Nat × Nat)) (cs ds : List (List (α × Tree α)))
    (c : Nat) : Tree.rolesCols π c (cs ++ ds) =
      Tree.rolesCols π c cs ++ Tree.rolesCols π (c + cs.length) ds := by
  induction cs generalizing c with
  | nil => simp [Tree.rolesCols]
  | cons col rest ih =>
    simp only [List.cons_append, Tree.rolesCols, ih, List.append_assoc, List.length_cons]
    rw [show c + 1 + rest.length = c + (rest.length + 1) by omega]

/-- N5.6 (helper): a forest at a nonempty path only reads the columns it passes through. -/
theorem forestAt_cons_mono {α : Type} {cs cs' : List (List (α × Tree α))}
    (h : ∀ (i : Nat) y, cs[i]? = some y → cs'[i]? = some y) (p : Nat × Nat)
    (rest : List (Nat × Nat))
    {f : Tree α} (hf : (Tree.node cs).forestAt (p :: rest) = some f) :
    (Tree.node cs').forestAt (p :: rest) = some f := by
  obtain ⟨ci, ii⟩ := p
  simp only [Tree.forestAt, Tree.cols] at hf ⊢
  cases hc : cs[ci]? with
  | none => simp [hc] at hf
  | some col => rw [h ci col hc]; rw [hc] at hf; exact hf

/-- N5.6 (helper): columns of a tree survive appending outer columns. -/
theorem colAt_mono_cols {α : Type} {cs cs' : List (List (α × Tree α))}
    (h : ∀ (i : Nat) y, cs[i]? = some y → cs'[i]? = some y) (d : ColAddr) {x : List (α × Tree α)}
    (hx : (Tree.node cs).colAt d = some x) : (Tree.node cs').colAt d = some x := by
  unfold Tree.colAt at hx ⊢
  cases hp : d.path with
  | nil =>
    rw [hp] at hx
    simp only [Tree.forestAt, Option.bind_some, Tree.cols] at hx ⊢
    exact h _ _ hx
  | cons p rest =>
    rw [hp] at hx
    cases hf : (Tree.node cs).forestAt (p :: rest) with
    | none => rw [hf] at hx; simp at hx
    | some f => rw [hf] at hx; rw [forestAt_cons_mono h p rest hf]; exact hx

/-- N5.6 (helper): entries of a tree survive appending outer columns. -/
theorem entryAt_mono_cols {α : Type} {cs cs' : List (List (α × Tree α))}
    (h : ∀ (i : Nat) y, cs[i]? = some y → cs'[i]? = some y) (e : EntryAddr) {x : α × Tree α}
    (hx : (Tree.node cs).entryAt e = some x) : (Tree.node cs').entryAt e = some x := by
  unfold Tree.entryAt at hx ⊢
  cases hc : (Tree.node cs).colAt e.col with
  | none => rw [hc] at hx; simp at hx
  | some col => rw [hc] at hx; rw [colAt_mono_cols h _ hc]; exact hx

/-- N5.6 (helper): zips of prefixes are prefixes. -/
theorem zip_prefix {α β : Type} {l₁ l₁' : List α} {l₂ l₂' : List β} (h₁ : l₁ <+: l₁')
    (h₂ : l₂ <+: l₂') : l₁.zip l₂ <+: l₁'.zip l₂' := by
  induction l₁ generalizing l₁' l₂ l₂' with
  | nil => exact List.nil_prefix
  | cons x xs ih =>
    obtain ⟨t₁, rfl⟩ := h₁
    cases l₂ with
    | nil => exact List.nil_prefix
    | cons y ys =>
      obtain ⟨t₂, rfl⟩ := h₂
      simp only [List.cons_append, List.zip_cons_cons]
      exact (List.prefix_cons_inj _).2 (ih ⟨t₁, rfl⟩ ⟨t₂, rfl⟩)

/-- N5.6: if `K` consists of the first outer columns of `K'`, every atom of `freeBlock K` is an
atom of `freeBlock K'`, and the roles of `K` are a prefix of those of `K'`. -/
theorem freeBlock_prefix {K K' : Key} (h : K.cols = K'.cols.take K.cols.length) :
    (∀ a ∈ freeBlock K, a ∈ freeBlock K') ∧ K.roles <+: K'.roles := by
  obtain ⟨cs⟩ := K
  obtain ⟨cs'⟩ := K'
  simp only [Tree.cols] at h
  have hcs : cs' = cs ++ cs'.drop cs.length := by
    conv_lhs => rw [← List.take_append_drop cs.length cs']
    rw [← h]
  have hget : ∀ (i : Nat) y, cs[i]? = some y → cs'[i]? = some y := by
    intro i y hy
    rw [h, List.getElem?_take] at hy
    split_ifs at hy
    exact hy
  have hroles : (Tree.node cs).roles <+: (Tree.node cs').roles := by
    refine ⟨Tree.rolesCols [] (0 + cs.length) (cs'.drop cs.length), ?_⟩
    simp only [Tree.roles, Tree.rolesF]
    conv_rhs => rw [hcs]
    rw [rolesCols_append]
  refine ⟨fun a ha => ?_, hroles⟩
  have hrs := hroles.map BlkVar.inner
  have hcolA : ∀ c, c ∈ (Tree.node cs).colAddrs → c ∈ (Tree.node cs').colAddrs :=
    fun c hc => (hroles.filterMap _).subset hc
  have hentA : ∀ e, e ∈ (Tree.node cs).entryAddrs → e ∈ (Tree.node cs').entryAddrs :=
    fun e he => (hroles.filterMap _).subset he
  simp only [freeBlock, List.mem_append, List.mem_cons, List.mem_map, List.mem_filterMap,
    List.mem_flatMap] at ha ⊢
  rcases ha with ((((rfl | ⟨r, hr, rfl⟩) | ⟨xy, hxy, rfl⟩) | ⟨c, hc, hca⟩) | ⟨e, he, hea⟩)
  · exact Or.inl (Or.inl (Or.inl (Or.inl rfl)))
  · obtain ⟨r0, hr0, rfl⟩ := hr
    exact Or.inl (Or.inl (Or.inl (Or.inr ⟨_, ⟨r0, hroles.subset hr0, rfl⟩, rfl⟩)))
  · refine Or.inl (Or.inl (Or.inr ⟨xy, ?_, rfl⟩))
    exact (zip_prefix ((List.prefix_cons_inj _).2 hrs) hrs).subset hxy
  · refine Or.inl (Or.inr ⟨c, hcolA c hc, ?_⟩)
    split_ifs at hca with hs
    obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 hs
    rw [colAt_mono_cols hget _ hx]
    simpa using hca
  · refine Or.inr ⟨e, hentA e he, ?_⟩
    cases hx : (Tree.node cs).entryAt e with
    | none => rw [hx] at hea; simp at hea
    | some x => rw [hx] at hea; rw [entryAt_mono_cols hget e hx]; exact hea

/-- N5.6: the same for positive blocks with the same selector. -/
theorem posBlock_prefix {K K' : Key} (h : K.cols = K'.cols.take K.cols.length) (sel : Nat) :
    ∀ a ∈ posBlock K sel, a ∈ posBlock K' sel := by
  intro a ha
  simp only [posBlock, List.mem_append] at ha ⊢
  rcases ha with ha | ha
  · exact Or.inl ((freeBlock_prefix h).1 a ha)
  · exact Or.inr ha

/-- N5.6 (helper): prefixes of a reachable path are reachable. -/
theorem forestAt_isSome_of_prefix {α : Type} {t : Tree α} {π π' : List (Nat × Nat)}
    (h : π' <+: π) (hs : (t.forestAt π).isSome) : (t.forestAt π').isSome := by
  obtain ⟨r, rfl⟩ := h
  rw [Tree.forestAt_append] at hs
  cases hf : t.forestAt π' with
  | none => rw [hf] at hs; simp at hs
  | some f => rfl

/-- N5.6 (helper): a forest reachable through `(ck, ik)` has a column `ck`. -/
theorem cols_isSome_of_forestAt_cons {α : Type} {f : Tree α} {ck ik : Nat}
    {rest : List (Nat × Nat)} (hs : (f.forestAt ((ck, ik) :: rest)).isSome) :
    (f.cols[ck]?).isSome := by
  simp only [Tree.forestAt] at hs
  cases hc : f.cols[ck]? with
  | none => rw [hc] at hs; simp at hs
  | some _ => rfl

/-- N5.6 (helper): every column on the visible stack of a column of `t` is a column of `t`. -/
theorem colAt_isSome_of_onStack {α : Type} {t : Tree α} {c o : ColAddr}
    (hc : (t.colAt c).isSome) (ho : c.OnStack o) : (t.colAt o).isSome := by
  unfold Tree.colAt at hc ⊢
  cases hf : t.forestAt c.path with
  | none => rw [hf] at hc; simp at hc
  | some f =>
    rw [hf] at hc
    simp only [Option.bind_some] at hc
    rcases ho with ⟨k, ck, ik, hk, hop, hoc⟩ | ⟨hop, hoc⟩
    · have hsplit : c.path = c.path.take k ++ (ck, ik) :: c.path.drop (k + 1) := by
        obtain ⟨hlt, heq⟩ := List.getElem?_eq_some_iff.1 hk
        conv_lhs => rw [← List.take_append_drop k c.path]
        rw [List.drop_eq_getElem_cons hlt, heq]
      have hs : (t.forestAt c.path).isSome := by rw [hf]; rfl
      rw [hsplit, Tree.forestAt_append] at hs
      rw [hop]
      cases hg : t.forestAt (c.path.take k) with
      | none => rw [hg] at hs; simp at hs
      | some g =>
        rw [hg] at hs
        simp only [Option.bind_some] at hs ⊢
        have := cols_isSome_of_forestAt_cons hs
        rw [Option.isSome_iff_exists] at this ⊢
        obtain ⟨col, hcol⟩ := this
        have hlt : ck < g.cols.length := (List.getElem?_eq_some_iff.1 hcol).1
        exact ⟨_, List.getElem?_eq_getElem (by omega)⟩
    · rw [hop, hf]
      simp only [Option.bind_some]
      rw [Option.isSome_iff_exists] at hc ⊢
      obtain ⟨col, hcol⟩ := hc
      have hlt : c.col < f.cols.length := (List.getElem?_eq_some_iff.1 hcol).1
      exact ⟨_, List.getElem?_eq_getElem (by omega)⟩

/-- N5.6 (helper): both representatives of a resolved number seen from a column of `t` are
roles of `t`. -/
theorem rep_mem_roles {α : Type} {t : Tree α} {c : ColAddr} (hc : (t.colAt c).isSome)
    {base q : Nat} {o w : Role} (hr : c.rep base q = some (o, w)) : o ∈ t.roles ∧ w ∈ t.roles := by
  unfold ColAddr.rep at hr
  cases hres : c.resolve base q with
  | none => rw [hres] at hr; simp at hr
  | some o' =>
    rw [hres] at hr
    simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq] at hr
    obtain ⟨rfl, rfl⟩ := hr
    have hst := ((ColAddr.resolve_spec base c o' q).1 hres).1
    have ho' : (t.colAt o').isSome := colAt_isSome_of_onStack hc hst
    refine ⟨(Tree.mem_roles_iff t (.ord o')).2 ho', ?_⟩
    cases hcont : o'.container c with
    | none => exact (Tree.mem_roles_iff t (.ord o')).2 ho'
    | some e' =>
      obtain ⟨-, hpre⟩ := (ColAddr.container_spec o' c e').1 hcont
      have hpath : (t.forestAt c.path).isSome := by
        unfold Tree.colAt at hc
        cases hf : t.forestAt c.path with
        | none => rw [hf] at hc; simp at hc
        | some _ => rfl
      have hh := forestAt_isSome_of_prefix hpre hpath
      rw [Tree.forestAt_heightPath] at hh
      refine (Tree.mem_roles_iff t (.slot e')).2 ?_
      show (t.entryAt e').isSome = true
      unfold Tree.heightAt at hh
      cases he : t.entryAt e' with
      | none => rw [he] at hh; simp at hh
      | some _ => rfl

/-- N5.6 [V-fix, new]: the variables of a positive (hence of a free) block are the frame
variables, the owner, and `inner r` for internal roles `r` of `K` only. -/
theorem posBlock_vars (K : Key) (sel : Nat) :
    ∀ w ∈ baseVars (posBlock K sel), w = .host ∨ w = .owner ∨ (∃ q, w = .ord q ∨ w = .cur q) ∨
      ∃ r ∈ K.roles, w = .inner r := by
  intro w hw
  simp only [baseVars, List.mem_flatMap] at hw
  obtain ⟨b, hb, hwb⟩ := hw
  simp only [posBlock, freeBlock, List.mem_append, List.mem_cons, List.mem_map,
    List.mem_filterMap, List.mem_flatMap, List.not_mem_nil] at hb
  suffices H : ∀ x ∈ b.vars, x = .host ∨ x = .owner ∨ (∃ q, x = .ord q ∨ x = .cur q) ∨
      ∃ r ∈ K.roles, x = .inner r from H w hwb
  clear hwb w
  have gI : ∀ r ∈ K.roles, BlkVar.inner r = .host ∨ BlkVar.inner r = .owner ∨
      (∃ q, BlkVar.inner r = .ord q ∨ BlkVar.inner r = .cur q) ∨
      ∃ r' ∈ K.roles, BlkVar.inner r = .inner r' := fun r hr => Or.inr (Or.inr (Or.inr ⟨r, hr, rfl⟩))
  have hcolR : ∀ c, c ∈ K.colAddrs → Role.ord c ∈ K.roles := by
    intro c hc
    obtain ⟨x, hx, hxc⟩ := List.mem_filterMap.1 hc
    cases x with
    | ord d => cases hxc; exact hx
    | slot _ => cases hxc
  have hentR : ∀ e, e ∈ K.entryAddrs → Role.slot e ∈ K.roles := by
    intro e he
    obtain ⟨x, hx, hxe⟩ := List.mem_filterMap.1 he
    cases x with
    | slot d => cases hxe; exact hx
    | ord _ => cases hxe
  rcases hb with ((((rfl | ⟨_, ⟨r, hr, rfl⟩, rfl⟩) | ⟨xy, hxy, rfl⟩) | ⟨c, hc, hca⟩) |
    ⟨e, he, hea⟩) | rfl | rfl | hF
  · simp [BaseAtom.vars]
  · simp only [BaseAtom.vars, List.mem_singleton, forall_eq]; exact gI r hr
  · obtain ⟨h1, h2⟩ := List.of_mem_zip hxy
    simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false, forall_eq_or_imp,
      forall_eq]
    obtain ⟨r2, hr2, hr2'⟩ := List.mem_map.1 h2
    refine ⟨?_, hr2' ▸ gI r2 hr2⟩
    rcases List.mem_cons.1 h1 with h1 | h1
    · exact Or.inr (Or.inl h1)
    · obtain ⟨r1, hr1, hr1'⟩ := List.mem_map.1 h1
      exact hr1' ▸ gI r1 hr1
  · split_ifs at hca with hs
    cases hca
    simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false, forall_eq_or_imp,
      forall_eq]
    exact ⟨gI _ (hcolR c hc), gI _ ((Tree.mem_roles_iff K (.ord _)).2 hs)⟩
  · have hslot := hentR e he
    cases hx : K.entryAt e with
    | none => rw [hx] at hea; simp at hea
    | some x =>
      obtain ⟨⟨bb, q⟩, h⟩ := x
      have hcol : Role.ord e.col ∈ K.roles := by
        obtain ⟨col, hcol, -⟩ := Tree.colAt_of_entryAt hx
        exact (Tree.mem_roles_iff K (.ord e.col)).2 (show (K.colAt e.col).isSome by
          rw [hcol]; rfl)
      rw [hx] at hea
      cases bb with
      | false =>
        simp only [List.mem_cons, List.mem_nil_iff, or_false] at hea
        rcases hea with rfl | rfl <;>
          simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false, forall_eq_or_imp,
            forall_eq] <;>
          exact ⟨gI _ hslot, gI _ hcol, by simp⟩
      | true =>
        cases q with
        | zero =>
          simp only [List.mem_cons, List.mem_nil_iff, or_false] at hea
          rcases hea with rfl | rfl <;>
            simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false,
              forall_eq_or_imp, forall_eq] <;>
            exact ⟨gI _ hslot, gI _ hcol, by simp⟩
        | succ v =>
          simp only at hea
          cases hr : e.col.rep 1 (v + 1) with
          | none => rw [hr] at hea; simp at hea
          | some ow =>
            obtain ⟨o, w'⟩ := ow
            rw [hr] at hea
            have hcs : (K.colAt e.col).isSome := (Tree.mem_roles_iff K (.ord e.col)).1 hcol
            obtain ⟨ho, hw'⟩ := rep_mem_roles hcs hr
            simp only [List.mem_cons, List.mem_nil_iff, or_false] at hea
            rcases hea with rfl | rfl <;>
              simp only [BaseAtom.vars, List.mem_cons, List.mem_nil_iff, or_false,
                forall_eq_or_imp, forall_eq]
            · exact ⟨gI _ hslot, gI _ hcol, gI _ ho⟩
            · exact ⟨gI _ hslot, gI _ hcol, gI _ hw'⟩
  · simp [BaseAtom.vars]
  · simp [BaseAtom.vars]
  · exact hF.elim

/-! ## N5.8 Projections of packet validity -/

/-- N5.8 (helper): the three blocks of the joint diagram hold. -/
theorem joint_holds {P : Prims.{u}} (pk : SourcePacket.{u}) (hv : pk.Valid P) :
    BaseHolds P (prefixGraph pk.rk.E pk.rk.b) (pk.asg ∘ pk.tgtChart) ∧
      BaseHolds P (graph pk.rk.F) (pk.asg ∘ pk.srcChart) ∧ pk.aux.Holds P pk.asg := by
  have hj : pk.joint.Holds P pk.asg := hv.2.2.2.2.1
  have h1 : (Diagram.ofBase ((prefixGraph pk.rk.E pk.rk.b).map
      (BaseAtom.map pk.tgtChart))).Holds P pk.asg :=
    fun x hx => hj x (List.mem_append.2 (Or.inl (List.mem_append.2 (Or.inl hx))))
  have h2 : (Diagram.ofBase ((graph pk.rk.F).map (BaseAtom.map pk.srcChart))).Holds P pk.asg :=
    fun x hx => hj x (List.mem_append.2 (Or.inl (List.mem_append.2 (Or.inr hx))))
  rw [holds_ofBase, baseHolds_map'] at h1 h2
  exact ⟨h1, h2, fun x hx => hj x (List.mem_append.2 (Or.inr hx))⟩

/-- N5.8: the source context is configured by `asg ∘ srcChart` (Valid clause 4). -/
theorem valid_src_config {P : Prims.{u}} (pk : SourcePacket.{u}) (hv : pk.Valid P) :
    IsConfig P pk.rk.F (pk.asg ∘ pk.srcChart) :=
  (joint_holds pk hv).2.1

/-- N5.8: the target prefix graph holds through `tgtChart` (Valid clause 4). -/
theorem valid_tgt_prefix {P : Prims.{u}} (pk : SourcePacket.{u}) (hv : pk.Valid P) :
    BaseHolds P (prefixGraph pk.rk.E pk.rk.b) (pk.asg ∘ pk.tgtChart) :=
  (joint_holds pk hv).1

/-- N5.8: the auxiliary diagram holds (Valid clause 4). -/
theorem valid_aux {P : Prims.{u}} (pk : SourcePacket.{u}) (hv : pk.Valid P) :
    pk.aux.Holds P pk.asg :=
  (joint_holds pk hv).2.2

/-- N5.8: the host and the target frame names are low; the owner is not. -/
theorem lowNames_spec {P : Prims.{u}} (pk : SourcePacket.{u}) (hadm : pk.rk.Admitted)
    (hv : pk.Valid P) :
    pk.host ∈ pk.lowNames ∧ (∀ ov ∈ pk.tgtFrame.reps, ov.1 ∈ pk.lowNames ∧ ov.2 ∈ pk.lowNames) ∧
      pk.tgtFrame.host ∈ pk.lowNames ∧ pk.owner ∉ pk.lowNames := by
  obtain ⟨-, hb, ha, -⟩ := hadm
  have hlow : ∀ x ∈ pk.lowNames, pk.asg x < pk.asg pk.owner := hv.2.2.2.2.2.2
  have hT : ∀ x ∈ prefixRoles pk.rk.E pk.rk.b, pk.tgtChart x ∈ pk.lowNames := fun x hx =>
    List.mem_append.2 (Or.inl (List.mem_append.2 (Or.inl (List.mem_map_of_mem hx))))
  have hS : ∀ x ∈ prefixRoles pk.rk.F pk.rk.a, pk.srcChart x ∈ pk.lowNames := fun x hx =>
    List.mem_append.2 (Or.inl (List.mem_append.2 (Or.inr (List.mem_map_of_mem hx))))
  obtain ⟨hbcol, hbreps⟩ := frameOf_mem_prefix hb
  refine ⟨hS _ (frameOf_mem_prefix ha).1, fun ov hov => ?_, hT _ hbcol,
    fun h => lt_irrefl _ (hlow _ h)⟩
  simp only [SourcePacket.tgtFrame, Frame.map, frameOf, List.mem_map] at hov
  obtain ⟨ov0, hov0, rfl⟩ := hov
  exact ⟨hT _ (hbreps ov0 hov0).1, hT _ (hbreps ov0 hov0).2⟩

/-! ## L6.7 Seed lemma -/

/-- L6.7a: the column `A_i` of the seed `L_m` (`A_0` the empty outer column; `A_1` the second
outer column; `A_{i+2}` the column of the height of `U_{i+1}`). -/
def seedCol : Nat → ColAddr
  | 0 => ⟨[], 0⟩
  | 1 => ⟨[], 1⟩
  | i + 2 => ⟨(1, 0) :: List.replicate i (0, 0), 0⟩

/-- L6.7a: the ordinary role `A_i`. -/
def seedA (i : Nat) : Role := .ord (seedCol i)

/-- L6.7a: the slot `U_i` (`i ≥ 1`). -/
def seedU (i : Nat) : Role := .slot ⟨seedCol i, 0⟩

/-- L6.7a: reading order of `L_{m+1}`: `A_0, A_1, U_1, …, A_{m+1}, U_{m+1}` (txt:1001). -/
def seedRoles (m : Nat) : List Role :=
  seedA 0 :: (List.range (m + 1)).flatMap fun i => [seedA (i + 1), seedU (i + 1)]

/-- L6.7a: the graph of `L_{m+1}` (txt:1001-1004): limits, the reading chain, the outer pair
`A_0 ≺ A_1`, and the edges `R(U_1,A_1,A_0)` (twice), `R(U_i,A_i,A_{i-1})`, `R(U_i,A_i,U_{i-1})`. -/
def seedGraph (m : Nat) : List (BaseAtom Role) :=
  let rs := seedRoles m
  rs.map BaseAtom.lim ++ (rs.zip rs.tail).map (fun xy => BaseAtom.lt xy.1 xy.2) ++
  [BaseAtom.elem (seedA 0) (seedA 1)] ++
  (List.range (m + 1)).flatMap fun i =>
    [BaseAtom.edge (seedU (i + 1)) (seedA (i + 1)) (seedA i),
     BaseAtom.edge (seedU (i + 1)) (seedA (i + 1)) (if i = 0 then seedA 0 else seedU i)]

/-- L6.7a (testable; checked by `#eval` for `m ≤ 6`). -/
theorem seed_roles (m : Nat) : (seed (m + 1)).roles = seedRoles m := by
  sorry

/-- L6.7a (testable; checked by `#eval` for `m ≤ 6`). -/
theorem seed_graph_sub (m : Nat) : ∀ a ∈ graph (seed (m + 1)), a ∈ seedGraph m := by
  sorry

/-- L6.7a: `L_0 = ()` has one role and one atom (testable). -/
theorem seed_zero_graph : (seed 0).roles = [.ord ⟨[], 0⟩] ∧
    graph (seed 0) = [BaseAtom.lim (.ord ⟨[], 0⟩)] := by
  sorry

/-- L6.7b: the descending Mahlo chain (txt:1005-1011): from a weakly `k`-Mahlo `κ` and a limit
`w > κ`, values `a_0 < a_1 < v_1 < … < a_{k+1} = κ < v_{k+1} = w` with all seed edges. -/
theorem mahlo_chain (I : Interface.{u}) : ∀ (k : Nat) (κ : Cardinal.{u}) (w : Ordinal.{u}),
    IsWeaklyMahlo k κ → IsLim w → κ.ord < w →
    ∃ a v : Nat → Ordinal.{u}, a (k + 1) = κ.ord ∧ v (k + 1) = w ∧
      (∀ i, i ≤ k → I.Edge (v (i + 1)) (a (i + 1)) (a i)) ∧
      (∀ i, 1 ≤ i → i ≤ k → I.Edge (v (i + 1)) (a (i + 1)) (v i)) ∧
      (∀ i, 1 ≤ i → i ≤ k + 1 → a i < v i) := by
  sorry

/-- L6.7c: the seed assignment `A_i ↦ a_i`, `U_i ↦ v_i`. -/
noncomputable def seedVal (a v : Nat → Ordinal.{u}) : Role → Ordinal.{u}
  | .ord c => if c = ⟨[], 0⟩ then a 0 else a (c.path.length + 1)
  | .slot e => v (e.col.path.length + 1)

/-- L6.7c: a Mahlo chain realizes the seed graph. -/
theorem seedGraph_holds (I : Interface.{u}) {m : Nat} {a v : Nat → Ordinal.{u}}
    (h1 : ∀ i, i ≤ m → I.Edge (v (i + 1)) (a (i + 1)) (a i))
    (h2 : ∀ i, 1 ≤ i → i ≤ m → I.Edge (v (i + 1)) (a (i + 1)) (v i))
    (h3 : ∀ i, 1 ≤ i → i ≤ m + 1 → a i < v i) :
    BaseHolds I.toPrims (seedGraph m) (seedVal a v) := by
  sorry

/-! ## D8.1 / §8.1: failures, (19), the two-candidate fact, `S_0` -/

/-- D8.1b: a failure of `S_n` at floor `L`. -/
def Fails (P : Prims.{u}) (n : Nat) (pk : SourcePacket.{u}) (L : Ordinal.{u}) : Prop :=
  pk.rk.Admitted ∧ pk.Valid P ∧ pk.rk.tgtHeight.size = n ∧ L < pk.asg pk.owner ∧
    ¬ pk.TargetAbove P L

/-- D8.1b: the host-owner pair `(ρ, u)` of a packet, lexicographically ordered. -/
noncomputable def failPair (pk : SourcePacket.{u}) : Ordinal.{u} ×ₗ Ordinal.{u} :=
  toLex (pk.asg pk.host, pk.asg pk.owner)

/-- L8.2a: the elementarity atoms of `Γ(E)` that touch entry `e` (its slot or its height). -/
def localStruct (E : Forest) (e : EntryAddr) : List (BaseAtom Role) :=
  (graph E).filter fun a => isStruct a && a.vars.any fun v => v.inEntry e

/-- L8.2a: consecutive columns of one forest give an ordinary pair. -/
theorem elem_col_succ {E : Forest} {c : ColAddr} (hc : c ∈ E.colAddrs)
    (hs : (E.colAt ⟨c.path, c.col + 1⟩).isSome) :
    BaseAtom.elem (.ord c) (.ord ⟨c.path, c.col + 1⟩) ∈ graph E := by
  sorry

/-- L8.2a: under V an entry's column steps to its slot (`edge U_e A_c _`). -/
theorem step_col_slot {E : Forest} (hV : Scan.CondV E) {e : EntryAddr} (he : e ∈ E.entryAddrs) :
    ∃ o, BaseAtom.edge (.slot e) (.ord e.col) o ∈ graph E := by
  sorry

/-- L8.2a: under V and I a slot with nonempty height steps to the height's first column: the
first parent there is the host number, read as `P(host) = U_e` (txt:1194-1195). -/
theorem step_slot_child {E : Forest} (hV : Scan.CondV E) (hI : Scan.CondI E) {e : EntryAddr}
    (he : e ∈ E.entryAddrs) {h : Forest} (hh : E.heightAt e = some h) (hne : h ≠ Tree.empty) :
    BaseAtom.edge (.slot ⟨⟨e.heightPath, 0⟩, 0⟩) (.ord ⟨e.heightPath, 0⟩) (.slot e) ∈ graph E := by
  sorry

/-- L8.2b: the owner path (txt:1194-1200), syntactically: every role inside the height of `e`
is reached from `U_e` by elementarity steps touching `e`. -/
theorem graph_chain {E : Forest} (hV : Scan.CondV E) (hI : Scan.CondI E) {e : EntryAddr}
    (he : e ∈ E.entryAddrs) {z : Role} (hz : z ∈ E.roles) (hin : z.inEntry e = true) :
    Relation.ReflTransGen (ElemStep (localStruct E e)) (.slot e) z := by
  sorry

/-- L8.2c: the atoms touching `e` read only `e`'s slot and height and `e`'s frame. -/
theorem localStruct_vars {E : Forest} (hV : Scan.CondV E) {e : EntryAddr}
    (he : e ∈ E.entryAddrs) :
    ∀ a ∈ localStruct E e, ∀ v ∈ a.vars,
      v.inEntry e = true ∨ v = .ord e.col ∨ ∃ ov ∈ e.col.reps0, v = ov.1 ∨ v = ov.2 := by
  sorry

/-- L8.2, (19): owner-path elementarity in any realized diagram containing the atoms touching
`e`: `J_{β(U_e)} ≺_{Σ1} J_{β z}` for every role `z` inside the height of `e`. -/
theorem owner_path_elem (I : Interface.{u}) {E : Forest} (hV : Scan.CondV E)
    (hI : Scan.CondI E) {e : EntryAddr} (he : e ∈ E.entryAddrs) {D : List (BaseAtom Role)}
    (hD : ∀ a ∈ localStruct E e, a ∈ D) {β : Role → Ordinal.{u}}
    (hβ : BaseHolds I.toPrims D β) (hlim : IsLim (β (.slot e))) {z : Role} (hz : z ∈ E.roles)
    (hin : z.inEntry e = true) : I.Elem (β (.slot e)) (β z) := by
  sorry

/-- L8.2, (19), for configurations. -/
theorem owner_path_elem_config (I : Interface.{u}) {E : Forest} (hV : Scan.CondV E)
    (hI : Scan.CondI E) {α : Role → Ordinal.{u}} (hα : IsConfig I.toPrims E α) {e : EntryAddr}
    (he : e ∈ E.entryAddrs) {z : Role} (hz : z ∈ E.roles) (hin : z.inEntry e = true) :
    I.Elem (α (.slot e)) (α z) := by
  sorry

/-- L8.2d: roles on the terminal route towards the stopping column `T`: an ordinary role of a
route forest at or before that forest's route column, or the slot of a containing entry of
`T`. -/
def OnRoute (sd : Scan.StopData) : Role → Prop
  | .ord c => ∃ d, c.path = sd.col.path.take d ∧
      c.col ≤ (((sd.col.path ++ [(sd.col.col, 0)])[d]?).map Prod.fst).getD 0
  | .slot e => e.heightPath <+: sd.col.path

/-- L8.2d: route elementarity (txt:1289-1291): `J_{α v} ≺_{Σ1} J_{α T}` for `v` on the route. -/
theorem route_chain (I : Interface.{u}) {H : Forest} (hV : Scan.CondV H) (hI : Scan.CondI H)
    {sd : Scan.StopData} (hsd : Scan.stopData H = some sd) {α : Role → Ordinal.{u}}
    (hα : IsConfig I.toPrims H α) {v : Role} (hv : v ∈ H.roles) (hr : OnRoute sd v) :
    I.Elem (α v) (α (.ord sd.col)) := by
  sorry

/-- L8.3: a realization of the free block problem of `K` at frame `fr` above floor `L`. -/
def IsFreeReal (P : Prims.{u}) (K : Key) (fr : BlkVar → Option Ordinal.{u}) (L : Ordinal.{u})
    (β : BlkVar → Ordinal.{u}) : Prop :=
  (∀ w o, fr w = some o → β w = o) ∧
    (∀ w ∈ baseVars (freeBlock K), fr w = none → L < β w) ∧ BaseHolds P (freeBlock K) β

/-- L8.3: the maximum of a block realization over its new variables (owner and inner roles). -/
noncomputable def blkMax (K : Key) (β : BlkVar → Ordinal.{u}) : Ordinal.{u} :=
  ((BlkVar.owner :: K.roles.map BlkVar.inner).map β).foldr max 0

/-- L8.3, two-candidate fact (txt:1201-1210). Given two realizations of the same free problem
above the same floor, with owner paths and frame values at most the floor, some realization has
owner and maximum no larger than either candidate's. -/
theorem two_candidates (I : Interface.{u}) {K : Key} {fr : BlkVar → Option Ordinal.{u}}
    {L : Ordinal.{u}} {βX βY : BlkVar → Ordinal.{u}}
    (hX : IsFreeReal I.toPrims K fr L βX) (hY : IsFreeReal I.toPrims K fr L βY)
    (hpX : ∀ r ∈ K.roles, I.Elem (βX .owner) (βX (.inner r)))
    (hpY : ∀ r ∈ K.roles, I.Elem (βY .owner) (βY (.inner r)))
    (hfr : ∀ w ∈ baseVars (freeBlock K), ∀ o, fr w = some o → o ≤ L)
    (hnew : ∀ w ∈ baseVars (freeBlock K), fr w = none → w = .owner ∨ ∃ r, w = .inner r) :
    ∃ β, IsFreeReal I.toPrims K fr L β ∧ β .owner ≤ βX .owner ∧ β .owner ≤ βY .owner ∧
      blkMax K β ≤ blkMax K βX ∧ blkMax K β ≤ blkMax K βY := by
  sorry

/-- L8.4, base `S_0` (txt:1211-1214; S-3 rejected: the capture along `J_u ≺ J_b` is kept). -/
theorem sStrict_zero (I : Interface.{u}) : SStrict I.toPrims 0 := by
  sorry

/-! ## §8.2: `S_{<n} ⇒ W_{<n}` -/

/-- L8.5a: the roles of the source bank: root entries `0, …, c` (slots and heights). -/
def setupBank (S : ScanSetup.{u}) : List Role :=
  S.H.roles.filter fun x => (List.range (S.rd.cursor + 1)).any fun i => x.inEntry ⟨S.rd.col, i⟩

/-- L8.5a: the pre-root roles of the anchor. -/
def setupPreRoot (S : ScanSetup.{u}) : List Role := rolesBefore S.H (.ord S.rd.col)

/-- L8.5a: the bank graph: atoms of `Γ(H)` inside `preRoot ∪ {R} ∪ bank` involving `R` or the
bank (spine §c.11 S5). -/
def setupBankGraph (S : ScanSetup.{u}) : List (BaseAtom Role) :=
  (restrictTo (graph S.H) (setupPreRoot S ++ [.ord S.rd.col] ++ setupBank S)).filter fun a =>
    a.vars.any fun v => decide (v = .ord S.rd.col ∨ v ∈ setupBank S)

/-- L8.5a: bank values: bank roles through `bankNm`, `R ↦ ρ`, pre-root through `ePre ∘ χ`. -/
noncomputable def setupBankVal (S : ScanSetup.{u}) (x : Role) : Ordinal.{u} :=
  if x ∈ setupBank S then S.asg (S.bankNm x)
  else if x = .ord S.rd.col then S.asg S.stopNm else S.baseVal x

/-- L8.5a: values of the original positive query (spine §c.11 S4). -/
noncomputable def setupPosVal (S : ScanSetup.{u}) : Role → Ordinal.{u} :=
  S.fitVal fun x => S.asg (S.qNm x)

/-- L8.5a: the transported `E`-prefix domain `P_E` of a setup. -/
def setupEPrefix (S : ScanSetup.{u}) : List Role := ePrefix S.E S.cap S.sd

/-- L8.5a: the key and selector of query entry `j`. -/
def queryKey (S : ScanSetup.{u}) (j : Nat) : Key := ((Scan.queryKeys S.sd)[j]?).getD Tree.empty
def querySel (S : ScanSetup.{u}) (j : Nat) : Nat := ((S.sd.Q[j]?).map Prod.fst).getD 0

/-- L8.5a: owner and block maximum of the original positive query entry `j`. -/
noncomputable def queryOwnerVal (S : ScanSetup.{u}) (j : Nat) : Ordinal.{u} :=
  S.asg (S.qNm (.slot ⟨S.sd.col, j⟩))
noncomputable def queryBlockMax (S : ScanSetup.{u}) (j : Nat) : Ordinal.{u} :=
  ((S.entryRoles j).map fun x => S.asg (S.qNm x)).foldr max 0

/-- L8.5a: block maximum of bank entry `i` (`M_i`). -/
noncomputable def bankBlockMax (S : ScanSetup.{u}) (i : Nat) : Ordinal.{u} :=
  ((S.H.roles.filter fun x => x.inEntry ⟨S.rd.col, i⟩).map (setupBankVal S)).foldr max 0

/-- L8.5a: the clauses S1–S6 of `ScanSetup.Valid` (spine §c.11), written out. Equivalent to the
spine body `ScanSetup.ValidDef` (U3 D7.2b) by `valid_iff` (L8.5h). -/
def SetupClauses (P : Prims.{u}) (S : ScanSetup.{u}) : Prop :=
  -- S1
  (IsStd S.E ∧ Scan.InL S.H ∧ Scan.stepKind S.H = some .ordinary ∧
    Scan.stopData S.H = some S.sd ∧ Scan.rootData S.H = some S.rd ∧
    S.rd.cursor < ((S.H.colAt S.rd.col).getD []).length ∧
    S.rd.col.container S.sd.col ≠ some ⟨S.rd.col, S.rd.cursor⟩) ∧
  -- S2
  (Set.InjOn S.ePre {y | y ∈ setupEPrefix S} ∧
    BaseHolds P (restrictTo (graph S.E) (setupEPrefix S)) (S.asg ∘ S.ePre) ∧
    ∀ y ∈ setupEPrefix S, S.asg (S.ePre y) < S.asg S.stopNm) ∧
  -- S3
  (S.aux.Holds P S.asg ∧ ∀ v ∈ S.aux.vars, S.asg v < S.asg S.stopNm) ∧
  -- S4
  BaseHolds P S.queryGraph (setupPosVal S) ∧
  -- S5
  BaseHolds P (setupBankGraph S) (setupBankVal S) ∧
  -- S6
  (Set.InjOn S.qNm {x | x ∈ S.queryRoles} ∧ Set.InjOn S.bankNm {x | x ∈ setupBank S} ∧
    (∀ x ∈ S.queryRoles, S.qNm x ≠ S.stopNm ∧ S.qNm x ∉ S.aux.vars ∧
      (∀ y ∈ setupEPrefix S, S.qNm x ≠ S.ePre y) ∧ ∀ y ∈ setupBank S, S.qNm x ≠ S.bankNm y) ∧
    (∀ x ∈ setupBank S, S.bankNm x ≠ S.stopNm ∧ S.bankNm x ∉ S.aux.vars ∧
      ∀ y ∈ setupEPrefix S, S.bankNm x ≠ S.ePre y))

/-- L8.5h (formerly the stub `Req.valid_iff`, U5 R24): the spine's `ScanSetup.Valid` (body
`ScanSetup.ValidDef`, U3 D7.2b) is equivalent to the clauses `SetupClauses` written out by U5. -/
theorem valid_iff {P : Prims.{u}} (S : ScanSetup.{u}) : S.Valid P ↔ SetupClauses P S := by
  sorry

/-- L8.5b: the scan invariant (17) at state `(i, j)`. -/
def ScanInv (P : Prims.{u}) (S : ScanSetup.{u}) (i j : Nat) (β : Role → Ordinal.{u}) : Prop :=
  S.Fitted P j β ∧ S.Lmax j β < S.ownerVal i ∧ S.Lmax j β ≤ S.Cmax j

/-- L8.5b: (17) holds initially: `L_0 = C_0 = ρ < u_0` (txt:1220-1221). -/
theorem scan_init {P : Prims.{u}} (S : ScanSetup.{u}) (hS : SetupClauses P S)
    (β : Role → Ordinal.{u}) : ScanInv P S 0 0 β := by
  sorry

/-- L8.5c: `x_i < y_j`: advance the source cursor (txt:1222-1224). -/
theorem scan_lt {P : Prims.{u}} (S : ScanSetup.{u}) (hS : SetupClauses P S) {i j : Nat}
    {β : Role → Ordinal.{u}} (hinv : ScanInv P S i j β) (hi : i < S.rd.cursor) :
    ScanInv P S (i + 1) j β := by
  sorry

/-- L8.5d: both target heads at `u_i` from the positive heads at `h`: restriction if `h ≥ u_i`,
extension through (19) and intermediate elementarity if `h < u_i ≤ c_0` (txt:1228-1231). -/
theorem heads_at_owner (I : Interface.{u}) (S : ScanSetup.{u}) (hS : SetupClauses I.toPrims S)
    {i j : Nat} (hj : j < S.sd.Q.length) (hi : i ≤ S.rd.cursor) (β : Role → Ordinal.{u})
    (hc0 : S.ownerVal i ≤ queryBlockMax S j) (hL : S.Lmax j β < S.ownerVal i) :
    S.HeadsAt I.toPrims j i β := by
  sorry

/-- L8.5e: `x_i > y_j`: reuse the positive block below `u_i`, or call `S_{N(J_j)}` on the scan
packet (txt:1227-1234). -/
theorem scan_gt (I : Interface.{u}) {n : Nat} (hSn : ∀ m < n, SStrict I.toPrims m)
    (S : ScanSetup.{u}) (hS : S.Valid I.toPrims) (hQ : ∀ J ∈ S.sd.Q, J.2.size < n)
    {i j : Nat} {β : Role → Ordinal.{u}} (hinv : ScanInv I.toPrims S i j β)
    (hgt : Scan.ReachesGT (Scan.rootKeys S.H S.rd) (Scan.queryKeys S.sd) i j)
    (hi : i ≤ S.rd.cursor) : ∃ β', ScanInv I.toPrims S i (j + 1) β' := by
  sorry

/-- L8.5f: `x_i = y_j`: the two-candidate fact on the bank block and the positive block
(txt:1235-1241). -/
theorem scan_eq (I : Interface.{u}) (S : ScanSetup.{u}) (hS : S.Valid I.toPrims) {i j : Nat}
    {β : Role → Ordinal.{u}} (hinv : ScanInv I.toPrims S i j β) {x : Key}
    (hx : (Scan.rootKeys S.H S.rd)[i]? = some x) (hy : (Scan.queryKeys S.sd)[j]? = some x)
    (hi : i < S.rd.cursor) : ∃ β', ScanInv I.toPrims S (i + 1) (j + 1) β' := by
  sorry

/-- L8.5g: the invariant along the whole actual trace (txt:1242-1244). -/
theorem scan_trace (I : Interface.{u}) {n : Nat} (hSn : ∀ m < n, SStrict I.toPrims m)
    (S : ScanSetup.{u}) (hS : S.Valid I.toPrims) (hQ : ∀ J ∈ S.sd.Q, J.2.size < n) :
    ∀ s ∈ Scan.trace (Scan.rootKeys S.H S.rd) (Scan.queryKeys S.sd),
      ∃ β, ScanInv I.toPrims S s.1 s.2 β := by
  sorry

/-- L8.5, `S_{<n} ⇒ W_{<n}` (txt:1216-1248). -/
theorem wFit_of_sStrict (I : Interface.{u}) (n : Nat) (h : ∀ m < n, SStrict I.toPrims m) :
    WFit I.toPrims n := by
  sorry

/-! ## §8.3: `W_{<n} ⇒ D_{<n}` -/

/-- L8.6a: the hypotheses of `DLab` for one anchored input and one label, bundled. -/
structure DLabHyps (P : Prims.{u}) (n : Nat) (E : Forest) (cap : Option (Closure.AdmCap E))
    (α : Role → Ordinal.{u}) (sd : Scan.StopData) (rd : Scan.RootData) (V : Type)
    (Λ : Diagram V) (ν eν : Role → V) (b : V → Ordinal.{u}) (Fix : V → Prop) : Prop where
  inL : Scan.InL (Closure.anchor E cap)
  ordinary : Scan.stepKind (Closure.anchor E cap) = some .ordinary
  stop : Scan.stopData (Closure.anchor E cap) = some sd
  root : Scan.rootData (Closure.anchor E cap) = some rd
  config : IsConfig P (Closure.anchor E cap) α
  query : sd.Q = [] ∨ (IsStd E ∧ ∀ J ∈ sd.Q, J.2.size < n)
  bind : ∀ x ∈ rolesBefore (Closure.anchor E cap) (.ord sd.col), b (ν x) = α x
  origin : ∀ x ∈ rolesBefore (Closure.anchor E cap) (.ord sd.col), ∀ y,
    Closure.anchorOrigin E cap x = some y → eν y = ν x
  pre : ∀ T' a, Closure.anchorOrigin E cap (.ord sd.col) = some T' →
    a ∈ restrictTo (graph E) (rolesBefore E T') → Atom.base (a.map eν) ∈ Λ
  holds : Λ.Holds P b
  below : ∀ v ∈ Λ.vars, b v < α (.ord sd.col)
  fixBelow : ∀ v ∈ Λ.vars, Fix v → b v < α (.ord rd.col)

/-- L8.6a: unfolding `DLab` into its bundled hypotheses. -/
theorem dLab_iff (P : Prims.{u}) (n : Nat) :
    DLab P n ↔ ∀ (E : Forest) (cap : Option (Closure.AdmCap E)) (α : Role → Ordinal.{u})
      (sd : Scan.StopData) (rd : Scan.RootData) (V : Type) (Λ : Diagram V) (ν eν : Role → V)
      (b : V → Ordinal.{u}) (Fix : V → Prop), DLabHyps P n E cap α sd rd V Λ ν eν b Fix →
      ∀ (k : Nat) (H' : Forest), expand (Closure.anchor E cap) k = some H' →
        ∃ (γ : Role → Ordinal.{u}) (b' : V → Ordinal.{u}),
          IsConfig P H' γ ∧ (∀ x ∈ H'.roles, γ x < α (.ord sd.col)) ∧
          (∀ v, Fix v → b' v = b v) ∧
          (∀ x ∈ rolesBefore (Closure.anchor E cap) (.ord sd.col),
            b' (ν x) = γ (iota (Closure.anchor E cap) k x)) ∧
          Λ.Holds P b' ∧ (∀ v ∈ Λ.vars, b' v < α (.ord sd.col)) ∧
          (∀ x ∈ rolesBefore (Closure.anchor E cap) (.ord rd.col), γ x = α x) ∧
          (0 < k → ∀ x ∈ rolesBefore (Closure.anchor E cap) (.ord sd.col),
            x ∉ rolesBefore (Closure.anchor E cap) (.ord rd.col) → ¬ Fix (ν x) →
              γ x < α (.ord rd.col)) := by
  sorry

/-- L8.6a: the role sets of an ordinary input are those of its branch data. -/
theorem roleSets_eq {H : Forest} {sd : Scan.StopData} {rd : Scan.RootData}
    (hsd : Scan.stopData H = some sd) (hrd : Scan.rootData H = some rd) :
    ∃ rs, roleSets H = some rs ∧ rs.T = .ord sd.col ∧ rs.R = .ord rd.col ∧
      rs.N = .slot (Scan.closingSlot sd) ∧ rs.P = rolesBefore H (.ord sd.col) ∧
      rs.D = rolesBefore H (.ord rd.col) ++ [.ord rd.col] ++ rs.K := by
  sorry

/-- L8.6a: labels read every pre-stop role (via the `lim` atoms of the `E`-prefix graph), so the
`Fix` bound applies to all of them; hence a fixed label variable reads only pre-root roles. -/
theorem nu_mem_vars {P : Prims.{u}} {n : Nat} {E : Forest} {cap : Option (Closure.AdmCap E)}
    {α : Role → Ordinal.{u}} {sd : Scan.StopData} {rd : Scan.RootData} {V : Type}
    {Λ : Diagram V} {ν eν : Role → V} {b : V → Ordinal.{u}} {Fix : V → Prop}
    (hyp : DLabHyps P n E cap α sd rd V Λ ν eν b Fix) :
    ∀ x ∈ rolesBefore (Closure.anchor E cap) (.ord sd.col), ν x ∈ Λ.vars := by
  sorry

/-- L8.6b, (20): the final control edge `R(C, W, p)` with `p < W < C` (txt:1253-1254). -/
theorem control_edge (I : Interface.{u}) {H : Forest} {α : Role → Ordinal.{u}}
    {sd : Scan.StopData} {rd : Scan.RootData} (hV : Scan.CondV H)
    (hsd : Scan.stopData H = some sd) (hrd : Scan.rootData H = some rd)
    (hα : IsConfig I.toPrims H α) :
    I.Edge (α (.slot (Scan.closingSlot sd))) (α (.ord sd.col)) (α (.ord rd.col)) ∧
      α (.ord rd.col) < α (.ord sd.col) ∧ α (.ord sd.col) < α (.slot (Scan.closingSlot sd)) := by
  sorry

/-- L8.6c: the first retained role `v` of `K` is absent, on the route (ordinary or active
owner), or the closed root owner at the final cursor (txt:1288-1297). -/
theorem firstK_cases {H : Forest} (hL : Scan.InL H) (hk : Scan.stepKind H = some .ordinary)
    {sd : Scan.StopData} {rd : Scan.RootData} (hsd : Scan.stopData H = some sd)
    (hrd : Scan.rootData H = some rd) {rs : RoleSets} (hrs : roleSets H = some rs) :
    rs.K = [] ∨ (∃ v rest, rs.K = v :: rest ∧ OnRoute sd v) ∨
      (∃ rest, rs.K = .slot ⟨rd.col, rd.cursor⟩ :: rest ∧
        rd.cursor < ((H.colAt rd.col).getD []).length ∧
        rd.col.container sd.col ≠ some ⟨rd.col, rd.cursor⟩) := by
  sorry

/-- L8.6d: variables of the transported stage problem: main roles of `H[m]`, label variables,
fresh reference names of the `E`-prefix, the original positive query, the head `t`. -/
inductive SVar (V : Type) where
  | main (x : Role)
  | lab (v : V)
  | ref (y : Role)
  | qry (x : Role)
  | top

/-- L8.6d: the reference chart of the whole `E`-prefix at stage `m`: shared with the latest
main copy `f_m` on `χ(D)`, fresh elsewhere (consumed and deleted blocks; txt:1268-1270). -/
def refVar {V : Type} (E : Forest) (cap : Option (Closure.AdmCap E)) (H : Forest)
    (rs : RoleSets) (m : Nat) (y : Role) : SVar V :=
  match rs.D.find? (fun x => Closure.anchorOrigin E cap x == some y) with
  | some x => .main (fMap H m m x)
  | none => .ref y

/-- L8.6d: how the original positive query reads its context: `T ↦ t`, `Q ↦` query variables,
the rest of `P` through the reference chart (`P⁻ ↦ ePre ∘ χ`, as in a scan setup). -/
def qryVar {V : Type} (E : Forest) (cap : Option (Closure.AdmCap E)) (H : Forest)
    (rs : RoleSets) (m : Nat) (x : Role) : SVar V :=
  if x = rs.T then .top else if x ∈ rs.Q then .qry x else
    match Closure.anchorOrigin E cap x with
    | some y => refVar E cap H rs m y
    | none => .top

/-- L8.6d: the transported stage problem (txt:1273-1281), ordinal form: the main graph `G_m`,
the label, the reference `E`-prefix graph, the original positive query at head `t`, the label
bindings `ν x = x` on `P`, and the budget `x < t` for every old coordinate ((21)). -/
def stageDiagram {V : Type} (E : Forest) (cap : Option (Closure.AdmCap E))
    (sd : Scan.StopData) (rs : RoleSets) (Λ : Diagram V) (ν : Role → V) (m : Nat)
    (G : Forest) : Diagram (SVar V) :=
  let H := Closure.anchor E cap
  Diagram.ofBase ((graph G).map (BaseAtom.map SVar.main)) ++
  Diagram.map SVar.lab Λ ++
  Diagram.ofBase ((restrictTo (graph E) (ePrefix E cap sd)).map
    (BaseAtom.map (refVar E cap H rs m))) ++
  Diagram.ofBase ((queryAtoms H rs).map (BaseAtom.map (qryVar E cap H rs m))) ++
  Diagram.ofBase (rs.P.map fun x => BaseAtom.eq (SVar.lab (ν x)) (SVar.main x)) ++
  Diagram.ofBase (G.roles.map fun x => BaseAtom.lt (SVar.main x) SVar.top) ++
  Diagram.ofBase (Λ.vars.map fun v => BaseAtom.lt (SVar.lab v) SVar.top) ++
  Diagram.ofBase ((ePrefix E cap sd).map fun y => BaseAtom.lt (refVar E cap H rs m y) SVar.top)

/-- L8.6d: fixed variables of the stage problem: pre-root main roles and fixed label variables. -/
def stageFixed {V : Type} (H : Forest) (rs : RoleSets) (Fix : V → Prop) : SVar V → Prop
  | .main x => x ∈ rolesBefore H rs.R
  | .lab v => Fix v
  | _ => False

/-- L8.6d: the stage-`m` values, with head value `t` (`t = α(T)` before transport, `t = α(R)`
after it). -/
noncomputable def stageSigma {V : Type} (α : Role → Ordinal.{u}) (g : Role → Ordinal.{u})
    (b' : V → Ordinal.{u}) (eb : Role → Ordinal.{u}) (t : Ordinal.{u}) :
    SVar V → Ordinal.{u}
  | .main x => g x
  | .lab v => b' v
  | .ref y => eb y
  | .qry x => α x
  | .top => t

/-- L8.6e: the stage invariant of §8.3 (txt:1264-1267), ordinal form. -/
def StageInv (P : Prims.{u}) (H : Forest) (rs : RoleSets) (α : Role → Ordinal.{u}) {V : Type}
    (Λ : Diagram V) (ν : Role → V) (b : V → Ordinal.{u}) (Fix : V → Prop) (m : Nat)
    (G : Forest) (g : Role → Ordinal.{u}) (b' : V → Ordinal.{u}) : Prop :=
  expand H m = some G ∧ IsConfig P G g ∧ (∀ x ∈ G.roles, g x < α rs.T) ∧
    g (fMap H m m rs.R) = α rs.R ∧ (∀ x ∈ rs.K, g (fMap H m m x) = α x) ∧
    (∀ x ∈ rolesBefore H rs.R, g x = α x) ∧
    (∀ v, Fix v → b' v = b v) ∧ (∀ x ∈ rs.P, b' (ν x) = g x) ∧
    Λ.Holds P b' ∧ (∀ v ∈ Λ.vars, b' v < α rs.T) ∧
    (0 < m → ∀ x ∈ rs.P, x ∉ rolesBefore H rs.R → ¬ Fix (ν x) → g x < α rs.R)

/-- L8.6e: stage zero is the restriction to `P` (txt:1267, 1312). -/
theorem stage_zero_inv {P : Prims.{u}} {n : Nat} {E : Forest} {cap : Option (Closure.AdmCap E)}
    {α : Role → Ordinal.{u}} {sd : Scan.StopData} {rd : Scan.RootData} {V : Type}
    {Λ : Diagram V} {ν eν : Role → V} {b : V → Ordinal.{u}} {Fix : V → Prop}
    (hyp : DLabHyps P n E cap α sd rd V Λ ν eν b Fix) {rs : RoleSets}
    (hrs : roleSets (Closure.anchor E cap) = some rs) :
    ∃ G, StageInv P (Closure.anchor E cap) rs α Λ ν b Fix 0 G α b := by
  sorry

/-- L8.6e: the pre-stop roles persist at their addresses in every `H[m]` (`ι_m = id`). -/
theorem persist_prefix {H : Forest} (hL : Scan.InL H) {rs : RoleSets}
    (hrs : roleSets H = some rs) {m : Nat} {G : Forest} (hG : expand H m = some G) :
    rs.P <+: G.roles := by
  sorry

/-- L8.6f: control transport of the whole stage problem from `t = W` to `t = p`, captured into
`J_W` (txt:1281-1287). -/
theorem stage_transport (I : Interface.{u}) {n : Nat} {E : Forest}
    {cap : Option (Closure.AdmCap E)} {α : Role → Ordinal.{u}} {sd : Scan.StopData}
    {rd : Scan.RootData} {V : Type} {Λ : Diagram V} {ν eν : Role → V} {b : V → Ordinal.{u}}
    {Fix : V → Prop} (hyp : DLabHyps I.toPrims n E cap α sd rd V Λ ν eν b Fix)
    {rs : RoleSets} (hrs : roleSets (Closure.anchor E cap) = some rs) {m : Nat} {G : Forest}
    {g : Role → Ordinal.{u}} {b' : V → Ordinal.{u}}
    (hinv : StageInv I.toPrims (Closure.anchor E cap) rs α Λ ν b Fix m G g b') :
    (stageDiagram E cap sd rs Λ ν m G).RealizableBelow I.toPrims
      (fun z => stageFixed (Closure.anchor E cap) rs Fix z ∨ z = SVar.top)
      (stageSigma α g b' (b ∘ eν) (α rs.R)) (α rs.T) := by
  sorry

/-- L8.6g: the scan setup of the closed-root-owner case of stage `m + 1`, built from a
transported realization `a` (txt:1295-1304): transported chart `role 0`, query `role 1`, bank
`role 2` at original values, stop `aux 0` at `a t = p`, no auxiliary diagram. -/
noncomputable def stageSetup {V : Type} (E : Forest) (cap : Option (Closure.AdmCap E))
    (sd : Scan.StopData) (rd : Scan.RootData) (rs : RoleSets) (m : Nat)
    (α : Role → Ordinal.{u}) (a : SVar V → Ordinal.{u}) : ScanSetup.{u} where
  E := E
  cap := cap
  sd := sd
  rd := rd
  ePre := fun y => .role 0 y
  stopNm := .aux 0
  qNm := fun x => .role 1 x
  bankNm := fun x => .role 2 x
  aux := []
  asg := fun nm => match nm with
    | .role 0 y => a (refVar E cap (Closure.anchor E cap) rs m y)
    | .role 1 x => a (.qry x)
    | .role 2 x => α x
    | .aux 0 => a .top
    | _ => 0

/-- L8.6g: the setup is valid when the first retained role is the closed root owner and the
anchor carries the standard/size hypotheses (every hypothesis of §7.3 and `W_{<n}` is present,
txt:1298-1303). -/
theorem stageSetup_clauses (I : Interface.{u}) {n : Nat} {E : Forest}
    {cap : Option (Closure.AdmCap E)} {α : Role → Ordinal.{u}} {sd : Scan.StopData}
    {rd : Scan.RootData} {V : Type} {Λ : Diagram V} {ν eν : Role → V} {b : V → Ordinal.{u}}
    {Fix : V → Prop} (hyp : DLabHyps I.toPrims n E cap α sd rd V Λ ν eν b Fix)
    {rs : RoleSets} (hrs : roleSets (Closure.anchor E cap) = some rs) (hstd : IsStd E)
    (hclosed : rd.cursor < ((((Closure.anchor E cap)).colAt rd.col).getD []).length ∧
      rd.col.container sd.col ≠ some ⟨rd.col, rd.cursor⟩)
    {m : Nat} {G : Forest} {a : SVar V → Ordinal.{u}}
    (ha : (stageDiagram E cap sd rs Λ ν m G).Holds I.toPrims a) (htop : a SVar.top = α rs.R)
    (hbelow : ∀ z ∈ (stageDiagram E cap sd rs Λ ν m G).vars, a z < α rs.T)
    -- [V-fix] added: S5 reads the pre-root chart through `main`, the bank at `α`
    (hfix : ∀ x ∈ rolesBefore (Closure.anchor E cap) rs.R, a (SVar.main x) = α x) :
    SetupClauses I.toPrims (stageSetup E cap sd rd rs m α a) := by
  sorry

/-- L8.6h: fit the transported query before the restored `K` (txt:1288-1304): a realization of
the stage problem with `t = p`, all values below `W`, and all query values below the first
value of `K` (or `W` if `K` is empty). -/
theorem stage_fit (I : Interface.{u}) {n : Nat} (hW : WFit I.toPrims n) {E : Forest}
    {cap : Option (Closure.AdmCap E)} {α : Role → Ordinal.{u}} {sd : Scan.StopData}
    {rd : Scan.RootData} {V : Type} {Λ : Diagram V} {ν eν : Role → V} {b : V → Ordinal.{u}}
    {Fix : V → Prop} (hyp : DLabHyps I.toPrims n E cap α sd rd V Λ ν eν b Fix)
    {rs : RoleSets} (hrs : roleSets (Closure.anchor E cap) = some rs) {m : Nat} {G : Forest}
    {σ : SVar V → Ordinal.{u}}
    (hT : (stageDiagram E cap sd rs Λ ν m G).RealizableBelow I.toPrims
      (fun z => stageFixed (Closure.anchor E cap) rs Fix z ∨ z = SVar.top) σ (α rs.T))
    (htop : σ SVar.top = α rs.R)
    -- [V-fix] added: the fixed values are the stage-zero ones (pre-root `α`, fixed labels `b`)
    (hσ : ∀ z, stageFixed (Closure.anchor E cap) rs Fix z →
      σ z = stageSigma α α b (b ∘ eν) (α rs.R) z) :
    ∃ a : SVar V → Ordinal.{u},
      (∀ z, (stageFixed (Closure.anchor E cap) rs Fix z ∨ z = SVar.top) → a z = σ z) ∧
      (∀ z ∈ (stageDiagram E cap sd rs Λ ν m G).vars, a z < α rs.T) ∧
      (stageDiagram E cap sd rs Λ ν m G).Holds I.toPrims a ∧
      ∀ x ∈ rs.Q, a (.qry x) < (match rs.K with
        | [] => α rs.T
        | v :: _ => α v) := by
  sorry

/-- L8.6i: restore `K` at its original values with the new root `p`; the union is `G_{m+1}` and
the stage invariant holds at `m + 1` (txt:1306-1311). -/
theorem stage_restore (I : Interface.{u}) {n : Nat} {E : Forest}
    {cap : Option (Closure.AdmCap E)} {α : Role → Ordinal.{u}} {sd : Scan.StopData}
    {rd : Scan.RootData} {V : Type} {Λ : Diagram V} {ν eν : Role → V} {b : V → Ordinal.{u}}
    {Fix : V → Prop} (hyp : DLabHyps I.toPrims n E cap α sd rd V Λ ν eν b Fix)
    {rs : RoleSets} (hrs : roleSets (Closure.anchor E cap) = some rs) {m : Nat} {G G' : Forest}
    (hG : expand (Closure.anchor E cap) m = some G)
    (hG' : expand (Closure.anchor E cap) (m + 1) = some G') {a : SVar V → Ordinal.{u}}
    (hfixed : ∀ z, stageFixed (Closure.anchor E cap) rs Fix z →
      a z = stageSigma α α b (b ∘ eν) (α rs.R) z)
    (htop : a SVar.top = α rs.R)
    (hbelow : ∀ z ∈ (stageDiagram E cap sd rs Λ ν m G).vars, a z < α rs.T)
    (hholds : (stageDiagram E cap sd rs Λ ν m G).Holds I.toPrims a)
    (hq : ∀ x ∈ rs.Q, a (.qry x) < (match rs.K with
        | [] => α rs.T
        | v :: _ => α v)) :
    ∃ g' b', StageInv I.toPrims (Closure.anchor E cap) rs α Λ ν b Fix (m + 1) G' g' b' := by
  sorry

/-- L8.6j: one copy stage (transport, fit, restore). -/
theorem stage_step (I : Interface.{u}) {n : Nat} (hW : WFit I.toPrims n) {E : Forest}
    {cap : Option (Closure.AdmCap E)} {α : Role → Ordinal.{u}} {sd : Scan.StopData}
    {rd : Scan.RootData} {V : Type} {Λ : Diagram V} {ν eν : Role → V} {b : V → Ordinal.{u}}
    {Fix : V → Prop} (hyp : DLabHyps I.toPrims n E cap α sd rd V Λ ν eν b Fix)
    {rs : RoleSets} (hrs : roleSets (Closure.anchor E cap) = some rs) {m : Nat} {G G' : Forest}
    {g : Role → Ordinal.{u}} {b' : V → Ordinal.{u}}
    (hinv : StageInv I.toPrims (Closure.anchor E cap) rs α Λ ν b Fix m G g b')
    (hG' : expand (Closure.anchor E cap) (m + 1) = some G') :
    ∃ g' b'', StageInv I.toPrims (Closure.anchor E cap) rs α Λ ν b Fix (m + 1) G' g' b'' := by
  sorry

/-- L8.6, `W_{<n} ⇒ D_{<n}` with labels (txt:1250-1323). -/
theorem dLab_of_wFit (I : Interface.{u}) (n : Nat) (hW : WFit I.toPrims n) :
    DLab I.toPrims n := by
